import std.alpha as alpha
import std.beta as beta
import std.gamma as gamma

main {
    UInt64(10) -> alpha.encode => alphaValue
    UInt64(10) -> beta.encode => betaValue
    UInt64(10) -> alpha.localEncode => localValue
    [UInt8(7), UInt8(9)] => bytes
    bytes -> gamma.firstPlus(UInt8(3)) => arrayValue
    bytes -> gamma.localFirstPlus(UInt8(4)) => localArrayValue
    alphaValue == 11 and betaValue == 12 and localValue == 11 and arrayValue == UInt8(10) and localArrayValue == UInt8(11)
        -> unless { 1 / 0 => failure }
}
