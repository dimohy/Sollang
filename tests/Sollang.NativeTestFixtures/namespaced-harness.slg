import sys.process as process
import native_tests.tests as test_module_0

main {
    0 => failures!
    "running 3 tests" -> println
    test_module_0.test_addition() -> if {
        "test native_tests.tests.test_addition ... ok" -> println
    } else {
        "test native_tests.tests.test_addition ... FAILED" -> println
        failures! + 1 => failures!
    }
    test_module_0.test_subtraction() -> if {
        "test native_tests.tests.test_subtraction ... ok" -> println
    } else {
        "test native_tests.tests.test_subtraction ... FAILED" -> println
        failures! + 1 => failures!
    }
    test_module_0.test_only_import() -> if {
        "test native_tests.tests.test_only_import ... ok" -> println
    } else {
        "test native_tests.tests.test_only_import ... FAILED" -> println
        failures! + 1 => failures!
    }
    "test result: $(3 - failures!) passed; $(failures!) failed" -> println
    failures! == 0 -> if { 0 -> process.exit } else { 1 -> process.exit }
}
