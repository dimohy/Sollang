namespace fixture.library

square value: Float64 -> Float64 {
    value * value
}

public add left: Int32, right: Int32 -> Int32 {
    left + right
}

public multiply left: Int64, right: Int64 -> Int64 {
    left * right
}

public hypotSquared left: Float64, right: Float64 -> Float64 {
    left -> square => leftSquared
    right -> square => rightSquared
    leftSquared + rightSquared
}
