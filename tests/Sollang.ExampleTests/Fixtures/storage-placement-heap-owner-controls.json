{
  "schemaVersion": 1,
  "scope": "source-frames",
  "cases": [
    {
      "id": "mutable-empty-array",
      "source": "main {\n    [Int; ~] => values!\n}\n",
      "warnings": [
        "S002@2"
      ],
      "expected": [
        "main|slots:24/8",
        "main|alloc:BindingStatement@2,0,24"
      ]
    },
    {
      "id": "mutable-box",
      "source": "main {\n    box 13 => value!\n}\n",
      "warnings": [
        "S002@2"
      ],
      "expected": [
        "main|slots:24/8",
        "main|alloc:BindingStatement@2,0,24"
      ]
    },
    {
      "id": "mutable-dictionary",
      "source": "main {\n    { 1: 2 } => values!\n}\n",
      "warnings": [
        "S002@2"
      ],
      "expected": [
        "main|slots:24/8",
        "main|alloc:BindingStatement@2,0,24"
      ]
    },
    {
      "id": "mutable-if-array",
      "source": "main {\n    true -> if { [1; ~] } else { [2; ~] } => values!\n}\n",
      "warnings": [
        "S002@2"
      ],
      "expected": [
        "main|slots:24/8",
        "main|alloc:BindingStatement@2,0,24"
      ]
    },
    {
      "id": "mutable-call-array",
      "source": "make: -> [Int; ~] { [7; ~] }\nmain {\n    make() => values!\n}\n",
      "warnings": [
        "S002@3"
      ],
      "expected": [
        "main|slots:24/8",
        "main|alloc:BindingStatement@3,0,24",
        "function:make@1|slots:"
      ]
    },
    {
      "id": "async-excludes-frame",
      "source": "work: -> async Int {\n    [1, 2] => values\n    values[0]\n}\nmain {}\n",
      "warnings": [],
      "expected": [
        "main|slots:",
        "function:work@1|slots:"
      ],
      "excludedFrames": [
        "function:work@1"
      ]
    }
  ]
}
