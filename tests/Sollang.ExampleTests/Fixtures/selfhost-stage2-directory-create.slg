import sys.directory as directory
import sys.path as path

main {
    "artifacts/example-tests/stage2-directory-create" -> path.fromText(path.nativeStyle()) => target!
    target! -> directory.create => created
    target! -> directory.create => exists
    created -> if { "created" -> println } else { "create failed" -> println }
    exists -> if { "exists" -> println } else { "existing directory failed" -> println }
}
