namespace regression.constant_records

public struct Constant {
    public value: Long
    public sourceNode: Int
}

public struct Expansion {
    public constants: [Constant; ~]
    public dictionary: Bool
}

public make: -> Result<Expansion, Int> {
    Expansion {
        constants: [Constant { value: 25, sourceNode: 7 }, Constant { value: 26, sourceNode: 9 }; ~]
        dictionary: false
    } -> Result<Expansion, Int>.Ok
}
