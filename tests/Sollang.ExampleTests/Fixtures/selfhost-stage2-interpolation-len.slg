# Parenthesized interpolation evaluates the complete flow call and prints the
# current mutable-array length, not the array storage value. The nested region
# also proves that Arena construction and signed integer materialization use
# the same intrinsic emission contract as a function's linear region.
main {
    [1, 2, 3; ~] => values!
    values! -> push(4)
    "count=$(values! -> len)" -> println
    true -> if {
        Arena(0) => storage!
        values! -> len => count
        "materialized=$count" => message
        message -> materialize(storage!) -> println
    }
}
