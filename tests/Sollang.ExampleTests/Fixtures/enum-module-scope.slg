namespace regression.enum_scope

public enum Error {
    Failed
    Present(Int)
}

struct Holder {
    Failed: Int
}

public empty: -> Error => Error.Failed
public payload value: Int -> Error => Error.Present(value)
public shadow value: Int -> Int {
    Holder { Failed: value } => Error
    Error.Failed
}

public matched: -> Int {
    Error.Failed -> when {
        Error.Failed => 42
        Error.Present(value) => value
    }
}
