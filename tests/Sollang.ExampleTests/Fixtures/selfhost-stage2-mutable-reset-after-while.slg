scanPair first: Text, second: Text -> Int {
    UIntSize(0) => index!
    index! < (first -> len) -> while {
        index! + 1 => index!
    }
    UIntSize(0) => index!
    index! < (second -> len) -> while {
        index! + 1 => index!
    }
    Int(index!)
}

enum Style {
    Posix
    Windows
}

isWindows style: Style -> Bool {
    false => matched!
    style -> when {
        Windows { true => matched! }
        Posix { false => matched! }
    }
    matched!
}

main {
    "first-value" -> scanPair("next") -> println
    Style.Windows -> isWindows -> println
}
