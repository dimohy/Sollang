{
  "schemaVersion": 1,
  "scope": "source-frames",
  "cases": [
    {
      "id": "implicit-fixed-overlap",
      "source": "[1; 512] => first\n[2; 512] => second\nfirst[0] => firstValue\nsecond[0] => secondValue\n",
      "warnings": [],
      "expected": [
        "main|slots:2048/8,2048/8",
        "main|alloc:ArrayRepeatExpression@1,0,2048",
        "main|alloc:ArrayRepeatExpression@2,1,2048",
        "main|end:BindingStatement@3,0,2048",
        "main|end:BindingStatement@4,1,2048"
      ]
    },
    {
      "id": "implicit-readonly-dynamic",
      "source": "[1, 2; ~] => values\nvalues[0] => first\n",
      "warnings": [
        "S003@1"
      ],
      "expected": [
        "main|slots:8/8",
        "main|alloc:ArrayLiteralExpression@1,0,8",
        "main|end:BindingStatement@2,0,8"
      ]
    },
    {
      "id": "implicit-owner-header",
      "source": "[Int; ~] => values!\nvalues! -> push(1)\n",
      "warnings": [
        "S003@1"
      ],
      "expected": [
        "main|slots:24/8",
        "main|alloc:BindingStatement@1,0,24"
      ]
    }
  ]
