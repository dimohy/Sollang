{
  "schemaVersion": 1,
  "scope": "source-control-facts",
  "cases": [
    {
      "id": "simple",
      "source": "work: -> Int { 1 }\nmain {}\n",
      "warnings": [],
      "expected": [
        "function:work@1|standalone:false"
      ]
    },
    {
      "id": "fixed-array",
      "source": "work: -> Int {\n    [1, 2] => values\n    values[0]\n}\nmain {}\n",
      "warnings": [],
      "expected": [
        "function:work@1|standalone:true"
      ]
    },
    {
      "id": "empty-dynamic",
      "source": "work: -> [Int; ~] { [Int; ~] }\nmain {}\n",
      "warnings": [],
      "expected": [
        "function:work@1|standalone:true"
      ]
    },
    {
      "id": "repeat-array",
      "source": "work: -> Int {\n    [1; 2] => values\n    values[0]\n}\nmain {}\n",
      "warnings": [],
      "expected": [
        "function:work@1|standalone:true"
      ]
    },
    {
      "id": "dictionary",
      "source": "work: -> Int {\n    { 1: 2 } => values\n    values -> len\n}\nmain {}\n",
      "warnings": [],
      "expected": [
        "function:work@1|standalone:true"
      ]
    },
    {
      "id": "box-only",
      "source": "work: -> Int {\n    box 13 => owner\n    1\n}\nmain {}\n",
      "warnings": [],
      "expected": [
        "function:work@1|standalone:false"
      ]
    },
    {
      "id": "early-return",
      "source": "work: -> Int { 1 -> return }\nmain {}\n",
      "warnings": [],
      "expected": [
        "function:work@1|standalone:true"
      ]
    },
    {
      "id": "async",
      "source": "work: -> async Int { 1 }\nmain {}\n",
      "warnings": [],
      "expected": [
        "function:work@1|standalone:true"
      ]
    },
    {
      "id": "if-array",
      "source": "work flag: Bool -> [Int; ~] {\n    flag -> if { [1; ~] } else { [2; ~] }\n}\nmain {}\n",
      "warnings": [],
      "expected": [
        "function:work@1|standalone:true"
      ]
    },
    {
      "id": "callback-array",
      "source": "work: -> Unit {\n    1..2 -> each value {\n        [value, 2] => values\n        values[0] => first\n    }\n}\nmain {}\n",
      "warnings": [],
      "expected": [
        "function:work@1|standalone:true"
      ]
    },
    {
      "id": "plain-interpolation",
      "source": "work value: Int -> Unit uses Console { \"value=$value\" -> println }\nmain {}\n",
      "warnings": [],
      "expected": [
        "function:work@1|standalone:false"
      ]
    },
    {
      "id": "array-interpolation",
      "source": "work: -> Unit uses Console { \"$([1, 2] -> len)\" -> println }\nmain {}\n",
      "warnings": [],
      "expected": [
        "function:work@1|standalone:true"
      ]
    },
    {
      "id": "nested-function-owner",
      "source": "outer: -> Int {\n    inner: -> Int {\n        [1, 2] => values\n        values[0]\n    }\n    1\n}\nmain {}\n",
      "warnings": [],
      "expected": [
        "function:inner@2|standalone:true",
        "function:outer@1|standalone:false"
      ]
    }
  ]
}
