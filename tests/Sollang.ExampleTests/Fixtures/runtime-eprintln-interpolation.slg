import sys.runtime as runtime

writeFunction value: Int, enabled: Bool, label: Text -> Unit uses Console {
    "function int=$value bool=$enabled text=$label" -> runtime.eprintln
    value > 0 -> if {
        "control int=$(value + 1) bool=$(not enabled) text=$label" -> runtime.eprintln
    }
}

main {
    "entry int=$(40 + 2) bool=$(1 == 1) text=entry" -> runtime.eprintln
    7 -> writeFunction(true, "sample")
}
