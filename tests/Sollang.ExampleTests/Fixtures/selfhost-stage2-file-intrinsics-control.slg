import sys.file as file

# SourceText-producing compiler intrinsics must keep their runtime lowering when
# they occur inside nested control regions, not only in a function's root block.
main {
    true -> if {
        file.readStandardInput() => input!
        input! -> len => inputLength
        inputLength >= UIntSize(0) -> if { }
    }
    false -> if {
        [UInt8(65), UInt8(10); ~] => bytes!
        bytes! -> file.borrowBytes => borrowed!
        borrowed! -> len => borrowedLength
        borrowedLength == UIntSize(2) -> if { }
    }
}
