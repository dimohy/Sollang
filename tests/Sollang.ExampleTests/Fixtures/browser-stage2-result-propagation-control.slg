checked value: Int -> Result<Int, Int> => value >= 0
    -> if {
    Result<Int, Int>.Ok(value)
} else {
    Result<Int, Int>.Err(value)
}

verify: -> Result<Bool, Int> {
    checked(42)? => parsed

    checked(-1) -> when {
        Ok(unexpected) { Result<Bool, Int>.Ok(false) -> return }
        Err(error) {
            error == -1 -> unless { Result<Bool, Int>.Err(error) -> return }
        }
    }

    checked(-2) -> when {
        Ok(unexpected) { Result<Bool, Int>.Ok(false) -> return }
        Err(error) {
            error == -2 -> unless { Result<Bool, Int>.Err(error) -> return }
        }
    }

    Result<Bool, Int>.Ok(parsed == 42)
}

main {
    verify() -> when {
        Ok(valid) { "result-propagation=$valid" -> println }
        Err(error) { "result-propagation-error=$error" -> println }
    }
}
