namespace fixture.result_instance

public struct Counter {
    public value: Int
}

impl Counter {
    public read: self -> Int => self.value

    public increment: mut self -> Int {
        self.value + 1 => self.value
        self.value
    }
}

public create value: Int -> Result<Counter, Int> {
    Result<Counter, Int>.Ok(Counter { value: value })
}
