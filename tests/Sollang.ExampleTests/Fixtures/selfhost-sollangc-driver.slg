import sollang.compiler.llvm.text as llvm
import sollang.compiler.llvm.source_root as llvmRoot
import sollang.compiler.llvm.codegen_units as codegenUnits
import sollang.compiler.ir.module_artifacts as moduleArtifacts
import sollang.compiler.ir.typed as typedIr
import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.module_interfaces as moduleInterfaces
import sollang.compiler.semantic.module_cache as moduleCache
import sollang.compiler.semantic.module_cache_io as moduleCacheIo
import sollang.compiler.semantic.modules as modules
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.cli_project as cliProject
import sollang.compiler.cli_workspace as cliWorkspace
import sollang.compiler.source_root as sourceRoot
import sys.path as path
import sys.process as process

processCode result: Result<Int, Text> -> Int => result -> when {
    Ok(code) => code
    Err(error) => -1
}

textEquals left: Text, right: Text -> Bool {
    (left -> len) == (right -> len) => matches!
    UIntSize(0) => index!
    (matches! and index! < (left -> len)) -> while {
        (left -> byte(index!)) != (right -> byte(index!)) -> if {
            false => matches!
        }
        index! + UIntSize(1) => index!
    }
    matches!
}

pathTextAt paths: [path.Path; ~], index: Int -> Text {
    path.pathText(paths[index])
}

printVersion: -> Unit uses Console {
    "Sollang 0.4.0" -> println
}

printHelp: -> Unit uses Console {
    "Sollang 0.4.0" -> println
    "usage: sollang <command> [options]" -> println
    "" -> println
    "commands:" -> println
    "  build            compile source, project, or workspace products" -> println
    "  run              build and run a native program" -> println
    "  test             discover, build, and run Sollang tests" -> println
    "  format           format Sollang source" -> println
    "  resolve          resolve and lock package dependencies" -> println
    "  language-server  run the Language Server Protocol endpoint" -> println
    "  bind-cpp         generate a checked C++ binding package" -> println
    "  grammar build    regenerate the canonical parser table" -> println
    "" -> println
    "global options:" -> println
    "  -h, --help       show this help" -> println
    "  -v, --version    show the compiler version" -> println
}

exitFailure: -> Unit uses Process {
    process.exit(1)
}

isJobsOption value: Text -> Bool {
    (value -> len) == UIntSize(6) => matches!
    matches! -> if {
        ((value -> byte(UIntSize(0))) == UInt8(45) and (value -> byte(UIntSize(1))) == UInt8(45) and (value -> byte(UIntSize(2))) == UInt8(106) and (value -> byte(UIntSize(3))) == UInt8(111) and (value -> byte(UIntSize(4))) == UInt8(98) and (value -> byte(UIntSize(5))) == UInt8(115)) => matches!
    }
    matches!
}

parsePositiveInt value: Text -> Int {
    0 => parsed!
    (value -> len) > UIntSize(0) => valid!
    UIntSize(0) => index!
    (valid! and index! < (value -> len)) -> while {
        value -> byte(index!) => digit
        (digit < UInt8(48) or digit > UInt8(57)) -> if {
            false => valid!
        } else {
            parsed! * 10 + Int(digit - UInt8(48)) => parsed!
        }
        index! + UIntSize(1) => index!
    }
    (valid! and parsed! > 0) -> if { parsed! } else { -1 }
}

configureWorkerLimit optionStart: UIntSize -> Int uses Process {
    sys.process.arguments() => arguments
    0 => workers!
    optionStart < (arguments -> len) -> if {
        arguments[optionStart] -> isJobsOption -> if {
            optionStart + UIntSize(1) < (arguments -> len) -> if {
                arguments[optionStart + UIntSize(1)] -> parsePositiveInt => requested
                requested > 0 -> if {
                    requested -> limitParallelWorkers => workers!
                } else { -1 => workers! }
            } else { -1 => workers! }
        }
    }
    workers!
}

sourceStart optionStart: UIntSize -> UIntSize uses Process {
    sys.process.arguments() => arguments
    optionStart => start!
    optionStart < (arguments -> len) -> if {
        arguments[optionStart] -> isJobsOption -> if { optionStart + UIntSize(2) => start! }
    }
    start!
}

collectPaths start: UIntSize -> [Text; ~] uses Process {
    sys.process.arguments() => arguments
    arguments -> len => argumentCount
    [Text; ~] => paths!
    start => index!
    index! < argumentCount -> while {
        arguments[index!] => path
        paths! -> push(path)
        index! + UIntSize(1) => index!
    }
    paths!
}

collectBuildPaths start: UIntSize -> [Text; ~] uses Process {
    sys.process.arguments() => arguments
    arguments -> len => argumentCount
    [Text; ~] => paths!
    start => index!
    index! < argumentCount -> while {
        arguments[index!] => path
        paths! -> push(path)
        index! + UIntSize(1) => index!
    }
    paths!
}

emitLinuxFiles pathStart: UIntSize -> Unit uses Console, File, Process {
    pathStart -> collectPaths => paths!
    paths! -> llvm.emitLinuxCheckedFiles => diagnosticCount
    diagnosticCount > 0 -> if { exitFailure() }
}

emitWasmFiles pathStart: UIntSize -> Unit uses Console, File, Process {
    pathStart -> collectPaths => paths!
    paths! -> llvm.emitWasmCheckedFiles => diagnosticCount
    diagnosticCount > 0 -> if { exitFailure() }
}

emitWindowsFiles pathStart: UIntSize -> Unit uses Console, File, Process {
    pathStart -> collectPaths => paths!
    paths! -> llvm.emitCheckedFiles => diagnosticCount
    diagnosticCount > 0 -> if { exitFailure() }
}

emitLinuxRoot pathStart: UIntSize -> Unit uses Console, File, Process {
    sys.process.arguments() => arguments
    # Root discovery and source mapping run in this native Windows driver even
    # when the emitted program targets Linux.
    arguments[pathStart] -> path.fromText(path.Style.Windows) => root!
    root! -> llvmRoot.emitLinuxCheckedRoot
}

emitWasmRoot pathStart: UIntSize -> Unit uses Console, File, Process {
    sys.process.arguments() => arguments
    arguments[pathStart] -> path.fromText(path.Style.Windows) => root!
    root! -> llvmRoot.emitWasmCheckedRoot
}

emitWindowsRoot pathStart: UIntSize -> Unit uses Console, File, Process {
    sys.process.arguments() => arguments
    arguments[pathStart] -> path.fromText(path.Style.Windows) => root!
    arguments -> len => explicitStart
    llvmRoot.emitCheckedRoot(root!, explicitStart, 0) => diagnosticCount
    diagnosticCount > 0 -> if { exitFailure() }
}

emitRootAndFiles pathStart: UIntSize, target: Int -> Unit uses Console, File, Process {
    sys.process.arguments() => arguments
    arguments[pathStart] -> path.fromText(path.nativeStyle()) => root!
    pathStart + UIntSize(1) -> configureWorkerLimit => workers
    workers < 0 -> if {
        "; sollang error: --jobs expects a positive integer" -> println
        exitFailure()
    }
    workers > 0 -> if { "; sollang workers = $workers" -> println }
    pathStart + UIntSize(1) -> sourceStart => fileStart
    llvmRoot.emitCheckedRoot(root!, fileStart, target) => diagnosticCount
    diagnosticCount > 0 -> if { exitFailure() }
}

emitFingerprints pathStart: UIntSize -> Unit uses Console, File, Process {
    pathStart -> collectPaths => paths!
    paths! -> semanticContext.prepareFiles => snapshot!
    snapshot!.package -> moduleInterfaces.fingerprintAnalyzed => fingerprints!
    0 => fingerprintIndex!
    fingerprintIndex! < (fingerprints! -> len) -> while {
        fingerprints![fingerprintIndex!] => fingerprint
        "module fingerprint = $(fingerprint.moduleHash),$(fingerprint.sourceHash),$(fingerprint.interfaceHash),$(fingerprint.implementationHash),$(fingerprint.importHash),$(fingerprint.publicSymbolCount),$(fingerprint.importCount)" -> println
        fingerprintIndex! + 1 => fingerprintIndex!
    }
}

runInterfaceCache: -> Unit uses Console, File, Process {
    sys.process.arguments() => arguments
    UIntSize(4) -> collectPaths => paths!
    paths! -> semanticContext.prepareFiles => snapshot!
    snapshot!.package -> moduleCache.encodeAnalyzed(UInt64(1)) => current!
    current! -> moduleCacheIo.publish(arguments[2], arguments[3]) => published
    arguments[2] -> moduleCacheIo.load => loaded!
    snapshot!.package -> moduleCache.reuseAnalyzed(loaded!, UInt64(1)) => reuse
    (published and reuse.status == 0) -> if { 1 } else { 0 } => persistent
    "module cache = $(reuse.status),$(reuse.hits),$(reuse.misses),$(reuse.bodyOnlyConsumerHits),$persistent" -> println
}

runModuleArtifacts: -> Unit uses Console, File, Process {
    UIntSize(2) -> collectPaths => paths!
    paths! -> semanticContext.prepareFiles => snapshot!
    snapshot! -> typedIr.lowerContext => ir!
    [typeIds.SemanticType; ~] => types!
    snapshot!.semantic.types -> each currentType { types! -> push(currentType) }
    [modules.ModuleIdentity; ~] => identities!
    snapshot!.modules -> each identity { identities! -> push(identity) }
    ir! -> moduleArtifacts.encode(identities!, types!) => words!
    words! -> moduleArtifacts.validate => validation
    words! -> moduleArtifacts.decode(identities!) => decoded!
    [typedIr.TypedIrNode; ~] => decodedIr!
    decoded!.ir -> each node { decodedIr! -> push(node) }
    decodedIr! -> len => decodedNodeCount
    (validation.nodeCount > 0 and decoded!.status == 0 and decodedNodeCount == validation.nodeCount) -> if { 1 } else { 0 } => hasNodes
    "module artifacts = $(validation.status),$(validation.moduleCount),$hasNodes" -> println
}

runCodegenUnits: -> Unit uses Console {
    codegenUnits.CodegenUnits {
        kinds: [1, 2, 1, 0; ~]
        moduleHashes: [UInt64(6012471128798655323), UInt64(0), UInt64(13501036247553511367), UInt64(0); ~]
        interfaceHashes: [UInt64(220), UInt64(0), UInt64(210), UInt64(0); ~]
        implementationHashes: [UInt64(320), UInt64(402), UInt64(310), UInt64(401); ~]
        identityStarts: [0, 4, 4, 9; ~]
        identityLengths: [4, 0, 5, 0; ~]
        identityWords: [UInt64(122), UInt64(101), UInt64(116), UInt64(97), UInt64(97), UInt64(108), UInt64(112), UInt64(104), UInt64(97); ~]
        fragmentStarts: [0, 1, 2, 3; ~]
        fragmentWordLengths: [1, 1, 1, 1; ~]
        fragmentByteLengths: [2, 1, 2, 1; ~]
        fragmentWords: [UInt64(14682), UInt64(84), UInt64(12609), UInt64(72); ~]
    } => units!
    UInt64(101) => compilerHash
    UInt64(202) => targetHash
    UInt64(303) => configurationHash
    units! -> codegenUnits.encode(compilerHash, targetHash, configurationHash) => artifact!
    artifact! -> codegenUnits.validate(compilerHash, targetHash, configurationHash) => validation
    artifact! -> codegenUnits.merge(compilerHash, targetHash, configurationHash) => merged!
    (validation.status == 0 and merged!.status == 0) -> if {
        "codegen units = $(validation.status),$(validation.moduleCount),$(merged!.byteLength)" -> println
    } else {
        "codegen units = $(validation.status),0,0" -> println
    }
}

buildWindows pathStart: UIntSize -> Unit uses Console, File, Process {
    sys.process.arguments() => arguments
    pathStart -> collectBuildPaths => sourcePaths!
    [arguments[0], "windows"; ~] => emitArgv!
    pathStart > UIntSize(5) -> if {
        emitArgv! -> push(arguments[5])
        emitArgv! -> push(arguments[6])
    }
    sourcePaths! -> each sourcePath { emitArgv! -> push(sourcePath) }
    process.RunToFileRequest {
        argv: emitArgv!
        output: arguments[2]
    } -> process.runToFile -> processCode => emitCode

    emitCode == 0 -> if {
        [arguments[4], arguments[2], "-O1", "-Wno-override-module", "-o", arguments[3]; ~] => clangArgv!
        clangArgv! -> process.run -> processCode => clangCode
        clangCode >= 0 -> if {
            "native build = $(clangCode)" -> println
        } else {
            "native compiler invocation failed" -> println
        }
    } else {
        "compiler emission failed" -> println
    }
}

nativeTargetMode target: Int -> Text {
    target == 0 -> if {
        "windows"
    } else {
        target == 1 -> if { "linux" } else { "wasm" }
    }
}

nativeCliTargetMode target: Int -> Text {
    target == 0 -> if {
        "windows-stdlib"
    } else {
        target == 1 -> if { "linux-stdlib" } else { "wasm-stdlib" }
    }
}

nativeTargetName target: Int -> Text {
    target == 0 -> if {
        "windows-x64"
    } else {
        target == 1 -> if { "linux-x64" } else { "wasm32-browser" }
    }
}

parseNativeTarget value: Text -> Int {
    value -> textEquals("windows-x64") -> if {
        0
    } else {
        value -> textEquals("linux-x64") -> if {
            1
        } else {
            value -> textEquals("wasm32-browser") -> if { 2 } else { -1 }
        }
    }
}

windowsNativeOutput stem: Text, storage: mut Arena -> Text {
    "$stem.exe" -> materialize(storage)
}

wasmNativeOutput stem: Text, storage: mut Arena -> Text {
    "$stem.wasm" -> materialize(storage)
}

portableNativeOutput stem: Text, storage: mut Arena -> Text {
    stem -> materialize(storage)
}

defaultNativeOutput source: Text, target: Int, storage: mut Arena -> Text {
    source -> len => sourceLength
    sourceLength >= UIntSize(4) => validSuffix!
    validSuffix! -> if {
        (validSuffix! and (source -> byte(sourceLength - UIntSize(4))) == UInt8(46)) => validSuffix!
        (validSuffix! and (source -> byte(sourceLength - UIntSize(3))) == UInt8(115)) => validSuffix!
        (validSuffix! and (source -> byte(sourceLength - UIntSize(2))) == UInt8(108)) => validSuffix!
        (validSuffix! and (source -> byte(sourceLength - UIntSize(1))) == UInt8(103)) => validSuffix!
    }
    UIntSize(0) => stemLength!
    validSuffix! -> if { sourceLength - UIntSize(4) => stemLength! } else { sourceLength => stemLength! }
    source -> slice(UIntSize(0), stemLength!) => stem
    target == 0 -> if {
        stem -> windowsNativeOutput(storage)
    } else {
        target == 2 -> if {
            stem -> wasmNativeOutput(storage)
        } else {
            stem -> portableNativeOutput(storage)
        }
    }
}

nativeClangPath llvmHome: Text, hostTarget: Int, storage: mut Arena -> Text {
    (llvmHome -> len) == UIntSize(0) -> if {
        "clang"
    } else {
        hostTarget == 0 -> if {
            llvmHome -> windowsClangPath(storage)
        } else {
            llvmHome -> posixClangPath(storage)
        }
    }
}

windowsClangPath llvmHome: Text, storage: mut Arena -> Text {
    "$llvmHome\\bin\\clang.exe" -> materialize(storage)
}

posixClangPath llvmHome: Text, storage: mut Arena -> Text {
    "$llvmHome/bin/clang" -> materialize(storage)
}

stdlibNativePath compilerDirectory: Text, storage: mut Arena -> Text {
    "$compilerDirectory/stdlib" -> materialize(storage)
}

executableDirectory executable: Text -> Text {
    UIntSize(0) => lastSeparator!
    false => found!
    UIntSize(0) => index!
    index! < (executable -> len) -> while {
        executable -> byte(index!) => current
        (current == UInt8(47) or current == UInt8(92)) -> if {
            index! => lastSeparator!
            true => found!
        }
        index! + UIntSize(1) => index!
    }
    found! -> if {
        executable -> slice(UIntSize(0), lastSeparator!) => directory
        directory -> return
    }
    "."
}

executeNativeBuild sources: [Text; ~], output: Text, llvmHome: Text, stdlibOption: Text, optimization: Text, target: Int, hostTarget: Int, jobs: Text, keepTemps: Bool, quiet: Bool -> Int uses Console, File, Process {
    target == 2 -> if {
        "sollang: native CLI wasm linking is not implemented yet" -> println
        -1 -> return
    }
    target != hostTarget -> if {
        "sollang: native CLI cross-target linking is not implemented yet; requested $(target -> nativeTargetName)" -> println
        -1 -> return
    }

    Arena(0) => llvmPathStorage!
    "$output.ll" -> materialize(llvmPathStorage!) => llvmPath
    process.arguments() => arguments
    arguments[0] -> executableDirectory => compilerDirectory
    Arena(0) => stdlibRootStorage!
    "" => stdlibRoot!
    (stdlibOption -> len) > UIntSize(0) -> if {
        stdlibOption -> portableNativeOutput(stdlibRootStorage!) => stdlibRoot!
    } else {
        compilerDirectory -> stdlibNativePath(stdlibRootStorage!) => stdlibRoot!
    }
    [arguments[0], target -> nativeCliTargetMode, stdlibRoot!; ~] => emitArgv!
    (jobs -> len) > UIntSize(0) -> if {
        emitArgv! -> push("--jobs")
        emitArgv! -> push(jobs)
    }
    sources -> each source { emitArgv! -> push(source) }
    process.RunToFileRequest {
        argv: emitArgv!
        output: llvmPath
    } -> process.runToFile -> processCode => emitCode
    emitCode != 0 -> if {
        "sollang: compiler emission failed" -> println
        emitCode -> return
    }

    Arena(0) => clangPathStorage!
    llvmHome -> nativeClangPath(hostTarget, clangPathStorage!) => clangPath
    [clangPath, llvmPath, optimization, "-Wno-override-module", "-o", output; ~] => clangArgv!
    target == 0 -> if {
        clangArgv! -> push("-Xlinker")
        clangArgv! -> push("/subsystem:console")
        clangArgv! -> push("-lshell32")
    }
    target == 1 -> if { clangArgv! -> push("-Wl,-z,stack-size=67108864") }
    clangArgv! -> process.run -> processCode => clangCode
    clangCode != 0 -> if {
        "sollang: native linker failed with exit code $clangCode" -> println
        clangCode -> return
    }
    (keepTemps and not quiet) -> if {
        "Kept $llvmPath" -> println
    }
    not quiet -> if { "Wrote $output" -> println }
    0
}

executeNativePathBuild sources: [path.Path; ~], output: Text, llvmHome: Text, stdlibOption: Text, optimization: Text, target: Int, hostTarget: Int, jobs: Text, keepTemps: Bool, quiet: Bool -> Int uses Console, File, Process {
    target == 2 -> if {
        "sollang: native CLI wasm linking is not implemented yet" -> println
        -1 -> return
    }
    target != hostTarget -> if {
        "sollang: native CLI cross-target linking is not implemented yet; requested $(target -> nativeTargetName)" -> println
        -1 -> return
    }

    Arena(0) => llvmPathStorage!
    "$output.ll" -> materialize(llvmPathStorage!) => llvmPath
    process.arguments() => arguments
    arguments[0] -> executableDirectory => compilerDirectory
    Arena(0) => stdlibRootStorage!
    "" => stdlibRoot!
    (stdlibOption -> len) > UIntSize(0) -> if {
        stdlibOption -> portableNativeOutput(stdlibRootStorage!) => stdlibRoot!
    } else {
        compilerDirectory -> stdlibNativePath(stdlibRootStorage!) => stdlibRoot!
    }
    [arguments[0], target -> nativeCliTargetMode, stdlibRoot!; ~] => emitArgv!
    (jobs -> len) > UIntSize(0) -> if {
        emitArgv! -> push("--jobs")
        emitArgv! -> push(jobs)
    }
    0 => sourceIndex!
    sourceIndex! < (sources -> len) -> while {
        sources -> pathTextAt(sourceIndex!) => source
        emitArgv! -> push(source)
        sourceIndex! + 1 => sourceIndex!
    }
    process.RunToFileRequest {
        argv: emitArgv!
        output: llvmPath
    } -> process.runToFile -> processCode => emitCode
    emitCode != 0 -> if {
        "sollang: compiler emission failed" -> println
        emitCode -> return
    }

    Arena(0) => clangPathStorage!
    llvmHome -> nativeClangPath(hostTarget, clangPathStorage!) => clangPath
    [clangPath, llvmPath, optimization, "-Wno-override-module", "-o", output; ~] => clangArgv!
    target == 0 -> if {
        clangArgv! -> push("-Xlinker")
        clangArgv! -> push("/subsystem:console")
        clangArgv! -> push("-lshell32")
    }
    target == 1 -> if { clangArgv! -> push("-Wl,-z,stack-size=67108864") }
    clangArgv! -> process.run -> processCode => clangCode
    clangCode != 0 -> if {
        "sollang: native linker failed with exit code $clangCode" -> println
        clangCode -> return
    }
    (keepTemps and not quiet) -> if { "Kept $llvmPath" -> println }
    not quiet -> if { "Wrote $output" -> println }
    0
}

executeNativeProgram output: Text, programArguments: [Text; ~] -> Int uses Process {
    [Text; ~] => runArgv!
    runArgv! -> push(output)
    programArguments -> each programArgument { runArgv! -> push(programArgument) }
    runArgv! -> process.run -> processCode
}

runNativePathCli sources: [path.Path; ~], defaultSource: Text, outputOption: Text, llvmHome: Text, stdlibRoot: Text, optimization: Text, target: Int, hostTarget: Int, jobs: Text, keepTemps: Bool, runAfterBuild: Bool, programArguments: [Text; ~] -> Int uses Console, File, Process {
    Arena(0) => outputStorage!
    (outputOption -> len) > UIntSize(0) -> if {
        sources -> executeNativePathBuild(outputOption, llvmHome, stdlibRoot, optimization, target, hostTarget, jobs, keepTemps, runAfterBuild) => buildCode
        buildCode != 0 -> if {
            buildCode
        } else {
            runAfterBuild -> if {
                outputOption -> executeNativeProgram(programArguments)
            } else { 0 }
        }
    } else {
        defaultSource -> defaultNativeOutput(target, outputStorage!) => output
        sources -> executeNativePathBuild(output, llvmHome, stdlibRoot, optimization, target, hostTarget, jobs, keepTemps, runAfterBuild) => buildCode
        buildCode != 0 -> if {
            buildCode
        } else {
            runAfterBuild -> if {
                output -> executeNativeProgram(programArguments)
            } else { 0 }
        }
    }
}

runNativeCli runAfterBuild: Bool, hostTarget: Int -> Int uses Console, File, Process {
    process.arguments() => arguments
    arguments -> len => argumentCount
    [Text; ~] => sources!
    [Text; ~] => programArguments!
    Arena(0) => projectManifestStorage!
    Arena(0) => projectRootStorage!
    Arena(0) => workspaceManifestStorage!
    Arena(0) => workspaceProjectStorage!
    "" => outputOption!
    "" => llvmHome!
    "" => stdlibRoot!
    "" => jobs!
    "" => projectOption!
    "" => workspaceOption!
    "" => packageOption!
    "" => productOption!
    "" => workspaceSourceDirectory!
    "-O1" => optimization!
    hostTarget => target!
    false => keepTemps!
    false => locked!
    false => library!
    false => parsingProgramArguments!
    0 => status!
    UIntSize(2) => index!

    index! < argumentCount -> while {
        arguments[index!] => argument
        parsingProgramArguments! -> if {
            programArguments! -> push(argument)
        } else {
            argument -> textEquals("--") -> if {
                true => parsingProgramArguments!
            } else {
                ((argument -> textEquals("-o")) or (argument -> textEquals("--output"))) -> if {
                    index! + UIntSize(1) < argumentCount -> if {
                        index! + UIntSize(1) => index!
                        arguments[index!] => outputOption!
                    } else { 1 => status! }
                } else {
                    argument -> textEquals("--llvm") -> if {
                        index! + UIntSize(1) < argumentCount -> if {
                            index! + UIntSize(1) => index!
                            arguments[index!] => llvmHome!
                        } else { 2 => status! }
                    } else {
                        argument -> textEquals("--stdlib") -> if {
                            index! + UIntSize(1) < argumentCount -> if {
                                index! + UIntSize(1) => index!
                                arguments[index!] => stdlibRoot!
                            } else { 3 => status! }
                        } else {
                            argument -> textEquals("--target") -> if {
                                index! + UIntSize(1) < argumentCount -> if {
                                    index! + UIntSize(1) => index!
                                    arguments[index!] -> parseNativeTarget => target!
                                    target! < 0 -> if { 4 => status! }
                                } else { 5 => status! }
                            } else {
                                argument -> textEquals("--jobs") -> if {
                                    index! + UIntSize(1) < argumentCount -> if {
                                        index! + UIntSize(1) => index!
                                        (arguments[index!] -> parsePositiveInt) > 0 -> if {
                                            arguments[index!] => jobs!
                                        } else { 6 => status! }
                                    } else { 6 => status! }
                                } else {
                                    argument -> textEquals("--keep-temps") -> if {
                                        true => keepTemps!
                                    } else {
                                        ((argument -> textEquals("-O0")) or (argument -> textEquals("-O1")) or (argument -> textEquals("-O2")) or (argument -> textEquals("-O3"))) -> if {
                                            argument => optimization!
                                        } else {
                                            argument -> textEquals("--project") -> if {
                                                index! + UIntSize(1) < argumentCount -> if {
                                                    index! + UIntSize(1) => index!
                                                    arguments[index!] => projectOption!
                                                } else { 7 => status! }
                                            } else {
                                                argument -> textEquals("--workspace") -> if {
                                                    index! + UIntSize(1) < argumentCount -> if {
                                                        index! + UIntSize(1) => index!
                                                        arguments[index!] => workspaceOption!
                                                    } else { 7 => status! }
                                                } else {
                                                    argument -> textEquals("--package") -> if {
                                                        index! + UIntSize(1) < argumentCount -> if {
                                                            index! + UIntSize(1) => index!
                                                            arguments[index!] => packageOption!
                                                        } else { 7 => status! }
                                                    } else {
                                                        argument -> textEquals("--product") -> if {
                                                            index! + UIntSize(1) < argumentCount -> if {
                                                                index! + UIntSize(1) => index!
                                                                arguments[index!] => productOption!
                                                            } else { 7 => status! }
                                                        } else {
                                                            argument -> textEquals("--locked") -> if {
                                                                true => locked!
                                                            } else {
                                                                argument -> textEquals("--library") -> if {
                                                                    true => library!
                                                                } else {
                                                                    (argument -> len) > UIntSize(0) and (argument -> byte(UIntSize(0))) == UInt8(45) -> if {
                                                                        8 => status!
                                                                    } else {
                                                                        sources! -> push(argument)
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        index! + UIntSize(1) => index!
    }

    status! != 0 -> if {
        "sollang: invalid or not-yet-native build option (status $(status!))" -> println
        1 -> return
    }
    ((projectOption! -> len) > UIntSize(0) and (workspaceOption! -> len) > UIntSize(0)) -> if {
        "sollang: --project cannot be combined with --workspace" -> println
        1 -> return
    }
    ((sources! -> len) > 0 and ((projectOption! -> len) > UIntSize(0) or (workspaceOption! -> len) > UIntSize(0))) -> if {
        "sollang: --project/--workspace cannot be combined with explicit source files" -> println
        1 -> return
    }
    ((sources! -> len) > 0 and (productOption! -> len) > UIntSize(0)) -> if {
        "sollang: --product requires a project build" -> println
        1 -> return
    }
    ((sources! -> len) > 0 and (packageOption! -> len) > UIntSize(0)) -> if {
        "sollang: --package requires a workspace build" -> println
        1 -> return
    }
    ((packageOption! -> len) > UIntSize(0) and (projectOption! -> len) > UIntSize(0)) -> if {
        "sollang: --package cannot be combined with --project" -> println
        1 -> return
    }
    (locked! and (sources! -> len) > 0) -> if {
        "sollang: --locked requires a project or workspace build" -> println
        1 -> return
    }
    (library! and target! == 2) -> if {
        "sollang: --library currently supports windows-x64 and linux-x64" -> println
        1 -> return
    }
    (not runAfterBuild and parsingProgramArguments!) -> if {
        "sollang: build does not accept program arguments after --" -> println
        1 -> return
    }
    (workspaceOption! -> len) > UIntSize(0) -> if {
        workspaceOption! -> cliWorkspace.load(packageOption!, workspaceManifestStorage!, workspaceProjectStorage!) => workspaceInput!
        workspaceInput!.status != 0 -> if {
            "sollang: invalid workspace manifest or package selection (status $(workspaceInput!.status))" -> println
            1 -> return
        }
        workspaceInput!.projectOption => projectOption!
        workspaceInput!.sourceDirectory => workspaceSourceDirectory!
    }
    (projectOption! -> len) > UIntSize(0) -> if {
        projectOption! -> cliProject.load(productOption!, projectManifestStorage!, projectRootStorage!) => projectInput!
        projectInput!.status != 0 -> if {
            "sollang: invalid project manifest or product selection (status $(projectInput!.status))" -> println
            1 -> return
        }
        projectInput!.multiProduct -> if {
            sources! -> push(projectInput!.source)
        } else {
        (workspaceSourceDirectory! -> len) > UIntSize(0) -> if {
            workspaceSourceDirectory! -> path.fromText(path.nativeStyle())
        } else {
            projectInput!.sourceDirectory -> path.fromText(path.nativeStyle())
        } => projectSourceRoot!
        projectSourceRoot! -> sourceRoot.discoverDirect => projectSourcePaths!
        (projectSourcePaths! -> len) == 0 -> if {
            "sollang: project source root contains no .slg files" -> println
            1 -> return
        }
        projectSourcePaths! -> runNativePathCli(projectInput!.source, outputOption!, llvmHome!, stdlibRoot!, optimization!, target!, hostTarget, jobs!, keepTemps!, runAfterBuild, programArguments!) => projectCode
        projectCode -> return
        }
    }
    (sources! -> len) == 0 -> if {
        "sollang: no source file, sollang.project, or sollang.workspace was found" -> println
        1 -> return
    }
    Arena(0) => outputStorage!
    (outputOption! -> len) > UIntSize(0) -> if {
        outputOption! => output
        sources! -> executeNativeBuild(output, llvmHome!, stdlibRoot!, optimization!, target!, hostTarget, jobs!, keepTemps!, runAfterBuild) => buildCode
        buildCode != 0 -> if { buildCode -> return }
        runAfterBuild -> if {
            output -> executeNativeProgram(programArguments!)
        } else { 0 }
    } else {
        sources![0] -> defaultNativeOutput(target!, outputStorage!) => output
        sources! -> executeNativeBuild(output, llvmHome!, stdlibRoot!, optimization!, target!, hostTarget, jobs!, keepTemps!, runAfterBuild) => buildCode
        buildCode != 0 -> if { buildCode -> return }
        runAfterBuild -> if {
            output -> executeNativeProgram(programArguments!)
        } else { 0 }
    }
}

dispatchArguments: -> Unit uses Console, File, Process {
    sys.process.arguments() => arguments
    (arguments -> len) == UIntSize(2) -> if {
        ((arguments[1] -> textEquals("--version")) or (arguments[1] -> textEquals("-v"))) -> if {
            printVersion()
            process.exit(0)
        }
        ((arguments[1] -> textEquals("--help")) or (arguments[1] -> textEquals("-h")) or (arguments[1] -> textEquals("help"))) -> if {
            printHelp()
            process.exit(0)
        }
    }
    path.nativeStyle() -> when {
        Windows { 0 }
        Posix { 1 }
    } => hostTarget
    arguments[1] -> textEquals("build") -> if {
        false -> runNativeCli(hostTarget) => exitCode!
        exitCode! < 0 -> if { 1 => exitCode! }
        process.exit(exitCode!)
    }
    arguments[1] -> textEquals("run") -> if {
        true -> runNativeCli(hostTarget) => exitCode!
        exitCode! < 0 -> if { 1 => exitCode! }
        process.exit(exitCode!)
    }
    arguments[1] -> textEquals("windows-stdlib") -> if {
        UIntSize(2) -> emitRootAndFiles(0)
        process.exit(0)
    }
    arguments[1] -> textEquals("linux-stdlib") -> if {
        UIntSize(2) -> emitRootAndFiles(1)
        process.exit(0)
    }
    arguments[1] -> textEquals("wasm-stdlib") -> if {
        UIntSize(2) -> emitRootAndFiles(2)
        process.exit(0)
    }
    arguments[1] -> len => targetLength
    UIntSize(2) => optionStart!
    targetLength == UIntSize(13) -> if { UIntSize(5) => optionStart! }
    optionStart! -> configureWorkerLimit => workers
    optionStart! -> sourceStart => pathStart
    workers < 0 -> if {
        "; sollang error: --jobs expects a positive integer" -> println
    } else {
    workers > 0 -> if { "; sollang workers = $workers" -> println }
    targetLength == UIntSize(18) -> if {
        runCodegenUnits()
    } else {
    targetLength == UIntSize(16) -> if {
        runModuleArtifacts()
    } else {
    targetLength == UIntSize(15) -> if {
        runInterfaceCache()
    } else {
    targetLength == UIntSize(11) -> if {
        pathStart -> emitFingerprints
    } else {
    targetLength == UIntSize(13) -> if {
        pathStart -> buildWindows
    } else {
    targetLength == UIntSize(12) -> if {
        pathStart -> emitWindowsRoot
    } else {
    targetLength == UIntSize(10) -> if {
        pathStart -> emitLinuxRoot
    } else {
    targetLength == UIntSize(9) -> if {
        pathStart -> emitWasmRoot
    } else {
    targetLength == UIntSize(5) -> if {
        pathStart -> emitLinuxFiles
    } else {
        targetLength == UIntSize(4) -> if {
            pathStart -> emitWasmFiles
        } else {
            pathStart -> emitWindowsFiles
        }
    }
    }
    }
    }
    }
    }
    }
    }
    }
    }
}

main {
    sys.process.arguments() => arguments
    (arguments -> len) == UIntSize(1) -> if {
        printHelp()
        process.exit(1)
    }
    dispatchArguments()
}
