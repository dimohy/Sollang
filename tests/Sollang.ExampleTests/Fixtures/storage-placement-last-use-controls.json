{
  "schemaVersion": 1,
  "scope": "source-frames",
  "cases": [
    {
      "id": "interpolated-owner-last-use",
      "source": "main {\n    [1, 2] => values\n    \"$(values[0])\" -> println\n    [3; 4] => later\n}\n",
      "warnings": [],
      "expected": [
        "main|slots:16/8",
        "main|alloc:ArrayLiteralExpression@2,0,8",
        "main|alloc:ArrayRepeatExpression@4,0,16",
        "main|end:BindingStatement@4,0,16",
        "main|end:ExpressionStatement@3,0,8"
      ]
    },
    {
      "id": "nested-owner-containing-unit",
      "source": "main {\n    [1, 2] => values\n    true -> if {\n        values[0] -> println\n    } else {\n        0 -> println\n    }\n    [3; 4] => later\n}\n",
      "warnings": [],
      "expected": [
        "main|slots:16/8",
        "main|alloc:ArrayLiteralExpression@2,0,8",
        "main|alloc:ArrayRepeatExpression@8,0,16",
        "main|end:BindingStatement@8,0,16",
        "main|end:ExpressionStatement@3,0,8"
      ]
    },
    {
      "id": "mutable-owner-write-last-use",
      "source": "main {\n    [1, 2] => values!\n    3 => values![0]\n    [4; 4] => later\n}\n",
      "warnings": [],
      "expected": [
        "main|slots:16/8",
        "main|alloc:ArrayLiteralExpression@2,0,8",
        "main|alloc:ArrayRepeatExpression@4,0,16",
        "main|end:BindingStatement@4,0,16",
        "main|end:IndexAssignmentStatement@3,0,8"
      ]
    }
  ]
}
