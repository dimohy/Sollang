native handleFixture from "handle_fixture" {
    handle Counter drop "counter_drop"
    create initial: Int32 -> handleFixture.Counter as "counter_create"
    add self: ref handleFixture.Counter, amount: Int32 -> Int32 as "counter_add"
    dropCount: -> Int32 as "counter_drop_count"
}

exercise: -> Int32 {
    handleFixture.create(40) => counter
    handleFixture.add(counter, 2) => first
    handleFixture.add(counter, 8) => second
    second
}

main {
    exercise => result
    handleFixture.dropCount => drops
    "$result,$drops" -> println
}
