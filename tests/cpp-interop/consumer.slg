main {
    cppFixture.add(20, 22) => answer
    cppFixture.multiply(6, 7) => product
    cppFixture.hypot_squared(3, 4) => squared
    cppFixture.scaleInt32Int32(7, 6) => scaledInteger
    cppFixture.scaleFloat64Float64(1.5, 4) => scaledFloat
    cppFixture.createCounter(40) => counter
    cppFixture.counterAdd(counter, 2) => counterValue

    "$answer" -> println
    "$product" -> println
    Int64(squared) => squaredInteger
    "$squaredInteger" -> println
    "$scaledInteger" -> println
    Int64(scaledFloat) => scaledFloatInteger
    "$scaledFloatInteger" -> println
    "$counterValue" -> println
}
