counterExercise: -> Result<Int32, Int32> {
    cppFixture.createCounter(40)? => counter
    cppFixture.counterAdd(counter, 2) => counterValue
    Result<Int32, Int32>.Ok(counterValue)
}

counterResult result: Result<Int32, Int32> -> Int32 {
    result -> when {
        Result<Int32, Int32>.Ok(value) => value
        Result<Int32, Int32>.Err(error) => -error
    }
}

riskySuccess: -> Result<Int32, Int32> {
    cppFixture.createRiskyCounter(10)? => counter
    cppFixture.riskyCounterAdd(counter, 5)? => value
    Result<Int32, Int32>.Ok(value)
}

riskyConstructorFailure: -> Result<Int32, Int32> {
    cppFixture.createRiskyCounter(-1)? => counter
    Result<Int32, Int32>.Ok(0)
}

riskyMethodFailure: -> Result<Int32, Int32> {
    cppFixture.createRiskyCounter(10)? => counter
    cppFixture.riskyCounterAdd(counter, 13)? => value
    Result<Int32, Int32>.Ok(value)
}

main {
    cppFixture.add(20, 22) => answer
    cppFixture.multiply(6, 7) => product
    cppFixture.hypot_squared(3, 4) => squared
    cppFixture.scaleInt32Int32(7, 6) => scaledInteger
    cppFixture.scaleFloat64Float64(1.5, 4) => scaledFloat
    counterExercise -> counterResult => counterValue
    riskySuccess -> counterResult => riskySuccessValue
    riskyConstructorFailure -> counterResult => riskyConstructorError
    riskyMethodFailure -> counterResult => riskyMethodError
    cppFixture.risky_double(21) -> counterResult => riskyFunctionValue
    cppFixture.risky_double(-1) -> counterResult => riskyFunctionError
    cppFixture.risky_destructions => riskyDestructions

    "$answer" -> println
    "$product" -> println
    Int64(squared) => squaredInteger
    "$squaredInteger" -> println
    "$scaledInteger" -> println
    Int64(scaledFloat) => scaledFloatInteger
    "$scaledFloatInteger" -> println
    "$counterValue" -> println
    "$riskySuccessValue" -> println
    "$riskyConstructorError" -> println
    "$riskyMethodError" -> println
    "$riskyFunctionValue" -> println
    "$riskyFunctionError" -> println
    "$riskyDestructions" -> println
}
