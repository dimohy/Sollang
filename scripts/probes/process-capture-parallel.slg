import sys.process as process

double value: Int -> Int => value * 2
square value: Int -> Int => value * value

main {
    7 -> parallel branch {
        doubled: ref -> double
        squared: ref -> square
    } => results
    results.doubled -> println
    results.squared -> println
    process.command("/bin/echo") => command!
    command! -> arg("ok")
    command! -> collect(process.CaptureLimits {
        standardOutputBytes: 128
        standardErrorBytes: 128
    }) -> when {
        Ok(output) { output.standardOutput -> len -> println }
        Err(error) { error -> println }
    }
}
