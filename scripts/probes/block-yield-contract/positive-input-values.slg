struct Algorithms { }

impl Algorithms {
    evaluate<T>: self, value: T -> Int block item: ref T -> Bool {
        value -> yield => matches
        matches -> if { 7 } else { 9 }
    }
}

countValue value: Text -> Int block item: ref UIntSize -> Bool {
    value -> len => count
    count -> yield => matches
    matches -> if { 7 } else { 9 }
}

main {
    Algorithms { } => algorithms
    algorithms -> evaluate(1) item { item > 0 } => scalar
    "abc" -> countValue item { item == 3 } => converted
    "$scalar,$converted" -> println
}
