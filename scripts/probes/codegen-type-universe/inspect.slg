    records! -> keys.appendTypeUniverseRecord(plans.KeyPart.TypeStructs, 2001, -1, values12) -> when {
        Ok {}
        Err(_) { "invalid-record" -> println
            process.exit(1) }
    }
    records! -> keys.typeUniverseFields -> when {
        Ok(fields) { fields -> each field { field -> show } }
        Err(_) { "invalid-fields" -> println
