    records! -> keys.typeUniverseFields -> when {
        Ok(fields) { fields -> each field { field -> show } }
        Err(_) { "invalid-fields" -> println
            process.exit(1) }
    }
    records! -> keys.typeUniverseHash -> when {
        Ok(hash) { keys.hexField(hash) => field
            field -> show }
        Err(_) { "invalid-hash" -> println
            process.exit(1) }
    }
}

main {
    case0()
    case1()
    case2()
    case3()
    case4()
    case5()
    case6()
    case7()
    case8()
}
