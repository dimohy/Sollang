import sollang.compiler.llvm.codegen_cache_keys as keys
import sollang.compiler.llvm.codegen_cache_key_policy as plans
import sys.file as file
import sys.process as process

bindings parts: [plans.KeyPart], values: [Text] -> [keys.Binding; ~] {
    [keys.Binding; ~] => bindings!
    0 => ordinal!
    parts -> each part {
        bindings! -> push(keys.Binding { part: part, fields: [keys.textField(values[ordinal!]); ~] })
        ordinal! + 1 => ordinal!
    }
    bindings!
}

show field: ref keys.Field -> Unit uses Console {
    field.bytes -> file.borrowBytes => bytes
    bytes -> slice(0, bytes -> len) -> println
}

case0: -> Unit uses Console, Process {
    keys.TypeUniverseRecords { categories: [plans.KeyPart; ~], typeIds: [Int; ~], memberOrdinals: [Int; ~], fields: [keys.Field; ~] } => records!
    [plans.KeyPart.TypeId, plans.KeyPart.TypeKey, plans.KeyPart.TypeValue, plans.KeyPart.TypeKeySize, plans.KeyPart.TypeKeyAlignment, plans.KeyPart.TypeValueOffset, plans.KeyPart.TypeValueSize, plans.KeyPart.TypeValueAlignment, plans.KeyPart.TypeEntryStride] -> bindings(["2009", "2", "3", "4", "4", "4", "1", "1", "8"]) => values0
    records! -> keys.appendTypeUniverseRecord(plans.KeyPart.TypeDictionaries, 2009, -1, values0) -> when {
        Ok {}
        Err(_) { "invalid-record" -> println
            process.exit(1) }
    }
    [plans.KeyPart.TypeId, plans.KeyPart.TypeElement, plans.KeyPart.TypeSize, plans.KeyPart.TypeAlignment] -> bindings(["2008", "2", "4", "4"]) => values1
