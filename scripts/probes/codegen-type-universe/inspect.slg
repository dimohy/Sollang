        Ok {}
        Err(_) { "invalid-record" -> println
            process.exit(1) }
    }
    [plans.KeyPart.TypeId, plans.KeyPart.TypeName, plans.KeyPart.TypeModule, plans.KeyPart.TypePayloadWords] -> bindings(["2002", "Choice", "cache.types", "1"]) => values9
    records! -> keys.appendTypeUniverseRecord(plans.KeyPart.TypeEnums, 2002, -1, values9) -> when {
        Ok {}
        Err(_) { "invalid-record" -> println
            process.exit(1) }
    }
    [plans.KeyPart.TypeFieldIndex, plans.KeyPart.MemberName, plans.KeyPart.MemberType] -> bindings(["0", "head", "2"]) => values10
    records! -> keys.appendTypeUniverseRecord(plans.KeyPart.TypeStructs, 2001, 0, values10) -> when {
