        Ok {}
        Err(_) { "invalid-record" -> println
            process.exit(1) }
    }
    [plans.KeyPart.TypeId, plans.KeyPart.TypeElement, plans.KeyPart.TypeSize, plans.KeyPart.TypeAlignment, plans.KeyPart.TypeLength] -> bindings(["2006", "2", "4", "4", ""]) => values2
    records! -> keys.appendTypeUniverseRecord(plans.KeyPart.TypeStaticArrays, 2006, -1, values2) -> when {
