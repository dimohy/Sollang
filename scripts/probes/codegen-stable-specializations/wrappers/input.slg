namespace cache.wrapper_specialization

public wrap<T> value: T -> Option<T> { Option<T>.Some(value) }
public none<T> value: T -> Option<T> { Option<T>.None }
public ok<T, U> value: T, error: U -> Result<T, U> { Result<T, U>.Ok(value) }
public fail<T, U> value: T, error: U -> Result<T, U> { Result<T, U>.Err(error) }

main {
    wrap(9) -> when { Some(value) { value } None { 0 } } => first
    wrap(false) -> when { Some(value) { value } None { true } } => flag
    wrap(10) -> when { Some(value) { value } None { 0 } } => repeated
    none(1) -> when { Some(value) { value } None { 0 } } => empty
    ok(7, false) -> when { Ok(value) { value } Err(_) { 0 } } => success
    fail(7, true) -> when { Ok(_) { false } Err(value) { value } } => failure
    "$first,$flag,$repeated,$empty,$success,$failure" -> println
}
