namespace cache.value_specialization

size<N> values: ref [Int; N] -> Int where N: Int { N }
first<N, T> values: ref [T; N] -> T where N: Int { values[0] }
additional<N> seed: Int, values: ref [Int; N] -> Int where N: Int { seed + values[0] + N }
repeat<N> value: Int -> [Int; N] where N: Int { [value; N] }

main {
    [1, 2, 3] => ints
    [0; 0] => empty
    [UInt8(7), 8] => bytes
    ints -> size<3> => count
    empty -> size<0> => zero
    ints -> first<3> => integer
    bytes -> first<2> => byte
    10 -> additional<3>(ints) => total
    9 -> repeat<4> => repeated
    6 -> repeat<2> => short
    "$count,$zero,$integer,$byte,$total,$(repeated[0]),$(short[0])" -> println
}
