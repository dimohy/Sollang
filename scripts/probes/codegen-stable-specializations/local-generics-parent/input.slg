namespace cache.local_generic_parent

outer<T> value: T -> T {
    inner<U> item: U -> T { value }
    true -> inner
}

parameters<T> value: T -> T {
    same item: T -> T { item }
    choose<U> item: T, ignored: U -> T { item -> same }
    value -> choose(true)
}

main {
    7 -> outer -> println
    9 -> parameters -> println
}
