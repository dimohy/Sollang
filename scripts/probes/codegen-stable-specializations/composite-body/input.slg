namespace cache.composite_specialization

struct Point { value: Int }
public identity<T> value: T -> T { value }

main {
    identity(Point { value: 7 }) => point
    identity([1, 2, 3]) => fixed
    identity(Option<Int>.Some(4)) => optional
    identity((left: 5, flag: true)) => product
    optional -> when { Some(value) { value } None { 0 } } => number
    "$(point.value),$(fixed[1]),$number,$(product.left)" -> println
}
