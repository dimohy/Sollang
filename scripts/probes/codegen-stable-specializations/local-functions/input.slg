namespace cache.local_functions

outer value: Int -> Int {
    inner item: Int -> Int {
        deepest leaf: Int -> Int { leaf + 1 }
        item -> deepest
    }
    value -> inner
}

other value: Int -> Int {
    inner item: Int -> Int { item + 2 }
    value -> inner
}

main {
    outer(4) => first
    other(4) => second
    "$first,$second" -> println
}
