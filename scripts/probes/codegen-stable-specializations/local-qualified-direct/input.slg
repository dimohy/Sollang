namespace cache.local_qualified_direct

top.step value: Int -> Int { value + 20 }

outer value: Int -> Int {
    internal.step item: Int -> Int { item + 3 }
    internal.twice item: Int -> Int { item * 2 }
    nested item: Int -> Int { internal.step(item) }
    internal.twice(nested(value))
}

main {
    outer(4) -> println
    top.step(2) -> println
}
