namespace cache.local_generic_values

first value: Int -> Int {
    duplicate<N> item: Int -> [Int; N] where N: Int { [item; N] }
    value -> duplicate<2> => duplicateed
    duplicateed[1]
}

second value: Int -> Int {
    duplicate<N> item: Int -> [Int; N] where N: Int { [item + 10; N] }
    value -> duplicate<2> => duplicateed
    duplicateed[0]
}

capture value: Int -> Int {
    count<N> item: Int -> Int where N: Int { item + value + N }
    2 -> count<3>
}

main {
    first(7) -> println
    second(7) -> println
    capture(7) -> println
}
