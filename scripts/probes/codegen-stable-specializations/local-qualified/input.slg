namespace cache.local_qualified

left value: Int -> Int {
    internal.step item: Int -> Int { item + 3 }
    value -> internal.step
}

right value: Int -> Int {
    internal.step item: Int -> Int { item + 10 }
    value -> internal.step
}

capturing value: Int -> Int {
    internal.step item: Int -> Int { item + value }
    2 -> internal.step
}

main {
    left(4) -> println
    right(4) -> println
    capturing(4) -> println
}
