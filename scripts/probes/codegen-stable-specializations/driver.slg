import sollang.compiler.llvm.codegen_type_registration as typeRegistration
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.ir.typed as typedIr
import sollang.compiler.semantic.expression_type_ids as expressionIds
import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.reference_prepared_type_ids as referenceIds
import sollang.compiler.semantic.type_fact_concreteness as concreteness
import sollang.compiler.semantic.modules as moduleNames
import sollang.compiler.llvm.codegen_cache_keys as keys
import sollang.compiler.source_root as sourceRoot
import sys.file as file
import sys.path as path
import sys.process as process

inspect: -> Unit uses Console, File, Process {
    keys.textField("가𐐀a") => unicode
    unicode.bytes -> keys.stableUtf16Length => utf16
    utf16 != 4 -> if { process.exit(4) -> return }
    [path.Path; ~] => orderControl!
    orderControl! -> push(path.fromText(".slg", path.nativeStyle()))
    orderControl! -> push(path.fromText("𐀀.slg", path.nativeStyle()))
    orderControl! -> sourceRoot.referenceOrder => ordered
    ordered[0] != 1 or ordered[1] != 0 -> if { process.exit(4) -> return }
    "utf16:$utf16" -> println
    process.arguments() => arguments
    arguments[1] -> path.fromText(path.nativeStyle()) -> sourceRoot.discoverDirect => paths
    [file.SourceText; ~] => owners!
    paths -> sourceRoot.referenceOrder -> each index { paths[index] -> pathText -> file.mapText => owner
        owners! -> push(owner) }
    arguments[2] -> file.mapText => fixture
    owners! -> push(fixture)
    [Text; ~] => sources!
    owners! -> each owner { owner -> slice(0, owner -> len) => source
        sources! -> push(source) }
    sources! -> semanticContext.prepare -> expressionIds.resolveCallContext => callContext
    callContext.prepared => prepared
    callContext.types => resolved!
    prepared -> referenceIds.registerMetadataSignatures -> when {
        Err(_) { process.exit(1) -> return }
        Ok(value) { value }
    } => identities
    prepared -> referenceIds.register -> when {
        Err(_) { process.exit(5) -> return }
        Ok(value) { value }
    } => declaredIdentities
    [moduleNames.ModuleIdentity; ~] => modules!
    prepared.modules -> each module { modules! -> push(module) }
    [moduleNames.ImportEdge; ~] => imports!
    prepared.imports -> each edge { imports! -> push(edge) }
    keys.TypeFieldContext { identities: modules!, imports: imports!, sourceModule: 0, ownerSymbol: -1 } => context!
    concreteness.classify(prepared.semantic.types, prepared.semantic.fields) => states
    (prepared.package.ranges -> len) - 1 => fixtureModule
    fixtureModule => context!.sourceModule
    prepared -> typedIr.lowerResolvedContext(resolved!) => ir!
    ir! -> typedIr.materializeGenericClosure(prepared, resolved!) => instances
    [typeIds.SemanticType; ~] => types!
    resolved!.types -> each type { types! -> push(type) }
    ir! -> typedIr.planResolvedGenericCalls(prepared, resolved!) => plans
    typeIds.SemanticTypeSet { types: types!, references: resolved!.references, fields: resolved!.fields } => semantic!
    [Int; ~] => functionIdentities!
    (arguments -> len) == 3 or ((arguments -> len) > 3 and (arguments[3] == "whole-type-uses" or arguments[3] == "all-user-functions"))
        -> if {
            prepared -> referenceIds.registerDeclarations -> when {
                Err(_) { process.exit(6) -> return }
                Ok(value) { value }
            } => declarations
            prepared -> typeRegistration.collect(resolved!, ir!, semantic!.types, plans, declarations.ids) => bodyUses
            [Int; ~] => roots!
            bodyUses.uses -> each use { roots! -> push(use.typeId) }
            prepared -> referenceIds.registerResolvedTypeUses(semantic!, roots!) -> when {
                Err(_) { "registration-error" -> println
                    process.exit(6) -> return }
                Ok(value) { value }
            } => registered
            bodyUses.unresolvedCalls != 0 -> if { process.exit(6) -> return }
            registered.ids -> each identity { functionIdentities! -> push(identity) }
            (arguments -> len) > 3 and arguments[3] == "whole-type-uses"
                -> if {
                    "declaration-next:$(declarations.nextTypeId)" -> println
                    "unresolved-plans:$(bodyUses.unresolvedCalls)" -> println
                    "value-calls:$(bodyUses.valueCalls)" -> println
                    bodyUses.unresolvedNodes -> each node {
                        "unresolved-call:$(ir![node].sourceModule):$(ir![node].astNode):$(ir![node].targetModule):$(ir![node].symbol)" -> println
                    }
                    [Int; ~] => typeByIdentity!
                    0..<(registered.nextTypeId - declarations.nextTypeId) -> each index { typeByIdentity! -> push(-1) }
                    0..<(semantic!.types -> len) -> each typeId {
                        registered.ids[typeId] >= declarations.nextTypeId and semantic!.types[typeId].kind != 11
                            -> if {
                                typeId => typeByIdentity![registered.ids[typeId] - declarations.nextTypeId]
                            }
                    }
                    0..<(typeByIdentity! -> len) -> each index {
                        typeByIdentity![index] < 0 -> if { process.exit(6) -> return }
                        context! -> keys.resolvedStableTypeIdentityField(prepared.package, semantic!, typeByIdentity![index], identities.ids) -> when {
                            Err(_) { process.exit(6) -> return }
                            Ok(field) {
                                field.bytes -> file.borrowBytes => bytes
                                bytes -> slice(0, bytes -> len) => identity
                                "registered-body:$(declarations.nextTypeId + index):$identity" -> println
                            }
                        }
                    }
                    bodyUses.uses -> each use {
                        "use:$(use.sourceModule):$(use.astNode):$(use.start):$(use.end):$(use.order):$(registered.ids[use.typeId])" -> println
                    }
                    return
                }
        }
    (arguments -> len) > 3 and arguments[3] == "registry-type-uses"
        -> if {
            [Int; ~] => uses!
            plans -> each plan {
                plan.templateNode >= 0 and plan.templateNode < (ir! -> len) and ir![plan.templateNode].sourceModule == fixtureModule
                    -> if {
                        plan.status != 0 -> if { process.exit(6) -> return }
                        plan.actualInputs -> each actual {
                            false => seen!
                            uses! -> each previous { previous == actual -> if { true => seen! } }
                            not seen! -> if { uses! -> push(actual) }
                        }
                    }
            }
            prepared -> referenceIds.registerDeclarations -> when {
                Err(_) { process.exit(6) -> return }
                Ok(value) { "declaration-next:$(value.nextTypeId)" -> println }
            }
            prepared -> referenceIds.registerResolvedTypeUses(semantic!, uses!) -> when {
                Err(_) { process.exit(6) -> return }
                Ok(value) { value }
            } => registered
            uses! -> each actual {
                context! -> keys.resolvedStableTypeIdentityField(prepared.package, semantic!, actual, identities.ids) -> when {
                    Err(_) { process.exit(6) -> return }
                    Ok(field) {
                        field.bytes -> file.borrowBytes => bytes
                        bytes -> slice(0, bytes -> len) => identity
                        "registered-use:$(registered.ids[actual]):$identity" -> println
                    }
                }
            }
            return
        }
    (arguments -> len) > 3 and arguments[3] == "call-input-types"
        -> if {
            plans -> each plan {
                plan.templateNode >= 0 and plan.templateNode < (ir! -> len) and ir![plan.templateNode].sourceModule == fixtureModule
                    -> if {
                        plan.status != 0 -> if { process.exit(6) -> return }
                        plan.actualInputs -> each actual {
                            context! -> keys.resolvedStableTypeIdentityField(prepared.package, semantic!, actual, identities.ids) -> when {
                                Err(_) { "argument-error:$actual" -> println
                                    process.exit(6) -> return }
                                Ok(field) {
                                    field.bytes -> file.borrowBytes => bytes
                                    bytes -> slice(0, bytes -> len) => identity
                                    "argument:$identity" -> println
                                }
                            }
                        }
                    }
            }
            return
        }
    (arguments -> len) > 3 and arguments[3] == "all-user-functions" => allFunctions
    ir! -> typedIr.bindGenericBodies(instances, prepared.interpolations -> len) => bodies
    instances -> each instance {
        ir![instance.templateNode].sourceModule == fixtureModule
            -> if {
                "materialized:$(instance.functionNode):$(instance.templateNode):$(instance.ownerFunction):$(instance.status)" -> println
            }
    }
    context! -> keys.collectCompilationFunctions(prepared, semantic!, ir!, plans, functionIdentities!, identities.ids, bodies) => collected
    collected.functions -> each function {
        allFunctions or function.sourceModule == fixtureModule
            -> if {
                function.identity.bytes -> file.borrowBytes => bytes
                bytes -> slice(0, bytes -> len) => identity
                "function:$identity" -> println
            }
    }
    collected.failures -> each failure {
        "function-capture-error:$(failure.sourceModule):$(failure.ownerSymbol):$(failure.stage)" -> println
    }
    (collected.failures -> len) != 0 -> if { process.exit(6) -> return }
    allFunctions -> if {
        context! -> keys.captureFunctionEmissions(prepared, collected) -> when {
            Err(_) { "function-emission-error" -> println
                process.exit(6) -> return }
            Ok(emissions) { emissions -> each emission {
                    emission.identity.bytes -> file.borrowBytes => bytes
                    bytes -> slice(0, bytes -> len) => identity
                    "emission:$(emission.hash):$identity" -> println
            } }
        }
        return
    }
    0 => context!.sourceModule
    -1 => context!.ownerSymbol
    0 => typeId!
    prepared.semantic.types -> each type {
        false => constraint!
        type.kind == 1 and (type.origin == 0 or type.origin == 2) and type.module >= 0 and type.symbol >= 0
            -> if { prepared.package.symbols[prepared.package.ranges[type.module].symbolStart + type.symbol].kind == 5 => constraint! }
        not constraint! and type.kind != 11 and (states[typeId!] == 0 or (type.containsParameter and identities.ids[typeId!] >= 0))
            -> if {
                context! -> keys.resolvedStableTypeIdentityField(prepared.package, prepared.semantic, typeId!, identities.ids) -> when {
                    Err(_) { "error:$(typeId!):$(type.kind):$(type.origin):$(type.first):$(type.second)" -> println }
                    Ok(field) {
                        field.bytes -> file.borrowBytes => bytes
                        bytes -> slice(0, bytes -> len) => identity
                        "stable:$(typeId!):$identity" -> println
                        declaredIdentities.ids[typeId!] >= 0 -> if { "registered:$(declaredIdentities.ids[typeId!]):$identity" -> println }
                    }
                }
            }
        typeId! + 1 => typeId!
    }
}
main { inspect() }
