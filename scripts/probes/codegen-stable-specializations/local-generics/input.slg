namespace cache.local_generics

left value: Int -> Int {
    transform<T> item: T -> T { item }
    value -> transform
}

right value: Int -> Int {
    transform<T> item: T -> Int { 100 }
    value -> transform
}

capturing value: Int -> Int {
    add<T> item: T -> Int { item + value }
    5 -> add
}

sibling value: Int -> Int {
    helper item: Int -> Int { item + 2 }
    internal.apply<T> item: T -> Int { helper(item) }
    value -> internal.apply
}

main {
    left(7) -> println
    right(7) -> println
    capturing(7) -> println
    sibling(7) -> println
}
