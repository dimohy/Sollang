namespace cache.inferred_controls

increment value: -> { value + 1 }
typed value: Int -> { value + 2 }
result value: -> Int { value + 3 }
truth: -> { true }
public explicit value: Int -> Int { value }

main {
    increment(7) => first
    typed(first) => second
    result(second) => third
    truth() => flag
    explicit(third) => control
    "$first,$second,$third,$flag,$control" -> println
}
