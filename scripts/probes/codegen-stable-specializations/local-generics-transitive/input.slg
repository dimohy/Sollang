namespace cache.local_generic_transitive

outer value: Int -> Int {
    helper item: Int -> Int { item + value }
    apply<T> item: T -> Int { helper(item) }
    choose<A, B> item: A, other: B -> B { other }
    5 -> apply => first
    true -> choose(9) => second
    first + second
}

main { outer(7) -> println }
