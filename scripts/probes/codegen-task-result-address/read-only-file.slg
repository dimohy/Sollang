import sys.file as file

main {
    "examples/regression/48-box-owned-values.slg" => path
    file.openReadAsync(path) -> await -> when {
        Ok(reader) {
            [UInt8(0); ~] => buffer
            reader -> readIntoAtAsync(buffer, 0, false) -> await -> when {
                Ok(read) { "read=$(read.buffer[0]),count=$(read.count)" -> println }
                Err(error) { "unexpected read failure" -> println }
            }
        }
        Err(error) { "unexpected open failure" -> println }
    }
    file.openReadAsync(path) => unfinished
    "scope joins and drops the open result" -> println
}
