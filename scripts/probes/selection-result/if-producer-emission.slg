import sollang.compiler.llvm.text as compiler

main {
    """
    check value: Bool -> Result<Bool, Int> => Result<Bool, Int>.Ok(value)
    
    reportResult value: Bool -> Unit uses Console {
        value -> check -> when {
            Ok(value) { value }
            Err(error) { false }
        } -> if {
            "yes"
        } else {
            "no"
        } -> println
    }
    
    main {
        true -> check -> when {
            Ok(value) { value }
            Err(error) { false }
        } -> if {
            "yes"
        } else {
            "no"
        } -> println
        false -> check -> when {
            Ok(value) { value }
            Err(error) { false }
        } -> if {
            "yes"
        } else {
            "no"
        } -> println
        true -> reportResult
        false -> reportResult
        true -> if {
            true -> check -> when {
                Ok(value) { value }
                Err(error) { false }
            } -> if {
                "yes"
            } else {
                "no"
            } -> println
        }
    }
    """ => input
    [input,; ~] => sources
    sources -> compiler.emit
}
