import std.compress.zstd.fse as fse

probe input: [UInt8] -> Result<Int, fse.Failure> {
    fse.decodeReverse(input, 0, 1) -> when {
        Err(error) { Result<Int, fse.Failure>.Err(error) -> return }
        Ok(reader) { reader }
    } => reader!
    reader! -> read(input, 1) -> when {
        Err(error) { Result<Int, fse.Failure>.Err(error) -> return }
        Ok(value) { value }
    } => value
    Result<Int, fse.Failure>.Ok(value)
}

makeInput: -> [UInt8; 1] => [3]

main {
    makeInput() -> probe -> when {
        Err(_) { "failed" -> println }
        Ok(value) { "value=$value" -> println }
    }
}
