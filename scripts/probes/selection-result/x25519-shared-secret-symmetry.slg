import std.crypto.x25519 as x25519

# Compare both sides of deterministic key agreement without exposing key bytes.
main {
    [UInt8(1); 32] => clientScalar
    [UInt8(2); 32] => serverScalar
    clientScalar -> x25519.publicKey => clientPublic
    serverScalar -> x25519.publicKey => serverPublic
    x25519.scalarMultiply(clientScalar, serverPublic) => clientShared
    x25519.scalarMultiply(serverScalar, clientPublic) => serverShared

    true => matches!
    0 => index!
    index! < 32 -> while {
        clientShared[index!] == serverShared[index!] -> unless { false => matches! }
        index! + 1 => index!
    }
    "shared-secret-equal=$(matches!)" -> println
}
