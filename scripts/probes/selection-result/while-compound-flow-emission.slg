import sollang.compiler.llvm.text as compiler

main {
    """
    double value: Int -> Int => value * 2
    increment value: Int -> Int => value + 1

    main {
        UIntSize(0) => count!
        count! < 2 -> while { count! + 1 => count! }
        "while-count=$(count!)" -> println
        UIntSize(0) => index!
        index! < 1 and "a" -> byte(index!) >= 97 and "a" -> byte(index!) <= 122
            -> while { index! + 1 => index! }
        "index=$(index!)" -> println
        3 -> double -> increment -> println
    }
    """ => input
    [input,; ~] => sources
    sources -> compiler.emitChecked => diagnosticCount
    diagnosticCount != 0 -> if { "while-emission-rejected" -> println }
}
