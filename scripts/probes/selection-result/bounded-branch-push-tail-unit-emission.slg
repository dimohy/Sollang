import sollang.compiler.llvm.text as compiler

main {
    """
    struct Binding {
        status: Int
    }

    main {
        Binding { status: 0 } => binding!
        [Int; <=2] => values!
        binding!.status == 0 and (values! -> len) == 0
            -> if {
                values! -> push(4)
            } else {
                5 => binding!.status
            }
        "count=$(values! -> len),value=$(values![0]),status=$(binding!.status)" -> println
    }
    """ => input
    [input,; ~] -> compiler.emitChecked => diagnosticCount
    diagnosticCount != 0 -> if { "push-result-emission-rejected" -> println }
}
