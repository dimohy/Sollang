import sollang.compiler.llvm.text as compiler

main {
    """
    enum Choice {
        Read
        Constant
    }

    struct Token {
        value: Int
    }

    readToken: -> Result<Token, Text> {
        Result<Token, Text>.Ok(Token { value: 7 })
    }

    choose choice: Choice -> Result<Int, Text> {
        choice -> when {
            Read {
                readToken()? => token
                Result<Int, Text>.Ok(token.value) -> return
            }
            Constant { Result<Int, Text>.Ok(9) }
        }
    }

    main {
        choose(Choice.Read) -> when {
            Ok(value) { "read=$value" -> println }
            Err(error) { "read-error=$error" -> println }
        }
        choose(Choice.Constant) -> when {
            Ok(value) { "constant=$value" -> println }
            Err(error) { "constant-error=$error" -> println }
        }
    }
    """ => input
    [input,; ~] => sources
    sources -> compiler.emitChecked => diagnosticCount
    diagnosticCount != 0 -> if { "selection-emission-rejected" -> println }
}
