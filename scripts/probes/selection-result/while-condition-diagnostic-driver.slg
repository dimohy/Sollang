import sollang.compiler.probes.while_condition as checks

main {
    """
    main {
        1 -> while { "bad" -> println }
    }
    """ -> checks.check(18) => integerRejected
    """
    main {
        "bad" -> while { "bad" -> println }
    }
    """ -> checks.check(18) => textRejected
    """
    main {
        false -> while { "unused" -> println }
    }
    """ -> checks.check(0) => booleanAccepted
    """
    main {
        UIntSize(0) => index!
        index! < 1 and "a" -> byte(index!) >= 97 and "a" -> byte(index!) <= 122
            -> while { index! + 1 => index! }
    }
    """ -> checks.check(0) => compoundAccepted
    "while-condition=$(integerRejected and textRejected and booleanAccepted and compoundAccepted)" -> println
}
