import sollang.compiler.llvm.text as compiler

main {
    """
    rebind<T, S> value: T, initial: S -> S {
        initial => current!
        value => current!
        current!
    }

    main {}
    """ => input
    [input,; ~] -> compiler.emitChecked => diagnosticCount
    diagnosticCount != 0 -> if { "unused-generic-rebind-rejected" -> println }
}
