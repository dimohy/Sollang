import sys.file as file

borrowText value: Text -> Int { 13 }

borrowLength value: Text -> UIntSize {
    value -> file.borrowText => source
    source -> len
}

directBorrowLength value: Text -> UIntSize {
    file.borrowText(value) => source
    source -> len
}

main {
    borrowLength("abcd") => flowLength
    directBorrowLength("abc") => callLength
    "x" -> borrowText => userValue
    "flow=$flowLength,call=$callLength,user=$userValue" -> println
}
