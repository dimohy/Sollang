import std.compress.brotli.compressed_header as header

main {
    header.Limits {
        maxBlockTypes: 256
        maxBlockLength: 16_793_840
        maxContextEntries: 16_384
        maxTrees: 256
        maxTableEntries: 1_080
        maxTotalTableEntries: 276_480
    } -> parser -> when {
        Ok(parser) { "brotli-parser=true" -> println }
        Err(error) { "brotli-parser=false" -> println }
    }
}
