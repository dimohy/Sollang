import sollang.compiler.llvm.text as compiler

main {
    """
    main {
        UIntSize(0) => count!
        count! < 2 -> while {
            count! + 1 => count!
        }
        "while-count=$(count!)" -> println
    }
    """ => input
    [input,; ~] => sources
    sources -> compiler.emitChecked => diagnosticCount
    diagnosticCount != 0 -> if { "while-emission-rejected" -> println }
}
