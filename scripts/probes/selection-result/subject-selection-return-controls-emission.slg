import sollang.compiler.llvm.text as compiler

main {
    """
    # Compare a tail selection with an explicitly bound selection result.
    chooseInt value: Int -> Int {
        value -> when {
            == 0 { 7 }
            else { 9 }
        }
    }

    chooseBound value: Int -> Int {
        value -> when {
            == 0 { 7 }
            else { 9 }
        } => selected
        selected
    }

    main {
        "integer=$(chooseInt(0)),$(chooseInt(2))" -> println
        "bound=$(chooseBound(0)),$(chooseBound(2))" -> println
    }
    """ => input
    [input,; ~] => sources
    sources -> compiler.emitChecked => diagnosticCount
    diagnosticCount != 0 -> if { "selection-emission-rejected" -> println }
}
