struct Bucket {
    value: Int
}

impl Bucket {
    push: self, value: Int -> Int => self.value + value
}

struct Holder {
    field: Bucket
}

impl Holder {
    push: self, value: Int -> Int => self.field -> push(value)
}

main {
    Holder { field: Bucket { value: 5 } } -> push(4) => result
    "projected=$result" -> println
}
