import sollang.compiler.semantic.analysis as analysis
import sys.file as file

main {
    "P:/MyWorks/Sollang/stdlib/std/text/json.slg" -> file.mapText => owner
    [owner,; ~] -> analysis.analyzeSources => package
    package.symbols[386] => declaration
    package.sources[0] -> len => length
    package.sources[0] -> slice(0, length) => source
    package.tokens[declaration.nameToken] => name
    source -> slice(name.span.start, name.span.length) => nameText
    declaration.secondaryTypeNode >= 0 -> if { declaration.secondaryTypeNode } else { declaration.typeNode } => resultAst
    package.nodes[resultAst] => result
    source -> slice(result.start, result.length) => resultText
    "name=$nameText" -> println
    "result=$resultText" -> println
}
