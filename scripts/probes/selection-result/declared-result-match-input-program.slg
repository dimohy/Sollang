struct Reader {
    value: Int
}

impl Reader {
    read: self -> Result<Int, Text> => Result<Int, Text>.Ok(self.value)
}

consume value: Int -> Int => value + 1

main {
    Reader { value: 3 } -> read -> when {
        Err(_) { 0 }
        Ok(state) { state }
    } => first
    first -> consume => result
    "result=$result" -> println
}
