struct Binding {
    status: Int
    offset: UIntSize
}

main {
    Binding { status: 0, offset: 0 } => binding!
    [Text; ~] => texts!
    binding!.status == 0 and binding!.offset == 0
        -> if {
            true -> if {
                false -> if {
                    1 => binding!.status
                } else {
                    "a" -> len => binding!.offset
                }
                texts! -> push("x")
            } else {
                4 => binding!.status
            }
        } else {
            5 => binding!.status
        }
    "count=$(texts! -> len),status=$(binding!.status)" -> println
}
