struct Reader {
    value: Int
}

impl Reader {
    read: self -> Result<Int, Text> => Result<Int, Text>.Ok(self.value)
}

consume value: Int -> Int => value + 1

run reader: Reader -> Result<Int, Text> {
    reader -> read -> when {
        Err(error) { Result<Int, Text>.Err(error) -> return }
        Ok(state) { state }
    } => first
    first -> consume => result
    Result<Int, Text>.Ok(result)
}

main {
    Reader { value: 3 } -> run -> when {
        Err(error) { error -> println }
        Ok(result) { "result=$result" -> println }
    }
}
