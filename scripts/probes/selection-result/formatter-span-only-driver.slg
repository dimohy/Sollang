import sollang.compiler.cli_format as formatter
import sys.file as file

main {
    """
    check: -> Result<Bool, Int> => Result<Bool, Int>.Ok(true)

    main {
        check() -> when {
            Ok(value) { value }
            Err(error) { false }
        } -> if {
            "yes"
        } else {
            "no"
        } -> println
    }
    """ => original
    original -> file.borrowText => source
    source -> formatter.traceFormatSpans
}
