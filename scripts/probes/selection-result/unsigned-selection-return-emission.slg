import sollang.compiler.llvm.text as compiler

main {
    """
    # Selection must return its selected arm value, including unsigned scalar types.
    choose value: UInt64 -> UInt64 {
        value -> when {
            == 0 { 1 }
            == 1 { 1 }
            == 2 { 0 }
            == 3 { 1 }
            == 4 { 0 }
            else { 1 }
        }
    }

    main {
        "selected=$(choose(0)),$(choose(2)),$(choose(3)),$(choose(4)),$(choose(5))" -> println
    }
    """ => input
    [input,; ~] => sources
    sources -> compiler.emitChecked => diagnosticCount
    diagnosticCount != 0 -> if { "selection-emission-rejected" -> println }
}
