import sollang.compiler.llvm.text as compiler

main {
    """
    main {
        1 -> while { "bad" -> println }
    }
    """ => integerSource
    [integerSource,; ~] => integerSources
    integerSources -> compiler.emitChecked => integerDiagnostics
    "rejected=$integerDiagnostics" -> println
    """
    main {
        "bad" -> while { "bad" -> println }
    }
    """ => textSource
    [textSource,; ~] => textSources
    textSources -> compiler.emitChecked => textDiagnostics
    "rejected=$textDiagnostics" -> println
}
