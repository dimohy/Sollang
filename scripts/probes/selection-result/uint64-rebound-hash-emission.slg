import sollang.compiler.llvm.text as compiler

main {
    """
    main {
        UInt64(0) => hash!
        true -> if {
            1469598103934665603 => hash!
            UInt8(1) => value
            hash! * 1099511628211 + UInt64(value) => hash!
        }
        "hash=$(hash!)" -> println
    }
    """ => input
    [input,; ~] -> compiler.emitChecked => diagnosticCount
    diagnosticCount != 0 -> if { "uint64-hash-emission-rejected" -> println }
}
