import std.net.quic.reassembly as reassembly
import std.net.quic.frame as frames

main {
    reassembly.initial() => queue!
    frames.Stream {
        id: 0
        offset: 0
        fin: false
        data: [1, 2]
    } => frame
    queue! -> push(frame)
    "count=$(queue! -> count),bytes=$(queue! -> bytes)" -> println
}
