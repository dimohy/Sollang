namespace sollang.compiler.cli_format

import sys.file as file

public traceFormatSpans source: file.SourceText -> Unit uses Console {
    source -> removeSourceControlParentheses => normalizedBytes
    normalizedBytes -> file.borrowBytes => normalizedSource
    normalizedSource -> sourceLines => lines
    "source-length=$(source -> len),normalized-length=$(normalizedSource -> len),lines=$(lines -> len)" -> println
    0 => index!
    lines -> each original {
        normalizedSource -> trimLine(original) => trimmed
        normalizedSource -> redundantControlParentheses(trimmed) => parentheses
        normalizedSource -> longInlineControlArrow(trimmed) => arrow
        "line=$(index!),start=$(original.start),length=$(original.length),trim-start=$(trimmed.start),trim-length=$(trimmed.length),parentheses=$(parentheses.found),opening=$(parentheses.opening),closing=$(parentheses.closing),arrow=$arrow" -> println
        index! + 1 => index!
    }
}
