import sollang.compiler.llvm.text as compiler

main {
    """
    increment value: Int -> Int => value + 1

    main {
        (3 -> increment) => first
        ((3 + 1) -> increment) => second
        (3 + 1) -> increment => third
        "results=$first,$second,$third" -> println
    }
    """ => input
    [input,; ~] -> compiler.emitChecked => diagnosticCount
    diagnosticCount != 0 -> if { "push-result-emission-rejected" -> println }
}
