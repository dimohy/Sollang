import sollang.compiler.probes.noelse_results as checks

main {
    """
    main {
        true -> if { UIntSize(3) => length } else { "else" -> println }
    }
    """ -> checks.checkTypes(0) => bindingThen
    "binding-then-unit=$bindingThen" -> println

    """
    main {
        false -> if { "then" -> println } else { UIntSize(4) => length }
    }
    """ -> checks.checkTypes(0) => bindingElse
    "binding-else-unit=$bindingElse" -> println

    """
    main {
        UIntSize(0) => count!
        true -> if {
            count! < 2 -> while { count! + 1 => count! }
        } else { "else" -> println }
    }
    """ -> checks.checkTypes(0) => loop
    "loop-tail-unit=$loop" -> println
}
