import std.crypto.field25519 as field

# Public constant controls isolate arithmetic from networking and random keys.
main {
    field.one() => one
    field.add(one, one) => two
    field.multiply(two, two) => four
    field.subtract(four, two) => difference
    field.encode(two) => twoBytes
    field.encode(four) => fourBytes
    field.encode(difference) => differenceBytes
    "add=$(twoBytes[0]),multiply=$(fourBytes[0]),subtract=$(differenceBytes[0])" -> println

    [UInt8(0); 32] => coordinate!
    9 => coordinate![0]
    field.decode(coordinate!) => nine
    nine -> field.invert -> field.multiply(nine) -> field.encode => identity
    "inverse-first=$(identity[0]),inverse-last=$(identity[31])" -> println
}
