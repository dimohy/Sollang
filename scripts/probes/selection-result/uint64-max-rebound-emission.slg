import sollang.compiler.llvm.text as compiler

main {
    """
    main {
        UInt64(0) => value!
        true -> if { 18446744073709551615 => value! }
        "value=$(value!)" -> println
    }
    """ => input
    [input,; ~] -> compiler.emitChecked => diagnosticCount
    diagnosticCount != 0 -> if { "uint64-max-emission-rejected" -> println }
}
