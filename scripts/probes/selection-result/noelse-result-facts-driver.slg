import sollang.compiler.probes.noelse_results as checks

main {
    """
    main {
        true -> if {
            "diagnostic" => label
            "$label" -> println
        }
    }
    """ -> checks.checkTypes(0) => unit
    "noelse-unit=$unit" -> println

    """
    main {
        true -> if {
            "yes"
        } else {
            "no"
        } => selected
        selected -> println
    }
    """ -> checks.checkTypes(1) => text
    "value-if-text=$text" -> println
}
