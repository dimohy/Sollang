import sys.file as file

build storage: mut Arena -> Text {
    [UInt8; ~] => bytes!
    "a" => value
    UIntSize(0) => cursor!
    cursor! < (value -> len) -> while {
        bytes! -> push(value -> byte(cursor!))
        cursor! + 1 => cursor!
    }
    bytes! -> file.borrowBytes => source
    source -> slice(0, source -> len) -> materialize(storage)
}

main {
    Arena(0) => storage!
    build(storage!) -> println
}
