import sys.file as file

sourceFor value: Int -> Result<Result<file.SourceText, Text>, Text> {
    Result<Result<file.SourceText, Text>, Text>.Ok(Result<file.SourceText, Text>.Ok("source" -> file.borrowText))
}

main {
    [1,; ~] -> tryParallel item { item -> sourceFor } => result
    result -> when {
        Ok(values) => values -> len -> println
        Err(error) => error -> println
    }
}
