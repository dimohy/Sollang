import sys.file as file

sourceFor value: Int -> Result<Option<file.SourceText>, Text> {
    Result<Option<file.SourceText>, Text>.Ok(Option<file.SourceText>.Some("source" -> file.borrowText))
}

main {
    [1,; ~] -> tryParallel item { item -> sourceFor } => result
    result -> when {
        Ok(values) => values -> len -> println
        Err(error) => error -> println
    }
}
