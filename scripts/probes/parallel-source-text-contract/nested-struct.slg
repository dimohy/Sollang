import sys.file as file

struct SourceWrapper { source: file.SourceText }

sourceFor value: Int -> Result<SourceWrapper, Text> {
    Result<SourceWrapper, Text>.Ok(SourceWrapper { source: "source" -> file.borrowText })
}

main {
    [1,; ~] -> tryParallel item { item -> sourceFor } => result
    result -> when {
        Ok(values) => values -> len -> println
        Err(error) => error -> println
    }
}
