import sollang.compiler.semantic.ownership_check as ownership
import sollang.compiler.ir.typed as typedIr
import sollang.compiler.syntax as syntax

main {
    [ownership.OwnershipDiagnostic; ~] => diagnostics!
    diagnostics! -> push(ownership.OwnershipDiagnostic {
        code: ownership.parallelSourceTextResultCode()
        sourceModule: 0
        functionSymbol: -1
        expectedOrigin: -1
        expectedModule: -1
        expectedSymbol: -1
        actualOrigin: -1
        actualModule: -1
        actualSymbol: -1
        actualBuiltin: -1
        readonlyReferencePath: -1
        span: syntax.SourceSpan { fileId: 0, start: 0, length: 0 }
    })
    [typedIr.TypedIrNode; ~] => nodes
    0 -> ownership.isBlockingDiagnostic(diagnostics!, nodes)
        -> if {
            "blocked" -> println
        } else {
            "unblocked" -> println
        }
}
