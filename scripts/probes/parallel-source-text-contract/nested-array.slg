import sys.file as file

sourceFor value: Int -> Result<[file.SourceText; ~], Text> {
    [file.SourceText; ~] => sources!
    sources! -> push("source" -> file.borrowText)
    Result<[file.SourceText; ~], Text>.Ok(sources!)
}

main {
    [1,; ~] -> tryParallel item { item -> sourceFor } => result
    result -> when {
        Ok(values) => values -> len -> println
        Err(error) => error -> println
    }
}
