import sys.file as file

sourceFor value: Int -> Result<Int, file.SourceText> {
    Result<Int, file.SourceText>.Err("source" -> file.borrowText)
}

main {
    [1,; ~] -> tryParallel item { item -> sourceFor } => result
    result -> when {
        Ok(values) => values -> len -> println
        Err(error) => error -> len -> println
    }
}
