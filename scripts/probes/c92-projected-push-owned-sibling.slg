struct Owned {
    data: [UInt8; ~]
}

struct Pair {
    moved: Owned
    retained: Owned
}

main {
    Pair {
        moved: Owned { data: [1; ~] }
        retained: Owned { data: [2; ~] }
    } => pair
    [Owned; ~] => values!
    values! -> push(pair.moved)
    pair.retained.data[0] -> println
}
