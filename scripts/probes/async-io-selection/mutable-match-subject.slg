takeFirst values: mut [Int; ~] -> Result<Int, Int> {
    values -> push(9)
    Result<Int, Int>.Ok(values[0])
}

consume values: mut [Int; ~] -> Int => values -> takeFirst -> when {
    Ok(value) => value
    Err(error) => error
}

main {
    [7; ~] => values!
    values! -> takeFirst -> when {
        Ok(value) { "match=$value" -> println }
        Err(error) { "error=$error" -> println }
    }
    values! -> consume -> println
    "after=$(values! -> len)" -> println
}
