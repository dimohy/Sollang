import std.sequence

main {
    [1, 2, 3, 4; ~] => values
    0 => observed!
    0 => after!
    values
        -> mapArray value { value * 2 }
        -> filter value { value % 4 == 0 }
        -> tap value { observed! + 1 => observed! }
        -> skip(1)
        -> scan(10) total, value { total + value }
        -> afterEach value { after! + 1 => after! }
        -> take(1)
        -> each value { "array=$value" -> println }
    "observed=$(observed!),after=$(after!)" -> println

    0 => entered!
    1..3
        -> beforeEach outer { entered! + 1 => entered! }
        -> flatMap(1..2) outer, inner { outer * 10 + inner }
        -> take(3)
        -> each value { "nested=$value" -> println }
    "entered=$(entered!)" -> println
}
