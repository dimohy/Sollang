import sollang.compiler.semantic.borrowed_text_return_policy as policy

main {
    policy.requiresOriginCheck(false, false, false)
        -> if { "1" -> println } else { "0" -> println }
    policy.requiresOriginCheck(true, false, false)
        -> if { "1" -> println } else { "0" -> println }
    policy.requiresOriginCheck(false, true, false)
        -> if { "1" -> println } else { "0" -> println }
    policy.requiresOriginCheck(true, true, false)
        -> if { "1" -> println } else { "0" -> println }
    policy.requiresOriginCheck(false, false, true)
        -> if { "1" -> println } else { "0" -> println }
    policy.requiresOriginCheck(true, false, true)
        -> if { "1" -> println } else { "0" -> println }
    policy.requiresOriginCheck(false, true, true)
        -> if { "1" -> println } else { "0" -> println }
    policy.requiresOriginCheck(true, true, true) -> if { "1" -> println } else { "0" -> println }
}
