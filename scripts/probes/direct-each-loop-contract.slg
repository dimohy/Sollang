# Differential control only: range each shares finite-count semantics with repeat.
count: -> Int uses Console {
    "count" -> println
    3
}

show limit: Int -> Unit uses Console {
    1..limit -> each number {
        "function=$number" -> println
    }
}

main {
    1..count() -> each number {
        "main=$number" -> println
    }
    1..0 -> each { "zero=$it" -> println }
    1..(-2) -> each { "negative=$it" -> println }
    1..2 -> each { "default=$it" -> println }
    show(2)
    true -> if {
        1..2 -> each number { "branch=$number" -> println }
    }
    1..4 -> each number {
        number == 2 -> if { continue }
        number == 4 -> if { break }
        "transfer=$number" -> println
    }
    1..2 -> each outer {
        1..2 -> each inner { "nested=$outer,$inner" -> println }
    }
}
