struct First { value: Int }
struct Second { flag: Bool }
first values: [First; ~] -> [Int; ~] {
    values -> parallel item { item.value } => mapped
    mapped
}
second values: [Second; ~] -> [Bool; ~] {
    values -> parallel item { item.flag } => mapped
    mapped
}
main {
    [First { value: 7 }; ~] -> first => numbers
    [Second { flag: true }; ~] -> second => flags
    numbers[0] -> println
    flags[0] -> println
}
