import sollang.compiler.semantic.type_ids as types

node kind: Int, origin: Int, symbol: Int, first: Int, second: Int, length: Int -> types.SemanticType {
    types.SemanticType { kind: kind, origin: origin, module: -1, symbol: symbol, first: first, second: second, length: length, lengthHash: 0, containsParameter: false, status: 0 }
}

plain: -> types.SemanticType { node(1, 1, 2, -1, -1, -1) }

main {
    [types.NominalField; ~] => emptyFields
    [types.PayloadEdge; ~] => emptyPayloads
    [Bool; ~] => resources
    [plain(), node(3, -1, -1, 0, -1, -1), node(12, -1, -1, 1, -1, 4); ~] => backwardTypes
    types.classifyWithResources(backwardTypes, emptyFields, emptyPayloads, resources) => backwardTraits
    "backward=$(backwardTraits[2])" -> println
    [plain(), node(12, -1, -1, 6, -1, 4), plain(), plain(), plain(), plain(), node(3, -1, -1, 0, -1, -1); ~] => forwardTypes
    types.classifyWithResources(forwardTypes, emptyFields, emptyPayloads, resources) => forwardTraits
    "forward=$(forwardTraits[1])" -> println
    [plain(), node(12, -1, -1, 2, -1, 4), node(9, -1, -1, -1, -1, -1); ~] => resourceTypes
    types.classifyWithResources(resourceTypes, emptyFields, emptyPayloads, resources) => resourceTraits
    "resource=$(resourceTraits[1])" -> println
    [plain(), node(1, 0, 0, -1, -1, -1), node(3, -1, -1, 0, -1, -1); ~] => fieldTypes
    [types.NominalField { ownerType: 1, sourceModule: 0, ownerSymbol: -1, fieldSymbol: -1, labelToken: -1, ordinal: 0, fieldType: 2, status: 0 }; ~] => fields
    types.classifyWithResources(fieldTypes, fields, emptyPayloads, resources) => fieldTraits
    "field=$(fieldTraits[1])" -> println
    [plain(), node(1, 0, 0, -1, -1, -1), node(9, -1, -1, -1, -1, -1); ~] => payloadTypes
    [types.PayloadEdge { ownerType: 1, payloadType: 2 }; ~] => payloads
    types.classifyWithResources(payloadTypes, emptyFields, payloads, resources) => payloadTraits
    "payload=$(payloadTraits[1])" -> println
    [plain(), node(4, -1, -1, 2, -1, 0), node(9, -1, -1, -1, -1, -1); ~] => zeroTypes
    types.classifyWithResources(zeroTypes, emptyFields, emptyPayloads, resources) => zeroTraits
    "zero=$(zeroTraits[1])" -> println
    [plain(), node(13, -1, -1, 0, 2, 4), node(3, -1, -1, 0, -1, -1); ~] => dictionaryTypes
    types.classifyWithResources(dictionaryTypes, emptyFields, emptyPayloads, resources) => dictionaryTraits
    "dictionary=$(dictionaryTraits[1])" -> println
}
