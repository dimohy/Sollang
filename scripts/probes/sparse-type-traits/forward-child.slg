import sollang.compiler.semantic.type_ids as types

plain: -> types.SemanticType {
    types.SemanticType { kind: 1, origin: 1, module: -1, symbol: 2, first: -1, second: -1, length: -1, lengthHash: 0, containsParameter: false, status: 0 }
}

run: -> Unit uses Console {
    [plain(); ~] => table!
    table! -> types.reserveStaticArrayType(6, 0, 4) => reserved
    not reserved -> if { "setup-rejected" -> println
        return }
    table! -> types.allocateSemanticTypeSlot => parent
    types.SemanticType { kind: 12, origin: -1, module: -1, symbol: -1, first: 6, second: -1, length: 4, lengthHash: 0, containsParameter: false, status: 0 } => table![parent]
    [types.NominalField; ~] => fields
    [types.PayloadEdge; ~] => payloads
    [Bool; ~] => resources
    types.classifyWithResources(table!, fields, payloads, resources) => traits
    "parent=$parent,forward=$(traits[parent]),child=$(traits[6])" -> println
}

main { run() }
