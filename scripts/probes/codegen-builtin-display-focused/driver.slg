import sollang.compiler.semantic.type_name_policy as policy
import sollang.compiler.semantic.type_ids as typeIds

main {
    ["Unit", "Text", "Int", "Bool", "Int8", "Int16", "Int64", "UInt8", "UInt16", "UInt32", "UInt64", "Size", "UIntSize", "CodePoint", "Arguments", "Arena", "MappedBytes", "MutableMappedBytes", "Float32", "Float64", "IntSlice", "StaticIntArray", "StaticTextArray", "DynamicIntArray", "IntDictionaryView", "IntDictionary", "TaskInt", "Duration", "BoxDuration", "File", "FileWriter", "SourceText", "ProcessCommand", "AtomicReplaceRequest", "Path", "PathStyle", "DynamicUInt8Array", "DirectoryRaw", "DirectoryEntryKind", "DirectoryEntry", "DynamicDirectoryEntryArray", "DirectoryRawResult", "DirectoryReadResult", "Range", "MouseEvent", "MouseEventKind", "EventOverflowPolicy", "FixedUInt8Array12", "FixedUInt8Array16", "FixedUInt8Array32", "GenericParameter", "SecondaryGenericParameter", "TertiaryGenericParameter", "FirstUserDefined"] -> each name {
        name -> policy.builtinDisplayName -> println
    }
    0 => symbol!
    symbol! < 26 -> while {
        symbol! -> typeIds.builtinEnumName -> println
        symbol! + 1 => symbol!
    }
}
