import sys.file as file

select flag: Bool -> file.SourceText uses File {
    flag -> if {
        "abc" -> file.borrowText
    } else {
        "scripts/probes/source-text-control-values/payload.txt" -> file.mapText
    }
}

main {
    true -> select => first
    first -> len -> println
    false -> select => second
    second -> len -> println
}
