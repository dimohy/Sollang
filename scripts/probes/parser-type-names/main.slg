import sollang.compiler.semantic.type_name_policy as names

main {
    ["Unit", "Text", "Bool", "Self", "Int", "Long", "Int8", "Int16", "Int32", "Int64", "UInt8", "UInt16", "UInt32", "UInt64", "Size", "UIntSize", "CodePoint", "Arena", "Arguments", "SourceText", "MappedBytes", "MutableMappedBytes", "Float", "Double", "Float32", "Float64", "Range", "Option", "Result", "Unknown", "cache.Int"; ~] -> each name {
        name -> names.isBuiltin => builtin
        "$name=$builtin" -> println
    }
}
