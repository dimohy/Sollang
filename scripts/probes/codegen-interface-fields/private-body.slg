namespace cache.interfaces

public struct Zeta {
    value: Text
    public count: Int
}
public struct Alpha { public tag: Int }
struct Hidden { value: Int }
public enum Choice { Empty, Value(Text) }
public trait Reader {
    type Item
    read: self, source: ref Text, count: Int -> Item
}
public echo source: ref Text, count: Int -> Int uses Console, File { count }
public chooseFourth<A, B, C, D> first: A, second: B, third: C, fourth: D -> D { fourth }
hidden value: Int -> Int { value + 2 }

# private body/comment changes
