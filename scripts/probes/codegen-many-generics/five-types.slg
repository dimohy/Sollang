chooseThird<A, B, C> first: A, second: B, third: C -> C {
    third
}

chooseFifth<A, B, C, D, E> first: A, second: B, third: C, fourth: D, fifth: E -> E {
    fifth
}

main {
    chooseThird(1, true, 3) -> println
    chooseFifth(1, true, 3, 4, UInt64(4294967297)) -> println
    chooseFifth(1, true, 3, false, "last") -> println
}
