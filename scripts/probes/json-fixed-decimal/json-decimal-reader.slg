import std.text.json as json

main {
    json.limits(32, 2, 8, 16) -> when {
        Ok(limits) {
            json.reader("1.25", limits) -> when {
                Ok(reader) { reader -> fixedDecimal(5, 2) -> println }
                Err(error) { error.offset -> println }
            }
        }
        Err(error) { error.offset -> println }
    }
}
