import std.crypto.field25519

struct Holder {
    public bytes: [UInt64; 16]
}

replace holder: mut Holder -> Unit {
    holder.bytes -> field25519.replace(field25519.one())
}

main {
    Holder { bytes: field25519.zeros() } => holder!
    holder! -> replace
    "first=$(holder!.bytes[0])" -> println
}
