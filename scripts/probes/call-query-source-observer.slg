namespace sollang.compiler.semantic.calls

import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.semantic.modules as modules
import sollang.compiler.semantic.module_resolve as moduleResolve
import sollang.compiler.semantic.qualified
import std.time as time

public struct SourceQueryProfile {
    public sourceModule: Int
    public milliseconds: Long
    public rows: Int
    public checksum: Long
}

# Observe the existing per-source resolver, with one shared preparation.
# Bare global references, result concatenation and final filtering are excluded.
public profileSourceQueries package: ref analysis.PackageAnalysis, semantic: ref typeIds.SemanticTypeSet, receiverTypes: ref [Int; ~], resolvedTypes: ref [typeIds.SemanticType; ~], identities: ref [modules.ModuleIdentity; ~], imports: ref [modules.ImportEdge; ~], resolvedImports: ref [moduleResolve.ResolvedImport; ~], qualifiedResults: ref [qualified.QualifiedResolution; ~] -> Result<[SourceQueryProfile; ~], time.Error> uses Clock {
    package -> indexTypedMethodReferences(semantic.references) => referenceIndex
    package -> prepareTypedMethodDeclarationFacts(semantic.references, identities, resolvedImports) => declarations
    package -> declaredIntrinsicCallableNames => intrinsicNames
    time.monotonicClock() => clock
    [SourceQueryProfile; ~] => observations!
    0..<Int(package.sources -> len) -> each sourceModule {
        clock -> now => started
        sourceModule -> resolveSourceTypedWithDeclarations(package, semantic, identities, imports, resolvedImports, qualifiedResults, intrinsicNames, receiverTypes, resolvedTypes, declarations, referenceIndex) => rows
        Long(rows -> len) => checksum!
        rows -> each row {
            checksum! + Long(row.sourceModule) + Long(row.callAst) => checksum!
            checksum! + Long(row.origin) + Long(row.targetModule) => checksum!
            checksum! + Long(row.targetSourceModule) + Long(row.functionSymbol) + Long(row.status) => checksum!
        }
        clock -> now => completed
        completed -> durationSince(started)? => duration
        observations! -> push(SourceQueryProfile {
            sourceModule: sourceModule
            milliseconds: duration -> asMilliseconds
            rows: Int(rows -> len)
            checksum: checksum!
        })
    }
    observations! -> Result<[SourceQueryProfile; ~], time.Error>.Ok
}
