# One nested path returns, while the other still contributes Bool to the arm.
enum Mode {
    Persistent
    Close
}

check mode: Mode -> Bool {
    mode -> when {
        Persistent {
            true -> if { true -> return } else { true }
        }
        Close { false }
    } => flag
    flag and true
}

main {
    Mode.Close -> check -> if { "valid" } else { "invalid" } -> println
}
