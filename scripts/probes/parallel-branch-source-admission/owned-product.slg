identity value: Int -> Int => value
makeItems count: Int -> [Int; ~] => [7, 8, 9; ~]
readCount value: ref (count: Int, items: [Int; ~]) -> Int => value.count
readLength value: ref (count: Int, items: [Int; ~]) -> Int => value.items -> len
main {
    3 -> branch {
        count: -> identity
        items: -> makeItems
    } => owner
    owner -> parallel branch {
        left: ref -> readCount
        right: ref -> readLength
    } => result
    "$(result.left):$(result.right)" -> println
}
