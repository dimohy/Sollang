struct Values { items: [Int; ~] }
enum Slot {
    Empty
    Present(Values)
}
read value: ref Slot -> Int => 1
main {
    Slot.Present(Values { items: [7, 8, 9; ~] }) => owner
    owner -> parallel branch {
        left: ref -> read
        right: ref -> read
    } => result
    "$(result.left):$(result.right)" -> println
}
