refresh value: Text, storage: mut Arena -> Text {
    value -> materialize(storage)
}

display flag: Bool -> Unit uses Console {
    Arena(0) => storage!
    "old" -> materialize(storage!) => selected!
    flag -> if {
        return
    } else {
        "new" -> refresh(storage!)
    } => selected!
    selected! -> println
}

main { false -> display }
