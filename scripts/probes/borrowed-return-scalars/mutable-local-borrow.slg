import sys.file as file

ownedUtf8 value: Text -> [UInt8; ~] {
    [UInt8; ~] => bytes!
    0..<Int(value -> len) -> each index {
        bytes! -> push(value -> byte(UIntSize(index)))
    }
    bytes!
}

selectText code: Int -> Text {
    "unsafe" -> ownedUtf8 => bytes
    bytes -> file.borrowBytes => source
    "safe" => selected!
    code == 1 -> if {
        "safe" => selected!
    } else {
        source -> slice(0, source -> len) => selected!
    }
    selected! => result
    result
}

main {
    0 -> selectText -> println
}
