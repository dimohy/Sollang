refresh value: Text, storage: mut Arena -> Text {
    value -> materialize(storage)
}

display change: Bool, storage: mut Arena -> Unit uses Console {
    "old" -> refresh(storage) => selected!
    change -> if {
        "new" -> refresh(storage) => selected!
    }
    selected! -> println
}

main {
    Arena(0) => storage!
    true -> display(storage!)
}
