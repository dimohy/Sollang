import sys.file as file

struct ViewAndCount {
    view: Text
    count: Int
}

ownedUtf8 value: Text -> [UInt8; ~] {
    [UInt8; ~] => bytes!
    0..<Int(value -> len) -> each index {
        bytes! -> push(value -> byte(UIntSize(index)))
    }
    bytes!
}

countOnly: -> Int {
    "a" -> ownedUtf8 => bytes
    bytes -> file.borrowBytes => source
    source -> slice(0, source -> len) => text
    ViewAndCount { view: text, count: 42 } => pair
    pair.count
}

main {
    countOnly() -> println
}
