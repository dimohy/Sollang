namespace fixture.partial_catalog

public struct Document { public value: Int }
public struct Package { public value: Int }
public struct Prepared { public package: Package }
public struct Catalog { public bindings: [Int; ~] }

public parseDocument value: Int -> Document => Document { value: value }

public prepare paths: [Text; ~] -> Prepared {
    Prepared { package: Package { value: paths -> len } }
}

public load package: ref Package, paths: [Text; ~], target: Text, style: Int -> Catalog {
    Catalog { bindings: [package.value + (paths -> len) + Int(target -> len) + style; ~] }
}
