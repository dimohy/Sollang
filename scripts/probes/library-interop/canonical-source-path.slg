import sys.path as path
import sys.process as process

main {
    process.arguments() => arguments
    arguments[1] -> path.fromText(path.nativeStyle()) -> query -> when {
        Err(error) { "query error = $error" -> println }
        Ok(info) {
            info.canonical => canonical
            canonical -> pathText -> println
            canonical -> path.normalizeConfined -> when {
                Err(error) { "lexical error = $error" -> println }
                Ok(value) { value -> pathText -> println }
            }
        }
    }
}
