makePayload value: Int -> [Int; ~] {
    [value,; ~]
}

main {
    [1, 2,; ~] -> tryParallel item {
        Result<[Int; ~], Text>.Ok(item -> makePayload) => result
        result
    } => result
    result -> when {
        Ok(values) {
            values -> each payload {
                payload -> each item { item -> println }
            }
        }
        Err(error) => error -> println
    }
}
