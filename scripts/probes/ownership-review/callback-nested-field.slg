struct PayloadPair {
    selected: [Int; ~]
    retained: [Int; ~]
}

makePayload value: Int -> [Int; ~] {
    [Int; ~] => payload!
    payload! -> push(value)
    payload!
}

makePair value: Int -> PayloadPair {
    PayloadPair {
        selected: value -> makePayload
        retained: (value + 10) -> makePayload
    }
}

struct PayloadWrapper {
    pair: PayloadPair
}
makeWrapper value: Int -> PayloadWrapper {
    PayloadWrapper { pair: value -> makePair }
}

main {
    [Int; ~] => values!
    1..3 -> each item { values! -> push(item) }
    values! -> parallel item {
        item -> makeWrapper => wrapper
        (wrapper.pair.retained -> len) -> println
        wrapper.pair.selected
    } => mapped
    mapped -> each payload {
        payload -> each item { item -> println }
    }
}
