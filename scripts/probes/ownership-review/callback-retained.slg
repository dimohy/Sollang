makePayload value: Int -> [Int; ~] {
    [Int; ~] => payload!
    payload! -> push(value)
    payload!
}

main {
    [Int; ~] => values!
    1..3 -> each item { values! -> push(item) }
    values! -> parallel item {
        item -> makePayload => retained
        retained -> len -> println
        item -> makePayload => payload
        (payload -> len) -> println
        payload
    } => mapped
    mapped -> each payload {
        payload -> each item { item -> println }
    }
}
