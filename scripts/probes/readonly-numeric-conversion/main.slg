widen value: ref Int -> Int64 { Int64(value) }
same value: ref Int -> Int { Int(value) }
narrow value: ref Int64 -> Int { Int(value) }
additional prefix: Int, value: ref Int -> Int64 { Int64(value) }
nested value: ref Int, chosen: Bool -> Int64 {
    chosen -> if { Int64(value) -> return }
    Int64(0)
}
fromFloat value: ref Float64 -> Int { Int(value) }
toFloat value: ref Int -> Float64 { Float64(value) }
widenFloat value: ref Float32 -> Float64 { Float64(value) }
sameFloat value: ref Float64 -> Float64 { Float64(value) }
narrowFloat value: ref Float64 -> Float32 { Float32(value) }
direct value: Int -> Int64 { Int64(value) }

main {
    17 => number
    Int64(17) => wide
    Float64(17) => floating
    Float32(17) => single
    number -> widen -> println
    number -> same -> println
    wide -> narrow -> println
    0 -> additional(number) -> println
    number -> nested(true) -> println
    floating -> fromFloat -> println
    Int(number -> toFloat) -> println
    Int(single -> widenFloat) -> println
    Int(floating -> sameFloat) -> println
    Int(floating -> narrowFloat) -> println
    number -> direct -> println
}
