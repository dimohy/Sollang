sourcePath: -> Text uses Console {
    "path" -> println
    "examples/regression/01-function-basic-hello.slg"
}

offset: -> UInt64 uses Console {
    "offset" -> println
    1
}

length: -> UIntSize uses Console {
    "length" -> println
    3
}

readRange: -> Unit uses File, Console {
    map read sourcePath() at offset() for length() => data
    "length=$(data -> len)" -> println
    "bytes=$(data[0]),$(data[1]),$(data[2])" -> println
}

main { readRange() }
