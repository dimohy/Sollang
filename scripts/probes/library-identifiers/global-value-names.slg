namespace sollang.compiler.llvm.text

import sollang.compiler.ir.typed as typedIr

identityNode moduleIndex: Int -> typedIr.TypedIrNode => typedIr.TypedIrNode {
    kind: 5, parent: -1, sourceModule: moduleIndex, astNode: -1
    symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1
    typeSymbol: 2, typeId: 2, typeKind: 1, typeFlags: 0
    payloadToken: -1, opcode: 0, operand0: -1, operand1: -1
    nextOperand: -1, flags: 0
}

main {
    [identityNode(0), identityNode(1), identityNode(1), identityNode(0), identityNode(-1), identityNode(2); ~] => ir
    ir -> globalValueNames(3) => names
    names -> each name { name -> println }
    [typedIr.TypedIrNode; ~] => empty
    empty -> globalValueNames(0) => emptyNames
    emptyNames -> len => emptyCount
    "empty=$emptyCount" -> println
}
