namespace cache.finaltypes

struct Wide { small: Bool, wide: Int64 }
enum Inner { Empty, Value(Wide) }
struct Wrapper { prefix: Bool, value: Inner }
enum Outer { None, Payload(Wrapper) }
trait Value { get: self -> Int }
public inspect value: ref Wide, boxed: box Int, fixed: [Int; 3], growable: [Int; ~], mapped: {Int: Bool}, dynamic: dyn Value, outer: Outer, optional: Option<Outer> -> Unit { }
main { }
