namespace cache.prepared_registry

struct Used { value: Int }
struct Empty { }
struct Other { flag: Bool }
enum Unused { First, Second }
trait Value { get: self -> Int }
public inspect value: ref Used, boxed: box Int, fixed: [Int; 3], growable: [Int; ~], mapped: {Int: Bool}, dynamic: dyn Value -> Unit { }
trait Carrier { type Item }
impl Carrier for Used { type Item = [UInt8; 19] }
main { }
