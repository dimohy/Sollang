struct Leaf { values: [Int; ~] }
struct Branch { leaves: [Leaf; ~] }

first values: ref [Int; ~] -> Int { values[0] }

read roots: ref [Branch; ~], outer: Int, inner: Int -> Int {
    roots[outer].leaves[inner].values -> first
}

main {
    [Branch { leaves: [Leaf { values: [65, 66; ~] }; ~] }; ~] => roots
    roots -> read(0, 0) -> println
    roots[0].leaves[0].values -> first -> println
}
