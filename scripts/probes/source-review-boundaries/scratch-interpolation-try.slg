readValue value: Int, fail: Bool -> Result<Int, Int> {
    fail and value == 1 -> if {
        Result<Int, Int>.Err(9) -> return
    }
    Result<Int, Int>.Ok(value + 10)
}

run fail: Bool -> Result<Unit, Int> uses Console {
    0 => index!
    index! < 2 -> while {
        "value=$(index! -> readValue(fail)?)" -> println
        index! + 1 => index!
    }
    Result<Unit, Int>.Ok
}

main {
    false -> run -> when {
        Ok(done) { "ok" -> println }
        Err(error) { "error=$error" -> println }
    }
    true -> run -> when {
        Ok(done) { "ok" -> println }
        Err(error) { "error=$error" -> println }
    }
}
