import sys.directory as directory
import sys.path as path

struct DirectoryView {
    value: ref path.Path
}

borrowDirectory value: ref path.Path -> ref path.Path => value

inspectDirectory value: ref path.Path -> Bool uses File {
    value -> queryRaw -> when {
        Result<path.RawInfo, Text>.Ok(info) { info.kindCode == 1 }
        Result<path.RawInfo, Text>.Err(error) { false }
    }
}

main {
    path.fromText(".", path.Style.Windows) => current
    current -> inspectDirectory -> println
    current -> inspectDirectory -> println
    DirectoryView { value: current -> borrowDirectory } => view
    view.value -> inspectDirectory -> println
    current -> borrowDirectory -> inspectDirectory -> println
}
