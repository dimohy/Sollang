scan values: ref {Int: Int; <=2} -> Unit uses Console {
    0 => index!
    index! < 2 -> while {
        "ref=$(values[1])" -> println
        index! + 1 => index!
    }
}

main {
    {1: 10; <=2} => values
    0 => index!
    index! < 2 -> while {
        "value=$(values[1])" -> println
        index! + 1 => index!
    }
    values -> scan
}
