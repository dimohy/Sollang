import std.sequence

main {
    0 => count!
    0 => before!
    0 => after!
    2_147_483_646..2_147_483_647
        -> beforeEach item { before! + 1 => before! }
        -> afterEach item { after! + 1 => after! }
        -> flatMap(2_147_483_646..2_147_483_647) outer, inner { inner }
        -> each item { count! + 1 => count! }
    count! -> println
    before! -> println
    after! -> println

    0 => taken!
    2_147_483_646..2_147_483_647
        -> map item { item }
        -> take(1)
        -> each item { taken! + 1 => taken! }
    taken! -> println
}
