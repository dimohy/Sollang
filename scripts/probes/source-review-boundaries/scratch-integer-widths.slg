measure value: Text -> UIntSize => value -> len

main {
    Int8(-128) => narrow
    UInt8(255) => byteValue
    Int64(-9223372036854775808) => signed
    UInt64(18446744073709551615) => unsigned
    0..1 -> each {
        "$(narrow)" -> measure -> println
        "$(byteValue)" -> measure -> println
        "$(signed)" -> measure -> println
        "$(unsigned)" -> measure -> println
    }
}
