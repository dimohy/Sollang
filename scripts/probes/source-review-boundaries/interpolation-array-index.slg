make count: Int -> [Int; ~] {
    [Int; ~] => values!
    0 => index!
    index! < count -> while {
        values! -> push(40 + index! * 10)
        index! + 1 => index!
    }
    values!
}

main {
    [10, 20, 30] => fixed
    3 -> make => growable
    [70, 80, 90; <=4] => bounded
    1 => index!
    "$(fixed[index!]),$(growable[index!]),$(bounded[index!])" -> println
    2 => index!
    "$(fixed[index!]),$(growable[index!]),$(bounded[index!])" -> println
}
