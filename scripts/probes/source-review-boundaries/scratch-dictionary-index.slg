scanValue values: {Int: Int; <=2} -> Unit uses Console {
    0 => index!
    index! < 2 -> while {
        values[1] -> println
        index! + 1 => index!
    }
}

scanReference values: ref {Int: Int; <=2} -> Unit uses Console {
    0 => index!
    index! < 2 -> while {
        values[1] -> println
        index! + 1 => index!
    }
}

main {
    {1: 10; <=2} => values
    values -> scanValue
    values -> scanReference
    {1: 20; <=2} => mutableValues!
    0 => index!
    index! < 2 -> while {
        mutableValues! -> put(1, 20 + index!)
        mutableValues![1] -> println
        index! + 1 => index!
    }
}
