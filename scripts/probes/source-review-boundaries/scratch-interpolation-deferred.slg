main {
    {1: 10; <=2} => values
    0..2 -> each value {
        value > 0 -> if {
            "logical=$(value > 0 and value < 2)"
        } else {
            "zero"
        } -> println
        value > 0 -> if {
            "dictionary=$(values[1])"
        } else {
            "zero"
        } -> println
    }
}
