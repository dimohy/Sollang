import std.sequence

measure value: Text -> UIntSize => value -> len

main {
    0..1 -> map value { Int8(value - 12) } -> each number {
        "$(number)" -> measure -> println
    }
    0..1 -> map value { UInt64(value) + 18446744073709551614 } -> each number {
        "$(number)" -> measure -> println
    }
    0..1 -> map value { value > 0 } -> each flag {
        "$(flag)" -> measure -> println
    }
    0..1 -> map value {
        value > 0 -> if { "hi" } else { "ho" }
    } -> each text {
        "$(text)" -> measure -> println
    }
}
