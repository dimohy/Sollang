struct Counter { value: Int }
borrow value: ref Counter -> ref Counter => value
len value: ref Counter -> Int uses Console {
    "custom len" -> println
    value.value
}
capacity value: ref Counter -> Int uses Console {
    "custom capacity" -> println
    value.value
}
main {
    Counter { value: 7 } => value
    (value -> borrow) -> len -> println
    (value -> borrow) -> capacity -> println
}
