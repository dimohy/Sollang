import sys.file as file

showText value: ref Text, index: UIntSize -> Unit uses Console {
    "text=$(value -> byte(index))" -> println
}

showSource value: ref SourceText, index: UIntSize -> Unit uses Console {
    "source=$(value -> byte(index))" -> println
}

main {
    "abc" => text
    text -> showText(1)
    "abc" -> file.borrowText => source
    source -> showSource(1)
}
