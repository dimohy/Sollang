import std.net.quic as quic

identityAndCertificate: -> Result<Bool, quic.QuicError> uses Random {
    quic.generateIdentity()? => identity
    identity -> certificate? => certificate
    Result<Bool, quic.QuicError>.Ok((certificate -> len) > 0)
}

main {
    identityAndCertificate() -> when {
        Ok(valid) { "quic-identity=$valid" -> println }
        Err(error) { "quic-identity-error=$(error.code)" -> println }
    }
}
