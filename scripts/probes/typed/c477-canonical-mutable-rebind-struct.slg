# A later mutable declaration can share an IR slot with an earlier binding.
# Its resolved declaration, reads, and final nominal field retain UIntSize.
struct CursorBox {
    value: UIntSize
}

main {
    UIntSize(2) => cursor!
    cursor! + 1 => cursor!
    cursor! => first
    first => cursor!
    cursor! + 1 => cursor!
    cursor! => last
    CursorBox { value: last } => cursorBox
    cursorBox.value -> println
}
