# Concrete capacities share an identity with their literals, while distinct
# capacities remain distinct even when their elements have the same type.
makeDictionaryTwo: -> {Int: Int; <=2} {
    {1: 10; <=2}
}

makeDictionaryThree: -> {Int: Int; <=3} {
    {1: 10, 2: 20; <=3}
}

makeArrayTwo: -> [Int; <=2] {
    [1; <=2]
}

makeArrayThree: -> [Int; <=3] {
    [1, 2; <=3]
}

main {
    "ok" -> println
}
