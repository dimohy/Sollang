import sys.file as file

scan owners: [file.SourceText; ~] -> UIntSize {
    UIntSize(0) => total!
    UIntSize(0) => index!
    index! < (owners -> len) -> while {
        owners[index!] -> len => sourceLength
        total! + sourceLength => total!
        index! + 1 => index!
    }
    total!
}

main { }