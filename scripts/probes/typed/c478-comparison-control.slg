# Numeric comparisons and Text content equality remain valid.
main {
    1 == 1 => sameNumber
    2 != 3 => differentNumber
    3 < 4 => lessNumber
    4 >= 4 => atLeastNumber
    "abc" == "abc" => sameText
    "abc" != "abd" => differentText
    "numbers=$(sameNumber),$(differentNumber),$(lessNumber),$(atLeastNumber);text=$(sameText),$(differentText)" -> println
}
