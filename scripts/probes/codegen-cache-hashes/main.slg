# The verification runner supplies arithmetic-smoke.slg from compiled C# methods.
import sollang.compiler.llvm.codegen_cache_policy as policy
import cache.hash.smoke as smoke

values: -> [UInt64; 8] => [
0, 1, 255, 4294967295, 4294967296,
9223372036854775807, 9223372036854775808, 18446744073709551615
]

main {
    values() -> each hash {
        values() -> each value {
            hash -> policy.checksumMix(value) -> println
            hash -> policy.fingerprintMix(value) -> println
            hash -> smoke.subtract(value) -> println
            hash -> smoke.changed(value) -> println
        }
    }
}
