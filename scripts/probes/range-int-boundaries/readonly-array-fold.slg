sumView values: [Int] -> Int {
    values -> fold 0 total, item { total + item }
}

sumBorrowed values: ref [Int; ~] -> Int {
    values -> fold 0 total, item { total + item }
}

main {
    [1, 2, 3] => items
    items -> sumView -> println
    [1, 2, 3; ~] => growable
    growable -> sumBorrowed -> println
}
