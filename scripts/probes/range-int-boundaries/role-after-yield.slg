observe: -> async Int uses Console {
    2147483647 => maximum
    maximum..maximum => values
    0 => seen!
    0 => last!
    values -> each item {
        seen! + 1 => seen!
        seen! > 1 -> if break
        yield
        "item=$item" -> println
        item => last!
    }
    last!
}

main {
    observe() => pending
    pending -> await => value
    value -> println
}
