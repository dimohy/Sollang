count values: Range -> Int {
    0 => seen!
    values -> each item { seen! + 1 => seen! }
    seen!
}

countAsync values: Range -> async Int {
    0 => seen!
    values -> each item {
        seen! + 1 => seen!
        yield
    }
    seen!
}

repeatAsync times: Int -> async Int {
    0 => seen!
    times -> repeat item {
        seen! + 1 => seen!
        yield
    }
    seen!
}

main {
    count(2..4) -> println
    count(4..2) -> println
    count(2..<4) -> println
    countAsync(2..4) => ranged
    ranged -> await => rangedCount
    rangedCount -> println
    repeatAsync(3) => repeated
    repeated -> await => repeatedCount
    repeatedCount -> println
    repeatAsync(0) => empty
    empty -> await => emptyCount
    emptyCount -> println
}
