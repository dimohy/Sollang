# A bounded dictionary index retains the specialized value type in a generic body.
struct Item { public value: UInt64 }

pack<T> value: T -> {Int: T; <=2} { {Int: T; 1: value; <=2} }

unpack<T> value: T -> T {
    value -> pack => values
    values[1]
}

main {
    Item { value: 4294967297 } -> unpack => item
    item.value -> println
}
