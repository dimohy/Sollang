# Resolve each computed receiver before its bounded field, index and member.
struct Item { public value: UInt64 }
struct Holder {
    public items: [Item; <=2]
    public table: {Int: Item; <=2}
}

makeHolder: -> Holder {
    Holder {
        items: [Item { value: 4294967297 }; <=2]
        table: {1: Item { value: 4294967297 }; <=2}
    }
}

main {
    makeHolder().items[0].value -> println
    makeHolder().table[1].value -> println
}
