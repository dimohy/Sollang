# Read an element inside a generic body after its container-producing call.
struct Item { public value: UInt64 }

pack<T> value: T -> [T; <=2] { [value,; <=2] }

unpack<T> value: T -> T {
    value -> pack => values
    values[0]
}

main {
    Item { value: 4294967297 } -> unpack => item
    item.value -> println
}
