import std.sequence

makeValues values: Range -> Stream<Int> {
    values -> defer
}

asEvents left: move Stream<Int>, right: move Stream<Int> -> EventStream<Int> {
    (left, right) -> merge
}

positive value: Int -> stream Bool {
    value > 0 -> emit
}

main {
    1..10 -> makeValues => left
    11..20 -> makeValues => right
    left -> asEvents(right) => events
    0 => seen!
    0 => received!
    events -> tap item {
        seen! + 1 => seen!
    } -> positive -> skip(1) -> take(2) -> each flag {
        flag -> if { received! + 1 => received! }
    }
    "seen=$(seen!) received=$(received!)" -> println
}
