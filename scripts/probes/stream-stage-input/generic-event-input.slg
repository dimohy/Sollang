import std.sequence

makeValues values: Range -> Stream<Int> {
    values -> defer
}

asEvents<T> left: move Stream<T>, right: move Stream<T> -> EventStream<T> {
    (left, right) -> merge
}

main {
    1..3 -> makeValues => left
    10..12 -> makeValues => right
    left -> asEvents(right) => events
    0 => received!
    events -> take(1) -> each value {
        received! + 1 => received!
    }
    "received=$(received!)" -> println
}
