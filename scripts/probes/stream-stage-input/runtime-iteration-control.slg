import std.sequence

makeValues values: Range -> Stream<Int> {
    values -> defer
}

positive value: Int -> stream Bool {
    value > 0 -> emit
}

main {
    1..10 -> makeValues => values
    0 => seen!
    0 => received!
    values -> positive -> each flag {
        seen! + 1 => seen!
        seen! == 2 -> if { continue }
        flag -> if { received! + 1 => received! }
        seen! >= 3 -> if { break }
    }
    "seen=$(seen!) received=$(received!)" -> println
}
