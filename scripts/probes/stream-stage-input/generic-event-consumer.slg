import std.sequence

makeValues values: Range -> Stream<Int> {
    values -> defer
}

asEvents left: move Stream<Int>, right: move Stream<Int> -> EventStream<Int> {
    (left, right) -> merge
}

countEvents<T> events: move EventStream<T> -> Int {
    0 => count!
    events -> each value {
        count! + 1 => count!
    }
    count!
}

main {
    1..3 -> makeValues => left
    10..12 -> makeValues => right
    left -> asEvents(right) -> countEvents -> println
}
