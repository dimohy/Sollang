import std.sequence

main {
    true -> if {
        1..2 -> defer => zipLeft
        10..11 -> defer => zipRight
        (left: zipLeft, right: zipRight) -> zip => zipped
        zipped -> each pair { pair.left + pair.right -> println }

        1..2 -> defer => concatLeft
        10..11 -> defer => concatRight
        (concatLeft, concatRight) -> concat => concatenated
        concatenated -> each value { value -> println }

        1..2 -> defer => mergeLeft
        10..11 -> defer => mergeRight
        (mergeLeft, mergeRight) -> merge => merged
        0 => total!
        merged -> each value { total! + value => total! }
        total! -> println

        1..2 -> defer => latestLeft
        10..11 -> defer => latestRight
        (left: latestLeft, right: latestRight) -> latest => snapshots
        0 => last!
        snapshots -> each pair { pair.left + pair.right => last! }
        last! -> println
    }
}
