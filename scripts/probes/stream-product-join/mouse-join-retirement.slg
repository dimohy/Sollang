import sys.input.mouse
import std.sequence

main {
    2 -> mouse.source(mouse.OverflowPolicy.DropNewest) -> when {
        Ok(first) {
            first -> events => left
            2 -> mouse.source(mouse.OverflowPolicy.DropNewest) -> when {
                Ok(second) {
                    second -> events => right
                    (left, right) -> merge => joined
                    joined -> each event {
                        event.x -> println
                        stop
                    }
                }
                Err(error) { error.invalidCapacity -> println }
            }
        }
        Err(error) { error.invalidCapacity -> println }
    }
}
