import std.sequence

makeValues values: Range -> Stream<Int> { values -> defer }

makePair: -> (left: Stream<Int>, right: Stream<Int>) {
    (left: makeValues(3..4), right: makeValues(30..31))
}

consume inputs: move (left: Stream<Int>, right: Stream<Int>) -> Unit uses Console {
    inputs -> zip => joined
    joined -> each pair { "function=$(pair.left)+$(pair.right)" -> println }
}

main {
    1..2 -> makeValues => zipLeft
    10..12 -> makeValues => zipRight
    (left: zipLeft, right: zipRight) => zipInputs
    zipInputs -> zip => zipped
    zipped -> each pair { "zip=$(pair.left)+$(pair.right)" -> println }

    1..2 -> makeValues => concatLeft
    10..11 -> makeValues => concatRight
    (concatLeft, concatRight) => concatInputs
    concatInputs -> concat => concatenated
    concatenated -> each value { "concat=$value" -> println }

    1..2 -> makeValues => mergeLeft
    10..11 -> makeValues => mergeRight
    (mergeLeft, mergeRight) => mergeInputs
    mergeInputs -> merge => merged
    merged -> each value { "merge=$value" -> println }

    1..2 -> makeValues => latestLeft
    10..11 -> makeValues => latestRight
    (left: latestLeft, right: latestRight) => latestInputs
    latestInputs -> latest => current
    current -> each pair { "latest=$(pair.left)+$(pair.right)" -> println }

    makePair() => factoryInputs
    factoryInputs -> concat => factory
    factory -> each value { "factory=$value" -> println }

    makePair() => functionInputs
    functionInputs -> consume

    5..6 -> makeValues => directLeft
    50..51 -> makeValues => directRight
    (left: directLeft, right: directRight) -> zip => direct
    direct -> each pair { "direct=$(pair.left)+$(pair.right)" -> println }
}
