import probe.identity.left as left
import probe.identity_left as right
struct Cell { value: Int }
impl left.Measure for Cell { get: self -> Int => self.value }
impl right.Measure for Cell { get: self -> Int => self.value * 2 }
main {
    Cell { value: 3 } -> dyn<left.Measure> => first
    Cell { value: 3 } -> dyn<right.Measure> => second
    first -> left.Measure.get -> println
    second -> right.Measure.get -> println
}
