import probe.identity.left
import probe.identity_left
struct Cell { value: Int }
impl left.Measure for Cell { get: self -> Int => self.value }
impl identity_left.Measure for Cell { get: self -> Int => self.value * 2 }
main {
    Cell { value: 3 } -> dyn<left.Measure> => first
    Cell { value: 3 } -> dyn<identity_left.Measure> => second
    first -> left.Measure.get -> println
    second -> identity_left.Measure.get -> println
}
