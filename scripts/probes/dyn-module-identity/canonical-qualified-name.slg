import probe.identity.left as left
import probe.identity_left as right
struct Cell { value: Int }
impl left.Measure for Cell { get: self -> Int => self.value }
impl right.Measure for Cell { get: self -> Int => self.value * 2 }
main {
    Cell { value: 3 } -> dyn<probe.identity.left.Measure> => first
    Cell { value: 3 } -> dyn<probe.identity_left.Measure> => second
    first -> probe.identity.left.Measure.get -> println
    second -> probe.identity_left.Measure.get -> println
}
