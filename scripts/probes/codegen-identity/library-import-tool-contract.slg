import sollang.compiler.toolchain as toolchain
import sys.process as process

main {
    process.arguments() => arguments
    "LIBRARY ucrtbase.dll\nEXPORTS\n_wspawnvp\nmemcpy\nstrlen\ngetchar\n" => specification
    arguments[1] -> toolchain.createImportLibrary(arguments[2], arguments[3], specification) => status
    process.exit(status)
}
