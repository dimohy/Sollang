borrow<T> values: ref [T; ~] -> ref [T; ~] => values

struct Index { values: [Int; ~] }

main {
    Index { values: [7,; ~] } => index
    index.values -> borrow => first
    [8,; ~] => values!
    values! -> push(9)
    values! -> borrow => second
    first -> len -> println
    second -> len -> println
    first -> capacity -> println
}
