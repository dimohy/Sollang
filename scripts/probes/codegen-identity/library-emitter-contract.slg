import sollang.compiler.llvm.text as llvm
import sollang.compiler.semantic.semantic_cache as semanticCache
import sys.file as file
import sys.process as process

main {
    process.arguments() => arguments
    arguments[1] -> file.mapText => owner
    owner -> slice(UIntSize(0), owner -> len) => source
    [source; ~] => sources
    [arguments[1]; ~] => paths
    semanticCache.disabled() => cache
    sources -> llvm.emitLibraryCheckedWithSourcePathsCached(paths, paths, 0, cache, true, "math.dll", arguments[2]) => status
    owner -> len => ownerLength
    process.exit(status)
}
