import sollang.compiler.llvm.source_root as sourceRoot
import sollang.compiler.semantic.semantic_cache as semanticCache
import sys.path as path
import sys.process as process

main {
    process.arguments() => arguments
    arguments[1] == "ordinary" => ordinary
    not ordinary and arguments[1] != "library" -> if {
        "unknown focused emitter mode" -> println
        process.exit(1)
    }
    arguments[3] -> path.fromText(path.nativeStyle()) => root
    semanticCache.disabled() => cache
    ordinary -> if {
        root -> sourceRoot.emitCachedCheckedRoot(4, 0, cache)
    } else {
        root -> sourceRoot.emitCachedLibraryCheckedRoot(4, 0, cache, "math.dll", arguments[2])
    } => status
    process.exit(status)
}
