main {
    process.arguments() => arguments
    arguments[1] => selected
    when {
        selected == "fragment-0" => record0() -> observe("fragment-0")
        selected == "fragment-1073741825" => record1() -> observe("fragment-1073741825")
        selected == "fragment-4294967296" => record2() -> observe("fragment-4294967296")
        selected == "fragment-4294967297" => record3() -> observe("fragment-4294967297")
        selected == "fragment-9223372036854775808" => record4() -> observe("fragment-9223372036854775808")
        selected == "fragment-18446744073709551615" => record5() -> observe("fragment-18446744073709551615")
        selected == "kind-3" => record6() -> observe("kind-3")
        selected == "kind-4294967296" => record7() -> observe("kind-4294967296")
        selected == "kind-18446744073709551615" => record8() -> observe("kind-18446744073709551615")
        else => process.exit(2)
    }
}
