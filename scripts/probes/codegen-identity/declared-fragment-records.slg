import sollang.compiler.llvm.codegen_units as codegen
import sys.process as process

observe words: [UInt64; ~], label: Text -> Unit uses Console {
    words -> codegen.validate(101, 202, 303) => validation
    words -> codegen.decode(101, 202, 303) => decoded
    words -> codegen.merge(101, 202, 303) => merged
    "$label=$(validation.status),$(decoded.status),$(merged.status)" -> println
}

