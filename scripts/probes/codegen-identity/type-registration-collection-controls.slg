import sollang.compiler.semantic.reference_synthetic_type_ids as ids
import sys.process as process

inspect: -> Unit uses Console, Process {
    [
    ids.Recipe { kind: ids.Kind.Named, first: -1, second: -1, length: 0 },
    ids.Recipe { kind: ids.Kind.Named, first: -1, second: -1, length: 0 },
    ids.Recipe { kind: ids.Kind.Dynamic, first: 0, second: -1, length: 0 },
    ids.Recipe { kind: ids.Kind.Dictionary, first: 0, second: 1, length: 0 },
    ids.Recipe { kind: ids.Kind.Set, first: 0, second: -1, length: 0 },
    ids.Recipe { kind: ids.Kind.Set, first: 0, second: -1, length: 0 },
    ids.Recipe { kind: ids.Kind.Deque, first: 0, second: -1, length: 0 },
    ids.Recipe { kind: ids.Kind.BinaryHeap, first: 0, second: -1, length: 0 }; ~] => recipes
    [2, 0, -1, -1, -1, -1, -1, -1; ~] => seeds
    [ids.Shape; ~] => aliases
    [2, 3, 4, 5, 6, 7; ~] => roots
    recipes -> ids.register(seeds, aliases, roots, 100) -> when {
        Err(_) { process.exit(1)
            return }
        Ok(value) { value }
    } => registered
    [2, 0, 100, 101, 102, 102, 103, 104] => expected
    registered.nextTypeId != 105 -> if { process.exit(2) }
    0..<(expected -> len) -> each index {
        registered.ids[index] != expected[index] -> if { process.exit(3) }
    }
    "collection-factories:distinct-and-interned" -> println
}

main { inspect() }
