import sollang.compiler.semantic.library_interfaces as interfaces
import sys.file as file

writeHex bytes: [UInt8; 64] -> Unit uses Console {
    [UInt8; ~] => text!
    bytes -> each value { text! -> push(value) }
    text! -> file.borrowBytes => owner
    owner -> slice(UIntSize(0), owner -> len) -> println
}

main {
    "increaseInt32valueslg_dc7a3a3ad5028317688622961e45d5cb27150659c3487b0a321ed3033923fa89_increase" => source
    interfaces.MetadataSpan { start: 0, length: 8 } => name
    interfaces.MetadataSpan { start: 8, length: 5 } => scalar
    [interfaces.LibraryExport {
        name: name
        qualifiedName: name
        symbol: interfaces.MetadataSpan { start: 18, length: 77 }
        parameterStart: 0
        parameterCount: 1
        resultType: scalar
        signatureHash: interfaces.MetadataSpan { start: 0, length: 0 }
    }; ~] => exports
    [interfaces.LibraryParameter {
        name: interfaces.MetadataSpan { start: 13, length: 5 }
        typeName: scalar
    }; ~] => parameters
    source -> interfaces.abiMaterial(exports, parameters) => abi
    source -> interfaces.signatureMaterial(exports[0], parameters) => signature
    "abi=" -> print
    abi -> interfaces.hashHex -> writeHex
    "signature=" -> print
    signature -> interfaces.hashHex -> writeHex
}
