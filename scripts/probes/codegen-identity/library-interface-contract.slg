import sollang.compiler.semantic.library_interfaces as interfaces
import sys.file as file
import sys.process as process

check path: Text, label: Text -> Unit uses Console, File {
    path -> file.mapText => owner
    owner -> interfaces.parseSourceForTarget("windows-x64") => document
    "$label=$(document.status)" -> println
}

main {
    process.arguments() => arguments
    arguments[1] -> check("valid")
    arguments[2] -> check("abi")
    arguments[3] -> check("signature")
}
