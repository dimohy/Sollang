import sollang.compiler.llvm.codegen_units as codegen

record: -> [UInt64; ~] => [
6002245291164258119, 1, 101, 202,
303, 2, 24, 3767646442389999970,
0, 0, 101, 202,
0, 0, 0, 1033661766257033286,
2, 0, 101, 202,
0, 0, 0, 1033661766257033286; ~
]

main {
    0..<8 -> each row {
        row % 2 == 1 -> if { UInt64(101) } else { UInt64(102) } => compiler
        row / 2 % 2 == 1 -> if { UInt64(202) } else { UInt64(203) } => target
        row / 4 % 2 == 1 -> if { UInt64(303) } else { UInt64(304) } => configuration
        record() => words
        words -> codegen.validate(compiler, target, configuration) => validation
        words -> codegen.decode(compiler, target, configuration) => decoded
        words -> codegen.merge(compiler, target, configuration) => merged
        "$row=$(validation.status),$(decoded.status),$(merged.status)" -> println
    }
}
