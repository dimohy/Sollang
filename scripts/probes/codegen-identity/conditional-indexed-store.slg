import sys.process as process

eachConditional count: Int -> [Int; ~] {
    [Int; ~] => ids!
    0 => fill!
    fill! < count -> while { ids! -> push(-1)
        fill! + 1 => fill! }
    1024 => next!
    [3, 4] -> each kind {
        0 => index!
        index! < count -> while {
            kind == 3 -> if { next! => value
                next! + 1 => next!
                value } else { next! => value
                next! + 1 => next!
                value } => ids![index!]
            index! + 1 => index!
        }
    }
    ids!
}

whileConditional count: Int -> [Int; ~] {
    [Int; ~] => ids!
    0 => fill!
    fill! < count -> while { ids! -> push(-1)
        fill! + 1 => fill! }
    1024 => next!
    3 => kind!
    kind! <= 4 -> while {
        0 => index!
        index! < count -> while {
            kind! == 3 -> if { next! => value
                next! + 1 => next!
                value } else { next! => value
                next! + 1 => next!
                value } => ids![index!]
            index! + 1 => index!
        }
        kind! + 1 => kind!
    }
    ids!
}

eachDirect count: Int -> [Int; ~] {
    [Int; ~] => ids!
    0 => fill!
    fill! < count -> while { ids! -> push(-1)
        fill! + 1 => fill! }
    [3, 4] -> each kind {
        0 => index!
        index! < count -> while {
            kind + index! => ids![index!]
            index! + 1 => index!
        }
    }
    ids!
}

main {
    Int(process.arguments() -> len) + 2 => count
    "each-if" -> println
    count -> eachConditional -> each value { value -> println }
    "while-if" -> println
    count -> whileConditional -> each value { value -> println }
    "each-direct" -> println
    count -> eachDirect -> each value { value -> println }
}
