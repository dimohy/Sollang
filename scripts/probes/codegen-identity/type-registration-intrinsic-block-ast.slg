import sollang.compiler.ast as ast
import sollang.compiler.lexer as lexer
import sollang.compiler.semantic.symbols as symbols
import sys.file as file
import sys.process as process

main {
    process.arguments() => arguments
    arguments[1] -> file.mapText => owner
    owner -> slice(0, owner -> len) => source
    source -> ast.lower => nodes
    source -> lexer.lex => tokens
    nodes -> symbols.collectPreparedWithTokens(tokens) => declarations
    declarations -> each declaration {
        declaration.kind == 7 or declaration.kind == 31
            -> if {
                tokens[declaration.nameToken] => token
                source -> slice(token.span.start, token.span.length) => name
                declaration.blockTypeNode >= 0 -> if {
                    nodes[declaration.blockTypeNode] => input
                    source -> slice(input.start, input.length)
                } else { "-" } => input
                declaration.blockResultTypeNode >= 0 -> if {
                    nodes[declaration.blockResultTypeNode] => result
                    source -> slice(result.start, result.length)
                } else { "-" } => result
                "$name\t$input\t$result" -> println
            }
    }
}
