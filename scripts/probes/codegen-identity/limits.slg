import sollang.compiler.llvm.codegen_units as codegen

check length: Int -> Unit uses Console {
    [UInt64; ~] => identities!
    UInt64(1469598103934665603) => hash!
    0 => index!
    index! < length -> while {
        identities! -> push(120)
        hash! * 1099511628211 + 120 => hash!
        index! + 1 => index!
    }
    codegen.CodegenUnits {
        kinds: [0, 1, 2; ~]
        moduleHashes: [0, hash!, 0; ~]
        interfaceHashes: [101, 101, 101; ~]
        implementationHashes: [202, 202, 202; ~]
        identityStarts: [0, 0, 0; ~]
        identityLengths: [0, length, 0; ~]
        identityWords: identities!
        fragmentStarts: [0, 0, 0; ~]
        fragmentWordLengths: [0, 0, 0; ~]
        fragmentByteLengths: [0, 0, 0; ~]
        fragmentWords: [UInt64; ~]
    } => units
    units -> codegen.encode(101, 202, 303) => artifact
    artifact -> codegen.validate(101, 202, 303) => result
    "length=$length status=$(result.status)" -> println
}

main {
    [0, 1, 1048576, 1048577; ~] -> each length { length -> check }
}
