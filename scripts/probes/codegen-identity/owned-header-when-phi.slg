consume values: move [Int; ~] -> Int { values -> len }

choose count: Int, first: Int, second: Bool -> Int {
    [Int; ~] => values!
    0 => index!
    index! < count -> while {
        values! -> push(index!)
        index! + 1 => index!
    }
    first -> when {
        == 1 { values! -> consume }
        else {
            second -> if { values! -> consume } else { values! -> consume }
        }
    }
}

main {
    3 -> choose(1, false) -> println
    3 -> choose(0, true) -> println
    3 -> choose(0, false) -> println
}
