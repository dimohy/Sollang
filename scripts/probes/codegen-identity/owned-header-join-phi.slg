consume values: move [Int; ~] -> Int { values -> len }

choose count: Int, first: Bool, second: Bool -> Int {
    [Int; ~] => values!
    0 => index!
    index! < count -> while {
        values! -> push(index!)
        index! + 1 => index!
    }
    first -> if { values! -> consume } else {
        second -> if { values! -> consume } else { values! -> consume }
    }
}

main {
    3 -> choose(true, false) -> println
    3 -> choose(false, true) -> println
    3 -> choose(false, false) -> println
}
