native counter from "artifacts/scratch/resume-20261006-owner-continuation22/handle25784-library/counter" {
    handle Counter drop "counter_drop"
    create initial: Int32 -> counter.Counter as "counter_create"
    try createChecked initial: Int32 -> counter.Counter as "counter_try_create"
    value self: ref counter.Counter -> Int32 as "counter_value"
    drops: -> Int32 as "counter_drops"
}

read value: Int32 -> Int32 {
    counter.createChecked(value) -> when {
        Result<counter.Counter, Int32>.Ok(owner) => owner -> counter.value
        Result<counter.Counter, Int32>.Err(error) => error
    }
}

main {
    read(42) -> println
    counter.drops() -> println
    read(-1) -> println
    counter.drops() -> println
