import sys.file as file

valueOrEnd result: Result<Option<UInt8>, Text> -> Int => result -> when {
    Ok(value) => value -> when { Some(byte) => Int(byte) None => -1 }
    Err(error) => -2
}
main {
    file.openRead("scripts/probes/file-completion-publication/input.txt") -> when {
        Ok(reader) {
            reader -> readAtAsync<UInt8>(0) => pending
            pending -> await -> valueOrEnd -> println
        }
        Err(error) { "open-error" -> println }
    }
}
