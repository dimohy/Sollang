import sys.file as file

valueOrEnd result: Result<Option<UInt8>, Text> -> Int => result -> when {
    Ok(value) => value -> when { Some(byte) => Int(byte) None => -1 }
    Err(error) => -2
}
main {
    "scripts/probes/file-completion-publication/input.txt" -> file.openReader
    file.readAsync<UInt8>() -> await -> valueOrEnd => first
    file.readAsync<UInt8>() -> await -> valueOrEnd => end
    file.closeReader()
    "scripts/probes/file-completion-publication/input.txt" -> file.openReader
    file.readAsync<UInt8>() -> await -> valueOrEnd => again
    file.closeReader()
    "legacy=$first,$end,$again" -> println
}
