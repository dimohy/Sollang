implicit value: ref Int -> Int { value }
explicit value: ref Int -> Int { value -> return }
additional prefix: Int, value: ref Int -> Int { value -> return }
nested value: ref Int, chosen: Bool -> Int {
    chosen -> if { value -> return }
    0
}
boolean value: ref Bool -> Bool { value -> return }
text value: ref Text -> Text { value -> return }
forward value: ref Int -> ref Int { value -> return }

main {
    17 => number
    true => chosen
    "token" => word
    number -> implicit -> println
    number -> explicit -> println
    0 -> additional(number) -> println
    number -> nested(true) -> println
    chosen -> boolean -> println
    word -> text -> println
    number -> forward -> implicit -> println
}
