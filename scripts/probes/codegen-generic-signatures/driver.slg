import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.reference_prepared_type_ids as reference
import sollang.compiler.semantic.function_type_binding_policy as policy
import sollang.compiler.source_root as sourceRoot
import sys.file as file
import sys.path as path
import sys.process as process

verifyBindingDecision actual: Bool, expected: Bool, code: Int -> Unit uses Process {
    actual and not expected or not actual and expected
        -> if { process.exit(code) }
}

inspect: -> Unit uses Console, File, Process {
    0 => decisions!
    [false, true] -> each first {
        [false, true] -> each second {
            [false, true] -> each third {
                policy.bindReturnTypeEagerly(first, second, third) -> verifyBindingDecision(not first or second and not third, 1)
                policy.bindOwnershipTypeEagerly(first, second, third) -> verifyBindingDecision(first and not second and third, 2)
                decisions! + 2 => decisions!
            }
        }
        policy.bindCallbackResultEagerly(first) -> verifyBindingDecision(first, 3)
        decisions! + 1 => decisions!
    }
    "decisions:$(decisions!)" -> println
    process.arguments() => arguments
    arguments[1] -> path.fromText(path.nativeStyle()) -> sourceRoot.discoverDirect => paths
    [file.SourceText; ~] => owners!
    paths -> each current { current -> pathText -> file.mapText => owner
        owners! -> push(owner) }
    arguments[2] -> file.mapText => fixture
    owners! -> push(fixture)
    [Text; ~] => sources!
    owners! -> each owner { owner -> slice(0, owner -> len) => source
        sources! -> push(source) }
    sources! -> semanticContext.prepare => prepared
    prepared -> reference.registerMetadataSignatures -> when {
        Err(error) {
            error -> when {
                Nominal(_) { "error:nominal" -> println }
                Synthetic(value) {
                    value -> when {
                        InvalidType { "error:invalid-type" -> println }
                        InvalidShape { "error:invalid-shape" -> println }
                        Cycle { "error:cycle" -> println }
                        TypeIdOverflow { "error:overflow" -> println }
                    }
                }
                InvalidSource { "error:source" -> println }
            }
            process.exit(4) -> return
        }
        Ok(value) { value }
    } => identities
    [Int; ~] => seen!
    0 => typeId!
    prepared.semantic.types -> each type {
        identities.ids[typeId!] => identity
        type.containsParameter and identity >= 0
            and (type.kind == 3 or type.kind == 10 or (type.kind == 7 and type.origin == 4 and (type.symbol == 0 or type.symbol == 1)))
            -> if {
                false => duplicate!
                seen! -> each previous { previous == identity -> if { true => duplicate! } }
                not duplicate! -> if {
                    seen! -> push(identity)
                    type.first >= 0 -> if { identities.ids[type.first] } else { -1 } => first
                    type.second >= 0 -> if { identities.ids[type.second] } else { -1 } => second
                    "abstract:$identity:$(type.kind):$(type.symbol):$first:$second:$(type.length)" -> println
                }
            }
        typeId! + 1 => typeId!
    }
    "abstract-count:$(seen! -> len)" -> println
}
main { inspect() }
