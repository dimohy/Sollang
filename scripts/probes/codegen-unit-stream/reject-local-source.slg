import sollang.compiler.llvm.codegen_units as units
import sys.file as file

dangling: -> Result<[units.StreamedUnit; ~], units.UnitStreamError> uses File {
    "scripts/probes/codegen-unit-stream/input.txt" -> file.mapText => owner
    owner -> slice(0, owner -> len) -> units.readStreamedUnits
}

main {
    dangling() -> when {
        Ok(parts) { parts -> each part { part.fragment -> println } }
        Err(error) { "empty" -> println }
    }
}
