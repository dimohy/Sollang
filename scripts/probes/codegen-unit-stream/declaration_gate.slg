namespace sollang.compiler.probes.declaration_gate

import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.diagnostics as diagnostics
import sys.file as file
import sys.process as process

main {
    process.arguments() => arguments
    arguments[1] -> file.mapText => owner
    owner -> slice(0, owner -> len) => source
    [source,; ~] -> analysis.analyze => package
    package -> diagnostics.firstSignatureTypeDiagnostic => diagnostic
    "declaration:$(diagnostic.code)" -> println
    diagnostic.code != 0 -> if { process.exit(1) }
}
