import sollang.compiler.llvm.codegen_units as units
import sys.file as file
import sys.process as process

run: -> Unit uses Console, File, Process {
    process.arguments() => arguments
    arguments[1] -> file.mapText => owner
    owner -> slice(0, owner -> len) -> units.compilerStreamPayload -> units.readStreamedUnits -> when {
        Err(_) { process.exit(1)
            return }
        Ok(parts) {
            parts -> each part {
                not part.hasKey -> if { process.exit(2)
                    return }
                "unit:$(part.kind):$(part.identity):$(part.interfaceHash):$(part.implementationHash):$(part.fragment -> len)" -> println
            }
        }
    }
}

main { run() }
