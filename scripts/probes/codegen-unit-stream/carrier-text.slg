import sys.file as file

struct Holder { source: file.SourceText, borrowed: Text }

borrow external: Text -> Text uses File {
    Holder {
        source: "scripts/probes/codegen-unit-stream/input.txt" -> file.mapText
        borrowed: external
    } => owner
    owner.borrowed -> slice(0, 6)
}

main { "prefix suffix" -> borrow -> println }
