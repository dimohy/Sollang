    "; sollang.codegen.unit 0:\n; sollang.codegen.key 1:2\n; sollang.codegen.unit 2:\n; sollang.codegen.end\n" -> check(false, "keyed-missing-suffix")
    "; sollang.codegen.unit 0:\n; sollang.codegen.key -1:2\n; sollang.codegen.unit 2:\n; sollang.codegen.key 3:4\n; sollang.codegen.end\n" -> check(false, "keyed-negative")
    "; sollang.codegen.unit 0:\n; sollang.codegen.key 18446744073709551616:2\n; sollang.codegen.unit 2:\n; sollang.codegen.key 3:4\n; sollang.codegen.end\n" -> check(false, "keyed-overflow")
    "; sollang.codegen.unit 0:\n; sollang.codegen.key 01:2\n; sollang.codegen.unit 2:\n; sollang.codegen.key 3:4\n; sollang.codegen.end\n" -> check(false, "keyed-leading-zero")
    "; sollang.codegen.unit 0:\n; sollang.codegen.key 12\n; sollang.codegen.unit 2:\n; sollang.codegen.key 3:4\n; sollang.codegen.end\n" -> check(false, "keyed-no-colon")
    "; sollang.codegen.unit 0:\n; sollang.codegen.key 1:2:3\n; sollang.codegen.unit 2:\n; sollang.codegen.key 3:4\n; sollang.codegen.end\n" -> check(false, "keyed-extra-colon")
    "; sollang.codegen.unit 0:\n; sollang.codegen.key a:2\n; sollang.codegen.unit 2:\n; sollang.codegen.key 3:4\n; sollang.codegen.end\n" -> check(false, "keyed-nonnumeric")
    "; sollang.codegen.unit 0:\n; sollang.codegen.key :2\n; sollang.codegen.unit 2:\n; sollang.codegen.key 3:4\n; sollang.codegen.end\n" -> check(false, "keyed-empty-hash")
    "; sollang.codegen.unit 0:\n; sollang.codegen.key 18446744073709551615:2\nprefix\n; sollang.codegen.unit 1:cache.beta\n; sollang.codegen.key 3:0\nbody\n; sollang.codegen.unit 2:\n; sollang.codegen.key 5:6\nsuffix\n; sollang.codegen.end\n" -> checkKeyViews
    0 -> units.beginStreamedUnit("")
    "prefix" -> println
    1 -> units.beginStreamedUnit("cache.beta")
    "body" -> println
    2 -> units.beginStreamedUnit("")
    "suffix" -> println
    units.endStreamedUnits()
}
