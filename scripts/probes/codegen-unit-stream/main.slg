    "; sollang.codegen.unit 0:\nbody\n; sollang.codegen.key 1:2\n; sollang.codegen.unit 2:\n; sollang.codegen.key 3:4\n; sollang.codegen.end\n" -> check(false, "keyed-late")
    "; sollang.codegen.unit 0:\n; sollang.codegen.key 1:2\n; sollang.codegen.key 1:2\n; sollang.codegen.unit 2:\n; sollang.codegen.key 3:4\n; sollang.codegen.end\n" -> check(false, "keyed-duplicate")
