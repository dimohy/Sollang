import sollang.compiler.llvm.codegen_units as units
import sys.process as process
import sys.file as file

check source: Text, expected: Bool, label: Text -> Unit uses Console, Process {
    source -> units.readStreamedUnits -> when {
        Ok(parts) { true }
        Err(error) { false }
    } => accepted
    (expected and not accepted) or (accepted and not expected)
        -> if { process.exit(1) }
    "$label=ok" -> println
}

checkViews source: Text, label: Text -> Unit uses Console, Process {
    source -> units.readStreamedUnits -> when {
        Ok(parts) {
            (parts -> len) != 3 -> if { process.exit(1) }
            parts[0].kind != 0 or parts[1].kind != 1 or parts[2].kind != 2
                -> if { process.exit(1) }
            not (parts[0].identity == "") or not (parts[1].identity == "cache.beta") or not (parts[2].identity == "")
                -> if { process.exit(1) }
            not (parts[0].fragment == "prefix\n") or not (parts[1].fragment == "body\n") or not (parts[2].fragment == "suffix\n")
                -> if { process.exit(1) }
        }
        Err(error) { process.exit(1) }
    }
    "$label=ok" -> println
}

checkKeyViews source: Text -> Unit uses Console, Process {
    source -> units.readStreamedUnits -> when {
        Err(_) { process.exit(1) }
        Ok(parts) {
            (parts -> len) != 3 -> if { process.exit(1) }
            not parts[0].hasKey or not parts[1].hasKey or not parts[2].hasKey
                -> if { process.exit(1) }
            parts[0].interfaceHash != 18446744073709551615 or parts[1].implementationHash != 0
                -> if { process.exit(1) }
            not (parts[0].fragment == "prefix\n") or not (parts[1].fragment == "body\n") or not (parts[2].fragment == "suffix\n")
                -> if { process.exit(1) }
        }
    }
    "keyed-views=ok" -> println
}

checkReusedViews source: Text -> Unit uses Console, Process {
    source -> units.readStreamedUnits -> when {
        Err(_) { process.exit(1) }
        Ok(parts) {
            (parts -> len) != 3 -> if { process.exit(1) }
            parts[0].reused or not parts[1].reused or parts[2].reused
                -> if { process.exit(1) }
            not (parts[0].fragment == "prefix\n") or not (parts[1].fragment == "body\n") or not (parts[2].fragment == "suffix\n")
                -> if { process.exit(1) }
        }
    }
    "reused-views=ok" -> println
}

main {
