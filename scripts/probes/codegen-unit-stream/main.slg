    "; sollang workers = 2147483648\n; sollang.codegen.unit 0:\n; sollang.codegen.key 1:2\nprefix\n; sollang.codegen.unit 1:cache.beta\n; sollang.codegen.key 3:4\n; sollang.codegen.reused\nbody\n; sollang.codegen.unit 2:\n; sollang.codegen.key 5:6\nsuffix\n; sollang.codegen.end\n" -> units.compilerStreamPayload -> check(false, "worker-overflow")
    "; sollang workers = 1x\n; sollang.codegen.unit 0:\n; sollang.codegen.key 1:2\nprefix\n; sollang.codegen.unit 1:cache.beta\n; sollang.codegen.key 3:4\n; sollang.codegen.reused\nbody\n; sollang.codegen.unit 2:\n; sollang.codegen.key 5:6\nsuffix\n; sollang.codegen.end\n" -> units.compilerStreamPayload -> check(false, "worker-suffix")
    "; sollang workers = 1\n; sollang workers = 1\n; sollang.codegen.unit 0:\n; sollang.codegen.key 1:2\nprefix\n; sollang.codegen.unit 1:cache.beta\n; sollang.codegen.key 3:4\n; sollang.codegen.reused\nbody\n; sollang.codegen.unit 2:\n; sollang.codegen.key 5:6\nsuffix\n; sollang.codegen.end\n" -> units.compilerStreamPayload -> check(false, "worker-duplicate")
    "; sollang.codegen.unit 0:\n; sollang.codegen.key 1:2\nprefix\n; sollang.codegen.unit 1:cache.beta\n; sollang.codegen.key 3:4\n; sollang.codegen.reused\nbody\n; sollang.codegen.unit 2:\n; sollang.codegen.key 5:6\nsuffix\n; sollang.codegen.end\n" -> check(true, "reused-valid")
    "; sollang.codegen.unit 0:\n; sollang.codegen.key 1:2\nprefix\n; sollang.codegen.unit 1:cache.beta\n; sollang.codegen.reused\nbody\n; sollang.codegen.unit 2:\n; sollang.codegen.key 5:6\nsuffix\n; sollang.codegen.end\n" -> check(false, "reused-missing-key")
    "; sollang.codegen.unit 0:\n; sollang.codegen.key 1:2\nprefix\n; sollang.codegen.unit 1:cache.beta\n; sollang.codegen.key 3:4\n; sollang.codegen.reused\n; sollang.codegen.reused\nbody\n; sollang.codegen.unit 2:\n; sollang.codegen.key 5:6\nsuffix\n; sollang.codegen.end\n" -> check(false, "reused-duplicate")
    "; sollang.codegen.unit 0:\n; sollang.codegen.key 1:2\nprefix\n; sollang.codegen.unit 1:cache.beta\n; sollang.codegen.key 3:4\nbody\n; sollang.codegen.reused\n; sollang.codegen.unit 2:\n; sollang.codegen.key 5:6\nsuffix\n; sollang.codegen.end\n" -> check(false, "reused-late")
