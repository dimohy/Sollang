forward<T> value: move Deque<T> -> Deque<T> { value }
countDeque<T> value: ref Deque<T> -> Int { value -> len }
combinedCount<T> left: move Deque<T>, right: move Deque<T> -> Int {
    (left -> len) + (right -> len)
}

main {
    Deque<Int>(2) => input!
    input! -> pushBack(7)
    input! -> forward => returned!
    returned! -> pushFront(3)
    returned! -> countDeque -> println
    returned! -> popBack => popped
    popped -> println
    Deque<box Int>(2) => boxes!
    boxes! -> pushBack(box 9)
    boxes! -> forward => returnedBoxes
    returnedBoxes -> countDeque -> println
    Deque<Text>(2) => left!
    left! -> pushBack("a")
    Deque<Text>(2) => right!
    right! -> pushBack("b")
    left! -> combinedCount(right!) -> println
}
