namespace sollang.compiler.llvm.text

import sollang.compiler.semantic.type_ids as typeIds

storageType kind: Int, origin: Int, symbol: Int, first: Int, second: Int -> typeIds.SemanticType => typeIds.SemanticType {
    kind: kind, origin: origin, module: 0, symbol: symbol, first: first, second: second,
    length: 0, lengthHash: 0, containsParameter: false, status: 0
}

public ownedStorageClassificationChecks: -> Unit uses Console {
    [typeIds.SemanticType; ~] => types!
    types! -> push(storageType(1, 1, 2, -1, -1))
    types! -> push(storageType(1, 0, 0, -1, -1))
    types! -> push(storageType(1, 2, 1, -1, -1))
    types! -> push(storageType(4, 0, -1, 0, -1))
    types! -> push(storageType(12, 0, -1, 0, -1))
    types! -> push(storageType(12, 0, -1, 3, -1))
    types! -> push(storageType(11, 0, -1, 0, -1))
    types! -> push(storageType(10, 0, -1, 6, -1))
    types! -> push(storageType(11, 0, -1, 3, -1))
    types! -> push(storageType(10, 0, -1, 8, -1))
    types! -> push(storageType(1, 0, 2, -1, -1))
    types! -> push(storageType(1, 0, 3, -1, -1))
    types! -> push(storageType(1, 0, 4, -1, -1))
    types! -> push(storageType(8, 0, -1, 3, -1))
    types! -> push(storageType(7, 4, 2, 0, -1))
    types! -> push(storageType(13, 0, -1, 0, 0))
    types! -> push(storageType(13, 0, -1, 0, 3))
    types! -> push(storageType(3, 0, -1, 0, -1))
    types! -> push(storageType(6, 0, -1, 0, -1))
    types! -> push(storageType(9, 0, -1, -1, -1))
    [typeIds.NominalField; ~] => fields!
    fields! -> push(typeIds.NominalField { ownerType: 1, sourceModule: 0, ownerSymbol: -1, fieldSymbol: -1, labelToken: -1, ordinal: 0, fieldType: 0, status: 0 })
    fields! -> push(typeIds.NominalField { ownerType: 2, sourceModule: 0, ownerSymbol: -1, fieldSymbol: -1, labelToken: -1, ordinal: 0, fieldType: 1, status: 0 })
    [typeIds.PayloadEdge; ~] => payloads!
    payloads! -> push(typeIds.PayloadEdge { ownerType: 10, payloadType: 0 })
    payloads! -> push(typeIds.PayloadEdge { ownerType: 11, payloadType: 3 })
    [Bool; ~] => resources!
    types! -> each type { resources! -> push(false) }
    true => resources![12]
    typeIds.ownedStorageByType(types!, fields!, payloads!, resources!) => owned
    not owned[1] and not owned[2] => check0
    "storage-nominal=$check0" -> println
    owned[3] => check1
    "storage-fixed=$check1" -> println
    not owned[4] and owned[5] => check2
    "storage-bounded=$check2" -> println
    not owned[7] and owned[9] => check3
    "storage-product=$check3" -> println
    not owned[10] and owned[11] => check4
    "storage-enum=$check4" -> println
    owned[12] and owned[19] => check5
    "storage-resource=$check5" -> println
    not owned[13] => check6
    "storage-reference=$check6" -> println
    owned[14] => check7
    "storage-task=$check7" -> println
    not owned[15] and owned[16] => check8
    "storage-dictionary=$check8" -> println
    owned[17] and owned[18] => check9
    "storage-dynamic-box=$check9" -> println
}
