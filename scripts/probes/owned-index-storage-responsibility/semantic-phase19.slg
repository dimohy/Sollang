probe6: -> Bool {
    """
    struct IndexedInner {
        data: [Int; ~]
    }
    struct IndexedFrame {
        inner: IndexedInner
    }
    struct IndexedOwner {
        frames: [IndexedFrame; ~]
    }
    observeIndexedData data: [Int] -> Int => data -> len
    main {
        IndexedOwner { frames: [IndexedFrame { inner: IndexedInner { data: [7, 8,; ~] } },; ~] } => owner
        owner.frames[0].inner.data -> observeIndexedData => count
        "$count,$(owner.frames[0].inner.data[0])" -> println
    }
    """ => input
    input -> semanticDiagnostics.ownedIndexDecisionBeforeTypedIr => actualModule
    actualModule == -1
}

probe7: -> Bool {
    """
    struct ScalarFrame {
        start: Int
        finish: Int
        data: [Int; ~]
    }
    struct ScalarOwner {
        frames: [ScalarFrame; ~]
    }
    sumScalarFields first: Int, second: Int -> Int => first + second
    main {
        ScalarOwner {
            frames: [ScalarFrame {
                start: 2
                finish: 3
                data: [7,; ~]
            },; ~]
        } => owner
        owner.frames[0].start -> sumScalarFields(owner.frames[0].finish) => total
        "$total,$(owner.frames[0].data[0])" -> println
    }
    """ => input
    input -> semanticDiagnostics.ownedIndexDecisionBeforeTypedIr => actualModule
    actualModule == -1
}

probe8: -> Bool {
    """
    struct OwnedSymbol {
        name: Text
        payload: [Int; ~]
    }
    
    payloadLength values: [Int; ~] -> Int {
        values -> len => length
        Int(length)
    }
    
    increment value: Int -> Int {
        value + 1
    }
    
    main {
        {Int: OwnedSymbol;
            1: OwnedSymbol { name: "lexer", payload: [10, 20; ~] }
        } => symbols
        symbols[1].payload -> payloadLength => count
        (symbols[1].payload)[0] -> increment => first
        symbols[1].name -> len => nameLength
        "projected borrow=$count,$first,$nameLength" -> println
    }
    """ => input
    input -> semanticDiagnostics.ownedIndexDecisionBeforeTypedIr => actualModule
    actualModule == -1
}

