import sollang.compiler.semantic.diagnostics as semanticDiagnostics

probe0: -> Bool {
    """
    struct Owned {
        value: box Int
    }
    
    main {
        [Owned { value: box 1 }] => values
        values[0] => value
        value.value -> println
    }
    """ => input
    input -> semanticDiagnostics.ownedIndexDecisionBeforeTypedIr => actualModule
    actualModule == 0
}

