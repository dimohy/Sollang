ownedUnlessThree value: Int -> Result<[box Int; ~], Text> {
    value == 3 -> if {
        Result<[box Int; ~], Text>.Err("owned partials cleaned")
    } else {
        Result<[box Int; ~], Text>.Ok([box value,; ~])
    }
}

runValues: -> Result<[[box Int; ~]; ~], Text> {
    [Int; ~] => values!
    1..8 -> each item { values! -> push(item) }
    values! -> tryParallel item {
        item + 0 => local
        local -> ownedUnlessThree
    } => result
    result
}
main {
    runValues() -> when {
        Ok(values) => "unexpected"
        Err(error) => error
    } -> println
}
