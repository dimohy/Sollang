struct Left { value: Int }
struct Right { value: Int }
struct Holder { left: Left, right: Right }

impl Left {
    public read: self -> Int => self.value + 100
}

impl Right {
    public read: self -> Int => self.value + 200
}

projected root: Holder -> Int {
    root.left => first
    root.right => second
    first -> read => left
    second -> read => right
    left + right
}

indexed left: [Left; 2], right: [Right; 2] -> Int {
    left[1] => first
    right[0] => second
    first -> read => leftValue
    second -> read => rightValue
    leftValue + rightValue
}

main {
    projected(Holder { left: Left { value: 7 }, right: Right { value: 9 } }) -> println
    indexed([Left { value: 2 }, Left { value: 3 }], [Right { value: 5 }, Right { value: 6 }]) -> println
}
