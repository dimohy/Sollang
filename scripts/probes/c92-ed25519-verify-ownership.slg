import std.crypto.ed25519

signAndVerify: -> Result<Bool, ed25519.Error> {
    ed25519.publicKey([UInt8(1); 32])? => publicKey
    ed25519.sign([UInt8(1); 32], [UInt8(2); 200])? => signature
    ed25519.verify(publicKey, [UInt8(2); 200], signature)
}

main {
    signAndVerify() -> when {
        Ok(valid) { "verified=$valid" -> println }
        Err(error) { "verify-error" -> println }
    }
}
