node kind: Int, parent: Int, astNode: Int, operand0: Int, operand1: Int, nextOperand: Int -> TypedIrNode {
    TypedIrNode {
        kind: kind, parent: parent, sourceModule: 0, astNode: astNode,
        symbol: -1, targetModule: -1, typeOrigin: -1, typeModule: -1,
        typeSymbol: -1, typeId: -1, typeKind: -1, typeFlags: 0,
        payloadToken: -1, opcode: 0, operand0: operand0, operand1: operand1,
        nextOperand: nextOperand, flags: 0
    }
}

operationNode kind: Int, parent: Int, astNode: Int, operand0: Int, operand1: Int, nextOperand: Int, opcode: Int -> TypedIrNode {
    node(kind, parent, astNode, operand0, operand1, nextOperand) => result!
    opcode => result!.opcode
    result!
}

reverseOrder: -> Unit uses Console {
    [TypedIrNode; ~] => ir!
    ir! -> push(node(0, -1, 0, -1, -1, -1))
    ir! -> push(node(19, 0, 0, -1, -1, -1))
    ir! -> push(node(1, 1, 3, -1, -1, -1))
    ir! -> push(node(1, 1, 1, -1, -1, -1))
    ir! -> push(node(1, 1, 2, -1, -1, -1))
    [AstNode; ~] => nodes!
    nodes! -> push(AstNode { start: 0 })
    nodes! -> push(AstNode { start: 10 })
    nodes! -> push(AstNode { start: 20 })
    nodes! -> push(AstNode { start: 30 })
    [SourceRange; ~] => ranges!
    ranges! -> push(SourceRange { astStart: 0 })
    EmitContext { pointerBitWidth: 64, ir: ir!, nodes: nodes!, ranges: ranges! } => context
    [Int; ~] => ends!
    ends! -> push(5)
    CoreEmitterState { frozenFunctionEnds: ends! } => state
    1 -> emitRegion([0], context, state)
}

