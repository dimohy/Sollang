main {
    "reverse" -> println
    reverseOrder()
    "dependency" -> println
    forwardDependency()
    "branches" -> println
    nestedBranches()
    "short-circuit" -> println
    shortCircuitNestedBranch()
    "each-role" -> println
    eachSourceBeforeRole()
    "late-member" -> println
    previousStatementLateMember()
    "equal-starts" -> println
    equalSourceStarts()
    "binding-operand" -> println
    bindingViaOperand()
    "loop-members" -> println
    loopMemberBoundary()
    "outside-function" -> println
    outsideFunctionOperand()
}
