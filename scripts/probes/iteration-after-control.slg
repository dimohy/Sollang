report limit: Int -> Unit uses Console {
    true -> if { "function-before" -> println }
    1..limit -> each number {
        number > 0 -> if { "function=$number" -> println }
    }
    "function-after" -> println
}

main {
    true -> if { "main-before" -> println }
    2 -> repeat number {
        number > 0 -> if { "main=$number" -> println }
    }
    "main-after" -> println
    report(2)
    true -> if {
        true -> if { "region-before" -> println }
        2 -> repeat number {
            number > 0 -> if { "region=$number" -> println }
        }
        "region-after" -> println
    }
}
