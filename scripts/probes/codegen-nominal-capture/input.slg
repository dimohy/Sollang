namespace cache.nominal

struct Pair {
    small: Bool
    wide: Int64
}

enum Choice { None, Some(Pair), Flag(Bool), Number(Int) }
trait Value { get: self -> Int }

public inspect choice: Choice, value: ref Pair, boxed: box Int, view: [Int], fixed: [Int; 3], growable: [Int; ~], mapped: {Int: Bool}, dynamic: dyn Value -> Unit { }
main { }
