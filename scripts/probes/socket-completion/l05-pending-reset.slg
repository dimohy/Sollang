import std.io.async as asyncio
import std.net as net
import std.net.socket as socket

struct Setup {
    listener: socket.TcpListener
    sender: socket.TcpStream
    receiver: socket.TcpStream
}

setup: -> Result<Setup, socket.SocketError> uses Network {
    socket.ListenOptions {
        endpoint: net.loopback(0) -> unified
        backlog: 1
        reuseAddress: true
    } -> listen? => listener
    listener -> localPort? => port
    net.loopback(port) -> unified -> connect? => sender
    listener -> accept? => receiver
    Result<Setup, socket.SocketError>.Ok(Setup {
        listener: listener
        sender: sender
        receiver: receiver
    })
}

ready: -> async Bool {
    yield
    true
}

main {
    setup() -> when {
        Err(error) { "setup-error=$(error.code)" -> println }
        Ok(value) {
            value.listener => listener
            value.sender => sender
            value.receiver => receiver
            socket.CompletionReactorOptions {
                registrations: 1
                pendingOperations: 1
                completionBatch: 1
            } -> socket.completionReactor -> when {
                Err(error) {
                    receiver -> close
                    sender -> close
                    listener -> close
                    "create-error=$(error.code)" -> println
                }
                Ok(reactor) {
                    reactor -> registerStream(receiver, 85) -> when {
                        Err(failure) {
                            failure.reactor -> close
                            failure.connection -> close
                            sender -> close
                            listener -> close
                            "register-error=$(failure.error.code)" -> println
                        }
                        Ok(registered) {
                            [0, 0, 0; ~] -> socket.operationSlot(805, socket.OperationDirection.Receive) => slot
                            registered -> submit(85, slot) -> when {
                                Err(failure) {
                                    failure.slot => failedSlot
                                    failure.reactor => failedReactor
                                    failedSlot -> intoBytes => returned
                                    failedReactor -> close
                                    sender -> close
                                    listener -> close
                                    "submit-error=$(failure.error.code),len=$(returned -> len)" -> println
                                }
                                Ok(submission) {
                                    submission -> when {
                                        socket.CompletionSubmission.Completed(completion) {
                                            completion.slot => unexpectedSlot
                                            completion.reactor => unexpectedReactor
                                            unexpectedSlot -> intoBytes => returned
                                            unexpectedReactor -> close
                                            sender -> close
                                            listener -> close
                                            "pending=false,len=$(returned -> len)" -> println
                                        }
                                        socket.CompletionSubmission.Pending(pendingReactor) {
                                            pendingReactor -> dequeue(asyncio.Cancellation { requested: false }) => pendingTask
                                            ready() => readyTask
                                            readyTask -> await => readyRan
                                            "ready-task=$readyRan" -> println
                                            sender -> sendText("de") -> when {
                                                Err(error) { "send-error=$(error.code)" -> println }
                                                Ok(_) { }
                                            }
                                            pendingTask -> await -> when {
                                                Err(failure) {
                                                    failure.reactor -> close
                                                    sender -> close
                                                    listener -> close
                                                    "dequeue-error=$(failure.error.code)" -> println
                                                }
                                                Ok(completion) {
                                                    completion.slot => completedSlot
                                                    completion.reactor => completedReactor
                                                    completedSlot -> operationState -> when {
                                                        Completed { true }
                                                        else { false }
                                                    } => terminal
                                                    completedSlot -> transferredCount -> when {
                                                        None { UIntSize(999) }
                                                        Some(count) { count }
                                                    } => count
                                                    completedSlot -> completionError => maybeError
                                                    completedSlot -> byteAt(0) => first
                                                    completedSlot -> intoBytes => bytes
                                                    maybeError -> when {
                                                        None { "reset=false,code=0,state=$terminal,count=$count,len=$(bytes -> len),first=$first" -> println }
                                                        Some(error) {
                                                            error.kind -> when {
                                                                ConnectionReset { true }
                                                                else { false }
                                                            } => reset
                                                            "reset=$reset,code=$(error.code),state=$terminal,count=$count,len=$(bytes -> len),first=$first" -> println
                                                        }
                                                    }
                                                    completedReactor -> close
                                                    sender -> close
                                                    listener -> close
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
