import std.io.async as asyncio
import std.net as net
import std.net.socket as socket
import sys.io as io
import sys.runtime as runtime

main {
    socket.ListenOptions {
        endpoint: net.loopback(0) -> unified
        backlog: 1
        reuseAddress: true
    } -> listen -> when {
        Err(error) { "listen-error=$(error.code)" -> io.println }
        Ok(listener) {
            listener -> localPort -> when {
                Err(error) {
                    listener -> close
                    "port-error=$(error.code)" -> io.println
                }
                Ok(port) {
                    "peer-port=$port" -> io.println
                    runtime.flushStandardOutput()
                    listener -> accept -> when {
                        Err(error) {
                            listener -> close
                            "accept-error=$(error.code)" -> io.println
                        }
                        Ok(receiver) {
                            socket.CompletionReactorOptions {
                                registrations: 1
                                pendingOperations: 1
                                completionBatch: 1
                            } -> socket.completionReactor -> when {
                                Err(error) {
                                    receiver -> close
                                    listener -> close
                                    "create-error=$(error.code)" -> io.println
                                }
                                Ok(reactor) {
                                    reactor -> registerStream(receiver, 51) -> when {
                                        Err(failure) {
                                            failure.reactor -> close
                                            failure.connection -> close
                                            listener -> close
                                            "register-error=$(failure.error.code)" -> io.println
                                        }
                                        Ok(registered) {
                                            [7, 8, 9; ~] -> socket.operationSlot(501, socket.OperationDirection.Receive) => slot
                                            registered -> submit(51, slot) -> when {
                                                Err(failure) {
                                                    failure.slot => failedSlot
                                                    failure.reactor => failedReactor
                                                    failedSlot -> intoBytes => returned
                                                    failedReactor -> close
                                                    listener -> close
                                                    "submit-error=$(failure.error.code),len=$(returned -> len)" -> io.println
                                                }
                                                Ok(submission) {
                                                    submission -> when {
                                                        socket.CompletionSubmission.Completed(completion) {
                                                            completion.slot => unexpectedSlot
                                                            completion.reactor => unexpectedReactor
                                                            unexpectedSlot -> intoBytes => returned
                                                            unexpectedReactor -> close
                                                            listener -> close
                                                            "pending=false,len=$(returned -> len)" -> io.println
                                                        }
                                                        socket.CompletionSubmission.Pending(pendingReactor) {
                                                            pendingReactor -> dequeueTerminal(asyncio.Cancellation { requested: false }) => pendingTask
                                                            "pending=true" -> io.println
                                                            runtime.flushStandardOutput()
                                                            pendingTask -> await -> when {
                                                                socket.SocketTerminalOutcome.Succeeded(completion) {
                                                                    completion.slot => completedSlot
                                                                    completion.reactor => completedReactor
                                                                    completedSlot -> intoBytes => returned
                                                                    completedReactor -> close
                                                                    listener -> close
                                                                    "failed=false,len=$(returned -> len)" -> io.println
                                                                }
                                                                socket.SocketTerminalOutcome.Cancelled(completion) {
                                                                    completion.slot => cancelledSlot
                                                                    completion.reactor => cancelledReactor
                                                                    cancelledSlot -> intoBytes => returned
                                                                    cancelledReactor -> close
                                                                    listener -> close
                                                                    "cancelled=true,len=$(returned -> len)" -> io.println
                                                                }
                                                                socket.SocketTerminalOutcome.Failed(completion) {
                                                                    completion.slot => failedSlot
                                                                    completion.reactor => failedReactor
                                                                    failedSlot -> operationState -> when {
                                                                        Completed { true }
                                                                        else { false }
                                                                    } => completed
                                                                    failedSlot -> transferredCount -> when {
                                                                        None { UIntSize(999) }
                                                                        Some(count) { count }
                                                                    } => count
                                                                    failedSlot -> completionError -> when {
                                                                        None {
                                                                            failedSlot -> intoBytes => returned
                                                                            failedReactor -> close
                                                                            listener -> close
                                                                            "missing-error=true,len=$(returned -> len)" -> io.println
                                                                        }
                                                                        Some(error) {
                                                                            error.kind -> when {
                                                                                ConnectionReset { true }
                                                                                else { false }
                                                                            } => reset
                                                                            error.code => code
                                                                            failedSlot -> byteAt(0) == 7
                                                                                and failedSlot -> byteAt(1) == 8
                                                                                and failedSlot -> byteAt(2) == 9 => unchanged
                                                                            failedSlot -> intoBytes => returned
                                                                            "failed=true,reset=$reset,code=$code,state=$completed,count=$count,len=$(returned -> len),unchanged=$unchanged" -> io.println
                                                                            failedReactor -> close
                                                                            listener -> close
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
