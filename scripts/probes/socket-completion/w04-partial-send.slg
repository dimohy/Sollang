import std.io.async as asyncio
import std.net as net
import std.net.socket as socket
import sys.io as io
import sys.runtime as runtime

main {
    socket.ListenOptions {
        endpoint: net.loopback(0) -> unified
        backlog: 1
        reuseAddress: true
    } -> listen -> when {
        Err(error) { "listen-error=$(error.code)" -> io.println }
        Ok(listener) {
            listener -> localPort -> when {
                Err(error) {
                    listener -> close
                    "port-error=$(error.code)" -> io.println
                }
                Ok(port) {
                    "peer-port=$port" -> io.println
                    runtime.flushStandardOutput()
                    listener -> accept -> when {
                        Err(error) {
                            listener -> close
                            "accept-error=$(error.code)" -> io.println
                        }
                        Ok(sender) {
                            socket.CompletionReactorOptions {
                                registrations: 1
                                pendingOperations: 1
                                completionBatch: 1
                            } -> socket.completionReactor -> when {
                                Err(error) {
                                    sender -> close
                                    listener -> close
                                    "create-error=$(error.code)" -> io.println
                                }
                                Ok(reactor) {
                                    reactor -> registerStream(sender, 41) -> when {
                                        Err(failure) {
                                            failure.reactor -> close
                                            failure.connection -> close
                                            listener -> close
                                            "register-error=$(failure.error.code)" -> io.println
                                        }
                                        Ok(registered) {
                                            [10, 20, 30, 40, 50; ~]
                                                -> socket.operationSlot(401, socket.OperationDirection.Send)
                                                -> range(0, 3)
                                                -> when {
                                                    Err(failure) {
                                                        failure -> intoSlot -> intoBytes => returned
                                                        registered -> close
                                                        listener -> close
                                                        "range-error=true,len=$(returned -> len)" -> io.println
                                                    }
                                                    Ok(slot) {
                                                        registered -> submit(41, slot) -> when {
                                                            Err(failure) {
                                                                failure.slot => failedSlot
                                                                failure.reactor => failedReactor
                                                                failedSlot -> intoBytes => returned
                                                                failedReactor -> close
                                                                listener -> close
                                                                "submit-error=$(failure.error.code),len=$(returned -> len)" -> io.println
                                                            }
                                                            Ok(submission) {
                                                                submission -> when {
                                                                    socket.CompletionSubmission.Completed(completion) {
                                                                        Result<socket.SocketCompletion, socket.CompletionWaitFailure>.Ok(completion)
                                                                    }
                                                                    socket.CompletionSubmission.Pending(pendingReactor) {
                                                                        pendingReactor -> dequeue(asyncio.Cancellation { requested: false }) => pendingTask
                                                                        pendingTask -> await
                                                                    }
                                                                } -> when {
                                                                    Err(failure) {
                                                                        failure.reactor -> close
                                                                        listener -> close
                                                                        "dequeue-error=$(failure.error.code)" -> io.println
                                                                    }
                                                                    Ok(completion) {
                                                                        completion.slot => completedSlot
                                                                        completion.reactor => completedReactor
                                                                        completedSlot -> operationState -> when {
                                                                            Completed { true }
                                                                            else { false }
                                                                        } => completed
                                                                        completedSlot -> transferredCount -> when {
                                                                            None { UIntSize(999) }
                                                                            Some(count) { count }
                                                                        } => count
                                                                        completedSlot -> completionError -> when {
                                                                            None { false }
                                                                            Some(_) { true }
                                                                        } => hasError
                                                                        completedSlot -> byteAt(0) == 10
                                                                            and completedSlot -> byteAt(1) == 20
                                                                            and completedSlot -> byteAt(2) == 30
                                                                            and completedSlot -> byteAt(3) == 40
                                                                            and completedSlot -> byteAt(4) == 50 => unchanged
                                                                        completedSlot -> intoBytes => returned
                                                                        "sent=true,count=$count,state=$completed,error=$hasError,len=$(returned -> len),unchanged=$unchanged" -> io.println
                                                                        completedReactor -> close
                                                                        listener -> close
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
