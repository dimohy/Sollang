import std.io.async as asyncio
import std.net as net
import std.net.socket as socket
import std.time as time
import sys.io as io
import sys.runtime as runtime

finish reactor: move socket.CompletionReactor, slot: move socket.OperationSlot, completionWinner: Bool -> Unit uses Network, Console {
    slot -> transferredCount -> when {
        None { UIntSize(999) }
        Some(count) { count }
    } => count
    slot -> operationState -> when {
        Completed { completionWinner }
        Cancelled { not completionWinner }
        else { false }
    } => stateMatches
    slot -> byteAt(0) => byte
    slot -> intoBytes => returned
    "winnerCompletion=$completionWinner,count=$count,byte=$byte,state=$stateMatches,len=$(returned -> len)" -> io.println
    reactor -> cancelOperation(601) -> when {
        Ok(unexpected) {
            unexpected -> close
            "secondCancelRejected=false" -> io.println
        }
        Err(failure) {
            failure.error.kind -> when {
                InvalidArgument { true }
                else { false }
            } => rejected
            failure.reactor -> close
            "secondCancelRejected=$rejected" -> io.println
        }
    }
}

main {
    socket.ListenOptions {
        endpoint: net.loopback(0) -> unified
        backlog: 1
        reuseAddress: true
    } -> listen -> when {
        Err(error) { "listen-error=$(error.code)" -> io.println }
        Ok(listener) {
            listener -> localPort -> when {
                Err(error) {
                    listener -> close
                    "port-error=$(error.code)" -> io.println
                }
                Ok(port) {
                    "peer-port=$port" -> io.println
                    runtime.flushStandardOutput()
                    listener -> accept -> when {
                        Err(error) {
                            listener -> close
                            "accept-error=$(error.code)" -> io.println
                        }
                        Ok(receiver) {
                            socket.CompletionReactorOptions {
                                registrations: 1
                                pendingOperations: 1
                                completionBatch: 1
                            } -> socket.completionReactor -> when {
                                Err(error) {
                                    receiver -> close
                                    listener -> close
                                    "create-error=$(error.code)" -> io.println
                                }
                                Ok(reactor) {
                                    reactor -> registerStream(receiver, 61) -> when {
                                        Err(failure) {
                                            failure.reactor -> close
                                            failure.connection -> close
                                            listener -> close
                                            "register-error=$(failure.error.code)" -> io.println
                                        }
                                        Ok(registered) {
                                            [0; ~] -> socket.operationSlot(601, socket.OperationDirection.Receive) => slot
                                            registered -> submit(61, slot) -> when {
                                                Err(failure) {
                                                    failure.slot => failedSlot
                                                    failure.reactor => failedReactor
                                                    failedSlot -> intoBytes => returned
                                                    failedReactor -> close
                                                    listener -> close
                                                    "submit-error=$(failure.error.code),len=$(returned -> len)" -> io.println
                                                }
                                                Ok(submission) {
                                                    submission -> when {
                                                        socket.CompletionSubmission.Completed(completion) {
                                                            completion.slot => unexpectedSlot
                                                            completion.reactor => unexpectedReactor
                                                            unexpectedSlot -> intoBytes => returned
                                                            unexpectedReactor -> close
                                                            listener -> close
                                                            "pending=false,len=$(returned -> len)" -> io.println
                                                        }
                                                        socket.CompletionSubmission.Pending(pendingReactor) {
                                                            "pending=true" -> io.println
                                                            runtime.flushStandardOutput()
                                                            time.milliseconds(20) -> when {
                                                                Err(_) { "delay=false" -> io.println }
                                                                Ok(delay) { delay -> sleep -> await }
                                                            }
                                                            pendingReactor -> cancelOperation(601) -> when {
                                                                Err(failure) {
                                                                    failure.reactor -> close
                                                                    listener -> close
                                                                    "cancel-error=$(failure.error.code)" -> io.println
                                                                }
                                                                Ok(cancelledReactor) {
                                                                    cancelledReactor -> dequeueTerminal(asyncio.Cancellation { requested: false }) => terminalTask
                                                                    terminalTask -> await -> when {
                                                                        socket.SocketTerminalOutcome.Succeeded(completion) {
                                                                            completion.reactor => completedReactor
                                                                            completion.slot => completedSlot
                                                                            completedReactor -> finish(completedSlot, true)
                                                                            listener -> close
                                                                        }
                                                                        socket.SocketTerminalOutcome.Cancelled(completion) {
                                                                            completion.reactor => cancelledReactor
                                                                            completion.slot => cancelledSlot
                                                                            cancelledReactor -> finish(cancelledSlot, false)
                                                                            listener -> close
                                                                        }
                                                                        socket.SocketTerminalOutcome.Failed(completion) {
                                                                            completion.slot => failedSlot
                                                                            completion.reactor => failedReactor
                                                                            failedSlot -> intoBytes => returned
                                                                            failedReactor -> close
                                                                            listener -> close
                                                                            "failed=true,len=$(returned -> len)" -> io.println
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
