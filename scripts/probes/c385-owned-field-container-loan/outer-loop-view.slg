import sys.path as path
struct Member { manifestPath: path.Path }
Member { manifestPath: "member.project" -> path.fromText(path.Style.Posix) } => owner
owner.manifestPath -> pathText => view
[path.Path; ~] => retained!
0 => index!
index! < 2 -> while {
    view -> println
    retained! -> push(owner.manifestPath)
    index! + 1 => index!
}
