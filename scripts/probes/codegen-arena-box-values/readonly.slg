struct Point { x: Int }

packInt value: ref Int -> box Int { box value }
packPoint value: ref Point -> box Point { box value }
readPoint value: box Point -> Int { value.x }

main {
    42 => number
    packInt(number) => numberOwner
    Point { x: 7 } => point
    packPoint(point) => pointOwner
    "boxed-ref=$(pointOwner -> readPoint)" -> println
}
