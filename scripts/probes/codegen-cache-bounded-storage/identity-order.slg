import sollang.compiler.semantic.reference_synthetic_type_ids as ids
import sys.process as process

main {
    [
    ids.Recipe { kind: ids.Kind.Named, first: -1, second: -1, length: 0 },
    ids.Recipe { kind: ids.Kind.BoundedArray, first: 0, second: -1, length: 4 },
    ids.Recipe { kind: ids.Kind.BoundedArray, first: 0, second: -1, length: 4 },
    ids.Recipe { kind: ids.Kind.BoundedArray, first: 0, second: -1, length: 5 },
    ids.Recipe { kind: ids.Kind.BoundedDictionary, first: 0, second: 0, length: 4 },
    ids.Recipe { kind: ids.Kind.BoundedDictionary, first: 0, second: 0, length: 4 },
    ids.Recipe { kind: ids.Kind.BoundedDictionary, first: 0, second: 0, length: 5 },
    ids.Recipe { kind: ids.Kind.Dictionary, first: 0, second: 0, length: 0 }; ~] => recipes
    [2, -1, -1, -1, -1, -1, -1, -1; ~] => seeds
    [ids.Shape; ~] => aliases
    [1, 2, 3, 4, 5, 6, 7; ~] => roots
    recipes -> ids.register(seeds, aliases, roots, 100) -> when {
        Err(_) { process.exit(1) }
        Ok(registered) {
            "array4=$(registered.ids[1] - 100)" -> println
            "array4Repeat=$(registered.ids[2] - 100)" -> println
            "array5=$(registered.ids[3] - 100)" -> println
            "dictionary4=$(registered.ids[4] - 100)" -> println
            "dictionary4Repeat=$(registered.ids[5] - 100)" -> println
            "dictionary5=$(registered.ids[6] - 100)" -> println
            "dictionaryHeap=$(registered.ids[7] - 100)" -> println
            "next=$(registered.nextTypeId - 100)" -> println
        }
    }
}
