import sollang.compiler.llvm.codegen_cache_key_policy as plans
import sollang.compiler.llvm.codegen_cache_keys as keys

bindings: -> [keys.Binding; ~] {
    [
    keys.Binding { part: plans.KeyPart.Identity, fields: ["cache.한글.𐀀" -> keys.textField; ~] },
    keys.Binding { part: plans.KeyPart.DeclarationContainer, fields: ["Parent" -> keys.textField; ~] },
    keys.Binding { part: plans.KeyPart.Visibility, fields: ["public" -> keys.textField; ~] },
    keys.Binding { part: plans.KeyPart.StructFields, fields: ["first" -> keys.textField, "Int" -> keys.textField, "second" -> keys.textField, "Text" -> keys.textField; ~] },
    keys.Binding { part: plans.KeyPart.EnumVariants, fields: ["None" -> keys.textField, "" -> keys.textField, "Some" -> keys.textField, "Text" -> keys.textField; ~] },
    keys.Binding { part: plans.KeyPart.TraitAssociatedTypes, fields: ["Item" -> keys.textField; ~] },
    keys.Binding { part: plans.KeyPart.TraitMethods, fields: ["read" -> keys.textField, "0" -> keys.textField, "Item" -> keys.textField, "1" -> keys.textField, "Text" -> keys.textField, "0" -> keys.textField; ~] },
    keys.Binding { part: plans.KeyPart.FunctionInput, fields: ["Int" -> keys.textField, "0" -> keys.textField; ~] },
    keys.Binding { part: plans.KeyPart.FunctionReturn, fields: ["Text" -> keys.textField; ~] },
    keys.Binding { part: plans.KeyPart.FunctionBlock, fields: ["Int" -> keys.textField, "Text" -> keys.textField; ~] },
    keys.Binding { part: plans.KeyPart.FunctionStream, fields: ["Int" -> keys.textField; ~] },
    keys.Binding { part: plans.KeyPart.FunctionAsync, fields: ["sync" -> keys.textField; ~] },
    keys.Binding { part: plans.KeyPart.FunctionGenerics, fields: ["T" -> keys.textField, "U" -> keys.textField, "V" -> keys.textField, "Display" -> keys.textField, "Item" -> keys.textField, "Int" -> keys.textField; ~] },
    keys.Binding { part: plans.KeyPart.FunctionEffects, fields: ["Console" -> keys.textField, "File" -> keys.textField; ~] },
    keys.Binding { part: plans.KeyPart.FunctionParameters, fields: ["count" -> keys.textField, "Int" -> keys.textField, "0" -> keys.textField; ~] },
    keys.Binding { part: plans.KeyPart.FunctionAssociatedTypes, fields: ["Item" -> keys.textField, "Text" -> keys.textField; ~] }; ~]
}

emit rule: move plans.KeyRule, name: Text -> Unit uses Console {
    bindings() => inputs
    rule -> keys.hashRule(inputs) -> when {
        Ok(value) { "$name=$value" -> println }
        Err(_) { "$name=unexpected-error" -> println }
    }
}

main {
    plans.structInterface() -> emit("StructInterface")
    plans.enumInterface() -> emit("EnumInterface")
    plans.traitInterface() -> emit("TraitInterface")
    plans.functionInterface() -> emit("FunctionInterface")
}
