import sys.runtime as runtime

render signed: Int64, unsigned: UInt64 -> Unit uses Console {
    "$signed" -> runtime.eprintln
    "$unsigned" -> runtime.eprintln
    "function=$signed,$unsigned" -> runtime.eprintln
}

main {
    -2_147_483_648 => minimum
    Int64(0) => zero
    "$minimum" -> runtime.eprintln
    "$zero" -> runtime.eprintln
    render(-9_223_372_036_854_775_807 - 1, 18_446_744_073_709_551_615)
    "$(true)" -> runtime.eprintln
    "$(false)" -> runtime.eprintln
    "stderr=done" -> println
}
