main {
    0 -> println
    -2_147_483_648 -> println
    2_147_483_647 -> println
    Int64(-9_223_372_036_854_775_807) - 1 => minimum
    Int64(9_223_372_036_854_775_807) => maximum
    UInt64(18_446_744_073_709_551_615) => unsigned
    minimum -> println
    maximum -> println
    unsigned -> println
    "mixed=$minimum,$maximum,$unsigned" -> println
}
