import std.archive.zip as zip_archive

run: -> Result<Unit, zip_archive.Error> {
    zip_archive.Limits {
        maxEncodedBytes: 128
        maxDecodedBytes: 16
        maxNameBytes: 16
        maxExtraBytes: 16
        maxCommentBytes: 16
    } -> codec? => codec
    codec -> writer(zip_archive.WriterLimits {
        maxEncodedBytes: 128
        maxEntryBytes: 16
        maxEntries: 2
        maxNameBytes: 16
        maxExtraBytes: 16
        maxCommentBytes: 16
        maxDirectoryBytes: 64
        maxWorkUnits: 128
    })? => writer!
    [UInt8; ~] => output!
    writer! -> finish([UInt8; ~], output!)? => first
    writer! -> finish([UInt8; ~], output!)? => second
    Result<Unit, zip_archive.Error>.Ok
}

main {
    run() -> when { Ok(_) {} Err(_) {} }
}
