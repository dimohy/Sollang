double value: Int -> Int => value * 2
square value: Int -> Int => value * value

main {
    7 -> parallel branch {
        doubled: ref -> double
        squared: ref -> square
    } => results
    results.doubled -> println
    results.squared -> println
    Option<Int>.Some(3) -> when {
        Some(value) { value -> println }
        None { 0 -> println }
    }
}
