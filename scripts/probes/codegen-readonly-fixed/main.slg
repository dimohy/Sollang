struct Rule { parts: [Int; ~] }
struct Holder { rules: [Rule; 2] }

make seed: Int -> Rule {
    [Int; ~] => parts!
    parts! -> push(seed)
    Rule { parts: parts! }
}
count rule: ref Rule -> Int { rule.parts -> len }
show seed: Int, rule: ref Rule -> Unit uses Console {
    rule.parts -> len => size
    "$(seed):$(size)" -> println
}
read values: ref [Rule; 2] -> Unit uses Console {
    0..<2 -> each index { index -> show(values[index]) }
}
main {
    [make(1), make(2)] => rules
    rules[0] -> count => first
    first -> println
    0..<2 -> each index { index -> show(rules[index]) }
    rules -> read
    Holder { rules: [make(3), make(4)] } => holder
    0..<2 -> each index { index -> show(holder.rules[index]) }
}
