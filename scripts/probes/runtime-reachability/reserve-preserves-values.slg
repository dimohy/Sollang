main {
    BinaryHeap<Int>(2) => heap!
    heap! -> push(4)
    heap! -> push(9)
    heap! -> reserve(9)
    heap! -> peek => top
    "heap=$top,$(heap! -> capacity)" -> println

    Deque<Int>(2) => deque!
    deque! -> pushBack(2)
    deque! -> pushFront(1)
    deque! -> reserve(9)
    deque! -> reserve(1)
    deque! -> front => first
    deque! -> back => last
    "deque=$first,$last,$(deque! -> capacity)" -> println

    Set<Int>(2) => set!
    set! -> insert(7) => inserted
    set! -> reserve(17)
    set! -> contains(7) => contains
    "set=$contains,$(set! -> capacity)" -> println

    {Int: Text; 2~} => labels!
    labels! -> put(1, "one")
    labels! -> put(17, "seventeen")
    labels! -> reserve(40)
    labels![17] => label
    "labels=$label,$(labels! -> capacity)" -> println

    { 1: 10, 17: 170 } => legacy!
    legacy! -> reserve(40)
    legacy![17] => legacyValue
    "legacy=$legacyValue,$(legacy! -> capacity)" -> println
}
