main {
    BinaryHeap<Int>(2) => heap!
    heap! -> push(4)
    heap! -> push(9)
    heap! -> reserve(9)
    "heap=$(heap! -> len),$(heap! -> capacity)" -> println

    Deque<Int>(2) => deque!
    deque! -> pushBack(2)
    deque! -> pushFront(1)
    deque! -> reserve(9)
    "deque=$(deque! -> len),$(deque! -> capacity)" -> println

    Set<Int>(2) => set!
    set! -> insert(7) => inserted
    set! -> reserve(17)
    "set=$(set! -> len),$(set! -> capacity),$inserted" -> println
}
