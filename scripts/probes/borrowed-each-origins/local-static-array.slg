import sys.file as file

collect: -> [file.SourceText; ~] {
    ["alpha", "beta"] => values
    [file.SourceText; ~] => sources!
    values -> each value {
        value -> file.borrowText => source
        sources! -> push(source)
    }
    sources!
}

main {
    collect() => sources
    "count=$(sources -> len)" -> println
}
