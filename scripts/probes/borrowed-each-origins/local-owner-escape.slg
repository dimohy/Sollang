import sys.file as file

escape: -> [file.SourceText; ~] {
    [UInt8(97); ~] => bytes
    bytes -> file.borrowBytes => owner
    owner -> slice(0, owner -> len) => text
    [Text; ~] => values!
    values! -> push(text)
    [file.SourceText; ~] => sources!
    values! -> each value {
        value -> file.borrowText => source
        sources! -> push(source)
    }
    sources!
}

main {
    escape() => sources
    "count=$(sources -> len)" -> println
}
