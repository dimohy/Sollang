import sys.file as file

collect values: [Text; ~] -> [file.SourceText; ~] {
    [file.SourceText; ~] => sources!
    values -> each value {
        value -> file.borrowText => source
        sources! -> push(source)
    }
    sources!
}

main {
    ["alpha", "beta"; ~] -> collect => sources
    "count=$(sources -> len)" -> println
}
