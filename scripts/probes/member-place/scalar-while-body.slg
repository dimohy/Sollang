struct Sample { name: Text, limit: Int }
borrow value: ref Sample -> ref Sample { value }
project value: ref Sample -> Unit uses Console {
    0 => index!
    index! < value.limit -> while {
        value -> borrow => view
        view.name -> println
        index! + 1 => index!
    }
}
main {
    Sample { name: "ok", limit: 1 } => owner
    owner -> project
}
