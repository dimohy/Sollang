struct Bucket { values: [Int; ~] }

public visit values: [Int; ~] -> Int block item: Int {
    values -> each value { value -> yield }
    values -> len
}

main {
    Bucket { values: [1, 2; ~] } => bucket
    bucket.values -> visit item { item -> println } => count
    count -> println
    bucket.values -> len -> println
    bucket.values[0] -> println
}
