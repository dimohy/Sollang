public visit values: [Int; ~] -> Int block item: Int {
    values -> each value { value -> yield }
    values -> len
}

main {
    [Int; ~] => values!
    0 => index!
    index! < 2 -> while {
        values! -> push(index! + 1)
        index! + 1 => index!
    }
    values! -> visit item { item -> println } => count
    count -> println
}
