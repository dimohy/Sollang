import sollang.compiler.llvm.text as facts
import sollang.compiler.llvm.source_root as llvmSourceRoot
import sys.path as path
import sys.process as process

main {
    process.arguments() => arguments
    arguments[1] == "emit" -> if {
        arguments[3] -> path.fromText(path.nativeStyle()) => root
        root -> llvmSourceRoot.emitCheckedRoot(4, 0) => status
        process.exit(status)
    }
    arguments[1] == "flags" -> if {
        facts.observeReadonlyFlags()
        process.exit(0)
    }
    facts.observeOwnership()
}
