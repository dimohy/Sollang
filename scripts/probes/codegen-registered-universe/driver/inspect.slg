import sollang.compiler.llvm.codegen_cache_keys as keys
import sollang.compiler.llvm.codegen_cache_key_policy as plans
import sollang.compiler.llvm.text as llvm
import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.semantic.type_registration as registration
import sollang.compiler.semantic.storage_registration as storageRegistration
import sollang.compiler.semantic.modules as modules
import sys.file as file
import sys.process as process

inspectCatalog: -> Unit uses Console, File, Process {
    process.arguments() => arguments
    arguments[1] -> file.mapText => owner
    [owner,; ~] -> analysis.analyzeTestSources([Int; ~], [Int; ~]) => package
    package -> typeIds.resolveAnalyzed => semantic!
    registration.registerNamedBoxes(package, semantic!.types) -> when {
        Err(_) { process.exit(1) -> return }
        Ok(boxes) { boxes }
    } => boxes
    [Int; ~] => registered!
    0 => identity!
    identity! < (semantic!.types -> len) -> while {
        semantic!.types[identity!] => type
        type.status == 0 and not type.containsParameter
            -> if {
                (type.kind == 1 and (type.origin == 0 or type.origin == 2 or type.origin == 16 or (type.origin == 1 and type.symbol == 25)))
                    or type.kind == 3 or type.kind == 4 or type.kind == 5 or type.kind == 6 or type.kind == 8 or type.kind == 9 or type.kind == 10
                    or (type.kind == 7 and type.origin == 4 and (type.symbol == 0 or type.symbol == 1))
                    -> if {
                        true => include!
                        type.kind == 3 or type.kind == 4 or type.kind == 5 or type.kind == 6
                            -> if {
                                semantic!.types -> storageRegistration.sourceStorageRequiresMetadata(identity!) -> when {
                                    Err(_) { process.exit(18) }
                                    Ok(required) { required => include! }
                                }
                            }
                        include! -> if { registered! -> push(identity!) }
                    }
            }
        identity! + 1 => identity!
    }
    (semantic!.types -> len) => scratch
    semantic!.types -> push(typeIds.SemanticType { kind: 8, origin: -1, module: -1, symbol: -1, first: typeIds.builtinTypeId(semantic!.types, 1), second: -1, length: -1, lengthHash: 0, containsParameter: false, status: 0 })
    [typeIds.SemanticType; ~] => layoutTypes!
    semantic!.types -> each type { layoutTypes! -> push(type) }
    [typeIds.NominalField; ~] => layoutFields!
    semantic!.fields -> each field { layoutFields! -> push(field) }
    llvm.TypeLayoutRequest { types: layoutTypes!, fields: layoutFields!, typeId: -1, pointerBitWidth: 64 } -> llvm.layoutsFor => layouts!
    [Int; ~] => referenceIndex!
    package.nodes -> each _ { referenceIndex! -> push(-1) }
    0 => reference!
    semantic!.references -> each current {
        current.typeAst >= 0 -> if { reference! => referenceIndex![package.ranges[current.sourceModule].astStart + current.typeAst] }
        reference! + 1 => reference!
    }
    typeIds.enumPayloadEdges(semantic!.types, semantic!.references, package.ranges, package.symbols, referenceIndex!) => edges
    typeIds.classifyWithPayloads(semantic!.types, semantic!.fields, edges) => traits!
    semantic!.types -> llvm.refineDeclaredTypeLayouts(semantic!.fields, semantic!.references, package.ranges, package.symbols, package.nodes, referenceIndex!, layouts!.sizes, layouts!.aligns, layouts!.statuses, traits!)
    package -> modules.identitiesAnalyzed => identities
    package -> modules.importsAnalyzed => imports
    keys.TypeFieldContext { identities: identities, imports: imports, sourceModule: 0, ownerSymbol: -1 } => context!
    "builtin:Text:$(typeIds.builtinTypeId(semantic!.types, 1))" -> println
    "builtin:Int:$(typeIds.builtinTypeId(semantic!.types, 2))" -> println
    "builtin:Bool:$(typeIds.builtinTypeId(semantic!.types, 23))" -> println
    "builtin:Int64:$(typeIds.builtinTypeId(semantic!.types, 6))" -> println
    "builtin:Float32:$(typeIds.builtinTypeId(semantic!.types, 20))" -> println
    [Int; ~] => empty
    context! -> llvm.captureRegisteredTypeUniverse(package, semantic!, layouts!, empty) -> when {
        Err(_) { process.exit(14) }
        Ok(records) {
            (records.fields -> len) == 0 -> if { process.exit(15) }
            records.typeIds -> each identity {
                identity != typeIds.builtinTypeId(semantic!.types, 25)
                    -> if { process.exit(16) }
            }
        }
    }
    context! -> keys.resolvedTypeNameField(package, semantic!, typeIds.builtinTypeId(semantic!.types, 25)) -> when {
        Err(_) { process.exit(17) }
        Ok(field) {
            field.bytes -> file.borrowBytes => buffer
            buffer -> slice(0, buffer -> len) => name
            "range-name:$name" -> println
        }
    }
    [typeIds.builtinTypeId(semantic!.types, 25), typeIds.builtinTypeId(semantic!.types, 25); ~] => duplicate
    context! -> llvm.captureRegisteredTypeUniverse(package, semantic!, layouts!, duplicate) -> when {
        Err(_) { }
        Ok(_) { process.exit(9) }
    }
    [typeIds.builtinTypeId(semantic!.types, 2),; ~] => scalar
    context! -> llvm.captureRegisteredTypeUniverse(package, semantic!, layouts!, scalar) -> when {
        Err(_) { }
        Ok(_) { process.exit(10) }
    }
    context! -> llvm.captureRegisteredTypeUniverse(package, semantic!, layouts!, registered!) -> when {
        Err(_) { process.exit(11) }
        Ok(records) {
            records.typeIds -> each identity { identity == scratch -> if { process.exit(12) } }
            records.fields -> each field {
                field.bytes -> file.borrowBytes => buffer
                buffer -> slice(0, buffer -> len) => text
                "record:$text" -> println
            }
        }
    }
    context!.sourceModule != 0 -> if { process.exit(13) }
}

main { inspectCatalog() }
