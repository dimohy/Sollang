import sys.file as file

struct Field { bytes: [UInt8; ~] }
struct Facts {
    owner: Field
    name: Field
    associated: [Field; ~]
}
struct Binding { fields: [Field; ~] }
make: -> Facts {
    [UInt8; ~] => owner!
    owner! -> push('o')
    [UInt8; ~] => name!
    name! -> push('n')
    Facts { owner: Field { bytes: owner! }, name: Field { bytes: name! }, associated: [Field; ~] }
}
project facts: move Facts -> [Binding; ~] {
    [Field; ~] => names!
    names! -> push(facts.name)
    [Binding; ~] => bindings!
    bindings! -> push(Binding { fields: names! })
    bindings! -> push(Binding { fields: facts.associated })
    bindings!
}
main {
    make() -> project => bindings
    bindings[0].fields[0].bytes -> file.borrowBytes => text
    text -> slice(0, text -> len) -> println
}
