import sys.file as file
import sys.process as process
struct Field { bytes: [UInt8; ~] }
enum Failure { Invalid }
make: -> Result<Field, Failure> {
    [UInt8; ~] => bytes!
    "Int" => text
    UIntSize(0) => index!
    index! < (text -> len) -> while {
        bytes! -> push(text -> byte(index!))
        index! + 1 => index!
    }
    Result<Field, Failure>.Ok(Field { bytes: bytes! })
}
main {
    process.arguments() => arguments
    (arguments -> len) > 1 => borrow
    [Field; ~] => values!
    make() -> when {
        Ok(field) {
            borrow -> if {
                (field.bytes -> len) != 3 -> if { process.exit(2) }
            } else { values! -> push(field) }
        }
        Err(_) { process.exit(3) }
    }
    values! -> each value {
        value.bytes -> file.borrowBytes => text
        text -> slice(0, text -> len) -> println
    }
}
