import sys.file as file
struct Field { bytes: [UInt8; ~] }
struct Fields {
    first: Field
    second: Field
    third: Field
}
enum Failure { Invalid }
empty: -> Result<Field, Failure> => Result<Field, Failure>.Ok(Field { bytes: [UInt8; ~] })
make: -> Result<Fields, Failure> {
    empty() -> when {
        Err(error) { Result<Fields, Failure>.Err(error) }
        Ok(field) {
            [UInt8; ~] => first!
            first! -> push('n')
            Result<Fields, Failure>.Ok(Fields { first: Field { bytes: first! }, second: Field { bytes: [UInt8; ~] }, third: field })
        }
    }
}
main {
    make() -> when {
        Ok(fields) {
            [fields.first, fields.second, fields.third] => values
            values[0].bytes -> file.borrowBytes => text
            text -> slice(0, text -> len) -> println
        }
        Err(_) { "error" -> println }
    }
}
