import sys.process as process

cut text: Text, start: UIntSize, length: UIntSize -> UIntSize {
    text -> slice(start, length) -> len
}

cutRegion text: Text, start: UIntSize, length: UIntSize, run: Bool -> UIntSize {
    run -> if { text -> slice(start, length) -> len } else { UIntSize(0) }
}

cutWhile text: Text, start: UIntSize, length: UIntSize -> Bool {
    false => found!
    (text -> slice(start, length) -> len) > 0 -> while {
        true => found!
        break
    }
    found!
}

main {
    process.arguments() => arguments
    arguments[1] => mode
    mode == "ordinary-start-outside" -> if { "abcd" -> cut(99, 0) -> println }
    mode == "ordinary-length-outside" -> if { "abcd" -> cut(0, 99) -> println }
    mode == "ordinary-utf8-interior" -> if { "가" -> cut(1, 1) -> println }
    mode == "ordinary-utf8-end-interior" -> if { "가" -> cut(0, 1) -> println }
    mode == "ordinary-valid-ascii" -> if { "abcd" -> cut(1, 2) -> println }
    mode == "ordinary-valid-utf8" -> if { "가" -> cut(0, 3) -> println }
    mode == "ordinary-valid-empty-end" -> if { "abcd" -> cut(4, 0) -> println }
    mode == "region-start-outside" -> if { "abcd" -> cutRegion(99, 0, true) -> println }
    mode == "region-length-outside" -> if { "abcd" -> cutRegion(0, 99, true) -> println }
    mode == "region-utf8-interior" -> if { "가" -> cutRegion(1, 1, true) -> println }
    mode == "region-utf8-end-interior" -> if { "가" -> cutRegion(0, 1, true) -> println }
    mode == "region-valid-ascii" -> if { "abcd" -> cutRegion(1, 2, true) -> println }
    mode == "region-valid-utf8" -> if { "가" -> cutRegion(0, 3, true) -> println }
    mode == "region-valid-empty-end" -> if { "abcd" -> cutRegion(4, 0, true) -> println }
    mode == "while-start-outside" -> if { "abcd" -> cutWhile(99, 0) -> println }
    mode == "while-length-outside" -> if { "abcd" -> cutWhile(0, 99) -> println }
    mode == "while-utf8-interior" -> if { "가" -> cutWhile(1, 1) -> println }
    mode == "while-utf8-end-interior" -> if { "가" -> cutWhile(0, 1) -> println }
    mode == "while-valid-ascii" -> if { "abcd" -> cutWhile(1, 2) -> println }
    mode == "while-valid-utf8" -> if { "가" -> cutWhile(0, 3) -> println }
    mode == "while-valid-empty-end" -> if { "abcd" -> cutWhile(4, 0) -> println }
}
