namespace probe.qualified_call

nested.cut value: Int -> Int => value

nested.answer: -> Int => 42

plain value: Int -> Int => value

runLocal value: Int -> Int {
    inner input: Int -> Int => input
    value -> inner
}

main {
    "$(42 -> nested.cut),$(42 -> plain),$(42 -> runLocal),$(nested.answer())" -> println
}
