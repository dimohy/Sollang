import sys.process as process

main {
    process.arguments() => arguments
    arguments[1] => mode
    "abcd" => text!
    UIntSize(0) => start!
    UIntSize(0) => length!
    mode == "entry-start-outside" -> if { 99 => start! }
    mode == "entry-length-outside" -> if { 99 => length! }
    mode == "entry-utf8-interior" -> if {
        "가" => text!
        1 => start!
        1 => length!
    }
    mode == "entry-utf8-end-interior" -> if {
        "가" => text!
        1 => length!
    }
    mode == "entry-valid-ascii" -> if {
        1 => start!
        2 => length!
    }
    mode == "entry-valid-utf8" -> if {
        "가" => text!
        3 => length!
    }
    mode == "entry-valid-empty-end" -> if { 4 => start! }
    text! -> slice(start!, length!) -> len -> println
}
