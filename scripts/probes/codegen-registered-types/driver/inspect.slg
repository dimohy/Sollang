import sollang.compiler.llvm.codegen_cache_keys as keys
import sollang.compiler.llvm.codegen_cache_key_policy as keysPlans
import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.type_ids as typeIds
import sys.file as file
import sys.process as process

main {
    process.arguments() => arguments
    arguments[1] -> file.mapText => owner
    [owner,; ~] -> analysis.analyzeTestSources([Int; ~], [Int; ~]) => package
    package -> typeIds.resolveAnalyzed => semantic
    -1 => pair!
    package.ranges -> each range {
        0 => index!
        index! < range.symbolCount -> while {
            package.symbols[range.symbolStart + index!] => symbol
            symbol.kind == 3 -> if {
                package.tokens[range.tokenStart + symbol.nameToken] => token
                package.sources[range.sourceModule] -> slice(token.span.start, token.span.length) == "Pair"
                    -> if {
                        0 => typeIndex!
                        typeIndex! < (semantic.types -> len) -> while {
                            semantic.types[typeIndex!] => type
                            type.kind == 1 and type.module == range.sourceModule and type.symbol == index!
                                -> if { typeIndex! => pair! }
                            typeIndex! + 1 => typeIndex!
                        }
                    }
            }
            index! + 1 => index!
        }
    }
    pair! < 0 -> if { process.exit(1) }
    keys.TypeUniverseRecords { categories: [keysPlans.KeyPart; ~], typeIds: [Int; ~], memberOrdinals: [Int; ~], fields: [keys.Field; ~] } => records!
    records! -> keys.appendReferenceTypeUniverse(semantic.types) -> when {
        Err(_) { process.exit(1) }
        Ok {}
    }
    (records!.fields -> len) != 1 -> if { process.exit(1) }
    records!.typeIds[0] => reference
    semantic.types[reference].kind != 8 or semantic.types[reference].first != pair!
        -> if { process.exit(1) }
    "reference:$reference:$(pair!)" -> println
    records!.fields[0].bytes -> file.borrowBytes => bytes
    bytes -> slice(0, bytes -> len) -> println
}
