# A function-local binding receives the Bool result of a nominal-key insertion.
struct Key {
    scope: Int
    id: Int
}

trait Hash { hash: self -> Int }
trait Eq { eq: self -> Int }

impl Hash for Key {
    hash: self -> Int => self.scope * 1009 + self.id
}

impl Eq for Key {
    eq: self -> Int => self.scope * 100000 + self.id
}

insertOnce values: mut {Key: Int} -> Bool {
    values -> putIfAbsent({ id: 3, scope: 2 }, 42) => inserted
    inserted -> if { "new" -> println } else { "existing" -> println }
    inserted
}

main {
    {Key: Int; 4~} => values!
    values! -> insertOnce => first
    values! -> insertOnce => second
    first -> if { "first=true" -> println } else { "first=false" -> println }
    second -> if { "second=true" -> println } else { "second=false" -> println }
    values! -> len -> println
}
