# A typed-header populated bounded dictionary keeps its inline entries and capacity.
main {
    {Int: Int; 4: 40, 7: 70; <=3} => values!
    values! -> len -> println
    values! -> capacity -> println
    values![4] -> println
    values![7] -> println
    values! -> put(9, 90)
    values! -> len -> println
    values![9] -> println
}
