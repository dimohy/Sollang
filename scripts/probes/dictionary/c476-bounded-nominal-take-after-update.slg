# A bounded nominal-key dictionary retains the updated value until take.
struct Key {
    scope: Int
    id: Int
}

trait Hash { hash: self -> Int }
trait Eq { eq: self -> Int }

impl Hash for Key {
    hash: self -> Int => self.scope * 1009 + self.id
}

impl Eq for Key {
    eq: self -> Int => self.scope * 100000 + self.id
}

main {
    {Key: Text; <=2} => values!
    values! -> putIfAbsent({ id: 7, scope: 2 }, "before") => inserted
    "after" => values![{ scope: 2, id: 7 }]
    values! -> take(Key { scope: 2, id: 7 }) => taken
    inserted -> if { "inserted=true" -> println } else { "inserted=false" -> println }
    taken -> println
    values! -> len -> println
}
