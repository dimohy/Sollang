# A dictionary index must check the declared nominal key before lookup.
struct Key {
    scope: Int
    id: Int
}

trait Hash { hash: self -> Int }
trait Eq { eq: self -> Int }

impl Hash for Key {
    hash: self -> Int => self.scope * 1009 + self.id
}

impl Eq for Key {
    eq: self -> Int => self.scope * 100000 + self.id
}

main {
    {Key: Text; { scope: 1, id: 10 }: "lexer"} => symbols!
    symbols![{ scope: 2 }] -> println
}
