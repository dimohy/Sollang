# One-byte integer keys use the same hash for literal insertion, put, and lookup.
main {
    {UInt8: Int; UInt8(1): 10, UInt8(2): 20} => values!
    values![UInt8(1)] => before
    values! -> put(UInt8(1), 99)
    values![UInt8(1)] => after
    values![UInt8(2)] => other
    values! -> len => count
    "UInt8 before=$before after=$after other=$other count=$count" -> println
}
