# An owned struct value keeps its field owner through dictionary replacement.
struct OwnedValues {
    values: [Int; ~]
}

main {
    {Int: OwnedValues; 1: { values: [10; ~] }} => batches!
    OwnedValues { values: [7, 8; ~] } => replacement
    replacement => batches![1]
    batches! -> take(1) => first
    first.values -> len -> println
}
