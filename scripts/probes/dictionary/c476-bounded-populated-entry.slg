# A populated bounded dictionary retains its entries and declared capacity.
main {
    {1: 10, 2: 20; <=3} => values!
    values! -> len -> println
    values! -> capacity -> println
    values![1] -> println
    values![2] -> println
    values! -> put(3, 30)
    values! -> len -> println
    values![3] -> println
}
