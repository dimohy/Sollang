# A dictionary put key inferred as Key still requires named struct fields.
struct Key {
    id: Int
}

trait Hash { hash: self -> Int }
trait Eq { eq: self -> Int }
impl Hash for Key { hash: self -> Int => self.id }
impl Eq for Key { eq: self -> Int => self.id }

main {
    {Key: Text; { id: 1 }: "one"} => values!
    values! -> put({ 1: 2 }, "two")
}
