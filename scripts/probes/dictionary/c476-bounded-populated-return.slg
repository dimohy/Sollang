# Returning a populated bounded dictionary preserves its inline entries.
makeValues: -> {Int: Int; <=3} {
    {1: 10, 2: 20; <=3}
}

main {
    makeValues() => values!
    values! -> len -> println
    values! -> capacity -> println
    values![1] -> println
    values![2] -> println
    values! -> put(3, 30)
    values! -> len -> println
    values![3] -> println
}
