# A declared nominal key is materialized for indexed replacement.
struct Key {
    scope: Int
    id: Int
}

trait Hash { hash: self -> Int }
trait Eq { eq: self -> Int }

impl Hash for Key {
    hash: self -> Int => self.scope * 1009 + self.id
}

impl Eq for Key {
    eq: self -> Int => self.scope * 100000 + self.id
}

consume values: move [Int; ~] -> Unit {}

main {
    [1, 2; ~] => scope
    scope -> consume
    {Key: Text; { scope: 1, id: 2 }: "old"} => symbols!
    "new" => symbols![{ id: 2, scope: 1 }]
    symbols![{ scope: 1, id: 2 }] -> println
    symbols! -> len -> println
}
