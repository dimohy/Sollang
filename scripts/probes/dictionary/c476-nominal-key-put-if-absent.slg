# A declared nominal key is materialized for putIfAbsent.
struct Key {
    scope: Int
    id: Int
}

trait Hash { hash: self -> Int }
trait Eq { eq: self -> Int }

impl Hash for Key {
    hash: self -> Int => self.scope * 1009 + self.id
}

impl Eq for Key {
    eq: self -> Int => self.scope * 100000 + self.id
}

main {
    {Key: Text; 4~} => symbols!
    symbols! -> putIfAbsent({ id: 7, scope: 2 }, "first") => inserted
    symbols! -> putIfAbsent({ scope: 2, id: 7 }, "second") => duplicate
    inserted -> if { "inserted=true" -> println } else { "inserted=false" -> println }
    duplicate -> if { "duplicate=true" -> println } else { "duplicate=false" -> println }
    symbols![{ scope: 2, id: 7 }] -> println
    symbols! -> len -> println
}
