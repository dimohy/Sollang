# A dictionary put gives a contextual nominal key its declared field layout.
struct SymbolKey {
    scope: Int
    id: Int
}

trait Hash { hash: self -> Int }
trait Eq { eq: self -> Int }

impl Hash for SymbolKey {
    hash: self -> Int => self.scope * 1009 + self.id
}

impl Eq for SymbolKey {
    eq: self -> Int => self.scope * 100000 + self.id
}

main {
    {SymbolKey: Text; { scope: 1, id: 10 }: "lexer"} => symbols!
    symbols! -> put({ id: 20, scope: 1 }, "parser")
    symbols![{ scope: 1, id: 20 }] -> println
    symbols! -> len -> println
}
