# A bounded dictionary preserves nominal-key lookup and replacement.
struct Key {
    scope: Int
    id: Int
}

trait Hash { hash: self -> Int }
trait Eq { eq: self -> Int }

impl Hash for Key {
    hash: self -> Int => self.scope * 1009 + self.id
}

impl Eq for Key {
    eq: self -> Int => self.scope * 100000 + self.id
}

main {
    {Key: Text; <=2} => symbols!
    symbols! -> putIfAbsent({ id: 7, scope: 2 }, "before") => inserted
    inserted -> if { "inserted=true" -> println } else { "inserted=false" -> println }
    symbols![{ scope: 2, id: 7 }] -> println
    "after" => symbols![{ id: 7, scope: 2 }]
    symbols![{ scope: 2, id: 7 }] -> println
    symbols! -> len -> println
}
