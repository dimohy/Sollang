struct Reader {
    bytes: [UInt8; ~]
    offset: Int
}

struct Success {
    reader: Reader
    buffer: [UInt8; ~]
    count: Int
}

roundTrip reader: move Reader, buffer: move [UInt8; ~] -> async Success {
    yield
    Success { reader: reader, buffer: buffer, count: 0 }
}

main {
    Reader { bytes: [1; ~], offset: 0 } -> roundTrip([0; ~]) -> await => result
    "nested=$(result.reader.bytes -> len),buffer=$(result.buffer -> len),count=$(result.count)" -> println
}
