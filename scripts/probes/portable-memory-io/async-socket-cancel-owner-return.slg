import std.io.async as asyncio
import std.io.socket as ioSocket
import std.net as net
import std.net.socket as socket

struct Setup {
    listener: socket.TcpListener
    sender: socket.TcpStream
    receiver: socket.TcpStream
}

setup: -> Result<Setup, socket.SocketError> uses Network {
    socket.ListenOptions { endpoint: net.loopback(0) -> unified, backlog: 1, reuseAddress: true } -> listen? => listener
    listener -> localPort? => port
    net.loopback(port) -> unified -> connect? => sender
    listener -> accept? => receiver
    Result<Setup, socket.SocketError>.Ok(Setup { listener: listener, sender: sender, receiver: receiver })
}

main {
    setup() -> when {
        Err(error) { "setup-error=$(error.code)" -> println }
        Ok(value) {
            value.listener => listener
            value.sender => sender
            value.receiver => receiver
            receiver -> ioSocket.asyncStream -> when {
                Err(failure) {
                    failure.error.code => errorCode
                    failure.connection -> close
                    sender -> close
                    listener -> close
                    "create-error=$errorCode" -> println
                }
                Ok(channel) {
                    channel -> readIntoAsync([0, 0, 0; ~], asyncio.Cancellation { requested: true }) => readTask
                    readTask -> await -> when {
                        Ok(success) {
                            UIntSize(success.buffer -> len) => length
                            success.channel => channel
                            channel -> close
                            sender -> close
                            listener -> close
                            "cancelled=false,len=$length" -> println
                        }
                        Err(failure) {
                            failure.error.kind -> when {
                                socket.SocketErrorKind.Interrupted { true }
                                else { false }
                            } => cancelled
                            UIntSize(failure.buffer -> len) => length
                            failure.channel => channel
                            channel -> close
                            sender -> close
                            listener -> close
                            "cancelled=$cancelled,len=$length" -> println
                        }
                    }
                }
            }
        }
    }
}
