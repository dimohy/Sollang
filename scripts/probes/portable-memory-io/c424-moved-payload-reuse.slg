struct Pair {
    first: [UInt8; ~]
    second: [UInt8; ~]
}

struct Holder {
    buffer: [UInt8; ~]
}

struct Invalid {
    left: Holder
    whole: Pair
}

reuse pair: move Pair -> Invalid {
    Invalid {
        left: Holder { buffer: pair.first }
        whole: pair
    }
}

main {
    [UInt8; ~] => first
    [UInt8; ~] => second
    Pair { first: first, second: second } -> reuse => invalid
}
