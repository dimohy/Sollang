struct CipherKey {
    expanded: [UInt8; ~]
    marker: Int
}

struct GcmKey {
    cipher: CipherKey
    marker: Int
}

prepareCipher: -> CipherKey {
    [UInt8; ~] => expanded!
    expanded! -> push(7)
    CipherKey { expanded: expanded!, marker: 128 }
}

prepareGcm: -> GcmKey {
    GcmKey { cipher: prepareCipher(), marker: 256 }
}

main {
    prepareGcm() => key
    "nested=$(key.cipher.expanded -> len),$(key.cipher.marker),$(key.marker)" -> println
}
