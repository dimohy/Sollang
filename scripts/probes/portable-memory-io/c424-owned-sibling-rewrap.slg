struct Pair {
    first: [UInt8; ~]
    second: [UInt8; ~]
}

struct Holder {
    buffer: [UInt8; ~]
}

struct Rewrapped {
    holder: Holder
    sibling: [UInt8; ~]
}

rewrap pair: move Pair -> Rewrapped {
    Rewrapped {
        holder: Holder { buffer: pair.first }
        sibling: pair.second
    }
}

main {
    [UInt8; ~] => first!
    first! -> push(1)
    [UInt8; ~] => second!
    second! -> push(2)
    second! -> push(3)
    Pair { first: first!, second: second! } -> rewrap => result
    "rewrap=$(result.holder.buffer -> len),$(result.sibling -> len)" -> println
}
