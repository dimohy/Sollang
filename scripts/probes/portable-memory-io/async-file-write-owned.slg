import sys.file as file

describe result: Result<file.WriteAtSuccess, file.WriteAtFailure> -> Int => result -> when {
    Result<file.WriteAtSuccess, file.WriteAtFailure>.Ok(success) => Int(success.count) * 10 + (success.buffer -> len)
    Result<file.WriteAtSuccess, file.WriteAtFailure>.Err(failure) => failure.error -> when {
        Io(message) => -1
        InvalidRange => -2
        Cancelled => -3
    }
}

main {
    file.openWrite("artifacts/scratch/portable-memory-io/file-write-owned.bin") -> when {
        Result<file.FileWriter, Text>.Ok(writer) {
            [UInt8; ~] => buffer!
            buffer! -> push(70)
            buffer! -> push(71)
            buffer! -> push(72)
            writer -> writeRangeAtAsync(buffer!, 1, 2, 4, false) -> await -> describe => code
            "file-write=$code" -> println
        }
        Result<file.FileWriter, Text>.Err(error) { error -> println }
    }
}
