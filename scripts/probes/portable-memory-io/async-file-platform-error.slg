import sys.file as file

main {
    file.File { token: 0 } => invalid
    [UInt8; ~] => buffer!
    buffer! -> push(0)
    invalid -> readIntoAtAsync(buffer!, 37, false) -> await -> when {
        Result<file.ReadAtSuccess, file.ReadAtFailure>.Ok(success) { "unexpected" -> println }
        Result<file.ReadAtSuccess, file.ReadAtFailure>.Err(failure) {
            failure.error -> when {
                Io(message) { "file-io=$message,$(failure.buffer -> len)" -> println }
                else { "wrong-error" -> println }
            }
        }
    }
}
