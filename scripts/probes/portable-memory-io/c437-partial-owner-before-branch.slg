struct Wrapper {
    owner: [Int; ~]
    marker: Int
}

observe value: move Wrapper, chooseFirst: Bool -> async Int {
    value.owner => owner
    yield
    value.marker => marker
    chooseFirst -> if {
        marker + 1
    } else {
        marker + 2
    } => selected
    (owner -> len) + selected
}

main {
    Wrapper { owner: [5, 6,; ~], marker: 2 } -> observe(true) => task
    task -> await => result
    "reduced=$result" -> println
}
