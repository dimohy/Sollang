struct CallPlan {
    templates: [Int; ~]
    actuals: [Int; ~]
}

main {
    [CallPlan { templates: [7; ~], actuals: [9; ~] }; ~] => source!
    source! -> take(0) => plan
    [CallPlan; ~] => destination!
    destination! -> push(plan)
    destination! -> each item { "$(item.templates[0]),$(item.actuals[0])" -> println }
}
