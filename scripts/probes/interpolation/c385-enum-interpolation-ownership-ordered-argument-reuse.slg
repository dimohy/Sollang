payloadLength wrapped: Option<[Int; ~]> -> Int {
    wrapped -> when { Some(items) { items -> len } None { 0 } }
}
sum wrapped: Option<[Int; ~]>, count: Int -> Int => payloadLength(wrapped) + count
main {
    [1; ~] => values
    "length=$(sum(Option<[Int; ~]>.Some(values), values -> len))" -> println
}
