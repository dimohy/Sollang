struct Product { nodes: [Int; ~], retained: [Int; ~] }
struct Carrier { nodes: [Int; ~] }
consume request: move Carrier -> Int => request.nodes -> len

finish product: move Product, enabled: Bool -> Int {
    enabled -> if {
        Carrier { nodes: product.nodes } -> consume => count
        count + product.retained[0] + product.retained[1] -> return
    }
    product.retained[0] + product.retained[1]
}

main {
    Product { nodes: [1; ~], retained: [2, 3; ~] } -> finish(true) -> println
    Product { nodes: [1; ~], retained: [2, 3; ~] } -> finish(false) -> println
}
