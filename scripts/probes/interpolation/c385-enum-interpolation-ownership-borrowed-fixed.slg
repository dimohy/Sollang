payloadLength wrapped: Option<[UInt8; 8]> -> Int {
    wrapped -> when { Some(items) { items -> len } None { 0 } }
}
bytes: -> [UInt8; 8] => [7; 8]
inspect values: ref [UInt8; 8] -> Unit uses Console {
    "length=$(Option<[UInt8; 8]>.Some(values) -> payloadLength),source=$(values[0])" -> println
}
main {
    bytes() => values
    values -> inspect
}
