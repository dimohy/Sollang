impl Int {
    checked: self -> Result<Int, Int> {
        self >= 0 -> if {
            Result<Int, Int>.Ok(self)
        } else {
            Result<Int, Int>.Err(9)
        }
    }
}

show value: Int -> Result<Int, Int> uses Console {
    "value=$(((value + 1) -> checked)?)" -> println
    Result<Int, Int>.Ok(7)
}

main {
    show(2) -> when {
        Ok(value) { "ok=$value" -> println }
        Err(error) { "unexpected=$error" -> println }
    }
    show(-2) -> when {
        Ok(value) { "unexpected=$value" -> println }
        Err(error) { "error=$error" -> println }
    }
}
