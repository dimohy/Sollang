payloadLength wrapped: Option<[UInt8; 8]> -> Int {
    wrapped -> when { Some(items) { items -> len } None { 0 } }
}
sum wrapped: Option<[UInt8; 8]>, count: Int -> Int => payloadLength(wrapped) + count
bytes: -> [UInt8; 8] => [7; 8]
inspect values: ref [UInt8; 8] -> Unit uses Console {
    "sum=$(sum(Option<[UInt8; 8]>.Some(values), values -> len)),source=$(values[0])" -> println
}
main {
    bytes() => values
    values -> inspect
}
