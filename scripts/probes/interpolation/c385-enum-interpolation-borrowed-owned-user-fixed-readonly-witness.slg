struct Item { values: [Int; ~] }
count wrapped: Option<[Item; 1]> -> Int {
    wrapped -> when { Some(items) { items -> len } None { 0 } }
}
inspect items: [Item; 1] -> Unit uses Console {
    "length=$(Option<[Item; 1]>.Some(items) -> count)" -> println
}
main {
    false -> if {
        [Item { values: [7; ~] }] => items
        items -> inspect
    }
}
