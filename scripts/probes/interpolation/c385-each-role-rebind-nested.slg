# Each role is read by a nested condition before a mutable assignment.
measure values: ref [Int; ~] -> Int uses Console {
    -1 => previous!
    values -> each value {
        previous! < 0 or value > previous!
            -> if {
                value -> print
            }
        value => previous!
    }
    previous!
}

main {
    [1, 2, 3; ~] => values
    values -> measure -> println
}
