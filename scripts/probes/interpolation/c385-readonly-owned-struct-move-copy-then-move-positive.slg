struct Payload { values: [Int; ~] }

consume payload: move Payload -> Int { payload.values -> len }

copyOwned payload: Payload -> Payload {
    [Int; ~] => values!
    payload.values -> each value { values! -> push(value) }
    Payload { values: values! }
}

forward payload: Payload -> Int { payload -> copyOwned -> consume }

main { Payload { values: [1, 2; ~] } -> forward -> println }
