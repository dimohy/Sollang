import sollang.compiler.ir.typed as typedIr
import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.expression_type_ids as expressionTypeIds

main {
    [
    """
    main {
        Double(0.1) * 1000000000.0 => scaled
        Int(scaled) => converted
    }
    """; ~
    ] -> semanticContext.prepare => prepared
    prepared -> semanticContext.freeze => snapshot
    snapshot -> expressionTypeIds.resolveContext => types
    [2, 3] -> each phase {
        snapshot -> typedIr.profileResolvedContext(types, phase) => ir
        ir -> each node {
            node.sourceModule == 0 and (node.kind == 8 or node.kind == 17)
                -> if {
                    "$phase $(node.kind) $(node.astNode) $(node.typeId) $(node.typeSymbol) $(node.operand0) $(node.operand1) $(node.opcode)" -> println
                }
        }
    }
}
