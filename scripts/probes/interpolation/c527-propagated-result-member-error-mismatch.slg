struct Point {
    public x: Float32
}

readPoint: -> Result<Point, Text> => Result<Point, Text>.Ok(Point { x: Float32(1.5) })

run: -> Result<Unit, Int> uses Console {
    "value=$((readPoint()?).x)" -> println
    Result<Unit, Int>.Ok
}

main {
    run() -> when {
        Ok(done) { }
        Err(error) { "unexpected-error=$error" -> println }
    }
}
