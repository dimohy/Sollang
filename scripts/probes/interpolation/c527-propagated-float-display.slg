# Reject a propagated Float payload as an interpolation display value.
readValue: -> Result<Float, Int> => Result<Float, Int>.Ok(Float(7))
run: -> Result<Unit, Int> uses Console {
    "value=$(readValue()?)" -> println
    Result<Unit, Int>.Ok
}
main {
    run() -> when {
        Ok(done) { }
        Err(error) { "unexpected-error=$error" -> println }
    }
}
