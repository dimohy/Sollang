struct Value {
    public x: Int
}

struct Holder {
    public values: [Value; 2]
}

struct Maker {
    holder: Holder
}

impl Maker {
    make: self -> Holder => self.holder
}

main {
    Maker { holder: Holder { values: [Value { x: 5 }, Value { x: 7 }] } } => maker
    "value=$((maker -> make).values[0].x)" -> println
}
