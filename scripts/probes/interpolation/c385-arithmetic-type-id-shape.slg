import sollang.compiler.semantic.expression_type_ids as expressionTypeIds

main {
    [
        """
        main {
            Double(0.1) * 1000000000.0 => scaled
            Int(scaled) => converted
        }
        """; ~
    ] -> expressionTypeIds.resolve => resolved
    resolved.expressions -> each expression {
        expression.sourceModule == 0 and expression.typeId >= 0 -> if {
            resolved.types[expression.typeId] => resultType
            "$(expression.astNode) $(expression.typeId) $(resultType.kind) $(resultType.origin) $(resultType.symbol)" -> println
        }
    }
}
