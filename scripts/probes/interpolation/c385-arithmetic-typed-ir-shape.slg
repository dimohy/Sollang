import sollang.compiler.ir.typed as typedIr

main {
    [
        """
        main {
            Double(0.1) * 1000000000.0 => scaled
            Int(scaled) => converted
        }
        """; ~
    ] -> typedIr.lower => ir
    ir -> each node {
        node.sourceModule == 0 -> if {
            "$(node.kind) $(node.astNode) $(node.typeId) $(node.typeSymbol) $(node.opcode) $(node.operand0) $(node.operand1)" -> println
        }
    }
}
