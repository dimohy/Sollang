scaled value: Float64 -> Int => Int(value * 1000000000)

main {
    "f32=$(Int(Float32(7))),f64=$(Int(Float64(8))),f=$(Int(Float(9))),d=$(Int(Double(10)))" -> println
    "value=$(Int(Float32(1_0.5)))" -> println
    "negative=$(Int64(Float64(-4294967296)))" -> println
    "float32=$(Int64(Float32(4294967296)))" -> println
    "float64=$(Int64(Float64('e')))" -> println
    "float32=$(Int64(Float32('e')))" -> println
    "sub=$(Int(Float32(7.5) - 2.5)),mul=$(Int(Float32(1.5) * 2.0)),div=$(Int(Float32(7.5) / 2.5)),double=$(Int(Float64(7.5) + 2.5))" -> println
    "greater=$(Float32(2.5) > 1.5),equal=$(Float64(1.25) == 1.25)" -> println
    "above=$(Int((1.000000059604644775390625000000000000000001 - 1.0) * 8388608))" -> println
    "tie=$(Int((1.000000059604644775390625 - 1.0) * 8388608))" -> println
    "below=$(Int((1.000000059604644775390624999999999999999999 - 1.0) * 8388608))" -> println
    "negativeZero=$((1.0 / -0.0) < 0.0)" -> println
    "subnormal=$(1e-45 > 0.0)" -> println
    "underflow=$(1e-100 == 0.0)" -> println
    "contextual=$(scaled(-0.1))" -> println
}
