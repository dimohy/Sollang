struct Pair { first: [Int; ~], second: [Int; ~] }
struct Product { pair: Pair, retained: [Int; ~] }
struct Carrier { nodes: [Int; ~] }
consume request: move Carrier -> Int => request.nodes -> len

main {
    Product {
        pair: Pair { first: [1; ~], second: [2, 3; ~] }
        retained: [4; ~]
    } => product
    Carrier { nodes: product.pair.first } -> consume => first
    Carrier { nodes: product.pair.second } -> consume => second
    first + second + (product.retained -> len) -> println
}
