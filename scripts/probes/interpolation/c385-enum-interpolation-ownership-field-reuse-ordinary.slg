struct Pair { first: [Int; ~], second: [Int; ~] }
payloadLength wrapped: Option<[Int; ~]> -> Int {
    wrapped -> when { Some(items) { items -> len } None { 0 } }
}
length values: ref [Int; ~] -> Int => values -> len
main {
    Pair { first: [1; ~], second: [2, 3; ~] } => owner
    Option<[Int; ~]>.Some(owner.first) => wrapped
    "payload=$(wrapped -> payloadLength),sibling=$(owner.second -> length)" -> println
    owner.first -> length -> println
}
