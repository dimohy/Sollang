struct Point {
    public x: Float32
}

makePoint: -> Point => Point { x: Float32(1.5) }

run: -> Result<Unit, Int> uses Console {
    "value=$((makePoint()?).x)" -> println
    Result<Unit, Int>.Ok
}

main {
    run() -> when {
        Ok(done) { }
        Err(error) { "unexpected-error=$error" -> println }
    }
}
