struct Product { nodes: [Int; ~], retained: [Int; ~] }
struct Carrier { nodes: [Int; ~], retained: [Int; ~] }

adapt result: move Result<Product, Product> -> Carrier => result -> when {
    Ok(success) { Carrier { nodes: success.nodes, retained: success.retained } }
    Err(failure) { Carrier { nodes: failure.nodes, retained: failure.retained } }
}
consume carrier: move Carrier -> Int => carrier.nodes[0] + carrier.retained[0]

main {
    Result<Product, Product>.Ok(Product { nodes: [1; ~], retained: [2; ~] }) -> adapt -> consume -> println
    Result<Product, Product>.Err(Product { nodes: [3; ~], retained: [4; ~] }) -> adapt -> consume -> println
}
