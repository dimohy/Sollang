struct Owner { values: [Int; ~] }
struct Inner { left: Owner }
struct Outer { inner: Inner }
consumeBoth first: move Owner, second: move Owner -> Int => (first.values -> len) + (second.values -> len)
main {
    Owner { values: [1; ~] } => first
    Outer { inner: Inner { left: Owner { values: [2; ~] } } } => outer
    first -> consumeBoth(outer.inner.left) -> println
}
