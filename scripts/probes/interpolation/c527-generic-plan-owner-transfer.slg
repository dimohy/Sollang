struct CallPlan {
    templates: [Int; ~]
    actuals: [Int; ~]
}

makePlans: -> [CallPlan; ~] {
    [CallPlan { templates: [7; ~], actuals: [9; ~] }; ~]
}

main {
    [CallPlan; ~] => plans!
    makePlans() => additional
    additional -> each plan { plans! -> push(plan) }
    plans! -> each plan { "$(plan.templates[0]),$(plan.actuals[0])" -> println }
}
