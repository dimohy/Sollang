struct Product { nodes: [Int; ~], retained: [Int; ~] }
struct Carrier { nodes: [Int; ~] }
consume request: move Carrier -> Int => request.nodes -> len

main {
    Product { nodes: [1; ~], retained: [2; ~] } => product
    Carrier { nodes: product.nodes } => first
    first -> consume => count
    Carrier { nodes: product.nodes } => second
    second -> consume -> println
}
