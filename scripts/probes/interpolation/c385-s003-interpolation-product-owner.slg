struct Product {
    nodes: [Int; ~]
    typeNodes: [Int; ~]
}

makeProduct: -> Product {
    [1; ~] => nodes
    [2; ~] => typeNodes
    Product { nodes: nodes, typeNodes: typeNodes }
}

projectNodes: -> [Int; ~] {
    makeProduct() => product
    product.typeNodes -> len => typeCount
    product.nodes => nodes
    nodes
}

main {
    projectNodes() -> len -> println
}
