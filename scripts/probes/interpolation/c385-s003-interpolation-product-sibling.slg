struct Product {
    nodes: [Int; ~]
    typeNodes: [Int; ~]
}

makeProduct: -> Product {
    [1; ~] => nodes
    [2; ~] => typeNodes
    Product { nodes: nodes, typeNodes: typeNodes }
}

struct Carrier { nodes: [Int; ~] }
consume request: move Carrier -> Int => request.nodes -> len

projectSibling: -> Int {
    makeProduct() => product
    Carrier { nodes: product.nodes } -> consume => nodeCount
    product.typeNodes -> len
}

main {
    projectSibling() -> println
}
