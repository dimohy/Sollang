struct Product { nodes: [Int; ~], retained: [Int; ~] }
struct Carrier { nodes: [Int; ~] }
consume request: move Carrier -> Int => request.nodes -> len

finish enabled: Bool -> Int {
    Product { nodes: [1; ~], retained: [2, 3; ~] } => product!
    enabled -> if {
        Carrier { nodes: product!.nodes } -> consume
    } else {
        Carrier { nodes: product!.nodes } -> consume
    } => count
    [9; ~] => product!.nodes
    product!.nodes[0] + product!.retained[0] + product!.retained[1]
}

main {
    true -> finish -> println
    false -> finish -> println
}
