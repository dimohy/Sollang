payloadLength wrapped: Option<[UInt8; 8]> -> Int {
    wrapped -> when { Some(items) { items -> len } None { 0 } }
}
bytes: -> [UInt8; 8] => [7; 8]
make: -> Option<[UInt8; 8]> => Option<[UInt8; 8]>.Some(bytes())
main {
    make() -> when {
        Some(items) { "length=$(Option<[UInt8; 8]>.Some(items) -> payloadLength)" -> println }
        None { "length=0" -> println }
    }
}
