impl Int {
    doubled: self -> Int => self * 2
}

impl Bool {
    score: self -> Int => self -> if { 1 } else { 0 }
}

impl Float {
    whole: self -> Int => Int(self)
}

impl Int8 {
    widened: self -> Int => Int(self)
}

main {
    "int=$((1 + 2) -> doubled)" -> println
    "nested=$(((1 + 2) * 3) -> doubled)" -> println
    "compare=$((1 < 2) -> score)" -> println
    "logical=$((true and false) -> score)" -> println
    "float=$((1.0 + 2.0) -> whole)" -> println
    "width=$((Int8(2) + 3) -> widened)" -> println
}
