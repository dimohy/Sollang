struct Product { first: [Int; ~], second: [Int; ~] }
struct Carrier { nodes: [Int; ~] }
consume request: move Carrier -> Int => request.nodes -> len

finish product: move Product -> Int {
    Carrier { nodes: product.first } -> consume => first
    Carrier { nodes: product.second } -> consume => second
    first + second
}

main {
    Product { first: [1; ~], second: [2, 3; ~] } -> finish -> println
}
