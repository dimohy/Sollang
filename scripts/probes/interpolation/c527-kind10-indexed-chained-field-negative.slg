struct Value {
    public x: Float32
}

struct Holder {
    public values: [Value; 2]
}

struct Maker {
    holder: Holder
}

impl Maker {
    make: self -> Holder => self.holder
}

main {
    Maker { holder: Holder { values: [Value { x: Float32(1.5) }, Value { x: Float32(2.5) }] } } => maker
    "value=$((maker -> make).values[0].x)" -> println
}
