# Both paths in the first arm return from the function, so only Close joins.
enum Mode {
    Persistent
    Close
}

check mode: Mode -> Bool {
    mode -> when {
        Persistent {
            true -> if { true -> return } else { false -> return }
        }
        Close { false }
    } => flag
    flag and true
}

main {
    Mode.Close -> check -> if { "valid" } else { "invalid" } -> println
}
