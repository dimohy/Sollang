# Function inputs and results must preserve nested product and container layout.
makePair: -> (left: Int, right: [Int; 2]) {
    [20, 22] => right
    (left: 1, right: right)
}

makeFixed: -> [(left: Int, right: Int); 2] => [(left: 1, right: 2), (left: 3, right: 4)]

makeBounded: -> [(left: Int, right: Int); <=3] => [(left: 5, right: 6), (left: 7, right: 8); <=3]

makeGrowable: -> [(left: Int, right: Int); ~] => [(left: 9, right: 10), (left: 11, right: 12); ~]

readView values: [(left: Int, right: Int)] -> Int => values[0].left + values[1].right

readReference value: ref (left: Int, right: [Int; 2]) -> Int => value.left + value.right[1]

main {
    makePair() => pair
    pair -> readReference -> println

    makeFixed() => fixed
    fixed -> readView -> println

    makeBounded() => bounded
    bounded -> readView -> println

    makeGrowable() => growable
    growable -> readView -> println
}
