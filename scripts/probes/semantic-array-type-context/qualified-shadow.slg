import array.fixture as model

struct Cell { value: Bool }

foreignFirst values: [model.Cell; ~] -> Int => values[0].value
localFirst values: [Cell; ~] -> Bool => values[0].value

main {
    [model.Cell; ~] => foreign!
    foreign! -> push(model.Cell { value: 7 })
    foreign! -> foreignFirst -> println
    [Cell; ~] => local!
    local! -> push(Cell { value: true })
    local! -> localFirst -> println
}
