main {
    Deque<Int>(1) => one
    Deque<Int>(2) => two!
    Deque<Int>(3) => three
    "capacities=$(one -> capacity),$(two! -> capacity),$(three -> capacity)" -> println

    two! -> pushBack(1)
    two! -> pushBack(2)
    two! -> pushFront(0)
    "grown=$(two! -> capacity) len=$(two! -> len) front=$(two! -> front)" -> println
}
