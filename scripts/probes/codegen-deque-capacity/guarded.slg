showGuarded values: ref Deque<Text> -> Unit uses Console {
    values -> len => length
    length > 0 -> if {
        "guarded=$(values -> front),$(values -> back)" -> println
    }
}

main {
    Deque<Text>(1) => empty
    showGuarded(empty)
    Deque<Text>(1) => words!
    words! -> pushBack("live")
    showGuarded(words!)
    "done" -> println
}
