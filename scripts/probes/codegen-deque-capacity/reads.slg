show values: ref Deque<UInt16> -> Unit uses Console {
    "ref=$(values -> front),$(values -> back)" -> println
}

showText values: ref Deque<Text> -> Unit uses Console {
    "text-ref=$(values -> front),$(values -> back)" -> println
    values -> len => length
    length > 0 -> if {
        "text-block=$(values -> front),$(values -> back)" -> println
    }
}

showHeap values: ref BinaryHeap<Int> -> Unit uses Console {
    "heap-ref=$(values -> peek)" -> println
}

main {
    Deque<UInt16>(2) => numbers!
    numbers! -> pushBack(7)
    numbers! -> pushBack(9)
    "ends=$(numbers! -> front),$(numbers! -> back)" -> println
    show(numbers!)

    Deque<Double>(2) => decimals!
    decimals! -> pushBack(1.5)
    decimals! -> pushBack(2.5)
    "float=$((decimals! -> front) == 1.5),$((decimals! -> back) == 2.5)" -> println

    Deque<Text>(2) => words!
    words! -> pushBack("alpha")
    words! -> pushBack("beta")
    "text=$(words! -> front),$(words! -> back)" -> println
    showText(words!)

    BinaryHeap<Int>(2) => heap!
    heap! -> push(5)
    heap! -> push(2)
    "peek=$(heap! -> peek)" -> println
    showHeap(heap!)
}
