namespace cache.type_fields
import external.module as ext

public struct Fields {
    reference: ref Int
    boxed: box User
    dynamicTrait: dyn Reader
    growable: [Text; ~]
    fixed: [Int; 0004]
    bounded: [UInt8; <=04]
    dictionary: {Text: [ref User; ~]; <=08}
    product: (key: Text, count: Int,)
    optional: Option<ref User>
    result: Result<ext.Item, [Int]>
    self: Self
    range: Range
    bits: BitSet<0064>
}
struct User { value: Int }
struct Range { value: Int }
trait Reader { read: self -> Int }
