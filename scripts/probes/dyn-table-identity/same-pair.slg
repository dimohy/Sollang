struct Cell { value: Int }
trait Value { get: self -> Int }
impl Value for Cell { get: self -> Int => self.value }

unused: -> dyn Value { Cell { value: 99 } -> dyn<Value> }
make value: Int -> dyn Value { Cell { value: value } -> dyn<Value> }

main {
    make(1) => first
    Cell { value: 2 } -> dyn<Value> => second
    first -> Value.get -> println
    second -> Value.get -> println
}
