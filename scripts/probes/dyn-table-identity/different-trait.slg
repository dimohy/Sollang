struct Cell { value: Int }
trait Value { get: self -> Int }
trait Twice { get: self -> Int }
impl Value for Cell { get: self -> Int => self.value }
impl Twice for Cell { get: self -> Int => self.value * 2 }
main {
    Cell { value: 3 } -> dyn<Value> => first
    Cell { value: 3 } -> dyn<Twice> => second
    first -> Value.get -> println
    second -> Twice.get -> println
}
