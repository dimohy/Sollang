literal seed: Int -> Int {
    true -> if { seed } else { seed + 1 }
}

inverted value: Bool -> Int {
    not value -> if { 61 } else { 62 }
}

alternative left: Bool, right: Bool -> Int {
    left or right -> unless { 71 -> return }
    72
}

main {
    5 -> literal -> println
    true -> inverted -> println
    false -> inverted -> println
    true -> alternative(false) -> println
    false -> alternative(true) -> println
    false -> alternative(false) -> println
    false -> unless { "unless" -> println }
}
