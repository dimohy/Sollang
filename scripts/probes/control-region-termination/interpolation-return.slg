thenReturns flag: Bool -> Int uses Console {
    "choice=$(flag -> if { 7 -> return } else { 3 })" -> println
    9
}

elseReturns flag: Bool -> Int uses Console {
    "choice=$(flag -> if { 4 } else { 8 -> return })" -> println
    10
}

main {
    true -> thenReturns -> println
    false -> thenReturns -> println
    true -> elseReturns -> println
    false -> elseReturns -> println
}
