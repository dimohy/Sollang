showCounts values: [Int] -> Unit uses Console {
    "function=$(values -> len)" -> println
    true -> if {
        "nested=$(values -> len)" -> println
    }
}

showGrowing count: Int -> Unit uses Console {
    [Int; ~] => dynamic!
    0..<count -> each item {
        dynamic! -> push(item)
    }
    true -> if {
        "growable=$(dynamic! -> len)" -> println
    }
}

main {
    [1, 2, 3] => numbers
    "entry=$(numbers -> len)" -> println
    numbers -> showCounts
    1 -> showGrowing
}
