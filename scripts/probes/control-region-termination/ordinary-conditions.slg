choose seed: Int, flag: Bool -> Int {
    flag -> if { seed + 1 } else { seed + 2 }
}

nested seed: Int, flag: Bool -> Int {
    seed > 0 -> if {
        flag -> if { seed + 3 } else { seed + 4 }
    } else { seed + 5 }
}

mutableCondition flag: Bool -> Int {
    flag => active!
    not active! => active!
    active! -> if { 31 } else { 32 }
}

unlessCondition seed: Int, flag: Bool -> Int {
    flag -> unless { seed + 5 -> return }
    seed + 6
}

shortCircuit left: Bool, right: Bool -> Int {
    left and right -> if { 41 } else { 42 }
}

readCondition flag: ref Bool -> Int {
    flag -> if { 51 } else { 52 }
}

main {
    10 -> choose(true) -> println
    10 -> choose(false) -> println
    10 -> nested(true) -> println
    10 -> nested(false) -> println
    -1 -> nested(true) -> println
    true -> mutableCondition -> println
    false -> mutableCondition -> println
    10 -> unlessCondition(true) -> println
    10 -> unlessCondition(false) -> println
    true -> shortCircuit(true) -> println
    true -> shortCircuit(false) -> println
    false -> shortCircuit(true) -> println
    true => first
    false => second
    first -> readCondition -> println
    second -> readCondition -> println
}
