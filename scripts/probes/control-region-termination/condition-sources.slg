additional seed: Int, flag: Bool -> Int uses Console {
    "arg=$(flag -> if { 13 -> return } else { 6 })" -> println
    21
}

mutableCondition flag: Bool -> Int uses Console {
    not flag => active!
    not active! => active!
    "local=$(active! -> if { 14 -> return } else { 7 })" -> println
    22
}

main {
    0 -> additional(true) -> println
    0 -> additional(false) -> println
    true -> mutableCondition -> println
    false -> mutableCondition -> println
}
