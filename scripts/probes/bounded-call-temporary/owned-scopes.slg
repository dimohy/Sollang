struct Owned {
    value: box Int
}

make: -> [Owned; <=4] => [Owned { value: box 7 }, Owned { value: box 9 }; <=4]
count values: [Owned; <=4] -> Int => values -> len
forward: -> Int => count(make())
continueLoop values: [Owned; <=4], index: Int -> Bool => (values -> len) == 2 and index < 2

main {
    count([Owned { value: box 11 }, Owned { value: box 13 }; <=4]) -> println
    forward() -> println
    0 => index!
    continueLoop(make(), index!) -> while {
        count(make()) -> println
        index! + 1 => index!
    }
    index! -> println
}
