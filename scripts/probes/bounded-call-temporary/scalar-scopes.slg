read values: [UInt8; <= 8] -> Int {
    (values -> capacity) + (values -> len) + Int(values[0]) + Int(values[3])
}

forward: -> Int => read([10, 20, 30, 40])
extra ignored: Int, values: [UInt8; <= 8] -> Int => read(values)
continueLoop values: [UInt8; <= 8], index: Int -> Bool => read(values) == 62 and index < 2

main {
    read([10, 20, 30, 40]) -> println
    forward() -> println
    extra(0, [10, 20, 30, 40]) -> println
    0 -> extra([10, 20, 30, 40]) -> println
    0 => index!
    continueLoop([10, 20, 30, 40], index!) -> while {
        read([10, 20, 30, 40]) -> println
        index! + 1 => index!
    }
    index! -> println
}
