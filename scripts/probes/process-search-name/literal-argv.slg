import sys.process as process

main {
    process.arguments() => arguments
    arguments[1] == "--echo" -> if {
        arguments -> len -> println
        arguments[2] -> println
    } else {
        process.command(arguments[1]) => command!
        command! -> arg("--echo")
        command! -> arg(arguments[2])
        command! -> status -> when {
            Result<process.ExitStatus, Text>.Ok(status) { "status=$(status -> exitCode)" -> println }
            Result<process.ExitStatus, Text>.Err(error) { "error=$error" -> println }
        }
    }
}
