import sys.process as process

main {
    process.arguments() => arguments
    process.Command {
        argv: [arguments[1],; ~], workingDirectoryValue: "", hasWorkingDirectory: false
        environmentChanges: [process.EnvironmentChange; ~], inheritsEnvironment: true
        standardInput: process.Input.Inherit
        standardOutput: process.Output.Null, standardError: process.Output.Inherit
    } -> run -> when {
        Ok(code) { "exit=$code" -> println }
        Err(error) { "error=$error" -> println }
    }
}
