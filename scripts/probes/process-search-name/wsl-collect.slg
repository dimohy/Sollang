import sys.process as process

main {
    process.arguments() => arguments
    process.command(arguments[1]) => command!
    command! -> arg("--exec")
    command! -> arg("true")
    command! -> collect(process.CaptureLimits { standardOutputBytes: 0, standardErrorBytes: 0 }) -> when {
        Result<process.CapturedOutput, Text>.Ok(output) { "status=$(output.status -> exitCode)" -> println }
        Result<process.CapturedOutput, Text>.Err(error) { "error=$error" -> println }
    }
}
