struct Field { values: [Int; ~] }
struct Item { field: Field }

read field: ref Field -> Int { field.values[0] }
add value: Int, field: ref Field -> Int { value + field.values[0] }

inspect: -> Unit uses Console {
    [Item { field: Field { values: [5; ~] } }, Item { field: Field { values: [9; ~] } }] => items
    [1, 0] => order
    2 => position!
    position! > 0 -> while {
        items[order[position! - 1]].field -> read -> println
        3 -> add(items[order[position! - 1]].field) -> println
        position! - 1 => position!
    }
}

main { inspect() }
