import sollang.compiler.toolchain as toolchain
import sys.process as process

main {
    process.arguments() => arguments
    [sys.path.Path; ~] => libraries!
    arguments[1] -> toolchain.createWindowsImportLibraries(arguments[2], arguments[3], libraries!) => code
    code == 0 -> if {
        libraries! -> each library { library -> pathText -> println }
    }
    "result=$code" -> println
}
