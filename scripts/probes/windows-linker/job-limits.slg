namespace sollang.compiler.windows_linker

import sys.process as process

main {
    process.arguments() => args
    args[1] -> positiveInteger => processors
    args[2] == "none" -> if { Option<Int>.None } else {
        args[2] == "0" -> if { 0 } else {
            args[2] == "-1" -> if { -1 } else { args[2] -> positiveInteger }
        } -> Option<Int>.Some
    } => maximum
    processors -> jobLimit(maximum, args[3]) -> when {
        Ok(value) { "workers=$value" -> println }
        Err(error) { "error=$error" -> println }
    }
}
