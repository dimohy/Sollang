import std.compress.gzip as gzip

probe: -> Result<Unit, gzip.Error> uses Console {
    gzip.Limits { maxOutputBytes: 1_024, maxExpansionRatio: 64 } -> codec()? => codec
    codec -> dynamicEncoder()? => encoder
    encoder.produced -> println
    Result<Unit, gzip.Error>.Ok
}

main {
    probe() -> when { Ok(done) { } Err(error) { } }
}
