# A source-final subject when whose every arm explicitly returns terminates
# the function.  The self-host emitter must not create or return a merge SSA
# value for the when expression.
choose value: Int -> Result<Int, Text> {
    value -> when {
        == 0 { Result<Int, Text>.Ok(7) -> return }
        == 1 { Result<Int, Text>.Ok(9) -> return }
        else { Result<Int, Text>.Err("other") -> return }
    }
}

main {
    0 -> choose -> when {
        Ok(value) { value -> println }
        Err(message) { message -> println }
    }
}
