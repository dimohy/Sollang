namespace sollang.compiler.semantic.calls

import sollang.compiler.ast as ast

literalNode kind: Int, parent: Int, start: UIntSize, length: UIntSize, payload: Int -> ast.AstNode {
    ast.AstNode { kind: kind, parent: parent, cstRuleId: 0, operatorKind: 0,
        payloadToken: payload, secondaryToken: -1, tertiaryToken: -1,
        flags: 0, firstToken: 0, tokenCount: 0, start: start, length: length }
}

main {
    [literalNode(10, -1, 10, 100, -1),
    literalNode(37, 0, 20, 10, -1),
    literalNode(37, 0, 20, 10, -1),
    literalNode(15, 2, 31, 1, -1),
    literalNode(15, 2, 29, 1, -1),
    literalNode(15, 2, 29, 1, -1),
    literalNode(39, 0, 10, 10, 1),
    literalNode(39, 0, 10, 20, 1),
    literalNode(39, 0, 10, 20, 2),
    literalNode(39, 0, 10, 99, -1),
    literalNode(39, 1, 10, 5, 3),
    literalNode(39, -1, 10, 50, 4),
    literalNode(37, 0, 34, 10, -1); ~] => nodes
    indexReceiverLiterals(nodes, 0, 13) => index
    index.firstDirect[0] == 6 -> println
    index.firstDirect[1] == -1 -> println
    index.firstChild[2] == 4 -> println
    lastArrayLiteralAt(nodes, 0, index, 20) == 2 -> println
    lastArrayLiteralAt(nodes, 0, index, 34) == 12 -> println
    lastArrayLiteralAt(nodes, 0, index, 21) == -1 -> println
    lastArrayLiteralAt(nodes, 0, index, 10) == -1 -> println
    bestBindingLiteralAt(nodes, 0, index, 10, 0) == 7 -> println
    bestBindingLiteralAt(nodes, 0, index, 10, 1) == 10 -> println
    bestBindingLiteralAt(nodes, 0, index, 10, 2) == -1 -> println
    bestBindingLiteralAt(nodes, 0, index, 10, -1) == -1 -> println
    [ast.AstNode; ~] => empty
    indexReceiverLiterals(empty, 0, 0) => emptyIndex
    lastArrayLiteralAt(empty, 0, emptyIndex, 20) == -1 -> println
    [ast.AstNode; ~] => padded!
    padded! -> push(nodes[0])
    padded! -> push(nodes[0])
    nodes -> each node { padded! -> push(node) }
    indexReceiverLiterals(padded!, 2, 13) => paddedIndex
    lastArrayLiteralAt(padded!, 2, paddedIndex, 20) == 2 -> println
    bestBindingLiteralAt(padded!, 2, paddedIndex, 10, 0) == 7 -> println
}
