import sys.path as path

show label: Text, root: ref path.Path, candidate: ref path.Path -> Unit uses File, Console {
    root -> containsResolved(candidate) -> when {
        Ok(contained) { "$label=ok,$contained" -> println }
        Err(error) { "$label=err,$error" -> println }
    }
}

main {
    path.fromText("root", path.Style.Windows) => root
    path.fromText("root\\child", path.Style.Windows) => child
    path.fromText("root\\escape", path.Style.Windows) => escaped
    show("child", root, child)
    show("junction", root, escaped)
}
