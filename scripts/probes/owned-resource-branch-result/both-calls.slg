namespace regression.owned_resource

import std.net.socket as socket
transfer reactor: move socket.CompletionReactor -> socket.CompletionReactor { reactor }
choose reactor: move socket.CompletionReactor, requested: Bool -> socket.CompletionReactor {
    requested -> if {
        reactor -> transfer
    } else {
        reactor -> transfer
    }
}
main { 1 -> println }
