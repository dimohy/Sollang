import sollang.compiler.llvm.text as llvmText

main {
    "scripts/probes/owned-resource-branch-result/call-versus-result.slg" -> llvmText.resourceBranchDiagnosticCount => callResult
    "call-versus-result=$callResult" -> println
    "scripts/probes/owned-resource-branch-result/both-calls.slg" -> llvmText.resourceBranchDiagnosticCount => bothCalls
    "both-calls=$bothCalls" -> println
    "scripts/probes/owned-resource-branch-result/move-versus-retain.slg" -> llvmText.resourceBranchDiagnosticCount => mixed
    "move-versus-retain=$mixed" -> println
    "scripts/probes/owned-resource-branch-result/terminating-arm.slg" -> llvmText.resourceBranchDiagnosticCount => terminated
    "terminating-arm=$terminated" -> println
}
