score value: Int16 -> Int => Int(value)
adjust base: Int16, delta: Int16 -> Int => Int(base + delta)

main {
    score(-7) -> println
    score(1 + 2 * 3) -> println
    score(true -> if {
        "then" -> println
        false -> if { 8 } else { 3 }
    } else {
        "else" -> println
        9
    }) -> println
    Int16(4) -> adjust(1 + 2 * 3) -> println
}
