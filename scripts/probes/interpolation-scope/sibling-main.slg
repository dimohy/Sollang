main {
    [0, 1] -> each item {
        item == 0 -> if {
            "left" => name!
            item < 0 -> if { "changed" => name! }
            "value $(name!)" -> println
        } else {
            "right" => name!
            item < 0 -> if { "changed" => name! }
            "value $(name!)" -> println
        }
    }
}
