# Branch result provenance must not confuse an immediate sink with storage.
choose flag: Bool, value: Int -> Text {
    flag -> if { "value=$value" } else { "literal" }
}

main {
    7 => value
    [true -> if { "value=$value" } else { "literal" }] => fields
    fields[0] -> println
    [value -> when {
        == 7 { "value=$value" }
        else { "literal" }
    }] => selected
    selected[0] -> println
    [Option<Int>.Some(value) -> when {
        Some(item) { "value=$item" }
        None { "literal" }
    }] => matched
    matched[0] -> println
}
