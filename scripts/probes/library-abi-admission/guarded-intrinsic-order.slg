guardedSlice source: Text, rejectValue: Bool -> Bool {
    0 => index!
    index! < 1 -> while {
        rejectValue -> if { false -> return }
        index! + 1 => index!
    }
    (source -> slice(1, 1)) == "x"
}

guardedByte value: Int, rejectValue: Bool -> UInt8 {
    0 => index!
    index! < 1 -> while {
        rejectValue -> if { 7 -> return }
        index! + 1 => index!
    }
    UInt8(value)
}

main {
    "가" -> guardedSlice(true) -> println
    "axc" -> guardedSlice(false) -> println
    300 -> guardedByte(true) -> println
    250 -> guardedByte(false) -> println
}
