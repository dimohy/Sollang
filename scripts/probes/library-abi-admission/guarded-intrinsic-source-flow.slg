isX value: Text -> Bool { value == "x" }

guardedSource source: Text -> Bool {
    UIntSize(0) => index!
    index! < 1 -> while {
        (source -> byte(index!)) >= 128 -> if { false -> return }
        index! + 1 => index!
    }
    source -> slice(1, 1) -> isX
}

main {
    "가" -> guardedSource -> println
    "axc" -> guardedSource -> println
}
