import sollang.compiler.semantic.library_interfaces as interfaces

main {
    "fn가" => names
    [UInt8; ~] => strings!
    UIntSize(0) => index!
    index! < (names -> len) -> while {
        strings! -> push(names -> byte(index!))
        index! + 1 => index!
    }
    [interfaces.LibraryExport {
        name: interfaces.MetadataSpan { start: 0, length: 2 },
        qualifiedName: interfaces.MetadataSpan { start: 0, length: 2 },
        symbol: interfaces.MetadataSpan { start: 0, length: 0 },
        parameterStart: 0, parameterCount: 0,
        resultType: interfaces.MetadataSpan { start: 3, length: 1 },
        signatureHash: interfaces.MetadataSpan { start: 0, length: 0 }
    }; ~] => exports
    [interfaces.LibraryParameter; ~] => parameters
    exports -> interfaces.create(parameters, strings!, "windows-x64", "probe.dll") -> when {
        Ok(_) => "accepted"
        Err(_) => "rejected"
    } -> println
}
