struct Failure {
    code: Int
}

makeBytes: -> Result<[UInt8; ~], Failure> {
    [UInt8; ~] => bytes!
    bytes! -> push(7)
    Result<[UInt8; ~], Failure>.Ok(bytes!)
}

measure bytes: [UInt8] -> Result<Int, Failure> {
    Result<Int, Failure>.Ok(bytes -> len)
}

run: -> Result<Int, Failure> {
    makeBytes()? -> measure? => count
    Result<Int, Failure>.Ok(count)
}

main {
    run() -> when {
        Ok(count) { "count=$count" -> println }
        Err(error) { "error=$(error.code)" -> println }
    }
}
