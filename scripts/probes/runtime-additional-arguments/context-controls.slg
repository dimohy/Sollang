struct Counter { value: Int }

impl Counter { read: self -> Int => self.value }

readBorrow value: ref Counter -> Int { value -> read }

countBytes bytes: [UInt8] -> Int => bytes -> len

main {
    Counter { value: 42 } => value
    value -> readBorrow -> println
    countBytes([]) -> println
    countBytes([1, 2]) -> println
}
