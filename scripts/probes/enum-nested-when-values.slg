subjectValue value: Result<Int, Int>, byte: Int -> Int {
    value -> when {
        Ok(offset) {
            byte -> when {
                == 1 { offset + 10 }
                else { offset + 20 }
            }
        }
        Err(offset) {
            byte -> when {
                == 1 { offset + 30 }
                else { offset + 40 }
            }
        }
    }
}

booleanValue value: Result<Int, Int>, byte: Int -> Int {
    value -> when {
        Ok(offset) {
            when {
                byte == 1 { offset + 50 }
                else { offset + 60 }
            }
        }
        Err(offset) { offset + 70 }
    }
}

terminatingValue value: Result<Int, Int>, byte: Int -> Int {
    value -> when {
        Ok(offset) { offset + 80 -> return }
        Err(offset) {
            byte -> when {
                == 1 { offset + 90 }
                else { offset + 100 }
            }
        }
    }
}

main {
    subjectValue(Result<Int, Int>.Ok(2), 1) -> println
    subjectValue(Result<Int, Int>.Ok(2), 0) -> println
    subjectValue(Result<Int, Int>.Err(3), 1) -> println
    subjectValue(Result<Int, Int>.Err(3), 0) -> println
    booleanValue(Result<Int, Int>.Ok(2), 1) -> println
    booleanValue(Result<Int, Int>.Ok(2), 0) -> println
    booleanValue(Result<Int, Int>.Err(3), 0) -> println
    terminatingValue(Result<Int, Int>.Ok(2), 0) -> println
    terminatingValue(Result<Int, Int>.Err(3), 1) -> println
    terminatingValue(Result<Int, Int>.Err(3), 0) -> println
}
