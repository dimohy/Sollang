double value: Int -> Int => value * 2
square value: Int -> Int => value * value

main {
    7 -> parallel branch {
        doubled: ref -> double
        squared: ref -> square
    } => results
    results.doubled -> println
    results.squared -> println
    Option<Int>.None -> when {
        Some(value) { value -> println }
        None { 4 -> println }
    }
    true -> if { 5 -> println }
    0 => index!
    index! < 1 -> while {
        6 -> println
        index! + 1 => index!
    }
    when {
        true { 7 -> println }
        else { 0 -> println }
    }
    8 -> when {
        == 8 { 8 -> println }
        else { 0 -> println }
    }
}
