import inference.fixture as model

main {
    model.number() -> println
    model.label() -> println
    model.cell() => returned
    returned.value -> println
    model.Cell { value: 29 } => literal
    literal.value -> println
    model.flag() -> when {
        Ready { "ready" -> println }
        Done { "done" -> println }
    }
    model.Flag.Ready -> when {
        Ready { "constant" -> println }
        Done { "wrong" -> println }
    }
}
