import inference.fixture as model

main {
    {Int: Int} => plain!
    plain! -> put(1, 19)
    plain![1] -> println
    {Text: Int} => named!
    named! -> put("key", 31)
    named!["key"] -> println
    {Int: model.Cell; <=2} => records!
    records! -> put(1, model.Cell { value: 41 })
    records![1].value -> println
}
