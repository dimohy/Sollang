# Deferred arguments and sink-only branch work do not create stored Text.
observe text: Text -> Int uses Console {
    text -> println
    1
}

main {
    7 => value
    [true -> if {
        "value=$value" -> println
        "plain"
    } else { "other" }] => fields
    fields[0] -> println
    ["value=$value" -> observe] => counts
    counts[0] -> println
    ["""raw $value""", "$", "plain"] => literals
    literals[0] -> println
}
