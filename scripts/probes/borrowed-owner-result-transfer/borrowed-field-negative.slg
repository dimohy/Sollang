import sys.file as file

struct Source {
    bytes: [UInt8; ~]
    label: Text
}

view source: Source -> Text {
    source.bytes -> file.borrowBytes => owner
    owner -> slice(0, owner -> len)
}

escape: -> Text {
    Source { bytes: [97; ~], label: "static" } => source
    source -> view
}

main {
    escape() -> println
}
