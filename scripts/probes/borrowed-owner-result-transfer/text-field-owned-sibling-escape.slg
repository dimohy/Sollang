import sys.file as file

struct Carrier {
    bytes: [UInt8; ~]
    label: Text
}

select source: move Carrier -> Text {
    source.label => label
    label
}

escape: -> Text {
    [UInt8(97); ~] => bytes
    bytes -> file.borrowBytes => owner
    owner -> slice(0, owner -> len) => label
    Carrier { bytes: bytes, label: label } -> select
}

main {
    escape() -> println
}
