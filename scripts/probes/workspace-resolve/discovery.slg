import sollang.compiler.manifest_entry as entry
import sys.path as path
import sys.process as process

main {
    process.arguments() => arguments
    Arena(0) => diagnosticStorage!
    arguments[1] -> entry.findFrom(arguments[2], path.nativeStyle(), diagnosticStorage!) -> when {
        Ok(found) {
            found -> when {
                Some(value) { value -> pathText -> println }
                None { "none" -> println }
            }
        }
        Err(error) { "error=$error" -> println }
    }
}
