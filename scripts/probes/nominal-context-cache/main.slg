import numeric_cache.provider as provider
peer: -> UInt8 => 3
plain: -> UInt8 => (true -> if { 1 } else { 2 }) + peer()
plus<T> value: T -> T => (true -> if { 1 } else { 2 }) + value
main {
    plus(UInt8(3)) => first
    plus(UInt16(3)) => second
    plain() => third
    provider.entry() => item
    item.value => fourth
    "$first,$second,$third,$fourth" -> println
}
