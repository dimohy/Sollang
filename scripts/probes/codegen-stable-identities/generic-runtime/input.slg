namespace cache.generic_identity

public identity<T> value: T -> T { value }
public choose<T, U> value: T, other: U -> T { value }
public wrap<T> value: T -> Option<T> { Option<T>.Some(value) }
public count<T> values: [T; ~] -> Int { values -> len }
public extra<T> value: Int, values: [T; ~] -> Int { value }
public nested<T> value: Option<T> -> Unit { }
public third<T, U, V> value: T, second: U, third: V -> V { third }

main {
    identity(7) => number
    [1, 2; ~] => values
    values -> count => size
    "$number,$size" -> println
}
