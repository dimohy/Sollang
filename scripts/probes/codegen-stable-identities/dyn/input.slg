namespace cache.dyn_identity

struct Live { marker: Int }
trait Value { get: self -> Int }
impl Value for Live { get: self -> Int => 7 }

public make: -> dyn Value { Live { marker: 0 } -> dyn<Value> }
public read value: dyn Value -> Int { value -> Value.get }

main {
    make() => value
    value -> read => result
    "$result" -> println
}
