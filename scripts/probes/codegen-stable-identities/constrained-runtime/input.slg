namespace cache.generic_constraint_identity

trait Value { get: self -> Int }
trait Carrier { type Item }
public bounded<T> value: T -> Int where T: Value { value -> Value.get }
public associated<T> value: T -> Unit where T: Carrier, T.Item == Int { }

struct Live { }
impl Value for Live { get: self -> Int => 9 }
impl Carrier for Live { type Item = Int }
main {
    Live { } -> bounded => number
    Live { } -> associated
    "$number" -> println
}
