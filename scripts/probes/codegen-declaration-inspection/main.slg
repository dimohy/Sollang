import sollang.compiler.semantic.analysis as analysis
import sys.file as file
import sys.process as process

inspect path: Text -> Unit uses File, Console {
    path -> file.mapText => source
    [file.SourceText; ~] => sources!
    sources! -> push(source)
    sources! -> analysis.analyzeTestSources([Int; ~], [Int; ~]) => package
    package.ranges[0] => range
    0 => index!
    index! < range.symbolCount -> while {
        package.symbols[range.symbolStart + index!] => symbol
        symbol.nameToken >= 0 -> if {
            package.tokens[range.tokenStart + symbol.nameToken].span => span
            package.sources[0] -> slice(span.start, span.length) => name
            symbol.kind => kind
            symbol.parent => parent
            symbol.flags => flags
            symbol.typeNode => first
            symbol.secondaryTypeNode => second
            "$(index!):$kind:$parent:$flags:$name:$first:$second" -> println
        }
        index! + 1 => index!
    }
}

main {
    process.arguments() => arguments
    arguments[1] -> inspect
}
