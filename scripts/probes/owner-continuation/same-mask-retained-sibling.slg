struct Product { nodes: [Int; ~], retained: [Int; ~] }
struct Carrier { nodes: [Int; ~] }
finish product: move Product, completion: Result<Int, Int> -> Carrier uses Console {
    completion -> when {
        Err(_) => Carrier { nodes: product.nodes }
        Ok(_) => Carrier { nodes: product.nodes }
    } => result
    product.retained[0] -> println
    result
}
consume carrier: move Carrier -> Int => carrier.nodes[0]
main {
    Product { nodes: [1; ~], retained: [2; ~] } -> finish(Result<Int, Int>.Ok(0)) -> consume -> println
    Product { nodes: [3; ~], retained: [4; ~] } -> finish(Result<Int, Int>.Err(9)) -> consume -> println
}
