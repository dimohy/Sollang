struct Product { nodes: [Int; ~], retained: [Int; ~] }
struct Carrier { nodes: [Int; ~] }
finish product: move Product, completion: Result<Int, Int> -> Int {
    completion -> when {
        Err(_) => Result<Carrier, Int>.Ok(Carrier { nodes: product.nodes })
        Ok(_) => Result<Carrier, Int>.Ok(Carrier { nodes: product.nodes })
    } -> consume(product.retained[0])
}
consume result: move Result<Carrier, Int>, retained: Int -> Int => result -> when {
    Ok(carrier) => carrier.nodes[0] + retained
    Err(error) => error + retained
}
main {
    Product { nodes: [1; ~], retained: [2; ~] } -> finish(Result<Int, Int>.Ok(0)) -> println
    Product { nodes: [3; ~], retained: [4; ~] } -> finish(Result<Int, Int>.Err(9)) -> println
}
