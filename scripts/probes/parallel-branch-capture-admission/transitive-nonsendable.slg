# A local target cannot hide a non-sendable Arena capture inside a parallel branch worker.
run value: Int -> (left: Int, right: Int) {
    addUsage input: Int -> Int => input + Int(memory -> used)
    relay input: Int -> Int => input -> addUsage

    Arena(8) => memory
    value -> parallel branch {
        left: -> relay
        right: -> relay
    }
}

main {
    1 -> run => result
}
