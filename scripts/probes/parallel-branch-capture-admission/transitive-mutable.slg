# A local target cannot hide a mutable capture inside a parallel branch worker.
run value: Int -> (left: Int, right: Int) {
    addOffset input: Int -> Int => input + offset!
    relay input: Int -> Int => input -> addOffset

    10 => offset!
    value -> parallel branch {
        left: -> relay
        right: -> relay
    }
}

main {
    1 -> run => result
}
