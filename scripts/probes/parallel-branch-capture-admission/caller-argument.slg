add input: Int, amount: Int -> Int => input + amount
run value: Int -> (left: Int, right: Int) {
    read input: Int -> Int => input + offset!
    10 => offset!
    11 => offset!
    value -> parallel branch {
        left: -> add(2 -> read)
        right: -> add(3 -> read)
    }
}
main {
    1 -> run => result
    "$(result.left):$(result.right)" -> println
}
