struct Owner { values: [Int; ~] }

parent: -> async Unit uses Console {
    [Owner { values: [11, 22; ~] }] => owners
    "parent-start" -> println
    yield
    owners[0].values[0] -> println
}

gate: -> async Int { 1 }

main {
    parent() => task
    gate() -> await => first
    task -> cancel
    gate() -> await => second
    "cancelled:$first,$second" -> println
}
