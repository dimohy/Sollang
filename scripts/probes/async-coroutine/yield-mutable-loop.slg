namespace probes.yield_mutable_loop
public count: -> async Int uses Console {
    0 => counter!
    counter! < 3 -> while {
        counter! + 1 => counter!
        yield
        "tick $(counter!)" -> println
    }
    counter!
}
main {
    probes.yield_mutable_loop.count() => task
    task -> await => result
    "$result" -> println
}
