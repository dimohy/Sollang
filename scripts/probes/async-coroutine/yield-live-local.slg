namespace probes.yield_live_local
public first input: Int -> async Unit uses Console {
    input + 1 => value
    "A1" -> println
    yield
    "A2:$value" -> println
}
public second: -> async Unit uses Console {
    "B1" -> println
    yield
    "B2" -> println
}
main {
    probes.yield_live_local.first(6) => firstTask
    probes.yield_live_local.second() => secondTask
    firstTask -> await
    secondTask -> await
}
