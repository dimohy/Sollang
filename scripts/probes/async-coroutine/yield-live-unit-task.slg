namespace probes.yield_live_unit_task
public child: -> async Unit uses Console {
    "child1" -> println
    yield
    "child2" -> println
}
public parent: -> async Unit uses Console {
    probes.yield_live_unit_task.child() => childTask
    "parent1" -> println
    yield
    "parent2" -> println
    childTask -> await
    yield
    "parent3" -> println
}
main {
    probes.yield_live_unit_task.parent() => task
    task -> await
    "done" -> println
}
