namespace probes.yield_live_task
public child: -> async Int uses Console {
    "child1" -> println
    yield
    "child2" -> println
    7
}
public parent: -> async Int uses Console {
    probes.yield_live_task.child() => childTask
    "parent1" -> println
    yield
    "parent2" -> println
    childTask -> await => value
    yield
    "value:$value" -> println
    value
}
main {
    probes.yield_live_task.parent() => task
    task -> await => result
    "result:$result" -> println
}
