namespace probes.await_parent_fifo
public child input: Int -> async Int uses Console {
    "C$(input)1" -> println
    yield
    "C$(input)2" -> println
    input + 1
}
public parent input: Int -> async Int uses Console {
    "P$(input)1" -> println
    probes.await_parent_fifo.child(input) => childTask
    childTask -> await => result
    "P$(input)2" -> println
    result
}
main {
    probes.await_parent_fifo.parent(1) => first
    probes.await_parent_fifo.parent(2) => second
    first -> await => firstResult
    second -> await => secondResult
    "$firstResult $secondResult" -> println
}
