namespace probes.async_coroutine.anonymous_pattern_direct_await

import std.time as time

report value: Option<Int> -> Unit uses Console {
    value -> when {
        Some(number) { number -> println }
        None { 0 -> println }
    }
}

worker: -> async Int uses Clock, Console {
    time.milliseconds(1) -> when {
        Ok(delay) { delay -> sleep -> await }
        Err(error) { "duration-error" -> println }
    }
    7
}

main {
    Option<Int>.None -> report
    Option<Int>.Some(3) -> report
    worker() => task
    task -> await -> println
}
