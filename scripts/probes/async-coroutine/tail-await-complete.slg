namespace probes.tail_await_complete
public child: -> async Int uses Console {
    "child1" -> println
    yield
    "child2" -> println
    7
}
public parent: -> async Int uses Console {
    "parent-start" -> println
    probes.tail_await_complete.child() => childTask
    childTask -> await
}
main {
    probes.tail_await_complete.parent() => task
    task -> await => value
    "completed:$value" -> println
}
