# The Err arm returns from the function; only the Ok arm reaches the match result.
check value: Result<Bool, Text> -> Bool {
    value -> when {
        Err(_) { false -> return }
        Ok(flag) { flag }
    } => result
    result and true
}

main {
    Result<Bool, Text>.Ok(true) -> check -> if { "valid" } else { "invalid" } -> println
}
