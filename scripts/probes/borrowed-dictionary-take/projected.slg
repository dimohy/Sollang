struct DictionaryState {
    values: {Int: Int}
}

extract state: mut DictionaryState -> Int {
    state.values -> take(1)
}

main {
    DictionaryState { values: { 1: 10, 2: 20 } } => state!
    state! -> extract => first
    first -> println
    state!.values[2] -> println
    state!.values -> len -> println
    state!.values -> take(2) => second
    second -> println
    state!.values -> len -> println
}
