extract marker: Int, values: mut {UInt64: Text} -> Text {
    values -> take(UInt64(4294967297))
}

main {
    {UInt64: Text; 2~} => values!
    values! -> put(UInt64(4294967297), "first")
    values! -> put(UInt64(8589934593), "second")
    0 -> extract(values!) => selected
    selected -> println
    values![UInt64(8589934593)] -> println
    values! -> len -> println
}
