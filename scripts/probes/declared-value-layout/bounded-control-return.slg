branch flag: Bool, values: [Int; <=3] -> [Int; <=3] {
    flag -> if { values -> return }
    [5]
}

inspect values: ref [Int; <=3] -> Int => values -> len

afterAppend values: mut [Int; <=3] -> Int {
    values -> push(11)
    values -> inspect
}

main {
    [7, 9; <=3] => values!
    branch(true, values!) => first
    branch(false, values!) => second
    first[0] -> println
    second[0] -> println
    afterAppend(values!) -> println
}
