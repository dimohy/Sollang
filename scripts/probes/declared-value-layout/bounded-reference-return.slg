make: -> [Int; <=3] => [7, 9]

copyRef values: ref [Int; <=3] -> [Int; <=3] => values

replace values: mut [Int; <=3] -> Unit {
    42 => values[0]
}

main {
    make() => original
    original -> copyRef => second!
    replace(second!)
    original[0] -> println
    second![0] -> println
    second! -> len -> println
}
