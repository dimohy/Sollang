struct Record {
    tag: Int
}

make input: ref [Int; <=3], extra: [Int; <=2] -> [Int; <=3] {
    [input[0] + extra[0]; <=3]
}

copy input: ref [Int; <=3] -> [Int; <=3] {
    [input[0] + 0; <=3]
}

makeRecord input: ref Record -> Record {
    Record { tag: input.tag + 10 }
}

readRecord input: ref Record -> Int {
    input.tag
}

main {
    [1, 2; <=3] => values
    [10; <=2] => offsets
    values -> make(offsets) -> copy => result
    result[0] -> println
    Record { tag: 1 } => record
    record -> makeRecord -> readRecord -> println
}
