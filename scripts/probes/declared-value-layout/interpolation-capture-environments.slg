struct Owned {
    tag: Int
    value: box Int
}

struct Record {
    tag: Int
}

inspect scalar: Int, owned: Owned -> Unit uses Console {
    read increment: Int -> Int {
        scalar + increment
    }
    readOwned increment: Int -> Int {
        owned.tag + increment
    }
    "scalar=$(1 -> read),again=$(2 -> read)" -> println
    "owned=$(1 -> readOwned),again=$(2 -> readOwned)" -> println
}

inspectMutable record: mut Record -> Unit uses Console {
    read increment: Int -> Int {
        record.tag + increment
    }
    record.tag + 1 => record.tag
    1 -> read => normal
    normal -> println
    "mutable=$(1 -> read),again=$(2 -> read)" -> println
}

main {
    Owned { tag: 7, value: box 9 } => owned
    3 -> inspect(owned)
    Record { tag: 3 } => record!
    record! -> inspectMutable
}
