struct Bucket {
    values: [Int; <=3]
}

struct Record {
    tag: Int
}

make input: ref [Int; <=3], extra: [Int; <=2] -> [Int; <=3] {
    [input[0] + extra[0]; <=3]
}

copy input: ref [Int; <=3] -> [Int; <=3] {
    [input[0] + 0; <=3]
}

makeRecord value: Int -> Record => Record { tag: value + 10 }

readRecord input: ref Record -> Int => input.tag

main {
    [1, 2; <=3] => values
    [10; <=2] => offsets
    (values) -> make(offsets) -> copy => parenthesized
    parenthesized[0] -> println
    Bucket { values: [1, 2] } => bucket
    bucket.values -> make(offsets) -> copy => projected
    projected[0] -> println
    3 => scalar
    scalar -> makeRecord -> readRecord -> println
}
