struct Storage {
    public values: [[Int; <=2]; 2]
}

make: -> Storage => Storage { values: [[5], [7, 9]] }

replace values: mut [Int; <=2] -> Unit {
    42 => values[0]
}

main {
    make() => owner
    owner.values[0] => first!
    replace(first!)
    owner.values[0] => original
    original[0] -> println
    first![0] -> println
    original -> len -> println
    first! -> len -> println
}
