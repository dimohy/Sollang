make: -> [Int; <=3] => [7, 9]

copy values: [Int; <=3] -> [Int; <=3] => values

pick flag: Int, values: [Int; <=3] -> [Int; <=3] => values

throughRef values: ref [Int; <=3] -> [Int; <=3] => copy(values)

replace values: mut [Int; <=3] -> Unit {
    42 => values[0]
}

main {
    make() => source
    copy(source) => first!
    replace(first!)
    first![0] -> println
    source[0] -> println
    pick(1, source) -> len -> println
    source -> throughRef -> len -> println
}
