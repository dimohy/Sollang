struct Owned {
    value: box Int
}

verify offsets: [Int; <=2], owned: [Owned; <=2] -> Unit uses Console {
    add value: Int -> Int {
        value + offsets[0]
    }
    count value: Int -> Int {
        value + (owned -> len)
    }
    1 -> parallel branch {
        first: ref -> add
        second: ref -> count
    } => result
    result.first -> println
    result.second -> println
}

main {
    [10; <=2] => offsets
    [Owned { value: box 7 }; <=2] => owned
    offsets -> verify(owned)
}
