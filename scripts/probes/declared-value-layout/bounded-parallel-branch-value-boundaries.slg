verify values: [Int; <=3] -> Unit uses Console {
    first input: ref [Int; <=3] -> [Int; <=3] {
        [input[0] + 1; <=3]
    }
    second input: ref [Int; <=3] -> [Int; <=3] {
        [input[1] + 2; <=3]
    }
    values -> parallel branch {
        first: ref -> first
        second: ref -> second
    } => result
    result.first => firstResult
    result.second => secondResult
    firstResult[0] -> println
    secondResult[0] -> println
}

main {
    [7, 9; <=3] => values
    values -> verify
}
