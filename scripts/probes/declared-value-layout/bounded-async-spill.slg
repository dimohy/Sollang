increment value: Int -> async Int => value + 1

make: -> async [Int; <=3] {
    [7, 9; <=3] => values!
    10 -> increment => pending
    pending -> await => result
    result => values![0]
    values!
}

main {
    make() => pending
    pending -> await => values
    values[0] -> println
    values[1] -> println
    values -> len -> println
    values -> capacity -> println
}
