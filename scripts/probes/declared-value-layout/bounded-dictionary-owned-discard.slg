struct Owned {
    value: box Int
}

makeOwned value: Int -> [Owned; <=2] {
    [Owned { value: box value }; <=2]
}

main {
    { 1: makeOwned(7) } => values!
    values! -> putIfAbsent(1, makeOwned(9)) => inserted
    inserted -> if {
        "inserted" -> println
    } else {
        "duplicate" -> println
    }
    values! -> take(1) => selected
    selected -> len -> println
}
