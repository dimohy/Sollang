swap values: mut [Int; ~] -> Unit {
    values -> exchange(0, 1)
}

main {
    [1, 2; ~] => values!
    values! -> exchange(0, 1)
    values![0] -> println
    values![1] -> println

    swap(values!)
    values![0] -> println
    values![1] -> println

    values![0] == 1 -> if {
        values! -> exchange(0, 1)
    }
    values![0] -> println
    values![1] -> println
}
