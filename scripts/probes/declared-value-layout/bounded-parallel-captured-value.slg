lower values: [Int; ~], offsets: [Int; <=2] -> [Int; ~] {
    apply value: Int -> Int {
        value + offsets[0]
    }
    values -> parallel value {
        value -> apply
    } => result
    result
}

main {
    [1, 2; ~] => values
    [10; <=2] => offsets
    values -> lower(offsets) => result
    result[0] -> println
    result[1] -> println
}
