pause: -> async Int => 1

inspect values: [Int; <=3] -> async Int {
    local increment: Int -> async Int {
        pause() => pending
        pending -> await => offset
        values[0] + increment + offset
    }
    1 -> local => pending
    pending -> await
}

main {
    [7, 9; <=3] => values
    values -> inspect => pending
    pending -> await -> println
}
