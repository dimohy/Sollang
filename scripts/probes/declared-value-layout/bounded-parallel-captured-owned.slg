struct Owned {
    value: box Int
}

lower values: [Int; ~], offsets: [Owned; <=2] -> [Int; ~] {
    apply value: Int -> Int {
        (offsets -> len) + value
    }
    values -> parallel value {
        value -> apply
    } => result
    result
}

main {
    [1, 2; ~] => values
    [Owned { value: box 7 }; <=2] => offsets
    values -> lower(offsets) => result
    result[0] -> println
    result[1] -> println
}
