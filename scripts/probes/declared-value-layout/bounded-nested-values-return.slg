struct Storage {
    public values: [[Int; <=2]; 2]
}

make: -> Storage => Storage { values: [[5], [7, 9]] }

main {
    make() => owner
    owner.values -> len -> println
    owner.values[0] => first
    owner.values[1] => second
    first[0] -> println
    second[1] -> println
    first -> capacity -> println
}
