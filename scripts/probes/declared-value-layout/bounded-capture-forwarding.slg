struct Owned {
    value: box Int
}

read values: [Int; <=3] -> Int {
    relay increment: Int -> Int {
        leaf extra: Int -> Int {
            values[0] + extra
        }
        increment -> leaf
    }
    1 -> relay
}

readOwned values: [Owned; <=2] -> Int {
    relay increment: Int -> Int {
        leaf extra: Int -> Int {
            (values -> len) + extra
        }
        increment -> leaf
    }
    1 -> relay
}

main {
    [7, 9; <=3] => values
    values -> read => first
    first -> println
    [Owned { value: box 7 }; <=2] => owned
    owned -> readOwned => second
    second -> println
}
