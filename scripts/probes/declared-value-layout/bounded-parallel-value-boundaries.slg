verify values: [Int; ~], offsets: [Int; <=2] -> Unit uses Console {
    apply value: Int, extra: [Int; <=2] -> [Int; <=3] {
        [value + extra[0]; <=3]
    }
    values -> parallel value {
        value -> apply(offsets)
    } => result
    result[0] => first
    first[0] -> println
    result[1] => second
    second[0] -> println
}

main {
    [1, 2; ~] => values
    [10; <=2] => offsets
    values -> verify(offsets)
}
