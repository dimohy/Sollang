make: -> [Int; <=3] => [7, 9]

scoped early: Bool -> Int {
    make() => values!
    early -> if { values![0] -> return }
    42 => values![0]
    values![0]
}

produce: -> [Int; <=3] uses Console {
    11 -> println
    [11]
}

discarded: -> Int uses Console {
    produce() -> len => length
    length
}

main {
    scoped(true) -> println
    scoped(false) -> println
    discarded() -> println
}
