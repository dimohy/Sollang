struct Holder {
    value: Int
}

impl Holder {
    read: self -> async Int => self.value
}

normal value: Int -> Int {
    local increment: Int -> Int {
        value + increment
    }
    1 -> local
}

main {
    Holder { value: 7 } => holder
    holder -> read => pending
    pending -> await -> println
    4 -> normal -> println
}
