make: -> [Int; <=3] => [7, 9]

success: -> Result<[Int; <=3], Text> {
    Result<[Int; <=3], Text>.Ok(make())
}

readSuccess: -> Result<Int, Text> {
    success()? => values
    Result<Int, Text>.Ok(values[1])
}

failure: -> Result<Int, [Int; <=3]> {
    Result<Int, [Int; <=3]>.Err(make())
}

forwardFailure: -> Result<Int, [Int; <=3]> {
    failure()? => value
    Result<Int, [Int; <=3]>.Ok(value)
}

main {
    readSuccess() -> when {
        Ok(value) { value -> println }
        Err(error) { error -> println }
    }
    forwardFailure() -> when {
        Ok(value) { value -> println }
        Err(values) { values[0] -> println }
    }
}
