struct Owned {
    value: box Int
}

inspect values: [Int; <=3], owned: [Owned; <=2] -> Unit uses Console {
    read increment: Int -> Int {
        values[0] + increment
    }
    count increment: Int -> Int {
        (owned -> len) + increment
    }
    "copy=$(1 -> read)" -> println
    "owned=$(1 -> count)" -> println
}

main {
    [7, 9; <=3] => values
    [Owned { value: box 7 }; <=2] => owned
    values -> inspect(owned)
}
