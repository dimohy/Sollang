struct Storage {
    public values: [Int; <=3]
}

make: -> [Int; <=3] => [7, 9]

copy values: [Int; <=3] -> [Int; <=3] => values

inspect values: ref [Int; <=3] -> Int => values -> len

describe values: ref [Int; <=3] -> Unit uses Console {
    "refLen=$(values -> len)" -> println
    "refItem=$(values[0])" -> println
}

main {
    make() => values!
    42 => values![1]
    Storage { values: [11, 13] } => owner
    "copy=$(copy(values!) -> len)" -> println
    "first=$(copy(values!)[0])" -> println
    "read=$(values! -> inspect)" -> println
    "field=$(owner.values[0])" -> println
    "fieldSize=$(owner.values -> copy -> len)" -> println
    "cap=$(owner.values -> capacity)" -> println
    values! -> describe
}
