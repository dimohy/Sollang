struct Storage {
    public values: [Int; <=3]
}

make: -> Storage => Storage { values: [7, 9] }

append values: mut [Int; <=3], value: Int -> Unit {
    values -> push(value)
}

main {
    make() => owner!
    append(owner!.values, 11)
    owner!.values -> len -> println
    owner!.values[2] -> println
}
