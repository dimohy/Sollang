length values: ref [Int; ~] -> Int => values -> len
first values: ref [Int; ~] -> Int => values[0]
main {
    [7, 8, 9; ~] => values
    values -> branch {
        count: ref -> length
        head: ref -> first
    } => results
    results.count -> println
    results.head -> println
    values -> len -> println
}
