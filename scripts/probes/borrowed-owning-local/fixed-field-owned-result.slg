struct Mixed { fixed: [Int; 2], owned: [Int; ~] }
makeMixed values: Mixed -> Mixed {
    Mixed { fixed: values.fixed, owned: [1; ~] }
}
main {
    Mixed { fixed: [7, 8], owned: [99; ~] } => values
    values -> makeMixed => pair
    pair.fixed[0] + pair.owned[0] -> println
    values.fixed[0] -> println
    values.owned[0] -> println
}
