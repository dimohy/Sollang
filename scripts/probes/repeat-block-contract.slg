count: -> Int uses Console {
    "count" -> println
    3
}

show limit: Int -> Unit uses Console {
    limit -> repeat number {
        "function=$number" -> println
    }
}

main {
    count() -> repeat number {
        "main=$number" -> println
    }
    0 -> repeat { "zero=$it" -> println }
    -2 -> repeat { "negative=$it" -> println }
    2 -> repeat { "default=$it" -> println }
    show(2)
    true -> if {
        2 -> repeat number { "branch=$number" -> println }
    }
    4 -> repeat number {
        number == 2 -> if { continue }
        number == 4 -> if { break }
        "transfer=$number" -> println
    }
    2 -> repeat outer {
        2 -> repeat inner { "nested=$outer,$inner" -> println }
    }
}
