import std.net.quic.error as errors
import std.net.quic.tls_hello as hello

randomBytes: -> [UInt8; 32] => [0; 32]

keyShare: -> [UInt8; 32] => [1; 32]

run: -> Result<Int, errors.Error> {
    hello.encodeClientHello(
    randomBytes(),
    [101, 120, 97, 109, 112, 108, 101],
    [104, 51],
    keyShare(),
    [1, 2, 3, 4])? => encoded
    encoded -> hello.decodeClientHello? => decoded
    Result<Int, errors.Error>.Ok(decoded.serverName -> len)
}

main {
    run() -> when {
        Ok(length) { "server-name-length=$length" -> println }
        Err(error) { "client-hello-error=$(error.code)" -> println }
    }
}
