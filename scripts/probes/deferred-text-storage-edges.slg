namespace sollang.compiler.semantic.ownership_check

import sollang.compiler.ir.typed as typedIr

edgeNode kind: Int, operand0: Int, operand1: Int, opcode: Int -> typedIr.TypedIrNode {
    typedIr.TypedIrNode {
        kind: kind
        parent: -1
        sourceModule: 0
        astNode: -1
        symbol: -1
        targetModule: -1
        typeId: 1
        typeKind: 1
        typeOrigin: 1
        typeModule: -1
        typeSymbol: 1
        typeFlags: 0
        payloadToken: 1
        opcode: opcode
        operand0: operand0
        operand1: operand1
        nextOperand: 2
        flags: 0
    }
}

public runEdges: -> Unit uses Console {
    [edgeNode(2, -1, -1, -1), edgeNode(19, -1, -1, -1), edgeNode(3, -1, -1, -1), edgeNode(23, 0, -1, -1); ~] => values
    edgeNode(17, 0, -1, -1) => binding
    "edge-binding=$(binding -> deferredTextStorageConsumes(0, values)),$(binding -> deferredTextStorageConsumes(1, values))" -> println
    edgeNode(24, 0, 1, -1) => indexed
    "edge-index=$(indexed -> deferredTextStorageConsumes(0, values)),$(indexed -> deferredTextStorageConsumes(1, values)),$(indexed -> deferredTextStorageConsumes(2, values))" -> println
    edgeNode(25, 0, 1, -1) => field
    "edge-field=$(field -> deferredTextStorageConsumes(0, values)),$(field -> deferredTextStorageConsumes(1, values))" -> println
    edgeNode(9, 0, 1, -204) => push
    "edge-push=$(push -> deferredTextStorageConsumes(0, values)),$(push -> deferredTextStorageConsumes(1, values))" -> println
    edgeNode(6, 0, 1, -223) => put
    "edge-put=$(put -> deferredTextStorageConsumes(0, values)),$(put -> deferredTextStorageConsumes(1, values)),$(put -> deferredTextStorageConsumes(2, values))" -> println
    edgeNode(6, 0, 1, -1) => userCall
    "edge-user-call=$(userCall -> deferredTextStorageConsumes(1, values)),$(userCall -> preservesDeferredText(0, values))" -> println
    edgeNode(19, 0, 1, -1) => region
    "edge-region=$(region -> preservesDeferredText(0, values)),$(region -> preservesDeferredText(1, values)),$(region -> preservesDeferredText(3, values))" -> println
    edgeNode(18, 0, 1, -1) => conditional
    "edge-control=$(conditional -> preservesDeferredText(0, values)),$(conditional -> preservesDeferredText(1, values))" -> println
    edgeNode(9, 0, 1, -229) => materialized
    "edge-materialize=$(materialized -> deferredTextStorageConsumes(0, values)),$(materialized -> preservesDeferredText(0, values))" -> println

    [typedIr.TypedIrNode; ~] => strings!
    edgeNode(2, -1, -1, -1) => first!
    strings! -> push(first!)
    1 => first!.sourceModule
    strings! -> push(first!)
    2 => first!.payloadToken
    strings! -> push(first!)
    5 => first!.kind
    strings! -> push(first!)
    2 => first!.kind
    9 => first!.sourceModule
    strings! -> push(first!)
    0 => first!.sourceModule
    6 => first!.payloadToken
    strings! -> push(first!)
    [0, 7; ~] => starts
    [4, 5; ~] => counts
    # Module 1 token 1 models a raw/literal token absent from interpolation IR.
    [0, 1, 1, 1, 9; ~] => modules
    [1, 2, 2, -1, 0; ~] => tokens
    strings! -> deferredTextStringSeeds(starts, counts, modules, tokens) => seeds
    "seed-modules=$(seeds[0]),$(seeds[1]),$(seeds[2]),$(seeds[3]),$(seeds[4]),$(seeds[5])" -> println
    [7, 0; ~] => swappedStarts
    strings! -> deferredTextStringSeeds(swappedStarts, counts, modules, tokens) => swapped
    "seed-offset-order=$(swapped[0]),$(swapped[1]),$(swapped[2]),$(swapped[3]),$(swapped[4]),$(swapped[5])" -> println
}
