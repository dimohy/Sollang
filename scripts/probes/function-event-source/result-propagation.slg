import sys.input.mouse as mouse

inspectPlan capacity: Int -> Result<Unit, mouse.Error> uses Console {
    capacity -> mouse.source(mouse.OverflowPolicy.DropNewest)? => plan
    plan.capacity -> println
    Result<Unit, mouse.Error>.Ok
}

main {
    2 -> inspectPlan -> when {
        Ok(unit) { "ok" -> println }
        Err(error) { error.invalidCapacity -> println }
    }
    1 -> inspectPlan -> when {
        Ok(unit) { "unexpected" -> println }
        Err(error) { error.invalidCapacity -> println }
    }
}
