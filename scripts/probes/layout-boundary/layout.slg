import sollang.compiler.llvm.text as compiler
import sollang.compiler.semantic.type_ids as types
import sys.process as process

main {
    process.arguments() => arguments
    Int(arguments -> len) - 1 => index
    [1, 536870907, 536870908, 536870909, 536870910, 536870912, 2147483647] => capacities
    capacities[index] => capacity
    [types.SemanticType; ~] => items!
    items! -> push(types.SemanticType {
        kind: 1, origin: 1, module: -1, symbol: 2,
        first: -1, second: -1, length: -1, lengthHash: 0,
        containsParameter: false, status: 0
    })
    items! -> push(types.SemanticType {
        kind: 12, origin: 0, module: -1, symbol: -1,
        first: 0, second: -1, length: capacity, lengthHash: 0,
        containsParameter: false, status: 0
    })
    [types.NominalField; ~] => fields
    compiler.TypeLayoutRequest {
        types: items!, fields: fields, typeId: 1, pointerBitWidth: 64
    } -> compiler.layoutsFor => layouts
    layouts.statuses[1] => status
    layouts.sizes[1] => size
    layouts.aligns[1] => alignment
    "capacity=$capacity status=$status size=$size align=$alignment" -> println
}
