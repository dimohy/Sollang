import sollang.compiler.llvm.emitter.layout_arithmetic as arithmetic
import sys.process as process

main {
    process.arguments() => arguments
    Int(arguments -> len) - 1 => index
    [1, 536870907, 536870908, 536870909, 536870910, 536870912, 2147483647] => capacities
    capacities[index] => capacity
    4 -> arithmetic.boundedArrayStorageLayout(4, capacity) -> when {
        Ok(layout) {
            "capacity=$capacity status=0 size=$(layout.size) align=$(layout.align)" -> println
        }
        Err(error) {
            error -> when { InvalidInput { 2 } Overflow { 4 } } => status
            "capacity=$capacity status=$status size=-1 align=1" -> println
        }
    }
}
