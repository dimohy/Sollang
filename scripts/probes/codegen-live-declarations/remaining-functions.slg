namespace cache.remaining

public struct Box { value: Int }
public trait Reader {
    type Item
    read: self -> Item
}
impl Reader for Box {
    type Item = Int
    public read: self -> Int => self.value
}
public infer value: Int -> => value
public inferZero: -> => 42
public qualified.echo value: Int -> Int { value }
public constrained<T> value: T -> T where T: Reader, T.Item == Int { value }
native api from "kernel32" {
    public version: -> UInt32 as "GetVersion"
}
