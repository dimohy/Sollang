struct Cell { value: Int }

read index: Int, values: [Cell] -> Int => values[index].value

make count: Int -> [Cell; ~] {
    [Cell; ~] => values!
    0 => index!
    index! < count -> while {
        values! -> push(Cell { value: 17 + index! })
        index! + 1 => index!
    }
    values!
}

choose values: ref [Cell; ~] -> Int {
    0 -> read(values)
}

main {
    2 -> make => values
    values -> choose -> println
}
