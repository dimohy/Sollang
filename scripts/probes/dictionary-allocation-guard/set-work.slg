setWork count: Int -> Unit uses Console {
    Set<Int>(4) => values!
    0..<count -> each item { values! -> insert(item) => inserted }
    0..<16 -> each item { values! -> remove(item) => removed }
    values! -> reserve(128)
    "set=$(values! -> len),$(values! -> contains(19)),$(values! -> contains(0))" -> println
}
main { 20 -> setWork }
