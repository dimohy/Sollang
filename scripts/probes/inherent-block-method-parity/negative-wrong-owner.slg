struct LeftAlgorithms { }
struct RightAlgorithms { }

impl LeftAlgorithms {
    partitionPoint<T>: self, values: [T] -> Int block item: ref T -> Bool {
        values[0] -> yield
        0
    }
}

impl RightAlgorithms {
    partitionPoint<T>: self, values: [T] -> Int block item: ref T -> Bool {
        values[0] -> yield
        0
    }
}

main {
    LeftAlgorithms { } => left
    [1; ~] => values
    left -> RightAlgorithms.partitionPoint(values) value { value > 0 } => boundary
    boundary -> println
}
