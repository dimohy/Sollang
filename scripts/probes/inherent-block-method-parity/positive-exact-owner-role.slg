struct LeftAlgorithms { }
struct RightAlgorithms { }
struct OwnedEntry { key: Int, payload: box Int }

impl LeftAlgorithms {
    partitionPoint<T>: self, values: [T] -> Int block item: ref T -> Bool {
        0 => lower!
        values -> len => upper!
        lower! < upper! -> while {
            lower! + (upper! - lower!) / 2 => middle
            values[middle] -> yield => inPrefix
            inPrefix -> if {
                middle + 1 => lower!
            } else {
                middle => upper!
            }
        }
        lower!
    }
}

impl RightAlgorithms {
    partitionPoint<T>: self, values: [T] -> Int block item: ref T -> Bool {
        values[0] -> yield
        700
    }
}

main {
    LeftAlgorithms { } => algorithms
    [OwnedEntry;
    { key: 1, payload: box 10 },
    { key: 2, payload: box 20 },
    { key: 3, payload: box 30 },
    { key: 4, payload: box 40 },
    { key: 5, payload: box 50 };
    ~
    ] => values!
    values! -> len => length
    algorithms -> partitionPoint(values!) entry { entry.key < 4 } => boundary
    values! -> take(0) => retained
    "boundary=$boundary,len=$length,retained=$(retained.key)" -> println
}
