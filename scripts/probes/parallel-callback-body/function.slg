run values: [Int; ~] -> [Int; ~] uses Console {
    values -> parallel item {
        "$item" -> println
        item * 2
    } => mapped
    mapped
}

main {
    [Int; ~] => values!
    1..3 -> each item { values! -> push(item) }
    values! -> run => mapped
    (mapped -> len) -> println
    mapped -> each item { item -> println }
}
