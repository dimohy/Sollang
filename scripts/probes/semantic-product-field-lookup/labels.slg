read value: (left: Int, right: Bool) -> Int => value.left

main {
    (left: 7, right: true) => first
    first -> read -> println
    first.right -> println
    (left: "named", right: 9) => second
    second.left -> println
    second.right -> println
    (right: 13, left: false) => reordered
    reordered.right -> println
    reordered.left -> println
}
