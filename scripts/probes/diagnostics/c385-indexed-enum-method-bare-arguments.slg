public enum Mode {
    Lsb6
    Msb6
}

impl Mode {
    public id: self, previous: UInt8, secondPrevious: UInt8 -> Int => self -> when {
        Lsb6 { Int(previous) + Int(secondPrevious) }
        Msb6 { Int(previous) * Int(secondPrevious) }
    }
}

public struct Header {
    public contextModes: [Mode; ~]
}

main {
    Mode.Lsb6 => mode
    Header { contextModes: [mode] } => header
    header.contextModes[0] -> id(1, 2) => contextId
    "value=$(64 + contextId)" -> println
}
