struct Task { values: [Int; ~] }

choose ready: Bool -> Task {
    ready -> if {
        Task { values: [42; ~] } => task
        task
    } else {
        Task { values: [42; ~] } => task
        task
    }
}

main {
    true -> choose => first
    false -> choose => second
    first.values -> len -> println
    second.values -> len -> println
}
