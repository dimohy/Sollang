struct Packet { bytes: [UInt8; 2] }
copiedField packet: ref Packet -> UInt8 uses Console {
    packet.bytes => copied!
    19 => copied![0]
    packet.bytes[0] -> println
    copied![0]
}
main {
    Packet { bytes: [13, 17] } => packet
    packet -> copiedField -> println
    packet.bytes[0] -> println
}
