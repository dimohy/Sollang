namespace sollang.compiler.llvm.codegen_cache_keys

import sollang.compiler.llvm.codegen_cache_key_policy as plans
import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.modules as modules
import sys.file as file
import sys.process as process

showMemberField field: ref Field -> Unit uses Console {
    field.bytes -> file.borrowBytes => source
    source -> slice(0, source -> len) -> println
}

showMemberRule context: ref TypeFieldContext, package: ref analysis.PackageAnalysis, rule: ref plans.KeyRule, name: Text, unavailable: Bool -> Unit uses Console, Process {
    name -> println
    rule.parts -> each part {
        context -> sourceMemberField(package, 1, part) -> when {
            Ok(field) {
                unavailable -> if { process.exit(1) }
                field -> showMemberField
            }
            Err(_) {
                unavailable -> if { "unavailable" -> println } else { process.exit(1) }
            }
        }
    }
}

main {
    process.arguments() => arguments
    arguments[1] -> file.mapText => source
    [file.SourceText; ~] => sources!
    sources! -> push(source)
    sources! -> analysis.analyzeTestSources([Int; ~], [Int; ~]) => package
    package -> modules.identitiesAnalyzed => identities
    package -> modules.importsAnalyzed => imports
    TypeFieldContext { identities: identities, imports: imports, sourceModule: 0, ownerSymbol: 0 } => context
    plans.memberOriginal() => ruleOriginal
    context -> showMemberRule(package, ruleOriginal, "MemberOriginal", false)
    plans.memberReordered() => ruleReordered
    context -> showMemberRule(package, ruleReordered, "MemberReordered", false)
    plans.memberRelabeled() => ruleRelabeled
    context -> showMemberRule(package, ruleRelabeled, "MemberRelabeled", false)
    plans.memberUnavailable() => ruleUnavailable
    context -> showMemberRule(package, ruleUnavailable, "MemberUnavailable", true)
}
