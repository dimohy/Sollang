import std.archive.zip as zip_archive

run: -> Result<Unit, zip_archive.Error> {
    zip_archive.Limits { maxEncodedBytes: 128, maxDecodedBytes: 16, maxNameBytes: 16, maxExtraBytes: 4, maxCommentBytes: 4 } -> codec? => codec
    codec -> deflateDecoder(zip_archive.DeflateLimits { maxCompressedBytes: 16, maxExpansionRatio: 16, maxWorkUnits: 32 })? => decoder!
    [UInt8; ~] => output!
    decoder! -> finish(output!)? => first
    decoder! -> finish(output!)? => second
    Result<Unit, zip_archive.Error>.Ok
}

main {
    run() -> when { Ok(_) {} Err(_) {} }
}
