signed value: ref Int -> Bool {
    value < 0
}

unsigned value: ref UInt32 -> Bool {
    value > 2147483647
}

signedLoop value: ref Int -> Unit uses Console {
    0 => index!
    index! < 1 and value < 0 -> while {
        index! + 1 => index!
        index! -> println
    }
}

unsignedLoop value: ref UInt32 -> Unit uses Console {
    0 => index!
    index! < 1 and value > 2147483647 -> while {
        index! + 1 => index!
        index! -> println
    }
}

main {
    -1 => negative
    negative -> signed -> println
    UInt32(4294967295) => high
    high -> unsigned -> println
    negative -> signedLoop
    high -> unsignedLoop
}
