struct Values {
    number: Int
    caption: Text
}

number values: ref Values -> ref Int { values.number }
caption values: ref Values -> ref Text { values.caption }

show value: ref Int, text: ref Text -> Unit uses Console {
    true -> if {
        (value < 0) -> println
        (text == "ok") -> println
    }
}

main {
    Values { number: -7, caption: "ok" } => values
    values -> number => borrowedNumber
    values -> caption => borrowedCaption
    true -> if {
        (borrowedNumber < 0) -> println
        (borrowedCaption == "ok") -> println
    }
    borrowedNumber -> show(borrowedCaption)
}
