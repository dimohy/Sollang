struct Values {
    wide: UInt32
    decimal: Float64
}

wide values: ref Values -> ref UInt32 { values.wide }
decimal values: ref Values -> ref Float64 { values.decimal }

show value: ref UInt32, fraction: ref Float64 -> Unit uses Console {
    true -> if {
        (value > 2147483647) -> println
        (fraction > 0.0) -> println
    }
}

main {
    Values { wide: 4294967295, decimal: 1.0 } => values
    values -> wide => borrowedWide
    values -> decimal => borrowedDecimal
    (borrowedWide > 2147483647) -> println
    (borrowedDecimal > 0.0) -> println
    true -> if {
        (2147483647 < borrowedWide) -> println
        (0.0 < borrowedDecimal) -> println
    }
    borrowedWide -> show(borrowedDecimal)
}
