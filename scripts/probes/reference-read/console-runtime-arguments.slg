import sys.runtime as runtime

showSigned value: ref Int8 -> Unit uses Console {
    value -> println
}

showUnsigned value: ref UInt8 -> Unit uses Console {
    value -> println
}

showWide value: ref UInt32 -> Unit uses Console {
    value -> println
}

showBool value: ref Bool -> Unit uses Console {
    value -> println
}

showText value: ref Text -> Unit uses Console {
    value -> print
    value -> println
    value -> runtime.eprint
    value -> runtime.eprintln
}

showNested value: ref Int8, flag: ref Bool -> Unit uses Console {
    true -> if {
        value -> println
        flag -> println
    }
}

main {
    Int8(-7) => signed
    UInt8(255) => unsigned
    UInt32(4294967295) => wide
    true => flag
    "text" => label
    signed -> showSigned
    unsigned -> showUnsigned
    wide -> showWide
    flag -> showBool
    label -> showText
    signed -> showNested(flag)
}
