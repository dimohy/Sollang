textLoop value: ref Text -> Unit uses Console {
    0 => index!
    index! < 2 and value == "yes" -> while {
        index! + 1 => index!
        index! -> println
    }
}

intLoop value: ref Int -> Unit uses Console {
    0 => index!
    index! < 2 and value > 0 -> while {
        index! + 1 => index!
        index! -> println
    }
}

wideLoop ignored: Int, value: ref UInt32 -> Unit uses Console {
    0 => index!
    index! < 2 and 0 < value -> while {
        index! + 1 => index!
        index! -> println
    }
}

floatLoop value: ref Float64 -> Unit uses Console {
    0 => index!
    index! < 2 and value > 0.0 -> while {
        index! + 1 => index!
        index! -> println
    }
}

main {
    "yes" => text
    text -> textLoop
    42 => number
    number -> intLoop
    UInt32(42) => wide
    0 -> wideLoop(wide)
    Float64(42.0) => real
    real -> floatLoop
}
