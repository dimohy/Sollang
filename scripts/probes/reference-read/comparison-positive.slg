left value: ref Int -> Bool {
    value > 0
}

right value: ref Int -> Bool {
    0 < value
}

both first: ref Int, second: ref Int -> Bool {
    first == second
}

textEqual value: ref Text -> Bool {
    value == "yes"
}

main {
    42 => value
    value -> left -> println
    value -> right -> println
    value -> both(value) -> println
    "yes" => text
    text -> textEqual -> println
}
