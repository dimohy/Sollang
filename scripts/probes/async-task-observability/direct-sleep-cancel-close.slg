namespace probes.async_task_observability.direct_sleep_cancel_close

import std.async.diagnostics as diagnostics
import std.time as time

emptySnapshot: -> diagnostics.TaskSnapshot => diagnostics.TaskSnapshot {
    taskId: 0,
    parentTaskId: Option<UInt64>.None,
    lifecycle: diagnostics.Lifecycle.Pending,
    waitState: diagnostics.WaitState.None,
    awaitedTaskId: Option<UInt64>.None,
    timerDeadlineMillis: 0,
    suspension: Option<diagnostics.SuspensionLocator>.None
}

printLifecycle value: diagnostics.Lifecycle -> Unit uses Console {
    value -> when {
        diagnostics.Lifecycle.Pending { "Pending" -> println }
        diagnostics.Lifecycle.Running { "Running" -> println }
        diagnostics.Lifecycle.Completed { "Completed" -> println }
        diagnostics.Lifecycle.Cancelled { "Cancelled" -> println }
    }
}

printWaitState value: diagnostics.WaitState -> Unit uses Console {
    value -> when {
        diagnostics.WaitState.None { "None" -> println }
        diagnostics.WaitState.Ready { "Ready" -> println }
        diagnostics.WaitState.Timer { "Timer" -> println }
        diagnostics.WaitState.AwaitBlocked { "AwaitBlocked" -> println }
    }
}

public observe: -> async Unit uses Clock, Console {
    time.milliseconds(1000) -> when {
        Ok(delay) {
            diagnostics.startDiagnosticSession(diagnostics.DiagnosticLimits { maximumTrackedTasks: 1 }) -> when {
                Ok(session) {
                    session => active!
                    delay -> sleep => pending
                    active! -> track(pending) -> when {
                        Ok(tracked) {
                            tracked -> cancel
                            [emptySnapshot()] => output!
                            active! -> snapshot<1>(output!) => captured
                            output![0].lifecycle -> printLifecycle
                            output![0].waitState -> printWaitState
                            active! -> close -> when {
                                Ok(summary) { "close sessionId=$(summary.sessionId) trackedTasks=$(summary.trackedTasks) untrackedTasks=$(summary.untrackedTasks)" -> println }
                                Err(failure) { "close-error" -> println }
                            }
                        }
                        Err(failure) {
                            failure._0 -> cancel
                            active! -> close => recoveredClose
                            "track-error" -> println
                        }
                    }
                }
                Err(error) { "open-error" -> println }
            }
        }
        Err(error) { "duration-error" -> println }
    }
}

main {
    probes.async_task_observability.direct_sleep_cancel_close.observe() => observation
    observation -> await
}
