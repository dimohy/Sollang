namespace probes.async_task_observability.session_close_reuse

import std.async.diagnostics as diagnostics

public unit: -> async Unit {
    yield
    1 => completed
}

emptySnapshot: -> diagnostics.TaskSnapshot => diagnostics.TaskSnapshot {
    taskId: 0,
    parentTaskId: Option<UInt64>.None,
    lifecycle: diagnostics.Lifecycle.Pending,
    waitState: diagnostics.WaitState.None,
    awaitedTaskId: Option<UInt64>.None,
    timerDeadlineMillis: 0,
    suspension: Option<diagnostics.SuspensionLocator>.None
}

public observeSecond firstSummary: diagnostics.DiagnosticSummary -> async Unit uses Console {
    diagnostics.startDiagnosticSession(diagnostics.DiagnosticLimits { maximumTrackedTasks: 1 }) -> when {
        Ok(second) {
            second => active!
            probes.async_task_observability.session_close_reuse.unit() => pending
            active! -> track(pending) -> when {
                Ok(tracked) {
                    [emptySnapshot()] => output!
                    active! -> snapshot<1>(output!) => captured
                    "first sessionId=$(firstSummary.sessionId) trackedTasks=$(firstSummary.trackedTasks) untrackedTasks=$(firstSummary.untrackedTasks)" -> println
                    "second snapshot sessionId=$(captured.sessionId) taskId=$(output![0].taskId)" -> println
                    tracked -> await
                    active! -> close -> when {
                        Ok(summary) { "second close sessionId=$(summary.sessionId) trackedTasks=$(summary.trackedTasks) untrackedTasks=$(summary.untrackedTasks)" -> println }
                        Err(failure) { "second-close-error" -> println }
                    }
                }
                Err(failure) {
                    failure._0 -> await
                    active! -> close => recoveredClose
                    "second-track-error" -> println
                }
            }
        }
        Err(error) { "second-open-error" -> println }
    }
}

public observe: -> async Unit uses Console {
    diagnostics.startDiagnosticSession(diagnostics.DiagnosticLimits { maximumTrackedTasks: 1 }) -> when {
        Ok(first) {
            first => active!
            probes.async_task_observability.session_close_reuse.unit() => pending
            active! -> track(pending) -> when {
                Ok(tracked) {
                    active! -> close -> when {
                        Err(busy) {
                            "Busy" -> println
                            busy.session => retry
                            tracked -> await
                            retry -> close -> when {
                                Ok(firstSummary) {
                                    firstSummary -> probes.async_task_observability.session_close_reuse.observeSecond => secondObservation
                                    secondObservation -> await
                                }
                                Err(failure) { "first-close-error" -> println }
                            }
                        }
                        Ok(summary) {
                            tracked -> await
                            "unexpected-close" -> println
                        }
                    }
                }
                Err(failure) {
                    failure._0 -> await
                    active! -> close => recoveredClose
                    "first-track-error" -> println
                }
            }
        }
        Err(error) { "first-open-error" -> println }
    }
}

main {
    probes.async_task_observability.session_close_reuse.observe() => observation
    observation -> await
}
