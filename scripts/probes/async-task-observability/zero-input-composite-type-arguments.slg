number<T>: -> async Int {
    yield
    Option<T>.None => value
    value -> when {
        Some(item) { 1 }
        None { 7 }
    }
}

main {
    number<(Int, Bool)>() => integerTask
    integerTask -> await -> println
    number<Option<Int>>() => booleanTask
    booleanTask -> await -> println
}
