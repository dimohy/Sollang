namespace probes.async_task_observability.boolean_interpolated_await

child: -> async Bool {
    yield
    true
}

format<T>: -> async Unit uses Console {
    child() => task
    "bool=$(task -> await)" -> println
}

main {
    probes.async_task_observability.boolean_interpolated_await.format<Int>() => firstTask
    firstTask -> await
    probes.async_task_observability.boolean_interpolated_await.format<Bool>() => secondTask
    secondTask -> await
}
