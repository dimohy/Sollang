namespace probes.async_task_observability.close_busy_transactional

import std.async.diagnostics as diagnostics
import std.time as time

emptySnapshot: -> diagnostics.TaskSnapshot => diagnostics.TaskSnapshot {
    taskId: 0,
    parentTaskId: Option<UInt64>.None,
    lifecycle: diagnostics.Lifecycle.Pending,
    waitState: diagnostics.WaitState.None,
    awaitedTaskId: Option<UInt64>.None,
    timerDeadlineMillis: 0,
    suspension: Option<diagnostics.SuspensionLocator>.None
}

printLifecycle value: diagnostics.Lifecycle -> Unit uses Console {
    value -> when {
        diagnostics.Lifecycle.Pending { "Pending" -> println }
        diagnostics.Lifecycle.Running { "Running" -> println }
        diagnostics.Lifecycle.Completed { "Completed" -> println }
        diagnostics.Lifecycle.Cancelled { "Cancelled" -> println }
    }
}

public observe: -> async Unit uses Clock, Console {
    time.milliseconds(0) -> when {
        Ok(fastDelay) {
            time.milliseconds(1000) -> when {
                Ok(slowDelay) {
                    diagnostics.startDiagnosticSession(diagnostics.DiagnosticLimits { maximumTrackedTasks: 2 }) -> when {
                        Ok(session) {
                            session => active!
                            fastDelay -> sleep => fastPending
                            slowDelay -> sleep => slowPending
                            active! -> track(fastPending) -> when {
                                Ok(fast) {
                                    active! -> track(slowPending) -> when {
                                        Ok(slow) {
                                            yield
                                            active! -> close -> when {
                                                Err(busy) {
                                                    "Busy" -> println
                                                    busy.session => retry
                                                    [emptySnapshot(), emptySnapshot()] => before!
                                                    retry -> snapshot<2>(before!) => beforeResult
                                                    before![0].lifecycle -> printLifecycle
                                                    before![1].lifecycle -> printLifecycle
                                                    slow -> cancel
                                                    fast -> await
                                                    [emptySnapshot(), emptySnapshot()] => after!
                                                    retry -> snapshot<2>(after!) => afterResult
                                                    after![0].lifecycle -> printLifecycle
                                                    after![1].lifecycle -> printLifecycle
                                                    retry -> close -> when {
                                                        Ok(summary) { "close sessionId=$(summary.sessionId) trackedTasks=$(summary.trackedTasks) untrackedTasks=$(summary.untrackedTasks)" -> println }
                                                        Err(failure) { "close-error" -> println }
                                                    }
                                                }
                                                Ok(summary) {
                                                    slow -> cancel
                                                    fast -> await
                                                    "unexpected-close" -> println
                                                }
                                            }
                                        }
                                        Err(failure) {
                                            failure._0 -> cancel
                                            fast -> await
                                            active! -> close => recoveredClose
                                            "slow-track-error" -> println
                                        }
                                    }
                                }
                                Err(failure) {
                                    failure._0 -> await
                                    slowPending -> cancel
                                    active! -> close => recoveredClose
                                    "fast-track-error" -> println
                                }
                            }
                        }
                        Err(error) { "open-error" -> println }
                    }
                }
                Err(error) { "slow-duration-error" -> println }
            }
        }
        Err(error) { "fast-duration-error" -> println }
    }
}

main {
    probes.async_task_observability.close_busy_transactional.observe() => observation
    observation -> await
}
