namespace probes.async_task_observability.affine_copy_negative

import std.async.diagnostics as diagnostics

main {
    diagnostics.startDiagnosticSession(diagnostics.DiagnosticLimits { maximumTrackedTasks: 1 }) => opened
    opened -> when {
        Result<diagnostics.DiagnosticSession, diagnostics.DiagnosticError>.Ok(session) {
            session => copied
            session -> println
            copied -> println
        }
        Result<diagnostics.DiagnosticSession, diagnostics.DiagnosticError>.Err(error) { "open-error" -> println }
    }
}
