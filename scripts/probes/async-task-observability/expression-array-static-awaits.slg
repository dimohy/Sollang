child value: Int -> async Int {
    yield
    value
}

calculate<T>: -> async Unit uses Console {
    child(7) => first
    child(9) => second
    [first -> await, second -> await] => values
    "array=$(values[0]),$(values[1])" -> println
}

main {
    calculate<Int>() => one
    one -> await
    calculate<Bool>() => two
    two -> await
}
