# Renaming the generic method separates readonly-view inference from count's
# builtin-name collision without changing the owner or argument shapes.
struct Ordering { }
impl Ordering {
    measure<T>: self, values: [T] -> Int => values -> len
}

main {
    [1, 2; ~] => numbers
    ["one", "two"] => words
    Ordering { } -> measure(numbers) -> println
    Ordering { } -> measure(words) -> println
}
