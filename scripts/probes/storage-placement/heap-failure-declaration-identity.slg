namespace allocation_probe

plain value: Int -> Int {
    (value > 0 -> if { value } else { 0 }) => seed
    [seed; 1201] => values
    values[1200]
}

many<N> value: Int -> Int where N: Int {
    [value; N] => values
    values[0]
}

main {
    7 -> plain -> println
    9 -> many<1203> -> println
    [3; 1202] => local
    local[1201] -> println
}
