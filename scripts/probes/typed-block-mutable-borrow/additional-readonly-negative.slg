struct Algorithms { }

impl Algorithms {
    exchangeReadonly<T>: self, values: [T; ~] -> Int block item: ref T -> Bool {
        values[0] -> yield => selected
        selected -> if { values -> exchange(0, 0) }
        values -> len
    }
}

main {
    Algorithms { } => algorithms
    [7; ~] => values!
    algorithms -> exchangeReadonly(values!) item {
        item == 0
    } => count
    count -> println
}
