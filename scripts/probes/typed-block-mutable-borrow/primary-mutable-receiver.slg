struct Bucket {
    values: [Int; ~]
}

impl Bucket {
    exchangePrimary<T>: mut self, marker: T -> Int block item: ref Int -> Bool {
        self.values[0] -> yield => selected
        selected -> if { self.values -> exchange(0, 0) }
        self.values -> len
    }
}

main {
    Bucket { values: [7; ~] } => bucket!
    bucket! -> exchangePrimary(0) item {
        item == 0
    } => count
    count -> println
}
