struct Algorithms { }

impl Algorithms {
    exchangeAdditional<T>: self, values: mut [T; ~] -> Int block item: ref T -> Bool {
        values[0] -> yield => selected
        selected -> if { values -> exchange(0, 0) }
        values -> len
    }
}

main {
    Algorithms { } => algorithms
    [7; ~] => values!
    algorithms -> exchangeAdditional(values!) item {
        item == 0
    } => count
    count -> println
}
