import std.crypto.random as random

copy32 bytes: [UInt8] -> [UInt8; 32] {
    [UInt8(0); 32] => copied!
    0 => index!
    index! < 32 -> while {
        bytes[index!] => copied![index!]
        index! + 1 => index!
    }
    copied!
}

random32: -> Result<[UInt8; 32], random.Error> uses Random {
    random.secure() -> bytes(32) -> when {
        Ok(bytes) { Result<[UInt8; 32], random.Error>.Ok(copy32(bytes)) }
        Err(error) { Result<[UInt8; 32], random.Error>.Err(error) }
    }
}

main {
    random32() -> when {
        Ok(bytes) { "random=$(bytes -> len)" -> println }
        Err(error) { "random-error" -> println }
    }
}
