import std.net.quic.keys
import std.net.quic.error as errors
import std.net.quic.version_negotiation as negotiation

decodeVersionInBranch: -> Result<Bool, errors.Error> {
    negotiation.Information {
        chosen: keys.version1()
        available: [keys.version1(), keys.version2(); ~]
    } -> encode? => encoded
    false => valid!
    negotiation.parameterId() -> when {
        == negotiation.parameterId() {
            negotiation.decode(encoded)? => information
            information -> validateClient?
            true => valid!
        }
        else { }
    }
    Result<Bool, errors.Error>.Ok(valid!)
}

main {
    decodeVersionInBranch() -> when {
        Ok(valid) { "version-valid=$valid" -> println }
        Err(error) { "version-error=$(error.code)" -> println }
    }
}
