struct Counter { value: Int }

impl Counter {
    increase: mut self, amount: Int -> Int {
        self.value + amount => self.value
        self.value
    }
}

update counter: mut Counter -> Int {
    counter.increase(2)
}

main {
    Counter { value: 40 } => counter!
    counter! -> update -> println
    counter!.value -> println
}
