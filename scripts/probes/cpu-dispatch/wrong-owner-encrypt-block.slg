namespace std.crypto.aes128

public encryptBlock left: Int, right: Int -> Int {
    left + right
}

struct OtherKey {
    offset: Int
}

impl OtherKey {
    encryptBlock: self, value: Int -> Int {
        self.offset + value
    }
}

main {
    encryptBlock(20, 22) -> println
    OtherKey { offset: 1 } -> encryptBlock(42) -> println
}
