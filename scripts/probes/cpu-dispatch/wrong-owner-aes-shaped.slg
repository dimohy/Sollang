namespace std.crypto.aes128

import std.crypto.aes128 as aes128

public encryptBlock key: Key, input: [UInt8; 16] -> [UInt8; 16] {
    [1; 16]
}

struct OtherKey {
    marker: Int
}

impl OtherKey {
    encryptBlock: self, input: [UInt8; 16] -> [UInt8; 16] {
        [2; 16]
    }
}

controlBlock: -> [UInt8; 16] => [0; 16]

main {
    controlBlock() => bytes
    bytes -> aes128.prepare => key
    encryptBlock(key, bytes) => globalResult
    globalResult[0] -> println
    OtherKey { marker: 7 } -> encryptBlock(bytes) => otherResult
    otherResult[0] -> println
}
