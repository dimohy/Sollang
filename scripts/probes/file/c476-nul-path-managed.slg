import sys.file as file
import sys.path as path

main {
    path.fromBytes([120, 0, 115; ~], path.Style.Windows) -> when {
        Ok(rawPath) {
            rawPath -> pathText => nulPath
            nulPath -> len => length
            nulPath -> byte(1) => middle
            length == 3 and middle == 0 -> if {
                nulPath -> file.createExclusive => rejectedCreate
                "x" -> file.createExclusive => created
                nulPath -> file.removePath => rejectedRemove
                "x" -> file.createExclusive => stillExists
                "x" -> file.removePath => removed
                "$rejectedCreate/$created/$rejectedRemove/$stillExists/$removed" -> println
            } else {
                "invalid test input" -> println
            }
        }
        Err(_) { "path construction failed" -> println }
    }
}
