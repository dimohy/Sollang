import sys.file as file

main {
    "artifacts/scratch/c476-managed-file-intrinsics-20260924-01/created.txt" => path
    "artifacts/scratch/c476-managed-file-intrinsics-20260924-01" => directory
    path -> file.createExclusive => created
    path -> file.createExclusive => existing
    path -> file.removePath => removed
    path -> file.removePath => missing
    directory -> file.removePath => directoryRejected
    "$created/$existing/$removed/$missing/$directoryRejected" -> println
}
