import sollang.compiler.llvm.text as llvm
import sollang.compiler.syntax.source_decoding as sourceDecoding
import sys.file as file

report sources: move [Text; ~], label: Text, expected: Int -> Unit uses Console {
    sources -> llvm.probeInterpolationDiagnosticAggregate(label, expected) => count
    "$label=$count" -> println
}

main {
    "scripts/probes/diagnostic-aggregation/interpolation2.slg" -> file.mapText => first
    "scripts/probes/diagnostic-aggregation/interpolation64.slg" -> file.mapText => second
    "scripts/probes/diagnostic-aggregation/borrowed-control.slg" -> file.mapText => third
    [first, second, third] => owners
    [owners[0] -> sourceDecoding.utf8Text; ~] -> report("interpolation2", 0)
    [owners[1] -> sourceDecoding.utf8Text; ~] -> report("interpolation64", 0)
    [owners[2] -> sourceDecoding.utf8Text; ~] -> report("borrowed-control", 1)
    owners -> len => ownerCount
    "owners=$ownerCount" -> println
}
