main {
    Set<UIntSize>(4) => offsets!
    offsets! -> insert(UIntSize(7)) => first
    offsets! -> insert(UIntSize(2)) => outer
    offsets! -> insert(UIntSize(7)) => duplicate
    offsets! -> contains(UIntSize(2)) => found
    offsets! -> contains(UIntSize(9)) => absent
    "first=$first,outer=$outer,duplicate=$duplicate,found=$found,absent=$absent" -> println
}
