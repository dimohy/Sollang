struct State { declarations: [Int; ~], storage: [Int; ~], boxes: [Int; ~], used: [Int; ~] }
refresh state: move State -> Result<State, Int> {
    Result<[Int; ~], Int>.Ok([7,; ~]) -> when {
        Err(error) { Result<State, Int>.Err(error) }
        Ok(used) {
            State { declarations: state.declarations, storage: state.storage, boxes: state.boxes, used: used } => result
            Result<State, Int>.Ok(result)
        }
    }
}
main {
    State { declarations: [1,; ~], storage: [2,; ~], boxes: [3,; ~], used: [4,; ~] } -> refresh -> when {
        Err(_) { "error" -> println }
        Ok(state) { state.used[0] -> println }
    }
}
