namespace cache.prepared_registry

struct Used { value: Int }
struct Empty { }
struct Other { flag: Bool }
enum Unused { First, Second }
trait Value { get: self -> Int }
public inspect value: ref Used, boxed: box Int, fixed: [Int; 3], growable: [Int; ~], mapped: {Int: Bool}, dynamic: dyn Value -> Unit { }

struct Storage { numbers: [UInt32; ~], values: [Used; ~] }
word: -> UInt32 => 42
emptyBytes: -> [UInt8] => []
emptyResult: -> Result<[UInt8; ~], Text> => Result<[UInt8; ~], Text>.Ok([])

main {
    Storage { numbers: [word(), word()], values: [] } => storage
    storage.numbers[0] -> println
    storage.values -> len -> println
    emptyBytes() -> len -> println
    emptyResult() -> when {
        Ok(values) { values -> len -> println }
        Err(error) { error -> println }
    }
}
