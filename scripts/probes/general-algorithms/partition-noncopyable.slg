import std.algorithm as algorithm

struct OwnedEntry { key: Int, payload: box Int }

main {
    algorithm.Algorithms { } => algorithms
    [OwnedEntry;
    { key: -1, payload: box 10 },
    { key: 2, payload: box 20 },
    { key: -3, payload: box 30 },
    { key: 4, payload: box 40 };
    ~
    ] => values!
    values! -> capacity => originalCapacity
    0 => calls!
    0 => order!
    algorithms -> partitionInPlace(values!) item {
        calls! + 1 => calls!
        order! * 10 + item.key => order!
        item.key > 0
    } => boundary
    "boundary=$boundary,calls=$(calls!),order=$(order!),len=$((values! -> len) == 4),capacity=$((values! -> capacity) == originalCapacity)" -> println
    values! -> each item { item.key -> println }
}
