struct OwnedEntry { key: Int, payload: box Int }

manualExchange<T> values: mut [T; ~], left: Int, right: Int -> Unit {
    values[left] => previous
    values[right] => values[left]
    previous => values[right]
}

main {
    [OwnedEntry;
    { key: 11, payload: box 101 },
    { key: 22, payload: box 202 };
    ~
    ] => values!
    values! -> manualExchange(0, 1)
}
