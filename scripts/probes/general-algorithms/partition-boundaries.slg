import std.algorithm as algorithm

main {
    algorithm.Algorithms { } => algorithms

    [Int; ~] => empty!
    empty! -> capacity => emptyCapacity
    0 => emptyCalls!
    algorithms -> partitionInPlace(empty!) item {
        emptyCalls! + 1 => emptyCalls!
        item % 2 == 0
    } => emptyBoundary
    "empty=$emptyBoundary,$(emptyCalls!),$((empty! -> len) == 0),$((empty! -> capacity) == emptyCapacity)" -> println

    [2, 4, 6; ~] => allTrue!
    allTrue! -> capacity => allTrueCapacity
    0 => allTrueCalls!
    0 => allTrueOrder!
    algorithms -> partitionInPlace(allTrue!) item {
        allTrueCalls! + 1 => allTrueCalls!
        allTrueOrder! * 10 + item => allTrueOrder!
        item % 2 == 0
    } => allTrueBoundary
    "all-true=$allTrueBoundary,$(allTrueCalls!),$(allTrueOrder!),$((allTrue! -> len) == 3),$((allTrue! -> capacity) == allTrueCapacity)" -> println
    allTrue! -> each item { item -> println }

    [1, 3, 5; ~] => allFalse!
    allFalse! -> capacity => allFalseCapacity
    0 => allFalseCalls!
    0 => allFalseOrder!
    algorithms -> partitionInPlace(allFalse!) item {
        allFalseCalls! + 1 => allFalseCalls!
        allFalseOrder! * 10 + item => allFalseOrder!
        item % 2 == 0
    } => allFalseBoundary
    "all-false=$allFalseBoundary,$(allFalseCalls!),$(allFalseOrder!),$((allFalse! -> len) == 3),$((allFalse! -> capacity) == allFalseCapacity)" -> println
    allFalse! -> each item { item -> println }

    [1, 2, 3, 4, 5, 6; ~] => mixed!
    mixed! -> capacity => mixedCapacity
    0 => mixedCalls!
    0 => mixedOrder!
    algorithms -> partitionInPlace(mixed!) item {
        mixedCalls! + 1 => mixedCalls!
        mixedOrder! * 10 + item => mixedOrder!
        item % 2 == 0
    } => mixedBoundary
    "mixed=$mixedBoundary,$(mixedCalls!),$(mixedOrder!),$((mixed! -> len) == 6),$((mixed! -> capacity) == mixedCapacity)" -> println
    mixed! -> each item { item -> println }
}
