struct NestedOwner { value: box Int }
struct OwnedEntry { key: Int, payload: box NestedOwner }

main {
    [OwnedEntry;
    { key: 11, payload: box NestedOwner { value: box 101 } },
    { key: 22, payload: box NestedOwner { value: box 202 } },
    { key: 33, payload: box NestedOwner { value: box 303 } };
    ~
    ] => values!
    values! -> len => originalLength
    values! -> capacity => originalCapacity

    values! -> exchange(0, 2)
    "distinct=$(values![0].key),$(values![1].key),$(values![2].key)" -> println

    values! -> exchange(1, 1)
    "same=$(values![0].key),$(values![1].key),$(values![2].key)" -> println

    values! -> len => finalLength
    values! -> capacity => finalCapacity
    finalLength == originalLength => lengthPreserved
    finalCapacity == originalCapacity => capacityPreserved
    "storage=$lengthPreserved,$capacityPreserved" -> println
}
