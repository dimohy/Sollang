import std.algorithm as algorithm

struct OwnedEntry { key: Int, payload: box Int }

main {
    algorithm.Algorithms { } => algorithms
    [OwnedEntry;
    { key: 1, payload: box 10 },
    { key: 2, payload: box 20 },
    { key: 3, payload: box 30 },
    { key: 10, payload: box 40 },
    { key: 11, payload: box 50 };
    ~
    ] => values!
    values! -> len => length
    values! -> capacity => capacity
    algorithms -> partitionPoint(values!) item { item.key < 10 } => boundary
    values! -> take(0) => retained
    "boundary=$boundary,len=$length,capacity=$capacity,retained=$(retained.key)" -> println
}
