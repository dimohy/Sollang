import std.algorithm as algorithm

main {
    algorithm.Algorithms { } => algorithms

    algorithms -> partitionPoint([Int; ~]) item { item < 10 } => emptyBoundary
    "empty=$emptyBoundary" -> println

    [10] => singleFalse
    algorithms -> partitionPoint(singleFalse) item { item < 10 } => singleFalseBoundary
    "single-false=$singleFalseBoundary" -> println

    [9] => singleTrue
    algorithms -> partitionPoint(singleTrue) item { item < 10 } => singleTrueBoundary
    "single-true=$singleTrueBoundary" -> println

    [10, 11, 12, 13] => allFalse
    algorithms -> partitionPoint(allFalse) item { item < 10 } => allFalseBoundary
    "all-false=$allFalseBoundary" -> println

    [1, 2, 3, 4] => allTrue
    algorithms -> partitionPoint(allTrue) item { item < 10 } => allTrueBoundary
    "all-true=$allTrueBoundary" -> println

    [1, 2, 3, 10, 11, 12] => mixed
    algorithms -> partitionPoint(mixed) item { item < 10 } => mixedBoundary
    "mixed=$mixedBoundary" -> println
}
