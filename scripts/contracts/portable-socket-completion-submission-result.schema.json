{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "completed", "total", "compilerSha256", "inputStable", "inputDrift", "formatExitCode", "compileExitCode", "warningCount", "noteCount", "nativeExitCode", "llvmAsExitCode", "directCallClosureExitCode", "pendingCompileExitCode", "pendingNativeExitCode", "pendingLlvmAsExitCode", "pendingDirectCallClosureExitCode", "pendingStdout", "peerConnectedAt", "readyObservedAt", "peerActivityAt", "pendingProcessExitedAt", "baselineThreadCount", "pendingThreadCount", "waiterThreadDelta", "waiterThreadCallSites", "orphanProcessIds", "payloadCopyFree", "dequeueOwnerTransferVerified", "waiterJoinedBeforeExit", "closeCallSites", "stdout", "llvmSha256", "pendingLlvmSha256", "inputHashes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["passed", "failed"] },
    "completed": { "type": "integer", "minimum": 0, "maximum": 1 },
    "total": { "const": 1 },
    "compilerSha256": { "pattern": "^[A-F0-9]{64}$" },
    "inputStable": { "type": "boolean" },
    "inputDrift": { "type": "array", "items": { "type": "string" } },
    "compileExitCode": { "type": "integer" },
    "formatExitCode": { "type": "integer" },
    "warningCount": { "type": "integer", "minimum": 0 },
    "noteCount": { "type": "integer", "minimum": 0 },
    "nativeExitCode": { "type": "integer" },
    "llvmAsExitCode": { "type": "integer" },
    "directCallClosureExitCode": { "type": "integer" },
    "pendingCompileExitCode": { "type": "integer" },
    "pendingNativeExitCode": { "type": "integer" },
    "pendingLlvmAsExitCode": { "type": "integer" },
    "pendingDirectCallClosureExitCode": { "type": "integer" },
    "pendingStdout": { "type": "array", "items": { "type": "string" } },
    "peerConnectedAt": { "type": "string", "format": "date-time" },
    "readyObservedAt": { "type": "string", "format": "date-time" },
    "peerActivityAt": { "type": "string", "format": "date-time" },
    "pendingProcessExitedAt": { "type": "string", "format": "date-time" },
    "baselineThreadCount": { "type": "integer", "minimum": 1 },
    "pendingThreadCount": { "type": "integer", "minimum": 2 },
    "waiterThreadDelta": { "const": 1 },
    "waiterThreadCallSites": { "type": "integer" },
    "orphanProcessIds": { "type": "array", "items": { "type": "integer" } },
    "payloadCopyFree": { "type": "boolean" },
    "dequeueOwnerTransferVerified": { "type": "boolean" },
    "waiterJoinedBeforeExit": { "type": "boolean" },
    "closeCallSites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cancelIoEx", "stopPacket", "waiterJoin", "retainedBufferFree", "socketClose", "waiterHandleClose", "completionPortClose"],
      "properties": {
        "cancelIoEx": { "type": "integer" },
        "stopPacket": { "type": "integer" },
        "waiterJoin": { "type": "integer" },
        "retainedBufferFree": { "type": "integer" },
        "socketClose": { "type": "integer" },
        "waiterHandleClose": { "type": "integer" },
        "completionPortClose": { "type": "integer" }
      }
    },
    "stdout": { "type": "array", "items": { "type": "string" } },
    "llvmSha256": { "pattern": "^[A-F0-9]{64}$" },
    "pendingLlvmSha256": { "pattern": "^[A-F0-9]{64}$" },
    "inputHashes": { "type": "object", "minProperties": 10, "additionalProperties": { "pattern": "^[A-F0-9]{64}$" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } } },
      "then": {
        "properties": {
          "completed": { "const": 1 },
          "inputStable": { "const": true },
          "inputDrift": { "maxItems": 0 },
          "compileExitCode": { "const": 0 },
          "formatExitCode": { "const": 0 },
          "warningCount": { "const": 0 },
          "noteCount": { "const": 0 },
          "nativeExitCode": { "const": 0 },
          "llvmAsExitCode": { "const": 0 },
          "directCallClosureExitCode": { "const": 0 }
          ,"pendingCompileExitCode": { "const": 0 }
          ,"pendingNativeExitCode": { "const": 0 }
          ,"pendingLlvmAsExitCode": { "const": 0 }
          ,"pendingDirectCallClosureExitCode": { "const": 0 }
          ,"waiterThreadCallSites": { "const": 1 }
          ,"orphanProcessIds": { "maxItems": 0 }
          ,"payloadCopyFree": { "const": true }
          ,"dequeueOwnerTransferVerified": { "const": true }
          ,"waiterJoinedBeforeExit": { "const": true }
          ,"closeCallSites": {
            "properties": {
              "cancelIoEx": { "const": 1 },
              "stopPacket": { "const": 1 },
              "waiterJoin": { "const": 1 },
              "retainedBufferFree": { "const": 1 },
              "socketClose": { "const": 1 },
              "waiterHandleClose": { "const": 1 },
              "completionPortClose": { "const": 1 }
            }
          }
        }
      }
    }
  ]
}
