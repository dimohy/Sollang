{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "defect",
    "fixture",
    "managedRuntime",
    "selfhostRuntime",
    "hosts",
    "monotonicImport",
    "wallImport",
    "officialReferences",
    "invariants"
  ],
  "properties": {
    "$schema": { "const": "browser-time-domain.schema.json" },
    "version": { "const": 1 },
    "defect": { "const": "C2026-09-03-248" },
    "fixture": { "const": "1390-browser-time-domain-separation" },
    "managedRuntime": { "const": "src/Sollang.Compiler/CodeGen/WasmBrowserLlvmRuntimePlatform.cs" },
    "selfhostRuntime": { "const": "selfhost/llvm/emitter/text_output_runtime.slg" },
    "hosts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 5 }
    },
    "monotonicImport": { "const": "sollang_browser_now_millis" },
    "wallImport": { "const": "sollang_browser_utc_now_millis" },
    "officialReferences": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri" }
    },
    "invariants": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 12 }
    }
  }
}
