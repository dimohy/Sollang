{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "hostTarget",
    "verificationTarget",
    "optimization",
    "seedMode",
    "generatedByCompilerFingerprint",
    "sourceFingerprint",
    "compilerPath",
    "compilerFingerprint",
    "llvmPath",
    "llvmFingerprint",
    "focusedExecutionVerified",
    "managedDifferential"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "const": "verified-selfhost-stage1-generation" },
    "hostTarget": { "const": "windows" },
    "verificationTarget": { "enum": ["windows", "linux"] },
    "optimization": { "enum": ["O0", "O1"] },
    "seedMode": { "enum": ["Slg", "ManagedRecovery"] },
    "generatedByCompilerFingerprint": { "$ref": "#/$defs/sha256" },
    "sourceFingerprint": { "$ref": "#/$defs/sha256" },
    "compilerPath": { "type": "string", "minLength": 1 },
    "compilerFingerprint": { "$ref": "#/$defs/sha256" },
    "llvmPath": { "type": "string", "minLength": 1 },
    "llvmFingerprint": { "$ref": "#/$defs/sha256" },
    "focusedExecutionVerified": { "const": true },
    "managedDifferential": { "type": "boolean" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
  }
}
