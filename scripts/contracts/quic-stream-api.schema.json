{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sollang QUIC stream API contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "module",
    "authorities",
    "numericLimits",
    "frameExhaustiveConsumerFixtures",
    "publicSurface",
    "invariants",
    "verificationMatrix",
    "implementationSlices",
    "knownGaps"
  ],
  "properties": {
    "$schema": { "const": "quic-stream-api.schema.json" },
    "schemaVersion": { "const": 1 },
    "module": { "const": "std.net.quic" },
    "authorities": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "appliesTo"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "appliesTo": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "numericLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumStreamCountInclusive", "maximumStreamIdInclusive", "maximumStreamOffsetInclusive"],
      "properties": {
        "maximumStreamCountInclusive": { "const": 1152921504606846976 },
        "maximumStreamIdInclusive": { "const": 4611686018427387903 },
        "maximumStreamOffsetInclusive": { "const": 4611686018427387903 }
      }
    },
    "frameExhaustiveConsumerFixtures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]+-[a-z0-9-]+$" }
    },
    "publicSurface": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "member", "receiver", "result", "semantics"],
        "properties": {
          "owner": { "enum": ["StreamCount", "Endpoint", "ConnectionOptions", "Connection", "BiStream", "SendStream", "ReceiveStream"] },
          "member": { "type": "string", "minLength": 1 },
          "receiver": { "enum": ["self", "mut self", "move self"] },
          "result": { "type": "string", "minLength": 1 },
          "semantics": { "type": "string", "minLength": 1 }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rule", "proof"],
        "properties": {
          "id": { "type": "string", "pattern": "^QUIC-STREAM-[0-9]{3}$" },
          "rule": { "type": "string", "minLength": 1 },
          "proof": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verificationMatrix": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "targets", "proves", "scenario", "expected"],
        "properties": {
          "id": { "type": "string", "pattern": "^QSF[0-9]{3}$" },
          "kind": { "enum": ["positive", "negative", "boundary", "integration", "structural"] },
          "targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["managed", "windows-stage2", "windows-stage3", "linux-stage2", "linux-stage3", "browser"] }
          },
          "proves": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^QUIC-STREAM-[0-9]{3}$" }
          },
          "scenario": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 }
        }
      }
    },
    "implementationSlices": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "dependsOn", "files", "scope", "gate"],
        "properties": {
          "id": { "type": "string", "pattern": "^QS[0-9]+$" },
          "status": { "enum": ["implemented", "partial", "pending", "blocked"] },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^QS[0-9]+$" }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "scope": { "type": "string", "minLength": 1 },
          "gate": { "type": "string", "minLength": 1 }
        }
      }
    },
    "knownGaps": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "current", "required"],
        "properties": {
          "id": { "type": "string", "pattern": "^QG[0-9]+$" },
          "source": { "type": "string", "minLength": 1 },
          "current": { "type": "string", "minLength": 1 },
          "required": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
