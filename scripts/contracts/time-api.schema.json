{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "module",
    "runtimeModule",
    "officialReferences",
    "implementedSurfaces",
    "invariants",
    "orderedSlices",
    "calendarFormatting",
    "targetPolicy"
  ],
  "properties": {
    "$schema": { "const": "time-api.schema.json" },
    "version": { "const": 1 },
    "module": { "const": "std.time" },
    "runtimeModule": { "const": "sys.runtime" },
    "officialReferences": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri" }
    },
    "implementedSurfaces": {
      "type": "array",
      "minItems": 14,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "invariants": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 12 }
    },
    "orderedSlices": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/slice" }
    },
    "calendarFormatting": { "$ref": "#/$defs/calendarFormatting" },
    "targetPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows-x64", "linux-x64", "wasm32-browser"],
      "properties": {
        "windows-x64": { "type": "string", "minLength": 12 },
        "linux-x64": { "type": "string", "minLength": 12 },
        "wasm32-browser": { "type": "string", "minLength": 12 }
      }
    }
  },
  "$defs": {
    "calendarFormatting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "surface",
        "format",
        "outputBytes",
        "outputOwnership",
        "minimumUnixMillis",
        "maximumUnixMillis",
        "errorKinds",
        "fixture"
      ],
      "properties": {
        "status": { "enum": ["in-progress", "complete"] },
        "surface": { "const": "UtcInstant.formatRfc3339" },
        "format": { "const": "YYYY-MM-DDTHH:mm:ss.SSSZ" },
        "outputBytes": { "const": 24 },
        "outputOwnership": { "const": "caller-owned mutable byte array" },
        "minimumUnixMillis": { "const": -62135596800000 },
        "maximumUnixMillis": { "const": 253402300799999 },
        "errorKinds": {
          "const": ["CalendarOutOfRange", "InsufficientOutput"]
        },
        "fixture": { "const": "1711-time-rfc3339-calendar-format" }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^T[1-6]$" },
        "status": { "enum": ["pending", "in-progress", "complete"] },
        "title": { "type": "string", "minLength": 5 },
        "requiredSurfaces": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "requiredConsumers": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        }
      },
      "oneOf": [
        { "required": ["requiredSurfaces"] },
        { "required": ["requiredConsumers"] }
      ]
    }
  }
}
