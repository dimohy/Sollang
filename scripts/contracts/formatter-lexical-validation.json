{
  "schemaVersion": 1,
  "scope": "Existing lexical diagnostic families and lexer-before-parser priority retain their original source owner through formatting.",
  "cases": [
    {
      "id": "unclosed-string",
      "mode": "format-stdin",
      "source": "\"open",
      "expected": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "sollang: lex error at 1:1: unterminated string literal\n"
      }
    },
    {
      "id": "unclosed-raw",
      "mode": "format-stdin",
      "source": "\"\"\"open",
      "expected": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "sollang: lex error at 1:1: unterminated raw string literal\n"
      }
    },
    {
      "id": "invalid-character",
      "mode": "format-stdin",
      "source": "'ab'",
      "expected": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "sollang: lex error at 1:1: character literal must contain one Unicode scalar\n"
      }
    },
    {
      "id": "unclosed-character",
      "mode": "format-stdin",
      "source": "'a",
      "expected": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "sollang: lex error at 1:1: unterminated character literal\n"
      }
    },
    {
      "id": "lex-before-parse",
      "mode": "format-stdin",
      "source": "main {\n    =>\n}\n\u0000",
      "expected": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "sollang: lex error at 4:1: unexpected character '\u0000'\n"
      }
    },
    {
      "id": "string-before-parse",
      "mode": "format-stdin",
      "source": "main {\n    =>\n}\n\"open",
      "expected": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "sollang: lex error at 4:1: unterminated string literal\n"
      }
    }
  ]
}
