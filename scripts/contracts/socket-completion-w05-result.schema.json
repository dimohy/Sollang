{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "status", "compilerSha256", "inputStable", "inputDrift", "inputHashes", "formatExitCode", "compileExitCode", "compileDiagnosticsClean", "nativeExitCode", "llvmAsExitCode", "closureExitCode", "stdout", "orphanProcessIds", "irAssertions", "failureIds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "const": "W05" },
    "status": { "enum": ["passed", "failed"] },
    "compilerSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "inputStable": { "type": "boolean" },
    "inputDrift": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "inputHashes": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
    },
    "formatExitCode": { "type": ["integer", "null"] },
    "compileExitCode": { "type": ["integer", "null"] },
    "compileDiagnosticsClean": { "type": "boolean" },
    "nativeExitCode": { "type": ["integer", "null"] },
    "llvmAsExitCode": { "type": ["integer", "null"] },
    "closureExitCode": { "type": ["integer", "null"] },
    "stdout": { "type": "array", "items": { "type": "string" } },
    "orphanProcessIds": { "type": "array", "maxItems": 0, "items": { "type": "integer" } },
    "irAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlappedResultCallCount", "waiterReadsExactWsaError", "dequeueMapsSocketErrorKind", "payloadCopyFree", "dequeueOwnerTransferVerified"],
      "properties": {
        "overlappedResultCallCount": { "type": "integer" },
        "waiterReadsExactWsaError": { "type": "boolean" },
        "dequeueMapsSocketErrorKind": { "type": "boolean" },
        "payloadCopyFree": { "type": "boolean" },
        "dequeueOwnerTransferVerified": { "type": "boolean" }
      }
    },
    "failureIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  },
  "allOf": [{
    "if": { "properties": { "status": { "const": "passed" } } },
    "then": {
      "properties": {
        "inputStable": { "const": true },
        "inputDrift": { "maxItems": 0 },
        "formatExitCode": { "const": 0 },
        "compileExitCode": { "const": 0 },
        "compileDiagnosticsClean": { "const": true },
        "nativeExitCode": { "const": 0 },
        "llvmAsExitCode": { "const": 0 },
        "closureExitCode": { "const": 0 },
        "stdout": { "const": ["pending=true", "failed=true,reset=true,code=10054,state=true,count=0,len=3,unchanged=true"] },
        "irAssertions": {
          "properties": {
            "overlappedResultCallCount": { "const": 1 },
            "waiterReadsExactWsaError": { "const": true },
            "dequeueMapsSocketErrorKind": { "const": true },
            "payloadCopyFree": { "const": true },
            "dequeueOwnerTransferVerified": { "const": true }
          }
        },
        "failureIds": { "maxItems": 0 }
      }
    }
  }]
}
