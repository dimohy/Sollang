{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "module",
    "fixture",
    "profile",
    "limits",
    "ownership",
    "errorKinds",
    "referenceCaseCount",
    "boundaryLineCount",
    "referenceCases",
    "boundaryLines",
    "acceptance"
  ],
  "properties": {
    "$schema": {
      "const": "text-glob.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "module": {
      "const": "std.text.glob"
    },
    "fixture": {
      "const": "1728-glob-bounded-pattern"
    },
    "profile": {
      "const": {
        "matching": "whole-text-case-sensitive",
        "wildcardUnit": "unicode-scalar",
        "star": "zero-or-more-scalars",
        "question": "one-scalar",
        "escapes": [
          "*",
          "?",
          "\\"
        ],
        "otherCharacters": "literal-including-separators-dot-newline-nul-brackets-braces",
        "normalization": false,
        "filesystem": false
      }
    },
    "limits": {
      "const": {
        "maxPatternBytes": 256,
        "maxInputBytes": 256,
        "maxSteps": 4096,
        "negative": "InvalidLimits",
        "zero": "real-ceiling",
        "step": "one-state-transition-including-terminal-decision",
        "constructorPrecedence": [
          "InvalidLimits",
          "PatternLimit",
          "InvalidEscape"
        ],
        "matchPrecedence": [
          "InputLimit",
          "WorkLimit"
        ]
      }
    },
    "ownership": {
      "const": "Pattern borrows source owner; matches borrows input only for call; no state mutation or allocation"
    },
    "errorKinds": {
      "const": [
        "InvalidLimits",
        "PatternLimit",
        "InputLimit",
        "InvalidEscape",
        "WorkLimit"
      ]
    },
    "referenceCaseCount": {
      "const": 29
    },
    "boundaryLineCount": {
      "const": 27
    },
    "referenceCases": {
      "type": "array",
      "minItems": 29,
      "maxItems": 29,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "pattern",
          "input",
          "match"
        ],
        "properties": {
          "label": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "pattern": {
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "match": {
            "type": "boolean"
          }
        }
      }
    },
    "boundaryLines": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "const": {
        "native": "current-managed-dll-windows-exact",
        "reference": "independent-dotnet-unicode-rune-dynamic-programming",
        "allocation": "whole-std.text.glob-reachable-direct-call-graph",
        "promotion": "selfhost-and-Stage-deferred"
      }
    }
  }
