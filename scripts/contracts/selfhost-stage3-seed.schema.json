{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "producer",
    "optimization",
    "target",
    "seedPath",
    "seedFingerprint",
    "stage2",
    "stage3",
    "fixedPointLlvmFingerprint",
    "publishedByStage3Gate"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "const": "verified-selfhost-stage3-seed" },
    "producer": {
      "enum": [
        "verify-selfhost-stage3.ps1",
        "verify-selfhost-stage3-linux.ps1"
      ]
    },
    "optimization": { "const": "O1" },
    "target": { "enum": ["windows", "linux"] },
    "seedPath": { "type": "string", "minLength": 1 },
    "seedFingerprint": { "$ref": "#/$defs/sha256" },
    "stage2": { "$ref": "#/$defs/generation" },
    "stage3": {
      "allOf": [
        { "$ref": "#/$defs/generation" },
        {
          "type": "object",
          "required": ["inputReceiptPath", "inputFingerprint"],
          "properties": {
            "inputReceiptPath": { "type": "string", "minLength": 1 },
            "inputFingerprint": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "fixedPointLlvmFingerprint": { "$ref": "#/$defs/sha256" },
    "publishedByStage3Gate": { "const": true }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executablePath",
        "executableFingerprint",
        "llvmPath",
        "llvmFingerprint",
        "bitcodePath",
        "bitcodeFingerprint",
        "outputReceiptPath",
        "outputReceiptFingerprint"
      ],
      "properties": {
        "executablePath": { "type": "string", "minLength": 1 },
        "executableFingerprint": { "$ref": "#/$defs/sha256" },
        "llvmPath": { "type": "string", "minLength": 1 },
        "llvmFingerprint": { "$ref": "#/$defs/sha256" },
        "bitcodePath": { "type": "string", "minLength": 1 },
        "bitcodeFingerprint": { "$ref": "#/$defs/sha256" },
        "outputReceiptPath": { "type": "string", "minLength": 1 },
        "outputReceiptFingerprint": { "$ref": "#/$defs/sha256" },
        "inputReceiptPath": { "type": "string", "minLength": 1 },
        "inputFingerprint": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
