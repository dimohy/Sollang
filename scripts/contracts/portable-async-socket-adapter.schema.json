{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "item", "status", "module", "probeLayer", "implementationClaim", "probes", "api", "ownership", "scheduling", "forbidden", "parentDependencies", "acceptanceComposition", "matrix", "negativeControls", "earlyGate"],
  "properties": {
    "$schema": { "const": "portable-async-socket-adapter.schema.json" },
    "schemaVersion": { "const": 1 },
    "item": { "const": "Portable memory I/O" },
    "status": { "const": "implementation-in-progress" },
    "module": { "const": "std.io.socket" },
    "probeLayer": { "const": "existing-std.net.socket-completion-api" },
    "implementationClaim": { "const": false },
    "probes": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source", "path", "expected"],
        "properties": {
          "id": { "enum": ["direct-owner-return", "pending-await-owner-return", "cooperative-cancellation-owner-return"] },
          "source": { "type": "string", "pattern": "^scripts/probes/portable-memory-io/.+\\.slg$" },
          "path": { "enum": ["direct", "pending", "cancelled"] },
          "expected": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "api": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "ownership": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "scheduling": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "forbidden": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "parentDependencies": {
      "type": "object", "additionalProperties": false,
      "required": ["stdlibBacklog", "socketCompletion"],
      "properties": {
        "stdlibBacklog": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "denominator", "selectedOrdinal"],
          "properties": {
            "path": { "const": "scripts/contracts/stdlib-evolution-progress.json" },
            "denominator": { "const": 22 },
            "selectedOrdinal": { "const": 8 }
          }
        },
        "socketCompletion": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "denominator", "requiredCompleted"],
          "properties": {
            "path": { "const": "scripts/contracts/socket-completion-reactor.json" },
            "denominator": { "const": 22 },
            "requiredCompleted": { "const": 22 }
          }
        }
      }
    },
    "acceptanceComposition": {
      "type": "object", "additionalProperties": false,
      "required": ["rule", "independentDenominators", "sumForbidden"],
      "properties": {
        "rule": { "const": "adapter 21/21 AND socket completion 22/22 AND Portable memory I/O item acceptance" },
        "independentDenominators": { "const": [21, 22, 22] },
        "sumForbidden": { "const": true }
      }
    },
    "matrix": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "replacesParentMatrix", "total", "managedWindows", "managedLinux", "selfhostWindows", "selfhostLinux", "browser", "semanticNegative", "crossCutting", "browserPolicy", "cases"],
      "properties": {
        "scope": { "const": "nested-adapter-slice" },
        "replacesParentMatrix": { "const": false },
        "total": { "const": 21 },
        "managedWindows": { "const": 3 },
        "managedLinux": { "const": 3 },
        "selfhostWindows": { "const": 3 },
        "selfhostLinux": { "const": 3 },
        "browser": { "const": 1 },
        "semanticNegative": { "const": 5 },
        "crossCutting": { "const": 3 },
        "browserPolicy": {
          "type": "object", "additionalProperties": false,
          "required": ["focusedBuildRequired", "unsupportedClaimRequiresBuildRejection", "compileSuccessRequiresSupportedBehaviorTest"],
          "properties": {
            "focusedBuildRequired": { "const": true },
            "unsupportedClaimRequiresBuildRejection": { "const": true },
            "compileSuccessRequiresSupportedBehaviorTest": { "const": true }
          }
        },
        "cases": {
          "type": "array", "minItems": 21, "maxItems": 21,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "platform", "kind", "status"],
            "properties": {
              "id": { "type": "string", "pattern": "^(W|L|SW|SL|B|N|X)[0-9]{2}$" },
              "platform": { "enum": ["managed-windows-x64", "managed-linux-x64", "selfhost-windows-x64", "selfhost-linux-x64", "wasm32-browser", "semantic", "cross-cutting"] },
              "kind": { "type": "string", "minLength": 1 },
              "status": { "enum": ["probe-ready", "planned"] }
            }
          }
        }
      }
    },
    "negativeControls": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "behavior"],
        "properties": {
          "id": { "pattern": "^N0[1-5]$" },
          "behavior": { "type": "string", "minLength": 1 }
        }
      }
    },
    "earlyGate": {
      "type": "object", "additionalProperties": false,
      "required": ["completed", "total", "requiredBeforeImplementation"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0, "maximum": 3 },
        "total": { "const": 3 },
        "requiredBeforeImplementation": { "const": true }
      }
    }
  }
}
