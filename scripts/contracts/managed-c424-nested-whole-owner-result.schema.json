{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "mode", "defectId", "runStatus", "completionStatus",
    "completed", "total", "target", "compilerSha256",
    "expectedCompilerSha256", "inputStable", "inputDrift", "inputHashes",
    "case", "failureIds"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "const": "managed-c424-nested-whole-owner" },
    "defectId": { "const": "C2026-09-13-424" },
    "runStatus": { "enum": ["passed", "failed"] },
    "completionStatus": { "enum": ["complete", "in-progress"] },
    "completed": { "type": "integer", "minimum": 0, "maximum": 1 },
    "total": { "const": 1 },
    "target": { "const": "windows-x64" },
    "compilerSha256": { "$ref": "#/$defs/sha256" },
    "expectedCompilerSha256": { "$ref": "#/$defs/sha256" },
    "inputStable": { "type": "boolean" },
    "inputDrift": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "inputHashes": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "sourceRoot": { "type": "string", "minLength": 1 },
    "stdlibSourceCount": { "type": "integer", "minimum": 1 },
    "stdlibSourceSetSha256": { "$ref": "#/$defs/sha256" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "passed", "sourceSha256", "compileExit", "stderrEmpty",
        "targetLlvmProduced", "diagnosticFree", "llvmAsExit", "closureExit",
        "nativeExit", "expectedStdout", "nativeExact", "auditLinkExit",
        "auditExit", "expectedAllocationCount", "allocationCount",
        "releaseCount", "invalidReleaseCount", "allocationBalanced",
        "childType", "parentType", "childDropFunction", "parentDropFunction",
        "childDropCallsInParent", "independentChildDropCalls",
        "parentDropCalls", "structureMatched", "failure"
      ],
      "properties": {
        "id": { "const": "C424-P1" },
        "passed": { "type": "boolean" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "compileExit": { "type": "integer" },
        "stderrEmpty": { "type": "boolean" },
        "targetLlvmProduced": { "type": "boolean" },
        "diagnosticFree": { "type": "boolean" },
        "llvmAsExit": { "type": ["integer", "null"] },
        "closureExit": { "type": ["integer", "null"] },
        "nativeExit": { "type": ["integer", "null"] },
        "expectedStdout": { "const": "nested=1,128,256" },
        "nativeExact": { "type": "boolean" },
        "auditLinkExit": { "type": ["integer", "null"] },
        "auditExit": { "type": ["integer", "null"] },
        "expectedAllocationCount": { "const": 1 },
        "allocationCount": { "type": ["integer", "null"], "minimum": 0 },
        "releaseCount": { "type": ["integer", "null"], "minimum": 0 },
        "invalidReleaseCount": { "type": ["integer", "null"], "minimum": 0 },
        "allocationBalanced": { "type": "boolean" },
        "childType": { "type": ["string", "null"] },
        "parentType": { "type": ["string", "null"] },
        "childDropFunction": { "type": ["string", "null"] },
        "parentDropFunction": { "type": ["string", "null"] },
        "childDropCallsInParent": { "type": ["integer", "null"], "minimum": 0 },
        "independentChildDropCalls": { "type": ["integer", "null"], "minimum": 0 },
        "parentDropCalls": { "type": ["integer", "null"], "minimum": 0 },
        "structureMatched": { "type": "boolean" },
        "failure": { "type": ["string", "null"] }
      }
    },
    "failureIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "runStatus": { "const": "passed" } } },
      "then": {
        "properties": {
          "completionStatus": { "const": "complete" },
          "completed": { "const": 1 },
          "inputStable": { "const": true },
          "inputDrift": { "maxItems": 0 },
          "failureIds": { "maxItems": 0 },
          "case": {
            "properties": {
              "passed": { "const": true },
              "compileExit": { "const": 0 },
              "stderrEmpty": { "const": true },
              "targetLlvmProduced": { "const": true },
              "diagnosticFree": { "const": true },
              "llvmAsExit": { "const": 0 },
              "closureExit": { "const": 0 },
              "nativeExit": { "const": 0 },
              "nativeExact": { "const": true },
              "auditLinkExit": { "const": 0 },
              "auditExit": { "const": 0 },
              "allocationCount": { "const": 1 },
              "releaseCount": { "const": 1 },
              "invalidReleaseCount": { "const": 0 },
              "allocationBalanced": { "const": true },
              "childDropCallsInParent": { "const": 1 },
              "independentChildDropCalls": { "const": 0 },
              "parentDropCalls": { "const": 1 },
              "structureMatched": { "const": true },
              "failure": { "type": "null" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
  }
}
