{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sollang.dev/contracts/cpu-target-features.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dispatchPolicies", "architectures", "specializations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "dispatchPolicies": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "architectures": {
      "type": "object",
      "required": ["x86_64", "arm64", "wasm32"],
      "additionalProperties": { "$ref": "#/$defs/architecture" }
    },
    "specializations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["required"],
          "properties": {
            "required": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
          }
        }
      }
    }
  },
  "$defs": {
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "baselineMask", "allowedMask", "features"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "baselineMask": { "type": "integer", "minimum": 0 },
        "allowedMask": { "type": "integer", "minimum": 0 },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "bit", "managed", "llvm"],
            "properties": {
              "id": { "type": "string" },
              "bit": { "type": "integer", "minimum": 0, "maximum": 63 },
              "managed": { "type": "string" },
              "llvm": { "type": "string", "pattern": "^\\+" },
              "requires": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
              "osState": { "type": "string" },
              "linuxHwcap": { "type": "string" },
              "declaration": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
