{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "seedCompilerFingerprint",
    "currentSourceFingerprint",
    "overlaySourceFingerprint",
    "overlayPath",
    "compilerPath",
    "compilerFingerprint",
    "llvmPath",
    "llvmFingerprint",
    "dispatch"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "const": "c85-per-source-performance-control" },
    "seedCompilerFingerprint": { "$ref": "#/$defs/sha256" },
    "currentSourceFingerprint": { "$ref": "#/$defs/sha256" },
    "overlaySourceFingerprint": { "$ref": "#/$defs/sha256" },
    "overlayPath": { "type": "string", "minLength": 1 },
    "compilerPath": { "type": "string", "minLength": 1 },
    "compilerFingerprint": { "$ref": "#/$defs/sha256" },
    "llvmPath": { "type": "string", "minLength": 1 },
    "llvmFingerprint": { "$ref": "#/$defs/sha256" },
    "dispatch": { "const": "per-source" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
  }
}
