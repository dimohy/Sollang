{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "defectId", "cases"],
  "properties": {
    "$schema": { "const": "direct-owned-field-binding.schema.json" },
    "schemaVersion": { "const": 1 },
    "defectId": { "const": "C2026-09-06-341" },
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "source", "expectedBuildExit"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["positive", "negative"] },
          "expectedBuildExit": { "enum": [0, 1] },
          "source": { "type": "string", "pattern": "\\.slg$" },
          "expected": { "type": "string", "pattern": "\\.stdout\\.txt$" },
          "expectedText": { "type": "string" },
          "auditAllocations": { "type": "integer", "minimum": 1 },
          "diagnostic": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          { "if": { "properties": { "kind": { "const": "positive" } } }, "then": { "properties": { "expectedBuildExit": { "const": 0 } }, "anyOf": [{ "required": ["expected"] }, { "required": ["expectedText"] }], "not": { "required": ["diagnostic"] } } },
          { "if": { "properties": { "kind": { "const": "negative" } } }, "then": { "properties": { "expectedBuildExit": { "const": 1 } }, "required": ["diagnostic"], "not": { "anyOf": [{ "required": ["expected"] }, { "required": ["expectedText"] }, { "required": ["auditAllocations"] }] } } }
        ]
      }
    }
  }
}
