{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "status", "compilerSha256", "inputStable", "inputDrift", "inputHashes", "formatExitCode", "compileExitCode", "compileDiagnosticsClean", "llvmAsExitCode", "closureExitCode", "nativeExitCode", "stdout", "stderr", "orphanProcessIds", "irAssertions", "failureIds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "const": "L02" },
    "status": { "enum": ["passed", "failed"] },
    "compilerSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "inputStable": { "type": "boolean" },
    "inputDrift": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "inputHashes": { "type": "object", "minProperties": 11, "additionalProperties": { "type": "string", "pattern": "^[A-F0-9]{64}$" } },
    "formatExitCode": { "type": ["integer", "null"] },
    "compileExitCode": { "type": ["integer", "null"] },
    "compileDiagnosticsClean": { "type": "boolean" },
    "llvmAsExitCode": { "type": ["integer", "null"] },
    "closureExitCode": { "type": ["integer", "null"] },
    "nativeExitCode": { "type": ["integer", "null"] },
    "stdout": { "type": "array", "items": { "type": "string" } },
    "stderr": { "type": "string" },
    "orphanProcessIds": { "type": "array", "maxItems": 0, "items": { "type": "integer" } },
    "irAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["singleBlockingWaiter", "taskWorkerNonblocking", "taskUsesSocketStatus", "terminalPublishOnce", "taskWakeHandoff", "pendingOwnerPublishedBeforeWaiter", "dequeueTransfersOwner", "payloadCopyFree", "closeJoinsBeforeFree"],
      "properties": {
        "singleBlockingWaiter": { "type": "boolean" },
        "taskWorkerNonblocking": { "type": "boolean" },
        "taskUsesSocketStatus": { "type": "boolean" },
        "terminalPublishOnce": { "type": "boolean" },
        "taskWakeHandoff": { "type": "boolean" },
        "pendingOwnerPublishedBeforeWaiter": { "type": "boolean" },
        "dequeueTransfersOwner": { "type": "boolean" },
        "payloadCopyFree": { "type": "boolean" },
        "closeJoinsBeforeFree": { "type": "boolean" }
      }
    },
    "failureIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  },
  "allOf": [{
    "if": { "properties": { "status": { "const": "passed" } } },
    "then": { "properties": {
      "inputStable": { "const": true },
      "inputDrift": { "maxItems": 0 },
      "formatExitCode": { "const": 0 },
      "compileExitCode": { "const": 0 },
      "compileDiagnosticsClean": { "const": true },
      "llvmAsExitCode": { "const": 0 },
      "closureExitCode": { "const": 0 },
      "nativeExitCode": { "const": 0 },
      "stdout": { "const": ["ready-task=true", "woke=true,2,100,101,len=3"] },
      "stderr": { "const": "" },
      "irAssertions": { "properties": {
        "singleBlockingWaiter": { "const": true },
        "taskWorkerNonblocking": { "const": true },
        "taskUsesSocketStatus": { "const": true },
        "terminalPublishOnce": { "const": true },
        "taskWakeHandoff": { "const": true },
        "pendingOwnerPublishedBeforeWaiter": { "const": true },
        "dequeueTransfersOwner": { "const": true },
        "payloadCopyFree": { "const": true },
        "closeJoinsBeforeFree": { "const": true }
      } },
      "failureIds": { "maxItems": 0 }
    } }
  }]
}
