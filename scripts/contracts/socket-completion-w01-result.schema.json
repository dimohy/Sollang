{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "status", "compilerSha256", "inputHashes", "compileExit", "compileDiagnosticsClean", "nativeExit", "llvmAsExit", "closureExit", "authorityExit", "stdout", "failureIds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "const": "W01" },
    "status": { "enum": ["passed", "failed"] },
    "compilerSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "inputHashes": {
      "type": "object", "additionalProperties": false,
      "required": ["compiler", "probe", "contract", "contractSchema", "resultSchema", "verifier", "authorityVerifier", "closureVerifier", "windowsRuntime", "linuxRuntime"],
      "properties": {
        "compiler": { "type": "string", "pattern": "^[A-F0-9]{64}$" }, "probe": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "contract": { "type": "string", "pattern": "^[A-F0-9]{64}$" }, "contractSchema": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "resultSchema": { "type": "string", "pattern": "^[A-F0-9]{64}$" }, "verifier": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "authorityVerifier": { "type": "string", "pattern": "^[A-F0-9]{64}$" }, "closureVerifier": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "windowsRuntime": { "type": "string", "pattern": "^[A-F0-9]{64}$" }, "linuxRuntime": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
      }
    },
    "compileExit": { "type": "integer" },
    "compileDiagnosticsClean": { "type": "boolean" },
    "nativeExit": { "type": ["integer", "null"] },
    "llvmAsExit": { "type": ["integer", "null"] },
    "closureExit": { "type": ["integer", "null"] },
    "authorityExit": { "type": ["integer", "null"] },
    "stdout": { "const": "duplicate=true,code=0,portsDistinct=true,returnedB=true,removedA=true,removedB=true\ncapacity=true,code=0,portsDistinct=true,returnedC=true,removedA=true,removedB=true\nw01=complete" },
    "failureIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  },
  "allOf": [{
    "if": { "properties": { "status": { "const": "passed" } } },
    "then": {
      "properties": {
        "compileExit": { "const": 0 }, "compileDiagnosticsClean": { "const": true }, "nativeExit": { "const": 0 },
        "llvmAsExit": { "const": 0 }, "closureExit": { "const": 0 }, "authorityExit": { "const": 0 },
        "failureIds": { "maxItems": 0 }
      }
    }
  }]
}
