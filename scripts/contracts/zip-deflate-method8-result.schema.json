{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zip-deflate-method8-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capabilityId", "mode", "status", "planned", "completed", "compiler", "inputs", "windows", "linux", "browser", "python", "semanticNegatives", "processAudit", "failureIds", "startedUtc", "finishedUtc"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capabilityId": { "const": "zip-deflate-method8" },
    "mode": { "enum": ["input-validation", "semantic-preflight", "full"] },
    "status": { "enum": ["validated-inputs", "validated-semantic-negatives", "passed", "failed"] },
    "planned": { "const": 6 },
    "completed": { "type": "integer", "minimum": 0, "maximum": 6 },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256Start", "sha256End"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256Start": { "$ref": "#/$defs/nullableSha256" },
        "sha256End": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/hashMap" },
        "end": { "$ref": "#/$defs/hashMap" }
      }
    },
    "windows": { "$ref": "#/$defs/nativePlatform" },
    "linux": { "$ref": "#/$defs/nativePlatform" },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "completed", "artifactProduced", "wasmMagicValid", "exactOutput", "stdoutSha256", "stdoutBytes", "llvmSha256", "bitcodeSha256", "artifactSha256", "warningCount", "noteCount"],
      "properties": {
        "status": { "enum": ["not-run", "failed", "passed"] },
        "completed": { "type": "integer", "minimum": 0, "maximum": 1 },
        "artifactProduced": { "type": "boolean" },
        "wasmMagicValid": { "type": "boolean" },
        "exactOutput": { "type": "boolean" },
        "stdoutSha256": { "$ref": "#/$defs/nullableSha256" },
        "stdoutBytes": { "type": ["integer", "null"], "minimum": 0 },
        "llvmSha256": { "$ref": "#/$defs/nullableSha256" },
        "bitcodeSha256": { "$ref": "#/$defs/nullableSha256" },
        "artifactSha256": { "$ref": "#/$defs/nullableSha256" },
        "warningCount": { "type": ["integer", "null"], "minimum": 0 },
        "noteCount": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "completed", "stdoutSha256", "stdoutBytes"],
      "properties": {
        "status": { "enum": ["not-run", "failed", "passed"] },
        "completed": { "type": "integer", "minimum": 0, "maximum": 1 },
        "stdoutSha256": { "$ref": "#/$defs/nullableSha256" },
        "stdoutBytes": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "semanticNegatives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned", "completed", "failureIds"],
      "properties": {
        "planned": { "const": 2 },
        "completed": { "type": "integer", "minimum": 0, "maximum": 2 },
        "failureIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "processAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootProcessIds", "descendantProcessIds", "orphanProcessIds", "invocations"],
      "properties": {
        "rootProcessIds": { "$ref": "#/$defs/processIds" },
        "descendantProcessIds": { "$ref": "#/$defs/processIds" },
        "orphanProcessIds": { "$ref": "#/$defs/processIds" },
        "invocations": { "type": "array", "items": { "$ref": "#/$defs/invocation" } }
      }
    },
    "failureIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "startedUtc": { "type": "string", "format": "date-time" },
    "finishedUtc": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "input-validation" } } },
      "then": { "properties": { "status": { "enum": ["validated-inputs", "failed"] } } }
    },
    {
      "if": { "properties": { "mode": { "const": "semantic-preflight" } } },
      "then": { "properties": { "status": { "enum": ["validated-semantic-negatives", "failed"] } } }
    },
    {
      "if": { "properties": { "mode": { "const": "full" } } },
      "then": { "properties": { "status": { "enum": ["passed", "failed"] } } }
    },
    {
      "if": { "properties": { "status": { "const": "validated-inputs" } } },
      "then": {
        "properties": {
          "completed": { "const": 0 },
          "failureIds": { "maxItems": 0 },
          "compiler": { "properties": { "sha256Start": { "$ref": "#/$defs/sha256" }, "sha256End": { "$ref": "#/$defs/sha256" } } },
          "windows": { "properties": { "status": { "const": "not-run" }, "completed": { "const": 0 } } },
          "linux": { "properties": { "status": { "const": "not-run" }, "completed": { "const": 0 } } },
          "browser": { "properties": { "status": { "const": "not-run" }, "completed": { "const": 0 } } },
          "python": { "properties": { "status": { "const": "not-run" }, "completed": { "const": 0 } } }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "validated-semantic-negatives" } } },
      "then": {
        "properties": {
          "completed": { "const": 0 },
          "failureIds": { "maxItems": 0 },
          "compiler": { "properties": { "sha256Start": { "$ref": "#/$defs/sha256" }, "sha256End": { "$ref": "#/$defs/sha256" } } },
          "windows": { "properties": { "status": { "const": "not-run" }, "completed": { "const": 0 } } },
          "linux": { "properties": { "status": { "const": "not-run" }, "completed": { "const": 0 } } },
          "browser": { "properties": { "status": { "const": "not-run" }, "completed": { "const": 0 } } },
          "python": { "properties": { "status": { "const": "not-run" }, "completed": { "const": 0 } } },
          "semanticNegatives": { "properties": { "completed": { "const": 2 }, "failureIds": { "maxItems": 0 } } }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "passed" } } },
      "then": {
        "properties": {
          "completed": { "const": 6 },
          "failureIds": { "maxItems": 0 },
          "compiler": { "properties": { "sha256Start": { "$ref": "#/$defs/sha256" }, "sha256End": { "$ref": "#/$defs/sha256" } } },
          "windows": { "properties": { "status": { "const": "passed" }, "completed": { "const": 2 } } },
          "linux": { "properties": { "status": { "const": "passed" }, "completed": { "const": 2 } } },
          "browser": { "properties": { "status": { "const": "passed" }, "completed": { "const": 1 }, "artifactProduced": { "const": true }, "wasmMagicValid": { "const": true }, "exactOutput": { "const": true }, "stdoutSha256": { "$ref": "#/$defs/sha256" }, "stdoutBytes": { "type": "integer", "minimum": 1 }, "llvmSha256": { "$ref": "#/$defs/sha256" }, "bitcodeSha256": { "$ref": "#/$defs/sha256" }, "artifactSha256": { "$ref": "#/$defs/sha256" }, "warningCount": { "const": 0 }, "noteCount": { "const": 0 } } },
          "python": { "properties": { "status": { "const": "passed" }, "completed": { "const": 1 }, "stdoutSha256": { "$ref": "#/$defs/sha256" }, "stdoutBytes": { "type": "integer", "minimum": 1 } } },
          "semanticNegatives": { "properties": { "completed": { "const": 2 }, "failureIds": { "maxItems": 0 } } },
          "processAudit": { "properties": { "orphanProcessIds": { "maxItems": 0 } } }
        }
      }
    },
    { "if": { "properties": { "status": { "const": "failed" } } }, "then": { "properties": { "failureIds": { "minItems": 1 } } } },
    {
      "if": { "properties": { "browser": { "properties": { "status": { "const": "not-run" } } } } },
      "then": {
        "properties": {
          "processAudit": {
            "properties": {
              "invocations": {
                "not": { "contains": { "properties": { "id": { "pattern": "browser" } }, "required": ["id"] } }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "nullableSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "hashMap": { "type": "object", "minProperties": 8, "additionalProperties": { "$ref": "#/$defs/sha256" } },
    "processIds": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optimization", "status", "stdoutSha256", "stdoutBytes", "llvmSha256", "bitcodeSha256", "artifactSha256", "warningCount", "noteCount"],
      "properties": {
        "optimization": { "enum": ["O0", "O2"] },
        "status": { "enum": ["not-run", "failed", "passed"] },
        "stdoutSha256": { "$ref": "#/$defs/nullableSha256" },
        "stdoutBytes": { "type": ["integer", "null"], "minimum": 0 },
        "llvmSha256": { "$ref": "#/$defs/nullableSha256" },
        "bitcodeSha256": { "$ref": "#/$defs/nullableSha256" },
        "artifactSha256": { "$ref": "#/$defs/nullableSha256" },
        "warningCount": { "type": ["integer", "null"], "minimum": 0 },
        "noteCount": { "type": ["integer", "null"], "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "passed" } } },
          "then": {
            "properties": {
              "stdoutSha256": { "$ref": "#/$defs/sha256" },
              "stdoutBytes": { "type": "integer", "minimum": 1 },
              "llvmSha256": { "$ref": "#/$defs/sha256" },
              "bitcodeSha256": { "$ref": "#/$defs/sha256" },
              "artifactSha256": { "$ref": "#/$defs/sha256" },
              "warningCount": { "const": 0 },
              "noteCount": { "const": 0 }
            }
          }
        }
      ]
    },
    "nativePlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "planned", "completed", "checks"],
      "properties": {
        "status": { "enum": ["not-run", "failed", "passed"] },
        "planned": { "const": 2 },
        "completed": { "type": "integer", "minimum": 0, "maximum": 2 },
        "checks": { "type": "array", "minItems": 2, "maxItems": 2, "contains": { "properties": { "optimization": { "const": "O0" } } }, "minContains": 1, "maxContains": 1, "items": { "$ref": "#/$defs/check" } }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "processId", "exitCode", "stdoutPath", "stderrPath", "stdoutSha256", "stdoutBytes", "stderrSha256", "stderrBytes", "descendantProcessIds", "orphanProcessIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "processId": { "type": "integer", "minimum": 1 },
        "exitCode": { "type": "integer" },
        "stdoutPath": { "type": "string", "minLength": 1 },
        "stderrPath": { "type": "string", "minLength": 1 },
        "stdoutSha256": { "$ref": "#/$defs/sha256" },
        "stdoutBytes": { "type": "integer", "minimum": 0 },
        "stderrSha256": { "$ref": "#/$defs/sha256" },
        "stderrBytes": { "type": "integer", "minimum": 0 },
        "descendantProcessIds": { "$ref": "#/$defs/processIds" },
        "orphanProcessIds": { "$ref": "#/$defs/processIds" }
      }
    }
  }
}
