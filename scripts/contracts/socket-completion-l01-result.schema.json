{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "status", "compilerSha256", "inputStable", "inputDrift", "inputHashes", "formatExitCode", "compileExitCode", "compileDiagnosticsClean", "llvmAsExitCode", "closureExitCode", "nativeExitCode", "stdout", "stderr", "orphanProcessIds", "irAssertions", "failureIds"],
  "properties": {
    "schemaVersion": { "const": 1 }, "caseId": { "const": "L01" }, "status": { "enum": ["passed", "failed"] },
    "compilerSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "inputStable": { "type": "boolean" }, "inputDrift": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "inputHashes": { "type": "object", "minProperties": 11, "additionalProperties": { "type": "string", "pattern": "^[A-F0-9]{64}$" } },
    "formatExitCode": { "type": ["integer", "null"] }, "compileExitCode": { "type": ["integer", "null"] },
    "compileDiagnosticsClean": { "type": "boolean" }, "llvmAsExitCode": { "type": ["integer", "null"] }, "closureExitCode": { "type": ["integer", "null"] },
    "nativeExitCode": { "type": ["integer", "null"] }, "stdout": { "type": "array", "items": { "type": "string" } }, "stderr": { "type": "string" },
    "orphanProcessIds": { "type": "array", "maxItems": 0, "items": { "type": "integer" } },
    "irAssertions": {
      "type": "object", "additionalProperties": false,
      "required": ["pollDeclarationCount", "nonblockingPrecedesEpoll", "directReceivePresent", "directSendPresent", "wouldBlockPreservesPendingOwner", "payloadCopyFree", "registrationOwnerRetainedUntilClose"],
      "properties": {
        "pollDeclarationCount": { "type": "integer" }, "nonblockingPrecedesEpoll": { "type": "boolean" },
        "directReceivePresent": { "type": "boolean" }, "directSendPresent": { "type": "boolean" },
        "wouldBlockPreservesPendingOwner": { "type": "boolean" }, "payloadCopyFree": { "type": "boolean" },
        "registrationOwnerRetainedUntilClose": { "type": "boolean" }
      }
    },
    "failureIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  },
  "allOf": [{ "if": { "properties": { "status": { "const": "passed" } } }, "then": { "properties": {
    "inputStable": { "const": true }, "inputDrift": { "maxItems": 0 }, "formatExitCode": { "const": 0 }, "compileExitCode": { "const": 0 },
    "compileDiagnosticsClean": { "const": true }, "llvmAsExitCode": { "const": 0 }, "closureExitCode": { "const": 0 }, "nativeExitCode": { "const": 0 },
    "stdout": { "const": ["completed=true,count=3,first=97,last=99,len=3"] }, "stderr": { "const": "" },
    "irAssertions": { "properties": {
      "pollDeclarationCount": { "const": 1 }, "nonblockingPrecedesEpoll": { "const": true }, "directReceivePresent": { "const": true },
      "directSendPresent": { "const": true }, "wouldBlockPreservesPendingOwner": { "const": true }, "payloadCopyFree": { "const": true },
      "registrationOwnerRetainedUntilClose": { "const": true }
    } }, "failureIds": { "maxItems": 0 }
  } } }]
}
