    "schemaVersion": { "const": 1 },
    "capabilityId": { "const": "zip-deflate-method8" },
    "module": { "const": "std.archive.zip" },
    "implementationStatus": { "enum": ["implementation-in-progress", "implemented-focused", "verified"] },
    "sources": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "fixture": { "type": "string", "minLength": 1 },
    "expectedOutput": { "type": "string", "minLength": 1 },
    "publicSurface": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "engineReuse": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "limits": { "type": "array", "const": ["maxCompressedBytes", "maxExpansionRatio", "maxWorkUnits"] },
    "transactionality": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "requiredFixtureCases": { "type": "array", "minItems": 11, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "semanticNegatives": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 }
        }
      }
    },
    "semanticPreflight": { "const": "scripts/verify-zip-deflate-method8-focused.ps1 -ValidateSemanticPreflightOnly" },
    "executionMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managedWindowsO0O2", "linuxO0O2", "browserExactExecution", "independentPython", "total"],
      "properties": {
        "managedWindowsO0O2": { "const": 2 },
        "linuxO0O2": { "const": 2 },
        "browserExactExecution": { "const": 1 },
        "independentPython": { "const": 1 },
        "total": { "const": 6 }
      }
    },
    "independentOracle": { "const": "scripts/probes/zip-deflate-method8/verify_python_oracle.py" },
    "resultSchema": { "const": "scripts/contracts/zip-deflate-method8-result.schema.json" },
    "resultVerifier": { "const": "scripts/verify-zip-deflate-method8-result.ps1" },
    "contractVerifier": { "const": "scripts/verify-zip-deflate-method8-contract.ps1" },
    "resultNegativeControls": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "remainingBacklog": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "unsupported": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
