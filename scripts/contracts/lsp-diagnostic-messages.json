{
  "schemaVersion": 1,
  "scope": "Independent exact language-server diagnostic oracles: canonical CLI syntax messages, replacement glyph, raw strings, committed statement/map/local syntax and valid control",
  "cases": [
    {
      "id": "supplementary-invalid",
      "kind": "diagnostic",
      "source": "main { 😀 }\n",
      "expected": [
        {
          "range": {
            "start": {
              "line": 0,
              "character": 7
            },
            "end": {
              "line": 0,
              "character": 8
            }
          },
          "severity": 1,
          "source": "sollang",
          "message": "lex error at 1:8: unexpected character '�'"
        }
      ]
    },
    {
      "id": "statement-boundary",
      "kind": "diagnostic",
      "source": "main { 1 => x 2 => y }\n",
      "expected": [
        {
          "range": {
            "start": {
              "line": 0,
              "character": 14
            },
            "end": {
              "line": 0,
              "character": 15
            }
          },
          "severity": 1,
          "source": "sollang",
          "message": "parse error at 1:15: expected end of statement"
        }
      ]
    },
    {
      "id": "missing-expression",
      "kind": "diagnostic",
      "source": "main { 1 + }\n",
      "expected": [
        {
          "range": {
            "start": {
              "line": 0,
              "character": 11
            },
            "end": {
              "line": 0,
              "character": 12
            }
          },
          "severity": 1,
          "source": "sollang",
          "message": "parse error at 1:12: expected expression"
        }
      ]
    },
    {
      "id": "raw-unterminated",
      "kind": "diagnostic",
      "source": "main { \"\"\"\n    text\n}\n",
      "expected": [
        {
          "range": {
            "start": {
              "line": 0,
              "character": 7
            },
            "end": {
              "line": 0,
              "character": 8
            }
          },
          "severity": 1,
          "source": "sollang",
          "message": "lex error at 1:8: unterminated raw string literal"
        }
      ]
    },
    {
      "id": "raw-layout",
      "kind": "diagnostic",
      "source": "main {\n    \"\"\"\n bad\n    \"\"\" -> println\n}\n",
      "expected": [
        {
          "range": {
            "start": {
              "line": 1,
              "character": 4
            },
            "end": {
              "line": 1,
              "character": 5
            }
          },
          "severity": 1,
          "source": "sollang",
          "message": "parse error at 2:5: raw string content must match the closing delimiter indentation"
        }
      ]
    },
    {
      "id": "local-public",
      "kind": "diagnostic",
      "source": "outer: -> Int {\n    public inner: -> Int => 1\n    1\n}\nmain { outer() -> println }\n",
      "expected": [
        {
          "range": {
            "start": {
              "line": 1,
              "character": 4
            },
            "end": {
              "line": 1,
              "character": 5
            }
          },
          "severity": 1,
          "source": "sollang",
          "message": "parse error at 2:5: local functions cannot be public"
        }
      ]
    },
    {
      "id": "map-mode",
      "kind": "diagnostic",
      "source": "main { map strange \"x\" }\n",
      "expected": [
        {
          "range": {
            "start": {
              "line": 0,
              "character": 11
            },
            "end": {
              "line": 0,
              "character": 12
            }
          },
          "severity": 1,
          "source": "sollang",
          "message": "parse error at 1:12: map expects 'read' or 'write'"
        }
      ]
    },
    {
      "id": "valid-control",
      "kind": "diagnostic",
      "source": "main { \"ok\" -> println }\n",
      "expected": []
    }
  ]
}
