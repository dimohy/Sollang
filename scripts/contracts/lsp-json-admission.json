{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "invalid-literal",
      "payload": "{\"junk\":truX}",
      "expectedBuildExit": 0,
      "expectedRuntimeExit": 1,
      "expectedStderr": "sollang: invalid LSP message\n"
    },
    {
      "id": "invalid-escape",
      "payload": "{\"junk\":\"\\q\"}",
      "expectedBuildExit": 0,
      "expectedRuntimeExit": 1,
      "expectedStderr": "sollang: invalid LSP message\n"
    },
    {
      "id": "missing-comma",
      "payload": "{\"junk\":1 \"other\":2}",
      "expectedBuildExit": 0,
      "expectedRuntimeExit": 1,
      "expectedStderr": "sollang: invalid LSP message\n"
    },
    {
      "id": "trailing-input",
      "payload": "{} false",
      "expectedBuildExit": 0,
      "expectedRuntimeExit": 1,
      "expectedStderr": "sollang: invalid LSP message\n"
    },
    {
      "id": "mismatched-container",
      "payload": "{\"junk\":[1,2}}",
      "expectedBuildExit": 0,
      "expectedRuntimeExit": 1,
      "expectedStderr": "sollang: invalid LSP message\n"
    },
    {
      "id": "valid-unused-members",
      "payload": "{\"junk\":{\"values\":[null,true,false,1.25e-2,\"x\"]}}",
      "expectedBuildExit": 0,
      "expectedRuntimeExit": 0,
      "expectedStderr": ""
    },
    {
      "id": "isolated-high-surrogate",
      "payload": "{\"junk\":\"\\uD800\"}",
      "expectedBuildExit": 0,
      "expectedRuntimeExit": 0,
      "expectedStderr": ""
    },
    {
      "id": "isolated-low-surrogate",
      "payload": "{\"junk\":\"\\uDC00\"}",
      "expectedBuildExit": 0,
      "expectedRuntimeExit": 0,
      "expectedStderr": ""
    },
    {
      "id": "invalid-unicode-hex",
      "payload": "{\"junk\":\"\\uZZZZ\"}",
      "expectedBuildExit": 0,
      "expectedRuntimeExit": 1,
      "expectedStderr": "sollang: invalid LSP message\n"
    },
    {
      "id": "depth64",
      "payload": "{\"junk\":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[0]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}",
      "expectedBuildExit": 0,
      "expectedRuntimeExit": 0,
      "expectedStderr": ""
    },
    {
      "id": "depth65",
      "payload": "{\"junk\":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[0]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}",
      "expectedBuildExit": 0,
      "expectedRuntimeExit": 1,
      "expectedStderr": "sollang: invalid LSP message\n"
    }
  ]
}
