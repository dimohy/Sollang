{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "module", "sources", "fixture", "rangeFixture", "officialReferences", "surfaces", "invariants", "unsupported"],
  "properties": {
    "$schema": { "const": "http-body-framing.schema.json" },
    "version": { "const": 4 },
    "module": { "const": "std.net.http.body" },
    "sources": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "fixture": { "const": "1229-http-body-framing" },
    "rangeFixture": { "const": "1336-http-body-range-leftover" },
    "officialReferences": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri" }
    },
    "surfaces": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "invariants": {
      "type": "array",
      "minItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "unsupported": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
