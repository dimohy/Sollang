import sys.file as file

prefix source: file.SourceText -> (Int, (Text, Int)) {
    source -> slice(UIntSize(0), UIntSize(3)) => view
    (1, (view, 2))
}

consume source: move file.SourceText -> Unit {
}

main {
    "lexer" -> file.borrowText => source
    source -> prefix => views
    source -> consume
    views._1._0 -> println
}
