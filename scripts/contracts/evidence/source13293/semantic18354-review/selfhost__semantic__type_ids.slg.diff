+# Match the C# dynamic-array and dictionary registration families. Heap and
+# Deque share dynamic-array storage; Set is a dictionary with a Unit value.
+public isDynamicArrayFamily type: SemanticType -> Bool {
+    type.kind == 3
+        or (type.kind == 7 and type.origin == 4 and (type.symbol == 6 or type.symbol == 7))
+}
+
+public isDictionaryFamily type: SemanticType -> Bool {
+    type.kind == 5 or type.kind == 13
+        or (type.kind == 7 and type.origin == 4 and type.symbol == 5)
+}
+
+public isHeapCollection type: SemanticType -> Bool {
+    (type -> isDynamicArrayFamily) or ((type -> isDictionaryFamily) and type.kind != 13)
+}
