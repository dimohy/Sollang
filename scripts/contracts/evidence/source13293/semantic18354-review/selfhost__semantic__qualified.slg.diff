+
+# A declared variant is a nominal value or constructor, never a module alias.
+enumVariantInSource package: ref analysis.PackageAnalysis, requestingSource: Int, ownerToken: Int, memberToken: Int, targetSource: Int -> Int {
+    package.ranges[requestingSource] => queryRange
+    package.tokens[queryRange.tokenStart + ownerToken] => owner
+    package.tokens[queryRange.tokenStart + memberToken] => member
+    package.sources[requestingSource] -> slice(owner.span.start, owner.span.length) => ownerName
+    package.sources[requestingSource] -> slice(member.span.start, member.span.length) => memberName
+    package.ranges[targetSource] => targetRange
+    0 => enumIndex!
+    enumIndex! < targetRange.symbolCount -> while {
+        package.symbols[targetRange.symbolStart + enumIndex!] => enumeration
+        enumeration.kind == 4 and enumeration.parent < 0
+            -> if {
+                package.tokens[targetRange.tokenStart + enumeration.nameToken] => name
+                (package.sources[targetSource] -> slice(name.span.start, name.span.length)) == ownerName
+                    -> if {
+                        0 => variantIndex!
+                        variantIndex! < targetRange.symbolCount -> while {
+                            package.symbols[targetRange.symbolStart + variantIndex!] => variant
+                            variant.kind == 27 and variant.parent == enumIndex!
+                                -> if {
+                                    package.tokens[targetRange.tokenStart + variant.nameToken] => variantName
+                                    (package.sources[targetSource] -> slice(variantName.span.start, variantName.span.length)) == memberName
+                                        -> if { variantIndex! -> return }
+                                }
+                            variantIndex! + 1 => variantIndex!
+                        }
+                    }
+            }
+        enumIndex! + 1 => enumIndex!
+    }
+    -1
+}
