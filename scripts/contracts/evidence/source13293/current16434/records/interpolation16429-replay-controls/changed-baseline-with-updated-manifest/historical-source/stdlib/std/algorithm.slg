namespace std.algorithm

# Comparisons are pure and must define one consistent strict weak ordering.
# Only the sign matters; reversing an order never negates the comparison value.
public trait Comparison {
    type Item
    compare: self, left: ref Item, right: ref Item -> Int
}

public enum Direction {
    Ascending
    Descending
}

public struct Ordering {
    public direction: Direction
}

public struct Algorithms { }

public struct SearchResult {
    public index: Int
    public found: Bool
}

public struct EqualRange {
    public start: Int
    public end: Int
}

public enum Error {
    ReversedBounds
}

public enum StableSortError {
    InsufficientScratch
}

public enum MergeError {
    LengthOverflow
    InsufficientOutputCapacity
    InsufficientOutputLength
}

impl Algorithms {
    # The predicate must be true for one prefix and false for the remaining
    # suffix. Returns the first false position, or values.len when all are true.
    # The readonly search borrows every inspected item and performs no allocation.
    public partitionPoint<T>: self, values: [T] -> Int block item: ref T -> Bool {
        0 => lower!
        values -> len => upper!
        lower! < upper! -> while {
            lower! + (upper! - lower!) / 2 => middle
            values[middle] -> yield => inPrefix
            inPrefix -> if {
                middle + 1 => lower!
            } else {
                middle => upper!
            }
        }
        lower!
    }

    # Unstable in-place partition. The typed block observes every original
    # element exactly once in index order. Selected elements are moved into the
    # prefix by the atomic collection exchange primitive, so owned elements are
    # never copied or exposed through an uninitialized place.
    public partitionInPlace<T>: self, values: mut [T; ~] -> Int block item: ref T -> Bool {
        values -> len => count
        0 => boundary!
        0 => index!
        index! < count -> while {
            values[index!] -> yield => selected
            selected -> if {
                values -> exchange(boundary!, index!)
                boundary! + 1 => boundary!
            }
            index! + 1 => index!
        }
        boundary!
    }
}

impl Ordering {
    # Equivalent values retain the first input. Like sort, these value-returning
    # operations require values that permit inline copying from readonly inputs.
    public min<T, C>: self, left: T, right: T, comparison: C -> T where C: Comparison, C.Item == T {
        self -> before(right, left, comparison) -> if { right } else { left }
    }

    public max<T, C>: self, left: T, right: T, comparison: C -> T where C: Comparison, C.Item == T {
        self -> before(left, right, comparison) -> if { right } else { left }
    }

    public clamp<T, C>: self, value: T, lower: T, upper: T, comparison: C -> Result<T, Error> where C: Comparison, C.Item == T {
        self -> before(upper, lower, comparison)
            -> if { Result<T, Error>.Err(Error.ReversedBounds) -> return }
        self -> before(value, lower, comparison)
            -> if { Result<T, Error>.Ok(lower) -> return }
        self -> before(upper, value, comparison)
            -> if { Result<T, Error>.Ok(upper) -> return }
        Result<T, Error>.Ok(value)
    }

    before<T, C>: self, left: ref T, right: ref T, comparison: C -> Bool where C: Comparison, C.Item == T {
        comparison -> Comparison.compare(left, right) => order
        self.direction -> when {
            Ascending { order < 0 }
            Descending { order > 0 }
        }
    }

    exchange<T>: self, values: mut [T; ~], left: Int, right: Int -> Unit {
        values[left] => previous
        values[right] => values[left]
        previous => values[right]
    }

    siftDown<T, C>: self, values: mut [T; ~], start: Int, count: Int, comparison: C -> Unit where C: Comparison, C.Item == T {
        start => root!
        root! < count / 2 -> while {
            root! * 2 + 1 => child!
            child! + 1 < count
                and self -> before(values[child!], values[child! + 1], comparison)
                -> if { child! + 1 => child! }
            self -> before(values[root!], values[child!], comparison)
                -> unless { return }
            self -> exchange(values, root!, child!)
            child! => root!
        }
    }

    # Unstable heapsort: worst-case O(n log n) comparisons, O(1) extra storage.
    # The caller retains its array, length, and capacity. Elements must permit
    # inline copying; owned elements are rejected by the ordinary ownership rules.
    public sort<T, C>: self, values: mut [T; ~], comparison: C -> Unit where C: Comparison, C.Item == T {
        values -> len => count
        count / 2 => parent!
        parent! > 0 -> while {
            parent! - 1 => parent!
            self -> siftDown(values, parent!, count, comparison)
        }
        count => remaining!
        remaining! > 1 -> while {
            remaining! - 1 => remaining!
            self -> exchange(values, 0, remaining!)
            self -> siftDown(values, 0, remaining!, comparison)
        }
    }

    mergeStable<T, C>: self, values: mut [T; ~], scratch: mut [T; ~], start: Int, middle: Int, end: Int, comparison: C -> Unit where C: Comparison, C.Item == T {
        start => index!
        index! < end -> while {
            values[index!] => scratch[index!]
            index! + 1 => index!
        }

        start => left!
        middle => right!
        start => output!
        output! < end -> while {
            false => takeRight!
            left! >= middle -> if {
                true => takeRight!
            } else {
                right! < end -> if {
                    self -> before(scratch[right!], scratch[left!], comparison) => takeRight!
                }
            }
            takeRight! -> if {
                scratch[right!] => values[output!]
                right! + 1 => right!
            } else {
                scratch[left!] => values[output!]
                left! + 1 => left!
            }
            output! + 1 => output!
        }
    }

    # Stable bottom-up merge sort for inline-copyable elements. Scratch storage
    # is caller-owned and must already contain at least values.len elements.
    # Insufficient scratch is rejected before either array is changed.
    public stableSort<T, C>: self, values: mut [T; ~], scratch: mut [T; ~], comparison: C -> Result<Unit, StableSortError> where C: Comparison, C.Item == T {
        values -> len => count
        (scratch -> len) < count -> if {
            Result<Unit, StableSortError>.Err(StableSortError.InsufficientScratch) -> return
        }

        1 => width!
        width! < count -> while {
            0 => start!
            start! < count -> while {
                start! + width! => middle!
                middle! > count -> if { count => middle! }
                middle! => end!
                (count - middle!) < width! -> if {
                    count => end!
                } else {
                    middle! + width! => end!
                }
                self -> mergeStable(values, scratch, start!, middle!, end!, comparison)
                end! => start!
            }
            width! > count / 2 -> if {
                count => width!
            } else {
                width! * 2 => width!
            }
        }
        Result<Unit, StableSortError>.Ok
    }

    # Stable merge into caller-owned initialized output. Both sorted inputs are
    # borrowed and remain reusable. Output validation completes before writing.
    public mergeSorted<T, C>: self, left: [T], right: [T], output: mut [T; ~], comparison: C -> Result<Int, MergeError> where C: Comparison, C.Item == T {
        left -> len => leftLength
        right -> len => rightLength
        leftLength > 2_147_483_647 - rightLength
            -> if {
                Result<Int, MergeError>.Err(MergeError.LengthOverflow) -> return
            }
        leftLength + rightLength => required
        (output -> capacity) < required -> if {
            Result<Int, MergeError>.Err(MergeError.InsufficientOutputCapacity) -> return
        }
        (output -> len) < required -> if {
            Result<Int, MergeError>.Err(MergeError.InsufficientOutputLength) -> return
        }

        0 => leftIndex!
        0 => rightIndex!
        0 => outputIndex!
        outputIndex! < required -> while {
            false => takeRight!
            leftIndex! >= leftLength -> if {
                true => takeRight!
            } else {
                rightIndex! < rightLength -> if {
                    self -> before(right[rightIndex!], left[leftIndex!], comparison) => takeRight!
                }
            }
            takeRight! -> if {
                right[rightIndex!] => output[outputIndex!]
                rightIndex! + 1 => rightIndex!
            } else {
                left[leftIndex!] => output[outputIndex!]
                leftIndex! + 1 => leftIndex!
            }
            outputIndex! + 1 => outputIndex!
        }
        Result<Int, MergeError>.Ok(required)
    }

    # The array must already be sorted by this direction and comparator.
    # Return the first equal position, or the insertion position when absent.
    # This borrows the existing growable storage without copying its elements.
    public lowerBound<T, C>: self, values: [T], needle: ref T, comparison: C -> Int where C: Comparison, C.Item == T {
        0 => lower!
        values -> len => upper!
        lower! < upper! -> while {
            lower! + (upper! - lower!) / 2 => middle
            self -> before(values[middle], needle, comparison)
                -> if {
                    middle + 1 => lower!
                } else {
                    middle => upper!
                }
        }
        lower!
    }

    public upperBound<T, C>: self, values: [T], needle: ref T, comparison: C -> Int where C: Comparison, C.Item == T {
        0 => lower!
        values -> len => upper!
        lower! < upper! -> while {
            lower! + (upper! - lower!) / 2 => middle
            self -> before(needle, values[middle], comparison)
                -> if {
                    middle => upper!
                } else {
                    middle + 1 => lower!
                }
        }
        lower!
    }

    public equalRange<T, C>: self, values: [T], needle: ref T, comparison: C -> EqualRange where C: Comparison, C.Item == T {
        EqualRange {
            start: self -> lowerBound(values, needle, comparison),
            end: self -> upperBound(values, needle, comparison)
        }
    }

    public isSorted<T, C>: self, values: [T], comparison: C -> Bool where C: Comparison, C.Item == T {
        1 => index!
        index! < (values -> len) -> while {
            self -> before(values[index!], values[index! - 1], comparison)
                -> if { false -> return }
            index! + 1 => index!
        }
        true
    }

    public binarySearchRef<T, C>: self, values: [T], needle: ref T, comparison: C -> SearchResult where C: Comparison, C.Item == T {
        self -> lowerBound(values, needle, comparison) => lower
        false => found!
        lower < (values -> len) -> if {
            comparison -> Comparison.compare(values[lower], needle) == 0 => found!
        }
        SearchResult { index: lower, found: found! }
    }

    # Copyable needles retain the literal-friendly compatibility surface.
    public binarySearch<T, C>: self, values: [T], needle: T, comparison: C -> SearchResult where C: Comparison, C.Item == T {
        self -> binarySearchRef(values, needle, comparison)
    }
}
