namespace sys.path

# Compiler/runtime ABI bindings for the public sys.path value model. Pure path
# operations remain in stdlib/sys/path.slg; this fragment owns only host and
# target boundaries and adds no wrapper frame.
impl Path {
    public queryRaw: self -> Result<RawInfo, Text> uses File = intrinsic

    public pathText: self -> Text = intrinsic
}

# The compiled target decides this value; it never reflects the build host.
public nativeStyle: -> Style = intrinsic
