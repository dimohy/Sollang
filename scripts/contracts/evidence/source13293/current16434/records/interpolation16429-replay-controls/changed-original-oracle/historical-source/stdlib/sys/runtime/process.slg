namespace sys.process

# Compiler/runtime ABI bindings for the public sys.process model. The logical
# module identity remains sys.process while the physical runtime layer is kept
# separate from the user-facing type definitions.
public arguments: -> Arguments uses Process = intrinsic

public environment name: Text -> Option<Text> uses Environment = intrinsic

impl Command {
    public spawn: move self -> Result<Child, Text> uses Process = intrinsic

    public run: move self -> Result<Int, Text> uses Process = intrinsic

    public runToFile: move self, output: Text -> Result<Int, Text> uses Process, File = intrinsic

    # Overrides stdout and stderr with private pipes, drains both concurrently,
    # and retains at most the explicitly requested bytes for each stream.
    public collect: move self, limits: CaptureLimits -> Result<CapturedOutput, Text> uses Process = intrinsic
}

impl Child {
    # Pure domain projection. The compiler lowers this directly from the Child
    # aggregate; it is not an operating-system call or wrapper frame.
    public id: self -> ProcessId = intrinsic

    # Observes completion without blocking and preserves the exact terminal
    # domain. A signal is successful observation rather than a wait failure.
    public tryWaitTermination: mut self -> Result<Option<TerminationStatus>, Text> uses Process {
        self.completionState -> when {
            == 1 {
                TerminationStatus.Exited(ExitStatus { code: self.exitCode })
                    -> Option<TerminationStatus>.Some
                    -> Result<Option<TerminationStatus>, Text>.Ok
            }
            == 2 {
                TerminationStatus.Signaled(SignalStatus { number: self.exitCode })
                    -> Option<TerminationStatus>.Some
                    -> Result<Option<TerminationStatus>, Text>.Ok
            }
            else {
                self.token -> pollChild => polled
                polled.state -> when {
                    == 2 { Result<Option<TerminationStatus>, Text>.Err("wait") }
                    == 0 { Result<Option<TerminationStatus>, Text>.Ok(Option<TerminationStatus>.None) }
                    == 3 {
                        0 => self.token
                        polled.exitCode => self.exitCode
                        2 => self.completionState
                        TerminationStatus.Signaled(SignalStatus { number: self.exitCode })
                            -> Option<TerminationStatus>.Some
                            -> Result<Option<TerminationStatus>, Text>.Ok
                    }
                    == 1 {
                        0 => self.token
                        polled.exitCode => self.exitCode
                        1 => self.completionState
                        TerminationStatus.Exited(ExitStatus { code: self.exitCode })
                            -> Option<TerminationStatus>.Some
                            -> Result<Option<TerminationStatus>, Text>.Ok
                    }
                    else { Result<Option<TerminationStatus>, Text>.Err("wait") }
                }
            }
        }
    }

    # Compatibility projection for callers that have not yet adopted the typed
    # terminal outcome. It delegates to the same single poll/reap authority.
    public tryWait: mut self -> Result<Option<ExitStatus>, Text> uses Process {
        self -> tryWaitTermination -> when {
            Result<Option<TerminationStatus>, Text>.Err(error) {
                Result<Option<ExitStatus>, Text>.Err(error)
            }
            Result<Option<TerminationStatus>, Text>.Ok(status) {
                status -> when {
                    Option<TerminationStatus>.None {
                        Result<Option<ExitStatus>, Text>.Ok(Option<ExitStatus>.None)
                    }
                    Option<TerminationStatus>.Some(termination) {
                        termination -> when {
                            TerminationStatus.Exited(exit) {
                                Result<Option<ExitStatus>, Text>.Ok(Option<ExitStatus>.Some(exit))
                            }
                            TerminationStatus.Signaled(signal) {
                                Result<Option<ExitStatus>, Text>.Err("signal")
                            }
                        }
                    }
                }
            }
        }
    }

    # Requests forced termination without consuming or reaping the owner. The
    # existing wait/tryWait path remains the single authority that observes and
    # caches terminal state, so successful kill never closes the native token.
    public kill: mut self -> Result<Unit, Text> uses Process {
        self.completionState -> when {
            == 0 {
                self.token -> killChild -> if {
                    Result<Unit, Text>.Ok
                } else {
                    Result<Unit, Text>.Err("kill")
                }
            }
            else { Result<Unit, Text>.Ok }
        }
    }

    public wait: move self -> Result<ExitStatus, Text> uses Process = intrinsic
}

impl ProcessId {
    # Transparent numeric observation of the domain value.
    public asUInt64: self -> UInt64 = intrinsic
}

public exit code: Int -> Unit uses Process = intrinsic

pollChild token: UInt64 -> ChildPoll uses Process = intrinsic

killChild token: UInt64 -> Bool uses Process = intrinsic
