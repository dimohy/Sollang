namespace std.archive.zip.decoder_phase

# Internal streaming phases are a domain value rather than magic integers.
# Decoder keeps the field private; users observe only write and finish.
public enum Phase {
    LocalHeader
    LocalName
    LocalExtra
    Payload
    CentralHeader
    CentralName
    CentralExtra
    CentralComment
    EndOfCentralDirectory
    ArchiveComment
    Complete
}
