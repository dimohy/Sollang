namespace std.compress.gzip.decoder_phase

# Internal streaming phases are a domain value rather than magic integers.
# Decoder keeps the field private; users observe only write/finish behavior.
public enum Phase {
    HeaderFixed
    HeaderExtraLength
    HeaderExtra
    HeaderName
    HeaderComment
    HeaderChecksum
    BlockHeader
    StoredHeader
    StoredData
    Dynamic
    Compressed
    TrailerChecksum
    TrailerSize
}
