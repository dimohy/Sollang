namespace std.crypto.random

import sys.runtime as rt

public enum Error {
    Unavailable
}

public struct SecureRandom {
    public marker: UInt8
}

public secure: -> SecureRandom => SecureRandom { marker: 0 }

impl SecureRandom {
    # Returns independently owned bytes produced by the operating system
    # cryptographic random source. The zero-state receiver is a capability
    # value; runtime support is linked only when this method is reachable.
    public bytes: self, count: UIntSize -> Result<[UInt8; ~], Error> uses Random {
        count -> rt.secureRandomBytes
    }
}
