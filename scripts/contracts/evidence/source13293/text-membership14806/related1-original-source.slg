trait Hash { hash: self -> Int }
trait Eq { eq: self -> Int }

struct Key { id: Int }
impl Hash for Key { hash: self -> Int => self.id }
impl Eq for Key { eq: self -> Int => self.id }

show values: ref Set<Int> -> Unit uses Console {
    "readonly=$(values -> contains(7)),$(values -> contains(9))" -> println
}

main {
    Set<Text>(4) => words!
    words! -> insert("alpha") => textInserted
    textInserted -> println
    "alpha" => textQuery
    "beta" => textMissing
    "text=$(words! -> contains(textQuery)),$(words! -> contains(textMissing))" -> println

    Set<Key>(4) => keys!
    keys! -> insert(Key { id: 1 }) => nominalInserted
    nominalInserted -> println
    Key { id: 1 } => nominalQuery
    Key { id: 2 } => nominalMissing
    "nominal=$(keys! -> contains(nominalQuery)),$(keys! -> contains(nominalMissing))" -> println

    Set<Int>(4) => numbers!
    numbers! -> insert(7) => integerInserted
    integerInserted -> println
    numbers! -> show
}
