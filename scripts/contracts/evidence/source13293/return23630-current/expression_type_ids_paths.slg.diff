+# Expression coordinates are stable while type/status facts remain live.
+# Append candidates in expression order, scoped to their own function's final
+# direct body value. The round's expression limit keeps new call facts for the
+# next round, while existing candidates retain their live type/status facts.
+synchronizeInferredReturnCandidates prepared: ref semanticContext.SemanticSnapshot, bodies: ref [Int; ~], expressions: ref [ExpressionTypeId; ~], limit: Int, first: mut [Int; ~], last: mut [Int; ~], next: mut [Int; ~], distances: mut [Int; ~] -> Unit {
+    (first -> len) == 0 -> if {
+        prepared.package.nodes -> each _ { first -> push(-1)
+            last -> push(-1) }
+    }
+    Int(next -> len) < limit -> while {
+        Int(next -> len) => expressionIndex
+        expressions[expressionIndex] => expression
+        prepared.package.ranges[expression.sourceModule] => range
+        expression.astNode => root!
+        prepared.package.nodes[range.astStart + root!].parent => ancestor!
+        1 => distance!
+        -1 => owner!
+        true => searching!
+        ancestor! >= 0 and searching! -> while {
+            prepared.package.nodes[range.astStart + ancestor!] => parent
+            parent.kind == 7 or parent.kind == 29 or parent.kind == 31
+                -> if {
+                    range.astStart + ancestor! => owner!
+                    false => searching!
+                } else {
+                    parent.kind == 71 -> if { false => searching! } else {
+                        ancestor! => root!
+                        parent.parent => ancestor!
+                        distance! + 1 => distance!
+                    }
+                }
+        }
+        next -> push(-1)
+        distances -> push(distance!)
+        owner! >= 0 and bodies[owner!] == root!
+            and (prepared.package.nodes[range.astStart + root!].kind != 47 or expression.astNode != root!)
+            -> if {
+                last[owner!] >= 0 -> if { expressionIndex => next[last[owner!]] } else {
+                    expressionIndex => first[owner!]
+                }
+                expressionIndex => last[owner!]
+            }
+    }
+}
