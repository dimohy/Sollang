import regression.same_name_frames as frames
import regression.same_name_codec as codec

# The source constructor's opening parenthesis must not hide the later
# qualified flow target or redirect it to this same-named function.
encode version: Int -> Result<Int, codec.Error> {
    frames.Value.Crypto(frames.Payload { code: version }) -> codec.encode? => decoded
    Result<Int, codec.Error>.Ok(decoded)
}

main {
    6 -> encode -> when {
        Ok(answer) { "$answer" -> println }
        Err(error) { "error=$(error.code)" -> println }
    }
}