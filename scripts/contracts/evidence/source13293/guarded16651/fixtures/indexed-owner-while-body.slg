struct Sample { name: Text, values: [Int; ~] }
struct Group { items: [Sample; ~] }
borrow value: ref Sample -> ref Sample { value }
project group: ref Group -> Unit uses Console {
    0 => index!
    index! < (group.items -> len) -> while {
        group.items[index!] -> borrow => view
        view.name -> println
        index! + 1 => index!
    }
}
main {
    [Sample; ~] => items!
    items! -> push(Sample { name: "ok", values: [Int; ~] })
    Group { items: items! } => owner
    owner -> project
}
