struct Holder { values: [Int; <=3] }

inspect owner: ref Holder -> Int {
    0 => index!
    0 => total!
    index! < (owner.values -> len) -> while {
        total! + owner.values[index!] => total!
        index! + 1 => index!
    }
    total!
}

main {
    Holder { values: [20, 22] } => owner
    owner -> inspect -> println
}
