struct Inner { values: [Int; <= 3] }
struct Outer { child: Inner }

inspect owner: Outer -> Int {
    0 => index!
    owner.child.values[index!] != 0 -> while {
        index! + 1 => index!
    }
    index!
}

main {
    Outer { child: Inner { values: [1, 0] } } => owner
    owner -> inspect -> println
}
