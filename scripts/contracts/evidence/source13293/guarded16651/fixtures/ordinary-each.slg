struct Location { line: Int, column: Int }
emit values: [Int] -> Unit uses Console {
    values -> each item {
        Location { line: 1, column: 2 } => location
        "<main>" => moduleName!
        item < 0 -> if { "other" => moduleName! }
        "header at $(location.line):$(location.column): [module '$(moduleName!)'] " -> print
        "message" -> println
    }
}
main { [0] -> emit }
