namespace sollang.compiler.llvm.codegen_cache_key_policy

public changedOrder: -> KeyRule {
    [KeyPart; ~] => parts!
    parts! -> push(KeyPart.DependencyInterfaces)
    parts! -> push(KeyPart.Emissions)
    parts! -> push(KeyPart.TypeUniverse)
    parts! -> push(KeyPart.AmbientStandardLibrary)
    parts! -> push(KeyPart.SourceImplementation)
    parts! -> push(KeyPart.Identity)
    KeyRule {
        domain: "module-implementation"
        parts: parts!
    }
}

public changedDomain: -> KeyRule {
    [KeyPart; ~] => parts!
    parts! -> push(KeyPart.Identity)
    parts! -> push(KeyPart.SourceImplementation)
    parts! -> push(KeyPart.AmbientStandardLibrary)
    parts! -> push(KeyPart.TypeUniverse)
    parts! -> push(KeyPart.Emissions)
    parts! -> push(KeyPart.DependencyInterfaces)
    KeyRule {
        domain: "changed-domain"
        parts: parts!
    }
}

public domainOnly: -> KeyRule {
    [KeyPart; ~] => parts!
    KeyRule {
        domain: "domain-only"
        parts: parts!
    }
}

public repeated: -> KeyRule {
    [KeyPart; ~] => parts!
    parts! -> push(KeyPart.Identity)
    parts! -> push(KeyPart.Identity)
    KeyRule {
        domain: "repeated"
        parts: parts!
    }
}
