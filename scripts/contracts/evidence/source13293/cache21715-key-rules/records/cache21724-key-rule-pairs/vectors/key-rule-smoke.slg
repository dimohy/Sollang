namespace sollang.compiler.llvm.codegen_cache_key_policy

public changedOrder: -> KeyRule {
    KeyRule {
        domain: "module-implementation"
        parts: [KeyPart.DependencyInterfaces, KeyPart.Emissions, KeyPart.TypeUniverse, KeyPart.AmbientStandardLibrary, KeyPart.SourceImplementation, KeyPart.Identity; ~]
    }
}

public changedDomain: -> KeyRule {
    KeyRule {
        domain: "changed-domain"
        parts: [KeyPart.Identity, KeyPart.SourceImplementation, KeyPart.AmbientStandardLibrary, KeyPart.TypeUniverse, KeyPart.Emissions, KeyPart.DependencyInterfaces; ~]
    }
}

public domainOnly: -> KeyRule {
    KeyRule {
        domain: "domain-only"
        parts: [KeyPart; ~]
    }
}

public repeated: -> KeyRule {
    KeyRule {
        domain: "repeated"
        parts: [KeyPart.Identity, KeyPart.Identity; ~]
    }
}
