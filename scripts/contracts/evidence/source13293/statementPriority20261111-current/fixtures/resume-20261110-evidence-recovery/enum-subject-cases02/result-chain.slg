enum Step { Next(Int)
    Stop }
enum Failure { Invalid }
read step: Step -> Result<Int, Failure> {
    step -> when {
        Next(value) { Result<Int, Failure>.Ok(value) }
        Stop { Result<Int, Failure>.Err(Failure.Invalid) }
    }
}
main {
    Step.Next(7) -> read -> when {
        Ok(value) { value -> println }
        Err(_) { 0 -> println }
    }
}
