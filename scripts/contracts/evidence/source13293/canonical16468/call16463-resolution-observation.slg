                                        receiverInitializerResultTypeNode! >= 0
                                            -> if {
                                                -1 => receiverResultTypeId!
                                                lastSourceReferenceIndex(package, semantic.references, referenceIndex, receiverInitializer.targetSourceModule, receiverInitializerResultTypeNode!) => receiverReferenceIndex
                                                receiverReferenceIndex >= 0 -> if {
