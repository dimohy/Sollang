namespace sollang.compiler.semantic.calls

import sollang.compiler.ast as ast
import sollang.compiler.lexer as lexer
import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.module_resolve as moduleResolve
import sollang.compiler.semantic.modules as modules
import sollang.compiler.semantic.qualified as qualified
import sollang.compiler.semantic.symbols as symbols
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.syntax as syntax
import syntax.generated.slg as grammar

# Per-source typed call resolution extracted from resolveModulesTyped.
# Each invocation owns its candidate/result arrays and borrows global indexes.

typedMethodOwnerMatches types: ref [typeIds.SemanticType; ~], receiverTypeId: Int, ownerTypeId: Int, sliceOwner: Bool -> Bool {
    receiverTypeId < 0 or receiverTypeId >= (types -> len)
        or ownerTypeId < 0 or ownerTypeId >= (types -> len)
        -> if { false -> return }
    types[receiverTypeId] => receiver
    types[ownerTypeId] => owner
    receiver.status != 0 or owner.status != 0 -> if { false -> return }
    sliceOwner -> if {
        (owner.kind == 2 and (receiver.kind == 3 or receiver.kind == 4 or receiver.kind == 12)
            and owner.first == receiver.first) -> return
    }
    receiverTypeId == ownerTypeId -> if { true -> return }
    # Imported and local nominal references retain the same declaration identity.
    # Applications also retain their exact canonical arguments.
    ((receiver.kind == 1 or receiver.kind == 7) and receiver.kind == owner.kind
        and receiver.origin != 1 and receiver.origin != 3 and receiver.origin != 4
        and owner.origin != 1 and owner.origin != 3 and owner.origin != 4
        and receiver.module == owner.module and receiver.symbol == owner.symbol
        and receiver.first == owner.first and receiver.second == owner.second) -> return
}

typedMethodTraitAst package: ref analysis.PackageAnalysis, sourceModule: Int, implAst: Int, ownerAst: Int -> Int {
    package.ranges[sourceModule] => range
    -1 => traitAst!
    0 => childIndex!
    childIndex! < range.astCount -> while {
        package.nodes[range.astStart + childIndex!] => child
        child.parent == implAst and child.kind == 16 and childIndex! != ownerAst
            -> if {
                traitAst! < 0 or child.start < package.nodes[range.astStart + traitAst!].start
                    -> if { childIndex! => traitAst! }
            }
        childIndex! + 1 => childIndex!
    }
    traitAst!
}

typedMethodModulePrefixMatches sourceModule: Int, start: UIntSize, length: UIntSize, targetModule: Int, package: ref analysis.PackageAnalysis, identities: ref [modules.ModuleIdentity; ~], imports: ref [modules.ImportEdge; ~], resolvedImports: ref [moduleResolve.ResolvedImport; ~] -> Bool {
    length == 0 or targetModule < 0 or targetModule >= (identities -> len)
        -> if { false -> return }
    identities[targetModule] => target
    target.pathLength == length => equal!
    UIntSize(0) => namespaceByte!
    equal! and namespaceByte! < length -> while {
        (package.sources[sourceModule] -> byte(start + namespaceByte!)) != (package.sources[target.sourceIndex] -> byte(target.pathStart + namespaceByte!))
            -> if { false => equal! }
        namespaceByte! + 1 => namespaceByte!
    }
    equal! -> if { true -> return }
    resolvedImports -> each imported {
        imported.sourceModule == sourceModule and imported.status == 0
            and imported.edge >= 0 and imported.edge < (imports -> len)
            and imported.targetModule >= 0 and imported.targetModule < (identities -> len)
            and modules.sameLogicalAnalyzedSource(package.sources, identities, identities[imported.targetModule].sourceIndex, target.sourceIndex, package.tokens, package.ranges)
            -> if {
                imports[imported.edge] => edge
                package.ranges[sourceModule] => range
                edge.aliasToken >= 0 and edge.aliasToken < range.tokenCount
                    -> if {
                        package.tokens[range.tokenStart + edge.aliasToken] => alias
                        alias.span.length == length => aliasEqual!
                        UIntSize(0) => aliasByte!
                        aliasEqual! and aliasByte! < length -> while {
                            (package.sources[sourceModule] -> byte(start + aliasByte!)) != (package.sources[sourceModule] -> byte(alias.span.start + aliasByte!))
                                -> if { false => aliasEqual! }
                            aliasByte! + 1 => aliasByte!
                        }
                        aliasEqual! -> if { true -> return }
                    }
            }
    }
    false
}

# Resolve a real source span through the same module and import-alias identities
# used by qualified source paths. Interpolation paths need no fabricated AST.
public resolveTypedMethodTraitPrefix sourceModule: Int, start: UIntSize, length: UIntSize, package: ref analysis.PackageAnalysis, identities: ref [modules.ModuleIdentity; ~], imports: ref [modules.ImportEdge; ~], resolvedImports: ref [moduleResolve.ResolvedImport; ~] -> TypedMethodQualifier {
    TypedMethodQualifier { targetModule: -1, targetSymbol: -1, status: -1 } => missing
    sourceModule < 0 or sourceModule >= (package.sources -> len)
        or sourceModule >= (identities -> len) or length == 0
        -> if { missing -> return }
    package.sources[sourceModule] -> len => sourceLength
    start > sourceLength or length > sourceLength - start
        -> if { missing -> return }
    start => nameStart!
    start => byteIndex!
    byteIndex! < start + length -> while {
        (package.sources[sourceModule] -> byte(byteIndex!)) == 46
            -> if { byteIndex! + 1 => nameStart! }
        byteIndex! + 1 => byteIndex!
    }
    start + length - nameStart! => nameLength
    nameLength == 0 -> if { missing -> return }
    missing => selected!
    0 => qualifierPass!
    qualifierPass! < 2 -> while {
        0 => moduleIndex!
        moduleIndex! < (identities -> len) -> while {
            identities[moduleIndex!] => identity
            identity.sourceIndex => targetSource
            targetSource >= 0 and targetSource < (package.ranges -> len)
                and ((qualifierPass! == 0 and modules.sameLogicalAnalyzedSource(package.sources, identities, identity.sourceIndex, identities[sourceModule].sourceIndex, package.tokens, package.ranges))
                or (qualifierPass! == 1 and not modules.sameLogicalAnalyzedSource(package.sources, identities, identity.sourceIndex, identities[sourceModule].sourceIndex, package.tokens, package.ranges)))
                -> if {
                    false => reachable!
                    false => namespaceEqual!
                    nameStart! == start and modules.sameLogicalAnalyzedSource(package.sources, identities, identity.sourceIndex, identities[sourceModule].sourceIndex, package.tokens, package.ranges)
                        -> if { true => reachable! }
                    nameStart! > start -> if {
                        nameStart! - start - 1 => prefixLength
                        identity.pathLength == prefixLength => namespaceEqual!
                        UIntSize(0) => namespaceByte!
                        namespaceEqual! and namespaceByte! < prefixLength
                            -> while {
                                (package.sources[sourceModule] -> byte(start + namespaceByte!)) != (package.sources[targetSource] -> byte(identity.pathStart + namespaceByte!))
                                    -> if { false => namespaceEqual! }
                                namespaceByte! + 1 => namespaceByte!
                            }
                        namespaceEqual! and modules.sameLogicalAnalyzedSource(package.sources, identities, identity.sourceIndex, identities[sourceModule].sourceIndex, package.tokens, package.ranges)
                            -> if { true => reachable! }
                    }
                    resolvedImports -> each imported {
                        imported.sourceModule == sourceModule and imported.status == 0
                            and imported.edge >= 0 and imported.edge < (imports -> len)
                            and imported.targetModule >= 0 and imported.targetModule < (identities -> len)
                            and modules.sameLogicalAnalyzedSource(package.sources, identities, identities[imported.targetModule].sourceIndex, identity.sourceIndex, package.tokens, package.ranges)
                            -> if {
                                nameStart! == start or namespaceEqual! -> if { true => reachable! } else {
                                    imports[imported.edge] => edge
                                    package.ranges[sourceModule] => callerRange
                                    edge.aliasToken >= 0 and edge.aliasToken < callerRange.tokenCount
                                        -> if {
                                            package.tokens[callerRange.tokenStart + edge.aliasToken] => alias
                                            alias.span.length == nameStart! - start - 1 => aliasEqual!
                                            UIntSize(0) => aliasByte!
                                            aliasEqual! and aliasByte! < alias.span.length
                                                -> while {
                                                    (package.sources[sourceModule] -> byte(start + aliasByte!)) != (package.sources[sourceModule] -> byte(alias.span.start + aliasByte!))
                                                        -> if { false => aliasEqual! }
                                                    aliasByte! + 1 => aliasByte!
                                                }
                                            aliasEqual! -> if { true => reachable! }
                                        }
                                }
                            }
                    }
                    reachable! -> if {
                        package.ranges[targetSource] => range
                        0 => symbolIndex!
                        symbolIndex! < range.symbolCount -> while {
                            package.symbols[range.symbolStart + symbolIndex!] => declaration
                            declaration.kind == 5 and declaration.nameToken >= 0
                                -> if {
                                    package.tokens[range.tokenStart + declaration.nameToken] => name
                                    name.span.length == nameLength => equal!
                                    UIntSize(0) => nameByte!
                                    equal! and nameByte! < nameLength -> while {
                                        (package.sources[sourceModule] -> byte(nameStart! + nameByte!)) != (package.sources[targetSource] -> byte(name.span.start + nameByte!))
                                            -> if { false => equal! }
                                        nameByte! + 1 => nameByte!
                                    }
                                    equal! -> if {
                                        selected!.status >= 0 -> if {
                                            2 => selected!.status
                                            -1 => selected!.targetSymbol
                                        } else {
                                            moduleIndex! => selected!.targetModule
                                            symbolIndex! => selected!.targetSymbol
                                            modules.sameLogicalAnalyzedSource(package.sources, identities, identity.sourceIndex, identities[sourceModule].sourceIndex, package.tokens, package.ranges)
                                                or declaration.flags / 4 % 2 == 1
                                                -> if { 0 } else { 1 } => selected!.status
                                        }
                                    }
                                }
                            symbolIndex! + 1 => symbolIndex!
                        }
                    }
                }
            moduleIndex! + 1 => moduleIndex!
        }
        selected!.status >= 0 -> if { selected! -> return }
        qualifierPass! + 1 => qualifierPass!
    }
    selected!
}

# Shared declaration selection after receiver typing. Ordinary source calls and
# retained interpolation calls supply their own real target identity to this
# boundary; neither consumer may replace the selected method with a free call.
# Instance selection requires the declaration's actual primary type, not
# just membership in an impl. Associated typed inputs retain their own type.
struct TypedMethodReferenceIndex {
    heads: [Int; ~]
    previous: [Int; ~]
}

typedMethodReferenceBucket package: ref analysis.PackageAnalysis, sourceIndex: Int, typeAst: Int -> Int {
    sourceIndex >= 0 and sourceIndex < (package.ranges -> len) and typeAst >= 0
        -> if {
            package.ranges[sourceIndex] => range
            typeAst < range.astCount and range.astStart >= 0
                and range.astStart < (package.nodes -> len)
                and typeAst < (package.nodes -> len) - range.astStart
                -> if { range.astStart + typeAst -> return }
        }
    package.nodes -> len
}

indexTypedMethodReferences package: ref analysis.PackageAnalysis, references: ref [typeIds.TypeReference; ~] -> TypedMethodReferenceIndex {
    [Int; ~] => heads!
    0 => slot!
    slot! <= (package.nodes -> len) -> while {
        heads! -> push(-1)
        slot! + 1 => slot!
    }
    [Int; ~] => previous!
    0 => referenceIndex!
    references -> each reference {
        previous! -> push(-1)
        reference.status == 0 -> if {
            package -> typedMethodReferenceBucket(reference.sourceModule, reference.typeAst) => bucket
            heads![bucket] => previous![referenceIndex!]
            referenceIndex! => heads![bucket]
        }
        referenceIndex! + 1 => referenceIndex!
    }
    TypedMethodReferenceIndex { heads: heads!, previous: previous! }
}

lastTypedMethodReference package: ref analysis.PackageAnalysis, references: ref [typeIds.TypeReference; ~], index: ref TypedMethodReferenceIndex, sourceIndex: Int, typeAst: Int -> Int {
    typeAst < 0 -> if { -1 -> return }
    package -> typedMethodReferenceBucket(sourceIndex, typeAst) => bucket
    index.heads[bucket] => referenceIndex!
    referenceIndex! >= 0 -> while {
        references[referenceIndex!] => reference
        reference.sourceModule == sourceIndex and reference.typeAst == typeAst
            -> if { reference.typeId -> return }
        index.previous[referenceIndex!] => referenceIndex!
    }
    -1
}

typedMethodReferenceMatches package: ref analysis.PackageAnalysis, references: ref [typeIds.TypeReference; ~], index: ref TypedMethodReferenceIndex, sourceIndex: Int, typeAst: Int, typeId: Int -> Bool {
    # Standalone method resolution has no prepared index and retains its
    # original linear lookup. Prepared declarations retain every valid row.
    (index.heads -> len) == 0 -> if {
        references -> each reference {
            reference.sourceModule == sourceIndex and reference.typeAst == typeAst
                and reference.status == 0 and reference.typeId == typeId
                -> if { true -> return }
        }
        false -> return
    }
    package -> typedMethodReferenceBucket(sourceIndex, typeAst) => bucket
    index.heads[bucket] => referenceIndex!
    referenceIndex! >= 0 -> while {
        references[referenceIndex!] => reference
        reference.sourceModule == sourceIndex and reference.typeAst == typeAst and reference.typeId == typeId
            -> if { true -> return }
        index.previous[referenceIndex!] => referenceIndex!
    }
    false
}

typedMethodPrimaryMatches package: ref analysis.PackageAnalysis, references: ref [typeIds.TypeReference; ~], sourceIndex: Int, functionSymbol: Int, ownerTypeId: Int, referenceIndex: ref TypedMethodReferenceIndex -> Bool {
    package.ranges[sourceIndex] => range
    package.symbols[range.symbolStart + functionSymbol] => function
    function.kind == 31 and function.astNode >= 0
        and package.nodes[range.astStart + function.astNode].secondaryToken >= 0
        -> if { true -> return }
    0 => symbolIndex!
    symbolIndex! < range.symbolCount -> while {
        package.symbols[range.symbolStart + symbolIndex!] => parameter
        parameter.kind == 35 and parameter.parent == functionSymbol
            and parameter.astNode == function.astNode and parameter.typeNode >= 0
            -> if {
                typedMethodReferenceMatches(package, references, referenceIndex, sourceIndex, parameter.typeNode, ownerTypeId)
                    -> if { true -> return }
            }
        symbolIndex! + 1 => symbolIndex!
    }
    false
}

# Immutable declaration facts; receiver selection and diagnostic ordering remain per call.
struct TypedMethodDeclarationFacts {
    ownerTypes: [Int; ~]
    primaryMatches: [Bool; ~]
    traitAsts: [Int; ~]
    methodSymbols: [Int; ~]
    methodStarts: [Int; ~]
    methodCounts: [Int; ~]
    openFunctionSymbols: [Int; ~]
    openFunctionStarts: [Int; ~]
    openFunctionCounts: [Int; ~]
    importReachability: [Bool; ~]
}

prepareTypedMethodDeclarationFacts package: ref analysis.PackageAnalysis, references: ref [typeIds.TypeReference; ~], identities: ref [modules.ModuleIdentity; ~], resolvedImports: ref [moduleResolve.ResolvedImport; ~] -> TypedMethodDeclarationFacts {
    package -> indexTypedMethodReferences(references) => referenceIndex
    [Int; ~] => ownerTypes!
    [Bool; ~] => primaryMatches!
    [Int; ~] => traitAsts!
    [Int; ~] => methodSymbols!
    [Int; ~] => methodStarts!
    [Int; ~] => methodCounts!
    [Int; ~] => openFunctionSymbols!
    [Int; ~] => openFunctionStarts!
    [Int; ~] => openFunctionCounts!
    [Int; ~] => implOwnerTypes!
    [Int; ~] => implTraitAsts!
    package.symbols -> each symbol {
        ownerTypes! -> push(-1)
        primaryMatches! -> push(false)
        traitAsts! -> push(-1)
        implOwnerTypes! -> push(-2)
        implTraitAsts! -> push(-1)
    }
    package.ranges -> each range {
        methodSymbols! -> len => methodStart
        methodStarts! -> push(methodStart)
        openFunctionSymbols! -> len => openFunctionStart
        openFunctionStarts! -> push(openFunctionStart)
        0 => symbolIndex!
        symbolIndex! < range.symbolCount -> while {
            package.symbols[range.symbolStart + symbolIndex!] => method
            method.kind == 7 and method.flags / 4 % 2 == 1
                and (method.parent < 0 or (method.parent < range.symbolCount
                and package.symbols[range.symbolStart + method.parent].kind != 6))
                -> if { openFunctionSymbols! -> push(symbolIndex!) }
            (method.kind == 31 or method.kind == 7) and method.parent >= 0
                and method.parent < range.symbolCount and method.nameToken >= 0
                -> if {
                    package.symbols[range.symbolStart + method.parent] => implementation
                    implementation.kind == 6 and implementation.astNode >= 0
                        and implementation.astNode < range.astCount -> if {
                            methodSymbols! -> push(symbolIndex!)
                            range.symbolStart + method.parent => implSlot
                            implOwnerTypes![implSlot] == -2 -> if {
                                package -> typeIds.implOwnerTypeAst(range.sourceModule, implementation.astNode) => ownerAst
                                lastTypedMethodReference(package, references, referenceIndex, range.sourceModule, ownerAst)
                                    => implOwnerTypes![implSlot]
                                package -> typedMethodTraitAst(range.sourceModule, implementation.astNode, ownerAst)
                                    => implTraitAsts![implSlot]
                            }
                            implOwnerTypes![implSlot] => ownerTypes![range.symbolStart + symbolIndex!]
                            implTraitAsts![implSlot] => traitAsts![range.symbolStart + symbolIndex!]
                            typedMethodPrimaryMatches(package, references, range.sourceModule, symbolIndex!, implOwnerTypes![implSlot], referenceIndex)
                                => primaryMatches![range.symbolStart + symbolIndex!]
                        }
                }
            symbolIndex! + 1 => symbolIndex!
        }
        methodCounts! -> push((methodSymbols! -> len) - methodStart)
        openFunctionCounts! -> push((openFunctionSymbols! -> len) - openFunctionStart)
    }
    [Bool; ~] => importReachability!
    identities -> len => moduleCount
    0 => reachabilitySlot!
    reachabilitySlot! < (package.sources -> len) * moduleCount
        -> while {
            importReachability! -> push(false)
            reachabilitySlot! + 1 => reachabilitySlot!
        }
    resolvedImports -> each imported {
        imported.sourceModule >= 0 and imported.sourceModule < (package.sources -> len)
            and imported.status == 0 and imported.targetModule >= 0
            and imported.targetModule < moduleCount -> if {
                identities[imported.targetModule].pathHash => importedPathHash
                0 => reachableModule!
                reachableModule! < moduleCount -> while {
                    modules.sameLogicalAnalyzedSource(package.sources, identities, identities[reachableModule!].sourceIndex, identities[imported.targetModule].sourceIndex, package.tokens, package.ranges)
                        -> if {
                            true => importReachability![imported.sourceModule * moduleCount + reachableModule!]
                        }
                    reachableModule! + 1 => reachableModule!
                }
            }
    }
    TypedMethodDeclarationFacts { ownerTypes: ownerTypes!, primaryMatches: primaryMatches!, traitAsts: traitAsts!, methodSymbols: methodSymbols!, methodStarts: methodStarts!, methodCounts: methodCounts!, openFunctionSymbols: openFunctionSymbols!, openFunctionStarts: openFunctionStarts!, openFunctionCounts: openFunctionCounts!, importReachability: importReachability! }
}

public resolveTypedMethod request: TypedMethodRequest, package: ref analysis.PackageAnalysis, types: ref [typeIds.SemanticType; ~], references: ref [typeIds.TypeReference; ~], identities: ref [modules.ModuleIdentity; ~], imports: ref [modules.ImportEdge; ~], resolvedImports: ref [moduleResolve.ResolvedImport; ~], qualifiedResults: ref [qualified.QualifiedResolution; ~] -> TypedMethodResolution{
    [Int; ~] => ownerTypes
    [Bool; ~] => primaryMatches
    [Int; ~] => traitAsts
    [Int; ~] => methodSymbols
    [Int; ~] => methodStarts
    [Int; ~] => methodCounts
    [Int; ~] => openFunctionSymbols
    [Int; ~] => openFunctionStarts
    [Int; ~] => openFunctionCounts
    [Bool; ~] => importReachability
    TypedMethodDeclarationFacts { ownerTypes: ownerTypes, primaryMatches: primaryMatches, traitAsts: traitAsts, methodSymbols: methodSymbols, methodStarts: methodStarts, methodCounts: methodCounts, openFunctionSymbols: openFunctionSymbols, openFunctionStarts: openFunctionStarts, openFunctionCounts: openFunctionCounts, importReachability: importReachability } => declarations
    request -> resolveTypedMethodWithDeclarations(package, types, references, identities, imports, resolvedImports, qualifiedResults, declarations)
}

resolveTypedMethodWithDeclarations request: TypedMethodRequest, package: ref analysis.PackageAnalysis, types: ref [typeIds.SemanticType; ~], references: ref [typeIds.TypeReference; ~], identities: ref [modules.ModuleIdentity; ~], imports: ref [modules.ImportEdge; ~], resolvedImports: ref [moduleResolve.ResolvedImport; ~], qualifiedResults: ref [qualified.QualifiedResolution; ~], declarations: ref TypedMethodDeclarationFacts -> TypedMethodResolution {
    TypedMethodResolution { targetModule: -1, targetSourceModule: -1, functionSymbol: -1, ownerTypeId: -1, traitModule: -1, traitSymbol: -1, status: -1 } => missing
    request.sourceModule < 0 or request.sourceModule >= (package.sources -> len)
        or request.sourceModule >= (identities -> len)
        or request.receiverTypeId < 0 or request.receiverTypeId >= (types -> len)
        or request.targetLength == 0 -> if { missing -> return }
    package.sources[request.sourceModule] -> len => sourceLength
    request.targetStart > sourceLength or request.targetLength > sourceLength - request.targetStart
        -> if { missing -> return }
    types -> typeIds.materializedReadTypeId(request.receiverTypeId) => receiverTypeId
    receiverTypeId < 0 or receiverTypeId >= (types -> len)
        -> if { missing -> return }
    types[receiverTypeId] => receiver
    receiver.status != 0 -> if { missing -> return }
    request.targetStart => memberStart!
    request.targetStart => pathByte!
    pathByte! < request.targetStart + request.targetLength
        -> while {
            (package.sources[request.sourceModule] -> byte(pathByte!)) == 46
                -> if { pathByte! + 1 => memberStart! }
            pathByte! + 1 => pathByte!
        }
    request.targetStart + request.targetLength - memberStart! => memberLength
    memberLength == 0 -> if { missing -> return }
    TypedMethodQualifier { targetModule: request.qualifiedTraitModule, targetSymbol: request.qualifiedTraitSymbol, status: request.qualifiedTraitModule >= 0
            -> if { 0 } else { -1 } } => requestedTrait!
    requestedTrait!.status < 0 and memberStart! > request.targetStart
        -> if {
            resolveTypedMethodTraitPrefix(request.sourceModule, request.targetStart, memberStart! - request.targetStart - 1, package, identities, imports, resolvedImports) => requestedTrait!
        }
    # Qualified trait, inherent exact/slice, then unqualified trait ambiguity.
    0 => selectionTier!
    memberStart! == request.targetStart and requestedTrait!.status < 0
        and request.qualifiedTargetStatus != 0 -> if { 1 => selectionTier! }
    selectionTier! < 3 -> while {
        missing => selected!
        2 => selectedRank!
        0 => ownerPass!
        ownerPass! < 2 -> while {
            0 => moduleIndex!
            moduleIndex! < (identities -> len) -> while {
                identities[moduleIndex!] => identity
                identity.sourceIndex => methodSource
                methodSource >= 0 and methodSource < (package.ranges -> len)
                    -> if {
                        false => reachable!
                        modules.sameLogicalAnalyzedSource(package.sources, identities, identity.sourceIndex, identities[request.sourceModule].sourceIndex, package.tokens, package.ranges)
                            -> if { true => reachable! }
                        receiver.module >= 0 and receiver.module < (identities -> len)
                            -> if {
                                modules.sameLogicalAnalyzedSource(package.sources, identities, identity.sourceIndex, identities[receiver.module].sourceIndex, package.tokens, package.ranges)
                                    -> if { true => reachable! }
                            }
                        (declarations.importReachability -> len) == 0
                            -> if {
                                resolvedImports -> each imported {
                                    imported.sourceModule == request.sourceModule and imported.status == 0
                                        and imported.targetModule >= 0 and imported.targetModule < (identities -> len)
                                        and modules.sameLogicalAnalyzedSource(package.sources, identities, identities[imported.targetModule].sourceIndex, identity.sourceIndex, package.tokens, package.ranges)
                                        -> if { true => reachable! }
                                }
                            } else {
                                declarations.importReachability[request.sourceModule * (identities -> len) + moduleIndex!]
                                    -> if { true => reachable! }
                            }
                        (request.qualifiedTargetStatus == 0 or request.qualifiedTargetStatus == 3)
                            and request.qualifiedTargetModule == moduleIndex!
                            -> if { true => reachable! }
                        reachable! -> if {
                            package.ranges[methodSource] => range
                            (declarations.ownerTypes -> len) == 0 -> if { range.symbolCount } else { declarations.methodCounts[methodSource] } => methodCount
                            0 => methodOffset!
                            methodOffset! < methodCount -> while {
                                (declarations.ownerTypes -> len) == 0 -> if { methodOffset! } else { declarations.methodSymbols[declarations.methodStarts[methodSource] + methodOffset!] } => symbolIndex
                                package.symbols[range.symbolStart + symbolIndex] => method
                                (method.kind == 31 or method.kind == 7) and method.parent >= 0
                                    and method.parent < range.symbolCount and method.nameToken >= 0
                                    and (not request.blockMethod or method.blockNameToken >= 0)
                                    -> if {
                                        package.symbols[range.symbolStart + method.parent] => implementation
                                        implementation.kind == 6 and implementation.astNode >= 0
                                            and implementation.astNode < range.astCount -> if {
                                                -1 => ownerTypeId!
                                                -1 => ownerAst!
                                                (declarations.ownerTypes -> len) == 0 -> if {
                                                    package -> typeIds.implOwnerTypeAst(methodSource, implementation.astNode) => ownerAst!
                                                    references -> each reference {
                                                        ownerAst! >= 0 and reference.sourceModule == methodSource and reference.typeAst == ownerAst!
                                                            and reference.status == 0 -> if { reference.typeId => ownerTypeId! }
                                                    }
                                                } else {
                                                    declarations.ownerTypes[range.symbolStart + symbolIndex] => ownerTypeId!
                                                }
                                                (types -> typedMethodOwnerMatches(receiverTypeId, ownerTypeId!, ownerPass! == 1))
                                                    and ((declarations.ownerTypes -> len) == 0 -> if {
                                                        [Int; ~] => referenceHeads
                                                        [Int; ~] => previousReferences
                                                        TypedMethodReferenceIndex { heads: referenceHeads, previous: previousReferences } => unpreparedReferences
                                                        typedMethodPrimaryMatches(package, references, methodSource, symbolIndex, ownerTypeId!, unpreparedReferences)
                                                    } else { declarations.primaryMatches[range.symbolStart + symbolIndex] })
                                                    -> if {
                                                        (declarations.ownerTypes -> len) == 0 -> if {
                                                            package -> typedMethodTraitAst(methodSource, implementation.astNode, ownerAst!)
                                                        } else { declarations.traitAsts[range.symbolStart + symbolIndex] } => traitAst
                                                        TypedMethodQualifier { targetModule: -1, targetSymbol: -1, status: -1 } => traitIdentity!
                                                        traitAst >= 0 -> if {
                                                            package.nodes[range.astStart + traitAst] => traitPathNode
                                                            resolveTypedMethodTraitPrefix(methodSource, traitPathNode.start, traitPathNode.length, package, identities, imports, resolvedImports) => traitIdentity!
                                                            qualifiedResults -> each traitPath {
                                                                traitPath.sourceModule == methodSource and traitPath.pathAst == traitAst
                                                                    and traitPath.status == 0 -> if {
                                                                        traitPath.targetModule => traitIdentity!.targetModule
                                                                        traitPath.targetSymbol => traitIdentity!.targetSymbol
                                                                        0 => traitIdentity!.status
                                                                    }
                                                            }
                                                        }
                                                        false => eligible!
                                                        0 => candidateRank!
                                                        selectionTier! == 1 and traitAst < 0 -> if {
                                                            modules.sameLogicalAnalyzedSource(package.sources, identities, identity.sourceIndex, identities[request.sourceModule].sourceIndex, package.tokens, package.ranges)
                                                                -> if {
                                                                    true => eligible!
                                                                    1 => candidateRank!
                                                                }
                                                            identity.pathLength == 0 -> if {
                                                                true => eligible!
                                                                0 => candidateRank!
                                                            }
                                                            (receiver.kind == 1 or receiver.kind == 7) and receiver.origin != 1
                                                                and receiver.origin != 3 and receiver.origin != 4
                                                                and receiver.module >= 0 and receiver.module < (identities -> len)
                                                                -> if {
                                                                    true => eligible!
                                                                    0 => candidateRank!
                                                                }
                                                        }
                                                        selectionTier! == 2 and traitAst >= 0 -> if { true => eligible! }
                                                        # C# qualified lookup accepts a module prefix as well as
                                                        # a trait prefix; the exact owner is still mandatory.
                                                        selectionTier! == 0 and memberStart! > request.targetStart
                                                            -> if {
                                                                (request.qualifiedTargetStatus == 0 or request.qualifiedTargetStatus == 3)
                                                                    and request.qualifiedTargetModule == moduleIndex!
                                                                    and request.qualifiedTargetSymbol == symbolIndex
                                                                    -> if { true => eligible! }
                                                                traitAst < 0 -> if {
                                                                    typedMethodModulePrefixMatches(request.sourceModule, request.targetStart, memberStart! - request.targetStart - 1, moduleIndex!, package, identities, imports, resolvedImports)
                                                                        -> if { true => eligible! }
                                                                }
                                                            }
                                                        selectionTier! == 0 and traitAst >= 0 -> if {
                                                            request.qualifiedTargetStatus == 0
                                                                and request.qualifiedTargetModule == moduleIndex!
                                                                and request.qualifiedTargetSymbol == symbolIndex
                                                                -> if { true => eligible! }
                                                            traitIdentity!.status == 0 and requestedTrait!.status == 0
                                                                and traitIdentity!.targetModule == requestedTrait!.targetModule
                                                                and traitIdentity!.targetSymbol == requestedTrait!.targetSymbol
                                                                -> if { true => eligible! }
                                                        }
                                                        eligible! -> if {
                                                            package.tokens[range.tokenStart + method.nameToken] => name
                                                            name.span.length == memberLength => equal!
                                                            UIntSize(0) => nameByte!
                                                            equal! and nameByte! < memberLength -> while {
                                                                (package.sources[methodSource] -> byte(name.span.start + nameByte!)) != (package.sources[request.sourceModule] -> byte(memberStart! + nameByte!))
                                                                    -> if { false => equal! }
                                                                nameByte! + 1 => nameByte!
                                                            }
                                                            equal! -> if {
                                                                selected!.status >= 0 and candidateRank! == selectedRank!
                                                                    -> if {
                                                                        2 => selected!.status
                                                                        -1 => selected!.functionSymbol
                                                                    }
                                                                selected!.status < 0 or candidateRank! < selectedRank!
                                                                    -> if {
                                                                        moduleIndex! => selected!.targetModule
                                                                        methodSource => selected!.targetSourceModule
                                                                        symbolIndex => selected!.functionSymbol
                                                                        ownerTypeId! => selected!.ownerTypeId
                                                                        traitIdentity!.targetModule => selected!.traitModule
                                                                        traitIdentity!.targetSymbol => selected!.traitSymbol
                                                                        candidateRank! => selectedRank!
                                                                        modules.sameLogicalAnalyzedSource(package.sources, identities, identity.sourceIndex, identities[request.sourceModule].sourceIndex, package.tokens, package.ranges)
                                                                            or method.flags / 4 % 2 == 1
                                                                            -> if { 0 } else { 1 } => selected!.status
                                                                    }
                                                            }
                                                        }
                                                    }
                                            }
                                    }
                                methodOffset! + 1 => methodOffset!
                            }
                        }
                    }
                moduleIndex! + 1 => moduleIndex!
            }
            selectionTier! != 2 and selected!.status >= 0
                -> if { selected! -> return }
            ownerPass! + 1 => ownerPass!
        }
        selected!.status >= 0 -> if { selected! -> return }
        selectionTier! + 1 => selectionTier!
    }
    missing
}

patternBindingTypeId sourceIndex: Int, binding: symbols.Symbol, package: ref analysis.PackageAnalysis, semantic: ref typeIds.SemanticTypeSet, identities: ref [modules.ModuleIdentity; ~], qualifiedResults: ref [qualified.QualifiedResolution; ~], localResults: ref [ModuleCallResolution; ~] -> Int {
    binding.kind != 35 or binding.astNode < 0 -> if { -1 -> return }
    package.ranges[sourceIndex] => sourceRange
    package.sources[sourceIndex] -> len => sourceLength
    package.sources[sourceIndex] -> slice(UIntSize(0), sourceLength) => source
    package.nodes[sourceRange.astStart + binding.astNode] => bindingAst
    binding.astNode => matchAncestor!
    -1 => matchAst!
    matchAncestor! >= 0 and matchAst! < 0 -> while {
        package.nodes[sourceRange.astStart + matchAncestor!] => matchCandidate
        matchCandidate.kind == 58 -> if { matchAncestor! => matchAst! }
        matchCandidate.parent => matchAncestor!
    }
    matchAst! < 0 -> if { -1 -> return }
    matchAst! => matchScope!
    package.nodes[sourceRange.astStart + matchAst!].parent => matchContainer
    bindingAst.start => matchSubjectEnd!
    matchContainer >= 0 -> if {
        package.nodes[sourceRange.astStart + matchContainer].start => matchSubjectEnd!
        package.nodes[sourceRange.astStart + matchContainer].parent => matchScope!
    }
    -1 => matchSubjectBindingAst!
    UIntSize(0) => matchSubjectStart!
    0 => matchSubjectNameIndex!
    matchSubjectNameIndex! < sourceRange.nameCount
        -> while {
            package.names[sourceRange.nameStart + matchSubjectNameIndex!] => matchSubjectName
            package.tokens[sourceRange.tokenStart + matchSubjectName.nameToken] => matchSubjectToken
            matchSubjectName.symbol >= 0
                and matchSubjectToken.span.start < matchSubjectEnd!
                and matchSubjectToken.span.start >= matchSubjectStart!
                -> if {
                    matchSubjectName.astNode => matchSubjectAncestor!
                    false => matchSubjectBelongs!
                    matchSubjectAncestor! >= 0 and not matchSubjectBelongs!
                        -> while {
                            matchSubjectAncestor! == matchScope!
                                -> if { true => matchSubjectBelongs! } else {
                                    package.nodes[sourceRange.astStart + matchSubjectAncestor!].parent
                                        => matchSubjectAncestor!
                                }
                        }
                    matchSubjectBelongs! -> if {
                        package.symbols[sourceRange.symbolStart + matchSubjectName.symbol]
                            => matchSubjectSymbol
                        matchSubjectSymbol.astNode => matchSubjectBindingAst!
                        matchSubjectToken.span.start => matchSubjectStart!
                    }
                }
            matchSubjectNameIndex! + 1 => matchSubjectNameIndex!
        }
    -1 => subjectTargetSource!
    -1 => subjectFunctionSymbol!
    UIntSize(0) => subjectEnd!
    0 => subjectLocalIndex!
    subjectLocalIndex! < (localResults -> len) -> while {
        localResults[subjectLocalIndex!] => subjectLocal
        subjectLocal.sourceModule == sourceIndex
            and subjectLocal.callAst >= 0
            and subjectLocal.callAst < sourceRange.astCount
            and subjectLocal.targetSourceModule >= 0
            and subjectLocal.functionSymbol >= 0
            -> if {
                package.nodes[sourceRange.astStart + subjectLocal.callAst] => subjectLocalCall
                subjectLocal.callAst == matchScope!
                    or subjectLocalCall.parent == matchScope!
                    or subjectLocalCall.parent == matchSubjectBindingAst!
                    => subjectLocalBelongs!
                not subjectLocalBelongs! and subjectLocalCall.parent >= 0
                    -> if {
                        package.nodes[sourceRange.astStart + subjectLocalCall.parent] => subjectLocalOwner
                        subjectLocalOwner.kind == 10
                            and subjectLocalOwner.parent == matchScope!
                            and subjectLocalOwner.start == subjectLocalCall.start
                            and subjectLocalOwner.length == subjectLocalCall.length
                            -> if { true => subjectLocalBelongs! }
                    }
                subjectLocalCall.start + subjectLocalCall.length => subjectLocalEnd
                subjectLocalBelongs!
                    and subjectLocalEnd <= bindingAst.start
                    and (subjectTargetSource! < 0 or subjectLocalEnd >= subjectEnd!)
                    -> if {
                        subjectLocalEnd => subjectEnd!
                        subjectLocal.targetSourceModule => subjectTargetSource!
                        subjectLocal.functionSymbol => subjectFunctionSymbol!
                    }
            }
        subjectLocalIndex! + 1 => subjectLocalIndex!
    }
    0 => subjectQualifiedIndex!
    subjectQualifiedIndex! < (qualifiedResults -> len)
        -> while {
            qualifiedResults[subjectQualifiedIndex!] => subjectQualified
            subjectQualified.sourceModule == sourceIndex
                and subjectQualified.status == 0
                and subjectQualified.targetModule >= 0
                and subjectQualified.targetSymbol >= 0
                -> if {
                    subjectQualified.pathAst => subjectAncestor!
                    false => subjectBelongs!
                    subjectAncestor! >= 0 and not subjectBelongs!
                        -> while {
                            subjectAncestor! == matchScope! or subjectAncestor! == matchSubjectBindingAst!
                                -> if { true => subjectBelongs! } else {
                                    package.nodes[sourceRange.astStart + subjectAncestor!].parent => subjectAncestor!
                                }
                        }
                    package.nodes[sourceRange.astStart + subjectQualified.pathAst] => subjectPath
                    subjectPath.start + subjectPath.length => subjectCandidateEnd
                    identities[subjectQualified.targetModule].sourceIndex => subjectCandidateSource
                    package.ranges[subjectCandidateSource] => subjectCandidateRange
                    subjectCandidateRange.symbolStart + subjectQualified.targetSymbol => subjectCandidateSymbolIndex
                    package.symbols[subjectCandidateSymbolIndex] => subjectCandidateSymbol
                    subjectBelongs!
                        and subjectCandidateEnd <= bindingAst.start
                        and (subjectCandidateSymbol.kind == 7 or subjectCandidateSymbol.kind == 31)
                        and (subjectTargetSource! < 0 or subjectCandidateEnd >= subjectEnd!)
                        -> if {
                            subjectCandidateEnd => subjectEnd!
                            subjectCandidateSource => subjectTargetSource!
                            subjectQualified.targetSymbol => subjectFunctionSymbol!
                        }
                }
            subjectQualifiedIndex! + 1 => subjectQualifiedIndex!
        }
    # A receiver-aware initializer can still be pending when its pattern arm is
    # visited. Recover its declaration only when the initializer's call name is
    # unique across the analyzed package; duplicate method names stay unresolved
    # rather than turning into an owner-agnostic fallback.
    subjectTargetSource! < 0 and matchSubjectBindingAst! >= 0
        -> if {
            -1 => subjectInitializerCallAst!
            UIntSize(0) => subjectInitializerCallStart!
            0 => subjectInitializerAstIndex!
            subjectInitializerAstIndex! < sourceRange.astCount
                -> while {
                    package.nodes[sourceRange.astStart + subjectInitializerAstIndex!]
                        => subjectInitializerCandidate
                    (subjectInitializerCandidate.kind == 10
                        or subjectInitializerCandidate.kind == 11
                        or subjectInitializerCandidate.kind == 48)
                        and subjectInitializerCandidate.parent == matchSubjectBindingAst!
                        and (subjectInitializerCallAst! < 0
                        or subjectInitializerCandidate.start >= subjectInitializerCallStart!)
                        -> if {
                            subjectInitializerAstIndex! => subjectInitializerCallAst!
                            subjectInitializerCandidate.start => subjectInitializerCallStart!
                        }
                    subjectInitializerAstIndex! + 1 => subjectInitializerAstIndex!
                }
            subjectInitializerCallAst! >= 0 -> if {
                package.nodes[sourceRange.astStart + subjectInitializerCallAst!]
                    => subjectInitializerCall
                -1 => subjectInitializerNameToken!
                subjectInitializerCall.firstToken => subjectInitializerTokenIndex!
                false => subjectInitializerInArguments!
                subjectInitializerTokenIndex! < subjectInitializerCall.firstToken + subjectInitializerCall.tokenCount
                    and not subjectInitializerInArguments!
                    -> while {
                        package.tokens[sourceRange.tokenStart + subjectInitializerTokenIndex!]
                            => subjectInitializerToken
                        subjectInitializerToken.kind == grammar.tokenIdLeftParen()
                            -> if { true => subjectInitializerInArguments! }
                        subjectInitializerToken.kind == grammar.tokenIdIdentifier()
                            and not subjectInitializerInArguments!
                            -> if { subjectInitializerTokenIndex! => subjectInitializerNameToken! }
                        subjectInitializerTokenIndex! + 1 => subjectInitializerTokenIndex!
                    }
                subjectInitializerNameToken! >= 0 -> if {
                    package.tokens[sourceRange.tokenStart + subjectInitializerNameToken!]
                        => subjectInitializerName
                    false => subjectInitializerFound!
                    false => subjectInitializerAmbiguous!
                    0 => subjectInitializerSource!
                    subjectInitializerSource! < (package.ranges -> len)
                        -> while {
                            package.ranges[subjectInitializerSource!] => subjectInitializerRange
                            package.sources[subjectInitializerSource!] -> len => subjectInitializerSourceLength
                            package.sources[subjectInitializerSource!]
                                -> slice(UIntSize(0), subjectInitializerSourceLength)
                                => subjectInitializerText
                            0 => subjectInitializerSymbol!
                            subjectInitializerSymbol! < subjectInitializerRange.symbolCount
                                -> while {
                                    package.symbols[subjectInitializerRange.symbolStart + subjectInitializerSymbol!]
                                        => subjectInitializerDeclaration
                                    (subjectInitializerDeclaration.kind == 7
                                        or subjectInitializerDeclaration.kind == 31)
                                        and subjectInitializerDeclaration.nameToken >= 0
                                        -> if {
                                            package.tokens[subjectInitializerRange.tokenStart + subjectInitializerDeclaration.nameToken]
                                                => subjectInitializerDeclarationName
                                            subjectInitializerName.span.length == subjectInitializerDeclarationName.span.length
                                                => subjectInitializerNameEqual!
                                            UIntSize(0) => subjectInitializerNameByte!
                                            subjectInitializerNameEqual!
                                                and subjectInitializerNameByte! < subjectInitializerName.span.length
                                                -> while {
                                                    (source -> byte(subjectInitializerName.span.start + subjectInitializerNameByte!)) != (subjectInitializerText -> byte(subjectInitializerDeclarationName.span.start + subjectInitializerNameByte!))
                                                        -> if { false => subjectInitializerNameEqual! }
                                                    subjectInitializerNameByte! + 1 => subjectInitializerNameByte!
                                                }
                                            subjectInitializerNameEqual! -> if {
                                                subjectInitializerFound! -> if {
                                                    true => subjectInitializerAmbiguous!
                                                } else {
                                                    true => subjectInitializerFound!
                                                    subjectInitializerSource! => subjectTargetSource!
                                                    subjectInitializerSymbol! => subjectFunctionSymbol!
                                                }
                                            }
                                        }
                                    subjectInitializerSymbol! + 1 => subjectInitializerSymbol!
                                }
                            subjectInitializerSource! + 1 => subjectInitializerSource!
                        }
                    subjectInitializerAmbiguous! -> if {
                        -1 => subjectTargetSource!
                        -1 => subjectFunctionSymbol!
                    }
                }
            }
        }
    # The match subject can be an inferred binding whose initializer call is a
    # sibling immediately before the `when` call. If the exact binding and unique
    # name paths are unavailable, use only the nearest successful call in the
    # same enclosing function and before the match subject boundary.
    subjectTargetSource! < 0 -> if {
        binding.parent => subjectFunctionAncestorSymbol!
        -1 => subjectEnclosingFunctionAst!
        subjectFunctionAncestorSymbol! >= 0 and subjectEnclosingFunctionAst! < 0
            -> while {
                package.symbols[sourceRange.symbolStart + subjectFunctionAncestorSymbol!]
                    => subjectFunctionAncestor
                subjectFunctionAncestor.kind == 7 or subjectFunctionAncestor.kind == 31
                    -> if {
                        subjectFunctionAncestor.astNode => subjectEnclosingFunctionAst!
                    } else {
                        subjectFunctionAncestor.parent => subjectFunctionAncestorSymbol!
                    }
            }
        0 => subjectSiblingIndex!
        subjectSiblingIndex! < (localResults -> len)
            -> while {
                localResults[subjectSiblingIndex!] => subjectSibling
                subjectSibling.sourceModule == sourceIndex
                    and subjectSibling.status == 0
                    and subjectSibling.callAst >= 0
                    and subjectSibling.targetSourceModule >= 0
                    and subjectSibling.functionSymbol >= 0
                    -> if {
                        package.nodes[sourceRange.astStart + subjectSibling.callAst] => subjectSiblingCall
                        subjectSibling.callAst => subjectSiblingAncestor!
                        false => subjectSiblingBelongs!
                        subjectSiblingAncestor! >= 0 and not subjectSiblingBelongs!
                            -> while {
                                subjectSiblingAncestor! == subjectEnclosingFunctionAst!
                                    -> if { true => subjectSiblingBelongs! } else {
                                        package.nodes[sourceRange.astStart + subjectSiblingAncestor!].parent
                                            => subjectSiblingAncestor!
                                    }
                            }
                        subjectSiblingCall.start + subjectSiblingCall.length => subjectSiblingEnd
                        subjectSiblingBelongs!
                            and subjectSiblingEnd <= matchSubjectEnd!
                            and (subjectTargetSource! < 0 or subjectSiblingEnd >= subjectEnd!)
                            -> if {
                                subjectSiblingEnd => subjectEnd!
                                subjectSibling.targetSourceModule => subjectTargetSource!
                                subjectSibling.functionSymbol => subjectFunctionSymbol!
                            }
                    }
                subjectSiblingIndex! + 1 => subjectSiblingIndex!
            }
    }
    subjectTargetSource! < 0 or subjectFunctionSymbol! < 0
        -> if { -1 -> return }
    package.ranges[subjectTargetSource!] => subjectRange
    package.symbols[subjectRange.symbolStart + subjectFunctionSymbol!] => subjectFunction
    subjectFunction.typeNode => subjectResultTypeNode!
    UIntSize(0) => subjectResultTypeStart!
    subjectResultTypeNode! >= 0 -> if {
        package.nodes[subjectRange.astStart + subjectResultTypeNode!].start => subjectResultTypeStart!
    }
    subjectFunction.secondaryTypeNode >= 0
        and package.nodes[subjectRange.astStart + subjectFunction.secondaryTypeNode].start >= subjectResultTypeStart!
        -> if {
            subjectFunction.secondaryTypeNode => subjectResultTypeNode!
            package.nodes[subjectRange.astStart + subjectResultTypeNode!].start => subjectResultTypeStart!
        }
    subjectFunction.blockTypeNode >= 0
        and package.nodes[subjectRange.astStart + subjectFunction.blockTypeNode].start >= subjectResultTypeStart!
        -> if {
            subjectFunction.blockTypeNode => subjectResultTypeNode!
            package.nodes[subjectRange.astStart + subjectResultTypeNode!].start => subjectResultTypeStart!
        }
    subjectFunction.blockResultTypeNode >= 0
        and package.nodes[subjectRange.astStart + subjectFunction.blockResultTypeNode].start >= subjectResultTypeStart!
        -> if {
            subjectFunction.blockResultTypeNode => subjectResultTypeNode!
            package.nodes[subjectRange.astStart + subjectResultTypeNode!].start => subjectResultTypeStart!
        }
    -1 => subjectTypeId!
    0 => subjectReferenceIndex!
    subjectReferenceIndex! < (semantic.references -> len)
        -> while {
            semantic.references[subjectReferenceIndex!] => subjectReference
            subjectReference.sourceModule == subjectTargetSource!
                and subjectReference.typeAst == subjectResultTypeNode!
                and subjectReference.status == 0
                -> if { subjectReference.typeId => subjectTypeId! }
            subjectReferenceIndex! + 1 => subjectReferenceIndex!
        }
    # Generic applications carry references on their argument children rather
    # than on the application AST. Reconstruct the canonical Result id from
    # those exact child references.
    subjectTypeId! < 0 and subjectResultTypeNode! >= 0
        -> if {
            -1 => subjectOkTypeId!
            -1 => subjectErrorTypeId!
            UIntSize(0) => subjectOkStart!
            UIntSize(0) => subjectErrorStart!
            0 => subjectArgumentReferenceIndex!
            subjectArgumentReferenceIndex! < (semantic.references -> len)
                -> while {
                    semantic.references[subjectArgumentReferenceIndex!] => subjectArgumentReference
                    subjectArgumentReference.sourceModule == subjectTargetSource!
                        and subjectArgumentReference.status == 0
                        and package.nodes[subjectRange.astStart + subjectArgumentReference.typeAst].parent == subjectResultTypeNode!
                        -> if {
                            package.nodes[subjectRange.astStart + subjectArgumentReference.typeAst]
                                => subjectArgumentNode
                            subjectOkTypeId! < 0 or subjectArgumentNode.start < subjectOkStart!
                                -> if {
                                    subjectOkTypeId! => subjectErrorTypeId!
                                    subjectOkStart! => subjectErrorStart!
                                    subjectArgumentReference.typeId => subjectOkTypeId!
                                    subjectArgumentNode.start => subjectOkStart!
                                } else {
                                    subjectErrorTypeId! < 0 or subjectArgumentNode.start < subjectErrorStart!
                                        -> if {
                                            subjectArgumentReference.typeId => subjectErrorTypeId!
                                            subjectArgumentNode.start => subjectErrorStart!
                                        }
                                }
                        }
                    subjectArgumentReferenceIndex! + 1 => subjectArgumentReferenceIndex!
                }
            subjectOkTypeId! >= 0 and subjectErrorTypeId! >= 0
                -> if {
                    0 => subjectApplicationTypeIndex!
                    subjectApplicationTypeIndex! < (semantic.types -> len) and subjectTypeId! < 0
                        -> while {
                            semantic.types[subjectApplicationTypeIndex!] => subjectApplicationType
                            subjectApplicationType.kind == 7
                                and subjectApplicationType.origin == 4
                                and subjectApplicationType.symbol == 1
                                and subjectApplicationType.first == subjectOkTypeId!
                                and subjectApplicationType.second == subjectErrorTypeId!
                                and subjectApplicationType.status == 0
                                -> if { subjectApplicationTypeIndex! => subjectTypeId! }
                            subjectApplicationTypeIndex! + 1 => subjectApplicationTypeIndex!
                        }
                }
        }
    subjectTypeId! < 0 -> if { -1 -> return }
    semantic.types[subjectTypeId!] => subjectType
    subjectType.kind != 7
        or subjectType.origin != 4
        or subjectType.symbol != 1
        or bindingAst.payloadToken < 0
        -> if { -1 -> return }
    subjectType.first => bindingTypeId!
    package.tokens[sourceRange.tokenStart + bindingAst.payloadToken] => variant
    (source -> byte(variant.span.start)) == 69 -> if { subjectType.second => bindingTypeId! }
    bindingTypeId!
}

readonlyPropertyCandidate package: ref analysis.PackageAnalysis, sourceIndex: Int, propertyAst: Int, callOwners: ref [Int; ~] -> Bool {
    package.ranges[sourceIndex] => range
    package.nodes[range.astStart + propertyAst] => property
    property.kind != 36 or property.tokenCount == 0
        -> if { false -> return }
    package.tokens[range.tokenStart + property.firstToken + property.tokenCount - 1] => endpoint
    endpoint.kind != grammar.tokenIdIdentifier()
        or endpoint.span.start + endpoint.span.length != property.start + property.length
        -> if { false -> return }
    callOwners[propertyAst] => callOwner
    callOwner >= 0 -> if {
        package.nodes[range.astStart + callOwner] => call
        call.start == property.start and call.length == property.length
            -> if { false -> return }
    }
    true
}

propertyHasStoredField package: ref analysis.PackageAnalysis, semantic: ref typeIds.SemanticTypeSet, sourceIndex: Int, nameToken: Int, receiverTypeId: Int -> Bool {
    package.ranges[sourceIndex] => range
    package.tokens[range.tokenStart + nameToken] => name
    semantic.fields -> each field {
        field.status == 0 and typedMethodOwnerMatches(semantic.types, receiverTypeId, field.ownerType, false)
            -> if {
                package.ranges[field.sourceModule] => fieldRange
                field.labelToken => fieldNameToken!
                fieldNameToken! < 0 and field.fieldSymbol >= 0
                    -> if {
                        package.symbols[fieldRange.symbolStart + field.fieldSymbol].nameToken => fieldNameToken!
                    }
                fieldNameToken! >= 0 -> if {
                    package.tokens[fieldRange.tokenStart + fieldNameToken!] => fieldName
                    fieldName.span.length == name.span.length => equal!
                    UIntSize(0) => byteIndex!
                    equal! and byteIndex! < name.span.length -> while {
                        (package.sources[sourceIndex] -> byte(name.span.start + byteIndex!)) != (package.sources[field.sourceModule] -> byte(fieldName.span.start + byteIndex!))
                            -> if { false => equal! }
                        byteIndex! + 1 => byteIndex!
                    }
                    equal! -> if { true -> return }
                }
            }
    }
    false
}

firstCallLeftParenToken node: ast.AstNode, tokens: ref [syntax.SyntaxToken; ~], tokenStart: Int -> Int {
    node.firstToken => cursor!
    node.firstToken + node.tokenCount => end
    cursor! < end -> while {
        tokens[tokenStart + cursor!].kind == grammar.tokenIdLeftParen()
            -> if { cursor! -> return }
        cursor! + 1 => cursor!
    }
    end
}

indexQualifiedCallTargets sourceIndex: Int, package: ref analysis.PackageAnalysis, localCalls: ref [TypedCallCandidate; ~], callByAst: ref [Int; ~], sourceQualifiedIndices: ref [Int; ~], qualifiedResults: ref [qualified.QualifiedResolution; ~], leftParenByCall: ref [Int; ~] -> [Int; ~] {
    package.ranges[sourceIndex] => range
    [Int; ~] => targets!
    localCalls -> each call { targets! -> push(-1) }
    # Visit global rows in their original order, retaining the last match.
    # Every ancestor call participates, including calls around nested arguments.
    sourceQualifiedIndices -> each qualifiedIndex {
        qualifiedResults[qualifiedIndex] => candidate
        candidate.sourceModule == sourceIndex -> if {
            package.nodes[range.astStart + candidate.pathAst] => candidatePath
            candidate.pathAst => ancestor!
            ancestor! >= 0 -> while {
                callByAst[ancestor!] => callIndex
                callIndex >= 0 -> if {
                    localCalls[callIndex] => call
                    package.nodes[range.astStart + call.callAst] => callNode
                    candidatePath.firstToken <= call.nameToken
                        and call.nameToken < candidatePath.firstToken + candidatePath.tokenCount
                        and (callNode.kind == 10
                        or candidatePath.firstToken + candidatePath.tokenCount <= leftParenByCall[callIndex])
                        -> if { qualifiedIndex => targets![callIndex] }
                }
                package.nodes[range.astStart + ancestor!].parent => ancestor!
            }
        }
    }
    targets!
}

lastSourceReferenceIndex package: ref analysis.PackageAnalysis, references: ref [typeIds.TypeReference; ~], index: ref TypedMethodReferenceIndex, source: Int, ast: Int -> Int {
    package -> typedMethodReferenceBucket(source, ast) => bucket
    index.heads[bucket] => selected!
    selected! >= 0 -> while {
        references[selected!] => reference
        reference.sourceModule == source and reference.typeAst == ast
            -> if { selected! -> return }
        index.previous[selected!] => selected!
    }
    -1
}

struct QualifiedReceiverLiteralIndex {
    heads: [Int; ~]
    next: [Int; ~]
    rows: [Int; ~]
    ends: [UIntSize; ~]
}

indexQualifiedReceiverLiterals package: ref analysis.PackageAnalysis, identities: ref [modules.ModuleIdentity; ~], qualifiedResults: ref [qualified.QualifiedResolution; ~], sourceQualifiedIndices: ref [Int; ~], sourceIndex: Int -> QualifiedReceiverLiteralIndex {
    package.ranges[sourceIndex] => range
    [Int; ~] => heads!
    [Int; ~] => next!
    [Int; ~] => rows!
    [UIntSize; ~] => ends!
    0..<(range.astCount + 1) -> each ast { heads! -> push(-1) }
    # Reverse insertion retains ascending source-qualified order. Equal ends
    # intentionally retain the last matching row, as the original >= selector.
    (sourceQualifiedIndices -> len) - 1 => ordinal!
    ordinal! >= 0 -> while {
        sourceQualifiedIndices[ordinal!] => row
        qualifiedResults[row] => candidate
        candidate.sourceModule == sourceIndex and candidate.status == 0
            and candidate.targetModule >= 0 and candidate.targetSymbol >= 0
            -> if {
                candidate.pathAst => ancestor!
                -1 => literal!
                ancestor! >= 0 and literal! < 0 -> while {
                    package.nodes[range.astStart + ancestor!] => node
                    node.kind == 39 -> if { ancestor! => literal! }
                    node.parent => ancestor!
                }
                literal! >= 0 -> if {
                    package.nodes[range.astStart + literal!] => literal
                    package.nodes[range.astStart + candidate.pathAst] => path
                    identities[candidate.targetModule].sourceIndex => targetSource
                    package.ranges[targetSource] => targetRange
                    package.symbols[targetRange.symbolStart + candidate.targetSymbol] => target
                    path.start == literal.start and (target.kind == 3 or target.kind == 4)
                        -> if {
                            Int(path.start % UIntSize(heads! -> len)) => bucket
                            rows! -> len => entry
                            rows! -> push(row)
                            ends! -> push(path.start + path.length)
                            next! -> push(heads![bucket])
                            entry => heads![bucket]
                        }
                }
            }
        ordinal! - 1 => ordinal!
    }
    QualifiedReceiverLiteralIndex { heads: heads!, next: next!, rows: rows!, ends: ends! }
}

struct ReceiverLiteralAstIndex {
    firstDirect: [Int; ~]
    firstChild: [Int; ~]
    heads: [Int; ~]
    next: [Int; ~]
}

indexReceiverLiterals nodes: ref [ast.AstNode; ~], sourceAstStart: Int, sourceAstCount: Int -> ReceiverLiteralAstIndex {
    [Int; ~] => direct!
    [Int; ~] => child!
    [Int; ~] => heads!
    [Int; ~] => next!
    0..<sourceAstCount -> each ast {
        direct! -> push(-1)
        child! -> push(-1)
        heads! -> push(-1)
        next! -> push(-1)
    }
    heads! -> push(-1)
    0..<sourceAstCount -> each ast {
        nodes[sourceAstStart + ast] => candidate
        candidate.parent >= 0 and candidate.parent < sourceAstCount
            -> if {
                child![candidate.parent] => previous
                previous < 0 -> if { ast => child![candidate.parent] } else {
                    candidate.start < nodes[sourceAstStart + previous].start
                        -> if { ast => child![candidate.parent] }
                }
                candidate.kind == 39 and candidate.payloadToken >= 0
                    and candidate.start == nodes[sourceAstStart + candidate.parent].start
                    and direct![candidate.parent] < 0
                    -> if { ast => direct![candidate.parent] }
            }
        candidate.kind == 37 or candidate.kind == 39 -> if {
            Int(candidate.start % UIntSize(heads! -> len)) => bucket
            heads![bucket] => next![ast]
            ast => heads![bucket]
        }
    }
    ReceiverLiteralAstIndex { firstDirect: direct!, firstChild: child!, heads: heads!, next: next! }
}

lastArrayLiteralAt nodes: ref [ast.AstNode; ~], sourceAstStart: Int, index: ref ReceiverLiteralAstIndex, start: UIntSize -> Int {
    Int(start % UIntSize(index.heads -> len)) => bucket
    index.heads[bucket] => ast!
    ast! >= 0 -> while {
        nodes[sourceAstStart + ast!] => candidate
        candidate.kind == 37 and candidate.start == start
            -> if { ast! -> return }
        index.next[ast!] => ast!
    }
    -1
}

bestBindingLiteralAt nodes: ref [ast.AstNode; ~], sourceAstStart: Int, index: ref ReceiverLiteralAstIndex, start: UIntSize, bindingAst: Int -> Int {
    Int(start % UIntSize(index.heads -> len)) => bucket
    index.heads[bucket] => ast!
    -1 => selected!
    UIntSize(0) => selectedLength!
    ast! >= 0 -> while {
        nodes[sourceAstStart + ast!] => candidate
        candidate.kind == 39 and candidate.start == start and candidate.payloadToken >= 0
            -> if {
                ast! => ancestor!
                false => belongs!
                ancestor! >= 0 and not belongs! -> while {
                    ancestor! == bindingAst -> if { true => belongs! } else {
                        nodes[sourceAstStart + ancestor!].parent => ancestor!
                    }
                }
                belongs! and (selected! < 0 or candidate.length > selectedLength!
                    or (candidate.length == selectedLength! and ast! < selected!))
                    -> if {
                        ast! => selected!
                        candidate.length => selectedLength!
                    }
            }
        index.next[ast!] => ast!
    }
    selected!
}

struct ReceiverRecoveryIndex {
    first: [Int; ~]
    rows: [Int; ~]
    next: [Int; ~]
    propagates: [Bool; ~]
}

appendReceiverResultAncestors first: mut [Int; ~], rows: mut [Int; ~], nextEdges: mut [Int; ~], last: mut [Int; ~], nodes: ref [ast.AstNode; ~], astStart: Int, node: Int, row: Int -> Unit {
    node => ancestor!
    ancestor! >= 0 -> while {
        rows -> len => edge
        rows -> push(row)
        nextEdges -> push(-1)
        last[ancestor!] => previous
        previous >= 0 -> if { edge => nextEdges[previous] } else {
            edge => first[ancestor!]
        }
        edge => last[ancestor!]
        nodes[astStart + ancestor!].parent => ancestor!
    }
}

indexReceiverRecovery nodes: ref [ast.AstNode; ~], astStart: Int, astCount: Int, sourceIndex: Int, localCalls: ref [TypedCallCandidate; ~], qualifiedTargets: ref [Int; ~], qualifiedResults: ref [qualified.QualifiedResolution; ~], existing: ref [ModuleCallResolution; ~] -> ReceiverRecoveryIndex {
    [Int; ~] => first!
    [Int; ~] => last!
    [Int; ~] => rows!
    [Int; ~] => nextEdges!
    [Bool; ~] => propagates!
    0 => seed!
    seed! < astCount -> while {
        first! -> push(-1)
        last! -> push(-1)
        propagates! -> push(false)
        seed! + 1 => seed!
    }
    0 => astIndex!
    astIndex! < astCount -> while {
        nodes[astStart + astIndex!].kind == 82 -> if {
            astIndex! => ancestor!
            ancestor! >= 0 -> while {
                true => propagates![ancestor!]
                nodes[astStart + ancestor!].parent => ancestor!
            }
        }
        astIndex! + 1 => astIndex!
    }
    0 => row!
    row! < (existing -> len) -> while {
        existing[row!] => current
        current.sourceModule == sourceIndex and current.callAst >= 0 and current.callAst < astCount
            -> if { appendReceiverResultAncestors(first!, rows!, nextEdges!, last!, nodes, astStart, current.callAst, row!) }
        row! + 1 => row!
    }
    0 => localIndex!
    localIndex! < (localCalls -> len) -> while {
        (existing -> len) + localIndex! => resultRow
        appendReceiverResultAncestors(first!, rows!, nextEdges!, last!, nodes, astStart, localCalls[localIndex!].callAst, resultRow)
        qualifiedTargets[localIndex!] => qualifiedIndex
        qualifiedIndex >= 0 and qualifiedIndex < (qualifiedResults -> len)
            -> if {
                qualifiedResults[qualifiedIndex].pathAst => path
                path >= 0 and path < astCount -> if {
                    appendReceiverResultAncestors(first!, rows!, nextEdges!, last!, nodes, astStart, path, resultRow)
                }
            }
        localIndex! + 1 => localIndex!
    }
    ReceiverRecoveryIndex { first: first!, rows: rows!, next: nextEdges!, propagates: propagates! }
}

resolveSourceTypedWithDeclarations sourceIndex: Int, package: ref analysis.PackageAnalysis, semantic: ref typeIds.SemanticTypeSet, identities: ref [modules.ModuleIdentity; ~], imports: ref [modules.ImportEdge; ~], resolvedImports: ref [moduleResolve.ResolvedImport; ~], qualifiedResults: ref [qualified.QualifiedResolution; ~], declaredIntrinsicNames: ref [DeclaredIntrinsicCallableName; ~], receiverTypeByCallAst: ref [Int; ~], resolvedTypes: ref [typeIds.SemanticType; ~], declarations: ref TypedMethodDeclarationFacts, referenceIndex: ref TypedMethodReferenceIndex -> [ModuleCallResolution; ~] {
    [ModuleCallResolution; ~] => results!
    package.ranges[sourceIndex] => literalRange
    indexReceiverLiterals(package.nodes, literalRange.astStart, literalRange.astCount) => literalAstIndex
    package.sources[sourceIndex] -> len => sourceLength
    package.sources[sourceIndex] -> slice(UIntSize(0), sourceLength) => source
    package.ranges[sourceIndex] => sourceRange
    indexLexicalFunctions(package.tokens, package.symbols, sourceRange.tokenStart, sourceRange.tokenCount, sourceRange.symbolStart, sourceRange.symbolCount, sourceRange.astCount) => lexicalFunctions
    # Retain global row identity and source order for every qualified lookup.
    [Int; ~] => sourceQualifiedIndices!
    0 => sourceQualifiedIndex!
    sourceQualifiedIndex! < (qualifiedResults -> len)
        -> while {
            qualifiedResults[sourceQualifiedIndex!].sourceModule == sourceIndex
                -> if { sourceQualifiedIndices! -> push(sourceQualifiedIndex!) }
            sourceQualifiedIndex! + 1 => sourceQualifiedIndex!
        }
    indexQualifiedReceiverLiterals(package, identities, qualifiedResults, sourceQualifiedIndices!, sourceIndex) => qualifiedLiteralIndex
    [TypedCallCandidate; ~] => localCalls!
    [Bool; ~] => propertyCandidates!
    package.nodes -> indexQualifiedPathCallOwners(sourceRange.astStart, sourceRange.astCount) => qualifiedPathCallOwners
    # Index the final Path child of every AST owner once. For an impl this
    # is its nominal target (or the target after `for` for a trait impl),
    # which is the authoritative type of each synthetic `self` binding.
    [Int; ~] => moduleLastPathChildByAst!
    [UIntSize; ~] => moduleLastPathStartByAst!
    0 => moduleLastPathSeed!
    moduleLastPathSeed! < sourceRange.astCount
        -> while {
            moduleLastPathChildByAst! -> push(-1)
            moduleLastPathStartByAst! -> push(0)
            moduleLastPathSeed! + 1 => moduleLastPathSeed!
        }
    0 => moduleLastPathCandidateIndex!
    moduleLastPathCandidateIndex! < sourceRange.astCount
        -> while {
            package.nodes[sourceRange.astStart + moduleLastPathCandidateIndex!]
                => moduleLastPathCandidate
            moduleLastPathCandidate.kind == 16
                and moduleLastPathCandidate.parent >= 0
                and moduleLastPathCandidate.parent < sourceRange.astCount
                and (moduleLastPathChildByAst![moduleLastPathCandidate.parent] < 0
                or moduleLastPathCandidate.start > moduleLastPathStartByAst![moduleLastPathCandidate.parent])
                -> if {
                    moduleLastPathCandidateIndex!
                        => moduleLastPathChildByAst![moduleLastPathCandidate.parent]
                    moduleLastPathCandidate.start
                        => moduleLastPathStartByAst![moduleLastPathCandidate.parent]
                }
            moduleLastPathCandidateIndex! + 1
                => moduleLastPathCandidateIndex!
        }
    # Build the flow-target index once per source. Previously each possible
    # call scanned the complete AST repeatedly, which was quadratic and
    # made the complete compiler graph spend tens of minutes here.
    [Int; ~] => moduleFlowNameTokens!
    [Int; ~] => moduleFlowCallChildByParent!
    0 => moduleFlowIndexBuild!
    moduleFlowIndexBuild! < sourceRange.astCount
        -> while {
            moduleFlowNameTokens! -> push(-1)
            moduleFlowCallChildByParent! -> push(-1)
            moduleFlowIndexBuild! + 1 => moduleFlowIndexBuild!
        }
    0 => moduleFlowCallChildIndex!
    moduleFlowCallChildIndex! < sourceRange.astCount
        -> while {
            package.nodes[sourceRange.astStart + moduleFlowCallChildIndex!]
                => moduleFlowCallChild
            moduleFlowCallChild.kind == 10
                and moduleFlowCallChild.parent >= 0
                and moduleFlowCallChild.parent < sourceRange.astCount
                -> if {
                    moduleFlowCallChild.parent => moduleFlowCallParent
                    moduleFlowCallChildIndex! => moduleFlowCallChildByParent![moduleFlowCallParent]
                }
            moduleFlowCallChildIndex! + 1 => moduleFlowCallChildIndex!
        }
    0 => moduleFlowChildIndex!
    moduleFlowChildIndex! < sourceRange.astCount
        -> while {
            package.nodes[sourceRange.astStart + moduleFlowChildIndex!] => moduleFlowChild
            moduleFlowChild.kind == 16 and moduleFlowChild.parent >= 0 and moduleFlowChild.parent < sourceRange.astCount
                -> if {
                    -1 => indexedFlowNameToken!
                    moduleFlowChild.firstToken => indexedFlowPathToken!
                    moduleFlowChild.firstToken + moduleFlowChild.tokenCount => indexedFlowPathEnd!
                    indexedFlowPathToken! < indexedFlowPathEnd! -> while {
                        package.tokens[sourceRange.tokenStart + indexedFlowPathToken!]
                            => indexedFlowPathPart
                        indexedFlowPathPart.kind == grammar.tokenIdLeftParen()
                            -> if {
                                indexedFlowPathToken! => indexedFlowPathEnd!
                            } else {
                                indexedFlowPathPart.kind == grammar.tokenIdIdentifier()
                                    -> if {
                                        indexedFlowPathToken! => indexedFlowNameToken!
                                    }
                                indexedFlowPathToken! + 1 => indexedFlowPathToken!
                            }
                    }
                    moduleFlowChild.parent => indexedFlowOwner!
                    package.nodes[sourceRange.astStart + indexedFlowOwner!].kind == 11
                        and package.nodes[sourceRange.astStart + indexedFlowOwner!].cstRuleId != grammar.ruleIdCallExpression()
                        and package.nodes[sourceRange.astStart + indexedFlowOwner!].cstRuleId != grammar.ruleIdTypeApplicationExpression()
                        and moduleFlowCallChildByParent![indexedFlowOwner!] >= 0
                        -> if {
                            moduleFlowCallChildByParent![indexedFlowOwner!]
                                => indexedFlowOwner!
                        }
                    indexedFlowNameToken! > moduleFlowNameTokens![indexedFlowOwner!]
                        -> if {
                            indexedFlowNameToken! => moduleFlowNameTokens![indexedFlowOwner!]
                        }
                }
            moduleFlowChildIndex! + 1 => moduleFlowChildIndex!
        }
    # Existential membership only; actual target resolution below remains ordered.
    [Bool; ~] => moduleQualifiedCallByAst!
    [Bool; ~] => moduleGeneratedComByAst!
    0 => qualifiedMembershipSeed!
    qualifiedMembershipSeed! < sourceRange.astCount
        -> while {
            moduleQualifiedCallByAst! -> push(false)
            moduleGeneratedComByAst! -> push(false)
            qualifiedMembershipSeed! + 1 => qualifiedMembershipSeed!
        }
    0 => qualifiedMembershipIndex!
    qualifiedMembershipIndex! < (sourceQualifiedIndices! -> len)
        -> while {
            qualifiedResults[sourceQualifiedIndices![qualifiedMembershipIndex!]] => moduleQualifiedCall
            moduleQualifiedCall.sourceModule == sourceIndex
                and moduleQualifiedCall.pathAst >= 0
                and moduleQualifiedCall.pathAst < sourceRange.astCount
                -> if {
                    package.nodes[sourceRange.astStart + moduleQualifiedCall.pathAst] => qualifiedMembershipPath
                    qualifiedMembershipPath.kind == 36 -> if {
                        qualifiedPathCallOwners[moduleQualifiedCall.pathAst] => qualifiedMembershipOwner!
                        qualifiedMembershipOwner! < 0
                            -> if { qualifiedMembershipPath.parent => qualifiedMembershipOwner! }
                        qualifiedMembershipOwner! >= 0 and qualifiedMembershipOwner! < sourceRange.astCount
                            -> if {
                                false => moduleQualifiedTargetCallable!
                                moduleQualifiedCall.status == 0
                                    and moduleQualifiedCall.targetModule >= 0
                                    and moduleQualifiedCall.targetModule < (identities -> len)
                                    -> if {
                                        identities[moduleQualifiedCall.targetModule].sourceIndex => moduleQualifiedTargetSource
                                        moduleQualifiedTargetSource >= 0 and moduleQualifiedTargetSource < (package.ranges -> len)
                                            -> if {
                                                package.ranges[moduleQualifiedTargetSource] => moduleQualifiedTargetRange
                                                moduleQualifiedCall.targetSymbol >= 0 and moduleQualifiedCall.targetSymbol < moduleQualifiedTargetRange.symbolCount
                                                    -> if {
                                                        package.symbols[moduleQualifiedTargetRange.symbolStart + moduleQualifiedCall.targetSymbol]
                                                            => moduleQualifiedTargetSymbol
                                                        moduleQualifiedTargetSymbol.kind == 7
                                                            or (moduleQualifiedTargetSymbol.kind == 27
                                                            and moduleQualifiedTargetSymbol.typeNode >= 0)
                                                            or moduleQualifiedTargetSymbol.kind == 31
                                                            or moduleQualifiedTargetSymbol.kind == 36
                                                            -> if {
                                                                true => moduleQualifiedTargetCallable!
                                                            }
                                                    }
                                            }
                                    }
                                moduleQualifiedTargetCallable!
                                    -> if { true => moduleQualifiedCallByAst![qualifiedMembershipOwner!] }
                            }
                    }
                    moduleQualifiedCall.targetSymbol >= 0 and moduleQualifiedCall.targetSymbol < sourceRange.symbolCount
                        -> if {
                            package.symbols[sourceRange.symbolStart + moduleQualifiedCall.targetSymbol].kind == 36
                                -> if { true => moduleGeneratedComByAst![moduleQualifiedCall.pathAst] }
                        }
                }
            qualifiedMembershipIndex! + 1 => qualifiedMembershipIndex!
        }
    0 => callAstIndex!
    callAstIndex! < sourceRange.astCount -> while {
        package.nodes[sourceRange.astStart + callAstIndex!] => callNode
        moduleFlowNameTokens![callAstIndex!] >= 0 => moduleHasFlowCallTarget
        moduleQualifiedCallByAst![callAstIndex!] => moduleHasQualifiedCallTarget
        moduleGeneratedComByAst![callAstIndex!] => moduleHasGeneratedComTarget
        false => moduleGeneratedComHasCallOwner!
        callNode.kind == 36 and callNode.parent >= 0
            -> if {
                package.nodes[sourceRange.astStart + callNode.parent] => generatedComParent
                generatedComParent.kind == 10
                    or generatedComParent.kind == 11
                    or generatedComParent.kind == 48 -> if {
                        true => moduleGeneratedComHasCallOwner!
                    }
            }
        (callNode.kind == 10 and (moduleHasFlowCallTarget or moduleHasQualifiedCallTarget)) or (callNode.kind == 11 and (callNode.cstRuleId == grammar.ruleIdCallExpression() or callNode.cstRuleId == grammar.ruleIdTypeApplicationExpression())) or callNode.kind == 48 or callNode.kind == 77 or (callNode.kind == 36 and moduleHasGeneratedComTarget and not moduleGeneratedComHasCallOwner!) or readonlyPropertyCandidate(package, sourceIndex, callAstIndex!, qualifiedPathCallOwners)
            -> if {
                -1 => callNameToken!
                callNode.kind == 48 or callNode.kind == 77 -> if { callNode.payloadToken => callNameToken! }
                callNode.kind == 36 -> if {
                    callNode.firstToken => comCallNameSearch!
                    comCallNameSearch! < callNode.firstToken + callNode.tokenCount
                        -> while {
                            package.tokens[sourceRange.tokenStart + comCallNameSearch!].kind == grammar.tokenIdIdentifier()
                                -> if { comCallNameSearch! => callNameToken! }
                            comCallNameSearch! + 1 => comCallNameSearch!
                        }
                }
                callNode.kind == 10 -> if { moduleFlowNameTokens![callAstIndex!] => callNameToken! }
                callNode.firstToken => callTokenIndex!
                false => moduleInFlowTypeArgument!
                false => moduleInFlowCallArguments!
                callTokenIndex! < callNode.firstToken + callNode.tokenCount and callNode.kind != 48 and callNode.kind != 77 and callNameToken! < 0
                    -> while {
                        package.tokens[sourceRange.tokenStart + callTokenIndex!].kind == grammar.tokenIdLess()
                            -> if { true => moduleInFlowTypeArgument! }
                        package.tokens[sourceRange.tokenStart + callTokenIndex!].kind == grammar.tokenIdGreater()
                            -> if { false => moduleInFlowTypeArgument! }
                        package.tokens[sourceRange.tokenStart + callTokenIndex!].kind == grammar.tokenIdLeftParen()
                            -> if { true => moduleInFlowCallArguments! }
                        package.tokens[sourceRange.tokenStart + callTokenIndex!].kind == grammar.tokenIdRightParen()
                            -> if { false => moduleInFlowCallArguments! }
                        package.tokens[sourceRange.tokenStart + callTokenIndex!].kind == grammar.tokenIdIdentifier() and not moduleInFlowTypeArgument! and not moduleInFlowCallArguments!
                            -> if { callTokenIndex! => callNameToken! }
                        callTokenIndex! + 1 => callTokenIndex!
                    }
                callNameToken! >= 0 -> if {
                    resolveLexicalFunction(source, package.nodes, package.tokens, package.symbols, lexicalFunctions, sourceRange.astStart, sourceRange.tokenStart, sourceRange.symbolStart, callNode.parent, callNameToken!, callNode.kind) => lexicalFunctionSymbol
                    lexicalFunctionSymbol => localFunctionSymbol!
                    (callNode.kind == 10 or callNode.kind == 11 or callNode.kind == 48 or callNode.kind == 77) and localFunctionSymbol! < 0
                        -> if {
                            RuntimeNameRequest { source: source, token: package.tokens[sourceRange.tokenStart + callNameToken!] } -> runtimeFunctionSymbol => runtimeSymbol
                            runtimeSymbol < -1 -> if { runtimeSymbol => localFunctionSymbol! }
                        }
                    RuntimeNameRequest { source: source, token: package.tokens[sourceRange.tokenStart + callNameToken!] } -> intrinsicFlowTarget => intrinsicFlow!
                    intrinsicFlow! => intrinsicFallback
                    package -> declaredPackageCallableKind(
                    sourceIndex,
                    package.tokens[sourceRange.tokenStart + callNameToken!],
                    declaredIntrinsicNames,
                    identities,
                    resolvedImports
                    ) => declaredCollisionKind
                    declaredCollisionKind > 0 => declaredCollision
                    declaredCollisionKind == 2 and lexicalFunctionSymbol == -1
                        -> if { -1 => localFunctionSymbol! }
                    intrinsicFlow! and declaredCollision -> if {
                        false => intrinsicFlow!
                    }
                    callNameToken! > callNode.firstToken and package.tokens[sourceRange.tokenStart + callNameToken! - 1].kind == grammar.tokenIdDot()
                        -> if { false => intrinsicFlow! }
                    false => localIntrinsicMethodCandidate!
                    callNode.kind == 10 and localFunctionSymbol! >= 0
                        -> if {
                            package.symbols[sourceRange.symbolStart + localFunctionSymbol!].kind == 31
                                -> if { true => localIntrinsicMethodCandidate! }
                        }
                    localFunctionSymbol! != -1 or (not intrinsicFlow! and (callNode.kind == 10 or callNode.kind == 11 or callNode.kind == 48 or callNode.kind == 77 or (callNode.kind == 36 and moduleHasGeneratedComTarget) or readonlyPropertyCandidate(package, sourceIndex, callAstIndex!, qualifiedPathCallOwners)))
                        -> if {
                            2 => localCallStatus!
                            localFunctionSymbol! != -1 -> if { 0 => localCallStatus! }
                            localCalls! -> push(TypedCallCandidate {
                                callAst: callAstIndex!
                                nameToken: callNameToken!
                                functionSymbol: localFunctionSymbol!
                                status: localCallStatus!
                                intrinsicFallback: intrinsicFallback and declaredCollisionKind == 1 and (localFunctionSymbol! < 0 or localIntrinsicMethodCandidate!)
                            })
                            propertyCandidates! -> push(not moduleHasGeneratedComTarget and readonlyPropertyCandidate(package, sourceIndex, callAstIndex!, qualifiedPathCallOwners))
                        }
                }
            }
        callAstIndex! + 1 => callAstIndex!
    }
    # Each lexical name reaches its ancestor calls once. Keep call arguments
    # outside their parent's receiver and retain the earliest exact root.
    [Int; ~] => receiverCallByAst!
    0 => receiverCallAstSeed!
    receiverCallAstSeed! < sourceRange.astCount -> while {
        receiverCallByAst! -> push(-1)
        receiverCallAstSeed! + 1 => receiverCallAstSeed!
    }
    [Int; ~] => receiverNameTokenByCall!
    [Int; ~] => receiverSymbolByCall!
    [Int; ~] => receiverRootAstByCall!
    [UIntSize; ~] => receiverStartByCall!
    0 => receiverCallSeed!
    receiverCallSeed! < (localCalls! -> len) -> while {
        localCalls![receiverCallSeed!] => indexedCall
        receiverCallSeed! => receiverCallByAst![indexedCall.callAst]
        package.nodes[sourceRange.astStart + indexedCall.callAst] => indexedCallNode
        indexedCall.nameToken => indexedReceiverNameToken!
        indexedCallNode.kind == 11 -> if {
            indexedCallNode.firstToken + indexedCallNode.tokenCount => indexedLeftParen!
            indexedCallNode.firstToken => indexedCallToken!
            indexedCallToken! < indexedCallNode.firstToken + indexedCallNode.tokenCount
                -> while {
                    package.tokens[sourceRange.tokenStart + indexedCallToken!].kind == grammar.tokenIdLeftParen()
                        -> if {
                            indexedCallToken! => indexedLeftParen!
                            indexedCallNode.firstToken + indexedCallNode.tokenCount => indexedCallToken!
                        } else { indexedCallToken! + 1 => indexedCallToken! }
                }
            indexedLeftParen! >= indexedCallNode.firstToken + 2
                and package.tokens[sourceRange.tokenStart + indexedLeftParen! - 1].kind == grammar.tokenIdIdentifier()
                and package.tokens[sourceRange.tokenStart + indexedLeftParen! - 2].kind == grammar.tokenIdDot()
                -> if { indexedLeftParen! - 1 => indexedReceiverNameToken! }
        }
        moduleFlowNameTokens![indexedCall.callAst] >= 0
            -> if { moduleFlowNameTokens![indexedCall.callAst] => indexedReceiverNameToken! }
        receiverNameTokenByCall! -> push(indexedReceiverNameToken!)
        receiverSymbolByCall! -> push(-1)
        receiverRootAstByCall! -> push(-1)
        receiverStartByCall! -> push(0)
        receiverCallSeed! + 1 => receiverCallSeed!
    }
    0 => receiverRootNameIndex!
    receiverRootNameIndex! < sourceRange.nameCount
        -> while {
            package.names[sourceRange.nameStart + receiverRootNameIndex!] => indexedName
            false => indexedRootBinding!
            indexedName.symbol >= 0 and indexedName.symbol < sourceRange.symbolCount
                -> if {
                    package.symbols[sourceRange.symbolStart + indexedName.symbol] => indexedRoot
                    indexedRoot.kind == 35 or indexedRoot.kind == 9 or indexedRoot.kind == 61
                        -> if { true => indexedRootBinding! }
                    indexedRootBinding! and indexedRoot.kind != 35 and indexedRoot.parent >= 0
                        -> if {
                            package.symbols[sourceRange.symbolStart + indexedRoot.parent] => indexedRootParent
                            indexedRootParent.kind == 3 or indexedRootParent.kind == 4
                                -> if { false => indexedRootBinding! }
                        }
                }
            indexedRootBinding! -> if {
                package.tokens[sourceRange.tokenStart + indexedName.nameToken] => indexedNameToken
                indexedName.astNode => indexedReceiverAncestor!
                false => indexedInsideArgument!
                indexedReceiverAncestor! >= 0 and not indexedInsideArgument!
                    -> while {
                        receiverCallByAst![indexedReceiverAncestor!] => indexedReceiverCall
                        indexedReceiverCall >= 0 -> if {
                            package.tokens[sourceRange.tokenStart + receiverNameTokenByCall![indexedReceiverCall]] => indexedReceiverCallName
                            indexedNameToken.span.start < indexedReceiverCallName.span.start
                                and (receiverSymbolByCall![indexedReceiverCall] < 0
                                or indexedNameToken.span.start < receiverStartByCall![indexedReceiverCall])
                                -> if {
                                    indexedName.symbol => receiverSymbolByCall![indexedReceiverCall]
                                    indexedName.astNode => receiverRootAstByCall![indexedReceiverCall]
                                    indexedNameToken.span.start => receiverStartByCall![indexedReceiverCall]
                                }
                        }
                        package.nodes[sourceRange.astStart + indexedReceiverAncestor!] => indexedReceiverNode
                        indexedReceiverNode.kind == 11
                            and indexedReceiverNode.cstRuleId == grammar.ruleIdCallExpression()
                            and indexedReceiverNode.start < indexedNameToken.span.start
                            -> if { true => indexedInsideArgument! }
                        indexedReceiverNode.parent => indexedReceiverAncestor!
                    }
            }
            receiverRootNameIndex! + 1 => receiverRootNameIndex!
        }
    [Int; ~] => leftParenByCall!
    localCalls! -> each call {
        firstCallLeftParenToken(package.nodes[sourceRange.astStart + call.callAst], package.tokens, sourceRange.tokenStart)
            => leftParen
        leftParenByCall! -> push(leftParen)
    }
    indexQualifiedCallTargets(sourceIndex, package, localCalls!, receiverCallByAst!, sourceQualifiedIndices!, qualifiedResults, leftParenByCall!) => qualifiedTargetByCall
    results! -> len => typedSourceResultStart
    indexReceiverRecovery(package.nodes, sourceRange.astStart, sourceRange.astCount, sourceIndex, localCalls!, qualifiedTargetByCall, qualifiedResults, results!) => receiverRecovery
    [Bool; ~] => propertySelections!
    0 => propertySeed!
    propertySeed! < (localCalls! -> len) -> while {
        propertySelections! -> push(false)
        propertySeed! + 1 => propertySeed!
    }
    0 => typedResolutionPass!
    typedResolutionPass! < 2 -> while {
        0 => localIndex!
        localIndex! < (localCalls! -> len) -> while {
            localCalls![localIndex!] => local
            package.nodes[sourceRange.astStart + local.callAst] => localCallNode
            leftParenByCall![localIndex!] => callLeftParenToken
            local.nameToken => exactCallNameToken!
            false => dottedDirectReceiver!
            propertyCandidates![localIndex!] => readonlyProperty
            readonlyProperty -> if {
                true => dottedDirectReceiver!
                false => propertySelections![localIndex!]
            }
            localCallNode.kind == 11
                and callLeftParenToken >= localCallNode.firstToken + 2
                and package.tokens[sourceRange.tokenStart + callLeftParenToken - 1].kind == grammar.tokenIdIdentifier()
