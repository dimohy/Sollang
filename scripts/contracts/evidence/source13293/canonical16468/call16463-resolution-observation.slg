                            (receiverTypeModule! < 0 or receiverTypeSymbol! < 0)
                                and receiverBinding.typeNode < 0
                                and not implicitReceiverBinding!
                                -> if {
                                    package.tokens[sourceRange.tokenStart + receiverBinding.nameToken]
                                        => indexedBindingTargetName
                                    -1 => indexedBindingRootSymbol!
                                    0 => indexedBindingDepth!
                                    UIntSize(0) => indexedBindingRootStart!
                                    0 => indexedBindingNameIndex!
                                    indexedBindingNameIndex! < sourceRange.nameCount
                                        -> while {
                                            package.names[sourceRange.nameStart + indexedBindingNameIndex!]
                                                => indexedBindingName
                                            package.tokens[sourceRange.tokenStart + indexedBindingName.nameToken]
                                                => indexedBindingNameToken
