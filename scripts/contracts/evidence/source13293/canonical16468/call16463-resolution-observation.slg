                                                                                                            => implicitReceiverTargetSymbol!
                                                                                                    }
                                                                                                }
                                                                                            }
                                                                                        implicitReceiverSymbolIndex! + 1
                                                                                            => implicitReceiverSymbolIndex!
                                                                                    }
                                                                            }
                                                                        implicitReceiverModuleIndex! + 1
                                                                            => implicitReceiverModuleIndex!
                                                                    }
                                                                implicitReceiverTargetAmbiguous! -> if {
                                                                    -1 => implicitReceiverTargetModule!
                                                                    -1 => implicitReceiverTargetSymbol!
                                                                }
                                                            }
                                                        }
                                                        implicitReceiverTargetModule! >= 0
                                                            and implicitReceiverTargetSymbol! >= 0
                                                            -> if {
                                                                0 => implicitReceiverTypeIndex!
                                                                implicitReceiverTypeIndex! < (semantic.types -> len)
                                                                    -> while {
                                                                        semantic.types[implicitReceiverTypeIndex!]
                                                                            => implicitReceiverType
                                                                        (implicitReceiverType.kind == 1
                                                                            or implicitReceiverType.kind == 7)
                                                                            and implicitReceiverType.origin != 4
                                                                            and implicitReceiverType.module == implicitReceiverTargetModule!
                                                                            and implicitReceiverType.symbol == implicitReceiverTargetSymbol!
                                                                            and implicitReceiverType.status == 0
                                                                            -> if {
                                                                                implicitReceiverTargetModule!
                                                                                    => receiverTypeModule!
                                                                                implicitReceiverTargetSymbol!
                                                                                    => receiverTypeSymbol!
                                                                                implicitReceiverTypeIndex!
                                                                                    => receiverTypeId!
                                                                            }
                                                                        implicitReceiverTypeIndex! + 1
                                                                            => implicitReceiverTypeIndex!
                                                                    }
                                                            }
                                                    }
                                                }
                                        }
                                }
                            0 => receiverQualifiedIndex!
                            receiverQualifiedIndex! < (sourceQualifiedIndices! -> len)
                                and not implicitReceiverBinding!
                                -> while {
                                    qualifiedResults[sourceQualifiedIndices![receiverQualifiedIndex!]] => receiverQualified
                                    receiverQualified.sourceModule == sourceIndex and receiverQualified.status == 0
                                        -> if {
                                            receiverQualified.pathAst => receiverQualifiedAncestor!
                                            false => receiverQualifiedBelongs!
                                            receiverQualifiedAncestor! >= 0 and not receiverQualifiedBelongs!
                                                -> while {
                                                    receiverQualifiedAncestor! == receiverBinding.astNode
                                                        -> if {
                                                            true => receiverQualifiedBelongs!
                                                        } else {
                                                            package.nodes[sourceRange.astStart + receiverQualifiedAncestor!].parent => receiverQualifiedAncestor!
                                                        }
                                                }
                                            receiverQualifiedBelongs!
                                                and receiverQualified.targetModule >= 0
                                                and receiverQualified.targetModule < (identities -> len)
                                                -> if {
                                                    identities[receiverQualified.targetModule].sourceIndex
                                                        => receiverQualifiedTargetSource
                                                    package.ranges[receiverQualifiedTargetSource]
                                                        => receiverQualifiedTargetRange
                                                    receiverQualified.targetSymbol >= 0
                                                        and receiverQualified.targetSymbol < receiverQualifiedTargetRange.symbolCount
                                                        -> if {
                                                            package.symbols[receiverQualifiedTargetRange.symbolStart + receiverQualified.targetSymbol]
                                                                => receiverQualifiedTarget
                                                            -1 => receiverQualifiedOwnerSymbol!
                                                            receiverQualifiedTarget.kind == 3
                                                                or receiverQualifiedTarget.kind == 4
                                                                -> if {
                                                                    receiverQualified.targetSymbol
                                                                        => receiverQualifiedOwnerSymbol!
                                                                }
                                                            receiverQualifiedOwnerSymbol! < 0
                                                                and receiverQualifiedTarget.parent >= 0
                                                                -> if {
                                                                    package.symbols[receiverQualifiedTargetRange.symbolStart + receiverQualifiedTarget.parent]
                                                                        => receiverQualifiedParent
                                                                    receiverQualifiedParent.kind == 3
                                                                        or receiverQualifiedParent.kind == 4
                                                                        -> if {
                                                                            receiverQualifiedTarget.parent
                                                                                => receiverQualifiedOwnerSymbol!
                                                                        }
                                                                }
                                                            receiverQualifiedOwnerSymbol! >= 0 -> if {
                                                                receiverQualified.targetModule
                                                                    => receiverTypeModule!
                                                                receiverQualifiedOwnerSymbol!
                                                                    => receiverTypeSymbol!
