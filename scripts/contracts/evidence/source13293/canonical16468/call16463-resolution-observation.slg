                                                                                        => bindingProjectionReceiverType
                                                                                    bindingProjectionFieldOwnerType.kind == 1
                                                                                        and bindingProjectionReceiverType.kind == 1
                                                                                        and bindingProjectionFieldOwnerType.module == bindingProjectionReceiverType.module
                                                                                        and bindingProjectionFieldOwnerType.symbol == bindingProjectionReceiverType.symbol
                                                                                        -> if { true => bindingProjectionFieldOwnerMatches! }
                                                                                }
                                                                            bindingProjectionFieldOwnerMatches!
