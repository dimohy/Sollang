                                                # no nominal module/symbol coordinates. Preserve only
                                                # the structural kinds accepted by the type arena;
                                                # an unresolved carrier must keep the older recovery
                                                # paths available instead of becoming a false owner.
                                                (declaredReceiverValueType.kind == 2
                                                    or declaredReceiverValueType.kind == 3
                                                    or declaredReceiverValueType.kind == 4
                                                    or declaredReceiverValueType.kind == 5
                                                    or declaredReceiverValueType.kind == 6
                                                    or declaredReceiverValueType.kind == 12
                                                    or declaredReceiverValueType.kind == 13
                                                    or declaredReceiverValueType.kind == 14)
                                                    and declaredReceiverValueType.status == 0
