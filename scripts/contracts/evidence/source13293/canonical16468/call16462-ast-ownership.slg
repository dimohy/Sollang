import sollang.compiler.ast as ast
import sollang.compiler.lexer as lexer

main {
    "main { true => projected\ntrue and projected -> println }" => source
    source -> ast.lower => nodes
    source -> lexer.lex => tokens
    0 => index!
    index! < (nodes -> len) -> while {
        nodes[index!] => node
        node.payloadToken >= 0 -> if {
            tokens[node.payloadToken] => token
            source -> slice(token.span.start, token.span.length) => name
            "node=$(index!),parent=$(node.parent),kind=$(node.kind),rule=$(node.cstRuleId),payload=$(node.payloadToken),first=$(node.firstToken),count=$(node.tokenCount),name=$name" -> println
        }
        index! + 1 => index!
    }
}
