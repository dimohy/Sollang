import sollang.compiler.semantic.storage_placement as placement
import sys.process as process

writePlan name: Text, candidates: [placement.Candidate] -> Unit uses Console, Process {
    candidates -> placement.allocateFrame -> when {
        Err(error) {
            error -> when { InvalidCandidate(index) { "invalid-candidate=$index" -> println } }
            process.exit(1)
        }
        Ok(plan) {
            "$name|sizes:" -> print
            plan.slots -> each slot { "$(slot.size)," -> print }
            "|align:" -> print
            plan.slots -> each slot { "$(slot.align)," -> print }
            "|assigned:" -> print
            plan.slotsByCandidate -> each slot { "$slot," -> print }
            "|ends:" -> print
            plan.ends -> each ending { "$(ending.position),$(ending.slot),$(ending.size);" -> print }
            "" -> println
        }
    }
}

main {
    [placement.Candidate; ~] => candidates0
    "empty" -> writePlan(candidates0)
    [
    placement.Candidate { source: 0, size: 4092, start: 0, end: 1, endUnit: 1, automaticEnd: true }
    ] => candidates1
    "below-budget" -> writePlan(candidates1)
    [
    placement.Candidate { source: 0, size: 4096, start: 0, end: 1, endUnit: 1, automaticEnd: true }
    ] => candidates2
    "exact-budget" -> writePlan(candidates2)
    [
    placement.Candidate { source: 0, size: 4100, start: 0, end: 1, endUnit: 1, automaticEnd: true }
    ] => candidates3
    "above-budget" -> writePlan(candidates3)
    [
    placement.Candidate { source: 0, size: 32, start: 0, end: 1, endUnit: 1, automaticEnd: true },
    placement.Candidate { source: 1, size: 56, start: 2, end: 3, endUnit: 3, automaticEnd: true },
    placement.Candidate { source: 2, size: 8, start: 4, end: 5, endUnit: 5, automaticEnd: true }
    ] => candidates4
    "reused-slot-growth" -> writePlan(candidates4)
    [
    placement.Candidate { source: 0, size: 32, start: 0, end: 3, endUnit: 3, automaticEnd: true },
    placement.Candidate { source: 1, size: 56, start: 1, end: 2, endUnit: 2, automaticEnd: true }
    ] => candidates5
    "overlapping-lifetimes" -> writePlan(candidates5)
    [
    placement.Candidate { source: 0, size: 32, start: 0, end: 1, endUnit: 1, automaticEnd: true },
    placement.Candidate { source: 1, size: 56, start: 1, end: 2, endUnit: 2, automaticEnd: true }
    ] => candidates6
    "touching-lifetimes" -> writePlan(candidates6)
    [
    placement.Candidate { source: 0, size: 2048, start: 0, end: 3, endUnit: 3, automaticEnd: true },
    placement.Candidate { source: 1, size: 2048, start: 1, end: 3, endUnit: 3, automaticEnd: true },
    placement.Candidate { source: 2, size: 4, start: 2, end: 3, endUnit: 3, automaticEnd: true }
    ] => candidates7
    "live-frame-budget" -> writePlan(candidates7)
    [
    placement.Candidate { source: 0, size: 2048, start: 0, end: 1, endUnit: 1, automaticEnd: true },
    placement.Candidate { source: 1, size: 2048, start: 0, end: 4, endUnit: 4, automaticEnd: true },
    placement.Candidate { source: 2, size: 2052, start: 2, end: 3, endUnit: 3, automaticEnd: true },
    placement.Candidate { source: 3, size: 2048, start: 3, end: 5, endUnit: 5, automaticEnd: true }
    ] => candidates8
    "failed-growth-does-not-reserve" -> writePlan(candidates8)
    [
    placement.Candidate { source: 0, size: 32, start: 0, end: 1, endUnit: 1, automaticEnd: true },
    placement.Candidate { source: 1, size: 56, start: 0, end: 1, endUnit: 1, automaticEnd: true },
    placement.Candidate { source: 2, size: 40, start: 2, end: 3, endUnit: 3, automaticEnd: true },
    placement.Candidate { source: 3, size: 8, start: 2, end: 3, endUnit: 3, automaticEnd: true }
    ] => candidates9
    "minimum-growth-then-size" -> writePlan(candidates9)
    [
    placement.Candidate { source: 0, size: 64, start: 0, end: 1, endUnit: 1, automaticEnd: true },
    placement.Candidate { source: 1, size: 32, start: 0, end: 1, endUnit: 1, automaticEnd: true },
    placement.Candidate { source: 2, size: 8, start: 2, end: 3, endUnit: 3, automaticEnd: true }
    ] => candidates10
    "smaller-free-slot-tie" -> writePlan(candidates10)
    [
    placement.Candidate { source: 0, size: 32, start: 2, end: 3, endUnit: 3, automaticEnd: true },
    placement.Candidate { source: 1, size: 16, start: 0, end: 1, endUnit: 1, automaticEnd: true }
    ] => candidates11
    "stable-unsorted-candidates" -> writePlan(candidates11)
    [
    placement.Candidate { source: 0, size: 24, start: 0, end: 4, endUnit: 4, automaticEnd: false },
    placement.Candidate { source: 1, size: 16, start: 1, end: 2, endUnit: 2, automaticEnd: true }
    ] => candidates12
    "manual-end-still-occupies-slot" -> writePlan(candidates12)
    [
    placement.Candidate { source: 0, size: 2147483647, start: 0, end: 1, endUnit: 1, automaticEnd: true },
    placement.Candidate { source: 1, size: 32, start: 0, end: 1, endUnit: 1, automaticEnd: true }
    ] => candidates13
    "oversized-rejection-keeps-budget" -> writePlan(candidates13)
}
