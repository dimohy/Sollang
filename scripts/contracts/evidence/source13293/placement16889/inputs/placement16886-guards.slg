import sollang.compiler.semantic.storage_placement as placement
import sys.process as process

check name: Text, candidates: [placement.Candidate] -> Unit uses Console, Process {
    candidates -> placement.allocateFrame -> when {
        Err(error) {
            error -> when { InvalidCandidate(index) { "$name|invalid=$index" -> println } }
        }
        Ok(_) { process.exit(1) }
    }
}

main {
    [placement.Candidate { source: -1, size: 8, start: 0, end: 1, endUnit: 1, automaticEnd: true }] => source
    "source" -> check(source)
    [placement.Candidate { source: 0, size: -1, start: 0, end: 1, endUnit: 1, automaticEnd: true }] => size
    "size" -> check(size)
    [placement.Candidate { source: 0, size: 8, start: -1, end: 1, endUnit: 1, automaticEnd: true }] => start
    "start" -> check(start)
    [placement.Candidate { source: 0, size: 8, start: 2, end: 1, endUnit: 1, automaticEnd: true }] => end
    "end" -> check(end)
    [placement.Candidate { source: 0, size: 8, start: 0, end: 1, endUnit: -1, automaticEnd: true }] => unit
    "unit" -> check(unit)
    [
    placement.Candidate { source: 0, size: 8, start: 0, end: 1, endUnit: 1, automaticEnd: true },
    placement.Candidate { source: 1, size: -1, start: 2, end: 3, endUnit: 3, automaticEnd: true }
    ] => later
    "later" -> check(later)
}
