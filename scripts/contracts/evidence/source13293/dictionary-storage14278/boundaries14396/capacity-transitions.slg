main {
    {Int: Int} => empty
    empty -> capacity -> println
    {Int: Int; 0~} => hint0
    hint0 -> capacity -> println
    {Int: Int; 1~} => hint1
    hint1 -> capacity -> println
    {Int: Int; 2~} => hint2
    hint2 -> capacity -> println
    {Int: Int; 3~} => hint3
    hint3 -> capacity -> println
    {Int: Int; 4~} => hint4
    hint4 -> capacity -> println
    {Int: Int; 5~} => hint5
    hint5 -> capacity -> println
    {1: 10} => one
    one -> capacity -> println
    {1: 10, 2: 20} => two
    two -> capacity -> println
    {1: 10, 2: 20, 3: 30} => three
    three -> capacity -> println
    {1: 10, 2: 20, 3: 30, 4: 40} => four
    four -> capacity -> println
    {1: 10, 2: 20, 3: 30, 4: 40, 5: 50} => five
    five -> capacity -> println
}
