struct QueueState {
    revision: Int
    priorities: BinaryHeap<Int>
    completed: Int
}

main {
    QueueState { revision: 7, priorities: BinaryHeap<Int>(1), completed: 2 } => queue!
    queue!.priorities -> push(7)
    queue!.priorities -> push(9)
    queue!.priorities -> push(3)
    queue!.priorities -> peek => peak
    queue!.priorities -> len => length
    queue!.priorities -> capacity => capacity
    "rev=$(queue!.revision) peek=$peak len=$length cap=$capacity done=$(queue!.completed)" -> println
}
