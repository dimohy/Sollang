main {
    (BinaryHeap<Int64>(1), 7, 2) => queue!
    queue!._0 -> push(7)
    queue!._0 -> push(9)
    queue!._0 -> push(3)
    queue!._0 -> peek => peak
    queue!._0 -> len => length
    queue!._0 -> capacity => capacity
    "rev=$(queue!._1) peek=$peak len=$length cap=$capacity done=$(queue!._2)" -> println
}
