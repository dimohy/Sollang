enqueue state: mut (Int, BinaryHeap<Int>, Int) -> Unit {
    state._1 -> push(7)
    state._1 -> push(9)
    state._1 -> push(3)
}

main {
    (7, BinaryHeap<Int>(1), 2) => queue!
    queue! -> enqueue
    queue!._1 -> peek => peak
    queue!._1 -> len => length
    queue!._1 -> capacity => capacity
    "rev=$(queue!._0) peek=$peak len=$length cap=$capacity done=$(queue!._2)" -> println
}
