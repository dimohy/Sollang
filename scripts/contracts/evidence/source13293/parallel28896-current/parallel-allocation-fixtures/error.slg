fail value: Int -> Result<Int, Text> => Result<Int, Text>.Err("no")
runError values: [Int; ~] -> Result<[Int; ~], Text> {
    values -> tryParallel value { value -> fail } => output
    output
}
main {
    [1, 2; ~] -> runError => output
    output -> when {
        Ok(values) => 0
        Err(error) => 1
    } -> println
}
