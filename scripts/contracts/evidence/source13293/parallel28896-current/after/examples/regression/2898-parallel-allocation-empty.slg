increment value: Int -> Int => value + 1
succeed value: Int -> Result<Int, Text> => Result<Int, Text>.Ok(value * 2)
runPool values: [Int; ~] -> [Int; ~] {
    values -> parallel value { value -> increment } => output
    output
}
runTry values: [Int; ~] -> Result<[Int; ~], Text> {
    values -> tryParallel value { value -> succeed } => output
    output
}
main {
    [Int; ~] -> runPool => empty
    empty -> len -> println
    [Int; ~] -> runTry => attempted
    attempted -> when {
        Ok(values) => values -> len
        Err(error) => -1
    } -> println
}
