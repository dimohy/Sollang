import sys.file as file

struct Inner {
    text: Text
}

struct Outer {
    inner: Inner
}

prefix source: file.SourceText -> Outer {
    source -> slice(UIntSize(0), UIntSize(3)) => view
    Outer { inner: Inner { text: view } }
}

consume source: move file.SourceText -> Unit {
}

main {
    "lexer" -> file.borrowText => source
    source -> prefix => views
    source -> consume
    views.inner.text -> println
}
