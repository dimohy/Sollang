+    consumerIndex! < sourceCount -> while {
+        nodes[consumerIndex!] => consumer
+        consumer.kind == 6 and consumer.opcode == -208 and consumer.operand0 >= 0 and consumer.operand0 < sourceCount
+            -> if {
+                consumer.operand0 => producerIndex
+                nodes[producerIndex] -> isUserStreamInvocation(prepared)
+                    and nodes[producerIndex].parent == consumerIndex!
+                    -> if {
+                        prepared.package.ranges[consumer.sourceModule] => range
+                        prepared.package.nodes[range.astStart + consumer.astNode] => callAst
+                        callAst.start + callAst.length => bodyStart!
+                        callAst.payloadToken + 1 => tokenIndex!
+                        false => foundBody!
+                        tokenIndex! < callAst.firstToken + callAst.tokenCount and not foundBody!
+                            -> while {
+                                prepared.package.tokens[range.tokenStart + tokenIndex!] => token
+                                token.kind == grammar.tokenIdLeftBrace() -> if {
+                                    token.span.start => bodyStart!
