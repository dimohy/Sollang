+struct BlockCallbackBody {
+    nodes: [Int; ~]
+    tail: Int
+}
+
+collectBlockCallback nodes: ref [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, callIndex: Int, sourceCount: Int, bodyStart: UIntSize -> BlockCallbackBody {
+    nodes[callIndex] => call
+    prepared.package.ranges[call.sourceModule] => sourceRange
+    [Int; ~] => callbackNodes!
+    -1 => callbackTail!
+    UIntSize(0) => callbackTailStart!
+    0 => callbackIndex!
+    callbackIndex! < sourceCount -> while {
+        nodes[callbackIndex!] => candidate
+        candidate.sourceModule == call.sourceModule and candidate.astNode >= 0
+            -> if {
+                prepared.package.nodes[sourceRange.astStart + candidate.astNode] => candidateAst
+                candidateAst.start > bodyStart -> if {
+                    candidate.parent => ancestor!
+                    false => belongs!
+                    ancestor! >= 0 and not belongs! -> while {
+                        ancestor! == callIndex -> if { true => belongs! } else { nodes[ancestor!].parent => ancestor! }
+                    }
+                    belongs! -> if {
+                        callbackNodes! -> push(callbackIndex!)
+                        candidate.parent == callIndex and candidate.kind != 17
+                            and (callbackTail! < 0 or candidateAst.start >= callbackTailStart!)
+                            -> if {
+                                callbackIndex! => callbackTail!
+                                candidateAst.start => callbackTailStart!
+                            }
+                    }
+                }
+            }
+        callbackIndex! + 1 => callbackIndex!
+    }
+    BlockCallbackBody { nodes: callbackNodes!, tail: callbackTail! }
+}
