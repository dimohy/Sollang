+# Direct consumers share the ordinary callback copier. Their explicit cleanup
+# scopes make break leave the producer and continue finish only this item.
+public materializeUserStreamConsumers nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~] -> Unit {
