+# A copied source producer keeps its declaration identity after becoming a
+# lexical scope. Deferred provenance and native producers are distinct.
+isUserStreamInvocation node: TypedIrNode, prepared: ref semanticContext.SemanticSnapshot -> Bool {
+    node.kind != 19 or node.opcode != -227 or node.symbol < 0
+        or node.targetModule < 0 or node.targetModule >= (prepared.package.ranges -> len)
+        -> if { false -> return }
+    prepared.package.ranges[node.targetModule] => range
+    node.symbol >= range.symbolCount -> if { false -> return }
+    prepared.package.symbols[range.symbolStart + node.symbol] -> symbols.isUserStreamFunction
+}
