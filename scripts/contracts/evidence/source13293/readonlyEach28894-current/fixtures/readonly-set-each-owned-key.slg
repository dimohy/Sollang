struct Key {
    id: Int
    payload: box Int
}
trait Hash { hash: self -> Int }
trait Eq { eq: self -> Int }
impl Hash for Key { hash: self -> Int => self.id }
impl Eq for Key { eq: self -> Int => self.id }
sum keys: ref Set<Key> -> Int {
    0 => total!
    keys -> each key { total! + key.id => total! }
    total!
}
main {
    Set<Key>(4) => keys!
    keys! -> insert(Key { id: 10, payload: box 1 }) -> println
    keys! -> insert(Key { id: 20, payload: box 2 }) -> println
    keys! -> sum -> println
}
