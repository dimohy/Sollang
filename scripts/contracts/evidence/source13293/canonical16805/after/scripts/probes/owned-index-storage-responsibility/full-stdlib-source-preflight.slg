namespace sollang.compiler.llvm.text

import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.expression_type_ids as expressionTypeIds
import sollang.compiler.semantic.diagnostics as diagnostics
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.semantic.module_interfaces as interfaces
import sollang.compiler.ir.module_artifact_types as typeArtifacts
import sollang.compiler.llvm.emitter.diagnostics as emitterDiagnostics
import sollang.compiler.llvm.target as llvmTarget
import sollang.compiler.syntax.source_decoding as sourceDecoding
import sys.file as file
import sys.path as path
import std.time as time

public observeCheckedPreparation: -> Result<Int, time.Error> uses Console, File, Clock {
    [Text; ~] => sources!
    # STDLIB_SOURCE_PATHS
    # ACTIVE_PROBE_PATH
    sources! -> len => packageCount
    packageCount - 1 => stdlibCount
    time.monotonicClock() => clock
    clock -> now => preparationStarted
    sources! -> semanticContext.prepareFiles => initialPrepared!
    stdlibCount => initialPrepared!.standardLibrarySourceCount
    initialPrepared! -> freeze => initialPrepared
    clock -> now => sourcePrepared
    initialPrepared -> expressionTypeIds.resolveCallContext => resolved
    clock -> now => callContextResolved
    resolved.prepared => prepared
    resolved.types => types
    typeIds.enumPayloadEdges(types.types, types.references, prepared.package.ranges, prepared.package.symbols, types.referenceIndexByTypeAst) => payloadEdges
    prepared -> semanticContext.ownedResourceSeeds(types.types) => resources
    typeIds.ownedStorageByType(types.types, types.fields, payloadEdges, resources) => storage
    prepared -> diagnostics.firstOwnedIndexReadDiagnostic(types, storage) => diagnostic
    0 => totalBodies!
    0 => activeBodies!
    prepared.package.ranges -> each range {
        prepared -> semanticContext.isStandardLibrarySource(range.sourceModule)
            -> if {
                0 => nodeIndex!
                nodeIndex! < range.astCount -> while {
                    prepared.package.nodes[range.astStart + nodeIndex!] => node
                    (node.kind == 7 or node.kind == 31) and node.flags / 128 % 2 == 0
                        -> if {
                            totalBodies! + 1 => totalBodies!
                            prepared -> diagnostics.declarationBodyIsActive(types, range.sourceModule, nodeIndex!)
                                -> if { activeBodies! + 1 => activeBodies! }
                        }
                    nodeIndex! + 1 => nodeIndex!
                }
            }
    }
    clock -> now => ownedIndexBodyChecked
    [file.SourceText; ~] => checkedOwners!
    sources! -> each location {
        location -> file.mapText => source
        checkedOwners! -> push(source)
    }
    [Text; ~] => checkedSources!
    checkedOwners! -> each owner {
        owner -> sourceDecoding.utf8Text => source
        checkedSources! -> push(source)
    }
    llvmTarget.windowsX64() => target
    # Consume the actual checked preparation, including full alias admission.
    PrepareRequest { sources: checkedSources!, standardLibrarySourceStart: 0, standardLibrarySourceCount: stdlibCount, pointerBitWidth: target.pointerBitWidth, targetArchitecture: target.architecture, cpuDispatchPolicy: target.dispatchPolicy, requiredCpuFeatures: target.requiredFeatures, allowedCpuFeatures: target.allowedFeatures, forbiddenCpuFeatures: target.forbiddenFeatures, supportsComputePool: true, expectedPathStyle: 1 } => request
    request -> prepareCheckedPaths(sources!, "windows-x64", path.nativeStyle()) -> when {
        DeclarationRejected(rejection) {
            rejection -> emitFunctionDeclarationRejection(sources!)
            1
        }
        Rejected(rejection) {
            rejection -> emitSignatureRejection(sources!)
            1
        }
        ImportRejected(rejection) {
            rejection -> emitInterpolationImportRejection(sources!)
            1
        }
        Ready(context) {
            context -> emitterDiagnostics.blockingDiagnosticCount => semanticCount
            semanticCount > 0 -> if {
                context -> emitterDiagnostics.emitBlockingDiagnostics
                semanticCount
            } else {
                context -> irInvariantDiagnosticCount => invariantCount
                invariantCount > 0 -> if { context -> emitIrInvariantDiagnostics }
                invariantCount
            }
        }
    } => checkedSemanticCount
    clock -> now => checkedFilesValidated
    sourcePrepared -> durationSince(preparationStarted)? -> asMilliseconds => sourceMilliseconds
    callContextResolved -> durationSince(sourcePrepared)? -> asMilliseconds => callMilliseconds
    ownedIndexBodyChecked -> durationSince(callContextResolved)? -> asMilliseconds => ownedMilliseconds
    checkedFilesValidated -> durationSince(ownedIndexBodyChecked)? -> asMilliseconds => checkedMilliseconds
    prepared.package -> interfaces.declarationIdentitiesAnalyzed(prepared.modules) => declarationIndex
    clock -> now => declarationIndexed
    declarationIndexed -> durationSince(checkedFilesValidated)? -> asMilliseconds => declarationMilliseconds
    prepared.package -> typeArtifacts.captureTypeDetailsAnalyzed(types.types, types.references, types.fields) => typeDetails
    clock -> now => typeDetailsCaptured
    typeDetailsCaptured -> durationSince(declarationIndexed)? -> asMilliseconds => typeDetailMilliseconds
    totalBodies! - activeBodies! => inactiveBodies
    """{"diagnosticSourceModule":""" -> print
    diagnostic.sourceModule -> print
    ""","fullStdlibSourceCount":""" -> print
    stdlibCount -> print
    ""","packageSourceCount":""" -> print
    packageCount -> print
    ""","activeStdlibBodyCount":""" -> print
    activeBodies! -> print
    ""","stdlibBodyCount":""" -> print
    totalBodies! -> print
    ""","inactiveStdlibBodyCount":""" -> print
    inactiveBodies -> print
    ""","checkedSemanticDiagnosticCount":""" -> print
    checkedSemanticCount -> print
    ""","sourcePreparationMilliseconds":""" -> print
    sourceMilliseconds -> print
    ""","callContextResolutionMilliseconds":""" -> print
    callMilliseconds -> print
    ""","ownedIndexBodyCheckMilliseconds":""" -> print
    ownedMilliseconds -> print
    ""","checkedFileValidationMilliseconds":""" -> print
    checkedMilliseconds -> print
    ""","declarationIdentityStatus":""" -> print
    declarationIndex.status -> print
    ""","declarationIdentityCount":""" -> print
    declarationIndex.sourceModules -> len -> print
    ""","declarationIdentityMilliseconds":""" -> print
    declarationMilliseconds -> print
    ""","typeDetailStatus":""" -> print
    typeDetails.status -> print
    ""","typeDetailCount":""" -> print
    (typeDetails.starts -> len) -> print
    ""","resolvedTypeCount":""" -> print
    (types.types -> len) -> print
    ""","typeDetailMilliseconds":""" -> print
    typeDetailMilliseconds -> print
    "}" -> println
    checkedSemanticCount -> Result<Int, time.Error>.Ok
}

main {
    sollang.compiler.llvm.text.observeCheckedPreparation() -> when {
        Ok(count) {}
        Err(error) { "profile clock error" -> println }
    }
}
