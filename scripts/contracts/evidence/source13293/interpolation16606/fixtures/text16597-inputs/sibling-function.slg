emit values: [Int] -> Unit uses Console {
    values -> each item {
        item == 0 -> if {
            "left" => name!
            item < 0 -> if { "changed" => name! }
            "value $(name!)" -> println
        } else {
            "right" => name!
            item < 0 -> if { "changed" => name! }
            "value $(name!)" -> println
        }
    }
}
main { [0, 1] -> emit }
