+# Source stream bodies use continuation lowering rather than an ordinary
+# callback result. Native/intrinsic declarations never supply a copied body.
+public isUserStreamFunction declaration: Symbol -> Bool {
+    (declaration.kind == 7 or declaration.kind == 31)
+        and declaration.flags / 64 % 2 == 1
+        and declaration.flags / 128 % 2 == 0
+}
