+struct CallArgumentBindingIndex {
+    firstByAst: [Int; ~]
+    nextBinding: [Int; ~]
+}
+
+# C# specializes from the owning call's arguments. These source/AST identities
+# stay fixed through the core; actual type and status facts are read live.
+indexCallArgumentBindings package: ref analysis.PackageAnalysis, bindings: ref [semanticContext.CallArgumentBinding; ~] -> CallArgumentBindingIndex {
+    [Int; ~] => first!
+    [Int; ~] => next!
+    package.nodes -> each node { first! -> push(-1) }
+    bindings -> each binding { next! -> push(-1) }
+    bindings -> len => index!
+    index! > 0 -> while {
+        index! - 1 => index!
+        bindings[index!] => binding
+        binding.sourceModule >= 0 and binding.sourceModule < (package.ranges -> len)
+            -> if {
+                package.ranges[binding.sourceModule] => range
+                binding.callAst >= 0 and binding.callAst < range.astCount
+                    -> if {
+                        range.astStart + binding.callAst => globalCall
+                        first![globalCall] => next![index!]
+                        index! => first![globalCall]
+                    }
+            }
+    }
+    CallArgumentBindingIndex { firstByAst: first!, nextBinding: next! }
+}
