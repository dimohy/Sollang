struct Point { x: Int }

produce<R> owner: move box Point -> stream R uses Console block item: Int -> R {
    box Point { x: 23 } => temporary
    owner.x + temporary.x -> yield -> emit
    "producer=tail" -> println
}

main {
    box Point { x: 99 } => retained
    box Point { x: 13 } -> produce item { item } -> each value {
        value -> println
        break
    }
    retained.x -> println
}
