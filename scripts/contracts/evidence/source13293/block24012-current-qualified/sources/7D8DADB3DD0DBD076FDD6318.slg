produce<R> values: Range -> stream R uses Console block item: Int -> R {
    "producer=begin" -> println
    values -> each item {
        item -> yield -> emit
    }
    "producer=end" -> println
}

main {
    1..3 -> produce item {
        item * 10
    } -> each value {
        "value=$value" -> println
        break
    }
}
