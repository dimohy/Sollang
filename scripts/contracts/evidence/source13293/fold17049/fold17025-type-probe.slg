import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.expression_type_ids as expressionTypeIds
import sollang.compiler.ir.typed as typedIr

main {
    """
    main {
        "value=$(1..3 -> fold 0 total, item { total + item })" -> println
    }
    """ => source
    [source,; ~] -> semanticContext.prepare => prepared
    prepared -> expressionTypeIds.resolveContext => facts
    -1 => root!
    prepared.interpolations -> each fragment {
        fragment.kind == 17 -> if { fragment.valueAst => root! }
    }
    facts.expressions -> each expression {
        expression.sourceModule == 0 and expression.astNode == root! and expression.typeId >= 0
            -> if { "ast-root=$(facts.types[expression.typeId].symbol)" -> println }
    }
    prepared -> typedIr.lowerResolvedContext(facts) => ir
    ir -> each node {
        node.sourceModule == 0 and node.astNode == root!
            -> if { "ir-root=$(node.typeSymbol)" -> println }
        node.sourceModule == 0 and node.kind == 32
            -> if { "ir-fold=$(node.typeSymbol)" -> println }
    }
}
