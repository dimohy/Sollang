import sys.process as process

reportPlacement context: ref emitterContext.EmitContext, expectedModule: Int -> Unit uses Console, Process {
    context.storagePlacement -> when {
        Err(_) {
            context -> placementPreparationDiagnosticCount => failures
            process.exit(1)
        }
        Ok(table) {
            (table.frameByFunction -> len) != (context.ir -> len)
                -> if { process.exit(2) }
            0 => mains!
            0 => functions!
            0 => mainSlots!
            0 => functionSlots!
            0 => ordinal!
            table.frames -> each frame {
                frame.sourceModule != expectedModule or table.frameByFunction[frame.functionIr] != ordinal!
                    or context.ir[frame.functionIr].astNode != frame.frameAst
                    -> if { process.exit(3) }
                frame.range.slotStart < 0 or frame.range.slotStart + frame.range.slotCount > (table.slots -> len)
                    or frame.range.allocationStart < 0 or frame.range.allocationStart + frame.range.allocationCount > (table.allocations -> len)
                    or frame.range.endStart < 0 or frame.range.endStart + frame.range.endCount > (table.ends -> len)
                    -> if { process.exit(4) }
                context.ir[frame.functionIr].kind == 11 -> if {
                    mains! + 1 => mains!
                    mainSlots! + frame.range.slotCount => mainSlots!
                } else {
                    context.ir[frame.functionIr].kind != 0 -> if { process.exit(5) }
                    functions! + 1 => functions!
                    functionSlots! + frame.range.slotCount => functionSlots!
                }
                ordinal! + 1 => ordinal!
            }
            "frames:$(table.frames -> len)" -> println
            "main-frames:$(mains!)" -> println
            "function-frames:$(functions!)" -> println
            "main-slots:$(mainSlots!)" -> println
            "function-slots:$(functionSlots!)" -> println
            "allocations:$(table.allocations -> len)" -> println
            "ends:$(table.ends -> len)" -> println
            table.slots -> each slot { "slot:$(slot.size):$(slot.align)" -> println }
            table.frames -> each frame { frame.functionIr -> emitStorageFrameAllocations(context) }
            0 => found!
            table.frames -> each frame {
                frame.range.allocationStart => allocationIndex!
                allocationIndex! < frame.range.allocationStart + frame.range.allocationCount
                    -> while {
                        table.allocations[allocationIndex!] => expected
                        false => matched!
                        0 => nodeIndex!
                        nodeIndex! < (context.ir -> len) and not matched!
                            -> while {
                                context.ir[nodeIndex!] => node
                                node.sourceModule == expected.sourceModule and node.astNode == expected.sourceAst
                                    -> if {
                                        nodeIndex! -> storagePackage.frameForNode(context.ir, table) -> when {
                                            Err(_) { process.exit(10) }
                                            Ok(owner) { owner -> when {
                                                    None { }
                                                    Some(ownerIndex) {
                                                        table.frames[ownerIndex].functionIr == frame.functionIr
                                                            -> if {
                                                                nodeIndex! -> storageAllocationForNode(context, table) -> when {
                                                                    Err(_) { process.exit(11) }
                                                                    Ok(allocation) { allocation -> when {
                                                                            None { process.exit(12) }
                                                                            Some(actual) {
                                                                                actual.sourceModule != expected.sourceModule or actual.sourceAst != expected.sourceAst
                                                                                    or actual.slot != expected.slot or actual.size != expected.size
                                                                                    -> if { process.exit(13) }
                                                                                true => matched!
                                                                            }
                                                                    } }
                                                                }
                                                            }
                                                    }
                                            } }
                                        }
                                    }
                                nodeIndex! + 1 => nodeIndex!
                            }
                        not matched! -> if { process.exit(14) }
                        found! + 1 => found!
                        allocationIndex! + 1 => allocationIndex!
                    }
            }
            "allocation-lookups:$(found!)" -> println
            0 => rejected!
            [-1, Int(context.ir -> len)] -> each invalidIndex {
                invalidIndex -> storageAllocationForNode(context, table) -> when {
                    Err(_) { rejected! + 1 => rejected! }
                    Ok(_) { process.exit(15) }
                }
            }
            "invalid-lookups:$(rejected!)" -> println
            0 => promoted!
            0 => heap!
            context -> prepareCoreEmitterState => state
            0 => literalIndex!
            literalIndex! < (context.ir -> len) -> while {
                literalIndex! -> isDirectFixedIntStorage(context, state)
                    -> if {
                        literalIndex! -> fixedArrayLiteralNeedsHeap(context, state)
                            -> if {
                                heap! + 1 => heap!
                            } else {
                                promoted! + 1 => promoted!
                                literalIndex! -> emitFixedStorageLifetimeStart(context, state)
                            }
                    }
                literalIndex! + 1 => literalIndex!
            }
            "fixed-decisions:$(promoted!):$(heap!)" -> println
        }
    }
}

inspectPlacementFiles paths: move [Text; ~], label: Text -> Unit uses Console, File, Process {
    [file.SourceText; ~] => owners!
    paths -> each sourcePath { sourcePath -> file.mapText => owner
        owners! -> push(owner)
    }
    [Text; ~] => sources!
    0 => index!
    index! < (owners! -> len) -> while {
        owners![index!] -> sourceDecoding.utf8Text => source
        sources! -> push(source)
        index! + 1 => index!
    }
    llvmTarget.windowsX64() => target
    PrepareRequest { sources: sources!, standardLibrarySourceStart: 0, standardLibrarySourceCount: 144, pointerBitWidth: target.pointerBitWidth, targetArchitecture: target.architecture, cpuDispatchPolicy: target.dispatchPolicy, requiredCpuFeatures: target.requiredFeatures, allowedCpuFeatures: target.allowedFeatures, forbiddenCpuFeatures: target.forbiddenFeatures, supportsComputePool: true, expectedPathStyle: 1 } => request
    request -> prepareCheckedLibraryFiles(paths, "windows-x64", path.nativeStyle()) -> when {
        DeclarationRejected(rejection) { rejection -> emitFunctionDeclarationRejection(paths)
            process.exit(6)
            return
        }
        Rejected(rejection) { rejection -> emitSignatureRejection(paths)
            process.exit(7)
            return
        }
        ImportRejected(rejection) { rejection -> emitInterpolationImportRejection(paths)
            process.exit(8)
            return
        }
        Ready(context) { context }
    } => context
    context -> checkedContextDiagnosticCount => count
    count != 0 -> if { context -> diagnostics.emitBlockingDiagnostics
        process.exit(9)
    }
    "case:$label" -> println
    context -> reportPlacement(144)
}

