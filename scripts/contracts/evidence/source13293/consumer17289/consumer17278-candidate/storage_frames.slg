namespace sollang.compiler.llvm.text

import sollang.compiler.llvm.emitter.context as emitterContext
import sollang.compiler.semantic.storage_placement_merge as frameMerge
import sollang.compiler.semantic.storage_placement_package as storagePackage
import sys.process as process

# Emission starts only after checkedContextDiagnosticCount. Keep an explicit
# terminating diagnostic if a consumer violates that checked boundary.
checkedStorageAllocation nodeIndex: Int, context: ref emitterContext.EmitContext -> Option<frameMerge.Allocation> uses Console, Process {
    context.storagePlacement -> when {
        Err(_) {
            context -> placementPreparationDiagnosticCount => failures
            process.exit(1)
        }
        Ok(table) {
            nodeIndex -> storageAllocationForNode(context, table) -> when {
                Err(_) {
                    "; sollang compiler error S052: PLACEMENT_INVALID_LOOKUP $nodeIndex" -> println
                    process.exit(1)
                }
                Ok(allocation) { allocation -> return }
            }
        }
    }
    # process.exit has Unit type; this typed tail is unreachable on either
    # rejected path. It is never a recovery choice for an invalid plan.
    Option<frameMerge.Allocation>.None
}

isDirectFixedIntStorage nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    nodeIndex < 0 or nodeIndex >= (context.ir -> len)
        -> if { false -> return }
    context.ir[nodeIndex] => node
    node.kind != 14 or not (node -> isFixedArrayType) or node.parent < 0 or node.parent >= (context.ir -> len)
        -> if { false -> return }
    context.ir[node.parent] => binding
    binding.kind != 17 or binding.operand0 != nodeIndex
        -> if { false -> return }
    node -> arrayElementTypeId(context, state) => elementId
    elementId < 0 or elementId >= (context.types -> len)
        -> if { false -> return }
    context.types[elementId] => element
    element.kind == 1 and element.origin == 1 and element.symbol == 2
}

emitFixedStorageLifetimeStart nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    nodeIndex -> isDirectFixedIntStorage(context, state)
        -> if {
            nodeIndex -> checkedStorageAllocation(context) -> when {
                None { }
                Some(allocation) {
                    "  call void @llvm.lifetime.start.p0(i64 $(allocation.size), ptr %stack_slot$(allocation.slot))" -> println
                }
            }
        }
}

# Match the allocation source inside the concrete owning function. Neither an
# AST identity alone nor a physical global slot offset identifies an instance.
storageAllocationForNode nodeIndex: Int, context: ref emitterContext.EmitContext, table: ref storagePackage.Table -> Result<Option<frameMerge.Allocation>, storagePackage.Error> {
    nodeIndex -> storagePackage.frameForNode(context.ir, table) -> when {
        Err(error) { error -> Result<Option<frameMerge.Allocation>, storagePackage.Error>.Err }
        Ok(frame) { frame -> when {
                None { Option<frameMerge.Allocation>.None -> Result<Option<frameMerge.Allocation>, storagePackage.Error>.Ok }
                Some(frameIndex) {
                    context.ir[nodeIndex] => node
                    table.frames[frameIndex].range => range
                    range.allocationStart => allocationIndex!
                    allocationIndex! < range.allocationStart + range.allocationCount
                        -> while {
                            table.allocations[allocationIndex!] => allocation
                            allocation.sourceModule == node.sourceModule and allocation.sourceAst == node.astNode
                                -> if { allocation -> Option<frameMerge.Allocation>.Some -> Result<Option<frameMerge.Allocation>, storagePackage.Error>.Ok -> return }
                            allocationIndex! + 1 => allocationIndex!
                        }
                    Option<frameMerge.Allocation>.None -> Result<Option<frameMerge.Allocation>, storagePackage.Error>.Ok
                }
        } }
    }
}

# The checked final context owns the table. Slot indexes are local to a concrete
# IR function even when several instances share the same source declaration.
emitStorageFrameAllocations ownerIndex: Int, context: ref emitterContext.EmitContext -> Unit uses Console, Process {
    context.storagePlacement -> when {
        Err(_) {
            context -> placementPreparationDiagnosticCount => failures
            process.exit(1)
        }
        Ok(table) {
            ownerIndex -> storagePackage.frameForNode(context.ir, table) -> when {
                Err(_) {
                    "; sollang compiler error S052: PLACEMENT_INVALID_LOOKUP $ownerIndex" -> println
                    process.exit(1)
                }
                Ok(frame) { frame -> when {
                        None { }
                        Some(frameIndex) {
                            table.frames[frameIndex].range => range
                            0 => slotIndex!
                            slotIndex! < range.slotCount -> while {
                                table.slots[range.slotStart + slotIndex!] => slot
                                "  %stack_slot$(slotIndex!) = alloca [$(slot.size) x i8], align $(slot.align)" -> println
                                slotIndex! + 1 => slotIndex!
                            }
                        }
                } }
            }
        }
    }
}
