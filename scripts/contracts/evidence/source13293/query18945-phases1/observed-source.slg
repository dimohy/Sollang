                                                }
                                        }
                                    }
                                # An inferred binding may be initialized from a nominal
                                # field projection: `session.connection => connection`.
                                # Resolve the initializer's lexical root, then walk its
                                # exact field path through the canonical type graph. Method
                                # lookup must not fall back to a same-name impl when several
                                # owners expose `close`, `send`, or another common verb.
                                (receiverTypeModule! < 0 or receiverTypeSymbol! < 0)
                                    and receiverBinding.typeNode < 0
                                    and not implicitReceiverBinding!
                                    -> if {
                                        package.tokens[sourceRange.tokenStart + receiverBinding.nameToken]
                                            => bindingProjectionTargetName
                                        package.nodes[sourceRange.astStart + receiverBinding.astNode]
                                            => bindingProjectionOwnerAst
                                        false => bindingProjectionHasDot!
                                        bindingProjectionOwnerAst.firstToken
                                            => bindingProjectionShapeTokenIndex!
                                        bindingProjectionShapeTokenIndex! < bindingProjectionOwnerAst.firstToken + bindingProjectionOwnerAst.tokenCount
                                            and not bindingProjectionHasDot!
                                            -> while {
                                                package.tokens[sourceRange.tokenStart + bindingProjectionShapeTokenIndex!]
                                                    => bindingProjectionShapeToken
                                                bindingProjectionShapeToken.span.start < bindingProjectionTargetName.span.start
                                                    and bindingProjectionShapeToken.kind == grammar.tokenIdDot()
                                                    -> if {
                                                        true => bindingProjectionHasDot!
                                                    }
                                                bindingProjectionShapeTokenIndex! + 1
                                                    => bindingProjectionShapeTokenIndex!
                                            }
                                        bindingProjectionHasDot! -> if {
                                            -1 => bindingProjectionPathAst!
                                            -1 => bindingProjectionRootSymbol!
                                            -1 => bindingProjectionRootNameToken!
                                            UIntSize(0) => bindingProjectionEnd!
                                            0 => bindingProjectionNameIndex!
                                            bindingProjectionNameIndex! < sourceRange.nameCount
                                                -> while {
                                                    package.names[sourceRange.nameStart + bindingProjectionNameIndex!]
                                                        => bindingProjectionName
                                                    package.tokens[sourceRange.tokenStart + bindingProjectionName.nameToken]
                                                        => bindingProjectionNameToken
                                                    bindingProjectionName.symbol >= 0
                                                        and bindingProjectionName.symbol != receiverSymbol
                                                        and bindingProjectionNameToken.span.start < bindingProjectionTargetName.span.start
                                                        -> if {
                                                            package.symbols[sourceRange.symbolStart + bindingProjectionName.symbol]
                                                                => bindingProjectionRoot
                                                            bindingProjectionRoot.typeNode >= 0
                                                                or bindingProjectionRoot.kind == 35
                                                                -> if {
                                                                    bindingProjectionName.astNode
                                                                        => bindingProjectionAncestor!
                                                                    -1 => bindingProjectionCandidatePath!
                                                                    false => bindingProjectionBelongs!
                                                                    bindingProjectionAncestor! >= 0
                                                                        and not bindingProjectionBelongs!
                                                                        -> while {
                                                                            bindingProjectionAncestor! == receiverBinding.astNode
                                                                                -> if {
                                                                                    true => bindingProjectionBelongs!
                                                                                } else {
                                                                                    package.nodes[sourceRange.astStart + bindingProjectionAncestor!]
                                                                                        => bindingProjectionAncestorNode
                                                                                    bindingProjectionAncestorNode.kind == 36
                                                                                        -> if {
                                                                                            bindingProjectionAncestor!
                                                                                                => bindingProjectionCandidatePath!
                                                                                        }
                                                                                    bindingProjectionAncestorNode.parent
                                                                                        => bindingProjectionAncestor!
                                                                                }
                                                                        }
                                                                    bindingProjectionBelongs!
                                                                        and bindingProjectionCandidatePath! >= 0
                                                                        -> if {
                                                                            package.nodes[sourceRange.astStart + bindingProjectionCandidatePath!]
                                                                                => bindingProjectionCandidate
                                                                            bindingProjectionCandidate.start + bindingProjectionCandidate.length
                                                                                => bindingProjectionCandidateEnd
                                                                            bindingProjectionCandidateEnd <= bindingProjectionTargetName.span.start
                                                                                and (bindingProjectionPathAst! < 0
                                                                                or bindingProjectionCandidateEnd >= bindingProjectionEnd!)
                                                                                -> if {
                                                                                    bindingProjectionCandidatePath!
                                                                                        => bindingProjectionPathAst!
                                                                                    bindingProjectionName.symbol
                                                                                        => bindingProjectionRootSymbol!
                                                                                    bindingProjectionName.nameToken
                                                                                        => bindingProjectionRootNameToken!
                                                                                    bindingProjectionCandidateEnd
                                                                                        => bindingProjectionEnd!
                                                                                }
                                                                        }
                                                                }
                                                        }
                                                    bindingProjectionNameIndex! + 1
                                                        => bindingProjectionNameIndex!
                                                }
                                            bindingProjectionPathAst! >= 0
                                                and bindingProjectionRootSymbol! >= 0
                                                and bindingProjectionRootNameToken! >= 0
                                                -> if {
                                                    package.symbols[sourceRange.symbolStart + bindingProjectionRootSymbol!]
                                                        => bindingProjectionRoot
                                                    -1 => bindingProjectionTypeId!
                                                    bindingProjectionRoot.typeNode < 0
                                                        and bindingProjectionRoot.kind == 35
                                                        -> if {
                                                            sourceIndex -> patternBindingTypeId(
                                                            bindingProjectionRoot,
                                                            package,
                                                            semantic,
                                                            identities,
                                                            qualifiedResults,
                                                            results!)
                                                                => bindingProjectionTypeId!
                                                        }
                                                    bindingProjectionRoot.typeNode >= 0 -> if {
                                                        lastSourceReferenceIndex(package, semantic.references, referenceIndex, sourceIndex, bindingProjectionRoot.typeNode) => bindingProjectionReferenceIndex
                                                        bindingProjectionReferenceIndex >= 0 -> if {
                                                            semantic.references[bindingProjectionReferenceIndex].typeId => bindingProjectionTypeId!
                                                        }
                                                    }
                                                    bindingProjectionTypeId! >= 0 -> if {
                                                        semantic.types[bindingProjectionTypeId!]
                                                            => bindingProjectionRootType
                                                        bindingProjectionRootType.kind == 8
                                                            and bindingProjectionRootType.first >= 0
                                                            -> if {
                                                                bindingProjectionRootType.first
                                                                    => bindingProjectionTypeId!
                                                            }
                                                        package.nodes[sourceRange.astStart + bindingProjectionPathAst!]
                                                            => bindingProjectionPath
                                                        package.tokens[sourceRange.tokenStart + bindingProjectionRootNameToken!]
                                                            => bindingProjectionRootName
                                                        true => bindingProjectionValid!
                                                        false => bindingProjectionResolvedField!
                                                        bindingProjectionPath.firstToken
                                                            => bindingProjectionTokenIndex!
                                                        bindingProjectionTokenIndex! < bindingProjectionPath.firstToken + bindingProjectionPath.tokenCount
                                                            -> while {
                                                                package.tokens[sourceRange.tokenStart + bindingProjectionTokenIndex!]
                                                                    => bindingProjectionToken
                                                                bindingProjectionValid!
                                                                    and bindingProjectionToken.kind == grammar.tokenIdIdentifier()
                                                                    and bindingProjectionToken.span.start > bindingProjectionRootName.span.start
                                                                    -> if {
                                                                        bindingProjectionTypeId! => bindingProjectionOwnerTypeId!
                                                                        semantic.types[bindingProjectionOwnerTypeId!].kind == 8
                                                                            and semantic.types[bindingProjectionOwnerTypeId!].first >= 0
                                                                            -> if {
                                                                                semantic.types[bindingProjectionOwnerTypeId!].first
                                                                                    => bindingProjectionOwnerTypeId!
                                                                            }
                                                                        -1 => bindingProjectionFieldTypeId!
                                                                        0 => bindingProjectionFieldIndex!
                                                                        bindingProjectionFieldIndex! < (semantic.fields -> len)
                                                                            -> while {
                                                                                semantic.fields[bindingProjectionFieldIndex!]
                                                                                    => bindingProjectionField
                                                                                bindingProjectionField.ownerType == bindingProjectionOwnerTypeId!
                                                                                    => bindingProjectionFieldOwnerMatches!
                                                                                not bindingProjectionFieldOwnerMatches!
                                                                                    and bindingProjectionField.ownerType >= 0
                                                                                    and bindingProjectionField.ownerType < (semantic.types -> len)
                                                                                    -> if {
                                                                                        semantic.types[bindingProjectionField.ownerType]
                                                                                            => bindingProjectionFieldOwnerType
                                                                                        semantic.types[bindingProjectionOwnerTypeId!]
                                                                                            => bindingProjectionReceiverType
                                                                                        bindingProjectionFieldOwnerType.kind == 1
                                                                                            and bindingProjectionReceiverType.kind == 1
                                                                                            and bindingProjectionFieldOwnerType.module == bindingProjectionReceiverType.module
                                                                                            and bindingProjectionFieldOwnerType.symbol == bindingProjectionReceiverType.symbol
                                                                                            -> if { true => bindingProjectionFieldOwnerMatches! }
                                                                                    }
                                                                                bindingProjectionFieldOwnerMatches!
                                                                                    and bindingProjectionField.status == 0
                                                                                    -> if {
                                                                                        package.ranges[bindingProjectionField.sourceModule]
                                                                                            => bindingProjectionFieldRange
                                                                                        bindingProjectionField.labelToken
                                                                                            => bindingProjectionFieldNameTokenIndex!
                                                                                        bindingProjectionFieldNameTokenIndex! < 0
                                                                                            and bindingProjectionField.fieldSymbol >= 0
                                                                                            -> if {
                                                                                                package.symbols[bindingProjectionFieldRange.symbolStart + bindingProjectionField.fieldSymbol]
                                                                                                    => bindingProjectionFieldSymbol
                                                                                                bindingProjectionFieldSymbol.nameToken
                                                                                                    => bindingProjectionFieldNameTokenIndex!
                                                                                            }
                                                                                        bindingProjectionFieldNameTokenIndex! >= 0 -> if {
                                                                                            package.tokens[bindingProjectionFieldRange.tokenStart + bindingProjectionFieldNameTokenIndex!]
                                                                                                => bindingProjectionFieldName
                                                                                            package.sources[bindingProjectionField.sourceModule]
                                                                                                -> len => bindingProjectionFieldSourceLength
                                                                                            package.sources[bindingProjectionField.sourceModule]
                                                                                                -> slice(UIntSize(0), bindingProjectionFieldSourceLength)
                                                                                                => bindingProjectionFieldSource
                                                                                            bindingProjectionToken.span.length == bindingProjectionFieldName.span.length
                                                                                                => bindingProjectionFieldNameEqual!
                                                                                            UIntSize(0) => bindingProjectionFieldNameByte!
                                                                                            bindingProjectionFieldNameEqual!
                                                                                                and bindingProjectionFieldNameByte! < bindingProjectionToken.span.length
                                                                                                -> while {
                                                                                                    (source -> byte(bindingProjectionToken.span.start + bindingProjectionFieldNameByte!)) != (bindingProjectionFieldSource -> byte(bindingProjectionFieldName.span.start + bindingProjectionFieldNameByte!))
                                                                                                        -> if {
                                                                                                            false => bindingProjectionFieldNameEqual!
                                                                                                        }
                                                                                                    bindingProjectionFieldNameByte! + 1
                                                                                                        => bindingProjectionFieldNameByte!
                                                                                                }
                                                                                            bindingProjectionFieldNameEqual! -> if {
                                                                                                bindingProjectionField.fieldType
                                                                                                    => bindingProjectionFieldTypeId!
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                bindingProjectionFieldIndex! + 1
                                                                                    => bindingProjectionFieldIndex!
                                                                            }
                                                                        bindingProjectionFieldTypeId! >= 0 -> if {
                                                                            bindingProjectionFieldTypeId!
                                                                                => bindingProjectionTypeId!
                                                                            true => bindingProjectionResolvedField!
                                                                        } else {
                                                                            false => bindingProjectionValid!
                                                                        }
                                                                    }
                                                                bindingProjectionTokenIndex! + 1
                                                                    => bindingProjectionTokenIndex!
                                                            }
                                                        bindingProjectionValid! and bindingProjectionResolvedField!
                                                            -> if {
                                                                semantic.types[bindingProjectionTypeId!]
                                                                    => bindingProjectionType
                                                                (bindingProjectionType.kind == 1
                                                                    or bindingProjectionType.kind == 7)
                                                                    and bindingProjectionType.origin != 4
                                                                    and bindingProjectionType.module >= 0
                                                                    and bindingProjectionType.symbol >= 0
                                                                    and bindingProjectionType.status == 0
                                                                    -> if {
                                                                        bindingProjectionType.module
                                                                            => receiverTypeModule!
                                                                        bindingProjectionType.symbol
                                                                            => receiverTypeSymbol!
                                                                        bindingProjectionTypeId!
                                                                            => receiverTypeId!
                                                                    }
                                                            }
                                                    }
                                                }
                                        }
                                    }
                                # An inferred binding may also take its value from an
                                # indexed place: `values[index] => candidate`. Select
                                # only a path that begins at the index expression's start,
                                # so identifiers used as subscripts cannot become the
                                # receiver owner, then descend the canonical container.
                                (receiverTypeModule! < 0 or receiverTypeSymbol! < 0)
                                    and receiverBinding.typeNode < 0
                                    and not implicitReceiverBinding!
                                    -> if {
                                        package.tokens[sourceRange.tokenStart + receiverBinding.nameToken]
                                            => indexedBindingTargetName
                                        -1 => indexedBindingRootSymbol!
                                        0 => indexedBindingDepth!
                                        UIntSize(0) => indexedBindingRootStart!
                                        0 => indexedBindingNameIndex!
                                        indexedBindingNameIndex! < sourceRange.nameCount
                                            -> while {
                                                package.names[sourceRange.nameStart + indexedBindingNameIndex!]
                                                    => indexedBindingName
                                                package.tokens[sourceRange.tokenStart + indexedBindingName.nameToken]
                                                    => indexedBindingNameToken
                                                indexedBindingName.symbol >= 0
                                                    and indexedBindingName.symbol != receiverSymbol
                                                    and indexedBindingNameToken.span.start < indexedBindingTargetName.span.start
                                                    -> if {
                                                        package.symbols[sourceRange.symbolStart + indexedBindingName.symbol]
                                                            => indexedBindingRoot
                                                        indexedBindingRoot.typeNode >= 0 -> if {
                                                            indexedBindingName.astNode => indexedBindingAncestor!
                                                            false => indexedBindingBelongs!
                                                            false => indexedBindingStartsIndex!
                                                            indexedBindingNameToken.span.start => indexedBindingCandidateStart
                                                            indexedBindingAncestor! >= 0 and not indexedBindingBelongs!
                                                                -> while {
                                                                    indexedBindingAncestor! == receiverBinding.astNode
                                                                        -> if { true => indexedBindingBelongs! } else {
                                                                            package.nodes[sourceRange.astStart + indexedBindingAncestor!]
                                                                                => indexedBindingAncestorNode
                                                                            indexedBindingAncestorNode.kind == 41
                                                                                and indexedBindingAncestorNode.start == indexedBindingCandidateStart
                                                                                -> if {
                                                                                    true => indexedBindingStartsIndex!
                                                                                }
                                                                            indexedBindingAncestorNode.parent
                                                                                => indexedBindingAncestor!
                                                                        }
                                                                }
                                                            indexedBindingBelongs!
                                                                and indexedBindingStartsIndex!
                                                                and (indexedBindingRootSymbol! < 0
                                                                or indexedBindingCandidateStart >= indexedBindingRootStart!)
                                                                -> if {
                                                                    indexedBindingName.symbol => indexedBindingRootSymbol!
                                                                    1 => indexedBindingDepth!
                                                                    indexedBindingCandidateStart => indexedBindingRootStart!
                                                                }
                                                        }
                                                    }
                                                indexedBindingNameIndex! + 1 => indexedBindingNameIndex!
                                            }
                                        indexedBindingRootSymbol! >= 0 and indexedBindingDepth! > 0
                                            -> if {
                                                package.symbols[sourceRange.symbolStart + indexedBindingRootSymbol!]
                                                    => indexedBindingRoot
                                                -1 => indexedBindingTypeId!
                                                lastSourceReferenceIndex(package, semantic.references, referenceIndex, sourceIndex, indexedBindingRoot.typeNode) => indexedBindingReferenceIndex
                                                indexedBindingReferenceIndex >= 0 -> if {
                                                    semantic.references[indexedBindingReferenceIndex].typeId => indexedBindingTypeId!
                                                }
                                                indexedBindingTypeId! >= 0 -> if {
                                                    semantic.types[indexedBindingTypeId!] => indexedBindingRootType
                                                    indexedBindingRootType.kind == 8
                                                        and indexedBindingRootType.first >= 0
                                                        -> if { indexedBindingRootType.first => indexedBindingTypeId! }
                                                    0 => indexedBindingProjection!
                                                    true => indexedBindingValid!
                                                    indexedBindingProjection! < indexedBindingDepth!
                                                        and indexedBindingValid!
                                                        -> while {
                                                            semantic.types[indexedBindingTypeId!] => indexedBindingContainer
                                                            (indexedBindingContainer.kind == 2
                                                                or indexedBindingContainer.kind == 3
                                                                or indexedBindingContainer.kind == 4
                                                                or indexedBindingContainer.kind == 12)
                                                                and indexedBindingContainer.first >= 0
                                                                -> if { indexedBindingContainer.first => indexedBindingTypeId! } else {
                                                                    false => indexedBindingValid!
                                                                }
                                                            indexedBindingProjection! + 1 => indexedBindingProjection!
                                                        }
                                                    indexedBindingValid! -> if {
                                                        semantic.types[indexedBindingTypeId!] => indexedBindingType
                                                        (indexedBindingType.kind == 1 or indexedBindingType.kind == 7)
                                                            and indexedBindingType.origin != 4
                                                            and indexedBindingType.status == 0
                                                            -> if {
                                                                indexedBindingTypeId! => receiverTypeId!
                                                                indexedBindingType.module >= 0
                                                                    and indexedBindingType.symbol >= 0
                                                                    -> if {
                                                                        indexedBindingType.module => receiverTypeModule!
                                                                        indexedBindingType.symbol => receiverTypeSymbol!
                                                                    }
                                                            }
                                                        (indexedBindingType.kind == 2
                                                            or indexedBindingType.kind == 3
                                                            or indexedBindingType.kind == 4
                                                            or indexedBindingType.kind == 5
                                                            or indexedBindingType.kind == 6
                                                            or indexedBindingType.kind == 12
                                                            or indexedBindingType.kind == 13
                                                            or indexedBindingType.kind == 14)
                                                            and indexedBindingType.status == 0
                                                            -> if { indexedBindingTypeId! => receiverTypeId! }
                                                    }
                                                }
                                            }
                                    }
                                # An inferred local binding can be initialized directly by
                                # an unqualified nominal literal: `State { ... } => state!`.
                                # Resolve the literal's declaration inside the same logical
                                # module so instance-call lookup does not depend on a written
                                # binding type or a factory call.
                                # Call-result recovery is authoritative for a binding such as
                                # `Options { ... } -> create? => resource`. The leading literal
                                # belongs to the initializer expression, but it is not the value
                                # stored in the binding after the fallible call succeeds.
                                receiverSymbol >= 0
                                    and not implicitReceiverBinding!
                                    -> if {
                                        package.symbols[sourceRange.symbolStart + receiverSymbol]
                                            => literalReceiverBinding
                                        package.nodes[sourceRange.astStart + literalReceiverBinding.astNode]
                                            => literalReceiverBindingAst
                                        literalReceiverBindingAst.start => receiverLiteralValueStart!
                                        true => receiverLiteralProjectionValid!
                                        # An indexed place borrows the collection's element.
                                        # Descend one direct array element for each index;
                                        # nested record fields are not receiver candidates.
                                        0 => literalReceiverIndex!
                                        literalReceiverIndex! < receiverIndexDepth!
                                            and receiverLiteralProjectionValid! -> while {
                                                lastArrayLiteralAt(package.nodes, sourceRange.astStart, literalAstIndex, receiverLiteralValueStart!) => literalReceiverArray
                                                literalReceiverArray >= 0 -> if { literalAstIndex.firstChild[literalReceiverArray] } else { -1 } => literalReceiverElement
                                                literalReceiverElement >= 0 -> if {
                                                    package.nodes[sourceRange.astStart + literalReceiverElement].start => receiverLiteralValueStart!
                                                } else {
                                                    false => receiverLiteralProjectionValid!
                                                }
                                                literalReceiverIndex! + 1 => literalReceiverIndex!
                                            }
                                        receiverLiteralProjectionValid! -> if {
                                            bestBindingLiteralAt(package.nodes, sourceRange.astStart, literalAstIndex, receiverLiteralValueStart!, literalReceiverBinding.astNode)
                                        } else { -1 } => receiverLiteralAst
                                        receiverLiteralAst >= 0 -> if {
                                            package.nodes[sourceRange.astStart + receiverLiteralAst]
                                                => receiverLiteral
                                            package.tokens[sourceRange.tokenStart + receiverLiteral.payloadToken]
                                                => receiverLiteralName
                                            # Only a terminal nominal literal determines the
                                            # binding type. If a flow call follows the literal,
                                            # its resolved result remains authoritative.
                                            false => receiverLiteralFeedsCall!
                                            receiverLiteral.firstToken + receiverLiteral.tokenCount
                                                => receiverLiteralFollowingToken!
                                            receiverLiteralFollowingToken! < literalReceiverBinding.nameToken
                                                and not receiverLiteralFeedsCall!
                                                -> while {
                                                    package.tokens[sourceRange.tokenStart + receiverLiteralFollowingToken!]
                                                        => receiverLiteralFollowing
                                                    receiverLiteralFollowing.kind == grammar.tokenIdArrow()
                                                        -> if {
                                                            true => receiverLiteralFeedsCall!
                                                        }
                                                    receiverLiteralFollowingToken! + 1
                                                        => receiverLiteralFollowingToken!
                                                }
                                            # A qualified literal initializer belongs to the
                                            # imported nominal module, not the binding's source
                                            # module. Select its exact resolved path before the
                                            # unqualified same-module name fallback. Otherwise an
                                            # unrelated imported global with the method's name can
                                            # make `process.Command { ... } => command` followed by
                                            # `command -> run` spuriously ambiguous.
                                            false => receiverLiteralQualified!
                                            0 => receiverBindingQualifiedIndex!
                                            not receiverLiteralFeedsCall!
                                                and receiverBindingQualifiedIndex! < (sourceQualifiedIndices! -> len)
                                                -> while {
                                                    qualifiedResults[sourceQualifiedIndices![receiverBindingQualifiedIndex!]]
                                                        => receiverBindingQualified
                                                    receiverBindingQualified.sourceModule == sourceIndex
                                                        and receiverBindingQualified.status == 0
                                                        and receiverBindingQualified.targetModule >= 0
                                                        and receiverBindingQualified.targetSymbol >= 0
                                                        -> if {
                                                            package.nodes[sourceRange.astStart + receiverBindingQualified.pathAst]
                                                                => receiverBindingQualifiedPath
                                                            identities[receiverBindingQualified.targetModule].sourceIndex
                                                                => receiverBindingQualifiedSource
                                                            package.ranges[receiverBindingQualifiedSource]
                                                                => receiverBindingQualifiedRange
                                                            receiverBindingQualified.targetSymbol < receiverBindingQualifiedRange.symbolCount
                                                                -> if {
                                                                    package.symbols[receiverBindingQualifiedRange.symbolStart + receiverBindingQualified.targetSymbol]
                                                                        => receiverBindingQualifiedSymbol
                                                                    receiverBindingQualifiedPath.start == receiverLiteral.start
                                                                        and (receiverBindingQualifiedSymbol.kind == 3
                                                                        or receiverBindingQualifiedSymbol.kind == 4)
                                                                        -> if {
                                                                            receiverBindingQualified.targetModule
                                                                                => receiverTypeModule!
                                                                            receiverBindingQualified.targetSymbol
                                                                                => receiverTypeSymbol!
                                                                            true => receiverLiteralQualified!
                                                                        }
                                                                }
                                                        }
                                                    receiverBindingQualifiedIndex! + 1
                                                        => receiverBindingQualifiedIndex!
                                                }
                                            not receiverLiteralFeedsCall!
                                                and not receiverLiteralQualified!
                                                -> if {
                                                    identities[sourceIndex] => receiverLiteralIdentity
                                                    false => receiverLiteralFound!
                                                    false => receiverLiteralAmbiguous!
                                                    0 => receiverLiteralModule!
                                                    receiverLiteralModule! < (identities -> len)
                                                        -> while {
                                                            identities[receiverLiteralModule!] => receiverLiteralCandidateIdentity
                                                            modules.sameLogicalAnalyzedSource(package.sources, identities, receiverLiteralCandidateIdentity.sourceIndex, receiverLiteralIdentity.sourceIndex, package.tokens, package.ranges)
                                                                -> if {
                                                                    receiverLiteralCandidateIdentity.sourceIndex
                                                                        => receiverLiteralSource
                                                                    package.ranges[receiverLiteralSource]
                                                                        => receiverLiteralRange
                                                                    package.sources[receiverLiteralSource] -> len
                                                                        => receiverLiteralSourceLength
                                                                    package.sources[receiverLiteralSource]
                                                                        -> slice(UIntSize(0), receiverLiteralSourceLength)
                                                                        => receiverLiteralText
                                                                    0 => receiverLiteralSymbol!
                                                                    receiverLiteralSymbol! < receiverLiteralRange.symbolCount
                                                                        -> while {
                                                                            package.symbols[receiverLiteralRange.symbolStart + receiverLiteralSymbol!]
                                                                                => receiverLiteralCandidateSymbol
                                                                            receiverLiteralCandidateSymbol.parent < 0
                                                                                and (receiverLiteralCandidateSymbol.kind == 3
                                                                                or receiverLiteralCandidateSymbol.kind == 4)
                                                                                -> if {
                                                                                    package.tokens[receiverLiteralRange.tokenStart + receiverLiteralCandidateSymbol.nameToken]
                                                                                        => receiverLiteralCandidateName
                                                                                    receiverLiteralCandidateName.span.length == receiverLiteralName.span.length
                                                                                        => receiverLiteralNameEqual!
                                                                                    UIntSize(0) => receiverLiteralByte!
                                                                                    receiverLiteralNameEqual!
                                                                                        and receiverLiteralByte! < receiverLiteralName.span.length
                                                                                        -> while {
                                                                                            (receiverLiteralText -> byte(receiverLiteralCandidateName.span.start + receiverLiteralByte!)) != (source -> byte(receiverLiteralName.span.start + receiverLiteralByte!))
                                                                                                -> if {
                                                                                                    false => receiverLiteralNameEqual!
                                                                                                }
                                                                                            receiverLiteralByte! + 1 => receiverLiteralByte!
                                                                                        }
                                                                                    receiverLiteralNameEqual! -> if {
                                                                                        receiverLiteralFound! -> if {
                                                                                            true => receiverLiteralAmbiguous!
                                                                                        } else {
                                                                                            true => receiverLiteralFound!
                                                                                            receiverLiteralModule! => receiverTypeModule!
                                                                                            receiverLiteralSymbol! => receiverTypeSymbol!
                                                                                        }
                                                                                    }
                                                                                }
                                                                            receiverLiteralSymbol! + 1 => receiverLiteralSymbol!
                                                                        }
                                                                }
                                                            receiverLiteralModule! + 1 => receiverLiteralModule!
                                                        }
                                                    receiverLiteralAmbiguous! -> if {
                                                        -1 => receiverTypeModule!
                                                        -1 => receiverTypeSymbol!
                                                    }
                                                }
                                        }
                                    }
                                # Pattern payload bindings have no written type or
                                # initializer beneath the binding AST. Recover their type
                                # from the canonical match subject and exact variant. The
                                # intrinsic Result layout stores Ok in `first` and Err in
                                # `second`, matching Typed IR's payload contract.
                                receiverSymbol >= 0
                                    and not implicitReceiverBinding!
                                    -> if {
                                        package.symbols[sourceRange.symbolStart + receiverSymbol]
                                            => patternReceiverBinding
                                        patternReceiverBinding.kind == 35
                                            and patternReceiverBinding.astNode >= 0
                                            -> if {
                                                package.nodes[sourceRange.astStart + patternReceiverBinding.astNode]
                                                    => patternReceiverAst
                                                patternReceiverBinding.astNode => patternMatchAncestor!
                                                -1 => patternMatchAst!
                                                patternMatchAncestor! >= 0 and patternMatchAst! < 0
                                                    -> while {
                                                        package.nodes[sourceRange.astStart + patternMatchAncestor!]
                                                            => patternMatchCandidate
                                                        patternMatchCandidate.kind == 58 -> if {
                                                            patternMatchAncestor! => patternMatchAst!
                                                        }
                                                        patternMatchCandidate.parent => patternMatchAncestor!
                                                    }
                                                patternMatchAst! >= 0 -> if {
                                                    patternMatchAst! => patternMatchScope!
                                                    package.nodes[sourceRange.astStart + patternMatchAst!].parent
                                                        => patternMatchContainer
                                                    patternMatchContainer >= 0 -> if {
                                                        package.nodes[sourceRange.astStart + patternMatchContainer].parent
                                                            => patternMatchScope!
                                                    }
                                                    package.nodes[sourceRange.astStart + patternMatchScope!]
                                                        => patternMatchScopeNode
                                                    -1 => patternSubjectTargetSource!
                                                    -1 => patternSubjectFunctionSymbol!
                                                    UIntSize(0) => patternSubjectEnd!
                                                    0 => patternSubjectLocalIndex!
                                                    patternSubjectLocalIndex! < (results! -> len)
                                                        -> while {
                                                            results![patternSubjectLocalIndex!] => patternSubjectLocal
                                                            patternSubjectLocal.sourceModule == sourceIndex
                                                                and patternSubjectLocal.status == 0
                                                                and patternSubjectLocal.callAst >= 0
                                                                and patternSubjectLocal.callAst < sourceRange.astCount
                                                                and patternSubjectLocal.targetSourceModule >= 0
                                                                and patternSubjectLocal.functionSymbol >= 0
                                                                -> if {
                                                                    package.nodes[sourceRange.astStart + patternSubjectLocal.callAst]
                                                                        => patternSubjectLocalCall
                                                                    patternSubjectLocal.callAst == patternMatchScope!
                                                                        or patternSubjectLocalCall.parent == patternMatchScope!
                                                                        => patternSubjectLocalBelongs!
                                                                    not patternSubjectLocalBelongs!
                                                                        and patternSubjectLocalCall.parent >= 0
                                                                        -> if {
                                                                            package.nodes[sourceRange.astStart + patternSubjectLocalCall.parent]
                                                                                => patternSubjectLocalOwner
                                                                            patternSubjectLocalOwner.kind == 10
                                                                                and patternSubjectLocalOwner.parent == patternMatchScope!
                                                                                and patternSubjectLocalOwner.start == patternSubjectLocalCall.start
                                                                                and patternSubjectLocalOwner.length == patternSubjectLocalCall.length
                                                                                -> if { true => patternSubjectLocalBelongs! }
                                                                        }
                                                                    patternSubjectLocalCall.start + patternSubjectLocalCall.length
                                                                        => patternSubjectLocalEnd
                                                                    patternSubjectLocalBelongs!
                                                                        and patternSubjectLocalEnd <= patternReceiverAst.start
                                                                        and (patternSubjectTargetSource! < 0 or patternSubjectLocalEnd >= patternSubjectEnd!)
                                                                        -> if {
                                                                            patternSubjectLocalEnd => patternSubjectEnd!
                                                                            patternSubjectLocal.targetSourceModule => patternSubjectTargetSource!
                                                                            patternSubjectLocal.functionSymbol => patternSubjectFunctionSymbol!
                                                                        }
                                                                }
                                                            patternSubjectLocalIndex! + 1 => patternSubjectLocalIndex!
                                                        }
                                                    0 => patternSubjectQualifiedIndex!
                                                    patternSubjectQualifiedIndex! < (sourceQualifiedIndices! -> len)
                                                        -> while {
                                                            qualifiedResults[sourceQualifiedIndices![patternSubjectQualifiedIndex!]]
                                                                => patternSubjectQualified
                                                            patternSubjectQualified.sourceModule == sourceIndex
                                                                and patternSubjectQualified.status == 0
                                                                and patternSubjectQualified.targetModule >= 0
                                                                and patternSubjectQualified.targetSymbol >= 0
                                                                -> if {
                                                                    patternSubjectQualified.pathAst
                                                                        => patternSubjectAncestor!
                                                                    false => patternSubjectBelongs!
                                                                    patternSubjectAncestor! >= 0
                                                                        and not patternSubjectBelongs!
                                                                        -> while {
                                                                            patternSubjectAncestor! == patternMatchScope!
                                                                                -> if {
                                                                                    true => patternSubjectBelongs!
                                                                                } else {
                                                                                    package.nodes[sourceRange.astStart + patternSubjectAncestor!].parent
                                                                                        => patternSubjectAncestor!
                                                                                }
                                                                        }
                                                                    sourceRange.astStart + patternSubjectQualified.pathAst
                                                                        => patternSubjectGlobalAst
                                                                    package.nodes[patternSubjectGlobalAst]
                                                                        => patternSubjectPath
                                                                    patternSubjectPath.start + patternSubjectPath.length
                                                                        => patternSubjectCandidateEnd
                                                                    identities[patternSubjectQualified.targetModule].sourceIndex
                                                                        => patternSubjectCandidateSource
                                                                    package.ranges[patternSubjectCandidateSource]
                                                                        => patternSubjectCandidateRange
                                                                    patternSubjectCandidateRange.symbolStart + patternSubjectQualified.targetSymbol
                                                                        => patternSubjectCandidateSymbolIndex
                                                                    package.symbols[patternSubjectCandidateSymbolIndex]
                                                                        => patternSubjectCandidateSymbol
                                                                    patternSubjectBelongs!
                                                                        and patternSubjectCandidateEnd <= patternReceiverAst.start
                                                                        and (patternSubjectCandidateSymbol.kind == 7
                                                                        or patternSubjectCandidateSymbol.kind == 31)
                                                                        and (patternSubjectTargetSource! < 0
                                                                        or patternSubjectCandidateEnd >= patternSubjectEnd!)
                                                                        -> if {
                                                                            patternSubjectCandidateEnd => patternSubjectEnd!
                                                                            patternSubjectCandidateSource
                                                                                => patternSubjectTargetSource!
                                                                            patternSubjectQualified.targetSymbol
                                                                                => patternSubjectFunctionSymbol!
                                                                        }
                                                                }
                                                            patternSubjectQualifiedIndex! + 1
                                                                => patternSubjectQualifiedIndex!
                                                        }
                                                    patternSubjectTargetSource! >= 0
                                                        and patternSubjectFunctionSymbol! >= 0
                                                        -> if {
                                                            package.ranges[patternSubjectTargetSource!]
                                                                => patternSubjectRange
                                                            patternSubjectRange.symbolStart + patternSubjectFunctionSymbol!
                                                                => patternSubjectSymbolIndex
                                                            package.symbols[patternSubjectSymbolIndex]
                                                                => patternSubjectFunction
                                                            patternSubjectFunction.typeNode
                                                                => patternSubjectResultTypeNode!
                                                            patternSubjectFunction.secondaryTypeNode >= 0
                                                                -> if {
                                                                    patternSubjectFunction.secondaryTypeNode
                                                                        => patternSubjectResultTypeNode!
                                                                }
                                                            patternSubjectFunction.blockResultTypeNode >= 0
                                                                -> if {
                                                                    patternSubjectFunction.blockResultTypeNode
                                                                        => patternSubjectResultTypeNode!
                                                                }
                                                            -1 => patternSubjectTypeId!
                                                            lastSourceReferenceIndex(package, semantic.references, referenceIndex, patternSubjectTargetSource!, patternSubjectResultTypeNode!) => patternSubjectReferenceIndex
                                                            patternSubjectReferenceIndex >= 0 -> if {
                                                                semantic.references[patternSubjectReferenceIndex].typeId => patternSubjectTypeId!
                                                            }
                                                            patternSubjectTypeId! >= 0 -> if {
                                                                semantic.types[patternSubjectTypeId!]
                                                                    => patternSubjectType
                                                                patternSubjectType.kind == 7
                                                                    and patternSubjectType.origin == 4
                                                                    and patternSubjectType.symbol == 1
                                                                    and patternReceiverAst.payloadToken >= 0
                                                                    -> if {
                                                                        sourceRange.tokenStart + patternReceiverAst.payloadToken
                                                                            => patternReceiverVariantTokenIndex
                                                                        package.tokens[patternReceiverVariantTokenIndex]
                                                                            => patternReceiverVariant
                                                                        patternSubjectType.first
                                                                            => patternReceiverTypeId!
                                                                        (source -> byte(patternReceiverVariant.span.start)) == 69
                                                                            -> if {
                                                                                patternSubjectType.second
                                                                                    => patternReceiverTypeId!
                                                                            }
                                                                        patternReceiverTypeId! >= 0 -> if {
                                                                            semantic.types[patternReceiverTypeId!]
                                                                                => patternReceiverType
                                                                            (patternReceiverType.kind == 1
                                                                                or patternReceiverType.kind == 7)
                                                                                and patternReceiverType.origin != 4
                                                                                and patternReceiverType.module >= 0
                                                                                and patternReceiverType.symbol >= 0
                                                                                and patternReceiverType.status == 0
                                                                                -> if {
                                                                                    patternReceiverType.module
                                                                                        => receiverTypeModule!
                                                                                    patternReceiverType.symbol
                                                                                        => receiverTypeSymbol!
                                                                                    patternReceiverTypeId!
                                                                                        => receiverTypeId!
                                                                                }
                                                                        }
                                                                    }
                                                            }
                                                        }
                                                }
                                            }
                                    }
                            }
                            # An unqualified struct literal is itself an exact nominal
                            # receiver. Recover its declared owner from the literal
                            # directly, rather than treating an intrinsic spelling as
                            # authoritative before receiver dispatch. The literal must
                            # be the direct child of this flow call, so a nested field
                            # initializer cannot become the receiver.
                            directLiteralAst >= 0 -> if {
                                package.nodes[sourceRange.astStart + directLiteralAst]
                                    => directLiteral
                                package.tokens[sourceRange.tokenStart + directLiteral.payloadToken]
                                    => directLiteralName
                                identities[sourceIndex] => directLiteralIdentity
                                false => directLiteralFound!
                                false => directLiteralAmbiguous!
                                0 => directLiteralModule!
                                directLiteralModule! < (identities -> len)
                                    -> while {
                                        identities[directLiteralModule!]
                                            => directLiteralCandidateIdentity
                                        modules.sameLogicalAnalyzedSource(package.sources, identities, directLiteralCandidateIdentity.sourceIndex, directLiteralIdentity.sourceIndex, package.tokens, package.ranges)
                                            -> if {
                                                directLiteralCandidateIdentity.sourceIndex
                                                    => directLiteralSource
                                                package.ranges[directLiteralSource]
                                                    => directLiteralRange
                                                package.sources[directLiteralSource] -> len
                                                    => directLiteralSourceLength
                                                package.sources[directLiteralSource]
                                                    -> slice(UIntSize(0), directLiteralSourceLength)
                                                    => directLiteralText
                                                0 => directLiteralSymbol!
                                                directLiteralSymbol! < directLiteralRange.symbolCount
                                                    -> while {
                                                        package.symbols[directLiteralRange.symbolStart + directLiteralSymbol!]
                                                            => directLiteralCandidateSymbol
                                                        directLiteralCandidateSymbol.parent < 0
                                                            and (directLiteralCandidateSymbol.kind == 3
                                                            or directLiteralCandidateSymbol.kind == 4)
                                                            -> if {
                                                                package.tokens[directLiteralRange.tokenStart + directLiteralCandidateSymbol.nameToken]
                                                                    => directLiteralCandidateName
                                                                directLiteralCandidateName.span.length == directLiteralName.span.length
                                                                    => directLiteralNameEqual!
                                                                UIntSize(0) => directLiteralByte!
                                                                directLiteralNameEqual!
                                                                    and directLiteralByte! < directLiteralName.span.length
                                                                    -> while {
                                                                        (directLiteralText -> byte(directLiteralCandidateName.span.start + directLiteralByte!)) != (source -> byte(directLiteralName.span.start + directLiteralByte!))
                                                                            -> if { false => directLiteralNameEqual! }
                                                                        directLiteralByte! + 1 => directLiteralByte!
                                                                    }
                                                                directLiteralNameEqual! -> if {
                                                                    directLiteralFound! -> if {
                                                                        true => directLiteralAmbiguous!
                                                                    } else {
                                                                        true => directLiteralFound!
                                                                        directLiteralModule! => receiverTypeModule!
                                                                        directLiteralSymbol! => receiverTypeSymbol!
                                                                    }
                                                                }
                                                            }
                                                        directLiteralSymbol! + 1 => directLiteralSymbol!
                                                    }
                                            }
                                        directLiteralModule! + 1 => directLiteralModule!
                                    }
                                directLiteralAmbiguous! -> if {
                                    -1 => receiverTypeModule!
                                    -1 => receiverTypeSymbol!
                                }
                            }
                            # A qualified struct literal is itself an exact nominal
                            # receiver: `socket.Options { ... } -> bind`. Recover
                            # that owner directly instead of mistaking identifiers
                            # inside its field initializers for the receiver. The
                            # literal must begin with this flow call, so nested
                            # qualified literals in its fields cannot take over.
                            Int(localCallNode.start % UIntSize(qualifiedLiteralIndex.heads -> len)) => qualifiedLiteralBucket
                            qualifiedLiteralIndex.heads[qualifiedLiteralBucket] => qualifiedLiteralEntry!
                            qualifiedLiteralEntry! >= 0 -> while {
                                qualifiedResults[qualifiedLiteralIndex.rows[qualifiedLiteralEntry!]] => qualifiedLiteral
                                package.nodes[sourceRange.astStart + qualifiedLiteral.pathAst] => qualifiedLiteralPath
                                qualifiedLiteralIndex.ends[qualifiedLiteralEntry!] => qualifiedLiteralCandidateEnd
                                qualifiedLiteralPath.start == localCallNode.start
                                    and qualifiedLiteralCandidateEnd <= receiverCallName.span.start
                                    and qualifiedLiteralCandidateEnd >= qualifiedLiteralEnd!
                                    -> if {
                                        qualifiedLiteralCandidateEnd => qualifiedLiteralEnd!
                                        qualifiedLiteral.targetModule => receiverTypeModule!
                                        qualifiedLiteral.targetSymbol => receiverTypeSymbol!
                                    }
                                qualifiedLiteralIndex.next[qualifiedLiteralEntry!] => qualifiedLiteralEntry!
                            }
                        }
                        receiverTypeModule! >= 0 and receiverTypeSymbol! >= 0
                            -> if {
                                0 => qualifiedLiteralTypeIndex!
                                qualifiedLiteralTypeIndex! < (semantic.types -> len)
                                    -> while {
                                        semantic.types[qualifiedLiteralTypeIndex!]
                                            => qualifiedLiteralType
                                        (qualifiedLiteralType.kind == 1
                                            or qualifiedLiteralType.kind == 7)
                                            and qualifiedLiteralType.origin != 4
                                            and qualifiedLiteralType.module == receiverTypeModule!
                                            and qualifiedLiteralType.symbol == receiverTypeSymbol!
                                            and qualifiedLiteralType.status == 0
                                            -> if {
                                                qualifiedLiteralTypeIndex!
                                                    => receiverTypeId!
                                            }
                                        qualifiedLiteralTypeIndex! + 1
                                            => qualifiedLiteralTypeIndex!
                                    }
                            }
                        # A qualified enum variant is a value of its parent enum,
                        # not a function result. Recover that exact parent before
                        # method lookup even though the receiver syntax has no
                        # call parentheses, for example `Polynomial.Ieee -> hasher`.
                        receiverTypeModule! < 0 or receiverTypeSymbol! < 0
                            -> if {
                                UIntSize(0) => qualifiedVariantEnd!
                                0 => qualifiedVariantIndex!
                                qualifiedVariantIndex! < (sourceQualifiedIndices! -> len)
                                    -> while {
                                        qualifiedResults[sourceQualifiedIndices![qualifiedVariantIndex!]]
                                            => qualifiedVariant
                                        qualifiedVariant.sourceModule == sourceIndex
                                            and qualifiedVariant.status == 0
                                            and qualifiedVariant.targetModule >= 0
                                            and qualifiedVariant.targetSymbol >= 0
                                            -> if {
                                                package.nodes[sourceRange.astStart + qualifiedVariant.pathAst]
                                                    => qualifiedVariantPath
                                                qualifiedVariant.pathAst
                                                    => qualifiedVariantAncestor!
                                                false => qualifiedVariantBelongs!
                                                qualifiedVariantAncestor! >= 0
                                                    and not qualifiedVariantBelongs!
                                                    -> while {
                                                        qualifiedVariantAncestor! == local.callAst
                                                            -> if {
                                                                true => qualifiedVariantBelongs!
                                                            } else {
                                                                package.nodes[sourceRange.astStart + qualifiedVariantAncestor!].parent
                                                                    => qualifiedVariantAncestor!
                                                            }
                                                    }
                                                identities[qualifiedVariant.targetModule].sourceIndex
                                                    => qualifiedVariantSource
                                                package.ranges[qualifiedVariantSource]
                                                    => qualifiedVariantRange
                                                package.symbols[qualifiedVariantRange.symbolStart + qualifiedVariant.targetSymbol]
                                                    => qualifiedVariantSymbol
                                                qualifiedVariantPath.start + qualifiedVariantPath.length
                                                    => qualifiedVariantCandidateEnd
                                                qualifiedVariantBelongs!
                                                    and qualifiedVariantCandidateEnd <= receiverCallName.span.start
                                                    and qualifiedVariantCandidateEnd >= qualifiedVariantEnd!
                                                    and qualifiedVariantSymbol.parent >= 0
                                                    and package.symbols[qualifiedVariantRange.symbolStart + qualifiedVariantSymbol.parent].kind == 4
                                                    -> if {
                                                        qualifiedVariantCandidateEnd => qualifiedVariantEnd!
                                                        qualifiedVariant.targetModule => receiverTypeModule!
                                                        qualifiedVariantSymbol.parent => receiverTypeSymbol!
                                                    }
                                            }
                                        qualifiedVariantIndex! + 1
                                            => qualifiedVariantIndex!
                                    }
                            }
                        # A flow receiver can also be the result of an immediate
                        # call, with no lexical binding to carry its nominal type:
                        # `net.loopback(port) -> unified`. Select the nearest
                        # successfully resolved call that ends before this method
                        # name and recover its canonical result type. This must run
                        # before open-import name fallback because multiple public
                        # impls may intentionally expose the same method name.
                        # Gate the global resolution-table scans on actual call
                        # syntax in the receiver. Most flow calls use a lexical
                        # binding and must not pay an O(all calls) fallback cost.
                        false => receiverHasImmediateCall!
                        localCallNode.firstToken => receiverCallSyntaxTokenIndex!
                        receiverCallSyntaxTokenIndex! < receiverCallNameToken!
                            -> while {
                                package.tokens[sourceRange.tokenStart + receiverCallSyntaxTokenIndex!]
                                    => receiverCallSyntaxToken
                                receiverCallSyntaxToken.kind == grammar.tokenIdLeftParen()
                                    -> if { true => receiverHasImmediateCall! }
                                receiverCallSyntaxTokenIndex! + 1
                                    => receiverCallSyntaxTokenIndex!
                            }
                        (receiverTypeModule! < 0 or receiverTypeSymbol! < 0)
                            and receiverHasImmediateCall!
                            -> if {
                                -1 => directReceiverResolution!
                                UIntSize(0) => directReceiverEnd!
                                -1 => directReceiverCallAst!
                                -1 => directReceiverTargetSource!
                                -1 => directReceiverFunctionSymbol!
                                0 => directReceiverResultIndex!
                                directReceiverResultIndex! < (results! -> len)
                                    -> while {
                                        results![directReceiverResultIndex!] => directReceiverResult
                                        directReceiverResult.sourceModule == sourceIndex
                                            and directReceiverResult.status == 0
                                            and directReceiverResult.callAst != local.callAst
                                            and directReceiverResult.targetSourceModule >= 0
                                            and directReceiverResult.functionSymbol >= 0
                                            -> if {
                                                package.nodes[sourceRange.astStart + directReceiverResult.callAst]
                                                    => directReceiverCall
                                                directReceiverResult.callAst => directReceiverAncestor!
                                                false => directReceiverBelongs!
                                                directReceiverAncestor! >= 0 and not directReceiverBelongs!
                                                    -> while {
                                                        directReceiverAncestor! == local.callAst
                                                            -> if {
                                                                true => directReceiverBelongs!
                                                            } else {
                                                                package.nodes[sourceRange.astStart + directReceiverAncestor!].parent
                                                                    => directReceiverAncestor!
                                                            }
                                                    }
                                                directReceiverCall.start + directReceiverCall.length
                                                    => directReceiverCandidateEnd
                                                directReceiverBelongs!
                                                    and not (directReceiverCall.firstToken <= receiverCallNameToken!
                                                    and receiverCallNameToken! < directReceiverCall.firstToken + directReceiverCall.tokenCount)
                                                    and directReceiverCandidateEnd <= receiverCallName.span.start
                                                    and (directReceiverResolution! < 0
                                                    or directReceiverCandidateEnd >= directReceiverEnd!)
                                                    -> if {
                                                        directReceiverResultIndex! => directReceiverResolution!
                                                        directReceiverCandidateEnd => directReceiverEnd!
                                                        directReceiverResult.callAst => directReceiverCallAst!
                                                        directReceiverResult.targetSourceModule
                                                            => directReceiverTargetSource!
                                                        directReceiverResult.functionSymbol
                                                            => directReceiverFunctionSymbol!
                                                    }
                                            }
                                        directReceiverResultIndex! + 1 => directReceiverResultIndex!
                                    }
                                # Qualified inner calls are resolved before local flow
                                # calls, but the outer flow call may be visited first.
                                # Consult that complete table when the incremental local
                                # result list does not yet contain the receiver call.
                                directReceiverTargetSource! < 0 -> if {
                                    0 => directReceiverQualifiedIndex!
                                    directReceiverQualifiedIndex! < (sourceQualifiedIndices! -> len)
                                        -> while {
                                            qualifiedResults[sourceQualifiedIndices![directReceiverQualifiedIndex!]]
                                                => directReceiverQualified
                                            directReceiverQualified.sourceModule == sourceIndex
                                                and directReceiverQualified.status == 0
                                                and directReceiverQualified.targetModule >= 0
                                                and directReceiverQualified.targetSymbol >= 0
                                                -> if {
                                                    package.nodes[sourceRange.astStart + directReceiverQualified.pathAst]
                                                        => directReceiverQualifiedPath
                                                    directReceiverQualified.pathAst
                                                        => directReceiverQualifiedAncestor!
                                                    false => directReceiverQualifiedBelongs!
                                                    directReceiverQualifiedAncestor! >= 0
                                                        and not directReceiverQualifiedBelongs!
                                                        -> while {
                                                            directReceiverQualifiedAncestor! == local.callAst
                                                                -> if {
                                                                    true => directReceiverQualifiedBelongs!
                                                                } else {
                                                                    package.nodes[sourceRange.astStart + directReceiverQualifiedAncestor!].parent
                                                                        => directReceiverQualifiedAncestor!
                                                                }
                                                        }
                                                    directReceiverQualifiedPath.start + directReceiverQualifiedPath.length
                                                        => directReceiverQualifiedEnd
                                                    identities[directReceiverQualified.targetModule].sourceIndex
                                                        => directReceiverQualifiedSource
                                                    package.ranges[directReceiverQualifiedSource]
                                                        => directReceiverQualifiedRange
                                                    directReceiverQualifiedRange.symbolStart + directReceiverQualified.targetSymbol
                                                        => directReceiverQualifiedSymbolIndex
                                                    package.symbols[directReceiverQualifiedSymbolIndex]
                                                        => directReceiverQualifiedSymbol
                                                    directReceiverQualifiedBelongs!
                                                        and directReceiverQualifiedEnd <= receiverCallName.span.start
                                                        and (directReceiverQualifiedSymbol.kind == 7
                                                        or directReceiverQualifiedSymbol.kind == 31)
                                                        and (directReceiverCallAst! < 0
                                                        or directReceiverQualifiedEnd >= directReceiverEnd!)
                                                        -> if {
                                                            directReceiverQualified.pathAst
                                                                => directReceiverCallAst!
                                                            directReceiverQualifiedEnd => directReceiverEnd!
                                                            directReceiverQualifiedSource
                                                                => directReceiverTargetSource!
                                                            directReceiverQualified.targetSymbol
                                                                => directReceiverFunctionSymbol!
                                                        }
                                                }
                                            directReceiverQualifiedIndex! + 1
                                                => directReceiverQualifiedIndex!
                                        }
                                }
                                directReceiverTargetSource! >= 0
                                    and directReceiverFunctionSymbol! >= 0
                                    -> if {
                                        package.ranges[directReceiverTargetSource!]
                                            => directReceiverRange
                                        directReceiverRange.symbolStart + directReceiverFunctionSymbol!
                                            => directReceiverSymbolIndex
                                        package.symbols[directReceiverSymbolIndex]
                                            => directReceiverFunction
                                        directReceiverFunction.typeNode
                                            => directReceiverResultTypeNode!
                                        directReceiverFunction.secondaryTypeNode >= 0
                                            -> if {
                                                directReceiverFunction.secondaryTypeNode
                                                    => directReceiverResultTypeNode!
                                            }
                                        directReceiverFunction.blockResultTypeNode >= 0
                                            -> if {
                                                directReceiverFunction.blockResultTypeNode
                                                    => directReceiverResultTypeNode!
                                            }
                                        directReceiverResultTypeNode! >= 0 -> if {
                                            -1 => directReceiverTypeId!
                                            lastSourceReferenceIndex(package, semantic.references, referenceIndex, directReceiverTargetSource!, directReceiverResultTypeNode!) => directReceiverReferenceIndex
                                            directReceiverReferenceIndex >= 0 -> if {
                                                semantic.references[directReceiverReferenceIndex].typeId => directReceiverTypeId!
                                            }
                                            false => directReceiverPropagates!
                                            directReceiverCallAst! => directReceiverPropagationAncestor!
                                            directReceiverPropagationAncestor! >= 0
                                                and directReceiverPropagationAncestor! != local.callAst
                                                and not directReceiverPropagates!
                                                -> while {
                                                    package.nodes[sourceRange.astStart + directReceiverPropagationAncestor!]
                                                        => directReceiverPropagation
                                                    directReceiverPropagation.kind == 82
                                                        -> if {
                                                            true => directReceiverPropagates!
                                                        }
                                                    package.nodes[sourceRange.astStart + directReceiverPropagationAncestor!].parent
                                                        => directReceiverPropagationAncestor!
                                                }
                                            directReceiverTypeId! >= 0 -> if {
                                                semantic.types[directReceiverTypeId!] => directReceiverResultType
                                                directReceiverPropagates!
                                                    and directReceiverResultType.kind == 7
                                                    and directReceiverResultType.origin == 4
                                                    and directReceiverResultType.symbol == 1
                                                    and directReceiverResultType.first >= 0
                                                    -> if {
                                                        directReceiverResultType.first => directReceiverTypeId!
                                                    }
                                                semantic.types[directReceiverTypeId!] => directReceiverValueType
                                                (directReceiverValueType.kind == 1
                                                    or directReceiverValueType.kind == 7)
                                                    and directReceiverValueType.origin != 4
                                                    and directReceiverValueType.status == 0
                                                    -> if {
                                                        directReceiverTypeId! => receiverTypeId!
                                                        directReceiverValueType.module >= 0
                                                            and directReceiverValueType.symbol >= 0
                                                            -> if {
                                                                directReceiverValueType.module => receiverTypeModule!
                                                                directReceiverValueType.symbol => receiverTypeSymbol!
                                                            }
                                                    }
                                                (directReceiverValueType.kind == 2
                                                    or directReceiverValueType.kind == 3
                                                    or directReceiverValueType.kind == 4
                                                    or directReceiverValueType.kind == 5
                                                    or directReceiverValueType.kind == 6
                                                    or directReceiverValueType.kind == 12
                                                    or directReceiverValueType.kind == 13
                                                    or directReceiverValueType.kind == 14)
                                                    and directReceiverValueType.status == 0
                                                    -> if {
                                                        directReceiverTypeId! => receiverTypeId!
                                                    }
                                            }
                                        }
                                    }
                            }
                        timing -> markQueryPhase(2)
                        # Receiver dispatch observes the referenced value, not the
                        # reference wrapper used by the calling ABI. Unwrap once
                        # before walking a projected field chain so `ref T` and `T`
                        # select the same inherent-method owner without a copy.
                        receiverTypeId! >= 0
                            and receiverTypeId! < (semantic.types -> len)
                            and semantic.types[receiverTypeId!].kind == 8
                            and semantic.types[receiverTypeId!].first >= 0
                            -> if {
                                semantic.types[receiverTypeId!].first => receiverTypeId!
                                semantic.types[receiverTypeId!] => receiverReferencedType
                                (receiverReferencedType.kind == 1
                                    or receiverReferencedType.kind == 7)
                                    and receiverReferencedType.origin != 4
                                    and receiverReferencedType.module >= 0
                                    and receiverReferencedType.symbol >= 0
                                    and receiverReferencedType.status == 0
                                    -> if {
                                        receiverReferencedType.module => receiverTypeModule!
                                        receiverReferencedType.symbol => receiverTypeSymbol!
                                    }
                            }
                        local.functionSymbol == -114 and receiverTypeId! >= 0
                            and receiverTypeId! < (semantic.types -> len)
                            -> if {
                                semantic.types[receiverTypeId!] => mappedReceiver
                                mappedReceiver.kind == 1 and mappedReceiver.origin == 1
                                    and mappedReceiver.symbol == 18 and mappedReceiver.status == 0
                                    -> if { true => mappedFlushReceiver! }
                            }
                        # Preserve the semantic type id as well as its nominal
                        # identity so projected receivers can follow declared field
                        # types before inherent-method lookup.
                        receiverTypeId! < 0
                            and receiverTypeModule! >= 0
                            and receiverTypeSymbol! >= 0
                            -> if {
                                0 => receiverNominalTypeSearch!
                                receiverNominalTypeSearch! < (semantic.types -> len)
                                    -> while {
                                        semantic.types[receiverNominalTypeSearch!]
                                            => receiverNominalTypeCandidate
                                        (receiverNominalTypeCandidate.kind == 1
                                            or receiverNominalTypeCandidate.kind == 7)
                                            and receiverNominalTypeCandidate.origin != 4
                                            and receiverNominalTypeCandidate.module == receiverTypeModule!
                                            and receiverNominalTypeCandidate.symbol == receiverTypeSymbol!
                                            and receiverNominalTypeCandidate.status == 0
                                            -> if {
                                                receiverNominalTypeSearch! => receiverTypeId!
                                            }
                                        receiverNominalTypeSearch! + 1
                                            => receiverNominalTypeSearch!
                                    }
                            }
                        # A bound receiver may be a field projection such as
                        # `endpoint.address`. Walk every identifier after the root
                        # binding through the nominal field table. Field labels are
                        # compared exactly; no method-name or open-import fallback
                        # participates in owner selection.
                        receiverSymbol >= 0 and receiverTypeId! >= 0
                            and not resolvedReceiverCommitted!
                            and directLiteralAst < 0
                            and qualifiedLiteralEnd! == 0
                            -> if {
                                localCallNode.firstToken => receiverProjectionTokenIndex!
                                receiverProjectionTokenIndex! < receiverCallNameToken!
                                    -> while {
                                        package.tokens[sourceRange.tokenStart + receiverProjectionTokenIndex!]
                                            => receiverProjectionToken
                                        receiverProjectionToken.kind == grammar.tokenIdIdentifier()
                                            and receiverProjectionToken.span.start > receiverStart
                                            -> if {
                                                false => receiverFieldFound!
                                                -1 => receiverFieldTypeId!
                                                0 => receiverFieldIndex!
                                                receiverFieldIndex! < (semantic.fields -> len)
                                                    -> while {
                                                        semantic.fields[receiverFieldIndex!] => receiverField
                                                        receiverField.ownerType == receiverTypeId! => receiverFieldOwnerMatches!
                                                        not receiverFieldOwnerMatches!
                                                            and receiverField.ownerType >= 0
                                                            and receiverField.ownerType < (semantic.types -> len)
                                                            -> if {
                                                                semantic.types[receiverField.ownerType] => receiverFieldOwnerType
                                                                semantic.types[receiverTypeId!] => receiverFieldReceiverType
                                                                receiverFieldOwnerType.kind == 1
                                                                    and receiverFieldReceiverType.kind == 1
                                                                    and receiverFieldOwnerType.module == receiverFieldReceiverType.module
                                                                    and receiverFieldOwnerType.symbol == receiverFieldReceiverType.symbol
                                                                    -> if { true => receiverFieldOwnerMatches! }
                                                            }
                                                        receiverFieldOwnerMatches! and receiverField.status == 0
                                                            -> if {
                                                                package.ranges[receiverField.sourceModule]
                                                                    => receiverFieldRange
                                                                receiverField.labelToken => receiverFieldNameTokenIndex!
                                                                receiverFieldNameTokenIndex! < 0
                                                                    and receiverField.fieldSymbol >= 0
                                                                    -> if {
                                                                        receiverFieldRange.symbolStart + receiverField.fieldSymbol
                                                                            => receiverFieldSymbolIndex
                                                                        package.symbols[receiverFieldSymbolIndex]
                                                                            => receiverFieldSymbol
                                                                        receiverFieldSymbol.nameToken
                                                                            => receiverFieldNameTokenIndex!
                                                                    }
                                                                receiverFieldNameTokenIndex! >= 0 -> if {
                                                                    receiverFieldRange.tokenStart + receiverFieldNameTokenIndex!
                                                                        => receiverFieldGlobalNameTokenIndex
                                                                    package.tokens[receiverFieldGlobalNameTokenIndex]
                                                                        => receiverFieldNameToken
                                                                    package.sources[receiverField.sourceModule]
                                                                        -> len => receiverFieldSourceLength
                                                                    package.sources[receiverField.sourceModule]
                                                                        -> slice(UIntSize(0), receiverFieldSourceLength)
                                                                        => receiverFieldSource
                                                                    receiverProjectionToken.span.length == receiverFieldNameToken.span.length
                                                                        => receiverFieldNameEqual!
                                                                    UIntSize(0) => receiverFieldNameByte!
                                                                    receiverFieldNameEqual!
                                                                        and receiverFieldNameByte! < receiverProjectionToken.span.length
                                                                        -> while {
                                                                            receiverProjectionToken.span.start + receiverFieldNameByte!
                                                                                => receiverProjectionByteIndex
                                                                            receiverFieldNameToken.span.start + receiverFieldNameByte!
                                                                                => receiverFieldByteIndex
                                                                            source -> byte(receiverProjectionByteIndex)
                                                                                => receiverProjectionByte
                                                                            receiverFieldSource -> byte(receiverFieldByteIndex)
                                                                                => receiverFieldByte
                                                                            receiverProjectionByte != receiverFieldByte
                                                                                -> if {
                                                                                    false => receiverFieldNameEqual!
                                                                                }
                                                                            receiverFieldNameByte! + 1
                                                                                => receiverFieldNameByte!
                                                                        }
                                                                    receiverFieldNameEqual! -> if {
                                                                        true => receiverFieldFound!
                                                                        receiverField.fieldType
                                                                            => receiverFieldTypeId!
                                                                    }
                                                                }
                                                            }
                                                        receiverFieldIndex! + 1 => receiverFieldIndex!
                                                    }
                                                receiverFieldFound! and receiverFieldTypeId! >= 0
                                                    -> if {
                                                        receiverFieldTypeId! => receiverTypeId!
                                                        semantic.types[receiverTypeId!].kind == 8
                                                            and semantic.types[receiverTypeId!].first >= 0
                                                            -> if {
                                                                semantic.types[receiverTypeId!].first
                                                                    => receiverTypeId!
                                                            }
                                                        semantic.types[receiverTypeId!] => receiverProjectedType
                                                        # The projected value replaces the root receiver owner.
                                                        # A structural field cannot retain its containing type's
                                                        # inherent method identity, even when names coincide.
                                                        -1 => receiverTypeModule!
                                                        -1 => receiverTypeSymbol!
                                                        (receiverProjectedType.kind == 1
                                                            or receiverProjectedType.kind == 7)
                                                            and receiverProjectedType.origin != 4
                                                            and receiverProjectedType.module >= 0
                                                            and receiverProjectedType.symbol >= 0
                                                            and receiverProjectedType.status == 0
                                                            -> if {
                                                                receiverProjectedType.module => receiverTypeModule!
                                                                receiverProjectedType.symbol => receiverTypeSymbol!
                                                            }
                                                    }
                                            }
                                        receiverProjectionTokenIndex! + 1
                                            => receiverProjectionTokenIndex!
                                    }
                            }
                        timing -> markQueryPhase(3)
                        receiverTypeModule! => openReceiverTypeModule!
                        receiverTypeSymbol! => openReceiverTypeSymbol!
                        receiverTypeId! >= 0 and (not readonlyProperty or not propertyHasStoredField(package, semantic, sourceIndex, exactCallNameToken!, receiverTypeId!))
                            -> if {
                                TypedMethodRequest {
                                    sourceModule: sourceIndex
                                    receiverTypeId: receiverTypeId!
                                    targetStart: qualifiedInherentBlockMethod! -> if { package.nodes[sourceRange.astStart + qualifiedResults[importedIndex].pathAst].start } else { receiverCallName.span.start }
                                    targetLength: qualifiedInherentBlockMethod! -> if { package.nodes[sourceRange.astStart + qualifiedResults[importedIndex].pathAst].length } else { receiverCallName.span.length }
                                    qualifiedTargetModule: importedIndex >= 0 -> if { qualifiedResults[importedIndex].targetModule } else { -1 }
                                    qualifiedTargetSymbol: importedIndex >= 0 -> if { qualifiedResults[importedIndex].targetSymbol } else { -1 }
                                    qualifiedTargetStatus: importedIndex >= 0 -> if { qualifiedResults[importedIndex].status } else { -1 }
                                    qualifiedTraitModule: -1
                                    qualifiedTraitSymbol: -1
                                    blockMethod: localCallNode.kind == 48
                                } => methodRequest
                                resolveTypedMethodWithDeclarations(methodRequest, package, semantic.types, semantic.references, identities, imports, resolvedImports, qualifiedResults, declarations) => methodSelection
                                readonlyProperty -> if {
                                    methodSelection.status == 2 -> if { true => propertySelections![localIndex!] }
                                    methodSelection.status >= 0 and methodSelection.targetSourceModule >= 0 and methodSelection.functionSymbol >= 0
                                        -> if {
                                            package.ranges[methodSelection.targetSourceModule] => propertyMethodRange
                                            package.symbols[propertyMethodRange.symbolStart + methodSelection.functionSymbol] => propertyMethod
                                            propertyMethod.flags % 4 == 0 -> if { true => propertySelections![localIndex!] }
                                        }
                                }
                                methodSelection.status >= 0 -> if {
                                    true => siblingFound!
                                    methodSelection.status == 2 => siblingAmbiguous!
                                    methodSelection.targetModule => resolvedTargetModule!
                                    methodSelection.targetSourceModule => resolvedTargetSource!
                                    methodSelection.functionSymbol => resolvedFunctionSymbol!
                                    0 => resolvedOrigin!
                                    methodSelection.status == 0 -> if { 0 } else {
                                        methodSelection.status == 1 -> if { 3 } else { 2 }
                                    } => resolvedStatus!
                                } else {
                                    local.functionSymbol >= 0
                                        and local.functionSymbol < sourceRange.symbolCount
                                        -> if {
                                            package.symbols[sourceRange.symbolStart + local.functionSymbol] => localDeclaration
                                            localDeclaration.kind == 31
                                                or (localDeclaration.kind == 7
                                                and localDeclaration.parent >= 0
                                                and localDeclaration.parent < sourceRange.symbolCount
                                                and package.symbols[sourceRange.symbolStart + localDeclaration.parent].kind == 6)
                                                -> if {
                                                    -1 => resolvedFunctionSymbol!
                                                    2 => resolvedStatus!
                                                    true => localFreeFallbackAllowed!
                                                }
                                        }
                                }
                            }
                    }
                timing -> markQueryPhase(4)
                # A qualified inherent block method still uses the exact
                # runtime receiver as dispatch authority. The qualifier may
                # constrain that owner, but it cannot replace it or redirect
                # the call to a same-name method on another type.
                qualifiedInherentBlockMethod! -> if {
                    qualifiedResults[importedIndex] => qualifiedBlockTarget
                    identities[qualifiedBlockTarget.targetModule].sourceIndex
                        => qualifiedBlockTargetSource
                    resolvedStatus! != 0
                        or resolvedTargetSource! != qualifiedBlockTargetSource
                        or resolvedFunctionSymbol! != qualifiedBlockTarget.targetSymbol
                        -> if {
                            true => siblingFound!
                            false => siblingAmbiguous!
                            sourceIndex => resolvedTargetModule!
                            sourceIndex => resolvedTargetSource!
                            -1 => resolvedFunctionSymbol!
                            7 => resolvedStatus!
                        }
                }
                # An unqualified name is also looked up in every directly
                # imported module. This is the Stage1 open-import behavior used
                # by `import std.sequence` followed by ordinary flow, direct,
                # or block-function calls such as `defer`, `map`, and `filter`.
                false => openImportFound!
                false => openImportAmbiguous!
                not siblingFound!
                    and localFreeFallbackAllowed!
                    and not local.intrinsicFallback
                    and (local.functionSymbol == -1 or localCallNode.kind == 10)
                    and (localCallNode.kind == 10 or localCallNode.kind == 11 or localCallNode.kind == 48 or localCallNode.kind == 77)
                    -> if {
                        0 => openImportIndex!
                        openImportIndex! < (resolvedImports -> len) -> while {
                            resolvedImports[openImportIndex!] => openImport
                            openImport.sourceModule == sourceIndex and openImport.status == 0
                                -> if {
                                    identities[openImport.targetModule]
                                        => openImportIdentity
                                    0 => openFragmentModule!
                                    openFragmentModule! < (identities -> len)
                                        -> while {
                                            identities[openFragmentModule!]
                                                => openFragmentIdentity
                                            modules.sameLogicalAnalyzedSource(package.sources, identities, openFragmentIdentity.sourceIndex, openImportIdentity.sourceIndex, package.tokens, package.ranges)
                                                -> if {
                                                    openFragmentIdentity.sourceIndex
                                                        => openTargetSource
                                                    package.ranges[openTargetSource]
                                                        => openTargetRange
                                                    package.sources[openTargetSource]
                                                        -> len => openTargetLength
                                                    package.sources[openTargetSource]
                                                        -> slice(UIntSize(0), openTargetLength)
                                                        => openTargetText
                                                    (declarations.ownerTypes -> len) == 0 -> if { openTargetRange.symbolCount } else { declarations.openFunctionCounts[openTargetSource] } => openSymbolCount
                                                    0 => openSymbolIndex!
                                                    openSymbolIndex! < openSymbolCount
                                                        -> while {
                                                            (declarations.ownerTypes -> len) == 0 -> if { openSymbolIndex! } else { declarations.openFunctionSymbols[declarations.openFunctionStarts[openTargetSource] + openSymbolIndex!] } => openCandidateSymbol
                                                            package.symbols[openTargetRange.symbolStart + openCandidateSymbol]
                                                                => openCandidate
                                                            false => openCandidateAccepted!
                                                            openCandidate.kind == 7
                                                                and (openCandidate.parent < 0
                                                                or (openCandidate.parent < openTargetRange.symbolCount
                                                                and package.symbols[openTargetRange.symbolStart + openCandidate.parent].kind != 6))
                                                                -> if { true => openCandidateAccepted! }
                                                            # Methods were selected once by resolveTypedMethod.
                                                            # Only a genuine not-found reaches this free fallback.
                                                            openCandidateAccepted!
                                                                and openCandidate.flags / 4 % 2 == 1
                                                                -> if {
                                                                    package.tokens[sourceRange.tokenStart + local.nameToken]
                                                                        => openCallName
                                                                    package.tokens[openTargetRange.tokenStart + openCandidate.nameToken]
                                                                        => openFunctionName
                                                                    openCallName.span.length == openFunctionName.span.length
                                                                        => openNameEqual!
                                                                    UIntSize(0) => openNameByte!
                                                                    openNameEqual!
                                                                        and openNameByte! < openCallName.span.length
                                                                        -> while {
                                                                            (source -> byte(openCallName.span.start + openNameByte!)) != (openTargetText -> byte(openFunctionName.span.start + openNameByte!))
                                                                                -> if {
                                                                                    false => openNameEqual!
                                                                                }
                                                                            openNameByte! + 1 => openNameByte!
                                                                        }
                                                                    openNameEqual! -> if {
                                                                        openImportFound! -> if {
                                                                            true => openImportAmbiguous!
                                                                        } else {
                                                                            true => openImportFound!
                                                                            1 => resolvedOrigin!
                                                                            openFragmentModule!
                                                                                => resolvedTargetModule!
                                                                            openTargetSource
                                                                                => resolvedTargetSource!
                                                                            openCandidateSymbol
                                                                                => resolvedFunctionSymbol!
                                                                            0 => resolvedStatus!
                                                                        }
                                                                    }
                                                                }
                                                            openSymbolIndex! + 1
                                                                => openSymbolIndex!
                                                        }
                                                }
                                            openFragmentModule! + 1
                                                => openFragmentModule!
                                        }
                                }
                            openImportIndex! + 1 => openImportIndex!
                        }
                        openImportAmbiguous! -> if {
                            sourceIndex => resolvedTargetModule!
                            sourceIndex => resolvedTargetSource!
                            -1 => resolvedFunctionSymbol!
                            2 => resolvedStatus!
                        }
                    }
                not siblingFound! and not openImportFound! -> if {
                    local.functionSymbol < -1 => runtimeCall
                    runtimeCall -> if {
                        2 => resolvedOrigin!
                        -1 => resolvedTargetSource!
                    }
                }
                local.intrinsicFallback and not siblingFound! and not mappedFlushReceiver!
                    -> if {
                        # This name collided with a declaration elsewhere, but the
                        # exact receiver owns no such method. Drop the temporary
                        # resolution after both typed passes so the intrinsic path
                        # remains authoritative.
                        6 => resolvedStatus!
                        # A known nominal receiver cannot fall back to a builtin
                        # collection operation merely because its spelling matches.
                        openReceiverTypeModule! >= 0 and openReceiverTypeSymbol! >= 0
                            -> if { 7 => resolvedStatus! }
                    }
            }
            # The final receiver arena is available before generic argument
            # diagnostics. Remove a free-function candidate when the canonical
            # File capability owns this unqualified scalar member instead.
            localCallNode.kind == 10 and importedIndex < 0
                -> if {
                    sourceRange.astStart + local.callAst => scalarFileCall
                    package.tokens[sourceRange.tokenStart + local.nameToken] => scalarFileToken
                    source -> slice(scalarFileToken.span.start, scalarFileToken.span.length) => scalarFileName
                    scalarFileName == "readAt" or scalarFileName == "readAtAsync" or scalarFileName == "writeAt" or scalarFileName == "writeAtAsync"
                        -> if {
                            compilerProvidedFileScalarReceiver(package, identities, resolvedTypes, receiverTypeByCallAst[scalarFileCall], scalarFileName == "writeAt" or scalarFileName == "writeAtAsync")
                                -> if { 6 => resolvedStatus! }
                        }
                }
            local.callAst => resolvedCallAst!
            resolvedStatus! == 0 and resolvedTargetSource! >= 0 and resolvedFunctionSymbol! >= 0
                and importedIndex >= 0 -> if {
                    package.ranges[resolvedTargetSource!] => activationRange
                    package.symbols[activationRange.symbolStart + resolvedFunctionSymbol!] => activationDeclaration
                    activationDeclaration.kind == 36 and activationDeclaration.flags / 4096 % 2 == 1
                        -> if {
                            package.nodes[sourceRange.astStart + qualifiedResults[importedIndex].pathAst] => activationPath
                            not (package.tokens -> hasExplicitQualifiedInvocation(sourceRange.tokenStart, sourceRange.tokenCount, activationPath.firstToken + activationPath.tokenCount))
                                -> if {
                                    5 => resolvedStatus!
                                    qualifiedResults[importedIndex].pathAst => resolvedCallAst!
                                }
                        }
                }
            ModuleCallResolution {
                sourceModule: sourceIndex
                callAst: resolvedCallAst!
                origin: resolvedOrigin!
                targetModule: resolvedTargetModule!
                targetSourceModule: resolvedTargetSource!
                functionSymbol: resolvedFunctionSymbol!
                status: resolvedStatus!
            } => typedResolvedCall
            typedResolutionPass! == 0 -> if {
                results! -> push(typedResolvedCall)
            } else {
                typedResolvedCall => results![typedSourceResultStart + localIndex!]
            }
            timing -> markQueryPhase(5)
            localIndex! + 1 => localIndex!
        }
        typedResolutionPass! + 1 => typedResolutionPass!
    }
    # Field/property candidates are private until the canonical selector has
    # admitted a readonly receiver method. A stored field or missing member is
    # not an unresolved function call.
    [ModuleCallResolution; ~] => published!
    0 => publishIndex!
    publishIndex! < (results! -> len) -> while {
        results![publishIndex!] => result
        not propertyCandidates![publishIndex! - typedSourceResultStart]
            or propertySelections![publishIndex! - typedSourceResultStart]
            -> if { published! -> push(result) }
        publishIndex! + 1 => publishIndex!
    }
    timing -> markQueryPhase(6)
    published!
}
