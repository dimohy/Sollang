                                            }
                                        receiverQualifiedIndex! + 1 => receiverQualifiedIndex!
                                    }

                                # A declared parameter or local already owns an exact
                                # semantic type reference. Use that authoritative edge
                                # before initializer recovery. Qualified receiver paths
                                # nested inside another call (for example
                                # `bind(local -> unified, certificate)`) are not always
                                # descendants of the flow-call AST, so the broader
                                # qualified-path scan above can legitimately miss them.
                                receiverBinding.typeNode => declaredReceiverTypeNode!
                                declaredReceiverTypeNode! < 0
                                    and receiverBinding.kind == 35
                                    and not implicitReceiverBinding!
                                    and receiverBinding.parent >= 0
                                    -> if {
                                        package.symbols[sourceRange.symbolStart + receiverBinding.parent]
                                            => declaredReceiverParentFunction
                                        declaredReceiverParentFunction.typeNode >= 0
                                            -> if {
                                                declaredReceiverParentFunction.typeNode
                                                    => declaredReceiverTypeNode!
                                            }
                                    }
                                declaredReceiverTypeNode! >= 0
                                    -> if {
                                        -1 => declaredReceiverTypeId!
                                        lastSourceReferenceIndex(package, semantic.references, referenceIndex, sourceIndex, declaredReceiverTypeNode!) => declaredReceiverReferenceIndex
                                        declaredReceiverReferenceIndex >= 0 -> if {
                                            semantic.references[declaredReceiverReferenceIndex].typeId => declaredReceiverTypeId!
                                        }
                                        declaredReceiverTypeId! >= 0 -> if {
                                            semantic.types[declaredReceiverTypeId!]
                                                => declaredReceiverType
                                            declaredReceiverTypeId! => declaredReceiverValueTypeId!
                                            declaredReceiverType.kind == 8
                                                and declaredReceiverType.first >= 0
                                                -> if {
                                                    declaredReceiverType.first
                                                        => declaredReceiverValueTypeId!
                                                }
                                            0 => declaredReceiverIndex!
                                            true => declaredReceiverProjectionValid!
                                            declaredReceiverIndex! < receiverIndexDepth!
                                                and declaredReceiverValueTypeId! >= 0
                                                -> while {
                                                    semantic.types[declaredReceiverValueTypeId!] => declaredReceiverContainer
                                                    (declaredReceiverContainer.kind == 2
                                                        or declaredReceiverContainer.kind == 3
                                                        or declaredReceiverContainer.kind == 4
                                                        or declaredReceiverContainer.kind == 12)
                                                        and declaredReceiverContainer.first >= 0
                                                        -> if {
                                                            declaredReceiverContainer.first => declaredReceiverValueTypeId!
                                                        } else {
                                                            false => declaredReceiverProjectionValid!
                                                            receiverIndexDepth! => declaredReceiverIndex!
                                                        }
                                                    declaredReceiverIndex! + 1 => declaredReceiverIndex!
                                                }
                                            declaredReceiverProjectionValid! and declaredReceiverValueTypeId! >= 0
                                                -> if {
                                                    semantic.types[declaredReceiverValueTypeId!]
                                                        => declaredReceiverValueType
                                                    (declaredReceiverValueType.kind == 1
                                                        or declaredReceiverValueType.kind == 7)
                                                        and declaredReceiverValueType.origin != 4
                                                        and declaredReceiverValueType.status == 0
                                                        -> if {
                                                            declaredReceiverValueTypeId! => receiverTypeId!
                                                            declaredReceiverValueType.module >= 0
                                                                and declaredReceiverValueType.symbol >= 0
                                                                -> if {
                                                                    declaredReceiverValueType.module => receiverTypeModule!
                                                                    declaredReceiverValueType.symbol => receiverTypeSymbol!
                                                                }
                                                        }
                                                    # Structural impl owners have canonical type ids but
                                                    # no nominal module/symbol coordinates. Preserve only
                                                    # the structural kinds accepted by the type arena;
                                                    # an unresolved carrier must keep the older recovery
                                                    # paths available instead of becoming a false owner.
                                                    (declaredReceiverValueType.kind == 2
                                                        or declaredReceiverValueType.kind == 3
                                                        or declaredReceiverValueType.kind == 4
                                                        or declaredReceiverValueType.kind == 5
                                                        or declaredReceiverValueType.kind == 6
                                                        or declaredReceiverValueType.kind == 12
                                                        or declaredReceiverValueType.kind == 13
                                                        or declaredReceiverValueType.kind == 14)
                                                        and declaredReceiverValueType.status == 0
                                                        -> if {
                                                            declaredReceiverValueTypeId! => receiverTypeId!
                                                        }
                                                }
                                        }
                                    }

                                # A binding initialized from a resolved call has no
                                # written type path beneath the binding AST. Recover
                                # the callee's canonical result type. If the binding
                                # uses `?`, select Result's success type before method
                                # lookup. This keeps instance syntax authoritative for
                                # factory and fallible-constructor results.
                                receiverBinding.typeNode < 0
                                    and not implicitReceiverBinding!
                                    -> if {
                                        -1 => receiverInitializerResolution!
                                        1000000 => receiverInitializerDistance!
                                        receiverBinding.astNode >= 0 and receiverBinding.astNode < (receiverRecovery.first -> len)
                                            -> if { receiverRecovery.first[receiverBinding.astNode] } else { -1 } => receiverResultEdge!
                                        receiverResultEdge! >= 0 -> while {
                                            receiverRecovery.rows[receiverResultEdge!] => receiverResultIndex
                                            receiverResultIndex < (results! -> len) -> if {
                                                results![receiverResultIndex] => receiverResult
                                                receiverResult.sourceModule == sourceIndex
                                                    and receiverResult.status == 0
                                                    and receiverResult.targetSourceModule >= 0
                                                    and receiverResult.functionSymbol >= 0
                                                    -> if {
                                                        receiverResult.callAst => receiverResultAncestor!
                                                        0 => receiverResultDistance!
                                                        false => receiverResultBelongs!
                                                        receiverResultAncestor! >= 0
                                                            and not receiverResultBelongs!
                                                            -> while {
                                                                receiverResultAncestor! == receiverBinding.astNode
                                                                    -> if {
                                                                        true => receiverResultBelongs!
                                                                    } else {
                                                                        package.nodes[sourceRange.astStart + receiverResultAncestor!].parent
                                                                            => receiverResultAncestor!
                                                                        receiverResultDistance! + 1
                                                                            => receiverResultDistance!
                                                                    }
                                                            }
                                                        receiverResultBelongs!
                                                            and receiverResultDistance! < receiverInitializerDistance!
                                                            -> if {
                                                                receiverResultIndex => receiverInitializerResolution!
                                                                receiverResultDistance! => receiverInitializerDistance!
                                                            }
                                                    }
                                            }
                                            receiverRecovery.next[receiverResultEdge!] => receiverResultEdge!
                                        }
                                        receiverInitializerResolution! >= 0 -> if {
                                            results![receiverInitializerResolution!] => receiverInitializer
                                            package.ranges[receiverInitializer.targetSourceModule]
                                                => receiverInitializerRange
                                            receiverInitializerRange.symbolStart + receiverInitializer.functionSymbol => receiverInitializerSymbolIndex
                                            package.symbols[receiverInitializerSymbolIndex]
                                                => receiverInitializerFunction
                                            receiverInitializerFunction.typeNode
                                                => receiverInitializerResultTypeNode!
                                            receiverInitializerFunction.secondaryTypeNode >= 0
                                                -> if {
                                                    receiverInitializerFunction.secondaryTypeNode
                                                        => receiverInitializerResultTypeNode!
                                                }
                                            receiverInitializerFunction.blockResultTypeNode >= 0
                                                -> if {
                                                    receiverInitializerFunction.blockResultTypeNode
                                                        => receiverInitializerResultTypeNode!
                                                }
                                            receiverInitializerResultTypeNode! >= 0
                                                -> if {
                                                    -1 => receiverResultTypeId!
                                                    lastSourceReferenceIndex(package, semantic.references, referenceIndex, receiverInitializer.targetSourceModule, receiverInitializerResultTypeNode!) => receiverReferenceIndex
                                                    receiverReferenceIndex >= 0 -> if {
                                                        semantic.references[receiverReferenceIndex].typeId => receiverResultTypeId!
                                                    }
                                                    receiverBinding.astNode >= 0
                                                        and receiverBinding.astNode < (receiverRecovery.propagates -> len)
                                                        and receiverRecovery.propagates[receiverBinding.astNode]
                                                        => receiverBindingPropagates
                                                    receiverResultTypeId! >= 0 -> if {
                                                        semantic.types[receiverResultTypeId!] => receiverResultType
                                                        receiverBindingPropagates
                                                            and receiverResultType.kind == 7
                                                            and receiverResultType.origin == 4
                                                            and receiverResultType.symbol == 1
                                                            and receiverResultType.first >= 0
                                                            -> if {
                                                                receiverResultType.first => receiverResultTypeId!
                                                            }
                                                        semantic.types[receiverResultTypeId!] => receiverValueType
                                                        (receiverValueType.kind == 1
                                                            or receiverValueType.kind == 7)
                                                            and receiverValueType.origin != 4
                                                            and receiverValueType.status == 0
                                                            -> if {
                                                                receiverResultTypeId! => receiverTypeId!
                                                                receiverValueType.module >= 0
                                                                    and receiverValueType.symbol >= 0
                                                                    -> if {
                                                                        receiverValueType.module => receiverTypeModule!
                                                                        receiverValueType.symbol => receiverTypeSymbol!
                                                                    }
                                                            }
                                                        (receiverValueType.kind == 2
                                                            or receiverValueType.kind == 3
                                                            or receiverValueType.kind == 4
                                                            or receiverValueType.kind == 5
                                                            or receiverValueType.kind == 6
                                                            or receiverValueType.kind == 12
                                                            or receiverValueType.kind == 13
                                                            or receiverValueType.kind == 14)
                                                            and receiverValueType.status == 0
