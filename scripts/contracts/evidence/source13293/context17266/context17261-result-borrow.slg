struct Plan { slots: [Int; ~] }
enum Error { Invalid }
struct Context { placement: Result<Plan, Error> }

make value: Int -> [Int; ~] { [value, value + 1; ~] }

count context: ref Context -> Int {
    context.placement -> when {
        Ok(plan) { plan.slots -> len }
        Err(_) { -1 }
    }
}

main {
    1 -> make => slots
    Plan { slots: slots } -> Result<Plan, Error>.Ok => placement
    Context { placement: placement } => context
    context -> count -> println
    context -> count -> println
}
