namespace c394.unicode_identifier
public scalarWidth source: Text, index: UIntSize -> UIntSize {
    index >= (source -> len) -> if { 0 -> return }
    source -> byte(index) => first
    first < 128 -> if { 1 -> return }
    first >= 194 and first <= 223 and index + 1 < (source -> len)
        -> if {
            source -> byte(index + 1) => second
            second >= 128 and second <= 191 -> if { 2 -> return }
        }
    first >= 224 and first <= 239 and index + 2 < (source -> len)
        -> if {
            source -> byte(index + 1) => second
            source -> byte(index + 2) => third
            second >= 128 and second <= 191 and third >= 128 and third <= 191
                and (first != 224 or second >= 160)
                and (first != 237 or second < 160)
                -> if { 3 -> return }
        }
    first >= 240 and first <= 244 and index + 3 < (source -> len)
        -> if {
            source -> byte(index + 1) => second
            source -> byte(index + 2) => third
            source -> byte(index + 3) => fourth
            second >= 128 and second <= 191 and third >= 128 and third <= 191
                and fourth >= 128 and fourth <= 191
                and (first != 240 or second >= 144)
                and (first != 244 or second <= 143)
                -> if { 4 -> return }
        }
    0
}
