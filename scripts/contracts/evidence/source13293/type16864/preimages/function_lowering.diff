+# Type parameters can be used only in the body, or deliberately unused. The
+# declaration remains a template even when its entire signature is concrete.
+public functionDeclaresGenericParameters function: TypedIrNode, ranges: ref [analysis.SourceAnalysisRange; ~], declarations: ref [symbols.Symbol; ~] -> Bool {
+    function.kind != 0 or function.sourceModule < 0 or function.sourceModule >= (ranges -> len)
+        or function.symbol < 0 -> if { false -> return }
+    ranges[function.sourceModule] => range
+    function.symbol >= range.symbolCount -> if { false -> return }
+    0 => index!
+    index! < range.symbolCount -> while {
+        declarations[range.symbolStart + index!] => candidate
+        candidate.kind == 32 and candidate.parent == function.symbol
+            -> if { true -> return }
+        index! + 1 => index!
+    }
+    false
 }
 
