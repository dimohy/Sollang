status=0
main {
    true -> if {
        """
        raw
        """ -> println
    }
    true -> if {
        """first
  second
third""" -> println
    }
    true -> if {
        value == 1 and value < 2 and value >= 0 and value != 3
            -> if {
                "long" -> println
            }
    }
    1 => aaaaaaaaaaaaaaaaaaaa
    1 => bbbbbbbbbbbbbbbbbbbb
    aaaaaaaaaaaaaaaaaaaa == bbbbbbbbbbbbbbbbbbbb -> if {
        "short" -> println
    }
    ready
        and active
        -> unless {
            "multiline" -> println
        }
}
