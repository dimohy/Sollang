                            postfixChildCount! + 1 => postfixChildCount!
                        }
                    postfixChildScan! + 1 => postfixChildScan!
                }
                -1 => postfixValue!
                true => postfixChainValid!
                0 => postfixChildIndex!
                postfixChildIndex! < (nodes! -> len)
                    and (postfixParent!.kind == 5 or postfixChildCount! >= 2)
                    -> while {
                        nodes![postfixChildIndex!].parent == postfixParentIndex!
                            and not (postfixParent!.kind == 7 and postfixChildIndex! == lastPostfixChild!)
                            -> if {
                                postfixValue! < 0 -> if {
                                    postfixChildIndex! => postfixValue!
                                } else {
                                    wiredNodes![postfixChildIndex!] => postfixSuffix!
                                    postfixSuffix!.kind == 5 and postfixSuffix!.operand0 < 0
                                        -> if {
                                            postfixValue! => postfixSuffix!.operand0
                                            postfixSuffix! => wiredNodes![postfixChildIndex!]
                                            postfixChildIndex! => postfixValue!
                                        } else {
                                            postfixSuffix!.kind == 7 and postfixSuffix!.operand0 >= 0 and postfixSuffix!.operand1 < 0
                                                -> if {
                                                    postfixSuffix!.operand0 => postfixSubscript
                                                    postfixValue! => postfixSuffix!.operand0
                                                    postfixSubscript => postfixSuffix!.operand1
                                                    postfixSuffix! => wiredNodes![postfixChildIndex!]
                                                    postfixChildIndex! => postfixValue!
                                                } else {
                                                    false => postfixChainValid!
                                                }
                                        }
                                }
                            }
                        postfixChildIndex! + 1 => postfixChildIndex!
                    }
                postfixChainValid! and postfixValue! >= 0 -> if {
                    postfixValue! => postfixParent!.operand0
                    postfixParent!.kind == 7 -> if {
                        lastPostfixChild! => postfixParent!.operand1
                    } else { -1 => postfixParent!.operand1 }
                    -1 => postfixParent!.operand2
                    postfixParent! => wiredNodes![postfixParentIndex!]
                }
            }
        postfixParentIndex! + 1 => postfixParentIndex!
    }

    # The parser also keeps repeated call suffixes as siblings of the outer
    # call. Their spans all start at the same base and grow with each postfix
    # step. Rebuild the shortest call first, then feed that result into the
    # next call while assigning only the arguments introduced by its span.
    # A nested call used as an ordinary argument starts later, so it must not
    # be folded into this receiver chain.
    0 => callParentIndex!
    callParentIndex! < (wiredNodes! -> len) -> while {
        wiredNodes![callParentIndex!] => callParent!
        # An intrinsic can terminate the same receiver chain, for example
        # owner.values -> copy -> len. Its receiver call still owns its input.
        callParent!.kind == 6 or callParent!.kind == 8 or callParent!.kind == 9 or callParent!.kind == 10
            -> if {
                -1 => callNestedCandidate!
                # A suffix can follow more than three direct children. Inspect
                # the full parent relation before fixed-width operands discard it.
                0 => callChildIndex!
                callChildIndex! < (wiredNodes! -> len) -> while {
                    wiredNodes![callChildIndex!] => callChild
                    callChild.parent == callParentIndex!
                        and (callChild.kind == 8 or callChild.kind == 9 or callChild.kind == 10)
                        and callChild.payloadStart == callParent!.payloadStart
                        and callChild.payloadLength < callParent!.payloadLength
                        and callChild.operand0 < 0 and callChild.operand1 < 0 and callChild.operand2 < 0
                        -> if { callChildIndex! => callNestedCandidate! }
                    callChildIndex! + 1 => callChildIndex!
                }
                callNestedCandidate! >= 0 -> if {
                    [Int; ~] => callShells!
                    [Int; ~] => callValues!
                    [Bool; ~] => callConsumed!
                    0 => callSeedIndex!
                    callSeedIndex! < (wiredNodes! -> len) -> while {
                        callConsumed! -> push(false)
                        nodes![callSeedIndex!] => callSeed
                        callSeed.parent == callParentIndex! -> if {
                            # Only an operand-free suffix is a shell to rebuild.
                            # A nested call with its own arguments is an input
                            # value, so its existing child edges must survive.
                            (callSeed.kind == 8 or callSeed.kind == 9 or callSeed.kind == 10)
                                and callSeed.payloadStart == callParent!.payloadStart
                                and callSeed.payloadLength < callParent!.payloadLength
                                and wiredNodes![callSeedIndex!].operand0 < 0
                                and wiredNodes![callSeedIndex!].operand1 < 0
                                and wiredNodes![callSeedIndex!].operand2 < 0
                                -> if { callShells! -> push(callSeedIndex!) } else {
                                    callValues! -> push(callSeedIndex!)
                                }
                        }
                        callSeedIndex! + 1 => callSeedIndex!
                    }
                    -1 => callPrevious!
                    0 => callShellOrdinal!
                    callShellOrdinal! < (callShells! -> len) -> while {
                        -1 => callNextShell!
                        UIntSize(0) => callNextLength!
                        0 => callShellSearch!
                        callShellSearch! < (callShells! -> len) -> while {
                            callShells![callShellSearch!] => callShellCandidateIndex
                            not callConsumed![callShellCandidateIndex] -> if {
                                wiredNodes![callShellCandidateIndex] => callShellCandidate
                                callNextShell! < 0 or callShellCandidate.payloadLength < callNextLength!
                                    -> if {
                                        callShellCandidateIndex => callNextShell!
                                        callShellCandidate.payloadLength => callNextLength!
                                    }
                            }
                            callShellSearch! + 1 => callShellSearch!
                        }
                        callNextShell! >= 0 -> if {
                            wiredNodes![callNextShell!] => callShell!
                            -1 => callShell!.operand0
                            -1 => callShell!.operand1
                            -1 => callShell!.operand2
                            0 => callOperandOrdinal!
                            callPrevious! >= 0 -> if {
                                callPrevious! => callShell!.operand0
                                wiredNodes![callPrevious!] => previousCall!
                                callNextShell! => previousCall!.parent
                                previousCall! => wiredNodes![callPrevious!]
                                1 => callOperandOrdinal!
                            }
                            true => callArgumentProgress!
                            callArgumentProgress! and callOperandOrdinal! < 3
                                -> while {
                                    false => callArgumentProgress!
                                    -1 => callNextArgument!
                                    UIntSize(0) => callNextArgumentStart!
                                    0 => callArgumentSearch!
                                    callArgumentSearch! < (callValues! -> len) -> while {
                                        callValues![callArgumentSearch!] => callArgumentCandidateIndex
                                        nodes![callArgumentCandidateIndex] => callArgumentCandidate
                                        not callConsumed![callArgumentCandidateIndex]
                                            and callArgumentCandidate.payloadStart + callArgumentCandidate.payloadLength <= callShell!.payloadStart + callShell!.payloadLength
                                            and (callNextArgument! < 0 or callArgumentCandidate.payloadStart < callNextArgumentStart!)
                                            -> if {
                                                callArgumentCandidateIndex => callNextArgument!
                                                callArgumentCandidate.payloadStart => callNextArgumentStart!
                                            }
                                        callArgumentSearch! + 1 => callArgumentSearch!
                                    }
                                    callNextArgument! >= 0 -> if {
                                        callOperandOrdinal! == 0 -> if { callNextArgument! => callShell!.operand0 }
                                        callOperandOrdinal! == 1 -> if { callNextArgument! => callShell!.operand1 }
                                        callOperandOrdinal! == 2 -> if { callNextArgument! => callShell!.operand2 }
                                        wiredNodes![callNextArgument!] => argumentNode!
                                        callNextShell! => argumentNode!.parent
                                        argumentNode! => wiredNodes![callNextArgument!]
                                        true => callConsumed![callNextArgument!]
                                        callOperandOrdinal! + 1 => callOperandOrdinal!
                                        true => callArgumentProgress!
                                    }
                                }
                            # Retain excess arguments as children of their own
                            # call so arity checks reject them before emission.
                            0 => excessArgumentIndex!
                            excessArgumentIndex! < (callValues! -> len) -> while {
                                callValues![excessArgumentIndex!] => excessArgumentNodeIndex
                                nodes![excessArgumentNodeIndex] => excessArgument
                                not callConsumed![excessArgumentNodeIndex]
                                    and excessArgument.payloadStart + excessArgument.payloadLength <= callShell!.payloadStart + callShell!.payloadLength
                                    -> if {
                                        wiredNodes![excessArgumentNodeIndex] => excessArgumentNode!
                                        callNextShell! => excessArgumentNode!.parent
                                        excessArgumentNode! => wiredNodes![excessArgumentNodeIndex]
                                        true => callConsumed![excessArgumentNodeIndex]
                                    }
                                excessArgumentIndex! + 1 => excessArgumentIndex!
                            }
                            callShell! => wiredNodes![callNextShell!]
                            true => callConsumed![callNextShell!]
                            callNextShell! => callPrevious!
                        }
                        callShellOrdinal! + 1 => callShellOrdinal!
                    }
                    callPrevious! >= 0 -> if {
                        callPrevious! => callParent!.operand0
                        wiredNodes![callPrevious!] => finalPreviousCall!
                        callParentIndex! => finalPreviousCall!.parent
                        finalPreviousCall! => wiredNodes![callPrevious!]
                        -1 => callParent!.operand1
                        -1 => callParent!.operand2
                        1 => callParentOperandOrdinal!
                        true => callParentArgumentProgress!
                        callParentArgumentProgress! and callParentOperandOrdinal! < 3
                            -> while {
                                false => callParentArgumentProgress!
                                -1 => callParentNextArgument!
                                UIntSize(0) => callParentNextArgumentStart!
                                0 => callParentArgumentSearch!
                                callParentArgumentSearch! < (callValues! -> len)
                                    -> while {
                                        callValues![callParentArgumentSearch!] => callParentArgumentCandidateIndex
                                        nodes![callParentArgumentCandidateIndex] => callParentArgumentCandidate
                                        not callConsumed![callParentArgumentCandidateIndex]
                                            and (callParentNextArgument! < 0 or callParentArgumentCandidate.payloadStart < callParentNextArgumentStart!)
                                            -> if {
                                                callParentArgumentCandidateIndex => callParentNextArgument!
                                                callParentArgumentCandidate.payloadStart => callParentNextArgumentStart!
                                            }
                                        callParentArgumentSearch! + 1 => callParentArgumentSearch!
                                    }
                                callParentNextArgument! >= 0 -> if {
                                    callParentOperandOrdinal! == 1 -> if { callParentNextArgument! => callParent!.operand1 }
                                    callParentOperandOrdinal! == 2 -> if { callParentNextArgument! => callParent!.operand2 }
                                    true => callConsumed![callParentNextArgument!]
                                    callParentOperandOrdinal! + 1 => callParentOperandOrdinal!
                                    true => callParentArgumentProgress!
                                }
                            }
                        callParent! => wiredNodes![callParentIndex!]
                    }
                }
            }
        callParentIndex! + 1 => callParentIndex!
    }

    # A repeated infix chain is represented as flat value children plus
    # childless prefix-operator shells below the outer operator. Rebuild those
    # shells from shortest prefix to longest, then attach the remaining value
    # to the outer operator. This preserves precedence already encoded by the
    # AST while preventing a third direct child from replacing a real operand.
    0 => infixParentIndex!
    infixParentIndex! < (wiredNodes! -> len) -> while {
        wiredNodes![infixParentIndex!] => infixParent!
        infixParent!.kind == 3 -> if {
            [Int; ~] => infixValues!
            [Int; ~] => infixShells!
            0 => infixChildIndex!
            infixChildIndex! < (nodes! -> len) -> while {
                nodes![infixChildIndex!].parent == infixParentIndex!
                    -> if {
                        wiredNodes![infixChildIndex!] => infixChild
                        infixChild.kind == 3 and infixChild.operand0 < 0 and infixChild.operand1 < 0
                            -> if {
                                infixShells! -> push(infixChildIndex!)
                            } else {
                                infixValues! -> push(infixChildIndex!)
                            }
                    }
                infixChildIndex! + 1 => infixChildIndex!
            }
            (infixShells! -> len) > 0 and (infixValues! -> len) == (infixShells! -> len) + 2
                -> if {
                    [Bool; ~] => infixSelected!
                    0 => infixSelectedSeed!
                    infixSelectedSeed! < (wiredNodes! -> len) -> while {
                        infixSelected! -> push(false)
                        infixSelectedSeed! + 1 => infixSelectedSeed!
                    }
                    -1 => infixPrevious!
                    0 => infixValueOrdinal!
                    0 => infixShellOrdinal!
                    infixShellOrdinal! < (infixShells! -> len) -> while {
                        -1 => infixNextShell!
                        UIntSize(0) => infixNextLength!
                        0 => infixShellSearch!
                        infixShellSearch! < (infixShells! -> len) -> while {
                            infixShells![infixShellSearch!] => infixShellCandidateIndex
                            wiredNodes![infixShellCandidateIndex] => infixShellCandidate
                            infixShellCandidate.parent == infixParentIndex! and not infixSelected![infixShellCandidateIndex] and (infixNextShell! < 0 or infixShellCandidate.payloadLength < infixNextLength!)
                                -> if {
                                    infixShellCandidateIndex => infixNextShell!
                                    infixShellCandidate.payloadLength => infixNextLength!
                                }
                            infixShellSearch! + 1 => infixShellSearch!
                        }
                        infixNextShell! >= 0 -> if {
                            wiredNodes![infixNextShell!] => infixShell!
                            infixPrevious! >= 0 -> if {
                                infixPrevious! => infixShell!.operand0
                            } else {
                                infixValues![infixValueOrdinal!] => infixShell!.operand0
                                infixValueOrdinal! + 1 => infixValueOrdinal!
                            }
                            infixValues![infixValueOrdinal!] => infixShell!.operand1
                            infixValueOrdinal! + 1 => infixValueOrdinal!
                            -1 => infixShell!.operand2
                            infixShell! => wiredNodes![infixNextShell!]
                            true => infixSelected![infixNextShell!]
                            infixNextShell! => infixPrevious!
                        }
                        infixShellOrdinal! + 1 => infixShellOrdinal!
                    }
                    infixPrevious! => infixParent!.operand0
                    infixValues![infixValueOrdinal!] => infixParent!.operand1
                    -1 => infixParent!.operand2
                    infixParent! => wiredNodes![infixParentIndex!]
                }
        }
        infixParentIndex! + 1 => infixParentIndex!
    }
    # The source AST records a postfix Result propagation shell beside its
    # operand. Make that dependency explicit before emission order and root
    # selection consume this IR, just as ordinary Typed IR does for kind 30.
    0 => tryIndex!
    tryIndex! < (wiredNodes! -> len) -> while {
        wiredNodes![tryIndex!] => tryNode!
        tryNode!.kind == 11 and tryNode!.operand0 < 0
            -> if {
                -1 => tryOperand!
                0 => trySearch!
                trySearch! < tryIndex! -> while {
                    wiredNodes![trySearch!] => tryCandidate
                    tryCandidate.sourceToken == tryNode!.sourceToken
                        and tryCandidate.segment == tryNode!.segment
                        and tryCandidate.parent == tryNode!.parent
                        and tryCandidate.kind != 11
                        and tryCandidate.payloadStart == tryNode!.payloadStart
                        and tryCandidate.payloadLength == tryNode!.payloadLength
                        -> if { trySearch! => tryOperand! }
                    trySearch! + 1 => trySearch!
                }
                tryOperand! >= 0 -> if {
                    tryOperand! => tryNode!.operand0
                    tryNode! => wiredNodes![tryIndex!]
                    wiredNodes![tryOperand!] => tryValue!
                    tryIndex! => tryValue!.parent
                    tryValue! => wiredNodes![tryOperand!]
                }
            }
        tryIndex! + 1 => tryIndex!
    }
    0 => callCountIndex!
    callCountIndex! < (wiredNodes! -> len) -> while {
        wiredNodes![callCountIndex!] => callNode!
        callNode!.kind == 8 or callNode!.kind == 10 or callNode!.kind == 15
            -> if {
                0 => callOperandCount!
                callNode!.operand0 >= 0 -> if { callOperandCount! + 1 => callOperandCount! }
                callNode!.operand1 >= 0 -> if { callOperandCount! + 1 => callOperandCount! }
                callNode!.operand2 >= 0 -> if { callOperandCount! + 1 => callOperandCount! }
                0 => directChildCount!
                0 => directChildIndex!
                directChildIndex! < (wiredNodes! -> len) -> while {
                    wiredNodes![directChildIndex!].parent == callCountIndex!
                        -> if { directChildCount! + 1 => directChildCount! }
                    directChildIndex! + 1 => directChildIndex!
                }
                directChildCount! > 3 -> if { directChildCount! => callOperandCount! }
                callOperandCount! => callNode!.argumentCount
                callNode! => wiredNodes![callCountIndex!]
            }
        callCountIndex! + 1 => callCountIndex!
    }
    PreparedInterpolationProduct { nodes: wiredNodes!, typeNodes: typeNodes!, typeTokens: typeTokens! }
}

public lowerPrepared request: move PreparedInterpolationRequest -> [InterpolationNode; ~] {
    request -> lowerPreparedWithTypes => product
    product.nodes => nodes
    nodes
}

public lower source: Text -> [InterpolationNode; ~] {
    source -> lexer.lex => sourceTokens
    source -> ast.lower => sourceAst
    sourceAst -> symbols.collectPrepared => table
    PreparedInterpolationRequest {
        source: source
        nodes: sourceAst
        tokens: sourceTokens
        symbols: table
    } => request
    request -> lowerPrepared
}
