+traitImplementationBindingsDiffer source: Int, implementation: Int, previousSource: Int, previous: Int, context: ref emitterContext.EmitContext -> Bool {
+    context.ranges[source] => range
+    context.ranges[previousSource] => previousRange
+    0 => count!
+    0 => previousCount!
+    0 => index!
+    index! < previousRange.symbolCount -> while {
+        context.symbols[previousRange.symbolStart + index!] => binding
+        binding.kind == 30 and binding.parent == previous
+            -> if { previousCount! + 1 => previousCount! }
+        index! + 1 => index!
+    }
+    0 => index!
+    index! < range.symbolCount -> while {
+        context.symbols[range.symbolStart + index!] => binding
+        binding.kind == 30 and binding.parent == implementation
+            -> if {
+                count! + 1 => count!
+                false => same!
+                0 => search!
+                search! < previousRange.symbolCount and not same!
+                    -> while {
+                        context.symbols[previousRange.symbolStart + search!] => candidate
+                        candidate.kind == 30 and candidate.parent == previous
+                            and (source -> sourceTokensEqual(binding.nameToken, previousSource, candidate.nameToken, context))
+                            -> if {
+                                source -> signatureTypeId(binding.typeNode, context) => currentType
+                                previousSource -> signatureTypeId(candidate.typeNode, context) => previousType
+                                currentType >= 0 and currentType == previousType
+                                    -> if { true => same! }
+                            }
+                        search! + 1 => search!
+                    }
+                not same! -> if { true -> return }
+            }
+        index! + 1 => index!
+    }
+    count! != previousCount!
+}
