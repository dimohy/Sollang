# Responsibility fragment extracted from emitCore. State is passed by readonly
# reference, preserving the original direct-call and allocation behavior.
struct ArrayStorageIdentity {
    resultDomain: Int
    resultIndex: Int
    labelIndex: Int
}

writeArrayStorageIdentity identity: ArrayStorageIdentity, suffix: Text -> Unit uses Console {
    identity.resultDomain == 1 -> if {
        "%v$(identity.labelIndex)_expression$(identity.resultIndex)$suffix" -> print
    } else { "%v$(identity.resultIndex)$suffix" -> print }
}

emitArrayStackBacking identity: ArrayStorageIdentity, byteLength: Int, alignment: Int -> Unit uses Console {
    "  " -> print
    identity -> writeArrayStorageIdentity("_data")
    " = alloca [$byteLength x i8], align $alignment" -> println
}

emitArrayHeapBacking identity: ArrayStorageIdentity, byteLength: Int -> Unit uses Console {
    "  " -> print
    identity -> writeArrayStorageIdentity("_data")
    byteLength == 0 -> if { " = inttoptr i64 0 to ptr" -> println } else {
        " = call ptr @sollang_alloc(i64 $byteLength)" -> println
    }
}

writeArrayStorageElementType elementTypeId: Int, legacySymbol: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    elementTypeId >= 0 -> if { elementTypeId -> writeAggregateFieldTypeId(context, state) } else {
        legacySymbol -> llvmType(context, state) -> print
    }
}

emitArrayElementStorePrefix identity: ArrayStorageIdentity, position: Int, elementTypeId: Int, legacySymbol: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    "  " -> print
    identity -> writeArrayStorageIdentity("_ptr")
    "$position = getelementptr " -> print
    elementTypeId -> writeArrayStorageElementType(legacySymbol, context, state)
    ", ptr " -> print
    identity -> writeArrayStorageIdentity("_data")
    ", i64 $position" -> println
    "  store " -> print
    elementTypeId -> writeArrayStorageElementType(legacySymbol, context, state)
    " " -> print
}

emitArrayElementStoreSuffix identity: ArrayStorageIdentity, position: Int, alignment: Int -> Unit uses Console {
    ", ptr " -> print
    identity -> writeArrayStorageIdentity("_ptr")
    "$position, align $alignment" -> println
}

emitArrayValueElementStore identity: ArrayStorageIdentity, position: Int, elementTypeId: Int, legacySymbol: Int, valueIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    elementTypeId >= 0 and context.types[elementTypeId].kind == 12 => boundedElement
    boundedElement -> if {
        "v$(identity.resultIndex)_element$(position)_bounded" -> emitBoundedArrayValue(valueIndex, ownerIndex, elementTypeId, context, state)
    }
    identity -> emitArrayElementStorePrefix(position, elementTypeId, legacySymbol, context, state)
    boundedElement -> if { "%v$(identity.resultIndex)_element$(position)_bounded" -> print } else {
        valueIndex -> writeValue(ownerIndex, context, state)
    }
    elementTypeId >= 0 -> if {
        identity -> emitArrayElementStoreSuffix(position, elementTypeId -> arrayElementStorageAlign(context, state))
    } else {
        identity -> emitArrayElementStoreSuffix(position, legacySymbol -> legacyStorageAlign(context, state))
    }
}

emitArrayStorageCarrier identity: ArrayStorageIdentity, length: Int, capacity: Int, view: Bool -> Unit uses Console {
    "  " -> print
    identity -> writeArrayStorageIdentity("_0")
    view -> if { " = insertvalue %sollang.int_slice poison, ptr " -> print } else {
        " = insertvalue %sollang.array.i32 poison, ptr " -> print
    }
    identity -> writeArrayStorageIdentity("_data")
    ", 0" -> println
    "  " -> print
    view -> if { identity -> writeArrayStorageIdentity("") } else { identity -> writeArrayStorageIdentity("_1") }
    view -> if { " = insertvalue %sollang.int_slice " -> print } else { " = insertvalue %sollang.array.i32 " -> print }
    identity -> writeArrayStorageIdentity("_0")
    ", i64 $length, 1" -> println
    not view -> if {
        "  " -> print
        identity -> writeArrayStorageIdentity("")
        " = insertvalue %sollang.array.i32 " -> print
        identity -> writeArrayStorageIdentity("_1")
        ", i64 $capacity, 2" -> println
    }
}

struct EnumStorageRequest {
    resultDomain: Int
    resultIndex: Int
    enumTypeId: Int
    variantTag: Int
    payloadTypeId: Int
    payloadIr: Int
    payloadInterpolation: Int
    labelIndex: Int
    sourceModule: Int
    ownerIndex: Int
    beforeIndex: Int
    copyBorrowedFixed: Bool
}

# SSA spelling is emitted from numeric identity; deferred text is never stored.
writeEnumStorageIdentity request: EnumStorageRequest, suffix: Text -> Unit uses Console {
    request.resultDomain == 1 -> if {
        "%v$(request.labelIndex)_expression$(request.resultIndex)" -> print
    } else { "%v$(request.resultIndex)" -> print }
    suffix -> print
}

runtimeAggregateStorageAlignment typeId: Int, context: ref emitterContext.EmitContext -> Int {
    context.types[typeId].kind == 4 -> if { 8 -> return }
    context.typeAligns[typeId]
}

enumStoragePayloadReferenceType request: EnumStorageRequest, interpolationNodes: ref [interpolation.InterpolationNode; ~], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => referenceTypeId!
    request.payloadInterpolation >= 0 -> if {
        request.payloadInterpolation -> interpolationNodeTypeId(interpolationNodes, request.sourceModule, request.ownerIndex, request.beforeIndex, context, state) => referenceTypeId!
    } else {
        request.payloadIr >= 0 -> if { context.ir[request.payloadIr] -> effectiveTypeId(context, state) => referenceTypeId! }
    }
    referenceTypeId! >= 0 and referenceTypeId! < (context.types -> len)
        and context.types[referenceTypeId!].kind == 8
        and context.types[referenceTypeId!].first == request.payloadTypeId
        -> if { request.payloadTypeId -> return }
    -1
}

writeEnumStoragePayload request: EnumStorageRequest, interpolationNodes: ref [interpolation.InterpolationNode; ~], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    (request -> enumStoragePayloadReferenceType(interpolationNodes, context, state)) >= 0
        -> if {
            request -> writeEnumStorageIdentity("_payload_value")
            return
        }
    request.payloadTypeId >= 0 and context.types[request.payloadTypeId].kind == 12
        -> if {
            request -> writeEnumStorageIdentity("_payload_bounded")
            return
        }
    request.payloadInterpolation >= 0 -> if {
        request.labelIndex -> writeInterpolationValue(request.payloadInterpolation, interpolationNodes, request.sourceModule, request.ownerIndex, request.beforeIndex, context, state)
    } else {
        request.payloadIr -> writeValue(request.ownerIndex, context, state)
    }
}

# Both expression domains consume the same enum ABI and payload-copy policy.
emitEnumStorage request: EnumStorageRequest, interpolationNodes: ref [interpolation.InterpolationNode; ~], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    request -> enumStoragePayloadReferenceType(interpolationNodes, context, state) => payloadReferenceType
    payloadReferenceType >= 0 -> if {
        "  " -> print
        request -> writeEnumStorageIdentity("_payload_value")
        " = load " -> print
        payloadReferenceType -> writeAggregateFieldTypeId(context, state)
        ", ptr " -> print
        request.payloadInterpolation >= 0 -> if {
            request.labelIndex -> writeInterpolationValue(request.payloadInterpolation, interpolationNodes, request.sourceModule, request.ownerIndex, request.beforeIndex, context, state)
        } else {
            request.payloadIr -> writeValue(request.ownerIndex, context, state)
        }
        ", align " -> print
        payloadReferenceType -> runtimeAggregateStorageAlignment(context) -> writeDecimalLine
    }
    request.payloadTypeId >= 0 and context.types[request.payloadTypeId].kind == 12
        and payloadReferenceType < 0 -> if {
            Arena(0) => boundedPrefixStorage!
            request.resultDomain == 1 -> if {
                "v$(request.labelIndex)_expression$(request.resultIndex)_payload_bounded" -> materialize(boundedPrefixStorage!)
            } else {
                "v$(request.resultIndex)_payload_bounded" -> materialize(boundedPrefixStorage!)
            } => boundedPrefix
            request.payloadInterpolation >= 0 -> if {
                boundedPrefix -> emitInterpolationBoundedValue(request.labelIndex, request.payloadInterpolation, request.payloadTypeId, interpolationNodes, request.sourceModule, request.ownerIndex, request.beforeIndex, context, state)
            } else {
                boundedPrefix -> emitBoundedArrayValue(request.payloadIr, request.ownerIndex, request.payloadTypeId, context, state)
            }
        }
    "  " -> print
    request -> writeEnumStorageIdentity("_enum_slot")
    " = alloca " -> print
    request.enumTypeId -> writeSemanticTypeId(context, state)
    ", align 8" -> println
    "  store " -> print
    request.enumTypeId -> writeSemanticTypeId(context, state)
    " zeroinitializer, ptr " -> print
    request -> writeEnumStorageIdentity("_enum_slot")
    ", align 8" -> println
    "  " -> print
    request -> writeEnumStorageIdentity("_enum_tag")
    " = getelementptr inbounds " -> print
    request.enumTypeId -> writeSemanticTypeId(context, state)
    ", ptr " -> print
    request -> writeEnumStorageIdentity("_enum_slot")
    ", i32 0, i32 0" -> println
    "  store i32 $(request.variantTag), ptr " -> print
    request -> writeEnumStorageIdentity("_enum_tag")
    ", align 4" -> println
    request.payloadTypeId >= 0 -> if {
        request.copyBorrowedFixed and context.types[request.payloadTypeId].kind == 4
            -> if {
                "  " -> print
                request -> writeEnumStorageIdentity("_payload_data")
                " = extractvalue %sollang.int_slice " -> print
                request -> writeEnumStoragePayload(interpolationNodes, context, state)
                ", 0" -> println
                "  " -> print
                request -> writeEnumStorageIdentity("_payload_length")
                " = extractvalue %sollang.int_slice " -> print
                request -> writeEnumStoragePayload(interpolationNodes, context, state)
                ", 1" -> println
                "  " -> print
                request -> writeEnumStorageIdentity("_payload_copy_data")
                " = call ptr @sollang_alloc(i64 $(context.typeSizes[request.payloadTypeId]))" -> println
                "  call void @llvm.memcpy.p0.p0.i64(ptr " -> print
                request -> writeEnumStorageIdentity("_payload_copy_data")
                ", ptr " -> print
                request -> writeEnumStorageIdentity("_payload_data")
                ", i64 $(context.typeSizes[request.payloadTypeId]), i1 false)" -> println
                "  " -> print
                request -> writeEnumStorageIdentity("_payload_copy0")
                " = insertvalue %sollang.int_slice poison, ptr " -> print
                request -> writeEnumStorageIdentity("_payload_copy_data")
                ", 0" -> println
                "  " -> print
                request -> writeEnumStorageIdentity("_payload_copy")
                " = insertvalue %sollang.int_slice " -> print
                request -> writeEnumStorageIdentity("_payload_copy0")
                ", i64 " -> print
                request -> writeEnumStorageIdentity("_payload_length")
                ", 1" -> println
            }
        request.copyBorrowedFixed and context.types[request.payloadTypeId].kind != 4
            -> if {
                "  " -> print
                request -> writeEnumStorageIdentity("_payload_copy_source")
                " = freeze " -> print
                request.payloadTypeId -> writeSemanticTypeId(context, state)
                " " -> print
                request -> writeEnumStoragePayload(interpolationNodes, context, state)
                "" -> println
                request.resultDomain == 1 -> if {
                    "%v$(request.labelIndex)_expression$(request.resultIndex)_payload_copy" -> emitCopyableFixedStructValue("%v$(request.labelIndex)_expression$(request.resultIndex)_payload_copy_source", request.payloadTypeId, context, state)
                } else {
                    "%v$(request.resultIndex)_payload_copy" -> emitCopyableFixedStructValue("%v$(request.resultIndex)_payload_copy_source", request.payloadTypeId, context, state)
                }
            }
        context.typeSizes[request.payloadTypeId] > 0 or context.types[request.payloadTypeId].kind == 4
            -> if {
                "  " -> print
                request -> writeEnumStorageIdentity("_enum_payload")
                " = getelementptr inbounds " -> print
                request.enumTypeId -> writeSemanticTypeId(context, state)
                ", ptr " -> print
                request -> writeEnumStorageIdentity("_enum_slot")
                ", i32 0, i32 1" -> println
                "  store " -> print
                request.payloadTypeId -> writeAggregateFieldTypeId(context, state)
                " " -> print
                request.copyBorrowedFixed -> if {
                    request -> writeEnumStorageIdentity("_payload_copy")
                } else {
                    request -> writeEnumStoragePayload(interpolationNodes, context, state)
                }
                ", ptr " -> print
                request -> writeEnumStorageIdentity("_enum_payload")
                ", align " -> print
                request.payloadTypeId -> runtimeAggregateStorageAlignment(context) -> writeDecimalLine
            }
    }
    "  " -> print
    request -> writeEnumStorageIdentity("")
    " = load " -> print
    request.enumTypeId -> writeSemanticTypeId(context, state)
    ", ptr " -> print
    request -> writeEnumStorageIdentity("_enum_slot")
    ", align 8" -> println
}

emitEnumConstructor request: WhileValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[request.nodeIndex] => constructor
    -1 => payloadIndex!
    -1 => payloadTypeId!
    false => copyBorrowedFixed!
    constructor.operand0 >= 0 -> if {
        constructor.operand0 -> aggregateValueIndex(context, state) => payloadIndex!
        context.ir[payloadIndex!] -> effectiveTypeId(context, state) => payloadTypeId!
        payloadTypeId! >= 0 and context.types[payloadTypeId!].kind == 4
            and (payloadIndex! -> fixedEnumPayloadBorrows(request.ownerIndex, context, state))
            -> if { true => copyBorrowedFixed! }
    }
    EnumStorageRequest {
        resultDomain: 0, resultIndex: request.nodeIndex, enumTypeId: constructor.typeId,
        variantTag: constructor -> enumVariantTag(context), payloadTypeId: payloadTypeId!,
        payloadIr: payloadIndex!, payloadInterpolation: -1, labelIndex: -1,
        sourceModule: constructor.sourceModule, ownerIndex: request.ownerIndex,
        beforeIndex: request.nodeIndex, copyBorrowedFixed: copyBorrowedFixed!
    } -> emitEnumStorage(context.interpolations, context, state)
}
emitProcessProjectionCall request: ProcessCallRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[request.callIndex] => call
    call.operand0 -> aggregateValueIndex(context, state) => receiverIndex
    context.ir[receiverIndex] => receiver
    "  %v$(request.callIndex) = extractvalue " -> print
    receiver -> writeIrType(context, state)
    " " -> print
    receiverIndex -> writeValue(request.ownerIndex, context, state)
    call.opcode == -285 -> if { ", 1" -> println } else { ", 0" -> println }
}
emitProcessCall request: ProcessCallRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[request.callIndex] => call
    call.opcode == -309 -> if {
        call.operand0 -> aggregateValueIndex(context, state) => tokenValueIndex
        "  %v$(request.callIndex) = call i1 @sollang_kill_process(i64 " -> print
        tokenValueIndex -> writeValue(request.ownerIndex, context, state)
        ")" -> println
        return
    }
    call.opcode == -308 -> if {
        call.operand0 -> aggregateValueIndex(context, state) => tokenValueIndex
        "  %v$(request.callIndex)_process_poll_raw = call %sollang.process_poll_result @sollang_poll_process(i64 " -> print
        tokenValueIndex -> writeValue(request.ownerIndex, context, state)
        ")" -> println
        "  %v$(request.callIndex)_process_poll_code = extractvalue %sollang.process_poll_result %v$(request.callIndex)_process_poll_raw, 0" -> println
        "  %v$(request.callIndex)_process_poll_state = extractvalue %sollang.process_poll_result %v$(request.callIndex)_process_poll_raw, 1" -> println
        "  %v$(request.callIndex)_process_poll0 = insertvalue " -> print
        call -> writeIrType(context, state)
        " poison, i32 %v$(request.callIndex)_process_poll_state, 0" -> println
        "  %v$(request.callIndex) = insertvalue " -> print
        call -> writeIrType(context, state)
        " %v$(request.callIndex)_process_poll0, i32 %v$(request.callIndex)_process_poll_code, 1" -> println
        return
    }
    call.opcode == -278 -> if {
        call.operand0 -> aggregateValueIndex(context, state) => childValueIndex
        context.ir[childValueIndex] => childValue
        "  %v$(request.callIndex)_process_completion_state = extractvalue " -> print
        childValue -> writeIrType(context, state)
        " " -> print
        childValueIndex -> writeValue(request.ownerIndex, context, state)
        ", 2" -> println
        "  %v$(request.callIndex)_process_cached = icmp ne i32 %v$(request.callIndex)_process_completion_state, 0" -> println
        "  %v$(request.callIndex)_process_cached_code = extractvalue " -> print
        childValue -> writeIrType(context, state)
        " " -> print
        childValueIndex -> writeValue(request.ownerIndex, context, state)
        ", 3" -> println
        "  br i1 %v$(request.callIndex)_process_cached, label %process$(request.callIndex)_cached, label %process$(request.callIndex)_wait" -> println
        "process$(request.callIndex)_cached:" -> println
        "  %v$(request.callIndex)_process_cached_is_exit = icmp eq i32 %v$(request.callIndex)_process_completion_state, 1" -> println
        "  %v$(request.callIndex)_process_cached_error = select i1 %v$(request.callIndex)_process_cached_is_exit, i32 0, i32 3" -> println
        "  br label %process$(request.callIndex)_wait_merge" -> println
        "process$(request.callIndex)_wait:" -> println
        "  %v$(request.callIndex)_process_child = extractvalue " -> print
        childValue -> writeIrType(context, state)
        " " -> print
        childValueIndex -> writeValue(request.ownerIndex, context, state)
        ", 0" -> println
        "  %v$(request.callIndex)_process_raw = call %sollang.process_result @sollang_wait_process(i64 %v$(request.callIndex)_process_child)" -> println
        "  %v$(request.callIndex)_process_wait_value = extractvalue %sollang.process_result %v$(request.callIndex)_process_raw, 0" -> println
        "  %v$(request.callIndex)_process_wait_error = extractvalue %sollang.process_result %v$(request.callIndex)_process_raw, 1" -> println
        "  br label %process$(request.callIndex)_wait_merge" -> println
        "process$(request.callIndex)_wait_merge:" -> println
        "  %v$(request.callIndex)_process_value = phi i32 [ %v$(request.callIndex)_process_cached_code, %process$(request.callIndex)_cached ], [ %v$(request.callIndex)_process_wait_value, %process$(request.callIndex)_wait ]" -> println
        "  %v$(request.callIndex)_process_error = phi i32 [ %v$(request.callIndex)_process_cached_error, %process$(request.callIndex)_cached ], [ %v$(request.callIndex)_process_wait_error, %process$(request.callIndex)_wait ]" -> println
    } else {
        call.operand0 => commandArgumentIndex
        commandArgumentIndex -> aggregateValueIndex(context, state) => commandValueIndex
        context.ir[commandValueIndex] => commandValue
        commandValue -> effectiveTypeId(context, state) => commandType
        nominalFieldType(commandType, 0, context) => argvType
        nominalFieldType(commandType, 1, context) => workingDirectoryType
        nominalFieldType(commandType, 3, context) => environmentChangesType
        nominalFieldType(commandType, 5, context) => standardInputType
        nominalFieldType(commandType, 6, context) => standardOutputType
        nominalFieldType(commandType, 7, context) => standardErrorType
        "  %v$(request.callIndex)_process_argv = extractvalue " -> print
        commandValue -> writeIrType(context, state)
        " " -> print
        commandValueIndex -> writeValue(request.ownerIndex, context, state)
        ", 0" -> println
        "  %v$(request.callIndex)_process_records = extractvalue " -> print
        argvType -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_process_argv, 0" -> println
        "  %v$(request.callIndex)_process_count = extractvalue " -> print
        argvType -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_process_argv, 1" -> println
        "  %v$(request.callIndex)_process_working_directory = extractvalue " -> print
        commandValue -> writeIrType(context, state)
        " " -> print
        commandValueIndex -> writeValue(request.ownerIndex, context, state)
        ", 1" -> println
        "  %v$(request.callIndex)_process_working_directory_ptr = extractvalue " -> print
        workingDirectoryType -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_process_working_directory, 0" -> println
        "  %v$(request.callIndex)_process_working_directory_len = extractvalue " -> print
        workingDirectoryType -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_process_working_directory, 1" -> println
        "  %v$(request.callIndex)_process_has_working_directory = extractvalue " -> print
        commandValue -> writeIrType(context, state)
        " " -> print
        commandValueIndex -> writeValue(request.ownerIndex, context, state)
        ", 2" -> println
        "  %v$(request.callIndex)_process_environment_changes = extractvalue " -> print
        commandValue -> writeIrType(context, state)
        " " -> print
        commandValueIndex -> writeValue(request.ownerIndex, context, state)
        ", 3" -> println
        "  %v$(request.callIndex)_process_environment_change_records = extractvalue " -> print
        environmentChangesType -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_process_environment_changes, 0" -> println
        "  %v$(request.callIndex)_process_environment_change_count = extractvalue " -> print
        environmentChangesType -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_process_environment_changes, 1" -> println
        "  %v$(request.callIndex)_process_inherits_environment = extractvalue " -> print
        commandValue -> writeIrType(context, state)
        " " -> print
        commandValueIndex -> writeValue(request.ownerIndex, context, state)
        ", 4" -> println
        "  %v$(request.callIndex)_process_stdin = extractvalue " -> print
        commandValue -> writeIrType(context, state)
        " " -> print
        commandValueIndex -> writeValue(request.ownerIndex, context, state)
        ", 5" -> println
        "  %v$(request.callIndex)_process_stdin_mode = extractvalue " -> print
        standardInputType -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_process_stdin, 0" -> println
        "  %v$(request.callIndex)_process_stdin_slot = alloca " -> print
        standardInputType -> writeSemanticTypeId(context, state)
        ", align 8" -> println
        "  store " -> print
        standardInputType -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_process_stdin, ptr %v$(request.callIndex)_process_stdin_slot, align 8" -> println
        "  %v$(request.callIndex)_process_stdin_path_address = getelementptr inbounds " -> print
        standardInputType -> writeSemanticTypeId(context, state)
        ", ptr %v$(request.callIndex)_process_stdin_slot, i32 0, i32 1" -> println
        "  %v$(request.callIndex)_process_stdin_path = load %sollang.text, ptr %v$(request.callIndex)_process_stdin_path_address, align 8" -> println
        "  %v$(request.callIndex)_process_stdin_path_ptr = extractvalue %sollang.text %v$(request.callIndex)_process_stdin_path, 0" -> println
        "  %v$(request.callIndex)_process_stdin_path_len = extractvalue %sollang.text %v$(request.callIndex)_process_stdin_path, 1" -> println
        "  %v$(request.callIndex)_process_stdout = extractvalue " -> print
        commandValue -> writeIrType(context, state)
        " " -> print
        commandValueIndex -> writeValue(request.ownerIndex, context, state)
        ", 6" -> println
        "  %v$(request.callIndex)_process_stdout_mode = extractvalue " -> print
        standardOutputType -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_process_stdout, 0" -> println
        "  %v$(request.callIndex)_process_stdout_slot = alloca " -> print
        standardOutputType -> writeSemanticTypeId(context, state)
        ", align 8" -> println
        "  store " -> print
        standardOutputType -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_process_stdout, ptr %v$(request.callIndex)_process_stdout_slot, align 8" -> println
        "  %v$(request.callIndex)_process_stdout_path_address = getelementptr inbounds " -> print
        standardOutputType -> writeSemanticTypeId(context, state)
        ", ptr %v$(request.callIndex)_process_stdout_slot, i32 0, i32 1" -> println
        "  %v$(request.callIndex)_process_stdout_path = load %sollang.text, ptr %v$(request.callIndex)_process_stdout_path_address, align 8" -> println
        "  %v$(request.callIndex)_process_stdout_path_ptr = extractvalue %sollang.text %v$(request.callIndex)_process_stdout_path, 0" -> println
        "  %v$(request.callIndex)_process_stdout_path_len = extractvalue %sollang.text %v$(request.callIndex)_process_stdout_path, 1" -> println
        "  %v$(request.callIndex)_process_stderr = extractvalue " -> print
        commandValue -> writeIrType(context, state)
        " " -> print
        commandValueIndex -> writeValue(request.ownerIndex, context, state)
        ", 7" -> println
