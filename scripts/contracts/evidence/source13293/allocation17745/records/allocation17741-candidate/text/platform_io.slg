emitExitCall callIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    callIndex -> callArgumentIndex(context, state) => argumentIndex
    context.ir[argumentIndex] => argument
    context -> diagnostics.usesTextRuntime -> if { "  call void @sollang_runtime_flush_stdout()" -> println }
    context.expectedPathStyle == 1 -> if { "  call void @ExitProcess(i32 " -> print } else { "  call void @exit(i32 " -> print }
    argument.kind == 3 -> if {
        argument -> writeIntegerLiteral(context, state)
    } else { "%v$(argumentIndex)" -> print }
    ")" -> println
}

socketNominalTypeNamed module: Int, expected: Text, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => foundType!
    0 => candidateIndex!
    candidateIndex! < (context.types -> len) -> while {
        context.types[candidateIndex!] => candidate
        candidate.status == 0 and candidate.kind == 1 and candidate.module == module
            -> if {
                candidateIndex! -> nominalDeclarationAst(context, state) => declarationAst
                declarationAst >= 0 -> if {
                    context.ranges[module] => moduleRange
                    context.nodes[moduleRange.astStart + declarationAst] => declaration
                    declaration.payloadToken >= 0 -> if {
                        context.tokens[moduleRange.tokenStart + declaration.payloadToken] => declarationName
                        declarationName.span.length == (expected -> len) => equal!
                        UIntSize(0) => nameByte!
                        equal! and nameByte! < declarationName.span.length
                            -> while {
                                (context.sources[module] -> byte(declarationName.span.start + nameByte!)) != (expected -> byte(nameByte!))
                                    -> if { false => equal! }
                                nameByte! + 1 => nameByte!
                            }
                        equal! -> if { candidateIndex! => foundType! }
                    }
                }
            }
        candidateIndex! + 1 => candidateIndex!
    }
    foundType!
}

emitSocketEndpointDescriptor callIndex: Int, endpointTypeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.types[endpointTypeId].module => endpointModule
    endpointModule -> socketNominalTypeNamed("Ipv4Endpoint", context, state) => ipv4EndpointType!
    endpointModule -> socketNominalTypeNamed("Ipv6Endpoint", context, state) => ipv6EndpointType!
    endpointTypeId -> enumPayloadTypes(context, state) => payloadTypes
    ipv4EndpointType! < 0 and (payloadTypes -> len) > 0
        -> if { payloadTypes[0] => ipv4EndpointType! }
    ipv6EndpointType! < 0 and (payloadTypes -> len) > 1
        -> if { payloadTypes[1] => ipv6EndpointType! }
    nominalFieldType(ipv4EndpointType!, 0, context) => ipv4AddressType
    nominalFieldType(ipv6EndpointType!, 0, context) => ipv6AddressType

    "  %v$(callIndex)_socket_endpoint_descriptor = alloca [32 x i8], align 8" -> println
    "  call void @llvm.memset.p0.i64(ptr %v$(callIndex)_socket_endpoint_descriptor, i8 0, i64 32, i1 false)" -> println
    "  %v$(callIndex)_socket_endpoint_tag = extractvalue " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_endpoint, 0" -> println
    "  %v$(callIndex)_socket_endpoint_is_ipv4 = icmp eq i32 %v$(callIndex)_socket_endpoint_tag, 0" -> println
    "  br i1 %v$(callIndex)_socket_endpoint_is_ipv4, label %socket_endpoint$(callIndex)_ipv4, label %socket_endpoint$(callIndex)_ipv6" -> println

    "socket_endpoint$(callIndex)_ipv4:" -> println
    "  %v$(callIndex)_socket_endpoint_enum_slot4 = alloca " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", align 8" -> println
    "  store " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_endpoint, ptr %v$(callIndex)_socket_endpoint_enum_slot4, align 8" -> println
    "  %v$(callIndex)_socket_endpoint_payload_address4 = getelementptr inbounds " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(callIndex)_socket_endpoint_enum_slot4, i32 0, i32 1" -> println
    "  %v$(callIndex)_socket_endpoint_ipv4 = load " -> print
    ipv4EndpointType! -> writeSemanticTypeId(context, state)
    ", ptr %v$(callIndex)_socket_endpoint_payload_address4, align 2" -> println
    "  %v$(callIndex)_socket_endpoint_ipv4_address = extractvalue " -> print
    ipv4EndpointType! -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_endpoint_ipv4, 0" -> println
    "  %v$(callIndex)_socket_endpoint_family4 = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 0" -> println
    "  store i32 4, ptr %v$(callIndex)_socket_endpoint_family4, align 4" -> println
    0 => ipv4Ordinal!
    ipv4Ordinal! < 4 -> while {
        "  %v$(callIndex)_socket_endpoint_ipv4_octet$(ipv4Ordinal!) = extractvalue " -> print
        ipv4AddressType -> writeSemanticTypeId(context, state)
        " %v$(callIndex)_socket_endpoint_ipv4_address, $(ipv4Ordinal!)" -> println
        "  %v$(callIndex)_socket_endpoint_ipv4_word$(ipv4Ordinal!) = zext i8 %v$(callIndex)_socket_endpoint_ipv4_octet$(ipv4Ordinal!) to i16" -> println
        "  %v$(callIndex)_socket_endpoint_ipv4_target$(ipv4Ordinal!) = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 $(4 + ipv4Ordinal! * 2)" -> println
        "  store i16 %v$(callIndex)_socket_endpoint_ipv4_word$(ipv4Ordinal!), ptr %v$(callIndex)_socket_endpoint_ipv4_target$(ipv4Ordinal!), align 2" -> println
        ipv4Ordinal! + 1 => ipv4Ordinal!
    }
    "  %v$(callIndex)_socket_endpoint_port4 = extractvalue " -> print
    ipv4EndpointType! -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_endpoint_ipv4, 1" -> println
    "  %v$(callIndex)_socket_endpoint_port_target4 = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 20" -> println
    "  store i16 %v$(callIndex)_socket_endpoint_port4, ptr %v$(callIndex)_socket_endpoint_port_target4, align 2" -> println
    "  br label %socket_endpoint$(callIndex)_complete" -> println

    "socket_endpoint$(callIndex)_ipv6:" -> println
    "  %v$(callIndex)_socket_endpoint_enum_slot6 = alloca " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", align 8" -> println
    "  store " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_endpoint, ptr %v$(callIndex)_socket_endpoint_enum_slot6, align 8" -> println
    "  %v$(callIndex)_socket_endpoint_payload_address6 = getelementptr inbounds " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(callIndex)_socket_endpoint_enum_slot6, i32 0, i32 1" -> println
    "  %v$(callIndex)_socket_endpoint_ipv6 = load " -> print
    ipv6EndpointType! -> writeSemanticTypeId(context, state)
    ", ptr %v$(callIndex)_socket_endpoint_payload_address6, align 4" -> println
    "  %v$(callIndex)_socket_endpoint_ipv6_address = extractvalue " -> print
    ipv6EndpointType! -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_endpoint_ipv6, 0" -> println
    "  %v$(callIndex)_socket_endpoint_family6 = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 0" -> println
    "  store i32 6, ptr %v$(callIndex)_socket_endpoint_family6, align 4" -> println
    0 => ipv6Ordinal!
    ipv6Ordinal! < 8 -> while {
        "  %v$(callIndex)_socket_endpoint_ipv6_group$(ipv6Ordinal!) = extractvalue " -> print
        ipv6AddressType -> writeSemanticTypeId(context, state)
        " %v$(callIndex)_socket_endpoint_ipv6_address, $(ipv6Ordinal!)" -> println
        "  %v$(callIndex)_socket_endpoint_ipv6_target$(ipv6Ordinal!) = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 $(4 + ipv6Ordinal! * 2)" -> println
        "  store i16 %v$(callIndex)_socket_endpoint_ipv6_group$(ipv6Ordinal!), ptr %v$(callIndex)_socket_endpoint_ipv6_target$(ipv6Ordinal!), align 2" -> println
        ipv6Ordinal! + 1 => ipv6Ordinal!
    }
    [1, 2, 3] => ipv6FieldOrdinals
    [20, 24, 28] => ipv6FieldOffsets
    0 => ipv6FieldIndex!
    ipv6FieldIndex! < 3 -> while {
        ipv6FieldOrdinals[ipv6FieldIndex!] => fieldOrdinal
        ipv6FieldOffsets[ipv6FieldIndex!] => fieldOffset
        "  %v$(callIndex)_socket_endpoint_ipv6_field$(ipv6FieldIndex!) = extractvalue " -> print
        ipv6EndpointType! -> writeSemanticTypeId(context, state)
        " %v$(callIndex)_socket_endpoint_ipv6, $fieldOrdinal" -> println
        "  %v$(callIndex)_socket_endpoint_ipv6_field_target$(ipv6FieldIndex!) = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 $fieldOffset" -> println
        "  store " -> print
        ipv6FieldIndex! == 0 -> if { "i16" -> print } else { "i32" -> print }
        " %v$(callIndex)_socket_endpoint_ipv6_field$(ipv6FieldIndex!), ptr %v$(callIndex)_socket_endpoint_ipv6_field_target$(ipv6FieldIndex!), align " -> print
        ipv6FieldIndex! == 0 -> if { "2" -> println } else { "4" -> println }
        ipv6FieldIndex! + 1 => ipv6FieldIndex!
    }
    "  br label %socket_endpoint$(callIndex)_complete" -> println
    "socket_endpoint$(callIndex)_complete:" -> println
}

emitSocketEndpointFromDescriptor callIndex: Int, endpointTypeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.types[endpointTypeId].module => endpointModule
    endpointModule -> socketNominalTypeNamed("Ipv4Endpoint", context, state) => ipv4EndpointType!
    endpointModule -> socketNominalTypeNamed("Ipv6Endpoint", context, state) => ipv6EndpointType!
    endpointTypeId -> enumPayloadTypes(context, state) => payloadTypes
    ipv4EndpointType! < 0 and (payloadTypes -> len) > 0
        -> if { payloadTypes[0] => ipv4EndpointType! }
    ipv6EndpointType! < 0 and (payloadTypes -> len) > 1
        -> if { payloadTypes[1] => ipv6EndpointType! }
    nominalFieldType(ipv4EndpointType!, 0, context) => ipv4AddressType
    nominalFieldType(ipv6EndpointType!, 0, context) => ipv6AddressType

    "  %v$(callIndex)_socket_source_slot = alloca " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", align 8" -> println
    "  store " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    " zeroinitializer, ptr %v$(callIndex)_socket_source_slot, align 8" -> println
    "  %v$(callIndex)_socket_source_family = load i32, ptr %v$(callIndex)_socket_endpoint_descriptor, align 4" -> println
    "  %v$(callIndex)_socket_source_is_ipv4 = icmp eq i32 %v$(callIndex)_socket_source_family, 4" -> println
    "  br i1 %v$(callIndex)_socket_source_is_ipv4, label %socket_source$(callIndex)_ipv4, label %socket_source$(callIndex)_ipv6" -> println

    "socket_source$(callIndex)_ipv4:" -> println
    0 => ipv4Ordinal!
    ipv4Ordinal! < 4 -> while {
        "  %v$(callIndex)_socket_source_ipv4_word$(ipv4Ordinal!)_address = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 $(4 + ipv4Ordinal! * 2)" -> println
        "  %v$(callIndex)_socket_source_ipv4_word$(ipv4Ordinal!) = load i16, ptr %v$(callIndex)_socket_source_ipv4_word$(ipv4Ordinal!)_address, align 2" -> println
        "  %v$(callIndex)_socket_source_ipv4_octet$(ipv4Ordinal!) = trunc i16 %v$(callIndex)_socket_source_ipv4_word$(ipv4Ordinal!) to i8" -> println
        "  %v$(callIndex)_socket_source_ipv4_address$(ipv4Ordinal!) = insertvalue " -> print
        ipv4AddressType -> writeSemanticTypeId(context, state)
        " " -> print
        ipv4Ordinal! == 0 -> if { "poison" -> print } else { "%v$(callIndex)_socket_source_ipv4_address$(ipv4Ordinal! - 1)" -> print }
        ", i8 %v$(callIndex)_socket_source_ipv4_octet$(ipv4Ordinal!), $(ipv4Ordinal!)" -> println
        ipv4Ordinal! + 1 => ipv4Ordinal!
    }
    "  %v$(callIndex)_socket_source_ipv4_port_address = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 20" -> println
    "  %v$(callIndex)_socket_source_ipv4_port = load i16, ptr %v$(callIndex)_socket_source_ipv4_port_address, align 2" -> println
    "  %v$(callIndex)_socket_source_ipv4_endpoint0 = insertvalue " -> print
    ipv4EndpointType! -> writeSemanticTypeId(context, state)
    " poison, " -> print
    ipv4AddressType -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_source_ipv4_address3, 0" -> println
    "  %v$(callIndex)_socket_source_ipv4_endpoint = insertvalue " -> print
    ipv4EndpointType! -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_source_ipv4_endpoint0, i16 %v$(callIndex)_socket_source_ipv4_port, 1" -> println
    "  %v$(callIndex)_socket_source_tag4 = getelementptr inbounds " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(callIndex)_socket_source_slot, i32 0, i32 0" -> println
    "  store i32 0, ptr %v$(callIndex)_socket_source_tag4, align 4" -> println
    "  %v$(callIndex)_socket_source_payload4 = getelementptr inbounds " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(callIndex)_socket_source_slot, i32 0, i32 1" -> println
    "  store " -> print
    ipv4EndpointType! -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_source_ipv4_endpoint, ptr %v$(callIndex)_socket_source_payload4, align 2" -> println
    "  br label %socket_source$(callIndex)_complete" -> println

    "socket_source$(callIndex)_ipv6:" -> println
    0 => ipv6Ordinal!
    ipv6Ordinal! < 8 -> while {
        "  %v$(callIndex)_socket_source_ipv6_group$(ipv6Ordinal!)_address = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 $(4 + ipv6Ordinal! * 2)" -> println
        "  %v$(callIndex)_socket_source_ipv6_group$(ipv6Ordinal!) = load i16, ptr %v$(callIndex)_socket_source_ipv6_group$(ipv6Ordinal!)_address, align 2" -> println
        "  %v$(callIndex)_socket_source_ipv6_address$(ipv6Ordinal!) = insertvalue " -> print
        ipv6AddressType -> writeSemanticTypeId(context, state)
        " " -> print
        ipv6Ordinal! == 0 -> if { "poison" -> print } else { "%v$(callIndex)_socket_source_ipv6_address$(ipv6Ordinal! - 1)" -> print }
        ", i16 %v$(callIndex)_socket_source_ipv6_group$(ipv6Ordinal!), $(ipv6Ordinal!)" -> println
        ipv6Ordinal! + 1 => ipv6Ordinal!
    }
    "  %v$(callIndex)_socket_source_ipv6_endpoint0 = insertvalue " -> print
    ipv6EndpointType! -> writeSemanticTypeId(context, state)
    " poison, " -> print
    ipv6AddressType -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_source_ipv6_address7, 0" -> println
    ["port", "flow", "scope"] => ipv6Names
    [20, 24, 28] => ipv6Offsets
    0 => ipv6FieldIndex!
    ipv6FieldIndex! < 3 -> while {
        ipv6FieldIndex! == 0 -> if { "i16" } else { "i32" } => fieldIrType
        "  %v$(callIndex)_socket_source_ipv6_$(ipv6Names[ipv6FieldIndex!])_address = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 $(ipv6Offsets[ipv6FieldIndex!])" -> println
        "  %v$(callIndex)_socket_source_ipv6_$(ipv6Names[ipv6FieldIndex!]) = load $fieldIrType, ptr %v$(callIndex)_socket_source_ipv6_$(ipv6Names[ipv6FieldIndex!])_address, align " -> print
        ipv6FieldIndex! == 0 -> if { "2" -> println } else { "4" -> println }
        "  %v$(callIndex)_socket_source_ipv6_endpoint$(ipv6FieldIndex! + 1) = insertvalue " -> print
        ipv6EndpointType! -> writeSemanticTypeId(context, state)
        " %v$(callIndex)_socket_source_ipv6_endpoint$(ipv6FieldIndex!), $fieldIrType %v$(callIndex)_socket_source_ipv6_$(ipv6Names[ipv6FieldIndex!]), $(ipv6FieldIndex! + 1)" -> println
        ipv6FieldIndex! + 1 => ipv6FieldIndex!
    }
    "  %v$(callIndex)_socket_source_tag6 = getelementptr inbounds " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(callIndex)_socket_source_slot, i32 0, i32 0" -> println
    "  store i32 1, ptr %v$(callIndex)_socket_source_tag6, align 4" -> println
    "  %v$(callIndex)_socket_source_payload6 = getelementptr inbounds " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(callIndex)_socket_source_slot, i32 0, i32 1" -> println
    "  store " -> print
    ipv6EndpointType! -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_source_ipv6_endpoint3, ptr %v$(callIndex)_socket_source_payload6, align 4" -> println
    "  br label %socket_source$(callIndex)_complete" -> println
    "socket_source$(callIndex)_complete:" -> println
    "  %v$(callIndex)_socket_source_endpoint = load " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(callIndex)_socket_source_slot, align 8" -> println
}

emitSocketCall request: SocketCallRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[request.callIndex] => call
    call.opcode == -272 or call.opcode == -287 or call.opcode == -290 or call.opcode == -291 or call.opcode == -292 or call.opcode == -302
        -> if {
            call.operand0 -> emitMutableBorrowArgumentValues(request.callIndex, request.ownerIndex, 0, context, state)
        }
    call.opcode == -270 or call.opcode == -340 -> if {
        call.operand0 -> aggregateValueIndex(context, state) => ownerIndex
        context.ir[ownerIndex] => owner
        "  %v$(request.callIndex)_socket_handle = extractvalue " -> print
        owner -> writeIrType(context, state)
        " " -> print
        ownerIndex -> writeValue(request.ownerIndex, context, state)
        ", 0" -> println
        call.opcode == -340 -> if {
            "  call void @sollang_platform_socket_completion_close(i64 %v$(request.callIndex)_socket_handle)" -> println
        } else {
            "  call void @sollang_platform_close_socket(i64 %v$(request.callIndex)_socket_handle)" -> println
        }
    } else {
        call.opcode == -336 -> if {
            request -> emitSocketCompletionSubmit(context, state)
        } else {
            call.opcode -> typedIr.isSocketCompletionDequeueOpcode
                -> if {
                    request -> emitSocketCompletionDequeue(context, state)
                } else {
                    request -> emitSocketResultCall(context, state)
                }
        }
    }
    # Runtime calls obey the same semantic move events as ordinary calls.
    # Retire consumed pattern owners after the result owns their storage.
    request.callIndex -> emitCompletedPatternBindingTransferMarks(context, state)
}

# Arguments retain their evaluation order in the IR operand chain. Resolve the
# already evaluated value instead of emitting a receiver or a slot again.
socketCallArgument callIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.ir[callIndex].operand0 => argument!
    0 => index!
    index! < ordinal and argument! >= 0 -> while {
        context.ir[argument!].nextOperand => argument!
        index! + 1 => index!
    }
    argument! -> aggregateValueIndex(context, state)
}

# Native Task contexts hold the result at their base. The reactor's exact
# affine token is retained in control field17, not in the managed context ABI.
emitSocketCompletionDequeue request: SocketCallRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[request.callIndex] => call
    request.callIndex -> socketCallArgument(0, context, state) => reactor
    request.callIndex -> socketCallArgument(1, context, state) => cancellation
    context.typeSizes[call.typeId] => resultSize
    resultSize -> runtimeTaskContextSize(context, state) => allocationSize
    "  %v$(request.callIndex)_completion_context = call ptr @sollang_alloc(i64 $allocationSize)" -> println
    "  %v$(request.callIndex)_completion_context_ok = icmp ne ptr %v$(request.callIndex)_completion_context, null" -> println
    "  br i1 %v$(request.callIndex)_completion_context_ok, label %completion$(request.callIndex)_descriptor, label %completion$(request.callIndex)_context_failed" -> println
    "completion$(request.callIndex)_context_failed:" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "completion$(request.callIndex)_descriptor:" -> println
    "  %v$(request.callIndex)_completion_descriptor = call ptr @sollang_alloc(i64 88)" -> println
    "  %v$(request.callIndex)_completion_descriptor_ok = icmp ne ptr %v$(request.callIndex)_completion_descriptor, null" -> println
    "  br i1 %v$(request.callIndex)_completion_descriptor_ok, label %completion$(request.callIndex)_start, label %completion$(request.callIndex)_descriptor_failed" -> println
    "completion$(request.callIndex)_descriptor_failed:" -> println
    "  call void @sollang_free(ptr %v$(request.callIndex)_completion_context)" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "completion$(request.callIndex)_start:" -> println
    "  call void @llvm.memset.p0.i64(ptr %v$(request.callIndex)_completion_descriptor, i8 0, i64 88, i1 false)" -> println
    "  call void @llvm.memset.p0.i64(ptr %v$(request.callIndex)_completion_context, i8 0, i64 $resultSize, i1 false)" -> println
    "  %v$(request.callIndex)_completion_handle = call ptr @sollang_task_start(ptr @sollang_socket_completion_dequeue_task_worker, ptr @sollang_free, ptr @sollang_socket_completion_dequeue_task_cancel, ptr %v$(request.callIndex)_completion_context)" -> println
    "  %v$(request.callIndex)_completion_started = icmp ne ptr %v$(request.callIndex)_completion_handle, null" -> println
    "  br i1 %v$(request.callIndex)_completion_started, label %completion$(request.callIndex)_ready, label %completion$(request.callIndex)_start_failed" -> println
    "completion$(request.callIndex)_start_failed:" -> println
    "  call void @sollang_free(ptr %v$(request.callIndex)_completion_descriptor)" -> println
    "  call void @sollang_free(ptr %v$(request.callIndex)_completion_context)" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "completion$(request.callIndex)_ready:" -> println
    "v$(request.callIndex)_completion" -> emitRuntimeTaskDiagnosticContext("%v$(request.callIndex)_completion_handle", "%v$(request.callIndex)_completion_context", resultSize, request.ownerIndex, context, state)
    "  %v$(request.callIndex)_completion_descriptor_value = ptrtoint ptr %v$(request.callIndex)_completion_descriptor to i64" -> println
    "  %v$(request.callIndex)_completion_descriptor_slot = getelementptr %sollang.task_control, ptr %v$(request.callIndex)_completion_handle, i32 0, i32 13" -> println
    "  store i64 %v$(request.callIndex)_completion_descriptor_value, ptr %v$(request.callIndex)_completion_descriptor_slot, align 8" -> println
    "  %v$(request.callIndex)_completion_identity = extractvalue " -> print
    reactor -> writeSocketReceiverType(context, state)
    " " -> print
    reactor -> writeSocketReceiverValue(request.ownerIndex, context, state)
    ", 0" -> println
    "  %v$(request.callIndex)_completion_identity_slot = getelementptr %sollang.task_control, ptr %v$(request.callIndex)_completion_handle, i32 0, i32 17" -> println
    "  store i64 %v$(request.callIndex)_completion_identity, ptr %v$(request.callIndex)_completion_identity_slot, align 8" -> println
    "  %v$(request.callIndex)_completion_cancelled = extractvalue " -> print
    cancellation -> writeSocketReceiverType(context, state)
    " " -> print
    cancellation -> writeSocketReceiverValue(request.ownerIndex, context, state)
    ", 0" -> println
    "  %v$(request.callIndex)_completion_cancelled32 = zext i1 %v$(request.callIndex)_completion_cancelled to i32" -> println
    "  %v$(request.callIndex)_completion_cancelled_slot = getelementptr %sollang.task_control, ptr %v$(request.callIndex)_completion_handle, i32 0, i32 20" -> println
    "  store i32 %v$(request.callIndex)_completion_cancelled32, ptr %v$(request.callIndex)_completion_cancelled_slot, align 4" -> println
    "  %v$(request.callIndex)_completion_result_completion_slot = getelementptr %sollang.task_control, ptr %v$(request.callIndex)_completion_handle, i32 0, i32 22" -> println
    "  store ptr @sollang_task_result_complete_n$(request.callIndex), ptr %v$(request.callIndex)_completion_result_completion_slot, align 8" -> println
    "  %v$(request.callIndex)_completion_task0 = insertvalue %sollang.task poison, ptr %v$(request.callIndex)_completion_handle, 0" -> println
    "  %v$(request.callIndex) = insertvalue %sollang.task %v$(request.callIndex)_completion_task0, ptr %v$(request.callIndex)_completion_context, 1" -> println
}

emitCompletionSocketError nodeIndex: Int, errorType: Int, kindSuffix: Text, codeSuffix: Text, targetSuffix: Text, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    "v$(nodeIndex)" -> emitCompletionSocketErrorNamed(errorType, kindSuffix, codeSuffix, targetSuffix, context, state)
}

emitCompletionSocketErrorNamed namePrefix: Text, errorType: Int, kindSuffix: Text, codeSuffix: Text, targetSuffix: Text, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    nominalFieldType(errorType, 0, context) => kindType
    "  %$(namePrefix)_$(targetSuffix)_kind = insertvalue " -> print
    kindType -> writeSemanticTypeId(context, state)
    " zeroinitializer, i32 %$(namePrefix)_$(kindSuffix), 0" -> println
    "  %$(namePrefix)_$(targetSuffix)_error0 = insertvalue " -> print
    errorType -> writeSemanticTypeId(context, state)
    " zeroinitializer, " -> print
    kindType -> writeSemanticTypeId(context, state)
    " %$(namePrefix)_$(targetSuffix)_kind, 0" -> println
    "  %$(namePrefix)_$(targetSuffix)_error = insertvalue " -> print
    errorType -> writeSemanticTypeId(context, state)
    " %$(namePrefix)_$(targetSuffix)_error0, i32 %$(namePrefix)_$(codeSuffix), 1" -> println
    "  store " -> print
    errorType -> writeSemanticTypeId(context, state)
    " %$(namePrefix)_$(targetSuffix)_error, ptr %$(namePrefix)_$(targetSuffix), align 8" -> println
}

# Rebuild the exact returned owner graph only after joining the completion
# worker. The descriptor's byte buffer transfers to the returned slot; only the
# descriptor storage is released here. Ordinary Task release frees the context.
emitCompletedSocketDequeue resultType: Int, producerIndex: Int, namePrefix: Text, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[producerIndex].opcode == -339 => terminalOnly
    -1 => completionType!
    terminalOnly -> if {
        resultType -> enumVariantPayloadTypes(context, state) => payloads
        payloads[0] => completionType!
    } else { context.types[resultType].first => completionType! }
    nominalFieldType(completionType!, 0, context) => reactorType
    nominalFieldType(completionType!, 1, context) => slotType
    [13, 17, 15, 11] => controlFields
    ["descriptor_value", "identity", "kind", "code"] => controlNames
    ["i64", "i64", "i32", "i32"] => controlTypes
    [8, 8, 4, 4] => controlAlignments
    0 => control!
    control! < 4 -> while {
        "  %$(namePrefix)_completion_$(controlNames[control!])_control = getelementptr %sollang.task_control, ptr %$(namePrefix)_task_handle, i32 0, i32 $(controlFields[control!])" -> println
        "  %$(namePrefix)_completion_$(controlNames[control!]) = load $(controlTypes[control!]), ptr %$(namePrefix)_completion_$(controlNames[control!])_control, align $(controlAlignments[control!])" -> println
        control! + 1 => control!
    }
    "  %$(namePrefix)_completion_descriptor = inttoptr i64 %$(namePrefix)_completion_descriptor_value to ptr" -> println
    "  %$(namePrefix)_completion_reactor = insertvalue " -> print
    reactorType -> writeSemanticTypeId(context, state)
    " zeroinitializer, i64 %$(namePrefix)_completion_identity, 0" -> println
    "  %$(namePrefix)_completion_ok = icmp slt i32 %$(namePrefix)_completion_kind, 0" -> println
    "  store " -> print
    resultType -> writeSemanticTypeId(context, state)
    " zeroinitializer, ptr %$(namePrefix)_task_context, align 8" -> println
    "  %$(namePrefix)_completion_result_tag = getelementptr inbounds " -> print
    resultType -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_task_context, i32 0, i32 0" -> println
    "  %$(namePrefix)_completion_result_payload = getelementptr inbounds " -> print
    resultType -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_task_context, i32 0, i32 1" -> println
    "  br i1 %$(namePrefix)_completion_ok, label %completion_await_$(namePrefix)_success, label %completion_await_$(namePrefix)_failure" -> println
    "completion_await_$(namePrefix)_success:" -> println
    ["key", "direction", "data", "buffer_length", "capacity", "offset", "length", "transferred", "state", "terminal_kind", "terminal_code", "native_identity"] => descriptorNames
    [0, 8, 16, 24, 32, 40, 48, 56, 64, 68, 72, 80] => descriptorOffsets
    ["i64", "i32", "ptr", "i64", "i64", "i64", "i64", "i64", "i32", "i32", "i32", "i64"] => descriptorTypes
    [8, 4, 8, 8, 8, 8, 8, 8, 4, 4, 4, 8] => descriptorAlignments
    0 => descriptorField!
    descriptorField! < 12 -> while {
        "  %$(namePrefix)_completion_$(descriptorNames[descriptorField!])_address = getelementptr i8, ptr %$(namePrefix)_completion_descriptor, i64 $(descriptorOffsets[descriptorField!])" -> println
        "  %$(namePrefix)_completion_$(descriptorNames[descriptorField!]) = load $(descriptorTypes[descriptorField!]), ptr %$(namePrefix)_completion_$(descriptorNames[descriptorField!])_address, align $(descriptorAlignments[descriptorField!])" -> println
        descriptorField! + 1 => descriptorField!
    }
    terminalOnly -> if {
        "  %$(namePrefix)_completion_cancelled = icmp eq i32 %$(namePrefix)_completion_state, 3" -> println
        "  %$(namePrefix)_completion_failed = icmp sge i32 %$(namePrefix)_completion_terminal_kind, 0" -> println
        "  %$(namePrefix)_completion_terminal_tag0 = select i1 %$(namePrefix)_completion_failed, i32 1, i32 0" -> println
        "  %$(namePrefix)_completion_terminal_tag = select i1 %$(namePrefix)_completion_cancelled, i32 2, i32 %$(namePrefix)_completion_terminal_tag0" -> println
        "  store i32 %$(namePrefix)_completion_terminal_tag, ptr %$(namePrefix)_completion_result_tag, align 4" -> println
    }
    "  %$(namePrefix)_completion_returned_reactor = getelementptr inbounds " -> print
    completionType! -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_completion_result_payload, i32 0, i32 0" -> println
    "  store " -> print
    reactorType -> writeSemanticTypeId(context, state)
    " %$(namePrefix)_completion_reactor, ptr %$(namePrefix)_completion_returned_reactor, align 8" -> println
    "  %$(namePrefix)_completion_slot = getelementptr inbounds " -> print
    completionType! -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_completion_result_payload, i32 0, i32 1" -> println
    ["key", "direction", "bytes", "offset", "length", "state", "transferred", "error", "native_identity"] => slotFields
    0 => slotField!
    slotField! < 9 -> while {
        "  %$(namePrefix)_completion_slot_$(slotFields[slotField!]) = getelementptr inbounds " -> print
        slotType -> writeSemanticTypeId(context, state)
        ", ptr %$(namePrefix)_completion_slot, i32 0, i32 $(slotField!)" -> println
        slotField! + 1 => slotField!
    }
    ["key", "offset", "length"] => scalarFields
    0 => scalar!
    scalar! < 3 -> while {
        "  store i64 %$(namePrefix)_completion_$(scalarFields[scalar!]), ptr %$(namePrefix)_completion_slot_$(scalarFields[scalar!]), align 8" -> println
        scalar! + 1 => scalar!
    }
    [1, 5] => tagOrdinals
    ["direction", "state"] => tagFields
    0 => tag!
    tag! < 2 -> while {
        "  %$(namePrefix)_completion_slot_$(tagFields[tag!])_tag = getelementptr inbounds " -> print
        nominalFieldType(slotType, tagOrdinals[tag!], context) -> writeSemanticTypeId(context, state)
        ", ptr %$(namePrefix)_completion_slot_$(tagFields[tag!]), i32 0, i32 0" -> println
        "  store i32 %$(namePrefix)_completion_$(tagFields[tag!]), ptr %$(namePrefix)_completion_slot_$(tagFields[tag!])_tag, align 4" -> println
        tag! + 1 => tag!
    }
    nominalFieldType(slotType, 2, context) => bytesType
    ["data", "buffer_length", "capacity"] => byteFields
    0 => byteField!
    byteField! < 3 -> while {
        "  %$(namePrefix)_completion_slot_bytes_$(byteField!) = getelementptr inbounds " -> print
        bytesType -> writeSemanticTypeId(context, state)
        ", ptr %$(namePrefix)_completion_slot_bytes, i32 0, i32 $(byteField!)" -> println
        "  store " -> print
        byteField! == 0 -> if { "ptr" -> print } else { "i64" -> print }
        " %$(namePrefix)_completion_$(byteFields[byteField!]), ptr %$(namePrefix)_completion_slot_bytes_$(byteField!), align 8" -> println
        byteField! + 1 => byteField!
    }
    [6, 8] => someOrdinals
    ["transferred", "native_identity"] => someFields
    0 => some!
    some! < 2 -> while {
        nominalFieldType(slotType, someOrdinals[some!], context) => optionType
        "  %$(namePrefix)_completion_$(someFields[some!])_tag = getelementptr inbounds " -> print
        optionType -> writeSemanticTypeId(context, state)
        ", ptr %$(namePrefix)_completion_slot_$(someFields[some!]), i32 0, i32 0" -> println
        "  store i32 1, ptr %$(namePrefix)_completion_$(someFields[some!])_tag, align 4" -> println
        "  %$(namePrefix)_completion_$(someFields[some!])_payload = getelementptr inbounds " -> print
        optionType -> writeSemanticTypeId(context, state)
        ", ptr %$(namePrefix)_completion_slot_$(someFields[some!]), i32 0, i32 1" -> println
        "  store i64 %$(namePrefix)_completion_$(someFields[some!]), ptr %$(namePrefix)_completion_$(someFields[some!])_payload, align 8" -> println
        some! + 1 => some!
    }
    nominalFieldType(slotType, 7, context) => errorOptionType
    "  %$(namePrefix)_completion_has_error = icmp sge i32 %$(namePrefix)_completion_terminal_kind, 0" -> println
    "  br i1 %$(namePrefix)_completion_has_error, label %completion_await_$(namePrefix)_slot_error, label %completion_await_$(namePrefix)_merge" -> println
    "completion_await_$(namePrefix)_slot_error:" -> println
    "  %$(namePrefix)_completion_slot_error_tag = getelementptr inbounds " -> print
    errorOptionType -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_completion_slot_error, i32 0, i32 0" -> println
    "  store i32 1, ptr %$(namePrefix)_completion_slot_error_tag, align 4" -> println
    "  %$(namePrefix)_completion_slot_error_payload = getelementptr inbounds " -> print
    errorOptionType -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_completion_slot_error, i32 0, i32 1" -> println
    namePrefix -> emitCompletionSocketErrorNamed(context.types[errorOptionType].first, "completion_terminal_kind", "completion_terminal_code", "completion_slot_error_payload", context, state)
    "  br label %completion_await_$(namePrefix)_merge" -> println
    "completion_await_$(namePrefix)_failure:" -> println
    terminalOnly -> if {
        "  call void @llvm.trap()" -> println
        "  unreachable" -> println
    } else {
        context.types[resultType].second => failureType
        "  store i32 1, ptr %$(namePrefix)_completion_result_tag, align 4" -> println
        "  %$(namePrefix)_completion_failure_reactor = getelementptr inbounds " -> print
        failureType -> writeSemanticTypeId(context, state)
        ", ptr %$(namePrefix)_completion_result_payload, i32 0, i32 0" -> println
        "  store " -> print
        reactorType -> writeSemanticTypeId(context, state)
        " %$(namePrefix)_completion_reactor, ptr %$(namePrefix)_completion_failure_reactor, align 8" -> println
        "  %$(namePrefix)_completion_failure_error = getelementptr inbounds " -> print
        failureType -> writeSemanticTypeId(context, state)
        ", ptr %$(namePrefix)_completion_result_payload, i32 0, i32 1" -> println
        namePrefix -> emitCompletionSocketErrorNamed(nominalFieldType(failureType, 1, context), "completion_kind", "completion_code", "completion_failure_error", context, state)
        "  br label %completion_await_$(namePrefix)_merge" -> println
    }
    "completion_await_$(namePrefix)_merge:" -> println
    "  call void @sollang_free(ptr %$(namePrefix)_completion_descriptor)" -> println
}

emitSocketCompletionSubmit request: SocketCallRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    request.callIndex -> socketCallArgument(0, context, state) => reactor
    request.callIndex -> socketCallArgument(1, context, state) => registrationKey
    request.callIndex -> socketCallArgument(2, context, state) => slot
    context.ir[slot] -> effectiveTypeId(context, state) => slotType
    nominalFieldType(slotType, 1, context) => directionType
    nominalFieldType(slotType, 2, context) => bytesType
    nominalFieldType(slotType, 5, context) => stateType
    "  %v$(request.callIndex)_submit_reactor = extractvalue " -> print
    reactor -> writeSocketReceiverType(context, state)
    " " -> print
    reactor -> writeSocketReceiverValue(request.ownerIndex, context, state)
    ", 0" -> println
    ["key", "direction", "bytes", "offset", "length", "state"] => fieldNames
    0 => field!
    field! < 6 -> while {
        "  %v$(request.callIndex)_submit_$(fieldNames[field!]) = extractvalue " -> print
        slotType -> writeSemanticTypeId(context, state)
        " " -> print
        slot -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", $(field!)" -> println
        field! + 1 => field!
    }
    "  %v$(request.callIndex)_submit_direction_tag = extractvalue " -> print
    directionType -> writeSemanticTypeId(context, state)
    " %v$(request.callIndex)_submit_direction, 0" -> println
    "  %v$(request.callIndex)_submit_state_tag = extractvalue " -> print
    stateType -> writeSemanticTypeId(context, state)
    " %v$(request.callIndex)_submit_state, 0" -> println
    ["data", "length", "capacity"] => byteFields
    0 => byteField!
    byteField! < 3 -> while {
        "  %v$(request.callIndex)_submit_buffer_$(byteFields[byteField!]) = extractvalue " -> print
        bytesType -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_submit_bytes, $(byteField!)" -> println
        byteField! + 1 => byteField!
    }
    "  %v$(request.callIndex)_submit_raw = call %sollang.socket_result @sollang_platform_socket_completion_submit(i64 %v$(request.callIndex)_submit_reactor, i64 " -> print
    registrationKey -> writeValue(request.ownerIndex, context, state)
    ", i64 %v$(request.callIndex)_submit_key, i32 %v$(request.callIndex)_submit_direction_tag, ptr %v$(request.callIndex)_submit_buffer_data, i64 %v$(request.callIndex)_submit_buffer_length, i64 %v$(request.callIndex)_submit_buffer_capacity, i64 %v$(request.callIndex)_submit_offset, i64 %v$(request.callIndex)_submit_length, i32 %v$(request.callIndex)_submit_state_tag)" -> println
    "  %v$(request.callIndex)_submit_kind = extractvalue %sollang.socket_result %v$(request.callIndex)_submit_raw, 1" -> println
    "  %v$(request.callIndex)_submit_ok = icmp slt i32 %v$(request.callIndex)_submit_kind, 0" -> println
    context.ir[request.callIndex] => call
    context.types[call.typeId].first => submissionType
    context.types[call.typeId].second => failureType
    "  store " -> print
    call -> writeIrType(context, state)
    " zeroinitializer, ptr %v$(request.callIndex)_socket_result_slot, align 8" -> println
    "  %v$(request.callIndex)_submit_result_tag = getelementptr inbounds " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_socket_result_slot, i32 0, i32 0" -> println
    "  %v$(request.callIndex)_submit_result_payload = getelementptr inbounds " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_socket_result_slot, i32 0, i32 1" -> println
    "  br i1 %v$(request.callIndex)_submit_ok, label %submit$(request.callIndex)_classify, label %submit$(request.callIndex)_failure" -> println
    "submit$(request.callIndex)_classify:" -> println
    "  %v$(request.callIndex)_submit_pending = icmp eq i32 %v$(request.callIndex)_submit_kind, -2" -> println
    "  %v$(request.callIndex)_submit_tag = getelementptr inbounds " -> print
    submissionType -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.callIndex)_submit_result_payload, i32 0, i32 0" -> println
    "  %v$(request.callIndex)_submit_payload = getelementptr inbounds " -> print
    submissionType -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.callIndex)_submit_result_payload, i32 0, i32 1" -> println
    "  br i1 %v$(request.callIndex)_submit_pending, label %submit$(request.callIndex)_pending, label %submit$(request.callIndex)_completed" -> println
    "submit$(request.callIndex)_pending:" -> println
    "  store i32 0, ptr %v$(request.callIndex)_submit_tag, align 4" -> println
    "  store " -> print
    reactor -> writeSocketReceiverType(context, state)
    " " -> print
    reactor -> writeSocketReceiverValue(request.ownerIndex, context, state)
    ", ptr %v$(request.callIndex)_submit_payload, align 8" -> println
    "  br label %submit$(request.callIndex)_merge" -> println
    "submit$(request.callIndex)_completed:" -> println
    "  store i32 1, ptr %v$(request.callIndex)_submit_tag, align 4" -> println
    submissionType -> enumVariantPayloadTypes(context, state) => submissionPayloadTypes
    submissionPayloadTypes[1] => completionType
    "  %v$(request.callIndex)_submit_completion_reactor = getelementptr inbounds " -> print
    completionType -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.callIndex)_submit_payload, i32 0, i32 0" -> println
    "  store " -> print
    reactor -> writeSocketReceiverType(context, state)
    " " -> print
    reactor -> writeSocketReceiverValue(request.ownerIndex, context, state)
    ", ptr %v$(request.callIndex)_submit_completion_reactor, align 8" -> println
    "  %v$(request.callIndex)_submit_completion_slot = getelementptr inbounds " -> print
    completionType -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.callIndex)_submit_payload, i32 0, i32 1" -> println
    "  store " -> print
    slotType -> writeSemanticTypeId(context, state)
    " " -> print
    slot -> writeSocketReceiverValue(request.ownerIndex, context, state)
    ", ptr %v$(request.callIndex)_submit_completion_slot, align 8" -> println
    "  %v$(request.callIndex)_submit_completed_state = getelementptr inbounds " -> print
    slotType -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.callIndex)_submit_completion_slot, i32 0, i32 5, i32 0" -> println
    "  store i32 2, ptr %v$(request.callIndex)_submit_completed_state, align 4" -> println
    nominalFieldType(slotType, 6, context) => transferredType
    "  %v$(request.callIndex)_submit_transferred_slot = getelementptr inbounds " -> print
    slotType -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.callIndex)_submit_completion_slot, i32 0, i32 6" -> println
    "  %v$(request.callIndex)_submit_transferred_tag = getelementptr inbounds " -> print
    transferredType -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.callIndex)_submit_transferred_slot, i32 0, i32 0" -> println
    "  store i32 1, ptr %v$(request.callIndex)_submit_transferred_tag, align 4" -> println
    "  %v$(request.callIndex)_submit_transferred_payload = getelementptr inbounds " -> print
    transferredType -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.callIndex)_submit_transferred_slot, i32 0, i32 1" -> println
    "  %v$(request.callIndex)_submit_transferred = extractvalue %sollang.socket_result %v$(request.callIndex)_submit_raw, 0" -> println
    "  store i64 %v$(request.callIndex)_submit_transferred, ptr %v$(request.callIndex)_submit_transferred_payload, align 8" -> println
    "  %v$(request.callIndex)_submit_error_slot = getelementptr inbounds " -> print
    slotType -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.callIndex)_submit_completion_slot, i32 0, i32 7" -> println
    "  store " -> print
    nominalFieldType(slotType, 7, context) -> writeSemanticTypeId(context, state)
    " zeroinitializer, ptr %v$(request.callIndex)_submit_error_slot, align 8" -> println
    "  br label %submit$(request.callIndex)_merge" -> println
    "submit$(request.callIndex)_failure:" -> println
    "  store i32 1, ptr %v$(request.callIndex)_submit_result_tag, align 4" -> println
    [reactor, slot] => retainedOwners
    0 => retained!
    retained! < 2 -> while {
        "  %v$(request.callIndex)_submit_retained$(retained!) = getelementptr inbounds " -> print
        failureType -> writeSemanticTypeId(context, state)
        ", ptr %v$(request.callIndex)_submit_result_payload, i32 0, i32 $(retained!)" -> println
        "  store " -> print
        retainedOwners[retained!] -> writeSocketReceiverType(context, state)
        " " -> print
        retainedOwners[retained!] -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", ptr %v$(request.callIndex)_submit_retained$(retained!), align 8" -> println
        retained! + 1 => retained!
    }
    nominalFieldType(failureType, 2, context) => errorType
    nominalFieldType(errorType, 0, context) => errorKindType
    "  %v$(request.callIndex)_submit_error_kind = insertvalue " -> print
    errorKindType -> writeSemanticTypeId(context, state)
    " zeroinitializer, i32 %v$(request.callIndex)_submit_kind, 0" -> println
    "  %v$(request.callIndex)_submit_error0 = insertvalue " -> print
    errorType -> writeSemanticTypeId(context, state)
    " zeroinitializer, " -> print
    errorKindType -> writeSemanticTypeId(context, state)
    " %v$(request.callIndex)_submit_error_kind, 0" -> println
    "  %v$(request.callIndex)_submit_code = extractvalue %sollang.socket_result %v$(request.callIndex)_submit_raw, 2" -> println
    "  %v$(request.callIndex)_submit_error = insertvalue " -> print
    errorType -> writeSemanticTypeId(context, state)
    " %v$(request.callIndex)_submit_error0, i32 %v$(request.callIndex)_submit_code, 1" -> println
    "  %v$(request.callIndex)_submit_failure_error = getelementptr inbounds " -> print
    failureType -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.callIndex)_submit_result_payload, i32 0, i32 2" -> println
    "  store " -> print
    errorType -> writeSemanticTypeId(context, state)
    " %v$(request.callIndex)_submit_error, ptr %v$(request.callIndex)_submit_failure_error, align 8" -> println
    "  br label %submit$(request.callIndex)_merge" -> println
    "submit$(request.callIndex)_merge:" -> println
    "  %v$(request.callIndex) = load " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_socket_result_slot, align 8" -> println
}

# Stateful socket wrappers are affine, so a readonly method on an outer owner
# can expose its socket field as a reference-backed value. The generic
# expression pass has already materialized that value as %v<node>. Intrinsic
# lowering must use the referenced nominal value type and that SSA value, while
# ordinary by-value receivers retain the existing writer path.
writeSocketReceiverType valueIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[valueIndex] => value
    value -> referenceValueTypeId(context, state) => referencedTypeId
    referencedTypeId >= 0 -> if {
        referencedTypeId -> writeSemanticTypeId(context, state)
    } else {
        value -> writeIrType(context, state)
    }
}

writeSocketReceiverValue valueIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[valueIndex] -> referenceValueTypeId(context, state) >= 0
        -> if {
            "%v$(valueIndex)" -> print
        } else {
            valueIndex -> writeValue(ownerIndex, context, state)
        }
}

emitSocketResultCall request: SocketCallRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[request.callIndex] => call
    call.operand0 => firstArgumentIndex
    firstArgumentIndex -> aggregateValueIndex(context, state) => firstValueIndex
    context.ir[firstValueIndex] => firstValue
    -1 => secondArgumentIndex!
    firstArgumentIndex >= 0 -> if { context.ir[firstArgumentIndex].nextOperand => secondArgumentIndex! }
    -1 => thirdArgumentIndex!
    secondArgumentIndex! >= 0 -> if { context.ir[secondArgumentIndex!].nextOperand => thirdArgumentIndex! }
    -1 => fourthArgumentIndex!
    thirdArgumentIndex! >= 0 -> if { context.ir[thirdArgumentIndex!].nextOperand => fourthArgumentIndex! }
    secondArgumentIndex! >= 0 -> if { secondArgumentIndex! -> aggregateValueIndex(context, state) => secondArgumentIndex! }
    thirdArgumentIndex! >= 0 -> if { thirdArgumentIndex! -> aggregateValueIndex(context, state) => thirdArgumentIndex! }
    fourthArgumentIndex! >= 0 -> if { fourthArgumentIndex! -> aggregateValueIndex(context, state) => fourthArgumentIndex! }
    # Completion capacity checks and allocation belong to the platform helper.
    # Pass the three independent UIntSize bounds without narrowing or defaults.
    call.opcode == -333 -> if {
        0 => optionIndex!
        optionIndex! < 3 -> while {
            "  %v$(request.callIndex)_completion_bound$(optionIndex!) = extractvalue " -> print
            firstValueIndex -> writeSocketReceiverType(context, state)
            " " -> print
            firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
            ", $(optionIndex!)" -> println
            optionIndex! + 1 => optionIndex!
        }
        "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_completion_create(i64 %v$(request.callIndex)_completion_bound0, i64 %v$(request.callIndex)_completion_bound1, i64 %v$(request.callIndex)_completion_bound2)" -> println
    }
    call.opcode == -334 or call.opcode == -335 or call.opcode == -337
        -> if {
            "  %v$(request.callIndex)_socket_handle = extractvalue " -> print
            firstValueIndex -> writeSocketReceiverType(context, state)
            " " -> print
            firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
            ", 0" -> println
            call.opcode == -334 -> if {
                "  %v$(request.callIndex)_completion_stream = extractvalue " -> print
                secondArgumentIndex! -> writeSocketReceiverType(context, state)
                " " -> print
                secondArgumentIndex! -> writeSocketReceiverValue(request.ownerIndex, context, state)
                ", 0" -> println
                "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_completion_register_stream(i64 %v$(request.callIndex)_socket_handle, i64 %v$(request.callIndex)_completion_stream, i64 " -> print
                thirdArgumentIndex! -> writeValue(request.ownerIndex, context, state)
                ")" -> println
            } else {
                "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_completion_" -> print
                call.opcode == -335 -> if { "remove_stream" -> print } else { "cancel" -> print }
                "(i64 %v$(request.callIndex)_socket_handle, i64 " -> print
                secondArgumentIndex! -> writeValue(request.ownerIndex, context, state)
                ")" -> println
            }
        }
    # listen(ListenOptions)
    call.opcode == -258 -> if {
        "  %v$(request.callIndex)_socket_endpoint = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 0" -> println
        firstValue -> effectiveTypeId(context, state) => socketOptionsType
        nominalFieldType(socketOptionsType, 0, context) => socketEndpointType
        request.callIndex -> emitSocketEndpointDescriptor(socketEndpointType, context, state)
        "  %v$(request.callIndex)_socket_backlog = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 1" -> println
        "  %v$(request.callIndex)_socket_backlog64 = sext i32 %v$(request.callIndex)_socket_backlog to i64" -> println
        "  %v$(request.callIndex)_socket_reuse = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 2" -> println
        "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_listen(ptr %v$(request.callIndex)_socket_endpoint_descriptor, i64 %v$(request.callIndex)_socket_backlog64, i1 %v$(request.callIndex)_socket_reuse)" -> println
    }
    # bindDatagram(DatagramBindOptions)
    call.opcode == -265 -> if {
        "  %v$(request.callIndex)_socket_endpoint = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 0" -> println
        firstValue -> effectiveTypeId(context, state) => socketOptionsType
        nominalFieldType(socketOptionsType, 0, context) => socketEndpointType
        request.callIndex -> emitSocketEndpointDescriptor(socketEndpointType, context, state)
        "  %v$(request.callIndex)_socket_reuse = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 1" -> println
        "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_bind_datagram(ptr %v$(request.callIndex)_socket_endpoint_descriptor, i1 %v$(request.callIndex)_socket_reuse)" -> println
    }
    # accept(TcpListener), localPort(UdpSocket)
    call.opcode == -259 or call.opcode == -268
        -> if {
            "  %v$(request.callIndex)_socket_handle = extractvalue " -> print
            firstValueIndex -> writeSocketReceiverType(context, state)
            " " -> print
            firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
