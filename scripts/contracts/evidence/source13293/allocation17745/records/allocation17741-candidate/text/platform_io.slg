    call.opcode == -335 or call.opcode == -337 -> if { nominalFieldType(socketFailureTypeId, 1, context) => socketErrorTypeId! }
    nominalFieldType(socketErrorTypeId!, 0, context) => socketKindTypeId
    "  %v$(request.callIndex)_socket_error_kind = insertvalue " -> print
    socketKindTypeId -> writeSemanticTypeId(context, state)
    " zeroinitializer, i32 %v$(request.callIndex)_socket_kind, 0" -> println
    "  %v$(request.callIndex)_socket_error0 = insertvalue " -> print
    socketErrorTypeId! -> writeSemanticTypeId(context, state)
    " poison, " -> print
    socketKindTypeId -> writeSemanticTypeId(context, state)
    " %v$(request.callIndex)_socket_error_kind, 0" -> println
    "  %v$(request.callIndex)_socket_error = insertvalue " -> print
    socketErrorTypeId! -> writeSemanticTypeId(context, state)
    " %v$(request.callIndex)_socket_error0, i32 %v$(request.callIndex)_socket_code, 1" -> println
    "  %v$(request.callIndex)_socket_error_payload = getelementptr inbounds " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_socket_result_slot, i32 0, i32 1" -> println
    call.opcode == -334 or call.opcode == -335 or call.opcode == -337
        -> if {
            "  %v$(request.callIndex)_completion_failure0 = insertvalue " -> print
            socketFailureTypeId -> writeSemanticTypeId(context, state)
            " zeroinitializer, " -> print
            firstValueIndex -> writeSocketReceiverType(context, state)
            " " -> print
            firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
            ", 0" -> println
            call.opcode == -334 -> if {
                "  %v$(request.callIndex)_completion_failure1 = insertvalue " -> print
                socketFailureTypeId -> writeSemanticTypeId(context, state)
                " %v$(request.callIndex)_completion_failure0, " -> print
                secondArgumentIndex! -> writeSocketReceiverType(context, state)
                " " -> print
                secondArgumentIndex! -> writeSocketReceiverValue(request.ownerIndex, context, state)
                ", 1" -> println
            }
            "  %v$(request.callIndex)_completion_failure = insertvalue " -> print
            socketFailureTypeId -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_completion_failure" -> print
            call.opcode == -334 -> if { "1" -> print } else { "0" -> print }
            ", " -> print
            socketErrorTypeId! -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_socket_error, " -> print
            call.opcode == -334 -> if { "2" -> println } else { "1" -> println }
            "  store " -> print
            socketFailureTypeId -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_completion_failure, ptr %v$(request.callIndex)_socket_error_payload, align 8" -> println
        } else {
            "  store " -> print
            socketErrorTypeId! -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_socket_error, ptr %v$(request.callIndex)_socket_error_payload, align 8" -> println
        }
    "  br label %socket$(request.callIndex)_merge" -> println
    "socket$(request.callIndex)_merge:" -> println
    "  %v$(request.callIndex) = load " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_socket_result_slot, align 8" -> println
}

nominalFieldType ownerType: Int, ordinal: Int, context: ref emitterContext.EmitContext -> Int {
    -1 => fieldType!
    0 => fieldIndex!
    fieldIndex! < (context.fields -> len) -> while {
        context.fields[fieldIndex!] => field
        field.status == 0 and field.ownerType == ownerType and field.ordinal == ordinal
            -> if { field.fieldType => fieldType! }
        fieldIndex! + 1 => fieldIndex!
    }
    fieldType!
}

emitAsyncFileScalarCall request: FileCallRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[request.callIndex] => call
    call.typeId < 0 or call.typeId >= (context.types -> len)
        -> if {
            "sollang compiler verification failure V008: async file call type outside canonical type bounds (call $(request.callIndex), type $(call.typeId))" -> runtime.eprintln
            return
        }
    call.opcode == typedIr.asyncFileWriteOpcode() => writing
    -1 => scalarTypeId!
    -1 => scalarValueIndex!
    -1 => scalarOffsetIndex!
    writing -> if {
        call.operand0 < 0 or call.operand0 >= (context.ir -> len)
            -> if {
                "sollang compiler verification failure V008: async file writer receiver missing (call $(request.callIndex))" -> runtime.eprintln
                return
            }
        call.operand0 => valueArgument!
        context.ir[valueArgument!].nextOperand => offsetArgument!
        offsetArgument! >= 0 and offsetArgument! < (context.ir -> len)
            and context.ir[offsetArgument!].nextOperand >= 0
            -> while {
                offsetArgument! => valueArgument!
                context.ir[offsetArgument!].nextOperand => offsetArgument!
            }
        valueArgument! == call.operand0 or offsetArgument! < 0 or offsetArgument! >= (context.ir -> len)
            -> if {
                "sollang compiler verification failure V008: async file writer scalar or offset missing (call $(request.callIndex))" -> runtime.eprintln
                return
            }
        valueArgument! -> aggregateValueIndex(context, state) => scalarValueIndex!
        offsetArgument! -> aggregateValueIndex(context, state) => scalarOffsetIndex!
        context.ir[scalarValueIndex!] -> effectiveTypeId(context, state) => scalarTypeId!
    } else {
        context.types[call.typeId].first => optionTypeId
        optionTypeId < 0 or optionTypeId >= (context.types -> len)
            -> if {
                "sollang compiler verification failure V008: async file option type missing (call $(request.callIndex), result $(call.typeId), option $optionTypeId)" -> runtime.eprintln
                return
            }
        context.types[optionTypeId].first => scalarTypeId!
    }
    scalarTypeId! < 0 or scalarTypeId! >= (context.typeSizes -> len)
        -> if {
            "sollang compiler verification failure V008: async file scalar type missing (call $(request.callIndex), result $(call.typeId), scalar $(scalarTypeId!))" -> runtime.eprintln
            return
        }
    context.typeSizes[scalarTypeId!] => scalarSize
    context.typeSizes[call.typeId] => resultSize
    resultSize -> runtimeTaskContextSize(context, state) => allocationSize
    "  %v$(request.callIndex)_file_async_context = call ptr @sollang_alloc(i64 $allocationSize)" -> println
    "  %v$(request.callIndex)_file_async_allocated = icmp ne ptr %v$(request.callIndex)_file_async_context, null" -> println
    "  br i1 %v$(request.callIndex)_file_async_allocated, label %file$(request.callIndex)_async_initialize, label %file$(request.callIndex)_async_allocation_failed" -> println
    "file$(request.callIndex)_async_allocation_failed:" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "file$(request.callIndex)_async_initialize:" -> println
    "  %v$(request.callIndex)_file_async_handle = call ptr @sollang_task_start(ptr @sollang_file_operation_task_worker, ptr @sollang_free, ptr @sollang_file_operation_task_cancel, ptr %v$(request.callIndex)_file_async_context)" -> println
    "  %v$(request.callIndex)_file_async_started = icmp ne ptr %v$(request.callIndex)_file_async_handle, null" -> println
    "  br i1 %v$(request.callIndex)_file_async_started, label %file$(request.callIndex)_async_ready, label %file$(request.callIndex)_async_start_failed" -> println
    "file$(request.callIndex)_async_start_failed:" -> println
    "  call void @sollang_free(ptr %v$(request.callIndex)_file_async_context)" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "file$(request.callIndex)_async_ready:" -> println
    "v$(request.callIndex)_file_async" -> emitRuntimeTaskDiagnosticContext("%v$(request.callIndex)_file_async_handle", "%v$(request.callIndex)_file_async_context", resultSize, request.ownerIndex, context, state)
    "  %v$(request.callIndex)_file_async_size_slot = getelementptr %sollang.task_control, ptr %v$(request.callIndex)_file_async_handle, i32 0, i32 11" -> println
    "  store i32 $scalarSize, ptr %v$(request.callIndex)_file_async_size_slot, align 4" -> println
    writing -> if {
        "  %v$(request.callIndex)_file_async_data_slot = getelementptr %sollang.task_control, ptr %v$(request.callIndex)_file_async_handle, i32 0, i32 13" -> println
        "  store " -> print
        scalarTypeId! -> writeSemanticTypeId(context, state)
        " " -> print
        scalarValueIndex! -> writeValue(request.ownerIndex, context, state)
        ", ptr %v$(request.callIndex)_file_async_data_slot, align $(context.typeAligns[scalarTypeId!])" -> println
        "  %v$(request.callIndex)_file_async_operation_slot = getelementptr %sollang.task_control, ptr %v$(request.callIndex)_file_async_handle, i32 0, i32 20" -> println
        "  store i32 1, ptr %v$(request.callIndex)_file_async_operation_slot, align 4" -> println
    }
    call.opcode == -320 or writing -> if {
        call.operand0 -> aggregateValueIndex(context, state) => receiverIndex
        receiverIndex < 0 or receiverIndex >= (context.ir -> len)
            -> if {
                "sollang compiler verification failure V008: async file receiver is outside canonical IR bounds (call $(request.callIndex))" -> runtime.eprintln
                return
            }
        context.ir[receiverIndex] => receiver
        receiver -> effectiveTypeId(context, state) => receiverStoredTypeId
        context.types -> typeIds.materializedReadTypeId(receiverStoredTypeId) => fileReaderTypeId
        receiverStoredTypeId != fileReaderTypeId => borrowedReceiver
        not (fileReaderTypeId -> isOwnedFileType(context, state))
            -> if {
                "sollang compiler verification failure V008: async file receiver is not the canonical File value (call $(request.callIndex), receiver $receiverIndex, type $fileReaderTypeId)" -> runtime.eprintln
                return
            }
        borrowedReceiver -> if {
            "  %v$(request.callIndex)_file_async_receiver = load " -> print
            fileReaderTypeId -> writeSemanticTypeId(context, state)
            ", ptr " -> print
            receiverIndex -> writeValue(request.ownerIndex, context, state)
            ", align $(context.typeAligns[fileReaderTypeId])" -> println
        }
        "  %v$(request.callIndex)_file_async_source_handle = extractvalue " -> print
        fileReaderTypeId -> writeSemanticTypeId(context, state)
        " " -> print
        borrowedReceiver -> if { "%v$(request.callIndex)_file_async_receiver" -> print } else {
            receiverIndex -> writeValue(request.ownerIndex, context, state)
        }
        ", 0" -> println
        "  %v$(request.callIndex)_file_async_owned_handle = call i64 @sollang_platform_duplicate_owned_file(i64 %v$(request.callIndex)_file_async_source_handle)" -> println
        "  %v$(request.callIndex)_file_async_handle_slot = getelementptr %sollang.task_control, ptr %v$(request.callIndex)_file_async_handle, i32 0, i32 17" -> println
        "  store i64 %v$(request.callIndex)_file_async_owned_handle, ptr %v$(request.callIndex)_file_async_handle_slot, align 8" -> println
        call.operand1 => offsetIndex!
        writing -> if { scalarOffsetIndex! => offsetIndex! }
        offsetIndex! < 0 or offsetIndex! >= (context.ir -> len)
            -> if {
                "sollang compiler verification failure V008: async file offset missing (call $(request.callIndex), ast $(call.astNode))" -> runtime.eprintln
                return
            }
        offsetIndex! -> aggregateValueIndex(context, state) => offsetValue
        "  %v$(request.callIndex)_file_async_offset_slot = getelementptr %sollang.task_control, ptr %v$(request.callIndex)_file_async_handle, i32 0, i32 18" -> println
        "  store i64 " -> print
        offsetValue -> writeValue(request.ownerIndex, context, state)
        ", ptr %v$(request.callIndex)_file_async_offset_slot, align 8" -> println
        "  %v$(request.callIndex)_file_async_explicit_slot = getelementptr %sollang.task_control, ptr %v$(request.callIndex)_file_async_handle, i32 0, i32 19" -> println
        "  store i32 1, ptr %v$(request.callIndex)_file_async_explicit_slot, align 4" -> println
    }
    "  %v$(request.callIndex)_file_async_result_completion_slot = getelementptr %sollang.task_control, ptr %v$(request.callIndex)_file_async_handle, i32 0, i32 22" -> println
    context.ir[request.callIndex].opcode -> typedIr.isAsyncFileOpcode
        -> if {
            "  store ptr @sollang_task_result_complete_n$(request.callIndex), ptr %v$(request.callIndex)_file_async_result_completion_slot, align 8" -> println
        }
    "  %v$(request.callIndex)_file_async_task_handle = insertvalue %sollang.task poison, ptr %v$(request.callIndex)_file_async_handle, 0" -> println
    "  %v$(request.callIndex) = insertvalue %sollang.task %v$(request.callIndex)_file_async_task_handle, ptr %v$(request.callIndex)_file_async_context, 1" -> println
}

isFilePathStatusCall call: typedIr.TypedIrNode -> Bool {
    (call.kind == 6 or call.kind == 9)
        and (call.opcode == -311 or call.opcode == -312)
}

writeFileScalarName request: WhileValueRequest -> Unit uses Console {
    request.whileIndex >= 0 -> if {
        "%while$(request.whileIndex)_v$(request.nodeIndex)" -> print
    } else { "%v$(request.nodeIndex)" -> print }
}

writeFileScalarArgument request: WhileValueRequest, pathIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[pathIndex] => path
    path.kind == 2 -> if {
        path -> sourceToken(context, state) => token
        Int(TextLiteralRequest { sourceModule: path.sourceModule, token: token } -> textLiteralLength(context, state)) => length
        "{ ptr @sollang_str_$pathIndex, i64 $length }" -> print
    } else {
        request.whileIndex >= 0 -> if {
            WhileValueRequest { whileIndex: request.whileIndex, ownerIndex: request.ownerIndex, nodeIndex: pathIndex } -> writeWhileValue(context, state)
        } else { pathIndex -> writeValue(request.ownerIndex, context, state) }
    }
}

# A negative whileIndex selects the ordinary SSA/operand context. Both paths
# lower the same canonical intrinsic and retain their own evaluated operands.
emitFilePathStatusCall request: WhileValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[request.nodeIndex] => call
    request.nodeIndex -> callArgumentIndex(context, state) -> aggregateValueIndex(context, state) => pathIndex
    "  " -> print
    request -> writeFileScalarName
    "_file_status_path_data = extractvalue %sollang.text " -> print
    request -> writeFileScalarArgument(pathIndex, context, state)
    ", 0" -> println
    "  " -> print
    request -> writeFileScalarName
    "_file_status_path_length = extractvalue %sollang.text " -> print
    request -> writeFileScalarArgument(pathIndex, context, state)
    ", 1" -> println
    "  " -> print
    request -> writeFileScalarName
    " = call i32 @sollang_platform_" -> print
    call.opcode == -311 -> if { "create_exclusive_file" -> print } else { "remove_file" -> print }
    "(ptr " -> print
    request -> writeFileScalarName
    "_file_status_path_data, i64 " -> print
    request -> writeFileScalarName
    "_file_status_path_length)" -> println
}

isFileScalarCall call: typedIr.TypedIrNode -> Bool {
    call -> isFilePathStatusCall or ((call.kind == 6 or call.kind == 9) and (call.opcode == -218 or call.opcode == -219))
}

emitFileScalarCall request: WhileValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[request.nodeIndex] -> isFilePathStatusCall
        -> if {
            request -> emitFilePathStatusCall(context, state)
        } else { request -> emitFileDurabilityCall(context, state) }
}

emitFileDurabilityCall request: WhileValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[request.nodeIndex] => call
    call.opcode == -218 -> if {
        request.nodeIndex -> callArgumentIndex(context, state) => writerIndex!
        writerIndex! -> aggregateValueIndex(context, state) => writerIndex!
        context.ir[writerIndex!] => writer
        "  " -> print
        request -> writeFileScalarName
        "_file_sync_handle = extractvalue " -> print
        writer -> writeIrType(context, state)
        " " -> print
        request -> writeFileScalarArgument(writerIndex!, context, state)
        ", 0" -> println
        "  " -> print
        request -> writeFileScalarName
        "_file_sync_raw = call i32 @sollang_platform_sync_owned_file(i64 " -> print
        request -> writeFileScalarName
        "_file_sync_handle)" -> println
        "  " -> print
        request -> writeFileScalarName
        " = icmp ne i32 " -> print
        request -> writeFileScalarName
        "_file_sync_raw, 0" -> println
    }
    call.opcode == -219 -> if {
        request.nodeIndex -> callArgumentIndex(context, state) => replaceIndex!
        replaceIndex! -> aggregateValueIndex(context, state) => replaceIndex!
        context.ir[replaceIndex!] => replace
        "  " -> print
        request -> writeFileScalarName
        "_file_temporary = extractvalue " -> print
        replace -> writeIrType(context, state)
        " " -> print
        request -> writeFileScalarArgument(replaceIndex!, context, state)
        ", 0" -> println
        "  " -> print
        request -> writeFileScalarName
        "_file_destination = extractvalue " -> print
        replace -> writeIrType(context, state)
        " " -> print
        request -> writeFileScalarArgument(replaceIndex!, context, state)
        ", 1" -> println
        "  " -> print
        request -> writeFileScalarName
        "_file_temporary_data = extractvalue %sollang.text " -> print
        request -> writeFileScalarName
        "_file_temporary, 0" -> println
        "  " -> print
        request -> writeFileScalarName
        "_file_temporary_length = extractvalue %sollang.text " -> print
        request -> writeFileScalarName
        "_file_temporary, 1" -> println
        "  " -> print
        request -> writeFileScalarName
        "_file_destination_data = extractvalue %sollang.text " -> print
        request -> writeFileScalarName
        "_file_destination, 0" -> println
        "  " -> print
        request -> writeFileScalarName
        "_file_destination_length = extractvalue %sollang.text " -> print
        request -> writeFileScalarName
        "_file_destination, 1" -> println
        "  " -> print
        request -> writeFileScalarName
        "_file_replace_raw = call i32 @sollang_platform_atomic_replace_file(ptr " -> print
        request -> writeFileScalarName
        "_file_temporary_data, i64 " -> print
        request -> writeFileScalarName
        "_file_temporary_length, ptr " -> print
        request -> writeFileScalarName
        "_file_destination_data, i64 " -> print
        request -> writeFileScalarName
        "_file_destination_length)" -> println
        "  " -> print
        request -> writeFileScalarName
        " = icmp ne i32 " -> print
        request -> writeFileScalarName
        "_file_replace_raw, 0" -> println
    }
}

emitFileCall request: FileCallRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[request.callIndex] => call
    call.opcode -> typedIr.isAsyncFileOpcode -> if {
        request -> emitAsyncFileScalarCall(context, state)
        return
    }
    (call.opcode == -316 or call.opcode == -317 or call.opcode == -318)
        and (context -> usesReachableAsyncFileRuntime(state))
        -> if { "  call void @sollang_file_wait_idle()" -> println }
    call.opcode == -313 or call.opcode == -316 -> if {
        request.callIndex -> callArgumentIndex(context, state) => pathIndex!
        pathIndex! -> aggregateValueIndex(context, state) => pathIndex!
        context.ir[pathIndex!] => path
        "  %v$(request.callIndex)_binary_path_data = extractvalue %sollang.text " -> print
        path.kind == 2 -> if {
            path -> sourceToken(context, state) => pathToken
            Int(TextLiteralRequest { sourceModule: path.sourceModule, token: pathToken } -> textLiteralLength(context, state)) => pathLength
            "{ ptr @sollang_str_" -> print
            pathIndex! -> writeDecimal
            ", i64 " -> print
            pathLength -> writeDecimal
            " }" -> print
        } else { pathIndex! -> writeValue(request.ownerIndex, context, state) }
        ", 0" -> println
        "  %v$(request.callIndex)_binary_path_length = extractvalue %sollang.text " -> print
        path.kind == 2 -> if {
            path -> sourceToken(context, state) => pathLengthToken
            Int(TextLiteralRequest { sourceModule: path.sourceModule, token: pathLengthToken } -> textLiteralLength(context, state)) => literalPathLength
            "{ ptr @sollang_str_" -> print
            pathIndex! -> writeDecimal
            ", i64 " -> print
            literalPathLength -> writeDecimal
            " }" -> print
        } else { pathIndex! -> writeValue(request.ownerIndex, context, state) }
        ", 1" -> println
        "  call void @sollang_binary_open_" -> print
        call.opcode == -313 -> if { "writer" -> print } else { "reader" -> print }
        "(ptr %v$(request.callIndex)_binary_path_data, i64 %v$(request.callIndex)_binary_path_length)" -> println
    }
    call.opcode == -315 or call.opcode == -318 -> if {
        "  call void @sollang_binary_close_" -> print
        call.opcode == -315 -> if { "writer" -> print } else { "reader" -> print }
        "()" -> println
    }
    call.opcode == -314 -> if {
        call.operand0 -> aggregateValueIndex(context, state) => scalarIndex
        context.ir[scalarIndex] => scalar
        scalar.typeId => scalarTypeId!
        scalarTypeId! < 0 -> if { scalar.typeSymbol => scalarTypeId! }
        context.typeSizes[scalarTypeId!] => scalarSize
        context.typeAligns[scalarTypeId!] => scalarAlign
        scalarTypeId! == 23 -> if {
            "  %v$(request.callIndex)_binary_bool = zext i1 " -> print
            scalarIndex -> writeValue(request.ownerIndex, context, state)
            " to i8" -> println
        }
        "  store " -> print
        scalarTypeId! == 23 -> if { "i8" -> print } else { scalarTypeId! -> writeSemanticTypeId(context, state) }
        " " -> print
        scalarTypeId! == 23 -> if { "%v$(request.callIndex)_binary_bool" -> print } else { scalarIndex -> writeValue(request.ownerIndex, context, state) }
        ", ptr %v$(request.callIndex)_file_write_slot, align $scalarAlign" -> println
        "  call void @sollang_binary_write(ptr %v$(request.callIndex)_file_write_slot, i64 $scalarSize)" -> println
    }
    call -> isFilePathStatusCall -> if {
        WhileValueRequest { whileIndex: -1, ownerIndex: request.ownerIndex, nodeIndex: request.callIndex } -> emitFilePathStatusCall(context, state)
        return
    }
    call.opcode == -304 -> if {
        call.operand0 -> emitMutableBorrowArgumentValues(request.callIndex, request.ownerIndex, 0, context, state)
    }
    call.opcode == -216 or call.opcode == -217 -> if {
        request.callIndex -> callArgumentIndex(context, state) => pathIndex!
        pathIndex! -> aggregateValueIndex(context, state) => pathIndex!
        context.ir[pathIndex!] => path
        "  %v$(request.callIndex)_file_path_data = extractvalue %sollang.text " -> print
        path.kind == 2 -> if {
            path -> sourceToken(context, state) => pathToken
            Int(TextLiteralRequest { sourceModule: path.sourceModule, token: pathToken } -> textLiteralLength(context, state)) => pathLength
            "{ ptr @sollang_str_" -> print
            pathIndex! -> writeDecimal
            ", i64 " -> print
            pathLength -> writeDecimal
            " }" -> print
        } else { pathIndex! -> writeValue(request.ownerIndex, context, state) }
        ", 0" -> println
        "  %v$(request.callIndex)_file_path_length = extractvalue %sollang.text " -> print
        path.kind == 2 -> if {
            path -> sourceToken(context, state) => pathLengthToken
            Int(TextLiteralRequest { sourceModule: path.sourceModule, token: pathLengthToken } -> textLiteralLength(context, state)) => literalPathLength
            "{ ptr @sollang_str_" -> print
            pathIndex! -> writeDecimal
            ", i64 " -> print
            literalPathLength -> writeDecimal
            " }" -> print
        } else { pathIndex! -> writeValue(request.ownerIndex, context, state) }
        ", 1" -> println
        "  %v$(request.callIndex)_file_open_raw = call %sollang.file_handle_result @sollang_platform_open_owned_" -> print
        call.opcode == -217 -> if { "write" -> print } else { "read" -> print }
        "_file(ptr %v$(request.callIndex)_file_path_data, i64 %v$(request.callIndex)_file_path_length)" -> println
        "  %v$(request.callIndex)_file_open_handle = extractvalue %sollang.file_handle_result %v$(request.callIndex)_file_open_raw, 0" -> println
        "  %v$(request.callIndex)_file_open_status = extractvalue %sollang.file_handle_result %v$(request.callIndex)_file_open_raw, 1" -> println
        "  %v$(request.callIndex)_file_open_ok = icmp ne i32 %v$(request.callIndex)_file_open_status, 0" -> println
        "  store " -> print
        call -> writeIrType(context, state)
        " zeroinitializer, ptr %v$(request.callIndex)_file_result_slot, align 8" -> println
        "  br i1 %v$(request.callIndex)_file_open_ok, label %file$(request.callIndex)_open_ok, label %file$(request.callIndex)_open_error" -> println
        "file$(request.callIndex)_open_ok:" -> println
        context.types[call.typeId].first => openedFileTypeId
        "  %v$(request.callIndex)_file_value = insertvalue " -> print
        openedFileTypeId -> writeSemanticTypeId(context, state)
        " poison, i64 %v$(request.callIndex)_file_open_handle, 0" -> println
        "  %v$(request.callIndex)_file_ok_tag = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_file_result_slot, i32 0, i32 0" -> println
        "  store i32 0, ptr %v$(request.callIndex)_file_ok_tag, align 4" -> println
        "  %v$(request.callIndex)_file_ok_payload = getelementptr inbounds " -> print
