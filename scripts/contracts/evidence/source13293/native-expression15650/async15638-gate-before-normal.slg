arrayChild: -> async [Int; ~] {
    yield
    [2, 3, 5; ~]
}

secondChild: -> async Int {
    yield
    yield
    yield
    1
}

gate: -> async Unit {
    yield
    yield
    yield
}

combine values: [Int; ~], extra: Int -> Int => (values -> len) + extra

parent: -> async Int uses Console {
    "parent-started" -> println
    arrayChild() => first
    secondChild() => second
    combine(first -> await, second -> await)
}

main {
    parent() => pending
    pending -> await => result
    "result=$result" -> println
}
