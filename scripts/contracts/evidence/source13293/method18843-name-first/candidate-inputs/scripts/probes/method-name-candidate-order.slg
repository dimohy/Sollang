struct Number { value: Int }
struct Other { value: Int }

trait FirstRead { read: self -> Int }
trait SecondRead { read: self -> Int }

impl Number {
    read: self -> Int => self.value
    readMore: self -> Int => 900
    reap: self -> Int => 901
}

impl Other {
    read: self -> Int => 999
}

impl FirstRead for Number {
    read: self -> Int => self.value + 10
}

impl SecondRead for Number {
    read: self -> Int => self.value + 20
}

main {
    Number { value: 10 } => number
    number -> read => inherent
    number -> FirstRead.read => first
    number -> SecondRead.read => second
    Other { value: 1 } -> read => other
    "$inherent,$first,$second,$other" -> println
}
