import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.expression_type_ids as expressionTypeIds
import sollang.compiler.ir.typed as typedIr
import sollang.compiler.semantic.diagnostics as semanticDiagnostics

main {
    """"
work<N> values: [Int; N] -> async Int where N: Int {
    values -> len
}

main {
    [1, 2] => values
    values -> work<2> => pending
    pending -> await -> println
}
    """" => source0
    [source0,; ~] -> semanticContext.prepare => prepared0
    prepared0 -> expressionTypeIds.resolveContext => resolved0!
    prepared0 -> typedIr.lowerResolvedContext(resolved0!) => ir0!
    ir0! -> typedIr.materializeGenericClosure(prepared0, resolved0!) => instances0
    prepared0 -> semanticDiagnostics.firstConcreteAsyncOwnedInputDiagnostic(resolved0!, ir0!, instances0) => diagnostic0
    "case0=$(diagnostic0.code)" -> println
    """"
work<N> value: Int, values: [Int; N] -> async Int where N: Int {
    values -> len
}

main {
