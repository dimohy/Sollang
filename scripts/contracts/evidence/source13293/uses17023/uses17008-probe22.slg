import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.storage_placement_source_index as sourceIndex
import sollang.compiler.semantic.storage_placement_units as sourceUnits
import sollang.compiler.semantic.storage_placement_uses as ownerUses
import sys.process as process

struct Query { label: Text, name: Text, line: Int, start: Int }

lineAt source: Text, offset: UIntSize -> Int {
    1 => line!
    UIntSize(0) => cursor!
    cursor! < offset -> while {
        (source -> byte(cursor!)) == '\n' -> if { line! + 1 => line! }
        cursor! + 1 => cursor!
    }
    line!
}

inspect label: Text, source: Text, queries: [Query] -> Unit uses Console, Process {
    [source,; ~] -> analysis.analyze => package
    package.ranges[0] => range
    range.astStart -> sourceIndex.build(range.astCount, package.nodes) -> when {
        Err(_) { process.exit(1) }
        Ok(indexed) { package -> sourceUnits.build(0, indexed) -> when {
                Err(_) { process.exit(2) }
                Ok(units) {
                    "case:$label" -> println
                    queries -> each query {
                        -1 => frame!
                        0 => astIndex!
                        astIndex! < range.astCount -> while {
                            package.nodes[range.astStart + astIndex!] => node
                            query.line == 0 and node.kind == 8 -> if { astIndex! => frame! }
                            query.line > 0 and (node.kind == 7 or node.kind == 31)
                                and (source -> lineAt(node.start)) == query.line
                                -> if {
                                    package.tokens[range.tokenStart + node.payloadToken].span => name
                                    (source -> slice(name.start, name.length)) == query.name
                                        -> if { astIndex! => frame! }
                                }
                            astIndex! + 1 => astIndex!
                        }
                        frame! < 0 -> if { process.exit(3) }
                        -1 => binding!
                        units.units -> each unit {
                            unit.frameAst == frame! and unit.position == query.start
                                and package.nodes[range.astStart + unit.astNode].kind == 9
                                -> if { unit.astNode => binding! }
                        }
                        binding! < 0 -> if { process.exit(4) }
                        binding! -> ownerUses.lastUse(source, package, 0, indexed, units) -> when {
                            Err(_) { process.exit(5) }
                            Ok(last) { "$(query.label)|$(query.start):$(last.position)" -> println }
                        }
                    }
                }
        } }
    }
}

main {
    """
    main {
        [1; 1025] => values
    }
    
    """ => source0
    "oversized-fixed" -> inspect(source0, [Query { label: "main", name: "", line: 0, start: 0 }])
    """
    main {
        [1, 2] => first
        [3; 4] => second
    }
    
    """ => source1
    "sequential-slot-growth" -> inspect(source1, [Query { label: "main", name: "", line: 0, start: 0 }, Query { label: "main", name: "", line: 0, start: 1 }])
    """
    main {
        [1; 512] => first
        [2; 512] => second
        [3; 1] => third
        first[0] => firstValue
        second[0] => secondValue
    }
    
    """ => source2
    "source-lifetimes-consume-budget" -> inspect(source2, [Query { label: "main", name: "", line: 0, start: 0 }, Query { label: "main", name: "", line: 0, start: 1 }, Query { label: "main", name: "", line: 0, start: 2 }])
    """
    main {
        [Int; ~] => values!
        1..3 -> each value {
            values! -> push(value)
        }
    }
    
    """ => source3
    "mutable-loop-owner-header" -> inspect(source3, [Query; ~])
    """
    main {
        [1, 2; ~] => values
        values -> capacity => allocated
        values[0] => first
    }
    
    """ => source4
    "readonly-dynamic-capacity" -> inspect(source4, [Query { label: "main", name: "", line: 0, start: 0 }])
    """
    main {
        { 1: 2 } => scores
        scores[1] => first
    }
    
    """ => source5
    "readonly-dictionary" -> inspect(source5, [Query { label: "main", name: "", line: 0, start: 0 }])
    """
    main {
        [1, 2; ~] => values
        values -> append(3) => grown
        grown -> capacity => allocated
    }
    
    """ => source6
    "owning-transform-rejects-promotion" -> inspect(source6, [Query; ~])
    """
    main {
        true -> if {
            [1, 2] => first
        } else {
            [3; 4] => second
        }
    }
    
    """ => source7
    "nested-branch-slot-reuse" -> inspect(source7, [Query { label: "main", name: "", line: 0, start: 0 }, Query { label: "main", name: "", line: 0, start: 1 }])
    """
    local: -> Int {
        [1, 2] => values
        values[0]
    }
    main {
        local() => first
    }
    
    """ => source8
    "ordinary-function-frame" -> inspect(source8, [Query { label: "function:local@1", name: "local", line: 1, start: 0 }])
    """
    take values: move [Int; ~] -> Int {
        values -> len
    }
    main {
        [1, 2; ~] => values
        values -> take => count
    }
    
    """ => source9
    "owned-input-rejects-promotion" -> inspect(source9, [Query; ~])
    """
    outer: -> Int {
        inner: -> Int {
            [1, 2] => values
            values[0]
        }
        [3; 3] => outerValues
        inner() + outerValues[0]
    }
    main {
        outer() => result
    }
    
    """ => source10
    "nested-function-frame-boundary" -> inspect(source10, [Query { label: "function:inner@2", name: "inner", line: 2, start: 0 }, Query { label: "function:outer@1", name: "outer", line: 1, start: 0 }])
    """
    combine left: Int, right: Int -> Int => left + right
    main {
        1 -> combine(true -> if {
            2 => first
            first
        } else {
            3 => second
            second
        }) => answer
    }
    
    """ => source11
    "additional-argument-nested-scopes" -> inspect(source11, [Query; ~])
    """
    main {
        2 -> when {
            == 1 => 10
            else => 20
        } => answer
    }
    
    """ => source12
    "inline-when-results" -> inspect(source12, [Query; ~])
    """
    main {
        1..3 -> fold 0 total, item {
            total + item => next
            next
        } => answer
    }
    
    """ => source13
    "fold-result-unit" -> inspect(source13, [Query; ~])
    """
    main {
        "value=$(true -> if { 2 } else { 3 })" -> println
    }
    
    """ => source14
    "interpolation-if-result-units" -> inspect(source14, [Query; ~])
    """
    # Result-producing block functions compose as ordinary pipeline stages.
    map value: Int -> Int block item: Int -> Int {
        value -> yield
    }
    
    filter value: Int -> Int block item: Int -> Bool {
        value -> yield => accepted
        accepted -> if { value } else { 0 }
    }
    
    tap value: Int -> Int block item: Int {
        value -> yield
        value
    }
    
    main {
        5
            -> map { it * 3 }
            -> tap { "tap=$it" -> println }
            -> filter { it > 10 }
            => result
    
        "result=$result" -> println
    }
    
    """ => source15
    "frozen-result-block-pipeline-source" -> inspect(source15, [Query; ~])
    """
    main {
        0 => counter!
        counter! < 1 -> while {
            counter! + 1 => counter!
        }
        counter! => answer
    }
    
    """ => source16
    "while-statement-and-reassignment" -> inspect(source16, [Query; ~])
    """
    main {
        2 -> when {
            == 1 {
                10 => one
                one
            }
            else {
                20 => other
                other
            }
        } => answer
    }
    
    """ => source17
    "block-when-results" -> inspect(source17, [Query; ~])
    """
    plus value: Int, delta: Int -> Int => value + delta
    map value: Int -> Int block item: Int -> Int {
        value -> yield
    }
    main {
        5
            -> plus(true -> if {
                2 => increment
                increment
            } else { 3 })
            -> map { it * 2 }
            => result
    }
    
    """ => source18
    "block-pipeline-additional-argument" -> inspect(source18, [Query; ~])
    """
    main {
        [1, 2] => values
        "$(values[0])" -> println
        [3; 4] => later
    }
    
    """ => source19
    "interpolated-owner-last-use" -> inspect(source19, [Query { label: "main", name: "", line: 0, start: 0 }, Query { label: "main", name: "", line: 0, start: 2 }])
    """
    main {
        [1, 2] => values
        true -> if {
            values[0] -> println
        } else {
            0 -> println
        }
        [3; 4] => later
    }
    
    """ => source20
    "nested-owner-containing-unit" -> inspect(source20, [Query { label: "main", name: "", line: 0, start: 0 }, Query { label: "main", name: "", line: 0, start: 4 }])
    """
    main {
        [1, 2] => values!
        3 => values![0]
        [4; 4] => later
    }
    
    """ => source21
    "mutable-owner-write-last-use" -> inspect(source21, [Query { label: "main", name: "", line: 0, start: 0 }, Query { label: "main", name: "", line: 0, start: 2 }])
}
