+
+public isBorrowedBlockInputBinding valueIr: Int, typed: ref [TypedIrNode; ~], sourceRanges: ref [analysis.SourceAnalysisRange; ~], declarations: ref [symbols.Symbol; ~] -> Bool {
+    valueIr < 0 or valueIr >= (typed -> len) -> if { false -> return }
+    typed[valueIr] => binding
+    binding.kind != 17 or not (binding.flags -> ast.readonlyInputFlags) or binding.symbol < 0
+        or binding.parent < 0 or binding.parent >= (typed -> len)
+        or binding.operand0 < 0 or binding.operand0 >= (typed -> len)
+        -> if { false -> return }
+    typed[binding.parent] => scope
+    scope.opcode != -227 or (scope.kind != 9 and scope.kind != 5 and scope.kind != 19)
+        -> if { false -> return }
+    # A materialized input argument is beside its alias in the same scope.
+    # A real local binding owns its value child and cannot match this shape.
+    typed[binding.operand0].parent != binding.parent
+        -> if { false -> return }
+    binding.sourceModule < 0 or binding.sourceModule >= (sourceRanges -> len)
+        -> if { false -> return }
+    sourceRanges[binding.sourceModule] => sourceRange
+    binding.symbol >= sourceRange.symbolCount -> if { false -> return }
+    declarations[sourceRange.symbolStart + binding.symbol] => role
+    role.kind == 35 and role.astNode == binding.astNode
 }
 
