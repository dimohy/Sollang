+# Inferred products keep their fields in the semantic field arena. Signature
+# products additionally have canonical field terms; retain that cross-check.
+appendResolvedProductDetails package: ref analysis.PackageAnalysis, owner: Int, count: Int, typeCount: Int, fields: ref [typeIds.NominalField; ~], words: mut [UInt64; ~] -> Bool {
+    0 => ownerFields!
+    fields -> each field { field.ownerType == owner -> if { ownerFields! + 1 => ownerFields! } }
+    ownerFields! != count -> if { false -> return }
+    words -> push(UInt64(count))
+    0..<count -> each ordinal {
+        -1 => selected!
+        0 => index!
+        fields -> each field {
+            field.ownerType == owner and field.ordinal == ordinal
+                -> if {
+                    selected! >= 0 -> if { false -> return }
+                    index! => selected!
+                }
+            index! + 1 => index!
+        }
+        selected! < 0 -> if { false -> return }
+        fields[selected!] => field
+        field.status != 0 or field.fieldType < 0 or field.fieldType >= typeCount
+            -> if { false -> return }
+        package -> appendLabel(field.sourceModule, field.labelToken, words)
+            -> unless { false -> return }
+        words -> push(UInt64(field.fieldType))
+    }
+    true
+}
