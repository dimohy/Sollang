struct OwnedKey {
    id: Int
    payload: box Int
}
trait Hash { hash: self -> Int }
trait Eq { eq: self -> Int }
impl Hash for OwnedKey { hash: self -> Int => self.id }
impl Eq for OwnedKey { eq: self -> Int => self.id }
main {
    {OwnedKey { id: 1, payload: box 10 }: 10, OwnedKey { id: 1, payload: box 20 }: 20; <=2} => values!
    OwnedKey { id: 1, payload: box 30 } => lookup
    values! -> len -> println
    values![lookup] -> println
    values! -> put(OwnedKey { id: 2, payload: box 40 }, 30)
    values! -> len -> println
}
