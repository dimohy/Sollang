+# Concrete move admission is a located signature error, including instances
+# whose IR signature has been replaced. Publish only the first source error.
+public firstInvalidMoveInputSignatureDiagnostic prepared: ref semanticContext.SemanticSnapshot, diagnostics: ref [OwnershipDiagnostic; ~] -> semanticDiagnostics.SignatureTypeDiagnostic {
+    -1 => selected!
+    0 => index!
+    index! < (diagnostics -> len) -> while {
+        diagnostics[index!] => candidate
+        candidate.code == 37 -> if {
+            selected! < 0 -> if { index! => selected! } else {
+                diagnostics[selected!] => previous
+                candidate.sourceModule < previous.sourceModule
+                    or (candidate.sourceModule == previous.sourceModule and candidate.span.start < previous.span.start)
+                    -> if { index! => selected! }
+            }
+        }
+        index! + 1 => index!
+    }
+    selected! < 0 -> if {
+        semanticDiagnostics.SignatureTypeDiagnostic { code: 0, sourceModule: -1, functionSymbol: -1, typeAst: -1, nameToken: -1, genericToken: -1 } -> return
+    }
+    diagnostics[selected!] => diagnostic
+    prepared.package.ranges[diagnostic.sourceModule] => range
+    # Code 37 captures an actual parameter declaration's AST span before
+    # inlining. Its source token remains stable when IR nodes are replaced.
+    0 => tokenIndex!
+    tokenIndex! < range.tokenCount and prepared.package.tokens[range.tokenStart + tokenIndex!].span.start < diagnostic.span.start
+        -> while { tokenIndex! + 1 => tokenIndex! }
+    semanticDiagnostics.SignatureTypeDiagnostic { code: 24, sourceModule: diagnostic.sourceModule, functionSymbol: diagnostic.functionSymbol, typeAst: -1, nameToken: tokenIndex!, genericToken: -1 }
+}
