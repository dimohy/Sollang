enum Error { InvalidSourceDomain }

guard value: Int -> Result<Int, Error> {
    value < 0 or value > 10
        -> if { Error.InvalidSourceDomain -> Result<Int, Error>.Err -> return }
    value == 0
        -> if { Error.InvalidSourceDomain -> Result<Int, Error>.Err -> return }
    value -> Result<Int, Error>.Ok
}

main {
    7 -> guard -> when {
        Err(error) { 0 -> println }
        Ok(value) { value -> println }
    }
}
