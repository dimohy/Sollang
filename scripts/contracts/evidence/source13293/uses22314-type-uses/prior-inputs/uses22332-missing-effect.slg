namespace cache.prepared_registry

struct Used { value: Int }
struct Empty { }
struct Other { flag: Bool }
enum Unused { First, Second }
trait Value { get: self -> Int }
public inspect value: ref Used, boxed: box Int, fixed: [Int; 3], growable: [Int; ~], mapped: {Int: Bool}, dynamic: dyn Value -> Unit { }
decorate<T> value: T -> (cacheBodyValue: T, cacheBodyCount: Int) {
    (cacheBodyValue: value, cacheBodyCount: 1)
}

neverInstantiated<T>: -> Unit {
    (templateOnlyValue: UInt8(3), templateOnlyCount: 2) => value
    value.templateOnlyValue -> println
}

ordinaryUncalled: -> Unit {
    (ordinaryBodyValue: UInt8(4), ordinaryBodyCount: 3) => value
    value.ordinaryBodyValue -> println
}

main {
    UInt8(7) -> decorate => result
    result.cacheBodyValue -> println
}
