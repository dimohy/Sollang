  %previous = load i1, ptr %ok_state, align 1
  %next_ok = and i1 %previous, %ok
  store i1 %next_ok, ptr %ok_state, align 1
  ret i1 %ok
}
define internal void @sollang_runtime_print(ptr %stdout, ptr %written, ptr %ok_state, ptr %data, i64 %len, i1 %newline) {
