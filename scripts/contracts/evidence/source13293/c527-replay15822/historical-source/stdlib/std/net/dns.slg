namespace std.net.dns

import std.net as net

# Resolver is a small policy value. It owns no socket and adds no wrapper call:
# lookup lowers directly to the platform name resolver intrinsic.
public enum AddressFamily {
    Any
    Ipv4Only
    Ipv6Only
}

public enum ErrorKind {
    InvalidLimit
    InvalidHost
    HostTooLong
    NotFound
    TemporaryFailure
    FamilyUnavailable
    ResultLimitExceeded
    Unsupported
    System
}

public struct Error {
    public kind: ErrorKind
    public code: Int32
}

public struct Resolver {
    public family: AddressFamily
    public maxResults: UIntSize
    public maxHostBytes: UIntSize
}

# Limits are part of the value rather than ambient runtime configuration.
# Host names follow the DNS presentation limit. IDNA conversion is deliberately
# not implicit; a future pure std.idna layer may prepare an ASCII host name.
public resolver family: AddressFamily, maxResults: UIntSize, maxHostBytes: UIntSize -> Resolver => Resolver {
    family: family
    maxResults: maxResults
    maxHostBytes: maxHostBytes
}

# Resolver.lookup's direct platform binding lives in sys/runtime/dns.slg.
