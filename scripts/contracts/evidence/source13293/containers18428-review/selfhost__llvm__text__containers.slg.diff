-emitArrayReserve request: WhileValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
+# Same bit spreading and minimum as the managed reserve capacity helpers.
+emitReservePowerOfTwo prefix: Text, value: Text -> Unit uses Console {
+    "  %$(prefix)_positive = icmp ugt i64 $value, 0" -> println
+    "  %$(prefix)_at_least_one = select i1 %$(prefix)_positive, i64 $value, i64 1" -> println
+    "  %$(prefix)_spread0 = sub i64 %$(prefix)_at_least_one, 1" -> println
+    0 => stage!
+    [1, 2, 4, 8, 16, 32] -> each shift {
+        "  %$(prefix)_shifted$(stage!) = lshr i64 %$(prefix)_spread$(stage!), $shift" -> println
+        "  %$(prefix)_spread$(stage! + 1) = or i64 %$(prefix)_spread$(stage!), %$(prefix)_shifted$(stage!)" -> println
+        stage! + 1 => stage!
+    }
+    "  %$(prefix)_power = add i64 %$(prefix)_spread6, 1" -> println
+}
+
+emitDequeReserve request: WhileValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
+    request.nodeIndex => index
+    context.ir[index] => call
+    context.ir[call.operand0] => receiver
+    context.types -> typeIds.materializedReadTypeId(receiver.typeId) => collectionTypeId
+    context.types[collectionTypeId].first => elementTypeId
+    context.typeSizes[elementTypeId] => elementSize
+    context.typeAligns[elementTypeId] => elementAlign
+    call.operand0 -> mutableStorageRoot(context, state) => root
+    call.operand0 -> mutableBorrowParameterOrdinal(request.ownerIndex, context, state) => borrow
+    Arena(0) => names!
+    "reserve$(index)_deque" -> materialize(names!) => prefix
+    "$(prefix)_round" -> emitReservePowerOfTwo("%reserve$(index)_requested")
+    borrow >= 0 -> if {
+        "  %$(prefix)_data = load ptr, ptr " -> print
+        borrow == 0 -> if { "%arg_mut_ptr_addr" -> print } else { "%arg$(borrow)_mut_ptr_addr" -> print }
+        ", align 8" -> println
+        "  %$(prefix)_length = load i64, ptr " -> print
+        borrow == 0 -> if { "%arg_mut_len_addr" -> print } else { "%arg$(borrow)_mut_len_addr" -> print }
+        ", align 8" -> println
+        "  %$(prefix)_capacity = load i64, ptr " -> print
+        borrow == 0 -> if { "%arg_mut_capacity_addr" -> print } else { "%arg$(borrow)_mut_capacity_addr" -> print }
+        ", align 8" -> println
+    } else {
+        "  %$(prefix)_owner = load %sollang.array.i32, ptr %slot$(root), align 8" -> println
+        "  %$(prefix)_data = extractvalue %sollang.array.i32 %$(prefix)_owner, 0" -> println
+        "  %$(prefix)_length = extractvalue %sollang.array.i32 %$(prefix)_owner, 1" -> println
+        "  %$(prefix)_capacity = extractvalue %sollang.array.i32 %$(prefix)_owner, 2" -> println
+    }
+    "  %$(prefix)_grow = icmp ugt i64 %$(prefix)_round_power, %$(prefix)_capacity" -> println
+    "  br i1 %$(prefix)_grow, label %$(prefix)_allocate, label %$(prefix)_keep" -> println
+    "$(prefix)_allocate:" -> println
+    "  %$(prefix)_payload_bytes = mul i64 %$(prefix)_round_power, $elementSize" -> println
+    "  %$(prefix)_bytes = add i64 %$(prefix)_payload_bytes, 8" -> println
+    "  %$(prefix)_allocated = call ptr @sollang_alloc(i64 %$(prefix)_bytes)" -> println
+    prefix -> emitAllocationGuard("_allocated", request.ownerIndex, context, state)
+    "  store i64 0, ptr %$(prefix)_allocated, align 8" -> println
+    "  %$(prefix)_head = load i64, ptr %$(prefix)_data, align 8" -> println
+    "  %$(prefix)_old_payload = getelementptr i8, ptr %$(prefix)_data, i64 8" -> println
+    "  %$(prefix)_new_payload = getelementptr i8, ptr %$(prefix)_allocated, i64 8" -> println
+    "  %$(prefix)_old_mask = sub i64 %$(prefix)_capacity, 1" -> println
+    "  br label %$(prefix)_copy" -> println
+    "$(prefix)_copy:" -> println
+    "  %$(prefix)_index = phi i64 [ 0, %$(prefix)_allocation_ready ], [ %$(prefix)_next, %$(prefix)_copy_body ]" -> println
+    "  %$(prefix)_active = icmp ult i64 %$(prefix)_index, %$(prefix)_length" -> println
+    "  br i1 %$(prefix)_active, label %$(prefix)_copy_body, label %$(prefix)_copied" -> println
+    "$(prefix)_copy_body:" -> println
+    "  %$(prefix)_unwrapped = add i64 %$(prefix)_head, %$(prefix)_index" -> println
+    "  %$(prefix)_physical = and i64 %$(prefix)_unwrapped, %$(prefix)_old_mask" -> println
+    "  %$(prefix)_source = getelementptr " -> print
+    elementTypeId -> writeSemanticTypeId(context, state)
+    ", ptr %$(prefix)_old_payload, i64 %$(prefix)_physical" -> println
+    "  %$(prefix)_item = load " -> print
+    elementTypeId -> writeSemanticTypeId(context, state)
+    ", ptr %$(prefix)_source, align $elementAlign" -> println
+    "  %$(prefix)_target = getelementptr " -> print
+    elementTypeId -> writeSemanticTypeId(context, state)
+    ", ptr %$(prefix)_new_payload, i64 %$(prefix)_index" -> println
+    "  store " -> print
+    elementTypeId -> writeSemanticTypeId(context, state)
+    " %$(prefix)_item, ptr %$(prefix)_target, align $elementAlign" -> println
+    "  %$(prefix)_next = add i64 %$(prefix)_index, 1" -> println
+    "  br label %$(prefix)_copy" -> println
+    "$(prefix)_copied:" -> println
+    "  call void @sollang_free(ptr %$(prefix)_data)" -> println
+    "  br label %$(prefix)_done" -> println
+    "$(prefix)_keep:" -> println
+    "  br label %$(prefix)_done" -> println
+    "$(prefix)_done:" -> println
+    "  %$(prefix)_final_data = phi ptr [ %$(prefix)_allocated, %$(prefix)_copied ], [ %$(prefix)_data, %$(prefix)_keep ]" -> println
+    "  %$(prefix)_final_capacity = phi i64 [ %$(prefix)_round_power, %$(prefix)_copied ], [ %$(prefix)_capacity, %$(prefix)_keep ]" -> println
+    borrow >= 0 -> if {
+        "  store ptr %$(prefix)_final_data, ptr " -> print
+        borrow == 0 -> if { "%arg_mut_ptr_addr" -> print } else { "%arg$(borrow)_mut_ptr_addr" -> print }
+        ", align 8" -> println
+        "  store i64 %$(prefix)_final_capacity, ptr " -> print
+        borrow == 0 -> if { "%arg_mut_capacity_addr" -> print } else { "%arg$(borrow)_mut_capacity_addr" -> print }
+        ", align 8" -> println
+    } else {
+        "  %$(prefix)_result0 = insertvalue %sollang.array.i32 poison, ptr %$(prefix)_final_data, 0" -> println
+        "  %$(prefix)_result1 = insertvalue %sollang.array.i32 %$(prefix)_result0, i64 %$(prefix)_length, 1" -> println
+        "  %$(prefix)_result2 = insertvalue %sollang.array.i32 %$(prefix)_result1, i64 %$(prefix)_final_capacity, 2" -> println
+        "  store %sollang.array.i32 %$(prefix)_result2, ptr %slot$(root), align 8" -> println
+    }
+}
