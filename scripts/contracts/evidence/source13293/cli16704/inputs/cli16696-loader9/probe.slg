import sollang.compiler.cli_sources as sources
import sys.path as path
import sys.text as text
import sys.process as process

verifyCase label: Text, roots: ref [Text; ~], expectedStatus: Int, expectedDiagnostic: Text, expectedPaths: ref [Text; ~] -> Bool uses Console, File {
    Arena(0) => storage!
    roots -> sources.loadFilesForTarget("windows-x64", path.Style.Windows, storage!) => result
    result.status == expectedStatus and (result.sources -> len) == (expectedPaths -> len) => valid!
    (expectedDiagnostic -> len) > 0 -> if {
        result.diagnostic -> text.contains(expectedDiagnostic)
            -> unless { false => valid! }
    } else {
        (result.diagnostic -> len) != 0 -> if { false => valid! }
    }
    result.status == 0 -> if {
        0 => index!
        index! < (expectedPaths -> len) and index! < (result.sources -> len)
            -> while {
                (result.sources[index!] -> pathText) != expectedPaths[index!]
                    -> if { false => valid! }
                index! + 1 => index!
            }
    }
    "$label=$(valid!)" -> println
    not valid! -> if {
        "status=$(result.status) count=$(result.sources -> len) diagnostic=$(result.diagnostic)" -> println
    }
    valid!
}

