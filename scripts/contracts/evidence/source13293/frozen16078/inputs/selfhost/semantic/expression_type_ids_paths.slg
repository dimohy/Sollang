        resolveContextualRecordTypes(prepared, types, fields, expressions, expressionIndexByAst, flowSourceByAst, contextualRecords, firstFieldByOwnerType!, nextFieldByField!, bindingValues, mutableOwners, references, expectedContextByAst)
            -> if { true => pathChanged! }
        0 => intrinsicSource!
