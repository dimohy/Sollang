        }

    # Field lookup is keyed by its canonical owner type. Preserve declaration
    # order within each owner while avoiding a complete field-table scan for
    # every member token on every fixed-point iteration.
    [Int; ~] => firstFieldByOwnerType!
    [Int; ~] => lastFieldByOwnerType!
    [Int; ~] => nextFieldByField!
    synchronizeFieldIndex(types, fields, firstFieldByOwnerType!, lastFieldByOwnerType!, nextFieldByField!)

    # A flow's source is its direct child at the same source start. Resolve
    # intrinsic results from that source before selecting a branch's final
    # expression; an intrinsic argument is not the flow's result.
    prepared.package -> semanticContext.indexFlowSourcesByAst => flowSourceByAst
    prepared.package -> indexContextualRecords => contextualRecords
    prepared.package -> indexUserBlockResultRoots => userBlockResultRoots

