                                -1 => inferredReturnExpression!
                                UIntSize(0) => inferredReturnTopLevelStart!
                                UIntSize(0) => inferredReturnValueStart!
                                1000000 => inferredReturnDistance!
                                returnFirstExpressionBySource![inferredReturnCall.targetSourceModule] => inferredReturnSearch!
                                inferredReturnSearch! >= 0 -> while {
                                    expressions[inferredReturnSearch!] => inferredReturnCandidate
                                    inferredReturnCandidate.status == 0 and inferredReturnCandidate.sourceModule == inferredReturnCall.targetSourceModule
                                        -> if {
                                            prepared.package.nodes[inferredReturnTargetRange.astStart + inferredReturnCandidate.astNode].parent => inferredReturnAncestor!
                                            inferredReturnCandidate.astNode => inferredReturnRootAst!
                                            1 => inferredReturnCandidateDistance!
                                            false => inferredReturnBelongs!
                                            false => inferredReturnNested!
