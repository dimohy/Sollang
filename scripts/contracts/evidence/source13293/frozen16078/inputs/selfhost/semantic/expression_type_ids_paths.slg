inferredBodyIsStatement kind: Int -> Bool {
    kind == 7 or kind == 9 or kind == 31
        or kind == 45 or kind == 46 or kind == 47
        or kind == 48 or kind == 53 or kind == 54
        or kind == 61 or kind == 62 or kind == 84
}

# A signature's result is its final direct value, not a nested argument or
# binding initializer. No body value gives the ordinary Unit contract.
# Keep expression bodies distinct from the expression-statement AST flag.
public indexInferredFunctionBodyValues prepared: ref semanticContext.SemanticSnapshot -> [Int; ~] {
    [Int; ~] => values!
    prepared.package.nodes -> each node { values! -> push(-1) }
    prepared.package.ranges -> each range {
        0 => astIndex!
        astIndex! < range.astCount -> while {
            prepared.package.nodes[range.astStart + astIndex!] => node
            node.parent >= 0 and node.kind != 16 and node.kind != 17
                and node.kind != 52 and node.kind != 60
                -> if {
                    range.astStart + node.parent => parentGlobal
                    prepared.package.nodes[parentGlobal] => parent
                    parent.kind == 7 or parent.kind == 31 -> if {
                        values![parentGlobal] => previous
                        previous < 0 or node.start >= prepared.package.nodes[range.astStart + previous].start
                            -> if { astIndex! => values![parentGlobal] }
                    }
                }
            astIndex! + 1 => astIndex!
        }
        0 => functionAst!
        functionAst! < range.astCount -> while {
            range.astStart + functionAst! => functionGlobal
            values![functionGlobal] => bodyAst
            bodyAst >= 0 -> if {
                prepared.package.nodes[range.astStart + bodyAst] => body
                body.kind != 47 and (body.kind -> inferredBodyIsStatement)
                    -> if { -1 => values![functionGlobal] }
            }
            functionAst! + 1 => functionAst!
        }
    }
    values!
}

# Resolve member, index, stream, branch, and late container paths as one
# deterministic fixed-point pass. Mutable arenas are borrowed directly;
# this phase adds no heap state wrapper or generated-program runtime work.
# A block result belongs to its final outer expression, never to an argument
# nested inside that expression. Index source roots before type fixed points.
indexUserBlockResultRoots package: ref analysis.PackageAnalysis -> [Int; ~] {
    [Int; ~] => roots!
    package.nodes -> each nodeSlot { roots! -> push(-1) }
    package.ranges -> each range {
        0 => index!
        index! < range.astCount -> while {
            package.nodes[range.astStart + index!] => node
            node.parent >= 0 and node.kind != 16 and node.kind != 12
                -> if {
                    package.nodes[range.astStart + node.parent] => parent
                    parent.kind == 48 and parent.tertiaryToken >= 0
                        and node.start >= package.tokens[range.tokenStart + parent.tertiaryToken].span.start
                        -> if {
                            range.astStart + node.parent => owner
                            roots![owner] => previous
                            previous < 0 or node.start > package.nodes[previous].start
                                -> if {
                                    range.astStart + index! => roots![owner]
                                }
                        }
                }
            index! + 1 => index!
        }
    }
    roots!
}

resolveUserBlockResultTypes prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], references: [typeIds.TypeReference], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: ref [Int; ~], roots: ref [Int; ~] -> Bool {
    false => changed!
    prepared.calls -> each call {
        call.status == 0 and call.targetSourceModule >= 0
            -> if {
                prepared.package.ranges[call.sourceModule] => caller
                prepared.package.ranges[call.targetSourceModule] => target
                prepared.package.symbols[target.symbolStart + call.functionSymbol] => function
                caller.astStart + call.callAst => globalCall
                expressionIndexByAst[globalCall] => resultIndex
                roots[globalCall] => root
                function.blockTypeNode >= 0 and function.blockResultTypeNode >= 0
                    and resultIndex >= 0 and root >= 0 -> if {
                        expressions[resultIndex] => result!
                        expressionIndexByAst[root] => callbackIndex
                        result!.typeId >= 0 and types[result!.typeId].containsParameter
                            and callbackIndex >= 0 -> if {
                                expressions[callbackIndex] => callback
                                callback.status == 0 and callback.typeId >= 0
                                    and not types[callback.typeId].containsParameter
                                    -> if {
                                        references -> each formal {
                                            formal.sourceModule == call.targetSourceModule
                                                and formal.typeAst == function.blockResultTypeNode
                                                and formal.status == 0 -> if {
                                                    types -> typeIds.specializeInto(formal.typeId, callback.typeId, result!.typeId) => specialized
                                                    specialized.status == 0 and specialized.root != result!.typeId
                                                        -> if {
                                                            specialized.root => result!.typeId
                                                            0 => result!.status
                                                            result! => expressions[resultIndex]
                                                            true => changed!
                                                        }
                                                }
                                        }
                                    }
                            }
                    }
            }
    }
    changed!
}

public continuationFlags package: ref analysis.PackageAnalysis -> [Bool; ~] {
    [Bool; ~] => reaches!
    [Int; ~] => pending!
    [Int; ~] => sourceByAst!
    0 => sourceIndex!
    sourceIndex! < (package.ranges -> len) -> while {
        package.ranges[sourceIndex!] => range
        0 => astIndex!
        astIndex! < range.astCount -> while {
            package.nodes[range.astStart + astIndex!] => node
            node.kind != 47 => mayReach
            reaches! -> push(mayReach)
            sourceByAst! -> push(sourceIndex!)
            not mayReach -> if { pending! -> push(range.astStart + astIndex!) }
            astIndex! + 1 => astIndex!
        }
        sourceIndex! + 1 => sourceIndex!
    }
    0 => nextPending!
    nextPending! < (pending! -> len) -> while {
        pending![nextPending!] => childGlobalAst
        sourceByAst![childGlobalAst] => source
        package.ranges[source] => range
        package.nodes[childGlobalAst].parent => parentAst
        parentAst >= 0 -> if {
            range.astStart + parentAst => parentGlobalAst
            reaches![parentGlobalAst] -> if {
                package.nodes[parentGlobalAst] => parent
                true => parentMayReach!
                parent.kind == 42 -> if {
                    false => parentMayReach!
                    0 => branchCount!
                    0 => branchAst!
                    branchAst! < range.astCount -> while {
                        package.nodes[range.astStart + branchAst!] => branch
                        branch.kind == 43 and branch.parent == parentAst
                            -> if {
                                branchCount! + 1 => branchCount!
                                reaches![range.astStart + branchAst!] -> if { true => parentMayReach! }
                            }
                        branchAst! + 1 => branchAst!
                    }
                    branchCount! < 2 -> if { true => parentMayReach! }
                }
                parent.kind == 56 or parent.kind == 57 -> if {
                    false => parentMayReach!
                    0 => armCount!
                    0 => armAst!
                    armAst! < range.astCount -> while {
                        package.nodes[range.astStart + armAst!] => arm
                        (arm.kind == 58 or arm.kind == 43) and arm.parent == parentAst
                            -> if {
                                armCount! + 1 => armCount!
                                reaches![range.astStart + armAst!] -> if { true => parentMayReach! }
                            }
                        armAst! + 1 => armAst!
                    }
                    armCount! == 0 -> if { true => parentMayReach! }
                }
                parent.kind == 43 or parent.kind == 10 or parent.kind == 9 or parent.kind == 58
                    -> if {
                        0 => siblingAst!
                        siblingAst! < range.astCount -> while {
                            package.nodes[range.astStart + siblingAst!] => sibling
                            sibling.parent == parentAst and not reaches![range.astStart + siblingAst!]
                                -> if { false => parentMayReach! }
                            siblingAst! + 1 => siblingAst!
                        }
                    }
                not parentMayReach! -> if {
                    false => reaches![parentGlobalAst]
                    pending! -> push(parentGlobalAst)
                }
            }
        }
        nextPending! + 1 => nextPending!
    }
    reaches!
}

public struct WhenResultContract {
    public typeId: Int
    public continuingArms: Int
    public complete: Bool
}

# One result contract serves both value publication and private signature
# admission. Provisional expression types never establish arm agreement.
public whenResultContract package: ref analysis.PackageAnalysis, expressions: ref [ExpressionTypeId; ~], expressionIndexByAst: ref [Int; ~], continuationByAst: ref [Bool; ~], unitTypeId: Int, sourceIndex: Int, whenAst: Int -> WhenResultContract {
    package.ranges[sourceIndex] => range
    -1 => joinedType!
    0 => continuingArms!
    0 => armCount!
    true => allArmsTyped!
    0 => armAst!
    armAst! < range.astCount -> while {
        package.nodes[range.astStart + armAst!] => arm
        (arm.kind == 58 or arm.kind == 43) and arm.parent == whenAst
            -> if {
                armCount! + 1 => armCount!
                arm.kind == 43 -> if { armAst! } else { -1 } => bodyAst!
                0 => bodySearch!
                bodySearch! < range.astCount -> while {
                    package.nodes[range.astStart + bodySearch!] => candidateBody
                    candidateBody.kind == 43
                        and candidateBody.parent == armAst!
                        -> if {
                            bodySearch! => bodyAst!
                        }
                    bodySearch! + 1 => bodySearch!
                }
                # Expression arms store their result directly under the
                # arm, alongside the pattern. Block arms own a body node.
                bodyAst! < 0 -> if { armAst! => bodyAst! }
                -1 => valueAst!
                UIntSize(0) => valueStart!
                0 => valueSearch!
                valueSearch! < range.astCount -> while {
                    package.nodes[range.astStart + valueSearch!] => candidateValue
                    candidateValue.parent == bodyAst!
                        and (valueAst! < 0 or candidateValue.start >= valueStart!)
                        -> if {
                            valueSearch! => valueAst!
                            candidateValue.start => valueStart!
                        }
                    valueSearch! + 1 => valueSearch!
                }
                bodyAst! < 0 -> if { false => allArmsTyped! } else {
                    continuationByAst[range.astStart + bodyAst!] -> if {
                        continuingArms! + 1 => continuingArms!
                        -1 => armType!
                        valueAst! < 0 -> if { unitTypeId => armType! } else {
                            package.nodes[range.astStart + valueAst!] => valueNode
                            valueNode.kind -> inferredBodyIsStatement -> if {
                                unitTypeId => armType!
                            } else {
                                expressionIndexByAst[range.astStart + valueAst!] => valueExpression
                                valueExpression >= 0 -> if {
                                    expressions[valueExpression] => valueType
                                    valueType.status == 0 -> if { valueType.typeId => armType! }
                                }
                            }
                        }
                        armType! < 0 -> if { false => allArmsTyped! } else {
                            joinedType! < 0 -> if { armType! => joinedType! } else {
                                armType! != joinedType! -> if { false => allArmsTyped! }
                            }
                        }
                    }
                }
            }
        armAst! + 1 => armAst!
    }
    WhenResultContract { typeId: joinedType!, continuingArms: continuingArms!, complete: armCount! > 0 and allArmsTyped! and joinedType! >= 0 }
}

# A following callee owns the flow result. Same-span wrappers may retain
# the terminal selection without becoming a distinct result producer.
public terminalWhenAst package: ref analysis.PackageAnalysis, sourceIndex: Int, bodyAst: Int -> Int {
    package.ranges[sourceIndex] => range
    bodyAst => current!
    current! >= 0 -> while {
        package.nodes[range.astStart + current!] => body
        body.kind == 56 or body.kind == 57 -> if { current! -> return }
        body.kind != 10 and body.kind != 36 -> if { -1 -> return }
        -1 => wrapped!
        0 => child!
        child! < range.astCount -> while {
            package.nodes[range.astStart + child!] => candidate
            candidate.parent == current! and candidate.start + candidate.length == body.start + body.length
                -> if {
                    candidate.kind == 56 or candidate.kind == 57 -> if { child! -> return }
                    candidate.start == body.start and (candidate.kind == 10 or candidate.kind == 36)
                        -> if { child! => wrapped! }
                }
            child! + 1 => child!
        }
        wrapped! => current!
    }
    -1
}

resolveWhenResultTypes package: ref analysis.PackageAnalysis, expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~], continuationByAst: ref [Bool; ~], unitTypeId: Int -> Bool {
    false => changed!
    0 => sourceIndex!
    sourceIndex! < (package.ranges -> len) -> while {
        package.ranges[sourceIndex!] => range
        0 => whenAst!
        whenAst! < range.astCount -> while {
            package.nodes[range.astStart + whenAst!] => selection
            selection.kind == 56 or selection.kind == 57 -> if {
                package -> whenResultContract(expressions, expressionIndexByAst, continuationByAst, unitTypeId, sourceIndex!, whenAst!) => contract
                contract.typeId => joinedType
                contract.complete
                    -> if {
                        range.astStart + whenAst! => whenGlobalAst
                        expressionIndexByAst[whenGlobalAst] => existingIndex!
                        existingIndex! < 0 -> if {
                            expressions -> len => existingIndex!
                            expressions -> push(ExpressionTypeId {
                                sourceModule: sourceIndex!
                                astNode: whenAst!
                                typeId: joinedType
                                status: 0
                            })
                            existingIndex! => expressionIndexByAst[whenGlobalAst]
                            true => changed!
                        } else {
                            expressions[existingIndex!] => existing!
                            existing!.typeId != joinedType -> if {
                                joinedType => existing!.typeId
                                0 => existing!.status
                                existing! => expressions[existingIndex!]
                                true => changed!
                            }
                        }
                        # Only a terminal selection supplies the enclosing flow's
                        # result. A following callee owns its own return type.
                        selection.parent >= 0 and selection.parent < range.astCount
                            and package.nodes[range.astStart + selection.parent].kind == 10
                            and selection.start + selection.length == package.nodes[range.astStart + selection.parent].start + package.nodes[range.astStart + selection.parent].length
                            -> if {
                                range.astStart + selection.parent => flowGlobalAst
                                expressionIndexByAst[flowGlobalAst] => flowExpression!
                                flowExpression! < 0 -> if {
                                    expressions -> len => flowExpression!
                                    expressions -> push(ExpressionTypeId {
                                        sourceModule: sourceIndex!
                                        astNode: selection.parent
                                        typeId: joinedType
                                        status: 0
                                    })
                                    flowExpression! => expressionIndexByAst[flowGlobalAst]
                                    true => changed!
                                } else {
                                    expressions[flowExpression!] => existingFlow!
                                    existingFlow!.typeId != joinedType or existingFlow!.status != 0
                                        -> if {
                                            joinedType => existingFlow!.typeId
                                            0 => existingFlow!.status
                                            existingFlow! => expressions[flowExpression!]
                                            true => changed!
                                        }
                                }
                            }
                    }
            }
            whenAst! + 1 => whenAst!
        }
        sourceIndex! + 1 => sourceIndex!
    }
    changed!
}

# -2 means an unknown variant or unresolved payload; -1 is a known payload-free variant.
public patternPayloadTypeId sourceIndex: Int, subjectType: typeIds.SemanticType, variant: syntax.SyntaxToken, prepared: ref semanticContext.SemanticSnapshot -> Int {
    -2 => payloadType!
    prepared.package.sources[sourceIndex] -> len => sourceLength
    prepared.package.sources[sourceIndex] -> slice(UIntSize(0), sourceLength) => source
    subjectType.kind == 7 and subjectType.origin == 4
        -> if {
            subjectType.symbol == 0 and variant.span.length == 4
                and (source -> byte(variant.span.start)) == 78
                and (source -> byte(variant.span.start + 1)) == 111
                and (source -> byte(variant.span.start + 2)) == 110
                and (source -> byte(variant.span.start + 3)) == 101
                -> if { -1 => payloadType! }
            subjectType.symbol == 0 and variant.span.length == 4
                and (source -> byte(variant.span.start)) == 83
                and (source -> byte(variant.span.start + 1)) == 111
                and (source -> byte(variant.span.start + 2)) == 109
                and (source -> byte(variant.span.start + 3)) == 101
                -> if { subjectType.first => payloadType! }
            subjectType.symbol == 1 and variant.span.length == 2
                and (source -> byte(variant.span.start)) == 79
                and (source -> byte(variant.span.start + 1)) == 107
                -> if { subjectType.first => payloadType! }
            subjectType.symbol == 1 and variant.span.length == 3
                and (source -> byte(variant.span.start)) == 69
                and (source -> byte(variant.span.start + 1)) == 114
                and (source -> byte(variant.span.start + 2)) == 114
                -> if { subjectType.second => payloadType! }
        }
    subjectType.kind == 1 and (subjectType.origin == 0 or subjectType.origin == 2)
        -> if {
            subjectType.module => ownerSource!
            subjectType.origin == 2 and ownerSource! >= 0 and ownerSource! < (prepared.modules -> len)
                -> if { prepared.modules[ownerSource!].sourceIndex => ownerSource! }
            ownerSource! >= 0 and ownerSource! < (prepared.package.ranges -> len)
                -> if {
                    prepared.package.ranges[ownerSource!] => ownerRange
                    prepared.package.sources[ownerSource!] -> len => ownerLength
                    prepared.package.sources[ownerSource!] -> slice(UIntSize(0), ownerLength) => ownerText
                    0 => variantIndex!
                    variantIndex! < ownerRange.symbolCount and payloadType! == -2
                        -> while {
                            prepared.package.symbols[ownerRange.symbolStart + variantIndex!] => candidate
                            candidate.kind == 27 and candidate.parent == subjectType.symbol
                                and candidate.nameToken >= 0
                                -> if {
                                    prepared.package.tokens[ownerRange.tokenStart + candidate.nameToken] => candidateName
                                    candidateName.span.length == variant.span.length => sameName!
                                    UIntSize(0) => byteIndex!
                                    sameName! and byteIndex! < variant.span.length
                                        -> while {
                                            (ownerText -> byte(candidateName.span.start + byteIndex!)) != (source -> byte(variant.span.start + byteIndex!))
                                                -> if { false => sameName! }
                                            byteIndex! + 1 => byteIndex!
                                        }
                                    sameName! -> if {
                                        candidate.typeNode < 0 -> if { -1 => payloadType! }
                                        0 => referenceIndex!
                                        referenceIndex! < (prepared.semantic.references -> len) and payloadType! < 0
                                            -> while {
                                                prepared.semantic.references[referenceIndex!] => reference
                                                reference.status == 0 and reference.sourceModule == ownerSource!
                                                    and reference.typeAst == candidate.typeNode
                                                    -> if { reference.typeId => payloadType! }
                                                referenceIndex! + 1 => referenceIndex!
                                            }
                                    }
                                }
                            variantIndex! + 1 => variantIndex!
                        }
                }
        }
    payloadType!
}

# A retained subject-condition wrapper can sit between an explicit enum
# pattern and its arm. Both inference and coverage follow source ownership.
public enumPatternArmAst package: ref analysis.PackageAnalysis, sourceIndex: Int, patternAst: Int -> Int {
    package.ranges[sourceIndex] => range
    package.nodes[range.astStart + patternAst].kind != 59
        -> if { -1 -> return }
    package.nodes[range.astStart + patternAst].parent => owner!
    0 => steps!
    owner! >= 0 and owner! < range.astCount and steps! < range.astCount
        -> while {
            package.nodes[range.astStart + owner!] => node
            node.kind == 58 -> if { owner! -> return }
            node.kind == 56 or node.kind == 57 -> if { -1 -> return }
            node.parent => owner!
            steps! + 1 => steps!
        }
    -1
}

# Pattern binding and exhaustiveness use the same source expression before
# a subject when. Same-span wrappers do not invent a second subject identity.
public subjectWhenValueAst package: ref analysis.PackageAnalysis, sourceIndex: Int, selectionAst: Int, resolvedByAst: ref [Int; ~] -> Int {
    package.ranges[sourceIndex] => range
    package.nodes[range.astStart + selectionAst] => selection
    selection.kind != 56 or selection.parent < 0 -> if { -1 -> return }
    -1 => subjectAst!
    UIntSize(0) => subjectStart!
    0 => search!
    search! < range.astCount -> while {
        package.nodes[range.astStart + search!] => candidate
        candidate.parent == selection.parent and candidate.start < selection.start
            and (subjectAst! < 0 or candidate.start >= subjectStart!)
            -> if { search! => subjectAst!
                candidate.start => subjectStart! }
        search! + 1 => search!
    }
    subjectAst! < 0 -> if { -1 -> return }
    true => wrapped!
    wrapped! -> while {
        false => wrapped!
        package.nodes[range.astStart + subjectAst!] => wrapper
        resolvedByAst[range.astStart + subjectAst!] < 0
            and (wrapper.kind == 10 or wrapper.kind == 36 or wrapper.kind == 55)
            -> if {
                0 => child!
                child! < range.astCount -> while {
                    package.nodes[range.astStart + child!] => candidate
                    candidate.parent == subjectAst! and candidate.start == wrapper.start and candidate.length == wrapper.length
                        -> if { child! => subjectAst!
                            true => wrapped! }
                    child! + 1 => child!
                }
            }
    }
    subjectAst!
}

resolvePatternPayloadTypes prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~], patternBindingTypeBySymbol: mut [Int; ~] -> Bool {
    false => changed!
    0 => sourceIndex!
    sourceIndex! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[sourceIndex!] => range
            0 => symbolIndex!
            symbolIndex! < range.symbolCount -> while {
                prepared.package.symbols[range.symbolStart + symbolIndex!] => binder
                binder.kind == 35 and binder.astNode >= 0 and binder.astNode < range.astCount
                    -> if {
                        prepared.package.nodes[range.astStart + binder.astNode] => pattern
                        prepared.package -> enumPatternArmAst(sourceIndex!, binder.astNode) => armAst
                        pattern.kind == 59 and pattern.payloadToken >= 0 and armAst >= 0
                            -> if {
                                prepared.package.nodes[range.astStart + armAst] => arm
                                arm.kind == 58 and arm.parent >= 0 -> if {
                                    prepared.package.nodes[range.astStart + arm.parent] => selection
                                    selection.kind == 56 and selection.parent >= 0
                                        -> if {
                                            prepared.package -> subjectWhenValueAst(sourceIndex!, arm.parent, expressionIndexByAst) => subjectAst
                                            subjectAst >= 0 -> if {
                                                expressionIndexByAst[range.astStart + subjectAst] => subjectExpression
                                                subjectExpression >= 0 -> if {
                                                    expressions[subjectExpression] => subjectValue
                                                    subjectValue.status == 0 and subjectValue.typeId >= 0 and subjectValue.typeId < (types -> len)
                                                        -> if {
                                                            types -> typeIds.materializedReadTypeId(subjectValue.typeId) => subjectTypeId
                                                            types[subjectTypeId] => subjectType
                                                            prepared.package.tokens[range.tokenStart + pattern.payloadToken] => variant
                                                            sourceIndex! -> patternPayloadTypeId(subjectType, variant, prepared) => payloadType
                                                            payloadType >= 0 and payloadType < (types -> len)
                                                                -> if {
                                                                    payloadType => patternBindingTypeBySymbol[range.symbolStart + symbolIndex!]
                                                                    0 => nameIndex!
                                                                    nameIndex! < range.nameCount -> while {
                                                                        prepared.package.names[range.nameStart + nameIndex!] => name
                                                                        name.symbol == symbolIndex! and name.astNode >= 0 and name.astNode < range.astCount
                                                                            -> if {
                                                                                range.astStart + name.astNode => nameGlobalAst
                                                                                expressionIndexByAst[nameGlobalAst] => existingIndex!
                                                                                existingIndex! < 0 -> if {
                                                                                    expressions -> len => existingIndex!
                                                                                    expressions -> push(ExpressionTypeId {
                                                                                        sourceModule: sourceIndex!
                                                                                        astNode: name.astNode
                                                                                        typeId: payloadType
                                                                                        status: 0
                                                                                    })
                                                                                    existingIndex! => expressionIndexByAst[nameGlobalAst]
                                                                                    true => changed!
                                                                                } else {
                                                                                    expressions[existingIndex!] => existing!
                                                                                    existing!.typeId != payloadType -> if {
                                                                                        payloadType => existing!.typeId
                                                                                        0 => existing!.status
                                                                                        existing! => expressions[existingIndex!]
                                                                                        true => changed!
                                                                                    }
                                                                                }
                                                                            }
                                                                        nameIndex! + 1 => nameIndex!
                                                                    }
                                                                }
                                                        }
                                                }
                                            }
                                        }
                                }
                            }
                    }
                symbolIndex! + 1 => symbolIndex!
            }
            sourceIndex! + 1 => sourceIndex!
        }
    changed!
}

resolvePaths prepared: semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], references: [typeIds.TypeReference], fields: mut [typeIds.NominalField; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~], flowTargetTokenByAst: [Int], productSources: [Int], productAsts: [Int], streamRoleTypeBySymbol: mut [Int; ~], patternBindingTypeBySymbol: mut [Int; ~], expectedContextByAst: mut [Int; ~] -> Unit {
    prepared.package -> semanticContext.indexMutableBindingOwners => mutableOwners
    prepared.package -> semanticContext.indexBindingValueAsts => bindingValues
    # An omitted input is constrained by its committed primary argument AST,
    # never by an already-typed expression nested inside that argument.
    prepared.package -> semanticContext.resolveCallArgumentBindings(prepared.calls) => signatureArgumentBindings
    [Int; ~] => primaryArgumentByCall!
    prepared.calls -> each call { primaryArgumentByCall! -> push(-1) }
    signatureArgumentBindings -> each binding {
        binding.parameterOrdinal == 0 and binding.argumentAst >= 0
            -> if {
                prepared.package.ranges[binding.sourceModule] => range
                prepared.callIndexByAst[range.astStart + binding.callAst] => callIndex
                callIndex >= 0 -> if { binding.argumentAst => primaryArgumentByCall![callIndex] }
            }
    }
    # Resolve member and index paths from the canonical type-id arena. Each
    # round walks typed expressions once and records the nearest usable base
    # for every still-untyped path, avoiding the legacy AST x expression scan.
    [Int; ~] => bindingSymbolByAst!
    0 => bindingAstSeed!
    bindingAstSeed! < (prepared.package.nodes -> len)
        -> while {
