    0 => controlBranchSource!
    controlBranchSource! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[controlBranchSource!] => controlBranchRange
            0 => controlBranchAst!
            controlBranchAst! < controlBranchRange.astCount
                -> while {
                    prepared.package.nodes[controlBranchRange.astStart + controlBranchAst!] => controlBranchNode
                    controlBranchNode.kind == 43 and controlBranchNode.parent >= 0
                        -> if {
