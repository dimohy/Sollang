                                                        -> if {
                                                            true => inferredReturnBelongs!
                                                        } else {
                                                            prepared.package.nodes[inferredReturnTargetRange.astStart + inferredReturnAncestor!] => inferredReturnAncestorNode
                                                            inferredReturnAncestorNode.kind == 7 or inferredReturnAncestorNode.kind == 29 or inferredReturnAncestorNode.kind == 31
                                                                -> if {
                                                                    true => inferredReturnNested!
                                                                } else {
                                                                    inferredReturnAncestor! => inferredReturnRootAst!
                                                                    inferredReturnAncestorNode.parent => inferredReturnAncestor!
                                                                    inferredReturnCandidateDistance! + 1 => inferredReturnCandidateDistance!
                                                                }
                                                        }
                                                }
                                            inferredReturnBelongs! and inferredReturnRootAst! == inferredReturnBodyValue
                                                and (prepared.package.nodes[inferredReturnTargetRange.astStart + inferredReturnBodyValue].kind != 47 or inferredReturnCandidate.astNode != inferredReturnBodyValue)
                                                -> if {
                                                    prepared.package.nodes[inferredReturnTargetRange.astStart + inferredReturnRootAst!].start => inferredReturnCandidateStart
                                                    prepared.package.nodes[inferredReturnTargetRange.astStart + inferredReturnCandidate.astNode].start => inferredReturnCandidateValueStart
                                                    inferredReturnExpression! < 0 or inferredReturnCandidateStart > inferredReturnTopLevelStart! or (inferredReturnCandidateStart == inferredReturnTopLevelStart! and (inferredReturnCandidateDistance! < inferredReturnDistance! or (inferredReturnCandidateDistance! == inferredReturnDistance! and inferredReturnCandidateValueStart > inferredReturnValueStart!)))
