                        prepared.package.nodes[intrinsicGlobal] => intrinsicFlow
                        flowTargetTokenByAst[intrinsicGlobal] => intrinsicTarget
                        flowSourceByAst[intrinsicGlobal] => intrinsicSourceGlobal
