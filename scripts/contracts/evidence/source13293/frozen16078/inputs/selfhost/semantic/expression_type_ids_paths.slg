                returnExpressionIndexSeed! + 1 => returnExpressionIndexSeed!
            }
        0 => inferredReturnCallIndex!
        inferredReturnCallIndex! < (prepared.calls -> len)
            -> while {
                prepared.calls[inferredReturnCallIndex!] => inferredReturnCall
                inferredReturnCall.status == 0 and inferredReturnCall.origin != 2 and inferredReturnCall.targetSourceModule >= 0
                    -> if {
                        prepared.package.ranges[inferredReturnCall.sourceModule] => inferredReturnCallRange
                        inferredReturnCallRange.astStart + inferredReturnCall.callAst => inferredReturnCallGlobalAst
                        prepared.package.ranges[inferredReturnCall.targetSourceModule] => inferredReturnTargetRange
                        prepared.package.symbols[inferredReturnTargetRange.symbolStart + inferredReturnCall.functionSymbol] => inferredReturnFunction
                        inferredReturnFunction.flags / 32 % 2 == 1 and inferredReturnFunction.flags / 4 % 2 == 0
                            -> if {
