                                                inferredParameterTargetRange.astStart + inferredParameterName.astNode => inferredParameterNameGlobalAst
                                                inferredParameterName.symbol == inferredParameterSymbol! and expressionIndexByAst[inferredParameterNameGlobalAst] < 0
                                                    -> if {
