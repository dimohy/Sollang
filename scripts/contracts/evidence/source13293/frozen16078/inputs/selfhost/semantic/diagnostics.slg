                                                    code: mapClauseCode!
                                                    sourceModule: sourceIndex!
                                                    astNode: astIndex!
                                                    operandAst: mapClauseSearch!
                                                    operatorKind: -1
                                                    locationOffset: mapClauseNode.start
                                                    operandTypeSymbol: -1
                                                    operandTypeId: mapClauseTypeId
                                                    firstTypeId: -1
