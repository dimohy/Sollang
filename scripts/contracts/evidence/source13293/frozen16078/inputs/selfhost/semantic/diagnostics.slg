                    package.nodes[range.astStart + boxChildIndex!] => boxOperand
                    boxOperand.parent == astIndex! -> if {
                        boxChildIndex! => typedBoxOperandAst!
                        typeIdByAst![range.astStart + typedBoxOperandAst!] => boxOperandTypeId!
