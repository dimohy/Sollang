                                    typeIdByAst![range.astStart + mapClauseSearch!] => mapClauseTypeId
                                    mapClauseTypeId >= 0 -> if {
                                        resolved.types[mapClauseTypeId] => mapClauseType
                                        mapClauseCode! == 9 -> if { 13 } else { 11 } => expectedClauseSymbol
                                        not (mapClauseType.kind == 1 and mapClauseType.origin == 1
                                            and mapClauseType.symbol == expectedClauseSymbol)
                                            -> if {
