                            resolved.types[leftTypeId] => leftType
                            resolved.types[rightTypeId] => rightType
                            leftType.kind == 1 and leftType.origin == 1 and leftType.symbol == 23 => leftBool
                            rightType.kind == 1 and rightType.origin == 1 and rightType.symbol == 23 => rightBool
