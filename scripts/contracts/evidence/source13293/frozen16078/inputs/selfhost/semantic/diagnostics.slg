                                    sourceModule: sourceIndex!
                                    astNode: astIndex!
                                    operandAst: mapPathAst!
                                    operatorKind: -1
                                    locationOffset: mapPathNode.start
                                    operandTypeSymbol: -1
                                    operandTypeId: mapPathTypeId!
                                    firstTypeId: -1
