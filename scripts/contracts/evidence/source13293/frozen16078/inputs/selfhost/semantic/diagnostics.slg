# One fact per missing declaration, in source and variant declaration order.
# These facts are collected from semantic types before any Typed IR exists.
public struct MissingEnumVariant {
    public sourceModule: Int
    public astNode: Int
    public typeId: Int
    public variantSymbol: Int
    public variantTag: Int
}

public missingEnumVariants prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet -> [MissingEnumVariant; ~] {
    [Int; ~] => typeByAst!
    prepared.package.nodes -> each node { typeByAst! -> push(-1) }
    resolved.expressions -> each expression {
        expression.status == 0 and expression.typeId >= 0
            -> if {
                prepared.package.ranges[expression.sourceModule] => range
                expression.typeId => typeByAst![range.astStart + expression.astNode]
            }
    }
    [MissingEnumVariant; ~] => missing!
    prepared.package.ranges -> each range {
        0 => selectionAst!
        selectionAst! < range.astCount -> while {
            prepared.package.nodes[range.astStart + selectionAst!] => selection
            selection.kind == 56 and (prepared -> declarationBodyIsActive(resolved, range.sourceModule, selectionAst!))
                -> if {
                    prepared.package -> expressionTypeIds.subjectWhenValueAst(range.sourceModule, selectionAst!, typeByAst!) => subjectAst
                    -1 => subjectType!
                    subjectAst >= 0 -> if { typeByAst![range.astStart + subjectAst] => subjectType! }
                    resolved.types -> typeIds.materializedReadTypeId(subjectType!) => enumTypeId
                    enumTypeId >= 0 -> if {
                        resolved.types[enumTypeId] => enumType
                        enumType.kind == 7 and enumType.origin == 4 and (enumType.symbol == 0 or enumType.symbol == 1) => standard
                        -1 => ownerSource!
                        -1 => ownerSymbol!
                        enumType.kind == 1 and (enumType.origin == 0 or enumType.origin == 2)
                            and enumType.module >= 0 and enumType.module < (prepared.package.ranges -> len)
                            -> if {
                                prepared.package.ranges[enumType.module] => ownerRange
                                enumType.symbol >= 0 and enumType.symbol < ownerRange.symbolCount
                                    and prepared.package.symbols[ownerRange.symbolStart + enumType.symbol].kind == 4
                                    -> if { enumType.module => ownerSource!
                                        enumType.symbol => ownerSymbol! }
                            }
                        false => hasElse!
                        0 => child!
                        child! < range.astCount -> while {
                            prepared.package.nodes[range.astStart + child!] => node
                            node.parent == selectionAst! and node.kind == 43
                                -> if { true => hasElse! }
                            child! + 1 => child!
                        }
                        not hasElse! and (standard or ownerSource! >= 0)
                            -> if {
                                standard -> if { 2 } else { prepared.package.ranges[ownerSource!].symbolCount } => candidates
                                0 => variant!
                                variant! < candidates -> while {
                                    -1 => variantSymbol!
                                    "" => variantName!
                                    standard -> if {
                                        enumType.symbol == 0 -> if {
                                            variant! == 0 -> if { "Some" } else { "None" } => variantName!
                                        } else {
                                            variant! == 0 -> if { "Ok" } else { "Err" } => variantName!
                                        }
                                    } else {
                                        prepared.package.ranges[ownerSource!] => ownerRange
                                        prepared.package.symbols[ownerRange.symbolStart + variant!] => declaration
                                        declaration.kind == 27 and declaration.parent == ownerSymbol!
                                            -> if {
                                                ownerRange.symbolStart + variant! => variantSymbol!
                                                prepared.package.tokens[ownerRange.tokenStart + declaration.nameToken] => token
                                                prepared.package.sources[ownerSource!] -> slice(token.span.start, token.span.length) => variantName!
                                            }
                                    }
                                    standard or variantSymbol! >= 0 -> if {
                                        false => covered!
                                        0 => patternAst!
                                        patternAst! < range.astCount -> while {
                                            prepared.package.nodes[range.astStart + patternAst!] => pattern
                                            pattern.kind == 59 and pattern.parent >= 0 and pattern.payloadToken >= 0
                                                -> if {
                                                    prepared.package -> expressionTypeIds.enumPatternArmAst(range.sourceModule, patternAst!) => armAst
                                                    armAst >= 0 and prepared.package.nodes[range.astStart + armAst].parent == selectionAst!
                                                        -> if {
                                                            prepared.package.tokens[range.tokenStart + pattern.payloadToken] => token
                                                            (prepared.package.sources[range.sourceModule] -> slice(token.span.start, token.span.length)) == variantName!
                                                                -> if { true => covered! }
                                                        }
                                                }
                                            patternAst! + 1 => patternAst!
                                        }
                                        not covered! -> if {
                                            missing! -> push(MissingEnumVariant { sourceModule: range.sourceModule, astNode: selectionAst!, typeId: enumTypeId, variantSymbol: variantSymbol!, variantTag: variant! })
                                        }
                                    }
                                    variant! + 1 => variant!
                                }
                            }
                    }
                }
            selectionAst! + 1 => selectionAst!
        }
    }
    missing!
}

public struct SemanticDiagnostic {
    public code: Int
    public symbol: Int
    public previousSymbol: Int
    public span: syntax.SourceSpan
}

# Qualified flow dispatch consumes function declarations. An exact nominal
# variant declaration remains a direct constructor, not a flowed function.
# Preserve the existing target path for the diagnostic name and location.
public unsupportedNominalEnumFlowPaths prepared: ref semanticContext.SemanticSnapshot -> [Int; ~] {
    [Int; ~] => paths!
    prepared.package.nodes -> each node { paths! -> push(-1) }
    prepared.calls -> each call {
        call.status == 0 and call.targetSourceModule >= 0
            and call.targetSourceModule < (prepared.package.ranges -> len)
            -> if {
                prepared.package.ranges[call.sourceModule] => sourceRange
                prepared.package.ranges[call.targetSourceModule] => targetRange
                sourceRange.astStart + call.callAst => globalCall
                prepared.package.nodes[globalCall].kind == 10
                    and call.functionSymbol >= 0 and call.functionSymbol < targetRange.symbolCount
                    -> if {
                        prepared.package.symbols[targetRange.symbolStart + call.functionSymbol] => variant
                        variant.kind == 27 and variant.parent >= 0 and variant.parent < targetRange.symbolCount
                            -> if {
                                prepared.package.symbols[targetRange.symbolStart + variant.parent].kind == 4
                                    -> if {
                                        prepared.directFlowTargetPathByAst[globalCall] => paths![globalCall]
                                    }
                            }
                    }
            }
    }
    paths!
}

public struct NominalFieldMismatchDiagnostic {
    public sourceModule: Int
    public initializerAst: Int
    public valueAst: Int
    public fieldIndex: Int
    public actualTypeId: Int
}

public struct SignatureTypeDiagnostic {
    public code: Int
    public sourceModule: Int
    public functionSymbol: Int
    public typeAst: Int
    public nameToken: Int
    public genericToken: Int
}

public struct InferredInputConflictDiagnostic {
    public sourceModule: Int
    public functionSymbol: Int
    public firstTypeId: Int
    public actualTypeId: Int
}

# Inference constrains the primary input from every committed call. Its actual
# expression type is independent of a missing formal annotation.
public firstInferredInputConflict prepared: ref semanticContext.SemanticSnapshot, resolved: mut expressionTypeIds.ExpressionTypeIdSet -> InferredInputConflictDiagnostic {
    InferredInputConflictDiagnostic { sourceModule: -1, functionSymbol: -1, firstTypeId: -1, actualTypeId: -1 } => valid
    false => hasInferredInput!
    prepared.package.symbols -> each symbol {
        symbol.kind == 7 and symbol.flags / 16 % 2 == 1
            -> if { true => hasInferredInput! }
    }
    not hasInferredInput! -> if { valid -> return }
    [Int; ~] => expressionIndexByAst!
    prepared.package.nodes -> each node { expressionIndexByAst! -> push(-1) }
    0 => expressionIndex!
    resolved.expressions -> each expression {
        expression.status == 0 and expression.typeId >= 0
            -> if {
                prepared.package.ranges[expression.sourceModule] => range
                expressionIndex! => expressionIndexByAst![range.astStart + expression.astNode]
            }
        expressionIndex! + 1 => expressionIndex!
    }
    [Int; ~] => firstTypeByFunction!
    prepared.package.symbols -> each symbol { firstTypeByFunction! -> push(-1) }
    prepared.package -> semanticContext.resolveCallArgumentBindings(prepared.calls) => bindings
    bindings -> each binding {
        binding.parameterOrdinal == 0 and binding.argumentAst >= 0
            -> if {
                prepared.package.ranges[binding.targetSourceModule] => targetRange
                prepared.package.symbols[targetRange.symbolStart + binding.functionSymbol] => function
                function.kind == 7 and function.flags / 16 % 2 == 1
                    -> if {
                        expressionTypeIds.inferredSignatureContractTypeId(prepared, resolved.types, resolved.expressions, expressionIndexByAst!, binding.sourceModule, binding.argumentAst) => actualType
                        actualType >= 0 and actualType < (resolved.types -> len)
                            and resolved.types[actualType].status == 0 and not resolved.types[actualType].containsParameter
                            -> if {
                                targetRange.symbolStart + binding.functionSymbol => globalFunction
                                firstTypeByFunction![globalFunction] => firstType
                                firstType < 0 -> if { actualType => firstTypeByFunction![globalFunction] } else {
                                    firstType != actualType -> if {
                                        InferredInputConflictDiagnostic { sourceModule: binding.targetSourceModule, functionSymbol: binding.functionSymbol, firstTypeId: firstType, actualTypeId: actualType } -> return
                                    }
                                }
                            }
                    }
            }
    }
    valid
}

# Declaration values and destination identity are decided before lowering.
# Code 1 is a live binding collision; code 2 is an unresolved direct call.
# Code 9 preserves an inaccessible direct call's committed target identity.
# Code 10 rejects an explicit declaration with a reserved binding name.
# Codes 11/12 reject indexed assignment value/index type mismatches.
# Code 13 rejects an unresolved inferred return before lowering.
public struct BindingDeclarationDiagnostic {
    public code: Int
    public sourceModule: Int
    public bindingAst: Int
    public valueAst: Int
    public nameToken: Int
    public expectedTypeId: Int
    public actualTypeId: Int
}

public struct CallArityDiagnostic {
    public nativePathStyle: Bool
    public sourceModule: Int
    public callAst: Int
    public targetSourceModule: Int
    public functionSymbol: Int
    public expectedAdditionalArguments: Int
}

directCallExpectedArguments prepared: ref semanticContext.SemanticSnapshot, call: calls.ModuleCallResolution -> Int {
    call.status == 0 and (prepared.package -> calls.isNativePathStyleIntrinsic(prepared.modules, call.targetSourceModule, call.functionSymbol))
        -> if { 0 -> return }
    call.status != 0 or call.sourceModule < 0 or call.sourceModule >= (prepared.package.ranges -> len)
        or call.targetSourceModule != call.sourceModule
        -> if { -1 -> return }
    prepared.package.ranges[call.sourceModule] => range
    prepared.package.ranges[call.targetSourceModule] => targetRange
    call.callAst < 0 or call.callAst >= range.astCount
        or call.functionSymbol < 0 or call.functionSymbol >= targetRange.symbolCount
        -> if { -1 -> return }
    prepared.package.nodes[range.astStart + call.callAst] => node
    node.kind != 11 or node.cstRuleId != grammar.ruleIdCallExpression()
        or node.firstToken < 0 or node.firstToken + 1 >= range.tokenCount
        -> if { -1 -> return }
    node.parent >= 0 -> if {
        prepared.package.nodes[range.astStart + node.parent] => parent
        parent.kind == 10 and node.start > parent.start
            -> if { -1 -> return }
    }
    prepared.package.tokens[range.tokenStart + node.firstToken].kind != grammar.tokenIdIdentifier()
        or prepared.package.tokens[range.tokenStart + node.firstToken + 1].kind != grammar.tokenIdLeftParen()
        -> if { -1 -> return }
    prepared.package.symbols[targetRange.symbolStart + call.functionSymbol] => function
    function.kind != 7 and function.kind != 31 -> if { -1 -> return }
    0 => childIndex!
    childIndex! < targetRange.symbolCount -> while {
        prepared.package.symbols[targetRange.symbolStart + childIndex!] => child
        child.parent == call.functionSymbol and child.kind == 32
            -> if { -1 -> return }
        childIndex! + 1 => childIndex!
    }
    prepared.package -> semanticContext.functionParameterSymbolsInSourceOrder(call.targetSourceModule, call.functionSymbol) => parameters
    parameters -> len
}

directArityOwnsUnknownName prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, sourceModule: Int, nameAst: Int -> Bool {
    prepared.package.ranges[sourceModule] => range
    nameAst => argumentRoot!
    prepared.package.nodes[range.astStart + nameAst].parent => ownerAst!
    ownerAst! >= 0 and ownerAst! < range.astCount
        -> while {
            prepared.package.nodes[range.astStart + ownerAst!] => owner
            owner.kind == 11 -> if {
                prepared.calls -> each call {
                    call.sourceModule == sourceModule and call.callAst == ownerAst!
                        -> if {
                            prepared -> directCallExpectedArguments(call) => expectedCount
                            expectedCount >= 0 and (prepared -> declarationBodyIsActive(resolved, sourceModule, ownerAst!))
                                -> if {
                                    # This exact direct-call branch never consumes a flow-source slot.
                                    [Int; ~] => unusedFlowSources
                                    prepared.package -> semanticContext.callArgumentAsts(call, unusedFlowSources) => arguments
                                    (arguments -> len) != expectedCount -> if {
                                        arguments -> each argument {
                                            argument == range.astStart + argumentRoot! -> if { true -> return }
                                        }
                                    }
                                }
                        }
                }
            }
            ownerAst! => argumentRoot!
            owner.parent => ownerAst!
        }
    false
}

public firstCallArityDiagnostic prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet -> CallArityDiagnostic {
    CallArityDiagnostic { nativePathStyle: false, sourceModule: -1, callAst: -1, targetSourceModule: -1, functionSymbol: -1, expectedAdditionalArguments: -1 } => selected!
    prepared.package -> semanticContext.indexFlowSourcesByAst => flowSources
    prepared.calls -> each call {
        call.status == 0 and call.sourceModule >= 0 and call.sourceModule < (prepared.package.ranges -> len)
            and call.targetSourceModule >= 0 and call.targetSourceModule < (prepared.package.ranges -> len)
            and call.functionSymbol >= 0 and call.functionSymbol < prepared.package.ranges[call.targetSourceModule].symbolCount
            -> if {
                prepared.package.ranges[call.sourceModule] => range
                prepared.package -> calls.isNativePathStyleIntrinsic(prepared.modules, call.targetSourceModule, call.functionSymbol) => nativePathStyle
                prepared -> directCallExpectedArguments(call) => directExpected
                call.callAst >= 0 and call.callAst < range.astCount
                    and (prepared.package.nodes[range.astStart + call.callAst].kind == 10
                    or directExpected >= 0)
                    and (prepared -> declarationBodyIsActive(resolved, call.sourceModule, call.callAst))
                    -> if {
                        directExpected => expectedTotal!
                        directExpected < 0 -> if {
                            prepared.package -> semanticContext.functionParameterSymbolsInSourceOrder(call.targetSourceModule, call.functionSymbol) => parameters
                            parameters -> len => expectedTotal!
                        }
                        prepared.package -> semanticContext.callArgumentAsts(call, flowSources) => arguments
                        (arguments -> len) == 0
                            and (prepared.package -> calls.displayFunctionSymbol(prepared.modules, call.targetSourceModule, call.functionSymbol, prepared.standardLibrarySourceStart, prepared.standardLibrarySourceCount)) == -102
                            -> if { 0 => expectedTotal! }
                        ((prepared.package.nodes[range.astStart + call.callAst].kind == 10 and expectedTotal! > 0)
                            or prepared.package.nodes[range.astStart + call.callAst].kind == 11 or nativePathStyle)
                            and (arguments -> len) != expectedTotal!
                            and (prepared.package -> diagnosticOriginBefore(call.sourceModule, call.callAst, selected!.sourceModule, selected!.callAst))
                            -> if {
                                expectedTotal! - 1 => expectedCount!
                                prepared.package.nodes[range.astStart + call.callAst].kind == 11
                                    -> if { expectedTotal! => expectedCount! }
                                CallArityDiagnostic {
                                    nativePathStyle: nativePathStyle
                                    sourceModule: call.sourceModule
                                    callAst: call.callAst
                                    targetSourceModule: call.targetSourceModule
                                    functionSymbol: call.functionSymbol
                                    expectedAdditionalArguments: expectedCount!
                                } => selected!
                            }
                    }
            }
    }
    selected!
}

declarationScope package: ref analysis.PackageAnalysis, sourceModule: Int, astNode: Int -> Int {
    package -> semanticContext.declarationScope(sourceModule, astNode)
}

declarationAncestor package: ref analysis.PackageAnalysis, sourceModule: Int, ancestor: Int, astNode: Int -> Bool {
    package -> semanticContext.declarationAncestor(sourceModule, ancestor, astNode)
}

public declarationBodyIsActive prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, sourceModule: Int, astNode: Int -> Bool {
    astNode < 0 -> if { true -> return }
    prepared.package.ranges[sourceModule] => range
    resolved.activeDeclarationBodyByAst[range.astStart + astNode]
}

# Interpolation fragments retain the enclosing source string token. Project the
# same declaration activation facts once, before the emitter consumes them.
public activeInterpolationBodies prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet -> [Bool; ~] {
    [Bool; ~] => activeByToken!
    prepared.package.tokens -> each token { activeByToken! -> push(true) }
    prepared.package.ranges -> each range {
        0 => astIndex!
        astIndex! < range.astCount -> while {
            prepared.package.nodes[range.astStart + astIndex!] => node
            node.payloadToken >= 0 and node.payloadToken < range.tokenCount
                -> if {
                    resolved.activeDeclarationBodyByAst[range.astStart + astIndex!]
                        => activeByToken![range.tokenStart + node.payloadToken]
                }
            astIndex! + 1 => astIndex!
        }
    }
    [Bool; ~] => activeByNode!
    prepared.interpolations -> each node { activeByNode! -> push(true) }
    prepared.interpolationRanges -> each interpolationRange {
        prepared.package.ranges[interpolationRange.sourceModule] => range
        0 => nodeIndex!
        nodeIndex! < interpolationRange.nodeCount -> while {
            interpolationRange.nodeStart + nodeIndex! => globalNode
            prepared.interpolations[globalNode].sourceToken => token
            token >= 0 and token < range.tokenCount -> if {
                activeByToken![range.tokenStart + token] => activeByNode![globalNode]
            }
            nodeIndex! + 1 => nodeIndex!
        }
    }
    activeByNode!
}

# Whole-owner moves remove a name. Field extraction leaves the owner live.
declarationIntrinsicOwnerConsumed prepared: ref semanticContext.SemanticSnapshot, sourceModule: Int, nameAst: Int -> Bool {
    prepared.package.ranges[sourceModule] => range
    prepared.package.nodes[range.astStart + nameAst] => name
    name.parent => flowAst!
    flowAst! < 0 -> if { false -> return }
    prepared.package.nodes[range.astStart + flowAst!] => firstFlow
    firstFlow.kind != 10 or firstFlow.start != name.start
        -> if { false -> return }
    # Nested flow edges preserve the first source. The outer edge owns the
    # final target, which is the C# consumption decision for the whole flow.
    false => outermost!
    not outermost! -> while {
        prepared.package.nodes[range.astStart + flowAst!] => flow
        flow.parent < 0 -> if { true => outermost! } else {
            prepared.package.nodes[range.astStart + flow.parent] => parent
            parent.kind == 10 and parent.start == name.start
                -> if { flow.parent => flowAst! } else { true => outermost! }
        }
    }
    range.astStart + flowAst! => globalFlow
    prepared.directFlowTargetPathByAst[globalFlow] => targetAst
    targetAst < 0 -> if { false -> return }
    prepared.package.nodes[range.astStart + targetAst] => target
    target.firstToken => targetToken!
    targetToken! < target.firstToken + target.tokenCount
        -> while {
            prepared.package.tokens[range.tokenStart + targetToken!].kind == grammar.tokenIdDot()
                -> if { false -> return }
            targetToken! + 1 => targetToken!
        }
    # A declared function with an intrinsic spelling keeps its own contract.
    prepared.callIndexByAst[globalFlow] => callIndex
    callIndex >= 0 -> if {
        prepared.calls[callIndex].functionSymbol >= 0
            -> if { false -> return }
    }
    prepared.package.tokens[range.tokenStart + target.payloadToken] => targetName
    prepared.package.sources[sourceModule] -> slice(targetName.span.start, targetName.span.length) -> calls.moveConsumingIntrinsicTarget
}

declarationNameConsumes prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, traits: ref [Int; ~], sourceModule: Int, nameAst: Int, ownerSymbol: Int, typeByAst: ref [Int; ~] -> Bool {
    prepared -> declarationIntrinsicOwnerConsumed(sourceModule, nameAst)
        -> if { true -> return }
    prepared.package.ranges[sourceModule] => range
    resolved.lexicalBindingTypeBySymbol[range.symbolStart + ownerSymbol] => ownerType!
    ownerType! < 0 -> if { false -> return }
    resolved.types -> typeIds.materializedReadTypeId(ownerType!) => ownerType!
    traits[ownerType!] % 2 == 0 -> if { false -> return }
    range.astStart + nameAst => globalName
    prepared.declaredMoveArgumentByAst[globalName]
        -> if { true -> return }
    prepared.package.nodes[globalName].parent => parentAst
    parentAst < 0 -> if { false -> return }
    prepared.package.nodes[range.astStart + parentAst] => parent
    prepared.package.symbols[range.symbolStart + ownerSymbol] => owner
    (parent.kind == 9 or parent.kind == 61) and owner.kind == 35 and owner.flags % 2 == 1
        -> if { true -> return }
    # Calls and field projections cannot turn a borrowed read into a literal transfer.
    parent.kind == 40 or parent.kind == 72 or parent.kind == 37 or parent.kind == 38 or parent.kind == 71
        -> unless { false -> return }
    typeByAst[globalName] => valueType!
    valueType! < 0 -> if { false -> return }
    resolved.types -> typeIds.materializedReadTypeId(valueType!) => valueType!
    valueType! != ownerType! -> if { false -> return }
    parentAst => literal!
    literal! >= 0 -> while {
        prepared.package.nodes[range.astStart + literal!] => literalNode
        literalNode.kind == 39 or literalNode.kind == 37 or literalNode.kind == 38 or literalNode.kind == 71
            -> if { true -> return }
        literalNode.kind != 40 and literalNode.kind != 72
            -> if { false -> return }
        literalNode.parent => literal!
    }
    false
}

declarationOwnerConsumed prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, traits: ref [Int; ~], sourceModule: Int, ownerSymbol: Int, bindingAst: Int, typeByAst: ref [Int; ~] -> Bool {
    prepared.package.ranges[sourceModule] => range
    prepared.package.nodes[range.astStart + bindingAst] => binding
    range.nameStart => nameIndex!
    nameIndex! < range.nameStart + range.nameCount
        -> while {
            prepared.package.names[nameIndex!] => name
            name.symbol == ownerSymbol -> if {
                prepared.package.nodes[range.astStart + name.astNode] => read
                prepared.package -> declarationScope(sourceModule, name.astNode) => readScope
                (read.start < binding.start or (prepared.package -> declarationAncestor(sourceModule, bindingAst, name.astNode)))
                    and (prepared.package -> declarationAncestor(sourceModule, readScope, bindingAst))
                    and (prepared -> declarationNameConsumes(resolved, traits, sourceModule, name.astNode, ownerSymbol, typeByAst))
                    -> if { true -> return }
            }
            nameIndex! + 1 => nameIndex!
        }
    false
}

diagnosticBindingOrigin package: ref analysis.PackageAnalysis, sourceModule: Int, astNode: Int -> Int {
    package.ranges[sourceModule] => range
    astNode => current!
    current! >= 0 -> while {
        package.nodes[range.astStart + current!] => node
        node.kind == 9 or node.kind == 61 -> if { current! -> return }
        node.kind == 7 or node.kind == 8 or node.kind == 31
            -> if { astNode -> return }
        node.parent => current!
    }
    astNode
}

diagnosticFunctionOrigin package: ref analysis.PackageAnalysis, sourceModule: Int, astNode: Int -> Int {
    package.ranges[sourceModule] => range
    astNode => current!
    current! >= 0 -> while {
        package.nodes[range.astStart + current!] => node
        node.kind == 7 or node.kind == 31 -> if { current! -> return }
        node.kind == 8 -> if { -1 -> return }
        node.parent => current!
    }
    -1
}

# Function bodies precede main. Within a body, initializer errors precede a
# collision at that same statement; distinct statements retain source order.
public diagnosticOriginBefore package: ref analysis.PackageAnalysis, sourceModule: Int, astNode: Int, otherSource: Int, otherAst: Int -> Bool {
    otherSource < 0 -> if { true -> return }
    package -> diagnosticFunctionOrigin(sourceModule, astNode) => function
    package -> diagnosticFunctionOrigin(otherSource, otherAst) => otherFunction
    function >= 0 and otherFunction < 0 -> if { true -> return }
    function < 0 and otherFunction >= 0 -> if { false -> return }
    sourceModule != otherSource -> if { sourceModule < otherSource -> return }
    package.ranges[sourceModule] => range
    function >= 0 and otherFunction >= 0 and function != otherFunction
        -> if { package.nodes[range.astStart + function].start < package.nodes[range.astStart + otherFunction].start -> return }
    package -> diagnosticBindingOrigin(sourceModule, astNode) => origin
    package -> diagnosticBindingOrigin(otherSource, otherAst) => otherOrigin
    package.nodes[range.astStart + origin].start < package.nodes[range.astStart + otherOrigin].start
}


# Destination identity comes from the frozen lexical table, before Typed IR.
indexedAssignmentOwnerType prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, sourceModule: Int, assignmentAst: Int -> Int {
    prepared.package.ranges[sourceModule] => range
    prepared.package.nodes[range.astStart + assignmentAst] => assignment
    prepared.package -> semanticContext.nearestVisibleMutableBinding(sourceModule, assignmentAst, assignment.payloadToken) => binding
    binding >= 0 -> if {
        resolved.lexicalBindingTypeBySymbol[resolved.mutableBindingOwners[binding]] -> return
    }
    # Mutable parameters have a declaration scope rather than a binding AST.
    prepared.package.tokens[range.tokenStart + assignment.payloadToken] => ownerToken
    prepared.package.sources[sourceModule] -> slice(ownerToken.span.start, ownerToken.span.length) => ownerName
    -1 => selectedType!
    UIntSize(0) => selectedStart!
    0 => symbolIndex!
    symbolIndex! < range.symbolCount -> while {
        prepared.package.symbols[range.symbolStart + symbolIndex!] => parameter
        parameter.kind == 35 and parameter.flags / 2 % 2 == 1 and parameter.astNode >= 0
            and (prepared.package -> semanticContext.declarationAncestor(sourceModule, parameter.astNode, assignmentAst))
            -> if {
                prepared.package.nodes[range.astStart + parameter.astNode] => declaration
                prepared.package.tokens[range.tokenStart + parameter.nameToken] => token
                prepared.package.sources[sourceModule] -> slice(token.span.start, token.span.length) => name
                name == ownerName and (selectedType! < 0 or declaration.start >= selectedStart!)
                    -> if {
                        resolved.lexicalBindingTypeBySymbol[range.symbolStart + symbolIndex!] => selectedType!
                        declaration.start => selectedStart!
                    }
            }
        symbolIndex! + 1 => symbolIndex!
    }
    selectedType!
}

public indexedAssignmentValueType prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, sourceModule: Int, assignmentAst: Int -> Int {
    prepared -> indexedAssignmentOwnerType(resolved, sourceModule, assignmentAst) => ownerTypeId
    ownerTypeId < 0 -> if { -1 -> return }
    resolved.types[ownerTypeId] => owner
    owner.kind == 3 or owner.kind == 4 or owner.kind == 12
        -> if { owner.first -> return }
    owner.kind == 5 or owner.kind == 13 -> if { owner.second -> return }
    owner.kind == 1 and owner.origin == 1 and owner.symbol == 18
        -> if { resolved.types -> typeIds.builtinTypeId(8) -> return }
    -1
}

indexedAssignmentTypesMatch types: ref [typeIds.SemanticType; ~], actual: Int, expected: Int -> Bool {
    actual == expected -> if { true -> return }
    types[actual] => actualType
    types[expected] => expectedType
    actualType.kind == 1 and actualType.origin == 1 and expectedType.kind == 1 and expectedType.origin == 1
        and (actualType.symbol -> typeIds.canonicalBuiltinSymbol) == (expectedType.symbol -> typeIds.canonicalBuiltinSymbol)
}

firstIndexedAssignmentDiagnostic prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, typeByAst: ref [Int; ~], previous: BindingDeclarationDiagnostic -> BindingDeclarationDiagnostic {
    previous => selected!
    # Index the first two children once, for assignment operands and literal negation.
    [Int; ~] => firstChildByAst!
    [Int; ~] => secondChildByAst!
    prepared.package.nodes -> each node {
        firstChildByAst! -> push(-1)
        secondChildByAst! -> push(-1)
    }
    prepared.package.ranges -> each range {
        0 => childAst!
        childAst! < range.astCount -> while {
            prepared.package.nodes[range.astStart + childAst!] => child
            child.parent >= 0
                -> if {
                    range.astStart + child.parent => parentGlobal
                    firstChildByAst![parentGlobal] => first
                    secondChildByAst![parentGlobal] => second
                    first < 0 or child.start < prepared.package.nodes[range.astStart + first].start
                        -> if {
                            first => secondChildByAst![parentGlobal]
                            childAst! => firstChildByAst![parentGlobal]
                        } else {
                            second < 0 or child.start < prepared.package.nodes[range.astStart + second].start
                                -> if { childAst! => secondChildByAst![parentGlobal] }
                        }
                }
            childAst! + 1 => childAst!
        }
    }
    resolved.types -> typeIds.builtinTypeId(2) => intType
    prepared.package.ranges -> each range {
        0 => assignmentAst!
        assignmentAst! < range.astCount -> while {
            prepared.package.nodes[range.astStart + assignmentAst!] => assignment
            assignment.kind == 53 and assignment.payloadToken >= 0
                and (prepared -> declarationBodyIsActive(resolved, range.sourceModule, assignmentAst!))
                -> if {
                    prepared -> indexedAssignmentOwnerType(resolved, range.sourceModule, assignmentAst!) => ownerTypeId
                    ownerTypeId >= 0 -> if {
                        resolved.types[ownerTypeId] => owner
                        intType => expectedIndex!
                        prepared -> indexedAssignmentValueType(resolved, range.sourceModule, assignmentAst!) => expectedValue
                        owner.kind == 5 or owner.kind == 13 -> if {
                            owner.first => expectedIndex!
                        }
                        owner.kind == 1 and owner.origin == 1 and owner.symbol == 18
                            -> if {
                                resolved.types -> typeIds.builtinTypeId(13) => expectedIndex!
                            }
                        expectedValue >= 0 -> if {
                            firstChildByAst![range.astStart + assignmentAst!] => valueAst
                            secondChildByAst![range.astStart + assignmentAst!] => indexAst
                            -1 => invalidAst!
                            -1 => expectedType!
                            -1 => actualType!
                            0 => code!
                            # C# binds and checks the value before the index.
                            0 => operand!
                            operand! < 2 -> while {
                                valueAst => ast!
                                expectedValue => expected!
                                operand! == 1 -> if {
                                    indexAst => ast!
                                    expectedIndex! => expected!
                                }
                                ast! >= 0 and expected! >= 0 and invalidAst! < 0
                                    -> if {
                                        typeByAst[range.astStart + ast!] => actual!
                                        prepared.package.nodes[range.astStart + ast!] => node
                                        # C# InferNameExpression reads one reference layer for a name.
                                        # Keep reference-producing calls and other expressions unchanged.
                                        node.kind == 15 -> if {
                                            resolved.types -> typeIds.materializedReadTypeId(actual!) => actual!
                                        }
                                        # Numeric literal context is permitted for values and mapped-byte indexes.
                                        # An already typed binding never acquires this literal-only permission.
                                        node.kind == 14 => numericLiteral!
                                        node.kind == 22 and node.operatorKind == grammar.tokenIdMinus()
                                            -> if {
                                                firstChildByAst![range.astStart + ast!] => child
                                                child >= 0 and secondChildByAst![range.astStart + ast!] < 0
                                                    and prepared.package.nodes[range.astStart + child].kind == 14
                                                    -> if { true => numericLiteral! }
                                            }
                                        resolved.types[expected!] => expectedSemanticType
                                        expectedSemanticType.kind == 1 and expectedSemanticType.origin == 1
                                            and ((expectedSemanticType.symbol >= 2 and expectedSemanticType.symbol <= 13)
                                            or (expectedSemanticType.symbol >= 19 and expectedSemanticType.symbol <= 22))
                                            and numericLiteral!
                                            and (operand! == 0 or (owner.kind == 1 and owner.origin == 1 and owner.symbol == 18)) => contextualNumericLiteral
                                        actual! >= 0 and not contextualNumericLiteral
                                            and not (resolved.types -> indexedAssignmentTypesMatch(actual!, expected!))
                                            -> if {
                                                ast! => invalidAst!
                                                expected! => expectedType!
                                                actual! => actualType!
                                                operand! + 11 => code!
                                            }
                                    }
                                operand! + 1 => operand!
                            }
                            invalidAst! >= 0 and (prepared.package -> diagnosticOriginBefore(range.sourceModule, invalidAst!, selected!.sourceModule, selected!.valueAst))
                                -> if {
                                    prepared.package.nodes[range.astStart + invalidAst!].firstToken => token
                                    BindingDeclarationDiagnostic { code: code!, sourceModule: range.sourceModule, bindingAst: assignmentAst!, valueAst: invalidAst!, nameToken: token, expectedTypeId: expectedType!, actualTypeId: actualType! } => selected!
                                }
                        }
                    }
                }
            assignmentAst! + 1 => assignmentAst!
        }
    }
    selected!
}

public firstBindingDeclarationDiagnostic prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, traits: ref [Int; ~], libraryCalls: ref [libraryImports.LibraryFunctionResolution; ~] -> BindingDeclarationDiagnostic {
    BindingDeclarationDiagnostic { code: 0, sourceModule: -1, bindingAst: -1, valueAst: -1, nameToken: -1, expectedTypeId: -1, actualTypeId: -1 } => selected!
    [Int; ~] => typeByAst!
    [Int; ~] => symbolByAst!
    prepared.package.nodes -> each node {
        typeByAst! -> push(-1)
        symbolByAst! -> push(-1)
    }
    resolved.expressions -> each expression {
        expression.status == 0 -> if {
            prepared.package.ranges[expression.sourceModule] => range
            expression.typeId => typeByAst![range.astStart + expression.astNode]
        }
    }
    # Signature inference precedes body binding in the C# frontend. A body
    # value with no committed declaration type must not reach IR. Share its
    # identity with inference, including expression bodies and empty Unit.
    prepared -> expressionTypeIds.indexInferredFunctionBodyValues => inferredBodyValues
    prepared.package -> expressionTypeIds.continuationFlags => signatureContinuationByAst
    [Int; ~] => signatureExpressionIndexByAst!
    prepared.package.nodes -> each node { signatureExpressionIndexByAst! -> push(-1) }
    0 => signatureExpression!
    signatureExpression! < (resolved.expressions -> len)
        -> while {
            resolved.expressions[signatureExpression!] => expression
            prepared.package.ranges[expression.sourceModule] => range
            signatureExpression! => signatureExpressionIndexByAst![range.astStart + expression.astNode]
            signatureExpression! + 1 => signatureExpression!
        }
    0 => signatureSource!
    signatureSource! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[signatureSource!] => signatureRange
            0 => signatureSymbol!
            signatureSymbol! < signatureRange.symbolCount
                -> while {
                    prepared.package.symbols[signatureRange.symbolStart + signatureSymbol!] => inferredFunction
                    inferredFunction.kind == 7 and inferredFunction.astNode >= 0
                        and inferredFunction.flags / 32 % 2 == 1
                        and inferredFunction.flags / 4 % 2 == 0
                        -> if {
                            inferredBodyValues[signatureRange.astStart + inferredFunction.astNode] => bodyAst
                            typeByAst![signatureRange.astStart + inferredFunction.astNode] < 0 => unresolved!
                            prepared.package -> expressionTypeIds.terminalWhenAst(signatureRange.sourceModule, bodyAst) => choiceAst
                            choiceAst >= 0 -> if {
                                prepared.package -> expressionTypeIds.whenResultContract(resolved.expressions, signatureExpressionIndexByAst!, signatureContinuationByAst, resolved.types -> typeIds.builtinTypeId(0), signatureRange.sourceModule, choiceAst) => choice
                                choice.continuingArms > 0 and not choice.complete
                                    -> if { true => unresolved! }
                            }
                            bodyAst >= 0 and unresolved!
                                -> if {
                                    BindingDeclarationDiagnostic { code: 13, sourceModule: signatureRange.sourceModule, bindingAst: inferredFunction.astNode, valueAst: inferredFunction.astNode, nameToken: inferredFunction.nameToken, expectedTypeId: -1, actualTypeId: -1 } -> return
                                }
                        }
                    signatureSymbol! + 1 => signatureSymbol!
                }
            signatureSource! + 1 => signatureSource!
        }
    prepared -> firstContainerTransformDiagnostic(resolved, typeByAst!) => selected!
    prepared -> firstIndexedAssignmentDiagnostic(resolved, typeByAst!, selected!) => selected!
    prepared.package.ranges -> each range {
        0 => symbolIndex!
        symbolIndex! < range.symbolCount -> while {
            prepared.package.symbols[range.symbolStart + symbolIndex!] => symbol
            symbol.astNode >= 0 -> if { symbolIndex! => symbolByAst![range.astStart + symbol.astNode] }
            symbolIndex! + 1 => symbolIndex!
        }
    }
    # Type conversions and constructors have a resolved semantic result even
    # when they do not resolve through the ordinary function-call table.
    # Validated metadata declarations retain their owning module and private
    # visibility without mutating the frozen source semantic snapshot.
    libraryCalls -> each call {
        call.status == 3 and call.exportIndex >= 0 and call.callAst >= 0
            and (prepared -> declarationBodyIsActive(resolved, call.sourceModule, call.callAst))
            and (prepared.package -> diagnosticOriginBefore(call.sourceModule, call.callAst, selected!.sourceModule, selected!.valueAst))
            -> if {
                prepared.package.ranges[call.sourceModule] => range
                prepared.package.nodes[range.astStart + call.callAst] => node
                prepared.package -> diagnosticBindingOrigin(call.sourceModule, call.callAst) => binding
                BindingDeclarationDiagnostic { code: 9, sourceModule: call.sourceModule, bindingAst: binding, valueAst: call.callAst, nameToken: node.payloadToken, expectedTypeId: -1, actualTypeId: -1 } => selected!
            }
    }
    prepared.calls -> each call {
        prepared.package.ranges[call.sourceModule] => range
        prepared.package.nodes[range.astStart + call.callAst] => node
        call.status == 3 and node.kind == 11 and call.targetSourceModule >= 0 and call.functionSymbol >= 0
            and (prepared -> declarationBodyIsActive(resolved, call.sourceModule, call.callAst))
            -> if {
                prepared.package -> diagnosticBindingOrigin(call.sourceModule, call.callAst) => binding
                prepared.package -> diagnosticOriginBefore(call.sourceModule, call.callAst, selected!.sourceModule, selected!.valueAst)
                    -> if { BindingDeclarationDiagnostic { code: 9, sourceModule: call.sourceModule, bindingAst: binding, valueAst: call.callAst, nameToken: node.payloadToken, expectedTypeId: -1, actualTypeId: -1 } => selected! }
            }
        call.status == 2 and node.kind == 11 and typeByAst![range.astStart + call.callAst] < 0
            and (prepared -> declarationBodyIsActive(resolved, call.sourceModule, call.callAst))
            -> if {
                prepared.package -> diagnosticBindingOrigin(call.sourceModule, call.callAst) => binding
                prepared.package -> diagnosticOriginBefore(call.sourceModule, call.callAst, selected!.sourceModule, selected!.valueAst)
                    -> if { BindingDeclarationDiagnostic { code: 2, sourceModule: call.sourceModule, bindingAst: binding, valueAst: call.callAst, nameToken: node.payloadToken, expectedTypeId: -1, actualTypeId: -1 } => selected! }
            }
    }
    prepared.package.ranges -> each range {
        0 => bindingAst!
        bindingAst! < range.astCount -> while {
            prepared.package.nodes[range.astStart + bindingAst!] => binding
            (binding.kind == 9 or binding.kind == 61)
                and (prepared -> declarationBodyIsActive(resolved, range.sourceModule, bindingAst!))
                -> if {
                    symbolByAst![range.astStart + bindingAst!] => bindingSymbol
                    prepared.package.symbols[range.symbolStart + bindingSymbol] => current
                    prepared.package.tokens[range.tokenStart + current.nameToken] => currentName
                    prepared.package.sources[range.sourceModule] -> slice(currentName.span.start, currentName.span.length) => declarationName
                    current.flags % 2 == 0 and (declarationName -> symbols.reservedBindingName)
                        and (prepared.package -> diagnosticOriginBefore(range.sourceModule, bindingAst!, selected!.sourceModule, selected!.valueAst))
                        -> if { BindingDeclarationDiagnostic { code: 10, sourceModule: range.sourceModule, bindingAst: bindingAst!, valueAst: bindingAst!, nameToken: current.nameToken, expectedTypeId: -1, actualTypeId: -1 } => selected! }
                    -1 => previous!
                    0 => candidateIndex!
                    candidateIndex! < range.symbolCount -> while {
                        prepared.package.symbols[range.symbolStart + candidateIndex!] => candidate
                        (candidate.kind == 9 or candidate.kind == 61 or candidate.kind == 35)
                            and candidateIndex! != bindingSymbol
                            and prepared.package.nodes[range.astStart + candidate.astNode].start < binding.start
                            and (candidate.kind == 35 or not (prepared.package -> declarationAncestor(range.sourceModule, candidate.astNode, bindingAst!)))
                            -> if {
                                prepared.package -> declarationScope(range.sourceModule, candidate.astNode) => candidateScope!
                                candidate.kind == 35 and candidate.parent >= 0
                                    -> if { prepared.package.symbols[range.symbolStart + candidate.parent].astNode => candidateScope! }
                                prepared.package -> declarationAncestor(range.sourceModule, candidateScope!, bindingAst!)
                                    -> if {
                                        (candidate.kind == 9 or candidate.kind == 61) and candidate.flags % 2 == 1 => candidateMutable
                                        current.flags % 2 == 1 => currentMutable
                                        prepared.package.tokens[range.tokenStart + candidate.nameToken] => candidateName
                                        ((candidateMutable and currentMutable) or (not candidateMutable and not currentMutable)) and candidateName.span.length == currentName.span.length => sameName!
                                        UIntSize(0) => byteIndex!
                                        sameName! and byteIndex! < currentName.span.length
                                            -> while {
                                                (prepared.package.sources[range.sourceModule] -> byte(currentName.span.start + byteIndex!)) != (prepared.package.sources[range.sourceModule] -> byte(candidateName.span.start + byteIndex!))
                                                    -> if { false => sameName! }
                                                byteIndex! + 1 => byteIndex!
                                            }
                                        candidate -> symbols.contextualName => contextualName
                                        (contextualName -> len) > 0 -> if {
                                            not currentMutable and (prepared.package.sources[range.sourceModule] -> slice(currentName.span.start, currentName.span.length)) == contextualName => sameName!
                                        }
                                        sameName! -> if {
                                            previous! < 0 -> if { candidateIndex! => previous! } else {
                                                prepared.package.nodes[range.astStart + candidate.astNode].start >= prepared.package.nodes[range.astStart + prepared.package.symbols[range.symbolStart + previous!].astNode].start
                                                    -> if { candidateIndex! => previous! }
                                            }
                                        }
                                    }
                            }
                        candidateIndex! + 1 => candidateIndex!
                    }
                    previous! >= 0 and current.flags % 2 == 0
                        and not (prepared -> declarationOwnerConsumed(resolved, traits, range.sourceModule, previous!, bindingAst!, typeByAst!))
                        and (prepared.package -> diagnosticOriginBefore(range.sourceModule, bindingAst!, selected!.sourceModule, selected!.valueAst))
                        -> if { BindingDeclarationDiagnostic { code: 1, sourceModule: range.sourceModule, bindingAst: bindingAst!, valueAst: bindingAst!, nameToken: current.nameToken, expectedTypeId: -1, actualTypeId: -1 } => selected! }
                }
            bindingAst! + 1 => bindingAst!
        }
    }
    selected!
}

signatureTypeReferencesGeneric package: ref analysis.PackageAnalysis, sourceModule: Int, functionSymbol: Int, typeAst: Int, maximumParameters: Int -> Bool {
    typeAst < 0 -> if { false -> return }
    package.ranges[sourceModule] => range
    package.symbols[range.symbolStart + functionSymbol].astNode => functionAst
    package.nodes[range.astStart + typeAst] => annotation
    0 => astIndex!
    astIndex! < range.astCount -> while {
        package.nodes[range.astStart + astIndex!] => clause
        clause.kind == 32 and clause.parent == functionAst
            -> if {
                0 => parameterCount!
                clause.firstToken => genericIndex!
                genericIndex! < clause.firstToken + clause.tokenCount
                    -> while {
                        package.tokens[range.tokenStart + genericIndex!] => generic
                        generic.kind == grammar.tokenIdIdentifier() -> if {
                            parameterCount! + 1 => parameterCount!
                            maximumParameters == 0 or parameterCount! <= maximumParameters
                                -> if {
                                    package.sources[sourceModule] -> slice(generic.span.start, generic.span.length) => genericName
                                    annotation.firstToken => typeIndex!
                                    typeIndex! < annotation.firstToken + annotation.tokenCount
                                        -> while {
                                            package.tokens[range.tokenStart + typeIndex!] => name
                                            name.kind == grammar.tokenIdIdentifier()
                                                and (package.sources[sourceModule] -> slice(name.span.start, name.span.length)) == genericName
                                                -> if { true -> return }
                                            typeIndex! + 1 => typeIndex!
                                        }
                                }
                        }
                        genericIndex! + 1 => genericIndex!
                    }
            }
        astIndex! + 1 => astIndex!
    }
    false
}

signatureFirstGenericIsValue package: ref analysis.PackageAnalysis, sourceModule: Int, functionAst: Int, genericToken: Int -> Bool {
    package.ranges[sourceModule] => range
    package.tokens[range.tokenStart + genericToken] => generic
    package.sources[sourceModule] -> slice(generic.span.start, generic.span.length) => genericName
    0 => astIndex!
    astIndex! < range.astCount -> while {
        package.nodes[range.astStart + astIndex!] => constraint
        constraint.kind == 34 and constraint.parent >= 0
            -> if {
                package.nodes[range.astStart + constraint.parent] => clause
                clause.kind == 33 and clause.parent == functionAst
                    -> if {
                        0 => significant!
                        false => matches!
                        false => colon!
                        false => integer!
                        constraint.firstToken => tokenIndex!
                        tokenIndex! < constraint.firstToken + constraint.tokenCount
                            -> while {
                                package.tokens[range.tokenStart + tokenIndex!] => token
                                token.kind != grammar.triviaIdWhitespace() and token.kind != grammar.triviaIdComment()
                                    -> if {
                                        significant! == 0 -> if {
                                            (package.sources[sourceModule] -> slice(token.span.start, token.span.length)) == genericName => matches!
                                        }
                                        significant! == 1 -> if { token.kind == grammar.tokenIdColon() => colon! }
                                        significant! == 2 -> if {
                                            token.kind == grammar.tokenIdIdentifier()
                                                and (package.sources[sourceModule] -> slice(token.span.start, token.span.length)) == "Int" => integer!
                                        }
                                        significant! + 1 => significant!
                                    }
                                tokenIndex! + 1 => tokenIndex!
                            }
                        matches! and colon! -> if {
                            integer! and significant! == 3 => valueGeneric
                            valueGeneric -> return
                        }
                    }
            }
        astIndex! + 1 => astIndex!
    }
    false
}

signatureRootIsArray package: ref analysis.PackageAnalysis, range: analysis.SourceAnalysisRange, typeAst: Int -> Bool {
    package.nodes[range.astStart + typeAst] => node
    node.firstToken => tokenIndex!
    tokenIndex! < node.firstToken + node.tokenCount
        -> while {
            package.tokens[range.tokenStart + tokenIndex!].kind => kind
            kind != grammar.triviaIdWhitespace() and kind != grammar.triviaIdComment()
                -> if {
                    kind == grammar.tokenIdLeftBracket() => arrayRoot
                    arrayRoot -> return
                }
            tokenIndex! + 1 => tokenIndex!
        }
    false
}

firstGenericInputUsageDiagnostic package: ref analysis.PackageAnalysis -> SignatureTypeDiagnostic {
    SignatureTypeDiagnostic { code: 0, sourceModule: -1, functionSymbol: -1, typeAst: -1, nameToken: -1, genericToken: -1 } => valid
    [Int; ~] => genericTokenByAst!
    package.nodes -> each node { genericTokenByAst! -> push(-1) }
    package.ranges -> each indexedRange {
        0 => astIndex!
        astIndex! < indexedRange.astCount -> while {
            package.nodes[indexedRange.astStart + astIndex!] => node
            node.kind == 32 and node.parent >= 0 -> if {
                node.payloadToken => genericTokenByAst![indexedRange.astStart + node.parent]
            }
            astIndex! + 1 => astIndex!
        }
    }
    0 => sourceModule!
    sourceModule! < (package.ranges -> len) -> while {
        package.ranges[sourceModule!] => range
        0 => functionIndex!
        functionIndex! < range.symbolCount -> while {
            package.symbols[range.symbolStart + functionIndex!] => function
            function.kind == 7 or function.kind == 31 -> if {
                package.nodes[range.astStart + function.astNode] => declaration
                genericTokenByAst![range.astStart + function.astNode] => genericToken
                genericToken >= 0 -> if {
                    function.typeNode => inputType!
                    function.kind == 7 and function.flags / 16 % 2 == 1
                        -> if { -1 => inputType! }
                    function.kind == 31 -> if {
                        -1 => inputType!
                        declaration.secondaryToken >= 0 and function.parent >= 0
                            -> if { package.symbols[range.symbolStart + function.parent].typeNode => inputType! }
                    }
                    inputType! >= 0 and not (package -> signatureFirstGenericIsValue(sourceModule!, function.astNode, genericToken))
                        and not (package -> signatureTypeReferencesGeneric(sourceModule!, functionIndex!, inputType!, 3))
                        and not (package -> signatureTypeReferencesGeneric(sourceModule!, functionIndex!, function.blockResultTypeNode, 1))
                        -> if {
                            false => additionalReference!
                            0 => parameterIndex!
                            parameterIndex! < range.symbolCount -> while {
                                package.symbols[range.symbolStart + parameterIndex!] => parameter
                                parameter.kind == 35 and parameter.parent == functionIndex!
                                    and package.nodes[range.astStart + parameter.astNode].kind == 60
                                    and (package -> signatureTypeReferencesGeneric(sourceModule!, functionIndex!, parameter.typeNode, 0))
                                    -> if { true => additionalReference! }
                                parameterIndex! + 1 => parameterIndex!
                            }
                            not additionalReference! -> if {
                                SignatureTypeDiagnostic { code: 2, sourceModule: sourceModule!, functionSymbol: functionIndex!, typeAst: inputType!, nameToken: function.nameToken, genericToken: genericToken } -> return
                            }
                        }
                }
            }
            functionIndex! + 1 => functionIndex!
        }
        sourceModule! + 1 => sourceModule!
    }
    valid
}

signatureDeclarationDiagnosticFirst package: ref analysis.PackageAnalysis, declarationDiagnostic: SignatureTypeDiagnostic, typeDiagnostic: SignatureTypeDiagnostic -> SignatureTypeDiagnostic {
    declarationDiagnostic.code == 0 -> if { typeDiagnostic -> return }
    declarationDiagnostic.sourceModule < typeDiagnostic.sourceModule
        -> if { declarationDiagnostic -> return }
    declarationDiagnostic.sourceModule == typeDiagnostic.sourceModule
        -> if {
            package.ranges[typeDiagnostic.sourceModule] => range
            package.symbols[range.symbolStart + declarationDiagnostic.functionSymbol].astNode => declarationAst
            package.symbols[range.symbolStart + typeDiagnostic.functionSymbol].astNode => typeDeclarationAst
            package.nodes[range.astStart + declarationAst].start <= package.nodes[range.astStart + typeDeclarationAst].start
                -> if { declarationDiagnostic -> return }
        }
    typeDiagnostic
}

# Signature types have a declaration owner before expression inference or IR.
# Every composite signature role preserves declared generic templates; concrete
# instantiations and generic constraints retain their separate semantic owners.
# Mutable input admission is a declaration decision, even for an unused body.
# A generic element does not change its outer storage shape: slices and enums
# remain invalid mutable inputs. Only a bare type parameter defers admission.
mutableInputTypeAdmitted prepared: ref semanticContext.SemanticSnapshot, typeId: Int -> Bool {
    prepared.semantic.types[typeId] => inputType
    inputType.kind == 1 and inputType.origin == 3
        -> if { true -> return }
    inputType.kind == 3 or inputType.kind == 4 or inputType.kind == 5
        or inputType.kind == 12 or inputType.kind == 13 or inputType.kind == 14
        -> if { true -> return }
    # C# stores Set as a dictionary and Deque/BinaryHeap as dynamic arrays.
    inputType.kind == 7 and inputType.origin == 4
        and inputType.symbol >= 5 and inputType.symbol <= 7
        -> if { true -> return }
    inputType.kind == 1 and inputType.origin == 1 and inputType.symbol == 15
        -> if { true -> return }
    (inputType.kind == 1 or inputType.kind == 7)
        and inputType.module >= 0 and inputType.module < (prepared.package.ranges -> len)
        -> if {
            prepared.package.ranges[inputType.module] => ownerRange
            inputType.symbol >= 0 and inputType.symbol < ownerRange.symbolCount
                -> if {
                    prepared.package.symbols[ownerRange.symbolStart + inputType.symbol].kind == 3 -> return
                }
        }
    false
}

# Inferred top-level signatures belong to one external consuming scope. Calls
# from the function itself do not count; repeated calls by one owner count once.
# Local signatures are constrained in their lexical scope instead.
public firstInferredFunctionConsumerDiagnostic prepared: ref semanticContext.SemanticSnapshot -> SignatureTypeDiagnostic {
    prepared.package.ranges -> each range {
        0 => functionIndex!
        functionIndex! < range.symbolCount -> while {
            prepared.package.symbols[range.symbolStart + functionIndex!] => function
            function.kind == 7 and function.parent < 0
                and (function.flags / 16 % 2 == 1 or function.flags / 32 % 2 == 1)
                -> if {
                    -2 => firstOwner!
                    false => multipleOwners!
                    0 => callIndex!
                    callIndex! < (prepared.calls -> len) and not multipleOwners!
                        -> while {
                            prepared.calls[callIndex!] => call
                            call.status == 0 and call.origin != 2
                                and call.targetSourceModule == range.sourceModule and call.functionSymbol == functionIndex!
                                -> if {
                                    prepared.package.ranges[call.sourceModule] => callerRange
                                    call.callAst => ownerAst!
                                    false => ownerFound!
                                    ownerAst! >= 0 and not ownerFound! -> while {
                                        prepared.package.nodes[callerRange.astStart + ownerAst!] => owner
                                        owner.kind == 7 or owner.kind == 31
                                            -> if { true => ownerFound! } else { owner.parent => ownerAst! }
                                    }
                                    not (call.sourceModule == range.sourceModule and ownerAst! == function.astNode)
                                        -> if {
                                            ownerAst! < 0 -> if { -1 } else { callerRange.astStart + ownerAst! } => ownerIdentity
                                            firstOwner! == -2 -> if { ownerIdentity => firstOwner! } else {
                                                firstOwner! != ownerIdentity -> if { true => multipleOwners! }
                                            }
                                        }
                                }
                            callIndex! + 1 => callIndex!
                        }
                    firstOwner! == -2 or multipleOwners! -> if {
                        multipleOwners! -> if { 7 } else { 6 } => code
                        SignatureTypeDiagnostic { code: code, sourceModule: range.sourceModule, functionSymbol: functionIndex!, typeAst: -1, nameToken: function.nameToken, genericToken: -1 } -> return
                    }
                }
            functionIndex! + 1 => functionIndex!
        }
    }
    SignatureTypeDiagnostic { code: 0, sourceModule: -1, functionSymbol: -1, typeAst: -1, nameToken: -1, genericToken: -1 }
}

public firstPreparedNominalSignatureDiagnostic prepared: ref semanticContext.SemanticSnapshot -> SignatureTypeDiagnostic {
    SignatureTypeDiagnostic { code: 0, sourceModule: -1, functionSymbol: -1, typeAst: -1, nameToken: -1, genericToken: -1 } => selected!
    [Int; ~] => statusByAst!
    prepared.package.nodes -> each node { statusByAst! -> push(0) }
    prepared.semantic.references -> each reference {
        reference.typeAst >= 0 -> if {
            prepared.package.ranges[reference.sourceModule] => range
            reference.status => statusByAst![range.astStart + reference.typeAst]
        }
    }
    prepared.package.ranges -> each range {
        0 => termIndex!
        termIndex! < range.termCount -> while {
            prepared.package.terms[range.termStart + termIndex!] => term
            term.kind == 1 and term.nameToken >= 0 and statusByAst![range.astStart + term.astNode] == 2
                -> if {
                    # Qualified paths retain their own module/visibility diagnostic.
                    prepared.package.nodes[range.astStart + term.astNode] => annotation
                    false => qualified!
                    annotation.firstToken => pathToken!
                    pathToken! < annotation.firstToken + annotation.tokenCount
                        -> while {
                            prepared.package.tokens[range.tokenStart + pathToken!].kind == grammar.tokenIdDot()
                                -> if { true => qualified! }
                            pathToken! + 1 => pathToken!
                        }
                    -1 => owner!
                    0 => symbolIndex!
                    symbolIndex! < range.symbolCount and owner! < 0
                        -> while {
                            prepared.package.symbols[range.symbolStart + symbolIndex!] => symbol
                            symbol.kind == 7 or symbol.kind == 31 or (symbol.kind == 35 and symbol.parent >= 0
                                and (prepared.package.symbols[range.symbolStart + symbol.parent].kind == 7
                                or prepared.package.symbols[range.symbolStart + symbol.parent].kind == 31))
                                -> if {
                                    [symbol.typeNode, symbol.secondaryTypeNode, symbol.blockTypeNode, symbol.blockResultTypeNode] => roots
                                    roots -> each root {
                                        root >= 0 and (prepared.package -> semanticContext.declarationAncestor(range.sourceModule, root, term.astNode))
                                            -> if {
                                                symbol.kind == 35 -> if { symbol.parent } else { symbolIndex! } => owner!
                                            }
                                    }
                                }
                            symbolIndex! + 1 => symbolIndex!
                        }
                    owner! >= 0 and not qualified!
                        and not (prepared.package -> signatureTypeReferencesGeneric(range.sourceModule, owner!, term.astNode, 0))
                        -> if {
                            prepared.package -> typeIds.openNominalTypeCandidates(prepared.modules, prepared.imports, prepared.resolvedImports, range.sourceModule, term.nameToken) => candidates
                            (candidates -> len) > 1 -> if { 9 } else { 8 } => code
                            prepared.package.symbols[range.symbolStart + owner!] => function
                            SignatureTypeDiagnostic { code: code, sourceModule: range.sourceModule, functionSymbol: owner!, typeAst: term.astNode, nameToken: function.nameToken, genericToken: term.nameToken } => diagnostic
                            code == 9 -> if { diagnostic -> return }
                            selected!.code == 0 -> if { diagnostic => selected! }
                        }
                }
            termIndex! + 1 => termIndex!
        }
    }
    selected!
}

public firstPreparedSignatureTypeDiagnostic prepared: ref semanticContext.SemanticSnapshot -> SignatureTypeDiagnostic {
    prepared -> firstPreparedNominalSignatureDiagnostic => nominalDiagnostic
    # Import ambiguity is a path-resolution error before semantic admission.
    nominalDiagnostic.code == 9 -> if { nominalDiagnostic -> return }
    prepared -> firstPreparedExplicitSignatureTypeDiagnostic => explicitDiagnostic
    explicitDiagnostic.code == 0 -> if { nominalDiagnostic } else { explicitDiagnostic }
}

# Unchecked emission preserves its explicit-signature contract. Nominal path
# admission belongs to checked preparation, where source paths and candidate
# identities remain available and rejection precedes typed IR construction.
public firstPreparedExplicitSignatureTypeDiagnostic prepared: ref semanticContext.SemanticSnapshot -> SignatureTypeDiagnostic {
    # Public signatures are explicit before body inference, just as in the
    # managed compiler. The AST records omitted primary and return slots.
    prepared.package.ranges -> each range {
        0 => functionIndex!
        functionIndex! < range.symbolCount -> while {
            prepared.package.symbols[range.symbolStart + functionIndex!] => function
            function.kind == 7 and function.flags / 4 % 2 == 1
                and (function.flags / 16 % 2 == 1 or function.flags / 32 % 2 == 1)
                -> if {
                    SignatureTypeDiagnostic { code: 5, sourceModule: range.sourceModule, functionSymbol: functionIndex!, typeAst: -1, nameToken: function.nameToken, genericToken: -1 } -> return
                }
            functionIndex! + 1 => functionIndex!
        }
    }
    prepared.package -> firstSignatureTypeDiagnostic => selected!
    [Int; ~] => referenceByAst!
    prepared.package.nodes -> each node { referenceByAst! -> push(-1) }
    prepared.semantic.references -> each reference {
        reference.status == 0 and reference.typeAst >= 0
            and reference.typeId >= 0 and reference.typeId < (prepared.semantic.types -> len)
            -> if {
                prepared.package.ranges[reference.sourceModule] => range
                reference.typeId => referenceByAst![range.astStart + reference.typeAst]
            }
    }
    prepared.package.ranges -> each range {
        0 => symbolIndex!
        symbolIndex! < range.symbolCount -> while {
            prepared.package.symbols[range.symbolStart + symbolIndex!] => input
            input.kind == 27 and input.parent >= 0 and input.parent < range.symbolCount
                and prepared.package.symbols[range.symbolStart + input.parent].kind == 4
                and input.typeNode >= 0 -> if {
                    referenceByAst![range.astStart + input.typeNode] => payloadTypeId
                    payloadTypeId >= 0 and payloadTypeId < (prepared.semantic.types -> len)
                        -> if {
                            prepared.semantic.types[payloadTypeId] => payloadType
                            payloadType.kind == 1 and payloadType.origin == 1 and payloadType.symbol == 0
                                -> if {
                                    SignatureTypeDiagnostic { code: 4, sourceModule: range.sourceModule, functionSymbol: input.parent, typeAst: input.typeNode, nameToken: input.nameToken, genericToken: -1 } => rejected
                                    selected!.code == 0 -> if { rejected => selected! } else {
                                        prepared.package -> signatureDeclarationDiagnosticFirst(selected!, rejected) => selected!
                                    }
                                }
                        }
                }
            -1 => functionSymbol!
            input.kind == 7 -> if { symbolIndex! => functionSymbol! }
            input.kind == 35 and input.parent >= 0 and input.parent < range.symbolCount
                -> if {
                    prepared.package.symbols[range.symbolStart + input.parent].kind == 7
                        or prepared.package.symbols[range.symbolStart + input.parent].kind == 31
                        -> if { input.parent => functionSymbol! }
                }
            functionSymbol! >= 0 and input.flags / 2 % 2 == 1 and input.typeNode >= 0
                and prepared.package.symbols[range.symbolStart + functionSymbol!].flags / 128 % 2 == 0
                -> if {
                    referenceByAst![range.astStart + input.typeNode] => inputTypeId
                    inputTypeId >= 0 and not (prepared -> mutableInputTypeAdmitted(inputTypeId))
                        -> if {
                            SignatureTypeDiagnostic { code: 3, sourceModule: range.sourceModule, functionSymbol: functionSymbol!, typeAst: input.typeNode, nameToken: input.nameToken, genericToken: -1 } => rejected
                            selected!.code == 0 -> if { rejected => selected! } else {
                                prepared.package -> signatureDeclarationDiagnosticFirst(selected!, rejected) => selected!
                            }
                        }
                }
            symbolIndex! + 1 => symbolIndex!
        }
    }
    selected!
}

public firstSignatureTypeDiagnostic package: ref analysis.PackageAnalysis -> SignatureTypeDiagnostic {
    package -> firstGenericInputUsageDiagnostic => declarationDiagnostic
    [Int; ~] => ownerByTypeAst!
    [Int; ~] => nameTokenByTypeAst!
    [Bool; ~] => templateAllowedByTypeAst!
    package.nodes -> each node {
        ownerByTypeAst! -> push(-1)
        nameTokenByTypeAst! -> push(-1)
        templateAllowedByTypeAst! -> push(false)
    }
    0 => sourceModule!
    sourceModule! < (package.ranges -> len) -> while {
        package.ranges[sourceModule!] => range
        0 => symbolIndex!
        symbolIndex! < range.symbolCount -> while {
            package.symbols[range.symbolStart + symbolIndex!] => symbol
            symbol.kind == 7 or symbol.kind == 31 -> if {
                symbol.typeNode >= 0 -> if {
                    symbolIndex! => ownerByTypeAst![range.astStart + symbol.typeNode]
                    symbol.nameToken => nameTokenByTypeAst![range.astStart + symbol.typeNode]
                    symbol.kind == 7 and symbol.flags / 16 % 2 == 0
                        or (package -> signatureRootIsArray(range, symbol.typeNode)) => templateAllowedByTypeAst![range.astStart + symbol.typeNode]
                }
                symbol.secondaryTypeNode >= 0 -> if {
                    symbolIndex! => ownerByTypeAst![range.astStart + symbol.secondaryTypeNode]
                    symbol.nameToken => nameTokenByTypeAst![range.astStart + symbol.secondaryTypeNode]
                    package -> signatureRootIsArray(range, symbol.secondaryTypeNode) => templateAllowedByTypeAst![range.astStart + symbol.secondaryTypeNode]
                }
                symbol.blockTypeNode >= 0 -> if {
                    symbolIndex! => ownerByTypeAst![range.astStart + symbol.blockTypeNode]
                    symbol.nameToken => nameTokenByTypeAst![range.astStart + symbol.blockTypeNode]
                    true => templateAllowedByTypeAst![range.astStart + symbol.blockTypeNode]
                }
                symbol.blockResultTypeNode >= 0 -> if {
                    symbolIndex! => ownerByTypeAst![range.astStart + symbol.blockResultTypeNode]
                    symbol.nameToken => nameTokenByTypeAst![range.astStart + symbol.blockResultTypeNode]
                    true => templateAllowedByTypeAst![range.astStart + symbol.blockResultTypeNode]
                }
            }
            symbol.kind == 35 and symbol.parent >= 0 and symbol.typeNode >= 0
                and package.nodes[range.astStart + symbol.astNode].kind == 60
                -> if {
                    package.symbols[range.symbolStart + symbol.parent].kind => parentKind
                    parentKind == 7 or parentKind == 31 -> if {
                        symbol.parent => ownerByTypeAst![range.astStart + symbol.typeNode]
                        symbol.nameToken => nameTokenByTypeAst![range.astStart + symbol.typeNode]
                        true => templateAllowedByTypeAst![range.astStart + symbol.typeNode]
                    }
                }
            symbolIndex! + 1 => symbolIndex!
        }
        0 => termIndex!
        termIndex! < range.termCount -> while {
            package.terms[range.termStart + termIndex!] => term
            term.kind == 4 and term.lengthToken >= 0
                and package.tokens[range.tokenStart + term.lengthToken].kind == grammar.tokenIdIdentifier()
                -> if {
                    term.astNode => typeAst!
                    typeAst! >= 0 and ownerByTypeAst![range.astStart + typeAst!] < 0
                        -> while { package.nodes[range.astStart + typeAst!].parent => typeAst! }
                    typeAst! >= 0 -> if {
                        ownerByTypeAst![range.astStart + typeAst!] => functionSymbol
                        templateAllowedByTypeAst![range.astStart + typeAst!]
                            and (package -> signatureTypeReferencesGeneric(sourceModule!, functionSymbol, typeAst!, 0)) => allowed
                        not allowed -> if {
                            SignatureTypeDiagnostic { code: 1, sourceModule: sourceModule!, functionSymbol: functionSymbol, typeAst: term.astNode, nameToken: nameTokenByTypeAst![range.astStart + typeAst!], genericToken: -1 } => typeDiagnostic
                            package -> signatureDeclarationDiagnosticFirst(declarationDiagnostic, typeDiagnostic) -> return
                        }
                    }
                }
            termIndex! + 1 => termIndex!
        }
        sourceModule! + 1 => sourceModule!
    }
    declarationDiagnostic
}

initializerValueAst typeByAst: ref [Int; ~], firstChild: ref [Int; ~], nextChild: ref [Int; ~], node: Int -> Int {
    typeByAst[node] >= 0 -> if { node -> return }
    firstChild[node] => child!
    child! >= 0 -> while {
        typeByAst -> initializerValueAst(firstChild, nextChild, child!) => value
        value >= 0 -> if { value -> return }
        nextChild[child!] => child!
    }
    -1
}

public firstNominalFieldMismatch package: ref analysis.PackageAnalysis, resolved: ref expressionTypeIds.ExpressionTypeIdSet -> NominalFieldMismatchDiagnostic {
    NominalFieldMismatchDiagnostic { sourceModule: -1, initializerAst: -1, valueAst: -1, fieldIndex: -1, actualTypeId: -1 } => valid
    [Int; ~] => typeByAst!
    [Int; ~] => firstChild!
    [Int; ~] => lastChild!
    [Int; ~] => nextChild!
    [Int; ~] => firstFieldByOwner!
    [Int; ~] => nextField!
    resolved.types -> each typeSlot { firstFieldByOwner! -> push(-1) }
    0 => indexedField!
    indexedField! < (resolved.fields -> len) -> while {
        resolved.fields[indexedField!] => field
        -1 => next!
        field.status == 0 and field.ownerType >= 0 and field.ownerType < (resolved.types -> len)
            -> if {
                firstFieldByOwner![field.ownerType] => next!
                indexedField! => firstFieldByOwner![field.ownerType]
            }
        nextField! -> push(next!)
        indexedField! + 1 => indexedField!
    }
    package.nodes -> each nodeSlot {
        typeByAst! -> push(-1)
        firstChild! -> push(-1)
        lastChild! -> push(-1)
        nextChild! -> push(-1)
    }
    resolved.expressions -> each expression {
        expression.status == 0 and expression.typeId >= 0
            -> if {
                package.ranges[expression.sourceModule] => range
                expression.typeId => typeByAst![range.astStart + expression.astNode]
            }
    }
    package.ranges -> each range {
        0 => astIndex!
        astIndex! < range.astCount -> while {
            range.astStart + astIndex! => globalAst
            package.nodes[globalAst].parent => parentAst
            parentAst >= 0 -> if {
                range.astStart + parentAst => parentGlobal
                firstChild![parentGlobal] < 0 -> if {
                    globalAst => firstChild![parentGlobal]
                } else { globalAst => nextChild![lastChild![parentGlobal]] }
                globalAst => lastChild![parentGlobal]
            }
            astIndex! + 1 => astIndex!
        }
    }
    0 => sourceModule!
    sourceModule! < (package.ranges -> len) -> while {
        package.ranges[sourceModule!] => range
        0 => initializerAst!
        initializerAst! < range.astCount -> while {
            range.astStart + initializerAst! => initializerGlobal
            package.nodes[initializerGlobal] => initializer
            initializer.kind == 40 and initializer.parent >= 0
                and resolved.activeDeclarationBodyByAst[initializerGlobal]
                -> if {
                    initializer.parent => literalAst!
                    literalAst! >= 0 and package.nodes[range.astStart + literalAst!].kind != 39
                        -> while { package.nodes[range.astStart + literalAst!].parent => literalAst! }
                    literalAst! >= 0 and typeByAst![range.astStart + literalAst!] >= 0
                        -> if {
                            typeByAst![range.astStart + literalAst!] => ownerType
                            package.tokens[range.tokenStart + initializer.payloadToken] => label
                            firstChild![initializerGlobal] => valueRoot
                            valueRoot >= 0 -> if {
                                typeByAst! -> initializerValueAst(firstChild!, nextChild!, valueRoot) => valueGlobal
                                valueGlobal >= 0 -> if {
                                    resolved.types -> typeIds.materializedReadTypeId(typeByAst![valueGlobal]) => actualTypeId
                                    resolved.types[actualTypeId] => actualType
                                    actualType.kind == 1 and actualType.origin != 1 and not actualType.containsParameter
                                        -> if {
                                            firstFieldByOwner![ownerType] => fieldIndex!
                                            fieldIndex! >= 0 -> while {
                                                resolved.fields[fieldIndex!] => field
                                                field.status == 0 and field.ownerType == ownerType and field.fieldSymbol >= 0
                                                    -> if {
                                                        package.ranges[field.sourceModule] => fieldRange
                                                        package.symbols[fieldRange.symbolStart + field.fieldSymbol] => fieldSymbol
                                                        package.tokens[fieldRange.tokenStart + fieldSymbol.nameToken] => fieldName
                                                        label.span.length == fieldName.span.length => sameName!
                                                        UIntSize(0) => byteIndex!
                                                        sameName! and byteIndex! < label.span.length -> while {
                                                            (package.sources[sourceModule!] -> byte(label.span.start + byteIndex!)) != (package.sources[field.sourceModule] -> byte(fieldName.span.start + byteIndex!))
                                                                -> if { false => sameName! }
                                                            byteIndex! + 1 => byteIndex!
                                                        }
                                                        resolved.types[field.fieldType] => expectedType
                                                        sameName! and expectedType.kind == 1 and expectedType.origin != 1
                                                            and not expectedType.containsParameter
                                                            and (expectedType.module != actualType.module or expectedType.symbol != actualType.symbol)
                                                            -> if {
                                                                NominalFieldMismatchDiagnostic {
                                                                    sourceModule: sourceModule!
                                                                    initializerAst: initializerAst!
                                                                    valueAst: valueGlobal - range.astStart
                                                                    fieldIndex: fieldIndex!
                                                                    actualTypeId: actualTypeId
                                                                } -> return
                                                            }
                                                    }
                                                nextField![fieldIndex!] => fieldIndex!
                                            }
                                        }
                                }
                            }
                        }
                }
            initializerAst! + 1 => initializerAst!
        }
        sourceModule! + 1 => sourceModule!
    }
    valid
}

public struct MemberFieldCollisionDiagnostic {
    public sourceModule: Int
    public functionSymbol: Int
    public ownerType: Int
}

public firstMemberFieldCollision package: ref analysis.PackageAnalysis, ir: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], references: ref [typeIds.TypeReference; ~], referenceIndexByTypeAst: ref [Int; ~], fields: ref [typeIds.NominalField; ~] -> MemberFieldCollisionDiagnostic {
    0 => functionIndex!
    functionIndex! < (ir -> len) -> while {
        ir[functionIndex!] => function
        function.kind == 0
            and function.sourceModule >= 0 and function.sourceModule < (package.ranges -> len)
            and function.symbol >= 0 -> if {
                package.ranges[function.sourceModule] => functionRange
                package.symbols[functionRange.symbolStart + function.symbol] => declaration
                -1 => ownerTypeId!
                function.operand1 >= 0 and function.operand1 < (ir -> len)
                    -> if {
                        ir[function.operand1].typeId => ownerTypeId!
                    }
                (ownerTypeId! < 0 or ownerTypeId! >= (types -> len)
                    or types[ownerTypeId!].kind != 1
                    or (types[ownerTypeId!].origin != 0 and types[ownerTypeId!].origin != 2))
                    and declaration.parent >= 0 and declaration.parent < functionRange.symbolCount
                    -> if {
                        package.symbols[functionRange.symbolStart + declaration.parent] => parent
                        parent.kind == 6 and parent.astNode >= 0 and parent.astNode < functionRange.astCount
                            -> if {
                                package -> typeIds.implOwnerTypeId(references, referenceIndexByTypeAst, function.sourceModule, parent.astNode) => ownerTypeId!
                            }
                    }
                ownerTypeId! >= 0 and ownerTypeId! < (types -> len)
                    and types[ownerTypeId!].kind == 1
                    and (types[ownerTypeId!].origin == 0 or types[ownerTypeId!].origin == 2)
                    -> if {
                        declaration.nameToken >= 0 -> if {
                            package.tokens[functionRange.tokenStart + declaration.nameToken] => functionName
                            0 => fieldIndex!
                            fieldIndex! < (fields -> len) -> while {
                                fields[fieldIndex!] => field
                                field.status == 0 and field.ownerType == ownerTypeId!
                                    and field.sourceModule >= 0 and field.sourceModule < (package.ranges -> len)
                                    -> if {
                                        package.ranges[field.sourceModule] => fieldRange
                                        field.labelToken => fieldNameToken!
                                        field.fieldSymbol >= 0 -> if {
                                            package.symbols[fieldRange.symbolStart + field.fieldSymbol].nameToken => fieldNameToken!
                                        }
                                        fieldNameToken! >= 0 -> if {
                                            package.tokens[fieldRange.tokenStart + fieldNameToken!] => fieldName
                                            functionName.span.length == fieldName.span.length
                                                -> if {
                                                    true => equal!
                                                    UIntSize(0) => byteIndex!
                                                    byteIndex! < functionName.span.length -> while {
                                                        (package.sources[function.sourceModule] -> byte(functionName.span.start + byteIndex!)) != (package.sources[field.sourceModule] -> byte(fieldName.span.start + byteIndex!))
                                                            -> if { false => equal! }
                                                        byteIndex! + 1 => byteIndex!
                                                    }
                                                    equal! -> if {
                                                        MemberFieldCollisionDiagnostic {
                                                            sourceModule: function.sourceModule
                                                            functionSymbol: function.symbol
                                                            ownerType: ownerTypeId!
                                                        } -> return
                                                    }
                                                }
                                        }
                                    }
                                fieldIndex! + 1 => fieldIndex!
                            }
                        }
                    }
            }
        functionIndex! + 1 => functionIndex!
    }
    MemberFieldCollisionDiagnostic { sourceModule: -1, functionSymbol: -1, ownerType: -1 }
}

public unresolvedInterpolationBindingByNode nodes: ref [interpolation.InterpolationNode; ~], uninvokedAssociatedMembers: ref [Bool; ~], missingAssociatedMembers: ref [Bool; ~], localEnumMemberStatusByNode: ref [Int; ~] -> [Bool; ~] {
    [Bool; ~] => associatedOwners!
    nodes -> each node { associatedOwners! -> push(false) }
    0 => memberIndex!
    memberIndex! < (nodes -> len) -> while {
        (uninvokedAssociatedMembers[memberIndex!] or missingAssociatedMembers[memberIndex!] or localEnumMemberStatusByNode[memberIndex!] > 0) and nodes[memberIndex!].operand0 >= 0
            -> if { true => associatedOwners![nodes[memberIndex!].operand0] }
        memberIndex! + 1 => memberIndex!
    }
    [Bool; ~] => unresolved!
    0 => nodeIndex!
    nodeIndex! < (nodes -> len) -> while {
        nodes[nodeIndex!] => node
        unresolved! -> push(node.kind == 1 and node.symbol < 0 and node.bareFunctionStatus < 0 and not associatedOwners![nodeIndex!])
        nodeIndex! + 1 => nodeIndex!
    }
    unresolved!
}

public uninvokedInterpolationFunctionByNode nodes: ref [interpolation.InterpolationNode; ~] -> [Bool; ~] {
    [Bool; ~] => uninvoked!
    nodes -> each node {
        uninvoked! -> push(node.kind == 1 and node.symbol < 0 and node.bareFunctionStatus >= 0)
    }
    uninvoked!
}

# The managed parser reports locations inside the parsed interpolation
# expression. Keep that fragment boundary in semantic diagnostics instead of
# converting an absolute source byte offset in the LLVM emitter.
public interpolationStringAst nodes: ref [ast.AstNode; ~], range: analysis.SourceAnalysisRange, fragments: ref [interpolation.InterpolationNode; ~], nodeIndex: Int -> Int {
    fragments[nodeIndex].sourceToken => sourceToken
    0 => astIndex!
    astIndex! < range.astCount -> while {
        nodes[range.astStart + astIndex!] => node
        node.kind == 13 and node.payloadToken == sourceToken
            -> if {
                astIndex! -> return
            }
        astIndex! + 1 => astIndex!
    }
    -1
}

public interpolationBelongsToMain nodes: ref [ast.AstNode; ~], range: analysis.SourceAnalysisRange, fragments: ref [interpolation.InterpolationNode; ~], nodeIndex: Int -> Bool {
    nodes -> interpolationStringAst(range, fragments, nodeIndex) => owner!
    owner! >= 0 and owner! < range.astCount -> while {
        nodes[range.astStart + owner!] => declaration
        declaration.kind == 8 -> if { true -> return }
        declaration.kind == 7 or declaration.kind == 31
            -> if { false -> return }
        declaration.parent => owner!
    }
    false
}

public interpolationFragmentLocation nodes: ref [interpolation.InterpolationNode; ~], source: Text, nodeIndex: Int -> syntaxDiagnostics.SourceLocation {
    nodeIndex => rootIndex!
    nodes[rootIndex!].parent >= 0 -> while {
        nodes[rootIndex!].parent => rootIndex!
    }
    nodes[rootIndex!] => root
    source -> slice(root.payloadStart, root.payloadLength) => fragment
    fragment -> syntaxDiagnostics.sourceLocation(nodes[nodeIndex].payloadStart - root.payloadStart)
}

public interpolationSourceOffsetLocation nodes: ref [interpolation.InterpolationNode; ~], source: Text, nodeIndex: Int, sourceOffset: UIntSize -> syntaxDiagnostics.SourceLocation {
    nodeIndex => rootIndex!
    nodes[rootIndex!].parent >= 0 -> while { nodes[rootIndex!].parent => rootIndex! }
    nodes[rootIndex!] => root
    source -> slice(root.payloadStart, root.payloadLength) => fragment
    fragment -> syntaxDiagnostics.sourceLocation(sourceOffset - root.payloadStart)
}

# The parser records a binary expression's operator token separately from its
# source span. Preserve that offset in interpolation IR for C# locations.
public interpolationExpressionLocation nodes: ref [interpolation.InterpolationNode; ~], source: Text, nodeIndex: Int -> syntaxDiagnostics.SourceLocation {
    nodeIndex => rootIndex!
    nodes[rootIndex!].parent >= 0 -> while { nodes[rootIndex!].parent => rootIndex! }
    nodes[rootIndex!] => root
    source -> slice(root.payloadStart, root.payloadLength) => fragment
    fragment -> syntaxDiagnostics.sourceLocation(nodes[nodeIndex].diagnosticStart - root.payloadStart)
}

public interpolationIndexExpressionLocation nodes: ref [interpolation.InterpolationNode; ~], source: Text, nodeIndex: Int -> syntaxDiagnostics.SourceLocation {
    nodeIndex => rootIndex!
    nodes[rootIndex!].parent >= 0 -> while { nodes[rootIndex!].parent => rootIndex! }
    nodes[rootIndex!] => root
    nodes[nodes[nodeIndex].operand0] => owner
    source -> slice(root.payloadStart, root.payloadLength) => fragment
    fragment -> syntaxDiagnostics.sourceLocation(owner.payloadStart + owner.payloadLength - root.payloadStart)
}

public interpolationCallTargetLocation nodes: ref [interpolation.InterpolationNode; ~], source: Text, nodeIndex: Int -> syntaxDiagnostics.SourceLocation {
    nodeIndex => rootIndex!
    nodes[rootIndex!].parent >= 0 -> while {
        nodes[rootIndex!].parent => rootIndex!
    }
    nodes[rootIndex!] => root
    source -> slice(root.payloadStart, root.payloadLength) => fragment
    fragment -> syntaxDiagnostics.sourceLocation(nodes[nodeIndex].callNameStart - root.payloadStart)
}

public unresolvedInterpolationBindingLocation nodes: ref [interpolation.InterpolationNode; ~], source: Text, nodeIndex: Int -> syntaxDiagnostics.SourceLocation {
    nodes[nodeIndex] => binding
    binding.payloadStart > 0 and (source -> byte(binding.payloadStart - 1)) == 36
        -> if { source -> syntaxDiagnostics.sourceLocation(binding.payloadStart - 1) -> return }
    nodes -> interpolationFragmentLocation(source, nodeIndex)
}

public expressionBelongsToMain nodes: ref [ast.AstNode; ~], range: analysis.SourceAnalysisRange, expressionAst: Int -> Bool {
    expressionAst => ancestor!
    ancestor! >= 0 and ancestor! < range.astCount
        -> while {
            nodes[range.astStart + ancestor!] => owner
            owner.kind == 8 -> if { true -> return }
            owner.parent => ancestor!
        }
    false
}

public unresolvedInterpolationCallByNode nodes: ref [interpolation.InterpolationNode; ~], importedTargets: ref [Int; ~], invalidCollectionIndexExpectedTypeByNode: ref [Int; ~] -> [Bool; ~] {
    [Bool; ~] => unresolved!
    0 => nodeIndex!
    nodeIndex! < (nodes -> len) -> while {
        nodes[nodeIndex!] => call
        call.kind == 10 and importedTargets[nodeIndex!] == -1 => isUnresolved!
        isUnresolved! and call.operand0 >= 0 and call.operand0 < (nodes -> len)
            and nodes[call.operand0].kind == 7
            and invalidCollectionIndexExpectedTypeByNode[call.operand0] >= 0
            -> if { false => isUnresolved! }
        unresolved! -> push(isUnresolved!)
        nodeIndex! + 1 => nodeIndex!
    }
    unresolved!
}

# Arguments, like mapped byte views, has a UIntSize index contract. Preserve
# this semantic decision before LLVM consumes the prepared interpolation nodes.
public invalidArgumentsInterpolationIndexByNode nodes: ref [interpolation.InterpolationNode; ~], ranges: ref [interpolation.InterpolationSourceRange; ~], ir: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~] -> [Bool; ~] {
    [Bool; ~] => invalid!
    0 => nodeIndex!
    nodeIndex! < (nodes -> len) -> while {
        false => isInvalid!
        nodes[nodeIndex!] => indexed
        indexed.kind == 7 and indexed.operand0 >= 0 and indexed.operand1 >= 0
            -> if {
                nodes[indexed.operand0] => owner
                nodes[indexed.operand1] => index
                owner.kind == 1 and owner.symbol >= 0 and index.kind != 0
                    -> if {
                        -1 => sourceModule!
                        ranges -> each range {
                            nodeIndex! >= range.nodeStart and nodeIndex! < range.nodeStart + range.nodeCount
                                -> if { range.sourceModule => sourceModule! }
                        }
                        -1 => indexBuiltin!
                        index.kind == 1 -> if {
                            0 => indexBindingSearch!
                            indexBindingSearch! < (ir -> len) -> while {
                                ir[indexBindingSearch!] => indexBinding
                                sourceModule! >= 0 and indexBinding.sourceModule == sourceModule!
                                    and indexBinding.symbol == index.symbol
                                    and (indexBinding.kind == 10 or indexBinding.kind == 17 or indexBinding.kind == 29)
                                    and indexBinding.typeId >= 0 and indexBinding.typeId < (types -> len)
                                    -> if {
                                        types[indexBinding.typeId] => indexType
                                        indexType.kind == 1 and indexType.origin == 1
                                            -> if { indexType.symbol => indexBuiltin! }
                                    }
                                indexBindingSearch! + 1 => indexBindingSearch!
                            }
                        }
                        0 => bindingIndex!
                        bindingIndex! < (ir -> len) -> while {
                            ir[bindingIndex!] => binding
                            sourceModule! >= 0 and binding.sourceModule == sourceModule!
                                and binding.symbol == owner.symbol
                                and (binding.kind == 10 or binding.kind == 17 or binding.kind == 29)
                                and binding.typeId >= 0 and binding.typeId < (types -> len)
                                -> if {
                                    types[binding.typeId] => ownerType
                                    ownerType.kind == 1 and ownerType.origin == 1 and ownerType.symbol == 16
                                        and ((index.kind == 9 and index.typeSymbol >= 0 and index.typeSymbol != 13)
                                        or index.kind == 4
                                        or (index.kind == 1 and indexBuiltin! >= 0 and indexBuiltin! != 13))
                                        -> if { true => isInvalid! }
                                }
                            bindingIndex! + 1 => bindingIndex!
                        }
                    }
            }
        invalid! -> push(isInvalid!)
        nodeIndex! + 1 => nodeIndex!
    }
    invalid!
}

public struct UnresolvedMutableNameDiagnostic {
    public sourceModule: Int
    public span: syntax.SourceSpan
    public ownInitializer: Bool
}

# A read of a name whose owner was consumed is a semantic name-visibility
# failure. The diagnostic shape belongs to semantic analysis even when a
# later ownership pass supplies evidence for a complex transfer.
public struct ConsumedBindingReadDiagnostic {
    public sourceModule: Int
    public astNode: Int
    public span: syntax.SourceSpan
}

# The semantic snapshot marks definite same-block reads after a declared move
# before expression typing. Convert that source fact to the same diagnostic
# shape used by the later ownership check for control and collection cases.
public consumedBindingReadsFromAst package: ref analysis.PackageAnalysis, readByAst: ref [Bool; ~], contextualLabels: ref [Bool; ~] -> [ConsumedBindingReadDiagnostic; ~] {
    [ConsumedBindingReadDiagnostic; ~] => diagnostics!
    0 => sourceIndex!
    sourceIndex! < (package.ranges -> len) -> while {
        package.ranges[sourceIndex!] => range
        0 => nameIndex!
        nameIndex! < range.nameCount -> while {
            package.names[range.nameStart + nameIndex!] => name
            name.astNode >= 0 and name.astNode < range.astCount
                and name.nameToken >= 0 and name.nameToken < range.tokenCount
                and readByAst[range.astStart + name.astNode]
                and not contextualLabels[range.astStart + name.astNode]
                -> if {
                    package.tokens[range.tokenStart + name.nameToken] => token
                    diagnostics! -> push(ConsumedBindingReadDiagnostic {
                        sourceModule: sourceIndex!
                        astNode: name.astNode
                        span: token.span
                    })
                }
            nameIndex! + 1 => nameIndex!
        }
        sourceIndex! + 1 => sourceIndex!
    }
    diagnostics!
}

# The resolver is authoritative for a name's exact mutable suffix. Report a
# bare name only when an in-scope mutable local with that base spelling exists
# but the exact name AST has no resolved symbol. Mutable parameters are bare
# by design and are not candidates here.
public unresolvedMutableLocalReads package: ref analysis.PackageAnalysis -> [UnresolvedMutableNameDiagnostic; ~] {
    [Bool; ~] => resolvedByAst!
    0 => astSeed!
    astSeed! < (package.nodes -> len) -> while {
        resolvedByAst! -> push(false)
        astSeed! + 1 => astSeed!
    }
    0 => sourceIndex!
    sourceIndex! < (package.ranges -> len) -> while {
        package.ranges[sourceIndex!] => range
        0 => nameIndex!
        nameIndex! < range.nameCount -> while {
            package.names[range.nameStart + nameIndex!] => name
            name.astNode >= 0 and name.astNode < range.astCount
                -> if { true => resolvedByAst![range.astStart + name.astNode] }
            nameIndex! + 1 => nameIndex!
        }
        sourceIndex! + 1 => sourceIndex!
    }
    [UnresolvedMutableNameDiagnostic; ~] => diagnostics!
    0 => sourceIndex!
    sourceIndex! < (package.ranges -> len) -> while {
        package.ranges[sourceIndex!] => range
        0 => astIndex!
        astIndex! < range.astCount -> while {
            package.nodes[range.astStart + astIndex!] => nameAst
            nameAst.kind == 15 and nameAst.payloadToken >= 0
                and nameAst.payloadToken < range.tokenCount
                and not resolvedByAst![range.astStart + astIndex!]
                and nameAst.parent >= 0
                and package.nodes[range.astStart + nameAst.parent].kind != 36
                and package.nodes[range.astStart + nameAst.parent].kind != 38
                and package.nodes[range.astStart + nameAst.parent].kind != 41
                -> if {
                    package.tokens[range.tokenStart + nameAst.payloadToken] => nameToken
                    # A binding is never visible inside its own initializer.
                    # Keep that reason distinct from a visible mutable local
                    # whose read merely omitted the required suffix.
                    -1 => bindingOwnerAst!
                    nameAst.parent => ownerAst!
                    ownerAst! >= 0 and bindingOwnerAst! < 0 -> while {
                        package.nodes[range.astStart + ownerAst!] => ownerNode
                        ownerNode.kind == 9 or ownerNode.kind == 61
                            -> if { ownerAst! => bindingOwnerAst! } else { ownerNode.parent => ownerAst! }
                    }
                    false => matchedMutableLocal!
                    false => ownInitializerMutable!
                    0 => symbolIndex!
                    symbolIndex! < range.symbolCount and not matchedMutableLocal!
                        -> while {
                            package.symbols[range.symbolStart + symbolIndex!] => candidate
                            (candidate.kind == 9 or candidate.kind == 61)
                                and candidate.flags % 2 == 1
                                and candidate.astNode >= 0
                                and candidate.astNode < range.astCount
                                and candidate.nameToken >= 0
                                and candidate.nameToken < range.tokenCount
                                and package.nodes[range.astStart + candidate.astNode].start < nameAst.start
                                -> if {
                                    package.tokens[range.tokenStart + candidate.nameToken] => candidateName
                                    nameToken.span.length == candidateName.span.length => sameBaseName!
                                    UIntSize(0) => byteIndex!
                                    sameBaseName! and byteIndex! < nameToken.span.length
                                        -> while {
                                            package.sources[sourceIndex!]
                                                -> byte(nameToken.span.start + byteIndex!) => nameByte
                                            package.sources[sourceIndex!]
                                                -> byte(candidateName.span.start + byteIndex!) => candidateByte
                                            nameByte != candidateByte -> if { false => sameBaseName! }
                                            byteIndex! + 1 => byteIndex!
                                        }
                                    sameBaseName! -> if {
                                        candidate.astNode == bindingOwnerAst! -> if {
                                            true => ownInitializerMutable!
                                        } else {
                                            package.nodes[range.astStart + candidate.astNode].parent => bindingScope
                                            nameAst.parent => visibleScope!
                                            visibleScope! >= 0 and not matchedMutableLocal!
                                                -> while {
                                                    visibleScope! == bindingScope
                                                        -> if { true => matchedMutableLocal! }
                                                    package.nodes[range.astStart + visibleScope!].parent => visibleScope!
                                                }
                                        }
                                    }
                                }
                            symbolIndex! + 1 => symbolIndex!
                        }
                    matchedMutableLocal! or ownInitializerMutable!
                        -> if {
                            diagnostics! -> push(UnresolvedMutableNameDiagnostic {
                                sourceModule: sourceIndex!
                                span: nameToken.span
                                ownInitializer: not matchedMutableLocal!
                            })
                        }
                }
            astIndex! + 1 => astIndex!
        }
        sourceIndex! + 1 => sourceIndex!
    }
    diagnostics!
}

# Code 1 identifies a duplicate declaration in the same lexical owner.
# Code 2 identifies an unresolved name expression.
# Code 3 identifies break/continue without an enclosing while.
public analyze source: Text -> [SemanticDiagnostic; ~] {
    source -> ast.lower => nodes
    nodes -> symbols.collectPrepared => table
    source -> lexer.lex => tokens
    [SemanticDiagnostic; ~] => diagnostics!
    table -> len => symbolCount
    0 => symbolIndex!

    symbolIndex! < symbolCount -> while {
        table[symbolIndex!] => current
        -1 => duplicateOf!
        0 => candidateIndex!
        candidateIndex! < symbolIndex! and duplicateOf! < 0
            -> while {
                table[candidateIndex!] => candidate
                current.kind != 48 and candidate.kind != 48 and current.parent == candidate.parent
                    -> if {
                        tokens[current.nameToken] => currentName
                        tokens[candidate.nameToken] => candidateName
                        currentName.span.length == candidateName.span.length => namesEqual!
                        UIntSize(0) => nameByte!
                        namesEqual! and nameByte! < currentName.span.length
                            -> while {
                                source -> byte(currentName.span.start + nameByte!) => currentByte
                                source -> byte(candidateName.span.start + nameByte!) => candidateByte
                                currentByte != candidateByte -> if {
                                    false => namesEqual!
                                }
                                nameByte! + 1 => nameByte!
                            }
                        namesEqual! -> if {
                            not ((current.kind == 9 or current.kind == 61) and (candidate.kind == 9 or candidate.kind == 61) and current.flags == 1 and candidate.flags == 1)
                                -> if {
                                    candidateIndex! => duplicateOf!
                                }
                        }
                    }
                candidateIndex! + 1 => candidateIndex!
            }
        duplicateOf! >= 0 -> if {
            tokens[current.nameToken] => duplicateName
            SemanticDiagnostic {
                code: 1
                symbol: symbolIndex!
                previousSymbol: duplicateOf!
                span: duplicateName.span
            } => diagnostic
            diagnostics! -> push(diagnostic)
        }
        symbolIndex! + 1 => symbolIndex!
    }

    source -> resolution.resolve => resolved
    nodes -> len => astCount
    resolved -> len => resolvedCount
    0 => diagnosticAstIndex!
    diagnosticAstIndex! < astCount -> while {
        nodes[diagnosticAstIndex!] => nameAst
        nameAst.kind == 15 -> if {
            false => nameResolved!
            0 => resolutionIndex!
            resolutionIndex! < resolvedCount -> while {
                resolved[resolutionIndex!].astNode == diagnosticAstIndex!
                    -> if {
                        true => nameResolved!
                    }
                resolutionIndex! + 1 => resolutionIndex!
            }
            not nameResolved! -> if {
                tokens[nameAst.payloadToken] => unresolvedName
                SemanticDiagnostic {
                    code: 2
                    symbol: -1
                    previousSymbol: -1
                    span: unresolvedName.span
                } => unresolvedDiagnostic
                diagnostics! -> push(unresolvedDiagnostic)
            }
        }
        nameAst.kind == 45 or nameAst.kind == 46 -> if {
            nameAst.parent => loopOwner!
            false => hasLoopOwner!
            loopOwner! >= 0 and not hasLoopOwner! -> while {
                nodes[loopOwner!].kind == 44 -> if { true => hasLoopOwner! } else { nodes[loopOwner!].parent => loopOwner! }
            }
            not hasLoopOwner! -> if {
                tokens[nameAst.payloadToken] => loopControlToken
                diagnostics! -> push(SemanticDiagnostic {
                    code: 3
                    symbol: -1
                    previousSymbol: -1
                    span: loopControlToken.span
                })
            }
        }
        diagnosticAstIndex! + 1 => diagnosticAstIndex!
    }

    diagnostics!
}

# Expression operand validity belongs to semantic type commitment. The emitter
# consumes this single decision after Typed IR lowering; it does not infer a
# second answer from provisional IR fields.
public struct ExpressionOperandDiagnostic {
    public code: Int
    public sourceModule: Int
    public astNode: Int
    public operandAst: Int
    public operatorKind: Int
    public locationOffset: UIntSize
    # Code 32 carries the missing closed-capability bit in this payload.
    public operandTypeSymbol: Int
    public operandTypeId: Int
    public firstTypeId: Int
}

public struct RedundantNumericConversion {
    public sourceModule: Int
    public conversionAst: Int
    public literalAst: Int
    public typeSymbol: Int
}

public struct NumericCallArgumentDiagnostic {
    # 5 identifies a concrete value passed to a generic box input.
    public code: Int
    public sourceModule: Int
    public argumentAst: Int
    public callAst: Int
    public targetSourceModule: Int
    public functionSymbol: Int
    public parameterSymbol: Int
    public parameterOrdinal: Int
    public genericParameterSymbol: Int
    public expectedTypeId: Int
    public actualTypeId: Int
}

# C# validates a numeric literal against the declared call parameter before
# lowering. Preserve that source decision even when later IR retags the value.
public struct NumericCallLiteralDiagnostic {
    # 0 valid, 1 out of integer range, 2 CodePoint surrogate,
    # 3 non-integer spelling for an integer parameter.
    public code: Int
    public sourceModule: Int
    public locationAst: Int
    public literalAst: Int
    public expectedSymbol: Int
    public negative: Bool
}

public struct CallOwnershipDiagnostic {
    # 0 valid, 1 immutable root, 2 direct temporary, 3 flowed temporary,
    # 4 readonly reference without an addressable owner or reference.
    public code: Int
    public sourceModule: Int
    public argumentAst: Int
    public callAst: Int
    public targetSourceModule: Int
    public functionSymbol: Int
    public rootAst: Int
}

public emptyCallOwnershipDiagnostic: -> CallOwnershipDiagnostic => CallOwnershipDiagnostic {
    code: 0, sourceModule: -1, argumentAst: -1, callAst: -1,
    targetSourceModule: -1, functionSymbol: -1, rootAst: -1
}

public struct OwnedIndexReadDiagnostic {
    public sourceModule: Int
    public indexAst: Int
    public elementTypeId: Int
    public dictionary: Bool
}

public firstOwnedIndexReadDiagnostic prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, ownedStorageByType: ref [Bool; ~] -> OwnedIndexReadDiagnostic {
    OwnedIndexReadDiagnostic { sourceModule: -1, indexAst: -1, elementTypeId: -1, dictionary: false } => selected!
    prepared.package -> semanticContext.indexExpressionSourceAsts => sourceByAst
    [Int; ~] => typeByAst!
    [Bool; ~] => readonlyByAst!
    prepared.package.nodes -> each node {
        typeByAst! -> push(-1)
        readonlyByAst! -> push(false)
    }
    resolved.expressions -> each expression {
        expression.status == 0 -> if {
            prepared.package.ranges[expression.sourceModule] => range
            expression.typeId => typeByAst![range.astStart + expression.astNode]
        }
    }
    resolved.callArguments -> each argument {
        # Call target and parameter identity are already resolved. An implicit
        # self has no type AST, so expected-type readiness must not hide its
        # declared readonly ownership.
        argument.parameterSymbol >= 0 -> if {
            prepared.package.ranges[argument.targetSourceModule] => targetRange
            prepared.package.symbols[targetRange.symbolStart + argument.parameterSymbol] => parameter
            parameter.flags % 4 == 0 -> if {
                prepared.package.ranges[argument.sourceModule] => range
                true => readonlyByAst![range.astStart + argument.argumentAst]
            }
        }
    }
    prepared.package.ranges -> each range {
        prepared.package.sources[range.sourceModule] -> len => sourceLength
        prepared.package.sources[range.sourceModule] -> slice(UIntSize(0), sourceLength) => source
        0 => flowAst!
        flowAst! < range.astCount -> while {
            sourceByAst[range.astStart + flowAst!] => sourceAst
            sourceAst >= 0 and (source -> calls.readonlyIntrinsicFlowSource(range.sourceModule, flowAst!, prepared.package.nodes, range.astStart, range.astCount, prepared.package.tokens, range.tokenStart, prepared.calls))
                -> if { true => readonlyByAst![range.astStart + sourceAst] }
            flowAst! + 1 => flowAst!
        }
    }
    # Index and member sources remain places. Only the final projection can
    # escape; its committed type decides whether storage ownership is involved.
    # This is the source equivalent of C#'s allowOwnedElementBorrow recursion,
    # including non-call binding and return consumers.
    resolved.expressions -> each expression {
        expression.status == 0 and expression.typeId >= 0
            and ownedStorageByType[expression.typeId]
            and (prepared -> declarationBodyIsActive(resolved, expression.sourceModule, expression.astNode))
            -> if {
                prepared.package.ranges[expression.sourceModule] => range
                prepared.package.nodes[range.astStart + expression.astNode] => expressionNode
                readonlyByAst![range.astStart + expression.astNode] => remainsPlace!
                false => flowSource!
                expressionNode.parent >= 0 -> if {
                    prepared.package.nodes[range.astStart + expressionNode.parent] => parent
                    parent.kind == 10 and sourceByAst[range.astStart + expressionNode.parent] == expression.astNode
                        -> if { true => flowSource! }
                    (parent.kind == 36 or parent.kind == 41)
                        and sourceByAst[range.astStart + expressionNode.parent] == expression.astNode
                        -> if { true => remainsPlace! }
                }
                not remainsPlace! -> if {
                    expression.astNode => indexAst!
                    indexAst! >= 0 and prepared.package.nodes[range.astStart + indexAst!].kind == 36
                        -> while { sourceByAst[range.astStart + indexAst!] => indexAst! }
                    indexAst! >= 0 and prepared.package.nodes[range.astStart + indexAst!].kind == 41
                        -> if {
                            typeByAst![range.astStart + indexAst!] => elementTypeId
                            sourceByAst[range.astStart + indexAst!] => sourceAst
                            elementTypeId >= 0 and ownedStorageByType[elementTypeId] and sourceAst >= 0
                                and (prepared.package -> diagnosticOriginBefore(expression.sourceModule, indexAst!, selected!.sourceModule, selected!.indexAst))
                                -> if {
                                    typeByAst![range.astStart + sourceAst] => containerTypeId
                                    containerTypeId >= 0 -> if {
                                        resolved.types -> typeIds.materializedReadTypeId(containerTypeId) => readTypeId
                                        resolved.types[readTypeId] => containerType
                                        # C# directly reads slice elements without the
                                        # owned-container extraction check. An owned
                                        # field projected from that element still
                                        # follows the separate field-access check.
                                        containerType.kind != 2 or expressionNode.kind == 36
                                            -> if {
                                                OwnedIndexReadDiagnostic {
                                                    sourceModule: expression.sourceModule,
                                                    indexAst: flowSource! -> if { expression.astNode } else { indexAst! },
                                                    elementTypeId: flowSource! -> if { expression.typeId } else { elementTypeId },
                                                    dictionary: not flowSource! and (containerType.kind == 5 or containerType.kind == 13)
                                                } => selected!
                                            }
                                    }
                                }
                        }
                }
            }
    }
    selected!
}

public struct DictionaryKeyDiagnostic {
    public sourceModule: Int
    public locationAst: Int
    public nameToken: Int
    public keyTypeId: Int
}

dictionaryKeyTraitEligible prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, keyTypeId: Int, traitName: Text, methodName: Text -> Bool {
    resolved.types[keyTypeId] => owner
    prepared.package.sources[owner.module] -> len => sourceLength
    prepared.package.sources[owner.module] -> slice(UIntSize(0), sourceLength) => source
    keyTypeId -> typeIds.nominalTraitMethodSymbol(traitName, methodName, prepared.package.ranges, prepared.package.nodes, prepared.package.tokens, prepared.package.symbols, source, prepared.modules, resolved.types) => methodSymbol
    methodSymbol < 0 -> if { false -> return }
    prepared.package.ranges[owner.module] => range
    prepared.package.symbols[range.symbolStart + methodSymbol] => method
    method.flags % 4 != 0 or method.typeNode < 0 -> if { false -> return }
    resolved.referenceIndexByTypeAst[range.astStart + method.typeNode] => referenceIndex
    referenceIndex < 0 -> if { false -> return }
    resolved.references[referenceIndex] => result
    result.status != 0 or result.typeId < 0 -> if { false -> return }
    resolved.types[result.typeId] => resultType
    resultType.kind == 1 and resultType.origin == 1 and resultType.symbol == 2
}

public supportedDictionaryKeyType prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, keyTypeId: Int -> Bool {
    keyTypeId < 0 or keyTypeId >= (resolved.types -> len)
        -> if { false -> return }
    resolved.types[keyTypeId] => key
    key.kind == 1 and key.origin == 1 -> if {
        key.symbol -> typeIds.canonicalBuiltinSymbol => symbol
        (symbol == 1 or (symbol >= 2 and symbol <= 4) or symbol == 6 or (symbol >= 8 and symbol <= 14)) -> return
    }
    key.kind != 1 or key.module < 0 -> if { false -> return }
    prepared.package.ranges[key.module] => range
    prepared.package.symbols[range.symbolStart + key.symbol] => declaration
    declaration.kind != 3 and declaration.kind != 4
        -> if { false -> return }
    (prepared -> dictionaryKeyTraitEligible(resolved, keyTypeId, "Hash", "hash"))
        and (prepared -> dictionaryKeyTraitEligible(resolved, keyTypeId, "Eq", "eq"))
}

storedDictionaryKeyDiagnostic prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, typeId: Int -> Int {
    typeId < 0 or typeId >= (resolved.types -> len)
        -> if { -1 -> return }
    resolved.types[typeId] => type
    type.status != 0 -> if { -1 -> return }
    prepared -> storedDictionaryKeyDiagnostic(resolved, type.first) => first
    first >= 0 -> if { first -> return }
    prepared -> storedDictionaryKeyDiagnostic(resolved, type.second) => second
    second >= 0 -> if { second -> return }
    (type.kind == 5 or type.kind == 13)
        and not (prepared -> supportedDictionaryKeyType(resolved, type.first))
        -> if { type.first -> return }
    -1
}

public firstDictionaryKeyDiagnostic prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet -> DictionaryKeyDiagnostic {
    DictionaryKeyDiagnostic { sourceModule: -1, locationAst: -1, nameToken: -1, keyTypeId: -1 } => selected!
    [Int; ~] => typeByAst!
    prepared.package.nodes -> each node { typeByAst! -> push(-1) }
    resolved.references -> each reference {
        reference.status == 0 and reference.typeAst >= 0
            -> if {
                prepared.package.ranges[reference.sourceModule] => range
                reference.typeId => typeByAst![range.astStart + reference.typeAst]
            }
    }
    resolved.expressions -> each expression {
        expression.status == 0 -> if {
            prepared.package.ranges[expression.sourceModule] => range
            expression.typeId => typeByAst![range.astStart + expression.astNode]
        }
    }
    prepared.package.ranges -> each range {
        # Declarations own admission before a dictionary value is constructed.
        # Primary input/return use the function origin; additional input uses
        # its parameter origin. Stored fields and payloads retain their names,
        # matching the independent managed compiler's construction check.
        0 => declarationIndex!
        declarationIndex! < range.symbolCount -> while {
            prepared.package.symbols[range.symbolStart + declarationIndex!] => declaration
            declaration.kind == 26 or declaration.kind == 5 => storedType
            declaration.kind == 7 or declaration.kind == 31 or declaration.kind == 35 or storedType
                -> if {
                    [declaration.typeNode, declaration.secondaryTypeNode,
                    declaration.blockTypeNode, declaration.blockResultTypeNode] -> each typeAst {
                        typeAst >= 0 -> if {
                            typeByAst![range.astStart + typeAst] => typeId
                            typeId >= 0 -> if {
                                resolved.types[typeId] => type
                                -1 => invalidKey!
                                storedType -> if {
                                    prepared -> storedDictionaryKeyDiagnostic(resolved, typeId) => invalidKey!
                                } else {
                                    (type.kind == 5 or type.kind == 13)
                                        and not (prepared -> supportedDictionaryKeyType(resolved, type.first))
                                        -> if { type.first => invalidKey! }
                                }
                                invalidKey! >= 0
                                    and (prepared.package -> diagnosticOriginBefore(range.sourceModule, declaration.astNode, selected!.sourceModule, selected!.locationAst))
                                    -> if {
                                        DictionaryKeyDiagnostic {
                                            sourceModule: range.sourceModule
                                            locationAst: declaration.astNode
                                            nameToken: declaration.kind == 35 or storedType
                                                -> if { declaration.nameToken } else { -1 }
                                            keyTypeId: invalidKey!
                                        } => selected!
                                    }
                            }
                        }
                    }
                }
            declarationIndex! + 1 => declarationIndex!
        }
        0 => literalAst!
        literalAst! < range.astCount -> while {
            prepared.package.nodes[range.astStart + literalAst!] => literal
            typeByAst![range.astStart + literalAst!] => literalTypeId
            literal.kind == 38 and literalTypeId >= 0
                and (prepared -> declarationBodyIsActive(resolved, range.sourceModule, literalAst!))
                -> if {
                    resolved.types[literalTypeId] => literalType
                    literalType.kind == 5 or literalType.kind == 13
                        -> if {
                            -1 => locationAst!
                            literalType.first => keyTypeId!
                            0 => childAst!
                            0 => itemOrdinal!
                            childAst! < range.astCount -> while {
                                prepared.package.nodes[range.astStart + childAst!] => child
                                child.parent == literalAst! -> if {
                                    child.kind == 12 -> if {
                                        not (prepared -> supportedDictionaryKeyType(resolved, keyTypeId!))
                                            -> if { literalAst! => locationAst! }
                                    } else {
                                        locationAst! < 0 and itemOrdinal! % 2 == 0 -> if {
                                            typeByAst![range.astStart + childAst!] => itemType
                                            itemType >= 0 and not (prepared -> supportedDictionaryKeyType(resolved, itemType))
                                                -> if {
                                                    childAst! => locationAst!
                                                    itemType => keyTypeId!
                                                }
                                        }
                                        itemOrdinal! + 1 => itemOrdinal!
                                    }
                                }
                                childAst! + 1 => childAst!
                            }
                            locationAst! >= 0 and (prepared.package -> diagnosticOriginBefore(range.sourceModule, locationAst!, selected!.sourceModule, selected!.locationAst))
                                -> if { DictionaryKeyDiagnostic { sourceModule: range.sourceModule, locationAst: locationAst!, nameToken: -1, keyTypeId: keyTypeId! } => selected! }
                        }
                }
            literalAst! + 1 => literalAst!
        }
    }
    selected!
}

# Argument eligibility belongs to the resolved source contract. Lowered IR
# retains the separate overlapping-borrow and live-reference analysis.
public firstCallOwnershipDiagnostic prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, traits: ref [Int; ~] -> CallOwnershipDiagnostic {
    emptyCallOwnershipDiagnostic() => selected!
    [Int; ~] => sourceByAst!
    [Int; ~] => symbolByAst!
    prepared.package.nodes -> each node {
        sourceByAst! -> push(-1)
        symbolByAst! -> push(-1)
    }
    prepared.package.ranges -> each range {
        0 => localAst!
        localAst! < range.astCount -> while {
            prepared.package.nodes[range.astStart + localAst!] => node
            node.parent >= 0 and node.start == prepared.package.nodes[range.astStart + node.parent].start
                -> if { localAst! => sourceByAst![range.astStart + node.parent] }
            localAst! + 1 => localAst!
        }
        0 => nameIndex!
        nameIndex! < range.nameCount -> while {
            prepared.package.names[range.nameStart + nameIndex!] => name
            name.astNode >= 0 and name.symbol >= 0
                -> if { name.symbol => symbolByAst![range.astStart + name.astNode] }
            nameIndex! + 1 => nameIndex!
        }
    }
    resolved.callArguments -> each argument {
        argument.status == 0 and argument.parameterSymbol >= 0
            and (resolved.types -> typeIds.functionArgumentCompatible(argument.actualTypeId, argument.expectedTypeId))
            and (prepared -> declarationBodyIsActive(resolved, argument.sourceModule, argument.argumentAst))
            -> if {
                prepared.package.ranges[argument.targetSourceModule] => targetRange
                prepared.package.symbols[targetRange.symbolStart + argument.parameterSymbol] => parameter
                prepared.package.symbols[targetRange.symbolStart + argument.functionSymbol] => function
                resolved.types[argument.expectedTypeId].kind == 8
                    and resolved.types[argument.actualTypeId].kind != 8 => readonlyBorrow
                (parameter.flags / 2 % 2 == 1 and function.flags / 128 % 2 == 0) or readonlyBorrow
                    -> if {
                        prepared.package.ranges[argument.sourceModule] => range
                        argument.argumentAst => rootAst!
                        false => priorOperandFailure!
                        rootAst! >= 0 and (prepared.package.nodes[range.astStart + rootAst!].kind == 36 or prepared.package.nodes[range.astStart + rootAst!].kind == 41)
                            -> while {
                                # Reading an owned indexed element has its own earlier
                                # source rule; this later parameter rule must not mask it.
                                prepared.package.nodes[range.astStart + rootAst!].kind == 41 and traits[argument.actualTypeId] % 2 == 1
                                    -> if { true => priorOperandFailure! }
                                sourceByAst![range.astStart + rootAst!] => rootAst!
                            }
                        0 => code!
                        readonlyBorrow -> if {
                            rootAst! < 0 -> if { 4 => code! } else {
                                prepared.package.nodes[range.astStart + rootAst!].kind != 15
                                    or symbolByAst![range.astStart + rootAst!] < 0
                                    -> if { 4 => code! }
                            }
                        } else {
                            rootAst! >= 0 and prepared.package.nodes[range.astStart + rootAst!].kind == 15
                                -> if {
                                    symbolByAst![range.astStart + rootAst!] => ownerSymbol
                                    ownerSymbol >= 0 and not (prepared.package -> mutableBorrowOwnerSymbol(argument.sourceModule, prepared.package.symbols[range.symbolStart + ownerSymbol]))
                                        -> if { 1 => code! }
                                } else {
                                    2 => code!
                                    argument.parameterOrdinal == 0 and prepared.package.nodes[range.astStart + argument.callAst].kind == 10
                                        -> if {
                                            3 => code!
                                            prepared.package.nodes[range.astStart + argument.argumentAst] => input
                                            (input.kind == 37 or input.kind == 38) and traits[argument.actualTypeId] % 2 == 1
                                                -> if { true => priorOperandFailure! }
                                        }
                                }
                        }
                        code! > 0 and not priorOperandFailure!
                            and (prepared.package -> diagnosticOriginBefore(argument.sourceModule, argument.argumentAst, selected!.sourceModule, selected!.argumentAst))
                            -> if {
                                CallOwnershipDiagnostic {
                                    code: code!, sourceModule: argument.sourceModule,
                                    argumentAst: argument.argumentAst, callAst: argument.callAst,
                                    targetSourceModule: argument.targetSourceModule,
                                    functionSymbol: argument.functionSymbol, rootAst: rootAst!
                                } => selected!
                            }
                    }
            }
    }
    selected!
}

# Field inference keeps the committed contextual record as its diagnostic owner.
public contextualRecordDiagnosticOwner package: ref analysis.PackageAnalysis, resolved: ref expressionTypeIds.ExpressionTypeIdSet, diagnostic: ExpressionOperandDiagnostic -> Int {
    diagnostic.code <= 0 or diagnostic.sourceModule < 0
        or diagnostic.sourceModule >= (package.ranges -> len)
        -> if { -1 -> return }
    package.ranges[diagnostic.sourceModule] => range
    diagnostic.astNode => ancestor!
    ancestor! >= 0 and ancestor! < range.astCount
        -> while {
            package.nodes[range.astStart + ancestor!].kind == 38
                -> if {
                    resolved.expressions -> each expression {
                        expression.status == 0 and expression.sourceModule == diagnostic.sourceModule
                            and expression.astNode == ancestor!
                            and (package -> expressionTypeIds.nominalStructType(resolved.types, expression.typeId))
                            -> if { ancestor! -> return }
                    }
                }
            package.nodes[range.astStart + ancestor!].parent => ancestor!
        }
    -1
}

public firstDeclarationRootDiagnostic package: ref analysis.PackageAnalysis, binding: BindingDeclarationDiagnostic, literal: NumericCallLiteralDiagnostic, argument: NumericCallArgumentDiagnostic, nominal: NominalFieldMismatchDiagnostic, ownership: CallOwnershipDiagnostic, dictionaryKey: DictionaryKeyDiagnostic, ownedIndex: OwnedIndexReadDiagnostic, arity: CallArityDiagnostic -> Int {
    package -> firstDeclarationRootDiagnosticWithOwnedBinding(binding, literal, argument, nominal, ownership, dictionaryKey, ownedIndex, arity, -1, -1, 0, -1, -1, 0, -1)
}

public firstDeclarationRootDiagnosticWithOwnedBinding package: ref analysis.PackageAnalysis, binding: BindingDeclarationDiagnostic, literal: NumericCallLiteralDiagnostic, argument: NumericCallArgumentDiagnostic, nominal: NominalFieldMismatchDiagnostic, ownership: CallOwnershipDiagnostic, dictionaryKey: DictionaryKeyDiagnostic, ownedIndex: OwnedIndexReadDiagnostic, arity: CallArityDiagnostic, ownedSource: Int, ownedAst: Int, ownedCode: Int, contextualSource: Int, contextualAst: Int, contextualCode: Int, contextualOwnerAst: Int -> Int {
    0 => selected!
    -1 => source!
    -1 => location!
    literal.code > 0 -> if {
        2 => selected!
        literal.sourceModule => source!
        literal.locationAst => location!
    }
    argument.code > 0 and (package -> diagnosticOriginBefore(argument.sourceModule, argument.argumentAst, source!, location!))
        -> if {
            3 => selected!
            argument.sourceModule => source!
            argument.argumentAst => location!
        }
    nominal.sourceModule >= 0 and (package -> diagnosticOriginBefore(nominal.sourceModule, nominal.initializerAst, source!, location!))
        -> if {
            4 => selected!
            nominal.sourceModule => source!
            nominal.initializerAst => location!
        }
    ownedIndex.sourceModule >= 0 and (package -> diagnosticOriginBefore(ownedIndex.sourceModule, ownedIndex.indexAst, source!, location!))
        -> if {
            8 => selected!
            ownedIndex.sourceModule => source!
            ownedIndex.indexAst => location!
        }
    ownership.code > 0 and (package -> diagnosticOriginBefore(ownership.sourceModule, ownership.argumentAst, source!, location!))
        -> if {
            6 => selected!
            ownership.sourceModule => source!
            ownership.argumentAst => location!
        }
    dictionaryKey.sourceModule >= 0 and (package -> diagnosticOriginBefore(dictionaryKey.sourceModule, dictionaryKey.locationAst, source!, location!))
        -> if {
            7 => selected!
            dictionaryKey.sourceModule => source!
            dictionaryKey.locationAst => location!
        }
    binding.code > 0 and (package -> diagnosticOriginBefore(binding.sourceModule, binding.valueAst, source!, location!))
        -> if {
            5 => selected!
            binding.sourceModule => source!
            binding.valueAst => location!
        }
    arity.sourceModule >= 0 and (package -> diagnosticOriginBefore(arity.sourceModule, arity.callAst, source!, location!))
        -> if {
            9 => selected!
            arity.sourceModule => source!
            arity.callAst => location!
        }
    contextualAst => contextualOrigin!
    contextualOwnerAst >= 0 -> if { contextualOwnerAst => contextualOrigin! }
    contextualSource >= 0 and contextualCode > 0
        and (contextualOwnerAst >= 0 or (contextualCode >= 33 and contextualCode <= 43))
        -> if {
            package -> diagnosticOriginBefore(contextualSource, contextualOrigin!, source!, location!) => contextualEarlier
            selected! == 4 and source! == contextualSource and location! == contextualOrigin! => sameContextualInitializer
            contextualEarlier or sameContextualInitializer
                -> if {
                    11 => selected!
                    contextualSource => source!
                    contextualOrigin! => location!
                }
        }
    ownedAst >= 0 -> if {
        package -> diagnosticOriginBefore(ownedSource, ownedAst, source!, location!) => ownedEarlier
        false => ownedSameBinding!
        source! >= 0 and source! == ownedSource -> if {
            package -> diagnosticBindingOrigin(source!, location!) => selectedBinding
            selectedBinding == ownedAst -> if { true => ownedSameBinding! }
        }
        # C# E17/E36 checks precede initializer inference. E34 follows it and
        # the existing collision/type checks, so existing roots win that tie.
        ownedEarlier or (ownedSameBinding! and (ownedCode == 17 or ownedCode == 36))
            -> if { 10 => selected! }
    }
    selected!
}

numericCallLiteralAt prepared: ref semanticContext.SemanticSnapshot, sourceModule: Int, expressionAst: Int, expectedSymbol: Int, pointerBitWidth: Int -> NumericCallLiteralDiagnostic {
    NumericCallLiteralDiagnostic { code: 0, sourceModule: -1, locationAst: -1, literalAst: -1, expectedSymbol: -1, negative: false } => valid
    prepared.package.ranges[sourceModule] => range
    expressionAst >= 0 and expressionAst < range.astCount
        -> unless { valid -> return }
    prepared.package.nodes[range.astStart + expressionAst] => expression
    -1 => literalAst!
    false => negative!
    expression.kind == 14 -> if { expressionAst => literalAst! }
    expression.kind == 22 and expression.operatorKind == grammar.tokenIdMinus()
        -> if {
            0 => childAst!
            childAst! < range.astCount and literalAst! < 0
                -> while {
                    prepared.package.nodes[range.astStart + childAst!] => child
                    child.parent == expressionAst and child.kind == 14
                        -> if {
                            childAst! => literalAst!
                            true => negative!
                        }
                    childAst! + 1 => childAst!
                }
        }
    literalAst! < 0 -> if { valid -> return }
    prepared.package.nodes[range.astStart + literalAst!] => literal
    prepared.package.sources[sourceModule] -> len => sourceLength
    prepared.package.sources[sourceModule] -> slice(UIntSize(0), sourceLength) => source
    literal.start + literal.length <= (source -> len)
        -> unless { valid -> return }
    (source -> byte(literal.start)) == 39 -> if {
        syntax.SourceSpan { fileId: sourceModule, start: literal.start, length: literal.length } => characterSpan
        source -> syntax.decodeCharacterLiteral(characterSpan) -> when {
            Some(value) {
                value -> numericLiteralRange.characterLiteralStatus(expectedSymbol, negative!) => characterStatus
                characterStatus == 1 -> if { valid -> return }
                NumericCallLiteralDiagnostic { code: 1, sourceModule: sourceModule, locationAst: expressionAst, literalAst: literalAst!, expectedSymbol: expectedSymbol, negative: negative! } -> return
            }
            None { valid -> return }
        }
    }
    source -> numericLiteralRange.literalUsesFloatingSyntax(literal.start, literal.start + literal.length)
        -> if {
            NumericCallLiteralDiagnostic { code: 3, sourceModule: sourceModule, locationAst: expressionAst, literalAst: literalAst!, expectedSymbol: expectedSymbol, negative: negative! } -> return
        }
    source -> numericLiteralRange.integerLiteralStatus(literal.start, literal.start + literal.length, expectedSymbol, pointerBitWidth, negative!, false, 0, 1) => status
    status == 1 -> if { valid -> return }
    status == 2 -> if {
        NumericCallLiteralDiagnostic { code: 2, sourceModule: sourceModule, locationAst: expressionAst, literalAst: literalAst!, expectedSymbol: expectedSymbol, negative: negative! } -> return
    }
    NumericCallLiteralDiagnostic { code: 1, sourceModule: sourceModule, locationAst: expressionAst, literalAst: literalAst!, expectedSymbol: expectedSymbol, negative: negative! }
}

# Check committed binary contexts and every concrete generic instance before
# collapsing shared source facts into the final diagnostics.
public firstFinalNumericLiteralDiagnostic prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, ir: ref [typedIr.TypedIrNode; ~], instances: ref [typedIr.GenericFunctionInstance; ~], pointerBitWidth: Int -> NumericCallLiteralDiagnostic {
    NumericCallLiteralDiagnostic { code: 0, sourceModule: -1, locationAst: -1, literalAst: -1, expectedSymbol: -1, negative: false } => selected!
    # A binary peer also supplies context outside a generic clone. Reuse the
    # source value-edge walk rather than treating every IR literal as scalar:
    # container elements can carry provisional widths owned by their container.
    [Int; ~] => firstChild!
    [Int; ~] => lastChild!
    [Int; ~] => nextChild!
    prepared.package.nodes -> each slot {
        firstChild! -> push(-1)
        lastChild! -> push(-1)
        nextChild! -> push(-1)
    }
    prepared.package.ranges -> each range {
        0 => ast!
        ast! < range.astCount -> while {
            range.astStart + ast! => global
            prepared.package.nodes[global].parent => parent
            parent >= 0 -> if {
                range.astStart + parent => owner
                firstChild![owner] < 0 -> if { global => firstChild![owner] } else {
                    global => nextChild![lastChild![owner]]
                }
                global => lastChild![owner]
            }
            ast! + 1 => ast!
        }
    }
    ir -> each binary {
        binary.kind == 8 and binary.operand0 >= 0 and binary.operand0 < (ir -> len)
            and binary.operand1 >= 0 and binary.operand1 < (ir -> len)
            -> if {
                [binary.operand0, binary.operand1] -> each operand {
                    ir[operand] => value
                    operand == binary.operand0 -> if { binary.operand1 } else { binary.operand0 } => peer
                    (value.kind == 18 or value.kind == 33 or value.kind == 34)
                        and value.typeId >= 0 and value.typeId < (resolved.types -> len)
                        and value.typeId == ir[peer].typeId
                        and value.sourceModule >= 0 and value.sourceModule < (prepared.package.ranges -> len)
                        -> if {
                            resolved.types[value.typeId] => target
                            target.symbol -> typeIds.canonicalBuiltinSymbol => symbol
                            target.kind == 1 and target.origin == 1 and symbol >= 2 and symbol <= 14
                                -> if {
                                    prepared.package.ranges[value.sourceModule] => range
                                    value.astNode >= 0 and value.astNode < range.astCount
                                        and (prepared -> declarationBodyIsActive(resolved, value.sourceModule, value.astNode))
                                        -> if {
                                            prepared.package -> expressionTypeIds.contextualNumericValueAsts(firstChild!, nextChild!, range.astStart + value.astNode, true) => values
                                            values -> each global {
                                                prepared.package.nodes[global] => syntaxValue
                                                false => negativeLeaf!
                                                syntaxValue.kind == 14 and syntaxValue.parent >= 0
                                                    -> if {
                                                        prepared.package.nodes[range.astStart + syntaxValue.parent] => parent
                                                        parent.kind == 22 and parent.operatorKind == grammar.tokenIdMinus() => negativeLeaf!
                                                    }
                                                not negativeLeaf! -> if {
                                                    prepared -> numericCallLiteralAt(value.sourceModule, global - range.astStart, symbol, pointerBitWidth) => candidate
                                                    candidate.code > 0 -> if {
                                                        selected!.code == 0 or candidate.sourceModule < selected!.sourceModule
                                                            or (candidate.sourceModule == selected!.sourceModule and candidate.locationAst < selected!.locationAst)
                                                            -> if { candidate => selected! }
                                                    }
                                                }
                                            }
                                        }
                                }
                        }
                }
            }
    }
    instances -> each instance {
        0 => offset!
        instance.status == 0 and offset! < instance.nodeCount
            -> while {
                ir[instance.functionNode + offset!] => value
                ir[instance.templateNode + offset!] => template
                # Literal range belongs to a newly committed concrete context.
                # Unchanged template literals may belong to container element contexts.
                value.typeId != template.typeId -> if {
                    (value.kind == 3 or (value.kind == 7 and value.opcode == grammar.tokenIdMinus()))
                        and value.typeId >= 0 and value.typeId < (resolved.types -> len)
                        and value.sourceModule >= 0 and value.sourceModule < (prepared.package.ranges -> len)
                        -> if {
                            resolved.types[value.typeId] => target
                            target.symbol -> typeIds.canonicalBuiltinSymbol => symbol
                            target.kind == 1 and target.origin == 1 and symbol >= 2 and symbol <= 14
                                -> if {
                                    prepared.package.ranges[value.sourceModule] => range
                                    value.astNode >= 0 and value.astNode < range.astCount
                                        and (prepared -> declarationBodyIsActive(resolved, value.sourceModule, value.astNode))
                                        -> if {
                                            prepared.package.nodes[range.astStart + value.astNode] => syntaxValue
                                            false => negativeLeaf!
                                            syntaxValue.kind == 14 and syntaxValue.parent >= 0 and syntaxValue.parent < range.astCount
                                                -> if {
                                                    prepared.package.nodes[range.astStart + syntaxValue.parent] => parent
                                                    parent.kind == 22 and parent.operatorKind == grammar.tokenIdMinus() => negativeLeaf!
                                                }
                                            not negativeLeaf! -> if {
                                                prepared -> numericCallLiteralAt(value.sourceModule, value.astNode, symbol, pointerBitWidth) => candidate
                                                candidate.code > 0 -> if {
                                                    selected!.code == 0 or candidate.sourceModule < selected!.sourceModule
                                                        or (candidate.sourceModule == selected!.sourceModule and candidate.locationAst < selected!.locationAst)
                                                        -> if { candidate => selected! }
                                                }
                                            }
                                        }
                                }
                        }
                }
                offset! + 1 => offset!
            }
    }
    selected!
}

# The finalized semantic call target, not the provisional IR width, supplies
# the context for both direct literals and value-if branch terminal literals.
public firstNumericCallLiteralDiagnostic prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, pointerBitWidth: Int -> NumericCallLiteralDiagnostic {
    NumericCallLiteralDiagnostic { code: 0, sourceModule: -1, locationAst: -1, literalAst: -1, expectedSymbol: -1, negative: false } => selected!
    prepared.package -> expressionTypeIds.declaredNumericReturnContextByAst(resolved.types, resolved.references) => returnContexts
    prepared.package.ranges -> each range {
        0 => astIndex!
        astIndex! < range.astCount -> while {
            returnContexts[range.astStart + astIndex!] => expectedTypeId
            expectedTypeId >= 0 and (prepared -> declarationBodyIsActive(resolved, range.sourceModule, astIndex!))
                -> if {
                    prepared.package.nodes[range.astStart + astIndex!] => expression
                    false => ownedByNegation!
                    expression.kind == 14 and expression.parent >= 0
                        -> if {
                            range.astStart + expression.parent => parentGlobal
                            prepared.package.nodes[parentGlobal] => parent
                            parent.kind == 22 and parent.operatorKind == grammar.tokenIdMinus()
                                and returnContexts[parentGlobal] == expectedTypeId
                                -> if { true => ownedByNegation! }
                        }
                    # Unary minus owns the signed literal check. Its child inherits
                    # the return type for lowering, not a second positive range check.
                    not ownedByNegation! -> if {
                        prepared -> numericCallLiteralAt(range.sourceModule, astIndex!, resolved.types[expectedTypeId].symbol, pointerBitWidth) => candidate
                        candidate.code > 0
                            and (prepared.package -> diagnosticOriginBefore(candidate.sourceModule, candidate.locationAst, selected!.sourceModule, selected!.locationAst))
                            -> if { candidate => selected! }
                    }
                }
            astIndex! + 1 => astIndex!
        }
    }
    resolved.callArguments -> each binding {
        binding.status == 0 and binding.expectedTypeId >= 0
            and binding.expectedTypeId < (resolved.types -> len)
            -> if {
                resolved.types[binding.expectedTypeId] => expectedType
                expectedType.kind == 1 and expectedType.origin == 1
                    -> if {
                        expectedType.symbol -> typeIds.canonicalBuiltinSymbol => expectedSymbol
                        (expectedSymbol >= 2 and expectedSymbol <= 4)
                            or expectedSymbol == 6
                            or (expectedSymbol >= 8 and expectedSymbol <= 14)
                            -> if {
                                prepared -> numericCallLiteralAt(binding.sourceModule, binding.argumentAst, expectedSymbol, pointerBitWidth) => directDiagnostic
                                directDiagnostic.code > 0
                                    and (prepared.package -> diagnosticOriginBefore(directDiagnostic.sourceModule, directDiagnostic.locationAst, selected!.sourceModule, selected!.locationAst))
                                    -> if { directDiagnostic => selected! }
                                prepared.package.ranges[binding.sourceModule] => sourceRange
                                prepared.package.nodes[sourceRange.astStart + binding.argumentAst] => argument
                                argument.kind == 10 and argument.cstRuleId == grammar.ruleIdFlowExpression()
                                    -> if {
                                        -1 => ifAst!
                                        0 => childAst!
                                        childAst! < sourceRange.astCount -> while {
                                            prepared.package.nodes[sourceRange.astStart + childAst!] => child
                                            child.parent == binding.argumentAst and child.kind == 42
                                                -> if { childAst! => ifAst! }
                                            childAst! + 1 => childAst!
                                        }
                                        ifAst! >= 0 -> if {
                                            0 => regionAst!
                                            regionAst! < sourceRange.astCount -> while {
                                                prepared.package.nodes[sourceRange.astStart + regionAst!] => region
                                                region.parent == ifAst! and region.kind == 43
                                                    -> if {
                                                        0 => branchAst!
                                                        branchAst! < sourceRange.astCount -> while {
                                                            prepared.package.nodes[sourceRange.astStart + branchAst!] => branch
                                                            branch.parent == regionAst!
                                                                and (branch.kind == 14 or branch.kind == 22)
                                                                and branch.start == region.start
                                                                and branch.length == region.length -> if {
                                                                    prepared -> numericCallLiteralAt(binding.sourceModule, branchAst!, expectedSymbol, pointerBitWidth) => branchDiagnostic
                                                                    branchDiagnostic.code > 0
                                                                        and (prepared.package -> diagnosticOriginBefore(branchDiagnostic.sourceModule, branchDiagnostic.locationAst, selected!.sourceModule, selected!.locationAst))
                                                                        -> if { branchDiagnostic => selected! }
                                                                }
                                                            branchAst! + 1 => branchAst!
                                                        }
                                                    }
                                                regionAst! + 1 => regionAst!
                                            }
                                        }
                                    }
                            }
                    }
            }
    }
    selected!
}

emptyNumericCallArgumentDiagnostic: -> NumericCallArgumentDiagnostic => NumericCallArgumentDiagnostic {
    code: 0
    sourceModule: -1
    argumentAst: -1
    callAst: -1
    targetSourceModule: -1
    functionSymbol: -1
    parameterSymbol: -1
    parameterOrdinal: -1
    genericParameterSymbol: -1
    expectedTypeId: -1
    actualTypeId: -1
}

numericCallArgumentMismatch package: ref analysis.PackageAnalysis, resolved: ref expressionTypeIds.ExpressionTypeIdSet, argument: expressionTypeIds.ResolvedCallArgument -> NumericCallArgumentDiagnostic {
    emptyNumericCallArgumentDiagnostic() => valid
    argument.sourceModule >= 0 and argument.sourceModule < (package.ranges -> len)
        and argument.argumentAst >= 0
        and argument.argumentAst < package.ranges[argument.sourceModule].astCount
        and argument.actualTypeId >= 0 and argument.actualTypeId < (resolved.types -> len)
        -> unless { valid -> return }
    argument.status == 2 -> if {
        argument.genericActualTypeId >= 0 and argument.genericActualTypeId < (resolved.types -> len)
            and argument.genericFirstActualTypeId >= 0 and argument.genericFirstActualTypeId < (resolved.types -> len)
            -> unless { valid -> return }
        NumericCallArgumentDiagnostic {
            code: 2
            sourceModule: argument.sourceModule
            argumentAst: argument.argumentAst
            callAst: argument.callAst
            targetSourceModule: argument.targetSourceModule
            functionSymbol: argument.functionSymbol
            parameterSymbol: argument.parameterSymbol
            parameterOrdinal: argument.parameterOrdinal
            genericParameterSymbol: argument.genericParameterSymbol
            expectedTypeId: argument.genericFirstActualTypeId
            actualTypeId: argument.genericActualTypeId
        } -> return
    }
    argument.status == 3 and argument.mismatchExpectedTypeId >= 0
        and argument.mismatchExpectedTypeId < (resolved.types -> len)
        and argument.mismatchActualTypeId >= 0
        and argument.mismatchActualTypeId < (resolved.types -> len)
        -> if {
            resolved.types[argument.mismatchExpectedTypeId] => expected
            resolved.types[argument.mismatchActualTypeId] => actual
            expected.kind == 6 and actual.kind != 6 -> if {
                argument.argumentAst => diagnosticAst!
                argument.parameterOrdinal == 0 and argument.callAst >= 0
                    -> if {
                        package.ranges[argument.sourceModule] => range
                        range.astStart + argument.callAst => globalCall
                        package.nodes[globalCall].kind == 10 -> if {
                            package -> semanticContext.indexDirectFlowTargetPathsByAst => paths
                            paths[globalCall] => target
                            target >= 0 -> if { target => diagnosticAst! }
                        }
                    }
                NumericCallArgumentDiagnostic {
                    code: 5
                    sourceModule: argument.sourceModule
                    argumentAst: diagnosticAst!
                    callAst: argument.callAst
                    targetSourceModule: argument.targetSourceModule
                    functionSymbol: argument.functionSymbol
                    parameterSymbol: argument.parameterSymbol
                    parameterOrdinal: argument.parameterOrdinal
                    genericParameterSymbol: -1
                    expectedTypeId: argument.mismatchExpectedTypeId
                    actualTypeId: argument.mismatchActualTypeId
                } -> return
            }
        }
    argument.status == 0 and argument.expectedTypeId >= 0
        and argument.expectedTypeId < (resolved.types -> len)
        -> unless { valid -> return }
    resolved.types[argument.expectedTypeId] => expectedType
    expectedType.kind == 1 and expectedType.origin == 1
        and ((expectedType.symbol >= 2 and expectedType.symbol <= 13)
        or (expectedType.symbol >= 19 and expectedType.symbol <= 22))
        and not (resolved.types -> typeIds.functionArgumentCompatible(argument.actualTypeId, argument.expectedTypeId))
        -> unless { valid -> return }
    argument.argumentAst => diagnosticAst!
    argument.parameterOrdinal == 0 and argument.callAst >= 0
        -> if { argument.callAst => diagnosticAst! }
    NumericCallArgumentDiagnostic {
        code: 1
        sourceModule: argument.sourceModule
        argumentAst: diagnosticAst!
        callAst: argument.callAst
        targetSourceModule: argument.targetSourceModule
        functionSymbol: argument.functionSymbol
        parameterSymbol: argument.parameterSymbol
        parameterOrdinal: argument.parameterOrdinal
        genericParameterSymbol: -1
        expectedTypeId: argument.expectedTypeId
        actualTypeId: argument.actualTypeId
    }
}

public firstNumericCallArgumentDiagnostic package: ref analysis.PackageAnalysis, resolved: ref expressionTypeIds.ExpressionTypeIdSet -> NumericCallArgumentDiagnostic {
    resolved.callArguments -> each argument {
        package -> numericCallArgumentMismatch(resolved, argument) => diagnostic
        diagnostic.code > 0 -> if { diagnostic -> return }
    }
    package -> firstFileScalarArgumentDiagnostic(resolved)
}

firstFileScalarArgumentDiagnostic package: ref analysis.PackageAnalysis, resolved: ref expressionTypeIds.ExpressionTypeIdSet -> NumericCallArgumentDiagnostic {
    package -> modules.identitiesAnalyzed => identities
    package -> semanticContext.indexFlowSourcesByAst => flowSources
    package -> semanticContext.indexDirectFlowTargetPathsByAst => targets
    [Int; ~] => typeByAst!
    package.nodes -> each node { typeByAst! -> push(-1) }
    resolved.expressions -> each expression {
        expression.status == 0 and expression.sourceModule >= 0 and expression.astNode >= 0
            -> if {
                expression.typeId => typeByAst![package.ranges[expression.sourceModule].astStart + expression.astNode]
            }
    }
    package.ranges -> each range {
        0 => callAst!
        callAst! < range.astCount -> while {
            range.astStart + callAst! => globalCall
            package.nodes[globalCall] => call
            targets[globalCall] => targetAst
            call.kind == 10 and targetAst >= 0 and flowSources[globalCall] >= 0
                -> if {
                    package.nodes[range.astStart + targetAst] => target
                    package.sources[range.sourceModule] -> slice(target.start, target.length) => name
                    name == "writeAt" -> if {
                        resolved.types -> typeIds.materializedReadTypeId(typeByAst![flowSources[globalCall]]) => receiverTypeId
                        receiverTypeId >= 0 and receiverTypeId < (resolved.types -> len)
                            -> if {
                                resolved.types[receiverTypeId] => receiver
                                receiver.kind == 1 and (receiver.origin == 0 or receiver.origin == 2)
                                    and receiver.module >= 0 and receiver.symbol >= 0
                                    -> if {
                                        package.ranges[receiver.module] => receiverRange
                                        identities[receiver.module] => identity
                                        package.symbols[receiverRange.symbolStart + receiver.symbol] => declaration
                                        package.tokens[receiverRange.tokenStart + declaration.nameToken] => token
                                        package.sources[receiver.module] -> slice(identity.pathStart, identity.pathLength) => moduleName
                                        package.sources[receiver.module] -> slice(token.span.start, token.span.length) => typeName
                                        moduleName == "sys.file" and typeName == "FileWriter"
                                            -> if {
                                                calls.ModuleCallResolution { sourceModule: range.sourceModule, callAst: callAst!, origin: 0, targetModule: -1, targetSourceModule: -1, functionSymbol: -1, status: 0 } => intrinsic
                                                package -> semanticContext.callArgumentAsts(intrinsic, flowSources) => arguments
                                                (arguments -> len) == 3 -> if {
                                                    -1 => scalarType!
                                                    resolved.references -> each reference {
                                                        reference.sourceModule == range.sourceModule and reference.status == 0 and reference.typeAst >= 0
                                                            -> if {
                                                                package.nodes[range.astStart + reference.typeAst] => typeNode
                                                                typeNode.kind == 12 and typeNode.parent >= 0 -> if {
                                                                    package.nodes[range.astStart + typeNode.parent] => parent
                                                                    typeNode.parent == callAst! or (parent.parent == callAst! and parent.start > call.start and (parent.kind == 11 or parent.kind == 77))
                                                                        -> if { reference.typeId => scalarType! }
                                                                }
                                                            }
                                                    }
                                                    1 => ordinal!
                                                    ordinal! <= 2 -> while {
                                                        arguments[ordinal!] => argumentGlobal
                                                        package.nodes[argumentGlobal] => argument
                                                        scalarType! => expected!
                                                        ordinal! == 2 -> if { 11 => expected! }
                                                        resolved.types -> typeIds.materializedReadTypeId(typeByAst![argumentGlobal]) => actual
                                                        argument.kind != 14 and expected! >= 0 and actual >= 0 and actual != expected!
                                                            -> if {
                                                                emptyNumericCallArgumentDiagnostic() => diagnostic!
                                                                ordinal! + 2 => diagnostic!.code
                                                                range.sourceModule => diagnostic!.sourceModule
                                                                argumentGlobal - range.astStart => diagnostic!.argumentAst
                                                                callAst! => diagnostic!.callAst
                                                                expected! => diagnostic!.expectedTypeId
                                                                actual => diagnostic!.actualTypeId
                                                                diagnostic! -> return
                                                            }
                                                        ordinal! + 1 => ordinal!
                                                    }
                                                }
                                            }
                                    }
                            }
                    }
                }
            callAst! + 1 => callAst!
        }
    }
    emptyNumericCallArgumentDiagnostic()
}

numericLiteralConversion package: ref analysis.PackageAnalysis, resolved: ref expressionTypeIds.ExpressionTypeIdSet, range: analysis.SourceAnalysisRange, expressionAst: Int, expectedTypeId: Int, firstChildByAst: ref [Int; ~], nextChildByAst: ref [Int; ~], typeIdByAst: ref [Int; ~] -> Int {
    range.astStart + expressionAst => globalAst
    package.nodes[globalAst].kind == 11 and typeIdByAst[globalAst] == expectedTypeId
        -> unless { -1 -> return }
    firstChildByAst[globalAst] => pathGlobal
    pathGlobal >= 0 and package.nodes[pathGlobal].kind == 16
        -> unless { -1 -> return }
    nextChildByAst[pathGlobal] => literalGlobal
    literalGlobal >= 0 and nextChildByAst[literalGlobal] < 0
        -> unless { -1 -> return }
    package.nodes[literalGlobal] => literalNode
    literalNode.kind == 14 -> unless {
        literalNode.kind == 22 and literalNode.operatorKind == grammar.tokenIdMinus()
            -> unless { -1 -> return }
        firstChildByAst[literalGlobal] => negativeLiteralGlobal
        negativeLiteralGlobal >= 0 and nextChildByAst[negativeLiteralGlobal] < 0
            and package.nodes[negativeLiteralGlobal].kind == 14
            -> unless { -1 -> return }
    }
    resolved.types[expectedTypeId] => operandType
    operandType.kind == 1 and operandType.origin == 1
        -> unless { -1 -> return }
    package.nodes[pathGlobal] => pathNode
    package.sources[range.sourceModule] -> slice(pathNode.start, pathNode.length) => pathName
    (pathName -> typeIds.builtinSymbolByName) == (operandType.symbol -> typeIds.canonicalBuiltinSymbol)
        -> if { literalGlobal - range.astStart } else { -1 }
}

appendContextualNumericWarning package: ref analysis.PackageAnalysis, resolved: ref expressionTypeIds.ExpressionTypeIdSet, sourceModule: Int, valueAst: Int, expectedTypeId: Int, actualTypeId: Int, firstChildByAst: ref [Int; ~], nextChildByAst: ref [Int; ~], typeIdByAst: ref [Int; ~], warnings: mut [RedundantNumericConversion; ~] -> Unit {
    sourceModule >= 0 and sourceModule < (package.ranges -> len)
        and expectedTypeId >= 0 and expectedTypeId < (resolved.types -> len)
        and actualTypeId == expectedTypeId
        -> unless { return }
    resolved.types[expectedTypeId] => expectedType
    expectedType.kind == 1 and expectedType.origin == 1
        and ((expectedType.symbol >= 2 and expectedType.symbol <= 13)
        or (expectedType.symbol >= 19 and expectedType.symbol <= 22))
        -> unless { return }
    package.ranges[sourceModule] => range
    valueAst >= 0 and valueAst < range.astCount
        and resolved.activeDeclarationBodyByAst[range.astStart + valueAst]
        -> unless { return }
    package -> numericLiteralConversion(resolved, range, valueAst, expectedTypeId, firstChildByAst, nextChildByAst, typeIdByAst) => literalAst
    literalAst >= 0 -> if {
        warnings -> each existing {
            existing.sourceModule == sourceModule and existing.conversionAst == valueAst
                -> if { return }
        }
        warnings -> push(RedundantNumericConversion {
            sourceModule: sourceModule
            conversionAst: valueAst
            literalAst: literalAst
            typeSymbol: expectedType.symbol
        })
    }
}

appendCallArgumentNumericWarning package: ref analysis.PackageAnalysis, resolved: ref expressionTypeIds.ExpressionTypeIdSet, argument: expressionTypeIds.ResolvedCallArgument, firstChildByAst: ref [Int; ~], nextChildByAst: ref [Int; ~], typeIdByAst: ref [Int; ~], warnings: mut [RedundantNumericConversion; ~] -> Unit {
    argument.status == 0 and not argument.suppressNumericWarning
        -> if {
            package -> appendContextualNumericWarning(resolved, argument.sourceModule, argument.argumentAst, argument.expectedTypeId, argument.actualTypeId, firstChildByAst, nextChildByAst, typeIdByAst, warnings)
        }
}

appendContextualNumericWarnings package: ref analysis.PackageAnalysis, resolved: ref expressionTypeIds.ExpressionTypeIdSet, sourceModule: Int, valueAst: Int, expectedTypeId: Int, firstChildByAst: ref [Int; ~], nextChildByAst: ref [Int; ~], typeIdByAst: ref [Int; ~], warnings: mut [RedundantNumericConversion; ~] -> Unit {
    package.ranges[sourceModule] => range
    range.astStart + valueAst => globalAst
    package -> appendContextualNumericWarning(resolved, sourceModule, valueAst, expectedTypeId, typeIdByAst[globalAst], firstChildByAst, nextChildByAst, typeIdByAst, warnings)
    resolved.types[expectedTypeId] => expected
    package.nodes[globalAst] => value
    expected.kind == 1 and expected.origin == 1 and expected.symbol >= 2 and expected.symbol <= 13
        and (value.kind == 20 or value.kind == 21) -> if {
            firstChildByAst[globalAst] => operand!
            operand! >= 0 -> while {
                package -> appendContextualNumericWarnings(resolved, sourceModule, operand! - range.astStart, expectedTypeId, firstChildByAst, nextChildByAst, typeIdByAst, warnings)
                nextChildByAst[operand!] => operand!
            }
        }
}

# One semantic field contract supplies both numeric contextual warnings and
# growable-storage requirements. Field lookup is indexed by resolved owner type.
public nominalFieldExpectedTypeIds package: ref analysis.PackageAnalysis, resolved: ref expressionTypeIds.ExpressionTypeIdSet, typeByAst: ref [Int; ~] -> [Int; ~] {
    [Int; ~] => expected!
    package.nodes -> each node { expected! -> push(-1) }
    [Int; ~] => firstField!
    resolved.types -> each type { firstField! -> push(-1) }
    [Int; ~] => nextField!
    0 => fieldIndex!
    fieldIndex! < (resolved.fields -> len) -> while {
        resolved.fields[fieldIndex!] => field
        -1 => next!
        field.status == 0 and field.ownerType >= 0 and field.ownerType < (resolved.types -> len)
            -> if {
                firstField![field.ownerType] => next!
                fieldIndex! => firstField![field.ownerType]
            }
        nextField! -> push(next!)
        fieldIndex! + 1 => fieldIndex!
    }
    package.ranges -> each range {
        0 => astIndex!
        astIndex! < range.astCount -> while {
            range.astStart + astIndex! => globalAst
            package.nodes[globalAst] => initializer
            initializer.kind == 40 and initializer.parent >= 0 and initializer.payloadToken >= 0
                -> if {
                    typeByAst[range.astStart + initializer.parent] => owner
                    owner >= 0 and owner < (firstField! -> len) -> if {
                        package.tokens[range.tokenStart + initializer.payloadToken] => label
                        firstField![owner] => currentField!
                        currentField! >= 0 -> while {
                            resolved.fields[currentField!] => field
                            package.ranges[field.sourceModule] => fieldRange
                            field.labelToken => nameToken!
                            field.fieldSymbol >= 0 -> if {
                                package.symbols[fieldRange.symbolStart + field.fieldSymbol].nameToken => nameToken!
                            }
                            nameToken! >= 0 -> if {
                                package.tokens[fieldRange.tokenStart + nameToken!] => name
                                label.span.length == name.span.length => same!
                                UIntSize(0) => byteIndex!
                                same! and byteIndex! < label.span.length -> while {
                                    (package.sources[range.sourceModule] -> byte(label.span.start + byteIndex!)) != (package.sources[field.sourceModule] -> byte(name.span.start + byteIndex!))
                                        -> if { false => same! }
                                    byteIndex! + 1 => byteIndex!
                                }
                                same! -> if { field.fieldType => expected![globalAst] }
                            }
                            nextField![currentField!] => currentField!
                        }
                    }
                }
            astIndex! + 1 => astIndex!
        }
    }
    expected!
}

# Match the C# binary warning decision after both operands have semantic types.
# Each source-local AST is indexed once; the full self-host package is too large
# for repeated descendant searches per binary expression.
public redundantNumericConversions package: ref analysis.PackageAnalysis, resolved: ref expressionTypeIds.ExpressionTypeIdSet -> [RedundantNumericConversion; ~] {
    [RedundantNumericConversion; ~] => warnings!
    [Int; ~] => typeIdByAst!
    [Int; ~] => firstChildByAst!
    [Int; ~] => lastChildByAst!
    [Int; ~] => nextChildByAst!
    package.nodes -> each nodeSlot {
        typeIdByAst! -> push(-1)
        firstChildByAst! -> push(-1)
        lastChildByAst! -> push(-1)
        nextChildByAst! -> push(-1)
    }
    resolved.expressions -> each expression {
        expression.status == 0 and expression.sourceModule >= 0
            and expression.sourceModule < (package.ranges -> len)
            -> if {
                package.ranges[expression.sourceModule] => range
                expression.astNode >= 0 and expression.astNode < range.astCount
                    and expression.typeId >= 0 and expression.typeId < (resolved.types -> len)
                    -> if { expression.typeId => typeIdByAst![range.astStart + expression.astNode] }
            }
    }
    package.ranges -> each range {
        0 => astIndex!
        astIndex! < range.astCount -> while {
            range.astStart + astIndex! => globalAst
            package.nodes[globalAst].parent => parentAst
            parentAst >= 0 and parentAst < range.astCount
                -> if {
                    range.astStart + parentAst => parentGlobal
                    firstChildByAst![parentGlobal] < 0
                        -> if { globalAst => firstChildByAst![parentGlobal] } else {
                            globalAst => nextChildByAst![lastChildByAst![parentGlobal]]
                        }
                    globalAst => lastChildByAst![parentGlobal]
                }
            astIndex! + 1 => astIndex!
        }
    }
    package.ranges -> each range {
        0 => astIndex!
        astIndex! < range.astCount -> while {
            range.astStart + astIndex! => globalAst
            package.nodes[globalAst] => binary
            (binary.kind == 18 or binary.kind == 19 or binary.kind == 20 or binary.kind == 21)
                and resolved.activeDeclarationBodyByAst[globalAst]
                -> if {
                    firstChildByAst![globalAst] => leftGlobal
                    leftGlobal >= 0 -> if {
                        nextChildByAst![leftGlobal] => rightGlobal
                        rightGlobal >= 0 and nextChildByAst![rightGlobal] < 0
                            -> if {
                                typeIdByAst![leftGlobal] => leftTypeId
                                typeIdByAst![rightGlobal] => rightTypeId
                                leftTypeId >= 0 and leftTypeId == rightTypeId
                                    -> if {
                                        resolved.types[leftTypeId] => operandType
                                        operandType.kind == 1 and operandType.origin == 1
                                            and ((operandType.symbol >= 2 and operandType.symbol <= 13)
                                            or (operandType.symbol >= 19 and operandType.symbol <= 22))
                                            -> if {
                                                leftGlobal - range.astStart => leftAst
                                                rightGlobal - range.astStart => rightAst
                                                package -> numericLiteralConversion(resolved, range, leftAst, leftTypeId, firstChildByAst!, nextChildByAst!, typeIdByAst!) => leftLiteral
                                                package -> numericLiteralConversion(resolved, range, rightAst, rightTypeId, firstChildByAst!, nextChildByAst!, typeIdByAst!) => rightLiteral
                                                package -> expressionTypeIds.contextualNumericOperand(range.astStart + leftAst, firstChildByAst!, nextChildByAst!) => leftContextual
                                                package -> expressionTypeIds.contextualNumericOperand(range.astStart + rightAst, firstChildByAst!, nextChildByAst!) => rightContextual
                                                leftLiteral >= 0 and rightLiteral < 0 and not rightContextual
                                                    -> if {
                                                        warnings! -> push(RedundantNumericConversion { sourceModule: range.sourceModule, conversionAst: leftAst, literalAst: leftLiteral, typeSymbol: operandType.symbol })
                                                    }
                                                rightLiteral >= 0 and not leftContextual -> if {
                                                    warnings! -> push(RedundantNumericConversion { sourceModule: range.sourceModule, conversionAst: rightAst, literalAst: rightLiteral, typeSymbol: operandType.symbol })
                                                }
                                            }
                                    }
                            }
                    }
                }
            astIndex! + 1 => astIndex!
        }
    }
    resolved.callArguments -> each argument {
        package -> appendCallArgumentNumericWarning(resolved, argument, firstChildByAst!, nextChildByAst!, typeIdByAst!, warnings!)
    }
    package -> nominalFieldExpectedTypeIds(resolved, typeIdByAst!) => fieldExpectedTypes
    package.ranges -> each range {
        0 => astIndex!
        astIndex! < range.astCount -> while {
            range.astStart + astIndex! => globalAst
            fieldExpectedTypes[globalAst] >= 0 -> if {
                firstChildByAst![globalAst] => value
                value >= 0 -> if {
                    package -> appendContextualNumericWarnings(resolved, range.sourceModule, value - range.astStart, fieldExpectedTypes[globalAst], firstChildByAst!, nextChildByAst!, typeIdByAst!, warnings!)
                }
            }
            astIndex! + 1 => astIndex!
        }
    }
    warnings!
}

mutableBorrowOwnerSymbol package: ref analysis.PackageAnalysis, sourceIndex: Int, owner: symbols.Symbol -> Bool {
    owner.kind == 9 or owner.kind == 61 -> if { owner.flags % 2 == 1 -> return }
    owner.kind != 35 -> if { false -> return }
    owner.flags / 2 % 2 == 1 -> if { true -> return }
    package.ranges[sourceIndex] => range
    owner.typeNode < 0 or owner.typeNode >= range.astCount
        -> if { false -> return }
    package.nodes[range.astStart + owner.typeNode] => annotation
    annotation.firstToken => tokenIndex!
    tokenIndex! < annotation.firstToken + annotation.tokenCount
        -> while {
            package.tokens[range.tokenStart + tokenIndex!] => token
            token.kind == grammar.tokenIdIdentifier() -> if {
                package.sources[sourceIndex] -> slice(token.span.start, token.span.length)
                    => modifierName
                modifierName == "mut" -> return
            }
            tokenIndex! + 1 => tokenIndex!
        }
    false
}

excludedBoxNominal package: ref analysis.PackageAnalysis, identities: ref [modules.ModuleIdentity; ~], operandType: typeIds.SemanticType -> Bool {
    operandType.kind != 1 or operandType.origin == 1 or operandType.module < 0
        or operandType.module >= (package.ranges -> len)
        -> if { false -> return }
    package.ranges[operandType.module] => typeRange
    operandType.symbol < 0 or operandType.symbol >= typeRange.symbolCount
        -> if { false -> return }
    package.symbols[typeRange.symbolStart + operandType.symbol] => typeSymbol
    package.tokens[typeRange.tokenStart + typeSymbol.nameToken] => nameToken
    identities[operandType.module] => identity
    package.sources[operandType.module] -> slice(identity.pathStart, identity.pathLength) => moduleName
    package.sources[operandType.module] -> slice(nameToken.span.start, nameToken.span.length) => typeName
    ["sys.file", "sys.file", "sys.file", "sys.file", "sys.process",
    "sys.path", "sys.path", "sys.directory", "sys.directory",
    "sys.directory", "sys.directory", "sys.directory.kind",
    "sys.input.mouse", "sys.input.mouse", "sys.input.mouse"] => excludedModules
    ["File", "FileWriter", "SourceText", "AtomicReplaceRequest", "Command",
    "Path", "Style", "Raw", "Entry", "RawResult", "ReadResult",
    "Kind", "Event", "Kind", "OverflowPolicy"] => excludedNames
    0 => excludedIndex!
    excludedIndex! < (excludedNames -> len) -> while {
        moduleName == excludedModules[excludedIndex!]
            and typeName == excludedNames[excludedIndex!]
            -> if { true -> return }
        excludedIndex! + 1 => excludedIndex!
    }
    false
}

logicalOperandOffset package: ref analysis.PackageAnalysis, sourceIndex: Int, operandAst: Int -> UIntSize {
    package.ranges[sourceIndex] => range
    package.nodes[range.astStart + operandAst] => operand
    operand.start => offset!
    operand.kind == 10 -> if {
        false => sawArrow!
        false => foundTarget!
        operand.firstToken => tokenIndex!
        tokenIndex! < operand.firstToken + operand.tokenCount and not foundTarget!
            -> while {
                package.tokens[range.tokenStart + tokenIndex!] => token
                token.kind == grammar.tokenIdArrow() -> if { true => sawArrow! }
                sawArrow! and token.kind == grammar.tokenIdIdentifier()
                    -> if {
                        token.span.start => offset!
                        true => foundTarget!
                    }
                tokenIndex! + 1 => tokenIndex!
            }
    }
    offset!
}

rangeStartPrecedesEndName package: ref analysis.PackageAnalysis, start: ExpressionOperandDiagnostic, name: ExpressionOperandDiagnostic -> Bool {
    start.code != 21 or name.code != 23 or start.sourceModule != name.sourceModule
        -> if { false -> return }
    package.ranges[start.sourceModule] => range
    start.astNode < 0 or start.astNode >= range.astCount or name.astNode < 0 or name.astNode >= range.astCount
        -> if { false -> return }
    package.nodes[range.astStart + start.astNode].kind != 63
        -> if { false -> return }
    name.astNode => child!
    child! >= 0 and child! < range.astCount -> while {
        package.nodes[range.astStart + child!].parent => parent
        parent == start.astNode -> if { child! != start.operandAst -> return }
        parent => child!
    }
    false
}

# Array elements are inferred in source order. A later element's inference
# failure cannot replace a completed earlier element's layout failure.
fixedArrayElementPrecedesNested package: ref analysis.PackageAnalysis, arrayFailure: ExpressionOperandDiagnostic, nestedFailure: ExpressionOperandDiagnostic -> Bool {
    arrayFailure.code != 26 or arrayFailure.sourceModule != nestedFailure.sourceModule
        -> if { false -> return }
    package.ranges[arrayFailure.sourceModule] => range
    nestedFailure.astNode => current!
    -1 => elementAst!
    current! >= 0 and current! < range.astCount and elementAst! < 0
        -> while {
            package.nodes[range.astStart + current!].parent => parent
            parent == arrayFailure.astNode -> if { current! => elementAst! } else { parent => current! }
        }
    elementAst! < 0 or elementAst! == arrayFailure.operandAst
        -> if { false -> return }
    package.nodes[range.astStart + arrayFailure.operandAst].start => invalidElementStart
    package.nodes[range.astStart + elementAst!].start => nestedElementStart
    invalidElementStart < nestedElementStart => earlierElement
    earlierElement -> return
}

# A record validates labels first, then required values in declaration order.
# This applies only inside that source-owned record; unrelated errors retain
# the ordinary expression comparator.
contextualRecordFieldPriority package: ref analysis.PackageAnalysis, fields: ref [typeIds.NominalField; ~], candidate: ExpressionOperandDiagnostic, selected: ExpressionOperandDiagnostic -> Int {
    selected.code < 33 or selected.code > 43 or candidate.sourceModule != selected.sourceModule
        -> if { -1 -> return }
    package.ranges[selected.sourceModule] => range
    candidate.astNode => valueAst!
    candidate.operandAst >= 0 and candidate.operandAst < range.astCount
        and (package -> semanticContext.declarationAncestor(selected.sourceModule, selected.astNode, candidate.operandAst))
        -> if { candidate.operandAst => valueAst! }
    valueAst! < 0 or valueAst! >= range.astCount or valueAst! == selected.astNode
        or not (package -> semanticContext.declarationAncestor(selected.sourceModule, selected.astNode, valueAst!))
        -> if { -1 -> return }
    selected.code == 33 or selected.code == 34 or selected.code == 39
        -> if { 0 -> return }
    package.nodes[range.astStart + valueAst!].parent != selected.astNode
        -> while {
            package.nodes[range.astStart + valueAst!].parent => valueAst!
        }
    -1 => labelAst!
    -1 => previousLabel!
    0 => ordinal!
    0 => childAst!
    childAst! < range.astCount -> while {
        package.nodes[range.astStart + childAst!] => child
        child.parent == selected.astNode and child.kind != 12
            -> if {
                ordinal! % 2 == 0 -> if { childAst! => previousLabel! } else {
                    childAst! == valueAst! -> if { previousLabel! => labelAst! }
                }
                ordinal! + 1 => ordinal!
            }
        childAst! + 1 => childAst!
    }
    labelAst! < 0 -> if { 0 -> return }
    package.nodes[range.astStart + labelAst!] => label
    package.tokens[range.tokenStart + label.payloadToken] => labelToken
    package.sources[selected.sourceModule] -> slice(labelToken.span.start, labelToken.span.length) => labelName
    -1 => candidateOrdinal!
    fields -> each field {
        field.status == 0 and field.ownerType == selected.operandTypeId
            -> if {
                package.ranges[field.sourceModule] => fieldRange
                field.labelToken => fieldToken!
                field.fieldSymbol >= 0 -> if {
                    package.symbols[fieldRange.symbolStart + field.fieldSymbol].nameToken => fieldToken!
                }
                fieldToken! >= 0 -> if {
                    package.tokens[fieldRange.tokenStart + fieldToken!] => declared
                    (package.sources[field.sourceModule] -> slice(declared.span.start, declared.span.length)) == labelName
                        -> if { field.ordinal => candidateOrdinal! }
                }
            }
    }
    candidateOrdinal! < 0 -> if { 0 -> return }
    selected.code == 37 -> if { 1 -> return }
    fields[selected.operatorKind].ordinal => selectedOrdinal
    candidateOrdinal! < selectedOrdinal or (candidateOrdinal! == selectedOrdinal and (selected.code == 36 or selected.code == 41 or selected.code == 42
        or (selected.code == 43 and (candidate.locationOffset < selected.locationOffset
        or (package -> semanticContext.declarationAncestor(selected.sourceModule, selected.operandAst, valueAst!))))))
        -> if { 1 } else { 0 }
}

expressionDiagnosticPrecedes package: ref analysis.PackageAnalysis, fields: ref [typeIds.NominalField; ~], candidate: ExpressionOperandDiagnostic, selected: ExpressionOperandDiagnostic -> Bool {
    selected.code == 0 -> if { true -> return }
    candidate.sourceModule != selected.sourceModule
        -> if {
            candidate.sourceModule < selected.sourceModule -> return
        }
    # Committed call authority is checked before evaluating its arguments.
    candidate.astNode == selected.astNode and candidate.code == 48
        and (selected.code == 47 or selected.code == 32)
        -> if { false -> return }
    candidate.astNode == selected.astNode and candidate.code == 32 and selected.code == 47
        -> if { false -> return }
    (candidate.code == 47 or candidate.code == 32 or candidate.code == 48)
        and (candidate.astNode == selected.astNode
        or (package -> declarationAncestor(candidate.sourceModule, candidate.astNode, selected.astNode)))
        -> if { true -> return }
    (selected.code == 47 or selected.code == 32 or selected.code == 48)
        and (candidate.astNode == selected.astNode
        or (package -> declarationAncestor(candidate.sourceModule, selected.astNode, candidate.astNode)))
        -> if { false -> return }
    package -> contextualRecordFieldPriority(fields, candidate, selected) => fieldPriority
    fieldPriority >= 0 -> if { fieldPriority == 1 -> return }
    package -> fixedArrayElementPrecedesNested(candidate, selected)
        -> if { true -> return }
    package -> fixedArrayElementPrecedesNested(selected, candidate)
        -> if { false -> return }
    package -> rangeStartPrecedesEndName(candidate, selected)
        -> if { true -> return }
    package -> rangeStartPrecedesEndName(selected, candidate)
        -> if { false -> return }
    package.ranges[candidate.sourceModule] => range
    package.nodes[range.astStart + candidate.astNode].parent => ancestor!
    false => candidateNested!
    ancestor! >= 0 and not candidateNested! -> while {
        ancestor! == selected.astNode -> if { true => candidateNested! } else {
            package.nodes[range.astStart + ancestor!].parent => ancestor!
        }
    }
    candidateNested! -> if { true -> return }
    package.nodes[range.astStart + selected.astNode].parent => selectedAncestor!
    false => selectedNested!
    selectedAncestor! >= 0 and not selectedNested!
        -> while {
            selectedAncestor! == candidate.astNode -> if { true => selectedNested! } else {
                package.nodes[range.astStart + selectedAncestor!].parent => selectedAncestor!
            }
        }
    selectedNested! -> if { false -> return }
    package.nodes[range.astStart + candidate.astNode].start => candidateStart
    package.nodes[range.astStart + selected.astNode].start => selectedStart
    candidateStart < selectedStart or (candidateStart == selectedStart and candidate.astNode < selected.astNode)
}

public firstMutableRebindDiagnostic prepared: ref semanticContext.SemanticSnapshot, resolved: mut expressionTypeIds.ExpressionTypeIdSet, prior: ExpressionOperandDiagnostic, genericPlans: ref [typedIr.GenericCallPlan; ~], ir: ref [typedIr.TypedIrNode; ~] -> ExpressionOperandDiagnostic {
    prior => selected!
    [Int; ~] => typeIdByAst!
    prepared.package.nodes -> each node { typeIdByAst! -> push(-1) }
    resolved.expressions -> each expression {
        expression.status == 0 -> if {
            prepared.package.ranges[expression.sourceModule] => range
            expression.typeId => typeIdByAst![range.astStart + expression.astNode]
        }
    }
    prepared.package -> semanticContext.indexBindingValueAsts => bindingValues
    prepared.package.ranges -> each bindingRange {
        0 => bindingSymbolIndex!
        bindingSymbolIndex! < bindingRange.symbolCount
            -> while {
                bindingRange.symbolStart + bindingSymbolIndex! => globalSymbol
                resolved.mutableBindingOwners[globalSymbol] => owner
                owner != globalSymbol and bindingValues[globalSymbol] >= 0
                    and (prepared -> declarationBodyIsActive(resolved, bindingRange.sourceModule, prepared.package.symbols[globalSymbol].astNode))
                    -> if {
                        resolved.lexicalBindingTypeBySymbol[owner] => expectedType
                        typeIdByAst![bindingValues[globalSymbol]] => actualType
                        expectedType >= 0 and actualType >= 0 and expectedType != actualType
                            -> if {
                                prepared.package.symbols[globalSymbol] => bindingSymbol
                                prepared.package.tokens[bindingRange.tokenStart + bindingSymbol.nameToken] => name
                                [Int; ~] => expectedTypes!
                                [Int; ~] => actualTypes!
                                not resolved.types[expectedType].containsParameter and not resolved.types[actualType].containsParameter
                                    -> if {
                                        expectedTypes! -> push(expectedType)
                                        actualTypes! -> push(actualType)
                                    } else {
                                        # Compare each active call's concrete types using the
                                        # same substitution contract as generic materialization.
                                        # Failed plans retain their existing planning diagnostic.
                                        genericPlans -> each plan {
                                            plan.status == 0 and plan.templateNode >= 0
                                                and plan.templateNode < (ir -> len)
                                                and ir[plan.templateNode].sourceModule == bindingRange.sourceModule
                                                and (prepared.package -> declarationAncestor(bindingRange.sourceModule, ir[plan.templateNode].astNode, bindingSymbol.astNode))
                                                -> if {
                                                    resolved.types -> typeIds.specializeManyInto(plan.inputTemplates, plan.actualInputs, expectedType) => expected
                                                    resolved.types -> typeIds.specializeManyInto(plan.inputTemplates, plan.actualInputs, actualType) => actual
                                                    expected.status == 0 and actual.status == 0 and expected.root >= 0 and actual.root >= 0
                                                        -> if {
                                                            expectedTypes! -> push(expected.root)
                                                            actualTypes! -> push(actual.root)
                                                        }
                                                }
                                        }
                                    }
                                0 => comparisonIndex!
                                comparisonIndex! < (expectedTypes! -> len) -> while {
                                    expectedTypes![comparisonIndex!] => concreteExpected
                                    actualTypes![comparisonIndex!] => concreteActual
                                    concreteExpected != concreteActual -> if {
                                        ExpressionOperandDiagnostic {
                                            code: 19
                                            sourceModule: bindingRange.sourceModule
                                            astNode: bindingSymbol.astNode
                                            operandAst: bindingValues[globalSymbol] - bindingRange.astStart
                                            operatorKind: -1
                                            locationOffset: name.span.start
                                            operandTypeSymbol: resolved.types[concreteActual].symbol
                                            operandTypeId: concreteActual
                                            firstTypeId: concreteExpected
                                        } => candidate
                                        prepared.package -> expressionDiagnosticPrecedes(resolved.fields, candidate, selected!)
                                            -> if { candidate => selected! }
                                    }
                                    comparisonIndex! + 1 => comparisonIndex!
                                }
                            }
                    }
                bindingSymbolIndex! + 1 => bindingSymbolIndex!
            }
    }
    selected!
}

# Identifier-only member chains keep the primary coordinate; calls, indexes,
# parentheses and Bang keep the actual postfix dot, matching interpolation IR.
ordinaryFieldDiagnosticOffset package: ref analysis.PackageAnalysis, sourceAsts: ref [Int; ~], sourceIndex: Int, fieldAst: Int -> UIntSize {
    package.ranges[sourceIndex] => range
    package.nodes[range.astStart + fieldAst] => operation
    fieldAst => receiverAst!
    false => identifierPath!
    true => scanning!
    receiverAst! >= 0 and receiverAst! < range.astCount and scanning! and not identifierPath!
        -> while {
            package.nodes[range.astStart + receiverAst!] => receiver
            receiver.start != operation.start -> if {
                false => scanning!
            } else {
                receiver.kind == 15 and receiver.cstRuleId == grammar.ruleIdNameExpression()
                    and receiver.firstToken >= 0 and receiver.firstToken < range.tokenCount
                    -> if {
                        package.tokens[range.tokenStart + receiver.firstToken] => identifier
                        identifier.kind == grammar.tokenIdIdentifier()
                            and receiver.start == identifier.span.start
                            and receiver.length == identifier.span.length
                            => identifierPath!
                    }
                receiver.kind == 16 and receiver.cstRuleId == grammar.ruleIdPath()
                    -> if { true => identifierPath! }
                not identifierPath! -> if {
                    receiver.kind != 36 or receiver.cstRuleId != grammar.ruleIdPostfixExpression()
                        or receiver.operatorKind != grammar.tokenIdDot()
                        -> if { false => scanning! } else {
                            sourceAsts[range.astStart + receiverAst!] => nextReceiver
                            nextReceiver == receiverAst! -> if { false => scanning! } else {
                                nextReceiver => receiverAst!
                            }
                        }
                }
            }
        }
    identifierPath! -> if { operation.start -> return }
    # A lowered field read's postfix operation retains its actual dot token.
    package.tokens[range.tokenStart + operation.payloadToken].span.start
}

# Preserve ordinary field-read identity; interpolation node indexes are unrelated.
privateRepeatedSeedField prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, ir: ref [typedIr.TypedIrNode; ~], readIndex: Int -> Int {
    ir[readIndex] => read
    read.kind != 13 or read.sourceModule < 0 or read.sourceModule >= (prepared.package.ranges -> len)
        or read.operand0 < 0 or read.operand0 >= (ir -> len)
        -> if { -1 -> return }
    prepared.package.ranges[read.sourceModule] => range
    read.astNode < 0 or read.astNode >= range.astCount
        -> if { -1 -> return }
    read.astNode => ancestor!
    false => repeatedSeed!
    ancestor! >= 0 and ancestor! < range.astCount and not repeatedSeed!
        -> while {
            prepared.package.nodes[range.astStart + ancestor!] => node
            node.kind == 37 -> if {
                prepared.package -> typeIds.arrayStorageSyntax(read.sourceModule, ancestor!) => storage
                storage.isRepeat -> if { true => repeatedSeed! }
            }
            node.parent => ancestor!
        }
    not repeatedSeed! or not (prepared -> declarationBodyIsActive(resolved, read.sourceModule, read.astNode))
        -> if { -1 -> return }
    resolved.types -> typeIds.materializedReadTypeId(ir[read.operand0].typeId) => ownerTypeId
    ownerTypeId < 0 or ownerTypeId >= (resolved.types -> len)
        -> if { -1 -> return }
    prepared.package.nodes[range.astStart + read.astNode] => operation
    -1 => fieldToken!
    operation.firstToken => tokenIndex!
    tokenIndex! >= 0 and tokenIndex! < operation.firstToken + operation.tokenCount
        and tokenIndex! < range.tokenCount -> while {
            prepared.package.tokens[range.tokenStart + tokenIndex!].kind == grammar.tokenIdIdentifier()
                -> if { tokenIndex! => fieldToken! }
            tokenIndex! + 1 => tokenIndex!
        }
    fieldToken! < 0 -> if { -1 -> return }
    prepared.package.tokens[range.tokenStart + fieldToken!] => readToken
    prepared.package.sources[read.sourceModule] -> slice(readToken.span.start, readToken.span.length) => fieldName
    0 => fieldIndex!
    fieldIndex! < (resolved.fields -> len) -> while {
        resolved.fields[fieldIndex!] => field
        field.status == 0 and field.ownerType == ownerTypeId and field.sourceModule >= 0
            and field.sourceModule < (prepared.package.ranges -> len) and field.fieldSymbol >= 0
            -> if {
                prepared.package.ranges[field.sourceModule] => fieldRange
                field.fieldSymbol < fieldRange.symbolCount -> if {
                    prepared.package.symbols[fieldRange.symbolStart + field.fieldSymbol] => declaration
                    prepared.package.tokens[fieldRange.tokenStart + declaration.nameToken] => declaredToken
                    prepared.package.sources[field.sourceModule] -> slice(declaredToken.span.start, declaredToken.span.length) => declaredName
                    fieldName == declaredName and (prepared -> expressionTypeIds.accessibleMemberFieldType(resolved.fields, read.sourceModule, fieldIndex!)) < 0
                        -> if { fieldIndex! -> return }
                }
            }
        fieldIndex! + 1 => fieldIndex!
    }
    -1
}

contextualRecordDecision package: ref analysis.PackageAnalysis, sourceModule: Int, literalAst: Int, locationAst: Int, code: Int, ownerType: Int, field: Int, actualType: Int -> ExpressionOperandDiagnostic {
    package.ranges[sourceModule] => range
    ExpressionOperandDiagnostic {
        code: code, sourceModule: sourceModule, astNode: literalAst,
        operandAst: locationAst, operatorKind: field,
        locationOffset: package.nodes[range.astStart + locationAst].start,
        operandTypeSymbol: -1, operandTypeId: ownerType, firstTypeId: actualType
    }
}

contextualRecordArrayDiagnostic package: ref analysis.PackageAnalysis, prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, typeByAst: ref [Int; ~], firstChild: ref [Int; ~], nextChild: ref [Int; ~], pointerBitWidth: Int, sourceModule: Int, literalAst: Int, arrayGlobal: Int, ownerType: Int, field: Int, expectedArrayType: Int -> ExpressionOperandDiagnostic {
    package -> contextualRecordDecision(sourceModule, literalAst, arrayGlobal - package.ranges[sourceModule].astStart, 0, ownerType, field, -1) => valid
    package.nodes[arrayGlobal].kind != 37 -> if { valid -> return }
    resolved.types[expectedArrayType] => expectedArray
    expectedArray.kind != 3 and expectedArray.kind != 4 and expectedArray.kind != 12
        -> if { valid -> return }
    package.ranges[sourceModule] => range
    package.sources[sourceModule] -> len => sourceLength
    package.sources[sourceModule] -> slice(UIntSize(0), sourceLength) => source
    expectedArray.first => expectedElementType
    0 => count!
    firstChild[arrayGlobal] => element!
    element! >= 0 -> while {
        package.nodes[element!].kind != 12 -> if {
            resolved.types -> typeIds.materializedReadTypeId(typeByAst[element!]) => actualElement
            # An unresolved child retains its ordinary diagnostic owner;
            # do not promote a later extent failure ahead of that child.
            actualElement < 0 -> if { valid -> return }
            resolved.types[expectedElementType] => expectedNumeric
            expectedNumeric.symbol -> typeIds.canonicalBuiltinSymbol => expectedSymbol
            expectedNumeric.kind == 1 and expectedNumeric.origin == 1
                and ((expectedSymbol >= 2 and expectedSymbol <= 4) or expectedSymbol == 6 or (expectedSymbol >= 8 and expectedSymbol <= 14))
                -> if {
                    package -> expressionTypeIds.contextualNumericValueAsts(firstChild, nextChild, element!, true) => numericValues
                    numericValues -> each numericValue {
                        package.nodes[numericValue] => valueNode
                        -1 => number!
                        valueNode.kind == 14 -> if { numericValue => number! }
                        valueNode.kind == 22 and valueNode.operatorKind == grammar.tokenIdMinus()
                            -> if {
                                firstChild[numericValue] => operand
                                operand >= 0 and package.nodes[operand].kind == 14
                                    -> if { operand => number! }
                            }
                        number! >= 0 -> if {
                            package.nodes[number!] => literal
                            not (source -> numericLiteralRange.literalUsesFloatingSyntax(literal.start, literal.start + literal.length))
                                -> if {
                                    prepared -> numericCallLiteralAt(sourceModule, numericValue - range.astStart, expectedSymbol, pointerBitWidth) => numeric
                                    numeric.code > 0 -> if {
                                        package -> contextualRecordDecision(sourceModule, literalAst, numeric.literalAst, 38, ownerType, field, expectedElementType) => decision!
                                        numeric.code => decision!.operandTypeSymbol
                                        package.nodes[range.astStart + numeric.locationAst].start => decision!.locationOffset
                                        decision! -> return
                                    }
                                }
                        }
                        valueNode.kind >= 18 and valueNode.kind <= 21
                            -> if {
                                firstChild[numericValue] => left
                                left >= 0 -> if { nextChild[left] } else { -1 } => right
                                left >= 0 and right >= 0 and nextChild[right] < 0
                                    -> if {
                                        resolved.types -> typeIds.materializedReadTypeId(typeByAst[left]) => leftType
                                        resolved.types -> typeIds.materializedReadTypeId(typeByAst[right]) => rightType
                                        leftType >= 0 and rightType >= 0 and (leftType != expectedElementType or rightType != expectedElementType)
                                            -> if {
                                                leftType != expectedElementType -> if { left } else { right } => invalidOperand
                                                package -> contextualRecordDecision(sourceModule, literalAst, invalidOperand - range.astStart, 40, ownerType, field, expectedElementType) => decision!
                                                valueNode.operatorKind => decision!.operandTypeSymbol
                                                decision! -> return
                                            }
                                    }
                            }
                    }
                }

            actualElement != expectedElementType -> if {
                package -> contextualRecordDecision(sourceModule, literalAst, element! - range.astStart, 43, ownerType, field, expectedElementType) => decision!
                actualElement => decision!.operandTypeSymbol
                decision! -> return
            }
            count! + 1 => count!
        }
        nextChild[element!] => element!
    }
    package -> typeIds.arrayStorageSyntax(sourceModule, arrayGlobal - range.astStart) => storage
    storage.isRepeat -> if { storage.length => count! }
    (expectedArray.kind == 4 and count! != expectedArray.length)
        or (expectedArray.kind == 12 and count! > expectedArray.length)
        -> if {
            expectedArray.kind == 4 -> if { 41 } else { 42 } => code
            package -> contextualRecordDecision(sourceModule, literalAst, arrayGlobal - range.astStart, code, ownerType, field, expectedArrayType) => decision!
            count! => decision!.operandTypeSymbol
            decision! -> return
        }
    valid
}

# A committed contextual record owns its labels, not its field value reads.
# Match C# identifier/duplicate checks, declaration-ordered fields, then extras.
contextualRecordDiagnostic package: ref analysis.PackageAnalysis, prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, typeByAst: ref [Int; ~], firstChild: ref [Int; ~], nextChild: ref [Int; ~], pointerBitWidth: Int -> ExpressionOperandDiagnostic {
    ExpressionOperandDiagnostic { code: 0, sourceModule: -1, astNode: -1, operandAst: -1, operatorKind: -1, locationOffset: 0, operandTypeSymbol: -1, operandTypeId: -1, firstTypeId: -1 } => valid
    [Int; ~] => firstField!
    [Int; ~] => lastField!
    [Int; ~] => nextField!
    resolved.types -> each type {
        firstField! -> push(-1)
        lastField! -> push(-1)
    }
    0 => fieldIndex!
    fieldIndex! < (resolved.fields -> len) -> while {
        resolved.fields[fieldIndex!] => field
        nextField! -> push(-1)
        field.status == 0 and field.ownerType >= 0 and field.ownerType < (firstField! -> len)
            -> if {
                firstField![field.ownerType] < 0 -> if { fieldIndex! => firstField![field.ownerType] } else {
                    fieldIndex! => nextField![lastField![field.ownerType]]
                }
                fieldIndex! => lastField![field.ownerType]
            }
        fieldIndex! + 1 => fieldIndex!
    }
    package.ranges -> each range {
        package.sources[range.sourceModule] -> len => sourceLength
        package.sources[range.sourceModule] -> slice(UIntSize(0), sourceLength) => source
        0 => literalAst!
        literalAst! < range.astCount -> while {
            range.astStart + literalAst! => literalGlobal
            typeByAst[literalGlobal] => ownerType
            package.nodes[literalGlobal].kind == 38
                and (package -> expressionTypeIds.nominalStructType(resolved.types, ownerType))
                and (prepared -> declarationBodyIsActive(resolved, range.sourceModule, literalAst!))
                -> if {
                    firstField![ownerType] => visibilityField!
                    visibilityField! >= 0 -> while {
                        resolved.fields[visibilityField!] => field
                        field.status == 0 and field.fieldSymbol >= 0 and field.fieldType >= 0
                            and field.sourceModule >= 0 and field.sourceModule < (prepared.modules -> len)
                            and prepared.modules[field.sourceModule].pathLength > 0
                            and (prepared -> expressionTypeIds.accessibleMemberFieldType(resolved.fields, range.sourceModule, visibilityField!)) < 0
                            -> if {
                                package -> contextualRecordDecision(range.sourceModule, literalAst!, literalAst!, 39, ownerType, visibilityField!, -1) => decision
                                decision -> return
                            }
                        nextField![visibilityField!] => visibilityField!
                    }
                    [Int; ~] => labels!
                    [Int; ~] => values!
                    [Int; ~] => fields!
                    0 => ordinal!
                    firstChild[literalGlobal] => child!
                    child! >= 0 -> while {
                        package.nodes[child!] => item
                        item.kind == 12 -> if {
                            nextChild[child!] => child!
                            continue
                        }
                        ordinal! % 2 == 0 -> if {
                            item.kind != 15 or item.cstRuleId != grammar.ruleIdNameExpression()
                                -> if {
                                    package -> contextualRecordDecision(range.sourceModule, literalAst!, child! - range.astStart, 33, ownerType, -1, -1) => decision
                                    decision -> return
                                }
                            package.tokens[range.tokenStart + item.payloadToken] => token
                            package.sources[range.sourceModule] -> slice(token.span.start, token.span.length) => labelName
                            labels! -> each earlier {
                                package.nodes[earlier] => earlierNode
                                package.tokens[range.tokenStart + earlierNode.payloadToken] => earlierToken
                                (package.sources[range.sourceModule] -> slice(earlierToken.span.start, earlierToken.span.length)) == labelName
                                    -> if {
                                        package -> contextualRecordDecision(range.sourceModule, literalAst!, child! - range.astStart, 34, ownerType, -1, -1) => decision
                                        decision -> return
                                    }
                            }
                            labels! -> push(child!)
                            package -> expressionTypeIds.contextualRecordField(resolved.fields, firstField!, nextField!, ownerType, range.sourceModule, child! - range.astStart) => field
                            fields! -> push(field)
                        } else { values! -> push(child!) }
                        ordinal! + 1 => ordinal!
                        nextChild[child!] => child!
                    }
                    firstField![ownerType] => declared!
                    declared! >= 0 -> while {
                        -1 => initializer!
                        0 => labelIndex!
                        labelIndex! < (fields! -> len) -> while {
                            fields![labelIndex!] == declared! -> if { labelIndex! => initializer! }
                            labelIndex! + 1 => labelIndex!
                        }
                        initializer! < 0 -> if {
                            package -> contextualRecordDecision(range.sourceModule, literalAst!, literalAst!, 35, ownerType, declared!, -1) => decision
                            decision -> return
                        }
                        initializer! < (values! -> len) -> if {
                            values![initializer!] => value
                            resolved.fields[declared!].fieldType => expectedFieldType
                            package -> contextualRecordArrayDiagnostic(prepared, resolved, typeByAst, firstChild, nextChild, pointerBitWidth, range.sourceModule, literalAst!, value, ownerType, declared!, expectedFieldType) => arrayDecision
                            arrayDecision.code > 0 -> if { arrayDecision -> return }
                            resolved.types[expectedFieldType] => expectedNumeric
                            expectedNumeric.symbol -> typeIds.canonicalBuiltinSymbol => expectedSymbol
                            expectedNumeric.kind == 1 and expectedNumeric.origin == 1
                                and ((expectedSymbol >= 2 and expectedSymbol <= 4) or expectedSymbol == 6 or (expectedSymbol >= 8 and expectedSymbol <= 14))
                                -> if {
                                    package -> expressionTypeIds.contextualNumericValueAsts(firstChild, nextChild, value, true) => numericValues
                                    numericValues -> each numericValue {
                                        package.nodes[numericValue] => valueNode
                                        -1 => number!
                                        valueNode.kind == 14 -> if { numericValue => number! }
                                        valueNode.kind == 22 and valueNode.operatorKind == grammar.tokenIdMinus()
                                            -> if {
                                                firstChild[numericValue] => operand
                                                operand >= 0 and package.nodes[operand].kind == 14
                                                    -> if { operand => number! }
                                            }
                                        number! >= 0 -> if {
                                            package.nodes[number!] => literal
                                            not (source -> numericLiteralRange.literalUsesFloatingSyntax(literal.start, literal.start + literal.length))
                                                -> if {
                                                    prepared -> numericCallLiteralAt(range.sourceModule, numericValue - range.astStart, expectedSymbol, pointerBitWidth) => numeric
                                                    numeric.code > 0 -> if {
                                                        package -> contextualRecordDecision(range.sourceModule, literalAst!, numeric.literalAst, 38, ownerType, declared!, expectedFieldType) => decision!
                                                        numeric.code => decision!.operandTypeSymbol
                                                        package.nodes[range.astStart + numeric.locationAst].start => decision!.locationOffset
                                                        decision! -> return
                                                    }
                                                }
                                        }
                                        valueNode.kind >= 18 and valueNode.kind <= 21
                                            -> if {
                                                firstChild[numericValue] => left
                                                left >= 0 -> if { nextChild[left] } else { -1 } => right
                                                left >= 0 and right >= 0 and nextChild[right] < 0
                                                    -> if {
                                                        resolved.types -> typeIds.materializedReadTypeId(typeByAst[left]) => leftType
                                                        resolved.types -> typeIds.materializedReadTypeId(typeByAst[right]) => rightType
                                                        leftType >= 0 and rightType >= 0 and (leftType != expectedFieldType or rightType != expectedFieldType)
                                                            -> if {
                                                                leftType != expectedFieldType -> if { left } else { right } => invalidOperand
                                                                package -> contextualRecordDecision(range.sourceModule, literalAst!, invalidOperand - range.astStart, 40, ownerType, declared!, expectedFieldType) => decision!
                                                                valueNode.operatorKind => decision!.operandTypeSymbol
                                                                decision! -> return
                                                            }
                                                    }
                                            }
                                    }
                                }
                            resolved.types -> typeIds.materializedReadTypeId(typeByAst[value]) => actual
                            actual >= 0 and actual != resolved.fields[declared!].fieldType
                                -> if {
                                    package -> contextualRecordDecision(range.sourceModule, literalAst!, value - range.astStart, 36, ownerType, declared!, actual) => decision
                                    decision -> return
                                }
                        }
                        nextField![declared!] => declared!
                    }
                    0 => extra!
                    extra! < (fields! -> len) -> while {
                        fields![extra!] < 0 -> if {
                            package -> contextualRecordDecision(range.sourceModule, literalAst!, labels![extra!] - range.astStart, 37, ownerType, -1, -1) => decision
                            decision -> return
                        }
                        extra! + 1 => extra!
                    }
                }
            literalAst! + 1 => literalAst!
        }
    }
    valid
}

reservedSysPath path: Text -> Bool {
    (path -> len) >= 4 -> if { (path -> slice(UIntSize(0), UIntSize(4))) == "sys." -> return }
    false
}

functionUsesReservedSysPath prepared: ref semanticContext.SemanticSnapshot, range: analysis.SourceAnalysisRange, symbol: symbols.Symbol, qualified: Bool, local: Bool -> Bool {
    prepared -> semanticContext.isStandardLibrarySource(range.sourceModule)
        -> if { false -> return }
    prepared.modules[range.sourceModule] => identity
    prepared.package.sources[range.sourceModule] -> slice(UIntSize(0), prepared.package.sources[range.sourceModule] -> len) => source
    source -> slice(identity.pathStart, identity.pathLength) => moduleName
    moduleName == "sys" or (moduleName -> reservedSysPath) => reservedModule
    symbol.kind == 31 and symbol.parent >= 0 -> if {
        prepared.package.symbols[range.symbolStart + symbol.parent] => implementation
        implementation.kind == 6 -> if {
            prepared.package.nodes -> typeIds.implTypePaths(range.astStart, range.astCount, implementation.astNode) => paths
            paths.traitAst >= 0 -> if { false -> return }
            paths.ownerAst >= 0 -> if {
                prepared.package.nodes[range.astStart + paths.ownerAst] => owner
                source -> slice(owner.start, owner.length) => ownerName
                ownerName -> reservedSysPath -> if { true -> return }
                false => dottedOwner!
                UIntSize(0) => byteIndex!
                byteIndex! < (ownerName -> len) -> while {
                    (ownerName -> byte(byteIndex!)) == 46 -> if { true => dottedOwner! }
                    byteIndex! + 1 => byteIndex!
                }
                dottedOwner! and (ownerName -> byte(UIntSize(0))) != 91
                    -> if { false -> return }
            }
        }
        reservedModule -> return
    }
    qualified -> if {
        prepared.package.tokens[range.tokenStart + symbol.nameToken] => nameToken
        (source -> slice(nameToken.span.start, nameToken.span.length)) == "sys" -> return
    }
    reservedModule and not local
}

firstFunctionNameDiagnostic prepared: ref semanticContext.SemanticSnapshot, declaredEffects: ref effects.DeclaredEffectIndex -> ExpressionOperandDiagnostic {
    ExpressionOperandDiagnostic { code: 0, sourceModule: -1, astNode: -1, operandAst: -1, operatorKind: -1, locationOffset: 0, operandTypeSymbol: -1, operandTypeId: -1, firstTypeId: -1 } => valid
    prepared.package.ranges -> each range {
        prepared.modules[range.sourceModule].pathLength > 0 => namespaced
        0 => symbolIndex!
        symbolIndex! < range.symbolCount -> while {
            prepared.package.symbols[range.symbolStart + symbolIndex!] => symbol
            (symbol.kind == 7 or symbol.kind == 31) and symbol.astNode >= 0 and symbol.nameToken >= 0
                -> if {
                    range.astStart + symbol.astNode => globalAst
                    prepared.package.nodes[globalAst] => node
                    false => local!
                    node.parent >= 0 -> if {
                        declaredEffects.owners[range.astStart + node.parent] >= 0 => local!
                    }
