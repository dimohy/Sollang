                and logical.payloadToken >= 0 and logical.payloadToken < range.tokenCount
                -> if {
                    0 => mappedBindingChild!
                    mappedBindingChild! < range.astCount -> while {
                        package.nodes[range.astStart + mappedBindingChild!] => bindingValue
                        bindingValue.parent == astIndex! -> if {
                            typeIdByAst![range.astStart + mappedBindingChild!] => bindingValueTypeId
                            bindingValueTypeId >= 0 -> if {
                                resolved.types[bindingValueTypeId] => bindingValueType
                                bindingValueType.kind == 1 and bindingValueType.origin == 1
                                    and bindingValueType.symbol == 18 -> if {
