public firstExpressionOperandDiagnostic package: ref analysis.PackageAnalysis, prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, ir: ref [typedIr.TypedIrNode; ~], mutableNames: ref [UnresolvedMutableNameDiagnostic; ~], pointerBitWidth: Int -> ExpressionOperandDiagnostic {
