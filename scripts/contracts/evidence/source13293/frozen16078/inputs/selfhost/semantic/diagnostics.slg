                }
                -1 => mapPathAst!
                0 => mapPathSearch!
                mapPathSearch! < range.astCount and mapPathAst! < 0
                    -> while {
                        package.nodes[range.astStart + mapPathSearch!].parent == astIndex!
                            -> if { mapPathSearch! => mapPathAst! }
                        mapPathSearch! + 1 => mapPathSearch!
                    }
                mapPathAst! >= 0 -> if {
                    package.nodes[range.astStart + mapPathAst!] => mapPathNode
                    typeIdByAst![range.astStart + mapPathAst!] => mapPathTypeId!
                    0 => mapPathChildSearch!
                    mapPathTypeId! < 0 and mapPathChildSearch! < range.astCount
                        -> while {
                            package.nodes[range.astStart + mapPathChildSearch!] => mapPathChild
                            mapPathChild.parent == mapPathAst!
                                and mapPathChild.start == mapPathNode.start
                                and mapPathChild.length == mapPathNode.length
                                -> if {
