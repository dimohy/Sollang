                0 => mapChildOrdinal!
                0 => mapClauseSearch!
                mapClauseSearch! < range.astCount -> while {
                    package.nodes[range.astStart + mapClauseSearch!] => mapClauseNode
                    mapClauseNode.parent == astIndex! -> if {
                        mapChildOrdinal! > 0 -> if {
                            0 => mapClauseCode!
                            mapChildOrdinal! == 1 and mapDirectChildCount! == 2 and mapOpcode == -307
