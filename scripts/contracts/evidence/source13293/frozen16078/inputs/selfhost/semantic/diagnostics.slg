                }
                package.sources[sourceIndex!] -> len => mapSourceLength
                package.sources[sourceIndex!] -> slice(UIntSize(0), mapSourceLength) => mapSource
                mapSource -> expressionTypeIds.mapExpressionOpcode(package.tokens, range.tokenStart, logical) => mapOpcode
                0 => mapDirectChildCount!
                0 => mapCountSearch!
                mapCountSearch! < range.astCount -> while {
