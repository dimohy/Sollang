import sollang.compiler.ir.typed as typedIr
import sollang.compiler.semantic.context as semanticContext

# Computed numeric subjects and their bound control results retain exact IR links.
main {
    """"
        namespace sample

        select descriptor: Int -> Int {
            descriptor % 4 -> when {
                == 0 { 0 }
                == 1 { 1 }
                == 2 { 2 }
                == 3 { 4 }
                else { 0 }
            } => dictionaryBytes
            descriptor / 64 -> when {
                == 0 { (descriptor / 32) % 2 }
                == 1 { 2 }
                == 2 { 4 }
                == 3 { 8 }
                else { 0 }
            } => sizeBytes
            dictionaryBytes * 10 + sizeBytes
        }

        classify descriptor: Int -> Text {
            descriptor -> when {
                1..<3 => "outside"
                3..3 => "inclusive"
                else => "unexpected"
            } => selected
            selected
        }
    """" => source

    [source,; ~] -> semanticContext.prepare => context
    context -> typedIr.lowerContext => ir
    0 => controls!
    0 => computedSubjects!
    0 => boundControls!
    0 => typedControls!
    0 => directControlValues!
    0 => index!
    index! < (ir -> len) -> while {
        ir[index!] => node
        node.kind == 34 -> if {
            controls! + 1 => controls!
            node.operand0 >= 0 and ir[node.operand0].kind == 8
                -> if { computedSubjects! + 1 => computedSubjects! }
        }
        node.kind == 17 and node.operand0 >= 0 and ir[node.operand0].kind == 34
            -> if { boundControls! + 1 => boundControls! }
        node.kind == 34 and not (node.typeOrigin == 1 and node.typeSymbol == 0)
            -> if { typedControls! + 1 => typedControls! }
        node.kind != 19 and node.parent >= 0 and ir[node.parent].kind == 34
            -> if { directControlValues! + 1 => directControlValues! }
        index! + 1 => index!
    }
    "controls=$(controls!),computed=$(computedSubjects!),bound=$(boundControls!),typed=$(typedControls!),direct=$(directControlValues!)" -> println
}
