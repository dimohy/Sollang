import sys.file as file
import sys.process as process

writeReturning path: Text -> Bool uses File {
    path -> file.openWrite -> when {
        Err(_) { false -> return }
        Ok(writer) {
            [UInt8(97), 98, 99; ~] => bytes
            writer -> writeRangeAt(bytes, 0, 3, 0) -> when {
                Err(_) { false -> return }
                Ok(count) { count != 3 -> if { false -> return } }
            }
            writer -> file.sync -> return
        }
    }
}

readReturning path: Text -> Bool uses File {
    path -> file.openRead -> when {
        Err(_) { false -> return }
        Ok(reader) {
            [UInt8; ~] => bytes!
            0..<3 -> each { bytes! -> push(0) }
            reader -> readIntoAt(bytes!, 0) -> when {
                Err(_) { false -> return }
                Ok(count) { count == 3 -> return }
            }
        }
    }
}

mappedResult path: Text -> Result<file.SourceText, Int> uses File {
    path -> file.mapText -> Result<file.SourceText, Int>.Ok
}

mappedLength path: Text -> UIntSize uses File {
    path -> mappedResult -> when {
        Err(_) { 0 -> return }
        Ok(source) { source -> len -> return }
    }
}

main {
    process.arguments() => arguments
    Arena(0) => sourceStorage!
    "$(arguments[0]).source" -> materialize(sourceStorage!) => source
    Arena(0) => destinationStorage!
    "$(arguments[0]).destination" -> materialize(destinationStorage!) => destination
    source -> writeReturning -> println
    source -> readReturning -> println
    source -> mappedLength -> println
    file.AtomicReplaceRequest { temporary: source, destination: destination } -> file.atomicReplace -> println
    (destination -> file.removePath) == 1 -> println
}
