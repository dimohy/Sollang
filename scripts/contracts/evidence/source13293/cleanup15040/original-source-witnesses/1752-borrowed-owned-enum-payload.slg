enum BorrowFailure {
    Invalid
}

struct BorrowPayload {
    buffer: [UInt8; ~]
}

inspect result: Result<BorrowPayload, BorrowFailure> -> Unit uses Console {
    result -> when {
        Ok(payload) { "len=$(payload.buffer -> len)" -> println }
        Err(_) { "invalid" -> println }
    }
}

main {
    Result<BorrowPayload, BorrowFailure>.Ok(BorrowPayload {
        buffer: [7; ~]
    }) => result
    result -> inspect
}
