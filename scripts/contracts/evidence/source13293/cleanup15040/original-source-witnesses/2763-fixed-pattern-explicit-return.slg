makeValues: -> Result<[UInt8; 8], Int> => Result<[UInt8; 8], Int>.Ok([7; 8])

first: -> UInt8 {
    makeValues() -> when {
        Ok(values) { values[0] -> return }
        Err(_) { 0 -> return }
    }
}

copyValues: -> [UInt8; 8] {
    makeValues() -> when {
        Ok(values) { values -> return }
        Err(_) { [0; 8] -> return }
    }
}

main {
    first() -> println
    copyValues() => values
    values[0] -> println
}
