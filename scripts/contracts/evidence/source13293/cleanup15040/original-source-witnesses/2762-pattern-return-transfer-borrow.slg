struct Payload { values: [Int; ~] }
enum Owner { Full(Payload) }

make value: Int -> Owner => Owner.Full(Payload { values: [value,; ~] })
take values: move [Int; ~] -> Int => values[0]

resolve consume: Bool -> Int {
    make(7) -> when {
        Full(payload) {
            consume -> if {
                payload.values => values
                values -> take -> return
            }
            payload.values -> len -> return
        }
    }
}

inspect owner: ref Owner -> Int {
    owner -> when {
        Full(payload) { payload.values[0] -> return }
    }
}

main {
    true -> resolve -> println
    false -> resolve -> println
    make(9) => owner
    owner -> inspect -> println
    owner -> inspect -> println
}
