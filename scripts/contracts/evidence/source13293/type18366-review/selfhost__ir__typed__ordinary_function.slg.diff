+functionUsesRuntimeValueGenerics source: Text, sourceIndex: Int, functionSymbol: Int, facts: ref SourceLowerFacts, prepared: ref semanticContext.SemanticSnapshot, functionNodes: ref [Int; ~], nodeStart: Int, nodeCount: Int -> Bool {
+    prepared.package.ranges[sourceIndex] => range
+    facts.names -> each name {
+        name.symbol >= 0 and name.symbol < range.symbolCount
+            and prepared.package.nodes[range.astStart + name.astNode].kind == 15
+            -> if {
+                prepared.package.symbols[range.symbolStart + name.symbol] => symbol
+                symbol.kind == 32 and symbol.parent == functionSymbol
+                    -> if { true -> return }
+            }
+    }
+    # A symbolic repeat count is a token, rather than a resolved Name AST.
+    # The frozen body index keeps other functions and signature types out.
+    nodeStart => position!
+    position! < nodeStart + nodeCount -> while {
+        prepared.package.nodes[range.astStart + functionNodes[position!]] => node
+        node.kind == 37 -> if {
+            source -> typeIds.arrayStorageSyntaxFromTokens(prepared.package.tokens, range.tokenStart, node) => storage
+            storage.isRepeat and storage.length < 0 -> if { true -> return }
+        }
+        position! + 1 => position!
+    }
+    prepared.interpolationRanges -> each interpolationRange {
+        interpolationRange.sourceModule == sourceIndex
+            -> if {
+                interpolationRange.nodeStart => interpolationIndex!
+                interpolationIndex! < interpolationRange.nodeStart + interpolationRange.nodeCount
+                    -> while {
+                        prepared.interpolations[interpolationIndex!] => node
+                        node.kind == 1 and node.symbol >= 0 and node.symbol < range.symbolCount
+                            -> if {
+                                prepared.package.symbols[range.symbolStart + node.symbol] => symbol
+                                symbol.kind == 32 and symbol.parent == functionSymbol
+                                    -> if { true -> return }
+                            }
+                        interpolationIndex! + 1 => interpolationIndex!
+                    }
+            }
+    }
+    false
+}
