+# Template value parameters are compile-time bindings, never runtime inputs of
+# a concrete instance. Resolved Name edges retain the same constant identity.
+specializeGenericArrayRepeatLength array: TypedIrNode, prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], valueSymbols: ref [Int; ~], value: Int -> Option<TypedIrNode> {
+    prepared.package.ranges[array.sourceModule] => range
+    prepared.package.nodes[range.astStart + array.astNode] => literal
+    prepared.package.sources[array.sourceModule] -> len => sourceLength
+    prepared.package.sources[array.sourceModule] -> slice(UIntSize(0), sourceLength) => source
+    source -> typeIds.arrayStorageSyntaxFromTokens(prepared.package.tokens, range.tokenStart, literal) => storage
+    not storage.isRepeat or storage.length >= 0 -> if { array -> Option<TypedIrNode>.Some -> return }
+    array.typeId < 0 or array.typeId >= (types -> len) or types[array.typeId].kind != 4
+        -> if { Option<TypedIrNode>.None -> return }
+    prepared.package.tokens -> typeIds.symbolicArrayRepeatCountToken(range.tokenStart, literal) => countToken
+    countToken < 0 -> if { Option<TypedIrNode>.None -> return }
+    prepared.package.tokens[range.tokenStart + countToken] => countName
+    source -> slice(countName.span.start, countName.span.length) => countSpelling
+    false => boundCount!
+    valueSymbols -> each symbol {
+        prepared.package.symbols[range.symbolStart + symbol] => parameter
+        prepared.package.tokens[range.tokenStart + parameter.nameToken] => parameterName
+        (source -> slice(parameterName.span.start, parameterName.span.length)) == countSpelling
+            -> if { true => boundCount! }
+    }
+    not boundCount! -> if { Option<TypedIrNode>.None -> return }
+    types -> expressionTypeIds.internArrayLiteralType(4, types[array.typeId].first, value) => concreteType
+    types[concreteType] => canonical
+    array => specialized!
+    concreteType => specialized!.typeId
+    canonical.kind => specialized!.typeKind
+    canonical.origin => specialized!.typeOrigin
+    canonical.module => specialized!.typeModule
+    canonical.symbol => specialized!.typeSymbol
+    specialized! -> Option<TypedIrNode>.Some
+}
