+genericIntegerParameterHash function: TypedIrNode, prepared: ref semanticContext.SemanticSnapshot -> UInt64 {
+    function.kind != 0 or function.sourceModule < 0
+        or function.sourceModule >= (prepared.package.ranges -> len)
+        or function.symbol < 0 -> if { 0 -> return }
+    prepared.package.ranges[function.sourceModule] => range
+    0 => symbolIndex!
+    symbolIndex! < range.symbolCount -> while {
+        prepared.package.symbols[range.symbolStart + symbolIndex!] => parameter
+        parameter.kind == 32 and parameter.parent == function.symbol
+            and (prepared.package -> analysis.declaresIntegerValueGeneric(function.sourceModule, function.astNode, parameter.nameToken))
+            -> if {
+                prepared.package.tokens[range.tokenStart + parameter.nameToken] => name
+                UInt64(1469598103934665603) => hash!
+                UIntSize(0) => byteIndex!
+                byteIndex! < name.span.length -> while {
+                    prepared.package.sources[function.sourceModule] -> byte(name.span.start + byteIndex!) => value
+                    hash! * 1099511628211 + UInt64(value) => hash!
+                    byteIndex! + 1 => byteIndex!
+                }
+                hash! -> return
+            }
+        symbolIndex! + 1 => symbolIndex!
+    }
+    0
+}
