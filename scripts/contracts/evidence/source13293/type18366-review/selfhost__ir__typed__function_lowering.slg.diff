+sealGenericIntegerConstants nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], functionIndex: Int, nodeCount: Int, value: Int -> Bool {
+    value < 0 -> if { true -> return }
+    nodes[functionIndex] => function!
+    [Int; ~] => runtimeParameters!
+    [Int; ~] => valueSymbols!
+    function!.operand1 => parameterIndex!
+    0 => ordinal!
+    parameterIndex! >= 0 -> while {
+        nodes[parameterIndex!] => parameter!
+        ordinal! == 0 -> if { function!.nextOperand } else { parameter!.nextOperand } => nextParameter
+        parameter! -> isHiddenValueInput(prepared) -> if {
+            valueSymbols! -> push(parameter!.symbol)
+            3 => parameter!.kind
+            value => parameter!.opcode
+            -1 => parameter!.payloadToken
+            -1 => parameter!.operand0
+            -1 => parameter!.operand1
+            -1 => parameter!.nextOperand
+            parameter! => nodes[parameterIndex!]
+        } else { runtimeParameters! -> push(parameterIndex!) }
+        nextParameter => parameterIndex!
+        ordinal! + 1 => ordinal!
+    }
+    -1 => function!.operand1
+    -1 => function!.nextOperand
+    (runtimeParameters! -> len) > 0 -> if { runtimeParameters![0] => function!.operand1 }
+    (runtimeParameters! -> len) > 1 -> if { runtimeParameters![1] => function!.nextOperand }
+    function! => nodes[functionIndex]
+    1 => runtimeIndex!
+    runtimeIndex! < (runtimeParameters! -> len) -> while {
+        runtimeParameters![runtimeIndex!] => runtimeParameter
+        nodes[runtimeParameter] => parameter!
+        -1 => parameter!.nextOperand
+        runtimeIndex! + 1 < (runtimeParameters! -> len)
+            -> if { runtimeParameters![runtimeIndex! + 1] => parameter!.nextOperand }
+        parameter! => nodes[runtimeParameter]
+        runtimeIndex! + 1 => runtimeIndex!
+    }
+    functionIndex + 1 => readIndex!
+    readIndex! < functionIndex + nodeCount -> while {
+        nodes[readIndex!] => read!
+        false => valueReference!
+        read!.kind == 5 and read!.sourceModule == function!.sourceModule
+            -> if {
+                valueSymbols! -> each symbol {
+                    read!.symbol == symbol -> if { true => valueReference! }
+                }
+            }
+        valueReference!
+            -> if {
+                value => read!.opcode
+                3 => read!.kind
+                -1 => read!.payloadToken
+                -1 => read!.operand0
+                -1 => read!.operand1
+                read! => nodes[readIndex!]
+            }
+        read!.kind == 14 -> if {
+            read! -> specializeGenericArrayRepeatLength(prepared, types, valueSymbols!, value) -> when {
+                Some(literal) { literal => nodes[readIndex!] }
+                None { false -> return }
+            }
+        }
+        readIndex! + 1 => readIndex!
+    }
+    true
+}
