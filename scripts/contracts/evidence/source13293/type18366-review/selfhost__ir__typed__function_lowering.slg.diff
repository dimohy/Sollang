+# Hidden numeric ABI parameters have no source-level runtime argument.
+isHiddenValueInput parameter: TypedIrNode, prepared: ref semanticContext.SemanticSnapshot -> Bool {
+    parameter.kind != 10 or parameter.sourceModule < 0 or parameter.symbol < 0
+        -> if { false -> return }
+    prepared.package.ranges[parameter.sourceModule] => range
+    parameter.symbol < range.symbolCount and prepared.package.symbols[range.symbolStart + parameter.symbol].kind == 32
+}
