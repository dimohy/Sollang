namespace sollang.compiler.path_identity

import sollang.compiler.syntax.unicode_identifier as unicodeIdentifier

# Generated from pinned .NET11 ICU OrdinalCasing BMP and CharUnicodeInfo
# supplementary authorities. Text retains the language strict UTF8 invariant.
ranges: -> Text => ""

singletons: -> Text => ""

hexValue data: Text, offset: Int -> Int {
    0 => value!
    0 => digit!
    digit! < 6 -> while {
        data -> byte(UIntSize(offset + digit!)) => code
        code >= '0' and code <= '9' -> if { Int(code) - 48 } else { Int(code) - 55 } => number
        value! * 16 + number => value!
        digit! + 1 => digit!
    }
    value!
}

upper scalar: Int -> Int {
    ranges() => rangeData
    0 => lower!
    Int(rangeData -> len) / 18 => limit!
    lower! < limit! -> while {
        (lower! + limit!) / 2 => middle
        rangeData -> hexValue(middle * 18) => first
        rangeData -> hexValue(middle * 18 + 6) => last
        scalar < first -> if { middle => limit! } else {
            scalar > last -> if { middle + 1 => lower! } else {
                rangeData -> hexValue(middle * 18 + 12) => mappedFirst
                mappedFirst + scalar - first -> return
            }
        }
    }
    singletons() => pairData
    0 => pairLower!
    Int(pairData -> len) / 12 => pairLimit!
    pairLower! < pairLimit! -> while {
        (pairLower! + pairLimit!) / 2 => middle
        pairData -> hexValue(middle * 12) => source
        scalar < source -> if { middle => pairLimit! } else {
            scalar > source -> if { middle + 1 => pairLower! } else {
                pairData -> hexValue(middle * 12 + 6) -> return
            }
        }
    }
    scalar
}

scalarAt source: Text, offset: UIntSize, width: UIntSize -> Int {
    source -> byte(offset) => first
    width == 1 -> if { Int(first) -> return }
    width == 2 -> if { Int(first) - 192 } else {
        width == 3 -> if { Int(first) - 224 } else { Int(first) - 240 }
    } => scalar!
    UIntSize(1) => index!
    index! < width -> while {
        scalar! * 64 + Int(source -> byte(offset + index!)) - 128 => scalar!
        index! + 1 => index!
    }
    scalar!
}

public equalsOrdinalIgnoreCase left: Text, right: Text -> Bool {
    UIntSize(0) => leftOffset!
    UIntSize(0) => rightOffset!
    leftOffset! < (left -> len) and rightOffset! < (right -> len)
        -> while {
            left -> unicodeIdentifier.scalarWidth(leftOffset!) => leftWidth
            right -> unicodeIdentifier.scalarWidth(rightOffset!) => rightWidth
            leftWidth == 0 -> if { left -> each scalar {} }
            rightWidth == 0 -> if { right -> each scalar {} }
            left -> scalarAt(leftOffset!, leftWidth) -> upper => leftUpper
            right -> scalarAt(rightOffset!, rightWidth) -> upper => rightUpper
            leftUpper != rightUpper -> if { false -> return }
            leftOffset! + leftWidth => leftOffset!
            rightOffset! + rightWidth => rightOffset!
        }
    leftOffset! == (left -> len) and rightOffset! == (right -> len)
}
