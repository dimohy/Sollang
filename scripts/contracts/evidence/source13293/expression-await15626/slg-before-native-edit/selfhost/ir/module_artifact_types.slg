}

hashIndex words: [UInt64; ~], start: Int, count: Int, hash: UInt64 -> Int {
    -1 => result!
    0 => recordIndex!
    recordIndex! < count and result! < 0 -> while {
        words[start + recordIndex! * 14] == hash -> if { recordIndex! => result! }
        recordIndex! + 1 => recordIndex!
    }
    result!
}

decodedHashIndex hashes: [UInt64; ~], hash: UInt64 -> Int {
    -1 => result!
    0 => index!
    index! < (hashes -> len) and result! < 0 -> while {
        hashes[index!] == hash -> if { index! => result! }
        index! + 1 => index!
    }
    result!
}

public indexOfHash hashes: [UInt64; ~], hash: UInt64 -> Int {
    hashes -> decodedHashIndex(hash)
}

signedFieldsFit words: [UInt64; ~], offset: Int -> Bool {
    words[offset + 1] <= 4294967295 and words[offset + 2] <= 4294967295
        and words[offset + 5] <= 4294967295 and words[offset + 10] <= 4294967295
        and words[offset + 13] <= 4294967295
}

public validate words: [UInt64; ~], start: Int, count: Int -> Int {
    0 => status!
    start < 0 or count < 0 or start > (words -> len)
        -> if { 1 => status! }
    status! == 0 -> if {
        count > ((words -> len) - start) / 14 -> if { 1 => status! }
    }
    UInt64(0) => previousHash!
    0 => recordIndex!
    status! == 0 and recordIndex! < count -> while {
        start + recordIndex! * 14 => offset
        words[offset] => storedHash
        previousHash! -> lessHash(storedHash) => orderValid
        recordIndex! > 0 and not orderValid -> if { 2 => status! }
        words[offset + 3] > 1 or words[offset + 6] > 1 or words[offset + 8] > 1 or words[offset + 12] > 1
            -> if { 3 => status! }
        words[offset + 3] == 0 and words[offset + 4] != 0
            -> if { 3 => status! }
        words[offset + 6] == 0 and words[offset + 7] != 0
            -> if { 3 => status! }
        words[offset + 8] == 0 and words[offset + 9] != 0
            -> if { 3 => status! }
        status! == 0 and not (words -> signedFieldsFit(offset))
            -> if { 3 => status! }
        words[offset + 7] => firstReferenceHash
        words[offset + 9] => secondReferenceHash
        words[offset + 6] == 1 and (words -> hashIndex(start, count, firstReferenceHash)) < 0
            -> if { 4 => status! }
        words[offset + 8] == 1 and (words -> hashIndex(start, count, secondReferenceHash)) < 0
            -> if { 4 => status! }
        words -> recordHashAt(offset) => actualHash
        status! == 0 and actualHash != storedHash -> if { 5 => status! }
        storedHash => previousHash!
        recordIndex! + 1 => recordIndex!
    }
    status!
}


public decode words: [UInt64; ~], identities: [modules.ModuleIdentity; ~] -> DecodedTypeTable {
    9 => start
    0 => count!
    0 => status!
    (words -> len) >= start -> if {
        words[5] <= UInt64(((words -> len) - start) / 14)
            -> if { Int(words[5]) => count! } else { 1 => status! }
    } else { 1 => status! }
    [typeIds.SemanticType; ~] => types!
    [UInt64; ~] => hashes!
    UInt64(0) => previousHash!
    0 => validationIndex!
    status! == 0 and validationIndex! < count! -> while {
        start + validationIndex! * 14 => validationOffset
        words[validationOffset] => storedHash
        validationIndex! > 0 and storedHash <= previousHash!
            -> if { 2 => status! }
        words[validationOffset + 3] > 1 or words[validationOffset + 6] > 1 or words[validationOffset + 8] > 1 or words[validationOffset + 12] > 1
            -> if { 3 => status! }
        words[validationOffset + 3] == 0 and words[validationOffset + 4] != 0
            -> if { 3 => status! }
        words[validationOffset + 6] == 0 and words[validationOffset + 7] != 0
            -> if { 3 => status! }
        words[validationOffset + 8] == 0 and words[validationOffset + 9] != 0
            -> if { 3 => status! }
        status! == 0 and not (words -> signedFieldsFit(validationOffset))
            -> if { 3 => status! }
        words[validationOffset + 7] => firstValidationHash
        words[validationOffset + 9] => secondValidationHash
        words[validationOffset + 6] == 1 and (words -> hashIndex(start, count!, firstValidationHash)) < 0
            -> if { 4 => status! }
        words[validationOffset + 8] == 1 and (words -> hashIndex(start, count!, secondValidationHash)) < 0
            -> if { 4 => status! }
        words -> recordHashAt(validationOffset) => actualHash
        status! == 0 and actualHash != storedHash -> if { 5 => status! }
        storedHash => previousHash!
        validationIndex! + 1 => validationIndex!
    }
    [Bool; ~] => decoded!
    0 => seed!
    status! == 0 and seed! < count! -> while {
        decoded! -> push(false)
        seed! + 1 => seed!
    }
    0 => decodedCount!
    true => changed!
    status! == 0 and decodedCount! < count! and changed!
        -> while {
            false => changed!
            0 => recordIndex!
            recordIndex! < count! -> while {
                not decoded![recordIndex!] -> if {
                    start + recordIndex! * 14 => offset
                    words[offset + 7] => firstReferenceHash
                    words[offset + 9] => secondReferenceHash
                    (words[offset + 6] == 0 or (hashes! -> decodedHashIndex(firstReferenceHash)) >= 0) => firstReady
                    (words[offset + 8] == 0 or (hashes! -> decodedHashIndex(secondReferenceHash)) >= 0) => secondReady
                    firstReady and secondReady -> if {
                        -1 => module!
                        words[offset + 3] == 1 -> if {
                            words[offset + 4] => moduleHash
                            identities -> moduleIndex(moduleHash) => module!
                            module! < 0 -> if { 6 => status! }
                        }
                        -1 => first!
                        words[offset + 6] == 1 -> if {
                            words[offset + 7] => firstHash
                            hashes! -> decodedHashIndex(firstHash) => first!
                        }
                        -1 => second!
                        words[offset + 8] == 1 -> if {
                            words[offset + 9] => secondHash
                            hashes! -> decodedHashIndex(secondHash) => second!
                        }
                        words[offset + 1] => kindWord
                        words[offset + 2] => originWord
                        words[offset + 5] => symbolWord
                        words[offset + 10] => lengthWord
                        words[offset + 13] => statusWord
                        kindWord -> signedValue => kind
                        originWord -> signedValue => origin
                        symbolWord -> signedValue => symbol
                        lengthWord -> signedValue => length
                        statusWord -> signedValue => recordStatus
                        types! -> push(typeIds.SemanticType {
                            kind: kind
                            origin: origin
                            module: module!
                            symbol: symbol
                            first: first!
                            second: second!
                            length: length
                            lengthHash: words[offset + 11]
                            containsParameter: words[offset + 12] == 1
                            status: recordStatus
                        })
                        hashes! -> push(words[offset])
                        true => decoded![recordIndex!]
                        decodedCount! + 1 => decodedCount!
                        true => changed!
                    }
                }
                recordIndex! + 1 => recordIndex!
            }
        }
    status! == 0 and decodedCount! != count! -> if { 7 => status! }
    DecodedTypeTable { types: types!, hashes: hashes!, status: status! } => result
    result
}

failedTypeRecipeEncoding status: Int -> EncodedTypeRecipes {
    EncodedTypeRecipes { words: [UInt64; ~], status: status }
}

failedTypeRecipeDecoding status: Int -> DecodedTypeRecipes {
    [UInt64; ~] => empty
    empty -> interfaces.decodeDeclarationKeys => declarations
    DecodedTypeRecipes { types: [typeIds.SemanticType; ~], details: emptyTypeDetails(), declarations: declarations, status: status }
}

# Auxiliary generation payload. The enclosing normal cache must supply and
# validate compiler/target/config/module digests and its SHA-256 checksum.
# A type payload owns only the declaration keys its nominal recipes reference.
# Unrelated local pattern bindings and repeated impl containers are not type
# identities. Referenced duplicate keys still reach the strict dictionary encoder.
typeRecipeDeclarations types: ref [typeIds.SemanticType; ~], declarations: ref interfaces.DeclarationIdentityIndex -> interfaces.DeclarationIdentityIndex {
    [Int; ~] => sourceModules!
    [Int; ~] => symbols!
    [Int; ~] => starts!
    [Int; ~] => lengths!
    [UInt64; ~] => hashes!
    [UInt64; ~] => words!
    declarations.sourceModules -> len => count
    declarations.status == 0 and (declarations.symbols -> len) == count
        and (declarations.starts -> len) == count and (declarations.lengths -> len) == count
        and (declarations.hashes -> len) == count => valid
    0 => status!
    not valid -> if { 1 => status! }
    0 => index!
    status! == 0 and index! < count -> while {
        false => needed!
        types -> each type {
            type.module >= 0 and type.module == declarations.sourceModules[index!]
                and type.symbol == declarations.symbols[index!]
                -> if { true => needed! }
        }
        needed! -> if {
            declarations.starts[index!] => start
            declarations.lengths[index!] => length
            start < 0 or length <= 0 or start > (declarations.words -> len)
                -> if { 1 => status! }
            status! == 0 -> if {
                length > (declarations.words -> len) - start
                    -> if { 1 => status! }
            }
            status! == 0 -> if {
                sourceModules! -> push(declarations.sourceModules[index!])
                symbols! -> push(declarations.symbols[index!])
                starts! -> push(words! -> len)
                lengths! -> push(length)
                hashes! -> push(declarations.hashes[index!])
                0..<length -> each offset { words! -> push(declarations.words[start + offset]) }
            }
        }
        index! + 1 => index!
    }
    interfaces.DeclarationIdentityIndex { keyIndexBySymbol: [Int; ~], sourceModules: sourceModules!, symbols: symbols!, starts: starts!, lengths: lengths!, hashes: hashes!, words: words!, status: status! }
}

public encodeRecipes types: ref [typeIds.SemanticType; ~], details: ref TypeDetails, allDeclarations: ref interfaces.DeclarationIdentityIndex -> EncodedTypeRecipes {
    types -> typeRecipeDeclarations(allDeclarations) => declarations
    declarations -> interfaces.encodeDeclarationKeys => keys
    keys.status != 0 or details.status != 0
        or (declarations.symbols -> len) != (declarations.sourceModules -> len)
        -> if { 1 -> failedTypeRecipeEncoding -> return }
    [UInt64(6002245308444529748), 1, 0, 0, 7, UInt64(types -> len), UInt64(keys.words -> len); ~] => words!
    keys.words -> each word { words! -> push(word) }
    [Int; ~] => mapped!
    0 => typeIndex!
    typeIndex! < (types -> len) -> while {
        types[typeIndex!] => type
        type.status != 0 or type.kind < 1 or type.kind > 14
            or type.module < -1 or type.first < -1 or type.second < -1
            or type.first >= typeIndex! or type.second >= typeIndex!
            -> if { 1 -> failedTypeRecipeEncoding -> return }
        UInt64(0) => declarationId!
        type.module >= 0 -> if {
            -1 => found!
            0 => keyIndex!
            keyIndex! < (declarations.sourceModules -> len)
                -> while {
                    declarations.sourceModules[keyIndex!] == type.module
                        and declarations.symbols[keyIndex!] == type.symbol
                        -> if {
                            found! >= 0 -> if { 1 -> failedTypeRecipeEncoding -> return }
                            keyIndex! => found!
                        }
                    keyIndex! + 1 => keyIndex!
                }
            found! < 0 -> if { 2 -> failedTypeRecipeEncoding -> return }
            UInt64(keys.keyIds[found!]) + 1 => declarationId!
        }
        details -> normalizedDetail(typeIndex!, type, mapped!) => detail
        detail.status != 0 -> if { detail.status -> failedTypeRecipeEncoding -> return }
        words! -> push(UInt64(type.kind))
        words! -> push(type.origin -> signedWord)
        words! -> push(declarationId!)
        declarationId! > 0 -> if { words! -> push(0) } else { words! -> push(type.symbol -> signedWord) }
        words! -> push(UInt64(type.first + 1))
        words! -> push(UInt64(type.second + 1))
        words! -> push(type.length -> signedWord)
        words! -> push(type.lengthHash)
        type.containsParameter -> if { words! -> push(1) } else { words! -> push(0) }
        words! -> push(UInt64(detail.words -> len))
        detail.words -> each word { words! -> push(word) }
        mapped! -> push(typeIndex!)
        typeIndex! + 1 => typeIndex!
    }
    UInt64(words! -> len) => words![4]
    EncodedTypeRecipes { words: words!, status: 0 }
}

public decodeRecipes words: ref [UInt64; ~] -> DecodedTypeRecipes {
    (words -> len) < 7 -> if { 1 -> failedTypeRecipeDecoding -> return }
    words[0] != 6002245308444529748 or words[1] != 1 or words[2] != 0 or words[3] != 0
        or words[4] != UInt64(words -> len) or words[6] < 7 or words[6] > UInt64((words -> len) - 7)
        -> if { 1 -> failedTypeRecipeDecoding -> return }
    Int(words[6]) => keyLength
    [UInt64; ~] => keyWords!
    0 => keyIndex!
    keyIndex! < keyLength -> while {
        keyWords! -> push(words[7 + keyIndex!])
        keyIndex! + 1 => keyIndex!
    }
    keyWords! -> interfaces.decodeDeclarationKeys => declarations
    declarations.status != 0 -> if { 1 -> failedTypeRecipeDecoding -> return }
    7 + keyLength => cursor!
    words[5] > UInt64(((words -> len) - cursor!) / 10)
        -> if { 1 -> failedTypeRecipeDecoding -> return }
    Int(words[5]) => count
    [typeIds.SemanticType; ~] => types!
    [Int; ~] => mapped!
    [Int; ~] => starts!
    [Int; ~] => lengths!
    [UInt64; ~] => details!
    0 => typeIndex!
    typeIndex! < count -> while {
        (words -> len) - cursor! < 10 -> if { 1 -> failedTypeRecipeDecoding -> return }
        words[cursor!] => kind
        words[cursor! + 1] => origin
        words[cursor! + 2] => declarationId
        words[cursor! + 3] => symbol
        words[cursor! + 4] => first
        words[cursor! + 5] => second
        words[cursor! + 6] => length
        words[cursor! + 7] => lengthHash
        words[cursor! + 8] => containsParameter
        words[cursor! + 9] => detailLength
        kind < 1 or kind > 14 or origin > 4294967295 or symbol > 4294967295 or length > 4294967295
            or declarationId > UInt64(declarations.symbols -> len) or (declarationId > 0 and symbol != 0)
            or first > UInt64(typeIndex!) or second > UInt64(typeIndex!) or containsParameter > 1
            -> if { 1 -> failedTypeRecipeDecoding -> return }
        cursor! + 10 => cursor!
        detailLength > UInt64((words -> len) - cursor!)
            or (kind != 10 and kind != 11 and detailLength != 0)
            -> if { 1 -> failedTypeRecipeDecoding -> return }
        [UInt64; ~] => rawDetail!
        0 => wordIndex!
        wordIndex! < Int(detailLength) -> while {
            rawDetail! -> push(words[cursor! + wordIndex!])
            wordIndex! + 1 => wordIndex!
        }
        declarationId > 0 -> if { 0 } else { -1 } => module
        declarationId > 0 -> if { Int(declarationId - 1) } else { symbol -> signedValue } => typeSymbol
        typeIds.SemanticType { kind: Int(kind), origin: origin -> signedValue, module: module, symbol: typeSymbol, first: Int(first) - 1, second: Int(second) - 1, length: length -> signedValue, lengthHash: lengthHash, containsParameter: containsParameter == 1, status: 0 } => type
        TypeDetails { starts: [0; ~], lengths: [Int(detailLength); ~], words: rawDetail!, status: 0 } => rawDetails
        rawDetails -> normalizedDetail(0, type, mapped!) => detail
        detail.status != 0 -> if { detail.status -> failedTypeRecipeDecoding -> return }
        starts! -> push(details! -> len)
        lengths! -> push(detail.words -> len)
        detail.words -> each word { details! -> push(word) }
        types! -> push(type)
        mapped! -> push(typeIndex!)
        cursor! + Int(detailLength) => cursor!
        typeIndex! + 1 => typeIndex!
    }
    cursor! != (words -> len) -> if { 1 -> failedTypeRecipeDecoding -> return }
    DecodedTypeRecipes { types: types!, details: TypeDetails { starts: starts!, lengths: lengths!, words: details!, status: 0 }, declarations: declarations, status: 0 }
}

failedTypeRecipeRestoration status: Int -> RestoredTypeRecipes {
    typeIds.SemanticTypeSet { types: [typeIds.SemanticType; ~], references: [typeIds.TypeReference; ~], fields: [typeIds.NominalField; ~] } => semantic
    RestoredTypeRecipes { semantic: semantic, typeIds: [Int; ~], status: status }
}

# One transaction for a normal generation reader: no type arena is exposed
# until exact field labels have also been connected to the current package.
public restoreRecipes words: ref [UInt64; ~], package: ref analysis.PackageAnalysis, current: ref typeIds.SemanticTypeSet -> RestoredTypeRecipes {
    words -> decodeRecipes => decoded
    decoded.status != 0 -> if { decoded.status -> failedTypeRecipeRestoration -> return }
    package -> captureTypeDetails(current) => currentDetails
    currentDetails.status != 0 -> if { currentDetails.status -> failedTypeRecipeRestoration -> return }
    package -> modules.identitiesAnalyzed => identities
    package -> interfaces.declarationIdentitiesAnalyzed(identities) => declarations
    decoded.types -> rebindWithDetails(decoded.details, decoded.declarations, declarations, current.types, currentDetails) => rebound
    rebound.status != 0 -> if { rebound.status -> failedTypeRecipeRestoration -> return }
    rebound -> materializeProductFields(package, current.fields, current.types -> len) => fields
    fields.status != 0 -> if { fields.status -> failedTypeRecipeRestoration -> return }
    [typeIds.TypeReference; ~] => references!
    current.references -> each reference { references! -> push(reference) }
    typeIds.SemanticTypeSet { types: rebound.types, references: references!, fields: fields.fields } => semantic
    RestoredTypeRecipes { semantic: semantic, typeIds: rebound.typeIds, status: 0 }
}

failedSelectedTypeRecipes status: Int -> SelectedTypeRecipes {
    SelectedTypeRecipes { words: [UInt64; ~], recipeBySourceType: [Int; ~], status: status }
}

# Detail validation and exact field labels use the same consumer as encoding.
recipeDependencies type: typeIds.SemanticType, index: Int, details: ref TypeDetails, identityMap: ref [Int; ~] -> RecipeDependencies {
    identityMap -> len => count
    type.status != 0 or type.kind < 1 or type.kind > 14 or type.module < -1
        or type.first < -1 or type.second < -1 or type.first >= count or type.second >= count
        -> if { RecipeDependencies { ids: [Int; ~], status: 1 } -> return }
    details -> normalizedDetail(index, type, identityMap) => detail
    detail.status != 0 -> if { RecipeDependencies { ids: [Int; ~], status: detail.status } -> return }
    [Int; ~] => ids!
    type.first >= 0 -> if { ids! -> push(type.first) }
    type.second >= 0 -> if { ids! -> push(type.second) }
    type.kind == 10 -> if {
        1 => cursor!
        0 => field!
        field! < type.length -> while {
            detail.words[cursor!] => label
            cursor! + 1 => cursor!
            label > 0 -> if { cursor! + Int(label - 1) => cursor! }
            ids! -> push(Int(detail.words[cursor!]))
            cursor! + 1 => cursor!
            field! + 1 => field!
        }
    }
    RecipeDependencies { ids: ids!, status: 0 }
}

# Explicit owner roots determine the payload. Unrelated unresolved sentinels
# remain outside it; a selected unresolved root/dependency is never repaired or
# dropped. The map translates final owner facts into compact recipe positions.
public encodeSelectedRecipes types: ref [typeIds.SemanticType; ~], details: ref TypeDetails, declarations: ref interfaces.DeclarationIdentityIndex, roots: ref [Int; ~] -> SelectedTypeRecipes {
    details.status != 0 -> if { 1 -> failedSelectedTypeRecipes -> return }
    types -> len => count
    [Bool; ~] => needed!
    [Int; ~] => identityMap!
    [Int; ~] => mapped!
    [Int; ~] => dependencyStarts!
    [Int; ~] => dependencyLengths!
    0..<count -> each index {
        needed! -> push(false)
        identityMap! -> push(index)
        mapped! -> push(-1)
        dependencyStarts! -> push(0)
        dependencyLengths! -> push(0)
    }
    [Int; ~] => work!
    roots -> each root {
        root < 0 or root >= count -> if { 1 -> failedSelectedTypeRecipes -> return }
        not needed![root] -> if {
            true => needed![root]
            work! -> push(root)
        }
    }
    [Int; ~] => dependencyIds!
    0 => workIndex!
    workIndex! < (work! -> len) -> while {
        work![workIndex!] => index
        types[index] -> recipeDependencies(index, details, identityMap!) => dependencies
        dependencies.status != 0 -> if { dependencies.status -> failedSelectedTypeRecipes -> return }
        dependencyIds! -> len => dependencyStarts![index]
        dependencies.ids -> len => dependencyLengths![index]
        dependencies.ids -> each dependency {
            dependencyIds! -> push(dependency)
            not needed![dependency] -> if {
                true => needed![dependency]
                work! -> push(dependency)
            }
        }
        workIndex! + 1 => workIndex!
    }
    [typeIds.SemanticType; ~] => selected!
    [Int; ~] => detailStarts!
    [Int; ~] => detailLengths!
    [UInt64; ~] => detailWords!
    true => changed!
    (selected! -> len) < (work! -> len) and changed!
        -> while {
            false => changed!
            0 => index!
            index! < count -> while {
                needed![index!] and mapped![index!] < 0 -> if {
                    true => ready!
                    0 => edge!
                    edge! < dependencyLengths![index!] -> while {
                        dependencyIds![dependencyStarts![index!] + edge!] => dependency
                        mapped![dependency] < 0 -> if { false => ready! }
                        edge! + 1 => edge!
                    }
                    ready! -> if {
                        types[index!] => type!
                        details -> normalizedDetail(index!, type!, mapped!) => detail
                        detail.status != 0 -> if { detail.status -> failedSelectedTypeRecipes -> return }
                        type!.first >= 0 -> if { mapped![type!.first] => type!.first }
                        type!.second >= 0 -> if { mapped![type!.second] => type!.second }
                        selected! -> len => mapped![index!]
                        selected! -> push(type!)
                        detailStarts! -> push(detailWords! -> len)
                        detailLengths! -> push(detail.words -> len)
                        detail.words -> each word { detailWords! -> push(word) }
                        true => changed!
                    }
                }
                index! + 1 => index!
            }
        }
    (selected! -> len) != (work! -> len) -> if { 3 -> failedSelectedTypeRecipes -> return }
    TypeDetails { starts: detailStarts!, lengths: detailLengths!, words: detailWords!, status: 0 } => selectedDetails
    selected! -> encodeRecipes(selectedDetails, declarations) => encoded
    encoded.status != 0 -> if { encoded.status -> failedSelectedTypeRecipes -> return }
    SelectedTypeRecipes { words: encoded.words, recipeBySourceType: mapped!, status: 0 }
}
