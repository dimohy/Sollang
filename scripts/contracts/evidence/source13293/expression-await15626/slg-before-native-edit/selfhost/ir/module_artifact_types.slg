namespace sollang.compiler.ir.module_artifact_types

import sollang.compiler.semantic.modules as modules
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.semantic.module_interfaces as interfaces
import sollang.compiler.semantic.analysis as analysis
import syntax.generated.slg as grammar

# A canonical type record contains its structural hash followed by thirteen
# stable fields. Module references carry an explicit presence word because a
# real module path hash is allowed to be zero.
public struct EncodedTypeTable {
    public words: [UInt64; ~]
    public hashes: [UInt64; ~]
    public count: Int
    public status: Int
}

public struct DecodedTypeTable {
    public types: [typeIds.SemanticType; ~]
    public hashes: [UInt64; ~]
    public status: Int
}

# Materialization is a transaction: the caller publishes this owned table only
# after its field/binding/call restoration also succeeds. typeIds maps decoded
# recipe positions to current-session interned types, never persisted TypeIds.
public struct ReboundTypeTable {
    public types: [typeIds.SemanticType; ~]
    public typeIds: [Int; ~]
    public status: Int
    public details: TypeDetails
}

# One bounded word range per type. Products contain an ordered field count,
# then presence/length, exact UTF-8 label bytes, and a type recipe reference.
# Product-field terms contain just their exact label; all other types are empty.
public struct TypeDetails {
    public starts: [Int; ~]
    public lengths: [Int; ~]
    public words: [UInt64; ~]
    public status: Int
}

public struct MaterializedTypeFields {
    public fields: [typeIds.NominalField; ~]
    public status: Int
}

# Semantic generations use full declaration keys and recipe positions. The
# retained complete-IR hash payload below remains a separate, unchanged format.
public struct EncodedTypeRecipes {
    public words: [UInt64; ~]
    public status: Int
}

public struct SelectedTypeRecipes {
    public words: [UInt64; ~]
    public recipeBySourceType: [Int; ~]
    public status: Int
}

struct RecipeDependencies {
    ids: [Int; ~]
    status: Int
}

public struct DecodedTypeRecipes {
    public types: [typeIds.SemanticType; ~]
    public details: TypeDetails
    public declarations: interfaces.DeclarationIdentityIndex
    public status: Int
}

public struct RestoredTypeRecipes {
    public semantic: typeIds.SemanticTypeSet
    public typeIds: [Int; ~]
    public status: Int
}

struct FieldLabelLocation {
    sourceModule: Int
    token: Int
    status: Int
}

# Product labels are values, not declarations. An exact current identifier
# token supplies their text storage; no cached source/token ordinal is reused.
locateFieldLabel package: ref analysis.PackageAnalysis, words: ref [UInt64; ~], start: Int, length: Int -> FieldLabelLocation {
    0 => sourceIndex!
    sourceIndex! < (package.ranges -> len) -> while {
        package.ranges[sourceIndex!] => range
        0 => tokenIndex!
        tokenIndex! < range.tokenCount -> while {
            package.tokens[range.tokenStart + tokenIndex!] => token
            token.kind == grammar.tokenIdIdentifier() and token.span.length == UIntSize(length)
                -> if {
                    true => matches!
                    0 => byteIndex!
                    matches! and byteIndex! < length -> while {
                        UInt64(package.sources[sourceIndex!] -> byte(token.span.start + UIntSize(byteIndex!))) != words[start + byteIndex!]
                            -> if { false => matches! }
                        byteIndex! + 1 => byteIndex!
                    }
                    matches! -> if {
                        FieldLabelLocation { sourceModule: sourceIndex!, token: tokenIndex!, status: 0 } -> return
                    }
                }
            tokenIndex! + 1 => tokenIndex!
        }
        sourceIndex! + 1 => sourceIndex!
    }
    FieldLabelLocation { sourceModule: -1, token: -1, status: 1 }
}

# Reuse current fields and populate newly interned product owners from the
# normalized detail arena. The caller commits this table with rebound.types.
# 1 invalid detail, 5 no exact current label token. Failure publishes no fields.
public materializeProductFields table: ref ReboundTypeTable, package: ref analysis.PackageAnalysis, currentFields: ref [typeIds.NominalField; ~], currentTypeCount: Int -> MaterializedTypeFields {
    table.status != 0 -> if {
        MaterializedTypeFields { fields: [typeIds.NominalField; ~], status: table.status } -> return
    }
    currentTypeCount < 0 or currentTypeCount > (table.types -> len)
        or (table.details.starts -> len) != (table.types -> len)
        or (table.details.lengths -> len) != (table.types -> len)
        -> if { MaterializedTypeFields { fields: [typeIds.NominalField; ~], status: 1 } -> return }
    [typeIds.NominalField; ~] => fields!
    currentFields -> each field { fields! -> push(field) }
    currentTypeCount => owner!
    owner! < (table.types -> len) -> while {
        table.types[owner!] => type
        type.kind == 10 -> if {
            table.details.starts[owner!] => start
            table.details.lengths[owner!] => length
            start < 0 or length <= 0 or start > (table.details.words -> len)
                -> if { MaterializedTypeFields { fields: [typeIds.NominalField; ~], status: 1 } -> return }
            length > (table.details.words -> len) - start or type.length < 0
                -> if { MaterializedTypeFields { fields: [typeIds.NominalField; ~], status: 1 } -> return }
            start + length => end
            table.details.words[start] != UInt64(type.length)
                -> if {
                    MaterializedTypeFields { fields: [typeIds.NominalField; ~], status: 1 } -> return
                }
            start + 1 => cursor!
            0 => ordinal!
            ordinal! < type.length -> while {
                cursor! >= end -> if {
                    MaterializedTypeFields { fields: [typeIds.NominalField; ~], status: 1 } -> return
                }
                table.details.words[cursor!] => label
                cursor! + 1 => cursor!
                FieldLabelLocation { sourceModule: -1, token: -1, status: 0 } => location!
                label > 0 -> if {
                    label <= 1 or label - 1 > UInt64(end - cursor!)
                        -> if {
                            MaterializedTypeFields { fields: [typeIds.NominalField; ~], status: 1 } -> return
                        }
                    Int(label - 1) => labelLength
                    package -> locateFieldLabel(table.details.words, cursor!, labelLength) => location!
                    location!.status != 0 -> if {
                        MaterializedTypeFields { fields: [typeIds.NominalField; ~], status: 5 } -> return
                    }
                    cursor! + labelLength => cursor!
                }
                cursor! >= end -> if {
                    MaterializedTypeFields { fields: [typeIds.NominalField; ~], status: 1 } -> return
                }
                table.details.words[cursor!] >= UInt64(table.types -> len)
                    -> if {
                        MaterializedTypeFields { fields: [typeIds.NominalField; ~], status: 1 } -> return
                    }
                fields! -> push(typeIds.NominalField { ownerType: owner!, sourceModule: location!.sourceModule, ownerSymbol: -1, fieldSymbol: -1, labelToken: location!.token, ordinal: ordinal!, fieldType: Int(table.details.words[cursor!]), status: 0 })
                cursor! + 1 => cursor!
                ordinal! + 1 => ordinal!
            }
            cursor! != end -> if {
                MaterializedTypeFields { fields: [typeIds.NominalField; ~], status: 1 } -> return
            }
        }
        owner! + 1 => owner!
    }
    MaterializedTypeFields { fields: fields!, status: 0 }
}

emptyTypeDetails: -> TypeDetails => TypeDetails { starts: [Int; ~], lengths: [Int; ~], words: [UInt64; ~], status: 0 }

appendLabel package: ref analysis.PackageAnalysis, sourceModule: Int, labelToken: Int, words: mut [UInt64; ~] -> Bool {
    labelToken == -1 -> if {
        words -> push(0)
        true -> return
    }
    sourceModule < 0 or sourceModule >= (package.ranges -> len)
        -> if { false -> return }
    package.ranges[sourceModule] => range
    labelToken < 0 or labelToken >= range.tokenCount
        -> if { false -> return }
    package.tokens[range.tokenStart + labelToken] => token
    token.span.start > (package.sources[sourceModule] -> len)
        -> if { false -> return }
    token.span.length > (package.sources[sourceModule] -> len) - token.span.start
        -> if { false -> return }
    words -> push(UInt64(token.span.length) + 1)
    UIntSize(0) => byteIndex!
    byteIndex! < token.span.length -> while {
        words -> push(UInt64(package.sources[sourceModule] -> byte(token.span.start + byteIndex!)))
        byteIndex! + 1 => byteIndex!
    }
    true
}

public captureTypeDetails package: ref analysis.PackageAnalysis, types: ref typeIds.SemanticTypeSet -> TypeDetails {
    package -> captureTypeDetailsAnalyzed(types.types, types.references, types.fields)
}

# A substituted field retains its canonical label identity but has no new
# source annotation. Reuse the already normalized label only when every
# matching identity has identical bytes; ambiguity is rejected.
appendDerivedProductLabel typeIndex: Int, types: ref [typeIds.SemanticType; ~], starts: ref [Int; ~], lengths: ref [Int; ~], words: mut [UInt64; ~] -> Bool {
    types[typeIndex] => type
    -1 => selected!
    0 => selectedLength!
    0 => previous!
    previous! < typeIndex -> while {
        types[previous!] => candidate
        candidate.kind == 11 and candidate.length == type.length and candidate.lengthHash == type.lengthHash
            -> if {
                lengths[previous!] => length
                length <= 0 -> if { false -> return }
                starts[previous!] => start
                selected! < 0 -> if {
                    start => selected!
                    length => selectedLength!
                } else {
                    length != selectedLength! -> if { false -> return }
                    0 => byte!
                    byte! < length -> while {
                        words[start + byte!] != words[selected! + byte!]
                            -> if { false -> return }
                        byte! + 1 => byte!
                    }
                }
            }
        previous! + 1 => previous!
    }
    selected! < 0 -> if { false -> return }
    0 => byte!
    byte! < selectedLength! -> while {
        words -> push(words[selected! + byte!])
        byte! + 1 => byte!
    }
    true
}

public captureTypeDetailsAnalyzed package: ref analysis.PackageAnalysis, sourceTypes: ref [typeIds.SemanticType; ~], sourceReferences: ref [typeIds.TypeReference; ~], sourceFields: ref [typeIds.NominalField; ~] -> TypeDetails {
    [Int; ~] => starts!
    [Int; ~] => lengths!
    [UInt64; ~] => words!
    0 => status!
    0 => typeIndex!
    typeIndex! < (sourceTypes -> len) and status! == 0
        -> while {
            words! -> len => start
            starts! -> push(start)
            sourceTypes[typeIndex!] => type
            type.kind == 10 -> if {
                type.length < 0 -> if { 1 => status! }
                false => declared!
                sourceReferences -> each reference {
                    reference.typeId == typeIndex! and reference.status == 0
                        -> if { true => declared! }
                }
                status! == 0 -> if { words! -> push(UInt64(type.length)) }
                type.first => fieldType!
                0 => ordinal!
                ordinal! < type.length and status! == 0 -> while {
                    fieldType! < 0 or fieldType! >= typeIndex! -> if { 1 => status! } else {
                        sourceTypes[fieldType!] => canonicalField
                        canonicalField.kind != 11 or canonicalField.first < 0 or canonicalField.first >= fieldType!
                            -> if { 1 => status! } else {
                                -1 => selected!
                                0 => fieldIndex!
                                fieldIndex! < (sourceFields -> len) -> while {
                                    sourceFields[fieldIndex!] => field
                                    field.ownerType == typeIndex! and field.ordinal == ordinal!
                                        -> if {
                                            selected! >= 0 -> if { 1 => status! }
                                            fieldIndex! => selected!
                                        }
                                    fieldIndex! + 1 => fieldIndex!
                                }
                                words! -> len => labelStart
                                lengths![fieldType!] => labelLength
                                selected! >= 0 -> if {
                                    sourceFields[selected!] => field
                                    field.status != 0 or field.fieldType != canonicalField.first
                                        -> if { 1 => status! }
                                    package -> appendLabel(field.sourceModule, field.labelToken, words!)
                                        -> unless { 1 => status! }
                                    (words! -> len) - labelStart != labelLength -> if { 1 => status! } else {
                                        0 => byte!
                                        byte! < labelLength and status! == 0 -> while {
                                            words![labelStart + byte!] != words![starts![fieldType!] + byte!]
                                                -> if { 1 => status! }
                                            byte! + 1 => byte!
                                        }
                                    }
                                } else {
                                    declared! -> if { 1 => status! } else {
                                        0 => byte!
                                        byte! < labelLength -> while {
                                            words! -> push(words![starts![fieldType!] + byte!])
                                            byte! + 1 => byte!
                                        }
                                    }
                                }
                                words! -> push(UInt64(canonicalField.first))
                                canonicalField.second => fieldType!
                            }
                    }
                    ordinal! + 1 => ordinal!
                }
                fieldType! != -1 -> if { 1 => status! }
            }
            type.kind == 11 -> if {
                false => found!
                0 => referenceIndex!
                referenceIndex! < (sourceReferences -> len) and not found!
                    -> while {
                        sourceReferences[referenceIndex!] => reference
                        reference.typeId == typeIndex! -> if {
                            package.ranges[reference.sourceModule] => range
                            0 => termIndex!
                            termIndex! < range.termCount and not found!
                                -> while {
                                    package.terms[range.termStart + termIndex!] => term
                                    term.astNode == reference.typeAst and term.kind == 11
                                        -> if {
                                            package -> appendLabel(reference.sourceModule, term.nameToken, words!)
                                                -> if { true => found! }
                                        }
                                    termIndex! + 1 => termIndex!
                                }
                        }
                        referenceIndex! + 1 => referenceIndex!
                    }
                not found! -> if {
                    typeIndex! -> appendDerivedProductLabel(sourceTypes, starts!, lengths!, words!) => found!
                }
                not found! -> if { 1 => status! }
            }
            lengths! -> push((words! -> len) - start)
            typeIndex! + 1 => typeIndex!
        }
    status! != 0 -> if {
        TypeDetails { starts: [Int; ~], lengths: [Int; ~], words: [UInt64; ~], status: status! } -> return
    }
    TypeDetails { starts: starts!, lengths: lengths!, words: words!, status: 0 }
}


normalizedDetail details: ref TypeDetails, typeIndex: Int, type: typeIds.SemanticType, mapped: ref [Int; ~] -> TypeDetails {
    type.kind != 10 and type.kind != 11 -> if { emptyTypeDetails() -> return }
    details.status != 0 or typeIndex < 0 or typeIndex >= (details.starts -> len)
        or typeIndex >= (details.lengths -> len)
        -> if { TypeDetails { starts: [Int; ~], lengths: [Int; ~], words: [UInt64; ~], status: 4 } -> return }
    details.starts[typeIndex] => start
    details.lengths[typeIndex] => length
    start < 0 or length <= 0 or start > (details.words -> len)
        -> if { TypeDetails { starts: [Int; ~], lengths: [Int; ~], words: [UInt64; ~], status: 1 } -> return }
    length > (details.words -> len) - start
        -> if { TypeDetails { starts: [Int; ~], lengths: [Int; ~], words: [UInt64; ~], status: 1 } -> return }
    [UInt64; ~] => words!
    start => cursor!
    start + length => end
    1 => count!
    type.kind == 10 -> if {
        type.length < 0 or details.words[cursor!] != UInt64(type.length)
            -> if { TypeDetails { starts: [Int; ~], lengths: [Int; ~], words: [UInt64; ~], status: 1 } -> return }
        type.length => count!
        words! -> push(details.words[cursor!])
        cursor! + 1 => cursor!
    }
    0 => field!
    field! < count! -> while {
        cursor! >= end -> if {
            TypeDetails { starts: [Int; ~], lengths: [Int; ~], words: [UInt64; ~], status: 1 } -> return
        }
        details.words[cursor!] => label
        words! -> push(label)
        cursor! + 1 => cursor!
        label > 0 -> if {
            label - 1 > UInt64(end - cursor!) -> if {
                TypeDetails { starts: [Int; ~], lengths: [Int; ~], words: [UInt64; ~], status: 1 } -> return
            }
            Int(label - 1) => bytes
            0 => byteIndex!
            byteIndex! < bytes -> while {
                details.words[cursor!] > 255 -> if {
                    TypeDetails { starts: [Int; ~], lengths: [Int; ~], words: [UInt64; ~], status: 1 } -> return
                }
                words! -> push(details.words[cursor!])
                cursor! + 1 => cursor!
                byteIndex! + 1 => byteIndex!
            }
        }
        type.kind == 10 -> if {
            cursor! >= end -> if {
                TypeDetails { starts: [Int; ~], lengths: [Int; ~], words: [UInt64; ~], status: 1 } -> return
            }
            details.words[cursor!] >= UInt64(mapped -> len)
                -> if {
                    TypeDetails { starts: [Int; ~], lengths: [Int; ~], words: [UInt64; ~], status: 1 } -> return
                }
            words! -> push(UInt64(mapped[Int(details.words[cursor!])]))
            cursor! + 1 => cursor!
        }
        field! + 1 => field!
    }
    cursor! != end -> if {
        TypeDetails { starts: [Int; ~], lengths: [Int; ~], words: [UInt64; ~], status: 1 } -> return
    }
    TypeDetails { starts: [Int; ~], lengths: [Int; ~], words: words!, status: 0 }
}

sameMaterializedType left: typeIds.SemanticType, right: typeIds.SemanticType -> Bool {
    left.origin == right.origin
        or ((left.origin == 0 or left.origin == 2) and (right.origin == 0 or right.origin == 2)) => sameOrigin
    left.kind == right.kind and sameOrigin and left.module == right.module
        and left.symbol == right.symbol and left.first == right.first and left.second == right.second
        and left.length == right.length and left.lengthHash == right.lengthHash
        and ((left.containsParameter and right.containsParameter)
        or (not left.containsParameter and not right.containsParameter)) and left.status == right.status
}

# Decoded types refer to a generation-local declaration dictionary. Its old
# coordinates select a full key; only matching that key authorizes rebinding.
# 1 invalid recipe/dictionary, 2 missing declaration, 3 ambiguous declaration,
# 4 product field metadata required. Product identity includes exact labels and
# ordered field types stored outside SemanticType; a length/hash is insufficient.
public rebind recipes: ref [typeIds.SemanticType; ~], cachedDeclarations: ref interfaces.DeclarationIdentityIndex, currentDeclarations: ref interfaces.DeclarationIdentityIndex, currentTypes: ref [typeIds.SemanticType; ~] -> ReboundTypeTable {
    emptyTypeDetails() => cachedDetails
    emptyTypeDetails() => currentDetails
    recipes -> rebindWithDetails(cachedDetails, cachedDeclarations, currentDeclarations, currentTypes, currentDetails)
}

public rebindWithDetails recipes: ref [typeIds.SemanticType; ~], cachedDetails: ref TypeDetails, cachedDeclarations: ref interfaces.DeclarationIdentityIndex, currentDeclarations: ref interfaces.DeclarationIdentityIndex, currentTypes: ref [typeIds.SemanticType; ~], currentDetails: ref TypeDetails -> ReboundTypeTable {
    cachedDeclarations.sourceModules -> len => declarationCount
    cachedDeclarations.status != 0 or currentDeclarations.status != 0
        or (cachedDeclarations.symbols -> len) != declarationCount
        or (cachedDeclarations.starts -> len) != declarationCount
        or (cachedDeclarations.lengths -> len) != declarationCount
        -> if { ReboundTypeTable { types: [typeIds.SemanticType; ~], typeIds: [Int; ~], details: emptyTypeDetails(), status: 1 } -> return }
    [typeIds.SemanticType; ~] => staged!
    currentTypes -> each type { staged! -> push(type) }
    [Int; ~] => mapped!
    [Int; ~] => detailStarts!
    [Int; ~] => detailLengths!
    [UInt64; ~] => detailWords!
    [Int; ~] => currentMap!
    0 => currentIndex!
    currentIndex! < (currentTypes -> len) -> while {
        currentMap! -> push(currentIndex!)
        currentIndex! + 1 => currentIndex!
    }
    0 => detailIndex!
    detailIndex! < (currentTypes -> len) -> while {
        currentDetails -> normalizedDetail(detailIndex!, currentTypes[detailIndex!], currentMap!) => detail
        detail.status != 0 -> if {
            ReboundTypeTable { types: [typeIds.SemanticType; ~], typeIds: [Int; ~], details: emptyTypeDetails(), status: detail.status } -> return
        }
        detailStarts! -> push(detailWords! -> len)
        detailLengths! -> push(detail.words -> len)
        detail.words -> each word { detailWords! -> push(word) }
        detailIndex! + 1 => detailIndex!
    }
    0 => recipeIndex!
    recipeIndex! < (recipes -> len) -> while {
        recipes[recipeIndex!] => recipe!
        recipe!.status != 0 or recipe!.first < -1 or recipe!.second < -1
            or recipe!.first >= recipeIndex! or recipe!.second >= recipeIndex!
            or recipe!.module < -1
            -> if { ReboundTypeTable { types: [typeIds.SemanticType; ~], typeIds: [Int; ~], details: emptyTypeDetails(), status: 1 } -> return }
        cachedDetails -> normalizedDetail(recipeIndex!, recipe!, mapped!) => detail
        detail.status != 0 -> if {
            ReboundTypeTable { types: [typeIds.SemanticType; ~], typeIds: [Int; ~], details: emptyTypeDetails(), status: detail.status } -> return
        }
        recipe!.first >= 0 -> if { mapped![recipe!.first] => recipe!.first }
        recipe!.second >= 0 -> if { mapped![recipe!.second] => recipe!.second }
        recipe!.module >= 0 -> if {
            -1 => declaration!
            0 => candidate!
            candidate! < declarationCount -> while {
                cachedDeclarations.sourceModules[candidate!] == recipe!.module
                    and cachedDeclarations.symbols[candidate!] == recipe!.symbol
                    -> if {
                        declaration! >= 0 -> if {
                            ReboundTypeTable { types: [typeIds.SemanticType; ~], typeIds: [Int; ~], details: emptyTypeDetails(), status: 1 } -> return
                        }
                        candidate! => declaration!
                    }
                candidate! + 1 => candidate!
            }
            declaration! < 0 -> if {
                ReboundTypeTable { types: [typeIds.SemanticType; ~], typeIds: [Int; ~], details: emptyTypeDetails(), status: 2 } -> return
            }
            currentDeclarations -> interfaces.findDeclarationIdentityRange(cachedDeclarations.words, cachedDeclarations.starts[declaration!], cachedDeclarations.lengths[declaration!]) => target
            target.status != 0 -> if {
                target.status == 2 -> if { 3 } else { 2 } => status
                ReboundTypeTable { types: [typeIds.SemanticType; ~], typeIds: [Int; ~], details: emptyTypeDetails(), status: status } -> return
            }
            target.sourceModule => recipe!.module
            target.symbol => recipe!.symbol
        }
        -1 => found!
        0 => existing!
        existing! < (staged! -> len) and found! < 0
            -> while {
                staged![existing!] -> sameMaterializedType(recipe!)
                    -> if {
                        detailLengths![existing!] == (detail.words -> len) => equal!
                        0 => wordIndex!
                        equal! and wordIndex! < (detail.words -> len)
                            -> while {
                                detailWords![detailStarts![existing!] + wordIndex!] != detail.words[wordIndex!]
                                    -> if { false => equal! }
                                wordIndex! + 1 => wordIndex!
                            }
                        equal! -> if { existing! => found! }
                    }
                existing! + 1 => existing!
            }
        found! < 0 -> if {
            staged! -> len => found!
            staged! -> push(recipe!)
            detailStarts! -> push(detailWords! -> len)
            detailLengths! -> push(detail.words -> len)
            detail.words -> each word { detailWords! -> push(word) }
        }
        mapped! -> push(found!)
        recipeIndex! + 1 => recipeIndex!
    }
    ReboundTypeTable { types: staged!, typeIds: mapped!, details: TypeDetails { starts: detailStarts!, lengths: detailLengths!, words: detailWords!, status: 0 }, status: 0 }
}

struct CanonicalTypeRecord {
    kind: UInt64
    origin: UInt64
    modulePresent: UInt64
    moduleHash: UInt64
    symbol: UInt64
    firstPresent: UInt64
    firstHash: UInt64
    secondPresent: UInt64
    secondHash: UInt64
    length: UInt64
    lengthHash: UInt64
    containsParameter: UInt64
    status: UInt64
}

mix hash: UInt64, value: UInt64 -> UInt64 {
    (hash + 11400714819323198485) * (hash + 13787848793156543929) + (value + 10723151780598845931) * (value + 7146057691288625177) + 1099511628211
}

lessHash left: UInt64, right: UInt64 -> Bool {
    UInt64(9223372036854775808) => midpoint
    left / midpoint => leftHigh
    right / midpoint => rightHigh
    leftHigh < rightHigh -> if {
        true
    } else {
        leftHigh > rightHigh -> if {
            false
        } else {
            left % midpoint < right % midpoint
        }
    }
}

signedWord value: Int -> UInt64 {
    value >= 0 -> if {
        UInt64(value) * 2
    } else {
        UInt64(-(value + 1)) * 2 + 1
    }
}

signedValue word: UInt64 -> Int {
    word % 2 == 0 -> if {
        Int(word / 2)
    } else {
        -(Int(word / 2) + 1)
    }
}

moduleHash identities: [modules.ModuleIdentity; ~], sourceModule: Int -> UInt64 {
    UInt64(0) => result!
    0 => identityIndex!
    identityIndex! < (identities -> len) -> while {
        identities[identityIndex!].sourceIndex == sourceModule
            -> if {
                identities[identityIndex!].pathHash => result!
                identities -> len => identityIndex!
            } else { identityIndex! + 1 => identityIndex! }
    }
    result!
}

moduleIndex identities: [modules.ModuleIdentity; ~], hash: UInt64 -> Int {
    -1 => result!
    0 => identityIndex!
    identityIndex! < (identities -> len) and result! < 0
        -> while {
            identities[identityIndex!].pathHash == hash -> if {
                identities[identityIndex!].sourceIndex => result!
            }
            identityIndex! + 1 => identityIndex!
        }
    result!
}

canonicalRecord current: typeIds.SemanticType, hashes: [UInt64; ~], identities: [modules.ModuleIdentity; ~] -> CanonicalTypeRecord {
    current.kind -> signedWord => kind
    current.origin -> signedWord => origin
    UInt64(0) => modulePresent!
    UInt64(0) => stableModuleHash!
    current.module >= 0 -> if {
        1 => modulePresent!
        identities -> moduleHash(current.module) => stableModuleHash!
    }
    current.symbol -> signedWord => symbol
    UInt64(0) => firstPresent!
    UInt64(0) => stableFirstHash!
    current.first >= 0 -> if {
        1 => firstPresent!
        hashes[current.first] => stableFirstHash!
    }
    UInt64(0) => secondPresent!
    UInt64(0) => stableSecondHash!
    current.second >= 0 -> if {
        1 => secondPresent!
        hashes[current.second] => stableSecondHash!
    }
    current.length -> signedWord => length
    UInt64(0) => containsParameter!
    current.containsParameter -> if { 1 => containsParameter! }
    current.status -> signedWord => status
    CanonicalTypeRecord {
        kind: kind
        origin: origin
        modulePresent: modulePresent!
        moduleHash: stableModuleHash!
        symbol: symbol
        firstPresent: firstPresent!
        firstHash: stableFirstHash!
        secondPresent: secondPresent!
        secondHash: stableSecondHash!
        length: length
        lengthHash: current.lengthHash
        containsParameter: containsParameter!
        status: status
    }
}

recordHash record: CanonicalTypeRecord -> UInt64 {
    UInt64(16320118547808316911) -> mix(record.kind) => hash1
    hash1 -> mix(record.origin) => hash2
    hash2 -> mix(record.modulePresent) => hash3
    hash3 -> mix(record.moduleHash) => hash4
    hash4 -> mix(record.symbol) => hash5
    hash5 -> mix(record.firstPresent) => hash6
    hash6 -> mix(record.firstHash) => hash7
    hash7 -> mix(record.secondPresent) => hash8
    hash8 -> mix(record.secondHash) => hash9
    hash9 -> mix(record.length) => hash10
    hash10 -> mix(record.lengthHash) => hash11
    hash11 -> mix(record.containsParameter) => hash12
    hash12 -> mix(record.status)
}

recordHashAt words: [UInt64; ~], offset: Int -> UInt64 {
    words[offset + 1] => kind
    words[offset + 2] => origin
    words[offset + 3] => modulePresent
    words[offset + 4] => moduleHash
    words[offset + 5] => symbol
    words[offset + 6] => firstPresent
    words[offset + 7] => firstHash
    words[offset + 8] => secondPresent
    words[offset + 9] => secondHash
    words[offset + 10] => length
    words[offset + 11] => lengthHash
    words[offset + 12] => containsParameter
    words[offset + 13] => status
    CanonicalTypeRecord { kind: kind, origin: origin, modulePresent: modulePresent, moduleHash: moduleHash, symbol: symbol, firstPresent: firstPresent, firstHash: firstHash, secondPresent: secondPresent, secondHash: secondHash, length: length, lengthHash: lengthHash, containsParameter: containsParameter, status: status } => record
    record -> recordHash
}

sameRecord left: CanonicalTypeRecord, right: CanonicalTypeRecord -> Bool {
    (left.kind == right.kind and left.origin == right.origin and left.modulePresent == right.modulePresent and left.moduleHash == right.moduleHash and left.symbol == right.symbol and left.firstPresent == right.firstPresent and left.firstHash == right.firstHash and left.secondPresent == right.secondPresent and left.secondHash == right.secondHash and left.length == right.length and left.lengthHash == right.lengthHash and left.containsParameter == right.containsParameter and left.status == right.status)
}

public encode types: [typeIds.SemanticType; ~], identities: [modules.ModuleIdentity; ~] -> EncodedTypeTable {
    [UInt64; ~] => hashes!
    [UInt64; ~] => words!
    0 => status!
    0 => typeIndex!
    typeIndex! < (types -> len) -> while {
        types[typeIndex!] => current
        (current.first >= typeIndex!) or (current.second >= typeIndex!)
            -> if { 1 => status! }
        current.first < -1 or current.second < -1 -> if { 1 => status! }
        status! != 0 -> if {
            EncodedTypeTable { words: [UInt64; ~], hashes: [UInt64; ~], count: 0, status: status! } -> return
        }
        current -> canonicalRecord(hashes!, identities) => record
        record -> recordHash => currentHash
        hashes! -> push(currentHash)
        typeIndex! + 1 => typeIndex!
    }

    [Bool; ~] => emitted!
    0 => emittedIndex!
    emittedIndex! < (types -> len) -> while {
        emitted! -> push(false)
        emittedIndex! + 1 => emittedIndex!
    }
    UInt64(0) => previousHash!
    -1 => previousSelected!
    0 => processedCount!
    0 => uniqueCount!
    processedCount! < (types -> len) -> while {
        -1 => selected!
        UInt64(18446744073709551615) => selectedHash!
        0 => candidate!
        candidate! < (types -> len) -> while {
            hashes![candidate!] => candidateHash
            candidateHash -> lessHash(selectedHash!) => candidateLess
            not emitted![candidate!] and (selected! < 0 or candidateLess)
                -> if {
                    candidate! => selected!
                    hashes![candidate!] => selectedHash!
                }
            candidate! + 1 => candidate!
        }
        true => emitted![selected!]
        false => duplicate!
        uniqueCount! > 0 and selectedHash! == previousHash!
            -> if {
                types[selected!] -> canonicalRecord(hashes!, identities) => selectedRecord
                types[previousSelected!] -> canonicalRecord(hashes!, identities) => previousRecord
                selectedRecord -> sameRecord(previousRecord)
                    -> if {
                        true => duplicate!
                    } else { 2 => status! }
            }
        not duplicate! -> if {
            selectedHash! => previousHash!
            selected! => previousSelected!
            types[selected!] => current
            current -> canonicalRecord(hashes!, identities) => record
            words! -> push(selectedHash!)
            words! -> push(record.kind)
            words! -> push(record.origin)
            words! -> push(record.modulePresent)
            words! -> push(record.moduleHash)
            words! -> push(record.symbol)
            words! -> push(record.firstPresent)
            words! -> push(record.firstHash)
            words! -> push(record.secondPresent)
            words! -> push(record.secondHash)
            words! -> push(record.length)
            words! -> push(record.lengthHash)
            words! -> push(record.containsParameter)
            words! -> push(record.status)
            uniqueCount! + 1 => uniqueCount!
        }
        processedCount! + 1 => processedCount!
    }
    EncodedTypeTable { words: words!, hashes: hashes!, count: uniqueCount!, status: status! } => result
