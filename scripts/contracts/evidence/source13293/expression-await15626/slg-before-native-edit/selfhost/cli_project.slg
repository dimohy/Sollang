namespace sollang.compiler.cli_project

import sollang.compiler.project
import sollang.compiler.manifest_diagnostics as manifestDiagnostics
import sollang.compiler.package_versions as versions
import sollang.compiler.source_root as sourceRoot
import std.path as pathComponents
import std.uri as uri
import std.uri.percent as percent
import sys.file as file
import sys.path as path
import sollang.compiler.manifest_entry as manifestEntry
import sys.directory.kind as kinds
import sys.text as text
import sollang.compiler.path_identity as pathIdentity
import sollang.compiler.syntax as syntax
import sollang.compiler.syntax.unicode_identifier as unicodeIdentifier

unitValue: -> Unit {
    false => ignored
}

public struct ProjectInput {
    public status: Int
    public diagnostic: Text
    public source: Text
    public sourceDirectory: Text
    public projectDirectory: Text
    public productName: Text
    public multiProduct: Bool
    public dependencyCount: Int
}

textEndsWith value: Text, suffix: Text -> Bool {
    value -> len => valueLength
    suffix -> len => suffixLength
    suffixLength <= valueLength => matches!
    valueLength - suffixLength => start
    UIntSize(0) => index!
    matches! and index! < suffixLength -> while {
        (value -> byte(start + index!)) != (suffix -> byte(index!))
            -> if { false => matches! }
        index! + 1 => index!
    }
    matches!
}

textEquals left: Text, right: Text -> Bool {
    (left -> len) == (right -> len) => matches!
    UIntSize(0) => index!
    matches! and index! < (left -> len) -> while {
        (left -> byte(index!)) != (right -> byte(index!))
            -> if { false => matches! }
        index! + 1 => index!
    }
    matches!
}

directoryOf value: Text -> Text {
    UIntSize(0) => lastSeparator!
    false => found!
    UIntSize(0) => index!
    index! < (value -> len) -> while {
        value -> byte(index!) => current
        current == 47 or current == 92 -> if {
            index! => lastSeparator!
            true => found!
        }
        index! + 1 => index!
    }
    found! -> if {
        value -> slice(UIntSize(0), lastSeparator!) => directory
        directory -> return
    }
    "."
}



spanText source: file.SourceText, span: project.TextSpan -> Text {
    source -> slice(span.start, span.length)
}

joinedPath base: Text, child: Text, style: path.Style -> Result<path.Path, Text> {
    path.fromText(base, style) -> join(child)
}

normalizePath value: move path.Path -> Result<path.Path, Text> {
    value -> normalizeConfined
}

manifestOwnedPath option: Text, style: path.Style -> Result<path.Path, Text> uses File => option -> manifestEntry.resolve("sollang.project", style)

normalizedManifestOwnedPath option: Text, style: path.Style -> Result<path.Path, Text> uses File => option -> manifestOwnedPath(style)

sameSpanText source: file.SourceText, left: project.TextSpan, right: project.TextSpan -> Bool {
    left.length == right.length => same!
    UIntSize(0) => index!
    same! and index! < left.length -> while {
        (source -> byte(left.start + index!)) != (source -> byte(right.start + index!))
            -> if {
                false => same!
            }
        index! + 1 => index!
    }
    same!
}

emptyInput status: Int, diagnostic: Text -> ProjectInput {
    ProjectInput {
        status: status
        diagnostic: diagnostic
        source: ""
        sourceDirectory: ""
        projectDirectory: ""
        productName: ""
        multiProduct: false
        dependencyCount: 0
    } => result
    result
}

public struct PathGraphResult {
    public status: Int
    public manifestStatus: Int
    public parserDiagnostic: manifestDiagnostics.ManifestDiagnostic
    public validationKind: Int
    public validationProductIndex: Int
    public validationDependencyIndex: Int
    public diagnostic: Text
    public normalizationError: Text
    public nativeFailure: DependencyPathFailure
}

# Dependency keys have already passed the char-based BMP identifier contract.
dependencyOrder source: file.SourceText, dependencies: [project.Dependency; ~] -> [Int; ~] {
    [Int; ~] => order!
    0 => index!
    index! < (dependencies -> len) -> while {
        order! -> push(index!)
        index! + 1 => index!
    }
    1 => sortIndex!
    sortIndex! < (order! -> len) -> while {
        order![sortIndex!] => selected
        source -> spanText(dependencies[selected].name) => selectedName
        sortIndex! => position!
        true => shifting!
        shifting! and position! > 0 -> while {
            source -> spanText(dependencies[order![position! - 1]].name) => previousName
            (selectedName -> text.compareOrdinal(previousName)) >= 0
                -> if {
                    false => shifting!
                } else {
                    order![position! - 1] => order![position!]
                    position! - 1 => position!
                }
        }
        selected => order![position!]
        sortIndex! + 1 => sortIndex!
    }
    order!
}

cycleDiagnostic current: Int, parents: [Int; ~], names: [path.Path; ~], storage: mut Arena -> Text {
    [Int; ~] => chain!
    current => cursor!
    cursor! >= 0 -> while {
        chain! -> push(cursor!)
        parents[cursor!] => cursor!
    }
    [UInt8; ~] => bytes!
    "project dependency cycle: " => prefix
    prefix -> appendSourceBytes(0, prefix -> len, bytes!)
    (chain! -> len) - 1 => chainIndex!
    chainIndex! >= 0 -> while {
        chainIndex! < (chain! -> len) - 1 -> if {
            " -> " => separator
            separator -> appendSourceBytes(0, separator -> len, bytes!)
        }
        names[chain![chainIndex!]] -> pathText => name
        name -> appendSourceBytes(0, name -> len, bytes!)
        chainIndex! - 1 => chainIndex!
    }
    bytes! -> file.borrowBytes => source
    source -> slice(0, source -> len) -> materialize(storage)
}

# Appends every transitive path-dependency source closure once.
# Status: 0 valid, 20 non-path dependency, 21 invalid dependency manifest,
# 22 dependency does not expose its same-named product,
# 24 dependency cycle, 25 dependency/project name mismatch,
# 26 dependency version requirement mismatch, 27 canonical-path query,
# 28 dependency manifest open, 29 dependency manifest syntax.
public resolvePathGraph option: Text, sources: mut [path.Path; ~], packageManifests: mut [path.Path; ~], packageNames: mut [path.Path; ~], packageVersions: mut [path.Path; ~], style: path.Style, diagnosticStorage: mut Arena -> PathGraphResult uses File {
    [path.Path; ~] => members
    [Int; ~] => order
    option -> resolvePathGraphCore(members, order, sources, packageManifests, packageNames, packageVersions, true, style, diagnosticStorage)
}

public resolveWorkspacePathGraph option: Text, members: ref [path.Path; ~], order: [Int; ~], sources: mut [path.Path; ~], packageManifests: mut [path.Path; ~], packageNames: mut [path.Path; ~], packageVersions: mut [path.Path; ~], style: path.Style, diagnosticStorage: mut Arena -> PathGraphResult uses File {
    option -> resolvePathGraphCore(members, order, sources, packageManifests, packageNames, packageVersions, true, style, diagnosticStorage)
}

public resolveWorkspaceGraph option: Text, members: ref [path.Path; ~], order: [Int; ~], packageManifests: mut [path.Path; ~], packageNames: mut [path.Path; ~], packageVersions: mut [path.Path; ~], style: path.Style, diagnosticStorage: mut Arena -> PathGraphResult uses File {
    [path.Path; ~] => sources!
    option -> resolvePathGraphCore(members, order, sources!, packageManifests, packageNames, packageVersions, false, style, diagnosticStorage)
}

resolvePathGraphCore option: Text, workspaceMembers: ref [path.Path; ~], workspaceOrder: [Int; ~], sources: mut [path.Path; ~], packageManifests: mut [path.Path; ~], packageNames: mut [path.Path; ~], packageVersions: mut [path.Path; ~], collectSources: Bool, style: path.Style, diagnosticStorage: mut Arena -> PathGraphResult uses File {
    [path.Path; ~] => manifests!
    0 => status!
    option -> normalizedManifestOwnedPath(style) -> when {
        Ok(normalized) {
            normalized -> pathText => normalizedText
            manifests! -> push(normalizedText -> path.fromText(style))
            unitValue()
        }
        Err(_) {
            27 => status!
            manifests! -> push("" -> path.fromText(style))
            unitValue()
        }
    }
    [path.Path; ~] => canonicalManifests!
    manifests![0] -> pathText => firstManifest
    canonicalManifests! -> push(firstManifest -> path.fromText(style))
    [path.Path; ~] => actualNames!
    actualNames! -> push("" -> path.fromText(style))
    [Bool; ~] => visited!
    visited! -> push(false)
    [Int; ~] => queuedSourceKinds!
    queuedSourceKinds! -> push(1)
    [Int; ~] => pending!
    [Int; ~] => parents!
    parents! -> push(-1)
    [path.Path; ~] => expectedNames!
    expectedNames! -> push("" -> path.fromText(style))
    [path.Path; ~] => requirements!
    requirements! -> push("" -> path.fromText(style))
    (workspaceOrder -> len) - 1 => rootCursor!
    rootCursor! >= 0 -> while {
        workspaceMembers[workspaceOrder[rootCursor!]] -> pathText => memberManifest
        not (memberManifest -> pathIdentity.equalsOrdinalIgnoreCase(firstManifest))
            -> if {
                manifests! -> len => rootEntry
                manifests! -> push(memberManifest -> path.fromText(style))
                canonicalManifests! -> push(memberManifest -> path.fromText(style))
                actualNames! -> push("" -> path.fromText(style))
                visited! -> push(false)
                queuedSourceKinds! -> push(1)
                parents! -> push(-1)
                expectedNames! -> push("" -> path.fromText(style))
                requirements! -> push("" -> path.fromText(style))
                pending! -> push(rootEntry)
            }
        rootCursor! - 1 => rootCursor!
    }
    pending! -> push(0)
    0 => processed!
    status! == 0 and (pending! -> len) > 0
        -> while {
            pending! -> take((pending! -> len) - 1) => nextEntry
            nextEntry => processed!
            queuedSourceKinds![processed!] != 1 -> if { 20 => status! }
            status! == 0 -> if {
                manifests![processed!] -> pathText => queuedManifestText
                queuedManifestText -> path.fromText(style) => manifestPath
                manifestPath -> pathText => manifestText
                false => skipCurrent!
                parents![processed!] < 0 and processed! > 0 -> if {
                    0 => completedIndex!
                    not skipCurrent! and completedIndex! < (canonicalManifests! -> len)
                        -> while {
                            visited![completedIndex!] and (canonicalManifests![completedIndex!] -> pathText -> pathIdentity.equalsOrdinalIgnoreCase(manifestText))
                                -> if { true => skipCurrent! }
                            completedIndex! + 1 => completedIndex!
                        }
                }
                manifestText -> directoryOf => manifestDirectoryText
                manifestDirectoryText -> path.fromText(style) => manifestDirectory
                status! == 0 and not skipCurrent! -> if {
                    manifestText -> file.openRead -> when {
                        Ok(_) {}
                        Err(_) { 28 => status! }
                    }
                    status! == 0 -> if {
                        manifestText -> file.mapText => source
                        source -> len => sourceLength
                        source -> slice(UIntSize(0), sourceLength) => sourceView
                        sourceView -> project.parse => parsed
                        [path.Path; ~] => validatedRoots!
                        [DependencySource; ~] => validatedDependencySources!
                        parsed.status != 0 -> if {
                            sourceView -> manifestDiagnostics.format(manifestText, parsed.diagnostic, diagnosticStorage) => message
                            PathGraphResult { status: 29, manifestStatus: parsed.status, parserDiagnostic: parsed.diagnostic, validationKind: 0, validationProductIndex: -1, validationDependencyIndex: -1, diagnostic: message, nativeFailure: DependencyPathFailure.None, normalizationError: "" } -> return
                        }
                        status! == 0 -> if {
                            source -> validateParsedManifest(parsed, manifestDirectoryText, style) => validation!
                            validation!.kind != 0 -> if {
                                source -> formatManifestValidation(parsed, validation!, manifestText, diagnosticStorage) => message
                                validation!.kind == 128 -> if {
                                    PathGraphResult { status: 29, manifestStatus: 0, parserDiagnostic: manifestDiagnostics.none(), validationKind: validation!.kind, validationProductIndex: validation!.productIndex, validationDependencyIndex: validation!.dependencyIndex, diagnostic: message, nativeFailure: validation!.nativeFailure, normalizationError: message } -> return
                                }
                                PathGraphResult { status: 29, manifestStatus: 0, parserDiagnostic: manifestDiagnostics.none(), validationKind: validation!.kind, validationProductIndex: validation!.productIndex, validationDependencyIndex: validation!.dependencyIndex, diagnostic: message, nativeFailure: validation!.nativeFailure, normalizationError: "" } -> return
                            } else {
                                # Preserve product insertion order and each validated lexical path.
                                (validation!.roots -> len) > 0 -> while {
                                    validation!.roots -> take(0) => root
                                    validatedRoots! -> push(root)
                                }
                                (validation!.dependencySources -> len) > 0 -> while {
                                    validation!.dependencySources -> take(0) => dependencySource
                                    validatedDependencySources! -> push(dependencySource)
                                }
                            }
                        }

                        parents![processed!] >= 0 and (workspaceMembers -> len) > 0
                            -> if {
                                false => memberAllowed!
                                0 => memberIndex!
                                not memberAllowed! and memberIndex! < (workspaceMembers -> len)
                                    -> while {
                                        workspaceMembers[memberIndex!] -> pathText -> pathIdentity.equalsOrdinalIgnoreCase(manifestText)
                                            -> if { true => memberAllowed! }
                                        memberIndex! + 1 => memberIndex!
                                    }
                                not memberAllowed! -> if {
                                    actualNames![parents![processed!]] -> pathText => parentName
                                    source -> spanText(parsed.name) => memberName
                                    "workspace package '$parentName' depends on '$memberName' at '$manifestText', but that project is not a workspace member" -> materialize(diagnosticStorage) => message
                                    PathGraphResult { status: 30, manifestStatus: 0, parserDiagnostic: manifestDiagnostics.none(), validationKind: 0, validationProductIndex: -1, validationDependencyIndex: -1, diagnostic: message, nativeFailure: DependencyPathFailure.None, normalizationError: "" } -> return
                                }
                            }
                        status! == 0 and parents![processed!] >= 0 -> if {
                            source -> spanText(parsed.name) => manifestName
                            not (expectedNames![processed!] -> equalsText(manifestName))
                                -> if {
                                    expectedNames![processed!] -> pathText => dependencyName
                                    "dependency '$dependencyName' resolves to project '$manifestName' in '$manifestText'" -> materialize(diagnosticStorage) => message
                                    PathGraphResult { status: 25, manifestStatus: 0, parserDiagnostic: manifestDiagnostics.none(), validationKind: 0, validationProductIndex: -1, validationDependencyIndex: -1, diagnostic: message, nativeFailure: DependencyPathFailure.None, normalizationError: "" } -> return
                                }
                            status! == 0 -> if {
                                requirements![processed!] -> pathText => requirementText
                                source -> spanText(parsed.version) => manifestVersion
                                requirementText -> versions.accepts(manifestVersion) => accepted
                                accepted.status != 0 or not accepted.accepted
                                    -> if {
                                        expectedNames![processed!] -> pathText => dependencyName
                                        requirementText -> versions.trimRequirement => declaredRequirement
                                        "dependency '$dependencyName' requires version '$declaredRequirement', but project '$manifestName' declares '$manifestVersion'" -> materialize(diagnosticStorage) => message
                                        PathGraphResult { status: 26, manifestStatus: 0, parserDiagnostic: manifestDiagnostics.none(), validationKind: 0, validationProductIndex: -1, validationDependencyIndex: -1, diagnostic: message, nativeFailure: DependencyPathFailure.None, normalizationError: "" } -> return
                                    }
                            }
                        }

                        -1 => productIndex!
                        status! == 0 and processed! > 0 -> if {
                            0 => candidateIndex!
                            candidateIndex! < (parsed.products -> len) -> while {
                                source -> sameSpanText(parsed.products[candidateIndex!].name, parsed.name)
                                    -> if { candidateIndex! => productIndex! }
                                candidateIndex! + 1 => candidateIndex!
                            }
                            productIndex! < 0 -> if {
                                parents![processed!] >= 0 -> if { 22 => status! } else {
                                    0 => productIndex!
                                    1 => fallbackIndex!
                                    fallbackIndex! < (parsed.products -> len) -> while {
                                        source -> spanText(parsed.products[fallbackIndex!].name) => candidateName
                                        source -> spanText(parsed.products[productIndex!].name) => selectedName
                                        (candidateName -> text.compareOrdinal(selectedName)) < 0
                                            -> if { fallbackIndex! => productIndex! }
                                        fallbackIndex! + 1 => fallbackIndex!
                                    }
                                }
                            }
                        }
                        status! == 0 -> if {
                            source -> spanText(parsed.name) => actualName
                            actualName -> path.fromText(style) => actualNames![processed!]
                            parents![processed!] => ancestor!
                            ancestor! >= 0 -> while {
                                canonicalManifests![ancestor!] -> pathText -> pathIdentity.equalsOrdinalIgnoreCase(manifestText)
                                    -> if {
                                        processed! -> cycleDiagnostic(parents!, actualNames!, diagnosticStorage) => message
                                        PathGraphResult { status: 24, manifestStatus: 0, parserDiagnostic: manifestDiagnostics.none(), validationKind: 0, validationProductIndex: -1, validationDependencyIndex: -1, diagnostic: message, nativeFailure: DependencyPathFailure.None, normalizationError: "" } -> return
                                    }
                                parents![ancestor!] => ancestor!
                            }
                            0 => seenIndex!
                            not skipCurrent! and seenIndex! < (canonicalManifests! -> len)
                                -> while {
                                    visited![seenIndex!] and (canonicalManifests![seenIndex!] -> pathText -> pathIdentity.equalsOrdinalIgnoreCase(manifestText))
                                        -> if { true => skipCurrent! }
                                    seenIndex! + 1 => seenIndex!
                                }
                            true => visited![processed!]
                        }

                        status! == 0 and not skipCurrent! -> if {
                            packageManifests -> push(manifestText -> path.fromText(style))
                            source -> spanText(parsed.name) => packageName
                            packageNames -> push(packageName -> path.fromText(style))
                            source -> spanText(parsed.version) => packageVersion
                            packageVersions -> push(packageVersion -> path.fromText(style))
                        }

                        collectSources and status! == 0 and not skipCurrent! and processed! > 0
                            -> if {
                                productIndex! >= 0 -> if {
                                    validatedRoots! -> take(productIndex!) => rootPath
                                    rootPath -> pathText => rootText
                                    rootText -> directoryOf => sourceDirectoryText
                                    sourceDirectoryText -> path.fromText(style) => sourceDirectory
                                    sourceDirectory -> sourceRoot.discoverDirect => discovered
                                    0 => discoveredIndex!
                                    discoveredIndex! < (discovered -> len) -> while {
                                        discovered[discoveredIndex!] -> pathText => discoveredText
                                        sources -> push(discoveredText -> path.fromText(style))
                                        discoveredIndex! + 1 => discoveredIndex!
                                    }
                                }
                            }

                        source -> dependencyOrder(parsed.dependencies) => order
                        (order -> len) - 1 => dependencyCursor!
                        status! == 0 and not skipCurrent! and dependencyCursor! >= 0
                            -> while {
                                order[dependencyCursor!] => dependencyIndex
                                validatedDependencySources![dependencyIndex].kind != 1
                                    -> if {
                                        manifests! -> len => entryIndex
                                        pending! -> push(entryIndex)
                                        validatedDependencySources![dependencyIndex].normalized -> file.borrowBytes => normalizedSource
                                        normalizedSource -> slice(0, normalizedSource -> len) => sourceText
                                        manifests! -> push(sourceText -> path.fromText(style))
                                        canonicalManifests! -> push(sourceText -> path.fromText(style))
                                        actualNames! -> push("" -> path.fromText(style))
                                        visited! -> push(false)
                                        queuedSourceKinds! -> push(validatedDependencySources![dependencyIndex].kind)
                                        parents! -> push(processed!)
                                        source -> spanText(parsed.dependencies[dependencyIndex].name) => dependencyName
                                        expectedNames! -> push(dependencyName -> path.fromText(style))
                                        parsed.dependencies[dependencyIndex].version.length > 0
                                            -> if {
                                                source -> spanText(parsed.dependencies[dependencyIndex].version)
                                            } else { "*" } => dependencyRequirement
                                        requirements! -> push(dependencyRequirement -> path.fromText(style))
                                    } else {
                                        validatedDependencySources![dependencyIndex].normalized -> file.borrowBytes => normalizedSource
                                        normalizedSource -> slice(0, normalizedSource -> len) => dependencyDirectory
                                        dependencyDirectory -> manifestOwnedPath(style) -> when {
                                            Ok(dependencyManifest) {
                                                Result<path.Path, Text>.Ok(dependencyManifest) -> when {
                                                    Ok(normalized) {
                                                        normalized -> pathText => dependencyManifestText
                                                        manifests! -> len => entryIndex
                                                        pending! -> push(entryIndex)
                                                        manifests! -> push(dependencyManifestText -> path.fromText(style))
                                                        canonicalManifests! -> push(dependencyManifestText -> path.fromText(style))
                                                        actualNames! -> push("" -> path.fromText(style))
                                                        visited! -> push(false)
                                                        queuedSourceKinds! -> push(1)
                                                        parents! -> push(processed!)
                                                        source -> spanText(parsed.dependencies[dependencyIndex].name) => dependencyName
                                                        expectedNames! -> push(dependencyName -> path.fromText(style))
                                                        parsed.dependencies[dependencyIndex].version.length > 0
                                                            -> if {
                                                                source -> spanText(parsed.dependencies[dependencyIndex].version)
                                                            } else {
                                                                "*"
                                                            } => dependencyRequirement
                                                        requirements! -> push(dependencyRequirement -> path.fromText(style))
                                                        unitValue()
                                                    }
                                                    Err(_) {
                                                        27 => status!
                                                        unitValue()
                                                    }
                                                }
                                            }
                                            Err(_) {
                                                27 => status!
                                                unitValue()
                                            }
                                        }
                                    }
                                dependencyCursor! - 1 => dependencyCursor!
                            }
                    }
                }

            }
        }
    PathGraphResult { status: status!, manifestStatus: 0, parserDiagnostic: manifestDiagnostics.none(), validationKind: 0, validationProductIndex: -1, validationDependencyIndex: -1, diagnostic: "", nativeFailure: DependencyPathFailure.None, normalizationError: "" }
}

public appendDependencySources option: Text, sources: mut [path.Path; ~], style: path.Style, diagnosticStorage: mut Arena -> PathGraphResult uses File {
    [path.Path; ~] => packageManifests!
    [path.Path; ~] => packageNames!
    [path.Path; ~] => packageVersions!
    option -> resolvePathGraph(sources, packageManifests!, packageNames!, packageVersions!, style, diagnosticStorage)
}

appendSourceBytes value: Text, start: UIntSize, length: UIntSize, output: mut [UInt8; ~] -> Unit {
    start => index!
    start + length => end
    index! < end -> while {
        output -> push(value -> byte(index!))
        index! + 1 => index!
    }
}

pathSeparator value: UInt8, windows: Bool -> Bool => value == '/' or windows and value == '\\'

public enum DependencyPathFailure {
    None
    BaseRequired
    Base(pathComponents.Error)
    Input(pathComponents.Error)
    OwnedUtf8
    FileUriEncoding(percent.Error)
    UriNormalization(uri.Error)
}

# GetFullPath-style absolute composition is distinct from project-root confinement.
fullDependencyPath value: Text, directory: Text, style: path.Style -> Result<path.Path, DependencyPathFailure> {
    style -> when { Windows => true Posix => false } => windows
    [UInt8; ~] => combined!
    value -> len => length
    directory -> len => directoryLength
    false => composed!
    windows and length >= 2 -> if {
        (value -> byte(1)) == ':' -> if {
            length >= 3 and pathSeparator(value -> byte(2), true)
                -> if {
                    value -> appendSourceBytes(0, length, combined!)
                } else {
                    directoryLength >= 2 and (directory -> byte(1)) == ':'
                        -> if {
                            value -> slice(0, 2) => drive
                            directory -> slice(0, 2) => baseDrive
                            drive -> text.equalsAsciiIgnoreCase(baseDrive)
                                -> if {
                                    directory -> appendSourceBytes(0, directoryLength, combined!)
                                    directoryLength > 0 and not pathSeparator(directory -> byte(directoryLength - 1), true)
                                        -> if { combined! -> push('\\') }
                                } else {
                                    value -> appendSourceBytes(0, 2, combined!)
                                    combined! -> push('\\')
                                }
                        } else {
                            value -> appendSourceBytes(0, 2, combined!)
                            combined! -> push('\\')
                        }
                    value -> appendSourceBytes(2, length - 2, combined!)
                }
            true => composed!
        }
    }
    not composed! and length > 0 -> if {
        pathSeparator(value -> byte(0), windows) -> if {
            windows and not (length >= 2 and pathSeparator(value -> byte(1), true))
                -> if {
                    directoryLength >= 2 and (directory -> byte(1)) == ':'
                        -> if {
                            directory -> appendSourceBytes(0, 2, combined!)
                        } else {
                            directory -> pathComponents.components(style, pathComponents.Limits { maxInputBytes: Int(directoryLength), maxComponents: Int(directoryLength) + 1, maxComponentBytes: Int(directoryLength) }) -> when {
                                Ok(parts) {
                                    parts => iterator!
                                    iterator! -> next -> when {
                                        Ok(first) {
                                            first -> when {
                                                Some(component) { directory -> appendSourceBytes(component.offset, component.length, combined!) }
                                                None { Result<path.Path, DependencyPathFailure>.Err(DependencyPathFailure.BaseRequired) -> return }
                                            }
                                        }
                                        Err(error) { Result<path.Path, DependencyPathFailure>.Err(DependencyPathFailure.Base(error)) -> return }
                                    }
                                }
                                Err(error) { Result<path.Path, DependencyPathFailure>.Err(DependencyPathFailure.Base(error)) -> return }
                            }
                        }
                }
            value -> appendSourceBytes(0, length, combined!)
            true => composed!
        }
    }
    not composed! -> if {
        directory -> appendSourceBytes(0, directoryLength, combined!)
        length > 0 and directoryLength > 0 and not pathSeparator(directory -> byte(directoryLength - 1), windows)
            -> if {
                windows -> if { combined! -> push('\\') } else { combined! -> push('/') }
            }
        value -> appendSourceBytes(0, length, combined!)
    }
    combined! -> file.borrowBytes => source
    source -> slice(0, source -> len) => combinedText
    combinedText -> len => inputLength
    combinedText -> pathComponents.components(style, pathComponents.Limits { maxInputBytes: Int(inputLength), maxComponents: Int(inputLength) + 1, maxComponentBytes: Int(inputLength) }) -> when {
        Err(error) { Result<path.Path, DependencyPathFailure>.Err(DependencyPathFailure.Input(error)) -> return }
        Ok(parts) {
            parts => iterator!
            [UInt8; ~] => bytes!
            [Int; ~] => componentStarts!
            false => done!
            not done! -> while {
                iterator! -> next -> when {
                    Err(error) { Result<path.Path, DependencyPathFailure>.Err(DependencyPathFailure.Input(error)) -> return }
                    Ok(next) {
                        next -> when {
                            None { true => done! }
                            Some(component) {
                                component.kind -> when {
                                    CurrentDirectory { }
                                    ParentDirectory {
                                        (componentStarts! -> len) > 0 -> if {
                                            componentStarts! -> take((componentStarts! -> len) - 1) => truncate
                                            (bytes! -> len) > truncate -> while { bytes! -> take((bytes! -> len) - 1) => removed }
                                        }
                                    }
                                    Normal {
                                        bytes! -> len => beforeSeparator
                                        beforeSeparator > 0 and not pathSeparator(bytes![beforeSeparator - 1], windows)
                                            -> if {
                                                windows -> if { bytes! -> push('\\') } else { bytes! -> push('/') }
                                            }
                                        componentStarts! -> push(beforeSeparator)
                                        combinedText -> appendSourceBytes(component.offset, component.length, bytes!)
                                    }
                                    else {
                                        component.offset => index!
                                        component.offset + component.length => end
                                        index! < end -> while {
                                            combinedText -> byte(index!) => current
                                            windows and pathSeparator(current, true) -> if { bytes! -> push('\\') } else { bytes! -> push(current) }
                                            index! + 1 => index!
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            inputLength > 0 and pathSeparator(combinedText -> byte(inputLength - 1), windows) and (bytes! -> len) > 0
                -> if {
                    not pathSeparator(bytes![(bytes! -> len) - 1], windows)
                        -> if {
                            windows -> if { bytes! -> push('\\') } else { bytes! -> push('/') }
                        }
                }
            path.fromBytes(bytes!, style) -> when {
                Ok(ownedPath) { Result<path.Path, DependencyPathFailure>.Ok(ownedPath) -> return }
                Err(_) { Result<path.Path, DependencyPathFailure>.Err(DependencyPathFailure.OwnedUtf8) -> return }
            }
        }
    }
}

struct DependencySourceValidation {
    kind: Int
    sourceKind: Int
    normalized: [UInt8; ~]
    nativeFailure: DependencyPathFailure
}

sourceFailure kind: Int, sourceKind: Int, failure: DependencyPathFailure -> DependencySourceValidation {
    DependencySourceValidation { kind: kind, sourceKind: sourceKind, normalized: [UInt8; ~], nativeFailure: failure }
}

# Registry local locations become file URIs; git local locations remain paths.
localDependencySource value: Text, directory: Text, style: path.Style, registry: Bool, sourceKind: Int -> DependencySourceValidation {
    value -> fullDependencyPath(directory, style) -> when {
        Err(error) { sourceFailure(128, sourceKind, error) -> return }
        Ok(local) {
            local -> pathText => localText
            [UInt8; ~] => normalized!
            not registry -> if {
                localText -> appendSourceBytes(0, localText -> len, normalized!)
                DependencySourceValidation { kind: 0, sourceKind: sourceKind, normalized: normalized!, nativeFailure: DependencyPathFailure.None } -> return
            }
            [UInt8; ~] => pathBytes!
            UIntSize(0) => index!
            index! < (localText -> len) -> while {
                localText -> byte(index!) => byte
                byte == '\\' -> if { pathBytes! -> push('/') } else { pathBytes! -> push(byte) }
                index! + 1 => index!
            }
            percent.path() -> encode(pathBytes!, (pathBytes! -> len) * 3) -> when {
                Err(error) { sourceFailure(128, 3, DependencyPathFailure.FileUriEncoding(error)) -> return }
                Ok(encoded) {
                    "file://" -> appendSourceBytes(0, 7, normalized!)
                    (encoded -> len) > 0 and encoded[0] != '/' -> if { normalized! -> push('/') }
                    0 => encodedIndex!
                    encodedIndex! < (encoded -> len) -> while {
                        normalized! -> push(encoded[encodedIndex!])
                        encodedIndex! + 1 => encodedIndex!
                    }
                }
            }
            (normalized! -> len) > 0 and normalized![(normalized! -> len) - 1] == '/'
                -> while {
                    normalized! -> take((normalized! -> len) - 1) => removed
                }
            DependencySourceValidation { kind: 0, sourceKind: 3, normalized: normalized!, nativeFailure: DependencyPathFailure.None } -> return
        }
    }
}

# URI admission is separate from parsing failure: C# explicitly selects local paths.
validateUriDependencySource value: Text, directory: Text, style: path.Style, registry: Bool -> DependencySourceValidation {
    registry -> if { 3 } else { 2 } => sourceKind
    value -> blankValue -> if {
        registry -> if { 141 } else { 137 } => kind
        sourceFailure(kind, sourceKind, DependencyPathFailure.None) -> return
    }
    value -> uri.parse(Int(value -> len)) -> when {
        Err(_) { value -> localDependencySource(directory, style, registry, sourceKind) -> return }
        Ok(reference) {
            reference.scheme.present -> unless { value -> localDependencySource(directory, style, registry, sourceKind) -> return }
            # A single-letter prefix is a Windows drive path to System.Uri.
            reference.scheme.length == 1 -> if { value -> localDependencySource(directory, style, registry, sourceKind) -> return }
            value -> slice(reference.scheme.start, reference.scheme.length) => scheme
            scheme -> text.equalsAsciiIgnoreCase("https") => https
            scheme -> text.equalsAsciiIgnoreCase("http") => http
            scheme -> text.equalsAsciiIgnoreCase("ssh") => ssh
            scheme -> text.equalsAsciiIgnoreCase("file") => fileScheme
            reference.authority -> when {
                Absent => false
                Present(authority) {
                    authority.host -> when {
                        Registered(host) => host.length > 0
                        else => true
                    }
                }
            } => hasAbsoluteHost
            # System.Uri requires a host for http(s); RFC 3986 permits empty names.
            (http or https) and not hasAbsoluteHost -> if { value -> localDependencySource(directory, style, registry, sourceKind) -> return }
            registry -> if { https or fileScheme } else { https or ssh or fileScheme }
                -> unless {
                    registry -> if { 142 } else { 138 } => kind
                    sourceFailure(kind, sourceKind, DependencyPathFailure.None) -> return
                }
            reference.authority -> when { Absent => false Present(authority) => authority.userInfo.length > 0 } => credentials
            credentials or registry and (reference.query.present or reference.fragment.present)
                -> if {
                    registry -> if { 143 } else { 139 } => kind
                    sourceFailure(kind, sourceKind, DependencyPathFailure.None) -> return
                }
            # .NET AbsoluteUri preserves escape-letter case in the observed path.
            uri.NormalizationPolicy { lowercaseScheme: true, lowercaseRegisteredName: true, decodeUnreserved: true, uppercasePercentHex: false, removeDotSegments: true } => policy
            reference -> normalizeBytes(policy, Int(value -> len) * 3 + 16) -> when {
                Err(error) { sourceFailure(128, sourceKind, DependencyPathFailure.UriNormalization(error)) -> return }
                Ok(normalized) {
                    normalized => bytes!
                    registry -> if {
                        (bytes! -> len) > 0 and bytes![(bytes! -> len) - 1] == '/'
                            -> while { bytes! -> take((bytes! -> len) - 1) => removed }
                    }
                    DependencySourceValidation { kind: 0, sourceKind: sourceKind, normalized: bytes!, nativeFailure: DependencyPathFailure.None } -> return
                }
            }
        }
    }
}

validateDependencySource source: file.SourceText, dependency: ref project.Dependency, presence: Int, directory: Text, style: path.Style -> DependencySourceValidation {
    presence % 2 == 1 -> if {
        source -> spanText(dependency.path) => value
        value -> rootedRoot(style) -> if { sourceFailure(136, 1, DependencyPathFailure.None) -> return }
        value -> localDependencySource(directory, style, false, 1) -> return
    }
    presence / 2 % 2 == 1 -> if {
        source -> spanText(dependency.git) => value
        value -> validateUriDependencySource(directory, style, false) -> return
    }
    source -> spanText(dependency.registry) => value
    value -> validateUriDependencySource(directory, style, true)
}

validGitRevision value: Text -> Bool {
    value -> len => length
    length != 40 and length != 64 -> if { false -> return }
    UIntSize(0) => index!
    true => valid!
    valid! and index! < length -> while {
        value -> byte(index!) => byte
        not ((byte >= '0' and byte <= '9') or (byte >= 'a' and byte <= 'f') or (byte >= 'A' and byte <= 'F'))
            -> if { false => valid! }
        index! + 1 => index!
    }
    valid!
}

# Uses the existing Unicode whitespace classifier without normalizing the value.
blankValue value: Text -> Bool {
    syntax.RawStringLayout { raw: false, multiline: false, contentStart: 0, contentEnd: value -> len, indentationStart: 0, indentationLength: 0, issue: 0 } => layout
    UIntSize(0) => cursor!
    true => blank!
    blank! and cursor! < (value -> len) -> while {
        value -> syntax.rawStringLine(layout, cursor!) => line
        line.start != line.end -> if { false => blank! }
        line.next => cursor!
    }
    blank!
}

portableProjectName value: Text -> Bool {
    true => portable!
    UIntSize(0) => index!
    portable! and index! < (value -> len) -> while {
        value -> byte(index!) => current
        current < 32 or current == 60 or current == 62 or current == 58 or current == 34
            or current == 47 or current == 92 or current == 124 or current == 63 or current == 42
            -> if { false => portable! }
        index! + 1 => index!
    }
    portable!
}

importSafeEntryName value: Text -> Bool {
    value -> unicodeIdentifier.startWidth(0) => firstWidth
    firstWidth == 0 -> if { false -> return }
    firstWidth => index!
    true => valid!
    valid! and index! < (value -> len) -> while {
        value -> unicodeIdentifier.continueWidth(index!) => width
        width == 0 -> if { false => valid! } else { index! + width => index! }
    }
    valid!
}

rootedRoot value: Text, style: path.Style -> Bool {
    (value -> len) == 0 -> if { false -> return }
    value -> byte(UIntSize(0)) => first
    style -> when {
        Posix => first == 47
        Windows {
            first == 47 or first == 92 -> if { true -> return }
            ((value -> len) >= 2 and (value -> byte(UIntSize(1))) == 58
                and ((first >= 65 and first <= 90) or (first >= 97 and first <= 122)))
        }
    }
}

slgRootExtension value: Text -> Bool {
    value -> len => length
    length < 4 -> if { false -> return }
    ((value -> byte(length - 4)) == 46
        and ((value -> byte(length - 3)) == 115 or (value -> byte(length - 3)) == 83)
        and ((value -> byte(length - 2)) == 108 or (value -> byte(length - 2)) == 76)
        and ((value -> byte(length - 1)) == 103 or (value -> byte(length - 1)) == 71))
}

# Typed validation facts own paths, never diagnostic Text or caller storage.
struct RootValidation {
    kind: Int
    normalizationError: Text
    root: path.Path
}

struct DependencySource {
    kind: Int
    normalized: [UInt8; ~]
}

struct ManifestValidation {
    kind: Int
    nativeFailure: DependencyPathFailure
    normalizationError: Text
    productIndex: Int
    roots: [path.Path; ~]
    dependencyIndex: Int
    dependencySources: [DependencySource; ~]
    requirementSyntax: versions.RequirementSyntax
}

rootFailure kind: Int, style: path.Style -> RootValidation {
    RootValidation { kind: kind, normalizationError: "", root: path.fromText("", style) }
}

# Retains lexical paths; query metadata only decides whether a file exists.
validateRoot root: Text, directory: Text, style: path.Style -> RootValidation uses File {
    root -> rootedRoot(style) -> if { 120 -> rootFailure(style) -> return }
    root -> path.fromText(style) -> normalizeConfined -> when {
        Err(error) {
            error -> textEquals("path escapes root") -> if {
                121 -> rootFailure(style) -> return
            }
            RootValidation { kind: 128, normalizationError: error, root: path.fromText("", style) } -> return
        }
        Ok(relative) {
            relative -> pathText => relativeText
            directory -> joinedPath(relativeText, style) -> when {
                Err(error) { RootValidation { kind: 128, normalizationError: error, root: path.fromText("", style) } -> return }
                Ok(joined) {
                    joined -> normalizeConfined -> when {
                        Err(error) { RootValidation { kind: 128, normalizationError: error, root: path.fromText("", style) } -> return }
                        Ok(fullRoot) {
                            fullRoot -> pathText => fullRootText
                            not (fullRootText -> slgRootExtension) -> if {
                                RootValidation { kind: 122, normalizationError: "", root: fullRoot } -> return
                            }
                            fullRoot -> query -> when {
                                Err(_) { RootValidation { kind: 127, normalizationError: "", root: fullRoot } -> return }
                                Ok(info) {
                                    (info.kind -> kinds.code) != 0 -> if {
                                        RootValidation { kind: 127, normalizationError: "", root: fullRoot } -> return
                                    }
                                }
                            }
                            RootValidation { kind: 0, normalizationError: "", root: fullRoot } -> return
                        }
                    }
                }
            }
        }
    }
}

# Shared by load and graph: name, presence, every product root, primary version.
# Parsing and dependency source/requirement validation remain separate owners.
validateParsedManifest source: file.SourceText, parsed: ref project.ProjectManifest, directory: Text, style: path.Style -> ManifestValidation uses File {
    [path.Path; ~] => roots!
    source -> spanText(parsed.name) => projectName
    projectName -> blankValue -> if {
        ManifestValidation { kind: 113, nativeFailure: DependencyPathFailure.None, normalizationError: "", productIndex: -1, roots: roots!, dependencyIndex: -1, dependencySources: [DependencySource; ~], requirementSyntax: versions.RequirementSyntax { status: 0, invalidStart: 0, invalidLength: 0 } } -> return
    }
    not (projectName -> portableProjectName) -> if {
        ManifestValidation { kind: 114, nativeFailure: DependencyPathFailure.None, normalizationError: "", productIndex: -1, roots: roots!, dependencyIndex: -1, dependencySources: [DependencySource; ~], requirementSyntax: versions.RequirementSyntax { status: 0, invalidStart: 0, invalidLength: 0 } } -> return
    }
    parsed.rootDeclared and parsed.productsDeclared
        -> if {
            ManifestValidation { kind: 115, nativeFailure: DependencyPathFailure.None, normalizationError: "", productIndex: -1, roots: roots!, dependencyIndex: -1, dependencySources: [DependencySource; ~], requirementSyntax: versions.RequirementSyntax { status: 0, invalidStart: 0, invalidLength: 0 } } -> return
        }
    not parsed.rootDeclared and not parsed.productsDeclared
        -> if {
            ManifestValidation { kind: 116, nativeFailure: DependencyPathFailure.None, normalizationError: "", productIndex: -1, roots: roots!, dependencyIndex: -1, dependencySources: [DependencySource; ~], requirementSyntax: versions.RequirementSyntax { status: 0, invalidStart: 0, invalidLength: 0 } } -> return
        }
    parsed.productsDeclared and (parsed.products -> len) == 0
        -> if {
            ManifestValidation { kind: 117, nativeFailure: DependencyPathFailure.None, normalizationError: "", productIndex: -1, roots: roots!, dependencyIndex: -1, dependencySources: [DependencySource; ~], requirementSyntax: versions.RequirementSyntax { status: 0, invalidStart: 0, invalidLength: 0 } } -> return
        }
    0 => rootIndex!
    rootIndex! < (parsed.products -> len) -> while {
        parsed.productsDeclared -> if {
            source -> spanText(parsed.products[rootIndex!].name) => productName
            productName -> blankValue -> if {
                ManifestValidation { kind: 118, nativeFailure: DependencyPathFailure.None, normalizationError: "", productIndex: rootIndex!, roots: roots!, dependencyIndex: -1, dependencySources: [DependencySource; ~], requirementSyntax: versions.RequirementSyntax { status: 0, invalidStart: 0, invalidLength: 0 } } -> return
            }
            not (productName -> importSafeEntryName) -> if {
                ManifestValidation { kind: 119, nativeFailure: DependencyPathFailure.None, normalizationError: "", productIndex: rootIndex!, roots: roots!, dependencyIndex: -1, dependencySources: [DependencySource; ~], requirementSyntax: versions.RequirementSyntax { status: 0, invalidStart: 0, invalidLength: 0 } } -> return
            }
        }
        source -> spanText(parsed.products[rootIndex!].root) => relativeRoot
        relativeRoot -> validateRoot(directory, style) => checkedRoot
        checkedRoot.kind => rootKind
        roots! -> push(checkedRoot.root)
        rootKind != 0 -> if {
            ManifestValidation { kind: rootKind, nativeFailure: DependencyPathFailure.None, normalizationError: checkedRoot.normalizationError, productIndex: rootIndex!, roots: roots!, dependencyIndex: -1, dependencySources: [DependencySource; ~], requirementSyntax: versions.RequirementSyntax { status: 0, invalidStart: 0, invalidLength: 0 } } -> return
        }
        rootIndex! + 1 => rootIndex!
    }
    source -> spanText(parsed.version) => versionText
    versionText -> versions.parse => version
    version.status != 0 -> if {
        ManifestValidation { kind: 123, nativeFailure: DependencyPathFailure.None, normalizationError: "", productIndex: -1, roots: roots!, dependencyIndex: -1, dependencySources: [DependencySource; ~], requirementSyntax: versions.RequirementSyntax { status: 0, invalidStart: 0, invalidLength: 0 } } -> return
    }
    [DependencySource; ~] => dependencySources!
    0 => dependencyIndex!
    dependencyIndex! < (parsed.dependencies -> len)
        -> while {
            parsed.dependencies[dependencyIndex!] => dependency
            parsed.dependencyFieldPresence[dependencyIndex!] => presence
            source -> spanText(dependency.name) => name
            name -> blankValue -> if {
                ManifestValidation { kind: 134, nativeFailure: DependencyPathFailure.None, normalizationError: "", productIndex: -1, roots: roots!, dependencyIndex: dependencyIndex!, dependencySources: dependencySources!, requirementSyntax: versions.RequirementSyntax { status: 0, invalidStart: 0, invalidLength: 0 } } -> return
            }
            not (name -> importSafeEntryName) -> if {
                ManifestValidation { kind: 135, nativeFailure: DependencyPathFailure.None, normalizationError: "", productIndex: -1, roots: roots!, dependencyIndex: dependencyIndex!, dependencySources: dependencySources!, requirementSyntax: versions.RequirementSyntax { status: 0, invalidStart: 0, invalidLength: 0 } } -> return
            }
            source -> validateDependencySource(dependency, presence, directory, style) => selected
            selected.kind != 0 -> if {
                ManifestValidation { kind: selected.kind, nativeFailure: selected.nativeFailure, normalizationError: "", productIndex: -1, roots: roots!, dependencyIndex: dependencyIndex!, dependencySources: dependencySources!, requirementSyntax: versions.RequirementSyntax { status: 0, invalidStart: 0, invalidLength: 0 } } -> return
            }
            presence / 2 % 2 == 1 -> if {
                source -> spanText(dependency.revision) => revision
                not (revision -> validGitRevision) -> if {
                    ManifestValidation { kind: 140, nativeFailure: DependencyPathFailure.None, normalizationError: "", productIndex: -1, roots: roots!, dependencyIndex: dependencyIndex!, dependencySources: dependencySources!, requirementSyntax: versions.RequirementSyntax { status: 0, invalidStart: 0, invalidLength: 0 } } -> return
                }
            }
            presence / 16 % 2 == 1 -> if {
                source -> spanText(dependency.version) => requirement
                requirement -> versions.validateRequirement => syntaxResult
                syntaxResult.status != 0 -> if {
                    syntaxResult.status == 1 -> if { 144 } else { 145 } => kind
                    ManifestValidation { kind: kind, nativeFailure: DependencyPathFailure.None, normalizationError: "", productIndex: -1, roots: roots!, dependencyIndex: dependencyIndex!, dependencySources: dependencySources!, requirementSyntax: syntaxResult } -> return
                }
            }
            dependencySources! -> push(DependencySource { kind: selected.sourceKind, normalized: selected.normalized })
            dependencyIndex! + 1 => dependencyIndex!
        }
    ManifestValidation { kind: 0, nativeFailure: DependencyPathFailure.None, normalizationError: "", productIndex: -1, roots: roots!, dependencyIndex: -1, dependencySources: dependencySources!, requirementSyntax: versions.RequirementSyntax { status: 0, invalidStart: 0, invalidLength: 0 } }
}

# Only validated BMP identifier names are compared; UTF-8 ordinal has the same order.
productNameBytes source: file.SourceText, products: [project.Product; ~] -> [UInt8; ~] {
    [Int; ~] => order!
    0 => productIndex!
    productIndex! < (products -> len) -> while {
        order! -> push(productIndex!)
        productIndex! + 1 => productIndex!
    }
    1 => sortIndex!
    sortIndex! < (order! -> len) -> while {
        order![sortIndex!] => selected
        source -> spanText(products[selected].name) => selectedName
        sortIndex! => position!
        true => shifting!
        shifting! and position! > 0 -> while {
            source -> spanText(products[order![position! - 1]].name) => previousName
            (selectedName -> text.compareOrdinal(previousName)) >= 0
                -> if {
                    false => shifting!
                } else {
                    order![position! - 1] => order![position!]
                    position! - 1 => position!
                }
        }
        selected => order![position!]
        sortIndex! + 1 => sortIndex!
    }
    [UInt8; ~] => bytes!
    0 => nameIndex!
    nameIndex! < (order! -> len) -> while {
        nameIndex! > 0 -> if { bytes! -> push(44)
            bytes! -> push(32) }
        source -> spanText(products[order![nameIndex!]].name) => name
        UIntSize(0) => byteIndex!
        byteIndex! < (name -> len) -> while {
            bytes! -> push(name -> byte(byteIndex!))
            byteIndex! + 1 => byteIndex!
        }
        nameIndex! + 1 => nameIndex!
    }
    bytes!
}

pathErrorName error: pathComponents.Error -> Text {
    error.kind -> when {
        InvalidLimits => "InvalidLimits"
        InputLimit => "InputLimit"
        InvalidNul => "InvalidNul"
        InvalidPrefix => "InvalidPrefix"
        UnsupportedNamespace => "UnsupportedNamespace"
        ComponentLimit => "ComponentLimit"
        ComponentSizeLimit => "ComponentSizeLimit"
    }
}

uriErrorName error: uri.Error -> Text {
    error.kind -> when {
        InvalidLimit => "InvalidLimit"
        InvalidCharacter => "InvalidCharacter"
        InvalidScheme => "InvalidScheme"
        InvalidPercentEncoding => "InvalidPercentEncoding"
        InvalidAuthority => "InvalidAuthority"
        InvalidHost => "InvalidHost"
        InvalidPort => "InvalidPort"
        RelativeFirstSegmentColon => "RelativeFirstSegmentColon"
    }
}

percentErrorName error: percent.Error -> Text {
    error.kind -> when {
        InvalidLimit => "InvalidLimit"
        InvalidEscape => "InvalidEscape"
        OutputLimitExceeded => "OutputLimitExceeded"
    }
}

# Native source failures retain their stage and typed error; C# parity is pending.
formatDependencyPathFailure failure: DependencyPathFailure, storage: mut Arena -> Text {
    failure -> when {
        None { "" -> materialize(storage) -> return }
        BaseRequired { "dependency base path requires an absolute root" -> materialize(storage) -> return }
        Base(error) {
            error -> pathErrorName => kind
            error.offset => offset
            "dependency base path error $kind at byte $offset" -> materialize(storage) -> return
        }
        Input(error) {
            error -> pathErrorName => kind
            error.offset => offset
            "dependency path error $kind at byte $offset" -> materialize(storage) -> return
        }
        OwnedUtf8 { "path is not valid UTF-8" -> materialize(storage) -> return }
        FileUriEncoding(error) {
            error -> percentErrorName => kind
            error.offset => offset
            "dependency file URI encoding error $kind at byte $offset" -> materialize(storage) -> return
        }
        UriNormalization(error) {
            error -> uriErrorName => kind
            error.offset => offset
            "dependency URI normalization error $kind at byte $offset" -> materialize(storage) -> return
        }
    }
}

# Formats supported loader decisions before mapped source and owned paths close.
# Noncanonical normalization failures stay in normalizationError, never fabricated.
formatManifestValidation source: file.SourceText, parsed: ref project.ProjectManifest, validation: ref ManifestValidation, manifest: Text, storage: mut Arena -> Text {
    source -> spanText(parsed.name) => projectName
    validation.kind == 113 -> if {
        "project name must not be empty in $manifest" -> materialize(storage) => message
        message -> return
    }
    validation.kind == 114 -> if {
        "project name is not a portable file name: $projectName" -> materialize(storage) => message
        message -> return
    }
    validation.kind == 115 -> if {
        "project manifest cannot declare both 'root' and 'products': $manifest" -> materialize(storage) => message
        message -> return
    }
    validation.kind == 116 -> if {
        "project manifest requires either 'root' or 'products': $manifest" -> materialize(storage) => message
        message -> return
    }
    validation.kind == 117 -> if {
        "project 'products' must not be empty: $manifest" -> materialize(storage) => message
        message -> return
    }
    validation.kind == 118 or validation.kind == 119
        -> if {
            source -> spanText(parsed.products[validation.productIndex].name) => productName
            validation.kind == 118 -> if {
                "product name must not be empty in $manifest" -> materialize(storage) => message
                message -> return
            }
            "product name must be an import-safe identifier in $manifest: $productName" -> materialize(storage) => message
            message -> return
        }
    validation.kind == 120 or validation.kind == 121 or validation.kind == 122
        -> if {
            source -> spanText(parsed.products[validation.productIndex].root) => root
            validation.kind == 120 -> if {
                "project root must be relative to the manifest: $root" -> materialize(storage) => message
                message -> return
            }
            validation.kind == 121 -> if {
                "project root escapes the manifest directory: $root" -> materialize(storage) => message
                message -> return
            }
            "project root must be an .slg source file: $root" -> materialize(storage) => message
            message -> return
        }
    validation.kind == 127 -> if {
        validation.roots[validation.productIndex] -> pathText => fullRoot
        "project root source not found: $fullRoot" -> materialize(storage) => message
        message -> return
    }
    validation.kind == 123 -> if {
        source -> spanText(parsed.version) => versionText
        "invalid semantic version '$versionText' in project manifest $manifest; expected SemVer 2.0.0 such as 1.2.3" -> materialize(storage) => message
        message -> return
    }
    validation.dependencyIndex >= 0 -> if {
        parsed.dependencies[validation.dependencyIndex] => dependency
        source -> spanText(dependency.name) => name
        validation.kind == 134 -> if { "dependency name must not be empty in $manifest" -> materialize(storage) -> return }
        validation.kind == 135 -> if { "dependency name must be an import-safe identifier in $manifest: $name" -> materialize(storage) -> return }
        validation.kind == 136 -> if {
            source -> spanText(dependency.path) => value
            "dependency path must be relative to the manifest in $manifest: $value" -> materialize(storage) -> return
        }
        validation.kind == 137 -> if { "dependency git location must not be empty in $manifest" -> materialize(storage) -> return }
        validation.kind == 138 -> if {
            source -> spanText(dependency.git) => value
            "dependency git URL must use https, ssh, or file in $manifest: $value" -> materialize(storage) -> return
        }
        validation.kind == 139 -> if { "dependency git URL must not contain credentials in $manifest" -> materialize(storage) -> return }
        validation.kind == 140 -> if {
            source -> spanText(dependency.revision) => value
            "dependency git revision must be a full 40- or 64-digit commit hash in $manifest: $value" -> materialize(storage) -> return
        }
        validation.kind == 141 -> if { "dependency registry location must not be empty in $manifest" -> materialize(storage) -> return }
        validation.kind == 142 -> if {
            source -> spanText(dependency.registry) => value
            "dependency registry URL must use https or file in $manifest: $value" -> materialize(storage) -> return
        }
        validation.kind == 143 -> if { "dependency registry URL must not contain credentials, a query, or a fragment in $manifest" -> materialize(storage) -> return }
        validation.kind == 144 -> if { "empty version requirement in dependency '$name' in $manifest" -> materialize(storage) -> return }
        validation.kind == 145 -> if {
            source -> spanText(dependency.version) -> versions.trimRequirement => requirement
            requirement -> slice(validation.requirementSyntax.invalidStart, validation.requirementSyntax.invalidLength) => value
            "invalid semantic version '$value' in dependency '$name' in $manifest; expected SemVer 2.0.0 such as 1.2.3" -> materialize(storage) -> return
        }
    }
    validation.kind == 128 -> if {
        validation.nativeFailure -> when {
            None { validation.normalizationError -> materialize(storage) -> return }
            else { validation.nativeFailure -> formatDependencyPathFailure(storage) -> return }
        }
    }
    ""
}

# Query follows links; canonical output is metadata only, never lexical identity.
public manifestFileExists manifest: ref path.Path -> Bool uses File => manifest -> manifestEntry.fileExists

# Workspace loading validates every manifest before selecting a member.
# The parser and ordered validator remain the same owners as primary loading.
public struct ParsedManifestInput {
    public status: Int
    public diagnostic: Text
    public name: project.TextSpan
}

public validateParsedInput source: file.SourceText, parsed: ref project.ProjectManifest, manifest: Text, storage: mut Arena -> ParsedManifestInput uses File {
    parsed.status != 0 -> if {
        source -> slice(0, source -> len) => sourceView
        sourceView -> manifestDiagnostics.format(manifest, parsed.diagnostic, storage) => message
        ParsedManifestInput { status: parsed.status + 100, diagnostic: message, name: project.TextSpan { start: 0, length: 0 } } -> return
    }
    manifest -> directoryOf => directory
    source -> validateParsedManifest(parsed, directory, path.nativeStyle()) => validation
    validation.kind != 0 -> if {
        source -> formatManifestValidation(parsed, validation, manifest, storage) => message
        ParsedManifestInput { status: validation.kind, diagnostic: message, name: project.TextSpan { start: 0, length: 0 } } -> return
    }
    ParsedManifestInput { status: 0, diagnostic: "", name: parsed.name }
}

# Nonzero load failures stop before product dispatch or graph preparation.
public load option: Text, requestedProduct: Text, manifestStorage: mut Arena, rootStorage: mut Arena, productNameStorage: mut Arena -> ProjectInput uses File {
    option -> manifestEntry.resolve("sollang.project", path.nativeStyle()) -> when {
        Err(error) {
            "project manifest path invalid: $error" -> materialize(rootStorage) => message
            129 -> emptyInput(message)
        }
        Ok(manifestFile) {
            manifestFile -> pathText -> materialize(manifestStorage) => manifest
            manifest -> directoryOf => directory
            manifestFile -> manifestFileExists -> unless {
                "project manifest not found: $manifest" -> materialize(rootStorage) => message
                129 -> emptyInput(message) -> return
            }
            manifestFile -> file.mapPath => source
            source -> len => sourceLength
            source -> slice(UIntSize(0), sourceLength) => sourceView
            sourceView -> project.parse => parsed
            parsed.status != 0 -> if {
                parsed.status + 100 => parseStatus
                sourceView -> manifestDiagnostics.format(manifest, parsed.diagnostic, rootStorage) => message
                parseStatus -> emptyInput(message) -> return
            }
            source -> validateParsedManifest(parsed, directory, path.nativeStyle()) => validation!
            source -> spanText(parsed.name) => projectName
            validation!.kind != 0 -> if {
                source -> formatManifestValidation(parsed, validation!, manifest, rootStorage) => message
                validation!.kind -> emptyInput(message) -> return
            }
            -1 => selectedIndex!
            (requestedProduct -> len) > 0 -> if {
                0 => index!
                index! < (parsed.products -> len) -> while {
                    source -> spanText(parsed.products[index!].name) => candidate
                    candidate -> textEquals(requestedProduct) -> if { index! => selectedIndex! }
                    index! + 1 => index!
                }
            } else {
                (parsed.products -> len) == 1 -> if { 0 => selectedIndex! }
            }
            selectedIndex! < 0 -> if {
                source -> productNameBytes(parsed.products) => names
                names -> file.borrowBytes => nameSource
                nameSource -> len => nameLength
                nameSource -> slice(UIntSize(0), nameLength) => availableNames
                (requestedProduct -> len) > 0 -> if {
                    "project '$projectName' has no product '$requestedProduct'; available products: $availableNames" -> materialize(rootStorage) => message
                    124 -> emptyInput(message) -> return
                }
                "project '$projectName' has multiple products; select one with --product: $availableNames" -> materialize(rootStorage) => message
                125 -> emptyInput(message) -> return
            }
            validation!.roots -> take(selectedIndex!) => selectedRoot
            selectedRoot -> pathText => selectedRootText
            selectedRootText -> materialize(rootStorage) => rootSource
            source -> spanText(parsed.products[selectedIndex!].name) => productNameView
            productNameView -> materialize(productNameStorage) => productName
            rootSource -> directoryOf => sourceDirectory
            ProjectInput {
                status: 0
                diagnostic: ""
                source: rootSource
                sourceDirectory: sourceDirectory
                projectDirectory: directory
                productName: productName
                multiProduct: (parsed.products -> len) > 1
                dependencyCount: parsed.dependencies -> len
            }
        }
    }
}
