makeValues: -> [Int; ~] => [2, 3, 5; ~]

combine values: [Int; ~], extra: Int -> Int => (values -> len) + extra

step value: Int -> async Int {
    yield
    value + 1
}

parent: -> async Int uses Console {
    "parent-started" -> println
    0 -> step => childTask
    combine(makeValues(), childTask -> await)
}

main {
    parent() => pending
    pending -> await => result
    "result=$result" -> println
}
