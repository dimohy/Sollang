namespace sollang.compiler.llvm.text

import sollang.compiler.llvm.target as llvmTarget

observe: -> Unit uses Console {
    [
    """
    answer: -> async Int { 42 }
    main {
        answer() -> await => result
        result -> println
    }
    """; ~] => sources
    llvmTarget.windowsX64() => target
    PrepareRequest { sources: sources, standardLibrarySourceStart: 0, standardLibrarySourceCount: 0, pointerBitWidth: target.pointerBitWidth, targetArchitecture: target.architecture, cpuDispatchPolicy: target.dispatchPolicy, requiredCpuFeatures: target.requiredFeatures, allowedCpuFeatures: target.allowedFeatures, forbiddenCpuFeatures: target.forbiddenFeatures, supportsComputePool: true, expectedPathStyle: 1 } => request
    request -> prepare => context
    (context.ir -> len) > 512 or (context.nodes -> len) > 512
        -> if {
            "observer-overflow" -> println
            return
        }
    0 => index!
    index! < (context.nodes -> len) -> while {
        context.nodes[index!] => node
        "AST $(index!) kind=$(node.kind) parent=$(node.parent) start=$(node.start) token=$(node.payloadToken)" -> println
        index! + 1 => index!
    }
    0 => ir!
    ir! < (context.ir -> len) -> while {
        context.ir[ir!] => node
        "IR $(ir!) kind=$(node.kind) parent=$(node.parent) ast=$(node.astNode) flags=$(node.flags) type=$(node.typeKind)/$(node.typeOrigin)/$(node.typeSymbol)/$(node.typeId) input=$(node.operand0) opcode=$(node.opcode)" -> println
        ir! + 1 => ir!
    }
    "observer-complete" -> println
}

main { observe() }
