            " " -> print
            entryPathIsReference! -> if { "%v$(entryExpressionIndex)_path_value" -> print } else {
                entryExpression.operand0 -> writeValue(functionIndex, context, state)
            }
            ", 0" -> println
            "  %v$(entryExpressionIndex)_path_data = extractvalue " -> print
            entryPathBytesType! -> writeSemanticTypeId(context, state)
            " %v$(entryExpressionIndex)_path_bytes, 0" -> println
            "  %v$(entryExpressionIndex)_path_length = extractvalue " -> print
