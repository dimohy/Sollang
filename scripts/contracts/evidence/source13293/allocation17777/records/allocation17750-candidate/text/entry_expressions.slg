    entryExpression.kind == 9 and entryExpression.opcode <= -252 and entryExpression.opcode >= -254 and entryExpression.operand0 >= 0
        -> if {
            entryExpressionIndex -> emitHeapIntrinsic(functionIndex, context, state)
