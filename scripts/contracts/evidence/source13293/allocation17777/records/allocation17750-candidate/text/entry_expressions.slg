                                        } else { entryExpression -> arrayElementSize(context, state) }) => emptyEntryFixedStorageBytes
                                        ArrayStorageIdentity { resultDomain: 0, resultIndex: entryExpressionIndex, labelIndex: -1 } -> emitArrayHeapBacking(emptyEntryFixedStorageBytes, functionIndex, context, state)
                                    } else { ArrayStorageIdentity { resultDomain: 0, resultIndex: entryExpressionIndex, labelIndex: -1 } -> emitArrayHeapBacking(0, functionIndex, context, state) }
                            } else {
