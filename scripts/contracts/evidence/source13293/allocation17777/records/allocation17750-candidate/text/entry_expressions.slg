    (entryExpression.kind == 9 or entryExpression.kind == 6) and (entryExpression.opcode == -214 or entryExpression.opcode == -230) and entryExpression.operand0 >= 0
        -> if {
            context.ir[entryExpression.operand0] => entryPath
            entryPath.typeId => entryPathType!
