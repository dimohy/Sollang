            }
            "  store " -> print
            entryMutableBinding -> writeIrType(context, state)
            " " -> print
            entryMutableValue.kind == 3 or entryMutableValue.kind == 4
                -> if {
                    entryMutableValue -> sourceToken(context, state) => entryMutableToken
                    entryMutableValue.kind == 3 -> if { entryMutableValue -> writeIntegerLiteral(context, state) } else {
                        (context.sources[entryMutableValue.sourceModule] -> byte(entryMutableToken.span.start)) == 116
                            -> if { "1" -> print } else { "0" -> print }
                    }
                } else { castEntryMutableValue -> if { "%v$(entryExpressionIndex)_mutable_cast" -> print } else { entryExpression.operand0 -> writeValue(functionIndex, context, state) } }
            ", ptr %slot$(entryMutableRoot), align " -> print
            entryMutableBinding -> storageAlign(context, state) -> writeDecimalLine
        }
    entryExpression.kind == 24 -> if {
        WhileValueRequest { whileIndex: entryExpressionIndex, ownerIndex: functionIndex, nodeIndex: entryExpressionIndex } -> emitIndexAssignment(context, state)
    }
    entryExpression.kind == 25 -> if {
        WhileValueRequest { whileIndex: entryExpressionIndex, ownerIndex: functionIndex, nodeIndex: entryExpressionIndex } -> emitMemberAssignment(context, state)
    }
    entryExpression.kind == 26 -> if {
        WhileValueRequest { whileIndex: entryExpressionIndex, ownerIndex: functionIndex, nodeIndex: entryExpressionIndex } -> emitEnumConstructor(context, state)
        entryExpressionIndex -> emitCompletedPatternBindingTransferMarks(context, state)
    }
    entryExpression.kind == 27 -> if { entryExpressionIndex -> emitEnumMatch(entryOrder, context, state) }
    entryExpression.kind == 34 -> if { entryExpressionIndex -> emitSubjectWhen(entryOrder, context, state) }
    entryExpression.kind == 15 -> if {
        entryExpressionIndex -> emitIndexRead(functionIndex, context, state)
    }

    entryActiveEachSize!
}

emitEntryOperationExpression entryExpressionIndex: Int, functionIndex: Int, entryEnd: Int, entryOrder: ref [Int; ~], entryActiveStreams: mut [Int; ~], entryStreamCurrentValues: mut [Int; ~], activeStreamSize: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int uses Console, Process {
    entryExpressionIndex -> emitDeferredTextConsole(functionIndex, context, state)
        -> if { activeStreamSize -> return }
    context.ir[entryExpressionIndex] => entryExpression
    entryExpressionIndex -> emitAwaitTaskValue(context, state)
    entryExpressionIndex -> emitCancelTaskValue(functionIndex, context, state)
    entryExpressionIndex -> emitDurationSleepTask(functionIndex, context, state)
    entryExpressionIndex -> emitDiagnosticSessionCall(functionIndex, context, state)
    entryExpression.kind == 8 and entryExpression.operand0 >= 0 and entryExpression.operand1 < 0 and activeStreamSize > 0
        -> if {
            context.ir[entryExpression.operand0] => entryFlowRight
            entryActiveStreams[activeStreamSize - 1] => entryFlowPipelineIndex
            context.streamPlan.pipelines[entryFlowPipelineIndex].terminalIr => entryFlowTerminalIr
            "" => entryFlowOperation!
            entryExpression.opcode == grammar.tokenIdPlus()
                -> if { "add" => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdMinus()
                -> if { "sub" => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdStar()
                -> if { "mul" => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdSlash()
                -> if { entryExpression -> integerQuotientOperation(context, state) => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdPercent()
                -> if { entryExpression -> integerRemainderOperation(context, state) => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdEqualEqual()
                -> if { "icmp eq" => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdBangEqual()
                -> if { "icmp ne" => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdLess()
                -> if { "icmp slt" => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdLessEqual()
                -> if { "icmp sle" => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdGreater()
                -> if { "icmp sgt" => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdGreaterEqual()
                -> if { "icmp sge" => entryFlowOperation! }
            "  %v$(entryExpressionIndex) = $(entryFlowOperation!) i32 %stream$(entryFlowTerminalIr)_item, " -> print
            entryFlowRight.kind == 3 -> if {
