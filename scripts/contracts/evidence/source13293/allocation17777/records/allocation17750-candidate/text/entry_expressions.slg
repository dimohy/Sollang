        -> if {
            entryExpressionIndex -> emitCapacityIntrinsic(functionIndex, context, state)
        }
    (entryExpression.kind == 9 or entryExpression.kind == 6)
        and entryExpression.opcode == -271
        and entryExpression.operand0 >= 0
        and entryExpression.operand1 >= 0
        -> if {
            WhileValueRequest { whileIndex: entryExpressionIndex, ownerIndex: functionIndex, nodeIndex: entryExpressionIndex }
