            } else {
                entryExpressionIndex -> emitDictionaryLiteralStorage(entryDictionaryCapacity, entryDictionaryEntryLayout, context, state)
            }
            entryDictionaryItemStart => entryDictionaryItemIndex!
            0 => entryDictionaryItemPosition!
            -1 => entryDictionaryControlHashWidth!
            entryDictionaryItemCount! > 0 -> if {
                entryDictionaryKeyTypeId! >= 0 and entryDictionaryKeyTypeId! < (context.types -> len)
                    -> if {
                        context.types[entryDictionaryKeyTypeId!] => entryDictionaryControlKeyType
                        entryDictionaryControlKeyType.kind == 1 and entryDictionaryControlKeyType.origin == 1
                            -> if {
                                entryDictionaryControlKeyType.symbol == 23
                                    -> if { 1 => entryDictionaryControlHashWidth! } else {
                                        (entryDictionaryControlKeyType.symbol -> integerWidth(context, state)) > 0
                                            -> if {
                                                entryDictionaryKeyStorageSize! == 1
                                                    -> if { 8 => entryDictionaryControlHashWidth! }
                                                entryDictionaryKeyStorageSize! == 2
                                                    -> if { 16 => entryDictionaryControlHashWidth! }
                                                entryDictionaryKeyStorageSize! == 4
                                                    -> if { 32 => entryDictionaryControlHashWidth! }
                                                entryDictionaryKeyStorageSize! == 8
                                                    -> if { 64 => entryDictionaryControlHashWidth! }
                                            }
                                    }
                            }
                    }
            }
            -1 => entryDictionaryControlHashMethod!
            entryDictionaryKeyTypeId! >= 0 -> if { entryDictionaryKeyTypeId! -> traitMethodSymbol("Hash", "hash", context, state) => entryDictionaryControlHashMethod! }
            entryDictionaryItemIndex! >= 0 -> while {
                context.ir[entryDictionaryItemIndex!] => entryDictionaryItem
                entryDictionaryItemPosition! / 2 => entryDictionaryEntryPosition
                entryDictionaryItemPosition! % 2 == 0 -> if { "keys" } else { "values" } => entryDictionarySide
                entryDictionaryItemPosition! % 2 == 0 -> if { entryExpression.typeModule } else { entryExpression.typeSymbol } => entryDictionaryItemSymbol
                entryDictionaryItemPosition! % 2 == 0 -> if { entryDictionaryKeyTypeId! } else { entryDictionaryValueTypeId! } => entryDictionaryItemTypeId
                entryDictionaryItemPosition! % 2 == 0 -> if {
                    DictionaryLiteralSlotRequest { dictionaryIndex: entryExpressionIndex, ownerIndex: functionIndex, entryPosition: entryDictionaryEntryPosition, keyIndex: entryDictionaryItemIndex!, keyTypeId: entryDictionaryKeyTypeId!, hashWidth: entryDictionaryControlHashWidth!, hashMethod: entryDictionaryControlHashMethod!, capacity: entryDictionaryCapacity, valueTypeId: entryDictionaryValueTypeId!, valueSymbol: entryExpression.typeSymbol, entryLayout: entryDictionaryEntryLayout } -> emitDictionaryLiteralSlot(context, state)
                }
                entryDictionaryItemTypeId >= 0 and context.types[entryDictionaryItemTypeId].kind == 12
                    -> if {
                        Arena(0) => boundedPrefixStorage!
                        "v$(entryExpressionIndex)_$(entryDictionarySide)_bounded$(entryDictionaryEntryPosition)" -> materialize(boundedPrefixStorage!) => boundedPrefix
                        boundedPrefix -> emitBoundedArrayValue(entryDictionaryItemIndex!, functionIndex, entryDictionaryItemTypeId, context, state)
                    }
                "  %v$(entryExpressionIndex)_$(entryDictionarySide)_ptr$(entryDictionaryEntryPosition) = getelementptr " -> print
                entryDictionaryEntryLayout -> writeDictionaryEntryStorageType
                ", ptr %v$(entryExpressionIndex)_$(entryDictionarySide), i64 %v$(entryExpressionIndex)_literal$(entryDictionaryEntryPosition)_slot" -> println
                "  store " -> print
                entryDictionaryItem.typeKind == 8 or (entryDictionaryItem.typeId >= 0 and context.types[entryDictionaryItem.typeId].kind == 8)
                    -> if { "ptr" -> print } else { entryDictionaryItemTypeId >= 0
                            -> if { entryDictionaryItemTypeId -> writeSemanticTypeId(context, state) } else { entryDictionaryItemSymbol -> llvmType(context, state) -> print } }
                " " -> print
                entryDictionaryItemTypeId >= 0 and context.types[entryDictionaryItemTypeId].kind == 12
                    -> if { "%v$(entryExpressionIndex)_$(entryDictionarySide)_bounded$(entryDictionaryEntryPosition)" -> print } else {
                        entryDictionaryItemIndex! -> writeDictionaryLiteralItem(functionIndex, context, state)
                    }
                ", ptr %v$(entryExpressionIndex)_$(entryDictionarySide)_ptr$(entryDictionaryEntryPosition), align " -> print
                entryDictionaryItem.typeKind == 8 or (entryDictionaryItem.typeId >= 0 and context.types[entryDictionaryItem.typeId].kind == 8)
                    -> if { context.pointerBitWidth / 8 -> writeDecimalLine } else { entryDictionaryItemTypeId >= 0
                            -> if { context.typeAligns[entryDictionaryItemTypeId] -> writeDecimalLine } else { entryDictionaryItemSymbol -> legacyStorageAlign(context, state) -> writeDecimalLine } }
                entryDictionaryItemPosition! % 2 == 0 -> if {
                    "v$(entryExpressionIndex)_literal$(entryDictionaryEntryPosition)_control" -> emitDictionaryControlStore("%v$(entryExpressionIndex)_controls", "%v$(entryExpressionIndex)_literal$(entryDictionaryEntryPosition)_slot", "%v$(entryExpressionIndex)_literal$(entryDictionaryEntryPosition)_h2", "$(entryDictionaryCapacity)")
                }
                entryDictionaryItem.nextOperand => entryDictionaryItemIndex!
                entryDictionaryItemPosition! + 1 => entryDictionaryItemPosition!
            }
            entryExpressionIndex -> emitDictionaryLiteralOwner(entryDictionaryLength, entryDictionaryCapacity, context, state)
        }
    entryExpression.kind == 17 and entryExpression.flags == 1
        -> if {
            entryExpressionIndex -> mutableBindingRoot(context, state) => entryMutableRoot
            context.ir[entryMutableRoot] => entryMutableBinding
            entryExpressionIndex -> emitMutableHeaderStart(context)
            context.ir[entryExpression.operand0] => entryMutableValue
            entryMutableBinding -> integerNodeWidth(context, state) => entryMutableTargetWidth
            entryMutableValue -> integerNodeWidth(context, state) => entryMutableSourceWidth
            (entryMutableTargetWidth > 0 and entryMutableSourceWidth > 0 and entryMutableTargetWidth != entryMutableSourceWidth and entryMutableValue.kind != 3 and entryMutableValue.kind != 4) => castEntryMutableValue
            castEntryMutableValue -> if {
                "  %v$(entryExpressionIndex)_mutable_cast = " -> print
                entryMutableTargetWidth < entryMutableSourceWidth
                    -> if { "trunc " -> print } else { entryMutableValue -> integerNodeSigned(context, state)
                            -> if { "sext " -> print } else { "zext " -> print } }
                entryMutableValue -> writeIrType(context, state)
                " %v$(entryExpression.operand0) to " -> print
                entryMutableBinding -> writeIrType(context, state)
