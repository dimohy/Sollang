                "  %v$(entryExpressionIndex)_path_style_valid = icmp eq i32 %v$(entryExpressionIndex)_path_style, $(entryPathExpectedStyle)" -> println
                "  br i1 %v$(entryExpressionIndex)_path_style_valid, label %map_path$(entryExpressionIndex)_open, label %map_path$(entryExpressionIndex)_style_error" -> println
                "map_path$(entryExpressionIndex)_style_error:" -> println
                "  call void @llvm.trap()" -> println
                "  unreachable" -> println
                "map_path$(entryExpressionIndex)_open:" -> println
            }
