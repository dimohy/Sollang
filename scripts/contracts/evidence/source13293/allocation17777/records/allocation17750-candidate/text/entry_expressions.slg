                            entryOrder! -> push(entryProducerPipeline.terminalIr)
                            true => entryScheduled![entryProducerPipeline.terminalIr - functionIndex - 1]
                            true => entryProducerCallbackProgress!
                            true => entryCombinedScheduleProgress!
                        }
                    entryProducerPartitionPredicatesReady! and entryProducerPipeline.status > 0 and entryProducerPipeline.status < 3 and entryProducerPipeline.terminalIr > functionIndex and entryProducerPipeline.terminalIr < entryEnd and entryScheduled![entryProducerPipeline.terminalIr - functionIndex - 1] and entryProducerPipeline.callbackStart >= functionIndex + 1 and entryProducerPipeline.callbackEnd < entryEnd
                        -> if {
                            entryProducerPipeline.stageStart => entryProducerStageIndex!
                            entryProducerStageIndex! < entryProducerPipeline.stageStart + entryProducerPipeline.stageCount
                                -> while {
                                    context.streamPlan.stages[entryProducerStageIndex!] => entryProducerStage
                                    entryProducerStage.callbackStart >= functionIndex + 1 and entryProducerStage.callbackEnd < entryEnd
                                        -> if {
                                            entryProducerStage.callbackStart => entryProducerStageCallbackIndex!
                                            entryProducerStageCallbackIndex! <= entryProducerStage.callbackEnd
                                                -> while {
                                                    not entryScheduled![entryProducerStageCallbackIndex! - functionIndex - 1]
                                                        -> if {
                                                            context.ir[entryProducerStageCallbackIndex!] => entryProducerStageCallback
                                                            true => entryProducerStageCallbackReady!
                                                            NodeAncestorRequest { nodeIndex: entryProducerStageCallbackIndex!, ownerIndex: entryProducerStage.callIr } -> irDescendsFrom(context, state) => entryProducerStageCallbackInside
                                                            not entryProducerStageCallbackInside -> if { false => entryProducerStageCallbackReady! }
                                                            entryProducerStageCallbackReady! and entryProducerStage.source0 >= 0
                                                                -> if {
                                                                    NodeAncestorRequest { nodeIndex: entryProducerStageCallbackIndex!, ownerIndex: entryProducerStage.source0 } -> irDescendsFrom(context, state) => entryProducerStageCallbackInsideSource
                                                                    entryProducerStageCallbackIndex! == entryProducerStage.source0 or entryProducerStageCallbackInsideSource
                                                                        -> if { false => entryProducerStageCallbackReady! }
                                                                }
                                                            entryProducerStageCallback.operand0 > functionIndex and entryProducerStageCallback.operand0 < entryEnd and not entryScheduled![entryProducerStageCallback.operand0 - functionIndex - 1]
                                                                -> if { false => entryProducerStageCallbackReady! }
                                                            entryProducerStageCallback.operand1 > functionIndex and entryProducerStageCallback.operand1 < entryEnd and not entryScheduled![entryProducerStageCallback.operand1 - functionIndex - 1]
                                                                -> if { false => entryProducerStageCallbackReady! }
                                                            entryProducerStageCallbackReady! -> if {
                                                                entryProducerStageCallbackIndex! -> entryPartitionRecoveryEffectsReady(entryProducerPartitionRoute, functionIndex, entryEnd, entryScheduled!, context, state) => entryProducerStageCallbackReady!
                                                            }
                                                            entryProducerStageCallbackReady! -> if {
                                                                entryOrder! -> push(entryProducerStageCallbackIndex!)
                                                                true => entryScheduled![entryProducerStageCallbackIndex! - functionIndex - 1]
                                                                true => entryProducerCallbackProgress!
                                                                true => entryCombinedScheduleProgress!
                                                            }
                                                        }
                                                    entryProducerStageCallbackIndex! + 1 => entryProducerStageCallbackIndex!
                                                }
                                        }
                                    entryProducerStageIndex! + 1 => entryProducerStageIndex!
                                }
                            entryProducerPipeline.callbackStart => entryProducerCallbackIndex!
                            entryProducerPipeline.callbackEnd => entryProducerCallbackEnd!
                            entryProducerPartitionRoute >= 0 -> if {
                                functionIndex + 1 => entryProducerCallbackIndex!
                                entryEnd - 1 => entryProducerCallbackEnd!
                            }
                            entryProducerCallbackIndex! <= entryProducerCallbackEnd!
                                -> while {
                                    not entryScheduled![entryProducerCallbackIndex! - functionIndex - 1]
                                        -> if {
                                            context.ir[entryProducerCallbackIndex!] => entryProducerCallback
                                            true => entryProducerCallbackReady!
                                            NodeAncestorRequest { nodeIndex: entryProducerCallbackIndex!, ownerIndex: entryProducerPipeline.terminalIr } -> irDescendsFrom(context, state) => entryProducerCallbackInside
                                            not entryProducerCallbackInside -> if { false => entryProducerCallbackReady! }
                                            entryProducerCallbackReady! and entryProducerPipeline.source0 >= 0
                                                -> if {
                                                    NodeAncestorRequest { nodeIndex: entryProducerCallbackIndex!, ownerIndex: entryProducerPipeline.source0 } -> irDescendsFrom(context, state) => entryProducerCallbackInsideSource
                                                    entryProducerCallbackIndex! == entryProducerPipeline.source0 or entryProducerCallbackInsideSource
                                                        -> if { false => entryProducerCallbackReady! }
                                                }
                                            entryProducerCallback.operand0 > functionIndex and entryProducerCallback.operand0 < entryEnd and not entryScheduled![entryProducerCallback.operand0 - functionIndex - 1]
                                                -> if { false => entryProducerCallbackReady! }
                                            entryProducerCallback.operand1 > functionIndex and entryProducerCallback.operand1 < entryEnd and not entryScheduled![entryProducerCallback.operand1 - functionIndex - 1]
                                                -> if { false => entryProducerCallbackReady! }
                                            entryProducerCallbackReady! -> if {
                                                entryProducerCallbackIndex! -> entryPartitionRecoveryEffectsReady(entryProducerPartitionRoute, functionIndex, entryEnd, entryScheduled!, context, state) => entryProducerCallbackReady!
                                            }
                                            entryProducerCallbackReady! -> if {
                                                entryOrder! -> push(entryProducerCallbackIndex!)
                                                true => entryScheduled![entryProducerCallbackIndex! - functionIndex - 1]
                                                true => entryProducerCallbackProgress!
                                                true => entryCombinedScheduleProgress!
                                            }
                                        }
                                    entryProducerCallbackIndex! + 1 => entryProducerCallbackIndex!
                                }
                        }
                    entryProducerPipelineIndex! + 1 => entryProducerPipelineIndex!
                }
        }
    }
    -1 => failureNode!
    -1 => failureTerminal!
    0 => validationPipelineIndex!
    validationPipelineIndex! < (context.streamPlan.pipelines -> len) and failureNode! < 0
        -> while {
            context.streamPlan.pipelines[validationPipelineIndex!] => pipeline
            pipeline.terminalIr > functionIndex and pipeline.terminalIr < entryEnd
                and not (pipeline.terminalIr -> hasDeferredScheduleOwner(functionIndex, context))
                -> if {
                    0 => terminalCount!
                    entryOrder! -> each orderedNode {
                        orderedNode == pipeline.terminalIr -> if { terminalCount! + 1 => terminalCount! }
                    }
                    terminalCount! != 1 -> if {
                        pipeline.terminalIr => failureNode!
                        pipeline.terminalIr => failureTerminal!
                    }
                    functionIndex + 1 => requiredCallback!
                    requiredCallback! < entryEnd and failureNode! < 0
                        -> while {
                            (requiredCallback! -> streamPipelineOwnsCallback(validationPipelineIndex!, context, state))
                                and not entryScheduled![requiredCallback! - functionIndex - 1]
                                -> if {
                                    requiredCallback! => failureNode!
                                    pipeline.terminalIr => failureTerminal!
                                }
                            requiredCallback! + 1 => requiredCallback!
                        }
                }
            validationPipelineIndex! + 1 => validationPipelineIndex!
        }
    BodySchedulePlan {
        functionIndex: functionIndex
        order: entryOrder!
        scheduled: entryScheduled!
        emitMutableSlots: true
        failureNode: failureNode!
        failureTerminal: failureTerminal!
    }
}

emitEntryOpeningStreamExpression entryExpressionIndex: Int, functionIndex: Int, entryEnd: Int, entryActiveStreams: mut [Int; ~], entryStreamCurrentValues: mut [Int; ~], entryStreamStops: mut [Int; ~], activeStreamSize: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int uses Console, Process {
    context.ir[entryExpressionIndex] => entryExpression
    activeStreamSize => entryActiveStreamSize!
    entryExpressionIndex -> plannedStreamPipeline(context, state) => entryOpeningStreamPipeline
    entryOpeningStreamPipeline >= 0 -> if {
        context.streamPlan.pipelines[entryOpeningStreamPipeline] => entryOpeningPipeline
        entryExpressionIndex -> plannedPartitionRoute(context, state) => entryOpeningPartitionRoute
        -1 => entryOpeningPartitionJunction!
        entryExpressionIndex => entryOpeningSharedTerminal!
        entryOpeningPipeline.source0 => entryOpeningSource!
        entryOpeningPipeline.status => entryOpeningStatus!
        entryOpeningPartitionRoute >= 0 -> if {
            entryOpeningPartitionRoute -> plannedPartitionJunction(context, state) => entryOpeningPartitionJunction!
            context.streamPlan.junctions[entryOpeningPartitionJunction!] => entryOpeningJunction
            entryOpeningJunction.source0 => entryOpeningSource!
            entryOpeningJunction.status => entryOpeningStatus!
            entryOpeningPartitionJunction! -> partitionFirstTerminal(context, state) => entryOpeningSharedTerminal!
        }
        entryOpeningPartitionRoute >= 0 and entryExpressionIndex != entryOpeningSharedTerminal!
            -> if {
                "partition$(context.streamPlan.junctions[entryOpeningPartitionJunction!].junctionIr)_route$(context.streamPlan.partitionRoutes[entryOpeningPartitionRoute].ordinal):" -> println
                context.types[context.ir[entryOpeningSource!].typeId] => entryOpeningPartitionSourceType
                "  %stream$(entryExpressionIndex)_item = freeze " -> print
                entryOpeningPartitionSourceType.first -> writeSemanticTypeId(context, state)
                " %stream$(entryOpeningSharedTerminal!)_item" -> println
            }
        entryOpeningPartitionRoute < 0 or entryExpressionIndex == entryOpeningSharedTerminal!
            -> if {
                entryOpeningStatus! == 3 -> unless {
                    entryOpeningStatus! == 0 -> if {
                        "  %stream$(entryExpressionIndex)_index_slot = alloca i32, align 4" -> println
                    } else {
                        entryOpeningSource! -> producerValueIndex(context, state) => entryOpeningProducerValue
                        context.ir[entryOpeningProducerValue] => entryOpeningProducer
                        context.types[entryOpeningProducer.typeId] => entryOpeningProducerType
                        "%sollang.stream" => entryOpeningProducerLlvmType!
                        entryOpeningPipeline.status == 2 -> if { "%sollang.event_stream" => entryOpeningProducerLlvmType! }
                        "  %stream$(entryExpressionIndex)_producer_item_slot = alloca " -> print
                        entryOpeningProducerType.first -> writeSemanticTypeId(context, state)
                        ", align " -> print
                        context.typeAligns[entryOpeningProducerType.first] -> writeDecimalLine
                        "  %stream$(entryExpressionIndex)_producer_context = extractvalue $(entryOpeningProducerLlvmType!) %v$(entryOpeningProducerValue), 0" -> println
                        "  %stream$(entryExpressionIndex)_producer_next = extractvalue $(entryOpeningProducerLlvmType!) %v$(entryOpeningProducerValue), 1" -> println
                        "  %stream$(entryExpressionIndex)_producer_drop = extractvalue $(entryOpeningProducerLlvmType!) %v$(entryOpeningProducerValue), 2" -> println
                    }
                }
            }
        entryOpeningPipeline.stageStart => entryOpeningStateStageIndex!
        entryOpeningStateStageIndex! < entryOpeningPipeline.stageStart + entryOpeningPipeline.stageCount
            -> while {
                context.streamPlan.stages[entryOpeningStateStageIndex!] => entryOpeningStateStage
                entryOpeningStateStage.flags == 1 or entryOpeningStateStage.flags == 2
                    -> if {
                        "  %stream$(entryExpressionIndex)_slice$(entryOpeningStateStageIndex!)_slot = alloca i32, align 4" -> println
                        "  store i32 0, ptr %stream$(entryExpressionIndex)_slice$(entryOpeningStateStageIndex!)_slot, align 4" -> println
                    }
                entryOpeningStateStage.flags == 3 -> if {
                    "  %stream$(entryExpressionIndex)_inner_index_slot = alloca i32, align 4" -> println
                }
                context.ir[entryOpeningStateStage.callIr] => entryOpeningStateCall
                context.ranges[entryOpeningStateCall.sourceModule] => entryOpeningStateRange
                -1 => entryOpeningStateCallScope!
                0 => entryOpeningStateScopeSearch!
                entryOpeningStateScopeSearch! < entryOpeningStateRange.symbolCount
                    -> while {
                        context.symbols[entryOpeningStateRange.symbolStart + entryOpeningStateScopeSearch!] => entryOpeningStateScopeCandidate
                        entryOpeningStateScopeCandidate.kind == 48 and entryOpeningStateScopeCandidate.astNode == entryOpeningStateCall.astNode
                            -> if { entryOpeningStateScopeSearch! => entryOpeningStateCallScope! }
                        entryOpeningStateScopeSearch! + 1 => entryOpeningStateScopeSearch!
                    }
                0 => entryOpeningStateRoleCount!
                0 => entryOpeningStateRoleSearch!
                entryOpeningStateRoleSearch! < entryOpeningStateRange.symbolCount
                    -> while {
                        context.symbols[entryOpeningStateRange.symbolStart + entryOpeningStateRoleSearch!] => entryOpeningStateRoleCandidate
                        entryOpeningStateRoleCandidate.kind == 35 and entryOpeningStateRoleCandidate.parent == entryOpeningStateCallScope!
                            -> if { entryOpeningStateRoleCount! + 1 => entryOpeningStateRoleCount! }
                        entryOpeningStateRoleSearch! + 1 => entryOpeningStateRoleSearch!
                    }
                entryOpeningStateRoleCount! > 1 and entryOpeningStateStage.argument0 >= 0 and entryOpeningStateStage.flags != 3
                    -> if {
                        "  %stream$(entryExpressionIndex)_state$(entryOpeningStateStageIndex!) = alloca " -> print
                        entryOpeningStateCall -> writeIrType(context, state)
                        ", align " -> print
                        entryOpeningStateCall -> storageAlign(context, state) -> writeDecimalLine
                        "  store " -> print
                        entryOpeningStateCall -> writeIrType(context, state)
                        " zeroinitializer, ptr %stream$(entryExpressionIndex)_state$(entryOpeningStateStageIndex!), align " -> print
                        entryOpeningStateCall -> storageAlign(context, state) -> writeDecimalLine
                    }
                entryOpeningStateStageIndex! + 1 => entryOpeningStateStageIndex!
            }
        entryOpeningPartitionRoute < 0 or entryExpressionIndex == entryOpeningSharedTerminal!
            -> if {
                entryOpeningStatus! == 3 -> if {
                    "  br label %stream$(entryExpressionIndex)_body" -> println
                    "stream$(entryExpressionIndex)_body:" -> println
                } else { entryOpeningStatus! == 0 -> if {
                        "  store i32 " -> print
                        WhileValueRequest { whileIndex: entryExpressionIndex, ownerIndex: functionIndex, nodeIndex: entryOpeningPipeline.source0 } -> writeWhileValue(context, state)
                        ", ptr %stream$(entryExpressionIndex)_index_slot, align 4" -> println
                        "  %stream$(entryExpressionIndex)_end = add i32 " -> print
                        WhileValueRequest { whileIndex: entryExpressionIndex, ownerIndex: functionIndex, nodeIndex: entryOpeningPipeline.source1 } -> writeWhileValue(context, state)
                        ", 0" -> println
                        "  br label %stream$(entryExpressionIndex)_header" -> println
                        "stream$(entryExpressionIndex)_header:" -> println
                        "  %stream$(entryExpressionIndex)_item = load i32, ptr %stream$(entryExpressionIndex)_index_slot, align 4" -> println
                        "  %stream$(entryExpressionIndex)_done = icmp " -> print
                        entryOpeningPipeline.flags % 2 == 1 -> if { "sge" -> print } else { "sgt" -> print }
                        " i32 %stream$(entryExpressionIndex)_item, %stream$(entryExpressionIndex)_end" -> println
                        "  br i1 %stream$(entryExpressionIndex)_done, label %stream$(entryExpressionIndex)_exit, label %stream$(entryExpressionIndex)_body" -> println
                        "stream$(entryExpressionIndex)_body:" -> println
                    } else {
                        context.types[context.ir[entryOpeningSource!].typeId] => entryOpeningBodyProducerType
                        "  br label %stream$(entryExpressionIndex)_header" -> println
                        "stream$(entryExpressionIndex)_header:" -> println
                        "  %stream$(entryExpressionIndex)_has_item = call i1 %stream$(entryExpressionIndex)_producer_next(ptr %stream$(entryExpressionIndex)_producer_context, ptr %stream$(entryExpressionIndex)_producer_item_slot)" -> println
                        "  br i1 %stream$(entryExpressionIndex)_has_item, label %stream$(entryExpressionIndex)_body, label %stream$(entryExpressionIndex)_exit" -> println
                        "stream$(entryExpressionIndex)_body:" -> println
                        "  %stream$(entryExpressionIndex)_item = load " -> print
                        entryOpeningBodyProducerType.first -> writeSemanticTypeId(context, state)
                        ", ptr %stream$(entryExpressionIndex)_producer_item_slot, align " -> print
                        context.typeAligns[entryOpeningBodyProducerType.first] -> writeDecimalLine
                    }
                }
            }
        entryOpeningPipeline.stageStart => entryOpeningPrefixStageIndex!
        true => entryOpeningPrefixOpen!
        entryOpeningPrefixStageIndex! < entryOpeningPipeline.stageStart + entryOpeningPipeline.stageCount and entryOpeningPrefixOpen!
            -> while {
                context.streamPlan.stages[entryOpeningPrefixStageIndex!] => entryOpeningPrefixStage
                entryOpeningPrefixStage.flags == 1 or entryOpeningPrefixStage.flags == 2
                    -> if {
                        entryOpeningPrefixStage.flags == 1 -> if {
                            "  %stream$(entryExpressionIndex)_taken$(entryOpeningPrefixStageIndex!) = load i32, ptr %stream$(entryExpressionIndex)_slice$(entryOpeningPrefixStageIndex!)_slot, align 4" -> println
                            "  %stream$(entryExpressionIndex)_take_open$(entryOpeningPrefixStageIndex!) = icmp slt i32 %stream$(entryExpressionIndex)_taken$(entryOpeningPrefixStageIndex!), " -> print
                            WhileValueRequest { whileIndex: entryExpressionIndex, ownerIndex: functionIndex, nodeIndex: entryOpeningPrefixStage.argument0 } -> writeWhileValue(context, state)
                            "" -> println
                            "  br i1 %stream$(entryExpressionIndex)_take_open$(entryOpeningPrefixStageIndex!), label %stream$(entryExpressionIndex)_take_pass$(entryOpeningPrefixStageIndex!), label %stream$(entryExpressionIndex)_exit" -> println
                            "stream$(entryExpressionIndex)_take_pass$(entryOpeningPrefixStageIndex!):" -> println
                            "  %stream$(entryExpressionIndex)_taken_next$(entryOpeningPrefixStageIndex!) = add i32 %stream$(entryExpressionIndex)_taken$(entryOpeningPrefixStageIndex!), 1" -> println
                            "  store i32 %stream$(entryExpressionIndex)_taken_next$(entryOpeningPrefixStageIndex!), ptr %stream$(entryExpressionIndex)_slice$(entryOpeningPrefixStageIndex!)_slot, align 4" -> println
                        }
                        entryOpeningPrefixStage.flags == 2 -> if {
                            "  %stream$(entryExpressionIndex)_skipped$(entryOpeningPrefixStageIndex!) = load i32, ptr %stream$(entryExpressionIndex)_slice$(entryOpeningPrefixStageIndex!)_slot, align 4" -> println
                            "  %stream$(entryExpressionIndex)_skip_open$(entryOpeningPrefixStageIndex!) = icmp slt i32 %stream$(entryExpressionIndex)_skipped$(entryOpeningPrefixStageIndex!), " -> print
                            WhileValueRequest { whileIndex: entryExpressionIndex, ownerIndex: functionIndex, nodeIndex: entryOpeningPrefixStage.argument0 } -> writeWhileValue(context, state)
                            "" -> println
                            "  br i1 %stream$(entryExpressionIndex)_skip_open$(entryOpeningPrefixStageIndex!), label %stream$(entryExpressionIndex)_skip_drop$(entryOpeningPrefixStageIndex!), label %stream$(entryExpressionIndex)_skip_pass$(entryOpeningPrefixStageIndex!)" -> println
                            "stream$(entryExpressionIndex)_skip_drop$(entryOpeningPrefixStageIndex!):" -> println
                            "  %stream$(entryExpressionIndex)_skipped_next$(entryOpeningPrefixStageIndex!) = add i32 %stream$(entryExpressionIndex)_skipped$(entryOpeningPrefixStageIndex!), 1" -> println
                            "  store i32 %stream$(entryExpressionIndex)_skipped_next$(entryOpeningPrefixStageIndex!), ptr %stream$(entryExpressionIndex)_slice$(entryOpeningPrefixStageIndex!)_slot, align 4" -> println
                            "  br label %stream$(entryExpressionIndex)_continue" -> println
                            "stream$(entryExpressionIndex)_skip_pass$(entryOpeningPrefixStageIndex!):" -> println
                        }
                        entryOpeningPrefixStageIndex! + 1 => entryOpeningPrefixStageIndex!
                    } else { false => entryOpeningPrefixOpen! }
            }
        -1 => entryOpeningFlatMapStage!
        -1 => entryOpeningBeforeEachStage!
        -1 => entryOpeningAfterEachStage!
        entryOpeningPipeline.stageStart => entryOpeningFlatMapSearch!
        entryOpeningFlatMapSearch! < entryOpeningPipeline.stageStart + entryOpeningPipeline.stageCount
            -> while {
                context.streamPlan.stages[entryOpeningFlatMapSearch!] => entryOpeningPhaseStage
                entryOpeningPhaseStage.flags == 3 -> if { entryOpeningFlatMapSearch! => entryOpeningFlatMapStage! }
                entryOpeningPhaseStage.flags == 4 and entryOpeningPhaseStage.callbackRoot >= 0
                    -> if { entryOpeningFlatMapSearch! => entryOpeningBeforeEachStage! }
                entryOpeningPhaseStage.flags == 5 and entryOpeningPhaseStage.callbackRoot >= 0
                    -> if { entryOpeningFlatMapSearch! => entryOpeningAfterEachStage! }
                entryOpeningFlatMapSearch! + 1 => entryOpeningFlatMapSearch!
            }
        entryOpeningFlatMapStage! >= 0 -> if {
            context.streamPlan.stages[entryOpeningFlatMapStage!] => entryOpeningFlatMap
            context.ir[entryOpeningFlatMap.callIr] => entryOpeningFlatMapCall
            entryOpeningBeforeEachStage! >= 0 -> if {
                "  br label %stream$(entryExpressionIndex)_before_each" -> println
            } else {
                "  br label %stream$(entryExpressionIndex)_inner_init" -> println
            }
            "stream$(entryExpressionIndex)_inner_init:" -> println
            "  store i32 " -> print
            WhileValueRequest { whileIndex: entryExpressionIndex, ownerIndex: functionIndex, nodeIndex: entryOpeningFlatMap.argument0 } -> writeWhileValue(context, state)
            ", ptr %stream$(entryExpressionIndex)_inner_index_slot, align 4" -> println
            "  %stream$(entryExpressionIndex)_inner_end = add i32 " -> print
            WhileValueRequest { whileIndex: entryExpressionIndex, ownerIndex: functionIndex, nodeIndex: entryOpeningFlatMap.argument1 } -> writeWhileValue(context, state)
            ", 0" -> println
            "  br label %stream$(entryExpressionIndex)_inner_header" -> println
            "stream$(entryExpressionIndex)_inner_header:" -> println
            "  %stream$(entryExpressionIndex)_inner_item = load i32, ptr %stream$(entryExpressionIndex)_inner_index_slot, align 4" -> println
            "  %stream$(entryExpressionIndex)_inner_done = icmp " -> print
            entryOpeningFlatMap.rangeFlags % 2 == 1 -> if { "sge" -> print } else { "sgt" -> print }
            " i32 %stream$(entryExpressionIndex)_inner_item, %stream$(entryExpressionIndex)_inner_end" -> println
            "  br i1 %stream$(entryExpressionIndex)_inner_done, label %stream$(entryExpressionIndex)_" -> print
            entryOpeningAfterEachStage! >= 0 -> if { "after_each" -> print } else { "inner_exit" -> print }
            ", label %stream$(entryExpressionIndex)_inner_body" -> println
            entryOpeningBeforeEachStage! >= 0 -> if {
                "stream$(entryExpressionIndex)_before_each:" -> println
            } else {
                entryOpeningAfterEachStage! >= 0 -> if {
                    "stream$(entryExpressionIndex)_after_each:" -> println
                } else {
                    "stream$(entryExpressionIndex)_inner_body:" -> println
                }
            }
            context.ranges[entryOpeningFlatMapCall.sourceModule] => entryOpeningFlatMapRange
            -1 => entryOpeningFlatMapScope!
            0 => entryOpeningFlatMapScopeSearch!
            entryOpeningFlatMapScopeSearch! < entryOpeningFlatMapRange.symbolCount
                -> while {
                    context.symbols[entryOpeningFlatMapRange.symbolStart + entryOpeningFlatMapScopeSearch!] => entryOpeningFlatMapScopeCandidate
                    entryOpeningFlatMapScopeCandidate.kind == 48 and entryOpeningFlatMapScopeCandidate.astNode == entryOpeningFlatMapCall.astNode
                        -> if { entryOpeningFlatMapScopeSearch! => entryOpeningFlatMapScope! }
                    entryOpeningFlatMapScopeSearch! + 1 => entryOpeningFlatMapScopeSearch!
                }
            entryOpeningBeforeEachStage! < 0 and entryOpeningAfterEachStage! < 0
                -> if {
                    0 => entryOpeningFlatMapRoleOrdinal!
                    0 => entryOpeningFlatMapRoleSearch!
                    entryOpeningFlatMapRoleSearch! < entryOpeningFlatMapRange.symbolCount
                        -> while {
                            context.symbols[entryOpeningFlatMapRange.symbolStart + entryOpeningFlatMapRoleSearch!] => entryOpeningFlatMapRole
                            entryOpeningFlatMapRole.kind == 35 and entryOpeningFlatMapRole.parent == entryOpeningFlatMapScope!
                                -> if {
                                    functionIndex + 1 => entryOpeningFlatMapUseSearch!
                                    entryOpeningFlatMapUseSearch! < entryEnd -> while {
                                        context.ir[entryOpeningFlatMapUseSearch!] => entryOpeningFlatMapUse
                                        entryOpeningFlatMapUse.kind == 5 and entryOpeningFlatMapUse.symbol == entryOpeningFlatMapRoleSearch!
                                            and (entryOpeningFlatMapRoleOrdinal! == 0 or entryOpeningPipeline.status == 3 or (context -> emitterContext.streamStageInputValue(entryOpeningStreamPipeline, entryOpeningFlatMapStage!)) < 0)
                                            -> if {
                                                "  %v$(entryOpeningFlatMapUseSearch!) = freeze " -> print
                                                context -> emitterContext.streamStageInputValue(entryOpeningStreamPipeline, entryOpeningFlatMapStage!) => entryOpeningInput
                                                entryOpeningFlatMapRoleOrdinal! != 0 and entryOpeningInput >= 0
                                                    -> if {
                                                        context.ir[entryOpeningInput] -> writeIrType(context, state)
                                                    } else { entryOpeningFlatMapUse -> writeIrType(context, state) }
                                                entryOpeningFlatMapRoleOrdinal! == 0 -> if { " %stream$(entryExpressionIndex)_inner_item" -> println } else {
                                                    entryOpeningInput >= 0 -> if { " " -> print
                                                        entryOpeningInput -> writeValue(functionIndex, context, state)
                                                        "" -> println } else { " %stream$(entryOpeningSharedTerminal!)_item" -> println }
                                                }
                                            }
                                        entryOpeningFlatMapUseSearch! + 1 => entryOpeningFlatMapUseSearch!
                                    }
                                    entryOpeningFlatMapRoleOrdinal! + 1 => entryOpeningFlatMapRoleOrdinal!
                                }
                            entryOpeningFlatMapRoleSearch! + 1 => entryOpeningFlatMapRoleSearch!
                        }
                }
        }
        # flatMap owns both role aliases at its phase entry; the generic first-stage
        # initializer must not emit either alias a second time.
        entryOpeningPipeline.stageCount > 0 and context.streamPlan.stages[entryOpeningPipeline.stageStart].flags != 3
            -> if {
                context.streamPlan.stages[entryOpeningPipeline.stageStart] => entryFirstStreamStage
                entryFirstStreamStage.callIr => entryFirstStageCall
                context.ir[entryFirstStageCall] => entryFirstStageNode
                context.ranges[entryFirstStageNode.sourceModule] => entryFirstStageRange
                -1 => entryFirstStageRoleSymbol!
                0 => entryFirstStageRoleSearch!
                entryFirstStageRoleSearch! < entryFirstStageRange.symbolCount
                    -> while {
                        context.symbols[entryFirstStageRange.symbolStart + entryFirstStageRoleSearch!] => entryFirstStageRole
                        entryFirstStageRole.kind == 35 and entryFirstStageRole.astNode == entryFirstStageNode.astNode
                            -> if { entryFirstStageRoleSearch! => entryFirstStageRoleSymbol! }
                        entryFirstStageRoleSearch! + 1 => entryFirstStageRoleSearch!
                    }
                functionIndex + 1 => entryFirstStageUseSearch!
                entryFirstStageUseSearch! < entryEnd -> while {
                    context.ir[entryFirstStageUseSearch!] => entryFirstStageUse
                    entryFirstStageUse.kind == 5 and entryFirstStageUse.symbol == entryFirstStageRoleSymbol!
                        -> if {
                            "  %v$(entryFirstStageUseSearch!) = freeze " -> print
                            entryFirstStageUse -> writeIrType(context, state)
                            " %stream$(entryOpeningSharedTerminal!)_item" -> println
                        }
                    entryFirstStageUseSearch! + 1 => entryFirstStageUseSearch!
                }
            }
        entryOpeningPipeline.stageCount == 0 -> if {
            context.ir[entryOpeningPipeline.terminalIr] => entryOpeningTerminal
            context.ranges[entryOpeningTerminal.sourceModule] => entryOpeningTerminalRange
            -1 => entryOpeningTerminalRoleSymbol!
            0 => entryOpeningTerminalRoleSearch!
            entryOpeningTerminalRoleSearch! < entryOpeningTerminalRange.symbolCount
                -> while {
                    context.symbols[entryOpeningTerminalRange.symbolStart + entryOpeningTerminalRoleSearch!] => entryOpeningTerminalRole
                    entryOpeningTerminalRole.kind == 35 and entryOpeningTerminalRole.astNode == entryOpeningTerminal.astNode
                        -> if { entryOpeningTerminalRoleSearch! => entryOpeningTerminalRoleSymbol! }
                    entryOpeningTerminalRoleSearch! + 1 => entryOpeningTerminalRoleSearch!
                }
            functionIndex + 1 => entryOpeningTerminalUseSearch!
            entryOpeningTerminalUseSearch! < entryEnd -> while {
                context.ir[entryOpeningTerminalUseSearch!] => entryOpeningTerminalUse
                entryOpeningTerminalUse.kind == 5 and entryOpeningTerminalUse.symbol == entryOpeningTerminalRoleSymbol!
                    -> if {
                        "  %v$(entryOpeningTerminalUseSearch!) = freeze " -> print
                        entryOpeningTerminalUse -> writeIrType(context, state)
                        " %stream$(entryOpeningSharedTerminal!)_item" -> println
                    }
                entryOpeningTerminalUseSearch! + 1 => entryOpeningTerminalUseSearch!
            }
        }
        entryOpeningPartitionRoute >= 0 and entryExpressionIndex == entryOpeningSharedTerminal!
            -> if {
                context.streamPlan.junctions[entryOpeningPartitionJunction!] => entryOpeningPartition
                context.ir[entryOpeningPartition.junctionIr] => entryOpeningPartitionNode
                context.ranges[entryOpeningPartitionNode.sourceModule] => entryOpeningPartitionRange
                -1 => entryOpeningPartitionRoleSymbol!
                0 => entryOpeningPartitionRoleSearch!
                entryOpeningPartitionRoleSearch! < entryOpeningPartitionRange.symbolCount
                    -> while {
                        context.symbols[entryOpeningPartitionRange.symbolStart + entryOpeningPartitionRoleSearch!] => entryOpeningPartitionRole
                        entryOpeningPartitionRole.kind == 35 and entryOpeningPartitionRole.astNode == entryOpeningPartitionNode.astNode
                            -> if { entryOpeningPartitionRoleSearch! => entryOpeningPartitionRoleSymbol! }
                        entryOpeningPartitionRoleSearch! + 1 => entryOpeningPartitionRoleSearch!
                    }
                functionIndex + 1 => entryOpeningPartitionUseSearch!
                entryOpeningPartitionUseSearch! < entryEnd -> while {
                    context.ir[entryOpeningPartitionUseSearch!] => entryOpeningPartitionUse
                    entryOpeningPartitionUse.kind == 5 and entryOpeningPartitionUse.symbol == entryOpeningPartitionRoleSymbol!
                        -> if {
                            "  %v$(entryOpeningPartitionUseSearch!) = freeze " -> print
                            entryOpeningPartitionUse -> writeIrType(context, state)
                            " %stream$(entryOpeningSharedTerminal!)_item" -> println
                        }
                    entryOpeningPartitionUseSearch! + 1 => entryOpeningPartitionUseSearch!
                }
            }
        entryActiveStreamSize! == (entryActiveStreams -> len)
            -> if {
                entryActiveStreams -> push(entryOpeningStreamPipeline)
                entryStreamCurrentValues -> push(-1)
                entryStreamStops -> push(0)
            } else {
                entryOpeningStreamPipeline => entryActiveStreams[entryActiveStreamSize!]
                -1 => entryStreamCurrentValues[entryActiveStreamSize!]
                0 => entryStreamStops[entryActiveStreamSize!]
            }
        entryActiveStreamSize! + 1 => entryActiveStreamSize!
    }
    entryActiveStreamSize!
}

emitEntryControlExpression entryExpressionIndex: Int, functionIndex: Int, entryOrder: ref [Int; ~], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[entryExpressionIndex] => entryExpression
    entryExpression.kind == 2 -> if {
        entryExpression -> sourceToken(context, state) => entryExpressionToken
        TextLiteralRequest { sourceModule: entryExpression.sourceModule, token: entryExpressionToken } -> textLiteralLength(context, state) => entryExpressionLength
        "  %v$(entryExpressionIndex)_ptr = insertvalue %sollang.text poison, ptr @sollang_str_$(entryExpressionIndex), 0" -> println
        "  %v$(entryExpressionIndex) = insertvalue %sollang.text %v$(entryExpressionIndex)_ptr, i64 $entryExpressionLength, 1" -> println
        entryExpressionIndex -> emitComparisonTextProducer(functionIndex, context, state)
    }
    entryExpression.kind == 36 -> if {
        "  %v$(entryExpressionIndex) = freeze " -> print
        entryExpression -> writeIrType(context, state)
        " " -> print
        entryExpression.operand0 -> writeValue(functionIndex, context, state)
        "" -> println
    }
    entryExpression.kind == 37 -> if { entryExpressionIndex -> emitSequentialBranchAggregate(functionIndex, context, state) }
    entryExpression.kind == 39 -> if { entryExpressionIndex -> emitSequentialBranchArmValue(functionIndex, context, state) }
    entryExpressionIndex -> emitPlannedJunctionValue(functionIndex, context, state)
    entryExpression.kind == 38 and context.supportsComputePool
        -> if { entryExpressionIndex -> emitParallelBranchValue(functionIndex, context, state) }
    entryExpression.kind == 12 or entryExpression.kind == 35
        -> if {
            entryExpression.operand0 < 0 -> if {
                "  %v$(entryExpressionIndex) = freeze " -> print
                entryExpression -> writeIrType(context, state)
                " zeroinitializer" -> println
            }
            entryExpression.operand0 => entryFieldValueIndex!
            0 => entryFieldPosition!
            entryFieldValueIndex! >= 0 -> while {
                context.ir[entryFieldValueIndex!] => entryFieldValue
                entryFieldValueIndex! -> aggregateValueIndex(context, state) => entryEmittedFieldIndex
                context.ir[entryEmittedFieldIndex] => entryEmittedFieldValue
                entryExpression.typeId => entryStructOwnerTypeId!
                0 => entryStructOwnerTypeSearch!
                entryStructOwnerTypeSearch! < (context.types -> len)
                    -> while {
                        context.types[entryStructOwnerTypeSearch!] => entryStructOwnerTypeCandidate
                        entryStructOwnerTypeCandidate.status == 0 and entryStructOwnerTypeCandidate.kind == 1 and entryStructOwnerTypeCandidate.origin == entryExpression.typeOrigin and entryStructOwnerTypeCandidate.module == entryExpression.typeModule and entryStructOwnerTypeCandidate.symbol == entryExpression.typeSymbol
                            -> if { entryStructOwnerTypeSearch! => entryStructOwnerTypeId! }
                        entryStructOwnerTypeSearch! + 1 => entryStructOwnerTypeSearch!
                    }
                -1 => entryTargetFieldTypeId!
                0 => entryTargetFieldOrdinal!
                0 => entryTargetFieldSearch!
                entryTargetFieldSearch! < (context.fields -> len)
                    -> while {
                        context.fields[entryTargetFieldSearch!] => entryTargetField
                        entryTargetField.status == 0 and entryTargetField.ownerType == entryStructOwnerTypeId!
                            -> if {
                                entryTargetFieldOrdinal! == entryFieldPosition!
                                    -> if { entryTargetField.fieldType => entryTargetFieldTypeId! }
                                entryTargetFieldOrdinal! + 1 => entryTargetFieldOrdinal!
                            }
                        entryTargetFieldSearch! + 1 => entryTargetFieldSearch!
                    }
                entryEmittedFieldValue -> integerNodeWidth(context, state) => entrySourceFieldWidth
                0 => entryTargetFieldWidth!
                entryTargetFieldTypeId! >= 0 -> if {
                    context.types[entryTargetFieldTypeId!] => entryTargetFieldSemanticType
                    entryTargetFieldSemanticType.origin == 1 -> if {
                        entryTargetFieldSemanticType.symbol -> integerWidth(context, state) => entryTargetFieldWidth!
                        entryTargetFieldSemanticType.symbol == 12 or entryTargetFieldSemanticType.symbol == 13
                            -> if { context.pointerBitWidth => entryTargetFieldWidth! }
                    }
                }
                (entrySourceFieldWidth > 0 and entryTargetFieldWidth! > 0 and entrySourceFieldWidth != entryTargetFieldWidth! and entryEmittedFieldValue.kind != 3 and entryEmittedFieldValue.kind != 4) => castEntryStructField
                castEntryStructField -> if {
                    "  %v$(entryExpressionIndex)_field$(entryFieldPosition!)_cast = " -> print
                    entryTargetFieldWidth! < entrySourceFieldWidth
                        -> if { "trunc " -> print } else {
                            entryEmittedFieldValue -> integerNodeSigned(context, state)
                                -> if { "sext " -> print } else { "zext " -> print }
                        }
                    entryEmittedFieldValue -> writeIrType(context, state)
                    " %v$(entryEmittedFieldIndex) to " -> print
                    entryTargetFieldTypeId! -> writeSemanticTypeId(context, state)
                    "" -> println
                }
                entryExpressionIndex -> aggregateFieldCopiesFixedStorage(entryEmittedFieldIndex, entryFieldPosition!, context, state) => copyEntryFixedField
                false => copyEntryFixedStructField!
                false => copyEntryFixedArrayField!
                copyEntryFixedField and entryTargetFieldTypeId! >= 0
                    -> if {
                        entryTargetFieldTypeId! -> directCopyableFixedStructType(context)
                            -> if {
                                true => copyEntryFixedStructField!
                                "%v$(entryExpressionIndex)_field$(entryFieldPosition!)_struct_copy" -> emitCopyableFixedStructValue("%v$(entryEmittedFieldIndex)", entryTargetFieldTypeId!, context, state)
                            } else {
                                true => copyEntryFixedArrayField!
                                "  %v$(entryExpressionIndex)_field$(entryFieldPosition!)_source = extractvalue %sollang.int_slice %v$(entryEmittedFieldIndex), 0" -> println
                                "  %v$(entryExpressionIndex)_field$(entryFieldPosition!)_length = extractvalue %sollang.int_slice %v$(entryEmittedFieldIndex), 1" -> println
                                context.typeSizes[entryTargetFieldTypeId!] => entryFieldAllocationBytes!
                                entryFieldAllocationBytes! == 0 -> if {
                                    context.typeSizes[context.types[entryTargetFieldTypeId!].first] => entryFieldAllocationBytes!
                                }
                                "  %v$(entryExpressionIndex)_field$(entryFieldPosition!)_owned = call ptr @sollang_alloc(i64 $(entryFieldAllocationBytes!))" -> println
                                "  call void @llvm.memcpy.p0.p0.i64(ptr %v$(entryExpressionIndex)_field$(entryFieldPosition!)_owned, ptr %v$(entryExpressionIndex)_field$(entryFieldPosition!)_source, i64 $(context.typeSizes[entryTargetFieldTypeId!]), i1 false)" -> println
                                "  %v$(entryExpressionIndex)_field$(entryFieldPosition!)_copy0 = insertvalue %sollang.int_slice poison, ptr %v$(entryExpressionIndex)_field$(entryFieldPosition!)_owned, 0" -> println
                                "  %v$(entryExpressionIndex)_field$(entryFieldPosition!)_copy = insertvalue %sollang.int_slice %v$(entryExpressionIndex)_field$(entryFieldPosition!)_copy0, i64 %v$(entryExpressionIndex)_field$(entryFieldPosition!)_length, 1" -> println
                            }
                    }
                entryTargetFieldTypeId! >= 0 and context.types[entryTargetFieldTypeId!].kind == 12 => entryBoundedField
                entryBoundedField -> if {
                    "v$(entryExpressionIndex)_field$(entryFieldPosition!)_bounded" -> emitBoundedArrayValue(entryEmittedFieldIndex, functionIndex, entryTargetFieldTypeId!, context, state)
                }
                "  " -> print
                entryFieldValue.nextOperand < 0 -> if { "%v$(entryExpressionIndex)" -> print } else { "%v$(entryExpressionIndex)_f$(entryFieldPosition!)" -> print }
                " = insertvalue " -> print
                entryExpression -> writeIrType(context, state)
                " " -> print
                entryFieldPosition! == 0 -> if { "poison" -> print } else {
                    "%v$(entryExpressionIndex)_f" -> print
                    entryFieldPosition! - 1 -> writeDecimal
                }
                ", " -> print
                entryTargetFieldTypeId! >= 0 -> if { entryTargetFieldTypeId! -> writeAggregateFieldTypeId(context, state) } else { entryEmittedFieldValue -> writeIrType(context, state) }
                " " -> print
                entryBoundedField -> if { "%v$(entryExpressionIndex)_field$(entryFieldPosition!)_bounded" -> print } else { copyEntryFixedStructField! -> if {
                        "%v$(entryExpressionIndex)_field$(entryFieldPosition!)_struct_copy" -> print
                    } else { copyEntryFixedArrayField! -> if {
                            "%v$(entryExpressionIndex)_field$(entryFieldPosition!)_copy" -> print
                        } else {                 entryEmittedFieldValue.kind == 2
                                -> if {
                                    entryEmittedFieldValue -> sourceToken(context, state) => entryFieldTextToken
                                    Int(TextLiteralRequest { sourceModule: entryEmittedFieldValue.sourceModule, token: entryFieldTextToken } -> textLiteralLength(context, state)) => entryFieldTextLength
                                    "{ ptr @sollang_str_$(entryEmittedFieldIndex), i64 $entryFieldTextLength }" -> print
                                } else {
                                    entryEmittedFieldValue.kind == 3 or entryEmittedFieldValue.kind == 4
                                        -> if {
                                            entryEmittedFieldValue -> sourceToken(context, state) => entryFieldToken
                                            entryEmittedFieldValue.kind == 3 -> if {
                                                entryEmittedFieldValue -> writeIntegerLiteral(context, state)
                                            } else {
                                                (context.sources[entryEmittedFieldValue.sourceModule] -> byte(entryFieldToken.span.start)) == 116
                                                    -> if { "1" -> print } else { "0" -> print }
                                            }
                                        } else {
                                            castEntryStructField -> if { "%v$(entryExpressionIndex)_field$(entryFieldPosition!)_cast" -> print } else { "%v$(entryEmittedFieldIndex)" -> print }
                                        }
                                }
                    } }
                }
                ", $(entryFieldPosition!)" -> println
                entryFieldValue.nextOperand => entryFieldValueIndex!
                entryFieldPosition! + 1 => entryFieldPosition!
            }
            entryExpressionIndex -> emitCompletedPatternBindingTransferMarks(context, state)
        }
    entryExpression.kind == 31 -> if { entryExpressionIndex -> emitRangeValue(functionIndex, context, state) }
    entryExpression.kind == 13 -> if {
        context.ir[entryExpression.operand0] => entrySyntheticProductBase
        entrySyntheticProductBase.typeKind == 10 and entrySyntheticProductBase.typeId >= (context.types -> len) and entryExpression.symbol >= 0
            -> if {
                "  " -> print
                entryExpressionIndex -> writeMemberStorageValueName(context, state)
                " = extractvalue %sollang.product.t$(entrySyntheticProductBase.typeId) %v$(entryExpression.operand0), $(entryExpression.symbol)" -> println
            } else {
                entryExpressionIndex -> canonicalMemberPathAvailable(context, state)
                    -> if {
                        context.ir[entryExpression.operand0] => entryCanonicalMemberBase
                        entryExpression -> sourceNode(context, state) => entryCanonicalMemberAst
                        entryCanonicalMemberBase -> sourceNode(context, state) => entryCanonicalMemberBaseAst
                        entryCanonicalMemberBaseAst.start + entryCanonicalMemberBaseAst.length => entryCanonicalMemberBaseEnd
                        entryCanonicalMemberAst.firstToken => entryCanonicalMemberTokenIndex!
                        true => entryCanonicalBeforeMemberBaseEnd!
                        entryCanonicalBeforeMemberBaseEnd! and entryCanonicalMemberTokenIndex! < entryCanonicalMemberAst.firstToken + entryCanonicalMemberAst.tokenCount
                            -> while {
                                context.tokens[context.ranges[entryExpression.sourceModule].tokenStart + entryCanonicalMemberTokenIndex!].span.start < entryCanonicalMemberBaseEnd
                                    -> if {
                                        entryCanonicalMemberTokenIndex! + 1 => entryCanonicalMemberTokenIndex!
                                    } else { false => entryCanonicalBeforeMemberBaseEnd! }
                            }
                        entryCanonicalMemberTokenIndex! => entryCanonicalMemberPathStart
                        0 => entryCanonicalMemberCount!
                        entryCanonicalMemberTokenIndex! < entryCanonicalMemberAst.firstToken + entryCanonicalMemberAst.tokenCount
                            -> while {
                                context.tokens[context.ranges[entryExpression.sourceModule].tokenStart + entryCanonicalMemberTokenIndex!].kind == grammar.tokenIdIdentifier()
                                    -> if {
                                        entryCanonicalMemberCount! + 1 => entryCanonicalMemberCount!
                                    }
                                entryCanonicalMemberTokenIndex! + 1 => entryCanonicalMemberTokenIndex!
                            }
                        entryCanonicalMemberBase.typeId => entryCanonicalMemberOwnerType!
                        0 => entryCanonicalMemberOrdinal!
                        entryCanonicalMemberPathStart => entryCanonicalMemberTokenIndex!
                        entryCanonicalMemberTokenIndex! < entryCanonicalMemberAst.firstToken + entryCanonicalMemberAst.tokenCount
                            -> while {
                                context.tokens[context.ranges[entryExpression.sourceModule].tokenStart + entryCanonicalMemberTokenIndex!].kind == grammar.tokenIdIdentifier()
                                    -> if {
                                        false => entryCanonicalMemberReference!
                                        context.types[entryCanonicalMemberOwnerType!].kind == 8 or context.types[entryCanonicalMemberOwnerType!].kind == 6
                                            -> if {
                                                context.types[entryCanonicalMemberOwnerType!].first => entryCanonicalMemberOwnerType!
                                                true => entryCanonicalMemberReference!
                                            }
                                        entryCanonicalMemberOrdinal! == entryCanonicalMemberCount! - 1
                                            -> if {
                                                entryCanonicalMemberOwnerType! -> canonicalMemberFieldOrdinalIndex(entryExpression.symbol, context)
                                            } else {
                                                entryCanonicalMemberOwnerType! -> canonicalMemberFieldIndex(entryExpression.sourceModule, entryCanonicalMemberTokenIndex!, context)
                                            } => entryCanonicalMemberResolvedField
                                        context.fields[entryCanonicalMemberResolvedField] => entryCanonicalMemberField
                                        "  " -> print
                                        entryCanonicalMemberOrdinal! == entryCanonicalMemberCount! - 1
                                            -> if { entryExpressionIndex -> writeMemberStorageValueName(context, state) } else { "%v$(entryExpressionIndex)_m$(entryCanonicalMemberOrdinal!)" -> print }
                                        entryCanonicalMemberReference! -> if {
                                            "_address = getelementptr inbounds " -> print
                                            entryCanonicalMemberOwnerType! -> writeSemanticTypeId(context, state)
                                            ", ptr " -> print
                                            entryCanonicalMemberOrdinal! == 0 -> if {
                                                entryExpression.operand0 -> isLocalReadonlyReferenceName(functionIndex, context, state)
                                                    -> if { functionIndex -> writeForwardedReferenceValue(entryExpression.operand0, context, state) } else {
                                                        "%v$(entryExpression.operand0)" -> print
                                                    }
                                            } else { "%v$(entryExpressionIndex)_m$(entryCanonicalMemberOrdinal! - 1)" -> print }
                                            ", i32 0, i32 $(entryCanonicalMemberField.ordinal)" -> println
                                            "  " -> print
                                            entryCanonicalMemberOrdinal! == entryCanonicalMemberCount! - 1
                                                -> if { entryExpressionIndex -> writeMemberStorageValueName(context, state) } else { "%v$(entryExpressionIndex)_m$(entryCanonicalMemberOrdinal!)" -> print }
                                            " = load " -> print
                                            entryCanonicalMemberField.fieldType -> writeSemanticTypeId(context, state)
                                            ", ptr " -> print
                                            entryCanonicalMemberOrdinal! == entryCanonicalMemberCount! - 1
                                                -> if { entryExpressionIndex -> writeMemberStorageValueName(context, state) } else { "%v$(entryExpressionIndex)_m$(entryCanonicalMemberOrdinal!)" -> print }
                                            "_address, align $(context.typeAligns[entryCanonicalMemberField.fieldType])" -> println
                                        } else {
                                            context.types[entryCanonicalMemberField.fieldType] => entryCanonicalMemberFieldType
                                            " = extractvalue " -> print
                                            entryCanonicalMemberOwnerType! -> writeSemanticTypeId(context, state)
                                            " " -> print
                                            entryCanonicalMemberOrdinal! == 0 -> if { "%v$(entryExpression.operand0)" -> print } else { "%v$(entryExpressionIndex)_m$(entryCanonicalMemberOrdinal! - 1)" -> print }
                                            ", $(entryCanonicalMemberField.ordinal)" -> println
                                        }
                                        entryCanonicalMemberField.fieldType => entryCanonicalMemberOwnerType!
                                        entryCanonicalMemberOrdinal! + 1 => entryCanonicalMemberOrdinal!
                                    }
                                entryCanonicalMemberTokenIndex! + 1 => entryCanonicalMemberTokenIndex!
                            }
                    } else {
                        entryExpression -> isArgumentsType -> unless {
                            context.ir[entryExpression.operand0] => entryMemberBase
                            entryMemberBase.typeOrigin => entryMemberCurrentOrigin!
                            entryMemberBase.typeModule => entryMemberCurrentModule!
                            entryMemberBase.typeSymbol => entryMemberCurrentSymbol!
                            entryExpression -> sourceNode(context, state) => entryMemberAst
                            entryMemberBase -> sourceNode(context, state) => entryMemberBaseAst
                            entryMemberBaseAst.start + entryMemberBaseAst.length => entryMemberBaseEnd
                            1 => entryMemberIdentifierCount!
                            entryMemberAst.firstToken => entryMemberTokenIndex!
                            true => entryBeforeMemberBaseEnd!
                            entryBeforeMemberBaseEnd! and entryMemberTokenIndex! < entryMemberAst.firstToken + entryMemberAst.tokenCount
                                -> while {
                                    context.tokens[context.ranges[entryExpression.sourceModule].tokenStart + entryMemberTokenIndex!].span.start < entryMemberBaseEnd
                                        -> if {
                                            entryMemberTokenIndex! + 1 => entryMemberTokenIndex!
                                        } else { false => entryBeforeMemberBaseEnd! }
                                }
                            entryMemberTokenIndex! => entryMemberPathTokenStart
                            entryMemberTokenIndex! < entryMemberAst.firstToken + entryMemberAst.tokenCount
                                -> while {
                                    context.tokens[context.ranges[entryExpression.sourceModule].tokenStart + entryMemberTokenIndex!].kind == grammar.tokenIdIdentifier()
                                        -> if { entryMemberIdentifierCount! + 1 => entryMemberIdentifierCount! }
                                    entryMemberTokenIndex! + 1 => entryMemberTokenIndex!
                                }
                            1 => entryMemberIdentifierOrdinal!
                            0 => entryMemberProjectionOrdinal!
                            entryMemberPathTokenStart => entryMemberTokenIndex!
                            entryMemberTokenIndex! < entryMemberAst.firstToken + entryMemberAst.tokenCount
                                -> while {
                                    context.tokens[context.ranges[entryExpression.sourceModule].tokenStart + entryMemberTokenIndex!].kind == grammar.tokenIdIdentifier()
                                        -> if {
                                            entryMemberIdentifierOrdinal! > 0 -> if {
                                                entryMemberCurrentModule! => entryMemberOwnerSourceModule!
                                                entryMemberCurrentOrigin! == 2 -> if { context.modules[entryMemberCurrentModule!].sourceIndex => entryMemberOwnerSourceModule! }
                                                context.ranges[entryMemberOwnerSourceModule!] => entryMemberOwnerRange
                                                -1 => entryMemberFieldOrdinal!
                                                0 => entryMemberCandidateFieldOrdinal!
                                                0 => entryMemberFieldSearch!
                                                entryMemberFieldSearch! < entryMemberOwnerRange.symbolCount
                                                    -> while {
                                                        context.symbols[entryMemberOwnerRange.symbolStart + entryMemberFieldSearch!] => entryMemberField
                                                        entryMemberField.kind == 26 and entryMemberField.parent == entryMemberCurrentSymbol!
                                                            -> if {
                                                                context.tokens[context.ranges[entryExpression.sourceModule].tokenStart + entryMemberTokenIndex!] => entryMemberName
                                                                context.tokens[entryMemberOwnerRange.tokenStart + entryMemberField.nameToken] => entryMemberFieldName
                                                                entryMemberName.span.length == entryMemberFieldName.span.length => entryMemberEqual!
                                                                UIntSize(0) => entryMemberFieldNameByte!
                                                                entryMemberEqual! and entryMemberFieldNameByte! < entryMemberName.span.length
                                                                    -> while {
                                                                        context.sources[entryExpression.sourceModule] -> byte(entryMemberName.span.start + entryMemberFieldNameByte!) => entryMemberByte
                                                                        context.sources[entryMemberOwnerSourceModule!] -> byte(entryMemberFieldName.span.start + entryMemberFieldNameByte!) => entryMemberFieldByte
                                                                        entryMemberByte != entryMemberFieldByte -> if { false => entryMemberEqual! }
                                                                        entryMemberFieldNameByte! + 1 => entryMemberFieldNameByte!
                                                                    }
                                                                entryMemberEqual! -> if {
                                                                    entryMemberCandidateFieldOrdinal! => entryMemberFieldOrdinal!
                                                                    -1 => entryMemberFieldTypeIndex!
                                                                    0 => entryMemberFieldTypeSearch!
                                                                    entryMemberFieldTypeSearch! < (context.nominal -> len)
                                                                        -> while {
                                                                            context.nominal[entryMemberFieldTypeSearch!].sourceModule == entryMemberOwnerSourceModule! and context.nominal[entryMemberFieldTypeSearch!].typeAst == entryMemberField.typeNode
                                                                                -> if { entryMemberFieldTypeSearch! => entryMemberFieldTypeIndex! }
                                                                            entryMemberFieldTypeSearch! + 1 => entryMemberFieldTypeSearch!
                                                                        }
                                                                    -1 => entryMemberNextOrigin!
                                                                    -1 => entryMemberNextModule!
                                                                    -1 => entryMemberNextSymbol!
                                                                    entryMemberFieldTypeIndex! >= 0 -> if {
                                                                        context.nominal[entryMemberFieldTypeIndex!] => entryMemberFieldType
                                                                        entryMemberFieldType.origin => entryMemberNextOrigin!
                                                                        entryMemberFieldType.targetModule => entryMemberNextModule!
                                                                        entryMemberFieldType.targetSymbol => entryMemberNextSymbol!
                                                                    } else {
                                                                        0 => entryMemberCompositeSearch!
                                                                        entryMemberCompositeSearch! < (context.composite -> len)
                                                                            -> while {
                                                                                context.composite[entryMemberCompositeSearch!] => entryMemberCompositeType
                                                                                entryMemberCompositeType.sourceModule == entryMemberOwnerSourceModule! and entryMemberCompositeType.typeAst == entryMemberField.typeNode
                                                                                    -> if {
                                                                                        10 + entryMemberCompositeType.kind => entryMemberNextOrigin!
                                                                                        entryMemberCompositeType.kind == 5 -> if {
                                                                                            entryMemberCompositeType.keySymbol => entryMemberNextModule!
                                                                                            entryMemberCompositeType.valueSymbol => entryMemberNextSymbol!
                                                                                        } else {
                                                                                            entryMemberCompositeType.elementModule => entryMemberNextModule!
                                                                                            entryMemberCompositeType.elementSymbol => entryMemberNextSymbol!
                                                                                        }
                                                                                    }
                                                                                entryMemberCompositeSearch! + 1 => entryMemberCompositeSearch!
                                                                            }
                                                                    }
                                                                    "  " -> print
                                                                    entryMemberIdentifierOrdinal! == entryMemberIdentifierCount! - 1
                                                                        -> if { entryExpressionIndex -> writeMemberStorageValueName(context, state) } else { "%v$(entryExpressionIndex)_m$(entryMemberProjectionOrdinal!)" -> print }
                                                                    " = extractvalue %sollang.struct.m$(entryMemberOwnerSourceModule!)_s$(entryMemberCurrentSymbol!) " -> print
                                                                    entryMemberProjectionOrdinal! == 0 -> if { "%v$(entryExpression.operand0)" -> print } else {
                                                                        "%v$(entryExpressionIndex)_m" -> print
                                                                        entryMemberProjectionOrdinal! - 1 -> writeDecimal
                                                                    }
                                                                    ", " -> print
                                                                    entryMemberFieldOrdinal! -> writeDecimalLine
                                                                    entryMemberNextOrigin! => entryMemberCurrentOrigin!
                                                                    entryMemberNextModule! => entryMemberCurrentModule!
                                                                    entryMemberNextSymbol! => entryMemberCurrentSymbol!
                                                                    entryMemberProjectionOrdinal! + 1 => entryMemberProjectionOrdinal!
                                                                }
                                                                entryMemberCandidateFieldOrdinal! + 1 => entryMemberCandidateFieldOrdinal!
                                                            }
                                                        entryMemberFieldSearch! + 1 => entryMemberFieldSearch!
                                                    }
                                            }
                                            entryMemberIdentifierOrdinal! + 1 => entryMemberIdentifierOrdinal!
                                        }
                                    entryMemberTokenIndex! + 1 => entryMemberTokenIndex!
                                }
                        }
                    }
            }
        entryExpressionIndex -> bindingFixedStorageCopyTypeId(context) => bindingCopyTypeId
        bindingCopyTypeId >= 0 -> if {
            "%v$(entryExpressionIndex)_binding_copy" -> emitCopyableFixedStorageValue("%v$(entryExpressionIndex)", bindingCopyTypeId, context, state)
        }
        context.ir[entryExpressionIndex] -> boundedArrayValueTypeId(context, state) => boundedMemberTypeId
        boundedMemberTypeId >= 0 -> if {
            "v$(entryExpressionIndex)" -> emitBoundedArrayHandle("%v$(entryExpressionIndex)_bounded_value", boundedMemberTypeId, context, state)
        }
    }
}

emitEntryValueExpression entryExpressionIndex: Int, functionIndex: Int, entryEnd: Int, entryPointerAlignment: Int, entryOrder: ref [Int; ~], entryActiveEach: mut [Int; ~], activeEachSize: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int uses Console, Process {
    context.ir[entryExpressionIndex] => entryExpression
    entryExpressionIndex -> emitAsyncIntRoleReads(context, state)
    entryExpressionIndex -> emitNamedBindingOwnershipInitialization(state)
    entryExpression.kind == 9 and (entryExpression.opcode == -306 or entryExpression.opcode == -307) and entryExpression.operand0 >= 0
        -> if { entryExpressionIndex -> emitMappedBytesExpression(functionIndex, context, state) }
    entryExpression -> isMappedBytesFlush(context)
        -> if { entryExpressionIndex -> emitMappedBytesFlush(functionIndex, context, state) }
    context.ir[functionIndex] => function
    activeEachSize => entryActiveEachSize!
    entryExpressionIndex -> emitArgumentsIntrinsic(context)
    entryExpression.kind == 5 and entryExpression.operand0 < 0 and function.kind == 0
        and function.operand1 >= 0 and entryExpression.symbol == context.ir[function.operand1].symbol
        and (entryExpressionIndex -> bindingFixedStorageCopyTypeId(context)) < 0
        and (entryExpression -> referenceValueTypeId(context, state)) < 0
        and (entryExpressionIndex -> mutableBorrowParameterOrdinal(functionIndex, context, state)) < 0
        -> if {
            "  %v$(entryExpressionIndex) = freeze " -> print
            entryExpression -> writeIrType(context, state)
            " %arg" -> println
        }
    entryExpressionIndex -> streamIr.resolveProducer(context.ir) => streamValueProducer
    entryExpression.kind == 5
        and (streamValueProducer -> plannedStreamStage(context, state)) < 0
        -> if { entryExpressionIndex -> emitNamedPlaceRead(functionIndex, context, state) }
    entryExpressionIndex -> emitDynExpression(functionIndex, context, state)
    entryExpression.kind == 9 and entryExpression.opcode == -226 and entryExpression.operand0 >= 0
        -> if {
            entryExpressionIndex -> staticTraitMethodSymbol(context, state) => entryStaticTraitMethod
            entryStaticTraitMethod >= 0 -> if {
                context.ir[entryExpression.operand0] => entryStaticTraitReceiver
                "  %v$(entryExpressionIndex) = call " -> print
                entryExpression -> writeIrType(context, state)
                " @sollang_m$(entryStaticTraitReceiver.typeModule)_s$(entryStaticTraitMethod)(" -> print
                entryStaticTraitReceiver -> writeIrType(context, state)
                " " -> print
                entryExpression.operand0 -> writeValue(functionIndex, context, state)
                ")" -> println
            }
        }
    (entryExpression.kind == 9 or entryExpression.kind == 6) and entryExpression.opcode == -201 and entryExpression.operand0 >= 0
        -> if {
            entryExpressionIndex -> emitLengthIntrinsic(functionIndex, context, state)
        }
    entryExpression.kind == 9 and entryExpression.opcode <= -241 and entryExpression.opcode >= -245 and entryExpression.operand0 >= 0
        -> if {
            entryExpressionIndex -> emitBitSetIntrinsic(functionIndex, context, state)
        }
