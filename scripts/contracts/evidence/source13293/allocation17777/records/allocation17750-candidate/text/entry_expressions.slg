                        -> if {
                            context.pointerBitWidth / 8 => entryDictionaryValueStorageSize!
                            context.pointerBitWidth / 8 => entryDictionaryValueStorageAlign!
                        }
                }
            entryDictionaryKeyStorageSize! -> dictionaryEntryLayout(entryDictionaryKeyStorageAlign!, entryDictionaryValueStorageSize!, entryDictionaryValueStorageAlign!) => entryDictionaryEntryLayout
            entryDictionaryCapacity == 0 -> if {
                "  %v$(entryExpressionIndex)_storage = getelementptr i8, ptr null, i64 0" -> println
