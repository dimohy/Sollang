                            }
                        }
                }
            entryExpression.operand0 => entryArrayElementIndex!
            0 => entryArrayElementPosition!
            entryArrayElementIndex! >= 0 and entryArrayElementPosition! < entryArrayLength!
                -> while {
                    context.ir[entryArrayElementIndex!] => entryArrayElement
                    ArrayStorageIdentity { resultDomain: 0, resultIndex: entryExpressionIndex, labelIndex: -1 }
                        -> emitArrayValueElementStore(entryArrayElementPosition!, entryExpression -> arrayElementTypeId(context, state), entryExpression.typeSymbol, entryArrayElementIndex!, functionIndex, context, state)
