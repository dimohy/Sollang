            -1 => entryPathBytesType!
            -1 => entryPathStyleType!
            0 => entryPathFieldIndex!
            entryPathFieldIndex! < (context.fields -> len)
                -> while {
                    context.fields[entryPathFieldIndex!] => entryPathField
                    entryPathField.ownerType == entryPathType! -> if {
