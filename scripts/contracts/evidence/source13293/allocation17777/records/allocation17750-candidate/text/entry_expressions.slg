            "  %v$(entryExpressionIndex)_path_text = insertvalue %sollang.text %v$(entryExpressionIndex)_path_text0, i64 %v$(entryExpressionIndex)_path_length, 1" -> println
            entryExpression.opcode == -230 -> if {
