            "  %v$(entryExpressionIndex)_value0 = insertvalue %sollang.source_text poison, ptr %v$(entryExpressionIndex)_data, 0" -> println
            "  %v$(entryExpressionIndex)_value1 = insertvalue %sollang.source_text %v$(entryExpressionIndex)_value0, i64 %v$(entryExpressionIndex)_length, 1" -> println
            "  %v$(entryExpressionIndex)_value2 = insertvalue %sollang.source_text %v$(entryExpressionIndex)_value1, ptr null, 2" -> println
