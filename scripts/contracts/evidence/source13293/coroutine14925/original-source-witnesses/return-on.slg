import std.async.diagnostics as diagnostics

child: -> async Int {
    yield
    7
}

relay: -> async Int {
    child() => pending
    pending -> await -> return
}

main {
    diagnostics.startDiagnosticSession(diagnostics.DiagnosticLimits { maximumTrackedTasks: 1 }) -> when {
        Ok(session) { session -> close => closed }
        Err(error) { }
    }
    relay() => task
    task -> await => value
    "$value" -> println
}
