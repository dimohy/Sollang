namespace sollang.compiler.llvm.codegen_cache_key_policy

public memberOriginal: -> KeyRule {
    [KeyPart; ~] => parts!
    parts! -> push(KeyPart.MemberName)
    parts! -> push(KeyPart.MemberType)
    KeyRule {
        domain: "original"
        parts: parts!
    }
}

public memberReordered: -> KeyRule {
    [KeyPart; ~] => parts!
    parts! -> push(KeyPart.MemberType)
    parts! -> push(KeyPart.MemberName)
    KeyRule {
        domain: "original"
        parts: parts!
    }
}

public memberRelabeled: -> KeyRule {
    [KeyPart; ~] => parts!
    parts! -> push(KeyPart.MemberName)
    parts! -> push(KeyPart.MemberType)
    KeyRule {
        domain: "changed-diagnostic-label"
        parts: parts!
    }
}

public memberUnavailable: -> KeyRule {
    [KeyPart; ~] => parts!
    parts! -> push(KeyPart.Identity)
    KeyRule {
        domain: "unavailable"
        parts: parts!
    }
}
