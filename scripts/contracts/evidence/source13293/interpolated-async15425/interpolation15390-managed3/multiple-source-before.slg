namespace probes.async_task_observability.multiple_interpolated_awaits

child: -> async Int {
    yield
    7
}

format<T>: -> async Unit uses Console {
    child() => first
    child() => second
    "한글😀 $(first -> await) / $(second -> await)" -> println
}

main {
    probes.async_task_observability.multiple_interpolated_awaits.format<Int>() -> await
    probes.async_task_observability.multiple_interpolated_awaits.format<Bool>() -> await
}
