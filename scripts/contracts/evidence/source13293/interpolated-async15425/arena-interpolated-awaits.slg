namespace probes.async_task_observability.arena_interpolated_awaits

child: -> async Int {
    yield
    7
}

format<T>: -> async Unit uses Console {
    Arena(64) => owner!
    child() => first
    child() => second
    "한글😀 $(first -> await) / $(second -> await)" -> materialize(owner!) => rendered
    rendered -> println
}

main {
    probes.async_task_observability.arena_interpolated_awaits.format<Int>() => firstTask
    firstTask -> await
    probes.async_task_observability.arena_interpolated_awaits.format<Bool>() => secondTask
    secondTask -> await
}
