namespace cache.prepared_registry

struct Used { value: Int }
struct Empty { }
struct Other { flag: Bool }
enum Unused { First, Second }
trait Value { get: self -> Int }
public inspect value: ref Used, boxed: box Int, fixed: [Int; 3], growable: [Int; ~], mapped: {Int: Bool}, dynamic: dyn Value -> Unit { }
main { }

struct More {
    optional: Option<Used>
    result: Result<Used, Unused>
    task: Task<Int>
    stream: Stream<Int>
    events: EventStream<Int>
    set: Set<Int>
    queue: Deque<Int>
    heap: BinaryHeap<Int>
    fixed: [UInt8; 12]
    bounded: [Int; <=4]
    dictionary: {Text: UInt64}
    boundedDictionary: {Int: UInt8; <=2}
    bits: BitSet<65>
    labeled: (이름: Long, 𐐀: UInt8)
