import sys.file as file
struct View { source: ref file.SourceText }
run view: ref View -> (left: UIntSize, right: UIntSize) {
    view.source -> parallel branch {
        left: ref -> len
        right: ref -> len
    }
}
main {
    "abc" -> file.borrowText => source
    View { source: source } => view
    view -> run => result
    "$(result.left):$(result.right)" -> println
}
