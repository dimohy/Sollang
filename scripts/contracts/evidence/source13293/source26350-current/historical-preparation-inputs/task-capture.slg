produce value: Int -> async Int { value }
ignore value: ref Task<Int> -> Int => 1
run value: Int -> (left: Int, right: Int) {
    read input: Int -> Int => input + (pending -> ignore)
    1 -> produce => pending
    value -> parallel branch {
        left: -> read
        right: -> read
    }
}
main { 1 -> run => result }
