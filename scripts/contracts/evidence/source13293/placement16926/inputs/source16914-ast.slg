import sollang.compiler.ast as ast
import sollang.compiler.lexer as lexer

inspect name: Text, source: Text -> Unit uses Console {
    source -> ast.lower => nodes
    source -> lexer.lex => tokens
    "$name:" -> println
    0 => index!
    nodes -> each node {
        "$(index!)|$(node.kind)|$(node.parent)|$(node.flags)|$(node.start)|$(node.length)|" -> print
        node.payloadToken >= 0 -> if {
            tokens[node.payloadToken].span => span
            source -> slice(span.start, span.length) -> print
        }
        "" -> println
        index! + 1 => index!
    }
}

main {
    """
    main {
        [1; 1025] => values
    }
    """ => source0
    "oversized-fixed" -> inspect(source0)
    """
    main {
        [1, 2] => first
        [3; 4] => second
    }
    """ => source1
    "sequential-slot-growth" -> inspect(source1)
    """
    main {
        [1; 512] => first
        [2; 512] => second
        [3; 1] => third
        first[0] => firstValue
        second[0] => secondValue
    }
    """ => source2
    "source-lifetimes-consume-budget" -> inspect(source2)
    """
    main {
        [Int; ~] => values!
        1..3 -> each value {
            values! -> push(value)
        }
    }
    """ => source3
    "mutable-loop-owner-header" -> inspect(source3)
    """
    main {
        [1, 2; ~] => values
        values -> capacity => allocated
        values[0] => first
    }
    """ => source4
    "readonly-dynamic-capacity" -> inspect(source4)
    """
    main {
        { 1: 2 } => scores
        scores[1] => first
    }
    """ => source5
    "readonly-dictionary" -> inspect(source5)
    """
    main {
        [1, 2; ~] => values
        values -> append(3) => grown
        grown -> capacity => allocated
    }
    """ => source6
    "owning-transform-rejects-promotion" -> inspect(source6)
    """
    main {
        true -> if {
            [1, 2] => first
        } else {
            [3; 4] => second
        }
    }
    """ => source7
    "nested-branch-slot-reuse" -> inspect(source7)
    """
    local: -> Int {
        [1, 2] => values
        values[0]
    }
    main {
        local() => first
    }
    """ => source8
    "ordinary-function-frame" -> inspect(source8)
    """
    take values: move [Int; ~] -> Int {
        values -> len
    }
    main {
        [1, 2; ~] => values
        values -> take => count
    }
    """ => source9
    "owned-input-rejects-promotion" -> inspect(source9)
}
