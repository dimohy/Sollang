profileMark label: Text -> Unit uses Console {
    "context-stage $label" -> runtime.eprintln
}

profileResolvedSnapshot request: ref PrepareRequest, resolvedCallContext: move expressionTypeIds.ResolvedCallContext, libraries: move libraryImports.LibraryCatalog, libraryCalls: move [libraryImports.LibraryFunctionResolution; ~], unresolvedMutableNames: move [semanticDiagnostics.UnresolvedMutableNameDiagnostic; ~], signatureTypeDiagnostic: semanticDiagnostics.SignatureTypeDiagnostic -> emitterContext.EmitContext uses Console {
    request.pointerBitWidth => pointerBitWidth
    request.targetArchitecture => targetArchitecture
    request.cpuDispatchPolicy => cpuDispatchPolicy
    request.requiredCpuFeatures => requiredCpuFeatures
    request.allowedCpuFeatures => allowedCpuFeatures
    request.forbiddenCpuFeatures => forbiddenCpuFeatures
    request.supportsComputePool => supportsComputePool
    request.expectedPathStyle => expectedPathStyle
    resolvedCallContext.prepared => prepared
    resolvedCallContext.types => recursiveTypes!
    "active-bodies" -> profileMark
    prepared -> semanticDiagnostics.activeInterpolationBodies(recursiveTypes!) => activeInterpolationBodyByNode
    "inferred-input" -> profileMark
    prepared -> semanticDiagnostics.firstInferredInputConflict(recursiveTypes!) => inferredInputConflict
    signatureTypeDiagnostic => resolvedSignatureDiagnostic!
    resolvedSignatureDiagnostic!.code == 0 -> if {
        prepared -> semanticDiagnostics.firstInferredFunctionConsumerDiagnostic => resolvedSignatureDiagnostic!
    }
    "local-enums" -> profileMark
    prepared -> interpolationInference.uninvokedAssociatedMemberByNode(recursiveTypes!) => uninvokedAssociatedMemberByNode
    prepared -> interpolationInference.missingLocalAssociatedMemberByNode(recursiveTypes!, uninvokedAssociatedMemberByNode) => missingLocalAssociatedMemberByNode
    prepared -> interpolationInference.localEnumMemberDecisionByNode(recursiveTypes!.types, uninvokedAssociatedMemberByNode) => localEnumMemberDecisionByNode!
    recursiveTypes!.enumConstructorArguments -> each constructor {
        constructor.memberStatus > 0 and constructor.callNode >= 0
            -> if {
                interpolationInference.LocalEnumMemberDecision {
                    status: constructor.memberStatus, typeId: constructor.enumTypeId
                } => localEnumMemberDecisionByNode![constructor.callNode]
            }
    }
    localEnumMemberDecisionByNode! -> interpolationInference.commitLocalEnumMemberTypes(recursiveTypes!.interpolationMemberTypeByNode)
    "numeric-literal" -> profileMark
    prepared -> semanticDiagnostics.firstNumericCallLiteralDiagnostic(recursiveTypes!, pointerBitWidth) => numericCallLiteralDiagnostic!
    prepared.package -> semanticDiagnostics.consumedBindingReadsFromAst(prepared.declaredMoveReadByAst, recursiveTypes!.contextualRecordLabelByAst) => earlyConsumedBindingReads
    "pre-ir-flow" -> profileMark
    prepared -> interpolationInference.preIrFlowCallTargets(recursiveTypes!) => semanticInterpolationCallTargets
    prepared.package -> semanticDiagnostics.redundantNumericConversions(recursiveTypes!) => redundantNumericConversions
    prepared -> fixedLengthArrays.collect(recursiveTypes!, prepared.interpolations, prepared.interpolationRanges) => fixedLengthArrayWarnings
    prepared -> interpolationInference.callNumericWarningByNode(recursiveTypes!) => interpolationNumericWarningByNode
    prepared -> interpolationInference.callArgumentDiagnosticsByNode(recursiveTypes!, pointerBitWidth) => interpolationCallArgumentDiagnosticByNode
    prepared.package -> semanticDiagnostics.firstNumericCallArgumentDiagnostic(recursiveTypes!, prepared.standardLibrarySourceStart, prepared.standardLibrarySourceCount) => numericCallArgumentDiagnostic
    prepared -> semanticDiagnostics.firstCallArityDiagnostic(recursiveTypes!) => callArityDiagnostic
    prepared -> semanticDiagnostics.unsupportedNominalEnumFlowPaths => unsupportedNominalEnumFlowPaths
    prepared.package -> semanticDiagnostics.firstNominalFieldMismatch(recursiveTypes!) => nominalFieldMismatch
    "type-traits" -> profileMark
    typeIds.enumPayloadEdges(recursiveTypes!.types, recursiveTypes!.references, prepared.package.ranges, prepared.package.symbols, recursiveTypes!.referenceIndexByTypeAst) => semanticPayloadEdges
    prepared -> semanticContext.ownedResourceSeeds(recursiveTypes!.types) => semanticResourceSeeds
    typeIds.classifyWithResources(recursiveTypes!.types, recursiveTypes!.fields, semanticPayloadEdges, semanticResourceSeeds) => semanticPropagationTraits
    typeIds.ownedStorageByType(recursiveTypes!.types, recursiveTypes!.fields, semanticPayloadEdges, semanticResourceSeeds) => ownedStorageByType
    "binding-declarations" -> profileMark
    prepared -> semanticDiagnostics.firstBindingDeclarationDiagnostic(recursiveTypes!, semanticPropagationTraits, libraryCalls) => bindingDeclarationDiagnostic
    prepared -> semanticDiagnostics.firstCallOwnershipDiagnostic(recursiveTypes!, semanticPropagationTraits) => callOwnershipDiagnostic
    prepared -> semanticDiagnostics.firstDictionaryKeyDiagnostic(recursiveTypes!) => dictionaryKeyDiagnostic
    prepared -> semanticDiagnostics.firstOwnedIndexReadDiagnostic(recursiveTypes!, ownedStorageByType) => ownedIndexReadDiagnostic
    prepared.package -> semanticDiagnostics.firstDeclarationRootDiagnostic(bindingDeclarationDiagnostic, numericCallLiteralDiagnostic!, numericCallArgumentDiagnostic, nominalFieldMismatch, callOwnershipDiagnostic, dictionaryKeyDiagnostic, ownedIndexReadDiagnostic, callArityDiagnostic) => firstDeclarationRootDiagnostic
    "result-propagation" -> profileMark
    prepared -> interpolationInference.preIrResultPropagationDecisionByNode(recursiveTypes!, semanticPropagationTraits, semanticInterpolationCallTargets, pointerBitWidth) => preIrResultPropagationDecisions
    prepared -> interpolationInference.preIrDisplayTypeByNode(recursiveTypes!, semanticInterpolationCallTargets, preIrResultPropagationDecisions, pointerBitWidth) => preIrDisplayTypeByNode
    prepared -> semanticDiagnostics.missingEnumVariants(recursiveTypes!) => missingEnumVariants
    "lower-ir" -> profileMark
    prepared -> lowerPreparedIr(recursiveTypes!, supportsComputePool) => ir!
    "materialize-arrays-1" -> profileMark
    ir! -> typedIr.materializeContextualArrayOwners(prepared, recursiveTypes!)
    ir! -> typedLibraryImports.projectLibraries(prepared, libraries, libraryCalls) => libraryCallDiagnostics
    ir! -> typedIr.planResolvedGenericCalls(prepared, recursiveTypes!) => initialGenericCallPlans
    ir! -> typedIr.materializeGenericClosure(prepared, recursiveTypes!) => genericInstances!
    resolvedSignatureDiagnostic!.code == 0 -> if {
        prepared -> semanticDiagnostics.firstConcreteAsyncOwnedInputDiagnostic(recursiveTypes!, ir!, genericInstances!) => resolvedSignatureDiagnostic!
    }
    prepared -> semanticDiagnostics.firstFinalNumericLiteralDiagnostic(recursiveTypes!, ir!, genericInstances!, pointerBitWidth) => reifiedNumericDiagnostic
    reifiedNumericDiagnostic.code > 0 -> if {
        numericCallLiteralDiagnostic!.code == 0 or reifiedNumericDiagnostic.sourceModule < numericCallLiteralDiagnostic!.sourceModule
            or (reifiedNumericDiagnostic.sourceModule == numericCallLiteralDiagnostic!.sourceModule and reifiedNumericDiagnostic.locationAst < numericCallLiteralDiagnostic!.locationAst)
            -> if { reifiedNumericDiagnostic => numericCallLiteralDiagnostic! }
    }
    ir! -> typedIr.materializeUserBlockCallbacks(prepared, recursiveTypes!, genericInstances!) => blockInstances
    # Block-specific instances replace generic bodies that have no caller block.
    # Keep unrelated generic call bindings and all original source identities.
    0 => genericBlockIndex!
    genericBlockIndex! < (genericInstances! -> len)
        -> while {
            genericInstances![genericBlockIndex!] => genericInstance!
            genericInstance!.callNode >= 0 -> if {
                ir![genericInstance!.callNode] => genericCall
                genericCall.targetModule >= 0 and genericCall.symbol >= 0
                    -> if {
                        prepared.package.ranges[genericCall.targetModule] => genericRange
                        prepared.package.symbols[genericRange.symbolStart + genericCall.symbol] => genericDeclaration
                        genericDeclaration.blockTypeNode >= 0 and genericDeclaration.flags / 64 % 2 == 0
                            -> if {
                                3 => genericInstance!.status
                                genericInstance! => genericInstances![genericBlockIndex!]
                            }
                    }
            }
            genericBlockIndex! + 1 => genericBlockIndex!
        }
    ir! -> typedIr.materializeUserBlockScopes(blockInstances) => scopedBlockInstances
    scopedBlockInstances -> each instance { genericInstances! -> push(instance) }
    "materialize-arrays-2" -> profileMark
    ir! -> typedIr.materializeContextualArrayOwners(prepared, recursiveTypes!)
    # Imported async methods acquire their final call identity after the
    # initial IR lowering. Give direct await flows the same value edge here.
    ir! -> typedIr.repairDiscardedDirectAsyncAwaits(prepared)
    ir! -> typedIr.repairDirectAsyncAwaitConsumers(prepared)
    ir! -> typedIr.sealCanonicalTaskAwaitTypes(prepared, recursiveTypes!)
    ir! -> typedIr.sealDeclaredRuntimeCalls(prepared)
    ir! -> typedIr.sealMaterializedTaskProducts(prepared, recursiveTypes!) => taskProductsChanged
    taskProductsChanged -> if {
        ir! -> typedIr.sealCanonicalTaskAwaitTypes(prepared, recursiveTypes!)
    }
    ir! -> typedIr.sealDirectAwaitFunctionOrder => awaitRelocation
    initialGenericCallPlans -> typedIr.relocateAwaitGenericPlans(awaitRelocation) => awaitGenericCallPlans
    awaitRelocation -> typedIr.relocateAwaitGenericInstances(ir!, genericInstances!)
    ir! -> typedIr.sealAsyncExpressionValues(prepared) => expressionRelocation
    awaitGenericCallPlans -> typedIr.relocateAwaitGenericPlans(expressionRelocation) => genericCallPlans
    expressionRelocation -> typedIr.relocateAwaitGenericInstances(ir!, genericInstances!)
    "generic-bodies" -> profileMark
    ir! -> typedIr.bindGenericBodies(genericInstances!, prepared.interpolations -> len) => genericBodies
    ir! -> typedIr.sealLateResolvedCallNumericArguments(prepared)
    "operand-diagnostics" -> profileMark
    prepared.package -> semanticDiagnostics.firstExpressionOperandDiagnostic(prepared, recursiveTypes!, ir!, unresolvedMutableNames, pointerBitWidth) => sourceOperandDiagnostic
    "mutable-rebind" -> profileMark
    prepared -> semanticDiagnostics.firstMutableRebindDiagnostic(recursiveTypes!, sourceOperandDiagnostic, genericCallPlans, ir!) => expressionOperandDiagnostic
    # Semantic preparation commits the await source before Typed IR lowering.
    [Bool; ~] => awaitSourceByAst!
    prepared.awaitSourceByAst -> each source { awaitSourceByAst! -> push(source) }
    # Call discovery precedes final receiver typing. Build one compact global
    # AST index after generic closure convergence so every later diagnostic is O(1)
    # instead of rescanning the full IR for each preliminary call entry.
    [Bool; ~] => finalCallResolvedByAst!
    0 => finalCallAstInit!
    finalCallAstInit! < (prepared.package.nodes -> len)
        -> while {
            finalCallResolvedByAst! -> push(false)
            finalCallAstInit! + 1 => finalCallAstInit!
        }
    0 => finalCallIrIndex!
    finalCallIrIndex! < (ir! -> len)
        -> while {
            ir![finalCallIrIndex!] => finalCall
            (finalCall.kind == 6 or (finalCall.kind == 9 and finalCall.opcode != -1))
                and finalCall.sourceModule >= 0
                and finalCall.sourceModule < (prepared.package.ranges -> len)
                and finalCall.astNode >= 0
                and ((finalCall.symbol >= 0 and finalCall.targetModule >= 0)
                or finalCall.opcode != -1)
                -> if {
                    prepared.package.ranges[finalCall.sourceModule] => finalCallRange
                    finalCall.astNode < finalCallRange.astCount -> if {
                        true => finalCallResolvedByAst![finalCallRange.astStart + finalCall.astNode]
                    }
                }
            finalCallIrIndex! + 1 => finalCallIrIndex!
        }
    "stream-plan" -> profileMark
    prepared -> streamIr.build(ir!, recursiveTypes!) => streamPlan
    false => usesConcurrentStreamJoins!
    0 => concurrentStreamJoinSearch!
    concurrentStreamJoinSearch! < (streamPlan.junctions -> len)
        -> while {
            streamPlan.junctions[concurrentStreamJoinSearch!] => concurrentStreamJoin
            concurrentStreamJoin.kind == 2 and (concurrentStreamJoin.policy == 1 or concurrentStreamJoin.policy == 3)
                -> if {
                    concurrentStreamJoin.inputStart => concurrentStreamInputSearch!
                    concurrentStreamInputSearch! < concurrentStreamJoin.inputStart + concurrentStreamJoin.inputCount
                        -> while {
                            streamPlan.junctionInputs[concurrentStreamInputSearch!].typeId => concurrentStreamInputTypeId
                            concurrentStreamInputTypeId >= 0 and concurrentStreamInputTypeId < (recursiveTypes!.types -> len)
                                -> if {
                                    recursiveTypes!.types[concurrentStreamInputTypeId] => concurrentStreamInputType
                                    concurrentStreamInputType.kind == 7 and concurrentStreamInputType.symbol == 4
                                        -> if { true => usesConcurrentStreamJoins! }
                                }
                            concurrentStreamInputSearch! + 1 => concurrentStreamInputSearch!
                        }
                }
            concurrentStreamJoinSearch! + 1 => concurrentStreamJoinSearch!
        }
    "interpolation-receivers" -> profileMark
    prepared -> interpolationInference.classifyIntrinsicFlowReceivers(streamPlan, recursiveTypes!, ir!, recursiveTypes!.types, recursiveTypes!.fields) => analysisInterpolations
    "interpolation-results" -> profileMark
    prepared -> interpolationInference.resultTypeByNode(streamPlan, recursiveTypes!, ir!, recursiveTypes!.types, recursiveTypes!.fields) => ownershipInterpolationResultTypes
    "interpolation-targets" -> profileMark
    prepared -> interpolationInference.importedFlowCallTargets(streamPlan, recursiveTypes!, semanticInterpolationCallTargets, analysisInterpolations, ir!, recursiveTypes!.types, recursiveTypes!.fields) => importedInterpolationCallTargetByNode!
    0 => concreteInterpolationIndex!
    concreteInterpolationIndex! < (genericBodies.functionsByInterpolation -> len)
        -> while {
            genericBodies.functionsByInterpolation[concreteInterpolationIndex!] => concreteTarget
            concreteTarget >= 0 -> if { concreteTarget => importedInterpolationCallTargetByNode![concreteInterpolationIndex!] }
            concreteInterpolationIndex! + 1 => concreteInterpolationIndex!
        }
    [Int; ~] => concreteOwnershipFunctions!
    0 => ownershipFunctionIndex!
    ownershipFunctionIndex! < (genericBodies.templatesByFunction -> len)
        -> while {
            genericBodies.templatesByFunction[ownershipFunctionIndex!] >= 0
                -> if { concreteOwnershipFunctions! -> push(ownershipFunctionIndex!) }
            ownershipFunctionIndex! + 1 => ownershipFunctionIndex!
        }
    "ownership-activity" -> profileMark
    prepared -> ownershipCheck.bodyDiagnosticActivity(ir!, recursiveTypes!.types, recursiveTypes!.activeDeclarationBodyByAst, concreteOwnershipFunctions!) => activeOwnershipBodies
    "ownership-analysis" -> profileMark
    prepared -> ownershipCheck.analyzeResolvedLoweredContextWithInterpolationFactsAndPaths(ir!, recursiveTypes!.types, recursiveTypes!.fields, genericBodies.functionsByCall, ownershipInterpolationResultTypes, importedInterpolationCallTargetByNode!, activeOwnershipBodies) => ownershipAnalysis
    ownershipAnalysis.diagnostics => ownershipDiagnostics!
    ownershipAnalysis.referencePaths => readonlyReferencePaths
    "mutable-warnings" -> profileMark
    prepared -> mutableBindingWarnings.collect(recursiveTypes!, ir!) => unusedMutableBindingWarnings
    [typeIds.SemanticType; ~] => semanticTypes!
    [typeIds.TypeReference; ~] => signatureTypeReferences!
    recursiveTypes!.references -> each reference { signatureTypeReferences! -> push(reference) }
    [typeTerms.TypeTerm; ~] => signatureTypeTerms!
    prepared.package.terms -> each term { signatureTypeTerms! -> push(term) }
    0 => semanticTypeCopyIndex351!
    semanticTypeCopyIndex351! < (recursiveTypes!.types -> len)
        -> while {
            recursiveTypes!.types[semanticTypeCopyIndex351!] => semanticType
            semanticTypes! -> push(semanticType)
            semanticTypeCopyIndex351! + 1 => semanticTypeCopyIndex351!
        }

    [typeIds.NominalField; ~] => semanticFields!
    0 => semanticFieldCopyIndex353!
    semanticFieldCopyIndex353! < (recursiveTypes!.fields -> len)
        -> while {
            recursiveTypes!.fields[semanticFieldCopyIndex353!] => semanticField
            semanticFields! -> push(semanticField)
            semanticFieldCopyIndex353! + 1 => semanticFieldCopyIndex353!
        }
    "member-collision" -> profileMark
    prepared.package -> semanticDiagnostics.firstMemberFieldCollision(ir!, semanticTypes!, recursiveTypes!.references, recursiveTypes!.referenceIndexByTypeAst, semanticFields!) => memberFieldCollision
    [nominalTypes.NominalType; ~] => nominal!
    0 => nominalTypeCopyIndex355!
    nominalTypeCopyIndex355! < (prepared.nominal -> len)
        -> while {
            prepared.nominal[nominalTypeCopyIndex355!] => nominalType
            nominal! -> push(nominalType)
            nominalTypeCopyIndex355! + 1 => nominalTypeCopyIndex355!
        }
    [compositeTypes.CompositeType; ~] => composite!
    0 => compositeTypeCopyIndex357!
    compositeTypeCopyIndex357! < (prepared.composite -> len)
        -> while {
            prepared.composite[compositeTypeCopyIndex357!] => compositeType
            composite! -> push(compositeType)
            compositeTypeCopyIndex357! + 1 => compositeTypeCopyIndex357!
        }
    [modules.ModuleIdentity; ~] => moduleIdentities!
    0 => moduleIdentityCopyIndex359!
    moduleIdentityCopyIndex359! < (prepared.modules -> len)
        -> while {
            prepared.modules[moduleIdentityCopyIndex359!] => moduleIdentity
            moduleIdentities! -> push(moduleIdentity)
            moduleIdentityCopyIndex359! + 1 => moduleIdentityCopyIndex359!
        }
    [modules.ImportEdge; ~] => importEdges!
    0 => importEdgeCopyIndex!
    importEdgeCopyIndex! < (prepared.imports -> len)
        -> while {
            importEdges! -> push(prepared.imports[importEdgeCopyIndex!])
            importEdgeCopyIndex! + 1 => importEdgeCopyIndex!
        }
    [moduleResolve.ResolvedImport; ~] => resolvedImports!
    0 => resolvedImportCopyIndex!
    resolvedImportCopyIndex! < (prepared.resolvedImports -> len)
        -> while {
            resolvedImports! -> push(prepared.resolvedImports[resolvedImportCopyIndex!])
            resolvedImportCopyIndex! + 1 => resolvedImportCopyIndex!
        }
    [analysis.SourceAnalysisRange; ~] => analysisRanges!
    0 => sourceRangeCopyIndex361!
    sourceRangeCopyIndex361! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[sourceRangeCopyIndex361!] => sourceRange
            analysisRanges! -> push(sourceRange)
            sourceRangeCopyIndex361! + 1 => sourceRangeCopyIndex361!
        }
    [ast.AstNode; ~] => analysisNodes!
    [constantLowering.Literal; ~] => constantLiterals!
    prepared.package.constantLiterals -> each literal { constantLiterals! -> push(literal) }
    [constantLowering.Failure; ~] => constantFailures!
    prepared.package.constantFailures -> each failure { constantFailures! -> push(failure) }
    0 => nodeCopyIndex363!
    nodeCopyIndex363! < (prepared.package.nodes -> len)
        -> while {
            prepared.package.nodes[nodeCopyIndex363!] => node
            analysisNodes! -> push(node)
            nodeCopyIndex363! + 1 => nodeCopyIndex363!
        }
    [syntax.SyntaxToken; ~] => analysisTokens!
    0 => tokenCopyIndex365!
    tokenCopyIndex365! < (prepared.package.tokens -> len)
        -> while {
            prepared.package.tokens[tokenCopyIndex365!] => token
            analysisTokens! -> push(token)
            tokenCopyIndex365! + 1 => tokenCopyIndex365!
        }
    [symbols.Symbol; ~] => analysisSymbols!
    0 => symbolCopyIndex367!
    symbolCopyIndex367! < (prepared.package.symbols -> len)
        -> while {
            prepared.package.symbols[symbolCopyIndex367!] => symbol
            analysisSymbols! -> push(symbol)
            symbolCopyIndex367! + 1 => symbolCopyIndex367!
        }
    [calls.ModuleCallResolution; ~] => analysisCalls!
    0 => callCopyIndex368!
    callCopyIndex368! < (prepared.calls -> len) -> while {
        analysisCalls! -> push(prepared.calls[callCopyIndex368!])
        callCopyIndex368! + 1 => callCopyIndex368!
    }
    [interpolation.InterpolationSourceRange; ~] => analysisInterpolationRanges!
    prepared.interpolationRanges -> each range { analysisInterpolationRanges! -> push(range) }
    [Int; ~] => localEnumMemberStatusByNode!
    localEnumMemberDecisionByNode! -> each decision { localEnumMemberStatusByNode! -> push(decision.status) }
    analysisInterpolations -> semanticDiagnostics.unresolvedInterpolationBindingByNode(uninvokedAssociatedMemberByNode, missingLocalAssociatedMemberByNode, localEnumMemberStatusByNode!) => unresolvedInterpolationBindingByNode
    analysisInterpolations -> semanticDiagnostics.uninvokedInterpolationFunctionByNode => uninvokedInterpolationFunctionByNode
    prepared -> interpolationInference.directCallExpectedArityByNode(streamPlan, recursiveTypes!, ir!, semanticTypes!, semanticFields!) => directCallExpectedArityByNode
    prepared -> interpolationInference.indexedResultTypeByNode(streamPlan, recursiveTypes!, ir!, semanticTypes!, semanticFields!) => indexedResultTypeByNode
    prepared -> interpolationInference.memberResultTypeByNode(streamPlan, recursiveTypes!, localEnumMemberDecisionByNode!, ir!, semanticTypes!, semanticFields!) => memberResultTypeByNode
    prepared -> interpolationInference.memberFieldByNode(streamPlan, recursiveTypes!, ir!, semanticTypes!, semanticFields!) => memberFieldByNode
    prepared -> interpolationInference.privateMemberFieldFromResolvedByNode(semanticFields!, memberFieldByNode) => privateMemberFieldByNode
    prepared -> interpolationInference.missingReadonlyMemberOwnerTypeByNode(streamPlan, recursiveTypes!, memberResultTypeByNode, importedInterpolationCallTargetByNode!, ir!, semanticTypes!, semanticFields!) => missingReadonlyMemberOwnerTypeByNode
    prepared -> interpolationInference.invalidCollectionIndexExpectedTypeByNode(streamPlan, recursiveTypes!, ir!, semanticTypes!, semanticFields!) => invalidCollectionIndexExpectedTypeByNode
    [expressionTypeIds.ResolvedEnumConstructorArgument; ~] => interpolationEnumConstructors!
    [expressionTypeIds.InterpolationArrayFact; ~] => interpolationArrayByNode!
    recursiveTypes!.interpolationArrayByNode -> each literal { interpolationArrayByNode! -> push(literal) }
    recursiveTypes!.enumConstructorArguments -> each constructor {
        interpolationEnumConstructors! -> push(constructor)
    }
    [Int; ~] => interpolationEnumConstructorByNode!
    recursiveTypes!.enumConstructorIndexByInterpolationNode -> each constructorIndex {
        interpolationEnumConstructorByNode! -> push(constructorIndex)
    }
    analysisInterpolations -> semanticDiagnostics.unresolvedInterpolationCallByNode(importedInterpolationCallTargetByNode!, invalidCollectionIndexExpectedTypeByNode) => unresolvedInterpolationCallByNode!
    0 => constructorDecisionIndex!
    constructorDecisionIndex! < (interpolationEnumConstructorByNode! -> len)
        -> while {
            interpolationEnumConstructorByNode![constructorDecisionIndex!] => constructorIndex
            constructorIndex >= 0 -> if {
                interpolationEnumConstructors![constructorIndex] => constructor
                constructor.enumTypeId >= 0
                    and (constructor.memberStatus == 3 or (constructor.memberStatus == 0 and constructor.expectedTypeId >= 0
                    and constructor.actualTypeId == constructor.expectedTypeId))
                    -> if { false => unresolvedInterpolationCallByNode![constructorDecisionIndex!] }
            }
            constructorDecisionIndex! + 1 => constructorDecisionIndex!
        }
    analysisInterpolations -> semanticDiagnostics.invalidArgumentsInterpolationIndexByNode(analysisInterpolationRanges!, ir!, semanticTypes!) => invalidArgumentsInterpolationIndexByNode
    prepared -> interpolationInference.intrinsicFlowResultBuiltinByNode(streamPlan, recursiveTypes!, analysisInterpolations, ir!, semanticTypes!, semanticFields!) => intrinsicFlowResultBuiltinByNode
    prepared -> interpolationInference.flowResultTypeByNode(streamPlan, recursiveTypes!, ir!, semanticTypes!, semanticFields!) => flowResultTypeByNode
    analysisInterpolations -> interpolationInference.invalidIntrinsicFlowArityByNode => invalidIntrinsicFlowArityByNode
    prepared -> interpolationInference.invalidTextIntrinsicArgumentByNode(streamPlan, recursiveTypes!, analysisInterpolations, ir!, semanticTypes!, semanticFields!) => invalidTextIntrinsicArgumentByNode
    prepared -> interpolationInference.collectionMembershipDiagnosticByNode(streamPlan, recursiveTypes!, analysisInterpolations, ir!, semanticTypes!, semanticFields!) => collectionMembershipDiagnosticByNode
    prepared -> interpolationInference.invalidMappedIndexByNode(streamPlan, recursiveTypes!, ir!, semanticTypes!, semanticFields!) => invalidMappedIndexByNode
    prepared -> interpolationInference.invalidSignedUnaryByNode(streamPlan, recursiveTypes!, ir!, semanticTypes!, semanticFields!) => invalidSignedUnaryByNode
    prepared -> interpolationInference.invalidNotUnaryByNode(streamPlan, recursiveTypes!, ir!, semanticTypes!, semanticFields!) => invalidNotUnaryByNode
    prepared -> interpolationInference.unaryResultTypeByNode(streamPlan, recursiveTypes!, ir!, semanticTypes!, semanticFields!, invalidSignedUnaryByNode, invalidNotUnaryByNode) => unaryResultTypeByNode
    prepared -> interpolationInference.binaryArithmeticDiagnosticByNode(streamPlan, recursiveTypes!, ir!, semanticTypes!, semanticFields!) => binaryArithmeticDiagnosticByNode
    prepared -> interpolationInference.binaryComparisonDiagnosticByNode(streamPlan, recursiveTypes!, ir!, semanticTypes!, semanticFields!) => binaryComparisonDiagnosticByNode
    prepared -> interpolationInference.numericLiteralContextByNode(semanticTypes!, binaryArithmeticDiagnosticByNode, binaryComparisonDiagnosticByNode, pointerBitWidth) => interpolationNumericLiteralContextByNode
    prepared -> interpolationInference.binaryLogicalDiagnosticByNode(streamPlan, recursiveTypes!, ir!, semanticTypes!, semanticFields!) => binaryLogicalDiagnosticByNode
    prepared -> interpolationInference.binaryResultTypeByNode(streamPlan, recursiveTypes!, ir!, semanticTypes!, semanticFields!, binaryArithmeticDiagnosticByNode, binaryComparisonDiagnosticByNode, binaryLogicalDiagnosticByNode) => binaryResultTypeByNode
    prepared -> interpolationInference.nominalInitializerDiagnosticByNode(streamPlan, recursiveTypes!, ir!, semanticTypes!, semanticFields!) => interpolationContextualDiagnosticByNode
    prepared -> interpolationInference.unsupportedIndexOwnerTypeByNode(streamPlan, recursiveTypes!, ir!, semanticTypes!, semanticFields!) => unsupportedIndexOwnerTypeByNode
    prepared -> interpolationInference.invalidNumericConversionTypeByNode(streamPlan, recursiveTypes!, ir!, semanticTypes!, semanticFields!) => invalidNumericConversionTypeByNode
    prepared -> interpolationInference.invalidCodePointFloatConversionByNode(streamPlan, recursiveTypes!, ir!, semanticTypes!, semanticFields!) => invalidCodePointFloatConversionByNode
    prepared -> interpolationInference.invalidNumericConversionLiteralByNode(pointerBitWidth) => invalidNumericConversionLiteralByNode
    prepared -> interpolationInference.invalidNumericConversionArityByNode => invalidNumericConversionArityByNode
    prepared -> interpolationInference.numericConversionResultTypeByNode(semanticTypes!, invalidNumericConversionArityByNode, invalidNumericConversionTypeByNode, invalidCodePointFloatConversionByNode, invalidNumericConversionLiteralByNode) => numericConversionResultTypeByNode
    [typeIds.SemanticType; ~] => layoutTypes!
    0 => layoutTypeCopyIndex418!
