        genericBodies: genericBodies
        streamPlan: streamPlan
        moves: moves
        nominal: nominal!
        composite: composite!
        modules: moduleIdentities!
        imports: importEdges!
        resolvedImports: resolvedImports!
        types: semanticTypes!
        typeReferences: signatureTypeReferences!
        typeTerms: signatureTypeTerms!
        fields: semanticFields!
        typeSizes: typeSizes!
        typeAligns: typeAligns!
        typeLayoutStatuses: typeLayoutStatuses!
        typeTraits: typeTraits!
        ownedStorageByType: ownedStorageByType
        pointerBitWidth: pointerBitWidth
        targetArchitecture: targetArchitecture
        cpuDispatchPolicy: cpuDispatchPolicy
        requiredCpuFeatures: requiredCpuFeatures
        allowedCpuFeatures: allowedCpuFeatures
        forbiddenCpuFeatures: forbiddenCpuFeatures
        supportsComputePool: supportsComputePool
        expectedPathStyle: expectedPathStyle
        usesConcurrentStreamJoins: usesConcurrentStreamJoins!
        ownershipDiagnostics: ownershipDiagnostics!
        readonlyReferencePaths: readonlyReferencePaths
    } => context!
    context! -> collectEnumPayloadStoragePlaces => enumPayloadStoragePlaces
    [ownershipCheck.EnumPayloadStorageDiagnostic; ~] => enumPayloadStorageDiagnostics!
    enumPayloadStoragePlaces -> each place {
        enumPayloadRequiresTransfer![place.constructorIndex]
            and (place -> enumPayloadPlaceBorrows(context!))
            -> if {
                enumPayloadStorageDiagnostics! -> push(ownershipCheck.EnumPayloadStorageDiagnostic {
                    sourceModule: place.sourceModule
                    argumentNode: place.argumentNode
                    argumentAst: place.argumentAst
                    bindingIr: place.bindingIr
                })
            }
    }
    enumPayloadStorageDiagnostics! => context!.enumPayloadStorageDiagnostics
    # No rejected payload means no diagnostic copy or precedence work.
    (context!.enumPayloadStorageDiagnostics -> len) > 0
        -> if {
            context!.ownershipDiagnostics -> ownershipCheck.prioritizeEnumPayloadDiagnostics(context!.enumPayloadStorageDiagnostics, context!.nodes, context!.ranges, context!.firstOwnedBindingDiagnostic) => prioritizedOwnership
            prioritizedOwnership.diagnostics => selectedOwnershipDiagnostics
            selectedOwnershipDiagnostics => context!.ownershipDiagnostics
            prioritizedOwnership.firstOwnedBindingDiagnostic => context!.firstOwnedBindingDiagnostic
        }
    enumPayloadStoragePlaces -> collectInterpolationPayloadTransfers(context!) => interpolationPayloadTransfers
    interpolationPayloadTransfers => context!.interpolationPayloadTransfers
    context! -> appendInterpolationWholePayloadMoves => interpolationMoves
    interpolationMoves => context!.moves
    context! -> interpolationConsumedNameByNode => consumedNames
    consumedNames => context!.unresolvedInterpolationBindingByNode
    context! -> interpolationConsumedBindingReads => consumedReads
    consumedReads => context!.consumedBindingReads
    context! -> interpolationOwnedParameterCallsByNode => ownedParameterCalls
    ownedParameterCalls => context!.interpolationOwnedParameterCallByNode
    context! -> diagnostics.analyzeNominalInitializers(prepared.qualified) => initializerDiagnostics
    initializerDiagnostics => context!.initializerDiagnostics
    "context-complete" -> profileMark
    context!
}

public profileResolvedFiles paths: [Text; ~] -> Int uses Console, File {
    "prepare-files" -> profileMark
    [file.SourceText; ~] => owners!
    paths -> each path { owners! -> push(path -> file.mapText) }
    [Text; ~] => sources!
    0 => sourceIndex!
    sourceIndex! < (owners! -> len) -> while {
        owners![sourceIndex!] -> sourceDecoding.utf8Text => source
        sources! -> push(source)
        sourceIndex! + 1 => sourceIndex!
    }
    sources! -> analysis.analyzeCheckedTextSources -> when {
        Err(code) { code -> return }
        Ok(value) { value }
    } => parsedPackage
    parsedPackage -> semanticContext.prepareAnalyzedWithStandardLibrarySources(144) => prepared
    llvmTarget.windowsX64() => target
    PrepareRequest { sources: sources!, standardLibrarySourceStart: 0, standardLibrarySourceCount: 144, pointerBitWidth: target.pointerBitWidth, targetArchitecture: target.architecture, cpuDispatchPolicy: target.dispatchPolicy, requiredCpuFeatures: target.requiredFeatures, allowedCpuFeatures: target.allowedFeatures, forbiddenCpuFeatures: target.forbiddenFeatures, supportsComputePool: true, expectedPathStyle: 1 } => request
    prepared -> semanticDiagnostics.firstPreparedExplicitSignatureTypeDiagnostic => signatureDiagnostic
    prepared.package -> semanticDiagnostics.unresolvedMutableLocalReads => mutableNames
    libraryImports.empty() => libraries
    [libraryImports.LibraryFunctionResolution; ~] => libraryCalls
    prepared.package -> libraryImports.callResultTypes(prepared.semantic.types, libraries, libraryCalls) => externalResults
    "resolve-call-context" -> profileMark
    prepared -> expressionTypeIds.resolveCallContextWithExternalResults(externalResults) => resolved
    "resolved-context" -> profileMark
    request -> profileResolvedSnapshot(resolved, libraries, libraryCalls, mutableNames, signatureDiagnostic) => context
    "blocking-diagnostics" -> profileMark
    context -> diagnostics.blockingDiagnosticCount => count
    owners! -> len => ownerCount
    "retained-owners-$ownerCount" -> profileMark
    "complete" -> profileMark
    count
}
