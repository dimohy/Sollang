+# C# registers this intrinsic declaration as SourceText before any containing
+# type is interned. Resolve its declaration once, independently of import aliases.
+public intrinsicSourceTextDeclaration package: ref analysis.PackageAnalysis, identities: ref [modules.ModuleIdentity; ~] -> OpenNominalTypeResolution {
+    OpenNominalTypeResolution { targetModule: -1, targetSymbol: -1, matchCount: 0 } => result!
+    0 => moduleIndex!
+    moduleIndex! < (identities -> len) -> while {
+        identities[moduleIndex!] => identity
+        package.ranges[identity.sourceIndex] => range
+        0 => symbolIndex!
+        symbolIndex! < range.symbolCount -> while {
+            package.symbols[range.symbolStart + symbolIndex!] => symbol
+            symbol.kind == 3 and symbol.parent < 0 -> if {
+                (package -> intrinsicNominalSymbol(identities, moduleIndex!, symbolIndex!)) == 24
+                    -> if {
+                        OpenNominalTypeResolution { targetModule: identity.sourceIndex, targetSymbol: symbolIndex!, matchCount: result!.matchCount + 1 } => result!
+                    }
+            }
+            symbolIndex! + 1 => symbolIndex!
+        }
+        moduleIndex! + 1 => moduleIndex!
+    }
+    result!
+}
