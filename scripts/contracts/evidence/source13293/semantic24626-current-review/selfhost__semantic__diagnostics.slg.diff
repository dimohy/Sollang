+# A typed-empty array owns the location of its element type lookup. Ordinary
+# qualified value paths retain their own location and existing admission.
+typedEmptyArrayPathOwner package: ref analysis.PackageAnalysis, sourceModule: Int, pathAst: Int -> Int {
+    package.ranges[sourceModule] => range
+    package.nodes[range.astStart + pathAst] => path
+    path.kind != 16 -> if { -1 -> return }
+    path.parent => owner!
+    owner! >= 0 and package.nodes[range.astStart + owner!].kind == 12
+        -> while {
+            package.nodes[range.astStart + owner!].parent => owner!
+        }
+    owner! >= 0 and package.nodes[range.astStart + owner!].kind == 37
+        -> if { owner! } else { -1 }
+}
