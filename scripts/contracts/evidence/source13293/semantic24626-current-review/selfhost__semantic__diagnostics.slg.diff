+            and candidate.pathAst >= 0 and candidate.pathAst < prepared.package.ranges[candidate.sourceModule].astCount
+            -> if {
+                prepared.package.ranges[candidate.sourceModule] => range
+                prepared.package -> typedEmptyArrayPathOwner(candidate.sourceModule, candidate.pathAst) => literal
+                literal >= 0 -> if {
+                    false => dependent!
+                    0 => symbolIndex!
+                    symbolIndex! < range.symbolCount and not dependent!
+                        -> while {
+                            prepared.package.symbols[range.symbolStart + symbolIndex!] => symbol
+                            (symbol.kind == 7 or symbol.kind == 31) and symbol.astNode >= 0
+                                and (prepared.package -> semanticContext.declarationAncestor(candidate.sourceModule, symbol.astNode, candidate.pathAst))
+                                and (prepared.package -> signatureTypeReferencesGeneric(candidate.sourceModule, symbolIndex!, candidate.pathAst, 0))
+                                -> if { true => dependent! }
+                            symbolIndex! + 1 => symbolIndex!
+                        }
+                    not dependent! -> if {
+                        prepared.package.nodes[range.astStart + literal] => array
+                        SignatureTypeDiagnostic { code: 21, sourceModule: candidate.sourceModule, functionSymbol: -1, typeAst: candidate.pathAst, nameToken: array.firstToken, genericToken: -1 } -> return
+                    }
+                }
+            }
         candidate.status == 3 and candidate.sourceModule >= 0
             and candidate.sourceModule < (prepared.package.ranges -> len)
             and candidate.targetModule >= 0 and candidate.targetModule < (prepared.modules -> len)
