+public callArgumentIsNamedRead package: ref analysis.PackageAnalysis, sourceModule: Int, callAst: Int, argumentAst: Int -> Bool {
+    sourceModule < 0 or sourceModule >= (package.ranges -> len)
+        -> if { false -> return }
+    package.ranges[sourceModule] => range
+    argumentAst < 0 or argumentAst >= range.astCount
+        -> if { false -> return }
+    package.nodes[range.astStart + argumentAst].kind == 15
+        -> if { true -> return }
+    package.nodes[range.astStart + argumentAst].kind != 16
+        -> if { false -> return }
+    (package -> directCallReceiverAst(sourceModule, callAst)) == argumentAst
+}
