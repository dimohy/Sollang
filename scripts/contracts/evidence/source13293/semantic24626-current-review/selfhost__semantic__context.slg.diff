+public directCallReceiverAst package: ref analysis.PackageAnalysis, sourceModule: Int, callAst: Int -> Int {
+    sourceModule < 0 or sourceModule >= (package.ranges -> len)
+        -> if { -1 -> return }
+    package.ranges[sourceModule] => range
+    callAst < 0 or callAst >= range.astCount -> if { -1 -> return }
+    package.nodes[range.astStart + callAst] => call
+    call.kind != 11 -> if { -1 -> return }
+    0 => nameIndex!
+    nameIndex! < range.nameCount -> while {
+        package -> directCallReceiverForName(sourceModule, nameIndex!) => receiverAst
+        receiverAst >= 0 and package.nodes[range.astStart + receiverAst].parent == callAst
+            -> if { receiverAst -> return }
+        nameIndex! + 1 => nameIndex!
+    }
+    -1
+}
