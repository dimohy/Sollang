 # Both entry paths share argument ownership, exclusion and source-order decisions.
+directCallReceiverForName package: ref analysis.PackageAnalysis, sourceModule: Int, nameIndex: Int -> Int {
+    package.ranges[sourceModule] => range
+    package.names[range.nameStart + nameIndex] => name
+    name.astNode < 0 or name.astNode >= range.astCount
+        or not (package -> calls.receiverSymbolIsRuntimeValue(sourceModule, name.symbol))
+        -> if { -1 -> return }
+    package.nodes[range.astStart + name.astNode] => receiver
+    receiver.kind != 16 or receiver.parent < 0 or receiver.parent >= range.astCount
+        or name.nameToken != receiver.firstToken
+        -> if { -1 -> return }
+    package.nodes[range.astStart + receiver.parent] => call
+    call.kind == 11 and receiver.start == call.start
+        -> if { name.astNode -> return }
+    -1
+}
