+public indexDirectCallReceiversByAst package: ref analysis.PackageAnalysis -> [Int; ~] {
+    [Int; ~] => receivers!
+    package.nodes -> each node { receivers! -> push(-1) }
+    0..<Int(package.ranges -> len) -> each sourceModule {
+        package.ranges[sourceModule] => range
+        0..<range.nameCount -> each nameIndex {
+            package -> directCallReceiverForName(sourceModule, nameIndex) => receiverAst
+            receiverAst >= 0 -> if {
+                range.astStart + package.nodes[range.astStart + receiverAst].parent => globalCall
+                # Preserve the scan query's first qualifying lexical fact.
+                receivers![globalCall] < 0 -> if { receiverAst => receivers![globalCall] }
+            }
+        }
+    }
+    receivers!
+}
