 # Per-source typed call resolution extracted from resolveModulesTyped.
 # Each invocation owns its candidate/result arrays and borrows global indexes.
+
+public receiverSymbolIsRuntimeValue package: ref analysis.PackageAnalysis, sourceModule: Int, symbolIndex: Int -> Bool {
+    sourceModule < 0 or sourceModule >= (package.ranges -> len)
+        -> if { false -> return }
+    package.ranges[sourceModule] => range
+    symbolIndex < 0 or symbolIndex >= range.symbolCount
+        -> if { false -> return }
+    package.symbols[range.symbolStart + symbolIndex] => root
+    root.kind == 35 -> if { true -> return }
+    root.kind != 9 and root.kind != 61 -> if { false -> return }
+    root.parent >= 0 -> if {
+        package.symbols[range.symbolStart + root.parent] => owner
+        owner.kind == 3 or owner.kind == 4 -> if { false -> return }
+    }
+    true
+}
 
