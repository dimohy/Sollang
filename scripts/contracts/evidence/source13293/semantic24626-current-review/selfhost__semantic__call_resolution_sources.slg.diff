+typedMethodNameMatches request: TypedMethodRequest, methodSource: Int, nameToken: Int, memberStart: UIntSize, memberLength: UIntSize, package: ref analysis.PackageAnalysis -> Bool {
+    package.ranges[methodSource] => range
+    package.tokens[range.tokenStart + nameToken] => name
+    name.span.length == memberLength => equal!
+    UIntSize(0) => nameByte!
+    equal! and nameByte! < memberLength -> while {
