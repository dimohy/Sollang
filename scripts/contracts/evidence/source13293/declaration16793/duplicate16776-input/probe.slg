import sollang.compiler.semantic.semantic_generations as semanticGenerations

main {
    process.arguments() => arguments
    (arguments -> len) != 5 -> if { process.exit(2) }
    [Text; ~] => paths!
    paths! -> push("stdlib/std/algorithm.slg")
    paths! -> push("stdlib/std/archive/zip.slg")
