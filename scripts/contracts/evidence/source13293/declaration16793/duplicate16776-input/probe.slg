    paths! -> push("stdlib/std/uuid/error.slg")
    paths! -> push("stdlib/sys/directory.slg")
    paths! -> push("stdlib/sys/directory/kind.slg")
    paths! -> push("stdlib/sys/file.slg")
    paths! -> push("stdlib/sys/input/mouse.slg")
    paths! -> push("stdlib/sys/io.slg")
    paths! -> push("stdlib/sys/path.slg")
    paths! -> push("stdlib/sys/process.slg")
    paths! -> push("stdlib/sys/random.slg")
    paths! -> push("stdlib/sys/runtime/clock.slg")
    paths! -> push("stdlib/sys/runtime/console.slg")
    paths! -> push("stdlib/sys/runtime/dns.slg")
    paths! -> push("stdlib/sys/runtime/integer_file.slg")
    paths! -> push("stdlib/sys/runtime/mouse_event.slg")
    paths! -> push("stdlib/sys/runtime/parallel.slg")
    paths! -> push("stdlib/sys/runtime/path.slg")
    paths! -> push("stdlib/sys/runtime/path_absolute.slg")
    paths! -> push("stdlib/sys/runtime/process.slg")
    paths! -> push("stdlib/sys/runtime/random.slg")
    paths! -> push("stdlib/sys/runtime/sequence.slg")
    paths! -> push("stdlib/sys/runtime/socket.slg")
    paths! -> push("stdlib/sys/runtime/time.slg")
    paths! -> push("stdlib/sys/text.slg")
    false => selected!
    arguments[1] == "original-cross-module" -> if {
        paths! -> push("artifacts/scratch/resume-20261006-owner-continuation22/runner16643-fixture/examples/regression/diagnostics/module-duplicate.slg")
        paths! -> push("artifacts/scratch/resume-20261006-owner-continuation22/runner16643-fixture/examples/regression/diagnostics/duplicate/first.slg")
        paths! -> push("artifacts/scratch/resume-20261006-owner-continuation22/runner16643-fixture/examples/regression/diagnostics/duplicate/second.slg")
        true => selected!
    }
    arguments[1] == "distinct-functions" -> if {
        paths! -> push("artifacts/scratch/resume-20261006-owner-continuation22/duplicate16750-input/distinct-functions/main.slg")
        paths! -> push("artifacts/scratch/resume-20261006-owner-continuation22/duplicate16750-input/distinct-functions/first.slg")
        paths! -> push("artifacts/scratch/resume-20261006-owner-continuation22/duplicate16750-input/distinct-functions/second.slg")
        true => selected!
    }
    arguments[1] == "same-file" -> if {
        paths! -> push("artifacts/scratch/resume-20261006-owner-continuation22/duplicate16750-input/same-file/main.slg")
        true => selected!
    }
    arguments[1] == "different-arity" -> if {
        paths! -> push("artifacts/scratch/resume-20261006-owner-continuation22/duplicate16750-input/different-arity/main.slg")
        true => selected!
    }
    arguments[1] == "different-namespaces" -> if {
        paths! -> push("artifacts/scratch/resume-20261006-owner-continuation22/duplicate16750-input/different-namespaces/main.slg")
        paths! -> push("artifacts/scratch/resume-20261006-owner-continuation22/duplicate16750-input/different-namespaces/first.slg")
        paths! -> push("artifacts/scratch/resume-20261006-owner-continuation22/duplicate16750-input/different-namespaces/second.slg")
        true => selected!
    }
    arguments[1] == "namespace-trivia" -> if {
        paths! -> push("artifacts/scratch/resume-20261006-owner-continuation22/duplicate16750-input/namespace-trivia/main.slg")
        paths! -> push("artifacts/scratch/resume-20261006-owner-continuation22/duplicate16750-input/namespace-trivia/first.slg")
        paths! -> push("artifacts/scratch/resume-20261006-owner-continuation22/duplicate16750-input/namespace-trivia/second.slg")
        true => selected!
    }
    arguments[1] == "local-scope" -> if {
        paths! -> push("artifacts/scratch/resume-20261006-owner-continuation22/duplicate16750-input/local-scope/main.slg")
        true => selected!
    }
    arguments[1] == "earlier-bad-signature" -> if {
        paths! -> push("artifacts/scratch/resume-20261006-owner-continuation22/duplicate16750-input/earlier-bad-signature/main.slg")
        true => selected!
    }
    arguments[1] == "duplicate-before-bad-signature"
        -> if {
            paths! -> push("artifacts/scratch/resume-20261006-owner-continuation22/duplicate16750-input/duplicate-before-bad-signature/main.slg")
            true => selected!
        }
    arguments[1] == "duplicate-before-body-error" -> if {
        paths! -> push("artifacts/scratch/resume-20261006-owner-continuation22/duplicate16750-input/duplicate-before-body-error/main.slg")
        true => selected!
    }
    not selected! -> if { process.exit(2) }
    [file.SourceText; ~] => owners!
    paths! -> each current { current -> file.mapText => owner
        owners! -> push(owner) }
    [Text; ~] => sources!
    0 => index!
    index! < (owners! -> len) -> while {
        owners![index!] -> sourceDecoding.utf8Text => source
        sources! -> push(source)
        index! + 1 => index!
    }
    arguments[0] -> semanticCache.compilerIdentity -> when {
        Ok(value) { value }
        Err(code) { process.exit(code)
            UInt64(0) }
    } => compilerIdentity
    semanticGenerations.CompilationIdentity { compiler: compilerIdentity, target: 0, configuration: 16776 } => identity
    semanticCache.Request { enabled: true, destination: arguments[2], staged: arguments[3], identity: identity } => cache
    arguments[4] == "warm" -> if {
        arguments[2] -> semanticCache.load => loaded
        loaded.status != 0 -> if { process.exit(4) }
    }
    sources! -> compiler.emitCheckedWithPathsCached(paths!, 144, cache) => diagnostics
    diagnostics > 0 -> if { "rejected=$diagnostics" -> println }
}
