(?m)^define i32 @sollang_m[0-9]+_s1\(ptr %arg\) \{\r?\nentry:\r?\n  %v[0-9]+ = load %sollang\.array\.i32, ptr %arg, align 8\r?\n  %call[0-9]+_arg0_slice_data = extractvalue %sollang\.array\.i32 %v[0-9]+, 0\r?\n  %call[0-9]+_arg0_slice_length = extractvalue %sollang\.array\.i32 %v[0-9]+, 1\r?\n  %call[0-9]+_arg0_slice0 = insertvalue \{ ptr, i64 \} poison, ptr %call[0-9]+_arg0_slice_data, 0\r?\n  %call[0-9]+_arg0_slice = insertvalue \{ ptr, i64 \} %call[0-9]+_arg0_slice0, i64 %call[0-9]+_arg0_slice_length, 1\r?\n  %v[0-9]+ = call i32 @sollang_m[0-9]+_s0\(\{ ptr, i64 \} %call[0-9]+_arg0_slice\)\r?\n  ret i32 %v[0-9]+\r?\n\}$
