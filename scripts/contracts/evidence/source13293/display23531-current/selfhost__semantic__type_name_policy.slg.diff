@@ -7,6 +7,23 @@ public isBuiltin name: Text -> Bool {
     builtinNames() -> containsName(name)
 }
 
+public builtinDisplayName enumName: Text -> Text {
+    builtinDisplayOverrides() => table
+    UIntSize(0) => start!
+    start! < (table -> len) -> while {
+        start! => end!
+        end! < (table -> len) and (table -> byte(end!)) != '|'
+            -> while { end! + 1 => end! }
+        start! => equal!
+        equal! < end! and (table -> byte(equal!)) != '='
+            -> while { equal! + 1 => equal! }
+        equal! < end! and (table -> slice(start!, equal! - start!)) == enumName
+            -> if { table -> slice(equal! + 1, end! - equal! - 1) -> return }
+        end! + 1 => start!
+    }
+    enumName
+}
