appendOwned0 values0: move [Int; ~], item: Int -> [Int; ~] {
    values0 -> append(item) => result0
    result0
}
updateOwned1 values1: move [Int; ~], index: Int, item: Int -> [Int; ~] {
    values1 -> updated(index, item) => result1
    result1
}
updateDictionary2 values2: move {Int: Int}, key: Int, item: Int -> {Int: Int} {
    values2 -> updated(key, item) => result2
    result2
}
main {
    [1, 2; ~] => values0
    values0 -> appendOwned0(3) => result0
    "$(result0[2]):$(result0 -> len)" -> println
    [1, 2; ~] => values1
    values1 -> updateOwned1(0, 9) => result1
    "$(result1[0]):$(result1[1]):$(result1 -> len)" -> println
    {1: 100, 2: 200} => values2
    values2 -> updateDictionary2(3, 300) => result2
    "$(result2[3]):$(result2 -> len)" -> println
    {1: 100, 2: 200} => values3
    values3 -> updated(3, 300) => grown3
    grown3 -> updated(4, 400) => inserted3
    inserted3 -> updated(4, 450) => result3
    "$(result3[3]):$(result3[4]):$(result3 -> len)" -> println
}
