    values! -> put(1219, 2121)
    values! -> take(1027) => removed
    removed -> println
    values! -> len -> println
    values! -> capacity -> println
    values![1219] -> println
    values! -> put(1283, 2100)
    values![1283] -> println
    values! -> take(3) => first
    first -> println
    values! -> len -> println
    values! -> capacity -> println
    values![67] -> println
}

