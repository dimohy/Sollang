chooseFreshSet condition: Bool -> Set<Int> {
    condition -> if {
        Set<Int>(4)
    } else {
        Set<Int>(4)
    }
}


boundedIntCase: -> Unit uses Console {
    {3: 10, 35: 11, 67: 12; <=24} => values!
    values! -> put(99, 13)
    values! -> put(131, 14)
    values! -> put(163, 15)
    values! -> put(195, 16)
    values! -> put(227, 17)
    values! -> put(259, 18)
    values! -> put(291, 19)
    values! -> put(323, 20)
    values! -> put(355, 21)
    values! -> put(387, 22)
    values! -> put(419, 23)
    values! -> put(451, 24)
    values! -> put(483, 25)
    values! -> put(515, 26)
    values! -> put(547, 27)
    values! -> put(579, 28)
    values! -> put(611, 29)
    values! -> put(611, 999)
    values![611] -> println
    values![3] -> println
    values! -> take(3) => first
    first -> println
    values! -> put(643, 888)
    values![643] -> println
    values! -> putIfAbsent(611, 1) => duplicate
    duplicate -> println
    values! -> putIfAbsent(675, 777) => inserted
    inserted -> println
    values! -> len -> println
    values! -> capacity -> println
}
boundedTextCase: -> Unit uses Console {
    {"a": 10, "b": 20; <=4} => values!
    values! -> put("c", 30)
    values! -> put("b", 25)
    values!["b"] -> println
    values! -> take("a") => selected
    selected -> println
    values! -> put("d", 40)
    values!["c"] -> println
    values!["d"] -> println
    values! -> len -> println
    values! -> capacity -> println
}
