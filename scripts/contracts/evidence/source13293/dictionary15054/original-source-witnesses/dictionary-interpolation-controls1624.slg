boundedBoolCase: -> Unit uses Console {
    {1: true, 9: false; <=2} => values!
    values![1] -> println
    values! -> put(9, true)
    values! -> take(9) => selected
    selected -> println
    values! -> put(9, false)
    values! -> putIfAbsent(1, true) => duplicate
    duplicate -> println
    values![9] -> println
    values! -> len -> println
    values! -> capacity -> println
}
boundedOwnedCase: -> Unit uses Console {
    {"a": [1, 2; ~], "b": [3; ~]; <=4} => values!
    values! -> take("a") => selected
    selected -> len -> println
    selected[1] -> println
    values! -> put("c", [4; ~])
    values! -> put("b", [5, 6; ~])
    values!["b"][0] -> println
    values!["c"][0] -> println
    values! -> len -> println
    values! -> capacity -> println
}

heapInterpolationCase: -> Unit uses Console {
    {"a": 10, "b": 20} => values!
    values! -> take("a") => selected
    values! -> put("c", 30)
    "b" => b
    "c" => c
    "text=$(values![b]),$(values![c])" -> println
    {UInt8(1): 11, UInt8(9): 99} => bytes!
    bytes! -> put(UInt8(17), 171)
    UInt8(9) => nine
    UInt8(17) => seventeen
    "u8=$(bytes![nine]),$(bytes![seventeen])" -> println
    {1: true, 9: false} => flags!
    flags! -> put(9, true)
    "bool=$(flags![1]),$(flags![9])" -> println
}

boundedInterpolationCase: -> Unit uses Console {
    {"a": 10, "b": 20; <=4} => values!
    values! -> take("a") => selected
    values! -> put("c", 30)
    "b" => b
    "c" => c
    35 => values![c]
    "bounded=$(values![b]),$(values![c]),$selected" -> println
}

boundedOwnedAssignmentCase: -> Unit uses Console {
    {"a": [1; ~], "b": [2; ~]; <=4} => values!
    "b" => b
    [5, 6; ~] => values![b]
    values! -> take(b) => selected
    "owned=$(selected[0]),$(selected[1])" -> println
    "a" => a
    "resident=$(values![a][0])" -> println
}

main {
    heapInterpolationCase()
    boundedInterpolationCase()
    boundedOwnedAssignmentCase()
    boundedIntCase()
    boundedTextCase()
    boundedUInt8Case()
    boundedBoolCase()
    boundedOwnedCase()
    {1: 10, 9: 90; <=4} => boundedEntry
    boundedEntry[9] -> println
    true -> if {
        {"x": 1, "y": 2; <=3} => boundedRegion
        boundedRegion["y"] -> println
    }
    chooseFreshSet(true) => chosenTrue
    chosenTrue -> len -> println
    chosenTrue -> capacity -> println
    chooseFreshSet(false) => chosenFalse
    chosenFalse -> len -> println
    chosenFalse -> capacity -> println
    intCase()
    textCase()
    ownedCase()
    wrapCase()
    emptyTextCase()
    emptyBoolCase()
    emptyOwnedCase()
    {1: true, 9: false} => flags!
    flags! -> put(9, true)
    flags![9] -> println
    flags! -> len -> println
    1 == 1 -> if {
        {"a": [7; ~], "b": [9; ~]} => owners!
        owners! -> put("c", [11; ~])
        owners!["a"][0] -> println
        owners!["c"][0] -> println
        owners! -> len -> println
    }
    flags![1] -> println

    keyInt8Case()
    keyUInt8Case()
    keyInt16Case()
    keyUInt16Case()
    keyInt32Case()
    keyUInt32Case()
    keyInt64Case()
    keyUInt64Case()
    keySizeCase()
    keyUIntSizeCase()
    keyCodePointCase()
    setIntCase()
    setTextCase()
    ownedSetCase()
}
