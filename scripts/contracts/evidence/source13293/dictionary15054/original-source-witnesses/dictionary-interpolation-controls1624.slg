intCase: -> Unit uses Console {
    {1: 10, 9: 90, 17: 170} => values!
    values! -> take(9) => removed
    removed -> println
    values! -> len -> println
    values! -> capacity -> println
    values![1] -> println
    values![17] -> println
    values! -> put(25, 250)
    values![25] -> println
    values! -> take(1) => first
    first -> println
    values! -> len -> println
    values! -> capacity -> println
    values![17] -> println
}

textCase: -> Unit uses Console {
    {"하나": 10, "둘": 20, "셋": 30} => values!
    values! -> take("둘") => removed
    removed -> println
    values! -> len -> println
    values! -> capacity -> println
    values!["하나"] -> println
    values!["셋"] -> println
    values! -> put("넷", 40)
    values!["넷"] -> println
    values! -> take("하나") => first
    first -> println
    values! -> len -> println
    values! -> capacity -> println
}

consume value: move [Int; ~] -> Int => value -> len

ownedCase: -> Unit uses Console {
    {1: [10, 11; ~], 9: [90; ~], 17: [170, 171; ~]} => owners!
    owners! -> take(9) => selected
    selected -> len -> println
    selected[0] -> println
    owners! -> len -> println
    owners! -> capacity -> println
    selected -> consume => selectedLength
    selectedLength -> println
    owners![1][0] -> println
    owners![17][1] -> println
}


wrapCase: -> Unit uses Console {
    {3: 100, 67: 200, 131: 300, 195: 400, 259: 500, 323: 600, 387: 700, 451: 800, 515: 900, 579: 1000, 643: 1100, 707: 1200, 771: 1300, 835: 1400, 899: 1500, 963: 1600, 1027: 1700, 1091: 1800, 1155: 1900, 1219: 2000} => values!
