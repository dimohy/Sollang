main {
    {1: 100, 2: 200} => values
    values -> capacity => initial
    values -> updated(3, 300) => first
    first -> capacity => firstCapacity
    first -> updated(4, 400) => second
    second -> capacity => secondCapacity
    second -> updated(5, 500) => third
    third -> capacity => thirdCapacity
    "$initial:$firstCapacity:$secondCapacity:$thirdCapacity:$(third[5])" -> println
}
