import syntax.generated.slg as grammar
import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.expression_type_ids as expressionTypes
import sollang.compiler.semantic.storage_placement_source_index as sourceIndex
import sollang.compiler.semantic.storage_placement_units as sourceUnits
import sollang.compiler.semantic.storage_placement_inline_frames as inlineFrames
import sollang.compiler.semantic.storage_placement_package as framePackage
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.ir.typed as typedIr
import sollang.compiler.diagnostics as diagnostics
import sys.process as process

main {
    """
    work<N> value: Int -> Int where N: Int {
        [value; N] => values
        values -> len
    }
    main { 7 -> work<3> -> println }
    """ => source
    [source,; ~] -> semanticContext.prepare => prepared
    prepared -> expressionTypes.resolveContext => facts
    0 => symbolIndex!
    prepared.package.symbols -> each symbol {
        prepared.package.tokens[symbol.nameToken] => token
        "symbol:$(symbolIndex!):$(symbol.kind):$(symbol.parent):$(symbol.astNode):$(source -> slice(token.span.start, token.span.length))" -> println
        symbolIndex! + 1 => symbolIndex!
    }
    prepared -> typedIr.lowerResolvedContext(facts) => ir
    0 => i!
    ir -> each node {
        node.kind == 0 or node.kind == 10 -> if {
            "ir:$(i!):$(node.kind):$(node.symbol):$(node.operand1):$(node.nextOperand)" -> println
        }
        i! + 1 => i!
    }
}
