# Match IntDictionaryLayout.CapacityForLength for populated literals and hints.
# A typed empty dictionary without a hint keeps its null, zero-capacity owner.
dictionaryLiteralCapacity length: Int, capacityHint: Int -> Int64 {
    length == 0 and capacityHint < 0 -> if { 0 -> return }
    Int64(length) => requested!
    capacityHint >= 0 -> if { Int64(capacityHint) => requested! }
    requested! * 2 => minimum!
    minimum! < 4 -> if { 4 => minimum! }
    Int64(1) => capacity!
    capacity! < minimum! -> while { capacity! * 2 => capacity! }
    capacity!
}

struct DictionaryLiteralSlotRequest {
    dictionaryIndex: Int
    ownerIndex: Int
    entryPosition: Int
    keyIndex: Int
    keyTypeId: Int
    hashWidth: Int
    hashMethod: Int
    capacity: Int64
    valueTypeId: Int
    valueSymbol: Int
    entryLayout: DictionaryEntryLayout
}

struct SocketCallRequest {
    callIndex: Int
    ownerIndex: Int
}

isDirectEachEmission nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.ir[nodeIndex] => node
    node.kind == 6 and (node.opcode -> typedIr.isDirectIterationOpcode)
        and node.operand0 >= 0 and node.operand1 >= 0
        and (nodeIndex -> plannedStreamPipeline(context, state)) < 0
}

# LLVM allocas execute each time control reaches them. Fixed-size result and
# scratch slots therefore belong to the owning function entry, never to a loop
# or branch body.
emitHoistedControlAllocas ownerIndex: Int, startIndex: Int, endIndex: Int, includeParameters: Bool, profile: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    includeParameters -> if {
        0 => pathOwnedParameterOrdinal!
        context -> parameterIndexAtOrdinal(ownerIndex, pathOwnedParameterOrdinal!) => pathOwnedParameterIndex!
        pathOwnedParameterIndex! >= 0 -> while {
            pathOwnedParameterIndex! -> moveParameterNeedsPathOwnershipFlag(ownerIndex, context, state)
                -> if {
                    "  %arg$(pathOwnedParameterIndex!)_owned = alloca i1, align 1" -> println
                    "  store i1 true, ptr %arg$(pathOwnedParameterIndex!)_owned, align 1" -> println
                }
            pathOwnedParameterOrdinal! + 1 => pathOwnedParameterOrdinal!
            context -> parameterIndexAtOrdinal(ownerIndex, pathOwnedParameterOrdinal!) => pathOwnedParameterIndex!
        }
    }
    startIndex => nodeIndex!
    nodeIndex! < endIndex -> while {
        profile and (nodeIndex! - startIndex) % 256 == 0
            -> if { "control allocas owner $ownerIndex node $(nodeIndex!)" -> runtime.eprintln }
        context.ir[nodeIndex!] => node
        nodeIndex! -> emitDeferredTextCaptureAllocas(ownerIndex, context, state)
        node -> isBoundedDictionaryLiteral(context) -> if {
            node.typeId -> boundedDictionaryLayoutForType(context) => dictionaryLayout
            "  %v$(nodeIndex!)_owner = alloca %sollang.bounded_dictionary.t$(node.typeId), align $(dictionaryLayout.align)" -> println
        }
        nodeIndex! -> boundedDictionaryIndexScratchTypeId(context, state) => dictionaryScratchType
        dictionaryScratchType >= 0 -> if {
            dictionaryScratchType -> boundedDictionaryLayoutForType(context) => dictionaryLayout
            "  %bidx$(nodeIndex!)_owner = alloca %sollang.bounded_dictionary.t$(dictionaryScratchType), align $(dictionaryLayout.align)" -> println
        }
        nodeIndex! -> isDirectEachEmission(context, state)
            -> if {
                not (nodeIndex! -> asyncIntIteratorIsPersistent(context, state))
                    -> if {
                        "  %each$(nodeIndex!)_index_slot = alloca i64, align 8" -> println
                        (context.ir[node.operand0] -> typeQueries.isRange(context)) or node.opcode == typedIr.repeatOpcode()
                            -> if {
                                "  %each$(nodeIndex!)_limit_slot = alloca i64, align 8" -> println
                            }
                    }
            }
        node.kind == 14 and (node -> isFixedArrayType) and not (nodeIndex! -> fixedArrayLiteralNeedsHeap(context, state))
            -> if {
                0 => fixedArrayLength!
                node.operand0 => fixedArrayElementIndex!
                fixedArrayElementIndex! >= 0 -> while {
                    fixedArrayLength! + 1 => fixedArrayLength!
                    context.ir[fixedArrayElementIndex!].nextOperand => fixedArrayElementIndex!
                }
                node.typeId >= 0
                    and context.types[node.typeId].kind == 4
                    and context.types[node.typeId].length >= 0
                    -> if { context.types[node.typeId].length => fixedArrayLength! }
                fixedArrayLength! * (node -> arrayElementSize(context, state)) => fixedArrayByteLength
                "  %v$(nodeIndex!)_data = alloca [$fixedArrayByteLength x i8], align " -> print
                node -> arrayElementAlign(context, state) -> writeDecimalLine
            }
        node.kind == 18 -> if {
            false => valueUsed!
            nodeIndex! -> controlValueUsed(ownerIndex, context, state) => valueUsed!
            valueUsed! and not (node.typeOrigin == 1 and node.typeSymbol == 0) and node.nextOperand >= 0
                -> if {
                    "  %if$(nodeIndex!)_result = alloca " -> print
                    node -> writeIrType(context, state)
                    ", align " -> print
                    node -> storageAlign(context, state) -> writeDecimalLine
                }
        }
        node.kind == 33 or node.kind == 34 -> if {
            nodeIndex! -> controlValueUsed(ownerIndex, context, state) => whenValueUsed!
            node.kind == 33
                and ownerIndex >= 0
                and ownerIndex < (context.ir -> len)
                and (context.ir[ownerIndex].kind == 0 or context.ir[ownerIndex].kind == 11)
                and context.ir[ownerIndex].operand0 >= 0
                and context.ir[ownerIndex].operand0 < (context.ir -> len)
                and context.ir[context.ir[ownerIndex].operand0].kind == 1
                and context.ir[context.ir[ownerIndex].operand0].operand0 == nodeIndex!
                -> if { true => whenValueUsed! }
            whenValueUsed! and not (node.typeOrigin == 1 and node.typeSymbol == 0)
                -> if {
                    "  %if$(nodeIndex!)_result = alloca " -> print
                    node -> writeIrType(context, state)
                    ", align " -> print
                    node -> storageAlign(context, state) -> writeDecimalLine
                }
        }
        node.kind == 27 and node.operand0 >= 0 -> if {
            node.operand0 -> materializedEnumSubject(context, state) => subject
            nodeIndex! => matchResultTypeIndex!
            node.typeOrigin == 1
                and node.typeSymbol == 0
                and ownerIndex >= 0
                and ownerIndex < (context.ir -> len)
                and (context.ir[ownerIndex].kind == 0 or context.ir[ownerIndex].kind == 11)
                and context.ir[ownerIndex].operand0 >= 0
                and context.ir[ownerIndex].operand0 < (context.ir -> len)
                -> if {
                    context.ir[ownerIndex].operand0 => matchResultOwnerBodyIndex
                    context.ir[matchResultOwnerBodyIndex].kind == 1
                        and context.ir[matchResultOwnerBodyIndex].operand0 == nodeIndex!
                        and not (context.ir[matchResultOwnerBodyIndex].typeOrigin == 1
                        and context.ir[matchResultOwnerBodyIndex].typeSymbol == 0)
                        -> if { matchResultOwnerBodyIndex => matchResultTypeIndex! }
                }
            context.ir[matchResultTypeIndex!] => matchResultType
            "  %v$(nodeIndex!)_subject_slot = alloca " -> print
            subject -> writeIrType(context, state)
            ", align 8" -> println
            nodeIndex! -> controlValueUsed(ownerIndex, context, state) => matchValueUsed!
            # A function body can return a control value directly through its
            # region edge without creating a separate value-consumer node.
            ownerIndex >= 0
                and ownerIndex < (context.ir -> len)
                and (context.ir[ownerIndex].kind == 0 or context.ir[ownerIndex].kind == 11)
                and context.ir[ownerIndex].operand0 >= 0
                and context.ir[ownerIndex].operand0 < (context.ir -> len)
                -> if {
                    context.ir[ownerIndex].operand0 => functionBodyIndex
                    context.ir[functionBodyIndex].kind == 1
                        and context.ir[functionBodyIndex].operand0 == nodeIndex!
                        -> if { true => matchValueUsed! }
                }
            matchValueUsed!
                and (nodeIndex! -> enumMatchHasConcreteArmValues(context, state))
                and not (matchResultType.typeOrigin == 1 and matchResultType.typeSymbol == 0)
                -> if {
                    "  %v$(nodeIndex!)_result = alloca " -> print
                    matchResultType -> writeIrType(context, state)
                    ", align " -> print
                    matchResultType -> storageAlign(context, state) -> writeDecimalLine
                }
        }
        # A moved enum payload can be initialized in only one branch while its
        # cleanup flag is cleared at a later merge shared by sibling branches.
        # Hoist the flag itself to the function entry and initialize it false;
        # the selected arm changes it to true after loading the payload.
        nodeIndex! -> namedBindingNeedsOwnershipFlag(state)
            -> if {
                "  %v$(nodeIndex!)_owned = alloca i1, align 1" -> println
                "  store i1 true, ptr %v$(nodeIndex!)_owned, align 1" -> println
            }
        node.kind == 27 -> if {
            node.operand1 => ownedArmIndex!
            ownedArmIndex! >= 0 -> while {
                ownedArmIndex! -> matchArmBindingValueIndex(context, state)
                    => ownedArmBindingIndex
                ownedArmBindingIndex -> patternBindingNeedsOwnershipFlag(context, state)
                    -> if {
                        "  %v$(ownedArmBindingIndex)_owned = alloca i1, align 1" -> println
                        "  store i1 false, ptr %v$(ownedArmBindingIndex)_owned, align 1" -> println
                    }
                context.ir[ownedArmIndex!].nextOperand => ownedArmIndex!
            }
        }
        (node.kind == 6 or node.kind == 9)
            and (node.opcode == -216 or node.opcode == -217 or node.opcode == -304 or node.opcode == -305)
            -> if {
                "  %v$(nodeIndex!)_file_result_slot = alloca " -> print
                node -> writeIrType(context, state)
                ", align 8" -> println
            }
        (node.kind == 6 or node.kind == 9)
            and (node.opcode -> typedIr.isSocketResultOpcode)
            -> if {
                "  %v$(nodeIndex!)_socket_result_slot = alloca " -> print
                node -> writeIrType(context, state)
                ", align 8" -> println
            }
        (node.kind == 6 or node.kind == 9)
            and node.opcode == -221
            and node.operand0 >= 0
            and context.ir[node.operand0].nextOperand >= 0
            -> if {
                node.operand0 => scalarArgumentIndex!
                context.ir[scalarArgumentIndex!].nextOperand => offsetArgumentIndex!
                context.ir[offsetArgumentIndex!].nextOperand >= 0
                    -> while {
                        offsetArgumentIndex! => scalarArgumentIndex!
                        context.ir[offsetArgumentIndex!].nextOperand => offsetArgumentIndex!
                    }
                scalarArgumentIndex! -> aggregateValueIndex(context, state) => scalarIndex
                context.ir[scalarIndex] => scalar
                scalar.typeId => scalarTypeId!
                scalarTypeId! < 0 -> if { scalar.typeSymbol => scalarTypeId! }
                "  %v$(nodeIndex!)_file_write_slot = alloca " -> print
                scalarTypeId! -> writeSemanticTypeId(context, state)
                ", align " -> print
                context.typeAligns[scalarTypeId!] -> writeDecimalLine
                "  %v$(nodeIndex!)_file_result_slot = alloca " -> print
                node -> writeIrType(context, state)
                ", align 8" -> println
            }
        (node.kind == 6 or node.kind == 9) and node.opcode == -314
            -> if {
                node.operand0 -> aggregateValueIndex(context, state) => scalarIndex
                context.ir[scalarIndex] => scalar
                scalar.typeId => scalarTypeId!
                scalarTypeId! < 0 -> if { scalar.typeSymbol => scalarTypeId! }
                "  %v$(nodeIndex!)_file_write_slot = alloca " -> print
                scalarTypeId! == 23 -> if { "i8" -> print } else { scalarTypeId! -> writeSemanticTypeId(context, state) }
                ", align " -> print
                context.typeAligns[scalarTypeId!] -> writeDecimalLine
            }
        (node.kind == 6 or node.kind == 9) and (node.opcode == -220 or node.opcode == -317)
            -> if {
                context.types[node.typeId].first => optionTypeId
                context.types[optionTypeId].first => scalarTypeId
                "  %v$(nodeIndex!)_file_read_slot = alloca " -> print
                scalarTypeId == 23 -> if { "i8" -> print } else { scalarTypeId -> writeSemanticTypeId(context, state) }
                ", align " -> print
                context.typeAligns[scalarTypeId] -> writeDecimalLine
                "  %v$(nodeIndex!)_file_result_slot = alloca " -> print
                node -> writeIrType(context, state)
                ", align 8" -> println
                "  %v$(nodeIndex!)_file_option_slot = alloca " -> print
                optionTypeId -> writeSemanticTypeId(context, state)
                ", align 8" -> println
            }
        nodeIndex! + 1 => nodeIndex!
    }
    profile -> if { "control allocas owner $ownerIndex complete" -> runtime.eprintln }
}

# Stack-owned orchestration state shared by the responsibility fragments.
# Every extracted helper receives `ref CoreEmitterState`, so the large context
# and immutable lookup snapshots are never copied and no wrapper allocation is
# introduced.
struct BodySchedulePlan {
    functionIndex: Int
    order: [Int; ~]
    scheduled: [Bool; ~]
    emitMutableSlots: Bool
    failureNode: Int
    failureTerminal: Int
}
struct CoreEmitterState {
    frozenCanonicalInterpolationRootByIr: [Int; ~]
    frozenDeferredTextValues: [Bool; ~]
    frozenDeferredTextCaptureLeaves: [Bool; ~]
    coroutine: typedIr.CoroutineTables
    bodySchedules: [BodySchedulePlan; ~]
    frozenFunctionEnds: [Int; ~]
    frozenFirstIrChildByParent: [Int; ~]
    frozenNextIrSiblingByNode: [Int; ~]
    frozenValuesHaveFunctionLocalDirectBindings: [Bool; ~]
    frozenReachableFunctions: [Bool; ~]
    frozenCaptureFunctionsBySymbol: [Int; ~]
    frozenFunctionsHaveDeclaredEffectsBySymbol: [Bool; ~]
    frozenFunctionCaptureOffsets: [Int; ~]
    frozenFunctionCaptureCounts: [Int; ~]
    frozenFunctionCaptureValues: [Int; ~]
    frozenEnumMatchConsumed: [Bool; ~]
    frozenNamedBindingPathOwned: [Bool; ~]
    intrinsicRuntimeModule: Int
}

public struct TypeLayoutRequest {
    public types: [typeIds.SemanticType; ~]
    public fields: [typeIds.NominalField; ~]
    public typeId: Int
    public pointerBitWidth: Int
}

public struct TypeLayout {
    public size: Int
    public align: Int
    # 0 known, 1 unresolved recursive dependency, 2 unsupported type.
    public status: Int
}

public struct TypeLayouts {
    public sizes: [Int; ~]
    public aligns: [Int; ~]
    public statuses: [Int; ~]
}

# A fixed array's backing bytes and its value stored in another aggregate
# have different layouts. The latter is the { ptr, i64 } value ABI.
public aggregateFieldLayout fieldType: typeIds.SemanticType, payloadSize: Int, payloadAlign: Int -> TypeLayout {
    TypeLayout { size: payloadSize, align: payloadAlign, status: 0 } => result!
    fieldType.kind == 4 -> if { TypeLayout { size: 16, align: 8, status: 0 } => result! }
    result!
}

struct DictionaryEntryLayout {
    valueOffset: Int
    stride: Int
    align: Int
}

dictionaryEntryLayout keySize: Int, keyAlign: Int, valueSize: Int, valueAlign: Int -> DictionaryEntryLayout {
    keyAlign => align!
    valueAlign > align! -> if { valueAlign => align! }
    ((keySize + valueAlign - 1) / valueAlign) * valueAlign => valueOffset
    ((valueOffset + valueSize + align! - 1) / align!) * align! => stride
    DictionaryEntryLayout { valueOffset: valueOffset, stride: stride, align: align! }
}

dictionaryEntryLayoutForTypeIds keyTypeId: Int, valueTypeId: Int, keySymbol: Int, valueSymbol: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> DictionaryEntryLayout {
    keySymbol -> storageSize(context, state) => keySize!
    valueSymbol -> storageSize(context, state) => valueSize!
    keySymbol -> legacyStorageAlign(context, state) => keyAlign!
    valueSymbol -> legacyStorageAlign(context, state) => valueAlign!
    keyTypeId >= 0 -> if {
        context.typeSizes[keyTypeId] => keySize!
        context.typeAligns[keyTypeId] => keyAlign!
    }
    valueTypeId >= 0 -> if {
        context.typeSizes[valueTypeId] => valueSize!
        context.typeAligns[valueTypeId] => valueAlign!
    }
    keySize! -> dictionaryEntryLayout(keyAlign!, valueSize!, valueAlign!)
}

emitGrowableDictionaryPointers prefix: Text, storagePointer: Text, capacity: Text, layout: DictionaryEntryLayout -> Unit uses Console {
    "  %$(prefix)_controls = getelementptr i8, ptr $(storagePointer), i64 0" -> println
    "  %$(prefix)_entries_mirror = add i64 $(capacity), 23" -> println
    "  %$(prefix)_entries_offset = and i64 %$(prefix)_entries_mirror, -8" -> println
    "  %$(prefix)_keys = getelementptr i8, ptr $(storagePointer), i64 %$(prefix)_entries_offset" -> println
    "  %$(prefix)_values = getelementptr i8, ptr %$(prefix)_keys, i64 $(layout.valueOffset)" -> println
}

emitGrowableDictionaryAllocation prefix: Text, capacity: Text, layout: DictionaryEntryLayout -> Unit uses Console {
    "  %$(prefix)_allocation_mirror = add i64 $(capacity), 23" -> println
    "  %$(prefix)_allocation_offset = and i64 %$(prefix)_allocation_mirror, -8" -> println
    "  %$(prefix)_entry_bytes = mul i64 $(capacity), $(layout.stride)" -> println
    "  %$(prefix)_allocation_bytes = add i64 %$(prefix)_allocation_offset, %$(prefix)_entry_bytes" -> println
    "  %$(prefix)_storage = call ptr @malloc(i64 %$(prefix)_allocation_bytes)" -> println
    "  %$(prefix)_allocated = icmp ne ptr %$(prefix)_storage, null" -> println
    "  br i1 %$(prefix)_allocated, label %$(prefix)_allocation_ready, label %$(prefix)_allocation_failed" -> println
    "$(prefix)_allocation_failed:" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "$(prefix)_allocation_ready:" -> println
    prefix -> emitGrowableDictionaryPointers("%$(prefix)_storage", capacity, layout)
    "  %$(prefix)_control_bytes = add i64 $(capacity), 16" -> println
    "  call void @llvm.memset.p0.i64(ptr %$(prefix)_controls, i8 0, i64 %$(prefix)_control_bytes, i1 false)" -> println
}

emitGrowableDictionaryOwner prefix: Text, storagePointer: Text, length: Text, capacity: Text -> Unit uses Console {
    "  %$(prefix)_0 = insertvalue %sollang.dict poison, ptr $(storagePointer), 0" -> println
    "  %$(prefix)_1 = insertvalue %sollang.dict %$(prefix)_0, i64 $(length), 1" -> println
    "  %$(prefix) = insertvalue %sollang.dict %$(prefix)_1, i64 $(capacity), 2" -> println
}

writeDictionaryEntryStorageType layout: DictionaryEntryLayout -> Unit uses Console {
    "[$(layout.stride) x i8]" -> print
}

emitDictionaryEntryPointer prefix: Text, storagePointer: Text, slot: Text, entriesOffset: Text, fieldOffset: Int, entryStride: Int -> Unit uses Console {
    "  %$(prefix)_entry_offset = mul i64 $(slot), $(entryStride)" -> println
    "  %$(prefix)_entries_field_offset = add i64 $(entriesOffset), $(fieldOffset)" -> println
    "  %$(prefix)_field_offset = add i64 %$(prefix)_entry_offset, %$(prefix)_entries_field_offset" -> println
    "  %$(prefix)_ptr = getelementptr i8, ptr $(storagePointer), i64 %$(prefix)_field_offset" -> println
}

# One lookup contract shared by dictionary read, mutation and rehash consumers.
# The caller materializes the query and hash once before entering this CFG.
struct DictionaryProbe {
    prefix: Text
    controls: Text
    keys: Text
    capacity: Text
    query: Text
    hash: Text
    h2: Text
    keyTypeId: Int
    keySymbol: Int
    valueTypeId: Int
    valueSymbol: Int
    entryLayout: DictionaryEntryLayout
    existingOnly: Bool
    bounded: Bool
}

dictionaryProbeIsIntKey probe: ref DictionaryProbe, context: ref emitterContext.EmitContext -> Bool {
    probe.keyTypeId >= 0 -> if {
        context.types[probe.keyTypeId] => keyType
        keyType.kind == 1 and keyType.origin == 1 and keyType.symbol == 2
    } else { probe.keySymbol == 2 }
}

dictionaryProbeIntegerWidth probe: ref DictionaryProbe, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    probe.keyTypeId >= 0 -> if {
        context.types[probe.keyTypeId] => keyType
        keyType.kind == 1 and keyType.origin == 1 -> if {
            keyType.symbol -> integerWidth(context, state)
        } else { 0 }
    } else { probe.keySymbol -> integerWidth(context, state) }
}

dictionaryProbeIsIntDictionary probe: ref DictionaryProbe, context: ref emitterContext.EmitContext -> Bool {
    probe.bounded -> if { false -> return }
    probe -> dictionaryProbeIsIntKey(context) -> unless { false -> return }
    probe.valueTypeId >= 0 -> if {
        context.types[probe.valueTypeId] => valueType
        valueType.kind == 1 and valueType.origin == 1 and valueType.symbol == 2
    } else { probe.valueSymbol == 2 }
}

writeDictionaryProbeKeyType probe: ref DictionaryProbe, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    probe.keyTypeId >= 0 -> if { probe.keyTypeId -> writeSemanticTypeId(context, state) } else { probe.keySymbol -> llvmType(context, state) -> print }
}

emitDictionaryProbeEquality probe: ref DictionaryProbe, prefix: Text, stored: Text, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    probe.keyTypeId >= 0 -> if {
        context.types[probe.keyTypeId] => keyType
        (keyType.kind == 1 and keyType.origin == 1 and keyType.symbol == 1) => textKey
        probe.keyTypeId -> traitMethodSymbol("Hash", "hash", context, state) => hashMethod
        probe.keyTypeId -> traitMethodSymbol("Eq", "eq", context, state) => eqMethod
        prefix -> emitSetEquality(stored, probe.query, probe.keyTypeId, eqMethod, textKey, hashMethod >= 0 and eqMethod >= 0, context, state)
    } else {
        "  %$(prefix)_equal = icmp eq " -> print
        probe -> writeDictionaryProbeKeyType(context, state)
        " $(stored), $(probe.query)" -> println
    }
}

emitDictionaryGroupedFindSlot probe: ref DictionaryProbe, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    probe.prefix => prefix
    not probe.existingOnly and not (probe -> dictionaryProbeIsIntDictionary(context)) => retainDeleted
    "  %$(prefix)_mask = sub i64 $(probe.capacity), 1" -> println
    "  %$(prefix)_start = and i64 $(probe.hash), %$(prefix)_mask" -> println
    "  br label %$(prefix)_entry" -> println
    "$(prefix)_entry:" -> println
    "  br label %$(prefix)_group" -> println
    "$(prefix)_group:" -> println
    "  %$(prefix)_probe = phi i64 [ 0, %$(prefix)_entry ], [ %$(prefix)_next_probe, %$(prefix)_next_group ]" -> println
    retainDeleted -> if {
        "  %$(prefix)_first_deleted = phi i64 [ $(probe.capacity), %$(prefix)_entry ], [ %$(prefix)_next_deleted, %$(prefix)_next_group ]" -> println
    }
    "  %$(prefix)_active = icmp ult i64 %$(prefix)_probe, $(probe.capacity)" -> println
    "  br i1 %$(prefix)_active, label %$(prefix)_body, label %$(prefix)_miss" -> println
    "$(prefix)_body:" -> println
    "  %$(prefix)_unwrapped = add i64 %$(prefix)_start, %$(prefix)_probe" -> println
    "  %$(prefix)_group_start = and i64 %$(prefix)_unwrapped, %$(prefix)_mask" -> println
    "  %$(prefix)_control_ptr = getelementptr i8, ptr $(probe.controls), i64 %$(prefix)_group_start" -> println
    "  %$(prefix)_controls = load <16 x i8>, ptr %$(prefix)_control_ptr, align 1" -> println
    "  %$(prefix)_h2_seed = insertelement <16 x i8> poison, i8 $(probe.h2), i64 0" -> println
    "  %$(prefix)_h2_vector = shufflevector <16 x i8> %$(prefix)_h2_seed, <16 x i8> poison, <16 x i32> zeroinitializer" -> println
    "  %$(prefix)_matches = icmp eq <16 x i8> %$(prefix)_controls, %$(prefix)_h2_vector" -> println
    "  %$(prefix)_match_bits = bitcast <16 x i1> %$(prefix)_matches to i16" -> println
    "  %$(prefix)_empties = icmp eq <16 x i8> %$(prefix)_controls, zeroinitializer" -> println
    "  %$(prefix)_empty_bits = bitcast <16 x i1> %$(prefix)_empties to i16" -> println
    retainDeleted -> if {
        "  %$(prefix)_deleted_seed = insertelement <16 x i8> poison, i8 -1, i64 0" -> println
        "  %$(prefix)_deleted_vector = shufflevector <16 x i8> %$(prefix)_deleted_seed, <16 x i8> poison, <16 x i32> zeroinitializer" -> println
        "  %$(prefix)_deleted_matches = icmp eq <16 x i8> %$(prefix)_controls, %$(prefix)_deleted_vector" -> println
        "  %$(prefix)_deleted_bits = bitcast <16 x i1> %$(prefix)_deleted_matches to i16" -> println
        "  %$(prefix)_has_deleted = icmp ne i16 %$(prefix)_deleted_bits, 0" -> println
        "  %$(prefix)_no_previous_deleted = icmp eq i64 %$(prefix)_first_deleted, $(probe.capacity)" -> println
        "  %$(prefix)_capture_deleted = and i1 %$(prefix)_has_deleted, %$(prefix)_no_previous_deleted" -> println
        "  %$(prefix)_deleted_offset16 = call i16 @llvm.cttz.i16(i16 %$(prefix)_deleted_bits, i1 false)" -> println
        "  %$(prefix)_deleted_offset = zext i16 %$(prefix)_deleted_offset16 to i64" -> println
        "  %$(prefix)_deleted_unwrapped = add i64 %$(prefix)_group_start, %$(prefix)_deleted_offset" -> println
        "  %$(prefix)_deleted_slot = and i64 %$(prefix)_deleted_unwrapped, %$(prefix)_mask" -> println
        "  %$(prefix)_captured_deleted = select i1 %$(prefix)_capture_deleted, i64 %$(prefix)_deleted_slot, i64 %$(prefix)_first_deleted" -> println
    }
    "  br label %$(prefix)_candidates" -> println
    "$(prefix)_candidates:" -> println
    "  %$(prefix)_candidate_bits = phi i16 [ %$(prefix)_match_bits, %$(prefix)_body ], [ %$(prefix)_cleared_bits, %$(prefix)_candidate_next ]" -> println
    "  %$(prefix)_has_candidate = icmp ne i16 %$(prefix)_candidate_bits, 0" -> println
    "  br i1 %$(prefix)_has_candidate, label %$(prefix)_candidate, label %$(prefix)_decision" -> println
    "$(prefix)_candidate:" -> println
    "  %$(prefix)_candidate_offset16 = call i16 @llvm.cttz.i16(i16 %$(prefix)_candidate_bits, i1 false)" -> println
    "  %$(prefix)_candidate_offset = zext i16 %$(prefix)_candidate_offset16 to i64" -> println
    "  %$(prefix)_candidate_unwrapped = add i64 %$(prefix)_group_start, %$(prefix)_candidate_offset" -> println
    "  %$(prefix)_candidate_slot = and i64 %$(prefix)_candidate_unwrapped, %$(prefix)_mask" -> println
    "  %$(prefix)_key_ptr = getelementptr " -> print
    probe.entryLayout -> writeDictionaryEntryStorageType
    ", ptr $(probe.keys), i64 %$(prefix)_candidate_slot" -> println
    "  %$(prefix)_key = load " -> print
    probe -> writeDictionaryProbeKeyType(context, state)
    ", ptr %$(prefix)_key_ptr, align " -> print
    probe.keyTypeId >= 0 -> if { context.typeAligns[probe.keyTypeId] -> writeDecimalLine } else { probe.keySymbol -> legacyStorageAlign(context, state) -> writeDecimalLine }
    probe -> emitDictionaryProbeEquality("$(prefix)_candidate", "%$(prefix)_key", context, state)
    "  br i1 %$(prefix)_candidate_equal, label %$(prefix)_match, label %$(prefix)_candidate_next" -> println
    "$(prefix)_candidate_next:" -> println
    "  %$(prefix)_bits_minus_one = sub i16 %$(prefix)_candidate_bits, 1" -> println
    "  %$(prefix)_cleared_bits = and i16 %$(prefix)_candidate_bits, %$(prefix)_bits_minus_one" -> println
    "  br label %$(prefix)_candidates" -> println
    "$(prefix)_decision:" -> println
    "  %$(prefix)_has_empty = icmp ne i16 %$(prefix)_empty_bits, 0" -> println
    probe.existingOnly -> if {
        "  br i1 %$(prefix)_has_empty, label %$(prefix)_miss, label %$(prefix)_next_group" -> println
    } else {
        "  br i1 %$(prefix)_has_empty, label %$(prefix)_empty, label %$(prefix)_next_group" -> println
        "$(prefix)_empty:" -> println
        "  %$(prefix)_empty_offset16 = call i16 @llvm.cttz.i16(i16 %$(prefix)_empty_bits, i1 false)" -> println
        "  %$(prefix)_empty_offset = zext i16 %$(prefix)_empty_offset16 to i64" -> println
        "  %$(prefix)_empty_unwrapped = add i64 %$(prefix)_group_start, %$(prefix)_empty_offset" -> println
        "  %$(prefix)_empty_slot = and i64 %$(prefix)_empty_unwrapped, %$(prefix)_mask" -> println
        retainDeleted -> if {
            "  %$(prefix)_use_empty = icmp eq i64 %$(prefix)_captured_deleted, $(probe.capacity)" -> println
            "  %$(prefix)_insertion_slot = select i1 %$(prefix)_use_empty, i64 %$(prefix)_empty_slot, i64 %$(prefix)_captured_deleted" -> println
        }
        "  br label %$(prefix)_done" -> println
    }
    "$(prefix)_match:" -> println
    "  br label %$(prefix)_done" -> println
    "$(prefix)_next_group:" -> println
    "  %$(prefix)_next_probe = add i64 %$(prefix)_probe, 16" -> println
    retainDeleted -> if { "  %$(prefix)_next_deleted = add i64 %$(prefix)_captured_deleted, 0" -> println }
    "  br label %$(prefix)_group" -> println
    "$(prefix)_miss:" -> println
    retainDeleted -> if {
        "  %$(prefix)_no_deleted = icmp eq i64 %$(prefix)_first_deleted, $(probe.capacity)" -> println
        "  %$(prefix)_miss_slot = select i1 %$(prefix)_no_deleted, i64 0, i64 %$(prefix)_first_deleted" -> println
    }
    "  br label %$(prefix)_done" -> println
    "$(prefix)_done:" -> println
    probe.existingOnly -> if {
        "  %$(prefix)_found = phi i1 [ true, %$(prefix)_match ], [ false, %$(prefix)_miss ]" -> println
        "  %$(prefix)_slot = phi i64 [ %$(prefix)_candidate_slot, %$(prefix)_match ], [ 0, %$(prefix)_miss ]" -> println
    } else {
        "  %$(prefix)_found = phi i1 [ false, %$(prefix)_empty ], [ true, %$(prefix)_match ], [ false, %$(prefix)_miss ]" -> println
        "  %$(prefix)_slot = phi i64 [ " -> print
        retainDeleted -> if { "%$(prefix)_insertion_slot" -> print } else { "%$(prefix)_empty_slot" -> print }
        ", %$(prefix)_empty ], [ %$(prefix)_candidate_slot, %$(prefix)_match ], [ " -> print
        retainDeleted -> if { "%$(prefix)_miss_slot" -> print } else { "0" -> print }
        ", %$(prefix)_miss ]" -> println
    }
}

emitDictionaryFindSlot probe: ref DictionaryProbe, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    (probe -> dictionaryProbeIntegerWidth(context, state)) > 0 and not (probe -> dictionaryProbeIsIntDictionary(context))
        -> unless {
            probe -> emitDictionaryGroupedFindSlot(context, state)
            return
        }
    probe.prefix => prefix
    "  %$(prefix)_mask = sub i64 $(probe.capacity), 1" -> println
    "  %$(prefix)_start = and i64 $(probe.hash), %$(prefix)_mask" -> println
    probe.existingOnly -> if {
        "  br label %$(prefix)_first" -> println
    } else {
        "  %$(prefix)_has_capacity = icmp ugt i64 $(probe.capacity), 0" -> println
        "  br i1 %$(prefix)_has_capacity, label %$(prefix)_first, label %$(prefix)_no_capacity" -> println
        "$(prefix)_no_capacity:" -> println
        "  br label %$(prefix)_done" -> println
    }
    "$(prefix)_first:" -> println
    "  %$(prefix)_control_ptr = getelementptr i8, ptr $(probe.controls), i64 %$(prefix)_start" -> println
    "  %$(prefix)_control = load i8, ptr %$(prefix)_control_ptr, align 1" -> println
    "  %$(prefix)_empty = icmp eq i8 %$(prefix)_control, 0" -> println
    "  br i1 %$(prefix)_empty, label %$(prefix)_vacant, label %$(prefix)_occupied" -> println
    "$(prefix)_occupied:" -> println
    "  %$(prefix)_h2_match = icmp eq i8 %$(prefix)_control, $(probe.h2)" -> println
    "  br i1 %$(prefix)_h2_match, label %$(prefix)_compare, label %$(prefix)_fallback" -> println
    "$(prefix)_compare:" -> println
    "  %$(prefix)_key_ptr = getelementptr " -> print
    probe.entryLayout -> writeDictionaryEntryStorageType
    ", ptr $(probe.keys), i64 %$(prefix)_start" -> println
    "  %$(prefix)_key = load " -> print
    probe -> writeDictionaryProbeKeyType(context, state)
    ", ptr %$(prefix)_key_ptr, align " -> print
    probe.keyTypeId >= 0 -> if { context.typeAligns[probe.keyTypeId] -> writeDecimalLine } else { probe.keySymbol -> legacyStorageAlign(context, state) -> writeDecimalLine }
    probe -> emitDictionaryProbeEquality(prefix, "%$(prefix)_key", context, state)
    "  br i1 %$(prefix)_equal, label %$(prefix)_match, label %$(prefix)_fallback" -> println
    "$(prefix)_match:" -> println
    "  br label %$(prefix)_done" -> println
    "$(prefix)_vacant:" -> println
    "  br label %$(prefix)_done" -> println
    "$(prefix)_fallback:" -> println
    probe => fallback!
    Arena(0) => probeLabels!
    "$(prefix)_grouped" -> materialize(probeLabels!) => fallback!.prefix
    fallback! -> emitDictionaryGroupedFindSlot(context, state)
    "  br label %$(prefix)_done" -> println
    "$(prefix)_done:" -> println
    "  %$(prefix)_found = phi i1 [ true, %$(prefix)_match ], [ false, %$(prefix)_vacant ], [ %$(prefix)_grouped_found, %$(prefix)_grouped_done ]" -> print
    probe.existingOnly -> unless { ", [ false, %$(prefix)_no_capacity ]" -> print }
    "" -> println
    "  %$(prefix)_slot = phi i64 [ %$(prefix)_start, %$(prefix)_match ], [ " -> print
    probe.existingOnly -> if { "0" -> print } else { "%$(prefix)_start" -> print }
    ", %$(prefix)_vacant ], [ %$(prefix)_grouped_slot, %$(prefix)_grouped_done ]" -> print
    probe.existingOnly -> unless { ", [ 0, %$(prefix)_no_capacity ]" -> print }
    "" -> println
}

struct BoundedDictionaryLayout {
    bucketCapacity: Int
    entriesOffset: Int
    entryStride: Int
    valueOffset: Int
    keyAlign: Int
    valueAlign: Int
    storageSize: Int
    size: Int
    align: Int
}

boundedDictionaryLayout capacity: Int, keySize: Int, keyAlign: Int, valueSize: Int, valueAlign: Int -> BoundedDictionaryLayout {
    Int((UInt64(capacity) * 8 + 6) / 7) => minimumBuckets
    16 => bucketCapacity!
    bucketCapacity! < minimumBuckets -> while { bucketCapacity! * 2 => bucketCapacity! }
    keySize -> dictionaryEntryLayout(keyAlign, valueSize, valueAlign) => entryLayout
    8 => align!
    entryLayout.align > align! -> if { entryLayout.align => align! }
    ((bucketCapacity! + 16 + entryLayout.align - 1) / entryLayout.align) * entryLayout.align => entriesOffset
    ((entriesOffset + bucketCapacity! * entryLayout.stride + align! - 1) / align!) * align! => storageSize
    ((8 + storageSize + align! - 1) / align!) * align! => size
    BoundedDictionaryLayout {
        bucketCapacity: bucketCapacity!
        entriesOffset: entriesOffset
        entryStride: entryLayout.stride
        valueOffset: entryLayout.valueOffset
        keyAlign: keyAlign
        valueAlign: valueAlign
        storageSize: storageSize
        size: size
        align: align!
    }
}

boundedDictionaryLayoutForType typeId: Int, context: ref emitterContext.EmitContext -> BoundedDictionaryLayout {
    context.types[typeId] => dictionaryType
    context.types[dictionaryType.first] -> aggregateFieldLayout(context.typeSizes[dictionaryType.first], context.typeAligns[dictionaryType.first]) => keyLayout
    context.types[dictionaryType.second] -> aggregateFieldLayout(context.typeSizes[dictionaryType.second], context.typeAligns[dictionaryType.second]) => valueLayout
    dictionaryType.length -> boundedDictionaryLayout(
    keyLayout.size, keyLayout.align, valueLayout.size, valueLayout.align)
}

# The value is { length, inline bytes }. Its storage address must always be
# derived from the current owner, never carried across a call or return.
emitBoundedDictionaryStoragePointer prefix: Text, ownerPointer: Text, typeId: Int -> Unit uses Console {
    "  %$(prefix)_storage = getelementptr inbounds %sollang.bounded_dictionary.t$(typeId), ptr $(ownerPointer), i32 0, i32 1, i32 0" -> println
}

emitBoundedDictionaryEntryPointer prefix: Text, storagePointer: Text, slot: Text, fieldOffset: Int, layout: BoundedDictionaryLayout -> Unit uses Console {
    prefix -> emitDictionaryEntryPointer(storagePointer, slot, "$(layout.entriesOffset)", fieldOffset, layout.entryStride)
}

# Bounded dictionaries share the generic probe but retain in-place tombstones,
# including Int/Int storage. Heap Int/Int's tombstone-free policy does not apply.
emitBoundedDictionaryProbe prefix: Text, storagePointer: Text, query: Text, hash: Text, h2: Text, dictionaryTypeId: Int, existingOnly: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.types[dictionaryTypeId] => dictionaryType
    dictionaryTypeId -> boundedDictionaryLayoutForType(context) => layout
    DictionaryEntryLayout {
        valueOffset: layout.valueOffset
        stride: layout.entryStride
        align: layout.align
    } => entryLayout
    "  %$(prefix)_probe_keys = getelementptr i8, ptr $(storagePointer), i64 $(layout.entriesOffset)" -> println
    Arena(0) => probePrefixStorage!
    "$(prefix)_group" -> materialize(probePrefixStorage!) => probePrefix
    Arena(0) => keysStorage!
    "%$(prefix)_probe_keys" -> materialize(keysStorage!) => keys
    Arena(0) => capacityStorage!
    "$(layout.bucketCapacity)" -> materialize(capacityStorage!) => capacity
    DictionaryProbe {
        prefix: probePrefix
        controls: storagePointer
        keys: keys
        capacity: capacity
        query: query
        hash: hash
        h2: h2
        keyTypeId: dictionaryType.first
        keySymbol: 0
        valueTypeId: dictionaryType.second
        valueSymbol: 0
        entryLayout: entryLayout
        existingOnly: existingOnly
        bounded: true
    } => probe
    probe -> emitDictionaryFindSlot(context, state)
    "  %$(prefix)_slot = add i64 %$(prefix)_group_slot, 0" -> println
    "  %$(prefix)_exists = or i1 %$(prefix)_group_found, false" -> println
}

emitDictionaryControlStore prefix: Text, storagePointer: Text, slot: Text, control: Text, capacity: Text -> Unit uses Console {
    "  %$(prefix)_control_ptr = getelementptr i8, ptr $(storagePointer), i64 $(slot)" -> println
    "  store i8 $(control), ptr %$(prefix)_control_ptr, align 1" -> println
    "  %$(prefix)_mirror_needed = icmp ult i64 $(slot), 16" -> println
    "  %$(prefix)_mirror_candidate = add i64 $(slot), $(capacity)" -> println
    "  %$(prefix)_mirror_slot = select i1 %$(prefix)_mirror_needed, i64 %$(prefix)_mirror_candidate, i64 $(slot)" -> println
    "  %$(prefix)_mirror_ptr = getelementptr i8, ptr $(storagePointer), i64 %$(prefix)_mirror_slot" -> println
    "  store i8 $(control), ptr %$(prefix)_mirror_ptr, align 1" -> println
}

emitBoundedDictionaryControlStore prefix: Text, storagePointer: Text, slot: Text, control: Text, layout: BoundedDictionaryLayout -> Unit uses Console {
    prefix -> emitDictionaryControlStore(storagePointer, slot, control, "$(layout.bucketCapacity)")
}

emitBoundedDictionaryLiteralOwner nodeIndex: Int, context: ref emitterContext.EmitContext -> Unit uses Console {
    context.ir[nodeIndex].typeId => dictionaryTypeId
    dictionaryTypeId -> boundedDictionaryLayoutForType(context) => layout
    "  store %sollang.bounded_dictionary.t$(dictionaryTypeId) zeroinitializer, ptr %v$(nodeIndex)_owner, align $(layout.align)" -> println
    "v$(nodeIndex)" -> emitBoundedDictionaryStoragePointer("%v$(nodeIndex)_owner", dictionaryTypeId)
}

emitEmptyBoundedDictionaryLiteral nodeIndex: Int, context: ref emitterContext.EmitContext -> Unit uses Console {
    nodeIndex -> emitBoundedDictionaryLiteralOwner(context)
    context.ir[nodeIndex].typeId => dictionaryTypeId
    dictionaryTypeId -> boundedDictionaryLayoutForType(context) => layout
    "  %v$(nodeIndex) = load %sollang.bounded_dictionary.t$(dictionaryTypeId), ptr %v$(nodeIndex)_owner, align $(layout.align)" -> println
}

isBoundedDictionaryLiteral node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext -> Bool {
    false => result!
    node.kind == 16 and node.typeId >= 0 and node.typeId < (context.types -> len)
        -> if { context.types[node.typeId].kind == 13
                -> if { true => result! } }
    result!
}

isEmptyBoundedDictionaryLiteral node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext -> Bool {
    node.operand0 < 0 and (node -> isBoundedDictionaryLiteral(context))
}

isPopulatedBoundedDictionaryLiteral node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext -> Bool {
    node.operand0 >= 0 and (node -> isBoundedDictionaryLiteral(context))
}

boundedDictionaryValueTypeId node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext -> Int {
    node.typeId => typeId!
    typeId! >= 0 and typeId! < (context.types -> len) and context.types[typeId!].kind == 8
        -> if { context.types[typeId!].first => typeId! }
    typeId! >= 0 and typeId! < (context.types -> len) and context.types[typeId!].kind == 13
        -> if { typeId! } else { -1 }
}

boundedDictionaryIndexScratchTypeId nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.ir[nodeIndex] => node
    node.kind != 15 or node.operand0 < 0 -> if { -1 -> return }
    context.ir[node.operand0] => source
    source -> boundedDictionaryValueTypeId(context) => typeId
    typeId < 0 -> if { -1 -> return }
    source.typeId >= 0 and context.types[source.typeId].kind == 8
        -> if { -1 -> return }
    source.kind == 5 and (node.operand0 -> mutableStorageRoot(context, state)) >= 0
        -> if { -1 -> return }
    typeId
}

emitBoundedDictionaryLiteralOperand nodeIndex: Int, ownerIndex: Int, typeId: Int, prefix: Text, storage: mut Arena, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Text uses Console, Process {
    context.ir[nodeIndex] => operand
    context.types[typeId].kind == 12 -> if {
        prefix -> emitBoundedArrayValue(nodeIndex, ownerIndex, typeId, context, state)
        "%$(prefix)" -> materialize(storage) -> return
    }
    operand.kind == 3 or operand.kind == 4 -> if {
        "%$(prefix)" -> materialize(storage) => valueName
        "  $(valueName) = add " -> print
        typeId -> writeSemanticTypeId(context, state)
        " 0, " -> print
        operand.kind == 3 -> if {
            operand -> writeIntegerLiteral(context, state)
        } else {
            operand -> sourceToken(context, state) => token
            (context.sources[operand.sourceModule] -> byte(token.span.start)) == 116
                -> if { "1" -> print } else { "0" -> print }
        }
        "" -> println
        valueName -> return
    }
    "%v$(nodeIndex)" -> materialize(storage)
}

emitPopulatedBoundedDictionaryLiteral nodeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[nodeIndex] => dictionaryNode
    dictionaryNode.typeId => dictionaryTypeId
    context.types[dictionaryTypeId] => dictionaryType
    dictionaryType.first => keyTypeId
    dictionaryType.second => valueTypeId
    context.types[keyTypeId] => keyType
    dictionaryTypeId -> boundedDictionaryLayoutForType(context) => layout
    nodeIndex -> emitBoundedDictionaryLiteralOwner(context)
    false => textKey!
    keyType.kind == 1 and keyType.origin == 1 and keyType.symbol == 1
        -> if { true => textKey! }
    keyTypeId -> traitMethodSymbol("Hash", "hash", context, state) => hashMethod
    keyTypeId -> traitMethodSymbol("Eq", "eq", context, state) => eqMethod
    keyType.symbol -> integerWidth(context, state) => keyWidth!
    keyType.symbol == 23 -> if { 1 => keyWidth! }
    keyType.symbol -> integerSigned(context, state) => keySigned
    dictionaryNode.operand0 => keyIndex!
    0 => entryIndex!
    keyIndex! >= 0 -> while {
        context.ir[keyIndex!] => keyNode
        keyNode.nextOperand => valueIndex
        context.ir[valueIndex] => valueNode
        Arena(0) => keyPrefixStorage!
        Arena(0) => valuePrefixStorage!
        Arena(0) => keyNameStorage!
        Arena(0) => valueNameStorage!
        Arena(0) => prefixStorage!
        "bd$(nodeIndex)_$(entryIndex!)_key_operand" -> materialize(keyPrefixStorage!) => keyOperandPrefix
        "bd$(nodeIndex)_$(entryIndex!)_value_operand" -> materialize(valuePrefixStorage!) => valueOperandPrefix
        keyIndex! -> emitBoundedDictionaryLiteralOperand(ownerIndex, keyTypeId, keyOperandPrefix, keyNameStorage!, context, state) => keyName
        valueIndex -> emitBoundedDictionaryLiteralOperand(ownerIndex, valueTypeId, valueOperandPrefix, valueNameStorage!, context, state) => valueName
        "bd$(nodeIndex)_$(entryIndex!)" -> materialize(prefixStorage!) => prefix
        textKey! -> if {
            "  %$(prefix)_hash = call i64 @sollang_dictionary_hash_text(%sollang.text $(keyName))" -> println
        } else {
            hashMethod >= 0 and eqMethod >= 0 -> if {
                "  %$(prefix)_hash_value = call i32 @sollang_m$(keyType.module)_s$(hashMethod)(" -> print
                keyTypeId -> writeSemanticTypeId(context, state)
                " $(keyName))" -> println
                "  %$(prefix)_hash_key = sext i32 %$(prefix)_hash_value to i64" -> println
            } else {
                "  %$(prefix)_hash_key = " -> print
                keyWidth! == 64 -> if { "add i64 0, " -> print } else {
                    keySigned -> if { "sext " -> print } else { "zext " -> print }
                    "i$(keyWidth!) " -> print
                }
                "$(keyName)" -> print
                keyWidth! == 64 -> if { "" -> println } else { " to i64" -> println }
            }
            "  %$(prefix)_hash_high = lshr i64 %$(prefix)_hash_key, 32" -> println
            "  %$(prefix)_hash_fold = xor i64 %$(prefix)_hash_key, %$(prefix)_hash_high" -> println
            "  %$(prefix)_hash = mul i64 %$(prefix)_hash_fold, -7046029254386353131" -> println
        }
        "  %$(prefix)_h2_shifted = lshr i64 %$(prefix)_hash, 57" -> println
        "  %$(prefix)_h2_raw = and i64 %$(prefix)_h2_shifted, 127" -> println
        "  %$(prefix)_h2_zero = icmp eq i64 %$(prefix)_h2_raw, 0" -> println
        "  %$(prefix)_h2_value = select i1 %$(prefix)_h2_zero, i64 1, i64 %$(prefix)_h2_raw" -> println
        "  %$(prefix)_h2 = trunc i64 %$(prefix)_h2_value to i8" -> println
        prefix -> emitBoundedDictionaryProbe("%v$(nodeIndex)_storage", keyName, "%$(prefix)_hash", "%$(prefix)_h2", dictionaryTypeId, false, context, state)
        "  br label %$(prefix)_insert" -> println
        "$(prefix)_insert:" -> println
        "$(prefix)_key" -> emitBoundedDictionaryEntryPointer("%v$(nodeIndex)_storage", "%$(prefix)_slot", 0, layout)
        "  store " -> print
        keyTypeId -> writeSemanticTypeId(context, state)
        " $(keyName), ptr %$(prefix)_key_ptr, align $(layout.keyAlign)" -> println
        "$(prefix)_value" -> emitBoundedDictionaryEntryPointer("%v$(nodeIndex)_storage", "%$(prefix)_slot", layout.valueOffset, layout)
        "  store " -> print
        valueTypeId -> writeAggregateFieldTypeId(context, state)
        " $(valueName), ptr %$(prefix)_value_ptr, align $(layout.valueAlign)" -> println
        "$(prefix)_control" -> emitBoundedDictionaryControlStore("%v$(nodeIndex)_storage", "%$(prefix)_slot", "%$(prefix)_h2", layout)
        valueNode.nextOperand => keyIndex!
        entryIndex! + 1 => entryIndex!
    }
    "  %v$(nodeIndex)_length_ptr = getelementptr inbounds %sollang.bounded_dictionary.t$(dictionaryTypeId), ptr %v$(nodeIndex)_owner, i32 0, i32 0" -> println
    "  store i64 $(entryIndex!), ptr %v$(nodeIndex)_length_ptr, align 8" -> println
    "  %v$(nodeIndex) = load %sollang.bounded_dictionary.t$(dictionaryTypeId), ptr %v$(nodeIndex)_owner, align $(layout.align)" -> println
}

emitBoundedDictionaryIndex nodeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[nodeIndex] => indexNode
    indexNode.operand0 => sourceIndex
    indexNode.operand1 => keyIndex
    context.ir[sourceIndex] => sourceNode
    sourceNode -> boundedDictionaryValueTypeId(context) => dictionaryTypeId
    context.types[dictionaryTypeId] => dictionaryType
    dictionaryType.first => keyTypeId
    dictionaryType.second => valueTypeId
    context.types[keyTypeId] => keyType
    dictionaryTypeId -> boundedDictionaryLayoutForType(context) => layout
    Arena(0) => prefixStorage!
    "bidx$(nodeIndex)" -> materialize(prefixStorage!) => prefix
    sourceNode.typeId >= 0 and context.types[sourceNode.typeId].kind == 8
        -> if {
            "  %$(prefix)_owner = freeze ptr " -> print
            sourceIndex -> writeValue(ownerIndex, context, state)
            "" -> println
        } else {
            sourceIndex -> mutableStorageRoot(context, state) => mutableRoot
            (nodeIndex -> boundedDictionaryIndexScratchTypeId(context, state)) < 0
                -> if {
                    "  %$(prefix)_owner = getelementptr i8, ptr %slot$(mutableRoot), i64 0" -> println
                } else {
                    "  store %sollang.bounded_dictionary.t$(dictionaryTypeId) " -> print
                    sourceIndex -> writeValue(ownerIndex, context, state)
                    ", ptr %$(prefix)_owner, align $(layout.align)" -> println
                }
        }
    prefix -> emitBoundedDictionaryStoragePointer("%$(prefix)_owner", dictionaryTypeId)
    "  %$(prefix)_query = freeze " -> print
    keyTypeId -> writeSemanticTypeId(context, state)
    " " -> print
    keyIndex -> writeValue(ownerIndex, context, state)
    "" -> println
    false => textKey!
    keyType.kind == 1 and keyType.origin == 1 and keyType.symbol == 1
        -> if { true => textKey! }
    keyTypeId -> traitMethodSymbol("Hash", "hash", context, state) => hashMethod
    keyTypeId -> traitMethodSymbol("Eq", "eq", context, state) => eqMethod
    keyType.symbol -> integerWidth(context, state) => keyWidth!
    keyType.symbol == 23 -> if { 1 => keyWidth! }
    keyType.symbol -> integerSigned(context, state) => keySigned
    textKey! -> if {
        "  %$(prefix)_hash = call i64 @sollang_dictionary_hash_text(%sollang.text %$(prefix)_query)" -> println
    } else {
        hashMethod >= 0 and eqMethod >= 0 -> if {
            "  %$(prefix)_hash_value = call i32 @sollang_m$(keyType.module)_s$(hashMethod)(" -> print
            keyTypeId -> writeSemanticTypeId(context, state)
            " %$(prefix)_query)" -> println
            "  %$(prefix)_hash_key = sext i32 %$(prefix)_hash_value to i64" -> println
        } else {
            "  %$(prefix)_hash_key = " -> print
            keyWidth! == 64 -> if { "add i64 0, " -> print } else {
                keySigned -> if { "sext " -> print } else { "zext " -> print }
                "i$(keyWidth!) " -> print
            }
            "%$(prefix)_query" -> print
            keyWidth! == 64 -> if { "" -> println } else { " to i64" -> println }
        }
        "  %$(prefix)_hash_high = lshr i64 %$(prefix)_hash_key, 32" -> println
        "  %$(prefix)_hash_fold = xor i64 %$(prefix)_hash_key, %$(prefix)_hash_high" -> println
        "  %$(prefix)_hash = mul i64 %$(prefix)_hash_fold, -7046029254386353131" -> println
    }
    "  %$(prefix)_h2_shifted = lshr i64 %$(prefix)_hash, 57" -> println
    "  %$(prefix)_h2_raw = and i64 %$(prefix)_h2_shifted, 127" -> println
    "  %$(prefix)_h2_zero = icmp eq i64 %$(prefix)_h2_raw, 0" -> println
    "  %$(prefix)_h2_value = select i1 %$(prefix)_h2_zero, i64 1, i64 %$(prefix)_h2_raw" -> println
    "  %$(prefix)_h2 = trunc i64 %$(prefix)_h2_value to i8" -> println
    prefix -> emitBoundedDictionaryProbe("%$(prefix)_storage", "%$(prefix)_query", "%$(prefix)_hash", "%$(prefix)_h2", dictionaryTypeId, true, context, state)
    "  br i1 %$(prefix)_exists, label %$(prefix)_found, label %$(prefix)_missing" -> println
    "$(prefix)_missing:" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "$(prefix)_found:" -> println
    "v$(nodeIndex)_value" -> emitBoundedDictionaryEntryPointer("%$(prefix)_storage", "%$(prefix)_slot", layout.valueOffset, layout)
    "  " -> print
    nodeIndex -> writeMemberStorageValueName(context, state)
    " = load " -> print
    valueTypeId -> writeAggregateFieldTypeId(context, state)
    ", ptr %v$(nodeIndex)_value_ptr, align $(layout.valueAlign)" -> println
    "v$(nodeIndex)" -> emitStoredBoundedValueHandle(valueTypeId, context, state)
}

# Emits a complete probe and leaves control in the found block with
# %<prefix>_slot live. Missing keys trap before any caller mutation.
emitBoundedDictionaryFindRequiredSlot prefix: Text, storagePointer: Text, keyName: Text, dictionaryTypeId: Int, existingOnly: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.types[dictionaryTypeId] => dictionaryType
    dictionaryType.first => keyTypeId
    context.types[keyTypeId] => keyType
    dictionaryTypeId -> boundedDictionaryLayoutForType(context) => layout
    false => textKey!
    keyType.kind == 1 and keyType.origin == 1 and keyType.symbol == 1
        -> if { true => textKey! }
    keyTypeId -> traitMethodSymbol("Hash", "hash", context, state) => hashMethod
    keyTypeId -> traitMethodSymbol("Eq", "eq", context, state) => eqMethod
    keyType.symbol -> integerWidth(context, state) => keyWidth!
    keyType.symbol == 23 -> if { 1 => keyWidth! }
    keyType.symbol -> integerSigned(context, state) => keySigned
    textKey! -> if {
        "  %$(prefix)_hash = call i64 @sollang_dictionary_hash_text(%sollang.text $(keyName))" -> println
    } else {
        hashMethod >= 0 and eqMethod >= 0 -> if {
            "  %$(prefix)_hash_value = call i32 @sollang_m$(keyType.module)_s$(hashMethod)(" -> print
            keyTypeId -> writeSemanticTypeId(context, state)
            " $(keyName))" -> println
            "  %$(prefix)_hash_key = sext i32 %$(prefix)_hash_value to i64" -> println
        } else {
            "  %$(prefix)_hash_key = " -> print
            keyWidth! == 64 -> if { "add i64 0, " -> print } else {
                keySigned -> if { "sext " -> print } else { "zext " -> print }
                "i$(keyWidth!) " -> print
            }
            "$(keyName)" -> print
            keyWidth! == 64 -> if { "" -> println } else { " to i64" -> println }
        }
        "  %$(prefix)_hash_high = lshr i64 %$(prefix)_hash_key, 32" -> println
        "  %$(prefix)_hash_fold = xor i64 %$(prefix)_hash_key, %$(prefix)_hash_high" -> println
        "  %$(prefix)_hash = mul i64 %$(prefix)_hash_fold, -7046029254386353131" -> println
    }
    "  %$(prefix)_h2_shifted = lshr i64 %$(prefix)_hash, 57" -> println
    "  %$(prefix)_h2_raw = and i64 %$(prefix)_h2_shifted, 127" -> println
    "  %$(prefix)_h2_zero = icmp eq i64 %$(prefix)_h2_raw, 0" -> println
    "  %$(prefix)_h2_value = select i1 %$(prefix)_h2_zero, i64 1, i64 %$(prefix)_h2_raw" -> println
    "  %$(prefix)_h2 = trunc i64 %$(prefix)_h2_value to i8" -> println
    prefix -> emitBoundedDictionaryProbe(storagePointer, keyName, "%$(prefix)_hash", "%$(prefix)_h2", dictionaryTypeId, existingOnly, context, state)
    "  br i1 %$(prefix)_exists, label %$(prefix)_found, label %$(prefix)_missing" -> println
    "$(prefix)_missing:" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "$(prefix)_found:" -> println
}

parameterIndexForFunction context: ref emitterContext.EmitContext, functionIndex: Int, symbol: Int -> Int {
    context.ir[functionIndex] => function
    function.operand1 => parameterIndex!
    0 => parameterOrdinal!
    -1 => matchedIndex!
    parameterIndex! >= 0 and matchedIndex! < 0 -> while {
        context.ir[parameterIndex!] => parameter
        symbol >= 0 and parameter.kind == 10 and parameter.symbol == symbol
            -> if {
                parameterIndex! => matchedIndex!
            } else {
                parameterOrdinal! == 0 -> if {
                    function.nextOperand => parameterIndex!
                } else {
                    parameter.nextOperand => parameterIndex!
                }
                parameterOrdinal! + 1 => parameterOrdinal!
            }
    }
    matchedIndex!
}

parameterIndexAtOrdinal context: ref emitterContext.EmitContext, functionIndex: Int, ordinal: Int -> Int {
    context.ir[functionIndex] => function
    function.operand1 => parameterIndex!
    0 => parameterOrdinal!
    parameterIndex! >= 0 and parameterOrdinal! < ordinal
        -> while {
            parameterOrdinal! == 0 -> if {
                function.nextOperand => parameterIndex!
            } else {
                context.ir[parameterIndex!].nextOperand => parameterIndex!
            }
            parameterOrdinal! + 1 => parameterOrdinal!
        }
    parameterOrdinal! == ordinal -> if { parameterIndex! } else { -1 }
}

writeParameterReference context: ref emitterContext.EmitContext, functionIndex: Int, symbol: Int -> Bool uses Console {
    context.ir[functionIndex] => function
    function.operand1 => parameterIndex!
    0 => parameterOrdinal!
    false => matched!
    parameterIndex! >= 0 and not matched! -> while {
        context.ir[parameterIndex!] => parameter
        symbol >= 0 and parameter.kind == 10 and parameter.symbol == symbol
            -> if {
                parameterOrdinal! == 0 -> if {
                    "%arg" -> print
                } else {
                    "%arg$(parameterOrdinal!)" -> print
                }
                true => matched!
            } else {
                parameterOrdinal! == 0 -> if {
                    function.nextOperand => parameterIndex!
                } else {
                    parameter.nextOperand => parameterIndex!
                }
                parameterOrdinal! + 1 => parameterOrdinal!
            }
    }
    matched!
}

isDirectEachRoleSymbol sourceModule: Int, symbolIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    sourceModule -> emitterContext.isDirectEachRoleSymbol(symbolIndex, context)
}

writeDirectEachRoleValue node: interpolation.InterpolationNode, sourceModule: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool uses Console {
    node -> directEachRoleTypeId(sourceModule, context, state) => typeId
    typeId >= 0 => matched
    matched -> if {
        beforeIndex -> asyncIntIteratorForRole(sourceModule, node.symbol, context, state) => iterator
        iterator >= 0 -> if {
            "%each_role_m$(sourceModule)_s$(node.symbol)_at$(beforeIndex)" -> print
        } else { "%each_role_m$(sourceModule)_s$(node.symbol)" -> print }
    }
    matched
}

directEachRoleTypeId node: interpolation.InterpolationNode, sourceModule: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    sourceModule -> emitterContext.directEachRoleSourceIr(node.symbol, context) => sourceIr
    sourceIr >= 0 -> if {
        context.ir[sourceIr] -> directEachElementTypeId(context, state)
    } else { -1 }
}

symbolUsedInInterpolation sourceModule: Int, symbolIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    false => used!
    sourceModule >= 0 and sourceModule < (context.interpolationRanges -> len)
        -> if {
            context.interpolationRanges[sourceModule] => interpolationRange
            0 => interpolationIndex!
            interpolationIndex! < interpolationRange.nodeCount and not used!
                -> while {
                    context.interpolations[interpolationRange.nodeStart + interpolationIndex!] => interpolationNode
                    interpolationNode.kind == 1 and interpolationNode.symbol == symbolIndex
                        -> if { true => used! }
                    interpolationIndex! + 1 => interpolationIndex!
                }
        }
    used!
}

valueHasDirectBinding nodeIndex: Int, state: ref CoreEmitterState -> Bool {
    nodeIndex >= 0
        and nodeIndex < (state.frozenValuesHaveFunctionLocalDirectBindings -> len)
        and state.frozenValuesHaveFunctionLocalDirectBindings[nodeIndex]
}

directBlockResultControlIndex blockIndex: Int, typeReferenceIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => resolved!
    blockIndex >= 0
        and blockIndex < (context.ir -> len)
        and typeReferenceIndex >= 0
        and typeReferenceIndex < (context.ir -> len)
        and context.ir[blockIndex].kind == 26
        and context.ir[blockIndex].opcode == 0
        -> if {
            context.ir[typeReferenceIndex] => typeReference
            blockIndex + 1 => childIndex!
            context.ir -> len => childEnd!
            blockIndex => blockOwner!
            blockOwner! >= 0 and context.ir[blockOwner!].kind != 0 and context.ir[blockOwner!].kind != 11
                -> while { context.ir[blockOwner!].parent => blockOwner! }
            blockOwner! >= 0 -> if { blockOwner! -> functionEnd(context, state) => childEnd! }
            childIndex! < childEnd! -> while {
                context.ir[childIndex!] => child
                false => childTypeMatches!
                typeReference.typeId >= 0 and child.typeId == typeReference.typeId
                    -> if { true => childTypeMatches! }
                typeReference.typeId < 0
                    and child.typeId < 0
                    and child.typeKind == typeReference.typeKind
                    and child.typeOrigin == typeReference.typeOrigin
                    and child.typeModule == typeReference.typeModule
                    and child.typeSymbol == typeReference.typeSymbol
                    -> if { true => childTypeMatches! }
                child.parent == blockIndex
                    and childTypeMatches!
                    and (child.kind == 18
                    or child.kind == 20
                    or child.kind == 27
                    or child.kind == 33
                    or child.kind == 34)
                    -> if { childIndex! => resolved! }
                childIndex! + 1 => childIndex!
            }
        }
    resolved!
}

controlResultShapeComplete controlIndex: Int, depth: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    true => complete!
    depth >= 32 -> if { false => complete! }
    controlIndex < 0 or controlIndex >= (context.ir -> len)
        -> if { false => complete! }
    complete! -> if {
        context.ir[controlIndex] => control
        control.kind == 18 -> if {
            control.operand1 < 0
                or control.operand1 >= (context.ir -> len)
                or context.ir[control.operand1].kind != 19
                or control.nextOperand < 0
                or control.nextOperand >= (context.ir -> len)
                or context.ir[control.nextOperand].kind != 19
                -> if { false => complete! } else {
                    context.ir[control.operand1].operand1 => rawThenResult
                    context.ir[control.nextOperand].operand1 => rawElseResult
                    rawThenResult < 0 or rawThenResult >= (context.ir -> len)
                        or rawElseResult < 0 or rawElseResult >= (context.ir -> len)
                        or context.ir[rawThenResult].kind == 17
                        or context.ir[rawElseResult].kind == 17
                        -> if { false => complete! } else {
                            control.operand1 -> regionResultValueIndex(context, state) => thenResult
                            control.nextOperand -> regionResultValueIndex(context, state) => elseResult
                            thenResult < 0 or thenResult >= (context.ir -> len)
                                or elseResult < 0 or elseResult >= (context.ir -> len)
                                -> if { false => complete! } else {
                                    context.ir[thenResult] => thenValue
                                    context.ir[elseResult] => elseValue
                                    (thenValue.kind == 18
                                        and not (thenResult -> controlResultShapeComplete(depth + 1, context, state)))
                                        or (elseValue.kind == 18
                                        and not (elseResult -> controlResultShapeComplete(depth + 1, context, state)))
                                        -> if { false => complete! }
                                }
                        }
                }
        }
    }
    complete!
}

# Arguments exposes borrowed Text values through its runtime view, not an
# addressable array of Text descriptors. Keep the role ABI shared everywhere.
directEachElementTypeId source: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    source -> typeQueries.directEachElementTypeId(context)
}

writeDirectEachElementType source: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    source -> directEachElementTypeId(context, state) => elementTypeId
    elementTypeId >= 0 -> if { elementTypeId -> writeSemanticTypeId(context, state) } else {
        source -> writeArrayElementType(context, state)
    }
}

emitDirectEachRoleAliases eachIndex: Int, eachSource: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[eachIndex] => eachNode
    context.ranges[eachNode.sourceModule] => eachRange
    0 => eachRoleSymbolIndex!
    eachRoleSymbolIndex! < eachRange.symbolCount
        -> while {
            context.symbols[eachRange.symbolStart + eachRoleSymbolIndex!] => eachRoleSymbol
            eachRoleSymbol.astNode == eachNode.astNode
                and (eachNode.sourceModule -> isDirectEachRoleSymbol(eachRoleSymbolIndex!, context))
                and (eachNode.sourceModule -> symbolUsedInInterpolation(eachRoleSymbolIndex!, context))
                -> if {
                    "  %each_role_m$(eachNode.sourceModule)_s$(eachRoleSymbolIndex!) = freeze " -> print
                    eachSource -> writeDirectEachElementType(context, state)
                    " %each$(eachIndex)_item" -> println
                }
            eachRoleSymbolIndex! + 1 => eachRoleSymbolIndex!
        }
}

# Deferred text keeps the lexical origin of its selected literal producer.
# A later sink changes emission labels, never the callback's binding scope.
interpolationLexicalUseIndex node: interpolation.InterpolationNode, sourceModule: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    beforeIndex -> aggregateValueIndex(context, state) => sourceIndex!
    context.ir[beforeIndex] => use
    use.kind == 6 or use.kind == 9 or (use -> isUserBlockScope)
        -> if { beforeIndex -> callArgumentIndex(context, state) => sourceIndex! }
    sourceIndex! >= 0 and sourceIndex! < (context.ir -> len)
        -> if {
            context.ir[sourceIndex!] => source
            source.kind == 2 and source.sourceModule == sourceModule
                and source.payloadToken == node.sourceToken
                -> if { sourceIndex! -> return }
        }
    beforeIndex
}

interpolationBindingIndex node: interpolation.InterpolationNode, sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    # Only a resolved lexical name identifies a binding. Member/call nodes use
    # their operand type; their -1 symbol must not match unnamed IR temporaries.
    node.kind != 1 or node.symbol < 0 -> if { -1 -> return }
    node -> interpolationLexicalUseIndex(sourceModule, beforeIndex, context, state) => lexicalUseIndex
    -1 => parameterIndex!
    ownerIndex >= 0 -> if {
        context -> parameterIndexForFunction(ownerIndex, node.symbol) => parameterIndex!
    }
    parameterIndex! >= 0 -> if {
        parameterIndex!
    } else {
        -1 => bindingIndex!
        UIntSize(0) => bindingStart!
        0 => bindingSearch!
        context.ir -> len => bindingEnd!
        ownerIndex >= 0 and ownerIndex < (context.ir -> len)
            -> if {
                ownerIndex + 1 => bindingSearch!
                ownerIndex -> functionEnd(context, state) => bindingEnd!
            }
        context.ranges[sourceModule] => bindingRange
        context.nodes[bindingRange.astStart + context.ir[lexicalUseIndex].astNode].start => interpolationStart
        bindingSearch! < bindingEnd! -> while {
            context.ir[bindingSearch!] => bindingCandidate
            (bindingCandidate.kind == 17 or bindingCandidate.kind == 29)
                and bindingCandidate.sourceModule == sourceModule
                and bindingCandidate.symbol == node.symbol
                and bindingCandidate.astNode >= 0 -> if {
                    context.nodes[bindingRange.astStart + bindingCandidate.astNode].start => candidateStart
                    bindingCandidate.parent => bindingOwner!
                    # A qualified pattern wraps its payload in a type expression.
                    # The arm owns both that pattern and its sibling body.
                    bindingCandidate.kind == 29 and bindingOwner! >= 0
                        and context.ir[bindingOwner!].kind == 8 and context.ir[bindingOwner!].opcode == 29
                        -> if { context.ir[bindingOwner!].parent => bindingOwner! }
                    lexicalUseIndex => useAncestor!
                    useAncestor! >= 0 and useAncestor! != bindingOwner!
                        -> while { context.ir[useAncestor!].parent => useAncestor! }
                    candidateStart <= interpolationStart
                        and useAncestor! == bindingOwner!
                        and (bindingSearch! -> userBlockCallbackOwner(context)) < 0
                        and (bindingIndex! < 0 or candidateStart > bindingStart!)
                        -> if {
                            bindingSearch! => bindingIndex!
                            candidateStart => bindingStart!
                        }
                }
            bindingSearch! + 1 => bindingSearch!
        }
        bindingIndex!
    }
}

interpolationEmissionOrder nodes: ref [interpolation.InterpolationNode; ~], sourceToken: Int, segment: Int -> [Int; ~] {
    [Bool; ~] => emitted!
    0 => emittedInit!
    emittedInit! < (nodes -> len) -> while {
        emitted! -> push(false)
        emittedInit! + 1 => emittedInit!
    }
    [Int; ~] => order!
    true => progress!
    progress! -> while {
        false => progress!
        Int(nodes -> len) - 1 => candidateIndex!
        candidateIndex! >= 0 -> while {
            nodes[candidateIndex!] => candidate
            candidate.sourceToken == sourceToken and candidate.segment == segment and not emitted![candidateIndex!]
                -> if {
                    true => ready!
                    candidate.operand0 >= 0 and nodes[candidate.operand0].sourceToken == sourceToken and nodes[candidate.operand0].segment == segment and not emitted![candidate.operand0]
                        -> if { false => ready! }
                    candidate.operand1 >= 0 and nodes[candidate.operand1].sourceToken == sourceToken and nodes[candidate.operand1].segment == segment and not emitted![candidate.operand1]
                        -> if { false => ready! }
                    candidate.operand2 >= 0 and nodes[candidate.operand2].sourceToken == sourceToken and nodes[candidate.operand2].segment == segment and not emitted![candidate.operand2]
                        -> if { false => ready! }
                    ready! -> if {
                        order! -> push(candidateIndex!)
                        true => emitted![candidateIndex!]
                        true => progress!
                    }
                }
            candidateIndex! - 1 => candidateIndex!
        }
    }
    order!
}

emitInterpolationLexicalLoad labelIndex: Int, nodeIndex: Int, node: interpolation.InterpolationNode, sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    node -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => bindingIndex
    bindingIndex >= 0 -> if {
        bindingIndex -> asyncFrameBindingRoot(ownerIndex, context, state) => asyncRoot
        asyncRoot >= 0 -> if {
            "  %v$(labelIndex)_expression$(nodeIndex)_mutable = load " -> print
            context.ir[asyncRoot] -> writeIrType(context, state)
            ", ptr " -> print
            asyncRoot -> writeAsyncLocalAddress(context)
            ", align " -> print
            context.ir[asyncRoot] -> storageAlign(context, state) -> writeDecimalLine
            return
        }
        context.ir[bindingIndex] => binding
        binding.kind == 17 -> if {
            bindingIndex -> mutableStorageRoot(context, state) => storageRoot
            storageRoot >= 0 -> if {
                "  %v$(labelIndex)_expression$(nodeIndex)_mutable = load " -> print
                binding -> writeIrType(context, state)
                ", ptr %slot$(storageRoot), align 8" -> println
            }
        }
        binding.kind == 10 and binding.flags / 2 % 2 == 1
            -> if {
                bindingIndex -> mutableBorrowParameterOrdinal(ownerIndex, context, state) => parameterOrdinal
                parameterOrdinal >= 0 -> if {
                    binding -> mutableBorrowUsesStructPointer(context)
                        -> if {
                            "  %v$(labelIndex)_expression$(nodeIndex)_mutable = load " -> print
                            binding -> writeIrType(context, state)
                            ", ptr " -> print
                            parameterOrdinal -> writeMutableStructParameterPointer
                            ", align " -> print
                            binding -> storageAlign(context, state) -> writeDecimalLine
                        } else {
                            "  %v$(labelIndex)_expression$(nodeIndex)_mutable_ptr = load ptr, ptr " -> print
                            parameterOrdinal == 0 -> if { "%arg_mut_ptr_addr" -> print } else { "%arg$(parameterOrdinal)_mut_ptr_addr" -> print }
                            ", align 8" -> println
                            "  %v$(labelIndex)_expression$(nodeIndex)_mutable_len = load i64, ptr " -> print
                            parameterOrdinal == 0 -> if { "%arg_mut_len_addr" -> print } else { "%arg$(parameterOrdinal)_mut_len_addr" -> print }
                            ", align 8" -> println
                            "  %v$(labelIndex)_expression$(nodeIndex)_mutable_capacity = load i64, ptr " -> print
                            parameterOrdinal == 0 -> if { "%arg_mut_capacity_addr" -> print } else { "%arg$(parameterOrdinal)_mut_capacity_addr" -> print }
                            ", align 8" -> println
                            "  %v$(labelIndex)_expression$(nodeIndex)_mutable0 = insertvalue " -> print
                            binding -> writeIrType(context, state)
                            " poison, ptr %v$(labelIndex)_expression$(nodeIndex)_mutable_ptr, 0" -> println
                            "  %v$(labelIndex)_expression$(nodeIndex)_mutable1 = insertvalue " -> print
                            binding -> writeIrType(context, state)
                            " %v$(labelIndex)_expression$(nodeIndex)_mutable0, i64 %v$(labelIndex)_expression$(nodeIndex)_mutable_len, 1" -> println
                            "  %v$(labelIndex)_expression$(nodeIndex)_mutable = insertvalue " -> print
                            binding -> writeIrType(context, state)
                            " %v$(labelIndex)_expression$(nodeIndex)_mutable1, i64 %v$(labelIndex)_expression$(nodeIndex)_mutable_capacity, 2" -> println
                        }
                }
            }
    }
}

writeInterpolationIntegerLiteral node: interpolation.InterpolationNode, sourceModule: Int, context: ref emitterContext.EmitContext -> Unit uses Console {
    (context.sources[sourceModule] -> byte(node.payloadStart)) == 39
        -> if {
            syntax.SourceSpan { fileId: sourceModule, start: node.payloadStart, length: node.payloadLength } => characterSpan
            context.sources[sourceModule] -> syntax.decodeCharacterLiteral(characterSpan) -> when {
                Some(value) { "$value" -> print -> return }
                None { }
            }
        }
    node.payloadStart => segmentStart!
    node.payloadStart => byteIndex!
    node.payloadStart + node.payloadLength => literalEnd
    false => decimalPoint!
    node.payloadStart => syntaxIndex!
    syntaxIndex! < literalEnd -> while {
        (context.sources[sourceModule] -> byte(syntaxIndex!)) == 46
            -> if { true => decimalPoint! }
        syntaxIndex! + 1 => syntaxIndex!
    }
    byteIndex! < literalEnd -> while {
        context.sources[sourceModule] -> byte(byteIndex!) => character
        character == 101 or character == 69 -> if {
            not decimalPoint! -> if {
                byteIndex! > segmentStart! -> if {
                    context.sources[sourceModule] -> slice(segmentStart!, byteIndex! - segmentStart!) -> print
                }
                ".0" -> print
                byteIndex! => segmentStart!
            }
        }
        character == 95
            -> if {
                byteIndex! > segmentStart! -> if {
                    context.sources[sourceModule] -> slice(segmentStart!, byteIndex! - segmentStart!) -> print
                }
                byteIndex! + 1 => segmentStart!
            }
        byteIndex! + 1 => byteIndex!
    }
    literalEnd > segmentStart! -> if {
        context.sources[sourceModule] -> slice(segmentStart!, literalEnd - segmentStart!) -> print
    }
}

interpolationIntegerLiteralSyntax nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, context: ref emitterContext.EmitContext -> Bool {
    nodes[nodeIndex] => node
    node.kind == 2 and node.opcode != -26 and node.operand0 >= 0
        -> if { node.operand0 -> interpolationIntegerLiteralSyntax(nodes, sourceModule, context) -> return }
    node.kind != 0 -> if { false -> return }
    (context.sources[sourceModule] -> byte(node.payloadStart)) == 39
        -> if { true -> return }
    node.payloadStart => cursor!
    node.payloadStart + node.payloadLength => end
    cursor! < end -> while {
        context.sources[sourceModule] -> byte(cursor!) => character
        character == 46 or character == 101 or character == 69
            -> if { false -> return }
        cursor! + 1 => cursor!
    }
    true
}

writeInterpolationIntegerSyntaxLiteral nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, context: ref emitterContext.EmitContext -> Unit uses Console {
    nodes[nodeIndex] => node
    node.kind == 2 -> if {
        "-" -> print
        nodes[node.operand0] -> writeInterpolationIntegerLiteral(sourceModule, context)
    } else {
        node -> writeInterpolationIntegerLiteral(sourceModule, context)
    }
}

interpolationLiteralEncoding nodeIndex: Int, width: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, context: ref emitterContext.EmitContext -> floatingLiterals.Encoding {
    nodes[nodeIndex] => node
    node.kind == 2 and node.opcode != -26 and node.operand0 >= 0
        -> if {
            node.operand0 -> interpolationLiteralEncoding(width, nodes, sourceModule, context) => operand
            node.opcode == grammar.tokenIdMinus() -> if { operand -> floatingLiterals.negate -> return }
            operand -> return
        }
    node.kind != 0 -> if {
        floatingLiterals.invalidEncoding() -> return
    }
    (context.sources[sourceModule] -> byte(node.payloadStart)) == 39
        -> if {
            syntax.SourceSpan { fileId: sourceModule, start: node.payloadStart, length: node.payloadLength } => span
            context.sources[sourceModule] -> syntax.decodeCharacterLiteral(span) -> when {
                Some(value) { Int(value) -> floatingLiterals.encodeCodePoint -> return }
                None { floatingLiterals.invalidEncoding() -> return }
            }
        }
    context.sources[sourceModule] -> slice(node.payloadStart, node.payloadLength) => literal
    literal -> floatingLiterals.encode(width)
}

writeInterpolationFloatingLiteral nodeIndex: Int, width: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, context: ref emitterContext.EmitContext -> Unit uses Console, Process {
    nodeIndex -> interpolationLiteralEncoding(width, nodes, sourceModule, context) => encoding
    not encoding.valid -> if {
        "; sollang internal error: interpolation floating literal is not finite at its committed width" -> println
        process.exit(1)
    }
    encoding -> floatingLiterals.write
}

writeInterpolationFloatingIntegerLiteral nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, context: ref emitterContext.EmitContext -> Unit uses Console, Process {
    nodeIndex -> writeInterpolationFloatingLiteral(64, nodes, sourceModule, context)
}

sameWidthNumericConversionOperand nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    nodes[nodeIndex] => conversion
    conversion.kind != 9 or conversion.operand0 < 0
        -> if { -1 -> return }
    conversion.typeSymbol -> integerWidth(context, state) => targetIntegerWidth!
    conversion.typeSymbol == 12 or conversion.typeSymbol == 13
        -> if { context.pointerBitWidth => targetIntegerWidth! }
    targetIntegerWidth! > 0 -> if {
        conversion.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => sourceTypeId
        false => sourceIsFloat!
        sourceTypeId >= 0 and sourceTypeId < (context.types -> len)
            -> if {
                context.types[sourceTypeId] => sourceType
                sourceType.kind == 1 and sourceType.origin == 1
                    -> if {
                        sourceType.symbol -> typeIds.canonicalBuiltinSymbol => sourceBuiltin
                        sourceBuiltin == 20 or sourceBuiltin == 21 -> if { true => sourceIsFloat! }
                    }
            }
        not sourceIsFloat! -> if {
            conversion.operand0 -> interpolationNodeIntegerWidth(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => sourceIntegerWidth
            sourceIntegerWidth == targetIntegerWidth! -> if { conversion.operand0 -> return }
        }
    }
    0 => targetWidth!
    conversion.typeSymbol == 19 or conversion.typeSymbol == 20
        -> if { 32 => targetWidth! }
    conversion.typeSymbol == 21 or conversion.typeSymbol == 22
        -> if { 64 => targetWidth! }
    targetWidth! == 0 -> if { -1 -> return }
    conversion.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => sourceTypeId
    sourceTypeId < 0 or sourceTypeId >= (context.types -> len)
        -> if { -1 -> return }
    context.types[sourceTypeId] => sourceType
    sourceType.kind != 1 or sourceType.origin != 1
        -> if { -1 -> return }
    sourceType.symbol == 19 or sourceType.symbol == 20
        -> if { targetWidth! == 32 -> if { conversion.operand0 -> return } }
    sourceType.symbol == 21 or sourceType.symbol == 22
        -> if { targetWidth! == 64 -> if { conversion.operand0 -> return } }
    -1
}

emitInterpolationIntegerConversionChecks labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    nodes[nodeIndex] => conversion
    conversion.operand0 -> interpolationNodeIntegerWidth(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => sourceWidth
    conversion.typeSymbol -> integerWidth(context, state) => targetWidth!
    conversion.typeSymbol == 12 or conversion.typeSymbol == 13
        -> if { context.pointerBitWidth => targetWidth! }
    sourceWidth <= 0 or targetWidth! <= 0 -> if { return }
    conversion.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => sourceTypeId
    nodes[conversion.operand0].typeSymbol => sourceSymbol!
    sourceTypeId >= 0 and sourceTypeId < (context.types -> len)
        -> if { context.types[sourceTypeId].symbol => sourceSymbol! }
    sourceSymbol! -> typeIds.canonicalBuiltinSymbol => sourceBuiltin
    conversion.typeSymbol -> typeIds.canonicalBuiltinSymbol => targetBuiltin
    conversion.operand0 -> interpolationNodeSigned(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => sourceSigned
    targetBuiltin -> typeIds.isSignedNumericBuiltinSymbol => targetSigned
    sourceWidth => sourceUpperBits!
    sourceSigned -> if { sourceWidth - 1 => sourceUpperBits! }
    sourceBuiltin == 14 -> if { 21 => sourceUpperBits! }
    targetWidth! => targetUpperBits!
    targetSigned -> if { targetWidth! - 1 => targetUpperBits! }
    targetBuiltin == 14 -> if { 21 => targetUpperBits! }
    sourceSigned and (not targetSigned or sourceWidth > targetWidth!)
        -> if {
            conversion.typeSymbol -> numericLiteralRange.minimumText(context.pointerBitWidth) => lowerBound
            "  %v$(labelIndex)_expression$(nodeIndex)_lower_valid = icmp sge i$(sourceWidth) " -> print
            labelIndex -> writeInterpolationValue(conversion.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
            ", $lowerBound" -> println
            "  br i1 %v$(labelIndex)_expression$(nodeIndex)_lower_valid, label %v$(labelIndex)_expression$(nodeIndex)_lower_ok, label %v$(labelIndex)_expression$(nodeIndex)_lower_fail" -> println
            "v$(labelIndex)_expression$(nodeIndex)_lower_fail:" -> println
            "  call void @llvm.trap()" -> println
            "  unreachable" -> println
            "v$(labelIndex)_expression$(nodeIndex)_lower_ok:" -> println
        }
    sourceUpperBits! > targetUpperBits! -> if {
        conversion.typeSymbol -> numericLiteralRange.maximumText(context.pointerBitWidth) => upperBound
        "  %v$(labelIndex)_expression$(nodeIndex)_upper_valid = icmp " -> print
        sourceSigned -> if { "sle" -> print } else { "ule" -> print }
        " i$(sourceWidth) " -> print
        labelIndex -> writeInterpolationValue(conversion.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
        ", $upperBound" -> println
        "  br i1 %v$(labelIndex)_expression$(nodeIndex)_upper_valid, label %v$(labelIndex)_expression$(nodeIndex)_upper_ok, label %v$(labelIndex)_expression$(nodeIndex)_upper_fail" -> println
        "v$(labelIndex)_expression$(nodeIndex)_upper_fail:" -> println
        "  call void @llvm.trap()" -> println
        "  unreachable" -> println
        "v$(labelIndex)_expression$(nodeIndex)_upper_ok:" -> println
    }
    targetBuiltin == 14 and sourceUpperBits! >= 16
        -> if {
            "  %v$(labelIndex)_expression$(nodeIndex)_below_surrogate = icmp " -> print
            sourceSigned -> if { "slt" -> print } else { "ult" -> print }
            " i$(sourceWidth) " -> print
            labelIndex -> writeInterpolationValue(conversion.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
            ", 55296" -> println
            "  %v$(labelIndex)_expression$(nodeIndex)_above_surrogate = icmp " -> print
            sourceSigned -> if { "sgt" -> print } else { "ugt" -> print }
            " i$(sourceWidth) " -> print
            labelIndex -> writeInterpolationValue(conversion.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
            ", 57343" -> println
            "  %v$(labelIndex)_expression$(nodeIndex)_valid_scalar = or i1 %v$(labelIndex)_expression$(nodeIndex)_below_surrogate, %v$(labelIndex)_expression$(nodeIndex)_above_surrogate" -> println
            "  br i1 %v$(labelIndex)_expression$(nodeIndex)_valid_scalar, label %v$(labelIndex)_expression$(nodeIndex)_scalar_ok, label %v$(labelIndex)_expression$(nodeIndex)_scalar_fail" -> println
            "v$(labelIndex)_expression$(nodeIndex)_scalar_fail:" -> println
            "  call void @llvm.trap()" -> println
            "  unreachable" -> println
            "v$(labelIndex)_expression$(nodeIndex)_scalar_ok:" -> println
        }
}

writeDirectFoldRoleValue node: interpolation.InterpolationNode, sourceModule: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool uses Console {
    context.ranges[sourceModule] => range
    node.symbol >= 0 and node.symbol < range.symbolCount
        -> if {
            context.symbols[range.symbolStart + node.symbol] => role
            role.kind == 35 and context.nodes[range.astStart + role.astNode].kind == 64
                -> if {
                    ownerIndex + 1 => ancestor!
                    ancestor! < (context.ir -> len) and context.ir[ancestor!].kind != 0 and context.ir[ancestor!].kind != 11
                        -> while {
                            context.ir[ancestor!] => owner
                            owner.kind == 32 and owner.sourceModule == sourceModule and owner.astNode == role.astNode
                                -> if {
                                    owner -> sourceNode(context, state) => foldAst
                                    role -> symbols.implicitFoldRole => implicitRole
                                    role.nameToken == foldAst.secondaryToken or implicitRole == 0
                                        -> if {
                                            "%fold$(ancestor!)_acc" -> print
                                            true -> return
                                        }
                                    role.nameToken == foldAst.tertiaryToken or implicitRole == 1
                                        -> if {
                                            "%fold$(ancestor!)_item" -> print
                                            true -> return
                                        }
                                }
                            ancestor! + 1 => ancestor!
                        }
                }
        }
    false
}

writeParallelRoleValue node: interpolation.InterpolationNode, sourceModule: Int, beforeIndex: Int, context: ref emitterContext.EmitContext -> Bool uses Console {
    node.kind == 1 -> if {
        sourceModule -> parallelRoleSymbolOwner(node.symbol, beforeIndex, context) => parallelOwner
        parallelOwner >= 0 -> if {
            "%v$(parallelOwner)_item" -> print
            true -> return
        }
    }
    false
}

canonicalInterpolationValueIndex node: interpolation.InterpolationNode, sourceModule: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.ranges[sourceModule] => range
    -1 => selected!
    (context.nodes -> len) + 1 => selectedDepth!
    ownerIndex + 1 => candidateIndex!
    ownerIndex -> functionEnd(context, state) => end
    candidateIndex! < end -> while {
        context.ir[candidateIndex!] => candidate
        candidate.sourceModule == sourceModule and candidate.astNode >= 0
            and state.frozenCanonicalInterpolationRootByIr[candidateIndex!] == node.valueAst
            -> if {
                candidate.astNode => ancestor!
                0 => depth!
                ancestor! >= 0 and ancestor! != node.valueAst
                    -> while {
                        context.nodes[range.astStart + ancestor!].parent => ancestor!
                        depth! + 1 => depth!
                    }
                ancestor! == node.valueAst and depth! < selectedDepth!
                    -> if {
                        candidateIndex! => selected!
                        depth! => selectedDepth!
                    }
            }
        candidateIndex! + 1 => candidateIndex!
    }
    selected!
}

emitCanonicalInterpolation node: interpolation.InterpolationNode, sourceModule: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    ownerIndex -> functionEnd(context, state) => end
    ownerIndex -> prepareFunctionExpressionOrder(end, ownerIndex + 1, context, state) => order
    order -> each valueIndex {
        context.ir[valueIndex].sourceModule == sourceModule
            and state.frozenCanonicalInterpolationRootByIr[valueIndex] == node.valueAst
            -> if {
                valueIndex -> emitRegionValueRoot(order, context, state)
                valueIndex -> emitAsyncLocalWrite(ownerIndex, context, state)
            }
    }
}

writeInterpolationValue labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    nodes[nodeIndex] => node
    node.kind == 17 -> if {
        node -> canonicalInterpolationValueIndex(sourceModule, ownerIndex, context, state) => valueIndex
        valueIndex < 0 -> if {
            "sollang: canonical interpolation value is missing" -> runtime.eprintln
            process.exit(1)
        }
        valueIndex -> writeValue(ownerIndex, context, state)
        return
    }
    node -> writeParallelRoleValue(sourceModule, beforeIndex, context)
        -> if { return }
    node.kind == 1 -> if {
        node -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => bindingIndex
        (bindingIndex -> asyncFrameBindingRoot(ownerIndex, context, state)) >= 0
            -> if {
                "%v$(labelIndex)_expression$(nodeIndex)_mutable" -> print
                return
            }
    }
    node.kind == 1 and (node -> writeDirectFoldRoleValue(sourceModule, ownerIndex, context, state))
        -> if { return }
    node.kind == 9 and node.operand0 >= 0 -> if {
        node.typeSymbol -> integerWidth(context, state) => integerTargetWidth!
        node.typeSymbol == 12 or node.typeSymbol == 13
            -> if { context.pointerBitWidth => integerTargetWidth! }
        integerTargetWidth! > 0 and (node.operand0 -> interpolationIntegerLiteralSyntax(nodes, sourceModule, context))
            -> if {
                node.operand0 -> writeInterpolationIntegerSyntaxLiteral(nodes, sourceModule, context)
                return
            }
    }
    node.kind == 9 and node.typeSymbol >= 19 and node.typeSymbol <= 22 and node.operand0 >= 0
        -> if {
            node.operand0 -> interpolationNumericLiteralSyntax(nodes)
                -> if {
                    node.typeSymbol == 19 or node.typeSymbol == 20
                        -> if { 32 } else { 64 } => width
                    node.operand0 -> writeInterpolationFloatingLiteral(width, nodes, sourceModule, context)
                    return
                }
        }
    nodeIndex -> sameWidthNumericConversionOperand(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => aliasOperand
    aliasOperand >= 0 -> if {
        labelIndex -> writeInterpolationValue(aliasOperand, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
        return
    }
    node.kind == 0 -> if {
        context.sources[sourceModule] -> numericLiteralRange.literalUsesFloatingSyntax(node.payloadStart, node.payloadStart + node.payloadLength)
            -> if { nodeIndex -> writeInterpolationFloatingLiteral(32, nodes, sourceModule, context) } else {
                node -> writeInterpolationIntegerLiteral(sourceModule, context)
            }
    } else {
        node.kind == 4 -> if {
            (context.sources[sourceModule] -> byte(node.payloadStart)) == 116
                -> if { "1" -> print } else { "0" -> print }
        } else {
            node.kind == 1 -> if {
                node -> writeDirectEachRoleValue(sourceModule, beforeIndex, context, state) => directEachRole
                not directEachRole -> if {
                    node -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => bindingIndex
                    bindingIndex < 0 -> if {
                        beforeIndex -> regionOwnedStreamPipeline(context, state) => streamPipeline
                        streamPipeline >= 0 -> if {
                            streamPipeline -> streamCallbackInputValue(node.symbol, context, state) => mappedInput
                            mappedInput >= 0 -> if {
                                mappedInput -> writeValue(ownerIndex, context, state)
                                return
                            }
                            streamPipeline -> streamCallbackRole(beforeIndex, beforeIndex, node.symbol, context, state) => streamRole
                            context.streamPlan.pipelines[streamPipeline].terminalIr => streamTerminal
                            streamRole == 2 -> if {
                                "%stream$(streamTerminal)_inner_item" -> print
                                return
                            }
                            streamRole == 1 -> if {
                                "%stream$(streamTerminal)_item" -> print
                                return
                            }
                        }
                    }
                    bindingIndex >= 0 and context.ir[bindingIndex].kind == 10
                        -> if {
                            context.ir[bindingIndex] => interpolationParameter
                            interpolationParameter.flags / 2 % 2 == 1 -> if {
                                "%v$(labelIndex)_expression$(nodeIndex)_mutable" -> print
                            } else {
                                context -> writeParameterReference(ownerIndex, node.symbol) => parameterWritten
                            }
                        } else {
                            bindingIndex >= 0 -> if {
                                context.ir[bindingIndex] => interpolationBinding
                                interpolationBinding.kind == 29 -> if {
                                    "%v$(bindingIndex)" -> print
                                } else {
                                    bindingIndex -> mutableStorageRoot(context, state) => storageRoot
                                    storageRoot >= 0 -> if {
                                        "%v$(labelIndex)_expression$(nodeIndex)_mutable" -> print
                                    } else {
                                        context.ir[interpolationBinding.operand0] => interpolationBindingValue
                                        interpolationBindingValue.kind == 3 or interpolationBindingValue.kind == 4
                                            -> if {
                                                interpolationBindingValue -> sourceToken(context, state) => interpolationBindingToken
                                                interpolationBindingValue.kind == 4 -> if {
                                                    (context.sources[interpolationBindingValue.sourceModule] -> byte(interpolationBindingToken.span.start)) == 116
                                                        -> if { "1" -> print } else { "0" -> print }
                                                } else {
                                                    interpolationBindingValue -> writeIntegerLiteral(context, state)
                                                }
                                            } else {
                                                interpolationBinding.operand0 -> writeValue(ownerIndex, context, state)
                                            }
                                    }
                                }
                            }
                        }
                }
            } else {
                "%v$(labelIndex)_expression$(nodeIndex)" -> print
            }
        }
    }
}

interpolationReferenceReadTypeId nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => valueTypeId
    nodes[nodeIndex].kind != 1 -> if { valueTypeId -> return }
    nodes[nodeIndex] -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => bindingIndex
    bindingIndex < 0 -> if { valueTypeId -> return }
    context.ir[bindingIndex].typeId => referenceTypeId
    referenceTypeId < 0 or referenceTypeId >= (context.types -> len)
        -> if { valueTypeId -> return }
    context.types[referenceTypeId].kind != 8 -> if { valueTypeId -> return }
    context.types[referenceTypeId].first => candidateTypeId
    candidateTypeId < 0 or candidateTypeId >= (context.types -> len)
        -> if { valueTypeId -> return }
    candidateTypeId
}

interpolationReferenceValueTypeId nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    nodeIndex -> interpolationReferenceReadTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => candidateTypeId
    candidateTypeId < 0 -> if { -1 -> return }
    -1 => valueTypeId!
    context.types[candidateTypeId] => candidateType
    candidateType.kind == 1 and candidateType.origin == 1
        -> if {
            candidateType.symbol -> integerWidth(context, state) => candidateWidth
            candidateWidth > 0 or candidateType.symbol == 1 or candidateType.symbol == 23
                -> if { candidateTypeId => valueTypeId! }
        }
    valueTypeId!
}

emitInterpolationReferenceValue labelIndex: Int, nodeIndex: Int, valueTypeId: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    "  %v$(labelIndex)_expression$(nodeIndex)_reference_value = load " -> print
    valueTypeId -> writeAggregateFieldTypeId(context, state)
    ", ptr " -> print
    labelIndex -> writeInterpolationValue(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
    context.types[valueTypeId].kind == 4 -> if { 8 } else { context.typeAligns[valueTypeId] } => valueAlignment
    ", align $valueAlignment" -> println
}

interpolationCallArgumentUsesValue nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    nodes[nodeIndex].parent => callIndex
    callIndex < 0 -> if { false -> return }
    nodes[callIndex].kind != 8 and nodes[callIndex].kind != 10
        -> if { false -> return }
    callIndex -> interpolationCallTargetFunction(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => targetIndex
    targetIndex < 0 -> if { false -> return }
    context.ir[targetIndex] => target
    target.operand1 => parameterIndex!
    0 => ordinal!
    callIndex -> interpolationCallArgumentAt(ordinal!, nodes) => argumentIndex!
    argumentIndex! >= 0 and parameterIndex! >= 0 -> while {
        context.ir[parameterIndex!] => parameter
        argumentIndex! == nodeIndex -> if {
            parameter.typeId < 0 -> if { false -> return }
            nodeIndex -> interpolationReferenceReadTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => readTypeId
            context.types[parameter.typeId].kind != 8 and parameter.flags / 2 % 2 == 0 and readTypeId == parameter.typeId -> return
        }
        ordinal! == 0 -> if { target.nextOperand => parameterIndex! } else { parameter.nextOperand => parameterIndex! }
        ordinal! + 1 => ordinal!
        callIndex -> interpolationCallArgumentAt(ordinal!, nodes) => argumentIndex!
    }
    false
}

writeInterpolationScalarValue labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    nodeIndex -> interpolationReferenceValueTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => referenceValueTypeId
    referenceValueTypeId >= 0 -> if {
        "%v$(labelIndex)_expression$(nodeIndex)_reference_value" -> print
    } else {
        labelIndex -> writeInterpolationValue(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
    }
}

interpolationNumericLiteralSyntax nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~] -> Bool {
    nodes[nodeIndex] => node
    node.kind == 0 -> if { true -> return }
    node.kind == 2 and node.opcode != -26 and node.operand0 >= 0
        -> if { node.operand0 -> interpolationNumericLiteralSyntax(nodes) -> return }
    false
}

writeInterpolationFloatScalarValue labelIndex: Int, nodeIndex: Int, builtin: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    nodeIndex -> interpolationNumericLiteralSyntax(nodes)
        -> if {
            builtin == 20 -> if { 32 } else { 64 } => width
            nodeIndex -> writeInterpolationFloatingLiteral(width, nodes, sourceModule, context)
            return
        }
    labelIndex -> writeInterpolationScalarValue(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
}

interpolationCallArgumentAt nodeIndex: Int, ordinal: Int, nodes: ref [interpolation.InterpolationNode; ~] -> Int {
    nodes[nodeIndex] => call
    (call.kind == 8 or call.kind == 10) and call.argumentCount > 3
        -> if {
            0 => childIndex!
            0 => childOrdinal!
            childIndex! < (nodes -> len) -> while {
                nodes[childIndex!].parent == nodeIndex -> if {
                    childOrdinal! == ordinal -> if { childIndex! -> return }
                    childOrdinal! + 1 => childOrdinal!
                }
                childIndex! + 1 => childIndex!
            }
            -1 -> return
        }
    ordinal == 0 -> if { call.operand0 -> return }
    ordinal == 1 -> if { call.operand1 -> return }
    ordinal == 2 -> if { call.operand2 -> return }
    -1
}

interpolationCallArgumentLimit node: interpolation.InterpolationNode -> Int {
    (node.kind == 8 or node.kind == 10) and node.argumentCount > 3
        -> if { node.argumentCount -> return }
    3
}

interpolationCallTargetFunction nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    nodes[nodeIndex] => node
    (node.kind == 5 or node.kind == 8 or node.kind == 10) and sourceModule >= 0 and sourceModule < (context.interpolationRanges -> len)
        -> if {
            context.interpolationRanges[sourceModule] => interpolationRange
            nodeIndex >= 0 and nodeIndex < (nodes -> len)
                -> if {
                    nodeIndex => globalNodeIndex!
                    (nodes -> len) != (context.interpolations -> len)
                        -> if { interpolationRange.nodeStart + nodeIndex => globalNodeIndex! }
                    context -> emitterContext.interpolationFunctionForOwner(ownerIndex, globalNodeIndex!) => selectedTarget
                    selectedTarget >= 0 -> if { selectedTarget -> return }
                }
        }
    node.kind == 8 -> if { -1 -> return }
    -1 => target!
    target! < 0
        and node.kind == 10
        and node.operand0 >= 0
        -> if {
            node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => receiverType
            1 => argumentCount!
            node.operand1 >= 0 -> if { argumentCount! + 1 => argumentCount! }
            node.operand2 >= 0 -> if { argumentCount! + 1 => argumentCount! }
            0 => candidateSearch!
            candidateSearch! < (context.ir -> len) -> while {
                context.ir[candidateSearch!] => candidate
                candidate.kind == 0
                    and candidate.operand1 >= 0
                    and context.ir[candidate.operand1].typeId == receiverType
                    and (node -> diagnostics.interpolationCallNameMatches(sourceModule, candidateSearch!, context))
                    -> if {
                        1 => parameterCount!
                        candidate.nextOperand => parameterSearch!
                        parameterSearch! >= 0 -> while {
                            parameterCount! + 1 => parameterCount!
                            context.ir[parameterSearch!].nextOperand => parameterSearch!
                        }
                        parameterCount! == argumentCount! -> if {
                            target! < 0 -> if { candidateSearch! => target! } else { -2 => target! }
                        }
                    }
                candidateSearch! + 1 => candidateSearch!
            }
        }
    target! >= 0 -> if { target! } else { -1 }
}

interpolationBuiltinTypeId symbol: Int, context: ref emitterContext.EmitContext -> Int {
    0 => typeIndex!
    typeIndex! < (context.types -> len) -> while {
        context.types[typeIndex!] => candidate
        candidate.kind == 1 and candidate.origin == 1 and candidate.symbol == symbol
            -> if { typeIndex! -> return }
        typeIndex! + 1 => typeIndex!
    }
    -1
}

interpolationEnumConstructorIndex node: interpolation.InterpolationNode, sourceModule: Int, context: ref emitterContext.EmitContext -> Int {
    node.kind == 10 or node.kind == 15 -> unless { -1 -> return }
    node -> semanticInterpolationNodeIndex(sourceModule, context) => semanticIndex
    semanticIndex < 0 or semanticIndex >= (context.interpolationEnumConstructorByNode -> len)
        -> if { -1 -> return }
    context.interpolationEnumConstructorByNode[semanticIndex] => constructorIndex
    constructorIndex < 0 or constructorIndex >= (context.interpolationEnumConstructors -> len)
        -> if { -1 -> return }
    context.interpolationEnumConstructors[constructorIndex] => constructor
    constructor.callNode != semanticIndex or constructor.enumTypeId < 0
        -> if { -1 -> return }
    constructor.memberStatus == 3 -> if { constructorIndex -> return }
    constructor.argumentNode < 0 or constructor.expectedTypeId < 0
        or constructor.actualTypeId != constructor.expectedTypeId
        -> if { -1 -> return }
    constructorIndex
}

interpolationEnumPayloadBorrows argumentNode: Int, sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    argumentNode => root!
    (context.interpolations[root!].kind == 5 or context.interpolations[root!].kind == 7)
        and context.interpolations[root!].operand0 >= 0
        -> while { context.interpolations[root!].operand0 => root! }
    context.interpolations[root!] => source
    source.kind != 1 -> if { false -> return }
    source -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => bindingIndex
    bindingIndex < 0 -> if { false -> return }
    context.ir[bindingIndex] => binding
    binding.kind == 29 -> if {
        not (bindingIndex -> patternBindingOwnsPayload(context, state)) -> return
    }
    binding.kind == 10 -> if { binding.flags % 2 == 0 -> return }
    binding.typeId >= 0 and context.types[binding.typeId].kind == 8
}

interpolationNodeTypeId nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    nodes[nodeIndex].kind == 0 or nodes[nodeIndex].kind == 2
        -> if {
            nodes[nodeIndex] -> semanticInterpolationNodeIndex(sourceModule, context) => semanticIndex
            semanticIndex >= 0 and semanticIndex < (context.interpolationNumericLiteralContextByNode -> len)
                and context.interpolationNumericLiteralContextByNode[semanticIndex].typeId >= 0
                -> if { context.interpolationNumericLiteralContextByNode[semanticIndex].typeId -> return }
        }
    nodes[nodeIndex] -> interpolationEnumConstructorIndex(sourceModule, context) => enumConstructorIndex
    enumConstructorIndex >= 0 -> if {
        context.interpolationEnumConstructors[enumConstructorIndex].enumTypeId -> return
    }
    nodes[nodeIndex] => node
    node.kind == 17 -> if {
        node -> canonicalInterpolationValueIndex(sourceModule, ownerIndex, context, state) => valueIndex
        valueIndex >= 0 -> if { context.ir[valueIndex].typeId -> return }
        -1 -> return
    }
    -1 => typeId!
    node.kind == 16 -> if {
        node -> semanticInterpolationNodeIndex(sourceModule, context) => semanticIndex
        semanticIndex >= 0 and semanticIndex < (context.interpolationArrayByNode -> len)
            -> if {
                context.interpolationArrayByNode[semanticIndex] => literal
                literal.status == 0 -> if { literal.typeId -> return }
            }
    }
    node.kind == 2 -> if {
        node -> semanticInterpolationNodeIndex(sourceModule, context) => semanticIndex
        semanticIndex >= 0 and semanticIndex < (context.interpolationUnaryTypeByNode -> len)
            -> if { context.interpolationUnaryTypeByNode[semanticIndex] -> return }
    }
    node.kind == 0 -> if {
        context.sources[sourceModule] -> numericLiteralRange.literalUsesFloatingSyntax(node.payloadStart, node.payloadStart + node.payloadLength)
            -> if { 21 -> interpolationBuiltinTypeId(context) => typeId! }
    }
    node.kind == 11 and node.operand0 >= 0 -> if {
        node -> semanticInterpolationNodeIndex(sourceModule, context) => semanticIndex
        semanticIndex >= 0 and semanticIndex < (context.interpolationResultPropagationByNode -> len)
            -> if {
                context.interpolationResultPropagationByNode[semanticIndex] => decision
                decision.status == 0 -> if { decision.okTypeId => typeId! }
            }
    }
    node.kind == 14 -> if {
        node -> semanticInterpolationNodeIndex(sourceModule, context) => semanticIndex
        semanticIndex >= 0 and semanticIndex < (context.interpolationContextualDiagnosticByNode -> len)
            -> if { context.interpolationContextualDiagnosticByNode[semanticIndex].ownerType -> return }
    }
    node.kind == 1 -> if {
        node -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => bindingIndex
        bindingIndex >= 0 -> if {
            context.ir[bindingIndex].typeId => typeId!
        } else {
            node -> directEachRoleTypeId(sourceModule, context, state) => typeId!
            typeId! < 0 -> if {
                beforeIndex -> regionOwnedStreamPipeline(context, state) => streamPipeline
                streamPipeline >= 0 -> if {
                    context.streamPlan.pipelines[streamPipeline].terminalIr => streamTerminal
                    context.ir[streamTerminal].sourceModule => streamSourceModule
                    context -> emitterContext.streamCallbackInput(streamPipeline, streamSourceModule, node.symbol) => callbackInput
                    callbackInput.typeId => typeId!
                }
            }
        }
    }
    node.kind == 7 and node.operand0 >= 0 -> if {
        node -> semanticInterpolationNodeIndex(sourceModule, context) => semanticIndex
        semanticIndex >= 0 and semanticIndex < (context.interpolationIndexedTypeByNode -> len)
            -> if {
                context.interpolationIndexedTypeByNode[semanticIndex] => semanticTypeId
                semanticTypeId >= 0 -> if { semanticTypeId -> return }
            }
    }
    node.kind == 5 and node.operand0 >= 0 -> if {
        node -> semanticInterpolationNodeIndex(sourceModule, context) => semanticIndex
        semanticIndex >= 0 and semanticIndex < (context.interpolationMemberTypeByNode -> len)
            -> if {
                context.interpolationMemberTypeByNode[semanticIndex] => semanticTypeId
                semanticTypeId >= 0 -> if { semanticTypeId -> return }
            }
    }
    node.kind == 3 -> if {
        node -> semanticInterpolationNodeIndex(sourceModule, context) => semanticIndex
        semanticIndex >= 0 and semanticIndex < (context.interpolationBinaryTypeByNode -> len)
            -> if { context.interpolationBinaryTypeByNode[semanticIndex] => typeId! }
    }
    node.kind == 6 -> if {
        node -> semanticInterpolationNodeIndex(sourceModule, context) => semanticIndex
        semanticIndex >= 0 and semanticIndex < (context.interpolationFlowTypeByNode -> len)
            -> if { context.interpolationFlowTypeByNode[semanticIndex] => typeId! }
    }
    node.kind == 8 or node.kind == 10 -> if {
        nodeIndex -> interpolationCallTargetFunction(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => callTargetFunction
        callTargetFunction >= 0 -> if { context.ir[callTargetFunction].typeId => typeId! }
    }
    node.kind == 9 -> if {
        node -> semanticInterpolationNodeIndex(sourceModule, context) => semanticIndex
        semanticIndex >= 0 and semanticIndex < (context.numericConversionResultTypeByNode -> len)
            -> if { context.numericConversionResultTypeByNode[semanticIndex] => typeId! }
    }
    typeId!
}

emitInterpolationResultPropagation labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    nodes[nodeIndex] => node
    node.operand0 < 0 -> if { return }
    node -> semanticInterpolationNodeIndex(sourceModule, context) => semanticIndex
    context.interpolationResultPropagationByNode[semanticIndex] => decision
    decision.status != 0 -> if { return }
    decision.operandTypeId => resultTypeId
    decision.functionTypeId => returnTypeId
    decision.okTypeId => okTypeId
    decision.operandErrorTypeId => errorTypeId
    context.types[errorTypeId] => errorType
    errorType.kind != 1 or errorType.origin != 1 or errorType.symbol != 0 => errorHasPayload
    "  store " -> print
    resultTypeId -> writeSemanticTypeId(context, state)
    " " -> print
    labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, labelIndex, context, state)
    ", ptr %interpolation$(labelIndex)_try$(nodeIndex)_slot, align $(context.typeAligns[resultTypeId])" -> println
    "  %interpolation$(labelIndex)_try$(nodeIndex)_tag = extractvalue " -> print
    resultTypeId -> writeSemanticTypeId(context, state)
    " " -> print
    labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, labelIndex, context, state)
    ", 0" -> println
    "  %interpolation$(labelIndex)_try$(nodeIndex)_is_error = icmp eq i32 %interpolation$(labelIndex)_try$(nodeIndex)_tag, 1" -> println
    "  br i1 %interpolation$(labelIndex)_try$(nodeIndex)_is_error, label %interpolation$(labelIndex)_try$(nodeIndex)_error, label %interpolation$(labelIndex)_try$(nodeIndex)_ok" -> println
    "interpolation$(labelIndex)_try$(nodeIndex)_error:" -> println
    errorHasPayload -> if {
        "  %interpolation$(labelIndex)_try$(nodeIndex)_error_addr = getelementptr inbounds " -> print
        resultTypeId -> writeSemanticTypeId(context, state)
        ", ptr %interpolation$(labelIndex)_try$(nodeIndex)_slot, i32 0, i32 1" -> println
        "  %interpolation$(labelIndex)_try$(nodeIndex)_error_value = load " -> print
        errorTypeId -> writeSemanticTypeId(context, state)
        ", ptr %interpolation$(labelIndex)_try$(nodeIndex)_error_addr, align $(context.typeAligns[errorTypeId])" -> println
    }
    "  store " -> print
    returnTypeId -> writeSemanticTypeId(context, state)
    " zeroinitializer, ptr %interpolation$(labelIndex)_try$(nodeIndex)_return_slot, align $(context.typeAligns[returnTypeId])" -> println
    "  %interpolation$(labelIndex)_try$(nodeIndex)_return_tag = getelementptr inbounds " -> print
    returnTypeId -> writeSemanticTypeId(context, state)
    ", ptr %interpolation$(labelIndex)_try$(nodeIndex)_return_slot, i32 0, i32 0" -> println
    "  store i32 1, ptr %interpolation$(labelIndex)_try$(nodeIndex)_return_tag, align 4" -> println
    errorHasPayload -> if {
        "  %interpolation$(labelIndex)_try$(nodeIndex)_return_payload = getelementptr inbounds " -> print
        returnTypeId -> writeSemanticTypeId(context, state)
        ", ptr %interpolation$(labelIndex)_try$(nodeIndex)_return_slot, i32 0, i32 1" -> println
        "  store " -> print
        errorTypeId -> writeSemanticTypeId(context, state)
        " %interpolation$(labelIndex)_try$(nodeIndex)_error_value, ptr %interpolation$(labelIndex)_try$(nodeIndex)_return_payload, align $(context.typeAligns[errorTypeId])" -> println
    }
    "  %interpolation$(labelIndex)_try$(nodeIndex)_return_value = load " -> print
    returnTypeId -> writeSemanticTypeId(context, state)
    ", ptr %interpolation$(labelIndex)_try$(nodeIndex)_return_slot, align $(context.typeAligns[returnTypeId])" -> println
    context.ir[labelIndex].parent => cleanupAncestor!
    cleanupAncestor! >= 0 and cleanupAncestor! != ownerIndex
        -> while {
            context.ir[cleanupAncestor!].kind == 19 or context.ir[cleanupAncestor!].kind == 1
                -> if {
                    OwnedDropRequest { regionIndex: cleanupAncestor!, beforeAst: context.ir[labelIndex].astNode, edgeIndex: labelIndex * 10 + 6, transferredSymbol: -1 } -> emitOwnedDrops([Int; ~], context, state)
                }
            context.ir[cleanupAncestor!].parent => cleanupAncestor!
        }
    "  ret " -> print
    returnTypeId -> writeSemanticTypeId(context, state)
    " %interpolation$(labelIndex)_try$(nodeIndex)_return_value" -> println
    "interpolation$(labelIndex)_try$(nodeIndex)_ok:" -> println
    "  %interpolation$(labelIndex)_try$(nodeIndex)_ok_addr = getelementptr inbounds " -> print
    resultTypeId -> writeSemanticTypeId(context, state)
    ", ptr %interpolation$(labelIndex)_try$(nodeIndex)_slot, i32 0, i32 1" -> println
    "  %v$(labelIndex)_expression$(nodeIndex) = load " -> print
    okTypeId -> writeSemanticTypeId(context, state)
    ", ptr %interpolation$(labelIndex)_try$(nodeIndex)_ok_addr, align $(context.typeAligns[okTypeId])" -> println
}

interpolationCallArgumentNeedsSliceProjection argumentIndex: Int, parameterIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    argumentIndex -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => argumentTypeId!
    argumentTypeId! >= 0 and argumentTypeId! < (context.types -> len) and context.types[argumentTypeId!].kind == 8
        -> if { context.types[argumentTypeId!].first => argumentTypeId! }
    (parameterIndex >= 0
        and parameterIndex < (context.ir -> len)
        and argumentTypeId! >= 0
        and argumentTypeId! < (context.types -> len)
        and context.ir[parameterIndex].typeId >= 0
        and context.ir[parameterIndex].typeId < (context.types -> len)
        and (context.types[argumentTypeId!].kind == 3 or context.types[argumentTypeId!].kind == 12)
        and context.types[context.ir[parameterIndex].typeId].kind == 2)
}

interpolationCallArgumentNeedsReferenceSlot argumentIndex: Int, parameterIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    argumentIndex -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => argumentTypeId
    context.ir -> len => irCount
    context.types -> len => typeCount
    parameterIndex >= 0 and parameterIndex < irCount => parameterInRange
    -1 => parameterTypeId!
    parameterInRange -> if { context.ir[parameterIndex].typeId => parameterTypeId! }
    argumentTypeId >= 0 and argumentTypeId < typeCount => argumentTypeInRange
    parameterTypeId! >= 0 and parameterTypeId! < typeCount => parameterTypeInRange
    argumentTypeInRange
        and parameterTypeInRange
        and context.types[parameterTypeId!].kind == 8
        and context.types[argumentTypeId].kind != 8
}

emitInterpolationCallReferenceArgumentAllocas labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    nodes[nodeIndex] => node
    node.kind == 8 or node.kind == 10 -> if {
        nodeIndex -> interpolationCallTargetFunction(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => callTargetFunction
        callTargetFunction >= 0 -> if {
            context.ir[callTargetFunction] => callTarget
            callTarget.operand1 => parameterIndex!
            node -> interpolationCallArgumentLimit => argumentLimit
            nodeIndex -> interpolationCallArgumentAt(0, nodes) => argumentIndex!
            0 => argumentOrdinal!
            parameterIndex! >= 0 and argumentIndex! >= 0 and argumentOrdinal! < argumentLimit
                -> while {
                    argumentIndex! -> interpolationCallArgumentNeedsReferenceSlot(
                    parameterIndex!,
                    nodes,
                    sourceModule,
                    ownerIndex,
                    beforeIndex,
                    context,
                    state) -> if {
                        context.types[context.ir[parameterIndex!].typeId].first => referenceOwnerType
                        "  %v$(labelIndex)_expression$(nodeIndex)_arg$(argumentOrdinal!)_ref = alloca " -> print
                        referenceOwnerType -> writeSemanticTypeId(context, state)
                        ", align $(context.typeAligns[referenceOwnerType])" -> println
                    }
                    argumentOrdinal! == 0 -> if { callTarget.nextOperand => parameterIndex! } else { context.ir[parameterIndex!].nextOperand => parameterIndex! }
                    argumentOrdinal! + 1 => argumentOrdinal!
                    nodeIndex -> interpolationCallArgumentAt(argumentOrdinal!, nodes) => argumentIndex!
                }
        }
    }
}

emitInterpolationFixedAllocas labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    nodes[nodeIndex] => node
    node.kind == 3 and (node.opcode == -24 or node.opcode == -25)
        -> if {
            "  %v$(labelIndex)_expression$(nodeIndex)_logical_slot = alloca i1, align 1" -> println
        }
    node.kind == 11 and node.operand0 >= 0 -> if {
        node -> semanticInterpolationNodeIndex(sourceModule, context) => semanticIndex
        semanticIndex >= 0 and semanticIndex < (context.interpolationResultPropagationByNode -> len)
            -> if {
                context.interpolationResultPropagationByNode[semanticIndex] => decision
                decision.status == 0 -> if {
                    "  %interpolation$(labelIndex)_try$(nodeIndex)_slot = alloca " -> print
                    decision.operandTypeId -> writeSemanticTypeId(context, state)
                    ", align $(context.typeAligns[decision.operandTypeId])" -> println
                    "  %interpolation$(labelIndex)_try$(nodeIndex)_return_slot = alloca " -> print
                    decision.functionTypeId -> writeSemanticTypeId(context, state)
                    ", align $(context.typeAligns[decision.functionTypeId])" -> println
                }
            }
    }
    node.kind == 7 and node.operand0 >= 0 and node.operand1 >= 0
        -> if {
            node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => receiverTypeId
            receiverTypeId >= 0 and context.types[receiverTypeId].kind == 13
                -> if {
                    receiverTypeId -> boundedDictionaryLayoutForType(context) => layout
                    "  %v$(labelIndex)_expression$(nodeIndex)_owner = alloca %sollang.bounded_dictionary.t$(receiverTypeId), align $(layout.align)" -> println
                }
        }
    node.kind == 6 and node.opcode == -243 and node.operand0 >= 0 and node.operand1 >= 0
        -> if {
            node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => receiverTypeId
            context.types -> typeIds.materializedReadTypeId(receiverTypeId) => setTypeId
            setTypeId >= 0 and context.types[setTypeId].kind == 7
                and context.types[setTypeId].origin == 4 and context.types[setTypeId].symbol == 5
                -> if {
                    context.types[setTypeId].first => keyTypeId
                    "  %iset$(labelIndex)_$(nodeIndex)_query_addr = alloca " -> print
                    keyTypeId -> writeSemanticTypeId(context, state)
                    ", align $(context.typeAligns[keyTypeId])" -> println
                }
        }
    node.kind == 16 -> if {
        node -> semanticInterpolationNodeIndex(sourceModule, context) => semanticIndex
        semanticIndex >= 0 and semanticIndex < (context.interpolationArrayByNode -> len)
            -> if {
                context.interpolationArrayByNode[semanticIndex] => literal
                literal.status == 0 and literal.typeId >= 0 and literal.elementTypeId >= 0
                    -> if {
                        context.types[literal.typeId] => arrayType
                        arrayType.kind == 12 -> if {
                            ArrayStorageIdentity { resultDomain: 1, resultIndex: nodeIndex, labelIndex: labelIndex } => identity
                            arrayType.length * (literal.elementTypeId -> arrayElementStorageSize(context, state)) => byteLength
                            "  " -> print
                            identity -> writeArrayStorageIdentity("_data")
                            " = alloca [$byteLength x i8], align " -> print
                            literal.elementTypeId -> arrayElementStorageAlign(context, state) -> writeDecimalLine
                        }
                    }
            }
    }
}

interpolationMemberFieldIndex nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    nodes[nodeIndex] => node
    node.kind == 5 and node.operand0 >= 0 and sourceModule >= 0 and sourceModule < (context.interpolationRanges -> len)
        -> if {
            nodeIndex => globalNodeIndex!
            (nodes -> len) != (context.interpolations -> len)
                -> if { context.interpolationRanges[sourceModule].nodeStart + nodeIndex => globalNodeIndex! }
            globalNodeIndex! >= 0 and globalNodeIndex! < (context.interpolationMemberFieldByNode -> len)
                -> if { context.interpolationMemberFieldByNode[globalNodeIndex!] -> return }
        }
    -1
}

canonicalMemberFieldIndex ownerTypeId: Int, sourceModule: Int, memberTokenIndex: Int, context: ref emitterContext.EmitContext -> Int {
    context.ranges[sourceModule] => memberRange
    context.tokens[memberRange.tokenStart + memberTokenIndex] => memberName
    -1 => fieldIndex!
    0 => fieldSearch!
    fieldSearch! < (context.fields -> len) -> while {
        context.fields[fieldSearch!] => field
        field.status == 0 and field.ownerType == ownerTypeId and field.sourceModule >= 0 and (field.fieldSymbol >= 0 or field.labelToken >= 0)
            -> if {
                context.ranges[field.sourceModule] => fieldRange
                field.labelToken => fieldNameToken!
                field.fieldSymbol >= 0 -> if {
                    context.symbols[fieldRange.symbolStart + field.fieldSymbol] => fieldSymbol
                    fieldSymbol.nameToken => fieldNameToken!
                }
                context.tokens[fieldRange.tokenStart + fieldNameToken!] => fieldName
                fieldName.span.length == memberName.span.length => equal!
                UIntSize(0) => nameByte!
                equal! and nameByte! < memberName.span.length
                    -> while {
                        (context.sources[sourceModule] -> byte(memberName.span.start + nameByte!)) != (context.sources[field.sourceModule] -> byte(fieldName.span.start + nameByte!))
                            -> if {
                                false => equal!
                            }
                        nameByte! + 1 => nameByte!
                    }
                equal! -> if { fieldSearch! => fieldIndex! }
            }
        fieldSearch! + 1 => fieldSearch!
    }
    fieldIndex!
}

canonicalMemberFieldOrdinalIndex ownerTypeId: Int, ordinal: Int, context: ref emitterContext.EmitContext -> Int {
    -1 => fieldIndex!
    0 => fieldSearch!
    fieldSearch! < (context.fields -> len) -> while {
        context.fields[fieldSearch!] => field
        field.status == 0 and field.ownerType == ownerTypeId and field.ordinal == ordinal
            -> if {
                fieldSearch! => fieldIndex!
            }
        fieldSearch! + 1 => fieldSearch!
    }
    fieldIndex!
}

canonicalMemberValueTypeId nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => valueTypeId!
    nodeIndex >= 0 and nodeIndex < (context.ir -> len)
        -> if {
            context.ir[nodeIndex] => node
            node.kind == 13 and node.operand0 >= 0 and node.operand0 < (context.ir -> len) and context.ir[node.operand0].typeId >= 0
                -> if {
                    context.ir[node.operand0] => memberBase
                    node -> sourceNode(context, state) => memberAst
                    memberBase -> sourceNode(context, state) => memberBaseAst
                    memberBaseAst.start + memberBaseAst.length => memberBaseEnd
                    memberAst.firstToken => memberTokenIndex!
                    true => beforeMemberBaseEnd!
                    beforeMemberBaseEnd! and memberTokenIndex! < memberAst.firstToken + memberAst.tokenCount
                        -> while {
                            context.tokens[context.ranges[node.sourceModule].tokenStart + memberTokenIndex!].span.start < memberBaseEnd
                                -> if {
                                    memberTokenIndex! + 1 => memberTokenIndex!
                                } else { false => beforeMemberBaseEnd! }
                        }
                    memberTokenIndex! => memberPathStart
                    0 => memberCount!
                    memberTokenIndex! < memberAst.firstToken + memberAst.tokenCount
                        -> while {
                            context.tokens[context.ranges[node.sourceModule].tokenStart + memberTokenIndex!].kind == grammar.tokenIdIdentifier()
                                -> if {
                                    memberCount! + 1 => memberCount!
                                }
                            memberTokenIndex! + 1 => memberTokenIndex!
                        }
                    memberBase.typeId => ownerTypeId!
                    0 => memberOrdinal!
                    true => pathValid!
                    memberPathStart => memberTokenIndex!
                    pathValid! and memberTokenIndex! < memberAst.firstToken + memberAst.tokenCount
                        -> while {
                            context.tokens[context.ranges[node.sourceModule].tokenStart + memberTokenIndex!].kind == grammar.tokenIdIdentifier()
                                -> if {
                                    ownerTypeId! >= 0 and ownerTypeId! < (context.types -> len) and (context.types[ownerTypeId!].kind == 8 or context.types[ownerTypeId!].kind == 6)
                                        -> if {
                                            context.types[ownerTypeId!].first => ownerTypeId!
                                        }
                                    -1 => fieldIndex!
                                    ownerTypeId! -> canonicalMemberFieldIndex(node.sourceModule, memberTokenIndex!, context) => fieldIndex!
                                    fieldIndex! < 0 and memberOrdinal! == memberCount! - 1
                                        -> if {
                                            ownerTypeId! -> canonicalMemberFieldOrdinalIndex(node.symbol, context) => fieldIndex!
                                        }
                                    fieldIndex! >= 0 -> if {
                                        context.fields[fieldIndex!].fieldType => ownerTypeId!
                                    } else { false => pathValid! }
                                    memberOrdinal! + 1 => memberOrdinal!
                                }
                            memberTokenIndex! + 1 => memberTokenIndex!
                        }
                    pathValid! and memberCount! > 0 and memberOrdinal! == memberCount!
                        -> if { ownerTypeId! => valueTypeId! }
                }
        }
    valueTypeId!
}

canonicalMemberPathAvailable nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    (nodeIndex -> canonicalMemberValueTypeId(context, state)) >= 0
}

interpolationIntegerTypeSymbol nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, fallbackSymbol: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    nodeIndex -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => typeId
    typeId >= 0 and typeId < (context.types -> len)
        -> if {
            context.types[typeId] => concreteType
            concreteType.kind == 1 and concreteType.origin == 1
                and (concreteType.symbol -> integerWidth(context, state)) > 0
                -> if { concreteType.symbol -> return }
        }
    fallbackSymbol
}

interpolationNodeIntegerWidth nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    nodes[nodeIndex] => node
    node.typeSymbol -> integerWidth(context, state) => width!
    node.typeSymbol == 12 or node.typeSymbol == 13
        -> if { context.pointerBitWidth => width! }
    node -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => bindingIndex
    node.kind == 1 and bindingIndex >= 0 -> if {
        context.ir[bindingIndex] => binding
        0 => bindingWidth!
        binding.typeId >= 0 and binding.typeId < (context.types -> len)
            -> if {
                context.types[binding.typeId].symbol -> integerWidth(context, state) => bindingWidth!
                context.types[binding.typeId].symbol == 12 or context.types[binding.typeId].symbol == 13
                    -> if { context.pointerBitWidth => bindingWidth! }
            }
        bindingWidth! <= 0 -> if { binding -> integerNodeWidth(context, state) => bindingWidth! }
        bindingWidth! > 0 -> if { bindingWidth! => width! }
    }
    node.kind == 1 -> if {
        nodeIndex -> interpolationReferenceValueTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => referenceValueTypeId
        referenceValueTypeId >= 0 -> if {
            context.types[referenceValueTypeId].symbol -> integerWidth(context, state) => referenceValueWidth
            referenceValueWidth > 0 -> if { referenceValueWidth => width! }
        }
    }
    node.kind == 1 and bindingIndex < 0 -> if {
        nodeIndex -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => roleTypeId
        roleTypeId >= 0 and roleTypeId < (context.types -> len)
            -> if {
                context.types[roleTypeId].symbol -> integerWidth(context, state) => roleWidth!
                context.types[roleTypeId].symbol == 12 or context.types[roleTypeId].symbol == 13
                    -> if { context.pointerBitWidth => roleWidth! }
                roleWidth! > 0 -> if { roleWidth! => width! }
            }
    }
    node.kind == 0 or node.kind == 2 or node.kind == 3 or node.kind == 5 or node.kind == 6 or node.kind == 7 or node.kind == 8 or node.kind == 10 or node.kind == 11 or node.kind == 17
        -> if {
            nodeIndex -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => indexTypeId
            indexTypeId >= 0 -> if {
                context.types[indexTypeId] => indexType
                indexType.symbol -> integerWidth(context, state) => indexWidth!
                indexType.symbol == 12 or indexType.symbol == 13
                    -> if { context.pointerBitWidth => indexWidth! }
                indexWidth! > 0 -> if { indexWidth! => width! }
            }
        }
    width!
}

interpolationNodeSigned nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    nodes[nodeIndex] => node
    node.typeSymbol -> integerSigned(context, state) => signed!
    node.kind == 1 -> if {
        node -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => bindingIndex
        bindingIndex >= 0 -> if {
            context.ir[bindingIndex] => binding
            binding.typeId >= 0 and binding.typeId < (context.types -> len)
                -> if {
                    context.types[binding.typeId].symbol -> integerSigned(context, state) => signed!
                } else { binding -> integerNodeSigned(context, state) => signed! }
        }
        bindingIndex < 0 -> if {
            nodeIndex -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => roleTypeId
            roleTypeId >= 0 and roleTypeId < (context.types -> len)
                -> if { context.types[roleTypeId].symbol -> integerSigned(context, state) => signed! }
        }
        nodeIndex -> interpolationReferenceValueTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => referenceValueTypeId
        referenceValueTypeId >= 0 -> if {
            context.types[referenceValueTypeId].symbol -> integerSigned(context, state) => signed!
        }
    }
    node.kind == 2 or node.kind == 3 or node.kind == 5 or node.kind == 6 or node.kind == 7 or node.kind == 8 or node.kind == 10 or node.kind == 17
        -> if {
            nodeIndex -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => typeId
            typeId >= 0 -> if { context.types[typeId].symbol -> integerSigned(context, state) => signed! }
        }
    signed!
}

interpolationHasLogicalAncestor nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~] -> Bool {
    nodes[nodeIndex].parent => ancestor!
    false => found!
    ancestor! >= 0 and not found! -> while {
        nodes[ancestor!] => candidate
        candidate.kind == 3 and (candidate.opcode == -24 or candidate.opcode == -25)
            -> if {
                true => found!
            } else {
                candidate.parent => ancestor!
            }
    }
    found!
}

emitBoundedInterpolationDictionaryIndex labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, dictionaryTypeId: Int, isReference: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    nodes[nodeIndex] => node
    context.types[dictionaryTypeId] => dictionaryType
    dictionaryType.first => keyTypeId
    dictionaryType.second => valueTypeId
    dictionaryTypeId -> boundedDictionaryLayoutForType(context) => layout
    Arena(0) => labelStorage!
    "v$(labelIndex)_expression$(nodeIndex)" -> materialize(labelStorage!) => prefix
    isReference -> if {
        "  %$(prefix)_owner = freeze ptr " -> print
        labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
        "" -> println
    } else {
        "  store %sollang.bounded_dictionary.t$(dictionaryTypeId) " -> print
        labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
        ", ptr %$(prefix)_owner, align $(layout.align)" -> println
    }
    prefix -> emitBoundedDictionaryStoragePointer("%$(prefix)_owner", dictionaryTypeId)
    "  %$(prefix)_query = freeze " -> print
    keyTypeId -> writeSemanticTypeId(context, state)
    " " -> print
    labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
    "" -> println
    "$(prefix)_find" -> emitBoundedDictionaryFindRequiredSlot("%$(prefix)_storage", "%$(prefix)_query", dictionaryTypeId, true, context, state)
    "$(prefix)_value" -> emitBoundedDictionaryEntryPointer("%$(prefix)_storage", "%$(prefix)_find_slot", layout.valueOffset, layout)
    "  %$(prefix) = load " -> print
    valueTypeId -> writeAggregateFieldTypeId(context, state)
    ", ptr %$(prefix)_value_ptr, align $(layout.valueAlign)" -> println
}

# Dynamic dictionary indexing derives field aliases from the canonical storage owner.
emitInterpolationDictionaryIndex labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, dictionaryTypeId: Int, isReference: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    nodes[nodeIndex] => node
    context.types[dictionaryTypeId] => dictionaryType
    dictionaryType.kind == 13 -> if {
        labelIndex -> emitBoundedInterpolationDictionaryIndex(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, dictionaryTypeId, isReference, context, state)
        return
    }
    dictionaryType.first => keyTypeId
    dictionaryType.second => valueTypeId
    context.types[keyTypeId] => keyType
    keyType.kind == 1 and keyType.origin == 1 and keyType.symbol == 1 => keyIsText
    keyType.kind == 1 and (keyType.origin == 0 or keyType.origin == 2) => keyIsNominal
    keyTypeId -> traitMethodSymbol("Hash", "hash", context, state) => hashMethod
    keyTypeId -> traitMethodSymbol("Eq", "eq", context, state) => eqMethod
    keyType.symbol -> integerWidth(context, state) => hashWidth!
    keyType.symbol == 12 or keyType.symbol == 13 -> if { context.pointerBitWidth => hashWidth! }
    keyType.symbol -> integerSigned(context, state) => hashSigned
    Arena(0) => labelStorage!
    "v$(labelIndex)_expression$(nodeIndex)" -> materialize(labelStorage!) => prefix
    "  %$(prefix)_dictionary = " -> print
    isReference -> if { "load %sollang.dict, ptr " -> print } else { "freeze %sollang.dict " -> print }
    labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
    isReference -> if { ", align 8" -> print }
    "" -> println
    "  %$(prefix)_query = freeze " -> print
    keyTypeId -> writeSemanticTypeId(context, state)
    " " -> print
    labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
    "" -> println
    "  %$(prefix)_storage = extractvalue %sollang.dict %$(prefix)_dictionary, 0" -> println
    "  %$(prefix)_capacity = extractvalue %sollang.dict %$(prefix)_dictionary, 2" -> println
    keyTypeId -> dictionaryEntryLayoutForTypeIds(valueTypeId, 0, 0, context, state) => entryLayout
    prefix -> emitGrowableDictionaryPointers("%$(prefix)_storage", "%$(prefix)_capacity", entryLayout)
    "  %$(prefix)_nonempty = icmp ugt i64 %$(prefix)_capacity, 0" -> println
    "  br i1 %$(prefix)_nonempty, label %$(prefix)_lookup_start, label %$(prefix)_missing" -> println
    "$(prefix)_lookup_start:" -> println
    prefix -> emitSetHashValue("%$(prefix)_query", keyTypeId, hashMethod, keyIsText, keyIsNominal, hashWidth!, hashSigned, context, state)
    "  %$(prefix)_h2_shift = lshr i64 %$(prefix)_hash, 57" -> println
    "  %$(prefix)_h2_raw = and i64 %$(prefix)_h2_shift, 127" -> println
    "  %$(prefix)_h2_zero = icmp eq i64 %$(prefix)_h2_raw, 0" -> println
    "  %$(prefix)_h2_value = select i1 %$(prefix)_h2_zero, i64 1, i64 %$(prefix)_h2_raw" -> println
    "  %$(prefix)_h2 = trunc i64 %$(prefix)_h2_value to i8" -> println
    Arena(0) => probePrefixStorage!
    "$(prefix)_probe" -> materialize(probePrefixStorage!) => probePrefix
    Arena(0) => probeControlsStorage!
    "%$(prefix)_controls" -> materialize(probeControlsStorage!) => probeControls
    Arena(0) => probeKeysStorage!
    "%$(prefix)_keys" -> materialize(probeKeysStorage!) => probeKeys
    Arena(0) => probeCapacityStorage!
    "%$(prefix)_capacity" -> materialize(probeCapacityStorage!) => probeCapacity
    Arena(0) => probeQueryStorage!
    "%$(prefix)_query" -> materialize(probeQueryStorage!) => probeQuery
    Arena(0) => probeHashStorage!
    "%$(prefix)_hash" -> materialize(probeHashStorage!) => probeHash
    Arena(0) => probeH2Storage!
    "%$(prefix)_h2" -> materialize(probeH2Storage!) => probeH2
    DictionaryProbe {
        prefix: probePrefix
        controls: probeControls
        keys: probeKeys
        capacity: probeCapacity
        query: probeQuery
        hash: probeHash
        h2: probeH2
        keyTypeId: keyTypeId
        keySymbol: 0
        valueTypeId: valueTypeId
        valueSymbol: 0
        entryLayout: entryLayout
        existingOnly: true
        bounded: false
    } => probe
    probe -> emitDictionaryFindSlot(context, state)
    "  %$(prefix)_slot = add i64 %$(prefix)_probe_slot, 0" -> println
    "  br i1 %$(prefix)_probe_found, label %$(prefix)_hit, label %$(prefix)_missing" -> println
    "$(prefix)_missing:" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "$(prefix)_hit:" -> println
    "  %$(prefix)_value_ptr = getelementptr " -> print
    entryLayout -> writeDictionaryEntryStorageType
    ", ptr %$(prefix)_values, i64 %$(prefix)_slot" -> println
    "  %$(prefix) = load " -> print
    valueTypeId -> writeSemanticTypeId(context, state)
    ", ptr %$(prefix)_value_ptr, align $(context.typeAligns[valueTypeId])" -> println
}

emitInterpolationContextualStruct labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, lexicalLoads: Bool, recursiveValues: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.interpolationRanges[sourceModule].nodeStart => globalNodeStart
    context.interpolationContextualDiagnosticByNode[globalNodeStart + nodeIndex].ownerType => typeId
    0 => fieldCount!
    context.fields -> each field {
        field.status == 0 and field.ownerType == typeId
            -> if { fieldCount! + 1 => fieldCount! }
    }
    fieldCount! == 0 -> if {
        "  %v$(labelIndex)_expression$(nodeIndex) = freeze " -> print
        typeId -> writeSemanticTypeId(context, state)
        " poison" -> println
        return
    }
    0 => ordinal!
    ordinal! < fieldCount! -> while {
        -1 => fieldIndex!
        0 => fieldSearch!
        fieldSearch! < (context.fields -> len) -> while {
            context.fields[fieldSearch!].status == 0 and context.fields[fieldSearch!].ownerType == typeId
                and context.fields[fieldSearch!].ordinal == ordinal!
                -> if { fieldSearch! => fieldIndex! }
            fieldSearch! + 1 => fieldSearch!
        }
        -1 => valueIndex!
        nodeIndex + 1 => labelSearch!
        labelSearch! < (nodes -> len) -> while {
            nodes[labelSearch!].parent == nodeIndex and globalNodeStart + labelSearch! < (context.interpolationContextualFieldByNode -> len)
                and context.interpolationContextualFieldByNode[globalNodeStart + labelSearch!] == fieldIndex!
                -> if {
                    labelSearch! + 1 => valueSearch!
                    valueSearch! < (nodes -> len) and valueIndex! < 0
                        -> while {
                            nodes[valueSearch!].parent == nodeIndex -> if { valueSearch! => valueIndex! }
                            valueSearch! + 1 => valueSearch!
                        }
                }
            labelSearch! + 1 => labelSearch!
        }
        recursiveValues -> if {
            labelIndex -> emitInterpolationSubtree(valueIndex!, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, context, state)
        }
        context.fields[fieldIndex!].fieldType => fieldValueType
        context.types[fieldValueType].kind == 12 -> if {
            Arena(0) => prefixStorage!
            "v$(labelIndex)_expression$(nodeIndex)_field$(ordinal!)_bounded" -> materialize(prefixStorage!) => prefix
            prefix -> emitInterpolationBoundedValue(labelIndex, valueIndex!, fieldValueType, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
        }
        ordinal! + 1 == fieldCount! -> if {
            "  %v$(labelIndex)_expression$(nodeIndex) = insertvalue " -> print
        } else {
            "  %v$(labelIndex)_expression$(nodeIndex)_field$(ordinal!) = insertvalue " -> print
        }
        typeId -> writeSemanticTypeId(context, state)
        ordinal! == 0 -> if { " poison, " -> print } else {
            " %v$(labelIndex)_expression$(nodeIndex)_field$(ordinal! - 1), " -> print
        }
        context.fields[fieldIndex!].fieldType -> writeSemanticTypeId(context, state)
        " " -> print
        context.types[fieldValueType].kind == 12 -> if {
            "%v$(labelIndex)_expression$(nodeIndex)_field$(ordinal!)_bounded" -> print
        } else { labelIndex -> writeInterpolationValue(valueIndex!, nodes, sourceModule, ownerIndex, beforeIndex, context, state) }
        ", $(ordinal!)" -> println
        ordinal! + 1 => ordinal!
    }
}

# Interpolation uses its own expression tree, so retain the same readonly-call
# lifetime contract as Typed IR: a projected anonymous producer is the owner,
# while a projection rooted in a name is a stable place.
emitInterpolationCallTemporaryDrops labelIndex: Int, callIndex: Int, targetIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[targetIndex] => target
    target.operand1 => parameterIndex!
    0 => ordinal!
    nodes[callIndex] -> interpolationCallArgumentLimit => argumentLimit
    [Int; ~] => temporaryOwners!
    [Int; ~] => temporaryOrdinals!
    callIndex -> interpolationCallArgumentAt(ordinal!, nodes) => argumentIndex!
    parameterIndex! >= 0 and argumentIndex! >= 0 and ordinal! < argumentLimit
        -> while {
            context.ir[parameterIndex!] => parameter
            argumentIndex! => ownerNodeIndex!
            nodes[ownerNodeIndex!].kind == 5 and nodes[ownerNodeIndex!].operand0 >= 0
                -> while { nodes[ownerNodeIndex!].operand0 => ownerNodeIndex! }
            nodes[ownerNodeIndex!] => ownerNode
            ownerNodeIndex! -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => ownerTypeId
            false => alreadyDropped!
            temporaryOwners! -> each temporaryOwner {
                temporaryOwner == ownerNodeIndex! -> if { true => alreadyDropped! }
            }
            parameter.flags % 4 == 0 and not alreadyDropped!
                and (ownerNode.kind == 8 or ownerNode.kind == 10 or ownerNode.kind == 15 or ownerNode.kind == 16)
                and ownerTypeId >= 0 and ownerTypeId < (context.types -> len)
                and ((ownerTypeId -> semanticTypeOwns(context, state))
                or context.types[ownerTypeId].kind == 4)
                -> if {
                    temporaryOwners! -> push(ownerNodeIndex!)
                    temporaryOrdinals! -> push(ordinal!)
                }
            ordinal! == 0 -> if { target.nextOperand => parameterIndex! } else {
                parameter.nextOperand => parameterIndex!
            }
            ordinal! + 1 => ordinal!
            callIndex -> interpolationCallArgumentAt(ordinal!, nodes) => argumentIndex!
        }
    Int(temporaryOwners! -> len) - 1 => temporaryIndex!
    temporaryIndex! >= 0 -> while {
        temporaryOwners![temporaryIndex!] => temporaryOwner
        temporaryOrdinals![temporaryIndex!] => temporaryOrdinal
        temporaryOwner -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => temporaryTypeId
        context.types[temporaryTypeId].kind == 4 -> if {
            "  %v$(labelIndex)_expression$(callIndex)_temporary$(temporaryOrdinal) = extractvalue { ptr, i64 } " -> print
            labelIndex -> writeInterpolationValue(temporaryOwner, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
            ", 0" -> println
            temporaryTypeId -> semanticTypeOwns(context, state)
                -> if {
                    "  %v$(labelIndex)_expression$(callIndex)_temporary$(temporaryOrdinal)_elements = load " -> print
                    temporaryTypeId -> writeSemanticTypeId(context, state)
                    ", ptr %v$(labelIndex)_expression$(callIndex)_temporary$(temporaryOrdinal), align $(context.typeAligns[temporaryTypeId])" -> println
                    "  call void @sollang_drop_t$(temporaryTypeId)(" -> print
                    temporaryTypeId -> writeSemanticTypeId(context, state)
                    " %v$(labelIndex)_expression$(callIndex)_temporary$(temporaryOrdinal)_elements)" -> println
                }
            "  call void @free(ptr %v$(labelIndex)_expression$(callIndex)_temporary$(temporaryOrdinal))" -> println
        } else {
            context.types[temporaryTypeId].kind == 12 -> if {
                Arena(0) => prefixStorage!
                "v$(labelIndex)_expression$(callIndex)_temporary$(temporaryOrdinal)_bounded" -> materialize(prefixStorage!) => prefix
                prefix -> emitInterpolationBoundedValue(labelIndex, temporaryOwner, temporaryTypeId, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
            }
            "  call void @sollang_drop_t$(temporaryTypeId)(" -> print
            temporaryTypeId -> writeSemanticTypeId(context, state)
            " " -> print
            context.types[temporaryTypeId].kind == 12 -> if {
                "%v$(labelIndex)_expression$(callIndex)_temporary$(temporaryOrdinal)_bounded" -> print
            } else { labelIndex -> writeInterpolationValue(temporaryOwner, nodes, sourceModule, ownerIndex, beforeIndex, context, state) }
            ")" -> println
        }
        temporaryIndex! - 1 => temporaryIndex!
    }
}

# Interpolation expressions use the same local handles and canonical value
# boundaries as ordinary Typed IR, despite having a separate expression tree.
writeInterpolationRuntimeTypeId typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.types[typeId].kind == 12 -> if { "%sollang.array.i32" -> print } else {
        typeId -> writeSemanticTypeId(context, state)
    }
}

emitInterpolationBoundedValue prefix: Text, labelIndex: Int, nodeIndex: Int, typeId: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    nodeIndex -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => sourceTypeId
    sourceTypeId >= 0 and context.types[sourceTypeId].kind == 8
        -> if {
            "  %$(prefix) = load " -> print
            typeId -> writeValueAbiTypeId(context, state)
            ", ptr " -> print
            labelIndex -> writeInterpolationValue(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
            ", align $(context.typeAligns[typeId])" -> println
            return
        }
    "  %$(prefix)_handle = freeze %sollang.array.i32 " -> print
    labelIndex -> writeInterpolationValue(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
    "" -> println
    Arena(0) => nameStorage!
    "%$(prefix)_handle" -> materialize(nameStorage!) => handle
    prefix -> emitBoundedArrayValueFromHandle(handle, typeId, context, state)
}

emitInterpolationBoundedReference prefix: Text, labelIndex: Int, nodeIndex: Int, typeId: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    "  %$(prefix)_bounded_value = load " -> print
    typeId -> writeValueAbiTypeId(context, state)
    ", ptr " -> print
    labelIndex -> writeInterpolationValue(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
    ", align $(context.typeAligns[typeId])" -> println
    prefix -> emitStoredBoundedValueHandle(typeId, context, state)
}

interpolationBoundedFunctionResultTypeId functionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.ir[functionIndex] => function
    function.flags / 8 % 2 == 1 or (function -> isNativeFunction(context, state))
        -> if { -1 -> return }
    function -> boundedArrayValueTypeId(context, state)
}

writeInterpolationArrayElementValue labelIndex: Int, elementNode: Int, elementTypeId: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    elementNode -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => sourceTypeId
    sourceTypeId >= 0 and context.types[sourceTypeId].kind == 8
        -> if {
            "%v$(labelIndex)_expression$(elementNode)_reference_value" -> print
            return
        }
    context.types[elementTypeId] => elementType
    elementType.kind == 1 and elementType.origin == 1
        -> if {
            elementType.symbol -> typeIds.canonicalBuiltinSymbol => builtin
            builtin == 20 or builtin == 21 -> if {
                labelIndex -> writeInterpolationFloatScalarValue(elementNode, builtin, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                return
            }
            (builtin -> integerWidth(context, state)) > 0
                and (elementNode -> interpolationIntegerLiteralSyntax(nodes, sourceModule, context))
                -> if {
                    elementNode -> writeInterpolationIntegerSyntaxLiteral(nodes, sourceModule, context)
                    return
                }
        }
    labelIndex -> writeInterpolationScalarValue(elementNode, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
}

emitInterpolationArray labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, lexicalLoads: Bool, recursiveValues: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    nodes[nodeIndex] -> semanticInterpolationNodeIndex(sourceModule, context) => semanticIndex
    semanticIndex < 0 or semanticIndex >= (context.interpolationArrayByNode -> len)
        -> if { return }
    context.interpolationArrayByNode[semanticIndex] => literal
    literal.status != 0 or literal.typeId < 0 or literal.elementTypeId < 0
        -> if { return }
    [Int; ~] => elements!
    0 => childIndex!
    childIndex! < (nodes -> len) -> while {
        nodes[childIndex!].parent == nodeIndex -> if {
            elements! -> push(childIndex!)
            recursiveValues -> if {
                labelIndex -> emitInterpolationSubtree(childIndex!, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, context, state)
            }
            childIndex! -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => sourceTypeId
            sourceTypeId >= 0 and context.types[sourceTypeId].kind == 8
                -> if {
                    labelIndex -> emitInterpolationReferenceValue(childIndex!, literal.elementTypeId, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                }
        }
        childIndex! + 1 => childIndex!
    }
    context.types[literal.typeId] => arrayType
    literal.elementCount => length
    length => capacity!
    arrayType.kind == 3 and literal.dynamic and literal.storageLength >= 0
        -> if { literal.storageLength => capacity! }
    arrayType.kind == 12 -> if { arrayType.length => capacity! }
    ArrayStorageIdentity { resultDomain: 1, resultIndex: nodeIndex, labelIndex: labelIndex } => identity
    capacity! * (literal.elementTypeId -> arrayElementStorageSize(context, state)) => byteLength
    arrayType.kind != 12 -> if { identity -> emitArrayHeapBacking(byteLength) }
    0 => position!
    position! < length -> while {
        position! => elementOrdinal!
        not literal.dynamic and not literal.bounded and literal.storageLength >= 0
            -> if { 0 => elementOrdinal! }
        elements![elementOrdinal!] => elementNode
        context.types[literal.elementTypeId].kind == 12
            -> if {
                Arena(0) => prefixStorage!
                "v$(labelIndex)_expression$(nodeIndex)_element$(position!)_bounded" -> materialize(prefixStorage!) => prefix
                prefix -> emitInterpolationBoundedValue(labelIndex, elementNode, literal.elementTypeId, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
            }
        identity -> emitArrayElementStorePrefix(position!, literal.elementTypeId, -1, context, state)
        context.types[literal.elementTypeId].kind == 12
            -> if {
                "%v$(labelIndex)_expression$(nodeIndex)_element$(position!)_bounded" -> print
            } else { labelIndex -> writeInterpolationArrayElementValue(elementNode, literal.elementTypeId, nodes, sourceModule, ownerIndex, beforeIndex, context, state) }
        identity -> emitArrayElementStoreSuffix(position!, literal.elementTypeId -> arrayElementStorageAlign(context, state))
        position! + 1 => position!
    }
    identity -> emitArrayStorageCarrier(length, capacity!, arrayType.kind == 2 or arrayType.kind == 4)
}

emitInterpolationSubtree labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, lexicalLoads: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    nodes[nodeIndex] => node
    node.kind == 16 -> if {
        labelIndex -> emitInterpolationArray(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, true, context, state)
        return
    }
    node.kind == 12 or node.kind == 14 -> if {
        labelIndex -> emitInterpolationContextualStruct(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, true, context, state)
        return
    }
    node.kind == 3 and (node.opcode == -24 or node.opcode == -25)
        -> if {
            labelIndex -> emitInterpolationSubtree(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, context, state)
            "  store i1 " -> print
            node.opcode == -25 -> if { "0" -> print } else { "1" -> print }
            ", ptr %v$(labelIndex)_expression$(nodeIndex)_logical_slot, align 1" -> println
            "  br i1 " -> print
            labelIndex -> writeInterpolationScalarValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
            ", label %interpolation$(labelIndex)_logical$(nodeIndex)_" -> print
            node.opcode == -25 -> if { "rhs" -> print } else { "end" -> print }
            ", label %interpolation$(labelIndex)_logical$(nodeIndex)_" -> print
            node.opcode == -25 -> if { "end" -> print } else { "rhs" -> print }
            "" -> println
            "interpolation$(labelIndex)_logical$(nodeIndex)_rhs:" -> println
            labelIndex -> emitInterpolationSubtree(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, context, state)
            "  store i1 " -> print
            labelIndex -> writeInterpolationScalarValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
            ", ptr %v$(labelIndex)_expression$(nodeIndex)_logical_slot, align 1" -> println
            "  br label %interpolation$(labelIndex)_logical$(nodeIndex)_end" -> println
            "interpolation$(labelIndex)_logical$(nodeIndex)_end:" -> println
            "  %v$(labelIndex)_expression$(nodeIndex) = load i1, ptr %v$(labelIndex)_expression$(nodeIndex)_logical_slot, align 1" -> println
        } else {
            (node.kind == 8 or node.kind == 10) and node.argumentCount > 3
                -> if {
                    0 => argumentOrdinal!
                    argumentOrdinal! < node.argumentCount -> while {
                        nodeIndex -> interpolationCallArgumentAt(argumentOrdinal!, nodes) => argumentIndex
                        argumentIndex >= 0 -> if {
                            labelIndex -> emitInterpolationSubtree(argumentIndex, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, context, state)
                        }
                        argumentOrdinal! + 1 => argumentOrdinal!
                    }
                } else {
                    node.operand0 >= 0 -> if { labelIndex -> emitInterpolationSubtree(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, context, state) }
                    node.operand1 >= 0 -> if { labelIndex -> emitInterpolationSubtree(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, context, state) }
                    node.operand2 >= 0 -> if { labelIndex -> emitInterpolationSubtree(node.operand2, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, context, state) }
                }
            labelIndex -> emitInterpolationIntrinsic(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, context, state)
            labelIndex -> emitInterpolationOperation(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
        }
}

interpolationIntegerSigned nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    nodes[nodeIndex] => node
    node.typeSymbol => symbol!
    node.operand0 >= 0 -> if {
        node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => operandTypeId
        operandTypeId >= 0 and operandTypeId < (context.types -> len)
            -> if {
                context.types[operandTypeId] => operandType
                operandType.kind == 1 and operandType.origin == 1
                    -> if { operandType.symbol => symbol! }
            }
    }
    symbol! -> integerSigned(context, state) => signed!
    node.operand0 >= 0 -> if {
        node.operand0 -> interpolationReferenceValueTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => referenceValueTypeId
        referenceValueTypeId >= 0 -> if {
            context.types[referenceValueTypeId].symbol -> integerSigned(context, state) => signed!
        }
    }
    signed!
}

interpolationQuotientOperation nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Text {
    nodeIndex -> interpolationIntegerSigned(nodes, sourceModule, ownerIndex, beforeIndex, context, state)
        -> if { "sdiv" } else { "udiv" }
}

interpolationRemainderOperation nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Text {
    nodeIndex -> interpolationIntegerSigned(nodes, sourceModule, ownerIndex, beforeIndex, context, state)
        -> if { "srem" } else { "urem" }
}

interpolationComparisonOperation nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Text {
    nodes[nodeIndex] => node
    nodeIndex -> interpolationIntegerSigned(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => signed
    node.opcode == grammar.tokenIdLess() -> if {
        signed -> if { "icmp slt" } else { "icmp ult" }
    } else {
        node.opcode == grammar.tokenIdLessEqual() -> if {
            signed -> if { "icmp sle" } else { "icmp ule" }
        } else {
            node.opcode == grammar.tokenIdGreater() -> if {
                signed -> if { "icmp sgt" } else { "icmp ugt" }
            } else {
                signed -> if { "icmp sge" } else { "icmp uge" }
            }
        }
    }
}

semanticInterpolationNodeIndex node: interpolation.InterpolationNode, sourceModule: Int, context: ref emitterContext.EmitContext -> Int {
    sourceModule < 0 or sourceModule >= (context.interpolationRanges -> len)
        -> if { -1 -> return }
    context.interpolationRanges[sourceModule] => range
    0 => nodeOffset!
    nodeOffset! < range.nodeCount -> while {
        range.nodeStart + nodeOffset! => globalIndex
        context.interpolations[globalIndex] => candidate
        candidate.kind == node.kind and candidate.sourceToken == node.sourceToken
            and candidate.segment == node.segment and candidate.opcode == node.opcode
            and candidate.payloadStart == node.payloadStart and candidate.payloadLength == node.payloadLength
            and candidate.expressionStart == node.expressionStart and candidate.expressionLength == node.expressionLength
            -> if { globalIndex -> return }
        nodeOffset! + 1 => nodeOffset!
    }
    -1
}

interpolationBinaryNumericWidth node: interpolation.InterpolationNode, sourceModule: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    node.kind != 3 -> if { 0 -> return }
    node -> semanticInterpolationNodeIndex(sourceModule, context) => semanticIndex
    semanticIndex < 0 -> if { 0 -> return }
    -1 => operandTypeId!
    semanticIndex < (context.binaryArithmeticDiagnosticByNode -> len)
        -> if {
            context.binaryArithmeticDiagnosticByNode[semanticIndex] => arithmetic
            arithmetic.code == 0 and arithmetic.leftTypeId >= 0 and arithmetic.rightTypeId >= 0
                -> if { arithmetic.leftTypeId => operandTypeId! }
        }
    operandTypeId! < 0 and semanticIndex < (context.binaryComparisonDiagnosticByNode -> len)
        -> if {
            context.binaryComparisonDiagnosticByNode[semanticIndex] => comparison
            comparison.code == 0 and comparison.leftTypeId >= 0 and comparison.rightTypeId >= 0
                -> if { comparison.leftTypeId => operandTypeId! }
        }
    operandTypeId! < 0 or operandTypeId! >= (context.types -> len)
        -> if { 0 -> return }
    context.types[operandTypeId!] => operandType
    operandType.kind != 1 or operandType.origin != 1
        -> if { 0 -> return }
    operandType.symbol -> typeIds.canonicalBuiltinSymbol => builtin
    builtin == 12 or builtin == 13 -> if { context.pointerBitWidth -> return }
    builtin -> integerWidth(context, state)
}

interpolationFloatComparisonBuiltin node: interpolation.InterpolationNode, sourceModule: Int, context: ref emitterContext.EmitContext -> Int {
    node.kind != 3 -> if { -1 -> return }
    node -> semanticInterpolationNodeIndex(sourceModule, context) => semanticIndex
    semanticIndex < 0 or semanticIndex >= (context.binaryComparisonDiagnosticByNode -> len)
        -> if { -1 -> return }
    context.binaryComparisonDiagnosticByNode[semanticIndex] => comparison
    comparison.code != 0 or comparison.textEquality or comparison.leftTypeId < 0
        or comparison.rightTypeId < 0 or comparison.leftTypeId >= (context.types -> len)
        -> if { -1 -> return }
    context.types[comparison.leftTypeId] => operandType
    operandType.kind != 1 or operandType.origin != 1
        -> if { -1 -> return }
    operandType.symbol -> typeIds.canonicalBuiltinSymbol => builtin
    builtin == 20 or builtin == 21 -> if { builtin -> return }
    -1
}

emitInterpolationOperation labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    nodes[nodeIndex] => node
    node -> interpolationEnumConstructorIndex(sourceModule, context) => enumConstructorIndex
    enumConstructorIndex >= 0 -> if {
        context.interpolationEnumConstructors[enumConstructorIndex] => constructor
        false => borrowedPayload!
        -1 => payloadTypeId!
        -1 => payloadInterpolation!
        constructor.argumentNode >= 0 -> if {
            constructor.argumentNode -> interpolationEnumPayloadBorrows(sourceModule, ownerIndex, beforeIndex, context, state) => borrowedPayload!
            constructor.expectedTypeId => payloadTypeId!
            constructor.argumentNode - (constructor.callNode - nodeIndex) => payloadInterpolation!
        }
        EnumStorageRequest {
            resultDomain: 1, resultIndex: nodeIndex, enumTypeId: constructor.enumTypeId,
            variantTag: constructor.variantTag, payloadTypeId: payloadTypeId!,
            payloadIr: -1, payloadInterpolation: payloadInterpolation!,
            labelIndex: labelIndex, sourceModule: sourceModule, ownerIndex: ownerIndex,
            beforeIndex: beforeIndex,
            copyBorrowedFixed: borrowedPayload! and (constructor.expectedTypeId -> fixedStructCopyState(0, context)) == 1
        } -> emitEnumStorage(nodes, context, state)
        constructor.argumentNode >= 0 -> if {
            constructor.argumentNode -> emitInterpolationEnumTransferMark(sourceModule, ownerIndex, beforeIndex, context, state)
        }
        return
    }
    node.kind == 2 and node.opcode != -26 -> if {
        nodeIndex -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => unaryTypeId
        unaryTypeId >= 0 and unaryTypeId < (context.types -> len)
            -> if {
                context.types[unaryTypeId] => unaryType
                unaryType.symbol -> typeIds.canonicalBuiltinSymbol => unaryBuiltin
                unaryType.kind == 1 and unaryType.origin == 1 and (unaryBuiltin == 20 or unaryBuiltin == 21)
                    -> if {
                        node.opcode -> numericUnaryOperation(unaryBuiltin) => operation
                        "  %v$(labelIndex)_expression$(nodeIndex) = $operation " -> print
                        unaryBuiltin == 20 -> if { "float " -> print } else { "double " -> print }
                        unaryBuiltin -> numericUnaryZero -> print
                        ", " -> print
                        labelIndex -> writeInterpolationFloatScalarValue(node.operand0, unaryBuiltin, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                        "" -> println
                        return
                    }
            }
    }
    node -> semanticInterpolationNodeIndex(sourceModule, context) => semanticIndex
    node.kind == 3 and semanticIndex >= 0
        and semanticIndex < (context.binaryComparisonDiagnosticByNode -> len)
        and context.binaryComparisonDiagnosticByNode[semanticIndex].textEquality
        -> if {
            node.opcode == grammar.tokenIdBangEqual() -> if {
                "  %v$(labelIndex)_expression$(nodeIndex)_text_equal = call i1 @sollang_text_equal(%sollang.text " -> print
            } else {
                "  %v$(labelIndex)_expression$(nodeIndex) = call i1 @sollang_text_equal(%sollang.text " -> print
            }
            labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
            ", %sollang.text " -> print
            labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
            ")" -> println
            node.opcode == grammar.tokenIdBangEqual() -> if {
                "  %v$(labelIndex)_expression$(nodeIndex) = xor i1 %v$(labelIndex)_expression$(nodeIndex)_text_equal, true" -> println
            }
            return
        }
    node -> interpolationFloatComparisonBuiltin(sourceModule, context) => floatComparisonBuiltin
    floatComparisonBuiltin >= 0 -> if {
        node.opcode -> floatBinaryOperation => comparisonOperation
        "  %v$(labelIndex)_expression$(nodeIndex) = $(comparisonOperation) " -> print
        floatComparisonBuiltin == 20 -> if { "float " -> print } else { "double " -> print }
        labelIndex -> writeInterpolationFloatScalarValue(node.operand0, floatComparisonBuiltin, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
        ", " -> print
        labelIndex -> writeInterpolationFloatScalarValue(node.operand1, floatComparisonBuiltin, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
        "" -> println
        return
    }
    node.kind == 3 and semanticIndex >= 0 and semanticIndex < (context.binaryArithmeticDiagnosticByNode -> len)
        -> if {
            context.binaryArithmeticDiagnosticByNode[semanticIndex] => arithmetic
            arithmetic.code == 0 and arithmetic.leftTypeId >= 0 and arithmetic.rightTypeId >= 0
                and arithmetic.leftTypeId < (context.types -> len)
                -> if {
                    context.types[arithmetic.leftTypeId] => operandType
                    operandType.kind == 1 and operandType.origin == 1
                        -> if {
                            operandType.symbol -> typeIds.canonicalBuiltinSymbol => builtin
                            builtin == 20 or builtin == 21 -> if {
                                "" => floatOperation!
                                node.opcode == grammar.tokenIdPlus() -> if { "fadd" => floatOperation! }
                                node.opcode == grammar.tokenIdMinus() -> if { "fsub" => floatOperation! }
                                node.opcode == grammar.tokenIdStar() -> if { "fmul" => floatOperation! }
                                node.opcode == grammar.tokenIdSlash() -> if { "fdiv" => floatOperation! }
                                node.opcode == grammar.tokenIdPercent() -> if { "frem" => floatOperation! }
                                floatOperation! != "" -> if {
                                    "  %v$(labelIndex)_expression$(nodeIndex) = $(floatOperation!) " -> print
                                    builtin == 20 -> if { "float " -> print } else { "double " -> print }
                                    labelIndex -> writeInterpolationFloatScalarValue(node.operand0, builtin, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                                    ", " -> print
                                    labelIndex -> writeInterpolationFloatScalarValue(node.operand1, builtin, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                                    "" -> println
                                    return
                                }
                            }
                        }
                }
        }
    node.kind == 2 or node.kind == 3 -> if {
        "" => operation!
        node.kind == 2 -> if { "sub" => operation! }
        node.kind == 2 and node.opcode == -26 -> if { "xor" => operation! }
        node.opcode == grammar.tokenIdPlus() -> if { "add" => operation! }
        node.opcode == grammar.tokenIdMinus() -> if { "sub" => operation! }
        node.opcode == grammar.tokenIdStar() -> if { "mul" => operation! }
        node.opcode == grammar.tokenIdSlash() -> if { nodeIndex -> interpolationQuotientOperation(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => operation! }
        node.opcode == grammar.tokenIdPercent() -> if { nodeIndex -> interpolationRemainderOperation(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => operation! }
        node.opcode == grammar.tokenIdEqualEqual() -> if { "icmp eq" => operation! }
        node.opcode == grammar.tokenIdBangEqual() -> if { "icmp ne" => operation! }
        node.opcode == grammar.tokenIdLess() or node.opcode == grammar.tokenIdLessEqual() or node.opcode == grammar.tokenIdGreater() or node.opcode == grammar.tokenIdGreaterEqual()
            -> if { nodeIndex -> interpolationComparisonOperation(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => operation! }
        node.opcode == -24 -> if { "or" => operation! }
        node.opcode == -25 -> if { "and" => operation! }
        (node.opcode == -24 or node.opcode == -25 or (node.kind == 2 and node.opcode == -26)) => boolOperands!
        node.opcode == grammar.tokenIdEqualEqual() or node.opcode == grammar.tokenIdBangEqual()
            -> if {
                node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => operandTypeId
                operandTypeId >= 0 and context.types[operandTypeId].symbol == 23
                    -> if { true => boolOperands! }
            }
        node.operand0 -> interpolationNodeIntegerWidth(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => leftWidth
        leftWidth => rightWidth!
        node.kind == 3 -> if {
            node.operand1 -> interpolationNodeIntegerWidth(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => rightWidth!
        }
        leftWidth > rightWidth! -> if { leftWidth } else { rightWidth! } => operationWidth!
        node -> interpolationBinaryNumericWidth(sourceModule, context, state) => resolvedWidth
        resolvedWidth > 0 -> if { resolvedWidth => operationWidth! }
        operationWidth! <= 0 -> if { 32 => operationWidth! }
        not boolOperands!
            and leftWidth > 0
            and leftWidth < operationWidth!
            and nodes[node.operand0].kind != 0
            -> if {
                "  %v$(labelIndex)_expression$(nodeIndex)_left_wide = " -> print
                node.operand0 -> interpolationNodeSigned(nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    -> if { "sext" -> print } else { "zext" -> print }
                " i$(leftWidth) " -> print
                labelIndex -> writeInterpolationScalarValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                " to i$(operationWidth!)" -> println
            }
        not boolOperands!
            and node.kind == 3
            and rightWidth! > 0
            and rightWidth! < operationWidth!
            and nodes[node.operand1].kind != 0
            -> if {
                "  %v$(labelIndex)_expression$(nodeIndex)_right_wide = " -> print
                node.operand1 -> interpolationNodeSigned(nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    -> if { "sext" -> print } else { "zext" -> print }
                " i$(rightWidth!) " -> print
                labelIndex -> writeInterpolationScalarValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                " to i$(operationWidth!)" -> println
            }
        "  %v$(labelIndex)_expression$(nodeIndex) = $(operation!) " -> print
        boolOperands! -> if { "i1 " -> print } else { "i$(operationWidth!) " -> print }
        node.kind == 2 and node.opcode != -26 -> if {
            "0, " -> print
            labelIndex -> writeInterpolationScalarValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
            "" -> println
        } else {
            not boolOperands!
                and leftWidth > 0
                and leftWidth < operationWidth!
                and nodes[node.operand0].kind != 0
                -> if { "%v$(labelIndex)_expression$(nodeIndex)_left_wide" -> print } else {
                    labelIndex -> writeInterpolationScalarValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                }
            ", " -> print
            node.kind == 2 -> if {
                "true" -> println
            } else {
                not boolOperands!
                    and rightWidth! > 0
                    and rightWidth! < operationWidth!
                    and nodes[node.operand1].kind != 0
                    -> if { "%v$(labelIndex)_expression$(nodeIndex)_right_wide" -> print } else {
                        labelIndex -> writeInterpolationScalarValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    }
                "" -> println
            }
        }
    }
}

# Set membership reuses the direct Set lookup, with interpolation values as inputs.
emitInterpolationSetContains prefix: Text, labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    nodes[nodeIndex] => node
    node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => receiverTypeId
    context.types -> typeIds.materializedReadTypeId(receiverTypeId) => setTypeId
    context.types[setTypeId].first => keyTypeId
    context.types[keyTypeId] => keyType
    context.typeSizes[keyTypeId] => keySize
    context.typeAligns[keyTypeId] => keyAlign
    (keyType.kind == 1 and keyType.origin == 1 and keyType.symbol == 1) => keyIsText
    keyTypeId -> traitMethodSymbol("Hash", "hash", context, state) => hashMethod
    keyTypeId -> traitMethodSymbol("Eq", "eq", context, state) => eqMethod
    hashMethod >= 0 and eqMethod >= 0 => keyIsNominal
    keyType.symbol -> integerWidth(context, state) => integerKeyWidth
    integerKeyWidth > 0 -> if { integerKeyWidth } else {
        keySize == 1 -> if { 8 } else { keySize == 2
                -> if { 16 } else { keySize == 4
                        -> if { 32 } else { 64 } } }
    } => hashWidth
    keyType.symbol -> integerSigned(context, state) => hashSigned
    nodes[node.operand0] -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => binding
    -1 => storageRoot!
    binding >= 0 -> if { binding -> mutableStorageRoot(context, state) => storageRoot! }
    "  %$(prefix)_source = " -> print
    storageRoot! >= 0 or receiverTypeId != setTypeId
        -> if {
            "load %sollang.dict, ptr " -> print
            storageRoot! >= 0 -> if { "%slot$(storageRoot!)" -> print } else {
                labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
            }
            ", align 8" -> println
        } else {
            "freeze %sollang.dict " -> print
            labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
            "" -> println
        }
    "  %$(prefix)_storage = extractvalue %sollang.dict %$(prefix)_source, 0" -> println
    "  %$(prefix)_capacity = extractvalue %sollang.dict %$(prefix)_source, 2" -> println
    keySize -> dictionaryEntryLayout(keyAlign, 0, 1) => setEntryLayout
    prefix -> emitGrowableDictionaryPointers("%$(prefix)_storage", "%$(prefix)_capacity", setEntryLayout)
    "  store " -> print
    keyTypeId -> writeSemanticTypeId(context, state)
    " " -> print
    labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
    ", ptr %$(prefix)_query_addr, align $(keyAlign)" -> println
    "  %$(prefix)_query = load " -> print
    keyTypeId -> writeSemanticTypeId(context, state)
    ", ptr %$(prefix)_query_addr, align $(keyAlign)" -> println
    "$(prefix)_query" -> emitSetHashValue("%$(prefix)_query", keyTypeId, hashMethod, keyIsText, keyIsNominal, hashWidth, hashSigned, context, state)
    prefix -> emitSetLookup(keyTypeId, keyAlign, eqMethod, keyIsText, keyIsNominal, false, context, state)
    "$(prefix)_missing:" -> println
    "  br label %$(prefix)_not_found" -> println
    "$(prefix)_found:" -> println
    "  br label %$(prefix)_present" -> println
    "$(prefix)_present:" -> println
    "  br label %$(prefix)_complete" -> println
    "$(prefix)_not_found:" -> println
    "  br label %$(prefix)_complete" -> println
    "$(prefix)_complete:" -> println
    "  %v$(labelIndex)_expression$(nodeIndex) = phi i1 [ true, %$(prefix)_present ], [ false, %$(prefix)_not_found ]" -> println
}

emitInterpolationCallTargetLoad labelIndex: Int, nodeIndex: Int, functionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[functionIndex] => function
    function -> isNativeFunction(context, state) -> if {
        function -> isImportedLibraryFunction(context, state) => imported
        "  %v$(labelIndex)_expression$(nodeIndex)_target = load ptr, ptr " -> print
        function.sourceModule -> writeNativeFunctionPointerSlot(function.symbol, imported, context)
        ", align 8" -> println
    }
}

emitInterpolationCaptureEnvironment labelIndex: Int, nodeIndex: Int, functionIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    functionIndex -> functionCaptures(context, state) => captures
    0 => captureIndex!
    captureIndex! < (captures -> len) -> while {
        CaptureValueRequest { callerIndex: ownerIndex, callIndex: labelIndex, interpolationIndex: nodeIndex, bindingIndex: captures[captureIndex!], captureIndex: captureIndex! } -> emitCaptureTransport(context, state)
        captureIndex! + 1 => captureIndex!
    }
}

writeInterpolationCaptureEnvironment labelIndex: Int, nodeIndex: Int, functionIndex: Int, ownerIndex: Int, hasExplicitArguments: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    functionIndex -> functionCaptures(context, state) => captures
    0 => captureIndex!
    captureIndex! < (captures -> len) -> while {
        context.ir[captures[captureIndex!]] -> writeCaptureAbiType(context, state)
        " " -> print
        CaptureValueRequest { callerIndex: ownerIndex, callIndex: labelIndex, interpolationIndex: nodeIndex, bindingIndex: captures[captureIndex!], captureIndex: captureIndex! } -> writeCaptureArgumentValue(context, state)
        captureIndex! + 1 < (captures -> len) or hasExplicitArguments
            -> if { ", " -> print }
        captureIndex! + 1 => captureIndex!
    }
}

writeInterpolationCallTarget labelIndex: Int, nodeIndex: Int, functionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[functionIndex] => function
    function -> isNativeFunction(context, state) -> if {
        " %v$(labelIndex)_expression$(nodeIndex)_target" -> print
    } else {
        " @sollang_m$(function.sourceModule)_s$(function.symbol)" -> print
        context -> emitterContext.isGenericInstance(functionIndex)
            -> if { "_g$(functionIndex)" -> print }
    }
    "(" -> print
}

emitInterpolationIndexBounds labelIndex: Int, nodeIndex: Int, category: Text -> Unit uses Console {
    "  %v$(labelIndex)_expression$(nodeIndex)_in_bounds = icmp ult i64 %v$(labelIndex)_expression$(nodeIndex)_index, %v$(labelIndex)_expression$(nodeIndex)_length" -> println
    "  br i1 %v$(labelIndex)_expression$(nodeIndex)_in_bounds, label %interpolation$(labelIndex)_$(category)$(nodeIndex)_valid, label %interpolation$(labelIndex)_$(category)$(nodeIndex)_invalid" -> println
    "interpolation$(labelIndex)_$(category)$(nodeIndex)_invalid:" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "interpolation$(labelIndex)_$(category)$(nodeIndex)_valid:" -> println
}

emitInterpolationIntrinsic labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, lexicalLoads: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    nodes[nodeIndex] => node
    node.kind == 17 -> if {
        node -> emitCanonicalInterpolation(sourceModule, ownerIndex, context, state)
        return
    }
    node.kind == 16 -> if {
        labelIndex -> emitInterpolationArray(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, false, context, state)
        return
    }
    node.kind == 12 or node.kind == 14 -> if {
        labelIndex -> emitInterpolationContextualStruct(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, false, context, state)
        return
    }
    node.kind == 11 -> if {
        labelIndex -> emitInterpolationResultPropagation(nodeIndex, nodes, sourceModule, ownerIndex, context, state)
        return
    }
    lexicalLoads and node.kind == 1 -> if {
        labelIndex -> emitInterpolationLexicalLoad(nodeIndex, node, sourceModule, ownerIndex, beforeIndex, context, state)
    }
    node.kind == 1 and node.parent >= 0 -> if {
        nodeIndex -> interpolationCallArgumentUsesValue(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => callValueRead
        -1 => referenceValueTypeId!
        callValueRead -> if {
            nodeIndex -> interpolationReferenceReadTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => referenceValueTypeId!
        } else {
            nodes[node.parent].kind == 2 or nodes[node.parent].kind == 3
                -> if {
                    nodeIndex -> interpolationReferenceValueTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => referenceValueTypeId!
                }
        }
        referenceValueTypeId! >= 0 -> if {
            labelIndex -> emitInterpolationReferenceValue(nodeIndex, referenceValueTypeId!, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
        }
    }
    node.kind == 5 and node.operand0 >= 0 -> if {
        node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => memberOwnerTypeId!
        false => memberOwnerReference!
        memberOwnerTypeId! >= 0 and context.types[memberOwnerTypeId!].kind == 8
            -> if {
                context.types[memberOwnerTypeId!].first => memberOwnerTypeId!
                true => memberOwnerReference!
            }
        nodeIndex -> interpolationMemberFieldIndex(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => memberFieldIndex
        memberFieldIndex >= 0 -> if {
            context.fields[memberFieldIndex] => memberField
            # The resolved field and its aggregate share one canonical owner.
            # Callback-role operands may lack a separate lexical type record.
            memberField.ownerType => memberOwnerTypeId!
            memberOwnerReference! -> if {
                "  %v$(labelIndex)_expression$(nodeIndex)_address = getelementptr inbounds " -> print
                memberOwnerTypeId! -> writeSemanticTypeId(context, state)
                ", ptr " -> print
                labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                ", i32 0, i32 $(memberField.ordinal)" -> println
                "  %v$(labelIndex)_expression$(nodeIndex)" -> print
                context.types[memberField.fieldType].kind == 12
                    -> if { "_bounded_value" -> print }
                " = load " -> print
                context.types[memberField.fieldType].kind == 4
                    -> if {
                        "{ ptr, i64 }" -> print
                    } else {
                        memberField.fieldType -> writeSemanticTypeId(context, state)
                    }
                ", ptr %v$(labelIndex)_expression$(nodeIndex)_address, align $(context.typeAligns[memberField.fieldType])" -> println
            } else {
                "  %v$(labelIndex)_expression$(nodeIndex)" -> print
                context.types[memberField.fieldType].kind == 12
                    -> if { "_bounded_value" -> print }
                " = extractvalue " -> print
                memberOwnerTypeId! -> writeSemanticTypeId(context, state)
                " " -> print
                labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                ", $(memberField.ordinal)" -> println
            }
            context.types[memberField.fieldType].kind == 12
                -> if {
                    Arena(0) => prefixStorage!
                    "v$(labelIndex)_expression$(nodeIndex)" -> materialize(prefixStorage!) => prefix
                    prefix -> emitStoredBoundedValueHandle(memberField.fieldType, context, state)
                }
        } else {
            nodeIndex -> interpolationCallTargetFunction(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => computedMethodIndex
            computedMethodIndex >= 0 -> if {
                context.ir[computedMethodIndex] => computedMethod
                computedMethodIndex -> interpolationBoundedFunctionResultTypeId(context, state) => computedBoundedResult
                context.ir[computedMethod.operand1] => computedParameter
                computedParameter -> boundedArrayValueTypeId(context, state) => computedBoundedInput
                computedBoundedInput >= 0 and computedParameter.flags / 2 % 2 == 0
                    and not (computedMethod -> isNativeFunction(context, state)) => computedUsesBoundedInput
                computedUsesBoundedInput -> if {
                    Arena(0) => prefixStorage!
                    "v$(labelIndex)_expression$(nodeIndex)_arg0_bounded" -> materialize(prefixStorage!) => prefix
                    prefix -> emitInterpolationBoundedValue(labelIndex, node.operand0, computedBoundedInput, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                }
                labelIndex -> emitInterpolationCaptureEnvironment(nodeIndex, computedMethodIndex, ownerIndex, context, state)
                labelIndex -> emitInterpolationCallTargetLoad(nodeIndex, computedMethodIndex, context, state)
                "  %v$(labelIndex)_expression$(nodeIndex)" -> print
                computedBoundedResult >= 0 -> if { "_bounded_value" -> print }
                " = call " -> print
                computedBoundedResult >= 0 -> if {
                    computedMethod -> writeFunctionValueAbiType(context, state)
                } else { computedMethod -> writeIrType(context, state) }
                labelIndex -> writeInterpolationCallTarget(nodeIndex, computedMethodIndex, context, state)
                labelIndex -> writeInterpolationCaptureEnvironment(nodeIndex, computedMethodIndex, ownerIndex, true, context, state)
                computedUsesBoundedInput -> if {
                    computedParameter -> writeFunctionValueAbiType(context, state)
                } else { computedParameter -> writeIrType(context, state) }
                " " -> print
                computedUsesBoundedInput -> if {
                    "%v$(labelIndex)_expression$(nodeIndex)_arg0_bounded" -> print
                } else { labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state) }
                ")" -> println
                computedBoundedResult >= 0 -> if {
                    Arena(0) => prefixStorage!
                    "v$(labelIndex)_expression$(nodeIndex)" -> materialize(prefixStorage!) => prefix
                    prefix -> emitStoredBoundedValueHandle(computedBoundedResult, context, state)
                }
            }
        }
    }
    node.kind == 8 or node.kind == 10 -> if {
        nodeIndex -> interpolationCallTargetFunction(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => callTargetFunction
        callTargetFunction >= 0 -> if {
            context.ir[callTargetFunction] => callTarget
            callTargetFunction -> interpolationBoundedFunctionResultTypeId(context, state) => boundedCallResult
            callTarget.operand1 => projectionParameterIndex!
            node -> interpolationCallArgumentLimit => argumentLimit
            nodeIndex -> interpolationCallArgumentAt(0, nodes) => projectionArgumentIndex!
            0 => projectionArgumentOrdinal!
            projectionParameterIndex! >= 0 and projectionArgumentIndex! >= 0 and projectionArgumentOrdinal! < argumentLimit
                -> while {
                    context.ir[projectionParameterIndex!] => projectionParameter
                    projectionParameter -> boundedArrayValueTypeId(context, state) => boundedInput
                    boundedInput >= 0 and projectionParameter.flags / 2 % 2 == 0
                        and not (callTarget -> isNativeFunction(context, state))
                        -> if {
                            Arena(0) => prefixStorage!
                            "v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_bounded" -> materialize(prefixStorage!) => prefix
                            prefix -> emitInterpolationBoundedValue(labelIndex, projectionArgumentIndex!, boundedInput, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                        }
                    context.ir[projectionParameterIndex!].flags / 2 % 2 == 1
                        -> if {
                            nodes[projectionArgumentIndex!] -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => mutableBindingIndex
                            mutableBindingIndex >= 0 -> if {
                                "v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_mutable"
                                    -> emitMutableBorrowPlace(projectionParameterIndex!, mutableBindingIndex, ownerIndex, context, state)
                            }
                        }
                    projectionArgumentIndex! -> interpolationCallArgumentNeedsReferenceSlot(
                    projectionParameterIndex!,
                    nodes,
                    sourceModule,
                    ownerIndex,
                    beforeIndex,
                    context,
                    state) -> if {
                        context.types[context.ir[projectionParameterIndex!].typeId].first => referenceOwnerType
                        context.types[referenceOwnerType].kind == 12 -> if {
                            Arena(0) => prefixStorage!
                            "v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_ref_value" -> materialize(prefixStorage!) => prefix
                            prefix -> emitInterpolationBoundedValue(labelIndex, projectionArgumentIndex!, referenceOwnerType, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                        }
                        "  store " -> print
                        referenceOwnerType -> writeSemanticTypeId(context, state)
                        " " -> print
                        context.types[referenceOwnerType].kind == 12 -> if {
                            "%v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_ref_value" -> print
                        } else { labelIndex -> writeInterpolationValue(projectionArgumentIndex!, nodes, sourceModule, ownerIndex, beforeIndex, context, state) }
                        ", ptr %v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_ref, align $(context.typeAligns[referenceOwnerType])" -> println
                    }
                    projectionArgumentIndex! -> interpolationCallArgumentNeedsSliceProjection(
                    projectionParameterIndex!,
                    nodes,
                    sourceModule,
                    ownerIndex,
                    beforeIndex,
                    context,
                    state) -> if {
                        projectionArgumentIndex! -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => projectionTypeId!
                        projectionTypeId! >= 0 and context.types[projectionTypeId!].kind == 8 => projectionReference
                        projectionTypeId! >= 0 and context.types[projectionTypeId!].kind == 8
                            -> if { context.types[projectionTypeId!].first => projectionTypeId! }
                        projectionReference and projectionTypeId! >= 0 and context.types[projectionTypeId!].kind == 12 => boundedSliceReference
                        boundedSliceReference -> if {
                            Arena(0) => prefixStorage!
                            "v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_slice_source" -> materialize(prefixStorage!) => prefix
                            prefix -> emitInterpolationBoundedReference(labelIndex, projectionArgumentIndex!, projectionTypeId!, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                        }
                        "  %v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_slice_data = extractvalue " -> print
                        projectionTypeId! -> writeInterpolationRuntimeTypeId(context, state)
                        " " -> print
                        boundedSliceReference -> if {
                            "%v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_slice_source" -> print
                        } else { labelIndex -> writeInterpolationValue(projectionArgumentIndex!, nodes, sourceModule, ownerIndex, beforeIndex, context, state) }
                        ", 0" -> println
                        "  %v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_slice_length = extractvalue " -> print
                        projectionTypeId! -> writeInterpolationRuntimeTypeId(context, state)
                        " " -> print
                        boundedSliceReference -> if {
                            "%v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_slice_source" -> print
                        } else { labelIndex -> writeInterpolationValue(projectionArgumentIndex!, nodes, sourceModule, ownerIndex, beforeIndex, context, state) }
                        ", 1" -> println
                        "  %v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_slice0 = insertvalue { ptr, i64 } poison, ptr %v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_slice_data, 0" -> println
                        "  %v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_slice = insertvalue { ptr, i64 } %v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_slice0, i64 %v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_slice_length, 1" -> println
                    }
                    projectionArgumentOrdinal! == 0 -> if { callTarget.nextOperand => projectionParameterIndex! } else { context.ir[projectionParameterIndex!].nextOperand => projectionParameterIndex! }
                    projectionArgumentOrdinal! + 1 => projectionArgumentOrdinal!
                    nodeIndex -> interpolationCallArgumentAt(projectionArgumentOrdinal!, nodes) => projectionArgumentIndex!
                }
            labelIndex -> emitInterpolationCaptureEnvironment(nodeIndex, callTargetFunction, ownerIndex, context, state)
            labelIndex -> emitInterpolationCallTargetLoad(nodeIndex, callTargetFunction, context, state)
            "  %v$(labelIndex)_expression$(nodeIndex)" -> print
            boundedCallResult >= 0 -> if { "_bounded_value" -> print }
            " = call " -> print
            boundedCallResult >= 0 -> if {
                callTarget -> writeFunctionValueAbiType(context, state)
            } else { callTarget -> writeIrType(context, state) }
            labelIndex -> writeInterpolationCallTarget(nodeIndex, callTargetFunction, context, state)
            callTarget.operand1 >= 0 and argumentLimit > 0 and (nodeIndex -> interpolationCallArgumentAt(0, nodes)) >= 0 => hasExplicitArguments
            labelIndex -> writeInterpolationCaptureEnvironment(nodeIndex, callTargetFunction, ownerIndex, hasExplicitArguments, context, state)
            callTarget.operand1 => callParameterIndex!
            0 => callArgumentOrdinal!
            nodeIndex -> interpolationCallArgumentAt(0, nodes) => callArgumentIndex!
            callParameterIndex! >= 0 and callArgumentIndex! >= 0 and callArgumentOrdinal! < argumentLimit
                -> while {
                    callArgumentOrdinal! > 0 -> if { ", " -> print }
                    context.ir[callParameterIndex!] => callParameter
                    callParameter.flags / 2 % 2 == 1 -> if {
                        callParameter -> mutableBorrowUsesStructPointer(context)
                            -> if {
                                "ptr " -> print
                            } else { "%sollang.mutable_container " -> print }
                        "%v$(labelIndex)_expression$(nodeIndex)_arg$(callArgumentOrdinal!)_mutable" -> print
                    } else {
                        callParameter -> boundedArrayValueTypeId(context, state) => boundedArgumentType
                        boundedArgumentType >= 0 and not (callTarget -> isNativeFunction(context, state)) => boundedArgument
                        boundedArgument -> if {
                            callParameter -> writeFunctionValueAbiType(context, state)
                        } else { callParameter -> writeIrType(context, state) }
                        " " -> print
                        nodes[callArgumentIndex!] => callArgument
                        boundedArgument -> if {
                            "%v$(labelIndex)_expression$(nodeIndex)_arg$(callArgumentOrdinal!)_bounded" -> print
                        } else { callArgumentIndex! -> interpolationCallArgumentNeedsReferenceSlot(
                            callParameterIndex!,
                            nodes,
                            sourceModule,
                            ownerIndex,
                            beforeIndex,
                            context,
                            state) -> if {
                                "%v$(labelIndex)_expression$(nodeIndex)_arg$(callArgumentOrdinal!)_ref" -> print
                            } else { callArgumentIndex! -> interpolationCallArgumentNeedsSliceProjection(
                                callParameterIndex!,
                                nodes,
                                sourceModule,
                                ownerIndex,
                                beforeIndex,
                                context,
                                state) -> if {
                                    "%v$(labelIndex)_expression$(nodeIndex)_arg$(callArgumentOrdinal!)_slice" -> print
                                } else {
                                    context.types[callParameter.typeId] => parameterType
                                    callArgumentIndex! -> interpolationReferenceReadTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => argumentReadTypeId
                                    parameterType.kind != 8 and argumentReadTypeId >= 0 and argumentReadTypeId == callParameter.typeId
                                        -> if {
                                            "%v$(labelIndex)_expression$(callArgumentIndex!)_reference_value" -> print
                                        } else { parameterType.kind == 1 and parameterType.origin == 1
                                                and ((parameterType.symbol -> typeIds.canonicalBuiltinSymbol) == 20
                                                or (parameterType.symbol -> typeIds.canonicalBuiltinSymbol) == 21)
                                                -> if {
                                                    labelIndex -> writeInterpolationFloatScalarValue(callArgumentIndex!, parameterType.symbol -> typeIds.canonicalBuiltinSymbol, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                                                } else { callArgument.kind == 0 or callArgument.kind == 4
                                                        -> if {
                                                            callArgument.kind == 4 -> if {
                                                                (context.sources[sourceModule] -> byte(callArgument.payloadStart)) == 116
                                                                    -> if { "1" -> print } else { "0" -> print }
                                                            } else { callArgument -> writeInterpolationIntegerLiteral(sourceModule, context) }
                                                        } else {
                                                            labelIndex -> writeInterpolationValue(callArgumentIndex!, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                                                        }
                                                }
                                        }
                                }
                            }
                        }
                    }
                    callArgumentOrdinal! == 0 -> if { callTarget.nextOperand => callParameterIndex! } else { callParameter.nextOperand => callParameterIndex! }
                    callArgumentOrdinal! + 1 => callArgumentOrdinal!
                    nodeIndex -> interpolationCallArgumentAt(callArgumentOrdinal!, nodes) => callArgumentIndex!
                }
            ")" -> println
            boundedCallResult >= 0 -> if {
                Arena(0) => prefixStorage!
                "v$(labelIndex)_expression$(nodeIndex)" -> materialize(prefixStorage!) => prefix
                prefix -> emitStoredBoundedValueHandle(boundedCallResult, context, state)
            }
            labelIndex -> emitInterpolationCallTemporaryDrops(nodeIndex, callTargetFunction, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
        }
    }
    node.kind == 9 and node.operand0 >= 0 -> if {
        node.operand0 -> interpolationNodeIntegerWidth(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => conversionSourceWidth
        node.typeSymbol -> integerWidth(context, state) => conversionTargetWidth!
        node.typeSymbol == 12 or node.typeSymbol == 13
            -> if { context.pointerBitWidth => conversionTargetWidth! }
        node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => conversionSourceTypeId
        false => conversionSourceIsFloat!
        0 => conversionSourceFloatWidth!
        conversionSourceTypeId >= 0 and conversionSourceTypeId < (context.types -> len)
            -> if {
                context.types[conversionSourceTypeId] => conversionSourceType
                conversionSourceType.kind == 1 and conversionSourceType.origin == 1
                    and conversionSourceType.symbol >= 19 and conversionSourceType.symbol <= 22
                    -> if {
                        true => conversionSourceIsFloat!
                        conversionSourceType.symbol == 19 or conversionSourceType.symbol == 20
                            -> if { 32 => conversionSourceFloatWidth! } else { 64 => conversionSourceFloatWidth! }
                    }
            }
        0 => conversionTargetFloatWidth!
        node.typeSymbol == 19 or node.typeSymbol == 20
            -> if { 32 => conversionTargetFloatWidth! }
        node.typeSymbol == 21 or node.typeSymbol == 22
            -> if { 64 => conversionTargetFloatWidth! }
        conversionTargetFloatWidth! > 0 and (node.operand0 -> interpolationNumericLiteralSyntax(nodes)) => conversionLiteralToFloat
        conversionSourceIsFloat! and conversionTargetFloatWidth! > 0
            and conversionSourceFloatWidth! != conversionTargetFloatWidth!
            and not conversionLiteralToFloat
            -> if {
                "  %v$(labelIndex)_expression$(nodeIndex) = " -> print
                conversionSourceFloatWidth! > conversionTargetFloatWidth!
                    -> if { "fptrunc " -> print }
                conversionSourceFloatWidth! < conversionTargetFloatWidth!
                    -> if { "fpext " -> print }
                conversionSourceFloatWidth! == 32 -> if { "float " -> print } else { "double " -> print }
                labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                conversionTargetFloatWidth! == 32 -> if { " to float" -> print } else { " to double" -> print }
                "" -> println
            }
        not conversionSourceIsFloat! and conversionSourceWidth > 0 and conversionTargetFloatWidth! > 0
            and not conversionLiteralToFloat
            -> if {
                "  %v$(labelIndex)_expression$(nodeIndex) = " -> print
                node.operand0 -> interpolationNodeSigned(nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    -> if { "sitofp" -> print } else { "uitofp" -> print }
                " i$(conversionSourceWidth) " -> print
                labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                conversionTargetFloatWidth! == 32 -> if { " to float" -> println } else { " to double" -> println }
            }
        conversionSourceIsFloat! and conversionTargetWidth! > 0
            -> if {
                "  %v$(labelIndex)_expression$(nodeIndex) = " -> print
                node.typeSymbol -> integerSigned(context, state)
                    -> if { "fptosi " -> print } else { "fptoui " -> print }
                conversionSourceFloatWidth! == 32 -> if { "float " -> print } else { "double " -> print }
                labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                " to i$(conversionTargetWidth!)" -> println
            }
        not conversionSourceIsFloat! and conversionSourceWidth > 0 and conversionTargetWidth! > 0
            -> if {
                not (node.operand0 -> interpolationIntegerLiteralSyntax(nodes, sourceModule, context))
                    -> if {
                        labelIndex -> emitInterpolationIntegerConversionChecks(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                        node.typeSymbol == 23 or conversionSourceWidth != conversionTargetWidth!
                            -> if {
                                "  %v$(labelIndex)_expression$(nodeIndex) = " -> print
                                node.typeSymbol == 23 -> if {
                                    "icmp ne i$(conversionSourceWidth) " -> print
                                    labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                                    ", 0" -> println
                                } else {
                                    conversionSourceWidth > conversionTargetWidth!
                                        -> if { "trunc i$(conversionSourceWidth) " -> print }
                                    conversionSourceWidth < conversionTargetWidth!
                                        -> if {
                                            node.operand0 -> interpolationNodeSigned(nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                                                -> if { "sext" -> print } else { "zext" -> print }
                                            " i$(conversionSourceWidth) " -> print
                                        }
                                    labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                                    " to i$(conversionTargetWidth!)" -> println
                                }
                            }
                    }
            }
    }
    node.kind == 6 and node.operand0 >= 0 -> if {
        nodes[node.operand0] => base
        node.opcode == -101 -> if {
            nodeIndex -> interpolationNodeIntegerWidth(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => lengthResultWidth
            false => lengthFromI64!
            node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => bitSetLengthTypeId!
            bitSetLengthTypeId! >= 0 and context.types[bitSetLengthTypeId!].kind == 8
                -> if { context.types[bitSetLengthTypeId!].first => bitSetLengthTypeId! }
            bitSetLengthTypeId! >= 0 and (context.types[bitSetLengthTypeId!].kind == 14 or context.types[bitSetLengthTypeId!].kind == 4 or context.types[bitSetLengthTypeId!].kind == 12)
                -> if {
                    context.types[bitSetLengthTypeId!].kind == 12
                        -> if {
                            node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => lengthSourceType
                            context.types[lengthSourceType].kind == 8 => boundedReference
                            boundedReference -> if {
                                Arena(0) => prefixStorage!
                                "v$(labelIndex)_expression$(nodeIndex)_length_source" -> materialize(prefixStorage!) => prefix
                                prefix -> emitInterpolationBoundedReference(labelIndex, node.operand0, bitSetLengthTypeId!, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                            }
                            "  %v$(labelIndex)_expression$(nodeIndex)" -> print
                            lengthResultWidth == 32 -> if { "_raw" -> print }
                            " = extractvalue %sollang.array.i32 " -> print
                            boundedReference -> if {
                                "%v$(labelIndex)_expression$(nodeIndex)_length_source" -> print
                            } else { labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state) }
                            ", 1" -> println
                            true => lengthFromI64!
                        } else { context.types[bitSetLengthTypeId!].kind == 4 -> if {
                                "  %v$(labelIndex)_expression$(nodeIndex)" -> print
                                lengthResultWidth == 32 -> if { "_raw" -> print }
                                " = add i64 0, $(context.types[bitSetLengthTypeId!].length)" -> println
                                true => lengthFromI64!
                            } else {
                                "  %v$(labelIndex)_expression$(nodeIndex) = add i32 0, $(context.types[bitSetLengthTypeId!].length)" -> println
                        } }
                } else {
                    base -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => baseBinding
                    baseBinding >= 0 -> if {
                        "  %v$(labelIndex)_expression$(nodeIndex)" -> print
                        lengthResultWidth == 32 -> if { "_raw" -> print }
                        " = extractvalue " -> print
                        context.ir[baseBinding] -> writeIrType(context, state)
                        " " -> print
                        labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                        context.ir[baseBinding] -> isDictionaryType
                            -> if {
                                context.ir[baseBinding].typeId >= 0 and context.types[context.ir[baseBinding].typeId].kind == 13
                                    -> if { ", 0" -> println } else { ", 1" -> println }
                            } else { ", 1" -> println }
                        true => lengthFromI64!
                    } else {
                        node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => projectedBaseTypeId!
                        projectedBaseTypeId! >= 0 and context.types[projectedBaseTypeId!].kind == 8
                            -> if { context.types[projectedBaseTypeId!].first => projectedBaseTypeId! }
                        projectedBaseTypeId! >= 0 -> if {
                            context.types[projectedBaseTypeId!] => projectedBaseType
                            projectedBaseType.kind == 4 -> if {
                                "  %v$(labelIndex)_expression$(nodeIndex)" -> print
                                lengthResultWidth == 32 -> if { "_raw" -> print }
                                " = add i64 0, $(projectedBaseType.length)" -> println
                                true => lengthFromI64!
                            }
                            projectedBaseType.kind == 2
                                or projectedBaseType.kind == 3
                                or projectedBaseType.kind == 5
                                or projectedBaseType.kind == 13
                                or projectedBaseType.kind == 12
                                or (projectedBaseType.kind == 1
                                and projectedBaseType.origin == 1
                                and (projectedBaseType.symbol == 1
                                or projectedBaseType.symbol == 15))
                                or (projectedBaseType.kind == 7
                                and projectedBaseType.origin == 4
                                and (projectedBaseType.symbol == 6
                                or projectedBaseType.symbol == 7)) -> if {
                                    "  %v$(labelIndex)_expression$(nodeIndex)" -> print
                                    lengthResultWidth == 32 -> if { "_raw" -> print }
                                    " = extractvalue " -> print
                                    projectedBaseType.kind == 2 -> if {
                                        "{ ptr, i64 }" -> print
                                    } else {
                                        projectedBaseTypeId! -> writeSemanticTypeId(context, state)
                                    }
                                    " " -> print
                                    labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                                    projectedBaseType.kind == 13 -> if { ", 0" -> println } else { ", 1" -> println }
                                    true => lengthFromI64!
                                }
                        }
                    }
                }
            lengthFromI64! and lengthResultWidth == 32 -> if {
                "  %v$(labelIndex)_expression$(nodeIndex) = trunc i64 %v$(labelIndex)_expression$(nodeIndex)_raw to i32" -> println
            }
        }
        node.opcode == -236 -> if {
            nodeIndex -> interpolationNodeIntegerWidth(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => capacityResultWidth
            node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => capacityType!
            false => capacityReference!
            capacityType! >= 0 and context.types[capacityType!].kind == 8
                -> if {
                    context.types[capacityType!].first => capacityType!
                    true => capacityReference!
                }
            capacityType! -> interpolationCapacityField(context) => capacityField
            capacityField >= 0 -> if {
                context.types[capacityType!].kind == 13 or context.types[capacityType!].kind == 12
                    -> if {
                        "  %v$(labelIndex)_expression$(nodeIndex)" -> print
                        capacityResultWidth == 32 -> if { "_raw" -> print }
                        " = add i64 0, $(context.types[capacityType!].length)" -> println
                    } else {
                        capacityReference! -> if {
                            "  %v$(labelIndex)_expression$(nodeIndex)_capacity_source = load " -> print
                            capacityType! -> writeSemanticTypeId(context, state)
                            ", ptr " -> print
                            labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                            ", align 8" -> println
                        }
                        "  %v$(labelIndex)_expression$(nodeIndex)" -> print
                        capacityResultWidth == 32 -> if { "_raw" -> print }
                        " = extractvalue " -> print
                        capacityType! -> writeSemanticTypeId(context, state)
                        " " -> print
                        capacityReference! -> if {
                            "%v$(labelIndex)_expression$(nodeIndex)_capacity_source" -> print
                        } else {
                            labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                        }
                        ", $capacityField" -> println
                    }
                capacityResultWidth == 32 -> if {
                    "  %v$(labelIndex)_expression$(nodeIndex) = trunc i64 %v$(labelIndex)_expression$(nodeIndex)_raw to i32" -> println
                }
            }
        }
        node.opcode == -244 -> if {
            node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => bitSetTypeId!
            false => bitSetReference!
            bitSetTypeId! >= 0 and context.types[bitSetTypeId!].kind == 8
                -> if {
                    context.types[bitSetTypeId!].first => bitSetTypeId!
                    true => bitSetReference!
                }
            bitSetTypeId! >= 0 and context.types[bitSetTypeId!].kind == 14
                -> if {
                    context.types[bitSetTypeId!].length => bitCount
                    (bitCount + 63) / 64 => wordCount
                    base -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => bitSetBinding
                    -1 => bitSetStorageRoot!
                    bitSetBinding >= 0 -> if {
                        bitSetBinding -> mutableStorageRoot(context, state) => bitSetStorageRoot!
                    }
                    bitSetStorageRoot! >= 0 -> if {
                        "  %v$(labelIndex)_expression$(nodeIndex)_source = load %sollang.bitset.t$(bitSetTypeId!), ptr %slot$(bitSetStorageRoot!), align 8" -> println
                    } else {
                        bitSetReference! -> if {
                            "  %v$(labelIndex)_expression$(nodeIndex)_source = load %sollang.bitset.t$(bitSetTypeId!), ptr " -> print
                            labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                            ", align 8" -> println
                        }
                    }
                    0 => countWord!
                    countWord! < wordCount -> while {
                        "  %v$(labelIndex)_expression$(nodeIndex)_word$(countWord!) = extractvalue %sollang.bitset.t$(bitSetTypeId!) " -> print
                        bitSetStorageRoot! >= 0 or bitSetReference! -> if {
                            "%v$(labelIndex)_expression$(nodeIndex)_source" -> print
                        } else {
                            labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                        }
                        ", 0, $(countWord!)" -> println
                        countWord! == wordCount - 1 and bitCount % 64 != 0
                            -> if {
                                bitCount -> bitSetCountTailMask => tailMask
                                "  %v$(labelIndex)_expression$(nodeIndex)_tail$(countWord!) = and i64 %v$(labelIndex)_expression$(nodeIndex)_word$(countWord!), $tailMask" -> println
                            }
                        "  %v$(labelIndex)_expression$(nodeIndex)_pop$(countWord!) = call i64 @llvm.ctpop.i64(i64 " -> print
                        countWord! == wordCount - 1 and bitCount % 64 != 0
                            -> if {
                                "%v$(labelIndex)_expression$(nodeIndex)_tail$(countWord!)" -> print
                            } else {
                                "%v$(labelIndex)_expression$(nodeIndex)_word$(countWord!)" -> print
                            }
                        ")" -> println
                        countWord! > 0 -> if {
                            "  %v$(labelIndex)_expression$(nodeIndex)_sum$(countWord!) = add i64 " -> print
                            countWord! == 1 -> if {
                                "%v$(labelIndex)_expression$(nodeIndex)_pop0" -> print
                            } else {
                                "%v$(labelIndex)_expression$(nodeIndex)_sum$(countWord! - 1)" -> print
                            }
                            ", %v$(labelIndex)_expression$(nodeIndex)_pop$(countWord!)" -> println
                        }
                        countWord! + 1 => countWord!
                    }
                    "  %v$(labelIndex)_expression$(nodeIndex) = trunc i64 " -> print
                    wordCount == 1 -> if {
                        "%v$(labelIndex)_expression$(nodeIndex)_pop0" -> print
                    } else {
                        "%v$(labelIndex)_expression$(nodeIndex)_sum$(wordCount - 1)" -> print
                    }
                    " to i32" -> println
                }
        }
        node.opcode == -243 and node.operand1 >= 0 -> if {
            node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => containsTypeId!
            false => containsReference!
            containsTypeId! >= 0 and context.types[containsTypeId!].kind == 8
                -> if {
                    context.types[containsTypeId!].first => containsTypeId!
                    true => containsReference!
                }
            containsTypeId! >= 0 and context.types[containsTypeId!].kind == 14
                -> if {
                    context.types[containsTypeId!].length => containsBitCount
                    (containsBitCount + 63) / 64 => containsWordCount
                    "  %v$(labelIndex)_expression$(nodeIndex)_valid = icmp ult i32 " -> print
                    labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    ", $containsBitCount" -> println
                    "  br i1 %v$(labelIndex)_expression$(nodeIndex)_valid, label %bitset$(labelIndex)_$(nodeIndex)_index_ok, label %bitset$(labelIndex)_$(nodeIndex)_index_fail" -> println
                    "bitset$(labelIndex)_$(nodeIndex)_index_fail:" -> println
                    "  call void @llvm.trap()" -> println
                    "  unreachable" -> println
                    "bitset$(labelIndex)_$(nodeIndex)_index_ok:" -> println
                    "  %v$(labelIndex)_expression$(nodeIndex)_index = zext i32 " -> print
                    labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    " to i64" -> println
                    "  %v$(labelIndex)_expression$(nodeIndex)_word_index = lshr i64 %v$(labelIndex)_expression$(nodeIndex)_index, 6" -> println
                    "  %v$(labelIndex)_expression$(nodeIndex)_bit_index = and i64 %v$(labelIndex)_expression$(nodeIndex)_index, 63" -> println
                    "  %v$(labelIndex)_expression$(nodeIndex)_mask = shl i64 1, %v$(labelIndex)_expression$(nodeIndex)_bit_index" -> println
                    base -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => containsBinding
                    -1 => containsRoot!
                    containsBinding >= 0 -> if { containsBinding -> mutableStorageRoot(context, state) => containsRoot! }
                    containsRoot! >= 0 -> if {
                        "  %v$(labelIndex)_expression$(nodeIndex)_source = load %sollang.bitset.t$(containsTypeId!), ptr %slot$(containsRoot!), align 8" -> println
                    } else {
                        containsReference! -> if {
                            "  %v$(labelIndex)_expression$(nodeIndex)_source = load %sollang.bitset.t$(containsTypeId!), ptr " -> print
                            labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                            ", align 8" -> println
                        }
                    }
                    0 => containsWord!
                    containsWord! < containsWordCount -> while {
                        "  %v$(labelIndex)_expression$(nodeIndex)_word$(containsWord!) = extractvalue %sollang.bitset.t$(containsTypeId!) " -> print
                        containsRoot! >= 0 or containsReference! -> if {
                            "%v$(labelIndex)_expression$(nodeIndex)_source" -> print
                        } else {
                            labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                        }
                        ", 0, $(containsWord!)" -> println
                        containsWord! + 1 => containsWord!
                    }
                    1 => containsSelectWord!
                    containsSelectWord! < containsWordCount -> while {
                        "  %v$(labelIndex)_expression$(nodeIndex)_is_word$(containsSelectWord!) = icmp eq i64 %v$(labelIndex)_expression$(nodeIndex)_word_index, $(containsSelectWord!)" -> println
                        "  %v$(labelIndex)_expression$(nodeIndex)_selected$(containsSelectWord!) = select i1 %v$(labelIndex)_expression$(nodeIndex)_is_word$(containsSelectWord!), i64 %v$(labelIndex)_expression$(nodeIndex)_word$(containsSelectWord!), i64 " -> print
                        containsSelectWord! == 1 -> if {
                            "%v$(labelIndex)_expression$(nodeIndex)_word0" -> print
                        } else {
                            "%v$(labelIndex)_expression$(nodeIndex)_selected$(containsSelectWord! - 1)" -> print
                        }
                        "" -> println
                        containsSelectWord! + 1 => containsSelectWord!
                    }
                    "  %v$(labelIndex)_expression$(nodeIndex)_masked = and i64 " -> print
                    containsWordCount == 1 -> if {
                        "%v$(labelIndex)_expression$(nodeIndex)_word0" -> print
                    } else {
                        "%v$(labelIndex)_expression$(nodeIndex)_selected$(containsWordCount - 1)" -> print
                    }
                    ", %v$(labelIndex)_expression$(nodeIndex)_mask" -> println
                    "  %v$(labelIndex)_expression$(nodeIndex) = icmp ne i64 %v$(labelIndex)_expression$(nodeIndex)_masked, 0" -> println
                }
            containsTypeId! >= 0 and context.types[containsTypeId!].kind == 7
                and context.types[containsTypeId!].origin == 4 and context.types[containsTypeId!].symbol == 5
                -> if { "iset$(labelIndex)_$(nodeIndex)" -> emitInterpolationSetContains(labelIndex, nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, context, state) }

        }
        node.opcode == -202 and node.operand1 >= 0 -> if {
            node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => byteTypeId!
            false => byteReference!
            byteTypeId! >= 0 and context.types[byteTypeId!].kind == 8
                -> if {
                    context.types[byteTypeId!].first => byteTypeId!
                    true => byteReference!
                }
            byteTypeId! >= 0 -> if {
                byteReference! -> if {
                    "  %v$(labelIndex)_expression$(nodeIndex)_source = load " -> print
                    byteTypeId! -> writeSemanticTypeId(context, state)
                    ", ptr " -> print
                    labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    ", align 8" -> println
                }
                "  %v$(labelIndex)_expression$(nodeIndex)_base = extractvalue " -> print
                byteTypeId! -> writeSemanticTypeId(context, state)
                " " -> print
                byteReference! -> if { "%v$(labelIndex)_expression$(nodeIndex)_source" -> print } else {
                    labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                }
                ", 0" -> println
                "  %v$(labelIndex)_expression$(nodeIndex)_length = extractvalue " -> print
                byteTypeId! -> writeSemanticTypeId(context, state)
                " " -> print
                byteReference! -> if { "%v$(labelIndex)_expression$(nodeIndex)_source" -> print } else {
                    labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                }
                ", 1" -> println
                node.operand1 -> interpolationNodeIntegerWidth(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => byteIndexWidth
                "  %v$(labelIndex)_expression$(nodeIndex)_index = " -> print
                byteIndexWidth < 64 -> if { "zext i$(byteIndexWidth) " -> print } else { "add i64 0, " -> print }
                labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                byteIndexWidth < 64 -> if { " to i64" -> print }
                "" -> println
                labelIndex -> emitInterpolationIndexBounds(nodeIndex, "byte")
                "  %v$(labelIndex)_expression$(nodeIndex)_address = getelementptr i8, ptr %v$(labelIndex)_expression$(nodeIndex)_base, i64 %v$(labelIndex)_expression$(nodeIndex)_index" -> println
                "  %v$(labelIndex)_expression$(nodeIndex) = load i8, ptr %v$(labelIndex)_expression$(nodeIndex)_address, align 1" -> println
            }
        }
        node.opcode == -203 and node.operand1 >= 0 and node.operand2 >= 0
            -> if {
                base -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => sliceBaseBinding
                sliceBaseBinding >= 0 -> if {
                    labelIndex -> emitInterpolationTextSlice(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                }
            }
    }
    node.kind == 7 and node.operand0 >= 0 and node.operand1 >= 0
        -> if {
            node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => indexedContainerTypeId!
            false => indexedReference!
            indexedContainerTypeId! >= 0 and context.types[indexedContainerTypeId!].kind == 8
                -> if {
                    context.types[indexedContainerTypeId!].first => indexedContainerTypeId!
                    true => indexedReference!
                }
            nodeIndex -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => indexedElementTypeId
            indexedContainerTypeId! >= 0 and indexedElementTypeId >= 0
                and context.types[indexedContainerTypeId!].kind == 1
                and context.types[indexedContainerTypeId!].origin == 1
                and context.types[indexedContainerTypeId!].symbol == 16
                -> if {
                    node.operand1 -> interpolationNodeIntegerWidth(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => argumentIndexWidth
                    argumentIndexWidth > 0 and argumentIndexWidth < 64
                        -> if {
                            "  %v$(labelIndex)_expression$(nodeIndex)_index = zext i$(argumentIndexWidth) " -> print
                            labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                            " to i64" -> println
                        }
                    "  %v$(labelIndex)_expression$(nodeIndex) = call %sollang.text @sollang_argument(i64 " -> print
                    argumentIndexWidth > 0 and argumentIndexWidth < 64
                        -> if { "%v$(labelIndex)_expression$(nodeIndex)_index" -> print } else {
                            labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                        }
                    ")" -> println
                }
            indexedContainerTypeId! >= 0 and indexedElementTypeId >= 0
                and context.types[indexedContainerTypeId!].kind == 1
                and context.types[indexedContainerTypeId!].origin == 1
                and (context.types[indexedContainerTypeId!].symbol == 17 or context.types[indexedContainerTypeId!].symbol == 18)
                -> if {
                    indexedReference! -> if {
                        "  %v$(labelIndex)_expression$(nodeIndex)_source = load %sollang.mapped_bytes, ptr " -> print
                        labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                        ", align 8" -> println
                    }
                    node.operand1 -> interpolationNodeIntegerWidth(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => mappedIndexWidth!
                    mappedIndexWidth! <= 0 -> if { 32 => mappedIndexWidth! }
                    "  %v$(labelIndex)_expression$(nodeIndex)_index = " -> print
                    mappedIndexWidth! < 64 -> if { "zext i$(mappedIndexWidth!) " -> print } else { "add i64 0, " -> print }
                    labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    mappedIndexWidth! < 64 -> if { " to i64" -> print }
                    "" -> println
                    "  %v$(labelIndex)_expression$(nodeIndex)_length = extractvalue %sollang.mapped_bytes " -> print
                    indexedReference! -> if { "%v$(labelIndex)_expression$(nodeIndex)_source" -> print } else {
                        labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    }
                    ", 1" -> println
                    "  %v$(labelIndex)_expression$(nodeIndex)_in_bounds = icmp ult i64 %v$(labelIndex)_expression$(nodeIndex)_index, %v$(labelIndex)_expression$(nodeIndex)_length" -> println
                    "  br i1 %v$(labelIndex)_expression$(nodeIndex)_in_bounds, label %interpolation$(labelIndex)_mapped$(nodeIndex)_valid, label %interpolation$(labelIndex)_mapped$(nodeIndex)_invalid" -> println
                    "interpolation$(labelIndex)_mapped$(nodeIndex)_invalid:" -> println
                    "  call void @llvm.trap()" -> println
                    "  unreachable" -> println
                    "interpolation$(labelIndex)_mapped$(nodeIndex)_valid:" -> println
                    "  %v$(labelIndex)_expression$(nodeIndex)_data = extractvalue %sollang.mapped_bytes " -> print
                    indexedReference! -> if { "%v$(labelIndex)_expression$(nodeIndex)_source" -> print } else {
                        labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    }
                    ", 0" -> println
                    "  %v$(labelIndex)_expression$(nodeIndex)_ptr = getelementptr i8, ptr %v$(labelIndex)_expression$(nodeIndex)_data, i64 %v$(labelIndex)_expression$(nodeIndex)_index" -> println
                    "  %v$(labelIndex)_expression$(nodeIndex) = load i8, ptr %v$(labelIndex)_expression$(nodeIndex)_ptr, align 1" -> println
                }
            indexedContainerTypeId! >= 0
                and (context.types[indexedContainerTypeId!].kind == 5 or context.types[indexedContainerTypeId!].kind == 13)
                -> if {
                    labelIndex -> emitInterpolationDictionaryIndex(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, indexedContainerTypeId!, indexedReference!, context, state)
                }
            indexedContainerTypeId! >= 0 and indexedElementTypeId >= 0
                and (context.types[indexedContainerTypeId!].kind == 3
                or context.types[indexedContainerTypeId!].kind == 4
                or context.types[indexedContainerTypeId!].kind == 12
                or (context.types[indexedContainerTypeId!].kind == 1 and context.types[indexedContainerTypeId!].origin == 1 and context.types[indexedContainerTypeId!].symbol == 1))
                -> if {
                    context.types[indexedContainerTypeId!] => indexedContainerType
                    indexedReference! and indexedContainerType.kind == 12
                        -> if {
                            Arena(0) => prefixStorage!
                            "v$(labelIndex)_expression$(nodeIndex)_source" -> materialize(prefixStorage!) => prefix
                            prefix -> emitInterpolationBoundedReference(labelIndex, node.operand0, indexedContainerTypeId!, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                        }
                    indexedReference! and indexedContainerType.kind != 4 and indexedContainerType.kind != 12
                        -> if {
                            "  %v$(labelIndex)_expression$(nodeIndex)_source = load " -> print
                            indexedContainerTypeId! -> writeSemanticTypeId(context, state)
                            ", ptr " -> print
                            labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                            ", align 8" -> println
                        }
                    # Fixed fields and ordinary fixed-array values share the
                    # pointer/length carrier used by the runtime ABI.
                    indexedContainerType.kind == 4 and indexedReference!
                        -> if {
                            "  %v$(labelIndex)_expression$(nodeIndex)_carrier = load { ptr, i64 }, ptr " -> print
                            labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                            ", align 8" -> println
                        }
                    "  %v$(labelIndex)_expression$(nodeIndex)_data = extractvalue " -> print
                    indexedContainerType.kind == 4 -> if { "{ ptr, i64 }" -> print } else { indexedContainerTypeId! -> writeInterpolationRuntimeTypeId(context, state) }
                    " " -> print
                    indexedReference! -> if {
                        indexedContainerType.kind == 4 -> if { "%v$(labelIndex)_expression$(nodeIndex)_carrier" -> print } else { "%v$(labelIndex)_expression$(nodeIndex)_source" -> print }
                    } else {
                        labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    }
                    ", 0" -> println
                    node.operand1 -> interpolationNodeIntegerWidth(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => indexedSubscriptWidth!
                    indexedSubscriptWidth! <= 0 -> if { 32 => indexedSubscriptWidth! }
                    "  %v$(labelIndex)_expression$(nodeIndex)_index = " -> print
                    indexedSubscriptWidth! < 64 -> if {
                        node.operand1 -> interpolationNodeSigned(nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                            -> if { "sext" -> print } else { "zext" -> print }
                        " i$(indexedSubscriptWidth!) " -> print
                    } else { "add i64 0, " -> print }
                    labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    indexedSubscriptWidth! < 64 -> if { " to i64" -> print }
                    "" -> println
                    "  %v$(labelIndex)_expression$(nodeIndex)_length = extractvalue " -> print
                    indexedContainerType.kind == 4 -> if { "{ ptr, i64 }" -> print } else { indexedContainerTypeId! -> writeInterpolationRuntimeTypeId(context, state) }
                    " " -> print
                    indexedReference! -> if {
                        indexedContainerType.kind == 4 -> if { "%v$(labelIndex)_expression$(nodeIndex)_carrier" -> print } else { "%v$(labelIndex)_expression$(nodeIndex)_source" -> print }
                    } else {
                        labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    }
                    ", 1" -> println
                    labelIndex -> emitInterpolationIndexBounds(nodeIndex, "array")
                    "  %v$(labelIndex)_expression$(nodeIndex)_ptr = getelementptr " -> print
                    indexedElementTypeId -> writeSemanticTypeId(context, state)
                    ", ptr %v$(labelIndex)_expression$(nodeIndex)_data, i64 %v$(labelIndex)_expression$(nodeIndex)_index" -> println
                    "  %v$(labelIndex)_expression$(nodeIndex)" -> print
                    context.types[indexedElementTypeId].kind == 12
                        -> if { "_bounded_value" -> print }
                    " = load " -> print
                    indexedElementTypeId -> writeSemanticTypeId(context, state)
                    ", ptr %v$(labelIndex)_expression$(nodeIndex)_ptr, align " -> print
                    context.typeAligns[indexedElementTypeId] -> writeDecimalLine
                    context.types[indexedElementTypeId].kind == 12
                        -> if {
                            Arena(0) => prefixStorage!
                            "v$(labelIndex)_expression$(nodeIndex)" -> materialize(prefixStorage!) => prefix
                            prefix -> emitStoredBoundedValueHandle(indexedElementTypeId, context, state)
                        }
                }
        }
}

# Computes target-aware storage facts from canonical recursive identity. Nominal
# layouts are a fixed point over owner-to-field edges, so declaration order does
# not affect nested structs and box indirection terminates recursive layouts.
public layoutsFor request: TypeLayoutRequest -> TypeLayouts {
    request.pointerBitWidth / 8 => pointerSize
    [Int; ~] => sizes!
    [Int; ~] => aligns!
    [Int; ~] => statuses!
    0 => seedIndex!
    seedIndex! < (request.types -> len) -> while {
        request.types[seedIndex!] => current
        -1 => size!
        1 => align!
        1 => status!
        current.status != 0 -> if {
            current.kind == 1 and (current.origin == 0 or current.origin == 2)
                -> if { 1 => status! } else { 2 => status! }
        } else {
            current.kind == 1 -> if {
                current.origin == 16 -> if {
                    2 * pointerSize => size!
                    pointerSize => align!
                    0 => status!
                }
                current.origin == 1 -> if {
                    current.symbol == 0 -> if {
                        0 => size!
                        0 => status!
                    }
                    current.symbol == 1 -> if {
                        # %sollang.text is { ptr, i64 }. The i64 member keeps
                        # 8-byte ABI alignment on wasm32, so its size is 16 on
                        # both 32-bit WebAssembly and 64-bit native targets.
                        16 => size!
                        8 => align!
                        0 => status!
                    }
                    current.symbol == 2 or current.symbol == 5 or current.symbol == 10 or current.symbol == 14 or current.symbol == 19 or current.symbol == 20
                        -> if {
                            4 => size!
                            4 => align!
                            0 => status!
                        }
                    current.symbol == 3 or current.symbol == 8 or current.symbol == 23
                        -> if {
                            1 => size!
                            1 => align!
                            0 => status!
                        }
                    current.symbol == 4 or current.symbol == 9 -> if {
                        2 => size!
                        2 => align!
                        0 => status!
                    }
                    current.symbol == 6 or current.symbol == 7 or current.symbol == 11 or current.symbol == 16 or current.symbol == 21 or current.symbol == 22
                        -> if {
                            8 => size!
                            8 => align!
                            0 => status!
                        }
                    current.symbol == 12 or current.symbol == 13
                        -> if {
                            pointerSize => size!
                            pointerSize => align!
                            0 => status!
                        }
                    current.symbol == 17 or current.symbol == 18 -> if {
                        # %sollang.mapped_bytes is { ptr, i64, ptr, i64, i1 }.
                        40 => size!
                        8 => align!
                        0 => status!
                    }
                    current.symbol == 24 -> if {
                        # %sollang.source_text is { ptr, i64, ptr, i64 }.
                        32 => size!
                        8 => align!
                        0 => status!
                    }
                    current.symbol == 25 -> if {
                        # Range stores two Int bounds on every target.
                        8 => size!
                        4 => align!
                        0 => status!
                    }
                }
            }
            current.kind == 2 -> if {
                # Slices are { ptr, i64 }, not two pointer-width words.
                16 => size!
                8 => align!
                0 => status!
            }
            current.kind == 3 -> if {
                # Dynamic arrays are { ptr, i64, i64 }.
                24 => size!
                8 => align!
                0 => status!
            }
            current.kind == 12 -> if {
                # Canonical layout describes the inline value, independently
                # of the descriptor used by local collection expressions.
                1 => status!
            }
            current.kind == 5 -> if {
                24 => size!
                8 => align!
                0 => status!
            }
            current.kind == 13 -> if {
                # The byte storage is part of the value. Resolve its key and
                # value layout before publishing the aggregate size.
                1 => status!
            }
            current.kind == 14 -> if {
                ((current.length + 63) / 64) * 8 => size!
                8 => align!
                0 => status!
            }
            current.kind == 6 -> if {
                pointerSize => size!
                pointerSize => align!
                0 => status!
            }
            current.kind == 8 -> if {
                pointerSize => size!
                pointerSize => align!
                0 => status!
            }
            current.kind == 9 -> if {
                pointerSize => size!
                pointerSize => align!
                0 => status!
            }
            current.kind == 7 -> if {
                current.origin == 4 and current.symbol == 2
                    -> if {
                        pointerSize * 2 => size!
                        pointerSize => align!
                        0 => status!
                    }
                current.origin == 4 and (current.symbol == 3 or current.symbol == 4)
                    -> if {
                        pointerSize * 3 => size!
                        pointerSize => align!
                        0 => status!
                    }
                current.origin == 4 and current.symbol == 5
                    -> if {
                        24 => size!
                        8 => align!
                        0 => status!
                    }
                current.origin == 4 and (current.symbol == 6 or current.symbol == 7)
                    -> if {
                        24 => size!
                        8 => align!
                        0 => status!
                    }
            }
        }
        sizes! -> push(size!)
        aligns! -> push(align!)
        statuses! -> push(status!)
        seedIndex! + 1 => seedIndex!
    }
    true => changed!
    changed! -> while {
        false => changed!
        0 => typeIndex!
        typeIndex! < (request.types -> len) -> while {
            statuses![typeIndex!] == 1 -> if {
                request.types[typeIndex!] => current
                current.kind == 4 -> if {
                    current.first >= 0 and statuses![current.first] == 0 and current.length >= 0
                        -> if {
                            request.types[current.first] -> aggregateFieldLayout(sizes![current.first], aligns![current.first]) => elementLayout
                            elementLayout.size * current.length => sizes![typeIndex!]
                            elementLayout.align => aligns![typeIndex!]
                            0 => statuses![typeIndex!]
                            true => changed!
                        }
                }
                current.kind == 12 -> if {
                    current.first >= 0 and statuses![current.first] == 0 and current.length >= 0
                        -> if {
                            request.types[current.first] -> aggregateFieldLayout(sizes![current.first], aligns![current.first]) => boundedElementLayout
                            8 => boundedAlignment!
                            boundedElementLayout.align > boundedAlignment!
                                -> if { boundedElementLayout.align => boundedAlignment! }
                            ((8 + boundedElementLayout.align - 1) / boundedElementLayout.align) * boundedElementLayout.align => boundedDataOffset
                            boundedDataOffset + boundedElementLayout.size * current.length => boundedEnd
                            ((boundedEnd + boundedAlignment! - 1) / boundedAlignment!) * boundedAlignment! => sizes![typeIndex!]
                            boundedAlignment! => aligns![typeIndex!]
                            0 => statuses![typeIndex!]
                            true => changed!
                        }
                }
                current.kind == 13 -> if {
                    current.length > 0 and current.first >= 0 and current.second >= 0
                        and statuses![current.first] == 0 and statuses![current.second] == 0
                        -> if {
                            request.types[current.first] -> aggregateFieldLayout(sizes![current.first], aligns![current.first]) => dictionaryKeyLayout
                            request.types[current.second] -> aggregateFieldLayout(sizes![current.second], aligns![current.second]) => dictionaryValueLayout
                            current.length -> boundedDictionaryLayout(dictionaryKeyLayout.size, dictionaryKeyLayout.align, dictionaryValueLayout.size, dictionaryValueLayout.align) => dictionaryLayout
                            dictionaryLayout.size => sizes![typeIndex!]
                            dictionaryLayout.align => aligns![typeIndex!]
                            0 => statuses![typeIndex!]
                            true => changed!
                        }
                }
                current.kind == 7 and current.origin == 4 and (current.symbol == 0 or current.symbol == 1)
                    -> if {
                        current.first >= 0 and statuses![current.first] == 0 and (current.second < 0 or statuses![current.second] == 0)
                            -> if {
                                request.types[current.first] -> aggregateFieldLayout(sizes![current.first], aligns![current.first]) => firstPayloadLayout
                                firstPayloadLayout.size => payloadSize!
                                current.second >= 0 -> if {
                                    request.types[current.second] -> aggregateFieldLayout(sizes![current.second], aligns![current.second]) => secondPayloadLayout
                                    secondPayloadLayout.size > payloadSize! -> if { secondPayloadLayout.size => payloadSize! }
                                }
                                (payloadSize! + 7) / 8 => payloadWords
                                8 + payloadWords * 8 => sizes![typeIndex!]
                                8 => aligns![typeIndex!]
                                0 => statuses![typeIndex!]
                                true => changed!
                            }
                    }
                (current.kind == 1 and (current.origin == 0 or current.origin == 2)) or current.kind == 10
                    -> if {
                        0 => size!
                        1 => align!
                        true => ready!
                        0 => fieldIndex!
                        fieldIndex! < (request.fields -> len) -> while {
                            request.fields[fieldIndex!] => field
                            false => fieldBelongs!
                            field.ownerType == typeIndex! -> if { true => fieldBelongs! }
                            field.ownerType >= 0
                                and field.ownerType < (request.types -> len)
                                and current.kind == 1
                                -> if {
                                    request.types[field.ownerType] => fieldOwner
                                    fieldOwner.kind == 1
                                        and fieldOwner.module == current.module
                                        and fieldOwner.symbol == current.symbol
                                        -> if { true => fieldBelongs! }
                                }
                            field.status == 0 and fieldBelongs!
                                -> if {
                                    field.fieldType < 0 or statuses![field.fieldType] != 0
                                        -> if { false => ready! } else {
                                            request.types[field.fieldType] -> aggregateFieldLayout(sizes![field.fieldType], aligns![field.fieldType]) => fieldLayout
                                            fieldLayout.align > align! -> if { fieldLayout.align => align! }
                                            ((size! + fieldLayout.align - 1) / fieldLayout.align) * fieldLayout.align => size!
                                            size! + fieldLayout.size => size!
                                        }
                                }
                            fieldIndex! + 1 => fieldIndex!
                        }
                        ready! -> if {
                            ((size! + align! - 1) / align!) * align! => sizes![typeIndex!]
                            align! => aligns![typeIndex!]
                            0 => statuses![typeIndex!]
                            true => changed!
                        }
                    }
            }
            typeIndex! + 1 => typeIndex!
        }
    }
    TypeLayouts { sizes: sizes!, aligns: aligns!, statuses: statuses! } => result
    result
}

public layoutOf request: TypeLayoutRequest -> TypeLayout {
    request.typeId => requestedType
    request -> layoutsFor => layouts
    requestedType >= 0 and requestedType < (layouts.sizes -> len)
        -> if {
            TypeLayout { size: layouts.sizes[requestedType], align: layouts.aligns[requestedType], status: layouts.statuses[requestedType] }
        } else {
            TypeLayout { size: -1, align: 1, status: 2 }
        }
}

# Logical repeat length is independent of declared storage capacity.
arrayLiteralCapacity node: typedIr.TypedIrNode, length: Int, context: ref emitterContext.EmitContext -> Int {
    # Context can retarget an unannotated literal to a bounded field or return.
    # Its committed type owns capacity; the syntax opcode still describes the
    # original literal and may be -1.
    node.typeId >= 0 and node.typeId < (context.types -> len)
        and context.types[node.typeId].kind == 12
        -> if { context.types[node.typeId].length -> return }
    node.opcode >= 1_000_000 -> if { node.opcode - 1_000_000 -> return }
    length
}

arrayLiteralLength node: typedIr.TypedIrNode, operandCount: Int, context: ref emitterContext.EmitContext -> Int {
    # A typed empty capacity hint reserves backing without creating elements.
    node.opcode >= 1_000_000 and operandCount == 0
        -> if { 0 -> return }
    node.typeId >= 0 and node.typeId < (context.types -> len)
        and context.types[node.typeId].kind == 4 and context.types[node.typeId].length >= 0
        -> if { context.types[node.typeId].length -> return }
    node.sourceModule >= 0 and node.sourceModule < (context.ranges -> len)
        -> if {
            context.ranges[node.sourceModule] => range
            node.astNode >= 0 and node.astNode < range.astCount
                -> if {
                    context.nodes[range.astStart + node.astNode] => literal
                    context.sources[node.sourceModule] -> typeIds.arrayStorageSyntaxFromTokens(context.tokens, range.tokenStart, literal) => storage
                    storage.isRepeat and storage.length >= 0 -> if { storage.length -> return }
                }
        }
    operandCount
}

isDynamicArrayType node: typedIr.TypedIrNode -> Bool {
    node -> typeQueries.isDynamicArray
}

isSliceArrayType node: typedIr.TypedIrNode -> Bool {
    node -> typeQueries.isSliceArray
}

isFixedArrayType node: typedIr.TypedIrNode -> Bool {
    node -> typeQueries.isFixedArray
}

# C# promotes a direct binding literal only when its element layout is known
# by the syntax-only placement analysis. Call arguments need independent storage.
fixedArrayLiteralNeedsHeap nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => needsHeap!
    nodeIndex >= 0 and nodeIndex < (context.ir -> len)
        -> if {
            context.ir[nodeIndex] => node
            node.kind == 14 and (node -> isFixedArrayType)
                and node.parent >= 0 and node.parent < (context.ir -> len)
                -> if {
                    context.ir[node.parent] => parent
                    # A consuming fixed call promotes parameter views before
                    # returning fixed storage, so its literal input can stay inline.
                    (parent.kind == 6 or parent.kind == 9)
                        and parent.typeId >= 0 and parent.typeId < (context.types -> len)
                        and context.types[parent.typeId].kind == 4
                        -> if {
                            parent.operand0 => argumentIndex!
                            0 => ordinal!
                            argumentIndex! >= 0 and argumentIndex! != nodeIndex
                                -> while {
                                    context.ir[argumentIndex!].nextOperand => argumentIndex!
                                    ordinal! + 1 => ordinal!
                                }
                            argumentIndex! == nodeIndex -> if {
                                node.parent -> callTargetParameter(ordinal!, context, state) => parameterIndex
                                parameterIndex >= 0 -> if {
                                    context.ir[parameterIndex] => parameter
                                    parameter.flags % 4 == 1
                                        and parameter.typeId >= 0 and parameter.typeId < (context.types -> len)
                                        and context.types[parameter.typeId].kind == 4
                                        -> if { false -> return }
                                }
                            }
                        }
                    parent.kind == 17 and parent.operand0 == nodeIndex
                        and node.operand0 >= 0 and context.ir[node.operand0].kind != 3
                        -> if { true => needsHeap! }
                    parent.kind == 0 or parent.kind == 1 or parent.kind == 6 or parent.kind == 9 or parent.kind == 12 or parent.kind == 23 or parent.kind == 26 or parent.kind == 35
                        -> if { true => needsHeap! }
                }
        }
    needsHeap!
}

emptyArrayCallParameter nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => parameterIndex!
    nodeIndex >= 0 and nodeIndex < (context.ir -> len)
        -> if {
            context.ir[nodeIndex] => node
            node.kind == 14 and node.operand0 < 0 and node.parent >= 0 and node.parent < (context.ir -> len)
                -> if {
                    context.ir[node.parent] => call
                    call.kind == 6 or call.kind == 9 -> if {
                        call.operand0 => argumentIndex!
                        0 => argumentOrdinal!
                        argumentIndex! >= 0 and argumentIndex! != nodeIndex
                            -> while {
                                context.ir[argumentIndex!].nextOperand => argumentIndex!
                                argumentOrdinal! + 1 => argumentOrdinal!
                            }
                        argumentIndex! == nodeIndex -> if { node.parent -> callTargetParameter(argumentOrdinal!, context, state) => parameterIndex! }
                    }
                }
        }
    parameterIndex!
}

isDictionaryType node: typedIr.TypedIrNode -> Bool {
    node -> typeQueries.isDictionary
}

isGenericEnumType node: typedIr.TypedIrNode -> Bool {
    node -> typeQueries.isGenericEnum
}

isNominalStructType node: typedIr.TypedIrNode -> Bool {
    node -> typeQueries.isNominalStruct
}

isTextType node: typedIr.TypedIrNode -> Bool {
    node -> typeQueries.isText
}

isArgumentsType node: typedIr.TypedIrNode -> Bool {
    node -> typeQueries.isArguments
}

writeTextLikeType node: typedIr.TypedIrNode -> Unit uses Console {
    node -> typeQueries.writeTextLike
}

ownsType node: typedIr.TypedIrNode -> Bool {
    node -> typeQueries.owns
}

# Transitional public boundary used by the emitter and regressions. Canonical
# kind/ownership wins whenever a type ID exists; the shallow branch remains
# only for IR nodes whose migration is not complete yet.
public writeType node: typedIr.TypedIrNode -> Unit uses Console {
    node -> typeQueries.write
}

writeDecimal value: Int -> Unit uses Console {
    "$(value)" -> print
}

writeDecimalLine value: Int -> Unit uses Console {
    "$(value)" -> println
}

# Map producers have one normalized Typed IR contract in every expression
# region. flags bits 0/1/2 denote at/for/size respectively; present values are
# chained from the path operand in source order.
isMappedBytesFlush expression: typedIr.TypedIrNode, context: ref emitterContext.EmitContext -> Bool {
    (expression.kind == 6 or expression.kind == 9)
        and expression.symbol == -114
        and expression.operand0 >= 0
        and context.ir[expression.operand0].typeOrigin == 1
        and context.ir[expression.operand0].typeSymbol == 18
}

emitMappedBytesExpression expressionIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[expressionIndex] => expression
    expression.operand0 => pathIndex
    context.ir[pathIndex].nextOperand => optionIndex!
    -1 => offsetIndex!
    -1 => lengthIndex!
    -1 => sizeIndex!
    expression.flags % 2 == 1 -> if {
        optionIndex! => offsetIndex!
        optionIndex! >= 0 -> if { context.ir[optionIndex!].nextOperand => optionIndex! }
    }
    expression.flags / 2 % 2 == 1 -> if {
        optionIndex! => lengthIndex!
        optionIndex! >= 0 -> if { context.ir[optionIndex!].nextOperand => optionIndex! }
    }
    expression.flags / 4 % 2 == 1 -> if {
        optionIndex! => sizeIndex!
    }
    "  %v$(expressionIndex)_path_data = extractvalue %sollang.text " -> print
    pathIndex -> writeValue(ownerIndex, context, state)
    ", 0" -> println
    "  %v$(expressionIndex)_path_length = extractvalue %sollang.text " -> print
    pathIndex -> writeValue(ownerIndex, context, state)
    ", 1" -> println
    "  %v$(expressionIndex) = call %sollang.mapped_bytes @sollang_map_file(ptr %v$(expressionIndex)_path_data, i64 %v$(expressionIndex)_path_length, i64 " -> print
    offsetIndex! >= 0 -> if { offsetIndex! -> writeValue(ownerIndex, context, state) } else { "0" -> print }
    ", i64 " -> print
    lengthIndex! >= 0 -> if { lengthIndex! -> writeValue(ownerIndex, context, state) } else { "0" -> print }
    ", i64 " -> print
    sizeIndex! >= 0 -> if { sizeIndex! -> writeValue(ownerIndex, context, state) } else { "0" -> print }
    expression.opcode == -307
        -> if { ", i1 true)" -> println } else { ", i1 false)" -> println }
    "  %v$(expressionIndex)_mapped_data = extractvalue %sollang.mapped_bytes %v$(expressionIndex), 0" -> println
    "  %v$(expressionIndex)_mapped_valid = icmp ne ptr %v$(expressionIndex)_mapped_data, null" -> println
    "  br i1 %v$(expressionIndex)_mapped_valid, label %mapped$(expressionIndex)_open_ok, label %mapped$(expressionIndex)_open_fail" -> println
    "mapped$(expressionIndex)_open_fail:" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "mapped$(expressionIndex)_open_ok:" -> println
}

emitMappedBytesFlush expressionIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[expressionIndex] => expression
    "  %v$(expressionIndex)_mapped_base = extractvalue %sollang.mapped_bytes " -> print
    expression.operand0 -> writeValue(ownerIndex, context, state)
    ", 2" -> println
    "  %v$(expressionIndex)_mapped_length = extractvalue %sollang.mapped_bytes " -> print
    expression.operand0 -> writeValue(ownerIndex, context, state)
    ", 3" -> println
    "  %v$(expressionIndex)_mapped_flush_ok = call i32 @sollang_mapped_flush(ptr %v$(expressionIndex)_mapped_base, i64 %v$(expressionIndex)_mapped_length)" -> println
    "  %v$(expressionIndex)_mapped_flush_succeeded = icmp ne i32 %v$(expressionIndex)_mapped_flush_ok, 0" -> println
    "  br i1 %v$(expressionIndex)_mapped_flush_succeeded, label %mapped$(expressionIndex)_flush_ok, label %mapped$(expressionIndex)_flush_fail" -> println
    "mapped$(expressionIndex)_flush_fail:" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "mapped$(expressionIndex)_flush_ok:" -> println
}

isDirectTextEachSource source: typedIr.TypedIrNode, context: ref emitterContext.EmitContext -> Bool {
    source.typeId => typeId!
    typeId! >= 0 -> if {
        context.types[typeId!].kind == 8 -> if { context.types[typeId!].first => typeId! }
        context.types[typeId!] => valueType
        valueType.kind == 1 and valueType.origin == 1 and valueType.symbol == 1
    } else { false }
}

emitDirectEachEnd eachIndex: Int, bodyTerminated: Bool, context: ref emitterContext.EmitContext -> Unit uses Console {
    not bodyTerminated -> if {
        "  br label %each$(eachIndex)_continue" -> println
    }
    "each$(eachIndex)_continue:" -> println
    (context.ir[context.ir[eachIndex].operand0] -> typeQueries.isRange(context)) or context.ir[eachIndex].opcode == typedIr.repeatOpcode()
        -> if {
            "  %each$(eachIndex)_current = load i64, ptr %each$(eachIndex)_index_slot, align 8" -> println
            "  %each$(eachIndex)_next = add i64 %each$(eachIndex)_current, 1" -> println
            "  store i64 %each$(eachIndex)_next, ptr %each$(eachIndex)_index_slot, align 8" -> println
        } else {
            context.ir[context.ir[eachIndex].operand0] -> isDirectTextEachSource(context)
                -> if {
                    "  %each$(eachIndex)_next = add i64 %each$(eachIndex)_index, %each$(eachIndex)_width" -> println
                } else {
                    "  %each$(eachIndex)_next = add i64 %each$(eachIndex)_index, 1" -> println
                }
            "  store i64 %each$(eachIndex)_next, ptr %each$(eachIndex)_index_slot, align 8" -> println
        }
    "  br label %each$(eachIndex)_header" -> println
    "each$(eachIndex)_exit:" -> println
}

# One direct-each implementation is shared by functions, main, and control arms.
emitDirectEachStart eachIndex: Int, ownerIndex: Int, ownerStart: Int, ownerEnd: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[eachIndex] => eachNode
    context.ir[ownerIndex] => owner
    context.ir[eachNode.operand0] => eachSource
    eachSource -> isArgumentsType => eachArguments
    eachSource -> isDirectTextEachSource(context) => eachText
    eachNode.opcode == typedIr.repeatOpcode() => eachRepeat
    eachSource -> typeQueries.isRange(context) => eachRange
    eachIndex -> asyncIntIteratorIsPersistent(context, state) => persistentIntIterator
    eachRepeat -> if {
        "  %each$(eachIndex)_count = freeze i32 " -> print
        eachNode.operand0 -> writeValue(ownerIndex, context, state)
        "" -> println
    }
    eachRange or eachRepeat -> if {
        eachRange -> if {
            "  %each$(eachIndex)_range = " -> print
            (eachSource -> referenceValueTypeId(context, state)) >= 0
                and not (eachNode.operand0 -> referenceParameterValueIsMaterialized(ownerIndex, context, state))
                -> if {
                    "load { i32, i32 }, ptr " -> print
                    eachNode.operand0 -> writeValue(ownerIndex, context, state)
                    ", align 4" -> println
                } else {
                    "freeze " -> print
                    eachNode.operand0 -> writeReadOperand(ownerIndex, context, state)
                    "" -> println
                }
            "  %each$(eachIndex)_first = extractvalue { i32, i32 } %each$(eachIndex)_range, 0" -> println
            "  %each$(eachIndex)_last = extractvalue { i32, i32 } %each$(eachIndex)_range, 1" -> println
            "  %each$(eachIndex)_start = sext i32 %each$(eachIndex)_first to i64" -> println
        }
        "  %each$(eachIndex)_limit = sext i32 " -> print
        eachRepeat -> if { "%each$(eachIndex)_count" -> print } else { "%each$(eachIndex)_last" -> print }
        " to i64" -> println
        "  store i64 " -> print
        eachRepeat -> if { "1" -> print } else { "%each$(eachIndex)_start" -> print }
        ", ptr %each$(eachIndex)_index_slot, align 8" -> println
        "  store i64 %each$(eachIndex)_limit, ptr %each$(eachIndex)_limit_slot, align 8" -> println
        "  br label %each$(eachIndex)_header" -> println
        "each$(eachIndex)_header:" -> println
        "  %each$(eachIndex)_index = load i64, ptr %each$(eachIndex)_index_slot, align 8" -> println
        "  %each$(eachIndex)_bound = load i64, ptr %each$(eachIndex)_limit_slot, align 8" -> println
        "  %each$(eachIndex)_done = icmp sgt i64 %each$(eachIndex)_index, %each$(eachIndex)_bound" -> println
        "  br i1 %each$(eachIndex)_done, label %each$(eachIndex)_exit, label %each$(eachIndex)_body" -> println
        "each$(eachIndex)_body:" -> println
        "  %each$(eachIndex)_item = trunc i64 %each$(eachIndex)_index to i32" -> println
    } else {
        eachSource -> isSetCollection(context) => eachSet
        false => eachReadonlyReference!
        eachSource.typeId => eachContainerTypeId!
        eachContainerTypeId! >= 0 and context.types[eachContainerTypeId!].kind == 8
            -> if {
                context.types[eachContainerTypeId!].first => eachContainerTypeId!
                context.types[eachContainerTypeId!].kind == 3 or eachText
                    -> if {
                        true => eachReadonlyReference!
                        "  %each$(eachIndex)_source = load " -> print
                        eachContainerTypeId! -> writeSemanticTypeId(context, state)
                        ", ptr " -> print
                        eachNode.operand0 -> writeValue(ownerIndex, context, state)
                        ", align 8" -> println
                    }
            }
        eachArguments -> if {
            "  %each$(eachIndex)_length = call i64 @sollang_argument_count()" -> println
        } else {
            eachSet -> if {
                "  %each$(eachIndex)_storage = extractvalue %sollang.dict " -> print
                eachNode.operand0 -> writeValue(ownerIndex, context, state)
                ", 0" -> println
                "  %each$(eachIndex)_length = extractvalue %sollang.dict " -> print
                eachNode.operand0 -> writeValue(ownerIndex, context, state)
                ", 2" -> println
                context.types[eachContainerTypeId!].first => eachSetElementType
                context.typeSizes[eachSetElementType] -> dictionaryEntryLayout(context.typeAligns[eachSetElementType], 0, 1) => eachSetEntryLayout
                "each$(eachIndex)" -> emitGrowableDictionaryPointers("%each$(eachIndex)_storage", "%each$(eachIndex)_length", eachSetEntryLayout)
            } else {
                "  %each$(eachIndex)_data = extractvalue " -> print
                eachContainerTypeId! -> writeArrayViewType(context, state)
                " " -> print
                eachReadonlyReference! -> if { "%each$(eachIndex)_source" -> print } else {
                    eachSource.kind == 5 and owner.operand1 >= 0 and eachSource.symbol == context.ir[owner.operand1].symbol
                        -> if { "%arg" -> print } else { "%v$(eachNode.operand0)" -> print }
                }
                ", 0" -> println
                "  %each$(eachIndex)_length = extractvalue " -> print
                eachContainerTypeId! -> writeArrayViewType(context, state)
                " " -> print
                eachReadonlyReference! -> if { "%each$(eachIndex)_source" -> print } else {
                    eachSource.kind == 5 and owner.operand1 >= 0 and eachSource.symbol == context.ir[owner.operand1].symbol
                        -> if { "%arg" -> print } else { "%v$(eachNode.operand0)" -> print }
                }
                ", 1" -> println
            }
        }
        "  store i64 0, ptr %each$(eachIndex)_index_slot, align 8" -> println
        "  br label %each$(eachIndex)_header" -> println
        "each$(eachIndex)_header:" -> println
        "  %each$(eachIndex)_index = load i64, ptr %each$(eachIndex)_index_slot, align 8" -> println
        "  %each$(eachIndex)_done = icmp " -> print
        eachText -> if { "uge" -> print } else { "eq" -> print }
        " i64 %each$(eachIndex)_index, %each$(eachIndex)_length" -> println
        eachSet -> if {
            "  br i1 %each$(eachIndex)_done, label %each$(eachIndex)_exit, label %each$(eachIndex)_check" -> println
            "each$(eachIndex)_check:" -> println
            "  %each$(eachIndex)_control_ptr = getelementptr i8, ptr %each$(eachIndex)_controls, i64 %each$(eachIndex)_index" -> println
            "  %each$(eachIndex)_control = load i8, ptr %each$(eachIndex)_control_ptr, align 1" -> println
            "  %each$(eachIndex)_occupied = icmp sgt i8 %each$(eachIndex)_control, 0" -> println
            "  br i1 %each$(eachIndex)_occupied, label %each$(eachIndex)_body, label %each$(eachIndex)_continue" -> println
        } else {
            "  br i1 %each$(eachIndex)_done, label %each$(eachIndex)_exit, label %each$(eachIndex)_body" -> println
        }
        "each$(eachIndex)_body:" -> println
        eachArguments -> if {
            "  %each$(eachIndex)_item = call %sollang.text @sollang_argument(i64 %each$(eachIndex)_index)" -> println
        } else {
            eachText -> if {
                "  %each$(eachIndex)_utf8 = call i64 @sollang_utf8_decode(ptr %each$(eachIndex)_data, i64 %each$(eachIndex)_length, i64 %each$(eachIndex)_index)" -> println
                "  %each$(eachIndex)_valid = icmp ne i64 %each$(eachIndex)_utf8, -1" -> println
                "  br i1 %each$(eachIndex)_valid, label %each$(eachIndex)_decoded, label %each$(eachIndex)_invalid" -> println
                "each$(eachIndex)_invalid:" -> println
                "  call void @llvm.trap()" -> println
                "  unreachable" -> println
                "each$(eachIndex)_decoded:" -> println
                "  %each$(eachIndex)_item = trunc i64 %each$(eachIndex)_utf8 to i32" -> println
                "  %each$(eachIndex)_width = lshr i64 %each$(eachIndex)_utf8, 32" -> println
            } else {
                "  %each$(eachIndex)_item_ptr = getelementptr " -> print
                eachSource -> writeArrayElementType(context, state)
                ", ptr " -> print
                eachSet -> if { "%each$(eachIndex)_keys" -> print } else { "%each$(eachIndex)_data" -> print }
                ", i64 %each$(eachIndex)_index" -> println
                "  %each$(eachIndex)_item = load " -> print
                eachSource -> writeArrayElementType(context, state)
                ", ptr %each$(eachIndex)_item_ptr, align " -> print
                eachSource -> arrayElementAlign(context, state) -> writeDecimalLine
            }
        }
    }
    persistentIntIterator -> if { return }
    eachIndex -> emitDirectEachRoleAliases(eachSource, context, state)
    ownerStart => eachRoleUseIndex!
    eachRoleUseIndex! < ownerEnd -> while {
        context.ir[eachRoleUseIndex!] => eachRoleUse
        NodeAncestorRequest { nodeIndex: eachRoleUseIndex!, ownerIndex: eachIndex } => eachRoleAncestorRequest
        eachRoleAncestorRequest -> nodeDescendsFrom(context, state) => eachRoleInside
        eachRoleUse.kind == 5 and eachRoleUse.operand0 < 0 and eachRoleUse.symbol >= 0 and eachRoleInside
            -> if {
                context.ranges[eachRoleUse.sourceModule] => eachRoleRange
                false => eachRoleIsItem!
                eachRoleUse.symbol < eachRoleRange.symbolCount
                    -> if {
                        context.symbols[eachRoleRange.symbolStart + eachRoleUse.symbol] => eachRoleSymbol
                        eachRoleSymbol.kind == 35 and eachRoleSymbol.astNode == eachNode.astNode
                            -> if { true => eachRoleIsItem! }
                    }
                eachRoleIsItem! -> if {
                    "  %v$(eachRoleUseIndex!) = freeze " -> print
                    eachSource -> writeDirectEachElementType(context, state)
                    " %each$(eachIndex)_item" -> println
                }
            }
        eachRoleUseIndex! + 1 => eachRoleUseIndex!
    }
}

# Capacity exists only on growable/bounded owners and Arena. Fixed arrays,
# slices and Text have no capacity field. Keep rejection and extraction on
# the same semantic receiver contract.
interpolationCapacityField typeId: Int, context: ref emitterContext.EmitContext -> Int {
    typeId => valueType!
    valueType! >= 0 and context.types[valueType!].kind == 8
        -> if {
            context.types[valueType!].first => valueType!
        }
    -1 => field!
    valueType! >= 0 -> if {
        context.types[valueType!] => value
        value.kind == 3 or value.kind == 12
            or (value.kind == 1 and value.origin == 1 and value.symbol == 15)
            -> if { 2 => field! }
        value.kind == 5 -> if { 2 => field! }
        # A bounded dictionary's public maximum is a type constant; the
        # nonnegative result only records that capacity is available.
        value.kind == 13 -> if { 0 => field! }
    }
    field!
}

interpolationContainingOwner literalIndex: Int, context: ref emitterContext.EmitContext -> Int {
    context.ir[literalIndex].parent => owner!
    owner! >= 0 and context.ir[owner!].kind != 0 and context.ir[owner!].kind != 11
        -> while {
            context.ir[owner!].parent => owner!
        }
    owner!
}

invalidInterpolationCapacityNode context: ref emitterContext.EmitContext -> Int {
    false => hasCapacity!
    0 => search!
    search! < (context.interpolations -> len) and not hasCapacity!
        -> while {
            context.interpolations[search!].kind == 6 and context.interpolations[search!].opcode == -236
                -> if { true => hasCapacity! }
            search! + 1 => search!
        }
    not hasCapacity! -> if { -1 -> return }
    context -> prepareCoreEmitterState => state
    -1 => invalid!
    0 => irIndex!
    irIndex! < (context.ir -> len) and invalid! < 0
        -> while {
            context.ir[irIndex!] => literal
            literal.kind == 2 and literal.sourceModule >= 0
                -> if {
                    irIndex! -> interpolationContainingOwner(context) => owner
                    context.interpolationRanges[literal.sourceModule] => range
                    range.nodeStart => nodeIndex!
                    nodeIndex! < range.nodeStart + range.nodeCount and invalid! < 0
                        -> while {
                            context.interpolations[nodeIndex!] => node
                            node.sourceToken == literal.payloadToken and node.kind == 6 and node.opcode == -236 and node.operand0 >= 0
                                -> if {
                                    node.operand0 -> interpolationNodeTypeId(context.interpolations, literal.sourceModule, owner, irIndex!, context, state) => receiverType
                                    (receiverType -> interpolationCapacityField(context)) < 0
                                        -> if { nodeIndex! => invalid! }
                                }
                            nodeIndex! + 1 => nodeIndex!
                        }
                }
            irIndex! + 1 => irIndex!
        }
    invalid!
}

invalidInterpolationFlowTargetNode context: ref emitterContext.EmitContext -> Int {
    false => hasFlowCall!
    0 => search!
    search! < (context.interpolations -> len) and not hasFlowCall!
        -> while {
            context.interpolations[search!].kind == 10
                -> if { true => hasFlowCall! }
            search! + 1 => search!
        }
    not hasFlowCall! -> if { -1 -> return }
    context -> prepareCoreEmitterState => state
    -1 => invalid!
    0 => irIndex!
    irIndex! < (context.ir -> len) and invalid! < 0
        -> while {
            context.ir[irIndex!] => literal
            literal.kind == 2 and literal.sourceModule >= 0
                -> if {
                    irIndex! -> interpolationContainingOwner(context) => owner
                    context.interpolationRanges[literal.sourceModule] => range
                    range.nodeStart => nodeIndex!
                    nodeIndex! < range.nodeStart + range.nodeCount and invalid! < 0
                        -> while {
                            context.interpolations[nodeIndex!] => node
                            node.sourceToken == literal.payloadToken
                                and node.kind == 10
                                and node.operand0 >= 0
                                and node.callNameLength > 0
                                and (node -> interpolationEnumConstructorIndex(literal.sourceModule, context)) < 0
                                -> if {
                                    nodeIndex! -> interpolationCallTargetFunction(context.interpolations, literal.sourceModule, owner, irIndex!, context, state) => target
                                    target < 0 -> if { nodeIndex! => invalid! }
                                }
                            nodeIndex! + 1 => nodeIndex!
                        }
                }
            irIndex! + 1 => irIndex!
        }
    invalid!
}

# Symbolic repeat cardinality comes from the owning value-generic ABI slot.
# Keep one source body while producing the same backing, fill and logical
# length as the managed compiler's concrete value specialization.
emitValueGenericArrayRepeat nodeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool uses Console, Process {
    context.ir[nodeIndex] => node
    node.kind != 14 or node.sourceModule < 0 -> if { false -> return }
    context.ranges[node.sourceModule] => range
    context.nodes[range.astStart + node.astNode] => literal
    context.sources[node.sourceModule] -> typeIds.arrayStorageSyntaxFromTokens(context.tokens, range.tokenStart, literal) => storage
    not storage.isRepeat or storage.length >= 0 -> if { false -> return }
    -1 => countToken!
    false => afterSemicolon!
    0 => depth!
    literal.firstToken => tokenIndex!
    tokenIndex! < literal.firstToken + literal.tokenCount
        -> while {
            context.tokens[range.tokenStart + tokenIndex!] => token
            token.kind == grammar.tokenIdLeftBracket() or token.kind == grammar.tokenIdLeftBrace() or token.kind == grammar.tokenIdLeftParen()
                -> if { depth! + 1 => depth! }
            token.kind == grammar.tokenIdRightBracket() or token.kind == grammar.tokenIdRightBrace() or token.kind == grammar.tokenIdRightParen()
                -> if { depth! - 1 => depth! }
            depth! == 1 -> if {
                token.kind == grammar.tokenIdSemicolon() -> if { true => afterSemicolon! }
                afterSemicolon! and token.kind == grammar.tokenIdIdentifier()
                    -> if { tokenIndex! => countToken! }
            }
            tokenIndex! + 1 => tokenIndex!
        }
    -1 => countParameter!
    countToken! >= 0 and ownerIndex >= 0 -> if {
        context.tokens[range.tokenStart + countToken!] => countName
        context.sources[node.sourceModule] -> slice(countName.span.start, countName.span.length) => spelling
        context.ir[ownerIndex] => owner
        owner.operand1 => parameterIndex!
        0 => ordinal!
        parameterIndex! >= 0 -> while {
            context.ir[parameterIndex!] => parameter
            parameter.kind == 10 and parameter.sourceModule == node.sourceModule and parameter.symbol >= 0
                -> if {
                    context.symbols[range.symbolStart + parameter.symbol] => symbol
                    symbol.kind == 32 -> if {
                        context.tokens[range.tokenStart + symbol.nameToken] => name
                        (context.sources[node.sourceModule] -> slice(name.span.start, name.span.length)) == spelling
                            -> if { parameterIndex! => countParameter! }
                    }
                }
            ordinal! == 0 -> if { owner.nextOperand => parameterIndex! } else { parameter.nextOperand => parameterIndex! }
            ordinal! + 1 => ordinal!
        }
    }
    countParameter! < 0 or node.operand0 < 0 -> if {
        "; sollang compiler error: symbolic array repeat has no owning value parameter at ir $nodeIndex" -> println
        process.exit(1)
    }
    "  %v$(nodeIndex)_repeat_length = sext i32 " -> print
    context -> writeParameterReference(ownerIndex, context.ir[countParameter!].symbol) => countWritten
    " to i64" -> println
    "  %v$(nodeIndex)_repeat_nonempty = icmp sgt i64 %v$(nodeIndex)_repeat_length, 0" -> println
    "  %v$(nodeIndex)_repeat_capacity = select i1 %v$(nodeIndex)_repeat_nonempty, i64 %v$(nodeIndex)_repeat_length, i64 1" -> println
    "  %v$(nodeIndex)_repeat_bytes = mul i64 %v$(nodeIndex)_repeat_capacity, $(node -> arrayElementSize(context, state))" -> println
    "  %v$(nodeIndex)_data = call ptr @malloc(i64 %v$(nodeIndex)_repeat_bytes)" -> println
    "  %v$(nodeIndex)_repeat_slot = alloca i64, align 8" -> println
    "  store i64 0, ptr %v$(nodeIndex)_repeat_slot, align 8" -> println
    "  br label %repeat$(nodeIndex)_header" -> println
    "repeat$(nodeIndex)_header:" -> println
    "  %v$(nodeIndex)_repeat_index = load i64, ptr %v$(nodeIndex)_repeat_slot, align 8" -> println
    "  %v$(nodeIndex)_repeat_done = icmp eq i64 %v$(nodeIndex)_repeat_index, %v$(nodeIndex)_repeat_length" -> println
    "  br i1 %v$(nodeIndex)_repeat_done, label %repeat$(nodeIndex)_end, label %repeat$(nodeIndex)_body" -> println
    "repeat$(nodeIndex)_body:" -> println
    "  %v$(nodeIndex)_repeat_ptr = getelementptr " -> print
    node -> writeArrayElementType(context, state)
    ", ptr %v$(nodeIndex)_data, i64 %v$(nodeIndex)_repeat_index" -> println
    "  store " -> print
    node -> writeArrayElementType(context, state)
    " " -> print
    node.operand0 -> writeValue(ownerIndex, context, state)
    ", ptr %v$(nodeIndex)_repeat_ptr, align $(node -> arrayElementAlign(context, state))" -> println
    "  %v$(nodeIndex)_repeat_next = add i64 %v$(nodeIndex)_repeat_index, 1" -> println
    "  store i64 %v$(nodeIndex)_repeat_next, ptr %v$(nodeIndex)_repeat_slot, align 8" -> println
    "  br label %repeat$(nodeIndex)_header" -> println
    "repeat$(nodeIndex)_end:" -> println
    "  %v$(nodeIndex)_0 = insertvalue { ptr, i64 } poison, ptr %v$(nodeIndex)_data, 0" -> println
    "  %v$(nodeIndex) = insertvalue { ptr, i64 } %v$(nodeIndex)_0, i64 %v$(nodeIndex)_repeat_length, 1" -> println
    true
}
