import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.expression_type_ids as expressionTypes
import sollang.compiler.semantic.storage_placement_source_index as sourceIndex
import sollang.compiler.semantic.storage_placement_units as sourceUnits
import sollang.compiler.semantic.storage_placement_frames as frames
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.diagnostics as diagnostics
import sys.process as process

struct Query { label: Text, name: Text, line: Int }

location nodeIndex: Int, source: Text, prepared: ref semanticContext.SemanticSnapshot, indexed: ref sourceIndex.SourceIndex, units: ref sourceUnits.UnitPlan -> (line: Int, column: Int) {
    prepared.package.ranges[0] => range
    prepared.package.nodes[range.astStart + nodeIndex] => node
    node.start => offset!
    node.kind == 9 -> if {
        prepared.package.tokens[range.tokenStart + node.payloadToken].span.start => offset!
    }
    units.units -> each unit { unit.astNode == nodeIndex -> if {
            prepared.package.tokens[range.tokenStart + unit.locationToken].span.start => offset!
    } }
    source -> diagnostics.sourceLocation(offset!)
}

kindCode nodeIndex: Int, prepared: ref semanticContext.SemanticSnapshot -> Int {
    prepared.package.ranges[0] => range
    prepared.package.nodes[range.astStart + nodeIndex] => node
    node.kind == 9 -> if { 2 -> return }
    node.kind == 38 -> if { 3 -> return }
    prepared.package -> typeIds.arrayStorageSyntax(0, nodeIndex) => storage
    storage.isRepeat -> if { 1 } else { 0 }
}

inspect label: Text, source: Text, queries: [Query] -> Unit uses Console, Process {
    [source,; ~] -> semanticContext.prepare => prepared
    prepared -> expressionTypes.resolveContext => facts
    prepared.package.ranges[0] => range
    range.astStart -> sourceIndex.build(range.astCount, prepared.package.nodes) -> when {
        Err(_) { process.exit(1) }
        Ok(indexed) { prepared.package -> sourceUnits.build(0, indexed) -> when {
                Err(_) { process.exit(2) }
                Ok(units) {
                    "case:$label" -> println
                    queries -> each query {
                        -1 => frame!
                        0 => i!
                        i! < range.astCount -> while {
                            prepared.package.nodes[range.astStart + i!] => node
                            query.line == 0 and node.kind == 8 -> if { i! => frame! }
                            query.line > 0 and (node.kind == 7 or node.kind == 31)
                                -> if {
                                    source -> diagnostics.sourceLocation(node.start) => location
                                    prepared.package.tokens[range.tokenStart + node.payloadToken] => name
                                    location.line == query.line and (source -> slice(name.span.start, name.span.length)) == query.name
                                        -> if { i! => frame! }
                                }
                            i! + 1 => i!
                        }
                        frame! < 0 -> if { process.exit(3) }
                        frame! -> frames.build(source, prepared, facts, 0, indexed, units) -> when {
                            Err(_) { process.exit(4) }
                            Ok(plan) {
                                "$(query.label)|slots:$(plan.slots -> len)" -> println
                                0 => slot!
                                plan.slots -> each item {
                                    "s|$(slot!):$(item.size):$(item.align)" -> println
                                    slot! + 1 => slot!
                                }
                                0 => ordinal!
                                plan.candidates -> each candidate {
                                    candidate.source -> kindCode(prepared) => kind
                                    candidate.source -> location(source, prepared, indexed, units) => start
                                    candidate.endUnit -> location(source, prepared, indexed, units) => end
                                    "c|$(ordinal!):$kind:$(start.line):$(start.column):$(candidate.size):$(candidate.start):$(candidate.end):$(end.line):$(end.column):$(candidate.automaticEnd):$(plan.slotsByCandidate[ordinal!])" -> println
                                    ordinal! + 1 => ordinal!
                                }
                                plan.ends -> each ending {
                                    ending.unit -> location(source, prepared, indexed, units) => end
                                    units.isResultByAst[ending.unit] -> if { "V" } else { "S" } => kind
                                    "e|$(ending.position):$(end.line):$(end.column):$kind:$(ending.slot):$(ending.size)" -> println
                                }
                            }
                        }
                    }
                }
        } }
    }
}

main {
    """
    main {
        [1; 1025] => values
    }
    """ => source0
    "oversized-fixed" -> inspect(source0, [Query { label: "main", name: "", line: 0 }])
    """
    main {
        [1, 2] => first
        [3; 4] => second
    }
    """ => source1
    "sequential-slot-growth" -> inspect(source1, [Query { label: "main", name: "", line: 0 }])
    """
    main {
        [1; 512] => first
        [2; 512] => second
        [3; 1] => third
        first[0] => firstValue
        second[0] => secondValue
    }
    """ => source2
    "source-lifetimes-consume-budget" -> inspect(source2, [Query { label: "main", name: "", line: 0 }])
    """
    main {
        [Int; ~] => values!
        1..3 -> each value {
            values! -> push(value)
        }
    }
    """ => source3
    "mutable-loop-owner-header" -> inspect(source3, [Query { label: "main", name: "", line: 0 }])
    """
    main {
        [1, 2; ~] => values
        values -> capacity => allocated
        values[0] => first
    }
    """ => source4
    "readonly-dynamic-capacity" -> inspect(source4, [Query { label: "main", name: "", line: 0 }])
    """
    main {
        { 1: 2 } => scores
        scores[1] => first
    }
    """ => source5
    "readonly-dictionary" -> inspect(source5, [Query { label: "main", name: "", line: 0 }])
    """
    main {
        [1, 2; ~] => values
        values -> append(3) => grown
        grown -> capacity => allocated
    }
    """ => source6
    "owning-transform-rejects-promotion" -> inspect(source6, [Query { label: "main", name: "", line: 0 }])
    """
    main {
        true -> if {
            [1, 2] => first
        } else {
            [3; 4] => second
        }
    }
    """ => source7
    "nested-branch-slot-reuse" -> inspect(source7, [Query { label: "main", name: "", line: 0 }])
    """
    local: -> Int {
        [1, 2] => values
        values[0]
    }
    main {
        local() => first
    }
    """ => source8
    "ordinary-function-frame" -> inspect(source8, [Query { label: "main", name: "", line: 0 }, Query { label: "function:local@1", name: "local", line: 1 }])
    """
    take values: move [Int; ~] -> Int {
        values -> len
    }
    main {
        [1, 2; ~] => values
        values -> take => count
    }
    """ => source9
    "owned-input-rejects-promotion" -> inspect(source9, [Query { label: "main", name: "", line: 0 }, Query { label: "function:take@1", name: "take", line: 1 }])
    """
    outer: -> Int {
        inner: -> Int {
            [1, 2] => values
            values[0]
        }
        [3; 3] => outerValues
        inner() + outerValues[0]
    }
    main {
        outer() => result
    }
    """ => source10
    "nested-function-frame-boundary" -> inspect(source10, [Query { label: "main", name: "", line: 0 }, Query { label: "function:inner@2", name: "inner", line: 2 }, Query { label: "function:outer@1", name: "outer", line: 1 }])
    """
    combine left: Int, right: Int -> Int => left + right
    main {
        1 -> combine(true -> if {
            2 => first
            first
        } else {
            3 => second
            second
        }) => answer
    }
    """ => source11
    "additional-argument-nested-scopes" -> inspect(source11, [Query { label: "main", name: "", line: 0 }, Query { label: "function:combine@1", name: "combine", line: 1 }])
    """
    main {
        2 -> when {
            == 1 => 10
            else => 20
        } => answer
    }
    """ => source12
    "inline-when-results" -> inspect(source12, [Query { label: "main", name: "", line: 0 }])
    """
    main {
        1..3 -> fold 0 total, item {
            total + item => next
            next
        } => answer
    }
    """ => source13
    "fold-result-unit" -> inspect(source13, [Query { label: "main", name: "", line: 0 }])
    """
    main {
        "value=$(true -> if { 2 } else { 3 })" -> println
    }
    """ => source14
    "interpolation-if-result-units" -> inspect(source14, [Query { label: "main", name: "", line: 0 }])
    """
    # Result-producing block functions compose as ordinary pipeline stages.
    map value: Int -> Int block item: Int -> Int {
        value -> yield
    }
    
    filter value: Int -> Int block item: Int -> Bool {
        value -> yield => accepted
        accepted -> if { value } else { 0 }
    }
    
    tap value: Int -> Int block item: Int {
        value -> yield
        value
    }
    
    main {
        5
            -> map { it * 3 }
            -> tap { "tap=$it" -> println }
            -> filter { it > 10 }
            => result
    
        "result=$result" -> println
    }
    """ => source15
    "frozen-result-block-pipeline-source" -> inspect(source15, [Query { label: "main", name: "", line: 0 }])
    """
    main {
        0 => counter!
        counter! < 1 -> while {
            counter! + 1 => counter!
        }
        counter! => answer
    }
    """ => source16
    "while-statement-and-reassignment" -> inspect(source16, [Query { label: "main", name: "", line: 0 }])
    """
    main {
        2 -> when {
            == 1 {
                10 => one
                one
            }
            else {
                20 => other
                other
            }
        } => answer
    }
    """ => source17
    "block-when-results" -> inspect(source17, [Query { label: "main", name: "", line: 0 }])
    """
    plus value: Int, delta: Int -> Int => value + delta
    map value: Int -> Int block item: Int -> Int {
        value -> yield
    }
    main {
        5
            -> plus(true -> if {
                2 => increment
                increment
            } else { 3 })
            -> map { it * 2 }
            => result
    }
    """ => source18
    "block-pipeline-additional-argument" -> inspect(source18, [Query { label: "main", name: "", line: 0 }, Query { label: "function:plus@1", name: "plus", line: 1 }])
    """
    main {
        [1, 2] => values
        "$(values[0])" -> println
        [3; 4] => later
    }
    """ => source19
    "interpolated-owner-last-use" -> inspect(source19, [Query { label: "main", name: "", line: 0 }])
    """
    main {
        [1, 2] => values
        true -> if {
            values[0] -> println
        } else {
            0 -> println
        }
        [3; 4] => later
    }
    """ => source20
    "nested-owner-containing-unit" -> inspect(source20, [Query { label: "main", name: "", line: 0 }])
    """
    main {
        [1, 2] => values!
        3 => values![0]
        [4; 4] => later
    }
    """ => source21
    "mutable-owner-write-last-use" -> inspect(source21, [Query { label: "main", name: "", line: 0 }])
}
