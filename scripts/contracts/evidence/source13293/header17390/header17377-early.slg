makeValues: -> [Int; ~] {
    [Int; 4~] => values!
    values! -> push(7)
    values!
}

readFirst early: Bool -> Int {
    makeValues() => values!
    values! -> push(8)
    early -> if {
        values![0] -> return
    }
    values![0]
}

main {
    true -> readFirst -> println
    false -> readFirst -> println
}
