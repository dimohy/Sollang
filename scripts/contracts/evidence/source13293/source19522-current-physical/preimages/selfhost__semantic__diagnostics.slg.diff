+
+# Match C#: first reject unbound owners, then check push finality, place and arity.
+heapFlowContract prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, sourceModule: Int, flowAst: Int, flowSource: Int, typesByAst: ref [Int; ~], sourceAsts: ref [Int; ~], symbolsByAst: ref [Int; ~], firstChild: ref [Int; ~], nextChild: ref [Int; ~], previous: ExpressionOperandDiagnostic -> ExpressionOperandDiagnostic {
+    flowSource < 0 -> if { previous -> return }
+    resolved.types -> typeIds.materializedReadTypeId(typesByAst[flowSource]) => receiverTypeId
+    receiverTypeId < 0 or receiverTypeId >= (resolved.types -> len)
+        -> if { previous -> return }
+    resolved.types[receiverTypeId] => receiverType
+    not (receiverType.kind == 7 and receiverType.origin == 4 and receiverType.symbol == 7)
+        -> if { previous -> return }
+    prepared.package.ranges[sourceModule] => range
+    range.astStart + flowAst => globalFlow
+    prepared.callIndexByAst[globalFlow] => callIndex
+    -1 => targetPath!
+    -1 => targetCall!
+    firstChild[globalFlow] => child!
+    child! >= 0 -> while {
+        child! != flowSource -> if {
+            prepared.package.nodes[child!] => candidate
+            candidate.kind == 16 -> if { child! => targetPath! }
+            candidate.kind == 11 -> if {
+                child! => targetCall!
+                firstChild[child!] => nested!
+                nested! >= 0 -> while {
+                    prepared.package.nodes[nested!] => path
+                    path.kind == 16 and path.start == candidate.start
+                        -> if { nested! => targetPath! }
+                    nextChild[nested!] => nested!
+                }
+            }
+        }
+        nextChild[child!] => child!
+    }
+    targetPath! < 0 -> if { previous -> return }
+    prepared.package.nodes[targetPath!] => target
+    target.payloadToken < 0
+        -> if { previous -> return }
+    prepared.package.tokens[range.tokenStart + target.payloadToken] => token
+    prepared.package.sources[sourceModule] -> slice(token.span.start, token.span.length) => name
+    prepared.package.nodes[flowSource] => receiver
+    flowSource => root!
+    flowSource => ownerRoot!
+    prepared.package.nodes[ownerRoot!].kind == 36
+        -> while {
+            sourceAsts[ownerRoot!] => ownerSource
+            ownerSource < 0 -> if { previous -> return }
+            range.astStart + ownerSource => ownerRoot!
+        }
+    target.tokenCount == 1 and (name == "len" or name == "byte" or name == "slice") => readonlyTarget!
+    false => consumingTarget!
+    false => declaredTarget!
+    callIndex >= 0 and prepared.calls[callIndex].functionSymbol >= 0
+        -> if {
+            true => declaredTarget!
+            false => readonlyTarget!
+            prepared.calls[callIndex] => call
+            prepared.package -> semanticContext.functionParameterSymbolsInSourceOrder(call.targetSourceModule, call.functionSymbol) => parameters
+            (parameters -> len) > 0 -> if {
+                prepared.package.ranges[call.targetSourceModule] => targetRange
+                prepared.package.symbols[targetRange.symbolStart + parameters[0]] => parameter
+                parameter.flags % 4 == 0 => readonlyTarget!
+                parameter.flags % 4 == 1 => consumingTarget!
+            }
+        }
+    not readonlyTarget! and not consumingTarget!
+        and prepared.package.nodes[ownerRoot!].kind != 15
+        and prepared.package.nodes[ownerRoot!].kind != 16
+        -> if {
+            receiver.start => ownerOffset!
+            receiver.kind == 36 -> if {
+                prepared.package -> ordinaryFieldDiagnosticOffset(sourceAsts, sourceModule, flowSource - range.astStart) => ownerOffset!
+            }
+            ExpressionOperandDiagnostic { code: 73, sourceModule: sourceModule, astNode: flowAst, operandAst: targetPath! - range.astStart, operatorKind: 2, locationOffset: ownerOffset!, operandTypeSymbol: -1, operandTypeId: receiverTypeId, firstTypeId: -1 } => diagnostic
+            prepared.package -> expressionDiagnosticPrecedes(resolved.fields, diagnostic, previous)
+                -> if { diagnostic -> return }
+            previous -> return
+        }
+    declaredTarget! or target.tokenCount != 1 or name != "push"
+        -> if { previous -> return }
+    receiver.kind == 36 -> if {
+        sourceAsts[flowSource] => receiverSource
+        receiverSource >= 0 -> if { range.astStart + receiverSource => root! } else { -1 => root! }
+    }
+    0 => failure!
+    0 => failureKind!
+    receiver.start => offset!
+    receiver.kind == 36 -> if {
+        prepared.package -> ordinaryFieldDiagnosticOffset(sourceAsts, sourceModule, flowSource - range.astStart) => offset!
+    }
+    prepared.package.nodes[globalFlow] => flow
+    flow.parent >= 0 -> if {
+        prepared.package.nodes[range.astStart + flow.parent] => parent
+        parent.kind == 10 and parent.start == flow.start
+            -> if {
+                60 => failure!
+                1 => failureKind!
+                target.start => offset!
+            }
+    }
+    failure! == 0 and (root! < 0 or prepared.package.nodes[root!].kind != 15)
+        -> if { 62 => failure! }
+    failure! == 0 and root! >= 0 and symbolsByAst[root!] >= 0
+        -> if {
+            not (prepared.package -> mutableBorrowOwnerSymbol(sourceModule, prepared.package.symbols[symbolsByAst[root!]]))
+                -> if { 61 => failure! }
+        }
+    failure! == 0 -> if {
+        0 => argumentCount!
+        targetCall! >= 0 -> if {
+            firstChild[targetCall!] => argument!
+            argument! >= 0 -> while {
+                argument! != targetPath! -> if { argumentCount! + 1 => argumentCount! }
+                nextChild[argument!] => argument!
+            }
+        }
+        argumentCount! != 1 -> if {
+            60 => failure!
+            target.start => offset!
+        }
+    }
+    failure! == 0 -> if { previous -> return }
+    ExpressionOperandDiagnostic {
+        code: failure!, sourceModule: sourceModule,
+        astNode: flowSource - range.astStart, operandAst: root! - range.astStart,
+        operatorKind: -252, locationOffset: offset!,
+        operandTypeSymbol: failureKind!, operandTypeId: receiverTypeId, firstTypeId: -1
+    } => diagnostic
+    prepared.package -> expressionDiagnosticPrecedes(resolved.fields, diagnostic, previous)
+        -> if { diagnostic } else { previous }
+}
