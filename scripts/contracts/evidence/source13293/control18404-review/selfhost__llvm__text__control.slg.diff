+# Shared conditional value emission for direct bodies and retained interpolation.
+emitConditionalValue controlIndex: Int, ownerIndex: Int, emissionOrder: ref [Int; ~], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
+    context.ir[controlIndex] => control
+    control.operand0 -> aggregateValueIndex(context, state) => conditionalConditionIndex
+    context.ir[conditionalConditionIndex] => conditionalCondition
+    controlIndex -> irValueUsed(ownerIndex, context, state) => conditionalValueUsed
+    (conditionalCondition.kind == 8 and (conditionalCondition.opcode == -25 or conditionalCondition.opcode == -24) or (conditionalCondition.kind == 7 and conditionalCondition.opcode == -26)) => conditionalShortCircuit
+    conditionalShortCircuit -> if {
+        WhileBranchRequest { whileIndex: controlIndex, ownerIndex: ownerIndex, conditionIndex: conditionalConditionIndex } -> emitWhileBranch(emissionOrder, context, state)
+        "while$(controlIndex)_body:" -> println
+        control -> writeIfShortCircuitBodyTarget(controlIndex)
+        "while$(controlIndex)_exit:" -> println
+        control -> writeIfShortCircuitExitTarget(controlIndex)
+    } else {
+        "  br i1 " -> print
+        conditionalCondition.kind == 4 -> if {
+            conditionalCondition -> sourceToken(context, state) => conditionalConditionToken
+            (context.sources[conditionalCondition.sourceModule] -> byte(conditionalConditionToken.span.start)) == 116
+                -> if { "1" -> print } else { "0" -> print }
+        } else { "%v$conditionalConditionIndex" -> print }
+        control -> writeIfDirectBranchTargets(controlIndex)
+    }
+    "if$(controlIndex)_then:" -> println
+    control.operand1 -> emitRegion(emissionOrder, context, state)
+    conditionalValueUsed and not (control.typeOrigin == 1 and control.typeSymbol == 0) and control.nextOperand >= 0
+        -> if {
+            control.operand1 -> regionResultValueIndex(context, state) => entryThenStoreIndex
+            control -> emitIfResultStore(entryThenStoreIndex, ownerIndex, controlIndex, 0, context, state)
+        }
+    OwnedDropRequest { regionIndex: control.operand1, beforeAst: -1, edgeIndex: controlIndex * 10 + 1, transferredSymbol: -1 } -> emitOwnedDrops([Int; ~], context, state)
+    "  br label %if$(controlIndex)_merge" -> println
+    control.nextOperand >= 0 -> if {
+        "if$(controlIndex)_else:" -> println
+        control.nextOperand -> emitRegion(emissionOrder, context, state)
+        conditionalValueUsed and not (control.typeOrigin == 1 and control.typeSymbol == 0)
+            -> if {
+                control.nextOperand -> regionResultValueIndex(context, state) => entryElseStoreIndex
+                control -> emitIfResultStore(entryElseStoreIndex, ownerIndex, controlIndex, 1, context, state)
+            }
+        OwnedDropRequest { regionIndex: control.nextOperand, beforeAst: -1, edgeIndex: controlIndex * 10 + 2, transferredSymbol: -1 } -> emitOwnedDrops([Int; ~], context, state)
+        "  br label %if$(controlIndex)_merge" -> println
+    }
+    "if$(controlIndex)_merge:" -> println
+    conditionalValueUsed and not (control.typeOrigin == 1 and control.typeSymbol == 0) and control.nextOperand >= 0
+        -> if {
+            "  %v$(controlIndex) = load " -> print
+            control -> writeIrType(context, state)
+            ", ptr %if$(controlIndex)_result, align " -> print
+            control -> storageAlign(context, state) -> writeDecimalLine
+        }
+}
