+# A substituted field retains its canonical label identity but has no new
+# source annotation. Reuse the already normalized label only when every
+# matching identity has identical bytes; ambiguity is rejected.
+appendDerivedProductLabel typeIndex: Int, types: ref [typeIds.SemanticType; ~], starts: ref [Int; ~], lengths: ref [Int; ~], words: mut [UInt64; ~] -> Bool {
+    types[typeIndex] => type
+    -1 => selected!
+    0 => selectedLength!
+    0 => previous!
+    previous! < typeIndex -> while {
+        types[previous!] => candidate
+        candidate.kind == 11 and candidate.length == type.length and candidate.lengthHash == type.lengthHash
+            -> if {
+                lengths[previous!] => length
+                length <= 0 -> if { false -> return }
+                starts[previous!] => start
+                selected! < 0 -> if {
+                    start => selected!
+                    length => selectedLength!
+                } else {
+                    length != selectedLength! -> if { false -> return }
+                    0 => byte!
+                    byte! < length -> while {
+                        words[start + byte!] != words[selected! + byte!]
+                            -> if { false -> return }
+                        byte! + 1 => byte!
+                    }
+                }
+            }
+        previous! + 1 => previous!
+    }
+    selected! < 0 -> if { false -> return }
+    0 => byte!
+    byte! < selectedLength! -> while {
+        words -> push(words[selected! + byte!])
+        byte! + 1 => byte!
+    }
+    true
+}
