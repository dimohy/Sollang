namespace sollang.compiler.semantic.interpolation_inference

import sollang.compiler.ast as ast
import sollang.compiler.ir.typed as typedIr
import sollang.compiler.ir.interpolation as interpolation
import sollang.compiler.ir.stream as streamIr
import sollang.compiler.lexer as lexer
import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.diagnostics as semanticDiagnostics
import sollang.compiler.semantic.expression_type_ids as expressionTypeIds
import sollang.compiler.semantic.modules as modules
import sollang.compiler.semantic.numeric_literal_range as numericLiteralRange
import sollang.compiler.semantic.symbols as symbols
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.semantic.type_terms as typeTerms
import sollang.compiler.syntax as syntax
import syntax.generated.slg as grammar

public struct InterpolationBinaryArithmeticDiagnostic {
    public code: Int
    public leftTypeId: Int
    public rightTypeId: Int
}

# One contextual literal contract is consumed by both diagnostics and LLVM.
public struct InterpolationNumericLiteralContext {
    public typeId: Int
    # -1 no contextual literal, 0 out of range, 1 valid, 2 Unicode surrogate.
    public status: Int
}

public struct CollectionMembershipDiagnostic {
    # 0 valid/unresolved, 1 BitSet arity, 2 Set arity, 3 BitSet index, 4 Set element.
    public code: Int
    public expectedTypeId: Int
    public actualTypeId: Int
    public argumentNode: Int
}

public struct InterpolationBinaryComparisonDiagnostic {
    public code: Int
    public leftTypeId: Int
    public rightTypeId: Int
    public textEquality: Bool
}

struct InterpolationBinaryOperands {
    leftBuiltin: Int
    rightBuiltin: Int
    leftTypeId: Int
    rightTypeId: Int
}

public struct SemanticInterpolationCallTarget {
    public sourceModule: Int
    public symbol: Int
    public receiverType: Int
    public ownerType: Int
    public traitModule: Int
    public traitSymbol: Int
    public expectedAdditionalArguments: Int
    # -1 unresolved, 0 visible method, 1 inaccessible method, 2 ambiguous,
    # 3 visible method with an invalid additional argument count.
    public status: Int
}

public struct InterpolationCallArgumentDiagnostic {
    # 0 valid, 1 incompatible concrete argument, 2 numeric literal outside its target range.
    public code: Int
    public sourceModule: Int
    public callNode: Int
    public argumentNode: Int
    public targetSourceModule: Int
    public functionSymbol: Int
    public parameterSymbol: Int
    public parameterOrdinal: Int
    public expectedTypeId: Int
    public actualTypeId: Int
    public line: Int
    public column: Int
    public literalNode: Int
    public literalTargetSymbol: Int
}

emptyCallArgumentDiagnostic: -> InterpolationCallArgumentDiagnostic => InterpolationCallArgumentDiagnostic {
    code: 0
    sourceModule: -1
    callNode: -1
    argumentNode: -1
    targetSourceModule: -1
    functionSymbol: -1
    parameterSymbol: -1
    parameterOrdinal: -1
    expectedTypeId: -1
    actualTypeId: -1
    line: 0
    column: 0
    literalNode: -1
    literalTargetSymbol: -1
}

# Commit argument failures before a consumer checks the call's result type.
public callArgumentDiagnosticsByNode prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, pointerBitWidth: Int -> [InterpolationCallArgumentDiagnostic; ~] {
    [InterpolationCallArgumentDiagnostic; ~] => diagnostics!
    prepared.interpolations -> each node {
        diagnostics! -> push(emptyCallArgumentDiagnostic())
    }
    0 => callIndex!
    callIndex! < (prepared.interpolations -> len)
        -> while {
            resolved.interpolationCallArguments -> each argument {
                argument.callNode == callIndex! and diagnostics![callIndex!].code == 0
                    -> if {
                        resolved.types[argument.expectedTypeId] => expected
                        resolved.types[argument.actualTypeId] => actual
                        expected.status == 0 and actual.status == 0
                            and not expected.containsParameter and not actual.containsParameter
                            -> if {
                                prepared.interpolations[argument.argumentNode] => value
                                argument.expectedTypeId => literalTypeId!
                                argument.inputFromFlow and expected.kind == 1 and expected.origin == 1
                                    and expected.symbol >= 19 and expected.symbol <= 22
                                    -> if { -1 => literalTypeId! }
                                argument.argumentNode => literalIndex!
                                value.kind == 9 -> if {
                                    value.typeSymbol -> numericBuiltinSymbol -> if {
                                        resolved.types -> typeIds.builtinTypeId(value.typeSymbol) => literalTypeId!
                                        value.operand0 => literalIndex!
                                    }
                                }
                                literalIndex! => literalExpression
                                false => negative!
                                literalIndex! >= 0 and prepared.interpolations[literalIndex!].kind == 2
                                    and prepared.interpolations[literalIndex!].opcode == grammar.tokenIdMinus()
                                    -> if {
                                        true => negative!
                                        prepared.interpolations[literalIndex!].operand0 => literalIndex!
                                    }
                                0 => code!
                                argument.argumentNode => diagnosticNode!
                                -1 => diagnosticLiteralNode!
                                argument.expectedTypeId => diagnosticType!
                                literalIndex! >= 0 and literalTypeId! >= 0
                                    and prepared.interpolations[literalIndex!].kind == 0
                                    and resolved.types[literalTypeId!].kind == 1 and resolved.types[literalTypeId!].origin == 1
                                    and (resolved.types[literalTypeId!].symbol -> numericBuiltinSymbol)
                                    -> if {
                                        prepared.interpolations[literalIndex!] => literal
                                        prepared.package.sources[argument.sourceModule] -> len => sourceLength
                                        prepared.package.sources[argument.sourceModule] -> slice(0, sourceLength) => source
                                        resolved.types[literalTypeId!].symbol -> typeIds.canonicalBuiltinSymbol => symbol
                                        true => valid!
                                        (source -> byte(literal.payloadStart)) == '\'' -> if {
                                            false => valid!
                                            syntax.SourceSpan { fileId: argument.sourceModule, start: literal.payloadStart, length: literal.payloadLength } => span
                                            source -> syntax.decodeCharacterLiteral(span) -> when {
                                                Some(scalar) {
                                                    symbol >= 19 and symbol <= 22 -> if { true => valid! } else {
                                                        scalar -> numericLiteralRange.characterLiteralStatus(symbol, negative!) => status
                                                        status == 1 => valid!
                                                    }
                                                }
                                                None { }
                                            }
                                        } else { symbol >= 19 and symbol <= 22 -> if {
                                                source -> numericLiteralRange.floatingLiteralWithinRange(literal.payloadStart, literal.payloadStart + literal.payloadLength, symbol) => valid!
                                            } else {
                                                source -> numericLiteralRange.literalUsesFloatingSyntax(literal.payloadStart, literal.payloadStart + literal.payloadLength) => floating
                                                not floating -> if {
                                                    source -> numericLiteralRange.integerLiteralStatus(literal.payloadStart, literal.payloadStart + literal.payloadLength, symbol, pointerBitWidth, negative!, false, 0, 1) => status
                                                    status == 1 => valid!
                                                }
                                        } }
                                        not valid! -> if {
                                            2 => code!
                                            literalTypeId! => diagnosticType!
                                            literalExpression => diagnosticNode!
                                            literalExpression => diagnosticLiteralNode!
                                        }
                                    }
                                code! == 0 and not (resolved.types -> typeIds.functionArgumentCompatible(argument.actualTypeId, argument.expectedTypeId))
                                    -> if {
                                        1 => code!
                                        argument.parameterOrdinal == 0 -> if { argument.callNode => diagnosticNode! }
                                    }
                                code! > 0 -> if {
                                    prepared.package.sources[argument.sourceModule] -> len => sourceLength
                                    prepared.package.sources[argument.sourceModule] -> slice(0, sourceLength) => source
                                    prepared.interpolations -> semanticDiagnostics.interpolationSourceOffsetLocation(source, diagnosticNode!, prepared.interpolations[diagnosticNode!].payloadStart) => location
                                    InterpolationCallArgumentDiagnostic {
                                        code: code!
                                        sourceModule: argument.sourceModule
                                        callNode: argument.callNode
                                        argumentNode: argument.argumentNode
                                        targetSourceModule: argument.targetSourceModule
                                        functionSymbol: argument.functionSymbol
                                        parameterSymbol: argument.parameterSymbol
                                        parameterOrdinal: argument.parameterOrdinal
                                        expectedTypeId: diagnosticType!
                                        actualTypeId: argument.actualTypeId
                                        line: location.line
                                        column: location.column
                                        literalNode: diagnosticLiteralNode!
                                        literalTargetSymbol: value.kind == 9 -> if { value.typeSymbol } else { -1 }
                                    } => diagnostics![callIndex!]
                                }
                            }
                    }
            }
            callIndex! + 1 => callIndex!
        }
    diagnostics!
}

public firstCallArgumentDiagnostic prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, pointerBitWidth: Int -> InterpolationCallArgumentDiagnostic {
    prepared -> callArgumentDiagnosticsByNode(resolved, pointerBitWidth) => diagnostics
    diagnostics -> each diagnostic {
        diagnostic.code > 0 -> if { diagnostic -> return }
    }
    emptyCallArgumentDiagnostic()
}

# Compatibility entry point for numeric diagnostic probes.
public firstCallNumericDiagnostic prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet, pointerBitWidth: Int -> InterpolationCallArgumentDiagnostic {
    prepared -> firstCallArgumentDiagnostic(resolved, pointerBitWidth)
}

public struct LocalEnumMemberDecision {
    # 0 not an enum member, 1 missing variant, 2 payload required, 3 value.
    public status: Int
    public typeId: Int
}

public struct ResultPropagationDecision {
    # -1 unrelated or unresolved operand; 0 valid; 1 non-Result operand;
    # 2 non-Result function; 3 different error type; 4 owned source not consumable.
    public status: Int
    public operandTypeId: Int
    public functionTypeId: Int
    public okTypeId: Int
    public operandErrorTypeId: Int
    public functionErrorTypeId: Int
}

# Interpolation fragments have no ordinary AST expression node. Resolve their
# prepared node identities against the same semantic types and typed bindings
# used by the rest of the compiler before LLVM emission begins.
sourceModuleAt prepared: ref semanticContext.SemanticSnapshot, nodeIndex: Int -> Int {
    -1 => sourceModule!
    prepared.interpolationRanges -> each range {
        nodeIndex >= range.nodeStart and nodeIndex < range.nodeStart + range.nodeCount
            -> if { range.sourceModule => sourceModule! }
    }
    sourceModule!
}

interpolationLexicalTypeFromIr prepared: ref semanticContext.SemanticSnapshot, ir: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], sourceModule: Int, node: interpolation.InterpolationNode -> Int {
    node.symbol < 0 or sourceModule < 0 or sourceModule >= (prepared.package.ranges -> len)
        -> if { -1 -> return }
    prepared.package.ranges[sourceModule] => sourceRange
    -1 => bindingTypeId!
    UIntSize(0) => bindingStart!
    0 => irIndex!
    irIndex! < (ir -> len) -> while {
        ir[irIndex!] => candidate
        (candidate.kind == 17 or candidate.kind == 29)
            and candidate.sourceModule == sourceModule and candidate.symbol == node.symbol
            and candidate.astNode >= 0 and candidate.astNode < sourceRange.astCount
            and candidate.typeId >= 0 -> if {
                prepared.package.nodes[sourceRange.astStart + candidate.astNode].start => candidateStart
                candidateStart <= node.payloadStart
                    and (bindingTypeId! < 0 or candidateStart > bindingStart!)
                    -> if {
                        candidate.typeId => bindingTypeId!
                        candidateStart => bindingStart!
                    }
            }
        irIndex! + 1 => irIndex!
    }
    bindingTypeId! >= 0 and bindingTypeId! < (types -> len)
        -> if { types -> typeIds.materializedReadTypeId(bindingTypeId!) -> return }
    -1
}



expressionTypeId prepared: ref semanticContext.SemanticSnapshot, plan: ref streamIr.StreamPlan, bindingFacts: ref expressionTypeIds.ExpressionTypeIdSet, ir: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], fields: ref [typeIds.NominalField; ~], sourceModule: Int, nodeIndex: Int -> Int {
    nodeIndex < 0 or nodeIndex >= (prepared.interpolations -> len)
        -> if { -1 -> return }
    prepared.interpolations[nodeIndex] => node
    (node.kind == 0 or node.kind == 2 or node.kind == 16) and nodeIndex < (bindingFacts.interpolationContextualStructTypeByNode -> len)
        and bindingFacts.interpolationContextualStructTypeByNode[nodeIndex] >= 0
        -> if { bindingFacts.interpolationContextualStructTypeByNode[nodeIndex] -> return }
    node.kind == 0 -> if {
        prepared -> sourceModuleAt(nodeIndex) => literalModule
        literalModule >= 0 -> if {
            prepared.package.sources[literalModule] -> slice(node.payloadStart, node.payloadLength) => literalText
            literalText -> numericLiteralRange.literalUsesFloatingSyntax(0, node.payloadLength)
                -> if { types -> typeIds.builtinTypeId(20) -> return }
        }
        types -> typeIds.builtinTypeId(2) -> return
    }
    node.kind == 1 -> if {
        nodeIndex < (bindingFacts.interpolationLexicalTypeByNode -> len)
            and bindingFacts.interpolationLexicalTypeByNode[nodeIndex] >= 0
            and bindingFacts.interpolationLexicalTypeByNode[nodeIndex] < (types -> len)
            and not types[bindingFacts.interpolationLexicalTypeByNode[nodeIndex]].containsParameter
            -> if { bindingFacts.interpolationLexicalTypeByNode[nodeIndex] -> return }
        # Generic source facts remain provisional until the caller publishes
        # its concrete binding; all consumers read that existing IR authority.
        prepared -> interpolationLexicalTypeFromIr(ir, types, sourceModule, node) -> return
    }
    node.kind == 4 -> if { types -> typeIds.builtinTypeId(23) -> return }
    node.kind == 14 and nodeIndex < (bindingFacts.interpolationContextualStructTypeByNode -> len)
        -> if { bindingFacts.interpolationContextualStructTypeByNode[nodeIndex] -> return }
    node.kind == 6 -> if {
        nodeIndex < (bindingFacts.interpolationCallTypeByNode -> len)
            and bindingFacts.interpolationCallTypeByNode[nodeIndex] >= 0
            -> if { bindingFacts.interpolationCallTypeByNode[nodeIndex] -> return }
        prepared -> methodFlowFallback(plan, bindingFacts, ir, types, fields, nodeIndex) => methodFallback
        methodFallback -> if {
            prepared -> flowCallTargetAt(plan, bindingFacts, prepared.interpolations, ir, types, fields, nodeIndex, true) => target
            target >= 0 and target < (ir -> len) -> if {
                ir[target].typeId >= 0 and ir[target].typeId < (types -> len)
                    -> if { ir[target].typeId -> return }
            }
            -1 -> return
        }
        prepared -> intrinsicFlowResultBuiltinSymbol(plan, bindingFacts, prepared.interpolations, ir, types, fields, sourceModule, nodeIndex) => builtin
        builtin >= 0 -> if { types -> typeIds.builtinTypeId(builtin) -> return }
    }
    node.kind == 2 and node.operand0 >= 0 -> if {
        nodeIndex < (bindingFacts.interpolationUnaryTypeByNode -> len)
            and bindingFacts.interpolationUnaryTypeByNode[nodeIndex] >= 0
            -> if { bindingFacts.interpolationUnaryTypeByNode[nodeIndex] -> return }
        prepared -> expressionTypeId(plan, bindingFacts, ir, types, fields, sourceModule, node.operand0) => operandTypeId
        operandTypeId >= 0 and operandTypeId < (types -> len)
            -> if {
                types[operandTypeId] => operandType
                operandType.kind == 1 and operandType.origin == 1
                    -> if {
                        node.opcode == -26 and operandType.symbol == 23
                            -> if { operandTypeId -> return }
                        node.opcode == grammar.tokenIdMinus()
                            and (operandType.symbol -> typeIds.isSignedNumericBuiltinSymbol)
                            -> if { operandTypeId -> return }
                    }
            }
    }
    node.kind == 7 and node.operand0 >= 0 -> if {
        nodeIndex < (bindingFacts.interpolationIndexedTypeByNode -> len)
            and bindingFacts.interpolationIndexedTypeByNode[nodeIndex] >= 0
            -> if { bindingFacts.interpolationIndexedTypeByNode[nodeIndex] -> return }
        prepared -> expressionTypeId(plan, bindingFacts, ir, types, fields, sourceModule, node.operand0) => ownerTypeId!
        ownerTypeId! >= 0 and ownerTypeId! < (types -> len) and types[ownerTypeId!].kind == 8
            -> if { types[ownerTypeId!].first => ownerTypeId! }
        ownerTypeId! >= 0 and ownerTypeId! < (types -> len)
            -> if {
                types[ownerTypeId!] => ownerType
                ownerType.kind == 2 or ownerType.kind == 3 or ownerType.kind == 4 or ownerType.kind == 12
                    -> if { ownerType.first -> return }
                ownerType.kind == 5 or ownerType.kind == 13
                    -> if { ownerType.second -> return }
                ownerType.kind == 1 and ownerType.origin == 1
                    -> if {
                        ownerType.symbol == 16 -> if { types -> typeIds.builtinTypeId(1) -> return }
                        ownerType.symbol == 17 or ownerType.symbol == 18
                            -> if { types -> typeIds.builtinTypeId(8) -> return }
                    }
            }
    }
    node.kind == 5 and node.operand0 >= 0 -> if {
        nodeIndex < (bindingFacts.interpolationMemberTypeByNode -> len)
            and bindingFacts.interpolationMemberTypeByNode[nodeIndex] >= 0
            -> if { bindingFacts.interpolationMemberTypeByNode[nodeIndex] -> return }
        prepared -> expressionTypeId(plan, bindingFacts, ir, types, fields, sourceModule, node.operand0) => ownerTypeId
        ownerTypeId >= 0 -> if {
            prepared -> expressionTypeIds.memberFieldIndex(types, fields, sourceModule, ownerTypeId, nodeIndex) => fieldIndex
            fieldIndex >= 0 -> if { fields[fieldIndex].fieldType -> return }
            prepared -> flowCallTargetAt(plan, bindingFacts, prepared.interpolations, ir, types, fields, nodeIndex, false) => methodIndex
            methodIndex >= 0 and methodIndex < (ir -> len)
                -> if { ir[methodIndex].typeId -> return }
        }
    }
    node.kind == 3 and node.operand0 >= 0 and node.operand1 >= 0
        and (node.opcode == -24 or node.opcode == -25)
        -> if {
            prepared -> expressionTypeId(plan, bindingFacts, ir, types, fields, sourceModule, node.operand0) => leftTypeId
            prepared -> expressionTypeId(plan, bindingFacts, ir, types, fields, sourceModule, node.operand1) => rightTypeId
            leftTypeId >= 0 and leftTypeId < (types -> len)
                and rightTypeId >= 0 and rightTypeId < (types -> len)
                -> if {
                    types[leftTypeId] => leftType
                    types[rightTypeId] => rightType
                    leftType.kind == 1 and leftType.origin == 1 and leftType.symbol == 23
                        and rightType.kind == 1 and rightType.origin == 1 and rightType.symbol == 23
                        -> if { leftTypeId -> return }
                }
        }
    node.kind == 3 and node.operand0 >= 0 and node.operand1 >= 0
        and (node.opcode == grammar.tokenIdEqualEqual() or node.opcode == grammar.tokenIdBangEqual()
        or node.opcode == grammar.tokenIdLess() or node.opcode == grammar.tokenIdLessEqual()
        or node.opcode == grammar.tokenIdGreater() or node.opcode == grammar.tokenIdGreaterEqual())
        -> if {
            prepared -> comparisonDecision(plan, bindingFacts, ir, types, fields, sourceModule, nodeIndex) => decision
            decision.code == 0 and decision.leftTypeId >= 0 and decision.rightTypeId >= 0
                -> if { types -> typeIds.builtinTypeId(23) -> return }
        }
    node.kind == 3 and node.operand0 >= 0 and node.operand1 >= 0
        and (node.opcode == grammar.tokenIdPlus() or node.opcode == grammar.tokenIdMinus()
        or node.opcode == grammar.tokenIdStar() or node.opcode == grammar.tokenIdSlash()
        or node.opcode == grammar.tokenIdPercent())
        -> if {
            prepared -> arithmeticDecision(plan, bindingFacts, ir, types, fields, sourceModule, nodeIndex) => decision
            decision.code == 0 and decision.leftTypeId >= 0 and decision.rightTypeId >= 0
                -> if { decision.leftTypeId -> return }
        }
    (node.kind == 8 or node.kind == 10 or node.kind == 15) and nodeIndex < (bindingFacts.interpolationCallTypeByNode -> len)
        and bindingFacts.interpolationCallTypeByNode[nodeIndex] >= 0
        -> if { bindingFacts.interpolationCallTypeByNode[nodeIndex] -> return }
    node.kind == 8 and node.symbol >= 0 -> if {
        prepared -> flowCallTargetAt(plan, bindingFacts, prepared.interpolations, ir, types, fields, nodeIndex, false) => target
        target >= 0 and target < (ir -> len) and ir[target].typeId >= 0 and ir[target].typeId < (types -> len)
            -> if { ir[target].typeId -> return }
    }
    node.kind == 10 and node.operand0 >= 0 -> if {
        prepared -> flowCallTargetAt(plan, bindingFacts, prepared.interpolations, ir, types, fields, nodeIndex, false) => target
        target >= 0 and target < (ir -> len) -> if {
            ir[target].typeId >= 0 and ir[target].typeId < (types -> len)
                -> if { ir[target].typeId -> return }
        }
    }
    node.kind == 11 and node.operand0 >= 0 -> if {
        prepared -> expressionTypeId(plan, bindingFacts, ir, types, fields, sourceModule, node.operand0) => resultTypeId
        resultTypeId >= 0 and resultTypeId < (types -> len)
            -> if {
                types[resultTypeId] => resultType
                resultType.kind == 7 and resultType.origin == 4 and resultType.symbol == 1
                    -> if { resultType.first -> return }
            }
    }
    node.kind == 9 and node.typeSymbol >= 0 -> if {
        types -> typeIds.builtinTypeId(node.typeSymbol) -> return
    }
    -1
}

# A nominal initializer is validated after expression inference. The early
# pass retains unknown-type and duplicate-name failures, while this pass checks
# each field value in source order before the missing-field check.
public nominalInitializerDiagnosticByNode prepared: ref semanticContext.SemanticSnapshot, plan: ref streamIr.StreamPlan, bindingFacts: ref expressionTypeIds.ExpressionTypeIdSet, ir: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], fields: ref [typeIds.NominalField; ~] -> [expressionTypeIds.ContextualStructDiagnostic; ~] {
    [expressionTypeIds.ContextualStructDiagnostic; ~] => diagnostics!
    bindingFacts.interpolationContextualDiagnosticByNode -> each diagnostic {
        diagnostics! -> push(diagnostic)
    }
    prepared.interpolationRanges -> each range {
        range.nodeStart => literalIndex!
        literalIndex! < range.nodeStart + range.nodeCount
            -> while {
                prepared.interpolations[literalIndex!] => literal
                literal.kind == 14 and diagnostics![literalIndex!].code == 0
                    and literalIndex! < (bindingFacts.interpolationContextualStructTypeByNode -> len)
                    -> if {
                        bindingFacts.interpolationContextualStructTypeByNode[literalIndex!] => ownerTypeId
                        ownerTypeId >= 0 -> if {
                            diagnostics![literalIndex!] => decision!
                            ownerTypeId => decision!.ownerType
                            literalIndex! + 1 => labelIndex!
                            labelIndex! < range.nodeStart + range.nodeCount and decision!.code == 0
                                -> while {
                                    prepared.interpolations[labelIndex!] => label
                                    label.parent == literalIndex! and label.kind == 13
                                        -> if {
                                            bindingFacts.interpolationContextualFieldByNode[labelIndex!] => fieldIndex
                                            fieldIndex < 0 -> if {
                                                expressionTypeIds.ContextualStructDiagnostic {
                                                    code: 5
                                                    locationNode: labelIndex!
                                                    fieldIndex: -1
                                                    actualType: -1
                                                    ownerType: ownerTypeId
                                                } => decision!
                                            } else {
                                                -1 => valueIndex!
                                                labelIndex! + 1 => valueSearch!
                                                valueSearch! < range.nodeStart + range.nodeCount and valueIndex! < 0
                                                    -> while {
                                                        prepared.interpolations[valueSearch!].parent == literalIndex!
                                                            -> if { valueSearch! => valueIndex! }
                                                        valueSearch! + 1 => valueSearch!
                                                    }
                                                valueIndex! >= 0 -> if {
                                                    prepared -> expressionTypeId(plan, bindingFacts, ir, types, fields, range.sourceModule, valueIndex!) => actualType!
                                                    prepared.interpolations[valueIndex!] => value
                                                    value.kind == 0 and fields[fieldIndex].fieldType >= 0
                                                        and fields[fieldIndex].fieldType < (types -> len)
                                                        -> if {
                                                            types[fields[fieldIndex].fieldType] => expectedType
                                                            expectedType.kind == 1 and expectedType.origin == 1
                                                                and ((expectedType.symbol >= 2 and expectedType.symbol <= 14)
                                                                or expectedType.symbol == 20 or expectedType.symbol == 21 or expectedType.symbol == 22)
                                                                -> if { fields[fieldIndex].fieldType => actualType! }
                                                        }
                                                    actualType! >= 0 -> if {
                                                        types -> typeIds.materializedReadTypeId(actualType!) => actualType!
                                                        actualType! != fields[fieldIndex].fieldType -> if {
                                                            expressionTypeIds.ContextualStructDiagnostic {
                                                                code: 4
                                                                locationNode: valueIndex!
                                                                fieldIndex: fieldIndex
                                                                actualType: actualType!
                                                                ownerType: ownerTypeId
                                                            } => decision!
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    labelIndex! + 1 => labelIndex!
                                }
                            decision!.code == 0 -> if {
                                -1 => missingField!
                                0 => candidateIndex!
                                candidateIndex! < (fields -> len) -> while {
                                    fields[candidateIndex!].status == 0 and fields[candidateIndex!].ownerType == ownerTypeId
                                        -> if {
                                            false => present!
                                            literalIndex! + 1 => presentSearch!
                                            presentSearch! < range.nodeStart + range.nodeCount
                                                -> while {
                                                    prepared.interpolations[presentSearch!].parent == literalIndex!
                                                        and bindingFacts.interpolationContextualFieldByNode[presentSearch!] == candidateIndex!
                                                        -> if { true => present! }
                                                    presentSearch! + 1 => presentSearch!
                                                }
                                            not present! and (missingField! < 0 or fields[candidateIndex!].ordinal < fields[missingField!].ordinal)
                                                -> if { candidateIndex! => missingField! }
                                        }
                                    candidateIndex! + 1 => candidateIndex!
                                }
                                missingField! >= 0 -> if {
                                    expressionTypeIds.ContextualStructDiagnostic {
                                        code: 3
                                        locationNode: literalIndex!
                                        fieldIndex: missingField!
                                        actualType: -1
                                        ownerType: ownerTypeId
                                    } => decision!
                                }
                            }
                            decision! => diagnostics![literalIndex!]
                        }
                    }
                literalIndex! + 1 => literalIndex!
            }
    }
    diagnostics!
}

consumableResultInterpolationOperand prepared: ref semanticContext.SemanticSnapshot, sourceModule: Int, operandIndex: Int -> Bool {
    prepared.interpolations[operandIndex] => operand
    operand.kind == 6 or operand.kind == 8 or operand.kind == 10
        -> if { true -> return }
    operand.kind == 5 and operand.operand0 >= 0
        -> if {
            prepared.interpolations[operand.operand0] => owner
            owner.kind == 1 and owner.symbol < 0 -> if { true -> return }
        }
    operand.kind == 1 and operand.symbol >= 0
        and sourceModule >= 0 and sourceModule < (prepared.package.ranges -> len)
        -> if {
            prepared.package.ranges[sourceModule] => sourceRange
            operand.symbol < sourceRange.symbolCount -> if {
                prepared.package.symbols[sourceRange.symbolStart + operand.symbol] => binding
                binding.kind == 35 and binding.flags % 2 == 1
                    -> if { true -> return }
            }
        }
    false
}

resultPropagationDecision types: ref [typeIds.SemanticType; ~], typeTraits: ref [Int; ~], operandTypeId: Int, functionTypeId: Int, consumable: Bool -> ResultPropagationDecision {
    -1 => status!
    -1 => okTypeId!
    -1 => operandErrorTypeId!
    -1 => functionErrorTypeId!
    operandTypeId >= 0 and operandTypeId < (types -> len)
        -> if {
            types[operandTypeId] => operandType
            1 => status!
            operandType.kind == 7 and operandType.origin == 4 and operandType.symbol == 1
                -> if {
                    operandType.first => okTypeId!
                    operandType.second => operandErrorTypeId!

                    2 => status!
                    functionTypeId >= 0 and functionTypeId < (types -> len)
                        -> if {
                            types[functionTypeId] => functionType
                            functionType.kind == 7 and functionType.origin == 4 and functionType.symbol == 1
                                -> if {
                                    functionType.second => functionErrorTypeId!
                                    3 => status!
                                    operandErrorTypeId! == functionErrorTypeId! -> if {
                                        0 => status!
                                        (okTypeId! >= 0 and okTypeId! < (typeTraits -> len)
                                            and typeTraits[okTypeId!] % 2 == 1)
                                            or (operandErrorTypeId! >= 0 and operandErrorTypeId! < (typeTraits -> len)
                                            and typeTraits[operandErrorTypeId!] % 2 == 1)
                                            -> if {

                                                not consumable -> if { 4 => status! }
                                            }
                                    }
                                }
                        }
                }
        }
    ResultPropagationDecision {
        status: status!
        operandTypeId: operandTypeId
        functionTypeId: functionTypeId
        okTypeId: okTypeId!
        operandErrorTypeId: operandErrorTypeId!
        functionErrorTypeId: functionErrorTypeId!
    }
}

semanticInterpolationFunctionTypeId prepared: ref semanticContext.SemanticSnapshot, bindingFacts: ref expressionTypeIds.ExpressionTypeIdSet, sourceModule: Int, sourceToken: Int -> Int {
    sourceModule < 0 or sourceModule >= (prepared.package.ranges -> len)
        -> if { -1 -> return }
    prepared.package.ranges[sourceModule] => range
    sourceToken < 0 or sourceToken >= range.tokenCount
        -> if { -1 -> return }
    prepared.package.tokens[range.tokenStart + sourceToken].span.start => position
    -1 => owner!
    UIntSize(0) => ownerLength!
    0 => symbolIndex!
    symbolIndex! < range.symbolCount -> while {
        prepared.package.symbols[range.symbolStart + symbolIndex!] => candidate
        (candidate.kind == 7 or candidate.kind == 31) and candidate.astNode >= 0 and candidate.astNode < range.astCount
            -> if {
                prepared.package.nodes[range.astStart + candidate.astNode] => declaration
                declaration.start <= position and position < declaration.start + declaration.length
                    and (owner! < 0 or declaration.length < ownerLength!)
                    -> if {
                        symbolIndex! => owner!
                        declaration.length => ownerLength!
                    }
            }
        symbolIndex! + 1 => symbolIndex!
    }
    owner! < 0 -> if { -1 -> return }
    prepared.package.symbols[range.symbolStart + owner!] => function
    function.secondaryTypeNode => returnAst!
    function.kind == 31 and prepared.package.nodes[range.astStart + function.astNode].secondaryToken >= 0
        -> if { function.typeNode => returnAst! }
    returnAst! < 0 -> if {
        false => hasInput!
        0 => parameterIndex!
        parameterIndex! < range.symbolCount -> while {
            prepared.package.symbols[range.symbolStart + parameterIndex!] => parameter
            parameter.parent == owner! and parameter.kind == 35
                -> if { true => hasInput! }
            parameterIndex! + 1 => parameterIndex!
        }
        not hasInput! -> if { function.typeNode => returnAst! }
    }
    returnAst! < 0 or returnAst! >= range.astCount
        -> if { -1 -> return }
    bindingFacts.referenceIndexByTypeAst[range.astStart + returnAst!] => referenceIndex
    referenceIndex < 0 or referenceIndex >= (bindingFacts.references -> len)
        -> if { -1 -> return }
    bindingFacts.references[referenceIndex] => reference
    reference.status != 0 -> if { -1 -> return }
    reference.typeId
}

public preIrResultPropagationDecisionByNode prepared: ref semanticContext.SemanticSnapshot, bindingFacts: ref expressionTypeIds.ExpressionTypeIdSet, typeTraits: ref [Int; ~], callTargets: ref [SemanticInterpolationCallTarget; ~], pointerBitWidth: Int -> [ResultPropagationDecision; ~] {
    prepared -> preIrCallMemberTypeByNode(bindingFacts, callTargets) => memberTypes
    prepared -> invalidNumericConversionArityByNode => invalidConversionArity
    prepared -> invalidNumericConversionLiteralByNode(pointerBitWidth) => invalidConversionLiteral
    [Int; ~] => computedTypes!
    [ResultPropagationDecision; ~] => decisions!
    prepared.interpolations -> each node {
        computedTypes! -> push(-1)
        decisions! -> push(resultPropagationDecision(bindingFacts.types, typeTraits, -1, -1, false))
    }
    (prepared.interpolations -> len) - 1 => nodeIndex!
    nodeIndex! >= 0 -> while {
        prepared.interpolations[nodeIndex!] => node
        prepared -> preIrDirectTypeId(bindingFacts, memberTypes, nodeIndex!) => computedTypes![nodeIndex!]
        node.kind == 2 -> if {
            prepared -> preIrDirectUnaryTypeId(bindingFacts, memberTypes, computedTypes!, nodeIndex!) => computedTypes![nodeIndex!]
        }
        node.kind == 3 -> if {
            prepared -> preIrDirectBinaryTypeId(bindingFacts, memberTypes, computedTypes!, nodeIndex!) => computedTypes![nodeIndex!]
        }
        node.kind == 9 -> if {
            prepared -> preIrDirectConversionTypeId(bindingFacts, memberTypes, computedTypes!, invalidConversionArity, invalidConversionLiteral, nodeIndex!) => computedTypes![nodeIndex!]
        }
        node.kind == 11 and node.operand0 >= 0 -> if {
            prepared -> sourceModuleAt(nodeIndex!) => sourceModule
            sourceModule >= 0 -> if {
                prepared -> expressionTypeIds.preIrInterpolationReceiverTypeId(bindingFacts.types, bindingFacts.references, bindingFacts.referenceIndexByTypeAst, bindingFacts.interpolationLexicalTypeByNode, bindingFacts.interpolationMemberTypeByNode, bindingFacts.interpolationIndexedTypeByNode, bindingFacts.interpolationContextualStructTypeByNode, bindingFacts.interpolationCallTypeByNode, sourceModule, node.operand0) => operandTypeId!
                node.operand0 > nodeIndex! and node.operand0 < (computedTypes! -> len)
                    and computedTypes![node.operand0] >= 0
                    -> if { computedTypes![node.operand0] => operandTypeId! }
                prepared -> semanticInterpolationFunctionTypeId(bindingFacts, sourceModule, node.sourceToken) => functionTypeId
                prepared -> consumableResultInterpolationOperand(sourceModule, node.operand0) => consumable
                resultPropagationDecision(bindingFacts.types, typeTraits, operandTypeId!, functionTypeId, consumable) => decision
                decision => decisions![nodeIndex!]
                decision.status == 0 -> if { decision.okTypeId => computedTypes![nodeIndex!] }
            }
        }
        nodeIndex! - 1 => nodeIndex!
    }
    decisions!
}

# Ownership and emission consume the same completed expression type decision.
# In particular, a scalar projection of Text does not retain its Text loan.
public resultTypeByNode prepared: ref semanticContext.SemanticSnapshot, plan: ref streamIr.StreamPlan, bindingFacts: ref expressionTypeIds.ExpressionTypeIdSet, ir: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], fields: ref [typeIds.NominalField; ~] -> [Int; ~] {
    [Int; ~] => resultTypes!
    0 => nodeIndex!
    nodeIndex! < (prepared.interpolations -> len)
        -> while {
            prepared -> sourceModuleAt(nodeIndex!) => sourceModule
            prepared -> expressionTypeId(plan, bindingFacts, ir, types, fields, sourceModule, nodeIndex!) => resultTypeId
            resultTypes! -> push(resultTypeId)
            nodeIndex! + 1 => nodeIndex!
        }
    resultTypes!
}

public indexedResultTypeByNode prepared: ref semanticContext.SemanticSnapshot, plan: ref streamIr.StreamPlan, bindingFacts: ref expressionTypeIds.ExpressionTypeIdSet, ir: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], fields: ref [typeIds.NominalField; ~] -> [Int; ~] {
    [Int; ~] => resultTypes!
    0 => nodeIndex!
    nodeIndex! < (prepared.interpolations -> len)
        -> while {
            -1 => resultTypeId!
            prepared.interpolations[nodeIndex!] => node
            node.kind == 7 and node.operand0 >= 0 and node.operand1 >= 0
                -> if {
                    prepared -> sourceModuleAt(nodeIndex!) => sourceModule
                    sourceModule >= 0 -> if {
                        prepared -> expressionTypeId(plan, bindingFacts, ir, types, fields, sourceModule, nodeIndex!) => resultTypeId!
                    }
                }
            resultTypes! -> push(resultTypeId!)
            nodeIndex! + 1 => nodeIndex!
        }
    resultTypes!
}

public memberResultTypeByNode prepared: ref semanticContext.SemanticSnapshot, plan: ref streamIr.StreamPlan, bindingFacts: ref expressionTypeIds.ExpressionTypeIdSet, localEnumMembers: ref [LocalEnumMemberDecision; ~], ir: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], fields: ref [typeIds.NominalField; ~] -> [Int; ~] {
    [Int; ~] => resultTypes!
    0 => nodeIndex!
    nodeIndex! < (prepared.interpolations -> len)
        -> while {
            -1 => resultTypeId!
            prepared.interpolations[nodeIndex!] => node
            node.kind == 5 and node.operand0 >= 0
                -> if {
                    prepared -> sourceModuleAt(nodeIndex!) => sourceModule
                    sourceModule >= 0 -> if {
                        prepared -> expressionTypeId(plan, bindingFacts, ir, types, fields, sourceModule, nodeIndex!) => resultTypeId!
                        localEnumMembers[nodeIndex!].status == 3
                            -> if { localEnumMembers[nodeIndex!].typeId => resultTypeId! }
                    }
                }
            resultTypes! -> push(resultTypeId!)
            nodeIndex! + 1 => nodeIndex!
        }
    resultTypes!
}

public memberFieldByNode prepared: ref semanticContext.SemanticSnapshot, plan: ref streamIr.StreamPlan, bindingFacts: ref expressionTypeIds.ExpressionTypeIdSet, ir: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], fields: ref [typeIds.NominalField; ~] -> [Int; ~] {
    [Int; ~] => fieldByNode!
    0 => nodeIndex!
    nodeIndex! < (prepared.interpolations -> len)
        -> while {
            -1 => fieldIndex!
            prepared.interpolations[nodeIndex!] => member
            member.kind == 5 and member.operand0 >= 0 -> if {
                prepared -> sourceModuleAt(nodeIndex!) => sourceModule
                sourceModule >= 0 -> if {
                    prepared -> expressionTypeId(plan, bindingFacts, ir, types, fields, sourceModule, member.operand0) => ownerTypeId
                    ownerTypeId >= 0 -> if {
                        prepared -> expressionTypeIds.memberFieldIndex(types, fields, sourceModule, ownerTypeId, nodeIndex!) => fieldIndex!
                    }
                }
            }
            fieldByNode! -> push(fieldIndex!)
            nodeIndex! + 1 => nodeIndex!
        }
