+appendReceiverResultAncestors first: mut [Int; ~], rows: mut [Int; ~], nextEdges: mut [Int; ~], last: mut [Int; ~], nodes: ref [ast.AstNode; ~], astStart: Int, node: Int, row: Int -> Unit {
