+preparedSignatureHasUnboundTypeParameter prepared: ref semanticContext.SemanticSnapshot, root: Int -> Bool {
+    [root,; ~] => pending!
+    [Int; ~] => visited!
+    0 => cursor!
+    cursor! < (pending! -> len) -> while {
+        pending![cursor!] => typeId
+        false => seen!
+        visited! -> each previous { previous == typeId -> if { true => seen! } }
+        not seen! and typeId >= 0 and typeId < (prepared.semantic.types -> len)
+            -> if {
+                visited! -> push(typeId)
+                prepared.semantic.types[typeId] => type
+                type.kind == 1 and type.origin == 3 -> if { true -> return }
+                type.containsParameter -> if {
+                    type.first >= 0 -> if { pending! -> push(type.first) }
+                    type.second >= 0 -> if { pending! -> push(type.second) }
+                    prepared.semantic.fields -> each field {
+                        field.ownerType == typeId -> if { pending! -> push(field.fieldType) }
+                    }
+                }
+            }
+        cursor! + 1 => cursor!
+    }
+    # Symbolic array lengths are value parameters, not unsendable type values.
+    false
