+# Nominal declarations own recursion. Only structural constructor arguments
+# are visited here, in the same child-first order as the managed type parser.
+firstArrayLayoutFailure types: ref [typeIds.SemanticType; ~], typeId: Int, definition: Bool, failures: mut [Int; ~] -> Int {
+    typeId < 0 or typeId >= (types -> len) -> if { -1 -> return }
+    failures[typeId] != -2 -> if { failures[typeId] -> return }
+    types[typeId] => type
+    -1 => failure!
+    type.status == 0 and type.kind != 1 -> if {
+        type.kind == 2 or type.kind == 3 or type.kind == 4 or type.kind == 5
+            or type.kind == 6 or type.kind == 7 or type.kind == 8
+            or type.kind == 12 or type.kind == 13
+            -> if {
+                types -> firstArrayLayoutFailure(type.first, definition, failures) => failure!
+            }
+        failure! < 0 and (type.kind == 5 or type.kind == 7 or type.kind == 13)
+            -> if {
+                types -> firstArrayLayoutFailure(type.second, definition, failures) => failure!
+            }
+        failure! < 0 -> if {
+            definition -> if {
+                type.first >= 0 and type.first < (types -> len)
+                    -> if {
+                        types[type.first] => element
+                        type.kind == 2 and not (element.kind == 1 and element.origin == 1 and element.symbol == 2)
+                            -> if { typeId => failure! }
+                        (type.kind == 3 or type.kind == 4 or type.kind == 12)
+                            and element.kind == 1 and element.origin == 1 and element.symbol == 0
+                            -> if { typeId => failure! }
+                    }
+            } else {
+                types -> typeIds.unsupportedArraySignatureElement(typeId)
+                    -> if { typeId => failure! }
+            }
+        }
+    }
+    failure! => failures[typeId]
+    failure!
+}
