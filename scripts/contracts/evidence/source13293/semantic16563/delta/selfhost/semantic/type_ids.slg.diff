+# Ordinary signature annotations follow the managed ParseType element policy.
+# Field definitions and contextual values have separate admission rules; this
+# source restriction is not a backend representation invariant.
+public unsupportedArraySignatureElement types: ref [SemanticType; ~], typeId: Int -> Bool {
+    typeId < 0 or typeId >= (types -> len) -> if { false -> return }
+    types[typeId] => outer
+    (outer.kind == 2 or outer.kind == 3 or outer.kind == 4 or outer.kind == 12)
+        and outer.first >= 0 and outer.first < (types -> len)
+        -> unless { false -> return }
+    types[outer.first] => element
+    element.kind == 1 and element.origin == 1 and element.symbol == 0
+        -> if { true -> return }
+    element.kind == 2 or element.kind == 3 or element.kind == 4
+        or element.kind == 5 or element.kind == 13
+        -> if { not (outer.kind == 3 and element.kind == 3) -> return }
+    false
 }
 
