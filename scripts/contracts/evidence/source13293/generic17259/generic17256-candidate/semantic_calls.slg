import syntax.generated.slg as grammar

# Both resolution paths use the same source invocation boundary.
hasExplicitQualifiedInvocation tokens: ref [syntax.SyntaxToken; ~], tokenStart: Int, tokenCount: Int, afterPathToken: Int -> Bool {
    afterPathToken => invocationToken!
    invocationToken! < tokenCount
        and (tokens[tokenStart + invocationToken!].kind == grammar.triviaIdWhitespace()
        or tokens[tokenStart + invocationToken!].kind == grammar.triviaIdComment())
        -> while { invocationToken! + 1 => invocationToken! }
    invocationToken! < tokenCount
        and tokens[tokenStart + invocationToken!].kind == grammar.tokenIdLeftParen()
}

public struct CallResolution {
    public callAst: Int
    public nameToken: Int
    public functionSymbol: Int
    public status: Int
}

public struct ModuleCallResolution {
    public sourceModule: Int
    public callAst: Int
    public origin: Int
    public targetModule: Int
    public targetSourceModule: Int
    public functionSymbol: Int
    public status: Int
}

public struct ModuleCallRequest {
    public sources: [Text; ~]
    public modules: [modules.ModuleIdentity; ~]
    public qualified: [qualified.QualifiedResolution; ~]
}

# A target constant is identified by its declaring namespace and intrinsic
# declaration. Ordinary functions with the same name retain their own body.
public isNativePathStyleIntrinsic package: ref analysis.PackageAnalysis, identities: ref [modules.ModuleIdentity; ~], targetSource: Int, targetSymbol: Int -> Bool {
    targetSource < 0 or targetSource >= (package.ranges -> len)
        -> if { false -> return }
    package.ranges[targetSource] => range
    targetSymbol < 0 or targetSymbol >= range.symbolCount
        -> if { false -> return }
    package.symbols[range.symbolStart + targetSymbol] => declaration
    declaration.kind != 7 or declaration.parent >= 0 or declaration.flags / 128 % 2 != 1
        -> if { false -> return }
    package.tokens[range.tokenStart + declaration.nameToken] => name
    (package.sources[targetSource] -> slice(name.span.start, name.span.length)) != "nativeStyle"
        -> if { false -> return }
    identities -> each identity {
        identity.sourceIndex == targetSource and identity.pathHash == 7794543808165292697
            and (package.sources[targetSource] -> slice(identity.pathStart, identity.pathLength)) == "sys.path"
            -> if { true -> return }
    }
    false
}

# The caller supplies a real target span and an already materialized receiver.
# Qualified path resolution and trait-prefix resolution are separate identities.
# No AST or interpolation index is reused across their distinct domains.
public struct TypedMethodRequest {
    public sourceModule: Int
    public receiverTypeId: Int
    public targetStart: UIntSize
    public targetLength: UIntSize
    public qualifiedTargetModule: Int
    public qualifiedTargetSymbol: Int
    public qualifiedTargetStatus: Int
    public qualifiedTraitModule: Int
    public qualifiedTraitSymbol: Int
    public blockMethod: Bool
}

public struct TypedMethodResolution {
    public targetModule: Int
    public targetSourceModule: Int
    public functionSymbol: Int
    # The declaration's canonical owner may be a slice view of an array receiver.
    public ownerTypeId: Int
    # Canonical trait identity is retained for diagnostics; inherent methods use -1.
    public traitModule: Int
    public traitSymbol: Int
    # -1 not found, 0 selected, 1 inaccessible, 2 ambiguous.
    # Arity and argument checks follow selection and cannot reopen free fallback.
    public status: Int
}

public struct TypedMethodQualifier {
    public targetModule: Int
    public targetSymbol: Int
    # -1 not a resolved trait prefix, 0 selected, 1 inaccessible, 2 ambiguous.
    public status: Int
}

# Builtin flow borrowing follows the C# first-target decision. A committed
# declaration (including mut/move shadows) takes precedence over the builtin.
public readonlyIntrinsicFlowSource source: Text, sourceModule: Int, flowAst: Int, nodes: ref [ast.AstNode; ~], nodeOffset: Int, nodeCount: Int, tokens: ref [syntax.SyntaxToken; ~], tokenOffset: Int, resolved: ref [ModuleCallResolution; ~] -> Bool {
    nodes[nodeOffset + flowAst].kind != 10 -> if { false -> return }
    resolved -> each call {
        call.sourceModule == sourceModule and call.callAst == flowAst
            -> if { false -> return }
    }
    -1 => firstTarget!
    0 => index!
    index! < nodeCount -> while {
        nodes[nodeOffset + index!] => target
        target.parent == flowAst and target.kind == 16 and target.payloadToken >= 0
            -> if {
                firstTarget! < 0 or target.payloadToken < nodes[nodeOffset + firstTarget!].payloadToken
                    -> if { index! => firstTarget! }
            }
        index! + 1 => index!
    }
    firstTarget! < 0 -> if { false -> return }
    nodes[nodeOffset + firstTarget!] => target
    target.firstToken => tokenIndex!
    tokenIndex! < target.firstToken + target.tokenCount
        -> while {
            tokens[tokenOffset + tokenIndex!].kind == grammar.tokenIdDot()
                -> if { false -> return }
            tokenIndex! + 1 => tokenIndex!
        }
    tokens[tokenOffset + target.payloadToken] => name
    # Arena operations retain their storage owner. Writable access and live
    # loans are checked independently; even mutating operations do not move it.
    source -> slice(name.span.start, name.span.length) -> rawArenaIntrinsic => arenaIntrinsic
    arenaIntrinsic.operation > 0 -> if { true -> return }
    (TokenNameRequest { source: source, token: name, expected: "len" } -> tokenNameIs)
        or (TokenNameRequest { source: source, token: name, expected: "byte" } -> tokenNameIs)
        or (TokenNameRequest { source: source, token: name, expected: "slice" } -> tokenNameIs)
}

struct TokenNameRequest {
    source: Text
    token: syntax.SyntaxToken
    expected: Text
}

struct RuntimeNameRequest {
    source: Text
    token: syntax.SyntaxToken
}

struct DeclaredIntrinsicCallableName {
    sourceModule: Int
    nameToken: Int
    sourceFunction: Bool
    publicDeclaration: Bool
}

struct TypedCallCandidate {
    callAst: Int
    nameToken: Int
    functionSymbol: Int
    status: Int
    intrinsicFallback: Bool
}

tokenNameIs request: TokenNameRequest -> Bool {
    request.token.span.length == (request.expected -> len) => equal!
    UIntSize(0) => index!
    equal! and index! < request.token.span.length
        -> while {
            (request.source -> byte(request.token.span.start + index!)) != (request.expected -> byte(index!))
                -> if { false => equal! }
            index! + 1 => index!
        }
    equal!
}

# Index every path ancestor that already contains a real call-expression
# owner. Qualified value projections can then reject borrowed call identity in
# O(1) instead of rescanning the AST for each qualified candidate.
indexQualifiedPathCallOwners nodes: ref [ast.AstNode; ~], nodeOffset: Int, nodeCount: Int -> [Int; ~] {
    [Int; ~] => owners!
    0 => ownerSeed!
    ownerSeed! < nodeCount
        -> while {
            owners! -> push(-1)
            ownerSeed! + 1 => ownerSeed!
        }
    0 => callOwnerSearch!
    callOwnerSearch! < nodeCount
        -> while {
            nodes[nodeOffset + callOwnerSearch!] => candidate
            candidate.kind == 11 and candidate.cstRuleId == grammar.ruleIdCallExpression()
                -> if {
                    candidate.parent => ancestor!
                    ancestor! >= 0 -> while {
                        nodes[nodeOffset + ancestor!] => ancestorNode
                        ancestorNode.kind == 36 and ancestorNode.start == candidate.start
                            -> if {
                                owners![ancestor!] => existingOwner
                                existingOwner < 0 or candidate.length < nodes[nodeOffset + existingOwner].length
                                    -> if { callOwnerSearch! => owners![ancestor!] }
                            }
                        ancestorNode.parent => ancestor!
                    }
                }
            callOwnerSearch! + 1 => callOwnerSearch!
        }
    owners!
}

# Negative symbols are stable built-in aliases used before stdlib-qualified
# resolution. -101/-102 are retained for typed-IR compatibility.
runtimeFunctionSymbol request: RuntimeNameRequest -> Int {
    -1 => runtimeSymbol!
    TokenNameRequest { source: request.source, token: request.token, expected: "print" } -> tokenNameIs
        -> if { -101 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "println" } -> tokenNameIs
        -> if { -102 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "readInt" } -> tokenNameIs
        -> if { -103 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "seedRandom" } -> tokenNameIs
        -> if { -104 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "randomBelow" } -> tokenNameIs
        -> if { -105 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "openIntWriter" } -> tokenNameIs
        -> if { -106 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "writeInt" } -> tokenNameIs
        -> if { -107 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "closeIntWriter" } -> tokenNameIs
        -> if { -108 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "openIntReader" } -> tokenNameIs
        -> if { -109 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "closestInt" } -> tokenNameIs
        -> if { -110 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "closeIntReader" } -> tokenNameIs
        -> if { -111 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "flush" } -> tokenNameIs
        -> if { -114 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "limitParallelWorkers" } -> tokenNameIs
        -> if { -115 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "parallelWorkers" } -> tokenNameIs
        -> if { -118 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "parallelPeakWorkers" } -> tokenNameIs
        -> if { -119 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "parallel" } -> tokenNameIs
        -> if { -120 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "tryParallel" } -> tokenNameIs
        -> if { -121 => runtimeSymbol! }
    runtimeSymbol!
}

# These temporary name markers never become an ABI: bind the actual canonical
# declaration before returning a module call table.
struct GlobalFunctionAlias {
    marker: Int
    sourceModule: Int
    functionSymbol: Int
    exported: Bool
}

public struct GlobalFunctionAliasDiagnostic {
    public code: Int
    public marker: Int
    public targetSourceModule: Int
    public functionSymbol: Int
    public contextSourceModule: Int
}

public noGlobalFunctionAliasDiagnostic: -> GlobalFunctionAliasDiagnostic => GlobalFunctionAliasDiagnostic { code: 0, marker: -1, targetSourceModule: -1, functionSymbol: -1, contextSourceModule: -1 }

public globalFunctionAliasName marker: Int -> Text {
    marker -> when {
        == -101 => "print"
        == -102 => "println"
        == -103 => "readInt"
        == -104 => "seedRandom"
        == -105 => "randomBelow"
        == -106 => "openIntWriter"
        == -107 => "writeInt"
        == -108 => "closeIntWriter"
        == -109 => "openIntReader"
        == -110 => "closestInt"
        == -111 => "closeIntReader"
        == -120 => "parallel"
        == -121 => "tryParallel"
        == -115 => "limitParallelWorkers"
        == -118 => "parallelWorkers"
        == -119 => "parallelPeakWorkers"
        else => ""
    }
}

public canonicalGlobalFunctionAliasName marker: Int -> Text {
    marker == -104 -> if { "seed" -> return }
    marker == -105 -> if { "below" -> return }
    marker -> globalFunctionAliasName
}

public globalFunctionAliasModule marker: Int -> Text => marker -> globalAliasNamespace

public firstGlobalFunctionAliasDiagnostic package: ref analysis.PackageAnalysis, identities: ref [modules.ModuleIdentity; ~], libraryStart: Int, libraryCount: Int -> GlobalFunctionAliasDiagnostic {
    [GlobalFunctionAlias; ~] => aliases!
    [Int; ~] => conflicts!
    -1 => contextSource!
    package.ranges -> each range {
        identities[range.sourceModule] => identity
        package.sources[range.sourceModule] -> slice(UIntSize(0), package.sources[range.sourceModule] -> len) => source
        source -> slice(identity.pathStart, identity.pathLength) => moduleName
        0 => symbolIndex!
        symbolIndex! < range.symbolCount -> while {
            package.symbols[range.symbolStart + symbolIndex!] => declaration
            (declaration.kind == 7 and declaration.parent < 0) or declaration.kind == 31
                -> if { range.sourceModule => contextSource! }
            declaration.kind == 7 and declaration.parent < 0 and declaration.nameToken >= 0 and (moduleName -> len) == 0
                and not (declaration -> symbols.hasQualifiedFunctionName(package.tokens, range.tokenStart, range.tokenCount))
                -> if {
                    RuntimeNameRequest { source: source, token: package.tokens[range.tokenStart + declaration.nameToken] } -> runtimeFunctionSymbol => marker
                    marker -> globalFunctionAlias -> if { conflicts! -> push(marker) }
                }
            symbolIndex! + 1 => symbolIndex!
        }
        range.sourceModule >= libraryStart and range.sourceModule - libraryStart < libraryCount
            -> if {
                moduleName == "sys.io" or moduleName == "sys.random" or moduleName == "sys.file" or moduleName == "sys.runtime"
                    -> if {
                        source -> collectGlobalFunctionAliases(range.sourceModule, moduleName, package.tokens, range.tokenStart, package.symbols, range.symbolStart, range.symbolCount) => fragment
                        fragment -> each target { aliases! -> push(target) }
                    }
            }
    }
    [-101, -102, -103, -104, -105, -106, -107, -108, -109, -110, -111, -120, -121, -115, -118, -119] => order
    order -> each marker {
        -1 => selected!
        0 => aliasIndex!
        aliases! -> each target {
            target.marker == marker -> if { aliasIndex! => selected! }
            aliasIndex! + 1 => aliasIndex!
        }
        selected! < 0 -> if {
            GlobalFunctionAliasDiagnostic { code: 1, marker: marker, targetSourceModule: -1, functionSymbol: -1, contextSourceModule: contextSource! } -> return
        }
        conflicts! -> each conflict {
            conflict == marker -> if {
                aliases![selected!] => target
                GlobalFunctionAliasDiagnostic { code: 2, marker: marker, targetSourceModule: target.sourceModule, functionSymbol: target.functionSymbol, contextSourceModule: contextSource! } -> return
            }
        }
    }
    noGlobalFunctionAliasDiagnostic()
}

globalAliasNamespace marker: Int -> Text {
    marker <= -101 and marker >= -103 -> if { "sys.io" -> return }
    marker == -104 or marker == -105 -> if { "sys.random" -> return }
    marker <= -106 and marker >= -111 -> if { "sys.file" -> return }
    marker == -115 or (marker <= -118 and marker >= -121)
        -> if { "sys.runtime" -> return }
    ""
}

globalFunctionAlias marker: Int -> Bool => (marker -> globalAliasNamespace -> len) > 0

canonicalAliasMarker source: Text, token: syntax.SyntaxToken, moduleName: Text -> Int {
    moduleName == "sys.random" -> if {
        TokenNameRequest { source: source, token: token, expected: "seed" } -> tokenNameIs
            -> if { -104 -> return }
        TokenNameRequest { source: source, token: token, expected: "below" } -> tokenNameIs
            -> if { -105 -> return }
        -1 -> return
    }
    RuntimeNameRequest { source: source, token: token } -> runtimeFunctionSymbol => marker
    (marker -> globalAliasNamespace) == moduleName
        -> if { marker -> return }
    -1
}

hasGlobalFunctionAliases resolutions: ref [ModuleCallResolution; ~] -> Bool {
    resolutions -> each call {
        call.origin == 2 and (call.functionSymbol -> globalFunctionAlias)
            -> if { true -> return }
    }
    false
}

collectGlobalFunctionAliases source: Text, sourceIndex: Int, moduleName: Text, tokens: ref [syntax.SyntaxToken; ~], tokenStart: Int, table: ref [symbols.Symbol; ~], symbolStart: Int, symbolCount: Int -> [GlobalFunctionAlias; ~] {
    [GlobalFunctionAlias; ~] => aliases!
    0 => symbolIndex!
    symbolIndex! < symbolCount -> while {
        table[symbolStart + symbolIndex!] => target
        target.kind == 7 and target.parent < 0 and target.nameToken >= 0
            -> if {
                source -> canonicalAliasMarker(tokens[tokenStart + target.nameToken], moduleName) => marker
                marker -> globalFunctionAlias -> if {
                    aliases! -> push(GlobalFunctionAlias { marker: marker, sourceModule: sourceIndex, functionSymbol: symbolIndex!, exported: target.flags / 4 % 2 == 1 })
                }
            }
        symbolIndex! + 1 => symbolIndex!
    }
    aliases!
}

commitGlobalFunctionAlias call: ModuleCallResolution, aliases: ref [GlobalFunctionAlias; ~], callerModuleName: Text -> ModuleCallResolution {
    call => committed!
    0 => matches!
    aliases -> each target {
        target.marker == call.functionSymbol -> if {
            matches! + 1 => matches!
            target.sourceModule => committed!.targetModule
            target.sourceModule => committed!.targetSourceModule
            target.functionSymbol => committed!.functionSymbol
            call.sourceModule == target.sourceModule -> if { 0 } else { 1 } => committed!.origin
            not target.exported and callerModuleName != (target.marker -> globalAliasNamespace)
                -> if { 1 => committed!.status }
        }
    }
    matches! != 1 -> if {
        0 => committed!.origin
        -1 => committed!.targetModule
        -1 => committed!.functionSymbol
        -1 => committed!.targetSourceModule
        2 => committed!.status
    }
    committed!
}

commitTextGlobalFunctionAliases resolutions: mut [ModuleCallResolution; ~], sources: ref [Text; ~], identities: ref [modules.ModuleIdentity; ~] -> Unit {
    resolutions -> hasGlobalFunctionAliases -> unless { return }
    [GlobalFunctionAlias; ~] => aliases!
    identities -> each identity {
        sources[identity.sourceIndex] => source
        source -> slice(identity.pathStart, identity.pathLength) => moduleName
        moduleName == "sys.io" or moduleName == "sys.random" or moduleName == "sys.file" or moduleName == "sys.runtime"
            -> if {
                source -> ast.lower => nodes
                source -> lexer.lex => tokens
                nodes -> symbols.collectPreparedWithTokens(tokens) => table
                source -> collectGlobalFunctionAliases(identity.sourceIndex, moduleName, tokens, 0, table, 0, table -> len) => fragment
                fragment -> each target { aliases! -> push(target) }
            }
    }
    0 => callIndex!
    callIndex! < (resolutions -> len) -> while {
        resolutions[callIndex!] => call
        call.origin == 2 and (call.functionSymbol -> globalFunctionAlias)
            -> if {
                identities[call.sourceModule] => caller
                sources[call.sourceModule] -> slice(caller.pathStart, caller.pathLength) => callerModuleName
                call -> commitGlobalFunctionAlias(aliases!, callerModuleName) => resolutions[callIndex!]
            }
        callIndex! + 1 => callIndex!
    }
}

commitAnalyzedGlobalFunctionAliases resolutions: mut [ModuleCallResolution; ~], package: ref analysis.PackageAnalysis, identities: ref [modules.ModuleIdentity; ~] -> Unit {
    resolutions -> hasGlobalFunctionAliases -> unless { return }
    [GlobalFunctionAlias; ~] => aliases!
    identities -> each identity {
        package.sources[identity.sourceIndex] -> slice(UIntSize(0), package.sources[identity.sourceIndex] -> len) => source
        source -> slice(identity.pathStart, identity.pathLength) => moduleName
        moduleName == "sys.io" or moduleName == "sys.random" or moduleName == "sys.file" or moduleName == "sys.runtime"
            -> if {
                package.ranges[identity.sourceIndex] => range
                source -> collectGlobalFunctionAliases(identity.sourceIndex, moduleName, package.tokens, range.tokenStart, package.symbols, range.symbolStart, range.symbolCount) => fragment
                fragment -> each target { aliases! -> push(target) }
            }
    }
    0 => callIndex!
    callIndex! < (resolutions -> len) -> while {
        resolutions[callIndex!] => call
        call.origin == 2 and (call.functionSymbol -> globalFunctionAlias)
            -> if {
                identities[call.sourceModule] => caller
                package.sources[call.sourceModule] -> slice(caller.pathStart, caller.pathLength) => callerModuleName
                call -> commitGlobalFunctionAlias(aliases!, callerModuleName) => resolutions[callIndex!]
            }
        callIndex! + 1 => callIndex!
    }
}

public isProcessAdditionalRuntimeIntrinsic package: ref analysis.PackageAnalysis, identities: ref [modules.ModuleIdentity; ~], sourceModule: Int, functionSymbol: Int, libraryStart: Int, libraryCount: Int -> Bool {
    sourceModule < libraryStart or sourceModule - libraryStart >= libraryCount
        or sourceModule < 0 or sourceModule >= (package.ranges -> len)
        -> if { false -> return }
    package.ranges[sourceModule] => range
    functionSymbol < 0 or functionSymbol >= range.symbolCount
        -> if { false -> return }
    package.symbols[range.symbolStart + functionSymbol] => declaration
    declaration.kind != 31 or declaration.parent < 0 or declaration.nameToken < 0
        -> if { false -> return }
    package.symbols[range.symbolStart + declaration.parent] => owner
    owner.kind != 6 -> if { false -> return }
    package -> typeIds.implOwnerTypeAst(sourceModule, owner.astNode) => ownerTypeAst
    ownerTypeAst < 0 -> if { false -> return }
    package.sources[sourceModule] -> slice(UIntSize(0), package.sources[sourceModule] -> len) => source
    source -> modules.logicalNameIs(identities[sourceModule], range, package.tokens, "sys.process")
        -> unless { false -> return }
    package.nodes[range.astStart + ownerTypeAst] => receiver
    source -> slice(receiver.start, receiver.length) => receiverName
    receiverName != "Command" and receiverName != "sys.process.Command"
        -> if { false -> return }
    package.tokens[range.tokenStart + declaration.nameToken] => nameToken
    source -> slice(nameToken.span.start, nameToken.span.length) => name
    name == "collect" or name == "runToFile"
}

public displayFunctionSymbol package: ref analysis.PackageAnalysis, identities: ref [modules.ModuleIdentity; ~], sourceModule: Int, functionSymbol: Int, libraryStart: Int, libraryCount: Int -> Int {
    sourceModule < libraryStart or sourceModule - libraryStart >= libraryCount
        or sourceModule < 0 or sourceModule >= (package.ranges -> len)
        or functionSymbol < 0
        -> if { -1 -> return }
    package.ranges[sourceModule] => range
    functionSymbol >= range.symbolCount -> if { -1 -> return }
    package.symbols[range.symbolStart + functionSymbol] => declaration
    declaration.kind != 7 or declaration.parent >= 0 or declaration.nameToken < 0
        -> if { -1 -> return }
    identities[sourceModule] => identity
    package.sources[sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName
    moduleName != "sys.io" and not (moduleName == "sys.runtime" and declaration.flags / 128 % 2 == 1)
        -> if { -1 -> return }
    package.tokens[range.tokenStart + declaration.nameToken] => token
    package.sources[sourceModule] -> slice(token.span.start, token.span.length) => name
    name == "print" -> if { -101 -> return }
    name == "println" -> if { -102 -> return }
    -1
}

# These stable ABI aliases name internal wrappers in the current runtime slice.
# Their visibility belongs to the canonical wrapper, including calls from main.
public internalRuntimeAliasModule functionSymbol: Int -> Text {
    functionSymbol == -104 or functionSymbol == -105
        -> if { "sys.random" -> return }
    functionSymbol <= -106 and functionSymbol >= -111
        -> if { "sys.file" -> return }
    ""
}

public internalRuntimeAliasName functionSymbol: Int -> Text {
    functionSymbol -> when {
        == -104 => "seed"
        == -105 => "below"
        == -106 => "openIntWriter"
        == -107 => "writeInt"
        == -108 => "closeIntWriter"
        == -109 => "openIntReader"
        == -110 => "closestInt"
        == -111 => "closeIntReader"
        else => ""
    }
}

public moveConsumingIntrinsicTarget name: Text -> Bool => name == "append" or name == "updated" or name == "await" or name == "cancel"

public struct RawArenaIntrinsic {
    public operation: Int
    public resultSymbol: Int
    public argumentCount: Int
    public mutates: Bool
}

# Semantic operation identities are independent of LLVM opcode allocation.
public rawArenaOperationSignature operation: Int -> RawArenaIntrinsic {
    operation == 1 -> if { RawArenaIntrinsic { operation: 1, resultSymbol: 13, argumentCount: 2, mutates: true } -> return }
    operation == 2 -> if { RawArenaIntrinsic { operation: 2, resultSymbol: 13, argumentCount: 0, mutates: false } -> return }
    operation == 3 -> if { RawArenaIntrinsic { operation: 3, resultSymbol: 0, argumentCount: 2, mutates: true } -> return }
    operation == 4 -> if { RawArenaIntrinsic { operation: 4, resultSymbol: 8, argumentCount: 1, mutates: false } -> return }
    operation == 5 -> if { RawArenaIntrinsic { operation: 5, resultSymbol: 0, argumentCount: 0, mutates: true } -> return }
    RawArenaIntrinsic { operation: 0, resultSymbol: -1, argumentCount: -1, mutates: false }
}

public rawArenaIntrinsic name: Text -> RawArenaIntrinsic {
    name == "alloc" -> if { 1 -> rawArenaOperationSignature -> return }
    name == "used" -> if { 2 -> rawArenaOperationSignature -> return }
    name == "store" -> if { 3 -> rawArenaOperationSignature -> return }
    name == "load" -> if { 4 -> rawArenaOperationSignature -> return }
    name == "reset" -> if { 5 -> rawArenaOperationSignature -> return }
    0 -> rawArenaOperationSignature
}

intrinsicFlowTarget request: RuntimeNameRequest -> Bool {
    false => intrinsic!
    TokenNameRequest { source: request.source, token: request.token, expected: "each" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "repeat" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "yield" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "emit" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "await" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "cancel" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "parallel" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "tryParallel" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "used" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "alloc" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "store" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "load" } -> tokenNameIs
