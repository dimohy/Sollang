public resolveModulesTypedWithReceiverTypeSeeds package: analysis.PackageAnalysis, semantic: typeIds.SemanticTypeSet, receiverTypeByCallAst: ref [Int; ~], resolvedTypes: ref [typeIds.SemanticType; ~], seededOwners: ref [Bool; ~], seededCalls: ref [ModuleCallResolution; ~] -> [ModuleCallResolution; ~] {
    package -> modules.identitiesAnalyzed => identities
    package -> modules.importsAnalyzed => imports
    package -> moduleResolve.resolveAnalyzed => resolvedImports
    package -> qualified.resolveAnalyzed => qualifiedResults
    package -> resolveModulesTypedWithPreparedFacts(semantic, receiverTypeByCallAst, resolvedTypes, seededOwners, seededCalls, identities, imports, resolvedImports, qualifiedResults)
}

# A semantic snapshot already owns these immutable package facts. Reuse them
# in later call passes while keeping standalone preparation in the public
# wrapper above. Receiver types and admitted owner seeds remain separate.
public resolveModulesTypedWithPreparedFacts package: analysis.PackageAnalysis, semantic: typeIds.SemanticTypeSet, receiverTypeByCallAst: ref [Int; ~], resolvedTypes: ref [typeIds.SemanticType; ~], seededOwners: ref [Bool; ~], seededCalls: ref [ModuleCallResolution; ~], identities: ref [modules.ModuleIdentity; ~], imports: ref [modules.ImportEdge; ~], resolvedImports: ref [moduleResolve.ResolvedImport; ~], qualifiedResults: ref [qualified.QualifiedResolution; ~] -> [ModuleCallResolution; ~] {
    package -> indexTypedMethodReferences(semantic.references) => referenceIndex
    package -> prepareTypedMethodDeclarationFacts(semantic.references, identities, resolvedImports) => declarations
    package -> declaredIntrinsicCallableNames => declaredIntrinsicNames
    [Bool; ~] => resolvedNameByAst!
    package.nodes -> each node { resolvedNameByAst! -> push(false) }
    [ModuleCallResolution; ~] => results!
    seededCalls -> each call {
        call.sourceModule >= 0 and call.sourceModule < (seededOwners -> len) and seededOwners[call.sourceModule]
            -> if { results! -> push(call) }
    }
    0 => bareSourceIndex!
    bareSourceIndex! < (package.ranges -> len) -> while {
        bareSourceIndex! < (seededOwners -> len) and seededOwners[bareSourceIndex!]
            -> if {
                bareSourceIndex! + 1 => bareSourceIndex!
                continue
            }
        package.ranges[bareSourceIndex!] => bareRange
        package.sources[bareSourceIndex!] -> len => bareSourceLength
        package.sources[bareSourceIndex!] -> slice(UIntSize(0), bareSourceLength) => bareSource
        0 => bareNameOffset!
        bareNameOffset! < bareRange.nameCount -> while {
            package.names[bareRange.nameStart + bareNameOffset!] => bareName
            bareName.astNode >= 0 and bareName.astNode < bareRange.astCount
                -> if { true => resolvedNameByAst![bareRange.astStart + bareName.astNode] }
            bareName.astNode >= 0 and bareName.astNode < bareRange.astCount
                and bareName.symbol >= 0 and bareName.symbol < bareRange.symbolCount
                -> if {
                    package.nodes[bareRange.astStart + bareName.astNode] => bareNameNode
                    package.symbols[bareRange.symbolStart + bareName.symbol] => bareTarget
                    bareNameNode.kind == 15 and (bareTarget.kind == 7 or bareTarget.kind == 31)
                        -> if {
                            results! -> push(ModuleCallResolution {
                                sourceModule: bareSourceIndex!
                                callAst: bareName.astNode
                                origin: 0
                                targetModule: bareSourceIndex!
                                targetSourceModule: bareSourceIndex!
                                functionSymbol: bareName.symbol
                                status: bareTarget.secondaryTypeNode >= 0 -> if { 4 } else { 5 }
                            })
                        }
                }
            bareNameOffset! + 1 => bareNameOffset!
        }
        0 => bareAstOffset!
        bareAstOffset! < bareRange.astCount -> while {
            package.nodes[bareRange.astStart + bareAstOffset!] => bareNode
            bareNode.kind == 15 -> if {
                resolvedNameByAst![bareRange.astStart + bareAstOffset!] => bareResolved
                not bareResolved -> if {
                    package.tokens[bareRange.tokenStart + bareNode.payloadToken] => bareToken
                    RuntimeNameRequest { source: bareSource, token: bareToken } -> runtimeFunctionSymbol => bareRuntimeSymbol
                    bareRuntimeSymbol < -1 -> if {
                        results! -> push(ModuleCallResolution {
                            sourceModule: bareSourceIndex!
                            callAst: bareAstOffset!
                            origin: 2
                            targetModule: bareSourceIndex!
                            targetSourceModule: -1
                            functionSymbol: bareRuntimeSymbol
                            status: bareRuntimeSymbol == -108 or bareRuntimeSymbol == -111 or bareRuntimeSymbol == -112 or bareRuntimeSymbol == -114 or bareRuntimeSymbol == -118 or bareRuntimeSymbol == -119
                                -> if { 5 } else { 4 }
                        })
                    }
                }
            }
            bareAstOffset! + 1 => bareAstOffset!
        }
        bareSourceIndex! + 1 => bareSourceIndex!
    }
    0 => sourceIndex!
    sourceIndex! < (package.sources -> len) -> while {
        sourceIndex! < (seededOwners -> len) and seededOwners[sourceIndex!]
            -> if {
                sourceIndex! + 1 => sourceIndex!
                continue
            }
        sourceIndex! -> resolveSourceTypedWithDeclarations(package, semantic, identities, imports, resolvedImports, qualifiedResults, declaredIntrinsicNames, receiverTypeByCallAst, resolvedTypes, declarations, referenceIndex) => sourceResults
        0 => sourceResultIndex!
        sourceResultIndex! < (sourceResults -> len) -> while {
            results! -> push(sourceResults[sourceResultIndex!])
            sourceResultIndex! + 1 => sourceResultIndex!
        }
        sourceIndex! + 1 => sourceIndex!
    }
    [ModuleCallResolution; ~] => filteredResults!
    # Duplicate errors are local to one source AST and function identity.
    # Keep accepted order while avoiding a scan of every earlier call.
    # The final bucket retains nonaddressable seeded rows under the same
    # complete key comparison; it never assigns them a valid AST identity.
    [Int; ~] => firstErrorByAst!
    [Int; ~] => nextErrorByResult!
    0 => errorBucketSeed!
    errorBucketSeed! <= (package.nodes -> len) -> while {
        firstErrorByAst! -> push(-1)
        errorBucketSeed! + 1 => errorBucketSeed!
    }
    0 => resultIndex!
    resultIndex! < (results! -> len) -> while {
        results![resultIndex!] => result
        result.status != 6 -> if {
            false => duplicateError!
            (package.nodes -> len) => errorBucket!
            result.status == 5 -> if {
                result.sourceModule >= 0 and result.sourceModule < (package.ranges -> len)
                    -> if {
                        package.ranges[result.sourceModule] => errorRange
                        result.callAst >= 0 and result.callAst < errorRange.astCount
                            and errorRange.astStart >= 0 and errorRange.astStart < (package.nodes -> len)
                            and result.callAst < (package.nodes -> len) - errorRange.astStart
                            -> if { errorRange.astStart + result.callAst => errorBucket! }
                    }
                firstErrorByAst![errorBucket!] => previousError!
                previousError! >= 0 and not duplicateError! -> while {
                    filteredResults![previousError!] => previous
                    previous.status == 5 and previous.sourceModule == result.sourceModule
                        and previous.callAst == result.callAst and previous.functionSymbol == result.functionSymbol
                        -> if { true => duplicateError! }
                    nextErrorByResult![previousError!] => previousError!
                }
            }
            not duplicateError! -> if {
                filteredResults! -> len => acceptedIndex
                filteredResults! -> push(result)
                nextErrorByResult! -> push(-1)
                result.status == 5 -> if {
                    firstErrorByAst![errorBucket!] => nextErrorByResult![acceptedIndex]
                    acceptedIndex => firstErrorByAst![errorBucket!]
                }
            }
        }
        resultIndex! + 1 => resultIndex!
    }
    filteredResults! -> commitAnalyzedGlobalFunctionAliases(package, identities)
    filteredResults!
}

public resolveModulesTyped package: analysis.PackageAnalysis, semantic: typeIds.SemanticTypeSet -> [ModuleCallResolution; ~] {
