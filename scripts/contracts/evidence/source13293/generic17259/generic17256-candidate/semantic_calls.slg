        -> while {
            sources[preparedSourceCopyIndex367!] => preparedSource
            preparedSources! -> push(preparedSource)
            preparedSourceCopyIndex367! + 1 => preparedSourceCopyIndex367!
        }
    ModuleCallRequest {
        sources: preparedSources!
        modules: identities
        qualified: qualifiedResults
    } => request
    request -> resolveModulesPrepared => results
    results
}

public resolveModulesTypedWithReceiverTypes package: analysis.PackageAnalysis, semantic: typeIds.SemanticTypeSet, receiverTypeByCallAst: ref [Int; ~], resolvedTypes: ref [typeIds.SemanticType; ~] -> [ModuleCallResolution; ~] {
