        -> if { true => intrinsic! }
    intrinsic!
}

# Intrinsic vocabulary is contextual, not reserved. Index only declarations
# whose spelling can collide, once per package. Include source functions in
# sibling namespace files as well as methods; lexical lookup already handles
# same-file functions. Existing typed fallback retains actual builtin calls
# when neither scoped source lookup nor exact receiver lookup selects a declaration.
declaredIntrinsicCallableNames package: ref analysis.PackageAnalysis -> [DeclaredIntrinsicCallableName; ~] {
    [DeclaredIntrinsicCallableName; ~] => names!
    0 => rangeIndex!
    rangeIndex! < (package.ranges -> len) -> while {
        package.ranges[rangeIndex!] => candidateRange
        package.sources[candidateRange.sourceModule] -> len => candidateSourceLength
        package.sources[candidateRange.sourceModule]
            -> slice(UIntSize(0), candidateSourceLength) => candidateSource
        0 => symbolOffset!
        symbolOffset! < candidateRange.symbolCount -> while {
            package.symbols[candidateRange.symbolStart + symbolOffset!] => candidate
            (candidate.kind == 7 or candidate.kind == 31) and candidate.nameToken >= 0
                and not (candidate -> symbols.hasQualifiedFunctionName(package.tokens, candidateRange.tokenStart, candidateRange.tokenCount))
                -> if {
                    candidateRange.tokenStart + candidate.nameToken => candidateNameToken
                    package.tokens[candidateNameToken] => candidateName
                    RuntimeNameRequest { source: candidateSource, token: candidateName }
                        -> intrinsicFlowTarget => intrinsicName
                    intrinsicName -> if {
                        names! -> push(DeclaredIntrinsicCallableName {
                            sourceModule: candidateRange.sourceModule
                            nameToken: candidateNameToken
                            sourceFunction: candidate.kind == 7
                            publicDeclaration: candidate.flags / 4 % 2 == 1
                        })
                    }
                }
            symbolOffset! + 1 => symbolOffset!
        }
        rangeIndex! + 1 => rangeIndex!
    }
    names!
}

# Namespace visibility follows lexical selection; a declaration from another
# namespace is available through a direct import only when it is public.
public sourceFunctionVisibleFrom package: ref analysis.PackageAnalysis, identities: ref [modules.ModuleIdentity; ~], resolvedImports: ref [moduleResolve.ResolvedImport; ~], sourceIndex: Int, targetSource: Int, publicDeclaration: Bool -> Bool {
    modules.sameLogicalAnalyzedSource(package.sources, identities, sourceIndex, targetSource, package.tokens, package.ranges)
        -> if { true -> return }
    not publicDeclaration -> if { false -> return }
    resolvedImports -> each imported {
        imported.sourceModule == sourceIndex and imported.status == 0
            and imported.targetModule >= 0 and imported.targetModule < (identities -> len)
            and modules.sameLogicalAnalyzedSource(package.sources, identities, identities[imported.targetModule].sourceIndex, targetSource, package.tokens, package.ranges)
            -> if { true -> return }
    }
    false
}

public struct SourceFunctionCandidate {
    public sourceModule: Int
    public symbol: Int
    public importEdge: Int
}

appendNamespaceSourceFunctions package: ref analysis.PackageAnalysis, identities: ref [modules.ModuleIdentity; ~], resolvedImports: ref [moduleResolve.ResolvedImport; ~], sourceIndex: Int, namespaceSource: Int, importEdge: Int, name: Text, candidates: mut [SourceFunctionCandidate; ~] -> Unit {
    package.ranges -> each range {
        modules.sameLogicalAnalyzedSource(package.sources, identities, namespaceSource, range.sourceModule, package.tokens, package.ranges)
            -> if {
                0 => symbolIndex!
                symbolIndex! < range.symbolCount -> while {
                    package.symbols[range.symbolStart + symbolIndex!] => declaration
                    declaration.kind == 7 and declaration.parent < 0 and declaration.nameToken >= 0
                        and not (declaration -> symbols.hasQualifiedFunctionName(package.tokens, range.tokenStart, range.tokenCount))
                        -> if {
                            package.tokens[range.tokenStart + declaration.nameToken] => token
                            package.sources[range.sourceModule] -> slice(token.span.start, token.span.length) => declaredName
                            declaredName == name
                                and (package -> sourceFunctionVisibleFrom(identities, resolvedImports, sourceIndex, range.sourceModule, declaration.flags / 4 % 2 == 1))
                                -> if {
                                    false => duplicate!
                                    candidates -> each previous {
                                        previous.sourceModule == range.sourceModule and previous.symbol == symbolIndex!
                                            -> if { true => duplicate! }
                                    }
                                    not duplicate! -> if {
                                        candidates -> push(SourceFunctionCandidate {
                                            sourceModule: range.sourceModule, symbol: symbolIndex!, importEdge: importEdge
                                        })
                                    }
                                }
                        }
                    symbolIndex! + 1 => symbolIndex!
                }
            }
    }
}

# Local lexical declarations are selected by the caller. Namespace declarations
# precede imported declarations, whose order follows the source import list.
public sourceFunctionCandidates package: ref analysis.PackageAnalysis, identities: ref [modules.ModuleIdentity; ~], resolvedImports: ref [moduleResolve.ResolvedImport; ~], sourceIndex: Int, name: Text -> [SourceFunctionCandidate; ~] {
    [SourceFunctionCandidate; ~] => candidates!
    package -> appendNamespaceSourceFunctions(identities, resolvedImports, sourceIndex, sourceIndex, -1, name, candidates!)
    (candidates! -> len) > 0 -> if { candidates! -> return }
    resolvedImports -> each imported {
        imported.sourceModule == sourceIndex and imported.status == 0
            and imported.targetModule >= 0 and imported.targetModule < (identities -> len)
            -> if {
                package -> appendNamespaceSourceFunctions(identities, resolvedImports, sourceIndex, identities[imported.targetModule].sourceIndex, imported.edge, name, candidates!)
            }
    }
    candidates!
}

declaredPackageCallableKind package: ref analysis.PackageAnalysis, sourceIndex: Int, name: syntax.SyntaxToken, names: ref [DeclaredIntrinsicCallableName; ~], identities: ref [modules.ModuleIdentity; ~], resolvedImports: ref [moduleResolve.ResolvedImport; ~] -> Int {
    0 => selectedKind!
    0 => nameIndex!
    nameIndex! < (names -> len) -> while {
        names[nameIndex!] => candidate
        package.tokens[candidate.nameToken] => candidateName
        candidateName.span.length == name.span.length => equal!
        UIntSize(0) => byteIndex!
        equal! and byteIndex! < name.span.length -> while {
            package.sources[candidate.sourceModule]
                -> byte(candidateName.span.start + byteIndex!) => candidateByte
            package.sources[sourceIndex]
                -> byte(name.span.start + byteIndex!) => nameByte
            candidateByte != nameByte -> if { false => equal! }
            byteIndex! + 1 => byteIndex!
        }
        equal! -> if {
            candidate.sourceFunction -> if {
                package -> sourceFunctionVisibleFrom(identities, resolvedImports, sourceIndex, candidate.sourceModule, candidate.publicDeclaration)
                    -> if { 2 -> return }
            } else { 1 => selectedKind! }
        }
        nameIndex! + 1 => nameIndex!
    }
    selectedKind!
}

# Search each lexical scope before its parent so local declarations shadow
# module functions. Both single-source and package calls share this authority.
struct LexicalFunctionIndex {
    functionSymbolByAst: [Int; ~]
    firstFunctionByScope: [Int; ~]
    nextFunctionBySymbol: [Int; ~]
}

indexLexicalFunctions tokens: ref [syntax.SyntaxToken; ~], table: ref [symbols.Symbol; ~], tokenStart: Int, tokenCount: Int, symbolStart: Int, symbolCount: Int, astCount: Int -> LexicalFunctionIndex {
    [Int; ~] => functionSymbolByAst!
    0 => astIndex!
    astIndex! <= astCount -> while {
        functionSymbolByAst! -> push(-1)
        astIndex! + 1 => astIndex!
    }
    [Int; ~] => firstFunctionByScope!
    0 => scopeIndex!
    scopeIndex! <= symbolCount -> while {
        firstFunctionByScope! -> push(-1)
        scopeIndex! + 1 => scopeIndex!
    }
    [Int; ~] => nextFunctionBySymbol!
    0..<symbolCount -> each symbol {
        nextFunctionBySymbol! -> push(-1)
        table[symbolStart + symbol] => declaration
        (declaration.kind == 7 or declaration.kind == 31)
            and declaration.astNode >= -1 and declaration.astNode < astCount
            -> if {
                declaration.astNode + 1 => slot
                functionSymbolByAst![slot] < 0 -> if { symbol => functionSymbolByAst![slot] }
            }
    }
    # Reverse insertion keeps the original ascending declaration search order.
    symbolCount - 1 => symbol!
    symbol! >= 0 -> while {
        table[symbolStart + symbol!] => declaration
        (declaration.kind == 7 or declaration.kind == 31)
            and declaration.parent >= -1 and declaration.parent < symbolCount
            and not (declaration -> symbols.hasQualifiedFunctionName(tokens, tokenStart, tokenCount))
            -> if {
                declaration.parent + 1 => scope
                firstFunctionByScope![scope] => nextFunctionBySymbol![symbol!]
                symbol! => firstFunctionByScope![scope]
            }
        symbol! - 1 => symbol!
    }
    LexicalFunctionIndex { functionSymbolByAst: functionSymbolByAst!, firstFunctionByScope: firstFunctionByScope!, nextFunctionBySymbol: nextFunctionBySymbol! }
}

resolveLexicalFunction source: Text, nodes: ref [ast.AstNode; ~], tokens: ref [syntax.SyntaxToken; ~], table: ref [symbols.Symbol; ~], index: ref LexicalFunctionIndex, nodeStart: Int, tokenStart: Int, symbolStart: Int, parentAst: Int, nameToken: Int, callKind: Int -> Int {
    parentAst => callerAst!
    -1 => callerFunctionAst!
    callerAst! >= 0 and callerFunctionAst! < 0 -> while {
        nodes[nodeStart + callerAst!] => callerNode
        callerNode.kind == 7 or callerNode.kind == 31
            -> if { callerAst! => callerFunctionAst! } else { callerNode.parent => callerAst! }
    }
    index.functionSymbolByAst[callerFunctionAst! + 1] => scope!
    tokens[tokenStart + nameToken] => callName
    scope! >= -1 -> while {
        index.firstFunctionByScope[scope! + 1] => symbolIndex!
        symbolIndex! >= 0 -> while {
            table[symbolStart + symbolIndex!] => candidate
            tokens[tokenStart + candidate.nameToken] => functionName
            callName.span.length == functionName.span.length => equal!
            UIntSize(0) => nameByte!
            equal! and nameByte! < callName.span.length -> while {
                (source -> byte(callName.span.start + nameByte!)) != (source -> byte(functionName.span.start + nameByte!))
                    -> if { false => equal! }
                nameByte! + 1 => nameByte!
            }
            equal! and (callKind == 10 or callKind == 11 or callKind == 48 or callKind == 77 or candidate.secondaryTypeNode < 0)
                -> if { symbolIndex! -> return }
            index.nextFunctionBySymbol[symbolIndex!] => symbolIndex!
        }
        scope! >= 0 -> if { table[symbolStart + scope!].parent => scope! } else { -2 => scope! }
    }
    -1
}

# Compiler-provided scalar File members belong to the canonical resource
# receiver, before a same-name free function can infer generic arguments.
compilerProvidedFileScalarReceiver package: ref analysis.PackageAnalysis, identities: ref [modules.ModuleIdentity; ~], types: ref [typeIds.SemanticType; ~], receiverTypeId: Int, writer: Bool -> Bool {
    types -> typeIds.materializedReadTypeId(receiverTypeId) => typeId
    typeId < 0 or typeId >= (types -> len) -> if { false -> return }
    types[typeId] => receiver
    receiver.kind != 1 or (receiver.origin != 0 and receiver.origin != 2)
        or receiver.module < 0 or receiver.module >= (package.ranges -> len)
        -> if { false -> return }
    false => fileModule!
    identities -> each identity {
        identity.sourceIndex == receiver.module -> if {
            (package.sources[identity.sourceIndex] -> slice(identity.pathStart, identity.pathLength)) == "sys.file"
                -> if { true => fileModule! }
        }
    }
    not fileModule! -> if { false -> return }
    package.ranges[receiver.module] => range
    receiver.symbol < 0 or receiver.symbol >= range.symbolCount
        -> if { false -> return }
    package.symbols[range.symbolStart + receiver.symbol] => declaration
    declaration.kind != 3 or declaration.parent >= 0 or declaration.nameToken < 0
        -> if { false -> return }
    package.tokens[range.tokenStart + declaration.nameToken] => token
    package.sources[receiver.module] -> slice(token.span.start, token.span.length) => name
    writer -> if { name == "FileWriter" } else { name == "File" }
}

# Status 0 is a resolved local function and 2 is an unresolved call target.
public resolve source: Text -> [CallResolution; ~] {
    source -> ast.lower => nodes
    source -> lexer.lex => tokens
    nodes -> symbols.collectPreparedWithTokens(tokens) => table
    indexLexicalFunctions(tokens, table, 0, tokens -> len, 0, table -> len, nodes -> len) => lexicalFunctions
    [CallResolution; ~] => resolved!
    0 => astIndex!
    astIndex! < (nodes -> len) -> while {
        nodes[astIndex!] => node
        false => hasControlTarget!
        false => hasFlowCallTarget!
        false => hasQualifiedFlowTarget!
        0 => controlTargetSearch!
        controlTargetSearch! < (nodes -> len) -> while {
            nodes[controlTargetSearch!].parent == astIndex! and (nodes[controlTargetSearch!].kind == 42 or nodes[controlTargetSearch!].kind == 44)
                -> if { true => hasControlTarget! }
            controlTargetSearch! + 1 => controlTargetSearch!
        }
        0 => flowTargetSearch!
        flowTargetSearch! < (nodes -> len) -> while {
            nodes[flowTargetSearch!].parent == astIndex! and nodes[flowTargetSearch!].kind == 16
                -> if { true => hasFlowCallTarget! }
            flowTargetSearch! + 1 => flowTargetSearch!
        }
        node.firstToken => flowTokenIndex!
        node.kind == 10 and flowTokenIndex! < node.firstToken + node.tokenCount
            -> while {
                tokens[flowTokenIndex!].kind == grammar.tokenIdDot()
                    -> if { true => hasQualifiedFlowTarget! }
                flowTokenIndex! + 1 => flowTokenIndex!
            }
        (node.kind == 10 and hasFlowCallTarget!) or (node.kind == 11 and (node.cstRuleId == grammar.ruleIdCallExpression() or node.cstRuleId == grammar.ruleIdTypeApplicationExpression())) or node.kind == 48 or node.kind == 77
            -> if {
                -1 => callNameToken!
                node.kind == 48 or node.kind == 77 -> if { node.payloadToken => callNameToken! }
                node.kind == 10 -> if {
                    0 => flowNameSearch!
                    flowNameSearch! < (nodes -> len) -> while {
                        nodes[flowNameSearch!].parent == astIndex!
                            and nodes[flowNameSearch!].kind == 16
                            and nodes[flowNameSearch!].payloadToken > callNameToken!
                            -> if {
                                nodes[flowNameSearch!].payloadToken => callNameToken!
                            }
                        flowNameSearch! + 1 => flowNameSearch!
                    }
                }
                node.firstToken => tokenIndex!
                false => inFlowTypeArgument!
                false => inFlowCallArguments!
                tokenIndex! < node.firstToken + node.tokenCount and node.kind != 48 and node.kind != 77 and callNameToken! < 0
                    -> while {
                        tokens[tokenIndex!].kind == grammar.tokenIdLess()
                            -> if { true => inFlowTypeArgument! }
                        tokens[tokenIndex!].kind == grammar.tokenIdGreater()
                            -> if { false => inFlowTypeArgument! }
                        tokens[tokenIndex!].kind == grammar.tokenIdLeftParen()
                            -> if { true => inFlowCallArguments! }
                        tokens[tokenIndex!].kind == grammar.tokenIdRightParen()
                            -> if { false => inFlowCallArguments! }
                        tokens[tokenIndex!].kind == grammar.tokenIdIdentifier() and not inFlowTypeArgument! and not inFlowCallArguments!
                            -> if { tokenIndex! => callNameToken! }
                        tokenIndex! + 1 => tokenIndex!
                    }
                callNameToken! >= 0 -> if {
                    resolveLexicalFunction(source, nodes, tokens, table, lexicalFunctions, 0, 0, 0, node.parent, callNameToken!, node.kind) => functionSymbol
                    RuntimeNameRequest { source: source, token: tokens[callNameToken!] } -> intrinsicFlowTarget => intrinsicFlow!
                    callNameToken! > node.firstToken and tokens[callNameToken! - 1].kind == grammar.tokenIdDot()
                        -> if { false => intrinsicFlow! }
                    functionSymbol >= 0 or (not intrinsicFlow! and (node.kind == 10 or node.kind == 11 or node.kind == 48 or node.kind == 77))
                        -> if {
                            2 => callStatus!
                            functionSymbol >= 0 -> if { 0 => callStatus! }
                            resolved! -> push(CallResolution {
                                callAst: astIndex!
                                nameToken: callNameToken!
                                functionSymbol: functionSymbol
                                status: callStatus!
                            })
                        }
                }
            }
        astIndex! + 1 => astIndex!
    }
    resolved!
}

# Origins: 0 local function, 1 imported function. Imported statuses preserve
# qualified lookup: 0 public, 2 missing/non-function, 3 non-public.
public resolveModulesPrepared request: move ModuleCallRequest -> [ModuleCallResolution; ~] {
    request.sources -> analysis.analyze => identityPackage
    [modules.ModuleIdentity; ~] => identities!
    0 => identityCopyIndex180!
    identityCopyIndex180! < (request.modules -> len)
        -> while {
            request.modules[identityCopyIndex180!] => identity
            identities! -> push(identity)
            identityCopyIndex180! + 1 => identityCopyIndex180!
        }
    [qualified.QualifiedResolution; ~] => qualifiedResults!
    0 => qualifiedResultCopyIndex182!
    qualifiedResultCopyIndex182! < (request.qualified -> len)
        -> while {
            request.qualified[qualifiedResultCopyIndex182!] => qualifiedResult
            qualifiedResults! -> push(qualifiedResult)
            qualifiedResultCopyIndex182! + 1 => qualifiedResultCopyIndex182!
        }
    [ModuleCallResolution; ~] => results!
    0 => sourceIndex!
    sourceIndex! < (request.sources -> len) -> while {
        request.sources[sourceIndex!] => source
        source -> ast.lower => nodes
        source -> lexer.lex => tokens
        nodes -> symbols.collectPreparedWithTokens(tokens) => table
        indexLexicalFunctions(tokens, table, 0, tokens -> len, 0, table -> len, nodes -> len) => lexicalFunctions
        [CallResolution; ~] => localCalls!
        nodes -> indexQualifiedPathCallOwners(0, nodes -> len) => qualifiedPathCallOwners
        0 => callAstIndex!
        callAstIndex! < (nodes -> len) -> while {
            nodes[callAstIndex!] => callNode
            false => moduleHasControlTarget!
            false => moduleHasFlowCallTarget!
            false => moduleHasQualifiedFlowTarget!
            0 => moduleControlTargetSearch!
            moduleControlTargetSearch! < (nodes -> len) -> while {
                nodes[moduleControlTargetSearch!].parent == callAstIndex! and (nodes[moduleControlTargetSearch!].kind == 42 or nodes[moduleControlTargetSearch!].kind == 44)
                    -> if { true => moduleHasControlTarget! }
                moduleControlTargetSearch! + 1 => moduleControlTargetSearch!
            }
            0 => moduleFlowTargetSearch!
            moduleFlowTargetSearch! < (nodes -> len) -> while {
                nodes[moduleFlowTargetSearch!].parent == callAstIndex! and nodes[moduleFlowTargetSearch!].kind == 16
                    -> if { true => moduleHasFlowCallTarget! }
                moduleFlowTargetSearch! + 1 => moduleFlowTargetSearch!
            }
            callNode.firstToken => moduleFlowTokenIndex!
            callNode.kind == 10 and moduleFlowTokenIndex! < callNode.firstToken + callNode.tokenCount
                -> while {
                    tokens[moduleFlowTokenIndex!].kind == grammar.tokenIdDot()
                        -> if { true => moduleHasQualifiedFlowTarget! }
                    moduleFlowTokenIndex! + 1 => moduleFlowTokenIndex!
                }
            false => moduleHasQualifiedCallTarget!
            0 => moduleQualifiedCallSearch!
            moduleQualifiedCallSearch! < (qualifiedResults! -> len)
                -> while {
                    qualifiedResults![moduleQualifiedCallSearch!] => moduleQualifiedCall
                    moduleQualifiedCall.sourceModule == sourceIndex!
                        and moduleQualifiedCall.pathAst >= 0
                        and moduleQualifiedCall.pathAst < (nodes -> len)
                        and nodes[moduleQualifiedCall.pathAst].kind == 36
                        and ((nodes[moduleQualifiedCall.pathAst].parent == callAstIndex! and qualifiedPathCallOwners[moduleQualifiedCall.pathAst] < 0)
                        or qualifiedPathCallOwners[moduleQualifiedCall.pathAst] == callAstIndex!)
                        -> if {
                            false => moduleQualifiedTargetCallable!
                            moduleQualifiedCall.status == 0
                                and moduleQualifiedCall.targetModule >= 0
                                and moduleQualifiedCall.targetModule < (identities! -> len)
                                -> if {
                                    identities![moduleQualifiedCall.targetModule].sourceIndex => moduleQualifiedTargetSource
                                    moduleQualifiedTargetSource >= 0 and moduleQualifiedTargetSource < (request.sources -> len)
                                        -> if {
                                            request.sources[moduleQualifiedTargetSource] -> symbols.collect => moduleQualifiedTargetSymbols
                                            moduleQualifiedCall.targetSymbol >= 0 and moduleQualifiedCall.targetSymbol < (moduleQualifiedTargetSymbols -> len)
                                                -> if {
                                                    moduleQualifiedTargetSymbols[moduleQualifiedCall.targetSymbol].kind => moduleQualifiedTargetKind
                                                    moduleQualifiedTargetKind == 7 or moduleQualifiedTargetKind == 31 or moduleQualifiedTargetKind == 36
                                                        -> if {
                                                            true => moduleQualifiedTargetCallable!
                                                        }
                                                }
                                        }
                                }
                            moduleQualifiedTargetCallable!
                                -> if { true => moduleHasQualifiedCallTarget! }
                        }
                    moduleQualifiedCallSearch! + 1 => moduleQualifiedCallSearch!
                }
            false => moduleHasGeneratedComTarget!
            0 => moduleComQualifiedSearch!
            moduleComQualifiedSearch! < (qualifiedResults! -> len)
                -> while {
                    qualifiedResults![moduleComQualifiedSearch!] => moduleComQualified
                    moduleComQualified.sourceModule == sourceIndex! and moduleComQualified.pathAst == callAstIndex! and moduleComQualified.targetSymbol >= 0 and moduleComQualified.targetSymbol < (table -> len)
                        -> if {
                            table[moduleComQualified.targetSymbol].kind == 36
                                -> if { true => moduleHasGeneratedComTarget! }
                        }
                    moduleComQualifiedSearch! + 1 => moduleComQualifiedSearch!
                }
            false => moduleGeneratedComHasCallOwner!
            callNode.kind == 36 and callNode.parent >= 0
                -> if {
                    nodes[callNode.parent] => generatedComParent
                    generatedComParent.kind == 10
                        or generatedComParent.kind == 11
                        or generatedComParent.kind == 48 -> if {
                            true => moduleGeneratedComHasCallOwner!
                        }
                }
            (callNode.kind == 10 and (moduleHasFlowCallTarget! or moduleHasQualifiedCallTarget!)) or (callNode.kind == 11 and (callNode.cstRuleId == grammar.ruleIdCallExpression() or callNode.cstRuleId == grammar.ruleIdTypeApplicationExpression())) or callNode.kind == 48 or callNode.kind == 77 or (callNode.kind == 36 and moduleHasGeneratedComTarget! and not moduleGeneratedComHasCallOwner!)
                -> if {
                    -1 => callNameToken!
                    callNode.kind == 48 or callNode.kind == 77 -> if { callNode.payloadToken => callNameToken! }
                    callNode.kind == 36 -> if {
                        callNode.firstToken => comCallNameSearch!
                        comCallNameSearch! < callNode.firstToken + callNode.tokenCount
                            -> while {
                                tokens[comCallNameSearch!].kind == grammar.tokenIdIdentifier()
                                    -> if { comCallNameSearch! => callNameToken! }
                                comCallNameSearch! + 1 => comCallNameSearch!
                            }
                    }
                    callNode.kind == 10 -> if {
                        0 => moduleFlowNameSearch!
                        moduleFlowNameSearch! < (nodes -> len) -> while {
                            nodes[moduleFlowNameSearch!].parent == callAstIndex!
                                and nodes[moduleFlowNameSearch!].kind == 16
                                and nodes[moduleFlowNameSearch!].payloadToken > callNameToken!
                                -> if {
