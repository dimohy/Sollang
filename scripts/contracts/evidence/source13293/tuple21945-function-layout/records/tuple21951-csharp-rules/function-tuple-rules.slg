namespace sollang.compiler.llvm.codegen_cache_key_policy

public blockOriginal: -> KeyRule {
    [KeyPart; ~] => parts!
    parts! -> push(KeyPart.BlockInput)
    parts! -> push(KeyPart.BlockResult)
    KeyRule {
        domain: "original"
        parts: parts!
    }
}

public blockReordered: -> KeyRule {
    [KeyPart; ~] => parts!
    parts! -> push(KeyPart.BlockResult)
    parts! -> push(KeyPart.BlockInput)
    KeyRule {
        domain: "original"
        parts: parts!
    }
}

public blockRelabeled: -> KeyRule {
    [KeyPart; ~] => parts!
    parts! -> push(KeyPart.BlockInput)
    parts! -> push(KeyPart.BlockResult)
    KeyRule {
        domain: "changed-label"
        parts: parts!
    }
}

public blockUnavailable: -> KeyRule {
    [KeyPart; ~] => parts!
    parts! -> push(KeyPart.Identity)
    KeyRule {
        domain: "original"
        parts: parts!
    }
}

public genericOriginal: -> KeyRule {
    [KeyPart; ~] => parts!
    parts! -> push(KeyPart.GenericPrimary)
    parts! -> push(KeyPart.GenericSecondary)
    parts! -> push(KeyPart.GenericTertiary)
    parts! -> push(KeyPart.GenericTraitBound)
    parts! -> push(KeyPart.GenericAssociatedName)
    parts! -> push(KeyPart.GenericAssociatedType)
    KeyRule {
        domain: "original"
        parts: parts!
    }
}

public genericReordered: -> KeyRule {
    [KeyPart; ~] => parts!
    parts! -> push(KeyPart.GenericAssociatedType)
    parts! -> push(KeyPart.GenericAssociatedName)
    parts! -> push(KeyPart.GenericTraitBound)
    parts! -> push(KeyPart.GenericTertiary)
    parts! -> push(KeyPart.GenericSecondary)
    parts! -> push(KeyPart.GenericPrimary)
    KeyRule {
        domain: "original"
        parts: parts!
    }
}

public genericRelabeled: -> KeyRule {
    [KeyPart; ~] => parts!
    parts! -> push(KeyPart.GenericPrimary)
    parts! -> push(KeyPart.GenericSecondary)
    parts! -> push(KeyPart.GenericTertiary)
    parts! -> push(KeyPart.GenericTraitBound)
    parts! -> push(KeyPart.GenericAssociatedName)
    parts! -> push(KeyPart.GenericAssociatedType)
    KeyRule {
        domain: "changed-label"
        parts: parts!
    }
}

public genericUnavailable: -> KeyRule {
    [KeyPart; ~] => parts!
    parts! -> push(KeyPart.Identity)
    KeyRule {
        domain: "original"
        parts: parts!
    }
}
