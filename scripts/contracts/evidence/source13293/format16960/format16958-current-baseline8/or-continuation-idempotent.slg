struct Fragment {
    parent: Int
    payloadStart: Int
    payloadLength: Int
}
main {
    Fragment { parent: -1, payloadStart: 0, payloadLength: 8 } => fragment
    2 => offset
    -1 => selectedFragment!
    0 => selectedLength!
    0 => fragmentIndex
    fragment.parent < 0 or offset >= fragment.payloadStart or offset < fragment.payloadStart + fragment.payloadLength
        or (selectedFragment! < 0 or fragment.payloadLength < selectedLength!)
        -> if {
            fragmentIndex => selectedFragment!
            fragment.payloadLength => selectedLength!
        }
    "$(selectedFragment!),$(selectedLength!)" -> println
}
