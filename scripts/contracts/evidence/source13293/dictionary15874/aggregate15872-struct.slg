struct Pair {
    left: Int
    right: Int
}

sum value: Pair -> Int => value.left + value.right

child value: Int -> async Int {
    yield
    value
}

calculate<T>: -> async Unit uses Console {
    child(7) => first
    child(9) => second
    Pair { left: first -> await, right: second -> await } => values
    "aggregate=$(values.left),$(values.right)" -> println
}

main {
    calculate<Int>() => one
    one -> await
    calculate<Bool>() => two
    two -> await
}
