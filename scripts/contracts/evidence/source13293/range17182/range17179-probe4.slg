import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.expression_type_ids as expressionTypes
import sollang.compiler.semantic.storage_placement_source_index as sourceIndex
import sollang.compiler.semantic.storage_placement_units as sourceUnits
import sollang.compiler.semantic.storage_placement_inline_frames as inlineFrames
import sollang.compiler.semantic.storage_placement_callers as callers
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.diagnostics as diagnostics
import sys.process as process

struct Query { label: Text, name: Text, line: Int }

location nodeIndex: Int, source: Text, prepared: ref semanticContext.SemanticSnapshot, indexed: ref sourceIndex.SourceIndex, units: ref sourceUnits.UnitPlan, sourceModule: Int -> diagnostics.SourceLocation {
    prepared.package.ranges[sourceModule] => range
    prepared.package.nodes[range.astStart + nodeIndex] => node
    node.start => offset!
    node.kind == 9 -> if {
        prepared.package.tokens[range.tokenStart + node.payloadToken].span.start => offset!
    }
    units.units -> each unit { unit.astNode == nodeIndex -> if {
            prepared.package.tokens[range.tokenStart + unit.locationToken].span.start => offset!
    } }
    source -> diagnostics.sourceLocation(offset!)
}

kindCode nodeIndex: Int, prepared: ref semanticContext.SemanticSnapshot, sourceModule: Int -> Int {
    prepared.package.ranges[sourceModule] => range
    prepared.package.nodes[range.astStart + nodeIndex] => node
    node.kind == 9 -> if { 2 -> return }
    node.kind == 38 -> if { 3 -> return }
    prepared.package -> typeIds.arrayStorageSyntax(sourceModule, nodeIndex) => storage
    storage.isRepeat -> if { 1 } else { 0 }
}

inspect paths: [Text; ~], queries: [Query] -> Unit uses Console, File, Process {
    paths -> semanticContext.prepareFiles => prepared!
    144 => prepared!.standardLibrarySourceCount
    prepared! -> semanticContext.freeze => prepared
    prepared -> expressionTypes.resolveContext => facts
    144 => sourceModule
    prepared.package.ranges[sourceModule] => range
    prepared.package.sources[sourceModule] -> len => length
    prepared.package.sources[sourceModule] -> slice(UIntSize(0), length) => source
    prepared -> inlineFrames.build(facts) -> when {
        Err(_) { process.exit(1) }
        Ok(pool) { range.astStart -> sourceIndex.build(range.astCount, prepared.package.nodes) -> when {
                Err(_) { process.exit(2) }
                Ok(indexed) { prepared.package -> sourceUnits.build(sourceModule, indexed) -> when {
                        Err(_) { process.exit(3) }
                        Ok(units) {
                            queries -> each query {
                                -1 => frame!
                                0 => i!
                                i! < range.astCount -> while {
                                    prepared.package.nodes[range.astStart + i!] => node
                                    query.line == 0 and node.kind == 8 -> if { i! => frame! }
                                    query.line > 0 and (node.kind == 7 or node.kind == 31)
                                        -> if {
                                            source -> diagnostics.sourceLocation(node.start) => location
                                            prepared.package.tokens[range.tokenStart + node.payloadToken] => name
                                            location.line == query.line and (source -> slice(name.span.start, name.span.length)) == query.name
                                                -> if { i! => frame! }
                                        }
                                    i! + 1 => i!
                                }
                                frame! < 0 -> if { process.exit(4) }
                                frame! -> callers.build(source, prepared, facts, sourceModule, indexed, units, pool) -> when {
                                    Err(_) { process.exit(5) }
                                    Ok(plan) {
                                        "$(query.label)|slots:$(plan.slots -> len)" -> println
                                        plan.slots -> each slot { "s|$(slot.size):$(slot.align)" -> println }
                                        plan.allocations -> each allocation {
                                            allocation.sourceAst -> kindCode(prepared, sourceModule) => kind
                                            allocation.sourceAst -> location(source, prepared, indexed, units, sourceModule) => location
                                            "a|$(allocation.sourceModule):$kind:$(location.line):$(location.column):$(allocation.slot):$(allocation.size)" -> println
                                        }
                                        plan.ends -> each ending {
                                            ending.unitAst -> location(source, prepared, indexed, units, sourceModule) => location
                                            "e|$(ending.sourceModule):$(location.line):$(location.column):$(ending.slot):$(ending.size)" -> println
                                        }
                                    }
                                }
                            }
                        }
                } }
        } }
    }
}

