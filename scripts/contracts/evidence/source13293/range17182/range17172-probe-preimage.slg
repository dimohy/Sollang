import sollang.compiler.semantic.storage_placement_merge as frameMerge
import sollang.compiler.semantic.storage_placement as placement
import sys.process as process

main {
    "offset-and-grouped-ends" -> println
    frameMerge.Frame { slots: [placement.Slot { size: 8, align: 8 }; ~], allocations: [frameMerge.Allocation { sourceModule: 0, sourceAst: 1, slot: 0, size: 4 }; ~], ends: [frameMerge.Ending { sourceModule: 0, unitAst: 10, slot: 0, size: 4 }; ~] } => frame0!
    [placement.Slot { size: -1, align: 8 }, placement.Slot { size: 16, align: 8 }, placement.Slot { size: 24, align: 8 }, placement.Slot { size: 4097, align: 1 }; ~] => slots0_0
    [frameMerge.Allocation { sourceModule: -1, sourceAst: -1, slot: -1, size: -1 }, frameMerge.Allocation { sourceModule: 0, sourceAst: 2, slot: 0, size: 12 }, frameMerge.Allocation { sourceModule: 0, sourceAst: 3, slot: 1, size: 24 }, frameMerge.Allocation { sourceModule: -2, sourceAst: -2, slot: -2, size: -2 }; ~] => allocations0_0
    [frameMerge.Ending { sourceModule: -1, unitAst: -1, slot: -1, size: -1 }, frameMerge.Ending { sourceModule: 0, unitAst: 20, slot: 0, size: 12 }, frameMerge.Ending { sourceModule: 0, unitAst: 20, slot: 1, size: 24 }, frameMerge.Ending { sourceModule: -2, unitAst: -2, slot: -2, size: -2 }; ~] => ends0_0
    frameMerge.FrameRange { slotStart: 1, slotCount: 2, allocationStart: 1, allocationCount: 2, endStart: 1, endCount: 2 } => range0_0
    frame0! -> frameMerge.mergeRange(slots0_0, allocations0_0, ends0_0, range0_0) -> when {
        Err(_) { process.exit(1) }
        Ok(accepted) { accepted -> println }
    }
    frame0!.slots -> each slot { "s:$(slot.size):$(slot.align)" -> println }
    frame0!.allocations -> each value { "a:$(value.sourceModule):$(value.sourceAst):$(value.slot):$(value.size)" -> println }
    frame0!.ends -> each value { "e:$(value.sourceModule):$(value.unitAst):$(value.slot):$(value.size)" -> println }
    "reject-whole-then-fit" -> println
    frameMerge.Frame { slots: [placement.Slot { size: 4000, align: 8 }; ~], allocations: [frameMerge.Allocation { sourceModule: 0, sourceAst: 1, slot: 0, size: 4000 }; ~], ends: [frameMerge.Ending; ~] } => frame1!
    [placement.Slot { size: -1, align: 8 }, placement.Slot { size: 64, align: 8 }, placement.Slot { size: 40, align: 8 }, placement.Slot { size: 4097, align: 1 }; ~] => slots1_0
    [frameMerge.Allocation { sourceModule: -1, sourceAst: -1, slot: -1, size: -1 }, frameMerge.Allocation { sourceModule: 0, sourceAst: 2, slot: 0, size: 64 }, frameMerge.Allocation { sourceModule: 0, sourceAst: 3, slot: 1, size: 40 }, frameMerge.Allocation { sourceModule: -2, sourceAst: -2, slot: -2, size: -2 }; ~] => allocations1_0
    [frameMerge.Ending { sourceModule: -1, unitAst: -1, slot: -1, size: -1 }, frameMerge.Ending { sourceModule: -2, unitAst: -2, slot: -2, size: -2 }; ~] => ends1_0
    frameMerge.FrameRange { slotStart: 1, slotCount: 2, allocationStart: 1, allocationCount: 2, endStart: 1, endCount: 0 } => range1_0
    frame1! -> frameMerge.mergeRange(slots1_0, allocations1_0, ends1_0, range1_0) -> when {
        Err(_) { process.exit(1) }
        Ok(accepted) { accepted -> println }
    }
    [placement.Slot { size: -1, align: 8 }, placement.Slot { size: 96, align: 8 }, placement.Slot { size: 4097, align: 1 }; ~] => slots1_1
    [frameMerge.Allocation { sourceModule: -1, sourceAst: -1, slot: -1, size: -1 }, frameMerge.Allocation { sourceModule: 0, sourceAst: 4, slot: 0, size: 96 }, frameMerge.Allocation { sourceModule: -2, sourceAst: -2, slot: -2, size: -2 }; ~] => allocations1_1
    [frameMerge.Ending { sourceModule: -1, unitAst: -1, slot: -1, size: -1 }, frameMerge.Ending { sourceModule: -2, unitAst: -2, slot: -2, size: -2 }; ~] => ends1_1
    frameMerge.FrameRange { slotStart: 1, slotCount: 1, allocationStart: 1, allocationCount: 1, endStart: 1, endCount: 0 } => range1_1
    frame1! -> frameMerge.mergeRange(slots1_1, allocations1_1, ends1_1, range1_1) -> when {
        Err(_) { process.exit(1) }
        Ok(accepted) { accepted -> println }
    }
    frame1!.slots -> each slot { "s:$(slot.size):$(slot.align)" -> println }
    frame1!.allocations -> each value { "a:$(value.sourceModule):$(value.sourceAst):$(value.slot):$(value.size)" -> println }
    frame1!.ends -> each value { "e:$(value.sourceModule):$(value.unitAst):$(value.slot):$(value.size)" -> println }
    "exact-budget" -> println
    frameMerge.Frame { slots: [placement.Slot { size: 4090, align: 8 }; ~], allocations: [frameMerge.Allocation; ~], ends: [frameMerge.Ending; ~] } => frame2!
    [placement.Slot { size: -1, align: 8 }, placement.Slot { size: 6, align: 8 }, placement.Slot { size: 4097, align: 1 }; ~] => slots2_0
    [frameMerge.Allocation { sourceModule: -1, sourceAst: -1, slot: -1, size: -1 }, frameMerge.Allocation { sourceModule: 0, sourceAst: 1, slot: 0, size: 6 }, frameMerge.Allocation { sourceModule: -2, sourceAst: -2, slot: -2, size: -2 }; ~] => allocations2_0
    [frameMerge.Ending { sourceModule: -1, unitAst: -1, slot: -1, size: -1 }, frameMerge.Ending { sourceModule: -2, unitAst: -2, slot: -2, size: -2 }; ~] => ends2_0
    frameMerge.FrameRange { slotStart: 1, slotCount: 1, allocationStart: 1, allocationCount: 1, endStart: 1, endCount: 0 } => range2_0
    frame2! -> frameMerge.mergeRange(slots2_0, allocations2_0, ends2_0, range2_0) -> when {
        Err(_) { process.exit(1) }
        Ok(accepted) { accepted -> println }
    }
    [placement.Slot { size: -1, align: 8 }, placement.Slot { size: 1, align: 8 }, placement.Slot { size: 4097, align: 1 }; ~] => slots2_1
    [frameMerge.Allocation { sourceModule: -1, sourceAst: -1, slot: -1, size: -1 }, frameMerge.Allocation { sourceModule: 0, sourceAst: 2, slot: 0, size: 1 }, frameMerge.Allocation { sourceModule: -2, sourceAst: -2, slot: -2, size: -2 }; ~] => allocations2_1
    [frameMerge.Ending { sourceModule: -1, unitAst: -1, slot: -1, size: -1 }, frameMerge.Ending { sourceModule: -2, unitAst: -2, slot: -2, size: -2 }; ~] => ends2_1
    frameMerge.FrameRange { slotStart: 1, slotCount: 1, allocationStart: 1, allocationCount: 1, endStart: 1, endCount: 0 } => range2_1
    frame2! -> frameMerge.mergeRange(slots2_1, allocations2_1, ends2_1, range2_1) -> when {
        Err(_) { process.exit(1) }
        Ok(accepted) { accepted -> println }
    }
    frame2!.slots -> each slot { "s:$(slot.size):$(slot.align)" -> println }
    frame2!.allocations -> each value { "a:$(value.sourceModule):$(value.sourceAst):$(value.slot):$(value.size)" -> println }
    frame2!.ends -> each value { "e:$(value.sourceModule):$(value.unitAst):$(value.slot):$(value.size)" -> println }
    "retain-primary-identities" -> println
    frameMerge.Frame { slots: [placement.Slot { size: 8, align: 8 }; ~], allocations: [frameMerge.Allocation { sourceModule: 0, sourceAst: 1, slot: 0, size: 4 }; ~], ends: [frameMerge.Ending { sourceModule: 0, unitAst: 10, slot: 0, size: 4 }; ~] } => frame3!
    [placement.Slot { size: -1, align: 8 }, placement.Slot { size: 16, align: 8 }, placement.Slot { size: 4097, align: 1 }; ~] => slots3_0
    [frameMerge.Allocation { sourceModule: -1, sourceAst: -1, slot: -1, size: -1 }, frameMerge.Allocation { sourceModule: 0, sourceAst: 1, slot: 0, size: 12 }, frameMerge.Allocation { sourceModule: 0, sourceAst: 2, slot: 0, size: 16 }, frameMerge.Allocation { sourceModule: -2, sourceAst: -2, slot: -2, size: -2 }; ~] => allocations3_0
    [frameMerge.Ending { sourceModule: -1, unitAst: -1, slot: -1, size: -1 }, frameMerge.Ending { sourceModule: 0, unitAst: 10, slot: 0, size: 12 }, frameMerge.Ending { sourceModule: 0, unitAst: 20, slot: 0, size: 16 }, frameMerge.Ending { sourceModule: -2, unitAst: -2, slot: -2, size: -2 }; ~] => ends3_0
    frameMerge.FrameRange { slotStart: 1, slotCount: 1, allocationStart: 1, allocationCount: 2, endStart: 1, endCount: 2 } => range3_0
    frame3! -> frameMerge.mergeRange(slots3_0, allocations3_0, ends3_0, range3_0) -> when {
        Err(_) { process.exit(1) }
        Ok(accepted) { accepted -> println }
    }
    frame3!.slots -> each slot { "s:$(slot.size):$(slot.align)" -> println }
    frame3!.allocations -> each value { "a:$(value.sourceModule):$(value.sourceAst):$(value.slot):$(value.size)" -> println }
    frame3!.ends -> each value { "e:$(value.sourceModule):$(value.unitAst):$(value.slot):$(value.size)" -> println }
    "retain-first-inline-identities" -> println
    frameMerge.Frame { slots: [placement.Slot; ~], allocations: [frameMerge.Allocation; ~], ends: [frameMerge.Ending; ~] } => frame4!
    [placement.Slot { size: -1, align: 8 }, placement.Slot { size: 8, align: 8 }, placement.Slot { size: 4097, align: 1 }; ~] => slots4_0
    [frameMerge.Allocation { sourceModule: -1, sourceAst: -1, slot: -1, size: -1 }, frameMerge.Allocation { sourceModule: 0, sourceAst: 1, slot: 0, size: 4 }, frameMerge.Allocation { sourceModule: -2, sourceAst: -2, slot: -2, size: -2 }; ~] => allocations4_0
    [frameMerge.Ending { sourceModule: -1, unitAst: -1, slot: -1, size: -1 }, frameMerge.Ending { sourceModule: 0, unitAst: 10, slot: 0, size: 4 }, frameMerge.Ending { sourceModule: -2, unitAst: -2, slot: -2, size: -2 }; ~] => ends4_0
    frameMerge.FrameRange { slotStart: 1, slotCount: 1, allocationStart: 1, allocationCount: 1, endStart: 1, endCount: 1 } => range4_0
    frame4! -> frameMerge.mergeRange(slots4_0, allocations4_0, ends4_0, range4_0) -> when {
        Err(_) { process.exit(1) }
        Ok(accepted) { accepted -> println }
    }
    [placement.Slot { size: -1, align: 8 }, placement.Slot { size: 16, align: 8 }, placement.Slot { size: 4097, align: 1 }; ~] => slots4_1
    [frameMerge.Allocation { sourceModule: -1, sourceAst: -1, slot: -1, size: -1 }, frameMerge.Allocation { sourceModule: 0, sourceAst: 1, slot: 0, size: 16 }, frameMerge.Allocation { sourceModule: -2, sourceAst: -2, slot: -2, size: -2 }; ~] => allocations4_1
    [frameMerge.Ending { sourceModule: -1, unitAst: -1, slot: -1, size: -1 }, frameMerge.Ending { sourceModule: 0, unitAst: 10, slot: 0, size: 16 }, frameMerge.Ending { sourceModule: -2, unitAst: -2, slot: -2, size: -2 }; ~] => ends4_1
    frameMerge.FrameRange { slotStart: 1, slotCount: 1, allocationStart: 1, allocationCount: 1, endStart: 1, endCount: 1 } => range4_1
    frame4! -> frameMerge.mergeRange(slots4_1, allocations4_1, ends4_1, range4_1) -> when {
        Err(_) { process.exit(1) }
        Ok(accepted) { accepted -> println }
    }
    frame4!.slots -> each slot { "s:$(slot.size):$(slot.align)" -> println }
    frame4!.allocations -> each value { "a:$(value.sourceModule):$(value.sourceAst):$(value.slot):$(value.size)" -> println }
    frame4!.ends -> each value { "e:$(value.sourceModule):$(value.unitAst):$(value.slot):$(value.size)" -> println }
    "empty-frames" -> println
    frameMerge.Frame { slots: [placement.Slot; ~], allocations: [frameMerge.Allocation; ~], ends: [frameMerge.Ending; ~] } => frame5!
    [placement.Slot { size: -1, align: 8 }, placement.Slot { size: 4097, align: 1 }; ~] => slots5_0
    [frameMerge.Allocation { sourceModule: -1, sourceAst: -1, slot: -1, size: -1 }, frameMerge.Allocation { sourceModule: -2, sourceAst: -2, slot: -2, size: -2 }; ~] => allocations5_0
    [frameMerge.Ending { sourceModule: -1, unitAst: -1, slot: -1, size: -1 }, frameMerge.Ending { sourceModule: -2, unitAst: -2, slot: -2, size: -2 }; ~] => ends5_0
    frameMerge.FrameRange { slotStart: 1, slotCount: 0, allocationStart: 1, allocationCount: 0, endStart: 1, endCount: 0 } => range5_0
    frame5! -> frameMerge.mergeRange(slots5_0, allocations5_0, ends5_0, range5_0) -> when {
        Err(_) { process.exit(1) }
        Ok(accepted) { accepted -> println }
    }
    frame5!.slots -> each slot { "s:$(slot.size):$(slot.align)" -> println }
    frame5!.allocations -> each value { "a:$(value.sourceModule):$(value.sourceAst):$(value.slot):$(value.size)" -> println }
    frame5!.ends -> each value { "e:$(value.sourceModule):$(value.unitAst):$(value.slot):$(value.size)" -> println }
}
