namespace sollang.compiler.semantic.type_ids
public struct SemanticType {
    public kind: Int
    public origin: Int
    public module: Int
    public symbol: Int
    public first: Int
    public second: Int
    public length: Int
    public lengthHash: UInt64
    public containsParameter: Bool
    public status: Int
}
public materializedReadTypeId types: ref [SemanticType; ~], typeId: Int -> Int {
    typeId >= 0 and typeId < (types -> len) and types[typeId].kind == 8
        -> if { types[typeId].first } else { typeId }
}
