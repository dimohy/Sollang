namespace c394.constant
public struct Literal { public astNode: Int, public value: Long }
findIndex literals: ref [Literal; ~], start: Int, count: Int, astNode: Int -> Int {
    start => low!
    start + count => high!
    low! < high! -> while {
        low! + (high! - low!) / 2 => middle
        literals[middle].astNode < astNode -> if {
            middle + 1 => low!
        } else { middle => high! }
    }
    low! < start + count and literals[low!].astNode == astNode
        -> if { low! } else { -1 }
}
public find literals: ref [Literal; ~], start: Int, count: Int, astNode: Int -> Option<Long> {
    literals -> findIndex(start, count, astNode) => index
    index >= 0 -> if { literals[index].value -> Option<Long>.Some } else { Option<Long>.None }
}