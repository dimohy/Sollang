namespace c394.type_ids
public struct SemanticType { public kind: Int, public origin: Int, public symbol: Int }
public canonicalBuiltinSymbol symbol: Int -> Int {
    symbol == 5 -> if { 2 -> return }
    symbol == 7 -> if { 6 -> return }
    symbol == 19 -> if { 20 -> return }
    symbol == 22 -> if { 21 -> return }
    symbol
}