struct Sample { name: Text, values: [Int; ~] }
borrow value: ref Sample -> ref Sample { value }
project value: ref Sample -> Unit uses Console {
    0 => index!
    index! < 1 -> while {
        value -> borrow => view
        view.name -> println
        index! + 1 => index!
    }
}
main {
    Sample { name: "ok", values: [Int; ~] } => owner
    owner -> project
}
