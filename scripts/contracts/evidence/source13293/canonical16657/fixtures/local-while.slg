struct Sample { name: Text, limit: Int }
borrow value: ref Sample -> ref Sample { value }
inspect value: ref Sample -> Int {
    value -> borrow => view
    0 => index!
    index! < view.limit -> while { index! + 1 => index! }
    index!
}
main {
    Sample { name: "ok", limit: 1 } => owner
    owner -> inspect -> println
}
