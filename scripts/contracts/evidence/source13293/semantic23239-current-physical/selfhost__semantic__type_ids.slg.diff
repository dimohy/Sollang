+# A nested declaration inherits outer type parameters; its own parameter names
+# shadow them. Source coordinates select symbols, never type identities.
+lexicalTypeParameter package: ref analysis.PackageAnalysis, sourceModule: Int, owner: Int, name: syntax.SyntaxToken -> Int {
+    package.ranges[sourceModule] => range
+    package.sources[sourceModule] -> slice(0, package.sources[sourceModule] -> len) => source
+    owner => scope!
+    scope! >= 0 -> while {
+        0..<range.symbolCount -> each index {
+            package.symbols[range.symbolStart + index] => candidate
+            candidate.kind == 32 and candidate.parent == scope!
+                -> if {
+                    package.tokens[range.tokenStart + candidate.nameToken] => token
+                    name.span.length == token.span.length => equal!
+                    UIntSize(0) => offset!
+                    equal! and offset! < name.span.length -> while {
+                        (source -> byte(name.span.start + offset!)) != (source -> byte(token.span.start + offset!))
+                            -> if { false => equal! }
+                        offset! + 1 => offset!
+                    }
+                    equal! -> if { index -> return }
+                }
+        }
+        package.symbols[range.symbolStart + scope!].parent => scope!
+    }
+    -1
+}
