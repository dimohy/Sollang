+# Flow indexing records the final name segment; direct calls record the first.
+# Normalize both to the whole path before applying lexical shadowing.
+lexicalFunctionNameMatches source: Text, tokens: ref [syntax.SyntaxToken; ~], tokenStart: Int, tokenCount: Int, nameToken: Int, declarationToken: Int -> Bool {
+    nameToken => left!
+    left! > 0 -> while {
+        tokens -> lexicalNameToken(tokenStart, tokenCount, left! - 1, -1) => dot
+        dot < 0 or tokens[tokenStart + dot].kind != grammar.tokenIdDot()
+            -> if { break }
+        tokens -> lexicalNameToken(tokenStart, tokenCount, dot - 1, -1) => previous
+        previous < 0 or tokens[tokenStart + previous].kind != grammar.tokenIdIdentifier()
+            -> if { false -> return }
+        previous => left!
+    }
+    declarationToken => right!
+    left! >= 0 and left! < tokenCount and right! >= 0 and right! < tokenCount
+        -> while {
+            tokens[tokenStart + left!] => leftToken
+            tokens[tokenStart + right!] => rightToken
+            leftToken.kind != grammar.tokenIdIdentifier() or rightToken.kind != grammar.tokenIdIdentifier()
+                or leftToken.span.length != rightToken.span.length
+                -> if { false -> return }
+            UIntSize(0) => byteIndex!
+            byteIndex! < leftToken.span.length -> while {
+                (source -> byte(leftToken.span.start + byteIndex!)) != (source -> byte(rightToken.span.start + byteIndex!))
+                    -> if { false -> return }
+                byteIndex! + 1 => byteIndex!
+            }
+            tokens -> lexicalNameToken(tokenStart, tokenCount, left! + 1, 1) => leftDot
+            tokens -> lexicalNameToken(tokenStart, tokenCount, right! + 1, 1) => rightDot
+            leftDot < tokenCount and tokens[tokenStart + leftDot].kind == grammar.tokenIdDot() => leftContinues
+            rightDot < tokenCount and tokens[tokenStart + rightDot].kind == grammar.tokenIdDot() => rightContinues
+            (leftContinues and not rightContinues) or (rightContinues and not leftContinues)
+                -> if { false -> return }
+            not leftContinues -> if { true -> return }
+            tokens -> lexicalNameToken(tokenStart, tokenCount, leftDot + 1, 1) => left!
+            tokens -> lexicalNameToken(tokenStart, tokenCount, rightDot + 1, 1) => right!
+        }
+    false
 }
 
