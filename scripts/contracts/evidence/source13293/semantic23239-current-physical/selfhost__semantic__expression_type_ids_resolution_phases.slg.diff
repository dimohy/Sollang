+publishPrimaryBlockRoleRead prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], references: ref [typeIds.TypeReference; ~], referenceIndexByTypeAst: ref [Int; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~], argumentBindings: ref [semanticContext.CallArgumentBinding; ~], sourceIndex: Int, role: symbols.Symbol, readAst: Int -> Bool {
+    prepared -> primaryBlockRoleTypeId(types, references, referenceIndexByTypeAst, expressions, expressionIndexByAst, argumentBindings, sourceIndex, role) => roleTypeId
+    roleTypeId < 0 -> if { false -> return }
+    prepared.package.ranges[sourceIndex].astStart + readAst => globalAst
+    expressionIndexByAst[globalAst] => existing
+    existing >= 0 -> if {
+        expressions[existing].typeId == roleTypeId and expressions[existing].status == 0
+            -> if { false -> return }
+    }
+    ExpressionTypeId { sourceModule: sourceIndex, astNode: readAst, typeId: roleTypeId, status: 0 } => exactType
+    existing >= 0 -> if {
+        exactType => expressions[existing]
+    } else {
+        expressions -> len => expressionIndex
+        expressions -> push(exactType)
+        expressionIndex => expressionIndexByAst[globalAst]
+    }
+    true
+}
