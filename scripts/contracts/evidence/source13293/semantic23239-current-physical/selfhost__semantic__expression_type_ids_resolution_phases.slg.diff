+                    -> if { expressions[expressionIndexByAst[global]].typeId => context! }
+                context! >= 0 and context! < (types -> len)
+                    -> if {
+                        types[context!] => container
+                        (container.kind == 2 or container.kind == 3 or container.kind == 4 or container.kind == 12)
+                            and container.first >= 0 and container.first < (types -> len)
+                            -> if {
+                                prepared.package -> typeIds.arrayStorageSyntax(range.sourceModule, astNode!) => storage
+                                not storage.dynamic and not storage.bounded -> if {
+                                    0 => length!
