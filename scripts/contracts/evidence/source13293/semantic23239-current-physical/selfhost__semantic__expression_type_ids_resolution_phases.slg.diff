+    # Additional arguments can become concrete after initial expression typing.
+    # Publish the specialized declaration before dependent member paths resolve.
+    false => changed!
+    0..<(prepared.package.ranges -> len) -> each sourceIndex {
+        prepared.package.ranges[sourceIndex] => range
+        0..<range.nameCount -> each nameIndex {
+            prepared.package.names[range.nameStart + nameIndex] => name
+            name.symbol >= 0 -> if {
+                prepared.package.symbols[range.symbolStart + name.symbol] => role
+                role.kind == 35 -> if {
+                    prepared -> publishPrimaryBlockRoleRead(types, references, referenceIndexByTypeAst, expressions, expressionIndexByAst, argumentBindings, sourceIndex, role, name.astNode)
+                        -> if { true => changed! }
+                }
+            }
+        }
+    }
+    changed!
+}
