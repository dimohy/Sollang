+                                        prepared.package.nodes[child!].kind != 12 and prepared.package.nodes[child!].kind != 16
+                                            -> if { length! + 1 => length! }
+                                        index.nextChild[child!] => child!
+                                    }
+                                    storage.isRepeat -> if { storage.length => length! }
+                                    length! >= 0 -> if {
+                                        types -> internArrayLiteralType(4, container.first, length!) => backing
+                                        facts! -> push(ExpressionTypeId { sourceModule: range.sourceModule, astNode: astNode!, typeId: backing, status: 0 })
+                                    }
+                                }
+                            }
+                    }
+            }
+            astNode! + 1 => astNode!
+        }
+    }
+    facts!
+}
