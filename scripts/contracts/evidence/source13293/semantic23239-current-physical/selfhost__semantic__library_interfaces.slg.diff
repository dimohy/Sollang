+producerAbiHash strings: ref [UInt8; ~], exports: ref [LibraryExport; ~], parameters: ref [LibraryParameter; ~] -> [UInt8; 64] {
+    strings -> file.borrowBytes => owner
+    owner -> slice(UIntSize(0), owner -> len) -> abiMaterial(exports, parameters) -> hashHex
+}
+
+producerSignatureHash strings: ref [UInt8; ~], exported: LibraryExport, parameters: ref [LibraryParameter; ~] -> [UInt8; 64] {
+    strings -> file.borrowBytes => owner
+    owner -> slice(UIntSize(0), owner -> len) -> signatureMaterial(exported, parameters) -> hashHex
+}
+
+storeExportSymbol strings: mut [UInt8; ~], qualifiedName: MetadataSpan, abiHash: [UInt8; 64] -> MetadataSpan {
+    UIntSize(strings -> len) => start
+    strings -> push(115)
+    strings -> push(108)
+    strings -> push(103)
+    strings -> push(95)
+    abiHash -> each digit { strings -> push(digit) }
+    strings -> push(95)
+    UIntSize(0) => offset!
+    offset! < qualifiedName.length -> while {
+        strings[Int(qualifiedName.start + offset!)] => value
+        # Valid source identifiers contain BMP scalars. Emit one underscore for
+        # each non-ASCII scalar, matching the C# UTF-16 character sanitizer.
+        value < 128 or value >= 192 -> if {
+            (value >= 48 and value <= 57) or (value >= 65 and value <= 90) or (value >= 97 and value <= 122)
+                -> if { strings -> push(value) } else { strings -> push(95) }
+        }
+        offset! + 1 => offset!
+    }
+    MetadataSpan { start: start, length: UIntSize(strings -> len) - start }
+}
