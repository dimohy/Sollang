+writeMetadataSpan writer: mut json.Writer, source: Text, span: MetadataSpan -> Result<Unit, json.Error> {
+    span.start <= (source -> len) and span.length <= (source -> len) - span.start
+        -> unless {
+            Result<Unit, json.Error>.Err(json.Error { kind: jsonErrors.Kind.InvalidModel, offset: span.start }) -> return
+        }
+    writer -> string(source -> slice(span.start, span.length))
+}
+
+storeMetadataText bytes: mut [UInt8; ~], value: Text -> MetadataSpan {
+    UIntSize(bytes -> len) => start
+    UIntSize(0) => offset!
+    offset! < (value -> len) -> while {
+        bytes -> push(value -> byte(offset!))
+        offset! + 1 => offset!
+    }
+    MetadataSpan { start: start, length: UIntSize(bytes -> len) - start }
+}
+
+storeMetadataHash bytes: mut [UInt8; ~], value: [UInt8; 64] -> MetadataSpan {
+    UIntSize(bytes -> len) => start
+    value -> each digit { bytes -> push(digit) }
+    MetadataSpan { start: start, length: 64 }
+}
+
+metadataSpanValid span: MetadataSpan, byteCount: UIntSize -> Bool {
+    span.start <= byteCount and span.length <= byteCount - span.start
+}
+
+producerShapeValid strings: ref [UInt8; ~], exports: ref [LibraryExport; ~], parameters: ref [LibraryParameter; ~] -> Bool {
+    UIntSize(strings -> len) => size
+    (exports -> len) == 0 -> if { false -> return }
+    exports -> each exported {
+        not (exported.name -> metadataSpanValid(size))
+            or not (exported.qualifiedName -> metadataSpanValid(size))
+            or not (exported.resultType -> metadataSpanValid(size))
+            or exported.parameterStart < 0 or exported.parameterCount < 0
+            or exported.parameterStart > (parameters -> len)
+            or exported.parameterCount > (parameters -> len) - exported.parameterStart
+            -> if { false -> return }
+    }
+    parameters -> each parameter {
+        not (parameter.name -> metadataSpanValid(size)) or not (parameter.typeName -> metadataSpanValid(size))
+            -> if { false -> return }
+    }
+    strings -> file.borrowBytes => owner
+    owner -> slice(UIntSize(0), owner -> len) => source
+    0 => index!
+    index! < (exports -> len) -> while {
+        exports[index!] => exported
+        source -> abiSafe(exported.resultType) -> unless { false -> return }
+        0 => previous!
+        previous! < index! -> while {
+            source -> sameSpan(exports[previous!].name, exported.name)
+                -> if { false -> return }
+            previous! + 1 => previous!
+        }
+        index! + 1 => index!
+    }
+    parameters -> each parameter {
+        source -> abiSafe(parameter.typeName) -> unless { false -> return }
+    }
+    true
+}
