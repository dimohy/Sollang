+# Call after declaration admission. Hash material, symbol construction and
+# strict consumer validation share one metadata model with the reader.
+public create exports: move [LibraryExport; ~], parameters: move [LibraryParameter; ~], strings: move [UInt8; ~], target: Text, libraryFile: Text -> Result<LibraryInterface, json.Error> {
+    target == "windows-x64" or target == "linux-x64"
+        -> unless { Result<LibraryInterface, json.Error>.Err(json.Error { kind: jsonErrors.Kind.InvalidModel, offset: 0 }) -> return }
+    (libraryFile -> len) > 0 -> unless { Result<LibraryInterface, json.Error>.Err(json.Error { kind: jsonErrors.Kind.InvalidModel, offset: 0 }) -> return }
+    UIntSize(0) => pathIndex!
+    pathIndex! < (libraryFile -> len) -> while {
+        libraryFile -> byte(pathIndex!) => value
+        value == 47 or value == 92 -> if { Result<LibraryInterface, json.Error>.Err(json.Error { kind: jsonErrors.Kind.InvalidModel, offset: pathIndex! }) -> return }
+        pathIndex! + 1 => pathIndex!
+    }
+    strings -> producerShapeValid(exports, parameters)
+        -> unless { Result<LibraryInterface, json.Error>.Err(json.Error { kind: jsonErrors.Kind.InvalidModel, offset: 0 }) -> return }
+    strings -> producerAbiHash(exports, parameters) => digest
+    strings => ownedStrings!
+    ownedStrings! -> storeMetadataText("sollang-c-v1") => abi
+    ownedStrings! -> storeMetadataText(target) => targetSpan
+    ownedStrings! -> storeMetadataText(libraryFile) => fileSpan
+    ownedStrings! -> storeMetadataHash(digest) => hashSpan
+    [LibraryExport; ~] => completedExports!
+    exports -> each exported {
+        ownedStrings! -> storeExportSymbol(exported.qualifiedName, digest) => symbol
+        LibraryExport { name: exported.name, qualifiedName: exported.qualifiedName, symbol: symbol,
+            parameterStart: exported.parameterStart, parameterCount: exported.parameterCount,
+            resultType: exported.resultType, signatureHash: MetadataSpan { start: 0, length: 0 } } => pending
+        ownedStrings! -> producerSignatureHash(pending, parameters) => signature
+        ownedStrings! -> storeMetadataHash(signature) => signatureSpan
+        completedExports! -> push(LibraryExport { name: pending.name, qualifiedName: pending.qualifiedName, symbol: pending.symbol,
+            parameterStart: pending.parameterStart, parameterCount: pending.parameterCount,
+            resultType: pending.resultType, signatureHash: signatureSpan })
+    }
+    emptyDocument() => document!
+    1 => document!.schema
+    abi => document!.abi
+    targetSpan => document!.target
+    fileSpan => document!.libraryFile
+    hashSpan => document!.abiHash
+    completedExports! => document!.exports
+    parameters => document!.parameters
+    ownedStrings! => document!.strings
+    Result<LibraryInterface, json.Error>.Ok(document!)
+}
+
+# The metadata model and JSON writer are shared with the strict reader. The
+# caller supplies its output budget; one byte is reserved for the final LF.
+public serialize document: ref LibraryInterface, maxOutputBytes: Int -> Result<[UInt8; ~], json.Error> {
+    document.status == 0 and document.schema == 1
+        -> unless {
+            Result<[UInt8; ~], json.Error>.Err(json.Error { kind: jsonErrors.Kind.InvalidModel, offset: 0 }) -> return
+        }
+    maxOutputBytes >= 1 -> unless {
+        Result<[UInt8; ~], json.Error>.Err(json.Error { kind: jsonErrors.Kind.InvalidLimit, offset: 0 }) -> return
+    }
+    document.strings -> file.borrowBytes => owner
+    owner -> slice(UIntSize(0), owner -> len) => source
+    (maxOutputBytes - 1) -> json.writer(5)? => writer!
+    writer! -> beginObject?
+    writer! -> name("schema")?
+    writer! -> number("1")?
+    writer! -> name("abi")?
+    writer! -> writeMetadataSpan(source, document.abi)?
+    writer! -> name("target")?
+    writer! -> writeMetadataSpan(source, document.target)?
+    writer! -> name("libraryFile")?
+    writer! -> writeMetadataSpan(source, document.libraryFile)?
+    writer! -> name("abiHash")?
+    writer! -> writeMetadataSpan(source, document.abiHash)?
+    writer! -> name("exports")?
+    writer! -> beginArray?
+    document.exports -> each exported {
+        exported.parameterStart >= 0 and exported.parameterCount >= 0
+            and exported.parameterStart <= (document.parameters -> len)
+            and exported.parameterCount <= (document.parameters -> len) - exported.parameterStart
+            -> unless {
+                Result<[UInt8; ~], json.Error>.Err(json.Error { kind: jsonErrors.Kind.InvalidModel, offset: 0 }) -> return
+            }
+        writer! -> beginObject?
+        writer! -> name("name")?
+        writer! -> writeMetadataSpan(source, exported.name)?
+        writer! -> name("qualifiedName")?
+        writer! -> writeMetadataSpan(source, exported.qualifiedName)?
+        writer! -> name("symbol")?
+        writer! -> writeMetadataSpan(source, exported.symbol)?
+        writer! -> name("parameters")?
+        writer! -> beginArray?
+        0 => parameterOrdinal!
+        parameterOrdinal! < exported.parameterCount -> while {
+            document.parameters[exported.parameterStart + parameterOrdinal!] => parameter
+            writer! -> beginObject?
+            writer! -> name("name")?
+            writer! -> writeMetadataSpan(source, parameter.name)?
+            writer! -> name("type")?
+            writer! -> writeMetadataSpan(source, parameter.typeName)?
+            writer! -> endObject?
+            parameterOrdinal! + 1 => parameterOrdinal!
+        }
+        writer! -> endArray?
+        writer! -> name("result")?
+        writer! -> writeMetadataSpan(source, exported.resultType)?
+        writer! -> name("signatureHash")?
+        writer! -> writeMetadataSpan(source, exported.signatureHash)?
+        writer! -> endObject?
+    }
+    writer! -> endArray?
+    writer! -> endObject?
+    writer! -> intoBytes? => bytes!
+    bytes! -> push(10)
+    Result<[UInt8; ~], json.Error>.Ok(bytes!)
+}
