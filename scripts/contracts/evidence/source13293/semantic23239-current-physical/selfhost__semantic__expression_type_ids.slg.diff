+completeArrayBackingFacts prepared: ref semanticContext.SemanticSnapshot, resolved: mut ExpressionTypeIdSet -> Unit {
+    [Int; ~] => expressionByAst!
+    prepared.package.nodes -> each _ { expressionByAst! -> push(-1) }
+    0 => expressionIndex!
+    resolved.expressions -> each expression {
+        prepared.package.ranges[expression.sourceModule] => range
+        expressionIndex! => expressionByAst![range.astStart + expression.astNode]
