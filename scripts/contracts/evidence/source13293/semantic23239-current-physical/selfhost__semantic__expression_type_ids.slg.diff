+            astNode! + 1 => astNode!
+        }
+    }
+    0 => argumentIndex!
+    argumentIndex! < (resolved.enumConstructorArguments -> len)
+        -> while {
+            resolved.enumConstructorArguments[argumentIndex!] => argument!
+            contextualizeEmptyArrayValue(prepared, resolved, expressionByAst!, context, expectedByAst!, argument!.sourceModule, argument!.argumentAst, argument!.expectedTypeId)
