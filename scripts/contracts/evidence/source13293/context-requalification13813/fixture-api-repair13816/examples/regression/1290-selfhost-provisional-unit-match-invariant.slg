import sollang.compiler.semantic.calls as calls
import sollang.compiler.ir.stream as streamIr
import sollang.compiler.ir.typed as typedIr
import sollang.compiler.llvm.emitter.context as emitterContext
import sollang.compiler.llvm.text as llvm
import sollang.compiler.semantic.diagnostics as semanticDiagnostics
import sollang.compiler.semantic.library_imports as libraryImports
import sollang.compiler.semantic.type_ids as typeIds

# V011 must recognize both legal arm shapes: a direct terminal and a nested
# block region. Either shape retaining provisional Unit would produce invalid
# LLVM when the match feeds a mutable assignment.
main {
    [
    typedIr.TypedIrNode { kind: 6, parent: -1, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 4, typeModule: -1, typeSymbol: 1, typeId: 0, typeKind: 7, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 27, parent: -1, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: 0, operand1: 2, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 19, parent: 1, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: 3, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 4, parent: 2, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 23, typeId: 2, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 27, parent: -1, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: 0, operand1: 5, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 19, parent: 4, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: 6, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 19, parent: 5, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: 7, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 4, parent: 6, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 23, typeId: 2, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 27, parent: -1, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: 0, operand1: 9, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 19, parent: 8, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: 10, nextOperand: 11, flags: 0 },
    typedIr.TypedIrNode { kind: 4, parent: 9, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 23, typeId: 2, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 19, parent: 8, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: 12, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 19, parent: 11, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: -1, flags: 0 }; ~
    ] => ir
    [
    typeIds.SemanticType { kind: 7, origin: 4, module: -1, symbol: 1, first: 1, second: 1, length: -1, lengthHash: 0, containsParameter: false, status: 0 },
    typeIds.SemanticType { kind: 1, origin: 1, module: -1, symbol: 0, first: -1, second: -1, length: -1, lengthHash: 0, containsParameter: false, status: 0 },
    typeIds.SemanticType { kind: 1, origin: 1, module: -1, symbol: 23, first: -1, second: -1, length: -1, lengthHash: 0, containsParameter: false, status: 0 }; ~
    ] => types
    emitterContext.EmitContext {
        globalFunctionAliasDiagnostic: calls.noGlobalFunctionAliasDiagnostic()
        unusedMutableBindingWarnings: []
        initializerDiagnostics: []
        missingEnumVariants: []
        nominalFieldMismatch: semanticDiagnostics.NominalFieldMismatchDiagnostic { sourceModule: -1, initializerAst: -1, valueAst: -1, fieldIndex: -1, actualTypeId: -1 }
        signatureTypeDiagnostic: semanticDiagnostics.SignatureTypeDiagnostic { code: 0, sourceModule: -1, functionSymbol: -1, typeAst: -1, nameToken: -1, genericToken: -1 }
        inferredInputConflict: semanticDiagnostics.InferredInputConflictDiagnostic { sourceModule: -1, functionSymbol: -1, firstTypeId: -1, actualTypeId: -1 }
        bindingDeclarationDiagnostic: semanticDiagnostics.BindingDeclarationDiagnostic { code: 0, sourceModule: -1, bindingAst: -1, valueAst: -1, nameToken: -1, expectedTypeId: -1, actualTypeId: -1 }
        callOwnershipDiagnostic: semanticDiagnostics.CallOwnershipDiagnostic { code: 0, sourceModule: -1, argumentAst: -1, callAst: -1, targetSourceModule: -1, functionSymbol: -1, rootAst: -1 }
        dictionaryKeyDiagnostic: semanticDiagnostics.DictionaryKeyDiagnostic { sourceModule: -1, locationAst: -1, nameToken: -1, keyTypeId: -1 }
        ownedIndexReadDiagnostic: semanticDiagnostics.OwnedIndexReadDiagnostic { sourceModule: -1, indexAst: -1, elementTypeId: -1, dictionary: false }
        firstDeclarationRootDiagnostic: -1
        firstOwnedBindingDiagnostic: -1
        callArityDiagnostic: semanticDiagnostics.CallArityDiagnostic { nativePathStyle: false, sourceModule: -1, callAst: -1, targetSourceModule: -1, functionSymbol: -1, expectedAdditionalArguments: -1 }
        numericCallLiteralDiagnostic: semanticDiagnostics.NumericCallLiteralDiagnostic { code: 0, sourceModule: -1, locationAst: -1, literalAst: -1, expectedSymbol: -1, negative: false }
        numericCallArgumentDiagnostic: semanticDiagnostics.NumericCallArgumentDiagnostic { code: 0, sourceModule: -1, argumentAst: -1, callAst: -1, targetSourceModule: -1, functionSymbol: -1, parameterSymbol: -1, parameterOrdinal: -1, genericParameterSymbol: -1, expectedTypeId: -1, actualTypeId: -1 }
        redundantNumericConversions: []
        fixedLengthArrayWarnings: []
        interpolationNumericWarningByNode: []
        interpolationCallArgumentDiagnosticByNode: []
        unresolvedMutableNames: []
        consumedBindingReads: []
        expressionOperandDiagnostic: semanticDiagnostics.ExpressionOperandDiagnostic { code: 0, sourceModule: -1, astNode: -1, operandAst: -1, operatorKind: -1, locationOffset: 0, operandTypeSymbol: -1, operandTypeId: -1, firstTypeId: -1 }
        memberFieldCollision: semanticDiagnostics.MemberFieldCollisionDiagnostic { sourceModule: -1, functionSymbol: -1, ownerType: -1 }
        sources: []
        ranges: []
        nodes: []
        constantLiterals: []
        constantFailures: []
        tokens: []
        symbols: []
        calls: []
        unsupportedNominalEnumFlowPathByAst: []
        finalCallResolvedByAst: []
        awaitSourceByAst: []
        libraries: libraryImports.LibraryCatalog { diagnosticCount: 0, bindings: [], sources: [], interfaces: [], runtimeLibraries: [] }
        libraryCalls: []
        libraryCallDiagnostics: []
        interpolationRanges: []
        activeInterpolationBodyByNode: []
        interpolations: []
        interpolationEnumConstructors: []
        interpolationEnumConstructorByNode: []
        interpolationArrayByNode: []
        interpolationOwnedParameterCallByNode: []
        interpolationPayloadTransfers: []
        enumPayloadStorageDiagnostics: []
        intrinsicFlowResultBuiltinByNode: []
        invalidIntrinsicFlowArityByNode: []
        invalidTextIntrinsicArgumentByNode: []
        collectionMembershipDiagnosticByNode: []
        unresolvedInterpolationBindingByNode: []
        uninvokedAssociatedMemberByNode: []
        missingLocalAssociatedMemberByNode: []
        localEnumMemberDecisionByNode: []
        uninvokedInterpolationFunctionByNode: []
        unresolvedInterpolationCallByNode: []
        semanticInterpolationCallTargets: []
        importedInterpolationCallTargetByNode: []
        directCallExpectedArityByNode: []
        invalidArgumentsInterpolationIndexByNode: []
        invalidMappedIndexByNode: []
        invalidCollectionIndexExpectedTypeByNode: []
        interpolationContextualDiagnosticByNode: []
        interpolationContextualFieldByNode: []
        interpolationIndexedTypeByNode: []
        interpolationMemberTypeByNode: []
        interpolationUnaryTypeByNode: []
        interpolationNumericLiteralContextByNode: []
        interpolationBinaryTypeByNode: []
        interpolationFlowTypeByNode: []
        interpolationResultPropagationByNode: []
        interpolationMemberFieldByNode: []
        interpolationPrivateFieldByNode: []
        interpolationMissingMemberOwnerTypeByNode: []
        interpolationOwnedIndexElementTypeByNode: []
        interpolationOwnedIndexContainerByNode: []
        invalidSignedUnaryByNode: []
        invalidNotUnaryByNode: []
        binaryArithmeticDiagnosticByNode: []
        binaryComparisonDiagnosticByNode: []
        binaryLogicalDiagnosticByNode: []
        unsupportedIndexOwnerTypeByNode: []
        invalidDisplayTypeByNode: []
        invalidNumericConversionTypeByNode: []
        invalidCodePointFloatConversionByNode: []
        invalidNumericConversionLiteralByNode: []
        invalidNumericConversionArityByNode: []
        numericConversionResultTypeByNode: []
        ir: ir
        genericCallPlans: []
        genericBodies: typedIr.GenericBodyBindings { functionsByCall: [], functionsByInterpolation: [], templatesByFunction: [], interpolationInstances: [] }
        streamPlan: streamIr.StreamPlan { pipelines: [], stages: [], junctions: [], junctionInputs: [], partitionRoutes: [] }
        moves: []
        nominal: []
        composite: []
        modules: []
        imports: []
        resolvedImports: []
        types: types
        typeReferences: []
        typeTerms: []
        fields: []
        typeSizes: []
        typeAligns: []
        typeLayoutStatuses: []
        typeTraits: []
        ownedStorageByType: []
        pointerBitWidth: 64
        targetArchitecture: 1
        cpuDispatchPolicy: 1
        requiredCpuFeatures: 1
        allowedCpuFeatures: 1_022
        forbiddenCpuFeatures: 0
        supportsComputePool: false
        expectedPathStyle: 1
        usesConcurrentStreamJoins: false
        ownershipDiagnostics: []
        readonlyReferencePaths: []
    } => context
    [Int; ~] => functions
    context -> llvm.irInvariantCode(1, functions) => directCode
    context -> llvm.irInvariantCode(4, functions) => nestedCode
    context -> llvm.irInvariantCode(8, functions) => incompleteCode
    "provisional Unit match invariants = $directCode,$nestedCode,$incompleteCode" -> println
}
