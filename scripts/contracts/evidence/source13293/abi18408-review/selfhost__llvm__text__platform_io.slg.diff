+# The raw primitive may return null. Expression allocation owns the fatal
+# decision, before payload initialization or publication to a container.
+emitArrayAllocationGuard identity: ArrayStorageIdentity, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
+    Arena(0) => names!
+    (identity.resultDomain == 1 -> if {
+        "v$(identity.labelIndex)_expression$(identity.resultIndex)" -> materialize(names!)
+    } else { identity.resultDomain == 2 -> if {
+            "while$(identity.labelIndex)_v$(identity.resultIndex)" -> materialize(names!)
+        } else { "v$(identity.resultIndex)" -> materialize(names!) } }) => prefix
+    prefix -> emitAllocationGuard("_data", ownerIndex, context, state)
+}
+
+# A nullable resize and a fresh literal allocation share the same fatal
+# decision. The pointer suffix also separates pointer and Boolean SSA names.
+emitAllocationGuard prefix: Text, pointerSuffix: Text, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
+    "  %$(prefix)_allocation_ok = icmp ne ptr %$(prefix)$(pointerSuffix), null" -> println
+    "  br i1 %$(prefix)_allocation_ok, label %$(prefix)_allocation_ready, label %$(prefix)_allocation_failed" -> println
+    "$(prefix)_allocation_failed:" -> println
+    WhileValueRequest { whileIndex: -1, ownerIndex: ownerIndex, nodeIndex: -1 }
+        -> emitRuntimeTrap(prefix, "allocation", "allocation_failed", context, state)
+    "$(prefix)_allocation_ready:" -> println
+}
