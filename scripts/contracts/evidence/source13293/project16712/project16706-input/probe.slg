    "incomplete" -> verifyCase("W:\\MyWorks\\Sollang\\artifacts\\scratch\\resume-20261006-owner-continuation22\\project16706-input\\app\\root.slg", manifests2, names2, 8, "source package context is incomplete", expected2) -> unless { false => valid! }
    not valid! -> if { process.exit(1)
}
