+# syntax. Reuse completed declarations; otherwise publish the complete body
+# contract. Consumer admission remains a separate signature diagnostic.
+publishInferredFunctionReturnTypes prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~] -> [Int; ~] {
+    prepared -> indexInferredFunctionBodyValues => bodies
+    [Int; ~] => results!
+    prepared.package.symbols -> each symbol { results! -> push(-1) }
+    prepared.package.ranges -> each range {
+        0..<range.symbolCount -> each symbolIndex {
+            prepared.package.symbols[range.symbolStart + symbolIndex] => function
+            function.kind == 7 and function.astNode >= 0
+                and function.flags / 32 % 2 == 1 and function.flags / 4 % 2 == 0
+                -> if {
+                    range.astStart + function.astNode => declaration
+                    expressionIndexByAst[declaration] => existing!
+                    -1 => result!
+                    existing! >= 0 -> if {
+                        expressions[existing!].status == 0 -> if { expressions[existing!].typeId => result! }
+                    }
+                    result! < 0 and bodies[declaration] >= 0 -> if {
+                        inferredSignatureContractTypeId(prepared, types, expressions, expressionIndexByAst, range.sourceModule, bodies[declaration]) => result!
+                        result! >= 0 and not types[result!].containsParameter
+                            -> if {
+                                ExpressionTypeId { sourceModule: range.sourceModule, astNode: function.astNode, typeId: result!, status: 0 } => fact
+                                existing! < 0 -> if {
+                                    expressions -> len => existing!
+                                    expressions -> push(fact)
+                                    existing! => expressionIndexByAst[declaration]
+                                } else { fact => expressions[existing!] }
+                            } else { -1 => result! }
+                    }
+                    result! => results![range.symbolStart + symbolIndex]
+                }
+        }
+    }
+    results!
 }
 
