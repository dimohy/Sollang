{
  "schemaVersion": 1,
  "scope": "Diagnostic scope only: confirm whether current CSharp lexer/formatter accepts nonraw Unicode whitespace before proposing any Native language change.",
  "cases": [
    {
      "id": "nbsp-indent",
      "mode": "format-stdin",
      "source": "main {\n\u00a0\u00a0\"unicode\" -> println\n}\n",
      "expected": {
        "exitCode": 0,
        "stdout": "main {\n    \"unicode\" -> println\n}\n",
        "stderr": ""
      }
    },
    {
      "id": "em-space-indent",
      "mode": "format-stdin",
      "source": "main {\n\u2003\"unicode\" -> println\n}\n",
      "expected": {
        "exitCode": 0,
        "stdout": "main {\n    \"unicode\" -> println\n}\n",
        "stderr": ""
      }
    },
    {
      "id": "nbsp-blank",
      "mode": "format-stdin",
      "source": "main {\n\u00a0\n    \"unicode\" -> println\n}\n",
      "expected": {
        "exitCode": 0,
        "stdout": "main {\n\n    \"unicode\" -> println\n}\n",
        "stderr": ""
      }
    },
    {
      "id": "nbsp-trailing",
      "mode": "format-stdin",
      "source": "main {\n    \"unicode\" -> println\u00a0\n}\n",
      "expected": {
        "exitCode": 0,
        "stdout": "main {\n    \"unicode\" -> println\n}\n",
        "stderr": ""
      }
    }
  ]
}
