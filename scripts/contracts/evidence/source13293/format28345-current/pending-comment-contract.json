{
  "schemaVersion": 1,
  "scope": "Diagnostic scope: valid line comments ending in Unicode whitespace versus quoted literal preservation; horizontal whitespace outside comments/literals remains the existing ASCII lexer contract.",
  "cases": [
    {
      "id": "nbsp-comment",
      "mode": "format-stdin",
      "source": "main {\n    # note\u00a0\n}\n",
      "expected": {
        "exitCode": 0,
        "stdout": "main {\n    # note\n}\n",
        "stderr": ""
      }
    },
    {
      "id": "em-space-comment",
      "mode": "format-stdin",
      "source": "main {\n    # note\u2003\n}\n",
      "expected": {
        "exitCode": 0,
        "stdout": "main {\n    # note\n}\n",
        "stderr": ""
      }
    },
    {
      "id": "mixed-comment",
      "mode": "format-stdin",
      "source": "main {\n    # note \u00a0\t\n}\n",
      "expected": {
        "exitCode": 0,
        "stdout": "main {\n    # note\n}\n",
        "stderr": ""
      }
    },
    {
      "id": "quoted-nbsp-control",
      "mode": "format-stdin",
      "source": "main {\n    \"value\u00a0\" -> println\n}\n",
      "expected": {
        "exitCode": 0,
        "stdout": "main {\n    \"value\u00a0\" -> println\n}\n",
        "stderr": ""
      }
    }
  ]
}
