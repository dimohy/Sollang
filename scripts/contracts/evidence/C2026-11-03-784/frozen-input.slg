struct Task { value: box Int }

finish task: move Task -> Unit uses Console { "finished" -> println }

run ready: Bool -> Unit uses Console {
    [Task; ~] => active!
    Task { value: box 42 } => task
    ready -> if {
        task -> finish
    } else {
        active! -> push(task)
    }
    active! -> len -> println
}

main {
    true -> run
    false -> run
}
