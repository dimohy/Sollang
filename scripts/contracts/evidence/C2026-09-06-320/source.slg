u8 values: [UInt8] -> Unit uses Console { values[0] -> println
    values[1] -> println
}
i8 values: [Int8] -> Unit uses Console { values[0] -> println
    values[1] -> println
}
i16 ignored: Int, values: [Int16] -> Unit uses Console { values[0] -> println
    values[1] -> println
}
u64 ignored: Int, values: [UInt64] -> Unit uses Console { values[0] -> println }
main {
    [0, 255] -> u8
    [-128, 127] -> i8
    0 -> i16([-32768, 32767])
    0 -> u64([18446744073709551615; 2])
}
