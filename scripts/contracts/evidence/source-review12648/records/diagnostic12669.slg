namespace sollang.compiler.llvm.text

import sys.file as file
import sollang.compiler.llvm.emitter.context as emitterContext
import sollang.compiler.syntax.source_decoding as sourceDecoding
import sollang.compiler.llvm.target as llvmTarget

main {
    [
    "stdlib/std/algorithm.slg",
    "stdlib/std/archive/zip.slg",
    "stdlib/std/archive/zip/decoder_phase.slg",
    "stdlib/std/archive/zip/encoder_phase.slg",
    "stdlib/std/archive/zip/error.slg",
    "stdlib/std/async/diagnostics.slg",
    "stdlib/std/compress/brotli.slg",
    "stdlib/std/compress/brotli/command.slg",
    "stdlib/std/compress/brotli/command/error.slg",
    "stdlib/std/compress/brotli/compressed_header.slg",
    "stdlib/std/compress/brotli/compressed_header/error.slg",
    "stdlib/std/compress/brotli/compressed_stream.slg",
    "stdlib/std/compress/brotli/context_map.slg",
    "stdlib/std/compress/brotli/context_map/error.slg",
    "stdlib/std/compress/brotli/decoder_phase.slg",
    "stdlib/std/compress/brotli/error.slg",
    "stdlib/std/compress/brotli/literal_context.slg",
    "stdlib/std/compress/brotli/prefix_code.slg",
    "stdlib/std/compress/brotli/prefix_code/error.slg",
    "stdlib/std/compress/brotli/prefix_table.slg",
    "stdlib/std/compress/brotli/prefix_table/error.slg",
    "stdlib/std/compress/brotli/static_dictionary.slg",
    "stdlib/std/compress/brotli/static_dictionary/error.slg",
    "stdlib/std/compress/brotli/static_dictionary_data.slg",
    "stdlib/std/compress/brotli/tree_group.slg",
    "stdlib/std/compress/brotli/tree_group/error.slg",
    "stdlib/std/compress/gzip.slg",
    "stdlib/std/compress/gzip/decoder_phase.slg",
    "stdlib/std/compress/gzip/error.slg",
    "stdlib/std/compress/zstd.slg",
    "stdlib/std/compress/zstd/decoder_phase.slg",
    "stdlib/std/compress/zstd/error.slg",
    "stdlib/std/compress/zstd/fse.slg",
    "stdlib/std/compress/zstd/huffman.slg",
    "stdlib/std/compress/zstd/sequence.slg",
    "stdlib/std/crypto/aes128.slg",
    "stdlib/std/crypto/aes128_gcm.slg",
    "stdlib/std/crypto/aes128_gcm_result.slg",
    "stdlib/std/crypto/bits.slg",
    "stdlib/std/crypto/ed25519.slg",
    "stdlib/std/crypto/ed25519_error.slg",
    "stdlib/std/crypto/field25519.slg",
    "stdlib/std/crypto/hkdf_sha256.slg",
    "stdlib/std/crypto/hmac_sha256.slg",
    "stdlib/std/crypto/random.slg",
    "stdlib/std/crypto/sha256.slg",
    "stdlib/std/crypto/sha512.slg",
    "stdlib/std/crypto/tls13_hkdf.slg",
    "stdlib/std/crypto/tls13_keys.slg",
    "stdlib/std/crypto/x25519.slg",
    "stdlib/std/encoding/base64.slg",
    "stdlib/std/encoding/base64/error.slg",
    "stdlib/std/encoding/base64/types.slg",
    "stdlib/std/encoding/binary.slg",
    "stdlib/std/encoding/binary/error.slg",
    "stdlib/std/encoding/hex.slg",
    "stdlib/std/encoding/hex/error.slg",
    "stdlib/std/hash/crc32.slg",
    "stdlib/std/hash/xxhash64.slg",
    "stdlib/std/io.slg",
    "stdlib/std/io/async.slg",
    "stdlib/std/io/file.slg",
    "stdlib/std/io/socket.slg",
    "stdlib/std/log.slg",
    "stdlib/std/net.slg",
    "stdlib/std/net/dns.slg",
    "stdlib/std/net/http.slg",
    "stdlib/std/net/http/body.slg",
    "stdlib/std/net/http/client.slg",
    "stdlib/std/net/http/error.slg",
    "stdlib/std/net/http/request.slg",
    "stdlib/std/net/http/response.slg",
    "stdlib/std/net/http/server.slg",
    "stdlib/std/net/parse_error.slg",
    "stdlib/std/net/quic.slg",
    "stdlib/std/net/quic/application_engine.slg",
    "stdlib/std/net/quic/connection_state.slg",
    "stdlib/std/net/quic/crypto_stream.slg",
    "stdlib/std/net/quic/error.slg",
    "stdlib/std/net/quic/frame.slg",
    "stdlib/std/net/quic/handshake_engine.slg",
    "stdlib/std/net/quic/initial_engine.slg",
    "stdlib/std/net/quic/keys.slg",
    "stdlib/std/net/quic/loss_recovery.slg",
    "stdlib/std/net/quic/p2p.slg",
    "stdlib/std/net/quic/packet.slg",
    "stdlib/std/net/quic/packet_number.slg",
    "stdlib/std/net/quic/packet_recovery.slg",
    "stdlib/std/net/quic/protection.slg",
    "stdlib/std/net/quic/reassembly.slg",
    "stdlib/std/net/quic/stream_state.slg",
    "stdlib/std/net/quic/tls_auth.slg",
    "stdlib/std/net/quic/tls_client_phase.slg",
    "stdlib/std/net/quic/tls_client_state.slg",
    "stdlib/std/net/quic/tls_handshake.slg",
    "stdlib/std/net/quic/tls_hello.slg",
    "stdlib/std/net/quic/tls_server_phase.slg",
    "stdlib/std/net/quic/tls_server_state.slg",
    "stdlib/std/net/quic/tls_transcript.slg",
    "stdlib/std/net/quic/traffic_keys.slg",
    "stdlib/std/net/quic/transport_parameters.slg",
    "stdlib/std/net/quic/varint.slg",
    "stdlib/std/net/quic/version_negotiation.slg",
    "stdlib/std/net/quic/version_packet.slg",
    "stdlib/std/net/quic/x509_ed25519.slg",
    "stdlib/std/net/quic/x509_identity.slg",
    "stdlib/std/net/socket.slg",
    "stdlib/std/path.slg",
    "stdlib/std/sequence.slg",
    "stdlib/std/text/csv.slg",
    "stdlib/std/text/glob.slg",
    "stdlib/std/text/json.slg",
    "stdlib/std/text/json/error.slg",
    "stdlib/std/text/regex.slg",
    "stdlib/std/time.slg",
    "stdlib/std/uri.slg",
    "stdlib/std/uri/error.slg",
    "stdlib/std/uri/percent.slg",
    "stdlib/std/uri/percent/error.slg",
    "stdlib/std/uri/percent/types.slg",
    "stdlib/std/uuid.slg",
    "stdlib/std/uuid/error.slg",
    "stdlib/sys/directory.slg",
    "stdlib/sys/directory/kind.slg",
    "stdlib/sys/file.slg",
    "stdlib/sys/input/mouse.slg",
    "stdlib/sys/io.slg",
    "stdlib/sys/path.slg",
    "stdlib/sys/process.slg",
    "stdlib/sys/random.slg",
    "stdlib/sys/runtime/clock.slg",
    "stdlib/sys/runtime/console.slg",
    "stdlib/sys/runtime/dns.slg",
    "stdlib/sys/runtime/integer_file.slg",
    "stdlib/sys/runtime/mouse_event.slg",
    "stdlib/sys/runtime/parallel.slg",
    "stdlib/sys/runtime/path.slg",
    "stdlib/sys/runtime/path_absolute.slg",
    "stdlib/sys/runtime/process.slg",
    "stdlib/sys/runtime/random.slg",
    "stdlib/sys/runtime/sequence.slg",
    "stdlib/sys/runtime/socket.slg",
    "stdlib/sys/runtime/time.slg",
    "stdlib/sys/text.slg",
    "scripts/probes/source-review-boundaries/scratch-stream-control-map.slg"
    ] => declaredPaths
    [file.SourceText; ~] => owners!
    declaredPaths -> each sourcePath {
        sourcePath -> file.mapText => owner
        owners! -> push(owner)
    }
    [Text; ~] => sources!
    0 => sourceIndex!
    sourceIndex! < (owners! -> len) -> while {
        owners![sourceIndex!] -> sourceDecoding.utf8Text => source
        sources! -> push(source)
        sourceIndex! + 1 => sourceIndex!
    }
    llvmTarget.windowsX64() => target
    PrepareRequest { sources: sources!, standardLibrarySourceStart: 0, standardLibrarySourceCount: 144, pointerBitWidth: target.pointerBitWidth, targetArchitecture: target.architecture, cpuDispatchPolicy: target.dispatchPolicy, requiredCpuFeatures: target.requiredFeatures, allowedCpuFeatures: target.allowedFeatures, forbiddenCpuFeatures: target.forbiddenFeatures, supportsComputePool: true, expectedPathStyle: 1 } => request
    request -> prepareNative => context
    context -> prepareCoreEmitterState => state
    0 => index!
    index! < (context.ir -> len) -> while {
        context.ir[index!] => node
        node.sourceModule == 144 -> if {
            "ir=$(index!),kind=$(node.kind),parent=$(node.parent),type=$(node.typeId),origin=$(node.typeOrigin),symbolType=$(node.typeSymbol),op=$(node.opcode),symbol=$(node.symbol),a=$(node.operand0),b=$(node.operand1),next=$(node.nextOperand)" -> println
            node.kind == 5 -> if {
                index! -> regionOwnedStreamPipeline(context, state) => pipeline
                pipeline >= 0 -> if {
                    context -> emitterContext.streamCallbackInput(pipeline, 144, node.symbol) => input
                    "role=$(index!),pipeline=$pipeline,value=$(input.valueIr),type=$(input.typeId),kind=$(input.kind)" -> println
                }
            }
        }
        index! + 1 => index!
    }
    0 => stageIndex!
    stageIndex! < (context.streamPlan.stages -> len)
        -> while {
            context.streamPlan.stages[stageIndex!] => stage
            context.ir[stage.callIr].sourceModule == 144 -> if {
                "stage=$(stageIndex!),call=$(stage.callIr),type=$(context.ir[stage.callIr].typeId),root=$(stage.callbackRoot),rootType=$(context.ir[stage.callbackRoot].typeId),flags=$(stage.flags)" -> println
            }
            stageIndex! + 1 => stageIndex!
        }
}
