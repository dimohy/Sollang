diff --git a/selfhost/llvm/text/function_scheduling.slg b/selfhost/llvm/text/function_scheduling.slg
index bb33c505..21cc6791 100644
--- a/selfhost/llvm/text/function_scheduling.slg
+++ b/selfhost/llvm/text/function_scheduling.slg
@@ -6,15 +6,31 @@ import syntax.generated.slg as grammar
 
 isUserBlockScope node: typedIr.TypedIrNode -> Bool {
     node.kind == 19 and node.opcode == -227 and node.symbol != -2
 }
 
+# Planned stream terminals own their ordered callback and junction dispatch.
+# Ordinary iteration and explicit transfers still need region control flow.
+directIterationNeedsStructuredBody nodeIndex: Int, context: ref emitterContext.EmitContext -> Bool {
+    context.ir[nodeIndex] => node
+    node.kind != 6 or not (node.opcode -> typedIr.isDirectIterationOpcode)
+        -> if { false -> return }
+    0 => pipelineIndex!
+    pipelineIndex! < (context.streamPlan.pipelines -> len)
+        -> while {
+            context.streamPlan.pipelines[pipelineIndex!].terminalIr == nodeIndex
+                -> if { false -> return }
+            pipelineIndex! + 1 => pipelineIndex!
+        }
+    true
+}
+
 functionNeedsStructuredBody functionIndex: Int, end: Int, context: ref emitterContext.EmitContext -> Bool {
     functionIndex + 1 => index!
     index! < end -> while {
         context.ir[index!] => node
-        (node -> isUserBlockScope) or (node.kind == 6 and (node.opcode -> typedIr.isDirectIterationOpcode))
+        (node -> isUserBlockScope) or (index! -> directIterationNeedsStructuredBody(context))
             or node.kind == 21 or node.kind == 22 -> if { true -> return }
         index! + 1 => index!
     }
     false
 }
