+emitPlannedJunctionValue expressionIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
+    context.ir[expressionIndex].kind == 43 -> if {
+        expressionIndex -> plannedStreamJunction(context, state) => junctionIndex
+        junctionIndex >= 0 and context.streamPlan.junctions[junctionIndex].kind == 2
+            -> if {
+                context.streamPlan.junctions[junctionIndex] => junction
+                junctionIndex -> junctionRequiresConcurrent(context, state) => concurrent
+                junction.policy == 0 -> if { expressionIndex -> emitZipJunctionValue(junctionIndex, ownerIndex, context, state) }
+                junction.policy == 1 and not concurrent -> if { expressionIndex -> emitMergeJunctionValue(junctionIndex, ownerIndex, context, state) }
+                (junction.policy == 1 or junction.policy == 3) and concurrent
+                    -> if { expressionIndex -> emitConcurrentJunctionValue(junctionIndex, ownerIndex, context, state) }
+                junction.policy == 2 -> if { expressionIndex -> emitConcatJunctionValue(junctionIndex, ownerIndex, context, state) }
+                junction.policy == 3 and not concurrent -> if { expressionIndex -> emitLatestJunctionValue(junctionIndex, ownerIndex, context, state) }
+            }
+    }
+}
