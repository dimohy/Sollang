{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defectId", "total", "currentSourceFreezeRequiredForPromotion", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "defectId": { "const": "C2026-09-13-437" },
    "total": { "const": 14 },
    "currentSourceFreezeRequiredForPromotion": { "const": true },
    "cases": {
      "type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source", "expectedExitCode", "expectedStdout", "expectedStderr", "expectedWarnings", "requiresLlvm"],
        "properties": {
          "id": { "enum": ["W01_DIRECT", "W02_PENDING", "W03_CANCEL", "REDUCED_POSITIVE", "COMPLETION_COMPAT", "C424_COPY_TAIL", "C399_CONTROL", "C424_NESTED_CONTROL", "ZSTD_CONTROL", "DIVERGENT_BRANCH", "LOOP_BRANCH", "LOOP_BREAK", "LOOP_CONTINUE", "LOOP_BACKEDGE"] },
          "source": { "type": "string", "minLength": 1 },
          "expectedExitCode": { "type": "integer", "minimum": 0, "maximum": 1 },
          "expectedStdout": { "type": "string" },
          "expectedStderr": { "type": "string" },
          "expectedWarnings": { "const": 0 },
          "requiresLlvm": { "type": "boolean" }
        }
      }
    }
  }
}
