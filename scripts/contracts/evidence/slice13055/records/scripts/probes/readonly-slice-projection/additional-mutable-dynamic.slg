read index: Int, values: [Int] -> Int => values[index]

make count: Int -> [Int; ~] {
    [Int; ~] => values!
    0 => index!
    index! < count -> while {
        values! -> push(17 + index! * 2)
        index! + 1 => index!
    }
    values!
}

choose index: Int, values: mut [Int; ~] -> Int {
    values -> push(23)
    index -> read(values)
}

main {
    2 -> make => values!
    2 -> choose(values!) -> println
}
