read index: Int, values: [Int] -> Int => values[index]

make count: Int -> [Int; ~] {
    [Int; ~] => values!
    0 => index!
    index! < count -> while {
        values! -> push(17 + index! * 2)
        index! + 1 => index!
    }
    values!
}

main {
    2 -> make => values
    0 -> read(values) -> println
}
