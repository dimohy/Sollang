struct Holder {
    values: [Int; <=3]
}

make: -> [Int; <=3] => [7, 9]
borrow holder: ref Holder -> ref [Int; <=3] => holder.values
continueValue values: [Int; <=3], index: Int -> Bool => (values -> len) == 2 and (values -> capacity) == 3 and values[0] == 7 and index < 2
continueReference values: ref [Int; <=3], index: Int -> Bool => (values -> len) == 2 and values[0] == 7 and index < 2

main {
    make() => values
    Holder { values: make() } => holder
    borrow(holder) => borrowed
    0 => first!
    continueValue(values, first!) -> while { first! + 1 => first! }
    first! -> println
    0 => second!
    continueValue(borrowed, second!) -> while { second! + 1 => second! }
    second! -> println
    0 => third!
    continueReference(borrowed, third!) -> while { third! + 1 => third! }
    third! -> println
}
