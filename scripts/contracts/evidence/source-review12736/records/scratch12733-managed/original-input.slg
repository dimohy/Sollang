import sys.directory as directory
import sys.path as path

struct DirectoryView {
    value: ref path.Path
}

borrowDirectory value: ref path.Path -> ref path.Path => value

createDirectory value: ref path.Path -> Bool uses File {
    value -> directory.create
}

main {
    path.fromText(".", path.Style.Windows) => current
    current -> directory.create -> println
    current -> createDirectory -> println
    DirectoryView { value: current -> borrowDirectory } => view
    view.value -> directory.create -> println
    current -> borrowDirectory -> directory.create -> println
}
