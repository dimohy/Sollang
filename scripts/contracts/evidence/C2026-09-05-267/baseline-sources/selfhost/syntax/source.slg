namespace sollang.compiler.syntax

# Byte offsets remain stable across UTF-8 decoding and are shared by tokens,
# CST nodes, diagnostics, and source maps.
public struct SourceSpan {
    public fileId: Int
    public start: UIntSize
    public length: UIntSize
}

public struct SyntaxToken {
    public kind: Int
    public span: SourceSpan
}

impl SourceSpan {
    public end: self -> UIntSize {
        self.start + self.length
    }
}
