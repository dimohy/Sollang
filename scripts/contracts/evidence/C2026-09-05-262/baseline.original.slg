# Tail each remains a runtime statement; collection comprehensions stay values.
showFirst values: ref [Int; ~] -> Unit uses Console {
    values -> each number { "first=$number" -> println }
}

showSecond heading: Text, values: ref [Int; ~] -> Unit uses Console {
    values -> each number { "$heading:$number" -> println }
}

showBranch values: ref [Int; ~], enabled: Bool -> Unit uses Console {
    enabled -> if {
        values -> each number { "branch=$number" -> println }
    } else {
        "off" -> println
    }
}

constructed: -> [Int; 2] => [1..2 -> each { it * 10 }]

main {
    [10, 20; ~] => values!
    values! -> showFirst
    "second" -> showSecond(values!)
    values! -> showBranch(true)
    constructed()[1] -> println
}
