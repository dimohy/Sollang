import sys.process as process

main {
    process.command("artifacts/scratch/resume-20261006-owner-continuation22/process11895-child/program space/echo/probe.exe") => command!
    command! -> arg("""payload""")
    command! -> status -> when {
        Result<process.ExitStatus, Text>.Ok(status) { "status=$(status -> exitCode)" -> println }
        Result<process.ExitStatus, Text>.Err(error) { "error=$error" -> println }
    }
}
