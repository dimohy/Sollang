once value: Int -> Int block item: Int -> Int {
    value -> yield
}
seed: -> Int {
    2 -> once item { item + 1 } => result
    result
}
inner<T> value: T -> T { value }
outer<T> value: T -> T uses Console {
    "$(value -> inner)" -> println
    value
}
main {
    seed() -> println
    7 -> outer => first
    true -> outer => second
}
