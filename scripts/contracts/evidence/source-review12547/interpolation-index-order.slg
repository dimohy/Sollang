index value: Int -> Int uses Console {
    "index=$value" -> println
    value
}

main {
    [5, 7] => values
    "$(values[0 -> index]),$(values[1 -> index])" -> println
    0 => current!
    current! < 2 -> while {
        "loop=$(values[current!])" -> println
        current! + 1 => current!
    }
    "logical=$(true and values[1] == 7)" -> println
}
