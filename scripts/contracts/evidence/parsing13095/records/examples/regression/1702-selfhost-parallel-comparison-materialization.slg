# The production function-parallel path must preserve the same comparison
# producer as sequential Typed IR lowering, even with a single worker.
scan text: Text -> UIntSize {
    UIntSize(0) => index!
    index! <= (text -> len) -> while {
        index! == (text -> len) -> if { index! -> return }
        index! + 1 => index!
    }
    index!
}

main {
    scan("abc") => count
    "count=$count" -> println
}
