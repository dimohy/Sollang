struct Values {
    value: Long
    minimum: Long
    maximum: Long
}

select value: ref Long, minimum: ref Long, maximum: ref Long -> Int {
    value -> when {
        minimum..maximum => 7
        else => 9
    }
}

main {
    Values { value: -3, minimum: -5, maximum: -1 } => values
    values.value -> select(values.minimum, values.maximum) -> println
}
