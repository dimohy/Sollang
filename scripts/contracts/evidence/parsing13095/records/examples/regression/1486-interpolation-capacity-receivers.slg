struct Holder { values: [Int; ~] }
read holder: ref Holder -> Unit uses Console {
    "projected=$(holder.values -> capacity)" -> println
}
readArray values: ref [Int; ~] -> Unit uses Console {
    "readonly=$(values -> capacity)" -> println
}
mark value: Int -> Int uses Console {
    value -> println
    value
}
ordinary: -> Unit uses Console {
    [Int; 0~] => a!
    "$(a! -> len),$(a! -> capacity)" -> println
    a! -> push(10)
    a! -> push(20)
    "$(a! -> len),$(a![1])" -> println
    [Int; 4~] => b!
    "$(b! -> len),$(b! -> capacity)" -> println
    b! -> push(10)
    b! -> push(20)
    "$(b! -> len),$(b![1])" -> println
}
nested: -> Unit uses Console { true -> if {
        [Int; 0~] => a!
        "$(a! -> len),$(a! -> capacity)" -> println
        a! -> push(10)
        a! -> push(20)
        "$(a! -> len),$(a![1])" -> println
        [Int; 4~] => b!
        "$(b! -> len),$(b! -> capacity)" -> println
        b! -> push(10)
        b! -> push(20)
        "$(b! -> len),$(b![1])" -> println
} }
looped: -> Unit uses Console { 0 => index!
    index! < 1 -> while {
        [Int; 0~] => a!
        "$(a! -> len),$(a! -> capacity)" -> println
        a! -> push(10)
        a! -> push(20)
        "$(a! -> len),$(a![1])" -> println
        [Int; 4~] => b!
        "$(b! -> len),$(b! -> capacity)" -> println
        b! -> push(10)
        b! -> push(20)
        "$(b! -> len),$(b![1])" -> println
        index! + 1 => index!
} }
main {
    [Int; 0~] => a!
    "$(a! -> len),$(a! -> capacity)" -> println
    a! -> push(10)
    a! -> push(20)
    "$(a! -> len),$(a![1])" -> println
    [Int; 4~] => b!
    "$(b! -> len),$(b! -> capacity)" -> println
    b! -> push(10)
    b! -> push(20)
    "$(b! -> len),$(b![1])" -> println
    ordinary()
    nested()
    looped()
    [7; 3] => repeated
    "$(repeated -> len),$(repeated[2])" -> println
    [Int; <=4] => bounded
    "bounded=$(bounded -> capacity)" -> println
    {Int: Int; <=4} => boundedDictionary
    "bounded-dictionary=$(boundedDictionary -> capacity)" -> println
    {Int: Int; 4~} => dictionary
    dictionary -> capacity => ordinaryCapacity
    "dictionary=$((dictionary -> capacity) == ordinaryCapacity)" -> println
    Holder { values: [Int; 4~] } => holder
    holder -> read
    [Int; 4~] => readonlyValues
    readonlyValues -> readArray
    Arena(4) => memory
    memory -> capacity -> println
    "arena=$(memory -> capacity)" -> println
    "$(10 -> mark),$(a! -> capacity),$(20 -> mark),$(a! -> len)" -> println
}
