import sollang.compiler.diagnostics as diagnostics

report source: Text -> Unit uses Console {
    source -> diagnostics.analyze => errors
    errors -> len == 0 -> if {
        0 -> println
    } else {
        errors[0].code -> println
    }
}

main {
    "main { 'a' => value }" -> report
    "main { '' => value }" -> report
    "main { 'ab' => value }" -> report
    "main { '\\x' => value }" -> report
    "main { 'a => value }" -> report
}
