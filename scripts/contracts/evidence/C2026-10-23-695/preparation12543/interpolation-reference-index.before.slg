showFixed values: ref [Int; 2], index: Int -> Unit uses Console {
    "fixed=$(values[index])" -> println
}

showGrowable values: ref [Int; ~], index: Int -> Unit uses Console {
    "growable=$(values[index])" -> println
}

main {
    [11, 22] => fixed
    [33, 44; ~] => growable
    fixed -> showFixed(1)
    growable -> showGrowable(0)
}
