main {
    [10, 20, 30] => fixed
    [40, 50; ~] => growable!
    growable! -> push(60)
    [70, 80, 90; <=4] => bounded
    1 => index!
    "$(fixed[index!]),$(growable![index!]),$(bounded[index!])" -> println
    2 => index!
    "$(fixed[index!]),$(growable![index!]),$(bounded[index!])" -> println
}
