borrowArray values: ref [Int; ~] -> ref [Int; ~] => values
borrowDictionary entries: ref {Int: Int} -> ref {Int: Int} => entries
main {
    [Int; 4~] => values
    1 => borrowArray!
    2 => borrowArray!
    borrowArray! -> println
    ((borrowArray(values) -> capacity) == (values -> capacity)) -> println
    {Int: Int; 4~} => entries
    1 => borrowDictionary!
    2 => borrowDictionary!
    borrowDictionary! -> println
    ((borrowDictionary(entries) -> capacity) == (entries -> capacity)) -> println
}
