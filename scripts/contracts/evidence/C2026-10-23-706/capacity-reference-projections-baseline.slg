struct ArrayView { values: ref [Int; ~] }
struct DictionaryView { entries: ref {Int: Int} }
borrowArray values: ref [Int; ~] -> ref [Int; ~] => values
borrowDictionary entries: ref {Int: Int} -> ref {Int: Int} => entries
main {
    [Int; 4~] => values!
    values! -> push(10)
    ArrayView { values: values! -> borrowArray } => view!
    ArrayView { values: values! -> borrowArray } => view!
    ((view!.values -> capacity) == (values! -> capacity)) -> println
    {Int: Int; 4~} => entries!
    entries! -> put(7, 77)
    DictionaryView { entries: entries! -> borrowDictionary } => lookup!
    DictionaryView { entries: entries! -> borrowDictionary } => lookup!
    ((lookup!.entries -> capacity) == (entries! -> capacity)) -> println
}
