arrayCapacity values: ref [Int; ~] -> UIntSize {
    values -> capacity
}
dictionaryCapacity values: ref {Int: Int} -> UIntSize {
    values -> capacity
}
main {
    [Int; 4~] => values!
    ((values! -> arrayCapacity) == (values! -> capacity)) -> println
    {Int: Int; 4~} => entries!
    ((entries! -> dictionaryCapacity) == (entries! -> capacity)) -> println
}
