struct Packet {
    data: [Int; ~]
}

wrap values: move [Int; ~], retain: Bool -> Result<Packet, Int> {
    retain -> if {
        Packet { data: values } -> Result<Packet, Int>.Ok -> return
    }
    7 -> Result<Packet, Int>.Err
}

main {
    [1, 2, 3; ~] -> wrap(true) -> when {
        Ok(packet) { "value=$(packet.data[2])" -> println }
        Err(error) { "unexpected=$error" -> println }
    }
    [4, 5, 6; ~] -> wrap(false) -> when {
        Ok(packet) { "unexpected=$(packet.data[0])" -> println }
        Err(error) { "error=$error" -> println }
    }
}
