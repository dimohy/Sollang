widen value: ref Int -> Int64 { value -> Int64 }
same value: ref Int -> Int { value -> Int }
narrow value: ref Int64 -> Int { value -> Int }
additional prefix: Int, value: ref Int -> Int64 { value -> Int64 }
nested value: ref Int, chosen: Bool -> Int64 {
    chosen -> if { value -> Int64 -> return }
    Int64(0)
}
fromFloat value: ref Float64 -> Int { value -> Int }
toFloat value: ref Int -> Float64 { value -> Float64 }
widenFloat value: ref Float32 -> Float64 { value -> Float64 }
direct value: Int -> Int64 { value -> Int64 }

main {
    17 => number
    Int64(17) => wide
    Float64(17) => floating
    Float32(17) => single
    number -> widen -> println
    number -> same -> println
    wide -> narrow -> println
    0 -> additional(number) -> println
    number -> nested(true) -> println
    floating -> fromFloat -> println
    number -> toFloat -> Int -> println
    single -> widenFloat -> Int -> println
    number -> direct -> println
}
