import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.expression_type_ids as expressionTypeIds
import sys.process as process

main {
    process.arguments() => arguments
    [Text; ~] => paths!
    UIntSize(1) => index!
    index! < (arguments -> len) -> while {
        paths! -> push(arguments[index!])
        index! + 1 => index!
    }
    "prepare-files" -> println
    paths! -> semanticContext.prepareFiles => prepared
    "candidate-call-context" -> println
    prepared -> expressionTypeIds.profileResolveCallContext -> when {
        Ok(profile) {
            "initial-core-ms" -> println
            profile.initialCoreMilliseconds -> println
            "completion-ms" -> println
            profile.completionMilliseconds -> println
            "selected-calls" -> println
            profile.resolved.prepared.calls -> len -> println
            "resolved-types" -> println
            profile.resolved.types.types -> len -> println
        }
        Err(error) { "clock-error" -> println }
    }
}
