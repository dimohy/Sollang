    "stdlib/std/net/quic/varint.slg",
    "stdlib/std/net/quic/version_negotiation.slg",
    "stdlib/std/net/quic/version_packet.slg",
    "stdlib/std/net/quic/x509_ed25519.slg",
    "stdlib/std/net/quic/x509_identity.slg",
    "stdlib/std/net/socket.slg",
    "stdlib/std/path.slg",
    "stdlib/std/sequence.slg",
    "stdlib/std/text/csv.slg",
    "stdlib/std/text/glob.slg",
    "stdlib/std/text/json.slg",
    "stdlib/std/text/json/error.slg",
    "stdlib/std/text/regex.slg",
    "stdlib/std/time.slg",
    "stdlib/std/uri.slg",
    "stdlib/std/uri/error.slg",
    "stdlib/std/uri/percent.slg",
    "stdlib/std/uri/percent/error.slg",
    "stdlib/std/uri/percent/types.slg",
    "stdlib/std/uuid.slg",
    "stdlib/std/uuid/error.slg",
    "stdlib/sys/directory.slg",
    "stdlib/sys/directory/kind.slg",
    "stdlib/sys/file.slg",
    "stdlib/sys/input/mouse.slg",
    "stdlib/sys/io.slg",
    "stdlib/sys/path.slg",
    "stdlib/sys/process.slg",
    "stdlib/sys/random.slg",
    "stdlib/sys/runtime/clock.slg",
    "stdlib/sys/runtime/console.slg",
    "stdlib/sys/runtime/dns.slg",
    "stdlib/sys/runtime/integer_file.slg",
    "stdlib/sys/runtime/mouse_event.slg",
    "stdlib/sys/runtime/parallel.slg",
    "stdlib/sys/runtime/path.slg",
    "stdlib/sys/runtime/path_absolute.slg",
    "stdlib/sys/runtime/process.slg",
    "stdlib/sys/runtime/random.slg",
    "stdlib/sys/runtime/sequence.slg",
    "stdlib/sys/runtime/socket.slg",
    "stdlib/sys/runtime/time.slg",
    "stdlib/sys/text.slg",
    programPath
    ] => declaredPaths
    [Text; ~] => paths!
    declaredPaths -> each sourcePath { paths! -> push(sourcePath) }
    paths! -> compiler.emitCheckedFilesWithStandardLibrarySources(144) => diagnosticCount
    diagnosticCount != 0 -> if { "selection-emission-rejected" -> println }
}
