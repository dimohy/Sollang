    "stdlib/std/io/file.slg",
    "stdlib/std/io/socket.slg",
    "stdlib/std/log.slg",
    "stdlib/std/net.slg",
    "stdlib/std/net/dns.slg",
    "stdlib/std/net/http.slg",
    "stdlib/std/net/http/body.slg",
    "stdlib/std/net/http/client.slg",
    "stdlib/std/net/http/error.slg",
    "stdlib/std/net/http/request.slg",
    "stdlib/std/net/http/response.slg",
    "stdlib/std/net/http/server.slg",
    "stdlib/std/net/parse_error.slg",
    "stdlib/std/net/quic.slg",
    "stdlib/std/net/quic/application_engine.slg",
    "stdlib/std/net/quic/connection_state.slg",
    "stdlib/std/net/quic/crypto_stream.slg",
    "stdlib/std/net/quic/error.slg",
    "stdlib/std/net/quic/frame.slg",
