import sollang.compiler.llvm.text as compiler
import sys.process as process
import sys.text as text

main {
    process.arguments() => arguments
    (arguments -> len) != 2 -> if {
        "SELECTION_RUNTIME_PROGRAM_ARGUMENT_COUNT" -> println
        process.exit(1)
    }
    arguments[1] => programPath
    [
    "scripts/probes/borrowed-owning-local/borrowed-local.slg",
    "scripts/probes/borrowed-owning-local/owned-local.slg",
    "scripts/probes/borrowed-owning-local/borrowed-readonly-call.slg",
    "scripts/probes/borrowed-owning-local/fixed-copy-control.slg",
    "artifacts/scratch/resume-20261006-owner-continuation22/borrowed-binding14516-nested/borrowed-nested-local.slg",
    "artifacts/scratch/resume-20261006-owner-continuation22/borrowed-binding14527-cases/owned-nested-local.slg",
    "artifacts/scratch/resume-20261006-owner-continuation22/borrowed-binding14527-cases/fixed-nested-local.slg"
    ] => allowedPrograms
    false => allowed!
    allowedPrograms -> each candidate {
        (programPath -> text.compareOrdinal(candidate)) == 0
            -> if { true => allowed! }
    }
    not allowed! -> if {
        "SELECTION_RUNTIME_PROGRAM_PATH_NOT_DECLARED" -> println
        process.exit(1)
    }
    [
    "stdlib/std/algorithm.slg",
    "stdlib/std/archive/zip.slg",
    "stdlib/std/archive/zip/decoder_phase.slg",
    "stdlib/std/archive/zip/encoder_phase.slg",
    "stdlib/std/archive/zip/error.slg",
    "stdlib/std/async/diagnostics.slg",
    "stdlib/std/compress/brotli.slg",
    "stdlib/std/compress/brotli/command.slg",
    "stdlib/std/compress/brotli/command/error.slg",
    "stdlib/std/compress/brotli/compressed_header.slg",
    "stdlib/std/compress/brotli/compressed_header/error.slg",
    "stdlib/std/compress/brotli/compressed_stream.slg",
    "stdlib/std/compress/brotli/context_map.slg",
    "stdlib/std/compress/brotli/context_map/error.slg",
    "stdlib/std/compress/brotli/decoder_phase.slg",
    "stdlib/std/compress/brotli/error.slg",
    "stdlib/std/compress/brotli/literal_context.slg",
    "stdlib/std/compress/brotli/prefix_code.slg",
    "stdlib/std/compress/brotli/prefix_code/error.slg",
    "stdlib/std/compress/brotli/prefix_table.slg",
    "stdlib/std/compress/brotli/prefix_table/error.slg",
    "stdlib/std/compress/brotli/static_dictionary.slg",
    "stdlib/std/compress/brotli/static_dictionary/error.slg",
    "stdlib/std/compress/brotli/static_dictionary_data.slg",
    "stdlib/std/compress/brotli/tree_group.slg",
    "stdlib/std/compress/brotli/tree_group/error.slg",
    "stdlib/std/compress/gzip.slg",
    "stdlib/std/compress/gzip/decoder_phase.slg",
    "stdlib/std/compress/gzip/error.slg",
    "stdlib/std/compress/zstd.slg",
    "stdlib/std/compress/zstd/decoder_phase.slg",
    "stdlib/std/compress/zstd/error.slg",
    "stdlib/std/compress/zstd/fse.slg",
    "stdlib/std/compress/zstd/huffman.slg",
    "stdlib/std/compress/zstd/sequence.slg",
    "stdlib/std/crypto/aes128.slg",
    "stdlib/std/crypto/aes128_gcm.slg",
    "stdlib/std/crypto/aes128_gcm_result.slg",
    "stdlib/std/crypto/bits.slg",
    "stdlib/std/crypto/ed25519.slg",
    "stdlib/std/crypto/ed25519_error.slg",
    "stdlib/std/crypto/field25519.slg",
    "stdlib/std/crypto/hkdf_sha256.slg",
    "stdlib/std/crypto/hmac_sha256.slg",
    "stdlib/std/crypto/random.slg",
    "stdlib/std/crypto/sha256.slg",
    "stdlib/std/crypto/sha512.slg",
    "stdlib/std/crypto/tls13_hkdf.slg",
    "stdlib/std/crypto/tls13_keys.slg",
    "stdlib/std/crypto/x25519.slg",
    "stdlib/std/encoding/base64.slg",
    "stdlib/std/encoding/base64/error.slg",
    "stdlib/std/encoding/base64/types.slg",
    "stdlib/std/encoding/binary.slg",
    "stdlib/std/encoding/binary/error.slg",
    "stdlib/std/encoding/hex.slg",
    "stdlib/std/encoding/hex/error.slg",
    "stdlib/std/hash/crc32.slg",
    "stdlib/std/hash/xxhash64.slg",
    "stdlib/std/io.slg",
