struct Request { values: [Int; ~] }
readCount values: move [Int; ~] -> Int {
    true -> if {
        Request { values: values } => request
        request.values -> len
    } else {
        Request { values: values } => request
        request.values -> len
    }
}
main {
    [7, 8; ~] => values
    values -> readCount -> println
}
