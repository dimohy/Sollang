import sollang.compiler.llvm.text as llvm

main {
    [
    """
    struct Request { values: [Int; ~] }
    readCount values: [Int; ~] -> Int {
        true -> if {
            Request { values: values } => request
            request.values -> len
        } else { 0 }
    }
    main {
        [7, 8; ~] => values
        values -> readCount -> println
    }
    """; ~
    ] -> llvm.probeBorrowedLocalDiagnostics("borrowed-nested-local") => count
    "borrowed-nested-local=$count" -> println
}
