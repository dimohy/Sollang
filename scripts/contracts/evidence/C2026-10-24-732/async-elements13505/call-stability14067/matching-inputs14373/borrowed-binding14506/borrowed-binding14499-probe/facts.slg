namespace sollang.compiler.llvm.text

import sollang.compiler.llvm.target as llvmTarget
import sollang.compiler.llvm.emitter.diagnostics as diagnostics
import sys.runtime as runtime

public probeBorrowedLocalDiagnostics sources: move [Text; ~], label: Text -> Int uses Console {
    "aggregate prepare $label" -> runtime.eprintln
    llvmTarget.windowsX64() => target
    PrepareRequest { sources: sources, standardLibrarySourceStart: 0, standardLibrarySourceCount: 0, pointerBitWidth: target.pointerBitWidth, targetArchitecture: target.architecture, cpuDispatchPolicy: target.dispatchPolicy, requiredCpuFeatures: target.requiredFeatures, allowedCpuFeatures: target.allowedFeatures, forbiddenCpuFeatures: target.forbiddenFeatures, supportsComputePool: false, expectedPathStyle: 1 } => request
    request -> prepare => context
    "aggregate count $label" -> runtime.eprintln
    context -> diagnostics.blockingDiagnosticCount => count
    "aggregate complete $label" -> runtime.eprintln
    context -> diagnostics.emitBlockingDiagnostics
    count
}
