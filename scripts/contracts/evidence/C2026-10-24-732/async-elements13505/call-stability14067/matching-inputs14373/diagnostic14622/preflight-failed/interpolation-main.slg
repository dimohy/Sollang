import sollang.compiler.llvm.text as llvm
import sollang.compiler.syntax.source_decoding as sourceDecoding
import sys.file as file

report sources: move [Text; ~], label: Text -> Unit uses Console {
    sources -> llvm.probeDiagnosticAggregate(label) => count
    "$label=$count" -> println
}

main {
    [file.SourceText; ~] => owners!
    "scripts/probes/diagnostic-aggregation/interpolation2.slg" -> file.mapText => first
    owners! -> push(first)
    "scripts/probes/diagnostic-aggregation/interpolation64.slg" -> file.mapText => second
    owners! -> push(second)
    "scripts/probes/diagnostic-aggregation/borrowed-control.slg" -> file.mapText => third
    owners! -> push(third)
    [owners![0] -> sourceDecoding.utf8Text; ~] -> report("interpolation2")
    [owners![1] -> sourceDecoding.utf8Text; ~] -> report("interpolation64")
    [owners![2] -> sourceDecoding.utf8Text; ~] -> report("borrowed-control")
    owners! -> len => ownerCount
    "owners=$ownerCount" -> println
}
