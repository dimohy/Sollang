struct Mixed { fixed: [Int; 2], owned: [Int; ~] }
readMixed values: Mixed -> Int {
    Mixed { fixed: values.fixed, owned: values.owned } => pair
    pair.fixed[0] + pair.owned[0]
}
main {
    Mixed { fixed: [7, 8], owned: [99; ~] } => values
    values -> readMixed -> println
    values.fixed[0] -> println
    values.owned[0] -> println
}
