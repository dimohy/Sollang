namespace sollang.compiler.semantic.expression_type_ids

import sollang.compiler.semantic.type_ids as typeIds

main {
    [1, 2; ~] => leftReceivers
    [1, 2; ~] => rightReceivers!
    callReceiverTypesEqual(leftReceivers, rightReceivers!) => receiverChecks!
    3 => rightReceivers![1]
    receiverChecks! and not callReceiverTypesEqual(leftReceivers, rightReceivers!) => receiverChecks!
    rightReceivers! -> push(4)
    receiverChecks! and not callReceiverTypesEqual(leftReceivers, rightReceivers!) => receiverChecks!
    "receivers=$(receiverChecks!)" -> println
    typeIds.SemanticType { kind: 1, origin: 1, module: -1, symbol: 2, first: -1, second: -1, length: -1, lengthHash: 0, containsParameter: false, status: 0 } => original
    [typeIds.SemanticType; ~] => left!
    [typeIds.SemanticType; ~] => right!
    left! -> push(original)
    right! -> push(original)
    callResolvedTypesEqual(left!, right!) => typeChecks!
    original => changedkind!
    2 => changedkind!.kind
    changedkind! => right![0]
    typeChecks! and not callResolvedTypesEqual(left!, right!) => typeChecks!
    original => changedorigin!
    2 => changedorigin!.origin
    changedorigin! => right![0]
    typeChecks! and not callResolvedTypesEqual(left!, right!) => typeChecks!
    original => changedmodule!
    0 => changedmodule!.module
    changedmodule! => right![0]
    typeChecks! and not callResolvedTypesEqual(left!, right!) => typeChecks!
    original => changedsymbol!
    3 => changedsymbol!.symbol
    changedsymbol! => right![0]
    typeChecks! and not callResolvedTypesEqual(left!, right!) => typeChecks!
    original => changedfirst!
    0 => changedfirst!.first
    changedfirst! => right![0]
    typeChecks! and not callResolvedTypesEqual(left!, right!) => typeChecks!
    original => changedsecond!
    0 => changedsecond!.second
    changedsecond! => right![0]
    typeChecks! and not callResolvedTypesEqual(left!, right!) => typeChecks!
    original => changedlength!
    0 => changedlength!.length
    changedlength! => right![0]
    typeChecks! and not callResolvedTypesEqual(left!, right!) => typeChecks!
    original => changedlengthHash!
    UInt64(1) => changedlengthHash!.lengthHash
    changedlengthHash! => right![0]
    typeChecks! and not callResolvedTypesEqual(left!, right!) => typeChecks!
    original => changedcontainsParameter!
    true => changedcontainsParameter!.containsParameter
    changedcontainsParameter! => right![0]
    typeChecks! and not callResolvedTypesEqual(left!, right!) => typeChecks!
    original => changedstatus!
    1 => changedstatus!.status
    changedstatus! => right![0]
    typeChecks! and not callResolvedTypesEqual(left!, right!) => typeChecks!
    right! -> push(original)
    typeChecks! and not callResolvedTypesEqual(left!, right!) => typeChecks!
    "types=$(typeChecks!)" -> println
}
