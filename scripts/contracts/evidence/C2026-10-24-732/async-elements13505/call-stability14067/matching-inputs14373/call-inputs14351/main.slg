import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.expression_type_ids as expressionTypeIds
import sys.process as process

main {
    process.arguments() => arguments
    [Text; ~] => paths!
    UIntSize(1) => index!
    index! < (arguments -> len) -> while {
        paths! -> push(arguments[index!])
        index! + 1 => index!
    }
    "prepare-files" -> println
    paths! -> semanticContext.prepareFiles => prepared
    "call-phases" -> println
    prepared -> expressionTypeIds.probeCallPhases14160 -> when {
        Ok(profile) {
            "matchingMilliseconds" -> println
            profile.matchingMilliseconds -> println
            "indexMilliseconds" -> println
            profile.indexMilliseconds -> println
            "coreMilliseconds" -> println
            profile.coreMilliseconds -> println
            "argumentMilliseconds" -> println
            profile.argumentMilliseconds -> println
            "enumMilliseconds" -> println
            profile.enumMilliseconds -> println
            "rounds" -> println
            profile.rounds -> println
            "sameReceiverRounds" -> println
            profile.sameReceiverRounds -> println
            "sameTypeRounds" -> println
            profile.sameTypeRounds -> println
            "sameSeedRounds" -> println
            profile.sameSeedRounds -> println
            "sameAllRounds" -> println
            profile.sameAllRounds -> println
            "sameInputResultDifferences" -> println
            profile.sameInputResultDifferences -> println
            "inputComparisonMilliseconds" -> println
            profile.inputComparisonMilliseconds -> println
            "eligibleQueryMilliseconds" -> println
            profile.eligibleQueryMilliseconds -> println
            "selected-calls" -> println
            profile.resolved.prepared.calls -> len -> println
            "resolved-types" -> println
            profile.resolved.types.types -> len -> println
        }
        Err(error) { "clock-error" -> println }
    }
}
