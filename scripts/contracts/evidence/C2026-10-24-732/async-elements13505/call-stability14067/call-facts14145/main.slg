import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.calls as callFacts
import sys.process as process
import sys.runtime as runtime

main {
    process.arguments() => arguments
    [Text; ~] => paths!
    UIntSize(1) => index!
    index! < (arguments -> len) -> while {
        paths! -> push(arguments[index!])
        index! + 1 => index!
    }
    "prepare-files" -> println
    paths! -> semanticContext.prepareFiles => prepared
    "immutable-call-facts" -> println
    "source-modules" -> println
    prepared.package.sources -> len -> println
    runtime.nowMillis() => referenceIndexStarted
    prepared.package -> callFacts.probeReferenceIndex14145(prepared.semantic.references) => referenceIndexObserved
    runtime.nowMillis() - referenceIndexStarted => referenceIndexElapsed
    "reference-index-ms" -> println
    referenceIndexElapsed -> println
    "reference-index-records" -> println
    referenceIndexObserved.count -> println
    "reference-index-checksum" -> println
    referenceIndexObserved.checksum -> println
    runtime.nowMillis() => methodDeclarationsStarted
    prepared.package -> callFacts.probeMethodDeclarations14145(prepared.semantic.references, prepared.modules, prepared.resolvedImports) => methodDeclarationsObserved
    runtime.nowMillis() - methodDeclarationsStarted => methodDeclarationsElapsed
    "method-declaration-ms" -> println
    methodDeclarationsElapsed -> println
    "method-declaration-records" -> println
    methodDeclarationsObserved.count -> println
    "method-declaration-checksum" -> println
    methodDeclarationsObserved.checksum -> println
    runtime.nowMillis() => intrinsicNamesStarted
    prepared.package -> callFacts.probeIntrinsicNames14145 => intrinsicNamesObserved
    runtime.nowMillis() - intrinsicNamesStarted => intrinsicNamesElapsed
    "intrinsic-names-ms" -> println
    intrinsicNamesElapsed -> println
    "intrinsic-names-records" -> println
    intrinsicNamesObserved.count -> println
    "intrinsic-names-checksum" -> println
    intrinsicNamesObserved.checksum -> println
}
