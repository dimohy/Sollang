import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.expression_type_ids as expressionTypeIds
import sollang.compiler.semantic.calls as calls
import sys.process as process
import sys.runtime as runtime

main {
    process.arguments() => arguments
    [Text; ~] => paths!
    UIntSize(1) => argumentIndex!
    argumentIndex! < (arguments -> len) -> while {
        paths! -> push(arguments[argumentIndex!])
        argumentIndex! + 1 => argumentIndex!
    }
    "prepare-files" -> println
    paths! -> semanticContext.prepareFiles => prepared
    prepared -> expressionTypeIds.probeInitialTypedSource14188 => initialTypes
    prepared.package -> semanticContext.indexFlowSourcesByAst => flowSources
    [Int; ~] => receiverTypes!
    prepared.package.nodes -> each node { receiverTypes! -> push(-1) }
    initialTypes.expressions -> each expression {
        prepared.package.ranges[expression.sourceModule] => range
        prepared.package.nodes[range.astStart + expression.astNode] => node
        node.parent >= 0 and node.parent < range.astCount and expression.status == 0
            and expression.typeId >= 0 and expression.typeId < (initialTypes.types -> len)
            and not initialTypes.types[expression.typeId].containsParameter
            -> if {
                prepared.package.nodes[range.astStart + node.parent] => call
                call.kind == 10 and flowSources[range.astStart + node.parent] == range.astStart + expression.astNode
                    -> if { expression.typeId => receiverTypes![range.astStart + node.parent] }
            }
    }
    runtime.nowMillis() => factsStarted
    calls.probePrepareTypedSource14188(prepared.package, prepared.semantic, prepared.modules, prepared.resolvedImports) => facts
    runtime.nowMillis() - factsStarted => factsElapsed
    "paired-call-declaration-index" -> println
    "source-count" -> println
    prepared.package.ranges -> len -> println
    "facts-ms" -> println
    factsElapsed -> println
    "indexed-open-functions" -> println
    facts -> calls.probeOpenRows14210 -> println
    "field-index-complete" -> println
    calls.probeReceiverIndexReady14220(facts, prepared.semantic)
        -> if { 1 } else { 0 } -> println
    0 => sourceIndex!
    0 => totalCalls!
    0 => totalFields!
    sourceIndex! < (prepared.package.ranges -> len)
        -> while {
            runtime.nowMillis() => baselineStarted
            calls.probeBaselineTypedSource14210(sourceIndex!, prepared.package, prepared.semantic, prepared.modules, prepared.imports, prepared.resolvedImports, prepared.qualified, receiverTypes!, initialTypes.types, facts) => baseline
            runtime.nowMillis() - baselineStarted => baselineElapsed
            runtime.nowMillis() => candidateStarted
            calls.probeTypedSource14188(sourceIndex!, prepared.package, prepared.semantic, prepared.modules, prepared.imports, prepared.resolvedImports, prepared.qualified, receiverTypes!, initialTypes.types, facts) => selected
            runtime.nowMillis() - candidateStarted => candidateElapsed
            (baseline -> len) == (selected -> len) => equal!
            0 => row!
            0 => fields!
            row! < (baseline -> len) and row! < (selected -> len)
                -> while {
                    baseline[row!] => left
                    selected[row!] => right
                    left.sourceModule != right.sourceModule or left.callAst != right.callAst or left.origin != right.origin
                        or left.targetModule != right.targetModule or left.targetSourceModule != right.targetSourceModule
                        or left.functionSymbol != right.functionSymbol or left.status != right.status
                        -> if { false => equal! }
                    fields! + 7 => fields!
                    row! + 1 => row!
                }
            "source-$(sourceIndex!)-baseline-ms" -> println
            baselineElapsed -> println
            "source-$(sourceIndex!)-candidate-ms" -> println
            candidateElapsed -> println
            "source-$(sourceIndex!)-calls" -> println
            selected -> len -> println
            "source-$(sourceIndex!)-equal" -> println
            equal! -> if { 1 } else { 0 } -> println
            "source-$(sourceIndex!)-fields" -> println
            fields! -> println
            totalCalls! + Int(selected -> len) => totalCalls!
            totalFields! + fields! => totalFields!
            sourceIndex! + 1 => sourceIndex!
        }
    "total-calls" -> println
    totalCalls! -> println
    "total-fields" -> println
    totalFields! -> println
}
