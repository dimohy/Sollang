namespace sollang.compiler.semantic.expression_type_ids

import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.calls as calls
import std.crypto.sha256 as sha256

fingerprint context: ref ResolvedCallContext -> [Text; ~] {
    [Text; ~] => values!
    values! -> push("types.types")
    values! -> push("$(context.types.types -> len)")
    context.types.types -> each entry {
        values! -> push("$(entry.kind)")
        values! -> push("$(entry.origin)")
        values! -> push("$(entry.module)")
        values! -> push("$(entry.symbol)")
        values! -> push("$(entry.first)")
        values! -> push("$(entry.second)")
        values! -> push("$(entry.length)")
        values! -> push("$(entry.lengthHash)")
        values! -> push("$(entry.containsParameter)")
        values! -> push("$(entry.status)")
    }
    values! -> push("types.references")
    values! -> push("$(context.types.references -> len)")
    context.types.references -> each entry {
        values! -> push("$(entry.sourceModule)")
        values! -> push("$(entry.typeAst)")
        values! -> push("$(entry.typeId)")
        values! -> push("$(entry.status)")
    }
    values! -> push("types.fields")
    values! -> push("$(context.types.fields -> len)")
    context.types.fields -> each entry {
        values! -> push("$(entry.ownerType)")
        values! -> push("$(entry.sourceModule)")
        values! -> push("$(entry.ownerSymbol)")
        values! -> push("$(entry.fieldSymbol)")
        values! -> push("$(entry.labelToken)")
        values! -> push("$(entry.ordinal)")
        values! -> push("$(entry.fieldType)")
        values! -> push("$(entry.status)")
    }
    values! -> push("types.expressions")
    values! -> push("$(context.types.expressions -> len)")
    context.types.expressions -> each entry {
        values! -> push("$(entry.sourceModule)")
        values! -> push("$(entry.astNode)")
        values! -> push("$(entry.typeId)")
        values! -> push("$(entry.status)")
    }
    values! -> push("types.externalCallResults")
    values! -> push("$(context.types.externalCallResults -> len)")
    context.types.externalCallResults -> each entry {
        values! -> push("$(entry.sourceModule)")
        values! -> push("$(entry.astNode)")
        values! -> push("$(entry.typeId)")
        values! -> push("$(entry.status)")
    }
    values! -> push("types.callArguments")
    values! -> push("$(context.types.callArguments -> len)")
    context.types.callArguments -> each entry {
        values! -> push("$(entry.sourceModule)")
        values! -> push("$(entry.callAst)")
        values! -> push("$(entry.argumentAst)")
        values! -> push("$(entry.targetSourceModule)")
        values! -> push("$(entry.functionSymbol)")
        values! -> push("$(entry.parameterSymbol)")
        values! -> push("$(entry.parameterOrdinal)")
        values! -> push("$(entry.expectedTypeId)")
        values! -> push("$(entry.actualTypeId)")
        values! -> push("$(entry.status)")
        values! -> push("$(entry.suppressNumericWarning)")
        values! -> push("$(entry.contextualInput)")
        values! -> push("$(entry.genericParameterSymbol)")
        values! -> push("$(entry.genericFirstActualTypeId)")
        values! -> push("$(entry.genericActualTypeId)")
        values! -> push("$(entry.mismatchExpectedTypeId)")
        values! -> push("$(entry.mismatchActualTypeId)")
    }
    values! -> push("types.enumConstructorArguments")
    values! -> push("$(context.types.enumConstructorArguments -> len)")
    context.types.enumConstructorArguments -> each entry {
        values! -> push("$(entry.memberStatus)")
        values! -> push("$(entry.sourceModule)")
        values! -> push("$(entry.callAst)")
        values! -> push("$(entry.argumentAst)")
        values! -> push("$(entry.callNode)")
        values! -> push("$(entry.argumentNode)")
        values! -> push("$(entry.enumTypeId)")
        values! -> push("$(entry.targetSourceModule)")
        values! -> push("$(entry.variantSymbol)")
        values! -> push("$(entry.variantTag)")
        values! -> push("$(entry.variantToken)")
        values! -> push("$(entry.expectedTypeId)")
        values! -> push("$(entry.actualTypeId)")
    }
    values! -> push("types.enumConstructorIndexByAst")
    values! -> push("$(context.types.enumConstructorIndexByAst -> len)")
    context.types.enumConstructorIndexByAst -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.enumConstructorIndexByInterpolationNode")
    values! -> push("$(context.types.enumConstructorIndexByInterpolationNode -> len)")
    context.types.enumConstructorIndexByInterpolationNode -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.referenceIndexByTypeAst")
    values! -> push("$(context.types.referenceIndexByTypeAst -> len)")
    context.types.referenceIndexByTypeAst -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.lexicalBindingTypeBySymbol")
    values! -> push("$(context.types.lexicalBindingTypeBySymbol -> len)")
    context.types.lexicalBindingTypeBySymbol -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.mutableBindingOwners")
    values! -> push("$(context.types.mutableBindingOwners -> len)")
    context.types.mutableBindingOwners -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.contextualRecordLabelByAst")
    values! -> push("$(context.types.contextualRecordLabelByAst -> len)")
    context.types.contextualRecordLabelByAst -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.directEachRoleTypeBySymbol")
    values! -> push("$(context.types.directEachRoleTypeBySymbol -> len)")
    context.types.directEachRoleTypeBySymbol -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.streamRoleTypeBySymbol")
    values! -> push("$(context.types.streamRoleTypeBySymbol -> len)")
    context.types.streamRoleTypeBySymbol -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.interpolationArrayByNode")
    values! -> push("$(context.types.interpolationArrayByNode -> len)")
    context.types.interpolationArrayByNode -> each entry {
        values! -> push("$(entry.typeId)")
        values! -> push("$(entry.elementTypeId)")
        values! -> push("$(entry.valueAst)")
        values! -> push("$(entry.dynamic)")
        values! -> push("$(entry.bounded)")
        values! -> push("$(entry.storageLength)")
        values! -> push("$(entry.elementCount)")
        values! -> push("$(entry.status)")
        values! -> push("$(entry.diagnosticNode)")
        values! -> push("$(entry.diagnosticContext)")
        values! -> push("$(entry.contextNode)")
        values! -> push("$(entry.expectedTypeId)")
        values! -> push("$(entry.actualTypeId)")
    }
    values! -> push("types.interpolationCallTypeByNode")
    values! -> push("$(context.types.interpolationCallTypeByNode -> len)")
    context.types.interpolationCallTypeByNode -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.interpolationCallSourceByNode")
    values! -> push("$(context.types.interpolationCallSourceByNode -> len)")
    context.types.interpolationCallSourceByNode -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.interpolationCallSymbolByNode")
    values! -> push("$(context.types.interpolationCallSymbolByNode -> len)")
    context.types.interpolationCallSymbolByNode -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.interpolationMethodByNode")
    values! -> push("$(context.types.interpolationMethodByNode -> len)")
    context.types.interpolationMethodByNode -> each entry {
        values! -> push("$(entry.sourceModule)")
        values! -> push("$(entry.symbol)")
        values! -> push("$(entry.receiverType)")
        values! -> push("$(entry.ownerType)")
        values! -> push("$(entry.traitModule)")
        values! -> push("$(entry.traitSymbol)")
        values! -> push("$(entry.expectedAdditionalArguments)")
        values! -> push("$(entry.status)")
    }
    values! -> push("types.interpolationCallArguments")
    values! -> push("$(context.types.interpolationCallArguments -> len)")
    context.types.interpolationCallArguments -> each entry {
        values! -> push("$(entry.sourceModule)")
        values! -> push("$(entry.callNode)")
        values! -> push("$(entry.argumentNode)")
        values! -> push("$(entry.inputFromFlow)")
        values! -> push("$(entry.parameterSymbol)")
        values! -> push("$(entry.parameterOrdinal)")
        values! -> push("$(entry.targetSourceModule)")
        values! -> push("$(entry.functionSymbol)")
        values! -> push("$(entry.expectedTypeId)")
        values! -> push("$(entry.actualTypeId)")
    }
    values! -> push("types.interpolationLexicalTypeByNode")
    values! -> push("$(context.types.interpolationLexicalTypeByNode -> len)")
    context.types.interpolationLexicalTypeByNode -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.interpolationMemberTypeByNode")
    values! -> push("$(context.types.interpolationMemberTypeByNode -> len)")
    context.types.interpolationMemberTypeByNode -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.interpolationIndexedTypeByNode")
    values! -> push("$(context.types.interpolationIndexedTypeByNode -> len)")
    context.types.interpolationIndexedTypeByNode -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.interpolationContextualStructTypeByNode")
    values! -> push("$(context.types.interpolationContextualStructTypeByNode -> len)")
    context.types.interpolationContextualStructTypeByNode -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.interpolationContextualFieldByNode")
    values! -> push("$(context.types.interpolationContextualFieldByNode -> len)")
    context.types.interpolationContextualFieldByNode -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.interpolationContextualDiagnosticByNode")
    values! -> push("$(context.types.interpolationContextualDiagnosticByNode -> len)")
    context.types.interpolationContextualDiagnosticByNode -> each entry {
        values! -> push("$(entry.code)")
        values! -> push("$(entry.locationNode)")
        values! -> push("$(entry.fieldIndex)")
        values! -> push("$(entry.actualType)")
        values! -> push("$(entry.ownerType)")
    }
    values! -> push("types.interpolationIndexExpectedTypeByNode")
    values! -> push("$(context.types.interpolationIndexExpectedTypeByNode -> len)")
    context.types.interpolationIndexExpectedTypeByNode -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.interpolationUnsupportedIndexOwnerTypeByNode")
    values! -> push("$(context.types.interpolationUnsupportedIndexOwnerTypeByNode -> len)")
    context.types.interpolationUnsupportedIndexOwnerTypeByNode -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.interpolationOwnedIndexElementTypeByNode")
    values! -> push("$(context.types.interpolationOwnedIndexElementTypeByNode -> len)")
    context.types.interpolationOwnedIndexElementTypeByNode -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.interpolationOwnedIndexContainerByNode")
    values! -> push("$(context.types.interpolationOwnedIndexContainerByNode -> len)")
    context.types.interpolationOwnedIndexContainerByNode -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.interpolationUnaryTypeByNode")
    values! -> push("$(context.types.interpolationUnaryTypeByNode -> len)")
    context.types.interpolationUnaryTypeByNode -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.interpolationUnaryStatusByNode")
    values! -> push("$(context.types.interpolationUnaryStatusByNode -> len)")
    context.types.interpolationUnaryStatusByNode -> each entry {
        values! -> push("$entry")
    }
    values! -> push("types.activeDeclarationBodyByAst")
    values! -> push("$(context.types.activeDeclarationBodyByAst -> len)")
    context.types.activeDeclarationBodyByAst -> each entry {
        values! -> push("$entry")
    }
    values! -> push("prepared.calls")
    values! -> push("$(context.prepared.calls -> len)")
    context.prepared.calls -> each entry {
        values! -> push("$(entry.sourceModule)")
        values! -> push("$(entry.callAst)")
        values! -> push("$(entry.origin)")
        values! -> push("$(entry.targetModule)")
        values! -> push("$(entry.targetSourceModule)")
        values! -> push("$(entry.functionSymbol)")
        values! -> push("$(entry.status)")
    }
    values! -> push("prepared.callIndexByAst")
    values! -> push("$(context.prepared.callIndexByAst -> len)")
    context.prepared.callIndexByAst -> each entry {
        values! -> push("$entry")
    }
    values! -> push("prepared.callResultMemberByAst")
    values! -> push("$(context.prepared.callResultMemberByAst -> len)")
    context.prepared.callResultMemberByAst -> each entry {
        values! -> push("$entry")
    }
    values! -> push("prepared.declaredMoveArgumentByAst")
    values! -> push("$(context.prepared.declaredMoveArgumentByAst -> len)")
    context.prepared.declaredMoveArgumentByAst -> each entry {
        values! -> push("$entry")
    }
    values! -> push("prepared.declaredMoveReadByAst")
    values! -> push("$(context.prepared.declaredMoveReadByAst -> len)")
    context.prepared.declaredMoveReadByAst -> each entry {
        values! -> push("$entry")
    }
    values!
}

digest values: ref [Text; ~] -> [UInt8; 32] {
    sha256.create() => hash!
    values -> each word {
        [UInt8; ~] => bytes!
        UIntSize(0) => index!
        index! < (word -> len) -> while {
            bytes! -> push(word -> byte(index!))
            index! + 1 => index!
        }
        bytes! -> push(0)
        hash! -> update(bytes!)
    }
    hash! -> finish
}

public checkStable sources: [Text; ~], label: Text -> Unit uses Console {
    sources -> semanticContext.prepare => prepared
    prepared -> resolveCallContext => completed
    0 => selectedCalls!
    0 => crossModuleCalls!
    completed.prepared.calls -> each call {
        call.status == 0 and call.functionSymbol >= 0 and call.targetSourceModule >= 0
            -> if {
                selectedCalls! + 1 => selectedCalls!
                call.sourceModule != call.targetSourceModule -> if { crossModuleCalls! + 1 => crossModuleCalls! }
            }
    }
    0 => moveArguments!
    completed.prepared.declaredMoveArgumentByAst -> each moved { moved -> if { moveArguments! + 1 => moveArguments! } }
    0 => genericArguments!
    completed.types.callArguments -> each argument { argument.genericParameterSymbol >= 0 -> if { genericArguments! + 1 => genericArguments! } }
    selectedCalls! > 0 and (completed.types.expressions -> len) > 0 => hasFacts!
    label == "move" and moveArguments! == 0 -> if { false => hasFacts! }
    label == "generic" and genericArguments! == 0
        -> if { false => hasFacts! }
    label == "qualified" and crossModuleCalls! == 0
        -> if { false => hasFacts! }
    label == "call-result" and selectedCalls! < 2
        -> if { false => hasFacts! }
    completed -> fingerprint => before
    completed.prepared => committedPrepared
    completed.types => committedTypes
    emptyCallContextSeeds() => seeds
    [ExpressionTypeId; ~] => externalResults
    committedPrepared -> refineResolvedCallContext(committedTypes, seeds, externalResults, true) => repeated
    repeated -> fingerprint => after
    hasFacts! and (before -> len) > 0 and (before -> len) == (after -> len) => same!
    0 => index!
    same! and index! < (before -> len) -> while {
        before[index!] != after[index!] -> if { false => same! }
        index! + 1 => index!
    }
    "$label:$(same!):$(before -> len):$(selectedCalls!):$(genericArguments!):$(moveArguments!):$(crossModuleCalls!)" -> println
    before -> digest => hash
    hash -> each byte { byte -> println }
}

public checkCallFields: -> Unit uses Console {
    calls.ModuleCallResolution { sourceModule: 0, callAst: 1, origin: 2, targetModule: 3, targetSourceModule: 4, functionSymbol: 5, status: 0 } => original
    [original; ~] => left
    left -> callContextDecisionsEqual([original; ~]) => allFields!
    left -> callContextDecisionsEqual([calls.ModuleCallResolution; ~])
        -> if { false => allFields! }
    original => changedsourceModule!
    original.sourceModule + 1 => changedsourceModule!.sourceModule
    left -> callContextDecisionsEqual([changedsourceModule!; ~])
        -> if { false => allFields! }
    original => changedcallAst!
    original.callAst + 1 => changedcallAst!.callAst
    left -> callContextDecisionsEqual([changedcallAst!; ~])
        -> if { false => allFields! }
    original => changedorigin!
    original.origin + 1 => changedorigin!.origin
    left -> callContextDecisionsEqual([changedorigin!; ~])
        -> if { false => allFields! }
    original => changedtargetModule!
    original.targetModule + 1 => changedtargetModule!.targetModule
    left -> callContextDecisionsEqual([changedtargetModule!; ~])
        -> if { false => allFields! }
    original => changedtargetSourceModule!
    original.targetSourceModule + 1 => changedtargetSourceModule!.targetSourceModule
    left -> callContextDecisionsEqual([changedtargetSourceModule!; ~])
        -> if { false => allFields! }
    original => changedfunctionSymbol!
    original.functionSymbol + 1 => changedfunctionSymbol!.functionSymbol
    left -> callContextDecisionsEqual([changedfunctionSymbol!; ~])
        -> if { false => allFields! }
    original => changedstatus!
    original.status + 1 => changedstatus!.status
    left -> callContextDecisionsEqual([changedstatus!; ~])
        -> if { false => allFields! }
    "call-fields:$(allFields!)" -> println
}
