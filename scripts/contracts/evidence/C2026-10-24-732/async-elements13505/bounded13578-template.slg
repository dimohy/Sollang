import sollang.compiler.ast as ast
import sollang.compiler.ir.interpolation as interpolation

main {
    ["make() -> len", "value -> len", "make(1) -> len", "value -> len(1)", "make() -> capacity"; ~] -> each fragment {
        "fragment=$fragment" -> println
        0 => index!
        fragment -> ast.lowerExpression -> each node {
            "ast=$(index!) kind=$(node.kind) parent=$(node.parent) start=$(node.start) length=$(node.length) payload=$(node.payloadToken)" -> println
            index! + 1 => index!
        }
    }
    """make: -> [Int; <=3] => [7, 9]

main {
    "size=$(make() -> len)" -> println
    "first=$(make()[0])" -> println
}
""" => source
    0 => index!
    source -> interpolation.lower -> each node {
        "interpolation=$(index!) kind=$(node.kind) parent=$(node.parent) opcode=$(node.opcode) args=$(node.argumentCount) operand0=$(node.operand0) operand1=$(node.operand1)" -> println
        index! + 1 => index!
    }
    "AST_DIAGNOSTIC_COMPLETE" -> println
}
