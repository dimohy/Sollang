child value: Int -> [Int; <=2] => [value]

make: -> [[Int; <=2]; <=3] => []

main {
    make() => values!
    child(7) => first
    values! -> push(first)
    values! -> push(child(9))
    values! -> exchange(0, 1)
    values! -> take(0) => taken
    values![0] => remaining
    taken[0] -> println
    remaining[0] -> println
    values! -> len -> println
    values! -> capacity -> println
}
