import sollang.compiler.ast as ast
import sollang.compiler.ir.interpolation as interpolation

main {
    ["copy(values!) -> len", "copy(values!)[0]", "values! -> inspect", "owner.values -> copy -> len", "copy(values!).field"; ~] -> each fragment {
        "fragment=$fragment" -> println
        0 => index!
        fragment -> ast.lowerExpression -> each node {
            "ast=$(index!) kind=$(node.kind) parent=$(node.parent) start=$(node.start) length=$(node.length) payload=$(node.payloadToken)" -> println
            index! + 1 => index!
        }
    }
    """struct Storage {
    public values: [Int; <=3]
}

make: -> [Int; <=3] => [7, 9]

copy values: [Int; <=3] -> [Int; <=3] => values

inspect values: ref [Int; <=3] -> Int => values -> len

describe values: ref [Int; <=3] -> Unit uses Console {
    "refLen=$(values -> len)" -> println
    "refItem=$(values[0])" -> println
}

main {
    make() => values!
    42 => values![1]
    Storage { values: [11, 13] } => owner
    "copy=$(copy(values!) -> len)" -> println
    "first=$(copy(values!)[0])" -> println
    "read=$(values! -> inspect)" -> println
    "field=$(owner.values[0])" -> println
    "fieldSize=$(owner.values -> copy -> len)" -> println
    "cap=$(owner.values -> capacity)" -> println
    values! -> describe
}
""" => source
    0 => index!
    source -> interpolation.lower -> each node {
        "interpolation=$(index!) kind=$(node.kind) parent=$(node.parent) opcode=$(node.opcode) args=$(node.argumentCount) operand0=$(node.operand0) operand1=$(node.operand1)" -> println
        index! + 1 => index!
    }
    "AST_DIAGNOSTIC_COMPLETE" -> println
}
