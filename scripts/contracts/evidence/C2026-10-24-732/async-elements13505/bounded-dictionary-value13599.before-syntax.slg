make: -> [Int; <=3] => [7, 9]

main {
    { 1: make(); ~ } => values!
    values! -> put(2, make())
    values![1] => first
    values! -> take(2) => second
    first[0] -> println
    first -> len => firstLength
    firstLength -> println
    second[1] -> println
    values! -> len => remaining
    remaining -> println
}
