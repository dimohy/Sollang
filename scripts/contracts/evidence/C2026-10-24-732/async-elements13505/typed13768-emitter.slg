    "scripts/probes/declared-value-layout/inferred-nested-literal.slg",
    "scripts/probes/declared-value-layout/nested-growable-mut-parameter-control.slg"
    ] => allowedPrograms
    false => allowed!
    allowedPrograms -> each candidate {
        (programPath -> text.compareOrdinal(candidate)) == 0
            -> if { true => allowed! }
    }
    not allowed! -> if {
        "SELECTION_RUNTIME_PROGRAM_PATH_NOT_DECLARED" -> println
        process.exit(1)
    }
    [
    "stdlib/std/algorithm.slg",
