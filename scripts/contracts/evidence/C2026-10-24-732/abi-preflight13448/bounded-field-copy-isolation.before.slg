struct Storage {
    public values: [Int; <=3]
}

make: -> Storage => Storage { values: [7, 9] }

main {
    make() => original
    original => second!
    42 => second!.values[0]
    original.values[0] -> println
    second!.values[0] -> println
    original.values -> len -> println
    second!.values -> len -> println
}
