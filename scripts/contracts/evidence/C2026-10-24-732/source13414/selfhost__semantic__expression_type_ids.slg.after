                            prepared.package.sources[sourceModule] -> slice(literal.payloadStart, literal.payloadLength) => spelling
                            (not (spelling -> numericLiteralRange.literalUsesFloatingSyntax(0, literal.payloadLength)) and expected.symbol < 19)
                                or (expected.symbol >= 19 and not inputFromFlow)
