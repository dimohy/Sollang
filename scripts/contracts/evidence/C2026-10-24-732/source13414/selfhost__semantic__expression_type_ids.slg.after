                -> while {
                    prepared.package.symbols[parameterRange.symbolStart + parameterSymbolIndex!] => parameter
                    parameter.kind == 35 and parameter.parent >= 0 and parameter.parent < parameterRange.symbolCount
                        -> if {
                            prepared.package.symbols[parameterRange.symbolStart + parameter.parent] => function
                            function.kind == 7 or function.kind == 31 -> if {
                                prepared.package -> typeIds.functionParameterTypeId(references!, referenceIndexByTypeAst!, parameterSourceIndex!, parameterSymbolIndex!) => parameterTypeId
                                parameterTypeId >= 0 and parameterTypeId < (types! -> len)
                                    and not types![parameterTypeId].containsParameter
                                    -> if {
                                        parameterTypeId => lexicalBindingTypeBySymbol![parameterRange.symbolStart + parameterSymbolIndex!]
                                    }
                            }
                        }
                    prepared -> primaryBlockRoleTypeId(types!, references!, referenceIndexByTypeAst!, expressions!, expressionIndexByAst!, blockAndFlowArgumentBindings, parameterSourceIndex!, parameter) => declaredRoleType
                    declaredRoleType >= 0 -> if {
                        declaredRoleType => lexicalBindingTypeBySymbol![parameterRange.symbolStart + parameterSymbolIndex!]
                    }
                    parameterSymbolIndex! + 1 => parameterSymbolIndex!
                }
            parameterSourceIndex! + 1 => parameterSourceIndex!
        }

    0 => patternSymbolIndex!
    patternSymbolIndex! < (patternBindingTypeBySymbol! -> len)
        -> while {
            patternBindingTypeBySymbol![patternSymbolIndex!] >= 0
                -> if { patternBindingTypeBySymbol![patternSymbolIndex!] => lexicalBindingTypeBySymbol![patternSymbolIndex!] }
            patternSymbolIndex! + 1 => patternSymbolIndex!
        }

    # Resolve a direct each block's input role from its source expression even
    # when the role appears only inside interpolation, which has no AST name
    # reference. Index candidate expressions by their enclosing each scope so
    # each expression and ancestor edge is visited once.
    [Bool; ~] => directEachScopeByAst!
    [UIntSize; ~] => directEachKeywordStartByAst!
    [Int; ~] => directEachSourceExpressionByAst!
    [UIntSize; ~] => directEachSourceEndByAst!
    [Int; ~] => directEachSourceDistanceByAst!
    prepared.package.nodes -> each scopeNode {
        directEachScopeByAst! -> push(false)
        directEachKeywordStartByAst! -> push(0)
        directEachSourceExpressionByAst! -> push(-1)
        directEachSourceEndByAst! -> push(0)
        directEachSourceDistanceByAst! -> push(1000000)
    }
    0 => eachScopeSource!
    eachScopeSource! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[eachScopeSource!] => range
            prepared.package.sources[eachScopeSource!] -> len => sourceLength
            prepared.package.sources[eachScopeSource!] -> slice(UIntSize(0), sourceLength) => source
            0 => scopeSymbolIndex!
            scopeSymbolIndex! < range.symbolCount -> while {
                prepared.package.symbols[range.symbolStart + scopeSymbolIndex!] => scopeSymbol
                scopeSymbol.kind == 48 and scopeSymbol.astNode >= 0 and scopeSymbol.astNode < range.astCount
                    -> if {
                        prepared.package.nodes[range.astStart + scopeSymbol.astNode] => scopeAst
                        scopeAst.payloadToken >= 0 -> if {
                            prepared.package.tokens[range.tokenStart + scopeAst.payloadToken] => keyword
                            prepared -> intrinsicCollectionRoleKind(eachScopeSource!, scopeSymbol.astNode) => collectionRoleKind
                            collectionRoleKind > 0 -> if {
                                true => directEachScopeByAst![range.astStart + scopeSymbol.astNode]
                                keyword.span.start => directEachKeywordStartByAst![range.astStart + scopeSymbol.astNode]
                            }
                        }
                    }
                scopeSymbolIndex! + 1 => scopeSymbolIndex!
            }
            eachScopeSource! + 1 => eachScopeSource!
        }
    0 => eachCandidateIndex!
    eachCandidateIndex! < (expressions! -> len) -> while {
        expressions![eachCandidateIndex!] => candidate
        candidate.status == 0 and candidate.sourceModule >= 0
            and candidate.sourceModule < (prepared.package.ranges -> len)
            -> if {
                prepared.package.ranges[candidate.sourceModule] => range
                candidate.astNode >= 0 and candidate.astNode < range.astCount
                    -> if {
                        prepared.package.nodes[range.astStart + candidate.astNode] => candidateAst
                        candidateAst.start + candidateAst.length => candidateEnd
                        candidateAst.parent => ancestor!
                        1 => distance!
                        ancestor! >= 0 and ancestor! < range.astCount
                            -> while {
                                range.astStart + ancestor! => globalAncestor
                                directEachScopeByAst![globalAncestor] and candidateEnd <= directEachKeywordStartByAst![globalAncestor]
                                    and (directEachSourceExpressionByAst![globalAncestor] < 0
                                    or candidateEnd > directEachSourceEndByAst![globalAncestor]
                                    or (candidateEnd == directEachSourceEndByAst![globalAncestor]
                                    and distance! < directEachSourceDistanceByAst![globalAncestor]))
                                    -> if {
                                        eachCandidateIndex! => directEachSourceExpressionByAst![globalAncestor]
                                        candidateEnd => directEachSourceEndByAst![globalAncestor]
                                        distance! => directEachSourceDistanceByAst![globalAncestor]
                                    }
                                prepared.package.nodes[globalAncestor].parent => ancestor!
                                distance! + 1 => distance!
                            }
                    }
            }
        eachCandidateIndex! + 1 => eachCandidateIndex!
    }
    [Int; ~] => directEachRoleTypeBySymbol!
    prepared.package.symbols -> each roleSymbol { directEachRoleTypeBySymbol! -> push(-1) }
    0 => eachRoleSource!
    eachRoleSource! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[eachRoleSource!] => range
            0 => roleSymbolIndex!
            roleSymbolIndex! < range.symbolCount -> while {
                prepared.package.symbols[range.symbolStart + roleSymbolIndex!] => role
                role.kind == 35 and role.parent >= 0 and role.parent < range.symbolCount
                    -> if {
                        prepared.package.symbols[range.symbolStart + role.parent] => scope
                        scope.kind == 48 and scope.astNode >= 0 and scope.astNode < range.astCount
                            and directEachScopeByAst![range.astStart + scope.astNode]
                            -> if {
                                directEachSourceExpressionByAst![range.astStart + scope.astNode] => sourceExpressionIndex
                                sourceExpressionIndex >= 0 -> if {
                                    expressions![sourceExpressionIndex].typeId => collectionTypeId!
                                    collectionTypeId! >= 0 and collectionTypeId! < (types! -> len)
                                        -> if {
                                            types! -> typeIds.materializedReadTypeId(collectionTypeId!) => collectionTypeId!
                                            types![collectionTypeId!] => collection
                                            -1 => elementTypeId!
                                            collection.kind == 2 or collection.kind == 3 or collection.kind == 4 or collection.kind == 12
                                                -> if { collection.first => elementTypeId! }
                                            collection.kind == 7 and collection.origin == 4
                                                and collection.symbol >= 3 and collection.symbol <= 7
                                                -> if { collection.first => elementTypeId! }
                                            collection.kind == 1 and collection.origin == 1
                                                -> if {
                                                    collection.symbol == 1 -> if { types! -> typeIds.builtinTypeId(14) => elementTypeId! }
                                                    collection.symbol == 16 -> if { types! -> typeIds.builtinTypeId(1) => elementTypeId! }
                                                    collection.symbol == 17 or collection.symbol == 18
                                                        -> if { types! -> typeIds.builtinTypeId(8) => elementTypeId! }
                                                    collection.symbol == 25 -> if { types! -> typeIds.builtinTypeId(2) => elementTypeId! }
                                                }
                                            (prepared -> intrinsicCollectionRoleKind(eachRoleSource!, scope.astNode)) == 4
                                                -> if { types! -> typeIds.builtinTypeId(2) => elementTypeId! }
                                            elementTypeId! >= 0 and elementTypeId! < (types! -> len)
                                                -> if { elementTypeId! => directEachRoleTypeBySymbol![range.symbolStart + roleSymbolIndex!] }
                                        }
                                }
                            }
                    }
                roleSymbolIndex! + 1 => roleSymbolIndex!
            }
            eachRoleSource! + 1 => eachRoleSource!
        }

    # Commit each interpolation name to the same materialized lexical type
    # used by ordinary name inference before Typed IR is lowered.
    [Int; ~] => interpolationLexicalTypeByNode!
    prepared.interpolations -> each interpolationNode {
        interpolationLexicalTypeByNode! -> push(-1)
    }
    prepared.interpolationRanges -> each interpolationRange {
        interpolationRange.sourceModule >= 0
            and interpolationRange.sourceModule < (prepared.package.ranges -> len)
            -> if {
                prepared.package.ranges[interpolationRange.sourceModule] => sourceRange
                interpolationRange.nodeStart => interpolationNodeIndex!
                interpolationNodeIndex! < interpolationRange.nodeStart + interpolationRange.nodeCount
                    -> while {
                        prepared.interpolations[interpolationNodeIndex!] => name
                        name.kind == 1 and name.symbol >= 0 and name.symbol < sourceRange.symbolCount
                            -> if {
                                sourceRange.symbolStart + name.symbol => globalSymbol
                                -1 => lexicalType!
                                lexicalBindingTypeBySymbol![globalSymbol] => lexicalType!
                                lexicalType! < 0 -> if { directEachRoleTypeBySymbol![globalSymbol] => lexicalType! }
                                lexicalType! < 0 -> if { streamRoleTypeBySymbol![globalSymbol] => lexicalType! }
                                lexicalType! >= 0 and lexicalType! < (types! -> len)
                                    -> if {
                                        types! -> typeIds.materializedReadTypeId(lexicalType!)
                                            => interpolationLexicalTypeByNode![interpolationNodeIndex!]
                                    }
                            }
                        interpolationNodeIndex! + 1 => interpolationNodeIndex!
                    }
            }
    }

    # Resolve each member or index after its receiver, matching recursive C# inference.
    # Inaccessible or unresolved fields remain for the later diagnostic path.
    [Int; ~] => interpolationCallTypeByNode!
    [Int; ~] => interpolationCallSourceByNode!
    [Int; ~] => interpolationCallSymbolByNode!
    [InterpolationMethodDecision; ~] => interpolationMethodByNode!
    [InterpolationArrayFact; ~] => interpolationArrayByNode!
    prepared.interpolations -> each node { interpolationArrayByNode! -> push(emptyInterpolationArrayFact()) }
    [ResolvedInterpolationCallArgument; ~] => interpolationCallArguments!
    [ResolvedEnumConstructorArgument; ~] => interpolationEnumConstructorArguments!
    [Int; ~] => interpolationEnumConstructorIndex!
    prepared.interpolations -> each node {
        interpolationCallTypeByNode! -> push(-1)
        interpolationEnumConstructorIndex! -> push(-1)
        interpolationCallSourceByNode! -> push(-1)
        interpolationCallSymbolByNode! -> push(-1)
        interpolationMethodByNode! -> push(emptyInterpolationMethodDecision())
    }
    [Int; ~] => interpolationMemberTypeByNode!
    prepared.interpolations -> each interpolationNode {
        interpolationMemberTypeByNode! -> push(-1)
    }
    # Commit the C# owner check before considering the index operand.
    # Supported collection indexing then records its expected index type.
    [Int; ~] => interpolationIndexedTypeByNode!
    [Int; ~] => interpolationContextualStructTypeByNode!
    [Int; ~] => interpolationContextualFieldByNode!
    [Int; ~] => interpolationIndexExpectedTypeByNode!
    [Int; ~] => interpolationUnsupportedIndexOwnerTypeByNode!
    [Int; ~] => interpolationOwnedIndexElementTypeByNode!
    [Int; ~] => interpolationOwnedIndexContainerByNode!
    prepared.interpolations -> each interpolationNode {
        interpolationIndexedTypeByNode! -> push(-1)
        interpolationContextualStructTypeByNode! -> push(-1)
        interpolationContextualFieldByNode! -> push(-1)
        interpolationIndexExpectedTypeByNode! -> push(-1)
        interpolationUnsupportedIndexOwnerTypeByNode! -> push(-1)
        interpolationOwnedIndexElementTypeByNode! -> push(-1)
        interpolationOwnedIndexContainerByNode! -> push(-1)
    }

    prepared.interpolationRanges -> each interpolationRange {
        interpolationRange.sourceModule >= 0
            and interpolationRange.sourceModule < (prepared.package.ranges -> len)
            -> if {
                interpolationRange.nodeStart => literalNodeIndex!
                literalNodeIndex! < interpolationRange.nodeStart + interpolationRange.nodeCount
                    -> while {
                        prepared.interpolations[literalNodeIndex!].kind == 14
                            -> if {
                                prepared -> nominalInterpolationTypeId(types!, interpolationRange.sourceModule, literalNodeIndex!)
                                    => interpolationContextualStructTypeByNode![literalNodeIndex!]
                            }
                        literalNodeIndex! + 1 => literalNodeIndex!
                    }
            }
    }

    prepared.interpolationRanges -> each interpolationRange {
        interpolationRange.sourceModule >= 0
            and interpolationRange.sourceModule < (prepared.package.ranges -> len)
            -> if {
                interpolationRange.nodeStart + interpolationRange.nodeCount => memberNodeIndex!
                memberNodeIndex! > interpolationRange.nodeStart
                    -> while {
                        memberNodeIndex! - 1 => memberNodeIndex!
                        prepared.interpolations[memberNodeIndex!] => member
                        member.kind == 16 -> if {
                            -1 => expectedArrayType!
                            member.valueAst >= 0 and member.valueAst < prepared.package.ranges[interpolationRange.sourceModule].astCount
                                -> if { expectedContextByAst![prepared.package.ranges[interpolationRange.sourceModule].astStart + member.valueAst] => expectedArrayType! }
                            prepared -> resolveInterpolationArrayLiteral(types!, references!, referenceIndexByTypeAst!, interpolationLexicalTypeByNode!, interpolationMemberTypeByNode!, interpolationIndexedTypeByNode!, interpolationContextualStructTypeByNode!, interpolationCallTypeByNode!, interpolationArrayByNode!, interpolationRange.sourceModule, memberNodeIndex!, expectedArrayType!, false) => arrayFact
                            arrayFact => interpolationArrayByNode![memberNodeIndex!]
                            arrayFact.status == 0 -> if { arrayFact.typeId => interpolationContextualStructTypeByNode![memberNodeIndex!] }
                        }
                        member.kind == 15 or (member.kind == 10 and member.targetAst >= 0)
                            -> if {
                                resolveInterpolationEnumConstructor(prepared, types!, references!, referenceIndexByTypeAst!, interpolationLexicalTypeByNode!, interpolationMemberTypeByNode!, interpolationIndexedTypeByNode!, interpolationContextualStructTypeByNode!, interpolationCallTypeByNode!, interpolationArrayByNode!, interpolationRange.sourceModule, memberNodeIndex!) => constructor
                                constructor.expectedTypeId >= 0 or constructor.memberStatus > 0
                                    -> if {
                                        interpolationEnumConstructorArguments! -> len => interpolationEnumConstructorIndex![memberNodeIndex!]
                                        interpolationEnumConstructorArguments! -> push(constructor)
                                        constructor.memberStatus == 3
                                            or (constructor.memberStatus == 0 and constructor.actualTypeId == constructor.expectedTypeId)
                                            -> if { constructor.enumTypeId => interpolationCallTypeByNode![memberNodeIndex!] }
                                    }
                            }
                        member.kind == 6 or member.kind == 8 or member.kind == 10
                            -> if {
                                resolveInterpolationCallReturnType(prepared, types!, references!, referenceIndexByTypeAst!, interpolationLexicalTypeByNode!, interpolationMemberTypeByNode!, interpolationIndexedTypeByNode!, interpolationContextualStructTypeByNode!, interpolationCallTypeByNode!, interpolationArrayByNode!, interpolationRange.sourceModule, memberNodeIndex!, interpolationCallSourceByNode!, interpolationCallSymbolByNode!, interpolationMethodByNode!, interpolationCallArguments!) => callType
                                callType >= 0 -> if { callType => interpolationCallTypeByNode![memberNodeIndex!] }
                            }
                        member.kind == 5 and member.operand0 >= 0
                            and member.operand0 < (interpolationLexicalTypeByNode! -> len)
                            -> if {
                                prepared -> preIrInterpolationReceiverTypeId(types!, references!, referenceIndexByTypeAst!, interpolationLexicalTypeByNode!, interpolationMemberTypeByNode!, interpolationIndexedTypeByNode!, interpolationContextualStructTypeByNode!, interpolationCallTypeByNode!, interpolationRange.sourceModule, member.operand0) => ownerTypeId
                                ownerTypeId >= 0 and ownerTypeId < (types! -> len)
                                    -> if {
                                        prepared -> memberFieldIndex(types!, fields!, interpolationRange.sourceModule, ownerTypeId, memberNodeIndex!) => fieldIndex
                                        prepared -> accessibleMemberFieldType(fields!, interpolationRange.sourceModule, fieldIndex)
                                            => fieldTypeId
                                        fieldTypeId >= 0 -> if { fieldTypeId => interpolationMemberTypeByNode![memberNodeIndex!] }
                                    }
                            }
                        prepared.interpolations[memberNodeIndex!] => indexed
                        indexed.kind == 7 and indexed.operand0 >= 0 and indexed.operand1 >= 0
                            and indexed.operand0 < (interpolationLexicalTypeByNode! -> len)
                            -> if {
                                prepared -> preIrInterpolationReceiverTypeId(types!, references!, referenceIndexByTypeAst!, interpolationLexicalTypeByNode!, interpolationMemberTypeByNode!, interpolationIndexedTypeByNode!, interpolationContextualStructTypeByNode!, interpolationCallTypeByNode!, interpolationRange.sourceModule, indexed.operand0) => ownerTypeId!
                                ownerTypeId! >= 0 -> if {
                                    ownerTypeId! >= 0 and ownerTypeId! < (types! -> len)
                                        -> if {
                                            types! -> typeIds.materializedReadTypeId(ownerTypeId!) => ownerTypeId!
                                            types![ownerTypeId!] => ownerType
                                            false => supportedIndexOwner!
                                            ownerType.kind == 2 or ownerType.kind == 3 or ownerType.kind == 4
                                                or ownerType.kind == 5 or ownerType.kind == 12 or ownerType.kind == 13
                                                -> if { true => supportedIndexOwner! }
                                            ownerType.kind == 1 and ownerType.origin == 1
                                                and (ownerType.symbol == 16 or ownerType.symbol == 17 or ownerType.symbol == 18)
                                                -> if { true => supportedIndexOwner! }
                                            not supportedIndexOwner! -> if {
                                                ownerTypeId! => interpolationUnsupportedIndexOwnerTypeByNode![memberNodeIndex!]
                                            }
                                            ownerType.kind == 2 or ownerType.kind == 3 or ownerType.kind == 4 or ownerType.kind == 12
                                                -> if {
                                                    types! -> typeIds.builtinTypeId(2) => expectedIndexTypeId
                                                    prepared -> preIrIntIndexExpression(types!, interpolationLexicalTypeByNode!, interpolationRange.sourceModule, indexed.operand1) => validIndex
                                                    validIndex -> if {
                                                        prepared -> semanticContext.typeContainsOwnedStorage(types!, ownerType.first)
                                                            -> if {
                                                                ownerType.first => interpolationOwnedIndexElementTypeByNode![memberNodeIndex!]
                                                                1 => interpolationOwnedIndexContainerByNode![memberNodeIndex!]
                                                            } else {
                                                                ownerType.first >= 0 and ownerType.first < (types! -> len)
                                                                    -> if { ownerType.first => interpolationIndexedTypeByNode![memberNodeIndex!] }
                                                            }
                                                    } else {
                                                        prepared.interpolations[indexed.operand1] => indexNode
                                                        indexNode.kind == 1 and indexed.operand1 < (interpolationLexicalTypeByNode! -> len)
                                                            -> if {
                                                                interpolationLexicalTypeByNode![indexed.operand1] => actualIndexTypeId
                                                                actualIndexTypeId >= 0 and actualIndexTypeId < (types! -> len)
                                                                    and expectedIndexTypeId >= 0
                                                                    -> if { expectedIndexTypeId => interpolationIndexExpectedTypeByNode![memberNodeIndex!] }
                                                            }
                                                    }
                                                } else {
                                                    ownerType.kind == 5 or ownerType.kind == 13 -> if {
                                                        ownerType.first => expectedIndexTypeId
                                                        expectedIndexTypeId >= 0 and expectedIndexTypeId < (types! -> len)
                                                            and ownerType.second >= 0 and ownerType.second < (types! -> len)
                                                            -> if {
                                                                types![expectedIndexTypeId] => keyType
                                                                prepared.interpolations[indexed.operand1] => indexNode
                                                                indexNode.kind == 12 and keyType.kind == 1
                                                                    and (keyType.origin == 0 or keyType.origin == 2)
                                                                    -> if {
                                                                        expectedIndexTypeId => interpolationContextualStructTypeByNode![indexed.operand1]
                                                                    }
                                                                keyType.kind == 1 and keyType.origin == 1 -> if {
                                                                    -1 => actualIndexTypeId!
                                                                    indexNode.kind == 1 and indexed.operand1 < (interpolationLexicalTypeByNode! -> len)
                                                                        -> if { interpolationLexicalTypeByNode![indexed.operand1] => actualIndexTypeId! }
                                                                    false => validIndex!
                                                                    actualIndexTypeId! >= 0 and actualIndexTypeId! == expectedIndexTypeId
                                                                        -> if { true => validIndex! }
                                                                    keyType.symbol == 2 -> if {
                                                                        prepared -> preIrIntIndexExpression(types!, interpolationLexicalTypeByNode!, interpolationRange.sourceModule, indexed.operand1)
                                                                            -> if { true => validIndex! }
                                                                    }
                                                                    validIndex! -> if {
                                                                        prepared -> semanticContext.typeContainsOwnedStorage(types!, ownerType.second)
                                                                            -> if {
                                                                                ownerType.second => interpolationOwnedIndexElementTypeByNode![memberNodeIndex!]
                                                                                2 => interpolationOwnedIndexContainerByNode![memberNodeIndex!]
                                                                            } else {
                                                                                ownerType.second >= 0 and ownerType.second < (types! -> len)
                                                                                    -> if { ownerType.second => interpolationIndexedTypeByNode![memberNodeIndex!] }
                                                                            }
                                                                    } else {
                                                                        actualIndexTypeId! >= 0 and actualIndexTypeId! < (types! -> len)
                                                                            -> if { expectedIndexTypeId => interpolationIndexExpectedTypeByNode![memberNodeIndex!] }
                                                                    }
                                                                }
                                                            }
                                                    } else {
                                                        ownerType.kind == 1 and ownerType.origin == 1
                                                            and (ownerType.symbol == 16 or ownerType.symbol == 17 or ownerType.symbol == 18)
                                                            -> if {
                                                                types! -> typeIds.builtinTypeId(13) => expectedIndexTypeId
                                                                prepared -> preIrUIntSizeIndexExpression(types!, interpolationLexicalTypeByNode!, interpolationRange.sourceModule, indexed.operand1)
                                                                    => validIndex
                                                                validIndex -> if {
                                                                    ownerType.symbol == 16 -> if { 1 } else { 8 } => resultSymbol
                                                                    types! -> typeIds.builtinTypeId(resultSymbol) => resultTypeId
                                                                    resultTypeId >= 0 -> if { resultTypeId => interpolationIndexedTypeByNode![memberNodeIndex!] }
                                                                } else {
                                                                    prepared.interpolations[indexed.operand1] => indexNode
                                                                    indexNode.kind == 1 and indexed.operand1 < (interpolationLexicalTypeByNode! -> len)
                                                                        -> if {
                                                                            interpolationLexicalTypeByNode![indexed.operand1] => actualIndexTypeId
                                                                            actualIndexTypeId >= 0 and expectedIndexTypeId >= 0
                                                                                -> if { expectedIndexTypeId => interpolationIndexExpectedTypeByNode![memberNodeIndex!] }
                                                                        }
                                                                }
                                                            }
                                                    }
                                                }
                                        }
                                }
                            }
                    }
            }
    }

    prepared.interpolationRanges -> each interpolationRange {
        interpolationRange.nodeStart => labelNodeIndex!
        labelNodeIndex! < interpolationRange.nodeStart + interpolationRange.nodeCount
            -> while {
                prepared.interpolations[labelNodeIndex!] => label
                label.kind == 13 and label.parent >= 0
                    and label.parent < (interpolationContextualStructTypeByNode! -> len)
                    -> if {
                        interpolationContextualStructTypeByNode![label.parent] => ownerTypeId
                        ownerTypeId >= 0 -> if {
                            prepared -> contextualStructFieldIndex(fields!, interpolationRange.sourceModule, ownerTypeId, labelNodeIndex!)
                                => interpolationContextualFieldByNode![labelNodeIndex!]
                        }
                    }
                labelNodeIndex! + 1 => labelNodeIndex!
            }
    }

    [ContextualStructDiagnostic; ~] => interpolationContextualDiagnosticByNode!
    prepared.interpolations -> each interpolationNode {
        interpolationContextualDiagnosticByNode! -> push(ContextualStructDiagnostic {
            code: 0
            locationNode: -1
            fieldIndex: -1
            actualType: -1
            ownerType: -1
        })
    }
    prepared.interpolationRanges -> each interpolationRange {
        interpolationRange.nodeStart => literalIndex!
        literalIndex! < interpolationRange.nodeStart + interpolationRange.nodeCount
            -> while {
                prepared.interpolations[literalIndex!].kind == 12 or prepared.interpolations[literalIndex!].kind == 14
                    -> if {
                        prepared -> contextualStructDiagnostic(types!, fields!, interpolationLexicalTypeByNode!, interpolationContextualStructTypeByNode!, interpolationContextualFieldByNode!, interpolationRange.sourceModule, literalIndex!)
                            => interpolationContextualDiagnosticByNode![literalIndex!]
                    }
                literalIndex! + 1 => literalIndex!
            }
    }

    # Direct and nested unary operands with committed semantic types decide the
    # unary result and invalid operand before Typed IR. Other operand shapes
    # remain unresolved until their own type producers move.
    [Int; ~] => interpolationUnaryTypeByNode!
    [Int; ~] => interpolationUnaryStatusByNode!
    prepared.interpolations -> each interpolationNode {
        interpolationUnaryTypeByNode! -> push(-1)
        interpolationUnaryStatusByNode! -> push(-1)
    }
    prepared.interpolationRanges -> each interpolationRange {
        interpolationRange.nodeStart => unaryNodeIndex!
        unaryNodeIndex! < interpolationRange.nodeStart + interpolationRange.nodeCount
            -> while {
                prepared.interpolations[unaryNodeIndex!] => unary
                unary.kind == 2 and unary.operand0 >= 0 and unary.operand0 < (prepared.interpolations -> len)
                    -> if {
                        prepared.interpolations[unary.operand0] => operand
                        -1 => operandTypeId!
                        operand.kind == 1 -> if {
                            interpolationLexicalTypeByNode![unary.operand0] => operandTypeId!
                        }
                        operand.kind == 5 -> if {
                            interpolationMemberTypeByNode![unary.operand0] => operandTypeId!
                        }
                        operand.kind == 7 -> if {
                            interpolationIndexedTypeByNode![unary.operand0] => operandTypeId!
                        }
                        operand.kind == 4 -> if { types! -> typeIds.builtinTypeId(23) => operandTypeId! }
                        operand.kind == 0 -> if {
                            prepared.package.sources[interpolationRange.sourceModule]
                                -> slice(operand.payloadStart, operand.payloadLength) => literal
                            literal -> numericLiteralRange.literalUsesFloatingSyntax(0, operand.payloadLength)
                                => floatingLiteral
                            floatingLiteral -> if { types! -> typeIds.builtinTypeId(20) => operandTypeId! } else {
                                types! -> typeIds.builtinTypeId(2) => operandTypeId!
                            }
                        }
                        types! -> interpolationUnaryDecision(operandTypeId!, unary.opcode) => decision
                        decision.typeId => interpolationUnaryTypeByNode![unaryNodeIndex!]
                        decision.status => interpolationUnaryStatusByNode![unaryNodeIndex!]
                    }
                unaryNodeIndex! + 1 => unaryNodeIndex!
            }
        interpolationRange.nodeStart + interpolationRange.nodeCount - 1 => nestedUnaryIndex!
        nestedUnaryIndex! >= interpolationRange.nodeStart
            -> while {
                prepared.interpolations[nestedUnaryIndex!] => unary
                unary.kind == 2 and unary.operand0 >= 0 and unary.operand0 < (prepared.interpolations -> len)
                    and prepared.interpolations[unary.operand0].kind == 2
                    and interpolationUnaryStatusByNode![unary.operand0] == 0
                    -> if {
                        types! -> interpolationUnaryDecision(interpolationUnaryTypeByNode![unary.operand0], unary.opcode) => decision
                        decision.typeId => interpolationUnaryTypeByNode![nestedUnaryIndex!]
                        decision.status => interpolationUnaryStatusByNode![nestedUnaryIndex!]
                    }
                nestedUnaryIndex! - 1 => nestedUnaryIndex!
            }
    }

    # Unary operands become typed after the initial owner-first index pass.
    # Commit a proven mismatch here without overriding an owner diagnostic.
    prepared.interpolationRanges -> each interpolationRange {
        interpolationRange.nodeStart => indexedUnaryNodeIndex!
        indexedUnaryNodeIndex! < interpolationRange.nodeStart + interpolationRange.nodeCount
            -> while {
                prepared.interpolations[indexedUnaryNodeIndex!] => indexed
                indexed.kind == 7 and indexed.operand0 >= 0 and indexed.operand1 >= 0
                    and indexed.operand1 < (prepared.interpolations -> len)
                    and prepared.interpolations[indexed.operand1].kind == 2
                    and interpolationUnaryStatusByNode![indexed.operand1] == 0
                    and interpolationUnsupportedIndexOwnerTypeByNode![indexedUnaryNodeIndex!] < 0
                    and interpolationIndexExpectedTypeByNode![indexedUnaryNodeIndex!] < 0
                    -> if {
                        prepared -> preIrInterpolationReceiverTypeId(types!, references!, referenceIndexByTypeAst!, interpolationLexicalTypeByNode!, interpolationMemberTypeByNode!, interpolationIndexedTypeByNode!, interpolationContextualStructTypeByNode!, interpolationCallTypeByNode!, interpolationRange.sourceModule, indexed.operand0) => ownerTypeId!
                        ownerTypeId! >= 0 and ownerTypeId! < (types! -> len)
                            -> if {
                                types! -> typeIds.materializedReadTypeId(ownerTypeId!) => ownerTypeId!
                                types![ownerTypeId!] => ownerType
                                -1 => expectedTypeId!
                                ownerType.kind == 2 or ownerType.kind == 3 or ownerType.kind == 4 or ownerType.kind == 12
                                    -> if { types! -> typeIds.builtinTypeId(2) => expectedTypeId! }
                                ownerType.kind == 5 or ownerType.kind == 13
                                    -> if { ownerType.first => expectedTypeId! }
                                ownerType.kind == 1 and ownerType.origin == 1
                                    and (ownerType.symbol == 16 or ownerType.symbol == 17 or ownerType.symbol == 18)
                                    -> if { types! -> typeIds.builtinTypeId(13) => expectedTypeId! }
                                expectedTypeId! >= 0 and interpolationUnaryTypeByNode![indexed.operand1] >= 0
                                    and interpolationUnaryTypeByNode![indexed.operand1] != expectedTypeId!
                                    -> if { expectedTypeId! => interpolationIndexExpectedTypeByNode![indexedUnaryNodeIndex!] }
                            }
                    }
                indexedUnaryNodeIndex! + 1 => indexedUnaryNodeIndex!
            }
    }

    prepared.package -> indexContextualRecordLabels(types!, expressions!) => contextualRecordLabelByAst
    prepared -> indexActiveDeclarationBodies(interpolationMethodByNode!) => activeDeclarationBodyByAst
    [ExpressionTypeId; ~] => externalCallResults!
    externalResults -> each value { externalCallResults! -> push(value) }

    ExpressionTypeIdSet {
        types: types!
        references: references!
        fields: fields!
        expressions: expressions!
        externalCallResults: externalCallResults!
        callArguments: [ResolvedCallArgument; ~]
        enumConstructorArguments: interpolationEnumConstructorArguments!
        enumConstructorIndexByAst: [Int; ~]
        enumConstructorIndexByInterpolationNode: interpolationEnumConstructorIndex!
        referenceIndexByTypeAst: referenceIndexByTypeAst!
        lexicalBindingTypeBySymbol: lexicalBindingTypeBySymbol!
        mutableBindingOwners: mutableBindingOwners
        contextualRecordLabelByAst: contextualRecordLabelByAst
        directEachRoleTypeBySymbol: directEachRoleTypeBySymbol!
        streamRoleTypeBySymbol: streamRoleTypeBySymbol!
        interpolationArrayByNode: interpolationArrayByNode!
        interpolationCallTypeByNode: interpolationCallTypeByNode!
        interpolationCallSourceByNode: interpolationCallSourceByNode!
        interpolationCallSymbolByNode: interpolationCallSymbolByNode!
        interpolationMethodByNode: interpolationMethodByNode!
        interpolationCallArguments: interpolationCallArguments!
        interpolationLexicalTypeByNode: interpolationLexicalTypeByNode!
        interpolationMemberTypeByNode: interpolationMemberTypeByNode!
        interpolationIndexedTypeByNode: interpolationIndexedTypeByNode!
        interpolationContextualStructTypeByNode: interpolationContextualStructTypeByNode!
        interpolationContextualFieldByNode: interpolationContextualFieldByNode!
        interpolationContextualDiagnosticByNode: interpolationContextualDiagnosticByNode!
        interpolationIndexExpectedTypeByNode: interpolationIndexExpectedTypeByNode!
        interpolationUnsupportedIndexOwnerTypeByNode: interpolationUnsupportedIndexOwnerTypeByNode!
        interpolationOwnedIndexElementTypeByNode: interpolationOwnedIndexElementTypeByNode!
        interpolationOwnedIndexContainerByNode: interpolationOwnedIndexContainerByNode!
        interpolationUnaryTypeByNode: interpolationUnaryTypeByNode!
        interpolationUnaryStatusByNode: interpolationUnaryStatusByNode!
        activeDeclarationBodyByAst: activeDeclarationBodyByAst
    } => result
    result
}

# Commit contextual numeric syntax to the same expression arena read by IR.
# Explicit conversions keep their independently resolved type.
replaceCallExpression expressions: mut [ExpressionTypeId; ~], index: Int, expression: ExpressionTypeId -> Unit {
    expression => expressions[index]
}

replaceCallArgument arguments: mut [ResolvedCallArgument; ~], index: Int, argument: ResolvedCallArgument -> Unit {
    argument => arguments[index]
}

contextualizeNumericCallArgument prepared: ref semanticContext.SemanticSnapshot, resolved: mut ExpressionTypeIdSet, expressionByAst: mut [Int; ~], sourceModule: Int, argumentAst: Int, expectedTypeId: Int -> Bool {
    contextualizeNumericCallArgumentArena(prepared, resolved.types, resolved.expressions, expressionByAst, sourceModule, argumentAst, expectedTypeId)
}

contextualizeArrayCallArgument prepared: ref semanticContext.SemanticSnapshot, resolved: mut ExpressionTypeIdSet, expressionByAst: mut [Int; ~], index: ref ContextualRecordIndex, expectedByAst: mut [Int; ~], sourceModule: Int, argumentAst: Int, expectedTypeId: Int -> Bool {
    expectedTypeId < 0 or expectedTypeId >= (resolved.types -> len)
        -> if { false -> return }
    resolved.types[expectedTypeId] => expected
    expected.kind != 2 and expected.kind != 3 and expected.kind != 4 and expected.kind != 12
        -> if { false -> return }
    expected.first < 0 or expected.first >= (resolved.types -> len)
        -> if { false -> return }
    prepared.package.ranges[sourceModule] => range
    range.astStart + argumentAst => globalAst
    prepared.package.nodes[globalAst].kind != 37 -> if { false -> return }
    index.firstChild[globalAst] => child!
    child! >= 0 -> while {
        # Explicitly typed constructors retain their own element contract.
        prepared.package.nodes[child!].kind == 12 or prepared.package.nodes[child!].kind == 16
            -> if { false -> return }
        index.nextChild[child!] => child!
    }
    expressionByAst[globalAst] => expressionIndex
    expressionIndex < 0 -> if { false -> return }
    resolved.expressions[expressionIndex].typeId => actualType
    actualType < 0 -> if { false -> return }
    resolved.types[actualType] => actual
    actual.kind != 3 and actual.kind != 4 and actual.kind != 12
        -> if { false -> return }
    # An unannotated literal inherits the owning parameter's storage contract.
    # Array diagnostics retain the original count and reject extent mismatches.
    # A slice is a view and keeps the literal's own backing storage.
    expectedTypeId => contextual!
    expected.kind == 2 -> if {
        resolved.types -> internArrayLiteralType(actual.kind, expected.first, actual.length) => contextual!
    }
    resolveContextualRecordFieldValue(prepared.package, resolved.types, resolved.expressions, expressionByAst, index, sourceModule, globalAst, contextual!, expectedByAst)
}

contextualizeNumericCallArgumentArena prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], expressions: mut [ExpressionTypeId; ~], expressionByAst: mut [Int; ~], sourceModule: Int, argumentAst: Int, expectedTypeId: Int -> Bool {
    expectedTypeId < 0 or expectedTypeId >= (types -> len)
        -> if { false -> return }
    types[expectedTypeId] => expected
    not (expected.kind == 1 and expected.origin == 1
        and ((expected.symbol >= 2 and expected.symbol <= 14)
        or (expected.symbol >= 19 and expected.symbol <= 22)))
        -> if { false -> return }
    prepared.package.ranges[sourceModule] => range
    range.astStart + argumentAst => globalAst
    prepared.package.nodes[globalAst] => argument
    false => contextual!
    argument.kind == 14 -> if {
        prepared.package.sources[sourceModule] -> len => sourceLength
        prepared.package.sources[sourceModule] -> slice(UIntSize(0), sourceLength) => source
        source -> numericLiteralRange.literalUsesFloatingSyntax(argument.start, argument.start + argument.length) => floating
        not floating or expected.symbol >= 19 -> if { true => contextual! }
    }
    argument.kind == 22 -> if {
        0 => childAst!
        childAst! < range.astCount -> while {
            prepared.package.nodes[range.astStart + childAst!] => child
            child.parent == argumentAst and child.kind == 14
                -> if {
                    contextualizeNumericCallArgumentArena(prepared, types, expressions, expressionByAst, sourceModule, childAst!, expectedTypeId) => childContextual
                    childContextual -> if { true => contextual! }
                }
            childAst! + 1 => childAst!
        }
    }
    argument.kind == 10 -> if {
        false => foundBranch!
        true => allBranchesContextual!
        0 => controlAst!
        controlAst! < range.astCount -> while {
            prepared.package.nodes[range.astStart + controlAst!] => control
            control.parent == argumentAst and control.kind == 42
                -> if {
                    0 => branchAst!
                    branchAst! < range.astCount -> while {
                        prepared.package.nodes[range.astStart + branchAst!] => branch
                        branch.parent == controlAst! and branch.kind == 43
                            -> if {
                                true => foundBranch!
                                -1 => valueAst!
                                0 => valueSearch!
                                valueSearch! < range.astCount -> while {
                                    prepared.package.nodes[range.astStart + valueSearch!] => value
                                    value.parent == branchAst!
                                        and value.start + value.length == branch.start + branch.length
                                        -> if { valueSearch! => valueAst! }
                                    valueSearch! + 1 => valueSearch!
                                }
                                valueAst! < 0 -> if { false => allBranchesContextual! } else {
                                    contextualizeNumericCallArgumentArena(prepared, types, expressions, expressionByAst, sourceModule, valueAst!, expectedTypeId) => branchContextual
                                    not branchContextual -> if { false => allBranchesContextual! }
                                }
                            }
                        branchAst! + 1 => branchAst!
                    }
                }
            controlAst! + 1 => controlAst!
        }
        foundBranch! and allBranchesContextual! -> if { true => contextual! }
    }
    (argument.kind == 20 or argument.kind == 21)
        and expected.symbol >= 2 and expected.symbol <= 14
        -> if {
            -1 => leftAst!
            -1 => rightAst!
            0 => childAst!
            childAst! < range.astCount -> while {
                prepared.package.nodes[range.astStart + childAst!].parent == argumentAst
                    -> if {
                        leftAst! < 0 -> if { childAst! => leftAst! } else { childAst! => rightAst! }
                    }
                childAst! + 1 => childAst!
            }
            leftAst! >= 0 and rightAst! >= 0 -> if {
                contextualizeNumericCallArgumentArena(prepared, types, expressions, expressionByAst, sourceModule, leftAst!, expectedTypeId) => leftContextual
                contextualizeNumericCallArgumentArena(prepared, types, expressions, expressionByAst, sourceModule, rightAst!, expectedTypeId) => rightContextual
                expressionByAst[range.astStart + leftAst!] => leftIndex
                expressionByAst[range.astStart + rightAst!] => rightIndex
                leftIndex >= 0 and rightIndex >= 0 -> if {
                    types -> typeIds.materializedReadTypeId(expressions[leftIndex].typeId) => leftType
                    types -> typeIds.materializedReadTypeId(expressions[rightIndex].typeId) => rightType
                    leftType == expectedTypeId and rightType == expectedTypeId
                        -> if { true => contextual! }
                }
            }
        }
    contextual! -> if {
        expressionByAst[globalAst] => expressionIndex
        expressionIndex >= 0 -> if {
            expressions[expressionIndex] => expression!
            expectedTypeId => expression!.typeId
            0 => expression!.status
            expressions -> replaceCallExpression(expressionIndex, expression!)
        } else {
            expressions -> len => nextIndex
            expressions -> push(ExpressionTypeId {
                sourceModule: sourceModule
                astNode: argumentAst
                typeId: expectedTypeId
                status: 0
            })
            nextIndex => expressionByAst[globalAst]
        }
    }
    contextual!
}

callParameterType prepared: ref semanticContext.SemanticSnapshot, resolved: ref ExpressionTypeIdSet, binding: ref semanticContext.CallArgumentBinding -> Int {
    prepared.package -> typeIds.functionParameterTypeId(resolved.references, resolved.referenceIndexByTypeAst, binding.targetSourceModule, binding.parameterSymbol)
}

# Resolve arguments once from semantic call identities. The concrete facts are
# shared by contextual typing, warnings, mismatch diagnostics and lowering.
# Preserve the last valid type annotation selected by each flow call.
# Source-local AST order and the existing parent predicate remain authoritative.
indexExplicitFlowTypeByCallAst prepared: ref semanticContext.SemanticSnapshot, references: ref [typeIds.TypeReference; ~], referenceIndexByTypeAst: ref [Int; ~] -> [Int; ~] {
    [Int; ~] => explicitTypeByCallAst!
    prepared.package.nodes -> each node { explicitTypeByCallAst! -> push(-1) }
    prepared.package.ranges -> each range {
        0 => astIndex!
        astIndex! < range.astCount -> while {
            prepared.package.nodes[range.astStart + astIndex!] => typeNode
            typeNode.kind == 12 and typeNode.parent >= 0 -> if {
                prepared.package.nodes[range.astStart + typeNode.parent] => parent
                -1 => callAst!
                parent.kind == 10 -> if {
                    typeNode.parent => callAst!
                } else {
                    (parent.kind == 11 or parent.kind == 77)
                        and parent.parent >= 0 and parent.parent < range.astCount
                        -> if {
                            prepared.package.nodes[range.astStart + parent.parent] => call
                            call.kind == 10 and parent.start > call.start
                                -> if { parent.parent => callAst! }
                        }
                }
                callAst! >= 0 -> if {
                    referenceIndexByTypeAst[range.astStart + astIndex!] => typeReference
                    typeReference >= 0 and references[typeReference].status == 0
                        -> if {
                            references[typeReference].typeId => explicitTypeByCallAst![range.astStart + callAst!]
                        }
                }
            }
            astIndex! + 1 => astIndex!
        }
    }
    explicitTypeByCallAst!
}

seedResolvedExplicitFlowGenericArguments prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], firstBinding: ref semanticContext.CallArgumentBinding, explicitType: Int, templates: mut [Int; ~], actuals: mut [Int; ~] -> Unit {
    explicitType >= 0 -> if {
        prepared.package.ranges[firstBinding.targetSourceModule] => targetRange
        -1 => firstParameter!
        0 => typeIndex!
        typeIndex! < (types -> len) -> while {
            types[typeIndex!] => type
            type.kind == 1 and type.origin == 3
                and type.module == firstBinding.targetSourceModule
                and type.symbol >= 0 and type.symbol < targetRange.symbolCount
                -> if {
                    prepared.package.symbols[targetRange.symbolStart + type.symbol] => parameter
                    parameter.parent == firstBinding.functionSymbol
                        -> if {
                            firstParameter! < 0 -> if { typeIndex! => firstParameter! } else {
                                prepared.package.symbols[targetRange.symbolStart + types[firstParameter!].symbol] => previous
                                prepared.package.nodes[targetRange.astStart + parameter.astNode].start < prepared.package.nodes[targetRange.astStart + previous.astNode].start
                                    -> if { typeIndex! => firstParameter! }
                            }
                        }
                }
            typeIndex! + 1 => typeIndex!
        }
        firstParameter! >= 0 -> if {
            templates -> push(firstParameter!)
            actuals -> push(explicitType)
        }
    }
}

seedExplicitFlowGenericArguments prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], references: ref [typeIds.TypeReference; ~], referenceIndexByTypeAst: ref [Int; ~], firstBinding: ref semanticContext.CallArgumentBinding, templates: mut [Int; ~], actuals: mut [Int; ~] -> Unit {
    prepared.package.ranges[firstBinding.sourceModule] => firstRange
    prepared.package.nodes[firstRange.astStart + firstBinding.callAst] => firstCall
    firstCall.kind == 10 -> if {
        -1 => explicitType!
        0 => explicitAst!
        explicitAst! < firstRange.astCount -> while {
            prepared.package.nodes[firstRange.astStart + explicitAst!] => typeNode
            typeNode.kind == 12 and typeNode.parent >= 0 -> if {
                prepared.package.nodes[firstRange.astStart + typeNode.parent] => parent
                typeNode.parent == firstBinding.callAst
                    or (parent.parent == firstBinding.callAst
                    and parent.start > firstCall.start
                    and (parent.kind == 11 or parent.kind == 77))
                    -> if {
                        referenceIndexByTypeAst[firstRange.astStart + explicitAst!] => typeReference
                        typeReference >= 0 and references[typeReference].status == 0
                            -> if {
                                references[typeReference].typeId => explicitType!
                            }
                    }
            }
            explicitAst! + 1 => explicitAst!
        }
        seedResolvedExplicitFlowGenericArguments(prepared, types, firstBinding, explicitType!, templates, actuals)
    }
}

seedIndexedExplicitFlowGenericArguments prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], firstBinding: ref semanticContext.CallArgumentBinding, explicitTypeByCallAst: ref [Int; ~], templates: mut [Int; ~], actuals: mut [Int; ~] -> Unit {
    prepared.package.ranges[firstBinding.sourceModule] => range
    prepared.package.nodes[range.astStart + firstBinding.callAst].kind == 10
        -> if {
            explicitTypeByCallAst[range.astStart + firstBinding.callAst] => explicitType
            seedResolvedExplicitFlowGenericArguments(prepared, types, firstBinding, explicitType, templates, actuals)
        }
}

resolveSemanticCallArguments prepared: ref semanticContext.SemanticSnapshot, resolved: mut ExpressionTypeIdSet -> Unit {
    prepared.package -> semanticContext.resolveCallArgumentBindings(prepared.calls) => bindings
    resolveSemanticCallArgumentBindings(prepared, resolved, bindings)
}

resolveSemanticCallArgumentBindings prepared: ref semanticContext.SemanticSnapshot, resolved: mut ExpressionTypeIdSet, bindings: ref [semanticContext.CallArgumentBinding; ~] -> Unit {
    emptyCallContextSeeds() => seeds
    resolveSemanticCallArgumentBindingsSeeded(prepared, resolved, bindings, seeds)
}

resolveSemanticCallArgumentBindingsSeeded prepared: ref semanticContext.SemanticSnapshot, resolved: mut ExpressionTypeIdSet, bindings: ref [semanticContext.CallArgumentBinding; ~], seeds: ref CallContextSeeds -> Unit {
    seeds.arguments -> each argument { resolved.callArguments -> push(argument) }
    prepared.package -> indexContextualRecords => contextualIndex
    [Int; ~] => expectedContextByAst!
    prepared.package.nodes -> each node { expectedContextByAst! -> push(-1) }
    prepared -> indexExplicitFlowTypeByCallAst(resolved.references, resolved.referenceIndexByTypeAst) => explicitTypeByCallAst
    [Int; ~] => expressionByAst!
    prepared.package.nodes -> each node { expressionByAst! -> push(-1) }
    0 => expressionIndex!
    expressionIndex! < (resolved.expressions -> len)
        -> while {
            resolved.expressions[expressionIndex!] => expression
            prepared.package.ranges[expression.sourceModule] => range
            expressionIndex! => expressionByAst![range.astStart + expression.astNode]
            expressionIndex! + 1 => expressionIndex!
        }
    0 => bindingIndex!
    bindingIndex! < (bindings -> len) -> while {
        bindings[bindingIndex!] => firstBinding
        prepared.package.ranges[firstBinding.sourceModule] => firstRange
        prepared.package.nodes[firstRange.astStart + firstBinding.callAst] => firstCall
        bindingIndex! + 1 => callEnd!
        callEnd! < (bindings -> len) -> while {
            bindings[callEnd!] => nextBinding
            nextBinding.sourceModule != firstBinding.sourceModule
                or nextBinding.callAst != firstBinding.callAst
                -> if { break }
            callEnd! + 1 => callEnd!
        }
        seeds.ownerBySource -> seededSource(firstBinding.sourceModule)
            -> if {
                callEnd! => bindingIndex!
                continue
            }
        # Each call owns one inference environment through all of its arguments.
        [Int; ~] => templates!
        [Int; ~] => actuals!
        [Int; ~] => factIndexes!
        false => genericCall!
        prepared.package.ranges[firstBinding.targetSourceModule] => declarationRange
        0 => genericSymbol!
        genericSymbol! < declarationRange.symbolCount
            -> while {
                prepared.package.symbols[declarationRange.symbolStart + genericSymbol!] => symbol
                symbol.kind == 32 and symbol.parent == firstBinding.functionSymbol
                    -> if { true => genericCall! }
                genericSymbol! + 1 => genericSymbol!
            }
        seedIndexedExplicitFlowGenericArguments(prepared, resolved.types, firstBinding, explicitTypeByCallAst, templates!, actuals!)
        bindingIndex! < callEnd! -> while {
            bindings[bindingIndex!] => binding
            prepared.package.ranges[binding.sourceModule] => sourceRange
            prepared.package.nodes[sourceRange.astStart + binding.callAst] => callNode
            callParameterType(prepared, resolved, binding) => templateType
            -1 => expectedType!
            -1 => actualType!
            1 => status!
            -1 => genericParameter!
            -1 => firstGenericActual!
            -1 => genericActual!
            -1 => mismatchExpected!
            -1 => mismatchActual!
            false => contextualInput!
            templateType >= 0 and templateType < (resolved.types -> len)
                -> if {
                    not resolved.types[templateType].containsParameter
                        -> if {
                            templateType => expectedType!
                        } else {
                            resolved.types -> typeIds.specializeManyInto(templates!, actuals!, templateType) => priorSpecialization
                            priorSpecialization.status == 0 and priorSpecialization.root >= 0
                                and not resolved.types[priorSpecialization.root].containsParameter
                                -> if {
                                    priorSpecialization.root => expectedType!
                                }
                        }
                    # Generic direct calls infer uncontextualized actual arguments first.
                    # Flow calls contextualize additional arguments after earlier bindings.
                    not genericCall! or (callNode.kind == 10 and binding.parameterOrdinal > 0)
                        or (callNode.kind == 10 and not resolved.types[templateType].containsParameter)
                        -> if {
                            callNode.kind != 10 or binding.parameterOrdinal > 0
                                or prepared.package.nodes[sourceRange.astStart + binding.argumentAst].kind == 14
                                or prepared.package.nodes[sourceRange.astStart + binding.argumentAst].kind == 22
                                or prepared.package.nodes[sourceRange.astStart + binding.argumentAst].kind == 37
                                -> if {
                                    expectedType! >= 0 and not resolved.types[expectedType!].containsParameter
                                        -> if { true => contextualInput! }
                                    contextualizeNumericCallArgument(prepared, resolved, expressionByAst!, binding.sourceModule, binding.argumentAst, expectedType!) => contextual
                                    contextualizeArrayCallArgument(prepared, resolved, expressionByAst!, contextualIndex, expectedContextByAst!, binding.sourceModule, binding.argumentAst, expectedType!) => contextualArray
                                }
                        }
                    expressionByAst![sourceRange.astStart + binding.argumentAst] => argumentIndex
                    argumentIndex >= 0 -> if {
                        resolved.expressions[argumentIndex] => argument
                        argument.status == 0 and argument.typeId >= 0
                            and argument.typeId < (resolved.types -> len)
                            and not resolved.types[argument.typeId].containsParameter
                            -> if { argument.typeId => actualType! }
                    }
                    actualType! >= 0 -> if {
                        resolved.types[templateType].containsParameter
                            -> if {
                                templates! -> push(templateType)
                                actuals! -> push(actualType!)
                                resolved.types -> typeIds.specializeManyInto(templates!, actuals!, templateType) => specialization
                                specialization.status == 0 and specialization.root >= 0
                                    and not resolved.types[specialization.root].containsParameter
                                    -> if {
                                        specialization.root => expectedType!
                                        0 => status!
                                    } else {
                                        specialization.status == 2 -> if {
                                            templateType => expectedType!
                                            3 => status!
                                            specialization.mismatchExpectedTypeId => mismatchExpected!
                                            specialization.mismatchActualTypeId => mismatchActual!
                                        }
                                        # The specialization owner preserves the first
                                        # exact conflict through composite formal types.
                                        prepared.package.ranges[binding.targetSourceModule] => targetRange
                                        specialization.conflictParameterModule == binding.targetSourceModule
                                            and specialization.conflictParameterSymbol >= 0
                                            and specialization.conflictParameterSymbol < targetRange.symbolCount
                                            and specialization.conflictFirstActualTypeId >= 0
                                            and specialization.conflictFirstActualTypeId < (resolved.types -> len)
                                            and specialization.conflictActualTypeId >= 0
                                            and specialization.conflictActualTypeId < (resolved.types -> len)
                                            -> if {
                                                prepared.package.symbols[targetRange.symbolStart + specialization.conflictParameterSymbol] => conflictParameter
                                                conflictParameter.kind == 32 and conflictParameter.parent == binding.functionSymbol
                                                    -> if {
                                                        specialization.conflictParameterSymbol => genericParameter!
                                                        specialization.conflictFirstActualTypeId => firstGenericActual!
                                                        specialization.conflictActualTypeId => genericActual!
                                                        2 => status!
                                                    }
                                            }
                                    }
                            } else { 0 => status! }
                    }
                }
            resolved.callArguments -> len => factIndex
            resolved.callArguments -> push(ResolvedCallArgument {
                sourceModule: binding.sourceModule
                callAst: binding.callAst
                argumentAst: binding.argumentAst
                targetSourceModule: binding.targetSourceModule
                functionSymbol: binding.functionSymbol
                parameterSymbol: binding.parameterSymbol
                parameterOrdinal: binding.parameterOrdinal
                expectedTypeId: expectedType!
                actualTypeId: actualType!
                status: status!
                suppressNumericWarning: callNode.kind == 10 and binding.parameterOrdinal == 0
                contextualInput: contextualInput!
                genericParameterSymbol: genericParameter!
                genericFirstActualTypeId: firstGenericActual!
                genericActualTypeId: genericActual!
                mismatchExpectedTypeId: mismatchExpected!
                mismatchActualTypeId: mismatchActual!
            })
            factIndexes! -> push(factIndex)
            # The last source argument completes generic-direct inference. Revalidate
            # every formal using the final environment, matching InferUserCallExpression.
            bindingIndex! + 1 == callEnd! => lastArgument
            lastArgument -> if {
                factIndexes! -> each priorIndex {
                    resolved.callArguments[priorIndex] => fact!
                    fact!.status != 2 and fact!.status != 3 -> if {
                        bindings[bindingIndex! - (factIndexes! -> len) + 1 + priorIndex - factIndexes![0]] => priorBinding
                        callParameterType(prepared, resolved, priorBinding) => priorTemplate
                        priorTemplate >= 0 and resolved.types[priorTemplate].containsParameter
                            -> if {
                                resolved.types -> typeIds.specializeManyInto(templates!, actuals!, priorTemplate) => finalSpecialization
                                finalSpecialization.status == 0 and finalSpecialization.root >= 0
                                    and not resolved.types[finalSpecialization.root].containsParameter
                                    -> if {
                                        finalSpecialization.root => fact!.expectedTypeId
                                        fact!.actualTypeId >= 0 -> if { 0 => fact!.status }
                                        callNode.kind != 10 -> if {
                                            contextualizeNumericCallArgument(prepared, resolved, expressionByAst!, fact!.sourceModule, fact!.argumentAst, fact!.expectedTypeId) => contextual
                                            contextual -> if { fact!.expectedTypeId => fact!.actualTypeId }
                                            contextualizeArrayCallArgument(prepared, resolved, expressionByAst!, contextualIndex, expectedContextByAst!, fact!.sourceModule, fact!.argumentAst, fact!.expectedTypeId) => contextualArray
                                            contextualArray -> if {
                                                prepared.package.ranges[fact!.sourceModule] => argumentRange
                                                expressionByAst![argumentRange.astStart + fact!.argumentAst] => argumentExpression
                                                resolved.expressions[argumentExpression].typeId => fact!.actualTypeId
                                            }
                                        }
                                        resolved.callArguments -> replaceCallArgument(priorIndex, fact!)
                                    }
                            }
                    }
                }
            }
            bindingIndex! + 1 => bindingIndex!
        }
    }
}

# Both readonly snapshots and owning call refresh commit the same argument facts.
# Completion borrows the snapshot and only mutates the newly resolved type set.
completeCallAndEnumFacts prepared: ref semanticContext.SemanticSnapshot, resolved: mut ExpressionTypeIdSet -> Unit {
    resolveSemanticCallArguments(prepared, resolved)
    resolveEnumConstructorArguments(prepared, resolved)
}

public resolveContext prepared: semanticContext.SemanticSnapshot -> ExpressionTypeIdSet {
    prepared -> resolveContextCore => resolved!
    completeCallAndEnumFacts(prepared, resolved!)
    resolved!
}

# Final typed targets already supplied the raw binding table used by move indexes.
# Keep final core, contextual/generic call facts and enum facts in the same order.
resolveContextWithCallArgumentBindings prepared: semanticContext.SemanticSnapshot, bindings: ref [semanticContext.CallArgumentBinding; ~], seeds: ref CallContextSeeds, externalResults: ref [ExpressionTypeId; ~] -> ExpressionTypeIdSet {
    prepared -> resolveContextCoreSeeded(seeds, externalResults) => resolved!
    resolveSemanticCallArgumentBindingsSeeded(prepared, resolved!, bindings, seeds)
    resolveEnumConstructorArguments(prepared, resolved!)
    resolved!
}

# This verifies table boundaries, not generation provenance. Callers must first
# approve compiler/target/config/declarations/modules and rebind all type roots.
validCallContextSeeds prepared: ref semanticContext.SemanticSnapshot, seeds: ref CallContextSeeds -> Bool {
    (seeds.ownerBySource -> len) == 0 -> if {
        (seeds.bindingTypeBySymbol -> len) == 0 and (seeds.values -> len) == 0
            and (seeds.calls -> len) == 0 and (seeds.arguments -> len) == 0 => empty
        empty -> return
    }
    (seeds.ownerBySource -> len) != (prepared.package.ranges -> len)
        or (seeds.bindingTypeBySymbol -> len) != (prepared.package.symbols -> len)
        -> if { false -> return }
    0..<Int(prepared.package.ranges -> len) -> each source {
        prepared.package.ranges[source] => range
        0..<range.symbolCount -> each symbol {
            seeds.bindingTypeBySymbol[range.symbolStart + symbol] => typeId
            typeId < -1 or typeId >= (prepared.semantic.types -> len)
                or (typeId >= 0 and not seeds.ownerBySource[source])
                -> if { false -> return }
        }
    }
    [Bool; ~] => seenValue!
    [Bool; ~] => seenCall!
    prepared.package.nodes -> each node {
        seenValue! -> push(false)
        seenCall! -> push(false)
    }
    seeds.values -> each value {
        not (seeds.ownerBySource -> seededSource(value.sourceModule))
            or value.status != 0 or value.typeId < 0 or value.typeId >= (prepared.semantic.types -> len)
            -> if { false -> return }
        prepared.package.ranges[value.sourceModule] => range
        value.astNode < 0 or value.astNode >= range.astCount
            -> if { false -> return }
        range.astStart + value.astNode => globalAst
        seenValue![globalAst] -> if { false -> return }
        true => seenValue![globalAst]
    }
    seeds.calls -> each call {
        not (seeds.ownerBySource -> seededSource(call.sourceModule))
            -> if { false -> return }
        prepared.package.ranges[call.sourceModule] => range
        call.callAst < 0 or call.callAst >= range.astCount
            -> if { false -> return }
        range.astStart + call.callAst => globalAst
        seenCall![globalAst] -> if { false -> return }
        true => seenCall![globalAst]
        call.functionSymbol >= 0 -> if {
            call.targetSourceModule < 0 or call.targetSourceModule >= (prepared.package.ranges -> len)
                -> if { false -> return }
            call.functionSymbol >= prepared.package.ranges[call.targetSourceModule].symbolCount
                -> if { false -> return }
        }
    }
    seeds.arguments -> each argument {
        not (seeds.ownerBySource -> seededSource(argument.sourceModule))
            -> if { false -> return }
        prepared.package.ranges[argument.sourceModule] => range
        argument.callAst < 0 or argument.callAst >= range.astCount
            or argument.argumentAst < -1 or argument.argumentAst >= range.astCount
            or argument.parameterOrdinal < -1 -> if { false -> return }
        not seenCall![range.astStart + argument.callAst]
            -> if { false -> return }
        argument.expectedTypeId < -1 or argument.expectedTypeId >= (prepared.semantic.types -> len)
            or argument.actualTypeId < -1 or argument.actualTypeId >= (prepared.semantic.types -> len)
            -> if { false -> return }
    }
    true
}

public resolveCallContextSeeded initialPrepared: move semanticContext.SemanticSnapshot, seeds: ref CallContextSeeds -> Result<ResolvedCallContext, Int> {
    [ExpressionTypeId; ~] => externalResults
    initialPrepared -> resolveCallContextSeededWithExternalResults(seeds, externalResults)
}

public resolveCallContextSeededWithExternalResults initialPrepared: move semanticContext.SemanticSnapshot, seeds: ref CallContextSeeds, externalResults: ref [ExpressionTypeId; ~] -> Result<ResolvedCallContext, Int> {
    not (initialPrepared -> validCallContextSeeds(seeds))
        -> if { 1 -> Result<ResolvedCallContext, Int>.Err -> return }
    # Resolved cache entries replace only their own AST decisions. Current
    # frontend records for conversions/intrinsics without a named target remain
    # live; the owner codec intentionally stores declared/intrinsic targets only.
    [Bool; ~] => restoredCallByAst!
    initialPrepared.package.nodes -> each node { restoredCallByAst! -> push(false) }
    seeds.calls -> each call {
        true => restoredCallByAst![initialPrepared.package.ranges[call.sourceModule].astStart + call.callAst]
    }
    [calls.ModuleCallResolution; ~] => committedCalls!
    initialPrepared.calls -> each call {
        not restoredCallByAst![initialPrepared.package.ranges[call.sourceModule].astStart + call.callAst]
            -> if { committedCalls! -> push(call) }
    }
    seeds.calls -> each call { committedCalls! -> push(call) }
    initialPrepared => prepared!
    committedCalls! => prepared!.calls
    prepared!.package -> semanticContext.indexCallsByAst(prepared!.calls) => prepared!.callIndexByAst
    prepared!.package -> semanticContext.indexCallResultMembersByAst(prepared!.calls) => prepared!.callResultMemberByAst
    prepared!.package -> semanticContext.resolveCallArgumentBindings(prepared!.calls) => initialBindings
    prepared!.package -> semanticContext.indexDeclaredMoveArgumentBindingsByAst(initialBindings) => prepared!.declaredMoveArgumentByAst
    prepared!.package -> semanticContext.indexDeclaredMoveReadsByAst(prepared!.declaredMoveArgumentByAst) => prepared!.declaredMoveReadByAst
    prepared! -> semanticContext.freeze => prepared
    prepared -> resolveContextCoreSeeded(seeds, externalResults) => initialTypes
    prepared -> completeResolvedCallContextSeeded(initialTypes, seeds, externalResults) -> Result<ResolvedCallContext, Int>.Ok
}

public resolveCallContext initialPrepared: move semanticContext.SemanticSnapshot -> ResolvedCallContext {
    initialPrepared -> resolveContextCore => initialTypes
    initialPrepared -> completeResolvedCallContext(initialTypes)
}

public resolveCallContextWithExternalResults initialPrepared: move semanticContext.SemanticSnapshot, externalResults: ref [ExpressionTypeId; ~] -> ResolvedCallContext {
    emptyCallContextSeeds() => seeds
    initialPrepared -> resolveContextCoreSeeded(seeds, externalResults) => initialTypes
    initialPrepared -> completeResolvedCallContextSeeded(initialTypes, seeds, externalResults)
}

completeResolvedCallContext initialPrepared: move semanticContext.SemanticSnapshot, initialTypes: move ExpressionTypeIdSet -> ResolvedCallContext {
    emptyCallContextSeeds() => seeds
    [ExpressionTypeId; ~] => externalResults
    initialPrepared -> completeResolvedCallContextSeeded(initialTypes, seeds, externalResults)
}

callContextDecisionsEqual left: ref [calls.ModuleCallResolution; ~], right: ref [calls.ModuleCallResolution; ~] -> Bool {
    (left -> len) != (right -> len) -> if { false -> return }
    0 => index!
    index! < (left -> len) -> while {
        left[index!] => previous
        right[index!] => current
        previous.sourceModule != current.sourceModule or previous.callAst != current.callAst
            or previous.origin != current.origin or previous.targetModule != current.targetModule
            or previous.targetSourceModule != current.targetSourceModule
            or previous.functionSymbol != current.functionSymbol or previous.status != current.status
            -> if { false -> return }
        index! + 1 => index!
    }
    true
}

completeResolvedCallContextSeeded initialPrepared: move semanticContext.SemanticSnapshot, initialTypes: move ExpressionTypeIdSet, seeds: ref CallContextSeeds, externalResults: ref [ExpressionTypeId; ~] -> ResolvedCallContext {
    initialPrepared -> refineResolvedCallContext(initialTypes, seeds, externalResults, false)
}

# Transfer each completed context into the next refinement. Owned analysis
# tables are bound once; no owner rebinding or name-check bypass is needed.
refineResolvedCallContext initialPrepared: move semanticContext.SemanticSnapshot, initialTypes: move ExpressionTypeIdSet, seeds: ref CallContextSeeds, externalResults: ref [ExpressionTypeId; ~], committedTypes: Bool -> ResolvedCallContext {
    initialPrepared.package -> semanticContext.indexFlowSourcesByAst => flowSources
    [Int; ~] => receiverTypeByCallAst!
    initialPrepared.package.nodes -> each node { receiverTypeByCallAst! -> push(-1) }
    initialTypes.expressions -> each expression {
        initialPrepared.package.ranges[expression.sourceModule] => range
        initialPrepared.package.nodes[range.astStart + expression.astNode] => node
        node.parent >= 0
            and node.parent < range.astCount
            and expression.status == 0
            and expression.typeId >= 0
            and expression.typeId < (initialTypes.types -> len)
            and not initialTypes.types[expression.typeId].containsParameter
            -> if {
                initialPrepared.package.nodes[range.astStart + node.parent] => call
                call.kind == 10 and flowSources[range.astStart + node.parent] == range.astStart + expression.astNode
                    -> if {
                        expression.typeId => receiverTypeByCallAst![range.astStart + node.parent]
                    }
            }
    }
    initialPrepared.package -> calls.resolveModulesTypedWithPreparedFacts(
    initialPrepared.semantic,
    receiverTypeByCallAst!,
    initialTypes.types,
    seeds.ownerBySource,
    initialPrepared.calls,
    initialPrepared.modules,
    initialPrepared.imports,
    initialPrepared.resolvedImports,
    initialPrepared.qualified
    ) => resolvedCalls
    not callContextDecisionsEqual(initialPrepared.calls, resolvedCalls) => decisionsChanged
    initialPrepared => prepared!
    resolvedCalls => prepared!.calls
    prepared!.package -> semanticContext.indexCallsByAst(prepared!.calls) => prepared!.callIndexByAst
    prepared!.package -> semanticContext.indexCallResultMembersByAst(prepared!.calls) => prepared!.callResultMemberByAst
    prepared!.package -> semanticContext.resolveCallArgumentBindings(prepared!.calls) => finalBindings
    prepared!.package -> semanticContext.indexDeclaredMoveArgumentBindingsByAst(finalBindings) => prepared!.declaredMoveArgumentByAst
    prepared!.package -> semanticContext.indexDeclaredMoveReadsByAst(prepared!.declaredMoveArgumentByAst) => prepared!.declaredMoveReadByAst
    prepared! -> semanticContext.freeze => finalPrepared
    finalPrepared -> resolveContextWithCallArgumentBindings(finalBindings, seeds, externalResults) => finalTypes
    committedTypes and not decisionsChanged -> if {
        ResolvedCallContext { prepared: finalPrepared, types: finalTypes } -> return
    }
    finalPrepared -> refineResolvedCallContext(finalTypes, seeds, externalResults, true)
}

# Measurement-only entry: exposes a completed pair, never initial type facts.
public profileResolveCallContext initialPrepared: move semanticContext.SemanticSnapshot -> Result<ProfiledCallContext, time.Error> uses Clock {
    time.monotonicClock() => clock
    clock -> now => profileStarted
    initialPrepared -> resolveContextCore => initialTypes
    clock -> now => profileInitialCompleted
    initialPrepared -> completeResolvedCallContext(initialTypes) => resolved
    clock -> now => profileCompleted
    profileInitialCompleted -> durationSince(profileStarted)? => initialDuration
    profileCompleted -> durationSince(profileInitialCompleted)? => completionDuration
    ProfiledCallContext {
        resolved: resolved
        initialCoreMilliseconds: initialDuration -> asMilliseconds
        completionMilliseconds: completionDuration -> asMilliseconds
    } -> Result<ProfiledCallContext, time.Error>.Ok
}

public resolvePrepared request: move ExpressionTypeIdRequest -> ExpressionTypeIdSet {
    [file.SourceText; ~] => sources!
    0 => sourceIndex!
    sourceIndex! < (request.sources -> len) -> while {
        request.sources[sourceIndex!] => source
        source -> file.borrowText => ownedSource
        sources! -> push(ownedSource)
        sourceIndex! + 1 => sourceIndex!
    }
    [typeIds.SemanticType; ~] => types!
    0 => semanticTypeCopyIndex599!
    semanticTypeCopyIndex599! < (request.types -> len)
        -> while {
            request.types[semanticTypeCopyIndex599!] => semanticType
            types! -> push(semanticType)
            semanticTypeCopyIndex599! + 1 => semanticTypeCopyIndex599!
        }
    [typeIds.TypeReference; ~] => references!
    0 => referenceCopyIndex601!
    referenceCopyIndex601! < (request.references -> len)
        -> while {
            request.references[referenceCopyIndex601!] => reference
            references! -> push(reference)
            referenceCopyIndex601! + 1 => referenceCopyIndex601!
        }
    [typeIds.NominalField; ~] => fields!
    0 => fieldCopyIndex603!
    fieldCopyIndex603! < (request.fields -> len)
        -> while {
            request.fields[fieldCopyIndex603!] => field
            fields! -> push(field)
            fieldCopyIndex603! + 1 => fieldCopyIndex603!
        }
    [modules.ModuleIdentity; ~] => moduleIdentities!
    0 => moduleIdentityCopyIndex605!
    moduleIdentityCopyIndex605! < (request.modules -> len)
        -> while {
            request.modules[moduleIdentityCopyIndex605!] => moduleIdentity
            moduleIdentities! -> push(moduleIdentity)
            moduleIdentityCopyIndex605! + 1 => moduleIdentityCopyIndex605!
        }
    [qualified.QualifiedResolution; ~] => qualifiedResults!
    0 => qualifiedResultCopyIndex607!
    qualifiedResultCopyIndex607! < (request.qualified -> len)
        -> while {
            request.qualified[qualifiedResultCopyIndex607!] => qualifiedResult
            qualifiedResults! -> push(qualifiedResult)
            qualifiedResultCopyIndex607! + 1 => qualifiedResultCopyIndex607!
        }
    [calls.ModuleCallResolution; ~] => moduleCalls!
    0 => moduleCallCopyIndex609!
    moduleCallCopyIndex609! < (request.calls -> len)
        -> while {
            request.calls[moduleCallCopyIndex609!] => moduleCall
            moduleCalls! -> push(moduleCall)
            moduleCallCopyIndex609! + 1 => moduleCallCopyIndex609!
        }
    [analysis.SourceAnalysisRange; ~] => ranges!
    0 => sourceRangeCopyIndex611!
    sourceRangeCopyIndex611! < (request.analysisRanges -> len)
        -> while {
            request.analysisRanges[sourceRangeCopyIndex611!] => sourceRange
            ranges! -> push(sourceRange)
            sourceRangeCopyIndex611! + 1 => sourceRangeCopyIndex611!
        }
    [ast.AstNode; ~] => nodes!
    0 => nodeCopyIndex613!
    nodeCopyIndex613! < (request.analysisNodes -> len)
        -> while {
            request.analysisNodes[nodeCopyIndex613!] => node
            nodes! -> push(node)
            nodeCopyIndex613! + 1 => nodeCopyIndex613!
        }
    [syntax.SyntaxToken; ~] => tokens!
    0 => tokenCopyIndex615!
    tokenCopyIndex615! < (request.analysisTokens -> len)
        -> while {
            request.analysisTokens[tokenCopyIndex615!] => token
            tokens! -> push(token)
            tokenCopyIndex615! + 1 => tokenCopyIndex615!
        }
    [symbols.Symbol; ~] => symbolTable!
    0 => symbolCopyIndex617!
    symbolCopyIndex617! < (request.analysisSymbols -> len)
        -> while {
            request.analysisSymbols[symbolCopyIndex617!] => symbol
            symbolTable! -> push(symbol)
            symbolCopyIndex617! + 1 => symbolCopyIndex617!
        }
    [resolution.ResolvedName; ~] => names!
    0 => nameCopyIndex619!
    nameCopyIndex619! < (request.analysisNames -> len)
        -> while {
            request.analysisNames[nameCopyIndex619!] => name
            names! -> push(name)
            nameCopyIndex619! + 1 => nameCopyIndex619!
        }
    [nominalTypes.NominalType; ~] => nominal
    [compositeTypes.CompositeType; ~] => composite
    [typeTerms.TypeTerm; ~] => terms
    [semanticTypes.TypeUse; ~] => typeUses
    typeIds.SemanticTypeSet { types: types!, references: references!, fields: fields! } => contextSemantic
    analysis.PackageAnalysis {
        sources: sources!
        entrySourceModule: -1
        interpolationRanges: [interpolation.InterpolationSourceRange; ~]
        interpolations: [interpolation.InterpolationNode; ~]
        ranges: ranges!
        nodes: nodes!
        tokens: tokens!
        symbols: symbolTable!
        names: names!
        terms: terms
        typeUses: typeUses
        constantLiterals: [constantLowering.Literal; ~]
        constantFailures: [constantLowering.Failure; ~]
    } -> analysis.completePackageInterpolations => contextPackage
    contextPackage -> typeIds.resolveAnalyzedSeeded(contextSemantic) => completedSemantic
    contextPackage -> semanticContext.indexQualifiedFunctionsByParentAst(moduleIdentities!, qualifiedResults!) => qualifiedFunctionByParentAst
    contextPackage -> semanticContext.indexCallsByAst(moduleCalls!) => callIndexByAst
    contextPackage -> semanticContext.indexCallResultMembersByAst(moduleCalls!) => callResultMemberByAst
    contextPackage -> semanticContext.indexControlProducerWrappersByAst => controlProducerWrapperByAst
    contextPackage -> semanticContext.indexDirectFlowTargetPathsByAst => directFlowTargetPathByAst
    contextPackage -> semanticContext.indexAwaitSourcesByAst => awaitSourceByAst
    contextPackage -> semanticContext.indexDeclaredMoveArgumentsByAst(moduleCalls!) => declaredMoveArgumentByAst
    contextPackage -> semanticContext.indexDeclaredMoveReadsByAst(declaredMoveArgumentByAst) => declaredMoveReadByAst
    [moduleResolve.ResolvedImport; ~] => emptyResolvedImports
    contextPackage -> semanticContext.lowerAnalyzedInterpolations(moduleIdentities!, emptyResolvedImports) => analyzedInterpolations
    semanticContext.SemanticSnapshot {
        standardLibrarySourceStart: 0
        standardLibrarySourceCount: 0
        semantic: completedSemantic
        package: contextPackage
        interpolationRanges: analyzedInterpolations.ranges
        interpolations: analyzedInterpolations.nodes
        nominal: nominal
        composite: composite
        modules: moduleIdentities!
        imports: [modules.ImportEdge; ~]
        resolvedImports: emptyResolvedImports
        qualified: qualifiedResults!
        qualifiedFunctionByParentAst: qualifiedFunctionByParentAst
        calls: moduleCalls!
        callIndexByAst: callIndexByAst
        callResultMemberByAst: callResultMemberByAst
        controlProducerWrapperByAst: controlProducerWrapperByAst
        directFlowTargetPathByAst: directFlowTargetPathByAst
        awaitSourceByAst: awaitSourceByAst
        declaredMoveArgumentByAst: declaredMoveArgumentByAst
        declaredMoveReadByAst: declaredMoveReadByAst
    } => prepared
    prepared -> semanticContext.freeze => snapshot
    snapshot -> resolveContext => result
    result
}

public resolve sources: [Text; ~] -> ExpressionTypeIdSet {
    sources -> semanticContext.prepare => prepared
    prepared -> resolveContext => result
    result
}

# This grammar identity is shared with lowering. It does not infer a constructor
# from a result type or from a same-named ordinary function.
public standardGenericEnumVariantToken source: Text, tokens: [syntax.SyntaxToken; ~], tokenStart: Int, node: ast.AstNode -> Int {
    -1 => variantToken!
    node.kind == 11 or node.kind == 55 => afterArrow!
    false => standardEnumName!
    0 => genericDepth!
    false => afterGeneric!
    false => afterDot!
    0 => parenDepth!
    0 => braceDepth!
    0 => bracketDepth!
    node.firstToken => tokenIndex!
    tokenIndex! < node.firstToken + node.tokenCount
        -> while {
            tokens[tokenStart + tokenIndex!] => token
            token.kind == grammar.tokenIdLeftParen() -> if { parenDepth! + 1 => parenDepth! }
            token.kind == grammar.tokenIdRightParen() and parenDepth! > 0
                -> if { parenDepth! - 1 => parenDepth! }
            token.kind == grammar.tokenIdLeftBrace() -> if { braceDepth! + 1 => braceDepth! }
            token.kind == grammar.tokenIdRightBrace() and braceDepth! > 0
                -> if { braceDepth! - 1 => braceDepth! }
            token.kind == grammar.tokenIdLeftBracket() -> if { bracketDepth! + 1 => bracketDepth! }
            token.kind == grammar.tokenIdRightBracket() and bracketDepth! > 0
                -> if { bracketDepth! - 1 => bracketDepth! }
            parenDepth! == 0 and braceDepth! == 0 and bracketDepth! == 0 and token.kind == grammar.tokenIdArrow()
                -> if {
                    # Only the current flow target can own this constructor.
                    -1 => variantToken!
                    true => afterArrow!
                    false => standardEnumName!
                    0 => genericDepth!
                    false => afterGeneric!
                    false => afterDot!
                } else {
                    afterArrow! and not standardEnumName! and parenDepth! == 0 and braceDepth! == 0 and bracketDepth! == 0 and token.kind == grammar.tokenIdIdentifier()
                        -> if {
                            (TextMatchRequest { source: source, start: token.span.start, length: token.span.length, expected: "Option" } -> textMatches)
                                or (TextMatchRequest { source: source, start: token.span.start, length: token.span.length, expected: "Result" } -> textMatches)
                                -> if { true => standardEnumName! } else { false => afterArrow! }
                        }
                    standardEnumName! -> if {
                        token.kind == grammar.tokenIdLess()
                            -> if { genericDepth! + 1 => genericDepth! }
                        token.kind == grammar.tokenIdGreater() and genericDepth! > 0
                            -> if {
                                genericDepth! - 1 => genericDepth!
                                genericDepth! == 0 -> if { true => afterGeneric! }
                            }
                        afterGeneric! and genericDepth! == 0 and parenDepth! == 0 and braceDepth! == 0 and bracketDepth! == 0 and token.kind == grammar.tokenIdDot()
                            -> if { true => afterDot! }
                        afterDot! and parenDepth! == 0 and braceDepth! == 0 and bracketDepth! == 0 and token.kind == grammar.tokenIdIdentifier()
                            -> if { tokenIndex! => variantToken! }
                    }
                }
            tokenIndex! + 1 => tokenIndex!
        }
    variantToken!
}

resolveEnumConstructorArguments prepared: ref semanticContext.SemanticSnapshot, resolved: mut ExpressionTypeIdSet -> Unit {
    prepared.package -> semanticContext.indexFlowSourcesByAst => flowSources
    [Int; ~] => typeByAst!
    [Int; ~] => constructorIndexByAst!
    [Text; ~] => sourceTexts!
    prepared.package.sources -> each source {
        source -> len => length
        sourceTexts! -> push(source -> slice(UIntSize(0), length))
    }
    prepared.package.nodes -> each node {
        constructorIndexByAst! -> push(-1)
        typeByAst! -> push(-1)
    }
    resolved.expressions -> each value {
        value.status == 0 and value.typeId >= 0 -> if {
            prepared.package.ranges[value.sourceModule] => valueRange
            value.typeId => typeByAst![valueRange.astStart + value.astNode]
        }
    }
    resolved.expressions -> each expression {
        expression.status == 0 and expression.typeId >= 0 and expression.typeId < (resolved.types -> len)
            -> if {
                prepared.package.ranges[expression.sourceModule] => range
                range.astStart + expression.astNode => globalCall
                prepared.package.nodes[globalCall] => node
                (node.kind == 11 or node.kind == 10 or node.kind == 55) and constructorIndexByAst![globalCall] < 0
                    and typeByAst![globalCall] == expression.typeId
                    -> if {
                        resolved.types[expression.typeId] => enumType
                        -1 => payloadType!
                        -1 => targetSource!
                        -1 => variantSymbol!
                        -1 => variantTag!
                        -1 => variantToken!
                        prepared.callIndexByAst[globalCall] => callIndex
                        node.kind == 11 and callIndex >= 0 -> if {
                            prepared.calls[callIndex] => call
                            call.status == 0 and call.targetSourceModule >= 0
                                and call.targetSourceModule < (prepared.package.ranges -> len)
                                -> if {
                                    prepared.package.ranges[call.targetSourceModule] => targetRange
                                    call.functionSymbol >= 0 and call.functionSymbol < targetRange.symbolCount
                                        -> if {
                                            prepared.package.symbols[targetRange.symbolStart + call.functionSymbol] => variant
                                            variant.kind == 27 and variant.parent >= 0
                                                and variant.typeNode >= 0 and variant.typeNode < targetRange.astCount
                                                and enumType.module == call.targetSourceModule and enumType.symbol == variant.parent
                                                -> if {
                                                    nominalEnumPayloadDecision(prepared, resolved.types, resolved.references, resolved.referenceIndexByTypeAst, call.targetSourceModule, call.functionSymbol) => payload
                                                    payload.typeId >= 0 and payload.enumTypeId == expression.typeId
                                                        -> if {
                                                            payload.typeId => payloadType!
                                                            call.targetSourceModule => targetSource!
                                                            call.functionSymbol => variantSymbol!
                                                            payload.tag => variantTag!
                                                        }
                                                }
                                        }
                                }
                        }
                        enumType.kind == 7 and enumType.origin == 4 and (enumType.symbol == 0 or enumType.symbol == 1)
                            -> if {
                                sourceTexts![expression.sourceModule] => source
                                source -> standardGenericEnumVariantToken(prepared.package.tokens, range.tokenStart, node) => variantToken!
                                variantToken! >= 0 -> if {
                                    prepared.package.tokens[range.tokenStart + variantToken!] => token
                                    source -> slice(token.span.start, token.span.length) => name
                                    enumType -> standardEnumPayloadDecision(name) => payload
                                    payload.typeId => payloadType!
                                    payload.tag => variantTag!
                                }
                            }
                        payloadType! >= 0 and payloadType! < (resolved.types -> len) and variantTag! >= 0
                            -> if {
                                # Only the source/call location is consumed by this argument API.
                                calls.ModuleCallResolution {
                                    sourceModule: expression.sourceModule
                                    callAst: expression.astNode
                                    origin: 0
                                    targetModule: targetSource!
                                    targetSourceModule: targetSource!
                                    functionSymbol: variantSymbol!
                                    status: 0
                                } => constructor
                                prepared.package -> semanticContext.callArgumentAsts(constructor, flowSources) => arguments
                                (arguments -> len) == 1 -> if {
                                    arguments[0] => argumentGlobal
                                    argumentGlobal - range.astStart => argumentAst
                                    # The constructor consumes the value read from a reference;
                                    # its original binding still supplies borrowing provenance.
                                    resolved.types -> typeIds.materializedReadTypeId(typeByAst![argumentGlobal]) => actualType
                                    resolved.enumConstructorArguments -> len => factIndex
                                    factIndex => constructorIndexByAst![globalCall]
                                    resolved.enumConstructorArguments -> push(ResolvedEnumConstructorArgument {
                                        memberStatus: 0
                                        sourceModule: expression.sourceModule
                                        callAst: expression.astNode
                                        argumentAst: argumentAst
                                        callNode: -1
                                        argumentNode: -1
                                        enumTypeId: expression.typeId
                                        targetSourceModule: targetSource!
                                        variantSymbol: variantSymbol!
                                        variantTag: variantTag!
                                        variantToken: variantToken!
                                        expectedTypeId: payloadType!
                                        actualTypeId: actualType
                                    })
                                }
                            }
                    }
            }
    }
    constructorIndexByAst! => resolved.enumConstructorIndexByAst
}
