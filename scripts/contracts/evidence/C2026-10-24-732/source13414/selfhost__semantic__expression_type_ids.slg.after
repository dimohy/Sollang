struct DeclarationActivationEdge {
    caller: Int
    target: Int
}

# Match lazy C# generic-body validation. Calls become activation edges, not
# roots: an unused generic cycle must remain inactive. Build this index once;
# diagnostic consumers borrow the completed facts without graph rescans.
indexActiveDeclarationBodies prepared: ref semanticContext.SemanticSnapshot, interpolationMethods: ref [InterpolationMethodDecision; ~] -> [Bool; ~] {
    [Int; ~] => ownerByAst!
    [Int; ~] => ownerByToken!
    [Int; ~] => firstEdge!
    [Bool; ~] => generic!
    [Bool; ~] => active!
    [Int; ~] => pending!
    [DeclarationActivationEdge; ~] => edges!
    prepared.package.nodes -> each node {
        ownerByAst! -> push(-1)
        firstEdge! -> push(-1)
        generic! -> push(false)
        active! -> push(false)
    }
    prepared.package.tokens -> each token { ownerByToken! -> push(-1) }
    prepared.package.ranges -> each range {
        0 => astIndex!
        astIndex! < range.astCount -> while {
            prepared.package.nodes[range.astStart + astIndex!] => node
            node.kind == 32 and node.parent >= 0
                -> if { true => generic![range.astStart + node.parent] }
            astIndex! + 1 => astIndex!
        }
        0 => astIndex!
        astIndex! < range.astCount -> while {
            range.astStart + astIndex! => globalAst
            prepared.package.nodes[globalAst] => node
            astIndex! => owner!
            owner! >= 0 -> while {
                prepared.package.nodes[range.astStart + owner!] => candidate
                candidate.kind == 7 or candidate.kind == 31 -> if { break }
                candidate.parent => owner!
            }
            owner! >= 0 -> if { range.astStart + owner! => ownerByAst![globalAst] }
            node.payloadToken >= 0 and node.payloadToken < range.tokenCount
                -> if { ownerByAst![globalAst] => ownerByToken![range.tokenStart + node.payloadToken] }
            (node.kind == 7 or node.kind == 31) and not generic![globalAst]
                -> if {
                    # Local bodies are validated with their enclosing body,
                    # even when never called. They are not independent roots.
                    node.parent => parent!
                    parent! >= 0 -> while {
                        prepared.package.nodes[range.astStart + parent!] => enclosing
                        enclosing.kind == 7 or enclosing.kind == 31 -> if { break }
                        enclosing.parent => parent!
                    }
                    parent! < 0 -> if {
                        true => active![globalAst]
                        pending! -> push(globalAst)
                    } else {
                        edges! -> push(DeclarationActivationEdge {
                            caller: range.astStart + parent!
                            target: globalAst
                        })
                    }
                }
            astIndex! + 1 => astIndex!
        }
    }
    prepared.calls -> each call {
        call.status == 0 and call.targetSourceModule >= 0 and call.functionSymbol >= 0
            -> if {
                prepared.package.ranges[call.sourceModule] => callerRange
                prepared.package.ranges[call.targetSourceModule] => targetRange
                prepared.package.symbols[targetRange.symbolStart + call.functionSymbol] => target
                edges! -> push(DeclarationActivationEdge {
                    caller: ownerByAst![callerRange.astStart + call.callAst]
                    target: targetRange.astStart + target.astNode
                })
            }
    }
    prepared.interpolationRanges -> each range {
        prepared.package.ranges[range.sourceModule] => sourceRange
        range.nodeStart => nodeIndex!
        nodeIndex! < range.nodeStart + range.nodeCount
            -> while {
                # Declaration identity precedes concrete result inference. A call
                # from a generic body can retain a type parameter at this stage.
                interpolationMethods[nodeIndex!] => method
                method.status >= 0 -> if {
                    InterpolationFunctionTarget { sourceModule: method.sourceModule, symbol: method.symbol }
                } else {
                    prepared -> interpolationFunctionTarget(range.sourceModule, nodeIndex!)
                } => declaration
                declaration.sourceModule >= 0 and declaration.symbol >= 0
                    -> if {
                        prepared.package.ranges[declaration.sourceModule] => targetRange
                        prepared.package.symbols[targetRange.symbolStart + declaration.symbol] => target
                        prepared.interpolations[nodeIndex!].sourceToken => sourceToken
                        edges! -> push(DeclarationActivationEdge {
                            caller: ownerByToken![sourceRange.tokenStart + sourceToken]
                            target: targetRange.astStart + target.astNode
                        })
                    }
                nodeIndex! + 1 => nodeIndex!
            }
    }
    [Int; ~] => nextEdge!
    0 => edgeIndex!
    edgeIndex! < (edges! -> len) -> while {
        edges![edgeIndex!] => edge
        edge.caller >= 0 -> if {
            nextEdge! -> push(firstEdge![edge.caller])
            edgeIndex! => firstEdge![edge.caller]
        } else {
            nextEdge! -> push(-1)
            not active![edge.target] -> if {
                true => active![edge.target]
                pending! -> push(edge.target)
            }
        }
        edgeIndex! + 1 => edgeIndex!
    }
    0 => pendingIndex!
    pendingIndex! < (pending! -> len) -> while {
        firstEdge![pending![pendingIndex!]] => edgeIndex!
        edgeIndex! >= 0 -> while {
            edges![edgeIndex!].target => target
            not active![target] -> if {
                true => active![target]
                pending! -> push(target)
            }
            nextEdge![edgeIndex!] => edgeIndex!
        }
        pendingIndex! + 1 => pendingIndex!
    }
    [Bool; ~] => result!
    ownerByAst! -> each owner {
        owner < 0 -> if { result! -> push(true) } else { result! -> push(active![owner]) }
    }
    result!
}

