                    argumentNodes! -> push(argumentIndex!)
                }
            argumentIndex! + 1 => argumentIndex!
        }
    (actualTypes! -> len) != (parameterTypes! -> len)
        -> if { -1 -> return }
    types[returnType].containsParameter => generic!
    parameterTypes! -> each parameterType {
        types[parameterType].containsParameter -> if { true => generic! }
    }
    returnType => resultType!
    generic! -> if {
        types -> typeIds.specializeManyInto(parameterTypes!, actualTypes!, returnType) => specialization
        specialization.status != 0 or specialization.root < 0 or types[specialization.root].containsParameter
            -> if { -1 -> return }
        specialization.root => resultType!
    }
    0 => ordinal!
    ordinal! < (parameterTypes! -> len) -> while {
        parameterTypes![ordinal!] => expectedType!
        generic! and types[expectedType!].containsParameter
            -> if {
