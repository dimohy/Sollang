public struct ExpressionTypeId {
    public sourceModule: Int
    public astNode: Int
    public typeId: Int
    public status: Int
}

public struct ResolvedCallArgument {
    public sourceModule: Int
    public callAst: Int
    public argumentAst: Int
    public targetSourceModule: Int
    public functionSymbol: Int
    public parameterSymbol: Int
    public parameterOrdinal: Int
    public expectedTypeId: Int
    public actualTypeId: Int
    # 0 resolved, 1 unresolved, 2 conflicting generic inference,
    # 3 a proven generic input shape mismatch.
    public status: Int
    public suppressNumericWarning: Bool
    # Expected input type was available before this argument was inferred.
    public contextualInput: Bool
    public genericParameterSymbol: Int
    public genericFirstActualTypeId: Int
    public genericActualTypeId: Int
    public mismatchExpectedTypeId: Int
    public mismatchActualTypeId: Int
}

public struct ResolvedInterpolationCallArgument {
    public sourceModule: Int
    public callNode: Int
    public argumentNode: Int
    public inputFromFlow: Bool
    public parameterSymbol: Int
    public parameterOrdinal: Int
    public targetSourceModule: Int
    public functionSymbol: Int
    public expectedTypeId: Int
    public actualTypeId: Int
}

# Constructor identity and its declared storage contract are semantic facts.
# Standard Option/Result variants use a tag; nominal variants retain their symbol.
public struct ResolvedEnumConstructorArgument {
    # Nullary generic member: 0 unrelated, 1 missing variant, 2 payload required, 3 value.
    public memberStatus: Int
    public sourceModule: Int
    public callAst: Int
    public argumentAst: Int
    # Exactly one location domain is present: ordinary AST or interpolation node.
    public callNode: Int
    public argumentNode: Int
    public enumTypeId: Int
    public targetSourceModule: Int
    public variantSymbol: Int
    public variantTag: Int
    public variantToken: Int
    public expectedTypeId: Int
    public actualTypeId: Int
}

struct StandardEnumPayloadDecision {
    typeId: Int
    tag: Int
}

standardEnumPayloadDecision enumType: typeIds.SemanticType, variantName: Text -> StandardEnumPayloadDecision {
    StandardEnumPayloadDecision { typeId: -1, tag: -1 } => result!
    enumType.kind == 7 and enumType.origin == 4 -> if {
        enumType.symbol == 0 and variantName == "Some"
            -> if {
                enumType.first => result!.typeId
                1 => result!.tag
            }
        enumType.symbol == 1 and variantName == "Ok" -> if {
            enumType.first => result!.typeId
            0 => result!.tag
        }
        enumType.symbol == 1 and variantName == "Err"
            -> if {
                enumType.second => result!.typeId
                1 => result!.tag
            }
    }
    result!
}

struct NominalEnumPayloadDecision {
    enumTypeId: Int
    typeId: Int
    tag: Int
    token: Int
}

nominalEnumPayloadDecision prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], references: ref [typeIds.TypeReference; ~], referenceIndexByTypeAst: ref [Int; ~], targetSource: Int, variantSymbol: Int -> NominalEnumPayloadDecision {
    NominalEnumPayloadDecision { enumTypeId: -1, typeId: -1, tag: -1, token: -1 } => result!
    targetSource < 0 or targetSource >= (prepared.package.ranges -> len)
        -> if { result! -> return }
    prepared.package.ranges[targetSource] => range
    variantSymbol < 0 or variantSymbol >= range.symbolCount
        -> if { result! -> return }
    prepared.package.symbols[range.symbolStart + variantSymbol] => variant
    variant.kind != 27 or variant.parent < 0 or variant.typeNode < 0 or variant.typeNode >= range.astCount
        -> if { result! -> return }
    prepared.package.symbols[range.symbolStart + variant.parent].kind != 4
        -> if { result! -> return }
    referenceIndexByTypeAst[range.astStart + variant.typeNode] => referenceIndex
    referenceIndex < 0 -> if { result! -> return }
    references[referenceIndex] => reference
    reference.status != 0 or reference.sourceModule != targetSource or reference.typeAst != variant.typeNode
        -> if { result! -> return }
    reference.typeId => result!.typeId
    variant.nameToken => result!.token
    0 => result!.tag
    0 => earlier!
    earlier! < variantSymbol -> while {
        prepared.package.symbols[range.symbolStart + earlier!] => sibling
        sibling.kind == 27 and sibling.parent == variant.parent
            -> if { result!.tag + 1 => result!.tag }
        earlier! + 1 => earlier!
    }
    types -> resolveNominalEnumOwnerType(targetSource, variant.parent, targetSource) => result!.enumTypeId
    result!
}

public struct InterpolationFunctionTarget {
    public sourceModule: Int
    public symbol: Int
}

public struct InterpolationImportAmbiguity {
    public sourceModule: Int
    public nodeIndex: Int
}

# A method decision precedes type and argument inference. Free-function lookup
# is permitted only for status -1; later consumers do not select another target.
public struct InterpolationMethodDecision {
    public sourceModule: Int
    public symbol: Int
    public receiverType: Int
    public ownerType: Int
    public traitModule: Int
    public traitSymbol: Int
    public expectedAdditionalArguments: Int
    # -1 not found, 0 selected, 1 inaccessible, 2 ambiguous, 3 invalid arity.
    public status: Int
}

# Dense canonical array facts. Non-array/unresolved entries have status1.
# Status:0 valid,1 unresolved,2 element mismatch,3 unsupported element,
# 4 literal capacity overflow,6 borrowed owned element,7 numeric range,
# 8 noncopyable repeat,9 retained child mismatch,10 contextual container mismatch,
# 11 typed-empty admission,12 fixed count,13 bounded capacity,14 repeat shape,
# 15 dependent nested failure (the original nested diagnostic remains authoritative).
# diagnosticNode/contextNode are global interpolation indices; valueAst is source-local.
public struct InterpolationArrayFact {
    public typeId: Int
    public elementTypeId: Int
    public valueAst: Int
    public dynamic: Bool
    public bounded: Bool
    public storageLength: Int
    public elementCount: Int
    public status: Int
    public diagnosticNode: Int
    public diagnosticContext: Int
    public contextNode: Int
    public expectedTypeId: Int
    public actualTypeId: Int
}

public struct ExpressionTypeIdSet {
    public types: [typeIds.SemanticType; ~]
    public references: [typeIds.TypeReference; ~]
    public fields: [typeIds.NominalField; ~]
    public expressions: [ExpressionTypeId; ~]
    # Current validated external call facts; never cache-restored source owners.
    public externalCallResults: [ExpressionTypeId; ~]
    public callArguments: [ResolvedCallArgument; ~]
    public enumConstructorArguments: [ResolvedEnumConstructorArgument; ~]
    public enumConstructorIndexByAst: [Int; ~]
    public enumConstructorIndexByInterpolationNode: [Int; ~]
    public referenceIndexByTypeAst: [Int; ~]
    public lexicalBindingTypeBySymbol: [Int; ~]
    public mutableBindingOwners: [Int; ~]
    public contextualRecordLabelByAst: [Bool; ~]
    public directEachRoleTypeBySymbol: [Int; ~]
    public streamRoleTypeBySymbol: [Int; ~]
    public interpolationArrayByNode: [InterpolationArrayFact; ~]
    public interpolationCallTypeByNode: [Int; ~]
    public interpolationCallSourceByNode: [Int; ~]
    public interpolationCallSymbolByNode: [Int; ~]
    public interpolationMethodByNode: [InterpolationMethodDecision; ~]
    public interpolationCallArguments: [ResolvedInterpolationCallArgument; ~]
    public interpolationLexicalTypeByNode: [Int; ~]
    public interpolationMemberTypeByNode: [Int; ~]
    public interpolationIndexedTypeByNode: [Int; ~]
    public interpolationContextualStructTypeByNode: [Int; ~]
    public interpolationContextualFieldByNode: [Int; ~]
    public interpolationContextualDiagnosticByNode: [ContextualStructDiagnostic; ~]
    public interpolationIndexExpectedTypeByNode: [Int; ~]
    public interpolationUnsupportedIndexOwnerTypeByNode: [Int; ~]
    public interpolationOwnedIndexElementTypeByNode: [Int; ~]
    public interpolationOwnedIndexContainerByNode: [Int; ~]
    public interpolationUnaryTypeByNode: [Int; ~]
    public interpolationUnaryStatusByNode: [Int; ~]
    public activeDeclarationBodyByAst: [Bool; ~]
}

# Admitted source-owner facts share the current semantic type arena. Empty
# seeds preserve ordinary compilation; admission and type rebinding precede use.
public struct CallContextSeeds {
    public ownerBySource: [Bool; ~]
    public bindingTypeBySymbol: [Int; ~]
    public values: [ExpressionTypeId; ~]
    public calls: [calls.ModuleCallResolution; ~]
    public arguments: [ResolvedCallArgument; ~]
}

public emptyCallContextSeeds: -> CallContextSeeds {
    CallContextSeeds { ownerBySource: [Bool; ~], bindingTypeBySymbol: [Int; ~], values: [ExpressionTypeId; ~], calls: [calls.ModuleCallResolution; ~], arguments: [ResolvedCallArgument; ~] }
}

seededSource owners: ref [Bool; ~], source: Int -> Bool {
    source >= 0 and source < (owners -> len) and owners[source]
}

public struct ResolvedCallContext {
    public prepared: semanticContext.SemanticSnapshot
    public types: ExpressionTypeIdSet
}

# Profiling metadata wraps one final owning result; no intermediate snapshot copy.
public struct ProfiledCallContext {
    public resolved: ResolvedCallContext
    public initialCoreMilliseconds: Long
    public completionMilliseconds: Long
}

public struct ContextualStructDiagnostic {
    # 0 valid, 1 non-identifier field, 2 duplicate field, 3 missing field,
    # 4 field type mismatch, 5 unknown field, 6 unknown nominal struct type.
    public code: Int
    public locationNode: Int
    public fieldIndex: Int
    public actualType: Int
    public ownerType: Int
}

struct UnaryTypeDecision {
    typeId: Int
    status: Int
}

interpolationUnaryDecision types: ref [typeIds.SemanticType; ~], operandTypeId: Int, opcode: Int -> UnaryTypeDecision {
    UnaryTypeDecision { typeId: -1, status: -1 } => unresolved
    operandTypeId < 0 or operandTypeId >= (types -> len)
        -> if { unresolved -> return }
    types[operandTypeId] => operandType
    not (operandType.kind == 1 and operandType.origin == 1)
        -> if { UnaryTypeDecision { typeId: -1, status: 1 } -> return }
    opcode == -26 -> if {
        operandType.symbol == 23
            -> if { UnaryTypeDecision { typeId: operandTypeId, status: 0 } -> return }
        UnaryTypeDecision { typeId: -1, status: 1 } -> return
    }
    opcode == grammar.tokenIdMinus() -> if {
        operandType.symbol -> typeIds.isSignedNumericBuiltinSymbol
            -> if { UnaryTypeDecision { typeId: operandTypeId, status: 0 } -> return }
        UnaryTypeDecision { typeId: -1, status: 1 } -> return
    }
    unresolved
}

# One semantic binary decision feeds receiver resolution, display composition,
# and diagnostic projections. None of these decisions reads Typed IR.
public struct BinaryOperands {
    public leftBuiltin: Int
    public rightBuiltin: Int
    public leftTypeId: Int
    public rightTypeId: Int
}

public struct BinaryArithmeticDecision {
    public code: Int
    public leftTypeId: Int
    public rightTypeId: Int
}

public struct BinaryComparisonDecision {
    public code: Int
    public leftTypeId: Int
    public rightTypeId: Int
    public textEquality: Bool
}

public interpolationNumericBuiltin symbol: Int, integerOnly: Bool -> Bool {
    symbol < 0 -> if { false -> return }
    symbol -> typeIds.canonicalBuiltinSymbol => canonical
    canonical == 2 or canonical == 3 or canonical == 4 or canonical == 6
        or canonical == 8 or canonical == 9 or canonical == 10 or canonical == 11
        or canonical == 12 or canonical == 13 or canonical == 14
        -> if { true -> return }
    not integerOnly and (canonical == 20 or canonical == 21)
}

public interpolationArithmeticDecision opcode: Int, operands: BinaryOperands -> BinaryArithmeticDecision {
    0 => code!
    operands.leftTypeId >= 0 and operands.rightTypeId >= 0
        -> if {
            operands.leftBuiltin -> typeIds.canonicalBuiltinSymbol => leftCanonical
            operands.rightBuiltin -> typeIds.canonicalBuiltinSymbol => rightCanonical
            leftCanonical == 14 -> if { 1 => code! }
            code! == 0 and not (operands.leftBuiltin -> interpolationNumericBuiltin(opcode == grammar.tokenIdPercent()))
                -> if { 2 => code! }
            code! == 0 and leftCanonical != rightCanonical
                -> if { 3 => code! }
        }
    BinaryArithmeticDecision {
        code: code!
        leftTypeId: operands.leftTypeId
        rightTypeId: operands.rightTypeId
    }
}

public interpolationComparisonDecision opcode: Int, operands: BinaryOperands -> BinaryComparisonDecision {
    0 => code!
    false => textEquality!
    operands.leftTypeId >= 0 and operands.rightTypeId >= 0
        -> if {
            operands.leftBuiltin -> typeIds.canonicalBuiltinSymbol => leftCanonical
            operands.rightBuiltin -> typeIds.canonicalBuiltinSymbol => rightCanonical
            leftCanonical == 1 or rightCanonical == 1 -> if {
                opcode != grammar.tokenIdEqualEqual() and opcode != grammar.tokenIdBangEqual()
                    -> if { 1 => code! } else {
                        leftCanonical != 1 or rightCanonical != 1
                            -> if { 2 => code! } else { true => textEquality! }
                    }
            }
            code! == 0 and not textEquality! and not (operands.leftBuiltin -> interpolationNumericBuiltin(false))
                -> if { 3 => code! }
            code! == 0 and not textEquality! and leftCanonical != rightCanonical
                -> if { 4 => code! }
        }
    BinaryComparisonDecision {
        code: code!
        leftTypeId: operands.leftTypeId
        rightTypeId: operands.rightTypeId
        textEquality: textEquality!
    }
}

public interpolationNumericLiteral nodes: ref [interpolation.InterpolationNode; ~], index: Int -> Bool {
    index < 0 or index >= (nodes -> len) -> if { false -> return }
    nodes[index] => node
    node.kind == 0 -> if { true -> return }
    node.kind == 2 and node.opcode == grammar.tokenIdMinus()
        and node.operand0 >= 0 and node.operand0 < (nodes -> len)
        and nodes[node.operand0].kind == 0
}

interpolationLiteralContextSupported prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], sourceModule: Int, nodeIndex: Int, peerTypeId: Int -> Bool {
    peerTypeId < 0 or peerTypeId >= (types -> len)
        -> if { false -> return }
    types[peerTypeId] => peer
    peer.kind != 1 or peer.origin != 1 or not (peer.symbol -> interpolationNumericBuiltin(false))
        -> if { false -> return }
    peer.symbol -> typeIds.canonicalBuiltinSymbol => builtin
    builtin == 20 or builtin == 21 -> if { true -> return }
    sourceModule < 0 or sourceModule >= (prepared.package.sources -> len)
        -> if { false -> return }
    prepared.interpolations[nodeIndex] => literal!
    literal!.kind == 2 -> if { prepared.interpolations[literal!.operand0] => literal! }
    prepared.package.sources[sourceModule] -> slice(0, prepared.package.sources[sourceModule] -> len) => source
    not (source -> numericLiteralRange.literalUsesFloatingSyntax(literal!.payloadStart, literal!.payloadStart + literal!.payloadLength))
}

# C# gives a literal its independently typed peer's numeric context. Two
# literals retain their own default types; arbitrary unary values are not literals.
public interpolationBinaryOperandsForNodes prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], sourceModule: Int, leftIndex: Int, rightIndex: Int, leftTypeId: Int, rightTypeId: Int -> BinaryOperands {
    prepared.interpolations -> interpolationNumericLiteral(leftIndex) => leftLiteral!
    prepared.interpolations -> interpolationNumericLiteral(rightIndex) => rightLiteral!
    leftLiteral! and not rightLiteral! -> if {
        prepared -> interpolationLiteralContextSupported(types, sourceModule, leftIndex, rightTypeId) => leftLiteral!
    } else {
        rightLiteral! and not leftLiteral! -> if {
            prepared -> interpolationLiteralContextSupported(types, sourceModule, rightIndex, leftTypeId) => rightLiteral!
        }
    }
    types -> interpolationBinaryOperands(leftTypeId, rightTypeId, leftLiteral!, rightLiteral!)
}

public interpolationBinaryOperands types: ref [typeIds.SemanticType; ~], leftTypeId: Int, rightTypeId: Int, leftLiteral: Bool, rightLiteral: Bool -> BinaryOperands {
    leftTypeId => contextualLeft!
    rightTypeId => contextualRight!
    -1 => leftBuiltin!
    -1 => rightBuiltin!
    contextualLeft! >= 0 and contextualLeft! < (types -> len)
        -> if {
            types[contextualLeft!] => valueType
            valueType.kind == 1 and valueType.origin == 1
                -> if { valueType.symbol => leftBuiltin! }
        }
    contextualRight! >= 0 and contextualRight! < (types -> len)
        -> if {
            types[contextualRight!] => valueType
            valueType.kind == 1 and valueType.origin == 1
                -> if { valueType.symbol => rightBuiltin! }
        }
    leftLiteral and not rightLiteral and (rightBuiltin! -> interpolationNumericBuiltin(false))
        -> if {
            rightBuiltin! => leftBuiltin!
            contextualRight! => contextualLeft!
        }
    rightLiteral and not leftLiteral and (leftBuiltin! -> interpolationNumericBuiltin(false))
        -> if {
            leftBuiltin! => rightBuiltin!
            contextualLeft! => contextualRight!
        }
    BinaryOperands { leftBuiltin: leftBuiltin!, rightBuiltin: rightBuiltin!, leftTypeId: contextualLeft!, rightTypeId: contextualRight! }
}

public interpolationBinaryTypeId types: ref [typeIds.SemanticType; ~], opcode: Int, leftTypeId: Int, rightTypeId: Int, leftLiteral: Bool, rightLiteral: Bool -> Int {
    leftTypeId < 0 or rightTypeId < 0 or leftTypeId >= (types -> len) or rightTypeId >= (types -> len)
        -> if { -1 -> return }
    types -> interpolationBinaryOperands(leftTypeId, rightTypeId, leftLiteral, rightLiteral) => operands
    opcode == grammar.tokenIdPlus() or opcode == grammar.tokenIdMinus()
        or opcode == grammar.tokenIdStar() or opcode == grammar.tokenIdSlash()
        or opcode == grammar.tokenIdPercent() -> if {
            opcode -> interpolationArithmeticDecision(operands) => decision
            decision.code == 0 -> if { decision.leftTypeId -> return }
        }
    opcode == grammar.tokenIdEqualEqual() or opcode == grammar.tokenIdBangEqual()
        or opcode == grammar.tokenIdLess() or opcode == grammar.tokenIdLessEqual()
        or opcode == grammar.tokenIdGreater() or opcode == grammar.tokenIdGreaterEqual()
        -> if {
            opcode -> interpolationComparisonDecision(operands) => decision
            decision.code == 0 -> if { types -> typeIds.builtinTypeId(23) -> return }
        }
    opcode == -24 or opcode == -25 -> if {
        operands.leftBuiltin -> typeIds.canonicalBuiltinSymbol => leftCanonical
        operands.rightBuiltin -> typeIds.canonicalBuiltinSymbol => rightCanonical
        leftCanonical == 23 and rightCanonical == 23 -> if { types -> typeIds.builtinTypeId(23) -> return }
    }
    -1
}

public struct ExpressionTypeIdRequest {
    public sources: [Text; ~]
    public types: [typeIds.SemanticType; ~]
    public references: [typeIds.TypeReference; ~]
    public fields: [typeIds.NominalField; ~]
    public modules: [modules.ModuleIdentity; ~]
    public qualified: [qualified.QualifiedResolution; ~]
    public calls: [calls.ModuleCallResolution; ~]
    public analysisRanges: [analysis.SourceAnalysisRange; ~]
    public analysisNodes: [ast.AstNode; ~]
    public analysisTokens: [syntax.SyntaxToken; ~]
    public analysisSymbols: [symbols.Symbol; ~]
    public analysisNames: [resolution.ResolvedName; ~]
}

# Map access mode is syntax-owned. Resolve only the exact second identifier in
# the MapExpression token span; malformed or unknown spellings remain invalid
# instead of silently becoming a read or write operation.
public mapExpressionOpcode source: Text, tokens: ref [syntax.SyntaxToken; ~], sourceTokenStart: Int, node: ast.AstNode -> Int {
    -1 => opcode!
    false => mapKeyword!
    0 => identifierOrdinal!
    node.firstToken => tokenIndex!
    tokenIndex! < node.firstToken + node.tokenCount
        -> while {
            tokens[sourceTokenStart + tokenIndex!] => token
            token.kind == grammar.tokenIdIdentifier() -> if {
                identifierOrdinal! == 0 -> if {
                    token.span.length == 3
                        and (source -> byte(token.span.start)) == 109
                        and (source -> byte(token.span.start + 1)) == 97
                        and (source -> byte(token.span.start + 2)) == 112
                        -> if { true => mapKeyword! }
                }
                identifierOrdinal! == 1 and mapKeyword! -> if {
                    token.span.length == 4
                        and (source -> byte(token.span.start)) == 114
                        and (source -> byte(token.span.start + 1)) == 101
                        and (source -> byte(token.span.start + 2)) == 97
                        and (source -> byte(token.span.start + 3)) == 100
                        -> if { -306 => opcode! }
                    token.span.length == 5
                        and (source -> byte(token.span.start)) == 119
                        and (source -> byte(token.span.start + 1)) == 114
                        and (source -> byte(token.span.start + 2)) == 105
                        and (source -> byte(token.span.start + 3)) == 116
                        and (source -> byte(token.span.start + 4)) == 101
                        -> if { -307 => opcode! }
                }
                identifierOrdinal! + 1 => identifierOrdinal!
            }
            tokenIndex! + 1 => tokenIndex!
        }
    opcode!
}

# A map clause supplies literal context before the semantic table is frozen.
# Read the nearest identifier within the map span, never one inside a string.
mapLiteralContextType source: Text, tokens: ref [syntax.SyntaxToken; ~], sourceTokenStart: Int, mapNode: ast.AstNode, literal: ast.AstNode -> Int {
    -1 => contextualType!
    literal.firstToken - 1 => tokenIndex!
    false => foundClause!
    tokenIndex! >= mapNode.firstToken and not foundClause!
        -> while {
            tokens[sourceTokenStart + tokenIndex!] => token
            token.kind == grammar.tokenIdIdentifier() -> if {
                true => foundClause!
                TextMatchRequest { source: source, start: token.span.start, length: token.span.length, expected: "at" } -> textMatches
                    -> if { 11 => contextualType! }
                TextMatchRequest { source: source, start: token.span.start, length: token.span.length, expected: "for" } -> textMatches
                    -> if { 13 => contextualType! }
                TextMatchRequest { source: source, start: token.span.start, length: token.span.length, expected: "size" } -> textMatches
                    -> if { 11 => contextualType! }
            }
            tokenIndex! - 1 => tokenIndex!
        }
    contextualType!
}

resolveLateArrayTypes prepared: semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~], expectedContextByAst: ref [Int; ~] -> Bool {
    [lateArrayTypes.Candidate; ~] => candidates!
    0 => candidateIndex!
    candidateIndex! < (expressions -> len) -> while {
        expressions[candidateIndex!] => candidate
        candidates! -> push(lateArrayTypes.Candidate {
            sourceModule: candidate.sourceModule
            astNode: candidate.astNode
            typeId: candidate.typeId
            status: candidate.status
        })
        candidateIndex! + 1 => candidateIndex!
    }
    lateArrayTypes.resolve(prepared, types, candidates!, expressionIndexByAst, expectedContextByAst) => resolved
    false => changed!
    0 => resolvedIndex!
    resolvedIndex! < (resolved -> len) -> while {
        resolved[resolvedIndex!] => item
        expressionIndexByAst[item.globalAst] => expressionIndex!
        expressionIndex! >= 0 -> if {
            expressions[expressionIndex!] => existing!
            existing!.typeId != item.typeId or existing!.status != 0
                -> if {
                    item.typeId => existing!.typeId
                    0 => existing!.status
                    existing! => expressions[expressionIndex!]
                    true => changed!
                }
        } else {
            expressions -> len => expressionIndex!
            expressions -> push(ExpressionTypeId {
                sourceModule: item.sourceModule
                astNode: item.astNode
                typeId: item.typeId
                status: 0
            })
            expressionIndex! => expressionIndexByAst[item.globalAst]
            true => changed!
        }
        resolvedIndex! + 1 => resolvedIndex!
    }
    changed!
}

struct TextMatchRequest {
    source: Text
    start: UIntSize
    length: UIntSize
    expected: Text
}

textMatches request: TextMatchRequest -> Bool {
    request.expected -> len => expectedLength
    request.length == expectedLength => matches!
    UIntSize(0) => byteIndex!
    matches! and byteIndex! < request.length -> while {
        request.source -> byte(request.start + byteIndex!) => actual
        request.expected -> byte(byteIndex!) => expected
        actual != expected -> if { false => matches! }
        byteIndex! + 1 => byteIndex!
    }
    matches!
}

# Resolve a member path against the semantic field table before Typed IR exists.
public memberFieldIndex prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], fields: ref [typeIds.NominalField; ~], sourceModule: Int, initialOwnerTypeId: Int, nodeIndex: Int -> Int {
    prepared.interpolations[nodeIndex] => node
    node.kind != 5 or node.operand0 < 0 -> if { -1 -> return }
    prepared.interpolations[node.operand0] => memberBase
    initialOwnerTypeId => ownerTypeId!
    -1 => fieldIndex!
    memberBase.payloadStart + memberBase.payloadLength => memberCursor!
    node.payloadStart + node.payloadLength => memberEnd
    true => memberPathValid!
    memberPathValid! and memberCursor! < memberEnd
        -> while {
            memberCursor! < memberEnd and (prepared.package.sources[sourceModule] -> byte(memberCursor!)) != 46
                -> while { memberCursor! + 1 => memberCursor! }
            memberCursor! + 1 => memberNameStart
            memberNameStart => memberNameEnd!
            memberNameEnd! < memberEnd and (prepared.package.sources[sourceModule] -> byte(memberNameEnd!)) != 46
                -> while { memberNameEnd! + 1 => memberNameEnd! }
            memberNameEnd! - memberNameStart => memberNameLength
            ownerTypeId! >= 0 and types[ownerTypeId!].kind == 8
                -> if { types[ownerTypeId!].first => ownerTypeId! }
            -1 => resolvedMemberField!
            0 => fieldSearch!
            fieldSearch! < (fields -> len) -> while {
                fields[fieldSearch!] => field
                field.status == 0 and field.ownerType == ownerTypeId!
                    and field.fieldSymbol < 0 and field.labelToken < 0
                    -> if {
                        prepared.package.sources[sourceModule] -> slice(memberNameStart, memberNameLength) -> typeIds.structuralFieldNameMatches(0, memberNameLength, field.ordinal)
                            -> if { fieldSearch! => resolvedMemberField! }
                    }
                field.status == 0 and field.ownerType == ownerTypeId! and field.sourceModule >= 0
                    and (field.fieldSymbol >= 0 or field.labelToken >= 0)
                    -> if {
                        prepared.package.ranges[field.sourceModule] => fieldRange
                        field.labelToken => fieldNameToken!
                        field.fieldSymbol >= 0 -> if {
                            prepared.package.symbols[fieldRange.symbolStart + field.fieldSymbol] => fieldSymbol
                            fieldSymbol.nameToken => fieldNameToken!
                        }
                        prepared.package.tokens[fieldRange.tokenStart + fieldNameToken!] => fieldName
                        fieldName.span.length == memberNameLength => fieldNameEqual!
                        UIntSize(0) => fieldNameByte!
                        fieldNameEqual! and fieldNameByte! < memberNameLength
                            -> while {
                                (prepared.package.sources[sourceModule] -> byte(memberNameStart + fieldNameByte!)) != (prepared.package.sources[field.sourceModule] -> byte(fieldName.span.start + fieldNameByte!))
                                    -> if { false => fieldNameEqual! }
                                fieldNameByte! + 1 => fieldNameByte!
                            }
                        fieldNameEqual! -> if { fieldSearch! => resolvedMemberField! }
                    }
                fieldSearch! + 1 => fieldSearch!
            }
            resolvedMemberField! >= 0 -> if {
                resolvedMemberField! => fieldIndex!
                fields[resolvedMemberField!].fieldType => ownerTypeId!
                memberNameEnd! => memberCursor!
            } else {
                false => memberPathValid!
                -1 => fieldIndex!
            }
        }
    fieldIndex!
}

public accessibleMemberFieldType prepared: ref semanticContext.SemanticSnapshot, fields: ref [typeIds.NominalField; ~], sourceModule: Int, fieldIndex: Int -> Int {
    fieldIndex < 0 or fieldIndex >= (fields -> len)
        -> if { -1 -> return }
    fields[fieldIndex] => field
    field.fieldSymbol >= 0 and field.sourceModule >= 0
        and not (prepared.package.sources -> modules.sameLogicalAnalyzedSource(prepared.modules, sourceModule, field.sourceModule, prepared.package.tokens, prepared.package.ranges))
        -> if {
            prepared.package.ranges[field.sourceModule] => fieldRange
            prepared.package.symbols[fieldRange.symbolStart + field.fieldSymbol] => declaration
            declaration.flags / 4 % 2 == 0 -> if { -1 -> return }
        }
    field.fieldType
}

public contextualStructFieldIndex prepared: ref semanticContext.SemanticSnapshot, fields: ref [typeIds.NominalField; ~], sourceModule: Int, ownerTypeId: Int, labelNodeIndex: Int -> Int {
    prepared.interpolations[labelNodeIndex] => label
    label.kind != 13 -> if { -1 -> return }
    0 => fieldIndex!
    fieldIndex! < (fields -> len) -> while {
        fields[fieldIndex!] => field
        field.status == 0 and field.ownerType == ownerTypeId and field.sourceModule >= 0
            and (field.fieldSymbol >= 0 or field.labelToken >= 0)
            -> if {
                prepared.package.ranges[field.sourceModule] => fieldRange
                field.labelToken => nameTokenIndex!
                field.fieldSymbol >= 0 -> if {
                    prepared.package.symbols[fieldRange.symbolStart + field.fieldSymbol].nameToken => nameTokenIndex!
                }
                prepared.package.tokens[fieldRange.tokenStart + nameTokenIndex!] => nameToken
                nameToken.span.length == label.payloadLength => sameName!
                UIntSize(0) => byteIndex!
                sameName! and byteIndex! < label.payloadLength
                    -> while {
                        (prepared.package.sources[sourceModule] -> byte(label.payloadStart + byteIndex!)) != (prepared.package.sources[field.sourceModule] -> byte(nameToken.span.start + byteIndex!))
                            -> if { false => sameName! }
                        byteIndex! + 1 => byteIndex!
                    }
                sameName! -> if { fieldIndex! -> return }
            }
        fieldIndex! + 1 => fieldIndex!
    }
    -1
}

contextualLabelsEqual prepared: ref semanticContext.SemanticSnapshot, sourceModule: Int, leftIndex: Int, rightIndex: Int -> Bool {
    prepared.interpolations[leftIndex] => left
    prepared.interpolations[rightIndex] => right
    left.payloadLength != right.payloadLength -> if { false -> return }
    UIntSize(0) => byteIndex!
    byteIndex! < left.payloadLength -> while {
        (prepared.package.sources[sourceModule] -> byte(left.payloadStart + byteIndex!)) != (prepared.package.sources[sourceModule] -> byte(right.payloadStart + byteIndex!))
            -> if { false -> return }
        byteIndex! + 1 => byteIndex!
    }
    true
}

contextualStructDiagnostic prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], fields: ref [typeIds.NominalField; ~], lexicalTypes: ref [Int; ~], typeByNode: ref [Int; ~], fieldByNode: ref [Int; ~], sourceModule: Int, literalIndex: Int -> ContextualStructDiagnostic {
    ContextualStructDiagnostic { code: 0, locationNode: -1, fieldIndex: -1, actualType: -1, ownerType: -1 } => valid!
    prepared.interpolations[literalIndex] => literal
    literalIndex >= (typeByNode -> len) or typeByNode[literalIndex] < 0
        -> if {
            literal.kind == 14 -> if {
                ContextualStructDiagnostic { code: 6, locationNode: literalIndex, fieldIndex: -1, actualType: -1, ownerType: -1 } -> return
            }
            valid! -> return
        }
    typeByNode[literalIndex] => ownerTypeId
    ownerTypeId => valid!.ownerType
    literal.kind == 14 -> if {
        types[ownerTypeId] => ownerType
        ownerType.origin == 0 and ownerType.module >= 0 and ownerType.symbol >= 0
            -> if {
                prepared.package.ranges[ownerType.module] => ownerRange
                prepared.package.symbols[ownerRange.symbolStart + ownerType.symbol] => declaration
                declaration.flags / 4 % 2 == 0
                    and not (prepared.package.sources -> modules.sameLogicalAnalyzedSource(prepared.modules, sourceModule, ownerType.module, prepared.package.tokens, prepared.package.ranges))
                    -> if {
                        ContextualStructDiagnostic { code: 7, locationNode: literalIndex, fieldIndex: -1, actualType: -1, ownerType: ownerTypeId } -> return
                    }
            }
    }
    0 => childOrdinal!
    literalIndex + 1 => childIndex!
    childIndex! < (prepared.interpolations -> len)
        -> while {
            prepared.interpolations[childIndex!] => child
            child.parent == literalIndex -> if {
                childOrdinal! % 2 == 0 -> if {
                    child.kind != 13 -> if {
                        ContextualStructDiagnostic { code: 1, locationNode: childIndex!, fieldIndex: -1, actualType: -1, ownerType: ownerTypeId } -> return
                    }
                    0 => earlierOrdinal!
                    literalIndex + 1 => earlierIndex!
                    earlierIndex! < childIndex! -> while {
                        prepared.interpolations[earlierIndex!].parent == literalIndex
                            -> if {
                                earlierOrdinal! % 2 == 0
                                    and (prepared -> contextualLabelsEqual(sourceModule, earlierIndex!, childIndex!))
                                    -> if {
                                        ContextualStructDiagnostic { code: 2, locationNode: childIndex!, fieldIndex: -1, actualType: -1, ownerType: ownerTypeId } -> return
                                    }
                                earlierOrdinal! + 1 => earlierOrdinal!
                            }
                        earlierIndex! + 1 => earlierIndex!
                    }
                }
                childOrdinal! + 1 => childOrdinal!
            }
            childIndex! + 1 => childIndex!
        }
    # Nominal initializers need the complete expression type. Their duplicate
    # names are known now; validate fields and values after expression inference.
    literal.kind == 14 -> if { valid! -> return }
    -1 => missingField!
    0 => candidateIndex!
    candidateIndex! < (fields -> len) -> while {
        fields[candidateIndex!] => field
        field.status == 0 and field.ownerType == ownerTypeId
            -> if {
                false => present!
                literalIndex + 1 => labelIndex!
                labelIndex! < (prepared.interpolations -> len)
                    -> while {
                        prepared.interpolations[labelIndex!].parent == literalIndex
                            and labelIndex! < (fieldByNode -> len)
                            and fieldByNode[labelIndex!] == candidateIndex!
                            -> if { true => present! }
                        labelIndex! + 1 => labelIndex!
                    }
                not present! and (missingField! < 0 or field.ordinal < fields[missingField!].ordinal)
                    -> if { candidateIndex! => missingField! }
            }
        candidateIndex! + 1 => candidateIndex!
    }
    missingField! >= 0 -> if {
        ContextualStructDiagnostic { code: 3, locationNode: literalIndex, fieldIndex: missingField!, actualType: -1, ownerType: ownerTypeId } -> return
    }
    0 => declarationOrdinal!
    declarationOrdinal! < (fields -> len) -> while {
        -1 => declaredFieldIndex!
        0 => fieldSearch!
        fieldSearch! < (fields -> len) -> while {
            fields[fieldSearch!].status == 0 and fields[fieldSearch!].ownerType == ownerTypeId
                and fields[fieldSearch!].ordinal == declarationOrdinal!
                -> if { fieldSearch! => declaredFieldIndex! }
            fieldSearch! + 1 => fieldSearch!
        }
        declaredFieldIndex! >= 0 -> if {
            -1 => valueIndex!
            literalIndex + 1 => labelSearch!
            labelSearch! < (prepared.interpolations -> len)
                -> while {
                    prepared.interpolations[labelSearch!].parent == literalIndex
                        and labelSearch! < (fieldByNode -> len)
                        and fieldByNode[labelSearch!] == declaredFieldIndex!
                        -> if {
                            labelSearch! + 1 => valueSearch!
                            valueSearch! < (prepared.interpolations -> len) and valueIndex! < 0
                                -> while {
                                    prepared.interpolations[valueSearch!].parent == literalIndex
                                        -> if { valueSearch! => valueIndex! }
                                    valueSearch! + 1 => valueSearch!
                                }
                        }
                    labelSearch! + 1 => labelSearch!
                }
            valueIndex! >= 0 -> if {
                prepared.interpolations[valueIndex!] => value
                -1 => actualType!
                value.kind == 4 -> if { types -> typeIds.builtinTypeId(23) => actualType! }
                value.kind == 1 and valueIndex! < (lexicalTypes -> len)
                    -> if { lexicalTypes[valueIndex!] => actualType! }
                value.kind == 0 -> if {
                    fields[declaredFieldIndex!].fieldType => expectedTypeId
                    expectedTypeId >= 0 and expectedTypeId < (types -> len)
                        -> if {
                            types[expectedTypeId] => expectedType
                            expectedType.kind == 1 and expectedType.origin == 1
                                and ((expectedType.symbol >= 2 and expectedType.symbol <= 14)
                                or expectedType.symbol == 20 or expectedType.symbol == 21 or expectedType.symbol == 22)
                                -> if { expectedTypeId => actualType! }
                        }
                    actualType! < 0 -> if {
                        prepared.package.sources[sourceModule] -> slice(value.payloadStart, value.payloadLength) => literalText
                        literalText -> numericLiteralRange.literalUsesFloatingSyntax(0, value.payloadLength)
                            -> if { types -> typeIds.builtinTypeId(20) => actualType! } else {
                                types -> typeIds.builtinTypeId(2) => actualType!
                            }
                    }
                }
                actualType! >= 0 -> if {
                    types -> typeIds.materializedReadTypeId(actualType!) => actualType!
                    actualType! != fields[declaredFieldIndex!].fieldType
                        -> if {
                            ContextualStructDiagnostic {
                                code: 4
                                locationNode: valueIndex!
                                fieldIndex: declaredFieldIndex!
                                actualType: actualType!
                                ownerType: ownerTypeId
                            } -> return
                        }
                }
            }
        }
        declarationOrdinal! + 1 => declarationOrdinal!
    }
    literalIndex + 1 => unknownIndex!
    unknownIndex! < (prepared.interpolations -> len)
        -> while {
            prepared.interpolations[unknownIndex!] => candidate
            candidate.parent == literalIndex and candidate.kind == 13
                and unknownIndex! < (fieldByNode -> len) and fieldByNode[unknownIndex!] < 0
                -> if {
                    ContextualStructDiagnostic { code: 5, locationNode: unknownIndex!, fieldIndex: -1, actualType: -1, ownerType: ownerTypeId } -> return
                }
            unknownIndex! + 1 => unknownIndex!
        }
    valid!
}

# Bridges the existing shallow expression pass into the canonical recursive
# type arena. Annotation-backed names and call results retain their full type;
# builtin expressions use the stable builtin id directly.
preIrIntegerIndexExpression prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], lexicalTypes: ref [Int; ~], sourceModule: Int, nodeIndex: Int, expectedSymbol: Int -> Bool {
    nodeIndex < 0 or nodeIndex >= (prepared.interpolations -> len)
        -> if { false -> return }
    prepared.interpolations[nodeIndex] => index
    index.kind == 0 -> if {
        prepared.package.sources[sourceModule] -> slice(index.payloadStart, index.payloadLength) => literal
        literal -> numericLiteralRange.literalUsesFloatingSyntax(0, index.payloadLength)
            -> if { false -> return }
        literal -> numericLiteralRange.integerLiteralStatus(0, index.payloadLength, expectedSymbol, 64, false, false, 0, 1) => status
        status == 1 -> return
    }
    index.kind == 1 and nodeIndex < (lexicalTypes -> len)
        -> if {
            lexicalTypes[nodeIndex] => indexType
            indexType >= 0 and indexType < (types -> len)
                -> if {
                    types[indexType] => semanticIndexType
                    semanticIndexType.kind == 1 and semanticIndexType.origin == 1 and semanticIndexType.symbol == expectedSymbol
                        -> if { true -> return }
                }
        }
    index.kind == 2 and index.opcode == grammar.tokenIdMinus()
        and expectedSymbol == 2 and index.operand0 >= 0
        -> if {
            prepared -> preIrIntegerIndexExpression(types, lexicalTypes, sourceModule, index.operand0, expectedSymbol)
                -> if { true -> return }
        }
    index.kind == 3 and index.operand0 >= 0 and index.operand1 >= 0
        and (index.opcode == grammar.tokenIdPlus() or index.opcode == grammar.tokenIdMinus()
        or index.opcode == grammar.tokenIdStar() or index.opcode == grammar.tokenIdSlash()
        or index.opcode == grammar.tokenIdPercent())
        -> if {
            prepared -> preIrIntegerIndexExpression(types, lexicalTypes, sourceModule, index.operand0, expectedSymbol) => leftMatches
            prepared -> preIrIntegerIndexExpression(types, lexicalTypes, sourceModule, index.operand1, expectedSymbol) => rightMatches
            leftMatches and rightMatches -> if { true -> return }
        }
    false
}

public preIrIntIndexExpression prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], lexicalTypes: ref [Int; ~], sourceModule: Int, nodeIndex: Int -> Bool {
    prepared -> preIrIntegerIndexExpression(types, lexicalTypes, sourceModule, nodeIndex, 2)
}

preIrUIntSizeIndexExpression prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], lexicalTypes: ref [Int; ~], sourceModule: Int, nodeIndex: Int -> Bool {
    prepared -> preIrIntegerIndexExpression(types, lexicalTypes, sourceModule, nodeIndex, 13)
}

# Reuse the collection index contract when a receiver becomes known only after
# method-target resolution. An invalid index or an owned element stays unknown
# for the existing diagnostic and ownership passes.
public preIrIndexedResultTypeId prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], lexicalTypes: ref [Int; ~], sourceModule: Int, ownerTypeId: Int, indexNodeIndex: Int -> Int {
    ownerTypeId < 0 or ownerTypeId >= (types -> len)
        or indexNodeIndex < 0 or indexNodeIndex >= (prepared.interpolations -> len)
        -> if { -1 -> return }
    types -> typeIds.materializedReadTypeId(ownerTypeId) => materializedOwnerTypeId
    types[materializedOwnerTypeId] => ownerType
    ownerType.kind == 2 or ownerType.kind == 3 or ownerType.kind == 4 or ownerType.kind == 12
        -> if {
            prepared -> preIrIntIndexExpression(types, lexicalTypes, sourceModule, indexNodeIndex) => validIndex
            validIndex and ownerType.first >= 0 and ownerType.first < (types -> len)
                -> if {
                    prepared -> semanticContext.typeContainsOwnedStorage(types, ownerType.first)
                        -> if { -1 -> return }
                    ownerType.first -> return
                }
        }
    ownerType.kind == 5 or ownerType.kind == 13 -> if {
        ownerType.first >= 0 and ownerType.first < (types -> len)
            and ownerType.second >= 0 and ownerType.second < (types -> len)
            -> if {
                types[ownerType.first] => keyType
                prepared.interpolations[indexNodeIndex] => indexNode
                -1 => actualIndexTypeId!
                indexNode.kind == 1 and indexNodeIndex < (lexicalTypes -> len)
                    -> if { lexicalTypes[indexNodeIndex] => actualIndexTypeId! }
                actualIndexTypeId! == ownerType.first => validIndex!
                keyType.kind == 1 and keyType.origin == 1 and keyType.symbol == 2
                    -> if {
                        prepared -> preIrIntIndexExpression(types, lexicalTypes, sourceModule, indexNodeIndex)
                            -> if { true => validIndex! }
                    }
                validIndex! -> if {
                    prepared -> semanticContext.typeContainsOwnedStorage(types, ownerType.second)
                        -> if { -1 -> return }
                    ownerType.second -> return
                }
            }
    }
    ownerType.kind == 1 and ownerType.origin == 1
        and (ownerType.symbol == 16 or ownerType.symbol == 17 or ownerType.symbol == 18)
        -> if {
            prepared -> preIrUIntSizeIndexExpression(types, lexicalTypes, sourceModule, indexNodeIndex)
                -> if {
                    ownerType.symbol == 16 -> if { 1 } else { 8 } => resultSymbol
                    types -> typeIds.builtinTypeId(resultSymbol) -> return
                }
        }
    -1
}

# Interpolation receivers can be names, declared fields, indexed values, or
# function results. Resolve their prepared type before Typed IR chooses a carrier.
public preIrInterpolationReceiverTypeId prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], references: ref [typeIds.TypeReference; ~], referenceIndexByTypeAst: ref [Int; ~], lexicalTypes: ref [Int; ~], memberTypes: ref [Int; ~], indexedTypes: ref [Int; ~], literalTypes: ref [Int; ~], callTypes: ref [Int; ~], sourceModule: Int, nodeIndex: Int -> Int {
    nodeIndex < 0 or nodeIndex >= (prepared.interpolations -> len)
        -> if { -1 -> return }
    prepared.interpolations[nodeIndex] => owner
    owner.kind == 11 and owner.operand0 >= 0 and owner.operand0 < (prepared.interpolations -> len)
        and owner.operand0 != nodeIndex and prepared.interpolations[owner.operand0].parent == nodeIndex
        -> if {
            prepared -> preIrInterpolationReceiverTypeId(types, references, referenceIndexByTypeAst, lexicalTypes, memberTypes, indexedTypes, literalTypes, callTypes, sourceModule, owner.operand0) => operandTypeId
            operandTypeId >= 0 and operandTypeId < (types -> len)
                -> if {
                    types[operandTypeId] => operandType
                    operandType.kind == 7 and operandType.origin == 4 and operandType.symbol == 1
                        -> if { operandType.first -> return }
                }
        }
    owner.kind == 1 and nodeIndex < (lexicalTypes -> len)
        -> if { lexicalTypes[nodeIndex] -> return }
    owner.kind == 5 and nodeIndex < (memberTypes -> len)
        -> if { memberTypes[nodeIndex] -> return }
    owner.kind == 7 and nodeIndex < (indexedTypes -> len)
        -> if { indexedTypes[nodeIndex] -> return }
    (owner.kind == 14 or owner.kind == 16 or owner.kind == 0 or owner.kind == 2) and nodeIndex < (literalTypes -> len) and literalTypes[nodeIndex] >= 0
        -> if { literalTypes[nodeIndex] -> return }
    (owner.kind == 6 or owner.kind == 8 or owner.kind == 10 or owner.kind == 15) and nodeIndex < (callTypes -> len)
        -> if { callTypes[nodeIndex] -> return }
    owner.kind == 0 -> if {
        sourceModule < 0 or sourceModule >= (prepared.package.sources -> len)
            -> if { -1 -> return }
        prepared.package.sources[sourceModule] -> len => sourceLength
        owner.payloadStart + owner.payloadLength > sourceLength
            -> if { -1 -> return }
        prepared.package.sources[sourceModule] -> slice(owner.payloadStart, owner.payloadLength) => literal
        literal -> numericLiteralRange.literalUsesFloatingSyntax(0, owner.payloadLength)
            -> if { types -> typeIds.builtinTypeId(20) -> return }
        types -> typeIds.builtinTypeId(2) -> return
    }
    owner.kind == 4 -> if { types -> typeIds.builtinTypeId(23) -> return }
    owner.kind == 9 and owner.typeSymbol >= 0
        -> if { types -> typeIds.builtinTypeId(owner.typeSymbol) -> return }
    owner.kind == 3 and owner.operand0 >= 0 and owner.operand1 >= 0
        and owner.operand0 < (prepared.interpolations -> len) and owner.operand1 < (prepared.interpolations -> len)
        and prepared.interpolations[owner.operand0].parent == nodeIndex
        and prepared.interpolations[owner.operand1].parent == nodeIndex
        -> if {
            prepared -> preIrInterpolationReceiverTypeId(types, references, referenceIndexByTypeAst, lexicalTypes, memberTypes, indexedTypes, literalTypes, callTypes, sourceModule, owner.operand0) => leftTypeId
            prepared -> preIrInterpolationReceiverTypeId(types, references, referenceIndexByTypeAst, lexicalTypes, memberTypes, indexedTypes, literalTypes, callTypes, sourceModule, owner.operand1) => rightTypeId
            prepared -> interpolationBinaryOperandsForNodes(types, sourceModule, owner.operand0, owner.operand1, leftTypeId, rightTypeId) => operands
            types -> interpolationBinaryTypeId(owner.opcode, operands.leftTypeId, operands.rightTypeId, false, false) -> return
        }
    owner.kind == 2 and owner.operand0 >= 0 and owner.operand0 != nodeIndex
        and owner.operand0 < (prepared.interpolations -> len)
        and prepared.interpolations[owner.operand0].parent == nodeIndex
        -> if {
            prepared -> preIrInterpolationReceiverTypeId(types, references, referenceIndexByTypeAst, lexicalTypes, memberTypes, indexedTypes, literalTypes, callTypes, sourceModule, owner.operand0) => operandTypeId
            types -> interpolationUnaryDecision(operandTypeId, owner.opcode) => decision
            decision.status == 0 -> if { decision.typeId -> return }
        }
    -1
}

public firstInterpolationImportAmbiguity prepared: ref semanticContext.SemanticSnapshot -> InterpolationImportAmbiguity {
    prepared.interpolationRanges -> each range {
        range.nodeStart => nodeIndex!
        nodeIndex! < range.nodeStart + range.nodeCount
            -> while {
                prepared.interpolations[nodeIndex!] => call
                call.kind == 10 and call.callNameLength > 0 -> if {
                    prepared.package.sources[range.sourceModule] -> slice(call.callNameStart, call.callNameLength) => name
                    prepared.package -> calls.sourceFunctionCandidates(prepared.modules, prepared.resolvedImports, range.sourceModule, name) => candidates
                    (candidates -> len) > 1 and candidates[0].importEdge >= 0
                        -> if {
                            InterpolationImportAmbiguity { sourceModule: range.sourceModule, nodeIndex: nodeIndex! } -> return
                        }
                }
                nodeIndex! + 1 => nodeIndex!
            }
    }
    InterpolationImportAmbiguity { sourceModule: -1, nodeIndex: -1 }
}

public interpolationFunctionTarget prepared: ref semanticContext.SemanticSnapshot, sourceModule: Int, nodeIndex: Int -> InterpolationFunctionTarget {
    InterpolationFunctionTarget { sourceModule: -1, symbol: -1 } => unresolved
    prepared.interpolations[nodeIndex] => call
    call.kind == 8 and call.symbol >= 0 -> if {
        InterpolationFunctionTarget { sourceModule: sourceModule, symbol: call.symbol } -> return
    }
    call.kind != 10 or call.callNameLength == 0
        -> if { unresolved -> return }
    call.targetAst >= 0 and call.prefixSymbol < 0
        -> if {
            prepared.qualified -> each qualifiedTarget {
                qualifiedTarget.sourceModule == sourceModule and qualifiedTarget.pathAst == call.targetAst
                    and qualifiedTarget.status == 0 and qualifiedTarget.targetModule >= 0
                    and qualifiedTarget.targetModule < (prepared.modules -> len)
                    -> if {
                        prepared.modules[qualifiedTarget.targetModule].sourceIndex => targetSource
                        prepared.package.ranges[targetSource] => targetRange
                        qualifiedTarget.targetSymbol >= 0 and qualifiedTarget.targetSymbol < targetRange.symbolCount
                            -> if {
                                prepared.package.symbols[targetRange.symbolStart + qualifiedTarget.targetSymbol] => declaration
                                declaration.kind == 7 -> if {
                                    InterpolationFunctionTarget { sourceModule: targetSource, symbol: qualifiedTarget.targetSymbol } -> return
                                }
                            }
                    }
            }
        }
    prepared.package.sources[sourceModule] -> slice(call.callNameStart, call.callNameLength) => path
    UIntSize(0) => dot!
    dot! < call.callNameLength and (path -> byte(dot!)) != 46
        -> while { dot! + 1 => dot! }
    dot! == call.callNameLength -> if {
        prepared.package -> calls.sourceFunctionCandidates(prepared.modules, prepared.resolvedImports, sourceModule, path) => candidates
        (candidates -> len) == 1 -> if {
            InterpolationFunctionTarget { sourceModule: candidates[0].sourceModule, symbol: candidates[0].symbol } -> return
        }
        unresolved -> return
    }
    dot! == 0 or dot! + 1 >= call.callNameLength
        -> if { unresolved -> return }
    path -> slice(UIntSize(0), dot!) => alias
    path -> slice(dot! + 1, call.callNameLength - dot! - 1) => name
    unresolved => target!
    prepared.resolvedImports -> each imported {
        imported.sourceModule == sourceModule and imported.status == 0
            -> if {
                prepared.imports[imported.edge] => edge
                prepared.package.ranges[sourceModule] => callerRange
                prepared.package.tokens[callerRange.tokenStart + edge.aliasToken] => aliasToken
                prepared.package.sources[sourceModule] -> slice(aliasToken.span.start, aliasToken.span.length) => importAlias
                importAlias == alias -> if {
                    prepared.package.ranges -> each range {
                        prepared.package.sources -> modules.sameLogicalAnalyzedSource(prepared.modules, imported.targetModule, range.sourceModule, prepared.package.tokens, prepared.package.ranges)
                            -> if {
                                0 => symbolIndex!
                                symbolIndex! < range.symbolCount -> while {
                                    prepared.package.symbols[range.symbolStart + symbolIndex!] => declaration
                                    declaration.kind == 7 and declaration.nameToken >= 0 and declaration.flags / 4 % 2 == 1
                                        and not (declaration -> symbols.hasQualifiedFunctionName(prepared.package.tokens, range.tokenStart, range.tokenCount))
                                        -> if {
                                            prepared.package.tokens[range.tokenStart + declaration.nameToken] => nameToken
                                            prepared.package.sources[range.sourceModule] -> slice(nameToken.span.start, nameToken.span.length) => declarationName
                                            declarationName == name -> if {
                                                target!.symbol >= 0 -> if { unresolved -> return }
                                                InterpolationFunctionTarget { sourceModule: range.sourceModule, symbol: symbolIndex! } => target!
                                            }
                                        }
                                    symbolIndex! + 1 => symbolIndex!
                                }
                            }
                    }
                }
            }
    }
    target!
}

# The parser retains the constructor type AST and exact variant span. Its
# canonical TypeReference is resolved with ordinary source types, before this pass.
emptyInterpolationArrayFact: -> InterpolationArrayFact {
    InterpolationArrayFact { typeId: -1, elementTypeId: -1, valueAst: -1,
        dynamic: false, bounded: false, storageLength: -1, elementCount: 0,
        status: 1, diagnosticNode: -1, diagnosticContext: 0, contextNode: -1, expectedTypeId: -1, actualTypeId: -1 }
}

arrayLiteralUnsupportedElement types: ref [typeIds.SemanticType; ~], elementTypeId: Int, dynamic: Bool -> Bool {
    elementTypeId < 0 or elementTypeId >= (types -> len)
        -> if { true -> return }
    types[elementTypeId] => element
    element.kind == 1 and element.origin == 1 and element.symbol == 0
        -> if { true -> return }
    # Bounded inline owners are values in an ordinary literal. Explicit typed
    # empties keep their separate constructor admission below.
    element.kind == 2 or element.kind == 4 or element.kind == 5
        or (dynamic and (element.kind == 12 or element.kind == 13))
        -> if { true -> return }
