{
  "schemaVersion": 1,
  "scope": "Same frozen Linux readInt program. Existing CSharp unsigned decimal parser, whitespace and 64-byte read semantics preserved. No new signed/range promises.",
  "cases": [
    {
      "id": "normal",
      "stdin": "42\n",
      "redirect": "",
      "exit": 0,
      "stdout": "number?42\n",
      "stderr": ""
    },
    {
      "id": "eof",
      "stdin": "",
      "redirect": "",
      "exit": 1,
      "stdout": "number?",
      "stderr": ""
    },
    {
      "id": "invalid",
      "stdin": "abc\n",
      "redirect": "",
      "exit": 1,
      "stdout": "number?",
      "stderr": ""
    },
    {
      "id": "whitespace-only",
      "stdin": " \t\r\n",
      "redirect": "",
      "exit": 1,
      "stdout": "number?",
      "stderr": ""
    },
    {
      "id": "padded",
      "stdin": " \t42 \r\n",
      "redirect": "",
      "exit": 0,
      "stdout": "number?42\n",
      "stderr": ""
    },
    {
      "id": "invalid-prefix",
      "stdin": "x42\n",
      "redirect": "",
      "exit": 1,
      "stdout": "number?",
      "stderr": ""
    },
    {
      "id": "invalid-suffix",
      "stdin": "42x\n",
      "redirect": "",
      "exit": 1,
      "stdout": "number?",
      "stderr": ""
    },
    {
      "id": "two-values",
      "stdin": "42 7\n",
      "redirect": "",
      "exit": 1,
      "stdout": "number?",
      "stderr": ""
    },
    {
      "id": "digits-at-eof",
      "stdin": "42",
      "redirect": "",
      "exit": 0,
      "stdout": "number?42\n",
      "stderr": ""
    },
    {
      "id": "read-error",
      "stdin": "",
      "redirect": " <&-",
      "exit": 1,
      "stdout": "number?",
      "stderr": ""
    },
    {
      "id": "prompt-failure",
      "stdin": "42\n",
      "redirect": " > /dev/full",
      "exit": 1,
      "stdout": "",
      "stderr": ""
    }
  ]
