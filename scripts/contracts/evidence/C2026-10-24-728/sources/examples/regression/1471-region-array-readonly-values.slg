readInteger value: ref Int -> Int {
    true -> if {
        [value,; ~] => items
        items[0] -> return
    }
    0
}

readAdditional flag: Bool, value: ref Int -> Int {
    flag -> if {
        [value, 12; ~] => items
        items[0] + items[1] -> return
    }
    0
}

readBoolean value: ref Bool -> Bool {
    true -> if {
        [value, false] => items
        items[0] -> return
    }
    false
}

main {
    11 => number
    number -> readInteger -> println
    true -> readAdditional(number) -> println
    true => enabled
    enabled -> readBoolean -> println
}
