import sollang.compiler.ast as ast
import sys.file as file

main {
    file.mapText("examples/regression/1471-region-array-readonly-values.slg")
        -> ast.lowerSource => nodes
    0 => index!
    index! < (nodes -> len) -> while {
        nodes[index!] => node
        "node=$(index!),kind=$(node.kind),parent=$(node.parent),start=$(node.start),length=$(node.length)" -> println
        index! + 1 => index!
    }
}
