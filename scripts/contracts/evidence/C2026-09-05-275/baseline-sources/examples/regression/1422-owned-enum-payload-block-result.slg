make: -> Result<[Int; ~], Int> {
    [11, 22; ~] -> Result<[Int; ~], Int>.Ok
}

unwrap: -> [Int; ~] {
    make() -> when {
        Ok(values) { values }
        Err(_) { [Int; ~] }
    }
}

main {
    unwrap() => first
    "temporary=$(first[1])" -> println
    make() => outcome
    outcome -> when {
        Ok(values) { values }
        Err(_) { [Int; ~] }
    } => second
    "named=$(second[0])" -> println
}
