read value: Int, p0: ref [Int; ~], p1: ref [Int; ~], p2: ref [Int; ~], p3: ref [Int; ~], p4: ref [Int; ~], p5: ref [Int; ~], p6: ref [Int; ~], p7: ref [Int; ~], p8: ref [Int; ~], p9: ref [Int; ~], p10: ref [Int; ~], p11: ref [Int; ~], p12: ref [Int; ~], p13: ref [Int; ~], p14: ref [Int; ~] -> Int {
    value + p14[0]
}

run values: [Int; ~], p0: ref [Int; ~], p1: ref [Int; ~], p2: ref [Int; ~], p3: ref [Int; ~], p4: ref [Int; ~], p5: ref [Int; ~], p6: ref [Int; ~], p7: ref [Int; ~], p8: ref [Int; ~], p9: ref [Int; ~], p10: ref [Int; ~], p11: ref [Int; ~], p12: ref [Int; ~], p13: ref [Int; ~], p14: ref [Int; ~] -> [Int; ~] {
    values -> parallel value { value -> read(p0, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, p14) } => output
    output
}

main {
    [40; ~] => offset
    [2; ~] -> run(offset, offset, offset, offset, offset, offset, offset, offset, offset, offset, offset, offset, offset, offset, offset) => result
    "$(result[0])" -> println
}
