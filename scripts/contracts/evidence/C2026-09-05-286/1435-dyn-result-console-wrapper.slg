struct Live { marker: Int }
struct Dead { marker: Int }

trait Value {
    get: self -> Int
}

helper: -> Int => 7

impl Value for Live {
    get: self -> Int => helper()
}

impl Value for Dead {
    get: self -> Int => 99
}

unused: -> dyn Value {
    Dead { marker: 0 } -> dyn<Value>
}

main {
    Live { marker: 0 } -> dyn<Value> => value
    value -> Value.get -> println
}
