struct Meter { value: Int }
impl Meter { len: self -> Text => "named" }

run: -> Result<Unit, Int> uses Console {
    Meter { value: 7 } => meter
    "value=$((meter -> len)?)" -> println
    Result<Unit, Int>.Ok
}

main {
    run() -> when {
        Ok(done) { }
        Err(error) { "unexpected=$error" -> println }
    }
}
