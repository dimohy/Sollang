import sollang.compiler.llvm.emitter.text_output_runtime as outputRuntime
import sys.process as process
import sys.text as text

main {
    process.arguments() => arguments
    (arguments -> len) != 2 -> if { process.exit(1) }
    (arguments[1] -> text.compareOrdinal("parallel")) == 0
        -> outputRuntime.emitLinuxTextRuntime(true)
}
