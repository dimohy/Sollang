first: -> Int uses Console {
    "first" -> println
    1
}

second: -> Int uses Console {
    "second" -> println
    2
}

condition left: Int, right: Int -> Bool => left > right

struct Pair { left: Int, right: Int }

conditionPair pair: Pair -> Bool => pair.left > pair.right

main {
    conditionPair(Pair { left: first(), right: second() }) -> while {
        "unexpected" -> println
    }
    "done" -> println
}
