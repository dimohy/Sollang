first: -> Int uses Console {
    "first" -> println
    1
}

second: -> Int uses Console {
    "second" -> println
    2
}

condition left: Int, right: Int -> Bool => left > right

exercise: -> Unit uses Console {
    condition(first(), second()) -> while {
        "unexpected" -> println
    }
    "done" -> println
}

main {
    exercise()
}
