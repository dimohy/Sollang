first: -> Int uses Console {
    "first" -> println
    1
}

second: -> Int uses Console {
    "second" -> println
    2
}

condition left: Int, right: Int -> Bool => left > right

conditionArray values: [Int; ~] -> Bool => values[0] > values[1]

main {
    conditionArray([first(), second(); ~]) -> while {
        "unexpected" -> println
    }
    "done" -> println
}
