main {
    "artifacts/scratch/resume-20261006-owner-continuation22/file-scalar11819.bin" => path
    file.openWrite(path) -> when {
        Result<file.FileWriter, Text>.Ok(writer) {
            writer -> writeAtAsync(Int8(-7), 0) => task0
            task0 -> await -> ok -> println
            writer -> writeAtAsync<UInt8>(255, 16) => task1
            task1 -> await -> ok -> println
            writer -> writeAtAsync(Int16(-1234), 32) => task2
            task2 -> await -> ok -> println
            writer -> writeAtAsync<UInt16>(65535, 48) => task3
            task3 -> await -> ok -> println
            writer -> writeAtAsync(-123456, 64) => task4
            task4 -> await -> ok -> println
            writer -> writeAtAsync<UInt32>(4294967295, 80) => task5
            task5 -> await -> ok -> println
            writer -> writeAtAsync(Long(-1234567890123), 96) => task6
            task6 -> await -> ok -> println
            writer -> writeAtAsync<UInt64>(18446744073709551615, 112) => task7
            task7 -> await -> ok -> println
            writer -> writeAtAsync(Size(-7), 128) => task8
            task8 -> await -> ok -> println
            writer -> writeAtAsync(UIntSize(7), 144) => task9
            task9 -> await -> ok -> println
            writer -> writeAtAsync(1.25, 160) => task10
            task10 -> await -> ok -> println
            writer -> writeAtAsync(Double(1.5), 176) => task11
            task11 -> await -> ok -> println
            writer -> writeAtAsync(CodePoint(65), 192) => task12
            task12 -> await -> ok -> println
            writer -> writeAtAsync(true, 208) => task13
            task13 -> await -> ok -> println
        }
        Result<file.FileWriter, Text>.Err(error) => error -> println
    }
    file.openRead(path) -> when {
        Result<file.File, Text>.Ok(reader) {
            reader -> readAt<Int8>(0) -> check0 -> println
            reader -> readAt<UInt8>(16) -> check1 -> println
            reader -> readAt<Int16>(32) -> check2 -> println
            reader -> readAt<UInt16>(48) -> check3 -> println
            reader -> readAt<Int>(64) -> check4 -> println
            reader -> readAt<UInt32>(80) -> check5 -> println
            reader -> readAt<Long>(96) -> check6 -> println
            reader -> readAt<UInt64>(112) -> check7 -> println
            reader -> readAt<Size>(128) -> check8 -> println
            reader -> readAt<UIntSize>(144) -> check9 -> println
            reader -> readAt<Float32>(160) -> check10 -> println
            reader -> readAt<Double>(176) -> check11 -> println
            reader -> readAt<CodePoint>(192) -> check12 -> println
            reader -> readAt<Bool>(208) -> check13 -> println
        }
        Result<file.File, Text>.Err(error) => error -> println
    }
}
