import sys.file as file

ok result: Result<Unit, Text> -> Bool => result -> when {
    Result<Unit, Text>.Ok(done) => true
    Result<Unit, Text>.Err(error) => false
}

check0 result: Result<Option<Int8>, Text> -> Bool => result -> when {
    Result<Option<Int8>, Text>.Ok(option) => option -> when {
        Option<Int8>.Some(value) => value == -7
        Option<Int8>.None => false
    }
    Result<Option<Int8>, Text>.Err(error) => false
}

