                            leftTypeId >= 0 and rightTypeId >= 0 and leftTypeId != rightTypeId
                                -> if {
                                    resolved.types[leftTypeId] => leftType
                                    leftType.kind == 1 and leftType.origin == 1
                                        and ((leftType.symbol >= 2 and leftType.symbol <= 13)
                                        or (leftType.symbol >= 19 and leftType.symbol <= 22))
                                        -> if {
                                            package.nodes[rightGlobal] => rightOperand
                                            ExpressionOperandDiagnostic {
                                                code: 16
                                                sourceModule: sourceIndex!
                                                astNode: astIndex!
                                                operandAst: rightGlobal - range.astStart
                                                operatorKind: logical.operatorKind
                                                locationOffset: rightOperand.start
                                                operandTypeSymbol: leftType.symbol
                                                operandTypeId: rightTypeId
                                                firstTypeId: -1
                                            } => candidate
                                            package -> expressionDiagnosticPrecedes(resolved.fields, candidate, selected!)
                                                -> if { candidate => selected! }
                                        }
                                }
                        }
                }
            }
            (logical.kind == 24 or logical.kind == 25)
                and logical.payloadToken >= 0 and logical.payloadToken < range.tokenCount
                -> if {
                    package.tokens[range.tokenStart + logical.payloadToken].span.start => operatorStart
                    -1 => leftAst!
                    -1 => rightAst!
                    0 => childIndex!
                    childIndex! < range.astCount -> while {
                        package.nodes[range.astStart + childIndex!] => child
                        child.parent == astIndex! -> if {
                            child.start < operatorStart and leftAst! < 0 -> if { childIndex! => leftAst! }
                            child.start > operatorStart and rightAst! < 0
                                -> if { childIndex! => rightAst! }
                        }
                        childIndex! + 1 => childIndex!
                    }
                    leftAst! >= 0 and rightAst! >= 0 -> if {
                        typeIdByAst![range.astStart + leftAst!] => leftTypeId
                        typeIdByAst![range.astStart + rightAst!] => rightTypeId
                        leftTypeId >= 0 and rightTypeId >= 0 -> if {
                            resolved.types[leftTypeId] => leftType
                            resolved.types[rightTypeId] => rightType
                            leftType.kind == 1 and leftType.origin == 1 and leftType.symbol == 23 => leftBool
                            rightType.kind == 1 and rightType.origin == 1 and rightType.symbol == 23 => rightBool
                            0 => failureCode!
                            not leftBool -> if { 1 => failureCode! } else {
                                not rightBool -> if { 2 => failureCode! }
                            }
                            failureCode! > 0 -> if {
                                failureCode! == 1 -> if { leftAst! } else { rightAst! } => operandAst
                                package -> logicalOperandOffset(sourceIndex!, operandAst) => locationOffset
                                ExpressionOperandDiagnostic {
                                    code: failureCode!
                                    sourceModule: sourceIndex!
                                    astNode: astIndex!
                                    operandAst: operandAst
                                    operatorKind: logical.operatorKind
                                    locationOffset: locationOffset
                                    operandTypeSymbol: -1
                                    operandTypeId: -1
                                    firstTypeId: -1
                                } => candidate
                                package -> expressionDiagnosticPrecedes(resolved.fields, candidate, selected!)
                                    -> if { candidate => selected! }
                            }
                        }
                    }
                }
            astIndex! + 1 => astIndex!
        }
        sourceIndex! + 1 => sourceIndex!
    }
    # Reuse the canonical child index to preserve final function/block values.
    # A main body has statement slots only; CST identity keeps operands,
    # bindings and call arguments outside this admission check.
    package.ranges -> each range {
        0 => statementIndex!
        statementIndex! < range.astCount -> while {
            package.nodes[range.astStart + statementIndex!] => statement
            typeIdByAst![range.astStart + statementIndex!] => statementTypeId
            statement.flags / 524288 % 2 == 1 and statement.parent >= 0
                and statementTypeId >= 0 and statementTypeId < (resolved.types -> len)
                -> if {
                    package.nodes[range.astStart + statement.parent] => parent
                    parent.kind == 0 or parent.kind == 7 or parent.kind == 8
                        or parent.kind == 31 or parent.kind == 43
                        -> if {
                            (parent.kind == 7 or parent.kind == 31 or parent.kind == 43)
                                and lastChildByAst![range.astStart + statement.parent] == range.astStart + statementIndex! => finalValue
                            resolved.types[statementTypeId] => statementType
                            statementType.kind == 1 and statementType.origin == 1
                                and statementType.symbol == 0 => isUnit
                            selected!.code > 0 and selected!.sourceModule == range.sourceModule
                                and (package -> declarationAncestor(range.sourceModule, statementIndex!, selected!.astNode)) => ownsExistingError
                            not finalValue and not isUnit and not ownsExistingError
                                and (prepared -> declarationBodyIsActive(resolved, range.sourceModule, statementIndex!))
                                -> if {
                                    ExpressionOperandDiagnostic {
                                        code: 31
                                        sourceModule: range.sourceModule
                                        astNode: statementIndex!
                                        operandAst: statementIndex!
                                        operatorKind: statement.kind == 10 -> if { 1 } else { 0 }
                                        locationOffset: statement.start
                                        operandTypeSymbol: -1
                                        operandTypeId: statementTypeId
                                        firstTypeId: -1
                                    } => candidate
                                    package -> expressionDiagnosticPrecedes(resolved.fields, candidate, selected!)
                                        -> if { candidate => selected! }
                                }
                        }
                }
            statementIndex! + 1 => statementIndex!
        }
    }

    # Check the committed callee against all seven closed caller capabilities.
    0 => effectCallIndex!
    effectCallIndex! < (prepared.calls -> len) -> while {
        prepared.calls[effectCallIndex!] => call
        (call.status == 0 or call.status == 1 or call.status == 3) and call.sourceModule >= 0
            and call.sourceModule < (package.ranges -> len)
            -> if {
                package.ranges[call.sourceModule] => range
                call.callAst >= 0 and call.callAst < range.astCount
                    -> if {
                        range.astStart + call.callAst => globalCall
                        prepared -> effects.missingCallEffect(declaredEffects, call) => requiredEffect
                        prepared -> effects.disallowedMainOnlyCall(declaredEffects, call) => mainOnly
                        false => privateAlias!
                        (call.status == 1 or call.status == 3) and call.functionSymbol >= 0
                            and call.targetSourceModule >= 0 and call.targetSourceModule < (package.ranges -> len)
                            -> if {
                                package.ranges[call.targetSourceModule] => targetRange
                                call.functionSymbol < targetRange.symbolCount
                                    -> if {
                                        package.symbols[targetRange.symbolStart + call.functionSymbol] => target
                                        target.kind == 7 or target.kind == 31 or target.kind == 36 => privateAlias!
                                    }
                            }
                        privateAlias! => privateAlias
                        (privateAlias or requiredEffect > 0 or mainOnly)
                            and (prepared -> declarationBodyIsActive(resolved, call.sourceModule, call.callAst))
                            -> if {
                                -1 => pathAst!
                                package.nodes[globalCall].kind == 10 -> if {
                                    prepared.directFlowTargetPathByAst[globalCall] => pathAst!
                                } else {
                                    firstChildByAst![globalCall] => child!
                                    child! >= 0 and pathAst! < 0 -> while {
                                        package.nodes[child!].kind == 16 -> if {
                                            child! - range.astStart => pathAst!
                                        }
                                        nextChildByAst![child!] => child!
                                    }
                                }
                                pathAst! >= 0 -> if {
                                    package.nodes[range.astStart + pathAst!] => path
                                    path.start => locationOffset!
                                    mainOnly and not privateAlias and requiredEffect == 0
                                        -> if {
                                            package -> expressionDiagnosticOffset(sourceAstByExpression, call.sourceModule, call.callAst) => locationOffset!
                                        }
                                    ExpressionOperandDiagnostic {
                                        code: privateAlias -> if { 47 } else { requiredEffect > 0 -> if { 32 } else { 48 } }
                                        sourceModule: call.sourceModule
                                        astNode: call.callAst
                                        operandAst: pathAst!
                                        operatorKind: effectCallIndex!
                                        locationOffset: locationOffset!
                                        operandTypeSymbol: requiredEffect
                                        operandTypeId: -1
                                        firstTypeId: -1
                                    } => candidate
                                    package -> expressionDiagnosticPrecedes(resolved.fields, candidate, selected!)
                                        -> if { candidate => selected! }
                                }
                            }
                    }
            }
        effectCallIndex! + 1 => effectCallIndex!
    }


    selected!
}

# Return admission belongs to the nearest lexical function, including local
# functions. Match C# before lowering the returned value or emitting LLVM.
public returnFromAsyncFunction nodes: ref [ast.AstNode; ~], range: analysis.SourceAnalysisRange, returnAst: Int -> Bool {
    returnAst >= 0 and returnAst < range.astCount
        -> unless { false -> return }
    nodes[range.astStart + returnAst] => statement
    statement.kind == 47 -> unless { false -> return }
    statement.parent => owner!
    owner! >= 0 and owner! < range.astCount -> while {
        nodes[range.astStart + owner!] => declaration
        declaration.kind == 7 or declaration.kind == 31 or declaration.kind == 8
            -> if { declaration.flags / 8 % 2 == 1 -> return }
        declaration.parent => owner!
    }
    false
}
