convert value: Result<Int, Int> -> Result<Int, Int> {
    value -> when {
        Ok(item) { item + 1 -> Result<Int, Int>.Ok }
        Err(error) { error -> Result<Int, Int>.Err }
    }? => converted
    converted * 2 -> Result<Int, Int>.Ok
}

main {
    3 -> Result<Int, Int>.Ok -> convert -> when {
        Ok(value) { "ok=$value" -> println }
        Err(error) { "unexpected=$error" -> println }
    }
    9 -> Result<Int, Int>.Err -> convert -> when {
        Ok(value) { "unexpected=$value" -> println }
        Err(error) { "error=$error" -> println }
    }
}
