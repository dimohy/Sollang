import sys.process as process

main {
    process.command("artifacts/scratch/resume-20261006-owner-continuation22/read11969-csharp-child/read-child/probe.exe") => command!
    command! -> arg("--child")
    command! -> stdin(process.Input.File("artifacts/scratch/resume-20261006-owner-continuation22/read11968-stdin.txt"))
    command! -> status -> when {
        Result<process.ExitStatus, Text>.Ok(status) { "status=$(status -> exitCode)" -> println }
        Result<process.ExitStatus, Text>.Err(error) { "error=$error" -> println }
    }
}
