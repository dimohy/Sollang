import sys.process as process

main {
    process.arguments() -> len => count
    [Text; ~] => names!
    UIntSize(0) => index!
    index! < count -> while {
        names! -> push("SOLLANG_TEST_VALUE")
        index! + UIntSize(1) => index!
    }
    names! -> parallel name {
        process.environment(name) -> when {
            Option<Text>.None => UIntSize(0)
            Option<Text>.Some(value) => value -> len
        }
    } => lengths
    "count=$(lengths -> len)" -> println
}
