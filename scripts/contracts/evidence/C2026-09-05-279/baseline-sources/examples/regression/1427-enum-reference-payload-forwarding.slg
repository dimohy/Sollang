enum IntView {
    Empty
    Ref(ref Int)
}

same value: ref Int -> ref Int { value }
read value: ref Int -> Int { value }

inspect view: IntView -> Int {
    view -> when {
        Empty => 0
        Ref(value) => value -> read
    }
}

main {
    40 => owner
    IntView.Ref(owner -> same) => stored
    stored -> when {
        Empty => 0
        Ref(value) => value -> read
    } => direct
    {1: IntView.Ref(owner -> same)} => values
    values[1] -> inspect => indexed
    "direct=$direct,indexed=$indexed" -> println
}
