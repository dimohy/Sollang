{
  "schemaVersion": 1,
  "scope": "Independent UTF16 logical-line positions and exact minimal CRLF-safe formatting edits; LF, CRLF and CR each separate one logical source line",
  "cases": [
    {
      "id": "diagnostic-lf",
      "kind": "diagnostic",
      "source": "main {\n    @\n}\n",
      "expected": [
        {
          "range": {
            "start": {
              "line": 1,
              "character": 4
            },
            "end": {
              "line": 1,
              "character": 5
            }
          },
          "severity": 1,
          "source": "sollang",
          "message": "lex error at 2:5: unexpected character '@'"
        }
      ]
    },
    {
      "id": "formatting-lf",
      "kind": "formatting",
      "source": "main {\n    \"ok\" -> println\n}\n",
      "expected": []
    },
    {
      "id": "diagnostic-crlf",
      "kind": "diagnostic",
      "source": "main {\r\n    @\r\n}\r\n",
      "expected": [
        {
          "range": {
            "start": {
              "line": 1,
              "character": 4
            },
            "end": {
              "line": 1,
              "character": 5
            }
          },
          "severity": 1,
          "source": "sollang",
          "message": "lex error at 2:5: unexpected character '@'"
        }
      ]
    },
    {
      "id": "formatting-crlf",
      "kind": "formatting",
      "source": "main {\r\n    \"ok\" -> println\r\n}\r\n",
      "expected": [
        {
          "range": {
            "start": {
              "line": 0,
              "character": 6
            },
            "end": {
              "line": 3,
              "character": 0
            }
          },
          "newText": "\n    \"ok\" -> println\n}\n"
        }
      ]
    },
    {
      "id": "diagnostic-cr",
      "kind": "diagnostic",
      "source": "main {\r    @\r}\r",
      "expected": [
        {
          "range": {
            "start": {
              "line": 1,
              "character": 4
            },
            "end": {
              "line": 1,
              "character": 5
            }
          },
          "severity": 1,
          "source": "sollang",
          "message": "lex error at 2:5: unexpected character '@'"
        }
      ]
    },
    {
      "id": "formatting-cr",
      "kind": "formatting",
      "source": "main {\r    \"ok\" -> println\r}\r",
      "expected": [
        {
          "range": {
            "start": {
              "line": 0,
              "character": 6
            },
            "end": {
              "line": 3,
              "character": 0
            }
          },
          "newText": "\n    \"ok\" -> println\n}\n"
        }
      ]
    }
  ]
