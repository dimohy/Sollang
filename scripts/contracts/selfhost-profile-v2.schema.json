{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sollang.dev/schemas/selfhost-profile-v2.schema.json",
  "title": "Sollang self-host compiler phase profile v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "measurement",
    "semanticBaseline",
    "sampleCount",
    "seedMode",
    "target",
    "optimization",
    "environment",
    "fixtureRoots",
    "expandedSourceCount",
    "compilerFingerprint",
    "fixtureFingerprint",
    "semanticPreparationMs",
    "expressionTypeIdsTotalMs",
    "expressionTypeIdsDeltaMs",
    "typedIrTotalMs",
    "typedIrDeltaMs",
    "postExpressionTypeTypedIrDeltaMs",
    "artifactTotalMs",
    "artifactEncodeDeltaMs"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "mode": { "enum": ["expression-types", "typed-ir", "artifacts"] },
    "measurement": { "const": "single-wall-clock" },
    "semanticBaseline": { "const": "prepare-only" },
    "sampleCount": { "const": 1 },
    "seedMode": { "enum": ["Slg", "ManagedRecovery"] },
    "target": { "enum": ["windows", "linux"] },
    "optimization": { "enum": ["O0", "O1"] },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["osDescription", "processArchitecture", "processorCount"],
      "properties": {
        "osDescription": { "type": "string", "minLength": 1 },
        "processArchitecture": { "type": "string", "minLength": 1 },
        "processorCount": { "type": "integer", "minimum": 1 }
      }
    },
    "fixtureRoots": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "expandedSourceCount": { "type": "integer", "minimum": 1 },
    "compilerFingerprint": { "$ref": "#/$defs/sha256" },
    "fixtureFingerprint": { "$ref": "#/$defs/sha256" },
    "semanticPreparationMs": { "$ref": "#/$defs/milliseconds" },
    "expressionTypeIdsTotalMs": { "$ref": "#/$defs/milliseconds" },
    "expressionTypeIdsDeltaMs": { "$ref": "#/$defs/signedMilliseconds" },
    "typedIrTotalMs": { "$ref": "#/$defs/nullableMilliseconds" },
    "typedIrDeltaMs": { "$ref": "#/$defs/nullableSignedMilliseconds" },
    "postExpressionTypeTypedIrDeltaMs": { "$ref": "#/$defs/nullableSignedMilliseconds" },
    "artifactTotalMs": { "$ref": "#/$defs/nullableMilliseconds" },
    "artifactEncodeDeltaMs": { "$ref": "#/$defs/nullableSignedMilliseconds" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "milliseconds": { "type": "integer", "minimum": 0 },
    "signedMilliseconds": { "type": "integer" },
    "nullableMilliseconds": {
      "anyOf": [
        { "$ref": "#/$defs/milliseconds" },
        { "type": "null" }
      ]
    },
    "nullableSignedMilliseconds": {
      "anyOf": [
        { "$ref": "#/$defs/signedMilliseconds" },
        { "type": "null" }
      ]
    }
  }
}
