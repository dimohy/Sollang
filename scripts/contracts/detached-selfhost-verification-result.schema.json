{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Detached self-host verification completion record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "verification",
    "executionMode",
    "supervisorPid",
    "startedAtUtc",
    "completedAtUtc",
    "durationMilliseconds",
    "exitCode",
    "status",
    "failureIds",
    "logPath",
    "standardErrorPath",
    "cancellationRequestPath",
    "targetProcessId",
    "orphanProcessIds"
  ],
  "properties": {
    "schemaVersion": { "enum": [1, 2, 3] },
    "runId": { "type": "string", "minLength": 1 },
    "verification": { "enum": ["Stage2", "Stage3", "Stage2Linux", "Stage3Linux", "BrowserStage2", "Incremental", "C341Focused", "C341FinalSelfhost", "C394FinalCandidate", "ExpressionBatch", "PortableMemoryIo", "TypedBlockMutableBorrow", "BinaryChecksum", "GzipSelfhost", "AdditionalMoveOwnership", "GenericTypeContexts", "SelfhostDeferredTextStorage", "SelfhostC424NestedWholeOwner", "LinuxOwnershipStorage", "ManagedHost", "Probe"] },
    "executionMode": { "const": "detached-supervisor" },
    "supervisorPid": { "type": "integer", "minimum": 1 },
    "startedAtUtc": { "type": "string", "format": "date-time" },
    "completedAtUtc": { "type": "string", "format": "date-time" },
    "durationMilliseconds": { "type": "integer", "minimum": 0 },
    "exitCode": { "type": "integer" },
    "status": { "enum": ["passed", "failed", "cancelled"] },
    "failureIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "logPath": { "type": "string", "minLength": 1 },
    "standardErrorPath": { "type": "string", "minLength": 1 },
    "cancellationRequestPath": { "type": "string", "minLength": 1 },
    "cancellationAcknowledgementPath": { "type": "string", "minLength": 1 },
    "cancellationAcknowledgement": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["schemaVersion", "runId", "targetProcessId", "observedAtUtc"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "targetProcessId": { "type": "integer", "minimum": 1 },
        "observedAtUtc": { "type": "string", "format": "date-time" }
      }
    },
    "additionalMoveOwnershipCompiler": { "type": ["string", "null"], "minLength": 1 },
    "additionalMoveOwnershipExpectedCompilerSha256": { "type": ["string", "null"], "pattern": "^[A-F0-9]{64}$" },
    "additionalMoveOwnershipOutputDirectory": { "type": ["string", "null"], "minLength": 1 },
    "focusedResultPath": { "type": ["string", "null"], "minLength": 1 },
    "focusedResultSha256": { "type": ["string", "null"], "pattern": "^[A-F0-9]{64}$" },
    "targetProcessId": { "type": ["integer", "null"], "minimum": 1 },
    "targetExitCode": { "type": ["integer", "null"] },
    "processAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "completed", "snapshotCount", "observedProcessIds"],
      "properties": {
        "method": { "const": "observed-pid-creation-time-snapshots" },
        "completed": { "type": "boolean" },
        "snapshotCount": { "type": "integer", "minimum": 0 },
        "observedProcessIds": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "orphanProcessIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "verification": { "const": "AdditionalMoveOwnership" } } },
      "then": {
        "required": ["additionalMoveOwnershipCompiler", "additionalMoveOwnershipExpectedCompilerSha256", "additionalMoveOwnershipOutputDirectory"],
        "properties": {
          "additionalMoveOwnershipCompiler": { "type": "string", "minLength": 1 },
          "additionalMoveOwnershipExpectedCompilerSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
          "additionalMoveOwnershipOutputDirectory": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": { "enum": ["C341FinalSelfhost", "C394FinalCandidate"] },
          "status": { "const": "passed" }
        },
        "required": ["verification", "status"]
      },
      "then": {
        "required": ["focusedResultPath", "focusedResultSha256"],
        "properties": {
          "focusedResultPath": { "type": "string", "minLength": 1 },
          "focusedResultSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
        }
      }
    },
    {
      "if": { "properties": { "schemaVersion": { "const": 3 } } },
      "then": {
        "required": ["processAudit", "targetExitCode", "cancellationAcknowledgementPath", "cancellationAcknowledgement"]
      }
    },
    {
      "if": { "properties": { "schemaVersion": { "enum": [2, 3] } } },
      "then": {
        "required": ["processAudit", "targetExitCode"],
        "allOf": [{
          "if": { "properties": { "status": { "enum": ["passed", "cancelled"] } } },
          "then": { "properties": { "processAudit": { "properties": {
            "completed": { "const": true },
            "snapshotCount": { "minimum": 1 },
            "observedProcessIds": { "minItems": 1 }
          } } } }
        }, {
          "if": { "properties": { "status": { "const": "passed" } } },
          "then": { "properties": { "targetExitCode": { "const": 0 } } }
        }]
      }
    },
    {
      "if": { "properties": { "status": { "const": "passed" } } },
      "then": {
        "properties": {
          "exitCode": { "const": 0 },
          "failureIds": { "maxItems": 0 },
          "orphanProcessIds": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": { "properties": { "exitCode": { "not": { "const": 0 } } } }
    },
    {
      "if": { "properties": { "status": { "const": "cancelled" } } },
      "then": {
        "properties": {
          "exitCode": { "not": { "const": 0 } },
          "failureIds": { "const": ["CANCELLATION_REQUESTED"] },
          "orphanProcessIds": { "maxItems": 0 },
          "targetExitCode": { "const": 130 },
          "cancellationAcknowledgement": { "type": "object" }
        }
      }
    }
  ]
}
