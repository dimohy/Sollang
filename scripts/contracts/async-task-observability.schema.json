{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "capabilityId", "implementationStatus", "module", "authority", "activation", "identity", "snapshot", "stateModel", "bounds", "close", "productionOffGate", "focusedInitialGate", "publicSurface", "forbidden", "probeMatrix", "denominators"],
  "properties": {
    "$schema": { "const": "async-task-observability.schema.json" },
    "schemaVersion": { "const": 1 },
    "capabilityId": { "const": "async-task-observability" },
    "implementationStatus": { "const": "contract-frozen" },
    "module": { "const": "std.async.diagnostics" },
    "authority": { "$ref": "#/$defs/stringMap" },
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "owner", "entry", "attachment", "propagation", "validation", "capacityOutcome", "default", "ambientRegistry", "schedulerSemanticChanges"],
      "properties": {
        "kind": { "const": "explicit-affine-instance" }, "owner": { "const": "DiagnosticSession" },
        "entry": { "type": "string", "minLength": 1 }, "attachment": { "type": "string", "minLength": 1 },
        "propagation": { "type": "string", "minLength": 1 }, "validation": { "type": "string", "minLength": 1 },
        "capacityOutcome": { "type": "string", "minLength": 1 },
        "default": { "const": "off" }, "ambientRegistry": { "const": false }, "schedulerSemanticChanges": { "const": false }
      }
    },
    "identity": { "$ref": "#/$defs/stringMap" },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["ownership", "ordering", "result", "allocation", "consistency", "terminalRetention", "locatorPresence", "recordFields", "suspensionLocator"],
      "properties": {
        "ownership": { "type": "string", "minLength": 1 }, "ordering": { "const": "ascending TaskId" },
        "result": { "type": "string", "minLength": 1 }, "allocation": { "const": "zero allocations per snapshot" },
        "consistency": { "type": "string", "minLength": 1 }, "terminalRetention": { "type": "string", "minLength": 1 },
        "locatorPresence": { "type": "string", "minLength": 1 },
        "recordFields": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "suspensionLocator": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "stateModel": {
      "type": "object", "additionalProperties": false,
      "required": ["lifecycle", "waitState", "validPairs", "runtimeStatusMapping"],
      "properties": {
        "lifecycle": { "$ref": "#/$defs/nonemptyUniqueStrings" }, "waitState": { "$ref": "#/$defs/nonemptyUniqueStrings" },
        "validPairs": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "type": "string" } },
        "runtimeStatusMapping": { "$ref": "#/$defs/stringMap" }
      }
    },
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["minimumTrackedTasks", "maximumTrackedTasks", "sessionAllocation", "saturation", "snapshotBound", "unboundedAllocation"],
      "properties": {
        "minimumTrackedTasks": { "const": 1 }, "maximumTrackedTasks": { "const": 65535 },
        "sessionAllocation": { "type": "string", "minLength": 1 }, "saturation": { "type": "string", "minLength": 1 },
        "snapshotBound": { "type": "string", "minLength": 1 }, "unboundedAllocation": { "const": false }
      }
    },
    "close": { "$ref": "#/$defs/stringMap" },
    "productionOffGate": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture", "taskControlBytes", "allocationCount", "releaseCount", "invalidReleaseCount", "required"],
      "properties": {
        "fixture": { "type": "string", "minLength": 1 }, "taskControlBytes": { "const": 152 },
        "allocationCount": { "const": 2 }, "releaseCount": { "const": 2 }, "invalidReleaseCount": { "const": 0 },
        "required": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "focusedInitialGate": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "canonicalLineFormat", "cases"],
      "properties": {
        "total": { "const": 4 },
        "canonicalLineFormat": { "type": "string", "minLength": 1 },
        "cases": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "source", "expectedOutput", "observationAuthority", "requiredEvidence"],
            "properties": {
              "id": { "enum": ["normal-parent-child-states", "normal-stable-id-transitions", "normal-suspension-locator", "production-off-zero-overhead"] },
              "source": { "type": "string", "pattern": "^scripts/probes/async-task-observability/.+\\.slg$" },
              "expectedOutput": { "type": "string", "pattern": "^scripts/probes/async-task-observability/.+\\.expected\\.txt$" },
              "observationAuthority": { "enum": ["runtime-exact-stdout", "llvm-metadata-plus-runtime-exact-stdout", "runtime-exact-stdout-plus-ir-and-allocation-audit"] },
              "locatorExpectation": {
                "type": "object", "additionalProperties": false,
                "required": ["token", "utf8ByteOffset", "line", "column"],
                "properties": {
                  "token": { "const": "await" }, "utf8ByteOffset": { "const": 2897 },
                  "line": { "const": 78 }, "column": { "const": 39 }
                }
              },
              "requiredEvidence": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "publicSurface": {
      "type": "object", "additionalProperties": false,
      "required": ["types", "signatures", "trackFailureType", "genericUserAdtRequired", "probeCanonicalFormatterPublic"],
      "properties": {
        "types": { "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "signatures": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "trackFailureType": { "const": "(T, TrackFailureKind) where T is Task<U>" },
        "genericUserAdtRequired": { "const": false },
        "probeCanonicalFormatterPublic": { "const": false }
      }
    },
    "forbidden": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "probeMatrix": {
      "type": "array", "minItems": 13, "maxItems": 13,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "class", "source", "expectation", "managed", "selfhost", "platforms"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "class": { "enum": ["normal", "boundary", "authority-negative", "production-off"] },
          "source": { "type": "string", "pattern": "^scripts/probes/async-task-observability/.+\\.slg$" },
          "expectation": { "enum": ["exact-stdout", "compiler-rejected", "exact-stdout-and-allocation-audit"] },
          "managed": { "const": true }, "selfhost": { "const": true },
          "platforms": { "type": "array", "uniqueItems": true, "items": { "enum": ["windows-x64", "linux-x64", "wasm32-browser"] } }
        }
      }
    },
    "denominators": {
      "type": "object", "additionalProperties": false,
      "required": ["contractStatic", "managed", "selfhost", "platform", "platformByTarget", "classes"],
      "properties": {
        "contractStatic": { "const": 14 }, "managed": { "const": 13 }, "selfhost": { "const": 13 }, "platform": { "const": 17 },
        "platformByTarget": {
          "type": "object", "additionalProperties": false, "required": ["windows-x64", "linux-x64", "wasm32-browser"],
          "properties": { "windows-x64": { "const": 8 }, "linux-x64": { "const": 8 }, "wasm32-browser": { "const": 1 } }
        },
        "classes": {
          "type": "object", "additionalProperties": false, "required": ["normal", "boundary", "authority-negative", "production-off"],
          "properties": { "normal": { "const": 3 }, "boundary": { "const": 5 }, "authority-negative": { "const": 4 }, "production-off": { "const": 1 } }
        }
      }
    }
  },
  "$defs": {
    "stringMap": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
    "nonemptyUniqueStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
