{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "managedExpressionInventoryTotal", "endToEndImplementedTotal", "endToEndPending", "authority", "mappings", "families", "fixtureCoverage", "earlyInvariant", "mapLowering", "mapBindingControls", "operatorTokenOwnership", "branchMaterialization", "contextMaterialization", "nestedStreamScheduling", "binaryWrapperControls", "focusedFixtures", "representativeFixtures"],
  "properties": {
    "schemaVersion": { "const": 9 },
    "status": { "enum": ["in-progress", "complete"] },
    "managedExpressionInventoryTotal": { "type": "integer", "minimum": 1 },
    "endToEndImplementedTotal": { "type": "integer", "minimum": 0 },
    "endToEndPending": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "Expression$" } },
    "authority": { "const": "syntax-shape-before-provisional-type" },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["managedExpression", "selfhostAstKinds", "typedIrKinds", "behavior", "policy", "policyStatus"],
        "properties": {
          "managedExpression": { "type": "string", "pattern": "Expression$" },
          "selfhostAstKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
          "typedIrKinds": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
          "behavior": { "enum": ["value", "control", "contextual", "compile-time", "pattern-only"] },
          "policy": { "type": "string", "minLength": 3 },
          "policyStatus": { "enum": ["shared", "shape-only", "duplicated-context"] }
        }
      }
    },
    "families": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "managedExpressions", "selfhostAstKinds", "selfhostPolicy"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "managedExpressions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "Expression$" } },
          "selfhostAstKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
          "selfhostPolicy": { "type": "string", "pattern": "^[A-Za-z][A-Za-z]+AstKind$" }
        }
      }
    },
    "fixtureCoverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["managedExpression", "fixture", "sourceFragments", "expectedOutputFragments"],
        "properties": {
          "managedExpression": { "type": "string", "pattern": "Expression$" },
          "fixture": { "type": "string", "minLength": 5 },
          "sourceFragments": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 2 }
          },
          "expectedOutputFragments": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "earlyInvariant": { "const": "S059" },
    "mapLowering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managedExpression", "astKind", "typedIrKind", "readOpcode", "writeOpcode", "readBuiltinSymbol", "writeBuiltinSymbol", "pathBuiltinSymbol", "offsetFlag", "lengthFlag", "fileSizeFlag", "flushRuntimeAlias", "flushReceiverBuiltinSymbol", "lexicalFlushWins", "earlyInvariant", "focusedFixtures"],
      "properties": {
        "managedExpression": { "const": "MapExpression" },
        "astKind": { "const": 49 },
        "typedIrKind": { "const": 9 },
        "readOpcode": { "const": -306 },
        "writeOpcode": { "const": -307 },
        "readBuiltinSymbol": { "const": 17 },
        "writeBuiltinSymbol": { "const": 18 },
        "pathBuiltinSymbol": { "const": 1 },
        "offsetFlag": { "const": 1 },
        "lengthFlag": { "const": 2 },
        "fileSizeFlag": { "const": 4 },
        "flushRuntimeAlias": { "const": -114 },
        "flushReceiverBuiltinSymbol": { "const": 18 },
        "lexicalFlushWins": { "const": true },
        "earlyInvariant": { "const": "S060" },
        "focusedFixtures": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "contains": { "const": "82-memory-mapped-bytes" },
          "items": { "enum": ["82-memory-mapped-bytes", "80-unicode-code-points"] }
        }
      }
    },
    "mapBindingControls": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mode", "producerCount", "producerKind", "producerOpcode", "producerBuiltinSymbol", "pathBuiltinSymbol", "flags", "optionBuiltinSymbols", "bindingMatchesProducer", "expectedInvalid"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "mode": { "enum": ["read", "write"] },
          "producerCount": { "type": "integer", "minimum": 0 },
          "producerKind": { "type": "integer", "minimum": -1 },
          "producerOpcode": { "type": "integer", "maximum": -1 },
          "producerBuiltinSymbol": { "type": "integer", "minimum": -1 },
          "pathBuiltinSymbol": { "type": "integer", "minimum": -1 },
          "flags": { "type": "integer", "minimum": 0, "maximum": 7 },
          "optionBuiltinSymbols": { "type": "array", "maxItems": 3, "items": { "type": "integer", "minimum": 0 } },
          "bindingMatchesProducer": { "type": "boolean" },
          "expectedInvalid": { "type": "boolean" }
        }
      }
    },
    "operatorTokenOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typeSyntaxAngles", "callArgumentsExcluded", "operatorlessEnvelope", "nestedComparisonControl"],
      "properties": {
        "typeSyntaxAngles": { "const": "type-annotation-plus-balanced-application-clause" },
        "callArgumentsExcluded": { "const": true },
        "operatorlessEnvelope": { "const": "omit" },
        "nestedComparisonControl": { "const": "Result<Bool, Text>.Ok(3 > 2)" }
      }
    },
    "branchMaterialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["armTypedIrKind", "sequentialBranchTypedIrKind", "parallelBranchTypedIrKind", "sharedAggregateEmitter", "sharedArmEmitter", "sharedParallelEmitter", "consumers", "controlRegionFixture", "nestedParallelControlFixture"],
      "properties": {
        "armTypedIrKind": { "const": 39 },
        "sequentialBranchTypedIrKind": { "const": 37 },
        "parallelBranchTypedIrKind": { "const": 38 },
        "sharedAggregateEmitter": { "const": "emitSequentialBranchAggregate" },
        "sharedArmEmitter": { "const": "emitSequentialBranchArmValue" },
        "sharedParallelEmitter": { "const": "emitParallelBranchValue" },
        "consumers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^selfhost/llvm/text/.+\\.slg$" }
        },
        "controlRegionFixture": { "const": "1704-selfhost-control-region-sequential-branch" },
        "nestedParallelControlFixture": { "const": "1218-ai-slg-best-practices" }
      }
    },
    "contextMaterialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rangeTypedIrKind", "sharedRangeEmitter", "rangeConsumers", "nestedControlFixture"],
      "properties": {
        "rangeTypedIrKind": { "const": 31 },
        "sharedRangeEmitter": { "const": "emitRangeValue" },
        "rangeConsumers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^selfhost/llvm/text/.+\\.slg$" }
        },
        "nestedControlFixture": { "const": "1218-ai-slg-best-practices" }
      }
    },
    "nestedStreamScheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sharedBodyEmitter", "regionDelegator", "ownershipClassifier", "mutableSlotPolicyField", "controlRegionFixture"],
      "properties": {
        "sharedBodyEmitter": { "const": "emitScheduledStreamBody" },
        "regionDelegator": { "const": "emitRegionStreamPipeline" },
        "ownershipClassifier": { "const": "regionOwnedStreamPipeline" },
        "mutableSlotPolicyField": { "const": "emitMutableSlots" },
        "controlRegionFixture": { "const": "1705-selfhost-control-region-stream" }
      }
    },
    "binaryWrapperControls": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nodes", "ownerAst", "irAsts", "expectedMissing"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "nodes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "parent", "start", "length"],
              "properties": {
                "kind": { "type": "integer", "minimum": 0 },
                "parent": { "type": "integer", "minimum": -1 },
                "start": { "type": "integer", "minimum": 0 },
                "length": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "ownerAst": { "type": "integer", "minimum": 0 },
          "irAsts": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
          "expectedMissing": { "type": "boolean" }
        }
      }
    },
    "focusedFixtures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 5 } },
    "representativeFixtures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 5 } }
  }
}
