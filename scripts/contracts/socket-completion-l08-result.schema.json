{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "status", "compilerSha256", "inputStable", "inputDrift", "inputHashes", "formatExitCode", "compileExitCode", "compileDiagnosticsClean", "llvmAsExitCode", "closureExitCode", "run", "orphanProcessIds", "irAssertions", "failureIds"],
  "properties": {
    "schemaVersion": { "const": 1 }, "caseId": { "const": "L08" }, "status": { "enum": ["passed", "failed"] }, "compilerSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "inputStable": { "type": "boolean" }, "inputDrift": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "inputHashes": { "type": "object", "minProperties": 12, "additionalProperties": { "type": "string", "pattern": "^[A-F0-9]{64}$" } },
    "formatExitCode": { "type": ["integer", "null"] }, "compileExitCode": { "type": ["integer", "null"] }, "compileDiagnosticsClean": { "type": "boolean" }, "llvmAsExitCode": { "type": ["integer", "null"] }, "closureExitCode": { "type": ["integer", "null"] },
    "run": { "type": "object", "additionalProperties": false, "required": ["exitCode", "peerSent", "stdout", "stderr"], "properties": {
      "exitCode": { "type": ["integer", "null"] }, "peerSent": { "type": "array", "items": { "type": "integer" } }, "stdout": { "type": "array", "items": { "type": "string" } }, "stderr": { "type": "string" }
    } },
    "orphanProcessIds": { "type": "array", "maxItems": 0, "items": { "type": "integer" } },
    "irAssertions": { "type": "object", "additionalProperties": false, "required": ["batchCapacityStored", "oneEventWaitBound", "registrationScopedScan", "oneShotRearm", "terminalReturnsToWait", "dequeueOwnerTransferVerified", "payloadCopyFree"], "properties": {
      "batchCapacityStored": { "type": "boolean" }, "oneEventWaitBound": { "type": "boolean" }, "registrationScopedScan": { "type": "boolean" }, "oneShotRearm": { "type": "boolean" }, "terminalReturnsToWait": { "type": "boolean" }, "dequeueOwnerTransferVerified": { "type": "boolean" }, "payloadCopyFree": { "type": "boolean" }
    } },
    "failureIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  },
  "allOf": [{ "if": { "properties": { "status": { "const": "passed" } } }, "then": { "properties": {
    "inputStable": { "const": true }, "inputDrift": { "maxItems": 0 }, "formatExitCode": { "const": 0 }, "compileExitCode": { "const": 0 }, "compileDiagnosticsClean": { "const": true }, "llvmAsExitCode": { "const": 0 }, "closureExitCode": { "const": 0 },
    "run": { "properties": { "exitCode": { "const": 0 }, "peerSent": { "const": [1, 1] }, "stdout": { "const": ["pending=true", "completion=true,count=1,state=true,len=1,keyByteMatch=true", "completion=true,count=1,state=true,len=1,keyByteMatch=true", "l08=complete"] }, "stderr": { "const": "" } } },
    "irAssertions": { "properties": { "batchCapacityStored": { "const": true }, "oneEventWaitBound": { "const": true }, "registrationScopedScan": { "const": true }, "oneShotRearm": { "const": true }, "terminalReturnsToWait": { "const": true }, "dequeueOwnerTransferVerified": { "const": true }, "payloadCopyFree": { "const": true } } },
    "failureIds": { "maxItems": 0 }
  } } }]
}
