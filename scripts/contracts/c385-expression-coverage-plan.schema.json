{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "managedCompiler", "selfhostCompiler", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "managedCompiler": { "$ref": "#/$defs/compiler" },
    "selfhostCompiler": { "$ref": "#/$defs/compiler" },
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 14,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["family", "fixture", "anchor", "occurrence", "selector", "proofMode", "astKind", "typedIrKind", "managedBatchResult", "selfhostBatchResult"],
        "properties": {
          "family": { "type": "string", "pattern": "^[A-Z][A-Za-z]+Expression$" },
          "fixture": { "type": "string", "pattern": "^[0-9a-z-]+$" },
          "anchor": { "type": "string", "minLength": 1 },
          "occurrence": { "type": "integer", "minimum": 0 },
          "selector": { "enum": ["exact", "smallest-containing"] },
          "proofMode": { "enum": ["direct", "folded-compile-time"] },
          "astKind": { "type": "integer", "minimum": 0 },
          "typedIrKind": { "type": "integer", "minimum": 0 },
          "managedBatchResult": { "type": "string", "minLength": 1 },
          "selfhostBatchResult": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "compiler": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
      }
    }
  }
}
