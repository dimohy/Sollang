{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sollang.dev/contracts/path-components.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "module", "scope", "styleAuthority", "reference", "surfaces", "limits", "componentKinds", "errorKinds", "factoryErrorPrecedence", "nextErrorPrecedence", "errorOffsets", "semantics", "referenceCases", "fixture", "acceptance"],
  "properties": {
    "$schema": { "const": "./path-components.schema.json" },
    "schemaVersion": { "const": 1 },
    "module": { "const": "stdlib/std/path.slg" },
    "scope": { "const": "bounded-utf8-lexical-components-over-borrowed-text" },
    "styleAuthority": { "const": "sys.path.Style" },
    "reference": { "const": "https://learn.microsoft.com/en-us/windows/win32/fileio/naming-a-file" },
    "surfaces": { "const": ["components", "Components.next", "Components.offset"] },
    "limits": { "const": ["maxInputBytes", "maxComponents", "maxComponentBytes"] },
    "componentKinds": { "const": ["PosixRoot", "WindowsRoot", "DrivePrefix", "UncRoot", "CurrentDirectory", "ParentDirectory", "Normal"] },
    "errorKinds": { "const": ["InvalidLimits", "InputLimit", "InvalidNul", "InvalidPrefix", "UnsupportedNamespace", "ComponentLimit", "ComponentSizeLimit"] },
    "factoryErrorPrecedence": { "const": ["InvalidLimits", "InputLimit", "InvalidNul", "UnsupportedNamespace", "InvalidPrefix"] },
    "nextErrorPrecedence": { "const": ["ComponentLimit", "ComponentSizeLimit"] },
    "errorOffsets": {
      "type": "object", "additionalProperties": false,
      "required": ["InvalidLimits", "InputLimit", "InvalidNul", "InvalidPrefix", "UnsupportedNamespace", "ComponentLimit", "ComponentSizeLimit"],
      "properties": {
        "InvalidLimits": { "const": "zero" }, "InputLimit": { "const": "zero" },
        "InvalidNul": { "const": "first NUL byte" }, "InvalidPrefix": { "const": "zero" },
        "UnsupportedNamespace": { "const": "zero" },
        "ComponentLimit": { "const": "candidate component start" },
        "ComponentSizeLimit": { "const": "candidate component start" }
      }
    },
    "semantics": {
      "type": "object", "additionalProperties": false,
      "required": ["encoding", "limits", "lifetime", "factory", "posix", "windows", "unc", "namespaces", "segments", "transaction", "offset", "cost", "nonGoals"],
      "properties": {
        "encoding": { "$ref": "#/$defs/text" }, "limits": { "$ref": "#/$defs/text" },
        "lifetime": { "$ref": "#/$defs/text" }, "factory": { "$ref": "#/$defs/text" },
        "posix": { "$ref": "#/$defs/text" }, "windows": { "$ref": "#/$defs/text" },
        "unc": { "$ref": "#/$defs/text" }, "namespaces": { "$ref": "#/$defs/text" },
        "segments": { "$ref": "#/$defs/text" }, "transaction": { "$ref": "#/$defs/text" },
        "offset": { "$ref": "#/$defs/text" }, "cost": { "$ref": "#/$defs/text" },
        "nonGoals": { "$ref": "#/$defs/text" }
      }
    },
    "referenceCases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "style", "input", "components"],
        "properties": {
          "label": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "style": { "enum": ["Posix", "Windows"] }, "input": { "type": "string" },
          "components": { "type": "array", "items": { "$ref": "#/$defs/component" } }
        }
      }
    },
    "fixture": { "const": "1726-path-components" },
    "acceptance": { "$ref": "#/$defs/text" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "offset", "length"],
      "properties": {
        "kind": { "enum": ["PosixRoot", "WindowsRoot", "DrivePrefix", "UncRoot", "CurrentDirectory", "ParentDirectory", "Normal"] },
        "offset": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
