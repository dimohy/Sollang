{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "compilerSha256", "inputHashes", "completed", "total", "cases", "failureIds", "acceptance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["passed", "failed"] },
    "compilerSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "inputHashes": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
    },
    "completed": { "type": "integer", "minimum": 0, "maximum": 3 },
    "total": { "const": 3 },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "compileExit", "nativeExit", "stdoutMatched", "observedStdout", "llvmAsExit", "v004Exit", "methodBodyCount", "forbiddenMemoryCallCount", "inputMutationCount", "fixedSliceLifetimeCount", "prematureLifetimeEndCount", "lifetimeOrderingPassed", "sourceSha256", "expectedSha256", "llvmSha256", "executableSha256", "failure"],
        "properties": {
          "id": { "enum": ["boundaries", "noncopyable-readonly", "fixed-readonly-lifetime"] },
          "passed": { "type": "boolean" },
          "compileExit": { "type": "integer" },
          "nativeExit": { "type": ["integer", "null"] },
          "stdoutMatched": { "type": ["boolean", "null"] },
          "observedStdout": { "type": ["string", "null"] },
          "llvmAsExit": { "type": ["integer", "null"] },
          "v004Exit": { "type": ["integer", "null"] },
          "methodBodyCount": { "type": ["integer", "null"], "minimum": 0 },
          "forbiddenMemoryCallCount": { "type": ["integer", "null"], "minimum": 0 },
          "inputMutationCount": { "type": ["integer", "null"], "minimum": 0 },
          "fixedSliceLifetimeCount": { "type": ["integer", "null"], "minimum": 0 },
          "prematureLifetimeEndCount": { "type": ["integer", "null"], "minimum": 0 },
          "lifetimeOrderingPassed": { "type": ["boolean", "null"] },
          "sourceSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
          "expectedSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
          "llvmSha256": { "type": ["string", "null"], "pattern": "^[A-F0-9]{64}$" },
          "executableSha256": { "type": ["string", "null"], "pattern": "^[A-F0-9]{64}$" },
          "failure": { "type": ["string", "null"] }
        }
      }
    },
    "failureIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "acceptance": { "const": "managed Windows focused native and LLVM evidence only; selfhost and other platforms pending" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "completed": { "const": 3 },
          "failureIds": { "maxItems": 0 },
          "cases": { "items": { "properties": { "passed": { "const": true }, "stdoutMatched": { "const": true }, "llvmAsExit": { "const": 0 }, "v004Exit": { "const": 0 }, "methodBodyCount": { "minimum": 1 }, "forbiddenMemoryCallCount": { "const": 0 }, "inputMutationCount": { "const": 0 }, "prematureLifetimeEndCount": { "const": 0 }, "lifetimeOrderingPassed": { "const": true }, "failure": { "type": "null" } } } }
        }
      }
    }
  ]
}
