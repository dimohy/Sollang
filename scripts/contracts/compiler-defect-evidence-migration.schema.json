{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compiler defect evidence migration audit inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "purpose", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "traceSha256", "baselineSha256", "candidateSha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^C[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]+$" },
        "traceSha256": { "$ref": "#/$defs/sha256" },
        "baselineSha256": { "$ref": "#/$defs/sha256" },
        "candidateSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
