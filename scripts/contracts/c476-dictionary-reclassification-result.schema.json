{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gate", "state", "classificationOnly", "compilersExecuted", "classifierSha256", "sourceResultPath", "sourceResultSha256", "sourceInputFingerprint", "total", "completed", "semanticPairPassed", "strictParityPassed", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gate": { "const": "c476-dictionary-negatives-reclassification" },
    "state": { "const": "classified" },
    "classificationOnly": { "const": true },
    "compilersExecuted": { "const": false },
    "classifierSha256": { "$ref": "#/$defs/sha" },
    "sourceResultPath": { "type": "string", "minLength": 1 },
    "sourceResultSha256": { "$ref": "#/$defs/sha" },
    "sourceInputFingerprint": { "$ref": "#/$defs/sha" },
    "total": { "const": 10 },
    "completed": { "const": 10 },
    "semanticPairPassed": { "$ref": "#/$defs/count" },
    "strictParityPassed": { "$ref": "#/$defs/count" },
    "cases": { "type": "array", "minItems": 10, "maxItems": 10, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 10 },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "nonzeroExit", "diagnosticInStderr", "noLoweringProduct", "noEmittedProducts", "generatedProducts"],
      "properties": {
        "state": { "enum": ["not-run", "passed", "failed"] },
        "nonzeroExit": { "type": ["boolean", "null"] },
        "diagnosticInStderr": { "type": ["boolean", "null"] },
        "noLoweringProduct": { "type": ["boolean", "null"] },
        "noEmittedProducts": { "type": ["boolean", "null"] },
        "generatedProducts": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourceResultPath", "sourceResultSha256", "selfhostDiagnosticOnlyLlSha256", "managed", "selfhost", "semanticPairPassed", "strictParityPassed"],
      "properties": {
        "id": { "type": "string", "pattern": "^generic-dictionary-put(-if-absent)?-(wrong-key|wrong-value|no-arguments|one-argument|three-arguments)$" },
        "sourceResultPath": { "type": "string", "minLength": 1 },
        "sourceResultSha256": { "$ref": "#/$defs/sha" },
        "selfhostDiagnosticOnlyLlSha256": { "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
        "managed": { "$ref": "#/$defs/evidence" },
        "selfhost": { "$ref": "#/$defs/evidence" },
        "semanticPairPassed": { "type": "boolean" },
        "strictParityPassed": { "type": "boolean" }
      }
    }
  }
}
