{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sollang.dev/schemas/selfhost-compiler-emission-profile.schema.json",
  "title": "Sollang self-host native compiler emission profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "measurement",
    "target",
    "workerLimit",
    "environment",
    "sourceManifests",
    "sourceCount",
    "compilerFingerprint",
    "inputFingerprint",
    "outputFingerprint",
    "outputBytes",
    "wallMilliseconds",
    "cpuMilliseconds",
    "peakWorkingSetBytes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "const": "compiler-emission" },
    "measurement": { "const": "single-process-native-llvm-emission" },
    "target": { "enum": ["windows", "linux"] },
    "workerLimit": { "type": "integer", "minimum": 1 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["osDescription", "processArchitecture", "processorCount"],
      "properties": {
        "osDescription": { "type": "string", "minLength": 1 },
        "processArchitecture": { "type": "string", "minLength": 1 },
        "processorCount": { "type": "integer", "minimum": 1 }
      }
    },
    "sourceManifests": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceCount": { "type": "integer", "minimum": 1 },
    "compilerFingerprint": { "$ref": "#/$defs/sha256" },
    "inputFingerprint": { "$ref": "#/$defs/sha256" },
    "outputFingerprint": { "$ref": "#/$defs/sha256" },
    "outputBytes": { "type": "integer", "minimum": 1 },
    "wallMilliseconds": { "$ref": "#/$defs/milliseconds" },
    "cpuMilliseconds": { "$ref": "#/$defs/milliseconds" },
    "peakWorkingSetBytes": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "milliseconds": { "type": "integer", "minimum": 0 }
  }
}
