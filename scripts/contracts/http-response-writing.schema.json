{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "module", "sources", "fixture", "officialReferences", "surfaces", "invariants", "unsupported"],
  "properties": {
    "$schema": { "const": "http-response-writing.schema.json" },
    "version": { "const": 1 },
    "module": { "const": "std.net.http.response" },
    "sources": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "fixture": { "const": "1233-http-response-head-writer" },
    "officialReferences": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri" }
    },
    "surfaces": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "invariants": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "unsupported": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
