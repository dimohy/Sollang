    "managedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "completed", "total", "compilerSha256"],
      "properties": {
        "path": { "const": "artifacts/scratch/general-algorithms-partition-point/c427-validation-v4/result.json" },
        "sha256": { "const": "282A37CBDC2EF809C81DE03ADAAD314D0E961E719EBCCD697D57F09476A292C3" },
        "completed": { "const": 3 },
        "total": { "const": 3 },
        "compilerSha256": { "const": "47C49A0726FA1C6C88DC53BDEAE15B6661676A4DC17E0249E5DD9948E67D778D" }
      }
