        "properties": {
          "id": { "enum": ["boundaries", "noncopyable-readonly", "fixed-readonly-lifetime"] },
          "source": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 }
        }
      }
    },
    "managedGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "compilerSha256", "required"],
      "properties": {
        "target": { "const": "windows-x64" },
        "compilerSha256": { "const": "47C49A0726FA1C6C88DC53BDEAE15B6661676A4DC17E0249E5DD9948E67D778D" },
        "required": { "const": ["authoritative-format", "exact-stdout", "llvm-as", "V004", "nonempty-method-body", "zero-allocation-reallocation-bulk-copy", "zero-input-mutation", "fixed-array-lifetime-after-final-use", "input-hash-stability"] }
      }
