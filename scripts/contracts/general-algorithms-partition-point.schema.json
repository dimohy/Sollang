    "acceptance": { "enum": ["static authority only until C426 is integrated; no managed, selfhost, or platform completion is claimed", "managed Windows focused 2/2 complete; selfhost and other platforms pending", "blocked by C427 after 1/2 original managed cases passed; no managed closure is claimed", "managed Windows focused 3/3 complete; selfhost and other platforms pending"] }
