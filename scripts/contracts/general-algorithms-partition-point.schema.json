        "values": { "const": "readonly borrow; supports copyable and noncopyable elements" },
        "item": { "const": "readonly ref T valid only for the callback invocation" },
        "preserves": { "const": ["owner", "length", "capacity", "elements"] },
        "mutations": { "const": 0 },
        "heapAllocations": { "const": 0 },
        "bulkStorageCopies": { "const": 0 }
      }
    },
    "coverage": { "const": ["empty", "single-false", "single-true", "all-false", "all-true", "mixed", "first-false", "returns-len", "noncopyable-readonly", "owner-length-capacity", "fixed-readonly-lifetime", "source-reuse"] },
    "fixtures": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
