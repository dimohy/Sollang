  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "status", "module", "resultSchema", "api", "precondition", "result", "algorithm", "ownership", "coverage", "fixtures", "managedGate", "remaining", "discovery", "managedResult", "acceptance"],
  "properties": {
