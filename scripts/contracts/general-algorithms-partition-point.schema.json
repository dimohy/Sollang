      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "time", "callbackEvaluations", "additionalStorage"],
      "properties": {
        "kind": { "const": "binary search over the monotone predicate partition" },
        "time": { "const": "O(log n)" },
        "callbackEvaluations": { "const": "at most ceil(log2(n + 1)); one per loop iteration" },
        "additionalStorage": { "const": "O(1) scalar indices" }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "item", "preserves", "mutations", "heapAllocations", "bulkStorageCopies"],
