      "properties": {
        "owner": { "const": "Algorithms" },
        "method": { "const": "partitionPoint" },
        "signature": { "const": "public partitionPoint<T>: self, values: [T] -> Int block item: ref T -> Bool" },
        "receiver": { "const": "Algorithms value" },
        "values": { "const": "readonly generic slice [T]" },
        "callback": { "const": "pure typed block item: ref T -> Bool" }
      }
