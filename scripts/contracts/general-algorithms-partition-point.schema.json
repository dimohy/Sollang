        "resultSha256": { "const": "68B269693CF91566FFEBA2F02963E8B6989014ACE7B5D6A87B5EFBD1B6DE94D3" },
        "llvm": { "const": "artifacts/scratch/general-algorithms-partition-point/c426-validation-v3/boundaries.ll" },
        "llvmSha256": { "const": "6C446E24F40435B3BA0F6B88C3E6518E633EFEBE71F16794EC3E218A59B61D5A" },
        "observed": { "const": "all-true=0 and mixed=0 instead of 4 and 3; llvm.lifetime.end precedes slice_ptr construction" },
        "minimal": { "const": "named fixed [1,2,3,4] passed as readonly [Int] through Algorithms.partitionPoint, then source reuse" }
      }
