{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "scope", "compilerPath", "expectedCompilerSha256", "compilerSha256Start", "compilerSha256End", "compilerDrift", "inputHashesStart", "inputHashesEnd", "inputDrift", "completed", "total", "cases", "failureIds", "rootProcessIds", "descendantProcessIds", "orphanProcessIds", "schemaControls"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["passed", "failed"] },
    "scope": { "const": "async-task-observability-managed-matrix" },
    "compilerPath": { "type": "string", "minLength": 1 },
    "expectedCompilerSha256": { "$ref": "#/$defs/hash" },
    "compilerSha256Start": { "$ref": "#/$defs/hash" },
    "compilerSha256End": { "$ref": "#/$defs/hash" },
    "compilerDrift": { "type": "boolean" },
    "inputHashesStart": { "$ref": "#/$defs/hashMap" },
    "inputHashesEnd": { "$ref": "#/$defs/hashMap" },
    "inputDrift": { "type": "boolean" },
    "completed": { "type": "integer", "minimum": 0, "maximum": 13 },
    "total": { "const": 13 },
    "cases": {
      "type": "array", "minItems": 0, "maxItems": 13,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "class", "target", "expectation", "sourceSha256", "compileExit", "warningCount", "noteCount", "diagnosticMatched", "nativeExit", "nativeExact", "llvmAsExit", "v004Exit", "allocationParity", "passed", "rootProcessIds", "descendantProcessIds", "orphanProcessIds"],
        "properties": {
          "id": { "enum": ["normal-parent-child-states", "normal-stable-id-transitions", "normal-suspension-locator", "boundary-caller-buffer-truncation", "boundary-record-capacity", "boundary-close-busy-owner-return", "boundary-session-id-no-reuse", "negative-affine-session-copy", "negative-use-after-close", "negative-ambient-registry", "negative-scheduler-control", "production-off-zero-overhead", "browser-async-actionable-rejection"] },
          "class": { "enum": ["normal", "boundary", "authority-negative", "production-off"] },
          "target": { "enum": ["windows-x64", "wasm32-browser"] },
          "expectation": { "enum": ["exact-stdout", "compiler-rejected", "exact-stdout-and-allocation-audit"] },
          "sourceSha256": { "$ref": "#/$defs/hash" },
          "compileExit": { "type": "integer" },
          "warningCount": { "type": "integer", "minimum": 0 },
          "noteCount": { "type": "integer", "minimum": 0 },
          "diagnosticMatched": { "type": ["boolean", "null"] },
          "nativeExit": { "type": ["integer", "null"] },
          "nativeExact": { "type": ["boolean", "null"] },
          "llvmAsExit": { "type": ["integer", "null"] },
          "v004Exit": { "type": ["integer", "null"] },
          "allocationParity": { "type": ["boolean", "null"] },
          "passed": { "const": true },
          "rootProcessIds": { "$ref": "#/$defs/processIds" },
          "descendantProcessIds": { "$ref": "#/$defs/processIds" },
          "orphanProcessIds": { "type": "array", "maxItems": 0 }
        }
      }
    },
    "failureIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" } },
    "rootProcessIds": { "$ref": "#/$defs/processIds" },
    "descendantProcessIds": { "$ref": "#/$defs/processIds" },
    "orphanProcessIds": { "type": "array", "maxItems": 0 },
    "schemaControls": {
      "type": "object", "additionalProperties": false,
      "required": ["positiveAccepted", "negativeRejected", "negativeTotal"],
      "properties": { "positiveAccepted": { "const": true }, "negativeRejected": { "const": 7 }, "negativeTotal": { "const": 7 } }
    },
    "failure": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "hashMap": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/hash" } },
    "processIds": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "completed": { "const": 13 }, "failureIds": { "maxItems": 0 }, "compilerDrift": { "const": false }, "inputDrift": { "const": false },
          "cases": {
            "minItems": 13, "maxItems": 13,
            "allOf": [
              { "contains": { "properties": { "id": { "const": "normal-parent-child-states" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "id": { "const": "normal-stable-id-transitions" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "id": { "const": "normal-suspension-locator" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "id": { "const": "boundary-caller-buffer-truncation" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "id": { "const": "boundary-record-capacity" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "id": { "const": "boundary-close-busy-owner-return" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "id": { "const": "boundary-session-id-no-reuse" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "id": { "const": "negative-affine-session-copy" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "id": { "const": "negative-use-after-close" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "id": { "const": "negative-ambient-registry" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "id": { "const": "negative-scheduler-control" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "id": { "const": "production-off-zero-overhead" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "id": { "const": "browser-async-actionable-rejection" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 }
            ]
          }
        }
      }
    },
    { "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] }, "then": { "required": ["failure"], "properties": { "failureIds": { "minItems": 1 } } } }
  ]
}
