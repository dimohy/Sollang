{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sollang.dev/schemas/selfhost-bootstrap-performance-pair.schema.json",
  "title": "Sollang adjacent self-host bootstrap performance pair",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "target", "sourceFingerprint", "baseline", "candidate"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "const": "adjacent-bootstrap-performance-pair" },
    "target": { "enum": ["windows", "linux"] },
    "sourceFingerprint": { "$ref": "#/$defs/sha256" },
    "baseline": { "$ref": "#/$defs/artifact" },
    "candidate": { "$ref": "#/$defs/artifact" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compilerPath",
        "compilerFingerprint",
        "llvmPath",
        "llvmFingerprint",
        "generatedByCompilerFingerprint",
        "optimization",
        "parallelCallbackCount",
        "nominalTransferCallbackCount"
      ],
      "properties": {
        "compilerPath": { "type": "string", "minLength": 1 },
        "compilerFingerprint": { "$ref": "#/$defs/sha256" },
        "llvmPath": { "type": "string", "minLength": 1 },
        "llvmFingerprint": { "$ref": "#/$defs/sha256" },
        "generatedByCompilerFingerprint": { "$ref": "#/$defs/sha256" },
        "optimization": { "const": "O1" },
        "parallelCallbackCount": { "type": "integer", "minimum": 0 },
        "nominalTransferCallbackCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
