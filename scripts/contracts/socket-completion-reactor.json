{
  "$schema": "socket-completion-reactor.schema.json",
  "schemaVersion": 1,
  "module": "std.net.socket",
  "blockerId": "PORTABLE_SOCKET_COMPLETION_SUBMISSION",
  "status": "blocked",
  "api": {
    "globalConstructor": "completionReactor(options) -> Result<CompletionReactor, SocketError>",
    "reactorMethods": [
      "registerStream(move self, move stream, registrationKey)",
      "removeStream(move self, registrationKey)",
      "submit(move self, registrationKey, move slot)",
      "cancelOperation(move self, applicationKey)",
      "dequeue(move self, cancellation: std.io.async.Cancellation) -> async"
    ],
    "slotMethods": ["recycle(move self)"]
  },
  "capacity": {
    "fields": ["registrations", "pendingOperations", "completionBatch"],
    "minimum": 1,
    "maximum": 1024,
    "relations": [
      "completionBatch <= pendingOperations",
      "pendingOperations <= registrations"
    ],
    "failure": "InvalidArgument before network effects or allocation"
  },
  "states": ["Vacant", "Pending", "Completed", "Cancelled"],
  "transitions": [
    { "from": "Vacant", "to": "Pending", "cause": "successful submission" },
    { "from": "Vacant", "to": "Completed", "cause": "synchronous completion" },
    { "from": "Pending", "to": "Completed", "cause": "one native completion wins" },
    { "from": "Pending", "to": "Cancelled", "cause": "one cancellation wins" },
    { "from": "Completed", "to": "Vacant", "cause": "OperationSlot.recycle consumes completion" },
    { "from": "Cancelled", "to": "Vacant", "cause": "OperationSlot.recycle consumes cancellation" }
  ],
  "ownership": [
    "one affine slot owns one application key and one native operation identity",
    "one affine slot owns the socket operation direction and exact byte range",
    "one affine slot owns its caller-provided byte buffer while submitted",
    "submission consumes a Vacant slot and rejects double submission",
    "completion returns the original slot and buffer without payload copying",
    "reclaim consumes one terminal slot and rejects double reclaim"
  ],
  "registration": [
    "registerStream consumes the reactor and stream and publishes the stream only into the bounded owner table",
    "duplicate-key detection precedes capacity failure so a full table still reports an existing key as InvalidArgument",
    "registration performs no IOCP association, fcntl mutation, epoll registration, or other socket effect",
    "the first submit performs platform association and nonblocking setup with rollback before publishing Pending",
    "removeStream succeeds only before the registration has been submitted and returns the exact reactor and stream owners",
    "submitted or associated registrations reject removeStream and retain reactor authority",
    "Linux epoll data stores a tagged native registration identity; user UInt64 keys remain unrestricted and are read from the owner table"
  ],
  "completion": [
    "synchronous completion returns directly without recording a wake target",
    "only a genuinely pending operation records its Task wake target",
    "completion preserves the exact transferred byte count or SocketError",
    "completion and cancellation race through one atomic terminal-state winner",
    "callbacks schedule ready Tasks and never execute user continuations",
    "EOF is Completed with Some(0) and remains distinct from no completion None",
    "cooperative dequeue cancellation returns the reactor while Task cancellation drains then drops every retained owner exactly once"
  ],
  "platforms": {
    "windows-x64": {
      "capability": "completion",
      "primitive": "IOCP with GetQueuedCompletionStatusEx",
      "semantics": [
        "one OVERLAPPED identity per reusable slot",
        "bounded batched dequeue",
        "exact transferred byte count and native error",
        "CancelIoEx requests cancellation but IOCP dequeue decides the terminal winner"
      ]
    },
    "linux-x64": {
      "capability": "readiness",
      "primitive": "epoll with nonblocking sockets and eventfd cancellation wakeup",
      "semantics": [
        "bounded event batch",
        "perform the requested operation until completion or EAGAIN",
        "acknowledge only the direction that reached EAGAIN",
        "EPOLLONESHOT false readiness rearms without terminal publication",
        "eventfd cancellation and completion share one terminal winner"
      ]
    },
    "wasm32-browser": {
      "capability": "unsupported",
      "primitive": "actionable target diagnostic",
      "semantics": ["raw socket completion creation is rejected without readiness or synchronous fallback"]
    }
  },
  "forbidden": [
    "blocking worker thread presented as socket async",
    "busy-loop or repeated zero-timeout polling",
    "unbounded registration, operation, or completion queues",
    "per-operation payload allocation or copy",
    "unconditional Linux readiness clearing",
    "global mutable callback registry",
    "browser transport substitution"
  ],
  "milestones": [
    { "id": "configuration", "status": "implemented", "evidence": ["stdlib/std/net/socket.slg", "examples/regression/1693-socket-completion-slot-contract.slg"] },
    { "id": "slot", "status": "implemented", "evidence": ["stdlib/std/net/socket.slg", "examples/regression/1692-async-owned-array-cancellation.slg", "examples/regression/1693-socket-completion-slot-contract.slg"] },
    { "id": "submission", "status": "planned", "evidence": [] },
    { "id": "completion", "status": "planned", "evidence": [] },
    { "id": "cancellation", "status": "planned", "evidence": [] },
    { "id": "platformExecution", "status": "planned", "evidence": [] }
  ],
  "verificationMatrix": [
    { "id": "W01", "target": "windows-x64", "kind": "capacity-registration-pre-effect", "expectation": "typed failure and exact owners", "status": "passed" },
    { "id": "W02", "target": "windows-x64", "kind": "direct-receive", "expectation": "Completed, exact bytes/count/owners, no Task", "status": "pending" },
    { "id": "W03", "target": "windows-x64", "kind": "pending-receive", "expectation": "Pending then exact IOCP dequeue", "status": "pending" },
    { "id": "W04", "target": "windows-x64", "kind": "partial-send", "expectation": "exact prefix count and unchanged buffer", "status": "pending" },
    { "id": "W05", "target": "windows-x64", "kind": "platform-error", "expectation": "exact SocketError kind/code and owners", "status": "pending" },
    { "id": "W06", "target": "windows-x64", "kind": "cancel-completion-race", "expectation": "one terminal winner and one slot return", "status": "pending" },
    { "id": "W07", "target": "windows-x64", "kind": "task-cancel", "expectation": "terminal drain then exactly-once owner cleanup", "status": "pending" },
    { "id": "L01", "target": "linux-x64", "kind": "direct-receive", "expectation": "Completed, exact bytes/count/owners, no Task", "status": "pending" },
    { "id": "L02", "target": "linux-x64", "kind": "pending-receive", "expectation": "Pending then exact epoll dequeue", "status": "pending" },
    { "id": "L03", "target": "linux-x64", "kind": "partial-send", "expectation": "exact prefix count and unchanged buffer", "status": "pending" },
    { "id": "L04", "target": "linux-x64", "kind": "false-readiness", "expectation": "EAGAIN rearm without terminal publication or spin", "status": "pending" },
    { "id": "L05", "target": "linux-x64", "kind": "platform-error", "expectation": "exact SocketError kind/code and owners", "status": "pending" },
    { "id": "L06", "target": "linux-x64", "kind": "cancel-completion-race", "expectation": "one terminal winner and one slot return", "status": "pending" },
    { "id": "L07", "target": "linux-x64", "kind": "task-cancel", "expectation": "epoll removal and drain then exactly-once cleanup", "status": "pending" },
    { "id": "L08", "target": "linux-x64", "kind": "bounded-fair-batch", "expectation": "bounded dequeue and later-operation progress", "status": "pending" },
    { "id": "B01", "target": "wasm32-browser", "kind": "capability", "expectation": "exact compiler diagnostic", "status": "passed" },
    { "id": "B02", "target": "wasm32-browser", "kind": "fallback-audit", "expectation": "no native artifact and no sync/readiness fallback", "status": "passed" },
    { "id": "X01", "target": "semantic", "kind": "moved-owner-reuse", "expectation": "compile reject", "status": "passed" },
    { "id": "X02", "target": "semantic", "kind": "invalid-slot-transition", "expectation": "pre-effect reject", "status": "passed" },
    { "id": "X03", "target": "all-positive-native", "kind": "llvm-structure", "expectation": "llvm-as and V004 pass", "status": "pending" },
    { "id": "X04", "target": "windows-x64+linux-x64", "kind": "allocation-copy-audit", "expectation": "zero steady-state allocation and payload copy", "status": "pending" },
    { "id": "X05", "target": "windows-x64+linux-x64", "kind": "close-pending-reactor", "expectation": "cancel, drain, close, and drop exactly once", "status": "pending" }
  ],
