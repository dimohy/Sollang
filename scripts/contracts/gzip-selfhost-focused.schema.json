{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "mode", "authorityContract", "platform", "optimizations", "positiveCaseIds", "negativeCaseIds", "selfhostDiagnosticsByCase", "additionalSourcesByCase", "requiredFocusedCaseIds", "positiveTotal", "negativeTotal", "total", "acceptance", "validationControls", "executionPolicy"],
  "properties": {
    "$schema": { "const": "gzip-selfhost-focused.schema.json" },
    "version": { "const": 1 },
    "mode": { "const": "selfhost-native-gzip-focused" },
    "authorityContract": { "const": "scripts/contracts/gzip-stream-api.json" },
    "platform": { "const": "windows-x64" },
    "optimizations": { "const": ["O0", "O2"] },
    "positiveCaseIds": { "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "negativeCaseIds": { "const": ["private-codec-state", "private-encoder-state", "private-decoder-state"] },
    "selfhostDiagnosticsByCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private-codec-state", "private-encoder-state", "private-decoder-state"],
      "properties": {
        "private-codec-state": { "const": "; sollang semantic error: cannot read private field 'limits' of struct 'std.compress.gzip.Codec' outside module 'std.compress.gzip'; use its public factory or public instance methods" },
        "private-encoder-state": { "const": "; sollang semantic error: cannot read private field 'produced' of struct 'std.compress.gzip.Encoder' outside module 'std.compress.gzip'; use its public factory or public instance methods" },
        "private-decoder-state": { "const": "; sollang semantic error: cannot read private field 'phase' of struct 'std.compress.gzip.Decoder' outside module 'std.compress.gzip'; use its public factory or public instance methods" }
      }
    },
    "additionalSourcesByCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crc-parity"],
      "properties": {
        "crc-parity": { "const": ["stdlib/std/hash/crc32.slg"] }
      }
    },
    "requiredFocusedCaseIds": { "const": ["transactional-concatenated", "one-byte-boundaries", "dynamic-writer"] },
    "positiveTotal": { "const": 20 },
    "negativeTotal": { "const": 3 },
    "total": { "const": 23 },
    "acceptance": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "validationControls": {
      "type": "object", "additionalProperties": false, "required": ["positive", "negative"],
      "properties": {
        "positive": { "type": "string", "minLength": 1 },
        "negative": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "executionPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["estimatedDuration", "detachedSupervisorMandatory", "launcher", "worker", "routeStatus"],
      "properties": {
        "estimatedDuration": { "const": ">=60s" },
        "detachedSupervisorMandatory": { "const": true },
        "launcher": { "const": "scripts/invoke-detached-selfhost-verification.ps1" },
        "worker": { "const": "scripts/verify-gzip-selfhost-focused.ps1" },
        "routeStatus": { "const": "integrated-and-validated" }
      }
    }
  }
}
