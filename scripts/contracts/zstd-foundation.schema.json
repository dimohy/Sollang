{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "module", "hashModule", "sources", "fixture", "compressedLiteralFixture", "huffmanFixture", "fseFixture", "sequenceFixture", "compressedFseFixture", "hashFixture", "officialReferences", "surfaces", "invariants", "unsupported"],
  "properties": {
    "$schema": { "const": "zstd-foundation.schema.json" },
    "version": { "const": 5 },
    "module": { "const": "std.compress.zstd" },
    "hashModule": { "const": "std.hash.xxhash64" },
    "sources": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "fixture": { "const": "1220-zstd-raw-rle-streaming" },
    "compressedLiteralFixture": { "const": "1304-zstd-literal-only-compressed-block" },
    "huffmanFixture": { "const": "1306-zstd-direct-huffman-literals" },
    "fseFixture": { "const": "1310-zstd-fse-foundation" },
    "sequenceFixture": { "const": "1312-zstd-sequence-frame" },
    "compressedFseFixture": { "const": "1313-zstd-compressed-fse-frame" },
    "hashFixture": { "const": "1228-xxhash64-streaming" },
    "officialReferences": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri" }
    },
    "surfaces": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "invariants": {
      "type": "array",
      "minItems": 11,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "unsupported": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
