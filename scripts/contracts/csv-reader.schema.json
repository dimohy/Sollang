{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "module", "scope", "reference", "surfaces", "lineEndings", "defaults", "profile", "limits", "invariants", "errors", "fixture", "negativeFixtures", "allowedWindowsExternals", "referenceCases", "acceptance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "module": { "const": "stdlib/std/text/csv.slg" },
    "scope": { "const": "bounded-utf8-field-stream-over-borrowed-text" },
    "reference": { "const": "https://www.rfc-editor.org/rfc/rfc4180.html#section-2" },
    "surfaces": { "$ref": "#/$defs/names", "minItems": 5, "maxItems": 5 },
    "lineEndings": {
      "type": "object", "required": ["CrLf", "Lf", "Either", "bareCr", "quoted"],
      "additionalProperties": { "type": "string", "minLength": 1 }, "maxProperties": 5
    },
    "defaults": {
      "type": "object", "additionalProperties": false, "required": ["lineEndings", "expectedColumns"],
      "properties": { "lineEndings": { "const": "CrLf" }, "expectedColumns": { "const": 0 } }
    },
    "profile": {
      "type": "object", "required": ["encoding", "emptyDocument", "blankRecord", "trailingComma", "terminalNewline", "header", "controls", "claim"],
      "additionalProperties": { "type": "string", "minLength": 1 }, "maxProperties": 8
    },
    "limits": { "$ref": "#/$defs/names", "minItems": 4, "maxItems": 4, "items": { "enum": ["maxInputBytes", "maxRecords", "maxFieldsPerRecord", "maxFieldBytes"] } },
    "invariants": { "$ref": "#/$defs/names", "minItems": 12, "maxItems": 12 },
    "errors": { "$ref": "#/$defs/names", "minItems": 13, "maxItems": 13 },
    "fixture": { "const": "1721-csv-bounded-reader" },
    "negativeFixtures": { "$ref": "#/$defs/names", "minItems": 2, "maxItems": 2, "items": { "type": "string", "pattern": "^csv-[a-z-]+-negative$" } },
    "allowedWindowsExternals": { "$ref": "#/$defs/names", "minItems": 3, "maxItems": 3, "items": { "enum": ["GetStdHandle", "WriteFile", "llvm.trap"] } },
    "referenceCases": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["label", "input", "expectedColumns"],
        "properties": {
          "label": { "enum": ["ascii", "quoted", "utf8", "spaces"] },
          "input": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "expectedColumns": { "type": "integer", "minimum": 1, "maximum": 32 }
        }
      }
    },
    "acceptance": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "names": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
