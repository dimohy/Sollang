{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "status", "compilerSha256", "inputStable", "inputDrift", "inputHashes", "formatExitCode", "compileExitCode", "compileDiagnosticsClean", "shimCompileExitCode", "shimDiagnosticsClean", "llvmAsExitCode", "closureExitCode", "nativeExitCode", "stdout", "stderr", "trace", "orphanProcessIds", "irAssertions", "failureIds"],
  "properties": {
    "schemaVersion": { "const": 1 }, "caseId": { "const": "L05" }, "status": { "enum": ["passed", "failed"] },
    "compilerSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "inputStable": { "type": "boolean" }, "inputDrift": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "inputHashes": { "type": "object", "minProperties": 12, "additionalProperties": { "type": "string", "pattern": "^[A-F0-9]{64}$" } },
    "formatExitCode": { "type": ["integer", "null"] }, "compileExitCode": { "type": ["integer", "null"] }, "compileDiagnosticsClean": { "type": "boolean" },
    "shimCompileExitCode": { "type": ["integer", "null"] }, "shimDiagnosticsClean": { "type": "boolean" },
    "llvmAsExitCode": { "type": ["integer", "null"] }, "closureExitCode": { "type": ["integer", "null"] }, "nativeExitCode": { "type": ["integer", "null"] },
    "stdout": { "type": "array", "items": { "type": "string" } }, "stderr": { "type": "string" }, "trace": { "type": "array", "items": { "type": "string" } },
    "orphanProcessIds": { "type": "array", "maxItems": 0, "items": { "type": "integer" } },
    "irAssertions": { "type": "object", "additionalProperties": false,
      "required": ["singleBlockingWaiter", "waiterCapturesErrno", "dequeueMapsKind", "terminalOwnerTransfer", "payloadCopyFree", "taskWakeHandoff"],
      "properties": { "singleBlockingWaiter": { "type": "boolean" }, "waiterCapturesErrno": { "type": "boolean" }, "dequeueMapsKind": { "type": "boolean" }, "terminalOwnerTransfer": { "type": "boolean" }, "payloadCopyFree": { "type": "boolean" }, "taskWakeHandoff": { "type": "boolean" } }
    },
    "failureIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  },
  "allOf": [{ "if": { "properties": { "status": { "const": "passed" } } }, "then": { "properties": {
    "inputStable": { "const": true }, "inputDrift": { "maxItems": 0 },
    "formatExitCode": { "const": 0 }, "compileExitCode": { "const": 0 }, "compileDiagnosticsClean": { "const": true },
    "shimCompileExitCode": { "const": 0 }, "shimDiagnosticsClean": { "const": true },
    "llvmAsExitCode": { "const": 0 }, "closureExitCode": { "const": 0 }, "nativeExitCode": { "const": 0 },
    "stdout": { "const": ["ready-task=true", "reset=true,code=104,state=true,count=0,len=3,first=0"] }, "stderr": { "const": "" }, "trace": { "const": ["forced-recv-call=2,errno=104"] },
    "irAssertions": { "properties": { "singleBlockingWaiter": { "const": true }, "waiterCapturesErrno": { "const": true }, "dequeueMapsKind": { "const": true }, "terminalOwnerTransfer": { "const": true }, "payloadCopyFree": { "const": true }, "taskWakeHandoff": { "const": true } } },
    "failureIds": { "maxItems": 0 }
  } } }]
}
