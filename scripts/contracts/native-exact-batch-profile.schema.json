{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sollang.dev/schemas/native-exact-batch-profile.schema.json",
  "title": "Sollang Windows native exact batch profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "measurement",
    "platform",
    "label",
    "startedUtc",
    "endedUtc",
    "wallMilliseconds",
    "sampleIntervalMilliseconds",
    "perFixtureTimeoutMilliseconds",
    "overallTimeoutMilliseconds",
    "hostVisibleCpuMilliseconds",
    "peakAggregateWorkingSetBytes",
    "maximumObservedProcessCount",
    "workerBudget",
    "minimumCompilerJobs",
    "compilerFingerprint",
    "batchScriptFingerprint",
    "exactVerifierFingerprint",
    "invocationFingerprint",
    "exitCode",
    "success",
    "completedFixtures",
    "totalFixtures",
    "cacheHitCount",
    "progress",
    "stdoutFingerprint",
    "stderrFingerprint",
    "stdoutLogFile",
    "stderrLogFile"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "measurement": { "const": "windows-host-visible-process-tree-and-completion-timeline" },
    "platform": { "const": "windows" },
    "label": { "type": "string", "minLength": 1 },
    "startedUtc": { "type": "string", "format": "date-time" },
    "endedUtc": { "type": "string", "format": "date-time" },
    "wallMilliseconds": { "$ref": "#/$defs/nonnegativeInteger" },
    "sampleIntervalMilliseconds": { "type": "integer", "minimum": 100, "maximum": 60000 },
    "perFixtureTimeoutMilliseconds": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
    "overallTimeoutMilliseconds": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
    "hostVisibleCpuMilliseconds": { "$ref": "#/$defs/nonnegativeInteger" },
    "unavailableCpuSamples": { "$ref": "#/$defs/nonnegativeInteger" },
    "peakAggregateWorkingSetBytes": { "type": "integer", "minimum": 1 },
    "maximumObservedProcessCount": { "type": "integer", "minimum": 1 },
    "workerBudget": { "type": "integer", "minimum": 1, "maximum": 64 },
    "minimumCompilerJobs": { "type": "integer", "minimum": 1, "maximum": 64 },
    "compilerFingerprint": { "$ref": "#/$defs/sha256" },
    "batchScriptFingerprint": { "$ref": "#/$defs/sha256" },
    "exactVerifierFingerprint": { "$ref": "#/$defs/sha256" },
    "invocationFingerprint": { "$ref": "#/$defs/sha256" },
    "exitCode": { "type": "integer" },
    "success": { "type": "boolean" },
    "completedFixtures": { "$ref": "#/$defs/nonnegativeInteger" },
    "totalFixtures": { "$ref": "#/$defs/nonnegativeInteger" },
    "cacheHitCount": { "$ref": "#/$defs/nonnegativeInteger" },
    "progress": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["completed", "total", "status", "fixture", "elapsedMilliseconds"],
        "properties": {
          "completed": { "type": "integer", "minimum": 1 },
          "total": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["PASS", "FAIL"] },
          "fixture": { "type": "string", "minLength": 1 },
          "elapsedMilliseconds": { "$ref": "#/$defs/nonnegativeInteger" }
        }
      }
    },
    "stdoutFingerprint": { "$ref": "#/$defs/sha256" },
    "stderrFingerprint": { "$ref": "#/$defs/sha256" },
    "stdoutLogFile": { "type": "string", "minLength": 1 },
    "stderrLogFile": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "nonnegativeInteger": { "type": "integer", "minimum": 0 }
  }
}
