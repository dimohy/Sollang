{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "status", "compilerSha256", "inputStable", "inputDrift", "inputHashes", "formatExitCode", "compileExitCode", "compileDiagnosticsClean", "llvmAsExitCode", "closureExitCode", "run", "orphanProcessIds", "irAssertions", "failureIds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "const": "W07" },
    "status": { "enum": ["passed", "failed"] },
    "compilerSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "inputStable": { "type": "boolean" },
    "inputDrift": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "inputHashes": { "type": "object", "minProperties": 11, "additionalProperties": { "type": "string", "pattern": "^[A-F0-9]{64}$" } },
    "formatExitCode": { "type": ["integer", "null"] },
    "compileExitCode": { "type": ["integer", "null"] },
    "compileDiagnosticsClean": { "type": "boolean" },
    "llvmAsExitCode": { "type": ["integer", "null"] },
    "closureExitCode": { "type": ["integer", "null"] },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exitCode", "stdout", "stderr", "peerObservedEof"],
      "properties": {
        "exitCode": { "type": ["integer", "null"] },
        "stdout": { "type": "array", "items": { "type": "string" } },
        "stderr": { "type": "string" },
        "peerObservedEof": { "type": "boolean" }
      }
    },
    "orphanProcessIds": { "type": "array", "maxItems": 0, "items": { "type": "integer" } },
    "irAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["socketWaitingStatusDistinct", "taskCancelRequestsWithoutFree", "cancelCallbackTwoPhase", "cancelMarkerPrecedesNativeCancel", "completionWonRecognized", "terminalPublishCount", "closeJoinsBeforeOwnerCleanup", "payloadCopyFree", "waiterScratchInEntry"],
      "properties": {
        "socketWaitingStatusDistinct": { "type": "boolean" },
        "taskCancelRequestsWithoutFree": { "type": "boolean" },
        "cancelCallbackTwoPhase": { "type": "boolean" },
        "cancelMarkerPrecedesNativeCancel": { "type": "boolean" },
        "completionWonRecognized": { "type": "boolean" },
        "terminalPublishCount": { "type": "integer" },
        "closeJoinsBeforeOwnerCleanup": { "type": "boolean" },
        "payloadCopyFree": { "type": "boolean" }, "waiterScratchInEntry": { "type": "boolean" }
      }
    },
    "failureIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  },
  "allOf": [{
    "if": { "properties": { "status": { "const": "passed" } } },
    "then": { "properties": {
      "inputStable": { "const": true },
      "inputDrift": { "maxItems": 0 },
      "formatExitCode": { "const": 0 },
      "compileExitCode": { "const": 0 },
      "compileDiagnosticsClean": { "const": true },
      "llvmAsExitCode": { "const": 0 },
      "closureExitCode": { "const": 0 },
      "run": { "properties": { "exitCode": { "const": 0 }, "stdout": { "const": ["parked=true", "taskCancelled=true"] }, "stderr": { "const": "" }, "peerObservedEof": { "const": true } } },
      "irAssertions": { "properties": {
        "socketWaitingStatusDistinct": { "const": true },
        "taskCancelRequestsWithoutFree": { "const": true },
        "cancelCallbackTwoPhase": { "const": true },
        "cancelMarkerPrecedesNativeCancel": { "const": true },
        "completionWonRecognized": { "const": true },
        "terminalPublishCount": { "const": 1 },
        "closeJoinsBeforeOwnerCleanup": { "const": true },
        "payloadCopyFree": { "const": true }, "waiterScratchInEntry": { "const": true }
      } },
      "failureIds": { "maxItems": 0 }
    } }
  }]
}
