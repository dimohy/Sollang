{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defectId", "fixtureCount", "familyCount", "fixtures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "defectId": { "const": "C2026-09-12-385" },
    "fixtureCount": { "const": 4 },
    "familyCount": { "const": 13 },
    "fixtures": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "expected", "probes"],
        "properties": {
          "id": { "enum": ["1700-selfhost-binary-binding-after-propagation", "1701-expression-context-shape-parity", "25-arrays-dictionaries", "16-condition-when-subject"] },
          "source": { "type": "string", "pattern": "^examples/regression/[0-9a-z-]+\\.slg$" },
          "expected": { "type": "string", "pattern": "^examples/regression/expected/[0-9a-z-]+\\.stdout\\.txt$" },
          "probes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["family", "anchor", "occurrence", "selector", "astKinds", "typedIrKinds"],
              "properties": {
                "family": { "type": "string", "pattern": "^[A-Z][A-Za-z]+Expression$" },
                "anchor": { "type": "string", "minLength": 1 },
                "occurrence": { "type": "integer", "minimum": 0 },
                "selector": { "enum": ["exact", "smallest-containing"] },
                "astKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
                "typedIrKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } }
              }
            }
          }
        }
      }
    }
  }
}
