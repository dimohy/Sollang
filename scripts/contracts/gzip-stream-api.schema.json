{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "module", "source", "fixture", "boundaryFixture", "surfaces", "invariants"],
  "properties": {
    "$schema": { "const": "gzip-stream-api.schema.json" },
    "version": { "const": 3 },
    "module": { "const": "std.compress.gzip" },
    "source": { "const": "stdlib/std/compress/gzip.slg" },
    "fixture": { "const": "1214-gzip-transactional-streaming-decoder" },
    "boundaryFixture": { "const": "1215-gzip-incremental-byte-boundaries" },
    "surfaces": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "invariants": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
