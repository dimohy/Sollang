{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "module", "sources", "surfaces", "invariants", "errorKinds", "offsetPolicies", "positiveCases", "negativeCases", "managedOptimizations", "pending"],
  "properties": {
    "$schema": { "const": "gzip-stream-api.schema.json" },
    "version": { "const": 4 },
    "module": { "const": "std.compress.gzip" },
    "sources": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "surfaces": { "type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "invariants": { "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "errorKinds": { "type": "array", "minItems": 17, "maxItems": 17, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "offsetPolicies": { "type": "object", "minProperties": 9, "maxProperties": 9, "additionalProperties": { "type": "string", "minLength": 1 } },
    "positiveCases": { "type": "array", "minItems": 10, "maxItems": 10, "items": { "type": "object", "required": ["id", "source"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "source": { "type": "string", "minLength": 1 }, "expected": { "type": "string", "minLength": 1 }, "expectedFirstLine": { "type": "string", "minLength": 1 }, "referenceText": { "type": "string", "minLength": 1 } }, "additionalProperties": false } },
    "negativeCases": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "required": ["id", "source", "diagnostic"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "source": { "type": "string", "minLength": 1 }, "diagnostic": { "type": "string", "minLength": 1 } }, "additionalProperties": false } },
    "managedOptimizations": { "const": ["O0", "O2"] },
    "pending": { "const": ["rebuilt-selfhost", "final-stage-integration"] }
  }
}
