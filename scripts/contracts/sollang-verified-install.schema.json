{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "producer",
    "target",
    "compilerVersion",
    "installedAtUtc",
    "stage3Fingerprint",
    "linuxStage3Fingerprint",
    "browserStage2Fingerprint",
    "browserInputFingerprint",
    "stdlibManifestFingerprint",
    "stdlibFileCount",
    "stage3ArtifactsVerified",
    "linuxStage3ArtifactsVerified",
    "browserStage2ArtifactsVerified",
    "stagedSmokeVerified",
    "globalEnvironmentSmokeVerified"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "mode": { "const": "verified-selfhost-stage3-install" },
    "producer": { "const": "install-verified-stage3.ps1" },
    "target": { "const": "windows" },
    "compilerVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "installedAtUtc": { "type": "string", "format": "date-time" },
    "stage3Fingerprint": { "$ref": "#/$defs/sha256" },
    "linuxStage3Fingerprint": { "$ref": "#/$defs/sha256" },
    "browserStage2Fingerprint": { "$ref": "#/$defs/sha256" },
    "browserInputFingerprint": { "$ref": "#/$defs/sha256" },
    "stdlibManifestFingerprint": { "$ref": "#/$defs/sha256" },
    "stdlibFileCount": { "type": "integer", "minimum": 1 },
    "stage3ArtifactsVerified": { "const": true },
    "linuxStage3ArtifactsVerified": { "const": true },
    "browserStage2ArtifactsVerified": { "const": true },
    "stagedSmokeVerified": { "const": true },
    "globalEnvironmentSmokeVerified": { "type": "boolean" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
  }
}
