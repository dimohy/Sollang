{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "module", "fixture", "reference", "invariants", "expectedStdout", "executionMatrix", "deferred"],
  "properties": {
    "$schema": { "const": "zip-stored-stream.schema.json" },
    "schemaVersion": { "const": 1 },
    "module": { "const": "std.archive.zip" },
    "fixture": { "const": "1754-zip-stored-stream" },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "entryName", "encodedBase64", "encodedLength", "encodedSha256", "decodedBytes", "decodedCrc32"],
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "entryName": { "const": "hello.bin" },
        "encodedBase64": { "type": "string", "minLength": 1 },
        "encodedLength": { "const": 123 },
        "encodedSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "decodedBytes": {
          "type": "array",
          "prefixItems": [
            { "const": 0 }, { "const": 1 }, { "const": 2 }, { "const": 3 },
            { "const": 255 }, { "const": 10 }, { "const": 20 }
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7
        },
        "decodedCrc32": { "const": "60E8F84F" }
      }
    },
    "invariants": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 1 } },
    "expectedStdout": { "const": "zip-stored=true\nzip-stored-unsupported=true,true,true,true,true\nzip-stored-malformed=true,true,true\nzip-stored-crc-offsets=true,true,true,true\nzip-stored-bounds=true,true,true,true,true,true,true\n" },
    "executionMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optimizations", "managedWindows", "independentPython", "total"],
      "properties": {
        "optimizations": { "const": ["O0", "O2"] },
        "managedWindows": { "const": 2 },
        "independentPython": { "const": 1 },
        "total": { "const": 3 }
      }
    },
    "deferred": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": { "enum": ["multiple entries", "streaming writer", "data descriptors", "DEFLATE method 8", "ZIP64", "encryption"] }
    }
  }
}
