# Exercises the extracted production layout and ownership functions.
shape kind: Int, origin: Int, symbol: Int, element: Int, length: Int -> SemanticType {
    SemanticType {
        kind: kind
        origin: origin
        module: -1
        symbol: symbol
        first: element
        second: -1
        length: length
        lengthHash: 0
        containsParameter: false
        status: 0
    }
}

main {
    [
        shape(1, 1, 17, -1, -1),
        shape(1, 1, 18, -1, -1),
        shape(1, 1, 8, -1, -1),
        shape(4, -1, -1, 0, 2),
        shape(4, -1, -1, 1, 0); ~
    ] => types
    [NominalField; ~] => fields
    [PayloadEdge; ~] => edges
    [Bool; ~] => seeds
    types -> classifyWithResources(fields, edges, seeds) => traits
    "traits=$(traits[0]),$(traits[1]),$(traits[2]),$(traits[3]),$(traits[4])" -> println
    TypeLayoutRequest { types: types, fields: fields, typeId: -1, pointerBitWidth: 64 } => request
    request -> layoutsFor => layout
    "read=$(layout.sizes[0])/$(layout.aligns[0])/$(layout.statuses[0])" -> println
    "write=$(layout.sizes[1])/$(layout.aligns[1])/$(layout.statuses[1])" -> println
    "fixed=$(layout.sizes[3])/$(layout.aligns[3])/$(layout.statuses[3])" -> println
    "empty=$(layout.sizes[4])/$(layout.statuses[4])" -> println
}
