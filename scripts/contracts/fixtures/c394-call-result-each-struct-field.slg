struct Box {
    value: Int
}

struct Node {
    value: Int
}

values nodes: ref [Node; ~], flags: ref [Bool; ~] -> [Int; ~] {
    flags[0] -> if {
        [nodes[0].value, 11; ~]
    } else {
        [nodes[0].value + 1, 11; ~]
    }
}

boxes: -> [Box; ~] {
    [Node { value: 7 }; ~] => input
    [true, false; ~] => flags
    [Box; ~] => output!
    input -> values(flags) -> each value {
        output! -> push(Box { value: value })
    }
    output!
}

main {
    boxes() => output
    "$(output[0].value),$(output[1].value)" -> println
}
