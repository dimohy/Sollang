{
  "schemaVersion": 1,
  "cases": [
    { "id": "bare-not", "mode": "format-stdin", "source": "main { not }\n", "expected": { "exitCode": 1, "stdout": "", "stderr": "sollang: parse error at 1:12: expected expression\n" } },
    { "id": "bare-box", "mode": "format-stdin", "source": "main { box }\n", "expected": { "exitCode": 1, "stdout": "", "stderr": "sollang: parse error at 1:12: expected expression\n" } },
    { "id": "not-with-operand", "mode": "format-stdin", "source": "main { not false -> println }\n", "expected": { "exitCode": 0, "stdout": "main { not false -> println }\n", "stderr": "" } },
    { "id": "box-with-operand", "mode": "format-stdin", "source": "main { box 1 -> println }\n", "expected": { "exitCode": 0, "stdout": "main { box 1 -> println }\n", "stderr": "" } },
    { "id": "not-binding-name", "mode": "format-stdin", "source": "main { 1 => not }\n", "expected": { "exitCode": 0, "stdout": "main { 1 => not }\n", "stderr": "" } },
    { "id": "box-binding-name", "mode": "format-stdin", "source": "main { 1 => box }\n", "expected": { "exitCode": 0, "stdout": "main { 1 => box }\n", "stderr": "" } },
    { "id": "ordinary-identifier", "mode": "format-stdin", "source": "main { 1 => not_value }\n", "expected": { "exitCode": 0, "stdout": "main { 1 => not_value }\n", "stderr": "" } }
  ]
}
