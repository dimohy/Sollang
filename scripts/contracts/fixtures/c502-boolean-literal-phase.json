{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "true-literal",
      "mode": "format-stdin",
      "source": "main { true }\n",
      "expected": { "exitCode": 0, "stdout": "main { true }\n", "stderr": "" }
    },
    {
      "id": "false-literal",
      "mode": "format-stdin",
      "source": "main { false }\n",
      "expected": { "exitCode": 0, "stdout": "main { false }\n", "stderr": "" }
    },
    {
      "id": "true-call-invalid",
      "mode": "format-stdin",
      "source": "main { true() }\n",
      "expected": { "exitCode": 1, "stdout": "", "stderr": "sollang: parse error at 1:12: expected end of statement\n" }
    },
    {
      "id": "false-call-invalid",
      "mode": "format-stdin",
      "source": "main { false() }\n",
      "expected": { "exitCode": 1, "stdout": "", "stderr": "sollang: parse error at 1:13: expected end of statement\n" }
    },
    {
      "id": "true-binding-name",
      "mode": "format-stdin",
      "source": "main { 1 => true }\n",
      "expected": { "exitCode": 0, "stdout": "main { 1 => true }\n", "stderr": "" }
    }
  ]
}
