part value: Text, start: UIntSize, count: UIntSize -> Text {
    value -> slice(start, count)
}

main {
    "가나다🙂Z" => value
    value -> part(0, 0) -> len -> println
    value -> part(14, 0) -> len -> println
    value -> part(0, 3) -> println
    value -> part(3, 6) -> println
    value -> part(9, 4) -> println
    value -> part(13, 1) -> println
    value -> part(0, 14) -> println
    0 => index!
    index! < 2 -> while {
        value -> part(UIntSize(index! * 3), 3) -> println
        index! + 1 => index!
    }
}
