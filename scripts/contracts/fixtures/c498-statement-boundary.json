{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "missing-separator",
      "mode": "format-stdin",
      "source": "main { 1 -> println 2 -> println }\n",
      "expected": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "sollang: parse error at 1:21: expected end of statement\n"
      }
    },
    {
      "id": "newline-separator",
      "mode": "format-stdin",
      "source": "main {\n    1 -> println\n    2 -> println\n}\n",
      "expected": {
        "exitCode": 0,
        "stdout": "main {\n    1 -> println\n    2 -> println\n}\n",
        "stderr": ""
      }
    },
    {
      "id": "right-brace-boundary",
      "mode": "format-stdin",
      "source": "main { 1 -> println }\n",
      "expected": {
        "exitCode": 0,
        "stdout": "main { 1 -> println }\n",
        "stderr": ""
      }
    },
    {
      "id": "crlf-separator",
      "mode": "format-stdin",
      "source": "main {\r\n    1 -> println\r\n    2 -> println\r\n}\r\n",
      "expected": {
        "exitCode": 0,
        "stdout": "main {\n    1 -> println\n    2 -> println\n}\n",
        "stderr": ""
      }
    }
  ]
}
