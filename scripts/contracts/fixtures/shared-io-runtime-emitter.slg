import sollang.compiler.llvm.emitter.async_file_runtime as fileRuntime

main {
    "; io-file-windows" -> println
    fileRuntime.emitSharedRuntime()
    fileRuntime.emitWindowsRuntime()
    "; io-file-linux" -> println
    fileRuntime.emitSharedRuntime()
    fileRuntime.emitLinuxRuntime()
    "; io-only-windows" -> println
    fileRuntime.emitSharedIoRuntime()
    fileRuntime.emitWindowsIoRuntime()
    "; io-only-linux" -> println
    fileRuntime.emitSharedIoRuntime()
    fileRuntime.emitLinuxIoRuntime()
}
