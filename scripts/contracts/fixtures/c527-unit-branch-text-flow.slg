emitDetail value: Int -> Unit uses Console {
    "detail" -> println
}

emitDiagnostic code: Int -> Unit uses Console {
    code == 20 -> if {
        code -> emitDetail
    } else {
        code == 21 -> if {
            "twenty-one" -> println
        } else {
            code == 22 -> if {
                "diagnostic" -> slice(0, 10) => label
                "$label:$code" -> println
            }
            code == 28 -> if {
                "last" -> slice(0, 4) => label
                "$label:$code" -> println
            }
        }
    }
}

main {
    20 -> emitDiagnostic
    21 -> emitDiagnostic
    22 -> emitDiagnostic
    28 -> emitDiagnostic
}
