import sys.process as process

struct Ordering { }
impl Ordering {
    count<T>: self, values: [T] -> Int => values -> len
}

main {
    # Keep a genuinely growable input without a fixed-length storage warning.
    process.arguments() -> len => argumentCount
    [Int; ~] => numbers!
    0..<(Int(argumentCount) * 2) -> each { numbers! -> push(1) }
    ["one", "two"] => words
    Ordering { } -> count(numbers!) -> println
    Ordering { } -> count(words) -> println
}
