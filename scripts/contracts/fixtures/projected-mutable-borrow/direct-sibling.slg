import sys.file as file
struct Pair { input: [UInt8; ~]
    documents: [Int; ~] }
mutate values: mut [Int; ~] -> Int { values -> push(1)
    0 }
mutateBytes values: mut [UInt8; ~] -> Int { values -> push(66)
    0 }
touch pair: mut Pair -> Int => 0
inspect pair: mut Pair -> Int {
    pair.input -> file.borrowBytes => source
    source -> slice(UIntSize(0), UIntSize(1)) => view
    view -> file.borrowText => payload
    mutate(pair.documents) => changed
    payload -> len => length
    Int(length)
}
main { Pair { input: [65; ~], documents: [Int; ~] } => pair!
    pair! -> inspect -> println }
