struct Reader {
    base: Int
}

scanValue reader: Reader, depth: Int -> Int {
    reader.base + depth * 10
}

impl Reader {
    depth: self -> Int {
        self.base - 1
    }

    scan: self -> Int {
        self.base - 1 => depth
        scanValue(self, depth)
    }
}

main {
    Reader { base: 4 } => reader
    reader -> scan => value
    "global=$value" -> println
}
