import sollang.compiler.probes.console_results as checks

main {
    """
    main {
        "a" -> print
        "b" -> println
    }
    """ -> checks.consoleResultFacts => flows
    "output-flow-unit=$flows" -> println

    """
    main {
        print("a")
        println("b")
    }
    """ -> checks.consoleResultFacts => calls
    "output-call-unit=$calls" -> println

    """
    identity value: Int -> Int => value
    main {
        8 -> identity => result
        result -> print
    }
    """ -> checks.declaredResultFacts => declared
    "declared-result-preserved=$declared" -> println
}
