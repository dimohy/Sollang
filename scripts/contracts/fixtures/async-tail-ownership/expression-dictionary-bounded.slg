child value: Int -> async Int {
    yield
    value
}

calculate<T>: -> async Unit uses Console {
    child(7) => first
    child(9) => second
    {1: first -> await, 2: second -> await; <=4} => values
    "dictionary=$(values[1]),$(values[2])" -> println
}

main {
    calculate<Int>() => one
    one -> await
    calculate<Bool>() => two
    two -> await
}
