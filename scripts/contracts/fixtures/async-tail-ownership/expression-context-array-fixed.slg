sum values: [Int; 2] -> Int => values[0] + values[1]

child value: Int -> async Int {
    yield
    value
}

calculate<T>: -> async Unit uses Console {
    child(7) => first
    child(9) => second
    sum([first -> await, second -> await]) => values
    "aggregate=$values" -> println
}

main {
    calculate<Int>() => one
    one -> await
    calculate<Bool>() => two
    two -> await
}
