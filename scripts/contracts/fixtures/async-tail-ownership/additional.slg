step value: Int -> async Int {
    value + 1
}

parent value: Int, values: move [Int; ~] -> async Int uses Console {
    "parent-started" -> println
    values -> len -> step -> await
}

main {
    [2, 3, 5; ~] => values
    0 -> parent(values) => pending
    0 -> step => gate
    gate -> await => ignored
    pending -> cancel
    "cancelled" -> println
}
