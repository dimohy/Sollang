child value: Int -> async Int {
    yield
    value
}

calculate<T>: -> async Unit uses Console {
    child(7) => first
    child(9) => second
    {first -> await: second -> await} => values
    "dictionary=$(values[7]),$(values[7])" -> println
}

main {
    calculate<Int>() => one
    one -> await
    calculate<Bool>() => two
    two -> await
}
