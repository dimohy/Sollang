step value: Int -> async Int {
    value + 1
}

parent values: move [Int; ~] -> async Int uses Console {
    "parent-started" -> println
    values -> len -> step -> await => next
    next + (values -> len)
}

main {
    [2, 3, 5; ~] -> parent => pending
    pending -> await => result
    "result=$result" -> println
}
