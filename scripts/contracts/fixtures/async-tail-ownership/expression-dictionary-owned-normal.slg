struct Values {
    items: [Int; ~]
}

arrayChild: -> async Values {
    yield
    Values { items: [2, 3, 5; ~] }
}

secondChild: -> async Values {
    yield
    yield
    yield
    Values { items: [7, 11, 13; ~] }
}

gate: -> async Int {
    yield
    yield
    yield
    0
}

combine values: [Int; ~], extra: Int -> Int => (values -> len) + extra

parent: -> async Int uses Console {
    "parent-started" -> println
    arrayChild() => first
    secondChild() => second
    {1: first -> await, 2: second -> await} => values
    (values[1].items -> len) + (values[2].items -> len)
}

main {
    parent() => pending
    pending -> await => result
    "result=$result" -> println
}
