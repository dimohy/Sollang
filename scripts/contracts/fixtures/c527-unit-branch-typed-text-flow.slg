emitDetail value: Int -> Unit uses Console {
    "detail" -> println
}

emitDiagnostic source: Text, code: Int -> Unit uses Console {
    code == 20 -> if {
        code -> emitDetail
    } else {
        code == 21 -> if {
            "twenty-one" -> println
        } else {
            code == 22 -> if {
                source -> slice(0, 10) => label
                "$label:$code" -> println
            }
            code == 28 -> if {
                source -> slice(0, 4) => label
                "$label:$code" -> println
            }
        }
    }
}

main {
    "diagnostic" -> emitDiagnostic(20)
    "diagnostic" -> emitDiagnostic(21)
    "diagnostic" -> emitDiagnostic(22)
    "diagnostic" -> emitDiagnostic(28)
}
