choose accepted: Bool -> Result<Unit, Text> {
    0 -> when {
        == 0 {
            accepted -> if {
                Result<Unit, Text>.Ok
            } else {
                Result<Unit, Text>.Err("rejected")
            }
        }
        else { Result<Unit, Text>.Ok }
    }
}

main {
    true -> choose -> when {
        Result<Unit, Text>.Ok(done) { "ok" -> println }
        Result<Unit, Text>.Err(error) { error -> println }
    }
}
