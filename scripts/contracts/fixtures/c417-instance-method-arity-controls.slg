struct Counter {
    value: Int
}

impl Counter {
    shifted: self, offset: Int -> Int {
        self.value + offset
    }

    weighted: self, scale: Int, offset: Int -> Int {
        self.value * scale + offset
    }
}

useCounter counter: Counter -> Int {
    counter.weighted(3, 4)
}

main {
    Counter { value: 5 } => counter
    counter.shifted(7) => shifted
    counter.weighted(6, 2) => weighted
    counter -> weighted(4, 1) => flowed
    counter -> useCounter => parameterReceiver
    "shifted=$shifted, weighted=$weighted, flowed=$flowed, parameter=$parameterReceiver" -> println
}
