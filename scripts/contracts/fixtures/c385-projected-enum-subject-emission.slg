import sollang.compiler.llvm.text as compiler

main {
    """
    enum Framing { None, ContentLength(UIntSize), UntilClose }
    struct Plan { public framing: Framing }
    inspect plan: Plan -> Int {
        plan.framing -> when {
            UntilClose { 2 }
            else { 3 }
        }
    }
    main {
        Plan { framing: Framing.UntilClose } -> inspect -> println
        Plan { framing: Framing.ContentLength(4) } -> inspect -> println
        Plan { framing: Framing.UntilClose } => direct
        direct.framing -> when {
            UntilClose { 2 }
            else { 3 }
        } -> println
        Plan { framing: Framing.None } => other
        other.framing -> when {
            UntilClose { 2 }
            else { 3 }
        } -> println
    }
    """ => input
    [input,; ~] => sources
    sources -> compiler.emit
}
