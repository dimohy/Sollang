      "mode": "format-stdin",
      "source": "main { \"\"\"\"abc\n",
      "expected": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "sollang: lex error at 1:8: unterminated raw string literal\n"
      }
    },
    {
      "id": "ordinary-unterminated-control",
      "mode": "format-stdin",
      "source": "main { \"abc\n",
      "expected": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "sollang: lex error at 1:8: unterminated string literal\n"
      }
    },
    {
      "id": "raw-valid-control",
      "mode": "format-stdin",
      "source": "main { \"\"\"abc\"\"\" -> println }\n",
      "expected": {
        "exitCode": 0,
        "stdout": "main { \"\"\"abc\"\"\" -> println }\n",
