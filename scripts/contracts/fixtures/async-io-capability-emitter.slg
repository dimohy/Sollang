import sollang.compiler.llvm.emitter.async_runtime as asyncRuntime

main {
    "; async-capability-windows-none" -> println
    asyncRuntime.emitStandaloneWindowsRuntime(false, false)
    "; async-capability-windows-file" -> println
    asyncRuntime.emitStandaloneWindowsRuntime(true, false)
    "; async-capability-windows-socket" -> println
    asyncRuntime.emitStandaloneWindowsRuntime(false, true)
    "; async-capability-windows-both" -> println
    asyncRuntime.emitStandaloneWindowsRuntime(true, true)
    "; async-capability-linux-none" -> println
    asyncRuntime.emitStandaloneLinuxRuntime(false, false)
    "; async-capability-linux-file" -> println
    asyncRuntime.emitStandaloneLinuxRuntime(true, false)
    "; async-capability-linux-socket" -> println
    asyncRuntime.emitStandaloneLinuxRuntime(false, true)
    "; async-capability-linux-both" -> println
    asyncRuntime.emitStandaloneLinuxRuntime(true, true)
}
