struct Owner {
    values: [Int; ~]
}

impl Owner {
    consume: move self, other: Owner -> Int {
        self.values -> len
    }
}

main {
    Owner { values: [1; ~] } => owner
    Owner { values: [2; ~] } => other
    true -> if {
        owner.consume(other)
    } else {
        0
    } => count
    count -> println
}
