weighted value: Int, scale: Int, offset: Int -> async Int {
    value * scale + offset
}

signed value: Int, positive: Bool -> async Int {
    positive -> if { value } else { 0 - value }
}

main {
    7 -> weighted(3, 2) => weightedTask
    9 -> signed(false) => signedTask
    weightedTask -> await => weightedValue
    signedTask -> await => signedValue
    "weighted=$(weightedValue),signed=$(signedValue)" -> println
}
