{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "missing-plus-operand",
      "mode": "format-stdin",
      "source": "main { 1 + -> println }\n",
      "expected": { "exitCode": 1, "stdout": "", "stderr": "sollang: parse error at 1:12: expected expression\n" }
    },
    {
      "id": "missing-multiply-operand",
      "mode": "format-stdin",
      "source": "main { 1 * -> println }\n",
      "expected": { "exitCode": 1, "stdout": "", "stderr": "sollang: parse error at 1:12: expected expression\n" }
    },
    {
      "id": "missing-call-argument",
      "mode": "format-stdin",
      "source": "main { println(+) }\n",
      "expected": { "exitCode": 1, "stdout": "", "stderr": "sollang: parse error at 1:16: expected expression\n" }
    },
    {
      "id": "trailing-call-comma",
      "mode": "format-stdin",
      "source": "main { println(1,) }\n",
      "expected": { "exitCode": 1, "stdout": "", "stderr": "sollang: parse error at 1:18: expected expression\n" }
    },
    {
      "id": "missing-plus-at-brace",
      "mode": "format-stdin",
      "source": "main { 1 + }\n",
      "expected": { "exitCode": 1, "stdout": "", "stderr": "sollang: parse error at 1:12: expected expression\n" }
    },
    {
      "id": "missing-right-paren-control",
      "mode": "format-stdin",
      "source": "main { println(1 }\n",
      "expected": { "exitCode": 1, "stdout": "", "stderr": "sollang: parse error at 1:18: expected RightParen\n" }
    },
    {
      "id": "missing-right-brace-control",
      "mode": "format-stdin",
      "source": "main { 1 -> println\n",
      "expected": { "exitCode": 1, "stdout": "", "stderr": "sollang: parse error at 2:1: expected RightBrace\n" }
    },
    {
      "id": "missing-identifier-control",
      "mode": "format-stdin",
      "source": "main { 1 => }\n",
      "expected": { "exitCode": 1, "stdout": "", "stderr": "sollang: parse error at 1:13: expected Identifier\n" }
    },
    {
      "id": "empty-call-control",
      "mode": "format-stdin",
      "source": "main { println() }\n",
      "expected": { "exitCode": 0, "stdout": "main { println() }\n", "stderr": "" }
    }
  ]
}
