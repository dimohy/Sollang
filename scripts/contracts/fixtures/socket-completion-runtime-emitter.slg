import sollang.compiler.llvm.emitter.async_file_runtime as ioRuntime
import sollang.compiler.llvm.emitter.socket_runtime as socketRuntime

main {
    "; completion-platform-windows" -> println
    socketRuntime.emitTypeRuntime()
    ioRuntime.emitSharedIoRuntime()
    ioRuntime.emitWindowsIoRuntime()
    socketRuntime.emitWindowsRuntime()
    socketRuntime.emitWindowsCompletionRuntime()
    "; completion-platform-linux" -> println
    socketRuntime.emitTypeRuntime()
    ioRuntime.emitSharedIoRuntime()
    ioRuntime.emitLinuxIoRuntime()
    socketRuntime.emitLinuxRuntime()
    socketRuntime.emitLinuxCompletionRuntime()
}
