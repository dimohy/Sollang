struct CalendarDate {
    year: Long
    month: Long
    day: Long
}

calendarDate seed: Long -> CalendarDate {
    seed + 3 => month!
    seed >= 10 -> if {
        month! - 12 => month!
    }
    CalendarDate { year: seed, month: month!, day: seed }
}

main {
    calendarDate(20).month -> println
}
