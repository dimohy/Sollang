import sollang.compiler.llvm.emitter.ownership as ownership

main {
    [Bool; ~] => consumed!
    consumed! -> push(false)
    consumed! -> push(true)
    consumed! -> ownership.enumMatchConsumes(-1, 17, 1) -> println
    consumed! -> ownership.enumMatchConsumes(2, 17, 1) -> println
    consumed! -> ownership.enumMatchConsumes(1, 0, -1) -> println
    consumed! -> ownership.enumMatchConsumes(0, 0, -1) -> println
    consumed! -> ownership.enumMatchConsumes(0, 17, 1) -> println
    consumed! -> ownership.enumMatchConsumes(0, 18, 1) -> println
    consumed! -> ownership.enumMatchConsumes(0, 17, -1) -> println
    consumed! -> ownership.enumMatchConsumes(0, 17, 2) -> println
    consumed! -> ownership.enumMatchConsumes(1, 17, 0) -> println
    [Bool; ~] => empty
    empty -> ownership.enumMatchConsumes(0, 17, 0) -> println
}
