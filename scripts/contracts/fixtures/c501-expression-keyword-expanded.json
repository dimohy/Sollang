{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "bare-when",
      "mode": "format-stdin",
      "source": "main { when }\n",
      "expected": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "sollang: parse error at 1:13: expected LeftBrace\n"
      }
    },
    {
      "id": "bare-map",
      "mode": "format-stdin",
      "source": "main { map }\n",
      "expected": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "sollang: parse error at 1:12: expected Identifier\n"
      }
    },
    {
      "id": "invalid-map-mode",
      "mode": "format-stdin",
      "source": "main { map foo }\n",
      "expected": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "sollang: parse error at 1:12: map expects 'read' or 'write'\n"
      }
    },
    {
      "id": "valid-map",
      "mode": "format-stdin",
      "source": "main { map read \"file\" -> println }\n",
      "expected": {
        "exitCode": 0,
        "stdout": "main { map read \"file\" -> println }\n",
        "stderr": ""
      }
    },
    {
      "id": "when-binding-name",
      "mode": "format-stdin",
      "source": "main { 1 => when }\n",
      "expected": {
        "exitCode": 0,
        "stdout": "main { 1 => when }\n",
        "stderr": ""
      }
    },
    {
      "id": "map-binding-name",
      "mode": "format-stdin",
      "source": "main { 1 => map }\n",
      "expected": {
        "exitCode": 0,
        "stdout": "main { 1 => map }\n",
        "stderr": ""
      }
    },
    {
      "id": "map-binding-followed",
      "mode": "format-stdin",
      "source": "main { 1 => map foo }\n",
      "expected": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "sollang: parse error at 1:17: expected end of statement\n"
      }
    },
    {
      "id": "when-binding-followed",
      "mode": "format-stdin",
      "source": "main { 1 => when foo }\n",
      "expected": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "sollang: parse error at 1:18: expected end of statement\n"
      }
    }
  ]
}
