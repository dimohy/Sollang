struct Owner {
    values: [Int; ~]
}

impl Owner {
    consume: self, other: move Owner -> Int {
        other.values -> len
    }
}

main {
    Owner { values: [1; ~] } => owner
    Owner { values: [2; ~] } => other
    true -> if {
        owner.consume(other)
    } else {
        owner.consume(other)
    } => count
    (owner.values -> len) -> println
}
