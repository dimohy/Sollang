emitDetail value: Int -> Unit uses Console {
    value > 0 -> if {
        "detail" -> println
    } else {
        "empty" -> println
    }
}

emitDiagnostic code: Int -> Unit uses Console {
    code == 20 -> if {
        code -> emitDetail
    } else {
        code == 21 -> if {
            "twenty-one" -> println
        } else {
            code == 22 -> if {
                "twenty-two" -> println
            } else {
                "other" -> println
            }
        }
    }
}

main {
    20 -> emitDiagnostic
    21 -> emitDiagnostic
    22 -> emitDiagnostic
    23 -> emitDiagnostic
}
