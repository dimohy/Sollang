emitDetail value: Int -> Unit uses Console {
    "detail" -> println
}

emitDiagnostic code: Int -> Unit uses Console {
    code == 20 -> if {
        code -> emitDetail
    } else {
        code == 21 -> if {
            "twenty-one" -> println
        } else {
            code == 33 -> if {
                code -> emitDetail
            }
            code == 34 -> if {
                "thirty-four" -> println
            }
            code == 35 -> if {
                "thirty-five" -> println
            }
        }
    }
}

main {
    20 -> emitDiagnostic
    21 -> emitDiagnostic
    33 -> emitDiagnostic
    34 -> emitDiagnostic
    35 -> emitDiagnostic
}
