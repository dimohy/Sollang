import sollang.compiler.llvm.emitter.compute_runtime as computeRuntime
import sollang.compiler.llvm.emitter.text_output_runtime as textRuntime

main {
    "; worker-platform-windows" -> println
    computeRuntime.emitMemoryOutputSinkRuntime()
    true -> textRuntime.emitWindowsTextRuntime(false)
    computeRuntime.emitWindowsComputeRuntime()
    "; worker-platform-linux" -> println
    computeRuntime.emitMemoryOutputSinkRuntime()
    true -> textRuntime.emitLinuxTextRuntime(false)
    computeRuntime.emitLinuxComputeRuntime()
}
