{
  "schemaVersion": 1,
  "scope": "Lexical failures retain original positions; parse failures report the formatted text after indentation/dedent; successful output is unchanged. Positions are fixed from canonical formatting and parser expression diagnostics, not backend IDs.",
  "cases": [
    {
      "id": "parse-error-after-main-indentation",
      "mode": "format-stdin",
      "source": "main {\n1 + =>\n}\n",
      "expected": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "sollang: parse error at 2:9: expected expression\n"
      }
    },
    {
      "id": "parse-error-after-root-dedent",
      "mode": "format-stdin",
      "source": "            1 + =>\n",
      "expected": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "sollang: parse error at 1:5: expected expression\n"
      }
    },
    {
      "id": "lexical-error-before-rewrite",
      "mode": "format-stdin",
      "source": "main {\n      \u0000\n}\n",
      "expected": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "sollang: lex error at 2:7: unexpected character '\u0000'\n"
      }
    },
    {
      "id": "valid-format-control",
      "mode": "format-stdin",
      "source": "main {\n    (true) -> if { \"valid\" -> println }\n}\n",
      "expected": {
        "exitCode": 0,
        "stdout": "main {\n    true -> if { \"valid\" -> println }\n}\n",
        "stderr": ""
      }
    }
  ]
}
