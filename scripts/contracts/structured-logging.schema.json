{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "module", "status", "surfaces", "invariants", "fixture"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "module": { "const": "std.log" },
    "status": { "enum": ["in-progress", "complete"] },
    "surfaces": { "type": "array", "minItems": 9, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
    "invariants": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 12 } },
    "fixture": { "const": "1696-structured-logger-explicit-sink" }
  }
}
