{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "defectId", "coveredDefectIds", "status", "completed", "total", "compilerSha256", "expectedCompilerSha256", "auditContractSha256", "deterministicRandomShimSha256", "deterministicSeedSha256", "inputStable", "inputDrift", "inputHashes", "cases", "failureIds"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "mode": { "const": "managed-additional-move-ownership" },
    "defectId": { "const": "C2026-08-28-92" },
    "coveredDefectIds": { "const": ["C2026-08-28-92", "C2026-09-13-424"] },
    "status": { "enum": ["passed", "failed"] },
    "completed": { "type": "integer", "minimum": 0, "maximum": 6 },
    "total": { "const": 6 },
    "compilerSha256": { "$ref": "#/$defs/sha256" },
    "expectedCompilerSha256": { "type": ["string", "null"], "pattern": "^[A-F0-9]{64}$" },
    "auditContractSha256": { "$ref": "#/$defs/sha256" },
    "deterministicRandomShimSha256": { "$ref": "#/$defs/sha256" },
    "deterministicSeedSha256": { "const": "40D0FC4C7874CC77C603103B4AE0735AEA70C3B7A45B64CFA4DFA0A6F32C8806" },
    "inputStable": { "type": "boolean" },
    "inputDrift": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "inputHashes": { "type": "object", "minProperties": 21, "additionalProperties": { "$ref": "#/$defs/sha256" } },
    "cases": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/positive" }, { "properties": { "id": { "const": "P1207" } } }] },
        { "$ref": "#/$defs/p1206" },
        { "allOf": [{ "$ref": "#/$defs/negative" }, { "properties": { "id": { "const": "N1" } } }] },
        { "allOf": [{ "$ref": "#/$defs/negative" }, { "properties": { "id": { "const": "N2" } } }] },
        { "$ref": "#/$defs/p2" },
        { "allOf": [{ "$ref": "#/$defs/negative" }, { "properties": { "id": { "const": "N3" } } }] }
      ],
      "items": false
    },
    "failureIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "completed": { "const": 6 },
          "inputStable": { "const": true },
          "inputDrift": { "maxItems": 0 },
          "failureIds": { "maxItems": 0 },
          "cases": {
            "prefixItems": [
              { "properties": { "passed": { "const": true } } },
              { "properties": { "passed": { "const": true } } },
              { "properties": { "passed": { "const": true } } },
              { "properties": { "passed": { "const": true } } },
              { "properties": { "passed": { "const": true } } },
              { "properties": { "passed": { "const": true } } }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "auditRun": {
      "type": "object", "additionalProperties": false,
      "required": ["run", "exit", "allocationCount", "releaseCount", "invalidReleaseCount", "exact"],
      "properties": { "run": { "type": "integer", "minimum": 1, "maximum": 3 }, "exit": { "const": 0 }, "allocationCount": { "type": "integer", "minimum": 0 }, "releaseCount": { "type": "integer", "minimum": 0 }, "invalidReleaseCount": { "const": 0 }, "exact": { "const": true } }
    },
    "base": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "passed", "compileExit", "llvmProduced", "nativeExit", "expectedStdout", "nativeExact", "llvmAsExit", "closureExit", "diagnosticMatched", "auditLinkExit", "auditExit", "expectedAllocationCount", "allocationCount", "releaseCount", "invalidReleaseCount", "allocationBalanced", "auditRunCount", "deterministicSeedSha256", "deterministicAuditExact", "productionUsesRealBCrypt", "auditUsesDeterministicRandom", "rawStdoutExact", "stdoutSha256", "stderrSha256", "warningNoteFree", "diagnosticCount", "auditRuns", "failure"],
      "properties": {
        "id": { "enum": ["P1207", "P1206", "N1", "N2", "P2", "N3"] }, "passed": { "type": "boolean" }, "compileExit": { "type": "integer" }, "llvmProduced": { "type": "boolean" },
        "nativeExit": { "type": ["integer", "null"] }, "expectedStdout": { "type": ["string", "null"] }, "nativeExact": { "type": ["boolean", "null"] }, "llvmAsExit": { "type": ["integer", "null"] }, "closureExit": { "type": ["integer", "null"] }, "diagnosticMatched": { "type": ["boolean", "null"] },
        "auditLinkExit": { "type": ["integer", "null"] }, "auditExit": { "type": ["integer", "null"] }, "expectedAllocationCount": { "type": ["integer", "null"], "minimum": 0 }, "allocationCount": { "type": ["integer", "null"], "minimum": 0 }, "releaseCount": { "type": ["integer", "null"], "minimum": 0 }, "invalidReleaseCount": { "type": ["integer", "null"], "minimum": 0 }, "allocationBalanced": { "type": ["boolean", "null"] },
        "auditRunCount": { "type": ["integer", "null"], "minimum": 3 }, "deterministicSeedSha256": { "type": ["string", "null"], "pattern": "^[A-F0-9]{64}$" }, "deterministicAuditExact": { "type": ["boolean", "null"] }, "productionUsesRealBCrypt": { "type": ["boolean", "null"] }, "auditUsesDeterministicRandom": { "type": ["boolean", "null"] },
        "rawStdoutExact": { "type": "boolean" }, "stdoutSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "stderrSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "warningNoteFree": { "type": "boolean" }, "diagnosticCount": { "type": ["integer", "null"], "minimum": 0 }, "auditRuns": { "type": "array", "items": { "$ref": "#/$defs/auditRun" } }, "failure": { "type": ["string", "null"] }
      }
    },
    "positive": { "allOf": [{ "$ref": "#/$defs/base" }, { "if": { "properties": { "passed": { "const": true } } }, "then": { "properties": { "compileExit": { "const": 0 }, "llvmProduced": { "const": true }, "nativeExit": { "const": 0 }, "nativeExact": { "const": true }, "rawStdoutExact": { "const": true }, "llvmAsExit": { "const": 0 }, "closureExit": { "const": 0 }, "warningNoteFree": { "const": true }, "diagnosticCount": { "type": "null" }, "failure": { "type": "null" } } } }] },
    "negative": { "allOf": [{ "$ref": "#/$defs/base" }, { "if": { "properties": { "passed": { "const": true } } }, "then": { "properties": { "compileExit": { "const": 1 }, "llvmProduced": { "const": false }, "nativeExit": { "type": "null" }, "expectedStdout": { "type": "null" }, "nativeExact": { "type": "null" }, "llvmAsExit": { "type": "null" }, "closureExit": { "type": "null" }, "diagnosticMatched": { "const": true }, "rawStdoutExact": { "const": true }, "warningNoteFree": { "const": true }, "diagnosticCount": { "const": 1 }, "auditRuns": { "maxItems": 0 }, "failure": { "type": "null" } } } }] },
    "p1206": { "allOf": [{ "$ref": "#/$defs/positive" }, { "properties": { "id": { "const": "P1206" } } }, { "if": { "properties": { "passed": { "const": true } } }, "then": { "properties": { "expectedAllocationCount": { "const": 169877 }, "allocationCount": { "const": 169877 }, "releaseCount": { "const": 169877 }, "invalidReleaseCount": { "const": 0 }, "allocationBalanced": { "const": true }, "auditRunCount": { "const": 3 }, "deterministicAuditExact": { "const": true }, "productionUsesRealBCrypt": { "const": true }, "auditUsesDeterministicRandom": { "const": true }, "auditRuns": { "minItems": 3, "maxItems": 3 } } } }] },
    "p2": { "allOf": [{ "$ref": "#/$defs/positive" }, { "properties": { "id": { "const": "P2" } } }, { "if": { "properties": { "passed": { "const": true } } }, "then": { "properties": { "expectedStdout": { "const": "count=3,retained=3" }, "expectedAllocationCount": { "const": 4 }, "allocationCount": { "const": 4 }, "releaseCount": { "const": 4 }, "invalidReleaseCount": { "const": 0 }, "allocationBalanced": { "const": true }, "auditRunCount": { "const": 3 }, "deterministicAuditExact": { "const": true }, "auditRuns": { "minItems": 3, "maxItems": 3 } } } }] }
  }
}
