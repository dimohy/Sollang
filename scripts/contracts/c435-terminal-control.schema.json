{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defect", "authority", "probe", "focusedFixtures", "mutationControls", "promotion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "defect": { "const": "C2026-09-13-435" },
    "authority": { "const": "wrapper-aware-later-sibling-aware-terminating-control" },
    "probe": { "const": "scripts/probes/gzip-stream-api/terminal-subject-when-all-return.slg" },
    "focusedFixtures": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 5 }
    },
    "mutationControls": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "remove-direct-region-classification",
          "use-weaker-control-returns",
          "remove-later-sibling-guard",
          "remove-wrapper-opcode-guard",
          "remove-wrapper-parent-ownership",
          "always-emit-subject-when-merge"
        ]
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["staticAuthority", "managedOracle", "rebuiltSelfhost", "finalStage2Stage3"],
      "properties": {
        "staticAuthority": { "const": "required" },
        "managedOracle": { "const": "required" },
        "rebuiltSelfhost": { "const": "required-before-candidate-fixed" },
        "finalStage2Stage3": { "const": "required-before-closed" }
      }
    }
  }
}
