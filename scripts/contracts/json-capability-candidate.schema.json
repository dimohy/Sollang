{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sollang.dev/contracts/json-capability-candidate.schema.json",
  "title": "Sollang JSON pending capability contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractSchema",
    "capabilityId",
    "authority",
    "implementationStatus",
    "productionImplemented",
    "module",
    "scope",
    "verifier"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractSchema": { "const": "scripts/contracts/json-capability-candidate.schema.json" },
    "capabilityId": {
      "enum": [
        "schema-driven-user-mapping",
        "float32-float64-conversion",
        "fixed-decimal-conversion"
      ]
    },
    "authority": { "const": "detail-authority" },
    "implementationStatus": { "enum": ["candidate-only", "blocked"] },
    "productionImplemented": { "const": false },
    "module": { "const": "stdlib/std/text/json.slg" },
    "scope": { "type": "string", "minLength": 1 },
    "fixture": { "type": "string", "minLength": 1 },
    "expected": { "type": "string", "minLength": 1 },
    "reflection": { "type": "string", "minLength": 1 },
    "model": {
      "type": "object",
      "properties": {
        "source": { "type": "string" }, "mapping": { "type": "string" }, "schemaAuthority": { "type": "string" },
        "fieldOrder": { "type": "string" }, "fieldNames": { "type": "string" }, "required": { "type": "string" },
        "optional": { "type": "string" }, "duplicateKnownField": { "type": "string" },
        "unknownMembers": { "type": "array", "items": { "type": "string" } },
        "enumRepresentation": { "type": "string" }, "unknownEnumTag": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ownership": {
      "type": "object",
      "properties": {
        "readerInput": { "type": "string" }, "ownedOutput": { "type": "string" }, "failure": { "type": "string" },
        "success": { "type": "string" }, "zeroCopyFollowup": { "type": "string" }
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "properties": {
        "reader": { "type": "array", "items": { "type": "string" } },
        "writer": { "type": "array", "items": { "type": "string" } },
        "validationOrder": { "type": "string" }
      },
      "additionalProperties": false
    },
    "transactionality": {
      "type": "object",
      "properties": {
        "reader": { "type": "string" }, "writer": { "type": "string" },
        "noConvenienceParser": { "type": "string" }, "arithmetic": { "type": "string" }
      },
      "additionalProperties": false
    },
    "fixtureCases": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "expected"],
        "properties": { "id": { "type": "string" }, "expected": { "type": "string" } },
        "additionalProperties": false
      }
    },
    "residual": { "type": "array", "items": { "type": "string" } },
    "probes": {
      "type": "object",
      "properties": {
        "control": { "type": "string" }, "dynamicParseBlocker": { "type": "string" },
        "classificationBlocker": { "type": "string" }, "formatBlocker": { "type": "string" },
        "wideIntermediateBlocker": { "type": "string" }, "readerBlocker": { "type": "string" },
        "writerBlocker": { "type": "string" }
      },
      "additionalProperties": false
    },
    "readerApi": { "type": "array", "items": { "type": "string" } },
    "writerApi": { "type": "array", "items": { "type": "string" } },
    "policy": {
      "type": "object",
      "properties": {
        "grammar": { "type": "string" }, "rounding": { "type": "string" }, "overflow": { "type": "string" },
        "underflow": { "type": "string" }, "negativeZero": { "type": "string" }, "finiteOnly": { "type": "string" },
        "format": { "type": "string" }, "exponent": { "type": "string" },
        "integerBoundary": {
          "type": "object",
          "properties": { "Float32": { "type": "string" }, "Float64": { "type": "string" } },
          "additionalProperties": false
        },
        "invalidSpellings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "requiredPortablePrimitives": { "type": "array", "items": { "type": "string" } },
    "rejectedImplementations": { "type": "array", "items": { "type": "string" } },
    "reference": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" }, "normalization": { "type": "string" },
        "tupleCount": { "type": "integer", "minimum": 1 }, "conversionTupleCount": { "type": "integer", "minimum": 1 },
        "arithmeticTupleCount": { "type": "integer", "minimum": 1 }, "path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "promotionGate": { "type": "string", "minLength": 1 },
    "type": {
      "type": "object",
      "properties": {
        "name": { "type": "string" }, "storage": { "type": "string" }, "precision": { "type": "string" },
        "scale": { "type": "string" }, "coefficientRange": { "type": "string" }, "value": { "type": "string" },
        "signedZero": { "type": "string" }, "forgeability": { "type": "string" }
      },
      "additionalProperties": false
    },
    "roundingModes": { "type": "array", "items": { "type": "string" } },
    "parse": {
      "type": "object",
      "properties": {
        "input": { "type": "string" }, "conversion": { "type": "string" }, "exactMode": { "type": "string" },
        "overflow": { "type": "string" }, "canonicalInput": { "type": "string" }
      },
      "additionalProperties": false
    },
    "format": {
      "type": "object",
      "properties": {
        "form": { "type": "string" }, "scale": { "type": "string" }, "integer": { "type": "string" },
        "zero": { "type": "string" }, "canonical": { "type": "string" }
      },
      "additionalProperties": false
    },
    "arithmetic": {
      "type": "object",
      "properties": {
        "addSubtract": { "type": "string" }, "multiply": { "type": "string" },
        "rescale": { "type": "string" }, "overflow": { "type": "string" }
      },
      "additionalProperties": false
    },
    "jsonApi": { "type": "array", "items": { "type": "string" } },
    "schemaMapping": {
      "type": "object",
      "properties": {
        "fieldContract": { "type": "string" }, "read": { "type": "string" },
        "write": { "type": "string" }, "ownership": { "type": "string" }
      },
      "additionalProperties": false
    },
    "requiredPrimitive": { "type": "string", "minLength": 1 },
    "blockerIds": { "type": "array", "items": { "type": "string" } },
    "verifier": {
      "type": "object",
      "required": ["path", "total"],
      "properties": {
        "path": { "type": "string", "pattern": "^scripts/verify-json-.*\\.ps1$" },
        "total": { "type": "integer", "minimum": 1 },
        "staticChecks": { "type": "integer", "minimum": 1 },
        "isolatedCaseChecks": { "type": "integer", "minimum": 1 },
        "referenceTupleChecks": { "type": "integer", "minimum": 1 },
        "referenceChecks": { "type": "integer", "minimum": 1 },
        "capabilityChecks": { "type": "integer", "minimum": 1 },
        "inputStabilityChecks": { "type": "integer", "minimum": 1 },
        "expectedStatus": { "type": "string", "minLength": 1 },
        "expectedCapabilityStatus": { "type": "string", "minLength": 1 },
        "failureIds": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
