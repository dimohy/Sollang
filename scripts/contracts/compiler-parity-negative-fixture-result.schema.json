{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gate",
    "state",
    "source",
    "expected",
    "sourceSha256",
    "expectedSha256",
    "managedCompilerPath",
    "selfhostCompilerPath",
    "llvmRoot",
    "stdlibRoot",
    "timeoutMilliseconds",
    "managedCompilerSha256",
    "selfhostCompilerSha256",
    "inputFingerprintStart",
    "inputFingerprintEnd",
    "inputsStable",
    "logs",
    "managed",
    "selfhost",
    "orphanProcessIds",
    "failureId",
    "failure"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "gate": {
      "const": "compiler-parity-negative-fixture"
    },
    "state": {
      "enum": [
        "running",
        "passed",
        "failed",
        "phase-captured"
      ]
    },
    "source": {
      "$ref": "#/$defs/path"
    },
    "sourceManifest": {
      "oneOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "expected": {
      "$ref": "#/$defs/path"
    },
    "managedCompilerPath": {
      "$ref": "#/$defs/path"
    },
    "selfhostCompilerPath": {
      "$ref": "#/$defs/path"
    },
    "llvmRoot": {
      "$ref": "#/$defs/path"
    },
    "stdlibRoot": {
      "$ref": "#/$defs/path"
    },
    "timeoutMilliseconds": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 3600000
    },
    "sourceSha256": {
      "$ref": "#/$defs/sha"
    },
    "expectedSha256": {
      "$ref": "#/$defs/sha"
    },
    "managedCompilerSha256": {
      "$ref": "#/$defs/sha"
    },
    "selfhostCompilerSha256": {
      "$ref": "#/$defs/sha"
    },
    "inputFingerprintStart": {
      "$ref": "#/$defs/sha"
    },
    "inputFingerprintEnd": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputsStable": {
      "type": "boolean"
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managedStdout",
        "managedStderr",
        "selfhostStdout",
        "selfhostStderr"
      ],
      "properties": {
        "managedStdout": {
          "$ref": "#/$defs/path"
        },
        "managedStderr": {
          "$ref": "#/$defs/path"
        },
        "selfhostStdout": {
          "$ref": "#/$defs/path"
        },
        "selfhostStderr": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "managed": {
      "oneOf": [
        {
          "$ref": "#/$defs/check"
        },
        {
          "type": "null"
        }
      ]
    },
    "selfhost": {
      "oneOf": [
        {
          "$ref": "#/$defs/check"
        },
        {
          "type": "null"
        }
      ]
    },
    "orphanProcessIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "failureId": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "NEGATIVE_PROCESS_ORPHANED",
        "NEGATIVE_PROCESS_TIMEOUT",
        "NEGATIVE_LOG_DRAIN_TIMEOUT",
        "NEGATIVE_PROCESS_INSPECTION_FAILED",
        "NEGATIVE_CHECK_FAILED"
      ]
    },
    "failure": {
      "type": [
        "string",
        "null"
      ]
    },
    "phaseCompilerSide": {
      "enum": [
        "managed",
        "selfhost"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "running"
          }
        }
      },
      "then": {
        "properties": {
          "inputFingerprintEnd": {
            "type": "null"
          },
          "inputsStable": {
            "const": false
          },
          "orphanProcessIds": {
            "maxItems": 0
          },
          "failureId": {
            "type": "null"
          },
          "failure": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "inputsStable": {
            "const": true
          },
          "inputFingerprintEnd": {
            "$ref": "#/$defs/sha"
          },
          "managed": {
            "$ref": "#/$defs/passingCheck"
          },
          "selfhost": {
            "$ref": "#/$defs/passingCheck"
          },
          "orphanProcessIds": {
            "maxItems": 0
          },
          "failureId": {
            "type": "null"
          },
          "failure": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "failureId": {
            "type": "string"
          },
          "failure": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "failureId": {
            "const": "NEGATIVE_PROCESS_ORPHANED"
          }
        },
        "required": [
          "failureId"
        ]
      },
      "then": {
        "properties": {
          "orphanProcessIds": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "phase-captured"
          }
        }
      },
      "then": {
        "required": [
          "phaseCompilerSide"
        ],
        "properties": {
          "inputsStable": {
            "const": true
          },
          "inputFingerprintEnd": {
            "$ref": "#/$defs/sha"
          },
          "orphanProcessIds": {
            "maxItems": 0
          },
          "failureId": {
            "type": "null"
          },
          "failure": {
            "type": "null"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "phaseCompilerSide": {
                  "const": "managed"
                }
              }
            },
            "then": {
              "properties": {
                "managed": {
                  "$ref": "#/$defs/passingCheck"
                },
                "selfhost": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "selfhost": {
                  "$ref": "#/$defs/passingCheck"
                },
                "managed": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exitCode",
        "nonzeroExit",
        "expectedInStderr",
        "noEmittedProducts",
        "generatedProducts",
        "outputDirectory",
        "stdoutPath",
        "stderrPath"
      ],
      "properties": {
        "exitCode": {
          "type": "integer"
        },
        "nonzeroExit": {
          "type": "boolean"
        },
        "expectedInStderr": {
          "type": "boolean"
        },
        "noEmittedProducts": {
          "type": "boolean"
        },
        "generatedProducts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "outputDirectory": {
          "$ref": "#/$defs/path"
        },
        "stdoutPath": {
          "$ref": "#/$defs/path"
        },
        "stderrPath": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "passingCheck": {
      "allOf": [
        {
          "$ref": "#/$defs/check"
        },
        {
          "properties": {
            "exitCode": {
              "not": {
                "const": 0
              }
            },
            "nonzeroExit": {
              "const": true
            },
            "expectedInStderr": {
              "const": true
            },
            "noEmittedProducts": {
              "const": true
            },
            "generatedProducts": {
              "maxItems": 0
            }
          }
        }
      ]
    }
  }
}
