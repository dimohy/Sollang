{
  "schemaVersion": 1,
  "dispatchPolicies": {
    "baseline-only": 0,
    "runtime-detect": 1,
    "fixed-features": 2
  },
  "architectures": {
    "x86_64": {
      "id": 1,
      "baselineMask": 1,
      "allowedMask": 1022,
      "features": [
        { "id": "sse2", "bit": 0, "managed": "Sse2", "llvm": "+sse2", "osState": "none" },
        { "id": "sse4.2", "bit": 1, "managed": "Sse42", "llvm": "+sse4.2", "osState": "none" },
        { "id": "pclmulqdq", "bit": 2, "managed": "Pclmulqdq", "llvm": "+pclmul", "osState": "none" },
        { "id": "aes", "bit": 3, "managed": "Aes", "llvm": "+aes", "osState": "none" },
        { "id": "sha", "bit": 4, "managed": "Sha", "llvm": "+sha", "osState": "none" },
        { "id": "avx", "bit": 5, "managed": "Avx", "llvm": "+avx", "osState": "xsave-xcr0-xmm-ymm" },
        { "id": "avx2", "bit": 6, "managed": "Avx2", "llvm": "+avx2", "requires": ["avx"], "osState": "xsave-xcr0-xmm-ymm" },
        { "id": "bmi2", "bit": 7, "managed": "Bmi2", "llvm": "+bmi2", "osState": "none" },
        { "id": "vaes", "bit": 8, "managed": "Vaes", "llvm": "+vaes", "requires": ["avx"], "osState": "xsave-xcr0-xmm-ymm" },
        { "id": "vpclmulqdq", "bit": 9, "managed": "Vpclmulqdq", "llvm": "+vpclmulqdq", "requires": ["avx"], "osState": "xsave-xcr0-xmm-ymm" }
      ]
    },
    "arm64": {
      "id": 2,
      "baselineMask": 65536,
      "allowedMask": 983048,
      "features": [
        { "id": "neon", "bit": 16, "managed": "Neon", "llvm": "+neon", "linuxHwcap": "ASIMD" },
        { "id": "aes", "bit": 3, "managed": "Aes", "llvm": "+aes", "linuxHwcap": "AES" },
        { "id": "pmull", "bit": 17, "managed": "Pmull", "llvm": "+aes", "linuxHwcap": "PMULL" },
        { "id": "sha2", "bit": 18, "managed": "Sha2", "llvm": "+sha2", "linuxHwcap": "SHA2" },
        { "id": "crc", "bit": 19, "managed": "Crc", "llvm": "+crc", "linuxHwcap": "CRC32" }
      ]
    },
    "wasm32": {
      "id": 3,
      "baselineMask": 0,
      "allowedMask": 0,
      "features": [
        { "id": "simd128", "bit": 24, "managed": "Simd128", "llvm": "+simd128", "declaration": "build-target-capability" }
      ]
    }
  },
  "specializations": {
    "aes128-block": {
      "x86_64": { "required": ["sse2", "aes"] },
      "arm64": { "required": ["neon", "aes"] }
    },
    "aes128-gcm": {
      "x86_64": { "required": ["sse2", "aes", "pclmulqdq"] },
      "arm64": { "required": ["neon", "pmull"] }
    },
    "sha256": {
      "x86_64": { "required": ["sse2", "sha"] },
      "arm64": { "required": ["neon", "sha2"] }
    }
  }
}
