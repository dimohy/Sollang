{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "module", "sources", "fixtures", "surfaces", "invariants", "unsupported"],
  "properties": {
    "$schema": { "const": "portable-memory-io.schema.json" },
    "version": { "const": 5 },
    "module": { "const": "std.io" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "fixtures": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "surfaces": {
      "type": "array",
      "minItems": 24,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "invariants": {
      "type": "array",
      "minItems": 40,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "unsupported": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
