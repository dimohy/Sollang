{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "module", "status", "surfaces", "invariants", "fixtures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "module": { "const": "std.uri" },
    "status": { "enum": ["in-progress", "complete"] },
    "surfaces": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
    "invariants": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string", "minLength": 16 } },
    "fixtures": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 5 } }
  }
}
