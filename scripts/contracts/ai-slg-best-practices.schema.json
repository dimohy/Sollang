{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "document", "grammar", "grammarRuleInventory", "verificationFixture", "featureFamilies"],
  "properties": {
    "$schema": { "const": "ai-slg-best-practices.schema.json" },
    "version": { "const": 2 },
    "document": { "const": "docs/AI_SLG_BEST_PRACTICES.md" },
    "grammar": { "const": "syntax/sollang.grammar" },
    "grammarRuleInventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" }
    },
    "verificationFixture": { "const": "1218-ai-slg-best-practices" },
    "featureFamilies": {
      "type": "array",
      "minItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requiredTerms", "examples"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "requiredTerms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "examples": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^examples/(user|regression)/.+\\.slg$" }
          }
        }
      }
    }
  }
}
