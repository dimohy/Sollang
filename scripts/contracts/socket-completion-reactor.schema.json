{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "module",
    "blockerId",
    "status",
    "api",
    "capacity",
    "states",
    "transitions",
    "ownership",
    "registration",
    "completion",
    "platforms",
    "forbidden",
    "milestones",
    "verificationMatrix",
    "baseline"
  ],
  "properties": {
    "$schema": { "const": "socket-completion-reactor.schema.json" },
    "schemaVersion": { "const": 1 },
    "module": { "const": "std.net.socket" },
    "blockerId": { "const": "PORTABLE_SOCKET_COMPLETION_SUBMISSION" },
    "status": { "enum": ["blocked", "complete"] },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["globalConstructor", "reactorMethods", "slotMethods"],
      "properties": {
        "globalConstructor": { "type": "string", "minLength": 1 },
        "reactorMethods": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "type": "string" } },
        "slotMethods": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "minimum", "maximum", "relations", "failure"],
      "properties": {
        "fields": {
          "type": "array",
          "items": { "enum": ["registrations", "pendingOperations", "completionBatch"] },
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        },
        "minimum": { "const": 1 },
        "maximum": { "const": 1024 },
        "relations": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "failure": { "type": "string", "minLength": 1 }
      }
    },
    "states": {
      "type": "array",
      "items": { "enum": ["Vacant", "Pending", "Completed", "Cancelled"] },
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "transitions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "cause"],
        "properties": {
          "from": { "enum": ["Vacant", "Pending", "Completed", "Cancelled"] },
          "to": { "enum": ["Pending", "Completed", "Cancelled", "Vacant"] },
          "cause": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ownership": { "type": "array", "minItems": 6, "items": { "type": "string", "minLength": 1 } },
    "registration": { "type": "array", "minItems": 7, "items": { "type": "string", "minLength": 1 } },
    "completion": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 1 } },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows-x64", "linux-x64", "wasm32-browser"],
      "properties": {
        "windows-x64": { "$ref": "#/definitions/platform" },
        "linux-x64": { "$ref": "#/definitions/platform" },
        "wasm32-browser": { "$ref": "#/definitions/platform" }
      }
    },
    "forbidden": { "type": "array", "minItems": 6, "items": { "type": "string", "minLength": 1 } },
    "milestones": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "enum": ["configuration", "slot", "submission", "completion", "cancellation", "platformExecution"] },
          "status": { "enum": ["planned", "contracted", "implemented", "verified"] },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "verificationMatrix": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "kind", "expectation", "status"],
        "properties": {
          "id": { "pattern": "^(W0[1-7]|L0[1-8]|B0[1-2]|X0[1-5])$" },
          "target": { "enum": ["windows-x64", "linux-x64", "wasm32-browser", "semantic", "all-positive-native", "windows-x64+linux-x64"] },
          "kind": { "type": "string", "minLength": 1 },
          "expectation": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "passed"] }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitCommit", "sourceHashes"],
      "properties": {
        "gitCommit": { "const": "37f524b4" },
        "sourceHashes": {
          "type": "array",
          "minItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "pattern": "^[A-F0-9]{64}$" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "primitive", "semantics"],
      "properties": {
        "capability": { "enum": ["completion", "readiness", "unsupported"] },
        "primitive": { "type": "string", "minLength": 1 },
        "semantics": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
