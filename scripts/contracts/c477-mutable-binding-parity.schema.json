{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "gate", "negative", "positives"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gate": { "const": "c477-mutable-binding-parity" },
    "negative": { "$ref": "#/$defs/fixture" },
    "positives": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/fixture" } }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "sourceSha256", "expected", "expectedSha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "sourceSha256": { "$ref": "#/$defs/sha" },
        "expected": { "type": "string", "minLength": 1 },
        "expectedSha256": { "$ref": "#/$defs/sha" }
      }
    }
  }
}
