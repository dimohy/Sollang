{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "module", "fixture", "scope", "reference", "surfaces", "invariants", "allowedWindowsExternals", "referenceCases", "requiredFailureKinds", "negativeFixtures", "acceptance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "module": { "const": "stdlib/std/text/csv.slg" },
    "fixture": { "const": "1724-csv-bounded-writer" },
    "scope": { "const": "bounded-transactional-utf8-record-writer-over-caller-output" },
    "reference": { "const": "https://www.rfc-editor.org/rfc/rfc4180.html#section-2" },
    "surfaces": { "$ref": "#/$defs/names", "minItems": 5, "maxItems": 5 },
    "invariants": { "$ref": "#/$defs/names", "minItems": 14, "maxItems": 14 },
    "allowedWindowsExternals": {
      "$ref": "#/$defs/names", "minItems": 3, "maxItems": 3,
      "items": { "enum": ["GetStdHandle", "WriteFile", "llvm.trap"] }
    },
    "referenceCases": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "fields", "lineEnding"],
        "properties": {
          "label": { "enum": ["ascii", "quoted", "utf8", "spaces", "empty", "breaks", "lf"] },
          "fields": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "maxLength": 64 } },
          "lineEnding": { "enum": ["\r\n", "\n"] }
        }
      }
    },
    "requiredFailureKinds": {
      "$ref": "#/$defs/names", "minItems": 10, "maxItems": 10,
      "items": { "enum": ["InvalidLimits", "InvalidOptions", "InvalidRecord", "OutputLimit", "RecordLimit", "FieldCountLimit", "FieldSizeLimit", "ColumnCountMismatch", "InvalidControl", "OutputTooSmall"] }
    },
    "negativeFixtures": {
      "$ref": "#/$defs/names", "minItems": 2, "maxItems": 2,
      "items": { "enum": ["csv-writer-private-state-negative", "csv-writer-output-alias-negative"] }
    },
    "acceptance": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "names": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
