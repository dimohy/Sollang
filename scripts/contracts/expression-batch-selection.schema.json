{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit expression lowering fixture selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]{1,4}-[a-z0-9]+(?:-[a-z0-9]+)*$" }
    }
  }
}
