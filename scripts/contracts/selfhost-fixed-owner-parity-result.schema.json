{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "mode", "defectIds", "runStatus", "completionStatus",
    "completed", "total", "target", "compilerSha256", "seedCompilerSha256",
    "generationRecordSha256", "sourceFingerprint", "inputHashes", "cases",
    "failureIds"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "const": "selfhost-fixed-owner-parity" },
    "defectIds": {
      "const": ["C2026-09-06-328", "C2026-09-06-334", "C2026-09-06-335"]
    },
    "runStatus": { "enum": ["passed", "failed"] },
    "completionStatus": { "enum": ["complete", "in-progress"] },
    "completed": { "type": "integer", "minimum": 0, "maximum": 2 },
    "total": { "const": 2 },
    "target": { "const": "windows" },
    "compilerSha256": { "$ref": "#/$defs/sha256" },
    "seedCompilerSha256": { "$ref": "#/$defs/sha256" },
    "generationRecordSha256": { "$ref": "#/$defs/sha256" },
    "sourceFingerprint": { "$ref": "#/$defs/sha256" },
    "inputHashes": {
      "type": "object",
      "minProperties": 12,
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "passed", "sourceSha256", "expectedStdout",
          "expectedAllocationCount", "expectedPromotedBackingDropCalls",
          "compileExit", "stderrEmpty", "targetLlvmProduced", "diagnosticFree",
          "promotedBackingDropCalls",
          "llvmAsExit", "closureExit", "nativeLinkExit", "nativeExit",
          "nativeExact", "auditLinkExit", "auditExit", "allocationCount",
          "releaseCount", "invalidReleaseCount", "allocationBalanced", "failure"
        ],
        "properties": {
          "id": { "enum": ["PROJECTED_FACTORY_TEMPORARY", "INLINE_NAMED_FIXED_COPY"] },
          "passed": { "type": "boolean" },
          "sourceSha256": { "$ref": "#/$defs/sha256" },
          "expectedStdout": { "enum": ["7", "9"] },
          "expectedAllocationCount": { "enum": [0, 1] },
          "expectedPromotedBackingDropCalls": { "enum": [0, 1] },
          "compileExit": { "type": "integer" },
          "stderrEmpty": { "type": "boolean" },
          "targetLlvmProduced": { "type": "boolean" },
          "diagnosticFree": { "type": "boolean" },
          "promotedBackingDropCalls": { "type": ["integer", "null"], "minimum": 0 },
          "llvmAsExit": { "type": ["integer", "null"] },
          "closureExit": { "type": ["integer", "null"] },
          "nativeLinkExit": { "type": ["integer", "null"] },
          "nativeExit": { "type": ["integer", "null"] },
          "nativeExact": { "type": "boolean" },
          "auditLinkExit": { "type": ["integer", "null"] },
          "auditExit": { "type": ["integer", "null"] },
          "allocationCount": { "type": ["integer", "null"], "minimum": 0 },
          "releaseCount": { "type": ["integer", "null"], "minimum": 0 },
          "invalidReleaseCount": { "type": ["integer", "null"], "minimum": 0 },
          "allocationBalanced": { "type": "boolean" },
          "failure": { "type": ["string", "null"] }
        }
      }
    },
    "failureIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
  }
}
