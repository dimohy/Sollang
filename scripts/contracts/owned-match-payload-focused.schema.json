{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "defectId", "runnerCapability", "cases"],
  "properties": {
    "$schema": { "const": "owned-match-payload-focused.schema.json" },
    "schemaVersion": { "const": 1 },
    "defectId": { "const": "C2026-09-12-399" },
    "runnerCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option", "missingCapabilityFailureId"],
      "properties": {
        "option": { "const": "--compiler" },
        "missingCapabilityFailureId": { "const": "RUNNER_COMPILER_INJECTION_UNAVAILABLE" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "$ref": "#/$defs/p1723" },
        { "$ref": "#/$defs/n1" },
        { "$ref": "#/$defs/n2" },
        { "$ref": "#/$defs/n3" },
        { "$ref": "#/$defs/n4" },
        { "$ref": "#/$defs/n5" }
      ],
      "items": false
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runnerId", "kind", "source", "expected"],
      "properties": {
        "id": { "type": "string" },
        "runnerId": { "type": "string" },
        "kind": { "enum": ["positive", "negative"] },
        "source": { "type": "string", "pattern": "\\.slg$" },
        "expected": { "type": "string", "pattern": "\\.(?:stdout|stderr\\.contains)\\.txt$" }
      }
    },
    "p1723": {
      "allOf": [
        { "$ref": "#/$defs/case" },
        { "properties": { "id": { "const": "P1723" }, "runnerId": { "const": "1723-owned-match-payload-mutable-binding" }, "kind": { "const": "positive" } } }
      ]
    },
    "n1": { "allOf": [{ "$ref": "#/$defs/case" }, { "properties": { "id": { "const": "N1" }, "runnerId": { "const": "diagnostic/owned-match-payload-borrowed-binding" }, "kind": { "const": "negative" } } }] },
    "n2": { "allOf": [{ "$ref": "#/$defs/case" }, { "properties": { "id": { "const": "N2" }, "runnerId": { "const": "diagnostic/owned-match-payload-use-after-binding" }, "kind": { "const": "negative" } } }] },
    "n3": { "allOf": [{ "$ref": "#/$defs/case" }, { "properties": { "id": { "const": "N3" }, "runnerId": { "const": "diagnostic/owned-match-subject-use-after-binding" }, "kind": { "const": "negative" } } }] },
    "n4": { "allOf": [{ "$ref": "#/$defs/case" }, { "properties": { "id": { "const": "N4" }, "runnerId": { "const": "diagnostic/owned-match-nested-borrowed-binding" }, "kind": { "const": "negative" } } }] },
    "n5": { "allOf": [{ "$ref": "#/$defs/case" }, { "properties": { "id": { "const": "N5" }, "runnerId": { "const": "diagnostic/owned-match-shadowed-borrowed-binding" }, "kind": { "const": "negative" } } }] }
  }
}
