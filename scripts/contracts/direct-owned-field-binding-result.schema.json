{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defectId", "runStatus", "completionStatus", "completed", "total", "compilerSha256", "inputHashes", "cases", "failureIds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "defectId": { "const": "C2026-09-06-341" },
    "runStatus": { "enum": ["passed", "failed"] },
    "completionStatus": { "enum": ["complete", "in-progress"] },
    "completed": { "type": "integer", "minimum": 0, "maximum": 20 },
    "total": { "const": 20 },
    "compilerSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "inputHashes": { "type": "object", "minProperties": 20, "additionalProperties": { "type": "string", "pattern": "^[A-F0-9]{64}$" } },
    "cases": {
      "type": "array", "minItems": 20, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "passed", "sourceSha256", "compileExit", "warningNoteFree", "llvmProduced", "llvmAsExit", "closureExit", "nativeExit", "auditExit", "diagnosticMatched", "failure"],
        "properties": {
          "id": { "type": "string" }, "passed": { "type": "boolean" }, "sourceSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
          "compileExit": { "type": "integer" }, "warningNoteFree": { "const": true }, "llvmProduced": { "type": "boolean" }, "llvmAsExit": { "type": ["integer", "null"] },
          "closureExit": { "type": ["integer", "null"] }, "nativeExit": { "type": ["integer", "null"] }, "auditExit": { "type": ["integer", "null"] },
          "diagnosticMatched": { "type": ["boolean", "null"] }, "failure": { "type": ["string", "null"] }
        }
      }
    },
    "failureIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  }
}
