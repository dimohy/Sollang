{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "defectId", "phase", "status", "completed", "total", "compilerPath", "compilerSha256", "baselineCompilerSha256", "existingMatrix", "portableCase", "sourceHashes", "failureIds", "inputStable"],
  "properties": {
    "$schema": { "const": "../../c399-owned-payload-candidate-result.schema.json" },
    "schemaVersion": { "const": 1 },
    "defectId": { "const": "C2026-09-12-399" },
    "phase": { "const": "candidate-focused" },
    "status": { "const": "passed" },
    "completed": { "const": 7 },
    "total": { "const": 7 },
    "compilerPath": { "type": "string", "minLength": 1 },
    "compilerSha256": { "$ref": "#/$defs/sha256" },
    "baselineCompilerSha256": { "$ref": "#/$defs/sha256" },
    "existingMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultPath", "resultSha256", "completed", "total", "semanticNegativeIds", "failureIds", "inputStable"],
      "properties": {
        "resultPath": { "type": "string", "minLength": 1 },
        "resultSha256": { "$ref": "#/$defs/sha256" },
        "completed": { "const": 6 },
        "total": { "const": 6 },
        "semanticNegativeIds": { "const": ["N1", "N2", "N3", "N4", "N5"] },
        "failureIds": { "maxItems": 0 },
        "inputStable": { "const": true }
      }
    },
    "portableCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "sourceSha256", "expected", "expectedSha256", "auditSource", "auditSourceSha256", "baselineDiagnostic", "compileExit", "nativeExit", "stdoutSha256", "llvmSha256", "bitcodeSha256", "llvmAsExit", "closureExit", "allocations", "releases"],
      "properties": {
        "id": { "const": "P-PORTABLE-DIRECT-PENDING" },
        "source": { "type": "string", "minLength": 1 },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "expected": { "type": "string", "minLength": 1 },
        "expectedSha256": { "$ref": "#/$defs/sha256" },
        "auditSource": { "type": "string", "minLength": 1 },
        "auditSourceSha256": { "$ref": "#/$defs/sha256" },
        "baselineDiagnostic": { "const": "unknown runtime binding 'value'" },
        "compileExit": { "const": 0 },
        "nativeExit": { "const": 0 },
        "stdoutSha256": { "$ref": "#/$defs/sha256" },
        "llvmSha256": { "$ref": "#/$defs/sha256" },
        "bitcodeSha256": { "$ref": "#/$defs/sha256" },
        "llvmAsExit": { "const": 0 },
        "closureExit": { "const": 0 },
        "allocations": { "const": 6 },
        "releases": { "const": 6 }
      }
    },
    "sourceHashes": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/sha256" } },
    "failureIds": { "maxItems": 0 },
    "inputStable": { "const": true }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" } }
}
