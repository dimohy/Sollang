{
  "schemaVersion": 1,
  "scope": "Seven original ABI rejection controls and Unicode export metadata, actual DLL call and source import execution",
  "target": "windows-x64",
  "optimization": "O0",
  "jobs": 1,
  "wholeCaseSeconds": 180,
  "cases": [
    {
      "id": "readonly",
      "source": "scripts/probes/codegen-identity/library-export-readonly.slg",
      "diagnostic": "fixed-width-type"
    },
    {
      "id": "struct",
      "source": "scripts/probes/codegen-identity/library-export-struct.slg",
      "diagnostic": "fixed-width-type"
    },
    {
      "id": "fixed-array",
      "source": "scripts/probes/codegen-identity/library-export-fixed-array.slg",
      "diagnostic": "fixed-width-type"
    },
    {
      "id": "no-public",
      "source": "scripts/probes/codegen-identity/library-no-public.slg",
      "stderr": "sollang: a Sollang shared library must declare at least one public function\n"
    },
    {
      "id": "native-int",
      "source": "scripts/probes/codegen-identity/library-native-int.slg",
      "stderr": "sollang: public library function 'invalid' input type 'Int' is not ABI-safe; use Unit or a fixed-width numeric scalar\n"
    },
    {
      "id": "effects",
      "source": "scripts/probes/codegen-identity/library-effects.slg",
      "stderr": "sollang: public library function 'output' must not require effects\n"
    },
    {
      "id": "generic",
      "source": "scripts/probes/codegen-identity/library-generic.slg",
      "stderr": "sollang: type 'GenericParameter' is not a fixed-width library ABI type\n"
    }
  ],
  "positive": {
    "source": "scripts/probes/library-identifiers/unicode-export.slg",
    "calls": [
      {
        "export": "증가",
        "arguments": [
          6
        ],
        "expected": 7
      },
      {
        "export": "increment",
        "arguments": [
          8
        ],
        "expected": 9
      }
    ],
    "consumer": {
      "source": "scripts/probes/library-identifiers/unicode-consumer.slg",
      "stdout": "7\n8\n9\n10\n"
    },
    "metadataRejections": [
      {
        "id": "unicode-symbol",
        "member": "symbol",
        "value": "한글기호",
        "stderr": "sollang: invalid export name, qualified name, or symbol for 'increment' in '{interface}'\n"
      },
      {
        "id": "leading-digit-name",
        "member": "name",
        "value": "1증가",
        "stderr": "sollang: invalid export name, qualified name, or symbol for '1증가' in '{interface}'\n"
      },
      {
        "id": "punctuation-parameter",
        "member": "parameterName",
        "value": "값!",
        "stderr": "sollang: invalid or duplicate parameter name '값!' for 'increment' in '{interface}'\n"
      },
      {
        "id": "supplementary-parameter",
        "member": "parameterName",
        "value": "𐐀",
        "stderr": "sollang: invalid or duplicate parameter name '𐐀' for 'increment' in '{interface}'\n"
      }
    ]
  }
}
