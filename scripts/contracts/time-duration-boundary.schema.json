{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "module",
    "compilerHashPolicy",
    "fieldVisibility",
    "authoritativeFactories",
    "canonicalRfc3339Bytes",
    "platformContract",
    "directConstructionInventory",
    "trackedInputs"
  ],
  "properties": {
    "$schema": { "const": "time-duration-boundary.schema.json" },
    "version": { "const": 2 },
    "module": { "const": "std.time.Duration" },
    "compilerHashPolicy": { "const": "snapshot-start-equals-every-case-and-end" },
    "fieldVisibility": { "const": "module-private" },
    "authoritativeFactories": {
      "const": ["milliseconds", "seconds", "minutes", "hours"]
    },
    "canonicalRfc3339Bytes": {
      "const": ["-", "-", "T", ":", ":", ".", "Z"]
    },
    "platformContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritativeTotal", "windows", "linux", "browser", "optimizations", "browserClockCapabilityFixture", "browserUnavailableDiagnostic", "positiveCases", "browserExecutionCases", "browserUnavailableCases", "privateConstructionCase", "unsupported", "blockers"],
      "properties": {
        "authoritativeTotal": { "const": 30 },
        "windows": { "const": { "exactExecutions": 12, "exactDiagnostics": 1, "total": 13 } },
        "linux": { "const": { "exactExecutions": 10, "exactDiagnostics": 1, "total": 11 } },
        "browser": { "const": { "exactExecutions": 2, "unavailableDiagnostics": 3, "exactDiagnostics": 1, "total": 6 } },
        "optimizations": { "const": ["O0", "O2"] },
        "browserClockCapabilityFixture": { "const": "1390-browser-time-domain-separation" },
        "browserUnavailableDiagnostic": { "const": "child processes are unavailable on the current target" },
        "positiveCases": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/executionCase" }
        },
        "browserExecutionCases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source", "expected"],
            "properties": {
              "id": { "const": "browser-time-domain-separation" },
              "source": { "const": "examples/regression/1390-browser-time-domain-separation.slg" },
              "expected": { "const": "examples/regression/expected/1390-browser-time-domain-separation.stdout.txt" }
            }
          }
        },
        "browserUnavailableCases": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source"],
            "properties": {
              "id": { "type": "string", "minLength": 3 },
              "source": { "type": "string", "pattern": "^examples/regression/.+\\.slg$" }
            }
          }
        },
        "privateConstructionCase": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "source", "diagnostic"],
          "properties": {
            "id": { "const": "duration-private-construction" },
            "source": { "const": "examples/regression/diagnostics/time-duration-private-construction.slg" },
            "diagnostic": { "const": "sollang: semantic error at 4:5: [module '<main>'] cannot construct struct 'std.time.Duration' outside module 'std.time' because field 'millis' is private; use its public factory or public instance methods" }
          }
        },
        "unsupported": { "const": [] },
        "blockers": { "const": ["transitive-sys-path-semantic-compatibility", "rebuilt-selfhost", "stage2", "stage3"] }
      }
    },
    "directConstructionInventory": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "count", "classification"],
        "properties": {
          "path": { "type": "string", "minLength": 3 },
          "count": { "type": "integer", "minimum": 1 },
          "classification": {
            "enum": [
              "declaring-module",
              "embedded-declaring-module",
              "intentional-external-forgery"
            ]
          }
        }
      }
    },
    "trackedInputs": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 3 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "$defs": {
    "executionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "expected", "targets"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "source": { "type": "string", "pattern": "^examples/regression/.+\\.slg$" },
        "expected": { "type": "string", "pattern": "^examples/regression/expected/.+\\.stdout\\.txt$" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["windows-x64", "linux-x64"] }
        }
      }
    }
  }
}
