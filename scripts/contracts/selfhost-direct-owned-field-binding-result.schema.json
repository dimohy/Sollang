{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "mode", "defectId", "runStatus", "completionStatus",
    "completed", "total", "target", "compilerSha256", "seedCompilerSha256",
    "generationRecordSha256", "sourceFingerprint", "inputHashes", "cases",
    "failureIds"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "const": "selfhost-direct-owned-field-binding" },
    "defectId": { "const": "C2026-09-06-341" },
    "runStatus": { "enum": ["passed", "failed"] },
    "completionStatus": { "enum": ["complete", "in-progress"] },
    "completed": { "type": "integer", "minimum": 0, "maximum": 20 },
    "total": { "const": 20 },
    "target": { "const": "windows" },
    "compilerSha256": { "$ref": "#/$defs/sha256" },
    "seedCompilerSha256": { "$ref": "#/$defs/sha256" },
    "generationRecordSha256": { "$ref": "#/$defs/sha256" },
    "sourceFingerprint": { "$ref": "#/$defs/sha256" },
    "inputHashes": {
      "type": "object",
      "minProperties": 23,
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "kind", "passed", "sourceSha256", "compileExit", "stderrEmpty", "warningNoteFree",
          "targetLlvmProduced", "diagnosticOnlyOutput", "commentOnlyDiagnostic", "diagnosticCount", "expectedDiagnosticCode",
          "diagnosticMatched", "llvmAsExit", "closureExit", "nativeExit", "auditExit",
          "failure"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["positive", "negative"] },
          "passed": { "type": "boolean" },
          "sourceSha256": { "$ref": "#/$defs/sha256" },
          "compileExit": { "type": "integer" },
          "stderrEmpty": { "type": "boolean" },
          "warningNoteFree": { "const": true },
          "targetLlvmProduced": { "type": "boolean" },
          "diagnosticOnlyOutput": { "type": "boolean" },
          "commentOnlyDiagnostic": { "type": "boolean" },
          "diagnosticCount": { "type": "integer", "minimum": 0, "maximum": 1 },
          "expectedDiagnosticCode": { "type": ["string", "null"], "pattern": "^E(17|34|36)$" },
          "diagnosticMatched": { "type": ["boolean", "null"] },
          "llvmAsExit": { "type": ["integer", "null"] },
          "closureExit": { "type": ["integer", "null"] },
          "nativeExit": { "type": ["integer", "null"] },
          "auditExit": { "type": ["integer", "null"] },
          "failure": { "type": ["string", "null"] }
        }
      }
    },
    "failureIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
  }
}
