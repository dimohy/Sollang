{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "status", "authority", "compilerSource", "helper", "staticResultSchema", "managedResultSchema", "cases", "acceptance"],
  "properties": {
    "$schema": { "const": "typed-block-mutable-borrow.schema.json" },
    "schemaVersion": { "const": 1 },
    "status": { "const": "production-source-fixed-integrated-candidate-pending" },
    "authority": { "type": "string", "minLength": 1 },
    "compilerSource": { "const": "src/Sollang.Compiler/Semantics/SemanticCompiler.cs" },
    "helper": { "const": "MutableBorrowBindingNames" },
    "staticResultSchema": { "const": "scripts/contracts/typed-block-mutable-borrow-static-result.schema.json" },
    "managedResultSchema": { "const": "scripts/contracts/typed-block-mutable-borrow-managed-result.schema.json" },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "source"],
          "properties": {
            "id": { "const": "P-PRIMARY-MUT" },
            "kind": { "const": "compile-success" },
            "source": { "const": "scripts/probes/typed-block-mutable-borrow/primary-mutable-receiver.slg" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "source"],
          "properties": {
            "id": { "const": "P-ADDITIONAL-MUT" },
            "kind": { "const": "compile-success" },
            "source": { "const": "scripts/probes/typed-block-mutable-borrow/additional-mutable-parameter.slg" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "source", "expected"],
          "properties": {
            "id": { "const": "N-ADDITIONAL-READONLY" },
            "kind": { "const": "compile-failure" },
            "source": { "const": "scripts/probes/typed-block-mutable-borrow/additional-readonly-negative.slg" },
            "expected": { "const": "scripts/probes/typed-block-mutable-borrow/additional-readonly-negative.stderr.contains.txt" }
          }
        }
      ],
      "items": false
    },
    "acceptance": { "type": "string", "minLength": 1 }
  }
}
