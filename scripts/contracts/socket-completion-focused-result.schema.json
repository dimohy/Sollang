{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["runStatus", "completionStatus", "completed", "total", "passedCaseIds", "failureIds", "inputHashes", "probes"],
  "properties": {
    "runStatus": { "enum": ["passed", "failed"] },
    "completionStatus": { "enum": ["in-progress", "complete"] },
    "completed": { "type": "integer", "minimum": 0, "maximum": 22 },
    "total": { "const": 22 },
    "passedCaseIds": { "type": "array", "uniqueItems": true, "items": { "enum": ["W01", "B01", "B02", "X01", "X02"] } },
    "failureIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "inputHashes": {
      "type": "object", "additionalProperties": false,
      "required": ["compiler", "contract", "resultSchema", "b01Source", "b01Expected", "x01Source", "x01Expected", "x01ReactorSource", "x01ReactorExpected", "x01StreamSource", "x01StreamExpected", "x02Source", "w01Source", "w01Verifier", "w01ResultSchema"],
      "properties": {
        "compiler": { "pattern": "^[A-F0-9]{64}$" }, "contract": { "pattern": "^[A-F0-9]{64}$" }, "resultSchema": { "pattern": "^[A-F0-9]{64}$" },
        "b01Source": { "pattern": "^[A-F0-9]{64}$" },
        "b01Expected": { "pattern": "^[A-F0-9]{64}$" }, "x01Source": { "pattern": "^[A-F0-9]{64}$" }, "x01Expected": { "pattern": "^[A-F0-9]{64}$" },
        "x01ReactorSource": { "pattern": "^[A-F0-9]{64}$" }, "x01ReactorExpected": { "pattern": "^[A-F0-9]{64}$" },
        "x01StreamSource": { "pattern": "^[A-F0-9]{64}$" }, "x01StreamExpected": { "pattern": "^[A-F0-9]{64}$" },
        "x02Source": { "pattern": "^[A-F0-9]{64}$" }, "w01Source": { "pattern": "^[A-F0-9]{64}$" },
        "w01Verifier": { "pattern": "^[A-F0-9]{64}$" }, "w01ResultSchema": { "pattern": "^[A-F0-9]{64}$" }
      }
    },
    "probes": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["caseId", "source", "sourceSha256", "compileExitCode", "nativeExitCode", "stdout", "llvmAsExitCode", "closureExitCode", "llvmSha256", "outputSha256"],
        "properties": {
          "caseId": { "enum": ["W01", "B01", "B02", "X01", "X02"] }, "source": { "type": "string" }, "sourceSha256": { "pattern": "^[A-F0-9]{64}$" },
          "compileExitCode": { "type": "integer" }, "nativeExitCode": { "type": ["integer", "null"] }, "stdout": { "type": "array", "items": { "type": "string" } },
          "llvmAsExitCode": { "type": ["integer", "null"] }, "closureExitCode": { "type": ["integer", "null"] },
          "llvmSha256": { "type": ["string", "null"], "pattern": "^[A-F0-9]{64}$" }, "outputSha256": { "type": ["string", "null"], "pattern": "^[A-F0-9]{64}$" }
        }
      }
    }
  }
}
