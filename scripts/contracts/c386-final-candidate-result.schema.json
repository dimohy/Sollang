    "fixture": { "type": "object", "additionalProperties": false, "required": ["id", "compileExit", "llvmAsExit", "v004Exit", "linkExit", "nativeExit", "stdoutSha256", "expectedStdoutSha256", "stdoutExact", "stderrSha256", "llvmSha256", "executableSha256"], "properties": { "id": { "const": "1702-selfhost-parallel-comparison-materialization" }, "compileExit": { "type": ["integer", "null"] }, "llvmAsExit": { "type": ["integer", "null"] }, "v004Exit": { "type": ["integer", "null"] }, "linkExit": { "type": ["integer", "null"] }, "nativeExit": { "type": ["integer", "null"] }, "stdoutSha256": { "$ref": "#/$defs/sha" }, "expectedStdoutSha256": { "$ref": "#/$defs/sha" }, "stdoutExact": { "type": "boolean" }, "stderrSha256": { "$ref": "#/$defs/sha" }, "llvmSha256": { "type": ["string", "null"], "pattern": "^[A-F0-9]{64}$" }, "executableSha256": { "type": ["string", "null"], "pattern": "^[A-F0-9]{64}$" } } },
    "canonicalPassed": { "allOf": [{ "$ref": "#/$defs/canonical" }, { "properties": { "completed": { "const": 5 }, "exitCode": { "const": 0 } } }] },
    "parityPassed": { "allOf": [{ "$ref": "#/$defs/parity" }, { "properties": { "completed": { "const": 2 }, "nodeCount": { "const": 942 }, "exitCode": { "const": 0 } } }] },
