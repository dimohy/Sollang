{
  "$schema": "time-api.schema.json",
  "version": 1,
  "module": "std.time",
  "runtimeModule": "sys.runtime",
  "officialReferences": [
    "https://learn.microsoft.com/en-us/dotnet/standard/datetime/timeprovider-overview",
    "https://doc.rust-lang.org/stable/std/time/struct.Instant.html",
    "https://pkg.go.dev/time",
    "https://docs.oracle.com/en/java/javase/25/docs/api/java.base/java/time/Clock.html"
  ],
  "implementedSurfaces": [
    "Duration.checkedAdd",
    "Duration.checkedSub",
    "Duration.checkedMultiply",
    "Duration.checkedDivide",
    "Duration.absoluteDifference",
    "Duration.sleep",
    "MonotonicClock.now",
    "MonotonicInstant.durationSince",
    "WallClock.now",
    "UtcInstant.durationSince",
    "ManualClock.now",
    "ManualClock.advance",
    "ManualWallClock.now",
    "ManualWallClock.set",
    "manualClock",
    "MonotonicInstant.sourceIdentity",
    "MonotonicInstant.sameSource",
    "MonotonicClock.deadlineAfter",
    "ManualClock.deadlineAfter",
    "Deadline.remaining",
    "Deadline.isDue",
    "FixedClock.now",
    "OffsetClock.now"
  ],
  "invariants": [
    "std.time is the only public time namespace",
    "sys.runtime exposes only irreducible clock and timer ABI operations",
    "elapsed time and deadlines never use a wall clock",
    "monotonic readings are never serialized or converted to Unix epoch values",
    "readings from different monotonic sources cannot be compared without a typed error",
    "system and injected clocks are concrete instances with static dispatch and no heap wrapper",
    "duration arithmetic is checked and never traps or silently saturates",
    "sleep is consuming asynchronous suspension and never a blocking compatibility shim",
    "periodic timers have explicit missed-tick and bounded wake policies",
    "target resolution suspend behavior and maximum delay are observable capabilities"
  ],
  "orderedSlices": [
    {
      "id": "T1",
      "status": "pending",
      "title": "clock capabilities and precision",
      "requiredSurfaces": [
        "ClockCapabilities.resolution",
        "ClockCapabilities.suspendPolicy",
        "ClockCapabilities.maximumDelay",
        "MonotonicClock.capabilities",
        "WallClock.capabilities"
      ]
    },
    {
      "id": "T2",
      "status": "in-progress",
      "title": "monotonic source identity",
      "requiredSurfaces": [
        "DifferentClock",
        "source-bound MonotonicInstant"
      ]
    },
    {
      "id": "T3",
      "status": "in-progress",
      "title": "monotonic deadline",
      "requiredSurfaces": [
        "MonotonicClock.deadlineAfter",
        "Deadline.remaining",
        "Deadline.isDue"
      ]
    },
    {
      "id": "T4",
      "status": "pending",
      "title": "affine timer",
      "requiredSurfaces": [
        "MonotonicClock.timer",
        "Timer.wait",
        "Timer.cancel",
        "Timer.close",
        "MissedTickPolicy"
      ]
    },
    {
      "id": "T5",
      "status": "in-progress",
      "title": "injected fixed and offset clocks",
      "requiredSurfaces": [
        "FixedClock.now",
        "OffsetClock.now"
      ]
    },
    {
      "id": "T6",
      "status": "pending",
      "title": "network and process deadline integration",
      "requiredConsumers": [
        "std.net.socket",
        "std.net.quic",
        "std.net.http",
        "sys.process"
      ]
    }
  ],
  "targetPolicy": {
    "windows-x64": "native clock and timer capability required",
    "linux-x64": "native clock and timer capability required",
    "wasm32-browser": "explicit host capability or blocking diagnostic required"
  }
}
