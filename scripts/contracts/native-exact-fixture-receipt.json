{
  "schemaVersion": 1,
  "executionContract": {
    "optionalArgumentsSuffix": ".args.txt",
    "argumentsEncoding": "UTF-8",
    "argumentsFormat": "one-argument-per-line-preserve-empty-lines",
    "argumentsAffectInputFingerprint": true,
    "rejectArgumentsPresenceChangeDuringVerification": true,
    "requiredExitCode": 0,
    "requiredStderr": "empty"
  },
  "inputIdentity": {
    "orderedSettings": [
      "distribution",
      "expectedStdoutLength",
      "fixture",
      "jobs",
      "label",
      "nativeJobLimit",
      "platform",
      "processorCount"
    ],
    "orderedFileGroups": [
      "compiler",
      "fixtureSourceClosure",
      "stdlibSourceClosure",
      "expectedOutputAndLlvmContracts",
      "verificationScripts",
      "platformTools"
    ],
    "contentAlgorithm": "SHA-256",
    "pathNormalization": "repository-relative-forward-slash"
  },
  "fingerprintLayers": {
    "commonOncePerBatch": [
      "compiler",
      "stdlibSourceClosure",
      "verificationScripts",
      "platformTools",
      "nativeJobLimit",
      "processorCount"
    ],
    "perFixture": [
      "commonFingerprint",
      "fixtureSourceClosure",
      "expectedOutputAndLlvmContracts",
      "distribution",
      "expectedStdoutLength",
      "fixture",
      "jobs",
      "label",
      "platform"
    ]
  },
  "outputIdentity": {
    "requiredArtifacts": [
      "llvm",
      "bitcode",
      "executable"
    ],
    "contentAlgorithm": "SHA-256"
  },
  "platformEnvironment": {
    "windows": {
      "contentHashedTools": [
        "clang.exe",
        "llvm-as.exe",
        "llvm-lib.exe",
        "llvm-split.exe",
        "lld-link.exe"
      ]
    },
    "linux": {
      "reuseRequires": [
        "distribution-identity",
        "assembler-identity",
        "linker-identity"
      ],
      "unidentifiedEnvironmentPolicy": "rebuild"
    }
  },
  "publicationOrder": [
    "verify-warning-note-zero",
    "verify-direct-call-and-llvm-contracts",
    "assemble-bitcode",
    "execute-exact-output",
    "recheck-input-fingerprint",
    "publish-output-receipt",
    "publish-input-receipt-as-commit-marker"
  ],
  "reuseRules": [
    "reject-duplicate-fixture-writers-before-start",
    "require-current-input-and-all-output-hashes",
    "execute-cached-binary-and-compare-exact-output",
    "never-trust-artifacts-created-before-a-valid-input-receipt",
    "rebuild-only-the-mismatched-fixture",
    "do-not-reuse-across-unidentified-platform-environments"
  ]
}
