namespace std.compress.brotli.compressed_header

import std.compress.brotli.compressed_header as model
import std.compress.brotli.compressed_header.error as errors
import std.compress.brotli.context_map as context_maps
import std.compress.brotli.context_map.error as context_errors
import std.compress.brotli.literal_context as contexts
import std.compress.brotli.prefix_code as prefix_code
import std.compress.brotli.prefix_code.error as prefix_errors
import std.compress.brotli.prefix_table as prefix
import std.compress.brotli.prefix_table.error as table_errors
import std.compress.brotli.tree_group as tree_groups
import std.compress.brotli.tree_group.error as group_errors

public struct Error {
    public kind: errors.Kind
    public offset: UIntSize
}

public struct Limits {
    public maxBlockTypes: Int
    public maxBlockLength: Int
    public maxContextEntries: Int
    public maxTrees: Int
    public maxTableEntries: Int
    public maxTotalTableEntries: Int
}

public struct Parser {
    public prefixParser: prefix_code.Parser
    public contextParser: context_maps.Parser
    public treeParser: tree_groups.Parser
    public maxBlockTypes: Int
    public maxBlockLength: Int
    public maxTrees: Int
}

public enum PreludePhase {
    BlockHasValue
    BlockWidth
    BlockRemainder
    BlockPrefix
    DistancePostfix
    DirectDistanceGroups
    ContextMode
    LiteralMapHasTreeCount
    LiteralMapWidth
    LiteralMapRemainder
    LiteralMapPrefix
    DistanceMapHasTreeCount
    DistanceMapWidth
    DistanceMapRemainder
    DistanceMapPrefix
    Finished
}

# PreludeReader owns only semantic scalars. Encoded bytes remain owned by each
# caller and unread bits remain in the separately bounded prefix.Window.
public struct PreludeReader {
    public phase: PreludePhase
    public maxBlockTypes: Int
    public maxTrees: Int
    public blockIndex: Int
    public pendingWidth: Int
    public pendingCount: Int
    public literalBlockTypes: Int
    public commandBlockTypes: Int
    public distanceBlockTypes: Int
    public distancePostfixBits: Int
    public directDistanceCodes: Int
    public literalContextMode: contexts.Mode
    public literalTreeCount: Int
    public distanceTreeCount: Int
}

public struct Prelude {
    public literalBlockTypes: Int
    public commandBlockTypes: Int
    public distanceBlockTypes: Int
    public distancePostfixBits: Int
    public directDistanceCodes: Int
    public literalContextMode: contexts.Mode
    public literalTreeCount: Int
    public distanceTreeCount: Int
}

public enum PreludeRead {
    NeedMore(Int)
    NeedBlockPrefix(Int)
    NeedLiteralMapPrefix(Int)
    NeedDistanceMapPrefix(Int)
    Ready(Prelude)
}

public enum TableSlot {
    Absent
    Present(prefix.Table)
}

public enum BlockStreamPhase {
    HasTypeCount
    TypeCountWidth
    TypeCountRemainder
    TypePrefix
    LengthPrefix
    InitialLengthSymbol
    InitialLengthExtra
    Finished
}

# BlockStreamReader owns only bounded semantic state and installed prefix
# tables. Encoded bytes remain with the caller and unread bits remain in the
# shared scalar Window.
public struct BlockStreamReader {
    public prefixParser: prefix_code.Parser
    public maxBlockTypes: Int
    public maxBlockLength: Int
    public phase: BlockStreamPhase
    public pendingWidth: Int
    public typeCount: Int
    public lengthCode: Int
    public initialLength: Int
    public typeTable: TableSlot
    public lengthTable: TableSlot
}

public enum BlockStreamRead {
    NeedMore(Int)
    NeedPrefix(Int)
    Ready
}

public enum HeaderPhase {
    BlockStream
    DistancePostfix
    DirectDistanceGroups
    ContextMode
    PreludeReady
}

# HeaderReader composes exactly three BlockStreamReader instances in wire order.
# Completing a block is consuming so the finished table owners cannot remain
# aliased with the next active reader.
public struct HeaderReader {
    public parser: Parser
    public activeBlock: BlockStreamReader
    public phase: HeaderPhase
    public blockIndex: Int
    public blockStreams: [BlockStream; ~]
    public distancePostfixBits: Int
    public directDistanceCodes: Int
    public contextModes: [contexts.Mode; ~]
}

public enum HeaderRead {
    NeedMore(Int)
    NeedBlockPrefix(Int)
    NeedBlockFinish(Int)
    Ready
}

public struct HeaderPrelude {
    public blockStreams: [BlockStream; ~]
    public distancePostfixBits: Int
    public directDistanceCodes: Int
    public distanceCodeCount: Int
    public contextModes: [contexts.Mode; ~]
    public literalContextEntryCount: Int
}

public enum ContextPhase {
    LiteralMap
    DistanceMap
    Finished
}

public struct ContextReader {
    public prelude: HeaderPrelude
    public reader: context_maps.Reader
    public phase: ContextPhase
    public literalContextMap: [Int; ~]
    public distanceContextMap: [Int; ~]
    public literalTreeCount: Int
    public distanceTreeCount: Int
}

public enum ContextRead {
    NeedMore(Int)
    NeedPrefix(Int)
    Ready
}

public struct ContextPrelude {
    public blockStreams: [BlockStream; ~]
    public distancePostfixBits: Int
    public directDistanceCodes: Int
    public distanceCodeCount: Int
    public contextModes: [contexts.Mode; ~]
    public literalContextMap: [Int; ~]
    public distanceContextMap: [Int; ~]
    public literalTreeCount: Int
    public distanceTreeCount: Int
}

public enum TreePhase {
    Literal
    Command
    Distance
    Finished
}

public struct TreeReader {
    public prelude: ContextPrelude
    public reader: tree_groups.Reader
    public phase: TreePhase
    public literalTrees: [prefix.Table; ~]
    public commandTrees: [prefix.Table; ~]
    public distanceTrees: [prefix.Table; ~]
}

public enum TreeRead {
    NeedTree(Int)
    Ready
}

public struct BlockStream {
    public typeCount: Int
    public initialLength: Int
    public typeTable: TableSlot
    public lengthTable: TableSlot
}

public struct BlockSwitch {
    public typeIndex: Int
    public length: Int
    public position: prefix.Position
}

public struct Parsed {
    public blockStreams: [BlockStream; ~]
    public distancePostfixBits: Int
    public directDistanceCodes: Int
    public distanceCodeCount: Int
    public contextModes: [contexts.Mode; ~]
    public literalContextMap: [Int; ~]
    public distanceContextMap: [Int; ~]
    public literalTrees: [prefix.Table; ~]
    public commandTrees: [prefix.Table; ~]
    public distanceTrees: [prefix.Table; ~]
    public position: prefix.Position
}

struct Bits {
    value: Int
    position: prefix.Position
}

struct ParsedBlockStream {
    value: BlockStream
    position: prefix.Position
}

enum WindowBits {
    NeedMore(Int)
    Ready(Int)
}

