namespace std.compress.gzip.error

public enum Kind {
    InvalidLimit
    InputLimitExceeded
    OutputLimitExceeded
    ExpansionRatioExceeded
    MemberLimitExceeded
    TruncatedInput
    InvalidHeader
    InvalidHeaderChecksum
    UnsupportedCompressionMethod
    UnsupportedDeflateBlock
    InvalidHuffmanTree
    InvalidDeflateCode
    InvalidDistance
    InvalidStoredLength
    ChecksumMismatch
    SizeMismatch
    TrailingData
}
