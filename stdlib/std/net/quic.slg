public struct QuicError {
    public kind: errors.Kind
    public code: UInt64
}

public struct Identity {
    public seed: [UInt8; 32]
}

public struct Endpoint {
    public socket: socket.UdpSocket
    public local: net.Endpoint
    public listening: Bool
    public routes: [Route; ~]
    public pendingPackets: [socket.Datagram; ~]
    public maxPendingPackets: UIntSize
}

public struct ReceiveWindowSizes {
    public connection: UInt64
    public locallyInitiatedBidirectionalStream: UInt64
    public remotelyInitiatedBidirectionalStream: UInt64
    public unidirectionalStream: UInt64
}

public struct ConnectionOptions {
    public maxInboundBidirectionalStreams: UInt64
    public maxInboundUnidirectionalStreams: UInt64
    public pendingInboundBidirectionalStreams: Int
    public pendingInboundUnidirectionalStreams: Int
    public pendingApplicationFrames: Int
    public pendingApplicationBytes: UInt64
    public receiveWindows: ReceiveWindowSizes
}

public struct Listener {
    public identity: Identity
    public local: net.Endpoint
    public connectionOptions: ConnectionOptions
    public active: Bool
}

public struct Connection {
    public peerCertificate: [UInt8; ~]
    public local: net.Endpoint
    public peer: net.Endpoint
    public localIsServer: Bool
    public version: UInt32
    public originalDestinationConnectionId: [UInt8; 8]
    public localConnectionId: [UInt8; 8]
    public remoteConnectionId: [UInt8; 8]
    public sendKeys: application.KeyState
    public receiveKeys: application.KeyState
    public nextSendPacketNumber: UInt64
    public nextReceivePacketNumber: UInt64
    public clientPending: Bool
    public clientPrivateKey: [UInt8; 32]
    public clientHello: [UInt8; ~]
    public handshakeReceiveSecret: [UInt8; 32]
    public handshakeTranscript: [UInt8; ~]
    public awaitClientFinished: Bool
    public handshakeConfirmed: Bool
    public pendingApplicationPacket: [UInt8; ~]
    public pendingStreamFrames: reassembly.Queue
    public pendingResetStreams: [frames.ResetStream; ~]
    public pendingStopSending: [frames.StopSending; ~]
    public pendingDatagrams: [frames.Datagram; ~]
    public pendingMaxStreamData: [frames.MaxStreamData; ~]
    public pendingApplicationBytes: UInt64
    public pendingApplicationFrameLimit: Int
    public pendingApplicationByteLimit: UInt64
    public pendingApplicationAck: Bool
    public handshakeDonePending: Bool
    public sentPackets: packetRecovery.Journal
    public rtt: recovery.RttState
    public congestion: recovery.CongestionState
    public flow: streamState.ConnectionFlow
    public streams: streamState.StreamRegistry
    public localInitiatedStreamSendMaximum: UInt64
    public peerInitiatedStreamSendMaximum: UInt64
    public localInitiatedStreamReceiveMaximum: UInt64
    public peerInitiatedStreamReceiveMaximum: UInt64
    public localInitiatedUnidirectionalStreamSendMaximum: UInt64
    public peerInitiatedUnidirectionalStreamReceiveMaximum: UInt64
    public peerAckDelayExponent: UInt8
    public peerMaxAckDelay: UInt64
    public peerMaxDatagramFrameSize: UInt64
}

struct SendDirection {
    sendFlow: streamState.SendFlow
    writeFinished: Bool
    peerStoppedSend: Bool
    peerStoppedSendCode: UInt64
}

struct ReceiveDirection {
    receiveFlow: streamState.ReceiveFlow
    readFinished: Bool
    peerReset: Bool
    peerResetCode: UInt64
    localReadStopped: Bool
    localReadStoppedCode: UInt64
}

public struct BiStream {
    public streamId: UInt64
    public sendState: SendDirection
    public receiveState: ReceiveDirection
}

public struct SendStream {
    public streamId: UInt64
    public sendState: SendDirection
}

public struct ReceiveStream {
    public streamId: UInt64
    public receiveState: ReceiveDirection
}

struct Route {
    localKey: UInt64
    originalKey: UInt64
}

struct PacketRoute {
    destinationKey: UInt64
    kind: UInt8
}

pendingMatches packet: ref socket.Datagram, connectionId: [UInt8] -> Bool {
    connectionKey(connectionId, 0) => expectedKey
    packet.bytes[0] / 64 == 3 -> if {
        connectionKey(packet.bytes, 6) == expectedKey -> return
    }
    connectionKey(packet.bytes, 1) == expectedKey
}

pendingLocalRouteIndex endpoint: ref Endpoint, route: ref PacketRoute -> Int {
    routeLocalIndex(endpoint, route.destinationKey)
}

pendingOriginalRouteIndex endpoint: ref Endpoint, route: ref PacketRoute -> Int {
    routeOriginalIndex(endpoint, route.destinationKey)
}

struct PeerTransport {
    initialMaxData: UInt64
    initialMaxStreamDataBidiLocal: UInt64
    initialMaxStreamDataBidiRemote: UInt64
    initialMaxStreamDataUni: UInt64
    initialMaxStreamsBidi: UInt64
    initialMaxStreamsUni: UInt64
    maxUdpPayloadSize: UInt64
    ackDelayExponent: UInt8
    maxAckDelay: UInt64
    maxDatagramFrameSize: UInt64
}

socketFailure value: socket.SocketError -> QuicError {
    QuicError { kind: errors.Kind.Io, code: UInt64(value.code) }
}

protocolFailure value: errors.Error -> QuicError {
    QuicError { kind: value.kind, code: value.code }
}

internalFailure: -> QuicError => QuicError {
    kind: errors.Kind.Internal
    code: errors.internalError()
}

defaultConnectionOptions: -> ConnectionOptions => ConnectionOptions {
    maxInboundBidirectionalStreams: 16
    maxInboundUnidirectionalStreams: 16
    pendingInboundBidirectionalStreams: 16
    pendingInboundUnidirectionalStreams: 16
    pendingApplicationFrames: 64
    pendingApplicationBytes: 1_048_576
    receiveWindows: ReceiveWindowSizes {
        connection: 1_048_576
        locallyInitiatedBidirectionalStream: 262_144
        remotelyInitiatedBidirectionalStream: 262_144
        unidirectionalStream: 262_144
    }
}

invalidConnectionOption value: UInt64 -> QuicError => QuicError {
    kind: errors.Kind.InvalidArgument
    code: value
}

validatedConnectionOptions options: ConnectionOptions -> Result<ConnectionOptions, QuicError> {
    UInt64(0) => validBidirectionalStreamCount!
    options.maxInboundBidirectionalStreams -> transport.streamCount -> when {
        Err(error) {
            Result<ConnectionOptions, QuicError>.Err(invalidConnectionOption(
            options.maxInboundBidirectionalStreams)) -> return
        }
        Ok(count) { count -> value => validBidirectionalStreamCount! }
    }
    UInt64(0) => validUnidirectionalStreamCount!
    options.maxInboundUnidirectionalStreams -> transport.streamCount -> when {
        Err(error) {
            Result<ConnectionOptions, QuicError>.Err(invalidConnectionOption(
            options.maxInboundUnidirectionalStreams)) -> return
        }
        Ok(count) { count -> value => validUnidirectionalStreamCount! }
    }
    options.pendingInboundBidirectionalStreams > 0
        and options.pendingInboundUnidirectionalStreams > 0
        -> unless {
            Result<ConnectionOptions, QuicError>.Err(invalidConnectionOption(0)) -> return
        }
    options.pendingApplicationFrames > 0
        -> unless {
            Result<ConnectionOptions, QuicError>.Err(invalidConnectionOption(0)) -> return
        }
    options.receiveWindows.connection <= 4_611_686_018_427_387_903
        and options.receiveWindows.locallyInitiatedBidirectionalStream <= 4_611_686_018_427_387_903
        and options.receiveWindows.remotelyInitiatedBidirectionalStream <= 4_611_686_018_427_387_903
        and options.receiveWindows.unidirectionalStream <= 4_611_686_018_427_387_903
        -> unless {
            Result<ConnectionOptions, QuicError>.Err(
            invalidConnectionOption(options.receiveWindows.connection)) -> return
        }
    Result<ConnectionOptions, QuicError>.Ok(ConnectionOptions {
        maxInboundBidirectionalStreams: validBidirectionalStreamCount!
        maxInboundUnidirectionalStreams: validUnidirectionalStreamCount!
        pendingInboundBidirectionalStreams: options.pendingInboundBidirectionalStreams
        pendingInboundUnidirectionalStreams: options.pendingInboundUnidirectionalStreams
        pendingApplicationFrames: options.pendingApplicationFrames
        pendingApplicationBytes: options.pendingApplicationBytes
        receiveWindows: options.receiveWindows
    })
}

initialConnectionStreams localIsServer: Bool, peerBidirectionalLimit: UInt64, peerUnidirectionalLimit: UInt64, options: ConnectionOptions -> Result<streamState.StreamRegistry, QuicError> {
    streamState.initialStreamRegistry(
    localIsServer,
    options.maxInboundBidirectionalStreams,
    options.maxInboundUnidirectionalStreams,
    peerBidirectionalLimit,
    peerUnidirectionalLimit,
    options.pendingInboundBidirectionalStreams,
    options.pendingInboundUnidirectionalStreams) -> when {
        Ok(value) { Result<streamState.StreamRegistry, QuicError>.Ok(value) }
        Err(error) { Result<streamState.StreamRegistry, QuicError>.Err(protocolFailure(error)) }
    }
}

# Numeric endpoints are copied field-for-field. This is allocation-free and
# prevents a local address borrowed from Endpoint from escaping into another
# independently owned QUIC resource.
copyNetEndpoint endpoint: net.Endpoint -> net.Endpoint => endpoint -> when {
    V4(value) => net.Endpoint.V4(net.Ipv4Endpoint {
        address: net.Ipv4Address {
            a: value.address.a
            b: value.address.b
            c: value.address.c
            d: value.address.d
        }
        port: value.port
    })
    V6(value) => net.Endpoint.V6(net.Ipv6Endpoint {
        address: net.Ipv6Address {
            a: value.address.a
            b: value.address.b
            c: value.address.c
            d: value.address.d
            e: value.address.e
            f: value.address.f
            g: value.address.g
            h: value.address.h
        }
        port: value.port
        flowInfo: value.flowInfo
        scopeId: value.scopeId
    })
}

copy8 bytes: [UInt8] -> [UInt8; 8] {
    [UInt8(0); 8] => copied!
    0 => index!
    index! < 8 -> while {
        bytes[index!] => copied![index!]
        index! + 1 => index!
    }
    copied!
}

connectionKey bytes: [UInt8], offset: UIntSize -> UInt64 {
    UInt64(0) => key!
    UIntSize(0) => index!
    index! < 8 -> while {
        key! * 256 + UInt64(bytes[Int(offset + index!)]) => key!
        index! + 1 => index!
    }
    key!
}

copy32 bytes: [UInt8] -> [UInt8; 32] {
    [UInt8(0); 32] => copied!
    0 => index!
    index! < 32 -> while {
        bytes[index!] => copied![index!]
        index! + 1 => index!
    }
    copied!
}

random8: -> Result<[UInt8; 8], QuicError> uses Random {
    random.secure() -> bytes(8) -> when {
        Ok(bytes) { Result<[UInt8; 8], QuicError>.Ok(copy8(bytes)) }
        Err(randomError) { Result<[UInt8; 8], QuicError>.Err(internalFailure()) }
    }
}

random32: -> Result<[UInt8; 32], QuicError> uses Random {
    random.secure() -> bytes(32) -> when {
        Ok(bytes) { Result<[UInt8; 32], QuicError>.Ok(copy32(bytes)) }
        Err(randomError) { Result<[UInt8; 32], QuicError>.Err(internalFailure()) }
    }
}

appendBytes output: mut [UInt8; ~], bytes: [UInt8] -> Unit {
    0 => index!
    index! < (bytes -> len) -> while {
        output -> push(bytes[index!])
        index! + 1 => index!
    }
}

struct HandshakeMessage {
    bytes: [UInt8; ~]
    nextOffset: UIntSize
}

handshakeMessage bytes: [UInt8], offset: UIntSize -> Result<HandshakeMessage, QuicError> {
    handshakeMessages.decode(bytes, offset) -> when {
        Ok(decoded) {
            [UInt8; ~] => message!
            offset => index!
            index! < decoded.nextOffset -> while {
                message! -> push(bytes[Int(index!)])
                index! + 1 => index!
            }
            Result<HandshakeMessage, QuicError>.Ok(HandshakeMessage {
                bytes: message!
                nextOffset: decoded.nextOffset
            })
        }
        Err(value) { Result<HandshakeMessage, QuicError>.Err(protocolFailure(value)) }
    }
}

encodeHandshakePacket version: UInt32, destinationConnectionId: [UInt8], sourceConnectionId: [UInt8], bytes: [UInt8], secret: [UInt8; 32] -> Result<[UInt8; ~], QuicError> {
    handshakeEngine.encode(
    version,
    destinationConnectionId,
    sourceConnectionId,
    0,
    0,
    bytes,
    secret) -> when {
        Ok(packet) { packet -> Result<[UInt8; ~], QuicError>.Ok }
        Err(value) { Result<[UInt8; ~], QuicError>.Err(protocolFailure(value)) }
    }
}

sendPacket socketValue: socket.UdpSocket, peer: net.Endpoint, bytes: ref [UInt8; ~] -> Result<Unit, QuicError> uses Network {
    socketValue -> sendTo(peer, bytes) -> when {
        Ok(count) {
            count == UIntSize(bytes -> len) -> if {
                Result<Unit, QuicError>.Ok
            } else { Result<Unit, QuicError>.Err(internalFailure()) }
        }
        Err(sendError) { Result<Unit, QuicError>.Err(socketFailure(sendError)) }
    }
}

receivePacket socketValue: socket.UdpSocket -> Result<socket.Datagram, QuicError> uses Network {
    socketValue -> receiveFrom(65_535) -> when {
        Ok(datagram) { Result<socket.Datagram, QuicError>.Ok(datagram) }
        Err(receiveError) { Result<socket.Datagram, QuicError>.Err(socketFailure(receiveError)) }
    }
}

# QUIC long headers carry an explicit CID length. This transport currently
# issues fixed eight-byte CIDs, which also makes short-header routing a direct
# eight-byte comparison without per-packet allocation.
packetRoute datagram: ref socket.Datagram -> Result<PacketRoute, QuicError> {
    UIntSize(datagram.bytes -> len) >= 1 -> unless {
        Result<PacketRoute, QuicError>.Err(QuicError {
            kind: errors.Kind.Truncated
            code: 0
        }) -> return
    }
    datagram.bytes[0] / 64 == 3 -> if {
        UIntSize(datagram.bytes -> len) >= 6 -> unless {
            Result<PacketRoute, QuicError>.Err(QuicError {
                kind: errors.Kind.Truncated
                code: UInt64(datagram.bytes -> len)
            }) -> return
        }
        datagram.bytes[5] == 8 -> unless {
            Result<PacketRoute, QuicError>.Err(QuicError {
                kind: errors.Kind.ProtocolViolation
                code: UInt64(datagram.bytes[5])
            }) -> return
        }
        UIntSize(datagram.bytes -> len) >= 14 -> unless {
            Result<PacketRoute, QuicError>.Err(QuicError {
                kind: errors.Kind.Truncated
                code: UInt64(datagram.bytes -> len)
            }) -> return
        }
        packets.longHeaderKind(datagram.bytes) -> when {
            Ok(kind) {
                Result<PacketRoute, QuicError>.Ok(PacketRoute {
                    destinationKey: connectionKey(datagram.bytes, 6)
                    kind: kind
                })
            }
            Err(value) { Result<PacketRoute, QuicError>.Err(protocolFailure(value)) }
        }
    } else {
        UIntSize(datagram.bytes -> len) >= 9 -> unless {
            Result<PacketRoute, QuicError>.Err(QuicError {
                kind: errors.Kind.Truncated
                code: UInt64(datagram.bytes -> len)
            }) -> return
        }
        Result<PacketRoute, QuicError>.Ok(PacketRoute {
            destinationKey: connectionKey(datagram.bytes, 1)
            kind: 4
        })
    }
}

routeLocalIndex endpoint: ref Endpoint, key: UInt64 -> Int {
    0 => index!
    index! < (endpoint.routes -> len) -> while {
        endpoint.routes[index!].localKey == key -> if { index! -> return }
        index! + 1 => index!
    }
    -1
}

routeOriginalIndex endpoint: ref Endpoint, key: UInt64 -> Int {
    0 => index!
    index! < (endpoint.routes -> len) -> while {
        endpoint.routes[index!].originalKey == key -> if { index! -> return }
        index! + 1 => index!
    }
    -1
}

connectionIdInUse endpoint: ref Endpoint, connectionId: [UInt8] -> Bool {
    connectionKey(connectionId, 0) => key
    routeLocalIndex(endpoint, key) >= 0 or routeOriginalIndex(endpoint, key) >= 0
}

uniqueConnectionId endpoint: ref Endpoint -> Result<[UInt8; 8], QuicError> uses Random {
    0 => attempt!
    attempt! < 8 -> while {
        random8()? => candidate
        endpoint -> connectionIdInUse(candidate) -> unless {
            Result<[UInt8; 8], QuicError>.Ok(candidate) -> return
        }
        attempt! + 1 => attempt!
    }
    Result<[UInt8; 8], QuicError>.Err(internalFailure())
}

registerRoute endpoint: mut Endpoint, localConnectionId: [UInt8; 8], originalDestinationConnectionId: [UInt8; 8] -> Result<Unit, QuicError> {
    connectionKey(localConnectionId, 0) => localKey
    connectionKey(originalDestinationConnectionId, 0) => originalKey
    endpoint -> connectionIdInUse(localConnectionId) => localCollision
    endpoint -> connectionIdInUse(originalDestinationConnectionId) => originalCollision
    localCollision or originalCollision
        or sameBytes(localConnectionId, originalDestinationConnectionId) => collision
    collision -> if {
        Result<Unit, QuicError>.Err(QuicError {
            kind: errors.Kind.Internal
            code: errors.internalError()
        }) -> return
    }
    endpoint.routes -> push(Route {
        localKey: localKey
        originalKey: originalKey
    })
    Result<Unit, QuicError>.Ok
}

unregisterRoute endpoint: mut Endpoint, localConnectionId: [UInt8] -> Unit {
    connectionKey(localConnectionId, 0) => localKey
    endpoint -> routeLocalIndex(localKey) => routeIndex
    routeIndex >= 0 -> if { endpoint.routes -> take(routeIndex) => removedRoute }
    0 => pendingIndex!
    pendingIndex! < (endpoint.pendingPackets -> len)
        -> while {
            pendingMatches(endpoint.pendingPackets[pendingIndex!], localConnectionId)
                -> if {
                    endpoint.pendingPackets -> take(pendingIndex!) => discarded
                } else {
                    pendingIndex! + 1 => pendingIndex!
                }
        }
}

enqueuePacket endpoint: mut Endpoint, packet: move socket.Datagram -> Result<Unit, QuicError> {
    UIntSize(endpoint.pendingPackets -> len) < endpoint.maxPendingPackets
        -> unless {
            Result<Unit, QuicError>.Err(QuicError {
                kind: errors.Kind.QueueLimitExceeded
                code: UInt64(endpoint.maxPendingPackets)
            }) -> return
        }
    endpoint.pendingPackets -> push(packet)
    Result<Unit, QuicError>.Ok
}

handleUnmatchedPacket endpoint: mut Endpoint, packet: move socket.Datagram, keep: Bool -> Result<Unit, QuicError> {
    keep -> if {
        endpoint -> enqueuePacket(packet) => queued
        queued -> return
    }
    Result<Unit, QuicError>.Ok
}

receiveForConnection endpoint: mut Endpoint, connectionId: [UInt8] -> Result<socket.Datagram, QuicError> uses Network {
    connectionKey(connectionId, 0) => expectedKey
    0 => pendingIndex!
    pendingIndex! < (endpoint.pendingPackets -> len)
        -> while {
            pendingMatches(endpoint.pendingPackets[pendingIndex!], connectionId)
                -> if {
                    endpoint.pendingPackets -> take(pendingIndex!) => selected
                    Result<socket.Datagram, QuicError>.Ok(selected) -> return
                }
            pendingIndex! + 1 => pendingIndex!
        }
    true -> while {
        receivePacket(endpoint.socket)? => datagram
        packetRoute(datagram)? => route
        route.destinationKey == expectedKey
            -> if {
                Result<socket.Datagram, QuicError>.Ok(datagram) -> return
            }
        endpoint -> routeLocalIndex(route.destinationKey) => localRouteIndex
        localRouteIndex >= 0 or (route.kind == 0 and endpoint.listening) => shouldQueue
        endpoint -> handleUnmatchedPacket(datagram, shouldQueue)?
    }
    Result<socket.Datagram, QuicError>.Err(internalFailure())
}

receiveForListener endpoint: mut Endpoint -> Result<socket.Datagram, QuicError> uses Network {
    0 => pendingIndex!
    pendingIndex! < (endpoint.pendingPackets -> len)
        -> while {
            packetRoute(endpoint.pendingPackets[pendingIndex!])? => route
            route.kind == 0
                -> if {
                    pendingLocalRouteIndex(endpoint, route) => localRouteIndex
                    localRouteIndex >= 0 -> if {
                        pendingIndex! + 1 => pendingIndex!
                    } else {
                        pendingOriginalRouteIndex(endpoint, route) => originalRouteIndex
                        originalRouteIndex >= 0 -> if {
                            endpoint.pendingPackets -> take(pendingIndex!) => duplicateInitial
                        } else {
                            endpoint.pendingPackets -> take(pendingIndex!) => selected
                            Result<socket.Datagram, QuicError>.Ok(selected) -> return
                        }
                    }
                } else {
                    pendingIndex! + 1 => pendingIndex!
                }
        }
    true -> while {
        receivePacket(endpoint.socket)? => datagram
        packetRoute(datagram)? => route
        endpoint -> routeLocalIndex(route.destinationKey) => localRouteIndex
        localRouteIndex >= 0 => shouldQueue
        localRouteIndex >= 0 -> unless {
            endpoint -> routeOriginalIndex(route.destinationKey) => originalRouteIndex
            originalRouteIndex >= 0 -> unless {
                route.kind == 0 -> if {
                    Result<socket.Datagram, QuicError>.Ok(datagram) -> return
                }
            }
        }
        endpoint -> handleUnmatchedPacket(datagram, shouldQueue)?
    }
    Result<socket.Datagram, QuicError>.Err(internalFailure())
}

public ipv4 address: Text, port: UInt16 -> Result<net.Endpoint, QuicError> {
    net.ipv4(address, port) -> when {
        Ok(endpoint) { Result<net.Endpoint, QuicError>.Ok(endpoint -> unified) }
        Err(error) { Result<net.Endpoint, QuicError>.Err(QuicError {
                kind: errors.Kind.InvalidArgument
                code: errors.noViablePath()
            }) }
    }
}

public loopback port: UInt16 -> net.Endpoint => net.loopback(port) -> unified
public anyAddress port: UInt16 -> net.Endpoint => net.anyIpv4(port) -> unified

public generateIdentity: -> Result<Identity, QuicError> uses Random {
    ed25519.generateSeed() -> when {
        Ok(seed) { Result<Identity, QuicError>.Ok(Identity { seed: seed }) }
        Err(randomError) {
            Result<Identity, QuicError>.Err(QuicError {
                kind: errors.Kind.Crypto
                code: errors.internalError()
            })
        }
    }
}

# Binds one UDP transport. Server identity and client certificate policy belong
# to Listener and Connection rather than being duplicated into the transport.
public bind local: net.Endpoint -> Result<Endpoint, QuicError> uses Network {
    bindEndpoint(local)
}

certificateImpl identity: ref Identity -> Result<[UInt8; ~], QuicError> {
    x509Identity.certificate(identity.seed) -> when {
        Ok(der) { Result<[UInt8; ~], QuicError>.Ok(der) }
        Err(certificateError) {
            Result<[UInt8; ~], QuicError>.Err(QuicError {
                kind: certificateError.kind
                code: certificateError.code
            })
        }
    }
}

bindEndpoint local: net.Endpoint -> Result<Endpoint, QuicError> uses Network {
    socket.DatagramBindOptions {
        endpoint: local
        reuseAddress: true
    } -> bind -> when {
        Ok(bound) {
            bound -> localPort -> when {
                Ok(port) {
                    Result<Endpoint, QuicError>.Ok(Endpoint {
                        socket: bound
                        local: local -> withPort(port)
                        listening: false
                        routes: [Route; ~]
                        pendingPackets: [socket.Datagram; ~]
                        maxPendingPackets: 256
                    }) -> return
                }
                Err(portError) { Result<Endpoint, QuicError>.Err(socketFailure(portError)) -> return }
            }
        }
        Err(bindError) { Result<Endpoint, QuicError>.Err(socketFailure(bindError)) -> return }
    }
}

public version1: -> UInt32 => keys.version1()
public version2: -> UInt32 => keys.version2()

sameBytes left: [UInt8], right: [UInt8] -> Bool {
    (left -> len) == (right -> len) -> unless { false -> return }
    0 => index!
    index! < (left -> len) -> while {
        left[index!] == right[index!] -> unless { false -> return }
        index! + 1 => index!
    }
    true
}

encodeParameter id: UInt64, value: [UInt8] -> Result<[UInt8; ~], QuicError> {
    transport.encode(id, value) -> when {
        Ok(encoded) { encoded -> Result<[UInt8; ~], QuicError>.Ok }
        Err(value) { Result<[UInt8; ~], QuicError>.Err(protocolFailure(value)) }
    }
}

encodeIntegerParameter id: UInt64, value: UInt64 -> Result<[UInt8; ~], QuicError> {
    transport.encodeInteger(id, value) -> when {
        Ok(encoded) { encoded -> Result<[UInt8; ~], QuicError>.Ok }
        Err(value) { Result<[UInt8; ~], QuicError>.Err(protocolFailure(value)) }
    }
}

encodeVersionInformation chosen: UInt32 -> Result<[UInt8; ~], QuicError> {
    negotiation.Information {
        chosen: chosen
        available: [keys.version2(), keys.version1()]
    } => information
    information -> encode -> when {
        Ok(encoded) { Result<[UInt8; ~], QuicError>.Ok(encoded) }
        Err(value) { Result<[UInt8; ~], QuicError>.Err(protocolFailure(value)) }
    }
}

appendParameter output: mut [UInt8; ~], parameter: move [UInt8; ~] -> Unit {
    output -> appendBytes(parameter)
}

commonTransportParameters version: UInt32, sourceConnectionId: [UInt8], options: ConnectionOptions -> Result<[UInt8; ~], QuicError> {
    [UInt8; ~] => parameters!
    parameters! -> appendParameter(encodeParameter(transport.initialSourceConnectionId(), sourceConnectionId)?)
    parameters! -> appendParameter(encodeIntegerParameter(transport.maxUdpPayloadSize(), 65_527)?)
    parameters! -> appendParameter(encodeIntegerParameter(
    transport.initialMaxData(),
    options.receiveWindows.connection)?)
    parameters! -> appendParameter(encodeIntegerParameter(
    transport.initialMaxStreamDataBidiLocal(),
    options.receiveWindows.locallyInitiatedBidirectionalStream)?)
    parameters! -> appendParameter(encodeIntegerParameter(
    transport.initialMaxStreamDataBidiRemote(),
    options.receiveWindows.remotelyInitiatedBidirectionalStream)?)
    parameters! -> appendParameter(encodeIntegerParameter(
    transport.initialMaxStreamDataUni(),
    options.receiveWindows.unidirectionalStream)?)
    parameters! -> appendParameter(encodeIntegerParameter(
    transport.initialMaxStreamsBidi(),
    options.maxInboundBidirectionalStreams)?)
    parameters! -> appendParameter(encodeIntegerParameter(
    transport.initialMaxStreamsUni(),
    options.maxInboundUnidirectionalStreams)?)
    parameters! -> appendParameter(encodeIntegerParameter(transport.activeConnectionIdLimit(), 2)?)
    parameters! -> appendParameter(encodeIntegerParameter(transport.maxDatagramFrameSize(), 65_527)?)
    encodeVersionInformation(version)? => versionBytes
    parameters! -> appendParameter(encodeParameter(transport.versionInformation(), versionBytes)?)
    Result<[UInt8; ~], QuicError>.Ok(parameters!)
}

clientTransportParameters version: UInt32, sourceConnectionId: [UInt8], options: ConnectionOptions -> Result<[UInt8; ~], QuicError> {
    commonTransportParameters(version, sourceConnectionId, options)
}

serverTransportParameters version: UInt32, sourceConnectionId: [UInt8], originalDestinationConnectionId: [UInt8], options: ConnectionOptions -> Result<[UInt8; ~], QuicError> {
    commonTransportParameters(version, sourceConnectionId, options)? => parameters!
    parameters! -> appendParameter(encodeParameter(
    transport.originalDestinationConnectionId(),
    originalDestinationConnectionId)?)
    Result<[UInt8; ~], QuicError>.Ok(parameters!)
}

