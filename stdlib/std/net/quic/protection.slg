namespace std.net.quic.protection

import std.crypto.aes128 as aes128
import std.crypto.aes128_gcm as gcm
import std.crypto.aes128_gcm_result as results
import std.crypto.bits

struct MaskValue {
    bytes: [UInt8; 5]
}

struct NonceValue {
    bytes: [UInt8; 12]
}

public struct PacketKey {
    public key: [UInt8; 16]
    public iv: [UInt8; 12]
}

public struct HeaderKey {
    public cipher: aes128.Key
}

public struct PreparedPacketKey {
    public protector: gcm.Key
    public iv: [UInt8; 12]
}

public prepareHeader key: [UInt8; 16] -> HeaderKey {
    key -> aes128.prepare => cipher
    HeaderKey { cipher: cipher }
}

copyIv iv: [UInt8; 12] -> [UInt8; 12] {
    [UInt8(0); 12] => copied!
    0 => index!
    index! < 12 -> while {
        iv[index!] => copied![index!]
        index! + 1 => index!
    }
    copied!
}

public preparePacket key: [UInt8; 16], iv: [UInt8; 12] -> PreparedPacketKey {
    key -> gcm.prepare => protector
    PreparedPacketKey { protector: protector, iv: copyIv(iv) }
}

impl HeaderKey {
    public mask: self, sample: [UInt8; 16] -> [UInt8; 5] {
        self.cipher -> encryptBlock(sample) => encrypted
        MaskValue { bytes: [0; 5] }.bytes => mask!
        0 => index!
        index! < 5 -> while {
            encrypted[index!] => mask![index!]
            index! + 1 => index!
        }
        mask!
    }
}

impl PreparedPacketKey {
    public seal: self, packetNumber: UInt64, header: [UInt8], plaintext: [UInt8] -> gcm.Sealed {
        nonce(self.iv, packetNumber) => packetNonce
        self.protector -> seal(packetNonce, header, plaintext)
    }

    public open: self, packetNumber: UInt64, header: [UInt8], ciphertext: [UInt8], tag: [UInt8; 16] -> results.Open {
        nonce(self.iv, packetNumber) => packetNonce
        self.protector -> open(packetNonce, header, ciphertext, tag)
    }
}

public headerMask headerProtectionKey: [UInt8; 16], sample: [UInt8; 16] -> [UInt8; 5] {
    headerProtectionKey -> prepareHeader => prepared
    prepared -> mask(sample)
}

public nonce iv: [UInt8; 12], packetNumber: UInt64 -> [UInt8; 12] {
    NonceValue { bytes: [0; 12] }.bytes => value!
    0 => copyIndex!
    copyIndex! < 12 -> while {
        iv[copyIndex!] => value![copyIndex!]
        copyIndex! + 1 => copyIndex!
    }
    packetNumber => remaining!
    11 => nonceIndex!
    nonceIndex! >= 4 -> while {
        UInt8(remaining! % 256) => packetByte
        UInt8(bits.xor(UInt32(value![nonceIndex!]), UInt32(packetByte))) => value![nonceIndex!]
        remaining! / 256 => remaining!
        nonceIndex! - 1 => nonceIndex!
    }
    value!
}

public seal packetKey: PacketKey, packetNumber: UInt64, header: [UInt8], plaintext: [UInt8] -> gcm.Sealed {
    preparePacket(packetKey.key, packetKey.iv) => prepared
    prepared -> seal(packetNumber, header, plaintext)
}

public open packetKey: PacketKey, packetNumber: UInt64, header: [UInt8], ciphertext: [UInt8], tag: [UInt8; 16] -> results.Open {
    preparePacket(packetKey.key, packetKey.iv) => prepared
    prepared -> open(packetNumber, header, ciphertext, tag)
}
