namespace std.net.quic.packet_number

import std.net.quic.error as errors

public struct Truncated {
    public value: UInt32
    public byteCount: UIntSize
}

error code: UInt64 -> errors.Error {
    errors.Error { kind: errors.Kind.Encoding, code: code }
}

window byteCount: UIntSize -> Result<UInt64, errors.Error> {
    byteCount -> when {
        == 1 { Result<UInt64, errors.Error>.Ok(256) }
        == 2 { Result<UInt64, errors.Error>.Ok(65_536) }
        == 3 { Result<UInt64, errors.Error>.Ok(16_777_216) }
        == 4 { Result<UInt64, errors.Error>.Ok(4_294_967_296) }
        else { Result<UInt64, errors.Error>.Err(error(UInt64(byteCount))) }
    }
}

impl UInt64 {
    public selectLength: self, hasAcknowledged: Bool, largestAcknowledged: UInt64 -> UIntSize {
        hasAcknowledged -> unless { 4 -> return }
        self >= largestAcknowledged -> unless { 4 -> return }
        self - largestAcknowledged => distance
        distance -> when {
            < 128 { 1 }
            < 32_768 { 2 }
            < 8_388_608 { 3 }
            else { 4 }
        }
    }

    public truncate: self, byteCount: UIntSize -> Result<Truncated, errors.Error> {
        self >= 4_611_686_018_427_387_904 -> if {
            Result<Truncated, errors.Error>.Err(error(self)) -> return
        }
        window(byteCount)? => packetWindow
        Result<Truncated, errors.Error>.Ok(Truncated {
            value: UInt32(self % packetWindow)
            byteCount: byteCount
        })
    }

    # `expectedPacketNumber` is one greater than the largest authenticated packet
    # number in this packet-number space, matching RFC 9000 Appendix A.3.
    public restore: self, truncatedPacketNumber: UInt32, byteCount: UIntSize -> Result<UInt64, errors.Error> {
        self > 4_611_686_018_427_387_904
            -> if {
                Result<UInt64, errors.Error>.Err(error(self)) -> return
            }
        window(byteCount)? => packetWindow
        packetWindow / 2 => halfWindow
        self / packetWindow * packetWindow + UInt64(truncatedPacketNumber) => candidate
        candidate + halfWindow <= self
            and candidate < 4_611_686_018_427_387_904 - packetWindow
            -> if {
                Result<UInt64, errors.Error>.Ok(candidate + packetWindow) -> return
            }
        candidate > self + halfWindow and candidate >= packetWindow
            -> if {
                Result<UInt64, errors.Error>.Ok(candidate - packetWindow) -> return
            }
        candidate < 4_611_686_018_427_387_904 -> if {
            Result<UInt64, errors.Error>.Ok(candidate)
        } else {
            Result<UInt64, errors.Error>.Err(error(candidate))
        }
    }
}
