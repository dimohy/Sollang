namespace std.net.quic.connection_state

import std.net.quic.error as errors
import std.net.quic.frame as frames
import std.net.quic.stream_state

public struct State {
    public localIsServer: Bool
    public handshakeConfirmed: Bool
    public peerClosed: Bool
    public flow: stream_state.ConnectionFlow
    public peerStreamLimits: stream_state.StreamLimits
}

transportError code: UInt64 -> errors.Error => errors.Error { kind: errors.Kind.Transport, code: code }

public create localIsServer: Bool, receiveMaximum: UInt64, sendMaximum: UInt64, peerBidirectionalStreams: UInt64, peerUnidirectionalStreams: UInt64 -> State => State {
    localIsServer: localIsServer
    handshakeConfirmed: false
    peerClosed: false
    flow: stream_state.initialConnectionFlow(receiveMaximum, sendMaximum)
    peerStreamLimits: stream_state.initialStreamLimits(peerBidirectionalStreams, peerUnidirectionalStreams)
}

impl State {
    public apply: move self, value: move frames.Value -> Result<State, errors.Error> {
        value -> when {
            MaxData(maximum) {
                State {
                    localIsServer: self.localIsServer
                    handshakeConfirmed: self.handshakeConfirmed
                    peerClosed: self.peerClosed
                    flow: self.flow -> onMaxData(maximum)
                    peerStreamLimits: self.peerStreamLimits
                } -> Result<State, errors.Error>.Ok
            }
            MaxStreams(limit) {
                State {
                    localIsServer: self.localIsServer
                    handshakeConfirmed: self.handshakeConfirmed
                    peerClosed: self.peerClosed
                    flow: self.flow
                    peerStreamLimits: self.peerStreamLimits -> onMaxStreams(
                    limit.bidirectional,
                    limit.maximum)
                } -> Result<State, errors.Error>.Ok
            }
            HandshakeDone {
                self.localIsServer -> if {
                    Result<State, errors.Error>.Err(transportError(errors.protocolViolation()))
                } else {
                    Result<State, errors.Error>.Ok(State {
                        localIsServer: false
                        handshakeConfirmed: true
                        peerClosed: self.peerClosed
                        flow: self.flow
                        peerStreamLimits: self.peerStreamLimits
                    })
                }
            }
            ConnectionClose(close) {
                Result<State, errors.Error>.Ok(State {
                    localIsServer: self.localIsServer
                    handshakeConfirmed: self.handshakeConfirmed
                    peerClosed: true
                    flow: self.flow
                    peerStreamLimits: self.peerStreamLimits
                })
            }
            Padding(count) { Result<State, errors.Error>.Ok(self) }
            Ping { Result<State, errors.Error>.Ok(self) }
            Ack(ack) { Result<State, errors.Error>.Ok(self) }
            ResetStream(value) { Result<State, errors.Error>.Ok(self) }
            StopSending(value) { Result<State, errors.Error>.Ok(self) }
            Crypto(crypto) { Result<State, errors.Error>.Ok(self) }
            Stream(streamFrame) { Result<State, errors.Error>.Ok(self) }
            Datagram(datagram) { Result<State, errors.Error>.Ok(self) }
            MaxStreamData(limit) { Result<State, errors.Error>.Ok(self) }
            DataBlocked(limit) { Result<State, errors.Error>.Ok(self) }
            StreamDataBlocked(blocked) { Result<State, errors.Error>.Ok(self) }
            StreamsBlocked(blocked) { Result<State, errors.Error>.Ok(self) }
            NewConnectionId(value) { Result<State, errors.Error>.Ok(self) }
            RetireConnectionId(sequence) { Result<State, errors.Error>.Ok(self) }
        }
    }
}
