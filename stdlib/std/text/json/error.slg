namespace std.text.json.error

public enum Kind {
    InvalidLimit
    InputLimitExceeded
    TokenLimitExceeded
    DepthLimitExceeded
    UnexpectedEnd
    UnexpectedByte
    ExpectedValue
    ExpectedName
    ExpectedColon
    ExpectedCommaOrEnd
    TrailingData
    InvalidLiteral
    InvalidNumber
    InvalidStringEscape
    InvalidUnicodeEscape
    InvalidUtf8
    OutputLimitExceeded
    WrongTokenKind
    InvalidWriterState
    IncompleteDocument
    NonIntegerNumber
    NumberOutOfRange
}
