namespace std.text.csv

import sys.file as file

# UTF-8 field-stream profile: RFC 4180 quoting, with explicit line policies
# and trailing empty fields. No header inference, BOM stripping, or trimming.
public enum LineEndings { CrLf, Lf, Either }
public enum Kind {
    InvalidLimits
    InvalidOptions
    InputLimit
    RecordLimit
    FieldCountLimit
    FieldSizeLimit
    ColumnCountMismatch
    UnexpectedQuote
    UnterminatedQuote
    TrailingAfterQuote
    InvalidLineEnding
    InvalidControl
    OutputTooSmall
    InvalidRecord
    OutputLimit
}
public struct Error {
    public kind: Kind
    public offset: UIntSize
    public requiredBytes: Int
}
public struct Limits {
    public maxInputBytes: Int
    public maxRecords: Int
    public maxFieldsPerRecord: Int
    public maxFieldBytes: Int
}
public struct WriterLimits {
    public maxOutputBytes: Int
    public maxRecords: Int
    public maxFieldsPerRecord: Int
    public maxFieldBytes: Int
}
public struct Format {
    public lineEndings: LineEndings
    public expectedColumns: Int
}
public struct Field {
    public recordIndex: Int
    public fieldIndex: Int
    public length: Int
    public endOfRecord: Bool
}
public struct Reader {
    source: file.SourceText
    index: UIntSize
    end: UIntSize
    recordIndex: Int
    fieldIndex: Int
    done: Bool
    format: Format
    limits: Limits
}
public struct Writer {
    limits: WriterLimits
    expectedColumns: Int
    lineEndingBytes: Int
    encodedBytes: Int
    records: Int
}
struct ScannedField {
    contentStart: UIntSize
    contentEnd: UIntSize
    nextIndex: UIntSize
    length: Int
    endOfRecord: Bool
    quoted: Bool
}

public standard: -> Format => Format { lineEndings: LineEndings.CrLf, expectedColumns: 0 }

failure kind: Kind, offset: UIntSize -> Error => Error { kind: kind, offset: offset, requiredBytes: 0 }

impl Format {
    # Text remains borrowed. Its backing storage must outlive this reader.
    public reader: self, text: Text, limits: Limits -> Result<Reader, Error> {
        limits.maxInputBytes >= 0 and limits.maxRecords >= 0
            and limits.maxFieldsPerRecord >= 0 and limits.maxFieldBytes >= 0
            -> unless { Result<Reader, Error>.Err(failure(Kind.InvalidLimits, 0)) -> return }
        self.expectedColumns >= 0
            and self.expectedColumns <= limits.maxFieldsPerRecord
            -> unless { Result<Reader, Error>.Err(failure(Kind.InvalidOptions, 0)) -> return }
        text -> len => length
        length <= UIntSize(limits.maxInputBytes) -> unless {
            Result<Reader, Error>.Err(failure(Kind.InputLimit, UIntSize(limits.maxInputBytes))) -> return
        }
        text -> file.borrowText => source
        Result<Reader, Error>.Ok(Reader {
            source: source
            index: 0
            end: length
            recordIndex: 0
            fieldIndex: 0
            done: length == 0
            format: self
            limits: limits
        })
    }

    public writer: self, limits: WriterLimits -> Result<Writer, Error> {
        limits.maxOutputBytes >= 0 and limits.maxRecords >= 0
            and limits.maxFieldsPerRecord >= 0 and limits.maxFieldBytes >= 0
            -> unless { Result<Writer, Error>.Err(failure(Kind.InvalidLimits, 0)) -> return }
        self.expectedColumns >= 0 and self.expectedColumns <= limits.maxFieldsPerRecord
            -> unless { Result<Writer, Error>.Err(failure(Kind.InvalidOptions, 0)) -> return }
        self.lineEndings -> when {
            CrLf { 2 }
            Lf { 1 }
            Either { Result<Writer, Error>.Err(failure(Kind.InvalidOptions, 0)) -> return }
        } => lineEndingBytes
        Result<Writer, Error>.Ok(Writer {
            limits: limits
            expectedColumns: self.expectedColumns
            lineEndingBytes: lineEndingBytes
            encodedBytes: 0
            records: 0
        })
    }
}

impl Reader {
    public offset: self -> UIntSize => self.index

    checkedLength: self, length: Int, byte: UInt8, offset: UIntSize, quoted: Bool -> Result<Int, Error> {
        byte < ' ' or byte == 127 -> if {
            quoted and (byte == '\r' or byte == '\n') -> unless {
                Result<Int, Error>.Err(failure(Kind.InvalidControl, offset)) -> return
            }
        }
        length < self.limits.maxFieldBytes -> unless {
            Result<Int, Error>.Err(failure(Kind.FieldSizeLimit, offset)) -> return
        }
        Result<Int, Error>.Ok(length + 1)
    }

    afterLineEnding: self, index: UIntSize -> Result<UIntSize, Error> {
        self.source -> byte(index) => byte
        self.format.lineEndings -> when {
            CrLf => byte == '\r'
            Lf => byte == '\n'
            Either => true
        } => allowed
        allowed -> unless {
            Result<UIntSize, Error>.Err(failure(Kind.InvalidLineEnding, index)) -> return
        }
        byte == '\r' -> if {
            index + 1 < self.end
                and self.source -> byte(index + 1) == '\n'
                -> unless { Result<UIntSize, Error>.Err(failure(Kind.InvalidLineEnding, index)) -> return }
            Result<UIntSize, Error>.Ok(index + 2)
        } else {
            Result<UIntSize, Error>.Ok(index + 1)
        }
    }

    scan: self -> Result<ScannedField, Error> {
        self.index => cursor!
        false => quoted!
        cursor! < self.end and self.source -> byte(cursor!) == '"'
            -> if {
                true => quoted!
                cursor! + 1 => cursor!
            }
        cursor! => contentStart
        0 => length!
        quoted! -> if {
            false => closed!
            cursor! < self.end and not closed! -> while {
                self.source -> byte(cursor!) => byte
                byte == '"' -> if {
                cursor! + 1 < self.end and self.source -> byte(cursor! + 1) == '"'
                    -> if {
                        self -> checkedLength(length!, byte, cursor!, true)? => length!
                        cursor! + 2 => cursor!
                    } else { true => closed! }
            } else {
                self -> checkedLength(length!, byte, cursor!, true)? => length!
                cursor! + 1 => cursor!
            }
        }
        closed! -> unless {
            Result<ScannedField, Error>.Err(failure(Kind.UnterminatedQuote, self.end)) -> return
        }
    } else {
        cursor! < self.end -> while {
            self.source -> byte(cursor!) => byte
            byte == ',' or byte == '\r' or byte == '\n' -> if { break }
            byte == '"' -> if {
            Result<ScannedField, Error>.Err(failure(Kind.UnexpectedQuote, cursor!)) -> return
        }
        self -> checkedLength(length!, byte, cursor!, false)? => length!
        cursor! + 1 => cursor!
    }
}
cursor! => contentEnd
quoted! -> if { cursor! + 1 => cursor! }
true => endOfRecord!
cursor! < self.end -> if {
    self.source -> byte(cursor!) => delimiter
    delimiter -> when {
        == ',' {
            false => endOfRecord!
            cursor! + 1 => cursor!
        }
        == '\r' { self -> afterLineEnding(cursor!)? => cursor! }
        == '\n' { self -> afterLineEnding(cursor!)? => cursor! }
        else {
            Result<ScannedField, Error>.Err(failure(Kind.TrailingAfterQuote, cursor!)) -> return
        }
    }
}
Result<ScannedField, Error>.Ok(ScannedField {
    contentStart: contentStart
    contentEnd: contentEnd
    nextIndex: cursor!
    length: length!
    endOfRecord: endOfRecord!
    quoted: quoted!
})
}

# Field-level transaction: errors leave the entire buffer and cursor intact.
# Previously returned fields are not rolled back by a later field's error.
# Only output[0..length] is written; no resize, copy of storage, or allocation.
public next: mut self, output: mut [UInt8; ~] -> Result<Option<Field>, Error> {
    self.done -> if { Result<Option<Field>, Error>.Ok(Option<Field>.None) -> return }
    self.recordIndex < self.limits.maxRecords -> unless {
        Result<Option<Field>, Error>.Err(failure(Kind.RecordLimit, self.index)) -> return
    }
    self.format.expectedColumns > 0 and self.fieldIndex >= self.format.expectedColumns
        -> if { Result<Option<Field>, Error>.Err(failure(Kind.ColumnCountMismatch, self.index)) -> return }
    self.fieldIndex < self.limits.maxFieldsPerRecord
        -> unless {
            Result<Option<Field>, Error>.Err(failure(Kind.FieldCountLimit, self.index)) -> return
        }
    self -> scan? => scanned
    scanned.endOfRecord and self.format.expectedColumns > 0
        and self.fieldIndex + 1 != self.format.expectedColumns
        -> if { Result<Option<Field>, Error>.Err(failure(Kind.ColumnCountMismatch, self.index)) -> return }
    scanned.length <= (output -> len) -> unless {
        Result<Option<Field>, Error>.Err(Error {
            kind: Kind.OutputTooSmall
            offset: self.index
            requiredBytes: scanned.length
        }) -> return
    }
    scanned.contentStart => cursor!
    0 => written!
    cursor! < scanned.contentEnd -> while {
        self.source -> byte(cursor!) => byte
        byte => output[written!]
        written! + 1 => written!
        cursor! + 1 => cursor!
        scanned.quoted and byte == '"' -> if { cursor! + 1 => cursor! }
    }
    Field {
        recordIndex: self.recordIndex
        fieldIndex: self.fieldIndex
        length: scanned.length
        endOfRecord: scanned.endOfRecord
    } => field
    scanned.nextIndex => self.index
    scanned.endOfRecord -> if {
        self.recordIndex + 1 => self.recordIndex
        0 => self.fieldIndex
        self.index == self.end => self.done
    } else { self.fieldIndex + 1 => self.fieldIndex }
    Result<Option<Field>, Error>.Ok(Option<Field>.Some(field))
}
}

fieldNeedsQuotes text: Text, length: UIntSize -> Bool {
    length == 0 -> if { true -> return }
    UIntSize(0) => cursor!
    cursor! < length -> while {
        text -> byte(cursor!) => byte
        byte == ',' or byte == '"' or byte == '\r' or byte == '\n'
            -> if { true -> return }
        cursor! + 1 => cursor!
    }
    false
}

# Preflight already validated every field and the complete output prefix.
# Re-reading the quote decision avoids retaining a per-field plan or buffer.
writeField text: Text, output: mut [UInt8; ~], offset: Int -> Int {
    text -> len => length
    fieldNeedsQuotes(text, length) => quoted
    offset => written!
    quoted -> if {
        '"' => output[written!]
        written! + 1 => written!
    }
    UIntSize(0) => cursor!
    cursor! < length -> while {
        text -> byte(cursor!) => byte
        byte => output[written!]
        written! + 1 => written!
        byte == '"' -> if {
        byte => output[written!]
        written! + 1 => written!
    }
    cursor! + 1 => cursor!
}
quoted -> if {
    '"' => output[written!]
    written! + 1 => written!
}
written!
}

impl Writer {
    public bytesWritten: self -> Int => self.encodedBytes

    public recordsWritten: self -> Int => self.records

    encodedFieldLength: self, text: Text, remaining: Int -> Result<Int, Error> {
        UIntSize(self.encodedBytes) => offset
        text -> len => length
        length <= UIntSize(self.limits.maxFieldBytes)
            -> unless { Result<Int, Error>.Err(failure(Kind.FieldSizeLimit, offset)) -> return }
        length <= UIntSize(remaining)
            -> unless { Result<Int, Error>.Err(failure(Kind.OutputLimit, offset)) -> return }
        Int(length) => encoded!
        length == 0 => quoted!
        UIntSize(0) => cursor!
        cursor! < length -> while {
            text -> byte(cursor!) => byte
            (byte < ' ' and byte != '\r' and byte != '\n') or byte == 127
                -> if { Result<Int, Error>.Err(failure(Kind.InvalidControl, offset)) -> return }
            byte == ',' or byte == '"' or byte == '\r' or byte == '\n'
                -> if { true => quoted! }
            byte == '"' -> if {
            encoded! < remaining
                -> unless { Result<Int, Error>.Err(failure(Kind.OutputLimit, offset)) -> return }
            encoded! + 1 => encoded!
        }
        cursor! + 1 => cursor!
    }
    quoted! -> if {
        remaining - encoded! >= 2
            -> unless { Result<Int, Error>.Err(failure(Kind.OutputLimit, offset)) -> return }
        encoded! + 2 => encoded!
    }
    Result<Int, Error>.Ok(encoded!)
}

# Record transaction: validate and size the entire row before any output
# write. The output's visible length is the writable span; no resize occurs.
public writeRecord: mut self, fields: [Text], output: mut [UInt8; ~] -> Result<Int, Error> {
    UIntSize(self.encodedBytes) => offset
    fields -> len => fieldCount
    fieldCount > 0
        -> unless { Result<Int, Error>.Err(failure(Kind.InvalidRecord, offset)) -> return }
    self.records < self.limits.maxRecords
        -> unless { Result<Int, Error>.Err(failure(Kind.RecordLimit, offset)) -> return }
    fieldCount <= self.limits.maxFieldsPerRecord
        -> unless { Result<Int, Error>.Err(failure(Kind.FieldCountLimit, offset)) -> return }
    self.expectedColumns > 0 and fieldCount != self.expectedColumns
        -> if { Result<Int, Error>.Err(failure(Kind.ColumnCountMismatch, offset)) -> return }

    self.limits.maxOutputBytes - self.encodedBytes => remaining
    self.lineEndingBytes <= remaining
        -> unless { Result<Int, Error>.Err(failure(Kind.OutputLimit, offset)) -> return }
    self.lineEndingBytes => recordLength!
    0 => fieldIndex!
    fieldIndex! < fieldCount -> while {
        fieldIndex! > 0 -> if {
            recordLength! < remaining
                -> unless { Result<Int, Error>.Err(failure(Kind.OutputLimit, offset)) -> return }
            recordLength! + 1 => recordLength!
        }
        self -> encodedFieldLength(fields[fieldIndex!], remaining - recordLength!)? => fieldLength
        recordLength! + fieldLength => recordLength!
        fieldIndex! + 1 => fieldIndex!
    }
    recordLength! <= (output -> len) -> unless {
        Result<Int, Error>.Err(Error {
            kind: Kind.OutputTooSmall
            offset: offset
            requiredBytes: recordLength!
        }) -> return
    }

    0 => written!
    0 => fieldIndex!
    fieldIndex! < fieldCount -> while {
        fieldIndex! > 0 -> if {
            ',' => output[written!]
            written! + 1 => written!
        }
        writeField(fields[fieldIndex!], output, written!) => written!
        fieldIndex! + 1 => fieldIndex!
    }
    self.lineEndingBytes == 2 -> if {
        '\r' => output[written!]
        written! + 1 => written!
    }
    '\n' => output[written!]
    self.encodedBytes + recordLength! => self.encodedBytes
    self.records + 1 => self.records
    Result<Int, Error>.Ok(recordLength!)
}
}
