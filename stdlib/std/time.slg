namespace std.time

import sys.runtime as runtime
import std.time as model

# Duration is non-negative elapsed time measured in whole milliseconds. The
# constructor validates that invariant before the value exists; every operation
# after construction is an instance method.
public struct Duration {
    public millis: Long
}

# MonotonicInstant is meaningful only relative to another reading from the
# same monotonic source. It is deliberately distinct from future UTC/calendar
# values and exposes no Unix timestamp conversion.
public struct MonotonicInstant {
    ticksMillis: Long
    source: UInt64
}

# UtcInstant is Unix epoch time in whole milliseconds. It is never used for
# elapsed-time measurement because wall time can move independently.
public struct UtcInstant {
    public unixMillis: Long
}

# The system monotonic source has no mutable state in user space. Querying it is
# still an explicit Clock effect.
public struct MonotonicClock {
    marker: UInt8
}

public struct WallClock {
    public marker: UInt8
}

# ManualClock is an injectable deterministic source for tests and simulations.
# It has no ambient Clock effect; advancing it requires an explicit mutable
# borrow and a validated Duration.
public struct ManualClock {
    ticksMillis: Long
    source: UInt64
}

public struct ManualWallClock {
    public unixMillis: Long
}

public struct Deadline {
    instant: MonotonicInstant
}

public struct FixedClock {
    instant: UtcInstant
}

public struct OffsetClock {
    offsetMillis: Long
}

public enum SuspendPolicy {
    IncludesSystemSuspend
    ExcludesSystemSuspend
    Unspecified
}

public struct ClockCapabilities {
    public resolution: Duration
    public suspendPolicy: SuspendPolicy
    public maximumDelay: Duration
}

public enum ErrorKind {
    NegativeDuration
    NegativeResult
    DivisionByZero
    Overflow
    ReversedInstant
    DifferentClock
    InvalidSource
}

public struct Error {
    public kind: ErrorKind
}

scaledDuration value: Long, scale: Long -> Result<Duration, Error> => value < 0
    -> if {
        Error { kind: model.ErrorKind.NegativeDuration } -> Result<Duration, Error>.Err
    } else {
        value > 9_223_372_036_854_775_807 / scale -> if {
            Error { kind: model.ErrorKind.Overflow } -> Result<Duration, Error>.Err
        } else {
            Duration { millis: value * scale } -> Result<Duration, Error>.Ok
        }
    }

public milliseconds value: Long -> Result<Duration, Error> => value -> scaledDuration(1)

public seconds value: Long -> Result<Duration, Error> => value -> scaledDuration(1_000)

public minutes value: Long -> Result<Duration, Error> => value -> scaledDuration(60_000)

public hours value: Long -> Result<Duration, Error> => value -> scaledDuration(3_600_000)

public monotonicClock: -> MonotonicClock => MonotonicClock { marker: 0 }

public wallClock: -> WallClock => WallClock { marker: 0 }

public manualClock source: UInt64, ticksMillis: Long -> Result<ManualClock, Error> => source == 0
    -> if {
        Error { kind: model.ErrorKind.InvalidSource } -> Result<ManualClock, Error>.Err
    } else { ticksMillis < 0
    -> if {
        Error { kind: model.ErrorKind.NegativeDuration } -> Result<ManualClock, Error>.Err
    } else {
        ManualClock { ticksMillis: ticksMillis, source: source } -> Result<ManualClock, Error>.Ok
    } }

public manualWallClock unixMillis: Long -> ManualWallClock => ManualWallClock {
    unixMillis: unixMillis
}

public fixedClock instant: UtcInstant -> FixedClock => FixedClock { instant: instant }

public offsetClock offsetMillis: Long -> OffsetClock => OffsetClock { offsetMillis: offsetMillis }

impl Duration {
    public asMilliseconds: self -> Long => self.millis

    public asSecondsFloor: self -> Long => self.millis / 1000

    public asMinutesFloor: self -> Long => self.millis / 60_000

    public asHoursFloor: self -> Long => self.millis / 3_600_000

    public isZero: self -> Bool => self.millis == 0

    public checkedAdd: self, other: Duration -> Result<Duration, Error> {
        self.millis > 9_223_372_036_854_775_807 - other.millis
            -> if {
                Error { kind: model.ErrorKind.Overflow } -> Result<Duration, Error>.Err
            } else {
                Duration { millis: self.millis + other.millis } -> Result<Duration, Error>.Ok
            }
    }

    public checkedSub: self, other: Duration -> Result<Duration, Error> {
        self.millis < other.millis -> if {
            Error { kind: model.ErrorKind.NegativeResult } -> Result<Duration, Error>.Err
        } else {
            Duration { millis: self.millis - other.millis } -> Result<Duration, Error>.Ok
        }
    }

    public checkedMultiply: self, factor: UInt32 -> Result<Duration, Error> {
        factor == 0 -> if {
            Duration { millis: 0 } -> Result<Duration, Error>.Ok
        } else {
            Long(factor) => wideFactor
            self.millis > 9_223_372_036_854_775_807 / wideFactor
                -> if {
                    Error { kind: model.ErrorKind.Overflow } -> Result<Duration, Error>.Err
                } else {
                    Duration { millis: self.millis * wideFactor } -> Result<Duration, Error>.Ok
                }
        }
    }

    public checkedDivide: self, divisor: UInt32 -> Result<Duration, Error> {
        divisor == 0 -> if {
            Error { kind: model.ErrorKind.DivisionByZero } -> Result<Duration, Error>.Err
        } else {
            Duration { millis: self.millis / Long(divisor) } -> Result<Duration, Error>.Ok
        }
    }

    public absoluteDifference: self, other: Duration -> Duration {
        self.millis >= other.millis -> if {
            Duration { millis: self.millis - other.millis }
        } else {
            Duration { millis: other.millis - self.millis }
        }
    }

}

impl MonotonicInstant {
    public durationSince: self, earlier: MonotonicInstant -> Result<Duration, Error> {
        self.source == earlier.source -> unless {
            Error { kind: model.ErrorKind.DifferentClock } -> Result<Duration, Error>.Err -> return
        }
        self.ticksMillis < earlier.ticksMillis -> if {
            Error { kind: model.ErrorKind.ReversedInstant } -> Result<Duration, Error>.Err
        } else {
            Duration { millis: self.ticksMillis - earlier.ticksMillis }
                -> Result<Duration, Error>.Ok
        }
    }

    public checkedAdd: self, duration: Duration -> Result<MonotonicInstant, Error> {
        self.ticksMillis > 9_223_372_036_854_775_807 - duration.millis
            -> if {
                Error { kind: model.ErrorKind.Overflow } -> Result<MonotonicInstant, Error>.Err
            } else {
                MonotonicInstant { ticksMillis: self.ticksMillis + duration.millis, source: self.source }
                    -> Result<MonotonicInstant, Error>.Ok
            }
    }

    public checkedSub: self, duration: Duration -> Result<MonotonicInstant, Error> {
        self.ticksMillis < duration.millis -> if {
            Error { kind: model.ErrorKind.ReversedInstant } -> Result<MonotonicInstant, Error>.Err
        } else {
            MonotonicInstant { ticksMillis: self.ticksMillis - duration.millis, source: self.source }
                -> Result<MonotonicInstant, Error>.Ok
        }
    }

    public sourceIdentity: self -> UInt64 => self.source

    public sameSource: self, other: MonotonicInstant -> Bool => self.source == other.source
}

impl MonotonicClock {
    public now: self -> MonotonicInstant uses Clock => MonotonicInstant {
        ticksMillis: runtime.nowMillis()
        source: 0
    }

    public deadlineAfter: self, duration: Duration -> Result<Deadline, Error> uses Clock {
        self -> now -> checkedAdd(duration)? => instant
        Result<Deadline, Error>.Ok(Deadline { instant: instant })
    }

    public capabilities: self -> ClockCapabilities {
        runtime.monotonicSuspendPolicy() -> when {
            == 0 { model.SuspendPolicy.IncludesSystemSuspend }
            == 1 { model.SuspendPolicy.ExcludesSystemSuspend }
            else { model.SuspendPolicy.Unspecified }
        } => suspendPolicy
        ClockCapabilities {
            resolution: Duration { millis: 1 }
            suspendPolicy: suspendPolicy
            maximumDelay: Duration { millis: 9_223_372_036_854_775_807 }
        }
    }
}

impl UtcInstant {
    public asUnixMilliseconds: self -> Long => self.unixMillis

    public durationSince: self, earlier: UtcInstant -> Result<Duration, Error> {
        self.unixMillis < earlier.unixMillis -> if {
            Error { kind: model.ErrorKind.ReversedInstant } -> Result<Duration, Error>.Err
        } else {
            earlier.unixMillis < 0
                and self.unixMillis > 9_223_372_036_854_775_807 + earlier.unixMillis
                -> if {
                    Error { kind: model.ErrorKind.Overflow } -> Result<Duration, Error>.Err
                } else {
                    Duration { millis: self.unixMillis - earlier.unixMillis }
                        -> Result<Duration, Error>.Ok
                }
        }
    }

    public checkedAdd: self, duration: Duration -> Result<UtcInstant, Error> {
        self.unixMillis > 9_223_372_036_854_775_807 - duration.millis
            -> if {
                Error { kind: model.ErrorKind.Overflow } -> Result<UtcInstant, Error>.Err
            } else {
                UtcInstant { unixMillis: self.unixMillis + duration.millis }
                    -> Result<UtcInstant, Error>.Ok
            }
    }

    public checkedSub: self, duration: Duration -> Result<UtcInstant, Error> {
        self.unixMillis < -9_223_372_036_854_775_807 - Long(1) + duration.millis
            -> if {
                Error { kind: model.ErrorKind.Overflow } -> Result<UtcInstant, Error>.Err
            } else {
                UtcInstant { unixMillis: self.unixMillis - duration.millis }
                    -> Result<UtcInstant, Error>.Ok
            }
    }
}

impl WallClock {
    public now: self -> UtcInstant uses Clock => UtcInstant {
        unixMillis: runtime.utcNowMillis()
    }

    public capabilities: self -> ClockCapabilities => ClockCapabilities {
        resolution: Duration { millis: 1 }
        suspendPolicy: model.SuspendPolicy.IncludesSystemSuspend
        maximumDelay: Duration { millis: 9_223_372_036_854_775_807 }
    }
}

impl ManualClock {
    public now: self -> MonotonicInstant => MonotonicInstant {
        ticksMillis: self.ticksMillis
        source: self.source
    }

    public advance: mut self, duration: Duration -> Result<Unit, Error> {
        self.ticksMillis > 9_223_372_036_854_775_807 - duration.millis
            -> if {
                Error { kind: model.ErrorKind.Overflow } -> Result<Unit, Error>.Err
            } else {
                self.ticksMillis + duration.millis => self.ticksMillis
                Result<Unit, Error>.Ok
            }
    }

    public deadlineAfter: self, duration: Duration -> Result<Deadline, Error> {
        self -> now -> checkedAdd(duration)? => instant
        Result<Deadline, Error>.Ok(Deadline { instant: instant })
    }
}

impl ManualWallClock {
    public now: self -> UtcInstant => UtcInstant { unixMillis: self.unixMillis }

    public set: mut self, instant: UtcInstant -> Unit {
        instant.unixMillis => self.unixMillis
    }
}

impl Deadline {
    public remaining: self, now: MonotonicInstant -> Result<Duration, Error> {
        self.instant.source == now.source -> unless {
            Error { kind: model.ErrorKind.DifferentClock } -> Result<Duration, Error>.Err -> return
        }
        now.ticksMillis >= self.instant.ticksMillis -> if {
            Result<Duration, Error>.Ok(Duration { millis: 0 })
        } else {
            Result<Duration, Error>.Ok(Duration { millis: self.instant.ticksMillis - now.ticksMillis })
        }
    }

    public isDue: self, now: MonotonicInstant -> Result<Bool, Error> {
        self.instant.source == now.source -> unless {
            Error { kind: model.ErrorKind.DifferentClock } -> Result<Bool, Error>.Err -> return
        }
        Result<Bool, Error>.Ok(now.ticksMillis >= self.instant.ticksMillis)
    }
}

impl FixedClock {
    public now: self -> UtcInstant => self.instant
}

impl OffsetClock {
    public now: self -> Result<UtcInstant, Error> uses Clock {
        runtime.utcNowMillis() => current
        self.offsetMillis > 0 and current > 9_223_372_036_854_775_807 - self.offsetMillis
            -> if {
                Result<UtcInstant, Error>.Err(Error { kind: model.ErrorKind.Overflow }) -> return
            }
        self.offsetMillis < 0 and current < (-9_223_372_036_854_775_807 - Long(1)) - self.offsetMillis
            -> if {
                Result<UtcInstant, Error>.Err(Error { kind: model.ErrorKind.Overflow }) -> return
            }
        Result<UtcInstant, Error>.Ok(UtcInstant { unixMillis: current + self.offsetMillis })
    }
}
