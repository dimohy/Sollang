namespace sys.runtime

public nowMillis: -> Long = intrinsic

# UTC Unix epoch milliseconds. This is wall-clock time and must not be used for
# elapsed-duration measurement; use nowMillis for the monotonic clock.
public utcNowMillis: -> Long = intrinsic

# Compiled-target monotonic suspend policy: 0 includes system suspend, 1
# excludes it, and 2 is intentionally unspecified by the target runtime.
public monotonicSuspendPolicy: -> UInt8 = intrinsic
