namespace sys.crypto.aes128

import sys.crypto.bits

# AES-128 has a fixed 16-byte block, 16-byte key, and 176-byte expanded key.
# The substitution and round-constant tables are immutable static data.
sbox: -> [UInt8] => [
    99, 124, 119, 123, 242, 107, 111, 197, 48, 1, 103, 43, 254, 215, 171, 118,
    202, 130, 201, 125, 250, 89, 71, 240, 173, 212, 162, 175, 156, 164, 114, 192,
    183, 253, 147, 38, 54, 63, 247, 204, 52, 165, 229, 241, 113, 216, 49, 21,
    4, 199, 35, 195, 24, 150, 5, 154, 7, 18, 128, 226, 235, 39, 178, 117,
    9, 131, 44, 26, 27, 110, 90, 160, 82, 59, 214, 179, 41, 227, 47, 132,
    83, 209, 0, 237, 32, 252, 177, 91, 106, 203, 190, 57, 74, 76, 88, 207,
    208, 239, 170, 251, 67, 77, 51, 133, 69, 249, 2, 127, 80, 60, 159, 168,
    81, 163, 64, 143, 146, 157, 56, 245, 188, 182, 218, 33, 16, 255, 243, 210,
    205, 12, 19, 236, 95, 151, 68, 23, 196, 167, 126, 61, 100, 93, 25, 115,
    96, 129, 79, 220, 34, 42, 144, 136, 70, 238, 184, 20, 222, 94, 11, 219,
    224, 50, 58, 10, 73, 6, 36, 92, 194, 211, 172, 98, 145, 149, 228, 121,
    231, 200, 55, 109, 141, 213, 78, 169, 108, 86, 244, 234, 101, 122, 174, 8,
    186, 120, 37, 46, 28, 166, 180, 198, 232, 221, 116, 31, 75, 189, 139, 138,
    112, 62, 181, 102, 72, 3, 246, 14, 97, 53, 87, 185, 134, 193, 29, 158,
    225, 248, 152, 17, 105, 217, 142, 148, 155, 30, 135, 233, 206, 85, 40, 223,
    140, 161, 137, 13, 191, 230, 66, 104, 65, 153, 45, 15, 176, 84, 187, 22]

roundConstants: -> [UInt8] => [1, 2, 4, 8, 16, 32, 64, 128, 27, 54]

struct ExpandedKeyValue {
    bytes: [UInt8; 176]
}

struct BlockValue {
    bytes: [UInt8; 16]
}

xorByte left: UInt8, right: UInt8 -> UInt8 {
    UInt8(bits.xor(UInt32(left), UInt32(right)))
}

xtime value: UInt8 -> UInt8 {
    UInt32(value) => wide
    wide < 128 -> if {
        UInt8(wide * 2)
    } else {
        UInt8(bits.xor((wide * 2) % 256, 27))
    }
}

mul3 value: UInt8 -> UInt8 {
    xorByte(xtime(value), value)
}

expandKey key: [UInt8; 16] -> [UInt8; 176] {
    ExpandedKeyValue { bytes: [0; 176] }.bytes => expanded!
    0 => index!
    index! < 16 -> while {
        key[index!] => expanded![index!]
        index! + 1 => index!
    }
    16 => generated!
    0 => round!
    [UInt8(0); 4] => temporary!
    generated! < 176 -> while {
        0 => temporaryIndex!
        temporaryIndex! < 4 -> while {
            expanded![generated! - 4 + temporaryIndex!] => temporary![temporaryIndex!]
            temporaryIndex! + 1 => temporaryIndex!
        }
        generated! % 16 == 0 -> if {
            temporary![0] => first
            sbox()[Int(temporary![1])] => temporary![0]
            sbox()[Int(temporary![2])] => temporary![1]
            sbox()[Int(temporary![3])] => temporary![2]
            sbox()[Int(first)] => temporary![3]
            xorByte(temporary![0], roundConstants()[round!]) => temporary![0]
            round! + 1 => round!
        }
        0 => wordIndex!
        wordIndex! < 4 -> while {
            xorByte(expanded![generated! - 16], temporary![wordIndex!]) => expanded![generated!]
            generated! + 1 => generated!
            wordIndex! + 1 => wordIndex!
        }
    }
    expanded!
}

addRoundKey state: mut [UInt8; 16], expanded: [UInt8; 176], offset: Int -> Unit {
    0 => index!
    index! < 16 -> while {
        xorByte(state[index!], expanded[offset + index!]) => state[index!]
        index! + 1 => index!
    }
}

subBytes state: mut [UInt8; 16] -> Unit {
    0 => index!
    index! < 16 -> while {
        sbox()[Int(state[index!])] => state[index!]
        index! + 1 => index!
    }
}

shiftRows state: mut [UInt8; 16] -> Unit {
    state[1] => one
    state[5] => state[1]
    state[9] => state[5]
    state[13] => state[9]
    one => state[13]

    state[2] => two
    state[6] => six
    state[10] => state[2]
    state[14] => state[6]
    two => state[10]
    six => state[14]

    state[3] => three
    state[15] => state[3]
    state[11] => state[15]
    state[7] => state[11]
    three => state[7]
}

mixColumns state: mut [UInt8; 16] -> Unit {
    0 => column!
    column! < 4 -> while {
        column! * 4 => base
        state[base] => a
        state[base + 1] => b
        state[base + 2] => c
        state[base + 3] => d
        xorByte(xorByte(xorByte(xtime(a), mul3(b)), c), d) => state[base]
        xorByte(xorByte(xorByte(a, xtime(b)), mul3(c)), d) => state[base + 1]
        xorByte(xorByte(xorByte(a, b), xtime(c)), mul3(d)) => state[base + 2]
        xorByte(xorByte(xorByte(mul3(a), b), c), xtime(d)) => state[base + 3]
        column! + 1 => column!
    }
}

public encryptBlock key: [UInt8; 16], input: [UInt8; 16] -> [UInt8; 16] {
    expandKey(key) => expanded
    BlockValue { bytes: [0; 16] }.bytes => state!
    0 => index!
    index! < 16 -> while {
        input[index!] => state![index!]
        index! + 1 => index!
    }
    addRoundKey(state!, expanded, 0)
    1 => round!
    round! < 10 -> while {
        subBytes(state!)
        shiftRows(state!)
        mixColumns(state!)
        addRoundKey(state!, expanded, round! * 16)
        round! + 1 => round!
    }
    subBytes(state!)
    shiftRows(state!)
    addRoundKey(state!, expanded, 160)
    state!
}
