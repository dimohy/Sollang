namespace sys.crypto.sha512

import sys.crypto.bits as bits

zero64: -> UInt64 => 0
zeroSize: -> UIntSize => 0
scheduleZeros: -> [UInt64; 80] => [0; 80]
digestZeros: -> [UInt8; 64] => [0; 64]

initialState: -> [UInt64; 8] => [
    7_640_891_576_956_012_808, 13_503_953_896_175_478_587,
    4_354_685_564_936_845_355, 11_912_009_170_470_909_681,
    5_840_696_475_078_001_361, 11_170_449_401_992_604_703,
    2_270_897_969_802_886_507, 6_620_516_959_819_538_809]

