    transport.decode(bytes, offset) -> when {
        Ok(decoded) { decoded -> Result<transport.Decoded, QuicError>.Ok }
        Err(value) { Result<transport.Decoded, QuicError>.Err(protocolFailure(value)) }
    }
}

