public struct Ipv4Endpoint {
    a: UInt8
    b: UInt8
    c: UInt8
    d: UInt8
    port: UInt16
}

public struct QuicError {
    kind: errors.Kind
    code: UInt64
}

public struct Identity {
    seed: [UInt8; 32]
}

public struct Endpoint {
    socket: socket.UdpSocket
    identity: Identity
    peerCertificate: [UInt8; ~]
    port: UInt16
}

public struct Connection {
    socket: socket.UdpSocket
    identity: Identity
    peerCertificate: [UInt8; ~]
    peer: Ipv4Endpoint
    localIsServer: Bool
    version: UInt32
    originalDestinationConnectionId: [UInt8; 8]
    localConnectionId: [UInt8; 8]
    remoteConnectionId: [UInt8; 8]
    sendKeys: application.KeyState
    receiveKeys: application.KeyState
    nextSendPacketNumber: UInt64
    nextReceivePacketNumber: UInt64
    clientPending: Bool
    clientPrivateKey: [UInt8; 32]
    clientHello: [UInt8; ~]
    handshakeReceiveSecret: [UInt8; 32]
    handshakeTranscript: [UInt8; ~]
    awaitClientFinished: Bool
    handshakeConfirmed: Bool
    pendingApplicationPacket: [UInt8; ~]
    pendingApplicationAck: Bool
    handshakeDonePending: Bool
    sentPackets: [packetRecovery.SentPacket; ~]
    rtt: recovery.RttState
    congestion: recovery.CongestionState
    flow: streamTypes.ConnectionFlow
    streamSendMaximum: UInt64
    streamReceiveMaximum: UInt64
    peerAckDelayExponent: UInt8
    peerMaxAckDelay: UInt64
    peerMaxDatagramFrameSize: UInt64
}

public struct BiStream {
    id: UInt64
    sendFlow: streamTypes.SendFlow
    receiveFlow: streamTypes.ReceiveFlow
    finished: Bool
}

struct PeerTransport {
    initialMaxData: UInt64
    initialMaxStreamDataBidiLocal: UInt64
    initialMaxStreamDataBidiRemote: UInt64
    initialMaxStreamsBidi: UInt64
    maxUdpPayloadSize: UInt64
    ackDelayExponent: UInt8
    maxAckDelay: UInt64
    maxDatagramFrameSize: UInt64
}

socketFailure value: socket.SocketError -> QuicError {
    QuicError { kind: errors.Kind.Io, code: UInt64(value.code) }
}

protocolFailure value: errors.Error -> QuicError {
    QuicError { kind: value.kind, code: value.code }
}

internalFailure: -> QuicError => QuicError {
    kind: errors.Kind.Internal
    code: errors.internalError()
}

copy8 bytes: [UInt8] -> [UInt8; 8] {
    [UInt8(0); 8] => copied!
    0 => index!
    index! < 8 -> while {
        bytes[index!] => copied![index!]
        index! + 1 => index!
    }
    copied!
}

copy32 bytes: [UInt8] -> [UInt8; 32] {
    [UInt8(0); 32] => copied!
    0 => index!
    index! < 32 -> while {
        bytes[index!] => copied![index!]
        index! + 1 => index!
    }
    copied!
}

random8: -> Result<[UInt8; 8], QuicError> uses Random {
    random.bytes(8) -> when {
        Ok(bytes) { Result<[UInt8; 8], QuicError>.Ok(copy8(bytes)) }
        Err(randomError) { Result<[UInt8; 8], QuicError>.Err(internalFailure()) }
    }
}

random32: -> Result<[UInt8; 32], QuicError> uses Random {
    random.bytes(32) -> when {
        Ok(bytes) { Result<[UInt8; 32], QuicError>.Ok(copy32(bytes)) }
        Err(randomError) { Result<[UInt8; 32], QuicError>.Err(internalFailure()) }
    }
}

appendBytes output: mut [UInt8; ~], bytes: [UInt8] -> Unit {
    0 => index!
    index! < (bytes -> len) -> while {
        output -> push(bytes[index!])
        index! + 1 => index!
    }
}

struct HandshakeMessage {
    bytes: [UInt8; ~]
    nextOffset: UIntSize
}

handshakeMessage bytes: [UInt8], offset: UIntSize -> Result<HandshakeMessage, QuicError> {
    handshakeMessages.decode(bytes, offset) -> when {
        Ok(decoded) {
            [UInt8; ~] => message!
            offset => index!
            index! < decoded.nextOffset -> while {
                message! -> push(bytes[Int(index!)])
                index! + 1 => index!
            }
            Result<HandshakeMessage, QuicError>.Ok(HandshakeMessage {
                bytes: message!
                nextOffset: decoded.nextOffset
            })
        }
        Err(value) { Result<HandshakeMessage, QuicError>.Err(protocolFailure(value)) }
    }
}

encodeHandshakePacket version: UInt32, destinationConnectionId: [UInt8], sourceConnectionId: [UInt8], bytes: [UInt8], secret: [UInt8; 32] -> Result<[UInt8; ~], QuicError> {
    handshakeEngine.encode(
        version,
        destinationConnectionId,
        sourceConnectionId,
        0,
        0,
        bytes,
        secret) -> when {
        Ok(packet) { packet -> Result<[UInt8; ~], QuicError>.Ok }
        Err(value) { Result<[UInt8; ~], QuicError>.Err(protocolFailure(value)) }
    }
}

sendPacket socketValue: socket.UdpSocket, peer: Ipv4Endpoint, bytes: ref [UInt8; ~] -> Result<Unit, QuicError> uses Network {
    Arena(0) => addressStorage!
    "$(peer.a).$(peer.b).$(peer.c).$(peer.d)" -> materialize(addressStorage!) => peerAddress
    socket.sendTo(socketValue, socket.Endpoint { address: peerAddress, port: peer.port }, bytes) -> when {
        Ok(count) {
            count == UIntSize(bytes -> len) -> if {
                Result<Unit, QuicError>.Ok
            } else { Result<Unit, QuicError>.Err(internalFailure()) }
        }
        Err(sendError) { Result<Unit, QuicError>.Err(socketFailure(sendError)) }
    }
}

receivePacket socketValue: socket.UdpSocket -> Result<socket.Datagram, QuicError> uses Network {
    socket.receiveFrom(socketValue, 65_535) -> when {
        Ok(datagram) { Result<socket.Datagram, QuicError>.Ok(datagram) }
        Err(receiveError) { Result<socket.Datagram, QuicError>.Err(socketFailure(receiveError)) }
    }
}

parsePeer bytes: [UInt8], port: UInt16 -> Result<Ipv4Endpoint, QuicError> {
    [0; 4] => parts!
    0 => part!
    0 => value!
    0 => index!
    true => valid!
    (valid! and index! <= (bytes -> len)) -> while {
        index! == (bytes -> len) => end
        false => separator!
        end -> unless { bytes[index!] == 46 => separator! }
        (end or separator!) -> if {
            (part! < 4 and value! <= 255) -> if {
                value! => parts![part!]
                part! + 1 => part!
                0 => value!
            } else { false => valid! }
        } else {
            bytes[index!] => digit
            (digit >= 48 and digit <= 57) -> if {
                value! * 10 + Int(digit - 48) => value!
            } else { false => valid! }
        }
        index! + 1 => index!
    }
    (valid! and part! == 4) -> unless {
        Result<Ipv4Endpoint, QuicError>.Err(QuicError {
            kind: errors.Kind.InvalidArgument
            code: errors.noViablePath()
        }) -> return
    }
    Result<Ipv4Endpoint, QuicError>.Ok(Ipv4Endpoint {
        a: UInt8(parts![0])
        b: UInt8(parts![1])
        c: UInt8(parts![2])
        d: UInt8(parts![3])
        port: port
    })
}

public generateIdentity: -> Result<Identity, QuicError> uses Random {
    ed25519.generateSeed() -> when {
        Ok(seed) { Result<Identity, QuicError>.Ok(Identity { seed: seed }) }
        Err(randomError) {
            Result<Identity, QuicError>.Err(QuicError {
                kind: errors.Kind.Crypto
                code: errors.internalError()
            })
        }
    }
}

public certificate identity: ref Identity -> Result<[UInt8; ~], QuicError> {
    x509Identity.certificate(identity.seed) -> when {
        Ok(der) { Result<[UInt8; ~], QuicError>.Ok(der) }
        Err(certificateError) {
            Result<[UInt8; ~], QuicError>.Err(QuicError {
                kind: certificateError.kind
                code: certificateError.code
            })
        }
    }
}

public bind local: Ipv4Endpoint, identity: move Identity, peerCertificate: move [UInt8; ~] -> Result<Endpoint, QuicError> uses Network {
    Arena(0) => addressStorage!
    "$(local.a).$(local.b).$(local.c).$(local.d)" -> materialize(addressStorage!) => localAddress
    socket.bindDatagram(socket.DatagramBindOptions {
        endpoint: socket.Endpoint { address: localAddress, port: local.port }
        reuseAddress: true
    }) -> when {
        Ok(bound) {
            socket.localPort(bound) -> when {
                Ok(port) {
                    Result<Endpoint, QuicError>.Ok(Endpoint {
                        socket: bound
                        identity: identity
                        peerCertificate: peerCertificate
                        port: port
                    }) -> return
                }
                Err(portError) { Result<Endpoint, QuicError>.Err(socketFailure(portError)) -> return }
            }
        }
        Err(bindError) { Result<Endpoint, QuicError>.Err(socketFailure(bindError)) -> return }
    }
}

public localPort endpoint: ref Endpoint -> UInt16 => endpoint.port

public version1: -> UInt32 => keys.version1()
public version2: -> UInt32 => keys.version2()

sameBytes left: [UInt8], right: [UInt8] -> Bool {
    (left -> len) == (right -> len) -> unless { false -> return }
    0 => index!
    index! < (left -> len) -> while {
        left[index!] == right[index!] -> unless { false -> return }
        index! + 1 => index!
    }
    true
}

encodeParameter id: UInt64, value: [UInt8] -> Result<[UInt8; ~], QuicError> {
    transport.encode(id, value) -> when {
        Ok(encoded) { encoded -> Result<[UInt8; ~], QuicError>.Ok }
        Err(value) { Result<[UInt8; ~], QuicError>.Err(protocolFailure(value)) }
    }
}

encodeIntegerParameter id: UInt64, value: UInt64 -> Result<[UInt8; ~], QuicError> {
    transport.encodeInteger(id, value) -> when {
        Ok(encoded) { encoded -> Result<[UInt8; ~], QuicError>.Ok }
        Err(value) { Result<[UInt8; ~], QuicError>.Err(protocolFailure(value)) }
    }
}

encodeVersionInformation chosen: UInt32 -> Result<[UInt8; ~], QuicError> {
    negotiation.encode(negotiation.Information {
        chosen: chosen
        available: [keys.version2(), keys.version1()]
    }) -> when {
        Ok(encoded) { Result<[UInt8; ~], QuicError>.Ok(encoded) }
        Err(value) { Result<[UInt8; ~], QuicError>.Err(protocolFailure(value)) }
    }
}

appendParameter output: mut [UInt8; ~], parameter: move [UInt8; ~] -> Unit {
    output -> appendBytes(parameter)
}

commonTransportParameters version: UInt32, sourceConnectionId: [UInt8] -> Result<[UInt8; ~], QuicError> {
    [UInt8; ~] => parameters!
    parameters! -> appendParameter(encodeParameter(transport.initialSourceConnectionId(), sourceConnectionId)?)
    parameters! -> appendParameter(encodeIntegerParameter(transport.maxUdpPayloadSize(), 65_527)?)
    parameters! -> appendParameter(encodeIntegerParameter(transport.initialMaxData(), 1_048_576)?)
    parameters! -> appendParameter(encodeIntegerParameter(transport.initialMaxStreamDataBidiLocal(), 262_144)?)
    parameters! -> appendParameter(encodeIntegerParameter(transport.initialMaxStreamDataBidiRemote(), 262_144)?)
    parameters! -> appendParameter(encodeIntegerParameter(transport.initialMaxStreamsBidi(), 16)?)
    parameters! -> appendParameter(encodeIntegerParameter(transport.activeConnectionIdLimit(), 2)?)
    parameters! -> appendParameter(encodeIntegerParameter(transport.maxDatagramFrameSize(), 65_527)?)
    encodeVersionInformation(version)? => versionBytes
    parameters! -> appendParameter(encodeParameter(transport.versionInformation(), versionBytes)?)
    Result<[UInt8; ~], QuicError>.Ok(parameters!)
}

clientTransportParameters version: UInt32, sourceConnectionId: [UInt8] -> Result<[UInt8; ~], QuicError> {
    commonTransportParameters(version, sourceConnectionId)
}

serverTransportParameters version: UInt32, sourceConnectionId: [UInt8], originalDestinationConnectionId: [UInt8] -> Result<[UInt8; ~], QuicError> {
    commonTransportParameters(version, sourceConnectionId)? => parameters!
    parameters! -> appendParameter(encodeParameter(
        transport.originalDestinationConnectionId(),
        originalDestinationConnectionId)?)
    Result<[UInt8; ~], QuicError>.Ok(parameters!)
}

encodeClientHello randomValue: [UInt8; 32], publicKey: [UInt8; 32], transportParameters: [UInt8] -> Result<[UInt8; ~], QuicError> {
    hello.encodeClientHello(
        randomValue,
        [115, 111, 108, 108, 97, 110, 103, 45, 112, 101, 101, 114],
        [104, 51],
        publicKey,
        transportParameters) -> when {
        Ok(message) { message -> Result<[UInt8; ~], QuicError>.Ok }
        Err(value) { Result<[UInt8; ~], QuicError>.Err(protocolFailure(value)) }
    }
}

encodeClientInitial version: UInt32, destinationConnectionId: [UInt8], sourceConnectionId: [UInt8], clientHello: [UInt8] -> Result<[UInt8; ~], QuicError> {
    initial.encodeClientInitial(version, destinationConnectionId, sourceConnectionId, 0, clientHello) -> when {
