namespace sys.io

import sys.runtime as rt

# Console and standard-stream access are system I/O effects. Portable memory
# readers, writers, and buffers live in std.io.
public print value: Text -> Unit uses Console {
    value -> rt.print
}

public println value: Text -> Unit uses Console {
    value -> rt.println
}

public readInt prompt: Text -> Int uses Console {
    prompt -> rt.readInt
}
