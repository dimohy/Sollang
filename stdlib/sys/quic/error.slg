namespace sys.quic.error

public enum Kind {
    InvalidArgument
    AddressInUse
    ConnectionFailed
    ConnectionClosed
    TimedOut
    Tls
    Io
    Internal
    Encoding
    Truncated
    ProtocolViolation
    Crypto
    Transport
}

public struct Error {
    kind: Kind
    code: UInt64
}

public noError: -> UInt64 => 0
public internalError: -> UInt64 => 1
public flowControlError: -> UInt64 => 3
public streamLimitError: -> UInt64 => 4
public streamStateError: -> UInt64 => 5
public finalSizeError: -> UInt64 => 6
public frameEncodingError: -> UInt64 => 7
public transportParameterError: -> UInt64 => 8
public protocolViolation: -> UInt64 => 10
public cryptoBufferExceeded: -> UInt64 => 13
public keyUpdateError: -> UInt64 => 14
public aeadLimitReached: -> UInt64 => 15
public noViablePath: -> UInt64 => 16
public versionNegotiationError: -> UInt64 => 17
