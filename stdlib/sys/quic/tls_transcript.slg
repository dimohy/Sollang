namespace sys.quic.tls_transcript

import sys.crypto.sha256

public struct Transcript {
    bytes: [UInt8; ~]
}

public create: -> Transcript => Transcript { bytes: [] }

appendBytes bytes: mut [UInt8; ~], message: [UInt8] -> Unit {
    0 => index!
    index! < (message -> len) -> while {
        bytes -> push(message[index!])
        index! + 1 => index!
    }
}

public append transcript: mut Transcript, message: [UInt8] -> Unit {
    transcript.bytes -> appendBytes(message)
}

public hash transcript: ref Transcript -> [UInt8; 32] {
    sha256.digest(transcript.bytes)
}

public byteCount transcript: ref Transcript -> Int {
    transcript.bytes -> len
}
