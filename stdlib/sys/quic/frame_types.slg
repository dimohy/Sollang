namespace sys.quic.frame_types

public struct Crypto {
    offset: UInt64
    data: [UInt8; ~]
}

public struct Stream {
    id: UInt64
    offset: UInt64
    fin: Bool
    data: [UInt8; ~]
}

public struct Datagram {
    data: [UInt8; ~]
}

public struct MaxStreamData {
    id: UInt64
    maximum: UInt64
}

public struct MaxStreams {
    bidirectional: Bool
    maximum: UInt64
}

public struct StreamDataBlocked {
    id: UInt64
    limit: UInt64
}

public struct StreamsBlocked {
    bidirectional: Bool
    limit: UInt64
}

public struct ConnectionClose {
    application: Bool
    errorCode: UInt64
    frameType: UInt64
    reason: [UInt8; ~]
}

public struct NewConnectionId {
    sequence: UInt64
    retirePriorTo: UInt64
    connectionId: [UInt8; ~]
    statelessResetToken: [UInt8; 16]
}

public struct AckRange {
    gap: UInt64
    rangeLength: UInt64
}

public struct Ack {
    largestAcknowledged: UInt64
    ackDelay: UInt64
    firstRange: UInt64
    ranges: [AckRange; ~]
}

public enum Value {
    Padding(UInt64)
    Ping
    Ack(Ack)
    Crypto(Crypto)
    Stream(Stream)
    Datagram(Datagram)
    MaxData(UInt64)
    MaxStreamData(MaxStreamData)
    MaxStreams(MaxStreams)
    DataBlocked(UInt64)
    StreamDataBlocked(StreamDataBlocked)
    StreamsBlocked(StreamsBlocked)
    NewConnectionId(NewConnectionId)
    RetireConnectionId(UInt64)
    ConnectionClose(ConnectionClose)
    HandshakeDone
}

public struct Decoded {
    frame: Value
    nextOffset: UIntSize
}
