namespace sys.quic.stream_types

public enum Initiator {
    Client
    Server
}

public enum Direction {
    Bidirectional
    Unidirectional
}

public struct StreamIdentity {
    id: UInt64
    sequence: UInt64
    initiator: Initiator
    direction: Direction
}

public struct ReceiveFlow {
    maximum: UInt64
    highestReceived: UInt64
    consumed: UInt64
    finalKnown: Bool
    finalSize: UInt64
}

public struct SendFlow {
    maximum: UInt64
    sent: UInt64
    finalKnown: Bool
    finalSize: UInt64
}

public struct ConnectionFlow {
    receiveMaximum: UInt64
    received: UInt64
    consumed: UInt64
    sendMaximum: UInt64
    sent: UInt64
}

public struct StreamLimits {
    bidirectional: UInt64
    unidirectional: UInt64
}
