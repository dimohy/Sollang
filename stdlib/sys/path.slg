namespace sys.path

import sys.directory.kind as kinds

# Path owns its UTF-8 storage. It is not a Text alias and therefore cannot
# outlive borrowed source storage accidentally.
public struct Path {
    bytes: [UInt8; ~]
    style: Style
}

# A query follows symbolic links and returns one owned canonical path together
# with the portable metadata shared by Windows and Linux.
public struct RawInfo {
    bytes: [UInt8; ~]
    kindCode: UInt8
    byteLength: UInt64
    modifiedNanos: UInt64
}

public struct Info {
    canonical: Path
    kind: kinds.Kind
    byteLength: UInt64
    modifiedNanos: UInt64
}

# Path style is explicit so a cross-compiler can manipulate target paths
# without silently applying the host machine's separator rules.
public enum Style {
    Posix
    Windows
}

public queryRaw target: Path -> Result<RawInfo, Text> uses File = intrinsic

queryKind code: UInt8 -> kinds.Kind {
    code == 0 -> if {
        kinds.Kind.File
    } else {
        code == 1 -> if {
            kinds.Kind.Directory
        } else {
            code == 2 -> if {
                kinds.Kind.Symlink
            } else {
                kinds.Kind.Other
            }
        }
    }
}

copyBytes source: [UInt8; ~] -> [UInt8; ~] {
    [UInt8; ~] => copied!
    0 => index!
    index! < (source -> len) -> while {
        copied! -> push(source[index!])
        index! + 1 => index!
    }
    copied!
}

public query target: Path -> Result<Info, Text> uses File {
    target.style => style
    target -> queryRaw -> when {
        Ok(raw) {
            raw.bytes -> copyBytes => canonicalBytes
            Info {
                canonical: Path { bytes: canonicalBytes, style: style }
                kind: raw.kindCode -> queryKind
                byteLength: raw.byteLength
                modifiedNanos: raw.modifiedNanos
            } => info
            Result<Info, Text>.Ok(info) -> return
        }
        Err(error) {
            Result<Info, Text>.Err(error) -> return
        }
    }
    Result<Info, Text>.Err("io")
}

# The compiled target decides this value; it never reflects the build host.
public nativeStyle: -> Style = intrinsic

public pathText value: ref Path -> Text = intrinsic

sameStyle left: Style, right: Style -> Bool {
    left -> when {
        Posix {
            right -> when {
                Posix { true }
                Windows { false }
            }
        }
        Windows {
            right -> when {
                Posix { false }
                Windows { true }
            }
        }
    }
}

isSeparator value: UInt8, style: Style -> Bool {
    style -> when {
        Posix { value == 47 }
        Windows { value == 47 or value == 92 }
    }
}

pathError message: Text -> Result<Path, Text> {
    Result<Path, Text>.Err(message) => result
    result
}

public fromText value: Text, style: Style -> Path {
    [UInt8; ~] => bytes!
    UIntSize(0) => index!
    index! < (value -> len) -> while {
        bytes! -> push(value -> byte(index!))
        index! + 1 => index!
    }
    Path { bytes: bytes!, style: style } => result
    result
}

public byteCount path: Path -> UIntSize {
    UIntSize(path.bytes -> len)
}

public equalsText path: Path, value: Text -> Bool {
    UIntSize(path.bytes -> len) => pathLength
    value -> len => valueLength
    pathLength == valueLength => matches!
    UIntSize(0) => index!
    (matches! and index! < pathLength) -> while {
        path.bytes[Int(index!)] != (value -> byte(index!))
            -> if { false => matches! }
        index! + 1 => index!
    }
    matches!
}

public endsWithText path: ref Path, value: Text -> Bool {
    UIntSize(path.bytes -> len) => pathLength
    value -> len => valueLength
    valueLength <= pathLength => matches!
    pathLength - valueLength => start
    UIntSize(0) => index!
    (matches! and index! < valueLength) -> while {
        path.bytes[Int(start + index!)] != (value -> byte(index!))
            -> if { false => matches! }
        index! + 1 => index!
    }
    matches!
}

public isAbsolute path: Path -> Bool {
    path.style -> when {
        Posix {
            UIntSize(path.bytes -> len) > 0 and path.bytes[0] == 47
        }
        Windows {
            UIntSize(path.bytes -> len) => length
            false => absolute!
            (length >= 2 and (path.bytes[0] == 47 or path.bytes[0] == 92) and (path.bytes[1] == 47 or path.bytes[1] == 92))
                -> if { true => absolute! }
            (length >= 3 and path.bytes[1] == 58 and (path.bytes[2] == 47 or path.bytes[2] == 92))
                -> if { true => absolute! }
            absolute!
        }
    }
}

# Join rejects an absolute child rather than silently discarding the base.
public join base: move Path, child: Text -> Result<Path, Text> {
    base.style => style
    style -> when {
        Posix {
            (child -> len) > 0 and (child -> byte(0)) == 47
        }
        Windows {
            child -> len => childLength
            false => absolute!
            (childLength >= 2 and ((child -> byte(UIntSize(0))) == 47 or (child -> byte(UIntSize(0))) == 92) and ((child -> byte(UIntSize(1))) == 47 or (child -> byte(UIntSize(1))) == 92))
                -> if { true => absolute! }
            (childLength >= 3 and (child -> byte(UIntSize(1))) == 58 and ((child -> byte(UIntSize(2))) == 47 or (child -> byte(UIntSize(2))) == 92))
                -> if { true => absolute! }
            absolute!
        }
    } => childAbsolute
    childAbsolute -> if {
        pathError("absolute child path") -> return
    }
    base.bytes => bytes!
    UIntSize(bytes! -> len) => baseLength
    false => endsWithSeparator!
    baseLength > 0 -> if {
        bytes![Int(baseLength - 1)] => lastByte
        style -> when {
            Posix => lastByte == 47
            Windows => lastByte == 47 or lastByte == 92
        } => endsWithSeparator!
    }
    (baseLength > 0 and (child -> len) > 0 and not endsWithSeparator!)
        -> if {
        style -> when {
            Posix => UInt8(47)
            Windows => UInt8(92)
        } => separator
        bytes! -> push(separator)
    }
    UIntSize(0) => childIndex!
    childIndex! < (child -> len) -> while {
        bytes! -> push(child -> byte(childIndex!))
        childIndex! + 1 => childIndex!
    }
    Path { bytes: bytes!, style: style } => joined
    Result<Path, Text>.Ok(joined)
}

# Joins two borrowed path values into a fresh owned result.
public joinDiscovered base: ref Path, child: ref Path -> Path {
    [UInt8; ~] => bytes!
    UIntSize(0) => baseIndex!
    baseIndex! < UIntSize(base.bytes -> len) -> while {
        bytes! -> push(base.bytes[Int(baseIndex!)])
        baseIndex! + 1 => baseIndex!
    }
    UIntSize(bytes! -> len) => baseLength
    false => endsWithSeparator!
    baseLength > 0 -> if {
        bytes![Int(baseLength - 1)] => last
        isSeparator(last, base.style) => endsWithSeparator!
    }
    (baseLength > 0 and UIntSize(child.bytes -> len) > 0 and not endsWithSeparator!)
        -> if {
        base.style -> when {
            Posix => UInt8(47)
            Windows => UInt8(92)
        } => separator
        bytes! -> push(separator)
    }
    UIntSize(0) => childIndex!
    childIndex! < UIntSize(child.bytes -> len) -> while {
        bytes! -> push(child.bytes[Int(childIndex!)])
        childIndex! + 1 => childIndex!
    }
    Path { bytes: bytes!, style: base.style } => joined
    joined
}

public joinPath base: Path, child: Path -> Result<Path, Text> {
    not sameStyle(base.style, child.style) -> if {
        Result<Path, Text>.Err("path styles differ") -> return
    }
    child -> isAbsolute -> if {
        Result<Path, Text>.Err("cannot join an absolute child") -> return
    }

    base -> joinDiscovered(child) => joined
    Result<Path, Text>.Ok(joined)
}

# Lexical normalization never touches the filesystem. Parent components that
# would cross the starting root are rejected, which is the safe default for
# package roots and module discovery.
public normalizeConfined path: move Path -> Result<Path, Text> {
    path.style => style
    path.bytes => source
    [UInt8; ~] => output!
    [UIntSize; ~] => componentStarts!
    style -> when {
        Posix => false
        Windows => true
    } => windows
    UIntSize(source -> len) => sourceLength
    UIntSize(0) => index!
    false => absolute!
    false => unc!
    UIntSize(0) => protectedComponents!

    windows -> if {
        (sourceLength >= 2 and source[1] == 58) -> if {
            output! -> push(source[0])
            output! -> push(58)
            2 => index!
            (index! < sourceLength and (source[Int(index!)] == 47 or source[Int(index!)] == 92))
                -> if {
                output! -> push(92)
                true => absolute!
                (index! < sourceLength and (source[Int(index!)] == 47 or source[Int(index!)] == 92))
                    -> while { index! + 1 => index! }
            }
        } else {
            (sourceLength >= 2 and (source[0] == 47 or source[0] == 92) and (source[1] == 47 or source[1] == 92))
                -> if {
                output! -> push(92)
                output! -> push(92)
                true => absolute!
                true => unc!
                2 => protectedComponents!
                2 => index!
                (index! < sourceLength and (source[Int(index!)] == 47 or source[Int(index!)] == 92))
                    -> while { index! + 1 => index! }
            }
        }
    } else {
        (sourceLength > 0 and source[0] == 47) -> if {
            output! -> push(47)
            true => absolute!
            1 => index!
            (index! < sourceLength and source[Int(index!)] == 47)
                -> while { index! + 1 => index! }
        }
    }

    false => escaped!
    false => wroteComponent!
    (index! < sourceLength and not escaped!) -> while {
        index! => componentStart
        (index! < sourceLength and (windows -> if { source[Int(index!)] != 47 and source[Int(index!)] != 92 } else { source[Int(index!)] != 47 }))
            -> while {
            index! + 1 => index!
        }
        index! => componentEnd
        componentEnd - componentStart => componentLength
        (index! < sourceLength and (windows -> if { source[Int(index!)] == 47 or source[Int(index!)] == 92 } else { source[Int(index!)] == 47 }))
            -> while {
            index! + 1 => index!
        }

        componentLength == 1 and source[Int(componentStart)] == 46 => currentDirectory
        componentLength == 2 and source[Int(componentStart)] == 46 and source[Int(componentStart + 1)] == 46 => parentDirectory
        (componentLength > 0 and not currentDirectory and not parentDirectory)
            -> if {
            UIntSize(output! -> len) => truncateStart
            wroteComponent! -> if {
                windows -> if { output! -> push(92) } else { output! -> push(47) }
            }
            componentStarts! -> push(truncateStart)
            componentStart => componentByteIndex!
            componentByteIndex! < componentEnd -> while {
                output! -> push(source[Int(componentByteIndex!)])
                componentByteIndex! + 1 => componentByteIndex!
            }
            true => wroteComponent!
        }
        parentDirectory -> if {
            UIntSize(componentStarts! -> len) > protectedComponents!
                -> if {
                componentStarts! -> take(Int(UIntSize(componentStarts! -> len) - 1)) => truncateTo
                UIntSize(output! -> len) > truncateTo -> while {
                    output! -> take(Int(UIntSize(output! -> len) - 1)) => removedByte
                }
                UIntSize(componentStarts! -> len) > 0 => wroteComponent!
            } else {
                true => escaped!
            }
        }
    }

    escaped! -> if {
        pathError("path escapes root") -> return
    }
    (unc! and UIntSize(componentStarts! -> len) < 2)
        -> if {
        pathError("incomplete UNC path") -> return
    }
    UIntSize(output! -> len) == 0 -> if { output! -> push(46) }
    Path { bytes: output!, style: style } => normalized
    Result<Path, Text>.Ok(normalized)
}
