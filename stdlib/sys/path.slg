namespace sys.path

import sys.directory.kind as kinds

# Path owns its UTF-8 storage. It is not a Text alias and therefore cannot
# outlive borrowed source storage accidentally.
public struct Path {
    public bytes: [UInt8; ~]
    public style: Style
}

# A query follows symbolic links and returns one owned canonical path together
# with the portable metadata shared by Windows and Linux.
public struct RawInfo {
    public bytes: [UInt8; ~]
    public kindCode: UInt8
    public byteLength: UInt64
    public modifiedNanos: UInt64
}

public struct Info {
    public canonical: Path
    public kind: kinds.Kind
    public byteLength: UInt64
    public modifiedNanos: UInt64
}

# Path style is explicit so a cross-compiler can manipulate target paths
# without silently applying the host machine's separator rules.
public enum Style {
    Posix
    Windows
}

queryKind code: UInt8 -> kinds.Kind {
    code == 0 -> if {
        kinds.Kind.File
    } else {
        code == 1 -> if {
            kinds.Kind.Directory
        } else {
            code == 2 -> if {
                kinds.Kind.Symlink
            } else {
                kinds.Kind.Other
            }
        }
    }
}

copyBytes source: [UInt8; ~] -> [UInt8; ~] {
    [UInt8; ~] => copied!
    0 => index!
    index! < (source -> len) -> while {
        copied! -> push(source[index!])
        index! + 1 => index!
    }
    copied!
}

impl Path {
    public query: self -> Result<Info, Text> uses File {
        self.style => style
        self -> queryRaw -> when {
            Ok(raw) {
                raw.bytes -> copyBytes => canonicalBytes
                Info {
                    canonical: Path { bytes: canonicalBytes, style: style }
                    kind: raw.kindCode -> queryKind
                    byteLength: raw.byteLength
                    modifiedNanos: raw.modifiedNanos
                } => info
                Result<Info, Text>.Ok(info) -> return
            }
            Err(error) {
                Result<Info, Text>.Err(error) -> return
            }
        }
        Result<Info, Text>.Err("io")
    }
}

sameStyle left: Style, right: Style -> Bool {
    left -> when {
        Posix {
            right -> when {
                Posix { true }
                Windows { false }
            }
        }
        Windows {
            right -> when {
                Posix { false }
                Windows { true }
            }
        }
    }
}

isSeparator value: UInt8, style: Style -> Bool {
    style -> when {
        Posix { value == '/' }
        Windows { value == '/' or value == '\\' }
    }
}

pathError message: Text -> Result<Path, Text> {
    Result<Path, Text>.Err(message) => result
    result
}

public fromText value: Text, style: Style -> Path {
    [UInt8; ~] => bytes!
    UIntSize(0) => index!
    index! < (value -> len) -> while {
        bytes! -> push(value -> byte(index!))
        index! + 1 => index!
    }
    Path { bytes: bytes!, style: style } => result
    result
}

impl Path {
    public byteCount: self -> UIntSize {
        UIntSize(self.bytes -> len)
    }

    public equalsText: self, value: Text -> Bool {
        UIntSize(self.bytes -> len) => pathLength
        value -> len => valueLength
        pathLength == valueLength => matches!
        UIntSize(0) => index!
        matches! and index! < pathLength -> while {
            self.bytes[Int(index!)] != (value -> byte(index!))
                -> if { false => matches! }
            index! + 1 => index!
        }
        matches!
    }

    public endsWithText: self, value: Text -> Bool {
        UIntSize(self.bytes -> len) => pathLength
        value -> len => valueLength
        valueLength <= pathLength => matches!
        pathLength - valueLength => start
        UIntSize(0) => index!
        matches! and index! < valueLength -> while {
            self.bytes[Int(start + index!)] != (value -> byte(index!))
                -> if { false => matches! }
            index! + 1 => index!
        }
        matches!
    }

    public isAbsolute: self -> Bool {
        self.style -> when {
            Posix {
                UIntSize(self.bytes -> len) > 0 and self.bytes[0] == '/'
            }
            Windows {
                UIntSize(self.bytes -> len) => length
                false => absolute!
                length >= 2 and (self.bytes[0] == '/' or self.bytes[0] == '\\') and (self.bytes[1] == '/' or self.bytes[1] == '\\')
                    -> if { true => absolute! }
                length >= 3 and self.bytes[1] == ':' and (self.bytes[2] == '/' or self.bytes[2] == '\\')
                    -> if { true => absolute! }
                absolute!
            }
        }
    }

    # Join rejects an absolute child rather than silently discarding the base.
    public join: move self, child: Text -> Result<Path, Text> {
        self.style => style
        style -> when {
            Posix {
                (child -> len) > 0 and (child -> byte(0)) == '/'
            }
            Windows {
                child -> len => childLength
                false => absolute!
                childLength >= 2 and ((child -> byte(UIntSize(0))) == '/' or (child -> byte(UIntSize(0))) == '\\') and ((child -> byte(UIntSize(1))) == '/' or (child -> byte(UIntSize(1))) == '\\')
                    -> if { true => absolute! }
                childLength >= 3 and (child -> byte(UIntSize(1))) == ':' and ((child -> byte(UIntSize(2))) == '/' or (child -> byte(UIntSize(2))) == '\\')
                    -> if { true => absolute! }
                absolute!
            }
        } => childAbsolute
        childAbsolute -> if {
            pathError("absolute child path") -> return
        }
        self.bytes => bytes!
        UIntSize(bytes! -> len) => baseLength
        false => endsWithSeparator!
        baseLength > 0 -> if {
            bytes![Int(baseLength - 1)] => lastByte
            style -> when {
                Posix => lastByte == '/'
                Windows => lastByte == '/' or lastByte == '\\'
            } => endsWithSeparator!
        }
        baseLength > 0 and (child -> len) > 0 and not endsWithSeparator!
            -> if {
                style -> when {
                    Posix => UInt8('/')
                    Windows => UInt8('\\')
                } => separator
                bytes! -> push(separator)
            }
        UIntSize(0) => childIndex!
        childIndex! < (child -> len) -> while {
            bytes! -> push(child -> byte(childIndex!))
            childIndex! + 1 => childIndex!
        }
        Path { bytes: bytes!, style: style } => joined
        Result<Path, Text>.Ok(joined)
    }

    # Joins two borrowed path values into a fresh owned result.
    public joinDiscovered: self, child: ref Path -> Path {
        [UInt8; ~] => bytes!
        UIntSize(0) => baseIndex!
        baseIndex! < UIntSize(self.bytes -> len) -> while {
            bytes! -> push(self.bytes[Int(baseIndex!)])
            baseIndex! + 1 => baseIndex!
        }
        UIntSize(bytes! -> len) => baseLength
        false => endsWithSeparator!
        baseLength > 0 -> if {
            bytes![Int(baseLength - 1)] => last
            isSeparator(last, self.style) => endsWithSeparator!
        }
        baseLength > 0 and UIntSize(child.bytes -> len) > 0 and not endsWithSeparator!
            -> if {
                self.style -> when {
                    Posix => UInt8('/')
                    Windows => UInt8('\\')
                } => separator
                bytes! -> push(separator)
            }
        UIntSize(0) => childIndex!
        childIndex! < UIntSize(child.bytes -> len) -> while {
            bytes! -> push(child.bytes[Int(childIndex!)])
            childIndex! + 1 => childIndex!
        }
        Path { bytes: bytes!, style: self.style } => joined
        joined
    }

    public joinPath: self, child: ref Path -> Result<Path, Text> {
        not sameStyle(self.style, child.style) -> if {
            Result<Path, Text>.Err("path styles differ") -> return
        }
        child -> isAbsolute -> if {
            Result<Path, Text>.Err("cannot join an absolute child") -> return
        }

        self -> joinDiscovered(child) => joined
        Result<Path, Text>.Ok(joined)
    }

    # Lexical normalization never touches the filesystem. Parent components that
    # would cross the starting root are rejected, which is the safe default for
    # package roots and module discovery.
    public normalizeConfined: move self -> Result<Path, Text> {
        self.style => style
        self.bytes => source
        [UInt8; ~] => output!
        [UIntSize; ~] => componentStarts!
        style -> when {
            Posix => false
            Windows => true
        } => windows
        UIntSize(source -> len) => sourceLength
        UIntSize(0) => index!
        false => absolute!
        false => unc!
        UIntSize(0) => protectedComponents!

        windows -> if {
            sourceLength >= 2 and source[1] == ':' -> if {
                output! -> push(source[0])
                output! -> push(':')
                2 => index!
                index! < sourceLength and (source[Int(index!)] == '/' or source[Int(index!)] == '\\')
                    -> if {
                        output! -> push('\\')
                        true => absolute!
                        index! < sourceLength and (source[Int(index!)] == '/' or source[Int(index!)] == '\\')
                            -> while { index! + 1 => index! }
                    }
            } else {
                sourceLength >= 2 and (source[0] == '/' or source[0] == '\\') and (source[1] == '/' or source[1] == '\\')
                    -> if {
                        output! -> push('\\')
                        output! -> push('\\')
                        true => absolute!
                        true => unc!
                        2 => protectedComponents!
                        2 => index!
                        index! < sourceLength and (source[Int(index!)] == '/' or source[Int(index!)] == '\\')
                            -> while { index! + 1 => index! }
                    }
            }
        } else {
            sourceLength > 0 and source[0] == '/' -> if {
                output! -> push('/')
                true => absolute!
                1 => index!
                index! < sourceLength and source[Int(index!)] == '/'
                    -> while { index! + 1 => index! }
            }
        }

        false => escaped!
        false => wroteComponent!
        index! < sourceLength and not escaped! -> while {
            index! => componentStart
            index! < sourceLength and (windows -> if { source[Int(index!)] != '/' and source[Int(index!)] != '\\' } else { source[Int(index!)] != '/' })
                -> while {
                    index! + 1 => index!
                }
            index! => componentEnd
            componentEnd - componentStart => componentLength
            index! < sourceLength and (windows -> if { source[Int(index!)] == '/' or source[Int(index!)] == '\\' } else { source[Int(index!)] == '/' })
                -> while {
                    index! + 1 => index!
                }

            componentLength == 1 and source[Int(componentStart)] == '.' => currentDirectory
            componentLength == 2 and source[Int(componentStart)] == '.' and source[Int(componentStart + 1)] == '.' => parentDirectory
            componentLength > 0 and not currentDirectory and not parentDirectory
                -> if {
                    UIntSize(output! -> len) => truncateStart
                    wroteComponent! -> if {
                        windows -> if { output! -> push('\\') } else { output! -> push('/') }
                    }
                    componentStarts! -> push(truncateStart)
                    componentStart => componentByteIndex!
                    componentByteIndex! < componentEnd -> while {
                        output! -> push(source[Int(componentByteIndex!)])
                        componentByteIndex! + 1 => componentByteIndex!
                    }
                    true => wroteComponent!
                }
            parentDirectory -> if {
                UIntSize(componentStarts! -> len) > protectedComponents!
                    -> if {
                        componentStarts! -> take(Int(UIntSize(componentStarts! -> len) - 1)) => truncateTo
                        UIntSize(output! -> len) > truncateTo -> while {
                            output! -> take(Int(UIntSize(output! -> len) - 1)) => removedByte
                        }
                        UIntSize(componentStarts! -> len) > 0 => wroteComponent!
                    } else {
                        true => escaped!
                    }
            }
        }

        escaped! -> if {
            pathError("path escapes root") -> return
        }
        unc! and UIntSize(componentStarts! -> len) < 2
            -> if {
                pathError("incomplete UNC path") -> return
            }
        UIntSize(output! -> len) == 0 -> if { output! -> push('.') }
        Path { bytes: output!, style: style } => normalized
        Result<Path, Text>.Ok(normalized)
    }
}
