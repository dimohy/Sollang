namespace benchmark.hash_set_mixed

import sys.runtime as runtime

main {
    10000000 => operations
    Set<Int>(10000000) => values!
    runtime.nowMillis() => started
    0 => i!
    i! < operations -> while {
        values! -> insert(i!) => inserted
        i! + 1 => i!
    }
    Long(0) => checksum!
    0 => probe!
    probe! < operations -> while {
        values! -> contains(probe!) => present
        present -> if {
            checksum! + Long(probe!) => checksum!
        }
        probe! + 1 => probe!
    }
    0 => removed!
    removed! < operations -> while {
        values! -> remove(removed!) => changed
        changed -> if {
            checksum! + Long(1) => checksum!
        }
        removed! + 2 => removed!
    }
    runtime.nowMillis() => finished
    values! -> len => length
    values! -> capacity => capacity
    finished - started => elapsed
    checksum! + Long(0) => finalChecksum
    "checksum=$finalChecksum elapsed_ms=$elapsed len=$length capacity=$capacity" -> println
}
