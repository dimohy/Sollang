    }

    expressionIrStart => operandIrIndex!
    operandIrIndex! < expressionIrEnd -> while {
        nodes[operandIrIndex!] => operatorIr!
        operatorIr!.kind == 6 or operatorIr!.kind == 7 or operatorIr!.kind == 8 or (operatorIr!.kind == 9 and (operatorIr!.opcode == -27 or (operatorIr!.opcode <= -201 and (operatorIr!.opcode >= -206 or operatorIr!.opcode == -213 or (operatorIr!.opcode == -223 or operatorIr!.opcode == -303) or operatorIr!.opcode == -224 or operatorIr!.opcode == -225 or operatorIr!.opcode == -226 or operatorIr!.opcode == -227 or operatorIr!.opcode == -228 or operatorIr!.opcode == -229 or operatorIr!.opcode == -236)) or (operatorIr!.opcode <= -241 and operatorIr!.opcode >= -257) or operatorIr!.opcode == -220 or operatorIr!.opcode == -221 or operatorIr!.opcode == -304 or operatorIr!.opcode == -305 or operatorIr!.opcode == -271)) or operatorIr!.kind == 13 or operatorIr!.kind == 15 or operatorIr!.kind == 17 or operatorIr!.kind == 22 or operatorIr!.kind == 23 or operatorIr!.kind == 24 or operatorIr!.kind == 25 or operatorIr!.kind == 26 or operatorIr!.kind == 31 or operatorIr!.kind == 32 or operatorIr!.kind == 36
            -> if {
                -1 => firstOperand!
                -1 => secondOperand!
                UIntSize(0) => firstStart!
                UIntSize(0) => secondStart!
                false => operatorHasDirectQualifiedTarget!
                operatorIr!.kind == 6 -> if {
                    prepared.qualifiedFunctionByParentAst[sourceRange.astStart + operatorIr!.astNode] >= 0
                        -> if { true => operatorHasDirectQualifiedTarget! }
                }
                expressionIrStart => childIrIndex!
                childIrIndex! < expressionIrEnd -> while {
                    nodes[childIrIndex!] => childIr
                    operatorIr!.kind == 17 and childIr.kind == 6
