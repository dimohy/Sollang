                tapSourceNode.typeOrigin => tapIr!.typeOrigin
                tapSourceNode.typeModule => tapIr!.typeModule
                tapSourceNode.typeSymbol => tapIr!.typeSymbol
                tapSourceNode.typeId => tapIr!.typeId
