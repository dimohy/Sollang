                                -> if {
                                    nodes[bindingControlOwner!].parent => bindingControlOwner!
                                    true => bindingControlOwnerSearching!
                                }
                        }
                        (nodes[bindingControlSearch!].kind == 18
                            or nodes[bindingControlSearch!].kind == 27
                            or nodes[bindingControlSearch!].kind == 33
                            or nodes[bindingControlSearch!].kind == 34)
                            and bindingControlOwner! == bindingControlWrapper
                            -> if {
                                bindingControlSearch! => bindingWrapperResult!
                                true => bindingWrapperIsControl!
                            }
                        not bindingWrapperIsControl! and nodes[bindingControlSearch!].parent == bindingControlWrapper and nodes[bindingControlSearch!].kind != 17 and not (nodes[bindingControlSearch!].typeOrigin == 1 and nodes[bindingControlSearch!].typeSymbol == 0)
                            -> if {
                                prepared.package.nodes[sourceRange.astStart + nodes[bindingControlSearch!].astNode].length => bindingWrapperCandidateLength
                                bindingWrapperResult! < 0 or bindingWrapperCandidateLength > bindingWrapperResultLength!
                                    -> if {
                                        bindingControlSearch! => bindingWrapperResult!
                                        bindingWrapperCandidateLength => bindingWrapperResultLength!
                                    }
                            }
                        bindingControlSearch! + 1 => bindingControlSearch!
                    }
                    bindingWrapperResult! >= 0 -> if { bindingWrapperResult! => bindingControlResult!.operand0 }
                    bindingControlResult! => nodes[bindingControlResultIndex!]
                }
            bindingControlResultIndex! + 1 => bindingControlResultIndex!
        }

    # Member/index assignments consume the value produced by a
    # control expression, not its transparent syntax wrapper.
    # Preserve that dependency in Typed IR so scheduling cannot
    # emit the assignment before the control merge value exists.
    expressionIrStart => assignmentControlResultIndex!
    assignmentControlResultIndex! < expressionIrEnd
        -> while {
            nodes[assignmentControlResultIndex!] => assignmentControlResult!
            (assignmentControlResult!.kind == 24 or assignmentControlResult!.kind == 25)
                and assignmentControlResult!.operand0 >= expressionIrStart
                and assignmentControlResult!.operand0 < expressionIrEnd
                -> if {
                    expressionIrStart => assignmentFlowControlSearch!
                    assignmentFlowControlSearch! < expressionIrEnd
                        -> while {
                            nodes[assignmentFlowControlSearch!] => assignmentFlowControlCandidate
                            (assignmentFlowControlCandidate.kind == 27
                                or assignmentFlowControlCandidate.kind == 34)
                                and assignmentFlowControlCandidate.operand0 == assignmentControlResult!.operand0
                                -> if {
                                    assignmentFlowControlSearch! => assignmentControlResult!.operand0
                                }
                            assignmentFlowControlSearch! + 1 => assignmentFlowControlSearch!
                        }
                    assignmentControlResult! => nodes[assignmentControlResultIndex!]
                }
            (assignmentControlResult!.kind == 24 or assignmentControlResult!.kind == 25)
                and assignmentControlResult!.operand0 >= expressionIrStart
                and assignmentControlResult!.operand0 < expressionIrEnd
                and nodes[assignmentControlResult!.operand0].kind == 9
                and nodes[assignmentControlResult!.operand0].opcode == -1
                -> if {
                    assignmentControlResult!.operand0 => assignmentControlWrapper
                    expressionIrStart => assignmentControlSearch!
                    assignmentControlSearch! < expressionIrEnd -> while {
                        nodes[assignmentControlSearch!].parent == assignmentControlWrapper
                            and (nodes[assignmentControlSearch!].kind == 18
                            or nodes[assignmentControlSearch!].kind == 27
                            or nodes[assignmentControlSearch!].kind == 33
                            or nodes[assignmentControlSearch!].kind == 34)
                            -> if {
                                assignmentControlSearch! => assignmentControlResult!.operand0
                            }
                        assignmentControlSearch! + 1 => assignmentControlSearch!
                    }
                    assignmentControlResult! => nodes[assignmentControlResultIndex!]
                }
            assignmentControlResultIndex! + 1 => assignmentControlResultIndex!
        }

    expressionIrStart => bindingNameIrIndex!
    # A result-producing role owns both the call and its result
    # binding on the same AST node. Equal-AST siblings are not
    # connected by the ordinary child-operand pass.
    expressionIrStart => roleBindingIndex!
    roleBindingIndex! < expressionIrEnd -> while {
        nodes[roleBindingIndex!] => roleBinding!
        roleBinding!.kind == 17 and roleBinding!.operand0 < 0 and prepared.package.nodes[sourceRange.astStart + roleBinding!.astNode].kind == 48
            -> if {
                expressionIrStart => roleCallSearch!
                roleCallSearch! < expressionIrEnd -> while {
                    nodes[roleCallSearch!].kind == 6 and nodes[roleCallSearch!].astNode == roleBinding!.astNode and (nodes[roleCallSearch!].opcode == -207 or nodes[roleCallSearch!].opcode == -208 or nodes[roleCallSearch!].opcode == -209)
                        -> if { roleCallSearch! => roleBinding!.operand0 }
                    roleCallSearch! + 1 => roleCallSearch!
                }
                roleBinding! => nodes[roleBindingIndex!]
            }
        roleBindingIndex! + 1 => roleBindingIndex!
    }

    expressionIrStart => bindingNameIrIndex!
    bindingNameIrIndex! < expressionIrEnd -> while {
        nodes[bindingNameIrIndex!] => bindingName!
        bindingName!.kind == 5 -> if {
            expressionIrStart => bindingDefinitionSearch!
            bindingDefinitionSearch! < expressionIrEnd -> while {
                (nodes[bindingDefinitionSearch!].kind == 17 or nodes[bindingDefinitionSearch!].kind == 29) and nodes[bindingDefinitionSearch!].symbol == bindingName!.symbol and nodes[bindingDefinitionSearch!].astNode >= 0 and bindingName!.astNode >= 0 and prepared.package.nodes[sourceRange.astStart + nodes[bindingDefinitionSearch!].astNode].start <= prepared.package.nodes[sourceRange.astStart + bindingName!.astNode].start and bindingDefinitionSearch! != bindingName!.parent and nodes[bindingDefinitionSearch!].operand0 != bindingNameIrIndex!
                    -> if {
                        bindingDefinitionSearch! => bindingName!.operand0
                    }
                bindingDefinitionSearch! + 1 => bindingDefinitionSearch!
            }
            bindingName! => nodes[bindingNameIrIndex!]
        }
        bindingNameIrIndex! + 1 => bindingNameIrIndex!
    }

    expressionIrStart => memberAssignmentIrIndex!
    memberAssignmentIrIndex! < expressionIrEnd -> while {
        nodes[memberAssignmentIrIndex!] => memberAssignment!
        memberAssignment!.kind == 25 -> if {
            prepared.package.nodes[sourceRange.astStart + memberAssignment!.astNode] => memberAssignmentAst
            prepared.package.tokens[sourceRange.tokenStart + memberAssignmentAst.payloadToken] => memberOwnerName
            -1 => memberOwnerBinding!
            UIntSize(0) => memberOwnerStart!
            functionIr + 2 => memberOwnerSearch!
            memberOwnerSearch! < memberAssignmentIrIndex!
                -> while {
                    nodes[memberOwnerSearch!] => memberOwnerCandidate
                    ((memberOwnerCandidate.kind == 17 and memberOwnerCandidate.flags == 1)
                        or (memberOwnerCandidate.kind == 10 and memberOwnerCandidate.flags / 2 % 2 == 1))
                        and memberOwnerCandidate.payloadToken >= 0 -> if {
                            prepared.package.tokens[sourceRange.tokenStart + memberOwnerCandidate.payloadToken] => memberCandidateName
                            memberOwnerName.span.length == memberCandidateName.span.length => memberOwnerEqual!
                            UIntSize(0) => memberOwnerByte!
                            memberOwnerEqual! and memberOwnerByte! < memberOwnerName.span.length
                                -> while {
                                    (source -> byte(memberOwnerName.span.start + memberOwnerByte!)) != (source -> byte(memberCandidateName.span.start + memberOwnerByte!))
                                        -> if { false => memberOwnerEqual! }
                                    memberOwnerByte! + 1 => memberOwnerByte!
                                }
                            memberOwnerEqual!
                                and (memberOwnerSearch! -> mutableAssignmentBindingVisible(memberAssignmentIrIndex!, nodes, prepared))
                                -> if {
                                    prepared.package.nodes[sourceRange.astStart + memberOwnerCandidate.astNode].start => memberCandidateStart
                                    memberOwnerBinding! < 0 or memberCandidateStart > memberOwnerStart!
                                        -> if {
                                            memberOwnerSearch! => memberOwnerBinding!
                                            memberCandidateStart => memberOwnerStart!
                                        }
                                }
                        }
                    memberOwnerSearch! + 1 => memberOwnerSearch!
                }
            memberOwnerBinding! >= 0 -> if {
                memberOwnerBinding! => memberAssignment!.operand1
                nodes[memberOwnerBinding!].symbol => memberAssignment!.symbol
                memberAssignment! => nodes[memberAssignmentIrIndex!]
            }
        }
        memberAssignmentIrIndex! + 1 => memberAssignmentIrIndex!
    }

    # A binding's initializer is the authoritative canonical
    # type. The legacy nearest-descendant heuristic can select
    # a loop index type from inside the binding's later use.
    expressionIrStart => canonicalBindingIr!
    canonicalBindingIr! < expressionIrEnd -> while {
        nodes[canonicalBindingIr!] => canonicalBinding!
        canonicalBinding!.kind == 17 and canonicalBinding!.operand0 >= expressionIrStart
            -> if {
                canonicalBinding!.operand0 => canonicalBindingValueIndex!
                # Nested owner types such as `Deque<box T>` lower the
                # inner box type as a transparent -27 wrapper around
                # the real collection constructor. Do not confuse that
                # type wrapper with a runtime `box value` initializer.
                nodes[canonicalBindingValueIndex!].kind == 9
                    and nodes[canonicalBindingValueIndex!].opcode == -27
                    and nodes[canonicalBindingValueIndex!].operand0 >= expressionIrStart
                    and nodes[nodes[canonicalBindingValueIndex!].operand0].kind == 6
                    and ((nodes[nodes[canonicalBindingValueIndex!].operand0].typeKind == 7
                    and nodes[nodes[canonicalBindingValueIndex!].operand0].typeOrigin == 4
                    and nodes[nodes[canonicalBindingValueIndex!].operand0].typeSymbol >= 5
                    and nodes[nodes[canonicalBindingValueIndex!].operand0].typeSymbol <= 7)
                    or (nodes[nodes[canonicalBindingValueIndex!].operand0].typeKind == 14
                    and nodes[nodes[canonicalBindingValueIndex!].operand0].typeOrigin == 4
                    and nodes[nodes[canonicalBindingValueIndex!].operand0].typeSymbol == 8))
                    -> if {
                        nodes[canonicalBindingValueIndex!].operand0 => canonicalBindingValueIndex!
                        canonicalBindingValueIndex! => canonicalBinding!.operand0
                    }
                nodes[canonicalBindingValueIndex!].kind == 9 and nodes[canonicalBindingValueIndex!].opcode == -1
                    -> if {
                        -1 => canonicalWrapperValue!
                        UIntSize(0) => canonicalWrapperLength!
                        expressionIrStart => canonicalWrapperSearch!
                        canonicalWrapperSearch! < expressionIrEnd -> while {
                            nodes[canonicalWrapperSearch!] => canonicalWrapperCandidate
                            canonicalWrapperCandidate.parent == canonicalBindingValueIndex! and canonicalWrapperCandidate.kind != 17 and not (canonicalWrapperCandidate.typeOrigin == 1 and canonicalWrapperCandidate.typeSymbol == 0)
                                -> if {
                                    prepared.package.nodes[sourceRange.astStart + canonicalWrapperCandidate.astNode].length => canonicalWrapperCandidateLength
                                    false => canonicalWrapperHasReadInt!
                                    canonicalWrapperValue! >= 0 -> if {
                                        nodes[canonicalWrapperValue!].kind == 6 and nodes[canonicalWrapperValue!].symbol == -103
                                            -> if { true => canonicalWrapperHasReadInt! }
                                    }
                                    (canonicalWrapperCandidate.kind == 6 and canonicalWrapperCandidate.symbol == -103) or (not canonicalWrapperHasReadInt! and (canonicalWrapperValue! < 0 or canonicalWrapperCandidateLength > canonicalWrapperLength!))
                                        -> if {
                                            canonicalWrapperSearch! => canonicalWrapperValue!
                                            canonicalWrapperCandidateLength => canonicalWrapperLength!
                                        }
                                }
                            canonicalWrapperSearch! + 1 => canonicalWrapperSearch!
                        }
                        canonicalWrapperValue! >= 0 -> if {
                            canonicalWrapperValue! => canonicalBindingValueIndex!
                            canonicalWrapperValue! => canonicalBinding!.operand0
                        }
                    }
                nodes[canonicalBindingValueIndex!] => canonicalBindingValue
                canonicalBindingValue.typeOrigin >= 0
                    and (canonicalBinding! -> mayRefreshValueAlias(canonicalBindingValue))
                    -> if {
                        canonicalBindingValue.typeOrigin => canonicalBinding!.typeOrigin
                        canonicalBindingValue.typeModule => canonicalBinding!.typeModule
                        canonicalBindingValue.typeSymbol => canonicalBinding!.typeSymbol
                        canonicalBindingValue.typeId => canonicalBinding!.typeId
                        canonicalBindingValue.typeKind => canonicalBinding!.typeKind
                        canonicalBindingValue.typeFlags => canonicalBinding!.typeFlags
                        canonicalBinding!.typeId < 0 -> if {
                            0 => canonicalInitializerTypeSearch!
                            canonicalInitializerTypeSearch! < (frozenRecursiveSemanticTypes -> len)
                                -> while {
                                    frozenRecursiveSemanticTypes[canonicalInitializerTypeSearch!] => canonicalInitializerType
                                    canonicalInitializerType.status == 0 and canonicalInitializerType.origin == canonicalBinding!.typeOrigin and canonicalInitializerType.module == canonicalBinding!.typeModule and canonicalInitializerType.symbol == canonicalBinding!.typeSymbol
                                        -> if {
                                            canonicalInitializerTypeSearch! => canonicalBinding!.typeId
                                            canonicalInitializerType.kind => canonicalBinding!.typeKind
                                            recursiveTypeFlags[canonicalInitializerTypeSearch!] => canonicalBinding!.typeFlags
                                        }
                                    canonicalInitializerTypeSearch! + 1 => canonicalInitializerTypeSearch!
                                }
                        }
                    }
                canonicalBinding! => nodes[canonicalBindingIr!]
            }
        canonicalBindingIr! + 1 => canonicalBindingIr!
    }
    expressionIrStart => canonicalBindingReadIr!
    canonicalBindingReadIr! < expressionIrEnd -> while {
        nodes[canonicalBindingReadIr!] => canonicalBindingRead!
        # Bindings are allocated before expressionIrStart. A read can
        # therefore point to a valid local binding outside the
        # expression slice; its initializer-derived type remains
        # authoritative over a stale nearest-expression inference.
        canonicalBindingRead!.kind == 5
            and canonicalBindingRead!.operand0 >= 0
            and nodes[canonicalBindingRead!.operand0].kind == 17
            and nodes[canonicalBindingRead!.operand0].typeOrigin >= 0
            -> if {
                nodes[canonicalBindingRead!.operand0] => canonicalReadBinding
                canonicalReadBinding.typeOrigin => canonicalBindingRead!.typeOrigin
                canonicalReadBinding.typeModule => canonicalBindingRead!.typeModule
                canonicalReadBinding.typeSymbol => canonicalBindingRead!.typeSymbol
                canonicalReadBinding.typeId => canonicalBindingRead!.typeId
                canonicalReadBinding.typeKind => canonicalBindingRead!.typeKind
                canonicalReadBinding.typeFlags => canonicalBindingRead!.typeFlags
                canonicalBindingRead! => nodes[canonicalBindingReadIr!]
            }
        canonicalBindingReadIr! + 1 => canonicalBindingReadIr!
    }

    expressionIrStart => aggregateIrIndex!
    aggregateIrIndex! < expressionIrEnd -> while {
        nodes[aggregateIrIndex!] => aggregate!
        aggregate!.kind == 12 or aggregate!.kind == 14 or aggregate!.kind == 16 or aggregate!.kind == 35
            -> if {
                -1 => firstFieldOperand!
                expressionIrStart => fieldOperandSearch!
                fieldOperandSearch! < expressionIrEnd -> while {
                    nodes[fieldOperandSearch!].parent == aggregateIrIndex!
                        -> if {
                            firstFieldOperand! < 0 or prepared.package.nodes[sourceRange.astStart + nodes[fieldOperandSearch!].astNode].start < prepared.package.nodes[sourceRange.astStart + nodes[firstFieldOperand!].astNode].start
                                -> if { fieldOperandSearch! => firstFieldOperand! }
                        }
                    fieldOperandSearch! + 1 => fieldOperandSearch!
                }
                firstFieldOperand! => aggregate!.operand0
                aggregate! => nodes[aggregateIrIndex!]
            }
        aggregateIrIndex! + 1 => aggregateIrIndex!
    }

}

finalizeOrdinaryReturn nodes: mut [TypedIrNode; ~], astToIr: mut [Int; ~], resolvedNames: ref [resolution.ResolvedName; ~], prepared: ref semanticContext.SemanticSnapshot, frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], recursiveTypeFlags: ref [Int; ~], sourceIndex: Int, functionSymbolIndex: Int, functionIr: Int, expressionIrStart: Int, resultRootAst: Int, returnIr: Int, functionResultOrigin: Int, functionResultModule: Int, functionResultSymbol: Int, functionResultTypeId: Int -> Unit {
    prepared.package.ranges[sourceIndex] => sourceRange
    prepared.package.sources[sourceIndex] -> len => sourceLength
    prepared.package.sources[sourceIndex] -> slice(UIntSize(0), sourceLength) => source
    prepared.package.symbols[sourceRange.symbolStart + functionSymbolIndex] => function
    nodes -> len => expressionIrEnd
    nodes[returnIr] => returnNode!
    astToIr[resultRootAst] => returnOperandIr!
    returnOperandIr! < 0 -> if {
        1000000 => returnOperandDistance!
        expressionIrStart => returnOperandSearch!
        returnOperandSearch! < expressionIrEnd -> while {
            prepared.package.nodes[sourceRange.astStart + nodes[returnOperandSearch!].astNode].parent => returnOperandAncestor!
            1 => returnCandidateDistance!
            false => returnCandidateBelongs!
            returnOperandAncestor! >= 0 and not returnCandidateBelongs!
                -> while {
                    returnOperandAncestor! == resultRootAst -> if { true => returnCandidateBelongs! } else {
                        prepared.package.nodes[sourceRange.astStart + returnOperandAncestor!].parent => returnOperandAncestor!
                        returnCandidateDistance! + 1 => returnCandidateDistance!
                    }
                }
            returnCandidateBelongs! and returnCandidateDistance! < returnOperandDistance!
                -> if {
                    returnOperandSearch! => returnOperandIr!
                    returnCandidateDistance! => returnOperandDistance!
                }
            returnOperandSearch! + 1 => returnOperandSearch!
        }
    }
    returnOperandIr! >= 0 and nodes[returnOperandIr!].kind == 9 and nodes[returnOperandIr!].opcode == -1
        -> if {
            returnOperandIr! => returnWrapperIr
            -1 => returnWrapperResult!
            expressionIrStart => returnControlSearch!
            returnControlSearch! < expressionIrEnd -> while {
                nodes[returnControlSearch!] => returnWrapperCandidate
                returnWrapperCandidate.parent == returnWrapperIr
                    and ((functionResultTypeId >= 0 and returnWrapperCandidate.typeId == functionResultTypeId)
                    or (functionResultTypeId < 0
                    and returnWrapperCandidate.typeOrigin == functionResultOrigin
                    and returnWrapperCandidate.typeModule == functionResultModule
                    and returnWrapperCandidate.typeSymbol == functionResultSymbol))
                    -> if { returnControlSearch! => returnWrapperResult! }
                returnControlSearch! + 1 => returnControlSearch!
            }
            returnWrapperResult! >= 0 -> if { returnWrapperResult! => returnOperandIr! }
        }
    false => returnOperandMatches!
    returnOperandIr! >= 0 -> if {
        nodes[returnOperandIr!] => selectedReturnOperand
        not (selectedReturnOperand.kind == 9 and selectedReturnOperand.opcode == -1 and selectedReturnOperand.operand0 < 0)
            and ((functionResultTypeId >= 0 and selectedReturnOperand.typeId == functionResultTypeId)
            or (functionResultTypeId < 0
            and selectedReturnOperand.typeOrigin == functionResultOrigin
            and selectedReturnOperand.typeModule == functionResultModule
            and selectedReturnOperand.typeSymbol == functionResultSymbol))
            -> if { true => returnOperandMatches! }
    }
    not returnOperandMatches! -> if {
        -1 => matchingReturnOperand!
        UIntSize(0) => matchingReturnStart!
        UIntSize(0) => matchingReturnLength!
        expressionIrStart => matchingReturnSearch!
        matchingReturnSearch! < expressionIrEnd -> while {
            nodes[matchingReturnSearch!] => matchingReturnCandidate
            false => matchingReturnBelongs!
            matchingReturnCandidate.astNode >= 0 -> if {
                matchingReturnCandidate.astNode => matchingReturnAncestor!
                matchingReturnAncestor! >= 0 and not matchingReturnBelongs!
                    -> while {
                        matchingReturnAncestor! == resultRootAst
                            -> if { true => matchingReturnBelongs! } else {
                                prepared.package.nodes[sourceRange.astStart + matchingReturnAncestor!].parent
                                    => matchingReturnAncestor!
                            }
                    }
            }
            false => matchingReturnTerminalFlow!
            grammar.ruleIdValueFlowExpression() => valueFlowRule
            -1 => matchingReturnCandidateRule!
            matchingReturnCandidate.astNode >= 0 -> if {
                prepared.package.nodes[sourceRange.astStart + matchingReturnCandidate.astNode].cstRuleId
                    => matchingReturnCandidateRule!
            }
            matchingReturnBelongs!
                and matchingReturnCandidate.kind == 26
                and matchingReturnCandidateRule! == valueFlowRule
                -> if { true => matchingReturnTerminalFlow! }
            matchingReturnBelongs!
                and not matchingReturnTerminalFlow!
                and matchingReturnCandidate.parent >= expressionIrStart
                and matchingReturnCandidate.parent < expressionIrEnd
                -> if {
                    nodes[matchingReturnCandidate.parent] => matchingReturnFlow
                    -1 => matchingReturnFlowRule!
                    matchingReturnFlow.astNode >= 0 -> if {
                        prepared.package.nodes[sourceRange.astStart + matchingReturnFlow.astNode].cstRuleId
                            => matchingReturnFlowRule!
                    }
                    matchingReturnFlow.kind == 6
                        and matchingReturnFlowRule! == valueFlowRule
                        -> if { true => matchingReturnTerminalFlow! }
                }
            (matchingReturnCandidate.parent == returnIr or matchingReturnTerminalFlow!)
                and matchingReturnCandidate.kind != 17
                and not (matchingReturnCandidate.kind == 9 and matchingReturnCandidate.opcode == -1 and matchingReturnCandidate.operand0 < 0)
                and ((functionResultTypeId >= 0 and matchingReturnCandidate.typeId == functionResultTypeId)
                or (functionResultTypeId < 0
                and matchingReturnCandidate.typeOrigin == functionResultOrigin
                and matchingReturnCandidate.typeModule == functionResultModule
                and matchingReturnCandidate.typeSymbol == functionResultSymbol))
                -> if {
                    prepared.package.nodes[sourceRange.astStart + matchingReturnCandidate.astNode] => matchingReturnAst
                    matchingReturnOperand! < 0 or matchingReturnAst.start > matchingReturnStart! or (matchingReturnAst.start == matchingReturnStart! and matchingReturnAst.length > matchingReturnLength!)
                        -> if {
                            matchingReturnSearch! => matchingReturnOperand!
                            matchingReturnAst.start => matchingReturnStart!
                            matchingReturnAst.length => matchingReturnLength!
                        }
                }
            matchingReturnSearch! + 1 => matchingReturnSearch!
        }
        matchingReturnOperand! < 0 -> if {
            expressionIrStart => rootReturnSearch!
            rootReturnSearch! < expressionIrEnd -> while {
                nodes[rootReturnSearch!] => rootReturnCandidate
                rootReturnCandidate.parent == returnIr
                    and rootReturnCandidate.kind != 17
                    and not (rootReturnCandidate.kind == 9 and rootReturnCandidate.opcode == -1 and rootReturnCandidate.operand0 < 0)
                    -> if {
                        prepared.package.nodes[sourceRange.astStart + rootReturnCandidate.astNode] => rootReturnAst
                        matchingReturnOperand! < 0 or rootReturnAst.start > matchingReturnStart! or (rootReturnAst.start == matchingReturnStart! and rootReturnAst.length > matchingReturnLength!)
                            -> if {
                                rootReturnSearch! => matchingReturnOperand!
                                rootReturnAst.start => matchingReturnStart!
                                rootReturnAst.length => matchingReturnLength!
                            }
                    }
                rootReturnSearch! + 1 => rootReturnSearch!
            }
        }
        matchingReturnOperand! >= 0 -> if { matchingReturnOperand! => returnOperandIr! }
    }
    # A mutable binding declaration is storage, not an SSA return
    # value. The final bare `value!` expression lowers to a direct
    # name read whose operand0 points at that storage root. Resolve
    # this after type-based fallback selection, which can otherwise
    # prefer the declaration because its canonical type is newer.
    returnOperandIr! >= 0 and nodes[returnOperandIr!].kind == 17 and nodes[returnOperandIr!].flags == 1
        -> if {
            nodes[returnOperandIr!] => mutableReturnBinding
            -1 => mutableReturnRead!
            UIntSize(0) => mutableReturnReadStart!
            expressionIrStart => mutableReturnSearch!
            mutableReturnSearch! < (nodes -> len) -> while {
                nodes[mutableReturnSearch!] => mutableReturnCandidate
                mutableReturnCandidate.kind == 5
                    and mutableReturnCandidate.parent == returnIr
                    and mutableReturnCandidate.symbol == mutableReturnBinding.symbol
                    and mutableReturnCandidate.astNode >= 0 -> if {
                        prepared.package.nodes[sourceRange.astStart + mutableReturnCandidate.astNode] => mutableReturnAst
                        mutableReturnRead! < 0 or mutableReturnAst.start >= mutableReturnReadStart!
                            -> if {
                                mutableReturnSearch! => mutableReturnRead!
                                mutableReturnAst.start => mutableReturnReadStart!
                            }
                    }
                mutableReturnSearch! + 1 => mutableReturnSearch!
            }
            mutableReturnRead! >= 0 -> if {
                mutableReturnRead! => returnOperandIr!
            }
        }
    # An implicit function result can initially map to the last leaf inside a
    # value-producing control. That branch-local SSA value does not dominate
    # the common function return. Promote it through exact same-type control
    # ancestors and retain the outermost merged value instead.
    -1 => mergedReturnControl!
    returnOperandIr! >= 0 -> if {
        nodes[returnOperandIr!].parent => returnControlAncestor!
        returnControlAncestor! >= expressionIrStart
            and returnControlAncestor! < expressionIrEnd
            -> while {
                nodes[returnControlAncestor!] => returnControlCandidate
                false => returnControlTypeMatches!
                functionResultTypeId >= 0
                    and returnControlCandidate.typeId == functionResultTypeId
                    -> if { true => returnControlTypeMatches! }
                functionResultTypeId < 0
                    and returnControlCandidate.typeId < 0
                    and returnControlCandidate.typeOrigin == functionResultOrigin
                    and returnControlCandidate.typeModule == functionResultModule
                    and returnControlCandidate.typeSymbol == functionResultSymbol
                    -> if { true => returnControlTypeMatches! }
                (returnControlCandidate.kind == 18
                    or returnControlCandidate.kind == 20
                    or returnControlCandidate.kind == 27
                    or returnControlCandidate.kind == 33
                    or returnControlCandidate.kind == 34)
                    and returnControlTypeMatches!
                    -> if { returnControlAncestor! => mergedReturnControl! }
                returnControlCandidate.parent => returnControlAncestor!
            }
    }
    mergedReturnControl! >= 0 -> if { mergedReturnControl! => returnOperandIr! }
    returnOperandIr! => returnNode!.operand0
    returnNode! => nodes[returnIr]

}
