# Ordered ordinary-function finalization phases. The explicit mutable node
# boundary preserves one authoritative IR while each static phase remains an
# independent compiler work unit with no aggregate copy or dynamic dispatch.

bindTapStageInput callIndex: Int, inputIndex: Int, nodes: mut [TypedIrNode; ~] -> Unit {
    nodes[callIndex] => call!
    nodes[inputIndex] => input!
    call!.operand0 => input!.nextOperand
    inputIndex => call!.operand0
    input! => nodes[inputIndex]
    call! => nodes[callIndex]
}

finalizeOrdinaryStructure nodes: mut [TypedIrNode; ~], astToIr: mut [Int; ~], resolvedNames: ref [resolution.ResolvedName; ~], prepared: ref semanticContext.SemanticSnapshot, frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], recursiveTypeFlags: ref [Int; ~], sourceIndex: Int, functionSymbolIndex: Int, functionIr: Int, expressionIrStart: Int, resultRootAst: Int, returnIr: Int, functionResultOrigin: Int, functionResultModule: Int, functionResultSymbol: Int, functionResultTypeId: Int -> Unit {
