finalizeOrdinaryBindings nodes: mut [TypedIrNode; ~], astToIr: mut [Int; ~], resolvedNames: ref [resolution.ResolvedName; ~], prepared: ref semanticContext.SemanticSnapshot, frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], recursiveTypeFlags: ref [Int; ~], sourceIndex: Int, functionSymbolIndex: Int, functionIr: Int, expressionIrStart: Int, resultRootAst: Int, returnIr: Int, functionResultOrigin: Int, functionResultModule: Int, functionResultSymbol: Int, functionResultTypeId: Int -> Unit {
