                firstOperand! => operatorIr!.operand0
                operatorIr!.kind == 7 and operatorIr!.opcode != -26 and firstOperand! >= 0
                    -> if {
                        nodes[firstOperand!] => unaryOperand
                        unaryOperand.typeOrigin => operatorIr!.typeOrigin
                        unaryOperand.typeModule => operatorIr!.typeModule
                        unaryOperand.typeSymbol => operatorIr!.typeSymbol
                        unaryOperand.typeId => operatorIr!.typeId
                        unaryOperand.typeKind => operatorIr!.typeKind
                        unaryOperand.typeFlags => operatorIr!.typeFlags
                    }
                operatorIr!.kind == 6 or operatorIr!.kind == 8 or (operatorIr!.kind == 9 and ((operatorIr!.opcode <= -201 and (operatorIr!.opcode >= -206 or operatorIr!.opcode == -213 or (operatorIr!.opcode == -223 or operatorIr!.opcode == -303) or operatorIr!.opcode == -224 or operatorIr!.opcode == -225 or operatorIr!.opcode == -226 or operatorIr!.opcode == -227 or operatorIr!.opcode == -229)) or (operatorIr!.opcode <= -241 and operatorIr!.opcode >= -243) or (operatorIr!.opcode <= -246 and operatorIr!.opcode >= -247) or operatorIr!.opcode == -252 or (operatorIr!.opcode <= -255 and operatorIr!.opcode >= -257) or operatorIr!.opcode == -220 or operatorIr!.opcode == -221 or operatorIr!.opcode == -304 or operatorIr!.opcode == -305 or operatorIr!.opcode == -271)) or operatorIr!.kind == 15 or operatorIr!.kind == 24 or operatorIr!.kind == 31 or operatorIr!.kind == 32 or operatorIr!.kind == 36
