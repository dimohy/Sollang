                                    26 => expressionKind!
                                    enumConstructor.enumTypeId => recursiveExpressionTypeId!
                                    frozenRecursiveSemanticTypes[enumConstructor.enumTypeId] => enumConstructorType
                                    enumConstructorType.origin => expressionTypeOrigin!
                                    enumConstructorType.module => expressionTypeModule!
                                    enumConstructorType.symbol => expressionTypeSymbol!
                                    enumConstructorType.kind == 7 -> if {
                                        17 => expressionTypeOrigin!
                                        enumConstructorType.first >= 0 -> if {
