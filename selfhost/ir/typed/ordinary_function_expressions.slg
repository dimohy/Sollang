                                }
                                expressionKind! == 14 and expressionTypeKind! == 12
                                    -> if {
                                        frozenRecursiveSemanticTypes[recursiveExpressionTypeId!].length => expressionOpcode!
                                    }
                                expressionKind! == 16 and expressionTypeKind! == 13
                                    -> if {
                                        frozenRecursiveSemanticTypes[recursiveExpressionTypeId!].length => expressionOpcode!
                                    }
