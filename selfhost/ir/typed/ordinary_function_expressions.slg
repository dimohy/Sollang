                                    expression.payloadToken >= 0 -> if {
                                        prepared.package.tokens[sourceRange.tokenStart + expression.payloadToken] => streamSliceToken
                                        IntrinsicNameRequest { source: source, token: streamSliceToken } -> streamSliceOpcode => expressionStreamSliceOpcode
                                        expressionStreamSliceOpcode != -1
                                            -> if { expressionStreamSliceOpcode => expressionOpcode! }
                                    }
