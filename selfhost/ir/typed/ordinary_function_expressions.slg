                                            patternBindingSymbol.kind == 35 and patternBindingSymbol.astNode == expressionAstIndex
                                                -> if { patternBindingSymbolSearch! => expressionSymbol! }
                                            patternBindingSymbolSearch! + 1 => patternBindingSymbolSearch!
