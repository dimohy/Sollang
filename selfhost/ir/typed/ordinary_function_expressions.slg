                                        directQualifiedCallIndex >= 0
                                            and expressionSymbol! == -1
                                            and ((expression.kind -> isFlowIntrinsicAstKind))
                                            -> if {
                                                prepared.qualified[directQualifiedCallIndex] => directQualifiedCall
                                                prepared.modules[directQualifiedCall.targetModule].sourceIndex => directQualifiedCallSource
                                                prepared.package.ranges[directQualifiedCallSource] => directQualifiedCallRange
                                                prepared.package.symbols[directQualifiedCallRange.symbolStart + directQualifiedCall.targetSymbol] => directQualifiedCallSymbol
                                                directQualifiedCallSymbol.kind == 7 -> if {
                                                    directQualifiedCall.targetSymbol => expressionSymbol!
                                                    directQualifiedCallSource => expressionTargetModule!
                                                    directQualifiedCallSource -> functionResultTypeId(directQualifiedCall.targetSymbol, prepared, recursiveTypes, frozenRecursiveSemanticTypes) => directQualifiedCallResultTypeId
                                                    directQualifiedCallResultTypeId >= 0 -> if {
