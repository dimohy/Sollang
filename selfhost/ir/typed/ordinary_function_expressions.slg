                                false => targetlessBuiltinTypeApplication!
                                -1 => builtinTypeApplicationSymbol!
                                expression.payloadToken >= 0 -> if {
                                    prepared.package.tokens[sourceRange.tokenStart + expression.payloadToken] => builtinTypeApplicationName
                                    source -> expressionTypes.builtinTypeApplicationSymbol(builtinTypeApplicationName) => builtinTypeApplicationSymbol!
                                }
                                expressionTypeIndex >= 0 -> if {
                                    inferred[expressionTypeIndex] -> isTargetlessBuiltinTypeApplication(builtinTypeApplicationSymbol!) => targetlessBuiltinTypeApplication!
                                }
                                prepared.callIndexByAst[sourceRange.astStart + expressionAstIndex] => resolvedCallIndex
                                resolvedCallIndex >= 0 and expression.kind == 10
                                    -> if {
                                        prepared.calls[resolvedCallIndex] => directResolvedFlowCall
                                        directResolvedFlowCall.sourceModule == sourceIndex
                                            and directResolvedFlowCall.callAst == expressionAstIndex
                                            and directResolvedFlowCall.status == 0
                                            -> if { false => targetlessBuiltinTypeApplication! }
                                    }
                                prepared.qualifiedFunctionByParentAst[sourceRange.astStart + expressionAstIndex] => directQualifiedCallIndex
                                directQualifiedCallIndex >= 0
                                    and expression.kind == 10
                                    -> if { false => targetlessBuiltinTypeApplication! }
                                expressionKind! == 6 and not targetlessBuiltinTypeApplication!
                                    -> if {
                                        resolvedCallIndex >= 0 -> if {
                                            prepared.calls[resolvedCallIndex] => resolvedCall
                                            resolvedCall.sourceModule == sourceIndex and resolvedCall.callAst == expressionAstIndex and resolvedCall.status == 0
                                                -> if {
                                                    resolvedCall.functionSymbol => expressionSymbol!
                                                    resolvedCall.targetSourceModule => expressionTargetModule!
                                                    resolvedCall.functionSymbol >= 0 and resolvedCall.targetSourceModule >= 0
                                                        -> if {
                                                            prepared.package.ranges[resolvedCall.targetSourceModule] => expressionTargetRange
                                                            prepared.package.symbols[expressionTargetRange.symbolStart + resolvedCall.functionSymbol] => expressionTargetFunction
                                                            (expressionTargetFunction.flags / 8) % 2 == 1 and (expressionFlags! / 8) % 2 == 0
                                                                -> if {
                                                                    expressionFlags! + 8 => expressionFlags!
                                                                }
                                                        } else {
                                                            resolvedCall.functionSymbol -> builtinRuntimeCallResultTypeSymbol => builtinResolvedCallTypeSymbol
                                                            builtinResolvedCallTypeSymbol >= 0 -> if {
                                                                1 => expressionTypeOrigin!
                                                                -1 => expressionTypeModule!
                                                                builtinResolvedCallTypeSymbol => expressionTypeSymbol!
                                                            }
