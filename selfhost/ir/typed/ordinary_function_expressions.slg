# A nominal variant call returns its declaring enum and owns one payload.
# A negative tag leaves ordinary function and unresolved-call lowering intact.
nominalEnumConstructorTag prepared: ref semanticContext.SemanticSnapshot, sourceIndex: Int, callAst: Int, canonicalTypesByAst: ref [Int; ~], canonicalTypes: ref [typeIds.SemanticType; ~] -> Int {
    -1 => tag!
    sourceIndex >= 0 and sourceIndex < (prepared.package.ranges -> len)
        -> if {
            prepared.package.ranges[sourceIndex] => range
            callAst >= 0 and callAst < range.astCount -> if {
                prepared.package.nodes[range.astStart + callAst].kind == 11
                    -> if {
                        prepared.callIndexByAst[range.astStart + callAst] => callIndex
                        callIndex >= 0 and callIndex < (prepared.calls -> len)
                            -> if {
                                prepared.calls[callIndex] => call
                                call.status == 0 and call.sourceModule == sourceIndex and call.callAst == callAst
                                    and call.targetSourceModule >= 0 and call.targetSourceModule < (prepared.package.ranges -> len)
                                    -> if {
                                        prepared.package.ranges[call.targetSourceModule] => targetRange
                                        call.functionSymbol >= 0 and call.functionSymbol < targetRange.symbolCount
                                            -> if {
                                                prepared.package.symbols[targetRange.symbolStart + call.functionSymbol] => target
                                                canonicalTypesByAst[range.astStart + callAst] => resultTypeId
                                                target.kind == 27 and target.parent >= 0 and target.parent < targetRange.symbolCount
                                                    and prepared.package.symbols[targetRange.symbolStart + target.parent].kind == 4
                                                    and resultTypeId >= 0 and resultTypeId < (canonicalTypes -> len)
                                                    -> if {
                                                        canonicalTypes[resultTypeId] => resultType
                                                        (resultType.kind == 1 or resultType.kind == 7)
                                                            and resultType.module == call.targetSourceModule and resultType.symbol == target.parent
                                                            -> if {
                                                                0 => tag!
                                                                0 => variantIndex!
                                                                variantIndex! < call.functionSymbol -> while {
                                                                    prepared.package.symbols[targetRange.symbolStart + variantIndex!] => variant
                                                                    variant.kind == 27 and variant.parent == target.parent
                                                                        -> if { tag! + 1 => tag! }
                                                                    variantIndex! + 1 => variantIndex!
                                                                }
                                                            }
                                                    }
                                            }
                                    }
                            }
                    }
            }
        }
    tag!
}

# Entry and ordinary lowering share the exact static enum wrapper ownership.
# The frozen type index contains only successful semantic expression facts.
staticEnumConstructorOwnsWrapper prepared: ref semanticContext.SemanticSnapshot, sourceIndex: Int, wrapperAst: Int, childAst: Int, canonicalTypesByAst: ref [Int; ~], canonicalTypes: ref [typeIds.SemanticType; ~], externalCalls: ref [expressionTypeIds.ExpressionTypeId; ~] -> Bool {
    false => ownsWrapper!
    sourceIndex >= 0 and sourceIndex < (prepared.package.ranges -> len)
        -> if {
            prepared.package.ranges[sourceIndex] => range
            wrapperAst >= 0 and wrapperAst < range.astCount
                and childAst >= 0 and childAst < range.astCount
                -> if {
                    prepared.package.nodes[range.astStart + wrapperAst] => wrapper
                    prepared.package.nodes[range.astStart + childAst] => child
                    canonicalTypesByAst[range.astStart + wrapperAst] => wrapperTypeId
                    child.parent == wrapperAst => constructorOwnsQualifier!
                    child.kind == 11 and child.start == wrapper.start and child.length == wrapper.length
                        -> if {
                            child.parent => qualifierAst!
                            not constructorOwnsQualifier! and qualifierAst! >= 0 and qualifierAst! < range.astCount
                                -> while {
                                    qualifierAst! == wrapperAst -> if {
                                        true => constructorOwnsQualifier!
                                    } else {
                                        prepared.package.nodes[range.astStart + qualifierAst!] => qualifier
                                        qualifier.kind == 36 and qualifier.start == child.start and qualifier.length <= child.length
                                            -> if { qualifier.parent => qualifierAst! } else { -1 => qualifierAst! }
                                    }
                                }
                        }
                    wrapper.kind == 36 and constructorOwnsQualifier!
                        and child.start == wrapper.start and child.length == wrapper.length
                        and wrapperTypeId >= 0 and wrapperTypeId < (canonicalTypes -> len)
                        and canonicalTypesByAst[range.astStart + childAst] == wrapperTypeId
                        and not prepared.callResultMemberByAst[range.astStart + wrapperAst]
                        -> if {
                            canonicalTypes[wrapperTypeId] => wrapperType
                            # A successful direct function call owns its complete
                            # postfix envelope just as a static enum constructor
                            # does. A trailing member has a different span and is
                            # excluded by the canonical call-result member table.
                            child.kind == 11 and wrapperType.status == 0 -> if {
                                externalCalls -> each externalCall {
                                    externalCall.status == 0 and externalCall.sourceModule == sourceIndex
                                        and externalCall.astNode == childAst and externalCall.typeId == wrapperTypeId
                                        -> if { true => ownsWrapper! }
                                }
                                prepared.callIndexByAst[range.astStart + childAst] => callIndex
                                callIndex >= 0 and callIndex < (prepared.calls -> len)
                                    -> if {
                                        prepared.calls[callIndex] => call
                                        call.status == 0 and call.sourceModule == sourceIndex and call.callAst == childAst
                                            and call.targetSourceModule >= 0 and call.targetSourceModule < (prepared.package.ranges -> len)
                                            -> if {
                                                prepared.package.ranges[call.targetSourceModule] => targetRange
                                                call.functionSymbol >= 0 and call.functionSymbol < targetRange.symbolCount
                                                    -> if {
                                                        prepared.package.symbols[targetRange.symbolStart + call.functionSymbol] => target
                                                        target.kind == 7 or target.kind == 31 -> if { true => ownsWrapper! }
                                                    }
                                            }
                                    }
                            }
                            wrapperType.kind == 1 or wrapperType.kind == 7
                                -> if {
                                    child.kind == 55 -> if { true => ownsWrapper! }
                                    child.kind == 11
                                        and (prepared -> nominalEnumConstructorTag(sourceIndex, childAst, canonicalTypesByAst, canonicalTypes)) >= 0
                                        -> if { true => ownsWrapper! }
                                }
                        }
                }
        }
    ownsWrapper!
}

# Lower one ordinary function body through an explicit borrowed work-unit
# boundary. The caller retains orchestration and final canonicalization.
returnedArmGenericFlowTypeId expressionAstIndex: Int, resultRootAst: Int, functionResultTypeId: Int, sourceIndex: Int, source: Text, prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~] -> Int {
    functionResultTypeId < 0 or resultRootAst < 0
        -> if { -1 -> return }
    prepared.package.ranges[sourceIndex] => range
    expressionAstIndex => outerFlowAst!
    0 => flowDepth!
    true => scanningParents!
    scanningParents! -> while {
        prepared.package.nodes[range.astStart + outerFlowAst!] => stage
        stage.parent >= 0 and stage.parent < range.astCount
            -> if {
                prepared.package.nodes[range.astStart + stage.parent] => parent
                parent.kind == 10 and parent.start == stage.start and parent.length > stage.length
                    -> if {
                        stage.parent => outerFlowAst!
                        flowDepth! + 1 => flowDepth!
                    } else { false => scanningParents! }
            } else { false => scanningParents! }
    }
    prepared.package.nodes[range.astStart + outerFlowAst!] => outerFlow
    outerFlow.parent < 0 or outerFlow.parent >= range.astCount
        -> if { -1 -> return }
    prepared.package.nodes[range.astStart + outerFlow.parent] => armBody
    armBody.kind != 43 or armBody.parent < 0 or armBody.parent >= range.astCount
        -> if { -1 -> return }
    prepared.package.nodes[range.astStart + armBody.parent] => arm
    arm.kind != 58 or arm.parent < 0 or arm.parent >= range.astCount
        -> if { -1 -> return }
    prepared.package.nodes[range.astStart + arm.parent] => returnedControl
    prepared.package.nodes[range.astStart + resultRootAst] => resultRoot
    returnedControl.kind != 56 or returnedControl.parent != resultRoot.parent or returnedControl.start < resultRoot.start
        -> if { -1 -> return }
    functionResultTypeId => expectedTypeId!
    0 => depthIndex!
    depthIndex! < flowDepth! -> while {
        types[expectedTypeId!] => expectedType
        expectedType.kind != 7 or expectedType.origin != 4 or expectedType.first < 0
            -> if { -1 -> return }
        expectedType.first => expectedTypeId!
        depthIndex! + 1 => depthIndex!
    }
    types[expectedTypeId!] => expectedType
    expectedType.kind == 7 and expectedType.origin == 4 and (expectedType.symbol == 0 or expectedType.symbol == 1)
        -> if { expectedTypeId! -> return }
    -1
}

lowerOrdinaryFunctionExpressions nodes: mut [TypedIrNode; ~], astToIr: mut [Int; ~], resolvedNames: ref [resolution.ResolvedName; ~], resolvedSymbolByAst: ref [Int; ~], resolvedQualifiedByAst: ref [Bool; ~], qualifiedFunctionPathByAst: ref [Bool; ~], qualifiedValueVariantIndexByAst: ref [Int; ~], localMemberByParentAst: ref [Bool; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, inferred: ref [expressionTypes.ExpressionType; ~], frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], recursiveTypeFlags: ref [Int; ~], frozenFunctionNodeIndices: ref [Int; ~], frozenInferredIndexByAst: ref [Int; ~], frozenNearestLegacyIndexByAst: ref [Int; ~], frozenRecursiveTypeByAst: ref [Int; ~], sourceIndex: Int, symbolIndex: Int, functionIr: Int, resultRootAst: Int, returnIr: Int, functionResultTypeId: Int, functionNodeStart: Int, functionNodeEnd: Int, parameterSymbol: Int, parameterTypeId: Int -> Unit {
    prepared.package.ranges[sourceIndex] => sourceRange
    prepared.package.sources[sourceIndex] -> len => sourceLength
    prepared.package.sources[sourceIndex] -> slice(UIntSize(0), sourceLength) => source
    prepared.package.symbols[sourceRange.symbolStart + symbolIndex] => function
    functionNodeStart => expressionNodePosition!
    expressionNodePosition! < functionNodeEnd -> while {
        frozenFunctionNodeIndices[expressionNodePosition!] => expressionAstIndex
        prepared.package.nodes[sourceRange.astStart + expressionAstIndex] => expression
        true => expressionBelongsToFunction
        frozenInferredIndexByAst[sourceRange.astStart + expressionAstIndex] => expressionTypeIndex
        frozenRecursiveTypeByAst[sourceRange.astStart + expressionAstIndex] => recursiveExpressionTypeId!
        false => exactTerminalFlow!
        expression.kind == 10 and functionResultTypeId >= 0
            -> if {
                frozenRecursiveSemanticTypes[functionResultTypeId] => terminalFunctionResult
                terminalFunctionResult.kind == 7
                    and terminalFunctionResult.origin == 4
                    and (terminalFunctionResult.symbol == 0 or terminalFunctionResult.symbol == 1)
                    and expression.cstRuleId == grammar.ruleIdValueFlowExpression()
                    -> if {
                        source -> standardGenericEnumFlowVariantToken(
                        prepared.package.tokens,
                        sourceRange.tokenStart,
                        expression
                        ) => terminalFlowVariantToken
                        terminalFlowVariantToken >= 0 -> if {
                            expressionAstIndex => terminalFlowAncestor!
                            terminalFlowAncestor! >= 0 and not exactTerminalFlow!
                                -> while {
                                    terminalFlowAncestor! == resultRootAst
                                        -> if { true => exactTerminalFlow! } else {
                                            prepared.package.nodes[sourceRange.astStart + terminalFlowAncestor!].parent
                                                => terminalFlowAncestor!
                                        }
                                }
                        }
                    }
            }
        exactTerminalFlow! -> if {
            functionResultTypeId => recursiveExpressionTypeId!
        }
        expression.kind == 10 -> if {
            expressionAstIndex -> returnedArmGenericFlowTypeId(resultRootAst, functionResultTypeId, sourceIndex, source, prepared, frozenRecursiveSemanticTypes) => returnedArmFlowTypeId
            returnedArmFlowTypeId >= 0 -> if { returnedArmFlowTypeId => recursiveExpressionTypeId! }
        }
        1 => expressionTypeOrigin!
        -1 => expressionTypeModule!
        0 => expressionTypeSymbol!
        expressionTypeIndex >= 0 -> if {
            inferred[expressionTypeIndex] => legacyExpressionType
            legacyExpressionType.origin => expressionTypeOrigin!
            legacyExpressionType.targetModule => expressionTypeModule!
            legacyExpressionType.targetSymbol => expressionTypeSymbol!
        }
        recursiveExpressionTypeId! >= 0 -> if {
            frozenRecursiveSemanticTypes[recursiveExpressionTypeId!] => recursiveExpressionType
            recursiveExpressionType.origin => expressionTypeOrigin!
            recursiveExpressionType.module => expressionTypeModule!
            recursiveExpressionType.symbol => expressionTypeSymbol!
            (recursiveExpressionType.kind >= 2 and recursiveExpressionType.kind <= 6) or recursiveExpressionType.kind == 8
                -> if {
                    10 + recursiveExpressionType.kind => expressionTypeOrigin!
                }
            recursiveExpressionType.kind == 2 or recursiveExpressionType.kind == 3 or recursiveExpressionType.kind == 4 or recursiveExpressionType.kind == 6 or recursiveExpressionType.kind == 8
                -> if {
                    recursiveExpressionType.first >= 0 -> if {
                        frozenRecursiveSemanticTypes[recursiveExpressionType.first].module => expressionTypeModule!
                        frozenRecursiveSemanticTypes[recursiveExpressionType.first].symbol => expressionTypeSymbol!
                    }
                }
            recursiveExpressionType.kind == 5 -> if {
                recursiveExpressionType.first >= 0 -> if { frozenRecursiveSemanticTypes[recursiveExpressionType.first].symbol => expressionTypeModule! }
                recursiveExpressionType.second >= 0 -> if { frozenRecursiveSemanticTypes[recursiveExpressionType.second].symbol => expressionTypeSymbol! }
            }
        }
        -1 => mapExpressionOpcode!
        expression.kind == 49 -> if {
            expressionTypeIds.mapExpressionOpcode(source, prepared.package.tokens, sourceRange.tokenStart, expression) => mapExpressionOpcode!
        }
        mapExpressionOpcode! -> mapExpressionTypeSymbolForOpcode => mapExpressionTypeSymbol
        expression.kind == 49 and mapExpressionTypeSymbol >= 0
            -> if {
                1 => expressionTypeOrigin!
                -1 => expressionTypeModule!
                mapExpressionTypeSymbol => expressionTypeSymbol!
                mapExpressionTypeSymbol => recursiveExpressionTypeId!
            }
        false => knownPatternReference!
        -1 => patternTypeAst!
        expression.kind == 59 -> if { expressionAstIndex => patternTypeAst! }
        expression.kind == 15 -> if {
            0 => patternNameResolutionSearch!
            patternNameResolutionSearch! < (resolvedNames -> len)
                -> while {
                    resolvedNames[patternNameResolutionSearch!] => patternResolvedName
                    patternResolvedName.astNode == expressionAstIndex
                        -> if {
                            prepared.package.symbols[sourceRange.symbolStart + patternResolvedName.symbol] => patternResolvedSymbol
                            prepared.package.nodes[sourceRange.astStart + patternResolvedSymbol.astNode].kind == 59
                                -> if { patternResolvedSymbol.astNode => patternTypeAst! }
                        }
                    patternNameResolutionSearch! + 1 => patternNameResolutionSearch!
                }
        }
        # Name resolution is authoritative for pattern payload
        # uses even when nominal payload typing is deferred. Keep
        # the value node independently of whether its consumer is
        # a function call or an enum constructor.
        expression.kind == 15 and patternTypeAst! >= 0
            -> if { true => knownPatternReference! }
        patternTypeAst! >= 0 -> if {
            prepared.package.nodes[sourceRange.astStart + patternTypeAst!] => patternTypeNode
            patternTypeNode.parent => patternArmAst!
            patternArmAst! >= 0 and prepared.package.nodes[sourceRange.astStart + patternArmAst!].kind == 70
                -> if {
                    prepared.package.nodes[sourceRange.astStart + patternArmAst!].parent => patternArmAst!
                }
            prepared.package.nodes[sourceRange.astStart + patternArmAst!].parent => patternMatchAst
            prepared.package.nodes[sourceRange.astStart + patternMatchAst].parent => patternFlowAst
            patternFlowAst => patternSubjectFlowAst
            -1 => patternSubjectTypeId!
            UIntSize(0) => patternSubjectStart!
            functionNodeStart => patternSubjectPosition!
            patternSubjectPosition! < functionNodeEnd
                -> while {
                    frozenFunctionNodeIndices[patternSubjectPosition!] => patternSubjectSearch
                    prepared.package.nodes[sourceRange.astStart + patternSubjectSearch] => patternSubjectAst
                    frozenRecursiveTypeByAst[sourceRange.astStart + patternSubjectSearch] => patternSubjectCandidateType!
                    patternSubjectCandidateType! < 0 -> if {
                        0 => generatedPatternCallSearch!
                        generatedPatternCallSearch! < (prepared.calls -> len)
                            -> while {
                                prepared.calls[generatedPatternCallSearch!] => generatedPatternCall
                                false => generatedPatternCallBelongs!
                                generatedPatternCall.sourceModule == sourceIndex and generatedPatternCall.callAst >= 0 and generatedPatternCall.callAst < sourceRange.astCount
                                    -> if {
                                        generatedPatternCall.callAst => generatedPatternCallAncestor!
                                        generatedPatternCallAncestor! >= 0 and not generatedPatternCallBelongs!
                                            -> while {
                                                generatedPatternCallAncestor! == patternSubjectSearch
                                                    -> if {
                                                        true => generatedPatternCallBelongs!
                                                    } else {
                                                        prepared.package.nodes[sourceRange.astStart + generatedPatternCallAncestor!].parent => generatedPatternCallAncestor!
                                                    }
                                            }
                                    }
                                generatedPatternCall.status == 0
                                    and generatedPatternCall.sourceModule == sourceIndex
                                    and generatedPatternCallBelongs!
                                    and generatedPatternCall.targetSourceModule >= 0
                                    and generatedPatternCall.functionSymbol >= 0
                                    -> if {
                                        generatedPatternCall.targetSourceModule -> functionResultTypeId(generatedPatternCall.functionSymbol, prepared, recursiveTypes, frozenRecursiveSemanticTypes) => patternSubjectCandidateType!
                                    }
                                generatedPatternCallSearch! + 1 => generatedPatternCallSearch!
                            }
                        0 => localPatternFunctionSearch!
                        localPatternFunctionSearch! < (resolvedNames -> len)
                            -> while {
                                resolvedNames[localPatternFunctionSearch!] => localPatternFunctionName
                                localPatternFunctionName.astNode => localPatternFunctionAncestor!
                                false => localPatternFunctionBelongs!
                                localPatternFunctionAncestor! >= 0 and not localPatternFunctionBelongs!
                                    -> while {
                                        localPatternFunctionAncestor! == patternSubjectSearch
                                            -> if {
                                                true => localPatternFunctionBelongs!
                                            } else {
                                                prepared.package.nodes[sourceRange.astStart + localPatternFunctionAncestor!].parent => localPatternFunctionAncestor!
                                            }
                                    }
                                localPatternFunctionBelongs! -> if {
                                    prepared.package.symbols[sourceRange.symbolStart + localPatternFunctionName.symbol] => localPatternFunction
                                    localPatternFunction.kind == 7 or localPatternFunction.kind == 31
                                        -> if {
                                            sourceIndex -> functionResultTypeId(localPatternFunctionName.symbol, prepared, recursiveTypes, frozenRecursiveSemanticTypes) => patternSubjectCandidateType!
                                        }
                                }
                                localPatternFunctionSearch! + 1 => localPatternFunctionSearch!
                            }
                    }
                    patternSubjectAst.parent == patternSubjectFlowAst => patternSubjectBelongs!
                    not patternSubjectBelongs! and patternSubjectAst.parent >= 0
                        -> if {
                            prepared.package.nodes[sourceRange.astStart + patternSubjectAst.parent] => patternSubjectOwner
                            patternSubjectOwner.kind == 10
                                and patternSubjectOwner.parent == patternSubjectFlowAst
                                and patternSubjectOwner.start == patternSubjectAst.start
                                and patternSubjectOwner.length == patternSubjectAst.length
                                -> if { true => patternSubjectBelongs! }
                        }
                    # A transparent value-flow owner can carry a
                    # provisional Unit type at the same source
                    # start as its resolved call child. Imported
                    # instance calls can also remain unresolved in
                    # the semantic call table until their earlier
                    # receiver has been lowered. For an exact
                    # subject shape the already-resolved Typed IR
                    # call result is the nearest authority, followed
                    # by the semantic call's declared result.
                    patternSubjectBelongs! -> if {
                        0 => patternSubjectIrSearch!
                        patternSubjectIrSearch! < (nodes -> len) -> while {
                            nodes[patternSubjectIrSearch!] => patternSubjectIr
                            (patternSubjectIr.kind == 6 or patternSubjectIr.kind == 9)
                                and patternSubjectIr.sourceModule == sourceIndex
                                and patternSubjectIr.astNode >= 0
                                and patternSubjectIr.typeId >= 0
                                -> if {
                                    prepared.package.nodes[sourceRange.astStart + patternSubjectIr.astNode] => patternSubjectIrAst
                                    patternSubjectIr.astNode == patternSubjectSearch
                                        or (patternSubjectIrAst.parent == patternSubjectSearch
                                        and patternSubjectIrAst.start == patternSubjectAst.start
                                        and patternSubjectIrAst.length == patternSubjectAst.length)
                                        -> if { patternSubjectIr.typeId => patternSubjectCandidateType! }
                                }
                            patternSubjectIrSearch! + 1 => patternSubjectIrSearch!
                        }
                        0 => patternSubjectCallSearch!
                        patternSubjectCallSearch! < (prepared.calls -> len)
                            -> while {
                                prepared.calls[patternSubjectCallSearch!] => patternSubjectCall
                                patternSubjectCall.status == 0
                                    and patternSubjectCall.sourceModule == sourceIndex
                                    and patternSubjectCall.callAst >= 0
                                    and patternSubjectCall.callAst < sourceRange.astCount
                                    and patternSubjectCall.targetSourceModule >= 0
                                    and patternSubjectCall.functionSymbol >= 0
                                    -> if {
                                        prepared.package.nodes[sourceRange.astStart + patternSubjectCall.callAst] => patternSubjectCallAst
                                        patternSubjectCall.callAst == patternSubjectSearch
                                            or (patternSubjectCallAst.parent == patternSubjectSearch
                                            and patternSubjectCallAst.start == patternSubjectAst.start
                                            and patternSubjectCallAst.length == patternSubjectAst.length)
                                            -> if {
                                                patternSubjectCall.targetSourceModule -> functionResultTypeId(patternSubjectCall.functionSymbol, prepared, recursiveTypes, frozenRecursiveSemanticTypes) => patternSubjectCallTypeId
                                                patternSubjectCallTypeId >= 0 -> if { patternSubjectCallTypeId => patternSubjectCandidateType! }
                                            }
                                    }
                                patternSubjectCallSearch! + 1 => patternSubjectCallSearch!
                            }
                    }
                    frozenRecursiveSemanticTypes -> typeIds.materializedReadTypeId(patternSubjectCandidateType!) => patternSubjectCandidateType!
                    patternSubjectBelongs! and patternSubjectAst.start < prepared.package.nodes[sourceRange.astStart + patternMatchAst].start and patternSubjectCandidateType! >= 0 and (frozenRecursiveSemanticTypes[patternSubjectCandidateType!].kind == 7 or frozenRecursiveSemanticTypes[patternSubjectCandidateType!].kind == 1)
                        -> if {
                            patternSubjectTypeId! < 0 or patternSubjectAst.start > patternSubjectStart!
                                -> if {
                                    patternSubjectCandidateType! => patternSubjectTypeId!
                                    patternSubjectAst.start => patternSubjectStart!
                                }
                        }
                    patternSubjectPosition! + 1 => patternSubjectPosition!
                }
            # The semantic call table is the final subject-type
            # authority. A normalized nullary call can own the flow
            # AST itself; an ordinary call can sit directly below
            # it or below the one exact same-span value-flow owner.
            # Keep those shapes equivalent without spelling or
            # ancestry searches.
            patternSubjectTypeId! < 0 -> if {
                UIntSize(0) => patternCallStart!
                0 => patternCallSearch!
                patternCallSearch! < (prepared.calls -> len) -> while {
                    prepared.calls[patternCallSearch!] => patternCall
                    patternCall.status == 0
                        and patternCall.sourceModule == sourceIndex
                        and patternCall.callAst >= 0
                        and patternCall.callAst < sourceRange.astCount
                        and patternCall.targetSourceModule >= 0
                        and patternCall.functionSymbol >= 0
                        -> if {
                            prepared.package.nodes[sourceRange.astStart + patternCall.callAst] => patternCallAst
                            patternCall.callAst == patternSubjectFlowAst
                                or patternCallAst.parent == patternSubjectFlowAst
                                => patternCallBelongs!
                            not patternCallBelongs! and patternCallAst.parent >= 0
                                -> if {
                                    prepared.package.nodes[sourceRange.astStart + patternCallAst.parent] => patternCallOwner
                                    patternCallOwner.kind == 10
                                        and patternCallOwner.parent == patternSubjectFlowAst
                                        and patternCallOwner.start == patternCallAst.start
                                        and patternCallOwner.length == patternCallAst.length
                                        -> if { true => patternCallBelongs! }
                                }
                            patternCallBelongs!
                                and patternCallAst.start < prepared.package.nodes[sourceRange.astStart + patternMatchAst].start
                                and (patternSubjectTypeId! < 0 or patternCallAst.start > patternCallStart!)
                                -> if {
                                    patternCall.targetSourceModule -> functionResultTypeId(patternCall.functionSymbol, prepared, recursiveTypes, frozenRecursiveSemanticTypes) => patternCallTypeId
                                    patternCallTypeId >= 0 -> if {
                                        patternCallTypeId => patternSubjectTypeId!
                                        patternCallAst.start => patternCallStart!
                                    }
                                }
                        }
                    patternCallSearch! + 1 => patternCallSearch!
                }
            }
            patternSubjectTypeId! >= 0 -> if {
                frozenRecursiveSemanticTypes[patternSubjectTypeId!] => patternSubjectType
                prepared.package.tokens[sourceRange.tokenStart + patternTypeNode.payloadToken] => patternVariantToken
                patternSubjectType.kind == 7 -> if {
                    patternSubjectType.first => recursiveExpressionTypeId!
                    (source -> byte(patternVariantToken.span.start)) == 69
                        -> if { patternSubjectType.second => recursiveExpressionTypeId! }
                } else {
                    sourceIndex -> nominalVariantPayloadTypeId(patternSubjectType, patternVariantToken, prepared, recursiveTypes) => recursiveExpressionTypeId!
                }
                recursiveExpressionTypeId! >= 0 -> if {
                    frozenRecursiveSemanticTypes[recursiveExpressionTypeId!] => patternPayloadType
                    patternPayloadType.origin => expressionTypeOrigin!
                    patternPayloadType.module => expressionTypeModule!
                    patternPayloadType.symbol => expressionTypeSymbol!
                    true => knownPatternReference!
                }
            }
        }
        false => knownParameterReference!
        parameterSymbol => knownParameterReferenceSymbol!
        # The canonical resolver owns the complete name, including any Bang
        # suffix. A matching base spelling cannot create a parameter read.
        expression.kind == 15 and parameterSymbol >= 0 and parameterTypeId >= 0
            and resolvedSymbolByAst[expressionAstIndex] == parameterSymbol
            -> if {
                true => knownParameterReference!
                parameterSymbol => knownParameterReferenceSymbol!
                parameterTypeId => recursiveExpressionTypeId!
                frozenRecursiveSemanticTypes[parameterTypeId] => knownParameterType
                knownParameterType.origin => expressionTypeOrigin!
                knownParameterType.module => expressionTypeModule!
                knownParameterType.symbol => expressionTypeSymbol!
            }
        expression.kind == 15 and not knownParameterReference!
            -> if {
                -1 => additionalParameterReferenceSymbol!
                resolvedSymbolByAst[expressionAstIndex] => resolvedParameterSymbol
                resolvedParameterSymbol >= 0 and resolvedParameterSymbol < sourceRange.symbolCount
                    -> if {
                        prepared.package.symbols[sourceRange.symbolStart + resolvedParameterSymbol] => parameterCandidate
                        parameterCandidate.kind == 35 and parameterCandidate.parent == symbolIndex
                            -> if { resolvedParameterSymbol => additionalParameterReferenceSymbol! }
                    }
                additionalParameterReferenceSymbol! >= 0 -> if {
                    functionIr + 1 => additionalParameterIrSearch!
                    additionalParameterIrSearch! < (nodes -> len)
                        -> while {
                            nodes[additionalParameterIrSearch!] => additionalParameterIrCandidate
                            additionalParameterIrCandidate.kind == 10
                                and additionalParameterIrCandidate.parent == functionIr
                                and additionalParameterIrCandidate.symbol == additionalParameterReferenceSymbol!
                                and additionalParameterIrCandidate.typeId >= 0
                                -> if {
                                    true => knownParameterReference!
                                    additionalParameterReferenceSymbol! => knownParameterReferenceSymbol!
                                    additionalParameterIrCandidate.typeId => recursiveExpressionTypeId!
