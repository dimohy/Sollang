                                        knownHeapExpression! -> if { heapOpcode! => expressionOpcode! }
                                        knownSetExpression! -> if { setOpcode! => expressionOpcode! }
                                        insertIntrinsicSpelling! and not knownSetExpression!
                                            -> if { -1 => expressionOpcode! }
