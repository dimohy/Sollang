# Parent ownership is authoritative only after the late control and wrapper
# repairs have converged. Build one linear child index at that point so a
# binary inside a match arm keeps its exact literal/subexpression roots rather
# than an earlier flow subject selected while parents were still provisional.
sealFinalBinaryOperandTopology nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot -> Unit {
    [Int; ~] => leftByBinary!
    [Int; ~] => rightByBinary!
    [UIntSize; ~] => leftEndByBinary!
    [UIntSize; ~] => leftStartByBinary!
    [UIntSize; ~] => rightStartByBinary!
    [UIntSize; ~] => rightEndByBinary!
    0 => initializeIndex!
    initializeIndex! < (nodes -> len) -> while {
        leftByBinary! -> push(-1)
        rightByBinary! -> push(-1)
        leftEndByBinary! -> push(0)
        leftStartByBinary! -> push(0)
        rightStartByBinary! -> push(0)
        rightEndByBinary! -> push(0)
        initializeIndex! + 1 => initializeIndex!
    }
    0 => candidateIndex!
    candidateIndex! < (nodes -> len) -> while {
        nodes[candidateIndex!] => candidate
        candidate.parent >= 0
            and candidate.parent < (nodes -> len)
            and candidate.astNode >= 0
            and candidate.sourceModule >= 0
            and not (candidate.kind == 9 and candidate.opcode == -1)
            and nodes[candidate.parent].kind == 8
            and nodes[candidate.parent].opcode >= grammar.tokenIdPlus()
            and nodes[candidate.parent].opcode <= grammar.tokenIdPercent()
            and nodes[candidate.parent].sourceModule == candidate.sourceModule
            and nodes[candidate.parent].astNode >= 0
            and nodes[candidate.parent].payloadToken >= 0
            -> if {
                candidate.parent => binaryIndex
                nodes[binaryIndex] => binary
                prepared.package.ranges[candidate.sourceModule] => sourceRange
                prepared.package.nodes[sourceRange.astStart + candidate.astNode] => candidateAst
                prepared.package.tokens[sourceRange.tokenStart + binary.payloadToken] => operatorToken
                candidateAst.start + candidateAst.length => candidateEnd
                operatorToken.span.start => operatorStart
                operatorStart + operatorToken.span.length => operatorEnd
                candidateEnd <= operatorStart
                    and (leftByBinary![binaryIndex] < 0
                    or candidateEnd > leftEndByBinary![binaryIndex]
                    or (candidateEnd == leftEndByBinary![binaryIndex]
                    and candidateAst.start < leftStartByBinary![binaryIndex]))
                    -> if {
                        candidateIndex! => leftByBinary![binaryIndex]
                        candidateEnd => leftEndByBinary![binaryIndex]
                        candidateAst.start => leftStartByBinary![binaryIndex]
                    }
                candidateAst.start >= operatorEnd
                    and (rightByBinary![binaryIndex] < 0
                    or candidateAst.start < rightStartByBinary![binaryIndex]
                    or (candidateAst.start == rightStartByBinary![binaryIndex]
                    and candidateEnd > rightEndByBinary![binaryIndex]))
                    -> if {
                        candidateIndex! => rightByBinary![binaryIndex]
                        candidateAst.start => rightStartByBinary![binaryIndex]
                        candidateEnd => rightEndByBinary![binaryIndex]
                    }
            }
        candidateIndex! + 1 => candidateIndex!
    }
    0 => binaryIndex!
    binaryIndex! < (nodes -> len) -> while {
        nodes[binaryIndex!] => binary!
        binary!.kind == 8
            and binary!.opcode >= grammar.tokenIdPlus()
            and binary!.opcode <= grammar.tokenIdPercent()
            and binary!.sourceModule >= 0
            and binary!.astNode >= 0
            and binary!.payloadToken >= 0
            -> if {
                prepared.package.ranges[binary!.sourceModule] => binaryRange
                prepared.package.nodes[binaryRange.astStart + binary!.astNode] => binaryAst
                prepared.package.tokens[binaryRange.tokenStart + binary!.payloadToken] => binaryOperatorToken
                binaryAst.start + binaryAst.length => binaryAstEnd
                binaryOperatorToken.span.start => binaryOperatorStart
                binaryOperatorStart + binaryOperatorToken.span.length => binaryOperatorEnd
                false => currentLeftValid!
                binary!.operand0 >= 0 and binary!.operand0 < (nodes -> len)
                    -> if {
                        nodes[binary!.operand0] => currentLeft
                        currentLeft.sourceModule == binary!.sourceModule
                            and currentLeft.astNode >= 0
                            and not (currentLeft.kind == 9 and currentLeft.opcode == -1)
                            -> if {
                                prepared.package.nodes[binaryRange.astStart + currentLeft.astNode] => currentLeftAst
                                currentLeftAst.start >= binaryAst.start
                                    and currentLeftAst.start + currentLeftAst.length <= binaryOperatorStart
                                    -> if { true => currentLeftValid! }
                            }
                    }
                false => currentRightValid!
                binary!.operand1 >= 0 and binary!.operand1 < (nodes -> len)
                    -> if {
                        nodes[binary!.operand1] => currentRight
                        currentRight.sourceModule == binary!.sourceModule
                            and currentRight.astNode >= 0
                            and not (currentRight.kind == 9 and currentRight.opcode == -1)
                            -> if {
                                prepared.package.nodes[binaryRange.astStart + currentRight.astNode] => currentRightAst
                                currentRightAst.start >= binaryOperatorEnd
                                    and currentRightAst.start + currentRightAst.length <= binaryAstEnd
                                    -> if { true => currentRightValid! }
                            }
                    }
                not currentLeftValid! and leftByBinary![binaryIndex!] >= 0
                    -> if { leftByBinary![binaryIndex!] => binary!.operand0 }
                not currentRightValid! and rightByBinary![binaryIndex!] >= 0
                    -> if { rightByBinary![binaryIndex!] => binary!.operand1 }
                binary! => nodes[binaryIndex!]
            }
        binaryIndex! + 1 => binaryIndex!
    }
}

# Late match typing is the final producer of some function result identities.
# Reconcile only top-level control values after that fixed point; structural
# flow wrappers may sit between the control and the function body, while a
# nested control/region ancestor makes the candidate branch-local.
settleLateFinalFunctionControlResults nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot -> Unit {
    0 => functionIndex!
    functionIndex! < (nodes -> len) -> while {
        nodes[functionIndex!] => function
        function.kind == 0 -> if {
            functionIndex! + 1 => functionEnd!
            functionEnd! < (nodes -> len)
                and nodes[functionEnd!].kind != 0
                and nodes[functionEnd!].kind != 11
                -> while {
                    functionEnd! + 1 => functionEnd!
                }
            function.operand0 >= 0
                and function.operand0 < functionEnd!
                and nodes[function.operand0].kind == 1
                -> if {
                    nodes[function.operand0] => functionBody!
                    functionBody!.operand0 => selectedResult!
                    false => selectedStartFound!
                    UIntSize(0) => selectedStart!
                    selectedResult! >= 0
                        and selectedResult! < functionEnd!
                        and nodes[selectedResult!].sourceModule >= 0
                        and nodes[selectedResult!].sourceModule < (prepared.package.ranges -> len)
                        and nodes[selectedResult!].astNode >= 0
                        -> if {
                            nodes[selectedResult!] => selectedNode
                            prepared.package.ranges[selectedNode.sourceModule] => selectedRange
                            prepared.package.nodes[selectedRange.astStart + selectedNode.astNode].start => selectedStart!
                            true => selectedStartFound!
                        }
                    functionIndex! + 1 => candidateIndex!
                    candidateIndex! < functionEnd! -> while {
                        nodes[candidateIndex!] => candidate
                        (candidate.kind == 18
                            or candidate.kind == 27
                            or candidate.kind == 33
                            or candidate.kind == 34)
                            and candidate.typeOrigin == function.typeOrigin
                            and candidate.typeModule == function.typeModule
                            and candidate.typeSymbol == function.typeSymbol
                            -> if {
                                true => topLevel!
                                candidate.parent => ancestor!
                                ancestor! >= functionIndex!
                                    and ancestor! < functionEnd!
                                    and ancestor! != function.operand0
                                    and topLevel!
                                    -> while {
                                        nodes[ancestor!] => ancestorNode
                                        ancestorNode.kind == 18
                                            or ancestorNode.kind == 19
                                            or ancestorNode.kind == 20
                                            or ancestorNode.kind == 27
                                            or ancestorNode.kind == 33
                                            or ancestorNode.kind == 34
                                            -> if {
                                                false => topLevel!
                                            } else {
                                                ancestorNode.parent => ancestor!
                                            }
                                    }
                                topLevel!
                                    and candidate.sourceModule >= 0
                                    and candidate.sourceModule < (prepared.package.ranges -> len)
                                    and candidate.astNode >= 0
                                    -> if {
                                        prepared.package.ranges[candidate.sourceModule] => candidateRange
                                        prepared.package.nodes[candidateRange.astStart + candidate.astNode].start => candidateStart
                                        not selectedStartFound! or candidateStart > selectedStart!
                                            -> if {
                                                candidateIndex! => selectedResult!
                                                candidateStart => selectedStart!
                                                true => selectedStartFound!
                                            }
                                    }
                            }
                        candidateIndex! + 1 => candidateIndex!
                    }
                    selectedResult! >= 0 and selectedResult! < functionEnd!
                        -> if {
                            selectedResult! => functionBody!.operand0
                            functionBody! => nodes[function.operand0]
                        }
                }
            functionEnd! => functionIndex!
        } else {
            functionIndex! + 1 => functionIndex!
        }
    }
}

# Late result reconciliation can select a branch-local terminal by source order.
# Seal the public function-result edge last by walking that terminal's actual IR
# ancestry and retaining the outermost exact-type value control.
sealFinalFunctionReturnAncestors nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot -> Unit {
    0 => functionIndex!
    functionIndex! < (nodes -> len) -> while {
        nodes[functionIndex!] => function
        function.kind == 0
            and function.operand0 >= 0
            and function.operand0 < (nodes -> len)
            and nodes[function.operand0].kind == 1
            -> if {
                nodes[function.operand0] => functionBody!
                -1 => finalTopLevelResult!
                UIntSize(0) => finalTopLevelStart!
                UIntSize(0) => finalTopLevelLength!
                UIntSize(0) => finalTopLevelEnd!
                functionIndex! + 1 => finalTopLevelSearch!
                finalTopLevelSearch! < (nodes -> len)
                    and nodes[finalTopLevelSearch!].kind != 0
                    and nodes[finalTopLevelSearch!].kind != 11
                    -> while {
                        nodes[finalTopLevelSearch!] => finalTopLevelCandidate
                        false => finalTopLevelTypeMatches!
                        function.typeId >= 0 and finalTopLevelCandidate.typeId == function.typeId
                            -> if { true => finalTopLevelTypeMatches! }
                        function.typeId < 0
                            and finalTopLevelCandidate.typeId < 0
                            and finalTopLevelCandidate.typeOrigin == function.typeOrigin
                            and finalTopLevelCandidate.typeModule == function.typeModule
                            and finalTopLevelCandidate.typeSymbol == function.typeSymbol
                            -> if { true => finalTopLevelTypeMatches! }
                        finalTopLevelCandidate.parent == function.operand0
                            and finalTopLevelCandidate.kind != 17
                            and finalTopLevelCandidate.kind != 19
                            and finalTopLevelCandidate.astNode >= 0
                            and finalTopLevelCandidate.sourceModule >= 0
                            and finalTopLevelCandidate.sourceModule < (prepared.package.ranges -> len)
                            and finalTopLevelTypeMatches!
                            -> if {
                                prepared.package.ranges[finalTopLevelCandidate.sourceModule] => finalTopLevelRange
                                prepared.package.nodes[finalTopLevelRange.astStart + finalTopLevelCandidate.astNode] => finalTopLevelAst
                                finalTopLevelAst.start + finalTopLevelAst.length => finalTopLevelCandidateEnd
                                finalTopLevelResult! < 0
                                    or finalTopLevelCandidateEnd > finalTopLevelEnd!
                                    or (finalTopLevelCandidateEnd == finalTopLevelEnd!
                                    and finalTopLevelAst.start < finalTopLevelStart!)
                                    or (finalTopLevelCandidateEnd == finalTopLevelEnd!
                                    and finalTopLevelAst.start == finalTopLevelStart!
                                    and finalTopLevelAst.length > finalTopLevelLength!)
                                    -> if {
                                        finalTopLevelSearch! => finalTopLevelResult!
                                        finalTopLevelAst.start => finalTopLevelStart!
                                        finalTopLevelAst.length => finalTopLevelLength!
                                        finalTopLevelCandidateEnd => finalTopLevelEnd!
                                    }
                            }
                        finalTopLevelSearch! + 1 => finalTopLevelSearch!
                    }
                finalTopLevelResult! >= 0 -> if { finalTopLevelResult! => functionBody!.operand0 }
                functionBody!.operand0 >= 0 and functionBody!.operand0 < (nodes -> len)
                    -> if {
                        nodes[functionBody!.operand0] => directFunctionResult!
                        (directFunctionResult!.kind == 27 or directFunctionResult!.kind == 34)
                            and function.typeId >= 0
                            -> if {
                                function.typeId => directFunctionResult!.typeId
                                function.typeKind => directFunctionResult!.typeKind
                                function.typeOrigin => directFunctionResult!.typeOrigin
                                function.typeModule => directFunctionResult!.typeModule
                                function.typeSymbol => directFunctionResult!.typeSymbol
                                function.typeFlags => directFunctionResult!.typeFlags
                                directFunctionResult! => nodes[functionBody!.operand0]
                            }
                    }
                functionBody!.operand0 => returnAncestor!
                -1 => outermostReturnControl!
                true => returnAncestorOpen!
                returnAncestor! >= 0
                    and returnAncestor! < (nodes -> len)
                    and returnAncestorOpen!
                    -> while {
                        nodes[returnAncestor!] => returnAncestorNode
                        false => returnAncestorTypeMatches!
                        function.typeId >= 0 and returnAncestorNode.typeId == function.typeId
                            -> if { true => returnAncestorTypeMatches! }
                        function.typeId < 0
                            and returnAncestorNode.typeId < 0
                            and returnAncestorNode.typeOrigin == function.typeOrigin
                            and returnAncestorNode.typeModule == function.typeModule
                            and returnAncestorNode.typeSymbol == function.typeSymbol
                            -> if { true => returnAncestorTypeMatches! }
                        (returnAncestorNode.kind == 18
                            or returnAncestorNode.kind == 27
                            or returnAncestorNode.kind == 33
                            or returnAncestorNode.kind == 34)
                            and returnAncestorTypeMatches!
                            -> if { returnAncestor! => outermostReturnControl! }
                        returnAncestor! == function.operand0 -> if {
                            false => returnAncestorOpen!
                        } else {
                            returnAncestorNode.parent => returnAncestor!
                        }
                    }
                outermostReturnControl! >= 0 -> if {
                    outermostReturnControl! => functionBody!.operand0
                }
                # Publish a corrected top-level result even when it is a plain
                # expression and no enclosing control replaces it.
                functionBody! => nodes[function.operand0]
            }
        functionIndex! + 1 => functionIndex!
    }
}

# Late alias and projected-call sealing can establish an arithmetic operand's
# exact builtin width after the earlier contextual-literal pass. Close that
# producer -> consumer edge once at the final boundary: a bare integer literal
# adopts its concrete peer width, and arithmetic adopts the same width. Boolean
# comparison results remain untouched.
sealFinalContextualNumericLiterals nodes: mut [TypedIrNode; ~] -> Unit {
    true => numericTypesChanged!
    numericTypesChanged! -> while {
        false => numericTypesChanged!
        0 => numericIndex!
        numericIndex! < (nodes -> len) -> while {
            nodes[numericIndex!] => numeric!
            (numeric!.opcode >= grammar.tokenIdPlus()
                and numeric!.opcode <= grammar.tokenIdPercent())
                => numericArithmetic
            (numericArithmetic
                or numeric!.opcode == grammar.tokenIdEqualEqual()
                or numeric!.opcode == grammar.tokenIdBangEqual()
                or (numeric!.opcode >= grammar.tokenIdLessEqual()
                and numeric!.opcode <= grammar.tokenIdGreater()))
                => numericOperands
            numeric!.kind == 8
                and numericOperands
                and numeric!.operand0 >= 0
                and numeric!.operand0 < (nodes -> len)
                and numeric!.operand1 >= 0
                and numeric!.operand1 < (nodes -> len)
                -> if {
                    nodes[numeric!.operand0].typeId => previousLeftTypeId
                    nodes[numeric!.operand1].typeId => previousRightTypeId
                    numeric!.typeId => previousResultTypeId
                    nodes[numeric!.operand1] => right
                    nodes -> sealIntegerLiteralPeerContext(numeric!.operand0, right)
                    nodes[numeric!.operand0] => left
                    nodes -> sealIntegerLiteralPeerContext(numeric!.operand1, left)
                    nodes[numeric!.operand0] => canonicalLeft
                    nodes[numeric!.operand1] => canonicalRight
                    numericArithmetic
                        and canonicalLeft.typeId >= 0
                        and canonicalLeft.typeId == canonicalRight.typeId
                        and canonicalLeft.typeKind == 1
                        and canonicalLeft.typeOrigin == 1
                        and integerTypeRank(canonicalLeft.typeSymbol) > 0
                        -> if {
                            canonicalLeft.typeId => numeric!.typeId
                            canonicalLeft.typeKind => numeric!.typeKind
                            canonicalLeft.typeOrigin => numeric!.typeOrigin
                            canonicalLeft.typeModule => numeric!.typeModule
                            canonicalLeft.typeSymbol => numeric!.typeSymbol
                            canonicalLeft.typeFlags => numeric!.typeFlags
                            numeric! => nodes[numericIndex!]
                        }
                    previousLeftTypeId != nodes[numeric!.operand0].typeId
                        or previousRightTypeId != nodes[numeric!.operand1].typeId
                        or previousResultTypeId != nodes[numericIndex!].typeId
                        -> if { true => numericTypesChanged! }
                }
            numericIndex! + 1 => numericIndex!
        }
    }
}

# Finalize returned controls, ownership flags, and runtime intrinsic opcodes.
sealBooleanWhenResultTypes nodes: mut [TypedIrNode; ~] -> Unit {
    0 => booleanWhenIndex!
    booleanWhenIndex! < (nodes -> len) -> while {
        nodes[booleanWhenIndex!] => booleanWhen!
        booleanWhen!.kind == 33
            and booleanWhen!.typeOrigin == 1
            and booleanWhen!.typeSymbol == 0
            and booleanWhen!.operand0 >= 0
            and booleanWhen!.operand0 < (nodes -> len)
            -> if {
                nodes[booleanWhen!.operand0] => booleanWhenFirstArmType
                not (booleanWhenFirstArmType.typeOrigin == 1 and booleanWhenFirstArmType.typeSymbol == 0)
                    -> if {
                        booleanWhenFirstArmType.typeOrigin => booleanWhen!.typeOrigin
                        booleanWhenFirstArmType.typeModule => booleanWhen!.typeModule
                        booleanWhenFirstArmType.typeSymbol => booleanWhen!.typeSymbol
                        booleanWhenFirstArmType.typeId => booleanWhen!.typeId
                        booleanWhenFirstArmType.typeKind => booleanWhen!.typeKind
                        booleanWhenFirstArmType.typeFlags => booleanWhen!.typeFlags
                        booleanWhen! => nodes[booleanWhenIndex!]
                    }
            }
        booleanWhenIndex! + 1 => booleanWhenIndex!
    }
}

finalizeResolvedContext nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], recursiveTypeFlags: ref [Int; ~], runtimeSymbols: ref LateRuntimeSymbols, finalWrappedValueByNode: ref [Int; ~] -> Unit {
    # Final return selection above is the authority for which control value
    # leaves a function. Apply that declared type to a returned enum or numeric
    # subject match and retain the terminal same-type value from each arm pipeline.
    0 => finalReturnedMatchIndex!
    finalReturnedMatchIndex! < (nodes -> len)
        -> while {
            nodes[finalReturnedMatchIndex!] => finalReturnedMatch
            finalReturnedMatchIndex! - 1 => finalReturnedOwnerIndex!
            finalReturnedOwnerIndex! >= 0
                and nodes[finalReturnedOwnerIndex!].kind != 0
                and nodes[finalReturnedOwnerIndex!].kind != 11
                -> while {
                    finalReturnedOwnerIndex! - 1 => finalReturnedOwnerIndex!
                }
            -1 => finalReturnedBodyIndex!
            finalReturnedOwnerIndex! >= 0
                -> if { nodes[finalReturnedOwnerIndex!].operand0 => finalReturnedBodyIndex! }
            (finalReturnedMatch.kind == 27 or finalReturnedMatch.kind == 34)
                and finalReturnedBodyIndex! >= 0
                and finalReturnedBodyIndex! < (nodes -> len)
                and nodes[finalReturnedBodyIndex!].kind == 1
                and nodes[finalReturnedBodyIndex!].operand0 == finalReturnedMatchIndex!
                and finalReturnedMatch.typeId >= 0
                -> if {
                    finalReturnedMatch => finalReturnedNode
                    frozenRecursiveSemanticTypes[finalReturnedNode.typeId] => finalReturnedType
                    finalReturnedMatch.operand1 => finalReturnedArmIndex!
                    finalReturnedArmIndex! >= 0
                        and finalReturnedArmIndex! < (nodes -> len)
                        and nodes[finalReturnedArmIndex!].parent == finalReturnedMatchIndex!
                        -> while {
                            nodes[finalReturnedArmIndex!] => finalReturnedArm
                            finalReturnedArmIndex! => finalReturnedRegionIndex!
                            finalReturnedArm.operand1 >= 0
                                and finalReturnedArm.operand1 < (nodes -> len)
                                and nodes[finalReturnedArm.operand1].kind == 19
                                -> if { finalReturnedArm.operand1 => finalReturnedRegionIndex! }
                            -1 => finalReturnedValue!
                            nodes[finalReturnedRegionIndex!].operand1 => finalReturnedExistingValue!
                            finalReturnedExistingValue! >= 0
                                and finalReturnedExistingValue! < (nodes -> len)
                                and nodes[finalReturnedExistingValue!].kind == 9
                                and nodes[finalReturnedExistingValue!].opcode == -1
                                and (nodes[finalReturnedExistingValue!].operand0 >= 0
                                or finalWrappedValueByNode[finalReturnedExistingValue!] >= 0)
                                -> while {
                                    nodes[finalReturnedExistingValue!].operand0 >= 0
                                        -> if {
                                            nodes[finalReturnedExistingValue!].operand0 => finalReturnedExistingValue!
                                        } else {
                                            finalWrappedValueByNode[finalReturnedExistingValue!] => finalReturnedExistingValue!
                                        }
                                }
                            finalReturnedExistingValue! >= 0
                                and finalReturnedExistingValue! < (nodes -> len)
                                -> if {
                                    finalReturnedExistingValue! => finalNestedControlAncestor!
                                    -1 => finalNestedControlValue!
                                    finalNestedControlAncestor! >= 0
                                        and finalNestedControlAncestor! < (nodes -> len)
                                        and finalNestedControlAncestor! != finalReturnedRegionIndex!
                                        -> while {
                                            nodes[finalNestedControlAncestor!] => finalNestedControlCandidate
                                            finalNestedControlCandidate.parent == finalReturnedRegionIndex!
                                                and (finalNestedControlCandidate.kind == 18
                                                or finalNestedControlCandidate.kind == 27
                                                or finalNestedControlCandidate.kind == 33
                                                or finalNestedControlCandidate.kind == 34)
                                                and finalNestedControlCandidate.typeId == finalReturnedNode.typeId
                                                -> if {
                                                    finalNestedControlAncestor! => finalNestedControlValue!
                                                    finalReturnedRegionIndex! => finalNestedControlAncestor!
                                                } else {
                                                    finalNestedControlCandidate.parent => finalNestedControlAncestor!
                                                }
                                        }
                                    finalNestedControlValue! >= 0
                                        -> if { finalNestedControlValue! => finalReturnedExistingValue! }
                                }
                            finalReturnedExistingValue! >= 0 and finalReturnedExistingValue! < (nodes -> len)
                                -> if {
                                    nodes[finalReturnedExistingValue!] => finalReturnedExistingCandidate
                                    (finalReturnedExistingCandidate.kind == 3
                                        and finalReturnedType.kind == 1
                                        and finalReturnedType.origin == 1
                                        and finalReturnedType.symbol >= 2
                                        and finalReturnedType.symbol <= 14) => finalReturnedExistingIsContextualIntegerLiteral
                                    finalReturnedExistingCandidate.typeId == finalReturnedNode.typeId
                                        or ((finalReturnedExistingCandidate.typeKind == finalReturnedNode.typeKind or finalReturnedExistingCandidate.typeId < 0)
                                        and finalReturnedExistingCandidate.typeOrigin == finalReturnedNode.typeOrigin
                                        and finalReturnedExistingCandidate.typeModule == finalReturnedNode.typeModule
                                        and finalReturnedExistingCandidate.typeSymbol == finalReturnedNode.typeSymbol)
                                        or finalReturnedExistingIsContextualIntegerLiteral
                                        -> if {
                                            finalReturnedExistingValue! => finalReturnedValue!
                                        }
                                }
                            finalReturnedArm.nextOperand => finalReturnedArmEnd!
                            finalReturnedArmEnd! < 0 -> if {
                                finalReturnedMatch.parent + 1 => finalReturnedArmEnd!
                                finalReturnedArmEnd! < (nodes -> len)
                                    and nodes[finalReturnedArmEnd!].kind != 0
                                    and nodes[finalReturnedArmEnd!].kind != 11
                                    -> while {
                                        finalReturnedArmEnd! + 1 => finalReturnedArmEnd!
                                    }
                            }
                            finalReturnedArmIndex! + 1 => finalReturnedCandidateIndex!
                            finalReturnedCandidateIndex! < finalReturnedArmEnd! and finalReturnedValue! < 0
                                -> while {
                                    nodes[finalReturnedCandidateIndex!] => finalReturnedCandidate
                                    ((finalReturnedCandidate.kind >= 2 and finalReturnedCandidate.kind <= 9)
                                        or (finalReturnedCandidate.kind >= 12 and finalReturnedCandidate.kind <= 18)
                                        or finalReturnedCandidate.kind == 26
                                        or finalReturnedCandidate.kind == 27
                                        or finalReturnedCandidate.kind == 29
                                        or (finalReturnedCandidate.kind >= 31 and finalReturnedCandidate.kind <= 43)) => finalReturnedCandidateProducesValue
                                    (finalReturnedCandidate.kind == 3
                                        and finalReturnedType.kind == 1
                                        and finalReturnedType.origin == 1
                                        and finalReturnedType.symbol >= 2
                                        and finalReturnedType.symbol <= 14) => finalReturnedCandidateIsContextualIntegerLiteral
                                    (finalReturnedCandidate.typeId == finalReturnedNode.typeId
                                        or ((finalReturnedCandidate.typeKind == finalReturnedNode.typeKind or finalReturnedCandidate.typeId < 0)
                                        and finalReturnedCandidate.typeOrigin == finalReturnedNode.typeOrigin
                                        and finalReturnedCandidate.typeModule == finalReturnedNode.typeModule
                                        and finalReturnedCandidate.typeSymbol == finalReturnedNode.typeSymbol)
                                        or finalReturnedCandidateIsContextualIntegerLiteral) => finalReturnedCandidateMatchesType
                                    finalReturnedCandidateProducesValue
                                        and finalReturnedCandidateMatchesType -> if {
                                            finalReturnedCandidateIndex! => finalReturnedValue!
                                        }
                                    finalReturnedCandidateIndex! + 1 => finalReturnedCandidateIndex!
                                }
                            finalReturnedValue! >= 0 -> if {
                                nodes[finalReturnedValue!] => finalReturnedCanonicalValue!
                                finalReturnedNode.typeId => finalReturnedCanonicalValue!.typeId
                                finalReturnedType.kind => finalReturnedCanonicalValue!.typeKind
                                finalReturnedType.origin => finalReturnedCanonicalValue!.typeOrigin
                                finalReturnedType.module => finalReturnedCanonicalValue!.typeModule
                                finalReturnedType.symbol => finalReturnedCanonicalValue!.typeSymbol
                                recursiveTypeFlags[finalReturnedNode.typeId] => finalReturnedCanonicalValue!.typeFlags
                                finalReturnedCanonicalValue! => nodes[finalReturnedValue!]
