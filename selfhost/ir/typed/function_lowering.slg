# A private body materialization step shares the existing relocatable body
# copier. Backend publication and captured lexical control remain separate.
public materializeUserBlockCallbacks nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, resolved: mut expressionTypeIds.ExpressionTypeIdSet, genericInstances: ref [GenericFunctionInstance; ~] -> [GenericFunctionInstance; ~] {
