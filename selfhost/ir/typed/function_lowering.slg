namespace sollang.compiler.ir.typed

import sollang.compiler.ast as ast
import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.symbols as symbols
import sollang.compiler.semantic.calls as calls
import sollang.compiler.semantic.expression_type_ids as expressionTypeIds
import sollang.compiler.semantic.resolve as resolution
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.syntax as syntax
import syntax.generated.slg as grammar

struct SourceTypedIr {
    nodes: [TypedIrNode; ~]
}

struct FunctionLowerRequest {
    sourceIndex: Int
    symbolIndex: Int
}

# Type parameters can be used only in the body, or deliberately unused. The
# declaration remains a template even when its entire signature is concrete.
public functionDeclaresGenericParameters function: TypedIrNode, ranges: ref [analysis.SourceAnalysisRange; ~], declarations: ref [symbols.Symbol; ~] -> Bool {
    function.kind != 0 or function.sourceModule < 0 or function.sourceModule >= (ranges -> len)
        or function.symbol < 0 -> if { false -> return }
    ranges[function.sourceModule] => range
    function.symbol >= range.symbolCount -> if { false -> return }
    0 => index!
    index! < range.symbolCount -> while {
        declarations[range.symbolStart + index!] => candidate
        candidate.kind == 32 and candidate.parent == function.symbol
            -> if { true -> return }
        index! + 1 => index!
    }
    false
}

# The same signature identifies retained templates for materialization and
# deferred body validation. Concrete instances have fully substituted types.
public functionSignatureContainsParameter nodes: ref [TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], functionIndex: Int -> Bool {
    nodes[functionIndex] => function
    function.typeId >= 0 and function.typeId < (types -> len)
        and types[function.typeId].containsParameter
        -> if { true -> return }
    function.operand1 => parameter!
    0 => ordinal!
    parameter! >= 0 and parameter! < (nodes -> len)
        and ordinal! < (nodes -> len) -> while {
            nodes[parameter!].typeId => parameterType
            parameterType >= 0 and parameterType < (types -> len)
                and types[parameterType].containsParameter
                -> if { true -> return }
            ordinal! == 0 -> if { function.nextOperand => parameter! } else {
                nodes[parameter!].nextOperand => parameter!
            }
            ordinal! + 1 => ordinal!
        }
    false
}

# Binding IR is hoisted before expressions, so IR index order is not lexical
# visibility. A mutable assignment can only select an earlier declaration in
# its own scope or an ancestor scope, never a later or sibling declaration.
mutableAssignmentBindingVisible candidateIndex: Int, assignmentIndex: Int, nodes: ref [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot -> Bool {
    nodes[candidateIndex] => candidate
    nodes[assignmentIndex] => assignment
    false => visible!
    candidate.sourceModule == assignment.sourceModule
        -> if {
            prepared.package.ranges[candidate.sourceModule] => range
            prepared.package.nodes[range.astStart + candidate.astNode] => declaration
            prepared.package.nodes[range.astStart + assignment.astNode] => use
            declaration.start <= use.start -> if {
                assignment.parent => ancestor!
                ancestor! >= 0 and not visible! -> while {
                    ancestor! == candidate.parent -> if { true => visible! }
                    nodes[ancestor!].parent => ancestor!
                }
            }
        }
    visible!
}

public struct GenericCallPlan {
    public callNode: Int
    public interpolationNode: Int
    public ownerFunction: Int
    public templateNode: Int
    public inputTemplates: [Int; ~]
    public actualInputs: [Int; ~]
    public resultType: Int
    public status: Int
}

public struct GenericFunctionInstance {
    public callNode: Int
    public interpolationNode: Int
    public ownerFunction: Int
    public templateNode: Int
    public functionNode: Int
    public nodeCount: Int
    public status: Int
}

public struct GenericBodyBindings {
    public functionsByCall: [Int; ~]
    public functionsByInterpolation: [Int; ~]
    public templatesByFunction: [Int; ~]
    public interpolationInstances: [GenericFunctionInstance; ~]
}

public bindGenericBodies nodes: ref [TypedIrNode; ~], instances: ref [GenericFunctionInstance; ~], interpolationCount: Int -> GenericBodyBindings {
    [Int; ~] => functions!
    [Int; ~] => templates!
    [Int; ~] => interpolationFunctions!
    [GenericFunctionInstance; ~] => interpolationInstances!
    0 => index!
    index! < (nodes -> len) -> while {
        functions! -> push(-1)
        templates! -> push(-1)
        index! + 1 => index!
    }
    (interpolationFunctions! -> len) < interpolationCount
        -> while { interpolationFunctions! -> push(-1) }
    instances -> each instance {
        instance.status == 0 -> if {
            instance.callNode >= 0 -> if { instance.functionNode => functions![instance.callNode] }
            instance.interpolationNode >= 0 -> if {
                interpolationInstances! -> push(instance)
                instance.ownerFunction < 0 -> if { instance.functionNode => interpolationFunctions![instance.interpolationNode] }
            }
            instance.templateNode => templates![instance.functionNode]
        }
    }
    GenericBodyBindings { functionsByCall: functions!, functionsByInterpolation: interpolationFunctions!, templatesByFunction: templates!, interpolationInstances: interpolationInstances! }
}

public genericInterpolationFunction bindings: ref GenericBodyBindings, ownerFunction: Int, interpolationNode: Int -> Int {
    bindings.interpolationInstances -> each instance {
        instance.ownerFunction == ownerFunction and instance.interpolationNode == interpolationNode
            -> if { instance.functionNode -> return }
    }
    -1
}

public publishGenericCallTypes nodes: mut [TypedIrNode; ~], instances: ref [GenericFunctionInstance; ~], prepared: ref semanticContext.SemanticSnapshot, resolved: ref expressionTypeIds.ExpressionTypeIdSet -> Unit {
    instances -> each instance {
        instance.status == 0 and instance.callNode >= 0
            -> if {
                nodes[instance.functionNode] => function
                nodes[instance.callNode] => call!
                function.typeId => call!.typeId
                function.typeKind => call!.typeKind
                function.typeOrigin => call!.typeOrigin
                function.typeModule => call!.typeModule
                function.typeSymbol => call!.typeSymbol
                function.typeFlags => call!.typeFlags
                call! => nodes[instance.callNode]
            }
    }
    typeIds.enumPayloadEdges(resolved.types, resolved.references, prepared.package.ranges, prepared.package.symbols, resolved.referenceIndexByTypeAst) => payloadEdges
    prepared -> semanticContext.ownedResourceSeeds(resolved.types) => resourceSeeds
    typeIds.classifyWithResources(resolved.types, resolved.fields, payloadEdges, resourceSeeds) => flags
    nodes -> sealIntrinsicPayloadsAfterGenericCalls(resolved.types, flags)
    nodes -> sealLateTypes(prepared, resolved, resolved.types, flags)
    nodes -> sealFinalIndexTypes(resolved.types, flags)
    nodes -> resolveFinalProjectedMethods(prepared, resolved, resolved.types, flags)
    nodes -> sealLateTypes(prepared, resolved, resolved.types, flags)
    nodes -> sealFinalIndexTypes(resolved.types, flags)
    nodes -> sealIntrinsicPayloadsAfterGenericCalls(resolved.types, flags)
    nodes -> sealStructuralProductMembers(prepared, resolved, resolved.types, flags)
}

# C# binds a generic call before typing its dependent match arm. Reestablish
# that same dependency after the self-host closure publishes the concrete call
# result, using only the exact match subject and intrinsic variant tag.
sealIntrinsicPayloadsAfterGenericCalls nodes: mut [TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], flags: ref [Int; ~] -> Unit {
    0 => payloadIndex!
    payloadIndex! < (nodes -> len) -> while {
        nodes[payloadIndex!] => payload!
        payload!.kind == 29 and payload!.parent >= 0 and payload!.parent < (nodes -> len)
            -> if {
                nodes[payload!.parent] => arm
                arm.kind == 19 and arm.parent >= 0 and arm.parent < (nodes -> len)
                    -> if {
                        nodes[arm.parent] => match
                        match.kind == 27 and match.operand0 >= 0 and match.operand0 < (nodes -> len)
                            -> if {
                                nodes[match.operand0].typeId => subjectTypeId
                                subjectTypeId >= 0 and subjectTypeId < (types -> len)
                                    -> if {
                                        types[subjectTypeId] => subjectType
                                        -1 => payloadTypeId!
                                        subjectType.kind == 7 and subjectType.origin == 4
                                            -> if {
                                                subjectType.symbol == 0 and arm.opcode == 0
                                                    -> if { subjectType.first => payloadTypeId! }
                                                subjectType.symbol == 1
                                                    -> if {
                                                        arm.opcode == 0 -> if { subjectType.first => payloadTypeId! }
                                                        arm.opcode == 1 -> if { subjectType.second => payloadTypeId! }
                                                    }
                                            }
                                        payloadTypeId! >= 0 and payloadTypeId! < (types -> len)
                                            -> if {
                                                payload! -> sealNodeTypeIdentity(payloadTypeId!, types, flags)
                                                payload! => nodes[payloadIndex!]
                                            }
                                    }
                            }
                    }
            }
        payloadIndex! + 1 => payloadIndex!
    }
    0 => readIndex!
    readIndex! < (nodes -> len) -> while {
        nodes[readIndex!] => read!
        read!.kind == 5 and read!.operand0 >= 0 and read!.operand0 < (nodes -> len)
            and nodes[read!.operand0].kind == 29 and nodes[read!.operand0].typeId >= 0
            -> if {
                nodes[read!.operand0] => binding
                binding.typeId => read!.typeId
                binding.typeKind => read!.typeKind
                binding.typeOrigin => read!.typeOrigin
                binding.typeModule => read!.typeModule
                binding.typeSymbol => read!.typeSymbol
                binding.typeFlags => read!.typeFlags
                read! => nodes[readIndex!]
            }
        readIndex! + 1 => readIndex!
    }
}

# Register instances before visiting their bodies so recursive calls reuse them.
# Preserve structural field labels under the generic result substitution.
materializeGenericProductFields nodes: ref [TypedIrNode; ~], types: mut [typeIds.SemanticType; ~], fields: mut [typeIds.NominalField; ~], plans: ref [GenericCallPlan; ~], selected: ref [Bool; ~] -> Unit {
    0 => planIndex!
    plans -> each plan {
        selected[planIndex!] and plan.status == 0 and plan.templateNode >= 0
            -> if {
                [nodes[plan.templateNode].typeId,; ~] => pending!
                [Int; ~] => visited!
                (pending! -> len) > 0 -> while {
                    pending! -> take(Int(pending! -> len) - 1) => template
                    false => seen!
                    visited! -> each known { known == template -> if { true => seen! } }
                    not seen! and template >= 0 and template < (types -> len)
                        -> if {
                            visited! -> push(template)
                            types[template] => sourceType
                            sourceType.kind == 10 and sourceType.containsParameter
                                -> if {
                                    types -> typeIds.specializeManyInto(plan.inputTemplates, plan.actualInputs, template) => owner
                                    owner.status == 0 and owner.root != template
                                        -> if {
                                            fields -> len => fieldCount
                                            0 => fieldIndex!
                                            fieldIndex! < fieldCount -> while {
                                                fields[fieldIndex!] => field
                                                field.ownerType == template -> if {
                                                    false => exists!
                                                    fields -> each existing {
                                                        existing.ownerType == owner.root and existing.ordinal == field.ordinal
                                                            -> if { true => exists! }
                                                    }
                                                    not exists! -> if {
                                                        types -> typeIds.specializeManyInto(plan.inputTemplates, plan.actualInputs, field.fieldType) => value
                                                        value.status == 0 -> if {
                                                            field => concrete!
                                                            owner.root => concrete!.ownerType
                                                            value.root => concrete!.fieldType
                                                            types[value.root].status => concrete!.status
                                                            fields -> push(concrete!)
                                                        }
                                                    }
                                                }
                                                fieldIndex! + 1 => fieldIndex!
                                            }
                                        }
                                }
                            sourceType.first >= 0 -> if { pending! -> push(sourceType.first) }
                            sourceType.second >= 0 -> if { pending! -> push(sourceType.second) }
                        }
                }
            }
        planIndex! + 1 => planIndex!
    }
}

# Explicit Number arguments are semantic value identity, independently of the
# runtime input type. Type syntax and runtime arguments own their own numbers.
# -1 means no explicit value; -2 retains an invalid Number identity for the
# existing parser/semantic diagnostic path rather than treating it as a value.
explicitGenericValueIdentity call: TypedIrNode, prepared: ref semanticContext.SemanticSnapshot -> Int {
    call.sourceModule < 0 or call.sourceModule >= (prepared.package.ranges -> len)
        -> if { -1 -> return }
    prepared.package.ranges[call.sourceModule] => range
    call.astNode < 0 or call.astNode >= range.astCount
        -> if { -1 -> return }
    call.astNode -> ast.explicitNumericGenericArgumentToken(range.astStart, range.astCount, range.tokenStart, prepared.package.nodes, prepared.package.tokens) => tokenIndex
    tokenIndex < 0 -> if { -1 -> return }
    prepared.package.sources[call.sourceModule] -> len => sourceLength
    prepared.package.sources[call.sourceModule] -> slice(UIntSize(0), sourceLength) => sourceText
    sourceText -> syntax.numericExtentTokenValue(prepared.package.tokens[range.tokenStart + tokenIndex]) => value
    value < 0 -> if { -2 -> return }
    value
}

public materializeGenericClosure nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, resolved: mut expressionTypeIds.ExpressionTypeIdSet -> [GenericFunctionInstance; ~] {
    {UInt64: Int; 16~} => heads!
    [Int; ~] => next!
    [Int; ~] => templates!
    [Int; ~] => results!
    [Int; ~] => starts!
    [Int; ~] => lengths!
    [Int; ~] => arguments!
    [Int; ~] => valueArguments!
    [Int; ~] => functions!
    [Int; ~] => counts!
    [Bool; ~] => processed!
    [GenericFunctionInstance; ~] => instances!
    true => progress!
    progress! -> while {
        false => progress!
        (processed! -> len) < (nodes -> len) -> while { processed! -> push(false) }
        nodes -> functionTemplatesBySymbol(prepared) => functionsBySymbol
        nodes -> planGenericCallsWithTemplates(prepared, resolved.types, resolved.references, functionsBySymbol) => plans!
        nodes -> appendInterpolationGenericCalls(prepared, resolved, plans!, functionsBySymbol)
        # A helper's result parameter belongs to its caller after substitution,
        # even while that caller is still a generic template.
        plans! -> each plan {
            plan.callNode >= 0 and plan.status == 0 and plan.resultType >= 0
                and (not resolved.types[plan.resultType].containsParameter
                or plan.resultType != nodes[plan.templateNode].typeId)
                -> if {
                    resolved.types[plan.resultType] => canonical
                    nodes[plan.callNode] => call!
                    plan.resultType => call!.typeId
                    canonical.kind => call!.typeKind
                    canonical.origin => call!.typeOrigin
                    canonical.module => call!.typeModule
                    canonical.symbol => call!.typeSymbol
                    call! => nodes[plan.callNode]
                }
        }
        # Publishing a stream stage's substituted result also changes its
        # downstream each role. Commit that edge before cloning any body:
        # a foreign stage parameter cannot be substituted by the caller.
        typeIds.enumPayloadEdges(resolved.types, resolved.references, prepared.package.ranges, prepared.package.symbols, resolved.referenceIndexByTypeAst) => rolePayloadEdges
        prepared -> semanticContext.ownedResourceSeeds(resolved.types) => roleResourceSeeds
        resolved.types -> typeIds.classifyWithResources(resolved.fields, rolePayloadEdges, roleResourceSeeds) => roleFlags
        nodes -> sealEachRoleTypes(prepared, resolved.types, roleFlags)
        [Int; ~] => planSlots!
        [Bool; ~] => selected!
        plans! -> each plan {
            -1 => slot!
            false => materialize!
            false => alreadyProcessed!
            plan.callNode >= 0 -> if { processed![plan.callNode] => alreadyProcessed! } else {
                instances! -> each instance {
                    instance.status == 0 and instance.interpolationNode == plan.interpolationNode
                        and instance.ownerFunction == plan.ownerFunction
                        -> if { true => alreadyProcessed! }
                }
            }
            not alreadyProcessed! and plan.status == 0
                -> if {
                    true => concrete!
                    plan.actualInputs -> each actual {
                        actual < 0 or actual >= (resolved.types -> len)
                            -> if {
                                false => concrete!
                            } else {
                                resolved.types[actual].containsParameter -> if { false => concrete! }
                            }
                    }
                    concrete! -> if {
                        -1 => valueArgument!
                        plan.callNode >= 0 -> if {
                            nodes[plan.callNode] -> explicitGenericValueIdentity(prepared) => valueArgument!
                        }
                        UInt64(plan.templateNode) * 65599 + UInt64(plan.resultType) => hash!
                        plan.actualInputs -> each actual {
                            hash! * 65599 + UInt64(actual) => hash!
                        }
                        hash! * 65599 => hash!
                        valueArgument! >= 0 -> if { hash! + UInt64(valueArgument!) + 1 => hash! }
                        heads! -> putIfAbsent(hash!, -1) => newBucket
                        heads![hash!] => candidate!
                        candidate! >= 0 and slot! < 0 -> while {
                            templates![candidate!] == plan.templateNode
                                and results![candidate!] == plan.resultType
                                and valueArguments![candidate!] == valueArgument!
                                and lengths![candidate!] == (plan.actualInputs -> len) => equal!
                            0 => argumentIndex!
                            equal! and argumentIndex! < (plan.actualInputs -> len)
                                -> while {
                                    arguments![starts![candidate!] + argumentIndex!] != plan.actualInputs[argumentIndex!]
                                        -> if { false => equal! }
                                    argumentIndex! + 1 => argumentIndex!
                                }
                            equal! -> if { candidate! => slot! }
                            next![candidate!] => candidate!
                        }
                        slot! < 0 -> if {
                            functions! -> len => slot!
                            next! -> push(heads![hash!])
                            templates! -> push(plan.templateNode)
                            results! -> push(plan.resultType)
                            valueArguments! -> push(valueArgument!)
                            starts! -> push(arguments! -> len)
                            lengths! -> push(plan.actualInputs -> len)
                            plan.actualInputs -> each actual { arguments! -> push(actual) }
                            heads! -> put(hash!, slot!)
                            functions! -> push(-1)
                            counts! -> push(0)
                            true => materialize!
                        }
                        plan.callNode >= 0 -> if { true => processed![plan.callNode] }
                    }
                }
            planSlots! -> push(slot!)
            selected! -> push(materialize!)
        }
        nodes -> materializeGenericProductFields(resolved.types, resolved.fields, plans!, selected!)
        typeIds.enumPayloadEdges(resolved.types, resolved.references, prepared.package.ranges, prepared.package.symbols, resolved.referenceIndexByTypeAst) => payloadEdges
        prepared -> semanticContext.ownedResourceSeeds(resolved.types) => resourceSeeds
        nodes -> materializeSelectedGenericBodies(resolved.types, resolved.fields, payloadEdges, resourceSeeds, plans!, selected!) => batch
        0 => instanceIndex!
        instanceIndex! < (batch -> len) -> while {
            batch[instanceIndex!] => instance
            planSlots![instanceIndex!] => slot
            slot >= 0 and instance.status == 0 -> if {
                instance.functionNode => functions![slot]
                instance.nodeCount => counts![slot]
            }
            instanceIndex! + 1 => instanceIndex!
        }
        0 => bindingIndex!
        bindingIndex! < (batch -> len) -> while {
            planSlots![bindingIndex!] => slot
            slot >= 0 -> if {
                batch[bindingIndex!] => instance!
                functions![slot] >= 0 -> if {
                    functions![slot] => instance!.functionNode
                    counts![slot] => instance!.nodeCount
                    0 => instance!.status
                    true => progress!
                }
                instances! -> push(instance!)
            }
            bindingIndex! + 1 => bindingIndex!
        }
        progress! -> if {
            # A concrete clone supplies numeric peers that the immutable template
            # could not decide. Seal its value contexts before publishing types.
            resolved.types -> typeIds.classifyWithResources(resolved.fields, payloadEdges, resourceSeeds) => numericFlags
            nodes -> sealFinalContextualNumericLiterals(prepared, resolved.types, numericFlags)
            nodes -> publishGenericCallTypes(instances!, prepared, resolved)
        }
    }
    instances!
}

relocateFunctionEdge edge: Int, start: Int, end: Int, destination: Int -> Int {
    edge >= start and edge < end -> if { destination + edge - start } else { edge }
}

# Materialize typed bodies separately from symbol/reachability publication.
# Failed substitutions never append a partial function. Classification runs
# once after all substitutions, rather than copying/classifying the arena for
# every node or instance.
public materializeGenericBodies nodes: mut [TypedIrNode; ~], types: mut [typeIds.SemanticType; ~], fields: ref [typeIds.NominalField; ~], plans: ref [GenericCallPlan; ~] -> [GenericFunctionInstance; ~] {
    [typeIds.PayloadEdge; ~] => payloadEdges
    [Bool; ~] => resourceSeeds
    [Bool; ~] => selected!
    0 => index!
    index! < (plans -> len) -> while {
        selected! -> push(true)
        index! + 1 => index!
    }
    nodes -> materializeSelectedGenericBodies(types, fields, payloadEdges, resourceSeeds, plans, selected!)
}

materializeSelectedGenericBodies nodes: mut [TypedIrNode; ~], types: mut [typeIds.SemanticType; ~], fields: ref [typeIds.NominalField; ~], payloadEdges: ref [typeIds.PayloadEdge; ~], resourceSeeds: ref [Bool; ~], plans: ref [GenericCallPlan; ~], selected: ref [Bool; ~] -> [GenericFunctionInstance; ~] {
    nodes -> len => originalCount
    [GenericFunctionInstance; ~] => instances!
    0 => selectionIndex!
    plans -> each plan {
        plan.status => status!
        not selected[selectionIndex!] -> if { 3 => status! }
        selectionIndex! + 1 => selectionIndex!
        -1 => instanceStart!
        0 => instanceCount!
        [TypedIrNode; ~] => body!
        status! == 0 -> if {
            plan.templateNode < 0 or plan.templateNode >= originalCount
                -> if { 2 => status! } else {
                    nodes[plan.templateNode].kind != 0 -> if { 2 => status! }
                }
        }
        status! == 0 -> if {
            plan.templateNode + 1 => end!
            true => bodyOpen!
            end! < originalCount and bodyOpen! and nodes[end!].kind != 0 and nodes[end!].kind != 11
                -> while {
                    # Function extent follows lexical ownership. A previously
                    # inlined declaration no longer supplies a kind0 delimiter.
                    nodes[end!].parent => bodyOwner!
                    bodyOwner! >= 0 and bodyOwner! != plan.templateNode
                        -> while { nodes[bodyOwner!].parent => bodyOwner! }
                    bodyOwner! == plan.templateNode
                        -> if { end! + 1 => end! } else { false => bodyOpen! }
                }
            nodes -> len => destination
            plan.templateNode => sourceIndex!
            sourceIndex! < end! and status! == 0 -> while {
                nodes[sourceIndex!] => node!
                node!.typeId >= 0 and node!.typeId < (types -> len)
                    -> if {
                        types[node!.typeId].containsParameter -> if {
                            types -> typeIds.specializeManyInto(plan.inputTemplates, plan.actualInputs, node!.typeId) => specialized
                            specialized.status == 0 and specialized.root >= 0
                                -> if {
                                    types[specialized.root] => canonical
                                    canonical.containsParameter -> if { 2 => status! } else {
                                        specialized.root => node!.typeId
                                        canonical.kind => node!.typeKind
                                        canonical.origin => node!.typeOrigin
                                        canonical.module => node!.typeModule
                                        canonical.symbol => node!.typeSymbol
                                    }
                                } else { 2 => status! }
                        }
                    }
                node!.parent -> relocateFunctionEdge(plan.templateNode, end!, destination) => node!.parent
                node!.operand0 -> relocateFunctionEdge(plan.templateNode, end!, destination) => node!.operand0
                node!.operand1 -> relocateFunctionEdge(plan.templateNode, end!, destination) => node!.operand1
                node!.nextOperand -> relocateFunctionEdge(plan.templateNode, end!, destination) => node!.nextOperand
                body! -> push(node!)
                sourceIndex! + 1 => sourceIndex!
            }
            status! == 0 -> if {
                destination => instanceStart!
                body! -> len => instanceCount!
                0 => appendIndex!
                appendIndex! < instanceCount! -> while {
                    nodes -> push(body![appendIndex!])
                    appendIndex! + 1 => appendIndex!
                }
            }
        }
        instances! -> push(GenericFunctionInstance {
            callNode: plan.callNode
            interpolationNode: plan.interpolationNode
            ownerFunction: plan.ownerFunction
            templateNode: plan.templateNode
            functionNode: instanceStart!
            nodeCount: instanceCount!
            status: status!
        })
    }
    types -> typeIds.classifyWithResources(fields, payloadEdges, resourceSeeds) => flags
    originalCount => classifyIndex!
    classifyIndex! < (nodes -> len) -> while {
        nodes[classifyIndex!] => node!
        node!.typeId >= 0 and node!.typeId < (flags -> len)
            -> if {
                flags[node!.typeId] => node!.typeFlags
                node! => nodes[classifyIndex!]
            }
        classifyIndex! + 1 => classifyIndex!
    }
    instances!
}

# Resolve calls only after concrete receiver/callee and operand linking. Keep
# each call's substitution separate from the immutable function template.
functionTemplatesBySymbol nodes: ref [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot -> [Int; ~] {
    [Int; ~] => functions!
    0 => symbolIndex!
    symbolIndex! < (prepared.package.symbols -> len)
        -> while {
            functions! -> push(-1)
            symbolIndex! + 1 => symbolIndex!
        }
    0 => functionIndex!
    functionIndex! < (nodes -> len) -> while {
        nodes[functionIndex!] => function
        function.kind == 0 and function.sourceModule >= 0
            and function.sourceModule < (prepared.package.ranges -> len)
            and function.symbol >= 0 -> if {
                prepared.package.ranges[function.sourceModule] => range
                function.symbol < range.symbolCount -> if {
                    functions![range.symbolStart + function.symbol] < 0
                        -> if {
                            functionIndex! => functions![range.symbolStart + function.symbol]
                        }
                }
            }
        functionIndex! + 1 => functionIndex!
    }
    functions!
}

public isDiagnosticTrackFunction function: TypedIrNode, prepared: ref semanticContext.SemanticSnapshot -> Bool {
    function => declaration!
    function.sourceModule => declaration!.targetModule
    (declaration! -> resolvedDeclaredRuntimeOpcode(prepared)) == -325
}

# A runtime Task owns its control/context independently of the async result.
# Diagnostic track's generic argument is that owner, not its result payload.
canonicalTaskArgumentType argument: TypedIrNode, nodes: ref [TypedIrNode; ~], types: mut [typeIds.SemanticType; ~] -> Int {
    not (argument -> isAsyncTaskValue(nodes)) -> if { argument.typeId -> return }
    argument.typeId < 0 or argument.typeId >= (types -> len)
        -> if { argument.typeId -> return }
    types[argument.typeId] => payload
    payload.kind == 7 and payload.origin == 4 and payload.symbol == 2
        -> if { argument.typeId -> return }
    0 => typeIndex!
    typeIndex! < (types -> len) -> while {
        types[typeIndex!] => candidate
        candidate.kind == 7 and candidate.origin == 4 and candidate.symbol == 2
            and candidate.first == argument.typeId -> if { typeIndex! -> return }
        typeIndex! + 1 => typeIndex!
    }
    types -> len => taskTypeId
    types -> push(typeIds.SemanticType {
        kind: 7
        origin: 4
        module: -1
        symbol: 2
        first: argument.typeId
        second: -1
        length: 0
        lengthHash: 0
        containsParameter: payload.containsParameter
        status: payload.status
    })
    taskTypeId
}

struct MaterializedTaskProduct {
    sourceType: Int
    productType: Int
}

# Runtime async calls retain their payload type for worker emission. A stored
# structural field owns the materialized Task instead. Intern a separate shape
# so an ordinary product with the same payload types keeps its original ABI.
public sealMaterializedTaskProducts nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, resolved: mut expressionTypeIds.ExpressionTypeIdSet -> Bool {
    [MaterializedTaskProduct; ~] => shapes!
    true => progress!
    progress! -> while {
        false => progress!
        [Int; ~] => changed!
        0 => productIndex!
        productIndex! < (nodes -> len) -> while {
            nodes[productIndex!] => product!
            (product!.kind == 12 or product!.kind == 35) and product!.typeKind == 10
                and product!.typeId >= 0 and product!.operand0 >= 0
                -> if {
                    [Int; ~] => fieldTypes!
                    false => materialized!
                    product!.operand0 => fieldIndex!
                    fieldIndex! >= 0 and fieldIndex! < (nodes -> len)
                        -> while {
                            nodes[fieldIndex!] => field
                            -1 => fieldType!
                            not (field -> typedNodeIsAwaitSource(prepared))
                                and (field -> isAsyncTaskValue(nodes)) -> if {
                                    field -> canonicalTaskArgumentType(nodes, resolved.types) => fieldType!
                                }
                            shapes! -> each shape {
                                field.typeId == shape.productType -> if { field.typeId => fieldType! }
                            }
                            fieldType! >= 0 -> if { true => materialized! }
                            fieldTypes! -> push(fieldType!)
                            field.nextOperand => fieldIndex!
                        }
                    materialized! -> if {
                        [Int; ~] => fieldIndices!
                        0 => ordinalInit!
                        ordinalInit! < (fieldTypes! -> len) -> while {
                            fieldIndices! -> push(-1)
                            ordinalInit! + 1 => ordinalInit!
                        }
                        0 => sourceFieldIndex!
                        sourceFieldIndex! < (resolved.fields -> len) -> while {
                            resolved.fields[sourceFieldIndex!] => sourceField
                            sourceField.ownerType == product!.typeId and sourceField.status == 0
                                and sourceField.ordinal >= 0 and sourceField.ordinal < Int(fieldTypes! -> len)
                                -> if {
                                    sourceFieldIndex! => fieldIndices![sourceField.ordinal]
                                }
                            sourceFieldIndex! + 1 => sourceFieldIndex!
                        }
                        true => ready!
                        false => differs!
                        0 => fieldOrdinal!
                        fieldOrdinal! < (fieldTypes! -> len) -> while {
                            fieldIndices![fieldOrdinal!] < 0 -> if { false => ready! } else {
                                resolved.fields[fieldIndices![fieldOrdinal!]].fieldType => oldFieldType
                                fieldTypes![fieldOrdinal!] < 0 -> if { oldFieldType => fieldTypes![fieldOrdinal!] }
                                fieldTypes![fieldOrdinal!] != oldFieldType -> if { true => differs! }
                            }
                            fieldOrdinal! + 1 => fieldOrdinal!
                        }
                        ready! and differs! -> if {
                            product!.typeId => sourceType!
                            shapes! -> each shape {
                                shape.productType == product!.typeId -> if { shape.sourceType => sourceType! }
                            }
                            -1 => productType!
                            shapes! -> each shape {
                                shape.sourceType == sourceType! -> if {
                                    0 => matches!
                                    resolved.fields -> each candidate {
                                        candidate.ownerType == shape.productType and candidate.status == 0
                                            and candidate.ordinal >= 0 and candidate.ordinal < Int(fieldTypes! -> len)
                                            and candidate.fieldType == fieldTypes![candidate.ordinal]
                                            -> if { matches! + 1 => matches! }
                                    }
                                    matches! == Int(fieldTypes! -> len) -> if { shape.productType => productType! }
                                }
                            }
                            productType! < 0 -> if {
                                resolved.types -> len => productType!
                                resolved.types[product!.typeId] => productTypeValue
                                resolved.types -> push(productTypeValue)
                                0 => copyOrdinal!
                                copyOrdinal! < (fieldTypes! -> len) -> while {
                                    resolved.fields[fieldIndices![copyOrdinal!]] => copied!
                                    productType! => copied!.ownerType
                                    fieldTypes![copyOrdinal!] => copied!.fieldType
                                    resolved.fields -> push(copied!)
                                    copyOrdinal! + 1 => copyOrdinal!
                                }
                                shapes! -> push(MaterializedTaskProduct { sourceType: sourceType!, productType: productType! })
                            }
                            productType! => product!.typeId
                            product! => nodes[productIndex!]
                            changed! -> push(productIndex!)
                            true => progress!
                        }
                    }
                }
            productIndex! + 1 => productIndex!
        }
        progress! -> if {
            typeIds.enumPayloadEdges(resolved.types, resolved.references, prepared.package.ranges, prepared.package.symbols, resolved.referenceIndexByTypeAst) => edges
            prepared -> semanticContext.ownedResourceSeeds(resolved.types) => seeds
            typeIds.classifyWithResources(resolved.types, resolved.fields, edges, seeds) => flags
            changed! -> each index {
                nodes[index] => product!
                product! -> sealNodeTypeIdentity(product!.typeId, resolved.types, flags)
                product! => nodes[index]
            }
            nodes -> sealLateTypes(prepared, resolved, resolved.types, flags)
            nodes -> sealStructuralProductMembers(prepared, resolved, resolved.types, flags)
            nodes -> sealLateTypes(prepared, resolved, resolved.types, flags)
        }
    }
    (shapes! -> len) > 0
}

public planGenericCalls nodes: ref [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~] -> [GenericCallPlan; ~] {
    nodes -> functionTemplatesBySymbol(prepared) => functions
    nodes -> planGenericCallsWithTemplates(prepared, types, prepared.semantic.references, functions)
}

public planResolvedGenericCalls nodes: ref [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, resolved: mut expressionTypeIds.ExpressionTypeIdSet -> [GenericCallPlan; ~] {
    nodes -> functionTemplatesBySymbol(prepared) => functions
    nodes -> planGenericCallsWithTemplates(prepared, resolved.types, resolved.references, functions)
}

planGenericCallsWithTemplates nodes: ref [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], references: ref [typeIds.TypeReference; ~], functions: ref [Int; ~] -> [GenericCallPlan; ~] {
    [GenericCallPlan; ~] => plans!
    0 => callIndex!
    callIndex! < (nodes -> len) -> while {
        nodes[callIndex!] => call
        -1 => target!
        call.kind == 6 and call.targetModule >= 0
            and call.targetModule < (prepared.package.ranges -> len)
            and call.symbol >= 0 -> if {
                prepared.package.ranges[call.targetModule] => range
                call.symbol < range.symbolCount -> if {
                    functions[range.symbolStart + call.symbol] => target!
                }
            }
        target! >= 0 -> if {
            nodes[target!] => function
            (nodes -> functionSignatureContainsParameter(types, target!))
                or (function -> functionDeclaresGenericParameters(prepared.package.ranges, prepared.package.symbols))
                -> if {
                    [Int; ~] => templates!
                    [Int; ~] => actuals!
                    # Explicit applications bind declaration parameters even if
                    # no value input or result mentions them. Use canonical type
                    # references; runtime code must never parse source spellings.
                    call.sourceModule >= 0 and call.sourceModule < (prepared.package.ranges -> len)
                        and call.astNode >= 0 -> if {
                            prepared.package.ranges[call.sourceModule] => callRange
                            call.astNode < callRange.astCount -> if {
                                prepared.package.nodes[callRange.astStart + call.astNode] => callAst
                                callAst.cstRuleId == grammar.ruleIdTypeApplicationExpression()
                                    -> if {
                                        prepared.package.ranges[function.sourceModule] => targetRange
                                        [Int; ~] => explicitTypes!
                                        0 => childIndex!
                                        childIndex! < callRange.astCount -> while {
                                            prepared.package.nodes[callRange.astStart + childIndex!] => child
                                            child.parent == call.astNode and child.kind == 12
                                                -> if {
                                                    -1 => actualType!
                                                    references -> each reference {
                                                        reference.sourceModule == call.sourceModule and reference.typeAst == childIndex!
                                                            and reference.status == 0 -> if { reference.typeId => actualType! }
                                                    }
                                                    explicitTypes! -> push(actualType!)
                                                }
                                            childIndex! + 1 => childIndex!
                                        }
                                        0 => genericIndex!
                                        0 => explicitIndex!
                                        genericIndex! < targetRange.symbolCount -> while {
                                            prepared.package.symbols[targetRange.symbolStart + genericIndex!] => parameter
                                            parameter.kind == 32 and parameter.parent == function.symbol
                                                -> if {
                                                    explicitIndex! < (explicitTypes! -> len) -> if {
                                                        -1 => parameterType!
                                                        0 => typeIndex!
                                                        typeIndex! < (types -> len) and parameterType! < 0
                                                            -> while {
                                                                types[typeIndex!] => candidate
                                                                candidate.kind == 1 and candidate.origin == 3
                                                                    and candidate.module == function.sourceModule and candidate.symbol == genericIndex!
                                                                    -> if { typeIndex! => parameterType! }
                                                                typeIndex! + 1 => typeIndex!
                                                            }
                                                        parameterType! < 0 -> if {
                                                            types -> len => parameterType!
                                                            types -> push(typeIds.SemanticType { kind: 1, origin: 3, module: function.sourceModule, symbol: genericIndex!, first: -1, second: -1, length: -1, lengthHash: 0, containsParameter: true, status: 0 })
                                                        }
                                                        templates! -> push(parameterType!)
                                                        actuals! -> push(explicitTypes![explicitIndex!])
                                                    }
                                                    explicitIndex! + 1 => explicitIndex!
                                                }
                                            genericIndex! + 1 => genericIndex!
                                        }
                                    }
                            }
                        }
                    function.operand1 => templateIndex!
                    0 => templateOrdinal!
                    templateIndex! >= 0 and templateIndex! < (nodes -> len)
                        and templateOrdinal! < (nodes -> len) -> while {
                            nodes[templateIndex!] => parameter
                            not (parameter -> isHiddenValueInput(prepared))
                                -> if { templates! -> push(parameter.typeId) }
                            templateOrdinal! == 0 -> if {
                                function.nextOperand => templateIndex!
                            } else { parameter.nextOperand => templateIndex! }
                            templateOrdinal! + 1 => templateOrdinal!
                        }
                    false => taskArgumentIdentityChanged!
                    call.operand0 => argumentIndex!
                    0 => argumentOrdinal!
                    argumentIndex! >= 0 and argumentIndex! < (nodes -> len)
                        and argumentOrdinal! < (templates! -> len) -> while {
                            nodes[argumentIndex!] => argument
                            argument.typeId => actualTypeId!
                            (call -> resolvedDeclaredRuntimeOpcode(prepared)) == -325
                                -> if { argument -> canonicalTaskArgumentType(nodes, types) => actualTypeId! }
                            actualTypeId! != argument.typeId -> if { true => taskArgumentIdentityChanged! }
                            actuals! -> push(actualTypeId!)
                            argumentOrdinal! == 0 -> if {
                                call.operand1 => argumentIndex!
                            } else { argument.nextOperand => argumentIndex! }
                            argumentOrdinal! + 1 => argumentOrdinal!
                        }
                    # Callback result inference commits the call's canonical result
                    # before body materialization. Reuse it as a type constraint so
                    # a result-only parameter is specialized in the whole body.
                    not taskArgumentIdentityChanged!
                        and function.typeId >= 0 and function.typeId < (types -> len)
                        and types[function.typeId].containsParameter
                        and call.typeId >= 0 and call.typeId < (types -> len)
                        and not types[call.typeId].containsParameter
                        -> if {
                            templates! -> push(function.typeId)
                            actuals! -> push(call.typeId)
                        }
                    types -> typeIds.specializeManyInto(templates!, actuals!, function.typeId) => specialized
                    plans! -> push(GenericCallPlan {
                        callNode: callIndex!
                        interpolationNode: -1
                        ownerFunction: -1
                        templateNode: target!
                        inputTemplates: templates!
                        actualInputs: actuals!
                        resultType: specialized.root
                        status: specialized.status
                    })
                }
        }
        callIndex! + 1 => callIndex!
    }
    plans!
}

# Synthetic interpolation calls share the ordinary generic body materializer.
# Their source identity remains separate from an emitted Typed IR call index.
# A generic interpolation call belongs to a concrete caller body, not only to
# its shared source node. Preserve that identity when specializing its inputs.
appendContextualInterpolationGenericPlans nodes: ref [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, resolved: mut expressionTypeIds.ExpressionTypeIdSet, plans: mut [GenericCallPlan; ~], sourceModule: Int, interpolationNode: Int, target: Int, templates: ref [Int; ~], actuals: ref [Int; ~] -> Unit {
    false => needsContext!
    actuals -> each actual {
        actual >= 0 and resolved.types[actual].containsParameter
            -> if { true => needsContext! }
    }
    not needsContext! -> if { return }
    prepared.interpolations[interpolationNode] => call
    call.ownerSymbol => ownerSymbol!
    ownerSymbol! < 0 and call.operand0 >= 0
        -> if { prepared.interpolations[call.operand0].ownerSymbol => ownerSymbol! }
    prepared.package.ranges[sourceModule] => range
    ownerSymbol! < 0 or ownerSymbol! >= range.symbolCount
        -> if { return }
    prepared.package.symbols[range.symbolStart + ownerSymbol!].astNode => ownerAst!
    ownerAst! >= 0 -> while {
        prepared.package.nodes[range.astStart + ownerAst!] => owner
        owner.kind == 7 or owner.kind == 31 -> if { break }
        owner.parent => ownerAst!
    }
    ownerAst! < 0 -> if { return }
    -1 => templateOwner!
    0 => nodeIndex!
    nodeIndex! < (nodes -> len) and templateOwner! < 0
        -> while {
            nodes[nodeIndex!] => node
            node.kind == 0 and node.sourceModule == sourceModule and node.astNode == ownerAst!
                -> if { nodeIndex! => templateOwner! }
            nodeIndex! + 1 => nodeIndex!
        }
    templateOwner! < 0 -> if { return }
    [Int; ~] => ownerTemplates!
    nodes -> appendGenericInputTypes(templateOwner!, ownerTemplates!, prepared)
    0 => ownerIndex!
    ownerIndex! < (nodes -> len) -> while {
        nodes[ownerIndex!] => owner
        ownerIndex! != templateOwner! and owner.kind == 0
            and owner.sourceModule == sourceModule and owner.astNode == ownerAst!
            -> if {
                [Int; ~] => ownerActuals!
                nodes -> appendGenericInputTypes(ownerIndex!, ownerActuals!, prepared)
                (ownerTemplates! -> len) == (ownerActuals! -> len) => concrete!
                ownerActuals! -> each actual {
                    actual < 0 -> if { false => concrete! } else {
                        resolved.types[actual].containsParameter -> if { false => concrete! }
                    }
                }
                concrete! -> if {
                    [Int; ~] => specializedActuals!
                    actuals -> each actual {
                        resolved.types -> typeIds.specializeManyInto(ownerTemplates!, ownerActuals!, actual) => specialized
                        specialized.status != 0 or specialized.root < 0
                            -> if { false => concrete! }
                        specializedActuals! -> push(specialized.root)
                    }
                    not concrete! -> if {
                        ownerIndex! + 1 => ownerIndex!
                        continue
                    }
                    [Int; ~] => inputTemplates!
                    templates -> each template { inputTemplates! -> push(template) }
                    resolved.types -> typeIds.specializeManyInto(inputTemplates!, specializedActuals!, nodes[target].typeId) => result
                    plans -> push(GenericCallPlan {
                        callNode: -1
                        interpolationNode: interpolationNode
                        ownerFunction: ownerIndex!
                        templateNode: target
                        inputTemplates: inputTemplates!
                        actualInputs: specializedActuals!
                        resultType: result.root
                        status: result.status
                    })
                }
            }
        ownerIndex! + 1 => ownerIndex!
    }
}

appendGenericInputTypes nodes: ref [TypedIrNode; ~], functionIndex: Int, destination: mut [Int; ~], prepared: ref semanticContext.SemanticSnapshot -> Unit {
    nodes[functionIndex] => function
    function.operand1 => parameterIndex!
    0 => ordinal!
    parameterIndex! >= 0 -> while {
        nodes[parameterIndex!] => parameter
        not (parameter -> isHiddenValueInput(prepared))
            -> if { destination -> push(parameter.typeId) }
        ordinal! == 0 -> if { function.nextOperand => parameterIndex! } else { parameter.nextOperand => parameterIndex! }
        ordinal! + 1 => ordinal!
    }
}

appendInterpolationGenericCalls nodes: ref [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, resolved: mut expressionTypeIds.ExpressionTypeIdSet, plans: mut [GenericCallPlan; ~], functions: ref [Int; ~] -> Unit {
    prepared.interpolationRanges -> each sourceRange {
        0 => offset!
        offset! < sourceRange.nodeCount -> while {
            sourceRange.nodeStart + offset! => callIndex
            prepared.interpolations[callIndex] => call
            resolved.interpolationMethodByNode[callIndex] => method
            method.status >= 0 -> if {
                expressionTypeIds.InterpolationFunctionTarget { sourceModule: method.sourceModule, symbol: method.symbol }
            } else {
                prepared -> expressionTypeIds.interpolationFunctionTarget(sourceRange.sourceModule, callIndex)
            } => declaration
            (call.kind == 8 or call.kind == 10
                or (call.kind == 6 and resolved.interpolationMethodByNode[callIndex].status == 0))
                and declaration.sourceModule >= 0 and declaration.symbol >= 0
                and method.status <= 0
                -> if {
                    -1 => target!
                    prepared.package.ranges[declaration.sourceModule] => range
                    declaration.symbol < range.symbolCount
                        -> if {
                            functions[range.symbolStart + declaration.symbol] => target!
                        }
                    target! >= 0 -> if {
                        nodes[target!] => function
                        nodes -> functionSignatureContainsParameter(resolved.types, target!)
                            -> if {
                                [Int; ~] => templates!
                                [Int; ~] => actuals!
                                function.operand1 => parameterIndex!
                                0 => ordinal!
                                parameterIndex! >= 0 -> while {
                                    nodes[parameterIndex!] => parameter
                                    not (parameter -> isHiddenValueInput(prepared))
                                        -> if { templates! -> push(parameter.typeId) }
                                    ordinal! == 0 -> if { function.nextOperand => parameterIndex! } else { parameter.nextOperand => parameterIndex! }
                                    ordinal! + 1 => ordinal!
                                }
                                sourceRange.nodeStart => argumentIndex!
                                argumentIndex! < sourceRange.nodeStart + sourceRange.nodeCount
                                    -> while {
                                        prepared.interpolations[argumentIndex!].parent == callIndex
                                            -> if {
                                                prepared -> expressionTypeIds.preIrInterpolationReceiverTypeId(resolved.types, resolved.references, resolved.referenceIndexByTypeAst, resolved.interpolationLexicalTypeByNode, resolved.interpolationMemberTypeByNode, resolved.interpolationIndexedTypeByNode, resolved.interpolationContextualStructTypeByNode, resolved.interpolationCallTypeByNode, sourceRange.sourceModule, argumentIndex!) => actual!
                                                actual! < 0 and prepared.interpolations[argumentIndex!].kind == 1
                                                    -> if {
                                                        prepared.interpolations[argumentIndex!].symbol => inputSymbol
                                                        0 => inputIndex!
                                                        inputIndex! < (nodes -> len) and actual! < 0 -> while {
                                                            nodes[inputIndex!] => input
                                                            input.kind == 10 and input.sourceModule == sourceRange.sourceModule
                                                                and input.symbol == inputSymbol and input.typeId >= 0
                                                                -> if { input.typeId => actual! }
                                                            inputIndex! + 1 => inputIndex!
                                                        }
                                                    }
                                                actuals! -> push(actual!)
                                            }
                                        argumentIndex! + 1 => argumentIndex!
                                    }
                                nodes -> appendContextualInterpolationGenericPlans(prepared, resolved, plans, sourceRange.sourceModule, callIndex, target!, templates!, actuals!)
                                resolved.types -> typeIds.specializeManyInto(templates!, actuals!, function.typeId) => specialized
                                plans -> push(GenericCallPlan {
                                    callNode: -1
                                    interpolationNode: callIndex
                                    ownerFunction: -1
                                    templateNode: target!
                                    inputTemplates: templates!
                                    actualInputs: actuals!
                                    resultType: specialized.root
                                    status: specialized.status
                                })
                            }
                    }
                }
            offset! + 1 => offset!
        }
    }
}

# A runtime member chain rooted in a local value remains local through every
# contiguous projection. Build that identity once from exact resolved symbols
# and AST parent edges; consumers must not rediscover it by spelling.
localMemberRoots prepared: ref semanticContext.SemanticSnapshot, resolvedNames: ref [resolution.ResolvedName; ~], sourceIndex: Int -> [Bool; ~] {
    prepared.package.ranges[sourceIndex] => sourceRange
    [Bool; ~] => localByAst!
    0 => astSeed!
    astSeed! < sourceRange.astCount -> while {
        localByAst! -> push(false)
        astSeed! + 1 => astSeed!
    }
    0 => nameIndex!
    nameIndex! < (resolvedNames -> len)
        -> while {
            resolvedNames[nameIndex!] => resolvedName
            resolvedName.astNode >= 0 and resolvedName.astNode < sourceRange.astCount
                and resolvedName.symbol >= 0 and resolvedName.symbol < sourceRange.symbolCount
                -> if {
                    prepared.package.nodes[sourceRange.astStart + resolvedName.astNode].parent => parentAst
                    parentAst >= 0 and parentAst < sourceRange.astCount
                        -> if {
                            prepared.package.symbols[sourceRange.symbolStart + resolvedName.symbol].kind => symbolKind
                            symbolKind == 9 or symbolKind == 35 or symbolKind == 50 or symbolKind == 51
                                -> if { true => localByAst![parentAst] }
                        }
                }
            nameIndex! + 1 => nameIndex!
        }
    sourceRange.astCount => memberIndex!
    memberIndex! > 0
        -> while {
            memberIndex! - 1 => memberIndex!
            localByAst![memberIndex!] -> if {
                prepared.package.nodes[sourceRange.astStart + memberIndex!] => member
                member.parent >= 0 and member.parent < sourceRange.astCount
                    -> if {
                        prepared.package.nodes[sourceRange.astStart + member.parent] => parent
                        member.kind == 36 and parent.kind == 36
                            and member.start == parent.start and member.length < parent.length
                            -> if { true => localByAst![member.parent] }
                    }
            }
        }
    localByAst!
}

# Restore the two canonical edges of indexed control-producer wrappers from
# the following control's exact subject. Parent adjacency is indexed once, so
# this final graph stitch is linear in IR size rather than wrapper-by-node.
repairIndexedControlProducerWrappers nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot -> Unit {
    [Int; ~] => firstChild!
    [Int; ~] => nextSibling!
    0 => seed!
    seed! < (nodes -> len) -> while {
        firstChild! -> push(-1)
        nextSibling! -> push(-1)
        seed! + 1 => seed!
    }
    0 => childIndex!
    childIndex! < (nodes -> len) -> while {
        nodes[childIndex!].parent => parent
        parent >= 0 and parent < (nodes -> len) -> if {
            firstChild![parent] => nextSibling![childIndex!]
            childIndex! => firstChild![parent]
        }
        childIndex! + 1 => childIndex!
    }
    0 => wrapperIndex!
    wrapperIndex! < (nodes -> len) -> while {
        nodes[wrapperIndex!] => wrapper!
        wrapper!.sourceModule >= 0
            and wrapper!.sourceModule < (prepared.package.ranges -> len)
            -> if {
                prepared.package.ranges[wrapper!.sourceModule] => sourceRange
                wrapper!.astNode >= 0 and wrapper!.astNode < sourceRange.astCount
                    and prepared.controlProducerWrapperByAst[sourceRange.astStart + wrapper!.astNode]
                    -> if {
                        firstChild![wrapperIndex!] => controlChild!
                        -1 => controlIndex!
                        controlChild! >= 0 -> while {
                            nodes[controlChild!] => child
                            child.kind == 18 or child.kind == 27
                                or child.kind == 33 or child.kind == 34
                                -> if { controlChild! => controlIndex! }
                            nextSibling![controlChild!] => controlChild!
                        }
                        controlIndex! >= 0
                            and nodes[controlIndex!].operand0 >= 0
                            and nodes[controlIndex!].operand0 < (nodes -> len)
                            and nodes[nodes[controlIndex!].operand0].parent == wrapperIndex!
                            -> if {
                                nodes[controlIndex!].operand0 => wrapper!.operand0
                                controlIndex! => wrapper!.operand1
                                wrapper! => nodes[wrapperIndex!]
                            }
                    }
            }
        wrapperIndex! + 1 => wrapperIndex!
    }
}

# A role read must survive lowering even when its collection is a late-typed
# enum payload projection. Seal it from that exact role's source after payload
# fields are known; an enclosing pattern binding is a different symbol.
sealEachRoleTypes nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], flags: ref [Int; ~] -> Unit {
    [Int; ~] => elementByRoleNode!
    0 => seed!
    seed! < (nodes -> len) -> while {
        elementByRoleNode! -> push(-1)
        seed! + 1 => seed!
    }
    0 => roleIndex!
    roleIndex! < (nodes -> len) -> while {
        nodes[roleIndex!] => role
        role.kind == 6 and (role.opcode -> isDirectIterationOpcode)
            and role.operand0 >= 0 and role.astNode >= 0
            -> if {
                nodes[role.operand0].typeId => collectionType!
                collectionType! >= 0 -> if {
                    types[collectionType!].kind == 8
                        -> if { types[collectionType!].first => collectionType! }
                }
                collectionType! >= 0 -> if {
                    types[collectionType!] => collection
                    -1 => element!
                    # A stream call's result is already its element type. Follow
                    # only value aliases to its declaration before interpreting
                    # an array-shaped element as an ordinary collection.
                    role.operand0 => producer!
                    0 => producerSteps!
                    producer! >= 0 and producer! < (nodes -> len)
                        and producerSteps! < (nodes -> len)
                        and (nodes[producer!].kind == 5 or nodes[producer!].kind == 17)
                        -> while {
                            nodes[producer!].operand0 => producer!
                            producerSteps! + 1 => producerSteps!
                        }
                    false => streamProducer!
                    producer! >= 0 and producer! < (nodes -> len)
                        -> if {
                            nodes[producer!] => producer
                            producer.kind == 6 and producer.targetModule >= 0
                                and producer.targetModule < (prepared.package.ranges -> len)
                                and producer.symbol >= 0 -> if {
                                    prepared.package.ranges[producer.targetModule] => producerRange
                                    producer.symbol < producerRange.symbolCount -> if {
                                        prepared.package.symbols[producerRange.symbolStart + producer.symbol] => declaration
                                        declaration.flags / 64 % 2 == 1 -> if {
                                            true => streamProducer!
                                            producer.typeId => element!
                                        }
                                    }
                                }
                        }
                    not streamProducer! -> if {
                        collection.kind >= 2 and collection.kind <= 4
                            -> if { collection.first => element! }
                        collection.kind == 1 and collection.origin == 1
                            and collection.symbol == 25
                            -> if { 2 => element! }
                    }
                    role.opcode == repeatOpcode() -> if { 2 => element! }
                    element! => elementByRoleNode![roleIndex!]
                }
            }
        roleIndex! + 1 => roleIndex!
    }
    0 => readIndex!
    readIndex! < (nodes -> len) -> while {
        nodes[readIndex!] => read!
        read!.kind == 5 and read!.symbol >= 0 -> if {
            prepared.package.ranges[read!.sourceModule] => sourceRange
            prepared.package.symbols[sourceRange.symbolStart + read!.symbol] => symbol
            symbol.kind == 35 and symbol.astNode >= 0 -> if {
                # Generic bodies share source AST ordinals, but each role
                # belongs to its own cloned lexical iteration scope.
                read!.parent => owner!
                0 => ownerSteps!
                -1 => element!
                owner! >= 0 and owner! < (nodes -> len)
                    and ownerSteps! < (nodes -> len) and element! < 0
                    -> while {
                        nodes[owner!] => scope
                        scope.sourceModule == read!.sourceModule
                            and scope.astNode == symbol.astNode
                            -> if { elementByRoleNode![owner!] => element! }
                        scope.parent => owner!
                        ownerSteps! + 1 => ownerSteps!
                    }
                element! >= 0 -> if {
                    read! -> sealNodeTypeIdentity(element!, types, flags)
                    read! => nodes[readIndex!]
                }
            }
        }
        readIndex! + 1 => readIndex!
    }
}

sealNodeTypeIdentity node: mut TypedIrNode, typeId: Int, types: ref [typeIds.SemanticType; ~], flags: ref [Int; ~] -> Unit {
    types[typeId] => canonical
    typeId => node.typeId
    canonical.kind => node.typeKind
    canonical.origin => node.typeOrigin
    canonical.module => node.typeModule
    canonical.symbol => node.typeSymbol
    flags[typeId] => node.typeFlags
}

builtinTypeId symbol: Int, types: ref [typeIds.SemanticType; ~] -> Int {
    -1 => typeId!
    0 => typeIndex!
    typeIndex! < (types -> len) and typeId! < 0
        -> while {
            types[typeIndex!] => candidate
            candidate.status == 0 and candidate.kind == 1
                and candidate.origin == 1 and candidate.symbol == symbol
                -> if { typeIndex! => typeId! }
            typeIndex! + 1 => typeIndex!
        }
    typeId!
}

# Operator topology can be repaired after the initial expression lowering.
# Seal the result from the canonical operator identity, not from either operand.
sealBooleanOperatorTypes results: mut [TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], flags: ref [Int; ~] -> Unit {
    23 -> builtinTypeId(types) => boolTypeId
    boolTypeId >= 0 -> if {
        0 => operatorIndex!
        operatorIndex! < (results -> len) -> while {
            results[operatorIndex!] => operator!
            (operator!.kind == 7 and operator!.opcode == -26)
                or (operator!.kind == 8
                and (operator!.opcode == grammar.tokenIdEqualEqual()
                or operator!.opcode == grammar.tokenIdBangEqual()
                or (operator!.opcode >= grammar.tokenIdLessEqual()
                and operator!.opcode <= grammar.tokenIdGreater())
                or operator!.opcode == -24
                or operator!.opcode == -25))
                -> if {
                    operator! -> sealNodeTypeIdentity(boolTypeId, types, flags)
                    operator! => results[operatorIndex!]
                }
            operatorIndex! + 1 => operatorIndex!
        }
    }
}

# A nested numeric subject can become canonical only after its enclosing enum
# payload is sealed. The lexical flow edge is still exact: the subject value's
# nextOperand names the subject-when control. Use that edge once, reject
# ambiguity, and never fall back to spelling, proximity, or type equality.
sealLateNumericSubjectControls results: mut [TypedIrNode; ~], types: ref [typeIds.SemanticType; ~] -> Unit {
    0 => controlIndex!
    controlIndex! < (results -> len) -> while {
        results[controlIndex!] => control!
        control!.kind == 34 and control!.operand0 < 0
            -> if {
                -1 => subjectIndex!
                false => ambiguous!
                0 => candidateIndex!
                candidateIndex! < (results -> len) -> while {
                    results[candidateIndex!] => candidate
                    false => integerCandidate!
                    candidate.typeId >= 0 and candidate.typeId < (types -> len)
                        -> if {
                            types[candidate.typeId] => candidateType
                            candidateType.kind == 1 and candidateType.origin == 1
                                and ((candidateType.symbol >= 2 and candidateType.symbol <= 14)
                                or (candidateType.symbol >= 19 and candidateType.symbol <= 23))
                                -> if { true => integerCandidate! }
                        }
                    candidate.sourceModule == control!.sourceModule
                        and candidate.nextOperand == controlIndex!
                        and integerCandidate!
                        -> if {
                            subjectIndex! >= 0 -> if { true => ambiguous! } else { candidateIndex! => subjectIndex! }
                        }
                    candidateIndex! + 1 => candidateIndex!
                }
                subjectIndex! >= 0 and not ambiguous! -> if {
                    subjectIndex! => control!.operand0
                    control! => results[controlIndex!]
                }
            }
        controlIndex! + 1 => controlIndex!
    }
}

# Comparison operands are values, never structural regions, assignments, or
# bindings. Keep this whitelist shared by both direct and reverse edge repair.
isComparisonOperandValue node: TypedIrNode -> Bool {
    node.kind == 2
        or node.kind == 3
        or node.kind == 4
        or node.kind == 5
        or node.kind == 6
        or node.kind == 7
        or node.kind == 8
        or node.kind == 9
        or node.kind == 10
        or node.kind == 12
        or node.kind == 13
        or node.kind == 14
        or node.kind == 15
        or node.kind == 16
        or node.kind == 18
        or node.kind == 26
        or node.kind == 27
        or node.kind == 34
}

# Once a late subject control is sealed, complete each structural comparison
# from its exact arm-local continuation edge. A valid preexisting right operand
# wins; otherwise accept only one direct nextOperand edge in either direction.
sealLateNumericSubjectConditionOperands results: mut [TypedIrNode; ~] -> Unit {
    0 => conditionIndex!
    conditionIndex! < (results -> len) -> while {
        results[conditionIndex!] => condition!
        condition!.kind == 8
            and condition!.parent >= 0
            and condition!.parent < (results -> len)
            and results[condition!.parent].kind == 19
            and results[condition!.parent].parent >= 0
            and results[condition!.parent].parent < (results -> len)
            and results[results[condition!.parent].parent].kind == 34
            -> if {
                results[condition!.parent].parent => controlIndex
                results[controlIndex].operand0 => subjectIndex
                condition!.operand1 => rightIndex!
                rightIndex! < 0 and condition!.operand0 >= 0 and condition!.operand0 != subjectIndex
                    -> if { condition!.operand0 => rightIndex! }
                rightIndex! < 0 -> if {
                    -1 => childIndex!
                    false => ambiguousChild!
                    0 => candidateIndex!
                    candidateIndex! < (results -> len) -> while {
                        results[candidateIndex!].parent == conditionIndex!
                            and (results[candidateIndex!] -> isComparisonOperandValue)
                            -> if {
                                childIndex! >= 0 -> if { true => ambiguousChild! } else { candidateIndex! => childIndex! }
                            }
                        candidateIndex! + 1 => candidateIndex!
                    }
                    childIndex! >= 0 and not ambiguousChild! -> if { childIndex! => rightIndex! }
                }
                rightIndex! < 0
                    and condition!.nextOperand >= 0
                    and condition!.nextOperand < (results -> len)
                    and results[condition!.nextOperand].parent == condition!.parent
                    and (results[condition!.nextOperand] -> isComparisonOperandValue)
                    -> if { condition!.nextOperand => rightIndex! }
                rightIndex! < 0 -> if {
                    -1 => predecessorIndex!
                    false => ambiguous!
                    0 => candidateIndex!
                    candidateIndex! < (results -> len) -> while {
                        results[candidateIndex!].parent == condition!.parent
                            and results[candidateIndex!].nextOperand == conditionIndex!
                            and (results[candidateIndex!] -> isComparisonOperandValue)
                            -> if {
                                predecessorIndex! >= 0 -> if { true => ambiguous! } else {
                                    candidateIndex! => predecessorIndex!
                                }
                            }
                        candidateIndex! + 1 => candidateIndex!
                    }
                    predecessorIndex! >= 0 and not ambiguous! -> if { predecessorIndex! => rightIndex! }
                }
                subjectIndex >= 0 and rightIndex! >= 0 -> if {
                    subjectIndex => condition!.operand0
                    rightIndex! => condition!.operand1
                    condition! => results[conditionIndex!]
                }
            }
        conditionIndex! + 1 => conditionIndex!
    }
}

# An arm can point directly at its terminal or through one or more structural
# regions. Keep that topology in one bounded resolver so late type sealing and
# LLVM invariants cannot disagree about expression-bodied and block arms.
public matchArmTerminalValueIndex armIndex: Int, nodes: ref [TypedIrNode; ~] -> Int {
    -1 => resolved!
    armIndex >= 0 and armIndex < (nodes -> len)
        -> if {
            nodes[armIndex].kind == 19 -> if {
                nodes[armIndex].operand1 => candidate!
                0 => regionDepth!
                candidate! >= 0
                    and candidate! < (nodes -> len)
                    and nodes[candidate!].kind == 19
                    and regionDepth! < (nodes -> len)
                    -> while {
                        nodes[candidate!].operand1 => candidate!
                        regionDepth! + 1 => regionDepth!
                    }
                candidate! >= 0
                    and candidate! < (nodes -> len)
                    and nodes[candidate!].kind != 19
                    -> if { candidate! => resolved! }
            } else {
                armIndex => resolved!
            }
        }
    resolved!
}

public terminalValueReturnsFromArm terminalIndex: Int, armIndex: Int, nodes: ref [TypedIrNode; ~] -> Bool {
    terminalIndex => ancestor!
    ancestor! >= 0 and ancestor! < (nodes -> len) and ancestor! != armIndex
        -> while {
            nodes[ancestor!].kind == 23 -> if { true -> return }
            nodes[ancestor!].parent => ancestor!
        }
    false
}

# A value-producing enum or numeric-subject match requires every continuing
# arm to provide the same canonical non-Unit terminal. One value arm beside an
# empty statement arm is still a Unit match; promoting it would make allocation
# and emission disagree. Explicit-return arms do not contribute a value.
sealEnumMatchTypesFromTerminalArms results: mut [TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], flags: ref [Int; ~] -> Unit {
    0 -> builtinTypeId(types) => unitTypeId
    results -> terminatingControlFlags => terminating
    0 => matchIndex!
    matchIndex! < (results -> len) -> while {
        results[matchIndex!] => match!
        (match!.kind == 27 or match!.kind == 34)
            and match!.operand1 >= 0
            -> if {
                match! -> normalizeMatchResultTypeFromCompleteArms(matchIndex!, unitTypeId, results, types, flags, terminating)
                match! => results[matchIndex!]
                match!.typeOrigin == 1 and match!.typeSymbol == 0
                    and match!.parent >= 0 and match!.parent < (results -> len)
                    and results[match!.parent].kind == 19
                    and results[match!.parent].operand1 == matchIndex!
                    -> if {
                        results[match!.parent] => parentRegion!
                        unitTypeId >= 0 -> if { parentRegion! -> sealNodeTypeIdentity(unitTypeId, types, flags) }
                        parentRegion! => results[match!.parent]
                    }
            }
        matchIndex! + 1 => matchIndex!
    }
}

repairReturnedEnumMatchResults results: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], flags: ref [Int; ~] -> Unit {
    # A returned enum match inherits the function return node's canonical type.
    # Resolve each arm to its final value of that type after every producer and
    # contextual type has settled; an initial payload in a flow pipeline is not
    # the arm result when a later constructor wraps it.
    0 => returnedEnumMatchRepairIndex!
    returnedEnumMatchRepairIndex! < (results -> len)
        -> while {
            results[returnedEnumMatchRepairIndex!] => returnedEnumMatch!
            (returnedEnumMatch!.kind == 27 or returnedEnumMatch!.kind == 34)
                and returnedEnumMatch!.parent >= 0
                and returnedEnumMatch!.parent < (results -> len)
                and results[returnedEnumMatch!.parent].kind == 1
                and results[returnedEnumMatch!.parent].operand0 == returnedEnumMatchRepairIndex!
                and results[returnedEnumMatch!.parent].typeId >= 0
                -> if {
                    results[returnedEnumMatch!.parent] => returnedEnumReturn!
                    types[returnedEnumReturn!.typeId] => returnedEnumResultType
                    returnedEnumReturn!.typeId => returnedEnumMatch!.typeId
                    returnedEnumResultType.kind => returnedEnumMatch!.typeKind
                    returnedEnumResultType.origin => returnedEnumMatch!.typeOrigin
                    returnedEnumResultType.module => returnedEnumMatch!.typeModule
                    returnedEnumResultType.symbol => returnedEnumMatch!.typeSymbol
                    flags[returnedEnumReturn!.typeId] => returnedEnumMatch!.typeFlags
                    returnedEnumMatch! => results[returnedEnumMatchRepairIndex!]
                    returnedEnumMatch!.operand1 => returnedEnumArmIndex!
                    returnedEnumArmIndex! >= 0
                        and returnedEnumArmIndex! < (results -> len)
                        and results[returnedEnumArmIndex!].parent == returnedEnumMatchRepairIndex!
                        -> while {
                            results[returnedEnumArmIndex!] => returnedEnumArm
                            returnedEnumArmIndex! => returnedEnumRegionIndex!
                            returnedEnumArm.operand1 >= 0
                                and returnedEnumArm.operand1 < (results -> len)
                                and results[returnedEnumArm.operand1].kind == 19
                                -> if { returnedEnumArm.operand1 => returnedEnumRegionIndex! }
                            -1 => returnedEnumArmResult!
                            -1 => returnedEnumArmResultRank!
                            UIntSize(0) => returnedEnumArmResultStart!
                            UIntSize(0) => returnedEnumArmResultLength!
                            results[returnedEnumRegionIndex!].operand1 => returnedEnumExistingResultIndex
                            returnedEnumExistingResultIndex >= 0
                                and returnedEnumExistingResultIndex < (results -> len)
                                -> if {
                                    results[returnedEnumExistingResultIndex] => returnedEnumExistingResult
                                    # The linked body result owns the value. A provisional
                                    # region type must not replace it with a same-typed
                                    # pattern binding or another operand from the arm.
                                    returnedEnumExistingResult.parent == returnedEnumRegionIndex!
                                        and returnedEnumExistingResult.kind != 23
                                        -> if {
                                            returnedEnumExistingResultIndex => returnedEnumArmResult!
                                            3 => returnedEnumArmResultRank!
                                        }
                                }
                            0 => returnedEnumCandidateIndex!
                            returnedEnumCandidateIndex! < (results -> len)
                                -> while {
                                    results[returnedEnumCandidateIndex!] => returnedEnumCandidate
                                    0 => returnedEnumCandidateRank!
                                    returnedEnumCandidate.kind >= 2 and returnedEnumCandidate.kind <= 5
                                        -> if { 1 => returnedEnumCandidateRank! }
                                    returnedEnumCandidate.kind == 6
                                        or returnedEnumCandidate.kind == 9
                                        or returnedEnumCandidate.kind == 12
                                        or returnedEnumCandidate.kind == 13
                                        or returnedEnumCandidate.kind == 14
                                        or returnedEnumCandidate.kind == 15
                                        or returnedEnumCandidate.kind == 16
                                        or returnedEnumCandidate.kind == 18
                                        or returnedEnumCandidate.kind == 26
                                        or returnedEnumCandidate.kind == 27
                                        or returnedEnumCandidate.kind == 29
                                        or (returnedEnumCandidate.kind >= 31 and returnedEnumCandidate.kind <= 43)
                                        -> if { 2 => returnedEnumCandidateRank! }
                                    returnedEnumCandidate.parent == returnedEnumRegionIndex!
                                        and (returnedEnumCandidate.kind == 18
                                        or returnedEnumCandidate.kind == 27
                                        or returnedEnumCandidate.kind == 33
                                        or returnedEnumCandidate.kind == 34)
                                        -> if { 4 => returnedEnumCandidateRank! }
                                    returnedEnumCandidateRank! > 0 and returnedEnumCandidate.typeId == returnedEnumReturn!.typeId
                                        -> if {
                                            returnedEnumCandidate.parent => returnedEnumCandidateAncestor!
                                            (returnedEnumCandidate.parent == returnedEnumRegionIndex! or returnedEnumCandidate.parent == returnedEnumArmIndex!) => returnedEnumCandidateBelongs!
                                            returnedEnumCandidateAncestor! >= 0
                                                and returnedEnumCandidateAncestor! != returnedEnumMatchRepairIndex!
                                                and not returnedEnumCandidateBelongs! -> while {
                                                    returnedEnumCandidateAncestor! == returnedEnumRegionIndex! or returnedEnumCandidateAncestor! == returnedEnumArmIndex!
                                                        -> if {
                                                            true => returnedEnumCandidateBelongs!
                                                        } else {
                                                            results[returnedEnumCandidateAncestor!].parent => returnedEnumCandidateAncestor!
                                                        }
                                                }
                                            returnedEnumCandidateBelongs!
                                                and returnedEnumCandidate.astNode >= 0
                                                and returnedEnumCandidate.sourceModule >= 0
                                                and returnedEnumCandidate.sourceModule < (prepared.package.ranges -> len)
                                                -> if {
                                                    prepared.package.ranges[returnedEnumCandidate.sourceModule] => returnedEnumCandidateRange
                                                    prepared.package.nodes[returnedEnumCandidateRange.astStart + returnedEnumCandidate.astNode] => returnedEnumCandidateAst
                                                    returnedEnumArmResult! < 0
                                                        or returnedEnumCandidateRank! > returnedEnumArmResultRank!
                                                        or (returnedEnumCandidateRank! == returnedEnumArmResultRank!
                                                        and (returnedEnumCandidateAst.start > returnedEnumArmResultStart!
                                                        or (returnedEnumCandidateAst.start == returnedEnumArmResultStart! and returnedEnumCandidateAst.length > returnedEnumArmResultLength!)))
                                                        -> if {
                                                            returnedEnumCandidateIndex! => returnedEnumArmResult!
                                                            returnedEnumCandidateRank! => returnedEnumArmResultRank!
                                                            returnedEnumCandidateAst.start => returnedEnumArmResultStart!
                                                            returnedEnumCandidateAst.length => returnedEnumArmResultLength!
                                                        }
                                                }
                                        }
                                    returnedEnumCandidateIndex! + 1 => returnedEnumCandidateIndex!
                                }
                            returnedEnumArmResult! >= 0 -> if {
                                results[returnedEnumRegionIndex!] => returnedEnumRegion!
                                returnedEnumArmResult! => returnedEnumRegion!.operand1
                                results[returnedEnumArmResult!].typeId => returnedEnumActualTypeId
                                returnedEnumActualTypeId >= 0 -> if {
                                    returnedEnumRegion! -> sealNodeTypeIdentity(returnedEnumActualTypeId, types, flags)
                                }
                                returnedEnumRegion! => results[returnedEnumRegionIndex!]
                            }
                            returnedEnumArm.nextOperand => returnedEnumArmIndex!
                        }
                    # The function may still name an earlier expression from
                    # the same body (for example an index assignment) as its
                    # provisional result. Exact parenthood proves this match
                    # is the expression-body result; bind the function only
                    # after arm repair so the mutation cannot perturb the
                    # bounded arm analysis that establishes the control value.
                    returnedEnumMatchRepairIndex! => returnedEnumReturn!.operand0
                    returnedEnumReturn! => results[returnedEnumMatch!.parent]
                }
            returnedEnumMatchRepairIndex! + 1 => returnedEnumMatchRepairIndex!
        }

}

# A member/index assignment may be lowered before its value-producing enum or
# numeric-subject control has a result identity. Redirect only the exact subject
# operand to a later completed non-Unit control; compatible destination types
# and proximity are not producer evidence.
repairAssignmentsToCompletedSubjectControls results: mut [TypedIrNode; ~] -> Unit {
    # Control nodes remain unchanged by assignment repair. Retain the last
    # eligible forward control for each exact input once, preserving the old
    # trailing search's order without scanning the whole IR per assignment.
    [Int; ~] => completedControlByInput!
    results -> each node { completedControlByInput! -> push(-1) }
    0 => controlIndex!
    controlIndex! < (results -> len) -> while {
        results[controlIndex!] => control
        (control.kind == 27 or control.kind == 34)
            and control.operand0 >= 0 and control.operand0 < controlIndex!
            and not (control.typeOrigin == 1 and control.typeSymbol == 0)
            -> if { controlIndex! => completedControlByInput![control.operand0] }
        controlIndex! + 1 => controlIndex!
    }
    0 => assignmentIndex!
    assignmentIndex! < (results -> len) -> while {
        results[assignmentIndex!] => assignment!
        (assignment!.kind == 24 or assignment!.kind == 25)
            and assignment!.operand0 >= 0
            and assignment!.operand0 < (results -> len)
            -> if {
                completedControlByInput![assignment!.operand0] => completedControl
                completedControl >= 0 -> if {
                    completedControl => assignment!.operand0
                    assignment! => results[assignmentIndex!]
                }
            }
        assignmentIndex! + 1 => assignmentIndex!
    }
}

# Control-valued immutable bindings and their direct reads are aliases of the
# completed SSA control. Keep this small linear closure reusable because a late
# nominal-member pass can reveal an arm terminal only after the first match seal.
sealControlBindingAliasTypes results: mut [TypedIrNode; ~] -> Unit {
    0 => bindingIndex!
    bindingIndex! < (results -> len) -> while {
        results[bindingIndex!] => binding!
        binding!.kind == 17
            and binding!.flags != 1
            and binding!.operand0 >= 0
            and binding!.operand0 < (results -> len)
            and (results[binding!.operand0].kind == 18
            or results[binding!.operand0].kind == 27
            or results[binding!.operand0].kind == 33
            or results[binding!.operand0].kind == 34)
            -> if {
                results[binding!.operand0] => value
                value.typeId => binding!.typeId
                value.typeKind => binding!.typeKind
                value.typeOrigin => binding!.typeOrigin
                value.typeModule => binding!.typeModule
                value.typeSymbol => binding!.typeSymbol
                value.typeFlags => binding!.typeFlags
                binding! => results[bindingIndex!]
            }
        bindingIndex! + 1 => bindingIndex!
    }
    0 => readIndex!
    readIndex! < (results -> len) -> while {
        results[readIndex!] => read!
        read!.kind == 5
            and read!.operand0 >= 0
            and read!.operand0 < (results -> len)
            and results[read!.operand0].kind == 17
            and results[read!.operand0].flags != 1
            and results[read!.operand0].operand0 >= 0
            and results[read!.operand0].operand0 < (results -> len)
            and (results[results[read!.operand0].operand0].kind == 18
            or results[results[read!.operand0].operand0].kind == 27
            or results[results[read!.operand0].operand0].kind == 33
            or results[results[read!.operand0].operand0].kind == 34)
            -> if {
                results[read!.operand0] => binding
                binding.typeId => read!.typeId
                binding.typeKind => read!.typeKind
                binding.typeOrigin => read!.typeOrigin
                binding.typeModule => read!.typeModule
                binding.typeSymbol => read!.typeSymbol
                binding.typeFlags => read!.typeFlags
                read! => results[readIndex!]
            }
        readIndex! + 1 => readIndex!
    }
}

# A local initialized from a completed enum match can itself become the exact
# subject of a later enum match. The read, binding, and initializer already
# carry the complete producer identity; consume only that direct chain and the
# read's parent/nextOperand control edge. Never recover this boundary by name,
# proximity, or compatible type.
repairEnumMatchSubjectsFromControlBindings results: mut [TypedIrNode; ~], types: ref [typeIds.SemanticType; ~] -> Unit {
    0 => readIndex!
    readIndex! < (results -> len) -> while {
        results[readIndex!] => read
        false => directControlSubject!
        read.kind == 5 and read.operand0 >= 0 and read.operand0 < (results -> len)
            -> if {
                results[read.operand0] => subjectBinding
                subjectBinding.kind == 10 or subjectBinding.kind == 29
                    -> if {
                        true => directControlSubject!
                    } else {
                        subjectBinding.kind == 17
                            and subjectBinding.flags != 1
                            and subjectBinding.operand0 >= 0
                            and subjectBinding.operand0 < (results -> len)
                            and (results[subjectBinding.operand0].kind == 18
                            or results[subjectBinding.operand0].kind == 27
                            or results[subjectBinding.operand0].kind == 33
                            or results[subjectBinding.operand0].kind == 34)
                            -> if { true => directControlSubject! }
                    }
            }
        types -> typeIds.materializedReadTypeId(read.typeId) => readValueTypeId
        directControlSubject! and readValueTypeId >= 0 and readValueTypeId < (types -> len)
            -> if {
                types[readValueTypeId] => readType
                readType.kind == 1
                    or (readType.kind == 7
                    and readType.origin == 4
                    and (readType.symbol == 0 or readType.symbol == 1))
                    -> if {
                        -1 => subjectMatchIndex!
                        read.parent >= 0
                            and read.parent < (results -> len)
                            and results[read.parent].kind == 27
                            -> if { read.parent => subjectMatchIndex! }
                        read.nextOperand >= 0
                            and read.nextOperand < (results -> len)
                            and results[read.nextOperand].kind == 27
                            -> if { read.nextOperand => subjectMatchIndex! }
                        subjectMatchIndex! >= 0
                            and results[subjectMatchIndex!].operand0 != readIndex!
                            -> if {
                                results[subjectMatchIndex!] => subjectMatch!
                                readIndex! => subjectMatch!.operand0
                                subjectMatch! => results[subjectMatchIndex!]
                            }
                    }
            }
        readIndex! + 1 => readIndex!
    }
}

# An enum payload binder may be attached directly to its arm or to the arm's
# canonical pattern condition. Both shapes encode the same exact ownership edge;
# resolve only that structural chain so payload sealing never depends on names or
# source proximity.
enumPayloadArmIndex payloadIndex: Int, nodes: ref [TypedIrNode; ~] -> Int {
    -1 => armIndex!
    payloadIndex >= 0 and payloadIndex < (nodes -> len) and nodes[payloadIndex].kind == 29
        -> if {
            nodes[payloadIndex].parent => payloadParent
            payloadParent >= 0 and payloadParent < (nodes -> len)
                -> if {
                    nodes[payloadParent].kind == 19 -> if {
                        payloadParent => armIndex!
                    } else {
                        nodes[payloadParent].kind == 8
                            and nodes[payloadParent].operand0 == payloadIndex
                            and nodes[payloadParent].parent >= 0
                            and nodes[payloadParent].parent < (nodes -> len)
                            and nodes[nodes[payloadParent].parent].kind == 19
                            -> if { nodes[payloadParent].parent => armIndex! }
                    }
                }
        }
    armIndex!
}

intrinsicResultTypeId candidateTypeId: Int, types: ref [typeIds.SemanticType; ~] -> Int {
    -1 => resultTypeId!
    types -> typeIds.materializedReadTypeId(candidateTypeId) => readTypeId
    readTypeId >= 0 and readTypeId < (types -> len)
        -> if {
            types[readTypeId] => candidate
            candidate.kind == 7 and candidate.origin == 4 and candidate.symbol == 1
                -> if { readTypeId => resultTypeId! }
        }
    resultTypeId!
}

resultPropagationResultTypeId propagation: TypedIrNode, producer: TypedIrNode, types: ref [typeIds.SemanticType; ~] -> Int {
    propagation.typeId -> intrinsicResultTypeId(types) => resultTypeId!
    producer.typeId -> intrinsicResultTypeId(types) => producerResultTypeId
    producerResultTypeId >= 0 -> if { producerResultTypeId => resultTypeId! }
    resultTypeId!
}

normalizeMatchResultTypeFromCompleteArms match: mut TypedIrNode, matchIndex: Int, unitTypeId: Int, nodes: ref [TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], flags: ref [Int; ~], terminating: ref [Bool; ~] -> Unit {
    (match.kind == 27 or match.kind == 34) and match.operand1 >= 0
        and match.operand1 < (nodes -> len) -> if {
            -1 => selectedTerminal!
            -1 => resultTypeId!
            false => hasContinuingValue!
            true => allContinuingArmsAgree!
            match.operand1 => armIndex!
            armIndex! >= 0
                and armIndex! < (nodes -> len)
                and allContinuingArmsAgree!
                -> while {
                    nodes[armIndex!] => arm
                    arm.parent != matchIndex -> if {
                        false => allContinuingArmsAgree!
                    } else {
                        armIndex! -> matchArmTerminalValueIndex(nodes) => terminalIndex
                        terminalIndex < 0 -> if {
                            false => allContinuingArmsAgree!
                        } else {
                            nodes[terminalIndex] => terminal
                            not terminating[terminalIndex]
                                and not (terminalIndex -> terminalValueReturnsFromArm(armIndex!, nodes))
                                -> if {
                                    terminal.typeId >= 0
                                        and not (terminal.typeOrigin == 1 and terminal.typeSymbol == 0)
                                        -> if {
                                            resultTypeId! < 0 -> if {
                                                terminal.typeId => resultTypeId!
                                                terminalIndex => selectedTerminal!
                                            } else {
                                                terminal.typeId != resultTypeId!
                                                    -> if { false => allContinuingArmsAgree! }
                                            }
                                            true => hasContinuingValue!
                                        } else {
                                            false => allContinuingArmsAgree!
                                        }
                                }
                        }
                        arm.kind == 19 -> if { arm.nextOperand => armIndex! } else { -1 => armIndex! }
                    }
                }
            allContinuingArmsAgree! and hasContinuingValue! and selectedTerminal! >= 0
                -> if {
                    nodes[selectedTerminal!] => resultTerminal
                    resultTerminal.typeOrigin => match.typeOrigin
                    resultTerminal.typeModule => match.typeModule
                    resultTerminal.typeSymbol => match.typeSymbol
                    resultTerminal.typeId => match.typeId
                    resultTerminal.typeKind => match.typeKind
                    resultTerminal.typeFlags => match.typeFlags
                } else {
                    unitTypeId >= 0 -> if { match -> sealNodeTypeIdentity(unitTypeId, types, flags) }
                }
        }
}

# Finalization can establish a match result after the earlier control seal has
# already run. Propagate those completed values through enclosing regions and
# value-producing if expressions in reverse IR order so children always settle
# before their parents. A terminating or Unit branch never contributes a value.
public terminatingControlFlags nodes: ref [TypedIrNode; ~] -> [Bool; ~] {
    [Bool; ~] => terminating!
    terminating! -> reserve(nodes -> len)
    0 => fillIndex!
    fillIndex! < (nodes -> len) -> while {
        terminating! -> push(false)
        fillIndex! + 1 => fillIndex!
    }
    nodes -> len => nodeIndex!
    nodeIndex! > 0 -> while {
        nodeIndex! - 1 => nodeIndex!
        nodes[nodeIndex!] => node
        node.kind == 23 -> if { true => terminating![nodeIndex!] }
        node.kind == 27 -> if {
            false => hasArm!
            true => allArmsTerminate!
            node.operand1 => armIndex!
            armIndex! >= 0 and armIndex! < (nodes -> len)
                -> while {
                    true => hasArm!
                    nodes[armIndex!] => arm
                    armIndex! => armRegion!
                    arm.operand1 >= 0
                        and arm.operand1 < (nodes -> len)
                        and nodes[arm.operand1].kind == 19
                        -> if { arm.operand1 => armRegion! }
                    not terminating![armRegion!]
                        -> if { false => allArmsTerminate! }
                    arm.nextOperand => armIndex!
                }
            hasArm! and allArmsTerminate!
                -> if { true => terminating![nodeIndex!] }
        }
        node.kind == 34 -> if {
            false => hasArm!
            false => hasElse!
            true => allArmsTerminate!
            node.operand1 => armIndex!
            true => armOpen!
            armIndex! >= 0 and armIndex! < (nodes -> len) and armOpen!
                -> while {
                    nodes[armIndex!] => arm
                    arm.parent != nodeIndex! -> if {
                        false => armOpen!
                    } else {
                        true => hasArm!
                        armIndex! => armRegion!
                        arm.kind == 19 and arm.operand1 >= 0
                            -> if { arm.operand1 => armRegion! } else { true => hasElse! }
                        not terminating![armRegion!]
                            -> if { false => allArmsTerminate! }
                        arm.nextOperand => armIndex!
                    }
                }
            hasArm! and hasElse! and allArmsTerminate!
                -> if { true => terminating![nodeIndex!] }
        }
        node.kind == 18
            and node.operand1 >= 0
            and node.operand1 < (nodes -> len)
            and node.nextOperand >= 0
            and node.nextOperand < (nodes -> len)
            and terminating![node.operand1]
            and terminating![node.nextOperand]
            -> if { true => terminating![nodeIndex!] }
        node.kind == 19
            and node.operand1 >= 0
            and node.operand1 < (nodes -> len)
            and terminating![node.operand1]
            -> if { true => terminating![nodeIndex!] }
    }
    terminating!
}

sealCompletedIfAndRegionTypes nodes: mut [TypedIrNode; ~] -> Unit {
    nodes -> terminatingControlFlags => terminating
    nodes -> len => controlIndex!
    controlIndex! > 0 -> while {
        controlIndex! - 1 => controlIndex!
        nodes[controlIndex!] => control
        control.kind == 19
            and control.operand1 >= 0
            and control.operand1 < (nodes -> len)
            -> if {
                nodes[control.operand1] => regionValue
                not (regionValue.typeOrigin == 1 and regionValue.typeSymbol == 0)
                    or regionValue.typeId >= 0
                    -> if {
                        nodes -> sealControlTypeFromValue(controlIndex!, regionValue)
                    }
            }
        control.kind == 18
            and control.operand1 >= 0
            and control.operand1 < (nodes -> len)
            and control.nextOperand >= 0
            and control.nextOperand < (nodes -> len)
            -> if {
                nodes[control.operand1] => thenRegion
                nodes[control.nextOperand] => elseRegion
                terminating[control.operand1] => thenTerminates
                terminating[control.nextOperand] => elseTerminates
                false => branchTypesMatch!
                -1 => valueRegionIndex!
                thenTerminates and not elseTerminates
                    -> if { control.nextOperand => valueRegionIndex! }
                elseTerminates and not thenTerminates
                    -> if { control.operand1 => valueRegionIndex! }
                not thenTerminates and not elseTerminates -> if {
                    thenRegion.typeId >= 0 and thenRegion.typeId == elseRegion.typeId
                        -> if { true => branchTypesMatch! }
                    thenRegion.typeId < 0
                        and elseRegion.typeId < 0
                        and thenRegion.typeKind == elseRegion.typeKind
                        and thenRegion.typeOrigin == elseRegion.typeOrigin
                        and thenRegion.typeModule == elseRegion.typeModule
                        and thenRegion.typeSymbol == elseRegion.typeSymbol
                        -> if { true => branchTypesMatch! }
                    branchTypesMatch! -> if { control.operand1 => valueRegionIndex! }
                }
                valueRegionIndex! >= 0
                    and (not (nodes[valueRegionIndex!].typeOrigin == 1
                    and nodes[valueRegionIndex!].typeSymbol == 0)
                    or nodes[valueRegionIndex!].typeId >= 0)
                    -> if {
                        nodes[valueRegionIndex!] => valueRegion
                        nodes -> sealControlTypeFromValue(controlIndex!, valueRegion)
                    }
            }
    }
}

astBelongsTo sourceModule: Int, childAst: Int, ownerAst: Int, prepared: ref semanticContext.SemanticSnapshot -> Bool {
    childAst => ancestor!
    ancestor! >= 0 -> while {
        ancestor! == ownerAst -> if { true -> return }
        prepared.package.nodes[prepared.package.ranges[sourceModule].astStart + ancestor!].parent => ancestor!
    }
    false
}

# Once an enum arm owns its canonical declaration tag, resolve the payload from
# that identity directly.  Repeating source-name and AST-shape recovery after
# the tag is known can leave a valid nested payload untyped when transparent
# type wrappers differ between semantic tables.
nominalVariantPayloadTypeIdByTag subjectType: typeIds.SemanticType, tag: Int, prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet -> Int {
    subjectType.module => ownerSourceModule!
    subjectType.origin == 2 -> if {
        subjectType.module >= 0 and subjectType.module < (prepared.modules -> len)
            -> if { prepared.modules[subjectType.module].sourceIndex => ownerSourceModule! }
    }
    -1 => payloadTypeId!
    ownerSourceModule! >= 0 and ownerSourceModule! < (prepared.package.ranges -> len)
        and subjectType.symbol >= 0
        -> if {
            prepared.package.ranges[ownerSourceModule!] => ownerRange
            0 => ordinal!
            0 => symbolIndex!
            symbolIndex! < ownerRange.symbolCount and payloadTypeId! < 0
                -> while {
                    prepared.package.symbols[ownerRange.symbolStart + symbolIndex!] => candidate
                    candidate.kind == 27 and candidate.parent == subjectType.symbol
                        -> if {
                            ordinal! == tag and candidate.typeNode >= 0 and candidate.typeNode < ownerRange.astCount
                                -> if {
                                    recursiveTypes.referenceIndexByTypeAst[ownerRange.astStart + candidate.typeNode] => referenceIndex
                                    referenceIndex >= 0 and referenceIndex < (recursiveTypes.references -> len)
                                        and recursiveTypes.references[referenceIndex].status == 0
                                        -> if { recursiveTypes.references[referenceIndex].typeId => payloadTypeId! }
                                }
                            ordinal! + 1 => ordinal!
                        }
                    symbolIndex! + 1 => symbolIndex!
                }
        }
    payloadTypeId!
}

# Tags can become canonical after the ordinary payload-typing pass.  Seal every
# nominal arm binding from that final identity in one linear walk, then make its
# direct reads aliases of the same typed SSA value before LLVM sees the graph.
sealNominalEnumPayloadsByArmTags results: mut [TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], flags: ref [Int; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet -> Unit {
    # A late Result payload seal must reach the binding's direct reads before
    # enum subject and arm payload sealing consume them.
    0 => propagatedReadIndex!
    propagatedReadIndex! < (results -> len) -> while {
        results[propagatedReadIndex!] => read!
        read!.kind == 5 and read!.operand0 >= 0 and read!.operand0 < (results -> len)
            and results[read!.operand0].kind == 17 and results[read!.operand0].operand0 >= 0
            and results[read!.operand0].operand0 < (results -> len)
            and results[results[read!.operand0].operand0].kind == 30
            and results[read!.operand0].typeId >= 0 -> if {
                results[read!.operand0] => binding
                binding.typeId => read!.typeId
                binding.typeKind => read!.typeKind
                binding.typeOrigin => read!.typeOrigin
                binding.typeModule => read!.typeModule
                binding.typeSymbol => read!.typeSymbol
                binding.typeFlags => read!.typeFlags
                read! => results[propagatedReadIndex!]
                -1 => subjectIndex!
                read!.parent >= 0 and read!.parent < (results -> len)
                    and (results[read!.parent].kind == 27 or results[read!.parent].kind == 34)
                    -> if { read!.parent => subjectIndex! }
                read!.nextOperand >= 0 and read!.nextOperand < (results -> len)
                    and (results[read!.nextOperand].kind == 27 or results[read!.nextOperand].kind == 34)
                    -> if { read!.nextOperand => subjectIndex! }
                # parent/nextOperand is an exact flow identity, so the sealed
                # Result payload read outranks any provisional call or control
                # subject installed by an earlier topology repair.
                subjectIndex! >= 0 and results[subjectIndex!].operand0 != propagatedReadIndex!
                    -> if {
                        results[subjectIndex!] => subject!
                        propagatedReadIndex! => subject!.operand0
                        subject! => results[subjectIndex!]
                    }
            }
        propagatedReadIndex! + 1 => propagatedReadIndex!
    }
    0 => payloadIndex!
    payloadIndex! < (results -> len) -> while {
        results[payloadIndex!] => payload!
        payload!.kind == 29 -> if {
            payloadIndex! -> enumPayloadArmIndex(results) => payloadArmIndex
            payloadArmIndex >= 0 -> if {
                results[payloadArmIndex] => arm
                arm.kind == 19 and arm.opcode >= 0 and arm.parent >= 0 and arm.parent < (results -> len)
                    and results[arm.parent].kind == 27
                    -> if {
                        results[arm.parent] => match
                        match.operand0 >= 0 and match.operand0 < (results -> len)
                            and results[match.operand0].typeId >= 0
                            -> if {
                                types[results[match.operand0].typeId] => subjectType
                                subjectType.kind == 1 -> if {
                                    subjectType -> nominalVariantPayloadTypeIdByTag(arm.opcode, prepared, recursiveTypes) => payloadTypeId
                                    payloadTypeId >= 0 -> if {
                                        payload! -> sealNodeTypeIdentity(payloadTypeId, types, flags)
                                        payload! => results[payloadIndex!]
                                    }
                                }
                            }
                    }
            }
        }
        payloadIndex! + 1 => payloadIndex!
    }
    0 => referenceIndex!
    referenceIndex! < (results -> len) -> while {
        results[referenceIndex!] => reference!
        reference!.kind == 5 and reference!.operand0 >= 0 and reference!.operand0 < (results -> len)
            and results[reference!.operand0].kind == 29 and results[reference!.operand0].typeId >= 0
            -> if {
                results[reference!.operand0] => binding
                binding.typeId => reference!.typeId
                binding.typeKind => reference!.typeKind
                binding.typeOrigin => reference!.typeOrigin
                binding.typeModule => reference!.typeModule
                binding.typeSymbol => reference!.typeSymbol
                binding.typeFlags => reference!.typeFlags
                reference! => results[referenceIndex!]
            }
        referenceIndex! + 1 => referenceIndex!
    }
}

# Path intrinsics may acquire their exact instance-method identity during late
# receiver repair. Seal their runtime opcodes both before and after that repair
# from the canonical module and intrinsic declaration, never from spelling
# alone.
sealPathRuntimeOpcodes results: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot -> Unit {
    0 => pathCallIndex!
    pathCallIndex! < (results -> len) -> while {
        results[pathCallIndex!] => pathCall!
        (pathCall!.kind == 6 or pathCall!.kind == 9)
            and pathCall!.targetModule >= 0
            and pathCall!.symbol >= 0
            -> if {
                false => canonicalPathModule!
                false => canonicalFileModule!
                false => canonicalMapPathIntrinsic!
                0 => pathModuleSearch!
                pathModuleSearch! < (prepared.modules -> len)
                    -> while {
                        prepared.modules[pathModuleSearch!] => pathModuleIdentity
                        pathModuleIdentity.sourceIndex == pathCall!.targetModule
                            and pathModuleIdentity.pathHash == 7794543808165292697
                            -> if { true => canonicalPathModule! }
                        pathModuleIdentity.sourceIndex == pathCall!.targetModule
                            and pathModuleIdentity.pathHash == 1560534979202565016
                            -> if { true => canonicalFileModule! }
                        pathModuleSearch! + 1 => pathModuleSearch!
                    }
                canonicalFileModule! and pathCall!.targetModule < (prepared.package.ranges -> len)
                    -> if {
                        prepared.package.ranges[pathCall!.targetModule] => fileSourceRange
                        pathCall!.symbol < fileSourceRange.symbolCount
                            -> if {
                                prepared.package.symbols[fileSourceRange.symbolStart + pathCall!.symbol] => fileSymbol
                                fileSymbol.kind == 7 and fileSymbol.parent < 0 and fileSymbol.flags / 128 % 2 == 1
                                    -> if {
                                        prepared.package.sources[pathCall!.targetModule] -> len => fileSourceLength
                                        prepared.package.sources[pathCall!.targetModule] -> slice(UIntSize(0), fileSourceLength) => fileSource
                                        prepared.package.tokens[fileSourceRange.tokenStart + fileSymbol.nameToken] => fileNameToken
                                        fileSource -> sourceMatches(fileNameToken.span.start, fileNameToken.span.length, "mapPath")
                                            -> if {
                                                true => canonicalMapPathIntrinsic!
                                                -214 => pathCall!.opcode
                                            }
                                    }
                            }
                    }
                not canonicalMapPathIntrinsic! and pathCall!.opcode == -214
                    -> if { -1 => pathCall!.opcode }
                canonicalPathModule! -> if {
                    false => canonicalPathIntrinsic!
                    prepared.package.ranges[pathCall!.targetModule] => pathSourceRange
                    prepared.package.symbols[pathSourceRange.symbolStart + pathCall!.symbol] => pathSymbol
                    (pathSymbol.kind == 7 or pathSymbol.kind == 31)
                        and pathSymbol.flags / 128 % 2 == 1
                        -> if {
                            true => canonicalPathIntrinsic!
                            prepared.package.sources[pathCall!.targetModule] -> len => pathSourceLength
                            prepared.package.sources[pathCall!.targetModule] -> slice(UIntSize(0), pathSourceLength) => pathSource
                            prepared.package.tokens[pathSourceRange.tokenStart + pathSymbol.nameToken] => pathNameToken
                            pathSource -> sourceMatches(pathNameToken.span.start, pathNameToken.span.length, "absolute")
                                -> if { pathAbsoluteOpcode() => pathCall!.opcode }
                            pathSource -> sourceMatches(pathNameToken.span.start, pathNameToken.span.length, "queryRaw")
                                -> if { -215 => pathCall!.opcode }
                            pathSource -> sourceMatches(pathNameToken.span.start, pathNameToken.span.length, "pathText")
                                -> if { -230 => pathCall!.opcode }
                        }
                    not canonicalPathIntrinsic! and (pathCall!.opcode == -215 or pathCall!.opcode == -230 or pathCall!.opcode == pathAbsoluteOpcode())
                        -> if { -1 => pathCall!.opcode }
                } else {
                    pathCall!.opcode == -215 or pathCall!.opcode == -230 or pathCall!.opcode == pathAbsoluteOpcode()
                        -> if { -1 => pathCall!.opcode }
                }
                pathCall! => results[pathCallIndex!]
                prepared.package -> calls.isNativePathStyleIntrinsic(prepared.modules, pathCall!.targetModule, pathCall!.symbol)
                    -> if {
                        pathNativeStyleOpcode() => pathCall!.opcode
                        pathCall! => results[pathCallIndex!]
                    }
            }
        pathCallIndex! + 1 => pathCallIndex!
    }
}

# Intrinsic vocabulary is contextual. A package method named `push` can win
# preliminary call discovery before a projected receiver field acquires its
# canonical growable-array type. Recover only that exact receiver/name pair at
# the final type boundary; nominal receivers keep their declared method.
sealLateGrowablePushCollisions results: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~] -> Unit {
    0 => growablePushIndex!
    growablePushIndex! < (results -> len) -> while {
        results[growablePushIndex!] => growablePush!
        (growablePush!.kind == 6 or growablePush!.kind == 9)
            and growablePush!.targetModule >= 0
            and growablePush!.symbol >= 0
            and growablePush!.operand0 >= 0
            and growablePush!.operand0 < (results -> len)
            and results[growablePush!.operand0].typeId >= 0
            and growablePush!.sourceModule >= 0
            and growablePush!.sourceModule < (prepared.package.ranges -> len)
            and growablePush!.astNode >= 0
            and growablePush!.astNode < prepared.package.ranges[growablePush!.sourceModule].astCount
            -> if {
                results[growablePush!.operand0].typeId => growablePushReceiverTypeId!
                types[growablePushReceiverTypeId!].kind == 8 -> if {
                    types[growablePushReceiverTypeId!].first => growablePushReceiverTypeId!
                }
                types[growablePushReceiverTypeId!].kind == 3 -> if {
                    prepared.package.sources[growablePush!.sourceModule] -> len => growablePushSourceLength
                    prepared.package.sources[growablePush!.sourceModule]
                        -> slice(UIntSize(0), growablePushSourceLength) => growablePushSource
                    growablePushSource -> resolvedFlowIntrinsicOpcode(prepared, growablePush!.sourceModule, growablePush!.astNode) => growablePushOpcode
                    growablePushOpcode == -204
                        -> if {
                            9 => growablePush!.kind
                            -1 => growablePush!.targetModule
                            -1 => growablePush!.symbol
                            -204 => growablePush!.opcode
                            growablePush! => results[growablePushIndex!]
                        }
                }
            }
        growablePushIndex! + 1 => growablePushIndex!
    }
}

resolvedCallRuntimeParameterCount call: ref TypedIrNode, prepared: ref semanticContext.SemanticSnapshot -> Int {
    0 => count!
    call.targetModule >= 0
        and call.targetModule < (prepared.package.ranges -> len)
        and call.symbol >= 0
        and call.symbol < prepared.package.ranges[call.targetModule].symbolCount
        -> if {
            prepared.package.ranges[call.targetModule] => targetRange
            prepared.package.symbols[targetRange.symbolStart + call.symbol] => declaration
            # Generated COM members carry their input contract in metadata,
            # without source parameter symbols.
            declaration.kind == 36 -> if {
                declaration.flags / 8192 % 2 == 1 or declaration.flags / 131072 % 2 == 1
                    -> if { 1 -> return }
                0 -> return
            }
            0 => parameterOffset!
            parameterOffset! < targetRange.symbolCount -> while {
                prepared.package.symbols[targetRange.symbolStart + parameterOffset!] => parameter
                parameter.kind == 35 and parameter.parent == call.symbol
                    -> if { count! + 1 => count! }
                parameterOffset! + 1 => parameterOffset!
            }
        }
    count!
}

# Late exact-receiver repair is valid only when the source has an explicit
# receiver: a flow call or a dotted direct call. The first operand of an
# ordinary global call is an argument, never a receiver. Treating it as one can
# reinterpret `scanValue(self, depth)` as `self.depth()` after types settle.
callHasExplicitReceiverSyntax call: TypedIrNode, prepared: ref semanticContext.SemanticSnapshot -> Bool {
    call.sourceModule >= 0
        and call.sourceModule < (prepared.package.ranges -> len)
        and call.astNode >= 0
        -> unless { false -> return }
    prepared.package.ranges[call.sourceModule] => range
    call.astNode < range.astCount -> unless { false -> return }
    prepared.package.nodes[range.astStart + call.astNode] => callAst
    callAst.kind == 10 -> if { true -> return }
    callAst.kind == 11 -> unless { false -> return }
    -1 => leftParenToken!
    0 => parenthesisDepth!
    callAst.firstToken => tokenIndex!
    tokenIndex! < callAst.firstToken + callAst.tokenCount
        -> while {
            prepared.package.tokens[range.tokenStart + tokenIndex!] => token
            token.kind == grammar.tokenIdLeftParen()
                -> if {
                    parenthesisDepth! == 0 -> if { tokenIndex! => leftParenToken! }
                    parenthesisDepth! + 1 => parenthesisDepth!
                }
            token.kind == grammar.tokenIdRightParen() and parenthesisDepth! > 0
                -> if { parenthesisDepth! - 1 => parenthesisDepth! }
            tokenIndex! + 1 => tokenIndex!
        }
    leftParenToken! >= callAst.firstToken + 2
        and prepared.package.tokens[range.tokenStart + leftParenToken! - 1].kind == grammar.tokenIdIdentifier()
        and prepared.package.tokens[range.tokenStart + leftParenToken! - 2].kind == grammar.tokenIdDot()
}

# Preliminary name lookup can bind an instance call before the receiver reaches
# its final nominal type. A same-name global function on explicit receiver
# syntax is only a provisional candidate: exact receiver lookup may replace it
# when that nominal owner has a matching inherent method. Existing methods stay
# on the fast path unless their canonical nominal owner or concrete arity
# disagrees with the receiver/call chain. Ordinary global calls remain intact.
resolvedCallNeedsExactReceiver callIndex: Int, nodes: ref [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, ownerTypes: [Int], types: ref [typeIds.SemanticType; ~] -> Bool {
    nodes[callIndex] => call
    call -> callHasExplicitReceiverSyntax(prepared)
        -> unless { false -> return }
    call.targetModule >= 0
        and call.targetModule < (prepared.package.ranges -> len)
        and call.symbol >= 0
        and call.symbol < prepared.package.ranges[call.targetModule].symbolCount
        -> unless { false -> return }
    prepared.package.ranges[call.targetModule] => targetRange
    prepared.package.symbols[targetRange.symbolStart + call.symbol].kind => targetKind
    targetKind == 7 -> if { true -> return }
    targetKind == 31 -> unless { false -> return }
    # Methods with equal arity can still name a different nominal owner.
    # Compare materialized canonical owners, never spelling or numeric type IDs.
    call.operand0 >= 0 and call.operand0 < (nodes -> len)
        -> if {
            types -> typeIds.materializedReadTypeId(nodes[call.operand0].typeId) => receiverTypeId
            ownerTypes[targetRange.symbolStart + call.symbol] => ownerTypeId
            receiverTypeId >= 0 and receiverTypeId < (types -> len)
                and ownerTypeId >= 0 and ownerTypeId < (types -> len)
                -> if {
                    types[receiverTypeId] => receiver
                    types[ownerTypeId] => owner
                    receiver.kind == 1 and owner.kind == 1
                        and (receiver.module != owner.module or receiver.symbol != owner.symbol)
                        -> if { true -> return }
                }
        }
    call -> resolvedCallRuntimeParameterCount(prepared) => expected
    0 => linked!
    call.operand0 => argumentIndex!
    argumentIndex! >= 0
        and argumentIndex! < (nodes -> len)
        and linked! <= expected
        -> while {
            linked! + 1 => linked!
            nodes[argumentIndex!].nextOperand => argumentIndex!
        }
    linked! != expected
}

normalizeUnaryResolvedFlowCallOperands nodeIndex: Int, results: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot -> Unit {
    results[nodeIndex] => call!
    call!.kind == 6
    # Role operations keep source and callback in separate slots even
    # when their canonical declaration has one ordinary parameter.
        and call!.opcode != -207 and not (call!.opcode -> isDirectIterationOpcode) and call!.opcode != -209
        and call!.operand1 >= 0
        and (call! -> resolvedCallRuntimeParameterCount(prepared)) == 1
        -> if {
            call!.operand1 => call!.operand0
            -1 => call!.operand1
            call! => results[nodeIndex]
        }
}

normalizeNullaryResolvedCallOperands nodeIndex: Int, results: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot -> Unit {
    results[nodeIndex] => call!
    call!.kind == 6
        and call!.targetModule >= 0
        and call!.symbol >= 0
        and (call! -> resolvedCallRuntimeParameterCount(prepared)) == 0
        -> if {
            -1 => call!.operand0
            -1 => call!.operand1
            call! => results[nodeIndex]
        }
}

# The concrete function's runtime parameter chain is the final call ABI.
# Synthetic declaration symbols can include contextual names that are not
# runtime parameters; a late flow repair must not attach one to a nullary call.
normalizeConcreteNullaryCallPlans results: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot -> Unit {
    [Int; ~] => functionsBySymbol!
    0 => symbolIndex!
    symbolIndex! < (prepared.package.symbols -> len)
        -> while {
            functionsBySymbol! -> push(-1)
            symbolIndex! + 1 => symbolIndex!
        }
    0 => functionIndex!
    functionIndex! < (results -> len) -> while {
        results[functionIndex!] => function
        function.kind == 0
            and function.sourceModule >= 0
            and function.sourceModule < (prepared.package.ranges -> len)
            and function.symbol >= 0
            and function.symbol < prepared.package.ranges[function.sourceModule].symbolCount
            -> if {
                prepared.package.ranges[function.sourceModule].symbolStart + function.symbol => globalSymbol
                functionIndex! => functionsBySymbol![globalSymbol]
            }
        functionIndex! + 1 => functionIndex!
    }
    0 => callIndex!
    callIndex! < (results -> len) -> while {
        results[callIndex!] => call!
        call!.kind == 6
            and call!.operand0 >= 0
            and call!.targetModule >= 0
            and call!.targetModule < (prepared.package.ranges -> len)
            and call!.symbol >= 0
            and call!.symbol < prepared.package.ranges[call!.targetModule].symbolCount
            -> if {
                prepared.package.ranges[call!.targetModule].symbolStart + call!.symbol => targetGlobalSymbol
                functionsBySymbol![targetGlobalSymbol] => targetFunctionIndex
                targetFunctionIndex >= 0 and results[targetFunctionIndex].operand1 < 0
                    -> if {
                        -1 => call!.operand0
                        -1 => call!.operand1
                        call! => results[callIndex!]
