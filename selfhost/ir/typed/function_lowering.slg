# the tag is known can leave a valid nested payload untyped when transparent
# type wrappers differ between semantic tables.
nominalVariantPayloadTypeIdByTag subjectType: typeIds.SemanticType, tag: Int, prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet -> Int {
    subjectType.module => ownerSourceModule!
    subjectType.origin == 2 -> if {
        subjectType.module >= 0 and subjectType.module < (prepared.modules -> len)
            -> if { prepared.modules[subjectType.module].sourceIndex => ownerSourceModule! }
    }
