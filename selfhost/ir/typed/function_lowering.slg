                    -> if { ancestor! => loop! } else {
                        owner.kind == 19 and owner.opcode == -227 and owner.symbol == -1
                            -> if {
                                owner.parent => invocation!
                                invocation! >= 0 and not (nodes[invocation!].kind == 19 and nodes[invocation!].opcode == -227 and nodes[invocation!].symbol >= 0)
                                    -> while { nodes[invocation!].parent => invocation! }
                                invocation! >= 0 -> if {
                                    nodes[invocation!].parent => ancestor!
                                } else { -1 => ancestor! }
                            } else { owner.parent => ancestor! }
                    }
            }
            loop! => transfer!.operand0
            transfer! => nodes[transferIndex!]
        }
        transferIndex! + 1 => transferIndex!
    }
