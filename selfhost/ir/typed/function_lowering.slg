                                finalEnumPatternCandidate.parent => finalEnumPatternParent!
                                finalEnumPatternParent! >= 0
                                    and prepared.package.nodes[finalEnumArmRange.astStart + finalEnumPatternParent!].kind == 70
                                    -> if {
                                        prepared.package.nodes[finalEnumArmRange.astStart + finalEnumPatternParent!].parent => finalEnumPatternParent!
                                    }
                                finalEnumPatternCandidate.kind == 59 and finalEnumPatternParent! == finalEnumArm!.astNode
                                    -> if { finalEnumPatternSearch! => finalEnumPatternAst! }
                                finalEnumPatternSearch! + 1 => finalEnumPatternSearch!
                            }
                        finalEnumPatternAst! >= 0 -> if {
                            prepared.package.nodes[finalEnumArmRange.astStart + finalEnumPatternAst!] => finalEnumPattern
                            prepared.package.tokens[finalEnumArmRange.tokenStart + finalEnumPattern.payloadToken] => finalEnumVariantToken
                            finalEnumArm!.sourceModule -> nominalVariantTagForType(finalEnumSubjectType, finalEnumVariantToken, prepared) => finalEnumVariantTag
                            finalEnumVariantTag >= 0 -> if {
                                finalEnumVariantTag => finalEnumArm!.opcode
                                finalEnumSubjectType -> nominalVariantPayloadTypeIdByTag(finalEnumVariantTag, prepared, recursiveTypes) => finalEnumPayloadTypeId
                                finalEnumPayloadTypeId >= 0 and finalEnumArm!.operand0 >= 0
