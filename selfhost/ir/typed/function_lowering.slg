    0 => receiverSourceIndex!
    receiverSourceIndex! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[receiverSourceIndex!] => receiverSourceRange
            0 => callTargetAstOffset!
            callTargetAstOffset! < receiverSourceRange.astCount
                -> while {
                    prepared.package.nodes[receiverSourceRange.astStart + callTargetAstOffset!] => callTarget
