            and finalEnumMatch.operand0 >= 0
            and finalEnumMatch.operand1 >= 0
            and nodes[finalEnumMatch.operand0].typeId >= 0
            -> if {
                nodes[finalEnumMatch.operand0].typeId => finalEnumSubjectTypeId
