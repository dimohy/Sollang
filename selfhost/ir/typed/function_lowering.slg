            }
        callIndex! + 1 => callIndex!
    }
}

# A late transparent wrapper around an immutable binding must preserve its
# completed control, not the subject or another leaf consumed by that control.
repairControlBindingWrappers results: mut [TypedIrNode; ~], wrappedValueByNode: [Int] -> Unit {
    0 => controlIndex!
    controlIndex! < (results -> len) -> while {
        results[controlIndex!] => control
        (control.kind == 27 or control.kind == 34)
            and control.parent >= 0
            and control.parent < (results -> len)
            and results[control.parent].kind == 17
            and results[control.parent].flags != 1
            and results[control.parent].operand0 == control.operand0
            -> if {
                results[control.parent] => directBinding!
                controlIndex! => directBinding!.operand0
                directBinding! => results[control.parent]
            }
        controlIndex! + 1 => controlIndex!
    }
    0 => bindingIndex!
    bindingIndex! < (results -> len) -> while {
        results[bindingIndex!] => binding!
        binding!.kind == 17
            and binding!.flags != 1
            and binding!.operand0 >= 0
            and binding!.operand0 < (results -> len)
            and results[binding!.operand0].kind == 9
            and results[binding!.operand0].opcode == -1
            and wrappedValueByNode[binding!.operand0] >= 0
            -> if {
                wrappedValueByNode[binding!.operand0] => valueIndex
                results[valueIndex] => value
                value.kind == 18 or value.kind == 27 or value.kind == 33 or value.kind == 34
                    -> if {
                        valueIndex => binding!.operand0
                        binding! => results[bindingIndex!]
                    }
            }
        bindingIndex! + 1 => bindingIndex!
    }
}

# A postfix `?` can be the first expression in an enum-match arm while the
# arm continues to a later value-producing control. The flat AST then nests
# that continuation below the propagation result constructor. Seal the arm
# region to the nearest contextual control result instead of preserving the
# intermediate Result payload type.
repairPostfixMatchArmResults results: mut [TypedIrNode; ~] -> Unit {
    [Bool; ~] => hasPostfixByRegion!
    0 => postfixSeed!
    postfixSeed! < (results -> len) -> while {
        hasPostfixByRegion! -> push(false)
        postfixSeed! + 1 => postfixSeed!
    }
    0 => postfixIndex!
    postfixIndex! < (results -> len) -> while {
        results[postfixIndex!].kind == 24 -> if {
            results[postfixIndex!].parent => postfixRegion!
            postfixRegion! >= 0 and results[postfixRegion!].kind != 19
                -> while { results[postfixRegion!].parent => postfixRegion! }
            postfixRegion! >= 0 -> if { true => hasPostfixByRegion![postfixRegion!] }
        }
        postfixIndex! + 1 => postfixIndex!
    }
    0 => matchIndex!
    matchIndex! < (results -> len) -> while {
        results[matchIndex!] => match
        match.kind == 27 -> if {
            match.operand1 => armIndex!
            armIndex! >= 0 -> while {
                results[armIndex!] => arm!
                arm!.operand1 >= 0
                    and arm!.operand1 < (results -> len)
                    and results[arm!.operand1].kind == 19
                    -> if {
                        arm!.operand1 => regionIndex
                        results[regionIndex] => region!
                        region!.operand1 >= 0 and region!.operand1 < (results -> len)
                            -> if {
                                region!.operand1 => regionRootIndex
                                results[regionRootIndex] => regionRoot
                                false => regionRootMatchesResultType!
                                match.typeId >= 0 and regionRoot.typeId == match.typeId
                                    -> if { true => regionRootMatchesResultType! }
                                match.typeId < 0
                                    and regionRoot.typeId < 0
                                    and regionRoot.typeKind == match.typeKind
                                    and regionRoot.typeOrigin == match.typeOrigin
                                    and regionRoot.typeModule == match.typeModule
                                    and regionRoot.typeSymbol == match.typeSymbol
                                    -> if { true => regionRootMatchesResultType! }
                                not regionRootMatchesResultType! and hasPostfixByRegion![regionIndex]
                                    -> if {
                                        -1 => contextualControlIndex!
                                        regionRootIndex + 1 => candidateIndex!
                                        candidateIndex! < (results -> len) and contextualControlIndex! < 0
                                            -> while {
                                                results[candidateIndex!] => candidate
                                                false => candidateMatchesResultType!
                                                match.typeId >= 0 and candidate.typeId == match.typeId
                                                    -> if { true => candidateMatchesResultType! }
                                                match.typeId < 0
                                                    and candidate.typeId < 0
                                                    and candidate.typeKind == match.typeKind
                                                    and candidate.typeOrigin == match.typeOrigin
                                                    and candidate.typeModule == match.typeModule
                                                    and candidate.typeSymbol == match.typeSymbol
                                                    -> if { true => candidateMatchesResultType! }
                                                (candidate.kind == 18
                                                    or candidate.kind == 27
                                                    or candidate.kind == 33
                                                    or candidate.kind == 34)
                                                    and candidateMatchesResultType!
                                                    -> if {
                                                        candidate.parent => ancestorIndex!
                                                        ancestorIndex! >= 0 and ancestorIndex! != regionRootIndex
                                                            -> while { results[ancestorIndex!].parent => ancestorIndex! }
                                                        ancestorIndex! == regionRootIndex
                                                            -> if { candidateIndex! => contextualControlIndex! }
                                                    }
                                                candidateIndex! + 1 => candidateIndex!
                                            }
                                        contextualControlIndex! >= 0 -> if {
                                            contextualControlIndex! => region!.operand1
                                            match.typeId => region!.typeId
                                            match.typeKind => region!.typeKind
                                            match.typeOrigin => region!.typeOrigin
                                            match.typeModule => region!.typeModule
                                            match.typeSymbol => region!.typeSymbol
                                            match.typeFlags => region!.typeFlags
                                            region! => results[regionIndex]
                                            match.typeId => arm!.typeId
                                            match.typeKind => arm!.typeKind
                                            match.typeOrigin => arm!.typeOrigin
                                            match.typeModule => arm!.typeModule
                                            match.typeSymbol => arm!.typeSymbol
                                            match.typeFlags => arm!.typeFlags
                                            arm! => results[armIndex!]
                                        }
                                    }
                            }
                    }
                arm!.nextOperand => armIndex!
            }
        }
        matchIndex! + 1 => matchIndex!
    }
}

# A nested enum match may consume its enclosing arm payload directly. Repair
# that exact owner edge before payload typing so the nested arm bindings can be
# typed from the now-canonical subject in the same pass.
repairNestedEnumPayloadSubjects results: mut [TypedIrNode; ~] -> Unit {
    [Int; ~] => payloadByArm!
