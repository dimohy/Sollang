                    results[callbackCandidateIndex!] => callbackCandidate
                    callbackCandidateIndex! != parallelIndex!
                        and callbackCandidate.sourceModule == parallel!.sourceModule
                        and callbackCandidate.astNode >= 0
                        and callbackCandidate.astNode < parallelRange.astCount
                        and callbackCandidate.typeId >= 0
                        and callbackCandidate.kind != 0
                        and callbackCandidate.kind != 1
                        and callbackCandidate.kind != 5
                        and callbackCandidate.kind != 10
                        and callbackCandidate.kind != 11
                        and callbackCandidate.kind != 17
                        and callbackCandidate.kind != 19
                        and callbackCandidate.kind != 21
                        and callbackCandidate.kind != 22
                        and callbackCandidate.kind != 23
                        and callbackCandidate.kind != 24
                        and callbackCandidate.kind != 25
                        and callbackCandidate.kind != 29
                        -> if {
                            prepared.package.nodes[parallelRange.astStart + callbackCandidate.astNode] => callbackAst
                            callbackAst.start + callbackAst.length => candidateEnd
                            0 => candidateRank!
                            callbackCandidate.kind == 18
                                or callbackCandidate.kind == 20
                                or callbackCandidate.kind == 27
                                or callbackCandidate.kind == 33
                                or callbackCandidate.kind == 34
                                -> if { 2 => candidateRank! }
                            callbackCandidate.kind == 6 or callbackCandidate.kind == 9
                                -> if { 1 => candidateRank! }
                            callbackAst.start >= bodyStart!
                                and candidateEnd <= bodyEnd!
                                and (callbackRoot! < 0
                                or candidateEnd > callbackEnd!
                                or (candidateEnd == callbackEnd! and callbackAst.length > callbackLength!)
                                or (candidateEnd == callbackEnd! and callbackAst.length == callbackLength! and candidateRank! > callbackRank!))
                                -> if {
                                    callbackCandidateIndex! => callbackRoot!
                                    candidateEnd => callbackEnd!
                                    callbackAst.length => callbackLength!
                                    candidateRank! => callbackRank!
                                }
                        }
                    callbackCandidateIndex! + 1 => callbackCandidateIndex!
                }
                callbackRoot! >= 0
                    and results[callbackRoot!].kind == 9
                    and results[callbackRoot!].operand0 < 0
                    -> if {
                        -1 => callbackChild!
                        UIntSize(0) => callbackChildEnd!
                        UIntSize(0) => callbackChildLength!
                        -1 => callbackChildRank!
                        0 => callbackChildIndex!
                        callbackChildIndex! < (results -> len) -> while {
                            results[callbackChildIndex!] => callbackChildCandidate
                            callbackChildCandidate.parent == callbackRoot!
                                and callbackChildCandidate.typeId >= 0
                                and callbackChildCandidate.kind != 5
                                and callbackChildCandidate.kind != 10
                                and callbackChildCandidate.kind != 17
                                and callbackChildCandidate.kind != 19
                                -> if {
                                    prepared.package.nodes[parallelRange.astStart + callbackChildCandidate.astNode] => callbackChildAst
                                    callbackChildAst.start + callbackChildAst.length => candidateChildEnd
                                    0 => candidateChildRank!
                                    callbackChildCandidate.kind == 18
                                        or callbackChildCandidate.kind == 20
                                        or callbackChildCandidate.kind == 27
                                        or callbackChildCandidate.kind == 33
                                        or callbackChildCandidate.kind == 34
                                        -> if { 2 => candidateChildRank! }
                                    callbackChildCandidate.kind == 6 or callbackChildCandidate.kind == 9
                                        -> if { 1 => candidateChildRank! }
                                    callbackChild! < 0
                                        or candidateChildEnd > callbackChildEnd!
                                        or (candidateChildEnd == callbackChildEnd! and callbackChildAst.length > callbackChildLength!)
                                        or (candidateChildEnd == callbackChildEnd! and callbackChildAst.length == callbackChildLength! and candidateChildRank! > callbackChildRank!)
                                        -> if {
                                            callbackChildIndex! => callbackChild!
                                            candidateChildEnd => callbackChildEnd!
                                            callbackChildAst.length => callbackChildLength!
                                            candidateChildRank! => callbackChildRank!
                                        }
                                }
                            callbackChildIndex! + 1 => callbackChildIndex!
                        }
                        callbackChild! >= 0 -> if { callbackChild! => callbackRoot! }
                    }
                callbackRoot! >= 0 -> if {
                    callbackRoot! => parallel!.operand1
                    results[callbackRoot!] => callbackRootNode
                    parallel!.opcode == -207 -> if {
                        -1 => parallelResultType!
                        0 => parallelTypeSearch!
                        parallelTypeSearch! < (recursiveTypes.types -> len) and parallelResultType! < 0
                            -> while {
                                recursiveTypes.types[parallelTypeSearch!] => parallelTypeCandidate
                                parallelTypeCandidate.kind == 3
                                    and parallelTypeCandidate.first == callbackRootNode.typeId
                                    and parallelTypeCandidate.status == 0
                                    -> if { parallelTypeSearch! => parallelResultType! }
                                parallelTypeSearch! + 1 => parallelTypeSearch!
                            }
                        parallelResultType! >= 0 -> if {
                            recursiveTypes.types[parallelResultType!] => parallelResult
                            parallelResultType! => parallel!.typeId
                            parallelResult.kind => parallel!.typeKind
                            parallelResult.origin => parallel!.typeOrigin
                            parallelResult.module => parallel!.typeModule
                            parallelResult.symbol => parallel!.typeSymbol
                            recursiveTypeFlags[parallelResultType!] => parallel!.typeFlags
                        }
                    }
                    parallel! => results[parallelIndex!]
                }
            }
        parallelIndex! + 1 => parallelIndex!
    }
    0 => parallelBindingIndex!
    parallelBindingIndex! < (results -> len) -> while {
        results[parallelBindingIndex!] => parallelBinding!
        parallelBinding!.kind == 17
            and parallelBinding!.operand0 >= 0
            and parallelBinding!.operand0 < (results -> len)
            and results[parallelBinding!.operand0].kind == 6
            and results[parallelBinding!.operand0].opcode == -207
            -> if {
                results[parallelBinding!.operand0] => parallelSource
                parallelSource.typeId => parallelBinding!.typeId
                parallelSource.typeKind => parallelBinding!.typeKind
                parallelSource.typeOrigin => parallelBinding!.typeOrigin
                parallelSource.typeModule => parallelBinding!.typeModule
                parallelSource.typeSymbol => parallelBinding!.typeSymbol
                parallelSource.typeFlags => parallelBinding!.typeFlags
                parallelBinding! => results[parallelBindingIndex!]
            }
        parallelBindingIndex! + 1 => parallelBindingIndex!
    }
}

# Materialize an exact structured-callback role receiver when semantic name
# resolution has no ordinary Typed IR definition for it. Global AST and symbol
# identity, not spelling or type compatibility, select the role and source type.
repairNamedFlowReceiverCallPlans results: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, recursiveTypeFlags: ref [Int; ~] -> Unit {
    [Int; ~] => receiverByAst!
    [Int; ~] => resolvedRoleNameByAst!
    [Int; ~] => roleSymbolByAst!
    [Int; ~] => callTargetTokenByAst!
    [Int; ~] => resolvedTypeByAst!
    0 => astIndex!
    astIndex! < (prepared.package.nodes -> len) -> while {
        receiverByAst! -> push(-1)
        resolvedRoleNameByAst! -> push(-1)
        roleSymbolByAst! -> push(-1)
        callTargetTokenByAst! -> push(-1)
        resolvedTypeByAst! -> push(-1)
        astIndex! + 1 => astIndex!
    }
    0 => expressionTypeIndex!
    expressionTypeIndex! < (recursiveTypes.expressions -> len)
        -> while {
            recursiveTypes.expressions[expressionTypeIndex!] => expressionType
            expressionType.status == 0 and expressionType.typeId >= 0
                and expressionType.sourceModule >= 0
                and expressionType.sourceModule < (prepared.package.ranges -> len)
                and expressionType.astNode >= 0
                and expressionType.astNode < prepared.package.ranges[expressionType.sourceModule].astCount
                -> if {
                    prepared.package.ranges[expressionType.sourceModule].astStart + expressionType.astNode
                        => expressionGlobalAst
                    resolvedTypeByAst![expressionGlobalAst] < 0 -> if {
                        expressionType.typeId => resolvedTypeByAst![expressionGlobalAst]
                    }
                }
            expressionTypeIndex! + 1 => expressionTypeIndex!
        }
    [Int; ~] => roleTypeBySymbol!
    0 => symbolIndex!
    symbolIndex! < (prepared.package.symbols -> len)
        -> while {
            roleTypeBySymbol! -> push(-1)
            symbolIndex! + 1 => symbolIndex!
        }
    0 => roleSourceIndex!
    roleSourceIndex! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[roleSourceIndex!] => roleRange
            0 => roleSymbolOffset!
            roleSymbolOffset! < roleRange.symbolCount -> while {
                prepared.package.symbols[roleRange.symbolStart + roleSymbolOffset!] => roleSymbol
                roleSymbol.kind == 35
                    and roleSymbol.astNode >= 0
                    and prepared.package.nodes[roleRange.astStart + roleSymbol.astNode].kind == 48
                    -> if {
                        roleRange.symbolStart + roleSymbolOffset!
                            => roleSymbolByAst![roleRange.astStart + roleSymbol.astNode]
                    }
                roleSymbolOffset! + 1 => roleSymbolOffset!
            }
            roleSourceIndex! + 1 => roleSourceIndex!
        }
    0 => receiverBuildIndex!
    receiverBuildIndex! < (results -> len) -> while {
        results[receiverBuildIndex!] => receiverCandidate
        receiverCandidate.kind == 5
            and receiverCandidate.sourceModule >= 0
            and receiverCandidate.sourceModule < (prepared.package.ranges -> len)
            and receiverCandidate.symbol >= 0
            and receiverCandidate.symbol < prepared.package.ranges[receiverCandidate.sourceModule].symbolCount
            and prepared.package.symbols[prepared.package.ranges[receiverCandidate.sourceModule].symbolStart + receiverCandidate.symbol].kind == 35
            -> if {
                prepared.package.ranges[receiverCandidate.sourceModule] => receiverRange
                receiverCandidate.astNode >= 0 and receiverCandidate.astNode < receiverRange.astCount
                    -> if {
                        prepared.package.nodes[receiverRange.astStart + receiverCandidate.astNode]
                            => receiverAst
                        receiverCandidate.astNode => receiverAncestor!
                        receiverAncestor! >= 0 -> while {
                            prepared.package.nodes[receiverRange.astStart + receiverAncestor!]
                                => receiverAncestorAst
                            receiverAncestorAst.start == receiverAst.start
                                -> if {
                                    receiverByAst![receiverRange.astStart + receiverAncestor!] < 0
                                        -> if {
                                            receiverBuildIndex! => receiverByAst![receiverRange.astStart + receiverAncestor!]
                                        }
                                    receiverAncestorAst.parent => receiverAncestor!
                                } else {
                                    -1 => receiverAncestor!
                                }
                        }
                    }
            }
        receiverCandidate.kind == 6
            and (receiverCandidate.opcode == -207 or receiverCandidate.opcode == -208 or receiverCandidate.opcode == -209)
            and receiverCandidate.sourceModule >= 0
            and receiverCandidate.sourceModule < (prepared.package.ranges -> len)
            and receiverCandidate.astNode >= 0
            and receiverCandidate.astNode < prepared.package.ranges[receiverCandidate.sourceModule].astCount
            and receiverCandidate.operand0 >= 0
            and receiverCandidate.operand0 < (results -> len)
            -> if {
                prepared.package.ranges[receiverCandidate.sourceModule] => roleOwnerRange
                roleSymbolByAst![roleOwnerRange.astStart + receiverCandidate.astNode]
                    => roleGlobalSymbol
                results[receiverCandidate.operand0].typeId => roleSourceTypeId!
                roleSourceTypeId! >= 0
                    and roleSourceTypeId! < (recursiveTypes.types -> len)
                    and recursiveTypes.types[roleSourceTypeId!].kind == 8
                    -> if { recursiveTypes.types[roleSourceTypeId!].first => roleSourceTypeId! }
                roleGlobalSymbol >= 0
                    and roleSourceTypeId! >= 0
                    and roleSourceTypeId! < (recursiveTypes.types -> len)
                    and recursiveTypes.types[roleSourceTypeId!].kind >= 2
                    and recursiveTypes.types[roleSourceTypeId!].kind <= 4
                    -> if {
                        recursiveTypes.types[roleSourceTypeId!].first
                            => roleTypeBySymbol![roleGlobalSymbol]
                    }
            }
        receiverBuildIndex! + 1 => receiverBuildIndex!
    }
    0 => receiverSourceIndex!
    receiverSourceIndex! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[receiverSourceIndex!] => receiverSourceRange
            0 => callTargetAstOffset!
            callTargetAstOffset! < receiverSourceRange.astCount
                -> while {
                    prepared.package.nodes[receiverSourceRange.astStart + callTargetAstOffset!] => callTarget
                    # Block calls own their callee token directly. Its boundary
                    # keeps a preceding pipeline producer intact even when the
                    # pipeline starts with a named parameter inside a Range.
                    callTarget.kind == 48 and callTarget.payloadToken >= 0
                        -> if {
                            callTarget.payloadToken
                                => callTargetTokenByAst![receiverSourceRange.astStart + callTargetAstOffset!]
                        }
                    callTarget.kind == 16 and callTarget.parent >= 0
                        and prepared.package.nodes[receiverSourceRange.astStart + callTarget.parent].kind == 10
                        -> if {
                            callTarget.payloadToken
                                => callTargetTokenByAst![receiverSourceRange.astStart + callTarget.parent]
                        }
                    callTargetAstOffset! + 1 => callTargetAstOffset!
                }
            0 => receiverNameOffset!
            receiverNameOffset! < receiverSourceRange.nameCount
                -> while {
                    receiverSourceRange.nameStart + receiverNameOffset! => receiverNameIndex
                    prepared.package.names[receiverNameIndex] => receiverName
                    receiverName.symbol >= 0
                        and receiverName.symbol < receiverSourceRange.symbolCount
                        and prepared.package.symbols[receiverSourceRange.symbolStart + receiverName.symbol].kind == 35
                        and receiverName.astNode >= 0
                        and receiverName.astNode < receiverSourceRange.astCount
                        -> if {
                            prepared.package.nodes[receiverSourceRange.astStart + receiverName.astNode] => receiverNameAst
                            receiverName.astNode => receiverNameAncestor!
                            receiverNameAncestor! >= 0 -> while {
                                prepared.package.nodes[receiverSourceRange.astStart + receiverNameAncestor!]
                                    => receiverNameAncestorAst
                                receiverNameAncestorAst.start == receiverNameAst.start
                                    -> if {
                                        resolvedRoleNameByAst![receiverSourceRange.astStart + receiverNameAncestor!] < 0
                                            -> if {
                                                receiverNameIndex => resolvedRoleNameByAst![receiverSourceRange.astStart + receiverNameAncestor!]
                                            }
                                        receiverNameAncestorAst.parent => receiverNameAncestor!
                                    } else {
                                        -1 => receiverNameAncestor!
                                    }
                            }
                        }
                    receiverNameOffset! + 1 => receiverNameOffset!
                }
            receiverSourceIndex! + 1 => receiverSourceIndex!
        }
    results -> len => originalResultCount
    0 => callIndex!
    callIndex! < originalResultCount -> while {
        results[callIndex!] => call!
        call!.kind == 6
            and call!.targetModule >= 0
            and call!.symbol >= 0
            and call!.sourceModule >= 0
            and call!.sourceModule < (prepared.package.ranges -> len)
            and call!.astNode >= 0
            -> if {
                prepared.package.ranges[call!.sourceModule] => sourceRange
                call!.astNode < sourceRange.astCount -> if {
                    prepared.package.nodes[sourceRange.astStart + call!.astNode] => callAst
                    -1 => arrowToken!
                    callAst.firstToken => tokenIndex!
                    tokenIndex! < callAst.firstToken + callAst.tokenCount and arrowToken! < 0
                        -> while {
                            prepared.package.tokens[sourceRange.tokenStart + tokenIndex!] => token
                            token.kind == grammar.tokenIdArrow() -> if { tokenIndex! => arrowToken! }
                            tokenIndex! + 1 => tokenIndex!
                        }
                    arrowToken! >= 0 and (call! -> resolvedCallRuntimeParameterCount(prepared)) > 0
                        -> if {
                            prepared.package.tokens[sourceRange.tokenStart + arrowToken!] => arrow
                            arrow.span.start => receiverBoundary!
                            callTargetTokenByAst![sourceRange.astStart + call!.astNode] => callTargetToken
                            callTargetToken >= 0 and callTargetToken < sourceRange.tokenCount
                                -> if {
                                    prepared.package.tokens[sourceRange.tokenStart + callTargetToken].span.start
                                        => receiverBoundary!
                                }
                            # A projected flow receiver is lowered as its base read
                            # followed by one or more member nodes. The complete
                            # projection, not the base read, is the first runtime
                            # argument. Remove only the exact contiguous member
                            # chain whose operand points at the preceding receiver;
                            # explicit call arguments keep their existing order.
                            -1 => canonicalReceiverIndex!
                            call!.operand0 => receiverPathIndex
                            receiverPathIndex >= 0
                                and receiverPathIndex < (results -> len)
                                -> if {
                                    receiverPathIndex => canonicalReceiverIndex!
                                    results[receiverPathIndex].nextOperand => receiverPathNext!
                                    receiverPathNext! >= 0
                                        and receiverPathNext! < (results -> len)
                                        and results[receiverPathNext!].kind == 13
                                        and results[receiverPathNext!].operand0 == canonicalReceiverIndex!
                                        -> while {
                                            prepared.package.nodes[sourceRange.astStart + results[receiverPathNext!].astNode]
                                                => receiverPathAst
                                            receiverPathAst.start + receiverPathAst.length <= receiverBoundary!
                                                -> if {
                                                    receiverPathNext! => canonicalReceiverIndex!
                                                    results[receiverPathNext!].nextOperand => receiverPathNext!
                                                } else {
                                                    -1 => receiverPathNext!
                                                }
                                        }
                                    canonicalReceiverIndex! != call!.operand0 -> if {
                                        canonicalReceiverIndex! => call!.operand0
                                        results[canonicalReceiverIndex!].nextOperand => call!.operand1
                                        call! => results[callIndex!]
                                    }
                                }
                            canonicalReceiverIndex! >= 0 -> if {
                                prepared.package.nodes[sourceRange.astStart + results[canonicalReceiverIndex!].astNode]
                                    => canonicalReceiverAst
                                canonicalReceiverAst.start + canonicalReceiverAst.length <= receiverBoundary!
                                    -> unless { -1 => canonicalReceiverIndex! }
                            }
                            receiverByAst![sourceRange.astStart + call!.astNode] => receiverIndex!
                            canonicalReceiverIndex! >= 0 -> if { canonicalReceiverIndex! => receiverIndex! }
                            receiverIndex! < 0 -> if {
                                resolvedRoleNameByAst![sourceRange.astStart + call!.astNode] => resolvedNameIndex
                                resolvedNameIndex >= 0 -> if {
                                    prepared.package.names[resolvedNameIndex] => resolvedReceiver
                                    resolvedReceiver.symbol >= 0
                                        and resolvedReceiver.symbol < sourceRange.symbolCount
                                        -> if {
                                            prepared.package.symbols[sourceRange.symbolStart + resolvedReceiver.symbol]
                                                => receiverSymbol
                                            resolvedTypeByAst![sourceRange.astStart + resolvedReceiver.astNode]
                                                => receiverTypeId!
                                            roleTypeBySymbol![sourceRange.symbolStart + resolvedReceiver.symbol]
                                                => exactRoleTypeId
                                            receiverSymbol.kind == 35 and exactRoleTypeId >= 0
                                                -> if { exactRoleTypeId => receiverTypeId! }
                                            receiverSymbol.kind == 35
                                                and receiverSymbol.astNode >= 0
                                                and prepared.package.nodes[sourceRange.astStart + receiverSymbol.astNode].kind == 48
                                                and receiverTypeId! >= 0
                                                and receiverTypeId! < (recursiveTypes.types -> len)
                                                -> if {
                                                    recursiveTypes.types[receiverTypeId!] => receiverType
                                                    results -> len => receiverIndex!
                                                    results -> push(TypedIrNode {
                                                        kind: 5
                                                        parent: callIndex!
                                                        sourceModule: call!.sourceModule
                                                        astNode: resolvedReceiver.astNode
                                                        symbol: resolvedReceiver.symbol
                                                        targetModule: -1
                                                        typeOrigin: receiverType.origin
                                                        typeModule: receiverType.module
                                                        typeSymbol: receiverType.symbol
                                                        typeId: receiverTypeId!
                                                        typeKind: receiverType.kind
                                                        typeFlags: recursiveTypeFlags[receiverTypeId!]
                                                        payloadToken: resolvedReceiver.nameToken
                                                        opcode: -1
                                                        operand0: -1
                                                        operand1: -1
                                                        nextOperand: -1
                                                        flags: 0
                                                    })
                                                }
                                        }
                                }
                            }
                            receiverIndex! >= 0 -> if {
                                prepared.package.nodes[sourceRange.astStart + results[receiverIndex!].astNode]
                                    => receiverAst
                                receiverAst.start + receiverAst.length <= receiverBoundary!
                                    -> unless { -1 => receiverIndex! }
                            }
                            receiverIndex! >= 0 -> if {
                                # Existing exact role reads need the same canonical element type as
                                # newly synthesized receivers. Resolve the actual name AST first;
                                # provisional role symbols on explicit arguments are not sufficient.
                                results[receiverIndex!] => existingReceiver!
                                existingReceiver!.kind == 5 and existingReceiver!.astNode >= 0
                                    and existingReceiver!.astNode < sourceRange.astCount
                                    -> if {
                                        resolvedRoleNameByAst![sourceRange.astStart + existingReceiver!.astNode] => existingRoleName
                                        existingRoleName >= 0 -> if {
                                            prepared.package.names[existingRoleName] => exactRoleName
                                            exactRoleName.symbol == existingReceiver!.symbol
                                                and exactRoleName.astNode == existingReceiver!.astNode
                                                -> if {
                                                    roleTypeBySymbol![sourceRange.symbolStart + exactRoleName.symbol] => exactRoleType
                                                    exactRoleType >= 0 and exactRoleType < (recursiveTypes.types -> len)
                                                        -> if {
                                                            recursiveTypes.types[exactRoleType] => canonicalRoleType
                                                            exactRoleType => existingReceiver!.typeId
                                                            canonicalRoleType.kind => existingReceiver!.typeKind
                                                            canonicalRoleType.origin => existingReceiver!.typeOrigin
                                                            canonicalRoleType.module => existingReceiver!.typeModule
                                                            canonicalRoleType.symbol => existingReceiver!.typeSymbol
                                                            recursiveTypeFlags[exactRoleType] => existingReceiver!.typeFlags
                                                            existingReceiver! => results[receiverIndex!]
                                                        }
                                                }
                                        }
                                    }
                                false => linked!
                                call!.operand0 => linkIndex!
                                0 => linkSteps!
                                linkIndex! >= 0
                                    and linkIndex! < (results -> len)
                                    and linkSteps! < (results -> len)
                                    -> while {
                                        linkIndex! == receiverIndex!
                                            -> if {
                                                true => linked!
                                                -1 => linkIndex!
                                            } else {
                                                results[linkIndex!].nextOperand => linkIndex!
                                            }
                                        linkSteps! + 1 => linkSteps!
                                    }
                                not linked! -> if {
                                    call!.operand0 => oldHead
                                    results[receiverIndex!] => receiver!
                                    oldHead => receiver!.nextOperand
                                    receiver! => results[receiverIndex!]
                                    receiverIndex! => call!.operand0
                                    oldHead >= 0 -> if { oldHead => call!.operand1 }
                                    call! => results[callIndex!]
                                }
                            }
                            # A late-resolved two-parameter flow call can retain
                            # its receiver while the single explicit name still
                            # points through the mutable binding that already names
                            # this call as its next consumer. Recover only one exact
                            # name between the target and following arrow, then use
                            # that symbol's exact binding -> current-value edge.
                            (call! -> resolvedCallRuntimeParameterCount(prepared)) == 2
                                and call!.operand0 >= 0
                                and call!.operand0 < (results -> len)
                                and call!.operand1 < 0
                                and results[call!.operand0].nextOperand < 0
                                and callTargetToken >= 0
                                -> if {
                                    callAst.start + callAst.length => explicitArgumentBoundary!
                                    callTargetToken + 1 => explicitArgumentBoundaryToken!
                                    explicitArgumentBoundaryToken! < callAst.firstToken + callAst.tokenCount
                                        -> while {
                                            prepared.package.tokens[sourceRange.tokenStart + explicitArgumentBoundaryToken!]
                                                => explicitArgumentBoundaryCandidate
                                            explicitArgumentBoundaryCandidate.kind == grammar.tokenIdArrow()
                                                and explicitArgumentBoundaryCandidate.span.start > receiverBoundary!
                                                -> if {
                                                    explicitArgumentBoundaryCandidate.span.start => explicitArgumentBoundary!
                                                    callAst.firstToken + callAst.tokenCount => explicitArgumentBoundaryToken!
                                                } else {
                                                    explicitArgumentBoundaryToken! + 1 => explicitArgumentBoundaryToken!
                                                }
                                        }
                                    -1 => explicitArgumentSymbol!
                                    -1 => explicitArgumentNameToken!
                                    false => explicitArgumentNameAmbiguous!
                                    0 => explicitArgumentNameOffset!
                                    explicitArgumentNameOffset! < sourceRange.nameCount
                                        -> while {
                                            prepared.package.names[sourceRange.nameStart + explicitArgumentNameOffset!]
                                                => explicitArgumentName
                                            explicitArgumentName.symbol >= 0
                                                and explicitArgumentName.symbol < sourceRange.symbolCount
                                                and explicitArgumentName.nameToken >= 0
                                                and explicitArgumentName.nameToken < sourceRange.tokenCount
                                                -> if {
                                                    prepared.package.tokens[sourceRange.tokenStart + explicitArgumentName.nameToken]
                                                        => explicitArgumentNameToken
                                                    explicitArgumentNameToken.span.start > receiverBoundary!
                                                        and explicitArgumentNameToken.span.start < explicitArgumentBoundary!
                                                        -> if {
                                                            explicitArgumentNameToken! >= 0
                                                                and explicitArgumentNameToken! != explicitArgumentName.nameToken
                                                                -> if { true => explicitArgumentNameAmbiguous! }
                                                            explicitArgumentName.symbol => explicitArgumentSymbol!
                                                            explicitArgumentName.nameToken => explicitArgumentNameToken!
                                                        }
                                                }
                                            explicitArgumentNameOffset! + 1 => explicitArgumentNameOffset!
                                        }
                                    -1 => explicitArgumentBinding!
                                    false => explicitArgumentBindingAmbiguous!
                                    0 => explicitArgumentBindingSearch!
                                    explicitArgumentSymbol! >= 0
                                        and not explicitArgumentNameAmbiguous!
                                        and explicitArgumentBindingSearch! < originalResultCount
                                        -> while {
                                            results[explicitArgumentBindingSearch!] => explicitArgumentBindingCandidate
                                            explicitArgumentBindingCandidate.kind == 17
                                                and explicitArgumentBindingCandidate.sourceModule == call!.sourceModule
                                                and explicitArgumentBindingCandidate.symbol == explicitArgumentSymbol!
                                                and explicitArgumentBindingCandidate.operand0 >= 0
                                                and explicitArgumentBindingCandidate.operand0 < originalResultCount
                                                and explicitArgumentBindingCandidate.nextOperand == callIndex!
                                                and results[explicitArgumentBindingCandidate.operand0].kind == 5
                                                -> if {
                                                    explicitArgumentBinding! >= 0
                                                        and explicitArgumentBindingSearch! != explicitArgumentBinding!
                                                        -> if { true => explicitArgumentBindingAmbiguous! }
                                                    explicitArgumentBindingSearch! => explicitArgumentBinding!
                                                }
                                            explicitArgumentBindingSearch! + 1 => explicitArgumentBindingSearch!
                                        }
                                    explicitArgumentBinding! >= 0 and not explicitArgumentBindingAmbiguous!
                                        -> if {
                                            results[explicitArgumentBinding!] => explicitArgument!
                                            -1 => explicitArgument!.nextOperand
                                            explicitArgument! => results[explicitArgumentBinding!]
                                            results[call!.operand0] => explicitArgumentHead!
                                            explicitArgumentBinding! => explicitArgumentHead!.nextOperand
                                            explicitArgumentHead! => results[call!.operand0]
                                            explicitArgumentBinding! => call!.operand1
                                            call! => results[callIndex!]
                                        }
                                }
                        }
                }
            }
        callIndex! + 1 => callIndex!
    }
}

# A flow-call binding owns the call result, not the receiver value consumed by
# that call. Entry lowering can initially attach both nodes directly to the
# binding and preserve the receiver as operand0. Repair only the exact topology:
# one direct call consumes the current operand and publishes a canonical result
# type. The receiver and result may share an ABI shape while retaining different
# semantic element types, so equality with the provisional binding type is not
# evidence. This is an IR edge invariant, never a spelling or proximity guess.
repairDirectFlowCallBindings results: mut [TypedIrNode; ~] -> Unit {
    0 => bindingIndex!
    bindingIndex! < (results -> len) -> while {
        results[bindingIndex!] => binding!
        binding!.kind == 17
            and binding!.flags != 1
            and binding!.operand0 >= 0
            and binding!.operand0 < (results -> len)
            -> if {
                -1 => exactCallIndex!
                0 => callIndex!
                callIndex! < (results -> len) -> while {
                    results[callIndex!] => call
                    call.kind == 6
                        and call.parent == bindingIndex!
                        and call.operand0 == binding!.operand0
                        and call.typeId >= 0
                        -> if {
                            exactCallIndex! < 0
                                -> if { callIndex! => exactCallIndex! } else { -2 => exactCallIndex! }
                        }
                    callIndex! + 1 => callIndex!
                }
                exactCallIndex! >= 0 -> if {
                    results[exactCallIndex!].typeId => binding!.typeId
                    exactCallIndex! => binding!.operand0
                    binding! => results[bindingIndex!]
                }
            }
        bindingIndex! + 1 => bindingIndex!
    }
}

# A direct async call can itself be the source of a following `await` flow.
# Named Task flows already retain a kind-5 value node between the producer call
# and the result binding. Preserve the same pre-LLVM topology for the direct
# form so scheduling emits the Task first and await owns exactly one join and
# release. Match the direct source child and contextual await target in the
# canonical AST; no function or fixture spelling participates in the repair.
repairDirectAsyncAwaitBindings results: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot -> Unit {
    results -> len => originalNodeCount
    0 => bindingIndex!
    bindingIndex! < originalNodeCount -> while {
        results[bindingIndex!] => binding!
        binding!.kind == 17
            and binding!.operand0 >= 0
            and binding!.operand0 < originalNodeCount
            -> if {
                binding!.operand0 => callIndex
                results[callIndex] => call
                (call.kind == 6 or call.kind == 9)
                    and (call.flags / 8) % 2 == 1
                    and call.sourceModule >= 0
                    and call.sourceModule < (prepared.package.ranges -> len)
                    -> if {
                        prepared.package.ranges[call.sourceModule] => sourceRange
                        call.astNode >= 0 and call.astNode < sourceRange.astCount
                            -> if {
                                prepared.package.nodes[sourceRange.astStart + call.astNode] => callAst
                                callAst.kind == 10
                                    and callAst.parent >= 0
                                    and callAst.parent < sourceRange.astCount
                                    -> if {
                                        prepared.package.nodes[sourceRange.astStart + callAst.parent] => awaitFlowAst
                                        false => directAwaitFlow!
                                        awaitFlowAst.kind == 10
                                            and callAst.firstToken == awaitFlowAst.firstToken
                                            and callAst.start == awaitFlowAst.start
                                            -> if {
                                                0 => awaitTargetSearch!
                                                awaitTargetSearch! < sourceRange.astCount and not directAwaitFlow!
                                                    -> while {
                                                        prepared.package.nodes[sourceRange.astStart + awaitTargetSearch!] => awaitTarget
                                                        awaitTarget.kind == 16
                                                            and awaitTarget.parent == callAst.parent
                                                            and awaitTarget.payloadToken >= 0
                                                            and awaitTarget.payloadToken < sourceRange.tokenCount
                                                            -> if {
                                                                prepared.package.tokens[sourceRange.tokenStart + awaitTarget.payloadToken] => awaitToken
                                                                prepared.package.sources[call.sourceModule] -> len => awaitSourceLength
                                                                prepared.package.sources[call.sourceModule] -> slice(UIntSize(0), awaitSourceLength) => awaitSourceText
                                                                awaitSourceText -> sourceMatches(awaitToken.span.start, awaitToken.span.length, "await")
                                                                    -> if { true => directAwaitFlow! }
                                                            }
                                                        awaitTargetSearch! + 1 => awaitTargetSearch!
                                                    }
                                            }
                                        directAwaitFlow! -> if {
                                            results -> len => awaitValueIndex
                                            results -> push(TypedIrNode {
                                                kind: 5
                                                parent: bindingIndex!
                                                sourceModule: call.sourceModule
                                                astNode: call.astNode
                                                symbol: -1
                                                targetModule: -1
                                                typeOrigin: call.typeOrigin
                                                typeModule: call.typeModule
                                                typeSymbol: call.typeSymbol
                                                typeId: call.typeId
                                                typeKind: call.typeKind
                                                typeFlags: call.typeFlags
                                                payloadToken: -1
                                                opcode: -1
                                                operand0: callIndex
                                                operand1: -1
                                                nextOperand: -1
                                                flags: 0
                                            })
                                            awaitValueIndex => binding!.operand0
                                            binding! => results[bindingIndex!]
                                        }
                                    }
                            }
                    }
            }
        bindingIndex! + 1 => bindingIndex!
    }
}

appendFunctionResult results: mut [TypedIrNode; ~], functionResult: ref SourceTypedIr -> Unit {
    results -> len => offset
    0 => index!
    index! < (functionResult.nodes -> len) -> while {
        functionResult.nodes[index!] => node!
        node!.parent >= 0 -> if { node!.parent + offset => node!.parent }
        node!.operand0 >= 0 -> if { node!.operand0 + offset => node!.operand0 }
        node!.operand1 >= 0 -> if { node!.operand1 + offset => node!.operand1 }
        node!.nextOperand >= 0 -> if { node!.nextOperand + offset => node!.nextOperand }
        results -> push(node!)
        index! + 1 => index!
    }
}

appendAndReleaseFunctionResults results: mut [TypedIrNode; ~], functionResults: mut [SourceTypedIr; ~] -> Unit {
    0 => resultIndex!
    resultIndex! < (functionResults -> len) -> while {
        results -> appendFunctionResult(functionResults[resultIndex!])
        SourceTypedIr { nodes: [TypedIrNode; ~] } => functionResults[resultIndex!]
        resultIndex! + 1 => resultIndex!
    }
}

# A trailing console consumer can be resolved before its value-producing `if`
# is lowered. In that provisional shape operand0 names the owner function.
# Reconnect only a control value contained by the same source flow; unrelated
# controls in the function must never become implicit console arguments.
repairTrailingConsoleControlResults results: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot -> Unit {
    0 => consoleIndex!
    consoleIndex! < (results -> len) -> while {
        results[consoleIndex!] => console!
        console! -> isConsoleRuntimeCall => consoleCall
        consoleCall and console!.operand0 >= 0
            and console!.operand0 < (results -> len)
            and (results[console!.operand0].kind == 0
            or results[console!.operand0].kind == 11
            or (results[console!.operand0].kind == 9 and results[console!.operand0].opcode == -1))
            and console!.sourceModule >= 0
            and console!.sourceModule < (prepared.package.ranges -> len)
            -> if {
                prepared.package.ranges[console!.sourceModule] => sourceRange
                console!.astNode >= 0 and console!.astNode < sourceRange.astCount
                    -> if {
                        prepared.package.nodes[sourceRange.astStart + console!.astNode] => consoleAst
                        consoleAst.start => consoleStart
                        consoleAst.start + consoleAst.length => consoleEnd
                        -1 => controlIndex!
                        UIntSize(0) => controlEnd!
                        0 => candidateIndex!
                        candidateIndex! < (results -> len) -> while {
                            results[candidateIndex!] => candidate
                            candidate.sourceModule == console!.sourceModule
                                and candidate.parent == console!.operand0
                                and (candidate.kind == 18
                                or candidate.kind == 27
                                or candidate.kind == 33
                                or candidate.kind == 34)
                                and candidate.astNode >= 0
                                and candidate.astNode < sourceRange.astCount
                                -> if {
                                    prepared.package.nodes[sourceRange.astStart + candidate.astNode] => candidateAst
                                    candidateAst.start => candidateStart
                                    candidateAst.start + candidateAst.length => candidateEnd
                                    candidateStart >= consoleStart
                                        and candidateEnd <= consoleEnd
                                        and (controlIndex! < 0 or candidateEnd >= controlEnd!)
                                        -> if {
                                            candidateIndex! => controlIndex!
                                            candidateEnd => controlEnd!
                                        }
                                }
                            candidateIndex! + 1 => candidateIndex!
                        }
                        controlIndex! >= 0 -> if {
                            controlIndex! => console!.operand0
                            console! => results[consoleIndex!]
                        }
                    }
            }
        consoleIndex! + 1 => consoleIndex!
    }
}

sealLateNominalMemberTypes results: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], recursiveTypeFlags: ref [Int; ~], changedTypeIndices: mut [Int; ~] -> Unit {
    0 => memberIndex!
    memberIndex! < (results -> len) -> while {
        results[memberIndex!] => member!
        member!.kind == 13
            and member!.operand0 >= 0
            and member!.operand0 < (results -> len)
            and results[member!.operand0].typeId >= 0
            -> if {
                results[member!.operand0].typeId => ownerType!
                frozenRecursiveSemanticTypes[ownerType!].kind == 8
                    -> if { frozenRecursiveSemanticTypes[ownerType!].first => ownerType! }
                prepared.package.ranges[member!.sourceModule] => memberRange
                prepared.package.nodes[memberRange.astStart + member!.astNode] => memberAst
                -1 => memberNameToken!
                memberAst.firstToken => tokenIndex!
                tokenIndex! < memberAst.firstToken + memberAst.tokenCount
                    -> while {
                        prepared.package.tokens[memberRange.tokenStart + tokenIndex!].kind == grammar.tokenIdIdentifier()
                            -> if { tokenIndex! => memberNameToken! }
                        tokenIndex! + 1 => tokenIndex!
                    }
                0 => fieldIndex!
                false => resolved!
                fieldIndex! < (recursiveTypes.fields -> len) and not resolved!
                    -> while {
                        recursiveTypes.fields[fieldIndex!] => field
                        field.ordinal == member!.symbol => fieldMatches!
                        memberNameToken! >= 0 and field.status == 0 and field.ownerType == ownerType!
                            -> if {
                                prepared.package.ranges[field.sourceModule] => fieldRange
                                field.labelToken => fieldNameToken!
                                fieldNameToken! < 0 and field.fieldSymbol >= 0
                                    -> if {
                                        prepared.package.symbols[fieldRange.symbolStart + field.fieldSymbol].nameToken => fieldNameToken!
                                    }
                                fieldNameToken! >= 0 -> if {
                                    prepared.package.tokens[memberRange.tokenStart + memberNameToken!] => memberName
                                    prepared.package.tokens[fieldRange.tokenStart + fieldNameToken!] => fieldName
                                    memberName.span.length == fieldName.span.length => fieldMatches!
                                    UIntSize(0) => byteIndex!
                                    fieldMatches! and byteIndex! < memberName.span.length
                                        -> while {
                                            (prepared.package.sources[member!.sourceModule] -> byte(memberName.span.start + byteIndex!)) != (prepared.package.sources[field.sourceModule] -> byte(fieldName.span.start + byteIndex!))
                                                -> if { false => fieldMatches! }
                                            byteIndex! + 1 => byteIndex!
                                        }
                                }
                            }
                        field.status == 0 and field.ownerType == ownerType! and fieldMatches!
                            -> if {
                                field.ordinal => member!.symbol
                                field.sourceModule => member!.targetModule
                                field.fieldType => member!.typeId
                                frozenRecursiveSemanticTypes[field.fieldType] => valueType
                                valueType.kind => member!.typeKind
                                valueType.origin => member!.typeOrigin
                                valueType.module => member!.typeModule
                                valueType.symbol => member!.typeSymbol
                                recursiveTypeFlags[field.fieldType] => member!.typeFlags
                                member! => results[memberIndex!]
                                changedTypeIndices -> push(memberIndex!)
                                true => resolved!
                            }
                        fieldIndex! + 1 => fieldIndex!
                    }
            }
        memberIndex! + 1 => memberIndex!
    }
}

# Late call/control repairs can change exact producer types after the ordinary
# reference pass. Keep this final fixed point outside the main lowering
# declaration so the ordering contract does not grow that already-large stage.
sealLateTypes results: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], recursiveTypeFlags: ref [Int; ~] -> Unit {
    [Int; ~] => changedTypeIndices!
    0 => bindingIndex!
    bindingIndex! < (results -> len) -> while {
        results[bindingIndex!] => binding!
        binding!.kind == 17
            and binding!.operand0 >= 0
            and binding!.operand0 < (results -> len)
            and results[binding!.operand0].typeId >= 0
            -> if {
                results[binding!.operand0] => value
                binding!.typeId != value.typeId
                    or binding!.typeKind != value.typeKind
                    or binding!.typeOrigin != value.typeOrigin
                    or binding!.typeModule != value.typeModule
                    or binding!.typeSymbol != value.typeSymbol
                    or binding!.typeFlags != value.typeFlags
                    -> if { changedTypeIndices! -> push(bindingIndex!) }
                value.typeId => binding!.typeId
                value.typeKind => binding!.typeKind
                value.typeOrigin => binding!.typeOrigin
                value.typeModule => binding!.typeModule
                value.typeSymbol => binding!.typeSymbol
                value.typeFlags => binding!.typeFlags
                binding! => results[bindingIndex!]
            }
        bindingIndex! + 1 => bindingIndex!
    }
    0 => referenceIndex!
    referenceIndex! < (results -> len) -> while {
        results[referenceIndex!] => reference!
        reference!.kind == 5
            and reference!.operand0 >= 0
            and reference!.operand0 < (results -> len)
            and results[reference!.operand0].kind == 17
            and results[reference!.operand0].typeId >= 0
            -> if {
                results[reference!.operand0] => binding
                reference!.typeId != binding.typeId
                    or reference!.typeKind != binding.typeKind
                    or reference!.typeOrigin != binding.typeOrigin
                    or reference!.typeModule != binding.typeModule
                    or reference!.typeSymbol != binding.typeSymbol
                    or reference!.typeFlags != binding.typeFlags
                    -> if { changedTypeIndices! -> push(referenceIndex!) }
                binding.typeId => reference!.typeId
                binding.typeKind => reference!.typeKind
                binding.typeOrigin => reference!.typeOrigin
                binding.typeModule => reference!.typeModule
                binding.typeSymbol => reference!.typeSymbol
                binding.typeFlags => reference!.typeFlags
                reference! => results[referenceIndex!]
            }
        referenceIndex! + 1 => referenceIndex!
    }
    results -> sealLateNominalMemberTypes(prepared, recursiveTypes, frozenRecursiveSemanticTypes, recursiveTypeFlags, changedTypeIndices!)
    # The exact edge seal can expose a wider operand after the earlier
    # arithmetic pass. Reapply widest-integer typing, then synchronize aliases.
    true => arithmeticChanged!
    arithmeticChanged! -> while {
        false => arithmeticChanged!
        0 => arithmeticIndex!
        arithmeticIndex! < (results -> len) -> while {
            results[arithmeticIndex!] => arithmetic!
            arithmetic!.kind == 8
                and arithmetic!.opcode >= grammar.tokenIdPlus()
                and arithmetic!.opcode <= grammar.tokenIdPercent()
                and arithmetic!.operand0 >= 0
                and arithmetic!.operand0 < (results -> len)
                and arithmetic!.operand1 >= 0
                and arithmetic!.operand1 < (results -> len)
                -> if {
                    results[arithmetic!.operand0] => left
                    results[arithmetic!.operand1] => right
                    left.typeSymbol -> integerTypeRank => leftRank
                    right.typeSymbol -> integerTypeRank => rightRank
                    left => canonical!
                    rightRank > leftRank -> if { right => canonical! }
                    (leftRank > 0 or rightRank > 0) and arithmetic!.typeId != canonical!.typeId
                        -> if {
                            canonical!.typeId => arithmetic!.typeId
                            canonical!.typeKind => arithmetic!.typeKind
                            canonical!.typeOrigin => arithmetic!.typeOrigin
                            canonical!.typeModule => arithmetic!.typeModule
                            canonical!.typeSymbol => arithmetic!.typeSymbol
                            canonical!.typeFlags => arithmetic!.typeFlags
                            arithmetic! => results[arithmeticIndex!]
                            true => arithmeticChanged!
                        }
                }
            arithmeticIndex! + 1 => arithmeticIndex!
        }
    }
    0 => arithmeticBindingIndex!
    arithmeticBindingIndex! < (results -> len) -> while {
        results[arithmeticBindingIndex!] => binding!
        binding!.kind == 17
            and binding!.operand0 >= 0
            and binding!.operand0 < (results -> len)
            and results[binding!.operand0].typeId >= 0
            -> if {
                results[binding!.operand0] => value
                value.typeId => binding!.typeId
                value.typeKind => binding!.typeKind
                value.typeOrigin => binding!.typeOrigin
                value.typeModule => binding!.typeModule
                value.typeSymbol => binding!.typeSymbol
                value.typeFlags => binding!.typeFlags
                binding! => results[arithmeticBindingIndex!]
            }
        arithmeticBindingIndex! + 1 => arithmeticBindingIndex!
    }
    0 => arithmeticReferenceIndex!
    arithmeticReferenceIndex! < (results -> len) -> while {
        results[arithmeticReferenceIndex!] => reference!
        reference!.kind == 5
            and reference!.operand0 >= 0
            and reference!.operand0 < (results -> len)
            and results[reference!.operand0].kind == 17
            and results[reference!.operand0].typeId >= 0
            -> if {
                results[reference!.operand0] => binding
                binding.typeId => reference!.typeId
                binding.typeKind => reference!.typeKind
                binding.typeOrigin => reference!.typeOrigin
                binding.typeModule => reference!.typeModule
                binding.typeSymbol => reference!.typeSymbol
                binding.typeFlags => reference!.typeFlags
                reference! => results[arithmeticReferenceIndex!]
            }
        arithmeticReferenceIndex! + 1 => arithmeticReferenceIndex!
    }
}

sealFinalIndexTypes nodes: mut [TypedIrNode; ~], frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], recursiveTypeFlags: ref [Int; ~] -> Unit {
    0 => indexNodeIndex!
    indexNodeIndex! < (nodes -> len) -> while {
        nodes[indexNodeIndex!] => indexNode!
        indexNode!.kind == 15 and indexNode!.operand0 >= 0
            -> if {
                nodes[indexNode!.operand0] => indexContainer
                indexContainer.typeId >= 0 -> if {
                    frozenRecursiveSemanticTypes[indexContainer.typeId] => containerType!
                    containerType!.kind == 8 and containerType!.first >= 0
                        -> if {
                            frozenRecursiveSemanticTypes[containerType!.first] => containerType!
                        }
                    -1 => elementTypeId!
                    containerType!.kind == 2 or containerType!.kind == 3 or containerType!.kind == 4
                        -> if { containerType!.first => elementTypeId! }
                    containerType!.kind == 5 -> if { containerType!.second => elementTypeId! }
                    elementTypeId! >= 0 -> if {
                        frozenRecursiveSemanticTypes[elementTypeId!] => elementType
                        elementTypeId! => indexNode!.typeId
                        elementType.kind => indexNode!.typeKind
                        elementType.origin => indexNode!.typeOrigin
                        elementType.module => indexNode!.typeModule
                        elementType.symbol => indexNode!.typeSymbol
                        recursiveTypeFlags[elementTypeId!] => indexNode!.typeFlags
                    }
                }
                indexNode! => nodes[indexNodeIndex!]
            }
        indexNodeIndex! + 1 => indexNodeIndex!
    }
}
# Resolve a trait prefix through its declaring module, not its last spelling.
# Import aliases can differ between the call and impl source fragments.
traitIdentityAtPath sourceIndex: Int, pathIndex: Int, nameToken: Int, prepared: ref semanticContext.SemanticSnapshot -> Int {
    prepared.package.sources[sourceIndex] -> len => sourceLength
    prepared.package.sources[sourceIndex] -> slice(UIntSize(0), sourceLength) => sourceText
    prepared.package.ranges[sourceIndex] => sourceRange
    prepared.package.nodes[sourceRange.astStart + pathIndex] => path
    prepared.package.tokens[sourceRange.tokenStart + nameToken] => name
    prepared.package.sources[sourceIndex] -> slice(name.span.start, name.span.length) => traitName
    UInt64(0) => moduleHash!
    false => moduleFound!
    name.span.start == path.start -> if {
        prepared.modules -> each identity {
            identity.sourceIndex == sourceIndex -> if {
                identity.pathHash => moduleHash!
                true => moduleFound!
            }
        }
    } else {
        prepared.package.sources[sourceIndex] -> slice(path.start, name.span.start - path.start - 1) => prefix
        prepared.imports -> each edge {
            edge.sourceModule == sourceIndex and edge.aliasToken >= 0
                -> if {
                    prepared.package.tokens[sourceRange.tokenStart + edge.aliasToken] => alias
                    sourceMatches(sourceText, alias.span.start, alias.span.length, prefix)
                        -> if {
                            edge.targetHash => moduleHash!
                            true => moduleFound!
                        }
                }
        }
        not moduleFound! -> if {
            prepared.modules -> each identity {
                prepared.package.sources[identity.sourceIndex] -> len => identityLength
                prepared.package.sources[identity.sourceIndex] -> slice(UIntSize(0), identityLength) => identityText
                sourceMatches(identityText, identity.pathStart, identity.pathLength, prefix)
                    -> if {
                        identity.pathHash => moduleHash!
                        true => moduleFound!
                    }
            }
        }
    }
    -1 => result!
    moduleFound! -> if {
        prepared.modules -> each identity {
            identity.pathHash == moduleHash! -> if {
                prepared.package.ranges[identity.sourceIndex] => range
                prepared.package.sources[identity.sourceIndex] -> len => identityLength
                prepared.package.sources[identity.sourceIndex] -> slice(UIntSize(0), identityLength) => identityText
                0 => symbolIndex!
                symbolIndex! < range.symbolCount -> while {
                    prepared.package.symbols[range.symbolStart + symbolIndex!] => symbol
                    symbol.kind == 5 and symbol.nameToken >= 0 -> if {
                        prepared.package.tokens[range.tokenStart + symbol.nameToken] => declared
                        sourceMatches(identityText, declared.span.start, declared.span.length, traitName)
                            -> if { range.symbolStart + symbolIndex! => result! }
                    }
                    symbolIndex! + 1 => symbolIndex!
                }
            }
        }
    }
    result!
}

resolveFinalProjectedMethods nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], recursiveTypeFlags: ref [Int; ~] -> Unit {
    # Index the canonical self parameter once for this pass. A call-site scan of
    # all functions would make owner validation quadratic on compiler inputs.
    [Int; ~] => ownerTypes!
    0 => ownerSymbolIndex!
    ownerSymbolIndex! < (prepared.package.symbols -> len)
        -> while {
            ownerTypes! -> push(-1)
            ownerSymbolIndex! + 1 => ownerSymbolIndex!
        }
    0 => ownerFunctionIndex!
    ownerFunctionIndex! < (nodes -> len) -> while {
        nodes[ownerFunctionIndex!] => function
        function.kind == 0 and function.sourceModule >= 0
            and function.sourceModule < (prepared.package.ranges -> len)
            and function.symbol >= 0
            and function.operand1 >= 0 and function.operand1 < (nodes -> len)
            -> if {
                prepared.package.ranges[function.sourceModule] => range
                function.symbol < range.symbolCount
                    and prepared.package.symbols[range.symbolStart + function.symbol].kind == 31
                    and ownerTypes![range.symbolStart + function.symbol] < 0
                    -> if {
                        frozenRecursiveSemanticTypes -> typeIds.materializedReadTypeId(nodes[function.operand1].typeId)
                            => ownerTypes![range.symbolStart + function.symbol]
                    }
            }
        ownerFunctionIndex! + 1 => ownerFunctionIndex!
    }
    0 => finalProjectedMethodIndex!
    finalProjectedMethodIndex! < (nodes -> len)
        -> while {
            nodes[finalProjectedMethodIndex!] => finalProjectedMethod!
            false => finalProjectedControlProducerWrapper!
            finalProjectedMethod!.sourceModule >= 0
                and finalProjectedMethod!.sourceModule < (prepared.package.ranges -> len)
                and finalProjectedMethod!.astNode >= 0
                -> if {
                    prepared.package.ranges[finalProjectedMethod!.sourceModule] => finalProjectedEligibilityRange
                    finalProjectedMethod!.astNode < finalProjectedEligibilityRange.astCount
                        -> if {
                            prepared.controlProducerWrapperByAst[finalProjectedEligibilityRange.astStart + finalProjectedMethod!.astNode]
                                => finalProjectedControlProducerWrapper!
                        }
                }
            finalProjectedMethod!.kind == 6 or finalProjectedMethod!.kind == 9
                => finalProjectedCall
            finalProjectedMethod!.symbol < 0 and finalProjectedMethod!.targetModule < 0
                => finalProjectedUnresolved
            finalProjectedMethodIndex! -> resolvedCallNeedsExactReceiver(nodes, prepared, ownerTypes!, frozenRecursiveSemanticTypes)
                => finalProjectedArityMismatch
            finalProjectedUnresolved or finalProjectedArityMismatch
                => finalProjectedNeedsResolution
            finalProjectedCall and finalProjectedNeedsResolution
                and not finalProjectedControlProducerWrapper!
                and (finalProjectedMethod!.opcode == -1
                or finalProjectedMethod!.opcode == -225
                or finalProjectedMethod!.opcode == -226
                or finalProjectedMethod!.opcode == -215
                or finalProjectedMethod!.opcode == -230)
                and finalProjectedMethod!.operand0 >= 0
                and finalProjectedMethod!.operand0 < (nodes -> len)
                -> if {
                    nodes[finalProjectedMethod!.operand0] => finalProjectedReceiver
                    finalProjectedReceiver.typeId => finalProjectedOwnerTypeId!
                    finalProjectedOwnerTypeId! >= 0
                        and frozenRecursiveSemanticTypes[finalProjectedOwnerTypeId!].kind == 8
                        -> if {
                            frozenRecursiveSemanticTypes[finalProjectedOwnerTypeId!].first
                                => finalProjectedOwnerTypeId!
                        }
                    finalProjectedOwnerTypeId! >= 0
                        and frozenRecursiveSemanticTypes[finalProjectedOwnerTypeId!].kind == 1
                        and frozenRecursiveSemanticTypes[finalProjectedOwnerTypeId!].module >= 0
                        and frozenRecursiveSemanticTypes[finalProjectedOwnerTypeId!].symbol >= 0
                        -> if {
                            frozenRecursiveSemanticTypes[finalProjectedOwnerTypeId!] => finalProjectedOwnerType
                            finalProjectedOwnerType.module => finalProjectedOwnerSource
                            finalProjectedOwnerType.symbol => finalProjectedOwnerSymbol
                            prepared.package.ranges[finalProjectedOwnerSource] => finalProjectedOwnerRange
                            prepared.package.symbols[finalProjectedOwnerRange.symbolStart + finalProjectedOwnerSymbol]
                                => finalProjectedOwnerDeclaration
                            prepared.package.tokens[finalProjectedOwnerRange.tokenStart + finalProjectedOwnerDeclaration.nameToken]
                                => finalProjectedOwnerName
                            prepared.package.sources[finalProjectedOwnerSource] -> len => finalProjectedOwnerLength
                            prepared.package.sources[finalProjectedOwnerSource]
                                -> slice(UIntSize(0), finalProjectedOwnerLength) => finalProjectedOwnerText

                            prepared.package.ranges[finalProjectedMethod!.sourceModule] => finalProjectedCallRange
                            prepared.package.nodes[finalProjectedCallRange.astStart + finalProjectedMethod!.astNode]
                                => finalProjectedCallAst
                            -1 => finalProjectedCallNameToken!
                            -1 => finalProjectedTraitNameToken!
                            -1 => finalProjectedTraitIdentity!
                            UIntSize(0) => finalProjectedReceiverEnd!
                            finalProjectedReceiver.astNode >= 0
                                and finalProjectedReceiver.astNode < finalProjectedCallRange.astCount
                                -> if {
                                    prepared.package.nodes[finalProjectedCallRange.astStart + finalProjectedReceiver.astNode]
                                        => finalProjectedReceiverAst
                                    finalProjectedReceiverAst.start + finalProjectedReceiverAst.length
                                        => finalProjectedReceiverEnd!
                                }
                            false => finalProjectedTargetTokenFound!
                            UIntSize(0) => finalProjectedTargetTokenStart!
                            finalProjectedCallAst.firstToken => finalProjectedCallTokenSearch!
                            finalProjectedCallTokenSearch! < finalProjectedCallAst.firstToken + finalProjectedCallAst.tokenCount
                                -> while {
                                    prepared.package.tokens[finalProjectedCallRange.tokenStart + finalProjectedCallTokenSearch!]
                                        => finalProjectedCallToken
                                    finalProjectedCallToken.kind == grammar.tokenIdIdentifier()
                                        and finalProjectedCallToken.span.start >= finalProjectedReceiverEnd!
                                        and (not finalProjectedTargetTokenFound!
                                        or finalProjectedCallToken.span.start < finalProjectedTargetTokenStart!)
                                        -> if {
