                                                                                    }
                                                                                traitPathIndex! + 1 => traitPathIndex!
                                                                            }
                                                                        declaredTraitPath! >= 0 and finalProjectedTraitIdentity! >= 0
                                                                            -> if {
                                                                                prepared.package.nodes[finalProjectedMethodRange.astStart + declaredTraitPath!] => declaredPath
                                                                                -1 => declaredNameToken!
                                                                                declaredPath.firstToken => declaredTokenIndex!
                                                                                declaredTokenIndex! < declaredPath.firstToken + declaredPath.tokenCount
                                                                                    -> while {
                                                                                        prepared.package.tokens[finalProjectedMethodRange.tokenStart + declaredTokenIndex!].kind == grammar.tokenIdIdentifier()
                                                                                            -> if { declaredTokenIndex! => declaredNameToken! }
                                                                                        declaredTokenIndex! + 1 => declaredTokenIndex!
                                                                                    }
                                                                                declaredNameToken! >= 0 -> if {
                                                                                    finalProjectedMethodSource -> traitIdentityAtPath(declaredTraitPath!, declaredNameToken!, prepared) => declaredIdentity
                                                                                    declaredIdentity == finalProjectedTraitIdentity! => requestedTraitMatches!
                                                                                }
                                                                            }
                                                                        -1 => ownerPath!
                                                                        UIntSize(0) => ownerPathStart!
                                                                        0 => pathIndex!
                                                                        pathIndex! < finalProjectedMethodRange.astCount
                                                                            -> while {
                                                                                prepared.package.nodes[finalProjectedMethodRange.astStart + pathIndex!] => path
                                                                                path.kind == 16 and path.parent == finalProjectedImpl.astNode
                                                                                    and (ownerPath! < 0 or path.start > ownerPathStart!)
                                                                                    -> if {
                                                                                        pathIndex! => ownerPath!
                                                                                        path.start => ownerPathStart!
                                                                                    }
                                                                                pathIndex! + 1 => pathIndex!
                                                                            }
                                                                        ownerPath! >= 0 -> if {
                                                                            prepared.package.nodes[finalProjectedMethodRange.astStart + ownerPath!] => path
                                                                            path.firstToken => tokenIndex!
                                                                            tokenIndex! < path.firstToken + path.tokenCount
                                                                                -> while {
                                                                                    prepared.package.tokens[finalProjectedMethodRange.tokenStart + tokenIndex!].kind == grammar.tokenIdIdentifier()
                                                                                        -> if { tokenIndex! => implOwnerToken! }
                                                                                    tokenIndex! + 1 => tokenIndex!
                                                                                }
                                                                        } else { false => requestedTraitMatches! }
                                                                    }
                                                                    prepared.package.tokens[finalProjectedMethodRange.tokenStart + implOwnerToken!]
                                                                        => finalProjectedImplName
                                                                    prepared.package.tokens[finalProjectedMethodRange.tokenStart + finalProjectedCandidate.nameToken]
                                                                        => finalProjectedCandidateName
                                                                    finalProjectedImplName.span.length == finalProjectedOwnerName.span.length
                                                                        => finalProjectedOwnerEqual!
                                                                    UIntSize(0) => finalProjectedOwnerByte!
                                                                    finalProjectedOwnerEqual!
                                                                        and finalProjectedOwnerByte! < finalProjectedOwnerName.span.length
                                                                        -> while {
                                                                            (finalProjectedMethodText -> byte(finalProjectedImplName.span.start + finalProjectedOwnerByte!)) != (finalProjectedOwnerText -> byte(finalProjectedOwnerName.span.start + finalProjectedOwnerByte!))
                                                                                -> if { false => finalProjectedOwnerEqual! }
                                                                            finalProjectedOwnerByte! + 1 => finalProjectedOwnerByte!
                                                                        }
                                                                    finalProjectedCandidateName.span.length == finalProjectedCallName.span.length
                                                                        => finalProjectedNameEqual!
                                                                    UIntSize(0) => finalProjectedNameByte!
                                                                    finalProjectedNameEqual!
                                                                        and finalProjectedNameByte! < finalProjectedCallName.span.length
                                                                        -> while {
                                                                            (finalProjectedMethodText -> byte(finalProjectedCandidateName.span.start + finalProjectedNameByte!)) != (prepared.package.sources[finalProjectedMethod!.sourceModule] -> byte(finalProjectedCallName.span.start + finalProjectedNameByte!))
                                                                                -> if { false => finalProjectedNameEqual! }
                                                                            finalProjectedNameByte! + 1 => finalProjectedNameByte!
                                                                        }
                                                                    finalProjectedOwnerEqual! and finalProjectedNameEqual! and requestedTraitMatches!
                                                                        -> if {
                                                                            finalProjectedMethodFound! -> if {
                                                                                finalProjectedTargetSource! != finalProjectedMethodSource
                                                                                    or finalProjectedTargetSymbol! != finalProjectedSymbolSearch!
                                                                                    -> if { true => finalProjectedMethodAmbiguous! }
                                                                            } else {
                                                                                true => finalProjectedMethodFound!
                                                                                finalProjectedMethodSource => finalProjectedTargetSource!
                                                                                finalProjectedSymbolSearch! => finalProjectedTargetSymbol!
                                                                            }
                                                                        }
                                                                }
                                                            finalProjectedSymbolSearch! + 1 => finalProjectedSymbolSearch!
                                                        }
                                                }
                                            finalProjectedModuleSearch! + 1 => finalProjectedModuleSearch!
                                        }
                                }
                            false => finalProjectedCandidateArityMatches!
                            finalProjectedMethodFound! and not finalProjectedMethodAmbiguous!
                                -> if {
                                    finalProjectedMethod! => finalProjectedCandidateCall!
                                    finalProjectedTargetSource! => finalProjectedCandidateCall!.targetModule
                                    finalProjectedTargetSymbol! => finalProjectedCandidateCall!.symbol
                                    finalProjectedCandidateCall! -> resolvedCallRuntimeParameterCount(prepared)
                                        => finalProjectedCandidateParameterCount
                                    0 => finalProjectedCandidateArgumentCount!
                                    finalProjectedCandidateCall!.operand0 => finalProjectedCandidateArgumentIndex!
                                    finalProjectedCandidateArgumentIndex! >= 0
                                        and finalProjectedCandidateArgumentIndex! < (nodes -> len)
                                        and finalProjectedCandidateArgumentCount! <= finalProjectedCandidateParameterCount
                                        -> while {
                                            finalProjectedCandidateArgumentCount! + 1
                                                => finalProjectedCandidateArgumentCount!
                                            nodes[finalProjectedCandidateArgumentIndex!].nextOperand
                                                => finalProjectedCandidateArgumentIndex!
                                        }
                                    finalProjectedCandidateArgumentCount! == finalProjectedCandidateParameterCount
                                        => finalProjectedCandidateArityMatches!
                                }
                            finalProjectedMethodFound! and not finalProjectedMethodAmbiguous!
                                and finalProjectedCandidateArityMatches!
                                -> if {
                                    6 => finalProjectedMethod!.kind
                                    finalProjectedTargetSource! => finalProjectedMethod!.targetModule
                                    finalProjectedTargetSymbol! => finalProjectedMethod!.symbol
                                    finalProjectedTargetSource! -> functionResultTypeId(finalProjectedTargetSymbol!, prepared, recursiveTypes, frozenRecursiveSemanticTypes)
                                        => finalProjectedResultTypeId
                                    finalProjectedResultTypeId >= 0 -> if {
                                        frozenRecursiveSemanticTypes[finalProjectedResultTypeId]
                                            => finalProjectedResultType
                                        finalProjectedResultType.origin => finalProjectedMethod!.typeOrigin
                                        finalProjectedResultType.module => finalProjectedMethod!.typeModule
                                        finalProjectedResultType.symbol => finalProjectedMethod!.typeSymbol
                                        finalProjectedResultTypeId => finalProjectedMethod!.typeId
                                        finalProjectedResultType.kind => finalProjectedMethod!.typeKind
                                        recursiveTypeFlags[finalProjectedResultTypeId] => finalProjectedMethod!.typeFlags
                                    }
                                    finalProjectedMethod! => nodes[finalProjectedMethodIndex!]
                                }
                        }
                }
            finalProjectedMethodIndex! + 1 => finalProjectedMethodIndex!
        }
}
sealFinalProjectedMatchSubjectsAndPayloads nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], recursiveTypeFlags: ref [Int; ~] -> Unit {
    # This pass changes subjects and payload types, not candidate ownership or
    # source AST links. Index those stable relations; read types and predicates
    # from the live nodes below. Slot zero represents the root owner (-1).
    [Int; ~] => projectedOwnerHeads!
    [Int; ~] => projectedCandidateSlots!
    [Int; ~] => projectedCandidateNext!
    0 => projectedOwnerSeed!
    projectedOwnerSeed! <= (nodes -> len) -> while {
        projectedOwnerHeads! -> push(-1)
        projectedOwnerSeed! + 1 => projectedOwnerSeed!
    }
    0 => projectedCandidateSeed!
    projectedCandidateSeed! < (nodes -> len) -> while {
        nodes[projectedCandidateSeed!] => indexedCandidate
        indexedCandidate.kind == 5 or indexedCandidate.kind == 6 or indexedCandidate.kind == 13
            -> if {
                indexedCandidate.parent >= -1 and indexedCandidate.parent < (nodes -> len)
                    -> if {
                        projectedCandidateSlots! -> len => directEntry
                        projectedCandidateSlots! -> push(projectedCandidateSeed!)
                        projectedCandidateNext! -> push(projectedOwnerHeads![indexedCandidate.parent + 1])
                        directEntry => projectedOwnerHeads![indexedCandidate.parent + 1]
                    }
                -2 => projectedOuterOwner!
                indexedCandidate.parent >= 0 and indexedCandidate.parent < (nodes -> len)
                    -> if {
                        nodes[indexedCandidate.parent] => indexedWrapper
                        indexedWrapper.kind == 9 and indexedWrapper.opcode == -1
                            -> if { indexedWrapper.parent => projectedOuterOwner! }
                        indexedWrapper.kind == 17
                            and indexedWrapper.operand0 == projectedCandidateSeed!
                            and indexedWrapper.nextOperand >= 0
                            and indexedWrapper.nextOperand < (nodes -> len)
                            -> if {
                                nodes[indexedWrapper.nextOperand] => indexedRead
                                indexedRead.kind == 5 and indexedRead.parent == indexedWrapper.parent
                                    -> if { indexedWrapper.parent => projectedOuterOwner! }
                            }
                    }
                projectedOuterOwner! >= -1 and projectedOuterOwner! < (nodes -> len)
                    and projectedOuterOwner! != indexedCandidate.parent
                    -> if {
                        projectedCandidateSlots! -> len => outerEntry
                        projectedCandidateSlots! -> push(projectedCandidateSeed!)
                        projectedCandidateNext! -> push(projectedOwnerHeads![projectedOuterOwner! + 1])
                        outerEntry => projectedOwnerHeads![projectedOuterOwner! + 1]
                    }
            }
        projectedCandidateSeed! + 1 => projectedCandidateSeed!
    }
    # The first pattern token belongs to the match AST, not to its IR slot.
    [Int; ~] => projectedPatternTokens!
    0 => projectedPatternSeed!
    projectedPatternSeed! < (prepared.package.nodes -> len)
        -> while {
            projectedPatternTokens! -> push(-1)
            projectedPatternSeed! + 1 => projectedPatternSeed!
        }
    0 => projectedSourceIndex!
    projectedSourceIndex! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[projectedSourceIndex!] => indexedPatternRange
            0 => projectedPatternIndex!
            projectedPatternIndex! < indexedPatternRange.astCount
                -> while {
                    prepared.package.nodes[indexedPatternRange.astStart + projectedPatternIndex!] => indexedPattern
                    indexedPattern.kind == 59 and indexedPattern.payloadToken >= 0
                        -> if {
                            indexedPattern.parent => indexedPatternOwner!
                            indexedPatternOwner! >= 0
                                and prepared.package.nodes[indexedPatternRange.astStart + indexedPatternOwner!].kind == 70
                                -> if {
                                    prepared.package.nodes[indexedPatternRange.astStart + indexedPatternOwner!].parent => indexedPatternOwner!
                                }
                            indexedPatternOwner! >= 0
                                and prepared.package.nodes[indexedPatternRange.astStart + indexedPatternOwner!].kind == 58
                                -> if {
                                    prepared.package.nodes[indexedPatternRange.astStart + indexedPatternOwner!].parent => indexedPatternMatch
                                    indexedPatternMatch >= 0
                                        and projectedPatternTokens![indexedPatternRange.astStart + indexedPatternMatch] < 0
                                        -> if {
                                            indexedPattern.payloadToken => projectedPatternTokens![indexedPatternRange.astStart + indexedPatternMatch]
                                        }
                                }
                        }
                    projectedPatternIndex! + 1 => projectedPatternIndex!
                }
            projectedSourceIndex! + 1 => projectedSourceIndex!
        }
    0 => finalProjectedMatchIndex!
    finalProjectedMatchIndex! < (nodes -> len)
        -> while {
            nodes[finalProjectedMatchIndex!] => finalProjectedMatch!
            finalProjectedMatch!.kind == 27
                and finalProjectedMatch!.sourceModule >= 0
                and finalProjectedMatch!.astNode >= 0
                -> if {
                    prepared.package.ranges[finalProjectedMatch!.sourceModule] => finalProjectedRange
                    prepared.package.nodes[finalProjectedRange.astStart + finalProjectedMatch!.astNode] => finalProjectedMatchAst
                    finalProjectedMatchAst.parent => finalProjectedFlowAstIndex
                    prepared.package.nodes[finalProjectedRange.astStart + finalProjectedFlowAstIndex] => finalProjectedFlowAst
                    projectedPatternTokens![finalProjectedRange.astStart + finalProjectedMatch!.astNode] => finalProjectedPatternToken
                    -1 => finalProjectedSubject!
                    UIntSize(0) => finalProjectedSubjectStart!
                    UIntSize(0) => finalProjectedSubjectEnd!
                    projectedOwnerHeads![finalProjectedMatch!.parent + 1] => finalProjectedCandidateEntry!
                    finalProjectedCandidateEntry! >= 0
                        -> while {
                            projectedCandidateSlots![finalProjectedCandidateEntry!] => finalProjectedCandidateIndex
                            nodes[finalProjectedCandidateIndex] => finalProjectedCandidate
                            false => finalProjectedCandidateUsesBoundSubject!
                            finalProjectedCandidate.parent == finalProjectedMatch!.parent
                                => finalProjectedCandidateSharesOwner!
                            not finalProjectedCandidateSharesOwner!
                                and finalProjectedCandidate.parent >= 0
                                and finalProjectedCandidate.parent < (nodes -> len)
                                -> if {
                                    nodes[finalProjectedCandidate.parent] => finalProjectedCandidateWrapper
                                    finalProjectedCandidateWrapper.kind == 9
                                        and finalProjectedCandidateWrapper.opcode == -1
                                        and finalProjectedCandidateWrapper.parent == finalProjectedMatch!.parent
                                        and finalProjectedCandidateWrapper.nextOperand == finalProjectedMatchIndex!
                                        -> if { true => finalProjectedCandidateSharesOwner! }
                                }
                            not finalProjectedCandidateSharesOwner!
                                and finalProjectedCandidate.parent >= 0
                                and finalProjectedCandidate.parent < (nodes -> len)
                                -> if {
                                    nodes[finalProjectedCandidate.parent] => finalProjectedCandidateBinding
                                    finalProjectedCandidateBinding.kind == 17
                                        and finalProjectedCandidateBinding.parent == finalProjectedMatch!.parent
                                        and finalProjectedCandidateBinding.operand0 == finalProjectedCandidateIndex
                                        and finalProjectedCandidateBinding.nextOperand >= 0
                                        and finalProjectedCandidateBinding.nextOperand < (nodes -> len)
                                        -> if {
                                            nodes[finalProjectedCandidateBinding.nextOperand] => finalProjectedCandidateRead
                                            finalProjectedCandidateRead.kind == 5
                                                and finalProjectedCandidateRead.parent == finalProjectedMatch!.parent
                                                and finalProjectedCandidateRead.operand0 == finalProjectedCandidate.parent
                                                and finalProjectedCandidateRead.nextOperand == finalProjectedMatchIndex!
                                                -> if {
                                                    true => finalProjectedCandidateSharesOwner!
                                                    true => finalProjectedCandidateUsesBoundSubject!
                                                }
                                        }
                                }
                            # Late nominal field recovery can establish the enum
                            # subject after the earlier subject pass. Keep the
                            # complete projection under the same owner, pattern
                            # and source-span contract as resolved call producers.
                            (finalProjectedCandidate.kind == 5 or finalProjectedCandidate.kind == 6 or finalProjectedCandidate.kind == 13)
                                and finalProjectedCandidate.sourceModule == finalProjectedMatch!.sourceModule
                                and finalProjectedCandidateSharesOwner!
                                and finalProjectedCandidate.astNode >= 0
                                and finalProjectedCandidate.typeId >= 0
                                and finalProjectedCandidate.typeId < (frozenRecursiveSemanticTypes -> len)
                                -> if {
                                    prepared.package.nodes[finalProjectedRange.astStart + finalProjectedCandidate.astNode] => finalProjectedCandidateAst
                                    finalProjectedCandidateAst.start + finalProjectedCandidateAst.length => finalProjectedCandidateEnd
                                    frozenRecursiveSemanticTypes -> typeIds.materializedReadTypeId(finalProjectedCandidate.typeId) => finalProjectedCandidateValueTypeId
                                    frozenRecursiveSemanticTypes[finalProjectedCandidateValueTypeId] => finalProjectedCandidateType
                                    false => finalProjectedCandidateEnum!
                                    finalProjectedCandidateType.kind == 7
                                        and finalProjectedCandidateType.origin == 4
                                        and (finalProjectedCandidateType.symbol == 0 or finalProjectedCandidateType.symbol == 1)
                                        -> if { true => finalProjectedCandidateEnum! }
                                    finalProjectedCandidateType.kind == 1 -> if { true => finalProjectedCandidateEnum! }
                                    false => finalProjectedPatternCompatible!
                                    finalProjectedCandidateEnum! and finalProjectedPatternToken >= 0
                                        -> if {
                                            prepared.package.tokens[finalProjectedRange.tokenStart + finalProjectedPatternToken] => finalProjectedPattern
                                            finalProjectedMatch!.sourceModule -> nominalVariantTagForType(finalProjectedCandidateType, finalProjectedPattern, prepared) => finalProjectedPatternTag
                                            finalProjectedPatternTag >= 0 -> if { true => finalProjectedPatternCompatible! }
                                        }
                                    false => finalProjectedCandidateBelongs!
                                    finalProjectedCandidateUsesBoundSubject!
                                        -> if { true => finalProjectedCandidateBelongs! }
                                    finalProjectedCandidate.nextOperand == finalProjectedMatchIndex!
                                        -> if { true => finalProjectedCandidateBelongs! }
                                    finalProjectedCandidate.astNode == finalProjectedFlowAstIndex
                                        or finalProjectedCandidateAst.parent == finalProjectedFlowAstIndex
                                        -> if { true => finalProjectedCandidateBelongs! }
                                    not finalProjectedCandidateBelongs! and finalProjectedCandidateAst.parent >= 0
                                        -> if {
                                            prepared.package.nodes[finalProjectedRange.astStart + finalProjectedCandidateAst.parent] => finalProjectedCandidateOwner
                                            finalProjectedCandidateOwner.kind == 10
                                                and finalProjectedCandidateOwner.parent == finalProjectedFlowAstIndex
                                                and finalProjectedCandidateOwner.start == finalProjectedCandidateAst.start
                                                and finalProjectedCandidateOwner.length == finalProjectedCandidateAst.length
                                                -> if { true => finalProjectedCandidateBelongs! }
                                        }
                                    finalProjectedPatternCompatible!
                                        and (finalProjectedCandidateAst.start >= finalProjectedFlowAst.start
                                        or finalProjectedCandidateUsesBoundSubject!)
                                        and finalProjectedCandidateBelongs!
                                        and finalProjectedCandidateEnd <= finalProjectedMatchAst.start
                                        -> if {
                                            finalProjectedSubject! < 0
                                                or finalProjectedCandidateEnd > finalProjectedSubjectEnd!
                                                or (finalProjectedCandidateEnd == finalProjectedSubjectEnd!
                                                and finalProjectedCandidateAst.start < finalProjectedSubjectStart!)
                                                or (finalProjectedCandidateEnd == finalProjectedSubjectEnd!
                                                and finalProjectedCandidateAst.start == finalProjectedSubjectStart!
                                                and finalProjectedCandidateIndex < finalProjectedSubject!)
                                                -> if {
                                                    finalProjectedCandidateIndex => finalProjectedSubject!
                                                    finalProjectedCandidateAst.start => finalProjectedSubjectStart!
                                                    finalProjectedCandidateEnd => finalProjectedSubjectEnd!
                                                }
                                        }
                                }
                            projectedCandidateNext![finalProjectedCandidateEntry!] => finalProjectedCandidateEntry!
                        }
                    # Replace missing or non-materialized provisional subjects
                    # with the resolved synthesized producer. A later exact
                    # Result-payload edge remains authoritative and may replace
                    # this fallback after propagation binding sealing.
                    finalProjectedSubject! >= 0 and finalProjectedMatch!.operand0 != finalProjectedSubject!
                        -> if {
                            finalProjectedSubject! => finalProjectedMatch!.operand0
                            finalProjectedMatch! => nodes[finalProjectedMatchIndex!]
                        }
                }
            finalProjectedMatchIndex! + 1 => finalProjectedMatchIndex!
        }
    0 => finalProjectedPayloadIndex!
    finalProjectedPayloadIndex! < (nodes -> len)
        -> while {
            nodes[finalProjectedPayloadIndex!] => finalProjectedPayload!
            finalProjectedPayload!.kind == 29 -> if {
                finalProjectedPayloadIndex! -> enumPayloadArmIndex(nodes) => finalProjectedPayloadArmIndex
                finalProjectedPayloadArmIndex >= 0
                    and nodes[finalProjectedPayloadArmIndex].parent >= 0
                    and nodes[nodes[finalProjectedPayloadArmIndex].parent].kind == 27
                    -> if {
                        nodes[finalProjectedPayloadArmIndex] => finalProjectedPayloadArm
                        nodes[finalProjectedPayloadArm.parent] => finalProjectedPayloadMatch
                        -1 => finalProjectedPayloadTypeId!
                        finalProjectedPayloadMatch.operand0 >= 0
                            and nodes[finalProjectedPayloadMatch.operand0].typeId >= 0
                            -> if {
                                frozenRecursiveSemanticTypes[nodes[finalProjectedPayloadMatch.operand0].typeId]
                                    => finalProjectedPayloadSubjectType
                                finalProjectedPayloadSubjectType.kind == 7
                                    and finalProjectedPayloadSubjectType.origin == 4
                                    -> if {
                                        finalProjectedPayloadSubjectType.symbol == 0 -> if {
                                            finalProjectedPayloadSubjectType.first => finalProjectedPayloadTypeId!
                                        }
                                        finalProjectedPayloadSubjectType.symbol == 1 -> if {
                                            finalProjectedPayloadArm.opcode == 0 -> if {
                                                finalProjectedPayloadSubjectType.first => finalProjectedPayloadTypeId!
                                            } else {
                                                finalProjectedPayloadSubjectType.second => finalProjectedPayloadTypeId!
                                            }
                                        }
                                    }
                            }
                        finalProjectedPayloadTypeId! >= 0
                            and finalProjectedPayloadTypeId! < (frozenRecursiveSemanticTypes -> len)
                            -> if {
                                frozenRecursiveSemanticTypes[finalProjectedPayloadTypeId!] => finalProjectedPayloadType
                                finalProjectedPayloadTypeId! => finalProjectedPayload!.typeId
                                finalProjectedPayloadType.kind => finalProjectedPayload!.typeKind
                                finalProjectedPayloadType.origin => finalProjectedPayload!.typeOrigin
                                finalProjectedPayloadType.module => finalProjectedPayload!.typeModule
                                finalProjectedPayloadType.symbol => finalProjectedPayload!.typeSymbol
                                recursiveTypeFlags[finalProjectedPayloadTypeId!] => finalProjectedPayload!.typeFlags
                                finalProjectedPayload! => nodes[finalProjectedPayloadIndex!]
                            }
                    }
            }
            finalProjectedPayloadIndex! + 1 => finalProjectedPayloadIndex!
        }
    0 => finalProjectedPayloadReadIndex!
    finalProjectedPayloadReadIndex! < (nodes -> len)
        -> while {
            nodes[finalProjectedPayloadReadIndex!] => finalProjectedPayloadRead!
            finalProjectedPayloadRead!.kind == 5
                and finalProjectedPayloadRead!.operand0 >= 0
                and nodes[finalProjectedPayloadRead!.operand0].kind == 29
                -> if {
                    nodes[finalProjectedPayloadRead!.operand0] => finalProjectedPayloadBinding
                    finalProjectedPayloadBinding.typeId => finalProjectedPayloadRead!.typeId
                    finalProjectedPayloadBinding.typeKind => finalProjectedPayloadRead!.typeKind
                    finalProjectedPayloadBinding.typeOrigin => finalProjectedPayloadRead!.typeOrigin
                    finalProjectedPayloadBinding.typeModule => finalProjectedPayloadRead!.typeModule
                    finalProjectedPayloadBinding.typeSymbol => finalProjectedPayloadRead!.typeSymbol
                    finalProjectedPayloadBinding.typeFlags => finalProjectedPayloadRead!.typeFlags
                    finalProjectedPayloadRead! => nodes[finalProjectedPayloadReadIndex!]
                }
            finalProjectedPayloadReadIndex! + 1 => finalProjectedPayloadReadIndex!
        }
}
sealFinalEnumArmTagsAndPayloads nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], recursiveTypeFlags: ref [Int; ~] -> Unit {
    0 => finalEnumMatchIndex!
    finalEnumMatchIndex! < (nodes -> len) -> while {
        nodes[finalEnumMatchIndex!] => finalEnumMatch
        # Qualified constructors retain the owner token at payloadToken. Their
        # resolved variant symbol, not that token or call opcode, owns the tag
        # and exact payload contract at this final identity boundary.
        finalEnumMatch.kind == 26 and finalEnumMatch.typeId >= 0
            and finalEnumMatch.typeId < (frozenRecursiveSemanticTypes -> len)
            and finalEnumMatch.operand0 >= 0
            and finalEnumMatch.operand0 < (nodes -> len)
            and finalEnumMatch.targetModule >= 0
            and finalEnumMatch.targetModule < (prepared.package.ranges -> len)
            -> if {
                prepared.package.ranges[finalEnumMatch.targetModule] => constructorRange
