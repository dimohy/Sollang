                        templateIndex! >= 0 -> if {
                            prepared.package.ranges[call.sourceModule] => sourceRange
                            prepared.package.nodes[sourceRange.astStart + call.astNode] => callAst
                            callAst.payloadToken + 1 => tokenIndex!
                            0 => parenDepth!
                            -1 => bodyToken!
                            tokenIndex! < callAst.firstToken + callAst.tokenCount and bodyToken! < 0
                                -> while {
                                    prepared.package.tokens[sourceRange.tokenStart + tokenIndex!].kind => tokenKind
                                    tokenKind == grammar.tokenIdLeftParen() -> if { parenDepth! + 1 => parenDepth! }
                                    tokenKind == grammar.tokenIdRightParen() -> if { parenDepth! - 1 => parenDepth! }
