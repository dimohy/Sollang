                -> if { false => activeCall! }
            owner.kind == 0 and owner.targetModule >= 0
                and owner.targetModule < (prepared.package.ranges -> len) and owner.symbol >= 0
                -> if {
                    prepared.package.ranges[owner.targetModule] => ownerRange
                    prepared.package.symbols[ownerRange.symbolStart + owner.symbol].blockTypeNode >= 0
