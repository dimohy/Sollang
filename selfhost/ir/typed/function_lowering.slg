                false => canonicalPathModule!
                0 => pathModuleSearch!
                pathModuleSearch! < (prepared.modules -> len)
                    -> while {
                        prepared.modules[pathModuleSearch!] => pathModuleIdentity
                        pathModuleIdentity.sourceIndex == pathCall!.targetModule
                            and pathModuleIdentity.pathHash == 7794543808165292697
                            -> if { true => canonicalPathModule! }
                        pathModuleSearch! + 1 => pathModuleSearch!
                    }
                canonicalPathModule! -> if {
                    false => canonicalPathIntrinsic!
                    prepared.package.ranges[pathCall!.targetModule] => pathSourceRange
                    prepared.package.symbols[pathSourceRange.symbolStart + pathCall!.symbol] => pathSymbol
                    (pathSymbol.kind == 7 or pathSymbol.kind == 31)
                        and pathSymbol.flags / 128 % 2 == 1
                        -> if {
                            true => canonicalPathIntrinsic!
                            prepared.package.sources[pathCall!.targetModule] -> len => pathSourceLength
                            prepared.package.sources[pathCall!.targetModule] -> slice(UIntSize(0), pathSourceLength) => pathSource
                            prepared.package.tokens[pathSourceRange.tokenStart + pathSymbol.nameToken] => pathNameToken
                            pathSource -> sourceMatches(pathNameToken.span.start, pathNameToken.span.length, "queryRaw")
                                -> if { -215 => pathCall!.opcode }
                            pathSource -> sourceMatches(pathNameToken.span.start, pathNameToken.span.length, "pathText")
                                -> if { -230 => pathCall!.opcode }
                        }
                    not canonicalPathIntrinsic! and (pathCall!.opcode == -215 or pathCall!.opcode == -230)
                        -> if { -1 => pathCall!.opcode }
                } else {
                    pathCall!.opcode == -215 or pathCall!.opcode == -230
                        -> if { -1 => pathCall!.opcode }
                }
                pathCall! => results[pathCallIndex!]
            }
        pathCallIndex! + 1 => pathCallIndex!
    }
