public materializeContextualArrayOwners nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, resolved: mut expressionTypeIds.ExpressionTypeIdSet -> Unit {
    [Int; ~] => changedNodes!
    [Bool; ~] => sliceArguments!
    [Int; ~] => functions!
    0 => seed!
    seed! < (nodes -> len) -> while {
        sliceArguments! -> push(false)
        seed! + 1 => seed!
    }
    0 => symbolSeed!
    symbolSeed! < (prepared.package.symbols -> len)
        -> while {
            functions! -> push(-1)
            symbolSeed! + 1 => symbolSeed!
        }
    0 => functionIndex!
    functionIndex! < (nodes -> len) -> while {
        nodes[functionIndex!] => function
        function.kind == 0 and function.sourceModule >= 0
            and function.sourceModule < (prepared.package.ranges -> len)
            and function.symbol >= 0 -> if {
                prepared.package.ranges[function.sourceModule] => range
                function.symbol < range.symbolCount -> if {
                    functions![range.symbolStart + function.symbol] < 0
                        -> if { functionIndex! => functions![range.symbolStart + function.symbol] }
                }
            }
        functionIndex! + 1 => functionIndex!
    }
    0 => callIndex!
    callIndex! < (nodes -> len) -> while {
        nodes[callIndex!] => call
        call.kind == 6 and call.targetModule >= 0
            and call.targetModule < (prepared.package.ranges -> len)
            and call.symbol >= 0 -> if {
                prepared.package.ranges[call.targetModule] => range
                call.symbol < range.symbolCount -> if {
                    functions![range.symbolStart + call.symbol] => target
                    target >= 0 -> if {
                        nodes[target] => function
                        call.operand0 => argumentIndex!
                        function.operand1 => parameterIndex!
                        0 => ordinal!
                        argumentIndex! >= 0 and parameterIndex! >= 0
                            and argumentIndex! < (nodes -> len)
                            and parameterIndex! < (nodes -> len)
                            and ordinal! < (nodes -> len) -> while {
                                nodes[argumentIndex!] => argument
                                nodes[parameterIndex!] => parameter
                                resolved.types -> typeIds.materializedReadTypeId(parameter.typeId) => parameterType
                                argument.kind == 14
                                    and (resolved.types -> hasConcreteLiteralContext(parameterType))
                                    and resolved.types[parameterType].kind == 2
                                    -> if {
                                        true => sliceArguments![argumentIndex!]
                                        # Projected receivers can resolve after the early literal pass.
                                        # Apply their final parameter context before rebuilding storage.
                                        resolved.types[parameterType].first => elementTypeId
                                        elementTypeId >= 0 -> if {
                                            resolved.types[elementTypeId] => elementType
                                            argument.operand0 => elementIndex!
                                            elementIndex! >= 0 -> while {
                                                nodes[elementIndex!] => element!
                                                element!.kind == 3
                                                    or (element!.kind == 7
                                                    and element!.opcode == grammar.tokenIdMinus()
                                                    and element!.operand0 >= 0
                                                    and nodes[element!.operand0].kind == 3)
                                                    -> if {
                                                        elementTypeId => element!.typeId
                                                        elementType.kind => element!.typeKind
                                                        elementType.origin => element!.typeOrigin
                                                        elementType.module => element!.typeModule
                                                        elementType.symbol => element!.typeSymbol
                                                        changedNodes! -> push(elementIndex!)
                                                        element! => nodes[elementIndex!]
                                                    }
                                                element!.nextOperand => elementIndex!
                                            }
                                        }
                                    }
                                ordinal! == 0 -> if {
                                    call.operand1 => argumentIndex!
                                    function.nextOperand => parameterIndex!
                                } else {
                                    argument.nextOperand => argumentIndex!
                                    parameter.nextOperand => parameterIndex!
                                }
                                ordinal! + 1 => ordinal!
                            }
                    }
                }
            }
        callIndex! + 1 => callIndex!
    }

    0 => index!
    index! < (nodes -> len) -> while {
        nodes[index!] => literal!
        sliceArguments![index!] and literal!.kind == 14 and literal!.operand0 >= 0
            and literal!.typeId >= 0 and literal!.typeId < (resolved.types -> len)
            -> if {
                resolved.types[literal!.typeId] => owner
                resolved.types -> typeIds.materializedReadTypeId(nodes[literal!.operand0].typeId) => elementType
                owner.kind == 4 and elementType >= 0
                    and elementType < (resolved.types -> len)
                    and owner.first != elementType
                    -> if {
                        # Context changes the element type, never literal storage or length.
                        -1 => ownerType!
                        0 => search!
                        search! < (resolved.types -> len) and ownerType! < 0
                            -> while {
                                resolved.types[search!] => candidate
                                candidate.kind == owner.kind and candidate.first == elementType
                                    and candidate.length == owner.length and candidate.status == 0
                                    -> if { search! => ownerType! }
                                search! + 1 => search!
                            }
                        ownerType! < 0 -> if {
                            resolved.types -> len => ownerType!
                            resolved.types -> push(typeIds.SemanticType {
                                kind: owner.kind
                                origin: owner.origin
                                module: owner.module
                                symbol: owner.symbol
                                first: elementType
                                second: owner.second
                                length: owner.length
                                lengthHash: owner.lengthHash
                                containsParameter: resolved.types[elementType].containsParameter
                                status: 0
                            })
                        }
                        ownerType! => literal!.typeId
                        resolved.types[ownerType!] => canonical
                        canonical.kind => literal!.typeKind
                        canonical.origin => literal!.typeOrigin
                        canonical.module => literal!.typeModule
                        canonical.symbol => literal!.typeSymbol
                        literal! => nodes[index!]
                        changedNodes! -> push(index!)
                    }
            }
        index! + 1 => index!
    }
    (changedNodes! -> len) > 0 -> if {
        typeIds.enumPayloadEdges(resolved.types, resolved.references, prepared.package.ranges, prepared.package.symbols, resolved.referenceIndexByTypeAst) => payloadEdges
        prepared -> semanticContext.ownedResourceSeeds(resolved.types) => resourceSeeds
        typeIds.classifyWithResources(resolved.types, resolved.fields, payloadEdges, resourceSeeds) => flags
        changedNodes! -> each changedIndex {
            nodes[changedIndex] => changed!
            flags[changed!.typeId] => changed!.typeFlags
            changed! => nodes[changedIndex]
        }
    }
}

# Publish a copied producer as a lexical invocation scope, not a new function.
# The caller owns explicit return and loop transfers. Producer locals and each
# yield retain distinct scopes for their normal and transferred cleanup edges.
public materializeUserBlockScopes nodes: mut [TypedIrNode; ~], instances: ref [GenericFunctionInstance; ~] -> [GenericFunctionInstance; ~] {
    [GenericFunctionInstance; ~] => scoped!
    instances -> each sourceInstance {
        sourceInstance => instance!
        instance!.status == 0 -> if {
            instance!.callNode => callIndex
            instance!.functionNode => producerIndex
            nodes[callIndex] => invocation!
            nodes[producerIndex] => producer!
            producer!.operand0 => returnIndex
            nodes[returnIndex] => returned!
            producer!.operand1 => parameterIndex!
            invocation!.operand0 => argumentIndex!
            [Int; ~] => arguments!
            [Int; ~] => parameterBindings!
            0 => ordinal!
            parameterIndex! >= 0 and argumentIndex! >= 0 -> while {
                nodes[parameterIndex!] => parameter!
                parameter!.nextOperand => nextParameter!
                nodes[argumentIndex!].nextOperand => nextArgument!
                ordinal! == 0 -> if {
                    producer!.nextOperand => nextParameter!
                    invocation!.operand1 => nextArgument!
                }
                17 => parameter!.kind
                -227 => parameter!.opcode
                parameterBindings! -> push(parameterIndex!)
                arguments! -> push(argumentIndex!)
                callIndex => parameter!.parent
                argumentIndex! => parameter!.operand0
                -1 => parameter!.operand1
                -1 => parameter!.nextOperand
                parameter! => nodes[parameterIndex!]
                nextParameter! => parameterIndex!
                nextArgument! => argumentIndex!
                ordinal! + 1 => ordinal!
            }
            nodes -> len => provenanceIndex
            invocation! => provenance!
            19 => provenance!.kind
            callIndex => provenance!.parent
            -2 => provenance!.symbol
            -227 => provenance!.opcode
            -1 => provenance!.operand0
            -1 => provenance!.operand1
            -1 => provenance!.nextOperand
            0 => provenance!.flags
            nodes -> push(provenance!)
            0 => originalIndex!
            originalIndex! < producerIndex -> while {
                nodes[originalIndex!] => original!
                original!.parent == callIndex -> if {
                    false => argument!
                    arguments! -> each valueIndex {
                        originalIndex! == valueIndex -> if { true => argument! }
                    }
                    not argument! -> if {
                        provenanceIndex => original!.parent
                        original! => nodes[originalIndex!]
                    }
                }
                originalIndex! + 1 => originalIndex!
            }
            19 => invocation!.kind
            -227 => invocation!.opcode
            -1 => invocation!.operand0
            returned!.operand0 => invocation!.operand1
            invocation! => nodes[callIndex]
            # The copied declaration and implicit-return carrier preserve
            # source identity, but are not independent runtime statements.
            19 => producer!.kind
            -2 => producer!.symbol
            -227 => producer!.opcode
            callIndex => producer!.parent
            -1 => producer!.operand0
            -1 => producer!.operand1
            -1 => producer!.operand1
            -1 => producer!.nextOperand
            0 => producer!.flags
            producer! => nodes[producerIndex]
            9 => returned!.kind
            -1 => returned!.opcode
            0 => returned!.flags
            returned! => nodes[returnIndex]
            producerIndex + instance!.nodeCount => end
            producerIndex + 1 => index!
            index! < end -> while {
                nodes[index!] => node!
                # Copied producer parameter reads formerly used the callee ABI.
                # The invocation now binds those declarations to caller values.
                node!.kind == 5 and node!.operand0 < 0 and node!.symbol >= 0
                    -> if {
                        parameterBindings! -> each bindingIndex {
                            nodes[bindingIndex] => binding
                            node!.sourceModule == binding.sourceModule
                                and node!.symbol == binding.symbol
                                -> if { bindingIndex => node!.operand0 }
                        }
                    }
                # The copied producer body remains an owned lexical region.
                # Publish it to the same live-region traversal as invocation
                # and yield scopes; an ordinary kind19 body is excluded there.
                node!.kind == 19 and node!.opcode == -1 and node!.parent == returnIndex
                    -> if {
                        -227 => node!.opcode
                        -3 => node!.symbol
                        -1 => node!.operand0
                    }
                node!.parent == returnIndex -> if { callIndex => node!.parent }
                node!.opcode == -227 and (node!.kind == 9 or node!.kind == 5)
                    -> if {
                        node!.operand1 => result!
                        node!.kind == 5 and node!.operand0 >= 0 -> if {
                            nodes[node!.operand0].operand0 => result!
                        }
                        19 => node!.kind
                        -1 => node!.symbol
                        -1 => node!.operand0
                        result! => node!.operand1
