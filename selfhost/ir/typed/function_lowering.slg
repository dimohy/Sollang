                    -> if {
                        prepared.package.nodes[receiverRange.astStart + receiverCandidate.astNode]
                            => receiverAst
                        receiverCandidate.astNode => receiverAncestor!
                        receiverAncestor! >= 0 -> while {
                            prepared.package.nodes[receiverRange.astStart + receiverAncestor!]
                                => receiverAncestorAst
                            receiverAncestorAst.start == receiverAst.start
                                -> if {
                                    receiverByAst![receiverRange.astStart + receiverAncestor!] < 0
                                        -> if {
                                            receiverBuildIndex! => receiverByAst![receiverRange.astStart + receiverAncestor!]
                                        }
                                    receiverAncestorAst.parent => receiverAncestor!
                                } else {
