    0 => receiverBuildIndex!
    receiverBuildIndex! < (results -> len) -> while {
        results[receiverBuildIndex!] => receiverCandidate
        receiverCandidate.kind == 5
            and receiverCandidate.sourceModule >= 0
            and receiverCandidate.sourceModule < (prepared.package.ranges -> len)
            and receiverCandidate.symbol >= 0
            and receiverCandidate.symbol < prepared.package.ranges[receiverCandidate.sourceModule].symbolCount
            and prepared.package.symbols[prepared.package.ranges[receiverCandidate.sourceModule].symbolStart + receiverCandidate.symbol].kind == 35
            -> if {
                prepared.package.ranges[receiverCandidate.sourceModule] => receiverRange
