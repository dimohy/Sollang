        activeCall! and call.kind == 6 and call.targetModule >= 0
            and call.targetModule < (prepared.package.ranges -> len) and call.symbol >= 0
            and call.sourceModule >= 0 and call.astNode >= 0
            -> if {
                prepared.package.ranges[call.targetModule] => targetRange
                prepared.package.symbols[targetRange.symbolStart + call.symbol] => declaration
                declaration.blockTypeNode >= 0 and declaration.flags / 64 % 2 == 0
