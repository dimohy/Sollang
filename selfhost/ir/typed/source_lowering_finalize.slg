                and entryCanonicalBinding!.operand0 >= entryExpressionStart
                and nodes[entryCanonicalBinding!.operand0].typeOrigin >= 0
                -> if {
                    nodes[entryCanonicalBinding!.operand0] => entryCanonicalBindingValue
                    entryCanonicalBinding! -> mayRefreshValueAlias(entryCanonicalBindingValue)
                        -> if {
                            entryCanonicalBindingValue.typeOrigin => entryCanonicalBinding!.typeOrigin
                            entryCanonicalBindingValue.typeModule => entryCanonicalBinding!.typeModule
                            entryCanonicalBindingValue.typeSymbol => entryCanonicalBinding!.typeSymbol
                            entryCanonicalBindingValue.typeId => entryCanonicalBinding!.typeId
                            entryCanonicalBindingValue.typeKind => entryCanonicalBinding!.typeKind
                            entryCanonicalBindingValue.typeFlags => entryCanonicalBinding!.typeFlags
                            entryCanonicalBinding! => nodes[entryCanonicalBindingIr!]
                        }
                }
            entryCanonicalBindingIr! + 1 => entryCanonicalBindingIr!
        }
    entryExpressionStart => entryCanonicalBindingReadIr!
    entryCanonicalBindingReadIr! < entryExpressionEnd
        -> while {
            nodes[entryCanonicalBindingReadIr!] => entryCanonicalBindingRead!
            # Entry-point expressions can read a binding allocated
            # before the current expression slice. Its canonical
            # initializer type remains authoritative, matching the
            # ordinary function lowering path above.
            entryCanonicalBindingRead!.kind == 5
                and entryCanonicalBindingRead!.operand0 >= 0
                and nodes[entryCanonicalBindingRead!.operand0].kind == 17
                and nodes[entryCanonicalBindingRead!.operand0].typeOrigin >= 0
                -> if {
                    nodes[entryCanonicalBindingRead!.operand0] => entryCanonicalReadBinding
                    entryCanonicalReadBinding.typeOrigin => entryCanonicalBindingRead!.typeOrigin
                    entryCanonicalReadBinding.typeModule => entryCanonicalBindingRead!.typeModule
                    entryCanonicalReadBinding.typeSymbol => entryCanonicalBindingRead!.typeSymbol
                    entryCanonicalReadBinding.typeId => entryCanonicalBindingRead!.typeId
                    entryCanonicalReadBinding.typeKind => entryCanonicalBindingRead!.typeKind
                    entryCanonicalReadBinding.typeFlags => entryCanonicalBindingRead!.typeFlags
                    entryCanonicalBindingRead! => nodes[entryCanonicalBindingReadIr!]
                }
            entryCanonicalBindingReadIr! + 1 => entryCanonicalBindingReadIr!
        }
    entryExpressionStart => entryAggregateIrIndex!
    entryAggregateIrIndex! < entryExpressionEnd -> while {
        nodes[entryAggregateIrIndex!] => entryAggregate!
        entryAggregate!.kind == 12 or entryAggregate!.kind == 14 or entryAggregate!.kind == 16 or entryAggregate!.kind == 35
            -> if {
                -1 => entryFirstFieldOperand!
                entryExpressionStart => entryFieldOperandSearch!
                entryFieldOperandSearch! < entryExpressionEnd
                    -> while {
                        nodes[entryFieldOperandSearch!].parent == entryAggregateIrIndex!
                            -> if {
                                entryFirstFieldOperand! < 0 or prepared.package.nodes[sourceRange.astStart + nodes[entryFieldOperandSearch!].astNode].start < prepared.package.nodes[sourceRange.astStart + nodes[entryFirstFieldOperand!].astNode].start
                                    -> if { entryFieldOperandSearch! => entryFirstFieldOperand! }
                            }
                        entryFieldOperandSearch! + 1 => entryFieldOperandSearch!
                    }
                entryFirstFieldOperand! => entryAggregate!.operand0
                entryAggregate! => nodes[entryAggregateIrIndex!]
            }
        entryAggregateIrIndex! + 1 => entryAggregateIrIndex!
    }
    nodes[entryIr] => entryNode!
    -1 => entryResultIr!
    entryResultTypeIndex >= 0 -> if {
        entryAstToIr[inferred[entryResultTypeIndex].astNode] => entryResultIr!
        entryResultIr! < 0 -> if {
            1000000 => entryResultOperandDistance!
            entryExpressionStart => entryResultOperandSearch!
            entryResultOperandSearch! < entryExpressionEnd
                -> while {
                    prepared.package.nodes[sourceRange.astStart + nodes[entryResultOperandSearch!].astNode].parent => entryResultOperandAncestor!
                    1 => entryResultCandidateDistance!
                    false => entryResultCandidateBelongs!
                    entryResultOperandAncestor! >= 0 and not entryResultCandidateBelongs!
                        -> while {
                            entryResultOperandAncestor! == inferred[entryResultTypeIndex].astNode
                                -> if { true => entryResultCandidateBelongs! } else {
                                    prepared.package.nodes[sourceRange.astStart + entryResultOperandAncestor!].parent => entryResultOperandAncestor!
                                    entryResultCandidateDistance! + 1 => entryResultCandidateDistance!
                                }
                        }
                    entryResultCandidateBelongs! and entryResultCandidateDistance! < entryResultOperandDistance!
                        -> if {
                            entryResultOperandSearch! => entryResultIr!
                            entryResultCandidateDistance! => entryResultOperandDistance!
                        }
                    entryResultOperandSearch! + 1 => entryResultOperandSearch!
                }
        }
    }
    entryResultIr! < 0 and entryHasResolvedCall
        -> if {
            UIntSize(0) => entryLatestCallStart!
            entryExpressionStart => entryLatestCallSearch!
            entryLatestCallSearch! < entryExpressionEnd -> while {
                nodes[entryLatestCallSearch!] => entryLatestCall
                entryLatestCall.kind == 6 and entryLatestCall.parent == entryIr
                    -> if {
                        prepared.package.nodes[sourceRange.astStart + entryLatestCall.astNode].start => entryLatestCallStart
                        entryResultIr! < 0 or entryLatestCallStart >= entryLatestCallStart!
                            -> if {
                                entryLatestCallSearch! => entryResultIr!
                                entryLatestCallStart => entryLatestCallStart!
                            }
                    }
                entryLatestCallSearch! + 1 => entryLatestCallSearch!
            }
        }
    entryResultIr! >= 0 and nodes[entryResultIr!].kind == 9
        -> if {
            entryExpressionStart => entryResultControlSearch!
            entryResultControlSearch! < entryExpressionEnd
                -> while {
                    (nodes[entryResultControlSearch!].kind == 18 or nodes[entryResultControlSearch!].kind == 20) and nodes[entryResultControlSearch!].parent == entryResultIr!
                        -> if { entryResultControlSearch! => entryResultIr! }
                    entryResultControlSearch! + 1 => entryResultControlSearch!
                }
        }
    entryResultIr! => entryNode!.operand0
    entryNode! => nodes[entryIr]
}
