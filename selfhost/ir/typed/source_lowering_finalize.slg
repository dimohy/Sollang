                    entryChildIr! + 1 => entryChildIr!
                }
                entryFirstOperand! => entryOperator!.operand0
                entryOperator!.kind == 7 and entryOperator!.opcode != -26 and entryFirstOperand! >= 0
                    -> if {
                        nodes[entryFirstOperand!] => entryUnaryOperand
                        entryUnaryOperand.typeOrigin => entryOperator!.typeOrigin
                        entryUnaryOperand.typeModule => entryOperator!.typeModule
                        entryUnaryOperand.typeSymbol => entryOperator!.typeSymbol
                        entryUnaryOperand.typeId => entryOperator!.typeId
                        entryUnaryOperand.typeKind => entryOperator!.typeKind
                        entryUnaryOperand.typeFlags => entryOperator!.typeFlags
                    }
                entryOperator!.kind == 6 or entryOperator!.kind == 8 or (entryOperator!.kind == 9 and ((entryOperator!.opcode <= -201 and (entryOperator!.opcode >= -206 or entryOperator!.opcode == -213 or (entryOperator!.opcode == -223 or entryOperator!.opcode == -303) or entryOperator!.opcode == -224 or entryOperator!.opcode == -225 or entryOperator!.opcode == -226 or entryOperator!.opcode == -227 or entryOperator!.opcode == -229)) or (entryOperator!.opcode <= -241 and entryOperator!.opcode >= -243) or (entryOperator!.opcode <= -246 and entryOperator!.opcode >= -247) or entryOperator!.opcode == -252 or (entryOperator!.opcode <= -255 and entryOperator!.opcode >= -257) or entryOperator!.opcode == -220 or entryOperator!.opcode == -221 or entryOperator!.opcode == -271)) or entryOperator!.kind == 15 or entryOperator!.kind == 24 or entryOperator!.kind == 31 or entryOperator!.kind == 32 or entryOperator!.kind == 36
                    -> if { entrySecondOperand! => entryOperator!.operand1 }
                entryOperator!.kind == 22 -> if {
