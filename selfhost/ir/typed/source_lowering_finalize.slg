                        entryFirstBranchStage! => entryNextBranchArmNode!.operand0
                        entryFinalBranchStage! => entryNextBranchArmNode!.operand1
                        entryFinalBranchStage! >= 0 -> if {
                            nodes[entryFinalBranchStage!] => entryFinalBranchStageNode
                            entryFinalBranchStageNode.typeOrigin => entryNextBranchArmNode!.typeOrigin
                            entryFinalBranchStageNode.typeModule => entryNextBranchArmNode!.typeModule
                            entryFinalBranchStageNode.typeSymbol => entryNextBranchArmNode!.typeSymbol
                            entryFinalBranchStageNode.typeId => entryNextBranchArmNode!.typeId
                            entryFinalBranchStageNode.typeKind => entryNextBranchArmNode!.typeKind
                            entryFinalBranchStageNode.typeFlags => entryNextBranchArmNode!.typeFlags
                        }
                        -1 => entryNextBranchArmNode!.nextOperand
                        entryNextBranchArmNode! => nodes[entryNextBranchArm!]
                        entryFirstBranchArm! < 0 -> if { entryNextBranchArm! => entryFirstBranchArm! }
                        entryPreviousBranchArm! >= 0 -> if {
                            nodes[entryPreviousBranchArm!] => entryPreviousBranchArmNode!
                            entryNextBranchArm! => entryPreviousBranchArmNode!.nextOperand
                            entryPreviousBranchArmNode! => nodes[entryPreviousBranchArm!]
                        }
                        entryNextBranchArm! => entryPreviousBranchArm!
                        entryNextBranchArmStart! => entryPreviousBranchArmStart!
                        true => entryFindingBranchArm!
                    }
                }
                entryBranchSource! >= 0 and entryFirstBranchArm! >= 0
                    -> if {
                        entryFirstBranchArm! => entryBranch!.operand0
                        entryBranchSource! => entryBranch!.operand1
                        entryBranch!.parent >= 0 -> if {
                            nodes[entryBranch!.parent] => entryBranchParent!
                            entryBranchParent!.kind == 6 and entryBranchParent!.operand1 == entryBranchIr!
                                -> if {
                                    entryBranchIr! => entryBranchParent!.operand0
                                    -1 => entryBranchParent!.operand1
                                    entryBranchParent! => nodes[entryBranch!.parent]
                                }
                            entryBranchParent!.kind == 17 and entryBranchParent!.operand0 == entryBranchSource!
                                -> if {
                                    entryBranchIr! => entryBranchParent!.operand0
                                    entryBranch!.typeOrigin => entryBranchParent!.typeOrigin
                                    entryBranch!.typeModule => entryBranchParent!.typeModule
                                    entryBranch!.typeSymbol => entryBranchParent!.typeSymbol
                                    entryBranch!.typeId => entryBranchParent!.typeId
                                    entryBranch!.typeKind => entryBranchParent!.typeKind
                                    entryBranch!.typeFlags => entryBranchParent!.typeFlags
                                    entryBranchParent! => nodes[entryBranch!.parent]
                                    entryExpressionStart => entryBranchBindingUseIndex!
                                    entryBranchBindingUseIndex! < entryExpressionEnd
                                        -> while {
                                            nodes[entryBranchBindingUseIndex!] => entryBranchBindingUse!
                                            entryBranchBindingUse!.kind == 5 and entryBranchBindingUse!.operand0 == entryBranch!.parent
                                                -> if {
