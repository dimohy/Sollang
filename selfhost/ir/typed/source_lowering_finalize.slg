# Normalize a completed source entry without copying its owned IR.
finalizeSourceEntry nodes: mut [TypedIrNode; ~], entryAstToIr: mut [Int; ~], resolvedNames: ref [resolution.ResolvedName; ~], prepared: ref semanticContext.SemanticSnapshot, inferred: ref [expressionTypes.ExpressionType; ~], frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], recursiveTypeFlags: ref [Int; ~], sourceIndex: Int, entryAstIndex: Int, entryIr: Int, entryExpressionStart: Int, entryHasResolvedCall: Bool, entryResultTypeIndex: Int -> Unit {
    prepared.package.ranges[sourceIndex] => sourceRange
    prepared.package.sources[sourceIndex] -> len => sourceLength
    prepared.package.sources[sourceIndex] -> slice(UIntSize(0), sourceLength) => source
    nodes -> len => entryExpressionEnd
    entryExpressionStart => entryParentIr!
    entryParentIr! < entryExpressionEnd -> while {
        nodes[entryParentIr!] => entryIrNode!
        prepared.package.nodes[sourceRange.astStart + entryIrNode!.astNode].parent => entryParentAst!
        -1 => entrySemanticParent!
        entryParentAst! >= 0 and entryParentAst! != entryAstIndex and entrySemanticParent! < 0
            -> while {
                entryAstToIr[entryParentAst!] >= 0 -> if {
                    entryAstToIr[entryParentAst!] != entryParentIr!
                        -> if {
                            entryAstToIr[entryParentAst!] => entrySemanticParent!
                        } else {
                            prepared.package.nodes[sourceRange.astStart + entryParentAst!].parent => entryParentAst!
                        }
                } else {
                    prepared.package.nodes[sourceRange.astStart + entryParentAst!].parent => entryParentAst!
                }
            }
        entrySemanticParent! >= 0 -> if { entrySemanticParent! => entryIrNode!.parent }
        entryIrNode! => nodes[entryParentIr!]
        entryParentIr! + 1 => entryParentIr!
    }
    entryExpressionStart => entryOperandIr!
    entryOperandIr! < entryExpressionEnd -> while {
        nodes[entryOperandIr!] => entryOperator!
        entryOperator!.kind == 6 or entryOperator!.kind == 7 or entryOperator!.kind == 8 or (entryOperator!.kind == 9 and (entryOperator!.opcode == -27 or (entryOperator!.opcode <= -201 and (entryOperator!.opcode >= -206 or entryOperator!.opcode == -213 or (entryOperator!.opcode == -223 or entryOperator!.opcode == -303) or entryOperator!.opcode == -224 or entryOperator!.opcode == -225 or entryOperator!.opcode == -226 or entryOperator!.opcode == -227 or entryOperator!.opcode == -228 or entryOperator!.opcode == -229 or entryOperator!.opcode == -236)) or (entryOperator!.opcode <= -241 and entryOperator!.opcode >= -257) or entryOperator!.opcode == -220 or entryOperator!.opcode == -221 or entryOperator!.opcode == -271)) or entryOperator!.kind == 13 or entryOperator!.kind == 15 or entryOperator!.kind == 17 or entryOperator!.kind == 22 or entryOperator!.kind == 23 or entryOperator!.kind == 24 or entryOperator!.kind == 25 or entryOperator!.kind == 26 or entryOperator!.kind == 31 or entryOperator!.kind == 32 or entryOperator!.kind == 36
            -> if {
                -1 => entryFirstOperand!
                -1 => entrySecondOperand!
                UIntSize(0) => entryFirstStart!
                UIntSize(0) => entrySecondStart!
                false => entryOperatorHasDirectQualifiedTarget!
                entryOperator!.kind == 6 -> if {
                    prepared.qualifiedFunctionByParentAst[sourceRange.astStart + entryOperator!.astNode] >= 0
                        -> if { true => entryOperatorHasDirectQualifiedTarget! }
                }
                entryExpressionStart => entryChildIr!
                entryChildIr! < entryExpressionEnd -> while {
                    nodes[entryChildIr!] => entryChild
                    entryChild.parent == entryOperandIr!
                        and not (entryOperatorHasDirectQualifiedTarget!
                        and (entryChild.kind == 18 or entryChild.kind == 20 or entryChild.kind == 27 or entryChild.kind == 33 or entryChild.kind == 34))
                        -> if {
                            prepared.package.nodes[sourceRange.astStart + entryChild.astNode].start => entryChildStart
                            entryFirstOperand! < 0 -> if {
                                entryChildIr! => entryFirstOperand!
                                entryChildStart => entryFirstStart!
                            } else {
                                (entryOperator!.kind == 17
                                    and entryChild.kind == 6
                                    and ((entryChild.typeKind == 7
                                    and entryChild.typeOrigin == 4
                                    and entryChild.typeSymbol >= 5
                                    and entryChild.typeSymbol <= 7)
                                    or (entryChild.typeKind == 14
                                    and entryChild.typeOrigin == 4
                                    and entryChild.typeSymbol == 8))
                                    and prepared.package.nodes[sourceRange.astStart + entryChild.astNode].length > prepared.package.nodes[sourceRange.astStart + nodes[entryFirstOperand!].astNode].length)
                                    or (entryOperator!.kind != 17 and entryChildStart < entryFirstStart!)
                                    -> if {
                                        entryFirstOperand! => entrySecondOperand!
                                        entryFirstStart! => entrySecondStart!
                                        entryChildIr! => entryFirstOperand!
                                        entryChildStart => entryFirstStart!
                                    } else {
                                        entrySecondOperand! < 0 or entryChildStart < entrySecondStart!
                                            -> if {
                                                entryChildIr! => entrySecondOperand!
                                                entryChildStart => entrySecondStart!
                                            }
                                    }
                            }
