                                                    entryBranch!.typeModule => entryBranchBindingUse!.typeModule
                                                    entryBranch!.typeSymbol => entryBranchBindingUse!.typeSymbol
                                                    entryBranch!.typeId => entryBranchBindingUse!.typeId
                                                    entryBranch!.typeKind => entryBranchBindingUse!.typeKind
                                                    entryBranch!.typeFlags => entryBranchBindingUse!.typeFlags
                                                    entryBranchBindingUse! => nodes[entryBranchBindingUseIndex!]
