                entryTapSideCall => entryTap!.operand1
                entryTapSourceNode.typeOrigin => entryTap!.typeOrigin
                entryTapSourceNode.typeModule => entryTap!.typeModule
                entryTapSourceNode.typeSymbol => entryTap!.typeSymbol
                entryTapSourceNode.typeId => entryTap!.typeId
                entryTapSourceNode.typeKind => entryTap!.typeKind
                entryTapSourceNode.typeFlags => entryTap!.typeFlags
                -1 => previousEntryTapStage!
                UIntSize(0) => previousEntryTapStageStart!
                entryTapSource! => entryTapStageInput!
                true => findingEntryTapStage!
                findingEntryTapStage! -> while {
                    false => findingEntryTapStage!
                    -1 => nextEntryTapStage!
                    UIntSize(0) => nextEntryTapStageStart!
                    entryExpressionStart => entryTapStageSearch!
                    entryTapStageSearch! < entryExpressionEnd -> while {
                        nodes[entryTapStageSearch!] => entryTapStageCandidate
                        entryTapStageCandidate.parent == entryTapIr! and entryTapStageCandidate.kind == 6
                            -> if {
                                prepared.package.nodes[sourceRange.astStart + entryTapStageCandidate.astNode].start => entryTapStageStart
                                previousEntryTapStage! < 0 or entryTapStageStart > previousEntryTapStageStart!
                                    -> if {
                                        nextEntryTapStage! < 0 or entryTapStageStart < nextEntryTapStageStart!
                                            -> if {
                                                entryTapStageSearch! => nextEntryTapStage!
                                                entryTapStageStart => nextEntryTapStageStart!
                                            }
                                    }
                            }
                        entryTapStageSearch! + 1 => entryTapStageSearch!
                    }
                    nextEntryTapStage! >= 0 -> if {
                        nextEntryTapStage! -> bindTapStageInput(entryTapStageInput!, nodes)
                        nextEntryTapStage! => entryTap!.operand1
                        nextEntryTapStage! => entryTapStageInput!
                        nextEntryTapStage! => previousEntryTapStage!
                        nextEntryTapStageStart! => previousEntryTapStageStart!
                        true => findingEntryTapStage!
                    }
                }
                entryTap!.parent >= 0 -> if {
                    nodes[entryTap!.parent] => entryTapParent!
                    entryTapParent!.kind == 6 and entryTapParent!.operand1 == entryTapIr!
                        -> if {
                            entryTapIr! => entryTapParent!.operand0
                            -1 => entryTapParent!.operand1
                            entryTapParent! => nodes[entryTap!.parent]
                        }
                }
                entryTap! => nodes[entryTapIr!]
            }
        }
        entryTapIr! + 1 => entryTapIr!
    }
    entryExpressionStart => entryBranchIr!
    entryBranchIr! < entryExpressionEnd -> while {
        nodes[entryBranchIr!] => entryBranch!
        entryBranch!.kind == 37 or entryBranch!.kind == 38
            -> if {
                -1 => entryBranchSource!
                UIntSize(0) => entryBranchSourceStart!
                entryExpressionStart => entryBranchSourceSearch!
                entryBranchSourceSearch! < entryExpressionEnd
                    -> while {
                        nodes[entryBranchSourceSearch!] => entryBranchSourceCandidate
                        entryBranchSourceCandidate.parent == entryBranch!.parent and entryBranchSourceSearch! != entryBranchIr!
                            -> if {
                                prepared.package.nodes[sourceRange.astStart + entryBranchSourceCandidate.astNode].start => entryBranchCandidateStart
                                prepared.package.nodes[sourceRange.astStart + entryBranch!.astNode].start => entryBranchStart
                                entryBranchCandidateStart < entryBranchStart and (entryBranchSource! < 0 or entryBranchCandidateStart > entryBranchSourceStart!)
                                    -> if {
                                        entryBranchSourceSearch! => entryBranchSource!
                                        entryBranchCandidateStart => entryBranchSourceStart!
                                    }
                            }
                        entryBranchSourceSearch! + 1 => entryBranchSourceSearch!
                    }
                -1 => entryPreviousBranchArm!
                UIntSize(0) => entryPreviousBranchArmStart!
                -1 => entryFirstBranchArm!
                true => entryFindingBranchArm!
                entryFindingBranchArm! -> while {
                    false => entryFindingBranchArm!
                    -1 => entryNextBranchArm!
                    UIntSize(0) => entryNextBranchArmStart!
                    entryExpressionStart => entryBranchArmSearch!
                    entryBranchArmSearch! < entryExpressionEnd -> while {
                        nodes[entryBranchArmSearch!] => entryBranchArmCandidate
                        entryBranchArmCandidate.parent == entryBranchIr! and entryBranchArmCandidate.kind == 39
                            -> if {
                                prepared.package.nodes[sourceRange.astStart + entryBranchArmCandidate.astNode].start => entryBranchArmStart
                                entryPreviousBranchArm! < 0 or entryBranchArmStart > entryPreviousBranchArmStart!
                                    -> if {
                                        entryNextBranchArm! < 0 or entryBranchArmStart < entryNextBranchArmStart!
                                            -> if {
                                                entryBranchArmSearch! => entryNextBranchArm!
                                                entryBranchArmStart => entryNextBranchArmStart!
                                            }
                                    }
                            }
                        entryBranchArmSearch! + 1 => entryBranchArmSearch!
                    }
                    entryNextBranchArm! >= 0 -> if {
                        nodes[entryNextBranchArm!] => entryNextBranchArmNode!
                        -1 => entryPreviousBranchStage!
                        UIntSize(0) => entryPreviousBranchStageStart!
                        -1 => entryFirstBranchStage!
                        -1 => entryFinalBranchStage!
                        true => entryFindingBranchStage!
                        entryFindingBranchStage! -> while {
                            false => entryFindingBranchStage!
                            -1 => entryNextBranchStage!
                            UIntSize(0) => entryNextBranchStageStart!
                            entryExpressionStart => entryBranchStageSearch!
                            entryBranchStageSearch! < entryExpressionEnd
                                -> while {
                                    nodes[entryBranchStageSearch!] => entryBranchStageCandidate
                                    entryBranchStageCandidate.parent == entryNextBranchArm! and entryBranchStageCandidate.kind == 6
                                        -> if {
                                            prepared.package.nodes[sourceRange.astStart + entryBranchStageCandidate.astNode].start => entryBranchStageStart
                                            entryPreviousBranchStage! < 0 or entryBranchStageStart > entryPreviousBranchStageStart!
                                                -> if {
                                                    entryNextBranchStage! < 0 or entryBranchStageStart < entryNextBranchStageStart!
                                                        -> if {
                                                            entryBranchStageSearch! => entryNextBranchStage!
                                                            entryBranchStageStart => entryNextBranchStageStart!
                                                        }
                                                }
                                        }
                                    entryBranchStageSearch! + 1 => entryBranchStageSearch!
                                }
                            entryNextBranchStage! >= 0 -> if {
                                entryFirstBranchStage! < 0 -> if { entryNextBranchStage! => entryFirstBranchStage! }
                                entryNextBranchStage! => entryFinalBranchStage!
                                entryNextBranchStage! => entryPreviousBranchStage!
                                entryNextBranchStageStart! => entryPreviousBranchStageStart!
                                true => entryFindingBranchStage!
                            }
