            -1 => entryPreviousPartitionRoute!
            UIntSize(0) => entryPreviousPartitionRouteStart!
            0 => entryPartitionRouteOrdinal!
            true => entryFindingPartitionRoute!
            entryFindingPartitionRoute! -> while {
