                    entryFirstOperand! => entryOperator!.operand1
                }
                entryOperator! => nodes[entryOperandIr!]
            }
        entryOperandIr! + 1 => entryOperandIr!
    }
    entryExpressionStart => entryTapIr!
    entryTapIr! < entryExpressionEnd -> while {
        nodes[entryTapIr!] => entryTap!
        entryTap!.kind == 36 -> if {
            entryTap!.operand0 => entryTapSideCall
            -1 => entryTapSource!
            UIntSize(0) => entryTapSourceStart!
            entryExpressionStart => entryTapSourceSearch!
            entryTapSourceSearch! < entryExpressionEnd -> while {
                nodes[entryTapSourceSearch!] => entryTapSourceCandidate
                entryTapSourceCandidate.parent == entryTap!.parent and entryTapSourceSearch! != entryTapIr!
