                                                                    enumPayloadNominalSearch! < (prepared.nominal -> len)
                                                                        -> while {
                                                                            prepared.nominal[enumPayloadNominalSearch!] => enumPayloadNominal
                                                                            enumPayloadNominal.status == 0 and enumPayloadNominal.sourceModule == enumPayloadOwnerSource! and enumPayloadNominal.typeAst >= 0
                                                                                -> if {
