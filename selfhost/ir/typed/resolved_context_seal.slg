                                                                structuralMemberType.kind => structuralMember!.typeKind
                                                                structuralMemberType.origin => structuralMember!.typeOrigin
                                                                structuralMemberType.module => structuralMember!.typeModule
                                                                structuralMemberType.symbol => structuralMember!.typeSymbol
