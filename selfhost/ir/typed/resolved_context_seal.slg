                                                contextualCallParameter.typeKind => contextualCallArgument!.typeKind
                                                contextualCallParameter.typeOrigin => contextualCallArgument!.typeOrigin
                                                contextualCallParameter.typeModule => contextualCallArgument!.typeModule
                                                contextualCallParameter.typeSymbol => contextualCallArgument!.typeSymbol
