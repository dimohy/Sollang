                                                            contextualCallElementType.kind => contextualCallElement!.typeKind
                                                            contextualCallElementType.origin => contextualCallElement!.typeOrigin
                                                            contextualCallElementType.module => contextualCallElement!.typeModule
                                                            contextualCallElementType.symbol => contextualCallElement!.typeSymbol
                                                            recursiveTypeFlags[contextualCallCollectionType.first] => contextualCallElement!.typeFlags
