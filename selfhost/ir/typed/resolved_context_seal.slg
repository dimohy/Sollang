        -> while {
            nodes[structuralMemberRepairIndex!] => structuralMember!
            structuralMember!.kind == 13 and structuralMember!.symbol < 0 and structuralMember!.operand0 >= 0
                -> if {
                    nodes[structuralMember!.operand0] => structuralMemberBase
                    structuralMemberBase.typeKind == 10 and structuralMemberBase.typeId >= 0
                        -> if {
