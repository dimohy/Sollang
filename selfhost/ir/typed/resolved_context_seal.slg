namespace sollang.compiler.ir.typed

import sollang.compiler.ast as ast
import sollang.compiler.lexer as lexer
import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.calls as calls
import sollang.compiler.semantic.composite_types as compositeTypes
import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.expression_type_ids as expressionTypeIds
import sollang.compiler.semantic.expression_types as expressionTypes
import sollang.compiler.semantic.modules as modules
import sollang.compiler.semantic.module_resolve as moduleResolve
import sollang.compiler.semantic.nominal_types as nominalTypes
import sollang.compiler.semantic.qualified as qualified
import sollang.compiler.semantic.resolve as resolution
import sollang.compiler.semantic.symbols as symbols
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.semantic.type_terms as typeTerms
import sollang.compiler.semantic.types as semanticTypes
import sollang.compiler.syntax as syntax
import syntax.generated.slg as grammar
import sys.file as file

# Seal contextual and control-flow types after normalization.
sealResolvedContext nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], recursiveTypeFlags: ref [Int; ~], runtimeSymbols: ref LateRuntimeSymbols -> [Int; ~] {
    # A bare integer literal in binary arithmetic or comparison adopts the
    # exact type of its independently typed peer. Without this final
    # contextualization,
    # `UInt16(value) / 16` keeps the right operand as Int, forcing an i32 LLVM
    # operation even though the semantic result and downstream ABI are UInt16.
    0 => contextualBinaryLiteralIndex!
    contextualBinaryLiteralIndex! < (nodes -> len)
        -> while {
            nodes[contextualBinaryLiteralIndex!] => contextualBinary
            (contextualBinary.opcode >= grammar.tokenIdPlus()
                and contextualBinary.opcode <= grammar.tokenIdPercent())
                => contextualBinaryArithmetic
            (contextualBinaryArithmetic
                or contextualBinary.opcode == grammar.tokenIdEqualEqual()
                or contextualBinary.opcode == grammar.tokenIdBangEqual()
                or (contextualBinary.opcode >= grammar.tokenIdLessEqual()
                and contextualBinary.opcode <= grammar.tokenIdGreater()))
                => contextualBinaryNumericOperands
            contextualBinary.kind == 8
                and contextualBinaryNumericOperands
                and contextualBinary.operand0 >= 0
                and contextualBinary.operand1 >= 0 -> if {
                    nodes[contextualBinary.operand0] => contextualBinaryLeft!
                    nodes[contextualBinary.operand1] => contextualBinaryRight!
                    contextualBinaryLeft!.kind == 3
                        and contextualBinaryRight!.typeKind == 1
                        and contextualBinaryRight!.typeOrigin == 1
                        and contextualBinaryRight!.typeSymbol >= 2
                        and contextualBinaryRight!.typeSymbol <= 14
                        -> if {
                            contextualBinaryRight!.typeId => contextualBinaryLeft!.typeId
                            contextualBinaryRight!.typeKind => contextualBinaryLeft!.typeKind
                            contextualBinaryRight!.typeOrigin => contextualBinaryLeft!.typeOrigin
                            contextualBinaryRight!.typeModule => contextualBinaryLeft!.typeModule
                            contextualBinaryRight!.typeSymbol => contextualBinaryLeft!.typeSymbol
                            contextualBinaryRight!.typeFlags => contextualBinaryLeft!.typeFlags
                            contextualBinaryLeft! => nodes[contextualBinary.operand0]
                        }
                    contextualBinaryRight!.kind == 3
                        and contextualBinaryLeft!.typeKind == 1
                        and contextualBinaryLeft!.typeOrigin == 1
                        and contextualBinaryLeft!.typeSymbol >= 2
                        and contextualBinaryLeft!.typeSymbol <= 14 -> if {
                            contextualBinaryLeft!.typeId => contextualBinaryRight!.typeId
                            contextualBinaryLeft!.typeKind => contextualBinaryRight!.typeKind
                            contextualBinaryLeft!.typeOrigin => contextualBinaryRight!.typeOrigin
                            contextualBinaryLeft!.typeModule => contextualBinaryRight!.typeModule
                            contextualBinaryLeft!.typeSymbol => contextualBinaryRight!.typeSymbol
                            contextualBinaryLeft!.typeFlags => contextualBinaryRight!.typeFlags
                            contextualBinaryRight! => nodes[contextualBinary.operand1]
                        }
                    # A negated literal is an operator node around the literal,
                    # so contextualize both nodes from the independently typed
                    # peer. Otherwise `-9_223_372_036_854_775_807 - Long(1)`
                    # lowers the first subtraction as i32 before the outer
                    # arithmetic widens to Long.
                    contextualBinaryLeft!.kind == 7
                        and contextualBinaryLeft!.opcode == grammar.tokenIdMinus()
                        and contextualBinaryLeft!.operand0 >= 0
                        and nodes[contextualBinaryLeft!.operand0].kind == 3
                        and contextualBinaryRight!.typeKind == 1
                        and contextualBinaryRight!.typeOrigin == 1
                        and contextualBinaryRight!.typeSymbol >= 2
                        and contextualBinaryRight!.typeSymbol <= 14
                        -> if {
                            nodes[contextualBinaryLeft!.operand0] => contextualBinaryLeftLiteral!
                            contextualBinaryRight!.typeId => contextualBinaryLeftLiteral!.typeId
                            contextualBinaryRight!.typeKind => contextualBinaryLeftLiteral!.typeKind
                            contextualBinaryRight!.typeOrigin => contextualBinaryLeftLiteral!.typeOrigin
                            contextualBinaryRight!.typeModule => contextualBinaryLeftLiteral!.typeModule
                            contextualBinaryRight!.typeSymbol => contextualBinaryLeftLiteral!.typeSymbol
                            contextualBinaryRight!.typeFlags => contextualBinaryLeftLiteral!.typeFlags
                            contextualBinaryLeftLiteral! => nodes[contextualBinaryLeft!.operand0]
                            contextualBinaryRight!.typeId => contextualBinaryLeft!.typeId
                            contextualBinaryRight!.typeKind => contextualBinaryLeft!.typeKind
                            contextualBinaryRight!.typeOrigin => contextualBinaryLeft!.typeOrigin
                            contextualBinaryRight!.typeModule => contextualBinaryLeft!.typeModule
                            contextualBinaryRight!.typeSymbol => contextualBinaryLeft!.typeSymbol
                            contextualBinaryRight!.typeFlags => contextualBinaryLeft!.typeFlags
                            contextualBinaryLeft! => nodes[contextualBinary.operand0]
                        }
                    contextualBinaryRight!.kind == 7
                        and contextualBinaryRight!.opcode == grammar.tokenIdMinus()
                        and contextualBinaryRight!.operand0 >= 0
                        and nodes[contextualBinaryRight!.operand0].kind == 3
                        and contextualBinaryLeft!.typeKind == 1
                        and contextualBinaryLeft!.typeOrigin == 1
                        and contextualBinaryLeft!.typeSymbol >= 2
                        and contextualBinaryLeft!.typeSymbol <= 14
                        -> if {
                            nodes[contextualBinaryRight!.operand0] => contextualBinaryRightLiteral!
                            contextualBinaryLeft!.typeId => contextualBinaryRightLiteral!.typeId
                            contextualBinaryLeft!.typeKind => contextualBinaryRightLiteral!.typeKind
                            contextualBinaryLeft!.typeOrigin => contextualBinaryRightLiteral!.typeOrigin
                            contextualBinaryLeft!.typeModule => contextualBinaryRightLiteral!.typeModule
                            contextualBinaryLeft!.typeSymbol => contextualBinaryRightLiteral!.typeSymbol
                            contextualBinaryLeft!.typeFlags => contextualBinaryRightLiteral!.typeFlags
                            contextualBinaryRightLiteral! => nodes[contextualBinaryRight!.operand0]
                            contextualBinaryLeft!.typeId => contextualBinaryRight!.typeId
                            contextualBinaryLeft!.typeKind => contextualBinaryRight!.typeKind
                            contextualBinaryLeft!.typeOrigin => contextualBinaryRight!.typeOrigin
                            contextualBinaryLeft!.typeModule => contextualBinaryRight!.typeModule
                            contextualBinaryLeft!.typeSymbol => contextualBinaryRight!.typeSymbol
                            contextualBinaryLeft!.typeFlags => contextualBinaryRight!.typeFlags
                            contextualBinaryRight! => nodes[contextualBinary.operand1]
                        }
                    nodes[contextualBinary.operand0] => contextualBinaryCanonicalLeft
                    nodes[contextualBinary.operand1] => contextualBinaryCanonicalRight
                    contextualBinaryArithmetic
                        and contextualBinaryCanonicalLeft.typeId >= 0
                        and contextualBinaryCanonicalLeft.typeId == contextualBinaryCanonicalRight.typeId
                        and contextualBinaryCanonicalLeft.typeKind == 1
                        and contextualBinaryCanonicalLeft.typeOrigin == 1
                        and contextualBinaryCanonicalLeft.typeSymbol >= 2
                        and contextualBinaryCanonicalLeft.typeSymbol <= 14
                        -> if {
                            contextualBinary => contextualBinaryResult!
                            contextualBinaryCanonicalLeft.typeId => contextualBinaryResult!.typeId
                            contextualBinaryCanonicalLeft.typeKind => contextualBinaryResult!.typeKind
                            contextualBinaryCanonicalLeft.typeOrigin => contextualBinaryResult!.typeOrigin
                            contextualBinaryCanonicalLeft.typeModule => contextualBinaryResult!.typeModule
                            contextualBinaryCanonicalLeft.typeSymbol => contextualBinaryResult!.typeSymbol
                            contextualBinaryCanonicalLeft.typeFlags => contextualBinaryResult!.typeFlags
                            contextualBinaryResult! => nodes[contextualBinaryLiteralIndex!]
                        }
                }
            contextualBinaryLiteralIndex! + 1 => contextualBinaryLiteralIndex!
        }
    # `take` consumes one collection entry and therefore produces the
    # collection's element/value, never the receiver container. Operand links
    # are final at this boundary, so settle the canonical result without AST
    # shape heuristics.
    0 => takeResultTypeRepairIndex!
    takeResultTypeRepairIndex! < (nodes -> len)
        -> while {
            nodes[takeResultTypeRepairIndex!] => takeResultTypeRepair!
            takeResultTypeRepair!.kind == 9
                and takeResultTypeRepair!.opcode == -213
                and takeResultTypeRepair!.operand0 >= 0
                and nodes[takeResultTypeRepair!.operand0].typeId >= 0
                -> if {
                    nodes[takeResultTypeRepair!.operand0].typeId => takeResultReceiverTypeId!
                    frozenRecursiveSemanticTypes[takeResultReceiverTypeId!] => takeResultReceiverType!
                    takeResultReceiverType!.kind == 8 -> if {
                        takeResultReceiverType!.first => takeResultReceiverTypeId!
                        frozenRecursiveSemanticTypes[takeResultReceiverTypeId!] => takeResultReceiverType!
                    }
                    -1 => takeResultElementTypeId!
                    takeResultReceiverType!.kind == 3 or takeResultReceiverType!.kind == 4 or takeResultReceiverType!.kind == 12
                        -> if { takeResultReceiverType!.first => takeResultElementTypeId! }
                    takeResultReceiverType!.kind == 5 -> if { takeResultReceiverType!.second => takeResultElementTypeId! }
                    takeResultElementTypeId! >= 0 -> if {
                        frozenRecursiveSemanticTypes[takeResultElementTypeId!] => takeResultElementType
                        takeResultElementTypeId! => takeResultTypeRepair!.typeId
                        takeResultElementType.kind => takeResultTypeRepair!.typeKind
                        takeResultElementType.origin => takeResultTypeRepair!.typeOrigin
                        takeResultElementType.module => takeResultTypeRepair!.typeModule
                        takeResultElementType.symbol => takeResultTypeRepair!.typeSymbol
                        recursiveTypeFlags[takeResultElementTypeId!] => takeResultTypeRepair!.typeFlags
                        takeResultTypeRepair! => nodes[takeResultTypeRepairIndex!]
                    }
                }
            takeResultTypeRepairIndex! + 1 => takeResultTypeRepairIndex!
        }
    # A pipeline enum match consumes the terminal value before its first arm.
    # Earlier passes may initially attach the lexical source name or leave the
    # subject unresolved when an outer binding receives its type from a
    # value-producing control expression. Once all canonical binding/reference
    # types exist, select the nearest proven enum value in the exact owning flow
    # before the match AST. This is the same structural ownership rule used
    # during initial lowering, but without stale provisional types.
    0 => enumSubjectTerminalRepairIndex!
    enumSubjectTerminalRepairIndex! < (nodes -> len)
        -> while {
            nodes[enumSubjectTerminalRepairIndex!] => enumSubjectTerminalRepair!
            enumSubjectTerminalRepair!.kind == 27
                and enumSubjectTerminalRepair!.sourceModule >= 0
                -> if {
                    prepared.package.ranges[enumSubjectTerminalRepair!.sourceModule] => enumSubjectTerminalRange
                    prepared.package.nodes[enumSubjectTerminalRange.astStart + enumSubjectTerminalRepair!.astNode] => enumSubjectTerminalMatchAst
                    enumSubjectTerminalMatchAst.parent => enumSubjectTerminalFlowAst
                    prepared.package.nodes[enumSubjectTerminalRange.astStart + enumSubjectTerminalFlowAst] => enumSubjectTerminalFlowNode
                    -1 => enumSubjectTerminalPatternToken!
                    0 => enumSubjectTerminalPatternSearch!
                    enumSubjectTerminalPatternSearch! < enumSubjectTerminalRange.astCount
                        -> while {
                            prepared.package.nodes[enumSubjectTerminalRange.astStart + enumSubjectTerminalPatternSearch!] => enumSubjectTerminalPatternCandidate
                            enumSubjectTerminalPatternCandidate.parent => enumSubjectTerminalPatternOwner!
                            enumSubjectTerminalPatternOwner! >= 0
                                and prepared.package.nodes[enumSubjectTerminalRange.astStart + enumSubjectTerminalPatternOwner!].kind == 70
                                -> if {
                                    prepared.package.nodes[enumSubjectTerminalRange.astStart + enumSubjectTerminalPatternOwner!].parent => enumSubjectTerminalPatternOwner!
                                }
                            enumSubjectTerminalPatternToken! < 0
                                and enumSubjectTerminalPatternCandidate.kind == 59
                                and enumSubjectTerminalPatternCandidate.payloadToken >= 0
                                and enumSubjectTerminalPatternOwner! >= 0
                                and prepared.package.nodes[enumSubjectTerminalRange.astStart + enumSubjectTerminalPatternOwner!].kind == 58
                                and prepared.package.nodes[enumSubjectTerminalRange.astStart + enumSubjectTerminalPatternOwner!].parent == enumSubjectTerminalRepair!.astNode
                                -> if {
                                    enumSubjectTerminalPatternCandidate.payloadToken => enumSubjectTerminalPatternToken!
                                }
                            enumSubjectTerminalPatternSearch! + 1 => enumSubjectTerminalPatternSearch!
                        }
                    -1 => enumSubjectTerminalLast!
                    0 => enumSubjectTerminalLastValueRank!
                    UIntSize(0) => enumSubjectTerminalLastStart!
                    UIntSize(0) => enumSubjectTerminalLastEnd!
                    1000000 => enumSubjectTerminalLastDistance!
                    0 => enumSubjectTerminalCandidateSearch!
                    enumSubjectTerminalCandidateSearch! < (nodes -> len)
                        -> while {
                            nodes[enumSubjectTerminalCandidateSearch!] => enumSubjectTerminalCandidate
                            enumSubjectTerminalCandidate.sourceModule == enumSubjectTerminalRepair!.sourceModule
                                and enumSubjectTerminalCandidate.astNode >= 0
                                and enumSubjectTerminalCandidate.astNode < enumSubjectTerminalRange.astCount
                                and enumSubjectTerminalCandidate.typeId >= 0
                                and enumSubjectTerminalCandidate.typeId < (frozenRecursiveSemanticTypes -> len)
                                -> if {
                                    prepared.package.nodes[enumSubjectTerminalRange.astStart + enumSubjectTerminalCandidate.astNode] => enumSubjectTerminalCandidateAst
                                    enumSubjectTerminalCandidateAst.start + enumSubjectTerminalCandidateAst.length => enumSubjectTerminalCandidateEnd
                                    enumSubjectTerminalCandidateAst.parent => enumSubjectTerminalAncestor!
                                    1 => enumSubjectTerminalDistance!
                                    enumSubjectTerminalCandidate.astNode == enumSubjectTerminalFlowAst => enumSubjectTerminalBelongs!
                                    enumSubjectTerminalBelongs! -> if { 0 => enumSubjectTerminalDistance! }
                                    enumSubjectTerminalAncestor! >= 0 and not enumSubjectTerminalBelongs!
                                        -> while {
                                            enumSubjectTerminalAncestor! == enumSubjectTerminalFlowAst
                                                -> if {
                                                    true => enumSubjectTerminalBelongs!
                                                } else {
                                                    prepared.package.nodes[enumSubjectTerminalRange.astStart + enumSubjectTerminalAncestor!].parent => enumSubjectTerminalAncestor!
                                                    enumSubjectTerminalDistance! + 1 => enumSubjectTerminalDistance!
                                                }
                                        }
                                    false => enumSubjectTerminalIsEnum!
                                    0 => enumSubjectTerminalCandidateValueRank!
                                    enumSubjectTerminalCandidate.kind == 5 -> if { 1 => enumSubjectTerminalCandidateValueRank! }
                                    (enumSubjectTerminalCandidate.kind == 5 or enumSubjectTerminalCandidate.kind == 6)
                                        or enumSubjectTerminalCandidate.kind == 8
                                        or enumSubjectTerminalCandidate.kind == 9
                                        or enumSubjectTerminalCandidate.kind == 12
                                        or enumSubjectTerminalCandidate.kind == 13
                                        or enumSubjectTerminalCandidate.kind == 14
                                        or enumSubjectTerminalCandidate.kind == 15
                                        or enumSubjectTerminalCandidate.kind == 16
                                        or enumSubjectTerminalCandidate.kind == 18
                                        or enumSubjectTerminalCandidate.kind == 26
                                        or enumSubjectTerminalCandidate.kind == 27
                                        or enumSubjectTerminalCandidate.kind == 29
                                        or (enumSubjectTerminalCandidate.kind >= 31 and enumSubjectTerminalCandidate.kind <= 43)
                                        -> if { 2 => enumSubjectTerminalCandidateValueRank! }
                                    frozenRecursiveSemanticTypes[enumSubjectTerminalCandidate.typeId] => enumSubjectTerminalType
                                    enumSubjectTerminalType.kind == 7 and enumSubjectTerminalType.origin == 4 and (enumSubjectTerminalType.symbol == 0 or enumSubjectTerminalType.symbol == 1)
                                        -> if { true => enumSubjectTerminalIsEnum! }
                                    enumSubjectTerminalType.kind == 1 -> if {
                                        enumSubjectTerminalType.module => enumSubjectTerminalOwnerSource!
                                        enumSubjectTerminalType.origin == 2 -> if {
                                            enumSubjectTerminalType.module >= 0 and enumSubjectTerminalType.module < (prepared.modules -> len)
                                                -> if { prepared.modules[enumSubjectTerminalType.module].sourceIndex => enumSubjectTerminalOwnerSource! }
                                        }
                                        enumSubjectTerminalOwnerSource! >= 0 and enumSubjectTerminalOwnerSource! < (prepared.package.ranges -> len)
                                            -> if {
                                                prepared.package.ranges[enumSubjectTerminalOwnerSource!] => enumSubjectTerminalOwnerRange
                                                enumSubjectTerminalType.symbol >= 0 and enumSubjectTerminalType.symbol < enumSubjectTerminalOwnerRange.symbolCount
                                                    -> if {
                                                        prepared.package.symbols[enumSubjectTerminalOwnerRange.symbolStart + enumSubjectTerminalType.symbol] => enumSubjectTerminalDeclaration
                                                        enumSubjectTerminalDeclaration.astNode >= 0 and prepared.package.nodes[enumSubjectTerminalOwnerRange.astStart + enumSubjectTerminalDeclaration.astNode].kind == 4
                                                            -> if { true => enumSubjectTerminalIsEnum! }
                                                    }
                                            }
                                    }
                                    true => enumSubjectTerminalPatternCompatible!
                                    enumSubjectTerminalPatternToken! >= 0 and enumSubjectTerminalIsEnum!
                                        -> if {
                                            prepared.package.tokens[enumSubjectTerminalRange.tokenStart + enumSubjectTerminalPatternToken!] => enumSubjectTerminalPattern
                                            enumSubjectTerminalRepair!.sourceModule -> nominalVariantTagForType(enumSubjectTerminalType, enumSubjectTerminalPattern, prepared) => enumSubjectTerminalPatternTag
                                            enumSubjectTerminalPatternTag < 0 -> if { false => enumSubjectTerminalPatternCompatible! }
                                        }
                                    enumSubjectTerminalCandidate.kind == 6
                                        and enumSubjectTerminalCandidate.parent == enumSubjectTerminalRepair!.parent
                                        and enumSubjectTerminalCandidateAst.start == enumSubjectTerminalFlowNode.start
                                        and enumSubjectTerminalCandidateEnd <= enumSubjectTerminalMatchAst.start
                                        and enumSubjectTerminalPatternCompatible!
                                        -> if {
                                            true => enumSubjectTerminalBelongs!
                                            0 => enumSubjectTerminalDistance!
                                            3 => enumSubjectTerminalCandidateValueRank!
                                        }
                                    enumSubjectTerminalCandidateValueRank! > enumSubjectTerminalLastValueRank! => betterTerminalSubjectRank
                                    (enumSubjectTerminalCandidateValueRank! == enumSubjectTerminalLastValueRank!
                                        and (enumSubjectTerminalDistance! < enumSubjectTerminalLastDistance!
                                        or (enumSubjectTerminalDistance! == enumSubjectTerminalLastDistance!
                                        and (enumSubjectTerminalCandidateEnd > enumSubjectTerminalLastEnd!
                                        or (enumSubjectTerminalCandidateEnd == enumSubjectTerminalLastEnd!
                                        and enumSubjectTerminalCandidateAst.start < enumSubjectTerminalLastStart!))))) => betterTerminalSubjectLocation
                                    enumSubjectTerminalBelongs!
                                        and enumSubjectTerminalIsEnum!
                                        and enumSubjectTerminalPatternCompatible!
                                        and enumSubjectTerminalCandidateAst.start < enumSubjectTerminalMatchAst.start
                                        and (enumSubjectTerminalLast! < 0
                                        or betterTerminalSubjectRank
                                        or betterTerminalSubjectLocation) -> if {
                                            enumSubjectTerminalCandidateSearch! => enumSubjectTerminalLast!
                                            enumSubjectTerminalCandidateValueRank! => enumSubjectTerminalLastValueRank!
                                            enumSubjectTerminalCandidateAst.start => enumSubjectTerminalLastStart!
                                            enumSubjectTerminalCandidateEnd => enumSubjectTerminalLastEnd!
                                            enumSubjectTerminalDistance! => enumSubjectTerminalLastDistance!
                                        }
                                }
                            enumSubjectTerminalCandidateSearch! + 1 => enumSubjectTerminalCandidateSearch!
                        }
                    enumSubjectTerminalLast! >= 0 and enumSubjectTerminalLast! != enumSubjectTerminalRepair!.operand0
                        -> if {
                            enumSubjectTerminalLast! => enumSubjectTerminalRepair!.operand0
                            enumSubjectTerminalRepair! => nodes[enumSubjectTerminalRepairIndex!]
                        }
                }
            enumSubjectTerminalRepairIndex! + 1 => enumSubjectTerminalRepairIndex!
        }
    # A chained control is the canonical subject of the control that follows it.
    # The broad AST/rank repair above can otherwise select the terminal value of
    # the producer's last arm. That value is branch-local and makes region
    # scheduling wait for an arm that only the producer itself can emit. Preserve
    # the explicit producer -> consumer edge when the provisional subject is
    # proven to be inside that producer. This is one linear producer pass plus
    # parent-chain walks; it does not add a consumer scan per control use.
    0 => chainedControlSubjectRepairIndex!
    chainedControlSubjectRepairIndex! < (nodes -> len)
        -> while {
            nodes[chainedControlSubjectRepairIndex!] => chainedControlProducer
            chainedControlProducer.nextOperand => chainedControlNext!
            # An if node uses nextOperand for its else arm, not the following stage.
            chainedControlProducer.kind == 18
                -> if { -1 => chainedControlNext! }
            chainedControlProducer.parent => chainedControlWrapper!
            # Flow normalization may move the following-stage edge onto a
            # transparent parent shell. Follow only that exact owner chain.
            chainedControlNext! < 0 and chainedControlWrapper! >= 0
                and chainedControlWrapper! < (nodes -> len)
                and nodes[chainedControlWrapper!].kind == 9
                and nodes[chainedControlWrapper!].opcode == -1
                -> while {
                    nodes[chainedControlWrapper!].nextOperand => chainedControlNext!
                    nodes[chainedControlWrapper!].parent => chainedControlWrapper!
                }
            (chainedControlProducer.kind == 18 or chainedControlProducer.kind == 27
                or chainedControlProducer.kind == 33 or chainedControlProducer.kind == 34)
                and chainedControlNext! >= 0
                and chainedControlNext! < (nodes -> len)
                -> if {
                    chainedControlNext! => chainedControlConsumerIndex
                    nodes[chainedControlConsumerIndex] => chainedControlConsumer!
                    (chainedControlConsumer!.kind == 27 or chainedControlConsumer!.kind == 34)
                        and chainedControlConsumer!.operand0 >= 0
                        and chainedControlConsumer!.operand0 < (nodes -> len)
                        -> if {
                            chainedControlConsumer!.operand0 => chainedControlSubjectAncestor!
                            false => chainedControlSubjectInside!
                            chainedControlSubjectAncestor! >= 0
                                and not chainedControlSubjectInside!
                                -> while {
                                    chainedControlSubjectAncestor! == chainedControlSubjectRepairIndex!
                                        -> if {
                                            true => chainedControlSubjectInside!
                                        } else {
                                            nodes[chainedControlSubjectAncestor!].parent => chainedControlSubjectAncestor!
                                        }
                                }
                            chainedControlSubjectInside!
                                and chainedControlConsumer!.operand0 != chainedControlSubjectRepairIndex!
                                -> if {
                                    chainedControlSubjectRepairIndex! => chainedControlConsumer!.operand0
                                    chainedControlConsumer! => nodes[chainedControlConsumerIndex]
                                }
                        }
                }
            chainedControlSubjectRepairIndex! + 1 => chainedControlSubjectRepairIndex!
        }
    nodes -> repairReturnedEnumMatchResults(prepared, frozenRecursiveSemanticTypes, recursiveTypeFlags)
    # Once an enum match has a canonical numeric result type, propagate that
    # context into a direct negated-literal arm result. The unary node and its
    # literal can otherwise retain the default Int type even when a preceding
    # payload arm establishes Long, causing LLVM to emit i32 subtraction and
    # select an unrelated same-typed payload temporary for the arm result.
    0 => enumArmNegatedLiteralRepairIndex!
    enumArmNegatedLiteralRepairIndex! < (nodes -> len)
        -> while {
            nodes[enumArmNegatedLiteralRepairIndex!] => enumArmNegatedLiteralMatch
            enumArmNegatedLiteralMatch.kind == 27
                and enumArmNegatedLiteralMatch.typeId >= 0
                and enumArmNegatedLiteralMatch.typeId < (frozenRecursiveSemanticTypes -> len)
                -> if {
                    frozenRecursiveSemanticTypes[enumArmNegatedLiteralMatch.typeId] => enumArmNegatedLiteralResultType
                    enumArmNegatedLiteralResultType.kind == 1
                        and enumArmNegatedLiteralResultType.origin == 1
                        and enumArmNegatedLiteralResultType.symbol >= 2
                        and enumArmNegatedLiteralResultType.symbol <= 14
                        -> if {
                            enumArmNegatedLiteralMatch.operand1 => enumArmNegatedLiteralArmIndex!
                            enumArmNegatedLiteralArmIndex! >= 0 -> while {
                                nodes[enumArmNegatedLiteralArmIndex!] => enumArmNegatedLiteralArm
                                0 => enumArmNegatedLiteralCandidateIndex!
                                enumArmNegatedLiteralCandidateIndex! < (nodes -> len)
                                    -> while {
                                        nodes[enumArmNegatedLiteralCandidateIndex!] => enumArmNegatedLiteralCandidate!
                                        enumArmNegatedLiteralCandidate!.kind == 7
                                            and enumArmNegatedLiteralCandidate!.opcode == grammar.tokenIdMinus()
                                            and enumArmNegatedLiteralCandidate!.parent == enumArmNegatedLiteralArmIndex!
                                            and enumArmNegatedLiteralCandidate!.operand0 >= 0
                                            and enumArmNegatedLiteralCandidate!.operand0 < (nodes -> len)
                                            and nodes[enumArmNegatedLiteralCandidate!.operand0].kind == 3
                                            -> if {
                                                nodes[enumArmNegatedLiteralCandidate!.operand0] => enumArmNegatedLiteralValue!
                                                enumArmNegatedLiteralMatch.typeId => enumArmNegatedLiteralValue!.typeId
                                                enumArmNegatedLiteralResultType.kind => enumArmNegatedLiteralValue!.typeKind
                                                enumArmNegatedLiteralResultType.origin => enumArmNegatedLiteralValue!.typeOrigin
                                                enumArmNegatedLiteralResultType.module => enumArmNegatedLiteralValue!.typeModule
                                                enumArmNegatedLiteralResultType.symbol => enumArmNegatedLiteralValue!.typeSymbol
                                                recursiveTypeFlags[enumArmNegatedLiteralMatch.typeId] => enumArmNegatedLiteralValue!.typeFlags
                                                enumArmNegatedLiteralValue! => nodes[enumArmNegatedLiteralCandidate!.operand0]
                                                enumArmNegatedLiteralMatch.typeId => enumArmNegatedLiteralCandidate!.typeId
                                                enumArmNegatedLiteralResultType.kind => enumArmNegatedLiteralCandidate!.typeKind
                                                enumArmNegatedLiteralResultType.origin => enumArmNegatedLiteralCandidate!.typeOrigin
                                                enumArmNegatedLiteralResultType.module => enumArmNegatedLiteralCandidate!.typeModule
                                                enumArmNegatedLiteralResultType.symbol => enumArmNegatedLiteralCandidate!.typeSymbol
                                                recursiveTypeFlags[enumArmNegatedLiteralMatch.typeId] => enumArmNegatedLiteralCandidate!.typeFlags
                                                enumArmNegatedLiteralCandidate! => nodes[enumArmNegatedLiteralCandidateIndex!]
                                            }
                                        enumArmNegatedLiteralCandidateIndex! + 1 => enumArmNegatedLiteralCandidateIndex!
                                    }
                                enumArmNegatedLiteralArm.nextOperand => enumArmNegatedLiteralArmIndex!
                            }
                        }
                }
            enumArmNegatedLiteralRepairIndex! + 1 => enumArmNegatedLiteralRepairIndex!
        }
    nodes -> repairNestedEnumPayloadSubjects
    # Enum payload bindings use the canonical subject and exact arm variant.
    # Option/Result carry payload ids; nominal enums resolve the declared type AST.
    0 => enumPayloadTypeRepairIndex!
    enumPayloadTypeRepairIndex! < (nodes -> len)
        -> while {
            nodes[enumPayloadTypeRepairIndex!] => enumPayloadTypeRepair!
            enumPayloadTypeRepair!.kind == 29
                and enumPayloadTypeRepair!.parent >= 0
                and nodes[enumPayloadTypeRepair!.parent].kind == 19
                and nodes[enumPayloadTypeRepair!.parent].parent >= 0
                and nodes[nodes[enumPayloadTypeRepair!.parent].parent].kind == 27
                -> if {
                    nodes[enumPayloadTypeRepair!.parent] => enumPayloadArm
                    nodes[enumPayloadArm.parent] => enumPayloadMatch
                    -1 => enumPayloadTypeId!
                    enumPayloadMatch.operand0 >= 0 -> if {
                        nodes[enumPayloadMatch.operand0] => enumPayloadSubject
                        enumPayloadSubject.typeId >= 0 -> if {
                            frozenRecursiveSemanticTypes[enumPayloadSubject.typeId] => enumPayloadSubjectType
                            enumPayloadSubjectType.kind == 7 and enumPayloadSubjectType.origin == 4
                                -> if {
                                    enumPayloadSubjectType.symbol == 0 -> if { enumPayloadSubjectType.first => enumPayloadTypeId! }
                                    enumPayloadSubjectType.symbol == 1 -> if {
                                        enumPayloadArm.opcode == 0 -> if { enumPayloadSubjectType.first => enumPayloadTypeId! } else { enumPayloadSubjectType.second => enumPayloadTypeId! }
                                    }
                                }
                            enumPayloadSubjectType.kind == 1 -> if {
                                enumPayloadSubjectType.module => enumPayloadOwnerSource!
                                enumPayloadSubjectType.origin == 2 -> if {
                                    enumPayloadSubjectType.module >= 0 and enumPayloadSubjectType.module < (prepared.modules -> len)
                                        -> if {
                                            prepared.modules[enumPayloadSubjectType.module].sourceIndex => enumPayloadOwnerSource!
                                        }
                                }
                                enumPayloadOwnerSource! >= 0 and enumPayloadOwnerSource! < (prepared.package.ranges -> len)
                                    -> if {
