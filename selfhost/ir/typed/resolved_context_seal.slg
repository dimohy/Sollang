                                                enumPayloadPatternCandidate.parent => enumPayloadPatternParent!
                                                enumPayloadPatternParent! >= 0 and prepared.package.nodes[enumPayloadUseRange.astStart + enumPayloadPatternParent!].kind == 70
                                                    -> if {
