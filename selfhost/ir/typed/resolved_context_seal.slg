                            prepared.package.nodes[structuralMemberRange.astStart + structuralMember!.astNode] => structuralMemberAst
                            prepared.package.nodes[structuralMemberRange.astStart + structuralMemberBase.astNode] => structuralMemberBaseAst
                            structuralMemberBaseAst.start + structuralMemberBaseAst.length => structuralMemberBaseEnd
                            structuralMemberAst.firstToken => structuralMemberTokenIndex!
