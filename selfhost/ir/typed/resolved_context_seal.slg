    # slice/fixed/growable SSA value rather than an untyped placeholder.
    0 => contextualCallLiteralIndex!
    contextualCallLiteralIndex! < (nodes -> len)
        -> while {
            nodes[contextualCallLiteralIndex!] => contextualCallLiteral
            (contextualCallLiteral.kind == 6 or contextualCallLiteral.kind == 9)
                and contextualCallLiteral.symbol >= 0
                and contextualCallLiteral.operand0 >= 0 -> if {
                    contextualCallLiteral.targetModule => contextualCallTargetModule!
                    contextualCallTargetModule! < 0 -> if { contextualCallLiteral.sourceModule => contextualCallTargetModule! }
                    -1 => contextualCallFunctionIndex!
                    0 => contextualCallFunctionSearch!
                    contextualCallFunctionSearch! < (nodes -> len) and contextualCallFunctionIndex! < 0
                        -> while {
