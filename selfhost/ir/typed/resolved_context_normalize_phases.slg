                        -1 => intrinsicSourceTextIr!.typeModule
                        24 => intrinsicSourceTextIr!.typeSymbol
                        3 => intrinsicSourceTextIr!.typeKind
                        intrinsicSourceTextArrayTypeId! >= 0 -> if { recursiveTypeFlags[intrinsicSourceTextArrayTypeId!] => intrinsicSourceTextIr!.typeFlags }
