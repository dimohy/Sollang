    canonicalBindingChildSeed! < (nodes -> len) -> while {
        canonicalBindingChildHeads! -> push(-1)
        canonicalBindingChildNext! -> push(-1)
        canonicalBindingChildSeed! + 1 => canonicalBindingChildSeed!
    }
    (nodes -> len) - 1 => canonicalBindingChildIndex!
