# Ordered normalization phases extracted from normalizeResolvedContext.
# Each phase mutates only the caller-owned Typed IR and borrows analysis tables.

normalizeResolvedCore nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, inferred: ref [expressionTypes.ExpressionType; ~], frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], frozenRecursiveTypeByAst: ref [Int; ~], recursiveReferences: ref [typeIds.TypeReference; ~], recursiveTypeFlags: ref [Int; ~] -> Unit {
    # Visit each owned aggregate value once and walk only its ancestor chain.
    # The former binding-first pass rescanned the complete compiler IR for
    # every owned array/dictionary binding, making this repair O(n^2).
    [Int; ~] => repairedOwnedBindings!
    0 => repairedOwnedBindingSeed!
    repairedOwnedBindingSeed! < (nodes -> len)
        -> while {
            repairedOwnedBindings! -> push(0)
            repairedOwnedBindingSeed! + 1 => repairedOwnedBindingSeed!
        }
    0 => ownedValueIndex!
    ownedValueIndex! < (nodes -> len) -> while {
        nodes[ownedValueIndex!] => ownedValueCandidate
        ownedValueCandidate.kind == 14 or ownedValueCandidate.kind == 16
            -> if {
                ownedValueCandidate.parent => ownedValueAncestor!
                ownedValueAncestor! >= 0 -> while {
                    nodes[ownedValueAncestor!] => ownedBinding!
                    ownedBinding!.kind == 17 and repairedOwnedBindings![ownedValueAncestor!] == 0 and ((ownedBinding!.typeOrigin == 13 and ownedValueCandidate.kind == 14) or (ownedBinding!.typeOrigin == 15 and ownedValueCandidate.kind == 16))
                        -> if {
                            ownedValueIndex! => ownedBinding!.operand0
                            ownedBinding! => nodes[ownedValueAncestor!]
                            1 => repairedOwnedBindings![ownedValueAncestor!]
                        }
                    ownedBinding!.parent => ownedValueAncestor!
                }
            }
        ownedValueIndex! + 1 => ownedValueIndex!
    }
    # A nullary flow source names its declaration by source-local symbol. Build
    # that identity once instead of rescanning the complete merged IR for every
    # call source. The first declaration wins, matching the former ordered scan.
    [Int; ~] => nullaryFunctionBySymbol!
    0 => nullaryFunctionSymbolSeed!
    nullaryFunctionSymbolSeed! < (prepared.package.symbols -> len)
        -> while {
            nullaryFunctionBySymbol! -> push(-1)
            nullaryFunctionSymbolSeed! + 1 => nullaryFunctionSymbolSeed!
        }
    0 => nullaryFunctionIndex!
    nullaryFunctionIndex! < (nodes -> len) -> while {
        nodes[nullaryFunctionIndex!] => nullaryFunction
        nullaryFunction.kind == 0
            and nullaryFunction.sourceModule >= 0
            and nullaryFunction.sourceModule < (prepared.package.ranges -> len)
            and nullaryFunction.symbol >= 0
            and nullaryFunction.operand1 < 0
            and nullaryFunction.nextOperand < 0
            -> if {
                prepared.package.ranges[nullaryFunction.sourceModule] => nullaryFunctionRange
                nullaryFunction.symbol < nullaryFunctionRange.symbolCount
                    -> if {
                        nullaryFunctionRange.symbolStart + nullaryFunction.symbol => nullaryFunctionGlobalSymbol
                        nullaryFunctionBySymbol![nullaryFunctionGlobalSymbol] < 0
                            -> if { nullaryFunctionIndex! => nullaryFunctionBySymbol![nullaryFunctionGlobalSymbol] }
                    }
            }
        nullaryFunctionIndex! + 1 => nullaryFunctionIndex!
    }
    0 => memberIndex!
    0 => nullaryFlowSourceIndex!
    nullaryFlowSourceIndex! < (nodes -> len) -> while {
        nodes[nullaryFlowSourceIndex!] => nullaryFlowSource!
        nullaryFlowSource!.kind == 5
            and nullaryFlowSource!.parent >= 0
            and nodes[nullaryFlowSource!.parent].kind == 6
            and nodes[nullaryFlowSource!.parent].operand0 == nullaryFlowSourceIndex!
            -> if {
                -1 => nullaryFlowFunctionIr!
                nullaryFlowSource!.sourceModule >= 0
                    and nullaryFlowSource!.sourceModule < (prepared.package.ranges -> len)
                    and nullaryFlowSource!.symbol >= 0
                    -> if {
                        prepared.package.ranges[nullaryFlowSource!.sourceModule] => nullaryFlowSourceRange
                        nullaryFlowSource!.symbol < nullaryFlowSourceRange.symbolCount
                            -> if {
                                nullaryFunctionBySymbol![nullaryFlowSourceRange.symbolStart + nullaryFlowSource!.symbol] => nullaryFlowFunctionIr!
                            }
                    }
                nullaryFlowFunctionIr! >= 0 -> if {
                    nodes[nullaryFlowFunctionIr!] => nullaryFlowFunction
                    6 => nullaryFlowSource!.kind
                    nullaryFlowSource!.sourceModule => nullaryFlowSource!.targetModule
                    nullaryFlowFunction.typeOrigin => nullaryFlowSource!.typeOrigin
                    nullaryFlowFunction.typeModule => nullaryFlowSource!.typeModule
                    nullaryFlowFunction.typeSymbol => nullaryFlowSource!.typeSymbol
                    nullaryFlowFunction.typeId => nullaryFlowSource!.typeId
                    nullaryFlowFunction.typeKind => nullaryFlowSource!.typeKind
                    nullaryFlowFunction.typeFlags => nullaryFlowSource!.typeFlags
                    nullaryFlowSource! => nodes[nullaryFlowSourceIndex!]
                }
            }
        nullaryFlowSourceIndex! + 1 => nullaryFlowSourceIndex!
    }
    memberIndex! < (nodes -> len) -> while {
        nodes[memberIndex!] => member!
        member!.kind == 13 and member!.operand0 >= 0
            -> if {
                nodes[member!.operand0] => memberBase
                memberBase.typeOrigin => memberCurrentOrigin!
                memberBase.typeModule => memberCurrentModule!
                memberBase.typeSymbol => memberCurrentSymbol!
                prepared.package.ranges[member!.sourceModule] => memberSourceRange
                prepared.package.nodes[memberSourceRange.astStart + member!.astNode] => memberAst
                # The operand already represents the complete typed base. Resolve
                # only the trailing path, so an identifier inside values[index]
                # cannot be mistaken for a field in values[index].field.
                1 => memberIdentifierOrdinal!
                prepared.package.nodes[memberSourceRange.astStart + memberBase.astNode] => memberBaseAst
                memberBaseAst.start + memberBaseAst.length => memberBaseEnd
                memberAst.firstToken => memberTokenIndex!
                true => beforeMemberBaseEnd!
                beforeMemberBaseEnd! and memberTokenIndex! < memberAst.firstToken + memberAst.tokenCount
                    -> while {
                        prepared.package.tokens[memberSourceRange.tokenStart + memberTokenIndex!].span.start < memberBaseEnd
                            -> if {
                                memberTokenIndex! + 1 => memberTokenIndex!
                            } else {
                                false => beforeMemberBaseEnd!
                            }
                    }
                # Canonical field identity also handles a ref T base. The legacy
                # projection below carries the unwrapped nominal spelling, while
                # the canonical arena is authoritative for readonly places.
                memberBase.typeId => canonicalMemberOwnerType!
                canonicalMemberOwnerType! >= 0 and (frozenRecursiveSemanticTypes[canonicalMemberOwnerType!].kind == 8 or frozenRecursiveSemanticTypes[canonicalMemberOwnerType!].kind == 6)
                    -> if {
                        frozenRecursiveSemanticTypes[canonicalMemberOwnerType!].first => canonicalMemberOwnerType!
                    }
                -1 => canonicalResolvedMemberType!
                memberTokenIndex! => canonicalMemberTokenIndex!
                canonicalMemberTokenIndex! < memberAst.firstToken + memberAst.tokenCount
                    -> while {
                        prepared.package.tokens[memberSourceRange.tokenStart + canonicalMemberTokenIndex!] => canonicalMemberToken
                        canonicalMemberOwnerType! >= 0 and canonicalMemberToken.kind == grammar.tokenIdIdentifier()
                            -> if {
                                -1 => canonicalMatchedFieldType!
                                0 => canonicalMemberFieldIndex!
                                canonicalMemberFieldIndex! < (recursiveTypes.fields -> len)
                                    -> while {
                                        recursiveTypes.fields[canonicalMemberFieldIndex!] => canonicalMemberField
                                        canonicalMemberField.status == 0 and canonicalMemberField.ownerType == canonicalMemberOwnerType!
                                            -> if {
                                                prepared.package.ranges[canonicalMemberField.sourceModule] => canonicalMemberFieldRange
                                                -1 => canonicalMemberFieldNameToken!
                                                canonicalMemberField.labelToken >= 0 -> if {
                                                    canonicalMemberField.labelToken => canonicalMemberFieldNameToken!
                                                } else {
                                                    canonicalMemberField.fieldSymbol >= 0 -> if {
                                                        prepared.package.symbols[canonicalMemberFieldRange.symbolStart + canonicalMemberField.fieldSymbol] => canonicalMemberFieldSymbol
                                                        canonicalMemberFieldSymbol.nameToken => canonicalMemberFieldNameToken!
                                                    }
                                                }
                                                canonicalMemberFieldNameToken! >= 0 -> if {
                                                    prepared.package.tokens[canonicalMemberFieldRange.tokenStart + canonicalMemberFieldNameToken!] => canonicalMemberFieldName
                                                    canonicalMemberToken.span.length == canonicalMemberFieldName.span.length => canonicalMemberNameEqual!
                                                    UIntSize(0) => canonicalMemberNameByte!
                                                    canonicalMemberNameEqual! and canonicalMemberNameByte! < canonicalMemberToken.span.length
                                                        -> while {
                                                            (prepared.package.sources[member!.sourceModule] -> byte(canonicalMemberToken.span.start + canonicalMemberNameByte!)) != (prepared.package.sources[canonicalMemberField.sourceModule] -> byte(canonicalMemberFieldName.span.start + canonicalMemberNameByte!))
                                                                -> if { false => canonicalMemberNameEqual! }
                                                            canonicalMemberNameByte! + 1 => canonicalMemberNameByte!
                                                        }
                                                    canonicalMemberNameEqual! -> if {
                                                        canonicalMemberField.ordinal => member!.symbol
                                                        canonicalMemberField.sourceModule => member!.targetModule
                                                        canonicalMemberField.fieldType => canonicalMatchedFieldType!
                                                    }
                                                } else {
                                                    canonicalMemberToken.span.length >= 2 and (prepared.package.sources[member!.sourceModule] -> byte(canonicalMemberToken.span.start)) == 95
                                                        -> if {
                                                            0 => canonicalOrdinalValue!
                                                            true => canonicalOrdinalValid!
                                                            UIntSize(1) => canonicalOrdinalByteIndex!
                                                            canonicalOrdinalByteIndex! < canonicalMemberToken.span.length
                                                                -> while {
                                                                    prepared.package.sources[member!.sourceModule] -> byte(canonicalMemberToken.span.start + canonicalOrdinalByteIndex!) => canonicalOrdinalByte
                                                                    canonicalOrdinalByte < 48 or canonicalOrdinalByte > 57
                                                                        -> if {
                                                                            false => canonicalOrdinalValid!
                                                                        } else {
                                                                            canonicalOrdinalValue! * 10 + Int(canonicalOrdinalByte - 48) => canonicalOrdinalValue!
                                                                        }
                                                                    canonicalOrdinalByteIndex! + 1 => canonicalOrdinalByteIndex!
                                                                }
                                                            canonicalOrdinalValid! and canonicalOrdinalValue! == canonicalMemberField.ordinal
                                                                -> if {
                                                                    canonicalMemberField.ordinal => member!.symbol
                                                                    canonicalMemberField.sourceModule => member!.targetModule
                                                                    canonicalMemberField.fieldType => canonicalMatchedFieldType!
                                                                }
                                                        }
                                                }
                                            }
                                        canonicalMemberFieldIndex! + 1 => canonicalMemberFieldIndex!
                                    }
                                canonicalMatchedFieldType! => canonicalMemberOwnerType!
                                canonicalMatchedFieldType! => canonicalResolvedMemberType!
                            }
                        canonicalMemberTokenIndex! + 1 => canonicalMemberTokenIndex!
                    }
                canonicalResolvedMemberType! >= 0 -> if {
                    frozenRecursiveSemanticTypes[canonicalResolvedMemberType!] => canonicalResolvedSemanticType
                    canonicalResolvedSemanticType.origin => member!.typeOrigin
                    canonicalResolvedSemanticType.module => member!.typeModule
                    canonicalResolvedSemanticType.symbol => member!.typeSymbol
                    canonicalResolvedMemberType! => member!.typeId
                    canonicalResolvedSemanticType.kind => member!.typeKind
                    recursiveTypeFlags[canonicalResolvedMemberType!] => member!.typeFlags
                }
                memberTokenIndex! < memberAst.firstToken + memberAst.tokenCount
                    -> while {
                        prepared.package.tokens[memberSourceRange.tokenStart + memberTokenIndex!].kind == grammar.tokenIdIdentifier()
                            -> if {
                                memberIdentifierOrdinal! > 0 -> if {
                                    memberCurrentModule! => memberOwnerSource!
                                    memberCurrentOrigin! == 2 -> if { prepared.modules[memberCurrentModule!].sourceIndex => memberOwnerSource! }
                                    memberOwnerSource! >= 0 and memberOwnerSource! < (prepared.package.ranges -> len)
                                        -> if {
                                            prepared.package.ranges[memberOwnerSource!] => memberOwnerRange
                                            0 => memberFieldOrdinal!
                                            0 => memberFieldIndex!
                                            memberFieldIndex! < memberOwnerRange.symbolCount
                                                -> while {
                                                    prepared.package.symbols[memberOwnerRange.symbolStart + memberFieldIndex!] => memberField
                                                    memberField.kind == 26 and memberField.parent == memberCurrentSymbol!
                                                        -> if {
                                                            prepared.package.tokens[memberSourceRange.tokenStart + memberTokenIndex!] => memberName
                                                            prepared.package.tokens[memberOwnerRange.tokenStart + memberField.nameToken] => memberFieldName
                                                            memberName.span.length == memberFieldName.span.length => memberEqual!
                                                            UIntSize(0) => memberNameByte!
                                                            memberEqual! and memberNameByte! < memberName.span.length
                                                                -> while {
                                                                    prepared.package.sources[member!.sourceModule] -> byte(memberName.span.start + memberNameByte!) => memberByte
                                                                    prepared.package.sources[memberOwnerSource!] -> byte(memberFieldName.span.start + memberNameByte!) => memberFieldByte
                                                                    memberByte != memberFieldByte -> if { false => memberEqual! }
                                                                    memberNameByte! + 1 => memberNameByte!
                                                                }
                                                            memberEqual! -> if {
                                                                memberFieldOrdinal! => member!.symbol
                                                                memberOwnerSource! => member!.targetModule
                                                                -1 => memberFieldTypeIndex!
                                                                0 => memberFieldTypeSearch!
                                                                memberFieldTypeSearch! < (prepared.nominal -> len)
                                                                    -> while {
                                                                        prepared.nominal[memberFieldTypeSearch!].sourceModule == memberOwnerSource! and prepared.nominal[memberFieldTypeSearch!].typeAst == memberField.typeNode
                                                                            -> if { memberFieldTypeSearch! => memberFieldTypeIndex! }
                                                                        memberFieldTypeSearch! + 1 => memberFieldTypeSearch!
                                                                    }
                                                                memberFieldTypeIndex! >= 0 -> if {
                                                                    prepared.nominal[memberFieldTypeIndex!] => memberFieldType
                                                                    memberFieldType.origin => memberCurrentOrigin!
                                                                    memberFieldType.targetModule => memberCurrentModule!
                                                                    memberFieldType.targetSymbol => memberCurrentSymbol!
                                                                } else {
                                                                    0 => memberCompositeSearch!
                                                                    memberCompositeSearch! < (prepared.composite -> len)
                                                                        -> while {
                                                                            prepared.composite[memberCompositeSearch!] => memberCompositeType
                                                                            memberCompositeType.sourceModule == memberOwnerSource! and memberCompositeType.typeAst == memberField.typeNode
                                                                                -> if {
                                                                                    10 + memberCompositeType.kind => memberCurrentOrigin!
                                                                                    memberCompositeType.kind == 5 -> if {
                                                                                        memberCompositeType.keySymbol => memberCurrentModule!
                                                                                        memberCompositeType.valueSymbol => memberCurrentSymbol!
                                                                                    } else {
                                                                                        memberCompositeType.elementModule => memberCurrentModule!
                                                                                        memberCompositeType.elementSymbol => memberCurrentSymbol!
                                                                                    }
                                                                                }
                                                                            memberCompositeSearch! + 1 => memberCompositeSearch!
                                                                        }
                                                                }
                                                                memberCurrentOrigin! => member!.typeOrigin
                                                                memberCurrentModule! => member!.typeModule
                                                                memberCurrentSymbol! => member!.typeSymbol
                                                                0 => memberTypeReferenceIndex!
                                                                memberTypeReferenceIndex! < (recursiveReferences -> len)
                                                                    -> while {
                                                                        recursiveReferences[memberTypeReferenceIndex!] => memberTypeReference
                                                                        memberTypeReference.status == 0 and memberTypeReference.sourceModule == memberOwnerSource! and memberTypeReference.typeAst == memberField.typeNode
                                                                            -> if {
                                                                                memberTypeReference.typeId => member!.typeId
                                                                                frozenRecursiveSemanticTypes[memberTypeReference.typeId].kind => member!.typeKind
                                                                                recursiveTypeFlags[memberTypeReference.typeId] => member!.typeFlags
                                                                            }
                                                                        memberTypeReferenceIndex! + 1 => memberTypeReferenceIndex!
                                                                    }
                                                            }
                                                            memberFieldOrdinal! + 1 => memberFieldOrdinal!
                                                        }
                                                    memberFieldIndex! + 1 => memberFieldIndex!
                                                }
                                        }
                                }
                                memberIdentifierOrdinal! + 1 => memberIdentifierOrdinal!
                            }
                        memberTokenIndex! + 1 => memberTokenIndex!
                    }
                member! => nodes[memberIndex!]
            }
        memberIndex! + 1 => memberIndex!
    }
    0 => loopExitIndex!
    loopExitIndex! < (nodes -> len) -> while {
        nodes[loopExitIndex!] => loopExit!
        loopExit!.kind == 21 or loopExit!.kind == 22
            -> if {
                loopExit!.parent => targetLoop!
                targetLoop! >= 0 and nodes[targetLoop!].kind != 20
                    -> while {
                        nodes[targetLoop!].parent => targetLoop!
                    }
                targetLoop! => loopExit!.operand0
                loopExit! => nodes[loopExitIndex!]
            }
        loopExitIndex! + 1 => loopExitIndex!
    }
    0 => recursiveIrIndex!
    recursiveIrIndex! < (nodes -> len) -> while {
        nodes[recursiveIrIndex!] => recursiveIr!
        -1 => recursiveIrTypeId!
        recursiveIr!.sourceModule >= 0 and recursiveIr!.sourceModule < (prepared.package.ranges -> len) and recursiveIr!.astNode >= 0
            -> if {
                prepared.package.ranges[recursiveIr!.sourceModule] => recursiveIrRange
                recursiveIr!.astNode < recursiveIrRange.astCount
                    -> if {
                        frozenRecursiveTypeByAst[recursiveIrRange.astStart + recursiveIr!.astNode] => recursiveIrTypeId!
                    }
            }
        recursiveIrTypeId! >= 0 and recursiveIr!.kind != 0 and recursiveIr!.kind != 1 and recursiveIr!.kind != 10 and recursiveIr!.kind != 11
            -> if {
                recursiveIrTypeId! => recursiveIr!.typeId
                frozenRecursiveSemanticTypes[recursiveIrTypeId!] => recursiveExpressionType
                recursiveExpressionType.kind => recursiveIr!.typeKind
                recursiveExpressionType.origin => recursiveIr!.typeOrigin
                recursiveExpressionType.module => recursiveIr!.typeModule
                recursiveExpressionType.symbol => recursiveIr!.typeSymbol
                recursiveTypeFlags[recursiveIrTypeId!] => recursiveIr!.typeFlags
            }
        # Intrinsic signatures are authoritative after recursive AST types
        # have been projected onto IR. `slice` always returns Text; neither
        # the SourceText receiver nor its UIntSize operands may determine the
        # result type consumed by later calls such as print.
        recursiveIr!.opcode == -203 -> if {
            1 => recursiveIr!.typeOrigin
            -1 => recursiveIr!.typeModule
            1 => recursiveIr!.typeSymbol
            -1 => recursiveIr!.typeId
            1 => recursiveIr!.typeKind
            0 => recursiveIr!.typeFlags
        }
        recursiveIr!.opcode == -236 -> if {
            recursiveIr!.operand0 => canonicalCapacityReceiver!
            canonicalCapacityReceiver! >= 0
                and canonicalCapacityReceiver! < (nodes -> len)
                and nodes[canonicalCapacityReceiver!].kind == 9
                and nodes[canonicalCapacityReceiver!].opcode == -236
                and nodes[canonicalCapacityReceiver!].operand0 >= 0
                and nodes[canonicalCapacityReceiver!].operand0 != canonicalCapacityReceiver!
                -> while {
                    nodes[canonicalCapacityReceiver!].operand0 => canonicalCapacityReceiver!
                }
            canonicalCapacityReceiver! >= 0 -> if { canonicalCapacityReceiver! => recursiveIr!.operand0 }
            1 => recursiveIr!.typeOrigin
            -1 => recursiveIr!.typeModule
            13 => recursiveIr!.typeSymbol
            13 => recursiveIr!.typeId
            1 => recursiveIr!.typeKind
            0 => recursiveIr!.typeFlags
        }
        recursiveIr!.kind == 6 and recursiveIr!.symbol < 0 and recursiveIr!.opcode == -1 and recursiveIr!.typeKind == 7 and recursiveIr!.typeOrigin == 4
            -> if {
                recursiveIr!.typeSymbol == 5 -> if { -237 => recursiveIr!.opcode }
                recursiveIr!.typeSymbol == 6 -> if { -238 => recursiveIr!.opcode }
                recursiveIr!.typeSymbol == 7 -> if { -239 => recursiveIr!.opcode }
            }
        recursiveIr!.kind == 6 and recursiveIr!.symbol < 0 and recursiveIr!.opcode == -1 and recursiveIr!.typeKind == 14 and recursiveIr!.typeOrigin == 4 and recursiveIr!.typeSymbol == 8
            -> if {
                -240 => recursiveIr!.opcode
            }
        recursiveIr! => nodes[recursiveIrIndex!]
        recursiveIrIndex! + 1 => recursiveIrIndex!
    }
}

normalizeResolvedBindings nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, inferred: ref [expressionTypes.ExpressionType; ~], frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], frozenRecursiveTypeByAst: ref [Int; ~], recursiveReferences: ref [typeIds.TypeReference; ~], recursiveTypeFlags: ref [Int; ~] -> Unit {
    # Constructor opcode specialization happens after local parent linking.
    # Repair nested owner annotations only now, when an inner `box T` wrapper
    # can be distinguished from a runtime box expression by its collection
    # constructor child. The later finalized-binding/read pass propagates the
    # corrected canonical owner type through every use.
    0 => nestedCollectionBindingIndex!
    nestedCollectionBindingIndex! < (nodes -> len)
        -> while {
            nodes[nestedCollectionBindingIndex!] => nestedCollectionBinding!
            nestedCollectionBinding!.kind == 17
                and nestedCollectionBinding!.operand0 >= 0
                and nodes[nestedCollectionBinding!.operand0].kind == 9
                and nodes[nestedCollectionBinding!.operand0].opcode == -27
                -> if {
                    nestedCollectionBinding!.operand0 => nestedCollectionWrapper
                    -1 => nestedCollectionConstructor!
                    0 => nestedCollectionConstructorSearch!
                    nestedCollectionConstructorSearch! < (nodes -> len)
                        -> while {
                            nodes[nestedCollectionConstructorSearch!] => nestedCollectionConstructorCandidate
                            nestedCollectionConstructorCandidate.parent == nestedCollectionWrapper
                                and nestedCollectionConstructorCandidate.kind == 6
                                and nestedCollectionConstructorCandidate.opcode <= -237
                                and nestedCollectionConstructorCandidate.opcode >= -240
                                -> if {
                                    nestedCollectionConstructorSearch! => nestedCollectionConstructor!
                                }
                            nestedCollectionConstructorSearch! + 1 => nestedCollectionConstructorSearch!
                        }
                    nestedCollectionConstructor! >= 0 -> if {
                        nestedCollectionConstructor! => nestedCollectionBinding!.operand0
                        nestedCollectionBinding! => nodes[nestedCollectionBindingIndex!]
                    }
                }
            nestedCollectionBindingIndex! + 1 => nestedCollectionBindingIndex!
        }
    # SourceText-producing runtime expressions and the bindings that receive
    # them can retain either the imported declaration identity or the canonical
    # builtin projection while lacking a recursive ID. Recover the canonical
    # identity and its ownership traits once at the IR boundary before
    # binding/reference/index propagation.
    -1 => intrinsicSourceTextModule!
    -1 => intrinsicSourceTextSymbol!
    0 => intrinsicSourceTextModuleSearch!
    intrinsicSourceTextModuleSearch! < (prepared.modules -> len)
        -> while {
            prepared.modules[intrinsicSourceTextModuleSearch!] => intrinsicSourceTextIdentity
            prepared.package.sources[intrinsicSourceTextIdentity.sourceIndex] -> len => intrinsicSourceTextLength
            prepared.package.sources[intrinsicSourceTextIdentity.sourceIndex] -> slice(UIntSize(0), intrinsicSourceTextLength) => intrinsicSourceTextSource
            intrinsicSourceTextIdentity.pathLength == 8 => intrinsicSourceTextNamespaceEqual!
            "sys.file" => intrinsicSourceTextNamespace
            UIntSize(0) => intrinsicSourceTextNamespaceByte!
            intrinsicSourceTextNamespaceEqual! and intrinsicSourceTextNamespaceByte! < intrinsicSourceTextIdentity.pathLength
                -> while {
                    (intrinsicSourceTextSource -> byte(intrinsicSourceTextIdentity.pathStart + intrinsicSourceTextNamespaceByte!)) != (intrinsicSourceTextNamespace -> byte(intrinsicSourceTextNamespaceByte!))
                        -> if { false => intrinsicSourceTextNamespaceEqual! }
                    intrinsicSourceTextNamespaceByte! + 1 => intrinsicSourceTextNamespaceByte!
                }
            intrinsicSourceTextNamespaceEqual! -> if {
                prepared.package.ranges[intrinsicSourceTextIdentity.sourceIndex] => intrinsicSourceTextRange
                0 => intrinsicSourceTextSymbolSearch!
                intrinsicSourceTextSymbolSearch! < intrinsicSourceTextRange.symbolCount
                    -> while {
                        prepared.package.symbols[intrinsicSourceTextRange.symbolStart + intrinsicSourceTextSymbolSearch!] => intrinsicSourceTextCandidate
                        intrinsicSourceTextCandidate.kind == 3 and intrinsicSourceTextCandidate.parent < 0
                            -> if {
                                prepared.package.tokens[intrinsicSourceTextRange.tokenStart + intrinsicSourceTextCandidate.nameToken] => intrinsicSourceTextNameToken
                                intrinsicSourceTextNameToken.span.length == 10 => intrinsicSourceTextNameEqual!
                                "SourceText" => intrinsicSourceTextName
                                UIntSize(0) => intrinsicSourceTextNameByte!
                                intrinsicSourceTextNameEqual! and intrinsicSourceTextNameByte! < intrinsicSourceTextNameToken.span.length
                                    -> while {
                                        (intrinsicSourceTextSource -> byte(intrinsicSourceTextNameToken.span.start + intrinsicSourceTextNameByte!)) != (intrinsicSourceTextName -> byte(intrinsicSourceTextNameByte!))
                                            -> if { false => intrinsicSourceTextNameEqual! }
                                        intrinsicSourceTextNameByte! + 1 => intrinsicSourceTextNameByte!
                                    }
                                intrinsicSourceTextNameEqual! -> if {
                                    intrinsicSourceTextIdentity.sourceIndex => intrinsicSourceTextModule!
                                    intrinsicSourceTextSymbolSearch! => intrinsicSourceTextSymbol!
                                }
                            }
                        intrinsicSourceTextSymbolSearch! + 1 => intrinsicSourceTextSymbolSearch!
                    }
            }
            intrinsicSourceTextModuleSearch! + 1 => intrinsicSourceTextModuleSearch!
        }
    -1 => intrinsicSourceTextTypeId!
    0 => intrinsicSourceTextTypeSearch!
    intrinsicSourceTextTypeSearch! < (frozenRecursiveSemanticTypes -> len)
        -> while {
            frozenRecursiveSemanticTypes[intrinsicSourceTextTypeSearch!] => intrinsicSourceTextTypeCandidate
            intrinsicSourceTextTypeCandidate.kind == 1 and intrinsicSourceTextTypeCandidate.origin == 1 and intrinsicSourceTextTypeCandidate.symbol == 24
                -> if {
                    intrinsicSourceTextTypeSearch! => intrinsicSourceTextTypeId!
                }
            intrinsicSourceTextTypeSearch! + 1 => intrinsicSourceTextTypeSearch!
        }
    -1 => intrinsicSourceTextArrayTypeId!
    0 => intrinsicSourceTextArraySearch!
    intrinsicSourceTextArraySearch! < (frozenRecursiveSemanticTypes -> len)
        -> while {
            frozenRecursiveSemanticTypes[intrinsicSourceTextArraySearch!] => intrinsicSourceTextArrayCandidate
            intrinsicSourceTextArrayCandidate.kind == 3 and intrinsicSourceTextArrayCandidate.first == intrinsicSourceTextTypeId!
                -> if {
                    intrinsicSourceTextArraySearch! => intrinsicSourceTextArrayTypeId!
                }
            intrinsicSourceTextArraySearch! + 1 => intrinsicSourceTextArraySearch!
        }
    0 => intrinsicSourceTextIrIndex!
    intrinsicSourceTextIrIndex! < (nodes -> len)
        -> while {
            nodes[intrinsicSourceTextIrIndex!] => intrinsicSourceTextIr!
            intrinsicSourceTextIr!.typeId < 0
                and ((intrinsicSourceTextIr!.typeModule == intrinsicSourceTextModule!
                and intrinsicSourceTextIr!.typeSymbol == intrinsicSourceTextSymbol!)
                or (intrinsicSourceTextIr!.typeOrigin == 1
                and intrinsicSourceTextIr!.typeSymbol == 24))
                -> if {
                    intrinsicSourceTextIr!.typeOrigin == 0 or intrinsicSourceTextIr!.typeOrigin == 1 or intrinsicSourceTextIr!.typeOrigin == 2
                        -> if {
                            intrinsicSourceTextTypeId! => intrinsicSourceTextIr!.typeId
                            1 => intrinsicSourceTextIr!.typeOrigin
                            -1 => intrinsicSourceTextIr!.typeModule
                            24 => intrinsicSourceTextIr!.typeSymbol
                            1 => intrinsicSourceTextIr!.typeKind
                            intrinsicSourceTextTypeId! >= 0 -> if { recursiveTypeFlags[intrinsicSourceTextTypeId!] => intrinsicSourceTextIr!.typeFlags }
                        }
