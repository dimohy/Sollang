                            recoveredControlRange.astStart + recoveredControlAst.parent => recoveredFlowGlobalAst
                            recoveredControlByFlowAst![recoveredFlowGlobalAst] => recoveredNextControlByIr![recoveredControlIndex!]
                            recoveredControlIndex! => recoveredControlByFlowAst![recoveredFlowGlobalAst]
