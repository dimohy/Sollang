                        frozenRecursiveSemanticTypes -> typeIds.materializedReadTypeId(preBindingNumericRight.typeId) => preBindingNumericRightTypeId
                        preBindingNumericRightTypeId >= 0 and preBindingNumericRightTypeId < (frozenRecursiveSemanticTypes -> len)
                            -> if {
                                frozenRecursiveSemanticTypes[preBindingNumericRightTypeId] => rightType
                                rightType.kind == 1 and rightType.origin == 1
                                    and ((rightType.symbol >= 2 and rightType.symbol <= 14)
                                    or (rightType.symbol >= 19 and rightType.symbol <= 22))
                                    -> if { preBindingNumericRightTypeId => preBindingNumericTypeId! }
                            }
                    }
                    preBindingNumericTypeId! >= 0 -> if {
                        frozenRecursiveSemanticTypes[preBindingNumericTypeId!] => preBindingNumericType
                        preBindingNumericType.origin => preBindingNumericOperator!.typeOrigin
                        preBindingNumericType.module => preBindingNumericOperator!.typeModule
                        preBindingNumericType.symbol => preBindingNumericOperator!.typeSymbol
