normalizeResolvedControls nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, inferred: ref [expressionTypes.ExpressionType; ~], frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], frozenRecursiveTypeByAst: ref [Int; ~], recursiveReferences: ref [typeIds.TypeReference; ~], recursiveTypeFlags: ref [Int; ~] -> Unit {
    # Control conditions are first linked before the final binding/reference
    # canonicalization above. Re-run only unresolved controls now that mutable
    # Bool reads have their stable type, preserving the original AST-distance
    # and source-order selection rules.
    # Index unresolved controls by their exact flow AST. Each Bool candidate
