                        prepared.package.sources[call.targetModule] -> len => targetSourceLength
                        prepared.package.sources[call.targetModule]
                            -> slice(UIntSize(0), targetSourceLength) => targetSource
                        prepared.modules[call.targetModule] => targetIdentity
                        prepared.package.tokens[targetRange.tokenStart + targetSymbol.nameToken] => declaredName
                        targetSource -> sourceMatches(targetIdentity.pathStart, targetIdentity.pathLength, "std.async.diagnostics")
                            -> if {
                                targetSource -> sourceMatches(declaredName.span.start, declaredName.span.length, "startDiagnosticSession")
                                    -> if { -324 => opcode! }
                                targetSource -> sourceMatches(declaredName.span.start, declaredName.span.length, "track")
                                    -> if { -325 => opcode! }
                                targetSource -> sourceMatches(declaredName.span.start, declaredName.span.length, "snapshot")
                                    -> if { -326 => opcode! }
                                targetSource -> sourceMatches(declaredName.span.start, declaredName.span.length, "close")
                                    -> if { -327 => opcode! }
                            }
                        targetSource -> sourceMatches(targetIdentity.pathStart, targetIdentity.pathLength, "std.time")
                            -> if {
                                prepared.package.tokens[targetRange.tokenStart + targetSymbol.nameToken] => targetName
                                targetSource -> sourceMatches(targetName.span.start, targetName.span.length, "sleep")
                                    -> if { -113 => opcode! }
                            }
                        targetSource -> sourceMatches(targetIdentity.pathStart, targetIdentity.pathLength, "sys.runtime")
                            -> if {
                                targetSource -> sourceMatches(declaredName.span.start, declaredName.span.length, "limitParallelWorkers")
                                    -> if { -115 => opcode! }
                                targetSource -> sourceMatches(declaredName.span.start, declaredName.span.length, "parallelWorkers")
                                    -> if { -328 => opcode! }
                                targetSource -> sourceMatches(declaredName.span.start, declaredName.span.length, "parallelPeakWorkers")
                                    -> if { -329 => opcode! }
                            }
                    }
            }
        }
    opcode!
}

normalizeResolvedDeclaredRuntime nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot -> Unit {
    # The stdlib-aware resolver retains the exact declared intrinsic identity.
    # Recognize declared stdlib runtime operations, never user spelling.
    # Diagnostic calls remain synchronous; sleep alone creates a Task.
    0 => timeCallIndex!
    timeCallIndex! < (nodes -> len) -> while {
        nodes[timeCallIndex!] => timeCall!
        timeCall!.kind == 6 or timeCall!.kind == 9
            -> if {
                prepared.package -> calls.displayFunctionSymbol(prepared.modules, timeCall!.targetModule, timeCall!.symbol, prepared.standardLibrarySourceStart, prepared.standardLibrarySourceCount) => displaySymbol
                displaySymbol < -1 -> if {
                    # Declaration identity remains in the committed call table.
                    # This is the existing display ABI after canonical admission.
                    displaySymbol => timeCall!.symbol
                    timeCall! => nodes[timeCallIndex!]
                }
                timeCall! -> resolvedDeclaredRuntimeOpcode(prepared) => timeOpcode
                timeOpcode == -113 or timeOpcode == -115 or (timeOpcode <= -324 and timeOpcode >= -329)
                    -> if {
                        timeOpcode => timeCall!.opcode
                        timeOpcode == -113 and (timeCall!.flags / 8) % 2 == 0
                            -> if { timeCall!.flags + 8 => timeCall!.flags }
                        timeCall! => nodes[timeCallIndex!]
                    }
            }
        timeCallIndex! + 1 => timeCallIndex!
    }
}

# Generic closure and final nominal receiver sealing can resolve a method
# after initial lowering. Classify its declared intrinsic identity again;
# ordinary user methods keep their existing call plan and opcode.
public sealDeclaredRuntimeCalls nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot -> Unit {
    nodes -> normalizeResolvedDeclaredRuntime(prepared)
}

resolvedProcessRuntimeOpcode call: ref TypedIrNode, prepared: ref semanticContext.SemanticSnapshot -> Int {
    -1 => opcode!
    call.targetModule >= 0
        and call.targetModule < (prepared.modules -> len)
        and call.symbol >= 0
        -> if {
            prepared.package.ranges[call.targetModule] => targetRange
            call.symbol < targetRange.symbolCount -> if {
                prepared.package.symbols[targetRange.symbolStart + call.symbol] => targetSymbol
                (targetSymbol.kind == 7 or targetSymbol.kind == 31)
                    and targetSymbol.nameToken >= 0
                    and targetSymbol.nameToken < targetRange.tokenCount
                    -> if {
                        prepared.package.sources[call.targetModule] -> len => targetSourceLength
                        prepared.package.sources[call.targetModule]
                            -> slice(UIntSize(0), targetSourceLength) => targetSource
                        prepared.modules[call.targetModule] => targetIdentity
                        targetSource -> sourceMatches(targetIdentity.pathStart, targetIdentity.pathLength, "sys.process")
                            -> if {
                                prepared.package.tokens[targetRange.tokenStart + targetSymbol.nameToken] => targetName
                                targetSource -> sourceMatches(targetName.span.start, targetName.span.length, "run")
                                    -> if { -210 => opcode! }
                                targetSource -> sourceMatches(targetName.span.start, targetName.span.length, "runToFile")
                                    -> if { -211 => opcode! }
                                targetSource -> sourceMatches(targetName.span.start, targetName.span.length, "collect")
                                    -> if { -288 => opcode! }
                                targetSource -> sourceMatches(targetName.span.start, targetName.span.length, "spawn")
                                    -> if { -277 => opcode! }
                                targetSource -> sourceMatches(targetName.span.start, targetName.span.length, "wait")
                                    -> if { -278 => opcode! }
                                targetSource -> sourceMatches(targetName.span.start, targetName.span.length, "pollChild")
                                    -> if { -308 => opcode! }
                                targetSource -> sourceMatches(targetName.span.start, targetName.span.length, "killChild")
                                    -> if { -309 => opcode! }
                                targetSource -> sourceMatches(targetName.span.start, targetName.span.length, "id")
                                    -> if { -285 => opcode! }
                                targetSource -> sourceMatches(targetName.span.start, targetName.span.length, "asUInt64")
                                    -> if { -286 => opcode! }
                                targetSource -> sourceMatches(targetName.span.start, targetName.span.length, "exit")
                                    -> if { -222 => opcode! }
                                targetSource -> sourceMatches(targetName.span.start, targetName.span.length, "arguments")
                                    -> if { -212 => opcode! }
                                targetSource -> sourceMatches(targetName.span.start, targetName.span.length, "environment")
                                    -> if { -235 => opcode! }
                            }
                    }
            }
        }
    opcode!
}

normalizeResolvedProcessRuntime nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, inferred: ref [expressionTypes.ExpressionType; ~], frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], frozenRecursiveTypeByAst: ref [Int; ~], recursiveReferences: ref [typeIds.TypeReference; ~], recursiveTypeFlags: ref [Int; ~] -> Unit {
    # Resolve every process intrinsic from the exact physical target fragment.
    # A namespace can span several files, so one representative source cannot
    # authoritatively provide every declaration's source-local symbol.
    0 => processCallIndex!
    processCallIndex! < (nodes -> len) -> while {
        nodes[processCallIndex!] => processCall!
        processCall!.kind == 6 or processCall!.kind == 9
            -> if {
                processCall! -> resolvedProcessRuntimeOpcode(prepared) => processOpcode
                processOpcode != -1 -> if { processOpcode => processCall!.opcode }
                (processCall!.opcode -> isProcessExecutionOpcode) or (processCall!.opcode -> isProcessProjectionOpcode)
                    and processCall!.operand0 < 0
                    and processCall!.sourceModule >= 0
                    and processCall!.astNode >= 0 -> if {
                        prepared.package.ranges[processCall!.sourceModule] => processCallRange
                        prepared.package.nodes[processCallRange.astStart + processCall!.astNode] => processCallAst
                        -1 => processInputSymbol!
                        -1 => processInputToken!
                        0 => processInputAstSearch!
                        processInputAstSearch! < processCallRange.astCount
                            -> while {
                                prepared.package.nodes[processCallRange.astStart + processInputAstSearch!] => processInputAst
                                processInputAst.parent == processCall!.astNode
                                    and processInputAst.kind == 15
                                    and processInputAst.start == processCallAst.start
                                    -> if {
                                        processInputAst.payloadToken => processInputToken!
                                        0 => processInputNameSearch!
                                        processInputNameSearch! < processCallRange.nameCount
                                            -> while {
                                                prepared.package.names[processCallRange.nameStart + processInputNameSearch!] => processInputName
                                                processInputName.astNode == processInputAstSearch!
                                                    -> if {
                                                        processInputName.symbol => processInputSymbol!
                                                    }
                                                processInputNameSearch! + 1 => processInputNameSearch!
                                            }
                                    }
                                processInputAstSearch! + 1 => processInputAstSearch!
                            }
                        processCallIndex! => processInputBindingSearch!
                        processInputBindingSearch! > 0 and processCall!.operand0 < 0
                            -> while {
                                processInputBindingSearch! - 1 => processInputBindingSearch!
                                nodes[processInputBindingSearch!] => processInputBinding
                                false => processInputBindingMatches!
                                processInputBinding.kind == 17
                                    and processInputBinding.sourceModule == processCall!.sourceModule
                                    and processInputSymbol! >= 0
                                    and processInputBinding.symbol == processInputSymbol!
                                    -> if {
                                        true => processInputBindingMatches!
                                    }
                                processInputBinding.kind == 17
                                    and processInputBinding.sourceModule == processCall!.sourceModule
                                    and processInputToken! >= 0
                                    and processInputBinding.payloadToken >= 0 -> if {
                                        prepared.package.tokens[processCallRange.tokenStart + processInputToken!] => processInputReferenceName
                                        prepared.package.tokens[processCallRange.tokenStart + processInputBinding.payloadToken] => processInputBindingName
                                        processInputReferenceName.span.length == processInputBindingName.span.length => processInputNameEqual!
                                        UIntSize(0) => processInputNameByte!
                                        processInputNameEqual! and processInputNameByte! < processInputReferenceName.span.length
                                            -> while {
                                                (prepared.package.sources[processCall!.sourceModule] -> byte(processInputReferenceName.span.start + processInputNameByte!)) != (prepared.package.sources[processCall!.sourceModule] -> byte(processInputBindingName.span.start + processInputNameByte!))
                                                    -> if {
                                                        false => processInputNameEqual!
                                                    }
                                                processInputNameByte! + 1 => processInputNameByte!
                                            }
                                        processInputNameEqual! -> if { true => processInputBindingMatches! }
                                    }
                                processInputBindingMatches!
                                    and processInputBinding.astNode >= 0
                                    and prepared.package.nodes[processCallRange.astStart + processInputBinding.astNode].start <= processCallAst.start
                                    -> if {
                                        processInputBindingSearch! => processCall!.operand0
                                    }
                            }
                    }
                processCall! => nodes[processCallIndex!]
            }
        processCallIndex! + 1 => processCallIndex!
    }
}

normalizeResolvedDirectoryRuntime nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, inferred: ref [expressionTypes.ExpressionType; ~], frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], frozenRecursiveTypeByAst: ref [Int; ~], recursiveReferences: ref [typeIds.TypeReference; ~], recursiveTypeFlags: ref [Int; ~] -> DirectoryRuntimeSymbols {
    # Directory traversal is a target runtime intrinsic. Resolve it from the
    # canonical module and function symbol so unrelated functions named
    # `readRaw` keep ordinary call semantics.
    -1 => directoryModuleSource!
    0 => directoryModuleSearch!
    directoryModuleSearch! < (prepared.modules -> len)
        -> while {
            prepared.modules[directoryModuleSearch!] => directoryModuleIdentity
            directoryModuleIdentity.pathHash == 3466438528969553761
                -> if { directoryModuleIdentity.sourceIndex => directoryModuleSource! }
            directoryModuleSearch! + 1 => directoryModuleSearch!
        }
    -1 => directoryReadRawSymbol!
    -1 => directoryCreateSymbol!
    directoryModuleSource! >= 0 -> if {
        prepared.package.ranges[directoryModuleSource!] => directorySourceRange
        prepared.package.sources[directoryModuleSource!] -> len => directorySourceLength
        prepared.package.sources[directoryModuleSource!] -> slice(UIntSize(0), directorySourceLength) => directorySource
        0 => directorySymbolSearch!
        directorySymbolSearch! < directorySourceRange.symbolCount
            -> while {
                prepared.package.symbols[directorySourceRange.symbolStart + directorySymbolSearch!] => directorySymbol
                directorySymbol.kind == 7
                    and directorySymbol.parent < 0
                    and directorySymbol.flags / 128 % 2 == 1
                    -> if {
                        prepared.package.tokens[directorySourceRange.tokenStart + directorySymbol.nameToken] => directoryNameToken
                        directorySource -> sourceMatches(directoryNameToken.span.start, directoryNameToken.span.length, "readRaw")
                            -> if { directorySymbolSearch! => directoryReadRawSymbol! }
                        directorySource -> sourceMatches(directoryNameToken.span.start, directoryNameToken.span.length, "create")
                            -> if { directorySymbolSearch! => directoryCreateSymbol! }
                    }
                directorySymbolSearch! + 1 => directorySymbolSearch!
            }
        0 => directoryCallIndex!
        directoryCallIndex! < (nodes -> len) -> while {
            nodes[directoryCallIndex!] => directoryCall!
            directoryCall!.kind == 6 and directoryCall!.targetModule == directoryModuleSource! and directoryCall!.symbol == directoryReadRawSymbol!
                -> if {
                    -215 => directoryCall!.opcode
                    directoryCall! => nodes[directoryCallIndex!]
                }
            directoryCall!.kind == 6 and directoryCall!.targetModule == directoryModuleSource! and directoryCall!.symbol == directoryCreateSymbol!
                -> if {
                    -233 => directoryCall!.opcode
                    directoryCall! => nodes[directoryCallIndex!]
                }
            directoryCallIndex! + 1 => directoryCallIndex!
        }
    }
    DirectoryRuntimeSymbols { moduleSource: directoryModuleSource!, readRawSymbol: directoryReadRawSymbol!, createSymbol: directoryCreateSymbol! }
}

normalizeResolvedFileRuntime nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, inferred: ref [expressionTypes.ExpressionType; ~], frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], frozenRecursiveTypeByAst: ref [Int; ~], recursiveReferences: ref [typeIds.TypeReference; ~], recursiveTypeFlags: ref [Int; ~] -> Unit {
    # Canonical path metadata shares the target filesystem lowering opcode
    # with directory traversal; the LLVM emitter distinguishes the RawInfo
    # payload shape from directory Raw.
