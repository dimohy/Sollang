            and recoveredConditionCandidate.sourceModule < (prepared.package.ranges -> len)
            and recoveredConditionCandidate.astNode >= 0
            and ((recoveredConditionCandidate.typeOrigin == 1 and recoveredConditionCandidate.typeSymbol == 23)
            or (recoveredConditionCandidate.typeId >= 0
