                    canonicalPatternFallbackSearch! < canonicalReferenceIndex!
                        -> while {
                            nodes[canonicalPatternFallbackSearch!] => canonicalPatternCandidate
                            canonicalPatternCandidate.kind == 29
                                and canonicalPatternCandidate.sourceModule == canonicalReference!.sourceModule
                                and canonicalPatternCandidate.symbol == canonicalReference!.symbol
                                and canonicalPatternCandidate.astNode >= 0
                                and canonicalReference!.astNode >= 0
                                -> if {
                                    prepared.package.ranges[canonicalReference!.sourceModule] => canonicalPatternRange
                                    prepared.package.nodes[canonicalPatternRange.astStart + canonicalPatternCandidate.astNode].start => canonicalPatternCandidateStart
                                    canonicalPatternCandidateStart <= prepared.package.nodes[canonicalPatternRange.astStart + canonicalReference!.astNode].start
