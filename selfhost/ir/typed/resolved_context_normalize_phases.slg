                        and contextualEnumCollection.sourceModule < (prepared.package.ranges -> len)
                        -> if {
                            prepared.package.ranges[contextualEnumCollection.sourceModule] => contextualEnumRange
                            contextualEnumCollection.payloadToken >= 0
                                and contextualEnumCollection.payloadToken < contextualEnumRange.tokenCount
                                -> if {
                                    prepared.package.tokens[contextualEnumRange.tokenStart + contextualEnumCollection.payloadToken] => contextualEnumVariantToken
                                    contextualEnumCollection.sourceModule -> nominalVariantTagForType(contextualEnumType, contextualEnumVariantToken, prepared) => contextualEnumTag
                                    -1 => contextualEnumPayloadTypeId!
                                    contextualEnumType.symbol == 0 and contextualEnumTag == 1
                                        -> if {
                                            contextualEnumType.first => contextualEnumPayloadTypeId!
                                        }
                                    contextualEnumType.symbol == 1 -> if {
                                        contextualEnumTag == 0 -> if { contextualEnumType.first => contextualEnumPayloadTypeId! }
                                        contextualEnumTag == 1 -> if { contextualEnumType.second => contextualEnumPayloadTypeId! }
                                    }
                                    contextualEnumPayloadTypeId! >= 0
                                        and contextualEnumPayloadTypeId! < (frozenRecursiveSemanticTypes -> len)
                                        and contextualEnumPayloadTypeId! < (recursiveTypeFlags -> len)
                                        -> if {
                                            frozenRecursiveSemanticTypes[contextualEnumPayloadTypeId!] => contextualEnumPayloadType
                                            nodes[contextualEnumCollection.operand0] => contextualEnumPayload!
                                            contextualEnumPayload!.kind == 14
                                                and contextualEnumPayload!.operand0 < 0
                                                and (contextualEnumPayloadType.kind == 3
                                                or contextualEnumPayloadType.kind == 4
                                                or contextualEnumPayloadType.kind == 12)
                                                -> if {
                                                    contextualEnumPayloadTypeId! => contextualEnumPayload!.typeId
                                                    contextualEnumPayloadType.kind => contextualEnumPayload!.typeKind
                                                    contextualEnumPayloadType.origin => contextualEnumPayload!.typeOrigin
                                                    contextualEnumPayloadType.module => contextualEnumPayload!.typeModule
                                                    contextualEnumPayloadType.symbol => contextualEnumPayload!.typeSymbol
                                                    recursiveTypeFlags[contextualEnumPayloadTypeId!] => contextualEnumPayload!.typeFlags
                                                    contextualEnumPayload! => nodes[contextualEnumCollection.operand0]
                                                }
                                            nodes -> sealIntegerLiteralContext(contextualEnumCollection.operand0,
                                            contextualEnumPayloadTypeId!, contextualEnumPayloadType,
                                            recursiveTypeFlags[contextualEnumPayloadTypeId!])
                                        }
                                }
                        }
                }
            contextualEnumCollectionIndex! + 1 => contextualEnumCollectionIndex!
        }
    # A nominal expression may inherit a coordinate-equivalent duplicate type
    # produced by shallow expression inference. Struct literals must use the
    # unique nominal identity that owns the declaration field table; otherwise
    # field contextualization and inline ABI materialization have no contract.
    0 => canonicalStructOwnerIndex!
    canonicalStructOwnerIndex! < (nodes -> len)
        -> while {
            nodes[canonicalStructOwnerIndex!] => canonicalStructOwner!
            canonicalStructOwner!.kind == 12
                and canonicalStructOwner!.typeId >= 0
                and frozenRecursiveSemanticTypes[canonicalStructOwner!.typeId].kind == 1
                -> if {
                    false => canonicalStructOwnerHasFields!
                    0 => canonicalStructOwnerFieldSearch!
                    canonicalStructOwnerFieldSearch! < (recursiveTypes.fields -> len)
                        -> while {
                            recursiveTypes.fields[canonicalStructOwnerFieldSearch!].status == 0
                                and recursiveTypes.fields[canonicalStructOwnerFieldSearch!].ownerType == canonicalStructOwner!.typeId
                                -> if {
                                    true => canonicalStructOwnerHasFields!
                                }
                            canonicalStructOwnerFieldSearch! + 1 => canonicalStructOwnerFieldSearch!
                        }
                    not canonicalStructOwnerHasFields! -> if {
                        frozenRecursiveSemanticTypes[canonicalStructOwner!.typeId] => canonicalStructDuplicateType
                        -1 => canonicalStructFieldOwnerType!
                        0 => canonicalStructFieldOwnerMatches!
                        0 => canonicalStructTypeSearch!
                        canonicalStructTypeSearch! < (frozenRecursiveSemanticTypes -> len)
                            -> while {
                                frozenRecursiveSemanticTypes[canonicalStructTypeSearch!] => canonicalStructTypeCandidate
                                canonicalStructTypeCandidate.kind == 1
                                    and canonicalStructTypeCandidate.origin == canonicalStructDuplicateType.origin
                                    and canonicalStructTypeCandidate.module == canonicalStructDuplicateType.module
                                    and canonicalStructTypeCandidate.symbol == canonicalStructDuplicateType.symbol
                                    -> if {
                                        false => canonicalStructCandidateHasFields!
                                        0 => canonicalStructCandidateFieldSearch!
                                        canonicalStructCandidateFieldSearch! < (recursiveTypes.fields -> len)
                                            -> while {
                                                recursiveTypes.fields[canonicalStructCandidateFieldSearch!].status == 0
                                                    and recursiveTypes.fields[canonicalStructCandidateFieldSearch!].ownerType == canonicalStructTypeSearch!
                                                    -> if {
                                                        true => canonicalStructCandidateHasFields!
                                                    }
                                                canonicalStructCandidateFieldSearch! + 1 => canonicalStructCandidateFieldSearch!
                                            }
                                        canonicalStructCandidateHasFields! -> if {
                                            canonicalStructTypeSearch! => canonicalStructFieldOwnerType!
                                            canonicalStructFieldOwnerMatches! + 1 => canonicalStructFieldOwnerMatches!
                                        }
                                    }
                                canonicalStructTypeSearch! + 1 => canonicalStructTypeSearch!
                            }
                        canonicalStructFieldOwnerMatches! == 1 -> if {
                            frozenRecursiveSemanticTypes[canonicalStructFieldOwnerType!] => canonicalStructFieldOwner
                            canonicalStructFieldOwnerType! => canonicalStructOwner!.typeId
                            canonicalStructFieldOwner.kind => canonicalStructOwner!.typeKind
                            canonicalStructFieldOwner.origin => canonicalStructOwner!.typeOrigin
                            canonicalStructFieldOwner.module => canonicalStructOwner!.typeModule
                            canonicalStructFieldOwner.symbol => canonicalStructOwner!.typeSymbol
                            recursiveTypeFlags[canonicalStructFieldOwnerType!] => canonicalStructOwner!.typeFlags
                            canonicalStructOwner! => nodes[canonicalStructOwnerIndex!]
                        }
                    }
                }
            canonicalStructOwnerIndex! + 1 => canonicalStructOwnerIndex!
        }
    nodes -> normalizeNominalOperandOrder(prepared, recursiveTypes.fields, frozenRecursiveSemanticTypes -> len)
    # A collection literal used as a nominal struct field is contextually
    # typed by that field declaration. Element-only inference defaults numeric
    # literals to Int and would otherwise make `[UInt8; ~]` storage use i32
    # while later indexed reads correctly use i8. Preserve one canonical type
    # across construction, projection, and indexing.
    0 => contextualStructIndex!
    contextualStructIndex! < (nodes -> len) -> while {
        nodes[contextualStructIndex!] => contextualStruct
        contextualStruct.kind == 12 and contextualStruct.typeId >= 0
            -> if {
                contextualStruct.operand0 => contextualStructFieldValueIndex!
                0 => contextualStructFieldOrdinal!
                contextualStructFieldValueIndex! >= 0 -> while {
                    nodes[contextualStructFieldValueIndex!] => contextualStructFieldValue!
                    -1 => contextualStructFieldTypeId!
                    0 => contextualStructFieldSearch!
                    contextualStructFieldSearch! < (recursiveTypes.fields -> len) and contextualStructFieldTypeId! < 0
                        -> while {
                            recursiveTypes.fields[contextualStructFieldSearch!] => contextualStructField
                            contextualStructField.status == 0
                                and contextualStructField.ownerType == contextualStruct.typeId
                                and contextualStructField.ordinal == contextualStructFieldOrdinal!
                                -> if {
                                    contextualStructField.fieldType => contextualStructFieldTypeId!
                                }
                            contextualStructFieldSearch! + 1 => contextualStructFieldSearch!
                        }
                    contextualStructFieldTypeId! >= 0 -> if {
                        frozenRecursiveSemanticTypes[contextualStructFieldTypeId!] => contextualStructFieldType
                        nodes -> sealNumericLiteralContext(contextualStructFieldValueIndex!,
                        contextualStructFieldTypeId!, contextualStructFieldType,
                        recursiveTypeFlags[contextualStructFieldTypeId!])
                        (contextualStructFieldValue!.kind == 14 and (contextualStructFieldType.kind == 3 or contextualStructFieldType.kind == 4 or contextualStructFieldType.kind == 12))
                            or (contextualStructFieldValue!.kind == 16 and contextualStructFieldType.kind == 5)
                            -> if {
                                contextualStructFieldTypeId! => contextualStructFieldValue!.typeId
                                contextualStructFieldType.kind => contextualStructFieldValue!.typeKind
                                contextualStructFieldType.origin => contextualStructFieldValue!.typeOrigin
                                contextualStructFieldType.module => contextualStructFieldValue!.typeModule
                                contextualStructFieldType.symbol => contextualStructFieldValue!.typeSymbol
                                recursiveTypeFlags[contextualStructFieldTypeId!] => contextualStructFieldValue!.typeFlags
                                contextualStructFieldValue! => nodes[contextualStructFieldValueIndex!]
                            }
                        # Bidirectional field typing also crosses a plain name
                        # whose binding has an explicit matching collection
                        # declaration. Table insertion may change shallow
                        # inference order, but it must not change this declared
                        # identity. Retype the name, binding, and literal
                        # together so storage and every use keep one ABI.
                        contextualStructFieldValue!.kind == 5
                            and contextualStructFieldValue!.operand0 >= 0
                            and contextualStructFieldValue!.operand0 < (nodes -> len)
                            and (contextualStructFieldType.kind == 3
                            or contextualStructFieldType.kind == 4
                            or contextualStructFieldType.kind == 12)
                            -> if {
                                contextualStructFieldValue!.operand0 => contextualStructBindingIndex
                                nodes[contextualStructBindingIndex] => contextualStructBinding!
                                -1 => contextualStructBindingDeclaredTypeId!
                                contextualStructBinding!.kind == 17
                                    and contextualStructBinding!.sourceModule >= 0
                                    and contextualStructBinding!.sourceModule < (prepared.package.ranges -> len)
                                    and contextualStructBinding!.symbol >= 0
                                    -> if {
                                        prepared.package.ranges[contextualStructBinding!.sourceModule] => contextualStructBindingRange
                                        contextualStructBinding!.symbol < contextualStructBindingRange.symbolCount
                                            -> if {
                                                prepared.package.symbols[contextualStructBindingRange.symbolStart + contextualStructBinding!.symbol] => contextualStructBindingSymbol
                                                -1 => contextualStructBindingReferenceIndex!
                                                contextualStructBindingSymbol.typeNode >= 0 and contextualStructBindingSymbol.typeNode < contextualStructBindingRange.astCount
                                                    -> if { recursiveTypes.referenceIndexByTypeAst[contextualStructBindingRange.astStart + contextualStructBindingSymbol.typeNode] => contextualStructBindingReferenceIndex! }
                                                contextualStructBindingReferenceIndex! >= 0
                                                    and recursiveTypes.references[contextualStructBindingReferenceIndex!].status == 0
                                                    -> if {
                                                        recursiveTypes.references[contextualStructBindingReferenceIndex!].typeId => contextualStructBindingDeclaredTypeId!
                                                    }
                                            }
                                    }
                                contextualStructBindingDeclaredTypeId! == contextualStructFieldTypeId!
                                    and contextualStructBinding!.operand0 >= 0
                                    and contextualStructBinding!.operand0 < (nodes -> len)
                                    and nodes[contextualStructBinding!.operand0].kind == 14
                                    -> if {
                                        nodes[contextualStructBinding!.operand0] => contextualStructBindingInitializer!
                                        contextualStructFieldTypeId! => contextualStructFieldValue!.typeId
                                        contextualStructFieldType.kind => contextualStructFieldValue!.typeKind
                                        contextualStructFieldType.origin => contextualStructFieldValue!.typeOrigin
                                        contextualStructFieldType.module => contextualStructFieldValue!.typeModule
                                        contextualStructFieldType.symbol => contextualStructFieldValue!.typeSymbol
                                        recursiveTypeFlags[contextualStructFieldTypeId!] => contextualStructFieldValue!.typeFlags
                                        contextualStructFieldTypeId! => contextualStructBinding!.typeId
                                        contextualStructFieldType.kind => contextualStructBinding!.typeKind
                                        contextualStructFieldType.origin => contextualStructBinding!.typeOrigin
                                        contextualStructFieldType.module => contextualStructBinding!.typeModule
                                        contextualStructFieldType.symbol => contextualStructBinding!.typeSymbol
                                        recursiveTypeFlags[contextualStructFieldTypeId!] => contextualStructBinding!.typeFlags
                                        contextualStructFieldTypeId! => contextualStructBindingInitializer!.typeId
                                        contextualStructFieldType.kind => contextualStructBindingInitializer!.typeKind
                                        contextualStructFieldType.origin => contextualStructBindingInitializer!.typeOrigin
                                        contextualStructFieldType.module => contextualStructBindingInitializer!.typeModule
                                        contextualStructFieldType.symbol => contextualStructBindingInitializer!.typeSymbol
                                        recursiveTypeFlags[contextualStructFieldTypeId!] => contextualStructBindingInitializer!.typeFlags
                                        contextualStructFieldValue! => nodes[contextualStructFieldValueIndex!]
                                        contextualStructBinding! => nodes[contextualStructBindingIndex]
                                        contextualStructBindingInitializer! => nodes[contextualStructBinding!.operand0]
                                    }
                            }
                    }
                    contextualStructFieldValue!.nextOperand => contextualStructFieldValueIndex!
                    contextualStructFieldOrdinal! + 1 => contextualStructFieldOrdinal!
                }
            }
        contextualStructIndex! + 1 => contextualStructIndex!
    }
}

normalizeResolvedStructuralOperands nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, inferred: ref [expressionTypes.ExpressionType; ~], frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], frozenRecursiveTypeByAst: ref [Int; ~], recursiveReferences: ref [typeIds.TypeReference; ~], recursiveTypeFlags: ref [Int; ~] -> Unit {
    # Collection and negative integer literals returned directly are contextually
    # typed by that function's declared result. Perform this after source IR
    # merging, when the final function -> return -> literal edges are stable.
    0 => contextualCollectionFunctionIndex!
    contextualCollectionFunctionIndex! < (nodes -> len)
        -> while {
            nodes[contextualCollectionFunctionIndex!] => contextualCollectionFunction
            contextualCollectionFunction.kind == 0 and contextualCollectionFunction.typeId >= 0
                and contextualCollectionFunction.operand0 >= 0
                and contextualCollectionFunction.operand0 < (nodes -> len)
                -> if {
                    nodes[contextualCollectionFunction.operand0] => contextualCollectionReturn
                    contextualCollectionReturn.kind == 1 -> if {
                        contextualCollectionReturn.operand0 => contextualCollectionLiteralIndex
                        contextualCollectionLiteralIndex >= 0 and contextualCollectionLiteralIndex < (nodes -> len)
                            -> if {
                                nodes[contextualCollectionLiteralIndex] => contextualCollectionLiteral!
                                ((contextualCollectionFunction.typeKind == 2 or contextualCollectionFunction.typeKind == 3 or contextualCollectionFunction.typeKind == 4 or contextualCollectionFunction.typeKind == 12) and contextualCollectionLiteral!.kind == 14) or (contextualCollectionFunction.typeKind == 5 and contextualCollectionLiteral!.kind == 16)
                                    -> if {
                                        contextualCollectionFunction.typeId => contextualCollectionLiteral!.typeId
                                        contextualCollectionFunction.typeKind => contextualCollectionLiteral!.typeKind
                                        contextualCollectionFunction.typeOrigin => contextualCollectionLiteral!.typeOrigin
                                        contextualCollectionFunction.typeModule => contextualCollectionLiteral!.typeModule
                                        contextualCollectionFunction.typeSymbol => contextualCollectionLiteral!.typeSymbol
                                        contextualCollectionFunction.typeFlags => contextualCollectionLiteral!.typeFlags
                                        contextualCollectionLiteral! => nodes[contextualCollectionLiteralIndex]
                                    }
                                nodes -> sealIntegerLiteralPeerContext(contextualCollectionLiteralIndex, contextualCollectionFunction)
                            }
                    }
                }
            contextualCollectionFunctionIndex! + 1 => contextualCollectionFunctionIndex!
        }
    # Reconnect a binary operand that names a compile-time value generic to the
    # hidden parameter created for its owning function. The resolved-name table
    # proves the exact generic symbol; AST position restores left/right order.
    0 => valueGenericOperandRepairIndex!
    valueGenericOperandRepairIndex! < (nodes -> len)
        -> while {
            nodes[valueGenericOperandRepairIndex!] => valueGenericOperandRepair!
            valueGenericOperandRepair!.kind == 8
                and valueGenericOperandRepair!.operand0 >= 0
                and valueGenericOperandRepair!.operand1 < 0
                and valueGenericOperandRepair!.sourceModule >= 0
                -> if {
                    valueGenericOperandRepair!.parent => valueGenericOwnerFunction!
                    valueGenericOwnerFunction! >= 0 and nodes[valueGenericOwnerFunction!].kind != 0
                        -> while {
                            nodes[valueGenericOwnerFunction!].parent => valueGenericOwnerFunction!
                        }
                    valueGenericOwnerFunction! >= 0 -> if {
                        prepared.package.ranges[valueGenericOperandRepair!.sourceModule] => valueGenericOperandRange
                        0 => valueGenericParameterSearch!
                        valueGenericParameterSearch! < (nodes -> len) and valueGenericOperandRepair!.operand1 < 0
                            -> while {
                                nodes[valueGenericParameterSearch!] => valueGenericParameter
                                valueGenericParameter.kind == 10
                                    and valueGenericParameter.parent == valueGenericOwnerFunction!
                                    and valueGenericParameter.symbol >= 0
                                    and prepared.package.symbols[valueGenericOperandRange.symbolStart + valueGenericParameter.symbol].kind == 32
                                    -> if {
                                        -1 => valueGenericNameAst!
                                        0 => valueGenericNameSearch!
                                        valueGenericNameSearch! < valueGenericOperandRange.nameCount
                                            -> while {
                                                prepared.package.names[valueGenericOperandRange.nameStart + valueGenericNameSearch!] => valueGenericName
                                                valueGenericName.symbol == valueGenericParameter.symbol
                                                    and valueGenericName.astNode >= 0 -> if {
                                                        valueGenericName.astNode => valueGenericNameAncestor!
                                                        false => valueGenericNameBelongs!
                                                        valueGenericNameAncestor! >= 0 and not valueGenericNameBelongs!
                                                            -> while {
                                                                valueGenericNameAncestor! == valueGenericOperandRepair!.astNode
                                                                    -> if {
                                                                        true => valueGenericNameBelongs!
                                                                    } else {
                                                                        prepared.package.nodes[valueGenericOperandRange.astStart + valueGenericNameAncestor!].parent => valueGenericNameAncestor!
                                                                    }
                                                            }
                                                        valueGenericNameBelongs! -> if { valueGenericName.astNode => valueGenericNameAst! }
                                                    }
                                                valueGenericNameSearch! + 1 => valueGenericNameSearch!
                                            }
                                        valueGenericNameAst! >= 0 -> if {
                                            prepared.package.nodes[valueGenericOperandRange.astStart + valueGenericNameAst!] => valueGenericNameNode
                                            prepared.package.nodes[valueGenericOperandRange.astStart + nodes[valueGenericOperandRepair!.operand0].astNode] => existingBinaryOperandAst
                                            valueGenericNameNode.start < existingBinaryOperandAst.start
                                                -> if {
                                                    valueGenericOperandRepair!.operand0 => valueGenericOperandRepair!.operand1
                                                    valueGenericParameterSearch! => valueGenericOperandRepair!.operand0
                                                } else {
                                                    valueGenericParameterSearch! => valueGenericOperandRepair!.operand1
                                                }
                                            valueGenericOperandRepair! => nodes[valueGenericOperandRepairIndex!]
                                        }
                                    }
                                valueGenericParameterSearch! + 1 => valueGenericParameterSearch!
                            }
                    }
                }
            valueGenericOperandRepairIndex! + 1 => valueGenericOperandRepairIndex!
        }

    # Pattern identity must win before the broader continuation repair below.
    0 => whenBinaryRepairIndex!
    whenBinaryRepairIndex! < (nodes -> len) -> while {
        nodes[whenBinaryRepairIndex!] => whenBinaryRepair!
        whenBinaryRepair!.sourceModule >= 0 -> if {
            prepared.package.ranges[whenBinaryRepair!.sourceModule] => whenBinaryRepairRange
            prepared.package.nodes[whenBinaryRepairRange.astStart + whenBinaryRepair!.astNode] => whenBinaryRepairAst
            whenBinaryRepairAst.parent => whenBinaryRepairArmAst!
            whenBinaryRepairArmAst! >= 0
                and prepared.package.nodes[whenBinaryRepairRange.astStart + whenBinaryRepairArmAst!].kind != 58
                -> while {
                    prepared.package.nodes[whenBinaryRepairRange.astStart + whenBinaryRepairArmAst!].parent => whenBinaryRepairArmAst!
                }
            whenBinaryRepair!.kind == 8
                and whenBinaryRepair!.operand0 >= 0
                and whenBinaryRepair!.operand1 < 0
                and whenBinaryRepairArmAst! >= 0
                -> if {
                    -1 => whenBinaryRepairNameAst!
                    0 => whenBinaryRepairAstSearch!
                    whenBinaryRepairAstSearch! < whenBinaryRepairRange.astCount
                        -> while {
                            prepared.package.nodes[whenBinaryRepairRange.astStart + whenBinaryRepairAstSearch!].kind == 15 and prepared.package.nodes[whenBinaryRepairRange.astStart + whenBinaryRepairAstSearch!].parent == whenBinaryRepair!.astNode
                                -> if { whenBinaryRepairAstSearch! => whenBinaryRepairNameAst! }
                            whenBinaryRepairAstSearch! + 1 => whenBinaryRepairAstSearch!
                        }
                    whenBinaryRepairNameAst! >= 0 -> if {
                        -1 => whenBinaryRepairPatternSymbolIndex!
                        0 => whenBinaryRepairResolutionSearch!
                        whenBinaryRepairResolutionSearch! < whenBinaryRepairRange.nameCount
                            -> while {
                                prepared.package.names[whenBinaryRepairRange.nameStart + whenBinaryRepairResolutionSearch!] => whenBinaryRepairResolution
                                whenBinaryRepairResolution.astNode == whenBinaryRepairNameAst!
                                    and whenBinaryRepairResolution.symbol >= 0
                                    -> if {
                                        prepared.package.symbols[whenBinaryRepairRange.symbolStart + whenBinaryRepairResolution.symbol] => whenBinaryRepairPatternSymbol
                                        whenBinaryRepairPatternSymbol.kind == 35
                                            and whenBinaryRepairPatternSymbol.parent >= 0
                                            and prepared.package.symbols[whenBinaryRepairRange.symbolStart + whenBinaryRepairPatternSymbol.parent].kind == 58
                                            and prepared.package.symbols[whenBinaryRepairRange.symbolStart + whenBinaryRepairPatternSymbol.parent].astNode == whenBinaryRepairArmAst!
                                            and whenBinaryRepairPatternSymbol.astNode >= 0
                                            and prepared.package.nodes[whenBinaryRepairRange.astStart + whenBinaryRepairPatternSymbol.astNode].kind == 59
                                            -> if {
                                                whenBinaryRepairResolution.symbol => whenBinaryRepairPatternSymbolIndex!
                                            }
                                    }
                                whenBinaryRepairResolutionSearch! + 1 => whenBinaryRepairResolutionSearch!
                            }
                        whenBinaryRepairPatternSymbolIndex! >= 0 -> if {
                            -1 => whenBinaryRepairRoot!
                            whenBinaryRepairIndex! => whenBinaryRepairRootSearch!
                            whenBinaryRepairRootSearch! >= 0 -> while {
                                whenBinaryRepairRootSearch! => whenBinaryRepairRoot!
                                nodes[whenBinaryRepairRootSearch!].parent => whenBinaryRepairRootSearch!
                            }
                            -1 => whenBinaryRepairPatternIr!
                            0 => whenBinaryRepairCandidateIndex!
                            whenBinaryRepairCandidateIndex! < whenBinaryRepairIndex! and whenBinaryRepairPatternIr! < 0
                                -> while {
                                    nodes[whenBinaryRepairCandidateIndex!] => whenBinaryRepairCandidate
                                    whenBinaryRepairCandidate.sourceModule == whenBinaryRepair!.sourceModule
                                        and whenBinaryRepairCandidate.kind == 29 and whenBinaryRepairCandidate.symbol == whenBinaryRepairPatternSymbolIndex!
                                        and whenBinaryRepairCandidate.astNode == prepared.package.symbols[whenBinaryRepairRange.symbolStart + whenBinaryRepairPatternSymbolIndex!].astNode
                                        -> if {
                                            -1 => whenBinaryRepairCandidateRoot!
                                            whenBinaryRepairCandidateIndex! => whenBinaryRepairCandidateRootSearch!
                                            whenBinaryRepairCandidateRootSearch! >= 0 -> while {
                                                whenBinaryRepairCandidateRootSearch! => whenBinaryRepairCandidateRoot!
                                                nodes[whenBinaryRepairCandidateRootSearch!].parent => whenBinaryRepairCandidateRootSearch!
                                            }
                                            whenBinaryRepairCandidateRoot! == whenBinaryRepairRoot!
                                                -> if { whenBinaryRepairCandidateIndex! => whenBinaryRepairPatternIr! }
                                        }
                                    whenBinaryRepairCandidateIndex! + 1 => whenBinaryRepairCandidateIndex!
                                }
                            whenBinaryRepairPatternIr! >= 0 -> if {
                                nodes[whenBinaryRepairIndex!].operand0 => whenBinaryRepair!.operand1
                                whenBinaryRepairPatternIr! => whenBinaryRepair!.operand0
                                whenBinaryRepair! => nodes[whenBinaryRepairIndex!]
                            }
                        }
                    }
                }
        }
        whenBinaryRepairIndex! + 1 => whenBinaryRepairIndex!
    }

    # Nested two-argument calls can leave their first argument in the sibling
    # continuation chain while the lowered binary node retains only the second
    # argument. Reconnect that exact structural predecessor; if the right value
    # is instead the binary's direct continuation, use that. Subject-pattern
    # wrappers remain owned by the dedicated enum/subject normalization above.
    # Both repairs read the last same-parent continuation predecessor.
    # Parent and nextOperand stay fixed while these passes update operands.
    [Int; ~] => continuationPredecessorByNode!
    0 => continuationPredecessorSeed!
    continuationPredecessorSeed! < (nodes -> len)
        -> while {
            continuationPredecessorByNode! -> push(-1)
            continuationPredecessorSeed! + 1 => continuationPredecessorSeed!
        }
    0 => continuationPredecessorIndex!
    continuationPredecessorIndex! < (nodes -> len)
        -> while {
            nodes[continuationPredecessorIndex!] => continuationPredecessorCandidate
            continuationPredecessorCandidate.nextOperand >= 0
                and continuationPredecessorCandidate.nextOperand < (nodes -> len)
                -> if {
                    nodes[continuationPredecessorCandidate.nextOperand] => continuationPredecessorTarget
                    continuationPredecessorCandidate.parent == continuationPredecessorTarget.parent
                        -> if {
                            continuationPredecessorIndex! => continuationPredecessorByNode![continuationPredecessorCandidate.nextOperand]
                        }
                }
            continuationPredecessorIndex! + 1 => continuationPredecessorIndex!
        }
    0 => binarySiblingRepairIndex!
    binarySiblingRepairIndex! < (nodes -> len)
        -> while {
            nodes[binarySiblingRepairIndex!] => binarySiblingRepair!
            binarySiblingRepair!.kind == 8
                and binarySiblingRepair!.operand0 >= 0
                and binarySiblingRepair!.operand1 < 0
                and binarySiblingRepair!.sourceModule >= 0 -> if {
                    prepared.package.ranges[binarySiblingRepair!.sourceModule] => binarySiblingRange
                    prepared.package.nodes[binarySiblingRange.astStart + binarySiblingRepair!.astNode] => binarySiblingAst
                    binarySiblingAst.kind != 70 -> if {
                        continuationPredecessorByNode![binarySiblingRepairIndex!] => binarySiblingPredecessor
                        binarySiblingPredecessor >= 0 -> if {
                            binarySiblingRepair!.operand0 => binarySiblingRepair!.operand1
                            binarySiblingPredecessor => binarySiblingRepair!.operand0
                            binarySiblingRepair! => nodes[binarySiblingRepairIndex!]
                        } else {
                            binarySiblingRepair!.nextOperand >= 0
                                and binarySiblingRepair!.nextOperand < (nodes -> len)
                                and nodes[binarySiblingRepair!.nextOperand].parent == binarySiblingRepair!.parent
                                -> if {
                                    binarySiblingRepair!.nextOperand => binarySiblingRepair!.operand1
                                    binarySiblingRepair! => nodes[binarySiblingRepairIndex!]
                                }
                        }
                    }
                }
            binarySiblingRepairIndex! + 1 => binarySiblingRepairIndex!
        }

    # Pipeline conditionals may retain the Boolean source as the exact
    # same-parent continuation predecessor even when recursive projection
    # omitted operand0 on the conditional itself. Preserve that identity;
    # no neighboring or type-compatible value is accepted as a substitute.
    0 => conditionalPredecessorRepairIndex!
    conditionalPredecessorRepairIndex! < (nodes -> len)
        -> while {
            nodes[conditionalPredecessorRepairIndex!] => conditionalPredecessorRepair!
            conditionalPredecessorRepair!.kind == 18 and conditionalPredecessorRepair!.operand0 < 0
                -> if {
                    continuationPredecessorByNode![conditionalPredecessorRepairIndex!] => conditionalPredecessor
                    conditionalPredecessor >= 0 -> if {
                        conditionalPredecessor => conditionalPredecessorRepair!.operand0
                        conditionalPredecessorRepair! => nodes[conditionalPredecessorRepairIndex!]
                    }
                }
            conditionalPredecessorRepairIndex! + 1 => conditionalPredecessorRepairIndex!
        }

    # A member rooted in an enum payload may be lowered after the payload name
    # expression has left the recursive slice. The enclosing enum arm still
    # owns a canonical pattern-binding value, but nested roles own other names.
    # Reconnect only when the resolved root symbol identifies that payload.
    0 => patternMemberRepairIndex!
    patternMemberRepairIndex! < (nodes -> len)
        -> while {
            nodes[patternMemberRepairIndex!] => patternMemberRepair!
            patternMemberRepair!.kind == 13 and patternMemberRepair!.operand0 < 0
                -> if {
                    prepared.package.ranges[patternMemberRepair!.sourceModule] => patternMemberRange
                    prepared.package.nodes[patternMemberRange.astStart + patternMemberRepair!.astNode] => patternMemberAst
                    -1 => patternMemberRootSymbol!
                    0 => patternMemberNameIndex!
                    patternMemberNameIndex! < patternMemberRange.nameCount
                        -> while {
                            prepared.package.names[patternMemberRange.nameStart + patternMemberNameIndex!] => rootName
                            rootName.astNode >= 0 -> if {
                                prepared.package.nodes[patternMemberRange.astStart + rootName.astNode] => rootAst
                                rootAst.kind == 15 and rootAst.start == patternMemberAst.start
                                    -> if { rootName.symbol => patternMemberRootSymbol! }
                            }
                            patternMemberNameIndex! + 1 => patternMemberNameIndex!
                        }
                    patternMemberRepair!.parent => patternMemberAncestor!
                    -1 => patternMemberArm!
                    patternMemberAncestor! >= 0 and patternMemberArm! < 0
                        -> while {
                            nodes[patternMemberAncestor!] => patternMemberAncestorNode
                            patternMemberAncestorNode.kind == 19
                                and patternMemberAncestorNode.parent >= 0
                                and nodes[patternMemberAncestorNode.parent].kind == 27
                                -> if {
                                    patternMemberAncestor! => patternMemberArm!
                                } else {
                                    patternMemberAncestorNode.parent => patternMemberAncestor!
                                }
                        }
                    patternMemberArm! >= 0 -> if {
                        0 => patternMemberBindingSearch!
                        patternMemberBindingSearch! < (nodes -> len) and patternMemberRepair!.operand0 < 0
                            -> while {
                                nodes[patternMemberBindingSearch!].kind == 29
                                    and nodes[patternMemberBindingSearch!].parent == patternMemberArm!
                                    and patternMemberRootSymbol! >= 0
                                    and nodes[patternMemberBindingSearch!].symbol == patternMemberRootSymbol!
                                    -> if {
                                        patternMemberBindingSearch! => patternMemberRepair!.operand0
                                        patternMemberRepair! => nodes[patternMemberRepairIndex!]
                                    }
                                patternMemberBindingSearch! + 1 => patternMemberBindingSearch!
                            }
                    }
                }
            patternMemberRepairIndex! + 1 => patternMemberRepairIndex!
        }

    # Subject-style `when` comparison nodes initially contain only their right
    # operand. Once every source has been lowered and sibling links are stable,
    # attach the shared integer subject as the left operand.
    0 => subjectWhenRepairIndex!
    subjectWhenRepairIndex! < (nodes -> len) -> while {
        nodes[subjectWhenRepairIndex!] => subjectWhenRepair!
        # A subject `when` may be lowered after its value has left the
        # control's recursive expression slice. Recover only the nearest
        # preceding sibling in the same block whose canonical type is an
        # integer; never search another region or match source spelling.
        subjectWhenRepair!.kind == 34
            and (subjectWhenRepair!.operand0 < 0 or subjectWhenRepair!.operand0 == subjectWhenRepairIndex!)
            -> if {
                subjectWhenRepairIndex! - 1 => subjectWhenSiblingIndex!
                false => subjectWhenSiblingFound!
                subjectWhenSiblingIndex! >= 0 and not subjectWhenSiblingFound!
                    -> while {
                        nodes[subjectWhenSiblingIndex!] => subjectWhenSibling
                        false => subjectWhenSiblingInteger!
                        subjectWhenSibling.typeOrigin == 1
                            and ((subjectWhenSibling.typeSymbol >= 2 and subjectWhenSibling.typeSymbol <= 14)
                            or (subjectWhenSibling.typeSymbol >= 19 and subjectWhenSibling.typeSymbol <= 23))
                            -> if {
                                true => subjectWhenSiblingInteger!
                            }
                        frozenRecursiveSemanticTypes -> typeIds.materializedReadTypeId(subjectWhenSibling.typeId) => subjectWhenSiblingReadTypeId
                        subjectWhenSiblingReadTypeId >= 0 -> if {
                            frozenRecursiveSemanticTypes[subjectWhenSiblingReadTypeId] => subjectWhenSiblingType
                            subjectWhenSiblingType.kind == 1
                                and subjectWhenSiblingType.origin == 1
                                and ((subjectWhenSiblingType.symbol >= 2 and subjectWhenSiblingType.symbol <= 14)
                                or (subjectWhenSiblingType.symbol >= 19 and subjectWhenSiblingType.symbol <= 23))
                                => subjectWhenSiblingInteger!
                        }
                        subjectWhenSibling.parent == subjectWhenRepair!.parent and subjectWhenSiblingInteger!
                            -> if {
                                subjectWhenSiblingIndex! => subjectWhenRepair!.operand0
                                subjectWhenRepair! => nodes[subjectWhenRepairIndex!]
                                true => subjectWhenSiblingFound!
                            }
                        subjectWhenSiblingIndex! - 1 => subjectWhenSiblingIndex!
                    }
            }
        subjectWhenRepair!.kind == 34 and subjectWhenRepair!.operand0 >= 0 and subjectWhenRepair!.operand1 >= 0
            -> if {
                subjectWhenRepair!.operand1 => subjectWhenRepairArmIndex!
                subjectWhenRepairArmIndex! >= 0 and subjectWhenRepairArmIndex! < (nodes -> len) and nodes[subjectWhenRepairArmIndex!].kind == 19 and nodes[subjectWhenRepairArmIndex!].parent == subjectWhenRepairIndex!
                    -> while {
                        nodes[subjectWhenRepairArmIndex!] => subjectWhenRepairArm
                        subjectWhenRepairArm.operand0 >= 0
                            and subjectWhenRepairArm.operand0 < (nodes -> len)
                            and nodes[subjectWhenRepairArm.operand0].kind == 8
                            -> if {
                                nodes[subjectWhenRepairArm.operand0] => subjectWhenRepairCondition!
                                subjectWhenRepairCondition!.operand1 < 0 -> if {
                                    subjectWhenRepairCondition!.operand0 => subjectWhenRepairCondition!.operand1
                                }
                                subjectWhenRepair!.operand0 => subjectWhenRepairCondition!.operand0
                                subjectWhenRepairCondition! => nodes[subjectWhenRepairArm.operand0]
                            }
                        subjectWhenRepairArm.nextOperand => subjectWhenRepairArmIndex!
                    }
            }
        subjectWhenRepairIndex! + 1 => subjectWhenRepairIndex!
    }

    # Canonicalize every relational subject arm independently of its sibling
    # link. Nested region planning can make an otherwise valid arm unreachable
    # from the control's first-arm chain, but its AST and IR parentage still
    # identify the exact subject control without a name or type heuristic.
    0 => subjectConditionRepairIndex!
    subjectConditionRepairIndex! < (nodes -> len)
        -> while {
            nodes[subjectConditionRepairIndex!] => subjectConditionRepair!
            subjectConditionRepair!.kind == 8
                and subjectConditionRepair!.operand0 >= 0
                and subjectConditionRepair!.sourceModule >= 0
                -> if {
                    prepared.package.ranges[subjectConditionRepair!.sourceModule] => subjectConditionRepairRange
                    subjectConditionRepair!.astNode >= 0 and subjectConditionRepair!.astNode < subjectConditionRepairRange.astCount
                        -> if {
                            prepared.package.nodes[subjectConditionRepairRange.astStart + subjectConditionRepair!.astNode] => subjectConditionRepairAst
                            false => subjectConditionEnumPattern!
                            0 => subjectConditionChildSearch!
                            subjectConditionChildSearch! < subjectConditionRepairRange.astCount
                                -> while {
                                    prepared.package.nodes[subjectConditionRepairRange.astStart + subjectConditionChildSearch!] => subjectConditionChild
                                    subjectConditionChild.kind == 59 and subjectConditionChild.parent == subjectConditionRepair!.astNode
                                        -> if {
                                            true => subjectConditionEnumPattern!
                                        }
                                    subjectConditionChildSearch! + 1 => subjectConditionChildSearch!
                                }
                            subjectConditionRepairAst.kind == 70
                                and not subjectConditionEnumPattern!
                                and subjectConditionRepair!.parent >= 0
                                and nodes[subjectConditionRepair!.parent].kind == 19
                                -> if {
                                    nodes[subjectConditionRepair!.parent].parent => subjectConditionControlIndex
                                    subjectConditionControlIndex >= 0
                                        and nodes[subjectConditionControlIndex].kind == 34
                                        and nodes[subjectConditionControlIndex].operand0 >= 0
                                        -> if {
                                            subjectConditionRepair!.operand1 < 0 -> if {
                                                subjectConditionRepair!.operand0 => subjectConditionRepair!.operand1
                                            }
                                            nodes[subjectConditionControlIndex].operand0 => subjectConditionRepair!.operand0
                                            subjectConditionRepair! => nodes[subjectConditionRepairIndex!]
                                        }
                                }
                        }
                }
            subjectConditionRepairIndex! + 1 => subjectConditionRepairIndex!
        }

}

# Field and `?` receiver types can become canonical only after structural
# normalization. Seal container `len` as Int at that boundary; the earlier
# conservative UIntSize is valid only for byte-addressed/runtime receivers.
normalizeResolvedLengthResults nodes: mut [TypedIrNode; ~], frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~] -> Unit {
    0 => lengthResultIndex!
    lengthResultIndex! < (nodes -> len) -> while {
        nodes[lengthResultIndex!] => lengthResult!
        lengthResult!.opcode == -201
            and lengthResult!.operand0 >= 0
            and lengthResult!.operand0 < (nodes -> len)
            -> if {
                nodes[lengthResult!.operand0] => lengthReceiver
                lengthReceiver.typeKind => lengthReceiverKind!
                lengthReceiver.typeOrigin => lengthReceiverOrigin!
                lengthReceiver.typeSymbol => lengthReceiverSymbol!
                lengthReceiver.typeId => lengthReceiverTypeId!
                lengthReceiverTypeId! >= 0 and lengthReceiverTypeId! < (frozenRecursiveSemanticTypes -> len)
                    -> if {
                        frozenRecursiveSemanticTypes[lengthReceiverTypeId!] => lengthReceiverReferenceType
                        lengthReceiverReferenceType.kind == 8 and lengthReceiverReferenceType.first >= 0
                            -> if { lengthReceiverReferenceType.first => lengthReceiverTypeId! }
                        frozenRecursiveSemanticTypes[lengthReceiverTypeId!] => lengthReceiverType
                        lengthReceiverType.kind => lengthReceiverKind!
                        lengthReceiverType.origin => lengthReceiverOrigin!
                        lengthReceiverType.symbol => lengthReceiverSymbol!
                    }
                (lengthReceiverKind! >= 2 and lengthReceiverKind! <= 5)
                    or lengthReceiverKind! == 14
                    or (lengthReceiverKind! == 7 and lengthReceiverOrigin! == 4
                    and lengthReceiverSymbol! >= 5 and lengthReceiverSymbol! <= 7)
                    -> if {
                        2 => lengthResult!.typeId
                        1 => lengthResult!.typeKind
                        1 => lengthResult!.typeOrigin
                        -1 => lengthResult!.typeModule
                        2 => lengthResult!.typeSymbol
                        0 => lengthResult!.typeFlags
                        lengthResult! => nodes[lengthResultIndex!]
                    }
            }
        lengthResultIndex! + 1 => lengthResultIndex!
    }
}

# Console consumes the result of its actual producer. An ordinary callee may
# have an intrinsic-like name; the Console envelope does not own that hint.
normalizeResolvedConsoleProducerResults nodes: mut [TypedIrNode; ~] -> Unit {
    0 => index!
    index! < (nodes -> len) -> while {
        nodes[index!] => consumer!
        (consumer!.kind == 6 or consumer!.kind == 9)
            and consumer!.opcode <= -201
            and (consumer!.symbol == -101 or consumer!.symbol == -102
            or consumer!.symbol == -116 or consumer!.symbol == -117)
            and consumer!.operand0 >= 0 and consumer!.operand0 < (nodes -> len)
            -> if {
                nodes[consumer!.operand0] => producer
                (producer.kind == 6 or producer.kind == 9)
                    and producer.symbol >= 0 and producer.targetModule >= 0
                    and producer.opcode == -1 and producer.typeId >= 0
                    -> if {
                        -1 => consumer!.opcode
                        producer.typeId => consumer!.typeId
                        producer.typeKind => consumer!.typeKind
                        producer.typeOrigin => consumer!.typeOrigin
                        producer.typeModule => consumer!.typeModule
                        producer.typeSymbol => consumer!.typeSymbol
                        producer.typeFlags => consumer!.typeFlags
                        consumer! => nodes[index!]
                    }
            }
        index! + 1 => index!
    }
}

# The sealed materialize intrinsic creates Text in the supplied Arena. Its
# result is independent of nested slice/len argument types. Normalize before
# binding propagation without changing operands or ownership diagnostics.
# A distinct materialize producer or resolved ordinary producer overrides
# a Console envelope spelling hint; the Console effect keeps its own opcode.
# user functions named materialize keep their declared scalar/text result.
normalizeResolvedMaterializeResults nodes: mut [TypedIrNode; ~], frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~] -> Unit {
    frozenRecursiveSemanticTypes -> typeIds.builtinTypeId(1) => materializeTextTypeId
    0 => materializeResultIndex!
    materializeResultIndex! < (nodes -> len) -> while {
        nodes[materializeResultIndex!] => materializeResult!
        (materializeResult!.kind == 6 or materializeResult!.kind == 9)
            and materializeResult!.opcode == -229 -> if {
                false => materializeOrdinaryProducer!
                (materializeResult!.symbol == -101 or materializeResult!.symbol == -102
                    or materializeResult!.symbol == -116 or materializeResult!.symbol == -117)
                    and materializeResult!.operand0 >= 0
                    and materializeResult!.operand0 < (nodes -> len)
                    -> if {
                        nodes[materializeResult!.operand0] => materializeProducer
                        (materializeProducer.kind == 6 or materializeProducer.kind == 9)
                            and ((materializeProducer.symbol >= 0
                            and materializeProducer.targetModule >= 0
                            and materializeProducer.opcode == -1)
                            or (materializeResult!.kind == 6
                            and materializeProducer.parent == materializeResultIndex!
                            and materializeProducer.opcode == -229
                            and materializeProducer.operand0 >= 0
                            and materializeProducer.operand1 >= 0)) -> if {
                                true => materializeOrdinaryProducer!
                                -1 => materializeResult!.opcode
                                materializeProducer.typeId => materializeResult!.typeId
                                materializeProducer.typeKind => materializeResult!.typeKind
                                materializeProducer.typeOrigin => materializeResult!.typeOrigin
                                materializeProducer.typeModule => materializeResult!.typeModule
                                materializeProducer.typeSymbol => materializeResult!.typeSymbol
                                materializeProducer.typeFlags => materializeResult!.typeFlags
                            }
                    }
                not materializeOrdinaryProducer! -> if {
                    materializeTextTypeId => materializeResult!.typeId
                    1 => materializeResult!.typeKind
                    1 => materializeResult!.typeOrigin
                    -1 => materializeResult!.typeModule
                    1 => materializeResult!.typeSymbol
                    0 => materializeResult!.typeFlags
                }
                materializeResult! => nodes[materializeResultIndex!]
            }
        materializeResultIndex! + 1 => materializeResultIndex!
    }
}

normalizeResolvedLateBindings nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, inferred: ref [expressionTypes.ExpressionType; ~], frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], frozenRecursiveTypeByAst: ref [Int; ~], recursiveReferences: ref [typeIds.TypeReference; ~], recursiveTypeFlags: ref [Int; ~] -> Unit {
    # Some mutable binding types are repaired after the earlier reference
    # refresh (for example a cursor initialized through a platform-width
    # conversion). Refresh every direct binding read once more at the final IR
    # boundary so arithmetic observes the binding's authoritative identity.
    0 => lateBindingTypeIndex!
    lateBindingTypeIndex! < (nodes -> len) -> while {
        nodes[lateBindingTypeIndex!] => lateBindingType!
        lateBindingType!.kind == 17
            and lateBindingType!.operand0 >= 0
            and nodes[lateBindingType!.operand0].typeId >= 0
            -> if {
                nodes[lateBindingType!.operand0] => lateBindingInitializer
                lateBindingInitializer.typeId => lateBindingCanonicalTypeId!
                frozenRecursiveSemanticTypes[lateBindingInitializer.typeId] => lateBindingInitializerType
                false => lateBindingUsesTry!
                lateBindingInitializerType.kind == 7
                    and lateBindingInitializerType.origin == 4
                    and lateBindingInitializerType.symbol == 1
                    and lateBindingInitializerType.first >= 0 -> if {
                        lateBindingType!.typeId == lateBindingInitializerType.first
                            -> if {
                                true => lateBindingUsesTry!
                            }
                    }
                lateBindingInitializerType.kind == 7
                    and lateBindingInitializerType.origin == 4
                    and lateBindingInitializerType.symbol == 1
                    and lateBindingInitializerType.first >= 0
                    and lateBindingType!.sourceModule >= 0
                    and not lateBindingUsesTry! -> if {
                        prepared.package.ranges[lateBindingType!.sourceModule] => lateBindingTryRange
                        0 => lateBindingTryAstSearch!
                        lateBindingTryAstSearch! < lateBindingTryRange.astCount and not lateBindingUsesTry!
                            -> while {
                                prepared.package.nodes[lateBindingTryRange.astStart + lateBindingTryAstSearch!] => lateBindingTryCandidate
                                lateBindingTryCandidate.kind == 82 -> if {
                                    prepared.package.nodes[lateBindingTryRange.astStart + lateBindingInitializer.astNode] => lateBindingInitializerAst
                                    prepared.package.nodes[lateBindingTryRange.astStart + lateBindingType!.astNode] => lateBindingAst
                                    lateBindingTryCandidate.start + lateBindingTryCandidate.length => lateBindingTryEnd
                                    lateBindingInitializerAst.start + lateBindingInitializerAst.length => lateBindingInitializerEnd
                                    lateBindingAst.start + lateBindingAst.length => lateBindingEnd
                                    (lateBindingTryCandidate.start <= lateBindingInitializerAst.start and lateBindingTryEnd >= lateBindingInitializerEnd)
                                        or (lateBindingInitializerAst.start <= lateBindingTryCandidate.start and lateBindingInitializerEnd >= lateBindingTryEnd)
                                        or (lateBindingAst.start <= lateBindingTryCandidate.start and lateBindingEnd >= lateBindingTryEnd)
                                        -> if {
                                            true => lateBindingUsesTry!
                                        }
                                    lateBindingTryCandidate.parent => lateBindingTryAncestor!
                                    lateBindingTryAncestor! >= 0 and lateBindingTryAncestor! != lateBindingType!.astNode
                                        -> while {
                                            prepared.package.nodes[lateBindingTryRange.astStart + lateBindingTryAncestor!].parent => lateBindingTryAncestor!
                                        }
                                    lateBindingTryAncestor! == lateBindingType!.astNode
                                        -> if { true => lateBindingUsesTry! }
                                }
                                lateBindingTryAstSearch! + 1 => lateBindingTryAstSearch!
                            }
                        lateBindingUsesTry! -> if { lateBindingInitializerType.first => lateBindingCanonicalTypeId! }
                    }
                frozenRecursiveSemanticTypes[lateBindingCanonicalTypeId!] => lateBindingCanonicalType
                lateBindingCanonicalTypeId! => lateBindingType!.typeId
                lateBindingCanonicalType.kind => lateBindingType!.typeKind
                lateBindingCanonicalType.origin => lateBindingType!.typeOrigin
                lateBindingCanonicalType.module => lateBindingType!.typeModule
                lateBindingCanonicalType.symbol => lateBindingType!.typeSymbol
                recursiveTypeFlags[lateBindingCanonicalTypeId!] => lateBindingType!.typeFlags
                lateBindingType! => nodes[lateBindingTypeIndex!]
            }
        lateBindingTypeIndex! + 1 => lateBindingTypeIndex!
    }
    # Rebinding nodes for one mutable slot share the declaration symbol and
    # lexical parent. Their type is invariant even when a later initializer was
    # temporarily inferred as Int. Restore every later version from the first
    # canonical slot declaration before refreshing reads.
    [Int; ~] => lateMutableRootBySymbol!
    0 => lateMutableSymbolSeed!
    lateMutableSymbolSeed! < (prepared.package.symbols -> len)
        -> while {
            lateMutableRootBySymbol! -> push(-1)
            lateMutableSymbolSeed! + 1 => lateMutableSymbolSeed!
        }
    0 => lateMutableBindingIndex!
    lateMutableBindingIndex! < (nodes -> len)
        -> while {
            nodes[lateMutableBindingIndex!] => lateMutableBinding!
            lateMutableBinding!.kind == 17
                and lateMutableBinding!.sourceModule >= 0
                and lateMutableBinding!.sourceModule < (prepared.package.ranges -> len)
                and lateMutableBinding!.symbol >= 0
                -> if {
                    prepared.package.ranges[lateMutableBinding!.sourceModule] => lateMutableBindingRange
                    lateMutableBinding!.symbol < lateMutableBindingRange.symbolCount
                        -> if {
                            lateMutableBindingRange.symbolStart + lateMutableBinding!.symbol => lateMutableGlobalSymbol
                            lateMutableRootBySymbol![lateMutableGlobalSymbol] => lateMutableRootIndex
                            lateMutableRootIndex >= 0 -> if {
                                nodes[lateMutableRootIndex] => lateMutableRoot
                                lateMutableRoot.typeId => lateMutableBinding!.typeId
                                lateMutableRoot.typeKind => lateMutableBinding!.typeKind
                                lateMutableRoot.typeOrigin => lateMutableBinding!.typeOrigin
                                lateMutableRoot.typeModule => lateMutableBinding!.typeModule
                                lateMutableRoot.typeSymbol => lateMutableBinding!.typeSymbol
                                lateMutableRoot.typeFlags => lateMutableBinding!.typeFlags
                                lateMutableBinding! => nodes[lateMutableBindingIndex!]
                            } else {
                                lateMutableBinding!.typeId >= 0
                                    -> if { lateMutableBindingIndex! => lateMutableRootBySymbol![lateMutableGlobalSymbol] }
                            }
                        }
                }
            lateMutableBindingIndex! + 1 => lateMutableBindingIndex!
        }
    0 => lateBindingReferenceIndex!
    lateBindingReferenceIndex! < (nodes -> len)
        -> while {
            nodes[lateBindingReferenceIndex!] => lateBindingReference!
            lateBindingReference!.kind == 5
                and lateBindingReference!.operand0 >= 0
                and nodes[lateBindingReference!.operand0].kind == 17
                and nodes[lateBindingReference!.operand0].typeId >= 0
                -> if {
                    nodes[lateBindingReference!.operand0] => lateBindingReferenceOwner
                    lateBindingReferenceOwner.typeId => lateBindingReference!.typeId
                    lateBindingReferenceOwner.typeKind => lateBindingReference!.typeKind
                    lateBindingReferenceOwner.typeOrigin => lateBindingReference!.typeOrigin
                    lateBindingReferenceOwner.typeModule => lateBindingReference!.typeModule
                    lateBindingReferenceOwner.typeSymbol => lateBindingReference!.typeSymbol
                    lateBindingReferenceOwner.typeFlags => lateBindingReference!.typeFlags
                    lateBindingReference! => nodes[lateBindingReferenceIndex!]
                }
            lateBindingReferenceIndex! + 1 => lateBindingReferenceIndex!
        }
}

# Reorder aggregate operand links by declared field identity. IR node order and
# source spans are unchanged, so evaluation and side effects retain source order.
normalizeNominalOperandOrder nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, fields: ref [typeIds.NominalField; ~], typeCount: Int -> Unit {
    [Int; ~] => firstField!
    [Int; ~] => nextField!
    0 => index!
    index! < typeCount -> while {
        firstField! -> push(-1)
        index! + 1 => index!
    }
    0 => index!
    index! < (fields -> len) -> while {
        nextField! -> push(-1)
        index! + 1 => index!
    }
    (fields -> len) - 1 => index!
    index! >= 0 -> while {
        fields[index!] => field
        field.ownerType >= 0 and field.status == 0 -> if {
            firstField![field.ownerType] => nextField![index!]
            index! => firstField![field.ownerType]
        }
        index! - 1 => index!
    }
    0 => constructorIndex!
    constructorIndex! < (nodes -> len) -> while {
        nodes[constructorIndex!] => constructor!
        constructor!.kind == 12 and constructor!.typeId >= 0 and constructor!.astNode >= 0 and constructor!.sourceModule >= 0
            -> if {
                prepared.package.ranges[constructor!.sourceModule] => range
                prepared.package.nodes[range.astStart + constructor!.astNode] => constructorSyntax
                constructorSyntax.kind == 39 or constructorSyntax.kind == 38
                    -> if {
                        [Int; ~] => ordered!
                        firstField![constructor!.typeId] => fieldIndex!
                        fieldIndex! >= 0 -> while {
                            ordered! -> push(-1)
                            nextField![fieldIndex!] => fieldIndex!
                        }
                        true => complete!
                        0 => count!
                        constructor!.operand0 => valueIndex!
                        valueIndex! >= 0 -> while {
                            nodes[valueIndex!] => value
                            value.astNode => initializerIndex!
                            constructorSyntax.kind == 39 -> if {
                                initializerIndex! >= 0
                                    and prepared.package.nodes[range.astStart + initializerIndex!].kind != 40
                                    and initializerIndex! != constructor!.astNode
                                    -> while {
                                        prepared.package.nodes[range.astStart + initializerIndex!].parent => initializerIndex!
                                    }
                            } else {
                                # Contextual records keep field names and values as
                                # direct siblings rather than kind-40 initializers.
                                initializerIndex! >= 0
                                    and prepared.package.nodes[range.astStart + initializerIndex!].parent != constructor!.astNode
                                    -> while {
                                        prepared.package.nodes[range.astStart + initializerIndex!].parent => initializerIndex!
                                    }
                                initializerIndex! >= 0 -> if {
                                    prepared.package.nodes[range.astStart + initializerIndex!] => directValue
                                    -1 => precedingFieldAst!
                                    0 => fieldKeySearch!
                                    fieldKeySearch! < range.astCount -> while {
                                        prepared.package.nodes[range.astStart + fieldKeySearch!] => fieldKeyCandidate
                                        fieldKeyCandidate.parent == constructor!.astNode
                                            and fieldKeyCandidate.start < directValue.start
                                            and (precedingFieldAst! < 0
                                            or fieldKeyCandidate.start > prepared.package.nodes[range.astStart + precedingFieldAst!].start)
                                            -> if { fieldKeySearch! => precedingFieldAst! }
                                        fieldKeySearch! + 1 => fieldKeySearch!
                                    }
                                    precedingFieldAst! => initializerIndex!
                                }
                            }
                            -1 => ordinal!
                            initializerIndex! >= 0
                                and (prepared.package.nodes[range.astStart + initializerIndex!].kind == 40
                                or (constructorSyntax.kind == 38 and prepared.package.nodes[range.astStart + initializerIndex!].kind == 15))
                                -> if {
                                    prepared.package.nodes[range.astStart + initializerIndex!] => initializer
                                    prepared.package.tokens[range.tokenStart + initializer.payloadToken] => name
                                    firstField![constructor!.typeId] => fieldIndex!
                                    fieldIndex! >= 0 and ordinal! < 0 -> while {
                                        fields[fieldIndex!] => field
                                        field.fieldSymbol >= 0 -> if {
                                            prepared.package.ranges[field.sourceModule] => fieldRange
                                            prepared.package.symbols[fieldRange.symbolStart + field.fieldSymbol] => symbol
                                            prepared.package.tokens[fieldRange.tokenStart + symbol.nameToken] => fieldName
                                            name.span.length == fieldName.span.length => same!
                                            UIntSize(0) => byteIndex!
                                            same! and byteIndex! < name.span.length -> while {
                                                (prepared.package.sources[constructor!.sourceModule] -> byte(name.span.start + byteIndex!)) != (prepared.package.sources[field.sourceModule] -> byte(fieldName.span.start + byteIndex!))
                                                    -> if { false => same! }
                                                byteIndex! + 1 => byteIndex!
                                            }
                                            same! -> if { field.ordinal => ordinal! }
                                        }
                                        nextField![fieldIndex!] => fieldIndex!
                                    }
                                }
                            ordinal! >= 0 and ordinal! < (ordered! -> len)
                                -> if {
                                    ordered![ordinal!] >= 0 -> if { false => complete! }
                                    valueIndex! => ordered![ordinal!]
                                } else { false => complete! }
                            count! + 1 => count!
                            value.nextOperand => valueIndex!
                        }
                        count! != (ordered! -> len) -> if { false => complete! }
                        0 => ordinal!
                        ordinal! < (ordered! -> len) -> while {
                            ordered![ordinal!] < 0 -> if { false => complete! }
                            ordinal! + 1 => ordinal!
                        }
                        complete! and (ordered! -> len) > 0 -> if {
                            ordered![0] => constructor!.operand0
                            constructor! => nodes[constructorIndex!]
                            0 => ordinal!
                            ordinal! < (ordered! -> len) -> while {
                                ordered![ordinal!] => valueIndex
                                nodes[valueIndex] => value!
                                -1 => value!.nextOperand
                                ordinal! + 1 < (ordered! -> len) -> if { ordered![ordinal! + 1] => value!.nextOperand }
                                value! => nodes[valueIndex]
                                ordinal! + 1 => ordinal!
                            }
                        }
                    }
            }
        constructorIndex! + 1 => constructorIndex!
    }
}
