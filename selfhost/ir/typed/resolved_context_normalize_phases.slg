    # use the first resolved numeric operand as the operator's result type.
    0 => preBindingNumericOperatorIndex!
    preBindingNumericOperatorIndex! < (nodes -> len)
        -> while {
            nodes[preBindingNumericOperatorIndex!] => preBindingNumericOperator!
            preBindingNumericOperator!.kind == 8
                and preBindingNumericOperator!.opcode >= grammar.tokenIdPlus()
                and preBindingNumericOperator!.opcode <= grammar.tokenIdPercent()
                and preBindingNumericOperator!.operand0 >= 0
                and preBindingNumericOperator!.operand0 < (nodes -> len)
                and preBindingNumericOperator!.operand1 >= 0
                and preBindingNumericOperator!.operand1 < (nodes -> len)
