                    -1 => preBindingNumericTypeId!
                    nodes[preBindingNumericOperator!.operand0] => preBindingNumericLeft
                    frozenRecursiveSemanticTypes -> typeIds.materializedReadTypeId(preBindingNumericLeft.typeId) => preBindingNumericLeftTypeId
                    preBindingNumericLeftTypeId >= 0 and preBindingNumericLeftTypeId < (frozenRecursiveSemanticTypes -> len)
                        -> if {
                            frozenRecursiveSemanticTypes[preBindingNumericLeftTypeId] => leftType
                            leftType.kind == 1 and leftType.origin == 1
