    0 => canonicalPatternIndex!
    canonicalPatternIndex! < (nodes -> len) -> while {
        nodes[canonicalPatternIndex!] => canonicalPattern
        canonicalPattern.kind == 29
            and canonicalPattern.sourceModule >= 0
            and canonicalPattern.sourceModule < (prepared.package.ranges -> len)
