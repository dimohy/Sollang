                                canonicalGlobalWrapperCandidate.parent == canonicalGlobalValueIndex! and canonicalGlobalWrapperCandidate.kind != 17 and not (canonicalGlobalWrapperCandidate.typeOrigin == 1 and canonicalGlobalWrapperCandidate.typeSymbol == 0)
                                    -> if {
