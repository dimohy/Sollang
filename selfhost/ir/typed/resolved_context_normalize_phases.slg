    # Owned File calls have a stable runtime ABI in the LLVM backend. Resolve
    # declared sys.file functions by canonical module/symbol identity; member
    # readAt/writeAt opcodes are assigned from their compiler-provided names by
    # intrinsicOpcode above.
    -1 => fileModuleSource!
    0 => fileModuleSearch!
    fileModuleSearch! < (prepared.modules -> len)
        -> while {
            prepared.modules[fileModuleSearch!] => fileModuleIdentity
            fileModuleIdentity.pathHash == 1560534979202565016
                -> if { fileModuleIdentity.sourceIndex => fileModuleSource! }
            fileModuleSearch! + 1 => fileModuleSearch!
        }
    -1 => fileOpenReadSymbol!
    -1 => fileOpenWriteSymbol!
    -1 => fileSyncSymbol!
    -1 => fileAtomicReplaceSymbol!
    -1 => fileCreateExclusiveSymbol!
    -1 => fileRemovePathSymbol!
    -1 => fileOpenWriterSymbol!
    -1 => fileWriteScalarSymbol!
    -1 => fileCloseWriterSymbol!
    -1 => fileOpenReaderSymbol!
    -1 => fileReadScalarSymbol!
    -1 => fileReadScalarAsyncSymbol!
    -1 => fileCloseReaderSymbol!
    -1 => fileReadIntoAtSymbol!
    -1 => fileWriteRangeAtSymbol!
    -1 => fileOwnedSymbol!
    -1 => fileWriterSymbol!
    fileModuleSource! >= 0 -> if {
        prepared.package.ranges[fileModuleSource!] => fileSourceRange
        prepared.package.sources[fileModuleSource!] -> len => fileSourceLength
        prepared.package.sources[fileModuleSource!] -> slice(UIntSize(0), fileSourceLength) => fileSource
        0 => fileSymbolSearch!
        fileSymbolSearch! < fileSourceRange.symbolCount
            -> while {
                prepared.package.symbols[fileSourceRange.symbolStart + fileSymbolSearch!] => fileSymbol
                prepared.package.tokens[fileSourceRange.tokenStart + fileSymbol.nameToken] => fileAnyNameToken
                fileAnyNameToken.span.length == 4 -> if {
                    (fileSource -> byte(fileAnyNameToken.span.start)) == 70 and (fileSource -> byte(fileAnyNameToken.span.start + 1)) == 105 and (fileSource -> byte(fileAnyNameToken.span.start + 2)) == 108 and (fileSource -> byte(fileAnyNameToken.span.start + 3)) == 101
                        -> if { fileSymbolSearch! => fileOwnedSymbol! }
                }
                fileAnyNameToken.span.length == 10 -> if {
                    (fileSource -> byte(fileAnyNameToken.span.start)) == 70 and (fileSource -> byte(fileAnyNameToken.span.start + 1)) == 105 and (fileSource -> byte(fileAnyNameToken.span.start + 2)) == 108 and (fileSource -> byte(fileAnyNameToken.span.start + 3)) == 101 and (fileSource -> byte(fileAnyNameToken.span.start + 4)) == 87 and (fileSource -> byte(fileAnyNameToken.span.start + 5)) == 114 and (fileSource -> byte(fileAnyNameToken.span.start + 6)) == 105 and (fileSource -> byte(fileAnyNameToken.span.start + 7)) == 116 and (fileSource -> byte(fileAnyNameToken.span.start + 8)) == 101 and (fileSource -> byte(fileAnyNameToken.span.start + 9)) == 114
                        -> if { fileSymbolSearch! => fileWriterSymbol! }
                    fileSymbol.kind == 31 and (fileSource -> sourceMatches(fileAnyNameToken.span.start, fileAnyNameToken.span.length, "readIntoAt"))
                        -> if { fileSymbolSearch! => fileReadIntoAtSymbol! }
                }
                fileAnyNameToken.span.length == 12 and fileSymbol.kind == 31
                    and (fileSource -> sourceMatches(fileAnyNameToken.span.start, fileAnyNameToken.span.length, "writeRangeAt"))
                    -> if { fileSymbolSearch! => fileWriteRangeAtSymbol! }
                fileSymbol.kind == 7 and fileSymbol.parent < 0
                    -> if {
                        prepared.package.tokens[fileSourceRange.tokenStart + fileSymbol.nameToken] => fileNameToken
                        fileSource -> sourceMatches(fileNameToken.span.start, fileNameToken.span.length, "createExclusive")
                            -> if { fileSymbolSearch! => fileCreateExclusiveSymbol! }
                        fileSource -> sourceMatches(fileNameToken.span.start, fileNameToken.span.length, "removePath")
                            -> if { fileSymbolSearch! => fileRemovePathSymbol! }
                        fileSource -> sourceMatches(fileNameToken.span.start, fileNameToken.span.length, "openWriter")
                            -> if { fileSymbolSearch! => fileOpenWriterSymbol! }
                        fileSource -> sourceMatches(fileNameToken.span.start, fileNameToken.span.length, "write")
                            -> if { fileSymbolSearch! => fileWriteScalarSymbol! }
                        fileSource -> sourceMatches(fileNameToken.span.start, fileNameToken.span.length, "closeWriter")
                            -> if { fileSymbolSearch! => fileCloseWriterSymbol! }
                        fileSource -> sourceMatches(fileNameToken.span.start, fileNameToken.span.length, "openReader")
                            -> if { fileSymbolSearch! => fileOpenReaderSymbol! }
                        fileSource -> sourceMatches(fileNameToken.span.start, fileNameToken.span.length, "read")
                            -> if { fileSymbolSearch! => fileReadScalarSymbol! }
                        fileSource -> sourceMatches(fileNameToken.span.start, fileNameToken.span.length, "readAsync")
                            -> if { fileSymbolSearch! => fileReadScalarAsyncSymbol! }
                        fileSource -> sourceMatches(fileNameToken.span.start, fileNameToken.span.length, "closeReader")
                            -> if { fileSymbolSearch! => fileCloseReaderSymbol! }
                        fileNameToken.span.length == 4 -> if {
                            (fileSource -> byte(fileNameToken.span.start)) == 115 and (fileSource -> byte(fileNameToken.span.start + 1)) == 121 and (fileSource -> byte(fileNameToken.span.start + 2)) == 110 and (fileSource -> byte(fileNameToken.span.start + 3)) == 99
                                -> if { fileSymbolSearch! => fileSyncSymbol! }
                        }
                        fileNameToken.span.length == 8 -> if {
                            (fileSource -> byte(fileNameToken.span.start)) == 111 and (fileSource -> byte(fileNameToken.span.start + 1)) == 112 and (fileSource -> byte(fileNameToken.span.start + 2)) == 101 and (fileSource -> byte(fileNameToken.span.start + 3)) == 110 and (fileSource -> byte(fileNameToken.span.start + 4)) == 82 and (fileSource -> byte(fileNameToken.span.start + 5)) == 101 and (fileSource -> byte(fileNameToken.span.start + 6)) == 97 and (fileSource -> byte(fileNameToken.span.start + 7)) == 100
                                -> if { fileSymbolSearch! => fileOpenReadSymbol! }
                        }
                        fileNameToken.span.length == 9 -> if {
                            (fileSource -> byte(fileNameToken.span.start)) == 111 and (fileSource -> byte(fileNameToken.span.start + 1)) == 112 and (fileSource -> byte(fileNameToken.span.start + 2)) == 101 and (fileSource -> byte(fileNameToken.span.start + 3)) == 110 and (fileSource -> byte(fileNameToken.span.start + 4)) == 87 and (fileSource -> byte(fileNameToken.span.start + 5)) == 114 and (fileSource -> byte(fileNameToken.span.start + 6)) == 105 and (fileSource -> byte(fileNameToken.span.start + 7)) == 116 and (fileSource -> byte(fileNameToken.span.start + 8)) == 101
                                -> if { fileSymbolSearch! => fileOpenWriteSymbol! }
                        }
                        fileNameToken.span.length == 13 -> if {
                            (fileSource -> byte(fileNameToken.span.start)) == 97 and (fileSource -> byte(fileNameToken.span.start + 1)) == 116 and (fileSource -> byte(fileNameToken.span.start + 2)) == 111 and (fileSource -> byte(fileNameToken.span.start + 3)) == 109 and (fileSource -> byte(fileNameToken.span.start + 4)) == 105 and (fileSource -> byte(fileNameToken.span.start + 5)) == 99 and (fileSource -> byte(fileNameToken.span.start + 6)) == 82 and (fileSource -> byte(fileNameToken.span.start + 7)) == 101 and (fileSource -> byte(fileNameToken.span.start + 8)) == 112 and (fileSource -> byte(fileNameToken.span.start + 9)) == 108 and (fileSource -> byte(fileNameToken.span.start + 10)) == 97 and (fileSource -> byte(fileNameToken.span.start + 11)) == 99 and (fileSource -> byte(fileNameToken.span.start + 12)) == 101
                                -> if { fileSymbolSearch! => fileAtomicReplaceSymbol! }
