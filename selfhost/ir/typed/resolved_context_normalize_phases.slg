                        prepared.package.nodes[recoveredConditionRange.astStart + recoveredConditionCandidate.astNode] => recoveredConditionAst
                        recoveredConditionAst.parent => recoveredConditionAncestor!
                        1 => recoveredCandidateDistance!
                        recoveredConditionAncestor! >= 0 -> while {
                            recoveredConditionRange.astStart + recoveredConditionAncestor! => recoveredConditionAncestorGlobalAst
                            recoveredControlByFlowAst![recoveredConditionAncestorGlobalAst] => recoveredCandidateControl!
                            recoveredCandidateControl! >= 0 -> while {
                                nodes[recoveredCandidateControl!] => recoveredCandidateControlNode
                                prepared.package.nodes[recoveredConditionRange.astStart + recoveredCandidateControlNode.astNode] => recoveredCandidateControlAst
                                recoveredConditionAst.start < recoveredCandidateControlAst.start
                                    and (recoveredConditionByControl![recoveredCandidateControl!] < 0
                                    or recoveredCandidateDistance! < recoveredConditionDistanceByControl![recoveredCandidateControl!]
                                    or (recoveredCandidateDistance! == recoveredConditionDistanceByControl![recoveredCandidateControl!]
