                        prepared.package.nodes[canonicalPatternRange.astStart + canonicalPatternCandidate.astNode].start => canonicalPatternCandidateStart
                        canonicalPatternCandidateStart <= prepared.package.nodes[canonicalPatternRange.astStart + canonicalReference!.astNode].start
