                        UIntSize(0) => canonicalGlobalWrapperLength!
                        canonicalBindingChildHeads![canonicalGlobalValueIndex!] => canonicalGlobalWrapperSearch!
                        canonicalGlobalWrapperSearch! >= 0
                            -> while {
