                    }
                nodes[canonicalGlobalValueIndex!].typeId => canonicalBinding!.typeId
                nodes[canonicalGlobalValueIndex!].typeKind => canonicalBinding!.typeKind
                nodes[canonicalGlobalValueIndex!].typeOrigin => canonicalBinding!.typeOrigin
                nodes[canonicalGlobalValueIndex!].typeModule => canonicalBinding!.typeModule
                nodes[canonicalGlobalValueIndex!].typeSymbol => canonicalBinding!.typeSymbol
                nodes[canonicalGlobalValueIndex!].typeFlags => canonicalBinding!.typeFlags
                canonicalBinding! => nodes[canonicalBindingIndex!]
            }
        canonicalBindingIndex! + 1 => canonicalBindingIndex!
    }
}

normalizeResolvedPatterns nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, inferred: ref [expressionTypes.ExpressionType; ~], frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], frozenRecursiveTypeByAst: ref [Int; ~], recursiveReferences: ref [typeIds.TypeReference; ~], recursiveTypeFlags: ref [Int; ~] -> Unit {
    [Int; ~] => canonicalPatternHeadBySymbol!
