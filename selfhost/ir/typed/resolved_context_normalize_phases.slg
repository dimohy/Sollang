    # Runtime readInt has no user declaration to contribute a return type.
    # Preserve its intrinsic Int result before binding/reference propagation.
    0 => runtimeReadIntIndex!
    runtimeReadIntIndex! < (nodes -> len) -> while {
        nodes[runtimeReadIntIndex!] => runtimeReadInt!
        runtimeReadInt!.kind == 6 and runtimeReadInt!.symbol == -103
            -> if {
                1 => runtimeReadInt!.typeOrigin
