        nodes[canonicalBindingChildIndex!].parent => canonicalBindingChildParent
        canonicalBindingChildParent >= 0 and canonicalBindingChildParent < (nodes -> len)
            -> if {
                canonicalBindingChildHeads![canonicalBindingChildParent] => canonicalBindingChildNext![canonicalBindingChildIndex!]
