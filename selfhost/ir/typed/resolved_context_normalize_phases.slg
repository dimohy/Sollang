                        fileNominalType.symbol == fileOwnedSymbol! -> if { fileNominalTypeSearch! => fileOwnedType! }
                        fileNominalType.symbol == fileWriterSymbol! -> if { fileNominalTypeSearch! => fileWriterType! }
                    }
                fileNominalTypeSearch! + 1 => fileNominalTypeSearch!
            }
        -1 => fileOpenReadResultType!
        -1 => fileOpenWriteResultType!
        0 => fileResultTypeSearch!
        fileResultTypeSearch! < (frozenRecursiveSemanticTypes -> len)
            -> while {
                frozenRecursiveSemanticTypes[fileResultTypeSearch!] => fileResultType
                fileResultType.kind == 7 and fileResultType.origin == 4 and fileResultType.symbol == 1 and fileResultType.second == 1
                    -> if {
                        fileResultType.first == fileOwnedType! -> if { fileResultTypeSearch! => fileOpenReadResultType! }
                        fileResultType.first == fileWriterType! -> if { fileResultTypeSearch! => fileOpenWriteResultType! }
                    }
                fileResultTypeSearch! + 1 => fileResultTypeSearch!
            }
        0 => fileCallIndex!
        fileCallIndex! < (nodes -> len) -> while {
            nodes[fileCallIndex!] => fileCall!
            (fileCall!.kind == 6 or fileCall!.kind == 9) and fileCall!.targetModule == fileModuleSource!
                -> if {
                    fileCall!.symbol == fileOpenReadSymbol! -> if { -216 => fileCall!.opcode }
                    fileCall!.symbol == fileOpenWriteSymbol! -> if { -217 => fileCall!.opcode }
                    fileCall!.symbol == fileSyncSymbol! -> if { -218 => fileCall!.opcode }
                    fileCall!.symbol == fileAtomicReplaceSymbol!
                        -> if { -219 => fileCall!.opcode }
                    fileCreateExclusiveSymbol! >= 0 and fileCall!.symbol == fileCreateExclusiveSymbol!
                        -> if { -311 => fileCall!.opcode }
                    fileRemovePathSymbol! >= 0 and fileCall!.symbol == fileRemovePathSymbol!
                        -> if { -312 => fileCall!.opcode }
                    fileOpenWriterSymbol! >= 0 and fileCall!.symbol == fileOpenWriterSymbol!
                        -> if { -313 => fileCall!.opcode }
                    fileWriteScalarSymbol! >= 0 and fileCall!.symbol == fileWriteScalarSymbol!
                        -> if { -314 => fileCall!.opcode }
                    fileCloseWriterSymbol! >= 0 and fileCall!.symbol == fileCloseWriterSymbol!
                        -> if { -315 => fileCall!.opcode }
                    fileOpenReaderSymbol! >= 0 and fileCall!.symbol == fileOpenReaderSymbol!
                        -> if { -316 => fileCall!.opcode }
                    fileReadScalarSymbol! >= 0 and fileCall!.symbol == fileReadScalarSymbol!
                        -> if { -317 => fileCall!.opcode }
                    fileReadScalarAsyncSymbol! >= 0 and fileCall!.symbol == fileReadScalarAsyncSymbol!
                        -> if {
                            -319 => fileCall!.opcode
                            (fileCall!.flags / 8) % 2 == 0
                                -> if { fileCall!.flags + 8 => fileCall!.flags }
                        }
                    fileCloseReaderSymbol! >= 0 and fileCall!.symbol == fileCloseReaderSymbol!
                        -> if { -318 => fileCall!.opcode }
                    fileCall!.symbol == fileReadIntoAtSymbol! -> if { -304 => fileCall!.opcode }
                    fileCall!.symbol == fileWriteRangeAtSymbol! -> if { -305 => fileCall!.opcode }
                    fileCall!.symbol == fileOpenReadSymbol! -> if { fileOpenReadResultType! => fileCall!.typeId }
                    fileCall!.symbol == fileOpenWriteSymbol! -> if { fileOpenWriteResultType! => fileCall!.typeId }
                    fileCall!.typeId < 0 and fileCall!.symbol >= 0
                        -> if {
                            prepared.package.symbols[fileSourceRange.symbolStart + fileCall!.symbol] => fileCallFunction
                            fileCallFunction.typeNode => fileCallResultAst!
                            fileCallFunction.secondaryTypeNode >= 0 -> if { fileCallFunction.secondaryTypeNode => fileCallResultAst! }
                            0 => fileCallReferenceSearch!
                            fileCallReferenceSearch! < (recursiveReferences -> len)
                                -> while {
                                    recursiveReferences[fileCallReferenceSearch!] => fileCallReference
                                    fileCallReference.sourceModule == fileModuleSource! and fileCallReference.typeAst == fileCallResultAst! and fileCallReference.status == 0
                                        -> if {
                                            fileCallReference.typeId => fileCall!.typeId
                                            frozenRecursiveSemanticTypes[fileCallReference.typeId] => fileCallType
                                            fileCallType.kind => fileCall!.typeKind
                                            fileCallType.origin => fileCall!.typeOrigin
                                            fileCallType.module => fileCall!.typeModule
                                            fileCallType.symbol => fileCall!.typeSymbol
                                            recursiveTypeFlags[fileCallReference.typeId] => fileCall!.typeFlags
                                        }
                                    fileCallReferenceSearch! + 1 => fileCallReferenceSearch!
                                }
                        }
                    fileCall!.typeId >= 0 -> if {
                        frozenRecursiveSemanticTypes[fileCall!.typeId] => canonicalFileCallType
                        canonicalFileCallType.kind => fileCall!.typeKind
                        canonicalFileCallType.origin => fileCall!.typeOrigin
                        canonicalFileCallType.module => fileCall!.typeModule
                        canonicalFileCallType.symbol => fileCall!.typeSymbol
                        recursiveTypeFlags[fileCall!.typeId] => fileCall!.typeFlags
