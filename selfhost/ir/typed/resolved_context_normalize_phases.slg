                    }
                fileSymbolSearch! + 1 => fileSymbolSearch!
            }
        -1 => fileOwnedType!
        -1 => fileWriterType!
        0 => fileNominalTypeSearch!
        fileNominalTypeSearch! < (frozenRecursiveSemanticTypes -> len)
            -> while {
                frozenRecursiveSemanticTypes[fileNominalTypeSearch!] => fileNominalType
                fileNominalType.kind == 1 and (fileNominalType.origin == 0 or fileNominalType.origin == 2) and fileNominalType.module == fileModuleSource!
