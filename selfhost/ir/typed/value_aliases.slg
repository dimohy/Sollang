namespace sollang.compiler.ir.typed

import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.expression_type_ids as expressionTypeIds
import sollang.compiler.semantic.type_ids as typeIds
import syntax.generated.slg as grammar

hasCanonicalValueType node: ref TypedIrNode -> Bool {
    node.typeId >= 0 and not (node.typeOrigin == 1 and node.typeSymbol == 0)
}

# A mutable binding can reuse a prior slot only when that declaration's
# lexical owner is visible from the new binding's scope. Equal spelling in
# nested and sibling control regions is a distinct owner. Symbol parents do
# not retain those regions; use the same AST scopes as semantic binding owners.
priorMutableBindingVisible previousSymbol: Int, currentSymbol: Int, sourceIndex: Int, prepared: ref semanticContext.SemanticSnapshot -> Bool {
    prepared.package.ranges[sourceIndex] => range
    previousSymbol < 0 or previousSymbol >= range.symbolCount or currentSymbol < 0 or currentSymbol >= range.symbolCount
        -> if { false -> return }
    prepared.package.symbols[range.symbolStart + previousSymbol].astNode => previousAst
    prepared.package.symbols[range.symbolStart + currentSymbol].astNode => currentAst
    prepared.package.nodes[range.astStart + previousAst].start >= prepared.package.nodes[range.astStart + currentAst].start
        -> if { false -> return }
    prepared.package -> semanticContext.declarationScope(sourceIndex, previousAst) => previousScope
    prepared.package -> semanticContext.declarationAncestor(sourceIndex, previousScope, currentAst)
}

# A source flow can wrap the match subject in transparent typed IR shells.
# The enum match consumes the materialized value, exactly as the managed
# emitter consumes the expression that represents its subject.
materializedMatchSubject subjectIndex: Int, nodes: ref [TypedIrNode; ~] -> Int {
    subjectIndex => valueIndex!
    0 => depth!
    valueIndex! >= 0 and valueIndex! < (nodes -> len) and depth! < (nodes -> len)
        -> while {
            nodes[valueIndex!] => value
            value.kind == 9 and value.opcode == -1 and value.operand1 < 0
                and value.operand0 >= 0 and value.operand0 < (nodes -> len)
                and nodes[value.operand0].parent == valueIndex!
                -> if {
                    value.operand0 => valueIndex!
                    depth! + 1 => depth!
                } else { valueIndex! -> return }
        }
    valueIndex!
}

# Source-finalization runs before every transparent flow operand is linked.
# Canonicalize enum match operands after the complete Typed IR is sealed.
sealMaterializedMatchSubjects nodes: mut [TypedIrNode; ~] -> Unit {
    0 => matchIndex!
    matchIndex! < (nodes -> len) -> while {
        nodes[matchIndex!] => match!
        match!.kind == 27 and match!.operand0 >= 0 -> if {
            match!.operand0 -> materializedMatchSubject(nodes) => match!.operand0
            match! => nodes[matchIndex!]
        }
        matchIndex! + 1 => matchIndex!
    }
}

# A returned subject `when` may keep provisional Unit metadata until calls in
# its arms and the function result have been sealed. Publish the declared
# return type on the actual control value before LLVM decides whether to
# allocate and fill its result slot.
sealReturnedSubjectWhenTypes nodes: mut [TypedIrNode; ~] -> Unit {
    0 => functionIndex!
    functionIndex! < (nodes -> len) -> while {
        nodes[functionIndex!] => function
        function.kind == 0 and function.typeId >= 0
            and function.operand0 >= 0 and function.operand0 < (nodes -> len)
            and nodes[function.operand0].kind == 1 -> if {
                nodes[function.operand0] => returnNode
                returnNode.operand0 >= 0 and returnNode.operand0 < (nodes -> len)
                    -> if {
                        nodes[returnNode.operand0] => result!
                        result!.kind == 34
                            and (result!.typeId < 0 or (result!.typeOrigin == 1 and result!.typeSymbol == 0))
                            -> if {
                                function.typeId => result!.typeId
                                function.typeKind => result!.typeKind
                                function.typeOrigin => result!.typeOrigin
                                function.typeModule => result!.typeModule
                                function.typeSymbol => result!.typeSymbol
                                function.typeFlags => result!.typeFlags
                                result! => nodes[returnNode.operand0]
                            }
                    }
            }
        functionIndex! + 1 => functionIndex!
    }
}

# A nested source flow is lowered as an inner transparent stage after the
# ordinary function pass. Recover its declared generic payload from the outer
# constructor, then materialize both enum variants before LLVM scheduling.
sealNestedStandardEnumConstructors nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], typeFlags: ref [Int; ~] -> Unit {
    prepared.package -> semanticContext.indexFlowSourcesByAst => flowSources
    0 => stageIndex!
    stageIndex! < (nodes -> len) -> while {
        nodes[stageIndex!] => stage!
        stage!.kind == 9 and stage!.opcode == -1 and stage!.parent >= 0
            and stage!.parent < (nodes -> len) and stage!.sourceModule >= 0
            and stage!.sourceModule < (prepared.package.ranges -> len)
            -> if {
                nodes[stage!.parent] => outer
                outer.kind == 26 and outer.typeId >= 0 and outer.typeId < (types -> len)
                    and outer.opcode == 0 and outer.operand0 == stageIndex!
                    -> if {
                        types[outer.typeId] => outerType
                        outerType.kind == 7 and outerType.origin == 4
                            and (outerType.symbol == 0 or outerType.symbol == 1)
                            and outerType.first >= 0 and outerType.first < (types -> len)
                            -> if {
                                prepared.package.ranges[stage!.sourceModule] => range
                                prepared.package.nodes[range.astStart + stage!.astNode] => stageAst
                                prepared.package.sources[stage!.sourceModule] -> len => sourceLength
                                prepared.package.sources[stage!.sourceModule] -> slice(UIntSize(0), sourceLength) => source
                                source -> standardGenericEnumFlowVariantToken(prepared.package.tokens, range.tokenStart, stageAst) => variantTokenIndex
                                variantTokenIndex >= 0 -> if {
                                    prepared.package.tokens[range.tokenStart + variantTokenIndex] => variantToken
                                    types[outerType.first] => stageType
                                    stage!.sourceModule -> nominalVariantTagForType(stageType, variantToken, prepared) => stageTag
                                    stageTag >= 0 and stageType.kind == 7 and stageType.origin == 4
                                        and stageType.symbol == 0 and stageType.first >= 0 and stageType.first < (types -> len)
                                        -> if {
                                            26 => stage!.kind
                                            outerType.first => stage!.typeId
                                            stageType.kind => stage!.typeKind
                                            stageType.origin => stage!.typeOrigin
                                            stageType.module => stage!.typeModule
                                            stageType.symbol => stage!.typeSymbol
                                            typeFlags[outerType.first] => stage!.typeFlags
                                            stageTag => stage!.opcode
                                            -1 => stage!.symbol
                                            -1 => stage!.targetModule
                                            -1 => stagePayload!
                                            flowSources[range.astStart + stage!.astNode] => sourceGlobal
                                            0 => childIndex!
                                            childIndex! < (nodes -> len) -> while {
                                                nodes[childIndex!] => child
                                                child.parent == stageIndex! and child.sourceModule == stage!.sourceModule
                                                    and child.astNode >= 0 and child.astNode < range.astCount
                                                    and sourceGlobal >= 0
                                                    -> if {
                                                        prepared.package.nodes[range.astStart + child.astNode] => childAst
                                                        prepared.package.nodes[sourceGlobal] => sourceAst
                                                        childAst.start == sourceAst.start and childAst.length == sourceAst.length
                                                            -> if { childIndex! => stagePayload! }
                                                    }
                                                childIndex! + 1 => childIndex!
                                            }
                                            stagePayload! >= 0 -> if {
                                                stagePayload! => stage!.operand0
                                                nodes[stagePayload!] => payload!
                                                payload!.targetModule >= 0 and payload!.targetModule < (prepared.package.ranges -> len)
                                                    -> if {
                                                        prepared.package.ranges[payload!.targetModule] => payloadRange
                                                        payload!.symbol >= 0 and payload!.symbol < payloadRange.symbolCount
                                                            -> if {
                                                                prepared.package.symbols[payloadRange.symbolStart + payload!.symbol] => variantSymbol
                                                                variantSymbol.kind == 27 and variantSymbol.parent >= 0
                                                                    -> if {
                                                                        types[stageType.first] => payloadEnumType
                                                                        prepared.package.tokens[payloadRange.tokenStart + variantSymbol.nameToken] => payloadVariantToken
                                                                        payload!.targetModule -> nominalVariantTagForType(payloadEnumType, payloadVariantToken, prepared) => payloadTag
                                                                        payloadTag >= 0 -> if {
                                                                            26 => payload!.kind
                                                                            stageType.first => payload!.typeId
                                                                            payloadEnumType.kind => payload!.typeKind
                                                                            payloadEnumType.origin => payload!.typeOrigin
                                                                            payloadEnumType.module => payload!.typeModule
                                                                            payloadEnumType.symbol => payload!.typeSymbol
                                                                            typeFlags[stageType.first] => payload!.typeFlags
                                                                            payloadTag => payload!.opcode
                                                                            0 => argumentIndex!
                                                                            argumentIndex! < (nodes -> len) -> while {
                                                                                nodes[argumentIndex!].parent == stagePayload! and nodes[argumentIndex!].kind == 12
                                                                                    -> if { argumentIndex! => payload!.operand0 }
                                                                                argumentIndex! + 1 => argumentIndex!
                                                                            }
                                                                            payload! => nodes[stagePayload!]
                                                                        }
                                                                    }
                                                            }
                                                    }
                                            }
                                            stagePayload! >= 0 -> if { stage! => nodes[stageIndex!] }
                                        }
                                }
                            }
                    }
            }
        stageIndex! + 1 => stageIndex!
    }
}

# A later assignment can temporarily point a mutable binding at an unresolved
# Result payload. Refreshing that edge must never erase an earlier canonical
# owner type with unknown or provisional Unit metadata.
mayRefreshValueAlias binding: ref TypedIrNode, value: ref TypedIrNode -> Bool {
    (value -> hasCanonicalValueType) or not (binding -> hasCanonicalValueType)
}

# Resolve a declaration result from the canonical recursive type arena. This is
# shared by initial lowering and late call-identity closure so a projected call
# cannot acquire its target after the only return-type pass has already run.
resolvedFunctionResultTypeId sourceIndex: Int, functionSymbol: Int, prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, types: ref [typeIds.SemanticType; ~] -> Int {
    prepared.package.ranges[sourceIndex] => functionRange
    prepared.package.symbols[functionRange.symbolStart + functionSymbol] => function
    -1 => resultTypeId!
    function.flags / 32 % 2 == 1 -> if {
        0 => inferredResultSearch!
        inferredResultSearch! < (recursiveTypes.expressions -> len)
            -> while {
                recursiveTypes.expressions[inferredResultSearch!] => inferredResult
                inferredResult.sourceModule == sourceIndex
                    and inferredResult.astNode == function.astNode
                    and inferredResult.status == 0
                    -> if { inferredResult.typeId -> return }
                inferredResultSearch! + 1 => inferredResultSearch!
            }
        -1 -> return
    }
    function.kind == 36 -> if {
        function.parent => comGeneratedInterfaceSymbol!
        function.flags / 131072 % 2 == 1 -> if { function.secondaryTypeNode => comGeneratedInterfaceSymbol! }
        types -> comGeneratedResultTypeId(sourceIndex, comGeneratedInterfaceSymbol!, function.flags) => resultTypeId!
    } else {
        function.typeNode => resultAst!
        function.secondaryTypeNode >= 0 -> if { function.secondaryTypeNode => resultAst! }
        prepared -> declaredArrayShapeKind(sourceIndex, resultAst!) => resultShapeKind
        resultAst! >= 0 and resultAst! < functionRange.astCount
            -> if {
                recursiveTypes.referenceIndexByTypeAst[functionRange.astStart + resultAst!] => resultReferenceIndex
                resultReferenceIndex >= 0 and resultReferenceIndex < (recursiveTypes.references -> len)
                    -> if {
                        recursiveTypes.references[resultReferenceIndex] => resultReference
                        resultReference.status == 0
                            and resultReference.sourceModule == sourceIndex
                            and resultReference.typeAst == resultAst!
                            and (resultShapeKind < 0 or types[resultReference.typeId].kind == resultShapeKind)
                            -> if { resultReference.typeId => resultTypeId! }
                    }
            }
        function.flags / 32768 % 2 == 1 and resultTypeId! >= 0
            -> if {
                resultTypeId! => nativeTrySuccessType
                0 => nativeTryResultSearch!
                nativeTryResultSearch! < (types -> len) -> while {
                    types[nativeTryResultSearch!] => nativeTryResultCandidate
                    nativeTryResultCandidate.kind == 7
                        and nativeTryResultCandidate.origin == 4
                        and nativeTryResultCandidate.symbol == 1
                        and nativeTryResultCandidate.first == nativeTrySuccessType
                        and nativeTryResultCandidate.second == (types -> typeIds.builtinTypeId(5))
                        -> if { nativeTryResultSearch! => resultTypeId! }
                    nativeTryResultSearch! + 1 => nativeTryResultSearch!
                }
            }
    }
    resultTypeId!
}

sealLateResolvedCallResultTypes nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, types: ref [typeIds.SemanticType; ~], flags: ref [Int; ~] -> Unit {
    0 => callIndex!
    callIndex! < (nodes -> len) -> while {
        nodes[callIndex!] => call!
        (call!.kind == 6 or call!.kind == 9)
            and call!.typeId < 0
            and call!.targetModule >= 0
            and call!.targetModule < (prepared.package.ranges -> len)
            and call!.symbol >= 0
            and call!.symbol < prepared.package.ranges[call!.targetModule].symbolCount
            -> if {
                call!.targetModule -> resolvedFunctionResultTypeId(call!.symbol, prepared, recursiveTypes, types) => resultTypeId
                resultTypeId >= 0 -> if {
                    types[resultTypeId] => resultType
                    resultTypeId => call!.typeId
                    resultType.kind => call!.typeKind
                    resultType.origin => call!.typeOrigin
                    resultType.module => call!.typeModule
                    resultType.symbol => call!.typeSymbol
                    flags[resultTypeId] => call!.typeFlags
                    call! => nodes[callIndex!]
                }
            }
        callIndex! + 1 => callIndex!
    }
}

# Index canonical Result values by their exact propagation parent once, then
# materialize every postfix-`?` payload and receiving binding. Late instance
# resolution can type a call, binding, and direct read only after the initial
# propagation pass. Follow only the terminal edge of a transparent flow shell;
# a Result constructed inside one match arm is not the match's merged value.
sealLateResultPropagations nodes: mut [TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], flags: ref [Int; ~] -> Unit {
    [Int; ~] => resultValueByPropagation!
    0 => resultPropagationSeed!
    resultPropagationSeed! < (nodes -> len) -> while {
        resultValueByPropagation! -> push(-1)
        resultPropagationSeed! + 1 => resultPropagationSeed!
    }
    0 => resultValueIndex!
    resultValueIndex! < (nodes -> len) -> while {
        nodes[resultValueIndex!] => resultValue
        resultValue.parent => propagationParent!
        resultValueIndex! => producerChild!
        propagationParent! >= 0
            and propagationParent! < (nodes -> len)
            and nodes[propagationParent!].kind == 9
            and nodes[propagationParent!].opcode == -1
            -> while {
                nodes[propagationParent!] => wrapper
                wrapper.operand1 == producerChild!
                    or (wrapper.operand1 < 0 and wrapper.operand0 == producerChild!)
                    -> if {
                        propagationParent! => producerChild!
                        wrapper.parent => propagationParent!
                    } else { -1 => propagationParent! }
            }
        false => hasFollowingProducer!
        resultValue.nextOperand >= 0
            and resultValue.nextOperand < (nodes -> len)
            -> if {
                nodes[resultValue.nextOperand].parent == resultValue.parent
                    -> if { true => hasFollowingProducer! }
            }
        propagationParent! >= 0
            and propagationParent! < (nodes -> len)
            and nodes[propagationParent!].kind == 30
            and not hasFollowingProducer!
            and (resultValue.typeId -> intrinsicResultTypeId(types)) >= 0
            -> if {
                resultValueIndex! => resultValueByPropagation![propagationParent!]
            }
        resultValueIndex! + 1 => resultValueIndex!
    }
    0 => resultPropagationIndex!
    resultPropagationIndex! < (nodes -> len) -> while {
        nodes[resultPropagationIndex!] => propagation!
        propagation!.kind == 30
            and resultValueByPropagation![resultPropagationIndex!] >= 0
            -> if {
                resultValueByPropagation![resultPropagationIndex!] => producerIndex
                nodes[producerIndex] => producer
                propagation! -> resultPropagationResultTypeId(producer, types)
                    => propagationResultTypeId
                propagationResultTypeId >= 0 -> if {
                    types[propagationResultTypeId] => propagationResultType
                    types[propagationResultType.first] => payloadType
                    producerIndex => propagation!.operand0
                    propagationResultType.first => propagation!.typeId
                    payloadType.kind => propagation!.typeKind
                    payloadType.origin => propagation!.typeOrigin
                    payloadType.module => propagation!.typeModule
                    payloadType.symbol => propagation!.typeSymbol
                    flags[propagationResultType.first] => propagation!.typeFlags
                    propagation! => nodes[resultPropagationIndex!]
                    propagation!.parent >= 0
                        and propagation!.parent < (nodes -> len)
                        and nodes[propagation!.parent].kind == 17
                        -> if {
                            nodes[propagation!.parent] => propagationBinding!
                            resultPropagationIndex! => propagationBinding!.operand0
                            propagation!.typeId => propagationBinding!.typeId
                            propagation!.typeKind => propagationBinding!.typeKind
                            propagation!.typeOrigin => propagationBinding!.typeOrigin
                            propagation!.typeModule => propagationBinding!.typeModule
                            propagation!.typeSymbol => propagationBinding!.typeSymbol
                            propagation!.typeFlags => propagationBinding!.typeFlags
                            propagationBinding! => nodes[propagation!.parent]
                        }
                }
            }
        resultPropagationIndex! + 1 => resultPropagationIndex!
    }
}

# An immutable `value => name` binding and an unknown mutable root initialized
# from a non-Result value preserve the producer type. A late intrinsic or
# projected call can acquire its canonical result only after the broad binding
# refresh has run. Repair only an unknown or provisional Unit binding from a
# concrete non-Unit producer; Result `?` bindings intentionally carry the
# success payload rather than the Result and are never copied from the wrapper.
# Mutable rebinds are distinct IR binding nodes with the same exact global
# source symbol. Retain the last canonical binding per symbol in one linear
# index. An unknown rebind inherits that type, as does the narrow cycle where
# its Result propagation reads the same rebind as its own receiver. Ordinary
# numeric widening and other non-cyclic rebind convergence remain untouched.
sealLateValueAliasTypes nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot -> Unit {
    [Int; ~] => canonicalMutableBindingBySymbol!
    0 => canonicalMutableSymbolSeed!
    canonicalMutableSymbolSeed! < (prepared.package.symbols -> len)
        -> while {
            canonicalMutableBindingBySymbol! -> push(-1)
            canonicalMutableSymbolSeed! + 1 => canonicalMutableSymbolSeed!
        }
    0 => bindingIndex!
    bindingIndex! < (nodes -> len) -> while {
        nodes[bindingIndex!] => binding!
        binding!.kind == 17
            and binding!.operand0 >= 0
            and binding!.operand0 < (nodes -> len)
            and (nodes[binding!.operand0] -> hasCanonicalValueType)
            and (binding!.flags != 1
            or not (nodes[binding!.operand0].typeKind == 7
            and nodes[binding!.operand0].typeOrigin == 4
            and nodes[binding!.operand0].typeSymbol == 1))
            and (binding!.typeId < 0
            or (binding!.typeOrigin == 1 and binding!.typeSymbol == 0)
            or (binding!.flags != 1
            and (nodes[binding!.operand0].kind == 5
            or nodes[binding!.operand0].kind == 15)
            and binding!.typeId != nodes[binding!.operand0].typeId))
            -> if {
                nodes[binding!.operand0] => value
                value.typeId => binding!.typeId
                value.typeKind => binding!.typeKind
                value.typeOrigin => binding!.typeOrigin
                value.typeModule => binding!.typeModule
                value.typeSymbol => binding!.typeSymbol
                value.typeFlags => binding!.typeFlags
                binding! => nodes[bindingIndex!]
            }
        binding!.kind == 17
            and binding!.flags == 1
            and binding!.sourceModule >= 0
            and binding!.sourceModule < (prepared.package.ranges -> len)
            and binding!.symbol >= 0
            and binding!.symbol < prepared.package.ranges[binding!.sourceModule].symbolCount
            -> if {
                prepared.package.ranges[binding!.sourceModule].symbolStart + binding!.symbol
                    => canonicalMutableGlobalSymbol
                canonicalMutableBindingBySymbol![canonicalMutableGlobalSymbol] >= 0
                    and (not (binding! -> hasCanonicalValueType)
                    or (binding!.operand0 >= 0
                    and binding!.operand0 < (nodes -> len)
                    and nodes[binding!.operand0].kind == 30
                    and nodes[binding!.operand0].operand0 >= 0
                    and nodes[binding!.operand0].operand0 < (nodes -> len)
                    and nodes[nodes[binding!.operand0].operand0].kind == 5
                    and nodes[nodes[binding!.operand0].operand0].operand0 == bindingIndex!))
                    -> if {
                        nodes[canonicalMutableBindingBySymbol![canonicalMutableGlobalSymbol]]
                            => canonicalMutableBinding
                        canonicalMutableBinding.typeId => binding!.typeId
                        canonicalMutableBinding.typeKind => binding!.typeKind
                        canonicalMutableBinding.typeOrigin => binding!.typeOrigin
                        canonicalMutableBinding.typeModule => binding!.typeModule
                        canonicalMutableBinding.typeSymbol => binding!.typeSymbol
                        canonicalMutableBinding.typeFlags => binding!.typeFlags
                        binding! => nodes[bindingIndex!]
                    }
                binding! -> hasCanonicalValueType -> if {
                    bindingIndex! => canonicalMutableBindingBySymbol![canonicalMutableGlobalSymbol]
                }
            }
        bindingIndex! + 1 => bindingIndex!
    }
    0 => readIndex!
    readIndex! < (nodes -> len) -> while {
        nodes[readIndex!] => read!
        read!.kind == 5
            and read!.operand0 >= 0
            and read!.operand0 < (nodes -> len)
            and nodes[read!.operand0].kind == 17
            and nodes[read!.operand0].typeId >= 0
            -> if {
                nodes[read!.operand0] => binding
                binding.typeId => read!.typeId
                binding.typeKind => read!.typeKind
                binding.typeOrigin => read!.typeOrigin
                binding.typeModule => read!.typeModule
                binding.typeSymbol => read!.typeSymbol
                binding.typeFlags => read!.typeFlags
                read! => nodes[readIndex!]
            }
        readIndex! + 1 => readIndex!
    }
}

# Final arithmetic fixed-point recovery can widen an initializer after the
# ordinary slot pass has already frozen its binding and direct reads. Refresh
# only declaration roots whose value is that repaired arithmetic node, then
# preserve the invariant type across every later version of the same mutable
# source symbol. Result `?` payload bindings and unrelated aliases remain
# governed by the broader late-value rules above.
sealPostArithmeticSlotTypes nodes: mut [TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot -> Unit {
    [Int; ~] => arithmeticRootBySymbol!
    0 => arithmeticRootSeed!
    arithmeticRootSeed! < (prepared.package.symbols -> len)
        -> while {
            arithmeticRootBySymbol! -> push(-1)
            arithmeticRootSeed! + 1 => arithmeticRootSeed!
        }
    0 => arithmeticBindingIndex!
    arithmeticBindingIndex! < (nodes -> len) -> while {
        nodes[arithmeticBindingIndex!] => arithmeticBinding!
        arithmeticBinding!.kind == 17
            and arithmeticBinding!.sourceModule >= 0
            and arithmeticBinding!.sourceModule < (prepared.package.ranges -> len)
            and arithmeticBinding!.symbol >= 0 -> if {
                prepared.package.ranges[arithmeticBinding!.sourceModule] => arithmeticBindingRange
                arithmeticBinding!.symbol < arithmeticBindingRange.symbolCount
                    -> if {
                        arithmeticBindingRange.symbolStart + arithmeticBinding!.symbol => arithmeticGlobalSymbol
                        arithmeticRootBySymbol![arithmeticGlobalSymbol] => arithmeticRootIndex
                        arithmeticRootIndex < 0
                            and arithmeticBinding!.operand0 >= 0
                            and arithmeticBinding!.operand0 < (nodes -> len)
                            and nodes[arithmeticBinding!.operand0].kind == 8
                            and nodes[arithmeticBinding!.operand0].opcode >= grammar.tokenIdPlus()
                            and nodes[arithmeticBinding!.operand0].opcode <= grammar.tokenIdPercent()
                            and (nodes[arithmeticBinding!.operand0] -> hasCanonicalValueType)
                            -> if {
                                nodes[arithmeticBinding!.operand0] => arithmeticRootValue
                                arithmeticRootValue.typeId => arithmeticBinding!.typeId
                                arithmeticRootValue.typeKind => arithmeticBinding!.typeKind
                                arithmeticRootValue.typeOrigin => arithmeticBinding!.typeOrigin
                                arithmeticRootValue.typeModule => arithmeticBinding!.typeModule
                                arithmeticRootValue.typeSymbol => arithmeticBinding!.typeSymbol
                                arithmeticRootValue.typeFlags => arithmeticBinding!.typeFlags
                                arithmeticBinding! => nodes[arithmeticBindingIndex!]
                                arithmeticBindingIndex! => arithmeticRootBySymbol![arithmeticGlobalSymbol]
                            }
                        arithmeticRootBySymbol![arithmeticGlobalSymbol] => refreshedArithmeticRootIndex
                        refreshedArithmeticRootIndex >= 0 and refreshedArithmeticRootIndex != arithmeticBindingIndex!
                            -> if {
                                nodes[refreshedArithmeticRootIndex] => arithmeticRoot
                                arithmeticBinding!.operand0 >= 0
                                    and arithmeticBinding!.operand0 < (nodes -> len)
                                    and nodes[arithmeticBinding!.operand0].kind == 8
                                    and nodes[arithmeticBinding!.operand0].opcode >= grammar.tokenIdPlus()
                                    and nodes[arithmeticBinding!.operand0].opcode <= grammar.tokenIdPercent()
                                    -> if {
                                        nodes[arithmeticBinding!.operand0] => arithmeticRebindValue!
                                        nodes -> sealIntegerLiteralPeerContext(arithmeticRebindValue!.operand0, arithmeticRoot)
                                        nodes -> sealIntegerLiteralPeerContext(arithmeticRebindValue!.operand1, arithmeticRoot)
                                        arithmeticRoot.typeId => arithmeticRebindValue!.typeId
                                        arithmeticRoot.typeKind => arithmeticRebindValue!.typeKind
                                        arithmeticRoot.typeOrigin => arithmeticRebindValue!.typeOrigin
                                        arithmeticRoot.typeModule => arithmeticRebindValue!.typeModule
                                        arithmeticRoot.typeSymbol => arithmeticRebindValue!.typeSymbol
                                        arithmeticRoot.typeFlags => arithmeticRebindValue!.typeFlags
                                        arithmeticRebindValue! => nodes[arithmeticBinding!.operand0]
                                    }
                                arithmeticRoot.typeId => arithmeticBinding!.typeId
                                arithmeticRoot.typeKind => arithmeticBinding!.typeKind
                                arithmeticRoot.typeOrigin => arithmeticBinding!.typeOrigin
                                arithmeticRoot.typeModule => arithmeticBinding!.typeModule
                                arithmeticRoot.typeSymbol => arithmeticBinding!.typeSymbol
                                arithmeticRoot.typeFlags => arithmeticBinding!.typeFlags
                                arithmeticBinding! => nodes[arithmeticBindingIndex!]
                            }
                    }
            }
        arithmeticBindingIndex! + 1 => arithmeticBindingIndex!
    }
    0 => arithmeticReadIndex!
    arithmeticReadIndex! < (nodes -> len) -> while {
        nodes[arithmeticReadIndex!] => arithmeticRead!
        arithmeticRead!.kind == 5
            and arithmeticRead!.operand0 >= 0
            and arithmeticRead!.operand0 < (nodes -> len)
            and nodes[arithmeticRead!.operand0].kind == 17
            and nodes[arithmeticRead!.operand0].sourceModule >= 0
            and nodes[arithmeticRead!.operand0].sourceModule < (prepared.package.ranges -> len)
            and nodes[arithmeticRead!.operand0].symbol >= 0
            -> if {
                nodes[arithmeticRead!.operand0] => arithmeticReadBinding
                prepared.package.ranges[arithmeticReadBinding.sourceModule] => arithmeticReadRange
                arithmeticReadBinding.symbol < arithmeticReadRange.symbolCount
                    -> if {
                        arithmeticReadRange.symbolStart + arithmeticReadBinding.symbol => arithmeticReadGlobalSymbol
                        arithmeticRootBySymbol![arithmeticReadGlobalSymbol] >= 0
                            -> if {
                                arithmeticReadBinding.typeId => arithmeticRead!.typeId
                                arithmeticReadBinding.typeKind => arithmeticRead!.typeKind
                                arithmeticReadBinding.typeOrigin => arithmeticRead!.typeOrigin
                                arithmeticReadBinding.typeModule => arithmeticRead!.typeModule
                                arithmeticReadBinding.typeSymbol => arithmeticRead!.typeSymbol
                                arithmeticReadBinding.typeFlags => arithmeticRead!.typeFlags
                                arithmeticRead! => nodes[arithmeticReadIndex!]
                            }
                    }
            }
        arithmeticReadIndex! + 1 => arithmeticReadIndex!
    }
}
