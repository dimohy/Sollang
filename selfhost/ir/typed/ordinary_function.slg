                                }
                            }
                        }
                    bindingNodePosition! + 1 => bindingNodePosition!
                }
                results! -> lowerOrdinaryFunctionExpressions(astToIr!, resolvedNames!, resolvedSymbolByAst!, resolvedQualifiedByAst!, qualifiedFunctionPathByAst!, qualifiedValueVariantIndexByAst!, localMemberByParentAst, prepared, recursiveTypes, inferred, frozenRecursiveSemanticTypes, recursiveTypeFlags, frozenFunctionNodeIndices, frozenInferredIndexByAst, frozenNearestLegacyIndexByAst, frozenRecursiveTypeByAst, sourceIndex, symbolIndex, functionIr, resultRootAst!, returnIr, functionResultTypeId!, functionNodeStart, functionNodeEnd, parameterSymbol!, parameterTypeId!)

                results! -> finalizeOrdinaryFunctionExpressions(astToIr!, resolvedNames!, prepared, frozenRecursiveSemanticTypes, recursiveTypeFlags, sourceIndex, symbolIndex, functionIr, expressionIrStart, resultRootAst!, returnIr, functionResultOrigin!, functionResultModule!, functionResultSymbol!, functionResultTypeId!)
            }
    }
    results! -> sourceTypedIr
}
