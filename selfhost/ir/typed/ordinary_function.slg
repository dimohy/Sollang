                                                    }
                                                }
                                        }
                                    }
                                bindingSymbol! >= 0 -> if {
                                    prepared.package.symbols[sourceRange.symbolStart + bindingSymbol!] => declaredBindingSymbol
                                    -1 => bindingDeclaredReferenceIndex!
                                    declaredBindingSymbol.typeNode >= 0 and declaredBindingSymbol.typeNode < sourceRange.astCount
                                        -> if { recursiveTypes.referenceIndexByTypeAst[sourceRange.astStart + declaredBindingSymbol.typeNode] => bindingDeclaredReferenceIndex! }
                                    bindingDeclaredReferenceIndex! >= 0
                                        -> if { recursiveTypes.references[bindingDeclaredReferenceIndex!].typeId => bindingCanonicalTypeId! }
                                }
                                bindingSymbol! >= 0 -> if {
                                    -1 => bindingOrigin!
                                    -1 => bindingModule!
                                    -1 => bindingSymbolType!
                                    -1 => bindingTypeKind!
                                    0 => bindingTypeFlags!
                                    bindingTypeIndex! >= 0 -> if {
                                        inferred[bindingTypeIndex!] => bindingType
                                        bindingType.origin => bindingOrigin!
                                        bindingType.targetModule => bindingModule!
                                        bindingType.targetSymbol => bindingSymbolType!
                                    }
                                    bindingCanonicalTypeId! >= 0 -> if {
                                        frozenRecursiveSemanticTypes[bindingCanonicalTypeId!] => bindingCanonicalType
                                        bindingCanonicalType.origin => bindingOrigin!
                                        bindingCanonicalType.module => bindingModule!
                                        bindingCanonicalType.symbol => bindingSymbolType!
                                        bindingCanonicalType.kind => bindingTypeKind!
                                        recursiveTypeFlags[bindingCanonicalTypeId!] => bindingTypeFlags!
                                        (bindingCanonicalType.kind >= 2 and bindingCanonicalType.kind <= 6) or bindingCanonicalType.kind == 8
                                            -> if { 10 + bindingCanonicalType.kind => bindingOrigin! }
                                        bindingCanonicalType.kind == 2 or bindingCanonicalType.kind == 3 or bindingCanonicalType.kind == 4 or bindingCanonicalType.kind == 6 or bindingCanonicalType.kind == 8
                                            -> if {
                                                bindingCanonicalType.first >= 0 -> if {
                                                    frozenRecursiveSemanticTypes[bindingCanonicalType.first].module => bindingModule!
                                                    frozenRecursiveSemanticTypes[bindingCanonicalType.first].symbol => bindingSymbolType!
                                                }
                                            }
                                        bindingCanonicalType.kind == 5 -> if {
                                            bindingCanonicalType.first >= 0 -> if { frozenRecursiveSemanticTypes[bindingCanonicalType.first].symbol => bindingModule! }
                                            bindingCanonicalType.second >= 0 -> if { frozenRecursiveSemanticTypes[bindingCanonicalType.second].symbol => bindingSymbolType! }
                                        }
                                    }
                                    bindingOrigin! == 13 and bindingSymbol! >= 0
                                        -> if {
                                            prepared.package.symbols[sourceRange.symbolStart + bindingSymbol!] => declaredBinding
                                            0 => declaredBindingTypeSearch!
                                            declaredBindingTypeSearch! < (prepared.nominal -> len)
                                                -> while {
                                                    prepared.nominal[declaredBindingTypeSearch!] => declaredBindingType
                                                    declaredBindingType.sourceModule == sourceIndex and declaredBindingType.typeAst == declaredBinding.typeNode and declaredBindingType.status == 0
                                                        -> if {
                                                            declaredBindingType.targetModule => bindingModule!
                                                            declaredBindingType.targetSymbol => bindingSymbolType!
