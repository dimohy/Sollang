                    astNode: resultTypeAstNode!
                    symbol: symbolIndex
                    targetModule: -1
                    typeOrigin: functionResultOrigin!
                    typeModule: functionResultModule!
                    typeSymbol: functionResultSymbol!
                    typeId: functionResultTypeId!
                    typeKind: functionResultTypeKind!
                    typeFlags: functionResultTypeFlags!
                    payloadToken: -1
                    opcode: -1
                    operand0: -1
                    operand1: -1
                    nextOperand: -1
                    flags: 0
                })
                parameterIr! >= 0 -> if {
                    prepared.package.symbols[sourceRange.symbolStart + parameterSymbol!] => parameter
                    results! -> push(TypedIrNode {
                        kind: 10
                        parent: functionIr
                        sourceModule: sourceIndex
                        astNode: parameter.astNode
                        symbol: parameterSymbol!
                        targetModule: sourceIndex
                        typeOrigin: parameterOrigin!
                        typeModule: parameterModule!
                        typeSymbol: parameterTypeSymbol!
                        typeId: parameterTypeId!
                        typeKind: -1
                        typeFlags: 0
                        payloadToken: parameter.nameToken
                        opcode: -1
                        operand0: -1
                        operand1: -1
                        nextOperand: -1
                        flags: parameter.flags
                    })
                }
                -1 => firstAdditionalParameterIr!
                -1 => previousAdditionalParameterIr!
                0 => additionalParameterSearch!
                additionalParameterSearch! < sourceRange.symbolCount
                    -> while {
                        prepared.package.symbols[sourceRange.symbolStart + additionalParameterSearch!] => additionalParameter
                        additionalParameter.kind == 35 and additionalParameter.parent == symbolIndex and additionalParameter.astNode != function.astNode
                            -> if {
                                -1 => additionalParameterTypeId!
                                -1 => additionalParameterReferenceIndex!
                                additionalParameter.typeNode >= 0 and additionalParameter.typeNode < sourceRange.astCount
                                    -> if { recursiveTypes.referenceIndexByTypeAst[sourceRange.astStart + additionalParameter.typeNode] => additionalParameterReferenceIndex! }
                                additionalParameterReferenceIndex! >= 0 and recursiveTypes.references[additionalParameterReferenceIndex!].status == 0
                                    -> if { recursiveTypes.references[additionalParameterReferenceIndex!].typeId => additionalParameterTypeId! }
                                -1 => additionalParameterOrigin!
                                -1 => additionalParameterModule!
                                -1 => additionalParameterTypeSymbol!
                                -1 => additionalParameterTypeKind!
                                0 => additionalParameterTypeFlags!
                                additionalParameterTypeId! >= 0 -> if {
                                    frozenRecursiveSemanticTypes[additionalParameterTypeId!] => additionalParameterType
                                    additionalParameterType.origin => additionalParameterOrigin!
                                    additionalParameterType.module => additionalParameterModule!
                                    additionalParameterType.symbol => additionalParameterTypeSymbol!
                                    additionalParameterType.kind => additionalParameterTypeKind!
                                    recursiveTypeFlags[additionalParameterTypeId!] => additionalParameterTypeFlags!
                                    additionalParameterType.kind != 1 -> if {
                                        10 + additionalParameterType.kind => additionalParameterOrigin!
                                        additionalParameterType.first >= 0 -> if {
                                            frozenRecursiveSemanticTypes[additionalParameterType.first] => additionalParameterElement
                                            additionalParameterElement.module => additionalParameterModule!
                                            additionalParameterElement.symbol => additionalParameterTypeSymbol!
                                        }
                                    }
                                }
                                additionalParameterOrigin! < 0 -> if {
                                    0 => additionalParameterNominalSearch!
                                    additionalParameterNominalSearch! < (prepared.nominal -> len)
                                        -> while {
                                            prepared.nominal[additionalParameterNominalSearch!] => additionalParameterNominal
                                            additionalParameterNominal.sourceModule == sourceIndex and additionalParameterNominal.typeAst == additionalParameter.typeNode
                                                -> if {
                                                    additionalParameterNominal.origin => additionalParameterOrigin!
                                                    additionalParameterNominal.targetModule => additionalParameterModule!
                                                    additionalParameterNominal.targetSymbol => additionalParameterTypeSymbol!
                                                }
                                            additionalParameterNominalSearch! + 1 => additionalParameterNominalSearch!
                                        }
                                }
                                additionalParameterOrigin! < 0 -> if {
                                    0 => additionalParameterCompositeSearch!
                                    additionalParameterCompositeSearch! < (prepared.composite -> len)
                                        -> while {
                                            prepared.composite[additionalParameterCompositeSearch!] => additionalParameterComposite
                                            additionalParameterComposite.sourceModule == sourceIndex and additionalParameterComposite.typeAst == additionalParameter.typeNode
                                                -> if {
                                                    10 + additionalParameterComposite.kind => additionalParameterOrigin!
                                                    additionalParameterComposite.elementModule => additionalParameterModule!
                                                    additionalParameterComposite.elementSymbol => additionalParameterTypeSymbol!
                                                }
                                            additionalParameterCompositeSearch! + 1 => additionalParameterCompositeSearch!
                                        }
                                }
                                results! -> len => additionalParameterIr
                                firstAdditionalParameterIr! < 0 -> if { additionalParameterIr => firstAdditionalParameterIr! }
                                previousAdditionalParameterIr! >= 0 -> if {
                                    results![previousAdditionalParameterIr!] => previousAdditionalParameter!
                                    additionalParameterIr => previousAdditionalParameter!.nextOperand
                                    previousAdditionalParameter! => results![previousAdditionalParameterIr!]
                                }
                                results! -> push(TypedIrNode {
                                    kind: 10
                                    parent: functionIr
                                    sourceModule: sourceIndex
                                    astNode: additionalParameter.astNode
                                    symbol: additionalParameterSearch!
                                    targetModule: sourceIndex
                                    typeOrigin: additionalParameterOrigin!
                                    typeModule: additionalParameterModule!
                                    typeSymbol: additionalParameterTypeSymbol!
                                    typeId: additionalParameterTypeId!
                                    typeKind: additionalParameterTypeKind!
                                    typeFlags: additionalParameterTypeFlags!
                                    payloadToken: additionalParameter.nameToken
                                    opcode: -1
                                    operand0: -1
                                    operand1: -1
                                    nextOperand: -1
                                    flags: additionalParameter.flags
                                })
                                additionalParameterIr => previousAdditionalParameterIr!
                            }
                        additionalParameterSearch! + 1 => additionalParameterSearch!
                    }
                # A compile-time value generic is a value in the function body
                # but not a source-level runtime parameter. Lower it as a
                # hidden trailing Int parameter so one generic body can serve
                # every numeric instantiation without source rewriting.
                0 => valueGenericSearch!
                valueGenericSearch! < sourceRange.symbolCount
                    -> while {
                        prepared.package.symbols[sourceRange.symbolStart + valueGenericSearch!] => valueGeneric
                        false => valueGenericUsed!
                        valueGeneric.kind == 32 and valueGeneric.parent == symbolIndex
                            -> if {
                                0 => valueGenericReferenceSearch!
                                valueGenericReferenceSearch! < (resolvedNames! -> len)
                                    -> while {
                                        resolvedNames![valueGenericReferenceSearch!] => valueGenericReference
                                        valueGenericReference.symbol == valueGenericSearch!
                                            and prepared.package.nodes[sourceRange.astStart + valueGenericReference.astNode].kind == 15
                                            -> if {
                                                true => valueGenericUsed!
                                            }
                                        valueGenericReferenceSearch! + 1 => valueGenericReferenceSearch!
                                    }
                            }
                        valueGenericUsed! -> if {
                            -1 => valueGenericIntTypeId!
                            0 => valueGenericIntTypeSearch!
                            valueGenericIntTypeSearch! < (frozenRecursiveSemanticTypes -> len) and valueGenericIntTypeId! < 0
                                -> while {
                                    frozenRecursiveSemanticTypes[valueGenericIntTypeSearch!] => valueGenericIntType
                                    valueGenericIntType.kind == 1 and valueGenericIntType.origin == 1 and valueGenericIntType.symbol == 2
                                        -> if {
                                            valueGenericIntTypeSearch! => valueGenericIntTypeId!
                                        }
                                    valueGenericIntTypeSearch! + 1 => valueGenericIntTypeSearch!
                                }
                            results! -> len => valueGenericIr
                            firstAdditionalParameterIr! < 0 -> if { valueGenericIr => firstAdditionalParameterIr! }
                            previousAdditionalParameterIr! >= 0 -> if {
                                results![previousAdditionalParameterIr!] => previousValueGenericParameter!
                                valueGenericIr => previousValueGenericParameter!.nextOperand
                                previousValueGenericParameter! => results![previousAdditionalParameterIr!]
                            }
                            results! -> push(TypedIrNode {
                                kind: 10
                                parent: functionIr
                                sourceModule: sourceIndex
                                astNode: valueGeneric.astNode
                                symbol: valueGenericSearch!
                                targetModule: sourceIndex
                                typeOrigin: 1
                                typeModule: -1
                                typeSymbol: 2
                                typeId: valueGenericIntTypeId!
                                typeKind: 1
                                typeFlags: 0
                                payloadToken: valueGeneric.nameToken
                                opcode: -1
                                operand0: -1
                                operand1: -1
                                nextOperand: -1
                                flags: 0
                            })
                            valueGenericIr => previousAdditionalParameterIr!
                        }
                        valueGenericSearch! + 1 => valueGenericSearch!
                    }
                firstAdditionalParameterIr! >= 0 -> if {
                    results![functionIr] => parameterizedFunction!
                    firstAdditionalParameterIr! => parameterizedFunction!.nextOperand
                    parameterizedFunction! => results![functionIr]
                }

                [Int; ~] => astToIr!
                0 => astMapIndex!
                astMapIndex! < sourceRange.astCount -> while {
                    astToIr! -> push(-1)
                    astMapIndex! + 1 => astMapIndex!
                }
                results! -> len => expressionIrStart
                sourceRange.astStart + function.astNode => functionGlobalAst
                frozenFunctionNodeStartsByAst[functionGlobalAst] => functionNodeStart
                functionNodeStart + frozenFunctionNodeCountsByAst[functionGlobalAst] => functionNodeEnd
                functionNodeStart => bindingNodePosition!
                bindingNodePosition! < functionNodeEnd -> while {
                    frozenFunctionNodeIndices[bindingNodePosition!] => bindingAstIndex
                    prepared.package.nodes[sourceRange.astStart + bindingAstIndex] => bindingAst
                    bindingAst.kind == 9 or bindingAst.kind == 61 or (bindingAst.kind == 48 and bindingAst.secondaryToken >= 0)
                        -> if {
                            true => bindingBelongsToFunction
                            bindingBelongsToFunction -> if {
                                -1 => bindingTypeIndex!
                                frozenNearestLegacyIndexByAst[sourceRange.astStart + bindingAstIndex] => bindingTypeIndex!
                                frozenNearestCanonicalTypeByAst[sourceRange.astStart + bindingAstIndex] => bindingCanonicalTypeId!
                                bindingCanonicalTypeId! < 0 -> if {
                                    0 => bindingValueTypeSearch!
                                    bindingValueTypeSearch! < sourceRange.astCount and bindingCanonicalTypeId! < 0
                                        -> while {
                                            prepared.package.nodes[sourceRange.astStart + bindingValueTypeSearch!] => bindingValueTypeAst
                                            bindingValueTypeAst.parent == bindingAstIndex
                                                and bindingValueTypeAst.start == bindingAst.start
                                                -> if {
                                                    frozenRecursiveTypeByAst[sourceRange.astStart + bindingValueTypeSearch!] => bindingValueTypeId
                                                    bindingValueTypeId >= 0 -> if { bindingValueTypeId => bindingCanonicalTypeId! }
