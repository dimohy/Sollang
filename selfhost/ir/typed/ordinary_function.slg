                                        }
                                }
                                # `source -> yield => accepted` binds the result of
                                # the caller-supplied block. A flow binding owns the
                                # yield AST as its value child, while direct role
                                # invocation uses the role-call AST itself. Both
                                # operations are Unit-valued at the call site, so
                                # the declared block-result type is authoritative
                                # for the response binding.
                                (bindingAst.kind == 48 and bindingAst.secondaryToken >= 0) => bindingUsesBlockResult!
                                bindingAst.kind == 9 or bindingAst.kind == 61
                                    -> if {
                                        0 => bindingYieldSearch!
                                        bindingYieldSearch! < sourceRange.astCount and not bindingUsesBlockResult!
                                            -> while {
                                                prepared.package.nodes[sourceRange.astStart + bindingYieldSearch!] => bindingYieldCandidate
                                                bindingYieldCandidate.parent == bindingAstIndex and bindingYieldCandidate.kind == 10
                                                    -> if {
                                                        source -> flowIntrinsicOpcode(
                                                        prepared.package.tokens,
                                                        sourceRange.tokenStart,
                                                        bindingYieldCandidate
                                                        ) => bindingYieldOpcode
                                                        bindingYieldOpcode == -227 -> if { true => bindingUsesBlockResult! }
                                                    }
                                                bindingYieldSearch! + 1 => bindingYieldSearch!
                                            }
                                    }
                                bindingUsesBlockResult! and function.blockResultTypeNode >= 0
                                    -> if {
                                        -1 => roleResultReferenceIndex!
                                        function.blockResultTypeNode < sourceRange.astCount
                                            -> if { recursiveTypes.referenceIndexByTypeAst[sourceRange.astStart + function.blockResultTypeNode] => roleResultReferenceIndex! }
                                        roleResultReferenceIndex! >= 0
                                            and recursiveTypes.references[roleResultReferenceIndex!].status == 0
                                            and recursiveTypes.references[roleResultReferenceIndex!].typeId >= 0
                                            -> if { recursiveTypes.references[roleResultReferenceIndex!].typeId => bindingCanonicalTypeId! }
                                    }
                                -1 => bindingSymbol!
                                0 => bindingSymbolSearch!
                                bindingSymbolSearch! < sourceRange.symbolCount
                                    -> while {
                                        (prepared.package.symbols[sourceRange.symbolStart + bindingSymbolSearch!].kind == 9 or prepared.package.symbols[sourceRange.symbolStart + bindingSymbolSearch!].kind == 61) and prepared.package.symbols[sourceRange.symbolStart + bindingSymbolSearch!].astNode == bindingAstIndex
                                            -> if { bindingSymbolSearch! => bindingSymbol! }
                                        bindingSymbolSearch! + 1 => bindingSymbolSearch!
                                    }
                                # A mutable rebind inside a stream callback refers
                                # to the existing outer slot. Its callback-local
                                # symbol can have no standalone inferred type, so
                                # recover canonical identity from the nearest prior
                                # binding with the same source name.
                                bindingAst.flags == 1 and bindingAst.payloadToken >= 0
                                    -> if {
                                        prepared.package.tokens[sourceRange.tokenStart + bindingAst.payloadToken] => mutableBindingName
                                        results! -> len => previousBindingSearch!
                                        previousBindingSearch! > 0 -> while {
                                            previousBindingSearch! - 1 => previousBindingSearch!
                                            results![previousBindingSearch!] => previousBinding
                                            previousBinding.kind == 17 and previousBinding.flags == 1 and previousBinding.sourceModule == sourceIndex and previousBinding.payloadToken >= 0
                                                -> if {
                                                    prepared.package.tokens[sourceRange.tokenStart + previousBinding.payloadToken] => previousBindingName
                                                    mutableBindingName.span.length == previousBindingName.span.length => previousBindingEqual!
                                                    UIntSize(0) => previousBindingByte!
                                                    previousBindingEqual! and previousBindingByte! < mutableBindingName.span.length
                                                        -> while {
                                                            (source -> byte(mutableBindingName.span.start + previousBindingByte!)) != (source -> byte(previousBindingName.span.start + previousBindingByte!))
                                                                -> if { false => previousBindingEqual! }
                                                            previousBindingByte! + 1 => previousBindingByte!
                                                        }
                                                    previousBindingEqual! -> if {
                                                        previousBinding.symbol => bindingSymbol!
                                                        previousBinding.typeId => bindingCanonicalTypeId!
