# Normalize the completed ordinary-function IR through borrowed tables only.
finalizeOrdinaryFunctionExpressions nodes: mut [TypedIrNode; ~], astToIr: mut [Int; ~], resolvedNames: ref [resolution.ResolvedName; ~], prepared: ref semanticContext.SemanticSnapshot, frozenRecursiveSemanticTypes: ref [typeIds.SemanticType; ~], recursiveTypeFlags: ref [Int; ~], sourceIndex: Int, functionSymbolIndex: Int, functionIr: Int, expressionIrStart: Int, resultRootAst: Int, returnIr: Int, functionResultOrigin: Int, functionResultModule: Int, functionResultSymbol: Int, functionResultTypeId: Int -> Unit {
    nodes -> finalizeOrdinaryStructure(astToIr, resolvedNames, prepared, frozenRecursiveSemanticTypes, recursiveTypeFlags, sourceIndex, functionSymbolIndex, functionIr, expressionIrStart, resultRootAst, returnIr, functionResultOrigin, functionResultModule, functionResultSymbol, functionResultTypeId)
    nodes -> finalizeOrdinaryCanonicalCalls(astToIr, resolvedNames, prepared, frozenRecursiveSemanticTypes, recursiveTypeFlags, sourceIndex, functionSymbolIndex, functionIr, expressionIrStart, resultRootAst, returnIr, functionResultOrigin, functionResultModule, functionResultSymbol, functionResultTypeId)
    nodes -> finalizeOrdinaryControls(astToIr, resolvedNames, prepared, frozenRecursiveSemanticTypes, recursiveTypeFlags, sourceIndex, functionSymbolIndex, functionIr, expressionIrStart, resultRootAst, returnIr, functionResultOrigin, functionResultModule, functionResultSymbol, functionResultTypeId)
    nodes -> finalizeOrdinaryBindings(astToIr, resolvedNames, prepared, frozenRecursiveSemanticTypes, recursiveTypeFlags, sourceIndex, functionSymbolIndex, functionIr, expressionIrStart, resultRootAst, returnIr, functionResultOrigin, functionResultModule, functionResultSymbol, functionResultTypeId)
    nodes -> finalizeOrdinaryReturn(astToIr, resolvedNames, prepared, frozenRecursiveSemanticTypes, recursiveTypeFlags, sourceIndex, functionSymbolIndex, functionIr, expressionIrStart, resultRootAst, returnIr, functionResultOrigin, functionResultModule, functionResultSymbol, functionResultTypeId)
}
