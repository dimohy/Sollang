namespace sollang.compiler.ir.stream

import sollang.compiler.ir.typed as typed
import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.expression_type_ids as expressionTypeIds
import syntax.generated.slg as grammar

# Stream lowering keeps a separate continuation plan instead of pretending that
# every pipeline stage is an ordinary eager call. The plan is flat and
# index-based so native and browser backends consume the same representation.
public struct StreamStage {
    callIr: Int
    callAst: Int
    targetModule: Int
    targetSymbol: Int
    source0: Int
    source1: Int
    argument0: Int
    argument1: Int
    callbackStart: Int
    callbackEnd: Int
    callbackRoot: Int
    roleToken: Int
    flags: Int
    rangeFlags: Int
}

public struct StreamPipeline {
    terminalIr: Int
    source0: Int
    source1: Int
    stageStart: Int
    stageCount: Int
    callbackStart: Int
    callbackEnd: Int
    callbackRoot: Int
    roleToken: Int
    status: Int
    flags: Int
}

public struct StreamJunctionInput {
    valueIr: Int
    typeId: Int
    ordinal: Int
}

public struct StreamPartitionRoute {
    routeIr: Int
    predicateIr: Int
    ordinal: Int
    terminalIr: Int
    pipelineIndex: Int
}

public struct StreamJunction {
    junctionIr: Int
    kind: Int
    policy: Int
    source0: Int
    inputStart: Int
    inputCount: Int
    routeStart: Int
    routeCount: Int
    status: Int
}

public struct StreamPlan {
    pipelines: [StreamPipeline; ~]
    stages: [StreamStage; ~]
    junctions: [StreamJunction; ~]
    junctionInputs: [StreamJunctionInput; ~]
    partitionRoutes: [StreamPartitionRoute; ~]
}

struct StageParts {
    source0: Int
    source1: Int
    argument0: Int
    argument1: Int
    callbackStart: Int
    callbackEnd: Int
    callbackRoot: Int
    roleToken: Int
}

isStreamFunction node: typed.TypedIrNode, prepared: semanticContext.SemanticSnapshot -> Bool {
    false => result!
    (node.kind == 6 and node.targetModule >= 0 and node.targetModule < (prepared.package.ranges -> len) and node.symbol >= 0) -> if {
        prepared.package.ranges[node.targetModule] => targetRange
        node.symbol < targetRange.symbolCount -> if {
            prepared.package.symbols[targetRange.symbolStart + node.symbol] => target
            (target.kind == 7 and (target.flags / 64) % 2 == 1) -> if {
                true => result!
            }
        }
    }
    result!
}

streamSliceKind node: typed.TypedIrNode, prepared: semanticContext.SemanticSnapshot -> Int {
    0 => kind!
    (node.kind == 6 and node.sourceModule >= 0 and node.sourceModule < (prepared.package.ranges -> len) and node.astNode >= 0) -> if {
        prepared.package.ranges[node.sourceModule] => sourceRange
        node.astNode < sourceRange.astCount -> if {
            prepared.package.nodes[sourceRange.astStart + node.astNode] => callAst
            (callAst.kind == 48 and callAst.payloadToken >= 0) -> if {
                prepared.package.tokens[sourceRange.tokenStart + callAst.payloadToken] => target
                target.span.length == 4 -> if {
                    ((prepared.package.sources[node.sourceModule] -> byte(target.span.start)) == 116 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 1)) == 97 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 2)) == 107 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 3)) == 101) -> if {
                        1 => kind!
                    }
                    ((prepared.package.sources[node.sourceModule] -> byte(target.span.start)) == 115 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 1)) == 107 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 2)) == 105 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 3)) == 112) -> if {
                        2 => kind!
                    }
                }
                target.span.length == 7 -> if {
                    ((prepared.package.sources[node.sourceModule] -> byte(target.span.start)) == 102 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 1)) == 108 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 2)) == 97 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 3)) == 116 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 4)) == 77 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 5)) == 97 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 6)) == 112) -> if {
                        3 => kind!
                    }
                }
                target.span.length == 10 -> if {
                    ((prepared.package.sources[node.sourceModule] -> byte(target.span.start)) == 98 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 1)) == 101 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 2)) == 102 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 3)) == 111 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 4)) == 114 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 5)) == 101 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 6)) == 69 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 7)) == 97 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 8)) == 99 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 9)) == 104) -> if {
                        4 => kind!
                    }
                }
                target.span.length == 9 -> if {
                    ((prepared.package.sources[node.sourceModule] -> byte(target.span.start)) == 97 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 1)) == 102 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 2)) == 116 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 3)) == 101 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 4)) == 114 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 5)) == 69 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 6)) == 97 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 7)) == 99 and (prepared.package.sources[node.sourceModule] -> byte(target.span.start + 8)) == 104) -> if {
                        5 => kind!
                    }
                }
            }
        }
    }
    kind!
}

isStreamStage node: typed.TypedIrNode, prepared: semanticContext.SemanticSnapshot -> Bool {
    (node -> isStreamFunction(prepared)) or ((node -> streamSliceKind(prepared)) > 0)
}

isRuntimeProducer node: typed.TypedIrNode, resolved: ref expressionTypeIds.ExpressionTypeIdSet -> Bool {
    false => producer!
    (node.typeId >= 0 and node.typeId < (resolved.types -> len)) -> if {
        resolved.types[node.typeId] => valueType
        (valueType.kind == 7 and valueType.origin == 4 and (valueType.symbol == 3 or valueType.symbol == 4)) -> if { true => producer! }
    }
    producer!
}

stageParts prepared: semanticContext.SemanticSnapshot, ir: [typed.TypedIrNode; ~], callIndex: Int -> StageParts {
    ir[callIndex] => call
    prepared.package.ranges[call.sourceModule] => sourceRange
    prepared.package.nodes[sourceRange.astStart + call.astNode] => callAst
    prepared.package.tokens[sourceRange.tokenStart + callAst.payloadToken] => targetToken
    callAst.start + callAst.length => bodyStart!
    false => hasBody!
    callAst.firstToken => tokenIndex!
    callAst.firstToken + callAst.tokenCount => tokenEnd
    tokenIndex! < tokenEnd -> while {
        prepared.package.tokens[sourceRange.tokenStart + tokenIndex!] => token
        (not hasBody! and token.kind == grammar.tokenIdLeftBrace() and token.span.start > targetToken.span.start) -> if {
            token.span.start => bodyStart!
            true => hasBody!
        }
        tokenIndex! + 1 => tokenIndex!
    }

    -1 => source0!
    -1 => source1!
    -1 => argument0!
    -1 => argument1!
    -1 => callbackStart!
    -1 => callbackEnd!
    -1 => callbackRoot!
    UIntSize(0) => source0Start!
    UIntSize(0) => source1Start!
    UIntSize(0) => argument0Start!
    UIntSize(0) => argument1Start!
    UIntSize(0) => callbackRootStart!
    0 => childIndex!
    childIndex! < (ir -> len) -> while {
        ir[childIndex!] => child
        (hasBody! and child.sourceModule == call.sourceModule and child.astNode >= 0 and child.astNode < sourceRange.astCount) -> if {
            prepared.package.nodes[sourceRange.astStart + child.astNode] => bodyCandidateAst
            (bodyCandidateAst.start > bodyStart! and bodyCandidateAst.start < callAst.start + callAst.length) -> if {
                bodyCandidateAst.parent => bodyAncestor!
                false => bodyBelongs!
                (bodyAncestor! >= 0 and not bodyBelongs!) -> while {
                    bodyAncestor! == call.astNode -> if {
                        true => bodyBelongs!
                    } else {
                        prepared.package.nodes[sourceRange.astStart + bodyAncestor!].parent => bodyAncestor!
                    }
                }
                bodyBelongs! -> if {
                    (callbackStart! < 0 or Int(childIndex!) < callbackStart!) -> if { Int(childIndex!) => callbackStart! }
                    (callbackEnd! < 0 or Int(childIndex!) > callbackEnd!) -> if { Int(childIndex!) => callbackEnd! }
                }
            }
        }
        (child.parent == callIndex and child.sourceModule == call.sourceModule and child.astNode >= 0 and child.astNode < sourceRange.astCount) -> if {
            prepared.package.nodes[sourceRange.astStart + child.astNode] => childAst
            childAst.start < targetToken.span.start -> if {
                (source0! < 0 or childAst.start < source0Start!) -> if {
                    source0! => source1!
                    source0Start! => source1Start!
                    childIndex! => source0!
                    childAst.start => source0Start!
                } else {
                    (source1! < 0 or childAst.start < source1Start!) -> if {
                        childIndex! => source1!
                        childAst.start => source1Start!
                    }
                }
            } else {
                (hasBody! and childAst.start > bodyStart!) -> if {
                    (callbackRoot! < 0 or childAst.start > callbackRootStart!) -> if {
                        childIndex! => callbackRoot!
                        childAst.start => callbackRootStart!
                    }
                } else {
                    childAst.start > targetToken.span.start -> if {
                        (argument0! < 0 or childAst.start < argument0Start!) -> if {
                            argument0! => argument1!
                            argument0Start! => argument1Start!
                            childIndex! => argument0!
                            childAst.start => argument0Start!
                        } else {
                            (argument1! < 0 or childAst.start < argument1Start!) -> if {
                                childIndex! => argument1!
                                childAst.start => argument1Start!
                            }
                        }
                    }
                }
            }
        }
        childIndex! + 1 => childIndex!
    }
    StageParts {
        source0: source0!
        source1: source1!
        argument0: argument0!
        argument1: argument1!
        callbackStart: callbackStart!
        callbackEnd: callbackEnd!
        callbackRoot: callbackRoot!
        roleToken: callAst.tertiaryToken
    }
}

public build prepared: semanticContext.SemanticSnapshot, ir: [typed.TypedIrNode; ~], resolved: ref expressionTypeIds.ExpressionTypeIdSet -> StreamPlan {
    [StreamPipeline; ~] => pipelines!
    [StreamStage; ~] => stages!
    [StreamJunction; ~] => junctions!
    [StreamJunctionInput; ~] => junctionInputs!
    [StreamPartitionRoute; ~] => partitionRoutes!
    0 => junctionIndex!
    junctionIndex! < (ir -> len) -> while {
        ir[junctionIndex!] => junctionNode
        junctionNode.kind == 40 -> if {
            partitionRoutes! -> len => partitionRouteStart
            0 => partitionRouteCount!
            junctionNode.operand1 => partitionRouteIr!
            partitionRouteIr! >= 0 -> while {
                ir[partitionRouteIr!] => partitionRoute
                partitionRoutes! -> push(StreamPartitionRoute {
                    routeIr: partitionRouteIr!
                    predicateIr: partitionRoute.operand0
                    ordinal: partitionRoute.opcode
                    terminalIr: -1
                    pipelineIndex: -1
                })
                partitionRouteCount! + 1 => partitionRouteCount!
                partitionRoute.nextOperand => partitionRouteIr!
            }
            0 => partitionStatus!
            (junctionNode.typeId >= 0 and junctionNode.typeId < (resolved.types -> len)) -> if {
                resolved.types[junctionNode.typeId] => partitionProductType
                partitionProductType.kind == 10 -> if {
                    0 => partitionFieldSearch!
                    partitionFieldSearch! < (resolved.fields -> len) -> while {
                        resolved.fields[partitionFieldSearch!] => partitionField
                        (partitionField.ownerType == junctionNode.typeId and partitionField.fieldType >= 0 and partitionField.fieldType < (resolved.types -> len)) -> if {
                            resolved.types[partitionField.fieldType] => partitionRouteType
                            partitionRouteType.symbol == 3 -> if { 1 => partitionStatus! }
                            partitionRouteType.symbol == 4 -> if { 2 => partitionStatus! }
                        }
                        partitionFieldSearch! + 1 => partitionFieldSearch!
                    }
                }
            }
            junctions! -> push(StreamJunction {
                junctionIr: junctionIndex!
                kind: 1
                policy: -1
                source0: junctionNode.operand0
                inputStart: -1
                inputCount: 0
                routeStart: Int(partitionRouteStart)
                routeCount: partitionRouteCount!
                status: partitionStatus!
            })
        }
        junctionNode.kind == 43 -> if {
            junctionInputs! -> len => joinInputStart
            0 => joinInputCount!
            (junctionNode.operand0 >= 0 and junctionNode.operand0 < (ir -> len)) -> if {
                ir[junctionNode.operand0].operand0 => joinInputIr!
                joinInputIr! >= 0 -> while {
                    ir[joinInputIr!] => joinInput
                    junctionInputs! -> push(StreamJunctionInput {
                        valueIr: joinInputIr!
                        typeId: joinInput.typeId
                        ordinal: joinInputCount!
                    })
                    joinInputCount! + 1 => joinInputCount!
                    joinInput.nextOperand => joinInputIr!
                }
            }
            0 => joinStatus!
            (junctionNode.typeId >= 0 and junctionNode.typeId < (resolved.types -> len)) -> if {
                resolved.types[junctionNode.typeId] => joinOutputType
                joinOutputType.symbol == 3 -> if { 1 => joinStatus! }
                joinOutputType.symbol == 4 -> if { 2 => joinStatus! }
            }
            junctions! -> push(StreamJunction {
                junctionIr: junctionIndex!
                kind: 2
                policy: junctionNode.opcode
                source0: junctionNode.operand0
                inputStart: Int(joinInputStart)
                inputCount: joinInputCount!
                routeStart: -1
                routeCount: 0
                status: joinStatus!
            })
        }
        junctionIndex! + 1 => junctionIndex!
    }
    0 => terminalIndex!
    terminalIndex! < (ir -> len) -> while {
        ir[terminalIndex!] => terminal
        (terminal.kind == 6 and terminal.opcode == -208 and terminal.operand0 >= 0 and ((ir[terminal.operand0] -> isStreamStage(prepared)) or (ir[terminal.operand0] -> isRuntimeProducer(resolved)))) -> if {
            [Int; ~] => reverseCalls!
            terminal.operand0 => stageIndex!
            (stageIndex! >= 0 and (ir[stageIndex!] -> isStreamStage(prepared))) -> while {
                reverseCalls! -> push(stageIndex!)
                ir[stageIndex!].operand0 => stageIndex!
            }
            stages! -> len => stageStart
            0 => stageCount!
            Int(reverseCalls! -> len) => reverseIndex!
            reverseIndex! > 0 -> while {
                reverseIndex! - 1 => reverseIndex!
                reverseCalls![reverseIndex!] => callIndex
                prepared -> stageParts(ir, callIndex) => parts
                ir[callIndex] => call
                call -> streamSliceKind(prepared) => sliceKind
                parts.argument0 => stageArgument0!
                parts.argument1 => stageArgument1!
                0 => stageRangeFlags!
                (sliceKind == 3 and stageArgument0! >= 0 and ir[stageArgument0!].kind == 31) -> if {
                    ir[stageArgument0!].opcode == grammar.tokenIdRangeUntil() -> if { 1 => stageRangeFlags! }
                    ir[stageArgument0!].operand1 => stageArgument1!
                    ir[stageArgument0!].operand0 => stageArgument0!
                }
                stages! -> push(StreamStage {
                    callIr: callIndex
                    callAst: call.astNode
                    targetModule: call.targetModule
                    targetSymbol: call.symbol
                    source0: parts.source0
                    source1: parts.source1
                    argument0: stageArgument0!
                    argument1: stageArgument1!
                    callbackStart: parts.callbackStart
                    callbackEnd: parts.callbackEnd
                    callbackRoot: parts.callbackRoot
                    roleToken: parts.roleToken
                    flags: sliceKind
                    rangeFlags: stageRangeFlags!
                })
                stageCount! + 1 => stageCount!
            }
            # Compiler-provided take/skip slices are represented inside the
            # terminal pipeline AST rather than as standalone call IR nodes.
            # Recover them into the continuation plan in lexical order so the
            # backend applies their state and early-stop semantics uniformly
            # to Stream and EventStream producers.
            prepared.package.ranges[terminal.sourceModule] => terminalRange
            prepared.package.nodes[terminalRange.astStart + terminal.astNode] => terminalAst
            terminalAst.firstToken => sliceTokenIndex!
            sliceTokenIndex! < terminalAst.firstToken + terminalAst.tokenCount -> while {
                prepared.package.tokens[terminalRange.tokenStart + sliceTokenIndex!] => sliceToken
                0 => recoveredSliceKind!
                sliceToken.kind == grammar.tokenIdIdentifier() -> if {
                    sliceToken.span.length == 4 -> if {
                        ((prepared.package.sources[terminal.sourceModule] -> byte(sliceToken.span.start)) == 116 and (prepared.package.sources[terminal.sourceModule] -> byte(sliceToken.span.start + 1)) == 97 and (prepared.package.sources[terminal.sourceModule] -> byte(sliceToken.span.start + 2)) == 107 and (prepared.package.sources[terminal.sourceModule] -> byte(sliceToken.span.start + 3)) == 101) -> if { 1 => recoveredSliceKind! }
                        ((prepared.package.sources[terminal.sourceModule] -> byte(sliceToken.span.start)) == 115 and (prepared.package.sources[terminal.sourceModule] -> byte(sliceToken.span.start + 1)) == 107 and (prepared.package.sources[terminal.sourceModule] -> byte(sliceToken.span.start + 2)) == 105 and (prepared.package.sources[terminal.sourceModule] -> byte(sliceToken.span.start + 3)) == 112) -> if { 2 => recoveredSliceKind! }
                    }
                }
                false => recoveredSliceRepresented!
                Int(stageStart) => representedSliceStageIndex!
                representedSliceStageIndex! < Int(stages! -> len) -> while {
                    stages![representedSliceStageIndex!] => representedSliceStage
                    (representedSliceStage.flags == recoveredSliceKind!
                        and representedSliceStage.callIr >= 0
                        and representedSliceStage.callIr < (ir -> len)
                        and ir[representedSliceStage.callIr].sourceModule == terminal.sourceModule
                        and representedSliceStage.callAst >= 0
                        and representedSliceStage.callAst < terminalRange.astCount) -> if {
                        prepared.package.nodes[terminalRange.astStart + representedSliceStage.callAst] => representedSliceCallAst
                        (representedSliceCallAst.payloadToken >= 0 and representedSliceCallAst.payloadToken < terminalRange.tokenCount) -> if {
                            prepared.package.tokens[terminalRange.tokenStart + representedSliceCallAst.payloadToken] => representedSliceTarget
                            representedSliceTarget.span.start == sliceToken.span.start -> if { true => recoveredSliceRepresented! }
                        }
                    }
                    representedSliceStageIndex! + 1 => representedSliceStageIndex!
                }
                (recoveredSliceKind! > 0 and not recoveredSliceRepresented!) -> if {
                    -1 => recoveredArgument!
                    UIntSize(0) => recoveredArgumentStart!
                    0 => recoveredChildIndex!
                    recoveredChildIndex! < (ir -> len) -> while {
                        ir[recoveredChildIndex!] => recoveredChild
                        (recoveredChild.parent == terminalIndex! and recoveredChild.astNode >= 0 and recoveredChild.astNode < terminalRange.astCount) -> if {
                            prepared.package.nodes[terminalRange.astStart + recoveredChild.astNode] => recoveredChildAst
                            (recoveredChildAst.start > sliceToken.span.start and (recoveredArgument! < 0 or recoveredChildAst.start < recoveredArgumentStart!)) -> if {
                                recoveredChildIndex! => recoveredArgument!
                                recoveredChildAst.start => recoveredArgumentStart!
                            }
                        }
                        recoveredChildIndex! + 1 => recoveredChildIndex!
                    }
                    recoveredArgument! >= 0 -> if {
                        stages! -> push(StreamStage {
                            callIr: terminalIndex!
                            callAst: terminal.astNode
                            targetModule: -1
                            targetSymbol: -1
                            source0: terminal.operand0
                            source1: -1
                            argument0: recoveredArgument!
                            argument1: -1
                            callbackStart: -1
                            callbackEnd: -1
                            callbackRoot: -1
                            roleToken: -1
                            flags: recoveredSliceKind!
                            rangeFlags: 0
                        })
                        stageCount! + 1 => stageCount!
                    }
                }
                sliceTokenIndex! + 1 => sliceTokenIndex!
            }
            prepared -> stageParts(ir, terminalIndex!) => terminalParts
            -1 => pipelineSource0!
            -1 => pipelineSource1!
            0 => pipelineFlags!
            (stages! -> len) > stageStart -> if {
                stages![stageStart] => firstStage
                firstStage.source0 => pipelineSource0!
                firstStage.source1 => pipelineSource1!
            } else {
                terminal.operand0 => pipelineSource0!
            }
            # A first-class range node owns its inclusive bounds directly.
            # Stream planning consumes those bounds as the producer source
            # instead of treating the range aggregate as one scalar value.
            (pipelineSource0! >= 0 and ir[pipelineSource0!].kind == 31) -> if {
                ir[pipelineSource0!].opcode == grammar.tokenIdRangeUntil() -> if { 1 => pipelineFlags! }
                ir[pipelineSource0!].operand1 => pipelineSource1!
                ir[pipelineSource0!].operand0 => pipelineSource0!
            }
            0 => pipelineStatus!
            (pipelineSource0! >= 0 and pipelineSource0! < (ir -> len) and ir[pipelineSource0!].typeId >= 0 and ir[pipelineSource0!].typeId < (resolved.types -> len)) -> if {
                resolved.types[ir[pipelineSource0!].typeId] => pipelineSourceType
                (pipelineSourceType.kind == 7 and pipelineSourceType.origin == 4 and pipelineSourceType.symbol == 3) -> if { 1 => pipelineStatus! }
                (pipelineSourceType.kind == 7 and pipelineSourceType.origin == 4 and pipelineSourceType.symbol == 4) -> if { 2 => pipelineStatus! }
            }
            pipelines! -> len => plannedPipelineIndex
            pipelines! -> push(StreamPipeline {
                terminalIr: terminalIndex!
                source0: pipelineSource0!
                source1: pipelineSource1!
                stageStart: Int(stageStart)
                stageCount: stageCount!
                callbackStart: terminalParts.callbackStart
                callbackEnd: terminalParts.callbackEnd
                callbackRoot: terminalParts.callbackRoot
                roleToken: terminalParts.roleToken
                status: pipelineStatus!
                flags: pipelineFlags!
            })
            pipelineSource0! >= 0 -> if {
                pipelineSource0! => partitionMemberIr
                ir[partitionMemberIr].kind == 13 -> if {
                    ir[partitionMemberIr] => partitionMember
                    partitionMember.operand0 => partitionMemberBase!
                    (partitionMemberBase! >= 0 and ir[partitionMemberBase!].kind == 5) -> if { ir[partitionMemberBase!].operand0 => partitionMemberBase! }
                    (partitionMemberBase! >= 0 and ir[partitionMemberBase!].kind == 17) -> if { ir[partitionMemberBase!].operand0 => partitionMemberBase! }
                    (partitionMemberBase! >= 0 and ir[partitionMemberBase!].kind == 40) -> if {
                        0 => partitionJunctionSearch!
                        partitionJunctionSearch! < (junctions! -> len) -> while {
                            junctions![partitionJunctionSearch!] => partitionJunction
                            partitionJunction.junctionIr == partitionMemberBase! -> if {
                                partitionJunction.routeStart => partitionRouteSearch!
                                partitionRouteSearch! < partitionJunction.routeStart + partitionJunction.routeCount -> while {
                                    partitionRoutes![partitionRouteSearch!] => plannedPartitionRoute
                                    plannedPartitionRoute.ordinal == partitionMember.symbol -> if {
                                        StreamPartitionRoute {
                                            routeIr: plannedPartitionRoute.routeIr
                                            predicateIr: plannedPartitionRoute.predicateIr
                                            ordinal: plannedPartitionRoute.ordinal
                                            terminalIr: terminalIndex!
                                            pipelineIndex: Int(plannedPipelineIndex)
                                        } => partitionRoutes![partitionRouteSearch!]
                                    }
                                    partitionRouteSearch! + 1 => partitionRouteSearch!
                                }
                            }
                            partitionJunctionSearch! + 1 => partitionJunctionSearch!
                        }
                    }
                }
            }
        }
        terminalIndex! + 1 => terminalIndex!
    }
    StreamPlan { pipelines: pipelines!, stages: stages!, junctions: junctions!, junctionInputs: junctionInputs!, partitionRoutes: partitionRoutes! } => plan
    plan
}
