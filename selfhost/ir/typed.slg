        # into the indexed place and leaves the source binding uninitialized.
        site.kind == 24 and site.operand0 >= 0 and (ir[site.operand0].typeOrigin == 13 or ir[site.operand0].typeOrigin == 15 or ir[site.operand0].typeFlags % 2 == 1)
            -> if {
