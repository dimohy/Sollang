        # its Result immediately feeds `when`. Its declared move receiver is
        # therefore no longer visible to the ordinary kind-6 function scan.
        # Record Command.spawn and Child.wait receivers explicitly so enum-arm
        # cleanup cannot drop the consumed Command or Child a second time.
        (site.kind == 6 or site.kind == 9)
            and (site.opcode == -277 or site.opcode == -278 or site.opcode == -288)
            and site.operand0 >= 0
            and (movedValueIrs! -> len) == 0
            -> if {
                movedValueIrs! -> push(site.operand0)
            }
        # Array/BinaryHeap push and Set insert transfer a named or projected owned
        # element into the destination collection. This matches the semantic ownership contract:
        # indexed reads remain reads, while owned names, field paths and names nested in
        # aggregate literals transfer. Aggregate literals are already covered
        # by the canonical aggregate rule below.
        site.kind == 9
            and (site.opcode == -204 or site.opcode == -252 or site.opcode == -255)
            and site.operand1 >= 0
            -> if {
                site.operand1 => pushedValueIr!
                ir[pushedValueIr!].kind == 9 and ir[pushedValueIr!].opcode == -1
                    -> if {
                        0 => pushedValueSearch!
                        pushedValueSearch! < (ir -> len) -> while {
                            ir[pushedValueSearch!] => pushedValueCandidate
                            pushedValueCandidate.parent == pushedValueIr!
                                and (pushedValueCandidate.kind == 2
                                or pushedValueCandidate.kind == 3
                                or pushedValueCandidate.kind == 4
                                or pushedValueCandidate.kind == 5
                                or pushedValueCandidate.kind == 6
                                or pushedValueCandidate.kind == 7
                                or pushedValueCandidate.kind == 8
                                or pushedValueCandidate.kind == 12
                                or pushedValueCandidate.kind == 13
                                or pushedValueCandidate.kind == 14
                                or pushedValueCandidate.kind == 35
                                or pushedValueCandidate.kind == 16
                                or pushedValueCandidate.kind == 18
                                or pushedValueCandidate.kind == 26
                                or pushedValueCandidate.kind == 27) -> if {
                                    pushedValueSearch! => pushedValueIr!
                                }
                            pushedValueSearch! + 1 => pushedValueSearch!
                        }
                    }
                ir[pushedValueIr!] => pushedValue
                (pushedValue.kind == 5 or pushedValue.kind == 13) and pushedValue.typeFlags % 2 == 1
                    -> if {
                        movedValueIrs! -> push(pushedValueIr!)
                    }
            }
        # Scalar-only nominal fields are copyable values. A direct field
        # binding becomes a partial move when the field owns heap storage or a
        # unique resource handle and therefore carries a drop obligation.
        site.kind == 17
            and site.operand0 >= 0
            and ir[site.operand0].kind == 13
            and ((ir[site.operand0].typeFlags / 2) % 2 == 1
            or (ir[site.operand0].typeFlags / 4) % 2 == 1)
            -> if {
                movedValueIrs! -> push(site.operand0)
