public movesFrom ir: [TypedIrNode; ~] -> [MoveEvent; ~] {
    [MoveEvent; ~] => events!
    0 => siteIndex!
    siteIndex! < (ir -> len) -> while {
        ir[siteIndex!] => site
        [Int; ~] => movedValueIrs!
        site.kind == 6 and site.symbol >= 0 and site.operand0 >= 0
            -> if {
                0 => functionIndex!
                functionIndex! < (ir -> len) -> while {
                    ir[functionIndex!] => function
                    function.kind == 0 and function.sourceModule == site.targetModule and function.symbol == site.symbol and function.operand1 >= 0
                        -> if {
                            site.operand0 => movedArgumentIndex!
                            function.operand1 => movedParameterIndex!
                            0 => movedParameterOrdinal!
                            movedArgumentIndex! >= 0 and movedParameterIndex! >= 0
                                -> while {
                                    ir[movedParameterIndex!] => movedParameter
                                    movedParameter.flags % 2 == 1 -> if { movedValueIrs! -> push(movedArgumentIndex!) }
                                    ir[movedArgumentIndex!].nextOperand => movedArgumentIndex!
                                    movedParameterOrdinal! == 0 -> if {
                                        function.nextOperand => movedParameterIndex!
                                    } else {
                                        movedParameter.nextOperand => movedParameterIndex!
                                    }
                                    movedParameterOrdinal! + 1 => movedParameterOrdinal!
                                }
                        }
                    functionIndex! + 1 => functionIndex!
                }
            }
        # each consumes an affine Stream/EventStream source even though it is
        # represented as a runtime intrinsic rather than a declared move
        # parameter. Recording the source name here makes a second terminal
        # use fail through the ordinary ownership checker.
        site.kind == 6 and site.opcode == -208 and site.operand0 >= 0
            -> if {
                ir[site.operand0] => eachSource
                eachSource.typeKind == 7 and eachSource.typeOrigin == 4 and (eachSource.typeSymbol == 3 or eachSource.typeSymbol == 4)
                    -> if {
                        movedValueIrs! -> push(site.operand0)
                    }
            }
