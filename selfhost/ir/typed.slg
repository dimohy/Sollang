sourceMatches source: Text, start: UIntSize, length: UIntSize, expected: Text -> Bool {
    expected -> len => expectedLength
    length == expectedLength => matches!
    UIntSize(0) => byteIndex!
    matches! and byteIndex! < length -> while {
        (source -> byte(start + byteIndex!)) != (expected -> byte(byteIndex!))
            -> if { false => matches! }
        byteIndex! + 1 => byteIndex!
    }
    matches!
}

# Socket opcodes are intentionally centralized because collection/process
# intrinsics occupy gaps between socket additions. Never widen across a gap.
public isSocketRuntimeOpcode opcode: Int -> Bool {
    (opcode <= -258 and opcode >= -270)
        or (opcode <= -272 and opcode >= -274)
        or opcode == -279
        or opcode == -280
        or (opcode <= -281 and opcode >= -284)
        or opcode == -287
        or (opcode <= -289 and opcode >= -296)
        or (opcode <= -297 and opcode >= -302)
}
public isSocketResultOpcode opcode: Int -> Bool {
    (opcode <= -258 and opcode >= -269)
        or (opcode <= -272 and opcode >= -274)
        or opcode == -279
        or opcode == -280
        or (opcode <= -281 and opcode >= -284)
        or opcode == -287
        or (opcode <= -289 and opcode >= -296)
        or (opcode <= -297 and opcode >= -302)
}

# File opcodes include the established scalar/open operations and the two
# caller-buffer positional operations. Keep them explicit because -222 onward
# belongs to unrelated runtime and container families.
public isFileRuntimeOpcode opcode: Int -> Bool {
    (opcode <= -216 and opcode >= -221)
        or opcode == -304
        or opcode == -305
}

public isFileResultOpcode opcode: Int -> Bool {
    opcode == -216
        or opcode == -217
        or opcode == -220
        or opcode == -221
        or opcode == -304
        or opcode == -305
}

# Syntax shape, not provisional semantic availability, decides whether
# operators exist in Typed IR. Both entry and ordinary-function lowering use
# this single policy so their materialization rules cannot drift independently.
public isNumericBinaryAstKind kind: Int -> Bool => kind == 20 or kind == 21

public isBooleanBinaryAstKind kind: Int -> Bool {
    kind == 18 or kind == 19 or kind == 24 or kind == 25 or kind == 70
}

public isBinaryValueAstKind kind: Int -> Bool {
    (kind -> isNumericBinaryAstKind) or (kind -> isBooleanBinaryAstKind)
}

# AST identity selects the stable Typed IR shape before any contextual type or
# call information is attached. Call, Bool-name, and nullary-enum refinements
# deliberately override this base result after semantic resolution.
public defaultExpressionIrKindForAstKind kind: Int -> Int {
    9 => irKind!
    kind == 13 -> if { 2 => irKind! }
    kind == 14 -> if { 3 => irKind! }
    kind == 15 -> if { 5 => irKind! }
    kind == 22 -> if { 7 => irKind! }
    kind == 23 or kind == 49 -> if { 9 => irKind! }
    kind -> isBinaryValueAstKind -> if { 8 => irKind! }
    kind == 39 -> if { 12 => irKind! }
    kind == 36 -> if { 13 => irKind! }
    kind == 37 -> if { 14 => irKind! }
    kind == 41 -> if { 15 => irKind! }
    kind == 38 -> if { 16 => irKind! }
    kind == 53 -> if { 24 => irKind! }
    kind == 54 -> if { 25 => irKind! }
    kind == 55 -> if { 26 => irKind! }
    kind == 56 -> if { 27 => irKind! }
    kind == 59 -> if { 29 => irKind! }
    kind == 63 -> if { 31 => irKind! }
    kind == 64 -> if { 32 => irKind! }
    kind == 57 -> if { 33 => irKind! }
    kind == 71 -> if { 35 => irKind! }
    kind == 76 -> if { 36 => irKind! }
    kind == 73 -> if { 37 => irKind! }
    kind == 74 -> if { 38 => irKind! }
    kind == 75 -> if { 39 => irKind! }
    kind == 78 -> if { 40 => irKind! }
    kind == 79 -> if { 41 => irKind! }
    kind == 80 -> if { 42 => irKind! }
    kind == 81 -> if { 43 => irKind! }
    irKind!
}

# Semantic resolution supplies only the contextual facts; the final shape
# precedence remains shared. This prevents entry and ordinary functions from
# independently deciding whether Bool names, calls, flows, and type
# applications become value, call, or enum-constructor nodes.
public resolvedExpressionIrKindForAstKind kind: Int, isBoolLiteral: Bool, isCallLike: Bool, isNullaryEnum: Bool, isPropertyCall: Bool -> Int {
    kind -> defaultExpressionIrKindForAstKind => irKind!
    isBoolLiteral -> if { 4 => irKind! }
    isCallLike -> if { 6 => irKind! }
    isNullaryEnum -> if { 26 => irKind! }
    isPropertyCall -> if { 6 => irKind! }
    irKind!
}

# Entry and ordinary functions share control materialization as well as value
# materialization. A negative result means the AST node is not a control node.
public controlIrKindForAstKind kind: Int -> Int {
    -1 => irKind!
    kind == 42 -> if { 18 => irKind! }
    kind == 43 or kind == 58 -> if { 19 => irKind! }
    kind == 44 -> if { 20 => irKind! }
    kind == 45 -> if { 21 => irKind! }
    kind == 46 -> if { 22 => irKind! }
    kind == 47 -> if { 23 => irKind! }
    kind == 62 or kind == 82 -> if { 30 => irKind! }
    irKind!
}

# MapExpression has no placeholder operands. The linked operand count is the
# canonical clause-presence contract: bit 0 = `at` offset, bit 1 = `for`
# length, bit 2 = `size` file size. Invalid opcode/count combinations remain
# unresolved instead of acquiring an arbitrary clause shape.
public mapExpressionClauseFlags opcode: Int, operandCount: Int -> Int {
    -1 => flags!
    opcode == -306 -> if {
        operandCount == 1 -> if { 0 => flags! }
        operandCount == 3 -> if { 3 => flags! }
    }
    opcode == -307 -> if {
        operandCount == 1 -> if { 0 => flags! }
        operandCount == 2 -> if { 4 => flags! }
        operandCount == 3 -> if { 3 => flags! }
        operandCount == 4 -> if { 7 => flags! }
    }
    flags!
}

# Both entry and ordinary-function lowering use the same nominal result type
# for a mapped-byte producer. An unknown opcode stays unresolved so malformed
# map syntax cannot acquire an arbitrary runtime owner type.
public mapExpressionTypeSymbolForOpcode opcode: Int -> Int => opcode -> when {
    == -306 { 17 }
    == -307 { 18 }
    else { -1 }
}

# Pure sys.process domain projections are intrinsic instance methods whose
# self-host lowering is an aggregate field extraction, never a wrapper call.
public isProcessProjectionOpcode opcode: Int -> Bool => opcode == -285 or opcode == -286

public isProcessExecutionOpcode opcode: Int -> Bool => opcode == -210 or opcode == -211 or opcode == -277 or opcode == -278 or opcode == -288 or opcode == -308 or opcode == -309

# Built-in runtime calls have no source declaration from which the ordinary
# function-result resolver can recover a type. Keep their value contract in
# one authority shared by entry and ordinary-function lowering. Async calls
# retain the underlying result type here; the async bit identifies the Task
# boundary until await consumes it.
public builtinRuntimeCallResultTypeSymbol functionSymbol: Int -> Int {
    -1 => result!
    functionSymbol == -103 or functionSymbol == -105 or functionSymbol == -110 or functionSymbol == -115
        -> if { 2 => result! }
    functionSymbol == -112 -> if { 9 => result! }
    functionSymbol == -113 -> if { 0 => result! }
    result!
}

public builtinRuntimeCallIsAsync functionSymbol: Int -> Bool => functionSymbol == -113

integerTypeRank symbol: Int -> Int {
    0 => rank!
    symbol == 3 or symbol == 8 -> if { 1 => rank! }
    symbol == 4 or symbol == 9 -> if { 2 => rank! }
    symbol == 2 or symbol == 5 or symbol == 10 or symbol == 14
        -> if { 3 => rank! }
    symbol == 6 or symbol == 7 or symbol == 11 or symbol == 12 or symbol == 13
        -> if { 4 => rank! }
    rank!
}

# Semantic type inference is authoritative for builtin type applications.
# They use call syntax but never resolve to a module function, even when their
# sole argument is itself a qualified call whose call table entry is nearby.
isTargetlessBuiltinTypeApplication value: expressionTypes.ExpressionType, builtinSymbol: Int -> Bool {
    builtinSymbol >= 0
        and value.origin == 1
        and value.targetModule < 0
        and value.targetSymbol == builtinSymbol
}

# Stable, flat typed IR. Indexes are relocatable array offsets so later LLVM
# lowering can consume the table without allocating an object graph.
# Kinds: 0 function, 1 return, 2 Text constant, 3 Int constant,
# 4 Bool constant, 5 name, 6 call, 7 unary, 8 binary, 9 other expression,
# 10 parameter, 11 entry point, 12 struct literal, 13 member access,
# 14 array literal, 15 index access, 16 dictionary literal, 17 binding,
# 18 structured if, 19 control-flow region, 20 structured while,
# 21 loop exit, 22 guarded loop exit (opcode 0 break, 1 continue;
# operand0 targets the while, guarded operand1 is the Bool condition),
# 23 explicit return (operand0 is the optional returned value), 24 index
# assignment (operand0 is the value and operand1 is the index), 25 mutable
# struct member assignment (operand0 is the value and operand1 is the owner
# binding), 26 enum constructor (operand0 is the optional payload), 27 enum
# match (operand0 subject, operand1 first arm), 29 enum payload binding. Enum
# arms reuse kind 19 regions and carry their variant tag in opcode. AST kind 48
# lowers to an ordinary call node; its child operations preserve the role body.
# Kind 31 is an inclusive Int range (operand0 start, operand1 end). Kind 32 is
# fold (operand0 source, operand1 initial); its body remains a child region.
# Kind 33 is an ordered Boolean when expression (operand0 first arm). Kind 34
# is an integer-subject when expression (operand0 subject, operand1 first arm).
# Kind 35 is a structural product value; operand0 is its first field value and
# sibling nextOperand links preserve declared field order. Kind 36 is a
# value-preserving tap (operand0 source, operand1 side-effecting call). Kind 37
# is a sequential named branch and kind 38 is an explicit parallel named
# branch (operand0 first arm node, operand1 shared source). Kind 39 is a named
# branch arm (operand0 first stage call, operand1 final stage call). Kind 40 is
# exclusive partition (operand0 source stream, operand1 first route), kind 41
# is a predicate route (operand0 Bool predicate), kind 42 is the else route,
# and kind 43 is a policy-specific stream join (operand0 product of streams).
public struct TypedIrNode {
    public kind: Int
    public parent: Int
    public sourceModule: Int
    public astNode: Int
    public symbol: Int
    public targetModule: Int
    public typeOrigin: Int
    public typeModule: Int
    public typeSymbol: Int
    public typeId: Int
    public typeKind: Int
    public typeFlags: Int
    public payloadToken: Int
    public opcode: Int
    public operand0: Int
    public operand1: Int
    public nextOperand: Int
    public flags: Int
}

# Console calls may remain ordinary calls or become materialized expressions
# when their source is a completed control value. Both forms are the same
# ordered runtime effect and must share scheduling and emission policy.
public isConsoleRuntimeCall node: TypedIrNode -> Bool {
    (node.kind == 6 or node.kind == 9)
        and (node.symbol == -101 or node.symbol == -102 or node.symbol == -116)
}

# A flat flow whose call result feeds a control retains one transparent
# materialize node around both edges.  It is the producer-side topology, not a
# concrete trailing call with two peer arguments.  Keep this identity shared
# with the LLVM invariant so the wrapper cannot be mistaken for S047.
public isTransparentControlProducerWrapper node: TypedIrNode -> Bool {
    node.kind == 9
        and node.symbol == -1
        and node.targetModule == -1
        and node.opcode == -1
        and node.operand0 >= 0
        and node.operand1 >= 0
}

# Set operations can remain ordinary calls in named functions or become
# materialized calls when their result feeds a control/value expression. The
# opcode, not the incidental call shape, is the canonical intrinsic identity.
public isSetIntrinsicCall node: TypedIrNode -> Bool {
    (node.kind == 6 or node.kind == 9)
        and node.opcode <= -255
        and node.opcode >= -257
        and node.operand0 >= 0
        and node.operand1 >= 0
}

public isSetMutationCall node: TypedIrNode -> Bool {
    (node -> isSetIntrinsicCall)
        and (node.opcode == -255 or node.opcode == -257)
}

# Builtin numeric conversions and Arena construction have no module function
# target. Their -1/-1 identity is consumed by direct LLVM lowering and must not
# be confused with an unresolved general call.
public isBuiltinIntegerConversionCall node: TypedIrNode -> Bool {
    node.kind == 6
        and node.targetModule < 0
        and node.typeOrigin == 1
        and integerTypeRank(node.typeSymbol) > 0
        and node.operand0 >= 0
        and node.operand1 < 0
}

public isArenaConstructorCall node: TypedIrNode -> Bool {
    node.kind == 6
        and node.symbol < 0
        and node.opcode == -1
        and node.typeOrigin == 1
        and node.typeSymbol == 15
        and node.operand0 >= 0
}

public isBuiltinTargetlessCall node: TypedIrNode -> Bool {
    (node -> isBuiltinIntegerConversionCall)
        or (node -> isArenaConstructorCall)
}

# A move event is a consuming call whose argument is a resolved local owner.
# Cleanup lowering uses this side table instead of overloading value/type flags.
public struct MoveEvent {
    public siteIr: Int
    public bindingIr: Int
    public sourceModule: Int
    public symbol: Int
    public regionIr: Int
    public memberIr: Int
}

# A suspension point belongs to one async function and receives a stable,
# one-based resume state in source order. Kind distinguishes child await from
# cooperative yield. awaitIr is -1 until a corresponding node is available;
# awaitAst is the stable source-site AST index for either kind.
public struct CoroutineSuspendPoint {
    public functionIr: Int
    public sourceModule: Int
    public awaitAst: Int
    public awaitIr: Int
    public state: Int
    # 0 awaits a child Task; 1 cooperatively yields the current Task.
    public kind: Int
}

# One frame slot records a binding that is defined before a suspension and
# referenced after it inside the same async function. Parameters stay in the
# function context and therefore do not appear in this side table. In flags,
# bit 0 marks mutable storage, bit 1 marks an obvious heap owner, and bit 2
# marks an affine Task whose handle and context must move into the frame.
public struct CoroutineFrameSlot {
    public functionIr: Int
    public state: Int
    public sourceModule: Int
    public symbol: Int
    public typeOrigin: Int
    public typeModule: Int
    public typeSymbol: Int
    public typeId: Int
    public typeKind: Int
    public typeFlags: Int
    public flags: Int
}

# One lowering produces every coroutine side table. Consumers that need more
# than one table keep this aggregate and avoid rebuilding typed IR.
public struct CoroutinePlan {
    public ir: [TypedIrNode; ~]
    public points: [CoroutineSuspendPoint; ~]
    public slots: [CoroutineFrameSlot; ~]
    public destroys: [CoroutineFrameSlot; ~]
}

public struct TypedIrRequest {
    public sources: [Text; ~]
    public types: [typeIds.SemanticType; ~]
    public references: [typeIds.TypeReference; ~]
    public fields: [typeIds.NominalField; ~]
    public nominal: [nominalTypes.NominalType; ~]
    public composite: [compositeTypes.CompositeType; ~]
    public modules: [modules.ModuleIdentity; ~]
    public qualified: [qualified.QualifiedResolution; ~]
    public calls: [calls.ModuleCallResolution; ~]
    public analysisRanges: [analysis.SourceAnalysisRange; ~]
    public analysisNodes: [ast.AstNode; ~]
    public analysisTokens: [syntax.SyntaxToken; ~]
    public analysisSymbols: [symbols.Symbol; ~]
    public analysisNames: [resolution.ResolvedName; ~]
}

struct IntrinsicNameRequest {
    source: Text
    token: syntax.SyntaxToken
}

sourceTypedIr nodes: move [TypedIrNode; ~] -> SourceTypedIr {
    SourceTypedIr { nodes: nodes } => result
    result
}

# Keep imported projection modules from re-inferring the element type of a
# mutable Typed IR array at every indexed write. This mutates one existing slot
# in place; it does not allocate, copy the array, or wrap the node.
public replaceNode nodes: mut [TypedIrNode; ~], index: Int, node: ref TypedIrNode -> Unit {
    node => nodes[index]
}

intrinsicOpcode request: IntrinsicNameRequest -> Int {
    -1 => opcode!
    request.source -> sourceMatches(request.token.span.start, request.token.span.length, "readIntoAt")
        -> if { -304 => opcode! }
    request.source -> sourceMatches(request.token.span.start, request.token.span.length, "writeRangeAt")
        -> if { -305 => opcode! }
    request.source -> sourceMatches(request.token.span.start, request.token.span.length, "putIfAbsent")
        -> if { -303 => opcode! }
    request.token.span.length == 3 -> if {
        (request.source -> byte(request.token.span.start)) == 108 and (request.source -> byte(request.token.span.start + 1)) == 101 and (request.source -> byte(request.token.span.start + 2)) == 110
            -> if { -201 => opcode! }
        (request.source -> byte(request.token.span.start)) == 100 and (request.source -> byte(request.token.span.start + 1)) == 121 and (request.source -> byte(request.token.span.start + 2)) == 110
            -> if { -224 => opcode! }
        request.source -> sourceMatches(request.token.span.start, request.token.span.length, "set")
            -> if { -241 => opcode! }
        request.source -> sourceMatches(request.token.span.start, request.token.span.length, "pop")
            -> if { -254 => opcode! }
    }
    request.token.span.length == 4 -> if {
        (request.source -> byte(request.token.span.start)) == 98 and (request.source -> byte(request.token.span.start + 1)) == 121 and (request.source -> byte(request.token.span.start + 2)) == 116 and (request.source -> byte(request.token.span.start + 3)) == 101
            -> if { -202 => opcode! }
        (request.source -> byte(request.token.span.start)) == 112 and (request.source -> byte(request.token.span.start + 1)) == 117 and (request.source -> byte(request.token.span.start + 2)) == 115 and (request.source -> byte(request.token.span.start + 3)) == 104
            -> if { -204 => opcode! }
        (request.source -> byte(request.token.span.start)) == 101 and (request.source -> byte(request.token.span.start + 1)) == 97 and (request.source -> byte(request.token.span.start + 2)) == 99 and (request.source -> byte(request.token.span.start + 3)) == 104
            -> if { -208 => opcode! }
        (request.source -> byte(request.token.span.start)) == 116 and (request.source -> byte(request.token.span.start + 1)) == 97 and (request.source -> byte(request.token.span.start + 2)) == 107 and (request.source -> byte(request.token.span.start + 3)) == 101
            -> if { -213 => opcode! }
        (request.source -> byte(request.token.span.start)) == 101 and (request.source -> byte(request.token.span.start + 1)) == 109 and (request.source -> byte(request.token.span.start + 2)) == 105 and (request.source -> byte(request.token.span.start + 3)) == 116
            -> if { -228 => opcode! }
        request.source -> sourceMatches(request.token.span.start, request.token.span.length, "back")
            -> if { -249 => opcode! }
        request.source -> sourceMatches(request.token.span.start, request.token.span.length, "peek")
            -> if { -253 => opcode! }
    }
    request.token.span.length == 3 -> if {
        (request.source -> byte(request.token.span.start)) == 112 and (request.source -> byte(request.token.span.start + 1)) == 117 and (request.source -> byte(request.token.span.start + 2)) == 116
            -> if { -223 => opcode! }
    }
    request.token.span.length == 5 -> if {
        (request.source -> byte(request.token.span.start)) == 115 and (request.source -> byte(request.token.span.start + 1)) == 108 and (request.source -> byte(request.token.span.start + 2)) == 105 and (request.source -> byte(request.token.span.start + 3)) == 99 and (request.source -> byte(request.token.span.start + 4)) == 101
            -> if { -203 => opcode! }
        (request.source -> byte(request.token.span.start)) == 121 and (request.source -> byte(request.token.span.start + 1)) == 105 and (request.source -> byte(request.token.span.start + 2)) == 101 and (request.source -> byte(request.token.span.start + 3)) == 108 and (request.source -> byte(request.token.span.start + 4)) == 100
            -> if { -227 => opcode! }
        request.source -> sourceMatches(request.token.span.start, request.token.span.length, "clear")
            -> if { -242 => opcode! }
        request.source -> sourceMatches(request.token.span.start, request.token.span.length, "count")
            -> if { -244 => opcode! }
        request.source -> sourceMatches(request.token.span.start, request.token.span.length, "front")
            -> if { -248 => opcode! }
    }
    request.token.span.length == 6 -> if {
        (request.source -> byte(request.token.span.start)) == 114 and (request.source -> byte(request.token.span.start + 1)) == 101 and (request.source -> byte(request.token.span.start + 2)) == 97 and (request.source -> byte(request.token.span.start + 3)) == 100 and (request.source -> byte(request.token.span.start + 4)) == 65 and (request.source -> byte(request.token.span.start + 5)) == 116
            -> if { -220 => opcode! }
        request.source -> sourceMatches(request.token.span.start, request.token.span.length, "insert")
            -> if { -255 => opcode! }
        request.source -> sourceMatches(request.token.span.start, request.token.span.length, "remove")
            -> if { -257 => opcode! }
    }
    request.token.span.length == 7 -> if {
        (request.source -> byte(request.token.span.start)) == 109 and (request.source -> byte(request.token.span.start + 1)) == 97 and (request.source -> byte(request.token.span.start + 2)) == 112 and (request.source -> byte(request.token.span.start + 3)) == 84 and (request.source -> byte(request.token.span.start + 4)) == 101 and (request.source -> byte(request.token.span.start + 5)) == 120 and (request.source -> byte(request.token.span.start + 6)) == 116
            -> if { -205 => opcode! }
        (request.source -> byte(request.token.span.start)) == 109 and (request.source -> byte(request.token.span.start + 1)) == 97 and (request.source -> byte(request.token.span.start + 2)) == 112 and (request.source -> byte(request.token.span.start + 3)) == 80 and (request.source -> byte(request.token.span.start + 4)) == 97 and (request.source -> byte(request.token.span.start + 5)) == 116 and (request.source -> byte(request.token.span.start + 6)) == 104
            -> if { -214 => opcode! }
        (request.source -> byte(request.token.span.start)) == 119 and (request.source -> byte(request.token.span.start + 1)) == 114 and (request.source -> byte(request.token.span.start + 2)) == 105 and (request.source -> byte(request.token.span.start + 3)) == 116 and (request.source -> byte(request.token.span.start + 4)) == 101 and (request.source -> byte(request.token.span.start + 5)) == 65 and (request.source -> byte(request.token.span.start + 6)) == 116
            -> if { -221 => opcode! }
        request.source -> sourceMatches(request.token.span.start, request.token.span.length, "popBack")
            -> if { -251 => opcode! }
        request.source -> sourceMatches(request.token.span.start, request.token.span.length, "reserve")
            -> if { -271 => opcode! }
    }
    request.token.span.length == 8 -> if {
        (request.source -> byte(request.token.span.start)) == 112 and (request.source -> byte(request.token.span.start + 1)) == 97 and (request.source -> byte(request.token.span.start + 2)) == 114 and (request.source -> byte(request.token.span.start + 3)) == 97 and (request.source -> byte(request.token.span.start + 4)) == 108 and (request.source -> byte(request.token.span.start + 5)) == 108 and (request.source -> byte(request.token.span.start + 6)) == 101 and (request.source -> byte(request.token.span.start + 7)) == 108
            -> if { -207 => opcode! }
        (request.source -> byte(request.token.span.start)) == 112 and (request.source -> byte(request.token.span.start + 1)) == 97 and (request.source -> byte(request.token.span.start + 2)) == 116 and (request.source -> byte(request.token.span.start + 3)) == 104 and (request.source -> byte(request.token.span.start + 4)) == 84 and (request.source -> byte(request.token.span.start + 5)) == 101 and (request.source -> byte(request.token.span.start + 6)) == 120 and (request.source -> byte(request.token.span.start + 7)) == 116
            -> if { -230 => opcode! }
        (request.source -> byte(request.token.span.start)) == 99
            and (request.source -> byte(request.token.span.start + 1)) == 97
            and (request.source -> byte(request.token.span.start + 2)) == 112
            and (request.source -> byte(request.token.span.start + 3)) == 97
            and (request.source -> byte(request.token.span.start + 4)) == 99
            and (request.source -> byte(request.token.span.start + 5)) == 105
            and (request.source -> byte(request.token.span.start + 6)) == 116
            and (request.source -> byte(request.token.span.start + 7)) == 121
            -> if { -236 => opcode! }
        request.source -> sourceMatches(request.token.span.start, request.token.span.length, "contains")
            -> if { -243 => opcode! }
        request.source -> sourceMatches(request.token.span.start, request.token.span.length, "pushBack")
            -> if { -247 => opcode! }
        request.source -> sourceMatches(request.token.span.start, request.token.span.length, "popFront")
            -> if { -250 => opcode! }
    }
    request.token.span.length == 9 -> if {
