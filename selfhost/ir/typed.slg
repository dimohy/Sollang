        # transfers into that aggregate. Treat direct names and owned member
        # paths exactly like consuming-call arguments so the former binding is
        # not dropped after the aggregate has taken ownership.
        (site.kind == 5 or site.kind == 13) and (site.typeOrigin == 13 or site.typeOrigin == 15 or site.typeFlags % 2 == 1 or (site.typeKind == 7 and site.typeOrigin == 4 and (site.typeSymbol == 3 or site.typeSymbol == 4)))
            -> if {
                site.parent => aggregateOwner!
                false => aggregateMemberPath!
                aggregateOwner! >= 0 and ir[aggregateOwner!].kind != 0 and ir[aggregateOwner!].kind != 1 and ir[aggregateOwner!].kind != 6 and ir[aggregateOwner!].kind != 11 and ir[aggregateOwner!].kind != 12 and ir[aggregateOwner!].kind != 14 and ir[aggregateOwner!].kind != 16 and ir[aggregateOwner!].kind != 19 and ir[aggregateOwner!].kind != 20 and ir[aggregateOwner!].kind != 26 and ir[aggregateOwner!].kind != 35
                    -> while {
                        ir[aggregateOwner!].kind == 13 -> if { true => aggregateMemberPath! }
                        ir[aggregateOwner!].parent => aggregateOwner!
                    }
                not aggregateMemberPath! and aggregateOwner! >= 0 and (ir[aggregateOwner!].kind == 12 or ir[aggregateOwner!].kind == 14 or ir[aggregateOwner!].kind == 16 or ir[aggregateOwner!].kind == 26 or ir[aggregateOwner!].kind == 35)
                    -> if {
                        movedValueIrs! -> push(siteIndex!)
                    }
            }
        0 => movedValueOrdinal!
        movedValueOrdinal! < (movedValueIrs! -> len)
            -> while {
                movedValueIrs![movedValueOrdinal!] => movedValueIr
                movedValueIr => moveRootIr!
                -1 => moveMemberIr!
                ir[moveRootIr!].kind == 13 or ir[moveRootIr!].kind == 15
                    -> if { moveRootIr! => moveMemberIr! }
                moveRootIr! >= 0 and (ir[moveRootIr!].kind == 13 or ir[moveRootIr!].kind == 15)
                    -> while { ir[moveRootIr!].operand0 => moveRootIr! }
                moveRootIr! >= 0 and ir[moveRootIr!].kind == 5 and ir[moveRootIr!].symbol >= 0
                    -> if {
                        ir[moveRootIr!] => moveRoot
                        moveRootIr! => moveBindingIr!
                        moveRoot.sourceModule => moveSourceModule!
                        moveRoot.symbol => moveSymbol!
                        moveRoot.operand0 >= 0
                            and moveRoot.operand0 < (ir -> len)
                            and (ir[moveRoot.operand0].kind == 17
                            or ir[moveRoot.operand0].kind == 29)
                            -> if {
                                moveRoot.operand0 => moveBindingIr!
                                ir[moveRoot.operand0].sourceModule => moveSourceModule!
                                ir[moveRoot.operand0].symbol => moveSymbol!
                            }
                        site.parent => moveRegion!
                        moveRegion! >= 0 and ir[moveRegion!].kind != 1 and ir[moveRegion!].kind != 11 and ir[moveRegion!].kind != 19 and ir[moveRegion!].kind != 20
                            -> while {
                                ir[moveRegion!].parent => moveRegion!
                            }
                        events! -> push(MoveEvent {
                            siteIr: siteIndex!
                            bindingIr: moveBindingIr!
                            sourceModule: moveSourceModule!
                            symbol: moveSymbol!
                            regionIr: moveRegion!
                            memberIr: moveMemberIr!
                        })
                    }
                movedValueOrdinal! + 1 => movedValueOrdinal!
            }
        siteIndex! + 1 => siteIndex!
    }
    events!
}

public moves sources: [Text; ~] -> [MoveEvent; ~] {
    sources -> lower -> movesFrom
