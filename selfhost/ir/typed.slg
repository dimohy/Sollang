    sourceLowerIndex! < sourceCount and (profileSourceLimit < 0 or sourceLowerIndex! < profileSourceLimit)
        -> while {
            sourceLowerIndex! -> lowerSource(parallelFunctions, profileFunctionLimit, prepared, recursiveTypes, inferred, frozenRecursiveSemanticTypes, recursiveTypeFlags, frozenFunctionResultLegacyIndexByAst, frozenFunctionResultRootAstByAst, frozenFunctionNodeStartsByAst, frozenFunctionNodeCountsByAst, frozenFunctionNodeIndices, frozenInferredIndexByAst, frozenNearestLegacyIndexByAst, frozenNearestCanonicalTypeByAst, frozenRecursiveTypeByAst) => sourceResult
            results! -> len => sourceIrOffset
            0 => sourceNodeIndex!
            sourceNodeIndex! < (sourceResult.nodes -> len)
                -> while {
                    sourceResult.nodes[sourceNodeIndex!] => sourceNode!
                    sourceNode!.parent >= 0 -> if { sourceNode!.parent + sourceIrOffset => sourceNode!.parent }
                    sourceNode!.operand0 >= 0 -> if { sourceNode!.operand0 + sourceIrOffset => sourceNode!.operand0 }
                    sourceNode!.operand1 >= 0 -> if { sourceNode!.operand1 + sourceIrOffset => sourceNode!.operand1 }
                    sourceNode!.nextOperand >= 0 -> if { sourceNode!.nextOperand + sourceIrOffset => sourceNode!.nextOperand }
                    results! -> push(sourceNode!)
                    sourceNodeIndex! + 1 => sourceNodeIndex!
                }
            sourceLowerIndex! + 1 => sourceLowerIndex!
        }
    results! -> repairIndexedControlProducerWrappers(prepared)
    profileStopAfter == 0 -> if { results! -> return }
    results! -> normalizeResolvedContext(prepared, recursiveTypes, inferred, frozenRecursiveSemanticTypes, frozenRecursiveTypeByAst, recursiveReferences!, recursiveTypeFlags) => runtimeSymbols
    profileStopAfter == 1 -> if { results! -> return }
    results! -> sealResolvedContext(prepared, recursiveTypes, frozenRecursiveSemanticTypes, recursiveTypeFlags, runtimeSymbols) => finalWrappedValueByNode
    profileStopAfter == 2 -> if { results! -> return }
    results! -> finalizeResolvedContext(prepared, recursiveTypes, frozenRecursiveSemanticTypes, recursiveTypeFlags, runtimeSymbols, finalWrappedValueByNode)
    # Finalization can establish a cross-fragment intrinsic target after the
    # normal normalization phases. Seal process opcodes from that exact target
    # before the immutable Typed IR crosses into LLVM emission.
    results! -> normalizeResolvedProcessRuntime(prepared, recursiveTypes, inferred, frozenRecursiveSemanticTypes, frozenRecursiveTypeByAst, recursiveReferences!, recursiveTypeFlags)
    results!
}

public lowerResolvedContext prepared: semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet -> [TypedIrNode; ~] {
    prepared -> lowerResolvedContextWithMode(recursiveTypes, false, 3, -1, -1)
}

public lowerResolvedContextParallel prepared: semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet -> [TypedIrNode; ~] {
    prepared -> lowerResolvedContextWithMode(recursiveTypes, true, 3, -1, -1)
}

# Diagnostic-only boundary for compiler profiles. Phase -1 stops after shared
# lowering indexes, 0 after ordered source lowering, 1 after resolved-context
# normalization, 2 after sealing, and 3 after the complete finalization path
# used by normal compilation.
public profileResolvedContext prepared: semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, phase: Int -> [TypedIrNode; ~] {
    prepared -> lowerResolvedContextWithMode(recursiveTypes, false, phase, -1, -1)
}

# Diagnostic-only prefix boundary. It preserves source order and stops after
# lowering the first sourceLimit sources, without normalization or sealing.
public profileResolvedContextPrefix prepared: semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, sourceLimit: Int -> [TypedIrNode; ~] {
    prepared -> lowerResolvedContextWithMode(recursiveTypes, false, 0, sourceLimit, -1)
}

# Diagnostic-only nested prefix boundary. The function limit applies to each
# selected source; compare one source prefix with adjacent function limits.
public profileResolvedContextFunctionPrefix prepared: semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, sourceLimit: Int, functionLimit: Int -> [TypedIrNode; ~] {
    prepared -> lowerResolvedContextWithMode(recursiveTypes, false, 0, sourceLimit, functionLimit)
}

public lowerContext prepared: semanticContext.SemanticSnapshot -> [TypedIrNode; ~] {
    prepared -> expressionTypeIds.resolveContext => recursiveTypes
    prepared -> lowerResolvedContext(recursiveTypes) => result
    result
}

# Diagnostic counterpart to lowerContext that preserves the production native
# function-parallel lowering mode. Differential probes use the same prepared
# snapshot so any node-set drift is attributable to the lowering mode itself.
public lowerContextParallel prepared: semanticContext.SemanticSnapshot -> [TypedIrNode; ~] {
    prepared -> expressionTypeIds.resolveContext => recursiveTypes
    prepared -> lowerResolvedContextParallel(recursiveTypes) => result
    result
}


