# Grammar-provided stream slices are not unresolved calls. They have no module
# function target because the stream planner consumes them directly, so give
# them a distinct Typed IR identity instead of reusing the -1/-1/-1 sentinel.
streamSliceOpcode request: IntrinsicNameRequest -> Int {
    -1 => opcode!
    request.source -> sourceMatches(request.token.span.start, request.token.span.length, "take")
        -> if { -275 => opcode! }
    request.source -> sourceMatches(request.token.span.start, request.token.span.length, "skip")
        -> if { -276 => opcode! }
    opcode!
}

flowIntrinsicOpcode source: Text, tokens: ref [syntax.SyntaxToken; ~], tokenStart: Int, node: ast.AstNode -> Int {
    node.cstRuleId == grammar.ruleIdControlFlowExpression()
        or node.cstRuleId == grammar.ruleIdFlowExpression()
        -> if { -1 -> return }
    -1 => opcode!
    node.firstToken => tokenIndex!
    0 => typeArgumentDepth!
    0 => callArgumentDepth!
    false => afterFlowArrow!
    true => beforeBlock!
    beforeBlock! and tokenIndex! < node.firstToken + node.tokenCount
        -> while {
            tokens[tokenStart + tokenIndex!] => token
            token.kind == grammar.tokenIdLeftBrace()
                -> if { false => beforeBlock! } else {
                    token.kind == grammar.tokenIdLess()
                        -> if { typeArgumentDepth! + 1 => typeArgumentDepth! }
                    token.kind == grammar.tokenIdGreater() and typeArgumentDepth! > 0
                        -> if { typeArgumentDepth! - 1 => typeArgumentDepth! }
                    token.kind == grammar.tokenIdLeftParen()
                        -> if { callArgumentDepth! + 1 => callArgumentDepth! }
                    token.kind == grammar.tokenIdRightParen() and callArgumentDepth! > 0
                        -> if { callArgumentDepth! - 1 => callArgumentDepth! }
                    token.kind == grammar.tokenIdArrow() and typeArgumentDepth! == 0 and callArgumentDepth! == 0
                        -> if { true => afterFlowArrow! }
                    afterFlowArrow! and token.kind == grammar.tokenIdIdentifier() and typeArgumentDepth! == 0 and callArgumentDepth! == 0
                        -> if {
                            IntrinsicNameRequest { source: source, token: token } -> intrinsicOpcode => candidateOpcode
                            candidateOpcode != -1 -> if { candidateOpcode => opcode! }
                        }
                    tokenIndex! + 1 => tokenIndex!
                }
        }
