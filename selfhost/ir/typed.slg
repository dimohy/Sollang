            -> if { -209 => opcode! }
        (request.source -> byte(request.token.span.start)) == 109 and (request.source -> byte(request.token.span.start + 1)) == 97 and (request.source -> byte(request.token.span.start + 2)) == 116 and (request.source -> byte(request.token.span.start + 3)) == 101 and (request.source -> byte(request.token.span.start + 4)) == 114 and (request.source -> byte(request.token.span.start + 5)) == 105 and (request.source -> byte(request.token.span.start + 6)) == 97 and (request.source -> byte(request.token.span.start + 7)) == 108 and (request.source -> byte(request.token.span.start + 8)) == 105 and (request.source -> byte(request.token.span.start + 9)) == 122 and (request.source -> byte(request.token.span.start + 10)) == 101
