}

# Typed-empty dictionaries have no value-expression child for their capacity.
# Preserve the source capacity hint in the flat IR opcode so LLVM lowering does
# not have to reinterpret a type child as an integer literal.
dictionaryCapacityHint source: Text, node: ast.AstNode -> Int {
    -1 => capacity!
    0 => value!
    false => afterSemicolon!
    false => sawDigit!
    false => validHint!
    true => active!
    UIntSize(0) => offset!
    offset! < node.length and active! -> while {
        source -> byte(node.start + offset!) => character
        character == 59 -> if {
            true => afterSemicolon!
        } else {
            afterSemicolon! and character >= 48 and character <= 57
                -> if {
                    value! * 10 + Int(character - 48) => value!
                    true => sawDigit!
                }
            afterSemicolon! and not (character >= 48 and character <= 57) and character != 32 and character != 9 and character != 10 and character != 13 and character != 60 and character != 61
                -> if {
                    sawDigit! and (character == 126 or character == 125 or character == 93)
                        -> if { true => validHint! }
                    false => active!
                }
        }
        offset! + 1 => offset!
    }
    validHint! -> if { value! => capacity! }
    capacity!
}

# Array IR already uses small nonnegative opcodes for bounded storage. Encode a
# growable array's source capacity hint in a disjoint range for LLVM lowering.
arrayCapacityHint source: Text, node: ast.AstNode -> Int {
    source -> dictionaryCapacityHint(node) => capacity
    capacity >= 0 -> if { capacity + 1_000_000 } else { -1 }
}

lowerResolvedContextWithMode prepared: semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, parallelFunctions: Bool, profileStopAfter: Int, profileSourceLimit: Int, profileFunctionLimit: Int -> [TypedIrNode; ~] {
