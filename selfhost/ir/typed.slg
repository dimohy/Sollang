flowIntrinsicOpcode request: FlowIntrinsicRequest -> Int {
    -1 => nameToken!
    request.node.firstToken => tokenIndex!
    0 => typeArgumentDepth!
    0 => callArgumentDepth!
    true => beforeBlock!
    (beforeBlock! and tokenIndex! < request.node.firstToken + request.node.tokenCount) -> while {
        request.tokens[request.tokenStart + tokenIndex!] => token
        token.kind == grammar.tokenIdLeftBrace() -> if { false => beforeBlock! } else {
            token.kind == grammar.tokenIdLess() -> if { typeArgumentDepth! + 1 => typeArgumentDepth! }
            (token.kind == grammar.tokenIdGreater() and typeArgumentDepth! > 0) -> if { typeArgumentDepth! - 1 => typeArgumentDepth! }
            token.kind == grammar.tokenIdLeftParen() -> if { callArgumentDepth! + 1 => callArgumentDepth! }
            (token.kind == grammar.tokenIdRightParen() and callArgumentDepth! > 0) -> if { callArgumentDepth! - 1 => callArgumentDepth! }
            (token.kind == grammar.tokenIdIdentifier() and typeArgumentDepth! == 0 and callArgumentDepth! == 0) -> if { tokenIndex! => nameToken! }
            tokenIndex! + 1 => tokenIndex!
        }
    }
    -1 => opcode!
    nameToken! >= 0 -> if {
        IntrinsicNameRequest { source: request.source, token: request.tokens[request.tokenStart + nameToken!] } -> intrinsicOpcode => opcode!
    }
    opcode!
}

# The canonical recursive expression pass is authoritative. Older typed-IR
# consumers still read the shallow ExpressionType shape, so project it once in
# linear time instead of rerunning the legacy whole-AST inference pass.
legacyTypes recursive: expressionTypeIds.ExpressionTypeIdSet -> [expressionTypes.ExpressionType; ~] {
    [expressionTypes.ExpressionType; ~] => projected!
    0 => expressionIndex!
    expressionIndex! < (recursive.expressions -> len) -> while {
        recursive.expressions[expressionIndex!] => expression
        (expression.status == 0 and expression.typeId >= 0 and expression.typeId < (recursive.types -> len)) -> if {
            recursive.types[expression.typeId] => current
            current.origin => origin!
            current.module => targetModule!
            current.symbol => targetSymbol!
            -1 => keyOrigin!
            -1 => keyModule!
            -1 => valueOrigin!
            -1 => valueModule!
            current.kind != 1 -> if {
                10 + current.kind => origin!
                current.first >= 0 -> if {
                    recursive.types[current.first] => first
                    first.module => targetModule!
                    first.symbol => targetSymbol!
                }
                current.kind == 5 -> if {
                    current.first >= 0 -> if {
                        recursive.types[current.first] => key
                        key.symbol => targetModule!
                        key.origin => keyOrigin!
                        key.module => keyModule!
                    }
                    current.second >= 0 -> if {
                        recursive.types[current.second] => value
                        value.symbol => targetSymbol!
                        value.origin => valueOrigin!
                        value.module => valueModule!
                    }
                }
            }
            projected! -> push(expressionTypes.ExpressionType {
                sourceModule: expression.sourceModule
                astNode: expression.astNode
                origin: origin!
                targetModule: targetModule!
                targetSymbol: targetSymbol!
                keyOrigin: keyOrigin!
                keyModule: keyModule!
                valueOrigin: valueOrigin!
                valueModule: valueModule!
            })
        }
        expressionIndex! + 1 => expressionIndex!
    }
    projected!
}

# Typed-empty dictionaries have no value-expression child for their capacity.
# Preserve the source capacity hint in the flat IR opcode so LLVM lowering does
# not have to reinterpret a type child as an integer literal.
dictionaryCapacityHint source: Text, node: ast.AstNode -> Int {
    -1 => capacity!
    0 => value!
    false => afterSemicolon!
    false => sawDigit!
    false => validHint!
    true => active!
    UIntSize(0) => offset!
    (offset! < node.length and active!) -> while {
        source -> byte(node.start + offset!) => character
        character == UInt8(59) -> if {
            true => afterSemicolon!
        } else {
            (afterSemicolon! and character >= UInt8(48) and character <= UInt8(57)) -> if {
                value! * 10 + Int(character - UInt8(48)) => value!
                true => sawDigit!
            }
            (afterSemicolon! and not (character >= UInt8(48) and character <= UInt8(57)) and character != UInt8(32) and character != UInt8(9) and character != UInt8(10) and character != UInt8(13)) -> if {
                (sawDigit! and character == UInt8(126)) -> if { true => validHint! }
                false => active!
            }
        }
        offset! + UIntSize(1) => offset!
    }
    validHint! -> if { value! => capacity! }
    capacity!
}

public lowerContext prepared: semanticContext.SemanticSnapshot -> [TypedIrNode; ~] {
    freezeSemanticTypes values: move [typeIds.SemanticType; ~] -> [typeIds.SemanticType; ~] {
        values
    }
    freezeExpressionTypes values: move [expressionTypeIds.ExpressionTypeId; ~] -> [expressionTypeIds.ExpressionTypeId; ~] {
        values
    }
    freezeLegacyExpressionTypes values: move [expressionTypes.ExpressionType; ~] -> [expressionTypes.ExpressionType; ~] {
        values
    }
    freezeInts values: move [Int; ~] -> [Int; ~] {
        values
    }
    nominalVariantTag sourceIndex: Int, variantToken: syntax.SyntaxToken -> Int {
        prepared.package.ranges[sourceIndex] => variantRange
        prepared.package.sources[sourceIndex] -> len => variantSourceLength
        prepared.package.sources[sourceIndex] -> slice(UIntSize(0), variantSourceLength) => variantSource
        -1 => tag!
        0 => candidateIndex!
        candidateIndex! < variantRange.astCount -> while {
            prepared.package.nodes[variantRange.astStart + candidateIndex!] => candidate
            (candidate.kind == 27 and candidate.parent >= 0 and prepared.package.nodes[variantRange.astStart + candidate.parent].kind == 4 and candidate.payloadToken >= 0) -> if {
                prepared.package.tokens[variantRange.tokenStart + candidate.payloadToken] => candidateToken
                candidateToken.span.length == variantToken.span.length -> if {
                    true => sameName!
                    UIntSize(0) => byteIndex!
                    (sameName! and byteIndex! < variantToken.span.length) -> while {
                        (variantSource -> byte(candidateToken.span.start + byteIndex!)) != (variantSource -> byte(variantToken.span.start + byteIndex!)) -> if { false => sameName! }
                        byteIndex! + UIntSize(1) => byteIndex!
                    }
                    sameName! -> if {
                        0 => ordinal!
                        0 => ordinalSearch!
                        ordinalSearch! < variantRange.astCount -> while {
                            prepared.package.nodes[variantRange.astStart + ordinalSearch!] => sibling
                            (sibling.kind == 27 and sibling.parent == candidate.parent and sibling.start < candidate.start) -> if { ordinal! + 1 => ordinal! }
                            ordinalSearch! + 1 => ordinalSearch!
                        }
                        ordinal! => tag!
                    }
                }
            }
            candidateIndex! + 1 => candidateIndex!
        }
        tag! < 0 -> if {
            false => ambiguousImportedTag!
            0 => importedSourceIndex!
            (importedSourceIndex! < (prepared.package.ranges -> len) and not ambiguousImportedTag!) -> while {
                prepared.package.ranges[importedSourceIndex!] => importedRange
