namespace sollang.compiler.cli_workspace

import sollang.compiler.project
import sollang.compiler.workspace
import sys.file as file
import sys.path as path

public struct WorkspaceInput {
    status: Int
    projectOption: Text
    sourceDirectory: Text
}

textEndsWith value: Text, suffix: Text -> Bool {
    value -> len => valueLength
    suffix -> len => suffixLength
    suffixLength <= valueLength => matches!
    valueLength - suffixLength => start
    UIntSize(0) => index!
    (matches! and index! < suffixLength) -> while {
        (value -> byte(start + index!)) != (suffix -> byte(index!)) -> if { false => matches! }
        index! + UIntSize(1) => index!
    }
    matches!
}

textEquals left: Text, right: Text -> Bool {
    (left -> len) == (right -> len) => matches!
    UIntSize(0) => index!
    (matches! and index! < (left -> len)) -> while {
        (left -> byte(index!)) != (right -> byte(index!)) -> if { false => matches! }
        index! + UIntSize(1) => index!
    }
    matches!
}

directoryOf value: Text -> Text {
    UIntSize(0) => lastSeparator!
    false => found!
    UIntSize(0) => index!
    index! < (value -> len) -> while {
        value -> byte(index!) => current
        (current == UInt8(47) or current == UInt8(92)) -> if {
            index! => lastSeparator!
            true => found!
        }
        index! + UIntSize(1) => index!
    }
    found! -> if {
        value -> slice(UIntSize(0), lastSeparator!) => directory
        directory -> return
    }
    "."
}

workspacePath option: Text, storage: mut Arena -> Text {
    option -> textEndsWith(".workspace") -> if {
        option -> return
    }
    "$option/sollang.workspace" -> materialize(storage)
}

memberText source: file.SourceText, member: workspace.WorkspaceMember -> Text {
    source -> slice(member.start, member.length)
}

memberMatches source: file.SourceText, member: workspace.WorkspaceMember, directory: Text, requestedPackage: Text -> Bool uses File {
    source -> memberText(member) => relative
    Arena(0) => projectPathStorage!
    "$directory/$relative/sollang.project" -> materialize(projectPathStorage!) => projectPath
    projectPath -> path.fromText(path.nativeStyle()) => projectFile!
    projectFile! -> file.mapPath => projectSource!
    projectSource! -> len => projectSourceLength
    projectSource! -> slice(UIntSize(0), projectSourceLength) => projectSourceView
    projectSourceView -> project.parse => parsed!
    parsed!.status == 0 => matches!
    matches! -> if {
        projectSource! -> slice(parsed!.name.start, parsed!.name.length) => name
        name -> textEquals(requestedPackage) => matches!
    }
    matches!
}

emptyInput status: Int -> WorkspaceInput {
    WorkspaceInput { status: status, projectOption: "", sourceDirectory: "" }
}

# Status: 0 valid, 1 invalid workspace, 2 requested package missing,
# 3 package selection required.
public load option: Text, requestedPackage: Text, manifestStorage: mut Arena, projectStorage: mut Arena -> WorkspaceInput uses File {
    option -> workspacePath(manifestStorage) => manifest
    manifest -> directoryOf => directory
    manifest -> path.fromText(path.nativeStyle()) => manifestFile!
    manifestFile! -> file.mapPath => source!
    source! -> len => sourceLength
    source! -> slice(UIntSize(0), sourceLength) => sourceView
    sourceView -> workspace.parse => parsed!
    parsed!.status != 0 -> if {
        parsed!.status + 100 => parseStatus
        parseStatus -> emptyInput => failure!
        failure! -> return
    }

    -1 => selectedIndex!
    (requestedPackage -> len) > UIntSize(0) -> if {
        0 => index!
        index! < (parsed!.members -> len) -> while {
            source! -> memberMatches(parsed!.members[index!], directory, requestedPackage) -> if {
                index! => selectedIndex!
            }
            index! + 1 => index!
        }
        selectedIndex! < 0 -> if {
            2 -> emptyInput => failure!
            failure! -> return
        }
    } else {
        (parsed!.members -> len) == 1 -> if {
            0 => selectedIndex!
        } else {
            3 -> emptyInput => failure!
            failure! -> return
        }
    }

    source! -> memberText(parsed!.members[selectedIndex!]) => relative
    "$directory/$relative" -> materialize(projectStorage) => projectOption
    WorkspaceInput { status: 0, projectOption: projectOption, sourceDirectory: directory } => result!
    result!
}
