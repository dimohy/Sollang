namespace sollang.compiler.semantic.modules

import sollang.compiler.ast as ast
import sollang.compiler.lexer as lexer
import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.symbols as symbols
import sollang.compiler.syntax as syntax
import sys.file as file
import syntax.generated.slg as grammar

public struct ModuleIdentity {
    public sourceIndex: Int
    public pathHash: UInt64
    public pathStart: UIntSize
    public pathLength: UIntSize
    public importCount: Int
}

# Complete namespace and containing declaration path, shared by metadata and
# semantic registration. Source symbol coordinates stay local to their file.
public appendDeclarationNameBytes source: Text, identity: ModuleIdentity, range: analysis.SourceAnalysisRange, tokens: ref [syntax.SyntaxToken; ~], declarations: ref [symbols.Symbol; ~], declaration: Int, bytes: mut [UInt8; ~] -> Unit {
    [UInt64; ~] => words!
    appendLogicalNameWords(source, identity, range, tokens, words!)
    words! -> each word { bytes -> push(UInt8(word)) }
    [Int; ~] => owners!
    declaration => owner!
    owner! >= 0 -> while {
        owners! -> push(owner!)
        declarations[range.symbolStart + owner!].parent => owner!
    }
    (owners! -> len) - 1 => index!
    index! >= 0 -> while {
        (bytes -> len) > 0 -> if { bytes -> push('.') }
        declarations[range.symbolStart + owners![index!]].nameToken => nameToken
        tokens[range.tokenStart + nameToken].span => span
        UIntSize(0) => byte!
        byte! < span.length -> while {
            bytes -> push(source -> byte(span.start + byte!))
            byte! + 1 => byte!
        }
        index! - 1 => index!
    }
}

public struct ImportEdge {
    public sourceModule: Int
    public targetHash: UInt64
    public pathStart: UIntSize
    public pathLength: UIntSize
    public aliasToken: Int
}

public appendLogicalNameWords source: Text, identity: ModuleIdentity, range: analysis.SourceAnalysisRange, tokens: ref [syntax.SyntaxToken; ~], words: mut [UInt64; ~] -> Unit {
    range.tokenStart + range.tokenCount => tokenEnd
    tokens -> nextPathToken(range.tokenStart, tokenEnd, identity) => index!
    index! < tokenEnd -> while {
        tokens[index!] => token
        UIntSize(0) => offset!
        offset! < token.span.length -> while {
            words -> push(UInt64(source -> byte(token.span.start + offset!)))
            offset! + 1 => offset!
        }
        tokens -> nextPathToken(index! + 1, tokenEnd, identity) => index!
    }
}

# Namespace trivia does not participate in parsed module identity. Keep the
# token comparison after the hash prefilter so collisions never grant access.
nextPathToken tokens: ref [syntax.SyntaxToken; ~], cursor: Int, tokenEnd: Int, identity: ModuleIdentity -> Int {
    cursor => current!
    current! < tokenEnd -> while {
        tokens[current!] => token
        token.span.start >= identity.pathStart + identity.pathLength
            -> if { tokenEnd -> return }
        token.span.start >= identity.pathStart
            and token.kind != grammar.triviaIdWhitespace() and token.kind != grammar.triviaIdComment()
            -> if { current! -> return }
        current! + 1 => current!
    }
    tokenEnd
}
sameLogicalPath leftText: Text, rightText: Text, left: ModuleIdentity, right: ModuleIdentity, leftRange: analysis.SourceAnalysisRange, rightRange: analysis.SourceAnalysisRange, tokens: ref [syntax.SyntaxToken; ~] -> Bool {
    left.pathHash != right.pathHash -> if { false -> return }
    left.pathLength == 0 or right.pathLength == 0
        -> if { left.pathLength == 0 and right.pathLength == 0 -> return }
    leftRange.tokenStart + leftRange.tokenCount => leftEnd
    rightRange.tokenStart + rightRange.tokenCount => rightEnd
    tokens -> nextPathToken(leftRange.tokenStart, leftEnd, left) => leftIndex!
    tokens -> nextPathToken(rightRange.tokenStart, rightEnd, right) => rightIndex!
    leftIndex! == leftEnd or rightIndex! == rightEnd
        -> if { false -> return }
    leftIndex! < leftEnd and rightIndex! < rightEnd
        -> while {
            tokens[leftIndex!] => leftToken
            tokens[rightIndex!] => rightToken
            leftToken.kind != rightToken.kind or leftToken.span.length != rightToken.span.length
                -> if { false -> return }
            UIntSize(0) => byteIndex!
            byteIndex! < leftToken.span.length -> while {
                (leftText -> byte(leftToken.span.start + byteIndex!)) != (rightText -> byte(rightToken.span.start + byteIndex!))
                    -> if { false -> return }
                byteIndex! + 1 => byteIndex!
            }
            tokens -> nextPathToken(leftIndex! + 1, leftEnd, left) => leftIndex!
            tokens -> nextPathToken(rightIndex! + 1, rightEnd, right) => rightIndex!
        }
    leftIndex! == leftEnd and rightIndex! == rightEnd
}
public logicalNameIs source: Text, identity: ModuleIdentity, range: analysis.SourceAnalysisRange, tokens: ref [syntax.SyntaxToken; ~], expected: Text -> Bool {
    range.tokenStart + range.tokenCount => tokenEnd
    tokens -> nextPathToken(range.tokenStart, tokenEnd, identity) => tokenIndex!
    UIntSize(0) => expectedIndex!
    tokenIndex! < tokenEnd -> while {
        tokens[tokenIndex!] => token
        UIntSize(0) => tokenByte!
        tokenByte! < token.span.length -> while {
            expectedIndex! >= (expected -> len)
                -> if { false -> return }
            (source -> byte(token.span.start + tokenByte!)) != (expected -> byte(expectedIndex!))
                -> if { false -> return }
            tokenByte! + 1 => tokenByte!
            expectedIndex! + 1 => expectedIndex!
        }
        tokens -> nextPathToken(tokenIndex! + 1, tokenEnd, identity) => tokenIndex!
    }
    expectedIndex! == (expected -> len)
}
public sameLogicalSource sources: ref [Text; ~], identities: ref [ModuleIdentity; ~], leftSource: Int, rightSource: Int, tokens: ref [syntax.SyntaxToken; ~], ranges: ref [analysis.SourceAnalysisRange; ~] -> Bool {
    leftSource < 0 or leftSource >= (identities -> len) or leftSource >= (sources -> len) or leftSource >= (ranges -> len)
        or rightSource < 0 or rightSource >= (identities -> len) or rightSource >= (sources -> len) or rightSource >= (ranges -> len)
        -> if { false -> return }
    sameLogicalPath(sources[leftSource], sources[rightSource], identities[leftSource], identities[rightSource], ranges[leftSource], ranges[rightSource], tokens)
}
public sameLogicalAnalyzedSource sources: ref [file.SourceText; ~], identities: ref [ModuleIdentity; ~], leftSource: Int, rightSource: Int, tokens: ref [syntax.SyntaxToken; ~], ranges: ref [analysis.SourceAnalysisRange; ~] -> Bool {
    leftSource < 0 or leftSource >= (identities -> len) or leftSource >= (sources -> len) or leftSource >= (ranges -> len)
        or rightSource < 0 or rightSource >= (identities -> len) or rightSource >= (sources -> len) or rightSource >= (ranges -> len)
        -> if { false -> return }
    sources[leftSource] -> slice(UIntSize(0), sources[leftSource] -> len) => leftText
    sources[rightSource] -> slice(UIntSize(0), sources[rightSource] -> len) => rightText
    sameLogicalPath(leftText, rightText, identities[leftSource], identities[rightSource], ranges[leftSource], ranges[rightSource], tokens)
}

public importTargetsAnalyzedModule package: ref analysis.PackageAnalysis, identities: ref [ModuleIdentity; ~], edge: ImportEdge, moduleIndex: Int -> Bool {
    moduleIndex < 0 or moduleIndex >= (identities -> len)
        or edge.sourceModule < 0 or edge.sourceModule >= (package.sources -> len)
        or edge.sourceModule >= (package.ranges -> len) or edge.pathLength == 0
        -> if { false -> return }
    identities[moduleIndex] => target
    target.sourceIndex < 0 or target.sourceIndex >= (package.sources -> len)
        or target.sourceIndex >= (package.ranges -> len)
        -> if { false -> return }
    ModuleIdentity { sourceIndex: edge.sourceModule, pathHash: edge.targetHash, pathStart: edge.pathStart, pathLength: edge.pathLength, importCount: 0 } => requested
    package.sources[edge.sourceModule] -> slice(UIntSize(0), package.sources[edge.sourceModule] -> len) => leftText
    package.sources[target.sourceIndex] -> slice(UIntSize(0), package.sources[target.sourceIndex] -> len) => rightText
    sameLogicalPath(leftText, rightText, requested, target, package.ranges[edge.sourceModule], package.ranges[target.sourceIndex], package.tokens)
}

public identities sources: [Text; ~] -> [ModuleIdentity; ~] {
    sources -> analysis.analyze => package
    package -> identitiesAnalyzed
}
public imports sources: [Text; ~] -> [ImportEdge; ~] {
    sources -> analysis.analyze => package
    package -> importsAnalyzed
}
public identitiesAnalyzed package: analysis.PackageAnalysis -> [ModuleIdentity; ~] {
    [ModuleIdentity; ~] => modules!
    package.sources -> len => sourceCount
    0 => sourceIndex!
    sourceIndex! < sourceCount -> while {
        package.sources[sourceIndex!] -> len => sourceLength
        package.sources[sourceIndex!] -> slice(UIntSize(0), sourceLength) => source
        package.ranges[sourceIndex!] => sourceRange
        UInt64(0) => pathHash!
        UIntSize(0) => pathStart!
        UIntSize(0) => pathLength!
        0 => importCount!
        sourceRange.astCount => nodeCount
        0 => nodeIndex!
        nodeIndex! < nodeCount -> while {
            package.nodes[sourceRange.astStart + nodeIndex!] => node
            node.kind == 2 -> if { importCount! + 1 => importCount! }
            node.kind == 1 -> if {
                0 => pathIndex!
                pathIndex! < nodeCount -> while {
                    package.nodes[sourceRange.astStart + pathIndex!] => pathNode
                    pathNode.parent == nodeIndex! and pathNode.kind == 16
                        -> if {
                            pathNode.start => pathStart!
                            pathNode.length => pathLength!
                            1469598103934665603 => pathHash!
                            pathNode.firstToken => pathToken!
                            pathNode.firstToken + pathNode.tokenCount => pathTokenEnd
                            pathToken! < pathTokenEnd -> while {
                                package.tokens[sourceRange.tokenStart + pathToken!] => token
                                token.kind != grammar.triviaIdWhitespace() and token.kind != grammar.triviaIdComment()
                                    -> if {
                                        UIntSize(0) => pathByte!
                                        pathByte! < token.span.length -> while {
                                            source -> byte(token.span.start + pathByte!) => value
                                            pathHash! * 1099511628211 + UInt64(value) => pathHash!
                                            pathByte! + 1 => pathByte!
                                        }
                                    }
                                pathToken! + 1 => pathToken!
                            }
                            nodeCount => pathIndex!
                        } else {
                            pathIndex! + 1 => pathIndex!
                        }
                }
            }
            nodeIndex! + 1 => nodeIndex!
        }
        ModuleIdentity {
            sourceIndex: sourceIndex!
            pathHash: pathHash!
            pathStart: pathStart!
            pathLength: pathLength!
            importCount: importCount!
        } => module
        modules! -> push(module)
        sourceIndex! + 1 => sourceIndex!
    }
    modules!
}


public importsAnalyzed package: analysis.PackageAnalysis -> [ImportEdge; ~] {
    [ImportEdge; ~] => edges!
    package.sources -> len => sourceCount
    0 => sourceIndex!
    sourceIndex! < sourceCount -> while {
        package.sources[sourceIndex!] -> len => sourceLength
        package.sources[sourceIndex!] -> slice(UIntSize(0), sourceLength) => source
        package.ranges[sourceIndex!] => sourceRange
        sourceRange.astCount => nodeCount
        0 => nodeIndex!
        nodeIndex! < nodeCount -> while {
            package.nodes[sourceRange.astStart + nodeIndex!] => node
            node.kind == 2 -> if {
                UInt64(0) => targetHash!
                UIntSize(0) => importStart!
                UIntSize(0) => importLength!
                -1 => aliasToken!
                -1 => defaultAliasToken!
                0 => pathIndex!
                pathIndex! < nodeCount -> while {
                    package.nodes[sourceRange.astStart + pathIndex!] => pathNode
                    pathNode.parent == nodeIndex! and pathNode.kind == 16
                        -> if {
                            pathNode.start => importStart!
                            pathNode.length => importLength!
                            1469598103934665603 => targetHash!
                            pathNode.firstToken => importPathToken!
                            pathNode.firstToken + pathNode.tokenCount => importPathEnd
                            importPathToken! < importPathEnd -> while {
                                package.tokens[sourceRange.tokenStart + importPathToken!] => token
                                token.kind == grammar.tokenIdIdentifier()
                                    -> if {
                                        importPathToken! => defaultAliasToken!
                                    }
                                token.kind != grammar.triviaIdWhitespace() and token.kind != grammar.triviaIdComment()
                                    -> if {
                                        UIntSize(0) => importByte!
                                        importByte! < token.span.length -> while {
                                            source -> byte(token.span.start + importByte!) => value
                                            targetHash! * 1099511628211 + UInt64(value) => targetHash!
                                            importByte! + 1 => importByte!
                                        }
                                    }
                                importPathToken! + 1 => importPathToken!
                            }
                            nodeCount => pathIndex!
                        } else {
                            pathIndex! + 1 => pathIndex!
                        }
                }
                false => afterAs!
                node.firstToken => importToken!
                node.firstToken + node.tokenCount => importTokenEnd
                importToken! < importTokenEnd -> while {
                    package.tokens[sourceRange.tokenStart + importToken!] => token
                    afterAs! -> if {
                        token.kind == grammar.tokenIdIdentifier()
                            -> if {
                                importToken! => aliasToken!
                                importTokenEnd => importToken!
                            } else {
                                importToken! + 1 => importToken!
                            }
                    } else {
                        token.kind == grammar.tokenIdIdentifier()
                            -> if {
                                token.span.length == 2 -> if {
                                    source -> byte(token.span.start) => asByte0
                                    source -> byte(token.span.start + 1) => asByte1
                                    asByte0 == 97 and asByte1 == 115 -> if { true => afterAs! }
                                }
                            }
                        importToken! + 1 => importToken!
                    }
                }
                aliasToken! < 0 -> if { defaultAliasToken! => aliasToken! }
                ImportEdge {
                    sourceModule: sourceIndex!
                    targetHash: targetHash!
                    pathStart: importStart!
                    pathLength: importLength!
                    aliasToken: aliasToken!
                } => edge
                edges! -> push(edge)
            }
            nodeIndex! + 1 => nodeIndex!
        }
        sourceIndex! + 1 => sourceIndex!
    }
    edges!
}
