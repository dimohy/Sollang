                }
            bareNameOffset! + 1 => bareNameOffset!
        }
        0 => bareAstOffset!
        bareAstOffset! < bareRange.astCount -> while {
            package.nodes[bareRange.astStart + bareAstOffset!] => bareNode
            bareNode.kind == 15 -> if {
                false => bareResolved!
                0 => bareResolutionOffset!
