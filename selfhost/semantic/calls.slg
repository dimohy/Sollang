        resultIndex! + 1 => resultIndex!
    }
    filteredResults!
}

public resolveModulesAnalyzed package: analysis.PackageAnalysis -> [ModuleCallResolution; ~] {
    package -> typeIds.resolveAnalyzed => semantic
    package -> resolveModulesTyped(semantic)
}
