namespace sollang.compiler.semantic.calls

import sollang.compiler.ast as ast
import sollang.compiler.lexer as lexer
import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.module_resolve as moduleResolve
import sollang.compiler.semantic.modules as modules
import sollang.compiler.semantic.qualified as qualified
import sollang.compiler.semantic.symbols as symbols
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.syntax as syntax
import syntax.generated.slg as grammar

public struct CallResolution {
    public callAst: Int
    public nameToken: Int
    public functionSymbol: Int
    public status: Int
}

public struct ModuleCallResolution {
    public sourceModule: Int
    public callAst: Int
    public origin: Int
    public targetModule: Int
    public targetSourceModule: Int
    public functionSymbol: Int
    public status: Int
}

public struct ModuleCallRequest {
    public sources: [Text; ~]
    public modules: [modules.ModuleIdentity; ~]
    public qualified: [qualified.QualifiedResolution; ~]
}

struct TokenNameRequest {
    source: Text
    token: syntax.SyntaxToken
    expected: Text
}

struct RuntimeNameRequest {
    source: Text
    token: syntax.SyntaxToken
}

struct DeclaredMethodName {
    sourceModule: Int
    nameToken: Int
}

struct TypedCallCandidate {
    callAst: Int
    nameToken: Int
    functionSymbol: Int
    status: Int
    intrinsicFallback: Bool
}

tokenNameIs request: TokenNameRequest -> Bool {
    request.token.span.length == (request.expected -> len) => equal!
    UIntSize(0) => index!
    equal! and index! < request.token.span.length
        -> while {
            (request.source -> byte(request.token.span.start + index!)) != (request.expected -> byte(index!))
                -> if { false => equal! }
            index! + 1 => index!
        }
    equal!
}

# Index every path ancestor that already contains a real call-expression
# owner. Qualified value projections can then reject borrowed call identity in
# O(1) instead of rescanning the AST for each qualified candidate.
indexQualifiedPathCallOwners nodes: ref [ast.AstNode; ~], nodeOffset: Int, nodeCount: Int -> [Int; ~] {
    [Int; ~] => owners!
    0 => ownerSeed!
    ownerSeed! < nodeCount
        -> while {
            owners! -> push(-1)
            ownerSeed! + 1 => ownerSeed!
        }
    0 => callOwnerSearch!
    callOwnerSearch! < nodeCount
        -> while {
            nodes[nodeOffset + callOwnerSearch!] => candidate
            candidate.kind == 11 and candidate.cstRuleId == grammar.ruleIdCallExpression()
                -> if {
                    candidate.parent => ancestor!
                    ancestor! >= 0 -> while {
                        nodes[nodeOffset + ancestor!] => ancestorNode
                        ancestorNode.kind == 36 and ancestorNode.start == candidate.start
                            -> if {
                                owners![ancestor!] => existingOwner
                                existingOwner < 0 or candidate.length < nodes[nodeOffset + existingOwner].length
                                    -> if { callOwnerSearch! => owners![ancestor!] }
                            }
                        ancestorNode.parent => ancestor!
                    }
                }
            callOwnerSearch! + 1 => callOwnerSearch!
        }
    owners!
}

# Negative symbols are stable built-in aliases used before stdlib-qualified
# resolution. -101/-102 are retained for typed-IR compatibility.
runtimeFunctionSymbol request: RuntimeNameRequest -> Int {
    -1 => runtimeSymbol!
    TokenNameRequest { source: request.source, token: request.token, expected: "print" } -> tokenNameIs
        -> if { -101 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "println" } -> tokenNameIs
        -> if { -102 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "readInt" } -> tokenNameIs
        -> if { -103 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "seedRandom" } -> tokenNameIs
        -> if { -104 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "randomBelow" } -> tokenNameIs
        -> if { -105 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "openIntWriter" } -> tokenNameIs
        -> if { -106 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "writeInt" } -> tokenNameIs
        -> if { -107 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "closeIntWriter" } -> tokenNameIs
        -> if { -108 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "openIntReader" } -> tokenNameIs
        -> if { -109 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "closestInt" } -> tokenNameIs
        -> if { -110 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "closeIntReader" } -> tokenNameIs
        -> if { -111 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "nowMillis" } -> tokenNameIs
        -> if { -112 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "sleep" } -> tokenNameIs
        -> if { -113 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "flush" } -> tokenNameIs
        -> if { -114 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "limitParallelWorkers" } -> tokenNameIs
        -> if { -115 => runtimeSymbol! }
    TokenNameRequest { source: request.source, token: request.token, expected: "eprintln" } -> tokenNameIs
        -> if { -116 => runtimeSymbol! }
    runtimeSymbol!
}

intrinsicFlowTarget request: RuntimeNameRequest -> Bool {
    false => intrinsic!
    TokenNameRequest { source: request.source, token: request.token, expected: "each" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "yield" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "emit" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "await" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "cancel" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "parallel" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "tryParallel" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "used" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "alloc" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "store" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "load" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "reset" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "materialize" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "flush" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "len" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "byte" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "slice" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "capacity" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "reserve" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "push" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "take" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "append" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "put" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "putIfAbsent" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "set" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "clear" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "contains" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "count" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "pushFront" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "pushBack" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "front" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "back" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "popFront" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "popBack" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "peek" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "pop" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "insert" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "remove" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "updated" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "readAt" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "writeAt" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "readIntoAt" } -> tokenNameIs
        -> if { true => intrinsic! }
    TokenNameRequest { source: request.source, token: request.token, expected: "writeRangeAt" } -> tokenNameIs
        -> if { true => intrinsic! }
    intrinsic!
}

# Intrinsic vocabulary is contextual, not reserved. Index only declarations
# whose spelling can collide, once per package, then preserve matching flow
# calls for exact typed-receiver resolution.
declaredIntrinsicMethodNames package: ref analysis.PackageAnalysis -> [DeclaredMethodName; ~] {
    [DeclaredMethodName; ~] => names!
    0 => rangeIndex!
    rangeIndex! < (package.ranges -> len) -> while {
        package.ranges[rangeIndex!] => candidateRange
        package.sources[candidateRange.sourceModule] -> len => candidateSourceLength
        package.sources[candidateRange.sourceModule]
            -> slice(UIntSize(0), candidateSourceLength) => candidateSource
        0 => symbolOffset!
        symbolOffset! < candidateRange.symbolCount -> while {
            package.symbols[candidateRange.symbolStart + symbolOffset!] => candidate
            candidate.kind == 31 and candidate.nameToken >= 0
                -> if {
                    candidateRange.tokenStart + candidate.nameToken => candidateNameToken
                    package.tokens[candidateNameToken] => candidateName
                    RuntimeNameRequest { source: candidateSource, token: candidateName }
                        -> intrinsicFlowTarget => intrinsicName
                    intrinsicName -> if {
                        names! -> push(DeclaredMethodName {
                            sourceModule: candidateRange.sourceModule
                            nameToken: candidateNameToken
                        })
                    }
                }
            symbolOffset! + 1 => symbolOffset!
        }
        rangeIndex! + 1 => rangeIndex!
    }
    names!
}

declaredPackageMethodNamed package: ref analysis.PackageAnalysis, sourceIndex: Int, name: syntax.SyntaxToken, names: ref [DeclaredMethodName; ~] -> Bool {
    false => found!
    0 => nameIndex!
    nameIndex! < (names -> len) and not found! -> while {
        names[nameIndex!] => candidate
        package.tokens[candidate.nameToken] => candidateName
        candidateName.span.length == name.span.length => equal!
        UIntSize(0) => byteIndex!
        equal! and byteIndex! < name.span.length -> while {
            package.sources[candidate.sourceModule]
                -> byte(candidateName.span.start + byteIndex!) => candidateByte
            package.sources[sourceIndex]
                -> byte(name.span.start + byteIndex!) => nameByte
            candidateByte != nameByte -> if { false => equal! }
            byteIndex! + 1 => byteIndex!
        }
        equal! -> if {
            true => found!
        }
        nameIndex! + 1 => nameIndex!
    }
    found!
}

# Status 0 is a resolved local function and 2 is an unresolved call target.
public resolve source: Text -> [CallResolution; ~] {
    source -> ast.lower => nodes
    source -> lexer.lex => tokens
    nodes -> symbols.collectPrepared => table
    [CallResolution; ~] => resolved!
    0 => astIndex!
    astIndex! < (nodes -> len) -> while {
        nodes[astIndex!] => node
        false => hasControlTarget!
        false => hasFlowCallTarget!
        false => hasQualifiedFlowTarget!
        0 => controlTargetSearch!
        controlTargetSearch! < (nodes -> len) -> while {
            nodes[controlTargetSearch!].parent == astIndex! and (nodes[controlTargetSearch!].kind == 42 or nodes[controlTargetSearch!].kind == 44)
                -> if { true => hasControlTarget! }
            controlTargetSearch! + 1 => controlTargetSearch!
        }
        0 => flowTargetSearch!
        flowTargetSearch! < (nodes -> len) -> while {
            nodes[flowTargetSearch!].parent == astIndex! and nodes[flowTargetSearch!].kind == 16
                -> if { true => hasFlowCallTarget! }
            flowTargetSearch! + 1 => flowTargetSearch!
        }
        node.firstToken => flowTokenIndex!
        node.kind == 10 and flowTokenIndex! < node.firstToken + node.tokenCount
            -> while {
                tokens[flowTokenIndex!].kind == grammar.tokenIdDot()
                    -> if { true => hasQualifiedFlowTarget! }
                flowTokenIndex! + 1 => flowTokenIndex!
            }
        (node.kind == 10 and hasFlowCallTarget!) or (node.kind == 11 and (node.cstRuleId == grammar.ruleIdCallExpression() or node.cstRuleId == grammar.ruleIdTypeApplicationExpression())) or node.kind == 48 or node.kind == 77
            -> if {
                -1 => callNameToken!
                node.kind == 48 or node.kind == 77 -> if { node.payloadToken => callNameToken! }
                node.kind == 10 -> if {
                    0 => flowNameSearch!
                    flowNameSearch! < (nodes -> len) -> while {
                        nodes[flowNameSearch!].parent == astIndex!
                            and nodes[flowNameSearch!].kind == 16
                            and nodes[flowNameSearch!].payloadToken > callNameToken!
                            -> if {
                                nodes[flowNameSearch!].payloadToken => callNameToken!
                            }
                        flowNameSearch! + 1 => flowNameSearch!
                    }
                }
                node.firstToken => tokenIndex!
                false => inFlowTypeArgument!
                false => inFlowCallArguments!
                tokenIndex! < node.firstToken + node.tokenCount and node.kind != 48 and node.kind != 77 and callNameToken! < 0
                    -> while {
                        tokens[tokenIndex!].kind == grammar.tokenIdLess()
                            -> if { true => inFlowTypeArgument! }
                        tokens[tokenIndex!].kind == grammar.tokenIdGreater()
                            -> if { false => inFlowTypeArgument! }
                        tokens[tokenIndex!].kind == grammar.tokenIdLeftParen()
                            -> if { true => inFlowCallArguments! }
                        tokens[tokenIndex!].kind == grammar.tokenIdRightParen()
                            -> if { false => inFlowCallArguments! }
                        tokens[tokenIndex!].kind == grammar.tokenIdIdentifier() and not inFlowTypeArgument! and not inFlowCallArguments!
                            -> if { tokenIndex! => callNameToken! }
                        tokenIndex! + 1 => tokenIndex!
                    }
                callNameToken! >= 0 -> if {
                    -1 => functionSymbol!
                    node.parent => callerAst!
                    -1 => callerFunctionAst!
                    callerAst! >= 0 and callerFunctionAst! < 0 -> while {
                        nodes[callerAst!] => callerNode
                        callerNode.kind == 7 or callerNode.kind == 31
                            -> if { callerAst! => callerFunctionAst! } else { callerNode.parent => callerAst! }
                    }
                    -1 => callerFunctionSymbol!
                    0 => callerSymbolSearch!
                    callerSymbolSearch! < (table -> len) and callerFunctionSymbol! < 0
                        -> while {
                            (table[callerSymbolSearch!].kind == 7 or table[callerSymbolSearch!].kind == 31) and table[callerSymbolSearch!].astNode == callerFunctionAst!
                                -> if { callerSymbolSearch! => callerFunctionSymbol! }
                            callerSymbolSearch! + 1 => callerSymbolSearch!
                        }
                    -1 => localOwnerSymbol!
                    callerFunctionSymbol! >= 0 -> if {
                        table[callerFunctionSymbol!].parent >= 0 -> if { table[callerFunctionSymbol!].parent => localOwnerSymbol! } else { callerFunctionSymbol! => localOwnerSymbol! }
                    }
                    0 => symbolIndex!
                    symbolIndex! < (table -> len) and functionSymbol! < 0
                        -> while {
                            table[symbolIndex!] => candidate
                            (candidate.kind == 7 or candidate.kind == 31) and (candidate.parent < 0 or candidate.parent == localOwnerSymbol!)
                                -> if {
                                    tokens[callNameToken!] => callName
                                    tokens[candidate.nameToken] => functionName
                                    callName.span.length == functionName.span.length => equal!
                                    UIntSize(0) => nameByte!
                                    equal! and nameByte! < callName.span.length
                                        -> while {
                                            source -> byte(callName.span.start + nameByte!) => callByte
                                            source -> byte(functionName.span.start + nameByte!) => functionByte
                                            callByte != functionByte -> if { false => equal! }
                                            nameByte! + 1 => nameByte!
                                        }
                                    equal! and (node.kind == 10 or node.kind == 11 or node.kind == 48 or node.kind == 77 or candidate.secondaryTypeNode < 0)
                                        -> if { symbolIndex! => functionSymbol! }
                                }
                            symbolIndex! + 1 => symbolIndex!
                        }
                    RuntimeNameRequest { source: source, token: tokens[callNameToken!] } -> intrinsicFlowTarget => intrinsicFlow!
                    callNameToken! > node.firstToken and tokens[callNameToken! - 1].kind == grammar.tokenIdDot()
                        -> if { false => intrinsicFlow! }
                    functionSymbol! >= 0 or (not intrinsicFlow! and (node.kind == 10 or node.kind == 11 or node.kind == 48 or node.kind == 77))
                        -> if {
                            2 => callStatus!
                            functionSymbol! >= 0 -> if { 0 => callStatus! }
                            resolved! -> push(CallResolution {
                                callAst: astIndex!
                                nameToken: callNameToken!
                                functionSymbol: functionSymbol!
                                status: callStatus!
                            })
                        }
                }
            }
        astIndex! + 1 => astIndex!
    }
    resolved!
}

# Origins: 0 local function, 1 imported function. Imported statuses preserve
# qualified lookup: 0 public, 2 missing/non-function, 3 non-public.
public resolveModulesPrepared request: move ModuleCallRequest -> [ModuleCallResolution; ~] {
    [modules.ModuleIdentity; ~] => identities!
    0 => identityCopyIndex180!
    identityCopyIndex180! < (request.modules -> len)
        -> while {
            request.modules[identityCopyIndex180!] => identity
            identities! -> push(identity)
            identityCopyIndex180! + 1 => identityCopyIndex180!
        }
    [qualified.QualifiedResolution; ~] => qualifiedResults!
    0 => qualifiedResultCopyIndex182!
    qualifiedResultCopyIndex182! < (request.qualified -> len)
        -> while {
            request.qualified[qualifiedResultCopyIndex182!] => qualifiedResult
            qualifiedResults! -> push(qualifiedResult)
            qualifiedResultCopyIndex182! + 1 => qualifiedResultCopyIndex182!
        }
    [ModuleCallResolution; ~] => results!
    0 => sourceIndex!
    sourceIndex! < (request.sources -> len) -> while {
        request.sources[sourceIndex!] => source
        source -> ast.lower => nodes
        source -> lexer.lex => tokens
        nodes -> symbols.collectPrepared => table
        [CallResolution; ~] => localCalls!
        nodes -> indexQualifiedPathCallOwners(0, nodes -> len) => qualifiedPathCallOwners
        0 => callAstIndex!
        callAstIndex! < (nodes -> len) -> while {
            nodes[callAstIndex!] => callNode
            false => moduleHasControlTarget!
            false => moduleHasFlowCallTarget!
            false => moduleHasQualifiedFlowTarget!
            0 => moduleControlTargetSearch!
            moduleControlTargetSearch! < (nodes -> len) -> while {
                nodes[moduleControlTargetSearch!].parent == callAstIndex! and (nodes[moduleControlTargetSearch!].kind == 42 or nodes[moduleControlTargetSearch!].kind == 44)
                    -> if { true => moduleHasControlTarget! }
                moduleControlTargetSearch! + 1 => moduleControlTargetSearch!
            }
            0 => moduleFlowTargetSearch!
            moduleFlowTargetSearch! < (nodes -> len) -> while {
                nodes[moduleFlowTargetSearch!].parent == callAstIndex! and nodes[moduleFlowTargetSearch!].kind == 16
                    -> if { true => moduleHasFlowCallTarget! }
                moduleFlowTargetSearch! + 1 => moduleFlowTargetSearch!
            }
            callNode.firstToken => moduleFlowTokenIndex!
            callNode.kind == 10 and moduleFlowTokenIndex! < callNode.firstToken + callNode.tokenCount
                -> while {
                    tokens[moduleFlowTokenIndex!].kind == grammar.tokenIdDot()
                        -> if { true => moduleHasQualifiedFlowTarget! }
                    moduleFlowTokenIndex! + 1 => moduleFlowTokenIndex!
                }
            false => moduleHasQualifiedCallTarget!
            0 => moduleQualifiedCallSearch!
            moduleQualifiedCallSearch! < (qualifiedResults! -> len)
                -> while {
                    qualifiedResults![moduleQualifiedCallSearch!] => moduleQualifiedCall
                    moduleQualifiedCall.sourceModule == sourceIndex!
                        and moduleQualifiedCall.pathAst >= 0
                        and moduleQualifiedCall.pathAst < (nodes -> len)
                        and nodes[moduleQualifiedCall.pathAst].kind == 36
                        and ((nodes[moduleQualifiedCall.pathAst].parent == callAstIndex! and qualifiedPathCallOwners[moduleQualifiedCall.pathAst] < 0)
                        or qualifiedPathCallOwners[moduleQualifiedCall.pathAst] == callAstIndex!)
                        -> if {
                            false => moduleQualifiedTargetCallable!
                            moduleQualifiedCall.status == 0
                                and moduleQualifiedCall.targetModule >= 0
                                and moduleQualifiedCall.targetModule < (identities! -> len)
                                -> if {
                                    identities![moduleQualifiedCall.targetModule].sourceIndex => moduleQualifiedTargetSource
                                    moduleQualifiedTargetSource >= 0 and moduleQualifiedTargetSource < (request.sources -> len)
                                        -> if {
                                            request.sources[moduleQualifiedTargetSource] -> symbols.collect => moduleQualifiedTargetSymbols
                                            moduleQualifiedCall.targetSymbol >= 0 and moduleQualifiedCall.targetSymbol < (moduleQualifiedTargetSymbols -> len)
                                                -> if {
                                                    moduleQualifiedTargetSymbols[moduleQualifiedCall.targetSymbol].kind => moduleQualifiedTargetKind
                                                    moduleQualifiedTargetKind == 7 or moduleQualifiedTargetKind == 31 or moduleQualifiedTargetKind == 36
                                                        -> if {
                                                            true => moduleQualifiedTargetCallable!
                                                        }
                                                }
                                        }
                                }
                            moduleQualifiedTargetCallable!
                                -> if { true => moduleHasQualifiedCallTarget! }
                        }
                    moduleQualifiedCallSearch! + 1 => moduleQualifiedCallSearch!
                }
            false => moduleHasGeneratedComTarget!
            0 => moduleComQualifiedSearch!
            moduleComQualifiedSearch! < (qualifiedResults! -> len)
                -> while {
                    qualifiedResults![moduleComQualifiedSearch!] => moduleComQualified
                    moduleComQualified.sourceModule == sourceIndex! and moduleComQualified.pathAst == callAstIndex! and moduleComQualified.targetSymbol >= 0 and moduleComQualified.targetSymbol < (table -> len)
                        -> if {
                            table[moduleComQualified.targetSymbol].kind == 36
                                -> if { true => moduleHasGeneratedComTarget! }
                        }
                    moduleComQualifiedSearch! + 1 => moduleComQualifiedSearch!
                }
            false => moduleGeneratedComHasCallOwner!
            callNode.kind == 36 and callNode.parent >= 0
                -> if {
                    nodes[callNode.parent] => generatedComParent
                    generatedComParent.kind == 10
                        or generatedComParent.kind == 11
                        or generatedComParent.kind == 48 -> if {
                            true => moduleGeneratedComHasCallOwner!
                        }
                }
            (callNode.kind == 10 and (moduleHasFlowCallTarget! or moduleHasQualifiedCallTarget!)) or (callNode.kind == 11 and (callNode.cstRuleId == grammar.ruleIdCallExpression() or callNode.cstRuleId == grammar.ruleIdTypeApplicationExpression())) or callNode.kind == 48 or callNode.kind == 77 or (callNode.kind == 36 and moduleHasGeneratedComTarget! and not moduleGeneratedComHasCallOwner!)
                -> if {
                    -1 => callNameToken!
                    callNode.kind == 48 or callNode.kind == 77 -> if { callNode.payloadToken => callNameToken! }
                    callNode.kind == 36 -> if {
                        callNode.firstToken => comCallNameSearch!
                        comCallNameSearch! < callNode.firstToken + callNode.tokenCount
                            -> while {
                                tokens[comCallNameSearch!].kind == grammar.tokenIdIdentifier()
                                    -> if { comCallNameSearch! => callNameToken! }
                                comCallNameSearch! + 1 => comCallNameSearch!
                            }
                    }
                    callNode.kind == 10 -> if {
                        0 => moduleFlowNameSearch!
                        moduleFlowNameSearch! < (nodes -> len) -> while {
                            nodes[moduleFlowNameSearch!].parent == callAstIndex!
                                and nodes[moduleFlowNameSearch!].kind == 16
                                and nodes[moduleFlowNameSearch!].payloadToken > callNameToken!
                                -> if {
                                    nodes[moduleFlowNameSearch!].payloadToken => callNameToken!
                                }
                            moduleFlowNameSearch! + 1 => moduleFlowNameSearch!
                        }
                    }
                    callNode.firstToken => callTokenIndex!
                    false => moduleInFlowTypeArgument!
                    false => moduleInFlowCallArguments!
                    callTokenIndex! < callNode.firstToken + callNode.tokenCount and callNode.kind != 48 and callNode.kind != 77 and callNameToken! < 0
                        -> while {
                            tokens[callTokenIndex!].kind == grammar.tokenIdLess()
                                -> if { true => moduleInFlowTypeArgument! }
                            tokens[callTokenIndex!].kind == grammar.tokenIdGreater()
                                -> if { false => moduleInFlowTypeArgument! }
                            tokens[callTokenIndex!].kind == grammar.tokenIdLeftParen()
                                -> if { true => moduleInFlowCallArguments! }
                            tokens[callTokenIndex!].kind == grammar.tokenIdRightParen()
