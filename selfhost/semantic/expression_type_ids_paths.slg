                                                        memberToken.span.length == memberFieldName.span.length => memberNameEqual!
                                                        UIntSize(0) => memberNameByte!
                                                        memberNameEqual! and memberNameByte! < memberToken.span.length
                                                            -> while {
                                                                pathSource -> byte(memberToken.span.start + memberNameByte!) => memberLeftByte
                                                                memberFieldSource -> byte(memberFieldName.span.start + memberNameByte!) => memberRightByte
                                                                memberLeftByte != memberRightByte -> if { false => memberNameEqual! }
                                                                memberNameByte! + 1 => memberNameByte!
                                                            }
                                                        memberNameEqual! -> if { memberField.fieldType => matchedFieldType! }
                                                    }
                                                    nextFieldByField![memberFieldIndex!] => memberFieldIndex!
                                                }
                                                matchedFieldType! >= 0 -> if {
                                                    # A field read through a readonly reference is still a value
                                                    # expression. Reference-place lowering decides separately
                                                    # whether a call needs the field's address.
                                                    matchedFieldType! => memberCurrentType!
                                                    true => memberResolvedField!
                                                } else {
                                                    false => memberPathValid!
                                                }
                                            }
                                        memberTokenIndex! + 1 => memberTokenIndex!
                                    }
                                memberPathValid! and memberResolvedField! -> if {
                                    expressionIndexByAst[pathGlobalAst] => memberExpressionIndex!
                                    memberExpressionIndex! < 0 -> if {
                                        expressions -> len => memberExpressionIndex!
                                        expressions -> push(ExpressionTypeId { sourceModule: pathSourceIndex!, astNode: pathAstIndex!, typeId: memberCurrentType!, status: 0 })
                                        memberExpressionIndex! => expressionIndexByAst[pathGlobalAst]
                                        true => pathChanged!
                                        true => pathRoundChanged!
                                    } else {
                                        expressions[memberExpressionIndex!] => existingMemberExpression!
                                        existingMemberExpression!.typeId != memberCurrentType! or existingMemberExpression!.status != 0
                                            -> if {
                                                memberCurrentType! => existingMemberExpression!.typeId
                                                0 => existingMemberExpression!.status
                                                existingMemberExpression! => expressions[memberExpressionIndex!]
                                                true => pathChanged!
                                                true => pathRoundChanged!
                                            }
                                    }
                                }
                            }
                            pathNode.kind == 41 -> if {
                                baseExpression.typeId => indexedBaseTypeId!
                                types[indexedBaseTypeId!].kind == 8 and types[indexedBaseTypeId!].first >= 0
                                    -> if {
                                        types[indexedBaseTypeId!].first => indexedBaseTypeId!
                                    }
                                types[indexedBaseTypeId!] => indexedBaseType
                                -1 => indexedElementType!
                                indexedBaseType.kind >= 2 and indexedBaseType.kind <= 4
                                    -> if { indexedBaseType.first => indexedElementType! }
                                indexedBaseType.kind == 5 -> if { indexedBaseType.second => indexedElementType! }
                                indexedBaseType.kind == 1 and indexedBaseType.origin == 1 and indexedBaseType.symbol == 16
                                    -> if { 1 => indexedElementType! }
                                indexedBaseType.kind == 1 and indexedBaseType.origin == 1 and indexedBaseType.symbol == 24
                                    -> if { 8 => indexedElementType! }
                                indexedElementType! >= 0 -> if {
                                    expressionIndexByAst[pathGlobalAst] => indexExpressionIndex!
                                    indexExpressionIndex! < 0 -> if {
                                        expressions -> len => indexExpressionIndex!
                                        expressions -> push(ExpressionTypeId { sourceModule: pathSourceIndex!, astNode: pathAstIndex!, typeId: indexedElementType!, status: 0 })
                                        indexExpressionIndex! => expressionIndexByAst[pathGlobalAst]
                                        true => pathChanged!
                                        true => pathRoundChanged!
                                    } else {
                                        expressions[indexExpressionIndex!] => existingIndexExpression!
                                        existingIndexExpression!.typeId != indexedElementType! or existingIndexExpression!.status != 0
                                            -> if {
                                                indexedElementType! => existingIndexExpression!.typeId
                                                0 => existingIndexExpression!.status
                                                existingIndexExpression! => expressions[indexExpressionIndex!]
                                                true => pathChanged!
                                                true => pathRoundChanged!
                                            }
                                    }
                                }
                            }
                            pathNode.kind == 10 -> if {
                                false => takeFlow!
                                flowTargetTokenByAst[pathGlobalAst] => takeTargetToken
                                takeTargetToken >= 0 -> if {
                                    prepared.package.tokens[pathRange.tokenStart + takeTargetToken] => takeTargetName
                                    TextMatchRequest { source: pathSource, start: takeTargetName.span.start, length: takeTargetName.span.length, expected: "take" } -> textMatches
                                        -> if { true => takeFlow! }
                                }
                                takeFlow! -> if {
                                    types[baseExpression.typeId] => takeBaseType
                                    -1 => takeResultType!
                                    takeBaseType.kind == 3 -> if { takeBaseType.first => takeResultType! }
                                    takeBaseType.kind == 5 -> if { takeBaseType.second => takeResultType! }
                                    takeResultType! >= 0 -> if {
                                        expressionIndexByAst[pathGlobalAst] => takeExpressionIndex!
                                        takeExpressionIndex! < 0 -> if {
                                            expressions -> len => takeExpressionIndex!
                                            expressions -> push(ExpressionTypeId { sourceModule: pathSourceIndex!, astNode: pathAstIndex!, typeId: takeResultType!, status: 0 })
                                            takeExpressionIndex! => expressionIndexByAst[pathGlobalAst]
                                            true => pathChanged!
                                            true => pathRoundChanged!
                                        } else {
                                            expressions[takeExpressionIndex!] => existingTakeExpression!
                                            existingTakeExpression!.typeId != takeResultType! or existingTakeExpression!.status != 0
                                                -> if {
                                                    takeResultType! => existingTakeExpression!.typeId
                                                    0 => existingTakeExpression!.status
                                                    existingTakeExpression! => expressions[takeExpressionIndex!]
                                                    true => pathChanged!
                                                    true => pathRoundChanged!
                                                }
                                        }
                                    }
                                }
                            }
                        }
                        pathAstIndex! + 1 => pathAstIndex!
                    }
                    pathSourceIndex! + 1 => pathSourceIndex!
                }
        }
        resolveLateArrayTypes(prepared, types, expressions, expressionIndexByAst) => lateArrayChanged
        lateArrayChanged -> if { true => pathChanged! }
        # Revisit dictionary literals whose values acquire enum types only after
        # the initial composite sweep through binding or indexed-path inference.
        0 => lateDictionarySourceIndex!
        lateDictionarySourceIndex! < (prepared.package.ranges -> len)
            -> while {
                prepared.package.ranges[lateDictionarySourceIndex!] => lateDictionaryRange
                0 => lateDictionaryAstIndex!
                lateDictionaryAstIndex! < lateDictionaryRange.astCount
                    -> while {
                        prepared.package.nodes[lateDictionaryRange.astStart + lateDictionaryAstIndex!] => lateDictionaryNode
                        lateDictionaryRange.astStart + lateDictionaryAstIndex! => lateDictionaryGlobalAst
                        lateDictionaryNode.kind == 38 -> if {
                            -1 => lateDictionaryFirstChild!
                            -1 => lateDictionarySecondChild!
                            0 => lateDictionaryChildSearch!
                            lateDictionaryChildSearch! < lateDictionaryRange.astCount
                                -> while {
                                    prepared.package.nodes[lateDictionaryRange.astStart + lateDictionaryChildSearch!] => lateDictionaryChild
                                    lateDictionaryChild.parent == lateDictionaryAstIndex!
                                        -> if {
                                            lateDictionaryFirstChild! < 0 -> if { lateDictionaryChildSearch! => lateDictionaryFirstChild! } else {
                                                lateDictionarySecondChild! < 0 -> if { lateDictionaryChildSearch! => lateDictionarySecondChild! }
                                            }
                                        }
                                    lateDictionaryChildSearch! + 1 => lateDictionaryChildSearch!
                                }
                            -1 => lateDictionaryFirstType!
                            -1 => lateDictionarySecondType!
                            lateDictionaryFirstChild! >= 0 -> if {
                                1000000 => lateDictionaryDistance!
                                0 => lateDictionaryCandidateSearch!
                                lateDictionaryCandidateSearch! < (expressions -> len)
                                    -> while {
                                        expressions[lateDictionaryCandidateSearch!] => lateDictionaryCandidate
                                        lateDictionaryCandidate.sourceModule == lateDictionarySourceIndex!
                                            -> if {
                                                prepared.package.nodes[lateDictionaryRange.astStart + lateDictionaryCandidate.astNode].parent => lateDictionaryAncestor!
                                                1 => lateDictionaryCandidateDistance!
                                                false => lateDictionaryBelongs!
                                                lateDictionaryCandidate.astNode == lateDictionaryFirstChild!
                                                    -> if {
                                                        true => lateDictionaryBelongs!
                                                        0 => lateDictionaryCandidateDistance!
                                                    }
                                                lateDictionaryAncestor! >= 0 and not lateDictionaryBelongs!
                                                    -> while {
                                                        lateDictionaryAncestor! == lateDictionaryFirstChild!
                                                            -> if { true => lateDictionaryBelongs! } else {
                                                                prepared.package.nodes[lateDictionaryRange.astStart + lateDictionaryAncestor!].parent => lateDictionaryAncestor!
                                                                lateDictionaryCandidateDistance! + 1 => lateDictionaryCandidateDistance!
                                                            }
                                                    }
                                                lateDictionaryBelongs! and lateDictionaryCandidateDistance! < lateDictionaryDistance!
                                                    -> if {
                                                        lateDictionaryCandidateDistance! => lateDictionaryDistance!
                                                        lateDictionaryCandidate.typeId => lateDictionaryFirstType!
                                                    }
                                            }
                                        lateDictionaryCandidateSearch! + 1 => lateDictionaryCandidateSearch!
                                    }
                            }
                            lateDictionarySecondChild! >= 0 -> if {
                                1000000 => lateDictionaryDistance!
                                0 => lateDictionaryCandidateSearch!
                                lateDictionaryCandidateSearch! < (expressions -> len)
                                    -> while {
                                        expressions[lateDictionaryCandidateSearch!] => lateDictionaryCandidate
                                        lateDictionaryCandidate.sourceModule == lateDictionarySourceIndex!
                                            -> if {
                                                prepared.package.nodes[lateDictionaryRange.astStart + lateDictionaryCandidate.astNode].parent => lateDictionaryAncestor!
                                                1 => lateDictionaryCandidateDistance!
                                                false => lateDictionaryBelongs!
                                                lateDictionaryCandidate.astNode == lateDictionarySecondChild!
                                                    -> if {
                                                        true => lateDictionaryBelongs!
                                                        0 => lateDictionaryCandidateDistance!
                                                    }
                                                lateDictionaryAncestor! >= 0 and not lateDictionaryBelongs!
                                                    -> while {
                                                        lateDictionaryAncestor! == lateDictionarySecondChild!
                                                            -> if { true => lateDictionaryBelongs! } else {
                                                                prepared.package.nodes[lateDictionaryRange.astStart + lateDictionaryAncestor!].parent => lateDictionaryAncestor!
                                                                lateDictionaryCandidateDistance! + 1 => lateDictionaryCandidateDistance!
                                                            }
                                                    }
                                                lateDictionaryBelongs! and lateDictionaryCandidateDistance! < lateDictionaryDistance!
                                                    -> if {
                                                        lateDictionaryCandidateDistance! => lateDictionaryDistance!
                                                        lateDictionaryCandidate.typeId => lateDictionarySecondType!
                                                    }
                                            }
                                        lateDictionaryCandidateSearch! + 1 => lateDictionaryCandidateSearch!
                                    }
                            }
                            lateDictionaryFirstType! >= 0 and lateDictionarySecondType! >= 0
                                -> if {
                                    -1 => lateDictionaryType!
                                    0 => lateDictionaryTypeSearch!
                                    lateDictionaryTypeSearch! < (types -> len) -> while {
                                        types[lateDictionaryTypeSearch!] => lateDictionaryCandidateType
                                        lateDictionaryCandidateType.kind == 5 and lateDictionaryCandidateType.first == lateDictionaryFirstType! and lateDictionaryCandidateType.second == lateDictionarySecondType! and lateDictionaryCandidateType.status == 0
                                            -> if {
                                                lateDictionaryTypeSearch! => lateDictionaryType!
                                            }
                                        lateDictionaryTypeSearch! + 1 => lateDictionaryTypeSearch!
                                    }
                                    lateDictionaryType! < 0 -> if {
                                        types -> len => lateDictionaryType!
                                        types -> push(typeIds.SemanticType {
                                            kind: 5
                                            origin: -1
                                            module: -1
                                            symbol: -1
                                            first: lateDictionaryFirstType!
                                            second: lateDictionarySecondType!
                                            length: -1
                                            lengthHash: 0
                                            containsParameter: types[lateDictionaryFirstType!].containsParameter or types[lateDictionarySecondType!].containsParameter
                                            status: 0
                                        })
                                    }
                                    expressionIndexByAst[lateDictionaryGlobalAst] >= 0
                                        -> if {
                                            expressions[expressionIndexByAst[lateDictionaryGlobalAst]] => lateDictionaryExisting!
                                            lateDictionaryType! => lateDictionaryExisting!.typeId
                                            lateDictionaryExisting! => expressions[expressionIndexByAst[lateDictionaryGlobalAst]]
                                        } else {
                                            expressions -> len => lateDictionaryExpressionIndex
                                            expressions -> push(ExpressionTypeId { sourceModule: lateDictionarySourceIndex!, astNode: lateDictionaryAstIndex!, typeId: lateDictionaryType!, status: 0 })
                                            lateDictionaryExpressionIndex => expressionIndexByAst[lateDictionaryGlobalAst]
                                        }
                                }
                        }
                        lateDictionaryAstIndex! + 1 => lateDictionaryAstIndex!
                    }
                lateDictionarySourceIndex! + 1 => lateDictionarySourceIndex!
            }

        # The late dictionary type must also feed an index expression in the same
        # pass; the normal path sweep has already run by this point.
        0 => lateDictionaryIndexSource!
        lateDictionaryIndexSource! < (prepared.package.ranges -> len)
            -> while {
                prepared.package.ranges[lateDictionaryIndexSource!] => lateDictionaryIndexRange
                0 => lateDictionaryIndexAst!
                lateDictionaryIndexAst! < lateDictionaryIndexRange.astCount
                    -> while {
                        prepared.package.nodes[lateDictionaryIndexRange.astStart + lateDictionaryIndexAst!] => lateDictionaryIndexNode
                        lateDictionaryIndexNode.kind == 41 -> if {
                            lateDictionaryIndexRange.astStart + lateDictionaryIndexAst! => lateDictionaryIndexGlobal
                            expressionIndexByAst[lateDictionaryIndexGlobal] < 0
                                -> if {
                                    -1 => lateDictionaryBaseType!
                                    0 => lateDictionaryBaseSearch!
                                    lateDictionaryBaseSearch! < (expressions -> len)
                                        -> while {
                                            expressions[lateDictionaryBaseSearch!] => lateDictionaryBaseCandidate
                                            lateDictionaryBaseCandidate.sourceModule == lateDictionaryIndexSource!
                                                -> if {
                                                    prepared.package.nodes[lateDictionaryIndexRange.astStart + lateDictionaryBaseCandidate.astNode].parent => lateDictionaryBaseAncestor!
                                                    false => lateDictionaryBaseBelongs!
                                                    lateDictionaryBaseAncestor! >= 0 and not lateDictionaryBaseBelongs!
                                                        -> while {
                                                            lateDictionaryBaseAncestor! == lateDictionaryIndexAst!
                                                                -> if { true => lateDictionaryBaseBelongs! } else {
                                                                    prepared.package.nodes[lateDictionaryIndexRange.astStart + lateDictionaryBaseAncestor!].parent => lateDictionaryBaseAncestor!
                                                                }
                                                        }
                                                    lateDictionaryBaseBelongs! -> if { lateDictionaryBaseCandidate.typeId => lateDictionaryBaseType! }
                                                }
                                            lateDictionaryBaseSearch! + 1 => lateDictionaryBaseSearch!
                                        }
                                    lateDictionaryBaseType! >= 0 and lateDictionaryBaseType! < (types -> len) and types[lateDictionaryBaseType!].kind == 5
                                        -> if {
                                            types[lateDictionaryBaseType!].second => lateDictionaryElementType
                                            expressions -> len => lateDictionaryIndexExpression
                                            expressions -> push(ExpressionTypeId { sourceModule: lateDictionaryIndexSource!, astNode: lateDictionaryIndexAst!, typeId: lateDictionaryElementType, status: 0 })
                                            lateDictionaryIndexExpression => expressionIndexByAst[lateDictionaryIndexGlobal]
                                        }
                                }
                        }
                        lateDictionaryIndexAst! + 1 => lateDictionaryIndexAst!
                    }
                lateDictionaryIndexSource! + 1 => lateDictionaryIndexSource!
            }
    }

}

# Extend the derived field index from canonical arena lengths, preserving existing links.
synchronizeFieldIndex types: [typeIds.SemanticType], fields: [typeIds.NominalField], firstByOwner: mut [Int; ~], lastByOwner: mut [Int; ~], nextByField: mut [Int; ~] -> Unit {
    (firstByOwner -> len) < (types -> len) -> while {
        firstByOwner -> push(-1)
        lastByOwner -> push(-1)
    }
    Int(nextByField -> len) => fieldIndex!
    fieldIndex! < (fields -> len) -> while {
        fields[fieldIndex!] => field
        nextByField -> push(-1)
        field.status == 0 and field.ownerType >= 0 -> if {
            lastByOwner[field.ownerType] >= 0 -> if {
                fieldIndex! => nextByField[lastByOwner[field.ownerType]]
            } else {
                fieldIndex! => firstByOwner[field.ownerType]
            }
            fieldIndex! => lastByOwner[field.ownerType]
        }
        fieldIndex! + 1 => fieldIndex!
    }
}
