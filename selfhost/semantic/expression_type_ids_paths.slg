namespace sollang.compiler.semantic.expression_type_ids

import sollang.compiler.ast
import sollang.compiler.lexer
import sollang.compiler.semantic.analysis
import sollang.compiler.semantic.calls
import sollang.compiler.semantic.composite_types as compositeTypes
import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.late_array_types as lateArrayTypes
import sollang.compiler.semantic.modules
import sollang.compiler.semantic.module_resolve as moduleResolve
import sollang.compiler.semantic.nominal_types as nominalTypes
import sollang.compiler.semantic.qualified
import sollang.compiler.semantic.resolve as resolution
import sollang.compiler.semantic.symbols
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.semantic.type_terms as typeTerms
import sollang.compiler.semantic.types as semanticTypes
import sollang.compiler.syntax
import syntax.generated.slg as grammar
import sys.file as file
# Resolve member, index, stream, branch, and late container paths as one
# deterministic fixed-point pass. Mutable arenas are borrowed directly;
# this phase adds no heap state wrapper or generated-program runtime work.
resolvePaths prepared: semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], references: [typeIds.TypeReference], fields: mut [typeIds.NominalField; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~], flowTargetTokenByAst: [Int], productSources: [Int], productAsts: [Int] -> Unit {
    # Resolve member and index paths from the canonical type-id arena. Each
    # round walks typed expressions once and records the nearest usable base
    # for every still-untyped path, avoiding the legacy AST x expression scan.
    [Int; ~] => bindingSymbolByAst!
    0 => bindingAstSeed!
    bindingAstSeed! < (prepared.package.nodes -> len)
        -> while {
            bindingSymbolByAst! -> push(-1)
            bindingAstSeed! + 1 => bindingAstSeed!
        }
    0 => bindingMapSource!
    bindingMapSource! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[bindingMapSource!] => bindingMapRange
            0 => bindingMapSymbol!
            bindingMapSymbol! < bindingMapRange.symbolCount
                -> while {
                    prepared.package.symbols[bindingMapRange.symbolStart + bindingMapSymbol!] => bindingMapCandidate
                    (bindingMapCandidate.kind == 9 or bindingMapCandidate.kind == 61) and bindingMapCandidate.astNode >= 0
                        -> if {
                            bindingMapRange.symbolStart + bindingMapSymbol! => bindingSymbolByAst![bindingMapRange.astStart + bindingMapCandidate.astNode]
                        }
                    bindingMapSymbol! + 1 => bindingMapSymbol!
                }
            bindingMapSource! + 1 => bindingMapSource!
        }
    # Complete stream generics in pipeline order. A stateful stage such as
    # scan<T,S> introduces S through its explicit initial-state argument; later
    # filter/take stages then inherit that now-concrete upstream element type.
    0 => streamGenericCallIndex!
    streamGenericCallIndex! < (prepared.calls -> len)
        -> while {
            prepared.calls[streamGenericCallIndex!] => streamGenericCall
            streamGenericCall.status == 0 and streamGenericCall.targetSourceModule >= 0
                -> if {
                    prepared.package.ranges[streamGenericCall.sourceModule] => streamGenericCallRange
                    prepared.package.nodes[streamGenericCallRange.astStart + streamGenericCall.callAst] => streamGenericCallAst
                    prepared.package.ranges[streamGenericCall.targetSourceModule] => streamGenericTargetRange
                    prepared.package.symbols[streamGenericTargetRange.symbolStart + streamGenericCall.functionSymbol] => streamGenericFunction
                    streamGenericCallRange.astStart + streamGenericCall.callAst => streamGenericGlobalAst
                    expressionIndexByAst[streamGenericGlobalAst] => streamGenericExpressionIndex
                    streamGenericCallAst.kind == 48 and streamGenericFunction.flags / 64 % 2 == 1 and streamGenericExpressionIndex >= 0 and types[expressions[streamGenericExpressionIndex].typeId].containsParameter
                        -> if {
                            -1 => streamGenericConcreteType!
                            streamGenericFunction.blockTypeNode => streamGenericInputAst!
                            prepared.package.tokens[streamGenericCallRange.tokenStart + streamGenericCallAst.payloadToken].span.start => streamGenericTargetStart
                            streamGenericCallAst.start + streamGenericCallAst.length => streamGenericBodyStart!
                            streamGenericCallAst.tertiaryToken >= 0 -> if {
                                prepared.package.tokens[streamGenericCallRange.tokenStart + streamGenericCallAst.tertiaryToken].span.start => streamGenericBodyStart!
                            }
                            UIntSize(0) => streamGenericArgumentStart!
                            0 => streamGenericArgumentSearch!
                            streamGenericFunction.blockTypeNode < 0 -> if { expressions -> len => streamGenericArgumentSearch! }
                            streamGenericArgumentSearch! < (expressions -> len)
                                -> while {
                                    expressions[streamGenericArgumentSearch!] => streamGenericArgument
                                    streamGenericArgument.status == 0 and streamGenericArgument.sourceModule == streamGenericCall.sourceModule and not types[streamGenericArgument.typeId].containsParameter
                                        -> if {
                                            prepared.package.nodes[streamGenericCallRange.astStart + streamGenericArgument.astNode] => streamGenericArgumentNode
                                            streamGenericArgumentNode.start > streamGenericTargetStart and streamGenericArgumentNode.start < streamGenericBodyStart!
                                                -> if {
                                                    streamGenericArgumentNode.parent => streamGenericArgumentAncestor!
                                                    false => streamGenericArgumentBelongs!
                                                    streamGenericArgumentAncestor! >= 0 and not streamGenericArgumentBelongs!
                                                        -> while {
                                                            streamGenericArgumentAncestor! == streamGenericCall.callAst
                                                                -> if {
                                                                    true => streamGenericArgumentBelongs!
                                                                } else {
                                                                    prepared.package.nodes[streamGenericCallRange.astStart + streamGenericArgumentAncestor!].parent => streamGenericArgumentAncestor!
                                                                }
                                                        }
                                                    streamGenericArgumentBelongs! and (streamGenericConcreteType! < 0 or streamGenericArgumentNode.start < streamGenericArgumentStart!)
                                                        -> if {
                                                            streamGenericArgument.typeId => streamGenericConcreteType!
                                                            streamGenericArgumentNode.start => streamGenericArgumentStart!
                                                        }
                                                }
                                        }
                                    streamGenericArgumentSearch! + 1 => streamGenericArgumentSearch!
                                }
                            streamGenericConcreteType! < 0 -> if {
                                -1 => streamGenericSourceType!
                                1000000 => streamGenericSourceDistance!
                                0 => streamGenericSourceSearch!
                                streamGenericSourceSearch! < (expressions -> len)
                                    -> while {
                                        expressions[streamGenericSourceSearch!] => streamGenericSourceCandidate
                                        streamGenericSourceCandidate.sourceModule == streamGenericCall.sourceModule
                                            -> if {
                                                prepared.package.nodes[streamGenericCallRange.astStart + streamGenericSourceCandidate.astNode] => streamGenericSourceNode
                                                streamGenericSourceNode.start + streamGenericSourceNode.length <= streamGenericTargetStart
                                                    -> if {
                                                        streamGenericSourceNode.parent => streamGenericSourceAncestor!
                                                        1 => streamGenericSourceCandidateDistance!
                                                        false => streamGenericSourceBelongs!
                                                        streamGenericSourceAncestor! >= 0 and not streamGenericSourceBelongs!
                                                            -> while {
                                                                streamGenericSourceAncestor! == streamGenericCall.callAst
                                                                    -> if {
                                                                        true => streamGenericSourceBelongs!
                                                                    } else {
                                                                        prepared.package.nodes[streamGenericCallRange.astStart + streamGenericSourceAncestor!].parent => streamGenericSourceAncestor!
                                                                        streamGenericSourceCandidateDistance! + 1 => streamGenericSourceCandidateDistance!
                                                                    }
                                                            }
                                                        streamGenericSourceBelongs! and streamGenericSourceCandidateDistance! < streamGenericSourceDistance! and not types[streamGenericSourceCandidate.typeId].containsParameter
                                                            -> if {
                                                                streamGenericSourceCandidate.typeId => streamGenericSourceType!
                                                                streamGenericSourceCandidateDistance! => streamGenericSourceDistance!
                                                            }
                                                    }
                                            }
                                        streamGenericSourceSearch! + 1 => streamGenericSourceSearch!
                                    }
                                streamGenericSourceType! => streamGenericConcreteType!
                                streamGenericFunction.typeNode => streamGenericInputAst!
                            }
                            streamGenericConcreteType! >= 0 -> if {
                                expressions[streamGenericExpressionIndex] => streamGenericExpression!
                                references -> each streamGenericReference {
                                    streamGenericReference.sourceModule == streamGenericCall.targetSourceModule
                                        and streamGenericReference.typeAst == streamGenericInputAst!
                                        and streamGenericReference.status == 0
                                        -> if {
                                            types -> typeIds.specializeInto(streamGenericReference.typeId, streamGenericConcreteType!, streamGenericExpression!.typeId) => streamSpecialization
                                            streamSpecialization.status == 0 -> if {
                                                streamSpecialization.root => streamGenericExpression!.typeId
                                                0 => streamGenericExpression!.status
                                                streamGenericExpression! => expressions[streamGenericExpressionIndex]
                                            }
                                        }
                                }
                            }
                        }
                }
            streamGenericCallIndex! + 1 => streamGenericCallIndex!
        }

    # A stream stage's caller block is typed from the value arriving from its
    # upstream stage, not from an unrelated nearby expression. Seed those role
    # references before the normal member/binary fixed point so projections
    # such as `reading.sensorId` are inferred in the same canonical arena.
    0 => streamRoleCallIndex!
    streamRoleCallIndex! < (prepared.calls -> len)
        -> while {
            prepared.calls[streamRoleCallIndex!] => streamRoleCall
            streamRoleCall.status == 0 and streamRoleCall.targetSourceModule >= 0
                -> if {
                    prepared.package.ranges[streamRoleCall.sourceModule] => streamRoleCallRange
                    prepared.package.nodes[streamRoleCallRange.astStart + streamRoleCall.callAst] => streamRoleCallAst
                    prepared.package.ranges[streamRoleCall.targetSourceModule] => streamRoleTargetRange
                    prepared.package.symbols[streamRoleTargetRange.symbolStart + streamRoleCall.functionSymbol] => streamRoleFunction
                    streamRoleCallAst.kind == 48 and streamRoleFunction.flags / 64 % 2 == 1
                        -> if {
                            -1 => streamRoleSourceType!
                            1000000 => streamRoleSourceDistance!
                            prepared.package.tokens[streamRoleCallRange.tokenStart + streamRoleCallAst.payloadToken].span.start => streamRoleTargetStart
                            0 => streamRoleSourceSearch!
                            streamRoleSourceSearch! < (expressions -> len)
                                -> while {
                                    expressions[streamRoleSourceSearch!] => streamRoleSourceCandidate
                                    streamRoleSourceCandidate.sourceModule == streamRoleCall.sourceModule
                                        -> if {
                                            prepared.package.nodes[streamRoleCallRange.astStart + streamRoleSourceCandidate.astNode] => streamRoleSourceNode
                                            streamRoleSourceNode.start + streamRoleSourceNode.length <= streamRoleTargetStart
                                                -> if {
                                                    streamRoleSourceNode.parent => streamRoleSourceAncestor!
                                                    1 => streamRoleCandidateDistance!
                                                    false => streamRoleSourceBelongs!
                                                    streamRoleSourceAncestor! >= 0 and not streamRoleSourceBelongs!
                                                        -> while {
                                                            streamRoleSourceAncestor! == streamRoleCall.callAst
                                                                -> if {
                                                                    true => streamRoleSourceBelongs!
                                                                } else {
                                                                    prepared.package.nodes[streamRoleCallRange.astStart + streamRoleSourceAncestor!].parent => streamRoleSourceAncestor!
                                                                    streamRoleCandidateDistance! + 1 => streamRoleCandidateDistance!
                                                                }
                                                        }
                                                    streamRoleSourceBelongs! and streamRoleCandidateDistance! < streamRoleSourceDistance!
                                                        -> if {
                                                            streamRoleSourceCandidate.typeId => streamRoleSourceType!
                                                            streamRoleCandidateDistance! => streamRoleSourceDistance!
                                                        }
                                                }
                                        }
                                    streamRoleSourceSearch! + 1 => streamRoleSourceSearch!
                                }
                            -1 => streamRoleElementType!
                            streamRoleSourceType! >= 0 -> if {
                                types[streamRoleSourceType!] => streamRoleSourceSemantic
                                streamRoleSourceType! => streamRoleElementType!
                                streamRoleSourceSemantic.kind >= 2 and streamRoleSourceSemantic.kind <= 4
                                    -> if { streamRoleSourceSemantic.first => streamRoleElementType! }
                                streamRoleSourceSemantic.kind == 1 and streamRoleSourceSemantic.origin == 1 and streamRoleSourceSemantic.symbol == 25
                                    -> if { 2 => streamRoleElementType! }
                                streamRoleSourceSemantic.kind == 7
                                    and streamRoleSourceSemantic.origin == 4
                                    and (streamRoleSourceSemantic.symbol == 3
                                    or streamRoleSourceSemantic.symbol == 4
                                    or streamRoleSourceSemantic.symbol == 5)
                                    and streamRoleSourceSemantic.first >= 0 -> if {
                                        streamRoleSourceSemantic.first => streamRoleElementType!
                                    }
                            }
                            -1 => streamRoleOutputType!
                            expressionIndexByAst[streamRoleCallRange.astStart + streamRoleCall.callAst] => streamRoleCallExpression
                            streamRoleCallExpression >= 0 -> if { expressions[streamRoleCallExpression].typeId => streamRoleOutputType! }
                            -1 => streamRoleCallScopeSymbol!
                            0 => streamRoleCallScopeSearch!
                            streamRoleCallScopeSearch! < streamRoleCallRange.symbolCount
                                -> while {
                                    prepared.package.symbols[streamRoleCallRange.symbolStart + streamRoleCallScopeSearch!] => streamRoleCallScopeCandidate
                                    streamRoleCallScopeCandidate.kind == 48 and streamRoleCallScopeCandidate.astNode == streamRoleCall.callAst
                                        -> if { streamRoleCallScopeSearch! => streamRoleCallScopeSymbol! }
                                    streamRoleCallScopeSearch! + 1 => streamRoleCallScopeSearch!
                                }
                            0 => streamRoleNameSearch!
                            streamRoleNameSearch! < streamRoleCallRange.nameCount
                                -> while {
                                    prepared.package.names[streamRoleCallRange.nameStart + streamRoleNameSearch!] => streamRoleName
                                    prepared.package.symbols[streamRoleCallRange.symbolStart + streamRoleName.symbol] => streamRoleSymbol
                                    streamRoleSymbol.kind == 35 and streamRoleSymbol.parent == streamRoleCallScopeSymbol!
                                        -> if {
                                            # Bind each callback input from its declared type. The stream
                                            # result is a substitution constraint, never an input type.
                                            0 => streamRoleOrdinal!
                                            0 => streamRoleOrdinalSearch!
                                            streamRoleOrdinalSearch! < streamRoleCallRange.symbolCount
                                                -> while {
                                                    prepared.package.symbols[streamRoleCallRange.symbolStart + streamRoleOrdinalSearch!] => earlierRole
                                                    earlierRole.kind == 35 and earlierRole.parent == streamRoleCallScopeSymbol!
                                                        and earlierRole.nameToken < streamRoleSymbol.nameToken
                                                        -> if { streamRoleOrdinal! + 1 => streamRoleOrdinal! }
                                                    streamRoleOrdinalSearch! + 1 => streamRoleOrdinalSearch!
                                                }
                                            -1 => streamRoleType!
                                            streamRoleFunction.blockNameToken >= 0 -> if {
                                                prepared.package.tokens[streamRoleTargetRange.tokenStart + streamRoleFunction.blockNameToken].span.start => declaredRoleStart!
                                                0 => declaredRoleOrdinal!
                                                declaredRoleOrdinal! <= streamRoleOrdinal! -> while {
                                                    -1 => declaredRoleType!
                                                    UIntSize(0) => declaredRoleEnd!
                                                    references -> each declaredRoleReference {
                                                        declaredRoleReference.sourceModule == streamRoleCall.targetSourceModule
                                                            and declaredRoleReference.status == 0
                                                            -> if {
                                                                prepared.package.nodes[streamRoleTargetRange.astStart + declaredRoleReference.typeAst] => declaredRoleNode
                                                                declaredRoleNode.parent == streamRoleFunction.astNode
                                                                    and declaredRoleNode.start >= declaredRoleStart!
                                                                    and (declaredRoleType! < 0 or declaredRoleNode.start < declaredRoleEnd!)
                                                                    -> if {
                                                                        declaredRoleReference.typeId => declaredRoleType!
                                                                        declaredRoleNode.start => declaredRoleEnd!
                                                                    }
                                                            }
                                                    }
                                                    declaredRoleType! => streamRoleType!
                                                    declaredRoleEnd! + 1 => declaredRoleStart!
                                                    declaredRoleOrdinal! + 1 => declaredRoleOrdinal!
                                                }
                                            }
                                            streamRoleType! >= 0 -> if {
                                                references -> each roleConstraint {
                                                    roleConstraint.sourceModule == streamRoleCall.targetSourceModule
                                                        and roleConstraint.status == 0
                                                        -> if {
                                                            -1 => actualRoleConstraint!
                                                            roleConstraint.typeAst == streamRoleFunction.typeNode
                                                                -> if { streamRoleElementType! => actualRoleConstraint! }
                                                            roleConstraint.typeAst == streamRoleFunction.secondaryTypeNode
                                                                -> if { streamRoleOutputType! => actualRoleConstraint! }
                                                            actualRoleConstraint! >= 0 -> if {
                                                                types -> typeIds.specializeInto(roleConstraint.typeId, actualRoleConstraint!, streamRoleType!) => roleSpecialization
                                                                roleSpecialization.status == 0
                                                                    -> if { roleSpecialization.root => streamRoleType! }
                                                            }
                                                        }
                                                }
                                            }

                                            streamRoleCallRange.astStart + streamRoleName.astNode => streamRoleGlobalAst
                                            streamRoleType! >= 0 -> if {
                                                ExpressionTypeId {
                                                    sourceModule: streamRoleCall.sourceModule
                                                    astNode: streamRoleName.astNode
                                                    typeId: streamRoleType!
                                                    status: 0
                                                } => streamRoleExactType
                                                expressionIndexByAst[streamRoleGlobalAst] >= 0
                                                    -> if {
                                                        streamRoleExactType => expressions[expressionIndexByAst[streamRoleGlobalAst]]
                                                    } else {
                                                        expressions -> len => streamRoleExpressionIndex
                                                        expressions -> push(streamRoleExactType)
                                                        streamRoleExpressionIndex => expressionIndexByAst[streamRoleGlobalAst]
                                                    }
                                            }
                                        }
                                    streamRoleNameSearch! + 1 => streamRoleNameSearch!
                                }
                        }
                }
            streamRoleCallIndex! + 1 => streamRoleCallIndex!
        }

    [Int; ~] => controlThenBranchByAst!
    [Int; ~] => controlElseBranchByAst!
    [Int; ~] => controlBranchTypeByAst!
    [UIntSize; ~] => controlBranchRootStartByAst!
    [Int; ~] => controlBranchDistanceByAst!
    0 => controlResultSeed!
    controlResultSeed! < (prepared.package.nodes -> len)
        -> while {
            controlThenBranchByAst! -> push(-1)
            controlElseBranchByAst! -> push(-1)
            controlBranchTypeByAst! -> push(-1)
            controlBranchRootStartByAst! -> push(0)
            controlBranchDistanceByAst! -> push(1000000)
            controlResultSeed! + 1 => controlResultSeed!
        }
    0 => controlBranchSource!
    controlBranchSource! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[controlBranchSource!] => controlBranchRange
            0 => controlBranchAst!
            controlBranchAst! < controlBranchRange.astCount
                -> while {
                    prepared.package.nodes[controlBranchRange.astStart + controlBranchAst!] => controlBranchNode
                    controlBranchNode.kind == 43 and controlBranchNode.parent >= 0
                        -> if {
                            controlBranchRange.astStart + controlBranchNode.parent => controlOwnerGlobalAst
                            controlThenBranchByAst![controlOwnerGlobalAst] < 0
                                -> if {
                                    controlBranchRange.astStart + controlBranchAst! => controlThenBranchByAst![controlOwnerGlobalAst]
                                } else {
                                    controlBranchRange.astStart + controlBranchAst! => controlElseBranchByAst![controlOwnerGlobalAst]
                                }
                        }
                    controlBranchAst! + 1 => controlBranchAst!
                }
            controlBranchSource! + 1 => controlBranchSource!
        }

    # The enclosing value branch for an AST node is structural and immutable.
    # Resolve it once instead of re-walking the same parent chain for every
    # typed expression on every fixed-point pass.
    [Int; ~] => controlRootByAst!
    [Int; ~] => controlBranchByAst!
    [Int; ~] => controlDistanceByAst!
    0 => controlAncestorSeed!
    controlAncestorSeed! < (prepared.package.nodes -> len)
        -> while {
            controlRootByAst! -> push(-1)
            controlBranchByAst! -> push(-1)
            controlDistanceByAst! -> push(1000000)
            controlAncestorSeed! + 1 => controlAncestorSeed!
        }
    0 => controlAncestorSource!
    controlAncestorSource! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[controlAncestorSource!] => controlAncestorRange
            0 => controlAncestorAst!
            controlAncestorAst! < controlAncestorRange.astCount
                -> while {
                    controlAncestorRange.astStart + controlAncestorAst! => controlAncestorGlobal
                    controlAncestorAst! => controlRoot!
                    prepared.package.nodes[controlAncestorGlobal].parent => controlAncestor!
                    1 => controlDistance!
                    -1 => controlBranch!
                    false => controlNested!
                    controlAncestor! >= 0 and controlBranch! < 0 and not controlNested!
                        -> while {
                            prepared.package.nodes[controlAncestorRange.astStart + controlAncestor!] => controlAncestorNode
                            controlAncestorNode.kind == 43 and controlAncestorNode.parent >= 0
                                -> if {
                                    controlAncestorRange.astStart + controlAncestor! => controlBranch!
                                } else {
                                    controlAncestorNode.kind == 7 or controlAncestorNode.kind == 29 or controlAncestorNode.kind == 31
                                        -> if {
                                            true => controlNested!
                                        } else {
                                            controlAncestor! => controlRoot!
                                            controlAncestorNode.parent => controlAncestor!
                                            controlDistance! + 1 => controlDistance!
                                        }
                                }
                        }
                    controlRoot! => controlRootByAst![controlAncestorGlobal]
                    controlBranch! => controlBranchByAst![controlAncestorGlobal]
                    controlDistance! => controlDistanceByAst![controlAncestorGlobal]
                    controlAncestorAst! + 1 => controlAncestorAst!
                }
            controlAncestorSource! + 1 => controlAncestorSource!
        }

    # Parent chains are immutable. Cache the nearest semantically relevant
    # binding and path ancestors, then follow only those links in each round.
    # This preserves all nested owners while skipping unrelated AST parents.
    [Int; ~] => nearestBindingAncestorByAst!
    [Int; ~] => nearestBindingDistanceByAst!
    [Int; ~] => nearestPathAncestorByAst!
    [Int; ~] => nearestPathDistanceByAst!
    0 => semanticAncestorSeed!
    semanticAncestorSeed! < (prepared.package.nodes -> len)
        -> while {
            nearestBindingAncestorByAst! -> push(-1)
            nearestBindingDistanceByAst! -> push(1000000)
            nearestPathAncestorByAst! -> push(-1)
            nearestPathDistanceByAst! -> push(1000000)
            semanticAncestorSeed! + 1 => semanticAncestorSeed!
        }
    0 => semanticAncestorSource!
    semanticAncestorSource! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[semanticAncestorSource!] => semanticAncestorRange
            0 => semanticAncestorAst!
            semanticAncestorAst! < semanticAncestorRange.astCount
                -> while {
                    semanticAncestorRange.astStart + semanticAncestorAst! => semanticAncestorGlobal
                    prepared.package.nodes[semanticAncestorGlobal].parent => semanticParent!
                    1 => semanticDistance!
                    semanticParent! >= 0 and nearestBindingAncestorByAst![semanticAncestorGlobal] < 0
                        -> while {
                            semanticAncestorRange.astStart + semanticParent! => semanticParentGlobal
                            bindingSymbolByAst![semanticParentGlobal] >= 0
                                -> if {
                                    semanticParentGlobal => nearestBindingAncestorByAst![semanticAncestorGlobal]
                                    semanticDistance! => nearestBindingDistanceByAst![semanticAncestorGlobal]
                                } else {
                                    prepared.package.nodes[semanticParentGlobal].parent => semanticParent!
                                    semanticDistance! + 1 => semanticDistance!
                                }
                        }
                    prepared.package.nodes[semanticAncestorGlobal].parent => pathSemanticParent!
                    1 => pathSemanticDistance!
                    pathSemanticParent! >= 0 and nearestPathAncestorByAst![semanticAncestorGlobal] < 0
                        -> while {
                            semanticAncestorRange.astStart + pathSemanticParent! => pathSemanticParentGlobal
                            prepared.package.nodes[pathSemanticParentGlobal] => pathSemanticParentNode
                            pathSemanticParentNode.kind == 36 or pathSemanticParentNode.kind == 41 or pathSemanticParentNode.kind == 10
                                -> if {
                                    pathSemanticParentGlobal => nearestPathAncestorByAst![semanticAncestorGlobal]
                                    pathSemanticDistance! => nearestPathDistanceByAst![semanticAncestorGlobal]
                                } else {
                                    pathSemanticParentNode.parent => pathSemanticParent!
                                    pathSemanticDistance! + 1 => pathSemanticDistance!
                                }
                        }
                    semanticAncestorAst! + 1 => semanticAncestorAst!
                }
            semanticAncestorSource! + 1 => semanticAncestorSource!
        }

    # Field lookup is keyed by its canonical owner type. Preserve declaration
    # order within each owner while avoiding a complete field-table scan for
    # every member token on every fixed-point iteration.
    [Int; ~] => firstFieldByOwnerType!
    [Int; ~] => lastFieldByOwnerType!
    [Int; ~] => nextFieldByField!
    synchronizeFieldIndex(types, fields, firstFieldByOwnerType!, lastFieldByOwnerType!, nextFieldByField!)

    true => pathChanged!
    pathChanged! -> while {
        false => pathChanged!
        # Late array and dictionary interning can grow the arena between rounds.
        synchronizeFieldIndex(types, fields, firstFieldByOwnerType!, lastFieldByOwnerType!, nextFieldByField!)
        # Aggregate each branch in one expression sweep, then seed a
        # value-producing if and its enclosing flow from the common result.
        0 => controlBranchReset!
        controlBranchReset! < (controlBranchTypeByAst! -> len)
            -> while {
                -1 => controlBranchTypeByAst![controlBranchReset!]
                0 => controlBranchRootStartByAst![controlBranchReset!]
                1000000 => controlBranchDistanceByAst![controlBranchReset!]
                controlBranchReset! + 1 => controlBranchReset!
            }
        0 => controlExpressionSearch!
        controlExpressionSearch! < (expressions -> len)
            -> while {
                expressions[controlExpressionSearch!] => controlExpression
                controlExpression.status == 0 and controlExpression.sourceModule >= 0 and controlExpression.sourceModule < (prepared.package.ranges -> len)
                    -> if {
                        prepared.package.ranges[controlExpression.sourceModule] => controlExpressionRange
                        controlExpressionRange.astStart + controlExpression.astNode => controlExpressionGlobal
                        controlRootByAst![controlExpressionGlobal] => controlExpressionRoot
                        controlBranchByAst![controlExpressionGlobal] => controlExpressionBranch
                        controlDistanceByAst![controlExpressionGlobal] => controlExpressionDistance!
                        controlExpressionBranch >= 0 -> if {
                            prepared.package.nodes[controlExpressionRange.astStart + controlExpression.astNode] => controlExpressionNode
                            prepared.package.nodes[controlExpressionRange.astStart + controlExpressionRoot] => controlExpressionRootNode
                            controlExpression.typeId => controlExpressionResultType!
                            controlExpressionRootNode.start => controlExpressionResultStart!
                            controlExpressionRootNode.kind == 10 -> if {
                                controlExpressionNode.start => controlExpressionResultStart!
                            } else {
                                expressionIndexByAst[controlExpressionRange.astStart + controlExpressionRoot] => controlExpressionRootTypeIndex
                                controlExpressionRootTypeIndex >= 0 -> if {
                                    expressions[controlExpressionRootTypeIndex] => controlExpressionRootType
                                    controlExpressionRootType.status == 0 -> if {
                                        controlExpressionRootType.typeId => controlExpressionResultType!
                                        0 => controlExpressionDistance!
                                    }
                                }
                            }
                            controlBranchTypeByAst![controlExpressionBranch] < 0
                                or controlExpressionResultStart! > controlBranchRootStartByAst![controlExpressionBranch]
                                or (controlExpressionResultStart! == controlBranchRootStartByAst![controlExpressionBranch] and controlExpressionDistance! < controlBranchDistanceByAst![controlExpressionBranch])
                                -> if {
                                    controlExpressionResultType! => controlBranchTypeByAst![controlExpressionBranch]
                                    controlExpressionResultStart! => controlBranchRootStartByAst![controlExpressionBranch]
                                    controlExpressionDistance! => controlBranchDistanceByAst![controlExpressionBranch]
                                }
                        }
                    }
                controlExpressionSearch! + 1 => controlExpressionSearch!
            }
        0 => controlResultSource!
        controlResultSource! < (prepared.package.ranges -> len)
            -> while {
