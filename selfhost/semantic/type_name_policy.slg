namespace sollang.compiler.semantic.type_name_policy

# Parser type spelling has its own contract: Self is unqualified, while Range
# is not a parser builtin. Do not substitute semantic numeric type identities.
# The name list is generated from the same compiled C# source as the parser.
public isBuiltin name: Text -> Bool {
    builtinNames() -> containsName(name)
}

public boxName name: Text, structure: Bool, enumeration: Bool, declarationName: Text -> Bool {
    primitiveBoxNames() -> containsName(name) => primitive
    boxExcludedStructNames() -> containsName(declarationName) => excludedStructure
    boxExcludedNominalNames() -> containsName(declarationName) => excludedNominal
    canRegisterBoxName(primitive, structure, enumeration, excludedStructure, excludedNominal)
}

# The builtin struct has no user-source declaration tokens. Its labels and
# field types come from the same compiled schema as BoundStructDefinition.
public rangeStructName: -> Text { rangeSchemaPart(-1, false) }
public rangeFieldName ordinal: Int -> Text { rangeSchemaPart(ordinal, false) }
public rangeFieldType ordinal: Int -> Text { rangeSchemaPart(ordinal, true) }
public rangeFieldOrdinal name: Text -> Int {
    0 => ordinal!
    rangeFieldName(ordinal!) != "" -> while {
        rangeFieldName(ordinal!) == name -> if { ordinal! -> return }
        ordinal! + 1 => ordinal!
    }
    -1
}

rangeSchemaPart ordinal: Int, fieldType: Bool -> Text {
    rangeDefinition() => schema
    UIntSize(0) => start!
    -1 => row!
    start! < (schema -> len) -> while {
        start! => end!
        end! < (schema -> len) and (schema -> byte(end!)) != '|'
            -> while { end! + 1 => end! }
        row! == ordinal -> if {
            start! => colon!
            colon! < end! and (schema -> byte(colon!)) != ':'
                -> while { colon! + 1 => colon! }
            fieldType -> if {
                colon! < end! -> if { schema -> slice(colon! + 1, end! - colon! - 1) -> return }
                "" -> return
            }
            schema -> slice(start!, colon! - start!) -> return
        }
        row! + 1 => row!
        end! + 1 => start!
    }
    ""
}

containsName names: Text, name: Text -> Bool {
    UIntSize(0) => start!
    UIntSize(0) => cursor!
    cursor! <= (names -> len) -> while {
        cursor! == (names -> len) or (names -> byte(cursor!)) == '|'
            -> if {
                cursor! - start! == (name -> len) => equal!
                UIntSize(0) => index!
                equal! and index! < (name -> len) -> while {
                    (names -> byte(start! + index!)) != (name -> byte(index!))
                        -> if { false => equal! }
                    index! + 1 => index!
                }
                equal! -> if { true -> return }
                cursor! + 1 => start!
            }
        cursor! + 1 => cursor!
    }
    false
}
