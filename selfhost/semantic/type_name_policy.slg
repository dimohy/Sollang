namespace sollang.compiler.semantic.type_name_policy

# Parser type spelling has its own contract: Self is unqualified, while Range
# is not a parser builtin. Do not substitute semantic numeric type identities.
# The name list is generated from the same compiled C# source as the parser.
public isBuiltin name: Text -> Bool {
    builtinNames() -> containsName(name)
}

public builtinDisplayName enumName: Text -> Text {
    builtinDisplayOverrides() => table
    UIntSize(0) => start!
    start! < (table -> len) -> while {
        start! => end!
        end! < (table -> len) and (table -> byte(end!)) != '|'
            -> while { end! + 1 => end! }
        start! => equal!
        equal! < end! and (table -> byte(equal!)) != '='
            -> while { equal! + 1 => equal! }
        equal! < end! and (table -> slice(start!, equal! - start!)) == enumName
            -> if { table -> slice(equal! + 1, end! - equal! - 1) -> return }
        end! + 1 => start!
    }
    enumName
}

public intrinsicEnumName name: Text, enumeration: Bool -> Text {
    enumeration -> if {
        intrinsicEnumDefinitions() -> typeBindingMember(name)
    } else { intrinsicStructDefinitions() -> typeBindingMember(name) }
}

public builtinEnumName name: Text -> Text { predefinedTypeBindings() -> typeBindingMember(name) }

# The compiled bindings own both semantic identities and public C ABI spellings.
public libraryAbiName schema: Text, enumName: Text -> Text {
    UIntSize(0) => start!
    start! < (schema -> len) -> while {
        start! => end!
        end! < (schema -> len) and (schema -> byte(end!)) != '|'
            -> while { end! + 1 => end! }
        start! => colon!
        colon! < end! and (schema -> byte(colon!)) != ':'
            -> while { colon! + 1 => colon! }
        colon! < end! and (schema -> slice(start!, colon! - start!)) == enumName
            -> if { schema -> slice(colon! + 1, end! - colon! - 1) -> return }
        end! + 1 => start!
    }
    ""
}

public libraryAbiDeclaredName name: Text -> Bool {
    (libraryAbiTypeBindings() -> typeBindingMember(name)) != ""
}

public taskEnumName valueEnumName: Text -> Text { predeclaredTaskBindings() -> typeBindingMember(valueEnumName) }

public enum StorageBindingError { InvalidDefinition }
public struct StorageBinding {
    public identityStart: UIntSize
    public identityLength: UIntSize
    public elementStart: UIntSize
    public elementLength: UIntSize
    public length: Int
}

# Catalog views carry source coordinates; callers retain the compiled schema.
# Decode every row before either consumer mutates its type registry.
public storageBindings schema: Text, fixedLength: Bool -> Result<[StorageBinding; ~], StorageBindingError> {
    (schema -> len) == 0 -> if { Result<[StorageBinding; ~], StorageBindingError>.Err(StorageBindingError.InvalidDefinition) -> return }
    (schema -> byte((schema -> len) - 1)) == '|' -> if { Result<[StorageBinding; ~], StorageBindingError>.Err(StorageBindingError.InvalidDefinition) -> return }
    [StorageBinding; ~] => bindings!
    UIntSize(0) => start!
    start! < (schema -> len) -> while {
        start! => end!
        end! < (schema -> len) and (schema -> byte(end!)) != '|'
            -> while { end! + 1 => end! }
        start! => colon!
        colon! < end! and (schema -> byte(colon!)) != ':'
            -> while { colon! + 1 => colon! }
        colon! == start! or colon! + 1 >= end!
            -> if { Result<[StorageBinding; ~], StorageBindingError>.Err(StorageBindingError.InvalidDefinition) -> return }
        colon! + 1 => elementStart
        end! => elementEnd!
        -1 => length!
        fixedLength -> if {
            elementStart => elementEnd!
            elementEnd! < end! and (schema -> byte(elementEnd!)) != ':'
                -> while { elementEnd! + 1 => elementEnd! }
            elementEnd! == elementStart or elementEnd! + 1 >= end!
                -> if { Result<[StorageBinding; ~], StorageBindingError>.Err(StorageBindingError.InvalidDefinition) -> return }
            0 => length!
            elementEnd! + 1 => digitIndex!
            digitIndex! < end! -> while {
                Int(schema -> byte(digitIndex!)) - 48 => digit
                digit < 0 or digit > 9 or length! > (2147483647 - digit) / 10
                    -> if { Result<[StorageBinding; ~], StorageBindingError>.Err(StorageBindingError.InvalidDefinition) -> return }
                length! * 10 + digit => length!
                digitIndex! + 1 => digitIndex!
            }
        }
        bindings! -> push(StorageBinding { identityStart: start!, identityLength: colon! - start!, elementStart: elementStart, elementLength: elementEnd! - elementStart, length: length! })
        end! + 1 => start!
    }
    Result<[StorageBinding; ~], StorageBindingError>.Ok(bindings!)
}

typeBindingMember schema: Text, name: Text -> Text {
    UIntSize(0) => start!
    start! < (schema -> len) -> while {
        start! => end!
        end! < (schema -> len) and (schema -> byte(end!)) != '|'
            -> while { end! + 1 => end! }
        start! => colon!
        colon! < end! and (schema -> byte(colon!)) != ':'
            -> while { colon! + 1 => colon! }
        colon! < end! and (schema -> slice(colon! + 1, end! - colon! - 1)) == name
            -> if { schema -> slice(start!, colon! - start!) -> return }
        end! + 1 => start!
    }
    ""
}

public boxName name: Text, structure: Bool, enumeration: Bool, declarationName: Text -> Bool {
    primitiveBoxNames() -> containsName(name) => primitive
    boxExcludedStructNames() -> containsName(declarationName) => excludedStructure
    boxExcludedNominalNames() -> containsName(declarationName) => excludedNominal
    canRegisterBoxName(primitive, structure, enumeration, excludedStructure, excludedNominal)
}

# The builtin struct has no user-source declaration tokens. Its labels and
# field types come from the same compiled schema as BoundStructDefinition.
public rangeStructName: -> Text { rangeSchemaPart(-1, false) }
public rangeFieldName ordinal: Int -> Text { rangeSchemaPart(ordinal, false) }
public rangeFieldType ordinal: Int -> Text { rangeSchemaPart(ordinal, true) }
public rangeFieldOrdinal name: Text -> Int {
    0 => ordinal!
    rangeFieldName(ordinal!) != "" -> while {
        rangeFieldName(ordinal!) == name -> if { ordinal! -> return }
        ordinal! + 1 => ordinal!
    }
    -1
}

rangeSchemaPart ordinal: Int, fieldType: Bool -> Text {
    rangeDefinition() => schema
    UIntSize(0) => start!
    -1 => row!
    start! < (schema -> len) -> while {
        start! => end!
        end! < (schema -> len) and (schema -> byte(end!)) != '|'
            -> while { end! + 1 => end! }
        row! == ordinal -> if {
            start! => colon!
            colon! < end! and (schema -> byte(colon!)) != ':'
                -> while { colon! + 1 => colon! }
            fieldType -> if {
                colon! < end! -> if { schema -> slice(colon! + 1, end! - colon! - 1) -> return }
                "" -> return
            }
            schema -> slice(start!, colon! - start!) -> return
        }
        row! + 1 => row!
        end! + 1 => start!
    }
    ""
}

containsName names: Text, name: Text -> Bool {
    UIntSize(0) => start!
    UIntSize(0) => cursor!
    cursor! <= (names -> len) -> while {
        cursor! == (names -> len) or (names -> byte(cursor!)) == '|'
            -> if {
                cursor! - start! == (name -> len) => equal!
                UIntSize(0) => index!
                equal! and index! < (name -> len) -> while {
                    (names -> byte(start! + index!)) != (name -> byte(index!))
                        -> if { false => equal! }
                    index! + 1 => index!
                }
                equal! -> if { true -> return }
                cursor! + 1 => start!
            }
        cursor! + 1 => cursor!
    }
    false
}
