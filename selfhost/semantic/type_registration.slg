namespace sollang.compiler.semantic.type_registration

import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.modules as modules
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.semantic.storage_registration as storage
import sollang.compiler.semantic.type_name_policy as policy
import sys.file as file

public enum BoxRegistrationError { PrimitiveName, MissingDeclaration, InvalidType }
public struct RegisteredBoxes { public ids: [Int; ~] }

containsPolicyName table: Text, name: Text -> Bool {
    UIntSize(0) => start!
    UIntSize(0) => cursor!
    cursor! <= (table -> len) -> while {
        cursor! == (table -> len) or (table -> byte(cursor!)) == '|'
            -> if {
                (table -> slice(start!, cursor! - start!)) == name
                    -> if { true -> return }
                cursor! + 1 => start!
            }
        cursor! + 1 => cursor!
    }
    false
}

appendRegisteredBox types: mut [typeIds.SemanticType; ~], ids: mut [Int; ~], available: mut [Int; ~], next: ref [Int; ~], element: Int -> Unit {
    available[element] => identity!
    identity! >= 0 -> if {
        next[identity!] => available[element]
    } else {
        types -> typeIds.allocateSemanticTypeSlot => identity!
        typeIds.SemanticType {
            kind: 6, origin: -1, module: -1, symbol: -1,
            first: element, second: -1, length: -1, lengthHash: 0,
            containsParameter: types[element].containsParameter, status: 0
        } => types[identity!]
    }
    ids -> push(identity!)
}

# The catalog consumes committed declaration identities, not all scratch kinds.
# Existing box identities are reused, including alias multiplicity, before new
# canonical boxes are appended. Unrelated arena boxes remain outside this
# named seed list and are selected later by their committed body roots.
public registerNamedBoxes package: ref analysis.PackageAnalysis, types: mut [typeIds.SemanticType; ~] -> Result<RegisteredBoxes, BoxRegistrationError> {
    (types -> len) => originalCount
    [Int; ~] => available!
    [Int; ~] => next!
    types -> each _ { available! -> push(-1)
        next! -> push(-1)
    }
    originalCount - 1 => index!
    index! >= 0 -> while {
        types[index!] => type
        type.kind == 6 and type.status == 0 -> if {
            type.first < 0 or type.first >= originalCount
                -> if { Result<RegisteredBoxes, BoxRegistrationError>.Err(BoxRegistrationError.InvalidType) -> return }
            available![type.first] => next![index!]
            index! => available![type.first]
        }
        index! - 1 => index!
    }
    [Int; ~] => ids!
    policy.primitiveBoxNames() => primitives
    UIntSize(0) => start!
    UIntSize(0) => cursor!
    cursor! <= (primitives -> len) -> while {
        cursor! == (primitives -> len) or (primitives -> byte(cursor!)) == '|'
            -> if {
                primitives -> slice(start!, cursor! - start!) -> typeIds.builtinSymbolByName => symbol
                symbol < 0 -> if { Result<RegisteredBoxes, BoxRegistrationError>.Err(BoxRegistrationError.PrimitiveName) -> return }
                types -> typeIds.builtinTypeId(symbol) => element
                element < 0 -> if { Result<RegisteredBoxes, BoxRegistrationError>.Err(BoxRegistrationError.InvalidType) -> return }
                policy.canRegisterBoxName(true, false, false, false, false)
                    -> if {
                        types -> appendRegisteredBox(ids!, available!, next!, element)
                    }
                cursor! + 1 => start!
            }
        cursor! + 1 => cursor!
    }
    [Int; ~] => declared!
    package.symbols -> each _ { declared! -> push(-1) }
    0 => typeIndex!
    typeIndex! < originalCount -> while {
        types[typeIndex!] => type
        ((type.kind == 1 and (type.origin == 0 or type.origin == 2)) or type.kind == 9) and type.status == 0 and type.module >= 0 and type.module < (package.ranges -> len)
            -> if {
                package.ranges[type.module] => range
                type.symbol >= 0 and type.symbol < range.symbolCount
                    -> if { typeIndex! => declared![range.symbolStart + type.symbol] }
            }
        typeIndex! + 1 => typeIndex!
    }
    package -> modules.identitiesAnalyzed => identities
    [3, 4] -> each kind {
        0 => source!
        source! < (package.ranges -> len) -> while {
            package.ranges[source!] => range
            package.sources[source!] -> slice(0, package.sources[source!] -> len) => text
            0 => symbol!
            symbol! < range.symbolCount -> while {
                package.symbols[range.symbolStart + symbol!].kind == kind
                    -> if {
                        [UInt8; ~] => name!
                        modules.appendDeclarationNameBytes(text, identities[source!], range, package.tokens, package.symbols, symbol!, name!)
                        name! -> file.borrowBytes => bytes
                        bytes -> slice(0, bytes -> len) => qualified
                        policy.boxExcludedStructNames() -> containsPolicyName(qualified) => excludedStructure
                        policy.boxExcludedNominalNames() -> containsPolicyName(qualified) => excludedNominal
                        policy.canRegisterBoxName(false, kind == 3, kind == 4, excludedStructure, excludedNominal)
                            -> if {
                                declared![range.symbolStart + symbol!] => element
                                element < 0 -> if { Result<RegisteredBoxes, BoxRegistrationError>.Err(BoxRegistrationError.MissingDeclaration) -> return }
                                types -> appendRegisteredBox(ids!, available!, next!, element)
                            }
                    }
                symbol! + 1 => symbol!
            }
            source! + 1 => source!
        }
    }
    RegisteredBoxes { ids: ids! } => result
    Result<RegisteredBoxes, BoxRegistrationError>.Ok(result)
}

public enum TypeRegistryError { Storage(storage.StorageRegistrationError), Boxes(BoxRegistrationError), DeclarationIdentity, TypeUse(Int) }
public struct RegisteredDeclaration { public typeId: Int, public identity: typeIds.SemanticType }
public struct RegisteredTypeSeeds {
    public declarations: [RegisteredDeclaration; ~]
    public storage: [Int; ~]
    public boxes: [Int; ~]
    public used: [Int; ~]
}

public emptyRegisteredTypeSeeds: -> RegisteredTypeSeeds {
    RegisteredTypeSeeds { declarations: [RegisteredDeclaration; ~], storage: [Int; ~], boxes: [Int; ~], used: [Int; ~] }
}

# Expression resolution preserves arena indices while canonicalizing some
# source declarations to builtin runtime representations. Keep their original
# declaration identities separately; cache metadata still describes the source.
public registerCompilationTypeSeeds package: ref analysis.PackageAnalysis, declaredTypes: ref [typeIds.SemanticType; ~], types: mut [typeIds.SemanticType; ~] -> Result<RegisteredTypeSeeds, TypeRegistryError> {
    [Int; ~] => declarationBySymbol!
    package.symbols -> each _ { declarationBySymbol! -> push(-1) }
    0 => index!
    declaredTypes -> each identity {
        (identity.kind == 1 and (identity.origin == 0 or identity.origin == 2)) or identity.kind == 9
            -> if {
                identity.module < 0 or identity.module >= (package.ranges -> len) or index! >= (types -> len)
                    -> if { Result<RegisteredTypeSeeds, TypeRegistryError>.Err(TypeRegistryError.DeclarationIdentity) -> return }
                package.ranges[identity.module] => range
                identity.symbol < 0 or identity.symbol >= range.symbolCount or types[index!].kind != identity.kind
                    -> if { Result<RegisteredTypeSeeds, TypeRegistryError>.Err(TypeRegistryError.DeclarationIdentity) -> return }
                index! => declarationBySymbol![range.symbolStart + identity.symbol]
            }
        index! + 1 => index!
    }
    [RegisteredDeclaration; ~] => declarations!
    [3, 4] -> each kind {
        0 => source!
        source! < (package.ranges -> len) -> while {
            package.ranges[source!] => range
            0 => symbol!
            symbol! < range.symbolCount -> while {
                package.symbols[range.symbolStart + symbol!].kind == kind
                    -> if {
                        declarationBySymbol![range.symbolStart + symbol!] => identity
                        identity < 0 -> if { Result<RegisteredTypeSeeds, TypeRegistryError>.Err(TypeRegistryError.DeclarationIdentity) -> return }
                        declarations! -> push(RegisteredDeclaration { typeId: identity, identity: declaredTypes[identity] })
                    }
                symbol! + 1 => symbol!
            }
            source! + 1 => source!
        }
    }
    storage.registerPredeclaredStorageTypes(package, types) -> when {
        Err(error) { Result<RegisteredTypeSeeds, TypeRegistryError>.Err(TypeRegistryError.Storage(error)) -> return }
        Ok(value) { value }
    } => storageTypes
    registerNamedBoxes(package, types) -> when {
        Err(error) { Result<RegisteredTypeSeeds, TypeRegistryError>.Err(TypeRegistryError.Boxes(error)) -> return }
        Ok(value) { value }
    } => boxes
    RegisteredTypeSeeds { declarations: declarations!, storage: storageTypes.ids, boxes: boxes.ids, used: [Int; ~] } => seeds
    Result<RegisteredTypeSeeds, TypeRegistryError>.Ok(seeds)
}
