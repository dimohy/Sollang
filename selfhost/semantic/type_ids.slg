# Structurally unifies a generic input template with one concrete argument,
# then rebuilds and interns only the changed result nodes in the caller's type
# arena. This is the canonical compiler path: specialization must not copy the
# complete, steadily growing arena for every call.
public specializeInto types: mut [SemanticType; ~], inputTemplate: Int, actualInput: Int, resultTemplate: Int -> SpecializationRoot {
    [inputTemplate,; ~] => inputTemplates
    [actualInput,; ~] => actualInputs
    types -> specializeManyInto(inputTemplates, actualInputs, resultTemplate)
}

# All arguments contribute to one binding environment. Repeated occurrences of
# a parameter must agree across argument boundaries, not just within one input.
public specializeManyInto types: mut [SemanticType; ~], inputTemplates: ref [Int; ~], actualInputs: ref [Int; ~], resultTemplate: Int -> SpecializationRoot {
    [Int; ~] => templateStack!
    [Int; ~] => actualStack!
    [Int; ~] => parameterModules!
    [Int; ~] => parameterSymbols!
    [Int; ~] => replacements!
    [UInt64; ~] => lengthParameterHashes!
    [Int; ~] => lengthReplacements!
    [UInt64; ~] => lengthReplacementHashes!
    0 => status!
    -1 => conflictParameterModule!
    -1 => conflictParameterSymbol!
    -1 => conflictFirstActualTypeId!
    -1 => conflictActualTypeId!
    -1 => mismatchExpectedTypeId!
    -1 => mismatchActualTypeId!
    (inputTemplates -> len) != (actualInputs -> len)
        or resultTemplate < 0 or resultTemplate >= (types -> len)
        -> if {
            2 => status!
        }
    # Reverse the initial stack so inference visits source arguments in order.
    (inputTemplates -> len) - 1 => inputIndex!
    status! == 0 and inputIndex! >= 0
        -> while {
            inputTemplates[inputIndex!] => inputTemplate
            actualInputs[inputIndex!] => actualInput
            inputTemplate < 0 or inputTemplate >= (types -> len)
                or actualInput < 0 or actualInput >= (types -> len)
                -> if { 2 => status! } else {
                    templateStack! -> push(inputTemplate)
                    actualStack! -> push(actualInput)
                }
            inputIndex! - 1 => inputIndex!
        }

    status! == 0 and (templateStack! -> len) > 0
        -> while {
            (templateStack! -> len) - 1 => workIndex
            templateStack! -> take(workIndex) => templateId
            actualStack! -> take(workIndex) => actualId
            types[templateId] => template!
            types[actualId] => actual
            templateId => matchedTemplateId!
            # The semantic call boundary has already validated this readonly
            # borrow. Infer a ref T parameter from the addressable value's T.
            template!.kind == 8 and actual.kind != 8 and template!.containsParameter
                and template!.first >= 0 -> if {
                    template!.first => matchedTemplateId!
                    types[matchedTemplateId!] => template!
