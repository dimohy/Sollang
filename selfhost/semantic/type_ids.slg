                            package.symbols[resolvedNominalRange.symbolStart + targetSymbol!] => resolvedNominalSymbol
                            (resolvedNominalSymbol.flags / 512 % 2 == 1 or resolvedNominalSymbol.flags / 65536 % 2 == 1)
