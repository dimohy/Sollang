                                                -> if {
                                                package.tokens[sourceRange.tokenStart + currentProductField.nameToken] => currentProductLabel
                                                package.ranges[candidateProductField.sourceModule] => candidateProductFieldRange
                                                package.sources[candidateProductField.sourceModule] -> len => candidateProductSourceLength
                                                package.sources[candidateProductField.sourceModule] -> slice(UIntSize(0), candidateProductSourceLength) => candidateProductSource
                                                package.tokens[candidateProductFieldRange.tokenStart + candidateProductField.labelToken] => candidateProductLabel
                                                currentProductLabel.span.length == candidateProductLabel.span.length => productLabelEqual!
                                                UIntSize(0) => productLabelByte!
                                                (productLabelEqual! and productLabelByte! < currentProductLabel.span.length)
                                                    -> while {
