                        parameterModules! -> push(template!.module)
                        parameterSymbols! -> push(template!.symbol)
                        replacements! -> push(actualId)
                    }
                } else {
                    # A call may pass array storage to a borrowed slice. The
                    # call checker validates that conversion; specialization
                    # must infer the slice element from the storage element.
                    template!.kind != actual.kind
                        and not (template!.kind == 2 and (actual.kind == 3 or actual.kind == 4 or actual.kind == 12))
                        -> if { 2 => status! }
                    status! == 0 and template!.kind == 1 and matchedTemplateId! != actualId
                        -> if { 2 => status! }
                    status! == 0 and template!.kind == 7 and (template!.origin != actual.origin or template!.module != actual.module or template!.symbol != actual.symbol)
                        -> if { 2 => status! }
