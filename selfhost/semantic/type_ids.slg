                                    -> if {
                                    true => productCandidateEqual!
                                    term.firstArgument => currentProductFieldTerm!
                                    0 => currentProductOrdinal!
                                    (currentProductFieldTerm! >= 0 and productCandidateEqual!)
                                        -> while {
                                        -1 => candidateProductFieldIndex!
                                        0 => candidateProductFieldSearch!
                                        candidateProductFieldSearch! < (fields! -> len)
                                            -> while {
