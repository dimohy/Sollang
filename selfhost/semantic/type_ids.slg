                    # matching C# Result success/error diagnostic priority.
                    status! == 0 and template!.second >= 0 -> if {
                        templateStack! -> push(template!.second)
                        actualStack! -> push(actual.second)
                    }
                    status! == 0 and template!.first >= 0 -> if {
                        templateStack! -> push(template!.first)
                        actualStack! -> push(actual.first)
                    }
                }
            status! == 2 and conflictParameterSymbol! < 0 and mismatchExpectedTypeId! < 0
                -> if {
                    matchedTemplateId! => mismatchExpectedTypeId!
                    actualId => mismatchActualTypeId!
                }
        }

    -1 => specializedRoot!
    status! == 0 -> if {
        # Rebuild only the result graph reachable from resultTemplate. Walking
        # the complete type arena here makes generic calls quadratic in every
        # unrelated type accumulated by the compilation.
        [Int; ~] => nodeStack!
        [Int; ~] => stateStack!
        [Int; ~] => resolvedNodes!
        [Int; ~] => resolvedTypes!
        nodeStack! -> push(resultTemplate)
        stateStack! -> push(0)
        (nodeStack! -> len) > 0 -> while {
            (nodeStack! -> len) - 1 => topIndex
            nodeStack![topIndex] => nodeId
            stateStack![topIndex] => nodeState

            -1 => alreadyResolved!
            0 => resolvedSearch!
            resolvedSearch! < (resolvedNodes! -> len) and alreadyResolved! < 0
                -> while {
                    resolvedNodes![resolvedSearch!] == nodeId -> if {
                        resolvedTypes![resolvedSearch!] => alreadyResolved!
                    }
                    resolvedSearch! + 1 => resolvedSearch!
                }

            alreadyResolved! >= 0 -> if {
                nodeStack! -> take(topIndex) => discardedNode
                stateStack! -> take(topIndex) => discardedState
            } else {
                types[nodeId] => current
                -1 => parameterReplacement!
                current.kind == 1 and current.origin == 3 -> if {
                    0 => parameterReplacementSearch!
                    parameterReplacementSearch! < (parameterSymbols! -> len) and parameterReplacement! < 0
                        -> while {
                            parameterModules![parameterReplacementSearch!] == current.module and parameterSymbols![parameterReplacementSearch!] == current.symbol
                                -> if {
                                    replacements![parameterReplacementSearch!] => parameterReplacement!
                                }
                            parameterReplacementSearch! + 1 => parameterReplacementSearch!
                        }
                }

                parameterReplacement! >= 0 -> if {
                    resolvedNodes! -> push(nodeId)
                    resolvedTypes! -> push(parameterReplacement!)
                    nodeStack! -> take(topIndex) => discardedNode
                    stateStack! -> take(topIndex) => discardedState
                } else {
                    nodeState == 0 -> if {
                        1 => stateStack![topIndex]
                        current.first >= 0 -> if {
                            nodeStack! -> push(current.first)
                            stateStack! -> push(0)
                        }
                    } else {
                        nodeState == 1 -> if {
                            2 => stateStack![topIndex]
                            current.second >= 0 -> if {
                                nodeStack! -> push(current.second)
                                stateStack! -> push(0)
                            }
                        } else {
                            current.first => first!
                            current.first >= 0 -> if {
                                -1 => first!
                                0 => firstSearch!
                                firstSearch! < (resolvedNodes! -> len) and first! < 0
                                    -> while {
                                        resolvedNodes![firstSearch!] == current.first
                                            -> if { resolvedTypes![firstSearch!] => first! }
                                        firstSearch! + 1 => firstSearch!
                                    }
                            }
                            current.second => second!
                            current.second >= 0 -> if {
                                -1 => second!
                                0 => secondSearch!
                                secondSearch! < (resolvedNodes! -> len) and second! < 0
                                    -> while {
                                        resolvedNodes![secondSearch!] == current.second
                                            -> if { resolvedTypes![secondSearch!] => second! }
                                        secondSearch! + 1 => secondSearch!
                                    }
                            }

                            current.length => specializedLength!
                            current.lengthHash => specializedLengthHash!
                            current.kind == 4 and current.length < 0 and current.lengthHash != 0
                                -> if {
                                    0 => specializedLengthSearch!
                                    specializedLengthSearch! < (lengthParameterHashes! -> len)
                                        and specializedLength! < 0 -> while {
                                            lengthParameterHashes![specializedLengthSearch!] == current.lengthHash
                                                -> if {
                                                    lengthReplacements![specializedLengthSearch!] => specializedLength!
                                                    lengthReplacementHashes![specializedLengthSearch!] => specializedLengthHash!
                                                }
                                            specializedLengthSearch! + 1 => specializedLengthSearch!
                                        }
                                }
                            nodeId => replacementType!
                            first! != current.first or second! != current.second
                                or specializedLength! != current.length
                                or specializedLengthHash! != current.lengthHash
                                -> if {
                                    current.origin == 3 => containsParameter!
                                    current.kind == 4 and specializedLength! < 0 and specializedLengthHash! != 0
                                        -> if { true => containsParameter! }
                                    first! >= 0 -> if { types[first!].containsParameter
                                            -> if { true => containsParameter! } }
                                    second! >= 0 -> if { types[second!].containsParameter
                                            -> if { true => containsParameter! } }
                                    -1 => existing!
                                    0 => existingSearch!
                                    existingSearch! < (types -> len) and existing! < 0
                                        -> while {
                                            types[existingSearch!] => known
                                            known.kind == current.kind and known.origin == current.origin and known.module == current.module and known.symbol == current.symbol and known.first == first! and known.second == second! and known.length == specializedLength! and known.lengthHash == specializedLengthHash! and known.status == current.status
                                                -> if {
                                                    existingSearch! => existing!
                                                }
                                            existingSearch! + 1 => existingSearch!
                                        }
                                    existing! < 0 -> if {
                                        types -> len => existing!
                                        types -> push(SemanticType {
                                            kind: current.kind
                                            origin: current.origin
                                            module: current.module
                                            symbol: current.symbol
                                            first: first!
                                            second: second!
                                            length: specializedLength!
                                            lengthHash: specializedLengthHash!
                                            containsParameter: containsParameter!
                                            status: current.status
                                        })
                                    }
                                    existing! => replacementType!
                                }
                            resolvedNodes! -> push(nodeId)
                            resolvedTypes! -> push(replacementType!)
                            nodeStack! -> take(topIndex) => discardedNode
                            stateStack! -> take(topIndex) => discardedState
                        }
                    }
                }
            }
        }
        0 => resultSearch!
        resultSearch! < (resolvedNodes! -> len) and specializedRoot! < 0
            -> while {
                resolvedNodes![resultSearch!] == resultTemplate
                    -> if { resolvedTypes![resultSearch!] => specializedRoot! }
                resultSearch! + 1 => resultSearch!
            }
    }

    SpecializationRoot {
        root: specializedRoot!
        status: status!
        conflictParameterModule: conflictParameterModule!
        conflictParameterSymbol: conflictParameterSymbol!
        conflictFirstActualTypeId: conflictFirstActualTypeId!
        conflictActualTypeId: conflictActualTypeId!
        mismatchExpectedTypeId: mismatchExpectedTypeId!
        mismatchActualTypeId: mismatchActualTypeId!
    } => result
    result
}

# Compatibility value API for callers that intentionally want an independent
# arena. Ownership moves into the wrapper; no redundant copy is performed.
public specialize request: SpecializationRequest -> SpecializationResult {
    request.inputTemplate => inputTemplate
    request.actualInput => actualInput
    request.resultTemplate => resultTemplate
    [SemanticType; ~] => types!
    0 => compatibilityTypeIndex!
    compatibilityTypeIndex! < (request.types -> len)
        -> while {
            types! -> push(request.types[compatibilityTypeIndex!])
            compatibilityTypeIndex! + 1 => compatibilityTypeIndex!
        }
    types! -> specializeInto(inputTemplate, actualInput, resultTemplate) => specialized
    SpecializationResult { types: types!, root: specialized.root, status: specialized.status } => result
    result
}
