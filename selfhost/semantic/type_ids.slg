                                    -> while {
                                        lengthParameterHashes![lengthParameterSearch!] == template!.lengthHash
                                            -> if { lengthParameterSearch! => lengthParameterIndex! }
                                        lengthParameterSearch! + 1 => lengthParameterSearch!
