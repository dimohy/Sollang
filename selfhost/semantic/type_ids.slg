namespace sollang.compiler.semantic.type_ids

import sollang.compiler.ast
import sollang.compiler.lexer
import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.module_resolve as moduleResolve
import sollang.compiler.semantic.modules
import sollang.compiler.semantic.qualified
import sollang.compiler.semantic.symbols
import syntax.generated.slg as grammar

# Kinds match type_terms: 1 nominal, 2 slice, 3 dynamic array, 4 fixed
# array, 5 dictionary, 6 box, 7 nominal application, 8 readonly reference,
# 9 affine external handle (COM interface or native opaque handle),
# 12 bounded inline array, 13 bounded inline dictionary, 14 fixed inline BitSet.
# Nominal origins: 0 local declaration, 1 builtin, 2 imported declaration,
# 3 generic parameter, 4 intrinsic type constructor.
public struct SemanticType {
    kind: Int
    origin: Int
    module: Int
    symbol: Int
    first: Int
    second: Int
    length: Int
    lengthHash: UInt64
    containsParameter: Bool
    status: Int
}

public struct TypeReference {
    sourceModule: Int
    typeAst: Int
    typeId: Int
    status: Int
}

public struct NominalField {
    ownerType: Int
    sourceModule: Int
    ownerSymbol: Int
    fieldSymbol: Int
    # Structural product fields use fieldSymbol = -1. A labeled field keeps
    # its exact source token here; an unlabeled tuple field uses -1.
    labelToken: Int
    ordinal: Int
    fieldType: Int
    status: Int
}

public struct SemanticTypeSet {
    types: [SemanticType; ~]
    references: [TypeReference; ~]
    fields: [NominalField; ~]
}

struct SpanNameRequest {
    source: Text
    start: UIntSize
    length: UIntSize
    expected: Text
}

public struct SpecializationRequest {
    types: [SemanticType; ~]
    inputTemplate: Int
    actualInput: Int
    resultTemplate: Int
}

public struct SpecializationResult {
    types: [SemanticType; ~]
    root: Int
    status: Int
}

public struct SpecializationRoot {
    root: Int
    status: Int
}

spanNameIs request: SpanNameRequest -> Bool {
    request.length == (request.expected -> len) => equal!
    UIntSize(0) => byteIndex!
    (equal! and byteIndex! < request.length) -> while {
        (request.source -> byte(request.start + byteIndex!)) != (request.expected -> byte(byteIndex!))
            -> if { false => equal! }
        byteIndex! + 1 => byteIndex!
    }
    equal!
}

public intrinsicNominalSymbol package: ref analysis.PackageAnalysis, identities: ref [modules.ModuleIdentity; ~], targetModule: Int, targetSymbol: Int -> Int {
    "sys.file" => fileNamespace
    "SourceText" => sourceTextName
    identities[targetModule] => identity
    package.sources[identity.sourceIndex] -> len => sourceLength
    package.sources[identity.sourceIndex] -> slice(UIntSize(0), sourceLength) => source
    package.ranges[identity.sourceIndex] => sourceRange
    package.symbols[sourceRange.symbolStart + targetSymbol] => symbol
    package.tokens[sourceRange.tokenStart + symbol.nameToken] => name
    (SpanNameRequest { source: source, start: identity.pathStart, length: identity.pathLength, expected: fileNamespace } -> spanNameIs)
        -> if {
        (SpanNameRequest { source: source, start: name.span.start, length: name.span.length, expected: sourceTextName } -> spanNameIs)
            -> if { 24 } else { -1 }
    } else { -1 }
}

# Canonical ownership traits derived from the recursive type arena.
# Bit 0 means the value owns destruction responsibility. Bit 1 means that
# responsibility reaches heap-backed storage. Child IDs always precede their
# parents, so fixed arrays and nominal applications are classified bottom-up.
public classify sourceTypes: [SemanticType; ~], sourceFields: [NominalField; ~] -> [Int; ~] {
    [SemanticType; ~] => types!
    0 => copyTypeIndex!
    copyTypeIndex! < (sourceTypes -> len) -> while {
        types! -> push(sourceTypes[copyTypeIndex!])
        copyTypeIndex! + 1 => copyTypeIndex!
    }
    [NominalField; ~] => fields!
    0 => copyFieldIndex!
    copyFieldIndex! < (sourceFields -> len) -> while {
        fields! -> push(sourceFields[copyFieldIndex!])
        copyFieldIndex! + 1 => copyFieldIndex!
    }
    [Int; ~] => traits!
    0 => seedTypeIndex!
    seedTypeIndex! < (types! -> len) -> while {
        types![seedTypeIndex!] => current
        false => owns!
        false => reachesHeap!
        current.kind == 9 -> if { true => owns! }
        (current.kind == 3 or current.kind == 5 or current.kind == 6)
            -> if {
            true => owns!
            true => reachesHeap!
        }
        (current.kind == 12 or current.kind == 13) -> if { true => owns! }
        (current.kind == 1 and current.origin == 1 and current.symbol == 24)
            -> if {
            true => owns!
            true => reachesHeap!
        }
        (current.kind == 1 and (current.origin == 0 or current.origin == 2))
            -> if {
            true => owns!
        }
        # Stream and EventStream are affine producer handles. Their fixed
        # three-pointer ABI owns producer state even when T itself is scalar.
        (current.kind == 7 and current.origin == 4 and (current.symbol == 3 or current.symbol == 4))
            -> if {
            true => owns!
            true => reachesHeap!
        }
        (current.kind == 7 and current.origin == 4 and (current.symbol == 5 or current.symbol == 6 or current.symbol == 7))
            -> if {
            true => owns!
            true => reachesHeap!
        }
        (current.kind == 4 or current.kind == 7 or current.kind == 12 or current.kind == 13)
            -> if {
            current.first >= 0 -> if {
                traits![current.first] % 2 == 1 -> if { true => owns! }
                (traits![current.first] / 2) % 2 == 1 -> if { true => reachesHeap! }
            }
            current.second >= 0 -> if {
                traits![current.second] % 2 == 1 -> if { true => owns! }
                (traits![current.second] / 2) % 2 == 1 -> if { true => reachesHeap! }
            }
        }
        0 => value!
        owns! -> if { value! + 1 => value! }
        reachesHeap! -> if { value! + 2 => value! }
        traits! -> push(value!)
        seedTypeIndex! + 1 => seedTypeIndex!
    }
    true => changed!
    changed! -> while {
        false => changed!
        0 => typeIndex!
        typeIndex! < (types! -> len) -> while {
            types![typeIndex!] => current
            traits![typeIndex!] => value
            value % 2 == 1 => owns!
            (value / 2) % 2 == 1 => reachesHeap!
            (current.kind == 4 or current.kind == 7 or current.kind == 12 or current.kind == 13)
                -> if {
                current.first >= 0 -> if {
                    traits![current.first] % 2 == 1 -> if { true => owns! }
                    (traits![current.first] / 2) % 2 == 1 -> if { true => reachesHeap! }
                }
                current.second >= 0 -> if {
                    traits![current.second] % 2 == 1 -> if { true => owns! }
                    (traits![current.second] / 2) % 2 == 1 -> if { true => reachesHeap! }
                }
            }
            0 => fieldIndex!
            fieldIndex! < (fields! -> len) -> while {
                fields![fieldIndex!] => field
                (field.status == 0 and field.ownerType == typeIndex! and field.fieldType >= 0)
                    -> if {
                    traits![field.fieldType] % 2 == 1 -> if { true => owns! }
                    (traits![field.fieldType] / 2) % 2 == 1 -> if { true => reachesHeap! }
                }
                fieldIndex! + 1 => fieldIndex!
            }
            0 => nextValue!
            owns! -> if { nextValue! + 1 => nextValue! }
            reachesHeap! -> if { nextValue! + 2 => nextValue! }
            nextValue! != value -> if {
                nextValue! => traits![typeIndex!]
                true => changed!
            }
            typeIndex! + 1 => typeIndex!
        }
    }
    traits!
}

# Resolves and globally interns recursive annotation types across source files.
# Nominal equality uses declaration identity, not source spelling.
public resolve sources: [Text; ~] -> SemanticTypeSet {
    sources -> analysis.analyze => package
    package -> resolveAnalyzed
}

public resolveAnalyzed package: analysis.PackageAnalysis -> SemanticTypeSet {
    ["Unit", "Text", "Int", "Int8", "Int16", "Int32", "Int64", "Long", "UInt8", "UInt16", "UInt32", "UInt64", "Size", "UIntSize", "CodePoint", "Arena", "Arguments", "MappedBytes", "MutableMappedBytes", "Float", "Float32", "Float64", "Double", "Bool", "SourceText", "Range"] => builtinNames
    package -> modules.identitiesAnalyzed => identities
    package -> modules.importsAnalyzed => imports
    package -> moduleResolve.resolveAnalyzed => resolvedImports
    package -> qualified.resolveAnalyzed => qualifiedResults
    [SemanticType; ~] => semanticTypes!
    [TypeReference; ~] => references!
    [NominalField; ~] => fields!

    # Seed builtins in their stable nominal-symbol order. Expression inference
    # can therefore use the same id without an adapter or encounter-order map.
    0 => builtinSeed!
    builtinSeed! < (builtinNames -> len) -> while {
        semanticTypes! -> push(SemanticType {
            kind: 1
            origin: 1
            module: -1
            symbol: builtinSeed!
            first: -1
            second: -1
            length: -1
            lengthHash: 0
            containsParameter: false
            status: 0
        })
        builtinSeed! + 1 => builtinSeed!
    }

    # Seed every generated affine external type even when user source never
    # spells it. COM activation/clone/receivers and native opaque handles then
    # share the same pointer-sized canonical identity without wrapper storage.
    0 => comTypeSourceIndex!
    comTypeSourceIndex! < (package.sources -> len)
        -> while {
        package.ranges[comTypeSourceIndex!] => comTypeRange
        0 => comTypeSymbolIndex!
        comTypeSymbolIndex! < comTypeRange.symbolCount
            -> while {
            package.symbols[comTypeRange.symbolStart + comTypeSymbolIndex!] => comTypeSymbol
            (comTypeSymbol.kind == 3 and (comTypeSymbol.flags / 512 % 2 == 1 or comTypeSymbol.flags / 65536 % 2 == 1))
                -> if {
                semanticTypes! -> len => comInterfaceTypeId
                semanticTypes! -> push(SemanticType {
                    kind: 9
                    origin: 0
                    module: comTypeSourceIndex!
                    symbol: comTypeSymbolIndex!
                    first: -1
                    second: -1
                    length: -1
                    lengthHash: 0
                    containsParameter: false
                    status: 0
                })
                comTypeSymbol.flags / 512 % 2 == 1 -> if {
                    semanticTypes! -> push(SemanticType {
                        kind: 7
                        origin: 4
                        module: -1
                        symbol: 1
                        first: comInterfaceTypeId
                        second: 5
                        length: -1
                        lengthHash: 0
                        containsParameter: false
                        status: 0
                    })
                }
            }
            comTypeSymbolIndex! + 1 => comTypeSymbolIndex!
        }
        comTypeSourceIndex! + 1 => comTypeSourceIndex!
    }

    0 => sourceIndex!
    sourceIndex! < (package.sources -> len) -> while {
        package.sources[sourceIndex!] -> len => sourceLength
        package.sources[sourceIndex!] -> slice(UIntSize(0), sourceLength) => source
        package.ranges[sourceIndex!] => sourceRange
        [Int; ~] => mapped!
        0 => mapSeed!
        mapSeed! < sourceRange.termCount -> while {
            mapped! -> push(-1)
            mapSeed! + 1 => mapSeed!
        }

        0 => completed!
        true => changed!
        (completed! < sourceRange.termCount and changed!)
            -> while {
            false => changed!
            0 => termIndex!
            termIndex! < sourceRange.termCount -> while {
                mapped![termIndex!] < 0 -> if {
                    package.terms[sourceRange.termStart + termIndex!] => term
                    (term.firstArgument < 0 or mapped![term.firstArgument] >= 0) => firstReady
                    (term.secondArgument < 0 or mapped![term.secondArgument] >= 0) => secondReady
                    (firstReady and secondReady) -> if {
                        term.kind == 0 -> if {
                            mapped![term.firstArgument] => transparentType
                            transparentType => mapped![termIndex!]
                            references! -> push(TypeReference {
                                sourceModule: sourceIndex!
                                typeAst: term.astNode
                                typeId: transparentType
                                status: semanticTypes![transparentType].status
                            })
                            completed! + 1 => completed!
                            true => changed!
                        } else {
                        -1 => origin!
                        -1 => targetModule!
                        -1 => targetSymbol!
                        0 => status!
                        term.kind == 1 -> if {
                            -1 => qualifiedIndex!
                            0 => qualifiedSearch!
                            qualifiedSearch! < (qualifiedResults -> len) -> while {
                                qualifiedResults[qualifiedSearch!] => candidate
                                candidate.sourceModule == sourceIndex! -> if {
                                    package.nodes[sourceRange.astStart + candidate.pathAst] => candidatePath
                                    (term.nameToken >= candidatePath.firstToken and term.nameToken < candidatePath.firstToken + candidatePath.tokenCount)
                                        -> if {
                                        qualifiedSearch! => qualifiedIndex!
                                    }
                                }
                                qualifiedSearch! + 1 => qualifiedSearch!
                            }
                            qualifiedIndex! >= 0 -> if {
                                qualifiedResults[qualifiedIndex!] => imported
                                2 => origin!
                                identities[imported.targetModule].sourceIndex => targetModule!
                                imported.targetSymbol => targetSymbol!
                                imported.status => status!
                                imported.status == 0 -> if {
                                    package -> intrinsicNominalSymbol(identities, imported.targetModule, imported.targetSymbol) => intrinsicSymbol
                                    intrinsicSymbol >= 0 -> if {
                                        1 => origin!
                                        -1 => targetModule!
                                        intrinsicSymbol => targetSymbol!
                                    }
                                }
                            } else {
                                package.tokens[sourceRange.tokenStart + term.nameToken] => name
                                -1 => builtinIndex!
                                0 => builtinSearch!
                                (builtinSearch! < (builtinNames -> len) and builtinIndex! < 0)
                                    -> while {
                                    builtinNames[builtinSearch!] => builtinName
                                    name.span.length == (builtinName -> len) => equal!
                                    UIntSize(0) => nameByte!
                                    (equal! and nameByte! < name.span.length) -> while {
                                        source -> byte(name.span.start + nameByte!) => leftByte
                                        builtinName -> byte(nameByte!) => rightByte
                                        leftByte != rightByte -> if { false => equal! }
                                        nameByte! + 1 => nameByte!
                                    }
                                    equal! -> if { builtinSearch! => builtinIndex! }
                                    builtinSearch! + 1 => builtinSearch!
                                }
                                builtinIndex! >= 0 -> if {
                                    1 => origin!
                                    -1 => targetModule!
                                    builtinIndex! => targetSymbol!
                                } else {
                                    -1 => ownerFunction!
                                    package.nodes[sourceRange.astStart + term.astNode].parent => ownerAst!
                                    (ownerAst! >= 0 and ownerFunction! < 0) -> while {
                                        0 => ownerSymbolIndex!
                                        ownerSymbolIndex! < sourceRange.symbolCount -> while {
                                            package.symbols[sourceRange.symbolStart + ownerSymbolIndex!] => ownerCandidate
                                            (ownerCandidate.kind == 7 and ownerCandidate.astNode == ownerAst!)
                                                -> if {
                                                ownerSymbolIndex! => ownerFunction!
                                            }
                                            ownerSymbolIndex! + 1 => ownerSymbolIndex!
                                        }
                                        ownerFunction! < 0 -> if { package.nodes[sourceRange.astStart + ownerAst!].parent => ownerAst! }
                                    }
                                    -1 => localSymbol!
                                    0 => symbolIndex!
                                    (symbolIndex! < sourceRange.symbolCount and localSymbol! < 0)
                                        -> while {
                                        package.symbols[sourceRange.symbolStart + symbolIndex!] => candidate
                                        ((candidate.parent < 0 and (candidate.kind == 3 or candidate.kind == 4)) or (candidate.kind == 32 and candidate.parent == ownerFunction!))
                                            -> if {
                                            package.tokens[sourceRange.tokenStart + candidate.nameToken] => candidateName
                                            name.span.length == candidateName.span.length => equal!
                                            UIntSize(0) => localByte!
                                            (equal! and localByte! < name.span.length) -> while {
                                                source -> byte(name.span.start + localByte!) => leftByte
                                                source -> byte(candidateName.span.start + localByte!) => rightByte
                                                leftByte != rightByte -> if { false => equal! }
                                                localByte! + 1 => localByte!
                                            }
                                            equal! -> if { symbolIndex! => localSymbol! }
                                        }
                                        symbolIndex! + 1 => symbolIndex!
                                    }
                                    sourceIndex! => localTypeSource!
                                    false => siblingTypeAmbiguous!
                                    localSymbol! < 0 -> if {
                                        identities[sourceIndex!] => currentIdentity
                                        0 => siblingModuleIndex!
                                        siblingModuleIndex! < (identities -> len) -> while {
                                            identities[siblingModuleIndex!] => siblingIdentity
                                            (siblingIdentity.sourceIndex != sourceIndex! and siblingIdentity.pathHash == currentIdentity.pathHash)
                                                -> if {
                                                siblingIdentity.sourceIndex => siblingSourceIndex
                                                package.sources[siblingSourceIndex] -> len => siblingSourceLength
                                                package.sources[siblingSourceIndex] -> slice(UIntSize(0), siblingSourceLength) => siblingSource
                                                package.ranges[siblingSourceIndex] => siblingRange
                                                0 => siblingSymbolIndex!
                                                siblingSymbolIndex! < siblingRange.symbolCount
                                                    -> while {
                                                    package.symbols[siblingRange.symbolStart + siblingSymbolIndex!] => siblingCandidate
                                                    (siblingCandidate.parent < 0 and (siblingCandidate.kind == 3 or siblingCandidate.kind == 4))
                                                        -> if {
                                                        package.tokens[siblingRange.tokenStart + siblingCandidate.nameToken] => siblingName
                                                        name.span.length == siblingName.span.length => siblingEqual!
                                                        UIntSize(0) => siblingByte!
                                                        (siblingEqual! and siblingByte! < name.span.length)
                                                            -> while {
                                                            (source -> byte(name.span.start + siblingByte!)) != (siblingSource -> byte(siblingName.span.start + siblingByte!))
                                                                -> if {
                                                                false => siblingEqual!
                                                            }
                                                            siblingByte! + 1 => siblingByte!
                                                        }
                                                        siblingEqual! -> if {
                                                            localSymbol! >= 0 -> if {
                                                                true => siblingTypeAmbiguous!
                                                            } else {
                                                                siblingSymbolIndex! => localSymbol!
                                                                siblingSourceIndex => localTypeSource!
                                                            }
                                                        }
                                                    }
                                                    siblingSymbolIndex! + 1 => siblingSymbolIndex!
                                                }
                                            }
                                            siblingModuleIndex! + 1 => siblingModuleIndex!
                                        }
                                    }
                                    (localSymbol! >= 0 and not siblingTypeAmbiguous!)
                                        -> if {
                                        package.ranges[localTypeSource!] => localTypeRange
                                        package.symbols[localTypeRange.symbolStart + localSymbol!].kind == 32
                                            -> if { 3 => origin! } else { 0 => origin! }
                                        localTypeSource! => targetModule!
                                        localSymbol! => targetSymbol!
                                    } else {
                                        -1 => importedTypeModule!
                                        -1 => importedTypeSymbol!
                                        0 => importedTypeMatches!
                                        false => searchImportedType!
                                        name.span.length == 10 -> if {
                                            ((source -> byte(name.span.start)) == 77
                                                and (source -> byte(name.span.start + 1)) == 111
                                                and (source -> byte(name.span.start + 2)) == 117
                                                and (source -> byte(name.span.start + 3)) == 115
                                                and (source -> byte(name.span.start + 4)) == 101
                                                and (source -> byte(name.span.start + 5)) == 69
                                                and (source -> byte(name.span.start + 6)) == 118
                                                and (source -> byte(name.span.start + 7)) == 101
                                                and (source -> byte(name.span.start + 8)) == 110
                                                and (source -> byte(name.span.start + 9)) == 116)
                                                    -> if {
                                                true => searchImportedType!
                                            }
                                        }
                                        0 => importedTypeEdgeIndex!
                                        (searchImportedType! and importedTypeEdgeIndex! < (imports -> len))
                                            -> while {
                                            imports[importedTypeEdgeIndex!] => importedTypeEdge
                                            resolvedImports[importedTypeEdgeIndex!] => importedTypeResolution
                                            (importedTypeEdge.sourceModule == sourceIndex! and importedTypeResolution.status == 0)
                                                -> if {
                                                identities[importedTypeResolution.targetModule].sourceIndex => importedTypeSourceModule
                                                package.sources[importedTypeSourceModule] -> len => importedTypeSourceLength
                                                package.sources[importedTypeSourceModule] -> slice(UIntSize(0), importedTypeSourceLength) => importedTypeSource
                                                package.ranges[importedTypeSourceModule] => importedTypeRange
                                                0 => importedTypeCandidateIndex!
                                                importedTypeCandidateIndex! < importedTypeRange.symbolCount
                                                    -> while {
                                                    package.symbols[importedTypeRange.symbolStart + importedTypeCandidateIndex!] => importedTypeCandidate
                                                    (importedTypeCandidate.parent < 0 and (importedTypeCandidate.kind == 3 or importedTypeCandidate.kind == 4) and importedTypeCandidate.flags >= 4)
                                                        -> if {
                                                        package.tokens[importedTypeRange.tokenStart + importedTypeCandidate.nameToken] => importedTypeCandidateName
                                                        name.span.length == importedTypeCandidateName.span.length => importedTypeNameEqual!
                                                        UIntSize(0) => importedTypeNameByte!
                                                        (importedTypeNameEqual! and importedTypeNameByte! < name.span.length)
                                                            -> while {
                                                            (source -> byte(name.span.start + importedTypeNameByte!)) != (importedTypeSource -> byte(importedTypeCandidateName.span.start + importedTypeNameByte!))
                                                                -> if {
                                                                false => importedTypeNameEqual!
                                                            }
                                                            importedTypeNameByte! + 1 => importedTypeNameByte!
                                                        }
                                                        importedTypeNameEqual! -> if {
                                                            importedTypeSourceModule => importedTypeModule!
                                                            importedTypeCandidateIndex! => importedTypeSymbol!
                                                            importedTypeMatches! + 1 => importedTypeMatches!
                                                        }
                                                    }
                                                    importedTypeCandidateIndex! + 1 => importedTypeCandidateIndex!
                                                }
                                            }
                                            importedTypeEdgeIndex! + 1 => importedTypeEdgeIndex!
                                        }
                                        importedTypeMatches! == 1 -> if {
                                            2 => origin!
                                            importedTypeModule! => targetModule!
                                            importedTypeSymbol! => targetSymbol!
                                        } else {
                                            2 => status!
                                        }
                                    }
                                }
                            }
                        }
                        term.kind == 7 -> if {
                            4 => origin!
                            -1 => targetModule!
                            package.tokens[sourceRange.tokenStart + term.nameToken] => constructorName
                            constructorName.span.length == 6 -> if {
                                source -> byte(constructorName.span.start) => byte0
                                source -> byte(constructorName.span.start + 1) => byte1
                                source -> byte(constructorName.span.start + 2) => byte2
                                source -> byte(constructorName.span.start + 3) => byte3
                                source -> byte(constructorName.span.start + 4) => byte4
                                source -> byte(constructorName.span.start + 5) => byte5
                                (byte0 == 82 and byte1 == 101 and byte2 == 115 and byte3 == 117 and byte4 == 108 and byte5 == 116)
                                    -> if { 1 => targetSymbol! }
                                (byte0 == 79 and byte1 == 112 and byte2 == 116 and byte3 == 105 and byte4 == 111 and byte5 == 110)
                                    -> if { 0 => targetSymbol! }
                                (byte0 == 83 and byte1 == 116 and byte2 == 114 and byte3 == 101 and byte4 == 97 and byte5 == 109)
                                    -> if { 3 => targetSymbol! }
                            }
                            constructorName.span.length == 4 -> if {
                                source -> byte(constructorName.span.start) => byte0
                                source -> byte(constructorName.span.start + 1) => byte1
                                source -> byte(constructorName.span.start + 2) => byte2
                                source -> byte(constructorName.span.start + 3) => byte3
                                (byte0 == 84 and byte1 == 97 and byte2 == 115 and byte3 == 107)
                                    -> if { 2 => targetSymbol! }
                            }
                            constructorName.span.length == 3 -> if {
                                source -> byte(constructorName.span.start) => byte0
                                source -> byte(constructorName.span.start + 1) => byte1
                                source -> byte(constructorName.span.start + 2) => byte2
                                (byte0 == 83 and byte1 == 101 and byte2 == 116)
                                    -> if { 5 => targetSymbol! }
                            }
                            constructorName.span.length == 5 -> if {
                                source -> byte(constructorName.span.start) => byte0
                                source -> byte(constructorName.span.start + 1) => byte1
                                source -> byte(constructorName.span.start + 2) => byte2
                                source -> byte(constructorName.span.start + 3) => byte3
                                source -> byte(constructorName.span.start + 4) => byte4
                                (byte0 == 68 and byte1 == 101 and byte2 == 113 and byte3 == 117 and byte4 == 101)
                                    -> if { 6 => targetSymbol! }
                            }
                            constructorName.span.length == 10 -> if {
                                source -> byte(constructorName.span.start) => byte0
                                source -> byte(constructorName.span.start + 1) => byte1
                                source -> byte(constructorName.span.start + 2) => byte2
                                source -> byte(constructorName.span.start + 3) => byte3
                                source -> byte(constructorName.span.start + 4) => byte4
                                source -> byte(constructorName.span.start + 5) => byte5
                                source -> byte(constructorName.span.start + 6) => byte6
                                source -> byte(constructorName.span.start + 7) => byte7
                                source -> byte(constructorName.span.start + 8) => byte8
                                source -> byte(constructorName.span.start + 9) => byte9
                                (byte0 == 66 and byte1 == 105 and byte2 == 110 and byte3 == 97 and byte4 == 114 and byte5 == 121 and byte6 == 72 and byte7 == 101 and byte8 == 97 and byte9 == 112)
                                    -> if { 7 => targetSymbol! }
                            }
                            constructorName.span.length == 11 -> if {
                                source -> byte(constructorName.span.start) => byte0
                                source -> byte(constructorName.span.start + 1) => byte1
                                source -> byte(constructorName.span.start + 2) => byte2
                                source -> byte(constructorName.span.start + 3) => byte3
                                source -> byte(constructorName.span.start + 4) => byte4
                                source -> byte(constructorName.span.start + 5) => byte5
                                source -> byte(constructorName.span.start + 6) => byte6
                                source -> byte(constructorName.span.start + 7) => byte7
                                source -> byte(constructorName.span.start + 8) => byte8
                                source -> byte(constructorName.span.start + 9) => byte9
                                source -> byte(constructorName.span.start + 10) => byte10
                                (byte0 == 69 and byte1 == 118 and byte2 == 101 and byte3 == 110 and byte4 == 116 and byte5 == 83 and byte6 == 116 and byte7 == 114 and byte8 == 101 and byte9 == 97 and byte10 == 109)
                                    -> if { 4 => targetSymbol! }
                            }
                            targetSymbol! < 0 -> if { 2 => status! }
                        }
                        term.kind == 14 -> if {
                            4 => origin!
                            -1 => targetModule!
                            8 => targetSymbol!
                        }

                        -1 => firstType!
                        term.firstArgument >= 0 -> if { mapped![term.firstArgument] => firstType! }
