public canRegisterBoxName primitive: Bool, structure: Bool, enumeration: Bool, excludedStructure: Bool, excludedNominal: Bool -> Bool {
    UInt64(64254) => decision!
    primitive -> if { decision! / 2 => decision! }
    structure -> if { decision! / 4 => decision! }
    enumeration -> if { decision! / 16 => decision! }
