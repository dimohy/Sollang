        # A when consumes the enum carrier, rather than selecting a struct field.
        path[stepIndex!].kind == 2 -> if { true -> return }
        typed[current!].parent => parentIr
        parentIr < 0 or parentIr >= (typed -> len) -> if { true -> return }
        typed[parentIr] => projection
