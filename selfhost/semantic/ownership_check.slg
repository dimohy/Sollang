                                                                                    sourceModule: functionCaptureNode.sourceModule
                                                                                    functionSymbol: typed[captureFunctionIr].symbol
                                                                                    expectedOrigin: -1
                                                                                    expectedModule: -1
                                                                                    expectedSymbol: -1
                                                                                    actualOrigin: functionCaptureBinding.typeOrigin
                                                                                    actualModule: functionCaptureBinding.typeModule
                                                                                    actualSymbol: functionCaptureBinding.typeSymbol
                                                                                    actualBuiltin: functionCaptureBinding.typeSymbol
                                                                                    readonlyReferencePath: -1
                                                                                    span: syntax.SourceSpan { fileId: functionCaptureNode.sourceModule, start: functionCaptureAst.start, length: functionCaptureAst.length }
                                                                                })
                                                                            }
                                                                        }
                                                                }
                                                            }
                                                    }
                                                    functionCaptureNode.kind == 6 and functionCaptureNode.targetModule >= 0 and functionCaptureNode.symbol >= 0
                                                        -> if {
                                                            -1 => transitiveTargetFunction!
                                                            functionCaptureNode.targetModule -> parallelDeclaration(functionCaptureNode.symbol, parallelFunctionBySymbol!) => transitiveTargetFunction!
                                                            transitiveTargetFunction! >= 0 and parallelLocalFunctions![transitiveTargetFunction!]
                                                                -> if { pendingCaptureFunctions! -> push(transitiveTargetFunction!) }
                                                        }
                                                }
                                            functionCaptureSearch! + 1 => functionCaptureSearch!
                                        }
                                    }
                                    pendingCaptureFunctionIndex! + 1 => pendingCaptureFunctionIndex!
                                }
                        }
                    }
            }
            parallelIrIndex! + 1 => parallelIrIndex!
        }
    }
    # Refine a moved-use fact only when both endpoints are consuming literal
    # transfers into the same aggregate. A read, fixed-storage copy or call
    # argument is not a second aggregate position. Existing overlap/reachability
    # facts retain responsibility for rejecting the aliasing source paths.
    [OwnershipDiagnostic; ~] => classifiedDiagnostics!
    # Aggregate duplication is an independent semantic decision. A prior
    # moved-read error need not exist (whole-owner then field is one such case).
    # Index prior transfers by owning literal so unrelated aggregates are not
    # compared in a global quadratic scan.
    [Int; ~] => aggregateHeads!
    0 => aggregateNode!
    aggregateNode! < (typed -> len) -> while {
        aggregateHeads! -> push(-1)
        aggregateNode! + 1 => aggregateNode!
    }
    [Int; ~] => aggregateNext!
    0 => aggregateMoveIndex!
    aggregateMoveIndex! < (moves! -> len) -> while {
        moves![aggregateMoveIndex!] => currentMove
        # Await consumes the Task, not another position of its result literal.
        # Keep that move for use-after-move checks, outside aggregate overlap.
        currentMove.awaited -> if { -1 } else {
            currentMove.valueIr -> aggregateForTransfer(ownedStorageByType!)
        } => currentAggregate
        -1 => previousAggregateMove!
        currentAggregate >= 0 -> if {
            aggregateHeads![currentAggregate] => previousAggregateMove!
        }
        aggregateNext! -> push(previousAggregateMove!)
        false => overlapFound!
        previousAggregateMove! >= 0 and not overlapFound!
            -> while {
                moves![previousAggregateMove!] => previousMove
                previousMove.sourceModule == currentMove.sourceModule
                    and previousMove.symbol == currentMove.symbol
                    and (previousMove.valueIr -> placesOverlap(currentMove.valueIr))
                    -> if { true => overlapFound! }
                aggregateNext![previousAggregateMove!] => previousAggregateMove!
            }
        overlapFound! -> if {
            typed -> placeProjectionRoot(currentMove.valueIr) => ownerIr
            false => duplicateOwner!
            classifiedDiagnostics! -> each previous {
                previous.expectedSymbol == currentAggregate
                    and typed[previous.actualSymbol].sourceModule == typed[ownerIr].sourceModule
                    and typed[previous.actualSymbol].symbol == typed[ownerIr].symbol
                    -> if { true => duplicateOwner! }
            }
            not duplicateOwner! -> if {
                typed[currentMove.valueIr] => value
                prepared.package.ranges[value.sourceModule] => range
                prepared.package.nodes[range.astStart + value.astNode] => valueAst
                classifiedDiagnostics! -> appendBodyDiagnostic(currentMove.siteIr, OwnershipDiagnostic {
                    code: aggregateTransferOverlapCode()
                    sourceModule: currentMove.sourceModule
                    functionSymbol: -1
                    expectedOrigin: -1
                    expectedModule: -1
                    expectedSymbol: currentAggregate
                    actualOrigin: currentMove.regionIr
                    actualModule: -1
                    actualSymbol: ownerIr
                    actualBuiltin: -1
                    readonlyReferencePath: -1
                    span: syntax.SourceSpan { fileId: value.sourceModule, start: valueAst.start, length: valueAst.length }
                })
            }
        }
        currentAggregate >= 0 -> if {
            aggregateMoveIndex! => aggregateHeads![currentAggregate]
        }
        aggregateMoveIndex! + 1 => aggregateMoveIndex!
    }
    diagnostics! -> each diagnostic {
        diagnostic.code => classifiedCode!
        diagnostic.expectedSymbol => classifiedExpected!
        diagnostic.actualSymbol => classifiedActual!
        (diagnostic.code == 17 or diagnostic.code == 24 or diagnostic.code == 38)
            and diagnostic.expectedSymbol >= 0 and diagnostic.actualSymbol >= 0
            -> if {
                0 => priorMoveIndex!
                priorMoveIndex! < (moves! -> len) and classifiedCode! != aggregateTransferOverlapCode()
                    -> while {
                        moves![priorMoveIndex!] => priorMove
                        priorMove.siteIr == diagnostic.expectedSymbol and not priorMove.awaited
                            -> if {
                                priorMove.valueIr -> aggregateForTransfer(ownedStorageByType!) => priorAggregate
                                priorAggregate >= 0 -> if {
                                    priorMoveIndex! + 1 => nextMoveIndex!
                                    nextMoveIndex! < (moves! -> len) and classifiedCode! != aggregateTransferOverlapCode()
                                        -> while {
                                            moves![nextMoveIndex!] => nextMove
                                            not nextMove.awaited
                                                and priorMove.sourceModule == nextMove.sourceModule
                                                and priorMove.symbol == nextMove.symbol
                                                and (diagnostic.actualSymbol -> nodeBelongsTo(nextMove.valueIr))
                                                and (nextMove.valueIr -> aggregateForTransfer(ownedStorageByType!)) == priorAggregate
                                                and (priorMove.valueIr -> placesOverlap(nextMove.valueIr))
                                                -> if {
                                                    aggregateTransferOverlapCode() => classifiedCode!
                                                    priorAggregate => classifiedExpected!
                                                    typed -> placeProjectionRoot(nextMove.valueIr) => classifiedActual!
                                                }
                                            nextMoveIndex! + 1 => nextMoveIndex!
                                        }
                                }
                            }
                        priorMoveIndex! + 1 => priorMoveIndex!
                    }
            }
        false => duplicateDiagnostic!
        classifiedCode! == aggregateTransferOverlapCode()
            -> if {
                classifiedDiagnostics! -> each previous {
                    previous.code == classifiedCode! and previous.expectedSymbol == classifiedExpected!
                        and previous.actualSymbol >= 0 and classifiedActual! >= 0
                        and typed[previous.actualSymbol].sourceModule == typed[classifiedActual!].sourceModule
                        and typed[previous.actualSymbol].symbol == typed[classifiedActual!].symbol
                        -> if { true => duplicateDiagnostic! }
                }
            }
        # Generic materializations retain one source identity for an invalid
        # direct deferred-Text binding. Publish that source diagnostic once.
        classifiedCode! == 35 and classifiedActual! >= 0 and classifiedActual! < (typed -> len)
            and typed[classifiedActual!].kind == 17
            -> if {
                typed[classifiedActual!] => consumer
                prepared.package.ranges[consumer.sourceModule] => range
                prepared.package.nodes[range.astStart + consumer.astNode] => storage
                storage.kind == 9 or storage.kind == 48 -> if {
                    classifiedDiagnostics! -> each previous {
                        previous.code == 35 and previous.sourceModule == diagnostic.sourceModule
                            and previous.span.start == diagnostic.span.start and previous.span.length == diagnostic.span.length
                            and previous.actualSymbol >= 0 and previous.actualSymbol < (typed -> len)
                            and typed[previous.actualSymbol].kind == 17
                            and typed[previous.actualSymbol].sourceModule == consumer.sourceModule
                            and typed[previous.actualSymbol].astNode == consumer.astNode
                            -> if { true => duplicateDiagnostic! }
                    }
                }
            }
        not duplicateDiagnostic! -> if {
            classifiedDiagnostics! -> push(OwnershipDiagnostic {
                code: classifiedCode!
                sourceModule: diagnostic.sourceModule
                functionSymbol: diagnostic.functionSymbol
                expectedOrigin: diagnostic.expectedOrigin
                expectedModule: diagnostic.expectedModule
                expectedSymbol: classifiedExpected!
                actualOrigin: diagnostic.actualOrigin
                actualModule: diagnostic.actualModule
                actualSymbol: classifiedActual!
                actualBuiltin: diagnostic.actualBuiltin
                readonlyReferencePath: diagnostic.readonlyReferencePath
                span: diagnostic.span
            })
        }
    }
    # Index actual name nodes by their source token. Preserve the canonical
    # symbol and containing literal, including distinct function instances.
    {Int: Int} => firstInterpolationNameByToken!
    [Int; ~] => nextInterpolationName!
    [Bool; ~] => consumedInterpolationBindingByNode!
    prepared.interpolations -> each node {
        nextInterpolationName! -> push(-1)
        consumedInterpolationBindingByNode! -> push(false)
    }
    prepared.interpolationRanges -> each range {
        prepared.package.ranges[range.sourceModule] => sourceRange
        range.nodeStart => nameIndex!
        nameIndex! < range.nodeStart + range.nodeCount
            -> while {
                prepared.interpolations[nameIndex!] => name
                name.kind == 1 and name.symbol >= 0 and name.sourceToken >= 0 and name.sourceToken < sourceRange.tokenCount
                    -> if {
                        sourceRange.tokenStart + name.sourceToken => token
                        firstInterpolationNameByToken! -> putIfAbsent(token, -1) => inserted
                        firstInterpolationNameByToken![token] => nextInterpolationName![nameIndex!]
                        nameIndex! => firstInterpolationNameByToken![token]
                    }
                nameIndex! + 1 => nameIndex!
            }
    }
    0 => literalIndex!
    literalIndex! < (typed -> len) -> while {
        typed[literalIndex!] => literal
        literal.kind == 2 and literal.sourceModule >= 0 and literal.payloadToken >= 0
            and activeBodies[literalIndex!]
            -> if {
                prepared.package.ranges[literal.sourceModule] => range
                literal.payloadToken < range.tokenCount -> if {
                    range.tokenStart + literal.payloadToken => token
                    firstInterpolationNameByToken! -> putIfAbsent(token, -1) => inserted
                    firstInterpolationNameByToken![token] => nameIndex!
                    nameIndex! >= 0 -> while {
                        typed -> interpolationBindingIr(prepared, literalIndex!, nameIndex!) => bindingIr
                        bindingIr >= 0 -> if {
                            0 => moveIndex!
                            moveIndex! < (moves! -> len) and not consumedInterpolationBindingByNode![nameIndex!]
                                -> while {
                                    moves![moveIndex!] => moved
                                    moved.bindingIr == bindingIr and moved.sourceModule == literal.sourceModule
                                        and moved.symbol == prepared.interpolations[nameIndex!].symbol
                                        and (moveIndex! -> wholeMoveInvalidatesRead(literalIndex!))
                                        -> if { true => consumedInterpolationBindingByNode![nameIndex!] }
                                    moveIndex! + 1 => moveIndex!
                                }
                        }
                        nextInterpolationName![nameIndex!] => nameIndex!
                    }
                }
            }
        literalIndex! + 1 => literalIndex!
    }
    OwnershipAnalysis { diagnostics: classifiedDiagnostics!, referencePaths: diagnosticReferencePaths!, consumedInterpolationBindingByNode: consumedInterpolationBindingByNode! }
}
