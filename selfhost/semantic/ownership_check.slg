}

# A binding read inherits the initializer's reference origins. Its IR parent
# remains the new binding, so ancestry alone cannot find calls in an alias's
# value. Follow the resolved binding identities, preserving the caller's
# binding for the independent last-use check.
readonlyReferenceCarrierValueIr typed: ref [typedIr.TypedIrNode; ~], valueIr: Int -> Int {
    valueIr => current!
    0 => depth!
    current! >= 0 and current! < (typed -> len) and depth! < (typed -> len)
        -> while {
            typed[current!] => value
            value.kind != 5 or value.operand0 < 0 or value.operand0 >= (typed -> len)
                -> if { current! -> return }
            typed[value.operand0] => binding
            binding.kind != 17 or binding.operand0 < 0
                -> if { current! -> return }
            binding.operand0 => current!
            depth! + 1 => depth!
        }
    current!
}

# Length only narrows candidates. Callers still compare complete root/name identity.
mutableBindingNameBucket prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], bindingIr: Int, rootKey: UInt64 -> UInt64 {
    UInt64(0) => length!
    typed[bindingIr] => binding
    binding.payloadToken >= 0 -> if {
        prepared.package.ranges[binding.sourceModule] => nameRange
        UInt64(prepared.package.tokens[nameRange.tokenStart + binding.payloadToken].span.length) => length!
    }
    rootKey * 1099511628211 + length!
}

