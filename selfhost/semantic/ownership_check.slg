readonlyReferencePathTouchesInterpolation prepared: ref semanticContext.SemanticSnapshot, sourceModule: Int, nodeIndex: Int, path: ref [ReadonlyReferencePathStep; ~] -> Bool {
    prepared.interpolations[nodeIndex] => name
    name.payloadStart + name.payloadLength => cursor!
    cursor! => memberEnd!
    nodeIndex => current!
    prepared.interpolations[current!].parent => parent!
