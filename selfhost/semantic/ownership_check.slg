parallelResultSourceTextSupported prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], resultTypeId: Int, fallible: Bool -> Bool {
    not (prepared -> semanticTypeContainsStorageKind(types, resultTypeId, 0, false, true))
        -> if { true -> return }
    not fallible or resultTypeId < 0 or resultTypeId >= (types -> len)
        -> if { false -> return }
    types[resultTypeId] => resultType
    resultType.kind != 7 or resultType.origin != 4 or resultType.symbol != 1
        or resultType.first < 0 or resultType.second < 0
        -> if { false -> return }
