                                                                expectedOrigin: -1
                                                                expectedModule: -1
                                                                expectedSymbol: roleIrIndex!
                                                                actualOrigin: ownedEscapeUse.typeOrigin
                                                                actualModule: ownedEscapeUse.typeModule
                                                                actualSymbol: ownedEscapeUseIndex!
                                                                actualBuiltin: ownedEscapeUse.typeSymbol
                                                                readonlyReferencePath: -1
