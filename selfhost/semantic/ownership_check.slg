struct DirectExitIndex {
    firstByParent: [Int; ~]
    nextExit: [Int; ~]
    allExits: [Int; ~]
}

struct OwnershipIrIndex {
    directExits: DirectExitIndex
    firstChild: [Int; ~]
    nextChild: [Int; ~]
}

indexDirectExits nodes: ref [typedIr.TypedIrNode; ~] -> DirectExitIndex {
    [Int; ~] => first!
    [Int; ~] => next!
    [Int; ~] => allExits!
    0 => ordinal!
    nodes -> each node {
        first! -> push(-1)
        next! -> push(-1)
        node.kind == 21 or node.kind == 23
            -> if { allExits! -> push(ordinal!) }
        ordinal! + 1 => ordinal!
    }
    first! -> push(-1)
    # Reverse insertion preserves ascending IR order, including equal offsets.
    (nodes -> len) - 1 => cursor!
    cursor! >= 0 -> while {
        nodes[cursor!] => node
        (node.kind == 21 or node.kind == 23)
            and node.parent >= -1 and node.parent < (nodes -> len)
            -> if {
                node.parent + 1 => bucket
                first![bucket] => next![cursor!]
                cursor! => first![bucket]
            }
        cursor! - 1 => cursor!
    }
    DirectExitIndex { firstByParent: first!, nextExit: next!, allExits: allExits! }
}

# These facts describe only immutable IR links, not reachability decisions.
# Keep original ascending node order and leave region/source/offset filters
# with their existing query so exits under unusual parents are not discarded.
indexOwnershipIr nodes: ref [typedIr.TypedIrNode; ~] -> OwnershipIrIndex {
    [Int; ~] => first!
    [Int; ~] => next!
    nodes -> each node {
        first! -> push(-1)
        next! -> push(-1)
    }
    (nodes -> len) - 1 => cursor!
    cursor! >= 0 -> while {
        nodes[cursor!].parent => parent
        parent >= 0 and parent < (nodes -> len) -> if {
            first![parent] => next![cursor!]
            cursor! => first![parent]
        }
        cursor! - 1 => cursor!
    }
    nodes -> indexDirectExits => exits
    OwnershipIrIndex { directExits: exits, firstChild: first!, nextChild: next! }
}

indexedDirectExitAfter nodes: ref [typedIr.TypedIrNode; ~], package: ref analysis.PackageAnalysis, index: ref DirectExitIndex, siteIndex: Int -> Int {
    -1 => firstExit!
    UIntSize(0) => firstExitStart!
    siteIndex >= 0 and siteIndex < (nodes -> len)
        -> unless { firstExit! -> return }
    nodes[siteIndex] => site
    site.sourceModule >= 0 and site.sourceModule < (package.ranges -> len)
        -> unless { firstExit! -> return }
    package.ranges[site.sourceModule] => range
    site.astNode >= 0 and site.astNode < range.astCount
        -> unless { firstExit! -> return }
    package.nodes[range.astStart + site.astNode].start => siteStart
    site.parent >= -1 and site.parent < (nodes -> len) => addressable
    # Unaddressable parents retain the original ordered scan.
    0 => cursor!
    addressable -> if { index.firstByParent[site.parent + 1] => cursor! }
    cursor! >= 0 and cursor! < (nodes -> len) -> while {
        nodes[cursor!] => candidate
        candidate.sourceModule == site.sourceModule and candidate.parent == site.parent
            and candidate.astNode >= 0 and candidate.astNode < range.astCount
            and (candidate.kind == 21 or candidate.kind == 23)
            -> if {
                package.nodes[range.astStart + candidate.astNode].start => exitStart
                exitStart > siteStart and (firstExit! < 0 or exitStart < firstExitStart!)
                    -> if {
                        cursor! => firstExit!
                        exitStart => firstExitStart!
                    }
            }
        addressable -> if { index.nextExit[cursor!] => cursor! } else { cursor! + 1 => cursor! }
    }
    firstExit!
}

# Body checks defer retained templates and inactive lexical declarations.
# Materialized instances are independent of the source activation graph.
public bodyDiagnosticActivity prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], activeSourceBodies: ref [Bool; ~], concreteFunctions: ref [Int; ~] -> [Bool; ~] {
    [Bool; ~] => activeFunctions!
    0 => functionIndex!
    functionIndex! < (typed -> len) -> while {
        typed[functionIndex!] => function
        true => active!
        function.kind == 0 -> if {
            (typed -> typedIr.functionSignatureContainsParameter(types, functionIndex!))
                or (function -> typedIr.functionDeclaresGenericParameters(prepared.package.ranges, prepared.package.symbols))
                -> if { false => active! } else {
                    function.sourceModule >= 0 and function.sourceModule < (prepared.package.ranges -> len)
                        -> if {
                            prepared.package.ranges[function.sourceModule] => range
                            function.astNode >= 0 and function.astNode < range.astCount
                                and range.astStart + function.astNode < (activeSourceBodies -> len)
                                -> if { activeSourceBodies[range.astStart + function.astNode] => active! }
                        }
                }
        }
        activeFunctions! -> push(active!)
        functionIndex! + 1 => functionIndex!
    }
    concreteFunctions -> each functionIr {
        functionIr >= 0 and functionIr < (typed -> len) and typed[functionIr].kind == 0
            and not (typed -> typedIr.functionSignatureContainsParameter(types, functionIr))
            -> if { true => activeFunctions![functionIr] }
    }
    [Bool; ~] => activeBodies!
    0 => nodeIndex!
    nodeIndex! < (typed -> len) -> while {
        typed -> borrowedTextFunctionIr(nodeIndex!) => functionIr
        true => active!
        functionIr >= 0 -> if { activeFunctions![functionIr] => active! }
        activeBodies! -> push(active!)
        nodeIndex! + 1 => nodeIndex!
    }
    activeBodies!
}

public aggregateTransferOverlapCode: -> Int { 47 }
public diagnosticTrackTaskArgumentCode: -> Int { 48 }
public taskOperationContractCode: -> Int { 51 }
public parallelSourceTextResultCode: -> Int { 52 }
public borrowedTextBlockEscapeCode: -> Int { 50 }

public struct ReadonlyReferencePathStep {
    # 0 named field, 1 canonical unlabeled product field,
    # 2 intrinsic enum payload (ordinal 0 Some, 1 Ok, 2 Err).
    public kind: Int
    public sourceModule: Int
    public nameToken: Int
    public ordinal: Int
}

public struct OwnershipDiagnostic {
    public code: Int
    public sourceModule: Int
    public functionSymbol: Int
    public expectedOrigin: Int
    public expectedModule: Int
    public expectedSymbol: Int
    public actualOrigin: Int
    public actualModule: Int
    public actualSymbol: Int
    public actualBuiltin: Int
    public readonlyReferencePath: Int
    public span: syntax.SourceSpan
}

# Keep diagnostics copyable. The analysis owns path storage and diagnostics
# refer to it by index; the production emitter carries both to the renderer.
public struct OwnershipAnalysis {
    public diagnostics: [OwnershipDiagnostic; ~]
    public referencePaths: [ReadonlyReferenceLoan; ~]
    public consumedInterpolationBindingByNode: [Bool; ~]
}

public struct EnumPayloadStoragePlace {
    public constructorIndex: Int
    public siteIr: Int
    public callNode: Int
    public argumentNode: Int
    public argumentAst: Int
    public bindingIr: Int
    public sourceModule: Int
    public regionIr: Int
    public fieldDepth: Int
}

public struct EnumPayloadStorageDiagnostic {
    public sourceModule: Int
    public argumentNode: Int
    public argumentAst: Int
    public bindingIr: Int
}

# Invalid constructor input is rejected before its enclosing result/storage.
# Preserve independent diagnostics and the chosen declaration-root identity.
public struct PrioritizedOwnershipDiagnostics {
    public diagnostics: [OwnershipDiagnostic; ~]
    public firstOwnedBindingDiagnostic: Int
}

public prioritizeEnumPayloadDiagnostics diagnostics: ref [OwnershipDiagnostic; ~], payloads: ref [EnumPayloadStorageDiagnostic; ~], nodes: ref [ast.AstNode; ~], ranges: ref [analysis.SourceAnalysisRange; ~], firstOwnedBindingDiagnostic: Int -> PrioritizedOwnershipDiagnostics {
    [OwnershipDiagnostic; ~] => selected!
    firstOwnedBindingDiagnostic => selectedRoot!
    0 => diagnosticIndex!
    diagnostics -> each diagnostic {
        false => consequence!
        diagnosticIndex! != firstOwnedBindingDiagnostic
            and (diagnostic.code == 25 or diagnostic.code == 26)
            and diagnostic.expectedSymbol >= 0
            -> if {
                payloads -> each payload {
                    payload.sourceModule == diagnostic.sourceModule
                        and payload.bindingIr == diagnostic.expectedSymbol
                        and payload.argumentAst >= 0
                        and payload.sourceModule >= 0 and payload.sourceModule < (ranges -> len)
                        -> if {
                            ranges[payload.sourceModule] => range
                            payload.argumentAst < range.astCount -> if {
                                nodes[range.astStart + payload.argumentAst] => argument
                                diagnostic.span.start <= argument.start
                                    and argument.start + argument.length <= diagnostic.span.start + diagnostic.span.length
                                    -> if { true => consequence! }
                            }
                        }
                }
            }
        not consequence! -> if {
            diagnosticIndex! == firstOwnedBindingDiagnostic
                -> if {
                    selected! -> len => selectedRoot!
                }
            selected! -> push(diagnostic)
        }
        diagnosticIndex! + 1 => diagnosticIndex!
    }
    PrioritizedOwnershipDiagnostics { diagnostics: selected!, firstOwnedBindingDiagnostic: selectedRoot! }
}

public placeProjectionRoot typed: ref [typedIr.TypedIrNode; ~], placeIr: Int -> Int {
    placeIr => root!
    0 => projectionDepth!
    root! >= 0
        and root! < (typed -> len)
        and projectionDepth! < (typed -> len)
        and (typed[root!].kind == 13 or typed[root!].kind == 15)
        -> while {
            typed[root!].operand0 => nextRoot
            nextRoot == root! -> if { -1 => root! } else { nextRoot => root! }
            projectionDepth! + 1 => projectionDepth!
        }
    projectionDepth! >= (typed -> len) -> if { -1 => root! }
    root!
}

resolvedFormalReadBinding typed: ref [typedIr.TypedIrNode; ~], readIr: Int -> Int {
    readIr < 0 or readIr >= (typed -> len) -> if { -1 -> return }
    typed[readIr] => read
    read.kind != 5 or read.operand0 >= 0 or read.symbol < 0
        -> if { -1 -> return }
    typed -> borrowedTextFunctionIr(readIr) => functionIr
    functionIr < 0 or functionIr >= (typed -> len) or typed[functionIr].kind != 0
        -> if { -1 -> return }
    typed[functionIr].operand1 => formalIr!
    formalIr! < 0 -> if { typed[functionIr].nextOperand => formalIr! }
    -1 => matched!
    0 => edges!
    formalIr! >= 0 and formalIr! < (typed -> len) and edges! < (typed -> len)
        -> while {
            typed[formalIr!] => formal
            formal.kind != 10 or formal.parent != functionIr
                -> if { -1 -> return }
            formal.sourceModule == read.sourceModule and formal.symbol == read.symbol
                -> if {
                    matched! >= 0 -> if { -1 -> return }
                    formalIr! => matched!
                }
            formalIr! == typed[functionIr].operand1 -> if {
                typed[functionIr].nextOperand => formalIr!
            } else { formal.nextOperand => formalIr! }
            edges! + 1 => edges!
        }
    formalIr! >= 0 -> if { -1 -> return }
    matched!
}
public resolvedPlaceRootBinding typed: ref [typedIr.TypedIrNode; ~], placeIr: Int -> Int {
    typed -> placeProjectionRoot(placeIr) => root
    root >= 0 and root < (typed -> len) and typed[root].kind == 5 and typed[root].operand0 >= 0
        -> if {
            typed[root].operand0
        } else {
            root >= 0
                and root < (typed -> len)
                and (typed[root].kind == 10 or typed[root].kind == 17 or typed[root].kind == 29)
                -> if { root } else { typed -> resolvedFormalReadBinding(root) }
        }
}
public resolvedPlaceProjectionDepth typed: ref [typedIr.TypedIrNode; ~], placeIr: Int -> Int {
    placeIr => projected!
    0 => depth!
    projected! >= 0
        and projected! < (typed -> len)
        and depth! < (typed -> len)
        and (typed[projected!].kind == 13 or typed[projected!].kind == 15)
        -> while {
            depth! + 1 => depth!
            typed[projected!].operand0 => nextProjection
            nextProjection == projected! -> if { -1 => projected! } else { nextProjection => projected! }
        }
    depth! >= (typed -> len) -> if { 0 => depth! }
    depth!
}

public enumPayloadStorageRequiresTransfer prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], payloadTypeId: Int -> Bool {
    (prepared -> semanticContext.typeContainsOwnedStorage(types, payloadTypeId))
        and not (prepared -> semanticContext.typeRequiresFixedStorageCopy(types, payloadTypeId))
}

public isConsumedBindingRead diagnostic: OwnershipDiagnostic, typed: ref [typedIr.TypedIrNode; ~] -> Bool {
    diagnostic.code == 24 and diagnostic.actualSymbol >= 0 and diagnostic.actualSymbol < (typed -> len)
        -> if {
            typed[diagnostic.actualSymbol] => read
            read.kind == 5 and read.payloadToken >= 0
        } else { false }
}

public isSupersededByBranchJoin diagnostic: OwnershipDiagnostic, diagnostics: ref [OwnershipDiagnostic; ~] -> Bool {
    false => superseded!
    diagnostic.code == 38 -> if {
        diagnostics -> each candidate {
            candidate.code == 20
                and candidate.sourceModule == diagnostic.sourceModule
                and candidate.expectedSymbol == diagnostic.expectedSymbol
                and candidate.expectedOrigin != diagnostic.actualOrigin
                -> if { true => superseded! }
        }
    }
    superseded!
}

public branchJoinDiagnosticsMatch left: OwnershipDiagnostic, right: OwnershipDiagnostic, typed: ref [typedIr.TypedIrNode; ~] -> Bool {
    left.expectedOrigin => leftJoin!
    right.expectedOrigin => rightJoin!
    leftJoin! >= 0 and leftJoin! < (typed -> len) and typed[leftJoin!].kind == 19
        -> if {
            typed[leftJoin!].parent => parent
            parent >= 0 and parent < (typed -> len) and typed[parent].kind == 18
                -> if { parent => leftJoin! }
        }
    rightJoin! >= 0 and rightJoin! < (typed -> len) and typed[rightJoin!].kind == 19
        -> if {
            typed[rightJoin!].parent => parent
            parent >= 0 and parent < (typed -> len) and typed[parent].kind == 18
                -> if { parent => rightJoin! }
        }
    left.code == 20 and right.code == 20
        and left.sourceModule == right.sourceModule
        and leftJoin! == rightJoin!
        and (left.actualOrigin >= 0 and left.actualOrigin == right.actualOrigin
        or left.actualOrigin < 0 and left.expectedSymbol == right.expectedSymbol)
}

public isDuplicateBranchJoinDiagnostic diagnosticIndex: Int, diagnostics: ref [OwnershipDiagnostic; ~], typed: ref [typedIr.TypedIrNode; ~] -> Bool {
    false => duplicate!
    diagnosticIndex >= 0 and diagnosticIndex < (diagnostics -> len)
        -> if {
            0 => earlierIndex!
            earlierIndex! < diagnosticIndex and not duplicate!
                -> while {
                    diagnostics[earlierIndex!] -> branchJoinDiagnosticsMatch(diagnostics[diagnosticIndex], typed)
                        -> if { true => duplicate! }
                    earlierIndex! + 1 => earlierIndex!
                }
        }
    duplicate!
}

public isBranchJoinSupersededByOverlap diagnostic: OwnershipDiagnostic, diagnostics: ref [OwnershipDiagnostic; ~], typed: ref [typedIr.TypedIrNode; ~] -> Bool {
    false => superseded!
    diagnostic.code == 20 -> if {
        diagnostics -> each candidate {
            diagnostic -> branchJoinDiagnosticsMatch(candidate, typed)
                -> if {
                    diagnostics -> each overlap {
                        overlap.code == 38
                            and overlap.sourceModule == candidate.sourceModule
                            and overlap.expectedSymbol == candidate.expectedSymbol
                            and overlap.actualOrigin == candidate.expectedOrigin
                            -> if { true => superseded! }
                    }
                }
        }
    }
    superseded!
}

public isBranchJoinSupersededByBorrowMutation diagnostic: OwnershipDiagnostic, diagnostics: ref [OwnershipDiagnostic; ~], typed: ref [typedIr.TypedIrNode; ~] -> Bool {
    diagnostic.code != 20 -> if { false -> return }
    typed -> resolvedPlaceRootBinding(diagnostic.actualSymbol) => ownerBinding
    ownerBinding < 0 -> if { false -> return }
    diagnostics -> each candidate {
        candidate.code == 21 and candidate.sourceModule == diagnostic.sourceModule
            and candidate.expectedSymbol == ownerBinding
            and candidate.span.start == diagnostic.span.start
            and candidate.span.length == diagnostic.span.length
            -> if { true -> return }
    }
    false
}

public isBlockingDiagnostic diagnosticIndex: Int, diagnostics: ref [OwnershipDiagnostic; ~], typed: ref [typedIr.TypedIrNode; ~] -> Bool {
    diagnostics[diagnosticIndex] => diagnostic
    (diagnostic -> isSupersededByBranchJoin(diagnostics))
        or (diagnosticIndex -> isDuplicateBranchJoinDiagnostic(diagnostics, typed))
        or (diagnostic -> isBranchJoinSupersededByOverlap(diagnostics, typed))
        or (diagnostic -> isBranchJoinSupersededByBorrowMutation(diagnostics, typed))
        -> if { false } else {
            diagnostic.code == 24 -> if { not (diagnostic -> isConsumedBindingRead(typed)) } else {
                (diagnostic.code >= 17 and diagnostic.code <= 28)
                    or (diagnostic.code >= 31 and diagnostic.code <= 40)
                    or diagnostic.code == 41 or diagnostic.code == 42
                    or diagnostic.code == aggregateTransferOverlapCode()
                    or diagnostic.code == diagnosticTrackTaskArgumentCode()
                    or diagnostic.code == taskOperationContractCode()
                    or diagnostic.code == parallelSourceTextResultCode()
                    or diagnostic.code == borrowedTextReturnEscapeCode()
                    or diagnostic.code == borrowedTextReturnInferenceCode()
                    or diagnostic.code == functionReturnCompatibilityCode()
                    or diagnostic.code == deferredFunctionReturnCode()
                    or diagnostic.code == localArraySliceReturnCode()
                    or diagnostic.code == borrowedTextBlockEscapeCode()
            }
        }
}

public consumedBindingReads diagnostics: ref [OwnershipDiagnostic; ~], typed: ref [typedIr.TypedIrNode; ~] -> [semanticDiagnostics.ConsumedBindingReadDiagnostic; ~] {
    [semanticDiagnostics.ConsumedBindingReadDiagnostic; ~] => reads!
    diagnostics -> each diagnostic {
        diagnostic -> isConsumedBindingRead(typed)
            -> if {
                typed[diagnostic.actualSymbol].astNode => readAst
                false => alreadyReported!
                # Alternative moves can explain the same later source read.
                # Publish one read fact, preserving distinct source identities.
                reads! -> each existingRead {
                    existingRead.sourceModule == diagnostic.sourceModule
                        and existingRead.astNode == readAst
                        -> if { true => alreadyReported! }
                }
                not alreadyReported! -> if {
                    reads! -> push(semanticDiagnostics.ConsumedBindingReadDiagnostic {
                        sourceModule: diagnostic.sourceModule
                        astNode: readAst
                        span: diagnostic.span
                    })
                }
            }
    }
    reads!
}

appendAwaitMoves prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], existing: ref [typedIr.MoveEvent; ~], awaited: ref [Bool; ~] -> [typedIr.MoveEvent; ~] {
    [typedIr.MoveEvent; ~] => moves!
    existing -> each event { moves! -> push(event) }
    0 => nodeIndex!
    nodeIndex! < (typed -> len) -> while {
        typed[nodeIndex!] => node
        node.kind == 5 and node.symbol >= 0
            and node.operand0 >= 0 and node.operand0 < (typed -> len)
            and (typed[node.operand0] -> typedIr.isTaskOwnerValue(typed, prepared))
            and node.sourceModule >= 0 and node.sourceModule < (prepared.package.ranges -> len)
            -> if {
                prepared.package.ranges[node.sourceModule] => range
                node.astNode >= 0 and node.astNode < range.astCount
                    and awaited[range.astStart + node.astNode]
                    -> if {
                        false => alreadyRecorded!
                        existing -> each event {
                            event.siteIr == nodeIndex! and event.awaited
                                -> if { true => alreadyRecorded! }
                        }
                        not alreadyRecorded! -> if {
                            nodeIndex! => bindingIr!
                            node.operand0 >= 0 and node.operand0 < (typed -> len)
                                -> if { node.operand0 => bindingIr! }
                            node.parent => region!
                            region! >= 0 and typed[region!].kind != 1 and typed[region!].kind != 11
                                and typed[region!].kind != 19 and typed[region!].kind != 20
                                -> while { typed[region!].parent => region! }
                            moves! -> push(typedIr.MoveEvent {
                                siteIr: nodeIndex!
                                valueIr: nodeIndex!
                                awaited: true
                                bindingIr: bindingIr!
                                sourceModule: node.sourceModule
                                symbol: node.symbol
                                regionIr: region!
                                memberIr: -1
                            })
                        }
                    }
            }
        nodeIndex! + 1 => nodeIndex!
    }
    moves!
}

# Deferred interpolation is a value representation, not an allocating Text.
# Consume canonical value edges after lowering, before any target emits LLVM.
# The caller seeds only Text constants identified by the interpolation parser.
# -1 no storage edge, -2 malformed dictionary edge; otherwise C# destination:
# 0 direct, 1 array, 2 struct, 3 product, 4 dictionary key, 5 dictionary value,
# 6 indexed element, 7 deque, 8 set. Preserve the consumer and destination once.
deferredTextStorageDestination parent: typedIr.TypedIrNode, valueIndex: Int, nodes: ref [typedIr.TypedIrNode; ~] -> Int {
    parent.kind == 17 and parent.opcode == -227
        -> if { -1 -> return }
    parent.kind == 17 and parent.operand0 == valueIndex
        -> if { 0 -> return }
    parent.kind == 25 and parent.operand0 == valueIndex
        -> if { 2 -> return }
    parent.kind == 24 -> if {
        parent.operand0 == valueIndex -> if { 6 -> return }
        parent.operand1 == valueIndex -> if { 4 -> return }
    }
    parent.kind == 12 -> if { 2 -> return }
    parent.kind == 14 -> if { 1 -> return }
    parent.kind == 35 -> if { 3 -> return }
    parent.kind == 16 -> if {
        parent.operand0 => item!
        0 => ordinal!
        item! >= 0 and item! < (nodes -> len) and ordinal! < (nodes -> len)
            -> while {
                item! == valueIndex -> if { (ordinal! % 2 == 0 -> if { 4 } else { 5 }) -> return }
                nodes[item!].nextOperand => item!
                ordinal! + 1 => ordinal!
            }
        -2 -> return
    }
    parent.kind != 6 and parent.kind != 9 -> if { -1 -> return }
    # Both statement and value-producing intrinsic forms share these opcodes.
    parent.operand1 == valueIndex -> if {
        parent.opcode == -204 -> if { 1 -> return }
        parent.opcode == -246 or parent.opcode == -247
            -> if { 7 -> return }
        parent.opcode == -255 -> if { 8 -> return }
    }
    parent.opcode == -223 or parent.opcode == -303
        -> if {
            parent.operand1 == valueIndex -> if { 4 -> return }
            parent.operand1 >= 0 and parent.operand1 < (nodes -> len)
                and nodes[parent.operand1].nextOperand == valueIndex
                -> if { 5 -> return }
        }
    -1
}

preservesDeferredText parent: typedIr.TypedIrNode, valueIndex: Int, nodes: ref [typedIr.TypedIrNode; ~] -> Bool {
    # Calls (including materialize and immediate sinks) end this representation.
    # A transparent flow wrapper and the selected result of a control do not.
    parent.kind == 9 and parent.opcode == -1 -> if { true -> return }
    parent.kind == 23 -> if { parent.operand0 == valueIndex -> return }
    parent.kind == 19 -> if {
        parent.operand1 == valueIndex or nodes[valueIndex].kind == 23 -> return
    }
    parent.kind == 18 or parent.kind == 27
        or parent.kind == 33 or parent.kind == 34
        -> if { nodes[valueIndex].kind == 19 -> return }
    false
}

deferredTextStringSeeds nodes: ref [typedIr.TypedIrNode; ~], tokenStarts: ref [Int; ~], tokenCounts: ref [Int; ~], interpolationModules: ref [Int; ~], interpolationTokens: ref [Int; ~] -> [Bool; ~] {
    0 => tokenCount!
    0 => moduleIndex!
    moduleIndex! < (tokenStarts -> len) -> while {
        tokenStarts[moduleIndex!] + tokenCounts[moduleIndex!] => end
        end > tokenCount! -> if { end => tokenCount! }
        moduleIndex! + 1 => moduleIndex!
    }
    [Bool; ~] => tokens!
    0 => tokenIndex!
    tokenIndex! < tokenCount! -> while {
        tokens! -> push(false)
        tokenIndex! + 1 => tokenIndex!
    }
    0 => interpolationIndex!
    interpolationIndex! < (interpolationModules -> len)
        -> while {
            interpolationModules[interpolationIndex!] => sourceModule
            interpolationTokens[interpolationIndex!] => sourceToken
            sourceModule >= 0 and sourceModule < (tokenStarts -> len)
                -> if {
                    sourceToken >= 0 and sourceToken < tokenCounts[sourceModule]
                        -> if { true => tokens![tokenStarts[sourceModule] + sourceToken] }
                }
            interpolationIndex! + 1 => interpolationIndex!
        }
    [Bool; ~] => result!
    nodes -> each node {
        false => deferred!
        node.kind == 2 and node.sourceModule >= 0
            and node.sourceModule < (tokenStarts -> len)
            -> if {
                node.payloadToken >= 0 and node.payloadToken < tokenCounts[node.sourceModule]
                    -> if { tokens![tokenStarts[node.sourceModule] + node.payloadToken] => deferred! }
            }
        result! -> push(deferred!)
    }
    result!
}

struct DeferredTextStorageFailure {
    origin: Int
    consumer: Int
    destination: Int
    value: Int
}

analyzeDeferredTextStorage nodes: ref [typedIr.TypedIrNode; ~], deferredStrings: ref [Bool; ~] -> [DeferredTextStorageFailure; ~] {
    nodes -> len => nodeCount
    [Int; ~] => origins!
    [Bool; ~] => reported!
    [DeferredTextStorageFailure; ~] => failures!
    0 => index!
    index! < nodeCount -> while {
        -1 => origin!
        nodes[index!].kind == 2 and deferredStrings[index!]
            -> if { index! => origin! }
        origins! -> push(origin!)
        reported! -> push(false)
        index! + 1 => index!
    }
    true => changed!
    changed! -> while {
        false => changed!
        0 => index!
        index! < nodeCount -> while {
            nodes[index!] => value
            value.operand0 >= 0 and origins![index!] < 0 -> if {
                value.kind == 5 or value.kind == 23
                    or (value.kind == 17 and value.opcode == -227)
                    -> if {
                        origins![value.operand0] >= 0 -> if {
                            origins![value.operand0] => origins![index!]
                            true => changed!
                        }
                    }
            }
            value.kind == 19 and value.operand1 >= 0
                and origins![index!] < 0
                -> if {
                    origins![value.operand1] >= 0 -> if {
                        origins![value.operand1] => origins![index!]
                        true => changed!
                    }
                }
            # Storage follows the binding's canonical initializer edge. A
            # lifted control may retain its transparent flow wrapper as parent
            # even after lowering selects that control as binding.operand0.
            value.kind == 17 and value.opcode != -227
                and value.operand0 >= 0 and value.operand0 < nodeCount
                and origins![value.operand0] >= 0 and not reported![index!]
                -> if {
                    failures! -> push(DeferredTextStorageFailure { origin: origins![value.operand0], consumer: index!, destination: 0, value: value.operand0 })
                    true => reported![index!]
                }
            origins![index!] >= 0 and value.parent >= 0 -> if {
                nodes[value.parent] => parent
                parent -> deferredTextStorageDestination(index!, nodes) => destination
                destination != -1 -> if {
                    not reported![value.parent] -> if {
                        failures! -> push(DeferredTextStorageFailure { origin: origins![index!], consumer: value.parent, destination: destination, value: index! })
                        true => reported![value.parent]
                    }
                } else {
                    (parent -> preservesDeferredText(index!, nodes))
                        and origins![value.parent] < 0
                        -> if {
                            origins![index!] => origins![value.parent]
                            true => changed!
                        }
                }
            }
            index! + 1 => index!
        }
    }
    failures!
}

# Lowering marks active producer and yielded callback scopes separately from
# preserved callback provenance and invocation arguments. Match the C# user
# block statement checker without extending it across an ordinary function.
deferredTextUserBlockStorage prepared: ref semanticContext.SemanticSnapshot, nodes: ref [typedIr.TypedIrNode; ~], consumer: Int -> Bool {
    nodes[consumer] => binding
    prepared.package.ranges[binding.sourceModule] => bindingRange
    # Inlining can attach a direct producer binding to the invocation itself.
    # Its preserved AST still identifies the declaration that owns the body.
    -1 => producerSymbol!
    binding.astNode => lexical!
    lexical! >= 0 -> while {
        prepared.package.nodes[bindingRange.astStart + lexical!] => lexicalNode
        lexicalNode.kind == 7 or lexicalNode.kind == 31
            -> if {
                0 => candidate!
                candidate! < bindingRange.symbolCount -> while {
                    prepared.package.symbols[bindingRange.symbolStart + candidate!] => declaration
                    (declaration.kind == 7 or declaration.kind == 31)
                        and declaration.astNode == lexical!
                        and declaration.blockTypeNode >= 0 and declaration.flags / 64 % 2 == 0
                        -> if { candidate! => producerSymbol! }
                    candidate! + 1 => candidate!
                }
                -1 => lexical!
            } else {
                lexicalNode.parent => lexical!
            }
    }
    nodes[consumer].parent => owner!
    owner! >= 0 -> while {
        nodes[owner!] => scope
        scope.kind == 19 and scope.opcode == -227 -> if {
            scope.symbol == -2 -> if { false -> return }
            scope.symbol == -3 or scope.symbol == -1 -> if { true -> return }
            producerSymbol! >= 0 and scope.targetModule == binding.sourceModule
                and scope.symbol == producerSymbol!
                -> if { true -> return }
        }
        scope.kind == 0 -> if {
            scope.targetModule < 0 or scope.symbol < 0 -> if { false -> return }
            prepared.package.ranges[scope.targetModule] => range
            prepared.package.symbols[range.symbolStart + scope.symbol] => declaration
            declaration.blockTypeNode >= 0 and declaration.flags / 64 % 2 == 0 -> return
        }
        scope.parent => owner!
    }
    false
}

public borrowedTextReturnEscapeCode: -> Int { 43 }
public borrowedTextReturnInferenceCode: -> Int { 44 }
public functionReturnCompatibilityCode: -> Int { 45 }
public deferredFunctionReturnCode: -> Int { 46 }
public localArraySliceReturnCode: -> Int { 49 }

struct BorrowedTextFunctionSelection {
    unique: Int
    last: Int
}

borrowedTextFunctionIdentity sourceModule: Int, symbol: Int -> UInt64 {
    sourceModule -> typedIr.sourceLocalIdentity(symbol)
}

borrowedTextFunctionsByIdentity typed: ref [typedIr.TypedIrNode; ~], candidates: ref [Int; ~] -> {UInt64: BorrowedTextFunctionSelection} {
    {UInt64: BorrowedTextFunctionSelection; 16~} => functions!
    candidates -> each functionIr {
        typed[functionIr] => function
        function.kind == 0 -> if {
            function.sourceModule -> borrowedTextFunctionIdentity(function.symbol) => identity
            functions! -> putIfAbsent(identity, BorrowedTextFunctionSelection { unique: functionIr, last: functionIr }) => inserted
            not inserted -> if {
                functions! -> put(identity, BorrowedTextFunctionSelection { unique: -2, last: functionIr })
            }
        }
    }
    # Include every exact queried identity, including intrinsic and malformed
    # signed coordinates, without changing their existing missing result.
    typed -> each node {
        node.targetModule -> borrowedTextFunctionIdentity(node.symbol) => identity
        functions! -> putIfAbsent(identity, BorrowedTextFunctionSelection { unique: -1, last: -1 }) => inserted
    }
    functions!
}

struct BorrowedTextCallFunctionIndex {
    genericSelectionByCall: [Int; ~]
    functionCandidates: [Int; ~]
    functionsByIdentity: {UInt64: BorrowedTextFunctionSelection}
    interpolationResultTypes: [Int; ~]
    interpolationFunctionTargets: [Int; ~]
    interpolationRootByToken: [Int; ~]
    interpolationNextRoot: [Int; ~]
    scalarVersionHeads: {Int: Int}
    scalarVersionNext: [Int; ~]
    irIndex: OwnershipIrIndex
}

struct BorrowedTextReturn {
    functionIr: Int
    sourceModule: Int
    functionSymbol: Int
    parameterOrdinal: Int
    transfersOwner: Bool
    concreteParameter: Bool
}

struct BorrowedTextOriginFact {
    # 0 unavailable, 1 proven empty, 2 inferred, 3 invalid IR identity.
    status: Int
    usesOrigin: Bool
    placeIr: Int
}

borrowedTextFunctionIr typed: ref [typedIr.TypedIrNode; ~], nodeIr: Int -> Int {
    nodeIr => owner!
    0 => edges!
    owner! >= 0 and owner! < (typed -> len) and edges! < (typed -> len)
        -> while {
            typed[owner!].kind == 0 -> if { owner! -> return }
            typed[owner!].parent => owner!
            edges! + 1 => edges!
        }
    owner! >= 0 -> if { -2 -> return }
    -1
}

borrowedTextParameterCarriesOrigin parameter: typedIr.TypedIrNode, prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], viewTypes: ref [Bool; ~] -> Bool {
    parameter.kind != 10 -> if { false -> return }
    parameter.typeOrigin == 1 and parameter.typeSymbol == 24
        -> if {
            parameter.flags == 0 -> return
        }
    parameter.typeOrigin == 1 and parameter.typeSymbol == 15
        -> if { true -> return }
    parameter.typeId < 0 or parameter.typeId >= (types -> len)
        -> if { false -> return }
    parameter.typeId < (viewTypes -> len) and viewTypes[parameter.typeId]
        -> if { true -> return }
    (types -> borrowedTextCanonicalByteArrayType(parameter.typeId))
        or (parameter.flags % 2 != 1 and (prepared -> semanticTypeContainsByteStorage(types, parameter.typeId)))
}

# Reuse the exact byte-array authority for both origin-bearing formals and
# concrete caller backing mapping; composite owned storage is outside this unit.
borrowedTextCanonicalByteArrayType types: ref [typeIds.SemanticType; ~], typeId: Int -> Bool {
    typeId < 0 or typeId >= (types -> len) -> if { false -> return }
    typeId => byteStorage!
    types[byteStorage!].kind == 8 -> if { types[byteStorage!].first => byteStorage! }
    byteStorage! >= 0 and byteStorage! < (types -> len) and types[byteStorage!].kind == 3
        -> if {
            types[byteStorage!].first => element
            element >= 0 and element < (types -> len) -> if {
                types[element] => byteType
                (byteType.kind == 1 and byteType.origin == 1 and byteType.symbol == 8) -> return
            }
        }
    false
}

# An implicit return's AST is the declared result type, not an evaluation site.
# Explicit return statements retain their existing source/evaluation boundary.
borrowedTextReturnQueryIr typed: ref [typedIr.TypedIrNode; ~], returnIr: Int -> Int {
    returnIr >= 0 and returnIr < (typed -> len) and typed[returnIr].kind == 1
        -> if { typed[returnIr].operand0 } else { returnIr }
}

borrowedTextSameResultType value: typedIr.TypedIrNode, owner: typedIr.TypedIrNode -> Bool {
    owner.typeId >= 0 -> if { value.typeId == owner.typeId -> return }
    (value.typeId < 0 and value.typeKind == owner.typeKind
        and value.typeOrigin == owner.typeOrigin and value.typeModule == owner.typeModule
        and value.typeSymbol == owner.typeSymbol)
}

borrowedTextRegionResultIr typed: ref [typedIr.TypedIrNode; ~], regionIr: Int -> Int {
    typed[regionIr] => region
    region.operand1 => result!
    result! >= 0 and result! < (typed -> len) and typed[result!].kind == 29
        -> if {
            # Expression-bodied enum arms store the payload binding in operand1,
            # not their result. Their final same-typed direct child is authoritative.
            -1 => result!
        }
    regionIr + 1 => child!
    result! >= 0 -> if { typed -> len => child! }
    child! < (typed -> len) and typed[child!].kind != 0
        -> while {
            typed[child!] => candidate
            candidate.parent == regionIr and child! != region.operand0
                and candidate.kind != 10 and candidate.kind != 17 and candidate.kind != 29
                and candidate.kind != 23 and (candidate -> borrowedTextSameResultType(region))
                -> if { child! => result! }
            child! + 1 => child!
        }
    # The producer may select a leaf under a nested control. The actual control
    # merge, never its condition or every statement, is the returned value.
    result! => ancestor!
    0 => edges!
    ancestor! >= 0 and ancestor! < (typed -> len) and ancestor! != regionIr and edges! < (typed -> len)
        -> while {
            typed[ancestor!] => parentValue
            (parentValue.kind == 18 or parentValue.kind == 27 or parentValue.kind == 33 or parentValue.kind == 34)
                and (parentValue -> borrowedTextSameResultType(region))
                -> if { ancestor! => result! }
            parentValue.parent => ancestor!
            edges! + 1 => edges!
        }
    ancestor! >= 0 and ancestor! != regionIr -> if { -2 -> return }
    result!
}

mergeBorrowedTextOrigin left: BorrowedTextOriginFact, right: BorrowedTextOriginFact, typed: ref [typedIr.TypedIrNode; ~] -> BorrowedTextOriginFact {
    # Failed inference may be omitted by C#'s partial union. Malformed IR is a
    # different invariant failure and cannot disappear beside an inferred row.
    left.status == 3 or right.status == 3 -> if {
        BorrowedTextOriginFact { status: 3, usesOrigin: false, placeIr: -1 } -> return
    }
    left.status == 2 or right.status == 2 -> if {
        BorrowedTextOriginFact { status: 2, usesOrigin: left.usesOrigin or right.usesOrigin, placeIr: left.placeIr } => joined!
        right.usesOrigin -> if {
            left.usesOrigin and (left.placeIr < 0 or right.placeIr < 0
                or (left.placeIr != right.placeIr and not (typed -> resolvedSameOwnedFieldPlace(left.placeIr, right.placeIr))))
                -> if { -1 => joined!.placeIr } else { right.placeIr => joined!.placeIr }
        }
        joined! -> return
    }
    left.status == 1 and right.status == 1 -> if {
        BorrowedTextOriginFact { status: 1, usesOrigin: false, placeIr: -1 } -> return
    }
    BorrowedTextOriginFact { status: 0, usesOrigin: false, placeIr: -1 }
}

# The same result identities used by ordinary lowering supply return checking.
# This is deliberately narrower than functionArgumentCompatible: a reference
# return additionally requires a reference-bearing lexical place root.
public functionBodyReturnType types: ref [typeIds.SemanticType; ~], declaredType: Int, declarationFlags: Int -> Int {
    # Stream IR retains its element type; the synchronous producer body returns Unit.
    declarationFlags / 64 % 2 == 1 -> if { types -> typeIds.builtinTypeId(0) -> return }
    declaredType
}

functionReturnCompatible prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], expectedType: Int, valueIr: Int, allPathsReturn: Bool -> Int {
    expectedType < 0 or expectedType >= (types -> len)
        -> if { 0 -> return }
    types[expectedType] => expected
    expected.status != 0 or expected.containsParameter
        -> if { 0 -> return }
    valueIr < 0 -> if {
        expected.kind == 1 and expected.origin == 1 and expected.symbol == 0
            -> if { 1 -> return }
        2 -> return
    }
    valueIr >= (typed -> len) -> if { 0 -> return }
    typed[valueIr] => value
    value.typeId < 0 or value.typeId >= (types -> len)
        -> if { 0 -> return }
    types[value.typeId] => actual
    actual.status != 0 or actual.containsParameter
        -> if { 0 -> return }
    # Type equality after contextual lowering does not grant static lifetime.
    expected.kind == 2 and (actual.kind == 3 or actual.kind == 4 or actual.kind == 12 or (actual.kind == 2 and value.kind == 14))
        and actual.first == expected.first -> if {
            prepared.package.ranges[value.sourceModule] => range
            value.astNode < 0 or value.astNode >= range.astCount
                -> if { 3 -> return }
            types[expected.first] => element
            element.symbol -> typeIds.canonicalBuiltinSymbol => builtin
            element.kind != 1 or element.origin != 1
                or not (builtin == 2 or builtin == 3 or builtin == 4 or builtin == 6 or (builtin >= 8 and builtin <= 14))
                -> if { 3 -> return }
            not typeIds.staticReadonlyArrayLiteral(prepared.package.tokens, range.tokenStart, prepared.package.nodes[range.astStart + value.astNode])
                -> if { 3 -> return }
            1 -> return
        }
    value.typeId == expectedType -> if { 1 -> return }
    actual.kind == 1 and actual.origin == 1 and expected.kind == 1 and expected.origin == 1
        and (actual.symbol -> typeIds.canonicalBuiltinSymbol) == (expected.symbol -> typeIds.canonicalBuiltinSymbol)
        -> if { 1 -> return }
    actual.kind == 1 and actual.origin == 1 and actual.symbol == 0 and allPathsReturn
        -> if { 1 -> return }
    expected.kind == 2 and (actual.kind == 2 or actual.kind == 3 or actual.kind == 4 or actual.kind == 12)
        and actual.first == expected.first -> if { 1 -> return }
    value.kind == 5 and actual.kind == 8 and actual.first == expectedType
        -> if {
            typed -> resolvedPlaceRootBinding(valueIr) => definitionIr
            definitionIr >= 0 and definitionIr < (typed -> len)
                and typed[definitionIr].typeId == value.typeId
                -> if { 1 -> return }
        }
    expected.kind != 8 or expected.first != value.typeId
        -> if { 2 -> return }
    valueIr => root!
    0 => edges!
    root! >= 0 and root! < (typed -> len) and edges! < (typed -> len)
        -> while {
            typed[root!] => place
            place.kind == 13 or place.kind == 15 -> if {
                place.operand0 => root!
            } else {
                place.kind != 5 -> if { 2 -> return }
                typed -> resolvedPlaceRootBinding(root!) => definitionIr
                definitionIr >= 0 and definitionIr < (typed -> len)
                    -> if {
                        typed[definitionIr] => definition
                        definition.typeId >= 0 and definition.typeId < (types -> len) and types[definition.typeId].kind == 8
                            -> if { 1 -> return }
                    }
                2 -> return
            }
            edges! + 1 => edges!
        }
    0
}

# Children precede the parent decision in reverse IR order. Only statement
# regions propagate unconditional exits; callback call nodes remain continuing,
# matching FunctionControlFlowFacts' block-invocation boundary.
functionReturnContinuation typed: ref [typedIr.TypedIrNode; ~] -> [Bool; ~] {
    [Bool; ~] => continuing!
    typed -> each node { continuing! -> push(true) }
    typed -> len => cursor!
    cursor! > 0 -> while {
        cursor! - 1 => cursor!
        typed[cursor!] => node
        node.kind == 23 -> if { false => continuing![cursor!] }
        node.kind == 19 and node.operand1 >= 0 and node.operand1 < (typed -> len)
            and not continuing![node.operand1]
            -> if { false => continuing![cursor!] }
        (node -> typedIr.isTransparentControlProducerWrapper)
            and node.operand0 < (typed -> len) and node.operand1 < (typed -> len)
            and not continuing![node.operand1]
            -> if { false => continuing![cursor!] }
        node.kind == 18 and node.operand1 >= 0 and node.operand1 < (typed -> len)
            and node.nextOperand >= 0 and node.nextOperand < (typed -> len)
            -> if {
                continuing![node.operand1] or continuing![node.nextOperand] => continuing![cursor!]
            }
        node.kind == 27 or node.kind == 33 or node.kind == 34
            -> if {
                node.operand0 => arm!
                node.kind == 27 or node.kind == 34 -> if { node.operand1 => arm! }
                false => hasArm!
                false => anyContinuing!
                0 => armEdges!
                arm! >= 0 and arm! < (typed -> len) and armEdges! < (typed -> len)
                    -> while {
                        typed[arm!].parent != cursor! -> if { true => anyContinuing!
                            -1 => arm! } else {
                            true => hasArm!
                            continuing![arm!] -> if { true => anyContinuing! }
                            typed[arm!].nextOperand => arm!
                        }
                        armEdges! + 1 => armEdges!
                    }
                hasArm! or node.kind == 27 -> if { anyContinuing! => continuing![cursor!] }
            }
        node.kind == 17 and node.operand0 >= 0 and node.operand0 < (typed -> len)
            -> if { continuing![node.operand0] => continuing![cursor!] }
        node.kind == 24 and node.operand0 >= 0 and node.operand0 < (typed -> len)
            and node.operand1 >= 0 and node.operand1 < (typed -> len)
            -> if {
                continuing![node.operand0] and continuing![node.operand1] => continuing![cursor!]
            }
        node.kind == 25 and node.operand0 >= 0 and node.operand0 < (typed -> len)
            -> if { continuing![node.operand0] => continuing![cursor!] }
        not continuing![cursor!] and node.parent >= 0 and node.parent < (typed -> len)
            and (typed[node.parent].kind == 19 or typed[node.parent].kind == 1)
            -> if { false => continuing![node.parent] }
    }
    continuing!
}

functionDeferredResults typed: ref [typedIr.TypedIrNode; ~], seeds: ref [Bool; ~] -> [Bool; ~] {
    [Bool; ~] => deferred!
    typed -> each node { deferred! -> push(false) }
    typed -> len => cursor!
    cursor! > 0 -> while {
        cursor! - 1 => cursor!
        typed[cursor!] => node
        node.kind == 2 and cursor! < (seeds -> len) -> if { seeds[cursor!] => deferred![cursor!] }
        node.kind == 18 -> if {
            node.operand1 >= 0 and node.operand1 < (typed -> len)
                -> if { deferred![node.operand1] => deferred![cursor!] }
            node.nextOperand >= 0 and node.nextOperand < (typed -> len) and deferred![node.nextOperand]
                -> if { true => deferred![cursor!] }
        }
        node.kind == 19 -> if {
            typed -> borrowedTextRegionResultIr(cursor!) => result
            result >= 0 and result < (typed -> len) and deferred![result]
                -> if { true => deferred![cursor!] }
        }
        node.kind == 27 or node.kind == 33 or node.kind == 34
            -> if {
                node.operand0 => arm!
                node.kind == 27 or node.kind == 34 -> if { node.operand1 => arm! }
                0 => edges!
                arm! >= 0 and arm! < (typed -> len) and edges! < (typed -> len)
                    -> while {
                        typed[arm!].parent == cursor! and deferred![arm!]
                            -> if { true => deferred![cursor!] }
                        typed[arm!].nextOperand => arm!
                        edges! + 1 => edges!
                    }
            }
        node.kind == 9 and node.opcode == -1 -> if {
            node.operand0 => result!
            node.operand1 >= 0 -> if { node.operand1 => result! }
            result! >= 0 and result! < (typed -> len) -> if { deferred![result!] => deferred![cursor!] }
        }
        (node.kind == 1 or node.kind == 23) and node.operand0 >= 0 and node.operand0 < (typed -> len)
            and deferred![node.operand0] -> if { true => deferred![cursor!] }
        node.kind == 23 and deferred![cursor!] and node.parent >= 0 and node.parent < (typed -> len)
            and (typed[node.parent].kind == 19 or typed[node.parent].kind == 1)
            -> if { true => deferred![node.parent] }
        # Calls, including materialize, intentionally do not propagate seeds.
    }
    deferred!
}

appendFunctionReturnDiagnostics prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], continuing: ref [Bool; ~], deferred: ref [Bool; ~], activeBodies: ref [Bool; ~], diagnostics: mut [OwnershipDiagnostic; ~] -> Unit {
    0 => cursor!
    cursor! < (typed -> len) -> while {
        typed[cursor!] => node
        node.kind == 0 or node.kind == 23 -> if {
            cursor! => functionIr!
            node.kind == 23 -> if { typed -> borrowedTextFunctionIr(cursor!) => functionIr! }
            functionIr! >= 0 and functionIr! < (typed -> len)
                -> if {
                    typed[functionIr!] => function
                    # Intrinsic and external signatures have no source body.
                    # Validate callers normally, but do not index a declaration
                    # or infer a return value for their synthetic IR module.
                    function.flags / 128 % 2 == 1 -> if {
                        cursor! + 1 => cursor!
                        continue
                    }
                    prepared.package.ranges[function.sourceModule] => range
                    prepared.package.symbols[range.symbolStart + function.symbol] => declaration
                    # Generated COM members have signatures, but no source body.
                    function.flags / 128 % 2 == 0 and declaration.kind != 36
                        and activeBodies[functionIr!]
                        -> if {
                            node.operand0 => value!
                            true => reaches!
                            node.kind == 0 -> if {
                                value! >= 0 and value! < (typed -> len) and typed[value!].kind == 1
                                    -> if {
                                        continuing[value!] => reaches!
                                        typed[value!].operand0 => value!
                                    } else { -1 => value! }
                            }
                            reaches! -> if {
                                false => allPathsReturn!
                                value! >= 0 and value! < (typed -> len) -> if { not continuing[value!] => allPathsReturn! }
                                types -> functionBodyReturnType(function.typeId, declaration.flags) => expectedBodyType
                                prepared -> functionReturnCompatible(typed, types, expectedBodyType, value!, allPathsReturn!) => compatible
                                prepared.package.tokens[range.tokenStart + declaration.nameToken].span => location!
                                node.kind == 23 and node.astNode >= 0 and node.astNode < range.astCount
                                    -> if {
                                        prepared.package.nodes[range.astStart + node.astNode] => returnAst
                                        prepared.package.tokens[range.tokenStart + returnAst.payloadToken].span => returnSite
                                        syntax.SourceSpan { fileId: node.sourceModule, start: returnSite.start, length: returnSite.length } => location!
                                    }
                                compatible == 2 -> if {
                                    diagnostics -> push(OwnershipDiagnostic {
                                        code: functionReturnCompatibilityCode(), sourceModule: function.sourceModule, functionSymbol: function.symbol,
                                        expectedOrigin: -1, expectedModule: -1, expectedSymbol: functionIr!,
                                        actualOrigin: node.kind, actualModule: -1, actualSymbol: value!, actualBuiltin: -1, readonlyReferencePath: -1, span: location!
                                    })
                                }
                                compatible == 3 and value! >= 0 and typed[value!].astNode >= 0
                                    -> if {
                                        prepared.package.nodes[range.astStart + typed[value!].astNode] => valueAst
                                        diagnostics -> push(OwnershipDiagnostic {
                                            code: localArraySliceReturnCode(), sourceModule: function.sourceModule, functionSymbol: function.symbol,
                                            expectedOrigin: -1, expectedModule: -1, expectedSymbol: functionIr!,
                                            actualOrigin: node.kind, actualModule: -1, actualSymbol: value!, actualBuiltin: -1,
                                            readonlyReferencePath: -1, span: syntax.SourceSpan { fileId: function.sourceModule, start: valueAst.start, length: valueAst.length }
                                        })
                                    }

                            }
                            node.kind == 0 and function.typeOrigin == 1 and function.typeSymbol == 1
                                and value! >= 0 and value! < (deferred -> len) and deferred[value!]
                                -> if {
                                    typed[value!] => body
                                    true => hasBodyValue!
                                    body.kind == 19 -> if {
                                        body.operand1 < 0 -> if { false => hasBodyValue! } else {
                                            body.operand1 < (typed -> len) and typed[body.operand1].kind == 23
                                                -> if { false => hasBodyValue! }
                                        }
                                    }
                                    prepared.package.ranges[function.sourceModule] => deferredRange
                                    hasBodyValue! and body.astNode >= 0 and body.astNode < deferredRange.astCount
                                        -> if {
                                            prepared.package.nodes[deferredRange.astStart + body.astNode] => bodyAst
                                            diagnostics -> push(OwnershipDiagnostic {
                                                code: deferredFunctionReturnCode(), sourceModule: function.sourceModule, functionSymbol: function.symbol,
                                                expectedOrigin: -1, expectedModule: -1, expectedSymbol: functionIr!,
                                                actualOrigin: -1, actualModule: -1, actualSymbol: value!, actualBuiltin: -1,
                                                readonlyReferencePath: -1, span: syntax.SourceSpan { fileId: function.sourceModule, start: bodyAst.start, length: bodyAst.length }
                                            })
                                        }
                                }
                        }
                }
        }
        cursor! + 1 => cursor!
    }
}

borrowedTextSelectedCallFunctionIr typed: ref [typedIr.TypedIrNode; ~], contracts: ref [BorrowedTextReturn; ~], callFunctionIndex: ref BorrowedTextCallFunctionIndex, callIr: Int -> Int {
    callIr < 0 or callIr >= (typed -> len) -> if { -2 -> return }
    callIr < (callFunctionIndex.genericSelectionByCall -> len)
        -> if {
            callFunctionIndex.genericSelectionByCall[callIr] => selected
            selected >= 0 -> if {
                selected >= (typed -> len) or typed[selected].kind != 0
                    -> if { -2 -> return }
                typed[selected].sourceModule != typed[callIr].targetModule or typed[selected].symbol != typed[callIr].symbol
                    -> if { -2 -> return }
                selected -> return
            }
        }
    typed[callIr] => call
    -1 => selected!
    contracts -> each contract {
        contract.sourceModule == call.targetModule and contract.functionSymbol == call.symbol
            -> if {
                selected! >= 0 and selected! != contract.functionIr
                    -> if { -1 -> return }
                contract.functionIr => selected!
            }
    }
    selected! >= 0 -> if { selected! -> return }
    call.targetModule -> borrowedTextFunctionIdentity(call.symbol) => identity
    callFunctionIndex.functionsByIdentity[identity].unique
}

borrowedTextNodeBelongsTo typed: ref [typedIr.TypedIrNode; ~], nodeIndex: Int, ancestorIndex: Int -> Bool {
    nodeIndex => ancestor!
    false => belongs!
    ancestor! >= 0 and ancestor! < (typed -> len) and not belongs!
        -> while {
            ancestor! == ancestorIndex -> if {
                true => belongs!
            } else {
                typed[ancestor!].parent => ancestor!
            }
        }
    belongs!
}

borrowedTextCanonicalArrayStoreSites typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], viewTypes: ref [Bool; ~] -> [Int; ~] {
    [Int; ~] => sites!
    0 => siteIr!
    siteIr! < (typed -> len) -> while {
        typed[siteIr!] => site
        # sealLateGrowablePushCollisions publishes this exact selected intrinsic.
        # An ordinary same-spelled method retains its call target and is excluded.
        site.kind == 9 and site.opcode == -204 and site.targetModule == -1 and site.symbol == -1
            and site.operand0 >= 0 and site.operand0 < (typed -> len)
            and site.operand1 >= 0 and site.operand1 < (typed -> len)
            and typed[site.operand0].typeId >= 0 and typed[site.operand0].typeId < (types -> len)
            -> if {
                types -> typeIds.materializedReadTypeId(typed[site.operand0].typeId) => arrayType
                arrayType >= 0 and arrayType < (types -> len) and types[arrayType].kind == 3
                    and types[arrayType].first >= 0 and types[arrayType].first < (viewTypes -> len)
                    and viewTypes[types[arrayType].first]
                    -> if { sites! -> push(siteIr!) }
            }
        siteIr! + 1 => siteIr!
    }
    sites!
}

borrowedTextRepeatedControl node: typedIr.TypedIrNode -> Bool {
    node.kind == 20 or (node.kind == 6 and node.opcode == -208)
}

borrowedTextClosestLoop typed: ref [typedIr.TypedIrNode; ~], nodeIr: Int -> Int {
    nodeIr => cursor!
    0 => count!
    cursor! >= 0 and cursor! < (typed -> len) and count! < (typed -> len)
        -> while {
            typed[cursor!] -> borrowedTextRepeatedControl
                -> if { cursor! -> return }
            typed[cursor!].kind == 0 or typed[cursor!].kind == 11
                -> if { -1 -> return }
            typed[cursor!].parent => cursor!
            count! + 1 => count!
        }
    -1
}

borrowedTextCommonLoop typed: ref [typedIr.TypedIrNode; ~], storeIr: Int, queryIr: Int -> Int {
    typed -> borrowedTextClosestLoop(storeIr) => loop!
    loop! >= 0 -> while {
        typed -> borrowedTextNodeBelongsTo(queryIr, loop!)
            -> if { loop! -> return }
        typed -> borrowedTextClosestLoop(typed[loop!].parent) => loop!
    }
    -1
}

# The commit has happened before this continuation. Ascend every enclosing
# region, not only the nearest one. Completed exit targets remain authoritative.
borrowedTextCommitContinuation typed: ref [typedIr.TypedIrNode; ~], returnControls: ref [Bool; ~], storeIr: Int, queryIr: Int, backedgeLoop: Int -> Bool {
    storeIr => current!
    0 => ascents!
    current! >= 0 and current! < (typed -> len) and ascents! < (typed -> len)
        -> while {
            current! == backedgeLoop -> if { true -> return }
            typed[current!].parent => region!
            region! >= 0 and region! < (typed -> len)
                and typed[region!].kind != 19 and typed[region!].kind != 20
                and typed[region!].kind != 0 and typed[region!].kind != 11
                and region! != backedgeLoop
                -> while {
                    region! => current!
                    typed[region!].parent => region!
                }
            region! < 0 or region! >= (typed -> len) -> if { true -> return }
            typed[current!].nextOperand => next!
            false => jumped!
            0 => following!
            next! >= 0 and next! < (typed -> len) and not jumped! and following! < (typed -> len)
                -> while {
                    backedgeLoop < 0 and (typed -> borrowedTextNodeBelongsTo(queryIr, next!))
                        -> if { true -> return }
                    next! < (returnControls -> len) and returnControls[next!]
                        -> if { false -> return }
                    typed[next!].kind == 22 -> if {
                        # True follows the exact normalized exit target. False still
                        # falls through this same suffix. Either reachable path suffices.
                        typed[next!].operand0 => guardedTarget
                        typed[next!].opcode == 1 and guardedTarget == backedgeLoop
                            -> if { true -> return }
                        guardedTarget >= 0 and guardedTarget < (typed -> len)
                            and ((backedgeLoop >= 0 and guardedTarget != backedgeLoop)
                            or (backedgeLoop < 0 and not (typed -> borrowedTextNodeBelongsTo(queryIr, guardedTarget))))
                            -> if {
                                typed -> borrowedTextCommitContinuation(returnControls, guardedTarget, queryIr, backedgeLoop)
                                    -> if { true -> return }
                            }
                    }
                    typed[next!].kind == 21 -> if {
                        typed[next!].operand0 => targetLoop
                        typed[next!].opcode == 0 and targetLoop == backedgeLoop
                            -> if { false -> return }
                        typed[next!].opcode == 1 and targetLoop == backedgeLoop
                            -> if { true -> return }
                        backedgeLoop < 0 and targetLoop >= 0 and (typed -> borrowedTextNodeBelongsTo(queryIr, targetLoop))
                            -> if { false -> return }
                        targetLoop >= 0 and targetLoop < (typed -> len)
                            -> if {
                                targetLoop => current!
                                true => jumped!
                            }
                    }
                    not jumped! -> if { typed[next!].nextOperand => next! }
                    following! + 1 => following!
                }
            not jumped! -> if {
                region! == backedgeLoop -> if { true -> return }
                typed[region!].kind == 0 or typed[region!].kind == 11
                    -> if { (backedgeLoop < 0) -> return }
                region! => current!
            }
            ascents! + 1 => ascents!
        }
    # Malformed or unsupported continuation has no proof of exclusion.
    true
}

borrowedTextBindingStartedBeforeSite prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], callFunctionIndex: ref BorrowedTextCallFunctionIndex, returnControls: ref [Bool; ~], bindingIr: Int, siteIr: Int -> Bool {
    bindingIr >= 0 and bindingIr < (typed -> len) and siteIr >= 0 and siteIr < (typed -> len)
        -> unless { false -> return }
    typed[bindingIr] => binding
    typed[siteIr] => site
    binding.sourceModule == site.sourceModule
        and site.sourceModule >= 0 and site.sourceModule < (prepared.package.ranges -> len)
        -> unless { false -> return }
    prepared.package.ranges[site.sourceModule] => range
    binding.astNode >= 0 and binding.astNode < range.astCount
        and site.astNode >= 0 and site.astNode < range.astCount
        -> unless { false -> return }
    prepared.package.nodes[range.astStart + binding.astNode] => bindingAst
    prepared.package.nodes[range.astStart + site.astNode] => siteAst
    # Binding shells precede statement expression children in Typed IR.
    # A fresh loan starts after its complete initializer, never inside it.
    # A later SSA version
    # of an existing mutable Text slot may carry a previous-iteration loan.
    bindingAst.start + bindingAst.length <= siteAst.start
        or (prepared -> borrowedTextScalarVersionVisible(typed, types, callFunctionIndex, returnControls, bindingIr, siteIr))
}

# A closest loop may break while its containing loop still continues.
# Preserve every possible enclosing backedge for a carrier declared outside it.
borrowedTextReachableBackedge typed: ref [typedIr.TypedIrNode; ~], returnControls: ref [Bool; ~], siteIr: Int, queryIr: Int, bindingIr: Int -> Bool {
    typed -> borrowedTextCommonLoop(siteIr, queryIr) => commonLoop!
    commonLoop! >= 0 -> while {
        bindingIr >= 0 and not (typed -> borrowedTextNodeBelongsTo(bindingIr, commonLoop!))
            and (typed -> borrowedTextCommitContinuation(returnControls, siteIr, queryIr, commonLoop!))
            -> if { true -> return }
        typed -> borrowedTextClosestLoop(typed[commonLoop!].parent) => commonLoop!
    }
    false
}

borrowedTextStoreVisible prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], returnControls: ref [Bool; ~], storeIr: Int, queryIr: Int, exits: ref DirectExitIndex -> Bool {
    storeIr >= 0 and storeIr < (typed -> len) and queryIr >= 0 and queryIr < (typed -> len)
        -> unless { true -> return }
    typed[storeIr].sourceModule == typed[queryIr].sourceModule
        and (typed -> borrowedTextFunctionIr(storeIr)) == (typed -> borrowedTextFunctionIr(queryIr))
        -> unless { false -> return }
    typed -> resolvedPlaceRootBinding(typed[storeIr].operand0) => receiverBinding
    typed -> borrowedTextReachableBackedge(returnControls, storeIr, queryIr, receiverBinding)
        -> if { true -> return }
    # The current store cannot exist while evaluating its receiver/arguments.
    typed -> borrowedTextNodeBelongsTo(queryIr, storeIr)
        -> if { false -> return }
    typed[storeIr].sourceModule => sourceModule
    sourceModule >= 0 and sourceModule < (prepared.package.ranges -> len)
        -> unless { true -> return }
    prepared.package.ranges[sourceModule] => range
    typed[storeIr].astNode >= 0 and typed[storeIr].astNode < range.astCount
        and typed[queryIr].astNode >= 0 and typed[queryIr].astNode < range.astCount
        -> unless { true -> return }
    prepared.package.nodes[range.astStart + typed[storeIr].astNode].start => storeStart
    prepared.package.nodes[range.astStart + typed[queryIr].astNode].start => queryStart
    storeStart < queryStart -> unless { false -> return }
    # Reuse same-iteration sibling exclusion. Prior iterations were handled above.
    prepared -> referenceForwardUseReachable(typed, storeIr, queryIr, exits)
        -> if { typed -> borrowedTextCommitContinuation(returnControls, storeIr, queryIr, -1) -> return }
    # A break exits a loop without destroying its stored payload after the loop.
    typed -> borrowedTextClosestLoop(storeIr) => storeLoop
    storeLoop >= 0 and not (typed -> borrowedTextNodeBelongsTo(queryIr, storeLoop))
        -> if { typed -> borrowedTextCommitContinuation(returnControls, storeIr, queryIr, -1) -> return }
    false
}

# Mutable scalar versions share a canonical slot symbol. Their initializer is
# not a phi: query the reaching versions using the completed control regions.
borrowedTextScalarSlot typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], valueIr: Int -> Bool {
    valueIr >= 0 and valueIr < (typed -> len) -> unless { false -> return }
    typed[valueIr] => value
    value.kind == 17 and value.flags % 2 == 1 and value.symbol >= 0
        and value.typeId >= 0 and value.typeId < (types -> len)
        -> unless { false -> return }
    types[value.typeId] => slotType
    slotType.status == 0 and not slotType.containsParameter and slotType.kind == 1
        and slotType.origin == 1 and slotType.symbol == 1
}

borrowedTextSameScalarSlot typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], slotIr: Int, candidateIr: Int -> Bool {
    typed -> borrowedTextScalarSlot(types, slotIr)
        -> unless { false -> return }
    typed -> borrowedTextScalarSlot(types, candidateIr)
        -> unless { false -> return }
    typed[slotIr].sourceModule == typed[candidateIr].sourceModule
        and typed[slotIr].symbol == typed[candidateIr].symbol
        and (typed -> borrowedTextFunctionIr(slotIr)) >= -1
        and (typed -> borrowedTextFunctionIr(slotIr)) == (typed -> borrowedTextFunctionIr(candidateIr))
}

# Recover the declaration AST of the resolved canonical slot. A later SSA
# version inside a loop is not the lifetime owner of that mutable slot.
borrowedTextScalarDeclaration prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], callFunctionIndex: ref BorrowedTextCallFunctionIndex, versionIr: Int -> Int {
    typed -> borrowedTextScalarSlot(types, versionIr)
        -> unless { -2 -> return }
    typed[versionIr] => version
    version.sourceModule >= 0 and version.sourceModule < (prepared.package.ranges -> len)
        -> unless { -2 -> return }
    prepared.package.ranges[version.sourceModule] => range
    version.symbol >= 0 and version.symbol < range.symbolCount
        -> unless { -2 -> return }
    prepared.package.symbols[range.symbolStart + version.symbol] => declaration
    (declaration.kind == 9 or declaration.kind == 61) and declaration.flags % 2 == 1
        and declaration.astNode >= 0 and declaration.astNode < range.astCount
        -> unless { -2 -> return }
    -1 => declarationIr!
    callFunctionIndex.scalarVersionHeads[version.symbol] => candidateIr!
    candidateIr! >= 0 -> while {
        typed[candidateIr!].astNode == declaration.astNode
            and (typed -> borrowedTextSameScalarSlot(types, versionIr, candidateIr!))
            -> if {
                declarationIr! >= 0 -> if { -2 -> return }
                candidateIr! => declarationIr!
            }
        callFunctionIndex.scalarVersionNext[candidateIr!] => candidateIr!
    }
    declarationIr!
}

borrowedTextScalarVersionVisible prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], callFunctionIndex: ref BorrowedTextCallFunctionIndex, returnControls: ref [Bool; ~], definitionIr: Int, queryIr: Int -> Bool {
    definitionIr >= 0 and definitionIr < (typed -> len) and queryIr >= 0 and queryIr < (typed -> len)
        -> unless { false -> return }
    typed[definitionIr].sourceModule == typed[queryIr].sourceModule
        and (typed -> borrowedTextFunctionIr(definitionIr)) >= -1
        and (typed -> borrowedTextFunctionIr(definitionIr)) == (typed -> borrowedTextFunctionIr(queryIr))
        -> unless { false -> return }
    typed[definitionIr].sourceModule => sourceModule
    sourceModule >= 0 and sourceModule < (prepared.package.ranges -> len)
        -> unless { false -> return }
    prepared.package.ranges[sourceModule] => range
    typed[definitionIr].astNode >= 0 and typed[definitionIr].astNode < range.astCount
        and typed[queryIr].astNode >= 0 and typed[queryIr].astNode < range.astCount
        -> unless { false -> return }
    prepared -> borrowedTextScalarDeclaration(typed, types, callFunctionIndex, definitionIr) => slotDeclarationIr
    slotDeclarationIr >= 0 and (typed -> borrowedTextReachableBackedge(returnControls, definitionIr, queryIr, slotDeclarationIr))
        -> if { true -> return }
    # Only a completed same-iteration definition can enter this query. The
    # current RHS has no current-version loan; prior iterations were checked above.
    typed -> borrowedTextNodeBelongsTo(queryIr, definitionIr)
        -> if { false -> return }
    prepared.package.nodes[range.astStart + typed[definitionIr].astNode] => definitionAst
    prepared.package.nodes[range.astStart + typed[queryIr].astNode].start >= definitionAst.start + definitionAst.length
        and (prepared -> referenceForwardUseReachable(typed, definitionIr, queryIr, callFunctionIndex.irIndex.directExits))
}

# End only the replaced scalar's incoming loan, never an alias or an RHS read.
# Calls obey the same independence and early-exit rules as other expressions.
borrowedTextScalarReplacementSupported prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], replacementIr: Int -> Bool {
    typed[replacementIr].operand0 => rhsIr
    rhsIr >= 0 and rhsIr < (typed -> len) -> unless { false -> return }
    typed -> borrowedTextFunctionIr(replacementIr) => functionIr
    replacementIr => captureScope!
    0 => captureAscents!
    captureScope! >= 0 and captureScope! < (typed -> len) and typed[captureScope!].kind != 0 and typed[captureScope!].kind != 11 and captureAscents! < (typed -> len)
        -> while {
            typed[captureScope!].parent => captureScope!
            captureAscents! + 1 => captureAscents!
        }
    captureScope! >= 0 and captureScope! < (typed -> len)
        -> unless { false -> return }
    typed[replacementIr].sourceModule => sourceModule
    sourceModule >= 0 and sourceModule < (prepared.package.ranges -> len)
        -> unless { false -> return }
    prepared.package.ranges[sourceModule] => range
    typed[captureScope!].astNode >= 0 and typed[captureScope!].astNode < range.astCount
        -> unless { false -> return }
    0 => captureIr!
    captureIr! < (typed -> len) -> while {
        typed[captureIr!].kind == 0 and captureIr! != functionIr
            and (typed -> borrowedTextNodeBelongsTo(captureIr!, captureScope!))
            -> if { false -> return }
        typed[captureIr!].kind == 0 and captureIr! != functionIr and typed[captureIr!].sourceModule == sourceModule
            and typed[captureIr!].astNode >= 0 and typed[captureIr!].astNode < range.astCount
            -> if {
                prepared.package.nodes[range.astStart + typed[captureIr!].astNode].parent => captureAst!
                0 => captureParents!
                captureAst! >= 0 and captureAst! < range.astCount and captureParents! < range.astCount
                    -> while {
                        captureAst! == typed[captureScope!].astNode -> if { false -> return }
                        prepared.package.nodes[range.astStart + captureAst!].parent => captureAst!
                        captureParents! + 1 => captureParents!
                    }
                captureParents! >= range.astCount -> if { false -> return }
            }
        typed[captureIr!] => candidate
        candidate.kind == 23 => mayExit!
        candidate.sourceModule == sourceModule and candidate.astNode >= 0 and candidate.astNode < range.astCount
            -> if {
                prepared.package.nodes[range.astStart + candidate.astNode].kind == 82
                    -> if { true => mayExit! }
            }
        candidate.sourceModule == sourceModule
            and (candidate.kind == 2 or candidate.kind == 5 or mayExit!)
            and (typed -> borrowedTextNodeBelongsTo(captureIr!, replacementIr))
            -> if {
                # Explicit return or Result propagation can skip the replacement.
                mayExit! -> if { false -> return }
                candidate.kind == 5 -> if {
                    candidate.operand0 => readBinding!
                    readBinding! < 0 -> if { typed -> resolvedFormalReadBinding(captureIr!) => readBinding! }
                    typed -> borrowedTextSameScalarSlot(types, replacementIr, readBinding!)
                        -> if { false -> return }
                }
                candidate.kind == 2 -> if {
                    prepared.interpolationRanges -> each interpolationRange {
                        interpolationRange.sourceModule == sourceModule
                            -> if {
                                interpolationRange.nodeStart => interpolationIndex!
                                interpolationIndex! < interpolationRange.nodeStart + interpolationRange.nodeCount
                                    -> while {
                                        prepared.interpolations[interpolationIndex!] => interpolated
                                        interpolated.kind == 1 and interpolated.sourceToken == candidate.payloadToken
                                            -> if {
                                                typed -> interpolationBindingIr(prepared, captureIr!, interpolationIndex!) => readBinding
                                                typed -> borrowedTextSameScalarSlot(types, replacementIr, readBinding)
                                                    -> if { false -> return }
                                            }
                                        interpolationIndex! + 1 => interpolationIndex!
                                    }
                            }
                    }
                }
            }
        captureIr! + 1 => captureIr!
    }
    true
}

# This is the same direct-sibling source-order authority as lowering714-744.
# Control nextOperand is an alternative edge, so it cannot be a suffix link.
borrowedTextScalarNextStatement prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], regionIr: Int, afterIr: Int, irIndex: ref OwnershipIrIndex -> Int {
    typed[regionIr].sourceModule => sourceModule
    sourceModule >= 0 and sourceModule < (prepared.package.ranges -> len)
        -> unless { -1 -> return }
    prepared.package.ranges[sourceModule] => range
    -1 => nextIr!
    UIntSize(0) => nextStart!
    # The immutable child index retains the original ascending IR order.
    # Keep source offsets and ambiguity decisions in this query.
    irIndex.firstChild[regionIr] => candidateIr!
    candidateIr! >= 0 and candidateIr! < (typed -> len)
        -> while {
            typed[candidateIr!] => candidate
            candidate.parent == regionIr and candidate.sourceModule == sourceModule
                and candidate.kind != 10 and candidate.kind != 29
                and candidate.astNode >= 0 and candidate.astNode < range.astCount
                -> if {
                    prepared.package.nodes[range.astStart + candidate.astNode].start => start
                    true => afterBoundary!
                    afterIr >= 0 -> if {
                        typed[afterIr].astNode >= 0 and typed[afterIr].astNode < range.astCount
                            -> if {
                                start > prepared.package.nodes[range.astStart + typed[afterIr].astNode].start => afterBoundary!
                            } else { false => afterBoundary! }
                    }
                    afterBoundary! and (nextIr! < 0 or start < nextStart!)
                        -> if {
                            candidateIr! => nextIr!
                            start => nextStart!
                        }
                    afterBoundary! and nextIr! >= 0 and candidateIr! != nextIr! and start == nextStart!
                        -> if { -2 -> return }
                }
            irIndex.nextChild[candidateIr!] => candidateIr!
        }
    nextIr!
}

# Only completed replacements on every continuing path can kill an old version.
# Loops and unsupported controls cannot establish a new must-replace proof.
borrowedTextScalarRegionMustReplace prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], returnControls: ref [Bool; ~], slotIr: Int, regionIr: Int, queryIr: Int, definitionStart: UIntSize, depth: Int, irIndex: ref OwnershipIrIndex -> Bool {
    depth < (typed -> len) and regionIr >= 0 and regionIr < (typed -> len)
        and slotIr >= 0 and slotIr < (typed -> len) and queryIr >= 0 and queryIr < (typed -> len)
        and typed[slotIr].sourceModule == typed[queryIr].sourceModule
        and typed[slotIr].sourceModule == typed[regionIr].sourceModule
        -> unless { false -> return }
    typed[slotIr].sourceModule => sourceModule
    sourceModule >= 0 and sourceModule < (prepared.package.ranges -> len)
        -> unless { false -> return }
    prepared.package.ranges[sourceModule] => range
    typed[queryIr].astNode >= 0 and typed[queryIr].astNode < range.astCount
        -> unless { false -> return }
    prepared.package.nodes[range.astStart + typed[queryIr].astNode].start => queryStart
    prepared -> borrowedTextScalarNextStatement(typed, regionIr, -1, irIndex) => statementIr!
    false => replaced!
    0 => steps!
    statementIr! >= 0 and statementIr! < (typed -> len) and steps! < (typed -> len)
        -> while {
            typed[statementIr!] => statement
            prepared.package.nodes[range.astStart + statement.astNode].start => statementStart
            (typed -> borrowedTextNodeBelongsTo(queryIr, statementIr!)) => queryInside
            statementStart >= queryStart and not queryInside
                -> if { replaced! -> return }
            statementStart > definitionStart -> if {
                typed -> borrowedTextSameScalarSlot(types, slotIr, statementIr!)
                    -> if {
                        prepared -> borrowedTextScalarReplacementSupported(typed, types, statementIr!)
                            -> if { true => replaced! }
                    }
                statementIr! => controlIr!
                statement.kind == 9 and statement.opcode == -1
                    and statement.operand1 >= 0 and statement.operand1 < (typed -> len)
                    and (typed[statement.operand1].kind == 18 or typed[statement.operand1].kind == 27
                    or typed[statement.operand1].kind == 33 or typed[statement.operand1].kind == 34)
                    and typed[statement.operand1].parent == statementIr!
                    and typed[statement.operand1].sourceModule == statement.sourceModule
                    -> if { statement.operand1 => controlIr! }
                typed[controlIr!] => control
                control.kind == 18 and control.operand1 >= 0
                    -> if {
                        queryInside -> if {
                            typed -> borrowedTextNodeBelongsTo(queryIr, control.operand1)
                                -> if {
                                    (replaced! or (prepared -> borrowedTextScalarRegionMustReplace(typed, types, returnControls, slotIr, control.operand1, queryIr, definitionStart, depth + 1, irIndex))) -> return
                                }
                            control.nextOperand >= 0 and (typed -> borrowedTextNodeBelongsTo(queryIr, control.nextOperand))
                                -> if {
                                    (replaced! or (prepared -> borrowedTextScalarRegionMustReplace(typed, types, returnControls, slotIr, control.nextOperand, queryIr, definitionStart, depth + 1, irIndex))) -> return
                                }
                            replaced! -> return
                        }
                        control.nextOperand >= 0 -> if {
                            prepared -> borrowedTextScalarRegionMustReplace(typed, types, returnControls, slotIr, control.operand1, queryIr, definitionStart, depth + 1, irIndex) => thenReplaces
                            prepared -> borrowedTextScalarRegionMustReplace(typed, types, returnControls, slotIr, control.nextOperand, queryIr, definitionStart, depth + 1, irIndex) => elseReplaces
                            control.operand1 < (returnControls -> len) and returnControls[control.operand1] => thenReturns
                            control.nextOperand < (returnControls -> len) and returnControls[control.nextOperand] => elseReturns
                            (thenReturns or thenReplaces) and (elseReturns or elseReplaces) and not (thenReturns and elseReturns)
                                -> if { true => replaced! }
                        }
                    }
                queryInside and (control.kind == 27 or control.kind == 33 or control.kind == 34)
                    -> if {
                        # Only the selected arm body precedes this query.
                        # Subject and condition reads retain the incoming version.
                        control.operand0 => arm!
                        control.kind == 27 or control.kind == 34 -> if { control.operand1 => arm! }
                        0 => armEdges!
                        arm! >= 0 and arm! < (typed -> len) and armEdges! < (typed -> len)
                            -> while {
                                typed[arm!].parent != controlIr! or typed[arm!].sourceModule != control.sourceModule
                                    -> if { replaced! -> return }
                                typed[arm!].operand1 => bodyIr
                                bodyIr >= 0 and bodyIr < (typed -> len)
                                    and typed[bodyIr].kind == 19 and typed[bodyIr].parent == arm!
                                    and typed[bodyIr].sourceModule == control.sourceModule
                                    and (typed -> borrowedTextNodeBelongsTo(queryIr, bodyIr))
                                    -> if {
                                        (replaced! or (prepared -> borrowedTextScalarRegionMustReplace(typed, types, returnControls, slotIr, bodyIr, queryIr, definitionStart, depth + 1, irIndex))) -> return
                                    }
                                typed[arm!].nextOperand => arm!
                                armEdges! + 1 => armEdges!
                            }
                        replaced! -> return
                    }
            }
            queryInside -> if { replaced! -> return }
            statement.kind == 21 or statement.kind == 22 or statement.kind == 23
                -> if { false -> return }
            prepared -> borrowedTextScalarNextStatement(typed, regionIr, statementIr!, irIndex) => statementIr!
            steps! + 1 => steps!
        }
    statementIr! == -1 -> if { replaced! } else { false }
}

borrowedTextScalarVersionReaches prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], returnControls: ref [Bool; ~], definitionIr: Int, queryIr: Int, irIndex: ref OwnershipIrIndex -> Bool {
    definitionIr >= 0 and definitionIr < (typed -> len) and queryIr >= 0 and queryIr < (typed -> len)
        -> unless { true -> return }
    typed[definitionIr].sourceModule == typed[queryIr].sourceModule
        -> unless { true -> return }
    typed[definitionIr].parent => regionIr
    regionIr >= 0 and regionIr < (typed -> len) -> unless { true -> return }
    typed[definitionIr].sourceModule => sourceModule
    sourceModule >= 0 and sourceModule < (prepared.package.ranges -> len)
        -> unless { true -> return }
    prepared.package.ranges[sourceModule] => range
    typed[definitionIr].astNode >= 0 and typed[definitionIr].astNode < range.astCount
        -> unless { true -> return }
    prepared.package.nodes[range.astStart + typed[definitionIr].astNode].start => definitionStart
    not (prepared -> borrowedTextScalarRegionMustReplace(typed, types, returnControls, definitionIr, regionIr, queryIr, definitionStart, 0, irIndex))
}

borrowedTextValueOrigin typed: ref [typedIr.TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], querySiteIr: Int, storeSites: ref [Int; ~], returnControls: ref [Bool; ~], contracts: ref [BorrowedTextReturn; ~], callFunctionIndex: ref BorrowedTextCallFunctionIndex, viewTypes: ref [Bool; ~], parameterLoans: Bool, concrete: Bool, valueIr: Int, originIr: Int, active: mut [Int; ~], depth: Int -> BorrowedTextOriginFact {
    valueIr >= 0 and valueIr < (typed -> len)
        and originIr >= 0 and originIr < (typed -> len)
        -> unless { BorrowedTextOriginFact { status: 3, usesOrigin: false, placeIr: -1 } -> return }
    0 => ancestor!
    ancestor! < depth -> while {
        active[ancestor! * 2] == valueIr and active[ancestor! * 2 + 1] == querySiteIr
            -> if {
                # A recursive edge has no proof yet. It is not a static value.
                BorrowedTextOriginFact { status: 0, usesOrigin: false, placeIr: -1 } -> return
            }
        ancestor! + 1 => ancestor!
    }
    depth * 2 < (active -> len) -> if {
        valueIr => active[depth * 2]
        querySiteIr => active[depth * 2 + 1]
    } else {
        active -> push(valueIr)
        active -> push(querySiteIr)
    }
    typed -> borrowedTextValueOriginCore(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, valueIr, originIr, active, depth + 1)
}

# Only the indexed Text payload has process lifetime. Borrowing the Arguments
# descriptor itself still uses the ordinary concrete-place path.
borrowedTextProcessArgumentIndex typed: ref [typedIr.TypedIrNode; ~], value: typedIr.TypedIrNode -> Bool {
    value.kind != 15 or value.typeOrigin != 1 or value.typeSymbol != 1
        -> if { false -> return }
    value.operand0 < 0 or value.operand0 >= (typed -> len)
        -> if { false -> return }
    typed[value.operand0] => source
    source.typeOrigin == 1 and source.typeSymbol == 16
        -> if { true -> return }
    (source.kind == 6 or source.kind == 9) and source.opcode == -212
}

# Exact lexical field paths share existing binding/module/ordinal identities.
# Indices and unresolved roots are deliberately outside this equality proof.
resolvedSameOwnedFieldPlace typed: ref [typedIr.TypedIrNode; ~], leftPlaceIr: Int, rightPlaceIr: Int -> Bool {
    typed -> resolvedPlaceRootBinding(leftPlaceIr) => root
    root < 0 or root != (typed -> resolvedPlaceRootBinding(rightPlaceIr))
        -> if { false -> return }
    typed -> resolvedPlaceProjectionDepth(leftPlaceIr) => depth
    depth <= 0 or depth != (typed -> resolvedPlaceProjectionDepth(rightPlaceIr))
        -> if { false -> return }
    leftPlaceIr => left!
    rightPlaceIr => right!
    0 => steps!
    steps! < depth and steps! < (typed -> len) -> while {
        left! < 0 or left! >= (typed -> len) or right! < 0 or right! >= (typed -> len)
            -> if { false -> return }
        typed[left!] => left
        typed[right!] => right
        left.kind != 13 or right.kind != 13 or left.symbol < 0 or right.symbol < 0
            or left.symbol != right.symbol or left.targetModule != right.targetModule
            -> if { false -> return }
        left.operand0 => left!
        right.operand0 => right!
        steps! + 1 => steps!
    }
    steps! == depth
}

semanticNominalSourceModule prepared: ref semanticContext.SemanticSnapshot, valueType: typeIds.SemanticType -> Int {
    valueType.origin != 0 and valueType.origin != 2
        -> if { -1 -> return }
    valueType.module => sourceModule!
    valueType.origin == 2 -> if {
        sourceModule! < 0 or sourceModule! >= (prepared.modules -> len)
            -> if { -1 -> return }
        prepared.modules[sourceModule!].sourceIndex => sourceModule!
    }
    sourceModule! < 0 or sourceModule! >= (prepared.package.ranges -> len)
        -> if { -1 -> return }
    sourceModule!
}

# Committed struct fields, enum payloads and scalar/byte backing prove an independent
# storage field. Unknown, generic, reference, other containers and cycles keep
# the existing aggregate origin. Storage ownership itself remains contextual.
borrowedTextIndependentFieldType prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], typeId: Int, depth: Int -> Bool {
    typeId < 0 or typeId >= (types -> len) or depth >= (types -> len)
        -> if { false -> return }
    (prepared -> semanticTypeContainsBorrowKind(types, typeId, 2))
        or (prepared -> semanticTypeContainsReadonlyReference(types, typeId))
        -> if { false -> return }
    types[typeId] => valueType
    valueType.status != 0 or valueType.containsParameter
        -> if { false -> return }
    valueType.kind == 1 and valueType.origin == 1
        -> if {
            (((valueType.symbol -> typeIds.builtinNameIsReserved)
                or valueType.symbol == typeIds.builtinSymbolByName("Range"))
                and valueType.symbol != 1 and valueType.symbol != 24) -> return
        }
    valueType.kind == 3 or valueType.kind == 4 -> if {
        valueType.first < 0 or valueType.first >= (types -> len)
            -> if { false -> return }
        types[valueType.first] => element
        element.kind == 1 and element.origin == 1 and element.symbol == 8 -> return
    }
    valueType.kind != 1 or (valueType.origin != 0 and valueType.origin != 2)
        -> if { false -> return }
    prepared -> semanticNominalSourceModule(valueType) => ownerSourceModule
    ownerSourceModule < 0 -> if { false -> return }
    prepared.package.ranges[ownerSourceModule] => ownerRange
    valueType.symbol < 0 or valueType.symbol >= ownerRange.symbolCount
        -> if { false -> return }
    prepared.package.symbols[ownerRange.symbolStart + valueType.symbol] => declaration
    declaration.kind == 4 -> if {
        0 => variantIndex!
        variantIndex! < ownerRange.symbolCount -> while {
            prepared.package.symbols[ownerRange.symbolStart + variantIndex!] => variant
            variant.kind == 27 and variant.parent == valueType.symbol and variant.typeNode >= 0
                -> if {
                    false => resolvedPayload!
                    0 => referenceIndex!
                    referenceIndex! < (prepared.semantic.references -> len)
                        -> while {
                            prepared.semantic.references[referenceIndex!] => payload
                            payload.sourceModule == ownerSourceModule and payload.typeAst == variant.typeNode
                                -> if {
                                    payload.status != 0 or not (prepared -> borrowedTextIndependentFieldType(types, payload.typeId, depth + 1))
                                        -> if { false -> return }
                                    true => resolvedPayload!
                                }
                            referenceIndex! + 1 => referenceIndex!
                        }
                    not resolvedPayload! -> if { false -> return }
                }
            variantIndex! + 1 => variantIndex!
        }
        true -> return
    }
    declaration.kind != 3 -> if { false -> return }
    0 => declaredFields!
    0 => symbolIndex!
    symbolIndex! < ownerRange.symbolCount -> while {
        prepared.package.symbols[ownerRange.symbolStart + symbolIndex!] => member
        member.kind == 26 and member.parent == valueType.symbol
            -> if { declaredFields! + 1 => declaredFields! }
        symbolIndex! + 1 => symbolIndex!
    }
    0 => resolvedFields!
    0 => fieldIndex!
    fieldIndex! < (prepared.semantic.fields -> len)
        -> while {
            prepared.semantic.fields[fieldIndex!] => field
            field.ownerType == typeId -> if {
                field.status != 0 or not (prepared -> borrowedTextIndependentFieldType(types, field.fieldType, depth + 1))
                    -> if { false -> return }
                resolvedFields! + 1 => resolvedFields!
            }
            fieldIndex! + 1 => fieldIndex!
        }
    resolvedFields! == declaredFields!
}

# Field IR already carries the committed field ordinal and selected type.
# Admit only a lexical field chain rooted in an owned, non-reference binding.
borrowedTextOwnedFieldRoot prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], typed: ref [typedIr.TypedIrNode; ~], valueIr: Int, depth: Int -> Int {
    valueIr < 0 or valueIr >= (typed -> len) or depth >= (typed -> len)
        -> if { -1 -> return }
    typed[valueIr] => value
    value.typeId < 0 or value.typeId >= (types -> len)
        -> if { -1 -> return }
    types[value.typeId].status != 0 or types[value.typeId].containsParameter
        or types[value.typeId].kind == 2 or types[value.typeId].kind == 8
        -> if { -1 -> return }
    value.kind == 5 -> if {
        typed -> resolvedPlaceRootBinding(valueIr) => binding
        binding >= 0 and binding < (typed -> len) -> if {
            typed[binding].typeId => bindingTypeId
            bindingTypeId >= 0 and bindingTypeId < (types -> len)
                and types[bindingTypeId].status == 0 and not types[bindingTypeId].containsParameter
                and types[bindingTypeId].kind != 2 and types[bindingTypeId].kind != 8
                and (prepared -> semanticTypeContainsOwnedStorage(types, bindingTypeId))
                -> if { binding -> return }
        }
        -1 -> return
    }
    value.kind != 13 or value.operand0 < 0 or value.operand0 >= (typed -> len)
        -> if { -1 -> return }
    prepared -> borrowedTextOwnedFieldRoot(types, typed, value.operand0, depth + 1) => root
    root < 0 or typed[root].sourceModule != value.sourceModule
        or (typed -> borrowedTextFunctionIr(root)) != (typed -> borrowedTextFunctionIr(valueIr))
        -> if { -1 -> return }
    typed[value.operand0].typeId => ownerTypeId
    ownerTypeId < 0 or ownerTypeId >= (types -> len)
        -> if { -1 -> return }
    types[ownerTypeId] => ownerType
    ownerType.status != 0 or ownerType.containsParameter
        or ownerType.kind != 1 or (ownerType.origin != 0 and ownerType.origin != 2)
        -> if { -1 -> return }
    prepared -> semanticNominalSourceModule(ownerType) => ownerSourceModule
    ownerSourceModule < 0 -> if { -1 -> return }
    prepared.package.ranges[ownerSourceModule] => ownerRange
    ownerType.symbol < 0 or ownerType.symbol >= ownerRange.symbolCount
        -> if { -1 -> return }
    prepared.package.symbols[ownerRange.symbolStart + ownerType.symbol].kind != 3
        -> if { -1 -> return }
    0 => fieldIndex!
    fieldIndex! < (prepared.semantic.fields -> len)
        -> while {
            prepared.semantic.fields[fieldIndex!] => field
            field.status == 0 and field.ownerType == ownerTypeId and field.ordinal == value.symbol
                and field.fieldType == value.typeId and field.sourceModule == value.targetModule
                -> if { root -> return }
            fieldIndex! + 1 => fieldIndex!
        }
    -1
}

borrowedTextPlaceUsesOrigin typed: ref [typedIr.TypedIrNode; ~], valuePlaceIr: Int, originIr: Int -> Bool {
    typed -> resolvedPlaceRootBinding(valuePlaceIr) => owner
    owner >= 0 and owner == originIr -> if { true -> return }
    valuePlaceIr < 0 or valuePlaceIr >= (typed -> len)
        or originIr < 0 or originIr >= (typed -> len)
        -> if { false -> return }
    typed -> resolvedPlaceRootBinding(originIr) => queriedOwner
    owner < 0 or owner != queriedOwner -> if { false -> return }
    (typed -> resolvedPlaceProjectionDepth(valuePlaceIr)) == 0
        -> if { true -> return }
    typed -> resolvedSameOwnedFieldPlace(valuePlaceIr, originIr)
}

# Selected-call loan registration and recursive values share parameter policy.
borrowedTextCallArgumentOrigin typed: ref [typedIr.TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], querySiteIr: Int, storeSites: ref [Int; ~], returnControls: ref [Bool; ~], contracts: ref [BorrowedTextReturn; ~], callFunctionIndex: ref BorrowedTextCallFunctionIndex, viewTypes: ref [Bool; ~], parameterLoans: Bool, concrete: Bool, argumentIr: Int, originIr: Int, contract: BorrowedTextReturn, active: mut [Int; ~], depth: Int -> BorrowedTextOriginFact {
    contract.concreteParameter and not contract.transfersOwner
        -> if {
            typed -> borrowedTextConcreteOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, argumentIr, originIr, active, depth) -> return
        }
    typed -> borrowedTextValueOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete and not contract.transfersOwner, argumentIr, originIr, active, depth)
}

borrowedTextCallArgumentOriginFact typed: ref [typedIr.TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], querySiteIr: Int, storeSites: ref [Int; ~], returnControls: ref [Bool; ~], contracts: ref [BorrowedTextReturn; ~], callFunctionIndex: ref BorrowedTextCallFunctionIndex, viewTypes: ref [Bool; ~], argumentIr: Int, originIr: Int, contract: BorrowedTextReturn -> BorrowedTextOriginFact {
    [Int; ~] => active!
    typed -> borrowedTextCallArgumentOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, false, true, argumentIr, originIr, contract, active!, 0)
}

borrowedTextConcreteOrigin typed: ref [typedIr.TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], querySiteIr: Int, storeSites: ref [Int; ~], returnControls: ref [Bool; ~], contracts: ref [BorrowedTextReturn; ~], callFunctionIndex: ref BorrowedTextCallFunctionIndex, viewTypes: ref [Bool; ~], parameterLoans: Bool, valueIr: Int, originIr: Int, active: mut [Int; ~], depth: Int -> BorrowedTextOriginFact {
    valueIr < 0 or valueIr >= (typed -> len) -> if {
        BorrowedTextOriginFact { status: 3, usesOrigin: false, placeIr: -1 } -> return
    }
    0 => ancestor!
    ancestor! < depth -> while {
        active[ancestor! * 2] == valueIr and active[ancestor! * 2 + 1] == querySiteIr
            -> if {
                BorrowedTextOriginFact { status: 0, usesOrigin: false, placeIr: -1 } -> return
            }
        ancestor! + 1 => ancestor!
    }
    depth * 2 < (active -> len) -> if {
        valueIr => active[depth * 2]
        querySiteIr => active[depth * 2 + 1]
    } else {
        active -> push(valueIr)
        active -> push(querySiteIr)
    }
    typed[valueIr] => value
    typed -> borrowedTextProcessArgumentIndex(value)
        -> if {
            BorrowedTextOriginFact { status: 1, usesOrigin: false, placeIr: -1 } -> return
        }
    value.kind == 13 -> if {
        prepared -> borrowedTextOwnedFieldRoot(types, typed, valueIr, 0) => ownedRoot
        ownedRoot >= 0 and (prepared -> semanticTypeContainsOwnedStorage(types, value.typeId))
            and (prepared -> borrowedTextIndependentFieldType(types, value.typeId, 0))
            -> if {
                BorrowedTextOriginFact { status: 2, usesOrigin: typed -> borrowedTextPlaceUsesOrigin(valueIr, originIr), placeIr: valueIr } -> return
            }
    }
    value.kind == 13 or value.kind == 15 -> if {
        typed -> borrowedTextConcreteOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, value.operand0, originIr, active, depth + 1) => source!
        source!.status == 2 and source!.placeIr >= 0 -> if { valueIr => source!.placeIr }
        source! -> return
    }
    valueIr => binding!
    value.kind == 5 -> if { value.operand0 => binding! }
    binding! >= 0 and binding! < (typed -> len) -> if {
        typed[binding!] => definition
        definition.kind == 10 or definition.kind == 17 or definition.kind == 29
            -> if {
                definition.typeId >= 0 and definition.typeId < (viewTypes -> len)
                    -> if {
                        not viewTypes[definition.typeId] -> if {
                            BorrowedTextOriginFact { status: 2, usesOrigin: typed -> borrowedTextPlaceUsesOrigin(valueIr, originIr), placeIr: valueIr } -> return
                        }
                    }
                (definition.typeOrigin == 1 and definition.typeSymbol == 24)
                    or (prepared -> semanticTypeContainsOwnedStorage(types, definition.typeId))
                    -> if {
                        # Empty upstream loans do not erase owned aggregate storage.
                        # Query actual loans without synthesizing initializer owners.
                        typed -> borrowedTextValueOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, false, valueIr, originIr, active, depth) => upstream
                        upstream.status == 2 or upstream.status == 3 -> if { upstream -> return }
                        BorrowedTextOriginFact { status: 2, usesOrigin: typed -> borrowedTextPlaceUsesOrigin(valueIr, originIr), placeIr: valueIr } -> return
                    }
            }
    }
    # This is C#'s concrete-place then recursive-view policy. Reuse the current
    # depth, so entering the recursive expression does not see itself as a cycle.
    typed -> borrowedTextValueOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, true, valueIr, originIr, active, depth)
}

borrowedTextEachRoleCall prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], valueIr: Int -> Int {
    typed[valueIr] => value
    value.sourceModule >= 0 and value.sourceModule < (prepared.package.ranges -> len)
        -> unless { -1 -> return }
    prepared.package.ranges[value.sourceModule] => range
    value.symbol >= 0 and value.symbol < range.symbolCount
        -> unless { -1 -> return }
    prepared.package.symbols[range.symbolStart + value.symbol] => parameter
    parameter.kind == 35 and parameter.parent >= 0 and parameter.parent < range.symbolCount
        -> unless { -1 -> return }
    prepared.package.symbols[range.symbolStart + parameter.parent] => role
    role.kind == 48 -> unless { -1 -> return }
    0 => callIr!
    callIr! < (typed -> len) -> while {
        typed[callIr!] => call
        call.kind == 6 and call.opcode == -208 and call.sourceModule == value.sourceModule
            and call.astNode == role.astNode and call.operand0 >= 0 and call.operand0 < (typed -> len)
            -> if {
                typed[call.operand0].typeId => sourceType!
                sourceType! >= 0 and sourceType! < (types -> len)
                    -> if {
                        types -> typeIds.materializedReadTypeId(sourceType!) => sourceType!
                        sourceType! >= 0 and sourceType! < (types -> len)
                            and types[sourceType!].kind >= 2 and types[sourceType!].kind <= 4
                            -> if { callIr! -> return }
                    }
            }
        callIr! + 1 => callIr!
    }
    -1
}

borrowedTextStoredArrayOrigin typed: ref [typedIr.TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], querySiteIr: Int, storeSites: ref [Int; ~], returnControls: ref [Bool; ~], contracts: ref [BorrowedTextReturn; ~], callFunctionIndex: ref BorrowedTextCallFunctionIndex, viewTypes: ref [Bool; ~], parameterLoans: Bool, concrete: Bool, bindingIr: Int, originIr: Int, active: mut [Int; ~], depth: Int -> BorrowedTextOriginFact {
    BorrowedTextOriginFact { status: 1, usesOrigin: false, placeIr: -1 } => stored!
    storeSites -> each storeIr {
        typed[storeIr] => store
        (typed -> resolvedPlaceRootBinding(store.operand0)) == bindingIr
            and (prepared -> borrowedTextStoreVisible(typed, returnControls, storeIr, querySiteIr, callFunctionIndex.irIndex.directExits))
            -> if {
                # Re-query the payload at its evaluation boundary. A header-dependent
                # each/name payload is never frozen to a first-iteration origin set.
                # The container carries upstream loans, not a borrow of the
                # transferred owner's former local backing frame.
                typed -> borrowedTextValueOrigin(prepared, types, storeIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, false, store.operand1, originIr, active, depth) => payload
                stored! -> mergeBorrowedTextOrigin(payload, typed) => stored!
            }
    }
    stored!
}

# Interpolation retains the selected literal's lexical scope, not its later sink.
interpolationBindingIr typed: ref [typedIr.TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, literalIr: Int, nodeIndex: Int -> Int {
    prepared.interpolations[nodeIndex] => node
    node.kind != 1 or node.symbol < 0 -> if { -1 -> return }
    typed[literalIr] => literal
    prepared.package.ranges[literal.sourceModule] => range
    typed -> borrowedTextFunctionIr(literalIr) => functionIr
    -1 => selected!
    UIntSize(0) => selectedStart!
    0 => candidateIr!
    candidateIr! < (typed -> len) -> while {
        typed[candidateIr!] => candidate
        candidate.sourceModule == literal.sourceModule and candidate.symbol == node.symbol
            and (typed -> borrowedTextFunctionIr(candidateIr!)) == functionIr
            -> if {
                candidate.kind == 10 and candidate.parent == functionIr
                    -> if { candidateIr! -> return }
                candidate.parent => bindingScope!
                # A payload pattern and its body are siblings in the case.
                # Reuse their canonical case/callback ownership region.
                candidate.kind == 29 -> if {
                    candidateIr! -> typedIr.moveOwnershipRegion(typed) => bindingScope!
                }
                (candidate.kind == 17 or candidate.kind == 29)
                    and candidate.astNode >= 0 and candidate.astNode < range.astCount
                    and bindingScope! >= 0
                    and (typed -> borrowedTextNodeBelongsTo(literalIr, bindingScope!))
                    -> if {
                        prepared.package.nodes[range.astStart + candidate.astNode].start => start
                        start <= node.payloadStart and (selected! < 0 or start > selectedStart!)
                            -> if {
                                candidateIr! => selected!
                                start => selectedStart!
                            }
                    }
            }
        candidateIr! + 1 => candidateIr!
    }
    selected!
}

# operand0 is authoritative even for a synthesized qualified receiver that was
# appended after the call's ordinary argument children.
borrowedTextInterpolationArgument prepared: ref semanticContext.SemanticSnapshot, nodeIndex: Int, ordinal: Int -> Int {
    prepared.interpolations[nodeIndex].operand0 => first
    ordinal == 0 -> if { first -> return }
    1 => nextOrdinal!
    0 => child!
    child! < (prepared.interpolations -> len) -> while {
        prepared.interpolations[child!].parent == nodeIndex and child! != first
            -> if {
                nextOrdinal! == ordinal -> if { child! -> return }
                nextOrdinal! + 1 => nextOrdinal!
            }
        child! + 1 => child!
    }
    -1
}

borrowedTextInterpolationOrigin typed: ref [typedIr.TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], literalIr: Int, querySiteIr: Int, storeSites: ref [Int; ~], returnControls: ref [Bool; ~], contracts: ref [BorrowedTextReturn; ~], callFunctionIndex: ref BorrowedTextCallFunctionIndex, viewTypes: ref [Bool; ~], parameterLoans: Bool, concrete: Bool, nodeIndex: Int, originIr: Int, active: mut [Int; ~], depth: Int, interpolationDepth: Int -> BorrowedTextOriginFact {
    nodeIndex >= 0 and nodeIndex < (prepared.interpolations -> len)
        and interpolationDepth < (prepared.interpolations -> len)
        -> unless { BorrowedTextOriginFact { status: 3, usesOrigin: false, placeIr: -1 } -> return }
    prepared.interpolations[nodeIndex] => node
    node.kind == 1 -> if {
        typed -> interpolationBindingIr(prepared, literalIr, nodeIndex) => bindingIr
        bindingIr < 0 -> if { BorrowedTextOriginFact { status: 0, usesOrigin: false, placeIr: -1 } -> return }
        concrete -> if {
            typed -> borrowedTextConcreteOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, bindingIr, originIr, active, depth) -> return
        }
        typed -> borrowedTextValueOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, false, bindingIr, originIr, active, depth) -> return
    }
    node.kind == 0 or node.kind == 4 or node.kind == 9
        -> if {
            BorrowedTextOriginFact { status: 1, usesOrigin: false, placeIr: -1 } -> return
        }
    node.kind == 5 or node.kind == 7 or node.kind == 11 or node.kind == 13
        -> if {
            typed -> borrowedTextInterpolationOrigin(prepared, types, literalIr, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, node.operand0, originIr, active, depth, interpolationDepth + 1) -> return
        }
    node.kind == 6 and (node.opcode == -203 or node.opcode == -206 or node.opcode == -232 or node.opcode == -230 or node.opcode == -229)
        -> if {
            node.operand0 => sourceNode!
            node.opcode == -229 -> if { prepared -> borrowedTextInterpolationArgument(nodeIndex, 1) => sourceNode! }
            node.opcode != -203 -> if {
                typed -> borrowedTextInterpolationOrigin(prepared, types, literalIr, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, true, sourceNode!, originIr, active, depth, interpolationDepth + 1) -> return
            }
            typed -> borrowedTextInterpolationOrigin(prepared, types, literalIr, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, sourceNode!, originIr, active, depth, interpolationDepth + 1) => prefix
            not parameterLoans and prefix.status == 0 -> if {
                typed -> borrowedTextInterpolationOrigin(prepared, types, literalIr, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, true, sourceNode!, originIr, active, depth, interpolationDepth + 1) -> return
            }
            prefix -> return
        }
    node.kind == 6 or node.kind == 8 or node.kind == 10
        -> if {
            nodeIndex >= (callFunctionIndex.interpolationFunctionTargets -> len)
                -> if { BorrowedTextOriginFact { status: 3, usesOrigin: false, placeIr: -1 } -> return }
            callFunctionIndex.interpolationFunctionTargets[nodeIndex] => selected
            selected < 0 -> if { BorrowedTextOriginFact { status: 0, usesOrigin: false, placeIr: -1 } -> return }
            selected >= (typed -> len) or typed[selected].kind != 0
                -> if { BorrowedTextOriginFact { status: 3, usesOrigin: false, placeIr: -1 } -> return }
            BorrowedTextOriginFact { status: 0, usesOrigin: false, placeIr: -1 } => mapped!
            contracts -> each contract {
                contract.functionIr == selected -> if {
                    prepared -> borrowedTextInterpolationArgument(nodeIndex, contract.parameterOrdinal) => argument
                    (contract.concreteParameter and not contract.transfersOwner)
                        or (concrete and not contract.transfersOwner) => argumentConcrete
                    typed -> borrowedTextInterpolationOrigin(prepared, types, literalIr, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, argumentConcrete, argument, originIr, active, depth, interpolationDepth + 1) => argumentOrigin
                    mapped! -> mergeBorrowedTextOrigin(argumentOrigin, typed) => mapped!
                }
            }
            mapped! -> return
        }
    node.kind == 12 or node.kind == 14 or node.kind == 15 or node.kind == 16
        -> if {
            BorrowedTextOriginFact { status: 1, usesOrigin: false, placeIr: -1 } => union!
            0 => child!
            child! < (prepared.interpolations -> len) -> while {
                prepared.interpolations[child!].parent == nodeIndex
                    -> if {
                        typed -> borrowedTextInterpolationOrigin(prepared, types, literalIr, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, child!, originIr, active, depth, interpolationDepth + 1) => childOrigin
                        union! -> mergeBorrowedTextOrigin(childOrigin, typed) => union!
                    }
                child! + 1 => child!
            }
            union! -> return
        }
    BorrowedTextOriginFact { status: 0, usesOrigin: false, placeIr: -1 }
}

borrowedTextValueOriginCore typed: ref [typedIr.TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], querySiteIr: Int, storeSites: ref [Int; ~], returnControls: ref [Bool; ~], contracts: ref [BorrowedTextReturn; ~], callFunctionIndex: ref BorrowedTextCallFunctionIndex, viewTypes: ref [Bool; ~], parameterLoans: Bool, concrete: Bool, valueIr: Int, originIr: Int, active: mut [Int; ~], depth: Int -> BorrowedTextOriginFact {
    typed[valueIr] => value
    typed -> borrowedTextProcessArgumentIndex(value)
        -> if {
            BorrowedTextOriginFact { status: 1, usesOrigin: false, placeIr: -1 } -> return
        }
    # Only the completed Path.pathText intrinsic borrows its actual receiver.
    # Ordinary selected calls keep their existing contract mapping.
    (value.kind == 6 or value.kind == 9) and value.opcode == -230
        and value.typeOrigin == 1 and value.typeSymbol == 1
        and value.operand0 >= 0 and value.operand0 < (typed -> len)
        -> if {
            typed -> borrowedTextConcreteOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, value.operand0, originIr, active, depth) -> return
        }
    value.kind == 2 -> if {
        BorrowedTextOriginFact { status: 1, usesOrigin: false, placeIr: -1 } => interpolationOrigins!
        prepared.package.ranges[value.sourceModule].tokenStart + value.payloadToken => sourceToken
        sourceToken >= 0 and sourceToken < (callFunctionIndex.interpolationRootByToken -> len)
            -> unless { BorrowedTextOriginFact { status: 3, usesOrigin: false, placeIr: -1 } -> return }
        callFunctionIndex.interpolationRootByToken[sourceToken] => root!
        root! >= 0 -> while {
            root! < (callFunctionIndex.interpolationResultTypes -> len)
                -> unless {
                    BorrowedTextOriginFact { status: 3, usesOrigin: false, placeIr: -1 } -> return
                }
            callFunctionIndex.interpolationResultTypes[root!] => resultType
            resultType >= 0 and resultType < (viewTypes -> len)
                -> if {
                    viewTypes[resultType] -> if {
                        typed -> borrowedTextInterpolationOrigin(prepared, types, valueIr, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, root!, originIr, active, depth, 0) => rootOrigin
                        interpolationOrigins! -> mergeBorrowedTextOrigin(rootOrigin, typed) => interpolationOrigins!
                    }
                } else {
                    interpolationOrigins! -> mergeBorrowedTextOrigin(BorrowedTextOriginFact { status: 0, usesOrigin: false, placeIr: -1 }, typed) => interpolationOrigins!
                }
            callFunctionIndex.interpolationNextRoot[root!] => root!
        }
        interpolationOrigins! -> return
    }
    value.kind == 3 or value.kind == 4
        -> if {
            BorrowedTextOriginFact { status: 1, usesOrigin: false, placeIr: -1 } -> return
        }
    value.kind == 10 -> if {
        BorrowedTextOriginFact { status: 0, usesOrigin: false, placeIr: -1 } => formal!
        parameterLoans -> if {
            BorrowedTextOriginFact { status: 2, usesOrigin: valueIr == originIr, placeIr: -1 } => formal!
        } else {
            concrete -> if {
                BorrowedTextOriginFact { status: 2, usesOrigin: valueIr == originIr, placeIr: valueIr } => formal!
            }
        }
        typed -> borrowedTextStoredArrayOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, valueIr, originIr, active, depth) => stored
        formal! -> mergeBorrowedTextOrigin(stored, typed) -> return
    }
    value.kind == 5 -> if {
        prepared -> borrowedTextEachRoleCall(typed, types, valueIr) => roleCallIr
        roleCallIr >= 0 -> if {
            typed -> borrowedTextValueOrigin(prepared, types, roleCallIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, typed[roleCallIr].operand0, originIr, active, depth) -> return
        }
        value.operand0 >= 0 -> if {
            typed -> borrowedTextValueOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, value.operand0, originIr, active, depth) -> return
        }
        # Root-place and loan consumers share the same exact lexical identity.
        (typed -> borrowedTextFunctionIr(valueIr)) == -2
            -> if {
                BorrowedTextOriginFact { status: 3, usesOrigin: false, placeIr: -1 } -> return
            }
        typed -> resolvedFormalReadBinding(valueIr) => formalIr
        formalIr >= 0 -> if {
            typed -> borrowedTextValueOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, formalIr, originIr, active, depth) -> return
        }
        BorrowedTextOriginFact { status: 0, usesOrigin: false, placeIr: -1 } -> return
    }
    value.kind == 17 or value.kind == 29 -> if {
        typed -> borrowedTextScalarSlot(types, valueIr)
            -> if {
                BorrowedTextOriginFact { status: 1, usesOrigin: false, placeIr: -1 } => versions!
                false => queriedVersion!
                callFunctionIndex.scalarVersionHeads[value.symbol] => scalarVersionIr!
                scalarVersionIr! >= 0 -> while {
                    typed -> borrowedTextSameScalarSlot(types, valueIr, scalarVersionIr!)
                        -> if {
                            typed[scalarVersionIr!] => scalarVersion
                            prepared -> borrowedTextScalarDeclaration(typed, types, callFunctionIndex, scalarVersionIr!) => slotDeclarationIr
                            slotDeclarationIr < 0 and querySiteIr >= 0 and querySiteIr < (typed -> len)
                                and scalarVersion.sourceModule == typed[querySiteIr].sourceModule
                                and (typed -> borrowedTextCommonLoop(scalarVersionIr!, querySiteIr)) >= 0
                                -> if {
                                    BorrowedTextOriginFact { status: 3, usesOrigin: false, placeIr: -1 } -> return
                                }
                            scalarVersion.operand0 >= 0 and scalarVersion.operand0 < (typed -> len)
                                and (prepared -> borrowedTextScalarVersionVisible(typed, types, callFunctionIndex, returnControls, scalarVersionIr!, querySiteIr))
                                and (prepared -> borrowedTextScalarVersionReaches(typed, types, returnControls, scalarVersionIr!, querySiteIr, callFunctionIndex.irIndex))
                                -> if {
                                    typed -> borrowedTextValueOrigin(prepared, types, scalarVersionIr!, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, scalarVersion.operand0, originIr, active, depth) => versionOrigin
                                    versions! -> mergeBorrowedTextOrigin(versionOrigin, typed) => versions!
                                    true => queriedVersion!
                                }
                        }
                    callFunctionIndex.scalarVersionNext[scalarVersionIr!] => scalarVersionIr!
                }
                queriedVersion! -> if { versions! -> return }
                prepared -> borrowedTextScalarVersionReaches(typed, types, returnControls, valueIr, querySiteIr, callFunctionIndex.irIndex)
                    -> unless { versions! -> return }
                querySiteIr != valueIr and not (prepared -> borrowedTextScalarVersionVisible(typed, types, callFunctionIndex, returnControls, valueIr, querySiteIr))
                    -> if { BorrowedTextOriginFact { status: 0, usesOrigin: false, placeIr: -1 } -> return }
                value.operand0 >= 0 -> if {
                    typed -> borrowedTextValueOrigin(prepared, types, valueIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, value.operand0, originIr, active, depth) -> return
                }
                BorrowedTextOriginFact { status: 0, usesOrigin: false, placeIr: -1 } -> return
            }
        concrete and value.typeOrigin == 1 and value.typeSymbol == 15
            -> if {
                BorrowedTextOriginFact { status: 2, usesOrigin: valueIr == originIr, placeIr: valueIr } -> return
            }
        value.operand0 >= 0 -> if {
            typed -> borrowedTextValueOrigin(prepared, types, valueIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, value.operand0, originIr, active, depth) => initializer
            typed -> borrowedTextStoredArrayOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, valueIr, originIr, active, depth) => stored
            initializer.status == 2 -> if { initializer -> mergeBorrowedTextOrigin(stored, typed) -> return }
            concrete and value.typeOrigin == 1 and value.typeSymbol == 24
                -> if {
                    # An owned SourceText with no upstream loan borrows its own
                    # storage when viewed as Text. Preserve that concrete place.
                    BorrowedTextOriginFact { status: 2, usesOrigin: valueIr == originIr, placeIr: valueIr } -> return
                }
            initializer -> mergeBorrowedTextOrigin(stored, typed) -> return
        }
        BorrowedTextOriginFact { status: 0, usesOrigin: false, placeIr: -1 } -> return
    }
    value.kind == 13 or value.kind == 15 or value.kind == 26 or value.kind == 36
        -> if {
            value.kind == 26 and value.operand0 < 0 -> if {
                BorrowedTextOriginFact { status: 1, usesOrigin: false, placeIr: -1 } -> return
            }
            typed -> borrowedTextValueOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, value.operand0, originIr, active, depth) -> return
        }
    value.kind == 30 or (value.kind == 7 and value.opcode == -27)
        -> if {
            # Try payload and a runtime box preserve the carried origin; type-only
            # box wrappers never occur as the selected runtime return operand.
            typed -> borrowedTextValueOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, value.operand0, originIr, active, depth) -> return
        }
    (value.kind == 9 or value.kind == 6) and value.opcode == -229
        -> if {
            # materialize explicitly creates a view into the caller-supplied Arena.
            # Whole-owner transfer suppresses synthetic storage frames, never this loan.
            typed -> borrowedTextConcreteOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, value.operand1, originIr, active, depth) -> return
        }
    (value.kind == 9 or value.kind == 6) and (value.opcode == -203 or value.opcode == -206 or value.opcode == -232)
        -> if {
            # SourceText runtime calls first try the exact concrete prefix place.
            value.opcode == -206 or value.opcode == -232 -> if {
                typed -> borrowedTextConcreteOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, value.operand0, originIr, active, depth) -> return
            }
            # Actual slice uses known loans before a concrete fallback.
            typed -> borrowedTextValueOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, value.operand0, originIr, active, depth) => prefix
            not parameterLoans and prefix.status == 0 -> if {
                typed -> borrowedTextConcreteOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, value.operand0, originIr, active, depth) -> return
            }
            prefix -> return
        }
    value.kind == 6 -> if {
        typed -> borrowedTextSelectedCallFunctionIr(contracts, callFunctionIndex, valueIr) => selectedFunction
        selectedFunction == -2 -> if { BorrowedTextOriginFact { status: 3, usesOrigin: false, placeIr: -1 } -> return }
        selectedFunction < 0 -> if { BorrowedTextOriginFact { status: 0, usesOrigin: false, placeIr: -1 } -> return }
        BorrowedTextOriginFact { status: 0, usesOrigin: false, placeIr: -1 } => mapped!
        0 => contractIndex!
        contractIndex! < (contracts -> len) -> while {
            contracts[contractIndex!] => contract
            selectedFunction == contract.functionIr
                -> if {
                    value.operand0 => argumentIr!
                    0 => ordinal!
                    argumentIr! >= 0 and argumentIr! < (typed -> len) and ordinal! < contract.parameterOrdinal
                        -> while {
                            typed[argumentIr!].nextOperand => argumentIr!
                            ordinal! + 1 => ordinal!
                        }
                    typed -> borrowedTextCallArgumentOrigin(prepared, types, valueIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, argumentIr!, originIr, contract, active, depth) => argumentOrigin
                    (not concrete or contract.concreteParameter) and argumentOrigin.status != 2
                        and not (contract.transfersOwner and argumentOrigin.status == 1)
                        -> if { argumentOrigin -> return }
                    mapped! -> mergeBorrowedTextOrigin(argumentOrigin, typed) => mapped!
                }
            contractIndex! + 1 => contractIndex!
        }
        mapped! -> return
    }
    value.kind == 12 or value.kind == 14 or value.kind == 16 or value.kind == 35
        -> if {
            # Aggregate union includes its direct value children; each child applies
            # its own replacement/call policy before contributing an origin.
            value.operand0 => child!
            0 => childCount!
            BorrowedTextOriginFact { status: 1, usesOrigin: false, placeIr: -1 } => union!
            child! >= 0 and child! < (typed -> len) and childCount! < (typed -> len)
                -> while {
                    typed[child!].typeId => childType
                    childType < 0 or childType >= (viewTypes -> len)
                        -> if { BorrowedTextOriginFact { status: 3, usesOrigin: false, placeIr: -1 } -> return }
                    viewTypes[childType] -> if {
                        typed -> borrowedTextValueOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, child!, originIr, active, depth) => childOrigin
                        union! -> mergeBorrowedTextOrigin(childOrigin, typed) => union!
                    }
                    typed[child!].nextOperand => child!
                    childCount! + 1 => childCount!
                }
            child! >= 0 -> if { BorrowedTextOriginFact { status: 3, usesOrigin: false, placeIr: -1 } -> return }
            union! -> return
        }
    value.kind == 18 -> if {
        # operand0 is the condition and supplies no returned view.
        querySiteIr => thenQueryIr!
        querySiteIr => elseQueryIr!
        querySiteIr == valueIr -> if {
            value.operand1 => thenQueryIr!
            value.nextOperand => elseQueryIr!
        }
        typed -> borrowedTextValueOrigin(prepared, types, thenQueryIr!, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, value.operand1, originIr, active, depth) => thenOrigin
        typed -> borrowedTextValueOrigin(prepared, types, elseQueryIr!, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, value.nextOperand, originIr, active, depth) => elseOrigin
        thenOrigin -> mergeBorrowedTextOrigin(elseOrigin, typed) -> return
    }
    value.kind == 19 -> if {
        typed -> borrowedTextRegionResultIr(valueIr) => result
        querySiteIr => resultQueryIr!
        querySiteIr == valueIr -> if { result => resultQueryIr! }
        typed -> borrowedTextValueOrigin(prepared, types, resultQueryIr!, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, result, originIr, active, depth) -> return
    }
    value.kind == 37 or value.kind == 38 or value.kind == 27 or value.kind == 33 or value.kind == 34
        -> if {
            value.operand0 => arm!
            value.kind == 27 or value.kind == 34 -> if { value.operand1 => arm! }
            BorrowedTextOriginFact { status: 0, usesOrigin: false, placeIr: -1 } => arms!
            0 => armCount!
            arm! >= 0 and arm! < (typed -> len) and armCount! < (typed -> len)
                -> while {
                    querySiteIr => armQueryIr!
                    querySiteIr == valueIr -> if { arm! => armQueryIr! }
                    typed -> borrowedTextValueOrigin(prepared, types, armQueryIr!, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, arm!, originIr, active, depth) => armOrigin
                    arms! -> mergeBorrowedTextOrigin(armOrigin, typed) => arms!
                    typed[arm!].nextOperand => arm!
                    armCount! + 1 => armCount!
                }
            arm! >= 0 -> if { BorrowedTextOriginFact { status: 3, usesOrigin: false, placeIr: -1 } -> return }
            arms! -> return
        }
    value.kind == 39 -> if {
        querySiteIr => armValueQueryIr!
        querySiteIr == valueIr -> if { value.operand1 => armValueQueryIr! }
        typed -> borrowedTextValueOrigin(prepared, types, armValueQueryIr!, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, value.operand1, originIr, active, depth) -> return
    }
    value.kind == 40 or value.kind == 43 -> if {
        typed -> borrowedTextValueOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, value.operand0, originIr, active, depth) -> return
    }
    value.kind == 9 and value.opcode == -1 and value.operand1 >= 0
        -> if {
            typed -> borrowedTextValueOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, parameterLoans, concrete, value.operand1, originIr, active, depth) -> return
        }
    BorrowedTextOriginFact { status: 0, usesOrigin: false, placeIr: -1 }
}

borrowedTextValueOriginFact typed: ref [typedIr.TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], querySiteIr: Int, storeSites: ref [Int; ~], returnControls: ref [Bool; ~], contracts: ref [BorrowedTextReturn; ~], callFunctionIndex: ref BorrowedTextCallFunctionIndex, viewTypes: ref [Bool; ~], concrete: Bool, valueIr: Int, originIr: Int -> BorrowedTextOriginFact {
    [Int; ~] => active!
    typed -> borrowedTextValueOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, true, concrete, valueIr, originIr, active!, 0)
}

borrowedTextReturnOriginFact typed: ref [typedIr.TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], querySiteIr: Int, storeSites: ref [Int; ~], returnControls: ref [Bool; ~], contracts: ref [BorrowedTextReturn; ~], callFunctionIndex: ref BorrowedTextCallFunctionIndex, viewTypes: ref [Bool; ~], valueIr: Int, originIr: Int -> BorrowedTextOriginFact {
    [Int; ~] => active!
    typed -> borrowedTextValueOrigin(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, false, false, valueIr, originIr, active!, 0)
}

borrowedTextValueUsesOrigin typed: ref [typedIr.TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], querySiteIr: Int, storeSites: ref [Int; ~], returnControls: ref [Bool; ~], contracts: ref [BorrowedTextReturn; ~], callFunctionIndex: ref BorrowedTextCallFunctionIndex, viewTypes: ref [Bool; ~], valueIr: Int, originIr: Int -> Bool {
    typed -> borrowedTextValueOriginFact(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, false, valueIr, originIr) => fact
    fact.status == 2 and fact.usesOrigin
}

borrowedTextValueUsesConcreteOrigin typed: ref [typedIr.TypedIrNode; ~], prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], querySiteIr: Int, storeSites: ref [Int; ~], returnControls: ref [Bool; ~], contracts: ref [BorrowedTextReturn; ~], callFunctionIndex: ref BorrowedTextCallFunctionIndex, viewTypes: ref [Bool; ~], valueIr: Int, originIr: Int -> Bool {
    typed -> borrowedTextValueOriginFact(prepared, types, querySiteIr, storeSites, returnControls, contracts, callFunctionIndex, viewTypes, true, valueIr, originIr) => fact
    fact.status == 2 and fact.usesOrigin
}

struct BorrowedTextBinding {
    bindingIr: Int
    ownerBindingIr: Int
    ownerPlaceIr: Int
}

struct MutableBorrowSite {
    siteIr: Int
    argumentIr: Int
}

struct ReadonlyReferenceReturn {
    sourceModule: Int
    functionSymbol: Int
    parameterOrdinal: Int
}

public struct ReadonlyReferenceLoan {
    public path: [ReadonlyReferencePathStep; ~]
}

cloneReadonlyReferencePath path: ref [ReadonlyReferencePathStep; ~] -> [ReadonlyReferencePathStep; ~] {
    [ReadonlyReferencePathStep; ~] => result!
    path -> each step { result! -> push(step) }
    result!
}

# Aggregate-return calls inherit their input origin union at every reference
# leaf, exactly as the managed compiler does. Literal calls already carry the
# field prefix selected by the initializer tree.
appendReadonlyReferenceLeafLoans prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], fields: ref [typeIds.NominalField; ~], typeId: Int, path: ref [ReadonlyReferencePathStep; ~], loans: mut [ReadonlyReferenceLoan; ~], depth: Int -> Unit {
    typeId < 0 or typeId >= (types -> len) or depth >= (types -> len)
        -> if { return }
    types[typeId] => valueType
    valueType.kind == 8 -> if {
        loans -> push(ReadonlyReferenceLoan { path: cloneReadonlyReferencePath(path) })
        return
    }
    valueType.kind == 7 and valueType.origin == 4
        and (valueType.symbol == 0 or valueType.symbol == 1)
        -> if {
            0 => payloadOrdinal!
            valueType.symbol == 1 -> if { 1 => payloadOrdinal! }
            cloneReadonlyReferencePath(path) => payloadPath!
            payloadPath! -> push(ReadonlyReferencePathStep {
                kind: 2, sourceModule: -1, nameToken: -1, ordinal: payloadOrdinal!
            })
            prepared -> appendReadonlyReferenceLeafLoans(types, fields, valueType.first, payloadPath!, loans, depth + 1)
            valueType.symbol == 1 -> if {
                cloneReadonlyReferencePath(path) => errorPath!
                errorPath! -> push(ReadonlyReferencePathStep {
                    kind: 2, sourceModule: -1, nameToken: -1, ordinal: 2
                })
                prepared -> appendReadonlyReferenceLeafLoans(types, fields, valueType.second, errorPath!, loans, depth + 1)
            }
            return
        }
    valueType.kind == 1 or valueType.kind == 10 -> if {
        loans -> len => initialCount
        fields -> each field {
            field.status == 0 and field.ownerType == typeId
                -> if {
                    field.labelToken => nameToken!
                    field.fieldSymbol >= 0 -> if {
                        prepared.package.ranges[field.sourceModule] => range
                        prepared.package.symbols[range.symbolStart + field.fieldSymbol].nameToken => nameToken!
                    }
                    cloneReadonlyReferencePath(path) => fieldPath!
                    fieldPath! -> push(ReadonlyReferencePathStep {
                        kind: nameToken! >= 0 -> if { 0 } else { 1 }
                        sourceModule: field.sourceModule
                        nameToken: nameToken!
                        ordinal: field.ordinal
                    })
                    prepared -> appendReadonlyReferenceLeafLoans(types, fields, field.fieldType, fieldPath!, loans, depth + 1)
                }
        }
        (loans -> len) > initialCount -> if { return }
    }
    # Other reference-bearing shapes retain their existing complete-carrier
    # loan. A missing field table must never silently discard an origin.
    prepared -> semanticTypeContainsReadonlyReference(types, typeId)
        -> if {
            loans -> push(ReadonlyReferenceLoan { path: cloneReadonlyReferencePath(path) })
        }
}

readonlyReferenceCallLoans prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], fields: ref [typeIds.NominalField; ~], carrierValueIr: Int, callIr: Int -> [ReadonlyReferenceLoan; ~] {
    [ReadonlyReferenceLoan; ~] => loans!
    [ReadonlyReferencePathStep; ~] => reversePath!
    callIr => current!
    0 => depth!
    current! != carrierValueIr and current! >= 0 and depth! < (typed -> len)
        -> while {
            typed[current!].parent => parentIr
            parentIr < 0 or parentIr >= (typed -> len) -> if { loans! -> return }
            typed[parentIr] => parent
            parent.kind == 6 and parent.typeId >= 0
                and not (prepared -> semanticTypeContainsReadonlyReference(types, parent.typeId))
                -> if { loans! -> return }
            (parent.kind == 12 or parent.kind == 35) and parent.astNode >= 0
                -> if {
                    prepared.package.ranges[parent.sourceModule] => range
                    typed[current!].astNode => fieldAst!
                    0 => fieldDepth!
                    fieldAst! >= 0 and fieldAst! < range.astCount
                        and prepared.package.nodes[range.astStart + fieldAst!].parent != parent.astNode
                        and fieldDepth! < range.astCount
                        -> while {
                            prepared.package.nodes[range.astStart + fieldAst!].parent => fieldAst!
                            fieldDepth! + 1 => fieldDepth!
                        }
                    fieldAst! >= 0 and fieldAst! < range.astCount
                        -> if {
                            prepared.package.nodes[range.astStart + fieldAst!] => field
                            0 => ordinal!
                            parent.operand0 => child!
                            child! >= 0 and child! != current! -> while {
                                typed[child!].nextOperand => child!
                                ordinal! + 1 => ordinal!
                            }
                            field.kind == 40 -> if {
                                reversePath! -> push(ReadonlyReferencePathStep {
                                    kind: 0, sourceModule: parent.sourceModule,
                                    nameToken: field.payloadToken, ordinal: ordinal!
                                })
                            }
                            field.kind == 72 -> if {
                                prepared.package.tokens -> typeTerms.productFieldLabelToken(range.tokenStart, field.firstToken, field.tokenCount) => labelToken
                                reversePath! -> push(ReadonlyReferencePathStep {
                                    kind: labelToken >= 0 -> if { 0 } else { 1 }
                                    sourceModule: parent.sourceModule
                                    nameToken: labelToken
                                    ordinal: ordinal!
                                })
                            }
                        }
                }
            parentIr => current!
            depth! + 1 => depth!
        }
    [ReadonlyReferencePathStep; ~] => path!
    reversePath! -> len => stepIndex!
    stepIndex! > 0 -> while {
        stepIndex! - 1 => stepIndex!
        path! -> push(reversePath![stepIndex!])
    }
    prepared -> appendReadonlyReferenceLeafLoans(types, fields, typed[callIr].typeId, path!, loans!, 0)
    loans!
}

readonlyReferencePathTouchesUse prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], useIr: Int, path: ref [ReadonlyReferencePathStep; ~] -> Bool {
    useIr => current!
