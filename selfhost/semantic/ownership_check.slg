    # Calls, control regions and non-literal expressions end that collection.
    aggregateForTransfer placeIr: Int, ownedStorage: mut [Int; ~] -> Int {
        placeIr < 0 or placeIr >= (typed -> len) -> if { -1 -> return }
        typed[placeIr].parent => parent!
        -1 => aggregate!
        0 => depth!
        parent! >= 0 and parent! < (typed -> len) and depth! < (typed -> len)
            -> while {
                typed[parent!] => node
                # C# collects array elements only for dynamic/bounded storage.
                # Fixed-array literals do not extend this recursive collector.
                node.kind == 14 -> if {
                    node.typeId >= 0 and node.typeId < (types -> len)
                        -> unless { aggregate! -> return }
                    types[node.typeId].kind != 3 and types[node.typeId].kind != 12
                        -> if { aggregate! -> return }
                }
                (node.kind == 12 or node.kind == 14 or node.kind == 16 or node.kind == 35)
                    and (prepared -> semanticTypeContainsOwnedStorageCached(types, fields, ownedStorage, node.typeId))
                    -> unless { aggregate! -> return }
                parent! => aggregate!
                node.parent => parent!
                depth! + 1 => depth!
            }
        depth! >= (typed -> len) -> if { -1 } else { aggregate! }
    }
    sameOwnedFieldPlace leftPlaceIr: Int, rightPlaceIr: Int -> Bool {
        leftPlaceIr -> placeRootBinding => leftRoot
        rightPlaceIr -> placeRootBinding => rightRoot
        leftPlaceIr => leftRootPlace!
        rightPlaceIr => rightRootPlace!
        0 => leftRootSteps!
        leftRootPlace! >= 0 and leftRootPlace! < (typed -> len)
            and leftRootSteps! < (typed -> len)
            and (typed[leftRootPlace!].kind == 13 or typed[leftRootPlace!].kind == 15)
            -> while {
                typed[leftRootPlace!].operand0 => nextLeftRoot
                nextLeftRoot == leftRootPlace! -> if { -1 => leftRootPlace! } else { nextLeftRoot => leftRootPlace! }
                leftRootSteps! + 1 => leftRootSteps!
            }
        0 => rightRootSteps!
        rightRootPlace! >= 0 and rightRootPlace! < (typed -> len)
            and rightRootSteps! < (typed -> len)
            and (typed[rightRootPlace!].kind == 13 or typed[rightRootPlace!].kind == 15)
            -> while {
                typed[rightRootPlace!].operand0 => nextRightRoot
                nextRightRoot == rightRootPlace! -> if { -1 => rightRootPlace! } else { nextRightRoot => rightRootPlace! }
                rightRootSteps! + 1 => rightRootSteps!
            }
        leftRoot >= 0 and leftRoot == rightRoot => sameRoot!
        leftRoot < 0 and rightRoot < 0
            and leftRootPlace! >= 0 and leftRootPlace! < (typed -> len)
            and rightRootPlace! >= 0 and rightRootPlace! < (typed -> len)
            -> if {
                typed[leftRootPlace!] => leftPlaceRoot
                typed[rightRootPlace!] => rightPlaceRoot
                leftPlaceRoot.kind == 5 and rightPlaceRoot.kind == 5
                    and leftPlaceRoot.sourceModule == rightPlaceRoot.sourceModule
                    and leftPlaceRoot.symbol >= 0
                    and leftPlaceRoot.symbol == rightPlaceRoot.symbol
                    and leftPlaceRoot.typeId == rightPlaceRoot.typeId
                    -> if { true => sameRoot! }
            }
        leftPlaceIr -> placeProjectionDepth => leftDepth
        rightPlaceIr -> placeProjectionDepth => rightDepth
        sameRoot! and leftDepth > 0 and leftDepth == rightDepth => same!
        0 => ordinal!
        same! and ordinal! < leftDepth -> while {
            leftPlaceIr -> placeProjectionAt(ordinal!) => leftProjectionIr
            rightPlaceIr -> placeProjectionAt(ordinal!) => rightProjectionIr
            leftProjectionIr >= 0 and rightProjectionIr >= 0
                -> if {
                    typed[leftProjectionIr] => leftProjection
                    typed[rightProjectionIr] => rightProjection
                    leftProjection.kind != 13 or rightProjection.kind != 13
                        or leftProjection.symbol < 0 or rightProjection.symbol < 0
                        or leftProjection.targetModule != rightProjection.targetModule
                        or leftProjection.symbol != rightProjection.symbol
                        -> if { false => same! }
                } else { false => same! }
            ordinal! + 1 => ordinal!
        }
        same!
    }
    placeOverlapsIndexedProjection placeIr: Int, indexIr: Int -> Bool {
        placeIr -> placeProjectionDepth => depth
        true => overlap!
        depth > 0 -> if {
            placeIr -> placeProjectionAt(0) => projectionIr
            typed[projectionIr] => projection
            projection.kind == 15
                and projection.operand1 >= 0
                and projection.operand1 < (typed -> len)
                and indexIr >= 0
                and indexIr < (typed -> len)
                -> if {
                    prepared -> constantIndexPlacesOverlap(typed, projection.operand1, indexIr) => sameIndex
                    not sameIndex -> if { false => overlap! }
                }
        }
        overlap!
    }
    nodeHasIdentifier nodeIndex: Int, expected: Text -> Bool {
        false => found!
        nodeIndex >= 0 and nodeIndex < (typed -> len)
            -> if {
                typed[nodeIndex] => candidate
                candidate.sourceModule >= 0
                    and candidate.sourceModule < (prepared.package.ranges -> len)
                    and candidate.astNode >= 0
                    -> if {
                        prepared.package.ranges[candidate.sourceModule] => candidateRange
                        candidate.astNode < candidateRange.astCount -> if {
                            prepared.package.nodes[candidateRange.astStart + candidate.astNode] => candidateAst
                            candidateAst.firstToken >= 0
                                and candidateAst.firstToken + candidateAst.tokenCount <= candidateRange.tokenCount
                                -> if {
                                    candidateAst.firstToken => tokenIndex!
                                    not found! and tokenIndex! < candidateAst.firstToken + candidateAst.tokenCount
                                        -> while {
                                            prepared.package.tokens[candidateRange.tokenStart + tokenIndex!] => token
                                            token.kind == grammar.tokenIdIdentifier() and token.span.length == (expected -> len)
                                                -> if {
                                                    true => sameIdentifier!
                                                    UIntSize(0) => identifierByte!
                                                    sameIdentifier! and identifierByte! < token.span.length
                                                        -> while {
                                                            (prepared.package.sources[candidate.sourceModule] -> byte(token.span.start + identifierByte!)) != (expected -> byte(identifierByte!))
                                                                -> if { false => sameIdentifier! }
                                                            identifierByte! + 1 => identifierByte!
                                                        }
                                                    sameIdentifier! -> if { true => found! }
                                                }
                                            tokenIndex! + 1 => tokenIndex!
                                        }
                                }
                        }
                    }
            }
        found!
    }
