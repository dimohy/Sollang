                prepared.package.ranges[step.sourceModule] => range
                prepared.package.tokens[range.tokenStart + step.nameToken] => expected
                prepared.package.sources[step.sourceModule] -> slice(expected.span.start, expected.span.length) => expectedName
                selectedName != expectedName -> if { false -> return }
            } else {
                not (selectedName -> typeIds.structuralFieldNameMatches(0, length, step.ordinal))
                    -> if { false -> return }
            }
            stepIndex! + 1 => stepIndex!
        }
