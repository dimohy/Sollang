                    and (prepared -> semanticTypeContainsOwnedStorageCached(types, fields, ownedStorageByType!, typed[ownedEscapeFunctionIr!].typeId)))) and not ownedEscapeRoleDiagnosed!
                    and ownedEscapeFunctionIr! >= 0 and ownedEscapeBorrowedBinding >= 0
