namespace sollang.compiler.semantic.ownership_check

import sollang.compiler.ast as ast
import sollang.compiler.ir.interpolation as interpolation
import sollang.compiler.ir.typed as typedIr
import sollang.compiler.lexer as lexer
import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.symbols as symbols
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.syntax as syntax
import syntax.generated.slg as grammar

public struct OwnershipDiagnostic {
    public code: Int
    public sourceModule: Int
    public functionSymbol: Int
    public expectedOrigin: Int
    public expectedModule: Int
    public expectedSymbol: Int
    public actualOrigin: Int
    public actualModule: Int
    public actualSymbol: Int
    public actualBuiltin: Int
    public span: syntax.SourceSpan
}

struct BorrowedTextReturn {
    sourceModule: Int
    functionSymbol: Int
    parameterOrdinal: Int
    transfersOwner: Bool
}

struct BorrowedTextBinding {
    bindingIr: Int
    ownerBindingIr: Int
    ownerPlaceIr: Int
}

struct MutableBorrowSite {
    siteIr: Int
    argumentIr: Int
}

struct ReadonlyReferenceReturn {
    sourceModule: Int
    functionSymbol: Int
    parameterOrdinal: Int
}

semanticTypeContainsOwnedStorage prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], typeId: Int -> Bool {
    [Int; ~] => pending!
    [Int; ~] => visited!
    false => contains!
    typeId >= 0 -> if { pending! -> push(typeId) }
    0 => pendingIndex!
    not contains! and pendingIndex! < (pending! -> len)
        -> while {
            pending![pendingIndex!] => currentTypeId
            false => seen!
            0 => seenIndex!
            seenIndex! < (visited! -> len) -> while {
                visited![seenIndex!] == currentTypeId -> if { true => seen! }
                seenIndex! + 1 => seenIndex!
            }
            not seen! and currentTypeId >= 0 and currentTypeId < (types -> len)
                -> if {
                    visited! -> push(currentTypeId)
                    types[currentTypeId] => current
                    current.kind == 3
                        or current.kind == 5
                        or current.kind == 6
                        or current.kind == 9
                        or current.kind == 12
                        or current.kind == 13
                        or (current.kind == 1 and current.origin == 1 and (current.symbol == 15 or current.symbol == 17 or current.symbol == 18 or current.symbol == 24))
                        or (current.kind == 7 and current.origin == 4 and (current.symbol == 3 or current.symbol == 4 or current.symbol == 5 or current.symbol == 6 or current.symbol == 7))
                        -> if {
                            true => contains!
                        } else {
                            # Fixed arrays carry inline value storage; only affine
                            # elements make their copies ownership-sensitive.
                            current.kind == 4 or current.kind == 7 -> if {
                                current.first >= 0 -> if { pending! -> push(current.first) }
                                current.second >= 0 -> if { pending! -> push(current.second) }
                            }
                            current.kind == 1 and (current.origin == 0 or current.origin == 2)
                                -> if {
                                    prepared -> semanticContext.nominalIsOwnedResource(currentTypeId)
                                        -> if {
                                            true => contains!
                                        } else {
                                            0 => fieldIndex!
                                            fieldIndex! < (prepared.semantic.fields -> len)
                                                -> while {
                                                    prepared.semantic.fields[fieldIndex!] => field
                                                    field.status == 0 and field.ownerType == currentTypeId and field.fieldType >= 0
                                                        -> if { pending! -> push(field.fieldType) }
                                                    fieldIndex! + 1 => fieldIndex!
                                                }
                                        }
                                }
                        }
                }
            pendingIndex! + 1 => pendingIndex!
        }
    contains!
}

semanticTypeContainsReadonlyReference prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], typeId: Int -> Bool {
    prepared -> semanticTypeContainsBorrowKind(types, typeId, 8)
}
semanticTypeContainsBorrowKind prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], typeId: Int, borrowKind: Int -> Bool {
    [Int; ~] => pending!
    [Int; ~] => visited!
    false => contains!
    typeId >= 0 -> if { pending! -> push(typeId) }
    0 => pendingIndex!
    not contains! and pendingIndex! < (pending! -> len)
        -> while {
            pending![pendingIndex!] => currentTypeId
            false => seen!
            0 => seenIndex!
            seenIndex! < (visited! -> len) -> while {
                visited![seenIndex!] == currentTypeId -> if { true => seen! }
                seenIndex! + 1 => seenIndex!
            }
            not seen! and currentTypeId >= 0 and currentTypeId < (types -> len)
                -> if {
                    visited! -> push(currentTypeId)
                    types[currentTypeId] => currentType
                    currentType.kind == borrowKind -> if {
                        true => contains!
                    } else {
                        currentType.kind == 1 -> if {
                            currentType.module => ownerSourceModule!
                            currentType.origin == 2 -> if {
                                currentType.module >= 0 and currentType.module < (prepared.modules -> len)
                                    -> if {
                                        prepared.modules[currentType.module].sourceIndex => ownerSourceModule!
                                    }
                            }
                            -1 => ownerDeclarationAst!
                            ownerSourceModule! >= 0 and ownerSourceModule! < (prepared.package.ranges -> len)
                                -> if {
                                    prepared.package.ranges[ownerSourceModule!] => ownerRange
                                    currentType.symbol >= 0 and currentType.symbol < ownerRange.symbolCount
                                        -> if {
                                            prepared.package.symbols[ownerRange.symbolStart + currentType.symbol] => ownerSymbol
                                            ownerSymbol.astNode >= 0 -> if { ownerSymbol.astNode => ownerDeclarationAst! }
                                        }
                                }
                            false => ownerIsEnum!
                            ownerDeclarationAst! >= 0 -> if {
                                prepared.package.ranges[ownerSourceModule!] => ownerRange
                                prepared.package.nodes[ownerRange.astStart + ownerDeclarationAst!].kind == 4
                                    -> if { true => ownerIsEnum! }
                            }
                            ownerIsEnum! -> if {
                                0 => payloadReferenceIndex!
                                payloadReferenceIndex! < (prepared.semantic.references -> len)
                                    -> while {
                                        prepared.semantic.references[payloadReferenceIndex!] => payloadReference
                                        payloadReference.status == 0 and payloadReference.sourceModule == ownerSourceModule! and payloadReference.typeAst >= 0
                                            -> if {
                                                payloadReference.typeAst => payloadAncestor!
                                                false => payloadBelongs!
                                                prepared.package.ranges[ownerSourceModule!] => payloadRange
                                                payloadAncestor! >= 0 and payloadAncestor! < payloadRange.astCount and not payloadBelongs!
                                                    -> while {
                                                        prepared.package.nodes[payloadRange.astStart + payloadAncestor!] => payloadNode
                                                        payloadNode.kind == 27 and payloadNode.parent == ownerDeclarationAst!
                                                            -> if {
                                                                true => payloadBelongs!
                                                            } else {
                                                                payloadNode.parent => payloadAncestor!
                                                            }
                                                    }
                                                payloadBelongs! -> if { pending! -> push(payloadReference.typeId) }
                                            }
                                        payloadReferenceIndex! + 1 => payloadReferenceIndex!
                                    }
                            } else {
                                0 => fieldIndex!
                                fieldIndex! < (prepared.semantic.fields -> len)
                                    -> while {
                                        prepared.semantic.fields[fieldIndex!] => field
                                        field.status == 0 and field.ownerType == currentTypeId
                                            -> if {
                                                pending! -> push(field.fieldType)
                                            }
                                        fieldIndex! + 1 => fieldIndex!
                                    }
                            }
                        } else {
                            currentType.kind == 2 or currentType.kind == 3 or currentType.kind == 4 or currentType.kind == 6 or currentType.kind == 8 or currentType.kind == 12
                                -> if {
                                    pending! -> push(currentType.first)
                                } else {
                                    currentType.kind == 5 or currentType.kind == 13
                                        -> if {
                                            pending! -> push(currentType.first)
                                            pending! -> push(currentType.second)
                                        }
                                }
                        }
                    }
                }
            pendingIndex! + 1 => pendingIndex!
        }
    contains!
}

readonlyCarrierUseTouchesReference prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], typed: ref [typedIr.TypedIrNode; ~], useIndex: Int, carrierTypeId: Int -> Bool {
    true => touches!
    carrierTypeId >= 0 and useIndex >= 0 and useIndex < (typed -> len)
        -> if {
            useIndex => projectedUse!
            typed[projectedUse!].parent => projectedParent!
            false => projected!
            projectedParent! >= 0 and projectedParent! < (typed -> len) and typed[projectedParent!].kind == 13 and typed[projectedParent!].operand0 == projectedUse!
                -> while {
                    true => projected!
                    projectedParent! => projectedUse!
                    typed[projectedUse!].parent => projectedParent!
                }
            projected! -> if {
                prepared -> semanticTypeContainsReadonlyReference(types, typed[projectedUse!].typeId) => touches!
            }
        }
    touches!
}

typedNodeContainsReadonlyReference prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], typed: ref [typedIr.TypedIrNode; ~], nodeIndex: Int -> Bool {
    false => contains!
    nodeIndex >= 0 and nodeIndex < (typed -> len)
        -> if {
            typed[nodeIndex] => candidate
            candidate.typeId >= 0 and candidate.typeId < (types -> len)
                -> if {
                    prepared -> semanticTypeContainsReadonlyReference(types, candidate.typeId) => contains!
                } else {
                    candidate.typeKind == 1 -> if {
                        candidate.typeModule => ownerSourceModule!
                        candidate.typeOrigin == 2 -> if {
                            candidate.typeModule >= 0 and candidate.typeModule < (prepared.modules -> len)
                                -> if { prepared.modules[candidate.typeModule].sourceIndex => ownerSourceModule! }
                        }
                        -1 => ownerDeclarationAst!
                        ownerSourceModule! >= 0 and ownerSourceModule! < (prepared.package.ranges -> len)
                            -> if {
                                prepared.package.ranges[ownerSourceModule!] => ownerRange
                                candidate.typeSymbol >= 0 and candidate.typeSymbol < ownerRange.symbolCount
                                    -> if {
                                        prepared.package.symbols[ownerRange.symbolStart + candidate.typeSymbol] => ownerSymbol
                                        ownerSymbol.astNode >= 0 -> if { ownerSymbol.astNode => ownerDeclarationAst! }
                                    }
                                ownerDeclarationAst! >= 0 and prepared.package.nodes[ownerRange.astStart + ownerDeclarationAst!].kind == 4
                                    -> if {
                                        0 => payloadReferenceIndex!
                                        not contains! and payloadReferenceIndex! < (prepared.semantic.references -> len)
                                            -> while {
                                                prepared.semantic.references[payloadReferenceIndex!] => payloadReference
                                                payloadReference.status == 0 and payloadReference.sourceModule == ownerSourceModule! and payloadReference.typeAst >= 0
                                                    -> if {
                                                        payloadReference.typeAst => payloadAncestor!
                                                        false => payloadBelongs!
                                                        payloadAncestor! >= 0 and payloadAncestor! < ownerRange.astCount and not payloadBelongs!
                                                            -> while {
                                                                prepared.package.nodes[ownerRange.astStart + payloadAncestor!] => payloadNode
                                                                payloadNode.kind == 27 and payloadNode.parent == ownerDeclarationAst!
                                                                    -> if { true => payloadBelongs! } else { payloadNode.parent => payloadAncestor! }
                                                            }
                                                        payloadBelongs! and (prepared -> semanticTypeContainsReadonlyReference(types, payloadReference.typeId))
                                                            -> if { true => contains! }
                                                    }
                                                payloadReferenceIndex! + 1 => payloadReferenceIndex!
                                            }
                                    }
                            }
                    }
                }
            not contains! and candidate.kind == 6 and candidate.typeKind == 8
                -> if { true => contains! }
            # A collection literal may reach this check before its recursive
            # collection type id is repaired. Inspect its direct element nodes as
            # a fallback; enum constructors and reference-bearing calls already
            # carry their concrete element type ids at this point.
            not contains! and (candidate.kind == 12 or candidate.kind == 14 or candidate.kind == 16 or candidate.kind == 26 or candidate.typeKind == 5 or candidate.typeKind == 12 or candidate.typeKind == 13 or (candidate.kind == 6 and candidate.typeKind == 8))
                -> if {
                    0 => aggregateChildIndex!
                    not contains! and aggregateChildIndex! < (typed -> len)
                        -> while {
                            typed[aggregateChildIndex!].parent == nodeIndex
                                -> if {
                                    prepared -> typedNodeContainsReadonlyReference(types, typed, aggregateChildIndex!)
                                        -> if { true => contains! }
                                }
                            aggregateChildIndex! + 1 => aggregateChildIndex!
                        }
                }
        }
    contains!
}

# Code 17 identifies whole-owner or overlapping-field use after a partial move.
# Code 18 identifies a mutable binding captured by a parallel callback.
# Code 19 identifies a structurally non-sendable parallel callback capture.
# Code 20 identifies a branch or loop that exits with a partially moved path.
# Code 21 identifies an origin moved while a returned borrowed Text is live.
# Code 22 identifies a readonly-reference argument without stable storage.
# Code 24 identifies a second terminal use of an affine Stream/EventStream.
# Code 27 identifies an owned block-function result without an explicit result
# binding. It mirrors the managed front-end rule and blocks LLVM emission.
# The view region ends at its last typed-IR use rather than at lexical scope end.
indexAssignmentTargetsBinding prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], assignmentIr: Int, bindingIr: Int -> Bool {
    false => same!
    assignmentIr >= 0 and assignmentIr < (typed -> len) and bindingIr >= 0 and bindingIr < (typed -> len)
        -> if {
            typed[assignmentIr] => assignment
            typed[bindingIr] => binding
            assignment.kind == 24 and assignment.sourceModule == binding.sourceModule and assignment.astNode >= 0 and assignment.sourceModule >= 0 and assignment.sourceModule < (prepared.package.ranges -> len)
                -> if {
                    prepared.package.ranges[assignment.sourceModule] => sourceRange
                    assignment.astNode < sourceRange.astCount and binding.payloadToken >= 0
                        -> if {
                            prepared.package.nodes[sourceRange.astStart + assignment.astNode] => assignmentAst
                            assignmentAst.kind == 53 and assignmentAst.payloadToken >= 0
                                -> if {
                                    prepared.package.tokens[sourceRange.tokenStart + assignmentAst.payloadToken] => assignmentName
                                    prepared.package.tokens[sourceRange.tokenStart + binding.payloadToken] => bindingName
                                    assignmentName.span.length == bindingName.span.length => same!
                                    UIntSize(0) => nameByte!
                                    same! and nameByte! < assignmentName.span.length
                                        -> while {
                                            (prepared.package.sources[assignment.sourceModule] -> byte(assignmentName.span.start + nameByte!)) != (prepared.package.sources[binding.sourceModule] -> byte(bindingName.span.start + nameByte!))
                                                -> if { false => same! }
                                            nameByte! + 1 => nameByte!
                                        }
                                }
                        }
                }
        }
    same!
}

indexedReferenceOverlapsAssignment prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], placeIr: Int, indexIr: Int -> Bool {
    true => overlap!
    placeIr >= 0 and placeIr < (typed -> len) and indexIr >= 0 and indexIr < (typed -> len)
        -> if {
            placeIr + 0 => indexedPlaceIr!
            indexedPlaceIr! >= 0 and indexedPlaceIr! < (typed -> len) and typed[indexedPlaceIr!].kind == 13
                -> while {
                    typed[indexedPlaceIr!].operand0 => indexedPlaceIr!
                }
            typed[indexedPlaceIr!] => place
            place.kind == 15 and place.operand1 >= 0 and place.operand1 < (typed -> len)
                -> if {
                    typed[place.operand1] => borrowedIndex
                    typed[indexIr] => assignedIndex
                    borrowedIndex.kind == 3 and assignedIndex.kind == 3 and borrowedIndex.payloadToken >= 0 and assignedIndex.payloadToken >= 0
                        -> if {
                            prepared.package.ranges[borrowedIndex.sourceModule] => borrowedRange
                            prepared.package.ranges[assignedIndex.sourceModule] => assignedRange
                            prepared.package.tokens[borrowedRange.tokenStart + borrowedIndex.payloadToken] => borrowedToken
                            prepared.package.tokens[assignedRange.tokenStart + assignedIndex.payloadToken] => assignedToken
                            borrowedToken.span.length == assignedToken.span.length => overlap!
                            UIntSize(0) => indexByte!
                            overlap! and indexByte! < borrowedToken.span.length
                                -> while {
                                    (prepared.package.sources[borrowedIndex.sourceModule] -> byte(borrowedToken.span.start + indexByte!)) != (prepared.package.sources[assignedIndex.sourceModule] -> byte(assignedToken.span.start + indexByte!))
                                        -> if { false => overlap! }
                                    indexByte! + 1 => indexByte!
                                }
                        }
                }
        }
    overlap!
}

referenceBindingUsedAfterIndexSite prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], bindingIr: Int, siteIr: Int -> Bool {
    false => used!
    bindingIr >= 0 and siteIr >= 0 and siteIr < (typed -> len)
        -> if {
            typed[siteIr] => site
            site.sourceModule >= 0 and site.sourceModule < (prepared.package.ranges -> len) and site.astNode >= 0
                -> if {
                    prepared.package.ranges[site.sourceModule] => useRange
                    site.astNode < useRange.astCount -> if {
                        prepared.package.nodes[useRange.astStart + site.astNode].start => siteStart
                        0 => useIndex!
                        not used! and useIndex! < (typed -> len) -> while {
                            typed[useIndex!] => use
                            use.kind == 5 and use.sourceModule == site.sourceModule and use.astNode >= 0 and use.astNode < useRange.astCount and use.operand0 == bindingIr
                                -> if {
                                    prepared.package.nodes[useRange.astStart + use.astNode].start > siteStart
                                        -> if { true => used! }
                                }
                            useIndex! + 1 => useIndex!
                        }
                    }
                }
        }
    used!
}

referenceForwardUseReachable prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], moveIndex: Int, useIndex: Int -> Bool {
    false => exclusive!
    moveIndex => moveAncestor!
    moveAncestor! >= 0 and moveAncestor! < (typed -> len) and not exclusive!
        -> while {
            typed[moveAncestor!] => moveAncestorNode
            moveAncestorNode.kind == 19 -> if {
                moveAncestorNode.parent >= 0 -> if {
                    moveAncestorNode.parent < (typed -> len) -> if {
                        typed[moveAncestorNode.parent].kind == 18 or typed[moveAncestorNode.parent].kind == 27
                            -> if {
                                useIndex => useAncestor!
                                useAncestor! >= 0 and useAncestor! < (typed -> len) and typed[useAncestor!].parent != moveAncestorNode.parent
                                    -> while {
                                        typed[useAncestor!].parent => useAncestor!
                                    }
                                useAncestor! >= 0 and useAncestor! < (typed -> len) and useAncestor! != moveAncestor! and typed[useAncestor!].kind == 19
                                    -> if {
                                        true => exclusive!
                                    }
                            }
                    }
                }
                not exclusive! and moveAncestorNode.sourceModule >= 0 and moveAncestorNode.sourceModule < (prepared.package.ranges -> len) and moveAncestorNode.astNode >= 0
                    -> if {
                        prepared.package.ranges[moveAncestorNode.sourceModule] => moveAncestorRange
                        moveAncestorNode.astNode < moveAncestorRange.astCount
                            -> if {
                                prepared.package.nodes[moveAncestorRange.astStart + moveAncestorNode.astNode].kind == 58
                                    -> if {
                                        moveAncestorNode.nextOperand => nextAlternative
                                        nextAlternative >= 0 and nextAlternative < (typed -> len)
                                            -> if {
                                                useIndex => alternativeUseAncestor!
                                                false => useInAlternative!
                                                alternativeUseAncestor! >= 0 and alternativeUseAncestor! < (typed -> len) and not useInAlternative!
                                                    -> while {
                                                        alternativeUseAncestor! == nextAlternative -> if {
                                                            true => useInAlternative!
                                                        } else {
                                                            typed[alternativeUseAncestor!].parent => alternativeUseAncestor!
                                                        }
                                                    }
                                                useInAlternative! -> if { true => exclusive! }
                                            }
                                    }
                            }
                    }
            }
            moveAncestorNode.parent => moveAncestor!
        }
    exclusive! -> if {
        false
    } else {
        moveIndex => moveRegion!
        moveRegion! >= 0 and moveRegion! < (typed -> len) and typed[moveRegion!].kind != 19 and typed[moveRegion!].kind != 20
            -> while {
                typed[moveRegion!].parent => moveRegion!
            }
        prepared.package.ranges[typed[moveIndex].sourceModule] => reachabilityRange
        prepared.package.nodes[reachabilityRange.astStart + typed[moveIndex].astNode].start => moveStart
        prepared.package.nodes[reachabilityRange.astStart + typed[useIndex].astNode].start => useStart
        false => stopped!
        0 => exitIndex!
        not stopped! and exitIndex! < (typed -> len)
            -> while {
                typed[exitIndex!] => exitCandidate
                exitCandidate.sourceModule == typed[moveIndex].sourceModule and exitCandidate.astNode >= 0 and (exitCandidate.kind == 23 or (exitCandidate.kind == 21 and exitCandidate.opcode == 0))
                    -> if {
                        exitIndex! => exitRegion!
                        exitRegion! >= 0 and exitRegion! < (typed -> len) and typed[exitRegion!].kind != 19 and typed[exitRegion!].kind != 20
                            -> while {
                                typed[exitRegion!].parent => exitRegion!
                            }
                        exitRegion! == moveRegion! -> if {
                            prepared.package.nodes[reachabilityRange.astStart + exitCandidate.astNode].start => exitStart
                            moveStart < exitStart and exitStart < useStart
                                -> if { true => stopped! }
                        }
                    }
                exitIndex! + 1 => exitIndex!
            }
        not stopped!
    }
}

public analyze sources: [Text; ~] -> [OwnershipDiagnostic; ~] {
    sources -> semanticContext.prepare => prepared
    prepared -> analyzeContext
}

public analyzeContext prepared: ref semanticContext.SemanticSnapshot -> [OwnershipDiagnostic; ~] {
    prepared -> typedIr.lowerContext => typed
    prepared -> analyzeLoweredContext(typed)
}

# Ownership is a read-only consumer of the canonical typed IR. The compiler
# driver lowers once and shares the same value with validation and LLVM output.
public analyzeLoweredContext prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~] -> [OwnershipDiagnostic; ~] {
    prepared -> analyzeResolvedLoweredContext(typed, prepared.semantic.types)
}

# Specializations append concrete types; ownership must use the same table as IR.
public analyzeResolvedLoweredContext prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~] -> [OwnershipDiagnostic; ~] {
    moveRegionFor nodeIndex: Int -> Int {
        typed[nodeIndex].parent => region!
        region! >= 0 and typed[region!].kind != 1 and typed[region!].kind != 11 and typed[region!].kind != 19 and typed[region!].kind != 20
            -> while {
                typed[region!].parent => region!
            }
        region!
    }
    nodeBelongsTo nodeIndex: Int, ancestorIndex: Int -> Bool {
        nodeIndex => ancestor!
        false => belongs!
        ancestor! >= 0 and ancestor! < (typed -> len) and not belongs!
            -> while {
                ancestor! == ancestorIndex -> if {
                    true => belongs!
                } else {
                    typed[ancestor!].parent => ancestor!
                }
            }
        belongs!
    }
    # Structured parallel callbacks borrow captures and join before the parent
    # resumes. SourceText is an immutable shared view here (Sync-like), not an
    # async ownership transfer (Send-like). Other affine runtime owners remain
    # rejected, including Arena, Arguments, and mapped byte views.
    parallelTypeIsSourceText typeId: Int -> Bool {
        false => sourceText!
        typeId >= 0 and typeId < (types -> len)
            -> if {
                types[typeId] => candidate
                candidate.kind == 1 and candidate.origin == 1 and candidate.symbol == 24
                    -> if {
                        true => sourceText!
                    } else {
                        candidate.kind == 1 and (candidate.origin == 0 or candidate.origin == 2)
                            -> if {
                                candidate.module => sourceModule!
                                candidate.origin == 2 and candidate.module >= 0 and candidate.module < (prepared.modules -> len)
                                    -> if {
                                        prepared.modules[candidate.module].sourceIndex => sourceModule!
                                    }
                                false => fileNamespace!
                                0 => moduleIndex!
                                moduleIndex! < (prepared.modules -> len) -> while {
                                    prepared.modules[moduleIndex!] => identity
                                    identity.sourceIndex == sourceModule! -> if {
                                        identity.pathLength == 8 => sameNamespace!
                                        "sys.file" => expectedNamespace
                                        UIntSize(0) => namespaceByte!
                                        sameNamespace! and namespaceByte! < identity.pathLength
                                            -> while {
                                                (prepared.package.sources[identity.sourceIndex] -> byte(identity.pathStart + namespaceByte!)) != (expectedNamespace -> byte(namespaceByte!))
                                                    -> if {
                                                        false => sameNamespace!
                                                    }
                                                namespaceByte! + 1 => namespaceByte!
                                            }
                                        sameNamespace! -> if { true => fileNamespace! }
                                    }
                                    moduleIndex! + 1 => moduleIndex!
                                }
                                fileNamespace! and sourceModule! >= 0 and sourceModule! < (prepared.package.ranges -> len)
                                    -> if {
                                        prepared.package.ranges[sourceModule!] => sourceRange
                                        candidate.symbol >= 0 and candidate.symbol < sourceRange.symbolCount
                                            -> if {
                                                prepared.package.symbols[sourceRange.symbolStart + candidate.symbol] => declaration
                                                declaration.kind == 3 and declaration.parent < 0 and declaration.nameToken >= 0
                                                    -> if {
                                                        prepared.package.tokens[sourceRange.tokenStart + declaration.nameToken] => name
                                                        name.span.length == 10 => sameName!
                                                        "SourceText" => expectedName
                                                        UIntSize(0) => nameByte!
                                                        sameName! and nameByte! < name.span.length -> while {
                                                            (prepared.package.sources[sourceModule!] -> byte(name.span.start + nameByte!)) != (expectedName -> byte(nameByte!))
                                                                -> if {
                                                                    false => sameName!
                                                                }
                                                            nameByte! + 1 => nameByte!
                                                        }
                                                        sameName! -> if { true => sourceText! }
                                                    }
                                            }
                                    }
                            }
                    }
            }
        sourceText!
    }
    captureBindingIsParallelShareable bindingIndex: Int -> Bool {
        typed[bindingIndex] => binding
        [Int; ~] => pendingTypes!
        [Int; ~] => visitedTypes!
        true => shareable!
        binding.typeId >= 0 -> if {
            pendingTypes! -> push(binding.typeId)
        } else {
            binding.typeOrigin == 1 and (binding.typeSymbol == 15 or binding.typeSymbol == 17 or binding.typeSymbol == 18)
                -> if { false => shareable! }
        }
        0 => pendingTypeIndex!
        shareable! and pendingTypeIndex! < (pendingTypes! -> len)
            -> while {
                pendingTypes![pendingTypeIndex!] => pendingTypeId
                false => typeVisited!
                0 => visitedTypeIndex!
                visitedTypeIndex! < (visitedTypes! -> len) -> while {
                    visitedTypes![visitedTypeIndex!] == pendingTypeId
                        -> if { true => typeVisited! }
                    visitedTypeIndex! + 1 => visitedTypeIndex!
                }
                not typeVisited! -> if {
                    visitedTypes! -> push(pendingTypeId)
                    pendingTypeId < 0 or pendingTypeId >= (types -> len)
