                -> if { true -> return }
            cursor! + 1 => start
            start => cursor!
            cursor! < memberEnd! and (prepared.package.sources[sourceModule] -> byte(cursor!)) != 46
                -> while { cursor! + 1 => cursor! }
            cursor! - start => length
            prepared.package.sources[sourceModule] -> slice(start, length) => selectedName
