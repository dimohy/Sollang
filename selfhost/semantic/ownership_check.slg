                }
        }
    contains!
}

# Code 17 identifies whole-owner or overlapping-field use after a partial move.
# Code 18 identifies a mutable binding captured by a parallel callback.
# Code 19 identifies a structurally non-sendable parallel callback capture.
# Code 20 identifies a branch or loop that exits with a partially moved path.
# Code 21 identifies an origin moved while a returned borrowed Text is live.
# Code 22 identifies a readonly-reference argument without stable storage.
# Code 24 identifies a second terminal use of an affine Stream/EventStream.
# Code 27 identifies an owned block-function result without an explicit result
# binding. It mirrors the managed front-end rule and blocks LLVM emission.
# The view region ends at its last typed-IR use rather than at lexical scope end.
indexAssignmentTargetsBinding prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], assignmentIr: Int, bindingIr: Int -> Bool {
    false => same!
    assignmentIr >= 0 and assignmentIr < (typed -> len) and bindingIr >= 0 and bindingIr < (typed -> len)
        -> if {
            typed[assignmentIr] => assignment
            typed[bindingIr] => binding
            assignment.kind == 24 and assignment.sourceModule == binding.sourceModule and assignment.astNode >= 0 and assignment.sourceModule >= 0 and assignment.sourceModule < (prepared.package.ranges -> len)
                -> if {
                    prepared.package.ranges[assignment.sourceModule] => sourceRange
                    assignment.astNode < sourceRange.astCount and binding.payloadToken >= 0
                        -> if {
                            prepared.package.nodes[sourceRange.astStart + assignment.astNode] => assignmentAst
                            assignmentAst.kind == 53 and assignmentAst.payloadToken >= 0
                                -> if {
                                    prepared.package.tokens[sourceRange.tokenStart + assignmentAst.payloadToken] => assignmentName
                                    prepared.package.tokens[sourceRange.tokenStart + binding.payloadToken] => bindingName
                                    assignmentName.span.length == bindingName.span.length => same!
                                    UIntSize(0) => nameByte!
                                    same! and nameByte! < assignmentName.span.length
                                        -> while {
                                            (prepared.package.sources[assignment.sourceModule] -> byte(assignmentName.span.start + nameByte!)) != (prepared.package.sources[binding.sourceModule] -> byte(bindingName.span.start + nameByte!))
                                                -> if { false => same! }
                                            nameByte! + 1 => nameByte!
                                        }
                                }
                        }
                }
        }
    same!
}

# Decimal index identity is numeric, independent of separators and leading zeroes.
# Dynamic indices conservatively overlap; comparison never narrows into Long.
constantIndexPlacesOverlap prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], leftIr: Int, rightIr: Int -> Bool {
    leftIr < 0 or leftIr >= (typed -> len) or rightIr < 0 or rightIr >= (typed -> len)
        -> if { true -> return }
    leftIr => leftIndex!
    rightIr => rightIndex!
    false => leftNegative!
    false => rightNegative!
    typed[leftIndex!].kind == 7 and typed[leftIndex!].opcode == grammar.tokenIdMinus()
        and typed[leftIndex!].operand0 >= 0 and typed[leftIndex!].operand0 < (typed -> len)
        -> if { true => leftNegative!
            typed[leftIndex!].operand0 => leftIndex! }
    typed[rightIndex!].kind == 7 and typed[rightIndex!].opcode == grammar.tokenIdMinus()
        and typed[rightIndex!].operand0 >= 0 and typed[rightIndex!].operand0 < (typed -> len)
        -> if { true => rightNegative!
            typed[rightIndex!].operand0 => rightIndex! }
    typed[leftIndex!] => left
    typed[rightIndex!] => right
    left.kind != 3 or right.kind != 3 or left.payloadToken < 0 or right.payloadToken < 0
        -> if { true -> return }
    prepared.package.ranges[left.sourceModule] => leftRange
    prepared.package.ranges[right.sourceModule] => rightRange
    prepared.package.tokens[leftRange.tokenStart + left.payloadToken] => leftToken
    prepared.package.tokens[rightRange.tokenStart + right.payloadToken] => rightToken
    prepared.package.sources[left.sourceModule] -> slice(leftToken.span.start, leftToken.span.length) => leftSpelling
    prepared.package.sources[right.sourceModule] -> slice(rightToken.span.start, rightToken.span.length) => rightSpelling
    (leftSpelling -> numericLiteralRange.literalUsesFloatingSyntax(0, leftSpelling -> len))
        or (rightSpelling -> numericLiteralRange.literalUsesFloatingSyntax(0, rightSpelling -> len))
        -> if { true -> return }
    UIntSize(0) => leftByte!
    UIntSize(0) => rightByte!
    leftByte! < leftToken.span.length -> while {
        prepared.package.sources[left.sourceModule] -> byte(leftToken.span.start + leftByte!) => digit
        digit != 48 and digit != 95 -> if { break }
        leftByte! + 1 => leftByte!
    }
    rightByte! < rightToken.span.length -> while {
        prepared.package.sources[right.sourceModule] -> byte(rightToken.span.start + rightByte!) => digit
        digit != 48 and digit != 95 -> if { break }
        rightByte! + 1 => rightByte!
    }
    leftByte! < leftToken.span.length and rightByte! < rightToken.span.length
        and ((leftNegative! and not rightNegative!) or (not leftNegative! and rightNegative!))
        -> if { false -> return }
    leftByte! < leftToken.span.length and rightByte! < rightToken.span.length
        -> while {
            (prepared.package.sources[left.sourceModule] -> byte(leftToken.span.start + leftByte!)) != (prepared.package.sources[right.sourceModule] -> byte(rightToken.span.start + rightByte!))
                -> if { false -> return }
            leftByte! + 1 => leftByte!
            rightByte! + 1 => rightByte!
            leftByte! < leftToken.span.length and (prepared.package.sources[left.sourceModule] -> byte(leftToken.span.start + leftByte!)) == 95
                -> while { leftByte! + 1 => leftByte! }
            rightByte! < rightToken.span.length and (prepared.package.sources[right.sourceModule] -> byte(rightToken.span.start + rightByte!)) == 95
                -> while { rightByte! + 1 => rightByte! }
        }
    leftByte! == leftToken.span.length and rightByte! == rightToken.span.length
}

indexedReferenceOverlapsAssignment prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], placeIr: Int, indexIr: Int -> Bool {
    true => overlap!
    placeIr >= 0 and placeIr < (typed -> len) and indexIr >= 0 and indexIr < (typed -> len)
        -> if {
            placeIr + 0 => indexedPlaceIr!
            indexedPlaceIr! >= 0 and indexedPlaceIr! < (typed -> len) and typed[indexedPlaceIr!].kind == 13
                -> while {
                    typed[indexedPlaceIr!].operand0 => indexedPlaceIr!
                }
            typed[indexedPlaceIr!] => place
            place.kind == 15 and place.operand1 >= 0 and place.operand1 < (typed -> len)
                -> if {
                    prepared -> constantIndexPlacesOverlap(typed, place.operand1, indexIr) => overlap!
                }
        }
    overlap!
}

referenceBindingUsedAfterIndexSite prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], bindingIr: Int, siteIr: Int -> Bool {
    false => used!
    bindingIr >= 0 and siteIr >= 0 and siteIr < (typed -> len)
        -> if {
            typed[siteIr] => site
            site.sourceModule >= 0 and site.sourceModule < (prepared.package.ranges -> len) and site.astNode >= 0
                -> if {
                    prepared.package.ranges[site.sourceModule] => useRange
                    site.astNode < useRange.astCount -> if {
                        prepared.package.nodes[useRange.astStart + site.astNode].start => siteStart
                        0 => useIndex!
                        not used! and useIndex! < (typed -> len) -> while {
                            typed[useIndex!] => use
                            use.kind == 5 and use.sourceModule == site.sourceModule and use.astNode >= 0 and use.astNode < useRange.astCount and use.operand0 == bindingIr
                                -> if {
                                    prepared.package.nodes[useRange.astStart + use.astNode].start > siteStart
                                        -> if { true => used! }
                                }
                            useIndex! + 1 => useIndex!
                        }
                    }
                }
        }
    used!
}

referenceForwardUseReachable prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], moveIndex: Int, useIndex: Int, exits: ref DirectExitIndex -> Bool {
    false => exclusive!
    moveIndex => moveAncestor!
    moveAncestor! >= 0 and moveAncestor! < (typed -> len) and not exclusive!
        -> while {
            typed[moveAncestor!] => moveAncestorNode
            moveAncestorNode.kind == 19 -> if {
                moveAncestorNode.parent >= 0 -> if {
                    moveAncestorNode.parent < (typed -> len) -> if {
                        typed[moveAncestorNode.parent].kind == 18 or typed[moveAncestorNode.parent].kind == 27
                            -> if {
                                useIndex => useAncestor!
                                useAncestor! >= 0 and useAncestor! < (typed -> len) and typed[useAncestor!].parent != moveAncestorNode.parent
                                    -> while {
                                        typed[useAncestor!].parent => useAncestor!
                                    }
                                useAncestor! >= 0 and useAncestor! < (typed -> len) and useAncestor! != moveAncestor! and typed[useAncestor!].kind == 19
                                    -> if {
                                        true => exclusive!
                                    }
                            }
                    }
                }
                not exclusive! and moveAncestorNode.sourceModule >= 0 and moveAncestorNode.sourceModule < (prepared.package.ranges -> len) and moveAncestorNode.astNode >= 0
                    -> if {
                        prepared.package.ranges[moveAncestorNode.sourceModule] => moveAncestorRange
                        moveAncestorNode.astNode < moveAncestorRange.astCount
                            -> if {
                                prepared.package.nodes[moveAncestorRange.astStart + moveAncestorNode.astNode].kind == 58
                                    -> if {
                                        moveAncestorNode.nextOperand => nextAlternative
                                        nextAlternative >= 0 and nextAlternative < (typed -> len)
                                            -> if {
                                                useIndex => alternativeUseAncestor!
                                                false => useInAlternative!
                                                alternativeUseAncestor! >= 0 and alternativeUseAncestor! < (typed -> len) and not useInAlternative!
                                                    -> while {
                                                        alternativeUseAncestor! == nextAlternative -> if {
                                                            true => useInAlternative!
                                                        } else {
                                                            typed[alternativeUseAncestor!].parent => alternativeUseAncestor!
                                                        }
                                                    }
                                                useInAlternative! -> if { true => exclusive! }
                                            }
                                    }
                            }
                    }
            }
            moveAncestorNode.parent => moveAncestor!
        }
    exclusive! -> if {
        false
    } else {
        moveIndex => moveRegion!
        moveRegion! >= 0 and moveRegion! < (typed -> len) and typed[moveRegion!].kind != 19 and typed[moveRegion!].kind != 20
            -> while {
                typed[moveRegion!].parent => moveRegion!
            }
        prepared.package.ranges[typed[moveIndex].sourceModule] => reachabilityRange
        prepared.package.nodes[reachabilityRange.astStart + typed[moveIndex].astNode].start => moveStart
        prepared.package.nodes[reachabilityRange.astStart + typed[useIndex].astNode].start => useStart
        false => stopped!
        0 => exitOrdinal!
        not stopped! and exitOrdinal! < (exits.allExits -> len)
            -> while {
                exits.allExits[exitOrdinal!] => exitIndex
                typed[exitIndex] => exitCandidate
                exitCandidate.sourceModule == typed[moveIndex].sourceModule and exitCandidate.astNode >= 0 and (exitCandidate.kind == 23 or (exitCandidate.kind == 21 and exitCandidate.opcode == 0))
                    -> if {
                        exitIndex => exitRegion!
                        exitRegion! >= 0 and exitRegion! < (typed -> len) and typed[exitRegion!].kind != 19 and typed[exitRegion!].kind != 20
                            -> while {
                                typed[exitRegion!].parent => exitRegion!
                            }
                        exitRegion! == moveRegion! -> if {
                            prepared.package.nodes[reachabilityRange.astStart + exitCandidate.astNode].start => exitStart
                            moveStart < exitStart and exitStart < useStart
                                -> if { true => stopped! }
                        }
                    }
                exitOrdinal! + 1 => exitOrdinal!
            }
        not stopped!
    }
}

# -1 is a known non-binding use; -2 is invalid diagnostic origin metadata.
public ownedBindingDiagnosticAst prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], diagnostic: OwnershipDiagnostic -> Int {
    diagnostic.sourceModule >= 0 and diagnostic.sourceModule < (prepared.package.ranges -> len)
        -> unless { -2 -> return }
    diagnostic.actualSymbol >= 0 and diagnostic.actualSymbol < (typed -> len)
        -> unless { -2 -> return }
    diagnostic.actualSymbol => originIr!
    diagnostic.code == 36 or diagnostic.code == aggregateTransferOverlapCode()
        -> if { diagnostic.expectedSymbol => originIr! }
    originIr! >= 0 and originIr! < (typed -> len)
        -> unless { -2 -> return }
    typed[originIr!] => origin
    origin.sourceModule == diagnostic.sourceModule
        -> unless { -2 -> return }
    prepared.package.ranges[diagnostic.sourceModule] => range
    origin.astNode >= 0 and origin.astNode < range.astCount
        -> unless { -2 -> return }
    # C# checks a direct field BindingStatement before CodeGen. A field
    # consumed by a call keeps its separate CodeGen diagnostic contract.
    diagnostic.code == 38 -> if {
        origin.kind == 13 -> unless { -1 -> return }
        origin.parent >= 0 and origin.parent < (typed -> len)
            -> unless { -2 -> return }
        typed[origin.parent] => directBinding
        directBinding.kind == 17 and directBinding.operand0 == originIr!
            -> unless { -1 -> return }
        directBinding.sourceModule == diagnostic.sourceModule
            and directBinding.astNode >= 0 and directBinding.astNode < range.astCount
            -> unless { -2 -> return }
        prepared.package.nodes[range.astStart + directBinding.astNode] => directBindingAst
        directBindingAst.kind == 9 or directBindingAst.kind == 61
            -> unless { -2 -> return }
        directBinding.astNode -> return
    }
    diagnostic.code == 34 or diagnostic.code == 36
        -> if {
            origin.kind == 17 -> unless { -2 -> return }
            prepared.package.nodes[range.astStart + origin.astNode] => binding
            binding.kind == 9 or binding.kind == 61 -> unless { -2 -> return }
            origin.astNode -> return
        }
    # Overlapping call/field-use E17 facts are not BindingStatement failures.
    diagnostic.code != aggregateTransferOverlapCode()
        and (diagnostic.code != 17 or origin.kind != 5)
        -> if { -1 -> return }
    origin.astNode => ancestor!
    0 => depth!
    ancestor! >= 0 and ancestor! < range.astCount and depth! < range.astCount
        -> while {
            prepared.package.nodes[range.astStart + ancestor!] => node
            node.kind == 9 or node.kind == 61 -> if { ancestor! -> return }
            node.kind == 7 or node.kind == 31 or node.kind == 8
                -> if { -1 -> return }
            node.parent => ancestor!
            depth! + 1 => depth!
        }
    ancestor! < 0 -> if { -1 } else { -2 }
}

public firstOwnedBindingDiagnostic prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], diagnostics: ref [OwnershipDiagnostic; ~] -> Int {
    -1 => selected!
    -1 => selectedSource!
    -1 => selectedAst!
    0 => selectedPhase!
    0 => index!
    index! < (diagnostics -> len) -> while {
        diagnostics[index!] => diagnostic
        diagnostic.code == 17 or diagnostic.code == 34 or diagnostic.code == 36
            or (diagnostic.code == 38 and not (diagnostic -> isSupersededByBranchJoin(diagnostics)))
            or diagnostic.code == aggregateTransferOverlapCode()
            -> if {
                prepared -> ownedBindingDiagnosticAst(typed, diagnostic) => bindingAst
                bindingAst == -2 -> if { -2 -> return }
                bindingAst >= 0 -> if {
                    3 => phase!
                    diagnostic.code == 17 or diagnostic.code == 38 or diagnostic.code == aggregateTransferOverlapCode()
                        -> if { 1 => phase! }
                    diagnostic.code == 36 -> if { 2 => phase! }
                    prepared.package -> semanticDiagnostics.diagnosticOriginBefore(diagnostic.sourceModule, bindingAst, selectedSource!, selectedAst!) => earlier
                    false => sameOrigin!
                    selected! >= 0 and diagnostic.sourceModule == selectedSource! and bindingAst == selectedAst!
                        -> if { true => sameOrigin! }
                    earlier or (sameOrigin! and phase! < selectedPhase!)
                        -> if {
                            index! => selected!
                            diagnostic.sourceModule => selectedSource!
                            bindingAst => selectedAst!
                            phase! => selectedPhase!
                        }
                }
            }
        index! + 1 => index!
    }
    selected!
}

public analyze sources: [Text; ~] -> [OwnershipDiagnostic; ~] {
    sources -> semanticContext.prepare => prepared
    prepared -> analyzeContext
}

public analyzeContext prepared: ref semanticContext.SemanticSnapshot -> [OwnershipDiagnostic; ~] {
    prepared -> expressionTypeIds.resolveContext => bindingFacts
    prepared -> typedIr.lowerResolvedContext(bindingFacts) => typed
    [Int; ~] => genericFunctionsByCall
    prepared -> analyzeResolvedLoweredContextWithBindingFacts(typed, bindingFacts.types, bindingFacts, genericFunctionsByCall)
}

# Ownership is a read-only consumer of the canonical typed IR. The compiler
# driver lowers once and shares the same value with validation and LLVM output.
public analyzeLoweredContext prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~] -> [OwnershipDiagnostic; ~] {
    prepared -> analyzeResolvedLoweredContext(typed, prepared.semantic.types)
}

# C# accepts user value types and enums independently of payload ownership.
# Builtin Result/Option are enums too; their scalar payload traits must not
# reject an otherwise valid move signature.
appendInvalidMoveInputSignature prepared: ref semanticContext.SemanticSnapshot, function: typedIr.TypedIrNode, parameter: typedIr.TypedIrNode, isMove: Bool, types: ref [typeIds.SemanticType; ~], traits: ref [Int; ~], diagnostics: mut [OwnershipDiagnostic; ~] -> Unit {
    isMove and parameter.kind == 10
        and parameter.typeId >= 0 and parameter.typeId < (types -> len)
        and parameter.typeId < (traits -> len)
        -> if {
            types[parameter.typeId] => inputType
            not inputType.containsParameter -> if {
                false => validMoveInput!
                (traits[parameter.typeId] / 2) % 2 == 1
                    or (traits[parameter.typeId] / 4) % 2 == 1
                    -> if { true => validMoveInput! }
                inputType.kind == 1 and (inputType.origin == 0 or inputType.origin == 2
                    or (inputType.origin == 1 and inputType.symbol == 15))
                    -> if { true => validMoveInput! }
                inputType.kind == 4 -> if { true => validMoveInput! }
                inputType.kind == 7 and inputType.origin == 4
                    and (inputType.symbol == 0 or inputType.symbol == 1)
                    -> if { true => validMoveInput! }
                not validMoveInput! and function.sourceModule >= 0
                    and function.sourceModule < (prepared.package.ranges -> len)
                    -> if {
                        prepared.package.ranges[function.sourceModule] => sourceRange
                        parameter.astNode >= 0 and parameter.astNode < sourceRange.astCount
                            -> if {
                                prepared.package.nodes[sourceRange.astStart + parameter.astNode] => declaration
                                diagnostics -> push(OwnershipDiagnostic {
                                    code: 37
                                    sourceModule: function.sourceModule
                                    functionSymbol: function.symbol
                                    expectedOrigin: -1
                                    expectedModule: -1
                                    expectedSymbol: -1
                                    actualOrigin: -1
                                    actualModule: -1
                                    actualSymbol: -1
                                    actualBuiltin: -1
                                    readonlyReferencePath: -1
                                    span: syntax.SourceSpan {
                                        fileId: function.sourceModule
                                        start: declaration.start
                                        length: declaration.length
                                    }
                                })
                            }
                    }
            }
        }
}

# Await IR points at its input; the canonical flow index owns the call site.
taskContractLocationAst prepared: ref semanticContext.SemanticSnapshot, sourceModule: Int, valueAst: Int, awaits: Bool -> Int {
    prepared.package.ranges[sourceModule] => range
    prepared.package.nodes[range.astStart + valueAst] => value
    awaits -> if {
        prepared.directFlowTargetPathByAst[range.astStart + value.parent]
    } else {
        value.kind == 10 -> if {
            prepared.directFlowTargetPathByAst[range.astStart + valueAst]
        } else { valueAst }
    }
}

# The declared track intrinsic accepts only an affine Task, even if a
# non-Task value otherwise qualifies for a general move input.
public invalidDiagnosticTrackArguments prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], activeBodies: ref [Bool; ~] -> [OwnershipDiagnostic; ~] {
    [OwnershipDiagnostic; ~] => diagnostics!
    0 => callIndex!
    callIndex! < (typed -> len) -> while {
        typed[callIndex!] => call
        (call.kind == 6 or call.kind == 9) and call.opcode == -325
            and activeBodies[callIndex!]
            -> if {
                false => isTask!
                call.operand1 >= 0 and call.operand1 < (typed -> len)
                    -> if {
                        typed[call.operand1] => argument
                        argument -> typedIr.isAsyncTaskValue(typed) => isTask!
                        argument.typeId >= 0 and argument.typeId < (types -> len)
                            -> if {
                                types[argument.typeId] => type
                                type.kind == 7 and type.origin == 4 and type.symbol == 2
                                    -> if { true => isTask! }
                            }
                    }
                not isTask! and call.sourceModule >= 0
                    and call.sourceModule < (prepared.package.ranges -> len)
                    -> if {
                        prepared.package.ranges[call.sourceModule] => range
                        call.astNode >= 0 and call.astNode < range.astCount
                            -> if {
                                prepared -> taskContractLocationAst(call.sourceModule, call.astNode, false) => locationAst
                                prepared.package.nodes[range.astStart + locationAst] => source
                                diagnostics! -> push(OwnershipDiagnostic {
                                    code: diagnosticTrackTaskArgumentCode()
                                    sourceModule: call.sourceModule
                                    functionSymbol: call.symbol
                                    expectedOrigin: 4
                                    expectedModule: -1
                                    expectedSymbol: 2
                                    actualOrigin: locationAst
                                    actualModule: -1
                                    actualSymbol: call.operand1
                                    actualBuiltin: -1
                                    readonlyReferencePath: -1
                                    span: syntax.SourceSpan { fileId: call.sourceModule, start: source.start, length: source.length }
                                })
                            }
                    }
            }
        callIndex! + 1 => callIndex!
    }
    diagnostics!
}

# Task contract actualOrigin is the canonical invocation AST.
# Code 51 actualBuiltin: 1 await input, 2 cancel input, 3 await scope.
public invalidTaskOperationContracts prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], activeBodies: ref [Bool; ~] -> [OwnershipDiagnostic; ~] {
    [OwnershipDiagnostic; ~] => diagnostics!
    0 => index!
    index! < (typed -> len) -> while {
        typed[index!] => operation
        operation.sourceModule >= 0 and operation.sourceModule < (prepared.package.ranges -> len)
            and operation.astNode >= 0 and activeBodies[index!]
            -> if {
                prepared.package.ranges[operation.sourceModule] => range
                operation.astNode < range.astCount -> if {
                    operation.kind == 5 and not (operation -> typedIr.isAsyncExpressionRead)
                        and prepared.awaitSourceByAst[range.astStart + operation.astNode] => awaits
                    (operation.kind == 6 or operation.kind == 9) and operation.opcode == -321 => cancels
                    (awaits or cancels) and operation.operand0 >= 0 and operation.operand0 < (typed -> len)
                        -> if {
                            typed[operation.operand0] => argument
                            argument -> typedIr.isTaskOwnerValue(typed, prepared) => isTask
                            0 => violation!
                            not isTask and argument.typeId >= 0 -> if { awaits -> if { 1 } else { 2 } => violation! }
                            isTask and awaits -> if {
                                operation.parent => owner!
                                owner! >= 0 and owner! < (typed -> len) and typed[owner!].kind != 0 and typed[owner!].kind != 11
                                    -> while {
                                        typed[owner!].parent => owner!
                                    }
                                owner! < 0 or owner! >= (typed -> len) -> if { 3 => violation! } else {
                                    typed[owner!].kind != 11 and typed[owner!].flags / 8 % 2 == 0
                                        -> if { 3 => violation! }
                                }
                            }
                            violation! > 0 -> if {
                                prepared -> taskContractLocationAst(operation.sourceModule, operation.astNode, awaits) => locationAst
                                prepared.package.nodes[range.astStart + locationAst] => source
                                diagnostics! -> push(OwnershipDiagnostic {
                                    code: taskOperationContractCode()
                                    sourceModule: operation.sourceModule
                                    functionSymbol: -1
                                    expectedOrigin: 4
                                    expectedModule: -1
                                    expectedSymbol: 2
                                    actualOrigin: locationAst
                                    actualModule: -1
                                    actualSymbol: operation.operand0
                                    actualBuiltin: violation!
                                    readonlyReferencePath: -1
                                    span: syntax.SourceSpan { fileId: operation.sourceModule, start: source.start, length: source.length }
                                })
                            }
                        }
                }
            }
        index! + 1 => index!
    }
    diagnostics!
}

public invalidMoveInputSignatures prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], traits: ref [Int; ~] -> [OwnershipDiagnostic; ~] {
    [OwnershipDiagnostic; ~] => diagnostics!
    0 => functionIndex!
    functionIndex! < (typed -> len) -> while {
        typed[functionIndex!] => function
        function.kind == 0 and not (function -> typedIr.isDiagnosticTrackFunction(prepared))
            -> if {
                function.operand1 >= 0 and function.operand1 < (typed -> len)
                    -> if {
                        typed[function.operand1] => primaryParameter
                        prepared -> appendInvalidMoveInputSignature(function, primaryParameter, function.flags % 2 == 1, types, traits, diagnostics!)
                    }
                function.nextOperand => additionalIndex!
                0 => additionalCount!
                additionalIndex! >= 0 and additionalIndex! < (typed -> len)
                    and additionalCount! < (typed -> len) -> while {
                        typed[additionalIndex!] => additionalParameter
                        prepared -> appendInvalidMoveInputSignature(function, additionalParameter, additionalParameter.flags % 2 == 1, types, traits, diagnostics!)
                        additionalParameter.nextOperand => additionalIndex!
                        additionalCount! + 1 => additionalCount!
                    }
            }
        functionIndex! + 1 => functionIndex!
    }
    diagnostics!
}

# Specializations append concrete types; ownership must use the same table as IR.
public analyzeResolvedLoweredContext prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~] -> [OwnershipDiagnostic; ~] {
    [Int; ~] => callFunctionIndex
    prepared -> analyzeResolvedLoweredContextWithGenericBodies(typed, types, callFunctionIndex)
}

public analyzeResolvedLoweredContextWithGenericBodies prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], genericFunctionsByCall: ref [Int; ~] -> [OwnershipDiagnostic; ~] {
    prepared -> expressionTypeIds.resolveContext => bindingFacts
    prepared -> analyzeResolvedLoweredContextWithBindingFacts(typed, types, bindingFacts, genericFunctionsByCall)
}

analyzeResolvedLoweredContextWithBindingFacts prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], bindingFacts: ref expressionTypeIds.ExpressionTypeIdSet, genericFunctionsByCall: ref [Int; ~] -> [OwnershipDiagnostic; ~] {
    prepared -> streamIr.build(typed, bindingFacts) => plan
    prepared -> interpolationInference.preIrFlowCallTargets(bindingFacts) => semanticTargets
    prepared -> interpolationInference.resultTypeByNode(plan, bindingFacts, typed, types, bindingFacts.fields) => resultTypes
    prepared -> interpolationInference.importedFlowCallTargets(plan, bindingFacts, semanticTargets, prepared.interpolations, typed, types, bindingFacts.fields) => functionTargets
    [Int; ~] => concreteFunctions!
    genericFunctionsByCall -> each selected { concreteFunctions! -> push(selected) }
    functionTargets -> each selected { concreteFunctions! -> push(selected) }
    prepared -> bodyDiagnosticActivity(typed, types, bindingFacts.activeDeclarationBodyByAst, concreteFunctions!) => activeBodies
    prepared -> analyzeResolvedLoweredContextWithInterpolationFactsAndPaths(typed, types, bindingFacts.fields, genericFunctionsByCall, resultTypes, functionTargets, activeBodies) -> ownershipDiagnosticsWithoutPaths
}

public analyzeResolvedLoweredContextWithInterpolationFacts prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], genericFunctionsByCall: ref [Int; ~], interpolationResultTypes: ref [Int; ~], interpolationFunctionTargets: ref [Int; ~] -> [OwnershipDiagnostic; ~] {
    prepared -> expressionTypeIds.resolveContext => referenceFacts
    [Int; ~] => concreteFunctions!
    genericFunctionsByCall -> each selected { concreteFunctions! -> push(selected) }
    interpolationFunctionTargets -> each selected { concreteFunctions! -> push(selected) }
    prepared -> bodyDiagnosticActivity(typed, types, referenceFacts.activeDeclarationBodyByAst, concreteFunctions!) => activeBodies
    prepared -> analyzeResolvedLoweredContextWithInterpolationFactsAndPaths(typed, types, referenceFacts.fields, genericFunctionsByCall, interpolationResultTypes, interpolationFunctionTargets, activeBodies) -> ownershipDiagnosticsWithoutPaths
}

ownershipDiagnosticsWithoutPaths result: move OwnershipAnalysis -> [OwnershipDiagnostic; ~] {
    result.diagnostics => diagnostics!
    # The compatibility entry point returns diagnostics without path storage.
    # Only the analysis-returning entry point exposes valid path indices.
    0 => index!
    index! < (diagnostics! -> len) -> while {
        diagnostics![index!] => diagnostic!
        -1 => diagnostic!.readonlyReferencePath
        diagnostic! => diagnostics![index!]
        index! + 1 => index!
    }
    diagnostics!
}

public analyzeResolvedLoweredContextWithInterpolationFactsAndPaths prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], fields: ref [typeIds.NominalField; ~], genericFunctionsByCall: ref [Int; ~], interpolationResultTypes: ref [Int; ~], interpolationFunctionTargets: ref [Int; ~], activeBodies: ref [Bool; ~] -> OwnershipAnalysis {
    # Keep original IR order and every explicit/implicit return candidate.
    # Repeated origin inference does not need to revisit unrelated IR nodes.
    [Int; ~] => genericSelectionByCall!
    genericFunctionsByCall -> each selected { genericSelectionByCall! -> push(selected) }
    [Int; ~] => ownedInterpolationResultTypes!
    interpolationResultTypes -> each typeId { ownedInterpolationResultTypes! -> push(typeId) }
    [Int; ~] => ownedInterpolationFunctionTargets!
    interpolationFunctionTargets -> each target { ownedInterpolationFunctionTargets! -> push(target) }
    # Index once rather than scan every fragment during each origin query.
    [Int; ~] => interpolationRootByToken!
    prepared.package.tokens -> each token { interpolationRootByToken! -> push(-1) }
    [Int; ~] => interpolationNextRoot!
    prepared.interpolations -> each node { interpolationNextRoot! -> push(-1) }
    prepared.interpolationRanges -> each range {
        range.nodeStart + range.nodeCount => root!
        root! > range.nodeStart -> while {
            root! - 1 => root!
            prepared.interpolations[root!] => node
            node.parent < 0 -> if {
                prepared.package.ranges[range.sourceModule].tokenStart + node.sourceToken => token
                interpolationRootByToken![token] => interpolationNextRoot![root!]
                root! => interpolationRootByToken![token]
            }
        }
    }
    typed -> typedIr.functionDeclarationIrs => functionCandidates
    typed -> borrowedTextFunctionsByIdentity(functionCandidates) => functionsByIdentity
    [Int; ~] => borrowedReturnSites!
    {Int: Int} => scalarVersionHeads!
    [Int; ~] => scalarVersionNext!
    0 => borrowedReturnSiteSearch!
    borrowedReturnSiteSearch! < (typed -> len) -> while {
        scalarVersionNext! -> push(-1)
        typed[borrowedReturnSiteSearch!].kind == 1 or typed[borrowedReturnSiteSearch!].kind == 23
            -> if { borrowedReturnSites! -> push(borrowedReturnSiteSearch!) }
        borrowedReturnSiteSearch! + 1 => borrowedReturnSiteSearch!
    }
    # This typed/type pair is immutable throughout borrowed origin queries.
    # Symbol buckets retain every module/function candidate and original order;
    # borrowedTextSameScalarSlot remains the exact identity authority.
    (typed -> len) - 1 => scalarVersionIndex!
    scalarVersionIndex! >= 0 -> while {
        typed -> borrowedTextScalarSlot(types, scalarVersionIndex!)
            -> if {
                typed[scalarVersionIndex!].symbol => scalarSymbol
                scalarVersionHeads! -> putIfAbsent(scalarSymbol, -1) => scalarHeadInserted
                scalarVersionHeads![scalarSymbol] => scalarVersionNext![scalarVersionIndex!]
                scalarVersionIndex! => scalarVersionHeads![scalarSymbol]
            }
        scalarVersionIndex! - 1 => scalarVersionIndex!
    }
    typed -> indexOwnershipIr => irIndex
    BorrowedTextCallFunctionIndex {
        genericSelectionByCall: genericSelectionByCall!
        functionCandidates: functionCandidates
        functionsByIdentity: functionsByIdentity
        interpolationResultTypes: ownedInterpolationResultTypes!
        interpolationFunctionTargets: ownedInterpolationFunctionTargets!
        interpolationRootByToken: interpolationRootByToken!
        interpolationNextRoot: interpolationNextRoot!
        scalarVersionHeads: scalarVersionHeads!
        scalarVersionNext: scalarVersionNext!
        irIndex: irIndex
    } => callFunctionIndex
    prepared -> analyzeResolvedLoweredContextWithReturnSites(typed, types, fields, callFunctionIndex, borrowedReturnSites!, activeBodies)
}

analyzeResolvedLoweredContextWithReturnSites prepared: ref semanticContext.SemanticSnapshot, typed: ref [typedIr.TypedIrNode; ~], types: ref [typeIds.SemanticType; ~], fields: ref [typeIds.NominalField; ~], callFunctionIndex: ref BorrowedTextCallFunctionIndex, borrowedReturnSites: ref [Int; ~], activeBodies: ref [Bool; ~] -> OwnershipAnalysis {
    appendBodyDiagnostic output: mut [OwnershipDiagnostic; ~], siteIr: Int, diagnostic: OwnershipDiagnostic -> Unit {
        siteIr < 0 or siteIr >= (activeBodies -> len)
            -> if {
                # Missing execution metadata cannot justify suppressing a failure.
                output -> push(diagnostic)
            } else {
                activeBodies[siteIr] -> if { output -> push(diagnostic) }
            }
    }
    parallelDeclaration sourceModule: Int, symbol: Int, declarations: ref [Int; ~] -> Int {
        sourceModule < 0 or sourceModule >= (prepared.package.ranges -> len) or symbol < 0
            -> if { -1 -> return }
        prepared.package.ranges[sourceModule] => range
        symbol >= range.symbolCount -> if { -1 -> return }
        declarations[range.symbolStart + symbol]
    }

    parallelFunctionIsLocal functionIr: Int -> Bool {
        typed[functionIr] => function
        prepared.package.ranges[function.sourceModule] => range
        function.astNode < 0 or function.astNode >= range.astCount
            -> if { false -> return }
        prepared.package.nodes[range.astStart + function.astNode].parent => ancestor!
        ancestor! >= 0 and ancestor! < range.astCount
            -> while {
                prepared.package.nodes[range.astStart + ancestor!] => scope
                scope.kind == 7 or scope.kind == 31 or scope.kind == 8
                    -> if { true -> return }
                scope.parent => ancestor!
            }
        false
    }

    retainedOwnerConcreteFunction functionIr: Int -> Bool {
        functionIr < 0 or functionIr >= (typed -> len)
            -> if { false -> return }
        typed[functionIr] => retainedFunction
        retainedFunction.kind != 0 or retainedFunction.sourceModule < 0 or retainedFunction.sourceModule >= (prepared.package.ranges -> len)
            -> if { false -> return }
        prepared.package.ranges[retainedFunction.sourceModule] => range
        retainedFunction.symbol < 0 or retainedFunction.symbol >= range.symbolCount
            -> if { false -> return }
        0 => declaration!
        declaration! < range.symbolCount -> while {
            prepared.package.symbols[range.symbolStart + declaration!] => symbol
            symbol.parent == retainedFunction.symbol and (symbol.kind == 32 or symbol.kind == 7 or symbol.kind == 31)
                -> if { false -> return }
            declaration! + 1 => declaration!
        }
        true
    }
    retainedOwnerLiteralSlot literalIr: Int, formalIr: Int -> Int {
        literalIr < 0 or literalIr >= (typed -> len) or formalIr < 0 or formalIr >= (typed -> len)
            -> if { -1 -> return }
        typed[literalIr] => literal
        literal.kind != 12 or literal.typeId < 0 or literal.typeId >= (types -> len)
            or types[literal.typeId].status != 0 or types[literal.typeId].containsParameter
            or types[literal.typeId].kind != 1
            -> if { -1 -> return }
        literal.operand0 => child!
        0 => ordinal!
        -1 => retainedSlot!
        child! >= 0 and child! < (typed -> len) and ordinal! < (typed -> len)
            -> while {
                typed[child!] => value
                (child! -> retainedFormalRead(formalIr)) and value.typeId == typed[formalIr].typeId
                    -> if {
                        false => movedWhole!
                        moves! -> each transfer {
                            transfer.valueIr == child! and transfer.memberIr < 0
                                -> if { true => movedWhole! }
                        }
                        movedWhole! -> unless { -1 -> return }
                        0 => fieldIndex!
                        fieldIndex! < (prepared.semantic.fields -> len)
                            -> while {
                                prepared.semantic.fields[fieldIndex!] => field
                                field.status == 0 and field.ownerType == literal.typeId and field.ordinal == ordinal!
                                    and field.fieldType == typed[formalIr].typeId
                                    -> if {
                                        retainedSlot! >= 0 -> if { -1 -> return }
                                        fieldIndex! => retainedSlot!
                                    }
                                fieldIndex! + 1 => fieldIndex!
                            }
                    }
                value.nextOperand => child!
                ordinal! + 1 => ordinal!
            }
        child! >= 0 -> if { -1 -> return }
        retainedSlot!
    }
    retainedAggregateReturn valueIr: Int, formalIr: Int -> Bool {
        valueIr => payload!
        0 => edges!
        payload! >= 0 and payload! < (typed -> len) and edges! < (typed -> len)
            -> while {
                typed[payload!] => value
                value.kind != 26 -> if { (payload! -> retainedOwnerLiteralSlot(formalIr)) >= 0 -> return }
                value.typeId < 0 or value.typeId >= (types -> len)
                    or types[value.typeId].status != 0 or types[value.typeId].containsParameter
                    or types[value.typeId].kind != 7
                    or not (prepared -> semanticTypeContainsOwnedStorage(types, value.typeId))
                    -> if { false -> return }
                value.operand0 < 0 or value.operand0 >= (typed -> len)
                    or typed[value.operand0].parent != payload!
                    or (typed -> borrowedTextFunctionIr(value.operand0)) != typed[formalIr].parent
                    -> if { false -> return }
                value.operand0 => payload!
                edges! + 1 => edges!
            }
        false
    }
    retainedOwnerFieldToken fieldIndex: Int -> Int {
        fieldIndex < 0 or fieldIndex >= (prepared.semantic.fields -> len)
            -> if { -1 -> return }
        prepared.semantic.fields[fieldIndex] => field
        field.labelToken >= 0 -> if { field.labelToken -> return }
        field.sourceModule < 0 or field.sourceModule >= (prepared.package.ranges -> len)
            -> if { -1 -> return }
        prepared.package.ranges[field.sourceModule] => range
        field.fieldSymbol < 0 or field.fieldSymbol >= range.symbolCount
            -> if { -1 -> return }
        prepared.package.symbols[range.symbolStart + field.fieldSymbol].nameToken
    }
    retainedOwnerReadonlyRead contracts: ref [BorrowedTextReturn; ~], readIr: Int, ownerIr: Int -> Bool {
        typed[readIr] => read
        read.kind != 5 or read.operand0 != ownerIr or read.parent < 0 or read.parent >= (typed -> len)
            -> if { false -> return }
        read.parent => callIr
        typed[callIr] => call
        call.kind != 6 -> if { false -> return }
        typed -> borrowedTextSelectedCallFunctionIr(contracts, callFunctionIndex, callIr) => selected
        selected < 0 or selected >= (typed -> len) -> if { false -> return }
        selected -> retainedOwnerConcreteFunction -> unless { false -> return }
        typed[selected] => retainedFunction
        retainedFunction.operand1 => formal!
        call.operand0 => argument!
        0 => count!
        formal! >= 0 and formal! < (typed -> len) and argument! >= 0 and argument! < (typed -> len)
            and count! < (typed -> len) -> while {
                argument! == readIr -> if {
                    typed[formal!] => parameter
                    parameter.kind != 10 or parameter.parent != selected or parameter.flags != 0
                        or parameter.typeId < 0 or parameter.typeId >= (types -> len)
                        -> if { false -> return }
                    types[parameter.typeId] => formalType
                    (formalType.status == 0 and not formalType.containsParameter and formalType.kind == 8
                        and formalType.first == typed[ownerIr].typeId) -> return
                }
                typed[argument!].nextOperand => argument!
                formal! == retainedFunction.operand1 -> if { retainedFunction.nextOperand => formal! } else { typed[formal!].nextOperand => formal! }
                count! + 1 => count!
            }
        false
    }
    retainedFormalRead valueIr: Int, formalIr: Int -> Bool {
        valueIr < 0 or valueIr >= (typed -> len) -> if { false -> return }
        typed[valueIr] => value
        typed[formalIr] => formal
        value.kind == 5 and value.sourceModule == formal.sourceModule
            and (typed -> borrowedTextFunctionIr(valueIr)) == formal.parent
            and (value.operand0 == formalIr
            or (typed -> resolvedFormalReadBinding(valueIr)) == formalIr)
    }
    retainedAstBelongsTo sourceModule: Int, nodeAst: Int, ownerAst: Int -> Bool {
        sourceModule < 0 or sourceModule >= (prepared.package.ranges -> len)
            -> if { false -> return }
        prepared.package.ranges[sourceModule] => range
        ownerAst < 0 or ownerAst >= range.astCount -> if { false -> return }
        nodeAst => cursor!
        0 => edges!
        cursor! >= 0 and cursor! < range.astCount and edges! < range.astCount
            -> while {
                cursor! == ownerAst -> if { true -> return }
                prepared.package.nodes[range.astStart + cursor!].parent => cursor!
                edges! + 1 => edges!
            }
        false
    }
    retainedFormalUsedInValue valueIr: Int, formalIr: Int -> Bool {
        valueIr < 0 or valueIr >= (typed -> len) -> if { true -> return }
        typed[valueIr] => value
        value.sourceModule < 0 or value.sourceModule >= (prepared.package.ranges -> len)
            -> if { true -> return }
        value.astNode < 0 or value.astNode >= prepared.package.ranges[value.sourceModule].astCount
            -> if { true -> return }
        0 => readIr!
        readIr! < (typed -> len) -> while {
            readIr! -> retainedFormalRead(formalIr)
                and (value.sourceModule -> retainedAstBelongsTo(typed[readIr!].astNode, value.astNode))
                -> if { true -> return }
            readIr! + 1 => readIr!
        }
        false
    }
    # The existing completed result edge supplies identity. AST authority proves
    # one target, never a last call selected from a multi-target/control body.
    retainedForwardExpressionAst resultIr: Int -> Int {
        typed[resultIr] => result
        result.sourceModule < 0 or result.sourceModule >= (prepared.package.ranges -> len)
            -> if { -1 -> return }
        prepared.package.ranges[result.sourceModule] => range
        result.astNode < 0 or result.astNode >= range.astCount
            -> if { -1 -> return }
        prepared.package.nodes[range.astStart + result.astNode] => expression
        # sealResolvedContext may publish the actual call instead of its envelope.
        expression.kind == 11 and expression.cstRuleId == grammar.ruleIdFlowTargetCall()
            -> if {
                expression.parent >= 0 and expression.parent < range.astCount
                    and prepared.package.nodes[range.astStart + expression.parent].kind == 10
                    -> if { expression.parent } else { -1 }
            } else { result.astNode }
    }
    retainedForwardCall resultIr: Int -> Int {
        typed[resultIr] => result
        result.sourceModule < 0 or result.sourceModule >= (prepared.package.ranges -> len)
            -> if { -1 -> return }
        prepared.package.ranges[result.sourceModule] => range
        result.astNode < 0 or result.astNode >= range.astCount
            -> if { -1 -> return }
        resultIr -> retainedForwardExpressionAst => expressionAstIndex
        expressionAstIndex < 0 -> if { -1 -> return }
        prepared.package.nodes[range.astStart + expressionAstIndex] => resultAst
        resultIr => callIr!
        result -> typedIr.isTransparentControlProducerWrapper
            -> if { result.operand1 => callIr! }
        callIr! < 0 or callIr! >= (typed -> len) -> if { -1 -> return }
        typed[callIr!] => call
        call.kind != 6 or call.sourceModule != result.sourceModule
            or (typed -> borrowedTextFunctionIr(callIr!)) != (typed -> borrowedTextFunctionIr(resultIr))
            or call.typeId != result.typeId or call.targetModule < 0 or call.symbol < 0
            or call.astNode < 0 or call.astNode >= range.astCount
            -> if { -1 -> return }
        prepared.package.nodes[range.astStart + call.astNode] => callAst
        resultAst.kind == 11 and resultIr == callIr! and resultAst.cstRuleId == grammar.ruleIdCallExpression()
            -> if { callIr! -> return }
        resultAst.kind != 10 -> if { -1 -> return }
        # The resolver owns the Flow AST for both bare and parenthesized targets.
        # A late completed call may instead expose its exact optional call child.
        call.astNode != expressionAstIndex and not (callAst.kind == 11
            and callAst.parent == expressionAstIndex
            and callAst.cstRuleId == grammar.ruleIdFlowTargetCall())
            -> if { -1 -> return }
        -1 => targetPathAst!
        0 => targets!
        0 => optionalCalls!
        0 => childAst!
        childAst! < range.astCount -> while {
            prepared.package.nodes[range.astStart + childAst!] => child
            child.parent == expressionAstIndex and child.start > resultAst.start
                -> if {
                    child.kind == 16 and child.cstRuleId == grammar.ruleIdPath()
                        -> if {
                            targets! + 1 => targets!
                            childAst! => targetPathAst!
                        } else {
                            child.kind == 11 and child.cstRuleId == grammar.ruleIdFlowTargetCall()
                                -> if { optionalCalls! + 1 => optionalCalls! } else { -1 -> return }
                        }
                }
            childAst! + 1 => childAst!
        }
        targets! != 1 or optionalCalls! > 1 or targetPathAst! < 0
            -> if { -1 -> return }
        prepared.directFlowTargetPathByAst[range.astStart + expressionAstIndex] != targetPathAst!
            -> if { -1 -> return }
        call.astNode != expressionAstIndex
            and callAst.start < prepared.package.nodes[range.astStart + targetPathAst!].start
            -> if { -1 -> return }
        callIr!
    }
    returnsRetainedWholeOwner contracts: ref [BorrowedTextReturn; ~], functionIr: Int, formalIr: Int, returnIr: Int -> Bool {
        [Int; ~] => visited!
        contracts -> returnsRetainedWholeOwnerCore(functionIr, formalIr, returnIr, visited!, 0)
    }
    returnsRetainedWholeOwnerCore contracts: ref [BorrowedTextReturn; ~], functionIr: Int, formalIr: Int, returnIr: Int, visited: mut [Int; ~], depth: Int -> Bool {

        functionIr < 0 or functionIr >= (typed -> len) or formalIr < 0 or formalIr >= (typed -> len)
            or returnIr < 0 or returnIr >= (typed -> len)
            -> if { false -> return }
        depth >= (typed -> len) or depth > (visited -> len)
            -> if { false -> return }
        0 => visitedIndex!
        visitedIndex! < depth -> while {
            visited[visitedIndex!] == functionIr -> if { false -> return }
            visitedIndex! + 1 => visitedIndex!
        }
        depth == (visited -> len) -> if { visited -> push(functionIr) } else { functionIr => visited[depth] }
        functionIr -> retainedOwnerConcreteFunction -> unless { false -> return }
        typed[functionIr] => retainedFunction
        typed[formalIr] => formal
        retainedFunction.kind != 0 or formal.kind != 10 or formal.parent != functionIr or formal.flags % 2 != 1
            or formal.typeId < 0 or formal.typeId >= (types -> len)
            or retainedFunction.typeId < 0 or retainedFunction.typeId >= (types -> len)
            or types[formal.typeId].status != 0 or types[formal.typeId].containsParameter or types[formal.typeId].kind == 8
            or types[retainedFunction.typeId].status != 0 or types[retainedFunction.typeId].containsParameter or types[retainedFunction.typeId].kind == 8
            -> if { false -> return }
        prepared -> semanticContext.typeContainsOwnedStorage(types, formal.typeId)
            -> unless { false -> return }
        # Early exits and local retainedFunction capture are outside this bounded proof.
        borrowedReturnSites -> each boundary {
            typed[boundary].kind == 23 and (typed -> borrowedTextFunctionIr(boundary)) == functionIr
                -> if { false -> return }
        }
        typed[returnIr].operand0 => result!
        result! < 0 or result! >= (typed -> len) or (typed -> borrowedTextFunctionIr(result!)) != functionIr
            -> if { false -> return }
        result! -> retainedForwardCall => forwardingCallIr
        forwardingCallIr >= 0 -> if {
            result! -> retainedForwardExpressionAst => forwardingExpressionAst
            forwardingExpressionAst < 0 -> if { false -> return }
            typed -> borrowedTextSelectedCallFunctionIr(contracts, callFunctionIndex, forwardingCallIr) => calleeIr
            calleeIr < 0 or calleeIr >= (typed -> len) or typed[calleeIr].typeId != retainedFunction.typeId
                -> if { false -> return }
            # The formal cannot be shadowed or read by a preceding statement.
            0 => precedingIr!
            precedingIr! < (typed -> len) -> while {
                (typed -> borrowedTextFunctionIr(precedingIr!)) == functionIr
                    -> if {
                        typed[precedingIr!] => preceding
                        (preceding.kind == 17 or preceding.kind == 29) and (formalIr -> sameBindingName(precedingIr!))
                            -> if { false -> return }
                        precedingIr! -> retainedFormalRead(formalIr)
                            and not (retainedFunction.sourceModule -> retainedAstBelongsTo(preceding.astNode, forwardingExpressionAst))
                            -> if { false -> return }
                    }
                precedingIr! + 1 => precedingIr!
            }
            typed[calleeIr].operand1 => calleeFormalIr!
            calleeFormalIr! < 0 -> if { typed[calleeIr].nextOperand => calleeFormalIr! }
            typed[forwardingCallIr].operand0 => argumentIr!
            -1 => matchingFormalIr!
            0 => matchingArguments!
            0 => arguments!
            argumentIr! >= 0 and argumentIr! < (typed -> len) and arguments! < (typed -> len)
                -> while {
                    calleeFormalIr! < 0 or calleeFormalIr! >= (typed -> len)
                        or typed[calleeFormalIr!].kind != 10 or typed[calleeFormalIr!].parent != calleeIr
                        or typed[calleeFormalIr!].sourceModule != typed[calleeIr].sourceModule
                        -> if { false -> return }
                    argumentIr! -> retainedFormalUsedInValue(formalIr)
                        -> if {
                            matchingArguments! + 1 => matchingArguments!
                            typed[argumentIr!].astNode => argumentAstIndex
                            prepared.package.ranges[retainedFunction.sourceModule] => argumentRange
                            argumentAstIndex < 0 or argumentAstIndex >= argumentRange.astCount
                                -> if { false -> return }
                            prepared.package.nodes[argumentRange.astStart + argumentAstIndex] => argumentAst
                            argumentAst.parent >= 0 and argumentAst.parent < argumentRange.astCount
                                and prepared.package.nodes[argumentRange.astStart + argumentAst.parent].kind == 11
                                and prepared.package.nodes[argumentRange.astStart + argumentAst.parent].cstRuleId == grammar.ruleIdFlowTargetCall()
                                and prepared.package.nodes[argumentRange.astStart + argumentAst.parent].parent == forwardingExpressionAst
                                => exactOptionalArgument
                            argumentAst.kind != 15 or (argumentAst.parent != typed[forwardingCallIr].astNode
                                and argumentAst.parent != forwardingExpressionAst and not exactOptionalArgument)
                                -> if { false -> return }
                            argumentIr! -> retainedFormalRead(formalIr)
                                and typed[argumentIr!].typeId == formal.typeId
                                and typed[calleeFormalIr!].typeId == formal.typeId
                                and typed[calleeFormalIr!].flags % 2 == 1
                                -> unless { false -> return }
                            calleeFormalIr! => matchingFormalIr!
                        }
                    typed[argumentIr!].nextOperand => argumentIr!
                    calleeFormalIr! == typed[calleeIr].operand1 -> if {
                        typed[calleeIr].nextOperand => calleeFormalIr!
                    } else { typed[calleeFormalIr!].nextOperand => calleeFormalIr! }
                    arguments! + 1 => arguments!
                }
            argumentIr! >= 0 or matchingArguments! != 1 or matchingFormalIr! < 0
                -> if { false -> return }
            -1 => calleeReturnIr!
            borrowedReturnSites -> each returnSite {
                typed[returnSite].kind == 1 and typed[returnSite].parent == calleeIr
                    -> if {
                        calleeReturnIr! >= 0 -> if { false -> return }
                        returnSite => calleeReturnIr!
                    }
            }
            calleeReturnIr! < 0 -> if { false -> return }
            contracts -> returnsRetainedWholeOwnerCore(calleeIr, matchingFormalIr!, calleeReturnIr!, visited, depth + 1) -> return
        }
        typed[result!] => returned
        (result! -> retainedFormalRead(formalIr)) and retainedFunction.typeId == formal.typeId
            -> if { true -> return }
        -1 => owner!
        returned.kind == 5 -> if {
            returned.operand0 => owner!
            owner! < 0 or owner! >= (typed -> len) or typed[owner!].kind != 17
                or typed[owner!].typeId != retainedFunction.typeId or (typed -> borrowedTextFunctionIr(owner!)) != functionIr
                -> if { false -> return }
            typed[owner!].operand0 => result!
        }
        result! < 0 or result! >= (typed -> len) or typed[result!].typeId != retainedFunction.typeId
            -> if { false -> return }
        result! -> retainedOwnerLiteralSlot(formalIr) => slot
        slot < 0 -> if { false -> return }
        owner! < 0 -> if { true -> return }
        prepared.semantic.fields[slot] => retainedField
        slot -> retainedOwnerFieldToken => retainedToken
        retainedToken < 0 -> if { false -> return }
        0 => use!
        use! < (typed -> len) -> while {
            use! != result! and use! != returnIr and (typed -> borrowedTextFunctionIr(use!)) == functionIr
                -> if {
                    typed[use!] => candidate
                    candidate.kind == 17 and use! != owner! and (owner! -> sameBindingName(use!))
                        -> if { false -> return }
                    candidate.kind == 5 and candidate.operand0 == owner! and use! != typed[returnIr].operand0
                        -> if {
                            contracts -> retainedOwnerReadonlyRead(use!, owner!)
                                -> unless { false -> return }
                        }
                    (candidate.kind == 24 or candidate.kind == 25) and candidate.operand1 == owner!
                        -> if {
                            candidate.kind != 25 or candidate.sourceModule < 0 or candidate.sourceModule >= (prepared.package.ranges -> len)
                                -> if { false -> return }
                            prepared.package.ranges[candidate.sourceModule] => range
                            candidate.astNode < 0 or candidate.astNode >= range.astCount
                                -> if { false -> return }
                            prepared.package.nodes[range.astStart + candidate.astNode] => assignment
                            assignment.secondaryToken < 0 -> if { false -> return }
                            retainedField.sourceModule -> tokenTextEquals(retainedToken, candidate.sourceModule, assignment.secondaryToken)
                                -> if { false -> return }
                            false => knownSibling!
                            prepared.semantic.fields -> each field {
                                field.status == 0 and field.ownerType == typed[owner!].typeId
                                    -> if {
                                        # Resolve the assignment slot from the same field table authority.
                                        field.fieldSymbol >= 0 and field.sourceModule >= 0 and field.sourceModule < (prepared.package.ranges -> len)
                                            -> if {
                                                prepared.package.ranges[field.sourceModule] => fieldRange
                                                field.fieldSymbol < fieldRange.symbolCount -> if {
                                                    prepared.package.symbols[fieldRange.symbolStart + field.fieldSymbol].nameToken => nameToken
                                                    field.sourceModule -> tokenTextEquals(nameToken, candidate.sourceModule, assignment.secondaryToken)
                                                        -> if { true => knownSibling! }
                                                }
                                            }
                                    }
                            }
