readonlyCarrierUseTouchesReference prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], typed: ref [typedIr.TypedIrNode; ~], useIndex: Int, carrierTypeId: Int -> Bool {
    # Projecting a scalar through ref T still reads the borrowed T storage.
    # Only a value aggregate's independent sibling field can end its ref loan.
    carrierTypeId >= 0 and carrierTypeId < (types -> len) and types[carrierTypeId].kind == 8
        -> if { true -> return }
