    borrowedBindingUsedAfterSite borrowedPrepared: ref semanticContext.SemanticSnapshot, borrowedTyped: ref [typedIr.TypedIrNode; ~], bindingIr: Int, siteIr: Int, carrierTypeId: Int, returnControls: ref [Bool; ~], referenceTypes: ref [Bool; ~], irIndex: ref OwnershipIrIndex -> Bool {
