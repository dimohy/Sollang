                branchReturn.kind == 23 and branchReturn.sourceModule == partialMove.sourceModule and (branchReturnSearch! -> moveRegionFor) == partialMove.regionIr and (prepared.package.nodes[branchRange.astStart + branchReturn.astNode].start > branchMoveStart or (partialMove.siteIr -> nodeBelongsTo(branchReturnSearch!)))
