            referenceCarrierCallOrdinal! < (referenceCallSites! -> len)
                -> while {
                    referenceCallSites![referenceCarrierCallOrdinal!] => referenceCarrierCallIndex
                    typed[referenceCarrierCallIndex] => referenceCall
                    false => referenceCallBelongsToCarrier!
                    referenceCarrierCallIndex == referenceCarrierValueIr
                        -> if { true => referenceCallBelongsToCarrier! }
                    referenceCarrierCallIndex => referenceCallAncestor!
                    not referenceCallBelongsToCarrier! and referenceCallAncestor! >= 0 and referenceCallAncestor! < (typed -> len)
                        -> while {
                            typed[referenceCallAncestor!].parent => referenceCallAncestor!
                            referenceCallAncestor! == referenceCarrierValueIr
                                -> if { true => referenceCallBelongsToCarrier! }
                        }
                    referenceCallBelongsToCarrier! and referenceCall.kind == 6 and referenceCall.operand0 >= 0
                        -> if {
                            [Int; ~] => referenceReturnOrigins!
                            0 => referenceReturnOriginIndex!
                            referenceReturnOriginIndex! < (readonlyReferenceReturns! -> len)
                                -> while {
                                    readonlyReferenceReturns![referenceReturnOriginIndex!] => origin
                                    origin.sourceModule == referenceCall.targetModule and origin.functionSymbol == referenceCall.symbol
                                        -> if {
                                            referenceReturnOrigins! -> push(referenceReturnOriginIndex!)
                                        }
                                    referenceReturnOriginIndex! + 1 => referenceReturnOriginIndex!
                                }
                            prepared -> readonlyReferenceCallLoans(typed, types, fields, referenceCarrierValueIr, referenceCarrierCallIndex) => referenceLoans
                            referenceLoans -> each referenceLoan {
                                0 => referenceMutationOrdinal!
                                referenceMutationOrdinal! < (referenceMutationSites! -> len)
                                    -> while {
                                        referenceMutationSites![referenceMutationOrdinal!] => referenceMutationIndex
                                        typed[referenceMutationIndex] => referenceMutation
                                        false => referenceMutationReported!
                                        0 => referenceOriginIndex!
                                        referenceOriginIndex! < (referenceReturnOrigins! -> len)
                                            -> while {
                                                readonlyReferenceReturns![referenceReturnOrigins![referenceOriginIndex!]] => referenceOrigin
                                                not referenceMutationReported!
                                                    -> if {
                                                        referenceCall.operand0 => referenceArgumentIr!
                                                        0 => referenceArgumentOrdinal!
                                                        referenceArgumentIr! >= 0 and referenceArgumentOrdinal! < referenceOrigin.parameterOrdinal
                                                            -> while {
                                                                typed[referenceArgumentIr!].nextOperand => referenceArgumentIr!
                                                                referenceArgumentOrdinal! + 1 => referenceArgumentOrdinal!
                                                            }
                                                        referenceArgumentIr! -> placeRootBinding => referenceOwnerBinding
                                                        false => mutatesReferenceOwner!
                                                        referenceOwnerBinding >= 0 and referenceMutation.kind == 25 and referenceMutation.sourceModule == typed[referenceOwnerBinding].sourceModule and referenceMutation.symbol == typed[referenceOwnerBinding].symbol and (referenceArgumentIr! -> referencePlaceOverlapsMemberAssignment(referenceMutationIndex))
                                                            -> if {
                                                                true => mutatesReferenceOwner!
                                                            }
                                                        referenceOwnerBinding >= 0 and referenceMutation.kind == 24 and (prepared -> indexAssignmentTargetsBinding(typed, referenceMutationIndex, referenceOwnerBinding)) and (prepared -> indexedReferenceOverlapsAssignment(typed, referenceArgumentIr!, referenceMutation.operand1))
                                                            -> if {
                                                                true => mutatesReferenceOwner!
                                                            }
                                                        # Rebinding the owner replaces its storage identity.
                                                        referenceOwnerBinding >= 0 and referenceMutation.kind == 17 and referenceMutationIndex != referenceOwnerBinding
                                                            -> if {
                                                                typed[referenceOwnerBinding] => referenceOwnerDefinition
                                                                referenceOwnerDefinition.sourceModule == referenceMutation.sourceModule and referenceOwnerDefinition.payloadToken >= 0 and referenceMutation.payloadToken >= 0
                                                                    -> if {
                                                                        prepared.package.ranges[referenceOwnerDefinition.sourceModule] => referenceRebindRange
                                                                        prepared.package.tokens[referenceRebindRange.tokenStart + referenceOwnerDefinition.payloadToken] => referenceOwnerName
                                                                        prepared.package.tokens[referenceRebindRange.tokenStart + referenceMutation.payloadToken] => referenceRebindName
                                                                        referenceOwnerName.span.length == referenceRebindName.span.length => sameReferenceOwnerName!
                                                                        UIntSize(0) => referenceOwnerNameByte!
                                                                        sameReferenceOwnerName! and referenceOwnerNameByte! < referenceOwnerName.span.length
                                                                            -> while {
                                                                                (prepared.package.sources[referenceOwnerDefinition.sourceModule] -> byte(referenceOwnerName.span.start + referenceOwnerNameByte!)) != (prepared.package.sources[referenceMutation.sourceModule] -> byte(referenceRebindName.span.start + referenceOwnerNameByte!))
                                                                                    -> if {
                                                                                        false => sameReferenceOwnerName!
                                                                                    }
                                                                                referenceOwnerNameByte! + 1 => referenceOwnerNameByte!
                                                                            }
                                                                        sameReferenceOwnerName! -> if { true => mutatesReferenceOwner! }
                                                                    }
                                                            }
                                                        # A consuming call or aggregate transfer invalidates
                                                        # the moved place. Whole-owner moves! overlap every
                                                        # projection; partial moves! retain place precision.
                                                        referenceMutationIndex => referenceMutationDiagnosticIr!
                                                        0 => referenceMoveIndex!
                                                        referenceOwnerBinding >= 0 and not mutatesReferenceOwner! and referenceMoveIndex! < (moves! -> len)
                                                            -> while {
                                                                moves![referenceMoveIndex!] => referenceMove
                                                                referenceMove.siteIr == referenceMutationIndex
                                                                    -> if {
                                                                        referenceMove.sourceModule == typed[referenceOwnerBinding].sourceModule and referenceMove.symbol == typed[referenceOwnerBinding].symbol
                                                                            -> if {
                                                                                referenceArgumentIr! -> placesOverlap(referenceMove.memberIr)
                                                                                    -> if {
                                                                                        true => mutatesReferenceOwner!
                                                                                        referenceMove.memberIr >= 0 -> if { referenceMove.memberIr } else { referenceMove.valueIr } => referenceMutationDiagnosticIr!
                                                                                    }
                                                                            }
                                                                    }
                                                                referenceMoveIndex! + 1 => referenceMoveIndex!
                                                            }
                                                        mutatesReferenceOwner! and referenceBindingIndex! < referenceMutationIndex
                                                            and (prepared -> borrowedTextBindingStartedBeforeSite(typed, types, callFunctionIndex, terminatingControls, referenceBindingIndex!, referenceMutationIndex))
                                                            -> if {
                                                                false => referenceBorrowUsedAfterMutation!
                                                                (referenceMutation.kind == 6 or referenceMutation.kind == 24) and (referenceLoan.path -> len) == 0
                                                                    -> if {
                                                                        prepared -> referenceBindingUsedAfterIndexSite(typed, referenceBindingIndex!, referenceMutationIndex) => referenceBorrowUsedAfterMutation!
                                                                        # A reference-bearing carrier can be consumed before the
                                                                        # mutation while a `when` payload alias remains live after
                                                                        # it. The direct-use fast path cannot see that alias edge;
                                                                        # reuse the field-sensitive carrier walk only on a miss.
                                                                        not referenceBorrowUsedAfterMutation! -> if {
                                                                            prepared -> borrowedBindingPathUsedAfterSite(typed, referenceBindingIndex!, referenceMutationIndex, referenceBindingCarrierType!, terminatingControls, referenceLoan.path, referenceViewTypes!, callFunctionIndex.irIndex) => referenceBorrowUsedAfterMutation!
                                                                        }
                                                                    } else {
                                                                        prepared -> borrowedBindingPathUsedAfterSite(typed, referenceBindingIndex!, referenceMutationIndex, referenceBindingCarrierType!, terminatingControls, referenceLoan.path, referenceViewTypes!, callFunctionIndex.irIndex) => referenceBorrowUsedAfterMutation!
                                                                    }
                                                                referenceBorrowUsedAfterMutation! -> if {
                                                                    prepared.package.ranges[referenceMutation.sourceModule] => referenceMutationRange
                                                                    typed[referenceMutationDiagnosticIr!] => referenceMutationDiagnostic
                                                                    prepared.package.nodes[referenceMutationRange.astStart + referenceMutationDiagnostic.astNode] => referenceMutationAst
                                                                    referenceMutationAst.start => referenceMutationStart!
                                                                    referenceMutation.kind == 17 or referenceMutation.kind == 24 or referenceMutation.kind == 25
                                                                        or referenceMutationDiagnostic.kind == 13 or referenceMutationDiagnostic.kind == 15
                                                                        -> if {
                                                                            prepared.package.tokens[referenceMutationRange.tokenStart + referenceMutationAst.payloadToken].span.start => referenceMutationStart!
                                                                        }
                                                                    diagnosticReferencePaths! -> len => referenceDiagnosticPath
                                                                    diagnosticReferencePaths! -> push(ReadonlyReferenceLoan { path: cloneReadonlyReferencePath(referenceLoan.path) })
                                                                    diagnostics! -> appendBodyDiagnostic(referenceMutationIndex, OwnershipDiagnostic {
                                                                        code: 23
                                                                        sourceModule: referenceMutation.sourceModule
                                                                        functionSymbol: referenceCall.symbol
                                                                        expectedOrigin: -1
                                                                        expectedModule: referenceArgumentIr!
                                                                        expectedSymbol: referenceOwnerBinding
                                                                        actualOrigin: -1
                                                                        actualModule: -1
                                                                        actualSymbol: referenceBindingIndex!
                                                                        actualBuiltin: -1
                                                                        readonlyReferencePath: referenceDiagnosticPath
                                                                        span: syntax.SourceSpan { fileId: referenceMutation.sourceModule, start: referenceMutationStart!, length: referenceMutationAst.start + referenceMutationAst.length - referenceMutationStart! }
                                                                    })
                                                                    true => referenceMutationReported!
                                                                }
                                                            }
                                                    }
                                                referenceOriginIndex! + 1 => referenceOriginIndex!
                                            }
                                        referenceMutationOrdinal! + 1 => referenceMutationOrdinal!
                                    }
                            }
                        }
                    referenceCarrierCallOrdinal! + 1 => referenceCarrierCallOrdinal!
                }
        }
        referenceBindingIndex! + 1 => referenceBindingIndex!
    }

    # Semantic type children precede their owners. Classify Text containment
    # once so aggregate-origin discovery is allocation-free and target-stable.
    [Bool; ~] => borrowedTextTypes!
    [Bool; ~] => borrowedTextViewTypes!
    0 => borrowedTextTypeIndex!
    borrowedTextTypeIndex! < (types -> len)
        -> while {
            types[borrowedTextTypeIndex!] => borrowedTextType
            (borrowedTextType.kind == 1 and borrowedTextType.origin == 1 and borrowedTextType.symbol == 1) => borrowedTextTypeContains!
            borrowedTextTypeContains! or (borrowedTextType.kind == 1 and borrowedTextType.origin == 1 and borrowedTextType.symbol == 24) => borrowedTextViewContains!
            borrowedTextType.kind == 2 or borrowedTextType.kind == 3 or borrowedTextType.kind == 4 or borrowedTextType.kind == 6 or borrowedTextType.kind == 7 or borrowedTextType.kind == 8
                -> if {
                    borrowedTextType.first >= 0 and borrowedTextType.first < (borrowedTextTypes! -> len) and borrowedTextTypes![borrowedTextType.first]
                        -> if { true => borrowedTextTypeContains! }
                    borrowedTextType.first >= 0 and borrowedTextType.first < (borrowedTextViewTypes! -> len) and borrowedTextViewTypes![borrowedTextType.first]
                        -> if { true => borrowedTextViewContains! }
                }
            # Both Result payloads can retain a borrowed Text/SourceText origin.
            borrowedTextType.kind == 5 or (borrowedTextType.kind == 7
                and borrowedTextType.origin == 4 and borrowedTextType.symbol == 1)
                -> if {
                    borrowedTextType.first >= 0 and borrowedTextType.first < (borrowedTextTypes! -> len) and borrowedTextTypes![borrowedTextType.first]
                        -> if { true => borrowedTextTypeContains! }
                    borrowedTextType.second >= 0 and borrowedTextType.second < (borrowedTextTypes! -> len) and borrowedTextTypes![borrowedTextType.second]
                        -> if { true => borrowedTextTypeContains! }
                    borrowedTextType.first >= 0 and borrowedTextType.first < (borrowedTextViewTypes! -> len) and borrowedTextViewTypes![borrowedTextType.first]
                        -> if { true => borrowedTextViewContains! }
                    borrowedTextType.second >= 0 and borrowedTextType.second < (borrowedTextViewTypes! -> len) and borrowedTextViewTypes![borrowedTextType.second]
                        -> if { true => borrowedTextViewContains! }
                }
            borrowedTextType.kind == 1 -> if {
                0 => borrowedTextFieldIndex!
                borrowedTextFieldIndex! < (prepared.semantic.fields -> len)
                    -> while {
                        prepared.semantic.fields[borrowedTextFieldIndex!] => borrowedTextField
                        borrowedTextField.ownerType == borrowedTextTypeIndex! and borrowedTextField.fieldType >= 0 and borrowedTextField.fieldType < (borrowedTextTypes! -> len) and borrowedTextTypes![borrowedTextField.fieldType]
                            -> if {
                                true => borrowedTextTypeContains!
                            }
                        borrowedTextField.ownerType == borrowedTextTypeIndex! and borrowedTextField.fieldType >= 0 and borrowedTextField.fieldType < (borrowedTextViewTypes! -> len) and borrowedTextViewTypes![borrowedTextField.fieldType]
                            -> if { true => borrowedTextViewContains! }
                        borrowedTextFieldIndex! + 1 => borrowedTextFieldIndex!
                    }
            }
            borrowedTextTypes! -> push(borrowedTextTypeContains!)
            borrowedTextViewTypes! -> push(borrowedTextViewContains!)
            borrowedTextTypeIndex! + 1 => borrowedTextTypeIndex!
        }

    # A Text returned from one or more default SourceText inputs inherits the
    # union of those symbolic origins. One contract row is recorded per source
    # parameter whose slice can reach a return, so callers keep every possible
    # owner alive without runtime metadata or explicit lifetime syntax.
    typed -> borrowedTextCanonicalArrayStoreSites(types, borrowedTextViewTypes!) => borrowedStoreSites
    # Return sites are immutable during inference. Keep their original order
    # within each function while avoiding a package-wide scan per parameter.
    [Int; ~] => firstBorrowedReturnByFunction!
    0 => borrowedReturnFunctionSlot!
    borrowedReturnFunctionSlot! < (typed -> len) -> while {
        firstBorrowedReturnByFunction! -> push(-1)
        borrowedReturnFunctionSlot! + 1 => borrowedReturnFunctionSlot!
    }
    [Int; ~] => nextBorrowedReturnSite!
    0 => borrowedReturnSiteSlot!
    borrowedReturnSiteSlot! < (borrowedReturnSites -> len)
        -> while {
            nextBorrowedReturnSite! -> push(-1)
            borrowedReturnSiteSlot! + 1 => borrowedReturnSiteSlot!
        }
    (borrowedReturnSites -> len) - 1 => borrowedReturnIndex!
    borrowedReturnIndex! >= 0 -> while {
        borrowedReturnSites[borrowedReturnIndex!] => indexedReturnIr
        typed[indexedReturnIr] => indexedReturn
        -1 => indexedReturnFunction!
        indexedReturn.kind == 1 -> if {
            indexedReturn.parent >= 0 and indexedReturn.parent < (typed -> len)
                -> if {
                    typed[indexedReturn.parent].kind == 0
                        -> if { indexedReturn.parent => indexedReturnFunction! }
                }
        }
        indexedReturn.kind == 23 -> if {
            typed -> borrowedTextFunctionIr(indexedReturnIr) => indexedReturnFunction!
        }
        indexedReturnFunction! >= 0 -> if {
            firstBorrowedReturnByFunction![indexedReturnFunction!] => nextBorrowedReturnSite![borrowedReturnIndex!]
            borrowedReturnIndex! => firstBorrowedReturnByFunction![indexedReturnFunction!]
        }
        borrowedReturnIndex! - 1 => borrowedReturnIndex!
    }
    [BorrowedTextReturn; ~] => borrowedReturns!
    true => borrowedReturnChanged!
    borrowedReturnChanged! -> while {
        false => borrowedReturnChanged!
        0 => borrowedFunctionIndex!
        borrowedFunctionIndex! < (typed -> len) -> while {
            typed[borrowedFunctionIndex!] => borrowedFunction
            # Reading a Text-containing input does not make a scalar result a view.
            # Keep unresolved generic results conservative until specialization.
            true => borrowedResultCanCarryText!
            borrowedFunction.typeId >= 0 and borrowedFunction.typeId < (borrowedTextViewTypes! -> len)
                -> if {
                    types[borrowedFunction.typeId].containsParameter
                        -> unless {
                            borrowedTextViewTypes![borrowedFunction.typeId] => borrowedResultCanCarryText!
                        }
                }
            borrowedFunction.kind == 0 and borrowedFunction.operand1 >= 0 and borrowedResultCanCarryText!
                -> if {
                    borrowedFunction.operand1 => borrowedParameterIr!
                    0 => borrowedParameterOrdinal!
                    borrowedParameterIr! >= 0 -> while {
                        typed[borrowedParameterIr!] => borrowedParameter
                        false => returnsSlice!
                        true => transfersBorrowedOwner!
                        false => borrowedParameterCarriesOrigin!
                        borrowedParameter -> borrowedTextParameterCarriesOrigin(prepared, types, borrowedTextViewTypes!) => borrowedParameterCarriesOrigin!
                        borrowedParameterCarriesOrigin! -> if {
                            firstBorrowedReturnByFunction![borrowedFunctionIndex!] => borrowedReturnSearch!
                            borrowedReturnSearch! >= 0
                                -> while {
                                    borrowedReturnSites[borrowedReturnSearch!] => borrowedReturnIr
                                    typed[borrowedReturnIr] => borrowedReturn
                                    (borrowedReturn.kind == 1 and borrowedReturn.parent == borrowedFunctionIndex!) or (borrowedReturn.kind == 23 and ((typed -> borrowedTextFunctionIr(borrowedReturnIr)) == borrowedFunctionIndex!))
                                        -> if {
                                            typed -> borrowedTextReturnQueryIr(borrowedReturnIr) => borrowedReturnQueryIr
                                            borrowedReturn.operand0 >= 0
                                                and (typed -> borrowedTextValueUsesOrigin(prepared, types, borrowedReturnQueryIr, borrowedStoreSites, terminatingControls, borrowedReturns!, callFunctionIndex, borrowedTextViewTypes!, borrowedReturn.operand0, borrowedParameterIr!))
                                                -> if {
                                                    true => returnsSlice!
                                                    borrowedReturns! -> returnsRetainedWholeOwner(borrowedFunctionIndex!, borrowedParameterIr!, borrowedReturnIr)
                                                        -> unless { false => transfersBorrowedOwner! }
                                                }
                                        }
                                    nextBorrowedReturnSite![borrowedReturnSearch!] => borrowedReturnSearch!
                                }
                            returnsSlice! -> if {
                                false => recordedOrigin!
                                0 => recordedOriginIndex!
                                recordedOriginIndex! < (borrowedReturns! -> len)
                                    -> while {
                                        borrowedReturns![recordedOriginIndex!] => recordedOrigin
                                        recordedOrigin.functionIr == borrowedFunctionIndex!
                                            and recordedOrigin.parameterOrdinal == borrowedParameterOrdinal!
                                            -> if {
                                                true => recordedOrigin!
                                                recordedOrigin.transfersOwner and not transfersBorrowedOwner!
                                                    -> if {
                                                        recordedOrigin => weakenedTransfer!
                                                        false => weakenedTransfer!.transfersOwner
                                                        weakenedTransfer! => borrowedReturns![recordedOriginIndex!]
                                                        true => borrowedReturnChanged!
                                                    }
                                            }
                                        recordedOriginIndex! + 1 => recordedOriginIndex!
                                    }
                                not recordedOrigin! -> if {
                                    borrowedReturns! -> push(BorrowedTextReturn {
                                        functionIr: borrowedFunctionIndex!
                                        sourceModule: borrowedFunction.sourceModule
                                        functionSymbol: borrowedFunction.symbol
                                        parameterOrdinal: borrowedParameterOrdinal!
                                        transfersOwner: transfersBorrowedOwner!
                                        concreteParameter: borrowedParameter.typeOrigin == 1 and (borrowedParameter.typeSymbol == 15 or borrowedParameter.typeSymbol == 24)
                                            or (types -> borrowedTextCanonicalByteArrayType(borrowedParameter.typeId))
                                            or (borrowedParameter.flags % 2 != 1 and (prepared -> semanticTypeContainsByteStorage(types, borrowedParameter.typeId)))
                                    })
                                    true => borrowedReturnChanged!
                                }
                            }
                        }
                        borrowedParameterIr! == borrowedFunction.operand1
                            -> if {
                                borrowedFunction.nextOperand => borrowedParameterIr!
                            } else {
                                borrowedParameter.nextOperand => borrowedParameterIr!
                            }
                        borrowedParameterOrdinal! + 1 => borrowedParameterOrdinal!
                    }
                }
            borrowedFunctionIndex! + 1 => borrowedFunctionIndex!
        }
    }

    # A region drops its local owners before its selected result continues.
    # Local escape candidates are immutable for this pass. Preserve ascending
    # IR order within each function and block instead of rescanning the package.
    [Int; ~] => firstLocalOwnerByFunction!
    [Int; ~] => nextLocalOwnerInFunction!
    {Int: Int; 16~} => firstLocalOwnerBySource!
    [Int; ~] => nextLocalOwnerInSource!
    [Int; ~] => firstBlockOwnerByParent!
    [Int; ~] => nextBlockOwnerByParent!
    0 => localOwnerSlot!
    localOwnerSlot! < (typed -> len) -> while {
        firstLocalOwnerByFunction! -> push(-1)
        nextLocalOwnerInFunction! -> push(-1)
        nextLocalOwnerInSource! -> push(-1)
        firstBlockOwnerByParent! -> push(-1)
        nextBlockOwnerByParent! -> push(-1)
        localOwnerSlot! + 1 => localOwnerSlot!
    }
    (typed -> len) - 1 => localOwnerIndex!
    localOwnerIndex! >= 0 -> while {
        typed[localOwnerIndex!] => indexedLocalOwner
        indexedLocalOwner.kind == 10 or indexedLocalOwner.kind == 17 or indexedLocalOwner.kind == 29
            -> if {
                firstLocalOwnerBySource! -> putIfAbsent(indexedLocalOwner.sourceModule, -1) => ownerSourceSeeded
                firstLocalOwnerBySource![indexedLocalOwner.sourceModule] => nextLocalOwnerInSource![localOwnerIndex!]
                localOwnerIndex! => firstLocalOwnerBySource![indexedLocalOwner.sourceModule]
                typed -> borrowedTextFunctionIr(localOwnerIndex!) => localOwnerFunction
                localOwnerFunction >= 0 -> if {
                    firstLocalOwnerByFunction![localOwnerFunction] => nextLocalOwnerInFunction![localOwnerIndex!]
                    localOwnerIndex! => firstLocalOwnerByFunction![localOwnerFunction]
                }
                (indexedLocalOwner.kind == 17 or indexedLocalOwner.kind == 29)
                    and indexedLocalOwner.parent >= 0 and indexedLocalOwner.parent < (typed -> len)
                    -> if {
                        firstBlockOwnerByParent![indexedLocalOwner.parent] => nextBlockOwnerByParent![localOwnerIndex!]
                        localOwnerIndex! => firstBlockOwnerByParent![indexedLocalOwner.parent]
                    }
            }
        localOwnerIndex! - 1 => localOwnerIndex!
    }

    # Only a Text result carries this block loan: scalar projections are copied,
    # while an owned aggregate may transfer its backing with its fields.
    0 => textBlockIr!
    textBlockIr! < (typed -> len) -> while {
        typed[textBlockIr!] => textBlock
        textBlock.kind == 19
            -> if {
                typed -> borrowedTextRegionResultIr(textBlockIr!) => textBlockResultIr
                textBlockResultIr >= 0 and textBlockResultIr < (typed -> len)
                    -> if {
                        typed[textBlockResultIr] => textResult
                        textResult.typeOrigin == 1 and textResult.typeSymbol == 1
                            -> if {
                                firstBlockOwnerByParent![textBlockIr!] => textBlockOwnerIr!
                                false => textBlockReported!
                                textBlockOwnerIr! >= 0 and not textBlockReported!
                                    -> while {
                                        typed[textBlockOwnerIr!] => textBlockOwner
                                        (textBlockOwner.kind == 17 or textBlockOwner.kind == 29)
                                            and textBlockOwner.parent == textBlockIr!
                                            and (typed -> borrowedTextFunctionIr(textBlockOwnerIr!)) == (typed -> borrowedTextFunctionIr(textBlockIr!))
                                            -> if {
                                                typed -> borrowedTextValueOriginFact(prepared, types, textBlockResultIr, borrowedStoreSites, terminatingControls, borrowedReturns!, callFunctionIndex, borrowedTextViewTypes!, false, textBlockResultIr, textBlockOwnerIr!) => textBlockOrigin
                                                textBlockOrigin.status == 2 and textBlockOrigin.usesOrigin
                                                    -> if {
                                                        prepared.package.ranges[textResult.sourceModule] => textBlockRange
                                                        prepared.package.nodes[textBlockRange.astStart + textResult.astNode] => textBlockAst
                                                        diagnostics! -> appendBodyDiagnostic(textBlockIr!, OwnershipDiagnostic {
                                                            code: borrowedTextBlockEscapeCode()
                                                            sourceModule: textResult.sourceModule
                                                            functionSymbol: -1
                                                            expectedOrigin: -1
                                                            expectedModule: textBlockOrigin.placeIr
                                                            expectedSymbol: textBlockOwnerIr!
                                                            actualOrigin: -1
                                                            actualModule: -1
                                                            actualSymbol: textBlockResultIr
                                                            actualBuiltin: textBlock.kind
                                                            readonlyReferencePath: -1
                                                            span: syntax.SourceSpan { fileId: textResult.sourceModule, start: textBlockAst.start, length: textBlockAst.length }
                                                        })
                                                        true => textBlockReported!
                                                    }
                                            }
                                        nextBlockOwnerByParent![textBlockOwnerIr!] => textBlockOwnerIr!
                                    }
                            }
                    }
            }
        textBlockIr! + 1 => textBlockIr!
    }

    [Int; ~] => localEscapeFunctionIrs!
    # Reject return views retaining a local Arena or mapped SourceText. Parameter
    # owners remain outside the function and are not local escape candidates.
    0 => borrowedEscapeReturn!
    borrowedEscapeReturn! < (typed -> len) -> while {
        typed[borrowedEscapeReturn!] => escapedReturn
        (escapedReturn.kind == 1 or escapedReturn.kind == 23) and escapedReturn.operand0 >= 0
            -> if {
                typed -> borrowedTextFunctionIr(borrowedEscapeReturn!) => escapeFunction
                escapeFunction >= 0 and typed[escapeFunction].typeId >= 0
                    and typed[escapeFunction].typeId < (borrowedTextViewTypes! -> len)
                    and borrowedTextViewTypes![typed[escapeFunction].typeId]
                    -> if {
                        firstLocalOwnerByFunction![escapeFunction] => escapeOwner!
                        false => escapeReported!
                        escapeOwner! >= 0 and not escapeReported!
                            -> while {
                                typed[escapeOwner!] => localOwner
                                (localOwner.kind == 17 or localOwner.kind == 29 or localOwner.kind == 10)
                                    and ((typed -> borrowedTextFunctionIr(escapeOwner!)) == escapeFunction)
                                    and (localOwner.kind != 10 or (localOwner.flags % 2 == 1
                                    and (prepared -> semanticTypeContainsOwnedStorageCached(types, fields, ownedStorageByType!, localOwner.typeId))
                                    and not (escapedReturn.operand0 -> retainedAggregateReturn(escapeOwner!))
                                    and not (borrowedReturns! -> returnsRetainedWholeOwner(escapeFunction, escapeOwner!, borrowedEscapeReturn!))))
                                    -> if {
                                        typed -> borrowedTextReturnQueryIr(borrowedEscapeReturn!) => escapeQueryIr
                                        typed -> borrowedTextReturnOriginFact(prepared, types, escapeQueryIr, borrowedStoreSites, terminatingControls, borrowedReturns!, callFunctionIndex, borrowedTextViewTypes!, escapedReturn.operand0, escapeOwner!) => escapeOrigin
                                        escapeOrigin.status == 2 and escapeOrigin.usesOrigin
                                            -> if {
                                                typed[escapedReturn.operand0] => escapedValue
                                                prepared.package.ranges[escapedReturn.sourceModule] => escapeRange
                                                prepared.package.nodes[escapeRange.astStart + escapedValue.astNode] => escapeAst
                                                localEscapeFunctionIrs! -> push(escapeFunction)
                                                diagnostics! -> appendBodyDiagnostic(borrowedEscapeReturn!, OwnershipDiagnostic {
                                                    code: borrowedTextReturnEscapeCode()
                                                    sourceModule: escapedReturn.sourceModule
                                                    functionSymbol: typed[escapeFunction].symbol
                                                    expectedOrigin: -1
                                                    expectedModule: escapeOrigin.placeIr
                                                    expectedSymbol: escapeOwner!
                                                    actualOrigin: -1
                                                    actualModule: -1
                                                    actualSymbol: escapedReturn.operand0
                                                    actualBuiltin: escapedReturn.kind
                                                    readonlyReferencePath: -1
                                                    span: syntax.SourceSpan { fileId: escapedReturn.sourceModule, start: escapeAst.start, length: escapeAst.length }
                                                })
                                                true => escapeReported!
                                            }
                                    }
                                nextLocalOwnerInFunction![escapeOwner!] => escapeOwner!
                            }
                    }
            }
        borrowedEscapeReturn! + 1 => borrowedEscapeReturn!
    }

    # A missing contract is not a proven empty origin. C# checks this only
    # for Text-containing returns with an origin-bearing input and slice flow.
    0 => inferenceFunction!
    inferenceFunction! < (typed -> len) -> while {
        typed[inferenceFunction!] => function
        function.kind == 0 and function.typeId >= 0 and function.typeId < (borrowedTextTypes! -> len)
            and borrowedTextTypes![function.typeId] -> if {
                false => hasOriginInput!
                function.operand1 => formal!
                0 => formalEdges!
                formal! < 0 -> if {
                    function.nextOperand => formal!
                }
                formal! >= 0 and formal! < (typed -> len) and formalEdges! < (typed -> len)
                    -> while {
                        typed[formal!] -> borrowedTextParameterCarriesOrigin(prepared, types, borrowedTextViewTypes!)
                            -> if { true => hasOriginInput! }
                        formal! == function.operand1 -> if {
                            function.nextOperand => formal!
                        } else { typed[formal!].nextOperand => formal! }
                        formalEdges! + 1 => formalEdges!
                    }
                false => hasContract!
                borrowedReturns! -> each contract {
                    contract.functionIr == inferenceFunction!
                        -> if { true => hasContract! }
                }
                false => hasLocalEscape!
                localEscapeFunctionIrs! -> each localEscapeFunction {
                    localEscapeFunction == inferenceFunction! -> if { true => hasLocalEscape! }
                }
                hasOriginInput! and not hasContract! and not hasLocalEscape! => needsInference
                needsInference -> if {
                    false => containsSlice!
                    inferenceFunction! + 1 => bodyIr!
                    bodyIr! < (typed -> len) and typed[bodyIr!].kind != 0
                        -> while {
                            (typed[bodyIr!].kind == 6 or typed[bodyIr!].kind == 9) and typed[bodyIr!].opcode == -203
                                and (typed -> borrowedTextFunctionIr(bodyIr!)) == inferenceFunction!
                                -> if { true => containsSlice! }
                            bodyIr! + 1 => bodyIr!
                        }
                    containsSlice! -> if {
                        prepared.package.ranges[function.sourceModule] => range
                        prepared.package.symbols[range.symbolStart + function.symbol] => declaration
                        prepared.package.tokens[range.tokenStart + declaration.nameToken] => name
                        diagnostics! -> appendBodyDiagnostic(inferenceFunction!, OwnershipDiagnostic {
                            code: borrowedTextReturnInferenceCode()
                            sourceModule: function.sourceModule
                            functionSymbol: function.symbol
                            expectedOrigin: -1
                            expectedModule: -1
                            expectedSymbol: inferenceFunction!
                            actualOrigin: -1
                            actualModule: -1
                            actualSymbol: inferenceFunction!
                            actualBuiltin: -1
                            readonlyReferencePath: -1
                            span: name.span
                        })
                    }
                }
            }
        inferenceFunction! + 1 => inferenceFunction!
    }

    # Direct storage owners are an existing concrete-place subset. Collect them
    # once; composite storage and projected fields retain their separate rules.
    [Int; ~] => directBorrowStorageOwners!
    0 => directBorrowStorageSearch!
    directBorrowStorageSearch! < (typed -> len) -> while {
        typed[directBorrowStorageSearch!] => directBorrowStorage
        (directBorrowStorage.kind == 10 or directBorrowStorage.kind == 17 or directBorrowStorage.kind == 29)
            and directBorrowStorage.typeId >= 0 and directBorrowStorage.typeId < (types -> len)
            -> if {
                types -> typeIds.materializedReadTypeId(directBorrowStorage.typeId) => directBorrowStorageTypeId
                directBorrowStorageTypeId >= 0 and directBorrowStorageTypeId < (types -> len)
                    -> if {
                        types[directBorrowStorageTypeId] => directBorrowStorageType
                        directBorrowStorageType.status == 0 and not directBorrowStorageType.containsParameter
                            and ((directBorrowStorageType.kind == 1 and directBorrowStorageType.origin == 1
                            and (directBorrowStorageType.symbol == 15 or directBorrowStorageType.symbol == 24))
                            or (types -> borrowedTextCanonicalByteArrayType(directBorrowStorage.typeId)))
                            -> if { directBorrowStorageOwners! -> push(directBorrowStorageSearch!) }
                    }
            }
        directBorrowStorageSearch! + 1 => directBorrowStorageSearch!
    }

    # Field candidates use committed types and exact lexical owner identity.
    # Separate binding rows retain both possible branch places without a new domain.
    [BorrowedTextBinding; ~] => independentBorrowFieldPlaces!
    0 => independentBorrowFieldSearch!
    independentBorrowFieldSearch! < (typed -> len)
        -> while {
            typed[independentBorrowFieldSearch!] => field
            field.kind == 13 -> if {
                prepared -> borrowedTextOwnedFieldRoot(types, typed, independentBorrowFieldSearch!, 0) => owner
                owner >= 0 and (prepared -> semanticTypeContainsOwnedStorageCached(types, fields, ownedStorageByType!, field.typeId))
                    and (prepared -> borrowedTextIndependentFieldType(types, field.typeId, 0))
                    -> if {
                        independentBorrowFieldPlaces! -> push(BorrowedTextBinding {
                            bindingIr: -1
                            ownerBindingIr: owner
                            ownerPlaceIr: independentBorrowFieldSearch!
                        })
                    }
            }
            independentBorrowFieldSearch! + 1 => independentBorrowFieldSearch!
        }

    [BorrowedTextBinding; ~] => borrowedBindings!
    0 => borrowedBindingSearch!
    borrowedBindingSearch! < (typed -> len) -> while {
        typed[borrowedBindingSearch!] => borrowedBinding
        borrowedBinding.kind == 17 and borrowedBinding.operand0 >= 0
            -> if {
                typed[borrowedBinding.operand0] => borrowedCall
                borrowedCall.kind == 6 -> if {
                    typed -> borrowedTextSelectedCallFunctionIr(borrowedReturns!, callFunctionIndex, borrowedBinding.operand0) => selectedBorrowedFunction
                    0 => borrowedReturnIndex!
                    borrowedReturnIndex! < (borrowedReturns! -> len)
                        -> while {
                            borrowedReturns![borrowedReturnIndex!] => borrowedReturnContract
                            selectedBorrowedFunction >= 0 and selectedBorrowedFunction == borrowedReturnContract.functionIr
                                -> if {
                                    borrowedCall.operand0 => borrowedCallArgumentIr!
                                    0 => borrowedCallArgumentOrdinal!
                                    borrowedCallArgumentIr! >= 0 and borrowedCallArgumentOrdinal! < borrowedReturnContract.parameterOrdinal
                                        -> while {
                                            typed[borrowedCallArgumentIr!].nextOperand => borrowedCallArgumentIr!
                                            borrowedCallArgumentOrdinal! + 1 => borrowedCallArgumentOrdinal!
                                        }
                                    borrowedCallArgumentIr! >= 0 -> if {
                                        typed[borrowedCallArgumentIr!] => borrowedCallSource
                                        firstLocalOwnerBySource![borrowedBinding.sourceModule] => borrowedCallRootBinding!
                                        borrowedCallRootBinding! >= 0 and borrowedCallRootBinding! < (typed -> len)
                                            -> while {
                                                typed[borrowedCallRootBinding!] => possibleOrigin
                                                BorrowedTextOriginFact { status: 0, usesOrigin: false, placeIr: -1 } => selectedArgumentOrigin!
                                                (possibleOrigin.kind == 10 or possibleOrigin.kind == 17 or possibleOrigin.kind == 29)
                                                    and borrowedCallRootBinding! != borrowedBindingSearch!
                                                    and possibleOrigin.sourceModule == borrowedBinding.sourceModule
                                                    -> if {
                                                        typed -> borrowedTextCallArgumentOriginFact(prepared, types, borrowedBinding.operand0, borrowedStoreSites, terminatingControls, borrowedReturns!, callFunctionIndex, borrowedTextViewTypes!, borrowedCallArgumentIr!, borrowedCallRootBinding!, borrowedReturnContract) => selectedArgumentOrigin!
                                                    }
                                                selectedArgumentOrigin!.status == 2 and selectedArgumentOrigin!.usesOrigin
                                                    -> if {
                                                        false => propagatedBorrowedOwner!
                                                        0 => inheritedBorrowedOwnerSearch!
                                                        inheritedBorrowedOwnerSearch! < (borrowedBindings! -> len)
                                                            -> while {
                                                                borrowedBindings![inheritedBorrowedOwnerSearch!] => inheritedBorrowedOwner
                                                                inheritedBorrowedOwner.bindingIr == borrowedCallRootBinding!
                                                                    -> if {
                                                                        false => duplicateInheritedBorrowedOwner!
                                                                        0 => inheritedBorrowedOwnerDuplicateSearch!
                                                                        inheritedBorrowedOwnerDuplicateSearch! < (borrowedBindings! -> len)
                                                                            -> while {
                                                                                borrowedBindings![inheritedBorrowedOwnerDuplicateSearch!] => existingInheritedBorrowedOwner
                                                                                existingInheritedBorrowedOwner.bindingIr == borrowedBindingSearch! and existingInheritedBorrowedOwner.ownerBindingIr == inheritedBorrowedOwner.ownerBindingIr and existingInheritedBorrowedOwner.ownerPlaceIr == inheritedBorrowedOwner.ownerPlaceIr
                                                                                    -> if {
                                                                                        true => duplicateInheritedBorrowedOwner!
                                                                                    }
                                                                                inheritedBorrowedOwnerDuplicateSearch! + 1 => inheritedBorrowedOwnerDuplicateSearch!
                                                                            }
                                                                        not duplicateInheritedBorrowedOwner! -> if {
                                                                            borrowedBindings! -> push(BorrowedTextBinding {
                                                                                bindingIr: borrowedBindingSearch!
                                                                                ownerBindingIr: inheritedBorrowedOwner.ownerBindingIr
                                                                                ownerPlaceIr: inheritedBorrowedOwner.ownerPlaceIr
                                                                            })
                                                                        }
                                                                        true => propagatedBorrowedOwner!
                                                                    }
                                                                inheritedBorrowedOwnerSearch! + 1 => inheritedBorrowedOwnerSearch!
                                                            }
                                                        not propagatedBorrowedOwner! and not borrowedReturnContract.transfersOwner
                                                            -> if {
                                                                borrowedCallArgumentIr! => borrowedOwnerPlaceIr!
                                                                false => canonicalWholeBorrowedOwner!
                                                                directBorrowStorageOwners! -> each directBorrowOwnerIr {
                                                                    directBorrowOwnerIr == borrowedCallRootBinding!
                                                                        -> if {
                                                                            typed -> borrowedTextValueOriginFact(prepared, types, borrowedBinding.operand0, borrowedStoreSites, terminatingControls, borrowedReturns!, callFunctionIndex, borrowedTextViewTypes!, true, borrowedCallArgumentIr!, borrowedCallRootBinding!) => borrowedOwnerOrigin
                                                                            borrowedOwnerOrigin.status == 2 and borrowedOwnerOrigin.usesOrigin
                                                                                and borrowedOwnerOrigin.placeIr >= 0 and borrowedOwnerOrigin.placeIr < (typed -> len)
                                                                                and (typed -> resolvedPlaceRootBinding(borrowedOwnerOrigin.placeIr)) == borrowedCallRootBinding!
                                                                                and (typed -> resolvedPlaceProjectionDepth(borrowedOwnerOrigin.placeIr)) == 0
                                                                                -> if {
                                                                                    borrowedOwnerOrigin.placeIr => borrowedOwnerPlaceIr!
                                                                                    true => canonicalWholeBorrowedOwner!
                                                                                }
                                                                        }
                                                                }
                                                                false => duplicateBorrowedOwner!
                                                                0 => borrowedOwnerSearch!
                                                                borrowedOwnerSearch! < (borrowedBindings! -> len)
                                                                    -> while {
                                                                        borrowedBindings![borrowedOwnerSearch!] => existingBorrowedOwner
                                                                        existingBorrowedOwner.bindingIr == borrowedBindingSearch! and existingBorrowedOwner.ownerBindingIr == borrowedCallRootBinding!
                                                                            and (existingBorrowedOwner.ownerPlaceIr == borrowedOwnerPlaceIr!
                                                                            or (canonicalWholeBorrowedOwner!
                                                                            and (typed -> resolvedPlaceRootBinding(existingBorrowedOwner.ownerPlaceIr)) == borrowedCallRootBinding!
                                                                            and (typed -> resolvedPlaceProjectionDepth(existingBorrowedOwner.ownerPlaceIr)) == 0))
                                                                            -> if {
                                                                                true => duplicateBorrowedOwner!
                                                                            }
                                                                        borrowedOwnerSearch! + 1 => borrowedOwnerSearch!
                                                                    }
                                                                not duplicateBorrowedOwner! -> if {
                                                                    borrowedBindings! -> push(BorrowedTextBinding {
                                                                        bindingIr: borrowedBindingSearch!
                                                                        ownerBindingIr: borrowedCallRootBinding!
                                                                        ownerPlaceIr: borrowedOwnerPlaceIr!
                                                                    })
                                                                }
                                                            }
                                                    }
                                                nextLocalOwnerInSource![borrowedCallRootBinding!] => borrowedCallRootBinding!
                                            }
                                    }
                                }
                            borrowedReturnIndex! + 1 => borrowedReturnIndex!
                        }
                }
                # Typed origin facts apply to every initializer shape, including
                # selected calls and compiler-owned call shells. Register actual
                # upstream loans, not synthetic owners consumed by the initializer.
                borrowedBinding.typeId >= 0 and borrowedBinding.typeId < (borrowedTextViewTypes! -> len)
                    and borrowedTextViewTypes![borrowedBinding.typeId]
                    -> if {
                        typed -> borrowedTextFunctionIr(borrowedBindingSearch!) => directBorrowDestinationFunction
                        independentBorrowFieldPlaces! -> each fieldPlace {
                            typed[fieldPlace.ownerBindingIr] => fieldOwner
                            fieldOwner.sourceModule == borrowedBinding.sourceModule
                                and (typed -> borrowedTextFunctionIr(fieldPlace.ownerBindingIr)) == directBorrowDestinationFunction
                                and fieldPlace.ownerBindingIr != borrowedBindingSearch!
                                -> if {
                                    typed -> borrowedTextValueOriginFact(prepared, types, borrowedBindingSearch!, borrowedStoreSites, terminatingControls, borrowedReturns!, callFunctionIndex, borrowedTextViewTypes!, false, borrowedBinding.operand0, fieldPlace.ownerPlaceIr) => fieldOrigin
                                    fieldOrigin.status == 2 and fieldOrigin.usesOrigin
                                        -> if {
                                            fieldPlace.ownerBindingIr => loanPlace!
                                            fieldOrigin.placeIr >= 0 and fieldOrigin.placeIr < (typed -> len)
                                                and (typed -> resolvedSameOwnedFieldPlace(fieldOrigin.placeIr, fieldPlace.ownerPlaceIr))
                                                -> if { fieldOrigin.placeIr => loanPlace! }
                                            # Unknown/whole origins remain whole-owner rows, never narrowed.
                                            false => duplicateFieldLoan!
                                            borrowedBindings! -> each existingFieldLoan {
                                                existingFieldLoan.bindingIr == borrowedBindingSearch!
                                                    and existingFieldLoan.ownerBindingIr == fieldPlace.ownerBindingIr
                                                    and (existingFieldLoan.ownerPlaceIr == loanPlace!
                                                    or (typed -> resolvedSameOwnedFieldPlace(existingFieldLoan.ownerPlaceIr, loanPlace!)))
                                                    -> if { true => duplicateFieldLoan! }
                                            }
                                            not duplicateFieldLoan! -> if {
                                                borrowedBindings! -> push(BorrowedTextBinding {
                                                    bindingIr: borrowedBindingSearch!
                                                    ownerBindingIr: fieldPlace.ownerBindingIr
                                                    ownerPlaceIr: loanPlace!
                                                })
                                            }
                                        }
                                }
                        }
                        directBorrowStorageOwners! -> each directBorrowOwnerIr {
                            typed[directBorrowOwnerIr] => directBorrowOwner
                            directBorrowOwnerIr != borrowedBindingSearch!
                                and directBorrowDestinationFunction >= -1
                                and directBorrowOwner.sourceModule == borrowedBinding.sourceModule
                                and (typed -> borrowedTextFunctionIr(directBorrowOwnerIr)) == directBorrowDestinationFunction
                                -> if {
                                    typed -> borrowedTextValueOriginFact(prepared, types, borrowedBindingSearch!, borrowedStoreSites, terminatingControls, borrowedReturns!, callFunctionIndex, borrowedTextViewTypes!, false, borrowedBinding.operand0, directBorrowOwnerIr) => directBorrowOrigin
                                    directBorrowOrigin.status == 2 and directBorrowOrigin.usesOrigin
                                        and directBorrowOrigin.placeIr >= 0 and directBorrowOrigin.placeIr < (typed -> len)
                                        and (typed -> resolvedPlaceRootBinding(directBorrowOrigin.placeIr)) == directBorrowOwnerIr
                                        and (typed -> resolvedPlaceProjectionDepth(directBorrowOrigin.placeIr)) == 0
                                        -> if {
                                            false => duplicateDirectBorrow!
                                            borrowedBindings! -> each existingDirectBorrow {
                                                existingDirectBorrow.bindingIr == borrowedBindingSearch!
                                                    and existingDirectBorrow.ownerBindingIr == directBorrowOwnerIr
                                                    and (typed -> resolvedPlaceRootBinding(existingDirectBorrow.ownerPlaceIr)) == directBorrowOwnerIr
                                                    and (typed -> resolvedPlaceProjectionDepth(existingDirectBorrow.ownerPlaceIr)) == 0
                                                    -> if { true => duplicateDirectBorrow! }
                                            }
                                            not duplicateDirectBorrow! -> if {
                                                borrowedBindings! -> push(BorrowedTextBinding {
                                                    bindingIr: borrowedBindingSearch!
                                                    ownerBindingIr: directBorrowOwnerIr
                                                    ownerPlaceIr: directBorrowOrigin.placeIr
                                                })
                                            }
                                        }
                                }
                        }
                    }
            }
        borrowedBindingSearch! + 1 => borrowedBindingSearch!
    }

    # A successful append creates another existing loan entry on the exact
    # receiver definition. Its payload is queried at the commit's pre-state.
    # Visibility is checked again at each mutation; future stores do not expire
    # or introduce a loan in an earlier evaluation.
    borrowedStoreSites -> each storedBorrowSiteIr {
        typed[storedBorrowSiteIr] => storedBorrowSite
        typed -> resolvedPlaceRootBinding(storedBorrowSite.operand0) => storedBorrowReceiver
        storedBorrowReceiver >= 0 -> if {
            typed -> borrowedTextFunctionIr(storedBorrowSiteIr) => storedBorrowFunction
            0 => storedBorrowOwnerIr!
            storedBorrowFunction >= 0 -> if {
                firstLocalOwnerByFunction![storedBorrowFunction] => storedBorrowOwnerIr!
            }
            storedBorrowOwnerIr! >= 0 and storedBorrowOwnerIr! < (typed -> len)
                -> while {
                    typed[storedBorrowOwnerIr!] => storedBorrowOwner
                    (storedBorrowOwner.kind == 10 or storedBorrowOwner.kind == 17 or storedBorrowOwner.kind == 29)
                        and storedBorrowOwner.sourceModule == storedBorrowSite.sourceModule
                        and (typed -> borrowedTextFunctionIr(storedBorrowOwnerIr!)) == storedBorrowFunction
                        and storedBorrowOwner.typeId >= 0 and storedBorrowOwner.typeId < (types -> len)
                        and (prepared -> semanticTypeContainsOwnedStorageCached(types, fields, ownedStorageByType!, storedBorrowOwner.typeId))
                        -> if {
                            typed -> borrowedTextValueOriginFact(prepared, types, storedBorrowSiteIr, borrowedStoreSites, terminatingControls, borrowedReturns!, callFunctionIndex, borrowedTextViewTypes!, false, storedBorrowSite.operand1, storedBorrowOwnerIr!) => storedBorrowOrigin
                            storedBorrowOrigin.status == 2 and storedBorrowOrigin.usesOrigin
                                -> if {
                                    storedBorrowOrigin.placeIr => storedBorrowPlace!
                                    storedBorrowPlace! < 0 -> if { storedBorrowOwnerIr! => storedBorrowPlace! }
                                    false => duplicateStoredBorrow!
                                    borrowedBindings! -> each existingStoredBorrow {
                                        existingStoredBorrow.bindingIr == storedBorrowReceiver
                                            and existingStoredBorrow.ownerBindingIr == storedBorrowOwnerIr!
                                            and existingStoredBorrow.ownerPlaceIr == storedBorrowPlace!
                                            -> if { true => duplicateStoredBorrow! }
                                    }
                                    not duplicateStoredBorrow! -> if {
                                        borrowedBindings! -> push(BorrowedTextBinding {
                                            bindingIr: storedBorrowReceiver
                                            ownerBindingIr: storedBorrowOwnerIr!
                                            ownerPlaceIr: storedBorrowPlace!
                                        })
                                    }
                                }
                        }
                    storedBorrowFunction >= 0 -> if {
                        nextLocalOwnerInFunction![storedBorrowOwnerIr!] => storedBorrowOwnerIr!
                    } else {
                        storedBorrowOwnerIr! + 1 => storedBorrowOwnerIr!
                    }
                }
        }
    }

    # A binding-to-binding assignment transfers the symbolic origin set. Each
    # mutable rebind already has a distinct typed-IR definition, so assigning an
    # owned/static Text creates no edge and naturally kills the previous loan.
    # Iterate to a fixed point so alias chains preserve every union-origin edge.
    true => borrowedAliasChanged!
    borrowedAliasChanged! -> while {
        false => borrowedAliasChanged!
        0 => borrowedAliasBindingSearch!
        borrowedAliasBindingSearch! < (typed -> len)
            -> while {
                typed[borrowedAliasBindingSearch!] => borrowedAliasBinding
                borrowedAliasBinding.kind == 17 and borrowedAliasBinding.operand0 >= 0
                    -> if {
                        typed[borrowedAliasBinding.operand0] => borrowedAliasValue
                        borrowedAliasValue.kind == 5 and borrowedAliasValue.operand0 >= 0
                            -> if {
                                0 => borrowedAliasOriginSearch!
                                borrowedAliasOriginSearch! < (borrowedBindings! -> len)
                                    -> while {
                                        borrowedBindings![borrowedAliasOriginSearch!] => borrowedAliasOrigin
                                        borrowedAliasOrigin.bindingIr == borrowedAliasValue.operand0
                                            -> if {
                                                false => duplicateBorrowedAlias!
                                                0 => borrowedAliasDuplicateSearch!
                                                borrowedAliasDuplicateSearch! < (borrowedBindings! -> len)
                                                    -> while {
                                                        borrowedBindings![borrowedAliasDuplicateSearch!] => existingBorrowedAlias
                                                        existingBorrowedAlias.bindingIr == borrowedAliasBindingSearch! and existingBorrowedAlias.ownerBindingIr == borrowedAliasOrigin.ownerBindingIr and existingBorrowedAlias.ownerPlaceIr == borrowedAliasOrigin.ownerPlaceIr
                                                            -> if {
                                                                true => duplicateBorrowedAlias!
                                                            }
                                                        borrowedAliasDuplicateSearch! + 1 => borrowedAliasDuplicateSearch!
                                                    }
                                                not duplicateBorrowedAlias! -> if {
                                                    borrowedBindings! -> push(BorrowedTextBinding {
                                                        bindingIr: borrowedAliasBindingSearch!
                                                        ownerBindingIr: borrowedAliasOrigin.ownerBindingIr
                                                        ownerPlaceIr: borrowedAliasOrigin.ownerPlaceIr
                                                    })
                                                    true => borrowedAliasChanged!
                                                }
                                            }
                                        borrowedAliasOriginSearch! + 1 => borrowedAliasOriginSearch!
                                    }
                            }
                    }
                borrowedAliasBindingSearch! + 1 => borrowedAliasBindingSearch!
            }
    }

    # A mutable borrow can grow or otherwise rewrite an Arena/container. It is
    # therefore an origin-invalidating site while a returned Text view remains
    # reachable, even though ownership itself does not move.
    0 => borrowedMutableSiteIndex!
    borrowedMutableSiteIndex! < (mutableBorrowSites! -> len)
        -> while {
            mutableBorrowSites![borrowedMutableSiteIndex!] => borrowedMutableSite
            borrowedMutableSite.argumentIr -> placeRootBinding => borrowedMutableOwnerBinding
            borrowedMutableOwnerBinding >= 0 -> if {
                0 => activeMutableBorrowIndex!
                activeMutableBorrowIndex! < (borrowedBindings! -> len)
                    -> while {
                        borrowedBindings![activeMutableBorrowIndex!] => activeMutableBorrow
                        activeMutableBorrow.ownerBindingIr == borrowedMutableOwnerBinding
                            and (activeMutableBorrow.ownerPlaceIr -> placesOverlap(borrowedMutableSite.argumentIr))
                            and (typed[activeMutableBorrow.bindingIr].kind == 10
                            or (prepared -> borrowedTextBindingStartedBeforeSite(typed, types, callFunctionIndex, terminatingControls, activeMutableBorrow.bindingIr, borrowedMutableSite.siteIr)))
                            and not (borrowedMutableSite.siteIr -> nodeBelongsTo(activeMutableBorrow.bindingIr))
                            and (typed -> borrowedTextValueUsesConcreteOrigin(prepared, types, borrowedMutableSite.siteIr, borrowedStoreSites, terminatingControls, borrowedReturns!, callFunctionIndex, borrowedTextViewTypes!, activeMutableBorrow.bindingIr, activeMutableBorrow.ownerBindingIr))
                            and (prepared -> borrowedBindingUsedAfterSite(typed, activeMutableBorrow.bindingIr, borrowedMutableSite.siteIr, -1, terminatingControls, referenceViewTypes!, callFunctionIndex.irIndex))
                            -> if {
                                typed[borrowedMutableSite.argumentIr] => borrowedMutableArgument
                                prepared.package.ranges[borrowedMutableArgument.sourceModule] => borrowedMutableRange
                                prepared.package.nodes[borrowedMutableRange.astStart + borrowedMutableArgument.astNode] => borrowedMutableAst
                                diagnostics! -> appendBodyDiagnostic(borrowedMutableSite.siteIr, OwnershipDiagnostic {
                                    code: 21
                                    sourceModule: borrowedMutableArgument.sourceModule
                                    functionSymbol: -1
                                    expectedOrigin: -1
                                    expectedModule: activeMutableBorrow.ownerPlaceIr
                                    expectedSymbol: borrowedMutableOwnerBinding
                                    actualOrigin: -1
                                    actualModule: -1
                                    actualSymbol: activeMutableBorrow.bindingIr
                                    actualBuiltin: -1
                                    readonlyReferencePath: -1
                                    span: syntax.SourceSpan { fileId: borrowedMutableArgument.sourceModule, start: borrowedMutableAst.start, length: borrowedMutableAst.length }
                                })
                            }
                        activeMutableBorrowIndex! + 1 => activeMutableBorrowIndex!
                    }
            }
            borrowedMutableSiteIndex! + 1 => borrowedMutableSiteIndex!
        }

    # Field and indexed replacements invalidate their destination backing, independently of
    # the existing RHS move events. Reuse the same loan and liveness consumers.
    0 => borrowedAssignmentIr!
    borrowedAssignmentIr! < (typed -> len) -> while {
        typed[borrowedAssignmentIr!] => assignment
        (assignment.kind == 25 or assignment.kind == 24) and assignment.operand1 >= 0 and assignment.operand1 < (typed -> len)
            and assignment.sourceModule >= 0 and assignment.sourceModule < (prepared.package.ranges -> len)
            -> if {
                prepared.package.ranges[assignment.sourceModule] => assignmentRange
                assignment.astNode >= 0 and assignment.astNode < assignmentRange.astCount
                    -> if {
                        borrowedBindings! -> each loan {
                            false => overlapsDestination!
                            loan.ownerBindingIr >= 0 and loan.ownerBindingIr < (typed -> len)
                                -> if {
                                    assignment.kind == 25 -> if {
                                        loan.ownerBindingIr == assignment.operand1
                                            and (loan.ownerPlaceIr -> borrowedFieldAssignmentOverlapsPlace(borrowedAssignmentIr!)) => overlapsDestination!
                                    } else {
                                        (prepared -> indexAssignmentTargetsBinding(typed, borrowedAssignmentIr!, loan.ownerBindingIr))
                                            and (loan.ownerPlaceIr -> placeOverlapsIndexedProjection(assignment.operand1)) => overlapsDestination!
                                    }
                                }
                            overlapsDestination!
                                and typed[loan.ownerBindingIr].sourceModule == assignment.sourceModule
                                and (typed -> borrowedTextFunctionIr(loan.bindingIr)) == (typed -> borrowedTextFunctionIr(borrowedAssignmentIr!))
                                and (typed[loan.bindingIr].kind == 10
                                or (prepared -> borrowedTextBindingStartedBeforeSite(typed, types, callFunctionIndex, terminatingControls, loan.bindingIr, borrowedAssignmentIr!)))
                                and not (borrowedAssignmentIr! -> nodeBelongsTo(loan.bindingIr))
                                and (typed -> borrowedTextValueUsesConcreteOrigin(prepared, types, borrowedAssignmentIr!, borrowedStoreSites, terminatingControls, borrowedReturns!, callFunctionIndex, borrowedTextViewTypes!, loan.bindingIr, loan.ownerBindingIr))
                                and (prepared -> borrowedBindingUsedAfterSite(typed, loan.bindingIr, borrowedAssignmentIr!, -1, terminatingControls, referenceViewTypes!, callFunctionIndex.irIndex))
                                -> if {
                                    prepared.package.nodes[assignmentRange.astStart + assignment.astNode] => assignmentAst
                                    assignmentAst.start => assignmentStart!
                                    assignmentAst.length => assignmentLength!
                                    assignment.kind == 24 and assignmentAst.payloadToken >= 0 and assignmentAst.payloadToken < assignmentRange.tokenCount
                                        -> if {
                                            prepared.package.tokens[assignmentRange.tokenStart + assignmentAst.payloadToken] => ownerToken
                                            ownerToken.span.start => assignmentStart!
                                            ownerToken.span.length => assignmentLength!
                                        }
                                    assignment.kind == 25 and assignmentAst.payloadToken >= 0 and assignmentAst.payloadToken < assignmentRange.tokenCount
                                        and assignmentAst.secondaryToken >= 0 and assignmentAst.secondaryToken < assignmentRange.tokenCount
                                        -> if {
                                            prepared.package.tokens[assignmentRange.tokenStart + assignmentAst.payloadToken] => ownerToken
                                            prepared.package.tokens[assignmentRange.tokenStart + assignmentAst.secondaryToken] => fieldToken
                                            fieldToken.span.start >= ownerToken.span.start
                                                -> if {
                                                    ownerToken.span.start => assignmentStart!
                                                    fieldToken.span.start + fieldToken.span.length - ownerToken.span.start => assignmentLength!
                                                }
                                        }
                                    diagnostics! -> appendBodyDiagnostic(borrowedAssignmentIr!, OwnershipDiagnostic {
                                        code: 21
                                        sourceModule: assignment.sourceModule
                                        functionSymbol: -1
                                        expectedOrigin: -1
                                        expectedModule: loan.ownerPlaceIr
                                        expectedSymbol: loan.ownerBindingIr
                                        actualOrigin: -1
                                        actualModule: -1
                                        actualSymbol: loan.bindingIr
                                        actualBuiltin: -1
                                        readonlyReferencePath: -1
                                        span: syntax.SourceSpan { fileId: assignment.sourceModule, start: assignmentStart!, length: assignmentLength! }
                                    })
                                }
                        }
                    }
            }
        borrowedAssignmentIr! + 1 => borrowedAssignmentIr!
    }

    0 => borrowedMoveIndex!
    borrowedMoveIndex! < (moves! -> len) -> while {
        moves![borrowedMoveIndex!] => borrowedMove
        borrowedMove.siteIr >= 0 and borrowedMove.siteIr < (typed -> len)
            -> if {
                typed[borrowedMove.siteIr] => borrowedMoveCall
                borrowedMove.memberIr >= 0 -> if { borrowedMove.memberIr } else { borrowedMove.valueIr } => borrowedMovePlaceIr
                borrowedMovePlaceIr >= 0 -> if {
                    borrowedMovePlaceIr -> placeRootBinding => movedOwnerBinding
                    borrowedMovePlaceIr -> placeProjectionDepth => borrowedMoveProjectionDepth
                    movedOwnerBinding >= 0 -> if {
                        0 => activeBorrowIndex!
                        activeBorrowIndex! < (borrowedBindings! -> len)
                            -> while {
                                borrowedBindings![activeBorrowIndex!] => activeBorrow
                                activeBorrow.bindingIr => activeBorrowBindingIr
                                activeBorrow.ownerBindingIr => activeBorrowOwnerBindingIr
                                (activeBorrowOwnerBindingIr == movedOwnerBinding
                                    or (activeBorrowOwnerBindingIr -> loopCarriedMutableOwnerMatches(movedOwnerBinding, activeBorrowBindingIr, borrowedMove.siteIr)))
                                    and (borrowedMove.memberIr < 0
                                    or borrowedMoveProjectionDepth == 0
                                    or (activeBorrow.ownerPlaceIr -> placesOverlap(borrowedMovePlaceIr)))
                                    and activeBorrowBindingIr < borrowedMove.siteIr
                                    and (prepared -> borrowedTextBindingStartedBeforeSite(typed, types, callFunctionIndex, terminatingControls, activeBorrowBindingIr, borrowedMove.siteIr))
