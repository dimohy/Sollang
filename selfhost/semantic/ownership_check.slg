}

# Text carrier liveness splits only committed ordinary struct fields, as the
# managed compiler does. Whole uses and unresolved/nonstruct projections keep
# their aggregate loan; a scalar or independently owned field does not read a
# sibling Text/SourceText/readonly-reference field.
borrowedTextCarrierUseTouchesLoan prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], typed: ref [typedIr.TypedIrNode; ~], useIndex: Int -> Bool {
    useIndex < 0 or useIndex >= (typed -> len) -> if { true -> return }
    useIndex => projectedUse!
    typed[projectedUse!].parent => projectedParent!
    false => projected!
    projectedParent! >= 0 and projectedParent! < (typed -> len)
        and typed[projectedParent!].kind == 13
        and typed[projectedParent!].operand0 == projectedUse!
        -> while {
            typed[projectedUse!].typeId => ownerTypeId
            ownerTypeId < 0 or ownerTypeId >= (types -> len)
                -> if { true -> return }
            types[ownerTypeId] => ownerType
            ownerType.status != 0 or ownerType.containsParameter
                or ownerType.kind != 1 or (ownerType.origin != 0 and ownerType.origin != 2)
                -> if { true -> return }
            prepared -> semanticNominalSourceModule(ownerType) => ownerSource
            ownerSource < 0 or ownerSource >= (prepared.package.ranges -> len)
                -> if { true -> return }
            prepared.package.ranges[ownerSource] => ownerRange
            ownerType.symbol < 0 or ownerType.symbol >= ownerRange.symbolCount
                -> if { true -> return }
            prepared.package.symbols[ownerRange.symbolStart + ownerType.symbol].kind != 3
                -> if { true -> return }
            typed[projectedParent!] => selectedField
            false => committedField!
            0 => fieldIndex!
            fieldIndex! < (prepared.semantic.fields -> len) and not committedField!
                -> while {
                    prepared.semantic.fields[fieldIndex!] => field
                    field.status == 0 and field.ownerType == ownerTypeId
                        and field.ordinal == selectedField.symbol
                        and field.fieldType == selectedField.typeId
                        and field.sourceModule == selectedField.targetModule
                        -> if { true => committedField! }
                    fieldIndex! + 1 => fieldIndex!
                }
            not committedField! -> if { true -> return }
            true => projected!
            projectedParent! => projectedUse!
            typed[projectedUse!].parent => projectedParent!
        }
    not projected! -> if { true -> return }
    typed[projectedUse!].typeId => selectedTypeId
    selectedTypeId < 0 or selectedTypeId >= (types -> len)
        -> if { true -> return }
    types[selectedTypeId].status != 0 or types[selectedTypeId].containsParameter
        -> if { true -> return }
    not (prepared -> borrowedTextIndependentFieldType(types, selectedTypeId, 0))
}

# Interpolation names retain the loan unless a committed ordinary struct
# projection selects a field whose type is independent of borrowed Text.
borrowedTextInterpolationUseTouchesLoan prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], binding: typedIr.TypedIrNode, nodeIndex: Int -> Bool {
    binding.typeId => ownerTypeId!
    nodeIndex => selectedNode!
    prepared.interpolations[selectedNode!].parent => memberIndex!
    false => projected!
    memberIndex! >= 0 and memberIndex! < (prepared.interpolations -> len)
        and prepared.interpolations[memberIndex!].kind == 5
        and prepared.interpolations[memberIndex!].operand0 == selectedNode!
        -> while {
            ownerTypeId! < 0 or ownerTypeId! >= (types -> len)
                -> if { true -> return }
            types[ownerTypeId!] => ownerType
            ownerType.status != 0 or ownerType.containsParameter or ownerType.kind != 1
                or (ownerType.origin != 0 and ownerType.origin != 2)
                -> if { true -> return }
            prepared -> semanticNominalSourceModule(ownerType) => ownerSource
            ownerSource < 0 or ownerSource >= (prepared.package.ranges -> len)
                -> if { true -> return }
            prepared.package.ranges[ownerSource] => ownerRange
            ownerType.symbol < 0 or ownerType.symbol >= ownerRange.symbolCount
                -> if { true -> return }
            prepared.package.symbols[ownerRange.symbolStart + ownerType.symbol].kind != 3
                -> if { true -> return }
            prepared -> expressionTypeIds.memberFieldIndex(types, prepared.semantic.fields, binding.sourceModule, ownerTypeId!, memberIndex!) => fieldIndex
            fieldIndex < 0 or fieldIndex >= (prepared.semantic.fields -> len)
                -> if { true -> return }
            prepared.semantic.fields[fieldIndex].fieldType => ownerTypeId!
            true => projected!
            memberIndex! => selectedNode!
            prepared.interpolations[selectedNode!].parent => memberIndex!
        }
