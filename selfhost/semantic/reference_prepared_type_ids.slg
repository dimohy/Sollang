namespace sollang.compiler.semantic.reference_prepared_type_ids

import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.diagnostics as diagnostics
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.semantic.type_name_policy as typeNames
import sollang.compiler.semantic.type_registration as registration
import sollang.compiler.semantic.reference_type_ids as nominal
import sollang.compiler.semantic.reference_synthetic_type_ids as synthetic
import sollang.compiler.semantic.function_type_binding_policy as bindingPolicy
import sys.file as file
import syntax.generated.slg as grammar

# Current source facts preserve the C# constructor and function-declaration
# registration order for library ABI diagnostic identities.
public enum Error { Nominal(nominal.Error), Synthetic(synthetic.Error), InvalidSource }

struct TraitUse {
    typeId: Int
    start: UIntSize
    returns: Bool
}

referencesAssociated prepared: ref semanticContext.SemanticSnapshot, module: Int, traitSymbol: Int, annotation: Int -> Bool {
    prepared.package.ranges[module] => range
    prepared.package.sources[module] -> slice(0, prepared.package.sources[module] -> len) => source
    prepared.package.nodes[range.astStart + annotation] => node
    0 => symbolIndex!
    symbolIndex! < range.symbolCount -> while {
        prepared.package.symbols[range.symbolStart + symbolIndex!] => associated
        associated.kind == 28 and associated.parent == traitSymbol and associated.nameToken >= 0
            -> if {
                prepared.package.tokens[range.tokenStart + associated.nameToken] => nameToken
                source -> slice(nameToken.span.start, nameToken.span.length) => name
                node.firstToken => tokenIndex!
                tokenIndex! < node.firstToken + node.tokenCount
                    -> while {
                        prepared.package.tokens[range.tokenStart + tokenIndex!] => token
                        token.kind == grammar.tokenIdIdentifier()
                            and (source -> slice(token.span.start, token.span.length)) == name
                            -> if { true -> return }
                        tokenIndex! + 1 => tokenIndex!
                    }
            }
        symbolIndex! + 1 => symbolIndex!
    }
    false
}

appendTraitRoots prepared: ref semanticContext.SemanticSnapshot, roots: mut [Int; ~] -> Unit {
    prepared.package.ranges -> each range {
        0 => methodIndex!
        methodIndex! < range.symbolCount -> while {
            prepared.package.symbols[range.symbolStart + methodIndex!] => method
            method.kind == 29 and method.parent >= 0 -> if {
                [TraitUse; ~] => uses!
                [Bool; ~] => selected!
                prepared.semantic.references -> each reference {
                    reference.sourceModule == range.sourceModule and reference.typeAst >= 0
                        -> if {
                            prepared.package.nodes[range.astStart + reference.typeAst] => annotation
                            annotation.parent < 0 or prepared.package.nodes[range.astStart + annotation.parent].kind != 12
                                -> if {
                                    annotation.parent => owner!
                                    owner! >= 0 and prepared.package.nodes[range.astStart + owner!].kind != 29
                                        -> while { prepared.package.nodes[range.astStart + owner!].parent => owner! }
                                    owner! == method.astNode
                                        and not (prepared -> referencesAssociated(range.sourceModule, method.parent, reference.typeAst))
                                        -> if {
                                            uses! -> push(TraitUse {
                                                typeId: reference.typeId
                                                start: annotation.start
                                                returns: annotation.operatorKind == grammar.tokenIdArrow()
                                            })
                                            selected! -> push(false)
                                        }
                                }
                        }
                }
                # BindTraits parses the return first, then parameters in source
                # order, independently of compact AST/type-reference order.
                [true, false] -> each returns {
                    0 => count!
                    count! < (uses! -> len) -> while {
                        -1 => chosen!
                        0 => index!
                        index! < (uses! -> len) -> while {
                            not selected![index!] and ((returns and uses![index!].returns) or (not returns and not uses![index!].returns))
                                -> if {
                                    chosen! < 0 -> if { index! => chosen! } else {
                                        uses![index!].start < uses![chosen!].start -> if { index! => chosen! }
                                    }
                                }
                            index! + 1 => index!
                        }
                        chosen! >= 0 -> if {
                            roots -> push(uses![chosen!].typeId)
                            true => selected![chosen!]
                        }
                        count! + 1 => count!
                    }
                }
            }
            methodIndex! + 1 => methodIndex!
        }
    }
}

genericIdentity prepared: ref semanticContext.SemanticSnapshot, module: Int, symbol: Int -> Int {
    prepared.package.ranges[module] => range
    prepared.package.symbols[range.symbolStart + symbol] => parameter
    0 => ordinal!
    0 => index!
    index! < range.symbolCount -> while {
        prepared.package.symbols[range.symbolStart + index!] => candidate
        candidate.kind == 32 and candidate.parent == parameter.parent and candidate.nameToken < parameter.nameToken
            -> if { ordinal! + 1 => ordinal! }
        index! + 1 => index!
    }
    nominal.enumValue("GenericParameter") + ordinal!
}

productLabels prepared: ref semanticContext.SemanticSnapshot, semantic: ref typeIds.SemanticTypeSet -> (components: [Int; ~], fields: [Int; ~]) {
    [Int; ~] => labels!
    semantic.types -> each type { labels! -> push(0) }
    [Int; ~] => fieldLabels!
    semantic.fields -> each field { fieldLabels! -> push(0) }
    0 => fieldIndex!
    [Int; ~] => modules!
    [Int; ~] => tokens!
    semantic.fields -> each field {
        field.fieldSymbol < 0 and field.ownerType >= 0 and field.labelToken >= 0
            -> if {
                semantic.types[field.ownerType] => product
                product.kind == 10 -> if {
                    prepared.package.ranges[field.sourceModule] => range
                    prepared.package.tokens[range.tokenStart + field.labelToken] => token
                    prepared.package.sources[field.sourceModule] -> slice(token.span.start, token.span.length) => name
                    -1 => label!
                    0 => index!
                    index! < (modules! -> len) and label! < 0 -> while {
                        prepared.package.ranges[modules![index!]] => existingRange
                        prepared.package.tokens[existingRange.tokenStart + tokens![index!]] => existingToken
                        prepared.package.sources[modules![index!]] -> slice(existingToken.span.start, existingToken.span.length) => existing
                        name == existing -> if { index! + 1 => label! }
                        index! + 1 => index!
                    }
                    label! < 0 -> if {
                        modules! -> push(field.sourceModule)
                        tokens! -> push(field.labelToken)
                        modules! -> len => label!
                    }
                    label! => fieldLabels![fieldIndex!]
                    product.first => component!
                    0 => ordinal!
                    ordinal! < field.ordinal and component! >= 0 -> while {
                        semantic.types[component!].second => component!
                        ordinal! + 1 => ordinal!
                    }
                    component! >= 0 -> if { label! => labels![component!] }
                }
            }
        fieldIndex! + 1 => fieldIndex!
    }
    (components: labels!, fields: fieldLabels!)
}

# Modes mirror BindFunctionDeclaration: ordinary signatures defer composite
# generic syntax; ownership and intrinsic/block results parse the full shape;
# block inputs defer any occurrence of a generic parameter.
appendSignatureRoot prepared: ref semanticContext.SemanticSnapshot, typeId: Int, mode: Int, roots: mut [Int; ~] -> Unit {
    typeId < 0 -> if { return }
    prepared.semantic.types[typeId] => type
    mode != 1 and type.containsParameter -> if {
        mode == 2 or type.kind != 1 -> if { return }
    }
    roots -> push(typeId)
}

intrinsicDeclaration prepared: ref semanticContext.SemanticSnapshot, module: Int, functionAst: Int -> Bool {
    prepared.package.ranges[module] => range
    prepared.package.nodes[range.astStart + functionAst] => node
    node.firstToken + node.tokenCount - 1 => index!
    index! >= node.firstToken -> while {
        prepared.package.tokens[range.tokenStart + index!] => token
        token.kind != grammar.triviaIdWhitespace() and token.kind != grammar.triviaIdComment() and token.kind != grammar.tokenIdNewLine()
            -> if {
                (prepared.package.sources[module] -> slice(token.span.start, token.span.length)) == "intrinsic" -> return
            }
        index! - 1 => index!
    }
    false
}

parallelRole moduleName: Text, name: Text -> Bool {
    bindingPolicy.parallelRoleNames() => table
    UIntSize(0) => start!
    UIntSize(0) => cursor!
    cursor! <= (table -> len) -> while {
        cursor! == (table -> len) or (table -> byte(cursor!)) == '|'
            -> if {
                cursor! - start! == (moduleName -> len) + 1 + (name -> len)
                    and (table -> slice(start!, moduleName -> len)) == moduleName
                    and (table -> byte(start! + (moduleName -> len))) == '.'
                    and (table -> slice(start! + (moduleName -> len) + 1, name -> len)) == name
                    -> if { true -> return }
                cursor! + 1 => start!
            }
        cursor! + 1 => cursor!
    }
    false
}

compositeTemplate prepared: ref semanticContext.SemanticSnapshot, typeId: Int -> Bool {
    typeId < 0 -> if { false -> return }
    prepared.semantic.types[typeId] => type
    type.containsParameter and type.kind != 1
}

appendImplementationRoots prepared: ref semanticContext.SemanticSnapshot, references: ref [Int; ~], roots: mut [Int; ~] -> Unit {
    prepared.package.ranges -> each range {
        0..<range.symbolCount -> each index {
            prepared.package.symbols[range.symbolStart + index] => implementation
            implementation.kind == 6 -> if {
                typeIds.implTypePaths(prepared.package.nodes, range.astStart, range.astCount, implementation.astNode) => paths
                paths.traitAst >= 0 -> if {
                    0..<range.symbolCount -> each memberIndex {
                        prepared.package.symbols[range.symbolStart + memberIndex] => member
                        member.kind == 30 and member.parent == index and member.typeNode >= 0
                            -> if { prepared -> appendSignatureRoot(references[range.astStart + member.typeNode], 1, roots) }
                    }
                }
            }
        }
    }
}

appendFunctionRoots prepared: ref semanticContext.SemanticSnapshot, references: ref [Int; ~], roots: mut [Int; ~] -> Unit {
    prepared.package.ranges -> each range {
        0 => functionIndex!
        functionIndex! < range.symbolCount -> while {
            prepared.package.symbols[range.symbolStart + functionIndex!] => function
            function.kind == 7 or function.kind == 31 -> if {
                function.parent => ancestor!
                false => local!
                ancestor! >= 0 and not local! -> while {
                    prepared.package.symbols[range.symbolStart + ancestor!] => parent
                    parent.kind == 7 or parent.kind == 31 -> if { true => local! } else { parent.parent => ancestor! }
                }
                not local! -> if {
                    false => valueGeneric!
                    -1 => primary!
                    0 => index!
                    index! < range.symbolCount -> while {
                        prepared.package.symbols[range.symbolStart + index!] => symbol
                        symbol.parent == functionIndex! -> if {
                            symbol.kind == 32 -> if {
                                prepared.package -> analysis.declaresIntegerValueGeneric(range.sourceModule, function.astNode, symbol.nameToken)
                                    -> if { true => valueGeneric! }
                            }
                            symbol.kind == 35 and symbol.astNode == function.astNode
                                -> if {
                                    symbol.typeNode >= 0 -> if { references[range.astStart + symbol.typeNode] => primary! } else {
                                        function.kind == 31 and function.parent >= 0 -> if {
                                            prepared.package.symbols[range.symbolStart + function.parent] => owner
                                            prepared.package -> typeIds.implOwnerTypeAst(range.sourceModule, owner.astNode) => ownerAst
                                            ownerAst >= 0 -> if { references[range.astStart + ownerAst] => primary! }
                                        }
                                    }
                                }
                        }
                        index! + 1 => index!
                    }
                    prepared -> appendSignatureRoot(primary!, 0, roots)
                    function.typeNode => resultAst!
                    function.secondaryTypeNode >= 0 -> if { function.secondaryTypeNode => resultAst! } else {
                        function.kind == 7 and primary! >= 0
                            -> if { -1 => resultAst! }
                    }
                    resultAst! >= 0 -> if {
                        prepared.modules[range.sourceModule] => module
                        prepared.package.sources[range.sourceModule] -> slice(module.pathStart, module.pathLength) => moduleName
                        prepared.package.tokens[range.tokenStart + function.nameToken] => nameToken
                        prepared.package.sources[range.sourceModule] -> slice(nameToken.span.start, nameToken.span.length) => name
                        references[range.astStart + resultAst!] => resultType
                        bindingPolicy.bindReturnTypeEagerly(prepared -> compositeTemplate(resultType), prepared -> intrinsicDeclaration(range.sourceModule, function.astNode), parallelRole(moduleName, name))
                            -> if { 1 } else { 0 } => mode
                        prepared -> appendSignatureRoot(resultType, mode, roots)
                    }
                    function.blockTypeNode >= 0 -> if { prepared -> appendSignatureRoot(references[range.astStart + function.blockTypeNode], 2, roots) }
                    function.blockResultTypeNode >= 0 and bindingPolicy.bindCallbackResultEagerly(function.blockTypeNode >= 0)
                        -> if { prepared -> appendSignatureRoot(references[range.astStart + function.blockResultTypeNode], 1, roots) }
                    bindingPolicy.bindOwnershipTypeEagerly(prepared -> compositeTemplate(primary!), valueGeneric!, function.flags % 4 != 0)
                        -> if { prepared -> appendSignatureRoot(primary!, 1, roots) }
                    0 => index!
                    index! < range.symbolCount -> while {
                        prepared.package.symbols[range.symbolStart + index!] => parameter
                        parameter.kind == 35 and parameter.parent == functionIndex! and parameter.astNode != function.astNode and parameter.typeNode >= 0
                            -> if {
                                references[range.astStart + parameter.typeNode] => typeId
                                prepared -> appendSignatureRoot(typeId, 0, roots)
                                bindingPolicy.bindOwnershipTypeEagerly(prepared -> compositeTemplate(typeId), valueGeneric!, parameter.flags % 4 != 0)
                                    -> if { prepared -> appendSignatureRoot(typeId, 1, roots) }
                            }
                        index! + 1 => index!
                    }
                }
            }
            functionIndex! + 1 => functionIndex!
        }
    }
}

public register prepared: ref semanticContext.SemanticSnapshot -> Result<synthetic.Identities, Error> {
    [Int; ~] => uses
    prepared -> registerCurrent(prepared.semantic, false, false, uses)
}

public registerDeclarations prepared: ref semanticContext.SemanticSnapshot -> Result<synthetic.Identities, Error> {
    [Int; ~] => uses
    prepared -> registerCurrent(prepared.semantic, true, false, uses)
}

public registerMetadataSignatures prepared: ref semanticContext.SemanticSnapshot -> Result<synthetic.Identities, Error> {
    [Int; ~] => uses
    prepared -> registerCurrent(prepared.semantic, true, true, uses)
}

# Type-use order belongs to the semantic caller. This extends the declaration
# registry using the same resolved node/reference/field graph as code generation.
public registerResolvedTypeUses prepared: ref semanticContext.SemanticSnapshot, semantic: ref typeIds.SemanticTypeSet, orderedUses: ref [Int; ~] -> Result<synthetic.Identities, Error> {
    (semantic.types -> len) < (prepared.semantic.types -> len)
        -> if { Result<synthetic.Identities, Error>.Err(Error.InvalidSource) -> return }
    orderedUses -> each typeId {
        typeId < 0 or typeId >= (semantic.types -> len)
            -> if { Result<synthetic.Identities, Error>.Err(Error.InvalidSource) -> return }
        semantic.types[typeId].status != 0 or semantic.types[typeId].containsParameter
            -> if { Result<synthetic.Identities, Error>.Err(Error.InvalidSource) -> return }
    }
    prepared -> registerCurrent(semantic, true, false, orderedUses)
}

metadataSignatureRoots prepared: ref semanticContext.SemanticSnapshot, sourceRoots: ref [Int; ~] -> Result<[Int; ~], Error> {
    [Int; ~] => pending!
    sourceRoots -> each root { pending! -> push(root) }
    [Bool; ~] => seen!
    prepared.semantic.types -> each _ { seen! -> push(false) }
    [Int; ~] => roots!
    0 => cursor!
    cursor! < (pending! -> len) -> while {
        pending![cursor!] => identity
        identity < 0 or identity >= (prepared.semantic.types -> len)
            -> if { Result<[Int; ~], Error>.Err(Error.InvalidSource) -> return }
        not seen![identity] -> if {
            true => seen![identity]
            prepared.semantic.types[identity] => type
            type.containsParameter -> if {
                (type -> typeIds.isHeapCollection) or type.kind == 4 or type.kind == 6 or type.kind == 8 or type.kind == 10 or type.kind == 12 or type.kind == 13
                    or (type.kind == 7 and type.origin == 4 and (type.symbol == 0 or type.symbol == 1))
                    -> if { roots! -> push(identity) }
                type.first >= 0 -> if { pending! -> push(type.first) }
                type.second >= 0 -> if { pending! -> push(type.second) }
            }
        }
        cursor! + 1 => cursor!
    }
    Result<[Int; ~], Error>.Ok(roots!)
}

registerRecipes recipes: ref [synthetic.Recipe; ~], seeds: ref [Int; ~], aliases: ref [synthetic.Shape; ~], roots: ref [Int; ~], nextTypeId: Int, typeCount: Int -> Result<synthetic.Identities, Error> {
    recipes -> synthetic.register(seeds, aliases, roots, nextTypeId) -> when {
        Err(error) { Result<synthetic.Identities, Error>.Err(Error.Synthetic(error)) }
        Ok(registered) {
            [Int; ~] => ids!
            0..<typeCount -> each typeId { ids! -> push(registered.ids[typeId]) }
            Result<synthetic.Identities, Error>.Ok(synthetic.Identities { ids: ids!, nextTypeId: registered.nextTypeId })
        }
    }
}

registerCurrent prepared: ref semanticContext.SemanticSnapshot, semantic: ref typeIds.SemanticTypeSet, includeDeclarations: Bool, metadataOnly: Bool, orderedUses: ref [Int; ~] -> Result<synthetic.Identities, Error> {
    [nominal.NominalDeclaration; ~] => declarations!
    [UInt8; ~] => strings!
    [Int; ~] => declarationBySymbol!
    prepared.package.symbols -> each symbol { declarationBySymbol! -> push(-1) }
    prepared.package.ranges -> each range {
        prepared.package.sources[range.sourceModule] -> slice(0, prepared.package.sources[range.sourceModule] -> len) => source
        prepared.modules[range.sourceModule] => identity
        0 => index!
        index! < range.symbolCount -> while {
            prepared.package.symbols[range.symbolStart + index!] => symbol
            (symbol.kind == 3 or symbol.kind == 4)
                and symbol.flags / 512 % 2 == 0 and symbol.flags / 65536 % 2 == 0
                -> if {
                    UIntSize(strings! -> len) => start
                    source -> diagnostics.appendFunctionDeclarationName(prepared.package.tokens, range.tokenStart, range.tokenCount, identity.pathStart, identity.pathLength, symbol.nameToken, strings!)
                    declarations! -> len => declarationBySymbol![range.symbolStart + index!]
                    declarations! -> push(nominal.NominalDeclaration { kind: symbol.kind, nameStart: start, nameLength: UIntSize(strings! -> len) - start })
                }
            index! + 1 => index!
        }
    }
    declarations! -> nominal.registerNominals(strings!) -> when {
        Err(error) { Result<synthetic.Identities, Error>.Err(Error.Nominal(error)) -> return }
        Ok(named) { named }
    } => named
    declarations! -> nominal.registerNominalBoxes(strings!) -> when {
        Err(error) { Result<synthetic.Identities, Error>.Err(Error.Nominal(error)) -> return }
        Ok(boxed) { boxed }
    } => boxed
    [Int; ~] => seeds!
    [synthetic.Recipe; ~] => recipes!
    prepared -> productLabels(semantic) => labels
    0 => typeIndex!
    semantic.types -> each type {
        -1 => seed!
        type.kind == 1 -> if {
            type.origin == 1 and type.symbol >= 0 and type.symbol < 26
                -> if {
                    typeIds.builtinTypeName(type.symbol) -> typeNames.builtinEnumName -> nominal.enumValue => seed!
                }
            (type.origin == 0 or type.origin == 2) and type.module >= 0 and type.module < (prepared.package.ranges -> len)
                -> if {
                    prepared.package.ranges[type.module] => range
                    type.symbol >= 0 and type.symbol < range.symbolCount
                        -> if {
                            declarationBySymbol![range.symbolStart + type.symbol] => declaration
                            declaration >= 0 -> if { named.ids[declaration] => seed! }
                        }
                }
        }
        includeDeclarations and type.kind == 1 and type.origin == 3
            -> if {
                prepared -> genericIdentity(type.module, type.symbol) => seed!
            }
        seeds! -> push(seed!)
        type.kind -> when {
            == 2 => synthetic.Kind.Slice
            == 3 => synthetic.Kind.Dynamic
            == 4 => synthetic.Kind.Fixed
            == 5 => synthetic.Kind.Dictionary
            == 12 => synthetic.Kind.BoundedArray
            == 13 => synthetic.Kind.BoundedDictionary
            == 14 => synthetic.Kind.BitSet
            == 8 => synthetic.Kind.Reference
            == 10 => synthetic.Kind.Product
            == 11 => synthetic.Kind.ProductField
            == 7 {
                type.origin == 4 -> if {
                    type.symbol -> when {
                        == 0 => synthetic.Kind.Option
                        == 1 => synthetic.Kind.Result
                        == 2 => synthetic.Kind.Task
                        == 3 => synthetic.Kind.Stream
                        == 4 => synthetic.Kind.EventStream
                        == 5 => synthetic.Kind.Set
                        == 6 => synthetic.Kind.Deque
                        == 7 => synthetic.Kind.BinaryHeap
                        else => synthetic.Kind.Named
                    }
                } else { synthetic.Kind.Named }
            }
            == 1 {
                type.origin == 16 -> if { synthetic.Kind.DynTrait } else { synthetic.Kind.Named }
            }
            else => synthetic.Kind.Named
        } => kind
        recipes! -> push(synthetic.Recipe {
            kind: kind
            first: type.first
            second: (type.kind == 7 and type.origin == 4 and type.symbol == 1) or type.kind == 11 or type.kind == 5 or type.kind == 13
                -> if { type.second } else { -1 }
            length: type.kind == 4 or type.kind == 10 or type.kind == 12 or type.kind == 13 or type.kind == 14
                -> if { type.length } else {
                    type.kind == 11 -> if { labels.components[typeIndex!] } else {
                        # A resolved trait symbol is an exact declaration identity;
                        # aliases share it, equal names in other modules do not.
                        type.kind == 1 and type.origin == 16
                            -> if { prepared.package.ranges[type.module].symbolStart + type.symbol } else { 0 }
                    }
                }
        })
        typeIndex! + 1 => typeIndex!
    }
    # Reuse the shared-policy box catalog, including alias multiplicity, rather
    # than maintaining a second primitive-spelling/semantic-symbol switch.
    [typeIds.SemanticType; ~] => boxTypes!
    semantic.types -> each type { boxTypes! -> push(type) }
    prepared.package -> registration.registerNamedBoxes(boxTypes!) -> when {
        Err(_) { Result<synthetic.Identities, Error>.Err(Error.InvalidSource) -> return }
        Ok(value) { value }
    } => boxCatalog
    [Int; ~] => boxIdentities!
    boxed.primitiveIds -> each identity { boxIdentities! -> push(identity) }
    [3, 4] -> each declarationKind {
        0 => declaration!
        declaration! < (declarations! -> len) -> while {
            declarations![declaration!].kind == declarationKind and boxed.ids[declaration!] >= 0
                -> if { boxIdentities! -> push(boxed.ids[declaration!]) }
            declaration! + 1 => declaration!
        }
    }
    (boxCatalog.ids -> len) != (boxIdentities! -> len)
        -> if { Result<synthetic.Identities, Error>.Err(Error.InvalidSource) -> return }
    0 => boxIndex!
    boxIndex! < (boxCatalog.ids -> len) -> while {
        boxCatalog.ids[boxIndex!] => semanticId
        semanticId < (seeds! -> len) -> if { boxIdentities![boxIndex!] => seeds![semanticId] }
        boxIndex! + 1 => boxIndex!
    }
    # Body products carry their ordered fields in the resolved field table.
    # Recipe-only field chains do not allocate semantic or reference TypeIds.
    0..<(semantic.types -> len) -> each typeId {
        semantic.types[typeId] => type
        type.kind == 10 and type.first < 0 -> if {
            recipes! -> len => firstField
            0..<type.length -> each ordinal {
                -1 => selected!
                0 => matches!
                0..<(semantic.fields -> len) -> each fieldIndex {
                    semantic.fields[fieldIndex] => field
                    field.ownerType == typeId and field.ordinal == ordinal
                        -> if {
                            fieldIndex => selected!
                            matches! + 1 => matches!
                        }
                }
                matches! != 1 -> if { Result<synthetic.Identities, Error>.Err(Error.InvalidSource) -> return }
                semantic.fields[selected!].status != 0 -> if { Result<synthetic.Identities, Error>.Err(Error.InvalidSource) -> return }
                recipes! -> push(synthetic.Recipe { kind: synthetic.Kind.ProductField, first: semantic.fields[selected!].fieldType, second: ordinal + 1 < type.length
                        -> if { firstField + ordinal + 1 } else { -1 }, length: labels.fields[selected!] })
                seeds! -> push(-1)
            }
            synthetic.Recipe { kind: synthetic.Kind.Product, first: firstField, second: -1, length: type.length } => recipes![typeId]
        }
    }
    # These canonical runtime aliases are reserved by BuildTypeDefinitions
    # before all field roots, and share their IDs with Result annotations.
    [
    synthetic.Shape { kind: synthetic.Kind.Dictionary, first: nominal.enumValue("Int"), second: nominal.enumValue("Int"), length: 0, identity: nominal.enumValue("IntDictionary") },
    synthetic.Shape { kind: synthetic.Kind.Slice, first: nominal.enumValue("Int"), second: -1, length: 0, identity: nominal.enumValue("IntSlice") },
    synthetic.Shape { kind: synthetic.Kind.Dynamic, first: nominal.enumValue("Int"), second: -1, length: 0, identity: nominal.enumValue("DynamicIntArray") },
    synthetic.Shape { kind: synthetic.Kind.Dynamic, first: nominal.enumValue("UInt8"), second: -1, length: 0, identity: nominal.enumValue("DynamicUInt8Array") },
    synthetic.Shape { kind: synthetic.Kind.Dynamic, first: nominal.enumValue("DirectoryEntry"), second: -1, length: 0, identity: nominal.enumValue("DynamicDirectoryEntryArray") },
    synthetic.Shape { kind: synthetic.Kind.Fixed, first: nominal.enumValue("UInt8"), second: -1, length: 12, identity: nominal.enumValue("FixedUInt8Array12") },
    synthetic.Shape { kind: synthetic.Kind.Fixed, first: nominal.enumValue("UInt8"), second: -1, length: 16, identity: nominal.enumValue("FixedUInt8Array16") },
    synthetic.Shape { kind: synthetic.Kind.Fixed, first: nominal.enumValue("UInt8"), second: -1, length: 32, identity: nominal.enumValue("FixedUInt8Array32") },
    synthetic.Shape { kind: synthetic.Kind.Result, first: nominal.enumValue("DirectoryRaw"), second: nominal.enumValue("Text"), length: 0, identity: nominal.enumValue("DirectoryRawResult") },
    synthetic.Shape { kind: synthetic.Kind.Result, first: nominal.enumValue("DynamicDirectoryEntryArray"), second: nominal.enumValue("Text"), length: 0, identity: nominal.enumValue("DirectoryReadResult") }; ~] => aliases
    [Int; ~] => references!
    prepared.package.nodes -> each node { references! -> push(-1) }
    semantic.references -> each reference {
        reference.typeAst >= 0 -> if {
            prepared.package.ranges[reference.sourceModule] => range
            reference.typeId => references![range.astStart + reference.typeAst]
        }
    }
    [Int; ~] => roots!
    [3, 4] -> each ownerKind {
        prepared.package.ranges -> each range {
            0 => index!
            index! < range.symbolCount -> while {
                prepared.package.symbols[range.symbolStart + index!] => symbol
                (symbol.kind == 26 or symbol.kind == 27) and symbol.parent >= 0 and symbol.typeNode >= 0
                    -> if {
                        prepared.package.symbols[range.symbolStart + symbol.parent] => parent
                        parent.kind == ownerKind -> if { roots! -> push(references![range.astStart + symbol.typeNode]) }
                    }
                index! + 1 => index!
            }
        }
    }
    prepared -> appendTraitRoots(roots!)
    prepared -> appendImplementationRoots(references!, roots!)
    includeDeclarations -> if { prepared -> appendFunctionRoots(references!, roots!) }
    orderedUses -> each typeId { roots! -> push(typeId) }
    metadataOnly -> if {
        prepared -> metadataSignatureRoots(roots!) -> when {
            Err(error) { Result<synthetic.Identities, Error>.Err(error) -> return }
            Ok(selected) { registerRecipes(recipes!, seeds!, aliases, selected, boxed.nextTypeId, semantic.types -> len) -> return }
        }
    }
    registerRecipes(recipes!, seeds!, aliases, roots!, boxed.nextTypeId, semantic.types -> len)
}
