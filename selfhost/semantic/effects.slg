namespace sollang.compiler.semantic.effects

import sollang.compiler.semantic.modules as modules

import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.calls as calls
import sollang.compiler.syntax as syntax
import syntax.generated.slg as grammar

public struct FunctionEffect {
    public sourceModule: Int
    public functionSymbol: Int
    public mask: Int
}

# Codes: 1 missing caller effect, 2 unknown effect, 3 duplicate effect.
public struct EffectDiagnostic {
    public code: Int
    public sourceModule: Int
    public functionSymbol: Int
    public targetSourceModule: Int
    public targetFunctionSymbol: Int
    public effectMask: Int
    public astNode: Int
    public span: syntax.SourceSpan
}

public struct EffectAnalysis {
    public functions: [FunctionEffect; ~]
    public diagnostics: [EffectDiagnostic; ~]
}

struct TokenTextRequest {
    source: Text
    token: syntax.SyntaxToken
    expected: Text
}

struct EffectMaskRequest {
    source: Text
    token: syntax.SyntaxToken
}

struct HasEffectRequest {
    mask: Int
    effect: Int
}

# Closed capability bits. Async is deliberately not an effect bit: it models
# suspension, while these bits model authority over the outside world.
public effectConsole: -> Int => 1
public effectFile: -> Int => 2
public effectClock: -> Int => 4
public effectRandom: -> Int => 8
public effectProcess: -> Int => 16
public effectEnvironment: -> Int => 32
public effectNetwork: -> Int => 64

# Production call admission shares the closed names with the analysis product.
# Owners are global AST indices; main deliberately has no function contract.
public struct DeclaredEffectIndex {
    public owners: [Int; ~]
    public masks: [Int; ~]
    public failureCode: Int
    public failureSourceModule: Int
    public failureFunctionAst: Int
    public failureReferenceAst: Int
}

public declaredEffectBit name: Text -> Int {
    when {
        name == "Console" => 1
        name == "File" => 2
        name == "Clock" => 4
        name == "Random" => 8
        name == "Process" => 16
        name == "Environment" => 32
        name == "Network" => 64
        else => 0
    }
}

public declaredEffectName bit: Int -> Text {
    bit -> when {
        == 1 => "Console"
        == 2 => "File"
        == 4 => "Clock"
        == 8 => "Random"
        == 16 => "Process"
        == 32 => "Environment"
        == 64 => "Network"
        else => ""
    }
}

# Older sys.runtime intrinsic declarations omit uses. Their canonical runtime
# operation still owns its capability; a same-named ordinary function does not.
intrinsicDeclarationEffect prepared: ref semanticContext.SemanticSnapshot, sourceModule: Int, symbolIndex: Int -> Int {
    prepared.package.ranges[sourceModule] => range
    prepared.package.symbols[range.symbolStart + symbolIndex] => symbol
    symbol.astNode < 0 or symbol.astNode >= range.astCount
        -> if { 0 -> return }
    prepared.package.nodes[range.astStart + symbol.astNode] => node
    node.flags / 128 % 2 == 0 -> if { 0 -> return }
    false => runtimeModule!
    prepared.package.sources[sourceModule] -> slice(UIntSize(0), prepared.package.sources[sourceModule] -> len) => sourceText
    prepared.modules -> each identity {
        identity.sourceIndex == sourceModule and identity.pathHash == 12254170256457402476
            and modules.logicalNameIs(sourceText, identity, range, prepared.package.tokens, "sys.runtime")
            -> if { true => runtimeModule! }
    }
    not runtimeModule! -> if { 0 -> return }
    node.firstToken + node.tokenCount - 1 => end!
    false => foundEnd!
    false => intrinsic!
    end! >= node.firstToken and not foundEnd! -> while {
        prepared.package.tokens[range.tokenStart + end!] => token
        token.kind != grammar.triviaIdWhitespace() and token.kind != grammar.triviaIdComment()
            and token.kind != grammar.tokenIdNewLine()
            -> if {
                true => foundEnd!
                (prepared.package.sources[sourceModule] -> slice(token.span.start, token.span.length)) == "intrinsic" => intrinsic!
            }
        end! - 1 => end!
    }
    not intrinsic! or symbol.nameToken < 0 or symbol.nameToken >= range.tokenCount
        -> if { 0 -> return }
    prepared.package.tokens[range.tokenStart + symbol.nameToken] => nameToken
    prepared.package.sources[sourceModule] -> slice(nameToken.span.start, nameToken.span.length) => name
    when {
        name == "print" or name == "println" or name == "readInt" or name == "eprint"
            or name == "eprintln" or name == "flushStandardOutput" => 1
        name == "openIntWriter" or name == "writeInt" or name == "closeIntWriter"
            or name == "openIntReader" or name == "closestInt" or name == "closeIntReader" => 2
        name == "nowMillis" or name == "utcNowMillis" => 4
        name == "seedRandom" or name == "randomBelow"
            or name == "secureRandomBytes" => 8
        else => 0
    }
}

# Main-only authority belongs to the nearest lexical function's source, not to
# a statement form or an intrinsic-looking name at the call site.
public disallowedMainOnlyCall prepared: ref semanticContext.SemanticSnapshot, index: ref DeclaredEffectIndex, call: calls.ModuleCallResolution -> Bool {
    call.status != 0 or call.sourceModule < 0 or call.sourceModule >= (prepared.package.ranges -> len)
        -> if { false -> return }
    prepared.package.ranges[call.sourceModule] => callerRange
    call.callAst < 0 or call.callAst >= callerRange.astCount
        -> if { false -> return }
    index.owners[callerRange.astStart + call.callAst] < 0
        or (prepared -> semanticContext.isStandardLibrarySource(call.sourceModule))
        -> if { false -> return }
    call.origin == 2 and (call.functionSymbol == -103
        or (call.functionSymbol <= -104 and call.functionSymbol >= -111)
        or call.functionSymbol == -115)
        -> if { true -> return }
    call.targetSourceModule < 0 or call.targetSourceModule >= (prepared.package.ranges -> len)
        -> if { false -> return }
    prepared.package.ranges[call.targetSourceModule] => range
    call.functionSymbol < 0 or call.functionSymbol >= range.symbolCount
        -> if { false -> return }
    prepared.package.symbols[range.symbolStart + call.functionSymbol] => target
    target.nameToken < 0 or target.nameToken >= range.tokenCount
        or target.astNode < 0 or target.astNode >= range.astCount
        -> if { false -> return }
    prepared.package.tokens[range.tokenStart + target.nameToken] => token
    prepared.package.sources[call.targetSourceModule] -> slice(token.span.start, token.span.length) => name
    "" => moduleName!
    prepared.modules -> each identity {
        identity.sourceIndex == call.targetSourceModule
            -> if {
                prepared.package.sources[identity.sourceIndex] -> slice(identity.pathStart, identity.pathLength) => moduleName!
            }
    }
    (moduleName! == "sys.io" and name == "readInt")
        or (moduleName! == "sys.random" and (name == "seed" or name == "below"))
        or (moduleName! == "sys.file" and (name == "openIntWriter" or name == "writeInt"
        or name == "closeIntWriter" or name == "openIntReader" or name == "closestInt" or name == "closeIntReader"))
        -> if { true -> return }
    prepared.package.nodes[range.astStart + target.astNode] => declaration
    declaration.flags / 128 % 2 != 1 -> if { false -> return }
    declaration.firstToken + declaration.tokenCount - 1 => end!
    false => intrinsic!
    false => foundEnd!
    end! >= declaration.firstToken and not foundEnd!
        -> while {
            prepared.package.tokens[range.tokenStart + end!] => last
            last.kind != grammar.triviaIdWhitespace() and last.kind != grammar.triviaIdComment()
                and last.kind != grammar.tokenIdNewLine()
                -> if {
                    true => foundEnd!
                    (prepared.package.sources[call.targetSourceModule] -> slice(last.span.start, last.span.length)) == "intrinsic" => intrinsic!
                }
            end! - 1 => end!
        }
    not intrinsic! -> if { false -> return }
    moduleName! == "sys.runtime" -> if {
        (name == "readInt" or name == "seedRandom" or name == "randomBelow" or name == "secureRandomBytes"
            or name == "openIntWriter" or name == "writeInt" or name == "closeIntWriter"
            or name == "openIntReader" or name == "closestInt" or name == "closeIntReader"
            or name == "limitParallelWorkers" or name == "parallelWorkers" or name == "parallelPeakWorkers"
            or name == "nowMillis" or name == "utcNowMillis" or name == "monotonicSuspendPolicy") -> return
    }
    moduleName! == "sys.file" and (name == "readStandardInput" or name == "readStandardInputChunk")
        -> if { true -> return }
    moduleName! == "sys.input.mouse" and name == "events" and target.parent >= 0 and target.parent < range.symbolCount
        -> if {
            prepared.package.symbols[range.symbolStart + target.parent] => owner
            owner.nameToken >= 0 and owner.nameToken < range.tokenCount
                -> if {
                    prepared.package.tokens[range.tokenStart + owner.nameToken] => ownerToken
                    (prepared.package.sources[call.targetSourceModule] -> slice(ownerToken.span.start, ownerToken.span.length)) == "Source" -> return
                }
        }
    false
}

public indexDeclaredEffects prepared: ref semanticContext.SemanticSnapshot -> DeclaredEffectIndex {
    [Int; ~] => owners!
    [Int; ~] => masks!
    0 => failureCode!
    -1 => failureSource!
    -1 => failureFunction!
    -1 => failureReference!
    prepared.package.nodes -> each node {
        owners! -> push(-1)
        masks! -> push(0)
    }
    prepared.package.ranges -> each range {
        0 => astIndex!
        astIndex! < range.astCount -> while {
            range.astStart + astIndex! => globalAst
            prepared.package.nodes[globalAst] => node
            node.kind == 7 or node.kind == 31 -> if {
                globalAst => owners![globalAst]
            } else {
                node.kind != 8 and node.parent >= 0 and node.parent < astIndex!
                    -> if { owners![range.astStart + node.parent] => owners![globalAst] }
            }
            owners![globalAst] => owner
            node.kind == 52 and owner >= 0 and node.tokenCount == 1
                and node.firstToken >= 0 and node.firstToken < range.tokenCount
                -> if {
                    prepared.package.tokens[range.tokenStart + node.firstToken] => token
                    prepared.package.sources[range.sourceModule] -> slice(token.span.start, token.span.length)
                        -> declaredEffectBit => bit
                    bit == 0 or (bit > 0 and masks![owner] / bit % 2 == 1)
                        -> if {
                            failureCode! == 0 -> if {
                                bit == 0 -> if { 44 } else { 45 } => failureCode!
                                range.sourceModule => failureSource!
                                owner - range.astStart => failureFunction!
                                astIndex! => failureReference!
                            }
                        }
                    bit > 0 -> if {
                        masks![owner] / bit % 2 == 0 -> if { masks![owner] + bit => masks![owner] }
                    }
                }
            astIndex! + 1 => astIndex!
        }
        0 => symbolIndex!
        symbolIndex! < range.symbolCount -> while {
            prepared.package.symbols[range.symbolStart + symbolIndex!] => symbol
            symbol.kind == 7 or symbol.kind == 31 -> if {
                prepared -> intrinsicDeclarationEffect(range.sourceModule, symbolIndex!) => intrinsicBit
                intrinsicBit > 0 -> if { intrinsicBit => masks![range.astStart + symbol.astNode] }
            }
            symbolIndex! + 1 => symbolIndex!
        }
    }
    DeclaredEffectIndex {
        owners: owners!
        masks: masks!
        failureCode: failureCode!
        failureSourceModule: failureSource!
        failureFunctionAst: failureFunction!
        failureReferenceAst: failureReference!
    }
}

# Return the first missing declared capability, in the callee's source order.
# Valid calls use the indexed masks; only a missing contract scans its signature.
public missingCallEffect prepared: ref semanticContext.SemanticSnapshot, index: ref DeclaredEffectIndex, call: calls.ModuleCallResolution -> Int {
    call.status != 0 or call.sourceModule < 0 or call.sourceModule >= (prepared.package.ranges -> len)
        -> if { 0 -> return }
    prepared.package.ranges[call.sourceModule] => range
    call.callAst < 0 or call.callAst >= range.astCount
        -> if { 0 -> return }
    index.owners[range.astStart + call.callAst] => caller
    caller < 0 -> if { 0 -> return }
    index.masks[caller] => callerMask
    call.origin == 2 and call.functionSymbol == -114
        -> if {
            callerMask / 2 % 2 == 0 -> if { 2 -> return }
            0 -> return
        }
    call.origin == 2 and (call.functionSymbol == -101 or call.functionSymbol == -102
        or call.functionSymbol == -103
        or call.functionSymbol == -116 or call.functionSymbol == -117)
        -> if {
            callerMask % 2 == 0 -> if { 1 -> return }
            0 -> return
        }
    call.functionSymbol < 0 or call.targetSourceModule < 0
        or call.targetSourceModule >= (prepared.package.ranges -> len)
        -> if { 0 -> return }
    prepared.package.ranges[call.targetSourceModule] => targetRange
    call.functionSymbol >= targetRange.symbolCount
        -> if { 0 -> return }
    prepared.package.symbols[targetRange.symbolStart + call.functionSymbol] => target
    target.astNode < 0 or target.astNode >= targetRange.astCount
        -> if { 0 -> return }
    targetRange.astStart + target.astNode => callee
    index.masks[callee] => requiredMask
    requiredMask == 0 or callerMask == 127 -> if { 0 -> return }
    false => missing!
    1 => bit!
    bit! <= 64 and not missing! -> while {
        requiredMask / bit! % 2 == 1 and callerMask / bit! % 2 == 0
            -> if { true => missing! }
        bit! * 2 => bit!
    }
    not missing! -> if { 0 -> return }
    prepared -> intrinsicDeclarationEffect(call.targetSourceModule, call.functionSymbol) => intrinsicBit
    intrinsicBit > 0 -> if { intrinsicBit -> return }
    target.astNode + 1 => astIndex!
    astIndex! < targetRange.astCount -> while {
        targetRange.astStart + astIndex! => globalAst
        prepared.package.nodes[globalAst] => node
        node.kind == 52 and index.owners[globalAst] == callee and node.tokenCount == 1
            and node.firstToken >= 0 and node.firstToken < targetRange.tokenCount
            -> if {
                prepared.package.tokens[targetRange.tokenStart + node.firstToken] => token
                prepared.package.sources[call.targetSourceModule] -> slice(token.span.start, token.span.length)
                    -> declaredEffectBit => bit
                bit > 0 -> if {
                    callerMask / bit % 2 == 0 -> if { bit -> return }
                }
            }
        astIndex! + 1 => astIndex!
    }
    0
}

tokenTextIs request: TokenTextRequest -> Bool {
    request.token.span.length == (request.expected -> len) => equal!
    UIntSize(0) => index!
    equal! and index! < request.token.span.length
        -> while {
            (request.source -> byte(request.token.span.start + index!)) != (request.expected -> byte(index!))
                -> if {
                    false => equal!
                }
            index! + 1 => index!
        }
    equal!
}

effectMask request: EffectMaskRequest -> Int {
    request.source -> slice(request.token.span.start, request.token.span.length) -> declaredEffectBit
}

hasEffect request: HasEffectRequest -> Bool {
    (request.mask / request.effect) % 2 == 1
}

public analyze sources: [Text; ~] -> EffectAnalysis {
    sources -> semanticContext.prepare => prepared
    prepared -> analyzeContext
}

public analyzeContext prepared: semanticContext.SemanticSnapshot -> EffectAnalysis {
    [FunctionEffect; ~] => functions!
    [EffectDiagnostic; ~] => diagnostics!
    [1, 2, 4, 8, 16, 32, 64] => effectBits

    # First build one source-qualified effect fact for every function symbol.
    0 => sourceIndex!
    sourceIndex! < (prepared.package.sources -> len)
        -> while {
            prepared.package.sources[sourceIndex!] -> len => sourceLength
            prepared.package.sources[sourceIndex!] -> slice(UIntSize(0), sourceLength) => source
            prepared.package.ranges[sourceIndex!] => sourceRange
            0 => symbolIndex!
            symbolIndex! < sourceRange.symbolCount -> while {
                prepared.package.symbols[sourceRange.symbolStart + symbolIndex!] => symbol
                symbol.kind == 7 -> if {
                    prepared.package.nodes[sourceRange.astStart + symbol.astNode] => functionNode
                    -1 => signatureAst!
                    0 => childIndex!
                    childIndex! < sourceRange.astCount and signatureAst! < 0
                        -> while {
                            prepared.package.nodes[sourceRange.astStart + childIndex!] => child
                            child.parent == symbol.astNode and child.kind == 17
                                -> if { childIndex! => signatureAst! }
                            childIndex! + 1 => childIndex!
                        }

                    0 => mask!
                    false => afterUses!
                    signatureAst! >= 0 -> if {
                        prepared.package.nodes[sourceRange.astStart + signatureAst!] => signature
                        signature.firstToken => tokenIndex!
                        tokenIndex! < signature.firstToken + signature.tokenCount
                            -> while {
                                prepared.package.tokens[sourceRange.tokenStart + tokenIndex!] => token
                                TokenTextRequest { source: source, token: token, expected: "uses" } -> tokenTextIs
                                    -> if {
                                        true => afterUses!
                                    } else {
                                        afterUses! and token.kind == grammar.tokenIdIdentifier()
                                            -> if {
                                                EffectMaskRequest { source: source, token: token } -> effectMask => effect
                                                effect == 0 -> if {
                                                    -1 => effectReferenceAst!
                                                    0 => effectReferenceSearch!
                                                    effectReferenceSearch! < sourceRange.astCount and effectReferenceAst! < 0
                                                        -> while {
                                                            prepared.package.nodes[sourceRange.astStart + effectReferenceSearch!] => effectReferenceCandidate
                                                            effectReferenceCandidate.kind == 52 and tokenIndex! >= effectReferenceCandidate.firstToken and tokenIndex! < effectReferenceCandidate.firstToken + effectReferenceCandidate.tokenCount
                                                                -> if {
                                                                    effectReferenceSearch! => effectReferenceAst!
                                                                }
                                                            effectReferenceSearch! + 1 => effectReferenceSearch!
                                                        }
                                                    -1 => effectReferenceLastToken!
                                                    false => qualifiedEffectReference!
                                                    effectReferenceAst! >= 0 -> if {
                                                        prepared.package.nodes[sourceRange.astStart + effectReferenceAst!] => effectReference
                                                        effectReference.firstToken => effectReferenceToken!
                                                        effectReferenceToken! < effectReference.firstToken + effectReference.tokenCount
                                                            -> while {
                                                                prepared.package.tokens[sourceRange.tokenStart + effectReferenceToken!].kind == grammar.tokenIdIdentifier()
                                                                    -> if { effectReferenceToken! => effectReferenceLastToken! }
                                                                prepared.package.tokens[sourceRange.tokenStart + effectReferenceToken!].kind == grammar.tokenIdDot()
                                                                    -> if { true => qualifiedEffectReference! }
                                                                effectReferenceToken! + 1 => effectReferenceToken!
                                                            }
                                                    }
                                                    false => knownUserEffect!
                                                    tokenIndex! == effectReferenceLastToken! -> if {
                                                        0 => localEffectSearch!
                                                        localEffectSearch! < sourceRange.symbolCount
                                                            -> while {
                                                                prepared.package.symbols[sourceRange.symbolStart + localEffectSearch!] => localEffect
                                                                localEffect.kind == 50 and localEffect.parent < 0
                                                                    -> if {
                                                                        prepared.package.tokens[sourceRange.tokenStart + localEffect.nameToken] => localEffectName
                                                                        token.span.length == localEffectName.span.length => sameEffectName!
                                                                        UIntSize(0) => effectNameByte!
                                                                        sameEffectName! and effectNameByte! < token.span.length
                                                                            -> while {
                                                                                (source -> byte(token.span.start + effectNameByte!)) != (source -> byte(localEffectName.span.start + effectNameByte!))
                                                                                    -> if { false => sameEffectName! }
                                                                                effectNameByte! + 1 => effectNameByte!
                                                                            }
                                                                        sameEffectName! -> if { true => knownUserEffect! }
                                                                    }
                                                                localEffectSearch! + 1 => localEffectSearch!
                                                            }
                                                        0 => importedEffectSearch!
                                                        importedEffectSearch! < (prepared.qualified -> len)
                                                            -> while {
                                                                prepared.qualified[importedEffectSearch!] => importedEffect
                                                                importedEffect.sourceModule == sourceIndex! -> if {
                                                                    importedEffect.pathAst => importedEffectAncestor!
                                                                    false => belongsToEffectReference!
                                                                    importedEffectAncestor! >= 0 and not belongsToEffectReference!
                                                                        -> while {
                                                                            importedEffectAncestor! == effectReferenceAst!
                                                                                -> if { true => belongsToEffectReference! } else {
                                                                                    prepared.package.nodes[sourceRange.astStart + importedEffectAncestor!].parent => importedEffectAncestor!
                                                                                }
                                                                        }
                                                                    belongsToEffectReference!
                                                                        and importedEffect.targetModule >= 0
                                                                        and importedEffect.targetModule < (prepared.modules -> len)
                                                                        and importedEffect.targetSymbol >= 0 -> if {
                                                                            prepared.modules[importedEffect.targetModule].sourceIndex => importedEffectSource
                                                                            importedEffectSource >= 0 -> if {
                                                                                prepared.package.ranges[importedEffectSource] => importedEffectRange
                                                                                prepared.package.symbols[importedEffectRange.symbolStart + importedEffect.targetSymbol].kind == 50
                                                                                    -> if { true => knownUserEffect! }
                                                                            }
                                                                        }
                                                                }
                                                                importedEffectSearch! + 1 => importedEffectSearch!
                                                            }
                                                        not knownUserEffect! and not qualifiedEffectReference!
                                                            -> if {
                                                                diagnostics! -> push(EffectDiagnostic {
                                                                    code: 2
                                                                    sourceModule: sourceIndex!
                                                                    functionSymbol: symbolIndex!
                                                                    targetSourceModule: -1
                                                                    targetFunctionSymbol: -1
                                                                    effectMask: 0
                                                                    astNode: symbol.astNode
                                                                    span: token.span
                                                                })
                                                            }
                                                    }
                                                } else {
                                                    HasEffectRequest { mask: mask!, effect: effect } -> hasEffect
                                                        -> if {
                                                            diagnostics! -> push(EffectDiagnostic {
                                                                code: 3
                                                                sourceModule: sourceIndex!
                                                                functionSymbol: symbolIndex!
                                                                targetSourceModule: -1
                                                                targetFunctionSymbol: -1
                                                                effectMask: effect
                                                                astNode: symbol.astNode
                                                                span: token.span
                                                            })
                                                        } else {
                                                            mask! + effect => mask!
                                                        }
                                                }
                                            }
                                    }
                                tokenIndex! + 1 => tokenIndex!
                            }
                    }
                    functions! -> push(FunctionEffect {
                        sourceModule: sourceIndex!
                        functionSymbol: symbolIndex!
                        mask: mask!
                    })
                }
                symbolIndex! + 1 => symbolIndex!
            }
            sourceIndex! + 1 => sourceIndex!
        }

    # Then validate every prepared resolved call against its lexical caller.
    0 => callIndex!
    callIndex! < (prepared.calls -> len) -> while {
        prepared.calls[callIndex!] => call
        call.status == 0 -> if {
            prepared.package.ranges[call.sourceModule] => sourceRange
            prepared.package.nodes[sourceRange.astStart + call.callAst] => callNode
            callNode.parent => ancestor!
            -1 => callerAst!
            ancestor! >= 0 and callerAst! < 0 -> while {
                prepared.package.nodes[sourceRange.astStart + ancestor!] => ancestorNode
                ancestorNode.kind == 7 -> if {
                    ancestor! => callerAst!
                } else {
                    ancestorNode.kind == 8 -> if {
                        -2 => callerAst!
                    } else {
                        ancestorNode.parent => ancestor!
                    }
                }
            }

            # Main is the unrestricted root capability boundary.
            callerAst! >= 0 -> if {
                -1 => callerSymbol!
                0 => callerSymbolSearch!
                callerSymbolSearch! < sourceRange.symbolCount and callerSymbol! < 0
                    -> while {
                        prepared.package.symbols[sourceRange.symbolStart + callerSymbolSearch!] => callerCandidate
                        callerCandidate.kind == 7 and callerCandidate.astNode == callerAst!
                            -> if {
                                callerSymbolSearch! => callerSymbol!
                            }
                        callerSymbolSearch! + 1 => callerSymbolSearch!
                    }

                0 => callerMask!
                0 => callerFactIndex!
                callerFactIndex! < (functions! -> len) -> while {
                    functions![callerFactIndex!] => callerFact
                    callerFact.sourceModule == call.sourceModule and callerFact.functionSymbol == callerSymbol!
                        -> if {
                            callerFact.mask => callerMask!
                        }
                    callerFactIndex! + 1 => callerFactIndex!
                }

                0 => requiredMask!
                call.functionSymbol == -101 or call.functionSymbol == -102 or call.functionSymbol == -103
                    -> if {
                        1 => requiredMask!
                    } else {
                        call.functionSymbol == -104 or call.functionSymbol == -105
                            -> if {
                                8 => requiredMask!
                            } else {
                                call.functionSymbol <= -106 and call.functionSymbol >= -111
                                    -> if {
                                        2 => requiredMask!
                                    } else {
                                        call.functionSymbol == -112 or call.functionSymbol == -113
                                            -> if {
                                                4 => requiredMask!
                                            } else {
                                                call.functionSymbol == -114 -> if {
                                                    2 => requiredMask!
                                                } else {
                                                    0 => targetFactIndex!
                                                    targetFactIndex! < (functions! -> len) -> while {
                                                        functions![targetFactIndex!] => targetFact
                                                        targetFact.sourceModule == call.targetSourceModule and targetFact.functionSymbol == call.functionSymbol
                                                            -> if {
                                                                targetFact.mask => requiredMask!
                                                            }
                                                        targetFactIndex! + 1 => targetFactIndex!
                                                    }
                                                }
                                            }
                                    }
                            }
                    }

                0 => effectBitIndex!
                effectBitIndex! < 7 -> while {
                    effectBits[effectBitIndex!] => requiredEffect
                    HasEffectRequest { mask: requiredMask!, effect: requiredEffect } => requiredEffectRequest
                    requiredEffectRequest -> hasEffect => requiresEffect
                    HasEffectRequest { mask: callerMask!, effect: requiredEffect } => callerEffectRequest
                    callerEffectRequest -> hasEffect => callerHasEffect
                    requiresEffect and not callerHasEffect -> if {
                        diagnostics! -> push(EffectDiagnostic {
                            code: 1
                            sourceModule: call.sourceModule
                            functionSymbol: callerSymbol!
                            targetSourceModule: call.targetSourceModule
                            targetFunctionSymbol: call.functionSymbol
                            effectMask: requiredEffect
                            astNode: call.callAst
                            span: syntax.SourceSpan {
                                fileId: call.sourceModule
                                start: callNode.start
                                length: callNode.length
                            }
                        })
                    }
                    effectBitIndex! + 1 => effectBitIndex!
                }
            }
        }
        callIndex! + 1 => callIndex!
    }

    # Memory-map construction is syntax rather than a function call, so derive
    # it directly from the prepared AST. Mapped-view flush uses runtime alias
    # -114 above and therefore follows the ordinary resolved-call path.
    0 => mapSourceIndex!
    mapSourceIndex! < (prepared.package.sources -> len)
        -> while {
            prepared.package.ranges[mapSourceIndex!] => mapSourceRange
            0 => mapAstIndex!
            mapAstIndex! < mapSourceRange.astCount -> while {
                prepared.package.nodes[mapSourceRange.astStart + mapAstIndex!] => mapNode
                mapNode.kind == 49 -> if {
                    mapNode.parent => mapAncestor!
                    -1 => mapCallerAst!
                    mapAncestor! >= 0 and mapCallerAst! < 0 -> while {
                        prepared.package.nodes[mapSourceRange.astStart + mapAncestor!] => mapAncestorNode
                        mapAncestorNode.kind == 7 -> if {
                            mapAncestor! => mapCallerAst!
                        } else {
                            mapAncestorNode.kind == 8 -> if {
                                -2 => mapCallerAst!
                            } else {
                                mapAncestorNode.parent => mapAncestor!
                            }
                        }
                    }
                    mapCallerAst! >= 0 -> if {
                        -1 => mapCallerSymbol!
                        0 => mapSymbolSearch!
                        mapSymbolSearch! < mapSourceRange.symbolCount and mapCallerSymbol! < 0
                            -> while {
                                prepared.package.symbols[mapSourceRange.symbolStart + mapSymbolSearch!] => mapCandidate
                                mapCandidate.kind == 7 and mapCandidate.astNode == mapCallerAst!
                                    -> if {
                                        mapSymbolSearch! => mapCallerSymbol!
                                    }
                                mapSymbolSearch! + 1 => mapSymbolSearch!
                            }
                        0 => mapCallerMask!
                        0 => mapFactSearch!
                        mapFactSearch! < (functions! -> len) -> while {
                            functions![mapFactSearch!] => mapFact
                            mapFact.sourceModule == mapSourceIndex! and mapFact.functionSymbol == mapCallerSymbol!
                                -> if {
                                    mapFact.mask => mapCallerMask!
                                }
                            mapFactSearch! + 1 => mapFactSearch!
                        }
                        not (HasEffectRequest { mask: mapCallerMask!, effect: 2 } -> hasEffect)
                            -> if {
                                diagnostics! -> push(EffectDiagnostic {
                                    code: 1
                                    sourceModule: mapSourceIndex!
                                    functionSymbol: mapCallerSymbol!
                                    targetSourceModule: -1
                                    targetFunctionSymbol: -115
                                    effectMask: 2
                                    astNode: mapAstIndex!
                                    span: syntax.SourceSpan {
                                        fileId: mapSourceIndex!
                                        start: mapNode.start
                                        length: mapNode.length
                                    }
                                })
                            }
                    }
                }
                mapAstIndex! + 1 => mapAstIndex!
            }
            mapSourceIndex! + 1 => mapSourceIndex!
        }

    EffectAnalysis { functions: functions!, diagnostics: diagnostics! } => result
    result
}
