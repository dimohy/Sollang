namespace sollang.compiler.semantic.type_terms

import sollang.compiler.ast
import sollang.compiler.lexer
import sollang.compiler.syntax as syntax
import syntax.generated.slg as grammar

# A semantic type is a canonical, index-addressed tree. Argument fields point
# back into the same arena, so nested types do not require recursive objects.
# Kinds: 1 nominal, 2 slice, 3 dynamic array, 4 fixed array,
# 5 dictionary, 6 box, 7 nominal application, 8 readonly reference,
# 10 structural product, 11 structural product field,
# 12 bounded inline array, 13 bounded inline dictionary,
# 14 fixed inline BitSet, 15 erased trait object.
public struct TypeTerm {
    public astNode: Int
    public canonical: Int
    public kind: Int
    public nameToken: Int
    public nameId: Int
    public firstArgument: Int
    public secondArgument: Int
    public lengthToken: Int
    public lengthId: Int
}

public struct SubstitutionRequest {
    public terms: [TypeTerm; ~]
    public root: Int
    public parameter: Int
    public replacement: Int
}

public struct SubstitutionResult {
    public terms: [TypeTerm; ~]
    public root: Int
    public status: Int
}

sameTypePathTokens source: Text, nodes: ref [ast.AstNode; ~], tokens: ref [syntax.SyntaxToken; ~], leftAst: Int, rightAst: Int -> Bool {
    nodes[leftAst].firstToken => left!
    nodes[rightAst].firstToken => right!
    nodes[leftAst].firstToken + nodes[leftAst].tokenCount => leftEnd
    nodes[rightAst].firstToken + nodes[rightAst].tokenCount => rightEnd
    left! < leftEnd or right! < rightEnd -> while {
        left! < leftEnd and (tokens[left!].kind == grammar.triviaIdWhitespace() or tokens[left!].kind == grammar.triviaIdComment() or tokens[left!].kind == grammar.tokenIdNewLine())
            -> while { left! + 1 => left! }
        right! < rightEnd and (tokens[right!].kind == grammar.triviaIdWhitespace() or tokens[right!].kind == grammar.triviaIdComment() or tokens[right!].kind == grammar.tokenIdNewLine())
            -> while { right! + 1 => right! }
        left! == leftEnd or right! == rightEnd -> if { left! == leftEnd and right! == rightEnd -> return }
        tokens[left!] => leftToken
        tokens[right!] => rightToken
        leftToken.kind != rightToken.kind or leftToken.span.length != rightToken.span.length
            -> if { false -> return }
        UIntSize(0) => index!
        index! < leftToken.span.length -> while {
            (source -> byte(leftToken.span.start + index!)) != (source -> byte(rightToken.span.start + index!))
                -> if { false -> return }
            index! + 1 => index!
        }
        left! + 1 => left!
        right! + 1 => right!
    }
    true
}

# A storage suffix belongs to the outer collection only. Generic applications,
# products and nested collections keep their own semicolons and capacities.
public struct TypeStorageSuffix {
    public semicolon: Bool
    public dynamic: Bool
    public bounded: Bool
    public lengthToken: Int
}

# ProductElement and ProductTypeField have the same optional Identifier Colon
# prefix. Colons inside the value or type are never labels of this field.
public productFieldLabelToken tokens: ref [syntax.SyntaxToken; ~], tokenStart: Int, firstToken: Int, tokenCount: Int -> Int {
    -1 => nameToken!
    firstToken => cursor!
    cursor! < firstToken + tokenCount -> while {
        tokens[tokenStart + cursor!].kind => kind
        kind != grammar.triviaIdWhitespace() and kind != grammar.triviaIdComment()
            and kind != grammar.tokenIdNewLine()
            -> if {
                nameToken! < 0 -> if {
                    kind != grammar.tokenIdIdentifier() -> if { -1 -> return }
                    cursor! => nameToken!
                } else {
                    kind == grammar.tokenIdColon() -> if { nameToken! -> return }
                    -1 -> return
                }
            }
        cursor! + 1 => cursor!
    }
    -1
}

public outerTypeStorageSuffix firstToken: Int, tokenEnd: Int, tokens: ref [syntax.SyntaxToken; ~] -> TypeStorageSuffix {
    0 => depth!
    false => semicolon!
    false => dynamic!
    false => bounded!
    -1 => lengthToken!
    firstToken => tokenIndex!
    tokenIndex! < tokenEnd -> while {
        tokens[tokenIndex!].kind => kind
        kind == grammar.tokenIdLeftBracket()
            or kind == grammar.tokenIdLeftBrace()
            or kind == grammar.tokenIdLeftParen()
            or kind == grammar.tokenIdLess()
            -> if { depth! + 1 => depth! }
        kind == grammar.tokenIdRightBracket()
            or kind == grammar.tokenIdRightBrace()
            or kind == grammar.tokenIdRightParen()
            or kind == grammar.tokenIdGreater()
            -> if { depth! - 1 => depth! }
        depth! == 1 -> if {
            kind == grammar.tokenIdSemicolon() -> if { true => semicolon! }
            semicolon! -> if {
                kind == grammar.tokenIdTilde() -> if { true => dynamic! }
                kind == grammar.tokenIdLessEqual() -> if { true => bounded! }
                lengthToken! < 0 and (kind == grammar.tokenIdNumber() or kind == grammar.tokenIdIdentifier())
                    -> if { tokenIndex! => lengthToken! }
            }
        }
        tokenIndex! + 1 => tokenIndex!
    }
    TypeStorageSuffix {
        semicolon: semicolon!
        dynamic: dynamic!
        bounded: bounded!
        lengthToken: lengthToken!
    }
}

# Lowers every TypeAnnotation, including nested children, into one arena. An
# impl's direct nominal Path also becomes a term so every impl owner publishes
# a canonical TypeReference without changing the bootstrap-compatible AST.
public lower source: Text -> [TypeTerm; ~] {
    source -> ast.lower => nodes
    source -> lexer.lex => tokens
    source -> lowerPrepared(nodes, tokens)
}

public lowerPrepared source: Text, nodes: ref [ast.AstNode; ~], tokens: ref [syntax.SyntaxToken; ~] -> [TypeTerm; ~] {
    [TypeTerm; ~] => terms!
    [Int; ~] => astToTerm!
    0 => astMapIndex!
    astMapIndex! < (nodes -> len) -> while {
        astToTerm! -> push(-1)
        astMapIndex! + 1 => astMapIndex!
    }

    0 => astIndex!
    astIndex! < (nodes -> len) -> while {
        nodes[astIndex!] => node
        node.kind == 12
            or (node.kind == 16 and node.parent >= 0
            and (nodes[node.parent].kind == 6
            or (nodes[node.parent].kind == 12 and nodes[node.parent].parent >= 0 and nodes[nodes[node.parent].parent].kind == 6)))
            -> if {
                node.firstToken => firstToken!
                node.firstToken + node.tokenCount => typeTokenEnd!
                # The CST for a structural impl owner keeps its brackets on the
                # ImplDeclaration rather than on the direct TypeAnnotation. Pull
                # that exact balanced span into semantic lowering; otherwise
                # `impl [UInt8]` is indistinguishable from nominal `impl UInt8`.
                node.kind == 12 and node.parent >= 0 and nodes[node.parent].kind == 6
                    and node.start > 0 and (source -> byte(node.start - 1)) == 91
                    -> if {
                        firstToken! - 1 => ownerOpenToken!
                        ownerOpenToken! >= 0 and tokens[ownerOpenToken!].kind != grammar.tokenIdLeftBracket()
                            -> while { ownerOpenToken! - 1 => ownerOpenToken! }
                        ownerOpenToken! >= 0 -> if {
                            ownerOpenToken! => firstToken!
                            0 => ownerBracketDepth!
                            firstToken! => ownerBracketToken!
                            ownerBracketToken! < (tokens -> len) and typeTokenEnd! <= node.firstToken + node.tokenCount
                                -> while {
                                    tokens[ownerBracketToken!].kind == grammar.tokenIdLeftBracket()
                                        -> if { ownerBracketDepth! + 1 => ownerBracketDepth! }
                                    tokens[ownerBracketToken!].kind == grammar.tokenIdRightBracket()
                                        -> if { ownerBracketDepth! - 1 => ownerBracketDepth! }
                                    ownerBracketToken! + 1 => ownerBracketToken!
                                    ownerBracketDepth! == 0 -> if { ownerBracketToken! => typeTokenEnd! }
                                }
                        }
                    }
                true => findingFirst!
                firstToken! < typeTokenEnd! and findingFirst!
                    -> while {
                        tokens[firstToken!].kind == grammar.triviaIdWhitespace() or tokens[firstToken!].kind == grammar.triviaIdComment()
                            -> if {
                                firstToken! + 1 => firstToken!
                            } else {
                                false => findingFirst!
                            }
                    }
                1 => kind!
                -1 => nameToken!
                -1 => lengthToken!
                node.cstRuleId == grammar.ruleIdProductType()
                    -> if {
                        10 => kind!
                    }
                node.cstRuleId == grammar.ruleIdProductTypeField()
                    -> if {
                        11 => kind!
                        tokens -> productFieldLabelToken(0, node.firstToken, node.tokenCount) => nameToken!
                    }
                kind! == 1 and tokens[firstToken!].kind == grammar.tokenIdLeftBracket()
                    -> if {
                        2 => kind!
                        firstToken! -> outerTypeStorageSuffix(typeTokenEnd!, tokens) => suffix
                        suffix.semicolon => outerSemicolon
                        suffix.dynamic => outerTilde
                        suffix.bounded => outerBounded
                        suffix.lengthToken => lengthToken!
                        outerSemicolon -> if {
                            outerBounded -> if { 12 => kind! } else {
                                outerTilde -> if { 3 => kind! } else { 4 => kind! }
                            }
                        }
                    } else {
                        kind! == 1 and tokens[firstToken!].kind == grammar.tokenIdLeftBrace()
                            -> if {
                                5 => kind!
                                firstToken! -> outerTypeStorageSuffix(typeTokenEnd!, tokens) => suffix
                                suffix.lengthToken => lengthToken!
                                suffix.bounded -> if { 13 => kind! }
                            } else {
                                kind! == 1 and tokens[firstToken!].kind == grammar.tokenIdIdentifier()
                                    -> if {
                                        firstToken! => nameToken!
                                        tokens[firstToken!] => firstName
                                        firstName.span.length == 3 -> if {
                                            source -> byte(firstName.span.start) => keywordByte0
                                            source -> byte(firstName.span.start + 1) => keywordByte1
                                            source -> byte(firstName.span.start + 2) => keywordByte2
                                            keywordByte0 == 98 and keywordByte1 == 111 and keywordByte2 == 120
                                                -> if {
                                                    6 => kind!
                                                    -1 => nameToken!
                                                }
                                            keywordByte0 == 114 and keywordByte1 == 101 and keywordByte2 == 102
                                                -> if {
                                                    8 => kind!
                                                    -1 => nameToken!
                                                }
                                            keywordByte0 == 100 and keywordByte1 == 121 and keywordByte2 == 110
                                                -> if {
                                                    15 => kind!
                                                    firstToken! + 1 => traitToken!
                                                    traitToken! < typeTokenEnd! and tokens[traitToken!].kind != grammar.tokenIdIdentifier()
                                                        -> while { traitToken! + 1 => traitToken! }
                                                    traitToken! < typeTokenEnd! -> if { traitToken! => nameToken! }
                                                }
                                        }
                                        firstName.span.length == 6 -> if {
                                            source -> byte(firstName.span.start) => keywordByte0
                                            source -> byte(firstName.span.start + 1) => keywordByte1
                                            source -> byte(firstName.span.start + 2) => keywordByte2
                                            source -> byte(firstName.span.start + 3) => keywordByte3
                                            source -> byte(firstName.span.start + 4) => keywordByte4
                                            source -> byte(firstName.span.start + 5) => keywordByte5
                                            keywordByte0 == 66 and keywordByte1 == 105 and keywordByte2 == 116 and keywordByte3 == 83 and keywordByte4 == 101 and keywordByte5 == 116
                                                -> if {
                                                    14 => kind!
                                                    firstToken! + 1 => bitSetToken!
                                                    bitSetToken! < typeTokenEnd! and lengthToken! < 0
                                                        -> while {
                                                            tokens[bitSetToken!].kind == grammar.tokenIdNumber()
                                                                -> if { bitSetToken! => lengthToken! }
                                                            bitSetToken! + 1 => bitSetToken!
                                                        }
                                                }
                                        }
                                    }
                            }
                    }
                TypeTerm {
                    astNode: astIndex!
                    canonical: -1
                    kind: kind!
                    nameToken: nameToken!
                    nameId: -1
                    firstArgument: -1
                    secondArgument: -1
                    lengthToken: lengthToken!
                    lengthId: -1
                } => term
                terms! -> len => termIndex
                terms! -> push(term)
                termIndex => astToTerm![astIndex!]
            }
        astIndex! + 1 => astIndex!
    }

    # Link direct type children in source order. The grammar permits at most
    # two generic arguments, matching dictionary and Result-like applications.
    0 => termIndex!
    termIndex! < (terms! -> len) -> while {
        terms![termIndex!] => term!
        -1 => firstChild!
        -1 => secondChild!
        0 => childIndex!
        childIndex! < (terms! -> len) -> while {
            terms![childIndex!] => child
            nodes[child.astNode].parent == term!.astNode
                -> if {
                    firstChild! < 0 -> if {
                        childIndex! => firstChild!
                    } else {
                        nodes[child.astNode].firstToken < nodes[terms![firstChild!].astNode].firstToken
                            -> if {
                                firstChild! => secondChild!
                                childIndex! => firstChild!
                            } else {
                                secondChild! < 0 -> if {
                                    childIndex! => secondChild!
                                } else {
                                    nodes[child.astNode].firstToken < nodes[terms![secondChild!].astNode].firstToken
                                        -> if {
                                            childIndex! => secondChild!
                                        }
                                }
                            }
                    }
                }
            childIndex! + 1 => childIndex!
        }
        firstChild! => term!.firstArgument
        secondChild! => term!.secondArgument
        term!.kind == 1 and firstChild! >= 0 -> if {
            term!.nameToken >= 0 -> if {
                7 => term!.kind
            } else {
                # Grammar-only type annotations are transparent. Their child
                # owns the semantic identity (including structural products).
                0 => term!.kind
            }
        }

        term!.nameToken >= 0 -> if {
            termIndex! => term!.nameId
            0 => priorNameIndex!
            priorNameIndex! < termIndex! and term!.nameId == termIndex!
                -> while {
                    terms![priorNameIndex!].nameToken >= 0 -> if {
                        tokens[term!.nameToken] => currentName
                        tokens[terms![priorNameIndex!].nameToken] => priorName
                        currentName.span.length == priorName.span.length => sameName!
                        UIntSize(0) => nameByte!
                        sameName! and nameByte! < currentName.span.length
                            -> while {
                                source -> byte(currentName.span.start + nameByte!) => currentByte
                                source -> byte(priorName.span.start + nameByte!) => priorByte
                                currentByte != priorByte -> if { false => sameName! }
                                nameByte! + 1 => nameByte!
                            }
                        sameName! and (term!.kind == 15 or terms![priorNameIndex!].kind == 15)
                            -> if {
                                term!.kind == terms![priorNameIndex!].kind
                                    and (source -> sameTypePathTokens(nodes, tokens, term!.astNode, terms![priorNameIndex!].astNode)) => sameName!
                            }
                        sameName! -> if { terms![priorNameIndex!].nameId => term!.nameId }
                    }
                    priorNameIndex! + 1 => priorNameIndex!
                }
        }
        term!.lengthToken >= 0 -> if {
            termIndex! => term!.lengthId
            0 => priorLengthIndex!
            priorLengthIndex! < termIndex! and term!.lengthId == termIndex!
                -> while {
                    terms![priorLengthIndex!].lengthToken >= 0 -> if {
                        tokens[term!.lengthToken] => currentLength
                        tokens[terms![priorLengthIndex!].lengthToken] => priorLength
                        currentLength.span.length == priorLength.span.length => sameLength!
                        UIntSize(0) => lengthByte!
                        sameLength! and lengthByte! < currentLength.span.length
                            -> while {
                                source -> byte(currentLength.span.start + lengthByte!) => currentByte
                                source -> byte(priorLength.span.start + lengthByte!) => priorByte
                                currentByte != priorByte -> if { false => sameLength! }
                                lengthByte! + 1 => lengthByte!
                            }
                        sameLength! -> if { terms![priorLengthIndex!].lengthId => term!.lengthId }
                    }
                    priorLengthIndex! + 1 => priorLengthIndex!
                }
        }
        term! => terms![termIndex!]
        termIndex! + 1 => termIndex!
    }

    # Product fields form an arbitrary-length linked list through
    # secondArgument. Each field's firstArgument is its annotated value type.
    0 => productRootIndex!
    productRootIndex! < (terms! -> len) -> while {
        terms![productRootIndex!] => productRoot!
        productRoot!.kind == 10 -> if {
            -1 => firstProductField!
            -1 => previousProductField!
            UIntSize(0) => previousProductStart!
            true => productFieldChanged!
            productFieldChanged! -> while {
                false => productFieldChanged!
                -1 => nextProductField!
                UIntSize(0) => nextProductStart!
                0 => productFieldSearch!
                productFieldSearch! < (terms! -> len) -> while {
                    terms![productFieldSearch!] => productFieldCandidate
                    productFieldCandidate.kind == 11 and nodes[productFieldCandidate.astNode].parent == productRoot!.astNode
                        -> if {
                            nodes[productFieldCandidate.astNode].start => productFieldStart
                            previousProductField! < 0 or productFieldStart > previousProductStart!
                                -> if {
                                    nextProductField! < 0 or productFieldStart < nextProductStart!
                                        -> if {
                                            productFieldSearch! => nextProductField!
                                            productFieldStart => nextProductStart!
                                        }
                                }
                        }
                    productFieldSearch! + 1 => productFieldSearch!
                }
                nextProductField! >= 0 -> if {
                    firstProductField! < 0 -> if { nextProductField! => firstProductField! }
                    previousProductField! >= 0 -> if {
                        terms![previousProductField!] => previousField!
                        nextProductField! => previousField!.secondArgument
                        previousField! => terms![previousProductField!]
                    }
                    nextProductField! => previousProductField!
                    nextProductStart! => previousProductStart!
                    true => productFieldChanged!
                }
            }
            firstProductField! => productRoot!.firstArgument
            -1 => productRoot!.secondArgument
            productRoot! => terms![productRootIndex!]
        }
        productRootIndex! + 1 => productRootIndex!
    }

    # Canonicalize bottom-up. A parent becomes ready after its child terms have
    # canonical ids; structurally equal trees reuse the first representative.
    0 => canonicalized!
    true => changed!
    canonicalized! < (terms! -> len) and changed!
        -> while {
            false => changed!
            0 => candidateIndex!
            candidateIndex! < (terms! -> len) -> while {
                terms![candidateIndex!] => candidate!
                candidate!.canonical < 0 -> if {
                    false => firstReady!
                    candidate!.firstArgument < 0 -> if {
                        true => firstReady!
                    } else {
                        terms![candidate!.firstArgument].canonical >= 0 => firstReady!
                    }
                    false => secondReady!
                    candidate!.secondArgument < 0 -> if {
                        true => secondReady!
                    } else {
                        terms![candidate!.secondArgument].canonical >= 0 => secondReady!
                    }
                    firstReady! and secondReady! -> if {
                        candidateIndex! => candidate!.canonical
                        0 => representativeIndex!
                        representativeIndex! < candidateIndex! and candidate!.canonical == candidateIndex!
                            -> while {
                                terms![representativeIndex!] => representative
                                representative.canonical >= 0 -> if {
                                    -1 => candidateFirst!
                                    candidate!.firstArgument >= 0 -> if { terms![candidate!.firstArgument].canonical => candidateFirst! }
                                    -1 => representativeFirst!
                                    representative.firstArgument >= 0 -> if { terms![representative.firstArgument].canonical => representativeFirst! }
                                    -1 => candidateSecond!
                                    candidate!.secondArgument >= 0 -> if { terms![candidate!.secondArgument].canonical => candidateSecond! }
                                    -1 => representativeSecond!
                                    representative.secondArgument >= 0 -> if { terms![representative.secondArgument].canonical => representativeSecond! }
                                    candidate!.kind == representative.kind and candidate!.nameId == representative.nameId and candidate!.lengthId == representative.lengthId and candidateFirst! == representativeFirst! and candidateSecond! == representativeSecond!
                                        -> if {
                                            representative.canonical => candidate!.canonical
                                        }
                                }
                                representativeIndex! + 1 => representativeIndex!
                            }
                        candidate! => terms![candidateIndex!]
                        canonicalized! + 1 => canonicalized!
                        true => changed!
                    }
                }
                candidateIndex! + 1 => candidateIndex!
            }
        }
    terms!
}

# Performs a structural substitution without recursion. Status 0 is success;
# status 1 reports an invalid index and status 2 an unresolved/cyclic arena.
public substitute request: move SubstitutionRequest -> SubstitutionResult {
    [TypeTerm; ~] => output!
    [Int; ~] => mapped!
    0 => mapIndex!
    mapIndex! < (request.terms -> len) -> while {
        mapped! -> push(-1)
        mapIndex! + 1 => mapIndex!
    }
    0 => status!
    request.root < 0 or request.root >= (request.terms -> len) or request.parameter < 0 or request.parameter >= (request.terms -> len) or request.replacement < 0 or request.replacement >= (request.terms -> len)
        -> if {
            1 => status!
        }
    0 => validationIndex!
    validationIndex! < (request.terms -> len) -> while {
        request.terms[validationIndex!] => sourceTerm
        sourceTerm.firstArgument >= (request.terms -> len)
            or sourceTerm.secondArgument >= (request.terms -> len)
            or sourceTerm.canonical >= (request.terms -> len)
            -> if { 1 => status! }
        status! != 1 and sourceTerm.canonical < 0 -> if { 2 => status! }
        validationIndex! + 1 => validationIndex!
    }
    # Freeze the original replacement before substituting the input tree.
    # A replacement containing the parameter is a value, not another request.
    -1 => replacementRoot!
    0 => pass!
    status! == 0 and pass! < 2 -> while {
        0 => resetIndex!
        resetIndex! < (mapped! -> len) -> while {
            -1 => mapped![resetIndex!]
            resetIndex! + 1 => resetIndex!
        }
        0 => completed!
        true => changed!
        completed! < (request.terms -> len) and changed!
            -> while {
                false => changed!
                0 => sourceIndex!
                sourceIndex! < (request.terms -> len) -> while {
                    mapped![sourceIndex!] < 0 -> if {
                        request.terms[sourceIndex!] => sourceTerm
                        pass! == 1 and sourceTerm.canonical == request.terms[request.parameter].canonical
                            -> if {
                                replacementRoot! => mapped![sourceIndex!]
                                completed! + 1 => completed!
                                true => changed!
                            } else {
                                false => firstReady!
                                sourceTerm.firstArgument < 0 -> if {
                                    true => firstReady!
                                } else {
                                    mapped![sourceTerm.firstArgument] >= 0 => firstReady!
                                }
                                false => secondReady!
                                sourceTerm.secondArgument < 0 -> if {
                                    true => secondReady!
                                } else {
                                    mapped![sourceTerm.secondArgument] >= 0 => secondReady!
                                }
                                firstReady! and secondReady! -> if {
                                    -1 => mappedFirst!
                                    sourceTerm.firstArgument >= 0 -> if { mapped![sourceTerm.firstArgument] => mappedFirst! }
                                    -1 => mappedSecond!
                                    sourceTerm.secondArgument >= 0 -> if { mapped![sourceTerm.secondArgument] => mappedSecond! }
                                    -1 => existing!
                                    0 => outputIndex!
                                    outputIndex! < (output! -> len) and existing! < 0
                                        -> while {
                                            output![outputIndex!] => outputTerm
                                            outputTerm.kind == sourceTerm.kind and outputTerm.nameId == sourceTerm.nameId and outputTerm.lengthId == sourceTerm.lengthId and outputTerm.firstArgument == mappedFirst! and outputTerm.secondArgument == mappedSecond!
                                                -> if {
                                                    outputIndex! => existing!
                                                }
                                            outputIndex! + 1 => outputIndex!
                                        }
                                    existing! < 0 -> if {
                                        output! -> len => existing!
                                        output! -> push(TypeTerm {
                                            astNode: sourceTerm.astNode
                                            canonical: existing!
                                            kind: sourceTerm.kind
                                            nameToken: sourceTerm.nameToken
                                            nameId: sourceTerm.nameId
                                            firstArgument: mappedFirst!
                                            secondArgument: mappedSecond!
                                            lengthToken: sourceTerm.lengthToken
                                            lengthId: sourceTerm.lengthId
                                        })
                                    }
                                    existing! => mapped![sourceIndex!]
                                    completed! + 1 => completed!
                                    true => changed!
                                }
                            }
                    }
                    sourceIndex! + 1 => sourceIndex!
                }
            }
        completed! < (request.terms -> len) -> if { 2 => status! }
        status! == 0 and pass! == 0 -> if { mapped![request.replacement] => replacementRoot! }
        pass! + 1 => pass!
    }
    -1 => resultRoot!
    status! == 0 -> if { mapped![request.root] => resultRoot! }
    SubstitutionResult { terms: output!, root: resultRoot!, status: status! } => result
    result
}
