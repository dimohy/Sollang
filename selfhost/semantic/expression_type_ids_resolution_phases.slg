                                            source -> byte(literalName.span.start + nameByte!) => leftByte
                                            source -> byte(declarationName.span.start + nameByte!) => rightByte
                                            leftByte != rightByte -> if { false => equal! }
                                            nameByte! + 1 => nameByte!
                                        }
                                    equal! -> if {
                                        sourceIndex! => literalTargetModule!
                                        localStructSearch! => literalTargetSymbol!
                                    }
                                }
                            localStructSearch! + 1 => localStructSearch!
                        }
                    literalTargetSymbol! < 0 -> if {
                        prepared.modules[sourceIndex!] => currentModuleIdentity
                        0 => siblingModuleIndex!
                        siblingModuleIndex! < (prepared.modules -> len)
                            -> while {
                                prepared.modules[siblingModuleIndex!] => siblingIdentity
                                siblingIdentity.sourceIndex != sourceIndex! and modules.sameLogicalAnalyzedSource(prepared.package.sources, prepared.modules, siblingIdentity.sourceIndex, currentModuleIdentity.sourceIndex, prepared.package.tokens, prepared.package.ranges)
                                    -> if {
                                        siblingIdentity.sourceIndex => siblingSourceModule
                                        prepared.package.ranges[siblingSourceModule] => siblingRange
                                        0 => siblingStructSearch!
                                        siblingStructSearch! < siblingRange.symbolCount and literalTargetSymbol! < 0
                                            -> while {
                                                prepared.package.symbols[siblingRange.symbolStart + siblingStructSearch!] => siblingStruct
                                                siblingStruct.kind == 3 and siblingStruct.parent < 0
                                                    -> if {
                                                        prepared.package.tokens[sourceRange.tokenStart + typeNameToken!] => literalName
                                                        prepared.package.tokens[siblingRange.tokenStart + siblingStruct.nameToken] => declarationName
                                                        literalName.span.length == declarationName.span.length => siblingEqual!
                                                        UIntSize(0) => siblingNameByte!
                                                        siblingEqual! and siblingNameByte! < literalName.span.length
                                                            -> while {
                                                                (source -> byte(literalName.span.start + siblingNameByte!)) != (prepared.package.sources[siblingSourceModule] -> byte(declarationName.span.start + siblingNameByte!))
                                                                    -> if {
                                                                        false => siblingEqual!
                                                                    }
                                                                siblingNameByte! + 1 => siblingNameByte!
                                                            }
                                                        siblingEqual! -> if {
                                                            siblingSourceModule => literalTargetModule!
                                                            siblingStructSearch! => literalTargetSymbol!
                                                        }
                                                    }
                                                siblingStructSearch! + 1 => siblingStructSearch!
                                            }
                                    }
                                siblingModuleIndex! + 1 => siblingModuleIndex!
                            }
                    }
                    literalTargetSymbol! < 0 -> if {
                        0 => qualifiedSearch!
                        qualifiedSearch! < (prepared.qualified -> len)
                            -> while {
                                prepared.qualified[qualifiedSearch!] => importedCandidate
                                importedCandidate.sourceModule == sourceIndex! and importedCandidate.status == 0
                                    -> if {
                                        prepared.package.nodes[sourceRange.astStart + importedCandidate.pathAst] => importedPath
                                        typeNameToken! >= importedPath.firstToken and typeNameToken! < importedPath.firstToken + importedPath.tokenCount
                                            -> if {
                                                prepared.modules[importedCandidate.targetModule].sourceIndex => literalTargetModule!
                                                importedCandidate.targetSymbol => literalTargetSymbol!
                                            }
                                    }
                                qualifiedSearch! + 1 => qualifiedSearch!
                            }
                    }
                    literalTargetSymbol! >= 0 -> if {
                        -1 => nominalTypeId!
                        0 => nominalTypeSearch!
                        nominalTypeSearch! < (types -> len) and nominalTypeId! < 0
                            -> while {
                                types[nominalTypeSearch!] => known
                                known.kind == 1 and (known.origin == 0 or known.origin == 2) and known.module == literalTargetModule! and known.symbol == literalTargetSymbol!
                                    -> if {
                                        nominalTypeSearch! => nominalTypeId!
                                    }
                                nominalTypeSearch! + 1 => nominalTypeSearch!
                            }
                        nominalTypeId! < 0 -> if {
                            types -> len => nominalTypeId!
                            2 => literalOrigin!
                            literalTargetModule! == sourceIndex! -> if { 0 => literalOrigin! }
                            types -> push(typeIds.SemanticType {
                                kind: 1
                                origin: literalOrigin!
                                module: literalTargetModule!
                                symbol: literalTargetSymbol!
                                first: -1
                                second: -1
                                length: -1
                                lengthHash: 0
                                containsParameter: false
                                status: 0
                            })
                        }
                        nominalTypeId! => builtinTypeId!
                    }
                }
                # Intrinsic each completes as Unit. Give the block call its own
                # result so a containing branch cannot select its array receiver
                # or callback operands as the completed statement value.
                node.kind == 48 -> if {
                    prepared -> intrinsicCollectionRoleKind(sourceIndex!, astIndex!) => collectionRoleKind
                    collectionRoleKind == 1 or collectionRoleKind == 4
                        -> if { 0 => builtinTypeId! }
                }
                builtinTypeId! >= 0 -> if {
                    builtinTypeId! -> typeIds.canonicalBuiltinSymbol => builtinTypeId!
                    expressions -> len => literalExpressionIndex
                    expressions -> push(ExpressionTypeId {
                        sourceModule: sourceIndex!
                        astNode: astIndex!
                        typeId: builtinTypeId!
                        status: 0
                    })
                    literalExpressionIndex => expressionIndexByAst[sourceRange.astStart + astIndex!]
                }
                astIndex! + 1 => astIndex!
            }

            0 => resolvedNameIndex!
            resolvedNameIndex! < (resolvedNames! -> len)
                -> while {
                    resolvedNames![resolvedNameIndex!] => resolvedName
                    prepared.package.symbols[sourceRange.symbolStart + resolvedName.symbol] => valueSymbol
                    valueSymbol.kind == 35 and valueSymbol.astNode >= 0 and prepared.package.nodes[sourceRange.astStart + valueSymbol.astNode].kind == 64
                        -> if {
                            expressionIndexByAst[sourceRange.astStart + resolvedName.astNode] => foldRoleExisting
                            ExpressionTypeId { sourceModule: sourceIndex!, astNode: resolvedName.astNode, typeId: 2, status: 0 } => foldRoleType
                            foldRoleExisting >= 0 -> if {
                                foldRoleType => expressions[foldRoleExisting]
                            } else {
                                expressions -> len => foldRoleExpression
                                expressions -> push(foldRoleType)
                                foldRoleExpression => expressionIndexByAst[sourceRange.astStart + resolvedName.astNode]
                            }
                        }
                    prepared -> primaryBlockRoleTypeId(types, references, referenceIndexByTypeAst, expressions, expressionIndexByAst, argumentBindings, sourceIndex!, valueSymbol) => roleTypeId
                    roleTypeId >= 0 -> if {
                        expressionIndexByAst[sourceRange.astStart + resolvedName.astNode] => roleExpressionIndex!
                        ExpressionTypeId { sourceModule: sourceIndex!, astNode: resolvedName.astNode, typeId: roleTypeId, status: 0 } => roleExactType
                        roleExpressionIndex! >= 0 -> if {
                            roleExactType => expressions[roleExpressionIndex!]
                        } else {
                            expressions -> len => roleExpressionIndex!
                            expressions -> push(roleExactType)
                            roleExpressionIndex! => expressionIndexByAst[sourceRange.astStart + resolvedName.astNode]
                        }
                    }
                    valueSymbol.typeNode >= 0 -> if {
                        referenceIndexByTypeAst[sourceRange.astStart + valueSymbol.typeNode] => referenceIndex
                        referenceIndex >= 0 -> if {
                            references[referenceIndex] => reference
                            expressionIndexByAst[sourceRange.astStart + resolvedName.astNode] => existingIndex
                            ExpressionTypeId {
                                sourceModule: sourceIndex!
                                astNode: resolvedName.astNode
                                typeId: reference.typeId
                                status: reference.status
                            } => exactType
                            existingIndex >= 0 -> if {
                                exactType => expressions[existingIndex]
                            } else {
                                expressions -> len => exactExpressionIndex
                                expressions -> push(exactType)
                                exactExpressionIndex => expressionIndexByAst[sourceRange.astStart + resolvedName.astNode]
                            }
                        }
                        referenceIndex < 0 -> if {
                            prepared.package.nodes[sourceRange.astStart + valueSymbol.typeNode] => unresolvedValueType
                            -1 => unresolvedValueTypeNameToken!
                            unresolvedValueType.firstToken => unresolvedValueTypeTokenIndex!
                            unresolvedValueTypeTokenIndex! < unresolvedValueType.firstToken + unresolvedValueType.tokenCount
                                -> while {
                                    prepared.package.tokens[sourceRange.tokenStart + unresolvedValueTypeTokenIndex!] => unresolvedValueTypeToken
                                    unresolvedValueTypeToken.kind == grammar.tokenIdIdentifier()
                                        -> if { unresolvedValueTypeTokenIndex! => unresolvedValueTypeNameToken! }
                                    unresolvedValueTypeTokenIndex! + 1 => unresolvedValueTypeTokenIndex!
                                }
                            unresolvedValueTypeNameToken! >= 0 -> if {
                                prepared.package.tokens[sourceRange.tokenStart + unresolvedValueTypeNameToken!] => unresolvedValueTypeName
                                TextMatchRequest { source: source, start: unresolvedValueTypeName.span.start, length: unresolvedValueTypeName.span.length, expected: "SourceText" } -> textMatches => unresolvedValueIsSourceText
                                unresolvedValueIsSourceText -> if {
                                    -1 => unresolvedValueSourceTextType!
                                    0 => unresolvedValueSourceTextSearch!
                                    unresolvedValueSourceTextSearch! < (types -> len)
                                        -> while {
                                            types[unresolvedValueSourceTextSearch!] => unresolvedValueSourceTextCandidate
                                            unresolvedValueSourceTextCandidate.kind == 1 and unresolvedValueSourceTextCandidate.origin == 1 and unresolvedValueSourceTextCandidate.symbol == 24
                                                -> if {
                                                    unresolvedValueSourceTextSearch! => unresolvedValueSourceTextType!
                                                }
                                            unresolvedValueSourceTextSearch! + 1 => unresolvedValueSourceTextSearch!
                                        }
                                    unresolvedValueSourceTextType! >= 0 -> if {
                                        expressionIndexByAst[sourceRange.astStart + resolvedName.astNode] => unresolvedValueExpressionIndex!
                                        ExpressionTypeId { sourceModule: sourceIndex!, astNode: resolvedName.astNode, typeId: unresolvedValueSourceTextType!, status: 0 } => unresolvedValueExactType
                                        unresolvedValueExpressionIndex! >= 0 -> if {
                                            unresolvedValueExactType => expressions[unresolvedValueExpressionIndex!]
                                        } else {
                                            expressions -> len => unresolvedValueExpressionIndex!
                                            expressions -> push(unresolvedValueExactType)
                                            unresolvedValueExpressionIndex! => expressionIndexByAst[sourceRange.astStart + resolvedName.astNode]
                                        }
                                    }
                                }
                            }
                        }
                    }
                    # An inferred binding has no written type node. Before composite
                    # literals are built, propagate the already-known initializer type
                    # to each resolved read. Otherwise `[left, right; ~]` observes two
                    # untyped names even when both binding initializers are canonical
                    # struct values, and no array type can be constructed.
                    valueSymbol.typeNode < 0
                        and valueSymbol.kind == 9
                        and valueSymbol.astNode >= 0
                        and prepared.package.nodes[sourceRange.astStart + valueSymbol.astNode].kind != 48
                        -> if {
                            prepared.package.tokens[sourceRange.tokenStart + valueSymbol.nameToken] => inferredBindingName
                            bindingValueAsts[sourceRange.symbolStart + resolvedName.symbol] => inferredInitializerAst
                            (inferredBindingHeads! -> len) == 0 -> if {
                                prepared.package.nodes -> each node {
                                    inferredBindingHeads! -> push(-1)
                                }
                            }
                            indexedBindingExpressions! < (expressions -> len)
                                -> while {
                                    expressions[indexedBindingExpressions!] => indexedExpression
                                    prepared.package.ranges[indexedExpression.sourceModule] => indexedRange
                                    prepared.package.nodes[indexedRange.astStart + indexedExpression.astNode].parent => indexedAncestor!
                                    1 => indexedDistance!
                                    indexedAncestor! >= 0 -> while {
                                        indexedRange.astStart + indexedAncestor! => indexedGlobalAncestor
                                        inferredBindingExpressions! -> len => indexedCandidate
                                        inferredBindingExpressions! -> push(indexedBindingExpressions!)
                                        inferredBindingDistances! -> push(indexedDistance!)
                                        inferredBindingNext! -> push(inferredBindingHeads![indexedGlobalAncestor])
                                        indexedCandidate => inferredBindingHeads![indexedGlobalAncestor]
                                        prepared.package.nodes[indexedGlobalAncestor].parent => indexedAncestor!
                                        indexedDistance! + 1 => indexedDistance!
                                    }
                                    indexedBindingExpressions! + 1 => indexedBindingExpressions!
                                }
                            -1 => inferredBindingType!
                            1_000_000 => inferredBindingDistance!
                            UIntSize(0) => inferredBindingStart!
                            -1 => inferredBindingExpression!
                            inferredBindingHeads![sourceRange.astStart + valueSymbol.astNode] => inferredBindingCandidateIndex!
                            inferredBindingCandidateIndex! >= 0
                                -> while {
                                    inferredBindingExpressions![inferredBindingCandidateIndex!] => inferredBindingExpressionIndex
                                    expressions[inferredBindingExpressionIndex] => inferredBindingCandidate
                                    inferredBindingCandidate.status == 0
                                        and inferredBindingCandidate.typeId >= 0
                                        and inferredBindingCandidate.sourceModule == sourceIndex!
                                        -> if {
                                            prepared.package.nodes[sourceRange.astStart + inferredBindingCandidate.astNode] => inferredBindingCandidateNode
                                            inferredBindingDistances![inferredBindingCandidateIndex!] => inferredBindingCandidateDistance
                                            # An initializer precedes the binding name (`value => name`).
                                            # Descendants after the name belong to a role/control
                                            # body and must not redefine the binding's inferred type.
                                            inferredBindingCandidateNode.start < inferredBindingName.span.start
                                                and inferredInitializerAst >= 0
                                                and inferredBindingCandidateNode.start == prepared.package.nodes[inferredInitializerAst].start
                                                and inferredBindingCandidateNode.length == prepared.package.nodes[inferredInitializerAst].length
                                                and (inferredBindingType! < 0
                                                or (inferredBindingCandidateDistance < inferredBindingDistance!
                                                or (inferredBindingCandidateDistance == inferredBindingDistance!
                                                and (inferredBindingCandidateNode.start > inferredBindingStart!
                                                or (inferredBindingCandidateNode.start == inferredBindingStart!
                                                and inferredBindingExpressionIndex > inferredBindingExpression!)))))
                                                -> if {
                                                    inferredBindingCandidate.typeId => inferredBindingType!
                                                    inferredBindingCandidateDistance => inferredBindingDistance!
                                                    inferredBindingCandidateNode.start => inferredBindingStart!
                                                    inferredBindingExpressionIndex => inferredBindingExpression!
                                                }
                                        }
                                    inferredBindingNext![inferredBindingCandidateIndex!] => inferredBindingCandidateIndex!
                                }
                            inferredBindingType! >= 0 -> if {
                                expressionIndexByAst[sourceRange.astStart + resolvedName.astNode] => inferredBindingExpressionIndex!
                                ExpressionTypeId { sourceModule: sourceIndex!, astNode: resolvedName.astNode, typeId: inferredBindingType!, status: 0 } => inferredBindingExactType
                                inferredBindingExpressionIndex! >= 0 -> if {
                                    inferredBindingExactType => expressions[inferredBindingExpressionIndex!]
                                } else {
                                    expressions -> len => inferredBindingExpressionIndex!
                                    expressions -> push(inferredBindingExactType)
                                    inferredBindingExpressionIndex! => expressionIndexByAst[sourceRange.astStart + resolvedName.astNode]
                                }
                            }
                        }
                    # A method's synthetic `self` symbol has no written type node.
                    # Resolve the impl owner's direct TypeAnnotation through the
                    # canonical TypeReference arena. This keeps readonly self a
                    # normal borrowed parameter for nominal and array owners alike.
                    valueSymbol.typeNode < 0 and valueSymbol.kind == 35 and valueSymbol.parent >= 0
                        -> if {
                            prepared.package.symbols[sourceRange.symbolStart + valueSymbol.parent] => selfOwner
                            selfOwner.kind == 31 and selfOwner.parent >= 0
                                -> if {
                                    prepared.package.symbols[sourceRange.symbolStart + selfOwner.parent] => selfImpl
                                    selfImpl.kind == 6 -> if {
                                        prepared.package -> typeIds.implOwnerTypeId(references, referenceIndexByTypeAst, sourceIndex!, selfImpl.astNode) => selfOwnerTypeId
                                        selfOwnerTypeId >= 0 -> if {
                                            expressionIndexByAst[sourceRange.astStart + resolvedName.astNode] => selfExpressionIndex!
                                            ExpressionTypeId { sourceModule: sourceIndex!, astNode: resolvedName.astNode, typeId: selfOwnerTypeId, status: 0 } => selfExactType
                                            selfExpressionIndex! >= 0 -> if {
                                                selfExactType => expressions[selfExpressionIndex!]
                                            } else {
                                                expressions -> len => selfExpressionIndex!
                                                expressions -> push(selfExactType)
                                                selfExpressionIndex! => expressionIndexByAst[sourceRange.astStart + resolvedName.astNode]
                                            }
                                        }
                                    }
                                }
                        }
                    resolvedNameIndex! + 1 => resolvedNameIndex!
                }
            sourceIndex! + 1 => sourceIndex!
        }

}

resolveContextualDictionaryStructValues prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~] -> Unit {
    # The declared dictionary value type owns an unqualified { field: value }
    # child. Preserve its AST identity as a nominal value before the generic
    # composite sweep can mistake its field value for a dictionary value.
    0 => sourceIndex!
    sourceIndex! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[sourceIndex!] => range
            0 => astIndex!
            astIndex! < range.astCount -> while {
                prepared.package.nodes[range.astStart + astIndex!] => candidate
                candidate.kind == 38 and candidate.parent >= 0
                    and expressionIndexByAst[range.astStart + astIndex!] < 0
                    -> if {
                        prepared.package.nodes[range.astStart + candidate.parent] => owner
                        owner.kind == 38 -> if {
                            expressionIndexByAst[range.astStart + candidate.parent] => ownerExpressionIndex
                            ownerExpressionIndex >= 0 -> if {
                                types[expressions[ownerExpressionIndex].typeId] => ownerType
                                ownerType.kind == 5 or ownerType.kind == 13 -> if {
                                    0 => entryPosition!
                                    0 => siblingIndex!
                                    siblingIndex! < astIndex! -> while {
                                        prepared.package.nodes[range.astStart + siblingIndex!] => sibling
                                        sibling.parent == candidate.parent and sibling.kind != 12
                                            -> if { entryPosition! + 1 => entryPosition! }
                                        siblingIndex! + 1 => siblingIndex!
                                    }
                                    ownerType.first => expectedTypeId!
                                    entryPosition! % 2 == 1 -> if { ownerType.second => expectedTypeId! }
                                    expectedTypeId! >= 0 -> if {
                                        types[expectedTypeId!] => expectedType
                                        expectedType.kind == 1 and (expectedType.origin == 0 or expectedType.origin == 2)
                                            -> if {
                                                expressions -> len => candidateExpressionIndex
                                                expressions -> push(ExpressionTypeId {
                                                    sourceModule: sourceIndex!
                                                    astNode: astIndex!
                                                    typeId: expectedTypeId!
                                                    status: 0
                                                })
                                                candidateExpressionIndex => expressionIndexByAst[range.astStart + astIndex!]
                                            }
                                    }
                                }
                            }
                        }
                    }
                astIndex! + 1 => astIndex!
            }
            sourceIndex! + 1 => sourceIndex!
        }
}

public nominalStructType package: ref analysis.PackageAnalysis, types: ref [typeIds.SemanticType; ~], typeId: Int -> Bool {
    typeId < 0 or typeId >= (types -> len) -> if { false -> return }
    types[typeId] => type
    type.kind != 1 or (type.origin != 0 and type.origin != 2)
        or type.module < 0 or type.module >= (package.ranges -> len)
        -> if { false -> return }
    package.ranges[type.module] => range
    type.symbol >= 0 and type.symbol < range.symbolCount
        and package.symbols[range.symbolStart + type.symbol].kind == 3
}

public contextualRecordField package: ref analysis.PackageAnalysis, fields: ref [typeIds.NominalField; ~], firstField: ref [Int; ~], nextField: ref [Int; ~], ownerType: Int, sourceModule: Int, labelAst: Int -> Int {
    package.ranges[sourceModule] => range
    package.nodes[range.astStart + labelAst] => label
    label.kind != 15 or label.cstRuleId != grammar.ruleIdNameExpression()
        or label.payloadToken < 0 or ownerType < 0 or ownerType >= (firstField -> len)
        -> if { -1 -> return }
    package.tokens[range.tokenStart + label.payloadToken] => token
    package.sources[sourceModule] -> slice(token.span.start, token.span.length) => name
    firstField[ownerType] => fieldIndex!
    fieldIndex! >= 0 -> while {
        fields[fieldIndex!] => field
        package.ranges[field.sourceModule] => fieldRange
        field.labelToken => fieldToken!
        field.fieldSymbol >= 0 -> if {
            package.symbols[fieldRange.symbolStart + field.fieldSymbol].nameToken => fieldToken!
        }
        fieldToken! >= 0 -> if {
            package.tokens[fieldRange.tokenStart + fieldToken!] => declared
            (package.sources[field.sourceModule] -> slice(declared.span.start, declared.span.length)) == name
                -> if { fieldIndex! -> return }
        }
        nextField[fieldIndex!] => fieldIndex!
    }
    -1
}

struct ContextualRecordAst { sourceModule: Int, astNode: Int }
struct ContextualRecordIndex {
    firstChild: [Int; ~]
    nextChild: [Int; ~]
    records: [ContextualRecordAst; ~]
}

indexContextualRecords package: ref analysis.PackageAnalysis -> ContextualRecordIndex {
    [Int; ~] => firstChild!
    [Int; ~] => lastChild!
    [Int; ~] => nextChild!
    [ContextualRecordAst; ~] => records!
    package.nodes -> each node {
        firstChild! -> push(-1)
        lastChild! -> push(-1)
        nextChild! -> push(-1)
    }
    package.ranges -> each range {
        0 => local!
        local! < range.astCount -> while {
            range.astStart + local! => global
            package.nodes[global] => node
            node.kind == 38 -> if {
                records! -> push(ContextualRecordAst { sourceModule: range.sourceModule, astNode: local! })
            }
            node.parent >= 0 -> if {
                range.astStart + node.parent => parent
                firstChild![parent] < 0 -> if { global => firstChild![parent] } else {
                    global => nextChild![lastChild![parent]]
                }
                global => lastChild![parent]
            }
            local! + 1 => local!
        }
    }
    ContextualRecordIndex { firstChild: firstChild!, nextChild: nextChild!, records: records! }
}

# Commit expected nominal identities in the existing type fixed point. A
# contextual record keeps its source AST; its labels never become value reads.
setContextualRecordExpressionType expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~], sourceModule: Int, astNode: Int, globalAst: Int, expectedType: Int -> Bool {
    expressionIndexByAst[globalAst] => existing
    existing < 0 -> if {
        expressions -> len => expressionIndexByAst[globalAst]
        expressions -> push(ExpressionTypeId { sourceModule: sourceModule, astNode: astNode, typeId: expectedType, status: 0 })
        true -> return
    }
    expressions[existing].typeId == expectedType and expressions[existing].status == 0
        -> if { false -> return }
    ExpressionTypeId { sourceModule: sourceModule, astNode: astNode, typeId: expectedType, status: 0 } => expressions[existing]
    true
}

# Integer context visits each operand subtree before validating its parent.
# Independent names and typed values remain leaves and retain their own types.
# Control context visits final arm values only; subjects, conditions and earlier statements remain independent.
public contextualNumericValueAsts package: ref analysis.PackageAnalysis, firstChild: ref [Int; ~], nextChild: ref [Int; ~], globalAst: Int, integerContext: Bool -> [Int; ~] {
    [Int; ~] => pending!
    [Int; ~] => values!
    pending! -> push(globalAst)
    1 => pendingCount!
    pendingCount! > 0 -> while {
        pendingCount! - 1 => pendingCount!
        pending![pendingCount!] => selected
        selected < 0 -> if { values! -> push(-selected - 1) } else {
            package.nodes[selected] => node
            [Int; ~] => results!
            integerContext -> if {
                node.kind >= 18 and node.kind <= 21 -> if {
                    firstChild[selected] => left
                    left >= 0 -> if { nextChild[left] } else { -1 } => right
                    left >= 0 and right >= 0 and nextChild[right] < 0
                        -> if {
                            results! -> push(left)
                            results! -> push(right)
                        }
                }
                node.kind == 10 or node.kind == 43 or node.kind == 58
                    -> if {
                        -1 => terminal!
                        firstChild[selected] => child!
                        child! >= 0 -> while {
                            (node.kind == 58 and package.nodes[child!].kind == 43)
                                or node.kind == 43
                                or (node.kind == 10 and package.nodes[child!].start + package.nodes[child!].length == node.start + node.length)
                                -> if { child! => terminal! }
                            nextChild[child!] => child!
                        }
                        terminal! >= 0 -> if {
                            package.nodes[terminal!] => value
                            node.kind == 10 -> if {
                                value.kind == 42 or value.kind == 56 or value.kind == 57
                                    -> if { results! -> push(terminal!) }
                            } else {
                                value.kind == 14 or value.kind == 22 or value.kind == 10 or value.kind == 43
                                    or value.kind == 56 or value.kind == 57 or (value.kind >= 18 and value.kind <= 21)
                                    -> if { results! -> push(terminal!) }
                            }
                        }
                    }
                node.kind == 42 or node.kind == 56 or node.kind == 57
                    -> if {
                        firstChild[selected] => arm!
                        arm! >= 0 -> while {
                            package.nodes[arm!].kind == 43 or package.nodes[arm!].kind == 58
                                -> if { results! -> push(arm!) }
                            nextChild[arm!] => arm!
                        }
                    }
            }
            results! -> len => resultCount!
            resultCount! > 0 -> if {
                pendingCount! < (pending! -> len) -> if { -selected - 1 => pending![pendingCount!] } else { pending! -> push(-selected - 1) }
                pendingCount! + 1 => pendingCount!
                resultCount! > 0 -> while {
                    resultCount! - 1 => resultCount!
                    results![resultCount!] => queued
                    pendingCount! < (pending! -> len) -> if { queued => pending![pendingCount!] } else { pending! -> push(queued) }
                    pendingCount! + 1 => pendingCount!
                }
            } else { values! -> push(selected) }
        }
    }
    values!
}

resolveContextualRecordFieldValue package: ref analysis.PackageAnalysis, types: ref [typeIds.SemanticType; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~], index: ref ContextualRecordIndex, sourceModule: Int, valueAst: Int, expectedType: Int, expectedContextByAst: mut [Int; ~] -> Bool {
    package.ranges[sourceModule] => range
    package.sources[sourceModule] -> len => sourceLength
    package.sources[sourceModule] -> slice(UIntSize(0), sourceLength) => source
    false => changed!
    [Int; ~] => pendingValues!
    [Int; ~] => pendingTypes!
    pendingValues! -> push(valueAst)
    pendingTypes! -> push(expectedType)
    0 => pendingIndex!
    pendingIndex! < (pendingValues! -> len) -> while {
        pendingValues![pendingIndex!] => selected
        pendingTypes![pendingIndex!] => expected
        types[expected] => target
        package.nodes[selected].kind == 37 and (target.kind == 3 or target.kind == 4 or target.kind == 12)
            -> if {
                expected => expectedContextByAst[selected]
                setContextualRecordExpressionType(expressions, expressionIndexByAst, sourceModule, selected - range.astStart, selected, expected)
                    -> if { true => changed! }
                index.firstChild[selected] => element!
                element! >= 0 -> while {
                    package.nodes[element!].kind != 12 -> if {
                        pendingValues! -> push(element!)
                        pendingTypes! -> push(target.first)
                    }
                    index.nextChild[element!] => element!
                }
            } else {
                target.symbol -> typeIds.canonicalBuiltinSymbol => symbol
                target.kind == 1 and target.origin == 1
                    and ((symbol >= 2 and symbol <= 4) or symbol == 6 or (symbol >= 8 and symbol <= 14) or symbol == 20 or symbol == 21)
                    -> if {
                        package -> contextualNumericValueAsts(index.firstChild, index.nextChild, selected, symbol != 20 and symbol != 21) => numericValues
                        numericValues -> each numericValue {
                            expected => expectedContextByAst[numericValue]
                            package.nodes[numericValue] => contextualValue
                            -1 => number!
                            contextualValue.kind == 14 -> if { numericValue => number! }
                            contextualValue.kind == 22 and contextualValue.operatorKind == grammar.tokenIdMinus()
                                -> if {
                                    index.firstChild[numericValue] => operand
                                    operand >= 0 and package.nodes[operand].kind == 14
                                        -> if { operand => number! }
                                }
                            number! >= 0 -> if {
                                expected => expectedContextByAst[number!]
                                package.nodes[number!] => literal
                                source -> numericLiteralRange.literalUsesFloatingSyntax(literal.start, literal.start + literal.length) => floating
                                not floating or symbol == 20 or symbol == 21 -> if {
                                    setContextualRecordExpressionType(expressions, expressionIndexByAst, sourceModule, numericValue - range.astStart, numericValue, expected)
                                        -> if { true => changed! }
                                    number! != numericValue -> if {
                                        setContextualRecordExpressionType(expressions, expressionIndexByAst, sourceModule, number! - range.astStart, number!, expected)
                                            -> if { true => changed! }
                                    }
                                }
                            }
                        }
                    }
            }
        pendingIndex! + 1 => pendingIndex!
    }
    changed!
}

resolveContextualRecordNumericValues package: ref analysis.PackageAnalysis, types: ref [typeIds.SemanticType; ~], fields: ref [typeIds.NominalField; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~], index: ref ContextualRecordIndex, firstField: ref [Int; ~], nextField: ref [Int; ~], sourceModule: Int, literalAst: Int, ownerType: Int, expectedContextByAst: mut [Int; ~] -> Bool {
    package.ranges[sourceModule] => range
    package.sources[sourceModule] -> len => sourceLength
    package.sources[sourceModule] -> slice(UIntSize(0), sourceLength) => source
    false => changed!
    -1 => label!
    0 => ordinal!
    index.firstChild[range.astStart + literalAst] => child!
    child! >= 0 -> while {
        package.nodes[child!] => value
        value.kind != 12 -> if {
            ordinal! % 2 == 0 -> if { child! - range.astStart => label! } else {
                package -> contextualRecordField(fields, firstField, nextField, ownerType, sourceModule, label!) => field
                field >= 0 -> if {
                    fields[field].fieldType => expected
                    package -> resolveContextualRecordFieldValue(types, expressions, expressionIndexByAst, index, sourceModule, child!, expected, expectedContextByAst)
                        -> if { true => changed! }
                }
            }
            ordinal! + 1 => ordinal!
        }
        index.nextChild[child!] => child!
    }
    changed!
}

resolveContextualRecordTypes prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], fields: ref [typeIds.NominalField; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~], flowSources: ref [Int; ~], index: ref ContextualRecordIndex, firstField: ref [Int; ~], nextField: ref [Int; ~], bindingValues: ref [Int; ~], mutableOwners: ref [Int; ~], references: [typeIds.TypeReference], expectedContextByAst: mut [Int; ~] -> Bool {
    false => changed!
    index.records -> each record {
        prepared.package.ranges[record.sourceModule] => range
        range.astStart + record.astNode => global
        prepared.package.nodes[global] => node
        -1 => expected!
        node.parent >= 0 -> if {
            range.astStart + node.parent => parentGlobal
            prepared.package.nodes[parentGlobal] => parent
            expressionIndexByAst[parentGlobal] => ownerIndex
            parent.kind == 38 and ownerIndex >= 0 -> if {
                expressions[ownerIndex].typeId => ownerTypeId
                ownerTypeId >= 0 -> if {
                    types[ownerTypeId] => ownerType
                    0 => ordinal!
                    -1 => label!
                    index.firstChild[parentGlobal] => child!
                    child! >= 0 and child! != global -> while {
                        prepared.package.nodes[child!].kind != 12 -> if {
                            ordinal! % 2 == 0 -> if { child! => label! }
                            ordinal! + 1 => ordinal!
                        }
                        index.nextChild[child!] => child!
                    }
                    ownerType.kind == 5 or ownerType.kind == 13 -> if {
                        ordinal! % 2 == 0 -> if { ownerType.first => expected! } else { ownerType.second => expected! }
                    } else {
                        ordinal! % 2 == 1 and label! >= 0
                            and (prepared.package -> nominalStructType(types, ownerTypeId))
                            -> if {
                                prepared.package -> contextualRecordField(fields, firstField, nextField, ownerTypeId, record.sourceModule, label! - range.astStart) => field
                                field >= 0 -> if { fields[field].fieldType => expected! }
                            }
                    }
                }
            }
            parent.kind == 53 and parent.payloadToken >= 0
                -> if {
                    -1 => receiverType!
                    prepared.package -> semanticContext.nearestVisibleMutableBinding(record.sourceModule, node.parent, parent.payloadToken) => binding
                    binding >= 0 -> if {
                        mutableOwners[binding] => owner
                        bindingValues[owner] >= 0 -> if {
                            expressionIndexByAst[bindingValues[owner]] => receiverIndex
                            receiverIndex >= 0 -> if { expressions[receiverIndex].typeId => receiverType! }
                        }
                    } else {
                        prepared.package.tokens[range.tokenStart + parent.payloadToken] => receiverToken
                        prepared.package.sources[record.sourceModule] -> slice(receiverToken.span.start, receiverToken.span.length) => receiverName
                        UIntSize(0) => selectedStart!
                        0 => symbolIndex!
                        symbolIndex! < range.symbolCount -> while {
                            prepared.package.symbols[range.symbolStart + symbolIndex!] => parameter
                            parameter.kind == 35 and parameter.flags / 2 % 2 == 1 and parameter.typeNode >= 0
                                and parameter.astNode >= 0 and parameter.astNode < range.astCount
                                and (prepared.package -> semanticContext.declarationAncestor(record.sourceModule, parameter.astNode, node.parent))
                                -> if {
                                    prepared.package.nodes[range.astStart + parameter.astNode] => declaration
                                    prepared.package.tokens[range.tokenStart + parameter.nameToken] => parameterToken
                                    prepared.package.sources[record.sourceModule] -> slice(parameterToken.span.start, parameterToken.span.length) => parameterName
                                    parameterName == receiverName and (receiverType! < 0 or declaration.start >= selectedStart!)
                                        -> if {
                                            references -> each reference {
                                                reference.status == 0 and reference.sourceModule == record.sourceModule and reference.typeAst == parameter.typeNode
                                                    -> if {
                                                        reference.typeId => receiverType!
                                                        declaration.start => selectedStart!
                                                    }
                                            }
                                        }
                                }
                            symbolIndex! + 1 => symbolIndex!
                        }
                    }
                    types -> typeIds.materializedReadTypeId(receiverType!) => dictionaryType
                    dictionaryType >= 0 -> if {
                        types[dictionaryType] => dictionary
                        dictionary.kind == 5 or dictionary.kind == 13
                            -> if {
                                index.firstChild[parentGlobal] => value
                                value == global -> if { dictionary.second => expected! } else {
                                    value >= 0 and index.nextChild[value] == global
                                        -> if { dictionary.first => expected! }
                                }
                            }
                    }
                }
            parent.kind == 41 -> if {
                index.firstChild[parentGlobal] => receiver
                receiver >= 0 and index.nextChild[receiver] == global
                    -> if {
                        expressionIndexByAst[receiver] => receiverIndex
                        receiverIndex >= 0 -> if {
                            types -> typeIds.materializedReadTypeId(expressions[receiverIndex].typeId) => receiverType
                            receiverType >= 0 -> if {
                                types[receiverType] => dictionary
                                dictionary.kind == 5 or dictionary.kind == 13
                                    -> if { dictionary.first => expected! }
                            }
                        }
                    }
            }
            parent.kind == 11 and parent.parent >= 0 -> if {
                range.astStart + parent.parent => flow
                prepared.package.nodes[flow].kind == 10
                    and not (prepared -> semanticContext.hasDeclaredCallTarget(flow))
                    -> if {
                        prepared.directFlowTargetPathByAst[flow] => targetAst
                        targetAst >= 0 and flowSources[flow] >= 0 -> if {
                            prepared.package.nodes[range.astStart + targetAst] => target
                            prepared.package.tokens[range.tokenStart + target.payloadToken] => token
                            prepared.package.sources[record.sourceModule] -> slice(token.span.start, token.span.length) => spelling
                            false => qualified!
                            target.firstToken => tokenIndex!
                            tokenIndex! < target.firstToken + target.tokenCount
                                -> while {
                                    prepared.package.tokens[range.tokenStart + tokenIndex!].kind == grammar.tokenIdDot()
                                        -> if { true => qualified! }
                                    tokenIndex! + 1 => tokenIndex!
                                }
                            not qualified! and (spelling == "put" or spelling == "putIfAbsent")
                                -> if {
                                    expressionIndexByAst[flowSources[flow]] => receiverIndex
                                    receiverIndex >= 0 -> if {
                                        types -> typeIds.materializedReadTypeId(expressions[receiverIndex].typeId) => receiverType
                                        receiverType >= 0 -> if {
                                            types[receiverType] => dictionary
                                            dictionary.kind == 5 or dictionary.kind == 13
                                                -> if {
                                                    index.firstChild[parentGlobal] => argument
                                                    argument == global -> if { dictionary.first => expected! } else {
                                                        argument >= 0 and index.nextChild[argument] == global
                                                            -> if { dictionary.second => expected! }
                                                    }
                                                }
                                        }
                                    }
                                }
                        }
                    }
            }
        }
        prepared.package -> nominalStructType(types, expected!)
            -> if {
                setContextualRecordExpressionType(expressions, expressionIndexByAst, record.sourceModule, record.astNode, global, expected!)
                    -> if { true => changed! }
                prepared.package -> resolveContextualRecordNumericValues(types, fields, expressions, expressionIndexByAst, index, firstField, nextField, record.sourceModule, record.astNode, expected!, expectedContextByAst)
                    -> if { true => changed! }
            }
    }
    changed!
}

# Signature constraints preserve source contracts independently of literal storage.
public inferredSignatureContractTypeId prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], expressions: ref [ExpressionTypeId; ~], expressionIndexByAst: ref [Int; ~], sourceModule: Int, expressionAst: Int -> Int {
    prepared.package.ranges[sourceModule] => range
    expressionIndexByAst[range.astStart + expressionAst] => expressionIndex
    expressionIndex < 0 -> if { -1 -> return }
    expressions[expressionIndex] => expression
    expression.status != 0 or expression.typeId < 0
        -> if { -1 -> return }
    types[expression.typeId] => actual
    actual.kind != 4 -> if { expression.typeId -> return }
    prepared.package.nodes[range.astStart + expressionAst] => node
    # The literal keeps fixed storage. Only its signature constraint is a slice.
    node.kind == 37 -> if {
        types -> internArrayLiteralType(2, actual.first, -1) -> return
    }
    # C# AddBindingType carries the initializer contract through ordinary names.
    # Follow the owning initializer, excluding role bodies after the binding name.
    0 => nameOffset!
    nameOffset! < range.nameCount -> while {
        prepared.package.names[range.nameStart + nameOffset!] => name
        name.astNode == expressionAst -> if {
            prepared.package.symbols[range.symbolStart + name.symbol] => binding
            binding.kind == 9 and binding.typeNode < 0 and binding.astNode >= 0
                -> if {
                    prepared.package.tokens[range.tokenStart + binding.nameToken] => bindingName
                    -1 => initializer!
                    1_000_000 => distance!
                    UIntSize(0) => initializerStart!
                    expressions -> each candidate {
                        candidate.sourceModule == sourceModule and candidate.status == 0 and candidate.typeId >= 0
                            -> if {
                                prepared.package.nodes[range.astStart + candidate.astNode] => candidateNode
                                candidateNode.start < bindingName.span.start -> if {
                                    candidateNode.parent => ancestor!
                                    1 => candidateDistance!
                                    ancestor! >= 0 and ancestor! != binding.astNode
                                        -> while {
                                            prepared.package.nodes[range.astStart + ancestor!].parent => ancestor!
                                            candidateDistance! + 1 => candidateDistance!
                                        }
                                    ancestor! == binding.astNode and (initializer! < 0
                                        or candidateDistance! < distance!
                                        or (candidateDistance! == distance! and candidateNode.start > initializerStart!))
                                        -> if {
                                            candidate.astNode => initializer!
                                            candidateDistance! => distance!
                                            candidateNode.start => initializerStart!
                                        }
                                }
                            }
                    }
                    initializer! >= 0 -> if {
                        inferredSignatureContractTypeId(prepared, types, expressions, expressionIndexByAst, sourceModule, initializer!) -> return
                    }
                }
        }
        nameOffset! + 1 => nameOffset!
    }
    # Calls with an explicit fixed result retain that declared source contract.
    expression.typeId
}

# One canonical array carrier/interner, shared by ordinary and interpolation literals.
internArrayLiteralType types: mut [typeIds.SemanticType; ~], kind: Int, elementTypeId: Int, length: Int -> Int {
    -1 => found!
    0 => typeIndex!
    typeIndex! < (types -> len) and found! < 0 -> while {
        types[typeIndex!] => known
        known.kind == kind and known.origin == -1 and known.module == -1 and known.symbol == -1
            and known.first == elementTypeId and known.second == -1 and known.length == length
            and known.lengthHash == 0 and known.status == 0
            -> if { typeIndex! => found! }
        typeIndex! + 1 => typeIndex!
    }
    found! < 0 -> if {
        types -> len => found!
        types -> push(typeIds.SemanticType {
            kind: kind, origin: -1, module: -1, symbol: -1, first: elementTypeId,
            second: -1, length: length, lengthHash: 0,
            containsParameter: types[elementTypeId].containsParameter, status: 0
        })
    }
    found!
}

resolveCompositeLiteralTypes prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~] -> Unit {
    # Build recursive IDs for composite literals bottom-up. This makes literal
    # arguments available to the same generic unifier as annotated names.
    true => compositeChanged!
    compositeChanged! -> while {
        false => compositeChanged!
        [Int; ~] => compositeChildDistance!
        [Int; ~] => compositeFirstChildType!
        [Int; ~] => compositeSecondChildType!
        [Int; ~] => compositeChildCount!
        [Bool; ~] => compositeHomogeneous!
        0 => compositeSeed!
        compositeSeed! < (prepared.package.nodes -> len)
            -> while {
                compositeChildDistance! -> push(1000000)
                compositeFirstChildType! -> push(-1)
                compositeSecondChildType! -> push(-1)
                compositeChildCount! -> push(0)
                compositeHomogeneous! -> push(true)
                compositeSeed! + 1 => compositeSeed!
            }
        # Canonical AST order owns element order. Literal facts are inserted
        # before resolved names, so arena append order is not source order.
        0 => childCandidateAst!
        childCandidateAst! < (prepared.package.nodes -> len)
            -> while {
                expressionIndexByAst[childCandidateAst!] => childCandidateIndex
                childCandidateIndex >= 0 -> if {
                    expressions[childCandidateIndex] => childCandidate
                    prepared.package.ranges[childCandidate.sourceModule] => childRange
                    prepared.package.nodes[childRange.astStart + childCandidate.astNode].parent => childAncestor!
                    1 => childDistance!
                    childAncestor! >= 0 -> while {
                        prepared.package.nodes[childRange.astStart + childAncestor!] => childAncestorNode
                        childRange.astStart + childAncestor! => childAncestorGlobal
                        childCandidate.typeId => childValueTypeId!
                        childAncestorNode.kind == 37 -> if {
                            types -> typeIds.materializedReadTypeId(childCandidate.typeId) => childValueTypeId!
                        }
                        (childAncestorNode.kind == 23 or childAncestorNode.kind == 37 or childAncestorNode.kind == 38) and expressionIndexByAst[childAncestorGlobal] < 0
                            -> if {
                                childDistance! < compositeChildDistance![childAncestorGlobal]
                                    -> if {
                                        childDistance! => compositeChildDistance![childAncestorGlobal]
                                        -1 => compositeFirstChildType![childAncestorGlobal]
                                        -1 => compositeSecondChildType![childAncestorGlobal]
                                        0 => compositeChildCount![childAncestorGlobal]
                                        true => compositeHomogeneous![childAncestorGlobal]
                                    }
                                childDistance! == compositeChildDistance![childAncestorGlobal]
                                    -> if {
                                        compositeChildCount![childAncestorGlobal] => childPosition
                                        childAncestorNode.kind == 38 -> if {
                                            childPosition % 2 == 0 -> if {
                                                compositeFirstChildType![childAncestorGlobal] < 0
                                                    -> if { childValueTypeId! => compositeFirstChildType![childAncestorGlobal] } else {
                                                        childValueTypeId! != compositeFirstChildType![childAncestorGlobal]
                                                            -> if { false => compositeHomogeneous![childAncestorGlobal] }
                                                    }
                                            } else {
                                                compositeSecondChildType![childAncestorGlobal] < 0
                                                    -> if { childValueTypeId! => compositeSecondChildType![childAncestorGlobal] } else {
                                                        childValueTypeId! != compositeSecondChildType![childAncestorGlobal]
                                                            -> if { false => compositeHomogeneous![childAncestorGlobal] }
                                                    }
                                            }
                                        } else {
                                            compositeFirstChildType![childAncestorGlobal] < 0
                                                -> if { childValueTypeId! => compositeFirstChildType![childAncestorGlobal] } else {
                                                    childValueTypeId! != compositeFirstChildType![childAncestorGlobal]
                                                        -> if {
                                                            false => contextualNumericArrayElement!
                                                            false => deferredGenericArrayElement!
                                                            childAncestorNode.kind == 37 -> if {
                                                                types[compositeFirstChildType![childAncestorGlobal]] => contextualArrayElementType
                                                                # Retain a generic storage owner until specialization.
                                                                # Every operand keeps its own type; concrete admission
                                                                # must still validate the specialized element contract.
                                                                contextualArrayElementType.containsParameter => deferredGenericArrayElement!
                                                                prepared.package.nodes[childRange.astStart + childCandidate.astNode] => contextualArrayElementNode
                                                                prepared.package.sources[childCandidate.sourceModule] -> slice(UIntSize(0), prepared.package.sources[childCandidate.sourceModule] -> len) => contextualArraySource
                                                                contextualArrayElementNode.kind == 14
                                                                    and contextualArrayElementType.kind == 1
                                                                    and contextualArrayElementType.origin == 1
                                                                    and ((contextualArrayElementType.symbol >= 2 and contextualArrayElementType.symbol <= 14)
                                                                    or (contextualArrayElementType.symbol >= 19 and contextualArrayElementType.symbol <= 22))
                                                                    and ((contextualArrayElementType.symbol >= 19 and contextualArrayElementType.symbol <= 22)
                                                                    or not (contextualArraySource -> numericLiteralRange.literalUsesFloatingSyntax(contextualArrayElementNode.start, contextualArrayElementNode.start + contextualArrayElementNode.length)))
                                                                    -> if {
                                                                        true => contextualNumericArrayElement!
                                                                    }
                                                            }
                                                            contextualNumericArrayElement! -> if {
                                                                expressions[childCandidateIndex] => contextualNumericCandidate!
                                                                compositeFirstChildType![childAncestorGlobal] => contextualNumericCandidate!.typeId
                                                                contextualNumericCandidate! => expressions[childCandidateIndex]
                                                            } else {
                                                                not deferredGenericArrayElement! -> if {
                                                                    false => compositeHomogeneous![childAncestorGlobal]
                                                                }
                                                            }
                                                        }
                                                }
                                        }
                                        childPosition + 1 => compositeChildCount![childAncestorGlobal]
                                    }
                            }
                        childAncestorNode.parent => childAncestor!
                        childDistance! + 1 => childDistance!
                    }
                }
                childCandidateAst! + 1 => childCandidateAst!
            }
        0 => compositeSourceIndex!
        compositeSourceIndex! < (prepared.package.sources -> len)
            -> while {
                prepared.package.ranges[compositeSourceIndex!] => compositeRange
                0 => compositeAstIndex!
                compositeAstIndex! < compositeRange.astCount
                    -> while {
                        prepared.package.nodes[compositeRange.astStart + compositeAstIndex!] => compositeNode
                        compositeRange.astStart + compositeAstIndex! => compositeGlobalAst
                        expressionIndexByAst[compositeGlobalAst] >= 0 => alreadyTyped
                        (compositeNode.kind == 23 or compositeNode.kind == 37 or compositeNode.kind == 38) and not alreadyTyped
                            -> if {
                                compositeFirstChildType![compositeGlobalAst] => firstChildType!
                                compositeSecondChildType![compositeGlobalAst] => secondChildType
                                compositeChildCount![compositeGlobalAst] => childPosition
                                compositeHomogeneous![compositeGlobalAst] => homogeneousComposite
                                false => dynamicArray!
                                false => boundedComposite!
                                -1 => boundedCompositeCapacity!
                                -1 => fixedRepeatLength!
                                compositeNode.kind == 37 -> if {
                                    prepared.package -> typeIds.arrayStorageSyntax(compositeSourceIndex!, compositeAstIndex!) => compositeStorage
                                    compositeStorage.dynamic => dynamicArray!
                                    compositeStorage.bounded => boundedComposite!
                                    compositeStorage.length => boundedCompositeCapacity!
                                    not compositeStorage.bounded -> if { compositeStorage.length => fixedRepeatLength! }
                                }
                                compositeNode.kind == 38 -> if {
                                    prepared.package -> typeIds.arrayStorageSyntax(compositeSourceIndex!, compositeAstIndex!) => compositeDictionaryStorage
                                    compositeDictionaryStorage.bounded => boundedComposite!
                                    compositeDictionaryStorage.length => boundedCompositeCapacity!
                                }
                                compositeNode.kind == 37 and compositeNode.tokenCount == 2 and childPosition == 0
                                    and firstChildType! < 0 and not dynamicArray! and not boundedComposite! => defaultEmptyArray
                                defaultEmptyArray -> if { types -> typeIds.builtinTypeId(2) => firstChildType! }
                                false => canBuildComposite!
                                -1 => compositeKind!
                                compositeNode.kind == 23 -> if {
                                    firstChildType! >= 0 -> if {
                                        6 => compositeKind!
                                        true => canBuildComposite!
                                    }
                                }
                                compositeNode.kind == 37 and dynamicArray! and firstChildType! >= 0 and homogeneousComposite
                                    -> if {
                                        3 => compositeKind!
                                        true => canBuildComposite!
                                    }
                                compositeNode.kind == 37 and boundedComposite! and firstChildType! >= 0 and homogeneousComposite
                                    -> if {
                                        12 => compositeKind!
                                        true => canBuildComposite!
                                    }
                                compositeNode.kind == 37 and not dynamicArray! and not boundedComposite! and (childPosition > 0 or defaultEmptyArray) and firstChildType! >= 0 and homogeneousComposite
                                    -> if {
                                        4 => compositeKind!
                                        true => canBuildComposite!
                                    }
                                compositeNode.kind == 38 and childPosition > 0 and childPosition % 2 == 0 and firstChildType! >= 0 and secondChildType >= 0 and homogeneousComposite
                                    -> if {
                                        boundedComposite! -> if { 13 => compositeKind! } else { 5 => compositeKind! }
                                        true => canBuildComposite!
                                    }
                                compositeNode.kind == 37 and (compositeKind! == 4 or compositeKind! == 12) and canBuildComposite!
                                    -> if {
                                        prepared.package -> typeIds.arrayStorageSyntax(compositeSourceIndex!, compositeAstIndex!) => literalStorage
                                        not literalStorage.isRepeat and not literalStorage.dynamic
                                            and (types -> typeIds.unsupportedFixedArrayLiteralElement(firstChildType!))
                                            -> if { false => canBuildComposite! }
                                    }
                                canBuildComposite! -> if {
                                    -1 => compositeLength!
                                    compositeKind! == 4 -> if {
                                        fixedRepeatLength! >= 0 -> if { fixedRepeatLength! } else { childPosition } => compositeLength!
                                    }
                                    compositeKind! == 12 or compositeKind! == 13
                                        -> if { boundedCompositeCapacity! => compositeLength! }
                                    -1 => existingType!
                                    compositeKind! == 3 or compositeKind! == 4 or compositeKind! == 12
                                        -> if { types -> internArrayLiteralType(compositeKind!, firstChildType!, compositeLength!) => existingType! }
                                    0 => typeSearch!
                                    typeSearch! < (types -> len) and existingType! < 0
                                        -> while {
                                            types[typeSearch!] => known
                                            known.kind == compositeKind! and known.origin == -1 and known.module == -1 and known.symbol == -1 and known.first == firstChildType! and known.second == secondChildType and known.length == compositeLength! and known.lengthHash == 0 and known.status == 0
                                                -> if {
                                                    typeSearch! => existingType!
                                                }
                                            typeSearch! + 1 => typeSearch!
                                        }
                                    existingType! < 0 -> if {
                                        types -> len => existingType!
                                        false => containsParameter!
                                        firstChildType! >= 0 -> if { types[firstChildType!].containsParameter => containsParameter! }
                                        false => secondContainsParameter!
                                        secondChildType >= 0 -> if { types[secondChildType].containsParameter => secondContainsParameter! }
                                        types -> push(typeIds.SemanticType {
                                            kind: compositeKind!
                                            origin: -1
                                            module: -1
                                            symbol: -1
                                            first: firstChildType!
                                            second: secondChildType
                                            length: compositeLength!
                                            lengthHash: 0
                                            containsParameter: containsParameter! or secondContainsParameter!
                                            status: 0
                                        })
                                    }
                                    expressions -> len => compositeExpressionIndex
                                    expressions -> push(ExpressionTypeId {
                                        sourceModule: compositeSourceIndex!
                                        astNode: compositeAstIndex!
                                        typeId: existingType!
                                        status: 0
                                    })
                                    compositeExpressionIndex => expressionIndexByAst[compositeGlobalAst]
                                    true => compositeChanged!
                                }
                                # Untyped dictionary literals may contain a constructor
                                # call whose concrete type is attached to a qualified
                                # child path rather than to the call node itself. The
                                # generic nearest-candidate pass can therefore miss the
                                # value side. Resolve each direct dictionary child from
                                # its nearest descendant candidate as a fallback.
                                compositeNode.kind == 38 and expressionIndexByAst[compositeGlobalAst] < 0
                                    -> if {
                                        -1 => directDictionaryFirstChild!
                                        -1 => directDictionarySecondChild!
                                        0 => directDictionaryChildSearch!
                                        directDictionaryChildSearch! < compositeRange.astCount
                                            -> while {
                                                prepared.package.nodes[compositeRange.astStart + directDictionaryChildSearch!] => directDictionaryChild
                                                directDictionaryChild.parent == compositeAstIndex!
                                                    -> if {
                                                        directDictionaryFirstChild! < 0 -> if {
                                                            directDictionaryChildSearch! => directDictionaryFirstChild!
                                                        } else {
                                                            directDictionarySecondChild! < 0 -> if { directDictionaryChildSearch! => directDictionarySecondChild! }
                                                        }
                                                    }
                                                directDictionaryChildSearch! + 1 => directDictionaryChildSearch!
                                            }
                                        -1 => directDictionaryFirstType!
                                        -1 => directDictionarySecondType!
                                        directDictionaryFirstChild! >= 0 -> if {
                                            1000000 => directDictionaryDistance!
                                            0 => directDictionaryCandidateSearch!
                                            directDictionaryCandidateSearch! < (expressions -> len)
                                                -> while {
                                                    expressions[directDictionaryCandidateSearch!] => directDictionaryCandidate
                                                    directDictionaryCandidate.sourceModule == compositeSourceIndex!
                                                        -> if {
                                                            prepared.package.nodes[compositeRange.astStart + directDictionaryCandidate.astNode].parent => directDictionaryAncestor!
                                                            1 => directDictionaryCandidateDistance!
                                                            false => directDictionaryBelongs!
                                                            directDictionaryCandidate.astNode == directDictionaryFirstChild!
                                                                -> if {
                                                                    true => directDictionaryBelongs!
                                                                    0 => directDictionaryCandidateDistance!
                                                                }
                                                            directDictionaryAncestor! >= 0 and not directDictionaryBelongs!
                                                                -> while {
                                                                    directDictionaryAncestor! == directDictionaryFirstChild!
                                                                        -> if { true => directDictionaryBelongs! } else {
                                                                            prepared.package.nodes[compositeRange.astStart + directDictionaryAncestor!].parent => directDictionaryAncestor!
                                                                            directDictionaryCandidateDistance! + 1 => directDictionaryCandidateDistance!
                                                                        }
                                                                }
                                                            directDictionaryBelongs! and directDictionaryCandidateDistance! < directDictionaryDistance!
                                                                -> if {
                                                                    directDictionaryCandidateDistance! => directDictionaryDistance!
                                                                    directDictionaryCandidate.typeId => directDictionaryFirstType!
                                                                }
                                                        }
                                                    directDictionaryCandidateSearch! + 1 => directDictionaryCandidateSearch!
                                                }
                                        }
                                        directDictionarySecondChild! >= 0 -> if {
                                            1000000 => directDictionaryDistance!
                                            0 => directDictionaryCandidateSearch!
                                            directDictionaryCandidateSearch! < (expressions -> len)
                                                -> while {
                                                    expressions[directDictionaryCandidateSearch!] => directDictionaryCandidate
                                                    directDictionaryCandidate.sourceModule == compositeSourceIndex!
                                                        -> if {
                                                            prepared.package.nodes[compositeRange.astStart + directDictionaryCandidate.astNode].parent => directDictionaryAncestor!
                                                            1 => directDictionaryCandidateDistance!
                                                            false => directDictionaryBelongs!
                                                            directDictionaryCandidate.astNode == directDictionarySecondChild!
                                                                -> if {
                                                                    true => directDictionaryBelongs!
                                                                    0 => directDictionaryCandidateDistance!
                                                                }
                                                            directDictionaryAncestor! >= 0 and not directDictionaryBelongs!
                                                                -> while {
                                                                    directDictionaryAncestor! == directDictionarySecondChild!
                                                                        -> if { true => directDictionaryBelongs! } else {
                                                                            prepared.package.nodes[compositeRange.astStart + directDictionaryAncestor!].parent => directDictionaryAncestor!
                                                                            directDictionaryCandidateDistance! + 1 => directDictionaryCandidateDistance!
                                                                        }
                                                                }
                                                            directDictionaryBelongs! and directDictionaryCandidateDistance! < directDictionaryDistance!
                                                                -> if {
                                                                    directDictionaryCandidateDistance! => directDictionaryDistance!
                                                                    directDictionaryCandidate.typeId => directDictionarySecondType!
                                                                }
                                                        }
                                                    directDictionaryCandidateSearch! + 1 => directDictionaryCandidateSearch!
                                                }
                                        }
                                        directDictionaryFirstType! >= 0 and directDictionarySecondType! >= 0
                                            -> if {
                                                boundedComposite! -> if { 13 } else { 5 } => directDictionaryKind
                                                boundedComposite! -> if { boundedCompositeCapacity! } else { -1 } => directDictionaryLength
                                                -1 => directDictionaryType!
                                                0 => directDictionaryTypeSearch!
                                                directDictionaryTypeSearch! < (types -> len) and directDictionaryType! < 0
                                                    -> while {
                                                        types[directDictionaryTypeSearch!] => directDictionaryCandidate
                                                        directDictionaryCandidate.kind == directDictionaryKind
                                                            and directDictionaryCandidate.origin == -1
                                                            and directDictionaryCandidate.module == -1
                                                            and directDictionaryCandidate.symbol == -1
                                                            and directDictionaryCandidate.first == directDictionaryFirstType!
                                                            and directDictionaryCandidate.second == directDictionarySecondType!
                                                            and directDictionaryCandidate.length == directDictionaryLength
                                                            and directDictionaryCandidate.lengthHash == 0
                                                            and directDictionaryCandidate.status == 0
                                                            -> if { directDictionaryTypeSearch! => directDictionaryType! }
                                                        directDictionaryTypeSearch! + 1 => directDictionaryTypeSearch!
                                                    }
                                                directDictionaryType! < 0 -> if {
                                                    types -> len => directDictionaryType!
                                                    types -> push(typeIds.SemanticType {
                                                        kind: directDictionaryKind
                                                        origin: -1
                                                        module: -1
                                                        symbol: -1
                                                        first: directDictionaryFirstType!
                                                        second: directDictionarySecondType!
                                                        length: directDictionaryLength
                                                        lengthHash: 0
                                                        containsParameter: types[directDictionaryFirstType!].containsParameter or types[directDictionarySecondType!].containsParameter
                                                        status: 0
                                                    })
                                                }
                                                expressions -> len => directDictionaryExpressionIndex
                                                expressions -> push(ExpressionTypeId { sourceModule: compositeSourceIndex!, astNode: compositeAstIndex!, typeId: directDictionaryType!, status: 0 })
                                                directDictionaryExpressionIndex => expressionIndexByAst[compositeGlobalAst]
                                                true => compositeChanged!
                                            }
                                    }
                            }
                        compositeAstIndex! + 1 => compositeAstIndex!
                    }
                compositeSourceIndex! + 1 => compositeSourceIndex!
            }
    }

}

resolveStructuralProductTypes prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], fields: mut [typeIds.NominalField; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~], productSources: [Int], productAsts: [Int] -> Bool {
    # Structural products preserve every field type, exact label token, and
    # declaration order. They are canonicalized against the shared field table
    # instead of being collapsed to a homogeneous array or a nominal stand-in.
    false => productChanged!
    0 => productCandidateIndex!
    productCandidateIndex! < (productAsts -> len)
        -> while {
            productSources[productCandidateIndex!] => productSourceIndex
            productAsts[productCandidateIndex!] => productAstIndex
            prepared.package.sources[productSourceIndex] -> len => productSourceLength
            prepared.package.sources[productSourceIndex] -> slice(UIntSize(0), productSourceLength) => productSource
            prepared.package.ranges[productSourceIndex] => productRange
            productRange.astStart + productAstIndex => productGlobalAst
            [Int; ~] => productFieldTypes!
            [Int; ~] => productFieldLabels!
            -1 => previousProductElement!
            UIntSize(0) => previousProductElementStart!
            true => findingProductElement!
            true => productFieldsReady!
            findingProductElement! -> while {
                false => findingProductElement!
                -1 => nextProductElement!
                UIntSize(0) => nextProductElementStart!
                0 => productElementSearch!
                productElementSearch! < productRange.astCount
                    -> while {
                        prepared.package.nodes[productRange.astStart + productElementSearch!] => productElementCandidate
                        productElementCandidate.kind == 72 and productElementCandidate.parent == productAstIndex
                            -> if {
                                previousProductElement! < 0 or productElementCandidate.start > previousProductElementStart!
                                    -> if {
                                        nextProductElement! < 0 or productElementCandidate.start < nextProductElementStart!
                                            -> if {
                                                productElementSearch! => nextProductElement!
                                                productElementCandidate.start => nextProductElementStart!
                                            }
                                    }
                            }
                        productElementSearch! + 1 => productElementSearch!
                    }
                nextProductElement! >= 0 -> if {
                    prepared.package.nodes[productRange.astStart + nextProductElement!] => productElement
                    -1 => productElementType!
                    1000000 => productElementDistance!
                    0 => productExpressionSearch!
                    productExpressionSearch! < (expressions -> len)
                        -> while {
                            expressions[productExpressionSearch!] => productExpressionCandidate
                            productExpressionCandidate.sourceModule == productSourceIndex
                                -> if {
                                    productExpressionCandidate.astNode => productExpressionAst
                                    prepared.package.nodes[productRange.astStart + productExpressionAst].parent => productExpressionAncestor!
                                    1 => productExpressionDistance!
                                    false => productExpressionBelongs!
                                    productExpressionAst == nextProductElement! -> if { true => productExpressionBelongs! }
                                    productExpressionAncestor! >= 0 and not productExpressionBelongs!
                                        -> while {
                                            productExpressionAncestor! == nextProductElement!
                                                -> if { true => productExpressionBelongs! } else {
                                                    prepared.package.nodes[productRange.astStart + productExpressionAncestor!].parent => productExpressionAncestor!
                                                    productExpressionDistance! + 1 => productExpressionDistance!
                                                }
                                        }
                                    productExpressionBelongs! and productExpressionDistance! < productElementDistance!
                                        -> if {
                                            types -> typeIds.materializedReadTypeId(productExpressionCandidate.typeId) => productElementType!
                                            productExpressionDistance! => productElementDistance!
                                        }
                                }
                            productExpressionSearch! + 1 => productExpressionSearch!
                        }
                    prepared.package.tokens -> typeTerms.productFieldLabelToken(productRange.tokenStart, productElement.firstToken, productElement.tokenCount) => productElementLabel
                    productElementType! < 0 -> if { false => productFieldsReady! }
                    productFieldTypes! -> push(productElementType!)
                    productFieldLabels! -> push(productElementLabel)
                    nextProductElement! => previousProductElement!
                    nextProductElementStart! => previousProductElementStart!
                    true => findingProductElement!
                }
            }
            (productFieldTypes! -> len) >= 2 and productFieldsReady!
                -> if {
                    -1 => productType!
                    0 => productTypeSearch!
                    productTypeSearch! < (types -> len) and productType! < 0
                        -> while {
                            types[productTypeSearch!] => productTypeCandidate
                            productTypeCandidate.kind == 10 and productTypeCandidate.length == Int(productFieldTypes! -> len) and productTypeCandidate.status == 0
                                -> if {
                                    true => productTypeEqual!
                                    0 => productFieldOrdinal!
                                    productFieldOrdinal! < Int(productFieldTypes! -> len) and productTypeEqual!
                                        -> while {
                                            -1 => productCandidateFieldIndex!
                                            0 => productCandidateFieldSearch!
                                            productCandidateFieldSearch! < (fields -> len)
                                                -> while {
                                                    fields[productCandidateFieldSearch!] => productCandidateField
                                                    productCandidateField.ownerType == productTypeSearch! and productCandidateField.ordinal == productFieldOrdinal!
                                                        -> if {
                                                            productCandidateFieldSearch! => productCandidateFieldIndex!
                                                        }
                                                    productCandidateFieldSearch! + 1 => productCandidateFieldSearch!
                                                }
                                            productCandidateFieldIndex! < 0 -> if { false => productTypeEqual! } else {
                                                fields[productCandidateFieldIndex!] => productCandidateField
                                                productCandidateField.fieldType != productFieldTypes![productFieldOrdinal!]
                                                    -> if { false => productTypeEqual! }
                                                ((productCandidateField.labelToken < 0) and not (productFieldLabels![productFieldOrdinal!] < 0)) or ((productFieldLabels![productFieldOrdinal!] < 0) and not (productCandidateField.labelToken < 0))
                                                    -> if { false => productTypeEqual! }
                                                productTypeEqual! and productCandidateField.labelToken >= 0
                                                    -> if {
                                                        prepared.package.tokens[productRange.tokenStart + productFieldLabels![productFieldOrdinal!]] => productCurrentLabel
                                                        prepared.package.ranges[productCandidateField.sourceModule] => productCandidateSourceRange
                                                        prepared.package.sources[productCandidateField.sourceModule] -> len => productCandidateSourceLength
                                                        prepared.package.sources[productCandidateField.sourceModule] -> slice(UIntSize(0), productCandidateSourceLength) => productCandidateSource
                                                        prepared.package.tokens[productCandidateSourceRange.tokenStart + productCandidateField.labelToken] => productCandidateLabel
                                                        productCurrentLabel.span.length == productCandidateLabel.span.length => productLabelEqual!
                                                        UIntSize(0) => productLabelByte!
                                                        productLabelEqual! and productLabelByte! < productCurrentLabel.span.length
                                                            -> while {
                                                                (productSource -> byte(productCurrentLabel.span.start + productLabelByte!)) != (productCandidateSource -> byte(productCandidateLabel.span.start + productLabelByte!))
                                                                    -> if { false => productLabelEqual! }
                                                                productLabelByte! + 1 => productLabelByte!
                                                            }
                                                        not productLabelEqual! -> if { false => productTypeEqual! }
                                                    }
                                            }
                                            productFieldOrdinal! + 1 => productFieldOrdinal!
                                        }
                                    productTypeEqual! -> if { productTypeSearch! => productType! }
                                }
                            productTypeSearch! + 1 => productTypeSearch!
                        }
                    productType! < 0 -> if {
                        types -> len => productType!
                        false => productContainsParameter!
                        0 => productParameterField!
                        productParameterField! < Int(productFieldTypes! -> len)
                            -> while {
                                types[productFieldTypes![productParameterField!]].containsParameter
                                    -> if { true => productContainsParameter! }
                                productParameterField! + 1 => productParameterField!
                            }
                        types -> push(typeIds.SemanticType {
                            kind: 10
                            origin: -1
                            module: -1
                            symbol: -1
                            first: -1
                            second: -1
                            length: Int(productFieldTypes! -> len)
                            lengthHash: 0
                            containsParameter: productContainsParameter!
                            status: 0
                        })
                        0 => productNewFieldOrdinal!
                        productNewFieldOrdinal! < Int(productFieldTypes! -> len)
                            -> while {
                                fields -> push(typeIds.NominalField {
                                    ownerType: productType!
                                    sourceModule: productSourceIndex
                                    ownerSymbol: -1
                                    fieldSymbol: -1
                                    labelToken: productFieldLabels![productNewFieldOrdinal!]
                                    ordinal: productNewFieldOrdinal!
                                    fieldType: productFieldTypes![productNewFieldOrdinal!]
                                    status: 0
                                })
                                productNewFieldOrdinal! + 1 => productNewFieldOrdinal!
                            }
                    }
                    expressionIndexByAst[productGlobalAst] => productExpressionIndex!
                    ExpressionTypeId {
                        sourceModule: productSourceIndex
                        astNode: productAstIndex
                        typeId: productType!
                        status: 0
                    } => productExactType
                    productExpressionIndex! < 0 -> if {
                        expressions -> len => productExpressionIndex!
                        expressions -> push(productExactType)
                        productExpressionIndex! => expressionIndexByAst[productGlobalAst]
                        true => productChanged!
                    } else {
                        expressions[productExpressionIndex!].typeId != productType!
                            -> if {
                                productExactType => expressions[productExpressionIndex!]
                                true => productChanged!
                            }
                    }
                }
            productCandidateIndex! + 1 => productCandidateIndex!
        }
    productChanged!
}

singleResultTypeParameter types: ref [typeIds.SemanticType; ~], resultType: Int -> Int {
    [Int; ~] => pending!
    pending! -> push(resultType)
    -1 => parameter!
    0 => index!
    index! < (pending! -> len) -> while {
        pending![index!] => typeIndex
        types[typeIndex] => candidate
        candidate.kind == 1 and candidate.origin == 3
            -> if {
                parameter! >= 0
                    and (types[parameter!].module != candidate.module
                    or types[parameter!].symbol != candidate.symbol)
                    -> if { -1 -> return }
                typeIndex => parameter!
            }
        candidate.first >= 0 -> if { pending! -> push(candidate.first) }
        candidate.second >= 0 -> if { pending! -> push(candidate.second) }
        index! + 1 => index!
    }
    parameter!
}

resolveNominalEnumOwnerType types: mut [typeIds.SemanticType; ~], targetSource: Int, enumSymbol: Int, sourceModule: Int -> Int {
    -1 => enumTypeId!
    0 => enumTypeSearch!
    enumTypeSearch! < (types -> len) and enumTypeId! < 0
        -> while {
            types[enumTypeSearch!] => candidate
            candidate.kind == 1 and (candidate.origin == 0 or candidate.origin == 2) and candidate.module == targetSource and candidate.symbol == enumSymbol and candidate.status == 0
                -> if { enumTypeSearch! => enumTypeId! }
            enumTypeSearch! + 1 => enumTypeSearch!
        }
    enumTypeId! < 0 -> if {
        types -> len => enumTypeId!
        2 => origin!
        targetSource == sourceModule -> if { 0 => origin! }
        types -> push(typeIds.SemanticType {
            kind: 1
            origin: origin!
            module: targetSource
            symbol: enumSymbol
            first: -1
            second: -1
            length: -1
            lengthHash: 0
            containsParameter: false
            status: 0
        })
    }
    enumTypeId!
}

resolveFlowCallTypes prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], references: ref [typeIds.TypeReference; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~], referenceIndexByTypeAst: ref [Int; ~], argumentBindings: ref [semanticContext.CallArgumentBinding; ~], seededOwners: ref [Bool; ~] -> [Int; ~] {
    [Int; ~] => firstArgumentByAst!
    prepared.package.nodes -> each nodeSlot { firstArgumentByAst! -> push(-1) }
    0 => argumentBindingIndex!
    argumentBindingIndex! < (argumentBindings -> len)
        -> while {
            argumentBindings[argumentBindingIndex!] => binding
            prepared.package.ranges[binding.sourceModule] => bindingRange
            bindingRange.astStart + binding.callAst => callGlobalAst
            firstArgumentByAst![callGlobalAst] < 0
                -> if { argumentBindingIndex! => firstArgumentByAst![callGlobalAst] }
            argumentBindingIndex! + 1 => argumentBindingIndex!
        }
    # Resolve each flow call's target token once. Generic result inference used
    # to rescan the complete source AST for every call, which became quadratic
    # for the compiler's own large modules.
    [Int; ~] => flowTargetTokenByAst!
    0 => flowTargetSlot!
    flowTargetSlot! < (prepared.package.nodes -> len)
        -> while {
            flowTargetTokenByAst! -> push(-1)
            flowTargetSlot! + 1 => flowTargetSlot!
        }
    0 => flowTargetSource!
    flowTargetSource! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[flowTargetSource!] => flowTargetRange
            0 => flowTargetNode!
            flowTargetNode! < flowTargetRange.astCount -> while {
                prepared.package.nodes[flowTargetRange.astStart + flowTargetNode!] => flowTargetCandidate
                flowTargetCandidate.parent >= 0
                    and flowTargetCandidate.parent < flowTargetRange.astCount
                    and flowTargetCandidate.kind == 16
                    and flowTargetCandidate.payloadToken >= 0 -> if {
                        flowTargetCandidate.payloadToken => flowTargetTokenByAst![flowTargetRange.astStart + flowTargetCandidate.parent]
                    }
                flowTargetNode! + 1 => flowTargetNode!
            }
            flowTargetSource! + 1 => flowTargetSource!
        }

    0 => callIndex!
    callIndex! < (prepared.calls -> len) -> while {
        prepared.calls[callIndex!] => call
        # Final admitted expression facts already occupy these AST slots.
        # Re-inserting call results would duplicate the cached owner arena and
        # make its next generation impossible to capture.
        prepared.package.ranges[call.sourceModule].astStart + call.callAst => callGlobalAst
        expressionIndexByAst[callGlobalAst] => seededExpression
        seededOwners -> seededSource(call.sourceModule)
            -> if {
                seededExpression >= 0 and expressions[seededExpression].status == 0
                    -> if {
                        callIndex! + 1 => callIndex!
                        continue
                    }
            }
        # Runtime output aliases have no declaration module, but their Unit
        # result is still a semantic value fact. Keep the source operand's
        # Text type separate from the completed call and branch result.
        call.status == 0 and call.sourceModule >= 0
            and call.sourceModule < (prepared.package.ranges -> len)
            and (call.functionSymbol == -101 or call.functionSymbol == -102
            or call.functionSymbol == -116 or call.functionSymbol == -117
            or (call.origin == 2 and call.functionSymbol == -114))
            -> if {
                prepared.package.ranges[call.sourceModule] => outputRange
                call.callAst >= 0 and call.callAst < outputRange.astCount
                    -> if {
                        types -> typeIds.builtinTypeId(0) => outputResultType
                        outputRange.astStart + call.callAst => outputGlobalAst
                        expressionIndexByAst[outputGlobalAst] => outputExpressionIndex!
                        outputExpressionIndex! < 0 -> if {
                            expressions -> len => outputExpressionIndex!
                            expressions -> push(ExpressionTypeId {
                                sourceModule: call.sourceModule
                                astNode: call.callAst
                                typeId: outputResultType
                                status: 0
                            })
                            outputExpressionIndex! => expressionIndexByAst[outputGlobalAst]
                        } else {
                            ExpressionTypeId {
                                sourceModule: call.sourceModule
                                astNode: call.callAst
                                typeId: outputResultType
                                status: 0
                            } => expressions[outputExpressionIndex!]
                        }
                    }
            }
        call.status == 0 and call.targetSourceModule >= 0
            -> if {
                prepared.package.ranges[call.targetSourceModule] => targetRange
                prepared.package.symbols[targetRange.symbolStart + call.functionSymbol] => function
                # A nominal enum variant's type annotation describes its payload.
                # The constructor value has the declaring enum's canonical type.
                function.kind == 27 and function.parent >= 0 and function.parent < targetRange.symbolCount
                    and prepared.package.symbols[targetRange.symbolStart + function.parent].kind == 4
                    -> if {
                        types -> resolveNominalEnumOwnerType(call.targetSourceModule, function.parent, call.sourceModule) => enumResultType
                        prepared.package.ranges[call.sourceModule] => enumCallRange
                        expressions -> len => enumExpressionIndex
                        expressions -> push(ExpressionTypeId {
                            sourceModule: call.sourceModule
                            astNode: call.callAst
                            typeId: enumResultType
                            status: 0
                        })
                        enumExpressionIndex => expressionIndexByAst[enumCallRange.astStart + call.callAst]
                    }
                function.typeNode => returnTypeAst!
                function.secondaryTypeNode >= 0 -> if { function.secondaryTypeNode => returnTypeAst! }
                returnTypeAst! >= 0 and function.kind != 27 -> if {
                    referenceIndexByTypeAst[targetRange.astStart + returnTypeAst!] => returnReference
                    returnReference >= 0 -> if {
                        references[returnReference] => reference
                        reference.typeId => resultTypeId!
                        reference.status => resultStatus!
                        function.flags / 32768 % 2 == 1 -> if {
                            0 => nativeTryCallResultSearch!
                            nativeTryCallResultSearch! < (types -> len)
                                -> while {
                                    types[nativeTryCallResultSearch!] => nativeTryCallResultCandidate
                                    nativeTryCallResultCandidate.kind == 7
                                        and nativeTryCallResultCandidate.origin == 4
                                        and nativeTryCallResultCandidate.symbol == 1
                                        and nativeTryCallResultCandidate.first == reference.typeId
                                        and nativeTryCallResultCandidate.second == (types -> typeIds.builtinTypeId(5))
                                        and nativeTryCallResultCandidate.status == 0
                                        -> if {
                                            nativeTryCallResultSearch! => resultTypeId!
                                        }
                                    nativeTryCallResultSearch! + 1 => nativeTryCallResultSearch!
                                }
                        }
                        types[resultTypeId!] => returnTemplateType
                        returnTemplateType.containsParameter => resultContainsParameter
                        resultContainsParameter -> if {
                            prepared.package.ranges[call.sourceModule] => callRange
                            prepared.package.nodes[callRange.astStart + call.callAst] => callNode
                            # The return type uses the same complete inference
                            # environment as the formal argument diagnostics.
                            # A secondary generic such as U cannot be inferred
                            # from only the primary T argument.
                            [Int; ~] => returnTemplates!
                            [Int; ~] => returnActuals!
                            firstArgumentByAst![callRange.astStart + call.callAst] => returnArgumentIndex!
                            false => returnArgumentsUnresolved!
                            returnArgumentIndex! >= 0 -> if {
                                seedExplicitFlowGenericArguments(prepared, types, references, referenceIndexByTypeAst, argumentBindings[returnArgumentIndex!], returnTemplates!, returnActuals!)
                            }
                            returnArgumentIndex! >= 0 and returnArgumentIndex! < (argumentBindings -> len)
                                -> while {
                                    argumentBindings[returnArgumentIndex!] => binding
                                    binding.sourceModule != call.sourceModule or binding.callAst != call.callAst
                                        -> if { break }
                                    prepared.package -> typeIds.functionParameterTypeId(references, referenceIndexByTypeAst, binding.targetSourceModule, binding.parameterSymbol) => parameterTypeId
                                    parameterTypeId >= 0 and callNode.kind == 10 and binding.parameterOrdinal > 0
                                        -> if {
                                            parameterTypeId => argumentTemplate
                                            types -> typeIds.specializeManyInto(returnTemplates!, returnActuals!, argumentTemplate) => priorSpecialization
                                            priorSpecialization.status == 0 and priorSpecialization.root >= 0
                                                and not types[priorSpecialization.root].containsParameter
                                                -> if {
                                                    contextualizeNumericCallArgumentArena(prepared, types, expressions, expressionIndexByAst, binding.sourceModule, binding.argumentAst, priorSpecialization.root) => contextual
                                                }
                                        }
                                    expressionIndexByAst[callRange.astStart + binding.argumentAst] => actualExpression
                                    parameterTypeId >= 0 and actualExpression >= 0
                                        and expressions[actualExpression].status == 0
                                        -> if {
                                            parameterTypeId => formalType
                                            expressions[actualExpression].typeId => actualType
                                            formalType >= 0 and actualType >= 0
                                                and not types[actualType].containsParameter
                                                -> if {
                                                    returnTemplates! -> push(formalType)
                                                    returnActuals! -> push(actualType)
                                                } else { true => returnArgumentsUnresolved! }
                                        } else { true => returnArgumentsUnresolved! }
                                    returnArgumentIndex! + 1 => returnArgumentIndex!
                                }
                            not returnArgumentsUnresolved! and (returnTemplates! -> len) > 0
                                -> if {
                                    types -> typeIds.specializeManyInto(returnTemplates!, returnActuals!, reference.typeId) => specialization
                                    specialization.status == 0 -> if {
                                        specialization.root => resultTypeId!
                                        0 => resultStatus!
                                    }
                                }
                            # An explicit one-parameter application such as
                            # read<UInt16>() has no value argument from which to
                            # infer T. Resolve its type child through the same
                            # canonical type-reference table used by declarations.
                            types[resultTypeId!].containsParameter
                                and callNode.cstRuleId == grammar.ruleIdTypeApplicationExpression()
                                -> if {
                                    -1 => explicitType!
                                    0 => explicitCount!
                                    0 => childAst!
                                    childAst! < callRange.astCount -> while {
                                        prepared.package.nodes[callRange.astStart + childAst!] => child
                                        child.parent == call.callAst and child.kind == 12
                                            -> if {
                                                explicitCount! + 1 => explicitCount!
                                                referenceIndexByTypeAst[callRange.astStart + childAst!] => childReference
                                                childReference >= 0 and references[childReference].status == 0
                                                    -> if { references[childReference].typeId => explicitType! }
                                            }
                                        childAst! + 1 => childAst!
                                    }
                                    explicitCount! == 1 and explicitType! >= 0
                                        and not types[explicitType!].containsParameter
                                        -> if {
                                            types -> singleResultTypeParameter(reference.typeId) => parameterType
                                            parameterType >= 0 -> if {
                                                types -> typeIds.specializeInto(parameterType, explicitType!, resultTypeId!) => explicitSpecialization
                                                explicitSpecialization.status == 0 -> if {
                                                    explicitSpecialization.root => resultTypeId!
                                                    0 => resultStatus!
                                                }
                                            }
                                        }
                                }
                            # A stream/block function can introduce a result
                            # generic only through its caller-supplied block. The
                            # primary source cannot select that parameter (for
                            # example Range -> map<R>), so specialize the remaining
                            # result from the block's final typed value.
                            types[resultTypeId!].containsParameter and function.blockTypeNode >= 0 and function.blockResultTypeNode >= 0 and callNode.kind == 48
                                -> if {
                                    referenceIndexByTypeAst[targetRange.astStart + function.blockResultTypeNode] => blockResultReference
                                    -1 => blockResultExpression!
                                    UIntSize(0) => blockResultEnd!
                                    1000000 => blockResultDistance!
                                    # Both explicit role names and default `it` infer
                                    # their return from the actual callback body.
                                    # Argument braces do not delimit that body.
                                    callNode.start + callNode.length => blockRoleStart!
                                    callNode.payloadToken + 1 => blockBodyToken!
                                    callNode.firstToken + callNode.tokenCount => blockCallEnd
                                    0 => blockArgumentDepth!
                                    false => blockBodyFound!
                                    blockBodyToken! < blockCallEnd and not blockBodyFound!
                                        -> while {
                                            prepared.package.tokens[callRange.tokenStart + blockBodyToken!] => blockBodyCandidate
                                            blockArgumentDepth! == 0 and blockBodyCandidate.kind == grammar.tokenIdLeftBrace()
                                                -> if {
                                                    blockBodyCandidate.span.start => blockRoleStart!
                                                    true => blockBodyFound!
                                                } else {
                                                    blockBodyCandidate.kind == grammar.tokenIdLeftParen() or blockBodyCandidate.kind == grammar.tokenIdLeftBracket()
                                                        -> if { blockArgumentDepth! + 1 => blockArgumentDepth! }
                                                    blockBodyCandidate.kind == grammar.tokenIdRightParen() or blockBodyCandidate.kind == grammar.tokenIdRightBracket()
                                                        -> if { blockArgumentDepth! - 1 => blockArgumentDepth! }
                                                }
                                            blockBodyToken! + 1 => blockBodyToken!
                                        }
                                    0 => blockResultSearch!
                                    blockResultSearch! < (expressions -> len) -> while {
                                        expressions[blockResultSearch!] => blockResultCandidate
                                        blockResultCandidate.status == 0 and blockResultCandidate.sourceModule == call.sourceModule
                                            -> if {
                                                prepared.package.nodes[callRange.astStart + blockResultCandidate.astNode] => blockResultNode
                                                blockResultNode.parent == call.callAst
                                                    and blockResultNode.start >= blockRoleStart! and blockResultNode.start < callNode.start + callNode.length
                                                    -> if {
                                                        blockResultNode.parent => blockResultAncestor!
                                                        1 => blockCandidateDistance!
                                                        false => blockResultBelongs!
                                                        blockResultAncestor! >= 0 and not blockResultBelongs!
                                                            -> while {
                                                                blockResultAncestor! == call.callAst -> if { true => blockResultBelongs! } else {
                                                                    prepared.package.nodes[callRange.astStart + blockResultAncestor!].parent => blockResultAncestor!
                                                                    blockCandidateDistance! + 1 => blockCandidateDistance!
                                                                }
                                                            }
                                                        blockResultNode.start + blockResultNode.length => blockCandidateEnd
                                                        blockResultBelongs! and (blockResultExpression! < 0 or blockCandidateEnd > blockResultEnd! or (blockCandidateEnd == blockResultEnd! and blockCandidateDistance! < blockResultDistance!))
                                                            -> if {
                                                                blockResultSearch! => blockResultExpression!
                                                                blockCandidateEnd => blockResultEnd!
                                                                blockCandidateDistance! => blockResultDistance!
                                                            }
                                                    }
                                            }
                                        blockResultSearch! + 1 => blockResultSearch!
                                    }
                                    blockResultReference >= 0 and blockResultExpression! >= 0
                                        -> if {
                                            types -> typeIds.specializeInto(references[blockResultReference].typeId, expressions[blockResultExpression!].typeId, resultTypeId!) => blockSpecialization
                                            blockSpecialization.status == 0 -> if {
                                                blockSpecialization.root => resultTypeId!
                                                0 => resultStatus!
                                            }
                                        }
                                }
                        }
                        prepared.package.ranges[call.sourceModule] => resultCallRange
                        expressions -> len => callExpressionIndex
                        expressions -> push(ExpressionTypeId {
                            sourceModule: call.sourceModule
                            astNode: call.callAst
                            typeId: resultTypeId!
                            status: resultStatus!
                        })
                        callExpressionIndex => expressionIndexByAst[resultCallRange.astStart + call.callAst]
                    }
                }
            }
        callIndex! + 1 => callIndex!
    }

    flowTargetTokenByAst!
}

# File scalar specializations consume their declared scalar type, rather than
# the default type of a numeric literal. Wait for receiver/pattern resolution,
# then contextualize the exact argument ASTs shared with ordinary call typing.
resolveFileScalarArgumentTypes prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], references: ref [typeIds.TypeReference; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~], referenceIndexByTypeAst: ref [Int; ~], flowTargetTokenByAst: ref [Int; ~] -> Unit {
    prepared.package -> semanticContext.indexFlowSourcesByAst => flowSources
    -1 => fileSource!
    -1 => writerSymbol!
    prepared.modules -> each identity {
        prepared.package.sources[identity.sourceIndex] -> slice(UIntSize(0), prepared.package.sources[identity.sourceIndex] -> len) => moduleSource
        TextMatchRequest { source: moduleSource, start: identity.pathStart, length: identity.pathLength, expected: "sys.file" } -> textMatches
            -> if { identity.sourceIndex => fileSource! }
    }
    fileSource! < 0 -> if { return }
    prepared.package.ranges[fileSource!] => fileRange
    prepared.package.sources[fileSource!] -> slice(UIntSize(0), prepared.package.sources[fileSource!] -> len) => fileSource
    0 => declarationIndex!
    declarationIndex! < fileRange.symbolCount -> while {
        prepared.package.symbols[fileRange.symbolStart + declarationIndex!] => declaration
        declaration.kind == 3 and declaration.parent < 0
            -> if {
                prepared.package.tokens[fileRange.tokenStart + declaration.nameToken] => name
                TextMatchRequest { source: fileSource, start: name.span.start, length: name.span.length, expected: "FileWriter" } -> textMatches
                    -> if { declarationIndex! => writerSymbol! }
            }
        declarationIndex! + 1 => declarationIndex!
    }
    writerSymbol! < 0 -> if { return }
    prepared.package.ranges -> each range {
        prepared.package.sources[range.sourceModule] -> slice(UIntSize(0), prepared.package.sources[range.sourceModule] -> len) => source
        0 => callAst!
        callAst! < range.astCount -> while {
            range.astStart + callAst! => globalCall
            prepared.package.nodes[globalCall] => call
            flowTargetTokenByAst[globalCall] => targetToken
            call.kind == 10 and targetToken >= 0 and flowSources[globalCall] >= 0
                -> if {
                    prepared.package.tokens[range.tokenStart + targetToken] => target
                    TextMatchRequest { source: source, start: target.span.start, length: target.span.length, expected: "writeAt" } -> textMatches => scalarWrite
                    TextMatchRequest { source: source, start: target.span.start, length: target.span.length, expected: "writeAtAsync" } -> textMatches => scalarWriteAsync
                    scalarWrite or scalarWriteAsync -> if {
                        expressionIndexByAst[flowSources[globalCall]] => receiverIndex
                        receiverIndex >= 0 -> if {
                            types -> typeIds.materializedReadTypeId(expressions[receiverIndex].typeId) => receiverTypeId
                            receiverTypeId >= 0 and receiverTypeId < (types -> len)
                                -> if {
                                    types[receiverTypeId] => receiver
                                    receiver.kind == 1 and (receiver.origin == 0 or receiver.origin == 2) and receiver.module == fileSource! and receiver.symbol == writerSymbol!
                                        -> if {
                                            calls.ModuleCallResolution { sourceModule: range.sourceModule, callAst: callAst!, origin: 0, targetModule: -1, targetSourceModule: -1, functionSymbol: -1, status: 0 } => intrinsic
                                            prepared.package -> semanticContext.callArgumentAsts(intrinsic, flowSources) => arguments
                                            (arguments -> len) == 3 -> if {
                                                -1 => scalarType!
                                                0 => typeAst!
                                                typeAst! < range.astCount -> while {
                                                    prepared.package.nodes[range.astStart + typeAst!] => typeNode
                                                    typeNode.kind == 12 and typeNode.parent >= 0 -> if {
                                                        prepared.package.nodes[range.astStart + typeNode.parent] => parent
                                                        typeNode.parent == callAst! or (parent.parent == callAst! and parent.start > call.start and (parent.kind == 11 or parent.kind == 77))
                                                            -> if {
                                                                referenceIndexByTypeAst[range.astStart + typeAst!] => referenceIndex
                                                                referenceIndex >= 0 and references[referenceIndex].status == 0
                                                                    -> if { references[referenceIndex].typeId => scalarType! }
                                                            }
                                                    }
                                                    typeAst! + 1 => typeAst!
                                                }
                                                scalarType! >= 0 and prepared.package.nodes[arguments[1]].kind == 14
                                                    -> if {
                                                        contextualizeNumericCallArgumentArena(prepared, types, expressions, expressionIndexByAst, range.sourceModule, arguments[1] - range.astStart, scalarType!) => scalarContextual
                                                    }
                                                prepared.package.nodes[arguments[2]].kind == 14
                                                    -> if {
                                                        contextualizeNumericCallArgumentArena(prepared, types, expressions, expressionIndexByAst, range.sourceModule, arguments[2] - range.astStart, 11) => offsetContextual
                                                    }
                                            }
                                        }
                                }
                        }
                    }
                }
            callAst! + 1 => callAst!
        }
    }
}

resolveFileMemberTypes prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~], flowTargetTokenByAst: ref [Int; ~] -> Unit {
    # Scalar positional File members are compiler-provided capabilities rather
    # than declarations in sys.file. Materialize their canonical result types
    # here so enum matching and subsequent flow calls see the same types as the
    # reference compiler. Reuse the canonical final flow target, so an outer
    # `readAt<T>(...) -> helper` keeps the helper's return type.
    0 => fileMemberSourceIndex!
    fileMemberSourceIndex! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[fileMemberSourceIndex!] => fileMemberRange
            prepared.package.sources[fileMemberSourceIndex!] -> len => fileMemberSourceLength
            prepared.package.sources[fileMemberSourceIndex!] -> slice(UIntSize(0), fileMemberSourceLength) => fileMemberSource
            0 => fileMemberAstIndex!
            fileMemberAstIndex! < fileMemberRange.astCount
                -> while {
                    prepared.package.nodes[fileMemberRange.astStart + fileMemberAstIndex!] => fileMemberNode
                    fileMemberNode.kind == 10
                        and not (prepared -> semanticContext.hasDeclaredCallTarget(fileMemberRange.astStart + fileMemberAstIndex!))
                        -> if {
                            flowTargetTokenByAst[fileMemberRange.astStart + fileMemberAstIndex!] => fileMemberTargetToken
                            -1 => fileMemberTypeToken!
                            false => fileMemberInTypeArguments!
                            fileMemberTargetToken + 1 => fileMemberTokenIndex!
                            fileMemberTargetToken >= 0 and fileMemberTokenIndex! < fileMemberNode.firstToken + fileMemberNode.tokenCount
                                -> while {
                                    prepared.package.tokens[fileMemberRange.tokenStart + fileMemberTokenIndex!] => fileMemberToken
                                    fileMemberToken.kind == grammar.tokenIdLess()
                                        -> if { true => fileMemberInTypeArguments! }
                                    fileMemberToken.kind == grammar.tokenIdGreater()
                                        -> if { false => fileMemberInTypeArguments! }
                                    fileMemberToken.kind == grammar.tokenIdLeftParen()
                                        -> if { break }
                                    fileMemberToken.kind == grammar.tokenIdIdentifier() and fileMemberInTypeArguments! and fileMemberTypeToken! < 0
                                        -> if { fileMemberTokenIndex! => fileMemberTypeToken! }
                                    fileMemberTokenIndex! + 1 => fileMemberTokenIndex!
                                }
                            false => fileMemberReadAt!
                            false => fileMemberReadAtAsync!
                            false => fileMemberWriteAt!
                            false => fileMemberWriteAtAsync!
                            fileMemberTargetToken >= 0 -> if {
                                prepared.package.tokens[fileMemberRange.tokenStart + fileMemberTargetToken] => fileMemberTarget
                                TextMatchRequest { source: fileMemberSource, start: fileMemberTarget.span.start, length: fileMemberTarget.span.length, expected: "readAt" } -> textMatches => fileMemberReadAt!
                                TextMatchRequest { source: fileMemberSource, start: fileMemberTarget.span.start, length: fileMemberTarget.span.length, expected: "readAtAsync" } -> textMatches => fileMemberReadAtAsync!
                                TextMatchRequest { source: fileMemberSource, start: fileMemberTarget.span.start, length: fileMemberTarget.span.length, expected: "writeAt" } -> textMatches => fileMemberWriteAt!
                                TextMatchRequest { source: fileMemberSource, start: fileMemberTarget.span.start, length: fileMemberTarget.span.length, expected: "writeAtAsync" } -> textMatches => fileMemberWriteAtAsync!
                            }
                            -1 => fileMemberResultType!
                            fileMemberWriteAt! or fileMemberWriteAtAsync!
                                -> if {
                                    0 => fileWriteResultSearch!
                                    fileWriteResultSearch! < (types -> len) -> while {
                                        types[fileWriteResultSearch!] => fileWriteResultCandidate
                                        fileWriteResultCandidate.kind == 7 and fileWriteResultCandidate.origin == 4 and fileWriteResultCandidate.symbol == 1 and fileWriteResultCandidate.first == 0 and fileWriteResultCandidate.second == 1 and fileWriteResultCandidate.status == 0
                                            -> if { fileWriteResultSearch! => fileMemberResultType! }
                                        fileWriteResultSearch! + 1 => fileWriteResultSearch!
                                    }
                                    fileMemberResultType! < 0 -> if {
                                        types -> len => fileMemberResultType!
                                        types -> push(typeIds.SemanticType { kind: 7, origin: 4, module: -1, symbol: 1, first: 0, second: 1, length: -1, lengthHash: 0, containsParameter: false, status: 0 })
                                    }
                                }
                            (fileMemberReadAt! or fileMemberReadAtAsync!) and fileMemberTypeToken! >= 0
                                -> if {
                                    prepared.package.tokens[fileMemberRange.tokenStart + fileMemberTypeToken!] => fileMemberTypeName
                                    -1 => fileMemberScalarType!
                                    TextMatchRequest { source: fileMemberSource, start: fileMemberTypeName.span.start, length: fileMemberTypeName.span.length, expected: "Int" } -> textMatches
                                        -> if { 2 => fileMemberScalarType! }
                                    TextMatchRequest { source: fileMemberSource, start: fileMemberTypeName.span.start, length: fileMemberTypeName.span.length, expected: "UInt8" } -> textMatches
                                        -> if { 8 => fileMemberScalarType! }
                                    TextMatchRequest { source: fileMemberSource, start: fileMemberTypeName.span.start, length: fileMemberTypeName.span.length, expected: "UInt16" } -> textMatches
                                        -> if { 9 => fileMemberScalarType! }
                                    TextMatchRequest { source: fileMemberSource, start: fileMemberTypeName.span.start, length: fileMemberTypeName.span.length, expected: "UInt32" } -> textMatches
                                        -> if { 10 => fileMemberScalarType! }
                                    TextMatchRequest { source: fileMemberSource, start: fileMemberTypeName.span.start, length: fileMemberTypeName.span.length, expected: "UInt64" } -> textMatches
                                        -> if { 11 => fileMemberScalarType! }
                                    TextMatchRequest { source: fileMemberSource, start: fileMemberTypeName.span.start, length: fileMemberTypeName.span.length, expected: "Long" } -> textMatches
                                        -> if { 7 => fileMemberScalarType! }
                                    TextMatchRequest { source: fileMemberSource, start: fileMemberTypeName.span.start, length: fileMemberTypeName.span.length, expected: "Int8" } -> textMatches
                                        -> if { 3 => fileMemberScalarType! }
                                    TextMatchRequest { source: fileMemberSource, start: fileMemberTypeName.span.start, length: fileMemberTypeName.span.length, expected: "Int16" } -> textMatches
                                        -> if { 4 => fileMemberScalarType! }
                                    TextMatchRequest { source: fileMemberSource, start: fileMemberTypeName.span.start, length: fileMemberTypeName.span.length, expected: "Int32" } -> textMatches
                                        -> if { 5 => fileMemberScalarType! }
                                    TextMatchRequest { source: fileMemberSource, start: fileMemberTypeName.span.start, length: fileMemberTypeName.span.length, expected: "Int64" } -> textMatches
                                        -> if { 6 => fileMemberScalarType! }
                                    TextMatchRequest { source: fileMemberSource, start: fileMemberTypeName.span.start, length: fileMemberTypeName.span.length, expected: "Size" } -> textMatches
                                        -> if { 12 => fileMemberScalarType! }
                                    TextMatchRequest { source: fileMemberSource, start: fileMemberTypeName.span.start, length: fileMemberTypeName.span.length, expected: "UIntSize" } -> textMatches
                                        -> if { 13 => fileMemberScalarType! }
                                    TextMatchRequest { source: fileMemberSource, start: fileMemberTypeName.span.start, length: fileMemberTypeName.span.length, expected: "CodePoint" } -> textMatches
                                        -> if { 14 => fileMemberScalarType! }
                                    TextMatchRequest { source: fileMemberSource, start: fileMemberTypeName.span.start, length: fileMemberTypeName.span.length, expected: "Float" } -> textMatches
                                        -> if { 19 => fileMemberScalarType! }
                                    TextMatchRequest { source: fileMemberSource, start: fileMemberTypeName.span.start, length: fileMemberTypeName.span.length, expected: "Float32" } -> textMatches
                                        -> if { 20 => fileMemberScalarType! }
                                    TextMatchRequest { source: fileMemberSource, start: fileMemberTypeName.span.start, length: fileMemberTypeName.span.length, expected: "Float64" } -> textMatches
                                        -> if { 21 => fileMemberScalarType! }
                                    TextMatchRequest { source: fileMemberSource, start: fileMemberTypeName.span.start, length: fileMemberTypeName.span.length, expected: "Double" } -> textMatches
                                        -> if { 22 => fileMemberScalarType! }
                                    TextMatchRequest { source: fileMemberSource, start: fileMemberTypeName.span.start, length: fileMemberTypeName.span.length, expected: "Bool" } -> textMatches
                                        -> if { 23 => fileMemberScalarType! }
                                    fileMemberScalarType! >= 0 -> if {
                                        -1 => fileMemberOptionType!
                                        0 => fileOptionSearch!
                                        fileOptionSearch! < (types -> len) -> while {
                                            types[fileOptionSearch!] => fileOptionCandidate
                                            fileOptionCandidate.kind == 7 and fileOptionCandidate.origin == 4 and fileOptionCandidate.symbol == 0 and fileOptionCandidate.first == fileMemberScalarType! and fileOptionCandidate.second < 0 and fileOptionCandidate.status == 0
                                                -> if { fileOptionSearch! => fileMemberOptionType! }
                                            fileOptionSearch! + 1 => fileOptionSearch!
                                        }
                                        fileMemberOptionType! < 0 -> if {
                                            types -> len => fileMemberOptionType!
                                            types -> push(typeIds.SemanticType { kind: 7, origin: 4, module: -1, symbol: 0, first: fileMemberScalarType!, second: -1, length: -1, lengthHash: 0, containsParameter: false, status: 0 })
                                        }
                                        0 => fileReadResultSearch!
                                        fileReadResultSearch! < (types -> len) -> while {
                                            types[fileReadResultSearch!] => fileReadResultCandidate
                                            fileReadResultCandidate.kind == 7 and fileReadResultCandidate.origin == 4 and fileReadResultCandidate.symbol == 1 and fileReadResultCandidate.first == fileMemberOptionType! and fileReadResultCandidate.second == 1 and fileReadResultCandidate.status == 0
                                                -> if { fileReadResultSearch! => fileMemberResultType! }
                                            fileReadResultSearch! + 1 => fileReadResultSearch!
                                        }
                                        fileMemberResultType! < 0 -> if {
                                            types -> len => fileMemberResultType!
                                            types -> push(typeIds.SemanticType { kind: 7, origin: 4, module: -1, symbol: 1, first: fileMemberOptionType!, second: 1, length: -1, lengthHash: 0, containsParameter: false, status: 0 })
                                        }
                                    }
                                }
                            fileMemberResultType! >= 0 -> if {
                                fileMemberRange.astStart + fileMemberAstIndex! => fileMemberGlobalAst
                                expressionIndexByAst[fileMemberGlobalAst] => fileMemberExpressionIndex!
                                fileMemberExpressionIndex! < 0 -> if {
                                    expressions -> len => fileMemberExpressionIndex!
                                    expressions -> push(ExpressionTypeId { sourceModule: fileMemberSourceIndex!, astNode: fileMemberAstIndex!, typeId: fileMemberResultType!, status: 0 })
                                    fileMemberExpressionIndex! => expressionIndexByAst[fileMemberGlobalAst]
                                } else {
                                    expressions[fileMemberExpressionIndex!] => fileMemberExpression!
                                    fileMemberResultType! => fileMemberExpression!.typeId
                                    0 => fileMemberExpression!.status
                                    fileMemberExpression! => expressions[fileMemberExpressionIndex!]
                                }
                            }
                        }
                    fileMemberAstIndex! + 1 => fileMemberAstIndex!
                }
            fileMemberSourceIndex! + 1 => fileMemberSourceIndex!
        }

}

resolveParallelRoleTypes prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~] -> Unit {
    # A result-producing parallel role returns one value per source element.
    # Its result generic is selected by the block value rather than by the
    # ordinary input argument, so specialize the canonical result to [R; ~]
    # before binding and subsequent each-role propagation.
    0 => parallelSourceIndex!
    parallelSourceIndex! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[parallelSourceIndex!] => parallelRange
            prepared.package.sources[parallelSourceIndex!] -> len => parallelSourceLength
            prepared.package.sources[parallelSourceIndex!] -> slice(UIntSize(0), parallelSourceLength) => parallelSource
            0 => parallelAstIndex!
            parallelAstIndex! < parallelRange.astCount -> while {
                prepared.package.nodes[parallelRange.astStart + parallelAstIndex!] => parallelAst
                parallelAst.kind == 48 and parallelAst.payloadToken >= 0
                    -> if {
                        prepared.package.tokens[parallelRange.tokenStart + parallelAst.payloadToken] => parallelName
                        prepared -> intrinsicCollectionRoleKind(parallelSourceIndex!, parallelAstIndex!) => collectionRoleKind
                        collectionRoleKind == 3 => intrinsicTryParallel
                        collectionRoleKind == 2 or intrinsicTryParallel
                            -> if {
                                -1 => parallelBlockExpression!
                                UIntSize(0) => parallelBlockEnd!
                                UIntSize(0) => parallelBlockLength!
                                0 => parallelExpressionSearch!
                                parallelExpressionSearch! < (expressions -> len)
                                    -> while {
                                        expressions[parallelExpressionSearch!] => parallelCandidate
                                        parallelCandidate.sourceModule == parallelSourceIndex!
                                            -> if {
                                                prepared.package.nodes[parallelRange.astStart + parallelCandidate.astNode] => parallelCandidateNode
                                                parallelCandidateNode.parent => parallelAncestor!
                                                false => parallelBelongs!
                                                parallelAncestor! >= 0 and not parallelBelongs!
                                                    -> while {
                                                        parallelAncestor! == parallelAstIndex! -> if { true => parallelBelongs! } else { prepared.package.nodes[parallelRange.astStart + parallelAncestor!].parent => parallelAncestor! }
                                                    }
                                                parallelCandidateNode.start + parallelCandidateNode.length => parallelCandidateEnd
                                                # The direct block body and a value-control owner are
                                                # transparent result regions. Their provisional types can
                                                # still be Unit before path resolution; specialize from the
                                                # concrete terminal producer inside the region instead.
                                                not ((parallelCandidateNode.parent == parallelAstIndex!
                                                    and prepared.callIndexByAst[parallelRange.astStart + parallelCandidate.astNode] < 0)
                                                    or parallelCandidateNode.kind == 42)
                                                    and parallelBelongs!
                                                    and parallelCandidate.astNode != parallelAstIndex!
                                                    and parallelCandidateNode.start >= parallelName.span.start + parallelName.span.length
                                                    and (parallelBlockExpression! < 0
                                                    or parallelCandidateEnd > parallelBlockEnd!
                                                    or (parallelCandidateEnd == parallelBlockEnd!
                                                    and parallelCandidateNode.length > parallelBlockLength!))
                                                    -> if {
                                                        parallelExpressionSearch! => parallelBlockExpression!
                                                        parallelCandidateEnd => parallelBlockEnd!
                                                        parallelCandidateNode.length => parallelBlockLength!
                                                    }
                                            }
                                        parallelExpressionSearch! + 1 => parallelExpressionSearch!
                                    }
                                parallelBlockExpression! >= 0 -> if {
                                    expressions[parallelBlockExpression!].typeId => parallelElementType!
                                    -1 => parallelErrorType!
                                    -1 => parallelResultConstructor!
                                    intrinsicTryParallel -> if {
                                        types[parallelElementType!] => parallelCallbackResult
                                        parallelCallbackResult.kind == 7 and parallelCallbackResult.first >= 0 and parallelCallbackResult.second >= 0
                                            -> if {
                                                parallelElementType! => parallelResultConstructor!
                                                parallelCallbackResult.first => parallelElementType!
                                                parallelCallbackResult.second => parallelErrorType!
                                            } else {
                                                -1 => parallelElementType!
                                            }
                                    }
                                    -1 => parallelArrayType!
                                    0 => parallelArraySearch!
                                    parallelElementType! >= 0 and parallelArraySearch! < (types -> len)
                                        -> while {
                                            types[parallelArraySearch!] => parallelArrayCandidate
                                            parallelArrayCandidate.kind == 3 and parallelArrayCandidate.first == parallelElementType! and parallelArrayCandidate.status == 0
                                                -> if { parallelArraySearch! => parallelArrayType! }
                                            parallelArraySearch! + 1 => parallelArraySearch!
                                        }
                                    parallelElementType! >= 0 and parallelArrayType! < 0
                                        -> if {
                                            types -> len => parallelArrayType!
                                            types -> push(typeIds.SemanticType {
                                                kind: 3
                                                origin: -1
                                                module: -1
                                                symbol: -1
                                                first: parallelElementType!
                                                second: -1
                                                length: -1
                                                lengthHash: 0
                                                containsParameter: false
                                                status: 0
                                            })
                                        }
                                    parallelArrayType! => parallelResultType!
                                    intrinsicTryParallel and parallelArrayType! >= 0 and parallelResultConstructor! >= 0
                                        -> if {
                                            types[parallelResultConstructor!] => parallelCallbackResult
                                            -1 => parallelWrappedResult!
                                            0 => parallelWrappedSearch!
                                            parallelWrappedSearch! < (types -> len) -> while {
                                                types[parallelWrappedSearch!] => parallelWrappedCandidate
                                                parallelWrappedCandidate.kind == 7 and parallelWrappedCandidate.origin == parallelCallbackResult.origin and parallelWrappedCandidate.module == parallelCallbackResult.module and parallelWrappedCandidate.symbol == parallelCallbackResult.symbol and parallelWrappedCandidate.first == parallelArrayType! and parallelWrappedCandidate.second == parallelErrorType! and parallelWrappedCandidate.status == 0
                                                    -> if { parallelWrappedSearch! => parallelWrappedResult! }
                                                parallelWrappedSearch! + 1 => parallelWrappedSearch!
                                            }
                                            parallelWrappedResult! < 0 -> if {
                                                types -> len => parallelWrappedResult!
                                                types -> push(typeIds.SemanticType {
                                                    kind: 7
                                                    origin: parallelCallbackResult.origin
                                                    module: parallelCallbackResult.module
                                                    symbol: parallelCallbackResult.symbol
                                                    first: parallelArrayType!
                                                    second: parallelErrorType!
                                                    length: -1
                                                    lengthHash: 0
                                                    containsParameter: false
                                                    status: 0
                                                })
                                            }
                                            parallelWrappedResult! => parallelResultType!
                                        }
                                    parallelRange.astStart + parallelAstIndex! => parallelGlobalAst
                                    expressionIndexByAst[parallelGlobalAst] => parallelExistingExpression
                                    parallelExistingExpression < 0 -> if {
                                        expressions -> len => parallelExpressionIndex
                                        expressions -> push(ExpressionTypeId { sourceModule: parallelSourceIndex!, astNode: parallelAstIndex!, typeId: parallelResultType!, status: 0 })
                                        parallelExpressionIndex => expressionIndexByAst[parallelGlobalAst]
                                    } else {
                                        expressions[parallelExistingExpression] => parallelExisting!
                                        parallelResultType! => parallelExisting!.typeId
                                        0 => parallelExisting!.status
                                        parallelExisting! => expressions[parallelExistingExpression]
                                    }
                                }
                            }
                    }
                parallelAstIndex! + 1 => parallelAstIndex!
            }
            parallelSourceIndex! + 1 => parallelSourceIndex!
        }

}

# Field labels have source-owned identity after contextual nominal inference.
# This table is shared by read diagnostics and both typed IR lowering paths.
public indexContextualRecordLabels package: ref analysis.PackageAnalysis, types: ref [typeIds.SemanticType; ~], expressions: ref [ExpressionTypeId; ~] -> [Bool; ~] {
    [Bool; ~] => labels!
    [Int; ~] => typeByAst!
    package.nodes -> each node {
        labels! -> push(false)
        typeByAst! -> push(-1)
    }
    expressions -> each expression {
        package.ranges[expression.sourceModule] => range
        expression.astNode >= 0 and expression.astNode < range.astCount
            -> if { expression.typeId => typeByAst![range.astStart + expression.astNode] }
    }
    package -> indexContextualRecords => index
    index.records -> each record {
        package.ranges[record.sourceModule] => range
        range.astStart + record.astNode => global
        package -> nominalStructType(types, typeByAst![global])
            -> if {
                0 => ordinal!
                index.firstChild[global] => child!
                child! >= 0 -> while {
                    package.nodes[child!].kind != 12 -> if {
                        ordinal! % 2 == 0 -> if { true => labels![child!] }
                        ordinal! + 1 => ordinal!
                    }
                    index.nextChild[child!] => child!
                }
            }
    }
    labels!
}
