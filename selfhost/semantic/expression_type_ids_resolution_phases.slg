                                -> if { 9 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "UInt32" } -> textMatches
                                -> if { 10 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "UInt64" } -> textMatches
                                -> if { 11 => typedArrayElementType! }
