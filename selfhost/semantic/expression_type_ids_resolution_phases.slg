namespace sollang.compiler.semantic.expression_type_ids

import sollang.compiler.ast
import sollang.compiler.lexer
import sollang.compiler.semantic.analysis
import sollang.compiler.semantic.calls
import sollang.compiler.semantic.composite_types as compositeTypes
import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.late_array_types as lateArrayTypes
import sollang.compiler.semantic.modules
import sollang.compiler.semantic.module_resolve as moduleResolve
import sollang.compiler.semantic.nominal_types as nominalTypes
import sollang.compiler.semantic.qualified
import sollang.compiler.semantic.resolve as resolution
import sollang.compiler.semantic.symbols
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.semantic.type_terms as typeTerms
import sollang.compiler.semantic.types as semanticTypes
import sollang.compiler.syntax
import syntax.generated.slg as grammar
import sys.file as file

# Ordered expression-type phases. Each phase has an explicit borrowed
# table boundary so compiler implementations can compile the functions as
# independent work units and preserve this semantic order at the call site.

resolveInitialExpressionTypes prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], references: ref [typeIds.TypeReference; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~], referenceIndexByTypeAst: ref [Int; ~], controlOwnerByAst: ref [Bool; ~], sourceTextModule: Int, sourceTextSymbol: Int -> Unit {
    0 => sourceIndex!
    sourceIndex! < (prepared.package.sources -> len)
        -> while {
            prepared.package.sources[sourceIndex!] -> len => sourceLength
            prepared.package.sources[sourceIndex!] -> slice(UIntSize(0), sourceLength) => source
            prepared.package.ranges[sourceIndex!] => sourceRange
            [resolution.ResolvedName; ~] => resolvedNames!
            0 => sourceNameOffset!
            sourceNameOffset! < sourceRange.nameCount -> while {
                resolvedNames! -> push(prepared.package.names[sourceRange.nameStart + sourceNameOffset!])
                sourceNameOffset! + 1 => sourceNameOffset!
            }

            0 => astIndex!
            astIndex! < sourceRange.astCount -> while {
                prepared.package.nodes[sourceRange.astStart + astIndex!] => node
                -1 => builtinTypeId!
                node.kind == 13 -> if { 1 => builtinTypeId! }
                node.kind == 14 -> if {
                    2 => builtinTypeId!
                    node.parent >= 0 -> if {
                        prepared.package.nodes[sourceRange.astStart + node.parent] => literalParent
                        literalParent.kind == 49 -> if {
                            mapLiteralContextType(source, prepared.package.tokens, sourceRange.tokenStart, literalParent, node) => mapLiteralType
                            mapLiteralType >= 0 -> if { mapLiteralType => builtinTypeId! }
                        }
                    }
                }
                # Comparisons and logical operators produce Bool independently
                # of operand types. Result inference must see the operation,
                # rather than accidentally selecting one of its operands.
                node.kind == 18 or node.kind == 19 or node.kind == 24 or node.kind == 25
                    -> if { 23 => builtinTypeId! }
                node.kind == 63 -> if { 25 => builtinTypeId! }
                node.kind == 64 -> if { 2 => builtinTypeId! }
                node.kind == 57 -> if { 0 => builtinTypeId! }
                node.kind >= 44 and node.kind <= 47 -> if { 0 => builtinTypeId! }
                node.kind == 53 or node.kind == 54 -> if { 0 => builtinTypeId! }
                node.kind == 49 -> if {
                    mapExpressionOpcode(source, prepared.package.tokens, sourceRange.tokenStart, node) => mapOpcode
                    mapOpcode == -306 -> if { 17 => builtinTypeId! }
                    mapOpcode == -307 -> if { 18 => builtinTypeId! }
                }
                node.kind == 55 -> if {
                    0 => constructorTypeSearch!
                    constructorTypeSearch! < sourceRange.astCount
                        -> while {
                            prepared.package.nodes[sourceRange.astStart + constructorTypeSearch!] => constructorTypeNode
                            constructorTypeNode.kind == 12 and constructorTypeNode.parent == astIndex!
                                -> if {
                                    referenceIndexByTypeAst[sourceRange.astStart + constructorTypeSearch!] => constructorReference
                                    constructorReference >= 0 -> if {
                                        references[constructorReference] => constructorTypeReference
                                        constructorTypeReference.status == 0 -> if { constructorTypeReference.typeId => builtinTypeId! }
                                    }
                                }
                            constructorTypeSearch! + 1 => constructorTypeSearch!
                        }
                }
                # A typed empty dynamic-array expression, such as
                # `[file.SourceText; ~]`, is also its type syntax. The recursive
                # type pass has already resolved that AST through TypeReference;
                # retain the ID so local owner bindings do not fall back to a
                # shallow element module/symbol projection.
                false => typedArrayTypeSyntax!
                node.kind == 37 -> if {
                    0 => typedArraySyntaxChildSearch!
                    typedArraySyntaxChildSearch! < sourceRange.astCount
                        -> while {
                            prepared.package.nodes[sourceRange.astStart + typedArraySyntaxChildSearch!] => typedArraySyntaxChild
                            (typedArraySyntaxChild.kind == 12 or typedArraySyntaxChild.kind == 16) and typedArraySyntaxChild.parent == astIndex!
                                -> if {
                                    true => typedArrayTypeSyntax!
                                }
                            typedArraySyntaxChildSearch! + 1 => typedArraySyntaxChildSearch!
                        }
                    # `~` and `<=` describe the storage shape in both type syntax
                    # and value literals. Only a direct type-path child proves
                    # this AST is type syntax; otherwise `[left, right; ~]` must
                    # remain available to bottom-up value inference below.
                }
                node.kind == 37 and typedArrayTypeSyntax! -> if {
                    0 => arrayReferenceSearch!
                    arrayReferenceSearch! < (references -> len)
                        -> while {
                            references[arrayReferenceSearch!] => arrayReference
                            arrayReference.status == 0 and arrayReference.sourceModule == sourceIndex! and (types[arrayReference.typeId].kind == 3 or types[arrayReference.typeId].kind == 12)
                                -> if {
                                    arrayReference.typeAst == astIndex! or prepared.package.nodes[sourceRange.astStart + arrayReference.typeAst].parent == astIndex!
                                        -> if {
                                            arrayReference.typeId => builtinTypeId!
                                        }
                                }
                            arrayReferenceSearch! + 1 => arrayReferenceSearch!
                        }
                    builtinTypeId! < 0 -> if {
                        -1 => typedArrayPathAst!
                        0 => typedArrayChildSearch!
                        typedArrayChildSearch! < sourceRange.astCount
                            -> while {
                                prepared.package.nodes[sourceRange.astStart + typedArrayChildSearch!] => typedArrayChild
                                (typedArrayChild.kind == 12 or typedArrayChild.kind == 16) and typedArrayPathAst! < 0
                                    -> if {
                                        typedArrayChild.parent => typedArrayPathAncestor!
                                        typedArrayPathAncestor! >= 0 and typedArrayPathAncestor! != astIndex!
                                            -> while {
                                                prepared.package.nodes[sourceRange.astStart + typedArrayPathAncestor!].parent => typedArrayPathAncestor!
                                            }
                                        typedArrayPathAncestor! == astIndex! -> if { typedArrayChildSearch! => typedArrayPathAst! }
                                    }
                                typedArrayChildSearch! + 1 => typedArrayChildSearch!
                            }
                        -1 => typedArrayElementType!
                        -1 => typedArrayNameToken!
                        false => typedArrayBounded!
                        -1 => typedArrayCapacity!
                        node.firstToken => typedArrayTokenIndex!
                        typedArrayTokenIndex! < node.firstToken + node.tokenCount
                            -> while {
                                prepared.package.tokens[sourceRange.tokenStart + typedArrayTokenIndex!] => typedArrayToken
                                typedArrayToken.kind == grammar.tokenIdLessEqual()
                                    -> if { true => typedArrayBounded! }
                                typedArrayBounded! and typedArrayCapacity! < 0 and typedArrayToken.kind == grammar.tokenIdNumber()
                                    -> if {
                                        0 => typedArrayCapacity!
                                        UIntSize(0) => typedArrayCapacityByte!
                                        typedArrayCapacityByte! < typedArrayToken.span.length
                                            -> while {
                                                source -> byte(typedArrayToken.span.start + typedArrayCapacityByte!) => typedArrayCapacityDigit
                                                typedArrayCapacity! * 10 + Int(typedArrayCapacityDigit - 48) => typedArrayCapacity!
                                                typedArrayCapacityByte! + 1 => typedArrayCapacityByte!
                                            }
                                    }
                                # The element name of a qualified type is its final
                                # identifier (`SourceText` in `file.SourceText`).
                                typedArrayToken.kind == grammar.tokenIdIdentifier()
                                    -> if { typedArrayTokenIndex! => typedArrayNameToken! }
                                typedArrayTokenIndex! + 1 => typedArrayTokenIndex!
                            }
                        typedArrayNameToken! >= 0 -> if {
                            prepared.package.tokens[sourceRange.tokenStart + typedArrayNameToken!] => typedArrayName
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "Unit" } -> textMatches
                                -> if { 0 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "Text" } -> textMatches
                                -> if { 1 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "Int" } -> textMatches
                                -> if { 2 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "UInt8" } -> textMatches
                                -> if { 8 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "UInt16" } -> textMatches
                                -> if { 9 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "UInt32" } -> textMatches
                                -> if { 10 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "UInt64" } -> textMatches
                                -> if { 11 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "Long" } -> textMatches
                                -> if { 7 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "Int8" } -> textMatches
                                -> if { 3 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "Int16" } -> textMatches
                                -> if { 4 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "Int32" } -> textMatches
                                -> if { 5 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "Int64" } -> textMatches
                                -> if { 6 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "Size" } -> textMatches
                                -> if { 12 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "UIntSize" } -> textMatches
                                -> if { 13 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "CodePoint" } -> textMatches
                                -> if { 14 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "Arena" } -> textMatches
                                -> if { 15 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "Arguments" } -> textMatches
                                -> if { 16 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "MappedBytes" } -> textMatches
                                -> if { 17 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "MutableMappedBytes" } -> textMatches
                                -> if { 18 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "Float" } -> textMatches
                                -> if { 19 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "Float32" } -> textMatches
                                -> if { 20 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "Float64" } -> textMatches
                                -> if { 21 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "Double" } -> textMatches
                                -> if { 22 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "Bool" } -> textMatches
                                -> if { 23 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "SourceText" } -> textMatches
                                -> if { 24 => typedArrayElementType! }
                        }
                        # Resolve a module-local nominal element before consulting
                        # imported qualified paths. Without this, `[LocalTask; ~]`
                        # leaves the array untyped and later member projections see
                        # the element name as a standalone nominal expression.
                        typedArrayElementType! < 0 and typedArrayNameToken! >= 0
                            -> if {
                                prepared.package.tokens[sourceRange.tokenStart + typedArrayNameToken!] => localArrayElementName
                                -1 => localArrayElementSymbol!
                                sourceIndex! => localArrayElementModule!
                                0 => localArrayElementSymbolSearch!
                                localArrayElementSymbolSearch! < sourceRange.symbolCount
                                    -> while {
                                        prepared.package.symbols[sourceRange.symbolStart + localArrayElementSymbolSearch!] => localArrayElementCandidate
                                        (localArrayElementCandidate.kind == 3 or localArrayElementCandidate.kind == 4) and localArrayElementCandidate.parent < 0
                                            -> if {
                                                prepared.package.tokens[sourceRange.tokenStart + localArrayElementCandidate.nameToken] => localArrayElementDeclarationName
                                                localArrayElementName.span.length == localArrayElementDeclarationName.span.length => localArrayElementEqual!
                                                UIntSize(0) => localArrayElementByte!
                                                localArrayElementEqual! and localArrayElementByte! < localArrayElementName.span.length
                                                    -> while {
                                                        (source -> byte(localArrayElementName.span.start + localArrayElementByte!)) != (source -> byte(localArrayElementDeclarationName.span.start + localArrayElementByte!))
                                                            -> if { false => localArrayElementEqual! }
                                                        localArrayElementByte! + 1 => localArrayElementByte!
                                                    }
                                                localArrayElementEqual! -> if { localArrayElementSymbolSearch! => localArrayElementSymbol! }
                                            }
                                        localArrayElementSymbolSearch! + 1 => localArrayElementSymbolSearch!
                                    }
                                localArrayElementSymbol! < 0 -> if {
                                    prepared.modules[sourceIndex!] => localArrayCurrentIdentity
                                    0 => localArraySiblingModuleSearch!
                                    localArraySiblingModuleSearch! < (prepared.modules -> len)
                                        -> while {
                                            prepared.modules[localArraySiblingModuleSearch!] => localArraySiblingIdentity
                                            localArraySiblingIdentity.sourceIndex != sourceIndex! and localArraySiblingIdentity.pathHash == localArrayCurrentIdentity.pathHash
                                                -> if {
                                                    localArraySiblingIdentity.sourceIndex => localArraySiblingSourceIndex
                                                    prepared.package.sources[localArraySiblingSourceIndex] -> len => localArraySiblingSourceLength
                                                    prepared.package.sources[localArraySiblingSourceIndex] -> slice(UIntSize(0), localArraySiblingSourceLength) => localArraySiblingSource
                                                    prepared.package.ranges[localArraySiblingSourceIndex] => localArraySiblingRange
                                                    0 => localArraySiblingSymbolSearch!
                                                    localArraySiblingSymbolSearch! < localArraySiblingRange.symbolCount and localArrayElementSymbol! < 0
                                                        -> while {
                                                            prepared.package.symbols[localArraySiblingRange.symbolStart + localArraySiblingSymbolSearch!] => localArraySiblingCandidate
                                                            (localArraySiblingCandidate.kind == 3 or localArraySiblingCandidate.kind == 4) and localArraySiblingCandidate.parent < 0
                                                                -> if {
                                                                    prepared.package.tokens[localArraySiblingRange.tokenStart + localArraySiblingCandidate.nameToken] => localArraySiblingName
                                                                    localArrayElementName.span.length == localArraySiblingName.span.length => localArraySiblingEqual!
                                                                    UIntSize(0) => localArraySiblingByte!
                                                                    localArraySiblingEqual! and localArraySiblingByte! < localArrayElementName.span.length
                                                                        -> while {
                                                                            (source -> byte(localArrayElementName.span.start + localArraySiblingByte!)) != (localArraySiblingSource -> byte(localArraySiblingName.span.start + localArraySiblingByte!))
                                                                                -> if {
                                                                                    false => localArraySiblingEqual!
                                                                                }
                                                                            localArraySiblingByte! + 1 => localArraySiblingByte!
                                                                        }
                                                                    localArraySiblingEqual! -> if {
                                                                        localArraySiblingSymbolSearch! => localArrayElementSymbol!
                                                                        localArraySiblingSourceIndex => localArrayElementModule!
                                                                    }
                                                                }
                                                            localArraySiblingSymbolSearch! + 1 => localArraySiblingSymbolSearch!
                                                        }
                                                }
                                            localArraySiblingModuleSearch! + 1 => localArraySiblingModuleSearch!
                                        }
                                }
                                localArrayElementSymbol! >= 0 -> if {
                                    0 => localArrayElementTypeSearch!
                                    localArrayElementTypeSearch! < (types -> len)
                                        -> while {
                                            types[localArrayElementTypeSearch!] => localArrayElementTypeCandidate
                                            localArrayElementTypeCandidate.kind == 1 and localArrayElementTypeCandidate.module == localArrayElementModule! and localArrayElementTypeCandidate.symbol == localArrayElementSymbol! and localArrayElementTypeCandidate.status == 0
                                                -> if {
                                                    localArrayElementTypeSearch! => typedArrayElementType!
                                                }
                                            localArrayElementTypeSearch! + 1 => localArrayElementTypeSearch!
                                        }
                                }
                            }
                        typedArrayElementType! < 0 -> if {
                            -1 => typedArrayQualifiedIndex!
                            0 => typedArrayQualifiedSearch!
                            typedArrayQualifiedSearch! < (prepared.qualified -> len)
                                -> while {
                                    prepared.qualified[typedArrayQualifiedSearch!] => typedArrayQualifiedCandidate
                                    typedArrayQualifiedCandidate.sourceModule == sourceIndex! and typedArrayQualifiedCandidate.pathAst == typedArrayPathAst! and typedArrayQualifiedCandidate.status == 0
                                        -> if { typedArrayQualifiedSearch! => typedArrayQualifiedIndex! }
                                    typedArrayQualifiedSearch! + 1 => typedArrayQualifiedSearch!
                                }
                            typedArrayQualifiedIndex! >= 0 -> if {
                                prepared.qualified[typedArrayQualifiedIndex!] => typedArrayQualified
                                0 => typedArrayElementSearch!
                                typedArrayElementSearch! < (types -> len) -> while {
                                    types[typedArrayElementSearch!] => typedArrayElementCandidate
                                    typedArrayElementCandidate.kind == 1 and typedArrayQualified.targetModule == sourceTextModule and typedArrayQualified.targetSymbol == sourceTextSymbol and typedArrayElementCandidate.origin == 1 and typedArrayElementCandidate.symbol == 24
                                        -> if { typedArrayElementSearch! => typedArrayElementType! }
                                    typedArrayElementCandidate.kind == 1 and typedArrayElementCandidate.module == typedArrayQualified.targetModule and typedArrayElementCandidate.symbol == typedArrayQualified.targetSymbol
                                        -> if { typedArrayElementSearch! => typedArrayElementType! }
                                    typedArrayElementSearch! + 1 => typedArrayElementSearch!
                                }
                            }
                        }
                        typedArrayElementType! >= 0 -> if {
                            3 => typedArrayKind!
                            -1 => typedArrayLength!
                            typedArrayBounded! -> if {
                                12 => typedArrayKind!
                                typedArrayCapacity! => typedArrayLength!
                            }
                            -1 => typedArrayType!
                            0 => typedArrayTypeSearch!
                            typedArrayTypeSearch! < (types -> len) -> while {
                                types[typedArrayTypeSearch!] => typedArrayCandidate
                                typedArrayCandidate.kind == typedArrayKind! and typedArrayCandidate.first == typedArrayElementType! and typedArrayCandidate.length == typedArrayLength! and typedArrayCandidate.status == 0
                                    -> if { typedArrayTypeSearch! => typedArrayType! }
                                typedArrayTypeSearch! + 1 => typedArrayTypeSearch!
                            }
                            typedArrayType! < 0 -> if {
                                types -> len => typedArrayType!
                                types -> push(typeIds.SemanticType {
                                    kind: typedArrayKind!
                                    origin: -1
                                    module: -1
                                    symbol: -1
                                    first: typedArrayElementType!
                                    second: -1
                                    length: typedArrayLength!
                                    lengthHash: 0
                                    containsParameter: types[typedArrayElementType!].containsParameter
                                    status: 0
                                })
                            }
                            typedArrayType! => builtinTypeId!
                        }
                    }
                }
                node.kind == 15 -> if {
                    prepared.package.tokens[sourceRange.tokenStart + node.payloadToken] => name
                    name.span.length == 4 -> if {
                        source -> byte(name.span.start) => byte0
                        source -> byte(name.span.start + 1) => byte1
                        source -> byte(name.span.start + 2) => byte2
                        source -> byte(name.span.start + 3) => byte3
                        byte0 == 116 and byte1 == 114 and byte2 == 117 and byte3 == 101
                            -> if { 23 => builtinTypeId! }
                    }
                    name.span.length == 5 -> if {
                        source -> byte(name.span.start) => byte0
                        source -> byte(name.span.start + 1) => byte1
                        source -> byte(name.span.start + 2) => byte2
                        source -> byte(name.span.start + 3) => byte3
                        source -> byte(name.span.start + 4) => byte4
                        byte0 == 102 and byte1 == 97 and byte2 == 108 and byte3 == 115 and byte4 == 101
                            -> if { 23 => builtinTypeId! }
                    }
                }
                # A typed dictionary literal carries two TypeAnnotation children
                # before its runtime entries. Resolve those annotations directly
                # instead of letting the generic nearest-expression pass mistake
                # the qualified key path for the dictionary value itself.
                node.kind == 38 -> if {
                    -1 => typedDictionaryKeyType!
                    -1 => typedDictionaryValueType!
                    false => typedDictionaryBounded!
                    -1 => typedDictionaryCapacity!
                    node.firstToken => typedDictionaryTokenSearch!
                    typedDictionaryTokenSearch! < node.firstToken + node.tokenCount
                        -> while {
                            prepared.package.tokens[sourceRange.tokenStart + typedDictionaryTokenSearch!].kind == grammar.tokenIdLessEqual()
                                -> if {
                                    true => typedDictionaryBounded!
                                }
                            typedDictionaryBounded! and typedDictionaryCapacity! < 0 and prepared.package.tokens[sourceRange.tokenStart + typedDictionaryTokenSearch!].kind == grammar.tokenIdNumber()
                                -> if {
                                    prepared.package.tokens[sourceRange.tokenStart + typedDictionaryTokenSearch!] => typedDictionaryCapacityToken
                                    0 => typedDictionaryCapacity!
                                    UIntSize(0) => typedDictionaryCapacityByte!
                                    typedDictionaryCapacityByte! < typedDictionaryCapacityToken.span.length
                                        -> while {
                                            source -> byte(typedDictionaryCapacityToken.span.start + typedDictionaryCapacityByte!) => typedDictionaryCapacityDigit
                                            typedDictionaryCapacity! * 10 + Int(typedDictionaryCapacityDigit - 48) => typedDictionaryCapacity!
                                            typedDictionaryCapacityByte! + 1 => typedDictionaryCapacityByte!
                                        }
                                }
                            typedDictionaryTokenSearch! + 1 => typedDictionaryTokenSearch!
                        }
                    0 => typedDictionaryChildSearch!
                    typedDictionaryChildSearch! < sourceRange.astCount
                        -> while {
                            prepared.package.nodes[sourceRange.astStart + typedDictionaryChildSearch!] => typedDictionaryChild
                            typedDictionaryChild.kind == 12 and typedDictionaryChild.parent == astIndex!
                                -> if {
                                    referenceIndexByTypeAst[sourceRange.astStart + typedDictionaryChildSearch!] => typedDictionaryReferenceIndex
                                    typedDictionaryReferenceIndex >= 0 -> if {
                                        references[typedDictionaryReferenceIndex] => typedDictionaryReference
                                        typedDictionaryReference.status == 0 -> if {
                                            typedDictionaryKeyType! < 0 -> if {
                                                typedDictionaryReference.typeId => typedDictionaryKeyType!
                                            } else {
                                                typedDictionaryValueType! < 0 -> if { typedDictionaryReference.typeId => typedDictionaryValueType! }
                                            }
                                        }
                                    }
                                }
                            typedDictionaryChildSearch! + 1 => typedDictionaryChildSearch!
                        }
                    typedDictionaryKeyType! >= 0 and typedDictionaryValueType! >= 0
                        -> if {
                            5 => typedDictionaryKind!
                            -1 => typedDictionaryLength!
                            typedDictionaryBounded! -> if {
                                13 => typedDictionaryKind!
                                typedDictionaryCapacity! => typedDictionaryLength!
                            }
                            -1 => typedDictionaryType!
                            0 => typedDictionaryTypeSearch!
                            typedDictionaryTypeSearch! < (types -> len)
                                -> while {
                                    types[typedDictionaryTypeSearch!] => typedDictionaryCandidate
                                    typedDictionaryCandidate.kind == typedDictionaryKind! and typedDictionaryCandidate.first == typedDictionaryKeyType! and typedDictionaryCandidate.second == typedDictionaryValueType! and typedDictionaryCandidate.length == typedDictionaryLength! and typedDictionaryCandidate.status == 0
                                        -> if {
                                            typedDictionaryTypeSearch! => typedDictionaryType!
                                        }
                                    typedDictionaryTypeSearch! + 1 => typedDictionaryTypeSearch!
                                }
                            typedDictionaryType! < 0 -> if {
                                types -> len => typedDictionaryType!
                                types -> push(typeIds.SemanticType {
                                    kind: typedDictionaryKind!
                                    origin: -1
                                    module: -1
                                    symbol: -1
                                    first: typedDictionaryKeyType!
                                    second: typedDictionaryValueType!
                                    length: typedDictionaryLength!
                                    lengthHash: 0
                                    containsParameter: types[typedDictionaryKeyType!].containsParameter or types[typedDictionaryValueType!].containsParameter
                                    status: 0
                                })
                            }
                            typedDictionaryType! => builtinTypeId!
                        }
                }
                node.kind == 10 -> if {
                    node.firstToken => flowTokenIndex!
                    flowTokenIndex! < node.firstToken + node.tokenCount
                        -> while {
                            prepared.package.tokens[sourceRange.tokenStart + flowTokenIndex!] => flowToken
                            flowToken.kind == grammar.tokenIdIdentifier()
                                -> if {
                                    flowToken.span.length == 3 -> if {
                                        source -> byte(flowToken.span.start) => flowByte0
                                        source -> byte(flowToken.span.start + 1) => flowByte1
                                        source -> byte(flowToken.span.start + 2) => flowByte2
                                        flowByte0 == 108 and flowByte1 == 101 and flowByte2 == 110
                                            -> if { 13 => builtinTypeId! }
                                    }
                                    flowToken.span.length == 4 -> if {
                                        source -> byte(flowToken.span.start) => flowByte0
                                        source -> byte(flowToken.span.start + 1) => flowByte1
                                        source -> byte(flowToken.span.start + 2) => flowByte2
                                        source -> byte(flowToken.span.start + 3) => flowByte3
                                        flowByte0 == 98 and flowByte1 == 121 and flowByte2 == 116 and flowByte3 == 101
                                            -> if { 8 => builtinTypeId! }
                                    }
                                    flowToken.span.length == 5 -> if {
                                        source -> byte(flowToken.span.start) => flowByte0
                                        source -> byte(flowToken.span.start + 1) => flowByte1
                                        source -> byte(flowToken.span.start + 2) => flowByte2
                                        source -> byte(flowToken.span.start + 3) => flowByte3
                                        source -> byte(flowToken.span.start + 4) => flowByte4
