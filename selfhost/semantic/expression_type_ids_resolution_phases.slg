                                                localArrayElementName.span.length == localArrayElementDeclarationName.span.length => localArrayElementEqual!
                                                UIntSize(0) => localArrayElementByte!
                                                localArrayElementEqual! and localArrayElementByte! < localArrayElementName.span.length
                                                    -> while {
                                                        (source -> byte(localArrayElementName.span.start + localArrayElementByte!)) != (source -> byte(localArrayElementDeclarationName.span.start + localArrayElementByte!))
