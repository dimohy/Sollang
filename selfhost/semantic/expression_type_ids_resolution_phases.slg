                    -> if { 23 => builtinTypeId! }
                node.kind == 63 -> if { 25 => builtinTypeId! }
                node.kind == 64 -> if { 2 => builtinTypeId! }
                node.kind == 57 -> if { 0 => builtinTypeId! }
                node.kind >= 44 and node.kind <= 47 -> if { 0 => builtinTypeId! }
                node.kind == 53 or node.kind == 54 -> if { 0 => builtinTypeId! }
                node.kind == 49 -> if {
