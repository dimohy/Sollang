                                -> if { 3 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "Int16" } -> textMatches
                                -> if { 4 => typedArrayElementType! }
                            TextMatchRequest { source: source, start: typedArrayName.span.start, length: typedArrayName.span.length, expected: "Int32" } -> textMatches
