                        -1 => typedArrayElementType!
                        -1 => typedArrayNameToken!
                        false => typedArrayBounded!
                        -1 => typedArrayCapacity!
                        node.firstToken => typedArrayTokenIndex!
                        typedArrayTokenIndex! < node.firstToken + node.tokenCount
                            -> while {
