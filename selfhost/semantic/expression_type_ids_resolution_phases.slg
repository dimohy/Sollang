# Ordered expression-type phases. Each phase has an explicit borrowed
# table boundary so compiler implementations can compile the functions as
# independent work units and preserve this semantic order at the call site.

# Collection callbacks share element-role inference, but ordinary declarations
# own their callback contract even when their name shadows a runtime intrinsic.
public intrinsicCollectionRoleKind prepared: ref semanticContext.SemanticSnapshot, sourceIndex: Int, astIndex: Int -> Int {
    prepared.package.ranges[sourceIndex] => range
    prepared.package.nodes[range.astStart + astIndex] => roleAst
    roleAst.kind != 48 or roleAst.payloadToken < 0
        -> if { 0 -> return }
    sourceIndex => nameSource!
    roleAst.payloadToken => nameToken!
    prepared.callIndexByAst[range.astStart + astIndex] => callIndex
    callIndex >= 0 -> if {
        prepared.calls[callIndex] => call
        call.status == 0 and call.targetSourceModule >= 0 and call.functionSymbol >= 0
            -> if {
                prepared.package.ranges[call.targetSourceModule] => targetRange
                prepared.package.symbols[targetRange.symbolStart + call.functionSymbol] => declaration
                declaration.flags / 128 % 2 != 1 -> if { 0 -> return }
                call.targetSourceModule => nameSource!
                declaration.nameToken => nameToken!
            }
    }
    nameToken! < 0 -> if { 0 -> return }
    prepared.package.ranges[nameSource!] => nameRange
    prepared.package.tokens[nameRange.tokenStart + nameToken!] => token
    prepared.package.sources[nameSource!] -> len => sourceLength
    prepared.package.sources[nameSource!] -> slice(UIntSize(0), sourceLength) => source
    TextMatchRequest { source: source, start: token.span.start, length: token.span.length, expected: "each" } -> textMatches
        -> if { 1 -> return }
    TextMatchRequest { source: source, start: token.span.start, length: token.span.length, expected: "repeat" } -> textMatches
        -> if { 4 -> return }
    TextMatchRequest { source: source, start: token.span.start, length: token.span.length, expected: "parallel" } -> textMatches
        -> if { 2 -> return }
    TextMatchRequest { source: source, start: token.span.start, length: token.span.length, expected: "tryParallel" } -> textMatches
        -> if { 3 -> return }
    0
}

# Resolved declaration identity is shared by ordinary role reads and
# interpolation-only role reads. Generic roles use the full argument environment.
primaryBlockRoleTypeId prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], references: ref [typeIds.TypeReference; ~], referenceIndexByTypeAst: ref [Int; ~], expressions: ref [ExpressionTypeId; ~], expressionIndexByAst: ref [Int; ~], argumentBindings: ref [semanticContext.CallArgumentBinding; ~], sourceIndex: Int, role: symbols.Symbol -> Int {
    role.kind != 35 or role.typeNode >= 0 or role.astNode < 0
        -> if { -1 -> return }
    prepared.package.ranges[sourceIndex] => range
    role.parent < 0 or role.parent >= range.symbolCount
        -> if { -1 -> return }
    prepared.package.symbols[range.symbolStart + role.parent] => roleScope
    roleScope.kind != 48 -> if { -1 -> return }
    roleScope.astNode => roleCallAst
    prepared.callIndexByAst[range.astStart + roleCallAst] => callIndex
    callIndex < 0 -> if { -1 -> return }
    prepared.calls[callIndex] => call
    call.status != 0 or call.targetSourceModule < 0
        -> if { -1 -> return }
    prepared.package.ranges[call.targetSourceModule] => targetRange
    prepared.package.symbols[targetRange.symbolStart + call.functionSymbol] => function
    function.blockTypeNode < 0 -> if { -1 -> return }
    0 => roleOrdinal!
    0 => roleSearch!
    roleSearch! < range.symbolCount -> while {
        prepared.package.symbols[range.symbolStart + roleSearch!] => earlierRole
        earlierRole.kind == 35 and earlierRole.parent == role.parent
            and earlierRole.nameToken < role.nameToken
            -> if { roleOrdinal! + 1 => roleOrdinal! }
        roleSearch! + 1 => roleSearch!
    }
    function.blockTypeNode => roleTypeAst!
    0 => selectedOrdinal!
    selectedOrdinal! < roleOrdinal! -> while {
        -1 => nextRoleTypeAst!
        references -> each candidateReference {
            candidateReference.sourceModule == call.targetSourceModule
                and candidateReference.status == 0
                -> if {
                    prepared.package.nodes[targetRange.astStart + candidateReference.typeAst] => candidateType
                    candidateType.parent == function.astNode
                        and candidateType.operatorKind == grammar.tokenIdColon()
                        and candidateType.start > prepared.package.nodes[targetRange.astStart + roleTypeAst!].start
                        and (nextRoleTypeAst! < 0 or candidateType.start < prepared.package.nodes[targetRange.astStart + nextRoleTypeAst!].start)
                        -> if { candidateReference.typeAst => nextRoleTypeAst! }
                }
        }
        nextRoleTypeAst! < 0 -> if { -1 -> return }
        nextRoleTypeAst! => roleTypeAst!
        selectedOrdinal! + 1 => selectedOrdinal!
    }
    referenceIndexByTypeAst[targetRange.astStart + roleTypeAst!] => referenceIndex
    referenceIndex < 0 -> if { -1 -> return }
    references[referenceIndex] => reference
    reference.status != 0 or reference.typeId < 0 or reference.typeId >= (types -> len)
        -> if { -1 -> return }
    not types[reference.typeId].containsParameter
        -> if { reference.typeId -> return }
    [Int; ~] => templates!
    [Int; ~] => actuals!
    false => seeded!
    false => unresolved!
    argumentBindings -> each binding {
        binding.sourceModule == sourceIndex and binding.callAst == roleCallAst
            -> if {
                not seeded! -> if {
                    seedExplicitFlowGenericArguments(prepared, types, references, referenceIndexByTypeAst, binding, templates!, actuals!)
                    true => seeded!
                }
                prepared.package -> typeIds.functionParameterTypeId(references, referenceIndexByTypeAst, binding.targetSourceModule, binding.parameterSymbol) => formalType
                expressionIndexByAst[range.astStart + binding.argumentAst] => actualIndex
                formalType >= 0 and actualIndex >= 0 and expressions[actualIndex].status == 0
                    -> if {
                        expressions[actualIndex].typeId => actualType
                        actualType >= 0 and not types[actualType].containsParameter
                            -> if {
                                templates! -> push(formalType)
                                actuals! -> push(actualType)
                            } else { true => unresolved! }
                    } else { true => unresolved! }
            }
    }
    unresolved! or (templates! -> len) == 0 -> if { -1 -> return }
    types -> typeIds.specializeManyInto(templates!, actuals!, reference.typeId) => specialized
    specialized.status == 0 and specialized.root >= 0
        -> if {
            not types[specialized.root].containsParameter
                -> if { specialized.root -> return }
        }
    -1
}

# Arithmetic returns the resolved left operand type. The canonical result
# belongs to the operator AST, before bindings and conversion arguments read it.
resolveArithmeticExpressionTypes prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~] -> Bool {
    [Int; ~] => leftChildByAst!
    0 => childSeed!
    childSeed! < (prepared.package.nodes -> len) -> while {
        leftChildByAst! -> push(-1)
        childSeed! + 1 => childSeed!
    }
    0 => sourceIndex!
    sourceIndex! < (prepared.package.ranges -> len)
        -> while {
            prepared.package.ranges[sourceIndex!] => sourceRange
            0 => childIndex!
            childIndex! < sourceRange.astCount -> while {
                prepared.package.nodes[sourceRange.astStart + childIndex!] => child
                child.parent >= 0 and child.parent < sourceRange.astCount
                    -> if {
                        sourceRange.astStart + child.parent => parentGlobalAst
                        leftChildByAst![parentGlobalAst] => previousChild
                        previousChild < 0
                            or child.start < prepared.package.nodes[sourceRange.astStart + previousChild].start
                            or (child.start == prepared.package.nodes[sourceRange.astStart + previousChild].start
                            and child.length > prepared.package.nodes[sourceRange.astStart + previousChild].length)
                            -> if { childIndex! => leftChildByAst![parentGlobalAst] }
                    }
                childIndex! + 1 => childIndex!
            }
            sourceIndex! + 1 => sourceIndex!
        }

    false => anyChanged!
    true => changed!
    changed! -> while {
        false => changed!
        0 => arithmeticSource!
        arithmeticSource! < (prepared.package.ranges -> len)
            -> while {
                prepared.package.ranges[arithmeticSource!] => arithmeticRange
                0 => arithmeticAst!
                arithmeticAst! < arithmeticRange.astCount -> while {
                    arithmeticRange.astStart + arithmeticAst! => arithmeticGlobalAst
                    prepared.package.nodes[arithmeticGlobalAst] => arithmeticNode
                    arithmeticNode.kind == 20 or arithmeticNode.kind == 21
                        or (arithmeticNode.kind == 22 and arithmeticNode.operatorKind == grammar.tokenIdMinus())
                        -> if {
                            leftChildByAst![arithmeticGlobalAst] => leftChild
                            leftChild >= 0 -> if {
                                expressionIndexByAst[arithmeticRange.astStart + leftChild] => leftExpressionIndex
                                leftExpressionIndex >= 0 -> if {
                                    types -> typeIds.materializedReadTypeId(expressions[leftExpressionIndex].typeId) => resultTypeId
                                    resultTypeId >= 0 and resultTypeId < (types -> len)
                                        -> if {
                                            types[resultTypeId] => resultType
                                            resultType.kind == 1 and resultType.origin == 1
                                                and ((resultType.symbol >= 2 and resultType.symbol <= 13)
                                                or (resultType.symbol >= 19 and resultType.symbol <= 22))
                                                and (arithmeticNode.kind != 22
                                                or ((resultType.symbol -> typeIds.isSignedNumericBuiltinSymbol)
                                                and prepared.package.nodes[arithmeticRange.astStart + leftChild].kind != 14))
                                                -> if {
                                                    expressionIndexByAst[arithmeticGlobalAst] => resultIndex
                                                    resultIndex < 0 -> if {
                                                        expressions -> len => nextIndex
                                                        expressions -> push(ExpressionTypeId {
                                                            sourceModule: arithmeticSource!
                                                            astNode: arithmeticAst!
                                                            typeId: resultTypeId
                                                            status: 0
                                                        })
                                                        nextIndex => expressionIndexByAst[arithmeticGlobalAst]
                                                        true => changed!
                                                        true => anyChanged!
                                                    } else {
                                                        expressions[resultIndex].typeId != resultTypeId
                                                            -> if {
                                                                expressions[resultIndex] => resultExpression!
                                                                resultTypeId => resultExpression!.typeId
                                                                resultExpression! => expressions[resultIndex]
                                                                true => changed!
                                                                true => anyChanged!
                                                            }
                                                    }
                                                }
                                        }
                                }
                            }
                        }
                    arithmeticAst! + 1 => arithmeticAst!
                }
                arithmeticSource! + 1 => arithmeticSource!
            }
    }
    anyChanged!
}

# Literal unary values wait until contextual inference has committed their
# destination width. Fill only missing carriers; an existing contextual type
# remains authoritative over the numeric leaf's initial default type.
resolveMissingUnaryExpressionTypes prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~] -> Bool {
    false => anyChanged!
    true => changed!
    changed! -> while {
        false => changed!
        prepared.package.ranges -> each range {
            0 => childAst!
            childAst! < range.astCount -> while {
                prepared.package.nodes[range.astStart + childAst!] => child
                child.parent >= 0 and child.parent < range.astCount
                    -> if {
                        range.astStart + child.parent => parentGlobal
                        prepared.package.nodes[parentGlobal] => parent
                        parent.kind == 22 and parent.operatorKind == grammar.tokenIdMinus()
                            and expressionIndexByAst[parentGlobal] < 0 -> if {
                                expressionIndexByAst[range.astStart + childAst!] => childExpression
                                childExpression >= 0 -> if {
                                    types -> typeIds.materializedReadTypeId(expressions[childExpression].typeId) => typeId
                                    typeId >= 0 and typeId < (types -> len) -> if {
                                        types[typeId] => type
                                        type.kind == 1 and type.origin == 1 and (type.symbol -> typeIds.isSignedNumericBuiltinSymbol)
                                            -> if {
                                                expressions -> len => expressionIndexByAst[parentGlobal]
                                                expressions -> push(ExpressionTypeId { sourceModule: range.sourceModule, astNode: child.parent, typeId: typeId, status: 0 })
                                                true => changed!
                                                true => anyChanged!
                                            }
                                    }
                                }
                            }
                    }
                childAst! + 1 => childAst!
            }
        }
    }
    anyChanged!
}

# Match BindingStatement's InferContextualValue: a rebind literal receives the
# visible original owner's numeric type. Non-literal values retain their own
# type so a mismatched rebind remains diagnosable before lowering.
resolveMutableRebindLiteralTypes prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], owners: ref [Int; ~], bindingValues: ref [Int; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: ref [Int; ~] -> Bool {
    false => changed!
    prepared.package.ranges -> each range {
        0 => symbolIndex!
        symbolIndex! < range.symbolCount -> while {
            range.symbolStart + symbolIndex! => globalSymbol
            owners[globalSymbol] => owner
            owner != globalSymbol and bindingValues[owner] >= 0 and bindingValues[globalSymbol] >= 0
                -> if {
                    bindingValues[globalSymbol] => valueGlobal
                    prepared.package.nodes[valueGlobal] => value
                    value.kind == 14 -> if {
                        expressionIndexByAst[bindingValues[owner]] => ownerExpression
                        expressionIndexByAst[valueGlobal] => valueExpression
                        ownerExpression >= 0 and valueExpression >= 0
                            -> if {
                                expressions[ownerExpression].typeId => ownerTypeId
                                ownerTypeId >= 0 and ownerTypeId < (types -> len)
                                    -> if {
                                        types[ownerTypeId] => ownerType
                                        ownerType.kind == 1 and ownerType.origin == 1
                                            and ((ownerType.symbol >= 2 and ownerType.symbol <= 13)
                                            or (ownerType.symbol >= 19 and ownerType.symbol <= 22))
                                            -> if {
                                                prepared.package.sources[range.sourceModule] -> slice(UIntSize(0), prepared.package.sources[range.sourceModule] -> len) => source
                                                source -> numericLiteralRange.literalUsesFloatingSyntax(value.start, value.start + value.length) => floatingSyntax
                                                (not floatingSyntax or ownerType.symbol >= 19)
                                                    and expressions[valueExpression].typeId != ownerTypeId
                                                    -> if {
                                                        expressions[valueExpression] => contextual!
                                                        ownerTypeId => contextual!.typeId
                                                        contextual! => expressions[valueExpression]
                                                        true => changed!
                                                    }
                                            }
                                    }
                            }
                    }
                }
            symbolIndex! + 1 => symbolIndex!
        }
    }
    changed!
}

# Declared scalar and array-element numeric context follows exact final-value AST edges and
# explicit return values in their nearest lexical function. Unrelated earlier
# statements, selection subjects, and independent named arm values do not inherit it.
public declaredNumericReturnContextByAst package: ref analysis.PackageAnalysis, types: ref [typeIds.SemanticType; ~], references: [typeIds.TypeReference] -> [Int; ~] {
    [Int; ~] => expected!
    [Int; ~] => firstChild!
    [Int; ~] => lastChild!
    [Int; ~] => nextChild!
    [Int; ~] => referenceType!
    package.nodes -> each node {
        expected! -> push(-1)
        firstChild! -> push(-1)
        lastChild! -> push(-1)
        nextChild! -> push(-1)
        referenceType! -> push(-1)
    }
    references -> each reference {
        reference.status == 0 and reference.sourceModule >= 0 and reference.typeAst >= 0
            -> if {
                package.ranges[reference.sourceModule] => range
                reference.typeAst < range.astCount
                    -> if { reference.typeId => referenceType![range.astStart + reference.typeAst] }
            }
    }
    package.ranges -> each range {
        0 => astIndex!
        astIndex! < range.astCount -> while {
            range.astStart + astIndex! => globalAst
            package.nodes[globalAst] => node
            node.parent >= 0 -> if {
                range.astStart + node.parent => parentGlobal
                firstChild![parentGlobal] < 0 -> if { globalAst => firstChild![parentGlobal] } else {
                    globalAst => nextChild![lastChild![parentGlobal]]
                }
                globalAst => lastChild![parentGlobal]
            }
            astIndex! + 1 => astIndex!
        }
    }
    [Int; ~] => pending!
    package.ranges -> each range {
        0 => symbolIndex!
        symbolIndex! < range.symbolCount -> while {
            package.symbols[range.symbolStart + symbolIndex!] => function
            (function.kind == 7 or function.kind == 31) and function.astNode >= 0
                -> if {
                    function.typeNode => resultAst!
                    function.secondaryTypeNode >= 0 -> if { function.secondaryTypeNode => resultAst! }
                    resultAst! >= 0 and resultAst! < range.astCount
                        -> if {
                            referenceType![range.astStart + resultAst!] => resultTypeId
                            resultTypeId >= 0 and resultTypeId < (types -> len)
                                -> if {
                                    types[resultTypeId] => resultType
                                    (resultType.kind == 1 and resultType.origin == 1
                                        and resultType.symbol >= 2 and resultType.symbol <= 13) => numericReturn!
                                    (resultType.kind == 3 or resultType.kind == 4 or resultType.kind == 12)
                                        and resultType.first >= 0 and resultType.first < (types -> len)
                                        -> if {
                                            types[resultType.first] => elementType
                                            elementType.kind == 1 and elementType.origin == 1
                                                and elementType.symbol >= 2 and elementType.symbol <= 13
                                                -> if { true => numericReturn! }
                                        }
                                    numericReturn! -> if {
                                        resultTypeId => expected![range.astStart + function.astNode]
                                        -1 => terminal!
                                        firstChild![range.astStart + function.astNode] => child!
                                        child! >= 0 -> while {
                                            package.nodes[child!] => candidate
                                            candidate.kind != 16 and candidate.kind != 17
                                                and (terminal! < 0 or candidate.start > package.nodes[terminal!].start)
                                                -> if { child! => terminal! }
                                            nextChild![child!] => child!
                                        }
                                        terminal! >= 0 -> if {
                                            resultTypeId => expected![terminal!]
                                            pending! -> push(terminal!)
                                        }
                                    }
                                }
                        }
                }
            symbolIndex! + 1 => symbolIndex!
        }
    }
    package.ranges -> each range {
        0 => astIndex!
        astIndex! < range.astCount -> while {
            range.astStart + astIndex! => globalAst
            package.nodes[globalAst] => node
            node.kind == 47 and firstChild![globalAst] >= 0
                -> if {
                    node.parent => owner!
                    0 => ownerEdges!
                    owner! >= 0 and owner! < range.astCount and ownerEdges! < range.astCount
                        and package.nodes[range.astStart + owner!].kind != 7
                        and package.nodes[range.astStart + owner!].kind != 31
                        -> while {
                            package.nodes[range.astStart + owner!].parent => owner!
                            ownerEdges! + 1 => ownerEdges!
                        }
                    owner! >= 0 and owner! < range.astCount and ownerEdges! < range.astCount
                        and (package.nodes[range.astStart + owner!].kind == 7 or package.nodes[range.astStart + owner!].kind == 31)
                        and expected![range.astStart + owner!] >= 0
                        -> if {
                            firstChild![globalAst] => value
                            expected![range.astStart + owner!] => expected![value]
                            pending! -> push(value)
                        }
                }
            astIndex! + 1 => astIndex!
        }
    }
    0 => pendingIndex!
    pendingIndex! < (pending! -> len) -> while {
        pending![pendingIndex!] => globalAst
        package.nodes[globalAst] => node
        -1 => terminal!
        node.kind == 10 or node.kind == 43 or node.kind == 58
            -> if {
                firstChild![globalAst] => child!
                child! >= 0 -> while {
                    terminal! < 0 or package.nodes[child!].start > package.nodes[terminal!].start
                        -> if { child! => terminal! }
                    nextChild![child!] => child!
                }
            }
        node.kind == 37 and expected![globalAst] >= 0
            -> if {
                types[expected![globalAst]] => expectedArray
                expectedArray.kind == 3 or expectedArray.kind == 4 or expectedArray.kind == 12
                    -> if {
                        firstChild![globalAst] => element!
                        element! >= 0 -> while {
                            package.nodes[element!].kind != 12 -> if {
                                expectedArray.first => expected![element!]
                                pending! -> push(element!)
                            }
                            nextChild![element!] => element!
                        }
                    }
            }
        node.kind == 22 and node.operatorKind == grammar.tokenIdMinus()
            and firstChild![globalAst] >= 0
            and package.nodes[firstChild![globalAst]].kind == 14
            -> if { firstChild![globalAst] => terminal! }
        terminal! >= 0 -> if {
            expected![globalAst] => expected![terminal!]
            pending! -> push(terminal!)
        }
        node.kind == 56 or node.kind == 57 -> if {
            firstChild![globalAst] => arm!
            arm! >= 0 -> while {
                package.nodes[arm!].kind == 58 or package.nodes[arm!].kind == 43
                    -> if {
                        expected![globalAst] => expected![arm!]
                        pending! -> push(arm!)
                    }
                nextChild![arm!] => arm!
            }
        }
        pendingIndex! + 1 => pendingIndex!
    }
    expected!
}

resolveDeclaredNumericReturnLiterals prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], references: [typeIds.TypeReference], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~] -> Bool {
    prepared.package -> declaredNumericReturnContextByAst(types, references) => expected
    false => changed!
    prepared.package.ranges -> each range {
        prepared.package.sources[range.sourceModule] -> len => sourceLength
        prepared.package.sources[range.sourceModule] -> slice(UIntSize(0), sourceLength) => source
        0 => astIndex!
        astIndex! < range.astCount -> while {
            range.astStart + astIndex! => globalAst
            prepared.package.nodes[globalAst] => node
            expected[globalAst] >= 0 and types[expected[globalAst]].kind == 1
                and types[expected[globalAst]].origin == 1
                and types[expected[globalAst]].symbol >= 2 and types[expected[globalAst]].symbol <= 13
                and (node.kind == 14 or (node.kind == 22 and node.operatorKind == grammar.tokenIdMinus()))
                and not (source -> numericLiteralRange.literalUsesFloatingSyntax(node.start, node.start + node.length))
                -> if {
                    expressionIndexByAst[globalAst] < 0 -> if {
                        expressions -> len => expressionIndexByAst[globalAst]
                        expressions -> push(ExpressionTypeId {
                            sourceModule: range.sourceModule
                            astNode: astIndex!
                            typeId: expected[globalAst]
                            status: 0
                        })
                        true => changed!
                    } else {
                        expressionIndexByAst[globalAst] => expressionIndex
                        expressions[expressionIndex] => expression!
                        expression!.typeId != expected[globalAst] -> if {
                            expected[globalAst] => expression!.typeId
                            expression! => expressions[expressionIndex]
                            true => changed!
                        }
                    }
                }
            astIndex! + 1 => astIndex!
        }
    }
    changed!
}

# Match InferNumericOperands: an independently typed numeric operand supplies
# the type for a bare numeric literal before binary validation and IR lowering.
resolveContextualNumericLiteralTypes prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~] -> Bool {
    [Int; ~] => expectedContextByAst!
    prepared.package.nodes -> each node { expectedContextByAst! -> push(-1) }
    resolveContextualNumericLiteralTypesWithExpectedContext(prepared, types, expressions, expressionIndexByAst, expectedContextByAst!)
}

numericLiteralLeaf package: ref analysis.PackageAnalysis, globalAst: Int, firstChildByAst: ref [Int; ~] -> Int {
    package.nodes[globalAst] => node
    node.kind == 14 -> if { globalAst -> return }
    node.kind == 22 and node.operatorKind == grammar.tokenIdMinus()
        -> if {
            firstChildByAst[globalAst] => child
            child >= 0 and package.nodes[child].kind == 14
                -> if { child -> return }
        }
    -1
}

# Keep operand selection shared with S001: literals and control results need
# context; a named or explicitly typed peer supplies it.
public contextualNumericOperand package: ref analysis.PackageAnalysis, globalAst: Int, firstChildByAst: ref [Int; ~], nextChildByAst: ref [Int; ~] -> Bool {
    package -> numericLiteralLeaf(globalAst, firstChildByAst) => literal
    literal >= 0 -> if { true -> return }
    package.nodes[globalAst] => expression
    expression.kind == 42 or expression.kind == 56 or expression.kind == 57
        -> if { true -> return }
    expression.kind == 10 -> if {
        firstChildByAst[globalAst] => terminal!
        terminal! >= 0 -> if {
            nextChildByAst[terminal!] >= 0 -> while { nextChildByAst[terminal!] => terminal! }
            package.nodes[terminal!].kind => kind
            kind == 42 or kind == 56 or kind == 57 -> if { true -> return }
        }
    }
    false
}

resolveContextualNumericLiteralTypesWithExpectedContext prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~], expectedContextByAst: ref [Int; ~] -> Bool {
    false => changed!
    [Int; ~] => firstChildByAst!
    [Int; ~] => lastChildByAst!
    [Int; ~] => nextChildByAst!
    prepared.package.nodes -> each childSlot {
        firstChildByAst! -> push(-1)
        lastChildByAst! -> push(-1)
        nextChildByAst! -> push(-1)
    }
    prepared.package.ranges -> each range {
        0 => astIndex!
        astIndex! < range.astCount -> while {
            range.astStart + astIndex! => globalAst
            prepared.package.nodes[globalAst].parent => parentAst
            parentAst >= 0 and parentAst < range.astCount
                -> if {
                    range.astStart + parentAst => parentGlobal
                    firstChildByAst![parentGlobal] < 0
                        -> if { globalAst => firstChildByAst![parentGlobal] } else {
                            globalAst => nextChildByAst![lastChildByAst![parentGlobal]]
                        }
                    globalAst => lastChildByAst![parentGlobal]
                }
            astIndex! + 1 => astIndex!
        }
    }
    prepared.package.ranges -> each range {
        prepared.package.sources[range.sourceModule] -> len => sourceLength
        prepared.package.sources[range.sourceModule] -> slice(UIntSize(0), sourceLength) => source
        0 => astIndex!
        astIndex! < range.astCount -> while {
            range.astStart + astIndex! => binaryGlobal
            prepared.package.nodes[binaryGlobal] => binary
            binary.kind == 18 or binary.kind == 19 or binary.kind == 20 or binary.kind == 21
                -> if {
                    firstChildByAst![binaryGlobal] => leftGlobal
                    leftGlobal >= 0 -> if {
                        nextChildByAst![leftGlobal] => rightGlobal
                        rightGlobal >= 0 and nextChildByAst![rightGlobal] < 0
                            -> if {
                                prepared.package -> numericLiteralLeaf(leftGlobal, firstChildByAst!) => leftLeaf
                                prepared.package -> numericLiteralLeaf(rightGlobal, firstChildByAst!) => rightLeaf
                                prepared.package -> contextualNumericOperand(leftGlobal, firstChildByAst!, nextChildByAst!) => leftContextual
                                prepared.package -> contextualNumericOperand(rightGlobal, firstChildByAst!, nextChildByAst!) => rightContextual
                                leftLeaf >= 0 and not rightContextual
                                    -> if { leftGlobal } else {
                                        rightLeaf >= 0 and not leftContextual
                                            -> if { rightGlobal } else { -1 }
                                    } => literalGlobal
                                literalGlobal >= 0 and expectedContextByAst[literalGlobal] < 0
                                    -> if {
                                        literalGlobal == leftGlobal -> if { rightGlobal } else { leftGlobal } => anchorGlobal
                                        expressionIndexByAst[anchorGlobal] => anchorIndex
                                        anchorIndex >= 0 -> if {
                                            types -> typeIds.materializedReadTypeId(expressions[anchorIndex].typeId) => anchorTypeId
                                            anchorTypeId >= 0 and anchorTypeId < (types -> len)
                                                -> if {
                                                    types[anchorTypeId] => anchorType
                                                    anchorType.kind == 1 and anchorType.origin == 1
                                                        and ((anchorType.symbol >= 2 and anchorType.symbol <= 13)
                                                        or (anchorType.symbol >= 19 and anchorType.symbol <= 22))
                                                        -> if {
                                                            literalGlobal == leftGlobal -> if { leftLeaf } else { rightLeaf } => leafGlobal
                                                            expressionIndexByAst[literalGlobal] => literalIndex
                                                            -1 => previousType!
                                                            literalIndex >= 0 -> if { expressions[literalIndex].typeId => previousType! }
                                                            expressionIndexByAst[leafGlobal] => leafIndex
                                                            -1 => previousLeafType!
                                                            leafIndex >= 0 -> if { expressions[leafIndex].typeId => previousLeafType! }
                                                            contextualizeNumericCallArgumentArena(prepared, types, expressions, expressionIndexByAst, range.sourceModule, literalGlobal - range.astStart, anchorTypeId) => contextual
                                                            contextual and (previousType! != anchorTypeId or previousLeafType! != anchorTypeId)
                                                                -> if { true => changed! }
                                                        }
                                                }
                                        }
                                    }
                                # Use the canonical value walk for both if and when.
                                # Conditions, subjects and independent typed values keep their types.
                                leftContextual and not rightContextual and leftLeaf < 0
                                    -> if { leftGlobal } else {
                                        rightContextual and not leftContextual and rightLeaf < 0
                                            -> if { rightGlobal } else { -1 }
                                    } => controlGlobal
                                controlGlobal >= 0 -> if {
                                    controlGlobal == leftGlobal -> if { rightGlobal } else { leftGlobal } => anchorGlobal
                                    expressionIndexByAst[anchorGlobal] => anchorIndex
                                    anchorIndex >= 0 -> if {
                                        types -> typeIds.materializedReadTypeId(expressions[anchorIndex].typeId) => anchorTypeId
                                        anchorTypeId >= 0 and anchorTypeId < (types -> len)
                                            -> if {
                                                types[anchorTypeId] => anchorType
                                                anchorType.symbol -> typeIds.canonicalBuiltinSymbol => symbol
                                                anchorType.kind == 1 and anchorType.origin == 1
                                                    and symbol >= 2 and symbol <= 14
                                                    -> if {
                                                        prepared.package -> contextualNumericValueAsts(firstChildByAst!, nextChildByAst!, controlGlobal, true) => values
                                                        values -> each valueGlobal {
                                                            prepared.package -> numericLiteralLeaf(valueGlobal, firstChildByAst!) => number
                                                            number >= 0 -> if {
                                                                prepared.package.nodes[number] => literal
                                                                source -> numericLiteralRange.literalUsesFloatingSyntax(literal.start, literal.start + literal.length) => floating
                                                                not floating -> if {
                                                                    setContextualRecordExpressionType(expressions, expressionIndexByAst, range.sourceModule, valueGlobal - range.astStart, valueGlobal, anchorTypeId)
                                                                        -> if { true => changed! }
                                                                    number != valueGlobal -> if {
                                                                        setContextualRecordExpressionType(expressions, expressionIndexByAst, range.sourceModule, number - range.astStart, number, anchorTypeId)
                                                                            -> if { true => changed! }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                            }
                                    }
                                }
                            }
                    }
                }
            astIndex! + 1 => astIndex!
        }
    }
    changed!
}

# Qualified call and constructor syntax can wrap one value without adding a
# member access. Commit the same-span direct value type for every consumer.
resolveQualifiedValueWrapperTypes prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~], externalResults: ref [ExpressionTypeId; ~] -> Bool {
    [Bool; ~] => resolvedCallByAst!
    prepared.package.nodes -> each nodeSlot { resolvedCallByAst! -> push(false) }
    prepared.calls -> each call {
        call.status == 0 and call.sourceModule >= 0
            and call.sourceModule < (prepared.package.ranges -> len)
            -> if {
                prepared.package.ranges[call.sourceModule] => range
                call.callAst >= 0 and call.callAst < range.astCount
                    -> if { true => resolvedCallByAst![range.astStart + call.callAst] }
            }
    }
    # Validated external calls have no source declaration in prepared.calls.
    # Their explicit result facts admit the same exact-span wrapper rule.
    externalResults -> each value {
        true => resolvedCallByAst![prepared.package.ranges[value.sourceModule].astStart + value.astNode]
    }
    false => changed!
    0 => valueIndex!
    valueIndex! < (expressions -> len) -> while {
        expressions[valueIndex!] => value
        prepared.package.ranges[value.sourceModule] => range
        range.astStart + value.astNode => valueGlobal
        prepared.package.nodes[valueGlobal] => node
        value.status == 0 and value.typeId >= 0 and value.typeId < (types -> len)
            and (node.kind == 55 or (node.kind == 11 and resolvedCallByAst![valueGlobal]))
            and node.parent >= 0 and node.parent < range.astCount
            -> if {
                range.astStart + node.parent => wrapperGlobal
                prepared.package.nodes[wrapperGlobal] => wrapper
                wrapper.kind == 36 and wrapper.start == node.start and wrapper.length == node.length
                    -> if {
                        expressionIndexByAst[wrapperGlobal] => wrapperIndex
                        wrapperIndex < 0 -> if {
                            expressions -> len => nextIndex
                            expressions -> push(ExpressionTypeId {
                                sourceModule: value.sourceModule
                                astNode: node.parent
                                typeId: value.typeId
                                status: 0
                            })
                            nextIndex => expressionIndexByAst[wrapperGlobal]
                            true => changed!
                        } else {
                            expressions[wrapperIndex] => existing!
                            existing!.typeId != value.typeId or existing!.status != 0
                                -> if {
                                    value.typeId => existing!.typeId
                                    0 => existing!.status
                                    existing! => expressions[wrapperIndex]
                                    true => changed!
                                }
                        }
                    }
            }
        valueIndex! + 1 => valueIndex!
    }
    changed!
}

# C# InferTryExpression returns Result<T,E>.Ok's T before the receiving binding
# is inferred. Keep that decision in the semantic arena instead of waiting for
# Typed IR's later propagation repair.
resolveResultPropagationPayloadTypes prepared: ref semanticContext.SemanticSnapshot, types: ref [typeIds.SemanticType; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~] -> Bool {
    [Int; ~] => operandByPropagation!
    prepared.package.nodes -> each nodeSlot { operandByPropagation! -> push(-1) }
    prepared.package.ranges -> each range {
        0 => childAst!
        childAst! < range.astCount -> while {
            range.astStart + childAst! => childGlobal
            prepared.package.nodes[childGlobal] => child
            child.parent >= 0 and child.parent < range.astCount
                -> if {
                    range.astStart + child.parent => parentGlobal
                    prepared.package.nodes[parentGlobal].kind == 82
                        and operandByPropagation![parentGlobal] < 0
                        -> if { childGlobal => operandByPropagation![parentGlobal] }
                }
            childAst! + 1 => childAst!
        }
    }
    false => changed!
    prepared.package.ranges -> each range {
        0 => propagationAst!
        propagationAst! < range.astCount -> while {
            range.astStart + propagationAst! => propagationGlobal
            prepared.package.nodes[propagationGlobal].kind == 82
                -> if {
                    operandByPropagation![propagationGlobal] => operandGlobal
                    operandGlobal >= 0 -> if {
                        expressionIndexByAst[operandGlobal] => operandIndex
                        operandIndex >= 0 -> if {
                            types -> typeIds.materializedReadTypeId(expressions[operandIndex].typeId) => operandTypeId
                            operandTypeId >= 0 and operandTypeId < (types -> len)
                                -> if {
                                    types[operandTypeId] => operandType
                                    operandType.kind == 7 and operandType.origin == 4
                                        and operandType.symbol == 1 and operandType.first >= 0
                                        and operandType.first < (types -> len) -> if {
                                            expressionIndexByAst[propagationGlobal] => propagationIndex
                                            propagationIndex < 0 -> if {
                                                expressions -> len => nextIndex
                                                expressions -> push(ExpressionTypeId {
                                                    sourceModule: range.sourceModule
                                                    astNode: propagationAst!
                                                    typeId: operandType.first
                                                    status: 0
                                                })
                                                nextIndex => expressionIndexByAst[propagationGlobal]
                                                true => changed!
                                            } else {
                                                expressions[propagationIndex].typeId != operandType.first
                                                    -> if {
                                                        expressions[propagationIndex] => payloadExpression!
                                                        operandType.first => payloadExpression!.typeId
                                                        payloadExpression! => expressions[propagationIndex]
                                                        true => changed!
                                                    }
                                            }
                                        }
                                }
                        }
                    }
                }
            propagationAst! + 1 => propagationAst!
        }
    }
    changed!
}

resolveInitialExpressionTypes prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], references: ref [typeIds.TypeReference; ~], expressions: mut [ExpressionTypeId; ~], expressionIndexByAst: mut [Int; ~], referenceIndexByTypeAst: ref [Int; ~], argumentBindings: ref [semanticContext.CallArgumentBinding; ~], controlOwnerByAst: ref [Bool; ~], sourceTextModule: Int, sourceTextSymbol: Int, seededOwners: ref [Bool; ~] -> Unit {
