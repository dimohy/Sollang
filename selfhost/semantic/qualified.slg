                                                                                        UIntSize(0) => qualifiedVariantByte!
                                                                                        qualifiedVariantEqual! and qualifiedVariantByte! < qualifiedVariantName.span.length
                                                                                            -> while {
                                                                                                (qualifiedSource -> byte(qualifiedVariantName.span.start + qualifiedVariantByte!)) != (source -> byte(qualifiedVariantReference.span.start + qualifiedVariantByte!))
                                                                                                    -> if { false => qualifiedVariantEqual! }
                                                                                                qualifiedVariantByte! + 1 => qualifiedVariantByte!
                                                                                            }
                                                                                        qualifiedVariantEqual! -> if { qualifiedVariantSearch! => qualifiedModuleSymbol! }
                                                                                    }
                                                                                qualifiedVariantSearch! + 1 => qualifiedVariantSearch!
                                                                            }
                                                                    }
                                                                } else { qualifiedSymbolSearch! => qualifiedModuleSymbol! }
                                                                qualifiedCandidate.flags / 4 % 2 == 1 -> if { true => qualifiedModulePublic! }
                                                                qualifiedModuleSymbol! >= 0 -> if {
                                                                    qualifiedRange.symbolCount => qualifiedSymbolSearch!
                                                                    identities -> len => qualifiedModuleSearch!
                                                                }
                                                            }
                                                        }
                                                    qualifiedSymbolSearch! + 1 => qualifiedSymbolSearch!
                                                }
                                        }
                                    qualifiedModuleSearch! + 1 => qualifiedModuleSearch!
                                }
                            qualifiedModuleFound! -> if {
                                2 => qualifiedModuleStatus!
                                qualifiedModuleSymbol! >= 0 -> if {
                                    qualifiedModulePublic! -> if { 0 => qualifiedModuleStatus! } else { 3 => qualifiedModuleStatus! }
                                }
                                results! -> push(QualifiedResolution {
                                    sourceModule: sourceIndex!
                                    pathAst: pathAstIndex!
                                    targetModule: qualifiedModuleTarget!
                                    targetSymbol: qualifiedModuleSymbol!
                                    status: qualifiedModuleStatus!
                                })
                                true => localVariantResolved!
                            }
                        }
                        0 => edgeIndex!
                        localVariantResolved! -> if { importCount => edgeIndex! }
                        edgeIndex! < importCount -> while {
                            imports[edgeIndex!] => edge
                            resolvedImports[edgeIndex!] => resolvedImport
                            edge.sourceModule == sourceIndex! and resolvedImport.status == 0
                                -> if {
                                    package.tokens[sourceRange.tokenStart + edge.aliasToken] => aliasName
                                    package.tokens[sourceRange.tokenStart + firstIdentifier!] => pathAlias
                                    aliasName.span.length == pathAlias.span.length => aliasEqual!
                                    UIntSize(0) => aliasByte!
                                    aliasEqual! and aliasByte! < aliasName.span.length
                                        -> while {
                                            source -> byte(aliasName.span.start + aliasByte!) => aliasLeftByte
                                            source -> byte(pathAlias.span.start + aliasByte!) => aliasRightByte
                                            aliasLeftByte != aliasRightByte -> if { false => aliasEqual! }
                                            aliasByte! + 1 => aliasByte!
                                        }
                                    aliasEqual! -> if {
                                        resolvedImport.targetModule => targetModule
                                        targetModule => selectedTargetModule!
                                        identities[targetModule].sourceIndex => targetSourceIndex
                                        package.sources[targetSourceIndex] -> len => targetSourceLength
                                        package.sources[targetSourceIndex] -> slice(UIntSize(0), targetSourceLength) => targetSource
                                        package.ranges[targetSourceIndex] => targetRange
                                        -1 => targetSymbol!
                                        false => targetPublic!
                                        0 => symbolIndex!
                                        symbolIndex! < targetRange.symbolCount -> while {
                                            package.symbols[targetRange.symbolStart + symbolIndex!] => candidate
                                            # An impl header repeats its target type's name, but it is
                                            # not an exported namespace member. Without this filter a
                                            # later `impl SourceSpan` shadows the public `SourceSpan`
                                            # declaration during qualified type resolution.
                                            candidate.parent < 0 and candidate.kind != 6
                                                -> if {
                                                    package.tokens[targetRange.tokenStart + candidate.nameToken] => candidateName
                                                    lastIdentifier! => topLevelIdentifier!
                                                    identifierCount! >= 3 -> if { secondIdentifier! => topLevelIdentifier! }
                                                    package.tokens[sourceRange.tokenStart + topLevelIdentifier!] => memberName
                                                    candidateName.span.length == memberName.span.length => memberEqual!
                                                    UIntSize(0) => memberByte!
                                                    memberEqual! and memberByte! < candidateName.span.length
                                                        -> while {
                                                            targetSource -> byte(candidateName.span.start + memberByte!) => memberLeftByte
                                                            source -> byte(memberName.span.start + memberByte!) => memberRightByte
                                                            memberLeftByte != memberRightByte -> if { false => memberEqual! }
                                                            memberByte! + 1 => memberByte!
                                                        }
                                                    memberEqual! -> if {
                                                        identifierCount! >= 3 -> if {
                                                            candidate.kind == 4 -> if {
                                                                0 => nestedSymbolIndex!
                                                                nestedSymbolIndex! < targetRange.symbolCount
                                                                    -> while {
                                                                        package.symbols[targetRange.symbolStart + nestedSymbolIndex!] => nestedCandidate
                                                                        nestedCandidate.parent == symbolIndex! -> if {
                                                                            package.tokens[targetRange.tokenStart + nestedCandidate.nameToken] => nestedName
                                                                            package.tokens[sourceRange.tokenStart + lastIdentifier!] => nestedMemberName
                                                                            nestedName.span.length == nestedMemberName.span.length => nestedEqual!
                                                                            UIntSize(0) => nestedByte!
                                                                            nestedEqual! and nestedByte! < nestedName.span.length
                                                                                -> while {
                                                                                    targetSource -> byte(nestedName.span.start + nestedByte!) => nestedLeftByte
                                                                                    source -> byte(nestedMemberName.span.start + nestedByte!) => nestedRightByte
                                                                                    nestedLeftByte != nestedRightByte -> if { false => nestedEqual! }
                                                                                    nestedByte! + 1 => nestedByte!
                                                                                }
                                                                            nestedEqual! -> if {
                                                                                nestedSymbolIndex! => targetSymbol!
                                                                                candidate.flags >= 4 -> if { true => targetPublic! }
                                                                            }
                                                                        }
                                                                        nestedSymbolIndex! + 1 => nestedSymbolIndex!
                                                                    }
                                                            }
                                                        } else {
                                                            symbolIndex! => targetSymbol!
                                                            candidate.flags >= 4 -> if { true => targetPublic! }
                                                        }
                                                    }
                                                }
                                            symbolIndex! + 1 => symbolIndex!
                                        }
                                        # The import facade is the first source of a
                                        # logical module. If a top-level member lives
                                        # in another source fragment, continue the
                                        # lookup across identities with the same path.
                                        targetSymbol! < 0 and identifierCount! < 3 -> if {
                                            identities[targetModule].pathHash => targetPathHash
                                            0 => fragmentModuleIndex!
                                            fragmentModuleIndex! < (identities -> len) -> while {
                                                identities[fragmentModuleIndex!] => fragmentIdentity
                                                fragmentIdentity.pathHash == targetPathHash and fragmentModuleIndex! != targetModule
                                                    -> if {
                                                        fragmentIdentity.sourceIndex => fragmentSourceIndex
                                                        package.sources[fragmentSourceIndex] -> len => fragmentSourceLength
                                                        package.sources[fragmentSourceIndex] -> slice(UIntSize(0), fragmentSourceLength) => fragmentSource
                                                        package.ranges[fragmentSourceIndex] => fragmentRange
                                                        0 => fragmentSymbolIndex!
                                                        fragmentSymbolIndex! < fragmentRange.symbolCount
                                                            -> while {
                                                                package.symbols[fragmentRange.symbolStart + fragmentSymbolIndex!] => fragmentCandidate
                                                                fragmentCandidate.parent < 0 and fragmentCandidate.kind != 6
                                                                    -> if {
                                                                        package.tokens[fragmentRange.tokenStart + fragmentCandidate.nameToken] => fragmentCandidateName
                                                                        package.tokens[sourceRange.tokenStart + lastIdentifier!] => fragmentMemberName
                                                                        fragmentCandidateName.span.length == fragmentMemberName.span.length => fragmentMemberEqual!
                                                                        UIntSize(0) => fragmentMemberByte!
                                                                        fragmentMemberEqual! and fragmentMemberByte! < fragmentCandidateName.span.length
                                                                            -> while {
                                                                                (fragmentSource -> byte(fragmentCandidateName.span.start + fragmentMemberByte!)) != (source -> byte(fragmentMemberName.span.start + fragmentMemberByte!))
                                                                                    -> if {
                                                                                        false => fragmentMemberEqual!
                                                                                    }
                                                                                fragmentMemberByte! + 1 => fragmentMemberByte!
                                                                            }
                                                                        fragmentMemberEqual! -> if {
                                                                            fragmentSymbolIndex! => targetSymbol!
                                                                            fragmentCandidate.flags >= 4 -> if { true => targetPublic! }
                                                                            fragmentModuleIndex! => selectedTargetModule!
                                                                        }
                                                                    }
                                                                fragmentSymbolIndex! + 1 => fragmentSymbolIndex!
                                                            }
                                                    }
                                                fragmentModuleIndex! + 1 => fragmentModuleIndex!
                                            }
                                        }
                                        2 => status!
                                        targetSymbol! >= 0 -> if {
                                            targetPublic! -> if { 0 => status! } else { 3 => status! }
                                        }
                                        QualifiedResolution {
                                            sourceModule: sourceIndex!
                                            pathAst: pathAstIndex!
                                            targetModule: selectedTargetModule!
                                            targetSymbol: targetSymbol!
                                            status: status!
                                        } => result
                                        results! -> push(result)
                                        importCount => edgeIndex!
                                    } else {
                                        edgeIndex! + 1 => edgeIndex!
                                    }
                                } else {
                                    edgeIndex! + 1 => edgeIndex!
                                }
                        }
                    }
            }
            pathAstIndex! + 1 => pathAstIndex!
        }
        sourceIndex! + 1 => sourceIndex!
    }
    results!
}

# The declaration and unqualified impl header live in the same source scope.
# Qualified and generic headers remain owned by their existing resolvers.
localNominalFunction package: ref analysis.PackageAnalysis, sourceIndex: Int, ownerToken: Int, memberToken: Int -> Int {
    package.ranges[sourceIndex] => range
    package.sources[sourceIndex] -> len => sourceLength
    package.sources[sourceIndex] -> slice(UIntSize(0), sourceLength) => source
    package.tokens[range.tokenStart + ownerToken] => ownerName
    package.tokens[range.tokenStart + memberToken] => memberName
    -1 => ownerSymbol!
    0 => index!
    index! < range.symbolCount -> while {
        package.symbols[range.symbolStart + index!] => candidate
        (candidate.kind == 3 or candidate.kind == 4) and candidate.parent < 0
            -> if {
                package.tokens[range.tokenStart + candidate.nameToken] => name
                (source -> slice(name.span.start, name.span.length)) == (source -> slice(ownerName.span.start, ownerName.span.length))
                    -> if {
                        index! => ownerSymbol!
                    }
            }
        index! + 1 => index!
    }
    ownerSymbol! < 0 -> if { -1 -> return }
    -1 => result!
    0 => index!
    index! < range.symbolCount -> while {
        package.symbols[range.symbolStart + index!] => method
        (method.kind == 7 or method.kind == 31) and method.parent >= 0
            -> if {
                package.symbols[range.symbolStart + method.parent] => ownerImpl
                ownerImpl.kind == 6 and ownerImpl.astNode >= 0
                    -> if {
                        # A plain impl header is a qualified-name AST, not a Type node.
                        # Require its exact direct child to be one identifier.
                        false => simpleHeader!
                        ownerImpl.astNode + 1 => headerIndex!
                        package.nodes[range.astStart + ownerImpl.astNode] => implAst
                        headerIndex! < range.astCount and package.nodes[range.astStart + headerIndex!].start < implAst.start + implAst.length
                            -> while {
                                package.nodes[range.astStart + headerIndex!] => header
                                header.parent == ownerImpl.astNode and header.kind == 16 and header.firstToken == ownerImpl.nameToken and header.tokenCount == 1
                                    -> if { true => simpleHeader! }
                                headerIndex! + 1 => headerIndex!
                            }
                        simpleHeader! -> if {
                            package.tokens[range.tokenStart + ownerImpl.nameToken] => implName
                            package.tokens[range.tokenStart + method.nameToken] => methodName
                            (source -> slice(implName.span.start, implName.span.length)) == (source -> slice(ownerName.span.start, ownerName.span.length))
                                and (source -> slice(methodName.span.start, methodName.span.length)) == (source -> slice(memberName.span.start, memberName.span.length))
                                -> if {
                                    result! >= 0 -> if { -1 -> return }
                                    index! => result!
                                }
                        }
                    }
            }
        index! + 1 => index!
    }
    result!
}
