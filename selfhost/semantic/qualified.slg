namespace sollang.compiler.semantic.qualified

import sollang.compiler.ast as ast
import sollang.compiler.lexer as lexer
import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.module_resolve as moduleResolve
import sollang.compiler.semantic.modules as modules
import sollang.compiler.semantic.symbols as symbols
import syntax.generated.slg as grammar

public struct QualifiedResolution {
    sourceModule: Int
    pathAst: Int
    targetModule: Int
    targetSymbol: Int
    status: Int
}

# Status: 0 public symbol, 2 missing member, 3 non-public member.
public resolve sources: [Text; ~] -> [QualifiedResolution; ~] {
    sources -> analysis.analyze => package
    package -> resolveAnalyzed
}
public resolveAnalyzed package: analysis.PackageAnalysis -> [QualifiedResolution; ~] {
    package -> modules.identitiesAnalyzed => identities!
    package -> modules.importsAnalyzed => imports!
    package -> moduleResolve.resolveAnalyzed => resolvedImports!
    [QualifiedResolution; ~] => results!
    package.sources -> len => sourceCount
    imports! -> len => importCount
    0 => sourceIndex!
    sourceIndex! < sourceCount -> while {
        package.sources[sourceIndex!] -> len => sourceLength
        package.sources[sourceIndex!] -> slice(UIntSize(0), sourceLength) => source
        package.ranges[sourceIndex!] => sourceRange
        sourceRange.astCount => astCount
        0 => pathAstIndex!
        pathAstIndex! < astCount -> while {
            package.nodes[sourceRange.astStart + pathAstIndex!] => pathAst
            (pathAst.kind == 16 or pathAst.kind == 36) -> if {
                -1 => firstIdentifier!
                -1 => secondIdentifier!
                -1 => previousIdentifier!
                -1 => lastIdentifier!
                0 => identifierCount!
                pathAst.firstToken => pathToken!
                pathAst.firstToken + pathAst.tokenCount => pathEnd!
                pathToken! < pathEnd! -> while {
                    package.tokens[sourceRange.tokenStart + pathToken!].kind == grammar.tokenIdLeftParen -> if { pathToken! => pathEnd! }
                    package.tokens[sourceRange.tokenStart + pathToken!].kind == grammar.tokenIdIdentifier -> if {
                        firstIdentifier! < 0 -> if { pathToken! => firstIdentifier! }
                        identifierCount! == 1 -> if { pathToken! => secondIdentifier! }
                        lastIdentifier! >= 0 -> if { lastIdentifier! => previousIdentifier! }
                        pathToken! => lastIdentifier!
                        identifierCount! + 1 => identifierCount!
                    }
                    pathToken! + 1 => pathToken!
                }
                (firstIdentifier! >= 0 and lastIdentifier! != firstIdentifier!) -> if {
                    false => localVariantResolved!
                    -1 => currentModule!
                    0 => currentModuleSearch!
                    currentModuleSearch! < (identities! -> len) -> while {
                        identities![currentModuleSearch!].sourceIndex == sourceIndex! -> if { currentModuleSearch! => currentModule! }
                        currentModuleSearch! + 1 => currentModuleSearch!
                    }
                    (currentModule! >= 0 and previousIdentifier! >= 0) -> if {
                        0 => nativeHandleSearch!
                        nativeHandleSearch! < sourceRange.symbolCount -> while {
                            package.symbols[sourceRange.symbolStart + nativeHandleSearch!] => nativeHandle
                            (nativeHandle.kind == 3
                                and nativeHandle.flags / 65536 % 2 == 1
                                and nativeHandle.astNode >= 0) -> if {
                                package.nodes[sourceRange.astStart + nativeHandle.astNode] => nativeHandleAst
                                nativeHandleAst.parent >= 0 -> if {
                                    package.nodes[sourceRange.astStart + nativeHandleAst.parent] => nativeHandleLibraryAst
                                    (nativeHandleLibraryAst.kind == 65
                                        and nativeHandleLibraryAst.payloadToken >= 0
                                        and nativeHandle.nameToken >= 0) -> if {
                                        package.tokens[sourceRange.tokenStart + nativeHandleLibraryAst.payloadToken] => nativeHandleAliasName
                                        package.tokens[sourceRange.tokenStart + firstIdentifier!] => nativeHandleAliasReference
                                        nativeHandleAliasName.span.length == nativeHandleAliasReference.span.length => nativeHandleAliasEqual!
                                        UIntSize(0) => nativeHandleAliasByte!
                                        (nativeHandleAliasEqual! and nativeHandleAliasByte! < nativeHandleAliasName.span.length) -> while {
                                            (source -> byte(nativeHandleAliasName.span.start + nativeHandleAliasByte!)) != (source -> byte(nativeHandleAliasReference.span.start + nativeHandleAliasByte!)) -> if {
                                                false => nativeHandleAliasEqual!
                                            }
                                            nativeHandleAliasByte! + UIntSize(1) => nativeHandleAliasByte!
                                        }
                                        package.tokens[sourceRange.tokenStart + nativeHandle.nameToken] => nativeHandleName
                                        package.tokens[sourceRange.tokenStart + lastIdentifier!] => nativeHandleReference
                                        nativeHandleName.span.length == nativeHandleReference.span.length => nativeHandleEqual!
                                        UIntSize(0) => nativeHandleByte!
                                        (nativeHandleEqual! and nativeHandleByte! < nativeHandleName.span.length) -> while {
                                            (source -> byte(nativeHandleName.span.start + nativeHandleByte!)) != (source -> byte(nativeHandleReference.span.start + nativeHandleByte!)) -> if {
                                                false => nativeHandleEqual!
                                            }
                                            nativeHandleByte! + UIntSize(1) => nativeHandleByte!
                                        }
                                        (nativeHandleAliasEqual! and nativeHandleEqual!) -> if {
                                            results! -> push(QualifiedResolution {
                                                sourceModule: sourceIndex!
                                                pathAst: pathAstIndex!
                                                targetModule: currentModule!
                                                targetSymbol: nativeHandleSearch!
                                                status: 0
                                            })
                                            true => localVariantResolved!
                                            sourceRange.symbolCount => nativeHandleSearch!
                                        }
                                    }
                                }
                            }
                            nativeHandleSearch! + 1 => nativeHandleSearch!
                        }
                        0 => nativeFunctionSearch!
                        localVariantResolved! -> if { sourceRange.symbolCount => nativeFunctionSearch! }
                        nativeFunctionSearch! < sourceRange.symbolCount -> while {
                            package.symbols[sourceRange.symbolStart + nativeFunctionSearch!] => nativeFunction
                            (nativeFunction.kind == 7 and nativeFunction.flags / 128 % 2 == 1 and nativeFunction.astNode >= 0) -> if {
                                package.nodes[sourceRange.astStart + nativeFunction.astNode] => nativeFunctionAst
                                nativeFunctionAst.parent >= 0 -> if {
                                    package.nodes[sourceRange.astStart + nativeFunctionAst.parent] => nativeLibraryAst
                                    (nativeLibraryAst.kind == 65 and nativeLibraryAst.payloadToken >= 0 and nativeFunction.nameToken >= 0) -> if {
                                        package.tokens[sourceRange.tokenStart + nativeLibraryAst.payloadToken] => nativeAliasName
                                        package.tokens[sourceRange.tokenStart + firstIdentifier!] => nativeAliasReference
                                        nativeAliasName.span.length == nativeAliasReference.span.length => nativeAliasEqual!
                                        UIntSize(0) => nativeAliasByte!
                                        (nativeAliasEqual! and nativeAliasByte! < nativeAliasName.span.length) -> while {
                                            (source -> byte(nativeAliasName.span.start + nativeAliasByte!)) != (source -> byte(nativeAliasReference.span.start + nativeAliasByte!)) -> if { false => nativeAliasEqual! }
                                            nativeAliasByte! + UIntSize(1) => nativeAliasByte!
                                        }
                                        package.tokens[sourceRange.tokenStart + nativeFunction.nameToken] => nativeFunctionName
                                        package.tokens[sourceRange.tokenStart + lastIdentifier!] => nativeFunctionReference
                                        nativeFunctionName.span.length == nativeFunctionReference.span.length => nativeFunctionEqual!
                                        UIntSize(0) => nativeFunctionByte!
                                        (nativeFunctionEqual! and nativeFunctionByte! < nativeFunctionName.span.length) -> while {
                                            (source -> byte(nativeFunctionName.span.start + nativeFunctionByte!)) != (source -> byte(nativeFunctionReference.span.start + nativeFunctionByte!)) -> if { false => nativeFunctionEqual! }
                                            nativeFunctionByte! + UIntSize(1) => nativeFunctionByte!
                                        }
                                        (nativeAliasEqual! and nativeFunctionEqual!) -> if {
                                            QualifiedResolution { sourceModule: sourceIndex!, pathAst: pathAstIndex!, targetModule: currentModule!, targetSymbol: nativeFunctionSearch!, status: 0 } => nativeResult
                                            results! -> push(nativeResult)
                                            true => localVariantResolved!
                                            sourceRange.symbolCount => nativeFunctionSearch!
                                        }
                                    }
                                }
                            }
                            nativeFunctionSearch! + 1 => nativeFunctionSearch!
                        }
                        0 => comFunctionSearch!
                        localVariantResolved! -> if { sourceRange.symbolCount => comFunctionSearch! }
                        comFunctionSearch! < sourceRange.symbolCount -> while {
                            package.symbols[sourceRange.symbolStart + comFunctionSearch!] => comFunction
                            ((comFunction.kind == 7 or comFunction.kind == 36)
                                and comFunction.flags / 512 % 2 == 1
                                and comFunction.parent >= 0) -> if {
                                package.symbols[sourceRange.symbolStart + comFunction.parent] => comInterfaceSymbol
                                package.nodes[sourceRange.astStart + comInterfaceSymbol.astNode] => comInterfaceAst
                                comInterfaceAst.parent >= 0 -> if {
                                    package.nodes[sourceRange.astStart + comInterfaceAst.parent] => comClassAst
                                    package.tokens[sourceRange.tokenStart + comClassAst.payloadToken] => comAliasName
                                    package.tokens[sourceRange.tokenStart + firstIdentifier!] => comAliasReference
                                    comAliasName.span.length == comAliasReference.span.length => comAliasEqual!
                                    UIntSize(0) => comAliasByte!
                                    (comAliasEqual! and comAliasByte! < comAliasName.span.length) -> while {
                                        (source -> byte(comAliasName.span.start + comAliasByte!)) != (source -> byte(comAliasReference.span.start + comAliasByte!)) -> if { false => comAliasEqual! }
                                        comAliasByte! + UIntSize(1) => comAliasByte!
                                    }
                                    false => comFunctionEqual!
                                    package.tokens[sourceRange.tokenStart + lastIdentifier!] => comFunctionReference
                                    comFunction.flags / 131072 % 2 == 1 -> if {
                                        package.symbols[sourceRange.symbolStart + comFunction.parent] => comQuerySource
                                        package.symbols[sourceRange.symbolStart + comFunction.secondaryTypeNode] => comQueryTarget
                                        package.tokens[sourceRange.tokenStart + comQuerySource.nameToken] => comQuerySourceName
                                        package.tokens[sourceRange.tokenStart + comQueryTarget.nameToken] => comQueryTargetName
                                        UIntSize(9) + comQuerySourceName.span.length + comQueryTargetName.span.length => comQueryLength
                                        comFunctionReference.span.length == comQueryLength -> if {
                                            true => comFunctionEqual!
                                            UIntSize(0) => comQueryByte!
                                            "query" => comQueryPrefix
                                            (comFunctionEqual! and comQueryByte! < UIntSize(5)) -> while {
                                                (source -> byte(comFunctionReference.span.start + comQueryByte!)) != (comQueryPrefix -> byte(comQueryByte!)) -> if { false => comFunctionEqual! }
                                                comQueryByte! + UIntSize(1) => comQueryByte!
                                            }
                                            UIntSize(0) => comQueryTargetByte!
                                            (comFunctionEqual! and comQueryTargetByte! < comQueryTargetName.span.length) -> while {
                                                (source -> byte(comFunctionReference.span.start + UIntSize(5) + comQueryTargetByte!)) != (source -> byte(comQueryTargetName.span.start + comQueryTargetByte!)) -> if { false => comFunctionEqual! }
                                                comQueryTargetByte! + UIntSize(1) => comQueryTargetByte!
                                            }
                                            "From" => comQueryFrom
                                            UIntSize(0) => comQueryFromByte!
                                            (comFunctionEqual! and comQueryFromByte! < UIntSize(4)) -> while {
                                                (source -> byte(comFunctionReference.span.start + UIntSize(5) + comQueryTargetName.span.length + comQueryFromByte!)) != (comQueryFrom -> byte(comQueryFromByte!)) -> if { false => comFunctionEqual! }
                                                comQueryFromByte! + UIntSize(1) => comQueryFromByte!
                                            }
                                            UIntSize(0) => comQuerySourceByte!
                                            (comFunctionEqual! and comQuerySourceByte! < comQuerySourceName.span.length) -> while {
                                                (source -> byte(comFunctionReference.span.start + UIntSize(9) + comQueryTargetName.span.length + comQuerySourceByte!)) != (source -> byte(comQuerySourceName.span.start + comQuerySourceByte!)) -> if { false => comFunctionEqual! }
                                                comQuerySourceByte! + UIntSize(1) => comQuerySourceByte!
                                            }
                                        }
                                    } else {
                                    comFunction.flags / 4096 % 2 == 1 -> if {
                                        comFunctionReference.span.length == UIntSize(6) -> if {
                                            "create" => comCreateName
                                            true => comFunctionEqual!
                                            UIntSize(0) => comCreateByte!
                                            (comFunctionEqual! and comCreateByte! < comFunctionReference.span.length) -> while {
                                                (source -> byte(comFunctionReference.span.start + comCreateByte!)) != (comCreateName -> byte(comCreateByte!)) -> if { false => comFunctionEqual! }
                                                comCreateByte! + UIntSize(1) => comCreateByte!
                                            }
                                        }
                                    } else {
                                        comFunction.flags / 8192 % 2 == 1 -> if {
                                            comFunctionReference.span.length == UIntSize(5) -> if {
                                                "clone" => comCloneName
                                                true => comFunctionEqual!
                                                UIntSize(0) => comCloneByte!
                                                (comFunctionEqual! and comCloneByte! < comFunctionReference.span.length) -> while {
                                                    (source -> byte(comFunctionReference.span.start + comCloneByte!)) != (comCloneName -> byte(comCloneByte!)) -> if { false => comFunctionEqual! }
                                                    comCloneByte! + UIntSize(1) => comCloneByte!
                                                }
                                            }
                                        } else {
                                            package.tokens[sourceRange.tokenStart + comFunction.nameToken] => comMethodName
                                            comMethodName.span.length == comFunctionReference.span.length => comFunctionEqual!
                                            UIntSize(0) => comMethodByte!
                                            (comFunctionEqual! and comMethodByte! < comMethodName.span.length) -> while {
                                                (source -> byte(comMethodName.span.start + comMethodByte!)) != (source -> byte(comFunctionReference.span.start + comMethodByte!)) -> if { false => comFunctionEqual! }
                                                comMethodByte! + UIntSize(1) => comMethodByte!
                                            }
                                        }
                                    }
                                    }
                                    (comAliasEqual!
                                        and comFunctionEqual!
                                        and (comFunction.flags / 4096 % 2 == 1
                                            or comFunction.flags / 8192 % 2 == 1
                                            or comFunction.flags / 131072 % 2 == 1
                                            or pathAst.kind == 16)) -> if {
                                        results! -> push(QualifiedResolution {
                                            sourceModule: sourceIndex!
                                            pathAst: pathAstIndex!
                                            targetModule: currentModule!
                                            targetSymbol: comFunctionSearch!
                                            status: 0
                                        })
                                        true => localVariantResolved!
                                        sourceRange.symbolCount => comFunctionSearch!
                                    }
                                }
                            }
                            comFunctionSearch! + 1 => comFunctionSearch!
                        }
                        0 => localEnumSearch!
                        localVariantResolved! -> if { sourceRange.symbolCount => localEnumSearch! }
                        localEnumSearch! < sourceRange.symbolCount -> while {
                            package.symbols[sourceRange.symbolStart + localEnumSearch!] => localEnum
                            (localEnum.kind == 4 and localEnum.parent < 0) -> if {
                                package.tokens[sourceRange.tokenStart + localEnum.nameToken] => localEnumName
                                package.tokens[sourceRange.tokenStart + previousIdentifier!] => localEnumReference
                                localEnumName.span.length == localEnumReference.span.length => localEnumEqual!
                                UIntSize(0) => localEnumByte!
                                (localEnumEqual! and localEnumByte! < localEnumName.span.length) -> while {
                                    (source -> byte(localEnumName.span.start + localEnumByte!)) != (source -> byte(localEnumReference.span.start + localEnumByte!)) -> if { false => localEnumEqual! }
                                    localEnumByte! + UIntSize(1) => localEnumByte!
                                }
                                localEnumEqual! -> if {
                                    0 => localVariantSearch!
                                    localVariantSearch! < sourceRange.symbolCount -> while {
                                        package.symbols[sourceRange.symbolStart + localVariantSearch!] => localVariant
                                        (localVariant.kind == 27 and localVariant.parent == localEnumSearch!) -> if {
                                            package.tokens[sourceRange.tokenStart + localVariant.nameToken] => localVariantName
                                            package.tokens[sourceRange.tokenStart + lastIdentifier!] => localVariantReference
                                            localVariantName.span.length == localVariantReference.span.length => localVariantEqual!
                                            UIntSize(0) => localVariantByte!
                                            (localVariantEqual! and localVariantByte! < localVariantName.span.length) -> while {
                                                (source -> byte(localVariantName.span.start + localVariantByte!)) != (source -> byte(localVariantReference.span.start + localVariantByte!)) -> if { false => localVariantEqual! }
                                                localVariantByte! + UIntSize(1) => localVariantByte!
                                            }
                                            localVariantEqual! -> if {
                                                QualifiedResolution { sourceModule: sourceIndex!, pathAst: pathAstIndex!, targetModule: currentModule!, targetSymbol: localVariantSearch!, status: 0 } => localResult
                                                results! -> push(localResult)
                                                true => localVariantResolved!
                                                sourceRange.symbolCount => localVariantSearch!
                                            }
                                        }
                                        localVariantSearch! + 1 => localVariantSearch!
                                    }
                                }
                            }
                            localEnumSearch! + 1 => localEnumSearch!
                        }
                    }
                    # Native library aliases are declarations rather than
                    # imported module aliases. A logical module may span
                    # several source fragments, so resolve a qualified native
                    # function or handle against sibling fragments before
                    # consulting explicit imports.
                    (not localVariantResolved! and currentModule! >= 0) -> if {
                        identities![currentModule!].pathHash => currentPathHash
                        0 => siblingModuleIndex!
                        siblingModuleIndex! < (identities! -> len) -> while {
                            identities![siblingModuleIndex!] => siblingIdentity
                            (siblingIdentity.sourceIndex != sourceIndex! and siblingIdentity.pathHash == currentPathHash) -> if {
                                siblingIdentity.sourceIndex => siblingSourceIndex
                                package.sources[siblingSourceIndex] -> len => siblingSourceLength
                                package.sources[siblingSourceIndex] -> slice(UIntSize(0), siblingSourceLength) => siblingSource
                                package.ranges[siblingSourceIndex] => siblingRange
                                0 => siblingSymbolIndex!
                                siblingSymbolIndex! < siblingRange.symbolCount -> while {
                                    package.symbols[siblingRange.symbolStart + siblingSymbolIndex!] => siblingSymbol
                                    ((siblingSymbol.kind == 3 and siblingSymbol.flags / 65536 % 2 == 1)
                                        or (siblingSymbol.kind == 7 and siblingSymbol.flags / 128 % 2 == 1)) -> if {
                                        package.nodes[siblingRange.astStart + siblingSymbol.astNode] => siblingDeclaration
                                        siblingDeclaration.parent >= 0 -> if {
                                            package.nodes[siblingRange.astStart + siblingDeclaration.parent] => siblingLibrary
                                            (siblingLibrary.kind == 65
                                                and siblingLibrary.payloadToken >= 0
                                                and siblingSymbol.nameToken >= 0) -> if {
                                                package.tokens[siblingRange.tokenStart + siblingLibrary.payloadToken] => siblingAliasName
                                                package.tokens[sourceRange.tokenStart + firstIdentifier!] => siblingAliasReference
                                                siblingAliasName.span.length == siblingAliasReference.span.length => siblingAliasEqual!
                                                UIntSize(0) => siblingAliasByte!
                                                (siblingAliasEqual! and siblingAliasByte! < siblingAliasName.span.length) -> while {
                                                    (siblingSource -> byte(siblingAliasName.span.start + siblingAliasByte!)) != (source -> byte(siblingAliasReference.span.start + siblingAliasByte!)) -> if {
                                                        false => siblingAliasEqual!
                                                    }
                                                    siblingAliasByte! + UIntSize(1) => siblingAliasByte!
                                                }
                                                package.tokens[siblingRange.tokenStart + siblingSymbol.nameToken] => siblingMemberName
                                                package.tokens[sourceRange.tokenStart + lastIdentifier!] => siblingMemberReference
                                                siblingMemberName.span.length == siblingMemberReference.span.length => siblingMemberEqual!
                                                UIntSize(0) => siblingMemberByte!
                                                (siblingMemberEqual! and siblingMemberByte! < siblingMemberName.span.length) -> while {
                                                    (siblingSource -> byte(siblingMemberName.span.start + siblingMemberByte!)) != (source -> byte(siblingMemberReference.span.start + siblingMemberByte!)) -> if {
                                                        false => siblingMemberEqual!
                                                    }
                                                    siblingMemberByte! + UIntSize(1) => siblingMemberByte!
                                                }
                                                (siblingAliasEqual! and siblingMemberEqual!) -> if {
                                                    results! -> push(QualifiedResolution {
                                                        sourceModule: sourceIndex!
                                                        pathAst: pathAstIndex!
                                                        targetModule: siblingModuleIndex!
                                                        targetSymbol: siblingSymbolIndex!
                                                        status: 0
                                                    })
                                                    true => localVariantResolved!
                                                    siblingRange.symbolCount => siblingSymbolIndex!
                                                    identities! -> len => siblingModuleIndex!
                                                }
                                            }
                                        }
                                    }
                                    siblingSymbolIndex! + 1 => siblingSymbolIndex!
                                }
                            }
                            siblingModuleIndex! + 1 => siblingModuleIndex!
                        }
                    }
                    0 => edgeIndex!
                    localVariantResolved! -> if { importCount => edgeIndex! }
                    edgeIndex! < importCount -> while {
                        imports![edgeIndex!] => edge
                        resolvedImports![edgeIndex!] => resolvedImport
                        (edge.sourceModule == sourceIndex! and resolvedImport.status == 0) -> if {
                            package.tokens[sourceRange.tokenStart + edge.aliasToken] => aliasName
                            package.tokens[sourceRange.tokenStart + firstIdentifier!] => pathAlias
                            aliasName.span.length == pathAlias.span.length => aliasEqual!
                            UIntSize(0) => aliasByte!
                            (aliasEqual! and aliasByte! < aliasName.span.length) -> while {
                                source -> byte(aliasName.span.start + aliasByte!) => aliasLeftByte
                                source -> byte(pathAlias.span.start + aliasByte!) => aliasRightByte
                                aliasLeftByte != aliasRightByte -> if { false => aliasEqual! }
                                aliasByte! + UIntSize(1) => aliasByte!
                            }
                            aliasEqual! -> if {
                                resolvedImport.targetModule => targetModule
                                targetModule => selectedTargetModule!
                                identities![targetModule].sourceIndex => targetSourceIndex
                                package.sources[targetSourceIndex] -> len => targetSourceLength
                                package.sources[targetSourceIndex] -> slice(UIntSize(0), targetSourceLength) => targetSource
                                package.ranges[targetSourceIndex] => targetRange
                                -1 => targetSymbol!
                                false => targetPublic!
                                0 => symbolIndex!
                                symbolIndex! < targetRange.symbolCount -> while {
                                    package.symbols[targetRange.symbolStart + symbolIndex!] => candidate
                                    # An impl header repeats its target type's name, but it is
                                    # not an exported namespace member. Without this filter a
                                    # later `impl SourceSpan` shadows the public `SourceSpan`
                                    # declaration during qualified type resolution.
                                    (candidate.parent < 0 and candidate.kind != 6) -> if {
                                        package.tokens[targetRange.tokenStart + candidate.nameToken] => candidateName
                                        lastIdentifier! => topLevelIdentifier!
                                        identifierCount! >= 3 -> if { secondIdentifier! => topLevelIdentifier! }
                                        package.tokens[sourceRange.tokenStart + topLevelIdentifier!] => memberName
                                        candidateName.span.length == memberName.span.length => memberEqual!
                                        UIntSize(0) => memberByte!
                                        (memberEqual! and memberByte! < candidateName.span.length) -> while {
                                            targetSource -> byte(candidateName.span.start + memberByte!) => memberLeftByte
                                            source -> byte(memberName.span.start + memberByte!) => memberRightByte
                                            memberLeftByte != memberRightByte -> if { false => memberEqual! }
                                            memberByte! + UIntSize(1) => memberByte!
                                        }
                                        memberEqual! -> if {
                                            identifierCount! >= 3 -> if {
                                                candidate.kind == 4 -> if {
                                                    0 => nestedSymbolIndex!
                                                    nestedSymbolIndex! < targetRange.symbolCount -> while {
                                                        package.symbols[targetRange.symbolStart + nestedSymbolIndex!] => nestedCandidate
                                                        nestedCandidate.parent == symbolIndex! -> if {
                                                            package.tokens[targetRange.tokenStart + nestedCandidate.nameToken] => nestedName
                                                            package.tokens[sourceRange.tokenStart + lastIdentifier!] => nestedMemberName
                                                            nestedName.span.length == nestedMemberName.span.length => nestedEqual!
                                                            UIntSize(0) => nestedByte!
                                                            (nestedEqual! and nestedByte! < nestedName.span.length) -> while {
                                                                targetSource -> byte(nestedName.span.start + nestedByte!) => nestedLeftByte
                                                                source -> byte(nestedMemberName.span.start + nestedByte!) => nestedRightByte
                                                                nestedLeftByte != nestedRightByte -> if { false => nestedEqual! }
                                                                nestedByte! + UIntSize(1) => nestedByte!
                                                            }
                                                            nestedEqual! -> if {
                                                                nestedSymbolIndex! => targetSymbol!
                                                                candidate.flags >= 4 -> if { true => targetPublic! }
                                                            }
                                                        }
                                                        nestedSymbolIndex! + 1 => nestedSymbolIndex!
                                                    }
                                                }
                                            } else {
                                                symbolIndex! => targetSymbol!
                                                candidate.flags >= 4 -> if { true => targetPublic! }
                                            }
                                        }
                                    }
                                    symbolIndex! + 1 => symbolIndex!
                                }
                                # The import facade is the first source of a
                                # logical module. If a top-level member lives
                                # in another source fragment, continue the
                                # lookup across identities with the same path.
                                (targetSymbol! < 0 and identifierCount! < 3) -> if {
                                    identities![targetModule].pathHash => targetPathHash
                                    0 => fragmentModuleIndex!
                                    fragmentModuleIndex! < (identities! -> len) -> while {
                                        identities![fragmentModuleIndex!] => fragmentIdentity
                                        (fragmentIdentity.pathHash == targetPathHash and fragmentModuleIndex! != targetModule) -> if {
                                            fragmentIdentity.sourceIndex => fragmentSourceIndex
                                            package.sources[fragmentSourceIndex] -> len => fragmentSourceLength
                                            package.sources[fragmentSourceIndex] -> slice(UIntSize(0), fragmentSourceLength) => fragmentSource
                                            package.ranges[fragmentSourceIndex] => fragmentRange
                                            0 => fragmentSymbolIndex!
                                            fragmentSymbolIndex! < fragmentRange.symbolCount -> while {
                                                package.symbols[fragmentRange.symbolStart + fragmentSymbolIndex!] => fragmentCandidate
                                                (fragmentCandidate.parent < 0 and fragmentCandidate.kind != 6) -> if {
                                                    package.tokens[fragmentRange.tokenStart + fragmentCandidate.nameToken] => fragmentCandidateName
                                                    package.tokens[sourceRange.tokenStart + lastIdentifier!] => fragmentMemberName
                                                    fragmentCandidateName.span.length == fragmentMemberName.span.length => fragmentMemberEqual!
                                                    UIntSize(0) => fragmentMemberByte!
                                                    (fragmentMemberEqual! and fragmentMemberByte! < fragmentCandidateName.span.length) -> while {
                                                        (fragmentSource -> byte(fragmentCandidateName.span.start + fragmentMemberByte!)) != (source -> byte(fragmentMemberName.span.start + fragmentMemberByte!)) -> if {
                                                            false => fragmentMemberEqual!
                                                        }
                                                        fragmentMemberByte! + UIntSize(1) => fragmentMemberByte!
                                                    }
                                                    fragmentMemberEqual! -> if {
                                                        fragmentSymbolIndex! => targetSymbol!
                                                        fragmentCandidate.flags >= 4 -> if { true => targetPublic! }
                                                        fragmentModuleIndex! => selectedTargetModule!
                                                    }
                                                }
                                                fragmentSymbolIndex! + 1 => fragmentSymbolIndex!
                                            }
                                        }
                                        fragmentModuleIndex! + 1 => fragmentModuleIndex!
                                    }
                                }
                                2 => status!
                                targetSymbol! >= 0 -> if {
                                    targetPublic! -> if { 0 => status! } else { 3 => status! }
                                }
                                QualifiedResolution {
                                    sourceModule: sourceIndex!
                                    pathAst: pathAstIndex!
                                    targetModule: selectedTargetModule!
                                    targetSymbol: targetSymbol!
                                    status: status!
                                } => result
                                results! -> push(result)
                                importCount => edgeIndex!
                            } else {
                                edgeIndex! + 1 => edgeIndex!
                            }
                        } else {
                            edgeIndex! + 1 => edgeIndex!
                        }
                    }
                }
            }
            pathAstIndex! + 1 => pathAstIndex!
        }
        sourceIndex! + 1 => sourceIndex!
    }
    results!
}
