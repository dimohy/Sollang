                                                            comFunctionReference.span.length == 6 -> if {
                                                                "create" => comCreateName
                                                                true => comFunctionEqual!
                                                                UIntSize(0) => comCreateByte!
                                                                comFunctionEqual! and comCreateByte! < comFunctionReference.span.length
                                                                    -> while {
                                                                        (source -> byte(comFunctionReference.span.start + comCreateByte!)) != (comCreateName -> byte(comCreateByte!))
                                                                            -> if { false => comFunctionEqual! }
                                                                        comCreateByte! + 1 => comCreateByte!
                                                                    }
                                                            }
                                                        } else {
                                                            comFunction.flags / 8192 % 2 == 1 -> if {
                                                                comFunctionReference.span.length == 5 -> if {
                                                                    "clone" => comCloneName
                                                                    true => comFunctionEqual!
                                                                    UIntSize(0) => comCloneByte!
                                                                    comFunctionEqual! and comCloneByte! < comFunctionReference.span.length
                                                                        -> while {
                                                                            (source -> byte(comFunctionReference.span.start + comCloneByte!)) != (comCloneName -> byte(comCloneByte!))
                                                                                -> if { false => comFunctionEqual! }
                                                                            comCloneByte! + 1 => comCloneByte!
                                                                        }
                                                                }
                                                            } else {
                                                                package.tokens[sourceRange.tokenStart + comFunction.nameToken] => comMethodName
                                                                comMethodName.span.length == comFunctionReference.span.length => comFunctionEqual!
                                                                UIntSize(0) => comMethodByte!
                                                                comFunctionEqual! and comMethodByte! < comMethodName.span.length
                                                                    -> while {
                                                                        (source -> byte(comMethodName.span.start + comMethodByte!)) != (source -> byte(comFunctionReference.span.start + comMethodByte!))
                                                                            -> if { false => comFunctionEqual! }
                                                                        comMethodByte! + 1 => comMethodByte!
                                                                    }
                                                            }
                                                        }
                                                    }
                                                    comAliasEqual!
                                                        and comFunctionEqual!
                                                        and (comFunction.flags / 4096 % 2 == 1
                                                        or comFunction.flags / 8192 % 2 == 1
                                                        or comFunction.flags / 131072 % 2 == 1
                                                        or pathAst.kind == 16) -> if {
                                                            results! -> push(QualifiedResolution {
                                                                sourceModule: sourceIndex!
                                                                pathAst: pathAstIndex!
                                                                targetModule: currentModule!
                                                                targetSymbol: comFunctionSearch!
                                                                status: 0
