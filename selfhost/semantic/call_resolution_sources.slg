namespace sollang.compiler.semantic.calls

import sollang.compiler.ast as ast
import sollang.compiler.lexer as lexer
import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.module_resolve as moduleResolve
import sollang.compiler.semantic.modules as modules
import sollang.compiler.semantic.qualified as qualified
import sollang.compiler.semantic.symbols as symbols
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.syntax as syntax
import syntax.generated.slg as grammar

# Per-source typed call resolution extracted from resolveModulesTyped.
# Each invocation owns its candidate/result arrays and borrows global indexes.

resolveSourceTyped sourceIndex: Int, package: ref analysis.PackageAnalysis, semantic: ref typeIds.SemanticTypeSet, identities: ref [modules.ModuleIdentity; ~], resolvedImports: ref [moduleResolve.ResolvedImport; ~], qualifiedResults: ref [qualified.QualifiedResolution; ~], declaredIntrinsicNames: ref [DeclaredMethodName; ~] -> [ModuleCallResolution; ~] {
    [ModuleCallResolution; ~] => results!
    package.sources[sourceIndex] -> len => sourceLength
    package.sources[sourceIndex] -> slice(UIntSize(0), sourceLength) => source
    package.ranges[sourceIndex] => sourceRange
    [TypedCallCandidate; ~] => localCalls!
    package.nodes -> indexQualifiedPathCallOwners(sourceRange.astStart, sourceRange.astCount) => qualifiedPathCallOwners
    # Index the final Path child of every AST owner once. For an impl this
    # is its nominal target (or the target after `for` for a trait impl),
    # which is the authoritative type of each synthetic `self` binding.
    [Int; ~] => moduleLastPathChildByAst!
    [UIntSize; ~] => moduleLastPathStartByAst!
    0 => moduleLastPathSeed!
    moduleLastPathSeed! < sourceRange.astCount
        -> while {
            moduleLastPathChildByAst! -> push(-1)
            moduleLastPathStartByAst! -> push(0)
            moduleLastPathSeed! + 1 => moduleLastPathSeed!
        }
    0 => moduleLastPathCandidateIndex!
    moduleLastPathCandidateIndex! < sourceRange.astCount
        -> while {
            package.nodes[sourceRange.astStart + moduleLastPathCandidateIndex!]
                => moduleLastPathCandidate
            moduleLastPathCandidate.kind == 16
                and moduleLastPathCandidate.parent >= 0
                and moduleLastPathCandidate.parent < sourceRange.astCount
                and (moduleLastPathChildByAst![moduleLastPathCandidate.parent] < 0
                or moduleLastPathCandidate.start > moduleLastPathStartByAst![moduleLastPathCandidate.parent])
                -> if {
                    moduleLastPathCandidateIndex!
                        => moduleLastPathChildByAst![moduleLastPathCandidate.parent]
                    moduleLastPathCandidate.start
                        => moduleLastPathStartByAst![moduleLastPathCandidate.parent]
                }
            moduleLastPathCandidateIndex! + 1
                => moduleLastPathCandidateIndex!
        }
    # Build the flow-target index once per source. Previously each possible
    # call scanned the complete AST repeatedly, which was quadratic and
    # made the complete compiler graph spend tens of minutes here.
    [Int; ~] => moduleFlowNameTokens!
    [Int; ~] => moduleFlowCallChildByParent!
    0 => moduleFlowIndexBuild!
    moduleFlowIndexBuild! < sourceRange.astCount
        -> while {
            moduleFlowNameTokens! -> push(-1)
            moduleFlowCallChildByParent! -> push(-1)
            moduleFlowIndexBuild! + 1 => moduleFlowIndexBuild!
        }
    0 => moduleFlowCallChildIndex!
    moduleFlowCallChildIndex! < sourceRange.astCount
        -> while {
            package.nodes[sourceRange.astStart + moduleFlowCallChildIndex!]
                => moduleFlowCallChild
            moduleFlowCallChild.kind == 10
                and moduleFlowCallChild.parent >= 0
                and moduleFlowCallChild.parent < sourceRange.astCount
                -> if {
                    moduleFlowCallChild.parent => moduleFlowCallParent
                    moduleFlowCallChildIndex! => moduleFlowCallChildByParent![moduleFlowCallParent]
                }
            moduleFlowCallChildIndex! + 1 => moduleFlowCallChildIndex!
        }
    0 => moduleFlowChildIndex!
    moduleFlowChildIndex! < sourceRange.astCount
        -> while {
            package.nodes[sourceRange.astStart + moduleFlowChildIndex!] => moduleFlowChild
            moduleFlowChild.kind == 16 and moduleFlowChild.parent >= 0 and moduleFlowChild.parent < sourceRange.astCount
                -> if {
                    -1 => indexedFlowNameToken!
                    moduleFlowChild.firstToken => indexedFlowPathToken!
                    moduleFlowChild.firstToken + moduleFlowChild.tokenCount => indexedFlowPathEnd!
                    indexedFlowPathToken! < indexedFlowPathEnd! -> while {
                        package.tokens[sourceRange.tokenStart + indexedFlowPathToken!]
                            => indexedFlowPathPart
                        indexedFlowPathPart.kind == grammar.tokenIdLeftParen()
                            -> if {
                                indexedFlowPathToken! => indexedFlowPathEnd!
                            } else {
                                indexedFlowPathPart.kind == grammar.tokenIdIdentifier()
                                    -> if {
                                        indexedFlowPathToken! => indexedFlowNameToken!
                                    }
                                indexedFlowPathToken! + 1 => indexedFlowPathToken!
                            }
                    }
                    moduleFlowChild.parent => indexedFlowOwner!
                    package.nodes[sourceRange.astStart + indexedFlowOwner!].kind == 11
                        and package.nodes[sourceRange.astStart + indexedFlowOwner!].cstRuleId != grammar.ruleIdCallExpression()
                        and package.nodes[sourceRange.astStart + indexedFlowOwner!].cstRuleId != grammar.ruleIdTypeApplicationExpression()
                        and moduleFlowCallChildByParent![indexedFlowOwner!] >= 0
                        -> if {
                            moduleFlowCallChildByParent![indexedFlowOwner!]
                                => indexedFlowOwner!
                        }
                    indexedFlowNameToken! > moduleFlowNameTokens![indexedFlowOwner!]
                        -> if {
                            indexedFlowNameToken! => moduleFlowNameTokens![indexedFlowOwner!]
                        }
                }
            moduleFlowChildIndex! + 1 => moduleFlowChildIndex!
        }
    0 => callAstIndex!
    callAstIndex! < sourceRange.astCount -> while {
        package.nodes[sourceRange.astStart + callAstIndex!] => callNode
        moduleFlowNameTokens![callAstIndex!] >= 0 => moduleHasFlowCallTarget
        false => moduleHasQualifiedCallTarget!
        0 => moduleQualifiedCallSearch!
        moduleQualifiedCallSearch! < (qualifiedResults -> len)
            -> while {
                qualifiedResults[moduleQualifiedCallSearch!] => moduleQualifiedCall
                moduleQualifiedCall.sourceModule == sourceIndex
                    and moduleQualifiedCall.pathAst >= 0
                    and moduleQualifiedCall.pathAst < sourceRange.astCount
                    and package.nodes[sourceRange.astStart + moduleQualifiedCall.pathAst].kind == 36
                    and ((package.nodes[sourceRange.astStart + moduleQualifiedCall.pathAst].parent == callAstIndex! and qualifiedPathCallOwners[moduleQualifiedCall.pathAst] < 0)
                    or qualifiedPathCallOwners[moduleQualifiedCall.pathAst] == callAstIndex!)
                    -> if {
                        false => moduleQualifiedTargetCallable!
                        moduleQualifiedCall.status == 0
                            and moduleQualifiedCall.targetModule >= 0
                            and moduleQualifiedCall.targetModule < (identities -> len)
                            -> if {
                                identities[moduleQualifiedCall.targetModule].sourceIndex => moduleQualifiedTargetSource
                                moduleQualifiedTargetSource >= 0 and moduleQualifiedTargetSource < (package.ranges -> len)
                                    -> if {
                                        package.ranges[moduleQualifiedTargetSource] => moduleQualifiedTargetRange
                                        moduleQualifiedCall.targetSymbol >= 0 and moduleQualifiedCall.targetSymbol < moduleQualifiedTargetRange.symbolCount
                                            -> if {
                                                package.symbols[moduleQualifiedTargetRange.symbolStart + moduleQualifiedCall.targetSymbol].kind => moduleQualifiedTargetKind
                                                moduleQualifiedTargetKind == 7 or moduleQualifiedTargetKind == 31 or moduleQualifiedTargetKind == 36
                                                    -> if {
                                                        true => moduleQualifiedTargetCallable!
                                                    }
                                            }
                                    }
                            }
                        moduleQualifiedTargetCallable!
                            -> if { true => moduleHasQualifiedCallTarget! }
                    }
                moduleQualifiedCallSearch! + 1 => moduleQualifiedCallSearch!
            }
        false => moduleHasGeneratedComTarget!
        0 => moduleComQualifiedSearch!
        moduleComQualifiedSearch! < (qualifiedResults -> len)
            -> while {
                qualifiedResults[moduleComQualifiedSearch!] => moduleComQualified
                moduleComQualified.sourceModule == sourceIndex and moduleComQualified.pathAst == callAstIndex! and moduleComQualified.targetSymbol >= 0 and moduleComQualified.targetSymbol < sourceRange.symbolCount
                    -> if {
                        package.symbols[sourceRange.symbolStart + moduleComQualified.targetSymbol].kind == 36
                            -> if { true => moduleHasGeneratedComTarget! }
                    }
                moduleComQualifiedSearch! + 1 => moduleComQualifiedSearch!
            }
        false => moduleGeneratedComHasCallOwner!
        callNode.kind == 36 and callNode.parent >= 0
            -> if {
                package.nodes[sourceRange.astStart + callNode.parent] => generatedComParent
                generatedComParent.kind == 10
                    or generatedComParent.kind == 11
                    or generatedComParent.kind == 48 -> if {
                        true => moduleGeneratedComHasCallOwner!
                    }
            }
        (callNode.kind == 10 and (moduleHasFlowCallTarget or moduleHasQualifiedCallTarget!)) or (callNode.kind == 11 and (callNode.cstRuleId == grammar.ruleIdCallExpression() or callNode.cstRuleId == grammar.ruleIdTypeApplicationExpression())) or callNode.kind == 48 or callNode.kind == 77 or (callNode.kind == 36 and moduleHasGeneratedComTarget! and not moduleGeneratedComHasCallOwner!)
            -> if {
                -1 => callNameToken!
                callNode.kind == 48 or callNode.kind == 77 -> if { callNode.payloadToken => callNameToken! }
                callNode.kind == 36 -> if {
                    callNode.firstToken => comCallNameSearch!
                    comCallNameSearch! < callNode.firstToken + callNode.tokenCount
                        -> while {
                            package.tokens[sourceRange.tokenStart + comCallNameSearch!].kind == grammar.tokenIdIdentifier()
                                -> if { comCallNameSearch! => callNameToken! }
                            comCallNameSearch! + 1 => comCallNameSearch!
                        }
                }
                callNode.kind == 10 -> if { moduleFlowNameTokens![callAstIndex!] => callNameToken! }
                callNode.firstToken => callTokenIndex!
                false => moduleInFlowTypeArgument!
                false => moduleInFlowCallArguments!
                callTokenIndex! < callNode.firstToken + callNode.tokenCount and callNode.kind != 48 and callNode.kind != 77 and callNameToken! < 0
                    -> while {
                        package.tokens[sourceRange.tokenStart + callTokenIndex!].kind == grammar.tokenIdLess()
                            -> if { true => moduleInFlowTypeArgument! }
                        package.tokens[sourceRange.tokenStart + callTokenIndex!].kind == grammar.tokenIdGreater()
                            -> if { false => moduleInFlowTypeArgument! }
                        package.tokens[sourceRange.tokenStart + callTokenIndex!].kind == grammar.tokenIdLeftParen()
                            -> if { true => moduleInFlowCallArguments! }
                        package.tokens[sourceRange.tokenStart + callTokenIndex!].kind == grammar.tokenIdRightParen()
                            -> if { false => moduleInFlowCallArguments! }
                        package.tokens[sourceRange.tokenStart + callTokenIndex!].kind == grammar.tokenIdIdentifier() and not moduleInFlowTypeArgument! and not moduleInFlowCallArguments!
                            -> if { callTokenIndex! => callNameToken! }
                        callTokenIndex! + 1 => callTokenIndex!
                    }
                callNameToken! >= 0 -> if {
                    -1 => localFunctionSymbol!
                    callNode.parent => callerAst!
                    -1 => callerFunctionAst!
                    callerAst! >= 0 and callerFunctionAst! < 0 -> while {
                        package.nodes[sourceRange.astStart + callerAst!] => callerNode
                        callerNode.kind == 7 or callerNode.kind == 31
                            -> if { callerAst! => callerFunctionAst! } else { callerNode.parent => callerAst! }
                    }
                    -1 => callerFunctionSymbol!
                    0 => callerSymbolSearch!
                    callerSymbolSearch! < sourceRange.symbolCount and callerFunctionSymbol! < 0
                        -> while {
                            package.symbols[sourceRange.symbolStart + callerSymbolSearch!] => callerCandidate
                            (callerCandidate.kind == 7 or callerCandidate.kind == 31) and callerCandidate.astNode == callerFunctionAst!
                                -> if { callerSymbolSearch! => callerFunctionSymbol! }
                            callerSymbolSearch! + 1 => callerSymbolSearch!
                        }
                    -1 => localOwnerSymbol!
                    callerFunctionSymbol! >= 0 -> if {
                        package.symbols[sourceRange.symbolStart + callerFunctionSymbol!] => callerFunction
                        callerFunction.parent >= 0 -> if { callerFunction.parent => localOwnerSymbol! } else { callerFunctionSymbol! => localOwnerSymbol! }
                    }
                    0 => localSymbolIndex!
                    localSymbolIndex! < sourceRange.symbolCount and localFunctionSymbol! < 0
                        -> while {
                            package.symbols[sourceRange.symbolStart + localSymbolIndex!] => localCandidate
                            (localCandidate.kind == 7 or localCandidate.kind == 31) and (localCandidate.parent < 0 or localCandidate.parent == localOwnerSymbol!)
                                -> if {
                                    package.tokens[sourceRange.tokenStart + callNameToken!] => callName
                                    package.tokens[sourceRange.tokenStart + localCandidate.nameToken] => functionName
                                    callName.span.length == functionName.span.length => localEqual!
                                    UIntSize(0) => localNameByte!
                                    localEqual! and localNameByte! < callName.span.length
                                        -> while {
                                            source -> byte(callName.span.start + localNameByte!) => callByte
                                            source -> byte(functionName.span.start + localNameByte!) => functionByte
                                            callByte != functionByte -> if { false => localEqual! }
                                            localNameByte! + 1 => localNameByte!
                                        }
                                    localEqual! and (callNode.kind == 10 or callNode.kind == 11 or callNode.kind == 48 or callNode.kind == 77 or localCandidate.secondaryTypeNode < 0)
                                        -> if { localSymbolIndex! => localFunctionSymbol! }
                                }
                            localSymbolIndex! + 1 => localSymbolIndex!
                        }
                    # Keep the analyzed-package path identical to the text path.
                    callNode.kind == 11 -> if {
                        RuntimeNameRequest { source: source, token: package.tokens[sourceRange.tokenStart + callNameToken!] } -> runtimeFunctionSymbol => directRuntimeSymbol
                        directRuntimeSymbol == -102 -> if { directRuntimeSymbol => localFunctionSymbol! }
                    }
                    (callNode.kind == 10 or callNode.kind == 11 or callNode.kind == 48 or callNode.kind == 77) and localFunctionSymbol! < 0
                        -> if {
                            RuntimeNameRequest { source: source, token: package.tokens[sourceRange.tokenStart + callNameToken!] } -> runtimeFunctionSymbol => runtimeSymbol
                            runtimeSymbol < -1 -> if { runtimeSymbol => localFunctionSymbol! }
                        }
                    RuntimeNameRequest { source: source, token: package.tokens[sourceRange.tokenStart + callNameToken!] } -> intrinsicFlowTarget => intrinsicFlow!
                    intrinsicFlow! => intrinsicFallback
                    package -> declaredPackageMethodNamed(
                    sourceIndex,
                    package.tokens[sourceRange.tokenStart + callNameToken!],
                    declaredIntrinsicNames
                    ) => declaredCollision
                    intrinsicFlow! and declaredCollision -> if {
                        false => intrinsicFlow!
                    }
                    callNameToken! > callNode.firstToken and package.tokens[sourceRange.tokenStart + callNameToken! - 1].kind == grammar.tokenIdDot()
                        -> if { false => intrinsicFlow! }
                    localFunctionSymbol! != -1 or (not intrinsicFlow! and (callNode.kind == 10 or callNode.kind == 11 or callNode.kind == 48 or callNode.kind == 77 or (callNode.kind == 36 and moduleHasGeneratedComTarget!)))
                        -> if {
                            2 => localCallStatus!
                            localFunctionSymbol! != -1 -> if { 0 => localCallStatus! }
                            localCalls! -> push(TypedCallCandidate {
                                callAst: callAstIndex!
                                nameToken: callNameToken!
                                functionSymbol: localFunctionSymbol!
                                status: localCallStatus!
                                intrinsicFallback: intrinsicFallback and declaredCollision and localFunctionSymbol! < 0
                            })
                        }
                }
            }
        callAstIndex! + 1 => callAstIndex!
    }
    results! -> len => typedSourceResultStart
    0 => typedResolutionPass!
    typedResolutionPass! < 2 -> while {
        0 => localIndex!
        localIndex! < (localCalls! -> len) -> while {
            localCalls![localIndex!] => local
            package.nodes[sourceRange.astStart + local.callAst] => localCallNode
            localCallNode.firstToken + localCallNode.tokenCount => callLeftParenToken!
            localCallNode.firstToken => callScanToken!
            callScanToken! < localCallNode.firstToken + localCallNode.tokenCount
                -> while {
                    package.tokens[sourceRange.tokenStart + callScanToken!].kind == grammar.tokenIdLeftParen()
                        -> if {
                            callScanToken! => callLeftParenToken!
                            localCallNode.firstToken + localCallNode.tokenCount => callScanToken!
                        } else {
                            callScanToken! + 1 => callScanToken!
                        }
                }
            -1 => importedIndex!
            0 => qualifiedIndex!
            qualifiedIndex! < (qualifiedResults -> len) -> while {
                qualifiedResults[qualifiedIndex!] => candidate
                candidate.sourceModule == sourceIndex -> if {
                    candidate.pathAst => ancestor!
                    0 => callPathDistance!
                    false => belongsToCall!
                    ancestor! >= 0 and not belongsToCall! -> while {
                        ancestor! == local.callAst -> if {
                            true => belongsToCall!
                        } else {
                            package.nodes[sourceRange.astStart + ancestor!].parent => ancestor!
                            callPathDistance! + 1 => callPathDistance!
                        }
                    }
                    package.nodes[sourceRange.astStart + candidate.pathAst] => candidatePath
                    local.functionSymbol >= -1
                        and belongsToCall!
                        and candidatePath.firstToken <= local.nameToken
                        and local.nameToken < candidatePath.firstToken + candidatePath.tokenCount
                        and (localCallNode.kind == 10
                        or candidatePath.firstToken + candidatePath.tokenCount <= callLeftParenToken!)
                        -> if { qualifiedIndex! => importedIndex! }
                }
                qualifiedIndex! + 1 => qualifiedIndex!
            }
            0 => resolvedOrigin!
            sourceIndex => resolvedTargetModule!
            sourceIndex => resolvedTargetSource!
            local.functionSymbol => resolvedFunctionSymbol!
            local.status => resolvedStatus!
            importedIndex! >= 0 -> if {
                qualifiedResults[importedIndex!] => imported
                -1 => targetSourceModule!
                imported.targetModule >= 0 -> if {
                    identities[imported.targetModule].sourceIndex => targetSourceModule!
                }
                imported.targetModule => importedResolvedModule!
                targetSourceModule! => importedResolvedSource!
                imported.status => importedStatus!
                imported.status == 0 -> if {
                    package.ranges[targetSourceModule!] => targetRange
                    package.symbols[targetRange.symbolStart + imported.targetSymbol] => importedTargetSymbol
                    importedTargetSymbol.kind != 7 and importedTargetSymbol.kind != 31 and importedTargetSymbol.kind != 36
                        -> if { 2 => importedStatus! }
                }
                imported.targetSymbol => importedFunctionSymbol!
                importedStatus! != 0 and targetSourceModule! >= 0
                    -> if {
                        package.ranges[targetSourceModule!] => importedTargetRange
                        package.sources[targetSourceModule!] -> len => importedTargetLength
                        package.sources[targetSourceModule!] -> slice(UIntSize(0), importedTargetLength) => importedTargetSource
                        package.tokens[sourceRange.tokenStart + local.nameToken] => importedCallName
                        0 => importedFunctionSearch!
                        importedFunctionSearch! < importedTargetRange.symbolCount
                            -> while {
                                package.symbols[importedTargetRange.symbolStart + importedFunctionSearch!] => importedFunction
                                (importedFunction.kind == 7 or importedFunction.kind == 31) and importedFunction.flags / 4 % 2 == 1
                                    -> if {
                                        package.tokens[importedTargetRange.tokenStart + importedFunction.nameToken] => importedFunctionName
                                        importedCallName.span.length == importedFunctionName.span.length => importedFunctionEqual!
                                        UIntSize(0) => importedFunctionByte!
                                        importedFunctionEqual! and importedFunctionByte! < importedCallName.span.length
                                            -> while {
                                                (source -> byte(importedCallName.span.start + importedFunctionByte!)) != (importedTargetSource -> byte(importedFunctionName.span.start + importedFunctionByte!))
                                                    -> if {
                                                        false => importedFunctionEqual!
                                                    }
                                                importedFunctionByte! + 1 => importedFunctionByte!
                                            }
                                        importedFunctionEqual! -> if {
                                            importedFunctionSearch! => importedFunctionSymbol!
                                            0 => importedStatus!
                                        }
                                    }
                                importedFunctionSearch! + 1 => importedFunctionSearch!
                            }
                    }
                importedStatus! != 0 and targetSourceModule! >= 0
                    -> if {
                        identities[imported.targetModule] => importedIdentity
                        false => importedSiblingFound!
                        false => importedSiblingAmbiguous!
                        0 => importedSiblingModuleIndex!
                        importedSiblingModuleIndex! < (identities -> len)
                            -> while {
                                identities[importedSiblingModuleIndex!] => importedSiblingIdentity
                                importedSiblingIdentity.sourceIndex != targetSourceModule! and importedSiblingIdentity.pathHash == importedIdentity.pathHash
                                    -> if {
                                        importedSiblingIdentity.sourceIndex => importedSiblingSource
                                        package.ranges[importedSiblingSource] => importedSiblingRange
                                        package.sources[importedSiblingSource] -> len => importedSiblingLength
                                        package.sources[importedSiblingSource] -> slice(UIntSize(0), importedSiblingLength) => importedSiblingText
                                        package.tokens[sourceRange.tokenStart + local.nameToken] => importedSiblingCallName
                                        0 => importedSiblingSymbolIndex!
                                        importedSiblingSymbolIndex! < importedSiblingRange.symbolCount
                                            -> while {
                                                package.symbols[importedSiblingRange.symbolStart + importedSiblingSymbolIndex!] => importedSiblingFunction
                                                (importedSiblingFunction.kind == 7 or importedSiblingFunction.kind == 31) and importedSiblingFunction.flags / 4 % 2 == 1
                                                    -> if {
                                                        package.tokens[importedSiblingRange.tokenStart + importedSiblingFunction.nameToken] => importedSiblingFunctionName
                                                        importedSiblingCallName.span.length == importedSiblingFunctionName.span.length => importedSiblingFunctionEqual!
                                                        UIntSize(0) => importedSiblingFunctionByte!
                                                        importedSiblingFunctionEqual! and importedSiblingFunctionByte! < importedSiblingCallName.span.length
                                                            -> while {
                                                                (source -> byte(importedSiblingCallName.span.start + importedSiblingFunctionByte!)) != (importedSiblingText -> byte(importedSiblingFunctionName.span.start + importedSiblingFunctionByte!))
                                                                    -> if {
                                                                        false => importedSiblingFunctionEqual!
                                                                    }
                                                                importedSiblingFunctionByte! + 1 => importedSiblingFunctionByte!
                                                            }
                                                        importedSiblingFunctionEqual! -> if {
                                                            importedSiblingFound! -> if {
                                                                true => importedSiblingAmbiguous!
                                                            } else {
                                                                true => importedSiblingFound!
                                                                importedSiblingModuleIndex! => importedResolvedModule!
                                                                importedSiblingSource => importedResolvedSource!
                                                                importedSiblingSymbolIndex! => importedFunctionSymbol!
                                                            }
                                                        }
                                                    }
                                                importedSiblingSymbolIndex! + 1 => importedSiblingSymbolIndex!
                                            }
                                    }
                                importedSiblingModuleIndex! + 1 => importedSiblingModuleIndex!
                            }
                        importedSiblingFound! and not importedSiblingAmbiguous!
                            -> if { 0 => importedStatus! }
                        importedSiblingAmbiguous! -> if { 2 => importedStatus! }
                    }
                1 => resolvedOrigin!
                importedResolvedModule! => resolvedTargetModule!
                importedResolvedSource! => resolvedTargetSource!
                importedFunctionSymbol! => resolvedFunctionSymbol!
                importedStatus! => resolvedStatus!
            } else {
                # Source files with the same namespace form one logical module.
                # Search sibling fragments before open imports so private helpers
                # remain module-local without wrappers or runtime indirection.
                false => siblingFound!
                false => siblingAmbiguous!
                local.functionSymbol == -1
                    and not local.intrinsicFallback
                    and (localCallNode.kind == 10 or localCallNode.kind == 11 or localCallNode.kind == 48 or localCallNode.kind == 77)
                    -> if {
                        identities[sourceIndex] => currentIdentity
                        0 => siblingModuleIndex!
                        siblingModuleIndex! < (identities -> len) -> while {
                            identities[siblingModuleIndex!] => siblingIdentity
                            siblingIdentity.sourceIndex != sourceIndex and siblingIdentity.pathHash == currentIdentity.pathHash
                                -> if {
                                    siblingIdentity.sourceIndex => siblingSource
                                    package.ranges[siblingSource] => siblingRange
                                    package.sources[siblingSource] -> len => siblingLength
                                    package.sources[siblingSource] -> slice(UIntSize(0), siblingLength) => siblingText
                                    0 => siblingSymbolIndex!
                                    siblingSymbolIndex! < siblingRange.symbolCount
                                        -> while {
                                            package.symbols[siblingRange.symbolStart + siblingSymbolIndex!] => siblingCandidate
                                            # Same-namespace global functions are valid lexical
                                            # fallbacks. Inherent methods are never selected by
                                            # spelling alone: the typed receiver lookup below owns
                                            # their owner identity and overload choice.
                                            siblingCandidate.kind == 7
                                                -> if {
                                                    package.tokens[sourceRange.tokenStart + local.nameToken] => siblingCallName
                                                    package.tokens[siblingRange.tokenStart + siblingCandidate.nameToken] => siblingFunctionName
                                                    siblingCallName.span.length == siblingFunctionName.span.length => siblingNameEqual!
                                                    UIntSize(0) => siblingNameByte!
                                                    siblingNameEqual! and siblingNameByte! < siblingCallName.span.length
                                                        -> while {
                                                            (source -> byte(siblingCallName.span.start + siblingNameByte!)) != (siblingText -> byte(siblingFunctionName.span.start + siblingNameByte!))
                                                                -> if {
                                                                    false => siblingNameEqual!
                                                                }
                                                            siblingNameByte! + 1 => siblingNameByte!
                                                        }
                                                    siblingNameEqual! -> if {
                                                        siblingFound! -> if {
                                                            true => siblingAmbiguous!
                                                        } else {
                                                            true => siblingFound!
                                                            0 => resolvedOrigin!
                                                            siblingModuleIndex! => resolvedTargetModule!
                                                            siblingSource => resolvedTargetSource!
                                                            siblingSymbolIndex! => resolvedFunctionSymbol!
                                                            0 => resolvedStatus!
                                                        }
                                                    }
                                                }
                                            siblingSymbolIndex! + 1 => siblingSymbolIndex!
                                        }
                                }
                            siblingModuleIndex! + 1 => siblingModuleIndex!
                        }
                        siblingAmbiguous! -> if {
                            sourceIndex => resolvedTargetModule!
                            sourceIndex => resolvedTargetSource!
                            -1 => resolvedFunctionSymbol!
                            2 => resolvedStatus!
                        }
                    }
                # A flow receiver may be a local binding whose nominal type was
                # declared in one fragment while its impl lives in another.
                # Recover that binding's qualified initializer type, then search
                # only impls for the same owner inside the logical module.
                # A receiver's inherent method has precedence over an
                # unqualified same-module function with the same name. Keep
                # the local candidate as a fallback, but always attempt typed
                # receiver resolution for flow calls before accepting it.
                -1 => openReceiverTypeModule!
                -1 => openReceiverTypeSymbol!
                localCallNode.kind == 10
                    -> if {
                        local.nameToken => receiverCallNameToken!
                        moduleFlowNameTokens![local.callAst] >= 0 -> if {
                            moduleFlowNameTokens![local.callAst] => receiverCallNameToken!
                        }
                        package.tokens[sourceRange.tokenStart + receiverCallNameToken!] => receiverCallName
                        -1 => receiverSymbol!
                        -1 => receiverRootAst!
                        UIntSize(0) => receiverStart!
                        0 => receiverNameIndex!
                        receiverNameIndex! < sourceRange.nameCount -> while {
                            package.names[sourceRange.nameStart + receiverNameIndex!] => receiverName
                            package.nodes[sourceRange.astStart + receiverName.astNode] => receiverNameAst
                            receiverName.astNode => receiverAncestor!
                            false => receiverBelongs!
                            receiverAncestor! >= 0 and not receiverBelongs!
                                -> while {
                                    receiverAncestor! == local.callAst -> if { true => receiverBelongs! } else {
                                        package.nodes[sourceRange.astStart + receiverAncestor!].parent => receiverAncestor!
                                    }
                                }
