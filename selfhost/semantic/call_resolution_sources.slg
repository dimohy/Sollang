                        # binding through the nominal field table. Field labels are
                        # compared exactly; no method-name or open-import fallback
                        # participates in owner selection.
                        receiverSymbol! >= 0 and receiverTypeId! >= 0
                            -> if {
                                localCallNode.firstToken => receiverProjectionTokenIndex!
                                receiverProjectionTokenIndex! < local.nameToken
                                    -> while {
                                        package.tokens[sourceRange.tokenStart + receiverProjectionTokenIndex!]
                                            => receiverProjectionToken
                                        receiverProjectionToken.kind == grammar.tokenIdIdentifier()
                                            and receiverProjectionToken.span.start > receiverStart!
                                            -> if {
                                                false => receiverFieldFound!
                                                -1 => receiverFieldTypeId!
                                                0 => receiverFieldIndex!
                                                receiverFieldIndex! < (semantic.fields -> len)
                                                    -> while {
                                                        semantic.fields[receiverFieldIndex!] => receiverField
                                                        receiverField.ownerType == receiverTypeId! => receiverFieldOwnerMatches!
                                                        not receiverFieldOwnerMatches!
                                                            and receiverField.ownerType >= 0
                                                            and receiverField.ownerType < (semantic.types -> len)
                                                            -> if {
                                                                semantic.types[receiverField.ownerType] => receiverFieldOwnerType
                                                                semantic.types[receiverTypeId!] => receiverFieldReceiverType
                                                                receiverFieldOwnerType.kind == 1
                                                                    and receiverFieldReceiverType.kind == 1
                                                                    and receiverFieldOwnerType.module == receiverFieldReceiverType.module
                                                                    and receiverFieldOwnerType.symbol == receiverFieldReceiverType.symbol
                                                                    -> if { true => receiverFieldOwnerMatches! }
                                                            }
                                                        receiverFieldOwnerMatches! and receiverField.status == 0
                                                            -> if {
                                                                package.ranges[receiverField.sourceModule]
                                                                    => receiverFieldRange
                                                                receiverField.labelToken => receiverFieldNameTokenIndex!
                                                                receiverFieldNameTokenIndex! < 0
                                                                    and receiverField.fieldSymbol >= 0
                                                                    -> if {
                                                                        receiverFieldRange.symbolStart + receiverField.fieldSymbol
                                                                            => receiverFieldSymbolIndex
                                                                        package.symbols[receiverFieldSymbolIndex]
                                                                            => receiverFieldSymbol
                                                                        receiverFieldSymbol.nameToken
                                                                            => receiverFieldNameTokenIndex!
                                                                    }
                                                                receiverFieldNameTokenIndex! >= 0 -> if {
                                                                    receiverFieldRange.tokenStart + receiverFieldNameTokenIndex!
                                                                        => receiverFieldGlobalNameTokenIndex
                                                                    package.tokens[receiverFieldGlobalNameTokenIndex]
                                                                        => receiverFieldNameToken
                                                                    package.sources[receiverField.sourceModule]
                                                                        -> len => receiverFieldSourceLength
                                                                    package.sources[receiverField.sourceModule]
                                                                        -> slice(UIntSize(0), receiverFieldSourceLength)
                                                                        => receiverFieldSource
                                                                    receiverProjectionToken.span.length == receiverFieldNameToken.span.length
                                                                        => receiverFieldNameEqual!
                                                                    UIntSize(0) => receiverFieldNameByte!
                                                                    receiverFieldNameEqual!
                                                                        and receiverFieldNameByte! < receiverProjectionToken.span.length
                                                                        -> while {
                                                                            receiverProjectionToken.span.start + receiverFieldNameByte!
                                                                                => receiverProjectionByteIndex
                                                                            receiverFieldNameToken.span.start + receiverFieldNameByte!
                                                                                => receiverFieldByteIndex
                                                                            source -> byte(receiverProjectionByteIndex)
                                                                                => receiverProjectionByte
                                                                            receiverFieldSource -> byte(receiverFieldByteIndex)
                                                                                => receiverFieldByte
                                                                            receiverProjectionByte != receiverFieldByte
                                                                                -> if {
                                                                                    false => receiverFieldNameEqual!
                                                                                }
                                                                            receiverFieldNameByte! + 1
                                                                                => receiverFieldNameByte!
                                                                        }
                                                                    receiverFieldNameEqual! -> if {
                                                                        true => receiverFieldFound!
                                                                        receiverField.fieldType
                                                                            => receiverFieldTypeId!
                                                                    }
                                                                }
                                                            }
                                                        receiverFieldIndex! + 1 => receiverFieldIndex!
                                                    }
                                                receiverFieldFound! and receiverFieldTypeId! >= 0
                                                    -> if {
                                                        receiverFieldTypeId! => receiverTypeId!
                                                        semantic.types[receiverTypeId!].kind == 8
                                                            and semantic.types[receiverTypeId!].first >= 0
                                                            -> if {
                                                                semantic.types[receiverTypeId!].first
                                                                    => receiverTypeId!
                                                            }
                                                        semantic.types[receiverTypeId!] => receiverProjectedType
                                                        (receiverProjectedType.kind == 1
                                                            or receiverProjectedType.kind == 7)
                                                            and receiverProjectedType.origin != 4
                                                            and receiverProjectedType.module >= 0
                                                            and receiverProjectedType.symbol >= 0
                                                            and receiverProjectedType.status == 0
                                                            -> if {
                                                                receiverProjectedType.module => receiverTypeModule!
                                                                receiverProjectedType.symbol => receiverTypeSymbol!
                                                            }
                                                    }
                                            }
                                        receiverProjectionTokenIndex! + 1
                                            => receiverProjectionTokenIndex!
                                    }
                            }
                        receiverTypeModule! >= 0 and receiverTypeSymbol! >= 0
                            -> if {
                                identities[receiverTypeModule!] => receiverTypeIdentity
                                identities[receiverTypeModule!].sourceIndex => receiverTypeSource
                                package.ranges[receiverTypeSource] => receiverTypeRange
                                package.symbols[receiverTypeRange.symbolStart + receiverTypeSymbol!] => receiverType
                                package.tokens[receiverTypeRange.tokenStart + receiverType.nameToken] => receiverTypeName
                                package.sources[receiverTypeSource] -> len => receiverTypeLength
                                package.sources[receiverTypeSource] -> slice(UIntSize(0), receiverTypeLength) => receiverTypeText
                                false => receiverMethodFound!
                                false => receiverMethodAmbiguous!
                                0 => receiverMethodModule!
                                receiverMethodModule! < (identities -> len) -> while {
                                    identities[receiverMethodModule!] => receiverMethodIdentity
                                    receiverMethodIdentity.pathHash == receiverTypeIdentity.pathHash
                                        -> if {
                                            receiverMethodIdentity.sourceIndex => receiverMethodSource
                                            package.ranges[receiverMethodSource] => receiverMethodRange
                                            package.sources[receiverMethodSource] -> len => receiverMethodLength
                                            package.sources[receiverMethodSource] -> slice(UIntSize(0), receiverMethodLength) => receiverMethodText
                                            0 => receiverMethodSymbol!
                                            receiverMethodSymbol! < receiverMethodRange.symbolCount
                                                -> while {
                                                    package.symbols[receiverMethodRange.symbolStart + receiverMethodSymbol!] => receiverMethod
                                                    receiverMethod.kind == 31
                                                        and receiverMethod.parent >= 0
                                                        and (receiverMethod.flags / 4 % 2 == 1
                                                        or receiverMethodIdentity.pathHash == identities[sourceIndex].pathHash)
                                                        -> if {
                                                            package.symbols[receiverMethodRange.symbolStart + receiverMethod.parent] => receiverImpl
                                                            package.tokens[receiverMethodRange.tokenStart + receiverMethod.nameToken] => receiverMethodName
                                                            false => receiverOwnerEqual!
                                                            receiverImpl.typeNode >= 0 -> if {
                                                                0 => receiverOwnerReferenceIndex!
                                                                receiverOwnerReferenceIndex! < (semantic.references -> len)
                                                                    -> while {
                                                                        semantic.references[receiverOwnerReferenceIndex!]
                                                                            => receiverOwnerReference
                                                                        receiverOwnerReference.sourceModule == receiverMethodSource
                                                                            and receiverOwnerReference.typeAst == receiverImpl.typeNode
                                                                            and receiverOwnerReference.status == 0
                                                                            -> if {
                                                                                semantic.types[receiverOwnerReference.typeId]
                                                                                    => receiverOwnerType
                                                                                receiverOwnerType.module == receiverTypeModule!
                                                                                    and receiverOwnerType.symbol == receiverTypeSymbol!
                                                                                    and receiverOwnerType.status == 0
                                                                                    -> if {
                                                                                        true => receiverOwnerEqual!
                                                                                    }
                                                                            }
                                                                        receiverOwnerReferenceIndex! + 1
                                                                            => receiverOwnerReferenceIndex!
                                                                    }
                                                            }
                                                            not receiverOwnerEqual! -> if {
                                                                package.tokens[receiverMethodRange.tokenStart + receiverImpl.nameToken]
                                                                    => receiverImplName
                                                                receiverImplName.span.length == receiverTypeName.span.length
                                                                    => receiverOwnerEqual!
                                                                UIntSize(0) => receiverOwnerByte!
                                                                receiverOwnerEqual!
                                                                    and receiverOwnerByte! < receiverTypeName.span.length
                                                                    -> while {
                                                                        (receiverMethodText -> byte(receiverImplName.span.start + receiverOwnerByte!)) != (receiverTypeText -> byte(receiverTypeName.span.start + receiverOwnerByte!))
                                                                            -> if {
                                                                                false => receiverOwnerEqual!
                                                                            }
                                                                        receiverOwnerByte! + 1 => receiverOwnerByte!
                                                                    }
                                                            }
                                                            receiverMethodName.span.length == receiverCallName.span.length => receiverMethodEqual!
                                                            UIntSize(0) => receiverMethodByte!
                                                            receiverMethodEqual! and receiverMethodByte! < receiverCallName.span.length
                                                                -> while {
                                                                    (receiverMethodText -> byte(receiverMethodName.span.start + receiverMethodByte!)) != (source -> byte(receiverCallName.span.start + receiverMethodByte!))
                                                                        -> if {
                                                                            false => receiverMethodEqual!
                                                                        }
                                                                    receiverMethodByte! + 1 => receiverMethodByte!
                                                                }
                                                            receiverOwnerEqual! and receiverMethodEqual!
                                                                -> if {
                                                                    receiverMethodFound! -> if {
                                                                        true => receiverMethodAmbiguous!
                                                                    } else {
                                                                        true => receiverMethodFound!
                                                                        0 => resolvedOrigin!
                                                                        receiverMethodModule! => resolvedTargetModule!
                                                                        receiverMethodSource => resolvedTargetSource!
                                                                        receiverMethodSymbol! => resolvedFunctionSymbol!
                                                                        0 => resolvedStatus!
                                                                    }
                                                                }
                                                        }
                                                    receiverMethodSymbol! + 1 => receiverMethodSymbol!
                                                }
                                        }
                                    receiverMethodModule! + 1 => receiverMethodModule!
                                }
                                receiverMethodFound! and not receiverMethodAmbiguous!
                                    -> if { true => siblingFound! }
                                receiverMethodAmbiguous! -> if {
                                    true => siblingAmbiguous!
                                    sourceIndex => resolvedTargetModule!
                                    sourceIndex => resolvedTargetSource!
                                    -1 => resolvedFunctionSymbol!
                                    2 => resolvedStatus!
                                }
                                receiverTypeModule! => openReceiverTypeModule!
                                receiverTypeSymbol! => openReceiverTypeSymbol!
                            }
                    }
                # An unqualified name is also looked up in every directly
                # imported module. This is the Stage1 open-import behavior used
                # by `import std.sequence` followed by ordinary flow, direct,
                # or block-function calls such as `defer`, `map`, and `filter`.
                false => openImportFound!
                false => openImportAmbiguous!
                not siblingFound!
                    and not local.intrinsicFallback
                    and (local.functionSymbol == -1 or localCallNode.kind == 10)
                    and (localCallNode.kind == 10 or localCallNode.kind == 11 or localCallNode.kind == 48 or localCallNode.kind == 77)
                    -> if {
                        0 => openImportIndex!
                        openImportIndex! < (resolvedImports -> len) -> while {
                            resolvedImports[openImportIndex!] => openImport
                            openImport.sourceModule == sourceIndex and openImport.status == 0
                                -> if {
                                    identities[openImport.targetModule]
                                        => openImportIdentity
                                    0 => openFragmentModule!
                                    openFragmentModule! < (identities -> len)
                                        -> while {
                                            identities[openFragmentModule!]
                                                => openFragmentIdentity
                                            openFragmentIdentity.pathHash == openImportIdentity.pathHash
                                                -> if {
                                                    openFragmentIdentity.sourceIndex
                                                        => openTargetSource
                                                    package.ranges[openTargetSource]
                                                        => openTargetRange
                                                    package.sources[openTargetSource]
                                                        -> len => openTargetLength
                                                    package.sources[openTargetSource]
                                                        -> slice(UIntSize(0), openTargetLength)
                                                        => openTargetText
                                                    0 => openSymbolIndex!
                                                    openSymbolIndex! < openTargetRange.symbolCount
                                                        -> while {
                                                            package.symbols[openTargetRange.symbolStart + openSymbolIndex!]
                                                                => openCandidate
                                                            false => openCandidateAccepted!
                                                            local.functionSymbol == -1
                                                                and openCandidate.kind == 7
                                                                -> if { true => openCandidateAccepted! }
                                                            # An imported extension-style method is a
                                                            # candidate only when its declared impl owner
                                                            # is the exact semantic receiver type. Name
                                                            # equality alone must never override a lexical
                                                            # global function.
                                                            localCallNode.kind == 10
                                                                and openCandidate.kind == 31
                                                                and openCandidate.parent >= 0
                                                                and openReceiverTypeModule! >= 0
                                                                and openReceiverTypeSymbol! >= 0
                                                                -> if {
                                                                    package.symbols[openTargetRange.symbolStart + openCandidate.parent]
                                                                        => openCandidateImpl
                                                                    openCandidateImpl.typeNode >= 0 -> if {
                                                                        0 => openOwnerReferenceIndex!
                                                                        openOwnerReferenceIndex! < (semantic.references -> len)
                                                                            and not openCandidateAccepted!
                                                                            -> while {
                                                                                semantic.references[openOwnerReferenceIndex!]
                                                                                    => openOwnerReference
                                                                                openOwnerReference.sourceModule == openTargetSource
                                                                                    and openOwnerReference.typeAst == openCandidateImpl.typeNode
                                                                                    and openOwnerReference.status == 0
                                                                                    -> if {
                                                                                        semantic.types[openOwnerReference.typeId]
                                                                                            => openOwnerType
                                                                                        openOwnerType.module == openReceiverTypeModule!
                                                                                            and openOwnerType.symbol == openReceiverTypeSymbol!
                                                                                            and openOwnerType.status == 0
                                                                                            -> if { true => openCandidateAccepted! }
                                                                                    }
                                                                                openOwnerReferenceIndex! + 1
                                                                                    => openOwnerReferenceIndex!
                                                                            }
                                                                    }
                                                                    # Qualified impl owners do not populate the
                                                                    # symbol typeNode. Their resolved path is the
                                                                    # direct child of the impl declaration. This
                                                                    # exact edge excludes every qualified type in
                                                                    # method signatures and bodies.
                                                                    0 => openOwnerQualifiedIndex!
                                                                    openOwnerQualifiedIndex! < (qualifiedResults -> len)
                                                                        and not openCandidateAccepted!
                                                                        -> while {
                                                                            qualifiedResults[openOwnerQualifiedIndex!]
                                                                                => openOwnerQualified
                                                                            openOwnerQualified.sourceModule == openTargetSource
                                                                                and openOwnerQualified.status == 0
                                                                                and openOwnerQualified.targetModule == openReceiverTypeModule!
                                                                                and openOwnerQualified.targetSymbol == openReceiverTypeSymbol!
                                                                                and package.nodes[openTargetRange.astStart + openOwnerQualified.pathAst].parent == openCandidateImpl.astNode
                                                                                -> if { true => openCandidateAccepted! }
                                                                            openOwnerQualifiedIndex! + 1
                                                                                => openOwnerQualifiedIndex!
                                                                        }
                                                                    # An unqualified impl owner in another
                                                                    # fragment of the receiver's own logical
                                                                    # module is identified by that shared
                                                                    # module path plus exact declaration name.
                                                                    not openCandidateAccepted!
                                                                        and identities[openFragmentModule!].pathHash == identities[openReceiverTypeModule!].pathHash
                                                                        and openCandidateImpl.nameToken >= 0
                                                                        -> if {
                                                                            identities[openReceiverTypeModule!].sourceIndex
                                                                                => openReceiverTypeSource
                                                                            package.ranges[openReceiverTypeSource]
                                                                                => openReceiverTypeRange
                                                                            package.symbols[openReceiverTypeRange.symbolStart + openReceiverTypeSymbol!]
                                                                                => openReceiverTypeDeclaration
                                                                            package.tokens[openReceiverTypeRange.tokenStart + openReceiverTypeDeclaration.nameToken]
                                                                                => openReceiverTypeName
                                                                            package.tokens[openTargetRange.tokenStart + openCandidateImpl.nameToken]
                                                                                => openOwnerName
                                                                            openReceiverTypeName.span.length == openOwnerName.span.length
                                                                                => openOwnerNameEqual!
                                                                            UIntSize(0) => openOwnerNameByte!
                                                                            openOwnerNameEqual!
                                                                                and openOwnerNameByte! < openOwnerName.span.length
                                                                                -> while {
                                                                                    (package.sources[openReceiverTypeSource] -> byte(openReceiverTypeName.span.start + openOwnerNameByte!)) != (openTargetText -> byte(openOwnerName.span.start + openOwnerNameByte!))
                                                                                        -> if { false => openOwnerNameEqual! }
                                                                                    openOwnerNameByte! + 1 => openOwnerNameByte!
                                                                                }
                                                                            openOwnerNameEqual! -> if { true => openCandidateAccepted! }
                                                                        }
                                                                }
                                                            openCandidateAccepted!
                                                                and openCandidate.flags / 4 % 2 == 1
                                                                -> if {
                                                                    package.tokens[sourceRange.tokenStart + local.nameToken]
                                                                        => openCallName
                                                                    package.tokens[openTargetRange.tokenStart + openCandidate.nameToken]
                                                                        => openFunctionName
                                                                    openCallName.span.length == openFunctionName.span.length
                                                                        => openNameEqual!
                                                                    UIntSize(0) => openNameByte!
                                                                    openNameEqual!
                                                                        and openNameByte! < openCallName.span.length
                                                                        -> while {
                                                                            (source -> byte(openCallName.span.start + openNameByte!)) != (openTargetText -> byte(openFunctionName.span.start + openNameByte!))
                                                                                -> if {
                                                                                    false => openNameEqual!
                                                                                }
                                                                            openNameByte! + 1 => openNameByte!
                                                                        }
                                                                    openNameEqual! -> if {
                                                                        openImportFound! -> if {
                                                                            true => openImportAmbiguous!
                                                                        } else {
                                                                            true => openImportFound!
                                                                            1 => resolvedOrigin!
                                                                            openFragmentModule!
                                                                                => resolvedTargetModule!
                                                                            openTargetSource
                                                                                => resolvedTargetSource!
                                                                            openSymbolIndex!
                                                                                => resolvedFunctionSymbol!
                                                                            0 => resolvedStatus!
                                                                        }
                                                                    }
                                                                }
                                                            openSymbolIndex! + 1
                                                                => openSymbolIndex!
                                                        }
                                                }
                                            openFragmentModule! + 1
                                                => openFragmentModule!
                                        }
                                }
                            openImportIndex! + 1 => openImportIndex!
                        }
                        openImportAmbiguous! -> if {
                            sourceIndex => resolvedTargetModule!
                            sourceIndex => resolvedTargetSource!
                            -1 => resolvedFunctionSymbol!
                            2 => resolvedStatus!
                        }
                    }
                not siblingFound! and not openImportFound! -> if {
                    local.functionSymbol < -1 => runtimeCall
                    runtimeCall -> if {
                        2 => resolvedOrigin!
                        -1 => resolvedTargetSource!
                    }
                }
                local.intrinsicFallback and not siblingFound!
                    -> if {
                        # This name collided with a declaration elsewhere, but the
                        # exact receiver owns no such method. Drop the temporary
                        # resolution after both typed passes so the intrinsic path
                        # remains authoritative.
                        6 => resolvedStatus!
                        # A known nominal receiver cannot fall back to a builtin
                        # collection operation merely because its spelling matches.
                        openReceiverTypeModule! >= 0 and openReceiverTypeSymbol! >= 0
                            -> if { 7 => resolvedStatus! }
                    }
            }
            ModuleCallResolution {
                sourceModule: sourceIndex
                callAst: local.callAst
                origin: resolvedOrigin!
                targetModule: resolvedTargetModule!
                targetSourceModule: resolvedTargetSource!
                functionSymbol: resolvedFunctionSymbol!
                status: resolvedStatus!
            } => typedResolvedCall
            typedResolutionPass! == 0 -> if {
                results! -> push(typedResolvedCall)
            } else {
                typedResolvedCall => results![typedSourceResultStart + localIndex!]
            }
            localIndex! + 1 => localIndex!
        }
        typedResolutionPass! + 1 => typedResolutionPass!
    }
    results!
}
