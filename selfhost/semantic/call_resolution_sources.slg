                        # Receiver dispatch observes the referenced value, not the
                        # reference wrapper used by the calling ABI. Unwrap once
                        # before walking a projected field chain so `ref T` and `T`
                        # select the same inherent-method owner without a copy.
                        receiverTypeId! >= 0
                            and receiverTypeId! < (semantic.types -> len)
                            and semantic.types[receiverTypeId!].kind == 8
                            and semantic.types[receiverTypeId!].first >= 0
                            -> if {
                                semantic.types[receiverTypeId!].first => receiverTypeId!
                                semantic.types[receiverTypeId!] => receiverReferencedType
                                (receiverReferencedType.kind == 1
                                    or receiverReferencedType.kind == 7)
                                    and receiverReferencedType.origin != 4
                                    and receiverReferencedType.module >= 0
                                    and receiverReferencedType.symbol >= 0
                                    and receiverReferencedType.status == 0
                                    -> if {
                                        receiverReferencedType.module => receiverTypeModule!
                                        receiverReferencedType.symbol => receiverTypeSymbol!
                                    }
                            }
                        # Preserve the semantic type id as well as its nominal
                        # identity so projected receivers can follow declared field
                        # types before inherent-method lookup.
                        receiverTypeId! < 0
                            and receiverTypeModule! >= 0
                            and receiverTypeSymbol! >= 0
                            -> if {
                                0 => receiverNominalTypeSearch!
                                receiverNominalTypeSearch! < (semantic.types -> len)
                                    -> while {
                                        semantic.types[receiverNominalTypeSearch!]
                                            => receiverNominalTypeCandidate
                                        (receiverNominalTypeCandidate.kind == 1
                                            or receiverNominalTypeCandidate.kind == 7)
                                            and receiverNominalTypeCandidate.origin != 4
                                            and receiverNominalTypeCandidate.module == receiverTypeModule!
                                            and receiverNominalTypeCandidate.symbol == receiverTypeSymbol!
                                            and receiverNominalTypeCandidate.status == 0
