namespace sollang.compiler.manifest_entry

import sys.path as path
import sys.directory.kind as kinds

# Directory.Exists and File.Exists return false for unavailable metadata.
# Query follows links; its canonical path does not replace lexical identity.
hasKind value: ref path.Path, expected: kinds.Kind -> Bool uses File {
    value -> query -> when {
        Ok(info) { (info.kind -> kinds.code) == (expected -> kinds.code) }
        Err(_) { false }
    }
}

public fileExists value: ref path.Path -> Bool uses File => value -> hasKind(kinds.Kind.File)

# ProjectManifest.FindFrom and WorkspaceManifest.FindFrom share the same
# nearest-ancestor search; absence is distinct from a path-resolution failure.
public findFrom directory: Text, fileName: Text, style: path.Style, diagnosticStorage: mut Arena -> Result<Option<path.Path>, Text> uses File {
    directory -> path.fromText(style) -> absolute -> when {
        Ok(value) { value }
        Err(error) { error -> materialize(diagnosticStorage) -> Result<Option<path.Path>, Text>.Err -> return }
    } => root
    root -> pathText => rootText
    rootText -> len => directoryLength!
    fileName -> path.fromText(style) => entry
    ".." -> path.fromText(style) => parentName
    true -> while {
        rootText -> slice(0, directoryLength!) -> path.fromText(style) => current
        current -> joinDiscovered(entry) => candidate
        candidate -> fileExists -> if {
            Option<path.Path>.Some(candidate) -> Result<Option<path.Path>, Text>.Ok -> return
        }
        current -> joinDiscovered(parentName) -> absolute -> when {
            Ok(value) { value }
            Err(error) { error -> materialize(diagnosticStorage) -> Result<Option<path.Path>, Text>.Err -> return }
        } => parent
        parent -> pathText => parentText
        parentText == (current -> pathText)
            -> if {
                Result<Option<path.Path>, Text>.Ok(Option<path.Path>.None) -> return
            }
        parentText -> len => directoryLength!
    }
    Result<Option<path.Path>, Text>.Ok(Option<path.Path>.None)
}

# Only a real directory selects the default manifest filename. Native lexical
# absolute resolution also works for nonexistent paths and keeps their names.
public resolve option: Text, fileName: Text, style: path.Style -> Result<path.Path, Text> uses File {
    option -> path.fromText(style) => request
    request -> hasKind(kinds.Kind.Directory) -> if {
        request -> join(fileName) -> when {
            Ok(value) { value -> absolute -> return }
            Err(error) { Result<path.Path, Text>.Err(error) -> return }
        }
    }
    request -> absolute
}
