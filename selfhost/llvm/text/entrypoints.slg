public emitCheckedTestFiles paths: [Text; ~], harness: ref [UInt8; ~], sourceIndices: [Int; ~], symbolIndices: [Int; ~], targetKind: Int -> Int uses Console, File {
    [file.SourceText; ~] => owners!
    0 => pathIndex!
    pathIndex! < (paths -> len) -> while {
        paths[pathIndex!] -> file.mapText => owner
        owners! -> push(owner)
        pathIndex! + 1 => pathIndex!
    }
    harness -> file.borrowBytes => harnessOwner
    owners! -> push(harnessOwner)
    [Text; ~] => sources!
    0 => sourceIndex!
    sourceIndex! < (owners! -> len) -> while {
        owners![sourceIndex!] -> len => sourceLength
        owners![sourceIndex!] -> slice(UIntSize(0), sourceLength) => source
        sources! -> push(source)
        sourceIndex! + 1 => sourceIndex!
    }
    sources! -> syntaxDiagnosticCount => syntaxCount
    syntaxCount > 0 -> if {
        sources! -> emitSyntaxDiagnostics
        syntaxCount -> return
    }
    targetKind == 0 -> if { llvmTarget.windowsX64() } else { llvmTarget.linuxX64() } => target
    targetKind == 0 -> if { 1 } else { 0 } => expectedStyle
    PrepareRequest { sources: sources!, pointerBitWidth: target.pointerBitWidth, supportsComputePool: true, expectedPathStyle: expectedStyle } => prepareRequest
    targetKind == 0 -> if { "windows-x64" } else { "linux-x64" } => targetName
    prepareRequest -> prepareTestLibraryFiles(paths, sourceIndices, symbolIndices, targetName, path.nativeStyle()) => context
    context -> diagnostics.blockingDiagnosticCount => semanticDiagnosticCount
    context -> irInvariantDiagnosticCount => irDiagnosticCount
    semanticDiagnosticCount + irDiagnosticCount => diagnosticCount!
    context -> diagnostics.comInteropFunctionCount => comInteropCount
    comInteropCount > 0 -> if { diagnosticCount! + 1 => diagnosticCount! }
    diagnosticCount! == 0 -> if {
        target.dataLayoutLine -> println
        target.tripleLine -> println
        targetKind == 0 -> if { context -> emitWindowsContext } else { context -> emitLinuxContext }
    } else {
        context -> diagnostics.emitBlockingDiagnostics
        context -> emitIrInvariantDiagnostics
    }
    owners! -> len => ownerCount
    diagnosticCount!
}

public emitWasmCheckedFiles paths: move [Text; ~] -> Int uses Console, File {
    [file.SourceText; ~] => owners!
    0 => pathIndex!
    pathIndex! < (paths -> len) -> while {
        paths[pathIndex!] -> file.mapText => owner
        owners! -> push(owner)
        pathIndex! + 1 => pathIndex!
    }
    [Text; ~] => sources!
    0 => sourceIndex!
    sourceIndex! < (owners! -> len) -> while {
        owners![sourceIndex!] -> len => sourceLength
        owners![sourceIndex!] -> slice(UIntSize(0), sourceLength) => source
        sources! -> push(source)
        sourceIndex! + 1 => sourceIndex!
    }
    sources! -> emitWasmChecked => diagnosticCount
    owners! -> len => ownerCount
    diagnosticCount
}
