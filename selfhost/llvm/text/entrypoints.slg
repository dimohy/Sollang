        unresolvedNominalMemberHasFields! -> if { 33 => code! }
    }
    # A nominal struct literal must name the identity that owns its field table.
    # Coordinate-equivalent duplicates cannot safely drive field ABI selection.
    (code! == 0
        and node.kind == 12
        and node.typeId >= 0
        and context.types[node.typeId].kind == 1) -> if {
        false => structOwnerInvariantHasFields!
        false => structOwnerInvariantEquivalentHasFields!
        context.types[node.typeId] => structOwnerInvariantType
        0 => structOwnerInvariantFieldSearch!
        structOwnerInvariantFieldSearch! < (context.fields -> len)
            -> while {
            context.fields[structOwnerInvariantFieldSearch!] => structOwnerInvariantField
            (structOwnerInvariantField.status == 0 and structOwnerInvariantField.ownerType == node.typeId)
                -> if { true => structOwnerInvariantHasFields! }
            context.types[structOwnerInvariantField.ownerType] => structOwnerInvariantCandidateType
            (structOwnerInvariantCandidateType.kind == 1
                and structOwnerInvariantCandidateType.origin == structOwnerInvariantType.origin
                and structOwnerInvariantCandidateType.module == structOwnerInvariantType.module
                and structOwnerInvariantCandidateType.symbol == structOwnerInvariantType.symbol)
                    -> if {
                structOwnerInvariantField.status == 0 -> if { true => structOwnerInvariantEquivalentHasFields! }
            }
            structOwnerInvariantFieldSearch! + 1 => structOwnerInvariantFieldSearch!
        }
        (not structOwnerInvariantHasFields! and structOwnerInvariantEquivalentHasFields!)
            -> if { 35 => code! }
    }
    # Arithmetic is emitted at the widest operand width. Its semantic result
    # must name that same width; otherwise LLVM text can declare an i16 call
    # argument while referencing an i32 SSA producer.
    (code! == 0
        and node.kind == 8
        and node.opcode >= grammar.tokenIdPlus()
        and node.opcode <= grammar.tokenIdPercent()
        and node.operand0 >= 0
        and node.operand0 < irCount
        and node.operand1 >= 0
        and node.operand1 < irCount) -> if {
        node -> irScalarIntegerWidth(context) => arithmeticResultWidth
        context.ir[node.operand0] -> irScalarIntegerWidth(context) => arithmeticLeftWidth
        context.ir[node.operand1] -> irScalarIntegerWidth(context) => arithmeticRightWidth
        arithmeticLeftWidth > arithmeticRightWidth -> if { arithmeticLeftWidth } else { arithmeticRightWidth } => arithmeticStorageWidth
        ((node -> irAggregateStorageClass) > 0 and arithmeticStorageWidth > 0)
            -> if { 37 => code! }
        (code! == 0
            and arithmeticResultWidth > 0
            and arithmeticStorageWidth > 0
            and arithmeticResultWidth != arithmeticStorageWidth)
                -> if { 15 => code! }
    }
    # A scalar local alias may start from a parameter name, whose ABI value is
    # written directly as %arg/%argN and therefore has no standalone SSA node.
    # Any other unresolved scalar name used as a binding initializer would
    # become an undefined %v reference in LLVM.
    (code! == 0
        and node.kind == 17
        and node.operand0 >= 0
        and node.operand0 < irCount
        and context.ir[node.operand0].kind == 5
        and context.ir[node.operand0].operand0 < 0
        and (context.ir[node.operand0] -> irScalarIntegerWidth(context)) > 0)
            -> if {
        node.parent => aliasOwner!
        (aliasOwner! >= 0 and context.ir[aliasOwner!].kind != 0 and context.ir[aliasOwner!].kind != 11)
            -> while {
            context.ir[aliasOwner!].parent => aliasOwner!
        }
        (aliasOwner! >= 0
            and context.ir[aliasOwner!].kind == 0
            and (context -> parameterIndexForFunction(aliasOwner!, context.ir[node.operand0].symbol)) < 0)
                -> if {
            16 => code!
        }
    }
    # A direct pattern read is an SSA alias of its canonical enum payload
    # binding.  Any type difference here would make the textual emitter name
    # one LLVM type for a value produced with another (for example
    # `freeze void %payload`).  Reject that Typed IR before emission.
    (code! == 0
        and node.kind == 5
        and node.operand0 >= 0
        and node.operand0 < irCount
        and context.ir[node.operand0].kind == 29
        and node.typeId != context.ir[node.operand0].typeId)
            -> if {
        43 => code!
    }
    # Resolved direct and flow calls have one explicit linked argument slot for
    # every runtime parameter. Compile-time value parameters are supplied from
    # generic syntax and are intentionally excluded. This gate turns a broken
    # call chain into a producer diagnostic before malformed LLVM can execute.
    (code! == 0
        and (node.kind == 6 or node.kind == 9)
        and node.targetModule >= 0
        and node.symbol >= 0)
            -> if {
        context -> concreteCallFunctionIndex(irIndex, functions) => callInvariantFunction
        callInvariantFunction >= 0 -> if {
            context -> runtimeParameterCount(callInvariantFunction) => callInvariantExpected
            context -> linkedCallArgumentCount(irIndex, callInvariantExpected) => callInvariantActual
            context -> implicitFlowArgumentCount(irIndex) => callInvariantImplicit
            callInvariantActual + callInvariantImplicit != callInvariantExpected -> if { 42 => code! }
        }
    }
    code!
}

irInvariantDiagnosticCount context: ref emitterContext.EmitContext -> Int {
    context -> concreteFunctionsBySymbol => functions
    0 => count!
    0 => irIndex!
    irIndex! < (context.ir -> len) -> while {
        (context -> irInvariantCode(irIndex!, functions)) != 0 -> if { count! + 1 => count! }
        irIndex! + 1 => irIndex!
    }
    count!
}

emitIrInvariantDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    context -> concreteFunctionsBySymbol => functions
    0 => irIndex!
    irIndex! < (context.ir -> len) -> while {
        context -> irInvariantCode(irIndex!, functions) => invariantCode
        invariantCode != 0 -> if {
            context.ir[irIndex!] => node
            irIndex! => diagnosticIrIndex
            node.sourceModule => sourceModule
            node.astNode => astNode
            context.ranges[sourceModule] => diagnosticRange
            context.nodes[diagnosticRange.astStart + astNode] => diagnosticAst
            invariantCode == 13 -> if {
                context.ir[node.operand0] => diagnosticArrayElement
                "; sollang compiler error S006: non-empty array literal has no canonical storage type at ir $diagnosticIrIndex (arrayType $(node.typeId)/$(node.typeKind)/$(node.typeOrigin)/$(node.typeModule)/$(node.typeSymbol), first $(node.operand0), firstType $(diagnosticArrayElement.typeId)/$(diagnosticArrayElement.typeKind)/$(diagnosticArrayElement.typeOrigin)/$(diagnosticArrayElement.typeModule)/$(diagnosticArrayElement.typeSymbol), firstSource $(diagnosticArrayElement.operand0), source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
            } else {
            invariantCode == 14 -> if {
                "; sollang compiler error S007: array literal storage element type disagrees with its first lowered operand at ir $diagnosticIrIndex (source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
            } else {
            invariantCode == 15 -> if {
                node -> irScalarIntegerWidth(context) => diagnosticResultWidth
                context.ir[node.operand0] => diagnosticLeft
                context.ir[node.operand1] => diagnosticRight
                diagnosticLeft -> irScalarIntegerWidth(context) => diagnosticLeftWidth
                diagnosticRight -> irScalarIntegerWidth(context) => diagnosticRightWidth
                "; sollang compiler error S008: arithmetic result width $diagnosticResultWidth disagrees with emitted operand widths $diagnosticLeftWidth/$diagnosticRightWidth at ir $diagnosticIrIndex (types $(node.typeSymbol)/$(diagnosticLeft.typeSymbol)/$(diagnosticRight.typeSymbol), source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
            } else {
            invariantCode == 16 -> if {
                "; sollang compiler error S009: scalar binding initializer has no binding or parameter value source at ir $diagnosticIrIndex (source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
            } else {
            invariantCode == 17 -> if {
                "; sollang compiler error S010: inverse guard identity disagrees between AST and Typed IR at ir $diagnosticIrIndex (source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
            } else {
            invariantCode == 11 -> if {
                "; sollang compiler error S011: enum subject pattern does not lower to an enum constructor at ir $diagnosticIrIndex (source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
            } else {
            invariantCode == 18 -> if {
                "; sollang compiler error S012: subject when has no canonical comparison subject at ir $diagnosticIrIndex (source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
            } else {
            invariantCode == 19 -> if {
                context.ir[node.parent] => subjectArmDiagnostic
                subjectArmDiagnostic.parent => subjectControlDiagnosticIndex
                context.ir[subjectControlDiagnosticIndex] => subjectControlDiagnostic
                "; sollang compiler error S013: subject when comparison has no canonical left operand at ir $diagnosticIrIndex (left $(node.operand0), expected $(subjectControlDiagnostic.operand0), arm $(node.parent)/$(subjectArmDiagnostic.kind), control $subjectControlDiagnosticIndex/$(subjectControlDiagnostic.kind), source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
            } else {
            invariantCode == 8 -> if {
