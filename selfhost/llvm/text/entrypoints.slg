                            }
                            memberOwnerDiagnosticTakeSearch! + 1 => memberOwnerDiagnosticTakeSearch!
                        }
                        context.ir[memberOwnerDiagnosticControl].operand0 => memberOwnerDiagnosticSubject
                        memberOwnerDiagnosticSubject >= 0 -> if {
                            context.ir[memberOwnerDiagnosticSubject].kind => memberOwnerDiagnosticSubjectNodeKind!
                            context.ir[memberOwnerDiagnosticSubject].opcode => memberOwnerDiagnosticSubjectNodeOpcode!
                            context.ir[memberOwnerDiagnosticSubject].parent => memberOwnerDiagnosticSubjectNodeParent!
                            context.ir[memberOwnerDiagnosticSubject].operand0 => memberOwnerDiagnosticSubjectNodeOperand0!
                            context.ir[memberOwnerDiagnosticSubject].nextOperand => memberOwnerDiagnosticSubjectNodeNext!
