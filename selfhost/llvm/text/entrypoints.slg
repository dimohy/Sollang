public emitCheckedFiles paths: [Text; ~] -> Int uses Console, File {
    [file.SourceText; ~] => owners!
    0 => pathIndex!
    pathIndex! < (paths -> len) -> while {
        paths[pathIndex!] -> file.mapText => owner!
        owners! -> push(owner!)
        pathIndex! + 1 => pathIndex!
    }
    [Text; ~] => sources!
    0 => sourceIndex!
    sourceIndex! < (owners! -> len) -> while {
        owners![sourceIndex!] -> len => sourceLength
        owners![sourceIndex!] -> slice(UIntSize(0), sourceLength) => source
        sources! -> push(source)
        sourceIndex! + 1 => sourceIndex!
    }
    llvmTarget.windowsX64 => target
    PrepareRequest { sources: sources!, pointerBitWidth: target.pointerBitWidth, supportsComputePool: true, expectedPathStyle: 1 } => prepareRequest!
    prepareRequest! -> prepareLibraryFiles(paths, "windows-x64", path.nativeStyle) => context!
    context! -> diagnostics.blockingDiagnosticCount => diagnosticCount
    diagnosticCount == 0 -> if {
        target.dataLayoutLine -> println
        target.tripleLine -> println
        context! -> emitWindowsContext
    } else { context! -> diagnostics.emitBlockingDiagnostics }
    owners! -> len => ownerCount
    diagnosticCount
}

public emitLinuxCheckedFiles paths: [Text; ~] -> Int uses Console, File {
    [file.SourceText; ~] => owners!
    0 => pathIndex!
    pathIndex! < (paths -> len) -> while {
        paths[pathIndex!] -> file.mapText => owner!
        owners! -> push(owner!)
        pathIndex! + 1 => pathIndex!
    }
    [Text; ~] => sources!
    0 => sourceIndex!
    sourceIndex! < (owners! -> len) -> while {
        owners![sourceIndex!] -> len => sourceLength
        owners![sourceIndex!] -> slice(UIntSize(0), sourceLength) => source
        sources! -> push(source)
        sourceIndex! + 1 => sourceIndex!
    }
    llvmTarget.linuxX64 => target
    PrepareRequest { sources: sources!, pointerBitWidth: target.pointerBitWidth, supportsComputePool: true, expectedPathStyle: 0 } => prepareRequest!
    prepareRequest! -> prepareLibraryFiles(paths, "linux-x64", path.nativeStyle) => context!
    context! -> diagnostics.blockingDiagnosticCount => diagnosticCount!
    context! -> diagnostics.comInteropFunctionCount => comInteropCount
    comInteropCount > 0 -> if { diagnosticCount! + 1 => diagnosticCount! }
    diagnosticCount! == 0 -> if {
        target.dataLayoutLine -> println
        target.tripleLine -> println
        context! -> emitLinuxContext
    } else {
        context! -> diagnostics.emitBlockingDiagnostics
        comInteropCount > 0 -> if { "Linux" -> diagnostics.emitComTargetDiagnostic }
    }
    owners! -> len => ownerCount
    diagnosticCount!
}

public emitWasmCheckedFiles paths: [Text; ~] -> Int uses Console, File {
    [file.SourceText; ~] => owners!
    0 => pathIndex!
    pathIndex! < (paths -> len) -> while {
        paths[pathIndex!] -> file.mapText => owner!
        owners! -> push(owner!)
        pathIndex! + 1 => pathIndex!
    }
    [Text; ~] => sources!
    0 => sourceIndex!
    sourceIndex! < (owners! -> len) -> while {
        owners![sourceIndex!] -> len => sourceLength
        owners![sourceIndex!] -> slice(UIntSize(0), sourceLength) => source
        sources! -> push(source)
        sourceIndex! + 1 => sourceIndex!
    }
    sources! -> emitWasmChecked => diagnosticCount
    owners! -> len => ownerCount
    diagnosticCount
}
