                        -> if {
                        true => nominalDependentHasField!
                        (nominalDependentField.fieldType < 0 or typeLayoutStatuses![nominalDependentField.fieldType] != 0)
                            -> if {
                            false => nominalDependentReady!
                        } else {
                            typeAligns![nominalDependentField.fieldType] > nominalDependentAlign!
                                -> if {
                                typeAligns![nominalDependentField.fieldType] => nominalDependentAlign!
                            }
                            ((nominalDependentSize! + typeAligns![nominalDependentField.fieldType] - 1) / typeAligns![nominalDependentField.fieldType]) * typeAligns![nominalDependentField.fieldType] => nominalDependentSize!
                            nominalDependentSize! + typeSizes![nominalDependentField.fieldType] => nominalDependentSize!
                        }
                    }
                    nominalDependentFieldIndex! + 1 => nominalDependentFieldIndex!
                }
                (nominalDependentReady!
                    and (nominalDependentHasField! or nominalDependentType.kind == 10))
                    -> if {
                    ((nominalDependentSize! + nominalDependentAlign! - 1) / nominalDependentAlign!) * nominalDependentAlign! => nominalDependentSize!
                    (typeSizes![nominalDependentLayoutIndex!] != nominalDependentSize! or typeAligns![nominalDependentLayoutIndex!] != nominalDependentAlign!)
                        -> if {
                        nominalDependentSize! => typeSizes![nominalDependentLayoutIndex!]
                        nominalDependentAlign! => typeAligns![nominalDependentLayoutIndex!]
                        0 => typeLayoutStatuses![nominalDependentLayoutIndex!]
                        true => nominalDependentLayoutChanged!
                        true => aggregateLayoutChanged!
                    }
                }
            }
            (nominalDependentType.kind == 4
                and nominalDependentType.first >= 0
                and nominalDependentType.length >= 0
                and typeLayoutStatuses![nominalDependentType.first] == 0)
                    -> if {
                typeSizes![nominalDependentType.first] * nominalDependentType.length => nominalDependentArraySize
                typeAligns![nominalDependentType.first] => nominalDependentArrayAlign
                (typeSizes![nominalDependentLayoutIndex!] != nominalDependentArraySize or typeAligns![nominalDependentLayoutIndex!] != nominalDependentArrayAlign)
                    -> if {
                    nominalDependentArraySize => typeSizes![nominalDependentLayoutIndex!]
                    nominalDependentArrayAlign => typeAligns![nominalDependentLayoutIndex!]
                    0 => typeLayoutStatuses![nominalDependentLayoutIndex!]
                    true => nominalDependentLayoutChanged!
                    true => aggregateLayoutChanged!
                }
            }
            nominalDependentLayoutIndex! + 1 => nominalDependentLayoutIndex!
        }
        }
        # Imported and local references can have distinct canonical type IDs
        # for the same nominal declaration. Only one representative owns the
        # recovered field table, so publish its converged layout to every
        # equivalent (module, symbol) identity before sizing outer enums.
        0 => nominalLayoutPublishIndex!
        nominalLayoutPublishIndex! < (semanticTypes! -> len)
            -> while {
            semanticTypes![nominalLayoutPublishIndex!] => nominalLayoutPublishType
            nominalLayoutPublishType.kind == 1
                -> if {
                typeSizes![nominalLayoutPublishIndex!] => publishedNominalSize!
                typeAligns![nominalLayoutPublishIndex!] => publishedNominalAlign!
                0 => publishedNominalFieldSize!
                1 => publishedNominalFieldAlign!
                false => publishedNominalHasField!
                0 => publishedNominalFieldIndex!
                publishedNominalFieldIndex! < (semanticFields! -> len)
                    -> while {
                    semanticFields![publishedNominalFieldIndex!] => publishedNominalField
                    publishedNominalField.ownerType >= 0 -> if {
                        semanticTypes![publishedNominalField.ownerType] => publishedNominalOwner
                        (publishedNominalField.status == 0
                            and publishedNominalOwner.module == nominalLayoutPublishType.module
                            and publishedNominalOwner.symbol == nominalLayoutPublishType.symbol
                            and publishedNominalField.fieldType >= 0
                            and typeLayoutStatuses![publishedNominalField.fieldType] == 0)
                            -> if {
                            true => publishedNominalHasField!
                            typeAligns![publishedNominalField.fieldType] > publishedNominalFieldAlign!
                                -> if { typeAligns![publishedNominalField.fieldType] => publishedNominalFieldAlign! }
                            ((publishedNominalFieldSize! + typeAligns![publishedNominalField.fieldType] - 1) / typeAligns![publishedNominalField.fieldType]) * typeAligns![publishedNominalField.fieldType] => publishedNominalFieldSize!
                            publishedNominalFieldSize! + typeSizes![publishedNominalField.fieldType] => publishedNominalFieldSize!
                        }
                    }
                    publishedNominalFieldIndex! + 1 => publishedNominalFieldIndex!
                }
                publishedNominalHasField! -> if {
                    ((publishedNominalFieldSize! + publishedNominalFieldAlign! - 1) / publishedNominalFieldAlign!) * publishedNominalFieldAlign! => publishedNominalFieldSize!
                    publishedNominalFieldSize! > publishedNominalSize!
                        -> if { publishedNominalFieldSize! => publishedNominalSize! }
                    publishedNominalFieldAlign! > publishedNominalAlign!
                        -> if { publishedNominalFieldAlign! => publishedNominalAlign! }
                }
                0 => nominalLayoutCandidateIndex!
                nominalLayoutCandidateIndex! < (semanticTypes! -> len)
                    -> while {
                    semanticTypes![nominalLayoutCandidateIndex!] => nominalLayoutCandidate
                    (nominalLayoutCandidate.status == 0
                        and nominalLayoutCandidate.kind == 1
                        and nominalLayoutCandidate.module == nominalLayoutPublishType.module
                        and nominalLayoutCandidate.symbol == nominalLayoutPublishType.symbol)
                        -> if {
                        typeSizes![nominalLayoutCandidateIndex!] > publishedNominalSize!
                            -> if { typeSizes![nominalLayoutCandidateIndex!] => publishedNominalSize! }
                        typeAligns![nominalLayoutCandidateIndex!] > publishedNominalAlign!
                            -> if { typeAligns![nominalLayoutCandidateIndex!] => publishedNominalAlign! }
                    }
                    nominalLayoutCandidateIndex! + 1 => nominalLayoutCandidateIndex!
                }
                (typeSizes![nominalLayoutPublishIndex!] != publishedNominalSize!
                    or typeAligns![nominalLayoutPublishIndex!] != publishedNominalAlign!)
                    -> if {
                    publishedNominalSize! => typeSizes![nominalLayoutPublishIndex!]
                    publishedNominalAlign! => typeAligns![nominalLayoutPublishIndex!]
                    0 => typeLayoutStatuses![nominalLayoutPublishIndex!]
                    true => aggregateLayoutChanged!
                }
            }
            nominalLayoutPublishIndex! + 1 => nominalLayoutPublishIndex!
        }
    }
    ir! -> typedIr.movesFrom => moves
    [Text; ~] => contextSources!
    0 => contextSourceIndex!
    contextSourceIndex! < (request.sources -> len)
        -> while {
        contextSources! -> push(request.sources[contextSourceIndex!])
        contextSourceIndex! + 1 => contextSourceIndex!
    }
    emitterContext.EmitContext {
        sources: contextSources!
        ranges: analysisRanges!
        nodes: analysisNodes!
        tokens: analysisTokens!
        symbols: analysisSymbols!
        calls: analysisCalls!
        libraries: libraries
        libraryCalls: libraryCalls
        libraryCallDiagnostics: libraryCallDiagnostics
        interpolationRanges: analysisInterpolationRanges!
        interpolations: analysisInterpolations!
        ir: ir!
        streamPlan: streamPlan
        moves: moves
        nominal: nominal!
        composite: composite!
        modules: moduleIdentities!
        imports: importEdges!
        resolvedImports: resolvedImports!
        types: semanticTypes!
        fields: semanticFields!
        typeSizes: typeSizes!
        typeAligns: typeAligns!
        typeLayoutStatuses: typeLayoutStatuses!
        typeTraits: typeTraits!
        pointerBitWidth: pointerBitWidth
        supportsComputePool: supportsComputePool
        expectedPathStyle: expectedPathStyle
        usesConcurrentStreamJoins: usesConcurrentStreamJoins!
        ownershipDiagnostics: ownershipDiagnostics
    } => context
    context
}

prepare request: ref PrepareRequest -> emitterContext.EmitContext {
    request.sources -> semanticContext.prepare => prepared
    request -> prepareSnapshot(prepared, libraryImports.empty(), [libraryImports.LibraryFunctionResolution; ~])
}

emitWindowsContext context: emitterContext.EmitContext -> Unit uses Console {
    context -> diagnostics.usesParallelRuntime => capturesParallelOutput
    context -> diagnostics.usesTextRuntime => usesTextOutput
    context -> diagnostics.usesStandardError => usesStandardError
    context -> diagnostics.usesProcessRuntime => needsProcessRuntime
    context -> diagnostics.usesEnvironmentRuntime => needsEnvironmentRuntime
    context -> diagnostics.usesArgumentsRuntime => needsArgumentsRuntime
    context -> diagnostics.usesDirectoryRuntime => needsDirectoryRuntime
    context -> diagnostics.usesOwnedFileRuntime => needsOwnedFileRuntime
    context -> diagnostics.usesSocketRuntime => needsSocketRuntime
    context -> diagnostics.usesMouseEventsRuntime => needsMouseEventsRuntime
    context.usesConcurrentStreamJoins => needsConcurrentStreamJoins
    context -> diagnostics.comInteropFunctionCount => comInteropCount
    context -> diagnostics.nativeInteropFunctionCount => nativeInteropCount
    capturesParallelOutput -> if { computeRuntime.emitMemoryOutputSinkRuntime() }
    (usesTextOutput or capturesParallelOutput) -> if { capturesParallelOutput -> textOutputRuntime.emitWindowsTextRuntime(usesStandardError) }
    capturesParallelOutput -> if { computeRuntime.emitWindowsComputeRuntime() }
    context -> diagnostics.usesIntMaterialization
        -> if { numberFormat.emitIntFormatRuntime() }
    context -> diagnostics.usesIntInterpolation -> if { numberFormat.emitIntTextRuntime() }
    context -> diagnostics.usesBoolInterpolation -> if { numberFormat.emitBoolTextRuntime() }
    (usesStandardError and (context -> diagnostics.usesIntInterpolation))
        -> if { numberFormat.emitIntStandardErrorRuntime() }
    (usesStandardError and (context -> diagnostics.usesBoolInterpolation))
        -> if { numberFormat.emitBoolStandardErrorRuntime() }
    context -> diagnostics.usesSourceTextRuntime => needsSourceTextRuntime
    context -> diagnostics.usesStandardInputSourceTextRuntime => needsStandardInputSourceTextRuntime
    -1 => runtimeModule!
    0 => runtimeModuleSearch!
    runtimeModuleSearch! < (context.modules -> len)
        -> while {
        context.modules[runtimeModuleSearch!] => moduleIdentity
        moduleIdentity.pathHash == 12254170256457402476
            -> if { moduleIdentity.sourceIndex => runtimeModule! }
        runtimeModuleSearch! + 1 => runtimeModuleSearch!
    }
    (needsOwnedFileRuntime or needsSourceTextRuntime or runtimeModule! >= 0)
        -> if {
        "declare dllimport ptr @CreateFileA(ptr, i32, i32, ptr, i32, i32, ptr)" -> println
    }
    (capturesParallelOutput or needsMouseEventsRuntime or needsConcurrentStreamJoins)
        -> if {
        "declare dllimport ptr @CreateThread(ptr, i64, ptr, ptr, i32, ptr)" -> println
        "declare dllimport i32 @WaitForSingleObject(ptr, i32)" -> println
    }
    (needsOwnedFileRuntime or needsDirectoryRuntime or needsSourceTextRuntime or runtimeModule! >= 0 or capturesParallelOutput or needsMouseEventsRuntime or needsConcurrentStreamJoins)
        -> if {
        "declare dllimport i32 @CloseHandle(ptr)" -> println
    }
    needsDirectoryRuntime -> if {
        "declare dllimport i32 @CreateDirectoryA(ptr, ptr)" -> println
        "declare dllimport i32 @GetFileAttributesA(ptr)" -> println
        "declare dllimport ptr @FindFirstFileA(ptr, ptr)" -> println
        "declare dllimport i32 @FindNextFileA(ptr, ptr)" -> println
        "declare dllimport i32 @FindClose(ptr)" -> println
        "declare dllimport void @SetLastError(i32)" -> println
        "declare dllimport i32 @GetLastError()" -> println
        "declare dllimport ptr @CreateFileW(ptr, i32, i32, ptr, i32, i32, ptr)" -> println
        "declare dllimport i32 @GetFinalPathNameByHandleW(ptr, ptr, i32, i32)" -> println
        "declare dllimport i32 @GetFileInformationByHandle(ptr, ptr)" -> println
        (not usesTextOutput and not capturesParallelOutput)
            -> if {
            "declare dllimport i32 @MultiByteToWideChar(i32, i32, ptr, i32, ptr, i32)" -> println
        }
        "declare dllimport i32 @WideCharToMultiByte(i32, i32, ptr, i32, ptr, i32, ptr, ptr)" -> println
    }
    needsArgumentsRuntime -> if {
        "declare dllimport ptr @GetCommandLineW()" -> println
        "declare dllimport ptr @CommandLineToArgvW(ptr, ptr)" -> println
        "declare dllimport ptr @LocalFree(ptr)" -> println
        not needsDirectoryRuntime -> if {
            "declare dllimport i32 @WideCharToMultiByte(i32, i32, ptr, i32, ptr, i32, ptr, ptr)" -> println
        }
    }
    needsEnvironmentRuntime -> if {
        "declare ptr @_wgetenv(ptr)" -> println
        (not usesTextOutput and not capturesParallelOutput and not needsDirectoryRuntime)
            -> if {
            "declare dllimport i32 @MultiByteToWideChar(i32, i32, ptr, i32, ptr, i32)" -> println
        }
        (not needsDirectoryRuntime and not needsArgumentsRuntime)
            -> if {
            "declare dllimport i32 @WideCharToMultiByte(i32, i32, ptr, i32, ptr, i32, ptr, ptr)" -> println
        }
        environmentRuntime.emitTypeRuntime()
    }
    (needsOwnedFileRuntime and runtimeModule! < 0)
        -> if {
        (not usesTextOutput and not capturesParallelOutput)
            -> if {
            "declare dllimport i32 @WriteFile(ptr, ptr, i32, ptr, ptr)" -> println
        }
    }
    needsProcessRuntime -> if { processRuntime.emitProcessTypeRuntime() }
    needsSocketRuntime -> if { socketRuntime.emitTypeRuntime() }
    needsSocketRuntime -> if { "declare i64 @strlen(ptr)" -> println }
    comInteropCount > 0 -> if { nativeInteropCount == 0 -> comRuntime.emitWindowsComRuntime }
    context -> emitCore
    needsSocketRuntime -> if { socketRuntime.emitWindowsRuntime() }
    needsEnvironmentRuntime -> if { environmentRuntime.emitWindowsRuntime() }
    needsMouseEventsRuntime -> if { mouseEventRuntime.emitWindowsMouseEventRuntime() }
    needsProcessRuntime -> if { processRuntime.emitWindowsProcessRuntime() }
    needsDirectoryRuntime -> if { llvmRuntime.emitWindowsDirectory() }
    needsOwnedFileRuntime -> if { llvmRuntime.emitWindowsOwnedFile() }
    runtimeModule! >= 0 -> if {
        runtimeModule! -> runtimeFunctionSymbols(context) => runtimeSymbols
        runtimeModule! -> llvmRuntime.emitWindows(runtimeSymbols)
    }
    needsSourceTextRuntime -> if {
        runtimeModule! < 0 -> if { llvmRuntime.emitWindowsSourceTextDeclarations() }
        llvmRuntime.emitWindowsSourceText()
        needsStandardInputSourceTextRuntime -> if {
            (not usesTextOutput and not capturesParallelOutput)
                -> if { "declare dllimport ptr @GetStdHandle(i32)" -> println }
            not needsOwnedFileRuntime -> if { "declare dllimport i32 @ReadFile(ptr, ptr, i32, ptr, ptr)" -> println }
            not needsDirectoryRuntime -> if { "declare dllimport i32 @GetLastError()" -> println }
            llvmRuntime.emitWindowsStandardInputSourceText()
        }
    }
}

emitLinuxContext context: emitterContext.EmitContext -> Unit uses Console {
    context -> diagnostics.usesParallelRuntime => capturesParallelOutput
    context -> diagnostics.usesTextRuntime => usesTextOutput
    context -> diagnostics.usesStandardError => usesStandardError
    context -> diagnostics.usesProcessRuntime => needsProcessRuntime
    context -> diagnostics.usesEnvironmentRuntime => needsEnvironmentRuntime
    context -> diagnostics.usesSourceTextRuntime => needsSourceTextRuntime
    context -> diagnostics.usesStandardInputSourceTextRuntime => needsStandardInputSourceTextRuntime
    context -> diagnostics.usesDirectoryRuntime => needsDirectoryRuntime
    context -> diagnostics.usesOwnedFileRuntime => needsOwnedFileRuntime
    context -> diagnostics.usesSocketRuntime => needsSocketRuntime
    context -> diagnostics.usesMouseEventsRuntime => needsMouseEventsRuntime
    context.usesConcurrentStreamJoins => needsConcurrentStreamJoins
    -1 => runtimeModule!
    0 => runtimeModuleSearch!
    runtimeModuleSearch! < (context.modules -> len)
        -> while {
        context.modules[runtimeModuleSearch!] => moduleIdentity
        moduleIdentity.pathHash == 12254170256457402476
            -> if { moduleIdentity.sourceIndex => runtimeModule! }
        runtimeModuleSearch! + 1 => runtimeModuleSearch!
    }
    (capturesParallelOutput or needsMouseEventsRuntime or needsConcurrentStreamJoins)
        -> if {
        "declare i32 @pthread_create(ptr, ptr, ptr, ptr)" -> println
        "declare i32 @pthread_join(i64, ptr)" -> println
    }
    capturesParallelOutput -> if { computeRuntime.emitMemoryOutputSinkRuntime() }
    (usesTextOutput or capturesParallelOutput) -> if { capturesParallelOutput -> textOutputRuntime.emitLinuxTextRuntime(usesStandardError) }
    capturesParallelOutput -> if { computeRuntime.emitLinuxComputeRuntime() }
    context -> diagnostics.usesIntMaterialization
        -> if { numberFormat.emitIntFormatRuntime() }
    context -> diagnostics.usesIntInterpolation -> if { numberFormat.emitIntTextRuntime() }
    context -> diagnostics.usesBoolInterpolation -> if { numberFormat.emitBoolTextRuntime() }
    (usesStandardError and (context -> diagnostics.usesIntInterpolation))
        -> if { numberFormat.emitIntStandardErrorRuntime() }
    (usesStandardError and (context -> diagnostics.usesBoolInterpolation))
        -> if { numberFormat.emitBoolStandardErrorRuntime() }
    needsProcessRuntime -> if { processRuntime.emitProcessTypeRuntime() }
    needsEnvironmentRuntime -> if { environmentRuntime.emitTypeRuntime() }
    needsSocketRuntime -> if { socketRuntime.emitTypeRuntime() }
    context -> emitCore
    (needsSocketRuntime or needsDirectoryRuntime)
        -> if {
        "declare ptr @__errno_location()" -> println
        "declare i64 @strlen(ptr)" -> println
    }
    needsSocketRuntime -> if { socketRuntime.emitLinuxRuntime() }
    needsEnvironmentRuntime -> if { environmentRuntime.emitLinuxRuntime() }
    needsMouseEventsRuntime -> if { usesTextOutput -> mouseEventRuntime.emitLinuxMouseEventRuntime }
    needsProcessRuntime -> if { capturesParallelOutput -> processRuntime.emitLinuxProcessRuntime }
    needsDirectoryRuntime -> if { llvmRuntime.emitLinuxDirectory() }
    needsOwnedFileRuntime -> if { not needsProcessRuntime -> llvmRuntime.emitLinuxOwnedFile }
    runtimeModule! >= 0 -> if {
        runtimeModule! -> runtimeFunctionSymbols(context) => runtimeSymbols
        runtimeModule! -> llvmRuntime.emitLinux(runtimeSymbols)
    }
    needsSourceTextRuntime -> if {
        (not needsProcessRuntime and not needsOwnedFileRuntime)
            -> if { "declare i32 @open(ptr, i32, i32)" -> println }
        (not capturesParallelOutput and not needsProcessRuntime and not needsOwnedFileRuntime)
            -> if { "declare i32 @close(i32)" -> println }
        llvmRuntime.emitLinuxSourceTextDeclarations()
        llvmRuntime.emitLinuxSourceText()
        needsStandardInputSourceTextRuntime -> if {
            (not capturesParallelOutput and not needsMouseEventsRuntime)
                -> if { "declare i64 @read(i32, ptr, i64)" -> println }
            llvmRuntime.emitLinuxStandardInputSourceText()
        }
    }
}

emitWasmContext context: emitterContext.EmitContext -> Unit uses Console {
    context -> diagnostics.usesTextRuntime -> if { textOutputRuntime.emitWasmTextRuntime() }
    context -> diagnostics.usesIntMaterialization
        -> if { numberFormat.emitIntFormatRuntime() }
    context -> diagnostics.usesIntInterpolation -> if { numberFormat.emitIntTextRuntime() }
    context -> diagnostics.usesBoolInterpolation -> if { numberFormat.emitBoolTextRuntime() }
    "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1 immarg)" -> println
    "declare void @llvm.memset.p0.i64(ptr, i8, i64, i1 immarg)" -> println
    context -> emitCore
}

syntaxDiagnosticCount sources: [Text; ~] -> Int {
    0 => count!
    0 => sourceIndex!
    sourceIndex! < (sources -> len) -> while {
        sources[sourceIndex!] -> syntaxDiagnostics.analyze => sourceDiagnostics
        count! + Int(sourceDiagnostics -> len) => count!
        sourceIndex! + 1 => sourceIndex!
    }
    count!
}

emitSyntaxDiagnostics sources: [Text; ~] -> Unit uses Console {
    0 => sourceIndex!
    sourceIndex! < (sources -> len) -> while {
        sourceIndex! => diagnosticSourceIndex
        sources[sourceIndex!] -> syntaxDiagnostics.analyze => sourceDiagnostics
        (sourceDiagnostics -> len) > 0 -> if {
            sourceDiagnostics[0] => diagnostic
            diagnostic.code == 1 -> if {
                sources[sourceIndex!] -> slice(diagnostic.span.start, diagnostic.span.length) => unexpected
                "; sollang syntax error: unexpected character '$unexpected' (source $diagnosticSourceIndex, byte $(diagnostic.span.start), length $(diagnostic.span.length))" -> println
            } else {
                diagnostic.code == 3 -> if {
                    "; sollang syntax error: unterminated string literal (source $diagnosticSourceIndex, byte $(diagnostic.span.start), length $(diagnostic.span.length))" -> println
                } else {
                    sources[sourceIndex!] -> syntaxDiagnostics.expectedCodes => expected
                    expected[(expected -> len) - 1] => expectedCode
                    expectedCode >= 0 -> if {
                        grammar.tokenNames() => tokenNames
                        "; sollang syntax error: expected $(tokenNames[expectedCode]) (source $diagnosticSourceIndex, byte $(diagnostic.span.start), length $(diagnostic.span.length))" -> println
                    } else {
                        grammar.keywordTexts() => keywordTexts
                        0 - expectedCode - 1 => keywordIndex
                        "; sollang syntax error: expected '$(keywordTexts[keywordIndex])' (source $diagnosticSourceIndex, byte $(diagnostic.span.start), length $(diagnostic.span.length))" -> println
                    }
                }
            }
        }
        sourceIndex! + 1 => sourceIndex!
    }
}

public emit sources: move [Text; ~] -> Unit uses Console {
    llvmTarget.windowsX64() => target
    target.dataLayoutLine -> println
    target.tripleLine -> println
    PrepareRequest { sources: sources, pointerBitWidth: target.pointerBitWidth, supportsComputePool: true, expectedPathStyle: 1 } => prepareRequest
    prepareRequest -> prepare => context
    context -> emitWindowsContext
}

public emitLinux sources: move [Text; ~] -> Unit uses Console {
    llvmTarget.linuxX64() => target
    target.dataLayoutLine -> println
    target.tripleLine -> println
    PrepareRequest { sources: sources, pointerBitWidth: target.pointerBitWidth, supportsComputePool: true, expectedPathStyle: 0 } => prepareRequest
    prepareRequest -> prepare => context
    context -> diagnostics.comInteropFunctionCount => comInteropCount
    comInteropCount == 0 -> if { context -> emitLinuxContext } else { "Linux" -> diagnostics.emitComTargetDiagnostic }
}

public emitWasm sources: move [Text; ~] -> Unit uses Console {
    llvmTarget.wasm32Browser() => target
    PrepareRequest { sources: sources, pointerBitWidth: target.pointerBitWidth, supportsComputePool: false, expectedPathStyle: 0 } => prepareRequest
    prepareRequest -> prepare => context
    context -> diagnostics.nativeInteropFunctionCount => nativeInteropCount
    context -> diagnostics.comInteropFunctionCount => comInteropCount
    context.usesConcurrentStreamJoins => usesUnsupportedConcurrentStreamJoins
    context -> diagnostics.usesParallelBranches => usesUnsupportedParallel
    (nativeInteropCount == 0 and comInteropCount == 0 and not usesUnsupportedConcurrentStreamJoins and not usesUnsupportedParallel)
        -> if {
        target.dataLayoutLine -> println
        target.tripleLine -> println
        context -> emitWasmContext
    } else {
        nativeInteropCount > 0 -> if { diagnostics.emitWasmNativeInteropDiagnostic() }
        comInteropCount > 0 -> if { "wasm32-browser" -> diagnostics.emitComTargetDiagnostic }
        usesUnsupportedConcurrentStreamJoins -> if { diagnostics.emitWasmConcurrentStreamJoinDiagnostic() }
        usesUnsupportedParallel -> if { diagnostics.emitWasmParallelDiagnostic() }
    }
}

binaryOpcodeValid opcode: Int -> Bool {
    ((opcode >= grammar.tokenIdPlus() and opcode <= grammar.tokenIdPercent())
        or opcode == grammar.tokenIdEqualEqual()
        or opcode == grammar.tokenIdBangEqual()
        or (opcode >= grammar.tokenIdLessEqual() and opcode <= grammar.tokenIdGreater())
        or opcode == -24
        or opcode == -25)
}

irScalarIntegerWidth node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext -> Int {
    -1 => symbol!
    node.typeId >= 0 -> if {
        context.types[node.typeId] => scalarType
        (scalarType.kind == 1 and scalarType.origin == 1)
            -> if { scalarType.symbol => symbol! }
    } else {
        (node.typeKind == 1 and node.typeOrigin == 1)
            -> if { node.typeSymbol => symbol! }
    }
    0 => width!
    (symbol! == 3 or symbol! == 8) -> if { 8 => width! }
    (symbol! == 4 or symbol! == 9) -> if { 16 => width! }
    (symbol! == 2 or symbol! == 5 or symbol! == 10 or symbol! == 14)
        -> if { 32 => width! }
    (symbol! == 6 or symbol! == 7 or symbol! == 11)
        -> if { 64 => width! }
    (symbol! == 12 or symbol! == 13) -> if { context.pointerBitWidth => width! }
    width!
}

irAggregateStorageClass node: typedIr.TypedIrNode -> Int {
    0 => storageClass!
    node -> isDynamicArrayType -> if { 1 => storageClass! }
    node -> isTextType -> if { 2 => storageClass! }
    node -> isSliceArrayType -> if { 3 => storageClass! }
    node -> isFixedArrayType -> if { 4 => storageClass! }
    node -> isDictionaryType -> if { 5 => storageClass! }
    node -> isGenericEnumType -> if { 6 => storageClass! }
    storageClass!
}

astNodeHasDirectChildKind context: ref emitterContext.EmitContext, sourceModule: Int, astNode: Int, childKind: Int -> Bool {
    false => found!
    (sourceModule >= 0 and sourceModule < (context.ranges -> len))
        -> if {
        context.ranges[sourceModule] => sourceRange
        0 => candidateIndex!
        (not found! and candidateIndex! < sourceRange.astCount)
            -> while {
            context.nodes[sourceRange.astStart + candidateIndex!] => candidate
            (candidate.kind == childKind and candidate.parent == astNode)
                -> if { true => found! }
            candidateIndex! + 1 => candidateIndex!
        }
    }
    found!
}

concreteFunctionsBySymbol context: ref emitterContext.EmitContext -> [Int; ~] {
    [Int; ~] => functions!
    0 => symbolIndex!
    symbolIndex! < (context.symbols -> len) -> while {
        functions! -> push(-1)
        symbolIndex! + 1 => symbolIndex!
    }
    0 => candidateIndex!
    candidateIndex! < (context.ir -> len) -> while {
        context.ir[candidateIndex!] => candidate
        (candidate.kind == 0
            and candidate.sourceModule >= 0
            and candidate.sourceModule < (context.ranges -> len)
            and candidate.symbol >= 0)
                -> if {
            context.ranges[candidate.sourceModule].symbolStart + candidate.symbol
                => globalSymbol
            (globalSymbol >= 0 and globalSymbol < (functions! -> len))
                -> if { candidateIndex! => functions![globalSymbol] }
        }
        candidateIndex! + 1 => candidateIndex!
    }
    functions!
}

concreteCallFunctionIndex context: ref emitterContext.EmitContext, callIndex: Int, functions: ref [Int; ~] -> Int {
    context.ir[callIndex] => call
    -1 => resolved!
    (call.targetModule >= 0
        and call.targetModule < (context.ranges -> len)
        and call.symbol >= 0)
            -> if {
        context.ranges[call.targetModule].symbolStart + call.symbol => globalSymbol
        (globalSymbol >= 0 and globalSymbol < (functions -> len))
            -> if { functions[globalSymbol] => resolved! }
    }
    resolved!
}

runtimeParameterCount context: ref emitterContext.EmitContext, functionIndex: Int -> Int {
    0 => count!
    functionIndex >= 0 -> if {
        context.ir[functionIndex].operand1 => parameterIndex!
        0 => parameterOrdinal!
        parameterIndex! >= 0 -> while {
            context.ir[parameterIndex!] => parameter
            false => compileTimeValueParameter!
            (parameter.sourceModule >= 0
                and parameter.sourceModule < (context.ranges -> len)
                and parameter.symbol >= 0
                and parameter.symbol < context.ranges[parameter.sourceModule].symbolCount)
                    -> if {
                context.symbols[context.ranges[parameter.sourceModule].symbolStart + parameter.symbol].kind == 32
                    -> if { true => compileTimeValueParameter! }
            }
            not compileTimeValueParameter! -> if { count! + 1 => count! }
            parameterOrdinal! == 0 -> if {
                context.ir[functionIndex].nextOperand => parameterIndex!
            } else {
                parameter.nextOperand => parameterIndex!
            }
            parameterOrdinal! + 1 => parameterOrdinal!
        }
    }
    count!
}

linkedCallArgumentCount context: ref emitterContext.EmitContext, callIndex: Int, maximum: Int -> Int {
    0 => count!
    context.ir[callIndex].operand0 => argumentIndex!
    (argumentIndex! >= 0
        and argumentIndex! < (context.ir -> len)
        and count! < maximum) -> while {
        count! + 1 => count!
        context.ir[argumentIndex!].nextOperand => argumentIndex!
    }
    count!
}

implicitFlowArgumentCount context: ref emitterContext.EmitContext, callIndex: Int -> Int {
    0 => count!
    context.ir[callIndex].parent => ownerIndex
    (ownerIndex >= 0 and ownerIndex < (context.ir -> len))
        -> if {
        context.ir[ownerIndex] => owner
        (owner.kind == 6
            and (owner.opcode == -207
                or owner.opcode == -208
                or owner.opcode == -209)
            and owner.operand1 == callIndex)
                -> if { 1 => count! } else {
        (owner.kind == 39
            and owner.parent >= 0
            and owner.parent < (context.ir -> len)
            and (context.ir[owner.parent].kind == 37 or context.ir[owner.parent].kind == 38))
                -> if { 1 => count! }
        }
    }
    count!
}

# Typed IR must be structurally valid before any LLVM text is emitted. These
# codes identify the producer invariant, not an LLVM parser failure.
public irInvariantCode context: ref emitterContext.EmitContext, irIndex: Int, functions: ref [Int; ~] -> Int {
    context.ir[irIndex] => node
    context.ir -> len => irCount
    0 => code!
    node.kind == 7 -> if {
        (node.operand0 < 0 or node.operand0 >= irCount)
            -> if {
            1 => code!
        } else {
            context.ir[node.operand0] => operand
            (operand.kind == 9 and operand.opcode == -1) -> if { 2 => code! }
        }
    }
    node.kind == 8 -> if {
        false => enumPatternMarker!
        false => subjectConditionMarker!
        (node.sourceModule >= 0 and node.sourceModule < (context.ranges -> len))
            -> if {
            context.ranges[node.sourceModule] => binaryRange
            (node.astNode >= 0 and node.astNode < binaryRange.astCount)
                -> if {
                context.nodes[binaryRange.astStart + node.astNode] => binaryAst
                # An enum pattern is represented by the parser's kind-70
                # wrapper and a direct kind-59 child. Ordinary
                # subject-when comparisons share the same AST wrapper but
                # retain both binary operands, so they are not pattern nodes.
                (node.operand1 < 0
                    and binaryAst.kind == 70
                    and binaryAst.parent >= 0
                    and context.nodes[binaryRange.astStart + binaryAst.parent].kind == 58
                    and (context -> astNodeHasDirectChildKind(node.sourceModule, node.astNode, 59)))
                        -> if {
                    true => enumPatternMarker!
                }
                (binaryAst.kind == 70
                    and binaryAst.parent >= 0
                    and context.nodes[binaryRange.astStart + binaryAst.parent].kind == 58
                    and not (context -> astNodeHasDirectChildKind(node.sourceModule, node.astNode, 59)))
                        -> if {
                    true => subjectConditionMarker!
                }
            }
        }
        (node.operand0 < 0 or node.operand0 >= irCount)
            -> if { 3 => code! }
        (subjectConditionMarker! and code! == 0 and (node.operand1 < 0 or node.operand1 >= irCount))
            -> if { 19 => code! }
        (subjectConditionMarker!
            and code! == 0
            and node.parent >= 0
            and node.parent < irCount
            and context.ir[node.parent].kind == 19
            and context.ir[node.parent].parent >= 0
            and context.ir[node.parent].parent < irCount
            and context.ir[context.ir[node.parent].parent].kind == 34
            and node.operand0 != context.ir[context.ir[node.parent].parent].operand0)
                -> if { 19 => code! }
        (not enumPatternMarker! and not subjectConditionMarker! and code! == 0 and (node.operand1 < 0 or node.operand1 >= irCount))
            -> if { 4 => code! }
        (not enumPatternMarker! and code! == 0 and not (node.opcode -> binaryOpcodeValid))
            -> if { 5 => code! }
        (not enumPatternMarker! and code! == 0) -> if {
            context.ir[node.operand0] => left
            context.ir[node.operand1] => right
            (left.kind == 9 and left.opcode == -1) -> if { 6 => code! }
            (code! == 0 and right.kind == 9 and right.opcode == -1)
                -> if { 7 => code! }
        }
        (enumPatternMarker! and code! == 0 and context.ir[node.operand0].kind != 29)
            -> if { 11 => code! }
    }
    node.kind == 13 -> if {
        (node.operand0 < 0 or node.operand0 >= irCount)
            -> if { 8 => code! }
        (code! == 0 and node.operand0 >= 0 and node.operand0 < irCount)
            -> if {
            context.ir[node.operand0].typeId => memberOwnerTypeId!
            memberOwnerTypeId! < 0 -> if { 20 => code! }
            memberOwnerTypeId! >= (context.types -> len) -> if { 20 => code! }
            (code! == 0 and memberOwnerTypeId! >= 0 and context.types[memberOwnerTypeId!].kind == 8)
                -> if {
                context.types[memberOwnerTypeId!].first => memberOwnerTypeId!
            }
            memberOwnerTypeId! >= (context.types -> len) -> if { 20 => code! }
            # Structural products (kind 10) own fields in the recursive type
            # arena rather than in a source module's nominal symbol table.
            # They are canonical member owners and lower through extractvalue.
            (code! == 0
                and memberOwnerTypeId! >= 0
                and context.types[memberOwnerTypeId!].kind != 1
                and context.types[memberOwnerTypeId!].kind != 10)
                    -> if { 20 => code! }
            (code! == 0 and memberOwnerTypeId! >= 0 and context.types[memberOwnerTypeId!].kind == 1)
                -> if {
                context.types[memberOwnerTypeId!] => memberOwnerType
                memberOwnerType.module => memberOwnerSourceModule!
                memberOwnerType.origin == 2 -> if {
                    (memberOwnerType.module < 0 or memberOwnerType.module >= (context.modules -> len))
                        -> if {
                        -1 => memberOwnerSourceModule!
                    } else {
                        context.modules[memberOwnerType.module].sourceIndex => memberOwnerSourceModule!
                    }
                }
                (memberOwnerSourceModule! < 0 or memberOwnerSourceModule! >= (context.ranges -> len))
                    -> if { 20 => code! }
            }
        }
    }
    node.kind == 17 -> if {
        (node.operand0 < 0 or node.operand0 >= irCount)
            -> if { 9 => code! }
    }
    node.kind == 18 -> if {
        (node.operand0 < 0 or node.operand0 >= irCount)
            -> if { 10 => code! }
        (code! == 0
            and node.sourceModule >= 0
            and node.sourceModule < (context.ranges -> len))
                -> if {
            context.ranges[node.sourceModule] => inverseRange
            (node.astNode >= 0 and node.astNode < inverseRange.astCount)
                -> if {
                context.nodes[inverseRange.astStart + node.astNode] => inverseAst
                inverseAst.operatorKind == -28 => astInverse
                node.opcode == -28 => irInverse
                ((astInverse and not irInverse) or (not astInverse and irInverse))
                    -> if { 17 => code! }
            }
        }
    }
    (code! == 0 and node.kind == 34 and node.operand0 == irIndex)
        -> if { 36 => code! }
    node.kind == 26 -> if {
        (node -> enumVariantTag(context)) < 0 -> if { 12 => code! }
    }
    # LLVM enum lowering extracts a tag and payload from operand0. A missing,
    # container, struct, or otherwise non-enum canonical subject can still
    # look executable in shallow tests but will eventually corrupt ABI and
    # ownership behavior.
    (code! == 0 and node.kind == 27) -> if {
        false => enumMatchSubjectValid!
        (node.operand0 >= 0 and node.operand0 < irCount)
            -> if {
            context.ir[node.operand0].typeId => enumMatchSubjectTypeId
            (enumMatchSubjectTypeId >= 0 and enumMatchSubjectTypeId < (context.types -> len))
                -> if {
                context.types[enumMatchSubjectTypeId] => enumMatchSubjectType
                (enumMatchSubjectType.kind == 7
                    and enumMatchSubjectType.origin == 4
                    and (enumMatchSubjectType.symbol == 0 or enumMatchSubjectType.symbol == 1))
                        -> if { true => enumMatchSubjectValid! }
                enumMatchSubjectType.kind == 1 -> if {
                    enumMatchSubjectType.module => enumMatchOwnerSource!
                    enumMatchSubjectType.origin == 2 -> if {
                        (enumMatchSubjectType.module >= 0 and enumMatchSubjectType.module < (context.modules -> len))
                            -> if {
                            context.modules[enumMatchSubjectType.module].sourceIndex => enumMatchOwnerSource!
                        } else { -1 => enumMatchOwnerSource! }
                    }
                    (enumMatchOwnerSource! >= 0 and enumMatchOwnerSource! < (context.ranges -> len))
                        -> if {
                        context.ranges[enumMatchOwnerSource!] => enumMatchOwnerRange
                        (enumMatchSubjectType.symbol >= 0 and enumMatchSubjectType.symbol < enumMatchOwnerRange.symbolCount)
                            -> if {
                            context.symbols[enumMatchOwnerRange.symbolStart + enumMatchSubjectType.symbol] => enumMatchDeclaration
                            (enumMatchDeclaration.astNode >= 0 and context.nodes[enumMatchOwnerRange.astStart + enumMatchDeclaration.astNode].kind == 4)
                                -> if { true => enumMatchSubjectValid! }
                        }
                    }
                }
            }
        }
        not enumMatchSubjectValid! -> if { 21 => code! }
    }
    # A canonical enum type is not enough: a name subject must resolve to a
    # parameter ABI value or retain its concrete producer link. Otherwise LLVM
    # references an SSA name that is never defined.
    (code! == 0 and node.kind == 27 and node.operand0 >= 0 and node.operand0 < irCount)
        -> if {
        context.ir[node.operand0] => enumValueSubject
        (enumValueSubject.kind == 0
            or enumValueSubject.kind == 1
            or enumValueSubject.kind == 10
            or enumValueSubject.kind == 11
            or enumValueSubject.kind == 17
            or (enumValueSubject.kind >= 19 and enumValueSubject.kind <= 25))
                -> if { 24 => code! }
    }
    # Control-transfer, declaration, and region nodes do not materialize LLVM
    # values even when stale contextual typing gives them an enum type.
    (code! == 0 and node.kind == 27 and node.operand0 >= 0 and node.operand0 < irCount)
        -> if {
        context.ir[node.operand0] => enumValueSubject
        (enumValueSubject.kind == 5 and enumValueSubject.operand0 < 0)
            -> if {
            node.parent => enumValueOwner!
            (enumValueOwner! >= 0 and context.ir[enumValueOwner!].kind != 0 and context.ir[enumValueOwner!].kind != 11)
                -> while {
                context.ir[enumValueOwner!].parent => enumValueOwner!
            }
            (enumValueOwner! < 0
                or enumValueSubject.sourceModule != context.ir[enumValueOwner!].sourceModule
                or (context -> parameterIndexForFunction(enumValueOwner!, enumValueSubject.symbol)) < 0)
                    -> if { 23 => code! }
        }
    }
    # A value-producing `if` needs concrete then/else region results before
    # result-slot emission. Missing region values otherwise reach
    # regionResultValueIndex as an out-of-bounds lookup and crash the compiler.
    (code! == 0
        and node.kind == 18
        and not (node.typeOrigin == 1 and node.typeSymbol == 0)
        and node.nextOperand >= 0) -> if {
        true => valueIfBranchesValid!
        (node.operand1 < 0
            or node.operand1 >= irCount
            or context.ir[node.operand1].kind != 19
            or context.ir[node.operand1].operand1 < 0
            or context.ir[node.operand1].operand1 >= irCount)
                -> if { false => valueIfBranchesValid! }
        (node.nextOperand < 0
            or node.nextOperand >= irCount
            or context.ir[node.nextOperand].kind != 19
            or context.ir[node.nextOperand].operand1 < 0
            or context.ir[node.nextOperand].operand1 >= irCount)
                -> if { false => valueIfBranchesValid! }
        not valueIfBranchesValid! -> if { 27 => code! }
    }
    # A value-producing `if` also needs one canonical type for its result slot
    # and both materialized branch values. Integer branches may still carry a
    # contextual literal identity because the slot width performs that
    # conversion explicitly; aggregate identities must agree exactly.
    (code! == 0
        and node.kind == 18
        and not (node.typeOrigin == 1 and node.typeSymbol == 0)
        and node.operand1 >= 0
        and node.operand1 < irCount
        and node.nextOperand >= 0
        and node.nextOperand < irCount
        and context.ir[node.operand1].kind == 19
        and context.ir[node.nextOperand].kind == 19
        and context.ir[node.operand1].operand1 >= 0
        and context.ir[node.operand1].operand1 < irCount
        and context.ir[node.nextOperand].operand1 >= 0
        and context.ir[node.nextOperand].operand1 < irCount)
            -> if {
        context.ir[node.operand1].operand1 => typedIfThenValueIndex
        context.ir[node.nextOperand].operand1 => typedIfElseValueIndex
        false => typedIfMismatch!
        node -> irAggregateStorageClass => typedIfStorageClass
        context.ir[typedIfThenValueIndex] -> irAggregateStorageClass => typedIfThenStorageClass
        context.ir[typedIfElseValueIndex] -> irAggregateStorageClass => typedIfElseStorageClass
        ((typedIfStorageClass > 0 or typedIfThenStorageClass > 0)
            and typedIfStorageClass != typedIfThenStorageClass)
                -> if { true => typedIfMismatch! }
        ((typedIfStorageClass > 0 or typedIfElseStorageClass > 0)
            and typedIfStorageClass != typedIfElseStorageClass)
                -> if { true => typedIfMismatch! }
        (not typedIfMismatch!
            and node.typeId >= 0
            and context.ir[typedIfThenValueIndex].typeId >= 0
            and context.ir[typedIfThenValueIndex].typeId != node.typeId)
                -> if {
            ((node -> irScalarIntegerWidth(context)) == 0
                or (context.ir[typedIfThenValueIndex] -> irScalarIntegerWidth(context)) == 0)
                    -> if {
                true => typedIfMismatch!
            }
        }
        (not typedIfMismatch!
            and node.typeId >= 0
            and context.ir[typedIfElseValueIndex].typeId >= 0
            and context.ir[typedIfElseValueIndex].typeId != node.typeId)
                -> if {
            ((node -> irScalarIntegerWidth(context)) == 0
                or (context.ir[typedIfElseValueIndex] -> irScalarIntegerWidth(context)) == 0)
                    -> if {
                true => typedIfMismatch!
            }
        }
        typedIfMismatch! -> if { 37 => code! }
    }
    # A non-negative payload binding type can still be stale. Intrinsic
    # Option/Result arms must use the exact canonical payload type carried by
    # the matched enum or fixed-array values can be lowered as slice headers.
    (code! == 0
        and node.kind == 29
        and node.parent >= 0
        and node.parent < irCount
        and context.ir[node.parent].kind == 19
        and context.ir[node.parent].parent >= 0
        and context.ir[node.parent].parent < irCount
        and context.ir[context.ir[node.parent].parent].kind == 27)
            -> if {
        context.ir[node.parent] => payloadArm
        context.ir[payloadArm.parent] => payloadMatch
        (payloadMatch.operand0 >= 0
            and payloadMatch.operand0 < irCount
            and context.ir[payloadMatch.operand0].typeId >= 0
            and context.ir[payloadMatch.operand0].typeId < (context.types -> len))
                -> if {
            context.types[context.ir[payloadMatch.operand0].typeId] => payloadSubjectType
            -1 => expectedPayloadType!
            (payloadSubjectType.kind == 7 and payloadSubjectType.origin == 4 and payloadSubjectType.symbol == 0)
                -> if {
                payloadSubjectType.first => expectedPayloadType!
            }
            (payloadSubjectType.kind == 7 and payloadSubjectType.origin == 4 and payloadSubjectType.symbol == 1)
                -> if {
                payloadArm.opcode == 0 -> if { payloadSubjectType.first => expectedPayloadType! } else { payloadSubjectType.second => expectedPayloadType! }
            }
            (expectedPayloadType! >= 0 and node.typeId != expectedPayloadType!)
                -> if { 28 => code! }
        }
    }
    # Fixed and bounded array return contracts are contextual types, not
    # suggestions. A direct literal must use the function's exact canonical
    # array identity before ABI selection.
    (code! == 0
        and node.kind == 0
        and node.typeId >= 0
        and node.typeId < (context.types -> len)
        and (context.types[node.typeId].kind == 4 or context.types[node.typeId].kind == 12)
        and node.operand0 >= 0
        and node.operand0 < irCount
        and context.ir[node.operand0].kind == 1
        and context.ir[node.operand0].operand0 >= 0
        and context.ir[node.operand0].operand0 < irCount
        and context.ir[context.ir[node.operand0].operand0].kind == 14
        and context.ir[context.ir[node.operand0].operand0].typeId != node.typeId)
            -> if { 29 => code! }
    # Array-valued nominal fields likewise require the declaration's exact
    # shape. A dynamic or slice carrier cannot initialize fixed inline storage.
    (code! == 0 and node.kind == 12 and node.typeId >= 0)
        -> if {
        node.operand0 => structArrayValueIndex!
        0 => structArrayFieldOrdinal!
        (structArrayValueIndex! >= 0 and structArrayValueIndex! < irCount and code! == 0)
            -> while {
            -1 => structArrayFieldTypeId!
            0 => structArrayFieldSearch!
            (structArrayFieldSearch! < (context.fields -> len) and structArrayFieldTypeId! < 0)
                -> while {
                context.fields[structArrayFieldSearch!] => structArrayField
                (structArrayField.ownerType == node.typeId and structArrayField.ordinal == structArrayFieldOrdinal!)
                    -> if {
                    structArrayField.fieldType => structArrayFieldTypeId!
                }
                structArrayFieldSearch! + 1 => structArrayFieldSearch!
            }
            (structArrayFieldTypeId! >= 0
                and structArrayFieldTypeId! < (context.types -> len)
                and (context.types[structArrayFieldTypeId!].kind == 3 or context.types[structArrayFieldTypeId!].kind == 4 or context.types[structArrayFieldTypeId!].kind == 12)
                and context.ir[structArrayValueIndex!].typeId != structArrayFieldTypeId!)
                    -> if { 30 => code! }
            context.ir[structArrayValueIndex!].nextOperand => structArrayValueIndex!
            structArrayFieldOrdinal! + 1 => structArrayFieldOrdinal!
        }
    }
    # A value-producing enum match must provide a canonical value on every
    # non-returning arm. Otherwise value-use propagation can request the match
    # SSA while the emitter has no arm value to store.
    (code! == 0
        and node.kind == 27
        and not (node.typeOrigin == 1 and node.typeSymbol == 0))
            -> if {
        false => valueMatchResultDemanded!
        (node.parent >= 0 and node.parent < irCount and context.ir[node.parent].kind == 19)
            -> if {
            context.ir[node.parent] => valueMatchParentRegion
            (valueMatchParentRegion.operand1 == irIndex
                and valueMatchParentRegion.sourceModule >= 0
                and valueMatchParentRegion.sourceModule < (context.ranges -> len))
                    -> if {
                context.ranges[valueMatchParentRegion.sourceModule] => valueMatchParentRange
                (valueMatchParentRegion.astNode >= 0 and valueMatchParentRegion.astNode < valueMatchParentRange.astCount)
                    -> if {
                    context.nodes[valueMatchParentRange.astStart + valueMatchParentRegion.astNode] => valueMatchParentAst
                    (valueMatchParentAst.kind == 58 or valueMatchParentAst.kind == 70)
                        -> if { true => valueMatchResultDemanded! }
                }
            }
        }
        valueMatchResultDemanded! -> if {
            node.operand1 => valueMatchArmIndex!
            true => valueMatchArmsValid!
            (valueMatchArmIndex! >= 0 and valueMatchArmIndex! < irCount and valueMatchArmsValid!)
                -> while {
                context.ir[valueMatchArmIndex!] => valueMatchArm
                (valueMatchArm.kind != 19 or valueMatchArm.parent != irIndex)
                    -> if {
                    false => valueMatchArmsValid!
                } else {
                    valueMatchArmIndex! => valueMatchRegionIndex!
                    (valueMatchArm.operand1 >= 0
                        and valueMatchArm.operand1 < irCount
                        and context.ir[valueMatchArm.operand1].kind == 19)
                            -> if {
                        valueMatchArm.operand1 => valueMatchRegionIndex!
                    }
                    context.ir[valueMatchRegionIndex!].operand1 < 0
                        -> if { false => valueMatchArmsValid! }
                    valueMatchArm.nextOperand => valueMatchArmIndex!
                }
            }
            not valueMatchArmsValid! -> if { 22 => code! }
        }
    }
    # Every materialized arm of a value-producing enum match must agree with
    # the match result slot's canonical type. A first-arm payload must never
    # become the slot type when later arms yield the enclosing Result/Option.
    (code! == 0
        and node.kind == 27
        and node.typeId >= 0
        and not (node.typeOrigin == 1 and node.typeSymbol == 0))
            -> if {
        false => typedMatchResultDemanded!
        (node.parent >= 0 and node.parent < irCount) -> if {
            context.ir[node.parent] => typedMatchParent
            ((typedMatchParent.kind == 1 and typedMatchParent.operand0 == irIndex)
                or (typedMatchParent.kind == 19 and typedMatchParent.operand1 == irIndex))
                    -> if { true => typedMatchResultDemanded! }
        }
        typedMatchResultDemanded! -> if {
            node.operand1 => typedMatchArmIndex!
            (typedMatchArmIndex! >= 0 and typedMatchArmIndex! < irCount and code! == 0)
                -> while {
                context.ir[typedMatchArmIndex!] => typedMatchArm
                typedMatchArmIndex! => typedMatchRegionIndex!
                (typedMatchArm.operand1 >= 0
                    and typedMatchArm.operand1 < irCount
                    and context.ir[typedMatchArm.operand1].kind == 19)
                        -> if { typedMatchArm.operand1 => typedMatchRegionIndex! }
                context.ir[typedMatchRegionIndex!].operand1 => typedMatchValueIndex
                (typedMatchValueIndex >= 0 and typedMatchValueIndex < irCount)
                    -> if {
                    context.ir[typedMatchValueIndex].typeId != node.typeId
                        -> if { 25 => code! }
                }
                typedMatchArm.nextOperand => typedMatchArmIndex!
            }
        }
    }
    # A transparent parser wrapper has no standalone SSA definition. Even if
    # it carries the correct contextual type, a value-producing match arm must
    # store the concrete producer beneath that wrapper.
    (code! == 0 and node.kind == 27) -> if {
        false => concreteMatchResultDemanded!
        (node.parent >= 0 and node.parent < irCount) -> if {
            context.ir[node.parent] => concreteMatchParent
            ((concreteMatchParent.kind == 1 and concreteMatchParent.operand0 == irIndex)
                or (concreteMatchParent.kind == 19 and concreteMatchParent.operand1 == irIndex))
                    -> if {
                true => concreteMatchResultDemanded!
            }
        }
        concreteMatchResultDemanded! -> if {
            node.operand1 => concreteMatchArmIndex!
            (concreteMatchArmIndex! >= 0 and concreteMatchArmIndex! < irCount and code! == 0)
                -> while {
                context.ir[concreteMatchArmIndex!] => concreteMatchArm
                concreteMatchArmIndex! => concreteMatchRegionIndex!
                (concreteMatchArm.operand1 >= 0
                    and concreteMatchArm.operand1 < irCount
                    and context.ir[concreteMatchArm.operand1].kind == 19)
                        -> if {
                    concreteMatchArm.operand1 => concreteMatchRegionIndex!
                }
                context.ir[concreteMatchRegionIndex!].operand1 => concreteMatchValueIndex
                (concreteMatchValueIndex >= 0
                    and concreteMatchValueIndex < irCount
                    and context.ir[concreteMatchValueIndex].kind == 9
                    and context.ir[concreteMatchValueIndex].opcode == -1)
                        -> if { 26 => code! }
                concreteMatchArm.nextOperand => concreteMatchArmIndex!
            }
        }
    }
    # Subject `when` controls must retain the value that every relational arm
    # compares. Losing it can leave individually plausible one-sided binary
    # nodes that only fail after nested enum payload lowering.
    (code! == 0 and node.kind == 34 and (node.operand0 < 0 or node.operand0 >= irCount))
        -> if {
        18 => code!
    }
    # Every non-empty array literal must carry its canonical dynamic, bounded,
    # or fixed-array identity before LLVM storage is selected. Missing this
    # contract would otherwise surface later as an invalid `alloca void`.
    (code! == 0 and node.kind == 14 and node.operand0 >= 0 and node.typeId < 0)
        -> if {
        13 => code!
    }
    # A stale array identity can remain non-negative while naming the wrong
    # element type. Header-only layouts may let that survive LLVM validation,
    # but ownership, drop, ABI, and indexed access will eventually diverge.
    # Numeric and Bool literals are exempt because contextual typing may
    # intentionally narrow their default literal type.
    (code! == 0
        and node.kind == 14
        and node.operand0 >= 0
        and node.operand0 < irCount
        and node.typeId >= 0
        and node.typeId < (context.types -> len)) -> if {
        context.types[node.typeId] => arrayType
        context.ir[node.operand0] => firstArrayOperand
        ((arrayType.kind == 3 or arrayType.kind == 4 or arrayType.kind == 12)
            and arrayType.first >= 0
            and firstArrayOperand.typeId >= 0
            and firstArrayOperand.kind != 3
            and firstArrayOperand.kind != 4
            and arrayType.first != firstArrayOperand.typeId)
                -> if {
            14 => code!
        }
    }
    # A repeat literal has one lowered element operand but its static length is
    # the source repeat count. Treating operand count as array length silently
    # changes indexing, ABI, and struct layout even when code generation runs.
    (code! == 0
        and node.kind == 14
        and node.typeId >= 0
        and node.typeId < (context.types -> len)
        and context.types[node.typeId].kind == 4
        and node.sourceModule >= 0
        and node.sourceModule < (context.ranges -> len))
            -> if {
        context.ranges[node.sourceModule] => repeatInvariantRange
        context.nodes[repeatInvariantRange.astStart + node.astNode] => repeatInvariantAst
        false => repeatInvariantAfterSemicolon!
        -1 => repeatInvariantLength!
        repeatInvariantAst.firstToken => repeatInvariantTokenIndex!
        repeatInvariantTokenIndex! < repeatInvariantAst.firstToken + repeatInvariantAst.tokenCount
            -> while {
            context.tokens[repeatInvariantRange.tokenStart + repeatInvariantTokenIndex!] => repeatInvariantToken
            repeatInvariantToken.kind == grammar.tokenIdSemicolon()
                -> if { true => repeatInvariantAfterSemicolon! } else {
                (repeatInvariantAfterSemicolon! and repeatInvariantLength! < 0 and repeatInvariantToken.kind == grammar.tokenIdNumber())
                    -> if {
                    0 => repeatInvariantLength!
                    UIntSize(0) => repeatInvariantByte!
                    repeatInvariantByte! < repeatInvariantToken.span.length
                        -> while {
                        context.sources[node.sourceModule] -> byte(repeatInvariantToken.span.start + repeatInvariantByte!) => repeatInvariantDigit
                        repeatInvariantDigit != 95 -> if { repeatInvariantLength! * 10 + Int(repeatInvariantDigit - 48) => repeatInvariantLength! }
                        repeatInvariantByte! + 1 => repeatInvariantByte!
                    }
                }
            }
            repeatInvariantTokenIndex! + 1 => repeatInvariantTokenIndex!
        }
        (repeatInvariantLength! >= 0 and context.types[node.typeId].length != repeatInvariantLength!)
            -> if { 31 => code! }
    }
    # A binding whose final source operator is `?` stores the success payload,
    # never the enclosing Result. Final synchronization passes must preserve
    # that distinction instead of copying the call's pre-unwrap type back.
    (code! == 0
        and node.kind == 17
        and node.typeId >= 0
        and node.operand0 >= 0
        and node.operand0 < irCount
        and context.ir[node.operand0].typeId == node.typeId
        and context.types[node.typeId].kind == 7
        and context.types[node.typeId].origin == 4
        and context.types[node.typeId].symbol == 1
        and node.sourceModule >= 0
        and node.sourceModule < (context.ranges -> len))
            -> if {
        context.ranges[node.sourceModule] => tryBindingInvariantRange
        context.nodes[tryBindingInvariantRange.astStart + node.astNode] => tryBindingInvariantAst
        -1 => tryBindingInvariantLastFlow!
        tryBindingInvariantAst.firstToken => tryBindingInvariantTokenIndex!
        tryBindingInvariantTokenIndex! < tryBindingInvariantAst.firstToken + tryBindingInvariantAst.tokenCount
            -> while {
            context.tokens[tryBindingInvariantRange.tokenStart + tryBindingInvariantTokenIndex!] => tryBindingInvariantToken
            (tryBindingInvariantToken.kind == grammar.tokenIdQuestion() or tryBindingInvariantToken.kind == grammar.tokenIdArrow())
                -> if {
                tryBindingInvariantToken.kind => tryBindingInvariantLastFlow!
            }
            tryBindingInvariantToken.kind == grammar.tokenIdFatArrow()
                -> if { tryBindingInvariantAst.firstToken + tryBindingInvariantAst.tokenCount => tryBindingInvariantTokenIndex! } else {
                tryBindingInvariantTokenIndex! + 1 => tryBindingInvariantTokenIndex!
            }
        }
        tryBindingInvariantLastFlow! == grammar.tokenIdQuestion()
            -> if { 32 => code! }
    }
    # A binding and every direct read of it share one canonical value type.
    # A Result binding followed by `?` is the sole intentional initializer
    # mismatch: the binding stores the success payload rather than the Result.
    # Any other stale type would make LLVM print one type for an SSA producer
    # and another type for the value that consumes it.
    (code! == 0
        and node.kind == 17
        and node.typeId >= 0
        and node.typeId < (context.types -> len)
        and node.operand0 >= 0
        and node.operand0 < irCount
        and context.ir[node.operand0].typeId >= 0
        and context.ir[node.operand0].typeId < (context.types -> len)
        and node.typeId != context.ir[node.operand0].typeId)
            -> if {
        context.ir[node.operand0].typeId => bindingInitializerTypeId
        false => bindingPayloadUnwrap!
        ((node -> irScalarIntegerWidth(context)) > 0
            and (context.ir[node.operand0] -> irScalarIntegerWidth(context)) > 0)
                -> if {
            true => bindingPayloadUnwrap!
        }
        context.types[node.typeId] => bindingCanonicalType
        context.types[bindingInitializerTypeId] => bindingInitializerType
        (bindingCanonicalType.kind == bindingInitializerType.kind
            and bindingCanonicalType.origin == bindingInitializerType.origin
            and bindingCanonicalType.module == bindingInitializerType.module
            and bindingCanonicalType.symbol == bindingInitializerType.symbol
            and bindingCanonicalType.first == bindingInitializerType.first
            and bindingCanonicalType.second == bindingInitializerType.second
            and bindingCanonicalType.length == bindingInitializerType.length)
                -> if {
            true => bindingPayloadUnwrap!
        }
        (bindingCanonicalType.origin == 3
            and bindingInitializerType.origin == 3
            and bindingCanonicalType.module == bindingInitializerType.module)
                -> if {
            true => bindingPayloadUnwrap!
        }
        (context.types[bindingInitializerTypeId].kind == 7
            and context.types[bindingInitializerTypeId].origin == 4
            and context.types[bindingInitializerTypeId].symbol == 1
            and context.types[bindingInitializerTypeId].first == node.typeId)
                -> if {
            true => bindingPayloadUnwrap!
        }
        not bindingPayloadUnwrap! -> if { 37 => code! }
    }
    (code! == 0
        and node.kind == 5
        and node.typeId >= 0
        and node.operand0 >= 0
        and node.operand0 < irCount
        and context.ir[node.operand0].kind == 17
        and context.ir[node.operand0].operand0 >= 0
        and context.ir[node.operand0].operand0 < irCount
        and context.ir[context.ir[node.operand0].operand0].typeId >= 0
        and node.typeId != context.ir[context.ir[node.operand0].operand0].typeId)
            -> if {
        context.ir[node.operand0].operand0 => bindingReadInitializerIndex
        false => bindingReadCompatible!
        ((node -> irScalarIntegerWidth(context)) > 0
            and (context.ir[bindingReadInitializerIndex] -> irScalarIntegerWidth(context)) > 0)
                -> if {
            true => bindingReadCompatible!
        }
        context.ir[bindingReadInitializerIndex].typeId => bindingReadInitializerTypeId
        (bindingReadInitializerTypeId >= 0
            and bindingReadInitializerTypeId < (context.types -> len)
            and node.typeId < (context.types -> len)) -> if {
            context.types[node.typeId] => bindingReadCanonicalType
            context.types[bindingReadInitializerTypeId] => bindingReadInitializerType
            (bindingReadCanonicalType.kind == bindingReadInitializerType.kind
                and bindingReadCanonicalType.origin == bindingReadInitializerType.origin
                and bindingReadCanonicalType.module == bindingReadInitializerType.module
                and bindingReadCanonicalType.symbol == bindingReadInitializerType.symbol
                and bindingReadCanonicalType.first == bindingReadInitializerType.first
                and bindingReadCanonicalType.second == bindingReadInitializerType.second
                and bindingReadCanonicalType.length == bindingReadInitializerType.length)
                    -> if {
                true => bindingReadCompatible!
            }
            (bindingReadCanonicalType.origin == 3
                and bindingReadInitializerType.origin == 3
                and bindingReadCanonicalType.module == bindingReadInitializerType.module)
                    -> if {
                true => bindingReadCompatible!
            }
        }
        (bindingReadInitializerTypeId >= 0
            and bindingReadInitializerTypeId < (context.types -> len)
            and context.types[bindingReadInitializerTypeId].kind == 7
            and context.types[bindingReadInitializerTypeId].origin == 4
            and context.types[bindingReadInitializerTypeId].symbol == 1
            and context.types[bindingReadInitializerTypeId].first == node.typeId)
                -> if {
            true => bindingReadCompatible!
        }
        not bindingReadCompatible! -> if { 37 => code! }
    }
    # A partition result is a structural product whose route fields preserve
    # the canonical Stream/EventStream wrapper of its source. Committing a
    # product from an earlier Range or other fixed-point candidate would make
    # direct dispatch consume a non-stream ABI and eventually reference an
    # intentionally unmaterialized product value.
    (code! == 0 and node.kind == 40) -> if {
        true => partitionTypeInvariantValid!
        (node.typeId < 0 or node.typeId >= (context.types -> len))
            -> if { false => partitionTypeInvariantValid! }
        (node.operand0 < 0 or node.operand0 >= irCount)
            -> if { false => partitionTypeInvariantValid! }
        -1 => partitionTypeInvariantSourceType!
        partitionTypeInvariantValid! -> if {
            context.ir[node.operand0].typeId => partitionTypeInvariantSourceType!
            (partitionTypeInvariantSourceType! < 0 or partitionTypeInvariantSourceType! >= (context.types -> len))
                -> if {
                false => partitionTypeInvariantValid!
            } else {
                context.types[partitionTypeInvariantSourceType!] => partitionTypeInvariantSource
                (partitionTypeInvariantSource.kind != 7
                    or partitionTypeInvariantSource.origin != 4
                    or (partitionTypeInvariantSource.symbol != 3 and partitionTypeInvariantSource.symbol != 4))
                        -> if {
                    false => partitionTypeInvariantValid!
                }
            }
        }
        0 => partitionTypeInvariantFieldCount!
        partitionTypeInvariantValid! -> if {
            context.types[node.typeId] => partitionTypeInvariantProduct
            partitionTypeInvariantProduct.kind != 10 -> if { false => partitionTypeInvariantValid! }
            0 => partitionTypeInvariantFieldSearch!
            partitionTypeInvariantFieldSearch! < (context.fields -> len)
                -> while {
                context.fields[partitionTypeInvariantFieldSearch!] => partitionTypeInvariantField
                (partitionTypeInvariantField.status == 0 and partitionTypeInvariantField.ownerType == node.typeId)
                    -> if {
                    partitionTypeInvariantFieldCount! + 1 => partitionTypeInvariantFieldCount!
                    partitionTypeInvariantField.fieldType != partitionTypeInvariantSourceType!
                        -> if { false => partitionTypeInvariantValid! }
                }
                partitionTypeInvariantFieldSearch! + 1 => partitionTypeInvariantFieldSearch!
            }
            partitionTypeInvariantFieldCount! != partitionTypeInvariantProduct.length
                -> if { false => partitionTypeInvariantValid! }
        }
        not partitionTypeInvariantValid! -> if { 41 => code! }
    }
    # `len` is an aggregate projection. A scalar receiver proves that operand
    # recovery crossed expression or region boundaries; emitting extractvalue
    # would otherwise defer the failure to LLVM assembly.
    (code! == 0
        and (node.kind == 6 or node.kind == 9)
        and node.opcode == -201
        and node.operand0 >= 0
        and node.operand0 < irCount
        and ((context.ir[node.operand0] -> irScalarIntegerWidth(context)) > 0
            or (context.ir[node.operand0].kind == 8
                and context.ir[node.operand0].opcode >= grammar.tokenIdPlus()
                and context.ir[node.operand0].opcode <= grammar.tokenIdPercent())))
                    -> if {
        38 => code!
    }
    # `capacity` has the same aggregate receiver contract as `len`. In
    # particular, a local binding named `capacity` is not an intrinsic stage
    # unless it occurs after a top-level flow arrow.
    node.operand0 => capacityInvariantReceiver!
    (capacityInvariantReceiver! >= 0
        and capacityInvariantReceiver! < irCount
        and context.ir[capacityInvariantReceiver!].kind == 9
        and context.ir[capacityInvariantReceiver!].opcode == -236
        and context.ir[capacityInvariantReceiver!].operand0 >= 0
        and context.ir[capacityInvariantReceiver!].operand0 != capacityInvariantReceiver!)
            -> while {
        context.ir[capacityInvariantReceiver!].operand0 => capacityInvariantReceiver!
    }
    (code! == 0
        and (node.kind == 6 or node.kind == 9)
        and node.opcode == -236
        and capacityInvariantReceiver! >= 0
        and capacityInvariantReceiver! < irCount
        and ((context.ir[capacityInvariantReceiver!] -> irScalarIntegerWidth(context)) > 0
            or (context.ir[capacityInvariantReceiver!].kind == 8
                and context.ir[capacityInvariantReceiver!].opcode >= grammar.tokenIdPlus()
                and context.ir[capacityInvariantReceiver!].opcode <= grammar.tokenIdPercent())))
                    -> if {
        40 => code!
    }
    # A dotted member base must be a proper structural prefix of the member
    # expression. A base outside that span proves that flattened IR parent
    # recovery crossed into another expression or control region.
    (code! == 0
        and node.kind == 13
        and node.operand0 >= 0
        and node.operand0 < irCount
        and context.ir[node.operand0].kind != 29
        and node.sourceModule >= 0
        and node.sourceModule < (context.ranges -> len)
        and context.ir[node.operand0].sourceModule == node.sourceModule)
            -> if {
        context.ranges[node.sourceModule] => memberBaseInvariantRange
        context.nodes[memberBaseInvariantRange.astStart + node.astNode] => memberBaseInvariantAst
        context.nodes[memberBaseInvariantRange.astStart + context.ir[node.operand0].astNode] => memberBaseInvariantOperandAst
        (memberBaseInvariantOperandAst.start != memberBaseInvariantAst.start
            or memberBaseInvariantOperandAst.length >= memberBaseInvariantAst.length
            or memberBaseInvariantOperandAst.start + memberBaseInvariantOperandAst.length > memberBaseInvariantAst.start + memberBaseInvariantAst.length)
                -> if {
            39 => code!
        }
    }
    # Once a nominal base is canonical, a dotted member of a field-bearing
    # type must also carry a canonical field type before ABI lowering.
    (code! == 0
        and node.kind == 13
        and node.opcode == grammar.tokenIdDot()
        and node.typeId < 0
        and node.operand0 >= 0
        and node.operand0 < irCount
        and context.ir[node.operand0].typeId >= 0
        and context.types[context.ir[node.operand0].typeId].kind == 1)
            -> if {
        false => unresolvedNominalMemberHasFields!
        0 => unresolvedNominalMemberFieldSearch!
        (unresolvedNominalMemberFieldSearch! < (context.fields -> len) and not unresolvedNominalMemberHasFields!)
            -> while {
            context.fields[unresolvedNominalMemberFieldSearch!].ownerType == context.ir[node.operand0].typeId
                -> if { true => unresolvedNominalMemberHasFields! }
            unresolvedNominalMemberFieldSearch! + 1 => unresolvedNominalMemberFieldSearch!
