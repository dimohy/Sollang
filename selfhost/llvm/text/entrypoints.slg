runtimeFunctionSymbol runtimeModule: Int, expectedName: Text, context: ref emitterContext.EmitContext -> Int {
    -1 => matchedSymbol!
    context.ranges[runtimeModule] => runtimeRange
    0 => symbolIndex!
    symbolIndex! < runtimeRange.symbolCount -> while {
        context.symbols[runtimeRange.symbolStart + symbolIndex!] => candidate
        (candidate.parent < 0 and candidate.nameToken >= 0 and candidate.nameToken < runtimeRange.tokenCount) -> if {
            context.tokens[runtimeRange.tokenStart + candidate.nameToken] => nameToken
            expectedName -> len => expectedLength
            nameToken.span.length == expectedLength => matches!
            UIntSize(0) => byteIndex!
            (matches! and byteIndex! < expectedLength) -> while {
                (context.sources[runtimeModule] -> byte(nameToken.span.start + byteIndex!)) != (expectedName -> byte(byteIndex!)) -> if {
                    false => matches!
                }
                byteIndex! + UIntSize(1) => byteIndex!
            }
            matches! -> if { symbolIndex! => matchedSymbol! }
        }
        symbolIndex! + 1 => symbolIndex!
    }
    matchedSymbol!
}

runtimeFunctionSymbols runtimeModule: Int, context: ref emitterContext.EmitContext -> llvmRuntime.RuntimeFunctionSymbols {
    llvmRuntime.RuntimeFunctionSymbols {
        printSymbol: runtimeModule -> runtimeFunctionSymbol("print", context)
        printlnSymbol: runtimeModule -> runtimeFunctionSymbol("println", context)
        readIntSymbol: runtimeModule -> runtimeFunctionSymbol("readInt", context)
        seedRandomSymbol: runtimeModule -> runtimeFunctionSymbol("seedRandom", context)
        randomBelowSymbol: runtimeModule -> runtimeFunctionSymbol("randomBelow", context)
        openIntWriterSymbol: runtimeModule -> runtimeFunctionSymbol("openIntWriter", context)
        writeIntSymbol: runtimeModule -> runtimeFunctionSymbol("writeInt", context)
        closeIntWriterSymbol: runtimeModule -> runtimeFunctionSymbol("closeIntWriter", context)
        openIntReaderSymbol: runtimeModule -> runtimeFunctionSymbol("openIntReader", context)
        closestIntSymbol: runtimeModule -> runtimeFunctionSymbol("closestInt", context)
        closeIntReaderSymbol: runtimeModule -> runtimeFunctionSymbol("closeIntReader", context)
        nowMillisSymbol: runtimeModule -> runtimeFunctionSymbol("nowMillis", context)
        eprintlnSymbol: runtimeModule -> runtimeFunctionSymbol("eprintln", context)
        flushStandardOutputSymbol: runtimeModule -> runtimeFunctionSymbol("flushStandardOutput", context)
    }
}


