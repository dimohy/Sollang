            } else {
            invariantCode == 10 -> if {
                "; sollang compiler error S016: conditional expression has no canonical condition operand at ir $diagnosticIrIndex (parent $(node.parent), operand1 $(node.operand1), nextOperand $(node.nextOperand), source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
            } else {
            invariantCode == 20 -> if {
                context.ir[node.operand0] => memberOwnerDiagnostic
                -1 => memberOwnerDiagnosticParentKind!
                -1 => memberOwnerDiagnosticControlKind!
                -1 => memberOwnerDiagnosticSubjectType!
                -1 => memberOwnerDiagnosticSubjectKind!
                -1 => memberOwnerDiagnosticSubjectOrigin!
                -1 => memberOwnerDiagnosticSubjectModule!
                -1 => memberOwnerDiagnosticSubjectSymbol!
                -1 => memberOwnerDiagnosticSubjectFirst!
                -1 => memberOwnerDiagnosticSubjectSecond!
                -1 => memberOwnerDiagnosticSubjectNodeKind!
                -1 => memberOwnerDiagnosticSubjectNodeOpcode!
                -1 => memberOwnerDiagnosticSubjectNodeParent!
                -1 => memberOwnerDiagnosticSubjectNodeOperand0!
                -1 => memberOwnerDiagnosticSubjectNodeNext!
                -1 => memberOwnerDiagnosticArmOpcode!
                -1 => memberOwnerDiagnosticOwnerSource!
                -1 => memberOwnerDiagnosticOwnerSymbolKind!
                -1 => memberOwnerDiagnosticOwnerSymbolAst!
                -1 => memberOwnerDiagnosticOwnerSymbolTypeAst!
                0 => memberOwnerDiagnosticVariantCount!
                -1 => memberOwnerDiagnosticTakeIr!
                -1 => memberOwnerDiagnosticTakeParent!
                -1 => memberOwnerDiagnosticTakeType!
                -1 => memberOwnerDiagnosticTakeOperandType!
                UIntSize(0) => memberOwnerDiagnosticTakeStart!
                memberOwnerDiagnostic.parent >= 0 -> if {
                    context.ir[memberOwnerDiagnostic.parent].kind => memberOwnerDiagnosticParentKind!
                    context.ir[memberOwnerDiagnostic.parent].opcode => memberOwnerDiagnosticArmOpcode!
                    context.ir[memberOwnerDiagnostic.parent].parent => memberOwnerDiagnosticControl
                    memberOwnerDiagnosticControl >= 0 -> if {
                        context.ir[memberOwnerDiagnosticControl].kind => memberOwnerDiagnosticControlKind!
                        context.ranges[sourceModule] => memberOwnerDiagnosticSourceRange
                        context.nodes[memberOwnerDiagnosticSourceRange.astStart + context.ir[memberOwnerDiagnosticControl].astNode] => memberOwnerDiagnosticControlAst
                        0 => memberOwnerDiagnosticTakeSearch!
                        memberOwnerDiagnosticTakeSearch! < (context.ir -> len)
                            -> while {
                            context.ir[memberOwnerDiagnosticTakeSearch!] => memberOwnerDiagnosticTakeCandidate
                            (memberOwnerDiagnosticTakeCandidate.sourceModule == sourceModule and memberOwnerDiagnosticTakeCandidate.kind == 9 and memberOwnerDiagnosticTakeCandidate.opcode == -213 and memberOwnerDiagnosticTakeCandidate.astNode >= 0)
                                -> if {
                                context.nodes[memberOwnerDiagnosticSourceRange.astStart + memberOwnerDiagnosticTakeCandidate.astNode] => memberOwnerDiagnosticTakeAst
                                (memberOwnerDiagnosticTakeAst.start < memberOwnerDiagnosticControlAst.start and (memberOwnerDiagnosticTakeIr! < 0 or memberOwnerDiagnosticTakeAst.start > memberOwnerDiagnosticTakeStart!))
                                    -> if {
                                    memberOwnerDiagnosticTakeSearch! => memberOwnerDiagnosticTakeIr!
                                    memberOwnerDiagnosticTakeCandidate.parent => memberOwnerDiagnosticTakeParent!
                                    memberOwnerDiagnosticTakeCandidate.typeId => memberOwnerDiagnosticTakeType!
                                    memberOwnerDiagnosticTakeCandidate.operand0 >= 0
                                        -> if { context.ir[memberOwnerDiagnosticTakeCandidate.operand0].typeId => memberOwnerDiagnosticTakeOperandType! }
