namespace sollang.compiler.llvm.text

import sollang.compiler.llvm.emitter.context as emitterContext
import sollang.compiler.syntax as syntax

# Text literal decoding is a source-only lowering concern. Keeping it in the
# logical LLVM text module avoids an aggregate adapter while giving it an
# independently navigable file and no runtime allocation.
literalIsRaw context: ref emitterContext.EmitContext, sourceModule: Int, token: syntax.SyntaxToken -> Bool {
    token.span.length >= 6
        and (context.sources[sourceModule] -> byte(token.span.start)) == 34
        and (context.sources[sourceModule] -> byte(token.span.start + 1)) == 34
        and (context.sources[sourceModule] -> byte(token.span.start + 2)) == 34
}

literalStart context: ref emitterContext.EmitContext, sourceModule: Int, token: syntax.SyntaxToken -> UIntSize {
    token.span.start + 1 => start!
    context -> literalIsRaw(sourceModule, token) -> if {
        token.span.start + 3 => start!
        start! < token.span.start + token.span.length -> if {
            context.sources[sourceModule] -> byte(start!) => first
            first == 13 -> if {
                start! + 1 => start!
                (start! < token.span.start + token.span.length and (context.sources[sourceModule] -> byte(start!)) == 10) -> if {
                    start! + 1 => start!
                }
            } else {
                first == 10 -> if { start! + 1 => start! }
            }
        }
    }
    start!
}

literalClosingLineStart context: ref emitterContext.EmitContext, sourceModule: Int, token: syntax.SyntaxToken -> UIntSize {
    token.span.start + token.span.length - 3 => closing!
    context -> literalIsRaw(sourceModule, token) -> if {
        closing! => cursor!
        (cursor! > token.span.start and (context.sources[sourceModule] -> byte(cursor! - 1)) != 10) -> while {
            cursor! - 1 => cursor!
        }
        cursor! => closing!
    }
    closing!
}

literalEnd context: ref emitterContext.EmitContext, sourceModule: Int, token: syntax.SyntaxToken -> UIntSize {
    token.span.start + token.span.length - 1 => end!
    context -> literalIsRaw(sourceModule, token) -> if {
        token.span.start + token.span.length - 3 => rawEnd
        context -> literalClosingLineStart(sourceModule, token) => closingLineStart
        false => rawClosingOwnLine!
        closingLineStart > token.span.start + 3 -> if {
            true => rawClosingOwnLine!
            closingLineStart => rawClosingByte!
            (rawClosingOwnLine! and rawClosingByte! < rawEnd) -> while {
                context.sources[sourceModule] -> byte(rawClosingByte!) => rawClosingCharacter
                (rawClosingCharacter != 32 and rawClosingCharacter != 9) -> if {
                    false => rawClosingOwnLine!
                }
                rawClosingByte! + 1 => rawClosingByte!
            }
        }
        rawClosingOwnLine! -> if {
            closingLineStart - 1 => end!
            (end! > token.span.start and (context.sources[sourceModule] -> byte(end! - 1)) == 13) -> if {
                end! - 1 => end!
            }
        } else {
            rawEnd => end!
        }
    }
    end!
}

literalIndent context: ref emitterContext.EmitContext, sourceModule: Int, token: syntax.SyntaxToken -> UIntSize {
    UIntSize(0) => indentation!
    context -> literalIsRaw(sourceModule, token) -> if {
        token.span.start + token.span.length - 3 => rawEnd
        context -> literalClosingLineStart(sourceModule, token) => closingLineStart
        false => rawIndentOwnLine!
        closingLineStart > token.span.start + 3 -> if {
            true => rawIndentOwnLine!
            closingLineStart => rawIndentByte!
            (rawIndentOwnLine! and rawIndentByte! < rawEnd) -> while {
                context.sources[sourceModule] -> byte(rawIndentByte!) => rawIndentCharacter
                (rawIndentCharacter != 32 and rawIndentCharacter != 9) -> if {
                    false => rawIndentOwnLine!
                }
                rawIndentByte! + 1 => rawIndentByte!
            }
        }
        rawIndentOwnLine! -> if { rawEnd - closingLineStart => indentation! }
    }
    indentation!
}

# Returns the decoded byte for a supported quoted-string escape, or -1 when
# the current source byte must be emitted literally. Raw strings never decode
# escapes. This mirrors the reference parser's exact escape set.
literalDecodedEscape context: ref emitterContext.EmitContext, sourceModule: Int, token: syntax.SyntaxToken, byteIndex: UIntSize, byteEnd: UIntSize -> Int {
    -1 => decoded!
    (not (context -> literalIsRaw(sourceModule, token))
        and byteIndex + 1 < byteEnd
        and (context.sources[sourceModule] -> byte(byteIndex)) == 92) -> if {
        context.sources[sourceModule] -> byte(byteIndex + 1) => escaped
        escaped == 110 -> if { 10 => decoded! }
        escaped == 114 -> if { 13 => decoded! }
        escaped == 116 -> if { 9 => decoded! }
        escaped == 92 -> if { 92 => decoded! }
    }
    decoded!
}

literalLength context: ref emitterContext.EmitContext, sourceModule: Int, token: syntax.SyntaxToken -> UIntSize {
    context -> literalStart(sourceModule, token) => byteIndex!
    context -> literalEnd(sourceModule, token) => byteEnd
    context -> literalIndent(sourceModule, token) => indentation
    UIntSize(0) => length!
    true => lineStart!
    byteIndex! < byteEnd -> while {
        lineStart! -> if {
            UIntSize(0) => skipped!
            (skipped! < indentation and byteIndex! < byteEnd) -> while {
                context.sources[sourceModule] -> byte(byteIndex!) => indentByte
                (indentByte == 32 or indentByte == 9) -> if {
                    byteIndex! + 1 => byteIndex!
                    skipped! + 1 => skipped!
                } else {
                    indentation => skipped!
                }
            }
            false => lineStart!
        }
        byteIndex! < byteEnd -> if {
            context.sources[sourceModule] -> byte(byteIndex!) => currentByte
            context -> literalDecodedEscape(sourceModule, token, byteIndex!, byteEnd) => decodedEscape
            decodedEscape >= 0 -> if {
                length! + 1 => length!
                decodedEscape == 10 -> if { true => lineStart! }
                byteIndex! + 1 => byteIndex!
            } else {
                (currentByte == 13
                    and byteIndex! + 1 < byteEnd
                    and (context.sources[sourceModule] -> byte(byteIndex! + 1)) == 10) -> if {
                    length! + 1 => length!
                    true => lineStart!
                    byteIndex! + 1 => byteIndex!
                } else {
                    length! + 1 => length!
                    currentByte == 10 -> if { true => lineStart! }
                }
            }
            byteIndex! + 1 => byteIndex!
        }
    }
    length!
}

literalHexDigit value: UInt16 -> Text {
    "F" => result!
    value == 0 -> if { "0" => result! }
    value == 1 -> if { "1" => result! }
    value == 2 -> if { "2" => result! }
    value == 3 -> if { "3" => result! }
    value == 4 -> if { "4" => result! }
    value == 5 -> if { "5" => result! }
    value == 6 -> if { "6" => result! }
    value == 7 -> if { "7" => result! }
    value == 8 -> if { "8" => result! }
    value == 9 -> if { "9" => result! }
    value == 10 -> if { "A" => result! }
    value == 11 -> if { "B" => result! }
    value == 12 -> if { "C" => result! }
    value == 13 -> if { "D" => result! }
    value == 14 -> if { "E" => result! }
    result!
}

literalEmitEscapedByte value: UInt8 -> Unit uses Console {
    "\" -> print
    UInt16(value) / 16 -> literalHexDigit -> print
    UInt16(value) % 16 -> literalHexDigit -> print
}

literalEmitConstant context: ref emitterContext.EmitContext, sourceModule: Int, token: syntax.SyntaxToken -> Unit uses Console {
    "c" -> print
    context.sources[sourceModule] -> slice(token.span.start, UIntSize(1)) -> print
    context -> literalStart(sourceModule, token) => byteIndex!
    context -> literalEnd(sourceModule, token) => byteEnd
    context -> literalIndent(sourceModule, token) => indentation
    true => lineStart!
    byteIndex! < byteEnd -> while {
        lineStart! -> if {
            UIntSize(0) => skipped!
            (skipped! < indentation and byteIndex! < byteEnd) -> while {
                context.sources[sourceModule] -> byte(byteIndex!) => indentByte
                (indentByte == 32 or indentByte == 9) -> if {
                    byteIndex! + 1 => byteIndex!
                    skipped! + 1 => skipped!
                } else {
                    indentation => skipped!
                }
            }
            false => lineStart!
        }
        byteIndex! < byteEnd -> if {
            context.sources[sourceModule] -> byte(byteIndex!) => textByte!
            context -> literalDecodedEscape(sourceModule, token, byteIndex!, byteEnd) => decodedEscape
            decodedEscape >= 0 -> if {
                UInt8(decodedEscape) => textByte!
                byteIndex! + 1 => byteIndex!
            } else {
                (textByte! == 13
                    and byteIndex! + 1 < byteEnd
                    and (context.sources[sourceModule] -> byte(byteIndex! + 1)) == 10) -> if {
                    10 => textByte!
                    byteIndex! + 1 => byteIndex!
                }
            }
            (textByte! >= 32
                and textByte! <= 126
                and textByte! != 34
                and textByte! != 92) -> if {
                context.sources[sourceModule] -> slice(byteIndex!, UIntSize(1)) -> print
            } else {
                textByte! -> literalEmitEscapedByte
            }
            textByte! == 10 -> if { true => lineStart! }
            byteIndex! + 1 => byteIndex!
        }
    }
    context.sources[sourceModule] -> slice(token.span.start, UIntSize(1)) -> println
}

literalEmitSourceByte context: ref emitterContext.EmitContext, sourceModule: Int, byteIndex: UIntSize -> Unit uses Console {
    context.sources[sourceModule] -> byte(byteIndex) => nativeByte
    (nativeByte >= 32
        and nativeByte <= 126
        and nativeByte != 34
        and nativeByte != 92) -> if {
        context.sources[sourceModule] -> slice(byteIndex, UIntSize(1)) -> print
    } else {
        nativeByte -> literalEmitEscapedByte
    }
}
