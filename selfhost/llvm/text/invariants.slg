        and node.sourceModule >= 0
        and node.sourceModule < (context.ranges -> len)
        and node.symbol >= 0
        and node.symbol < context.ranges[node.sourceModule].symbolCount
        and node.astNode >= 0
        and node.astNode < context.ranges[node.sourceModule].astCount
        -> if {
            context.ranges[node.sourceModule] => receiverInvariantRange
            context.symbols[receiverInvariantRange.symbolStart + node.symbol]
                => receiverInvariantFunction
            context.nodes[receiverInvariantRange.astStart + node.astNode]
                => receiverInvariantAst
            receiverInvariantFunction.kind == 31
                and receiverInvariantAst.secondaryToken >= 0
                -> if {
                    -1 => receiverInvariantParameterKind!
                    -1 => receiverInvariantParameterSourceModule!
                    -1 => receiverInvariantSymbolKind!
                    -1 => receiverInvariantSymbolParent!
                    -1 => receiverInvariantSymbolNameToken!
                    node.operand1 >= 0 and node.operand1 < irCount
                        -> if {
                            context.ir[node.operand1] => receiverInvariantParameter
                            receiverInvariantParameter.kind => receiverInvariantParameterKind!
                            receiverInvariantParameter.sourceModule => receiverInvariantParameterSourceModule!
                            receiverInvariantParameter.kind == 10
                                and receiverInvariantParameter.sourceModule == node.sourceModule
                                and receiverInvariantParameter.symbol >= 0
                                and receiverInvariantParameter.symbol < receiverInvariantRange.symbolCount
                                -> if {
                                    context.symbols[receiverInvariantRange.symbolStart + receiverInvariantParameter.symbol]
                                        => receiverInvariantSymbol
                                    receiverInvariantSymbol.kind => receiverInvariantSymbolKind!
                                    receiverInvariantSymbol.parent => receiverInvariantSymbolParent!
                                    receiverInvariantSymbol.nameToken => receiverInvariantSymbolNameToken!
                                }
                        }
                    invariantRules.methodReceiverInvariantCode(
                    receiverInvariantFunction.kind,
                    receiverInvariantAst.secondaryToken,
                    node.sourceModule,
                    node.symbol,
                    receiverInvariantParameterKind!,
                    receiverInvariantParameterSourceModule!,
                    receiverInvariantSymbolKind!,
                    receiverInvariantSymbolParent!,
                    receiverInvariantSymbolNameToken!) => receiverInvariantCode
                    receiverInvariantCode != 0 -> if { receiverInvariantCode => code! }
                }
        }
    # No unresolved call sentinel may cross the typed-IR boundary. A backend
    # must never turn the internal -1/-1 identity into an LLVM symbol.
    code! == 0
        and (node.kind == 6
        or (node.kind == 9
        and node.operand0 >= 0
        and node.operand0 < (context.ir -> len)
        and ((context.ir[node.operand0] -> irNodeHasSetType(context))
        or (node.operand1 >= 0 and node.operand1 < (context.ir -> len))
        or (context.ir[node.operand0].nextOperand >= 0
        and context.ir[node.operand0].nextOperand < (context.ir -> len)))))
        and node.symbol == -1
        and node.targetModule == -1
        and (node.opcode == -1 or node.opcode == -215 or node.opcode == -230)
        and not (node -> typedIr.isTransparentControlProducerWrapper)
        and not (node -> typedIr.isBuiltinTargetlessCall)
        and not (context -> isDeferredTemplateReceiverCall(irIndex))
        -> if { 50 => code! }
    # Resolved direct and flow calls have one explicit linked argument slot for
    # every runtime parameter. Compile-time value parameters are supplied from
    # generic syntax and are intentionally excluded. This gate turns a broken
    # call chain into a producer diagnostic before malformed LLVM can execute.
    code! == 0
        and (node.kind == 6 or node.kind == 9)
        and node.targetModule >= 0
        and node.symbol >= 0
        -> if {
            context -> concreteCallFunctionIndex(irIndex, functions) => callInvariantFunction
            callInvariantFunction >= 0 -> if {
                context -> runtimeParameterCount(callInvariantFunction) => callInvariantExpected
                context -> linkedCallArgumentCount(irIndex, callInvariantExpected) => callInvariantActual
                context -> implicitFlowArgumentCount(irIndex, callInvariantActual, callInvariantExpected) => callInvariantImplicit
                callInvariantActual + callInvariantImplicit != callInvariantExpected
                    -> if { 42 => code! }
                code! == 0
                    and (context -> arrayCallElementMismatch(irIndex, callInvariantFunction)) > 0
                    -> if { 55 => code! }
            }
        }
    # A direct immutable binding read is emitted as a freeze of its canonical
    # initializer. The read and binding must therefore agree after late type
    # sealing; otherwise valid source can escape as `freeze void %value`.
    code! == 0
        and node.kind == 5
        and node.operand0 >= 0
        and node.operand0 < irCount
        and context.ir[node.operand0].kind == 17
        and node.typeId != context.ir[node.operand0].typeId
        -> if { 52 => code! }
    # A canonical non-Unit arm terminal makes its value-producing match
    # non-Unit. Retaining the provisional Unit identity would otherwise reach
    # LLVM as `freeze void` even when binding and read agree with each other.
    code! == 0
        and (node.kind == 27 or node.kind == 34)
        and (node.typeId < 0
        or (node.typeOrigin == 1 and node.typeSymbol == 0))
        and (context -> matchHasCompleteCanonicalNonUnitTerminals(irIndex))
        -> if { 53 => code! }
    # Binding is a value operation. A Unit initializer has no value to retain;
    # reject it here before the LLVM writer can fabricate `freeze void`.
    code! == 0
        and node.kind == 17
        and node.operand0 >= 0
        and node.operand0 < irCount
        and context.ir[node.operand0].typeOrigin == 1
        and context.ir[node.operand0].typeSymbol == 0
        -> if { 54 => code! }
    code!
}


unresolvedGenericAbiNode context: ref emitterContext.EmitContext -> Int {
    context -> diagnostics.reachableFunctions => reachable
    -1 => invalid!
    0 => index!
    false => emittedFunction!
    index! < (context.ir -> len) and invalid! < 0
        -> while {
            context.ir[index!] => node
            node.kind == 0 or node.kind == 11 -> if {
                false => emittedFunction!
                node.kind == 0 and reachable[index!] and not (node -> isIntrinsicDeclaration)
                    -> if {
                        context.ranges[node.sourceModule] => sourceRange
                        context.symbols[sourceRange.symbolStart + node.symbol] => function
                        # Stream/block templates have a dedicated lowering path.
                        function.flags / 64 % 2 == 0 -> if { true => emittedFunction! }
                    }
            }
            emittedFunction! and (node.kind == 0 or node.kind == 10)
                and node.typeId >= 0 and node.typeId < (context.types -> len)
                -> if {
                    context.types[node.typeId] => canonical
                    canonical.kind == 1 and canonical.origin == 3
                        -> if { index! => invalid! }
                }
            index! + 1 => index!
        }
    invalid!
}

missingBinaryBindingIr context: ref emitterContext.EmitContext -> Int {
    # Build source-global indexes once. A binding whose initializer is binary
    # syntax must retain the canonical binary Typed IR producer even when its
    # type becomes concrete only during final convergence. Grammar layers can
    # retain same-span binary wrappers; only the deepest same-span descendant
    # is materialized, while a smaller nested binary remains a distinct value.
    [Int; ~] => binaryChildByParentAst!
    [Int; ~] => binaryOwnerByAst!
    [Int; ~] => binaryIrByAst!
    0 => astInit!
    astInit! < (context.nodes -> len) -> while {
        binaryChildByParentAst! -> push(-1)
        binaryOwnerByAst! -> push(-1)
        binaryIrByAst! -> push(-1)
        astInit! + 1 => astInit!
    }
    0 => sourceIndex!
    sourceIndex! < (context.ranges -> len) -> while {
        context.ranges[sourceIndex!] => sourceRange
        0 => astIndex!
        astIndex! < sourceRange.astCount -> while {
            context.nodes[sourceRange.astStart + astIndex!] => candidate
            candidate.kind -> typedIr.isBinaryValueAstKind
                and candidate.parent >= 0
                and candidate.parent < sourceRange.astCount
                -> if {
                    candidate.parent => binaryOwnerAst!
                    context.nodes[sourceRange.astStart + candidate.parent] => binaryParent
                    binaryParent.kind -> typedIr.isBinaryValueAstKind
                        and binaryParent.start == candidate.start
                        and binaryParent.length == candidate.length
                        and binaryOwnerByAst![sourceRange.astStart + candidate.parent] >= 0
                        -> if {
                            binaryOwnerByAst![sourceRange.astStart + candidate.parent] => binaryOwnerAst!
                        }
                    binaryOwnerAst! >= 0 and binaryOwnerAst! < sourceRange.astCount
                        -> if {
                            sourceRange.astStart + astIndex! => binaryGlobalAst
                            binaryOwnerAst! => binaryOwnerByAst![binaryGlobalAst]
                            binaryGlobalAst => binaryChildByParentAst![sourceRange.astStart + binaryOwnerAst!]
                        }
                }
            astIndex! + 1 => astIndex!
        }
        sourceIndex! + 1 => sourceIndex!
    }
    0 => irIndex!
    irIndex! < (context.ir -> len) -> while {
        context.ir[irIndex!] => candidate
        candidate.kind == 8
            and candidate.sourceModule >= 0
            and candidate.sourceModule < (context.ranges -> len)
            -> if {
                context.ranges[candidate.sourceModule] => sourceRange
                candidate.astNode >= 0 and candidate.astNode < sourceRange.astCount
                    -> if {
                        irIndex! => binaryIrByAst![sourceRange.astStart + candidate.astNode]
                    }
            }
        irIndex! + 1 => irIndex!
    }
    -1 => missing!
    0 => bindingIndex!
    bindingIndex! < (context.ir -> len) and missing! < 0
        -> while {
            context.ir[bindingIndex!] => binding
            binding.kind == 17
                and binding.sourceModule >= 0
                and binding.sourceModule < (context.ranges -> len)
                -> if {
                    context.ranges[binding.sourceModule] => sourceRange
                    binding.astNode >= 0 and binding.astNode < sourceRange.astCount
                        -> if {
                            binaryChildByParentAst![sourceRange.astStart + binding.astNode] => binaryAst
                            binaryAst >= 0 and binaryIrByAst![binaryAst] < 0
                                -> if { bindingIndex! => missing! }
                        }
                }
            bindingIndex! + 1 => bindingIndex!
        }
    missing!
}

# `map read` and `map write` are syntax-owned producers rather than resolved
# calls. Keep their AST identity authoritative until Typed IR has materialized
# the exact producer and binding edge; otherwise a path Text child can be
# mistaken for the mapped owner and only fail later as malformed LLVM.
mapAstOpcode context: ref emitterContext.EmitContext, sourceModule: Int, astNode: Int -> Int {
    -1 => opcode!
    sourceModule >= 0 and sourceModule < (context.ranges -> len)
        -> if {
            context.ranges[sourceModule] => sourceRange
            astNode >= 0 and astNode < sourceRange.astCount
                -> if {
                    context.nodes[sourceRange.astStart + astNode] => mapAst
                    mapAst.firstToken => tokenIndex!
                    tokenIndex! < mapAst.firstToken + mapAst.tokenCount and opcode! < 0
                        -> while {
                            context.tokens[sourceRange.tokenStart + tokenIndex!] => token
                            token.kind == grammar.tokenIdIdentifier() and token.span.length == 4
                                -> if {
                                    context.sources[sourceModule] -> byte(token.span.start) => byte0
                                    context.sources[sourceModule] -> byte(token.span.start + 1) => byte1
                                    context.sources[sourceModule] -> byte(token.span.start + 2) => byte2
                                    context.sources[sourceModule] -> byte(token.span.start + 3) => byte3
                                    byte0 == 114 and byte1 == 101 and byte2 == 97 and byte3 == 100
                                        -> if { -306 => opcode! }
                                }
                            token.kind == grammar.tokenIdIdentifier() and token.span.length == 5
                                -> if {
                                    context.sources[sourceModule] -> byte(token.span.start) => byte0
                                    context.sources[sourceModule] -> byte(token.span.start + 1) => byte1
                                    context.sources[sourceModule] -> byte(token.span.start + 2) => byte2
                                    context.sources[sourceModule] -> byte(token.span.start + 3) => byte3
                                    context.sources[sourceModule] -> byte(token.span.start + 4) => byte4
                                    byte0 == 119 and byte1 == 114 and byte2 == 105 and byte3 == 116 and byte4 == 101
                                        -> if { -307 => opcode! }
                                }
                            tokenIndex! + 1 => tokenIndex!
                        }
                }
        }
    opcode!
}

mapAstForBinding context: ref emitterContext.EmitContext, bindingIndex: Int -> Int {
    -1 => mapAst!
    bindingIndex >= 0 and bindingIndex < (context.ir -> len)
        -> if {
            context.ir[bindingIndex] => binding
            binding.sourceModule >= 0 and binding.sourceModule < (context.ranges -> len)
                -> if {
                    context.ranges[binding.sourceModule] => sourceRange
                    0 => astIndex!
                    astIndex! < sourceRange.astCount and mapAst! < 0
                        -> while {
                            context.nodes[sourceRange.astStart + astIndex!] => candidate
                            candidate.kind == 49 and candidate.parent == binding.astNode
                                -> if { astIndex! => mapAst! }
                            astIndex! + 1 => astIndex!
                        }
                }
        }
    mapAst!
}

irNodeHasBuiltinType node: typedIr.TypedIrNode, builtinSymbol: Int, context: ref emitterContext.EmitContext -> Bool {
    false => matches!
    node.typeOrigin == 1 and node.typeSymbol == builtinSymbol
        and node.typeId >= 0 and node.typeId < (context.types -> len)
        -> if {
            context.types[node.typeId] => canonical
            canonical.kind == 1 and canonical.origin == 1 and canonical.symbol == builtinSymbol
                -> if { true => matches! }
        }
    matches!
}

mapProducerContractValid context: ref emitterContext.EmitContext, producerIndex: Int, expectedOpcode: Int, expectedSymbol: Int -> Bool {
    false => valid!
    producerIndex >= 0 and producerIndex < (context.ir -> len)
        -> if {
            context.ir[producerIndex] => producer
            producer.kind == 9
                and producer.opcode == expectedOpcode
                and (producer -> irNodeHasBuiltinType(expectedSymbol, context))
                and producer.flags >= 0 and producer.flags <= 7
                and producer.operand0 >= 0 and producer.operand0 < (context.ir -> len)
                -> if {
                    producer.flags % 2 == 1 => hasOffset
                    producer.flags / 2 % 2 == 1 => hasLength
                    producer.flags / 4 % 2 == 1 => hasFileSize
                    ((hasOffset and hasLength) or (not hasOffset and not hasLength))
                        and not (expectedOpcode == -306 and hasFileSize)
                        -> if {
                            context.ir[producer.operand0] => pathOperand
                            pathOperand.parent == producerIndex
                                and (pathOperand -> irNodeHasBuiltinType(1, context))
                                -> if {
                                    producer.operand0 => operandIndex!
                                    0 => optionOrdinal!
                                    true => chainValid!
                                    operandIndex! >= 0 and optionOrdinal! < 4 and chainValid!
                                        -> while {
                                            context.ir[operandIndex!].nextOperand => operandIndex!
                                            operandIndex! >= 0 -> if {
                                                operandIndex! >= (context.ir -> len) -> if {
                                                    false => chainValid!
                                                } else {
                                                    context.ir[operandIndex!] => optionOperand
                                                    optionOperand.parent != producerIndex -> if { false => chainValid! }
                                                    -1 => expectedOptionSymbol!
                                                    hasOffset and optionOrdinal! == 0 -> if { 11 => expectedOptionSymbol! }
                                                    hasLength and optionOrdinal! == 1 -> if { 13 => expectedOptionSymbol! }
                                                    hasFileSize and ((hasLength and optionOrdinal! == 2) or (not hasLength and optionOrdinal! == 0))
                                                        -> if { 11 => expectedOptionSymbol! }
                                                    expectedOptionSymbol! < 0
                                                        or not (optionOperand -> irNodeHasBuiltinType(expectedOptionSymbol!, context))
                                                        -> if { false => chainValid! }
                                                    optionOrdinal! + 1 => optionOrdinal!
                                                }
                                            }
                                        }
                                    0 => expectedOptionCount!
                                    hasOffset -> if { expectedOptionCount! + 1 => expectedOptionCount! }
                                    hasLength -> if { expectedOptionCount! + 1 => expectedOptionCount! }
                                    hasFileSize -> if { expectedOptionCount! + 1 => expectedOptionCount! }
                                    chainValid! and optionOrdinal! == expectedOptionCount!
                                        -> if { true => valid! }
                                }
                        }
                }
        }
    valid!
}

invalidMapBindingIr context: ref emitterContext.EmitContext -> Int {
    [Int; ~] => mapIrByAst!
    [Int; ~] => mapIrCountByAst!
    0 => astInit!
    astInit! < (context.nodes -> len) -> while {
        mapIrByAst! -> push(-1)
        mapIrCountByAst! -> push(0)
        astInit! + 1 => astInit!
    }
    0 => irIndex!
    irIndex! < (context.ir -> len) -> while {
        context.ir[irIndex!] => candidate
        candidate.sourceModule >= 0 and candidate.sourceModule < (context.ranges -> len)
            -> if {
                context.ranges[candidate.sourceModule] => sourceRange
                candidate.astNode >= 0 and candidate.astNode < sourceRange.astCount
                    and context.nodes[sourceRange.astStart + candidate.astNode].kind == 49
                    -> if {
                        sourceRange.astStart + candidate.astNode => globalAst
                        mapIrByAst![globalAst] < 0 -> if { irIndex! => mapIrByAst![globalAst] }
                        mapIrCountByAst![globalAst] + 1 => mapIrCountByAst![globalAst]
                    }
            }
        irIndex! + 1 => irIndex!
    }
    -1 => invalid!
    0 => bindingIndex!
    bindingIndex! < (context.ir -> len) and invalid! < 0
        -> while {
            context.ir[bindingIndex!] => binding
            binding.kind == 17
                and binding.sourceModule >= 0
                and binding.sourceModule < (context.ranges -> len)
                -> if {
                    context -> mapAstForBinding(bindingIndex!) => mapAst
                    mapAst >= 0 -> if {
                        context.ranges[binding.sourceModule] => sourceRange
                        sourceRange.astStart + mapAst => globalMapAst
                        context -> mapAstOpcode(binding.sourceModule, mapAst) => expectedOpcode
                        -1 => expectedSymbol!
                        expectedOpcode == -306 -> if { 17 => expectedSymbol! }
                        expectedOpcode == -307 -> if { 18 => expectedSymbol! }
                        mapIrByAst![globalMapAst] => producerIndex
                        producerIndex < 0 or mapIrCountByAst![globalMapAst] != 1
                            -> if { bindingIndex! => invalid! } else {
                                context.ir[producerIndex] => producer
                                (expectedOpcode != -306 and expectedOpcode != -307)
                                    or not (context -> mapProducerContractValid(producerIndex, expectedOpcode, expectedSymbol!))
                                    or binding.operand0 != producerIndex
                                    -> if { bindingIndex! => invalid! }
                            }
                    }
                }
            bindingIndex! + 1 => bindingIndex!
        }
    invalid!
}

invalidMappedFlushIr context: ref emitterContext.EmitContext -> Int {
    -1 => invalid!
    0 => irIndex!
    irIndex! < (context.ir -> len) and invalid! < 0
        -> while {
            context.ir[irIndex!] => candidate
            candidate.symbol == -114 -> if {
                candidate.operand0 < 0 or candidate.operand0 >= (context.ir -> len)
                    -> if { irIndex! => invalid! } else {
                        context.ir[candidate.operand0] => receiver
                        not (receiver -> irNodeHasBuiltinType(18, context))
                            -> if { irIndex! => invalid! }
                    }
            }
            irIndex! + 1 => irIndex!
        }
    invalid!
}

invalidValueLayoutType context: ref emitterContext.EmitContext -> Int {
    -1 => invalid!
    0 => index!
    index! < (context.typeLayoutStatuses -> len) and invalid! < 0
        -> while {
            context.types[index!] => candidate
            context.typeLayoutStatuses[index!] == 3 and candidate.kind == 1
                and (candidate.origin == 0 or candidate.origin == 2)
                -> if { index! => invalid! }
            index! + 1 => index!
        }
    invalid!
}

irInvariantDiagnosticCount context: ref emitterContext.EmitContext -> Int {
    (context -> invalidValueLayoutType) >= 0 -> if { 1 -> return }
    context -> concreteFunctionsBySymbol => functions
    0 => count!
    0 => irIndex!
    irIndex! < (context.ir -> len) -> while {
        context -> irInvariantCode(irIndex!, functions) => invariantCode
        invariantCode != 0
            -> if { count! + 1 => count! }
        irIndex! + 1 => irIndex!
    }
    (context -> invalidInterpolationCapacityNode) >= 0
        -> if { count! + 1 => count! }
    count! + (context -> runtimeAbiDiagnosticCount) => count!
    (context -> unresolvedGenericAbiNode) >= 0 -> if { count! + 1 => count! }
    (context -> missingBinaryBindingIr) >= 0 -> if { count! + 1 => count! }
    (context -> invalidMapBindingIr) >= 0 -> if { count! + 1 => count! }
    (context -> invalidMappedFlushIr) >= 0 -> if { count! + 1 => count! }
    count!
}
