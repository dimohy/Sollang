binaryOpcodeValid opcode: Int -> Bool {
    ((opcode >= grammar.tokenIdPlus() and opcode <= grammar.tokenIdPercent())
        or opcode == grammar.tokenIdEqualEqual()
        or opcode == grammar.tokenIdBangEqual()
        or (opcode >= grammar.tokenIdLessEqual() and opcode <= grammar.tokenIdGreater())
        or opcode == -24
        or opcode == -25)
}

irScalarIntegerWidth node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext -> Int {
    -1 => symbol!
    node.typeId >= 0 -> if {
        context.types[node.typeId] => scalarType
        scalarType.kind == 1 and scalarType.origin == 1
            -> if { scalarType.symbol => symbol! }
    } else {
        node.typeKind == 1 and node.typeOrigin == 1
            -> if { node.typeSymbol => symbol! }
    }
    0 => width!
    symbol! == 3 or symbol! == 8 -> if { 8 => width! }
    symbol! == 4 or symbol! == 9 -> if { 16 => width! }
    symbol! == 2 or symbol! == 5 or symbol! == 10 or symbol! == 14
        -> if { 32 => width! }
    symbol! == 6 or symbol! == 7 or symbol! == 11
        -> if { 64 => width! }
    symbol! == 12 or symbol! == 13 -> if { context.pointerBitWidth => width! }
    width!
}

# Concrete arithmetic uses the same canonical callback role type as emission.
# Classes are 0 deferred, 1 numeric scalar, and 2 concrete non-numeric storage.
irNumericStorageClass node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext -> Int {
    node.typeId => typeId!
    node.kind == 5 and node.symbol >= 0 and node.sourceModule >= 0
        and node.sourceModule < (context.ranges -> len)
        -> if {
            context.ranges[node.sourceModule] => range
            node.symbol < range.symbolCount
                and context.symbols[range.symbolStart + node.symbol].kind == 35
                -> if {
                    0 => pipelineIndex!
                    false => resolved!
                    pipelineIndex! < (context.streamPlan.pipelines -> len) and not resolved!
                        -> while {
                            context -> emitterContext.streamCallbackInput(pipelineIndex!, node.sourceModule, node.symbol) => input
                            input.typeId >= 0 -> if {
                                input.typeId => typeId!
                                true => resolved!
                            }
                            pipelineIndex! + 1 => pipelineIndex!
                        }
                }
        }
    typeId! >= 0 and typeId! < (context.types -> len)
        -> if {
            context.types -> typeIds.materializedReadTypeId(typeId!) => typeId!
            typeId! >= 0 and typeId! < (context.types -> len)
                -> if {
                    context.types[typeId!] => valueType
                    not valueType.containsParameter -> if {
                        valueType.kind == 1 and valueType.origin == 1
                            and ((valueType.symbol >= 2 and valueType.symbol <= 14)
                            or (valueType.symbol >= 19 and valueType.symbol <= 22)) => numeric
                        numeric -> if { 1 -> return }
                        2 -> return
                    }
                }
        }
    0
}

irNodeHasSetType node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext -> Bool {
    (node.typeKind == 7
        and node.typeOrigin == 4
        and node.typeSymbol == 5) => isSet!
    node.typeId => typeId!
    not isSet!
        and typeId! >= 0
        and typeId! < (context.types -> len)
        and context.types[typeId!].kind == 8
        -> if { context.types[typeId!].first => typeId! }
    not isSet! and typeId! >= 0 and typeId! < (context.types -> len)
        -> if {
            context.types[typeId!] => canonicalType
            canonicalType.kind == 7
                and canonicalType.origin == 4
                and canonicalType.symbol == 5
                -> if { true => isSet! }
        }
    isSet!
}

irAggregateStorageClass node: typedIr.TypedIrNode -> Int {
    0 => storageClass!
    node -> isDynamicArrayType -> if { 1 => storageClass! }
    node -> isTextType -> if { 2 => storageClass! }
    node -> isSliceArrayType -> if { 3 => storageClass! }
    node -> isFixedArrayType -> if { 4 => storageClass! }
    node -> isDictionaryType -> if { 5 => storageClass! }
    node -> isGenericEnumType -> if { 6 => storageClass! }
    storageClass!
}

astNodeHasDirectChildKind context: ref emitterContext.EmitContext, sourceModule: Int, astNode: Int, childKind: Int -> Bool {
    false => found!
    sourceModule >= 0 and sourceModule < (context.ranges -> len)
        -> if {
            context.ranges[sourceModule] => sourceRange
            0 => candidateIndex!
            not found! and candidateIndex! < sourceRange.astCount
                -> while {
                    context.nodes[sourceRange.astStart + candidateIndex!] => candidate
                    candidate.kind == childKind and candidate.parent == astNode
                        -> if { true => found! }
                    candidateIndex! + 1 => candidateIndex!
                }
        }
    found!
}

concreteFunctionsBySymbol context: ref emitterContext.EmitContext -> [Int; ~] {
    [Int; ~] => functions!
    0 => symbolIndex!
    symbolIndex! < (context.symbols -> len) -> while {
        functions! -> push(-1)
        symbolIndex! + 1 => symbolIndex!
    }
    0 => candidateIndex!
    candidateIndex! < (context.ir -> len) -> while {
        context.ir[candidateIndex!] => candidate
        candidate.kind == 0
            and not (context -> emitterContext.isGenericInstance(candidateIndex!))
            and candidate.sourceModule >= 0
            and candidate.sourceModule < (context.ranges -> len)
            and candidate.symbol >= 0
            -> if {
                context.ranges[candidate.sourceModule].symbolStart + candidate.symbol
                    => globalSymbol
                globalSymbol >= 0 and globalSymbol < (functions! -> len)
                    -> if { candidateIndex! => functions![globalSymbol] }
            }
        candidateIndex! + 1 => candidateIndex!
    }
    functions!
}

# Typed IR functions and the synthetic entry are contiguous. Materialize their
# owner once so invariant checks and emitter indexes share the same O(n)
# function-boundary contract instead of rediscovering ranges per node.
irFunctionOwners context: ref emitterContext.EmitContext -> [Int; ~] {
    [Int; ~] => owners!
    -1 => owner!
    0 => index!
    index! < (context.ir -> len) -> while {
        context.ir[index!].kind == 0 or context.ir[index!].kind == 11
            -> if { index! => owner! }
        owners! -> push(owner!)
        index! + 1 => index!
    }
    owners!
}

concreteCallFunctionIndex context: ref emitterContext.EmitContext, callIndex: Int, functions: ref [Int; ~] -> Int {
    context -> emitterContext.genericFunctionForCall(callIndex) => genericFunction
    genericFunction >= 0 -> if { genericFunction -> return }
    context.ir[callIndex] => call
    -1 => resolved!
    call.targetModule >= 0
        and call.targetModule < (context.ranges -> len)
        and call.symbol >= 0
        -> if {
            context.ranges[call.targetModule].symbolStart + call.symbol => globalSymbol
            globalSymbol >= 0 and globalSymbol < (functions -> len)
                -> if { functions[globalSymbol] => resolved! }
        }
    resolved!
}

# A value-producing enum or numeric-subject match cannot retain provisional
# Unit when every continuing arm has the same canonical non-Unit terminal.
# Empty or differently typed arms keep the match in statement position.
matchHasCompleteCanonicalNonUnitTerminals context: ref emitterContext.EmitContext, matchIndex: Int -> Bool {
    false => foundValue!
    true => complete!
    -1 => resultTypeId!
    context.ir[matchIndex].operand1 => armIndex!
    armIndex! >= 0 and armIndex! < (context.ir -> len) and complete!
        -> while {
            context.ir[armIndex!] => arm
            arm.kind != 19 or arm.parent != matchIndex -> if {
                false => complete!
            } else {
                armIndex! -> typedIr.matchArmTerminalValueIndex(context.ir) => terminalIndex
                terminalIndex < 0 -> if {
                    false => complete!
                } else {
                    context.ir[terminalIndex] => terminal
                    terminal.kind != 23
                        and not (terminalIndex -> typedIr.terminalValueReturnsFromArm(armIndex!, context.ir))
                        -> if {
                            terminal.typeId >= 0
                                and not (terminal.typeOrigin == 1 and terminal.typeSymbol == 0)
                                -> if {
                                    resultTypeId! < 0 -> if { terminal.typeId => resultTypeId! } else {
                                        terminal.typeId != resultTypeId! -> if { false => complete! }
                                    }
                                    true => foundValue!
                                } else {
                                    false => complete!
                                }
                        }
                }
            }
            arm.nextOperand => armIndex!
        }
    complete! and foundValue!
}

runtimeParameterCount context: ref emitterContext.EmitContext, functionIndex: Int -> Int {
    0 => count!
    functionIndex >= 0 -> if {
        context.ir[functionIndex].operand1 => parameterIndex!
        0 => parameterOrdinal!
        parameterIndex! >= 0 -> while {
            context.ir[parameterIndex!] => parameter
            false => compileTimeValueParameter!
            parameter.sourceModule >= 0
                and parameter.sourceModule < (context.ranges -> len)
                and parameter.symbol >= 0
                and parameter.symbol < context.ranges[parameter.sourceModule].symbolCount
                -> if {
                    context.symbols[context.ranges[parameter.sourceModule].symbolStart + parameter.symbol].kind == 32
                        -> if { true => compileTimeValueParameter! }
                }
            not compileTimeValueParameter! -> if { count! + 1 => count! }
            parameterOrdinal! == 0 -> if {
                context.ir[functionIndex].nextOperand => parameterIndex!
            } else {
                parameter.nextOperand => parameterIndex!
            }
            parameterOrdinal! + 1 => parameterOrdinal!
        }
    }
    count!
}

linkedCallArgumentCount context: ref emitterContext.EmitContext, callIndex: Int, maximum: Int -> Int {
    0 => count!
    context.ir[callIndex].operand0 => argumentIndex!
    false => targetHasBlockRole!
    context.ir[callIndex] => call
    call.targetModule >= 0
        and call.targetModule < (context.ranges -> len)
        and call.symbol >= 0
        and call.symbol < context.ranges[call.targetModule].symbolCount
        -> if {
            context.ranges[call.targetModule].symbolStart + call.symbol => targetGlobalSymbol
            targetGlobalSymbol >= 0
                and targetGlobalSymbol < (context.symbols -> len)
                and context.symbols[targetGlobalSymbol].blockTypeNode >= 0
                -> if { true => targetHasBlockRole! }
        }
    # Count one slot beyond the concrete ABI so an extra linked argument
    # cannot be hidden by the expected-count bound. A block function is the
    # exception: its callback root intentionally follows the last runtime
    # argument in the same chain, so stop at the concrete ABI boundary.
    argumentIndex! >= 0
        and argumentIndex! < (context.ir -> len)
        and count! <= maximum
        and (not targetHasBlockRole! or count! < maximum)
        -> while {
            count! + 1 => count!
            context.ir[argumentIndex!].nextOperand => argumentIndex!
        }
    count!
}

implicitFlowArgumentCount context: ref emitterContext.EmitContext, callIndex: Int, linkedCount: Int, expectedCount: Int -> Int {
    0 => count!
    callIndex => ownerChildIndex!
    context.ir[callIndex].parent => ownerIndex!
    true => ownerOpen!
    ownerIndex! >= 0 and ownerIndex! < (context.ir -> len) and ownerOpen!
        -> while {
            context.ir[ownerIndex!] => owner
            owner.kind == 6
                and (owner.opcode == -207
                or owner.opcode == -208
                or owner.opcode == -209)
                -> if {
                    invariantRules.implicitFlowArgumentCount(true, ownerChildIndex! == owner.operand0, linkedCount, expectedCount) => count!
                    false => ownerOpen!
                } else {
                    owner.kind == 39
                        and owner.parent >= 0
                        and owner.parent < (context.ir -> len)
                        and (context.ir[owner.parent].kind == 37 or context.ir[owner.parent].kind == 38)
                        -> if {
                            invariantRules.implicitFlowArgumentCount(true, false, linkedCount, expectedCount) => count!
                            false => ownerOpen!
                        } else {
                            ownerIndex! => ownerChildIndex!
                            owner.parent => ownerIndex!
                        }
                }
        }
    count!
}

enumTypeDeclaresPattern context: ref emitterContext.EmitContext, subjectTypeId: Int, useSourceModule: Int, patternTokenIndex: Int -> Bool {
    false => declared!
    subjectTypeId >= 0
        and subjectTypeId < (context.types -> len)
        and useSourceModule >= 0
        and useSourceModule < (context.ranges -> len)
        -> if {
            context.ranges[useSourceModule] => useRange
            patternTokenIndex >= 0 and patternTokenIndex < useRange.tokenCount
                -> if {
                    context.tokens[useRange.tokenStart + patternTokenIndex] => patternToken
                    context.types[subjectTypeId] => subjectType
                    subjectType.kind == 7
                        and subjectType.origin == 4
                        and (subjectType.symbol == 0 or subjectType.symbol == 1)
                        -> if {
                            subjectType.symbol == 0 -> if {
                                patternToken.span.length == 4 -> if {
                                    context.sources[useSourceModule] -> byte(patternToken.span.start) => byte0
                                    context.sources[useSourceModule] -> byte(patternToken.span.start + 1) => byte1
                                    context.sources[useSourceModule] -> byte(patternToken.span.start + 2) => byte2
                                    context.sources[useSourceModule] -> byte(patternToken.span.start + 3) => byte3
                                    (byte0 == 78 and byte1 == 111 and byte2 == 110 and byte3 == 101)
                                        or (byte0 == 83 and byte1 == 111 and byte2 == 109 and byte3 == 101)
                                        -> if { true => declared! }
                                }
                            } else {
                                patternToken.span.length == 2 -> if {
                                    (context.sources[useSourceModule] -> byte(patternToken.span.start)) == 79
                                        and (context.sources[useSourceModule] -> byte(patternToken.span.start + 1)) == 107
                                        -> if { true => declared! }
                                }
                                patternToken.span.length == 3 -> if {
                                    (context.sources[useSourceModule] -> byte(patternToken.span.start)) == 69
                                        and (context.sources[useSourceModule] -> byte(patternToken.span.start + 1)) == 114
                                        and (context.sources[useSourceModule] -> byte(patternToken.span.start + 2)) == 114
                                        -> if { true => declared! }
                                }
                            }
                        }
                    subjectType.kind == 1 -> if {
                        subjectType.module => ownerSourceModule!
                        subjectType.origin == 2 -> if {
                            subjectType.module >= 0 and subjectType.module < (context.modules -> len)
                                -> if {
                                    context.modules[subjectType.module].sourceIndex => ownerSourceModule!
                                } else { -1 => ownerSourceModule! }
                        }
                        ownerSourceModule! >= 0 and ownerSourceModule! < (context.ranges -> len)
                            -> if {
                                context.ranges[ownerSourceModule!] => ownerRange
                                -1 => ownerDeclarationAst!
                                subjectType.symbol >= 0 and subjectType.symbol < ownerRange.symbolCount
                                    -> if {
                                        context.symbols[ownerRange.symbolStart + subjectType.symbol].astNode => ownerDeclarationAst!
                                    }
                                0 => declarationSearch!
                                ownerDeclarationAst! >= 0 and declarationSearch! < ownerRange.astCount and not declared!
                                    -> while {
                                        context.nodes[ownerRange.astStart + declarationSearch!] => declaration
                                        declaration.kind == 27
                                            and declaration.parent == ownerDeclarationAst!
                                            and declaration.payloadToken >= 0
                                            -> if {
                                                context.tokens[ownerRange.tokenStart + declaration.payloadToken] => declarationToken
                                                declarationToken.span.length == patternToken.span.length => sameName!
                                                UIntSize(0) => nameByte!
                                                sameName! and nameByte! < patternToken.span.length
                                                    -> while {
                                                        context.sources[ownerSourceModule!] -> byte(declarationToken.span.start + nameByte!) => declarationByte
                                                        context.sources[useSourceModule] -> byte(patternToken.span.start + nameByte!) => patternByte
                                                        declarationByte != patternByte -> if { false => sameName! }
                                                        nameByte! + 1 => nameByte!
                                                    }
                                                sameName! -> if { true => declared! }
                                            }
                                        declarationSearch! + 1 => declarationSearch!
                                    }
                            }
                    }
                }
        }
    declared!
}

typedControlTerminates controlIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    controlIndex >= 0 and controlIndex < (context.ir -> len)
        -> unless { false -> return }
    context.ir[controlIndex] => control
    control.kind == 23 -> if { true -> return }
    control.kind == 19 -> if {
        control.operand1 -> typedControlTerminates(context) => regionTerminates
        regionTerminates -> return
    }
    control.kind == 18 -> if {
        (control.operand1 -> typedControlTerminates(context))
            and (control.nextOperand -> typedControlTerminates(context))
            -> if { true -> return }
    }
    control.kind == 27 -> if {
        false => hasArm!
        true => allArmsTerminate!
        control.operand1 => armIndex!
        armIndex! >= 0 and armIndex! < (context.ir -> len)
            -> while {
                true => hasArm!
                context.ir[armIndex!] => arm
                armIndex! => armRegion!
                arm.operand1 >= 0
                    and arm.operand1 < (context.ir -> len)
                    and context.ir[arm.operand1].kind == 19
                    -> if { arm.operand1 => armRegion! }
                armRegion! -> typedControlTerminates(context) => armTerminates
                armTerminates -> unless { false => allArmsTerminate! }
                arm.nextOperand => armIndex!
            }
        hasArm! and allArmsTerminate! -> if { true -> return }
    }
    control.kind == 34 -> if {
        false => hasArm!
        false => hasElse!
        true => allArmsTerminate!
        control.operand1 => armIndex!
        true => armOpen!
        armIndex! >= 0 and armIndex! < (context.ir -> len) and armOpen!
            -> while {
                context.ir[armIndex!] => arm
                arm.parent != controlIndex -> if {
                    false => armOpen!
                } else {
                    true => hasArm!
                    armIndex! => armRegion!
                    arm.kind == 19 and arm.operand1 >= 0
                        -> if { arm.operand1 => armRegion! } else { true => hasElse! }
                    armRegion! -> typedControlTerminates(context) => armTerminates
                    armTerminates -> unless { false => allArmsTerminate! }
                    arm.nextOperand => armIndex!
                }
            }
        hasArm! and hasElse! and allArmsTerminate! -> if { true -> return }
    }
    false
}

# Typed IR must be structurally valid before any LLVM text is emitted. These
# codes identify the producer invariant, not an LLVM parser failure.
# Slice descriptors do not encode element width. Validate semantic element
# identity before an ABI-compatible header can hide an invalid typed conversion.
arrayCallElementMismatch context: ref emitterContext.EmitContext, callIndex: Int, functionIndex: Int -> Int {
    context.ir[functionIndex].operand1 => parameterIndex!
    context.ir[callIndex].operand0 => argumentIndex!
    context -> runtimeParameterCount(functionIndex) => expectedCount
    context -> linkedCallArgumentCount(callIndex, expectedCount) => linkedCount
    context -> implicitFlowArgumentCount(callIndex, linkedCount, expectedCount) => implicitCount
    0 => parameterOrdinal!
    0 => runtimeOrdinal!
    0 => mismatch!
    parameterIndex! >= 0 and argumentIndex! >= 0 and mismatch! == 0
        -> while {
            context.ir[parameterIndex!] => parameter
            false => compileTimeParameter!
            parameter.sourceModule >= 0 and parameter.symbol >= 0
                -> if {
                    context.ranges[parameter.sourceModule] => parameterRange
                    context.symbols[parameterRange.symbolStart + parameter.symbol].kind == 32
                        -> if { true => compileTimeParameter! }
                }
            not compileTimeParameter! -> if {
                # A worker supplies the implicit role slot. Explicit captures
                # still align with their own subsequent runtime parameter.
                runtimeOrdinal! >= implicitCount -> if {
                    context.types -> typeIds.materializedReadTypeId(parameter.typeId) => expectedType
                    context.types -> typeIds.materializedReadTypeId(context.ir[argumentIndex!].typeId) => actualType
                    expectedType >= 0 and actualType >= 0
                        and expectedType < (context.types -> len)
                        and actualType < (context.types -> len)
                        -> if {
                            context.types[expectedType] => expected
                            context.types[actualType] => actual
                            (expected.kind == 2 or expected.kind == 3 or expected.kind == 4 or expected.kind == 12)
                                and (actual.kind == 2 or actual.kind == 3 or actual.kind == 4 or actual.kind == 12)
                                and expected.first >= 0 and actual.first >= 0
                                and not context.types[expected.first].containsParameter
                                and not context.types[actual.first].containsParameter
                                and expected.first != actual.first
                                -> if { runtimeOrdinal! + 1 => mismatch! }
                        }
                    context.ir[argumentIndex!].nextOperand => argumentIndex!
                }
                runtimeOrdinal! + 1 => runtimeOrdinal!
            }
            parameterOrdinal! == 0 -> if {
                context.ir[functionIndex].nextOperand => parameterIndex!
            } else {
                parameter.nextOperand => parameterIndex!
            }
            parameterOrdinal! + 1 => parameterOrdinal!
        }
    mismatch!
}

# A parameter-dependent call belongs to the unspecialized template until its
# concrete body supplies the receiver owner. Concrete instances never qualify:
# every unresolved instance still receives the ordinary call-identity error.
isDeferredTemplateReceiverCall context: ref emitterContext.EmitContext, irIndex: Int -> Bool {
    context.ir[irIndex] => call
    false => deferred!
    call.operand0 >= 0 and call.operand0 < (context.ir -> len)
        -> if {
            context.ir[call.operand0].typeId => receiverType
            receiverType >= 0 and receiverType < (context.types -> len)
                and context.types[receiverType].containsParameter
                -> if {
                    call.parent => owner!
                    owner! >= 0 and owner! < (context.ir -> len)
                        and context.ir[owner!].kind != 0
                        and context.ir[owner!].kind != 11
                        -> while { context.ir[owner!].parent => owner! }
                    owner! >= 0 and owner! < (context.ir -> len)
                        and context.ir[owner!].kind == 0
                        and not (context -> emitterContext.isGenericInstance(owner!))
                        -> if {
                            context.ir[owner!].operand1 => parameter!
                            true => firstParameter!
                            parameter! >= 0 and parameter! < (context.ir -> len)
                                and not deferred!
                                -> while {
                                    context.ir[parameter!].typeId => parameterType
                                    parameterType >= 0 and parameterType < (context.types -> len)
                                        and context.types[parameterType].containsParameter
                                        -> if { true => deferred! }
                                    firstParameter! -> if {
                                        context.ir[owner!].nextOperand => parameter!
                                        false => firstParameter!
                                    } else {
                                        context.ir[parameter!].nextOperand => parameter!
                                    }
                                }
                        }
                }
        }
    deferred!
}
struct StreamJoinInputContract {
    code: Int
    fieldOrdinal: Int
}
streamJoinInputContract context: ref emitterContext.EmitContext, join: typedIr.TypedIrNode -> StreamJoinInputContract {
    join.operand0 < 0 or join.operand0 >= (context.ir -> len)
        -> if { StreamJoinInputContract { code: 1, fieldOrdinal: -1 } -> return }
    context.types -> typeIds.materializedReadTypeId(context.ir[join.operand0].typeId) => productType
    productType < 0 or productType >= (context.types -> len)
        -> if { StreamJoinInputContract { code: 1, fieldOrdinal: -1 } -> return }
    context.types[productType].kind != 10 or context.types[productType].length < 2
        -> if { StreamJoinInputContract { code: 1, fieldOrdinal: -1 } -> return }
    -1 => firstStreamType!
    0 => fieldIndex!
    fieldIndex! < (context.fields -> len) -> while {
        context.fields[fieldIndex!] => field
        field.ownerType == productType and field.status == 0
            -> if {
                context.types -> typeIds.materializedReadTypeId(field.fieldType) => fieldType
                fieldType < 0 or fieldType >= (context.types -> len)
                    -> if { StreamJoinInputContract { code: 2, fieldOrdinal: field.ordinal } -> return }
                context.types[fieldType] => streamType
                streamType.kind != 7 or streamType.origin != 4 or (streamType.symbol != 3 and streamType.symbol != 4)
                    -> if { StreamJoinInputContract { code: 2, fieldOrdinal: field.ordinal } -> return }
                firstStreamType! < 0 -> if { fieldType => firstStreamType! } else {
                    (join.opcode == 1 or join.opcode == 2) and fieldType != firstStreamType!
                        -> if { StreamJoinInputContract { code: 3, fieldOrdinal: field.ordinal } -> return }
                }
            }
        fieldIndex! + 1 => fieldIndex!
    }
    StreamJoinInputContract { code: 0, fieldOrdinal: -1 }
}
public irInvariantCode context: ref emitterContext.EmitContext, irIndex: Int, functions: ref [Int; ~] -> Int {
    context.ir[irIndex] => node
    node.kind == 43 -> if {
        context -> streamJoinInputContract(node) => joinContract
        joinContract.code != 0 -> if { 57 -> return }
    }
    node.kind == 17 and node.operand0 >= 0 and node.operand0 < (context.ir -> len)
        and context.ir[node.operand0].kind == 43 -> if {
            context -> streamJoinInputContract(context.ir[node.operand0]) => joinContract
