# First LLVM text backend slice. Names are derived only from stable module and
# symbol indexes; SSA registers are derived from typed-IR indexes.
struct WhileBranchRequest {
    whileIndex: Int
    ownerIndex: Int
    conditionIndex: Int
}

struct WhileValueRequest {
    whileIndex: Int
    ownerIndex: Int
    nodeIndex: Int
}

struct IntegerPromotionRequest {
    expressionIndex: Int
    operandIndex: Int
    targetWidth: Int
    ownerIndex: Int
    right: Bool
}

struct CallEnvironmentRequest {
    callerIndex: Int
    callIndex: Int
    targetModule: Int
    targetSymbol: Int
    hasArgument: Bool
}

struct CaptureValueRequest {
    callerIndex: Int
    callIndex: Int
    bindingIndex: Int
    captureIndex: Int
}

struct NodeAncestorRequest {
    nodeIndex: Int
    ownerIndex: Int
}

struct TextLiteralRequest {
    sourceModule: Int
    token: syntax.SyntaxToken
}

struct WhileBoolTask {
    kind: Int
    nodeIndex: Int
    trueKind: Int
    trueNode: Int
    falseKind: Int
    falseNode: Int
}

struct OwnedDropRequest {
    regionIndex: Int
    beforeAst: Int
    edgeIndex: Int
    transferredSymbol: Int
}

struct DropGlueRequest {
    typeId: Int
    typeOrigin: Int
    typeModule: Int
    typeSymbol: Int
    valueKind: Int
    valueIndex: Int
    nameRoot: Int
    pathCode: Int
    bindingIndex: Int
    regionIndex: Int
    beforeAst: Int
    parentTask: Int
    fieldOrdinal: Int
    hasPartialMoves: Bool
}

struct EnumDropRequest {
    typeId: Int
    valueKind: Int
    valueIndex: Int
    nameRoot: Int
    bindingIndex: Int
    regionIndex: Int
}

struct EnumPayloadDropRequest {
    enumTypeId: Int
    payloadTypeId: Int
    nameRoot: Int
    pointerRoot: Int
    bindingIndex: Int
    regionIndex: Int
}

struct TryParallelCollectRequest {
    expressionIndex: Int
    outerTypeId: Int
    callbackTypeId: Int
}

struct ProcessCallRequest {
    callIndex: Int
    ownerIndex: Int
}

struct DirectoryCallRequest {
    callIndex: Int
    ownerIndex: Int
}

struct FileCallRequest {
    callIndex: Int
    ownerIndex: Int
}

struct PrepareRequest {
    sources: [Text; ~]
    pointerBitWidth: Int
    targetArchitecture: Int
    cpuDispatchPolicy: Int
    requiredCpuFeatures: UInt64
    allowedCpuFeatures: UInt64
    forbiddenCpuFeatures: UInt64
    supportsComputePool: Bool
    expectedPathStyle: Int
}

struct SocketCallRequest {
    callIndex: Int
    ownerIndex: Int
}

# LLVM allocas execute each time control reaches them. Fixed-size result and
# scratch slots therefore belong to the owning function entry, never to a loop
# or branch body.
emitHoistedControlAllocas ownerIndex: Int, startIndex: Int, endIndex: Int, includeParameters: Bool, profile: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    includeParameters -> if {
        0 => pathOwnedParameterOrdinal!
        context -> parameterIndexAtOrdinal(ownerIndex, pathOwnedParameterOrdinal!) => pathOwnedParameterIndex!
        pathOwnedParameterIndex! >= 0 -> while {
            pathOwnedParameterIndex! -> moveParameterNeedsPathOwnershipFlag(ownerIndex, context, state)
                -> if {
                    "  %arg$(pathOwnedParameterIndex!)_owned = alloca i1, align 1" -> println
                    "  store i1 true, ptr %arg$(pathOwnedParameterIndex!)_owned, align 1" -> println
                }
            pathOwnedParameterOrdinal! + 1 => pathOwnedParameterOrdinal!
            context -> parameterIndexAtOrdinal(ownerIndex, pathOwnedParameterOrdinal!) => pathOwnedParameterIndex!
        }
    }
    startIndex => nodeIndex!
    nodeIndex! < endIndex -> while {
        profile and (nodeIndex! - startIndex) % 256 == 0
            -> if { "control allocas owner $ownerIndex node $(nodeIndex!)" -> runtime.eprintln }
        context.ir[nodeIndex!] => node
        node.kind == 14 and (node -> isFixedArrayType)
            -> if {
                0 => fixedArrayLength!
                node.operand0 => fixedArrayElementIndex!
                fixedArrayElementIndex! >= 0 -> while {
                    fixedArrayLength! + 1 => fixedArrayLength!
                    context.ir[fixedArrayElementIndex!].nextOperand => fixedArrayElementIndex!
                }
                node.typeId >= 0
                    and context.types[node.typeId].kind == 4
                    and context.types[node.typeId].length >= 0
                    -> if { context.types[node.typeId].length => fixedArrayLength! }
                fixedArrayLength! * (node -> arrayElementSize(context, state)) => fixedArrayByteLength
                "  %v$(nodeIndex!)_data = alloca [$fixedArrayByteLength x i8], align " -> print
                node -> arrayElementAlign(context, state) -> writeDecimalLine
            }
        node.kind == 18 -> if {
            false => valueUsed!
            nodeIndex! -> controlValueUsed(ownerIndex, context, state) => valueUsed!
            valueUsed! and not (node.typeOrigin == 1 and node.typeSymbol == 0) and node.nextOperand >= 0
                -> if {
                    "  %if$(nodeIndex!)_result = alloca " -> print
                    node -> writeIrType(context, state)
                    ", align " -> print
                    node -> storageAlign(context, state) -> writeDecimalLine
                }
        }
        node.kind == 33 or node.kind == 34 -> if {
            nodeIndex! -> controlValueUsed(ownerIndex, context, state) => whenValueUsed!
            node.kind == 33
                and ownerIndex >= 0
                and ownerIndex < (context.ir -> len)
                and (context.ir[ownerIndex].kind == 0 or context.ir[ownerIndex].kind == 11)
                and context.ir[ownerIndex].operand0 >= 0
                and context.ir[ownerIndex].operand0 < (context.ir -> len)
                and context.ir[context.ir[ownerIndex].operand0].kind == 1
                and context.ir[context.ir[ownerIndex].operand0].operand0 == nodeIndex!
                -> if { true => whenValueUsed! }
            whenValueUsed! and not (node.typeOrigin == 1 and node.typeSymbol == 0)
                -> if {
                    "  %if$(nodeIndex!)_result = alloca " -> print
                    node -> writeIrType(context, state)
                    ", align " -> print
                    node -> storageAlign(context, state) -> writeDecimalLine
                }
        }
        node.kind == 27 and node.operand0 >= 0 -> if {
            context.ir[node.operand0] => subject
            "  %v$(nodeIndex!)_subject_slot = alloca " -> print
            subject -> writeIrType(context, state)
            ", align 8" -> println
            nodeIndex! -> controlValueUsed(ownerIndex, context, state) => matchValueUsed!
            # A function body can return a control value directly through its
            # region edge without creating a separate value-consumer node.
            ownerIndex >= 0
                and ownerIndex < (context.ir -> len)
                and (context.ir[ownerIndex].kind == 0 or context.ir[ownerIndex].kind == 11)
                and context.ir[ownerIndex].operand0 >= 0
                and context.ir[ownerIndex].operand0 < (context.ir -> len)
                -> if {
                    context.ir[ownerIndex].operand0 => functionBodyIndex
                    context.ir[functionBodyIndex].kind == 1
                        and context.ir[functionBodyIndex].operand0 == nodeIndex!
                        -> if { true => matchValueUsed! }
                }
            matchValueUsed!
                and (nodeIndex! -> enumMatchHasConcreteArmValues(context, state))
                and not (node.typeOrigin == 1 and node.typeSymbol == 0)
                -> if {
                    "  %v$(nodeIndex!)_result = alloca " -> print
                    node -> writeIrType(context, state)
                    ", align " -> print
                    node -> storageAlign(context, state) -> writeDecimalLine
                }
        }
        # A moved enum payload can be initialized in only one branch while its
        # cleanup flag is cleared at a later merge shared by sibling branches.
        # Hoist the flag itself to the function entry and initialize it false;
        # the selected arm changes it to true after loading the payload.
        node.kind == 27 -> if {
            node.operand1 => ownedArmIndex!
            ownedArmIndex! >= 0 -> while {
                ownedArmIndex! -> matchArmBindingValueIndex(context, state)
                    => ownedArmBindingIndex
                false => ownedArmBindingHasMove!
                0 => ownedArmMoveSearch!
                ownedArmBindingIndex >= 0
                    and ownedArmMoveSearch! < (context.moves -> len)
                    and not ownedArmBindingHasMove!
                    -> while {
                        context.moves[ownedArmMoveSearch!].bindingIr == ownedArmBindingIndex
                            -> if { true => ownedArmBindingHasMove! }
                        ownedArmMoveSearch! + 1 => ownedArmMoveSearch!
                    }
                ownedArmBindingHasMove! -> if {
                    "  %v$(ownedArmBindingIndex)_owned = alloca i1, align 1" -> println
                    "  store i1 false, ptr %v$(ownedArmBindingIndex)_owned, align 1" -> println
                }
                context.ir[ownedArmIndex!].nextOperand => ownedArmIndex!
            }
        }
        (node.kind == 6 or node.kind == 9)
            and (node.opcode == -216 or node.opcode == -217 or node.opcode == -304 or node.opcode == -305)
            -> if {
                "  %v$(nodeIndex!)_file_result_slot = alloca " -> print
                node -> writeIrType(context, state)
                ", align 8" -> println
            }
        (node.kind == 6 or node.kind == 9)
            and (node.opcode -> typedIr.isSocketResultOpcode)
            -> if {
                "  %v$(nodeIndex!)_socket_result_slot = alloca " -> print
                node -> writeIrType(context, state)
                ", align 8" -> println
            }
        (node.kind == 6 or node.kind == 9)
            and node.opcode == -221
            and node.operand0 >= 0
            and context.ir[node.operand0].nextOperand >= 0
            -> if {
                node.operand0 => scalarArgumentIndex!
                context.ir[scalarArgumentIndex!].nextOperand => offsetArgumentIndex!
                context.ir[offsetArgumentIndex!].nextOperand >= 0
                    -> while {
                        offsetArgumentIndex! => scalarArgumentIndex!
                        context.ir[offsetArgumentIndex!].nextOperand => offsetArgumentIndex!
                    }
                scalarArgumentIndex! -> aggregateValueIndex(context, state) => scalarIndex
                context.ir[scalarIndex] => scalar
                scalar.typeId => scalarTypeId!
                scalarTypeId! < 0 -> if { scalar.typeSymbol => scalarTypeId! }
                "  %v$(nodeIndex!)_file_write_slot = alloca " -> print
                scalarTypeId! -> writeSemanticTypeId(context, state)
                ", align " -> print
                context.typeAligns[scalarTypeId!] -> writeDecimalLine
                "  %v$(nodeIndex!)_file_result_slot = alloca " -> print
                node -> writeIrType(context, state)
                ", align 8" -> println
            }
        (node.kind == 6 or node.kind == 9) and node.opcode == -220
            -> if {
                context.types[node.typeId].first => optionTypeId
                context.types[optionTypeId].first => scalarTypeId
                "  %v$(nodeIndex!)_file_read_slot = alloca " -> print
                scalarTypeId == 23 -> if { "i8" -> print } else { scalarTypeId -> writeSemanticTypeId(context, state) }
                ", align " -> print
                context.typeAligns[scalarTypeId] -> writeDecimalLine
                "  %v$(nodeIndex!)_file_result_slot = alloca " -> print
                node -> writeIrType(context, state)
                ", align 8" -> println
                "  %v$(nodeIndex!)_file_option_slot = alloca " -> print
                optionTypeId -> writeSemanticTypeId(context, state)
                ", align 8" -> println
            }
        nodeIndex! + 1 => nodeIndex!
    }
    profile -> if { "control allocas owner $ownerIndex complete" -> runtime.eprintln }
}

# Stack-owned orchestration state shared by the responsibility fragments.
# Every extracted helper receives `ref CoreEmitterState`, so the large context
# and immutable lookup snapshots are never copied and no wrapper allocation is
# introduced.
struct BodySchedulePlan {
    functionIndex: Int
    order: [Int; ~]
    scheduled: [Bool; ~]
    failureNode: Int
    failureTerminal: Int
}
struct CoreEmitterState {
    bodySchedules: [BodySchedulePlan; ~]
    frozenFunctionEnds: [Int; ~]
    frozenFirstIrChildByParent: [Int; ~]
    frozenNextIrSiblingByNode: [Int; ~]
    frozenValuesHaveFunctionLocalDirectBindings: [Bool; ~]
    frozenReachableFunctions: [Bool; ~]
    frozenCaptureFunctionsBySymbol: [Int; ~]
    frozenFunctionsHaveDeclaredEffectsBySymbol: [Bool; ~]
    frozenFunctionCaptureOffsets: [Int; ~]
    frozenFunctionCaptureCounts: [Int; ~]
    frozenFunctionCaptureValues: [Int; ~]
    frozenEnumMatchConsumed: [Bool; ~]
    intrinsicRuntimeModule: Int
}

public struct TypeLayoutRequest {
    public types: [typeIds.SemanticType; ~]
    public fields: [typeIds.NominalField; ~]
    public typeId: Int
    public pointerBitWidth: Int
}

public struct TypeLayout {
    public size: Int
    public align: Int
    # 0 known, 1 unresolved recursive dependency, 2 unsupported type.
    public status: Int
}

public struct TypeLayouts {
    public sizes: [Int; ~]
    public aligns: [Int; ~]
    public statuses: [Int; ~]
}

parameterIndexForFunction context: ref emitterContext.EmitContext, functionIndex: Int, symbol: Int -> Int {
    context.ir[functionIndex] => function
    function.operand1 => parameterIndex!
    0 => parameterOrdinal!
    -1 => matchedIndex!
    parameterIndex! >= 0 and matchedIndex! < 0 -> while {
        context.ir[parameterIndex!] => parameter
        symbol >= 0 and parameter.kind == 10 and parameter.symbol == symbol
            -> if {
                parameterIndex! => matchedIndex!
            } else {
                parameterOrdinal! == 0 -> if {
                    function.nextOperand => parameterIndex!
                } else {
                    parameter.nextOperand => parameterIndex!
                }
                parameterOrdinal! + 1 => parameterOrdinal!
            }
    }
    matchedIndex!
}

parameterIndexAtOrdinal context: ref emitterContext.EmitContext, functionIndex: Int, ordinal: Int -> Int {
    context.ir[functionIndex] => function
    function.operand1 => parameterIndex!
    0 => parameterOrdinal!
    parameterIndex! >= 0 and parameterOrdinal! < ordinal
        -> while {
            parameterOrdinal! == 0 -> if {
                function.nextOperand => parameterIndex!
            } else {
                context.ir[parameterIndex!].nextOperand => parameterIndex!
            }
            parameterOrdinal! + 1 => parameterOrdinal!
        }
    parameterOrdinal! == ordinal -> if { parameterIndex! } else { -1 }
}

writeParameterReference context: ref emitterContext.EmitContext, functionIndex: Int, symbol: Int -> Bool uses Console {
    context.ir[functionIndex] => function
    function.operand1 => parameterIndex!
    0 => parameterOrdinal!
    false => matched!
    parameterIndex! >= 0 and not matched! -> while {
        context.ir[parameterIndex!] => parameter
        symbol >= 0 and parameter.kind == 10 and parameter.symbol == symbol
            -> if {
                parameterOrdinal! == 0 -> if {
                    "%arg" -> print
                } else {
                    "%arg$(parameterOrdinal!)" -> print
                }
                true => matched!
            } else {
                parameterOrdinal! == 0 -> if {
                    function.nextOperand => parameterIndex!
                } else {
                    parameter.nextOperand => parameterIndex!
                }
                parameterOrdinal! + 1 => parameterOrdinal!
            }
    }
    matched!
}

isDirectEachRoleSymbol sourceModule: Int, symbolIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    false => matched!
    sourceModule >= 0 and sourceModule < (context.ranges -> len)
        -> if {
            context.ranges[sourceModule] => roleRange
            symbolIndex >= 0 and symbolIndex < roleRange.symbolCount
                -> if {
                    context.symbols[roleRange.symbolStart + symbolIndex] => roleSymbol
                    roleSymbol.kind == 35 and roleSymbol.parent >= 0 and roleSymbol.parent < roleRange.symbolCount
                        -> if {
                            context.symbols[roleRange.symbolStart + roleSymbol.parent] => roleOwner
                            roleOwner.kind == 48 and roleOwner.astNode == roleSymbol.astNode and roleOwner.astNode >= 0
                                -> if {
                                    context.nodes[roleRange.astStart + roleOwner.astNode] => roleAst
                                    roleAst.payloadToken >= 0 -> if {
                                        context.tokens[roleRange.tokenStart + roleAst.payloadToken] => roleName
                                        roleName.span.length == 4
                                            and (context.sources[sourceModule] -> byte(roleName.span.start)) == 101
                                            and (context.sources[sourceModule] -> byte(roleName.span.start + 1)) == 97
                                            and (context.sources[sourceModule] -> byte(roleName.span.start + 2)) == 99
                                            and (context.sources[sourceModule] -> byte(roleName.span.start + 3)) == 104
                                            -> if {
                                                true => matched!
                                            }
                                    }
                                }
                        }
                }
        }
    matched!
}

writeDirectEachRoleValue node: interpolation.InterpolationNode, sourceModule: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool uses Console {
    node -> directEachRoleTypeId(sourceModule, context, state) => typeId
    typeId >= 0 => matched
    matched -> if { "%each_role_m$(sourceModule)_s$(node.symbol)" -> print }
    matched
}

directEachRoleTypeId node: interpolation.InterpolationNode, sourceModule: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => typeId!
    sourceModule -> isDirectEachRoleSymbol(node.symbol, context)
        -> if {
            context.ranges[sourceModule] => roleRange
            context.symbols[roleRange.symbolStart + node.symbol] => roleSymbol
            0 => eachSearch!
            eachSearch! < (context.ir -> len) and typeId! < 0
                -> while {
                    context.ir[eachSearch!] => eachCandidate
                    eachCandidate.kind == 6
                        and eachCandidate.opcode == -208
                        and eachCandidate.sourceModule == sourceModule
                        and eachCandidate.astNode == roleSymbol.astNode
                        and eachCandidate.operand0 >= 0
                        and (eachSearch! -> plannedStreamPipeline(context, state)) < 0
                        -> if {
                            context.ir[eachCandidate.operand0] -> directEachElementTypeId(context, state) => typeId!
                        }
                    eachSearch! + 1 => eachSearch!
                }
        }
    typeId!
}

symbolUsedInInterpolation sourceModule: Int, symbolIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    false => used!
    sourceModule >= 0 and sourceModule < (context.interpolationRanges -> len)
        -> if {
            context.interpolationRanges[sourceModule] => interpolationRange
            0 => interpolationIndex!
            interpolationIndex! < interpolationRange.nodeCount and not used!
                -> while {
                    context.interpolations[interpolationRange.nodeStart + interpolationIndex!] => interpolationNode
                    interpolationNode.kind == 1 and interpolationNode.symbol == symbolIndex
                        -> if { true => used! }
                    interpolationIndex! + 1 => interpolationIndex!
                }
        }
    used!
}

valueHasDirectBinding nodeIndex: Int, state: ref CoreEmitterState -> Bool {
    nodeIndex >= 0
        and nodeIndex < (state.frozenValuesHaveFunctionLocalDirectBindings -> len)
        and state.frozenValuesHaveFunctionLocalDirectBindings[nodeIndex]
}

directBlockResultControlIndex blockIndex: Int, typeReferenceIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => resolved!
    blockIndex >= 0
        and blockIndex < (context.ir -> len)
        and typeReferenceIndex >= 0
        and typeReferenceIndex < (context.ir -> len)
        and context.ir[blockIndex].kind == 26
        and context.ir[blockIndex].opcode == 0
        -> if {
            context.ir[typeReferenceIndex] => typeReference
            blockIndex + 1 => childIndex!
            context.ir -> len => childEnd!
            blockIndex => blockOwner!
            blockOwner! >= 0 and context.ir[blockOwner!].kind != 0 and context.ir[blockOwner!].kind != 11
                -> while { context.ir[blockOwner!].parent => blockOwner! }
            blockOwner! >= 0 -> if { blockOwner! -> functionEnd(context, state) => childEnd! }
            childIndex! < childEnd! -> while {
                context.ir[childIndex!] => child
                false => childTypeMatches!
                typeReference.typeId >= 0 and child.typeId == typeReference.typeId
                    -> if { true => childTypeMatches! }
                typeReference.typeId < 0
                    and child.typeId < 0
                    and child.typeKind == typeReference.typeKind
                    and child.typeOrigin == typeReference.typeOrigin
                    and child.typeModule == typeReference.typeModule
                    and child.typeSymbol == typeReference.typeSymbol
                    -> if { true => childTypeMatches! }
                child.parent == blockIndex
                    and childTypeMatches!
                    and (child.kind == 18
                    or child.kind == 20
                    or child.kind == 27
                    or child.kind == 33
                    or child.kind == 34)
                    -> if { childIndex! => resolved! }
                childIndex! + 1 => childIndex!
            }
        }
    resolved!
}

controlResultShapeComplete controlIndex: Int, depth: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    true => complete!
    depth >= 32 -> if { false => complete! }
    controlIndex < 0 or controlIndex >= (context.ir -> len)
        -> if { false => complete! }
    complete! -> if {
        context.ir[controlIndex] => control
        control.kind == 18 -> if {
            control.operand1 < 0
                or control.operand1 >= (context.ir -> len)
                or context.ir[control.operand1].kind != 19
                or control.nextOperand < 0
                or control.nextOperand >= (context.ir -> len)
                or context.ir[control.nextOperand].kind != 19
                -> if { false => complete! } else {
                    context.ir[control.operand1].operand1 => rawThenResult
                    context.ir[control.nextOperand].operand1 => rawElseResult
                    rawThenResult < 0 or rawThenResult >= (context.ir -> len)
                        or rawElseResult < 0 or rawElseResult >= (context.ir -> len)
                        or context.ir[rawThenResult].kind == 17
                        or context.ir[rawElseResult].kind == 17
                        -> if { false => complete! } else {
                            control.operand1 -> regionResultValueIndex(context, state) => thenResult
                            control.nextOperand -> regionResultValueIndex(context, state) => elseResult
                            thenResult < 0 or thenResult >= (context.ir -> len)
                                or elseResult < 0 or elseResult >= (context.ir -> len)
                                -> if { false => complete! } else {
                                    context.ir[thenResult] => thenValue
                                    context.ir[elseResult] => elseValue
                                    (thenValue.kind == 18
                                        and not (thenResult -> controlResultShapeComplete(depth + 1, context, state)))
                                        or (elseValue.kind == 18
                                        and not (elseResult -> controlResultShapeComplete(depth + 1, context, state)))
                                        -> if { false => complete! }
                                }
                        }
                }
        }
    }
    complete!
}

# Arguments exposes borrowed Text values through its runtime view, not an
# addressable array of Text descriptors. Keep the role ABI shared everywhere.
directEachElementTypeId source: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    source.kind == 31 -> if { 2 } else {
        source -> isArgumentsType -> if { 1 } else {
            source -> arrayElementTypeId(context, state)
        }
    }
}

writeDirectEachElementType source: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    source -> directEachElementTypeId(context, state) => elementTypeId
    elementTypeId >= 0 -> if { elementTypeId -> writeSemanticTypeId(context, state) } else {
        source -> writeArrayElementType(context, state)
    }
}

emitDirectEachRoleAliases eachIndex: Int, eachSource: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[eachIndex] => eachNode
    context.ranges[eachNode.sourceModule] => eachRange
    0 => eachRoleSymbolIndex!
    eachRoleSymbolIndex! < eachRange.symbolCount
        -> while {
            context.symbols[eachRange.symbolStart + eachRoleSymbolIndex!] => eachRoleSymbol
            eachRoleSymbol.astNode == eachNode.astNode
                and (eachNode.sourceModule -> isDirectEachRoleSymbol(eachRoleSymbolIndex!, context))
                and (eachNode.sourceModule -> symbolUsedInInterpolation(eachRoleSymbolIndex!, context))
                -> if {
                    "  %each_role_m$(eachNode.sourceModule)_s$(eachRoleSymbolIndex!) = freeze " -> print
                    eachSource -> writeDirectEachElementType(context, state)
                    " %each$(eachIndex)_item" -> println
                }
            eachRoleSymbolIndex! + 1 => eachRoleSymbolIndex!
        }
}

interpolationBindingIndex node: interpolation.InterpolationNode, sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    # Only a resolved lexical name identifies a binding. Member/call nodes use
    # their operand type; their -1 symbol must not match unnamed IR temporaries.
    node.kind != 1 or node.symbol < 0 -> if { -1 -> return }
    -1 => parameterIndex!
    ownerIndex >= 0 -> if {
        context -> parameterIndexForFunction(ownerIndex, node.symbol) => parameterIndex!
    }
    parameterIndex! >= 0 -> if {
        parameterIndex!
    } else {
        -1 => bindingIndex!
        UIntSize(0) => bindingStart!
        0 => bindingSearch!
        context.ir -> len => bindingEnd!
        ownerIndex >= 0 and ownerIndex < (context.ir -> len)
            -> if {
                ownerIndex + 1 => bindingSearch!
                ownerIndex -> functionEnd(context, state) => bindingEnd!
            }
        context.ranges[sourceModule] => bindingRange
        context.nodes[bindingRange.astStart + context.ir[beforeIndex].astNode].start => interpolationStart
        bindingSearch! < bindingEnd! -> while {
            context.ir[bindingSearch!] => bindingCandidate
            (bindingCandidate.kind == 17 or bindingCandidate.kind == 29)
                and bindingCandidate.sourceModule == sourceModule
                and bindingCandidate.symbol == node.symbol
                and bindingCandidate.astNode >= 0 -> if {
                    context.nodes[bindingRange.astStart + bindingCandidate.astNode].start => candidateStart
                    candidateStart <= interpolationStart
                        and (bindingIndex! < 0 or candidateStart > bindingStart!)
                        -> if {
                            bindingSearch! => bindingIndex!
                            candidateStart => bindingStart!
                        }
                }
            bindingSearch! + 1 => bindingSearch!
        }
        bindingIndex!
    }
}

interpolationEmissionOrder nodes: ref [interpolation.InterpolationNode; ~], sourceToken: Int, segment: Int -> [Int; ~] {
    [Bool; ~] => emitted!
    0 => emittedInit!
    emittedInit! < (nodes -> len) -> while {
        emitted! -> push(false)
        emittedInit! + 1 => emittedInit!
    }
    [Int; ~] => order!
    true => progress!
    progress! -> while {
        false => progress!
        Int(nodes -> len) - 1 => candidateIndex!
        candidateIndex! >= 0 -> while {
            nodes[candidateIndex!] => candidate
            candidate.sourceToken == sourceToken and candidate.segment == segment and not emitted![candidateIndex!]
                -> if {
                    true => ready!
                    candidate.operand0 >= 0 and nodes[candidate.operand0].sourceToken == sourceToken and nodes[candidate.operand0].segment == segment and not emitted![candidate.operand0]
                        -> if { false => ready! }
                    candidate.operand1 >= 0 and nodes[candidate.operand1].sourceToken == sourceToken and nodes[candidate.operand1].segment == segment and not emitted![candidate.operand1]
                        -> if { false => ready! }
                    candidate.operand2 >= 0 and nodes[candidate.operand2].sourceToken == sourceToken and nodes[candidate.operand2].segment == segment and not emitted![candidate.operand2]
                        -> if { false => ready! }
                    ready! -> if {
                        order! -> push(candidateIndex!)
                        true => emitted![candidateIndex!]
                        true => progress!
                    }
                }
            candidateIndex! - 1 => candidateIndex!
        }
    }
    order!
}

emitInterpolationLexicalLoad labelIndex: Int, nodeIndex: Int, node: interpolation.InterpolationNode, sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    node -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => bindingIndex
    bindingIndex >= 0 -> if {
        context.ir[bindingIndex] => binding
        binding.kind == 17 -> if {
            bindingIndex -> mutableStorageRoot(context, state) => storageRoot
            storageRoot >= 0 -> if {
                "  %v$(labelIndex)_expression$(nodeIndex)_mutable = load " -> print
                binding -> writeIrType(context, state)
                ", ptr %slot$(storageRoot), align 8" -> println
            }
        }
        binding.kind == 10 and binding.flags / 2 % 2 == 1
            -> if {
                bindingIndex -> mutableBorrowParameterOrdinal(ownerIndex, context, state) => parameterOrdinal
                parameterOrdinal >= 0 -> if {
                    binding -> mutableBorrowUsesStructPointer(context)
                        -> if {
                            "  %v$(labelIndex)_expression$(nodeIndex)_mutable = load " -> print
                            binding -> writeIrType(context, state)
                            ", ptr " -> print
                            parameterOrdinal -> writeMutableStructParameterPointer
                            ", align " -> print
                            binding -> storageAlign(context, state) -> writeDecimalLine
                        } else {
                            "  %v$(labelIndex)_expression$(nodeIndex)_mutable_ptr = load ptr, ptr " -> print
                            parameterOrdinal == 0 -> if { "%arg_mut_ptr_addr" -> print } else { "%arg$(parameterOrdinal)_mut_ptr_addr" -> print }
                            ", align 8" -> println
                            "  %v$(labelIndex)_expression$(nodeIndex)_mutable_len = load i64, ptr " -> print
                            parameterOrdinal == 0 -> if { "%arg_mut_len_addr" -> print } else { "%arg$(parameterOrdinal)_mut_len_addr" -> print }
                            ", align 8" -> println
                            "  %v$(labelIndex)_expression$(nodeIndex)_mutable_capacity = load i64, ptr " -> print
                            parameterOrdinal == 0 -> if { "%arg_mut_capacity_addr" -> print } else { "%arg$(parameterOrdinal)_mut_capacity_addr" -> print }
                            ", align 8" -> println
                            "  %v$(labelIndex)_expression$(nodeIndex)_mutable0 = insertvalue " -> print
                            binding -> writeIrType(context, state)
                            " poison, ptr %v$(labelIndex)_expression$(nodeIndex)_mutable_ptr, 0" -> println
                            "  %v$(labelIndex)_expression$(nodeIndex)_mutable1 = insertvalue " -> print
                            binding -> writeIrType(context, state)
                            " %v$(labelIndex)_expression$(nodeIndex)_mutable0, i64 %v$(labelIndex)_expression$(nodeIndex)_mutable_len, 1" -> println
                            "  %v$(labelIndex)_expression$(nodeIndex)_mutable = insertvalue " -> print
                            binding -> writeIrType(context, state)
                            " %v$(labelIndex)_expression$(nodeIndex)_mutable1, i64 %v$(labelIndex)_expression$(nodeIndex)_mutable_capacity, 2" -> println
                        }
                }
            }
    }
}

writeInterpolationIntegerLiteral node: interpolation.InterpolationNode, sourceModule: Int, context: ref emitterContext.EmitContext -> Unit uses Console {
    node.payloadStart => segmentStart!
    node.payloadStart => byteIndex!
    node.payloadStart + node.payloadLength => literalEnd
    byteIndex! < literalEnd -> while {
        (context.sources[sourceModule] -> byte(byteIndex!)) == 95
            -> if {
                byteIndex! > segmentStart! -> if {
                    context.sources[sourceModule] -> slice(segmentStart!, byteIndex! - segmentStart!) -> print
                }
                byteIndex! + 1 => segmentStart!
            }
        byteIndex! + 1 => byteIndex!
    }
    literalEnd > segmentStart! -> if {
        context.sources[sourceModule] -> slice(segmentStart!, literalEnd - segmentStart!) -> print
    }
}

writeInterpolationValue labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    nodes[nodeIndex] => node
    node.kind == 0 -> if {
        node -> writeInterpolationIntegerLiteral(sourceModule, context)
    } else {
        node.kind == 4 -> if {
            (context.sources[sourceModule] -> byte(node.payloadStart)) == 116
                -> if { "1" -> print } else { "0" -> print }
        } else {
            node.kind == 1 -> if {
                node -> writeDirectEachRoleValue(sourceModule, context, state) => directEachRole
                not directEachRole -> if {
                    node -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => bindingIndex
                    bindingIndex >= 0 and context.ir[bindingIndex].kind == 10
                        -> if {
                            context.ir[bindingIndex] => interpolationParameter
                            interpolationParameter.flags / 2 % 2 == 1 -> if {
                                "%v$(labelIndex)_expression$(nodeIndex)_mutable" -> print
                            } else {
                                context -> writeParameterReference(ownerIndex, node.symbol) => parameterWritten
                            }
                        } else {
                            bindingIndex >= 0 -> if {
                                context.ir[bindingIndex] => interpolationBinding
                                interpolationBinding.kind == 29 -> if {
                                    "%v$(bindingIndex)" -> print
                                } else {
                                    bindingIndex -> mutableStorageRoot(context, state) => storageRoot
                                    storageRoot >= 0 -> if {
                                        "%v$(labelIndex)_expression$(nodeIndex)_mutable" -> print
                                    } else {
                                        context.ir[interpolationBinding.operand0] => interpolationBindingValue
                                        interpolationBindingValue.kind == 3 or interpolationBindingValue.kind == 4
                                            -> if {
                                                interpolationBindingValue -> sourceToken(context, state) => interpolationBindingToken
                                                interpolationBindingValue.kind == 4 -> if {
                                                    (context.sources[interpolationBindingValue.sourceModule] -> byte(interpolationBindingToken.span.start)) == 116
                                                        -> if { "1" -> print } else { "0" -> print }
                                                } else {
                                                    interpolationBindingValue -> writeIntegerLiteral(context, state)
                                                }
                                            } else {
                                                "%v$(interpolationBinding.operand0)" -> print
                                            }
                                    }
                                }
                            }
                        }
                }
            } else {
                "%v$(labelIndex)_expression$(nodeIndex)" -> print
            }
        }
    }
}

interpolationCallTargetFunction nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    nodes[nodeIndex] => node
    -1 => target!
    node.kind == 8 and node.symbol >= 0 -> if {
        0 => localSearch!
        localSearch! < (context.ir -> len) -> while {
            context.ir[localSearch!] => localCandidate
            localCandidate.kind == 0
                and localCandidate.sourceModule == sourceModule
                and localCandidate.symbol == node.symbol
                -> if { localSearch! => target! }
            localSearch! + 1 => localSearch!
        }
    }
    target! < 0
        and (node.kind == 8 or node.kind == 10)
        and node.operand0 >= 0
        -> if {
            node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => receiverType
            1 => argumentCount!
            node.operand1 >= 0 -> if { argumentCount! + 1 => argumentCount! }
            node.operand2 >= 0 -> if { argumentCount! + 1 => argumentCount! }
            0 => candidateSearch!
            candidateSearch! < (context.ir -> len) -> while {
                context.ir[candidateSearch!] => candidate
                candidate.kind == 0
                    and candidate.operand1 >= 0
                    and context.ir[candidate.operand1].typeId == receiverType
                    and (node -> diagnostics.interpolationCallNameMatches(sourceModule, candidateSearch!, context))
                    -> if {
                        1 => parameterCount!
                        candidate.nextOperand => parameterSearch!
                        parameterSearch! >= 0 -> while {
                            parameterCount! + 1 => parameterCount!
                            context.ir[parameterSearch!].nextOperand => parameterSearch!
                        }
                        parameterCount! == argumentCount! -> if {
                            target! < 0 -> if { candidateSearch! => target! } else { -2 => target! }
                        }
                    }
                candidateSearch! + 1 => candidateSearch!
            }
        }
    target! >= 0 -> if { target! } else { -1 }
}

interpolationNodeTypeId nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    nodes[nodeIndex] => node
    -1 => typeId!
    node.kind == 1 -> if {
        node -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => bindingIndex
        bindingIndex >= 0 -> if {
            context.ir[bindingIndex].typeId => typeId!
        } else {
            node -> directEachRoleTypeId(sourceModule, context, state) => typeId!
        }
    }
    node.kind == 7 and node.operand0 >= 0 -> if {
        node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => containerTypeId!
        containerTypeId! >= 0 and context.types[containerTypeId!].kind == 8
            -> if { context.types[containerTypeId!].first => containerTypeId! }
        containerTypeId! >= 0 -> if {
            context.types[containerTypeId!] => containerType
            containerType.kind == 3 or containerType.kind == 4
                -> if { containerType.first => typeId! }
            containerType.kind == 5 or containerType.kind == 13
                -> if { containerType.second => typeId! }
            containerType.kind == 1 and containerType.origin == 1 and containerType.symbol == 1
                -> if {
                    0 => byteTypeSearch!
                    byteTypeSearch! < (context.types -> len) -> while {
                        context.types[byteTypeSearch!] => byteType
                        byteType.kind == 1 and byteType.origin == 1 and byteType.symbol == 8
                            -> if {
                                byteTypeSearch! => typeId!
                                context.types -> len => byteTypeSearch!
                            }
                        byteTypeSearch! + 1 => byteTypeSearch!
                    }
                }
        }
    }
    node.kind == 5 and node.operand0 >= 0 -> if {
        nodeIndex -> interpolationMemberFieldIndex(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => memberFieldIndex
        memberFieldIndex >= 0 -> if { context.fields[memberFieldIndex].fieldType => typeId! }
    }
    node.kind == 8 or node.kind == 10 -> if {
        nodeIndex -> interpolationCallTargetFunction(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => callTargetFunction
        callTargetFunction >= 0 -> if { context.ir[callTargetFunction].typeId => typeId! }
    }
    node.kind == 9 -> if {
        0 => conversionTypeSearch!
        conversionTypeSearch! < (context.types -> len)
            -> while {
                context.types[conversionTypeSearch!] => conversionType
                conversionType.kind == 1 and conversionType.origin == 1 and conversionType.symbol == node.typeSymbol
                    -> if {
                        conversionTypeSearch! => typeId!
                    }
                conversionTypeSearch! + 1 => conversionTypeSearch!
            }
    }
    typeId!
}

interpolationCallArgumentNeedsSliceProjection argumentIndex: Int, parameterIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    argumentIndex -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => argumentTypeId!
    argumentTypeId! >= 0 and argumentTypeId! < (context.types -> len) and context.types[argumentTypeId!].kind == 8
        -> if { context.types[argumentTypeId!].first => argumentTypeId! }
    (parameterIndex >= 0
        and parameterIndex < (context.ir -> len)
        and argumentTypeId! >= 0
        and argumentTypeId! < (context.types -> len)
        and context.ir[parameterIndex].typeId >= 0
        and context.ir[parameterIndex].typeId < (context.types -> len)
        and context.types[argumentTypeId!].kind == 3
        and context.types[context.ir[parameterIndex].typeId].kind == 2)
}

interpolationCallArgumentNeedsReferenceSlot argumentIndex: Int, parameterIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    argumentIndex -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => argumentTypeId
    context.ir -> len => irCount
    context.types -> len => typeCount
    parameterIndex >= 0 and parameterIndex < irCount => parameterInRange
    -1 => parameterTypeId!
    parameterInRange -> if { context.ir[parameterIndex].typeId => parameterTypeId! }
    argumentTypeId >= 0 and argumentTypeId < typeCount => argumentTypeInRange
    parameterTypeId! >= 0 and parameterTypeId! < typeCount => parameterTypeInRange
    argumentTypeInRange
        and parameterTypeInRange
        and context.types[parameterTypeId!].kind == 8
        and context.types[argumentTypeId].kind != 8
}

emitInterpolationCallReferenceArgumentAllocas labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    nodes[nodeIndex] => node
    node.kind == 8 or node.kind == 10 -> if {
        nodeIndex -> interpolationCallTargetFunction(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => callTargetFunction
        callTargetFunction >= 0 -> if {
            context.ir[callTargetFunction] => callTarget
            callTarget.operand1 => parameterIndex!
            node.operand0 => argumentIndex!
            0 => argumentOrdinal!
            parameterIndex! >= 0 and argumentIndex! >= 0 and argumentOrdinal! < 3
                -> while {
                    argumentIndex! -> interpolationCallArgumentNeedsReferenceSlot(
                    parameterIndex!,
                    nodes,
                    sourceModule,
                    ownerIndex,
                    beforeIndex,
                    context,
                    state) -> if {
                        context.types[context.ir[parameterIndex!].typeId].first => referenceOwnerType
                        "  %v$(labelIndex)_expression$(nodeIndex)_arg$(argumentOrdinal!)_ref = alloca " -> print
                        referenceOwnerType -> writeSemanticTypeId(context, state)
                        ", align $(context.typeAligns[referenceOwnerType])" -> println
                    }
                    argumentOrdinal! == 0 -> if { callTarget.nextOperand => parameterIndex! } else { context.ir[parameterIndex!].nextOperand => parameterIndex! }
                    argumentOrdinal! + 1 => argumentOrdinal!
                    argumentOrdinal! == 1 -> if { node.operand1 => argumentIndex! }
                    argumentOrdinal! == 2 -> if { node.operand2 => argumentIndex! }
                    argumentOrdinal! >= 3 -> if { -1 => argumentIndex! }
                }
        }
    }
}

interpolationMemberFieldIndex nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    nodes[nodeIndex] => node
    -1 => fieldIndex!
    node.kind == 5 and node.operand0 >= 0 -> if {
        node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => ownerTypeId!
        nodes[node.operand0] => memberBase
        memberBase.payloadStart + memberBase.payloadLength => memberCursor!
        node.payloadStart + node.payloadLength => memberEnd
        true => memberPathValid!
        memberPathValid! and memberCursor! < memberEnd
            -> while {
                memberCursor! < memberEnd and (context.sources[sourceModule] -> byte(memberCursor!)) != 46
                    -> while {
                        memberCursor! + 1 => memberCursor!
                    }
                memberCursor! + 1 => memberNameStart
                memberNameStart => memberNameEnd!
                memberNameEnd! < memberEnd and (context.sources[sourceModule] -> byte(memberNameEnd!)) != 46
                    -> while {
                        memberNameEnd! + 1 => memberNameEnd!
                    }
                memberNameEnd! - memberNameStart => memberNameLength
                ownerTypeId! >= 0 and context.types[ownerTypeId!].kind == 8
                    -> if { context.types[ownerTypeId!].first => ownerTypeId! }
                -1 => resolvedMemberField!
                0 => fieldSearch!
                fieldSearch! < (context.fields -> len) -> while {
                    context.fields[fieldSearch!] => field
                    field.status == 0
                        and field.ownerType == ownerTypeId!
                        and field.sourceModule >= 0
                        and (field.fieldSymbol >= 0 or field.labelToken >= 0)
                        -> if {
                            context.ranges[field.sourceModule] => fieldRange
                            field.labelToken => fieldNameToken!
                            field.fieldSymbol >= 0 -> if {
                                context.symbols[fieldRange.symbolStart + field.fieldSymbol] => fieldSymbol
                                fieldSymbol.nameToken => fieldNameToken!
                            }
                            context.tokens[fieldRange.tokenStart + fieldNameToken!] => fieldName
                            fieldName.span.length == memberNameLength => fieldNameEqual!
                            UIntSize(0) => fieldNameByte!
                            fieldNameEqual! and fieldNameByte! < memberNameLength
                                -> while {
                                    (context.sources[sourceModule] -> byte(memberNameStart + fieldNameByte!)) != (context.sources[field.sourceModule] -> byte(fieldName.span.start + fieldNameByte!))
                                        -> if { false => fieldNameEqual! }
                                    fieldNameByte! + 1 => fieldNameByte!
                                }
                            fieldNameEqual! -> if { fieldSearch! => resolvedMemberField! }
                        }
                    fieldSearch! + 1 => fieldSearch!
                }
                resolvedMemberField! >= 0 -> if {
                    resolvedMemberField! => fieldIndex!
                    context.fields[resolvedMemberField!].fieldType => ownerTypeId!
                    memberNameEnd! => memberCursor!
                } else {
                    false => memberPathValid!
                    -1 => fieldIndex!
                }
            }
    }
    fieldIndex!
}

canonicalMemberFieldIndex ownerTypeId: Int, sourceModule: Int, memberTokenIndex: Int, context: ref emitterContext.EmitContext -> Int {
    context.ranges[sourceModule] => memberRange
    context.tokens[memberRange.tokenStart + memberTokenIndex] => memberName
    -1 => fieldIndex!
    0 => fieldSearch!
    fieldSearch! < (context.fields -> len) -> while {
        context.fields[fieldSearch!] => field
        field.status == 0 and field.ownerType == ownerTypeId and field.sourceModule >= 0 and (field.fieldSymbol >= 0 or field.labelToken >= 0)
            -> if {
                context.ranges[field.sourceModule] => fieldRange
                field.labelToken => fieldNameToken!
                field.fieldSymbol >= 0 -> if {
                    context.symbols[fieldRange.symbolStart + field.fieldSymbol] => fieldSymbol
                    fieldSymbol.nameToken => fieldNameToken!
                }
                context.tokens[fieldRange.tokenStart + fieldNameToken!] => fieldName
                fieldName.span.length == memberName.span.length => equal!
                UIntSize(0) => nameByte!
                equal! and nameByte! < memberName.span.length
                    -> while {
                        (context.sources[sourceModule] -> byte(memberName.span.start + nameByte!)) != (context.sources[field.sourceModule] -> byte(fieldName.span.start + nameByte!))
                            -> if {
                                false => equal!
                            }
                        nameByte! + 1 => nameByte!
                    }
                equal! -> if { fieldSearch! => fieldIndex! }
            }
        fieldSearch! + 1 => fieldSearch!
    }
    fieldIndex!
}

canonicalMemberFieldOrdinalIndex ownerTypeId: Int, ordinal: Int, context: ref emitterContext.EmitContext -> Int {
    -1 => fieldIndex!
    0 => fieldSearch!
    fieldSearch! < (context.fields -> len) -> while {
        context.fields[fieldSearch!] => field
        field.status == 0 and field.ownerType == ownerTypeId and field.ordinal == ordinal
            -> if {
                fieldSearch! => fieldIndex!
            }
        fieldSearch! + 1 => fieldSearch!
    }
    fieldIndex!
}

canonicalMemberValueTypeId nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => valueTypeId!
    nodeIndex >= 0 and nodeIndex < (context.ir -> len)
        -> if {
            context.ir[nodeIndex] => node
            node.kind == 13 and node.operand0 >= 0 and node.operand0 < (context.ir -> len) and context.ir[node.operand0].typeId >= 0
                -> if {
                    context.ir[node.operand0] => memberBase
                    node -> sourceNode(context, state) => memberAst
                    memberBase -> sourceNode(context, state) => memberBaseAst
                    memberBaseAst.start + memberBaseAst.length => memberBaseEnd
                    memberAst.firstToken => memberTokenIndex!
                    true => beforeMemberBaseEnd!
                    beforeMemberBaseEnd! and memberTokenIndex! < memberAst.firstToken + memberAst.tokenCount
                        -> while {
                            context.tokens[context.ranges[node.sourceModule].tokenStart + memberTokenIndex!].span.start < memberBaseEnd
                                -> if {
                                    memberTokenIndex! + 1 => memberTokenIndex!
                                } else { false => beforeMemberBaseEnd! }
                        }
                    memberTokenIndex! => memberPathStart
                    0 => memberCount!
                    memberTokenIndex! < memberAst.firstToken + memberAst.tokenCount
                        -> while {
                            context.tokens[context.ranges[node.sourceModule].tokenStart + memberTokenIndex!].kind == grammar.tokenIdIdentifier()
                                -> if {
                                    memberCount! + 1 => memberCount!
                                }
                            memberTokenIndex! + 1 => memberTokenIndex!
                        }
                    memberBase.typeId => ownerTypeId!
                    0 => memberOrdinal!
                    true => pathValid!
                    memberPathStart => memberTokenIndex!
                    pathValid! and memberTokenIndex! < memberAst.firstToken + memberAst.tokenCount
                        -> while {
                            context.tokens[context.ranges[node.sourceModule].tokenStart + memberTokenIndex!].kind == grammar.tokenIdIdentifier()
                                -> if {
                                    ownerTypeId! >= 0 and ownerTypeId! < (context.types -> len) and (context.types[ownerTypeId!].kind == 8 or context.types[ownerTypeId!].kind == 6)
                                        -> if {
                                            context.types[ownerTypeId!].first => ownerTypeId!
                                        }
                                    -1 => fieldIndex!
                                    ownerTypeId! -> canonicalMemberFieldIndex(node.sourceModule, memberTokenIndex!, context) => fieldIndex!
                                    fieldIndex! < 0 and memberOrdinal! == memberCount! - 1
                                        -> if {
                                            ownerTypeId! -> canonicalMemberFieldOrdinalIndex(node.symbol, context) => fieldIndex!
                                        }
                                    fieldIndex! >= 0 -> if {
                                        context.fields[fieldIndex!].fieldType => ownerTypeId!
                                    } else { false => pathValid! }
                                    memberOrdinal! + 1 => memberOrdinal!
                                }
                            memberTokenIndex! + 1 => memberTokenIndex!
                        }
                    pathValid! and memberCount! > 0 and memberOrdinal! == memberCount!
                        -> if { ownerTypeId! => valueTypeId! }
                }
        }
    valueTypeId!
}

canonicalMemberPathAvailable nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    (nodeIndex -> canonicalMemberValueTypeId(context, state)) >= 0
}

interpolationNodeIntegerWidth nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    nodes[nodeIndex] => node
    node.typeSymbol -> integerWidth(context, state) => width!
    node.typeSymbol == 12 or node.typeSymbol == 13
        -> if { context.pointerBitWidth => width! }
    node -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => bindingIndex
    node.kind == 1 and bindingIndex >= 0 -> if {
        context.ir[bindingIndex] => binding
        0 => bindingWidth!
        binding.typeId >= 0 and binding.typeId < (context.types -> len)
            -> if {
                context.types[binding.typeId].symbol -> integerWidth(context, state) => bindingWidth!
                context.types[binding.typeId].symbol == 12 or context.types[binding.typeId].symbol == 13
                    -> if { context.pointerBitWidth => bindingWidth! }
            }
        bindingWidth! <= 0 -> if { binding -> integerNodeWidth(context, state) => bindingWidth! }
        bindingWidth! > 0 -> if { bindingWidth! => width! }
    }
    node.kind == 2 and node.operand0 >= 0 -> if {
        node.operand0 -> interpolationNodeIntegerWidth(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => width!
    }
    node.kind == 3 and node.operand0 >= 0 and node.operand1 >= 0
        -> if {
            node.operand0 -> interpolationNodeIntegerWidth(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => leftWidth
            node.operand1 -> interpolationNodeIntegerWidth(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => rightWidth
            leftWidth > rightWidth -> if { leftWidth => width! } else { rightWidth => width! }
        }
    node.kind == 5 or node.kind == 7 or node.kind == 8 or node.kind == 10
        -> if {
            nodeIndex -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => indexTypeId
            indexTypeId >= 0 -> if {
                context.types[indexTypeId] => indexType
                indexType.symbol -> integerWidth(context, state) => indexWidth!
                indexType.symbol == 12 or indexType.symbol == 13
                    -> if { context.pointerBitWidth => indexWidth! }
                indexWidth! > 0 -> if { indexWidth! => width! }
            }
        }
    # Dynamic-array and slice lengths are materialized in the current LLVM
    # container ABI as i64 on every target.  UIntSize remains pointer-sized at
    # the language boundary, but interpolation must format the width actually
    # emitted for this node instead of inventing a wasm32 i32 operand.
    node.kind == 6 and (node.opcode == -101 or node.opcode == -236)
        -> if { 64 => width! }
    width!
}

interpolationNodeSigned nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    nodes[nodeIndex] => node
    node.typeSymbol -> integerSigned(context, state) => signed!
    node.kind == 1 -> if {
        node -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => bindingIndex
        bindingIndex >= 0 -> if {
            context.ir[bindingIndex] => binding
            binding.typeId >= 0 and binding.typeId < (context.types -> len)
                -> if {
                    context.types[binding.typeId].symbol -> integerSigned(context, state) => signed!
                } else { binding -> integerNodeSigned(context, state) => signed! }
        }
    }
    (node.kind == 2 or node.kind == 3) and node.operand0 >= 0
        -> if {
            node.operand0 -> interpolationNodeSigned(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => signed!
        }
    node.kind == 5 or node.kind == 7 or node.kind == 8 or node.kind == 10
        -> if {
            nodeIndex -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => typeId
            typeId >= 0 -> if { context.types[typeId].symbol -> integerSigned(context, state) => signed! }
        }
    signed!
}

interpolationHasLogicalAncestor nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~] -> Bool {
    nodes[nodeIndex].parent => ancestor!
    false => found!
    ancestor! >= 0 and not found! -> while {
        nodes[ancestor!] => candidate
        candidate.kind == 3 and (candidate.opcode == -24 or candidate.opcode == -25)
            -> if {
                true => found!
            } else {
                candidate.parent => ancestor!
            }
    }
    found!
}

# Dictionary indexing shares the existing key hash/equality emitters. The
# control bytes belong after capacity * key-size bytes in dictionary storage.
emitInterpolationDictionaryIndex labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, dictionaryTypeId: Int, isReference: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    nodes[nodeIndex] => node
    context.types[dictionaryTypeId] => dictionaryType
    dictionaryType.first => keyTypeId
    dictionaryType.second => valueTypeId
    context.types[keyTypeId] => keyType
    keyType.kind == 1 and keyType.origin == 1 and keyType.symbol == 1 => keyIsText
    keyType.kind == 1 and (keyType.origin == 0 or keyType.origin == 2) => keyIsNominal
    keyTypeId -> traitMethodSymbol("Hash", "hash", context, state) => hashMethod
    keyTypeId -> traitMethodSymbol("Eq", "eq", context, state) => eqMethod
    keyType.symbol -> integerWidth(context, state) => hashWidth!
    keyType.symbol == 12 or keyType.symbol == 13 -> if { context.pointerBitWidth => hashWidth! }
    keyType.symbol -> integerSigned(context, state) => hashSigned
    Arena(0) => labelStorage!
    "v$(labelIndex)_expression$(nodeIndex)" -> materialize(labelStorage!) => prefix
    "  %$(prefix)_dictionary = " -> print
    isReference -> if { "load %sollang.dict, ptr " -> print } else { "freeze %sollang.dict " -> print }
    labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
    isReference -> if { ", align 8" -> print }
    "" -> println
    "  %$(prefix)_query = freeze " -> print
    keyTypeId -> writeSemanticTypeId(context, state)
    " " -> print
    labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
    "" -> println
    "  %$(prefix)_keys = extractvalue %sollang.dict %$(prefix)_dictionary, 0" -> println
    "  %$(prefix)_values = extractvalue %sollang.dict %$(prefix)_dictionary, 1" -> println
    "  %$(prefix)_capacity = extractvalue %sollang.dict %$(prefix)_dictionary, 3" -> println
    "  %$(prefix)_nonempty = icmp ugt i64 %$(prefix)_capacity, 0" -> println
    "  br i1 %$(prefix)_nonempty, label %$(prefix)_lookup_start, label %$(prefix)_missing" -> println
    "$(prefix)_lookup_start:" -> println
    prefix -> emitSetHashValue("%$(prefix)_query", keyTypeId, hashMethod, keyIsText, keyIsNominal, hashWidth!, hashSigned, context, state)
    "  %$(prefix)_h2_shift = lshr i64 %$(prefix)_hash, 57" -> println
    "  %$(prefix)_h2_raw = and i64 %$(prefix)_h2_shift, 127" -> println
    "  %$(prefix)_h2_zero = icmp eq i64 %$(prefix)_h2_raw, 0" -> println
    "  %$(prefix)_h2_value = select i1 %$(prefix)_h2_zero, i64 1, i64 %$(prefix)_h2_raw" -> println
    "  %$(prefix)_h2 = trunc i64 %$(prefix)_h2_value to i8" -> println
    "  %$(prefix)_control_offset = mul i64 %$(prefix)_capacity, $(context.typeSizes[keyTypeId])" -> println
    "  %$(prefix)_controls = getelementptr i8, ptr %$(prefix)_keys, i64 %$(prefix)_control_offset" -> println
    "  %$(prefix)_start = urem i64 %$(prefix)_hash, %$(prefix)_capacity" -> println
    "  br label %$(prefix)_loop" -> println
    "$(prefix)_loop:" -> println
    "  %$(prefix)_slot = phi i64 [ %$(prefix)_start, %$(prefix)_lookup_start ], [ %$(prefix)_next, %$(prefix)_advance ]" -> println
    "  %$(prefix)_probe = phi i64 [ 0, %$(prefix)_lookup_start ], [ %$(prefix)_next_probe, %$(prefix)_advance ]" -> println
    "  %$(prefix)_in_range = icmp ult i64 %$(prefix)_probe, %$(prefix)_capacity" -> println
    "  br i1 %$(prefix)_in_range, label %$(prefix)_check, label %$(prefix)_missing" -> println
    "$(prefix)_check:" -> println
    "  %$(prefix)_control_ptr = getelementptr i8, ptr %$(prefix)_controls, i64 %$(prefix)_slot" -> println
    "  %$(prefix)_control = load i8, ptr %$(prefix)_control_ptr, align 1" -> println
    "  %$(prefix)_matches_h2 = icmp eq i8 %$(prefix)_control, %$(prefix)_h2" -> println
    "  br i1 %$(prefix)_matches_h2, label %$(prefix)_compare, label %$(prefix)_advance" -> println
    "$(prefix)_compare:" -> println
    "  %$(prefix)_key_ptr = getelementptr " -> print
    keyTypeId -> writeSemanticTypeId(context, state)
    ", ptr %$(prefix)_keys, i64 %$(prefix)_slot" -> println
    "  %$(prefix)_stored = load " -> print
    keyTypeId -> writeSemanticTypeId(context, state)
    ", ptr %$(prefix)_key_ptr, align $(context.typeAligns[keyTypeId])" -> println
    prefix -> emitSetEquality("%$(prefix)_stored", "%$(prefix)_query", keyTypeId, eqMethod, keyIsText, keyIsNominal, context, state)
    "  br i1 %$(prefix)_equal, label %$(prefix)_hit, label %$(prefix)_advance" -> println
    "$(prefix)_advance:" -> println
    "  %$(prefix)_unwrapped_next = add i64 %$(prefix)_slot, 1" -> println
    "  %$(prefix)_next = urem i64 %$(prefix)_unwrapped_next, %$(prefix)_capacity" -> println
    "  %$(prefix)_next_probe = add i64 %$(prefix)_probe, 1" -> println
    "  br label %$(prefix)_loop" -> println
    "$(prefix)_missing:" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "$(prefix)_hit:" -> println
    "  %$(prefix)_value_ptr = getelementptr " -> print
    valueTypeId -> writeSemanticTypeId(context, state)
    ", ptr %$(prefix)_values, i64 %$(prefix)_slot" -> println
    "  %$(prefix) = load " -> print
    valueTypeId -> writeSemanticTypeId(context, state)
    ", ptr %$(prefix)_value_ptr, align $(context.typeAligns[valueTypeId])" -> println
}

emitInterpolationSubtree labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, lexicalLoads: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    nodes[nodeIndex] => node
    node.kind == 3 and (node.opcode == -24 or node.opcode == -25)
        -> if {
            labelIndex -> emitInterpolationSubtree(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, context, state)
            "  %v$(labelIndex)_expression$(nodeIndex)_logical_slot = alloca i1, align 1" -> println
            "  store i1 " -> print
            node.opcode == -25 -> if { "0" -> print } else { "1" -> print }
            ", ptr %v$(labelIndex)_expression$(nodeIndex)_logical_slot, align 1" -> println
            "  br i1 " -> print
            labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
            ", label %interpolation$(labelIndex)_logical$(nodeIndex)_" -> print
            node.opcode == -25 -> if { "rhs" -> print } else { "end" -> print }
            ", label %interpolation$(labelIndex)_logical$(nodeIndex)_" -> print
            node.opcode == -25 -> if { "end" -> print } else { "rhs" -> print }
            "" -> println
            "interpolation$(labelIndex)_logical$(nodeIndex)_rhs:" -> println
            labelIndex -> emitInterpolationSubtree(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, context, state)
            "  store i1 " -> print
            labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
            ", ptr %v$(labelIndex)_expression$(nodeIndex)_logical_slot, align 1" -> println
            "  br label %interpolation$(labelIndex)_logical$(nodeIndex)_end" -> println
            "interpolation$(labelIndex)_logical$(nodeIndex)_end:" -> println
            "  %v$(labelIndex)_expression$(nodeIndex) = load i1, ptr %v$(labelIndex)_expression$(nodeIndex)_logical_slot, align 1" -> println
        } else {
            node.operand0 >= 0 -> if { labelIndex -> emitInterpolationSubtree(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, context, state) }
            node.operand1 >= 0 -> if { labelIndex -> emitInterpolationSubtree(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, context, state) }
            node.operand2 >= 0 -> if { labelIndex -> emitInterpolationSubtree(node.operand2, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, context, state) }
            labelIndex -> emitInterpolationIntrinsic(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, lexicalLoads, context, state)
            labelIndex -> emitInterpolationOperation(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
        }
}

interpolationIntegerSigned nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    nodes[nodeIndex] => node
    node.typeSymbol => symbol!
    node.operand0 >= 0 -> if {
        node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => operandTypeId
        operandTypeId >= 0 and operandTypeId < (context.types -> len)
            -> if {
                context.types[operandTypeId] => operandType
                operandType.kind == 1 and operandType.origin == 1
                    -> if { operandType.symbol => symbol! }
            }
    }
    symbol! -> integerSigned(context, state)
}

interpolationQuotientOperation nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Text {
    nodeIndex -> interpolationIntegerSigned(nodes, sourceModule, ownerIndex, beforeIndex, context, state)
        -> if { "sdiv" } else { "udiv" }
}

interpolationRemainderOperation nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Text {
    nodeIndex -> interpolationIntegerSigned(nodes, sourceModule, ownerIndex, beforeIndex, context, state)
        -> if { "srem" } else { "urem" }
}

interpolationComparisonOperation nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Text {
    nodes[nodeIndex] => node
    nodeIndex -> interpolationIntegerSigned(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => signed
    node.opcode == grammar.tokenIdLess() -> if {
        signed -> if { "icmp slt" } else { "icmp ult" }
    } else {
        node.opcode == grammar.tokenIdLessEqual() -> if {
            signed -> if { "icmp sle" } else { "icmp ule" }
        } else {
            node.opcode == grammar.tokenIdGreater() -> if {
                signed -> if { "icmp sgt" } else { "icmp ugt" }
            } else {
                signed -> if { "icmp sge" } else { "icmp uge" }
            }
        }
    }
}

emitInterpolationOperation labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    nodes[nodeIndex] => node
    node.kind == 2 or node.kind == 3 -> if {
        "" => operation!
        node.kind == 2 -> if { "sub" => operation! }
        node.kind == 2 and node.opcode == -26 -> if { "xor" => operation! }
        node.opcode == grammar.tokenIdPlus() -> if { "add" => operation! }
        node.opcode == grammar.tokenIdMinus() -> if { "sub" => operation! }
        node.opcode == grammar.tokenIdStar() -> if { "mul" => operation! }
        node.opcode == grammar.tokenIdSlash() -> if { nodeIndex -> interpolationQuotientOperation(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => operation! }
        node.opcode == grammar.tokenIdPercent() -> if { nodeIndex -> interpolationRemainderOperation(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => operation! }
        node.opcode == grammar.tokenIdEqualEqual() -> if { "icmp eq" => operation! }
        node.opcode == grammar.tokenIdBangEqual() -> if { "icmp ne" => operation! }
        node.opcode == grammar.tokenIdLess() or node.opcode == grammar.tokenIdLessEqual() or node.opcode == grammar.tokenIdGreater() or node.opcode == grammar.tokenIdGreaterEqual()
            -> if { nodeIndex -> interpolationComparisonOperation(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => operation! }
        node.opcode == -24 -> if { "or" => operation! }
        node.opcode == -25 -> if { "and" => operation! }
        (node.opcode == -24 or node.opcode == -25 or (node.kind == 2 and node.opcode == -26)) => boolOperands!
        node.opcode == grammar.tokenIdEqualEqual() or node.opcode == grammar.tokenIdBangEqual()
            -> if {
                node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => operandTypeId
                operandTypeId >= 0 and context.types[operandTypeId].symbol == 23
                    -> if { true => boolOperands! }
            }
        node.operand0 -> interpolationNodeIntegerWidth(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => leftWidth
        leftWidth => rightWidth!
        node.kind == 3 -> if {
            node.operand1 -> interpolationNodeIntegerWidth(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => rightWidth!
        }
        leftWidth > rightWidth! -> if { leftWidth } else { rightWidth! } => operationWidth!
        operationWidth! <= 0 -> if { 32 => operationWidth! }
        not boolOperands!
            and leftWidth > 0
            and leftWidth < operationWidth!
            and nodes[node.operand0].kind != 0
            -> if {
                "  %v$(labelIndex)_expression$(nodeIndex)_left_wide = " -> print
                node.operand0 -> interpolationNodeSigned(nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    -> if { "sext" -> print } else { "zext" -> print }
                " i$(leftWidth) " -> print
                labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                " to i$(operationWidth!)" -> println
            }
        not boolOperands!
            and node.kind == 3
            and rightWidth! > 0
            and rightWidth! < operationWidth!
            and nodes[node.operand1].kind != 0
            -> if {
                "  %v$(labelIndex)_expression$(nodeIndex)_right_wide = " -> print
                node.operand1 -> interpolationNodeSigned(nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    -> if { "sext" -> print } else { "zext" -> print }
                " i$(rightWidth!) " -> print
                labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                " to i$(operationWidth!)" -> println
            }
        "  %v$(labelIndex)_expression$(nodeIndex) = $(operation!) " -> print
        boolOperands! -> if { "i1 " -> print } else { "i$(operationWidth!) " -> print }
        node.kind == 2 and node.opcode != -26 -> if {
            "0, " -> print
            labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
            "" -> println
        } else {
            not boolOperands!
                and leftWidth > 0
                and leftWidth < operationWidth!
                and nodes[node.operand0].kind != 0
                -> if { "%v$(labelIndex)_expression$(nodeIndex)_left_wide" -> print } else {
                    labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                }
            ", " -> print
            node.kind == 2 -> if {
                "true" -> println
            } else {
                not boolOperands!
                    and rightWidth! > 0
                    and rightWidth! < operationWidth!
                    and nodes[node.operand1].kind != 0
                    -> if { "%v$(labelIndex)_expression$(nodeIndex)_right_wide" -> print } else {
                        labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    }
                "" -> println
            }
        }
    }
}

emitInterpolationIntrinsic labelIndex: Int, nodeIndex: Int, nodes: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, beforeIndex: Int, lexicalLoads: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    nodes[nodeIndex] => node
    lexicalLoads and node.kind == 1 -> if {
        labelIndex -> emitInterpolationLexicalLoad(nodeIndex, node, sourceModule, ownerIndex, beforeIndex, context, state)
    }
    node.kind == 5 and node.operand0 >= 0 -> if {
        node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => memberOwnerTypeId!
        nodes[node.operand0] => memberBase
        memberBase.payloadStart + memberBase.payloadLength => memberCursor!
        node.payloadStart + node.payloadLength => memberEnd
        0 => memberStep!
        true => memberPathValid!
        memberPathValid! and memberCursor! < memberEnd
            -> while {
                memberCursor! < memberEnd and (context.sources[sourceModule] -> byte(memberCursor!)) != 46
                    -> while {
                        memberCursor! + 1 => memberCursor!
                    }
                memberCursor! + 1 => memberNameStart
                memberNameStart => memberNameEnd!
                memberNameEnd! < memberEnd and (context.sources[sourceModule] -> byte(memberNameEnd!)) != 46
                    -> while {
                        memberNameEnd! + 1 => memberNameEnd!
                    }
                memberNameEnd! - memberNameStart => memberNameLength
                false => memberOwnerReference!
                memberOwnerTypeId! >= 0 and context.types[memberOwnerTypeId!].kind == 8
                    -> if {
                        context.types[memberOwnerTypeId!].first => memberOwnerTypeId!
                        true => memberOwnerReference!
                    }
                -1 => memberFieldIndex!
                0 => memberFieldSearch!
                memberFieldSearch! < (context.fields -> len)
                    -> while {
                        context.fields[memberFieldSearch!] => memberFieldCandidate
                        memberFieldCandidate.status == 0
                            and memberFieldCandidate.ownerType == memberOwnerTypeId!
                            and memberFieldCandidate.sourceModule >= 0
                            and (memberFieldCandidate.fieldSymbol >= 0 or memberFieldCandidate.labelToken >= 0)
                            -> if {
                                context.ranges[memberFieldCandidate.sourceModule] => memberFieldRange
                                memberFieldCandidate.labelToken => memberFieldNameToken!
                                memberFieldCandidate.fieldSymbol >= 0 -> if {
                                    context.symbols[memberFieldRange.symbolStart + memberFieldCandidate.fieldSymbol] => memberFieldSymbol
                                    memberFieldSymbol.nameToken => memberFieldNameToken!
                                }
                                context.tokens[memberFieldRange.tokenStart + memberFieldNameToken!] => memberFieldName
                                memberFieldName.span.length == memberNameLength => memberFieldNameEqual!
                                UIntSize(0) => memberFieldNameByte!
                                memberFieldNameEqual! and memberFieldNameByte! < memberNameLength
                                    -> while {
                                        (context.sources[sourceModule] -> byte(memberNameStart + memberFieldNameByte!)) != (context.sources[memberFieldCandidate.sourceModule] -> byte(memberFieldName.span.start + memberFieldNameByte!))
                                            -> if {
                                                false => memberFieldNameEqual!
                                            }
                                        memberFieldNameByte! + 1 => memberFieldNameByte!
                                    }
                                memberFieldNameEqual! -> if { memberFieldSearch! => memberFieldIndex! }
                            }
                        memberFieldSearch! + 1 => memberFieldSearch!
                    }
                memberFieldIndex! >= 0 -> if {
                    context.fields[memberFieldIndex!] => memberField
                    memberOwnerReference! -> if {
                        "  " -> print
                        memberNameEnd! == memberEnd -> if { "%v$(labelIndex)_expression$(nodeIndex)" -> print } else { "%v$(labelIndex)_expression$(nodeIndex)_m$(memberStep!)" -> print }
                        "_address = getelementptr inbounds " -> print
                        memberOwnerTypeId! -> writeSemanticTypeId(context, state)
                        ", ptr " -> print
                        memberStep! == 0 -> if {
                            labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                        } else { "%v$(labelIndex)_expression$(nodeIndex)_m$(memberStep! - 1)" -> print }
                        ", i32 0, i32 $(memberField.ordinal)" -> println
                        "  " -> print
                        memberNameEnd! == memberEnd -> if { "%v$(labelIndex)_expression$(nodeIndex)" -> print } else { "%v$(labelIndex)_expression$(nodeIndex)_m$(memberStep!)" -> print }
                        " = load " -> print
                        memberField.fieldType -> writeSemanticTypeId(context, state)
                        ", ptr " -> print
                        memberNameEnd! == memberEnd -> if { "%v$(labelIndex)_expression$(nodeIndex)" -> print } else { "%v$(labelIndex)_expression$(nodeIndex)_m$(memberStep!)" -> print }
                        "_address, align $(context.typeAligns[memberField.fieldType])" -> println
                    } else {
                        "  " -> print
                        memberNameEnd! == memberEnd -> if { "%v$(labelIndex)_expression$(nodeIndex)" -> print } else { "%v$(labelIndex)_expression$(nodeIndex)_m$(memberStep!)" -> print }
                        " = extractvalue " -> print
                        memberOwnerTypeId! -> writeSemanticTypeId(context, state)
                        " " -> print
                        memberStep! == 0 -> if {
                            labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                        } else { "%v$(labelIndex)_expression$(nodeIndex)_m$(memberStep! - 1)" -> print }
                        ", $(memberField.ordinal)" -> println
                    }
                    memberField.fieldType => memberOwnerTypeId!
                    memberNameEnd! => memberCursor!
                    memberStep! + 1 => memberStep!
                } else { false => memberPathValid! }
            }
    }
    node.kind == 8 or node.kind == 10 -> if {
        nodeIndex -> interpolationCallTargetFunction(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => callTargetFunction
        callTargetFunction >= 0 -> if {
            context.ir[callTargetFunction] => callTarget
            callTarget.operand1 => projectionParameterIndex!
            node.operand0 => projectionArgumentIndex!
            0 => projectionArgumentOrdinal!
            projectionParameterIndex! >= 0 and projectionArgumentIndex! >= 0 and projectionArgumentOrdinal! < 3
                -> while {
                    projectionArgumentIndex! -> interpolationCallArgumentNeedsReferenceSlot(
                    projectionParameterIndex!,
                    nodes,
                    sourceModule,
                    ownerIndex,
                    beforeIndex,
                    context,
                    state) -> if {
                        context.types[context.ir[projectionParameterIndex!].typeId].first => referenceOwnerType
                        "  store " -> print
                        referenceOwnerType -> writeSemanticTypeId(context, state)
                        " " -> print
                        labelIndex -> writeInterpolationValue(projectionArgumentIndex!, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                        ", ptr %v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_ref, align $(context.typeAligns[referenceOwnerType])" -> println
                    }
                    projectionArgumentIndex! -> interpolationCallArgumentNeedsSliceProjection(
                    projectionParameterIndex!,
                    nodes,
                    sourceModule,
                    ownerIndex,
                    beforeIndex,
                    context,
                    state) -> if {
                        projectionArgumentIndex! -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => projectionTypeId!
                        projectionTypeId! >= 0 and context.types[projectionTypeId!].kind == 8
                            -> if { context.types[projectionTypeId!].first => projectionTypeId! }
                        "  %v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_slice_data = extractvalue " -> print
                        projectionTypeId! -> writeSemanticTypeId(context, state)
                        " " -> print
                        labelIndex -> writeInterpolationValue(projectionArgumentIndex!, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                        ", 0" -> println
                        "  %v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_slice_length = extractvalue " -> print
                        projectionTypeId! -> writeSemanticTypeId(context, state)
                        " " -> print
                        labelIndex -> writeInterpolationValue(projectionArgumentIndex!, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                        ", 1" -> println
                        "  %v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_slice0 = insertvalue { ptr, i64 } poison, ptr %v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_slice_data, 0" -> println
                        "  %v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_slice = insertvalue { ptr, i64 } %v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_slice0, i64 %v$(labelIndex)_expression$(nodeIndex)_arg$(projectionArgumentOrdinal!)_slice_length, 1" -> println
                    }
                    projectionArgumentOrdinal! == 0 -> if { callTarget.nextOperand => projectionParameterIndex! } else { context.ir[projectionParameterIndex!].nextOperand => projectionParameterIndex! }
                    projectionArgumentOrdinal! + 1 => projectionArgumentOrdinal!
                    projectionArgumentOrdinal! == 1 -> if { node.operand1 => projectionArgumentIndex! }
                    projectionArgumentOrdinal! == 2 -> if { node.operand2 => projectionArgumentIndex! }
                    projectionArgumentOrdinal! >= 3 -> if { -1 => projectionArgumentIndex! }
                }
            "  %v$(labelIndex)_expression$(nodeIndex) = call " -> print
            callTarget -> writeIrType(context, state)
            " @sollang_m$(callTarget.sourceModule)_s$(callTarget.symbol)(" -> print
            callTarget.operand1 => callParameterIndex!
            0 => callArgumentOrdinal!
            node.operand0 => callArgumentIndex!
            callParameterIndex! >= 0 and callArgumentIndex! >= 0 and callArgumentOrdinal! < 3
                -> while {
                    callArgumentOrdinal! > 0 -> if { ", " -> print }
                    context.ir[callParameterIndex!] => callParameter
                    callParameter -> writeIrType(context, state)
                    " " -> print
                    nodes[callArgumentIndex!] => callArgument
                    callArgumentIndex! -> interpolationCallArgumentNeedsReferenceSlot(
                    callParameterIndex!,
                    nodes,
                    sourceModule,
                    ownerIndex,
                    beforeIndex,
                    context,
                    state) -> if {
                        "%v$(labelIndex)_expression$(nodeIndex)_arg$(callArgumentOrdinal!)_ref" -> print
                    } else { callArgumentIndex! -> interpolationCallArgumentNeedsSliceProjection(
                        callParameterIndex!,
                        nodes,
                        sourceModule,
                        ownerIndex,
                        beforeIndex,
                        context,
                        state) -> if {
                            "%v$(labelIndex)_expression$(nodeIndex)_arg$(callArgumentOrdinal!)_slice" -> print
                        } else { callArgument.kind == 0 or callArgument.kind == 4
                                -> if {
                                    callArgument.kind == 4 -> if {
                                        (context.sources[sourceModule] -> byte(callArgument.payloadStart)) == 116
                                            -> if { "1" -> print } else { "0" -> print }
                                    } else { callArgument -> writeInterpolationIntegerLiteral(sourceModule, context) }
                                } else {
                                    labelIndex -> writeInterpolationValue(callArgumentIndex!, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                                }
                        }
                    }
                    callArgumentOrdinal! == 0 -> if { callTarget.nextOperand => callParameterIndex! } else { callParameter.nextOperand => callParameterIndex! }
                    callArgumentOrdinal! + 1 => callArgumentOrdinal!
                    callArgumentOrdinal! == 1 -> if { node.operand1 => callArgumentIndex! }
                    callArgumentOrdinal! == 2 -> if { node.operand2 => callArgumentIndex! }
                    callArgumentOrdinal! >= 3 -> if { -1 => callArgumentIndex! }
                }
            ")" -> println
        }
    }
    node.kind == 9 and node.operand0 >= 0 -> if {
        node.operand0 -> interpolationNodeIntegerWidth(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => conversionSourceWidth
        node.typeSymbol -> integerWidth(context, state) => conversionTargetWidth!
        node.typeSymbol == 12 or node.typeSymbol == 13
            -> if { context.pointerBitWidth => conversionTargetWidth! }
        conversionSourceWidth > 0 and conversionTargetWidth! > 0
            -> if {
                "  %v$(labelIndex)_expression$(nodeIndex) = " -> print
                node.typeSymbol == 23 -> if {
                    "icmp ne i$(conversionSourceWidth) " -> print
                    labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    ", 0" -> println
                } else {
                    conversionSourceWidth == conversionTargetWidth!
                        -> if { "freeze i$(conversionTargetWidth!) " -> print }
                    conversionSourceWidth > conversionTargetWidth!
                        -> if { "trunc i$(conversionSourceWidth) " -> print }
                    conversionSourceWidth < conversionTargetWidth!
                        -> if {
                            node.operand0 -> interpolationNodeSigned(nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                                -> if { "sext" -> print } else { "zext" -> print }
                            " i$(conversionSourceWidth) " -> print
                        }
                    labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    conversionSourceWidth != conversionTargetWidth!
                        -> if { " to i$(conversionTargetWidth!)" -> print }
                    "" -> println
                }
            }
    }
    node.kind == 6 and node.operand0 >= 0 -> if {
        nodes[node.operand0] => base
        node.opcode == -101 -> if {
            base -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => baseBinding
            baseBinding >= 0 -> if {
                "  %v$(labelIndex)_expression$(nodeIndex) = extractvalue " -> print
                context.ir[baseBinding] -> writeIrType(context, state)
                " " -> print
                labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                context.ir[baseBinding] -> isDictionaryType
                    -> if { ", 2" -> println } else { ", 1" -> println }
            } else {
                node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => projectedBaseTypeId!
                projectedBaseTypeId! >= 0 and context.types[projectedBaseTypeId!].kind == 8
                    -> if { context.types[projectedBaseTypeId!].first => projectedBaseTypeId! }
                projectedBaseTypeId! >= 0 -> if {
                    context.types[projectedBaseTypeId!] => projectedBaseType
                    projectedBaseType.kind == 4 -> if {
                        "  %v$(labelIndex)_expression$(nodeIndex) = add i64 0, $(projectedBaseType.length)" -> println
                    }
                    projectedBaseType.kind == 2
                        or projectedBaseType.kind == 3
                        or projectedBaseType.kind == 5
                        or projectedBaseType.kind == 13
                        or projectedBaseType.kind == 12
                        or (projectedBaseType.kind == 1
                        and projectedBaseType.origin == 1
                        and (projectedBaseType.symbol == 1
                        or projectedBaseType.symbol == 15))
                        or (projectedBaseType.kind == 7
                        and projectedBaseType.origin == 4
                        and (projectedBaseType.symbol == 6
                        or projectedBaseType.symbol == 7)) -> if {
                            "  %v$(labelIndex)_expression$(nodeIndex) = extractvalue " -> print
                            projectedBaseType.kind == 2 -> if {
                                "{ ptr, i64 }" -> print
                            } else {
                                projectedBaseTypeId! -> writeSemanticTypeId(context, state)
                            }
                            " " -> print
                            labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                            projectedBaseType.kind == 5 or projectedBaseType.kind == 13
                                -> if { ", 2" -> println } else { ", 1" -> println }
                        }
                }
            }
        }
        node.opcode == -236 -> if {
            node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => capacityType!
            false => capacityReference!
            capacityType! >= 0 and context.types[capacityType!].kind == 8
                -> if {
                    context.types[capacityType!].first => capacityType!
                    true => capacityReference!
                }
            capacityType! -> interpolationCapacityField(context) => capacityField
            capacityField >= 0 -> if {
                capacityReference! -> if {
                    "  %v$(labelIndex)_expression$(nodeIndex)_capacity_source = load " -> print
                    capacityType! -> writeSemanticTypeId(context, state)
                    ", ptr " -> print
                    labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    ", align 8" -> println
                }
                "  %v$(labelIndex)_expression$(nodeIndex) = extractvalue " -> print
                capacityType! -> writeSemanticTypeId(context, state)
                " " -> print
                capacityReference! -> if {
                    "%v$(labelIndex)_expression$(nodeIndex)_capacity_source" -> print
                } else {
                    labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                }
                ", $capacityField" -> println
            }
        }
        node.opcode == -202 and node.operand1 >= 0 -> if {
            base -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => byteBaseBinding
            byteBaseBinding >= 0 -> if {
                "  %v$(labelIndex)_expression$(nodeIndex)_base = extractvalue " -> print
                context.ir[byteBaseBinding] -> writeIrType(context, state)
                " " -> print
                labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                ", 0" -> println
                "  %v$(labelIndex)_expression$(nodeIndex)_address = getelementptr i8, ptr %v$(labelIndex)_expression$(nodeIndex)_base, i64 " -> print
                labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                "" -> println
                "  %v$(labelIndex)_expression$(nodeIndex) = load i8, ptr %v$(labelIndex)_expression$(nodeIndex)_address, align 1" -> println
            }
        }
        node.opcode == -203 and node.operand1 >= 0 and node.operand2 >= 0
            -> if {
                base -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => sliceBaseBinding
                sliceBaseBinding >= 0 -> if {
                    "  %v$(labelIndex)_expression$(nodeIndex)_base = extractvalue " -> print
                    context.ir[sliceBaseBinding] -> writeIrType(context, state)
                    " " -> print
                    labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    ", 0" -> println
                    "  %v$(labelIndex)_expression$(nodeIndex)_start = getelementptr i8, ptr %v$(labelIndex)_expression$(nodeIndex)_base, i64 " -> print
                    labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    "" -> println
                    "  %v$(labelIndex)_expression$(nodeIndex)_ptr = insertvalue %sollang.text poison, ptr %v$(labelIndex)_expression$(nodeIndex)_start, 0" -> println
                    "  %v$(labelIndex)_expression$(nodeIndex) = insertvalue %sollang.text %v$(labelIndex)_expression$(nodeIndex)_ptr, i64 " -> print
                    labelIndex -> writeInterpolationValue(node.operand2, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                    ", 1" -> println
                }
            }
    }
    node.kind == 7 and node.operand0 >= 0 and node.operand1 >= 0
        -> if {
            node.operand0 -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => indexedContainerTypeId!
            false => indexedReference!
            indexedContainerTypeId! >= 0 and context.types[indexedContainerTypeId!].kind == 8
                -> if {
                    context.types[indexedContainerTypeId!].first => indexedContainerTypeId!
                    true => indexedReference!
                }
            nodeIndex -> interpolationNodeTypeId(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => indexedElementTypeId
            indexedContainerTypeId! >= 0
                and (context.types[indexedContainerTypeId!].kind == 5 or context.types[indexedContainerTypeId!].kind == 13)
                -> if {
                    labelIndex -> emitInterpolationDictionaryIndex(nodeIndex, nodes, sourceModule, ownerIndex, beforeIndex, indexedContainerTypeId!, indexedReference!, context, state)
                }
            indexedContainerTypeId! >= 0 and indexedElementTypeId >= 0
                and (context.types[indexedContainerTypeId!].kind == 3
                or context.types[indexedContainerTypeId!].kind == 4
                or (context.types[indexedContainerTypeId!].kind == 1 and context.types[indexedContainerTypeId!].origin == 1 and context.types[indexedContainerTypeId!].symbol == 1))
                -> if {
                    context.types[indexedContainerTypeId!] => indexedContainerType
                    indexedReference! and indexedContainerType.kind != 4
                        -> if {
                            "  %v$(labelIndex)_expression$(nodeIndex)_source = load " -> print
                            indexedContainerTypeId! -> writeSemanticTypeId(context, state)
                            ", ptr " -> print
                            labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                            ", align 8" -> println
                        }
                    # Ordinary local fixed-array values use the public view
                    # carrier. Inline field/call results and value parameters
                    # keep their aggregate representation in interpolation.
                    nodes[node.operand0] -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => indexedBinding
                    indexedBinding >= 0 and context.ir[indexedBinding].kind != 10 => indexedLocalCarrier
                    indexedContainerType.kind == 4
                        and not indexedReference!
                        and not indexedLocalCarrier
                        and nodes[node.operand1].kind == 0
                        -> if {
                            # A value-member projection is an inline LLVM array even
                            # though the ordinary expression path promotes that value to
                            # the public pointer/length fixed-array carrier. Constant
                            # interpolation indexes can read the inline aggregate
                            # directly, without a scratch allocation or wrapper.
                            "  %v$(labelIndex)_expression$(nodeIndex) = extractvalue " -> print
                            indexedContainerTypeId! -> writeSemanticTypeId(context, state)
                            " " -> print
                            labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                            ", " -> print
                            labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                            "" -> println
                        } else {
                            indexedContainerType.kind == 4 and indexedReference!
                                -> if {
                                    "  %v$(labelIndex)_expression$(nodeIndex)_data = getelementptr " -> print
                                    indexedContainerTypeId! -> writeSemanticTypeId(context, state)
                                    ", ptr " -> print
                                    labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                                    ", i64 0, i64 0" -> println
                                } else {
                                    "  %v$(labelIndex)_expression$(nodeIndex)_data = extractvalue " -> print
                                    indexedReference! -> if {
                                        indexedContainerTypeId! -> writeSemanticTypeId(context, state)
                                    } else {
                                        indexedContainerType.kind == 4 -> if {
                                            "{ ptr, i64 }" -> print
                                        } else {
                                            indexedContainerTypeId! -> writeSemanticTypeId(context, state)
                                        }
                                    }
                                    " " -> print
                                    indexedReference! -> if { "%v$(labelIndex)_expression$(nodeIndex)_source" -> print } else {
                                        labelIndex -> writeInterpolationValue(node.operand0, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                                    }
                                    ", 0" -> println
                                }
                            node.operand1 -> interpolationNodeIntegerWidth(nodes, sourceModule, ownerIndex, beforeIndex, context, state) => indexedSubscriptWidth!
                            indexedSubscriptWidth! <= 0 -> if { 32 => indexedSubscriptWidth! }
                            "  %v$(labelIndex)_expression$(nodeIndex)_ptr = getelementptr " -> print
                            indexedElementTypeId -> writeSemanticTypeId(context, state)
                            ", ptr %v$(labelIndex)_expression$(nodeIndex)_data, i$(indexedSubscriptWidth!) " -> print
                            labelIndex -> writeInterpolationValue(node.operand1, nodes, sourceModule, ownerIndex, beforeIndex, context, state)
                            "" -> println
                            "  %v$(labelIndex)_expression$(nodeIndex) = load " -> print
                            indexedElementTypeId -> writeSemanticTypeId(context, state)
                            ", ptr %v$(labelIndex)_expression$(nodeIndex)_ptr, align " -> print
                            context.typeAligns[indexedElementTypeId] -> writeDecimalLine
                        }
                }
        }
}

# Computes target-aware storage facts from canonical recursive identity. Nominal
# layouts are a fixed point over owner-to-field edges, so declaration order does
# not affect nested structs and box indirection terminates recursive layouts.
public layoutsFor request: TypeLayoutRequest -> TypeLayouts {
    request.pointerBitWidth / 8 => pointerSize
    [Int; ~] => sizes!
    [Int; ~] => aligns!
    [Int; ~] => statuses!
    0 => seedIndex!
    seedIndex! < (request.types -> len) -> while {
        request.types[seedIndex!] => current
        -1 => size!
        1 => align!
        1 => status!
        current.status != 0 -> if {
            current.kind == 1 and (current.origin == 0 or current.origin == 2)
                -> if { 1 => status! } else { 2 => status! }
        } else {
            current.kind == 1 -> if {
                current.origin == 1 -> if {
                    current.symbol == 0 -> if {
                        0 => size!
                        0 => status!
                    }
                    current.symbol == 1 -> if {
                        # %sollang.text is { ptr, i64 }. The i64 member keeps
                        # 8-byte ABI alignment on wasm32, so its size is 16 on
                        # both 32-bit WebAssembly and 64-bit native targets.
                        16 => size!
                        8 => align!
                        0 => status!
                    }
                    current.symbol == 2 or current.symbol == 5 or current.symbol == 10 or current.symbol == 14 or current.symbol == 19 or current.symbol == 20
                        -> if {
                            4 => size!
                            4 => align!
                            0 => status!
                        }
                    current.symbol == 3 or current.symbol == 8 or current.symbol == 23
                        -> if {
                            1 => size!
                            1 => align!
                            0 => status!
                        }
                    current.symbol == 4 or current.symbol == 9 -> if {
                        2 => size!
                        2 => align!
                        0 => status!
                    }
                    current.symbol == 6 or current.symbol == 7 or current.symbol == 11 or current.symbol == 16 or current.symbol == 21 or current.symbol == 22
                        -> if {
                            8 => size!
                            8 => align!
                            0 => status!
                        }
                    current.symbol == 12 or current.symbol == 13
                        -> if {
                            pointerSize => size!
                            pointerSize => align!
                            0 => status!
                        }
                    current.symbol == 24 -> if {
                        # %sollang.source_text is { ptr, i64, ptr, i64 }.
                        32 => size!
                        8 => align!
                        0 => status!
                    }
                }
            }
            current.kind == 2 -> if {
                # Slices are { ptr, i64 }, not two pointer-width words.
                16 => size!
                8 => align!
                0 => status!
            }
            current.kind == 3 -> if {
                # Dynamic arrays are { ptr, i64, i64 }.
                24 => size!
                8 => align!
                0 => status!
            }
            current.kind == 12 -> if {
                # Bounded arrays keep inline backing storage at the owner, but
                # expression values use the common { data, length, capacity }
                # handle so calls and collection operations stay uniform.
                24 => size!
                8 => align!
                0 => status!
            }
            current.kind == 5 -> if {
                pointerSize * 2 + 16 => size!
                8 => align!
                0 => status!
            }
            current.kind == 13 -> if {
                # Bounded dictionaries likewise use the dictionary handle;
                # both pointers address one owner-inline allocation.
                pointerSize * 2 + 16 => size!
                8 => align!
                0 => status!
            }
            current.kind == 14 -> if {
                ((current.length + 63) / 64) * 8 => size!
                8 => align!
                0 => status!
            }
            current.kind == 6 -> if {
                pointerSize => size!
                pointerSize => align!
                0 => status!
            }
            current.kind == 8 -> if {
                pointerSize => size!
                pointerSize => align!
                0 => status!
            }
            current.kind == 9 -> if {
                pointerSize => size!
                pointerSize => align!
                0 => status!
            }
            current.kind == 7 -> if {
                current.origin == 4 and current.symbol == 2
                    -> if {
                        pointerSize * 2 => size!
                        pointerSize => align!
                        0 => status!
                    }
                current.origin == 4 and (current.symbol == 3 or current.symbol == 4)
                    -> if {
                        pointerSize * 3 => size!
                        pointerSize => align!
                        0 => status!
                    }
                current.origin == 4 and current.symbol == 5
                    -> if {
                        pointerSize * 2 + 16 => size!
                        8 => align!
                        0 => status!
                    }
                current.origin == 4 and (current.symbol == 6 or current.symbol == 7)
                    -> if {
                        24 => size!
                        8 => align!
                        0 => status!
                    }
            }
        }
        sizes! -> push(size!)
        aligns! -> push(align!)
        statuses! -> push(status!)
        seedIndex! + 1 => seedIndex!
    }
    true => changed!
    changed! -> while {
        false => changed!
        0 => typeIndex!
        typeIndex! < (request.types -> len) -> while {
            statuses![typeIndex!] == 1 -> if {
                request.types[typeIndex!] => current
                current.kind == 4 -> if {
                    current.first >= 0 and statuses![current.first] == 0 and current.length >= 0
                        -> if {
                            sizes![current.first] * current.length => sizes![typeIndex!]
                            aligns![current.first] => aligns![typeIndex!]
                            0 => statuses![typeIndex!]
                            true => changed!
                        }
                }
                current.kind == 7 and current.origin == 4 and (current.symbol == 0 or current.symbol == 1)
                    -> if {
                        current.first >= 0 and statuses![current.first] == 0 and (current.second < 0 or statuses![current.second] == 0)
                            -> if {
                                sizes![current.first] => payloadSize!
                                current.second >= 0 and sizes![current.second] > payloadSize!
                                    -> if { sizes![current.second] => payloadSize! }
                                (payloadSize! + 7) / 8 => payloadWords
                                8 + payloadWords * 8 => sizes![typeIndex!]
                                8 => aligns![typeIndex!]
                                0 => statuses![typeIndex!]
                                true => changed!
                            }
                    }
                (current.kind == 1 and (current.origin == 0 or current.origin == 2)) or current.kind == 10
                    -> if {
                        0 => size!
                        1 => align!
                        true => ready!
                        0 => fieldIndex!
                        fieldIndex! < (request.fields -> len) -> while {
                            request.fields[fieldIndex!] => field
                            false => fieldBelongs!
                            field.ownerType == typeIndex! -> if { true => fieldBelongs! }
                            field.ownerType >= 0
                                and field.ownerType < (request.types -> len)
                                and current.kind == 1
                                -> if {
                                    request.types[field.ownerType] => fieldOwner
                                    fieldOwner.kind == 1
                                        and fieldOwner.module == current.module
                                        and fieldOwner.symbol == current.symbol
                                        -> if { true => fieldBelongs! }
                                }
                            field.status == 0 and fieldBelongs!
                                -> if {
                                    field.fieldType < 0 or statuses![field.fieldType] != 0
                                        -> if { false => ready! } else {
                                            aligns![field.fieldType] > align! -> if { aligns![field.fieldType] => align! }
                                            ((size! + aligns![field.fieldType] - 1) / aligns![field.fieldType]) * aligns![field.fieldType] => size!
                                            size! + sizes![field.fieldType] => size!
                                        }
                                }
                            fieldIndex! + 1 => fieldIndex!
                        }
                        ready! -> if {
                            ((size! + align! - 1) / align!) * align! => sizes![typeIndex!]
                            align! => aligns![typeIndex!]
                            0 => statuses![typeIndex!]
                            true => changed!
                        }
                    }
            }
            typeIndex! + 1 => typeIndex!
        }
    }
    TypeLayouts { sizes: sizes!, aligns: aligns!, statuses: statuses! } => result
    result
}

public layoutOf request: TypeLayoutRequest -> TypeLayout {
    request.typeId => requestedType
    request -> layoutsFor => layouts
    requestedType >= 0 and requestedType < (layouts.sizes -> len)
        -> if {
            TypeLayout { size: layouts.sizes[requestedType], align: layouts.aligns[requestedType], status: layouts.statuses[requestedType] }
        } else {
            TypeLayout { size: -1, align: 1, status: 2 }
        }
}

isDynamicArrayType node: typedIr.TypedIrNode -> Bool {
    node -> typeQueries.isDynamicArray
}

isSliceArrayType node: typedIr.TypedIrNode -> Bool {
    node -> typeQueries.isSliceArray
}

isFixedArrayType node: typedIr.TypedIrNode -> Bool {
    node -> typeQueries.isFixedArray
}

emptyArrayCallParameter nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => parameterIndex!
    nodeIndex >= 0 and nodeIndex < (context.ir -> len)
        -> if {
            context.ir[nodeIndex] => node
            node.kind == 14 and node.operand0 < 0 and node.parent >= 0 and node.parent < (context.ir -> len)
                -> if {
                    context.ir[node.parent] => call
                    call.kind == 6 or call.kind == 9 -> if {
                        call.operand0 => argumentIndex!
                        0 => argumentOrdinal!
                        argumentIndex! >= 0 and argumentIndex! != nodeIndex
                            -> while {
                                context.ir[argumentIndex!].nextOperand => argumentIndex!
                                argumentOrdinal! + 1 => argumentOrdinal!
                            }
                        argumentIndex! == nodeIndex -> if { node.parent -> callTargetParameter(argumentOrdinal!, context, state) => parameterIndex! }
                    }
                }
        }
    parameterIndex!
}

isDictionaryType node: typedIr.TypedIrNode -> Bool {
    node -> typeQueries.isDictionary
}

isGenericEnumType node: typedIr.TypedIrNode -> Bool {
    node -> typeQueries.isGenericEnum
}

isNominalStructType node: typedIr.TypedIrNode -> Bool {
    node -> typeQueries.isNominalStruct
}

isTextType node: typedIr.TypedIrNode -> Bool {
    node -> typeQueries.isText
}

isArgumentsType node: typedIr.TypedIrNode -> Bool {
    node -> typeQueries.isArguments
}

writeTextLikeType node: typedIr.TypedIrNode -> Unit uses Console {
    node -> typeQueries.writeTextLike
}

ownsType node: typedIr.TypedIrNode -> Bool {
    node -> typeQueries.owns
}

# Transitional public boundary used by the emitter and regressions. Canonical
# kind/ownership wins whenever a type ID exists; the shallow branch remains
# only for IR nodes whose migration is not complete yet.
public writeType node: typedIr.TypedIrNode -> Unit uses Console {
    node -> typeQueries.write
}

writeDecimal value: Int -> Unit uses Console {
    "$(value)" -> print
}

writeDecimalLine value: Int -> Unit uses Console {
    "$(value)" -> println
}

emitDirectEachEnd eachIndex: Int, bodyTerminated: Bool, context: ref emitterContext.EmitContext -> Unit uses Console {
    not bodyTerminated -> if {
        "  br label %each$(eachIndex)_continue" -> println
    }
    "each$(eachIndex)_continue:" -> println
    context.ir[context.ir[eachIndex].operand0].kind == 31
        -> if {
            "  %each$(eachIndex)_next = add i32 %each$(eachIndex)_index, 1" -> println
            "  store i32 %each$(eachIndex)_next, ptr %each$(eachIndex)_index_slot, align 4" -> println
        } else {
            "  %each$(eachIndex)_next = add i64 %each$(eachIndex)_index, 1" -> println
            "  store i64 %each$(eachIndex)_next, ptr %each$(eachIndex)_index_slot, align 8" -> println
        }
    "  br label %each$(eachIndex)_header" -> println
    "each$(eachIndex)_exit:" -> println
}

# One direct-each implementation is shared by functions, main, and control arms.
emitDirectEachStart eachIndex: Int, ownerIndex: Int, ownerStart: Int, ownerEnd: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[eachIndex] => eachNode
    context.ir[ownerIndex] => owner
    context.ir[eachNode.operand0] => eachSource
    eachSource -> isArgumentsType => eachArguments
    eachSource.kind == 31 -> if {
        "  %each$(eachIndex)_index_slot = alloca i32, align 4" -> println
        "  store i32 " -> print
        eachSource.operand0 -> writeValue(ownerIndex, context, state)
        ", ptr %each$(eachIndex)_index_slot, align 4" -> println
        "  br label %each$(eachIndex)_header" -> println
        "each$(eachIndex)_header:" -> println
        "  %each$(eachIndex)_index = load i32, ptr %each$(eachIndex)_index_slot, align 4" -> println
        "  %each$(eachIndex)_done = icmp " -> print
        eachSource.opcode == grammar.tokenIdRangeUntil()
            -> if { "sge" -> print } else { "sgt" -> print }
        " i32 %each$(eachIndex)_index, " -> print
        eachSource.operand1 -> writeValue(ownerIndex, context, state)
        "" -> println
        "  br i1 %each$(eachIndex)_done, label %each$(eachIndex)_exit, label %each$(eachIndex)_body" -> println
        "each$(eachIndex)_body:" -> println
        "  %each$(eachIndex)_item = freeze i32 %each$(eachIndex)_index" -> println
    } else {
        eachSource -> isSetCollection(context) => eachSet
        false => eachReadonlyReference!
        eachSource.typeId => eachContainerTypeId!
        eachContainerTypeId! >= 0 and context.types[eachContainerTypeId!].kind == 8
            -> if {
                context.types[eachContainerTypeId!].first => eachContainerTypeId!
                context.types[eachContainerTypeId!].kind == 3
                    -> if {
                        true => eachReadonlyReference!
                        "  %each$(eachIndex)_source = load " -> print
                        eachContainerTypeId! -> writeSemanticTypeId(context, state)
                        ", ptr " -> print
                        eachNode.operand0 -> writeValue(ownerIndex, context, state)
                        ", align 8" -> println
                    }
            }
        eachArguments -> if {
            "  %each$(eachIndex)_length = call i64 @sollang_argument_count()" -> println
        } else {
            eachSet -> if {
                "  %each$(eachIndex)_keys = extractvalue %sollang.dict " -> print
                eachNode.operand0 -> writeValue(ownerIndex, context, state)
                ", 0" -> println
                "  %each$(eachIndex)_controls = extractvalue %sollang.dict " -> print
                eachNode.operand0 -> writeValue(ownerIndex, context, state)
                ", 1" -> println
                "  %each$(eachIndex)_length = extractvalue %sollang.dict " -> print
                eachNode.operand0 -> writeValue(ownerIndex, context, state)
                ", 3" -> println
            } else {
                "  %each$(eachIndex)_data = extractvalue " -> print
                eachContainerTypeId! -> writeArrayViewType(context, state)
                " " -> print
                eachReadonlyReference! -> if { "%each$(eachIndex)_source" -> print } else {
                    eachSource.kind == 5 and owner.operand1 >= 0 and eachSource.symbol == context.ir[owner.operand1].symbol
                        -> if { "%arg" -> print } else { "%v$(eachNode.operand0)" -> print }
                }
                ", 0" -> println
                "  %each$(eachIndex)_length = extractvalue " -> print
                eachContainerTypeId! -> writeArrayViewType(context, state)
                " " -> print
                eachReadonlyReference! -> if { "%each$(eachIndex)_source" -> print } else {
                    eachSource.kind == 5 and owner.operand1 >= 0 and eachSource.symbol == context.ir[owner.operand1].symbol
                        -> if { "%arg" -> print } else { "%v$(eachNode.operand0)" -> print }
                }
                ", 1" -> println
            }
        }
        "  %each$(eachIndex)_index_slot = alloca i64, align 8" -> println
        "  store i64 0, ptr %each$(eachIndex)_index_slot, align 8" -> println
        "  br label %each$(eachIndex)_header" -> println
        "each$(eachIndex)_header:" -> println
        "  %each$(eachIndex)_index = load i64, ptr %each$(eachIndex)_index_slot, align 8" -> println
        "  %each$(eachIndex)_done = icmp eq i64 %each$(eachIndex)_index, %each$(eachIndex)_length" -> println
        eachSet -> if {
            "  br i1 %each$(eachIndex)_done, label %each$(eachIndex)_exit, label %each$(eachIndex)_check" -> println
            "each$(eachIndex)_check:" -> println
            "  %each$(eachIndex)_control_ptr = getelementptr i8, ptr %each$(eachIndex)_controls, i64 %each$(eachIndex)_index" -> println
            "  %each$(eachIndex)_control = load i8, ptr %each$(eachIndex)_control_ptr, align 1" -> println
            "  %each$(eachIndex)_occupied = icmp sgt i8 %each$(eachIndex)_control, 0" -> println
            "  br i1 %each$(eachIndex)_occupied, label %each$(eachIndex)_body, label %each$(eachIndex)_continue" -> println
        } else {
            "  br i1 %each$(eachIndex)_done, label %each$(eachIndex)_exit, label %each$(eachIndex)_body" -> println
        }
        "each$(eachIndex)_body:" -> println
        eachArguments -> if {
            "  %each$(eachIndex)_item = call %sollang.text @sollang_argument(i64 %each$(eachIndex)_index)" -> println
        } else {
            "  %each$(eachIndex)_item_ptr = getelementptr " -> print
            eachSource -> writeArrayElementType(context, state)
            ", ptr " -> print
            eachSet -> if { "%each$(eachIndex)_keys" -> print } else { "%each$(eachIndex)_data" -> print }
            ", i64 %each$(eachIndex)_index" -> println
            "  %each$(eachIndex)_item = load " -> print
            eachSource -> writeArrayElementType(context, state)
            ", ptr %each$(eachIndex)_item_ptr, align " -> print
            eachSource -> arrayElementAlign(context, state) -> writeDecimalLine
        }
    }
    eachIndex -> emitDirectEachRoleAliases(eachSource, context, state)
    ownerStart => eachRoleUseIndex!
    eachRoleUseIndex! < ownerEnd -> while {
        context.ir[eachRoleUseIndex!] => eachRoleUse
        NodeAncestorRequest { nodeIndex: eachRoleUseIndex!, ownerIndex: eachIndex } => eachRoleAncestorRequest
        eachRoleAncestorRequest -> nodeDescendsFrom(context, state) => eachRoleInside
        eachRoleUse.kind == 5 and eachRoleUse.operand0 < 0 and eachRoleUse.symbol >= 0 and eachRoleInside
            -> if {
                context.ranges[eachRoleUse.sourceModule] => eachRoleRange
                false => eachRoleIsItem!
                eachRoleUse.symbol < eachRoleRange.symbolCount
                    -> if {
                        context.symbols[eachRoleRange.symbolStart + eachRoleUse.symbol] => eachRoleSymbol
                        eachRoleSymbol.kind == 35 and eachRoleSymbol.astNode == eachNode.astNode
                            -> if { true => eachRoleIsItem! }
                    }
                eachRoleIsItem! -> if {
                    "  %v$(eachRoleUseIndex!) = freeze " -> print
                    eachSource -> writeDirectEachElementType(context, state)
                    " %each$(eachIndex)_item" -> println
                }
            }
        eachRoleUseIndex! + 1 => eachRoleUseIndex!
    }
}

# Capacity exists only on growable/bounded owners and Arena. Fixed arrays,
# slices and Text have no capacity field. Keep rejection and extraction on
# the same semantic receiver contract.
interpolationCapacityField typeId: Int, context: ref emitterContext.EmitContext -> Int {
    typeId => valueType!
    valueType! >= 0 and context.types[valueType!].kind == 8
        -> if {
            context.types[valueType!].first => valueType!
        }
    -1 => field!
    valueType! >= 0 -> if {
        context.types[valueType!] => value
        value.kind == 3 or value.kind == 12
            or (value.kind == 1 and value.origin == 1 and value.symbol == 15)
            -> if { 2 => field! }
        value.kind == 5 or value.kind == 13 -> if { 3 => field! }
    }
    field!
}

invalidInterpolationCapacityNode context: ref emitterContext.EmitContext -> Int {
    false => hasCapacity!
    0 => search!
    search! < (context.interpolations -> len) and not hasCapacity!
        -> while {
            context.interpolations[search!].kind == 6 and context.interpolations[search!].opcode == -236
                -> if { true => hasCapacity! }
            search! + 1 => search!
        }
    not hasCapacity! -> if { -1 -> return }
    context -> prepareCoreEmitterState => state
    -1 => invalid!
    0 => irIndex!
    irIndex! < (context.ir -> len) and invalid! < 0
        -> while {
            context.ir[irIndex!] => literal
            literal.kind == 2 and literal.sourceModule >= 0
                -> if {
                    literal.parent => owner!
                    owner! >= 0 and context.ir[owner!].kind != 0 and context.ir[owner!].kind != 11
                        -> while {
                            context.ir[owner!].parent => owner!
                        }
                    context.interpolationRanges[literal.sourceModule] => range
                    range.nodeStart => nodeIndex!
                    nodeIndex! < range.nodeStart + range.nodeCount and invalid! < 0
                        -> while {
                            context.interpolations[nodeIndex!] => node
                            node.sourceToken == literal.payloadToken and node.kind == 6 and node.opcode == -236 and node.operand0 >= 0
                                -> if {
                                    node.operand0 -> interpolationNodeTypeId(context.interpolations, literal.sourceModule, owner!, irIndex!, context, state) => receiverType
                                    (receiverType -> interpolationCapacityField(context)) < 0
                                        -> if { nodeIndex! => invalid! }
                                }
                            nodeIndex! + 1 => nodeIndex!
                        }
                }
            irIndex! + 1 => irIndex!
        }
    invalid!
}
