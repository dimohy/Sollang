    bindingIndex: Int
    regionIndex: Int
}

struct TryParallelCollectRequest {
    expressionIndex: Int
    outerTypeId: Int
    callbackTypeId: Int
}

struct ProcessCallRequest {
    callIndex: Int
    ownerIndex: Int
}

struct DirectoryCallRequest {
