                Arena(0) => grownProbeControlsStorage!
                "%put$(putIndex)_controls" -> materialize(grownProbeControlsStorage!) => grownProbeControls
                Arena(0) => grownProbeKeysStorage!
                "%put$(putIndex)_keys" -> materialize(grownProbeKeysStorage!) => grownProbeKeys
                Arena(0) => grownProbeCapacityStorage!
                "%put$(putIndex)_capacity" -> materialize(grownProbeCapacityStorage!) => grownProbeCapacity
