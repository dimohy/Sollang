                            ", ptr %while$(whileIndex)_v$(valueNodeIndex)_data, i64 %while$(whileIndex)_v$(valueNodeIndex)_index" -> println
                            "  %while$(whileIndex)_v$(valueNodeIndex) = load " -> print
                            valueNode -> writeIrType(context, state)
