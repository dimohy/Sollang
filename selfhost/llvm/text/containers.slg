                                " to i64" -> println
                            }
                            "  %while$(whileIndex)_v$(valueNodeIndex) = insertvalue %sollang.text %while$(whileIndex)_v$(valueNodeIndex)_ptr, i64 " -> print
                            (whileSliceLengthNode.kind != 3 and whileSliceLengthWidth > 0 and whileSliceLengthWidth < 64) -> if {
                                "%while$(whileIndex)_v$(valueNodeIndex)_length" -> print
                            } else {
                                WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: whileSliceLength } -> writeWhileValue(context, state)
                            }
                            ", 1" -> println
                        }
                        (valueNode.kind == 13 and valueNode.operand0 >= 0) -> if {
                            WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNodeIndex } -> emitWhileMember(context, state)
