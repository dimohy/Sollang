            putNode.opcode == -303 -> if {
                "  %v$(putIndex -> valueNameId(state)) = phi i1 [ false, %put$(putIndex)_update_in_place ], [ true, %put$(putIndex)_insert_in_place ]" -> print
                not putBounded! -> if { ", [ true, %put$(putIndex)_insert ]" -> print }
                "" -> println
            }
        }
    }
}
emitBoundedDictionaryPut request: WhileValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    request.whileIndex => putIndex
    context.ir[putIndex] => putNode
    putNode.operand0 => sourceIndex
    putNode.operand1 => keyIndex
    context.ir[keyIndex].nextOperand => valueIndex
    context.ir[sourceIndex] => sourceNode
    sourceNode -> boundedDictionaryValueTypeId(context) => dictionaryTypeId
    context.types[dictionaryTypeId] => dictionaryType
    dictionaryType.first => keyTypeId
    dictionaryType.second => valueTypeId
    context.types[keyTypeId] => keyType
    dictionaryTypeId -> boundedDictionaryLayoutForType(context) => layout
    sourceIndex -> mutableStorageRoot(context, state) => putRoot
    sourceIndex -> mutableBorrowParameterOrdinal(request.ownerIndex, context, state) => putBorrow
    Arena(0) => prefixStorage!
    "bput$(putIndex)" -> materialize(prefixStorage!) => prefix
    "  %$(prefix)_owner = getelementptr i8, ptr " -> print
    putBorrow >= 0 -> if { putBorrow -> writeMutableStructParameterPointer } else { "%slot$(putRoot)" -> print }
    ", i64 0" -> println
    prefix -> emitBoundedDictionaryStoragePointer("%$(prefix)_owner", dictionaryTypeId)
    "  %$(prefix)_length_ptr = getelementptr inbounds %sollang.bounded_dictionary.t$(dictionaryTypeId), ptr %$(prefix)_owner, i32 0, i32 0" -> println
    "  %$(prefix)_old_length = load i64, ptr %$(prefix)_length_ptr, align 8" -> println
    "  %$(prefix)_query = freeze " -> print
    keyTypeId -> writeSemanticTypeId(context, state)
    " " -> print
    keyIndex -> writeValue(request.ownerIndex, context, state)
    "" -> println
    context.types[valueTypeId].kind == 12 -> if {
        Arena(0) => boundedPrefixStorage!
        "$(prefix)_new_value" -> materialize(boundedPrefixStorage!) => boundedPrefix
        boundedPrefix -> emitBoundedArrayValue(valueIndex, request.ownerIndex, valueTypeId, context, state)
    } else {
        "  %$(prefix)_new_value = freeze " -> print
        valueTypeId -> writeAggregateFieldTypeId(context, state)
        " " -> print
        valueIndex -> writeValue(request.ownerIndex, context, state)
        "" -> println
    }
    false => textKey!
    keyType.kind == 1 and keyType.origin == 1 and keyType.symbol == 1
        -> if { true => textKey! }
    keyTypeId -> traitMethodSymbol("Hash", "hash", context, state) => hashMethod
    keyTypeId -> traitMethodSymbol("Eq", "eq", context, state) => eqMethod
    keyType.symbol -> integerWidth(context, state) => keyWidth!
    keyType.symbol == 23 -> if { 1 => keyWidth! }
    keyType.symbol -> integerSigned(context, state) => keySigned
    textKey! -> if {
        "  %$(prefix)_hash = call i64 @sollang_dictionary_hash_text(%sollang.text %$(prefix)_query)" -> println
    } else {
        hashMethod >= 0 and eqMethod >= 0 -> if {
            "  %$(prefix)_hash_value = call i32 @sollang_m$(keyType.module)_s$(hashMethod)(" -> print
            keyTypeId -> writeSemanticTypeId(context, state)
            " %$(prefix)_query)" -> println
            "  %$(prefix)_hash_key = sext i32 %$(prefix)_hash_value to i64" -> println
        } else {
            "  %$(prefix)_hash_key = " -> print
            keyWidth! == 64 -> if { "add i64 0, " -> print } else {
                keySigned -> if { "sext " -> print } else { "zext " -> print }
                "i$(keyWidth!) " -> print
            }
            "%$(prefix)_query" -> print
            keyWidth! == 64 -> if { "" -> println } else { " to i64" -> println }
        }
        "  %$(prefix)_hash_high = lshr i64 %$(prefix)_hash_key, 32" -> println
        "  %$(prefix)_hash_fold = xor i64 %$(prefix)_hash_key, %$(prefix)_hash_high" -> println
        "  %$(prefix)_hash = mul i64 %$(prefix)_hash_fold, -7046029254386353131" -> println
    }
    "  %$(prefix)_h2_shifted = lshr i64 %$(prefix)_hash, 57" -> println
    "  %$(prefix)_h2_raw = and i64 %$(prefix)_h2_shifted, 127" -> println
    "  %$(prefix)_h2_zero = icmp eq i64 %$(prefix)_h2_raw, 0" -> println
    "  %$(prefix)_h2_value = select i1 %$(prefix)_h2_zero, i64 1, i64 %$(prefix)_h2_raw" -> println
    "  %$(prefix)_h2 = trunc i64 %$(prefix)_h2_value to i8" -> println
    prefix -> emitBoundedDictionaryProbe("%$(prefix)_storage", "%$(prefix)_query", "%$(prefix)_hash", "%$(prefix)_h2", dictionaryTypeId, false, context, state)
    "  br i1 %$(prefix)_exists, label %$(prefix)_update, label %$(prefix)_insert_check" -> println
    "$(prefix)_insert_check:" -> println
    "  %$(prefix)_insert_slot = add i64 %$(prefix)_slot, 0" -> println
    "  %$(prefix)_new_length = add i64 %$(prefix)_old_length, 1" -> println
    "  %$(prefix)_fits = icmp ule i64 %$(prefix)_new_length, $(dictionaryType.length)" -> println
    "  br i1 %$(prefix)_fits, label %$(prefix)_insert, label %$(prefix)_full" -> println
    "$(prefix)_full:" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "$(prefix)_update:" -> println
    keyTypeId -> semanticTypeOwns(context, state)
        -> if {
            "  call void @sollang_drop_t$(keyTypeId)(" -> print
            keyTypeId -> writeSemanticTypeId(context, state)
            " %$(prefix)_query)" -> println
        }
    putNode.opcode == -303 -> if {
        valueTypeId -> semanticTypeOwns(context, state)
            -> if {
                "  call void @sollang_drop_t$(valueTypeId)(" -> print
                valueTypeId -> writeAggregateFieldTypeId(context, state)
                " %$(prefix)_new_value)" -> println
            }
    } else {
        "$(prefix)_update_value" -> emitBoundedDictionaryEntryPointer("%$(prefix)_storage", "%$(prefix)_slot", layout.valueOffset, layout)
        valueTypeId -> semanticTypeOwns(context, state)
            -> if {
                "  %$(prefix)_old_value = load " -> print
                valueTypeId -> writeAggregateFieldTypeId(context, state)
                ", ptr %$(prefix)_update_value_ptr, align $(layout.valueAlign)" -> println
                "  call void @sollang_drop_t$(valueTypeId)(" -> print
                valueTypeId -> writeAggregateFieldTypeId(context, state)
                " %$(prefix)_old_value)" -> println
            }
        "  store " -> print
        valueTypeId -> writeAggregateFieldTypeId(context, state)
        " %$(prefix)_new_value, ptr %$(prefix)_update_value_ptr, align $(layout.valueAlign)" -> println
    }
    "  br label %$(prefix)_complete" -> println
    "$(prefix)_insert:" -> println
    "$(prefix)_insert_key" -> emitBoundedDictionaryEntryPointer("%$(prefix)_storage", "%$(prefix)_insert_slot", 0, layout)
    "  store " -> print
    keyTypeId -> writeSemanticTypeId(context, state)
    " %$(prefix)_query, ptr %$(prefix)_insert_key_ptr, align $(layout.keyAlign)" -> println
    "$(prefix)_insert_value" -> emitBoundedDictionaryEntryPointer("%$(prefix)_storage", "%$(prefix)_insert_slot", layout.valueOffset, layout)
    "  store " -> print
    valueTypeId -> writeAggregateFieldTypeId(context, state)
    " %$(prefix)_new_value, ptr %$(prefix)_insert_value_ptr, align $(layout.valueAlign)" -> println
    "$(prefix)_insert_control" -> emitBoundedDictionaryControlStore("%$(prefix)_storage", "%$(prefix)_insert_slot", "%$(prefix)_h2", layout)
    "  store i64 %$(prefix)_new_length, ptr %$(prefix)_length_ptr, align 8" -> println
    "  br label %$(prefix)_complete" -> println
    "$(prefix)_complete:" -> println
    putNode.opcode == -303 -> if {
        "  %v$(putIndex -> valueNameId(state)) = phi i1 [ false, %$(prefix)_update ], [ true, %$(prefix)_insert ]" -> println
    }
}

emitExchange request: WhileValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    request.whileIndex => exchangeIndex
    context.ir[exchangeIndex] => exchangeNode
    context.ir[exchangeNode.operand0] => exchangeSource
    exchangeNode.operand1 -> aggregateValueIndex(context, state) => exchangeLeftIndex
    context.ir[exchangeLeftIndex] => exchangeLeft
    context.ir[exchangeNode.operand1].nextOperand -> aggregateValueIndex(context, state) => exchangeRightIndex
    context.ir[exchangeRightIndex] => exchangeRight
    exchangeNode.operand0 -> mutableBorrowParameterOrdinal(request.ownerIndex, context, state) => exchangeBorrowOrdinal
    exchangeNode.operand0 -> referencePlaceRootBindingForOwner(request.ownerIndex, context) => exchangePlaceRoot
    exchangePlaceRoot -> mutableBorrowParameterOrdinal(request.ownerIndex, context, state) => exchangePlaceRootBorrowOrdinal
    (exchangeSource.kind == 13
        and exchangeSource.operand0 >= 0
        and exchangePlaceRoot >= 0
        and (exchangePlaceRootBorrowOrdinal >= 0
        or (context.ir[exchangePlaceRoot].kind == 10 and context.ir[exchangePlaceRoot].flags / 2 % 2 == 1)
        or (context.ir[exchangePlaceRoot].kind == 17 and context.ir[exchangePlaceRoot].flags == 1))) => exchangeStructMember
    exchangeBorrowOrdinal >= 0 and not exchangeStructMember
        -> if {
            "  %exchange$(exchangeIndex)_data = load ptr, ptr " -> print
            exchangeBorrowOrdinal == 0 -> if { "%arg_mut_ptr_addr" -> print } else { "%arg$(exchangeBorrowOrdinal)_mut_ptr_addr" -> print }
            ", align 8" -> println
            "  %exchange$(exchangeIndex)_length = load i64, ptr " -> print
            exchangeBorrowOrdinal == 0 -> if { "%arg_mut_len_addr" -> print } else { "%arg$(exchangeBorrowOrdinal)_mut_len_addr" -> print }
            ", align 8" -> println
        } else {
            "  %exchange$(exchangeIndex)_data = extractvalue %sollang.array.i32 %v$(exchangeNode.operand0 -> valueNameId(state)), 0" -> println
            "  %exchange$(exchangeIndex)_length = extractvalue %sollang.array.i32 %v$(exchangeNode.operand0 -> valueNameId(state)), 1" -> println
        }
    exchangeLeft -> integerNodeWidth(context, state) => exchangeLeftWidth
    exchangeLeft.kind != 3 and exchangeLeftWidth > 0 and exchangeLeftWidth < 64
        -> if {
            "  %exchange$(exchangeIndex)_left = " -> print
            exchangeLeft -> integerNodeSigned(context, state)
                -> if { "sext " -> print } else { "zext " -> print }
            exchangeLeft -> writeIrType(context, state)
            " %v$(exchangeLeftIndex -> valueNameId(state)) to i64" -> println
        }
    exchangeRight -> integerNodeWidth(context, state) => exchangeRightWidth
    exchangeRight.kind != 3 and exchangeRightWidth > 0 and exchangeRightWidth < 64
        -> if {
            "  %exchange$(exchangeIndex)_right = " -> print
            exchangeRight -> integerNodeSigned(context, state)
                -> if { "sext " -> print } else { "zext " -> print }
            exchangeRight -> writeIrType(context, state)
            " %v$(exchangeRightIndex -> valueNameId(state)) to i64" -> println
        }
    "  %exchange$(exchangeIndex)_left_in_bounds = icmp ult i64 " -> print
    exchangeLeft.kind == 3 -> if { exchangeLeft -> writeIntegerLiteral(context, state) } else {
        exchangeLeftWidth > 0 and exchangeLeftWidth < 64
            -> if { "%exchange$(exchangeIndex)_left" -> print } else { "%v$(exchangeLeftIndex -> valueNameId(state))" -> print }
    }
    ", %exchange$(exchangeIndex)_length" -> println
    "  %exchange$(exchangeIndex)_right_in_bounds = icmp ult i64 " -> print
    exchangeRight.kind == 3 -> if { exchangeRight -> writeIntegerLiteral(context, state) } else {
        exchangeRightWidth > 0 and exchangeRightWidth < 64
            -> if { "%exchange$(exchangeIndex)_right" -> print } else { "%v$(exchangeRightIndex -> valueNameId(state))" -> print }
    }
    ", %exchange$(exchangeIndex)_length" -> println
    "  %exchange$(exchangeIndex)_in_bounds = and i1 %exchange$(exchangeIndex)_left_in_bounds, %exchange$(exchangeIndex)_right_in_bounds" -> println
    "  br i1 %exchange$(exchangeIndex)_in_bounds, label %exchange$(exchangeIndex)_validated, label %exchange$(exchangeIndex)_missing" -> println
    "exchange$(exchangeIndex)_missing:" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "exchange$(exchangeIndex)_validated:" -> println
    "  %exchange$(exchangeIndex)_same = icmp eq i64 " -> print
    exchangeLeft.kind == 3 -> if { exchangeLeft -> writeIntegerLiteral(context, state) } else {
        exchangeLeftWidth > 0 and exchangeLeftWidth < 64
            -> if { "%exchange$(exchangeIndex)_left" -> print } else { "%v$(exchangeLeftIndex -> valueNameId(state))" -> print }
    }
    ", " -> print
    exchangeRight.kind == 3 -> if { exchangeRight -> writeIntegerLiteral(context, state) } else {
        exchangeRightWidth > 0 and exchangeRightWidth < 64
            -> if { "%exchange$(exchangeIndex)_right" -> print } else { "%v$(exchangeRightIndex -> valueNameId(state))" -> print }
    }
    "" -> println
    "  br i1 %exchange$(exchangeIndex)_same, label %exchange$(exchangeIndex)_done, label %exchange$(exchangeIndex)_swap" -> println
    "exchange$(exchangeIndex)_swap:" -> println
    "  %exchange$(exchangeIndex)_left_ptr = getelementptr " -> print
    exchangeSource -> writeArrayElementType(context, state)
    ", ptr %exchange$(exchangeIndex)_data, i64 " -> print
    exchangeLeft.kind == 3 -> if { exchangeLeft -> writeIntegerLiteral(context, state) } else {
        exchangeLeftWidth > 0 and exchangeLeftWidth < 64
            -> if { "%exchange$(exchangeIndex)_left" -> print } else { "%v$(exchangeLeftIndex -> valueNameId(state))" -> print }
    }
    "" -> println
    "  %exchange$(exchangeIndex)_right_ptr = getelementptr " -> print
    exchangeSource -> writeArrayElementType(context, state)
    ", ptr %exchange$(exchangeIndex)_data, i64 " -> print
    exchangeRight.kind == 3 -> if { exchangeRight -> writeIntegerLiteral(context, state) } else {
        exchangeRightWidth > 0 and exchangeRightWidth < 64
            -> if { "%exchange$(exchangeIndex)_right" -> print } else { "%v$(exchangeRightIndex -> valueNameId(state))" -> print }
    }
    "" -> println
    "  %exchange$(exchangeIndex)_left_value = load " -> print
    exchangeSource -> writeArrayElementType(context, state)
    ", ptr %exchange$(exchangeIndex)_left_ptr, align " -> print
    exchangeSource -> arrayElementAlign(context, state) -> writeDecimalLine
    "  %exchange$(exchangeIndex)_right_value = load " -> print
    exchangeSource -> writeArrayElementType(context, state)
    ", ptr %exchange$(exchangeIndex)_right_ptr, align " -> print
    exchangeSource -> arrayElementAlign(context, state) -> writeDecimalLine
    "  store " -> print
    exchangeSource -> writeArrayElementType(context, state)
    " %exchange$(exchangeIndex)_right_value, ptr %exchange$(exchangeIndex)_left_ptr, align " -> print
    exchangeSource -> arrayElementAlign(context, state) -> writeDecimalLine
    "  store " -> print
    exchangeSource -> writeArrayElementType(context, state)
    " %exchange$(exchangeIndex)_left_value, ptr %exchange$(exchangeIndex)_right_ptr, align " -> print
    exchangeSource -> arrayElementAlign(context, state) -> writeDecimalLine
    "  br label %exchange$(exchangeIndex)_done" -> println
    "exchange$(exchangeIndex)_done:" -> println
}

emitBoundedDictionaryTake request: WhileValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    request.whileIndex => takeIndex
    context.ir[takeIndex] => takeNode
    takeNode.operand0 => sourceIndex
    context.ir[sourceIndex] => sourceNode
    takeNode.operand1 -> aggregateValueIndex(context, state) => keyIndex
    sourceNode -> boundedDictionaryValueTypeId(context) => dictionaryTypeId
    context.types[dictionaryTypeId] => dictionaryType
    dictionaryType.first => keyTypeId
    dictionaryType.second => valueTypeId
    dictionaryTypeId -> boundedDictionaryLayoutForType(context) => layout
    sourceIndex -> mutableBindingRoot(context, state) => takeRoot
    sourceIndex -> mutableBorrowParameterOrdinal(request.ownerIndex, context, state) => takeBorrow
    sourceIndex -> referencePlaceRootBindingForOwner(request.ownerIndex, context) => takePlaceRoot
    takePlaceRoot -> mutableBorrowParameterOrdinal(request.ownerIndex, context, state) => takePlaceBorrow
    (sourceNode.kind == 13 and sourceNode.operand0 >= 0 and takePlaceRoot >= 0
        and (takePlaceBorrow >= 0
        or (context.ir[takePlaceRoot].kind == 10 and context.ir[takePlaceRoot].flags / 2 % 2 == 1)
        or (context.ir[takePlaceRoot].kind == 17 and context.ir[takePlaceRoot].flags == 1))) => takeStructMember
    Arena(0) => prefixStorage!
    "btake$(takeIndex)" -> materialize(prefixStorage!) => prefix
    takeStructMember -> if {
        sourceIndex -> emitMutableReferenceMemberPlace(takePlaceRoot, takeIndex, 0, request.ownerIndex, false, context, state) => memberDepth
        "  %$(prefix)_owner = getelementptr i8, ptr %callref$(takeIndex)_arg0_place$(memberDepth - 1), i64 0" -> println
    } else {
        "  %$(prefix)_owner = getelementptr i8, ptr " -> print
        takeBorrow >= 0 -> if { takeBorrow -> writeMutableStructParameterPointer } else { "%slot$(takeRoot)" -> print }
        ", i64 0" -> println
    }
    prefix -> emitBoundedDictionaryStoragePointer("%$(prefix)_owner", dictionaryTypeId)
    "  %$(prefix)_length_ptr = getelementptr inbounds %sollang.bounded_dictionary.t$(dictionaryTypeId), ptr %$(prefix)_owner, i32 0, i32 0" -> println
    "  %$(prefix)_old_length = load i64, ptr %$(prefix)_length_ptr, align 8" -> println
    "  %$(prefix)_query = freeze " -> print
    keyTypeId -> writeSemanticTypeId(context, state)
    " " -> print
    keyIndex -> writeValue(request.ownerIndex, context, state)
    "" -> println
    "$(prefix)_find" -> emitBoundedDictionaryFindRequiredSlot("%$(prefix)_storage", "%$(prefix)_query", dictionaryTypeId, false, context, state)
    "$(prefix)_value" -> emitBoundedDictionaryEntryPointer("%$(prefix)_storage", "%$(prefix)_find_slot", layout.valueOffset, layout)
    "  %v$(takeIndex -> valueNameId(state))" -> print
    context.types[valueTypeId].kind == 12 -> if { "_bounded_value" -> print }
    " = load " -> print
    valueTypeId -> writeAggregateFieldTypeId(context, state)
    ", ptr %$(prefix)_value_ptr, align $(layout.valueAlign)" -> println
    Arena(0) => takenPrefixStorage!
    "v$(takeIndex -> valueNameId(state))" -> materialize(takenPrefixStorage!) => takenPrefix
    takenPrefix -> emitStoredBoundedValueHandle(valueTypeId, context, state)
    keyTypeId -> semanticTypeOwns(context, state)
        -> if {
            "$(prefix)_key" -> emitBoundedDictionaryEntryPointer("%$(prefix)_storage", "%$(prefix)_find_slot", 0, layout)
            "  %$(prefix)_stored_key = load " -> print
            keyTypeId -> writeSemanticTypeId(context, state)
            ", ptr %$(prefix)_key_ptr, align $(layout.keyAlign)" -> println
            "  call void @sollang_drop_t$(keyTypeId)(" -> print
            keyTypeId -> writeSemanticTypeId(context, state)
            " %$(prefix)_stored_key)" -> println
        }
    "$(prefix)_deleted" -> emitBoundedDictionaryControlStore("%$(prefix)_storage", "%$(prefix)_find_slot", "-1", layout)
    "  %$(prefix)_new_length = sub i64 %$(prefix)_old_length, 1" -> println
    "  store i64 %$(prefix)_new_length, ptr %$(prefix)_length_ptr, align 8" -> println
}

emitTake request: WhileValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    request.whileIndex => takeIndex
    context.ir[takeIndex] => takeNode
    context.ir[takeNode.operand0] => takeSource
    (takeSource -> boundedDictionaryValueTypeId(context)) >= 0
        -> if {
            request -> emitBoundedDictionaryTake(context, state)
            return
        }
    takeNode.operand1 -> aggregateValueIndex(context, state) => takeArgumentIndex
    context.ir[takeArgumentIndex] => takeArgument
    takeNode.operand0 -> mutableBindingRoot(context, state) => takeRoot
    takeNode.operand0 -> mutableBorrowParameterOrdinal(request.ownerIndex, context, state) => takeBorrowOrdinal
    takeNode.operand0 -> referencePlaceRootBindingForOwner(request.ownerIndex, context) => takePlaceRoot
    takePlaceRoot -> mutableBorrowParameterOrdinal(request.ownerIndex, context, state) => takePlaceRootBorrowOrdinal
    (takeSource.kind == 13
        and takeSource.operand0 >= 0
        and takePlaceRoot >= 0
        and (takePlaceRootBorrowOrdinal >= 0
        or (context.ir[takePlaceRoot].kind == 10 and context.ir[takePlaceRoot].flags / 2 % 2 == 1)
        or (context.ir[takePlaceRoot].kind == 17 and context.ir[takePlaceRoot].flags == 1))) => takeStructMember
    takeSource -> isDictionaryType -> if {
        -1 => takeKeyTypeId!
        -1 => takeValueTypeId!
        takeSource.typeId >= 0 -> if {
            context.types[takeSource.typeId] => takeDictionaryType
            takeDictionaryType.kind == 5 or takeDictionaryType.kind == 13
                -> if {
                    takeDictionaryType.first => takeKeyTypeId!
                    takeDictionaryType.second => takeValueTypeId!
                }
        }
        # A dictionary borrow addresses its canonical handle. A projected
        # member takes precedence over the containing mutable struct input.
        0 => takeDictionaryMemberDepth!
        takeStructMember -> if {
            takeNode.operand0 -> emitMutableReferenceMemberPlace(
            takePlaceRoot,
            takeIndex,
            0,
            request.ownerIndex,
            false,
            context,
            state) => takeDictionaryMemberDepth!
        }
        "  %take$(takeIndex)_dictionary = load %sollang.int_dictionary, ptr " -> print
        takeStructMember -> if {
            "%callref$(takeIndex)_arg0_place$(takeDictionaryMemberDepth! - 1)" -> print
        } else {
            takeBorrowOrdinal >= 0 -> if { takeBorrowOrdinal -> writeMutableStructParameterPointer } else { "%slot$(takeRoot)" -> print }
        }
        ", align 8" -> println
        "  %take$(takeIndex)_storage = extractvalue %sollang.int_dictionary %take$(takeIndex)_dictionary, 0" -> println
        "  %take$(takeIndex)_length = extractvalue %sollang.int_dictionary %take$(takeIndex)_dictionary, 1" -> println
        "  %take$(takeIndex)_capacity = extractvalue %sollang.int_dictionary %take$(takeIndex)_dictionary, 2" -> println
        -1 => takeKeyStorageSize!
        takeKeyTypeId! >= 0 -> if { context.typeSizes[takeKeyTypeId!] => takeKeyStorageSize! }
        takeKeyStorageSize! < 0 -> if { takeSource.typeModule -> storageSize(context, state) => takeKeyStorageSize! }
        takeKeyTypeId! -> dictionaryEntryLayoutForTypeIds(takeValueTypeId!, takeSource.typeModule, takeSource.typeSymbol, context, state) => takeEntryLayout
        "take$(takeIndex)" -> emitGrowableDictionaryPointers("%take$(takeIndex)_storage", "%take$(takeIndex)_capacity", takeEntryLayout)
        takeKeyStorageSize! == 1 -> if {
            takeKeyTypeId! >= 0 -> if { context.types[takeKeyTypeId!].symbol -> integerWidth(context, state) } else { -1 }
        } else {
            takeKeyStorageSize! == 2 -> if { 16 } else {
                takeKeyStorageSize! == 4 -> if { 32 } else {
                    takeKeyStorageSize! == 8 -> if { 64 } else { -1 }
                }
            }
        } => takeHashWidth
        false => takeHashSigned!
        takeKeyTypeId! >= 0 -> if { context.types[takeKeyTypeId!].symbol -> integerSigned(context, state) => takeHashSigned! }
        -1 => takeHashMethod!
        takeKeyTypeId! >= 0 -> if { takeKeyTypeId! -> traitMethodSymbol("Hash", "hash", context, state) => takeHashMethod! }
        false => takeKeyIsText!
        takeKeyTypeId! >= 0 -> if {
            context.types[takeKeyTypeId!] => takeCanonicalKeyType
            takeCanonicalKeyType.kind == 1 and takeCanonicalKeyType.origin == 1 and takeCanonicalKeyType.symbol == 1
                -> if { true => takeKeyIsText! }
        }
        -1 => takeEqMethod!
        takeKeyTypeId! >= 0 -> if { takeKeyTypeId! -> traitMethodSymbol("Eq", "eq", context, state) => takeEqMethod! }
        (takeHashMethod! >= 0 and takeEqMethod! >= 0) => takeKeyIsNominal
        "  %take$(takeIndex)_query = freeze " -> print
        takeKeyTypeId! >= 0 -> if { takeKeyTypeId! -> writeSemanticTypeId(context, state) } else { takeSource.typeModule -> llvmType(context, state) -> print }
        " " -> print
        takeArgumentIndex -> writeValue(request.ownerIndex, context, state)
        "" -> println
        "take$(takeIndex)_query" -> emitSetHashValue("%take$(takeIndex)_query", takeKeyTypeId!, takeHashMethod!, takeKeyIsText!, takeKeyIsNominal, takeHashWidth, takeHashSigned!, context, state)
        "  %take$(takeIndex)_hash = add i64 %take$(takeIndex)_query_hash, 0" -> println
        "  %take$(takeIndex)_h2_shifted = lshr i64 %take$(takeIndex)_hash, 57" -> println
        "  %take$(takeIndex)_h2_raw = and i64 %take$(takeIndex)_h2_shifted, 127" -> println
        "  %take$(takeIndex)_h2_zero = icmp eq i64 %take$(takeIndex)_h2_raw, 0" -> println
        "  %take$(takeIndex)_h2_value = select i1 %take$(takeIndex)_h2_zero, i64 1, i64 %take$(takeIndex)_h2_raw" -> println
        "  %take$(takeIndex)_h2 = trunc i64 %take$(takeIndex)_h2_value to i8" -> println
        Arena(0) => probePrefixStorage!
        "take$(takeIndex)_find" -> materialize(probePrefixStorage!) => probePrefix
        Arena(0) => probeControlsStorage!
        "%take$(takeIndex)_controls" -> materialize(probeControlsStorage!) => probeControls
        Arena(0) => probeKeysStorage!
        "%take$(takeIndex)_keys" -> materialize(probeKeysStorage!) => probeKeys
        Arena(0) => probeCapacityStorage!
        "%take$(takeIndex)_capacity" -> materialize(probeCapacityStorage!) => probeCapacity
        Arena(0) => probeQueryStorage!
        "%take$(takeIndex)_query" -> materialize(probeQueryStorage!) => probeQuery
        Arena(0) => probeHashStorage!
        "%take$(takeIndex)_hash" -> materialize(probeHashStorage!) => probeHash
        Arena(0) => probeH2Storage!
        "%take$(takeIndex)_h2" -> materialize(probeH2Storage!) => probeH2
        DictionaryProbe {
            prefix: probePrefix
            controls: probeControls
            keys: probeKeys
            capacity: probeCapacity
            query: probeQuery
            hash: probeHash
            h2: probeH2
            keyTypeId: takeKeyTypeId!
            keySymbol: takeSource.typeModule
            valueTypeId: takeValueTypeId!
            valueSymbol: takeSource.typeSymbol
            entryLayout: takeEntryLayout
            existingOnly: false
            bounded: false
        } => takeProbe
        takeProbe -> emitDictionaryFindSlot(context, state)
        "  br i1 %take$(takeIndex)_find_found, label %take$(takeIndex)_hit, label %take$(takeIndex)_missing" -> println
        "take$(takeIndex)_missing:" -> println
        "  call void @llvm.trap()" -> println
        "  unreachable" -> println
        "take$(takeIndex)_hit:" -> println
        "  %take$(takeIndex)_find_index = add i64 %take$(takeIndex)_find_slot, 0" -> println
        "  %take$(takeIndex)_key_ptr = getelementptr " -> print
        takeEntryLayout -> writeDictionaryEntryStorageType
        ", ptr %take$(takeIndex)_keys, i64 %take$(takeIndex)_find_index" -> println
        "  %take$(takeIndex)_key = load " -> print
        takeKeyTypeId! >= 0 -> if { takeKeyTypeId! -> writeSemanticTypeId(context, state) } else { takeSource.typeModule -> llvmType(context, state) -> print }
        ", ptr %take$(takeIndex)_key_ptr, align " -> print
        takeKeyTypeId! >= 0 -> if { context.typeAligns[takeKeyTypeId!] -> writeDecimalLine } else { takeSource.typeModule -> legacyStorageAlign(context, state) -> writeDecimalLine }
        "  %take$(takeIndex)_value_ptr = getelementptr " -> print
        takeEntryLayout -> writeDictionaryEntryStorageType
        ", ptr %take$(takeIndex)_values, i64 %take$(takeIndex)_find_index" -> println
        "  %v$(takeIndex -> valueNameId(state))" -> print
        takeValueTypeId! >= 0 and context.types[takeValueTypeId!].kind == 12
            -> if { "_bounded_value" -> print }
        " = load " -> print
        takeValueTypeId! >= 0 -> if { takeValueTypeId! -> writeSemanticTypeId(context, state) } else { takeSource.typeSymbol -> llvmType(context, state) -> print }
        ", ptr %take$(takeIndex)_value_ptr, align " -> print
        takeValueTypeId! >= 0 -> if { context.typeAligns[takeValueTypeId!] -> writeDecimalLine } else { takeSource.typeSymbol -> legacyStorageAlign(context, state) -> writeDecimalLine }
        takeValueTypeId! >= 0 and context.types[takeValueTypeId!].kind == 12
            -> if {
                Arena(0) => takenPrefixStorage!
                "v$(takeIndex -> valueNameId(state))" -> materialize(takenPrefixStorage!) => takenPrefix
                takenPrefix -> emitStoredBoundedValueHandle(takeValueTypeId!, context, state)
            }
        takeKeyTypeId! >= 0 and (takeKeyTypeId! -> semanticTypeOwns(context, state))
            -> if {
                "  call void @sollang_drop_t$(takeKeyTypeId!)(" -> print
                takeKeyTypeId! -> writeSemanticTypeId(context, state)
                " %take$(takeIndex)_key)" -> println
            }
        "  %take$(takeIndex)_new_length = sub i64 %take$(takeIndex)_length, 1" -> println
        "  %take$(takeIndex)_rebuild_capacity = add i64 %take$(takeIndex)_capacity, 0" -> println
        "  %take$(takeIndex)_rebuild_old_capacity = add i64 %take$(takeIndex)_capacity, 0" -> println
        "  %take$(takeIndex)_rebuild_old_controls = getelementptr i8, ptr %take$(takeIndex)_controls, i64 0" -> println
        "  %take$(takeIndex)_rebuild_old_keys = getelementptr i8, ptr %take$(takeIndex)_keys, i64 0" -> println
        "  %take$(takeIndex)_rebuild_old_values = getelementptr i8, ptr %take$(takeIndex)_values, i64 0" -> println
        "take$(takeIndex)_rebuild" -> emitGrowableDictionaryAllocation("%take$(takeIndex)_rebuild_capacity", takeEntryLayout)
        "take$(takeIndex)_rebuild" -> emitDictionaryRehashEntries(takeEntryLayout, takeKeyTypeId!, takeValueTypeId!, takeSource.typeModule, takeSource.typeSymbol, takeKeyIsText!, takeKeyIsNominal, takeHashMethod!, takeHashWidth, takeHashSigned!, "%take$(takeIndex)_find_index", context, state)
        "  call void @sollang_free(ptr %take$(takeIndex)_storage)" -> println
        "take$(takeIndex)_result" -> emitGrowableDictionaryOwner("%take$(takeIndex)_rebuild_storage", "%take$(takeIndex)_new_length", "%take$(takeIndex)_capacity")
        "  store %sollang.int_dictionary %take$(takeIndex)_result, ptr " -> print
        takeStructMember -> if {
            "%callref$(takeIndex)_arg0_place$(takeDictionaryMemberDepth! - 1)" -> print
        } else {
            takeBorrowOrdinal >= 0 -> if { takeBorrowOrdinal -> writeMutableStructParameterPointer } else { "%slot$(takeRoot)" -> print }
        }
        ", align 8" -> println
    } else {
        # As with push, a container field of a mutable struct parameter uses
        # the projected member place, not the direct mutable-container ABI.
        takeBorrowOrdinal >= 0 and not takeStructMember
            -> if {
                "  %take$(takeIndex)_data = load ptr, ptr " -> print
                takeBorrowOrdinal == 0 -> if { "%arg_mut_ptr_addr" -> print } else { "%arg$(takeBorrowOrdinal)_mut_ptr_addr" -> print }
                ", align 8" -> println
                "  %take$(takeIndex)_length = load i64, ptr " -> print
                takeBorrowOrdinal == 0 -> if { "%arg_mut_len_addr" -> print } else { "%arg$(takeBorrowOrdinal)_mut_len_addr" -> print }
                ", align 8" -> println
                "  %take$(takeIndex)_capacity = load i64, ptr " -> print
                takeBorrowOrdinal == 0 -> if { "%arg_mut_capacity_addr" -> print } else { "%arg$(takeBorrowOrdinal)_mut_capacity_addr" -> print }
                ", align 8" -> println
            } else {
                "  %take$(takeIndex)_data = extractvalue %sollang.array.i32 %v$(takeNode.operand0 -> valueNameId(state)), 0" -> println
                "  %take$(takeIndex)_length = extractvalue %sollang.array.i32 %v$(takeNode.operand0 -> valueNameId(state)), 1" -> println
                "  %take$(takeIndex)_capacity = extractvalue %sollang.array.i32 %v$(takeNode.operand0 -> valueNameId(state)), 2" -> println
            }
        takeArgument -> integerNodeWidth(context, state) => takeArgumentWidth
        takeArgument.kind != 3 and takeArgumentWidth > 0 and takeArgumentWidth < 64
            -> if {
                "  %take$(takeIndex)_index = " -> print
                takeArgument -> integerNodeSigned(context, state)
                    -> if { "sext " -> print } else { "zext " -> print }
                takeArgument -> writeIrType(context, state)
                " %v$(takeArgumentIndex -> valueNameId(state)) to i64" -> println
            }
        "  %take$(takeIndex)_in_bounds = icmp ult i64 " -> print
        takeArgument.kind == 3 -> if {
            takeArgument -> writeIntegerLiteral(context, state)
        } else {
            takeArgumentWidth > 0 and takeArgumentWidth < 64
                -> if { "%take$(takeIndex)_index" -> print } else { "%v$(takeArgumentIndex -> valueNameId(state))" -> print }
        }
        ", %take$(takeIndex)_length" -> println
        "  br i1 %take$(takeIndex)_in_bounds, label %take$(takeIndex)_ready, label %take$(takeIndex)_missing" -> println
        "take$(takeIndex)_missing:" -> println
        "  call void @llvm.trap()" -> println
        "  unreachable" -> println
        "take$(takeIndex)_ready:" -> println
        "  %take$(takeIndex)_selected = add i64 0, " -> print
        takeArgument.kind == 3 -> if {
            takeArgument -> writeIntegerLiteral(context, state)
            "" -> println
        } else {
            takeArgumentWidth > 0 and takeArgumentWidth < 64
                -> if { "%take$(takeIndex)_index" -> println } else { "%v$(takeArgumentIndex -> valueNameId(state))" -> println }
        }
        "  %take$(takeIndex)_value_ptr = getelementptr " -> print
        takeSource -> writeArrayElementType(context, state)
        ", ptr %take$(takeIndex)_data, i64 %take$(takeIndex)_selected" -> println
        "  " -> print
        takeIndex -> writeMemberStorageValueName(context, state)
        " = load " -> print
        takeSource -> writeArrayElementType(context, state)
        ", ptr %take$(takeIndex)_value_ptr, align " -> print
        takeSource -> arrayElementAlign(context, state) -> writeDecimalLine
        takeNode -> boundedArrayValueTypeId(context, state) => takeBoundedElementType
        "v$(takeIndex -> valueNameId(state))" -> emitStoredBoundedValueHandle(takeBoundedElementType, context, state)
        "  %take$(takeIndex)_new_length = sub i64 %take$(takeIndex)_length, 1" -> println
        "  br label %take$(takeIndex)_shift" -> println
        "take$(takeIndex)_shift:" -> println
        "  %take$(takeIndex)_shift_index = phi i64 [ %take$(takeIndex)_selected, %take$(takeIndex)_ready ], [ %take$(takeIndex)_shift_next, %take$(takeIndex)_shift_body ]" -> println
        "  %take$(takeIndex)_shift_active = icmp ult i64 %take$(takeIndex)_shift_index, %take$(takeIndex)_new_length" -> println
        "  br i1 %take$(takeIndex)_shift_active, label %take$(takeIndex)_shift_body, label %take$(takeIndex)_done" -> println
        "take$(takeIndex)_shift_body:" -> println
        "  %take$(takeIndex)_shift_next = add i64 %take$(takeIndex)_shift_index, 1" -> println
        "  %take$(takeIndex)_source_ptr = getelementptr " -> print
        takeSource -> writeArrayElementType(context, state)
        ", ptr %take$(takeIndex)_data, i64 %take$(takeIndex)_shift_next" -> println
        "  %take$(takeIndex)_moved = load " -> print
        takeSource -> writeArrayElementType(context, state)
        ", ptr %take$(takeIndex)_source_ptr, align " -> print
        takeSource -> arrayElementAlign(context, state) -> writeDecimalLine
        "  %take$(takeIndex)_target_ptr = getelementptr " -> print
        takeSource -> writeArrayElementType(context, state)
        ", ptr %take$(takeIndex)_data, i64 %take$(takeIndex)_shift_index" -> println
        "  store " -> print
        takeSource -> writeArrayElementType(context, state)
        " %take$(takeIndex)_moved, ptr %take$(takeIndex)_target_ptr, align " -> print
        takeSource -> arrayElementAlign(context, state) -> writeDecimalLine
        "  br label %take$(takeIndex)_shift" -> println
        "take$(takeIndex)_done:" -> println
        "  %take$(takeIndex)_array0 = insertvalue %sollang.array.i32 poison, ptr %take$(takeIndex)_data, 0" -> println
        "  %take$(takeIndex)_array1 = insertvalue %sollang.array.i32 %take$(takeIndex)_array0, i64 %take$(takeIndex)_new_length, 1" -> println
        "  %take$(takeIndex)_array2 = insertvalue %sollang.array.i32 %take$(takeIndex)_array1, i64 %take$(takeIndex)_capacity, 2" -> println
        takeBorrowOrdinal >= 0 and not takeStructMember
            -> if {
                "  store ptr %take$(takeIndex)_data, ptr " -> print
                takeBorrowOrdinal == 0 -> if { "%arg_mut_ptr_addr" -> print } else { "%arg$(takeBorrowOrdinal)_mut_ptr_addr" -> print }
                ", align 8" -> println
                "  store i64 %take$(takeIndex)_new_length, ptr " -> print
                takeBorrowOrdinal == 0 -> if { "%arg_mut_len_addr" -> print } else { "%arg$(takeBorrowOrdinal)_mut_len_addr" -> print }
                ", align 8" -> println
                "  store i64 %take$(takeIndex)_capacity, ptr " -> print
                takeBorrowOrdinal == 0 -> if { "%arg_mut_capacity_addr" -> print } else { "%arg$(takeBorrowOrdinal)_mut_capacity_addr" -> print }
                ", align 8" -> println
            } else {
                takeStructMember -> if {
                    takeNode.operand0 -> emitMutableReferenceMemberPlace(
                    takePlaceRoot,
                    takeIndex,
                    0,
                    request.ownerIndex,
                    false,
                    context,
                    state) => takeMemberDepth
                    "  store %sollang.array.i32 %take$(takeIndex)_array2, ptr %callref$(takeIndex)_arg0_place" -> print
                    takeMemberDepth - 1 -> writeDecimal
                    ", align 8" -> println
                } else {
                    "  store %sollang.array.i32 %take$(takeIndex)_array2, ptr %slot$(takeRoot), align 8" -> println
                }
            }
    }
}
