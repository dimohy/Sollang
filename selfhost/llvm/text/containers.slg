                            valueNode.operand1 -> regionResultValueIndex(context, state) => whileThenStoreIndex
                            valueNode -> emitIfResultStore(whileThenStoreIndex, ownerIndex, valueNodeIndex, 0, context, state)
                            "  br label %if$(valueNodeIndex)_merge" -> println
                            "if$(valueNodeIndex)_else:" -> println
                            valueNode.nextOperand -> emitRegion(context, state)
                            valueNode.nextOperand -> regionResultValueIndex(context, state) => whileElseStoreIndex
                            valueNode -> emitIfResultStore(whileElseStoreIndex, ownerIndex, valueNodeIndex, 1, context, state)
                            "  br label %if$(valueNodeIndex)_merge" -> println
                            "if$(valueNodeIndex)_merge:" -> println
                            "  %while$(whileIndex)_v$(valueNodeIndex) = load " -> print
                            valueNode -> writeIrType(context, state)
                            ", ptr %if$(valueNodeIndex)_result, align " -> print
                            valueNode -> storageAlign(context, state) -> writeDecimalLine
                        }
                        (valueNode.kind == 8 and (valueNode.operand0 < 0 or valueNode.operand1 < 0)) -> if {
                            "; invalid while binary ir=$(valueNodeIndex) op0=$(valueNode.operand0) op1=$(valueNode.operand1) opcode=$(valueNode.opcode)" -> println
                        }
                        ((valueNode.kind == 7 and valueNode.operand0 >= 0) or (valueNode.kind == 8 and valueNode.operand0 >= 0 and valueNode.operand1 >= 0)) -> if {
                            context.ir[valueNode.operand0] => left
                            0 => whileBinaryWidth!
                            false => whileLeftPromoted!
                            false => whileRightPromoted!
