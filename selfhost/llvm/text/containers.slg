emitWhileCallArgumentChain argumentIndex: Int, callIndex: Int, whileIndex: Int, ownerIndex: Int, ordinal: Int, separator: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    (argumentIndex >= 0 and context.ir[argumentIndex].parent == callIndex) -> if {
        separator -> if { ", " -> print }
        argumentIndex -> aggregateValueIndex(context, state) => argumentValueIndex
        context.ir[argumentValueIndex] => argument
        callIndex -> callTargetParameter(ordinal, context, state) => argumentParameterIndex
        false => argumentNeedsReferenceSlot!
        argumentParameterIndex >= 0 -> if {
            context.ir[argumentParameterIndex] => argumentParameter
            (argumentParameter.typeId >= 0 and context.types[argumentParameter.typeId].kind == 8 and not (argument.typeId >= 0 and context.types[argument.typeId].kind == 8)) -> if { true => argumentNeedsReferenceSlot! }
        }
        argumentNeedsReferenceSlot! -> if {
            argumentValueIndex -> aggregateValueIndex(context, state) => referenceValueIndex
            referenceValueIndex -> referencePlaceRootBinding(context, state) => referenceValueRoot
            false => referenceValueUsesMutableSlot!
            referenceValueRoot >= 0 -> if {
                context.ir[referenceValueRoot].flags == 1 -> if { true => referenceValueUsesMutableSlot! }
            }
            referenceValueUsesMutableSlot! -> if {
                referenceValueRoot -> mutableBindingRoot(context, state) => referenceMutableRoot
                referenceValueIndex -> referencePlaceAddressDepth(context, state) => referenceValueProjectionDepth
                referenceValueProjectionDepth > 0 -> if {
                    "ptr %callref$(callIndex)_arg$(ordinal)" -> print
                    "_place" -> print
                    referenceValueProjectionDepth - 1 -> writeDecimal
                } else {
                    "ptr %slot$(referenceMutableRoot)" -> print
                }
            } else {
                "ptr %callref$(callIndex)_arg$(ordinal)" -> print
            }
        } else {
            argumentParameterIndex >= 0 -> if {
                context.ir[argumentParameterIndex] -> writeIrType(context, state)
            } else {
                argument -> writeIrType(context, state)
            }
            " " -> print
            WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: argumentValueIndex } -> writeWhileValue(context, state)
        }
        argument.nextOperand -> emitWhileCallArgumentChain(callIndex, whileIndex, ownerIndex, ordinal + 1, true, context, state)
    }
}
