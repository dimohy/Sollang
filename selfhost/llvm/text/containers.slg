                                }
                            }
                        }
                        ((valueNode.kind == 9 or valueNode.kind == 6) and valueNode.opcode == -202 and valueNode.operand0 >= 0 and valueNode.operand1 >= 0) -> if {
                            context.ir[valueNode.operand0] => whileByteBase
                            valueNode.operand1 -> aggregateValueIndex(context, state) => whileByteIndexValue
                            context.ir[whileByteIndexValue] => whileByteIndex
                            whileByteIndex -> integerNodeWidth(context, state) => whileByteIndexWidth
                            "  %while$(whileIndex)_v$(valueNodeIndex)_base = extractvalue " -> print
                            whileByteBase -> writeTextLikeType
                            " " -> print
                            WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand0 } -> writeWhileValue(context, state)
                            ", 0" -> println
                            (whileByteIndexWidth > 0 and whileByteIndexWidth < 64) -> if {
                                "  %while$(whileIndex)_v$(valueNodeIndex)_index = " -> print
                                whileByteIndex -> integerNodeSigned(context, state) -> if { "sext" -> print } else { "zext" -> print }
                                " i$(whileByteIndexWidth) " -> print
