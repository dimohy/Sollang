emitWhileCallArgumentChain argumentIndex: Int, callIndex: Int, whileIndex: Int, ownerIndex: Int, ordinal: Int, separator: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    (argumentIndex >= 0 and context.ir[argumentIndex].parent == callIndex) -> if {
        separator -> if { ", " -> print }
        argumentIndex -> aggregateValueIndex(context, state) => argumentValueIndex
