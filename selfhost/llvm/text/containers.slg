                                valueNode.opcode == -25 -> if { "and" -> print }
                            }
                            " " -> print
                            whileBinaryWidth! > 0 -> if { "i$(whileBinaryWidth!)" -> print } else { left -> writeIrType(context, state) }
                            " " -> print
                            valueNode.kind == 7 -> if {
                                valueNode.opcode == -26 -> if {
                                    WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand0 } -> writeWhileValue(context, state)
