            "put$(putIndex)_insert_in_place:" -> println
            "  %put$(putIndex)_insert_in_place_key_ptr = getelementptr " -> print
            putEntryLayout -> writeDictionaryEntryStorageType
            ", ptr %put$(putIndex)_old_keys, i64 %put$(putIndex)_new_key_slot" -> println
            "  store " -> print
            putKeyTypeId! >= 0 -> if { putKeyTypeId! -> writeSemanticTypeId(context, state) } else { putSource.typeModule -> llvmType(context, state) -> print }
            " " -> print
            putKeyIndex -> writeValue(request.ownerIndex, context, state)
            ", ptr %put$(putIndex)_insert_in_place_key_ptr, align " -> print
            putKeyTypeId! >= 0 -> if { context.typeAligns[putKeyTypeId!] -> writeDecimalLine } else { putSource.typeModule -> legacyStorageAlign(context, state) -> writeDecimalLine }
            "  %put$(putIndex)_insert_in_place_value_ptr = getelementptr " -> print
            putEntryLayout -> writeDictionaryEntryStorageType
            ", ptr %put$(putIndex)_old_values, i64 %put$(putIndex)_new_key_slot" -> println
            "  store " -> print
            putValueTypeId! >= 0 -> if { putValueTypeId! -> writeSemanticTypeId(context, state) } else { putSource.typeSymbol -> llvmType(context, state) -> print }
            " " -> print
            putIndex -> writeDictionaryPutStoredValue(putValueIndex, request.ownerIndex, putValueTypeId!, context, state)
            ", ptr %put$(putIndex)_insert_in_place_value_ptr, align " -> print
            putValueTypeId! >= 0 -> if { context.typeAligns[putValueTypeId!] -> writeDecimalLine } else { putSource.typeSymbol -> legacyStorageAlign(context, state) -> writeDecimalLine }
            "  %put$(putIndex)_insert_in_place_control_ptr = getelementptr i8, ptr %put$(putIndex)_old_controls, i64 %put$(putIndex)_new_key_slot" -> println
            "put$(putIndex)_insert_control" -> emitDictionaryControlStore("%put$(putIndex)_old_controls", "%put$(putIndex)_new_key_slot", "%put$(putIndex)_h2", "%put$(putIndex)_old_capacity")
