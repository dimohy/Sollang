                "%put$(putIndex)_probe_query" -> materialize(grownProbeQueryStorage!) => grownProbeQuery
                Arena(0) => grownProbeHashStorage!
                "%put$(putIndex)_hash" -> materialize(grownProbeHashStorage!) => grownProbeHash
                Arena(0) => grownProbeH2Storage!
                "%put$(putIndex)_h2" -> materialize(grownProbeH2Storage!) => grownProbeH2
                DictionaryProbe {
                    prefix: grownProbePrefix
                    controls: grownProbeControls
                    keys: grownProbeKeys
                    capacity: grownProbeCapacity
