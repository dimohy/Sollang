                            " " -> print
                            whileSliceBaseReference! -> if { "%while$(whileIndex)_v$(valueNodeIndex)_base_source" -> print } else {
                                WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand0 } -> writeWhileValue(context, state)
                            }
                            ", 0" -> println
                            (whileSliceIndexWidth > 0 and whileSliceIndexWidth < 64) -> if {
                                "  %while$(whileIndex)_v$(valueNodeIndex)_index = " -> print
                                whileSliceIndex -> integerNodeSigned(context, state) -> if { "sext" -> print } else { "zext" -> print }
                                " i$(whileSliceIndexWidth) " -> print
