                }
                "  br i1 " -> print
                WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: boolNodeIndex! } -> writeWhileValue(context, state)
                ", label %" -> print
                boolTask.trueKind == 0 -> if { "while$(whileIndex)_body" -> print }
                boolTask.trueKind == 1 -> if { "while$(whileIndex)_exit" -> print }
                boolTask.trueKind == 2 -> if { "while$(whileIndex)_bool$(boolTask.trueNode)_rhs" -> print }
                ", label %" -> print
                boolTask.falseKind == 0 -> if { "while$(whileIndex)_body" -> print }
                boolTask.falseKind == 1 -> if { "while$(whileIndex)_exit" -> print }
                boolTask.falseKind == 2 -> if { "while$(whileIndex)_bool$(boolTask.falseNode)_rhs" -> print }
                "" -> println
            }
            }
        }
    }
}
writeCleanupName edgeIndex: Int, bindingIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    "%cleanup" -> print
    edgeIndex -> writeDecimal
    "_b" -> print
    bindingIndex -> writeDecimal
}
producerPipelineConsumesBinding bindingIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => consumed!
    0 => pipelineIndex!
    (pipelineIndex! < (context.streamPlan.pipelines -> len) and not consumed!) -> while {
        context.streamPlan.pipelines[pipelineIndex!] => pipeline
        pipeline.status > 0 -> if {
            pipeline.source0 == bindingIndex -> if { true => consumed! }
            (pipeline.source0 >= 0 and pipeline.source0 < (context.ir -> len)) -> if {
                context.ir[pipeline.source0] => source
                (source.kind == 5 and source.operand0 == bindingIndex) -> if { true => consumed! }
                (context.ir[bindingIndex].operand0 >= 0 and pipeline.source0 == context.ir[bindingIndex].operand0) -> if { true => consumed! }
            }
        }
        pipelineIndex! + 1 => pipelineIndex!
    }
    consumed!
}
emitOwnedDrops request: OwnedDropRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.pointerBitWidth / 8 => ownedPointerAlignment
    context.ir[request.regionIndex] => dropRegion
    UIntSize(0) => dropBeforeStart!
    request.beforeAst >= 0 -> if { context.nodes[context.ranges[dropRegion.sourceModule].astStart + request.beforeAst].start => dropBeforeStart! }
    request.regionIndex => ownedDropOwner!
    (ownedDropOwner! >= 0 and context.ir[ownedDropOwner!].kind != 0 and context.ir[ownedDropOwner!].kind != 11) -> while {
        context.ir[ownedDropOwner!].parent => ownedDropOwner!
    }
    ownedDropOwner! + 1 => ownedDropStart
    ownedDropOwner! -> functionEnd(context, state) => ownedDropIndex!
    ownedDropIndex! > ownedDropStart -> while {
        ownedDropIndex! - 1 => ownedDropIndex!
        context.ir[ownedDropIndex!] => ownedDropCandidate
        true => ownedDropBeforeEdge!
        request.beforeAst >= 0 -> if {
            (ownedDropCandidate -> sourceStart(context, state)) >= dropBeforeStart! -> if { false => ownedDropBeforeEdge! }
        }
        false => ownedDropMoved!
        state.frozenEnumMatchConsumed -> ownershipEmitter.enumMatchConsumes(ownedDropIndex!, ownedDropCandidate.kind, ownedDropCandidate.operand0) -> if { true => ownedDropMoved! }
        false => ownedDropHasPartialMoves!
        true => ownedDropIsRoot!
        ownedDropIndex! => ownedDropRoot!
        (ownedDropCandidate.kind == 17 and ownedDropCandidate.parent == request.regionIndex and ((ownedDropCandidate -> ownsType) or (ownedDropCandidate.typeId >= 0 and (ownedDropCandidate.typeId -> semanticTypeOwns(context, state))))) -> if {
            ownedDropIndex! -> mutableBindingRoot(context, state) => ownedDropRoot!
            ownedDropRoot! != ownedDropIndex! -> if { false => ownedDropIsRoot! }
        }
        (ownedDropCandidate.kind == 17 and ((ownedDropCandidate -> ownsType) or (ownedDropCandidate.typeId >= 0 and (ownedDropCandidate.typeId -> semanticTypeOwns(context, state))))) -> if {
            ownedDropIndex! -> producerPipelineConsumesBinding(context, state) -> if { true => ownedDropMoved! }
            0 => ownedMoveIndex!
            (ownedMoveIndex! < (context.moves -> len) and not ownedDropMoved!) -> while {
                context.moves[ownedMoveIndex!] => ownedMove
                (ownedMove.memberIr >= 0 and ownedMove.sourceModule == ownedDropCandidate.sourceModule and ownedMove.symbol == ownedDropCandidate.symbol and (ownedMoveIndex! -> partialMoveActiveBefore(request.regionIndex, request.beforeAst, context, state))) -> if { true => ownedDropHasPartialMoves! }
                (ownedMove.memberIr < 0 and ownedMove.sourceModule == ownedDropCandidate.sourceModule and ownedMove.symbol == ownedDropCandidate.symbol and ownedMove.regionIr == request.regionIndex) -> if {
                    context.ir[ownedMove.siteIr] => ownedMoveCall
                    true => ownedMoveBeforeEdge!
                    request.beforeAst >= 0 -> if {
                        (ownedMoveCall -> sourceStart(context, state)) >= dropBeforeStart! -> if { false => ownedMoveBeforeEdge! }
                    }
                    ((ownedMoveCall -> sourceStart(context, state)) > (ownedDropCandidate -> sourceStart(context, state)) and ownedMoveBeforeEdge!) -> if { true => ownedDropMoved! }
                }
                ownedMoveIndex! + 1 => ownedMoveIndex!
            }
            ownedDropStart => ownedPutMoveIndex!
            ownedDropOwner! -> functionEnd(context, state) => ownedPutMoveEnd
            (ownedPutMoveIndex! < ownedPutMoveEnd and not ownedDropMoved!) -> while {
                context.ir[ownedPutMoveIndex!] => ownedPutMove
                (ownedPutMove.kind == 9 and ownedPutMove.opcode == -223 and ownedPutMove.operand1 >= 0 and ownedPutMove.operand1 < (context.ir -> len)) -> if {
                    context.ir[ownedPutMove.operand1] => ownedPutMoveKey
                    (ownedPutMoveKey.kind == 5 and ownedPutMoveKey.operand0 >= 0 and ownedPutMoveKey.operand0 < (context.ir -> len)) -> if {
                        ownedPutMoveKey.operand0 -> mutableBindingRoot(context, state) => ownedPutMoveKeyRoot
                        true => ownedPutKeyBeforeEdge!
                        request.beforeAst >= 0 -> if {
                            (ownedPutMove -> sourceStart(context, state)) >= dropBeforeStart! -> if { false => ownedPutKeyBeforeEdge! }
                        }
                        (ownedPutMoveKeyRoot == ownedDropRoot! and (ownedPutMove -> sourceStart(context, state)) > (ownedDropCandidate -> sourceStart(context, state)) and ownedPutKeyBeforeEdge!) -> if {
                            true => ownedDropMoved!
                        }
                    }
                    ownedPutMoveKey.nextOperand => ownedPutMoveValueIndex
                    (ownedPutMoveValueIndex >= 0 and ownedPutMoveValueIndex < (context.ir -> len)) -> if {
                        context.ir[ownedPutMoveValueIndex] => ownedPutMoveValue
                        (ownedPutMoveValue.kind == 5 and ownedPutMoveValue.operand0 >= 0 and ownedPutMoveValue.operand0 < (context.ir -> len)) -> if {
                            ownedPutMoveValue.operand0 -> mutableBindingRoot(context, state) => ownedPutMoveRoot
                            true => ownedPutMoveBeforeEdge!
                            request.beforeAst >= 0 -> if {
                                (ownedPutMove -> sourceStart(context, state)) >= dropBeforeStart! -> if { false => ownedPutMoveBeforeEdge! }
                            }
                            (ownedPutMoveRoot == ownedDropRoot! and (ownedPutMove -> sourceStart(context, state)) > (ownedDropCandidate -> sourceStart(context, state)) and ownedPutMoveBeforeEdge!) -> if {
                                true => ownedDropMoved!
                            }
                        }
                    }
                }
                ownedPutMoveIndex! + 1 => ownedPutMoveIndex!
            }
        }
        ownedDropIndex! => cleanupBindingIndex
        (ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved! and not ownedDropHasPartialMoves! and ownedDropCandidate.kind == 17 and ownedDropCandidate.parent == request.regionIndex and ownedDropCandidate.typeId >= 0 and (ownedDropCandidate.typeId -> semanticTypeOwns(context, state)) and ownedDropCandidate.symbol != request.transferredSymbol) -> if {
            ownedDropCandidate.flags == 1 -> if {
                "  " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_current = load " -> print
                ownedDropCandidate.typeId -> writeSemanticTypeId(context, state)
                ", ptr %slot$(ownedDropRoot!), align " -> print
                ownedDropCandidate -> storageAlign(context, state) -> writeDecimalLine
            }
            "  call void @sollang_drop_t$(ownedDropCandidate.typeId)(" -> print
            ownedDropCandidate.typeId -> writeSemanticTypeId(context, state)
            " " -> print
            ownedDropCandidate.flags == 1 -> if {
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_current" -> print
            } else { "%v$(ownedDropCandidate.operand0)" -> print }
            ")" -> println
        }
        (ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved! and ownedDropCandidate.kind == 17 and ownedDropCandidate.parent == request.regionIndex and ownedDropCandidate.typeId < 0 and (ownedDropCandidate -> isDynamicArrayType) and ownedDropCandidate.symbol != request.transferredSymbol) -> if {
            ownedDropCandidate.flags == 1 -> if {
                "  " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_current = load %sollang.array.i32, ptr %slot$(ownedDropRoot!), align " -> print
                ownedDropCandidate -> storageAlign(context, state) -> writeDecimalLine
                "  " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                " = extractvalue %sollang.array.i32 " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_current, 0" -> println
            } else {
                "  " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                " = extractvalue %sollang.array.i32 %v$(ownedDropCandidate.operand0), 0" -> println
            }
            "  call void @free(ptr " -> print
            request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
            ")" -> println
        }
        (ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved! and ownedDropCandidate.kind == 17 and ownedDropCandidate.parent == request.regionIndex and ownedDropCandidate.typeId < 0 and (ownedDropCandidate -> isDictionaryType) and ownedDropCandidate.symbol != request.transferredSymbol) -> if {
            ownedDropCandidate.flags == 1 -> if {
                "  " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_current = load %sollang.dict, ptr %slot$(ownedDropRoot!), align " -> print
                ownedDropCandidate -> storageAlign(context, state) -> writeDecimalLine
                "  " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_keys = extractvalue %sollang.dict " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_current, 0" -> println
            } else {
                "  " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_keys = extractvalue %sollang.dict %v$(ownedDropCandidate.operand0), 0" -> println
            }
            "  call void @free(ptr " -> print
            request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
            "_keys)" -> println
            ownedDropCandidate.flags == 1 -> if {
                "  " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_values = extractvalue %sollang.dict " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_current, 1" -> println
            } else {
                "  " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_values = extractvalue %sollang.dict %v$(ownedDropCandidate.operand0), 1" -> println
            }
            "  call void @free(ptr " -> print
            request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
            "_values)" -> println
        }
        (ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved! and ownedDropCandidate.kind == 17 and ownedDropCandidate.parent == request.regionIndex and ownedDropCandidate.typeId < 0 and ownedDropCandidate.typeOrigin == 16 and ownedDropCandidate.symbol != request.transferredSymbol) -> if {
            ownedDropCandidate.flags == 1 -> if {
                "  " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_current = load %sollang.dyn, ptr %slot$(ownedDropRoot!), align $ownedPointerAlignment" -> println
                "  " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_data = extractvalue %sollang.dyn " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_current, 0" -> println
                "  " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_vtable = extractvalue %sollang.dyn " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_current, 1" -> println
            } else {
                "  " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_data = extractvalue %sollang.dyn %v$(ownedDropCandidate.operand0), 0" -> println
                "  " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_vtable = extractvalue %sollang.dyn %v$(ownedDropCandidate.operand0), 1" -> println
            }
            "  " -> print
            request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
            "_drop_slot = getelementptr ptr, ptr " -> print
            request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
            "_vtable, i64 0" -> println
            "  " -> print
            request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
            "_drop = load ptr, ptr " -> print
            request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
            "_drop_slot, align $ownedPointerAlignment" -> println
            "  call void " -> print
            request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
            "_drop(ptr " -> print
            request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
            "_data)" -> println
        }
        (ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved! and ownedDropCandidate.kind == 17 and ownedDropCandidate.parent == request.regionIndex and (ownedDropCandidate.typeId < 0 or ownedDropHasPartialMoves!) and (ownedDropCandidate -> isGenericEnumType) and ownedDropCandidate.symbol != request.transferredSymbol) -> if {
            0 => ownedEnumValueKind!
            ownedDropCandidate.flags == 1 -> if { 2 => ownedEnumValueKind! }
            EnumDropRequest {
                typeId: ownedDropCandidate.typeId
                valueKind: ownedEnumValueKind!
                valueIndex: ownedDropCandidate.flags == 1 -> if { ownedDropRoot! } else { ownedDropCandidate.operand0 }
                nameRoot: request.edgeIndex * 1000 + ownedDropIndex!
                bindingIndex: ownedDropIndex!
                regionIndex: request.regionIndex
            } -> emitEnumDrop(context, state)
        }
        (ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved! and ownedDropCandidate.kind == 17 and ownedDropCandidate.parent == request.regionIndex and (ownedDropCandidate.typeId < 0 or ownedDropHasPartialMoves!) and (ownedDropCandidate -> isNominalStructType) and ownedDropCandidate.symbol != request.transferredSymbol) -> if {
            request.edgeIndex * 1000 + ownedDropIndex! => ownedDropNameRoot
            ownedDropCandidate.flags == 1 -> if {
                "  %dropg$(ownedDropNameRoot)_p0 = load %sollang.struct.m$(ownedDropCandidate.typeModule)_s$(ownedDropCandidate.typeSymbol), ptr %slot$(ownedDropRoot!), align " -> print
                ownedDropCandidate -> storageAlign(context, state) -> writeDecimalLine
            }
            0 => ownedDropValueKind!
            ownedDropCandidate.flags == 1 -> if { 2 => ownedDropValueKind! }
        DropGlueRequest {
            typeId: ownedDropCandidate.typeId
            typeOrigin: ownedDropCandidate.typeOrigin
                typeModule: ownedDropCandidate.typeModule
                typeSymbol: ownedDropCandidate.typeSymbol
                valueKind: ownedDropValueKind!
                valueIndex: ownedDropCandidate.operand0
                nameRoot: ownedDropNameRoot
                pathCode: 0
                bindingIndex: ownedDropIndex!
                regionIndex: request.regionIndex
                beforeAst: request.beforeAst
                parentTask: -1
                fieldOrdinal: -1
                hasPartialMoves: ownedDropHasPartialMoves!
            } -> emitDropGlue(context, state)
        }
    }
}
