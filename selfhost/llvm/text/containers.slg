                        valueNode.kind == 6 -> if {
                            (valueNode.targetModule < 0 and valueNode.typeOrigin == 1 and (valueNode.typeSymbol -> integerWidth(context, state)) > 0 and valueNode.operand0 >= 0) -> if {
                                context.ir[valueNode.operand0] => whileIntegerArgument
                                valueNode -> integerNodeWidth(context, state) => whileTargetWidth
                                whileIntegerArgument -> integerNodeWidth(context, state) => whileInputWidth
