# Build the by-value dependency graph once. Pointer-backed containers terminate
# layout dependencies even when their element recursively names the owner.
valueLayoutCycles types: ref [typeIds.SemanticType; ~], fields: ref [typeIds.NominalField; ~], references: ref [typeIds.TypeReference; ~], ranges: ref [analysis.SourceAnalysisRange; ~], declarations: ref [symbols.Symbol; ~], referenceByAst: ref [Int; ~] -> [Bool; ~] {
    [Int; ~] => heads!
    [Int; ~] => pending!
    [Int; ~] => owners!
    [Int; ~] => next!
    [Bool; ~] => cyclic!
    types -> each current {
        heads! -> push(-1)
        pending! -> push(0)
        cyclic! -> push(false)
    }
    # Source ranges already assign disjoint symbol offsets. Reuse that identity
    # instead of packing module/symbol pairs or comparing every nominal field.
    [Int; ~] => canonicalBySymbol!
    [Int; ~] => firstVariant!
    [Int; ~] => nextVariant!
    declarations -> each declaration {
        canonicalBySymbol! -> push(-1)
        firstVariant! -> push(-1)
        nextVariant! -> push(-1)
    }
    [Int; ~] => canonicalByType!
    [Int; ~] => firstField!
    0 => typeIndex!
    typeIndex! < (types -> len) -> while {
        types[typeIndex!] => current
        typeIndex! => canonical!
        current.kind == 1 and (current.origin == 0 or current.origin == 2)
            and current.module >= 0 and current.module < (ranges -> len)
            -> if {
                ranges[current.module] => sourceRange
                current.symbol >= 0 and current.symbol < sourceRange.symbolCount
                    -> if {
                        sourceRange.symbolStart + current.symbol => symbolIndex
                        canonicalBySymbol![symbolIndex] < 0
                            -> if { typeIndex! => canonicalBySymbol![symbolIndex] }
                        canonicalBySymbol![symbolIndex] => canonical!
                    }
            }
        canonicalByType! -> push(canonical!)
        firstField! -> push(-1)
        typeIndex! + 1 => typeIndex!
    }
    [Int; ~] => nextField!
    0 => fieldIndex!
    fieldIndex! < (fields -> len) -> while {
        fields[fieldIndex!] => field
        nextField! -> push(-1)
        field.status == 0 and field.ownerType >= 0 and field.ownerType < (types -> len)
            and field.fieldType >= 0
            -> if {
                canonicalByType![field.ownerType] => owner
                firstField![owner] => nextField![fieldIndex!]
                fieldIndex! => firstField![owner]
            }
        fieldIndex! + 1 => fieldIndex!
    }
    ranges -> each sourceRange {
        0 => symbolIndex!
        symbolIndex! < sourceRange.symbolCount -> while {
            sourceRange.symbolStart + symbolIndex! => globalSymbol
            declarations[globalSymbol] => declaration
            declaration.kind == 27 and declaration.parent >= 0
                and declaration.parent < sourceRange.symbolCount
                -> if {
                    sourceRange.symbolStart + declaration.parent => parentSymbol
                    firstVariant![parentSymbol] => nextVariant![globalSymbol]
                    globalSymbol => firstVariant![parentSymbol]
                }
            symbolIndex! + 1 => symbolIndex!
        }
    }
    0 => owner!
    owner! < (types -> len) -> while {
        types[owner!] => current
        [Int; ~] => dependencies!
        canonicalByType![owner!] != owner! -> if {
            # Alias nodes share the declaration's complete by-value dependency set.
            dependencies! -> push(canonicalByType![owner!])
        } else {
            ((current.kind == 4 and current.length > 0) or current.kind == 12) and current.first >= 0
                -> if {
                    dependencies! -> push(current.first)
                }
            current.kind == 13 or (current.kind == 7 and current.origin == 4 and (current.symbol == 0 or current.symbol == 1))
                -> if {
                    current.first >= 0 -> if { dependencies! -> push(current.first) }
                    current.second >= 0 -> if { dependencies! -> push(current.second) }
                }
            current.kind == 1 or current.kind == 10 -> if {
                firstField![owner!] => fieldCursor!
                fieldCursor! >= 0 -> while {
                    dependencies! -> push(fields[fieldCursor!].fieldType)
                    nextField![fieldCursor!] => fieldCursor!
                }
            }
            current.kind == 1 and (current.origin == 0 or current.origin == 2)
                and current.module >= 0 and current.module < (ranges -> len)
                -> if {
                    ranges[current.module] => sourceRange
                    current.symbol >= 0 and current.symbol < sourceRange.symbolCount
                        -> if {
                            firstVariant![sourceRange.symbolStart + current.symbol] => variantIndex!
                            variantIndex! >= 0 -> while {
                                declarations[variantIndex!] => variant
                                variant.typeNode >= 0 -> if {
                                    referenceByAst[sourceRange.astStart + variant.typeNode] => referenceIndex
                                    referenceIndex >= 0 -> if {
                                        references[referenceIndex] => reference
                                        reference.status == 0 and reference.typeId >= 0
                                            -> if { dependencies! -> push(reference.typeId) }
                                    }
                                }
                                nextVariant![variantIndex!] => variantIndex!
                            }
                        }
                }
        }
        dependencies! -> each dependency {
            dependency >= 0 and dependency < (types -> len)
                -> if {
                    owners! -> push(owner!)
                    next! -> push(heads![dependency])
                    (owners! -> len) - 1 => heads![dependency]
                    pending![owner!] + 1 => pending![owner!]
                }
        }
        owner! + 1 => owner!
    }
    [Int; ~] => ready!
    0 => seed!
    seed! < (types -> len) -> while {
        pending![seed!] == 0 -> if { ready! -> push(seed!) }
        seed! + 1 => seed!
    }
    0 => cursor!
    cursor! < (ready! -> len) -> while {
        heads![ready![cursor!]] => edge!
        edge! >= 0 -> while {
            owners![edge!] => dependent
            pending![dependent] - 1 => pending![dependent]
            pending![dependent] == 0 -> if { ready! -> push(dependent) }
            next![edge!] => edge!
        }
        cursor! + 1 => cursor!
    }
    0 => resultIndex!
    resultIndex! < (types -> len) -> while {
        pending![resultIndex!] > 0 => cyclic![resultIndex!]
        resultIndex! + 1 => resultIndex!
    }
    cyclic!
}

lowerPreparedIr prepared: semanticContext.SemanticSnapshot, recursiveTypes: ref expressionTypeIds.ExpressionTypeIdSet, supportsComputePool: Bool -> [typedIr.TypedIrNode; ~] {
    supportsComputePool -> if {
        prepared -> typedIr.lowerResolvedContextParallel(recursiveTypes) => parallelIr
        parallelIr -> return
    }
    prepared -> typedIr.lowerResolvedContext(recursiveTypes) => sequentialIr
    sequentialIr
}

prepareSnapshot request: ref PrepareRequest, prepared: move semanticContext.SemanticSnapshot, libraries: move libraryImports.LibraryCatalog, libraryCalls: move [libraryImports.LibraryFunctionResolution; ~] -> emitterContext.EmitContext {
    request.pointerBitWidth => pointerBitWidth
    request.targetArchitecture => targetArchitecture
    request.cpuDispatchPolicy => cpuDispatchPolicy
    request.requiredCpuFeatures => requiredCpuFeatures
    request.allowedCpuFeatures => allowedCpuFeatures
    request.forbiddenCpuFeatures => forbiddenCpuFeatures
    request.supportsComputePool => supportsComputePool
    request.expectedPathStyle => expectedPathStyle
    prepared -> expressionTypeIds.resolveContext => recursiveTypes!
    prepared -> lowerPreparedIr(recursiveTypes!, supportsComputePool) => ir!
    ir! -> typedIr.materializeContextualArrayOwners(prepared, recursiveTypes!)
    ir! -> typedLibraryImports.projectLibraries(prepared, libraries, libraryCalls) => libraryCallDiagnostics
    ir! -> typedIr.planGenericCalls(prepared, recursiveTypes!.types) => genericCallPlans
    ir! -> typedIr.materializeGenericClosure(prepared, recursiveTypes!) => genericInstances
    ir! -> typedIr.bindGenericBodies(genericInstances) => genericBodies
    ir! -> typedIr.materializeContextualArrayOwners(prepared, recursiveTypes!)
    # Call discovery precedes final receiver typing. Build one compact global
    # AST index after generic closure convergence so every later diagnostic is O(1)
    # instead of rescanning the full IR for each preliminary call entry.
    [Bool; ~] => finalCallResolvedByAst!
    0 => finalCallAstInit!
    finalCallAstInit! < (prepared.package.nodes -> len)
        -> while {
            finalCallResolvedByAst! -> push(false)
            finalCallAstInit! + 1 => finalCallAstInit!
        }
    0 => finalCallIrIndex!
    finalCallIrIndex! < (ir! -> len)
        -> while {
            ir![finalCallIrIndex!] => finalCall
            (finalCall.kind == 6 or (finalCall.kind == 9 and finalCall.opcode != -1))
                and finalCall.sourceModule >= 0
                and finalCall.sourceModule < (prepared.package.ranges -> len)
                and finalCall.astNode >= 0
                and ((finalCall.symbol >= 0 and finalCall.targetModule >= 0)
                or finalCall.opcode != -1)
                -> if {
                    prepared.package.ranges[finalCall.sourceModule] => finalCallRange
                    finalCall.astNode < finalCallRange.astCount -> if {
                        true => finalCallResolvedByAst![finalCallRange.astStart + finalCall.astNode]
                    }
                }
            finalCallIrIndex! + 1 => finalCallIrIndex!
        }
    prepared -> streamIr.build(ir!, recursiveTypes!) => streamPlan
    false => usesConcurrentStreamJoins!
    0 => concurrentStreamJoinSearch!
    concurrentStreamJoinSearch! < (streamPlan.junctions -> len)
        -> while {
            streamPlan.junctions[concurrentStreamJoinSearch!] => concurrentStreamJoin
            concurrentStreamJoin.kind == 2 and (concurrentStreamJoin.policy == 1 or concurrentStreamJoin.policy == 3)
                -> if {
                    concurrentStreamJoin.inputStart => concurrentStreamInputSearch!
                    concurrentStreamInputSearch! < concurrentStreamJoin.inputStart + concurrentStreamJoin.inputCount
                        -> while {
                            streamPlan.junctionInputs[concurrentStreamInputSearch!].typeId => concurrentStreamInputTypeId
                            concurrentStreamInputTypeId >= 0 and concurrentStreamInputTypeId < (recursiveTypes!.types -> len)
                                -> if {
                                    recursiveTypes!.types[concurrentStreamInputTypeId] => concurrentStreamInputType
                                    concurrentStreamInputType.kind == 7 and concurrentStreamInputType.symbol == 4
                                        -> if { true => usesConcurrentStreamJoins! }
                                }
                            concurrentStreamInputSearch! + 1 => concurrentStreamInputSearch!
                        }
                }
            concurrentStreamJoinSearch! + 1 => concurrentStreamJoinSearch!
        }
    prepared -> ownershipCheck.analyzeResolvedLoweredContext(ir!, recursiveTypes!.types) => ownershipDiagnostics
    [typeIds.SemanticType; ~] => semanticTypes!
    [typeIds.TypeReference; ~] => signatureTypeReferences!
    recursiveTypes!.references -> each reference { signatureTypeReferences! -> push(reference) }
    [typeTerms.TypeTerm; ~] => signatureTypeTerms!
    prepared.package.terms -> each term { signatureTypeTerms! -> push(term) }
    0 => semanticTypeCopyIndex351!
    semanticTypeCopyIndex351! < (recursiveTypes!.types -> len)
        -> while {
            recursiveTypes!.types[semanticTypeCopyIndex351!] => semanticType
            semanticTypes! -> push(semanticType)
            semanticTypeCopyIndex351! + 1 => semanticTypeCopyIndex351!
        }

    [typeIds.NominalField; ~] => semanticFields!
    0 => semanticFieldCopyIndex353!
    semanticFieldCopyIndex353! < (recursiveTypes!.fields -> len)
        -> while {
            recursiveTypes!.fields[semanticFieldCopyIndex353!] => semanticField
            semanticFields! -> push(semanticField)
            semanticFieldCopyIndex353! + 1 => semanticFieldCopyIndex353!
        }
    [nominalTypes.NominalType; ~] => nominal!
    0 => nominalTypeCopyIndex355!
    nominalTypeCopyIndex355! < (prepared.nominal -> len)
        -> while {
            prepared.nominal[nominalTypeCopyIndex355!] => nominalType
            nominal! -> push(nominalType)
            nominalTypeCopyIndex355! + 1 => nominalTypeCopyIndex355!
        }
    [compositeTypes.CompositeType; ~] => composite!
    0 => compositeTypeCopyIndex357!
    compositeTypeCopyIndex357! < (prepared.composite -> len)
        -> while {
            prepared.composite[compositeTypeCopyIndex357!] => compositeType
            composite! -> push(compositeType)
            compositeTypeCopyIndex357! + 1 => compositeTypeCopyIndex357!
        }
    [modules.ModuleIdentity; ~] => moduleIdentities!
    0 => moduleIdentityCopyIndex359!
    moduleIdentityCopyIndex359! < (prepared.modules -> len)
        -> while {
            prepared.modules[moduleIdentityCopyIndex359!] => moduleIdentity
            moduleIdentities! -> push(moduleIdentity)
            moduleIdentityCopyIndex359! + 1 => moduleIdentityCopyIndex359!
        }
    [modules.ImportEdge; ~] => importEdges!
    0 => importEdgeCopyIndex!
    importEdgeCopyIndex! < (prepared.imports -> len)
        -> while {
