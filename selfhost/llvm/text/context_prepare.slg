    # Nominal enums share the same tagged payload ABI as Result/Option. The
    # recursive type arena represents their declaration identity as a nominal
    # type, so recover variant payload type uses from the flat AST before the
    # emitter freezes layout and ownership tables.
    [Bool; ~] => nominalEnumFlags!
    0 => nominalEnumFlagIndex!
    nominalEnumFlagIndex! < (semanticTypes! -> len)
        -> while {
            nominalEnumFlags! -> push(false)
            nominalEnumFlagIndex! + 1 => nominalEnumFlagIndex!
        }
