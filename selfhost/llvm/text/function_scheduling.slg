namespace sollang.compiler.llvm.text

import sollang.compiler.ir.typed as typedIr
import sollang.compiler.llvm.emitter.context as emitterContext

callHasDeclaredEffects node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => hasEffects!
    (node.kind == 6 and node.targetModule >= 0 and node.targetModule < (context.ranges -> len) and node.symbol >= 0)
        -> if {
        context.ranges[node.targetModule] => targetRange
        node.symbol < targetRange.symbolCount -> if {
            context.symbols[targetRange.symbolStart + node.symbol] => targetSymbol
            targetSymbol.astNode >= 0 -> if {
                context.nodes[targetRange.astStart + targetSymbol.astNode] => targetDeclaration
                targetDeclaration.firstToken => tokenIndex!
                tokenIndex! < targetDeclaration.firstToken + targetDeclaration.tokenCount
                    -> while {
                    context.tokens[targetRange.tokenStart + tokenIndex!] => token
                    (token.span.length == 4
                        and (context.sources[node.targetModule] -> byte(token.span.start)) == 117
                        and (context.sources[node.targetModule] -> byte(token.span.start + 1)) == 115
                        and (context.sources[node.targetModule] -> byte(token.span.start + 2)) == 101
                        and (context.sources[node.targetModule] -> byte(token.span.start + 3)) == 115)
                            -> if {
                        true => hasEffects!
                    }
                    tokenIndex! + 1 => tokenIndex!
                }
            }
        }
    }
    (node.kind == 6 and node.targetModule >= 0 and node.symbol >= 0 and not hasEffects!)
        -> if {
        0 => targetFunctionIndex!
        targetFunctionIndex! < (context.ir -> len) -> while {
            context.ir[targetFunctionIndex!] => targetFunction
            (targetFunction.kind == 0
                and targetFunction.sourceModule == node.targetModule
                and targetFunction.symbol == node.symbol) -> if {
                targetFunction.operand1 => targetParameterIndex!
                0 => targetParameterOrdinal!
                targetParameterIndex! >= 0 -> while {
                    context.ir[targetParameterIndex!] => targetParameter
                    targetParameter.flags / 2 % 2 == 1 -> if { true => hasEffects! }
                    targetParameterOrdinal! == 0 -> if {
                        targetFunction.nextOperand => targetParameterIndex!
                    } else {
                        targetParameter.nextOperand => targetParameterIndex!
                    }
                    targetParameterOrdinal! + 1 => targetParameterOrdinal!
                }
            }
            targetFunctionIndex! + 1 => targetFunctionIndex!
        }
    }
    hasEffects!
}
prepareFunctionExpressionOrder functionIndex: Int, functionEnd: Int, expressionStart: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> [Int; ~] uses Console {
    expressionStart => mutableSlotIndex!
    mutableSlotIndex! < functionEnd -> while {
        context.ir[mutableSlotIndex!] => mutableSlotCandidate
        (mutableSlotCandidate.kind == 17 and mutableSlotCandidate.flags == 1)
            -> if {
            mutableSlotIndex! -> mutableBindingRoot(context, state) => mutableSlotRoot
            mutableSlotRoot == mutableSlotIndex! -> if {
                "  %slot$(mutableSlotRoot) = alloca " -> print
                mutableSlotCandidate -> writeIrType(context, state)
                ", align " -> print
                mutableSlotCandidate -> storageAlign(context, state) -> writeDecimalLine
            }
        }
        mutableSlotIndex! + 1 => mutableSlotIndex!
    }
    [Bool; ~] => expressionScheduled!
    expressionStart => scheduledInit!
    scheduledInit! < functionEnd -> while {
        expressionScheduled! -> push(false)
        scheduledInit! + 1 => scheduledInit!
    }
    [Int; ~] => expressionOrder!
    true => scheduleProgress!
    scheduleProgress! -> while {
        false => scheduleProgress!
        -1 => pendingEach!
        Int(expressionOrder! -> len) - 1 => pendingEachOrderIndex!
        (pendingEachOrderIndex! >= 0 and pendingEach! < 0)
            -> while {
            expressionOrder![pendingEachOrderIndex!] => orderedEachCandidate
            context.ir[orderedEachCandidate] => orderedEachNode
            (orderedEachNode.kind == 6 and orderedEachNode.opcode == -208)
