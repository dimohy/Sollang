                            }
                            (not mutableReadInsideBarrier!
                                and not readsCurrentRebindPreviousValue!
                                and not expressionScheduled![mutableReadBarrierSearch! - expressionStart]
                                and (mutableReadBarrier.kind == 18
                                    or mutableReadBarrier.kind == 20
                                    or mutableReadBarrier.kind == 27
                                    or mutableReadBarrier.kind == 34
                                    or mutableReadBarrier.kind == 24
                                    or mutableReadBarrier.kind == 25
                                    or (mutableReadBarrier.kind == 6 and (mutableReadBarrierHasEffects or mutableReadBarrierMutatesBinding!))
                                    or (mutableReadBarrier.kind == 17 and mutableReadBarrier.flags == 1)
                                    or (mutableReadBarrier.kind == 9 and (mutableReadBarrier.opcode == -204 or mutableReadBarrier.opcode == -213 or mutableReadBarrier.opcode == -229 or mutableReadBarrier.opcode == -241 or mutableReadBarrier.opcode == -242 or mutableReadBarrier.opcode == -246 or mutableReadBarrier.opcode == -247 or mutableReadBarrier.opcode == -250 or mutableReadBarrier.opcode == -251 or (mutableReadBarrier.opcode <= -252 and mutableReadBarrier.opcode >= -257))))
                                and (mutableReadBarrier -> sourceStart(context, state)) < (scheduleNode -> sourceStart(context, state)))
                                    -> if {
                                false => scheduleReady!
                            }
                            mutableReadBarrierSearch! + 1 => mutableReadBarrierSearch!
                        }
                    }
                }
                (scheduleReady! and (scheduleNode.kind == 6 or scheduleNode.kind == 18 or scheduleNode.kind == 20 or scheduleNode.kind == 27 or scheduleNode.kind == 33 or scheduleNode.kind == 34 or scheduleNode.kind == 24 or scheduleNode.kind == 25 or (scheduleNode.kind == 17 and scheduleNode.flags == 1) or (scheduleNode.kind == 9 and (scheduleNode.opcode == -27 or scheduleNode.opcode == -204 or scheduleNode.opcode == -205 or scheduleNode.opcode == -213 or scheduleNode.opcode == -220 or scheduleNode.opcode == -221 or scheduleNode.opcode == -229 or scheduleNode.opcode == -241 or scheduleNode.opcode == -242 or scheduleNode.opcode == -246 or scheduleNode.opcode == -247 or scheduleNode.opcode == -250 or scheduleNode.opcode == -251 or scheduleNode.opcode == -252 or scheduleNode.opcode == -254 or scheduleNode.opcode == -255 or scheduleNode.opcode == -257))))
                    -> if {
                    true => rootEffect!
                    scheduleNode.parent => effectAncestor!
                    (effectAncestor! >= expressionStart and rootEffect!)
                        -> while {
                        ((context.ir[effectAncestor!].kind == 6 and context.ir[effectAncestor!].opcode != -208) or context.ir[effectAncestor!].kind == 18 or context.ir[effectAncestor!].kind == 20 or context.ir[effectAncestor!].kind == 27 or context.ir[effectAncestor!].kind == 34 or context.ir[effectAncestor!].kind == 24 or context.ir[effectAncestor!].kind == 25 or (context.ir[effectAncestor!].kind == 17 and context.ir[effectAncestor!].flags == 1) or (context.ir[effectAncestor!].kind == 9 and (context.ir[effectAncestor!].opcode == -204 or context.ir[effectAncestor!].opcode == -205 or context.ir[effectAncestor!].opcode == -213 or context.ir[effectAncestor!].opcode == -220 or context.ir[effectAncestor!].opcode == -221 or context.ir[effectAncestor!].opcode == -229 or context.ir[effectAncestor!].opcode == -241 or context.ir[effectAncestor!].opcode == -242 or context.ir[effectAncestor!].opcode == -246 or context.ir[effectAncestor!].opcode == -247 or context.ir[effectAncestor!].opcode == -250 or context.ir[effectAncestor!].opcode == -251 or context.ir[effectAncestor!].opcode == -252 or context.ir[effectAncestor!].opcode == -254 or context.ir[effectAncestor!].opcode == -255 or context.ir[effectAncestor!].opcode == -257)))
                            -> if { false => rootEffect! } else { context.ir[effectAncestor!].parent => effectAncestor! }
                    }
                    false => mutableRebindEffect!
                    (scheduleNode.kind == 17 and scheduleNode.flags == 1)
                        -> if {
                        scheduleCandidate! -> mutableBindingRoot(context, state) => scheduleEffectMutableRoot
                        scheduleEffectMutableRoot != scheduleCandidate!
                            -> if { true => mutableRebindEffect! }
                    }
                    (rootEffect! and (not (scheduleNode.kind == 17 and scheduleNode.flags == 1) or mutableRebindEffect!))
                        -> if {
                        expressionStart => earlierEffectSearch!
                        earlierEffectSearch! < functionEnd -> while {
                            context.ir[earlierEffectSearch!] => earlierEffect
                        (not expressionScheduled![earlierEffectSearch! - expressionStart] and (earlierEffect.kind == 6 or earlierEffect.kind == 18 or earlierEffect.kind == 20 or earlierEffect.kind == 27 or earlierEffect.kind == 34 or earlierEffect.kind == 24 or earlierEffect.kind == 25 or (earlierEffect.kind == 17 and earlierEffect.flags == 1) or (earlierEffect.kind == 9 and (earlierEffect.opcode == -204 or earlierEffect.opcode == -213 or earlierEffect.opcode == -229 or earlierEffect.opcode == -241 or earlierEffect.opcode == -242 or earlierEffect.opcode == -246 or earlierEffect.opcode == -247 or earlierEffect.opcode == -250 or earlierEffect.opcode == -251 or earlierEffect.opcode == -252 or earlierEffect.opcode == -254 or earlierEffect.opcode == -255 or earlierEffect.opcode == -257))) and (earlierEffect -> sourceStart(context, state)) < (scheduleNode -> sourceStart(context, state)))
                            -> if {
                                earlierEffect.parent => earlierEffectAncestor!
                                true => earlierRootEffect!
                                false => earlierInsideRegion!
                                (earlierEffectAncestor! >= expressionStart and earlierRootEffect! and not earlierInsideRegion!)
                                    -> while {
                                    (context.ir[earlierEffectAncestor!].kind == 19 or context.ir[earlierEffectAncestor!].kind == 20)
                                        -> if { true => earlierInsideRegion! } else {
                                    ((context.ir[earlierEffectAncestor!].kind == 6 and context.ir[earlierEffectAncestor!].opcode != -208) or context.ir[earlierEffectAncestor!].kind == 18 or context.ir[earlierEffectAncestor!].kind == 20 or context.ir[earlierEffectAncestor!].kind == 27 or context.ir[earlierEffectAncestor!].kind == 34 or context.ir[earlierEffectAncestor!].kind == 24 or context.ir[earlierEffectAncestor!].kind == 25 or (context.ir[earlierEffectAncestor!].kind == 17 and context.ir[earlierEffectAncestor!].flags == 1) or (context.ir[earlierEffectAncestor!].kind == 9 and (context.ir[earlierEffectAncestor!].opcode == -204 or context.ir[earlierEffectAncestor!].opcode == -205 or context.ir[earlierEffectAncestor!].opcode == -213 or context.ir[earlierEffectAncestor!].opcode == -220 or context.ir[earlierEffectAncestor!].opcode == -221 or context.ir[earlierEffectAncestor!].opcode == -229 or context.ir[earlierEffectAncestor!].opcode == -241 or context.ir[earlierEffectAncestor!].opcode == -242 or context.ir[earlierEffectAncestor!].opcode == -246 or context.ir[earlierEffectAncestor!].opcode == -247 or context.ir[earlierEffectAncestor!].opcode == -250 or context.ir[earlierEffectAncestor!].opcode == -251 or context.ir[earlierEffectAncestor!].opcode == -252 or context.ir[earlierEffectAncestor!].opcode == -254 or context.ir[earlierEffectAncestor!].opcode == -255 or context.ir[earlierEffectAncestor!].opcode == -257)))
                                        -> if { false => earlierRootEffect! } else { context.ir[earlierEffectAncestor!].parent => earlierEffectAncestor! }
                                    }
                                }
                                (earlierRootEffect! and not earlierInsideRegion!)
                                    -> if { false => scheduleReady! }
                            }
                            earlierEffectSearch! + 1 => earlierEffectSearch!
                        }
                    }
                }
                (not insideControlRegion!
                    and scheduleNode.kind == 5
                    and scheduleNode.operand0 >= expressionStart
                    and scheduleNode.operand0 < functionEnd
                    and context.ir[scheduleNode.operand0].kind == 17
                    and context.ir[scheduleNode.operand0].flags != 1
                    and scheduleNode.parent >= expressionStart
                    and scheduleNode.parent < functionEnd
                    and (context.ir[scheduleNode.parent].kind == 12
                        or context.ir[scheduleNode.parent].kind == 14
                        or context.ir[scheduleNode.parent].kind == 16
                        or context.ir[scheduleNode.parent].kind == 26
                        or context.ir[scheduleNode.parent].kind == 35)
                    and expressionScheduled![scheduleNode.operand0 - expressionStart])
                        -> if {
                    true => scheduleReady!
                }
                scheduleReady! -> if {
                    not insideLogicalValue! -> if { expressionOrder! -> push(scheduleCandidate!) }
                    true => expressionScheduled![scheduleCandidate! - expressionStart]
                    (scheduleNode.kind == 6 and scheduleNode.opcode == -208)
                        -> if { scheduleCandidate! => pendingEach! }
                    true => scheduleProgress!
                }
            }
            scheduleCandidate! + 1 => scheduleCandidate!
        }
    }
    expressionOrder!
}
