                (scheduleReady! and scheduleNode.kind == 6 and scheduleNode.parent >= expressionStart and scheduleNode.parent < functionEnd and context.ir[scheduleNode.parent].kind == 39 and context.ir[scheduleNode.parent].parent >= expressionStart and context.ir[context.ir[scheduleNode.parent].parent].kind == 37)
