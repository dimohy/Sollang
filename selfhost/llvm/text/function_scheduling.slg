                            (scheduleCandidate! == ifConditionCandidate.operand0 or ifDescends)
                                -> if {
                                true => insideIfCondition!
                            }
                        }
                    }
                    ifConditionSearch! + 1 => ifConditionSearch!
                }
                insideIfCondition! -> if { true => insideControlRegion! }
                false => insideLogicalValue!
                scheduleNode.parent => logicalValueAncestor!
                (logicalValueAncestor! >= expressionStart and not insideLogicalValue!)
                    -> while {
                    context.ir[logicalValueAncestor!] => logicalValueAncestorNode
                    (logicalValueAncestorNode.kind == 8 and (logicalValueAncestorNode.opcode == -24 or logicalValueAncestorNode.opcode == -25))
                        -> if {
                        true => insideLogicalValue!
                    } else {
