                    context.moves[dropMoveIndex!] => dropMove
                    (dropMove.memberIr >= 0 and dropMove.sourceModule == dropCandidate.sourceModule and dropMove.symbol == dropCandidate.symbol and (dropMoveIndex! -> partialMoveActiveBefore(function.operand0, -1, context, state))) -> if { true => dropCandidateHasPartialMoves! }
                    (dropMove.memberIr < 0 and dropMove.sourceModule == dropCandidate.sourceModule and dropMove.symbol == dropCandidate.symbol and dropMove.regionIr == function.operand0) -> if {
