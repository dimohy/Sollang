namespace sollang.compiler.llvm.text

import sollang.compiler.llvm.emitter.ownership as ownershipEmitter
import sollang.compiler.llvm.emitter.context as emitterContext
import sollang.compiler.syntax as syntax
import syntax.generated.slg as grammar

# Responsibility fragment extracted from emitCore. State is passed by readonly
# reference, preserving the original direct-call and allocation behavior.

emitFunction requestedFunctionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int uses Console {
    requestedFunctionIndex => functionIndex!
    context.ir[functionIndex!] => function
        functionIndex! + 1 => functionEnd!
        (functionEnd! < (context.ir -> len) and context.ir[functionEnd!].kind != 0 and context.ir[functionEnd!].kind != 11) -> while {
            functionEnd! + 1 => functionEnd!
        }
        functionIndex! -> functionCaptures(context, state) => currentFunctionCaptures!
        "define " -> print
        function -> writeIrType(context, state)
        " @sollang_m" -> print
        function.sourceModule -> writeDecimal
        "_s" -> print
        function.symbol -> writeDecimal
        "(" -> print
        0 => functionCaptureParameterIndex!
        functionCaptureParameterIndex! < (currentFunctionCaptures! -> len) -> while {
            context.ir[currentFunctionCaptures![functionCaptureParameterIndex!]] => functionCaptureParameter
            functionCaptureParameter -> ownsType -> if { "ptr" -> print } else { functionCaptureParameter -> writeIrType(context, state) }
            " %capture_$(functionCaptureParameterIndex!)" -> print
            (functionCaptureParameterIndex! + 1 < (currentFunctionCaptures! -> len) or function.operand1 >= 0 or function.nextOperand >= 0) -> if { ", " -> print }
            functionCaptureParameterIndex! + 1 => functionCaptureParameterIndex!
        }
        function.operand1 >= 0 -> if {
            context.ir[function.operand1] => parameter
            parameter.flags / 2 % 2 == 1 -> if {
                parameter -> mutableBorrowUsesStructPointer(context) -> if { "ptr %arg_mut_struct" -> print } else { "%sollang.mutable_container %arg_borrow" -> print }
            } else {
                parameter -> writeIrType(context, state)
                " %arg" -> print
            }
            function.nextOperand >= 0 -> if { ", " -> print }
        }
        function.nextOperand => additionalSignatureParameterIndex!
        1 => additionalSignatureParameterOrdinal!
        additionalSignatureParameterIndex! >= 0 -> while {
            context.ir[additionalSignatureParameterIndex!] => additionalSignatureParameter
            additionalSignatureParameter.flags / 2 % 2 == 1 -> if {
                additionalSignatureParameter -> mutableBorrowUsesStructPointer(context) -> if {
                    "ptr %arg$(additionalSignatureParameterOrdinal!)_mut_struct" -> print
                } else {
                    "%sollang.mutable_container %arg$(additionalSignatureParameterOrdinal!)_borrow" -> print
                }
            } else {
                additionalSignatureParameter -> writeIrType(context, state)
                " %arg$(additionalSignatureParameterOrdinal!)" -> print
            }
            additionalSignatureParameter.nextOperand >= 0 -> if { ", " -> print }
            additionalSignatureParameter.nextOperand => additionalSignatureParameterIndex!
            additionalSignatureParameterOrdinal! + 1 => additionalSignatureParameterOrdinal!
        }
        ") {" -> println
        "entry:" -> println
        functionIndex! -> emitHoistedControlAllocas(functionIndex! + 1, functionEnd!, context, state)
        function.operand1 >= 0 -> if {
            context.ir[function.operand1] => entryParameter
            entryParameter.flags / 2 % 2 == 1 -> if {
                entryParameter -> mutableBorrowUsesStructPointer(context) -> if {
                    "  %arg = load " -> print
                    entryParameter -> writeIrType(context, state)
                    ", ptr %arg_mut_struct, align " -> print
                    entryParameter -> storageAlign(context, state) -> writeDecimalLine
                } else {
                    "  %arg_mut_ptr_addr = extractvalue %sollang.mutable_container %arg_borrow, 0" -> println
                    "  %arg_mut_len_addr = extractvalue %sollang.mutable_container %arg_borrow, 1" -> println
                    "  %arg_mut_capacity_addr = extractvalue %sollang.mutable_container %arg_borrow, 2" -> println
                    "  %arg_mut_ptr = load ptr, ptr %arg_mut_ptr_addr, align 8" -> println
                    "  %arg_mut_len = load i64, ptr %arg_mut_len_addr, align 8" -> println
                    "  %arg_mut_capacity = load i64, ptr %arg_mut_capacity_addr, align 8" -> println
                    "  %arg_value0 = insertvalue " -> print
                    entryParameter -> writeIrType(context, state)
                    " poison, ptr %arg_mut_ptr, 0" -> println
                    "  %arg_value1 = insertvalue " -> print
                    entryParameter -> writeIrType(context, state)
                    " %arg_value0, i64 %arg_mut_len, 1" -> println
                    "  %arg = insertvalue " -> print
                    entryParameter -> writeIrType(context, state)
                    " %arg_value1, i64 %arg_mut_capacity, 2" -> println
                }
            }
        }
        function.nextOperand => entryAdditionalParameterIndex!
        1 => entryAdditionalParameterOrdinal!
        entryAdditionalParameterIndex! >= 0 -> while {
            context.ir[entryAdditionalParameterIndex!] => entryAdditionalParameter
            entryAdditionalParameter.flags / 2 % 2 == 1 -> if {
                entryAdditionalParameter -> mutableBorrowUsesStructPointer(context) -> if {
                    "  %arg$(entryAdditionalParameterOrdinal!) = load " -> print
                    entryAdditionalParameter -> writeIrType(context, state)
                    ", ptr %arg$(entryAdditionalParameterOrdinal!)_mut_struct, align " -> print
                    entryAdditionalParameter -> storageAlign(context, state) -> writeDecimalLine
                } else {
                    "  %arg$(entryAdditionalParameterOrdinal!)_mut_ptr_addr = extractvalue %sollang.mutable_container %arg$(entryAdditionalParameterOrdinal!)_borrow, 0" -> println
                    "  %arg$(entryAdditionalParameterOrdinal!)_mut_len_addr = extractvalue %sollang.mutable_container %arg$(entryAdditionalParameterOrdinal!)_borrow, 1" -> println
                    "  %arg$(entryAdditionalParameterOrdinal!)_mut_capacity_addr = extractvalue %sollang.mutable_container %arg$(entryAdditionalParameterOrdinal!)_borrow, 2" -> println
                    "  %arg$(entryAdditionalParameterOrdinal!)_mut_ptr = load ptr, ptr %arg$(entryAdditionalParameterOrdinal!)_mut_ptr_addr, align 8" -> println
                    "  %arg$(entryAdditionalParameterOrdinal!)_mut_len = load i64, ptr %arg$(entryAdditionalParameterOrdinal!)_mut_len_addr, align 8" -> println
                    "  %arg$(entryAdditionalParameterOrdinal!)_mut_capacity = load i64, ptr %arg$(entryAdditionalParameterOrdinal!)_mut_capacity_addr, align 8" -> println
                    "  %arg$(entryAdditionalParameterOrdinal!)_value0 = insertvalue " -> print
                    entryAdditionalParameter -> writeIrType(context, state)
                    " poison, ptr %arg$(entryAdditionalParameterOrdinal!)_mut_ptr, 0" -> println
                    "  %arg$(entryAdditionalParameterOrdinal!)_value1 = insertvalue " -> print
                    entryAdditionalParameter -> writeIrType(context, state)
                    " %arg$(entryAdditionalParameterOrdinal!)_value0, i64 %arg$(entryAdditionalParameterOrdinal!)_mut_len, 1" -> println
                    "  %arg$(entryAdditionalParameterOrdinal!) = insertvalue " -> print
                    entryAdditionalParameter -> writeIrType(context, state)
                    " %arg$(entryAdditionalParameterOrdinal!)_value1, i64 %arg$(entryAdditionalParameterOrdinal!)_mut_capacity, 2" -> println
                }
            }
            entryAdditionalParameter.nextOperand => entryAdditionalParameterIndex!
            entryAdditionalParameterOrdinal! + 1 => entryAdditionalParameterOrdinal!
        }
        [Int; ~] => captureBorrowBindings!
        functionIndex! + 1 => captureBorrowCallIndex!
        captureBorrowCallIndex! < functionEnd! -> while {
            context.ir[captureBorrowCallIndex!] => captureBorrowCall
            (captureBorrowCall.kind == 6 and captureBorrowCall.targetModule >= 0 and captureBorrowCall.symbol >= 0) -> if {
                -1 => captureBorrowTarget!
                captureBorrowCall.targetModule < (context.ranges -> len) -> if {
                    context.ranges[captureBorrowCall.targetModule].symbolStart + captureBorrowCall.symbol => captureBorrowGlobalSymbol
                    (captureBorrowGlobalSymbol >= 0 and captureBorrowGlobalSymbol < (state.frozenCaptureFunctionsBySymbol -> len)) -> if {
                        state.frozenCaptureFunctionsBySymbol[captureBorrowGlobalSymbol] => captureBorrowTarget!
                    }
                }
                captureBorrowTarget! >= 0 -> if {
                    captureBorrowTarget! -> functionCaptures(context, state) => captureBorrowCallBindings!
                    0 => captureBorrowCallBindingIndex!
                    captureBorrowCallBindingIndex! < (captureBorrowCallBindings! -> len) -> while {
                        captureBorrowCallBindings![captureBorrowCallBindingIndex!] => captureBorrowBindingIndex
                        context.ir[captureBorrowBindingIndex] => captureBorrowBinding
                        (captureBorrowBindingIndex > functionIndex! and captureBorrowBindingIndex < functionEnd! and (captureBorrowBinding -> ownsType) and not (captureBorrowBinding.kind != 10 and captureBorrowBinding.flags == 1)) -> if {
                            false => captureBorrowDuplicate!
                            0 => captureBorrowDuplicateIndex!
                            captureBorrowDuplicateIndex! < (captureBorrowBindings! -> len) -> while {
                                captureBorrowBindings![captureBorrowDuplicateIndex!] == captureBorrowBindingIndex -> if { true => captureBorrowDuplicate! }
                                captureBorrowDuplicateIndex! + 1 => captureBorrowDuplicateIndex!
                            }
                            not captureBorrowDuplicate! -> if { captureBorrowBindings! -> push(captureBorrowBindingIndex) }
                        }
                        captureBorrowCallBindingIndex! + 1 => captureBorrowCallBindingIndex!
                    }
                }
            }
            captureBorrowCallIndex! + 1 => captureBorrowCallIndex!
        }
        0 => captureBorrowBindingListIndex!
        captureBorrowBindingListIndex! < (captureBorrowBindings! -> len) -> while {
            captureBorrowBindings![captureBorrowBindingListIndex!] => captureBorrowBindingIndex
            context.ir[captureBorrowBindingIndex] => captureBorrowBinding
            "  %capture_borrow_binding$(captureBorrowBindingIndex) = alloca " -> print
            captureBorrowBinding -> writeIrType(context, state)
            ", align " -> print
            captureBorrowBinding -> storageAlign(context, state) -> writeDecimalLine
            captureBorrowBindingListIndex! + 1 => captureBorrowBindingListIndex!
        }
        function.operand0 + 1 => expressionStart
        expressionStart => functionCaptureUseIndex!
        functionCaptureUseIndex! < functionEnd! -> while {
            context.ir[functionCaptureUseIndex!] => functionCaptureUse
            (functionCaptureUse.kind == 5 and functionCaptureUse.operand0 < 0) -> if {
                0 => functionCaptureMatchIndex!
                functionCaptureMatchIndex! < (currentFunctionCaptures! -> len) -> while {
                    context.ir[currentFunctionCaptures![functionCaptureMatchIndex!]].symbol == functionCaptureUse.symbol -> if {
                        functionCaptureUse -> ownsType -> if {
                            "  %v$(functionCaptureUseIndex!) = load " -> print
                            functionCaptureUse -> writeIrType(context, state)
                            ", ptr %capture_$(functionCaptureMatchIndex!), align " -> print
                            functionCaptureUse -> storageAlign(context, state) -> writeDecimalLine
                        } else {
                            "  %v$(functionCaptureUseIndex!) = freeze " -> print
                            functionCaptureUse -> writeIrType(context, state)
                            " %capture_$(functionCaptureMatchIndex!)" -> println
                        }
                    }
                    functionCaptureMatchIndex! + 1 => functionCaptureMatchIndex!
                }
            }
            functionCaptureUseIndex! + 1 => functionCaptureUseIndex!
        }
        functionIndex! -> prepareFunctionExpressionOrder(functionEnd!, expressionStart, context, state) => expressionOrder!
        [Bool; ~] => expressionEmitted!
        expressionStart => expressionEmittedInit!
        expressionEmittedInit! < functionEnd! -> while {
            expressionEmitted! -> push(false)
            expressionEmittedInit! + 1 => expressionEmittedInit!
        }
        [Int; ~] => activeEach!
        0 => activeEachSize!
        0 => expressionOrderIndex!
        expressionOrderIndex! < (expressionOrder! -> len) -> while {
            expressionOrder![expressionOrderIndex!] => expressionIndex!
            true => expressionEmitted![expressionIndex! - expressionStart]
            context.ir[expressionIndex!] => expression
            (expression.kind == 5 and not (expression -> isArgumentsType)) -> if {
                expressionIndex! -> mutableBorrowParameterOrdinal(functionIndex!, context, state) => expressionMutableParameterOrdinal
                expressionMutableParameterOrdinal >= 0 -> if {
                    expressionIndex! -> emitCurrentMutableParameterValue(expressionMutableParameterOrdinal, functionIndex!, context, state)
                } else {
                not (function.operand1 >= 0 and expression.symbol == context.ir[function.operand1].symbol) -> if {
                expression.symbol => expressionParameterSymbol
                functionIndex! -> additionalParameterOrdinal(expressionParameterSymbol, context, state) => expressionParameterOrdinal
                expressionParameterOrdinal >= 0 -> if {
                    "  %v$(expressionIndex!) = freeze " -> print
                    expression -> writeIrType(context, state)
                    " %arg$(expressionParameterOrdinal)" -> println
                } else {
                -1 => bindingValueIr!
                (expression.operand0 >= 0 and (context.ir[expression.operand0].kind == 17 or context.ir[expression.operand0].kind == 29)) -> if { expression.operand0 => bindingValueIr! }
                bindingValueIr! >= 0 -> if {
                    context.ir[bindingValueIr!] => bindingValue
                    bindingValue.kind == 29 -> if {
                        "  %v$(expressionIndex!) = freeze " -> print
                        expression -> writeIrType(context, state)
                        " %v$(bindingValueIr!)" -> println
                    } else {
                    bindingValue.flags == 1 -> if {
                        bindingValueIr! -> mutableBindingRoot(context, state) => bindingRoot
                        "  %v$(expressionIndex!) = load " -> print
                        expression -> writeIrType(context, state)
                        ", ptr %slot$(bindingRoot), align " -> print
                        expression -> storageAlign(context, state) -> writeDecimalLine
                    } else {
                        context.ir[bindingValue.operand0] => bindingOperand
                        "  %v$(expressionIndex!) = freeze " -> print
                        expression -> writeIrType(context, state)
                        " " -> print
                        (bindingOperand.kind == 3 or bindingOperand.kind == 4) -> if {
                            bindingOperand -> sourceToken(context, state) => bindingOperandToken
                            bindingOperand.kind == 3 -> if { context.sources[bindingOperand.sourceModule] -> slice(bindingOperandToken.span.start, bindingOperandToken.span.length) -> print } else {
                                ((context.sources[bindingOperand.sourceModule] -> byte(bindingOperandToken.span.start)) == UInt8(116)) -> if { "1" -> print } else { "0" -> print }
                            }
                        } else { "%v$(bindingValue.operand0)" -> print }
                        "" -> println
                    }
                    }
                }
                }
                }
                }
            }
            ((expression.kind == 9 or expression.kind == 6) and expression.opcode == -201 and expression.operand0 >= 0) -> if {
                expressionIndex! -> emitLengthIntrinsic(functionIndex!, context, state)
            }
            (expression.kind == 9 and expression.opcode <= -241 and expression.opcode >= -245 and expression.operand0 >= 0) -> if {
                expressionIndex! -> emitBitSetIntrinsic(functionIndex!, context, state)
            }
            (expression.kind == 9 and expression.opcode <= -246 and expression.opcode >= -251 and expression.operand0 >= 0) -> if {
                expressionIndex! -> emitDequeIntrinsic(functionIndex!, context, state)
            }
            (expression.kind == 9 and expression.opcode <= -252 and expression.opcode >= -254 and expression.operand0 >= 0) -> if {
                expressionIndex! -> emitHeapIntrinsic(functionIndex!, context, state)
            }
            (expression.kind == 9 and expression.opcode <= -255 and expression.opcode >= -257 and expression.operand0 >= 0) -> if {
                expressionIndex! -> emitSetIntrinsic(functionIndex!, context, state)
            }
            ((expression.kind == 9 or expression.kind == 6) and expression.opcode == -236 and expression.operand0 >= 0) -> if {
                expressionIndex! -> emitCapacityIntrinsic(functionIndex!, context, state)
            }
            ((expression.kind == 9 or expression.kind == 6) and expression.opcode == -202 and expression.operand0 >= 0 and expression.operand1 >= 0) -> if {
                context.ir[expression.operand0] => byteBase
                expression.operand1 -> aggregateValueIndex(context, state) => byteIndexValue
                context.ir[byteIndexValue] => byteIndex
                byteIndex -> integerNodeWidth(context, state) => byteIndexWidth
                byteBase.typeId => byteBaseTypeId!
                false => byteBaseReference!
                (byteBaseTypeId! >= 0 and context.types[byteBaseTypeId!].kind == 8) -> if {
                    context.types[byteBaseTypeId!].first => byteBaseTypeId!
                    true => byteBaseReference!
                    "  %v$(expressionIndex!)_base_source = load " -> print
                    byteBaseTypeId! -> writeSemanticTypeId(context, state)
                    ", ptr " -> print
                    expression.operand0 -> writeValue(functionIndex!, context, state)
                    ", align 8" -> println
                }
                "  %v$(expressionIndex!)_base = extractvalue " -> print
                byteBaseReference! -> if { byteBaseTypeId! -> writeSemanticTypeId(context, state) } else { byteBase -> writeTextLikeType }
                " " -> print
                byteBaseReference! -> if { "%v$(expressionIndex!)_base_source" -> print } else {
                    (byteBase.kind == 5 and function.operand1 >= 0 and byteBase.symbol == context.ir[function.operand1].symbol) -> if { "%arg" -> print } else { "%v$(expression.operand0)" -> print }
                }
                ", 0" -> println
                (byteIndexWidth > 0 and byteIndexWidth < 64) -> if {
                    "  %v$(expressionIndex!)_index = " -> print
                    byteIndex -> integerNodeSigned(context, state) -> if { "sext" -> print } else { "zext" -> print }
                    " i$(byteIndexWidth) %v$(byteIndexValue) to i64" -> println
                }
                "  %v$(expressionIndex!)_address = getelementptr i8, ptr %v$(expressionIndex!)_base, i64 " -> print
                (byteIndexWidth > 0 and byteIndexWidth < 64) -> if { "%v$(expressionIndex!)_index" -> println } else { "%v$(byteIndexValue)" -> println }
                "  %v$(expressionIndex!) = load i8, ptr %v$(expressionIndex!)_address, align 1" -> println
            }
            ((expression.kind == 9 or expression.kind == 6) and expression.opcode == -203 and expression.operand0 >= 0 and expression.operand1 >= 0) -> if {
                context.ir[expression.operand1].nextOperand -> aggregateValueIndex(context, state) => sliceLength
                context.ir[expression.operand0] => sliceBase
                context.ir[expression.operand1] => sliceIndex
                context.ir[sliceLength] => sliceLengthNode
                sliceIndex -> integerNodeWidth(context, state) => sliceIndexWidth
                sliceLengthNode -> integerNodeWidth(context, state) => sliceLengthWidth
                sliceBase.typeId => sliceBaseTypeId!
                false => sliceBaseReference!
                (sliceBaseTypeId! >= 0 and context.types[sliceBaseTypeId!].kind == 8) -> if {
                    context.types[sliceBaseTypeId!].first => sliceBaseTypeId!
                    true => sliceBaseReference!
                    "  %v$(expressionIndex!)_base_source = load " -> print
                    sliceBaseTypeId! -> writeSemanticTypeId(context, state)
                    ", ptr " -> print
                    expression.operand0 -> writeValue(functionIndex!, context, state)
                    ", align 8" -> println
                }
                "  %v$(expressionIndex!)_base = extractvalue " -> print
                sliceBaseReference! -> if { sliceBaseTypeId! -> writeSemanticTypeId(context, state) } else { sliceBase -> writeTextLikeType }
                " " -> print
                sliceBaseReference! -> if { "%v$(expressionIndex!)_base_source" -> print } else {
                    (sliceBase.kind == 5 and function.operand1 >= 0 and sliceBase.symbol == context.ir[function.operand1].symbol) -> if { "%arg" -> print } else { "%v$(expression.operand0)" -> print }
                }
                ", 0" -> println
                (sliceIndexWidth > 0 and sliceIndexWidth < 64) -> if {
                    "  %v$(expressionIndex!)_index = " -> print
                    sliceIndex -> integerNodeSigned(context, state) -> if { "sext" -> print } else { "zext" -> print }
                    " i$(sliceIndexWidth) %v$(expression.operand1) to i64" -> println
                }
                "  %v$(expressionIndex!)_start = getelementptr i8, ptr %v$(expressionIndex!)_base, i64 " -> print
                (sliceIndexWidth > 0 and sliceIndexWidth < 64) -> if { "%v$(expressionIndex!)_index" -> println } else { "%v$(expression.operand1)" -> println }
                "  %v$(expressionIndex!)_ptr = insertvalue %sollang.text poison, ptr %v$(expressionIndex!)_start, 0" -> println
                (sliceLengthNode.kind != 3 and sliceLengthWidth > 0 and sliceLengthWidth < 64) -> if {
                    "  %v$(expressionIndex!)_length = " -> print
                    sliceLengthNode -> integerNodeSigned(context, state) -> if { "sext" -> print } else { "zext" -> print }
                    " i$(sliceLengthWidth) %v$(sliceLength) to i64" -> println
                }
                "  %v$(expressionIndex!) = insertvalue %sollang.text %v$(expressionIndex!)_ptr, i64 " -> print
                (sliceLengthNode.kind != 3 and sliceLengthWidth > 0 and sliceLengthWidth < 64) -> if {
                    "%v$(expressionIndex!)_length" -> print
                } else { "%v$(sliceLength)" -> print }
                ", 1" -> println
            }
            (expression.kind == 9 and expression.opcode == -204 and expression.operand0 >= 0 and expression.operand1 >= 0) -> if {
                WhileValueRequest { whileIndex: expressionIndex!, ownerIndex: functionIndex!, nodeIndex: 0 } -> emitArrayPush(context, state)
            }
            (expression.kind == 9 and expression.opcode == -223 and expression.operand0 >= 0 and expression.operand1 >= 0) -> if {
                WhileValueRequest { whileIndex: expressionIndex!, ownerIndex: functionIndex!, nodeIndex: 0 } -> emitDictionaryPut(context, state)
            }
            (expression.kind == 9 and expression.opcode == -213 and expression.operand0 >= 0 and expression.operand1 >= 0) -> if {
                WhileValueRequest { whileIndex: expressionIndex!, ownerIndex: functionIndex!, nodeIndex: 0 } -> emitTake(context, state)
            }
            ((expression.kind == 9 or expression.kind == 6) and expression.opcode == -205 and expression.operand0 >= 0) -> if {
                context.ir[expression.operand0] => mapPath
                "  %v$(expressionIndex!) = call %sollang.source_text @sollang_runtime_map_text(%sollang.text " -> print
                (mapPath.kind == 5 and function.operand1 >= 0 and mapPath.symbol == context.ir[function.operand1].symbol) -> if { "%arg" -> print } else { "%v$(expression.operand0)" -> print }
                ")" -> println
            }
            (expression -> isSourceTextFileIntrinsic) -> if {
                expressionIndex! -> emitSourceTextFileIntrinsic(functionIndex!, context, state)
            }
            ((expression.kind == 9 or expression.kind == 6) and (expression.opcode == -214 or expression.opcode == -230) and expression.operand0 >= 0) -> if {
                context.ir[expression.operand0] => sourcePath
                context.expectedPathStyle => sourcePathExpectedStyle
                sourcePath.typeId => sourcePathValueType!
                false => sourcePathIsReference!
                (sourcePathValueType! >= 0 and context.types[sourcePathValueType!].kind == 8) -> if {
                    context.types[sourcePathValueType!].first => sourcePathValueType!
                    true => sourcePathIsReference!
                }
                -1 => sourcePathBytesType!
                -1 => sourcePathStyleType!
                0 => sourcePathFieldIndex!
                sourcePathFieldIndex! < (context.fields -> len) -> while {
                    context.fields[sourcePathFieldIndex!] => sourcePathField
                    sourcePathField.ownerType == sourcePathValueType! -> if {
                        sourcePathField.ordinal == 0 -> if { sourcePathField.fieldType => sourcePathBytesType! }
                        sourcePathField.ordinal == 1 -> if { sourcePathField.fieldType => sourcePathStyleType! }
                    }
                    sourcePathFieldIndex! + 1 => sourcePathFieldIndex!
                }
                sourcePathIsReference! -> if {
                    "  %v$(expressionIndex!)_path_value = load " -> print
                    sourcePathValueType! -> writeSemanticTypeId(context, state)
                    ", ptr " -> print
                    (sourcePath.kind == 5 and function.operand1 >= 0 and sourcePath.symbol == context.ir[function.operand1].symbol) -> if { "%arg" -> print } else { "%v$(expression.operand0)" -> print }
                    ", align 8" -> println
                }
                "  %v$(expressionIndex!)_path_bytes = extractvalue " -> print
                sourcePathValueType! -> writeSemanticTypeId(context, state)
                " " -> print
                sourcePathIsReference! -> if {
                    "%v$(expressionIndex!)_path_value" -> print
                } else {
                    (sourcePath.kind == 5 and function.operand1 >= 0 and sourcePath.symbol == context.ir[function.operand1].symbol) -> if { "%arg" -> print } else { "%v$(expression.operand0)" -> print }
                }
                ", 0" -> println
                "  %v$(expressionIndex!)_path_data = extractvalue " -> print
                sourcePathBytesType! -> writeSemanticTypeId(context, state)
                " %v$(expressionIndex!)_path_bytes, 0" -> println
                "  %v$(expressionIndex!)_path_length = extractvalue " -> print
                sourcePathBytesType! -> writeSemanticTypeId(context, state)
                " %v$(expressionIndex!)_path_bytes, 1" -> println
                "  %v$(expressionIndex!)_path_style_value = extractvalue " -> print
                sourcePathValueType! -> writeSemanticTypeId(context, state)
                " " -> print
                sourcePathIsReference! -> if {
                    "%v$(expressionIndex!)_path_value" -> print
                } else {
                    (sourcePath.kind == 5 and function.operand1 >= 0 and sourcePath.symbol == context.ir[function.operand1].symbol) -> if { "%arg" -> print } else { "%v$(expression.operand0)" -> print }
                }
                ", 1" -> println
                "  %v$(expressionIndex!)_path_style = extractvalue " -> print
                sourcePathStyleType! -> writeSemanticTypeId(context, state)
                " %v$(expressionIndex!)_path_style_value, 0" -> println
                "  %v$(expressionIndex!)_path_style_valid = icmp eq i32 %v$(expressionIndex!)_path_style, $(sourcePathExpectedStyle)" -> println
                "  br i1 %v$(expressionIndex!)_path_style_valid, label %map_path$(expressionIndex!)_open, label %map_path$(expressionIndex!)_style_error" -> println
                "map_path$(expressionIndex!)_style_error:" -> println
                "  call void @llvm.trap()" -> println
                "  unreachable" -> println
                "map_path$(expressionIndex!)_open:" -> println
                "  %v$(expressionIndex!)_path_text0 = insertvalue %sollang.text poison, ptr %v$(expressionIndex!)_path_data, 0" -> println
                "  %v$(expressionIndex!)_path_text = insertvalue %sollang.text %v$(expressionIndex!)_path_text0, i64 %v$(expressionIndex!)_path_length, 1" -> println
                expression.opcode == -230 -> if {
                    "  %v$(expressionIndex!) = freeze %sollang.text %v$(expressionIndex!)_path_text" -> println
                } else {
                    "  %v$(expressionIndex!) = call %sollang.source_text @sollang_runtime_map_text(%sollang.text %v$(expressionIndex!)_path_text)" -> println
                }
            }
            ((expression.kind == 9 or expression.kind == 6) and expression.opcode == -206 and expression.operand0 >= 0) -> if {
                context.ir[expression.operand0] => borrowText
                "  %v$(expressionIndex!)_data = extractvalue %sollang.text " -> print
                (borrowText.kind == 5 and function.operand1 >= 0 and borrowText.symbol == context.ir[function.operand1].symbol) -> if { "%arg" -> print } else { "%v$(expression.operand0)" -> print }
                ", 0" -> println
                "  %v$(expressionIndex!)_length = extractvalue %sollang.text " -> print
                (borrowText.kind == 5 and function.operand1 >= 0 and borrowText.symbol == context.ir[function.operand1].symbol) -> if { "%arg" -> print } else { "%v$(expression.operand0)" -> print }
                ", 1" -> println
