                            (putMoveValue.kind == 5 and putMoveValue.operand0 >= 0 and putMoveValue.operand0 < (context.ir -> len)) -> if {
                                putMoveValue.operand0 -> mutableBindingRoot(context, state) => putMoveRoot
                                (putMoveRoot == dropCandidateRoot! and (putMove -> sourceStart(context, state)) > (dropCandidate -> sourceStart(context, state))) -> if {
