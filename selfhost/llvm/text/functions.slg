# Responsibility fragment extracted from emitCore. State is passed by readonly
# reference, preserving the original direct-call and allocation behavior.
callHasDeclaredEffects node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => hasEffects!
    (node.kind == 6 and node.targetModule >= 0 and node.targetModule < (context.ranges -> len) and node.symbol >= 0) -> if {
        context.ranges[node.targetModule] => targetRange
        node.symbol < targetRange.symbolCount -> if {
            context.symbols[targetRange.symbolStart + node.symbol] => targetSymbol
            targetSymbol.astNode >= 0 -> if {
                context.nodes[targetRange.astStart + targetSymbol.astNode] => targetDeclaration
                targetDeclaration.firstToken => tokenIndex!
                tokenIndex! < targetDeclaration.firstToken + targetDeclaration.tokenCount -> while {
                    context.tokens[targetRange.tokenStart + tokenIndex!] => token
                    (token.span.length == UIntSize(4)
                        and (context.sources[node.targetModule] -> byte(token.span.start)) == UInt8(117)
                        and (context.sources[node.targetModule] -> byte(token.span.start + UIntSize(1))) == UInt8(115)
                        and (context.sources[node.targetModule] -> byte(token.span.start + UIntSize(2))) == UInt8(101)
                        and (context.sources[node.targetModule] -> byte(token.span.start + UIntSize(3))) == UInt8(115)) -> if {
                        true => hasEffects!
                    }
                    tokenIndex! + 1 => tokenIndex!
                }
            }
        }
    }
    (node.kind == 6 and node.targetModule >= 0 and node.symbol >= 0 and not hasEffects!) -> if {
        0 => targetFunctionIndex!
        targetFunctionIndex! < (context.ir -> len) -> while {
            context.ir[targetFunctionIndex!] => targetFunction
            (targetFunction.kind == 0
                and targetFunction.sourceModule == node.targetModule
                and targetFunction.symbol == node.symbol) -> if {
                targetFunction.operand1 => targetParameterIndex!
                0 => targetParameterOrdinal!
                targetParameterIndex! >= 0 -> while {
                    context.ir[targetParameterIndex!] => targetParameter
                    targetParameter.flags / 2 % 2 == 1 -> if { true => hasEffects! }
                    targetParameterOrdinal! == 0 -> if {
                        targetFunction.nextOperand => targetParameterIndex!
                    } else {
                        targetParameter.nextOperand => targetParameterIndex!
                    }
                    targetParameterOrdinal! + 1 => targetParameterOrdinal!
                }
            }
            targetFunctionIndex! + 1 => targetFunctionIndex!
        }
    }
    hasEffects!
}

emitFunction requestedFunctionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int uses Console {
    requestedFunctionIndex => functionIndex!
    context.ir[functionIndex!] => function
        functionIndex! + 1 => functionEnd!
        (functionEnd! < (context.ir -> len) and context.ir[functionEnd!].kind != 0 and context.ir[functionEnd!].kind != 11) -> while {
            functionEnd! + 1 => functionEnd!
        }
        functionIndex! -> functionCaptures(context, state) => currentFunctionCaptures!
        "define " -> print
        function -> writeIrType(context, state)
        " @sollang_m" -> print
        function.sourceModule -> writeDecimal
        "_s" -> print
        function.symbol -> writeDecimal
        "(" -> print
        0 => functionCaptureParameterIndex!
        functionCaptureParameterIndex! < (currentFunctionCaptures! -> len) -> while {
            context.ir[currentFunctionCaptures![functionCaptureParameterIndex!]] => functionCaptureParameter
            functionCaptureParameter -> ownsType -> if { "ptr" -> print } else { functionCaptureParameter -> writeIrType(context, state) }
            " %capture_$(functionCaptureParameterIndex!)" -> print
            (functionCaptureParameterIndex! + 1 < (currentFunctionCaptures! -> len) or function.operand1 >= 0 or function.nextOperand >= 0) -> if { ", " -> print }
            functionCaptureParameterIndex! + 1 => functionCaptureParameterIndex!
        }
        function.operand1 >= 0 -> if {
            context.ir[function.operand1] => parameter
            parameter.flags / 2 % 2 == 1 -> if {
                "%sollang.mutable_container %arg_borrow" -> print
            } else {
                parameter -> writeIrType(context, state)
                " %arg" -> print
            }
            function.nextOperand >= 0 -> if { ", " -> print }
        }
        function.nextOperand => additionalSignatureParameterIndex!
        1 => additionalSignatureParameterOrdinal!
        additionalSignatureParameterIndex! >= 0 -> while {
            context.ir[additionalSignatureParameterIndex!] => additionalSignatureParameter
            additionalSignatureParameter.flags / 2 % 2 == 1 -> if {
                "%sollang.mutable_container %arg$(additionalSignatureParameterOrdinal!)_borrow" -> print
            } else {
                additionalSignatureParameter -> writeIrType(context, state)
                " %arg$(additionalSignatureParameterOrdinal!)" -> print
            }
            additionalSignatureParameter.nextOperand >= 0 -> if { ", " -> print }
            additionalSignatureParameter.nextOperand => additionalSignatureParameterIndex!
            additionalSignatureParameterOrdinal! + 1 => additionalSignatureParameterOrdinal!
        }
        ") {" -> println
        "entry:" -> println
        function.operand1 >= 0 -> if {
            context.ir[function.operand1] => entryParameter
            entryParameter.flags / 2 % 2 == 1 -> if {
                "  %arg_mut_ptr_addr = extractvalue %sollang.mutable_container %arg_borrow, 0" -> println
                "  %arg_mut_len_addr = extractvalue %sollang.mutable_container %arg_borrow, 1" -> println
                "  %arg_mut_capacity_addr = extractvalue %sollang.mutable_container %arg_borrow, 2" -> println
                "  %arg_mut_ptr = load ptr, ptr %arg_mut_ptr_addr, align 8" -> println
                "  %arg_mut_len = load i64, ptr %arg_mut_len_addr, align 8" -> println
                "  %arg_mut_capacity = load i64, ptr %arg_mut_capacity_addr, align 8" -> println
                "  %arg_value0 = insertvalue " -> print
                entryParameter -> writeIrType(context, state)
                " poison, ptr %arg_mut_ptr, 0" -> println
                "  %arg_value1 = insertvalue " -> print
                entryParameter -> writeIrType(context, state)
                " %arg_value0, i64 %arg_mut_len, 1" -> println
                "  %arg = insertvalue " -> print
                entryParameter -> writeIrType(context, state)
                " %arg_value1, i64 %arg_mut_capacity, 2" -> println
            }
        }
        function.nextOperand => entryAdditionalParameterIndex!
        1 => entryAdditionalParameterOrdinal!
        entryAdditionalParameterIndex! >= 0 -> while {
            context.ir[entryAdditionalParameterIndex!] => entryAdditionalParameter
            entryAdditionalParameter.flags / 2 % 2 == 1 -> if {
                "  %arg$(entryAdditionalParameterOrdinal!)_mut_ptr_addr = extractvalue %sollang.mutable_container %arg$(entryAdditionalParameterOrdinal!)_borrow, 0" -> println
                "  %arg$(entryAdditionalParameterOrdinal!)_mut_len_addr = extractvalue %sollang.mutable_container %arg$(entryAdditionalParameterOrdinal!)_borrow, 1" -> println
                "  %arg$(entryAdditionalParameterOrdinal!)_mut_capacity_addr = extractvalue %sollang.mutable_container %arg$(entryAdditionalParameterOrdinal!)_borrow, 2" -> println
                "  %arg$(entryAdditionalParameterOrdinal!)_mut_ptr = load ptr, ptr %arg$(entryAdditionalParameterOrdinal!)_mut_ptr_addr, align 8" -> println
                "  %arg$(entryAdditionalParameterOrdinal!)_mut_len = load i64, ptr %arg$(entryAdditionalParameterOrdinal!)_mut_len_addr, align 8" -> println
                "  %arg$(entryAdditionalParameterOrdinal!)_mut_capacity = load i64, ptr %arg$(entryAdditionalParameterOrdinal!)_mut_capacity_addr, align 8" -> println
                "  %arg$(entryAdditionalParameterOrdinal!)_value0 = insertvalue " -> print
                entryAdditionalParameter -> writeIrType(context, state)
                " poison, ptr %arg$(entryAdditionalParameterOrdinal!)_mut_ptr, 0" -> println
                "  %arg$(entryAdditionalParameterOrdinal!)_value1 = insertvalue " -> print
                entryAdditionalParameter -> writeIrType(context, state)
                " %arg$(entryAdditionalParameterOrdinal!)_value0, i64 %arg$(entryAdditionalParameterOrdinal!)_mut_len, 1" -> println
                "  %arg$(entryAdditionalParameterOrdinal!) = insertvalue " -> print
                entryAdditionalParameter -> writeIrType(context, state)
                " %arg$(entryAdditionalParameterOrdinal!)_value1, i64 %arg$(entryAdditionalParameterOrdinal!)_mut_capacity, 2" -> println
            }
            entryAdditionalParameter.nextOperand => entryAdditionalParameterIndex!
            entryAdditionalParameterOrdinal! + 1 => entryAdditionalParameterOrdinal!
        }
        [Int; ~] => captureBorrowBindings!
        functionIndex! + 1 => captureBorrowCallIndex!
        captureBorrowCallIndex! < functionEnd! -> while {
            context.ir[captureBorrowCallIndex!] => captureBorrowCall
            (captureBorrowCall.kind == 6 and captureBorrowCall.targetModule >= 0 and captureBorrowCall.symbol >= 0) -> if {
                -1 => captureBorrowTarget!
                captureBorrowCall.targetModule < (context.ranges -> len) -> if {
                    context.ranges[captureBorrowCall.targetModule].symbolStart + captureBorrowCall.symbol => captureBorrowGlobalSymbol
                    (captureBorrowGlobalSymbol >= 0 and captureBorrowGlobalSymbol < (state.frozenCaptureFunctionsBySymbol -> len)) -> if {
                        state.frozenCaptureFunctionsBySymbol[captureBorrowGlobalSymbol] => captureBorrowTarget!
                    }
                }
                captureBorrowTarget! >= 0 -> if {
                    captureBorrowTarget! -> functionCaptures(context, state) => captureBorrowCallBindings!
                    0 => captureBorrowCallBindingIndex!
                    captureBorrowCallBindingIndex! < (captureBorrowCallBindings! -> len) -> while {
                        captureBorrowCallBindings![captureBorrowCallBindingIndex!] => captureBorrowBindingIndex
                        context.ir[captureBorrowBindingIndex] => captureBorrowBinding
                        (captureBorrowBindingIndex > functionIndex! and captureBorrowBindingIndex < functionEnd! and (captureBorrowBinding -> ownsType) and not (captureBorrowBinding.kind != 10 and captureBorrowBinding.flags == 1)) -> if {
                            false => captureBorrowDuplicate!
                            0 => captureBorrowDuplicateIndex!
                            captureBorrowDuplicateIndex! < (captureBorrowBindings! -> len) -> while {
                                captureBorrowBindings![captureBorrowDuplicateIndex!] == captureBorrowBindingIndex -> if { true => captureBorrowDuplicate! }
                                captureBorrowDuplicateIndex! + 1 => captureBorrowDuplicateIndex!
                            }
                            not captureBorrowDuplicate! -> if { captureBorrowBindings! -> push(captureBorrowBindingIndex) }
                        }
                        captureBorrowCallBindingIndex! + 1 => captureBorrowCallBindingIndex!
                    }
                }
            }
            captureBorrowCallIndex! + 1 => captureBorrowCallIndex!
        }
        0 => captureBorrowBindingListIndex!
        captureBorrowBindingListIndex! < (captureBorrowBindings! -> len) -> while {
            captureBorrowBindings![captureBorrowBindingListIndex!] => captureBorrowBindingIndex
            context.ir[captureBorrowBindingIndex] => captureBorrowBinding
            "  %capture_borrow_binding$(captureBorrowBindingIndex) = alloca " -> print
            captureBorrowBinding -> writeIrType(context, state)
            ", align " -> print
            captureBorrowBinding -> storageAlign(context, state) -> writeDecimalLine
            captureBorrowBindingListIndex! + 1 => captureBorrowBindingListIndex!
        }
        function.operand0 + 1 => expressionStart
        expressionStart => functionCaptureUseIndex!
        functionCaptureUseIndex! < functionEnd! -> while {
            context.ir[functionCaptureUseIndex!] => functionCaptureUse
            (functionCaptureUse.kind == 5 and functionCaptureUse.operand0 < 0) -> if {
                0 => functionCaptureMatchIndex!
                functionCaptureMatchIndex! < (currentFunctionCaptures! -> len) -> while {
                    context.ir[currentFunctionCaptures![functionCaptureMatchIndex!]].symbol == functionCaptureUse.symbol -> if {
                        functionCaptureUse -> ownsType -> if {
                            "  %v$(functionCaptureUseIndex!) = load " -> print
                            functionCaptureUse -> writeIrType(context, state)
                            ", ptr %capture_$(functionCaptureMatchIndex!), align " -> print
                            functionCaptureUse -> storageAlign(context, state) -> writeDecimalLine
                        } else {
                            "  %v$(functionCaptureUseIndex!) = freeze " -> print
                            functionCaptureUse -> writeIrType(context, state)
                            " %capture_$(functionCaptureMatchIndex!)" -> println
                        }
                    }
                    functionCaptureMatchIndex! + 1 => functionCaptureMatchIndex!
                }
            }
            functionCaptureUseIndex! + 1 => functionCaptureUseIndex!
        }
        expressionStart => mutableSlotIndex!
        mutableSlotIndex! < functionEnd! -> while {
            context.ir[mutableSlotIndex!] => mutableSlotCandidate
            (mutableSlotCandidate.kind == 17 and mutableSlotCandidate.flags == 1) -> if {
                mutableSlotIndex! -> mutableBindingRoot(context, state) => mutableSlotRoot
                mutableSlotRoot == mutableSlotIndex! -> if {
                    "  %slot$(mutableSlotRoot) = alloca " -> print
                    mutableSlotCandidate -> writeIrType(context, state)
                    ", align " -> print
                    mutableSlotCandidate -> storageAlign(context, state) -> writeDecimalLine
                }
            }
            mutableSlotIndex! + 1 => mutableSlotIndex!
        }
        [Bool; ~] => expressionScheduled!
        [Bool; ~] => expressionEmitted!
        expressionStart => scheduledInit!
        scheduledInit! < functionEnd! -> while {
            expressionScheduled! -> push(false)
            expressionEmitted! -> push(false)
            scheduledInit! + 1 => scheduledInit!
        }
        [Int; ~] => expressionOrder!
        true => scheduleProgress!
        scheduleProgress! -> while {
            false => scheduleProgress!
            -1 => pendingEach!
            Int(expressionOrder! -> len) - 1 => pendingEachOrderIndex!
            (pendingEachOrderIndex! >= 0 and pendingEach! < 0) -> while {
                expressionOrder![pendingEachOrderIndex!] => orderedEachCandidate
                context.ir[orderedEachCandidate] => orderedEachNode
                (orderedEachNode.kind == 6 and orderedEachNode.opcode == -208) -> if {
                    false => orderedEachHasPendingBody!
                    expressionStart => orderedEachBodySearch!
                    (orderedEachBodySearch! < functionEnd! and not orderedEachHasPendingBody!) -> while {
                        NodeAncestorRequest { nodeIndex: orderedEachBodySearch!, ownerIndex: orderedEachCandidate } => orderedEachAncestorRequest
                        orderedEachAncestorRequest -> irDescendsFrom(context, state) => orderedEachInside
                        (not expressionScheduled![orderedEachBodySearch! - expressionStart] and orderedEachInside) -> if { true => orderedEachHasPendingBody! }
                        orderedEachBodySearch! + 1 => orderedEachBodySearch!
                    }
                    orderedEachHasPendingBody! -> if { orderedEachCandidate => pendingEach! }
                }
                pendingEachOrderIndex! - 1 => pendingEachOrderIndex!
            }
            expressionStart => scheduleCandidate!
            scheduleCandidate! < functionEnd! -> while {
                not expressionScheduled![scheduleCandidate! - expressionStart] -> if {
                    context.ir[scheduleCandidate!] => scheduleNode
                    scheduleNode.parent => scheduleAncestor!
                    scheduleNode.kind == 19 => insideControlRegion!
                    (scheduleAncestor! >= expressionStart and not insideControlRegion!) -> while {
                        (context.ir[scheduleAncestor!].kind == 19 or context.ir[scheduleAncestor!].kind == 20) -> if { true => insideControlRegion! } else { context.ir[scheduleAncestor!].parent => scheduleAncestor! }
                    }
                    false => insideIfCondition!
                    expressionStart => ifConditionSearch!
                    ifConditionSearch! < functionEnd! -> while {
                        context.ir[ifConditionSearch!] => ifConditionCandidate
                        ifConditionCandidate.kind == 18 -> if {
                            context.ir[ifConditionCandidate.operand0] => ifConditionRoot
                            (ifConditionRoot.kind == 8 and (ifConditionRoot.opcode == -25 or ifConditionRoot.opcode == -24) or (ifConditionRoot.kind == 7 and ifConditionRoot.opcode == -26)) -> if {
                                NodeAncestorRequest { nodeIndex: scheduleCandidate!, ownerIndex: ifConditionCandidate.operand0 } => ifAncestorRequest
                                ifAncestorRequest -> irDescendsFrom(context, state) => ifDescends
                                (scheduleCandidate! == ifConditionCandidate.operand0 or ifDescends) -> if {
                                    true => insideIfCondition!
                                }
                            }
                        }
                        ifConditionSearch! + 1 => ifConditionSearch!
                    }
                    insideIfCondition! -> if { true => insideControlRegion! }
                    (scheduleNode.kind == 17 and scheduleNode.operand0 >= expressionStart and scheduleNode.operand0 < functionEnd! and not insideControlRegion!) -> if {
                        context.ir[scheduleNode.operand0].parent => bindingScheduleAncestor!
                        (bindingScheduleAncestor! >= expressionStart and not insideControlRegion!) -> while {
                            context.ir[bindingScheduleAncestor!].kind == 19 -> if { true => insideControlRegion! } else { context.ir[bindingScheduleAncestor!].parent => bindingScheduleAncestor! }
                        }
                    }
                    (insideControlRegion! or scheduleNode.kind == 19) -> if {
                        true => expressionScheduled![scheduleCandidate! - expressionStart]
                        true => scheduleProgress!
                    }
                    true => scheduleReady!
                    (insideControlRegion! or scheduleNode.kind == 19) -> if { false => scheduleReady! }
                    false => scheduleInsidePendingEach!
                    pendingEach! >= 0 -> if {
                        NodeAncestorRequest { nodeIndex: scheduleCandidate!, ownerIndex: pendingEach! } => pendingEachAncestorRequest
                        pendingEachAncestorRequest -> irDescendsFrom(context, state) => scheduleInsidePendingEach!
                    }
                    (scheduleReady! and pendingEach! >= 0 and not scheduleInsidePendingEach!) -> if { false => scheduleReady! }
                    (scheduleReady! and scheduleNode.parent >= expressionStart) -> if {
                        scheduleCandidate! => eachBranchChild!
                        scheduleNode.parent => eachScheduleAncestor!
                        (eachScheduleAncestor! >= expressionStart and scheduleReady!) -> while {
                            context.ir[eachScheduleAncestor!] => eachScheduleOwner
                            (eachScheduleOwner.kind == 6 and eachScheduleOwner.opcode == -208 and eachBranchChild! != eachScheduleOwner.operand0 and not expressionScheduled![eachScheduleAncestor! - expressionStart]) -> if { false => scheduleReady! }
                            eachScheduleAncestor! => eachBranchChild!
                            context.ir[eachScheduleAncestor!].parent => eachScheduleAncestor!
                        }
                    }
                    (scheduleReady! and scheduleNode.operand0 >= expressionStart and scheduleNode.operand0 < functionEnd! and (scheduleNode.kind != 5 or context.ir[scheduleNode.operand0].flags % 2 == 0) and not expressionScheduled![scheduleNode.operand0 - expressionStart]) -> if { false => scheduleReady! }
                    (scheduleReady! and scheduleNode.kind == 5 and scheduleNode.operand0 >= expressionStart and scheduleNode.operand0 < functionEnd! and context.ir[scheduleNode.operand0].kind == 17 and context.ir[scheduleNode.operand0].flags == 1) -> if {
                        scheduleNode.operand0 -> mutableBindingRoot(context, state) => scheduleMutableReadRoot
                        # A mutable rebind reads the slot value that existed
                        # before its own store. Do not turn that read into a
                        # dependency on the store currently being scheduled.
                        (scheduleMutableReadRoot != scheduleNode.operand0 and scheduleMutableReadRoot >= expressionStart and scheduleMutableReadRoot < functionEnd! and not expressionScheduled![scheduleMutableReadRoot - expressionStart]) -> if { false => scheduleReady! }
                    }
                    (scheduleReady! and scheduleNode.kind != 6 and scheduleNode.kind != 18 and scheduleNode.kind != 20 and scheduleNode.kind != 27 and scheduleNode.kind != 33 and scheduleNode.operand1 >= expressionStart and scheduleNode.operand1 < functionEnd! and not expressionScheduled![scheduleNode.operand1 - expressionStart]) -> if { false => scheduleReady! }
                    (scheduleReady! and scheduleNode.kind == 6 and scheduleNode.opcode != -207 and scheduleNode.opcode != -208 and scheduleNode.opcode != -209 and scheduleNode.operand1 >= expressionStart and scheduleNode.operand1 < functionEnd!) -> if {
                        scheduleNode.operand1 -> aggregateValueIndex(context, state) => scheduleAdditionalArgument
                        (scheduleAdditionalArgument >= expressionStart and scheduleAdditionalArgument < functionEnd! and not expressionScheduled![scheduleAdditionalArgument - expressionStart]) -> if { false => scheduleReady! }
                    }
                    (scheduleReady! and (scheduleNode.kind == 9 or (scheduleNode.kind == 6 and scheduleNode.opcode == -1)) and scheduleNode.operand0 >= expressionStart) -> if {
                        scheduleNode.operand0 => scheduleCallArgument!
                        (scheduleCallArgument! >= expressionStart and scheduleCallArgument! < functionEnd! and context.ir[scheduleCallArgument!].parent == scheduleCandidate!) -> while {
                            not expressionScheduled![scheduleCallArgument! - expressionStart] -> if { false => scheduleReady! }
                            scheduleCallArgument! -> aggregateValueIndex(context, state) => scheduleCallArgumentValue
                            (scheduleCallArgumentValue >= expressionStart
                                and scheduleCallArgumentValue < functionEnd!
                                and not expressionScheduled![scheduleCallArgumentValue - expressionStart]) -> if { false => scheduleReady! }
                            context.ir[scheduleCallArgument!].nextOperand => scheduleCallArgument!
                        }
                    }
                    # A call with declared external effects may be bound and
                    # consumed only later. Keep it behind earlier source
                    # bindings so a ready read cannot leap over a still-
                    # computing publish/write binding. Console intrinsics keep
                    # the same source-order barrier.
                    scheduleNode -> callHasDeclaredEffects(context, state) => scheduleCallHasEffects
                    (scheduleReady! and scheduleNode.kind == 6 and (scheduleNode.symbol == -101 or scheduleNode.symbol == -102 or scheduleCallHasEffects)) -> if {
                        expressionStart => scheduleCallBindingSearch!
                        scheduleCallBindingSearch! < functionEnd! -> while {
                            context.ir[scheduleCallBindingSearch!] => scheduleCallBinding
                            NodeAncestorRequest { nodeIndex: scheduleCandidate!, ownerIndex: scheduleCallBindingSearch! } => scheduleCallBindingOwnerRequest
                            scheduleCallBindingOwnerRequest -> irDescendsFrom(context, state) => scheduleCallInsideBinding
                            (scheduleCallBinding.kind == 17 and scheduleCallBinding.operand0 >= expressionStart and scheduleCallBinding.operand0 < functionEnd! and not scheduleCallInsideBinding and (scheduleCallBinding -> sourceStart(context, state)) < (scheduleNode -> sourceStart(context, state)) and not expressionScheduled![scheduleCallBindingSearch! - expressionStart]) -> if { false => scheduleReady! }
                            scheduleCallBindingSearch! + 1 => scheduleCallBindingSearch!
                        }
                    }
                    (scheduleReady! and (scheduleNode.kind == 9 or scheduleNode.kind == 6) and scheduleNode.opcode == -203 and scheduleNode.operand1 >= 0 and context.ir[scheduleNode.operand1].nextOperand >= expressionStart and context.ir[scheduleNode.operand1].nextOperand < functionEnd! and not expressionScheduled![context.ir[scheduleNode.operand1].nextOperand - expressionStart]) -> if { false => scheduleReady! }
                    (scheduleReady! and scheduleNode.kind == 9 and (scheduleNode.opcode == -204 or scheduleNode.opcode == -213) and scheduleNode.operand1 >= 0) -> if {
                        scheduleNode.operand1 -> aggregateValueIndex(context, state) => schedulePushValue
                        (schedulePushValue >= expressionStart and schedulePushValue < functionEnd! and not expressionScheduled![schedulePushValue - expressionStart]) -> if { false => scheduleReady! }
                    }
                    (scheduleReady! and scheduleNode.kind == 26 and scheduleNode.operand0 >= 0) -> if {
                        scheduleNode.operand0 -> aggregateValueIndex(context, state) => scheduleEnumPayloadValue
                        (scheduleEnumPayloadValue >= expressionStart and scheduleEnumPayloadValue < functionEnd! and not expressionScheduled![scheduleEnumPayloadValue - expressionStart]) -> if { false => scheduleReady! }
                    }
                    (scheduleReady! and (scheduleNode.kind == 12 or scheduleNode.kind == 14 or scheduleNode.kind == 16)) -> if {
                        scheduleNode.operand0 => scheduleSibling!
                        scheduleSibling! >= 0 -> while {
                            scheduleSibling! -> aggregateValueIndex(context, state) => scheduleAggregateValue
                            not expressionScheduled![scheduleAggregateValue - expressionStart] -> if { false => scheduleReady! }
                            context.ir[scheduleSibling!].nextOperand => scheduleSibling!
                        }
                    }
                    (scheduleReady! and (scheduleNode.kind == 18 or scheduleNode.kind == 20 or scheduleNode.kind == 33)) -> if {
                        expressionStart => controlDependencySearch!
                        controlDependencySearch! < functionEnd! -> while {
                            context.ir[controlDependencySearch!] => controlDependencyUse
                            controlDependencyUse.parent => controlDependencyAncestor!
                            false => controlDependencyInside!
                            (controlDependencyAncestor! >= expressionStart and not controlDependencyInside!) -> while {
                                (controlDependencyAncestor! == scheduleNode.operand1 or (scheduleNode.kind == 20 and controlDependencyAncestor! == scheduleNode.operand0) or (scheduleNode.kind == 18 and scheduleNode.nextOperand >= 0 and controlDependencyAncestor! == scheduleNode.nextOperand)) -> if { true => controlDependencyInside! } else { context.ir[controlDependencyAncestor!].parent => controlDependencyAncestor! }
                            }
                            (controlDependencyInside! and controlDependencyUse.kind == 5 and controlDependencyUse.operand0 >= expressionStart and controlDependencyUse.operand0 < functionEnd! and context.ir[controlDependencyUse.operand0].kind == 17 and context.ir[controlDependencyUse.operand0].flags != 1) -> if {
                                context.ir[controlDependencyUse.operand0].operand0 => controlDependencyValue!
                                (controlDependencyValue! >= expressionStart and controlDependencyValue! < functionEnd!) -> if {
                                    context.ir[controlDependencyValue!].parent => controlDependencyValueAncestor!
                                    false => controlDependencyValueInside!
                                    (controlDependencyValueAncestor! >= expressionStart and not controlDependencyValueInside!) -> while {
                                        (controlDependencyValueAncestor! == scheduleNode.operand1 or (scheduleNode.kind == 20 and controlDependencyValueAncestor! == scheduleNode.operand0) or (scheduleNode.kind == 18 and scheduleNode.nextOperand >= 0 and controlDependencyValueAncestor! == scheduleNode.nextOperand)) -> if { true => controlDependencyValueInside! } else { context.ir[controlDependencyValueAncestor!].parent => controlDependencyValueAncestor! }
                                    }
                                    (not controlDependencyValueInside! and not expressionScheduled![controlDependencyValue! - expressionStart]) -> if { false => scheduleReady! }
                                }
                            }
                            controlDependencyInside! -> if {
                                0 => controlDirectOperandIndex!
                                controlDirectOperandIndex! < 2 -> while {
                                    controlDependencyUse.operand0 => controlDirectOperand!
                                    controlDirectOperandIndex! == 1 -> if { controlDependencyUse.operand1 => controlDirectOperand! }
                                    (controlDirectOperand! >= expressionStart
                                        and controlDirectOperand! < functionEnd!
                                        and context.ir[controlDirectOperand!].kind == 17
                                        and context.ir[controlDirectOperand!].flags == 1) -> if {
                                        -1 => controlDirectOperand!
                                    }
                                    (controlDirectOperand! >= expressionStart and controlDirectOperand! < functionEnd!) -> if {
                                        context.ir[controlDirectOperand!].parent => controlDirectOperandAncestor!
                                        false => controlDirectOperandInside!
                                        controlDirectOperand! == scheduleNode.operand1 -> if { true => controlDirectOperandInside! }
