            nestedShortCircuit -> if {
                WhileBranchRequest { whileIndex: regionNodeIndex!, ownerIndex: ownerIndex!, conditionIndex: nestedConditionIndex! } -> emitWhileBranch(context, state)
                "while$(regionNodeIndex!)_body:" -> println
                "  br label %if$(regionNodeIndex!)_then" -> println
                "while$(regionNodeIndex!)_exit:" -> println
                regionNode.nextOperand >= 0 -> if { "  br label %if$(regionNodeIndex!)_else" -> println } else { "  br label %if$(regionNodeIndex!)_merge" -> println }
            } else {
                "  br i1 " -> print
                nestedCondition.kind == 4 -> if {
                    nestedCondition -> sourceToken(context, state) => nestedConditionToken
                    ((context.sources[nestedCondition.sourceModule] -> byte(nestedConditionToken.span.start)) == UInt8(116)) -> if { "1" -> print } else { "0" -> print }
                } else {
                    (ownerIndex! >= 0 and context.ir[ownerIndex!].kind == 0 and context.ir[ownerIndex!].operand1 >= 0 and nestedCondition.kind == 5 and nestedCondition.symbol == context.ir[context.ir[ownerIndex!].operand1].symbol) -> if { "%arg" -> print } else { "%v$(nestedConditionIndex!)" -> print }
                }
                regionNode.nextOperand >= 0 -> if { ", label %if$(regionNodeIndex!)_then, label %if$(regionNodeIndex!)_else" -> println } else { ", label %if$(regionNodeIndex!)_then, label %if$(regionNodeIndex!)_merge" -> println }
            }
            "if$(regionNodeIndex!)_then:" -> println
            false => regionTerminated!
            }
        }
        regionEventKind == 3 -> if {
            ifActive![regionNodeIndex! - regionLocalStart] -> if {
                not regionTerminated! -> if {
                    regionNodeIndex! -> irValueUsed(ownerIndex!, context, state) => nestedThenValueUsed
                    (nestedThenValueUsed and not (regionNode.typeOrigin == 1 and regionNode.typeSymbol == 0) and regionNode.nextOperand >= 0) -> if {
                        regionNode.operand1 -> regionResultValueIndex(context, state) => nestedThenStoreIndex
                        regionNode -> emitIfResultStore(nestedThenStoreIndex, ownerIndex!, regionNodeIndex!, 0, context, state)
                    }
                    OwnedDropRequest { regionIndex: regionNode.operand1, beforeAst: -1, edgeIndex: regionNodeIndex! * 10 + 1, transferredSymbol: -1 } -> emitOwnedDrops(context, state)
                    "  br label %if$(regionNodeIndex!)_merge" -> println
                    true => ifThenReachesMerge![regionNodeIndex! - regionLocalStart]
                }
                "if$(regionNodeIndex!)_else:" -> println
                false => regionTerminated!
            }
        }
        regionEventKind == 4 -> if {
            ifActive![regionNodeIndex! - regionLocalStart] -> if {
            regionNode.nextOperand < 0 -> if { true => ifThenReachesMerge![regionNodeIndex! - regionLocalStart] }
            not regionTerminated! -> if {
                regionNode.nextOperand >= 0 -> if {
                    regionNodeIndex! -> irValueUsed(ownerIndex!, context, state) => nestedElseValueUsed
                    (nestedElseValueUsed and not (regionNode.typeOrigin == 1 and regionNode.typeSymbol == 0)) -> if {
                        regionNode.nextOperand -> regionResultValueIndex(context, state) => nestedElseStoreIndex
                        regionNode -> emitIfResultStore(nestedElseStoreIndex, ownerIndex!, regionNodeIndex!, 1, context, state)
                    }
                    OwnedDropRequest { regionIndex: regionNode.nextOperand, beforeAst: -1, edgeIndex: regionNodeIndex! * 10 + 2, transferredSymbol: -1 } -> emitOwnedDrops(context, state)
                } else {
                    OwnedDropRequest { regionIndex: regionNode.operand1, beforeAst: -1, edgeIndex: regionNodeIndex! * 10 + 2, transferredSymbol: -1 } -> emitOwnedDrops(context, state)
                }
                "  br label %if$(regionNodeIndex!)_merge" -> println
                true => ifThenReachesMerge![regionNodeIndex! - regionLocalStart]
            }
            ifThenReachesMerge![regionNodeIndex! - regionLocalStart] -> if {
                "if$(regionNodeIndex!)_merge:" -> println
                false => regionTerminated!
                regionNodeIndex! -> irValueUsed(ownerIndex!, context, state) => nestedMergeValueUsed
                (nestedMergeValueUsed and not (regionNode.typeOrigin == 1 and regionNode.typeSymbol == 0) and regionNode.nextOperand >= 0) -> if {
                    "  %v$(regionNodeIndex!) = load " -> print
                    regionNode -> writeIrType(context, state)
                    ", ptr %if$(regionNodeIndex!)_result, align " -> print
                    regionNode -> storageAlign(context, state) -> writeDecimalLine
                }
            }
            }
        }
        regionEventKind == 6 -> if {
            not regionTerminated! -> if {
                true => loopActive![regionNodeIndex! - regionLocalStart]
                "  br label %while$(regionNodeIndex!)_header" -> println
                "while$(regionNodeIndex!)_header:" -> println
                false => regionTerminated!
            }
        }
        regionEventKind == 7 -> if {
            loopActive![regionNodeIndex! - regionLocalStart] -> if {
                WhileBranchRequest { whileIndex: regionNodeIndex!, ownerIndex: ownerIndex!, conditionIndex: regionNode.operand0 } -> emitWhileBranch(context, state)
                "while$(regionNodeIndex!)_body:" -> println
                false => regionTerminated!
            }
        }
        regionEventKind == 8 -> if {
            loopActive![regionNodeIndex! - regionLocalStart] -> if {
                not regionTerminated! -> if {
                    OwnedDropRequest { regionIndex: regionNode.operand1, beforeAst: -1, edgeIndex: regionNodeIndex! * 10 + 3, transferredSymbol: -1 } -> emitOwnedDrops(context, state)
                    "  br label %while$(regionNodeIndex!)_header" -> println
                }
                "while$(regionNodeIndex!)_exit:" -> println
                false => regionTerminated!
            }
        }
        regionOrderIndex! + 1 => regionOrderIndex!
    }
}
emitEnumMatch matchIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[matchIndex] => match
    context.ir[match.operand0] => subject
    matchIndex => matchOwner!
    (matchOwner! >= 0 and context.ir[matchOwner!].kind != 0 and context.ir[matchOwner!].kind != 11) -> while {
        context.ir[matchOwner!].parent => matchOwner!
    }
    matchOwner! + 1 => matchOwnerStart
    matchOwner! -> functionEnd(context, state) => matchOwnerEnd
    matchIndex - 1 => matchOwnerIndex!
    (matchOwnerIndex! >= 0 and context.ir[matchOwnerIndex!].kind != 0 and context.ir[matchOwnerIndex!].kind != 11) -> while {
        matchOwnerIndex! - 1 => matchOwnerIndex!
    }
    matchIndex -> irValueUsed(matchOwner!, context, state) => matchValueUsed
    -1 => ownedMatchFileTypeId!
    (subject.typeId >= 0 and context.types[subject.typeId].kind == 7 and context.types[subject.typeId].first >= 0) -> if {
        context.types[subject.typeId].first => matchPayloadTypeId
        matchPayloadTypeId -> isOwnedFileType(context, state) -> if { matchPayloadTypeId => ownedMatchFileTypeId! }
    }
    "  %v$(matchIndex)_tag = extractvalue " -> print
    subject -> writeIrType(context, state)
    " " -> print
    (subject.kind == 5 and subject.parent >= 0 and context.ir[subject.parent].kind == 1 and context.ir[subject.parent].parent >= 0 and context.ir[context.ir[subject.parent].parent].operand1 >= 0 and subject.symbol == context.ir[context.ir[context.ir[subject.parent].parent].operand1].symbol) -> if { "%arg" -> print } else { "%v$(match.operand0)" -> print }
    ", 0" -> println
    "  %v$(matchIndex)_subject_slot = alloca " -> print
    subject -> writeIrType(context, state)
    ", align 8" -> println
    "  store " -> print
    subject -> writeIrType(context, state)
    " " -> print
    (subject.kind == 5 and subject.parent >= 0 and context.ir[subject.parent].kind == 1 and context.ir[subject.parent].parent >= 0 and context.ir[context.ir[subject.parent].parent].operand1 >= 0 and subject.symbol == context.ir[context.ir[context.ir[subject.parent].parent].operand1].symbol) -> if { "%arg" -> print } else { "%v$(match.operand0)" -> print }
    ", ptr %v$(matchIndex)_subject_slot, align 8" -> println
    (matchValueUsed and not (match.typeOrigin == 1 and match.typeSymbol == 0)) -> if {
        "  %v$(matchIndex)_result = alloca " -> print
        match -> writeIrType(context, state)
        ", align " -> print
        match -> storageAlign(context, state) -> writeDecimalLine
    }
    match.operand1 => armIndex!
    0 => armOrdinal!
    armIndex! >= 0 -> while {
        context.ir[armIndex!] => arm
        "  %v$(matchIndex)_is_arm$(armOrdinal!) = icmp eq i32 %v$(matchIndex)_tag, $(arm.opcode)" -> println
        "  br i1 %v$(matchIndex)_is_arm$(armOrdinal!), label %match$(matchIndex)_arm$(armOrdinal!), label %match$(matchIndex)_next$(armOrdinal!)" -> println
        "match$(matchIndex)_arm$(armOrdinal!):" -> println
        -1 => armBindingIndex!
        false => armBindingTransferred!
        matchOwnerStart => armBindingSearch!
        armBindingSearch! < matchOwnerEnd -> while {
            (context.ir[armBindingSearch!].kind == 29 and context.ir[armBindingSearch!].parent == armIndex!) -> if { armBindingSearch! => armBindingIndex! }
            armBindingSearch! + 1 => armBindingSearch!
        }
        armBindingIndex! >= 0 -> if {
            context.ir[armBindingIndex!] => armBinding
            not (armBinding.typeOrigin == 1 and armBinding.typeSymbol == 0) -> if {
            "  %v$(matchIndex)_arm$(armOrdinal!)_payload = getelementptr inbounds " -> print
            subject -> writeIrType(context, state)
            ", ptr %v$(matchIndex)_subject_slot, i32 0, i32 1" -> println
            "  %v$(armBindingIndex!) = load " -> print
            armBinding -> writeIrType(context, state)
            ", ptr %v$(matchIndex)_arm$(armOrdinal!)_payload, align " -> print
            armBinding -> storageAlign(context, state) -> writeDecimalLine
            }
        }
        armIndex! => emittedArmRegion!
        (arm.operand1 >= 0 and context.ir[arm.operand1].kind == 19) -> if {
            false => nestedArmHasExplicitReturn!
            matchOwnerStart => nestedArmReturnSearch!
            nestedArmReturnSearch! < matchOwnerEnd -> while {
                (context.ir[nestedArmReturnSearch!].parent == arm.operand1 and context.ir[nestedArmReturnSearch!].kind == 23) -> if { true => nestedArmHasExplicitReturn! }
                nestedArmReturnSearch! + 1 => nestedArmReturnSearch!
            }
            not nestedArmHasExplicitReturn! -> if { arm.operand1 => emittedArmRegion! }
        }
        emittedArmRegion! -> emitRegion(context, state)
        (matchValueUsed and not (match.typeOrigin == 1 and match.typeSymbol == 0)) -> if {
            armIndex! -> matchRegionResultValueIndex(context, state) => armValueIndex
            context.ir[armValueIndex] => armValue
            (armValue.kind == 26 and armValue.parent != armIndex! and armValue.parent != emittedArmRegion!) -> if {
                WhileValueRequest { whileIndex: armValueIndex, ownerIndex: matchIndex, nodeIndex: armValueIndex } -> emitEnumConstructor(context, state)
            }
            (armBindingIndex! < 0 and (armValueIndex == armIndex! or (armValue.kind == 19 and armValue.operand0 < 0))) => directArmPayload
            0 => safeArmBindingIndex!
            armBindingIndex! >= 0 -> if { armBindingIndex! => safeArmBindingIndex! }
            context.ir[safeArmBindingIndex!].symbol => resolvedArmBindingSymbol
            (armBindingIndex! >= 0 and armValue.kind == 5 and armValue.parent != armIndex! and (armValue.operand0 == armBindingIndex! or armValue.symbol == resolvedArmBindingSymbol)) => armValueUsesBlockBinding
            armValueUsesBlockBinding -> if { true => armBindingTransferred! }
            0 => safeMatchTypeIndex!
            match.typeId >= 0 -> if { match.typeId => safeMatchTypeIndex! }
            context.types[safeMatchTypeIndex!].kind => resolvedMatchTypeKind
            (armBindingIndex! >= 0 and armValue.kind == 19 and armValue.operand0 < 0 and (match.typeKind == 7 or (match.typeId >= 0 and resolvedMatchTypeKind == 7))) => emptyPayloadlessArm
            directArmPayload -> if {
                "  %v$(matchIndex)_arm$(armOrdinal!)_direct_payload = getelementptr inbounds " -> print
                subject -> writeIrType(context, state)
                ", ptr %v$(matchIndex)_subject_slot, i32 0, i32 1" -> println
                "  %v$(matchIndex)_arm$(armOrdinal!)_direct_value = load " -> print
                match -> writeIrType(context, state)
                ", ptr %v$(matchIndex)_arm$(armOrdinal!)_direct_payload, align " -> print
                match -> storageAlign(context, state) -> writeDecimalLine
            }
            "  store " -> print
            match -> writeIrType(context, state)
            " " -> print
            directArmPayload -> if { "%v$(matchIndex)_arm$(armOrdinal!)_direct_value" -> print } else {
            emptyPayloadlessArm -> if { "zeroinitializer" -> print } else {
            armValueUsesBlockBinding -> if { "%v$(armBindingIndex!)" -> print } else {
            (armValue.kind == 3 or armValue.kind == 4) -> if {
                armValue -> sourceToken(context, state) => armValueToken
                armValue.kind == 3 -> if { context.sources[armValue.sourceModule] -> slice(armValueToken.span.start, armValueToken.span.length) -> print } else {
                    ((context.sources[armValue.sourceModule] -> byte(armValueToken.span.start)) == UInt8(116)) -> if { "1" -> print } else { "0" -> print }
                }
            } else { "%v$(armValueIndex)" -> print }
            }
            }
            }
            ", ptr %v$(matchIndex)_result, align " -> print
            match -> storageAlign(context, state) -> writeDecimalLine
        }
        false => armBindingMoved!
        0 => armBindingMoveIndex!
        (armBindingIndex! >= 0 and armBindingMoveIndex! < (context.moves -> len) and not armBindingMoved!) -> while {
            context.moves[armBindingMoveIndex!] => armBindingMove
            (armBindingMove.memberIr < 0 and armBindingMove.sourceModule == context.ir[armBindingIndex!].sourceModule and armBindingMove.symbol == context.ir[armBindingIndex!].symbol and (armBindingMove.regionIr == emittedArmRegion! or armBindingMove.regionIr == armIndex!)) -> if { true => armBindingMoved! }
            armBindingMoveIndex! + 1 => armBindingMoveIndex!
        }
        (armBindingIndex! >= 0 and context.ir[armBindingIndex!].typeId >= 0 and (context.ir[armBindingIndex!].typeId -> semanticTypeOwns(context, state)) and not armBindingTransferred! and not armBindingMoved!) -> if {
            context.ir[armBindingIndex!].typeId => armBindingTypeId
            "  call void @sollang_drop_t$armBindingTypeId(" -> print
            context.ir[armBindingIndex!].typeId -> writeSemanticTypeId(context, state)
            " %v$(armBindingIndex!))" -> println
        }
        "  br label %match$(matchIndex)_merge" -> println
        "match$(matchIndex)_next$(armOrdinal!):" -> println
        arm.nextOperand => armIndex!
        armOrdinal! + 1 => armOrdinal!
    }
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "match$(matchIndex)_merge:" -> println
    (matchValueUsed and not (match.typeOrigin == 1 and match.typeSymbol == 0)) -> if {
        "  %v$(matchIndex) = load " -> print
        match -> writeIrType(context, state)
        ", ptr %v$(matchIndex)_result, align " -> print
        match -> storageAlign(context, state) -> writeDecimalLine
    }
    (ownedMatchFileTypeId! >= 0 and match.typeId != ownedMatchFileTypeId!) -> if {
        "  %v$(matchIndex)_owned_file_present = icmp eq i32 %v$(matchIndex)_tag, 0" -> println
        "  br i1 %v$(matchIndex)_owned_file_present, label %match$(matchIndex)_owned_file_close, label %match$(matchIndex)_owned_file_done" -> println
        "match$(matchIndex)_owned_file_close:" -> println
        "  %v$(matchIndex)_owned_file_payload = getelementptr inbounds " -> print
        subject -> writeIrType(context, state)
        ", ptr %v$(matchIndex)_subject_slot, i32 0, i32 1" -> println
        "  %v$(matchIndex)_owned_file_value = load " -> print
        ownedMatchFileTypeId! -> writeSemanticTypeId(context, state)
        ", ptr %v$(matchIndex)_owned_file_payload, align 8" -> println
        "  %v$(matchIndex)_owned_file_handle = extractvalue " -> print
        ownedMatchFileTypeId! -> writeSemanticTypeId(context, state)
        " %v$(matchIndex)_owned_file_value, 0" -> println
        "  call void @sollang_platform_close_owned_file(i64 %v$(matchIndex)_owned_file_handle)" -> println
        "  br label %match$(matchIndex)_owned_file_done" -> println
        "match$(matchIndex)_owned_file_done:" -> println
    }
}
