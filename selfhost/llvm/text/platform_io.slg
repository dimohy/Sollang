# Responsibility fragment extracted from emitCore. State is passed by readonly
# reference, preserving the original direct-call and allocation behavior.
emitEnumConstructor request: WhileValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[request.nodeIndex] => constructor
    constructor -> enumVariantTag(context, state) => variantTag
    "  %v$(request.nodeIndex)_enum_slot = alloca " -> print
    constructor -> writeIrType(context, state)
    ", align 8" -> println
    "  store " -> print
    constructor -> writeIrType(context, state)
    " zeroinitializer, ptr %v$(request.nodeIndex)_enum_slot, align 8" -> println
    "  %v$(request.nodeIndex)_enum_tag = getelementptr inbounds " -> print
    constructor -> writeIrType(context, state)
    ", ptr %v$(request.nodeIndex)_enum_slot, i32 0, i32 0" -> println
    "  store i32 $variantTag, ptr %v$(request.nodeIndex)_enum_tag, align 4" -> println
    constructor.operand0 >= 0 -> if {
        constructor.operand0 -> aggregateValueIndex(context, state) => payloadIndex
        context.ir[payloadIndex] => payload
        payload -> effectiveTypeId(context, state) => payloadTypeId
        (payloadTypeId < 0 or context.typeSizes[payloadTypeId] > 0) -> if {
            "  %v$(request.nodeIndex)_enum_payload = getelementptr inbounds " -> print
            constructor -> writeIrType(context, state)
            ", ptr %v$(request.nodeIndex)_enum_slot, i32 0, i32 1" -> println
            "  store " -> print
            payload -> writeIrType(context, state)
            " " -> print
            (payload.kind == 3 or payload.kind == 4) -> if {
                payload -> sourceToken(context, state) => payloadToken
                payload.kind == 3 -> if {
                    context.sources[payload.sourceModule] -> slice(payloadToken.span.start, payloadToken.span.length) -> print
                } else {
                    ((context.sources[payload.sourceModule] -> byte(payloadToken.span.start)) == UInt8(116)) -> if { "1" -> print } else { "0" -> print }
                }
            } else {
                (payload.kind == 5 and request.ownerIndex >= 0 and context.ir[request.ownerIndex].operand1 >= 0 and payload.symbol == context.ir[context.ir[request.ownerIndex].operand1].symbol) -> if { "%arg" -> print } else { "%v$(payloadIndex)" -> print }
            }
            ", ptr %v$(request.nodeIndex)_enum_payload, align " -> print
            payload -> storageAlign(context, state) -> writeDecimalLine
        }
    }
    "  %v$(request.nodeIndex) = load " -> print
    constructor -> writeIrType(context, state)
    ", ptr %v$(request.nodeIndex)_enum_slot, align 8" -> println
}
emitProcessCall request: ProcessCallRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[request.callIndex] => call
    request.callIndex -> callArgumentIndex(context, state) => argumentIndex!
    # Contextual flow conversion currently appears as the zero-value
    # process.arguments intrinsic wrapped around the actual aggregate.
    # It carries no runtime value, so recover the canonical operand before
    # lowering run/runToFile.
    (argumentIndex! >= 0 and context.ir[argumentIndex!].kind == 6 and context.ir[argumentIndex!].opcode == -212 and context.ir[argumentIndex!].operand0 >= 0) -> while {
        context.ir[argumentIndex!].operand0 -> aggregateValueIndex(context, state) => argumentIndex!
    }
    argumentIndex! => resolvedArgumentIndex
    context.ir[argumentIndex!] => argument
    -1 => processArgumentMutableRoot!
    (argument.kind == 17 and argument.flags == 1) -> if {
        argumentIndex! -> mutableBindingRoot(context, state) => processArgumentMutableRoot!
        "  %v$(request.callIndex)_process_argument = load " -> print
        argument -> writeIrType(context, state)
        ", ptr %slot" -> print
        processArgumentMutableRoot! -> writeDecimal
        ", align " -> print
        argument -> storageAlign(context, state) -> writeDecimalLine
    }
    call.opcode == -210 -> if {
        "  %v$(request.callIndex)_process_records = extractvalue " -> print
        argument -> writeIrType(context, state)
        " " -> print
        processArgumentMutableRoot! >= 0 -> if { "%v$(request.callIndex)_process_argument" -> print } else {
            (argument.kind == 5 and request.ownerIndex >= 0 and context.ir[request.ownerIndex].kind == 0 and context.ir[request.ownerIndex].operand1 >= 0 and argument.symbol == context.ir[context.ir[request.ownerIndex].operand1].symbol) -> if { "%arg" -> print } else { "%v$(resolvedArgumentIndex)" -> print }
        }
        ", 0" -> println
        "  %v$(request.callIndex)_process_count = extractvalue " -> print
        argument -> writeIrType(context, state)
        " " -> print
        processArgumentMutableRoot! >= 0 -> if { "%v$(request.callIndex)_process_argument" -> print } else {
            (argument.kind == 5 and request.ownerIndex >= 0 and context.ir[request.ownerIndex].kind == 0 and context.ir[request.ownerIndex].operand1 >= 0 and argument.symbol == context.ir[context.ir[request.ownerIndex].operand1].symbol) -> if { "%arg" -> print } else { "%v$(resolvedArgumentIndex)" -> print }
        }
        ", 1" -> println
        "  %v$(request.callIndex)_process_raw = call %sollang.process_result @sollang_run_process(ptr %v$(request.callIndex)_process_records, i64 %v$(request.callIndex)_process_count)" -> println
    } else {
        -1 => argvFieldType!
        -1 => outputFieldType!
        0 => processFieldIndex!
        processFieldIndex! < (context.fields -> len) -> while {
            context.fields[processFieldIndex!] => processField
            (processField.status == 0 and processField.ownerType == argument.typeId and processField.ordinal == 0) -> if { processField.fieldType => argvFieldType! }
            (processField.status == 0 and processField.ownerType == argument.typeId and processField.ordinal == 1) -> if { processField.fieldType => outputFieldType! }
            processFieldIndex! + 1 => processFieldIndex!
        }
        "  %v$(request.callIndex)_process_argv = extractvalue " -> print
        argument -> writeIrType(context, state)
        " " -> print
        processArgumentMutableRoot! >= 0 -> if { "%v$(request.callIndex)_process_argument" -> print } else {
            (argument.kind == 5 and request.ownerIndex >= 0 and context.ir[request.ownerIndex].kind == 0 and context.ir[request.ownerIndex].operand1 >= 0 and argument.symbol == context.ir[context.ir[request.ownerIndex].operand1].symbol) -> if { "%arg" -> print } else { "%v$(resolvedArgumentIndex)" -> print }
        }
        ", 0" -> println
        "  %v$(request.callIndex)_process_output = extractvalue " -> print
        argument -> writeIrType(context, state)
        " " -> print
        processArgumentMutableRoot! >= 0 -> if { "%v$(request.callIndex)_process_argument" -> print } else {
            (argument.kind == 5 and request.ownerIndex >= 0 and context.ir[request.ownerIndex].kind == 0 and context.ir[request.ownerIndex].operand1 >= 0 and argument.symbol == context.ir[context.ir[request.ownerIndex].operand1].symbol) -> if { "%arg" -> print } else { "%v$(resolvedArgumentIndex)" -> print }
        }
        ", 1" -> println
        "  %v$(request.callIndex)_process_records = extractvalue " -> print
        argvFieldType! -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_process_argv, 0" -> println
        "  %v$(request.callIndex)_process_count = extractvalue " -> print
        argvFieldType! -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_process_argv, 1" -> println
        "  %v$(request.callIndex)_process_output_ptr = extractvalue " -> print
        outputFieldType! -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_process_output, 0" -> println
        "  %v$(request.callIndex)_process_output_len = extractvalue " -> print
        outputFieldType! -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_process_output, 1" -> println
        "  %v$(request.callIndex)_process_raw = call %sollang.process_result @sollang_run_process_to_file(ptr %v$(request.callIndex)_process_records, i64 %v$(request.callIndex)_process_count, ptr %v$(request.callIndex)_process_output_ptr, i64 %v$(request.callIndex)_process_output_len)" -> println
    }
    "  %v$(request.callIndex)_process_exit = extractvalue %sollang.process_result %v$(request.callIndex)_process_raw, 0" -> println
    "  %v$(request.callIndex)_process_error = extractvalue %sollang.process_result %v$(request.callIndex)_process_raw, 1" -> println
    "  %v$(request.callIndex)_process_ok = icmp eq i32 %v$(request.callIndex)_process_error, 0" -> println
    "  %v$(request.callIndex)_process_result_slot = alloca " -> print
    call -> writeIrType(context, state)
    ", align 8" -> println
    "  store " -> print
    call -> writeIrType(context, state)
    " zeroinitializer, ptr %v$(request.callIndex)_process_result_slot, align 8" -> println
    "  br i1 %v$(request.callIndex)_process_ok, label %process$(request.callIndex)_ok, label %process$(request.callIndex)_error" -> println
    "process$(request.callIndex)_ok:" -> println
    "  %v$(request.callIndex)_process_ok_tag = getelementptr inbounds " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_process_result_slot, i32 0, i32 0" -> println
    "  store i32 0, ptr %v$(request.callIndex)_process_ok_tag, align 4" -> println
    "  %v$(request.callIndex)_process_ok_payload = getelementptr inbounds " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_process_result_slot, i32 0, i32 1" -> println
    "  store i32 %v$(request.callIndex)_process_exit, ptr %v$(request.callIndex)_process_ok_payload, align 4" -> println
    "  br label %process$(request.callIndex)_merge" -> println
    "process$(request.callIndex)_error:" -> println
    "  %v$(request.callIndex)_process_error_tag = getelementptr inbounds " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_process_result_slot, i32 0, i32 0" -> println
    "  store i32 1, ptr %v$(request.callIndex)_process_error_tag, align 4" -> println
    "  %v$(request.callIndex)_process_is_wait = icmp eq i32 %v$(request.callIndex)_process_error, 2" -> println
    "  %v$(request.callIndex)_process_is_signal = icmp eq i32 %v$(request.callIndex)_process_error, 3" -> println
    "  %v$(request.callIndex)_process_wait_ptr = select i1 %v$(request.callIndex)_process_is_wait, ptr @sollang_process_error_wait, ptr @sollang_process_error_spawn" -> println
    "  %v$(request.callIndex)_process_wait_len = select i1 %v$(request.callIndex)_process_is_wait, i64 4, i64 5" -> println
    "  %v$(request.callIndex)_process_error_ptr = select i1 %v$(request.callIndex)_process_is_signal, ptr @sollang_process_error_signal, ptr %v$(request.callIndex)_process_wait_ptr" -> println
    "  %v$(request.callIndex)_process_error_len = select i1 %v$(request.callIndex)_process_is_signal, i64 6, i64 %v$(request.callIndex)_process_wait_len" -> println
    "  %v$(request.callIndex)_process_error_text0 = insertvalue %sollang.text poison, ptr %v$(request.callIndex)_process_error_ptr, 0" -> println
    "  %v$(request.callIndex)_process_error_text = insertvalue %sollang.text %v$(request.callIndex)_process_error_text0, i64 %v$(request.callIndex)_process_error_len, 1" -> println
    "  %v$(request.callIndex)_process_error_payload = getelementptr inbounds " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_process_result_slot, i32 0, i32 1" -> println
    "  store %sollang.text %v$(request.callIndex)_process_error_text, ptr %v$(request.callIndex)_process_error_payload, align 8" -> println
    "  br label %process$(request.callIndex)_merge" -> println
    "process$(request.callIndex)_merge:" -> println
    "  %v$(request.callIndex) = load " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_process_result_slot, align 8" -> println
}
emitExitCall callIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    callIndex -> callArgumentIndex(context, state) => argumentIndex
    context.ir[argumentIndex] => argument
    context -> diagnostics.usesTextRuntime -> if { "  call void @sollang_runtime_flush_stdout()" -> println }
    context.expectedPathStyle == 1 -> if { "  call void @ExitProcess(i32 " -> print } else { "  call void @exit(i32 " -> print }
    argument.kind == 3 -> if {
        argument -> sourceToken(context, state) => argumentToken
        context.sources[argument.sourceModule] -> slice(argumentToken.span.start, argumentToken.span.length) -> print
    } else { "%v$(argumentIndex)" -> print }
    ")" -> println
}
emitFileCall request: FileCallRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[request.callIndex] => call
    -1 => enclosingFileMatch!
    call.parent => fileCallAncestor!
    (fileCallAncestor! >= 0 and enclosingFileMatch! < 0) -> while {
        context.ir[fileCallAncestor!].kind == 27 -> if { fileCallAncestor! => enclosingFileMatch! } else { context.ir[fileCallAncestor!].parent => fileCallAncestor! }
    }
    (call.opcode == -216 or call.opcode == -217) -> if {
        request.callIndex -> callArgumentIndex(context, state) => pathIndex!
        pathIndex! -> aggregateValueIndex(context, state) => pathIndex!
        context.ir[pathIndex!] => path
        "  %v$(request.callIndex)_file_path_data = extractvalue %sollang.text " -> print
             path.kind == 2 -> if {
                 path -> sourceToken(context, state) => pathToken
                 Int(TextLiteralRequest { sourceModule: path.sourceModule, token: pathToken } -> textLiteralLength(context, state)) => pathLength
                 "{ ptr @sollang_str_" -> print
                 pathIndex! -> writeDecimal
                 ", i64 " -> print
                 pathLength -> writeDecimal
                 " }" -> print
        } else { pathIndex! -> writeValue(request.ownerIndex, context, state) }
        ", 0" -> println
        "  %v$(request.callIndex)_file_path_length = extractvalue %sollang.text " -> print
             path.kind == 2 -> if {
                 path -> sourceToken(context, state) => pathLengthToken
                 Int(TextLiteralRequest { sourceModule: path.sourceModule, token: pathLengthToken } -> textLiteralLength(context, state)) => literalPathLength
                 "{ ptr @sollang_str_" -> print
                 pathIndex! -> writeDecimal
                 ", i64 " -> print
                 literalPathLength -> writeDecimal
                 " }" -> print
        } else { pathIndex! -> writeValue(request.ownerIndex, context, state) }
        ", 1" -> println
        "  %v$(request.callIndex)_file_open_raw = call %sollang.file_handle_result @sollang_platform_open_owned_" -> print
        call.opcode == -217 -> if { "write" -> print } else { "read" -> print }
        "_file(ptr %v$(request.callIndex)_file_path_data, i64 %v$(request.callIndex)_file_path_length)" -> println
        "  %v$(request.callIndex)_file_open_handle = extractvalue %sollang.file_handle_result %v$(request.callIndex)_file_open_raw, 0" -> println
        "  %v$(request.callIndex)_file_open_status = extractvalue %sollang.file_handle_result %v$(request.callIndex)_file_open_raw, 1" -> println
        "  %v$(request.callIndex)_file_open_ok = icmp ne i32 %v$(request.callIndex)_file_open_status, 0" -> println
        "  %v$(request.callIndex)_file_result_slot = alloca " -> print
        call -> writeIrType(context, state)
        ", align 8" -> println
        "  store " -> print
        call -> writeIrType(context, state)
        " zeroinitializer, ptr %v$(request.callIndex)_file_result_slot, align 8" -> println
        "  br i1 %v$(request.callIndex)_file_open_ok, label %file$(request.callIndex)_open_ok, label %file$(request.callIndex)_open_error" -> println
        "file$(request.callIndex)_open_ok:" -> println
        context.types[call.typeId].first => openedFileTypeId
        "  %v$(request.callIndex)_file_value = insertvalue " -> print
        openedFileTypeId -> writeSemanticTypeId(context, state)
        " poison, i64 %v$(request.callIndex)_file_open_handle, 0" -> println
        "  %v$(request.callIndex)_file_ok_tag = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_file_result_slot, i32 0, i32 0" -> println
        "  store i32 0, ptr %v$(request.callIndex)_file_ok_tag, align 4" -> println
        "  %v$(request.callIndex)_file_ok_payload = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_file_result_slot, i32 0, i32 1" -> println
        "  store " -> print
        openedFileTypeId -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_file_value, ptr %v$(request.callIndex)_file_ok_payload, align 8" -> println
        "  br label %file$(request.callIndex)_open_merge" -> println
        "file$(request.callIndex)_open_error:" -> println
        "  %v$(request.callIndex)_file_error_tag = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_file_result_slot, i32 0, i32 0" -> println
        "  store i32 1, ptr %v$(request.callIndex)_file_error_tag, align 4" -> println
        "  %v$(request.callIndex)_file_error_payload = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_file_result_slot, i32 0, i32 1" -> println
        "  %v$(request.callIndex)_file_error_text0 = insertvalue %sollang.text poison, ptr @sollang_file_error_io, 0" -> println
        "  %v$(request.callIndex)_file_error_text = insertvalue %sollang.text %v$(request.callIndex)_file_error_text0, i64 2, 1" -> println
        "  store %sollang.text %v$(request.callIndex)_file_error_text, ptr %v$(request.callIndex)_file_error_payload, align 8" -> println
        "  br label %file$(request.callIndex)_open_merge" -> println
        "file$(request.callIndex)_open_merge:" -> println
        "  %v$(request.callIndex) = load " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_file_result_slot, align 8" -> println
    }
    call.opcode == -218 -> if {
        enclosingFileMatch! >= 0 -> if {
            context.ir[enclosingFileMatch!] => syncWriterMatch
            context.types[context.ir[syncWriterMatch.operand0].typeId].first => syncWriterTypeId
            "  %v$(request.callIndex)_file_sync_writer_payload = getelementptr inbounds " -> print
            context.ir[syncWriterMatch.operand0] -> writeIrType(context, state)
            ", ptr %v$(enclosingFileMatch!)_subject_slot, i32 0, i32 1" -> println
            "  %v$(request.callIndex)_file_sync_writer = load " -> print
            syncWriterTypeId -> writeSemanticTypeId(context, state)
            ", ptr %v$(request.callIndex)_file_sync_writer_payload, align 8" -> println
            "  %v$(request.callIndex)_file_sync_handle = extractvalue " -> print
            syncWriterTypeId -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_file_sync_writer, 0" -> println
        } else {
            request.callIndex -> callArgumentIndex(context, state) => writerIndex!
            writerIndex! -> aggregateValueIndex(context, state) => writerIndex!
            context.ir[writerIndex!] => writer
            "  %v$(request.callIndex)_file_sync_handle = extractvalue " -> print
            writer -> writeIrType(context, state)
            " " -> print
            writerIndex! -> writeValue(request.ownerIndex, context, state)
            ", 0" -> println
        }
        "  %v$(request.callIndex)_file_sync_raw = call i32 @sollang_platform_sync_owned_file(i64 %v$(request.callIndex)_file_sync_handle)" -> println
        "  %v$(request.callIndex) = icmp ne i32 %v$(request.callIndex)_file_sync_raw, 0" -> println
    }
    call.opcode == -219 -> if {
        request.callIndex -> callArgumentIndex(context, state) => replaceIndex!
        replaceIndex! -> aggregateValueIndex(context, state) => replaceIndex!
        context.ir[replaceIndex!] => replace
        "  %v$(request.callIndex)_file_temporary = extractvalue " -> print
        replace -> writeIrType(context, state)
        " " -> print
        replaceIndex! -> writeValue(request.ownerIndex, context, state)
        ", 0" -> println
        "  %v$(request.callIndex)_file_destination = extractvalue " -> print
        replace -> writeIrType(context, state)
        " " -> print
        replaceIndex! -> writeValue(request.ownerIndex, context, state)
        ", 1" -> println
        "  %v$(request.callIndex)_file_temporary_data = extractvalue %sollang.text %v$(request.callIndex)_file_temporary, 0" -> println
        "  %v$(request.callIndex)_file_temporary_length = extractvalue %sollang.text %v$(request.callIndex)_file_temporary, 1" -> println
        "  %v$(request.callIndex)_file_destination_data = extractvalue %sollang.text %v$(request.callIndex)_file_destination, 0" -> println
        "  %v$(request.callIndex)_file_destination_length = extractvalue %sollang.text %v$(request.callIndex)_file_destination, 1" -> println
        "  %v$(request.callIndex)_file_replace_raw = call i32 @sollang_platform_atomic_replace_file(ptr %v$(request.callIndex)_file_temporary_data, i64 %v$(request.callIndex)_file_temporary_length, ptr %v$(request.callIndex)_file_destination_data, i64 %v$(request.callIndex)_file_destination_length)" -> println
        "  %v$(request.callIndex) = icmp ne i32 %v$(request.callIndex)_file_replace_raw, 0" -> println
    }
    call.opcode == -221 -> if {
        call.operand0 => scalarArgumentIndex!
        context.ir[scalarArgumentIndex!].nextOperand => offsetArgumentIndex!
        context.ir[offsetArgumentIndex!].nextOperand >= 0 -> while {
            offsetArgumentIndex! => scalarArgumentIndex!
            context.ir[offsetArgumentIndex!].nextOperand => offsetArgumentIndex!
        }
        scalarArgumentIndex! -> aggregateValueIndex(context, state) => scalarIndex
        offsetArgumentIndex! -> aggregateValueIndex(context, state) => offsetIndex
        context.ir[scalarIndex] => scalar
        scalar.typeId => scalarTypeId!
        scalarTypeId! < 0 -> if { scalar.typeSymbol => scalarTypeId! }
        context.typeSizes[scalarTypeId!] => scalarSize
        context.typeAligns[scalarTypeId!] => scalarAlign
        "  %v$(request.callIndex)_file_write_slot = alloca " -> print
        scalarTypeId! -> writeSemanticTypeId(context, state)
        ", align $scalarAlign" -> println
        "  store " -> print
        scalarTypeId! -> writeSemanticTypeId(context, state)
        " " -> print
        scalarIndex -> writeValue(request.ownerIndex, context, state)
        ", ptr %v$(request.callIndex)_file_write_slot, align $scalarAlign" -> println
        enclosingFileMatch! >= 0 -> if {
            context.ir[enclosingFileMatch!] => fileWriterMatch
            context.types[context.ir[fileWriterMatch.operand0].typeId].first => fileWriterTypeId
            "  %v$(request.callIndex)_file_writer_payload = getelementptr inbounds " -> print
            context.ir[fileWriterMatch.operand0] -> writeIrType(context, state)
            ", ptr %v$(enclosingFileMatch!)_subject_slot, i32 0, i32 1" -> println
            "  %v$(request.callIndex)_file_writer = load " -> print
            fileWriterTypeId -> writeSemanticTypeId(context, state)
            ", ptr %v$(request.callIndex)_file_writer_payload, align 8" -> println
            "  %v$(request.callIndex)_file_write_handle = extractvalue " -> print
            fileWriterTypeId -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_file_writer, 0" -> println
        }
        "  %v$(request.callIndex)_file_write_raw = call %sollang.file_count_result @sollang_platform_write_owned_file_at(i64 %v$(request.callIndex)_file_write_handle, ptr %v$(request.callIndex)_file_write_slot, i64 $scalarSize, i64 " -> print
        offsetIndex -> writeValue(request.ownerIndex, context, state)
        ")" -> println
        "  %v$(request.callIndex)_file_write_count = extractvalue %sollang.file_count_result %v$(request.callIndex)_file_write_raw, 0" -> println
        "  %v$(request.callIndex)_file_write_status = extractvalue %sollang.file_count_result %v$(request.callIndex)_file_write_raw, 1" -> println
        "  %v$(request.callIndex)_file_write_called = icmp ne i32 %v$(request.callIndex)_file_write_status, 0" -> println
        "  %v$(request.callIndex)_file_write_full = icmp eq i64 %v$(request.callIndex)_file_write_count, $scalarSize" -> println
