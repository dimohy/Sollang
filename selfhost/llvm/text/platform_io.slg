                "  %v$(request.callIndex)_file_read_encoding_ok = and i1 %v$(request.callIndex)_file_read_in_range, %v$(request.callIndex)_file_read_not_surrogate" -> println
                "  br i1 %v$(request.callIndex)_file_read_encoding_ok, label %file$(request.callIndex)_read_valid, label %file$(request.callIndex)_read_error_invalid" -> println
            } else { "  br label %file$(request.callIndex)_read_valid" -> println }
        }
        "file$(request.callIndex)_read_valid:" -> println
        scalarTypeId == 23 -> if { "  %v$(request.callIndex)_file_read_scalar = trunc i8 %v$(request.callIndex)_file_read_loaded to i1" -> println }
        "  %v$(request.callIndex)_file_option_slot = alloca " -> print
        optionTypeId -> writeSemanticTypeId(context, state)
        ", align 8" -> println
        "  store " -> print
        optionTypeId -> writeSemanticTypeId(context, state)
        " zeroinitializer, ptr %v$(request.callIndex)_file_option_slot, align 8" -> println
        "  %v$(request.callIndex)_file_some_tag = getelementptr inbounds " -> print
        optionTypeId -> writeSemanticTypeId(context, state)
        ", ptr %v$(request.callIndex)_file_option_slot, i32 0, i32 0" -> println
        "  store i32 1, ptr %v$(request.callIndex)_file_some_tag, align 4" -> println
        "  %v$(request.callIndex)_file_some_payload = getelementptr inbounds " -> print
        optionTypeId -> writeSemanticTypeId(context, state)
        ", ptr %v$(request.callIndex)_file_option_slot, i32 0, i32 1" -> println
