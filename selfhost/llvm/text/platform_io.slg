        rawTypeId! -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_directory_raw0, " -> print
        rawCountType! -> writeSemanticTypeId(context, state)
        " " -> print
        context.pointerBitWidth == 32 -> if {
            "%v$(request.callIndex)_directory_count_size" -> print
        } else {
            "%v$(request.callIndex)_directory_count" -> print
        }
        ", 1" -> println
        "  %v$(request.callIndex)_directory_ok_tag = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_directory_result_slot, i32 0, i32 0" -> println
        "  store i32 0, ptr %v$(request.callIndex)_directory_ok_tag, align 4" -> println
        "  %v$(request.callIndex)_directory_ok_payload = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_directory_result_slot, i32 0, i32 1" -> println
        "  store " -> print
        rawTypeId! -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_directory_raw_value, ptr %v$(request.callIndex)_directory_ok_payload, align 8" -> println
        "  br label %directory$(request.callIndex)_merge" -> println
        "directory$(request.callIndex)_error:" -> println
        "  %v$(request.callIndex)_directory_error_tag = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_directory_result_slot, i32 0, i32 0" -> println
        "  store i32 1, ptr %v$(request.callIndex)_directory_error_tag, align 4" -> println
        "  %v$(request.callIndex)_directory_error_text0 = insertvalue %sollang.text poison, ptr @sollang_directory_error_io, 0" -> println
        "  %v$(request.callIndex)_directory_error_text = insertvalue %sollang.text %v$(request.callIndex)_directory_error_text0, i64 2, 1" -> println
        "  %v$(request.callIndex)_directory_error_payload = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_directory_result_slot, i32 0, i32 1" -> println
        "  store %sollang.text %v$(request.callIndex)_directory_error_text, ptr %v$(request.callIndex)_directory_error_payload, align 8" -> println
        "  br label %directory$(request.callIndex)_merge" -> println
        "directory$(request.callIndex)_merge:" -> println
        "  %v$(request.callIndex) = load " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_directory_result_slot, align 8" -> println
    }
}
emitTryParallelCollect request: TryParallelCollectRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.types[request.callbackTypeId] => callbackResultType
    callbackResultType.first => okTypeId
    callbackResultType.second => errorTypeId
    context.typeSizes[request.callbackTypeId] => callbackStride
    context.typeSizes[okTypeId] => okStride
    context.typeAligns[request.callbackTypeId] => callbackAlign
    context.typeAligns[errorTypeId] => errorAlign
    context.typeAligns[okTypeId] => okAlign
    "  %v$(request.expressionIndex)_failure_limit = load atomic i64, ptr %v$(request.expressionIndex)_failure_limit_slot acquire, align 8" -> println
    "  %v$(request.expressionIndex)_has_failure = icmp ult i64 %v$(request.expressionIndex)_failure_limit, %v$(request.expressionIndex)_length" -> println
    "  br i1 %v$(request.expressionIndex)_has_failure, label %tryparallel$(request.expressionIndex)_error, label %tryparallel$(request.expressionIndex)_success" -> println
    "tryparallel$(request.expressionIndex)_error:" -> println
    "  %v$(request.expressionIndex)_selected_offset = mul i64 %v$(request.expressionIndex)_failure_limit, " -> print
    callbackStride -> writeDecimalLine
    "  %v$(request.expressionIndex)_selected_ptr = getelementptr i8, ptr %v$(request.expressionIndex)_callback_results, i64 %v$(request.expressionIndex)_selected_offset" -> println
    "  %v$(request.expressionIndex)_selected = load " -> print
    request.callbackTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.expressionIndex)_selected_ptr, align " -> print
    callbackAlign -> writeDecimalLine
    "  %v$(request.expressionIndex)_selected_slot = alloca " -> print
    request.callbackTypeId -> writeSemanticTypeId(context, state)
    ", align 8" -> println
    "  store " -> print
    request.callbackTypeId -> writeSemanticTypeId(context, state)
    " %v$(request.expressionIndex)_selected, ptr %v$(request.expressionIndex)_selected_slot, align 8" -> println
    "  %v$(request.expressionIndex)_selected_payload_ptr = getelementptr inbounds " -> print
    request.callbackTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.expressionIndex)_selected_slot, i32 0, i32 1" -> println
    "  %v$(request.expressionIndex)_error_payload = load " -> print
    errorTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.expressionIndex)_selected_payload_ptr, align " -> print
    errorAlign -> writeDecimalLine
    (okTypeId -> semanticTypeOwns(context, state)) or (errorTypeId -> semanticTypeOwns(context, state))
        -> if {
            request.expressionIndex * 1000 + 909 => partialDropRoot
            "  %v$(request.expressionIndex)_cleanup_result_slot = alloca " -> print
            request.callbackTypeId -> writeSemanticTypeId(context, state)
            ", align 8" -> println
            "  br label %tryparallel$(request.expressionIndex)_cleanup_header" -> println
            "tryparallel$(request.expressionIndex)_cleanup_header:" -> println
            "  %v$(request.expressionIndex)_cleanup_index = phi i64 [ 0, %tryparallel$(request.expressionIndex)_error ], [ %v$(request.expressionIndex)_cleanup_next_index, %tryparallel$(request.expressionIndex)_cleanup_next ]" -> println
            "  %v$(request.expressionIndex)_cleanup_in_range = icmp ult i64 %v$(request.expressionIndex)_cleanup_index, %v$(request.expressionIndex)_length" -> println
            "  br i1 %v$(request.expressionIndex)_cleanup_in_range, label %tryparallel$(request.expressionIndex)_cleanup_check, label %tryparallel$(request.expressionIndex)_cleanup_done" -> println
            "tryparallel$(request.expressionIndex)_cleanup_check:" -> println
            "  %v$(request.expressionIndex)_cleanup_initialized_ptr = getelementptr i8, ptr %v$(request.expressionIndex)_initialized, i64 %v$(request.expressionIndex)_cleanup_index" -> println
            "  %v$(request.expressionIndex)_cleanup_initialized = load atomic i8, ptr %v$(request.expressionIndex)_cleanup_initialized_ptr acquire, align 1" -> println
            "  %v$(request.expressionIndex)_cleanup_has_value = icmp ne i8 %v$(request.expressionIndex)_cleanup_initialized, 0" -> println
            "  %v$(request.expressionIndex)_cleanup_is_selected = icmp eq i64 %v$(request.expressionIndex)_cleanup_index, %v$(request.expressionIndex)_failure_limit" -> println
            "  %v$(request.expressionIndex)_cleanup_not_selected = xor i1 %v$(request.expressionIndex)_cleanup_is_selected, true" -> println
            "  %v$(request.expressionIndex)_cleanup_should_drop = and i1 %v$(request.expressionIndex)_cleanup_has_value, %v$(request.expressionIndex)_cleanup_not_selected" -> println
            "  br i1 %v$(request.expressionIndex)_cleanup_should_drop, label %tryparallel$(request.expressionIndex)_cleanup_drop, label %tryparallel$(request.expressionIndex)_cleanup_next" -> println
            "tryparallel$(request.expressionIndex)_cleanup_drop:" -> println
            "  %v$(request.expressionIndex)_cleanup_offset = mul i64 %v$(request.expressionIndex)_cleanup_index, " -> print
            callbackStride -> writeDecimalLine
            "  %v$(request.expressionIndex)_cleanup_ptr = getelementptr i8, ptr %v$(request.expressionIndex)_callback_results, i64 %v$(request.expressionIndex)_cleanup_offset" -> println
            "  %v$(request.expressionIndex)_cleanup_result = load " -> print
            request.callbackTypeId -> writeSemanticTypeId(context, state)
            ", ptr %v$(request.expressionIndex)_cleanup_ptr, align " -> print
            callbackAlign -> writeDecimalLine
            "  store " -> print
            request.callbackTypeId -> writeSemanticTypeId(context, state)
            " %v$(request.expressionIndex)_cleanup_result, ptr %v$(request.expressionIndex)_cleanup_result_slot, align 8" -> println
            "  %v$(request.expressionIndex)_cleanup_tag = extractvalue " -> print
            request.callbackTypeId -> writeSemanticTypeId(context, state)
            " %v$(request.expressionIndex)_cleanup_result, 0" -> println
            "  %enumdrop$(partialDropRoot)_payload_ptr = getelementptr inbounds " -> print
            request.callbackTypeId -> writeSemanticTypeId(context, state)
            ", ptr %v$(request.expressionIndex)_cleanup_result_slot, i32 0, i32 1" -> println
            "  %v$(request.expressionIndex)_cleanup_is_ok = icmp eq i32 %v$(request.expressionIndex)_cleanup_tag, 0" -> println
            "  br i1 %v$(request.expressionIndex)_cleanup_is_ok, label %tryparallel$(request.expressionIndex)_cleanup_ok, label %tryparallel$(request.expressionIndex)_cleanup_error" -> println
            "tryparallel$(request.expressionIndex)_cleanup_ok:" -> println
            okTypeId -> semanticTypeOwns(context, state) -> if {
                EnumPayloadDropRequest { enumTypeId: request.callbackTypeId, payloadTypeId: okTypeId, nameRoot: partialDropRoot * 10 + 1, pointerRoot: partialDropRoot, bindingIndex: -1, regionIndex: -1 } -> emitEnumPayloadDrop(context, state)
            }
            "  br label %tryparallel$(request.expressionIndex)_cleanup_next" -> println
            "tryparallel$(request.expressionIndex)_cleanup_error:" -> println
            errorTypeId -> semanticTypeOwns(context, state)
                -> if {
                    EnumPayloadDropRequest { enumTypeId: request.callbackTypeId, payloadTypeId: errorTypeId, nameRoot: partialDropRoot * 10 + 2, pointerRoot: partialDropRoot, bindingIndex: -1, regionIndex: -1 } -> emitEnumPayloadDrop(context, state)
                }
            "  br label %tryparallel$(request.expressionIndex)_cleanup_next" -> println
            "tryparallel$(request.expressionIndex)_cleanup_next:" -> println
            "  %v$(request.expressionIndex)_cleanup_next_index = add i64 %v$(request.expressionIndex)_cleanup_index, 1" -> println
            "  br label %tryparallel$(request.expressionIndex)_cleanup_header" -> println
            "tryparallel$(request.expressionIndex)_cleanup_done:" -> println
        }
    "  call void @free(ptr %v$(request.expressionIndex)_callback_results)" -> println
    "  call void @free(ptr %v$(request.expressionIndex)_initialized)" -> println
    "  call void @free(ptr %v$(request.expressionIndex)_data)" -> println
    "  %v$(request.expressionIndex)_error_slot = alloca " -> print
    request.outerTypeId -> writeSemanticTypeId(context, state)
    ", align 8" -> println
    "  store " -> print
    request.outerTypeId -> writeSemanticTypeId(context, state)
    " zeroinitializer, ptr %v$(request.expressionIndex)_error_slot, align 8" -> println
    "  %v$(request.expressionIndex)_error_tag = getelementptr inbounds " -> print
    request.outerTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.expressionIndex)_error_slot, i32 0, i32 0" -> println
    "  store i32 1, ptr %v$(request.expressionIndex)_error_tag, align 4" -> println
    "  %v$(request.expressionIndex)_outer_error_payload = getelementptr inbounds " -> print
    request.outerTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.expressionIndex)_error_slot, i32 0, i32 1" -> println
    "  store " -> print
    errorTypeId -> writeSemanticTypeId(context, state)
    " %v$(request.expressionIndex)_error_payload, ptr %v$(request.expressionIndex)_outer_error_payload, align " -> print
    errorAlign -> writeDecimalLine
    "  %v$(request.expressionIndex)_error_result = load " -> print
    request.outerTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.expressionIndex)_error_slot, align 8" -> println
    "  br label %tryparallel$(request.expressionIndex)_merge" -> println
    "tryparallel$(request.expressionIndex)_success:" -> println
    "  br label %tryparallel$(request.expressionIndex)_copy_header" -> println
    "tryparallel$(request.expressionIndex)_copy_header:" -> println
    "  %v$(request.expressionIndex)_copy_index = phi i64 [ 0, %tryparallel$(request.expressionIndex)_success ], [ %v$(request.expressionIndex)_copy_next, %tryparallel$(request.expressionIndex)_copy_body ]" -> println
    "  %v$(request.expressionIndex)_copy_in_range = icmp ult i64 %v$(request.expressionIndex)_copy_index, %v$(request.expressionIndex)_length" -> println
    "  br i1 %v$(request.expressionIndex)_copy_in_range, label %tryparallel$(request.expressionIndex)_copy_body, label %tryparallel$(request.expressionIndex)_copy_done" -> println
    "tryparallel$(request.expressionIndex)_copy_body:" -> println
    "  %v$(request.expressionIndex)_copy_result_offset = mul i64 %v$(request.expressionIndex)_copy_index, " -> print
    callbackStride -> writeDecimalLine
    "  %v$(request.expressionIndex)_copy_result_ptr = getelementptr i8, ptr %v$(request.expressionIndex)_callback_results, i64 %v$(request.expressionIndex)_copy_result_offset" -> println
    "  %v$(request.expressionIndex)_copy_result = load " -> print
    request.callbackTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.expressionIndex)_copy_result_ptr, align " -> print
    callbackAlign -> writeDecimalLine
    "  %v$(request.expressionIndex)_copy_result_slot = alloca " -> print
    request.callbackTypeId -> writeSemanticTypeId(context, state)
    ", align 8" -> println
    "  store " -> print
    request.callbackTypeId -> writeSemanticTypeId(context, state)
    " %v$(request.expressionIndex)_copy_result, ptr %v$(request.expressionIndex)_copy_result_slot, align 8" -> println
    "  %v$(request.expressionIndex)_copy_payload_ptr = getelementptr inbounds " -> print
    request.callbackTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.expressionIndex)_copy_result_slot, i32 0, i32 1" -> println
    "  %v$(request.expressionIndex)_copy_payload = load " -> print
    okTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.expressionIndex)_copy_payload_ptr, align " -> print
    okAlign -> writeDecimalLine
    "  %v$(request.expressionIndex)_copy_output_offset = mul i64 %v$(request.expressionIndex)_copy_index, " -> print
    okStride -> writeDecimalLine
    "  %v$(request.expressionIndex)_copy_output_ptr = getelementptr i8, ptr %v$(request.expressionIndex)_data, i64 %v$(request.expressionIndex)_copy_output_offset" -> println
    "  store " -> print
    okTypeId -> writeSemanticTypeId(context, state)
    " %v$(request.expressionIndex)_copy_payload, ptr %v$(request.expressionIndex)_copy_output_ptr, align " -> print
    okAlign -> writeDecimalLine
    "  %v$(request.expressionIndex)_copy_next = add i64 %v$(request.expressionIndex)_copy_index, 1" -> println
    "  br label %tryparallel$(request.expressionIndex)_copy_header" -> println
    "tryparallel$(request.expressionIndex)_copy_done:" -> println
    "  call void @free(ptr %v$(request.expressionIndex)_callback_results)" -> println
    "  call void @free(ptr %v$(request.expressionIndex)_initialized)" -> println
    "  %v$(request.expressionIndex)_array0 = insertvalue %sollang.array.i32 poison, ptr %v$(request.expressionIndex)_data, 0" -> println
    "  %v$(request.expressionIndex)_array1 = insertvalue %sollang.array.i32 %v$(request.expressionIndex)_array0, i64 %v$(request.expressionIndex)_length, 1" -> println
    "  %v$(request.expressionIndex)_array = insertvalue %sollang.array.i32 %v$(request.expressionIndex)_array1, i64 %v$(request.expressionIndex)_length, 2" -> println
    "  %v$(request.expressionIndex)_success_slot = alloca " -> print
    request.outerTypeId -> writeSemanticTypeId(context, state)
    ", align 8" -> println
    "  store " -> print
    request.outerTypeId -> writeSemanticTypeId(context, state)
    " zeroinitializer, ptr %v$(request.expressionIndex)_success_slot, align 8" -> println
    "  %v$(request.expressionIndex)_success_tag = getelementptr inbounds " -> print
    request.outerTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.expressionIndex)_success_slot, i32 0, i32 0" -> println
    "  store i32 0, ptr %v$(request.expressionIndex)_success_tag, align 4" -> println
    "  %v$(request.expressionIndex)_outer_success_payload = getelementptr inbounds " -> print
    request.outerTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.expressionIndex)_success_slot, i32 0, i32 1" -> println
    "  store %sollang.array.i32 %v$(request.expressionIndex)_array, ptr %v$(request.expressionIndex)_outer_success_payload, align 8" -> println
    "  %v$(request.expressionIndex)_success_result = load " -> print
    request.outerTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(request.expressionIndex)_success_slot, align 8" -> println
    "  br label %tryparallel$(request.expressionIndex)_merge" -> println
    "tryparallel$(request.expressionIndex)_merge:" -> println
    "  %v$(request.expressionIndex) = phi " -> print
    request.outerTypeId -> writeSemanticTypeId(context, state)
    " [ %v$(request.expressionIndex)_error_result, %tryparallel$(request.expressionIndex)_" -> print
    (okTypeId -> semanticTypeOwns(context, state)) or (errorTypeId -> semanticTypeOwns(context, state))
        -> if { "cleanup_done" -> print } else { "error" -> print }
    " ], [ %v$(request.expressionIndex)_success_result, %tryparallel$(request.expressionIndex)_copy_done ]" -> println
}
arrayElementTypeId node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => elementTypeId!
    node.typeId >= 0 -> if {
        node.typeId => arrayTypeId!
        context.types[arrayTypeId!].kind == 8 -> if { context.types[arrayTypeId!].first => arrayTypeId! }
        context.types[arrayTypeId!].kind == 2
            or context.types[arrayTypeId!].kind == 3
            or context.types[arrayTypeId!].kind == 4
            or context.types[arrayTypeId!].kind == 12
            or (context.types[arrayTypeId!].kind == 7
            and context.types[arrayTypeId!].origin == 4
            and (context.types[arrayTypeId!].symbol == 5
            or context.types[arrayTypeId!].symbol == 6
            or context.types[arrayTypeId!].symbol == 7))
            -> if {
                context.types[arrayTypeId!].first => elementTypeId!
            }
        # A non-empty call-argument literal retains its fixed-length container
        # identity while contextual parameter typing can narrow numeric/Bool
        # elements (for example `[30, 40]` passed to `[UInt8]`). Only that
        # structurally proven call context may override the container's default
        # element identity. Return literals keep their declared container type
        # even when an individual operand is a narrower parameter value.
        node.parent >= 0
            and node.parent < (context.ir -> len)
            and (context.ir[node.parent].kind == 6 or context.ir[node.parent].kind == 9)
            and node.operand0 >= 0
            and node.operand0 < (context.ir -> len)
            -> if {
                context.ir[node.operand0] => contextualFirstElement
                (contextualFirstElement.kind == 3 or contextualFirstElement.kind == 4)
                    and contextualFirstElement.typeId >= 0
                    -> if { contextualFirstElement.typeId => elementTypeId! }
            }
    } else {
        # A freshly lowered non-empty array literal can temporarily retain the
        # legacy dynamic-array projection while its canonical container type is
        # unresolved. Its first operand still has the authoritative element
        # type, so recover that before consulting the legacy symbol fields.
        node.operand0 >= 0 -> if {
            context.ir[node.operand0] => firstElement
            firstElement.typeId >= 0 -> if { firstElement.typeId => elementTypeId! } else {
                0 => builtinElementSearch!
                builtinElementSearch! < (context.types -> len) and elementTypeId! < 0
                    -> while {
                        context.types[builtinElementSearch!] => builtinElementCandidate
                        (firstElement.typeOrigin == 1
                            and builtinElementCandidate.origin == 1
                            and builtinElementCandidate.symbol == firstElement.typeSymbol)
                            or (builtinElementCandidate.kind == firstElement.typeKind
                            and builtinElementCandidate.origin == firstElement.typeOrigin
                            and builtinElementCandidate.module == firstElement.typeModule
                            and builtinElementCandidate.symbol == firstElement.typeSymbol)
                            -> if {
                                builtinElementSearch! => elementTypeId!
                            }
                        builtinElementSearch! + 1 => builtinElementSearch!
                    }
            }
        }
        # The legacy array projection stores a nominal element as
        # typeModule/typeSymbol. Recover its canonical ID so arrays of
        # user structs do not fall through to builtin symbol 0 (Unit).
        elementTypeId! < 0 and node.typeModule >= 0
            -> if {
                0 => legacyElementSearch!
                legacyElementSearch! < (context.types -> len)
                    -> while {
                        context.types[legacyElementSearch!] => legacyElementCandidate
                        legacyElementCandidate.kind == 1 and (legacyElementCandidate.origin == 0 or legacyElementCandidate.origin == 2) and legacyElementCandidate.module == node.typeModule and legacyElementCandidate.symbol == node.typeSymbol
                            -> if {
                                legacyElementSearch! => elementTypeId!
                            }
                        legacyElementSearch! + 1 => legacyElementSearch!
                    }
            }
    }
    elementTypeId!
}
isSetCollection node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext -> Bool {
    false => result!
    node.typeId >= 0 -> if {
        node.typeId => collectionTypeId!
        context.types[collectionTypeId!].kind == 8 -> if { context.types[collectionTypeId!].first => collectionTypeId! }
        context.types[collectionTypeId!].kind == 7
            and context.types[collectionTypeId!].origin == 4
            and context.types[collectionTypeId!].symbol == 5
            -> if { true => result! }
    }
    result!
}
arrayElementSize node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    node -> arrayElementTypeId(context, state) => elementTypeId
    elementTypeId >= 0 -> if {
        context.types[elementTypeId] => elementType
        # SourceText is declared as an opaque token in the bootstrap surface,
        # but its native ABI is { data, length, owner, ownerLength }. Arrays
        # must reserve the projected ABI width rather than the nominal token
        # layout or the second element overwrites the allocation.
        elementType.kind == 1 and elementType.origin == 1 and elementType.symbol == 24
            -> if { elementType.symbol -> storageSize(context, state) } else {
                elementTypeId -> enumAbiStorageSize(0, context, state)
            }
    } else { node.typeSymbol -> storageSize(context, state) }
}
arrayElementAlign node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    node -> arrayElementTypeId(context, state) => elementTypeId
    elementTypeId >= 0 -> if {
        context.types[elementTypeId] => elementType
        elementType.kind == 1 and elementType.origin == 1 and elementType.symbol == 24
            -> if { elementType.symbol -> legacyStorageAlign(context, state) } else { context.typeAligns[elementTypeId] }
    } else { node.typeSymbol -> legacyStorageAlign(context, state) }
}
writeArrayElementType node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    node -> arrayElementTypeId(context, state) => elementTypeId
    elementTypeId >= 0 -> if { elementTypeId -> writeSemanticTypeId(context, state) } else { node.typeSymbol -> llvmType(context, state) -> print }
}

writeArrayViewType typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.types[typeId] => arrayType
    arrayType.kind == 3
        or arrayType.kind == 12
        or (arrayType.kind == 7
        and arrayType.origin == 4
        and (arrayType.symbol == 6 or arrayType.symbol == 7))
        -> if { "%sollang.array.i32" -> print } else { "{ ptr, i64 }" -> print }
}
emitTextLiteralConstant request: TextLiteralRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context -> literalEmitConstant(request.sourceModule, request.token)
}
emitNativeSourceByte sourceModule: Int, byteIndex: UIntSize, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context -> literalEmitSourceByte(sourceModule, byteIndex)
}
emitNativeLibraryGlobals sourceModule: Int, libraryAst: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    libraryAst => nativeLibraryAstValue
    context.ranges[sourceModule] => nativeRange
    context.nodes[nativeRange.astStart + libraryAst] => nativeLibrary
    context.tokens[nativeRange.tokenStart + nativeLibrary.secondaryToken] => nativeLibraryToken
    TextLiteralRequest { sourceModule: sourceModule, token: nativeLibraryToken } => nativeLibraryRequest
    nativeLibraryRequest -> textLiteralLength(context, state) => nativeLibraryBaseLength
    context.expectedPathStyle == 1 -> if {
        nativeLibraryBaseLength + 5 => nativeLibraryLength
        "@sollang_native_library_name_m$(sourceModule)_a$(nativeLibraryAstValue) = private unnamed_addr constant [$(nativeLibraryLength) x i8] " -> print
    } else {
        nativeLibraryBaseLength + 7 => nativeLibraryLength
        "@sollang_native_library_name_m$(sourceModule)_a$(nativeLibraryAstValue) = private unnamed_addr constant [$(nativeLibraryLength) x i8] " -> print
    }
    "c" -> print
    context.sources[sourceModule] -> slice(nativeLibraryToken.span.start, UIntSize(1)) -> print
    nativeLibraryRequest -> textLiteralStart(context, state) => nativeLibraryByte!
    nativeLibraryRequest -> textLiteralEnd(context, state) => nativeLibraryEnd
    nativeLibraryByte! => nativeLibraryNameStart!
    nativeLibraryByte! => nativeLibrarySlashSearch!
    nativeLibrarySlashSearch! < nativeLibraryEnd -> while {
        context.sources[sourceModule] -> byte(nativeLibrarySlashSearch!) => nativePathByte
        nativePathByte == 47 or nativePathByte == 92
            -> if {
                nativeLibrarySlashSearch! + 1 => nativeLibraryNameStart!
            }
        nativeLibrarySlashSearch! + 1 => nativeLibrarySlashSearch!
    }
    context.expectedPathStyle == 0 and nativeLibraryNameStart! == nativeLibraryByte!
        -> if { "lib" -> print }
    nativeLibraryByte! < nativeLibraryEnd -> while {
        context.expectedPathStyle == 0 and nativeLibraryByte! == nativeLibraryNameStart! and nativeLibraryNameStart! != (nativeLibraryRequest -> textLiteralStart(context, state))
            -> if { "lib" -> print }
        sourceModule -> emitNativeSourceByte(nativeLibraryByte!, context, state)
        nativeLibraryByte! + 1 => nativeLibraryByte!
    }
    context.expectedPathStyle == 1 -> if { ".dll" -> print }
    context.expectedPathStyle != 1 -> if { ".so" -> print }
    "\" -> print
    "00" -> print
    context.sources[sourceModule] -> slice(nativeLibraryToken.span.start, UIntSize(1)) -> println
    "@sollang_native_library_m$(sourceModule)_a$(nativeLibraryAstValue) = internal global ptr null, align 8" -> println
}
emitImportedLibraryGlobals interfaceIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.libraries.sources[interfaceIndex] -> len => manifestLength
    context.libraries.sources[interfaceIndex] -> slice(UIntSize(0), manifestLength) => manifest
    context.libraries -> libraryImports.interfaceLibraryFile(interfaceIndex) => libraryFileSpan
    context.libraries -> libraryImports.runtimeLibraryLength(interfaceIndex) => runtimeLibraryLength
    context.libraries -> libraryImports.runtimeLibraryStyle(interfaceIndex) => runtimeLibraryStyle
    false => windowsDrivePath!
    runtimeLibraryStyle == 1 and runtimeLibraryLength >= 3
        -> if {
            context.libraries -> libraryImports.runtimeLibraryByte(interfaceIndex, 1) => driveColon
            context.libraries -> libraryImports.runtimeLibraryByte(interfaceIndex, 2) => driveSeparator
            driveColon == 58 and (driveSeparator == 47 or driveSeparator == 92)
                -> if {
                    true => windowsDrivePath!
                }
        }
    runtimeLibraryLength => emittedLibraryLength!
    context.expectedPathStyle == 0 and windowsDrivePath!
        -> if { emittedLibraryLength! + 4 => emittedLibraryLength! }
    emittedLibraryLength! + 1 => libraryNameLength
    "@sollang_library_name_i$(interfaceIndex) = private unnamed_addr constant [$libraryNameLength x i8] c" -> print
    manifest -> slice(libraryFileSpan.start - 1, UIntSize(1)) -> print
    0 => libraryByteIndex!
    context.expectedPathStyle == 0 and windowsDrivePath!
        -> if {
            "/mnt/" -> print
            context.libraries -> libraryImports.runtimeLibraryByte(interfaceIndex, 0) => driveLetter!
            driveLetter! >= 65 and driveLetter! <= 90 -> if { driveLetter! + 32 => driveLetter! }
            driveLetter! -> literalEmitEscapedByte
            "/" -> print
            3 => libraryByteIndex!
        }
    libraryByteIndex! < runtimeLibraryLength -> while {
        context.libraries -> libraryImports.runtimeLibraryByte(interfaceIndex, libraryByteIndex!) => libraryByte!
        context.expectedPathStyle == 0 and libraryByte! == 92
            -> if { 47 => libraryByte! }
        context.expectedPathStyle == 1 and libraryByte! == 47
            -> if { 92 => libraryByte! }
        libraryByte! -> literalEmitEscapedByte
        libraryByteIndex! + 1 => libraryByteIndex!
    }
    "\" -> print
    "00" -> print
    manifest -> slice(libraryFileSpan.start - 1, UIntSize(1)) -> println
    "@sollang_library_handle_i$(interfaceIndex) = internal global ptr null, align 8" -> println

    0 => exportIndex!
    context.libraries -> libraryImports.interfaceExportCount(interfaceIndex) => exportCount
    exportIndex! < exportCount -> while {
        context.libraries -> libraryImports.exportSymbol(interfaceIndex, exportIndex!) => exportedSymbol
        exportedSymbol.length + 1 => symbolNameLength
        "@sollang_library_symbol_name_i$(interfaceIndex)_e$(exportIndex!) = private unnamed_addr constant [$symbolNameLength x i8] c" -> print
        manifest -> slice(exportedSymbol.start - 1, UIntSize(1)) -> print
        UIntSize(0) => symbolByte!
        symbolByte! < exportedSymbol.length -> while {
            manifest -> byte(exportedSymbol.start + symbolByte!) -> literalEmitEscapedByte
            symbolByte! + 1 => symbolByte!
        }
        "\" -> print
        "00" -> print
        manifest -> slice(exportedSymbol.start - 1, UIntSize(1)) -> println
        "@sollang_library_function_i$(interfaceIndex)_e$(exportIndex!) = internal global ptr null, align 8" -> println
        exportIndex! + 1 => exportIndex!
    }
}
emitComServerGlobals sourceModule: Int, classAst: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ranges[sourceModule] => comServerRange
    context.nodes[comServerRange.astStart + classAst] => comServerClass
    context.tokens[comServerRange.tokenStart + comServerClass.tertiaryToken] => comServerToken
    TextLiteralRequest { sourceModule: sourceModule, token: comServerToken } => comServerRequest
    comServerRequest -> textLiteralLength(context, state) => comServerBaseLength
    comServerBaseLength + 5 => comServerLength
    "@sollang_com_server_name_m$(sourceModule)_a$(classAst) = private unnamed_addr constant [$(comServerLength) x i8] " -> print
    "c" -> print
    context.sources[sourceModule] -> slice(comServerToken.span.start, UIntSize(1)) -> print
    comServerRequest -> textLiteralStart(context, state) => comServerByte!
    comServerRequest -> textLiteralEnd(context, state) => comServerEnd
    comServerByte! < comServerEnd -> while {
        sourceModule -> emitNativeSourceByte(comServerByte!, context, state)
        comServerByte! + 1 => comServerByte!
    }
    ".dll" -> print
    "\" -> print
    "00" -> print
    context.sources[sourceModule] -> slice(comServerToken.span.start, UIntSize(1)) -> println
    "@sollang_com_server_m$(sourceModule)_a$(classAst) = internal global ptr null, align 8" -> println
    "@sollang_com_factory_m$(sourceModule)_a$(classAst) = internal global ptr null, align 8" -> println
}
emitNativeSymbolGlobals function: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    function.sourceModule => nativeFunctionSourceModule
    function.symbol => nativeFunctionSymbol
    context.ranges[function.sourceModule] => nativeRange
    function -> nativeSymbolToken(context, state) => nativeSymbolTokenIndex
    context.tokens[nativeRange.tokenStart + nativeSymbolTokenIndex] => nativeNameToken
    nativeNameToken.kind == grammar.tokenIdString()
        -> if {
            TextLiteralRequest { sourceModule: function.sourceModule, token: nativeNameToken } => nativeNameRequest
            nativeNameRequest -> textLiteralLength(context, state) => nativeNameContentLength
            nativeNameContentLength + 1 => nativeNameLength
            "@sollang_native_symbol_name_m$(nativeFunctionSourceModule)_s$(nativeFunctionSymbol) = private unnamed_addr constant [$nativeNameLength x i8] " -> print
            "c" -> print
            context.sources[function.sourceModule] -> slice(nativeNameToken.span.start, UIntSize(1)) -> print
            nativeNameRequest -> textLiteralStart(context, state) => nativeNameByte!
            nativeNameRequest -> textLiteralEnd(context, state) => nativeNameEnd
            nativeNameByte! < nativeNameEnd -> while {
                function.sourceModule -> emitNativeSourceByte(nativeNameByte!, context, state)
                nativeNameByte! + 1 => nativeNameByte!
            }
            "\" -> print
            "00" -> print
            context.sources[function.sourceModule] -> slice(nativeNameToken.span.start, UIntSize(1)) -> println
        }
    nativeNameToken.kind != grammar.tokenIdString()
        -> if {
            nativeNameToken.span.length + 1 => nativeNameLength
            function -> nativeLibraryAst(context, state) => nativeNameLibraryAst
            context.nodes[nativeRange.astStart + nativeNameLibraryAst] => nativeNameLibrary
            context.tokens[nativeRange.tokenStart + nativeNameLibrary.secondaryToken] => nativeNameLibraryToken
            "@sollang_native_symbol_name_m$(nativeFunctionSourceModule)_s$(nativeFunctionSymbol) = private unnamed_addr constant [$nativeNameLength x i8] c" -> print
            context.sources[function.sourceModule] -> slice(nativeNameLibraryToken.span.start, UIntSize(1)) -> print
            nativeNameToken.span.start => nativeIdentifierByte!
            nativeNameToken.span.start + nativeNameToken.span.length => nativeNameEnd
            nativeIdentifierByte! < nativeNameEnd -> while {
                function.sourceModule -> emitNativeSourceByte(nativeIdentifierByte!, context, state)
                nativeIdentifierByte! + 1 => nativeIdentifierByte!
            }
            "\" -> print
            "00" -> print
            context.sources[function.sourceModule] -> slice(nativeNameLibraryToken.span.start, UIntSize(1)) -> println
        }
    "@sollang_native_function_m$(nativeFunctionSourceModule)_s$(nativeFunctionSymbol) = internal global ptr null, align 8" -> println
}
emitNativeRuntime context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context -> emitNativeHandleGlobals
    0 => nativeLibrarySource!
    nativeLibrarySource! < (context.ranges -> len)
        -> while {
            context.ranges[nativeLibrarySource!] => nativeLibraryRange
            0 => nativeLibraryAstIndex!
            nativeLibraryAstIndex! < nativeLibraryRange.astCount
                -> while {
                    context.nodes[nativeLibraryRange.astStart + nativeLibraryAstIndex!].kind == 65
                        -> if {
                            nativeLibrarySource! -> emitNativeLibraryGlobals(nativeLibraryAstIndex!, context, state)
                        }
                    nativeLibraryAstIndex! + 1 => nativeLibraryAstIndex!
                }
            nativeLibrarySource! + 1 => nativeLibrarySource!
        }
    0 => nativeGlobalFunctionIndex!
    nativeGlobalFunctionIndex! < (context.ir -> len)
        -> while {
            context.ir[nativeGlobalFunctionIndex!] => nativeGlobalFunction
            (nativeGlobalFunction -> isNativeFunction(context, state))
                and not (nativeGlobalFunction -> isImportedLibraryFunction(context, state))
                -> if {
                    nativeGlobalFunction -> emitNativeSymbolGlobals(context, state)
                }
            nativeGlobalFunctionIndex! + 1 => nativeGlobalFunctionIndex!
        }
    0 => importedLibraryGlobalIndex!
    importedLibraryGlobalIndex! < (context.libraries.interfaces -> len)
        -> while {
            importedLibraryGlobalIndex! -> emitImportedLibraryGlobals(context, state)
            importedLibraryGlobalIndex! + 1 => importedLibraryGlobalIndex!
        }
    """
    define internal ptr @sollang_native_require(ptr %value) {
    entry:
      %found = icmp ne ptr %value, null
      br i1 %found, label %done, label %fail
    fail:
      call void @llvm.trap()
      unreachable
    done:
      ret ptr %value
    }
    define internal void @sollang_native_init() {
    entry:
    """ -> println
    0 => nativeInitLibrarySource!
    nativeInitLibrarySource! < (context.ranges -> len)
        -> while {
            context.ranges[nativeInitLibrarySource!] => nativeInitLibraryRange
            0 => nativeInitLibraryAst!
            nativeInitLibraryAst! < nativeInitLibraryRange.astCount
                -> while {
                    context.nodes[nativeInitLibraryRange.astStart + nativeInitLibraryAst!].kind == 65
                        and nativeLibraryReachable(nativeInitLibrarySource!, nativeInitLibraryAst!, context, state)
                        -> if {
                            context.expectedPathStyle == 1 -> if {
                                "  %native_library_raw_m$(nativeInitLibrarySource!)_a$(nativeInitLibraryAst!) = call ptr @LoadLibraryA(ptr @sollang_native_library_name_m$(nativeInitLibrarySource!)_a$(nativeInitLibraryAst!))" -> println
                            }
                            context.expectedPathStyle != 1 -> if {
                                "  %native_library_raw_m$(nativeInitLibrarySource!)_a$(nativeInitLibraryAst!) = call ptr @dlopen(ptr @sollang_native_library_name_m$(nativeInitLibrarySource!)_a$(nativeInitLibraryAst!), i32 2)" -> println
                            }
                            "  %native_library_checked_m$(nativeInitLibrarySource!)_a$(nativeInitLibraryAst!) = call ptr @sollang_native_require(ptr %native_library_raw_m$(nativeInitLibrarySource!)_a$(nativeInitLibraryAst!))" -> println
                            "  store ptr %native_library_checked_m$(nativeInitLibrarySource!)_a$(nativeInitLibraryAst!), ptr @sollang_native_library_m$(nativeInitLibrarySource!)_a$(nativeInitLibraryAst!), align 8" -> println
                        }
                    nativeInitLibraryAst! + 1 => nativeInitLibraryAst!
                }
            nativeInitLibrarySource! + 1 => nativeInitLibrarySource!
        }
    0 => importedLibraryInitIndex!
    importedLibraryInitIndex! < (context.libraries.interfaces -> len)
        -> while {
            context.expectedPathStyle == 1 -> if {
                "  %library_raw_i$(importedLibraryInitIndex!) = call ptr @LoadLibraryA(ptr @sollang_library_name_i$(importedLibraryInitIndex!))" -> println
            }
            context.expectedPathStyle != 1 -> if {
                "  %library_raw_i$(importedLibraryInitIndex!) = call ptr @dlopen(ptr @sollang_library_name_i$(importedLibraryInitIndex!), i32 2)" -> println
            }
            "  %library_checked_i$(importedLibraryInitIndex!) = call ptr @sollang_native_require(ptr %library_raw_i$(importedLibraryInitIndex!))" -> println
            "  store ptr %library_checked_i$(importedLibraryInitIndex!), ptr @sollang_library_handle_i$(importedLibraryInitIndex!), align 8" -> println
            importedLibraryInitIndex! + 1 => importedLibraryInitIndex!
        }
    0 => nativeInitFunctionIndex!
    nativeInitFunctionIndex! < (context.ir -> len)
        -> while {
            context.ir[nativeInitFunctionIndex!] => nativeInitFunction
            (nativeInitFunctionIndex! -> nativeFunctionReachable(state))
                and (nativeInitFunction -> isNativeFunction(context, state))
                and not (nativeInitFunction -> isImportedLibraryFunction(context, state))
                -> if {
                    nativeInitFunction -> nativeLibraryAst(context, state) => nativeInitLibrary
                    nativeInitFunction.sourceModule => nativeInitSourceModule
                    nativeInitFunction.symbol => nativeInitSymbol
                    "  %native_library_m$(nativeInitSourceModule)_s$(nativeInitSymbol) = load ptr, ptr @sollang_native_library_m$(nativeInitSourceModule)_a$(nativeInitLibrary), align 8" -> println
                    context.expectedPathStyle == 1 -> if {
                        "  %native_symbol_raw_m$(nativeInitSourceModule)_s$(nativeInitSymbol) = call ptr @GetProcAddress(ptr %native_library_m$(nativeInitSourceModule)_s$(nativeInitSymbol), ptr @sollang_native_symbol_name_m$(nativeInitSourceModule)_s$(nativeInitSymbol))" -> println
                    }
                    context.expectedPathStyle != 1 -> if {
                        "  %native_symbol_raw_m$(nativeInitSourceModule)_s$(nativeInitSymbol) = call ptr @dlsym(ptr %native_library_m$(nativeInitSourceModule)_s$(nativeInitSymbol), ptr @sollang_native_symbol_name_m$(nativeInitSourceModule)_s$(nativeInitSymbol))" -> println
                    }
                    "  %native_symbol_checked_m$(nativeInitSourceModule)_s$(nativeInitSymbol) = call ptr @sollang_native_require(ptr %native_symbol_raw_m$(nativeInitSourceModule)_s$(nativeInitSymbol))" -> println
                    "  store ptr %native_symbol_checked_m$(nativeInitSourceModule)_s$(nativeInitSymbol), ptr @sollang_native_function_m$(nativeInitSourceModule)_s$(nativeInitSymbol), align 8" -> println
                }
            nativeInitFunctionIndex! + 1 => nativeInitFunctionIndex!
        }
    0 => importedSymbolInterface!
    importedSymbolInterface! < (context.libraries.interfaces -> len)
        -> while {
            0 => importedSymbolExport!
            importedSymbolExport! < (context.libraries.interfaces[importedSymbolInterface!].exports -> len)
                -> while {
                    "  %library_handle_i$(importedSymbolInterface!)_e$(importedSymbolExport!) = load ptr, ptr @sollang_library_handle_i$(importedSymbolInterface!), align 8" -> println
                    context.expectedPathStyle == 1 -> if {
                        "  %library_symbol_raw_i$(importedSymbolInterface!)_e$(importedSymbolExport!) = call ptr @GetProcAddress(ptr %library_handle_i$(importedSymbolInterface!)_e$(importedSymbolExport!), ptr @sollang_library_symbol_name_i$(importedSymbolInterface!)_e$(importedSymbolExport!))" -> println
                    }
                    context.expectedPathStyle != 1 -> if {
                        "  %library_symbol_raw_i$(importedSymbolInterface!)_e$(importedSymbolExport!) = call ptr @dlsym(ptr %library_handle_i$(importedSymbolInterface!)_e$(importedSymbolExport!), ptr @sollang_library_symbol_name_i$(importedSymbolInterface!)_e$(importedSymbolExport!))" -> println
                    }
                    "  %library_symbol_checked_i$(importedSymbolInterface!)_e$(importedSymbolExport!) = call ptr @sollang_native_require(ptr %library_symbol_raw_i$(importedSymbolInterface!)_e$(importedSymbolExport!))" -> println
                    "  store ptr %library_symbol_checked_i$(importedSymbolInterface!)_e$(importedSymbolExport!), ptr @sollang_library_function_i$(importedSymbolInterface!)_e$(importedSymbolExport!), align 8" -> println
                    importedSymbolExport! + 1 => importedSymbolExport!
                }
            importedSymbolInterface! + 1 => importedSymbolInterface!
        }
    context -> emitNativeHandleInitializers(state)
    """
      ret void
    }
    define internal void @sollang_native_cleanup() {
    entry:
    """ -> println
    0 => nativeCleanupSource!
    nativeCleanupSource! < (context.ranges -> len)
        -> while {
            context.ranges[nativeCleanupSource!] => nativeCleanupRange
            0 => nativeCleanupAst!
            nativeCleanupAst! < nativeCleanupRange.astCount
                -> while {
                    context.nodes[nativeCleanupRange.astStart + nativeCleanupAst!].kind == 65
                        and nativeLibraryReachable(nativeCleanupSource!, nativeCleanupAst!, context, state)
                        -> if {
                            "  %native_close_handle_m$(nativeCleanupSource!)_a$(nativeCleanupAst!) = load ptr, ptr @sollang_native_library_m$(nativeCleanupSource!)_a$(nativeCleanupAst!), align 8" -> println
                            context.expectedPathStyle == 1 -> if {
                                "  %native_closed_m$(nativeCleanupSource!)_a$(nativeCleanupAst!) = call i32 @FreeLibrary(ptr %native_close_handle_m$(nativeCleanupSource!)_a$(nativeCleanupAst!))" -> println
                            }
                            context.expectedPathStyle != 1 -> if {
                                "  %native_closed_m$(nativeCleanupSource!)_a$(nativeCleanupAst!) = call i32 @dlclose(ptr %native_close_handle_m$(nativeCleanupSource!)_a$(nativeCleanupAst!))" -> println
                            }
                        }
                    nativeCleanupAst! + 1 => nativeCleanupAst!
                }
            nativeCleanupSource! + 1 => nativeCleanupSource!
        }
    0 => importedCleanupIndex!
    importedCleanupIndex! < (context.libraries.interfaces -> len)
        -> while {
            "  %library_close_i$(importedCleanupIndex!) = load ptr, ptr @sollang_library_handle_i$(importedCleanupIndex!), align 8" -> println
            context.expectedPathStyle == 1 -> if {
                "  %library_closed_i$(importedCleanupIndex!) = call i32 @FreeLibrary(ptr %library_close_i$(importedCleanupIndex!))" -> println
            }
            context.expectedPathStyle != 1 -> if {
                "  %library_closed_i$(importedCleanupIndex!) = call i32 @dlclose(ptr %library_close_i$(importedCleanupIndex!))" -> println
            }
            importedCleanupIndex! + 1 => importedCleanupIndex!
        }
    """
      ret void
    }
    """ -> println
}
