        "  br label %file$(request.callIndex)_read_error_store" -> println
        "file$(request.callIndex)_read_error_truncated_store:" -> println
        "  %v$(request.callIndex)_file_truncated_text0 = insertvalue %sollang.text poison, ptr @sollang_file_error_truncated, 0" -> println
        "  %v$(request.callIndex)_file_truncated_text = insertvalue %sollang.text %v$(request.callIndex)_file_truncated_text0, i64 9, 1" -> println
