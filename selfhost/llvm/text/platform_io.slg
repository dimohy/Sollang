# Responsibility fragment extracted from emitCore. State is passed by readonly
# reference, preserving the original direct-call and allocation behavior.
emitEnumConstructor request: WhileValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[request.nodeIndex] => constructor
    constructor -> enumVariantTag(context) => variantTag
    "  %v$(request.nodeIndex)_enum_slot = alloca " -> print
    constructor -> writeIrType(context, state)
    ", align 8" -> println
    "  store " -> print
    constructor -> writeIrType(context, state)
    " zeroinitializer, ptr %v$(request.nodeIndex)_enum_slot, align 8" -> println
    "  %v$(request.nodeIndex)_enum_tag = getelementptr inbounds " -> print
    constructor -> writeIrType(context, state)
    ", ptr %v$(request.nodeIndex)_enum_slot, i32 0, i32 0" -> println
    "  store i32 $variantTag, ptr %v$(request.nodeIndex)_enum_tag, align 4" -> println
    constructor.operand0 >= 0 -> if {
        constructor.operand0 -> aggregateValueIndex(context, state) => payloadIndex
        context.ir[payloadIndex] => payload
        payload -> effectiveTypeId(context, state) => payloadTypeId
        payloadTypeId < 0 or context.typeSizes[payloadTypeId] > 0
            -> if {
                "  %v$(request.nodeIndex)_enum_payload = getelementptr inbounds " -> print
                constructor -> writeIrType(context, state)
                ", ptr %v$(request.nodeIndex)_enum_slot, i32 0, i32 1" -> println
                payloadTypeId >= 0
                    and context.types[payloadTypeId].kind == 4
                    and context.types[payloadTypeId].length >= 0
                    -> if {
                        "  %v$(request.nodeIndex)_enum_payload_source = extractvalue { ptr, i64 } " -> print
                        payloadIndex -> writeValue(request.ownerIndex, context, state)
                        ", 0" -> println
                        "  call void @llvm.memcpy.p0.p0.i64(ptr %v$(request.nodeIndex)_enum_payload, ptr %v$(request.nodeIndex)_enum_payload_source, i64 $(context.typeSizes[payloadTypeId]), i1 false)" -> println
                    } else {
                        "  store " -> print
                        payload -> writeIrType(context, state)
                        " " -> print
                        payload.kind == 3 or payload.kind == 4 -> if {
                            payload -> sourceToken(context, state) => payloadToken
                            payload.kind == 3 -> if {
                                payload -> writeIntegerLiteral(context, state)
                            } else {
                                (context.sources[payload.sourceModule] -> byte(payloadToken.span.start)) == 116
                                    -> if { "1" -> print } else { "0" -> print }
                            }
                        } else {
                            payload.kind == 5 and request.ownerIndex >= 0 and context.ir[request.ownerIndex].operand1 >= 0 and payload.symbol == context.ir[context.ir[request.ownerIndex].operand1].symbol
                                -> if { "%arg" -> print } else { "%v$(payloadIndex)" -> print }
                        }
                        ", ptr %v$(request.nodeIndex)_enum_payload, align " -> print
                        payload -> storageAlign(context, state) -> writeDecimalLine
                    }
            }
    }
    "  %v$(request.nodeIndex) = load " -> print
    constructor -> writeIrType(context, state)
    ", ptr %v$(request.nodeIndex)_enum_slot, align 8" -> println
}
emitProcessProjectionCall request: ProcessCallRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[request.callIndex] => call
    call.operand0 -> aggregateValueIndex(context, state) => receiverIndex
    context.ir[receiverIndex] => receiver
    "  %v$(request.callIndex) = extractvalue " -> print
    receiver -> writeIrType(context, state)
    " " -> print
    receiverIndex -> writeValue(request.ownerIndex, context, state)
    call.opcode == -285 -> if { ", 1" -> println } else { ", 0" -> println }
}
