            "  %v$(request.callIndex)_process_capture_stderr1 = insertvalue " -> print
            capturedStderrType -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_process_capture_stderr0, i64 %v$(request.callIndex)_process_capture_stderr_len, 1" -> println
            "  %v$(request.callIndex)_process_capture_stderr2 = insertvalue " -> print
            capturedStderrType -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_process_capture_stderr1, i64 %v$(request.callIndex)_process_capture_stderr_capacity, 2" -> println
            "  %v$(request.callIndex)_process_capture_stderr_address = getelementptr inbounds " -> print
            capturedOutputType -> writeSemanticTypeId(context, state)
            ", ptr %v$(request.callIndex)_process_ok_payload, i32 0, i32 2" -> println
            "  store " -> print
            capturedStderrType -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_process_capture_stderr2, ptr %v$(request.callIndex)_process_capture_stderr_address, align 8" -> println
            "  %v$(request.callIndex)_process_capture_stdout_truncated_address = getelementptr inbounds " -> print
            capturedOutputType -> writeSemanticTypeId(context, state)
            ", ptr %v$(request.callIndex)_process_ok_payload, i32 0, i32 3" -> println
            "  store i1 %v$(request.callIndex)_process_capture_stdout_truncated, ptr %v$(request.callIndex)_process_capture_stdout_truncated_address, align 1" -> println
            "  %v$(request.callIndex)_process_capture_stderr_truncated_address = getelementptr inbounds " -> print
            capturedOutputType -> writeSemanticTypeId(context, state)
            ", ptr %v$(request.callIndex)_process_ok_payload, i32 0, i32 4" -> println
            "  store i1 %v$(request.callIndex)_process_capture_stderr_truncated, ptr %v$(request.callIndex)_process_capture_stderr_truncated_address, align 1" -> println
        } else {
            "  store i32 %v$(request.callIndex)_process_value, ptr %v$(request.callIndex)_process_ok_payload, align 4" -> println
        }
    }
    "  br label %process$(request.callIndex)_merge" -> println
    "process$(request.callIndex)_error:" -> println
    "  %v$(request.callIndex)_process_error_tag = getelementptr inbounds " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_process_result_slot, i32 0, i32 0" -> println
    "  store i32 1, ptr %v$(request.callIndex)_process_error_tag, align 4" -> println
    "  %v$(request.callIndex)_process_is_wait = icmp eq i32 %v$(request.callIndex)_process_error, 2" -> println
    "  %v$(request.callIndex)_process_is_signal = icmp eq i32 %v$(request.callIndex)_process_error, 3" -> println
    "  %v$(request.callIndex)_process_is_capture = icmp eq i32 %v$(request.callIndex)_process_error, 4" -> println
    "  %v$(request.callIndex)_process_wait_ptr = select i1 %v$(request.callIndex)_process_is_wait, ptr @sollang_process_error_wait, ptr @sollang_process_error_spawn" -> println
    "  %v$(request.callIndex)_process_wait_len = select i1 %v$(request.callIndex)_process_is_wait, i64 4, i64 5" -> println
    "  %v$(request.callIndex)_process_signal_ptr = select i1 %v$(request.callIndex)_process_is_signal, ptr @sollang_process_error_signal, ptr %v$(request.callIndex)_process_wait_ptr" -> println
    "  %v$(request.callIndex)_process_signal_len = select i1 %v$(request.callIndex)_process_is_signal, i64 6, i64 %v$(request.callIndex)_process_wait_len" -> println
    "  %v$(request.callIndex)_process_error_ptr = select i1 %v$(request.callIndex)_process_is_capture, ptr @sollang_process_error_capture, ptr %v$(request.callIndex)_process_signal_ptr" -> println
    "  %v$(request.callIndex)_process_error_len = select i1 %v$(request.callIndex)_process_is_capture, i64 7, i64 %v$(request.callIndex)_process_signal_len" -> println
    "  %v$(request.callIndex)_process_error_text0 = insertvalue %sollang.text poison, ptr %v$(request.callIndex)_process_error_ptr, 0" -> println
    "  %v$(request.callIndex)_process_error_text = insertvalue %sollang.text %v$(request.callIndex)_process_error_text0, i64 %v$(request.callIndex)_process_error_len, 1" -> println
    "  %v$(request.callIndex)_process_error_payload = getelementptr inbounds " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_process_result_slot, i32 0, i32 1" -> println
    "  store %sollang.text %v$(request.callIndex)_process_error_text, ptr %v$(request.callIndex)_process_error_payload, align 8" -> println
    "  br label %process$(request.callIndex)_merge" -> println
    "process$(request.callIndex)_merge:" -> println
    "  %v$(request.callIndex) = load " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_process_result_slot, align 8" -> println
}
emitEnvironmentCall request: ProcessCallRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[request.callIndex] => call
    request.callIndex -> callArgumentIndex(context, state) => argumentIndex!
    argumentIndex! -> aggregateValueIndex(context, state) => argumentIndex!
    context.ir[argumentIndex!] => argument
    "  %v$(request.callIndex)_environment_name_ptr = extractvalue %sollang.text " -> print
    argumentIndex! -> writeValue(request.ownerIndex, context, state)
    ", 0" -> println
    "  %v$(request.callIndex)_environment_name_len = extractvalue %sollang.text " -> print
    argumentIndex! -> writeValue(request.ownerIndex, context, state)
    ", 1" -> println
    "  %v$(request.callIndex)_environment_raw = call %sollang.environment_result @sollang_environment(ptr %v$(request.callIndex)_environment_name_ptr, i64 %v$(request.callIndex)_environment_name_len)" -> println
    "  %v$(request.callIndex)_environment_ptr = extractvalue %sollang.environment_result %v$(request.callIndex)_environment_raw, 0" -> println
    "  %v$(request.callIndex)_environment_len = extractvalue %sollang.environment_result %v$(request.callIndex)_environment_raw, 1" -> println
    "  %v$(request.callIndex)_environment_found = extractvalue %sollang.environment_result %v$(request.callIndex)_environment_raw, 2" -> println
    "  %v$(request.callIndex)_environment_ok = extractvalue %sollang.environment_result %v$(request.callIndex)_environment_raw, 3" -> println
    "  br i1 %v$(request.callIndex)_environment_ok, label %environment$(request.callIndex)_prepare, label %environment$(request.callIndex)_trap" -> println
    "environment$(request.callIndex)_trap:" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "environment$(request.callIndex)_prepare:" -> println
    "  %v$(request.callIndex)_environment_slot = alloca " -> print
    call -> writeIrType(context, state)
    ", align 8" -> println
    "  store " -> print
    call -> writeIrType(context, state)
    " zeroinitializer, ptr %v$(request.callIndex)_environment_slot, align 8" -> println
    "  br i1 %v$(request.callIndex)_environment_found, label %environment$(request.callIndex)_some, label %environment$(request.callIndex)_merge" -> println
    "environment$(request.callIndex)_some:" -> println
    "  %v$(request.callIndex)_environment_some_tag = getelementptr inbounds " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_environment_slot, i32 0, i32 0" -> println
    "  store i32 1, ptr %v$(request.callIndex)_environment_some_tag, align 4" -> println
    "  %v$(request.callIndex)_environment_text0 = insertvalue %sollang.text poison, ptr %v$(request.callIndex)_environment_ptr, 0" -> println
    "  %v$(request.callIndex)_environment_text = insertvalue %sollang.text %v$(request.callIndex)_environment_text0, i64 %v$(request.callIndex)_environment_len, 1" -> println
    "  %v$(request.callIndex)_environment_some_payload = getelementptr inbounds " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_environment_slot, i32 0, i32 1" -> println
    "  store %sollang.text %v$(request.callIndex)_environment_text, ptr %v$(request.callIndex)_environment_some_payload, align 8" -> println
    "  br label %environment$(request.callIndex)_merge" -> println
    "environment$(request.callIndex)_merge:" -> println
    "  %v$(request.callIndex) = load " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_environment_slot, align 8" -> println
}
emitExitCall callIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    callIndex -> callArgumentIndex(context, state) => argumentIndex
    context.ir[argumentIndex] => argument
    context -> diagnostics.usesTextRuntime -> if { "  call void @sollang_runtime_flush_stdout()" -> println }
    context.expectedPathStyle == 1 -> if { "  call void @ExitProcess(i32 " -> print } else { "  call void @exit(i32 " -> print }
    argument.kind == 3 -> if {
        argument -> writeIntegerLiteral(context, state)
    } else { "%v$(argumentIndex)" -> print }
    ")" -> println
}

socketNominalTypeNamed module: Int, expected: Text, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => foundType!
    0 => candidateIndex!
    candidateIndex! < (context.types -> len) -> while {
        context.types[candidateIndex!] => candidate
        candidate.status == 0 and candidate.kind == 1 and candidate.module == module
            -> if {
                candidateIndex! -> nominalDeclarationAst(context, state) => declarationAst
                declarationAst >= 0 -> if {
                    context.ranges[module] => moduleRange
                    context.nodes[moduleRange.astStart + declarationAst] => declaration
                    declaration.payloadToken >= 0 -> if {
                        context.tokens[moduleRange.tokenStart + declaration.payloadToken] => declarationName
                        declarationName.span.length == (expected -> len) => equal!
                        UIntSize(0) => nameByte!
                        equal! and nameByte! < declarationName.span.length
                            -> while {
                                (context.sources[module] -> byte(declarationName.span.start + nameByte!)) != (expected -> byte(nameByte!))
                                    -> if { false => equal! }
                                nameByte! + 1 => nameByte!
                            }
                        equal! -> if { candidateIndex! => foundType! }
                    }
                }
            }
        candidateIndex! + 1 => candidateIndex!
    }
    foundType!
}

emitSocketEndpointDescriptor callIndex: Int, endpointTypeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.types[endpointTypeId].module => endpointModule
    endpointModule -> socketNominalTypeNamed("Ipv4Endpoint", context, state) => ipv4EndpointType!
    endpointModule -> socketNominalTypeNamed("Ipv6Endpoint", context, state) => ipv6EndpointType!
    endpointTypeId -> enumPayloadTypes(context, state) => payloadTypes
    ipv4EndpointType! < 0 and (payloadTypes -> len) > 0
        -> if { payloadTypes[0] => ipv4EndpointType! }
    ipv6EndpointType! < 0 and (payloadTypes -> len) > 1
        -> if { payloadTypes[1] => ipv6EndpointType! }
    nominalFieldType(ipv4EndpointType!, 0, context) => ipv4AddressType
    nominalFieldType(ipv6EndpointType!, 0, context) => ipv6AddressType

    "  %v$(callIndex)_socket_endpoint_descriptor = alloca [32 x i8], align 8" -> println
    "  call void @llvm.memset.p0.i64(ptr %v$(callIndex)_socket_endpoint_descriptor, i8 0, i64 32, i1 false)" -> println
    "  %v$(callIndex)_socket_endpoint_tag = extractvalue " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_endpoint, 0" -> println
    "  %v$(callIndex)_socket_endpoint_is_ipv4 = icmp eq i32 %v$(callIndex)_socket_endpoint_tag, 0" -> println
    "  br i1 %v$(callIndex)_socket_endpoint_is_ipv4, label %socket_endpoint$(callIndex)_ipv4, label %socket_endpoint$(callIndex)_ipv6" -> println

    "socket_endpoint$(callIndex)_ipv4:" -> println
    "  %v$(callIndex)_socket_endpoint_enum_slot4 = alloca " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", align 8" -> println
    "  store " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_endpoint, ptr %v$(callIndex)_socket_endpoint_enum_slot4, align 8" -> println
    "  %v$(callIndex)_socket_endpoint_payload_address4 = getelementptr inbounds " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(callIndex)_socket_endpoint_enum_slot4, i32 0, i32 1" -> println
    "  %v$(callIndex)_socket_endpoint_ipv4 = load " -> print
    ipv4EndpointType! -> writeSemanticTypeId(context, state)
    ", ptr %v$(callIndex)_socket_endpoint_payload_address4, align 2" -> println
    "  %v$(callIndex)_socket_endpoint_ipv4_address = extractvalue " -> print
    ipv4EndpointType! -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_endpoint_ipv4, 0" -> println
    "  %v$(callIndex)_socket_endpoint_family4 = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 0" -> println
    "  store i32 4, ptr %v$(callIndex)_socket_endpoint_family4, align 4" -> println
    0 => ipv4Ordinal!
    ipv4Ordinal! < 4 -> while {
        "  %v$(callIndex)_socket_endpoint_ipv4_octet$(ipv4Ordinal!) = extractvalue " -> print
        ipv4AddressType -> writeSemanticTypeId(context, state)
        " %v$(callIndex)_socket_endpoint_ipv4_address, $(ipv4Ordinal!)" -> println
        "  %v$(callIndex)_socket_endpoint_ipv4_word$(ipv4Ordinal!) = zext i8 %v$(callIndex)_socket_endpoint_ipv4_octet$(ipv4Ordinal!) to i16" -> println
        "  %v$(callIndex)_socket_endpoint_ipv4_target$(ipv4Ordinal!) = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 $(4 + ipv4Ordinal! * 2)" -> println
        "  store i16 %v$(callIndex)_socket_endpoint_ipv4_word$(ipv4Ordinal!), ptr %v$(callIndex)_socket_endpoint_ipv4_target$(ipv4Ordinal!), align 2" -> println
        ipv4Ordinal! + 1 => ipv4Ordinal!
    }
    "  %v$(callIndex)_socket_endpoint_port4 = extractvalue " -> print
    ipv4EndpointType! -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_endpoint_ipv4, 1" -> println
    "  %v$(callIndex)_socket_endpoint_port_target4 = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 20" -> println
    "  store i16 %v$(callIndex)_socket_endpoint_port4, ptr %v$(callIndex)_socket_endpoint_port_target4, align 2" -> println
    "  br label %socket_endpoint$(callIndex)_complete" -> println

    "socket_endpoint$(callIndex)_ipv6:" -> println
    "  %v$(callIndex)_socket_endpoint_enum_slot6 = alloca " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", align 8" -> println
    "  store " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_endpoint, ptr %v$(callIndex)_socket_endpoint_enum_slot6, align 8" -> println
    "  %v$(callIndex)_socket_endpoint_payload_address6 = getelementptr inbounds " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(callIndex)_socket_endpoint_enum_slot6, i32 0, i32 1" -> println
    "  %v$(callIndex)_socket_endpoint_ipv6 = load " -> print
    ipv6EndpointType! -> writeSemanticTypeId(context, state)
    ", ptr %v$(callIndex)_socket_endpoint_payload_address6, align 4" -> println
    "  %v$(callIndex)_socket_endpoint_ipv6_address = extractvalue " -> print
    ipv6EndpointType! -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_endpoint_ipv6, 0" -> println
    "  %v$(callIndex)_socket_endpoint_family6 = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 0" -> println
    "  store i32 6, ptr %v$(callIndex)_socket_endpoint_family6, align 4" -> println
    0 => ipv6Ordinal!
    ipv6Ordinal! < 8 -> while {
        "  %v$(callIndex)_socket_endpoint_ipv6_group$(ipv6Ordinal!) = extractvalue " -> print
        ipv6AddressType -> writeSemanticTypeId(context, state)
        " %v$(callIndex)_socket_endpoint_ipv6_address, $(ipv6Ordinal!)" -> println
        "  %v$(callIndex)_socket_endpoint_ipv6_target$(ipv6Ordinal!) = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 $(4 + ipv6Ordinal! * 2)" -> println
        "  store i16 %v$(callIndex)_socket_endpoint_ipv6_group$(ipv6Ordinal!), ptr %v$(callIndex)_socket_endpoint_ipv6_target$(ipv6Ordinal!), align 2" -> println
        ipv6Ordinal! + 1 => ipv6Ordinal!
    }
    [1, 2, 3; ~] => ipv6FieldOrdinals
    [20, 24, 28; ~] => ipv6FieldOffsets
    0 => ipv6FieldIndex!
    ipv6FieldIndex! < 3 -> while {
        ipv6FieldOrdinals[ipv6FieldIndex!] => fieldOrdinal
        ipv6FieldOffsets[ipv6FieldIndex!] => fieldOffset
        "  %v$(callIndex)_socket_endpoint_ipv6_field$(ipv6FieldIndex!) = extractvalue " -> print
        ipv6EndpointType! -> writeSemanticTypeId(context, state)
        " %v$(callIndex)_socket_endpoint_ipv6, $fieldOrdinal" -> println
        "  %v$(callIndex)_socket_endpoint_ipv6_field_target$(ipv6FieldIndex!) = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 $fieldOffset" -> println
        "  store " -> print
        ipv6FieldIndex! == 0 -> if { "i16" -> print } else { "i32" -> print }
        " %v$(callIndex)_socket_endpoint_ipv6_field$(ipv6FieldIndex!), ptr %v$(callIndex)_socket_endpoint_ipv6_field_target$(ipv6FieldIndex!), align " -> print
        ipv6FieldIndex! == 0 -> if { "2" -> println } else { "4" -> println }
        ipv6FieldIndex! + 1 => ipv6FieldIndex!
    }
    "  br label %socket_endpoint$(callIndex)_complete" -> println
    "socket_endpoint$(callIndex)_complete:" -> println
}

emitSocketEndpointFromDescriptor callIndex: Int, endpointTypeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.types[endpointTypeId].module => endpointModule
    endpointModule -> socketNominalTypeNamed("Ipv4Endpoint", context, state) => ipv4EndpointType!
    endpointModule -> socketNominalTypeNamed("Ipv6Endpoint", context, state) => ipv6EndpointType!
    endpointTypeId -> enumPayloadTypes(context, state) => payloadTypes
    ipv4EndpointType! < 0 and (payloadTypes -> len) > 0
        -> if { payloadTypes[0] => ipv4EndpointType! }
    ipv6EndpointType! < 0 and (payloadTypes -> len) > 1
        -> if { payloadTypes[1] => ipv6EndpointType! }
    nominalFieldType(ipv4EndpointType!, 0, context) => ipv4AddressType
    nominalFieldType(ipv6EndpointType!, 0, context) => ipv6AddressType

    "  %v$(callIndex)_socket_source_slot = alloca " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", align 8" -> println
    "  store " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    " zeroinitializer, ptr %v$(callIndex)_socket_source_slot, align 8" -> println
    "  %v$(callIndex)_socket_source_family = load i32, ptr %v$(callIndex)_socket_endpoint_descriptor, align 4" -> println
    "  %v$(callIndex)_socket_source_is_ipv4 = icmp eq i32 %v$(callIndex)_socket_source_family, 4" -> println
    "  br i1 %v$(callIndex)_socket_source_is_ipv4, label %socket_source$(callIndex)_ipv4, label %socket_source$(callIndex)_ipv6" -> println

    "socket_source$(callIndex)_ipv4:" -> println
    0 => ipv4Ordinal!
    ipv4Ordinal! < 4 -> while {
        "  %v$(callIndex)_socket_source_ipv4_word$(ipv4Ordinal!)_address = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 $(4 + ipv4Ordinal! * 2)" -> println
        "  %v$(callIndex)_socket_source_ipv4_word$(ipv4Ordinal!) = load i16, ptr %v$(callIndex)_socket_source_ipv4_word$(ipv4Ordinal!)_address, align 2" -> println
        "  %v$(callIndex)_socket_source_ipv4_octet$(ipv4Ordinal!) = trunc i16 %v$(callIndex)_socket_source_ipv4_word$(ipv4Ordinal!) to i8" -> println
        "  %v$(callIndex)_socket_source_ipv4_address$(ipv4Ordinal!) = insertvalue " -> print
        ipv4AddressType -> writeSemanticTypeId(context, state)
        " " -> print
        ipv4Ordinal! == 0 -> if { "poison" -> print } else { "%v$(callIndex)_socket_source_ipv4_address$(ipv4Ordinal! - 1)" -> print }
        ", i8 %v$(callIndex)_socket_source_ipv4_octet$(ipv4Ordinal!), $(ipv4Ordinal!)" -> println
        ipv4Ordinal! + 1 => ipv4Ordinal!
    }
    "  %v$(callIndex)_socket_source_ipv4_port_address = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 20" -> println
    "  %v$(callIndex)_socket_source_ipv4_port = load i16, ptr %v$(callIndex)_socket_source_ipv4_port_address, align 2" -> println
    "  %v$(callIndex)_socket_source_ipv4_endpoint0 = insertvalue " -> print
    ipv4EndpointType! -> writeSemanticTypeId(context, state)
    " poison, " -> print
    ipv4AddressType -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_source_ipv4_address3, 0" -> println
    "  %v$(callIndex)_socket_source_ipv4_endpoint = insertvalue " -> print
    ipv4EndpointType! -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_source_ipv4_endpoint0, i16 %v$(callIndex)_socket_source_ipv4_port, 1" -> println
    "  %v$(callIndex)_socket_source_tag4 = getelementptr inbounds " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(callIndex)_socket_source_slot, i32 0, i32 0" -> println
    "  store i32 0, ptr %v$(callIndex)_socket_source_tag4, align 4" -> println
    "  %v$(callIndex)_socket_source_payload4 = getelementptr inbounds " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(callIndex)_socket_source_slot, i32 0, i32 1" -> println
    "  store " -> print
    ipv4EndpointType! -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_source_ipv4_endpoint, ptr %v$(callIndex)_socket_source_payload4, align 2" -> println
    "  br label %socket_source$(callIndex)_complete" -> println

    "socket_source$(callIndex)_ipv6:" -> println
    0 => ipv6Ordinal!
    ipv6Ordinal! < 8 -> while {
        "  %v$(callIndex)_socket_source_ipv6_group$(ipv6Ordinal!)_address = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 $(4 + ipv6Ordinal! * 2)" -> println
        "  %v$(callIndex)_socket_source_ipv6_group$(ipv6Ordinal!) = load i16, ptr %v$(callIndex)_socket_source_ipv6_group$(ipv6Ordinal!)_address, align 2" -> println
        "  %v$(callIndex)_socket_source_ipv6_address$(ipv6Ordinal!) = insertvalue " -> print
        ipv6AddressType -> writeSemanticTypeId(context, state)
        " " -> print
        ipv6Ordinal! == 0 -> if { "poison" -> print } else { "%v$(callIndex)_socket_source_ipv6_address$(ipv6Ordinal! - 1)" -> print }
        ", i16 %v$(callIndex)_socket_source_ipv6_group$(ipv6Ordinal!), $(ipv6Ordinal!)" -> println
        ipv6Ordinal! + 1 => ipv6Ordinal!
    }
    "  %v$(callIndex)_socket_source_ipv6_endpoint0 = insertvalue " -> print
    ipv6EndpointType! -> writeSemanticTypeId(context, state)
    " poison, " -> print
    ipv6AddressType -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_source_ipv6_address7, 0" -> println
    ["port", "flow", "scope"] => ipv6Names
    [20, 24, 28] => ipv6Offsets
    0 => ipv6FieldIndex!
    ipv6FieldIndex! < 3 -> while {
        ipv6FieldIndex! == 0 -> if { "i16" } else { "i32" } => fieldIrType
        "  %v$(callIndex)_socket_source_ipv6_$(ipv6Names[ipv6FieldIndex!])_address = getelementptr i8, ptr %v$(callIndex)_socket_endpoint_descriptor, i64 $(ipv6Offsets[ipv6FieldIndex!])" -> println
        "  %v$(callIndex)_socket_source_ipv6_$(ipv6Names[ipv6FieldIndex!]) = load $fieldIrType, ptr %v$(callIndex)_socket_source_ipv6_$(ipv6Names[ipv6FieldIndex!])_address, align " -> print
        ipv6FieldIndex! == 0 -> if { "2" -> println } else { "4" -> println }
        "  %v$(callIndex)_socket_source_ipv6_endpoint$(ipv6FieldIndex! + 1) = insertvalue " -> print
        ipv6EndpointType! -> writeSemanticTypeId(context, state)
        " %v$(callIndex)_socket_source_ipv6_endpoint$(ipv6FieldIndex!), $fieldIrType %v$(callIndex)_socket_source_ipv6_$(ipv6Names[ipv6FieldIndex!]), $(ipv6FieldIndex! + 1)" -> println
        ipv6FieldIndex! + 1 => ipv6FieldIndex!
    }
    "  %v$(callIndex)_socket_source_tag6 = getelementptr inbounds " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(callIndex)_socket_source_slot, i32 0, i32 0" -> println
    "  store i32 1, ptr %v$(callIndex)_socket_source_tag6, align 4" -> println
    "  %v$(callIndex)_socket_source_payload6 = getelementptr inbounds " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(callIndex)_socket_source_slot, i32 0, i32 1" -> println
    "  store " -> print
    ipv6EndpointType! -> writeSemanticTypeId(context, state)
    " %v$(callIndex)_socket_source_ipv6_endpoint3, ptr %v$(callIndex)_socket_source_payload6, align 4" -> println
    "  br label %socket_source$(callIndex)_complete" -> println
    "socket_source$(callIndex)_complete:" -> println
    "  %v$(callIndex)_socket_source_endpoint = load " -> print
    endpointTypeId -> writeSemanticTypeId(context, state)
    ", ptr %v$(callIndex)_socket_source_slot, align 8" -> println
}

emitSocketCall request: SocketCallRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[request.callIndex] => call
    call.opcode == -272 or call.opcode == -287 or call.opcode == -290 or call.opcode == -291 or call.opcode == -292 or call.opcode == -302
        -> if {
            call.operand0 -> emitMutableBorrowArgumentValues(request.callIndex, request.ownerIndex, 0, context, state)
        }
    call.opcode == -270 -> if {
        call.operand0 -> aggregateValueIndex(context, state) => ownerIndex
        context.ir[ownerIndex] => owner
        "  %v$(request.callIndex)_socket_handle = extractvalue " -> print
        owner -> writeIrType(context, state)
        " " -> print
        ownerIndex -> writeValue(request.ownerIndex, context, state)
        ", 0" -> println
        "  call void @sollang_platform_close_socket(i64 %v$(request.callIndex)_socket_handle)" -> println
    } else {
        request -> emitSocketResultCall(context, state)
    }
}

# Stateful socket wrappers are affine, so a readonly method on an outer owner
# can expose its socket field as a reference-backed value. The generic
# expression pass has already materialized that value as %v<node>. Intrinsic
# lowering must use the referenced nominal value type and that SSA value, while
# ordinary by-value receivers retain the existing writer path.
writeSocketReceiverType valueIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[valueIndex] => value
    value -> referenceValueTypeId(context, state) => referencedTypeId
    referencedTypeId >= 0 -> if {
        referencedTypeId -> writeSemanticTypeId(context, state)
    } else {
        value -> writeIrType(context, state)
    }
}

writeSocketReceiverValue valueIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[valueIndex] -> referenceValueTypeId(context, state) >= 0
        -> if {
            "%v$(valueIndex)" -> print
        } else {
            valueIndex -> writeValue(ownerIndex, context, state)
        }
}

emitSocketResultCall request: SocketCallRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[request.callIndex] => call
    call.operand0 => firstArgumentIndex
    firstArgumentIndex -> aggregateValueIndex(context, state) => firstValueIndex
    context.ir[firstValueIndex] => firstValue
    -1 => secondArgumentIndex!
    firstArgumentIndex >= 0 -> if { context.ir[firstArgumentIndex].nextOperand => secondArgumentIndex! }
    -1 => thirdArgumentIndex!
    secondArgumentIndex! >= 0 -> if { context.ir[secondArgumentIndex!].nextOperand => thirdArgumentIndex! }
    -1 => fourthArgumentIndex!
    thirdArgumentIndex! >= 0 -> if { context.ir[thirdArgumentIndex!].nextOperand => fourthArgumentIndex! }
    secondArgumentIndex! >= 0 -> if { secondArgumentIndex! -> aggregateValueIndex(context, state) => secondArgumentIndex! }
    thirdArgumentIndex! >= 0 -> if { thirdArgumentIndex! -> aggregateValueIndex(context, state) => thirdArgumentIndex! }
    fourthArgumentIndex! >= 0 -> if { fourthArgumentIndex! -> aggregateValueIndex(context, state) => fourthArgumentIndex! }
    # listen(ListenOptions)
    call.opcode == -258 -> if {
        "  %v$(request.callIndex)_socket_endpoint = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 0" -> println
        firstValue -> effectiveTypeId(context, state) => socketOptionsType
        nominalFieldType(socketOptionsType, 0, context) => socketEndpointType
        request.callIndex -> emitSocketEndpointDescriptor(socketEndpointType, context, state)
        "  %v$(request.callIndex)_socket_backlog = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 1" -> println
        "  %v$(request.callIndex)_socket_backlog64 = sext i32 %v$(request.callIndex)_socket_backlog to i64" -> println
        "  %v$(request.callIndex)_socket_reuse = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 2" -> println
        "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_listen(ptr %v$(request.callIndex)_socket_endpoint_descriptor, i64 %v$(request.callIndex)_socket_backlog64, i1 %v$(request.callIndex)_socket_reuse)" -> println
    }
    # bindDatagram(DatagramBindOptions)
    call.opcode == -265 -> if {
        "  %v$(request.callIndex)_socket_endpoint = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 0" -> println
        firstValue -> effectiveTypeId(context, state) => socketOptionsType
        nominalFieldType(socketOptionsType, 0, context) => socketEndpointType
        request.callIndex -> emitSocketEndpointDescriptor(socketEndpointType, context, state)
        "  %v$(request.callIndex)_socket_reuse = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 1" -> println
        "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_bind_datagram(ptr %v$(request.callIndex)_socket_endpoint_descriptor, i1 %v$(request.callIndex)_socket_reuse)" -> println
    }
    # accept(TcpListener), localPort(UdpSocket)
    call.opcode == -259 or call.opcode == -268
        -> if {
            "  %v$(request.callIndex)_socket_handle = extractvalue " -> print
            firstValueIndex -> writeSocketReceiverType(context, state)
            " " -> print
            firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
            ", 0" -> println
            "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_" -> print
            call.opcode == -259 -> if { "accept" -> print } else { "local_port" -> print }
            "(i64 %v$(request.callIndex)_socket_handle)" -> println
        }
    # localEndpoint/remoteEndpoint observe the native socket directly into the
    # fixed descriptor used by sendTo/receiveFrom; no text or heap wrapper.
    call.opcode == -273 or call.opcode == -274 -> if {
        "  %v$(request.callIndex)_socket_handle = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 0" -> println
        "  %v$(request.callIndex)_socket_endpoint_descriptor = alloca [32 x i8], align 8" -> println
        "  call void @llvm.memset.p0.i64(ptr %v$(request.callIndex)_socket_endpoint_descriptor, i8 0, i64 32, i1 false)" -> println
        "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_" -> print
        call.opcode == -273 -> if { "local_endpoint" -> print } else { "remote_endpoint" -> print }
        "(i64 %v$(request.callIndex)_socket_handle, ptr %v$(request.callIndex)_socket_endpoint_descriptor)" -> println
    }
    # Socket options lower directly to native calls. The instance is
    # only the affine handle; these operations add no wrapper or heap storage.
    call.opcode == -297 -> if {
        "  %v$(request.callIndex)_socket_handle = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 0" -> println
        "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_set_nonblocking(i64 %v$(request.callIndex)_socket_handle, i1 " -> print
        secondArgumentIndex! -> writeValue(request.ownerIndex, context, state)
        ")" -> println
    }
    call.opcode == -298 -> if {
        "  %v$(request.callIndex)_socket_handle = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 0" -> println
        "  %v$(request.callIndex)_socket_poll_mode = extractvalue " -> print
        context.ir[secondArgumentIndex!] -> writeIrType(context, state)
        " " -> print
        secondArgumentIndex! -> writeValue(request.ownerIndex, context, state)
        ", 0" -> println
        context.ir[thirdArgumentIndex!] => pollTimeoutOption
        pollTimeoutOption.typeId => pollTimeoutOptionType
        context.types[pollTimeoutOptionType].first => pollTimeoutDurationType
        "  %v$(request.callIndex)_socket_poll_timeout_tag = extractvalue " -> print
        pollTimeoutOptionType -> writeSemanticTypeId(context, state)
        " " -> print
        thirdArgumentIndex! -> writeValue(request.ownerIndex, context, state)
        ", 0" -> println
        "  %v$(request.callIndex)_socket_poll_has_timeout = icmp eq i32 %v$(request.callIndex)_socket_poll_timeout_tag, 1" -> println
        "  %v$(request.callIndex)_socket_poll_timeout_slot = alloca " -> print
        pollTimeoutOptionType -> writeSemanticTypeId(context, state)
        ", align 8" -> println
        "  store " -> print
        pollTimeoutOptionType -> writeSemanticTypeId(context, state)
        " " -> print
        thirdArgumentIndex! -> writeValue(request.ownerIndex, context, state)
        ", ptr %v$(request.callIndex)_socket_poll_timeout_slot, align 8" -> println
        "  %v$(request.callIndex)_socket_poll_timeout_payload = getelementptr inbounds " -> print
        pollTimeoutOptionType -> writeSemanticTypeId(context, state)
        ", ptr %v$(request.callIndex)_socket_poll_timeout_slot, i32 0, i32 1" -> println
        "  %v$(request.callIndex)_socket_poll_duration = load " -> print
        pollTimeoutDurationType -> writeSemanticTypeId(context, state)
        ", ptr %v$(request.callIndex)_socket_poll_timeout_payload, align 8" -> println
        "  %v$(request.callIndex)_socket_poll_millis = extractvalue " -> print
        pollTimeoutDurationType -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_socket_poll_duration, 0" -> println
        "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_poll(i64 %v$(request.callIndex)_socket_handle, i32 %v$(request.callIndex)_socket_poll_mode, i1 %v$(request.callIndex)_socket_poll_has_timeout, i64 %v$(request.callIndex)_socket_poll_millis)" -> println
    }
    call.opcode == -302 -> if {
        firstValue -> effectiveTypeId(context, state) => socketReactorType
        nominalFieldType(socketReactorType, 1, context) => socketInterestsType
        context.types[socketInterestsType].first => socketInterestType
        context.typeSizes[socketInterestType] => socketInterestStride
        socketInterestType -> nativeAbiFieldOffset(0, context, state) => socketInterestKeyOffset
        socketInterestType -> nativeAbiFieldOffset(1, context, state) => socketInterestSourceOffset
        socketInterestType -> nativeAbiFieldOffset(2, context, state) => socketInterestModeOffset
        context.ir[secondArgumentIndex!] => socketEvents
        context.types[socketEvents.typeId].first => socketEventType
        context.typeSizes[socketEventType] => socketEventStride
        socketEventType -> nativeAbiFieldOffset(0, context, state) => socketEventKeyOffset
        socketEventType -> nativeAbiFieldOffset(1, context, state) => socketEventReadOffset
        socketEventType -> nativeAbiFieldOffset(2, context, state) => socketEventWriteOffset
        socketEventType -> nativeAbiFieldOffset(3, context, state) => socketEventErrorOffset
        "  %v$(request.callIndex)_socket_reactor_maximum = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 0" -> println
        "  %v$(request.callIndex)_socket_reactor_interests = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 1" -> println
        "  %v$(request.callIndex)_socket_reactor_interests_data = extractvalue " -> print
        socketInterestsType -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_socket_reactor_interests, 0" -> println
        "  %v$(request.callIndex)_socket_reactor_interests_length = extractvalue " -> print
        socketInterestsType -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_socket_reactor_interests, 1" -> println
        "  %v$(request.callIndex)_socket_reactor_event_pointer_address = extractvalue %sollang.mutable_container %callmut$(request.callIndex)_arg1, 0" -> println
        "  %v$(request.callIndex)_socket_reactor_event_length_address = extractvalue %sollang.mutable_container %callmut$(request.callIndex)_arg1, 1" -> println
        "  %v$(request.callIndex)_socket_reactor_event_capacity_address = extractvalue %sollang.mutable_container %callmut$(request.callIndex)_arg1, 2" -> println
        "  %v$(request.callIndex)_socket_reactor_event_data = load ptr, ptr %v$(request.callIndex)_socket_reactor_event_pointer_address, align 8" -> println
        "  %v$(request.callIndex)_socket_reactor_event_capacity = load i64, ptr %v$(request.callIndex)_socket_reactor_event_capacity_address, align 8" -> println
        context.ir[thirdArgumentIndex!] => reactorTimeoutOption
        reactorTimeoutOption.typeId => reactorTimeoutOptionType
        context.types[reactorTimeoutOptionType].first => reactorTimeoutDurationType
        "  %v$(request.callIndex)_socket_reactor_timeout_tag = extractvalue " -> print
        reactorTimeoutOptionType -> writeSemanticTypeId(context, state)
        " " -> print
        thirdArgumentIndex! -> writeValue(request.ownerIndex, context, state)
        ", 0" -> println
        "  %v$(request.callIndex)_socket_reactor_has_timeout = icmp eq i32 %v$(request.callIndex)_socket_reactor_timeout_tag, 1" -> println
        "  %v$(request.callIndex)_socket_reactor_timeout_slot = alloca " -> print
        reactorTimeoutOptionType -> writeSemanticTypeId(context, state)
        ", align 8" -> println
        "  store " -> print
        reactorTimeoutOptionType -> writeSemanticTypeId(context, state)
        " " -> print
        thirdArgumentIndex! -> writeValue(request.ownerIndex, context, state)
        ", ptr %v$(request.callIndex)_socket_reactor_timeout_slot, align 8" -> println
        "  %v$(request.callIndex)_socket_reactor_timeout_payload = getelementptr inbounds " -> print
        reactorTimeoutOptionType -> writeSemanticTypeId(context, state)
        ", ptr %v$(request.callIndex)_socket_reactor_timeout_slot, i32 0, i32 1" -> println
        "  %v$(request.callIndex)_socket_reactor_duration = load " -> print
        reactorTimeoutDurationType -> writeSemanticTypeId(context, state)
        ", ptr %v$(request.callIndex)_socket_reactor_timeout_payload, align 8" -> println
        "  %v$(request.callIndex)_socket_reactor_millis = extractvalue " -> print
        reactorTimeoutDurationType -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_socket_reactor_duration, 0" -> println
        "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_reactor_wait(ptr %v$(request.callIndex)_socket_reactor_interests_data, i64 %v$(request.callIndex)_socket_reactor_interests_length, i64 $socketInterestStride, i64 $socketInterestKeyOffset, i64 $socketInterestSourceOffset, i64 $socketInterestModeOffset, i64 %v$(request.callIndex)_socket_reactor_maximum, ptr %v$(request.callIndex)_socket_reactor_event_data, ptr %v$(request.callIndex)_socket_reactor_event_length_address, i64 %v$(request.callIndex)_socket_reactor_event_capacity, i64 $socketEventStride, i64 $socketEventKeyOffset, i64 $socketEventReadOffset, i64 $socketEventWriteOffset, i64 $socketEventErrorOffset, i1 %v$(request.callIndex)_socket_reactor_has_timeout, i64 %v$(request.callIndex)_socket_reactor_millis)" -> println
    }
    call.opcode == -279 or call.opcode == -280 -> if {
        "  %v$(request.callIndex)_socket_handle = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 0" -> println
        "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_" -> print
        call.opcode == -279 -> if {
            "set_no_delay(i64 %v$(request.callIndex)_socket_handle, i1 " -> print
            secondArgumentIndex! -> writeValue(request.ownerIndex, context, state)
            ")" -> println
        } else {
            "no_delay(i64 %v$(request.callIndex)_socket_handle)" -> println
        }
    }
    call.opcode == -293 or call.opcode == -294 -> if {
        "  %v$(request.callIndex)_socket_handle = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 0" -> println
        "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_" -> print
        call.opcode == -293 -> if {
            "set_keep_alive(i64 %v$(request.callIndex)_socket_handle, i1 " -> print
            secondArgumentIndex! -> writeValue(request.ownerIndex, context, state)
            ")" -> println
        } else {
            "keep_alive(i64 %v$(request.callIndex)_socket_handle)" -> println
        }
    }
    call.opcode == -295 or call.opcode == -296 -> if {
        "  %v$(request.callIndex)_socket_handle = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 0" -> println
        call.opcode == -295 -> if {
            context.ir[secondArgumentIndex!] => lingerOption
            lingerOption.typeId => lingerOptionType
            context.types[lingerOptionType].first => lingerDurationType
            "  %v$(request.callIndex)_socket_linger_tag = extractvalue " -> print
            lingerOptionType -> writeSemanticTypeId(context, state)
            " " -> print
            secondArgumentIndex! -> writeValue(request.ownerIndex, context, state)
            ", 0" -> println
            "  %v$(request.callIndex)_socket_linger_enabled = icmp eq i32 %v$(request.callIndex)_socket_linger_tag, 1" -> println
            "  %v$(request.callIndex)_socket_linger_slot = alloca " -> print
            lingerOptionType -> writeSemanticTypeId(context, state)
            ", align 8" -> println
            "  store " -> print
            lingerOptionType -> writeSemanticTypeId(context, state)
            " " -> print
            secondArgumentIndex! -> writeValue(request.ownerIndex, context, state)
            ", ptr %v$(request.callIndex)_socket_linger_slot, align 8" -> println
            "  %v$(request.callIndex)_socket_linger_payload = getelementptr inbounds " -> print
            lingerOptionType -> writeSemanticTypeId(context, state)
            ", ptr %v$(request.callIndex)_socket_linger_slot, i32 0, i32 1" -> println
            "  %v$(request.callIndex)_socket_linger_duration = load " -> print
            lingerDurationType -> writeSemanticTypeId(context, state)
            ", ptr %v$(request.callIndex)_socket_linger_payload, align 8" -> println
            "  %v$(request.callIndex)_socket_linger_millis = extractvalue " -> print
            lingerDurationType -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_socket_linger_duration, 0" -> println
            "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_set_linger(i64 %v$(request.callIndex)_socket_handle, i1 %v$(request.callIndex)_socket_linger_enabled, i64 %v$(request.callIndex)_socket_linger_millis)" -> println
        } else {
            "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_linger(i64 %v$(request.callIndex)_socket_handle)" -> println
        }
    }
    # Relative synchronous timeouts use the public Option<Duration> value
    # directly. None is tag 0 and passes has_timeout=false; Some is tag 1 and
    # exposes the Duration's single i64 millisecond field without allocation.
    call.opcode <= -281 and call.opcode >= -284 -> if {
        "  %v$(request.callIndex)_socket_handle = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 0" -> println
        call.opcode == -281 or call.opcode == -283 -> if {
            context.ir[secondArgumentIndex!] => timeoutOption
            timeoutOption.typeId => timeoutOptionType
            context.types[timeoutOptionType].first => timeoutDurationType
            "  %v$(request.callIndex)_socket_timeout_tag = extractvalue " -> print
            timeoutOptionType -> writeSemanticTypeId(context, state)
            " " -> print
            secondArgumentIndex! -> writeValue(request.ownerIndex, context, state)
            ", 0" -> println
            "  %v$(request.callIndex)_socket_timeout_some = icmp eq i32 %v$(request.callIndex)_socket_timeout_tag, 1" -> println
            "  %v$(request.callIndex)_socket_timeout_slot = alloca " -> print
            timeoutOptionType -> writeSemanticTypeId(context, state)
            ", align 8" -> println
            "  store " -> print
            timeoutOptionType -> writeSemanticTypeId(context, state)
            " " -> print
            secondArgumentIndex! -> writeValue(request.ownerIndex, context, state)
            ", ptr %v$(request.callIndex)_socket_timeout_slot, align 8" -> println
            "  %v$(request.callIndex)_socket_timeout_payload = getelementptr inbounds " -> print
            timeoutOptionType -> writeSemanticTypeId(context, state)
            ", ptr %v$(request.callIndex)_socket_timeout_slot, i32 0, i32 1" -> println
            "  %v$(request.callIndex)_socket_timeout_duration = load " -> print
            timeoutDurationType -> writeSemanticTypeId(context, state)
            ", ptr %v$(request.callIndex)_socket_timeout_payload, align 8" -> println
            "  %v$(request.callIndex)_socket_timeout_millis = extractvalue " -> print
            timeoutDurationType -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_socket_timeout_duration, 0" -> println
            "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_set_" -> print
            call.opcode == -281 -> if { "read" -> print } else { "write" -> print }
            "_timeout(i64 %v$(request.callIndex)_socket_handle, i1 %v$(request.callIndex)_socket_timeout_some, i64 %v$(request.callIndex)_socket_timeout_millis)" -> println
        } else {
            "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_" -> print
            call.opcode == -282 -> if { "read" -> print } else { "write" -> print }
            "_timeout(i64 %v$(request.callIndex)_socket_handle)" -> println
        }
    }
    # shutdown(TcpStream, ShutdownDirection). The public enum tags are the
    # native Windows/Linux direction constants, so lowering is conversion-free.
    call.opcode == -264 -> if {
        "  %v$(request.callIndex)_socket_handle = extractvalue " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        ", 0" -> println
        "  %v$(request.callIndex)_socket_shutdown_direction = extractvalue " -> print
        context.ir[secondArgumentIndex!] -> writeIrType(context, state)
        " " -> print
        secondArgumentIndex! -> writeValue(request.ownerIndex, context, state)
        ", 0" -> println
        "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_shutdown(i64 %v$(request.callIndex)_socket_handle, i32 %v$(request.callIndex)_socket_shutdown_direction)" -> println
    }
    # connect(Endpoint)
    call.opcode == -260 -> if {
        "  %v$(request.callIndex)_socket_endpoint = freeze " -> print
        firstValueIndex -> writeSocketReceiverType(context, state)
        " " -> print
        firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
        "" -> println
        firstValue -> effectiveTypeId(context, state) => socketEndpointType
        request.callIndex -> emitSocketEndpointDescriptor(socketEndpointType, context, state)
        "  %v$(request.callIndex)_socket_raw = call %sollang.socket_result @sollang_platform_socket_connect(ptr %v$(request.callIndex)_socket_endpoint_descriptor)" -> println
    }
    # receive/send/sendText all begin with an owned stream handle.
    (call.opcode <= -261 and call.opcode >= -263)
        or call.opcode == -266 or call.opcode == -267 or call.opcode == -272 or call.opcode == -287 or call.opcode == -289 or call.opcode == -290 or call.opcode == -291 or call.opcode == -292 or call.opcode == -299 or call.opcode == -300 or call.opcode == -301
        -> if {
            "  %v$(request.callIndex)_socket_handle = extractvalue " -> print
            firstValueIndex -> writeSocketReceiverType(context, state)
            " " -> print
            firstValueIndex -> writeSocketReceiverValue(request.ownerIndex, context, state)
            ", 0" -> println
        }
    call.opcode == -267 -> if {
        "  %v$(request.callIndex)_socket_receive_zero = icmp eq i64 " -> print
        secondArgumentIndex! -> writeValue(request.ownerIndex, context, state)
        ", 0" -> println
        "  %v$(request.callIndex)_socket_receive_capacity = select i1 %v$(request.callIndex)_socket_receive_zero, i64 1, i64 " -> print
