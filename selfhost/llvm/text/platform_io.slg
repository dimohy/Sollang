            "  %v$(request.callIndex)_socket_datagram_truncated = icmp ne i8 %v$(request.callIndex)_socket_datagram_truncated_byte, 0" -> println
            "  %v$(request.callIndex)_socket_datagram_receipt = insertvalue " -> print
            socketOkTypeId -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_socket_datagram_receipt1, i1 %v$(request.callIndex)_socket_datagram_truncated, 2" -> println
            "  store " -> print
            socketOkTypeId -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_socket_datagram_receipt, ptr %v$(request.callIndex)_socket_ok_payload, align 8" -> println
        }
        call.opcode == -269 -> if {
            context.types[socketOkTypeId].first => dnsEndpointType
            dnsEndpointType -> enumAbiStorageSize(0, context, state) => dnsEndpointSize
            "  %v$(request.callIndex)_dns_bytes = mul i64 %v$(request.callIndex)_socket_value, $dnsEndpointSize" -> println
            "  %v$(request.callIndex)_dns_storage = call ptr @malloc(i64 %v$(request.callIndex)_dns_bytes)" -> println
            "  br label %dns$(request.callIndex)_copy" -> println
            "dns$(request.callIndex)_copy:" -> println
            "  %v$(request.callIndex)_dns_index = phi i64 [ 0, %socket$(request.callIndex)_ok ], [ %v$(request.callIndex)_dns_next, %dns$(request.callIndex)_next ]" -> println
            "  %v$(request.callIndex)_dns_done = icmp uge i64 %v$(request.callIndex)_dns_index, %v$(request.callIndex)_socket_value" -> println
            "  br i1 %v$(request.callIndex)_dns_done, label %dns$(request.callIndex)_copied, label %dns$(request.callIndex)_item" -> println
            "dns$(request.callIndex)_item:" -> println
            "  %v$(request.callIndex)_dns_descriptor_offset = mul i64 %v$(request.callIndex)_dns_index, 32" -> println
            "  %v$(request.callIndex)_socket_endpoint_descriptor = getelementptr i8, ptr %v$(request.callIndex)_dns_descriptors, i64 %v$(request.callIndex)_dns_descriptor_offset" -> println
            request.callIndex -> emitSocketEndpointFromDescriptor(dnsEndpointType, context, state)
            "  %v$(request.callIndex)_dns_slot = getelementptr " -> print
            dnsEndpointType -> writeSemanticTypeId(context, state)
            ", ptr %v$(request.callIndex)_dns_storage, i64 %v$(request.callIndex)_dns_index" -> println
            "  store " -> print
            dnsEndpointType -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_socket_source_endpoint, ptr %v$(request.callIndex)_dns_slot, align 8" -> println
            "  br label %dns$(request.callIndex)_next" -> println
            "dns$(request.callIndex)_next:" -> println
            "  %v$(request.callIndex)_dns_next = add i64 %v$(request.callIndex)_dns_index, 1" -> println
            "  br label %dns$(request.callIndex)_copy" -> println
            "dns$(request.callIndex)_copied:" -> println
            "  %v$(request.callIndex)_dns_array0 = insertvalue " -> print
            socketOkTypeId -> writeSemanticTypeId(context, state)
            " poison, ptr %v$(request.callIndex)_dns_storage, 0" -> println
            "  %v$(request.callIndex)_dns_array1 = insertvalue " -> print
            socketOkTypeId -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_dns_array0, i64 %v$(request.callIndex)_socket_value, 1" -> println
            "  %v$(request.callIndex)_dns_array = insertvalue " -> print
            socketOkTypeId -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_dns_array1, i64 %v$(request.callIndex)_socket_value, 2" -> println
            "  store " -> print
            socketOkTypeId -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_dns_array, ptr %v$(request.callIndex)_socket_ok_payload, align 8" -> println
        }
    }
    "  br label %socket$(request.callIndex)_merge" -> println
    "socket$(request.callIndex)_error:" -> println
    call.opcode == -261 or call.opcode == -267
        -> if { "  call void @free(ptr %v$(request.callIndex)_socket_receive_buffer)" -> println }
    "  %v$(request.callIndex)_socket_error_tag = getelementptr inbounds " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_socket_result_slot, i32 0, i32 0" -> println
    "  store i32 1, ptr %v$(request.callIndex)_socket_error_tag, align 4" -> println
    context.types[call.typeId].second => socketErrorTypeId
    nominalFieldType(socketErrorTypeId, 0, context) => socketKindTypeId
    "  %v$(request.callIndex)_socket_error_kind = insertvalue " -> print
    socketKindTypeId -> writeSemanticTypeId(context, state)
    " zeroinitializer, i32 %v$(request.callIndex)_socket_kind, 0" -> println
    "  %v$(request.callIndex)_socket_error0 = insertvalue " -> print
    socketErrorTypeId -> writeSemanticTypeId(context, state)
    " poison, " -> print
    socketKindTypeId -> writeSemanticTypeId(context, state)
    " %v$(request.callIndex)_socket_error_kind, 0" -> println
    "  %v$(request.callIndex)_socket_error = insertvalue " -> print
    socketErrorTypeId -> writeSemanticTypeId(context, state)
    " %v$(request.callIndex)_socket_error0, i32 %v$(request.callIndex)_socket_code, 1" -> println
    "  %v$(request.callIndex)_socket_error_payload = getelementptr inbounds " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_socket_result_slot, i32 0, i32 1" -> println
    "  store " -> print
    socketErrorTypeId -> writeSemanticTypeId(context, state)
    " %v$(request.callIndex)_socket_error, ptr %v$(request.callIndex)_socket_error_payload, align 8" -> println
    "  br label %socket$(request.callIndex)_merge" -> println
    "socket$(request.callIndex)_merge:" -> println
    "  %v$(request.callIndex) = load " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(request.callIndex)_socket_result_slot, align 8" -> println
}

nominalFieldType ownerType: Int, ordinal: Int, context: ref emitterContext.EmitContext -> Int {
    -1 => fieldType!
    0 => fieldIndex!
    fieldIndex! < (context.fields -> len) -> while {
        context.fields[fieldIndex!] => field
        field.status == 0 and field.ownerType == ownerType and field.ordinal == ordinal
            -> if { field.fieldType => fieldType! }
        fieldIndex! + 1 => fieldIndex!
    }
    fieldType!
}

emitFileCall request: FileCallRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[request.callIndex] => call
    -1 => enclosingFileMatch!
    call.parent => fileCallAncestor!
    fileCallAncestor! >= 0 and enclosingFileMatch! < 0
        -> while {
            context.ir[fileCallAncestor!].kind == 27 -> if { fileCallAncestor! => enclosingFileMatch! } else { context.ir[fileCallAncestor!].parent => fileCallAncestor! }
        }
    call.opcode == -216 or call.opcode == -217 -> if {
        request.callIndex -> callArgumentIndex(context, state) => pathIndex!
        pathIndex! -> aggregateValueIndex(context, state) => pathIndex!
        context.ir[pathIndex!] => path
        "  %v$(request.callIndex)_file_path_data = extractvalue %sollang.text " -> print
        path.kind == 2 -> if {
            path -> sourceToken(context, state) => pathToken
            Int(TextLiteralRequest { sourceModule: path.sourceModule, token: pathToken } -> textLiteralLength(context, state)) => pathLength
            "{ ptr @sollang_str_" -> print
            pathIndex! -> writeDecimal
            ", i64 " -> print
            pathLength -> writeDecimal
            " }" -> print
        } else { pathIndex! -> writeValue(request.ownerIndex, context, state) }
        ", 0" -> println
        "  %v$(request.callIndex)_file_path_length = extractvalue %sollang.text " -> print
        path.kind == 2 -> if {
            path -> sourceToken(context, state) => pathLengthToken
            Int(TextLiteralRequest { sourceModule: path.sourceModule, token: pathLengthToken } -> textLiteralLength(context, state)) => literalPathLength
            "{ ptr @sollang_str_" -> print
            pathIndex! -> writeDecimal
            ", i64 " -> print
            literalPathLength -> writeDecimal
            " }" -> print
        } else { pathIndex! -> writeValue(request.ownerIndex, context, state) }
        ", 1" -> println
        "  %v$(request.callIndex)_file_open_raw = call %sollang.file_handle_result @sollang_platform_open_owned_" -> print
        call.opcode == -217 -> if { "write" -> print } else { "read" -> print }
        "_file(ptr %v$(request.callIndex)_file_path_data, i64 %v$(request.callIndex)_file_path_length)" -> println
        "  %v$(request.callIndex)_file_open_handle = extractvalue %sollang.file_handle_result %v$(request.callIndex)_file_open_raw, 0" -> println
        "  %v$(request.callIndex)_file_open_status = extractvalue %sollang.file_handle_result %v$(request.callIndex)_file_open_raw, 1" -> println
        "  %v$(request.callIndex)_file_open_ok = icmp ne i32 %v$(request.callIndex)_file_open_status, 0" -> println
        "  store " -> print
        call -> writeIrType(context, state)
        " zeroinitializer, ptr %v$(request.callIndex)_file_result_slot, align 8" -> println
        "  br i1 %v$(request.callIndex)_file_open_ok, label %file$(request.callIndex)_open_ok, label %file$(request.callIndex)_open_error" -> println
        "file$(request.callIndex)_open_ok:" -> println
        context.types[call.typeId].first => openedFileTypeId
        "  %v$(request.callIndex)_file_value = insertvalue " -> print
        openedFileTypeId -> writeSemanticTypeId(context, state)
        " poison, i64 %v$(request.callIndex)_file_open_handle, 0" -> println
        "  %v$(request.callIndex)_file_ok_tag = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_file_result_slot, i32 0, i32 0" -> println
        "  store i32 0, ptr %v$(request.callIndex)_file_ok_tag, align 4" -> println
        "  %v$(request.callIndex)_file_ok_payload = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_file_result_slot, i32 0, i32 1" -> println
        "  store " -> print
        openedFileTypeId -> writeSemanticTypeId(context, state)
        " %v$(request.callIndex)_file_value, ptr %v$(request.callIndex)_file_ok_payload, align 8" -> println
        "  br label %file$(request.callIndex)_open_merge" -> println
        "file$(request.callIndex)_open_error:" -> println
        "  %v$(request.callIndex)_file_error_tag = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_file_result_slot, i32 0, i32 0" -> println
        "  store i32 1, ptr %v$(request.callIndex)_file_error_tag, align 4" -> println
        "  %v$(request.callIndex)_file_error_payload = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_file_result_slot, i32 0, i32 1" -> println
        "  %v$(request.callIndex)_file_error_text0 = insertvalue %sollang.text poison, ptr @sollang_file_error_io, 0" -> println
        "  %v$(request.callIndex)_file_error_text = insertvalue %sollang.text %v$(request.callIndex)_file_error_text0, i64 2, 1" -> println
        "  store %sollang.text %v$(request.callIndex)_file_error_text, ptr %v$(request.callIndex)_file_error_payload, align 8" -> println
        "  br label %file$(request.callIndex)_open_merge" -> println
        "file$(request.callIndex)_open_merge:" -> println
        "  %v$(request.callIndex) = load " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_file_result_slot, align 8" -> println
    }
    call.opcode == -218 -> if {
        enclosingFileMatch! >= 0 -> if {
            context.ir[enclosingFileMatch!] => syncWriterMatch
            context.types[context.ir[syncWriterMatch.operand0].typeId].first => syncWriterTypeId
            "  %v$(request.callIndex)_file_sync_writer_payload = getelementptr inbounds " -> print
            context.ir[syncWriterMatch.operand0] -> writeIrType(context, state)
            ", ptr %v$(enclosingFileMatch!)_subject_slot, i32 0, i32 1" -> println
            "  %v$(request.callIndex)_file_sync_writer = load " -> print
            syncWriterTypeId -> writeSemanticTypeId(context, state)
            ", ptr %v$(request.callIndex)_file_sync_writer_payload, align 8" -> println
            "  %v$(request.callIndex)_file_sync_handle = extractvalue " -> print
            syncWriterTypeId -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_file_sync_writer, 0" -> println
        } else {
            request.callIndex -> callArgumentIndex(context, state) => writerIndex!
            writerIndex! -> aggregateValueIndex(context, state) => writerIndex!
            context.ir[writerIndex!] => writer
            "  %v$(request.callIndex)_file_sync_handle = extractvalue " -> print
            writer -> writeIrType(context, state)
            " " -> print
            writerIndex! -> writeValue(request.ownerIndex, context, state)
            ", 0" -> println
        }
        "  %v$(request.callIndex)_file_sync_raw = call i32 @sollang_platform_sync_owned_file(i64 %v$(request.callIndex)_file_sync_handle)" -> println
        "  %v$(request.callIndex) = icmp ne i32 %v$(request.callIndex)_file_sync_raw, 0" -> println
    }
    call.opcode == -219 -> if {
        request.callIndex -> callArgumentIndex(context, state) => replaceIndex!
        replaceIndex! -> aggregateValueIndex(context, state) => replaceIndex!
        context.ir[replaceIndex!] => replace
        "  %v$(request.callIndex)_file_temporary = extractvalue " -> print
        replace -> writeIrType(context, state)
        " " -> print
        replaceIndex! -> writeValue(request.ownerIndex, context, state)
        ", 0" -> println
        "  %v$(request.callIndex)_file_destination = extractvalue " -> print
        replace -> writeIrType(context, state)
        " " -> print
        replaceIndex! -> writeValue(request.ownerIndex, context, state)
        ", 1" -> println
        "  %v$(request.callIndex)_file_temporary_data = extractvalue %sollang.text %v$(request.callIndex)_file_temporary, 0" -> println
        "  %v$(request.callIndex)_file_temporary_length = extractvalue %sollang.text %v$(request.callIndex)_file_temporary, 1" -> println
        "  %v$(request.callIndex)_file_destination_data = extractvalue %sollang.text %v$(request.callIndex)_file_destination, 0" -> println
        "  %v$(request.callIndex)_file_destination_length = extractvalue %sollang.text %v$(request.callIndex)_file_destination, 1" -> println
        "  %v$(request.callIndex)_file_replace_raw = call i32 @sollang_platform_atomic_replace_file(ptr %v$(request.callIndex)_file_temporary_data, i64 %v$(request.callIndex)_file_temporary_length, ptr %v$(request.callIndex)_file_destination_data, i64 %v$(request.callIndex)_file_destination_length)" -> println
        "  %v$(request.callIndex) = icmp ne i32 %v$(request.callIndex)_file_replace_raw, 0" -> println
    }
    call.opcode == -221 -> if {
        call.operand0 => scalarArgumentIndex!
        context.ir[scalarArgumentIndex!].nextOperand => offsetArgumentIndex!
        context.ir[offsetArgumentIndex!].nextOperand >= 0
            -> while {
                offsetArgumentIndex! => scalarArgumentIndex!
                context.ir[offsetArgumentIndex!].nextOperand => offsetArgumentIndex!
            }
        scalarArgumentIndex! -> aggregateValueIndex(context, state) => scalarIndex
        offsetArgumentIndex! -> aggregateValueIndex(context, state) => offsetIndex
        context.ir[scalarIndex] => scalar
        scalar.typeId => scalarTypeId!
        scalarTypeId! < 0 -> if { scalar.typeSymbol => scalarTypeId! }
        context.typeSizes[scalarTypeId!] => scalarSize
        context.typeAligns[scalarTypeId!] => scalarAlign
        "  store " -> print
        scalarTypeId! -> writeSemanticTypeId(context, state)
        " " -> print
        scalarIndex -> writeValue(request.ownerIndex, context, state)
        ", ptr %v$(request.callIndex)_file_write_slot, align $scalarAlign" -> println
        enclosingFileMatch! >= 0 -> if {
            context.ir[enclosingFileMatch!] => fileWriterMatch
            context.types[context.ir[fileWriterMatch.operand0].typeId].first => fileWriterTypeId
            "  %v$(request.callIndex)_file_writer_payload = getelementptr inbounds " -> print
            context.ir[fileWriterMatch.operand0] -> writeIrType(context, state)
            ", ptr %v$(enclosingFileMatch!)_subject_slot, i32 0, i32 1" -> println
            "  %v$(request.callIndex)_file_writer = load " -> print
            fileWriterTypeId -> writeSemanticTypeId(context, state)
            ", ptr %v$(request.callIndex)_file_writer_payload, align 8" -> println
            "  %v$(request.callIndex)_file_write_handle = extractvalue " -> print
            fileWriterTypeId -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_file_writer, 0" -> println
        }
        "  %v$(request.callIndex)_file_write_raw = call %sollang.file_count_result @sollang_platform_write_owned_file_at(i64 %v$(request.callIndex)_file_write_handle, ptr %v$(request.callIndex)_file_write_slot, i64 $scalarSize, i64 " -> print
        offsetIndex -> writeValue(request.ownerIndex, context, state)
        ")" -> println
        "  %v$(request.callIndex)_file_write_count = extractvalue %sollang.file_count_result %v$(request.callIndex)_file_write_raw, 0" -> println
        "  %v$(request.callIndex)_file_write_status = extractvalue %sollang.file_count_result %v$(request.callIndex)_file_write_raw, 1" -> println
        "  %v$(request.callIndex)_file_write_called = icmp ne i32 %v$(request.callIndex)_file_write_status, 0" -> println
        "  %v$(request.callIndex)_file_write_full = icmp eq i64 %v$(request.callIndex)_file_write_count, $scalarSize" -> println
        "  %v$(request.callIndex)_file_write_ok = and i1 %v$(request.callIndex)_file_write_called, %v$(request.callIndex)_file_write_full" -> println
        "  store " -> print
        call -> writeIrType(context, state)
        " zeroinitializer, ptr %v$(request.callIndex)_file_result_slot, align 8" -> println
        "  br i1 %v$(request.callIndex)_file_write_ok, label %file$(request.callIndex)_write_ok, label %file$(request.callIndex)_write_error" -> println
        "file$(request.callIndex)_write_ok:" -> println
        "  %v$(request.callIndex)_file_write_ok_tag = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_file_result_slot, i32 0, i32 0" -> println
        "  store i32 0, ptr %v$(request.callIndex)_file_write_ok_tag, align 4" -> println
        "  br label %file$(request.callIndex)_write_merge" -> println
        "file$(request.callIndex)_write_error:" -> println
        "  %v$(request.callIndex)_file_write_error_tag = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_file_result_slot, i32 0, i32 0" -> println
        "  store i32 1, ptr %v$(request.callIndex)_file_write_error_tag, align 4" -> println
        "  %v$(request.callIndex)_file_write_error_payload = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_file_result_slot, i32 0, i32 1" -> println
        "  %v$(request.callIndex)_file_write_error_text0 = insertvalue %sollang.text poison, ptr @sollang_file_error_io, 0" -> println
        "  %v$(request.callIndex)_file_write_error_text = insertvalue %sollang.text %v$(request.callIndex)_file_write_error_text0, i64 2, 1" -> println
        "  store %sollang.text %v$(request.callIndex)_file_write_error_text, ptr %v$(request.callIndex)_file_write_error_payload, align 8" -> println
        "  br label %file$(request.callIndex)_write_merge" -> println
        "file$(request.callIndex)_write_merge:" -> println
        "  %v$(request.callIndex) = load " -> print
        call -> writeIrType(context, state)
        ", ptr %v$(request.callIndex)_file_result_slot, align 8" -> println
    }
    call.opcode == -220 -> if {
        call.operand0 => offsetArgumentIndex!
        context.ir[offsetArgumentIndex!].nextOperand >= 0
            -> while {
                context.ir[offsetArgumentIndex!].nextOperand => offsetArgumentIndex!
            }
        offsetArgumentIndex! -> aggregateValueIndex(context, state) => offsetIndex
        context.types[call.typeId].first => optionTypeId
        context.types[optionTypeId].first => scalarTypeId
        context.typeSizes[scalarTypeId] => scalarSize
        context.typeAligns[scalarTypeId] => scalarAlign
        enclosingFileMatch! >= 0 -> if {
            context.ir[enclosingFileMatch!] => fileReaderMatch
            context.types[context.ir[fileReaderMatch.operand0].typeId].first => fileReaderTypeId
            "  %v$(request.callIndex)_file_reader_payload = getelementptr inbounds " -> print
            context.ir[fileReaderMatch.operand0] -> writeIrType(context, state)
            ", ptr %v$(enclosingFileMatch!)_subject_slot, i32 0, i32 1" -> println
            "  %v$(request.callIndex)_file_reader = load " -> print
            fileReaderTypeId -> writeSemanticTypeId(context, state)
            ", ptr %v$(request.callIndex)_file_reader_payload, align 8" -> println
            "  %v$(request.callIndex)_file_read_handle = extractvalue " -> print
            fileReaderTypeId -> writeSemanticTypeId(context, state)
            " %v$(request.callIndex)_file_reader, 0" -> println
        }
        "  %v$(request.callIndex)_file_read_raw = call %sollang.file_count_result @sollang_platform_read_owned_file_at(i64 %v$(request.callIndex)_file_read_handle, ptr %v$(request.callIndex)_file_read_slot, i64 $scalarSize, i64 " -> print
        offsetIndex -> writeValue(request.ownerIndex, context, state)
        ")" -> println
        "  %v$(request.callIndex)_file_read_count = extractvalue %sollang.file_count_result %v$(request.callIndex)_file_read_raw, 0" -> println
        "  %v$(request.callIndex)_file_read_status = extractvalue %sollang.file_count_result %v$(request.callIndex)_file_read_raw, 1" -> println
        "  %v$(request.callIndex)_file_read_ok = icmp ne i32 %v$(request.callIndex)_file_read_status, 0" -> println
        "  store " -> print
        call -> writeIrType(context, state)
        " zeroinitializer, ptr %v$(request.callIndex)_file_result_slot, align 8" -> println
        "  br i1 %v$(request.callIndex)_file_read_ok, label %file$(request.callIndex)_read_count, label %file$(request.callIndex)_read_io" -> println
        "file$(request.callIndex)_read_io:" -> println
        "  br label %file$(request.callIndex)_read_error_io" -> println
        "file$(request.callIndex)_read_count:" -> println
        "  %v$(request.callIndex)_file_read_eof = icmp eq i64 %v$(request.callIndex)_file_read_count, 0" -> println
        "  br i1 %v$(request.callIndex)_file_read_eof, label %file$(request.callIndex)_read_none, label %file$(request.callIndex)_read_nonempty" -> println
        "file$(request.callIndex)_read_nonempty:" -> println
        "  %v$(request.callIndex)_file_read_full = icmp eq i64 %v$(request.callIndex)_file_read_count, $scalarSize" -> println
        "  br i1 %v$(request.callIndex)_file_read_full, label %file$(request.callIndex)_read_loaded, label %file$(request.callIndex)_read_error_truncated" -> println
        "file$(request.callIndex)_read_loaded:" -> println
        "  %v$(request.callIndex)_file_read_loaded = load " -> print
        scalarTypeId == 23 -> if { "i8" -> print } else { scalarTypeId -> writeSemanticTypeId(context, state) }
        ", ptr %v$(request.callIndex)_file_read_slot, align $scalarAlign" -> println
        scalarTypeId == 23 -> if {
            "  %v$(request.callIndex)_file_read_encoding_ok = icmp ule i8 %v$(request.callIndex)_file_read_loaded, 1" -> println
            "  br i1 %v$(request.callIndex)_file_read_encoding_ok, label %file$(request.callIndex)_read_valid, label %file$(request.callIndex)_read_error_invalid" -> println
        } else {
            scalarTypeId == 14 -> if {
                "  %v$(request.callIndex)_file_read_in_range = icmp ule i32 %v$(request.callIndex)_file_read_loaded, 1114111" -> println
                "  %v$(request.callIndex)_file_read_before_surrogate = icmp ult i32 %v$(request.callIndex)_file_read_loaded, 55296" -> println
                "  %v$(request.callIndex)_file_read_after_surrogate = icmp ugt i32 %v$(request.callIndex)_file_read_loaded, 57343" -> println
                "  %v$(request.callIndex)_file_read_not_surrogate = or i1 %v$(request.callIndex)_file_read_before_surrogate, %v$(request.callIndex)_file_read_after_surrogate" -> println
                "  %v$(request.callIndex)_file_read_encoding_ok = and i1 %v$(request.callIndex)_file_read_in_range, %v$(request.callIndex)_file_read_not_surrogate" -> println
                "  br i1 %v$(request.callIndex)_file_read_encoding_ok, label %file$(request.callIndex)_read_valid, label %file$(request.callIndex)_read_error_invalid" -> println
