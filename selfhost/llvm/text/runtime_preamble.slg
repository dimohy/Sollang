import syntax.generated.slg as grammar

struct CoreRuntimePreambleResult {
    usesArguments: Bool
    usesNativeInterop: Bool
    usesComInterop: Bool
}

usesDirectTextEqualityRuntime context: ref emitterContext.EmitContext -> Bool {
    false => required!
    0 => nodeIndex!
    nodeIndex! < (context.ir -> len) -> while {
        context.ir[nodeIndex!] => node
        node.kind == 8
            and (node.opcode == grammar.tokenIdEqualEqual() or node.opcode == grammar.tokenIdBangEqual())
            and node.operand0 >= 0
            and node.operand0 < (context.ir -> len)
            and node.operand1 >= 0
            and node.operand1 < (context.ir -> len)
            and (node.operand0 -> comparisonReadIsText(context))
            and (node.operand1 -> comparisonReadIsText(context))
            -> if { true => required! }
        nodeIndex! + 1 => nodeIndex!
    }
    0 => interpolationIndex!
    interpolationIndex! < (context.binaryComparisonDiagnosticByNode -> len)
        -> while {
            context.binaryComparisonDiagnosticByNode[interpolationIndex!].textEquality
                -> if { true => required! }
            interpolationIndex! + 1 => interpolationIndex!
        }
    required!
}

emitCoreRuntimePreamble dropTypeActive: [Int; ~], intrinsicRuntimeModule: Int, requiresEarlyTextType: Bool, usesComputePool: Bool, usesAsyncRuntime: Bool, usesDirectoryTraversal: Bool, usesOwnedDropRuntime: Bool, usesSourceText: Bool, usesStandardInputSourceText: Bool, usesText: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> CoreRuntimePreambleResult uses Console, Process {
