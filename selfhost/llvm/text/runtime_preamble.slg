            and comMethod.flags / 4096 % 2 == 0
            and comMethod.flags / 8192 % 2 == 0
            and comMethod.flags / 131072 % 2 == 0
            and comMethod.typeId >= 0
            and context.types[comMethod.typeId].kind == 7
