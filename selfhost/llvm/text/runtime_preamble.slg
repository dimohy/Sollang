            define ptr @malloc(i64 %bytes) {
            entry:
              %value32 = call i32 @sollang_browser_alloc(i64 %bytes)
              %value = inttoptr i32 %value32 to ptr
              ret ptr %value
            }
            define ptr @realloc(ptr %old, i64 %bytes) {
            entry:
              %old32 = ptrtoint ptr %old to i32
              %new32 = call i32 @sollang_browser_realloc(i32 %old32, i64 %bytes)
              %new = inttoptr i32 %new32 to ptr
              ret ptr %new
            }
            define void @free(ptr %value) {
            entry:
              ret void
            }
            define ptr @sollang_alloc(i64 %bytes) {
            entry:
              %value = call ptr @malloc(i64 %bytes)
              ret ptr %value
            }
            """ -> println
        } else {
            "declare ptr @malloc(i64)" -> println
            (usesArrayPush! or usesTextMaterialize! or usesStandardInputSourceText) -> if { "declare ptr @realloc(ptr, i64)" -> println }
            "declare void @free(ptr)" -> println
        }
    }
    false => usesDictionary!
    0 => dictionaryTypeSearch!
    dictionaryTypeSearch! < (context.ir -> len) -> while {
        context.ir[dictionaryTypeSearch!] -> isDictionaryType -> if { true => usesDictionary! }
        dictionaryTypeSearch! + 1 => dictionaryTypeSearch!
    }
    0 => dictionarySemanticTypeSearch!
    dictionarySemanticTypeSearch! < (context.types -> len) -> while {
        context.types[dictionarySemanticTypeSearch!] => dictionarySemanticType
        (dictionarySemanticType.kind == 5 or (dictionarySemanticType.kind == 7 and dictionarySemanticType.origin == 4 and dictionarySemanticType.symbol == 5)) -> if { true => usesDictionary! }
        dictionarySemanticTypeSearch! + 1 => dictionarySemanticTypeSearch!
    }
    0 => dictionaryCompositeSearch!
    dictionaryCompositeSearch! < (context.composite -> len) -> while {
        context.composite[dictionaryCompositeSearch!].kind == 5 -> if { true => usesDictionary! }
        dictionaryCompositeSearch! + 1 => dictionaryCompositeSearch!
    }
    false => usesTextDictionaryKeys!
    0 => textDictionaryIrSearch!
    textDictionaryIrSearch! < (context.ir -> len) -> while {
        context.ir[textDictionaryIrSearch!] => textDictionaryNode
        textDictionaryNode -> isDictionaryType => textDictionaryNodeIsDictionary
        textDictionaryNodeIsDictionary -> if {
            (textDictionaryNode.typeId >= 0 and textDictionaryNode.typeId < (context.types -> len)) -> if {
                context.types[textDictionaryNode.typeId] => textDictionaryType
                ((textDictionaryType.kind == 5 or (textDictionaryType.kind == 7 and textDictionaryType.origin == 4 and textDictionaryType.symbol == 5)) and textDictionaryType.first >= 0 and textDictionaryType.first < (context.types -> len)) -> if {
                    context.types[textDictionaryType.first] => textDictionaryKeyType
                    (textDictionaryKeyType.kind == 1 and textDictionaryKeyType.origin == 1 and textDictionaryKeyType.symbol == 1) -> if { true => usesTextDictionaryKeys! }
                }
            }
        }
        textDictionaryIrSearch! + 1 => textDictionaryIrSearch!
    }
    false => usesEnumMatch!
    0 => enumMatchSearch!
    enumMatchSearch! < (context.ir -> len) -> while {
        context.ir[enumMatchSearch!].kind == 27 -> if { true => usesEnumMatch! }
        enumMatchSearch! + 1 => enumMatchSearch!
    }
    usesDictionary! -> if {
        "%sollang.dict = type { ptr, ptr, i64, i64 }" -> println
        (not usesDynamicArray! and not usesSourceText and not usesComputePool and intrinsicRuntimeModule < 0 and not usesOwnedDropRuntime) -> if {
            "declare ptr @malloc(i64)" -> println
            "declare void @free(ptr)" -> println
        }
    }
    dropTypeActive -> emitSemanticDropHelpers(context, state)
    false => usesNativeInterop!
    false => usesComInterop!
    0 => nativeInteropSearch!
    nativeInteropSearch! < (context.ir -> len) -> while {
        context.ir[nativeInteropSearch!] -> isNativeFunction(context, state) -> if { true => usesNativeInterop! }
        context.ir[nativeInteropSearch!] -> isComFunction(context, state) -> if { true => usesComInterop! }
        nativeInteropSearch! + 1 => nativeInteropSearch!
    }
    (usesCollectionCapacityTrap! or usesDictionary! or usesEnumMatch! or usesSourceText or usesNativeInterop! or usesComInterop!) -> if { "declare void @llvm.trap()" -> println }
    usesBitSetCount! -> if { "declare i64 @llvm.ctpop.i64(i64)" -> println }
    usesNativeInterop! -> if {
        context.expectedPathStyle == 1 -> if {
            "declare dllimport ptr @LoadLibraryA(ptr)" -> println
            "declare dllimport ptr @GetProcAddress(ptr, ptr)" -> println
            "declare dllimport i32 @FreeLibrary(ptr)" -> println
        } else {
            "declare ptr @dlopen(ptr, i32)" -> println
            "declare ptr @dlsym(ptr, ptr)" -> println
            "declare i32 @dlclose(ptr)" -> println
        }
        emitNativeRuntime(context, state)
    }
    context -> diagnostics.usesProcessExit => needsProcessExit
    needsProcessExit -> if {
        context.expectedPathStyle == 1 -> if { "declare dllimport void @ExitProcess(i32)" -> println } else { "declare void @exit(i32)" -> println }
    }
    (usesText and not requiresEarlyTextType) -> if { "%sollang.text = type { ptr, i64 }" -> println }
    (context.pointerBitWidth == 32 and usesSourceText) -> if {
        """
        define %sollang.source_text @sollang_runtime_map_text(%sollang.text %path) {
        entry:
          ret %sollang.source_text zeroinitializer
        }
        define void @sollang_runtime_unmap_text(%sollang.source_text %value) {
        entry:
          ret void
        }
        """ -> println
    }
    usesTextDictionaryKeys! -> if { llvmRuntime.emitDictionaryTextHelpers() }
    usesText -> if {
        0 => textGlobalIndex!
        textGlobalIndex! < (context.ir -> len) -> while {
            context.ir[textGlobalIndex!] => textConstant
            textConstant.kind == 2 -> if {
                textConstant -> sourceToken(context, state) => textToken
                TextLiteralRequest { sourceModule: textConstant.sourceModule, token: textToken } => textLiteralRequest
                textLiteralRequest -> textLiteralLength(context, state) => textLength
                "@sollang_str_$(textGlobalIndex!) = private unnamed_addr constant [$textLength x i8] " -> print
                textLiteralRequest -> emitTextLiteralConstant(context, state)
            }
            textGlobalIndex! + 1 => textGlobalIndex!
        }
    }
    false => usesArguments!
    0 => argumentsTypeSearch!
    argumentsTypeSearch! < (context.ir -> len) -> while {
        context.ir[argumentsTypeSearch!] -> isArgumentsType -> if { true => usesArguments! }
        argumentsTypeSearch! + 1 => argumentsTypeSearch!
    }
    usesArguments! -> if {
        context.pointerBitWidth == 32 -> if {
            """
            @sollang_browser_program_name = private constant [8 x i8] c"sollangc"
            declare i32 @sollang_browser_source_count()
            declare i32 @sollang_browser_source_pointer(i32)
            declare i32 @sollang_browser_source_length(i32)
            define i64 @sollang_argument_count() {
            entry:
              %source_count32 = call i32 @sollang_browser_source_count()
              %source_count = zext i32 %source_count32 to i64
              %argument_count = add i64 %source_count, 1
              ret i64 %argument_count
            }
            define %sollang.text @sollang_argument(i64 %index) {
            entry:
              %source_count32 = call i32 @sollang_browser_source_count()
              %source_count = zext i32 %source_count32 to i64
              %source_index64 = sub i64 %index, 1
              %has_source_index = icmp ugt i64 %index, 0
              %source_index_in_bounds = icmp ult i64 %source_index64, %source_count
              %is_source = and i1 %has_source_index, %source_index_in_bounds
              br i1 %is_source, label %source, label %program
            source:
              %source_index = trunc i64 %source_index64 to i32
              %source_ptr32 = call i32 @sollang_browser_source_pointer(i32 %source_index)
              %source_ptr = inttoptr i32 %source_ptr32 to ptr
              %source_len32 = call i32 @sollang_browser_source_length(i32 %source_index)
              %source_len = zext i32 %source_len32 to i64
              %source0 = insertvalue %sollang.text poison, ptr %source_ptr, 0
              %source1 = insertvalue %sollang.text %source0, i64 %source_len, 1
              ret %sollang.text %source1
            program:
              %program0 = insertvalue %sollang.text poison, ptr @sollang_browser_program_name, 0
              %program1 = insertvalue %sollang.text %program0, i64 8, 1
              ret %sollang.text %program1
            }
            """ -> println
        } else {
            "@sollang_argc = internal global i64 0" -> println
            "@sollang_argv = internal global ptr null" -> println
            "define i64 @sollang_argument_count() {" -> println
            "entry:" -> println
            "  %count = load i64, ptr @sollang_argc, align 8" -> println
            "  ret i64 %count" -> println
            "}" -> println
            "define %sollang.text @sollang_argument(i64 %index) {" -> println
            "entry:" -> println
            "  %argv = load ptr, ptr @sollang_argv, align 8" -> println
            "  %slot = getelementptr ptr, ptr %argv, i64 %index" -> println
            "  %value = load ptr, ptr %slot, align 8" -> println
            "  br label %length_loop" -> println
            "length_loop:" -> println
            "  %length = phi i64 [ 0, %entry ], [ %next, %length_body ]" -> println
            "  %byte_ptr = getelementptr i8, ptr %value, i64 %length" -> println
            "  %byte = load i8, ptr %byte_ptr, align 1" -> println
            "  %done = icmp eq i8 %byte, 0" -> println
            "  br i1 %done, label %length_done, label %length_body" -> println
            "length_body:" -> println
            "  %next = add i64 %length, 1" -> println
            "  br label %length_loop" -> println
            "length_done:" -> println
            "  %text_ptr = insertvalue %sollang.text poison, ptr %value, 0" -> println
            "  %text = insertvalue %sollang.text %text_ptr, i64 %length, 1" -> println
            "  ret %sollang.text %text" -> println
            "}" -> println
            context.expectedPathStyle == 1 -> if {
                """
                define internal void @sollang_init_utf8_arguments() {
                entry:
                  %argc_slot = alloca i32, align 4
                  %command = call ptr @GetCommandLineW()
                  %wide_argv = call ptr @CommandLineToArgvW(ptr %command, ptr %argc_slot)
                  %wide_ok = icmp ne ptr %wide_argv, null
                  br i1 %wide_ok, label %allocate, label %done
                allocate:
                  %argc32 = load i32, ptr %argc_slot, align 4
                  %argc = zext i32 %argc32 to i64
                  %argv_bytes = mul i64 %argc, 8
                  %utf8_argv = call ptr @malloc(i64 %argv_bytes)
                  %argv_ok = icmp ne ptr %utf8_argv, null
                  br i1 %argv_ok, label %loop, label %free_wide
                loop:
                  %index = phi i64 [ 0, %allocate ], [ %next, %stored ]
                  %complete = icmp eq i64 %index, %argc
                  br i1 %complete, label %success, label %size
                size:
                  %wide_slot = getelementptr ptr, ptr %wide_argv, i64 %index
                  %wide = load ptr, ptr %wide_slot, align 8
                  %byte_count32 = call i32 @WideCharToMultiByte(i32 65001, i32 128, ptr %wide, i32 -1, ptr null, i32 0, ptr null, ptr null)
                  %byte_count_valid = icmp sgt i32 %byte_count32, 0
                  br i1 %byte_count_valid, label %allocate_text, label %free_wide
                allocate_text:
                  %byte_count = zext i32 %byte_count32 to i64
                  %utf8 = call ptr @malloc(i64 %byte_count)
                  %utf8_ok = icmp ne ptr %utf8, null
                  br i1 %utf8_ok, label %convert, label %free_wide
                convert:
                  %written = call i32 @WideCharToMultiByte(i32 65001, i32 128, ptr %wide, i32 -1, ptr %utf8, i32 %byte_count32, ptr null, ptr null)
                  %converted = icmp eq i32 %written, %byte_count32
                  br i1 %converted, label %stored, label %free_wide
                stored:
                  %utf8_slot = getelementptr ptr, ptr %utf8_argv, i64 %index
                  store ptr %utf8, ptr %utf8_slot, align 8
                  %next = add i64 %index, 1
                  br label %loop
                success:
                  store i64 %argc, ptr @sollang_argc, align 8
                  store ptr %utf8_argv, ptr @sollang_argv, align 8
                  br label %free_wide
                free_wide:
                  %ignored = call ptr @LocalFree(ptr %wide_argv)
                  br label %done
                done:
                  ret void
                }
                """ -> println
            }
        }
    }
    CoreRuntimePreambleResult {
        usesArguments: usesArguments!
        usesNativeInterop: usesNativeInterop!
        usesComInterop: usesComInterop!
    }
}
