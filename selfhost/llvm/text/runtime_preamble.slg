                "failure:" -> println
                "  %failure_tag = getelementptr " -> print
                comMethod -> writeIrType(context, state)
                ", ptr %result_slot, i32 0, i32 0" -> println
                "  store i32 1, ptr %failure_tag, align 4" -> println
                "  %failure_payload = getelementptr " -> print
                comMethod -> writeIrType(context, state)
                ", ptr %result_slot, i32 0, i32 1" -> println
