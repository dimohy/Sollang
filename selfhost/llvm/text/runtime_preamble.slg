                "  %failure_payload = getelementptr " -> print
                comQuery -> writeIrType(context, state)
                ", ptr %result_slot, i32 0, i32 1" -> println
                "  store i32 %status, ptr %failure_payload, align 4" -> println
                "  br label %done" -> println
                "done:" -> println
                "  %result = load " -> print
                comQuery -> writeIrType(context, state)
                ", ptr %result_slot, align 8" -> println
                "  ret " -> print
