                        "  %server$(comBindIndex!) = extractvalue { ptr, ptr, i32 } %binding$(comBindIndex!), 0" -> println
                        "  %factory$(comBindIndex!) = extractvalue { ptr, ptr, i32 } %binding$(comBindIndex!), 1" -> println
                        "  %status$(comBindIndex!) = extractvalue { ptr, ptr, i32 } %binding$(comBindIndex!), 2" -> println
                        "  call void @sollang_com_require_status(i32 %status$(comBindIndex!))" -> println
                        "  call void @sollang_com_require_pointer(ptr %server$(comBindIndex!))" -> println
                        "  call void @sollang_com_require_pointer(ptr %factory$(comBindIndex!))" -> println
                        "  store ptr %server$(comBindIndex!), ptr @sollang_com_server_m$(comBindFunction.sourceModule)_a$(comBindInterfaceAst.parent), align 8" -> println
                        "  store ptr %factory$(comBindIndex!), ptr @sollang_com_factory_m$(comBindFunction.sourceModule)_a$(comBindInterfaceAst.parent), align 8" -> println
