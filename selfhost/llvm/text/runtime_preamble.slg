        allocationNode.kind == 6
            and allocationNode.symbol < 0
            and allocationNode.opcode == -1
            and allocationNode.typeOrigin == 1
            and allocationNode.typeSymbol == 15
            and allocationNode.operand0 >= 0 -> if {
                true => usesArenaAllocation!
                true => usesArenaConstruction!
                true => usesCollectionCapacityTrap!
            }
        arrayTypeSearch! + 1 => arrayTypeSearch!
    }
    # The canonical type arena is the dependency closure for emitted helper
    # signatures. A container may be reachable only through an enum payload
    # and its drop function even when no runtime IR node has that type.
    0 => arraySemanticTypeSearch!
    arraySemanticTypeSearch! < (context.types -> len)
        -> while {
            context.types[arraySemanticTypeSearch!] => arraySemanticType
            arraySemanticType.kind == 3 or (arraySemanticType.kind == 7 and arraySemanticType.origin == 4 and (arraySemanticType.symbol == 6 or arraySemanticType.symbol == 7))
                -> if { true => usesDynamicArray! }
            arraySemanticTypeSearch! + 1 => arraySemanticTypeSearch!
        }
    false => usesBoundedDictionary!
    0 => bitSetTypeSearch!
    bitSetTypeSearch! < (context.types -> len) -> while {
        context.types[bitSetTypeSearch!] => bitSetType
        bitSetType.kind == 13 and bitSetType.first >= 0 and bitSetType.second >= 0
            and context.typeLayoutStatuses[bitSetTypeSearch!] == 0
            -> if {
                true => usesBoundedDictionary!
                bitSetTypeSearch! -> boundedDictionaryLayoutForType(context) => boundedLayout
                "%sollang.bounded_dictionary.t$(bitSetTypeSearch!) = type { i64, [$(boundedLayout.storageSize) x i8] }" -> println
            }
        bitSetType.kind == 12 and bitSetType.first >= 0 and context.typeLayoutStatuses[bitSetTypeSearch!] == 0
            -> if {
                "%sollang.bounded_array.t$(bitSetTypeSearch!) = type { i64, " -> print
                bitSetTypeSearch! -> writeBoundedArrayBackingType(context, state)
                " }" -> println
            }
        bitSetType.kind == 14 -> if {
            "%sollang.bitset.t$(bitSetTypeSearch!) = type { [$((bitSetType.length + 63) / 64) x i64] }" -> println
        }
        bitSetTypeSearch! + 1 => bitSetTypeSearch!
    }
    0 => arrayCompositeSearch!
    arrayCompositeSearch! < (context.composite -> len)
        -> while {
            context.composite[arrayCompositeSearch!].kind == 3
                -> if { true => usesDynamicArray! }
            arrayCompositeSearch! + 1 => arrayCompositeSearch!
        }
    # Mutable container borrows are an ABI carrier for fixed, bounded, and
    # growable storage alike. Their declaration follows actual parameter use,
    # independently of the dynamic-array value layout.
    usesMutableContainer! -> if { "%sollang.mutable_container = type { ptr, ptr, ptr }" -> println }
    "%sollang.int_slice = type { ptr, i64 }" -> println
    usesDynamicArray! -> if { "%sollang.array.i32 = type { ptr, i64, i64 }" -> println }
    usesMappedBytes -> if { "%sollang.mapped_bytes = type { ptr, i64, ptr, i64, i1 }" -> println }
    false => usesDictionary!
    0 => dictionaryTypeSearch!
    dictionaryTypeSearch! < (context.ir -> len) -> while {
        (context.ir[dictionaryTypeSearch!] -> isDictionaryType)
            and (context.ir[dictionaryTypeSearch!] -> boundedDictionaryValueTypeId(context)) < 0
            -> if { true => usesDictionary! }
        dictionaryTypeSearch! + 1 => dictionaryTypeSearch!
    }
    0 => dictionarySemanticTypeSearch!
    dictionarySemanticTypeSearch! < (context.types -> len)
        -> while {
            context.types[dictionarySemanticTypeSearch!] => dictionarySemanticType
            dictionarySemanticType.kind == 5 or (dictionarySemanticType.kind == 7 and dictionarySemanticType.origin == 4 and dictionarySemanticType.symbol == 5)
                -> if { true => usesDictionary! }
            dictionarySemanticTypeSearch! + 1 => dictionarySemanticTypeSearch!
        }
    0 => dictionaryCompositeSearch!
    dictionaryCompositeSearch! < (context.composite -> len)
        -> while {
            context.composite[dictionaryCompositeSearch!].kind == 5
                -> if { true => usesDictionary! }
            dictionaryCompositeSearch! + 1 => dictionaryCompositeSearch!
        }
    false => usesTextDictionaryKeys!
    0 => textDictionaryIrSearch!
    textDictionaryIrSearch! < (context.ir -> len)
        -> while {
            context.ir[textDictionaryIrSearch!] => textDictionaryNode
            textDictionaryNode.typeId >= 0 and textDictionaryNode.typeId < (context.types -> len)
                -> if {
                    context.types[textDictionaryNode.typeId] => textDictionaryType
                    (textDictionaryType.kind == 5 or textDictionaryType.kind == 13 or (textDictionaryType.kind == 7 and textDictionaryType.origin == 4 and textDictionaryType.symbol == 5)) and textDictionaryType.first >= 0 and textDictionaryType.first < (context.types -> len)
                        -> if {
                            context.types[textDictionaryType.first] => textDictionaryKeyType
                            textDictionaryKeyType.kind == 1 and textDictionaryKeyType.origin == 1 and textDictionaryKeyType.symbol == 1
                                -> if { true => usesTextDictionaryKeys! }
                        }
                }
            textDictionaryIrSearch! + 1 => textDictionaryIrSearch!
        }
    false => usesEnumMatch!
    0 => enumMatchSearch!
    enumMatchSearch! < (context.ir -> len) -> while {
        context.ir[enumMatchSearch!].kind == 27 -> if { true => usesEnumMatch! }
        enumMatchSearch! + 1 => enumMatchSearch!
    }
    usesDictionary! -> if {
        "%sollang.int_dictionary = type { ptr, i64, i64 }" -> println
    }
    dropTypeActive -> emitSemanticDropHelpers(context, state)
    false => usesNativeInterop!
    false => hasNativeDeclarations!
    false => usesComInterop!
    0 => nativeInteropSearch!
    nativeInteropSearch! < (context.ir -> len) -> while {
        (context.ir[nativeInteropSearch!].kind == 6 or context.ir[nativeInteropSearch!].kind == 9)
            and (context.ir[nativeInteropSearch!] -> targetsNativeFunction(context, state))
            and (nativeInteropSearch! -> irNodeReachable(context, state))
            -> if { true => usesNativeInterop! }
        context.ir[nativeInteropSearch!] -> isNativeFunction(context, state)
            -> if {
                true => hasNativeDeclarations!
                nativeInteropSearch! -> nativeFunctionReachable(state)
                    -> if { true => usesNativeInterop! }
            }
        context.ir[nativeInteropSearch!] -> isComFunction(context, state)
            -> if { true => usesComInterop! }
        nativeInteropSearch! + 1 => nativeInteropSearch!
    }
    usesArrayAllocation! or usesCollectionCapacityTrap! or usesDictionary! or usesBoundedDictionary! or usesEnumMatch! or usesSourceText or usesMappedBytes or usesTextEach! or usesAsyncRuntime or hasNativeDeclarations! or usesComInterop! or (context -> usesReachableOwnedFileRuntime(state))
        -> if { "declare void @llvm.trap()" -> println }
    emitRawArenaRuntime(usesRawArenaAllocation!, usesRawArenaAccess!, usesArenaConstruction!)
    usesDictionary! -> if { "declare i16 @llvm.cttz.i16(i16, i1)" -> println }
    usesBitSetCount! -> if { "declare i64 @llvm.ctpop.i64(i64)" -> println }
    hasNativeDeclarations! -> if {
        context.expectedPathStyle == 1 -> if {
            "declare dllimport ptr @LoadLibraryA(ptr)" -> println
            "declare dllimport ptr @GetProcAddress(ptr, ptr)" -> println
            "declare dllimport i32 @FreeLibrary(ptr)" -> println
        } else {
            "declare ptr @dlopen(ptr, i32)" -> println
            "declare ptr @dlsym(ptr, ptr)" -> println
            "declare i32 @dlclose(ptr)" -> println
        }
        emitNativeRuntime(context, state)
    }
    context -> diagnostics.usesProcessExitWithReachability(state.frozenReachableFunctions) => needsProcessExit
    needsProcessExit or (context.pointerBitWidth != 32 and (intrinsicRuntimeModule >= 0 or (context -> usesReachableOwnedFileRuntime(state))))
        -> if {
            context.expectedPathStyle == 1 -> if { "declare dllimport void @ExitProcess(i32)" -> println } else { "declare void @exit(i32)" -> println }
        }
    usesText and not requiresEarlyTextType -> if { "%sollang.text = type { ptr, i64 }" -> println }
    usesMappedBytes and context.pointerBitWidth != 32
        -> if {
            context.expectedPathStyle == 1 -> if {
                not (intrinsicRuntimeModule >= 0 or usesSourceText or (context -> usesReachableOwnedFileRuntime(state)) or (context -> diagnostics.usesDirectoryRuntimeWithReachability(state.frozenReachableFunctions)) or (context -> diagnostics.usesParallelRuntime) or (context -> usesReachableProcessRuntime(state)) or (context -> diagnostics.usesProcessCaptureWithReachability(state.frozenReachableFunctions)) or (context -> diagnostics.usesMouseEventsRuntime) or context.usesConcurrentStreamJoins) => declareMappedCloseHandle
                intrinsicRuntimeModule < 0 and not usesSourceText => declareMappedMapping
                llvmRuntime.emitWindowsMappedBytes(declareMappedCloseHandle, declareMappedMapping)
            } else {
                not (usesSourceText or (context -> usesReachableProcessRuntime(state)) or (context -> usesReachableOwnedFileRuntime(state))) => declareMappedOpen
                not (usesSourceText or (context -> diagnostics.usesParallelRuntime) or (context -> diagnostics.usesSocketRuntimeWithReachability(state.frozenReachableFunctions)) or (context -> diagnostics.usesMouseEventsRuntime) or (context -> usesReachableProcessRuntime(state)) or (context -> usesReachableOwnedFileRuntime(state))) => declareMappedClose
                not usesSourceText => declareMappedPosixMapping
                llvmRuntime.emitLinuxMappedBytes(declareMappedOpen, declareMappedClose, declareMappedPosixMapping)
            }
        }
    context.pointerBitWidth == 32 and usesSourceText
        -> if {
            """
            define %sollang.source_text @sollang_runtime_map_text(%sollang.text %path) {
            entry:
              ret %sollang.source_text zeroinitializer
            }
            define void @sollang_runtime_unmap_text(%sollang.source_text %value) {
            entry:
              ret void
            }
            """ -> println
        }
    usesTextDictionaryKeys! -> if { llvmRuntime.emitDictionaryTextHashHelper() }
    context -> usesDirectTextEqualityRuntime => usesTextEqualityRuntime!
    usesTextDictionaryKeys! -> if { true => usesTextEqualityRuntime! }
    usesTextEqualityRuntime! -> if { llvmRuntime.emitTextEqualityHelper() }
    usesTextEach! -> if { llvmRuntime.emitUtf8DecodeHelper() }
    usesText -> if {
        0 => textGlobalIndex!
        textGlobalIndex! < (context.ir -> len) -> while {
            context.ir[textGlobalIndex!] => textConstant
            textConstant.kind == 2 -> if {
                textConstant -> sourceToken(context, state) => textToken
                TextLiteralRequest { sourceModule: textConstant.sourceModule, token: textToken } => textLiteralRequest
                textLiteralRequest -> textLiteralLength(context, state) => textLength
                "@sollang_str_$(textGlobalIndex! -> globalValueNameId(state)) = private unnamed_addr constant [$textLength x i8] " -> print
                textLiteralRequest -> emitTextLiteralConstant(context, state)
            }
            textGlobalIndex! + 1 => textGlobalIndex!
        }
    }
    false => usesArguments!
    0 => argumentsTypeSearch!
    argumentsTypeSearch! < (context.ir -> len) -> while {
        (argumentsTypeSearch! -> irNodeReachable(context, state))
            and (context.ir[argumentsTypeSearch!] -> isArgumentsType)
            -> if { true => usesArguments! }
        argumentsTypeSearch! + 1 => argumentsTypeSearch!
    }
    usesArguments! -> if {
        context.pointerBitWidth == 32 -> if {
            """
            @sollang_browser_program_name = private constant [8 x i8] c"sollangc"
            declare i32 @sollang_browser_source_count()
            declare i32 @sollang_browser_source_pointer(i32)
            declare i32 @sollang_browser_source_length(i32)
            define i64 @sollang_argument_count() {
            entry:
              %source_count32 = call i32 @sollang_browser_source_count()
              %source_count = zext i32 %source_count32 to i64
              %argument_count = add i64 %source_count, 1
              ret i64 %argument_count
            }
            define %sollang.text @sollang_argument(i64 %index) {
            entry:
              %source_count32 = call i32 @sollang_browser_source_count()
              %source_count = zext i32 %source_count32 to i64
              %source_index64 = sub i64 %index, 1
              %has_source_index = icmp ugt i64 %index, 0
              %source_index_in_bounds = icmp ult i64 %source_index64, %source_count
              %is_source = and i1 %has_source_index, %source_index_in_bounds
              br i1 %is_source, label %source, label %program
            source:
              %source_index = trunc i64 %source_index64 to i32
              %source_ptr32 = call i32 @sollang_browser_source_pointer(i32 %source_index)
              %source_ptr = inttoptr i32 %source_ptr32 to ptr
              %source_len32 = call i32 @sollang_browser_source_length(i32 %source_index)
              %source_len = zext i32 %source_len32 to i64
              %source0 = insertvalue %sollang.text poison, ptr %source_ptr, 0
              %source1 = insertvalue %sollang.text %source0, i64 %source_len, 1
              ret %sollang.text %source1
            program:
              %program0 = insertvalue %sollang.text poison, ptr @sollang_browser_program_name, 0
              %program1 = insertvalue %sollang.text %program0, i64 8, 1
              ret %sollang.text %program1
            }
            """ -> println
        } else {
            context.expectedPathStyle == 1 -> if {
                """
                @sollang_argument_count_value = internal global i64 0
                @sollang_argument_records = internal global ptr null
                define internal i32 @sollang_init_arguments() {
                entry:
                  %argc_slot = alloca i32, align 4
                  %command = call ptr @GetCommandLineW()
                  %wide_argv = call ptr @CommandLineToArgvW(ptr %command, ptr %argc_slot)
                  %argv_ok = icmp ne ptr %wide_argv, null
                  br i1 %argv_ok, label %allocate, label %fail

                allocate:
                  %argc32 = load i32, ptr %argc_slot, align 4
                  %argc = zext i32 %argc32 to i64
                  %record_bytes = mul i64 %argc, 16
                  %records = call ptr @sollang_alloc(i64 %record_bytes)
                  %records_ok = icmp ne ptr %records, null
                  br i1 %records_ok, label %loop, label %free_wide_fail

                loop:
                  %i = phi i64 [ 0, %allocate ], [ %next, %stored ]
                  %done = icmp eq i64 %i, %argc
                  br i1 %done, label %success, label %convert_size

                convert_size:
                  %wide_slot = getelementptr ptr, ptr %wide_argv, i64 %i
                  %wide = load ptr, ptr %wide_slot, align 8
                  %bytes32 = call i32 @WideCharToMultiByte(i32 65001, i32 128, ptr %wide, i32 -1, ptr null, i32 0, ptr null, ptr null)
                  %bytes_valid = icmp sgt i32 %bytes32, 0
                  br i1 %bytes_valid, label %convert_alloc, label %cleanup_partial

                convert_alloc:
                  %bytes = zext i32 %bytes32 to i64
                  %utf8 = call ptr @sollang_alloc(i64 %bytes)
                  %utf8_ok = icmp ne ptr %utf8, null
                  br i1 %utf8_ok, label %convert, label %cleanup_partial

                convert:
                  %written = call i32 @WideCharToMultiByte(i32 65001, i32 128, ptr %wide, i32 -1, ptr %utf8, i32 %bytes32, ptr null, ptr null)
                  %converted = icmp eq i32 %written, %bytes32
                  br i1 %converted, label %stored, label %free_current

                free_current:
                  call void @sollang_free(ptr %utf8)
                  br label %cleanup_partial

                stored:
                  %record = getelementptr %sollang.text, ptr %records, i64 %i
                  %ptr_slot = getelementptr inbounds %sollang.text, ptr %record, i32 0, i32 0
                  store ptr %utf8, ptr %ptr_slot, align 8
                  %len_slot = getelementptr inbounds %sollang.text, ptr %record, i32 0, i32 1
                  %length = sub i64 %bytes, 1
                  store i64 %length, ptr %len_slot, align 8
                  %next = add i64 %i, 1
                  br label %loop

                cleanup_partial:
                  %j = phi i64 [ %i, %convert_size ], [ %i, %convert_alloc ], [ %i, %free_current ], [ %prev, %cleanup_free ]
                  %cleanup_done = icmp eq i64 %j, 0
                  br i1 %cleanup_done, label %free_records_fail, label %cleanup_free

                cleanup_free:
                  %prev = sub i64 %j, 1
                  %old_record = getelementptr %sollang.text, ptr %records, i64 %prev
                  %old_ptr_slot = getelementptr inbounds %sollang.text, ptr %old_record, i32 0, i32 0
                  %old_ptr = load ptr, ptr %old_ptr_slot, align 8
                  call void @sollang_free(ptr %old_ptr)
                  br label %cleanup_partial

                free_records_fail:
                  call void @sollang_free(ptr %records)
                  br label %free_wide_fail

                success:
                  store i64 %argc, ptr @sollang_argument_count_value, align 8
                  store ptr %records, ptr @sollang_argument_records, align 8
                  %ignored_wide = call ptr @LocalFree(ptr %wide_argv)
                  ret i32 1

                free_wide_fail:
                  %ignored_fail = call ptr @LocalFree(ptr %wide_argv)
                  br label %fail

                fail:
                  ret i32 0
                }

                define internal i64 @sollang_argument_count() {
                entry:
                  %count = load i64, ptr @sollang_argument_count_value, align 8
                  ret i64 %count
                }

                define internal %sollang.text @sollang_argument(i64 %index) {
                entry:
                  %records = load ptr, ptr @sollang_argument_records, align 8
                  %record = getelementptr %sollang.text, ptr %records, i64 %index
                  %value = load %sollang.text, ptr %record, align 8
                  ret %sollang.text %value
                }

                define internal void @sollang_dispose_arguments() {
                entry:
                  %count = load i64, ptr @sollang_argument_count_value, align 8
                  %records = load ptr, ptr @sollang_argument_records, align 8
                  br label %loop

                loop:
                  %i = phi i64 [ 0, %entry ], [ %next, %free_item ]
                  %done = icmp eq i64 %i, %count
                  br i1 %done, label %finish, label %free_item

                free_item:
                  %record = getelementptr %sollang.text, ptr %records, i64 %i
                  %ptr_slot = getelementptr inbounds %sollang.text, ptr %record, i32 0, i32 0
                  %ptr = load ptr, ptr %ptr_slot, align 8
                  call void @sollang_free(ptr %ptr)
                  %next = add i64 %i, 1
                  br label %loop

                finish:
                  call void @sollang_free(ptr %records)
                  ret void
                }
                """ -> println
            } else {
                "@sollang_argc = internal global i64 0" -> println
                "@sollang_argv = internal global ptr null" -> println
                "define i64 @sollang_argument_count() {" -> println
                "entry:" -> println
                "  %count = load i64, ptr @sollang_argc, align 8" -> println
                "  ret i64 %count" -> println
                "}" -> println
                "define %sollang.text @sollang_argument(i64 %index) {" -> println
                "entry:" -> println
                "  %argv = load ptr, ptr @sollang_argv, align 8" -> println
                "  %slot = getelementptr ptr, ptr %argv, i64 %index" -> println
                "  %value = load ptr, ptr %slot, align 8" -> println
                "  br label %length_loop" -> println
                "length_loop:" -> println
                "  %length = phi i64 [ 0, %entry ], [ %next, %length_body ]" -> println
                "  %byte_ptr = getelementptr i8, ptr %value, i64 %length" -> println
                "  %byte = load i8, ptr %byte_ptr, align 1" -> println
                "  %done = icmp eq i8 %byte, 0" -> println
                "  br i1 %done, label %length_done, label %length_body" -> println
                "length_body:" -> println
                "  %next = add i64 %length, 1" -> println
                "  br label %length_loop" -> println
                "length_done:" -> println
                "  %text_ptr = insertvalue %sollang.text poison, ptr %value, 0" -> println
                "  %text = insertvalue %sollang.text %text_ptr, i64 %length, 1" -> println
                "  ret %sollang.text %text" -> println
                "}" -> println
            }
        }
    }
    CoreRuntimePreambleResult {
        usesArguments: usesArguments!
        usesNativeInterop: usesNativeInterop!
        usesComInterop: usesComInterop!
    }
}
