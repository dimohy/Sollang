                }
                comActivation.sourceModule -> emitGuidConstant(comClassAst.secondaryToken, false, comInterfaceAst.parent, context, state)
                "define internal " -> print
                comActivation -> writeIrType(context, state)
                " @sollang_$(comActivation.sourceModule -> functionSymbolName(comActivation.symbol, context))() {" -> println
                "entry:" -> println
                comClassAst.tertiaryToken < 0 -> if {
                    "  %raw = call { ptr, i32 } @sollang_com_activate_registered(ptr @sollang_com_clsid_m$(comActivation.sourceModule)_a$(comInterfaceAst.parent), ptr @sollang_com_iid_m$(comActivation.sourceModule)_s$(comActivationSymbol.parent))" -> println
