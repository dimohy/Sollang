                                        entryEarlierEffect.parent => entryEarlierParallelAncestor!
                                        false => entryEarlierInsideParallelBranch!
                                        entryEarlierParallelAncestor! > functionIndex and not entryEarlierInsideParallelBranch!
                                            -> while {
                                                context.ir[entryEarlierParallelAncestor!].kind == 38
                                                    -> if { true => entryEarlierInsideParallelBranch! } else { context.ir[entryEarlierParallelAncestor!].parent => entryEarlierParallelAncestor! }
                                            }
                                        not entryEarlierInsideParallelBranch! and not entryScheduled![entryEarlierEffectSearch! - functionIndex - 1] and ((entryEarlierEffect -> isSchedulingValueCapture) or (entryEarlierEffect -> typedIr.isConsoleRuntimeCall) or entryEarlierEffect.kind == 6 or (entryEarlierEffect -> isEntrySchedulingControl) or entryEarlierEffect.kind == 24 or entryEarlierEffect.kind == 25 or (entryEarlierEffect.kind == 17 and entryEarlierEffect.flags == 1) or ((entryEarlierEffect -> isSchedulingMutationIntrinsic))) and (entryEarlierEffect -> sourceStart(context, state)) < (context.ir[entryEffectOrderingIndex!] -> sourceStart(context, state))
                                            -> if {
