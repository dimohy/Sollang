                                        }
                                    }
                                } else {
                                    entryScheduleNode.kind == 9 -> if {
                                        entryScheduleNode.operand0 -> mutableStorageRoot(context, state) => entryMutableReadRoot!
                                        entryMutableReadRoot! >= 0 -> if { true => entryMutableRead! }
                                    } else {
                                        entryScheduleCandidate! -> referencePlaceRootBinding(context) => entryMutableProjectionRoot
                                        entryMutableProjectionRoot > functionIndex and entryMutableProjectionRoot < entryEnd and context.ir[entryMutableProjectionRoot].flags == 1
                                            -> if {
                                                true => entryMutableRead!
                                                entryMutableProjectionRoot => entryMutableReadRoot!
