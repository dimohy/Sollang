                            }
                        entryScheduleReady! and (entryScheduleNode.kind == 5 or entryScheduleNode.kind == 13 or entryScheduleNode.kind == 15 or (entryScheduleNode.kind == 9 and (entryScheduleNode.opcode == -201 or entryScheduleNode.opcode == -236 or (entryScheduleNode.opcode <= -248 and entryScheduleNode.opcode >= -251)) and entryScheduleNode.operand0 >= 0))
                            -> if {
                                false => entryMutableRead!
                                -1 => entryMutableReadRoot!
                                entryScheduleCandidate! -> isMutablePlaceRead(functionIndex + 1, entryEnd, context, state)
                                    -> if { true => entryMutableRead! }
                                entryScheduleNode.kind == 5 -> if {
                                    false => entryExactReadBinding!
                                    entryScheduleNode.operand0 > functionIndex and entryScheduleNode.operand0 < entryEnd and context.ir[entryScheduleNode.operand0].kind == 17
