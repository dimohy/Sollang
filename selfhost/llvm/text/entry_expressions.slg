        entryProducerCallbackProgress! -> while {
            false => entryProducerCallbackProgress!
            0 => entryProducerPipelineIndex!
            entryProducerPipelineIndex! < (context.streamPlan.pipelines -> len)
                -> while {
                    context.streamPlan.pipelines[entryProducerPipelineIndex!] => entryProducerPipeline
                    entryProducerPipeline.terminalIr -> plannedPartitionRoute(context, state) => entryProducerPartitionRoute
                    true => entryProducerPartitionPriorComplete!
                    entryProducerPartitionRoute >= 0 -> if {
                        entryProducerPartitionRoute -> plannedPartitionJunction(context, state) => entryProducerPartitionJunction
                        context.streamPlan.junctions[entryProducerPartitionJunction].routeStart => entryProducerPriorRoute!
                        entryProducerPriorRoute! < entryProducerPartitionRoute
                            -> while {
                                context.streamPlan.partitionRoutes[entryProducerPriorRoute!] => entryProducerPriorPartitionRoute
                                entryProducerPriorPartitionRoute.pipelineIndex >= 0
                                    -> if {
                                        context.streamPlan.pipelines[entryProducerPriorPartitionRoute.pipelineIndex] => entryProducerPriorPipeline
                                        entryProducerPriorPipeline.callbackStart => entryProducerPriorCallback!
                                        entryProducerPriorCallback! <= entryProducerPriorPipeline.callbackEnd
                                            -> while {
                                                entryProducerPriorCallback! > functionIndex and entryProducerPriorCallback! < entryEnd and not entryScheduled![entryProducerPriorCallback! - functionIndex - 1]
                                                    -> if { false => entryProducerPartitionPriorComplete! }
                                                entryProducerPriorCallback! + 1 => entryProducerPriorCallback!
                                            }
                                        entryProducerPriorPipeline.stageStart => entryProducerPriorStage!
                                        entryProducerPriorStage! < entryProducerPriorPipeline.stageStart + entryProducerPriorPipeline.stageCount
                                            -> while {
                                                context.streamPlan.stages[entryProducerPriorStage!] => entryProducerPriorStagePlan
                                                entryProducerPriorStagePlan.callbackStart => entryProducerPriorStageCallback!
                                                entryProducerPriorStageCallback! <= entryProducerPriorStagePlan.callbackEnd
                                                    -> while {
                                                        entryProducerPriorStageCallback! > functionIndex and entryProducerPriorStageCallback! < entryEnd and not entryScheduled![entryProducerPriorStageCallback! - functionIndex - 1]
                                                            -> if { false => entryProducerPartitionPriorComplete! }
                                                        entryProducerPriorStageCallback! + 1 => entryProducerPriorStageCallback!
                                                    }
                                                entryProducerPriorStage! + 1 => entryProducerPriorStage!
                                            }
                                    }
                                entryProducerPriorRoute! + 1 => entryProducerPriorRoute!
                            }
                    }
                    entryProducerPartitionRoute >= 0 and entryProducerPartitionPriorComplete! and entryProducerPipeline.terminalIr > functionIndex and entryProducerPipeline.terminalIr < entryEnd and not entryScheduled![entryProducerPipeline.terminalIr - functionIndex - 1]
                        -> if {
                            entryOrder! -> push(entryProducerPipeline.terminalIr)
                            true => entryScheduled![entryProducerPipeline.terminalIr - functionIndex - 1]
                            true => entryProducerCallbackProgress!
                            true => entryCombinedScheduleProgress!
                        }
                    entryProducerPipeline.status > 0 and entryProducerPipeline.status < 3 and entryProducerPipeline.terminalIr > functionIndex and entryProducerPipeline.terminalIr < entryEnd and entryScheduled![entryProducerPipeline.terminalIr - functionIndex - 1] and entryProducerPipeline.callbackStart >= functionIndex + 1 and entryProducerPipeline.callbackEnd < entryEnd
                        -> if {
                            entryProducerPipeline.stageStart => entryProducerStageIndex!
                            entryProducerStageIndex! < entryProducerPipeline.stageStart + entryProducerPipeline.stageCount
                                -> while {
                                    context.streamPlan.stages[entryProducerStageIndex!] => entryProducerStage
                                    entryProducerStage.callbackStart >= functionIndex + 1 and entryProducerStage.callbackEnd < entryEnd
                                        -> if {
                                            entryProducerStage.callbackStart => entryProducerStageCallbackIndex!
                                            entryProducerStageCallbackIndex! <= entryProducerStage.callbackEnd
                                                -> while {
                                                    not entryScheduled![entryProducerStageCallbackIndex! - functionIndex - 1]
                                                        -> if {
                                                            context.ir[entryProducerStageCallbackIndex!] => entryProducerStageCallback
                                                            true => entryProducerStageCallbackReady!
                                                            NodeAncestorRequest { nodeIndex: entryProducerStageCallbackIndex!, ownerIndex: entryProducerStage.callIr } -> irDescendsFrom(context, state) => entryProducerStageCallbackInside
                                                            not entryProducerStageCallbackInside -> if { false => entryProducerStageCallbackReady! }
                                                            entryProducerStageCallbackReady! and entryProducerStage.source0 >= 0
                                                                -> if {
                                                                    NodeAncestorRequest { nodeIndex: entryProducerStageCallbackIndex!, ownerIndex: entryProducerStage.source0 } -> irDescendsFrom(context, state) => entryProducerStageCallbackInsideSource
                                                                    entryProducerStageCallbackIndex! == entryProducerStage.source0 or entryProducerStageCallbackInsideSource
                                                                        -> if { false => entryProducerStageCallbackReady! }
                                                                }
                                                            entryProducerStageCallback.operand0 > functionIndex and entryProducerStageCallback.operand0 < entryEnd and not entryScheduled![entryProducerStageCallback.operand0 - functionIndex - 1]
                                                                -> if { false => entryProducerStageCallbackReady! }
                                                            entryProducerStageCallback.operand1 > functionIndex and entryProducerStageCallback.operand1 < entryEnd and not entryScheduled![entryProducerStageCallback.operand1 - functionIndex - 1]
                                                                -> if { false => entryProducerStageCallbackReady! }
                                                            entryProducerStageCallbackReady! -> if {
                                                                entryOrder! -> push(entryProducerStageCallbackIndex!)
                                                                true => entryScheduled![entryProducerStageCallbackIndex! - functionIndex - 1]
                                                                true => entryProducerCallbackProgress!
                                                                true => entryCombinedScheduleProgress!
                                                            }
                                                        }
                                                    entryProducerStageCallbackIndex! + 1 => entryProducerStageCallbackIndex!
                                                }
                                        }
                                    entryProducerStageIndex! + 1 => entryProducerStageIndex!
                                }
                            entryProducerPipeline.callbackStart => entryProducerCallbackIndex!
                            entryProducerCallbackIndex! <= entryProducerPipeline.callbackEnd
                                -> while {
                                    not entryScheduled![entryProducerCallbackIndex! - functionIndex - 1]
                                        -> if {
                                            context.ir[entryProducerCallbackIndex!] => entryProducerCallback
                                            true => entryProducerCallbackReady!
                                            NodeAncestorRequest { nodeIndex: entryProducerCallbackIndex!, ownerIndex: entryProducerPipeline.terminalIr } -> irDescendsFrom(context, state) => entryProducerCallbackInside
                                            not entryProducerCallbackInside -> if { false => entryProducerCallbackReady! }
                                            entryProducerCallbackReady! and entryProducerPipeline.source0 >= 0
                                                -> if {
                                                    NodeAncestorRequest { nodeIndex: entryProducerCallbackIndex!, ownerIndex: entryProducerPipeline.source0 } -> irDescendsFrom(context, state) => entryProducerCallbackInsideSource
                                                    entryProducerCallbackIndex! == entryProducerPipeline.source0 or entryProducerCallbackInsideSource
                                                        -> if { false => entryProducerCallbackReady! }
                                                }
