                                    entryScheduleCandidate! => entryPendingEach!
                                    entryScheduleCandidate! -> plannedStreamPipeline(context, state) => entryScheduledStreamPipeline
                                    entryScheduledStreamPipeline >= 0 and entryScheduleNode.operand0 > functionIndex and entryScheduleNode.operand0 < entryEnd
