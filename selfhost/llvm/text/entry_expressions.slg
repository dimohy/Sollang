}

emitEntryValueExpression entryExpressionIndex: Int, functionIndex: Int, entryEnd: Int, entryPointerAlignment: Int, entryOrder: ref [Int; ~], entryActiveEach: mut [Int; ~], activeEachSize: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int uses Console {
    context.ir[entryExpressionIndex] => entryExpression
    context.ir[functionIndex] => function
    activeEachSize => entryActiveEachSize!
    entryExpressionIndex -> emitArgumentsIntrinsic(context)
    entryExpression.kind == 5 and entryExpression.operand0 < 0 and function.kind == 0
        and (context -> parameterIndexForFunction(functionIndex, entryExpression.symbol)) >= 0
        -> if {
            "  %v$(entryExpressionIndex) = freeze " -> print
            entryExpression -> writeIrType(context, state)
            " " -> print
            entryExpressionIndex -> writeValue(functionIndex, context, state)
            "" -> println
        }
    entryExpressionIndex -> streamIr.resolveProducer(context.ir) => streamValueProducer
    entryExpression.kind == 5
        and (streamValueProducer -> plannedStreamStage(context, state)) < 0
        -> if {
            -1 => entryBindingValueIr!
            entryExpression.operand0 >= 0 and (context.ir[entryExpression.operand0].kind == 17 or context.ir[entryExpression.operand0].kind == 29)
                -> if { entryExpression.operand0 => entryBindingValueIr! }
            entryBindingValueIr! >= 0 -> if {
                context.ir[entryBindingValueIr!] => entryBindingValue
                entryBindingValue.kind == 29 -> if {
                    "  %v$(entryExpressionIndex) = freeze " -> print
