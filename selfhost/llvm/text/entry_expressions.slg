                "  %v$(entryExpressionIndex)_group_control5 = load i8, ptr %v$(entryExpressionIndex)_group_ptr5, align 1" -> println
                "  %v$(entryExpressionIndex)_group_control6 = load i8, ptr %v$(entryExpressionIndex)_group_ptr6, align 1" -> println
                "  %v$(entryExpressionIndex)_group_control7 = load i8, ptr %v$(entryExpressionIndex)_group_ptr7, align 1" -> println
                "  %v$(entryExpressionIndex)_group_match0 = icmp eq i8 %v$(entryExpressionIndex)_control, %v$(entryExpressionIndex)_h2" -> println
                "  %v$(entryExpressionIndex)_group_match1 = icmp eq i8 %v$(entryExpressionIndex)_group_control1, %v$(entryExpressionIndex)_h2" -> println
                "  %v$(entryExpressionIndex)_group_match2 = icmp eq i8 %v$(entryExpressionIndex)_group_control2, %v$(entryExpressionIndex)_h2" -> println
                "  %v$(entryExpressionIndex)_group_match3 = icmp eq i8 %v$(entryExpressionIndex)_group_control3, %v$(entryExpressionIndex)_h2" -> println
                "  %v$(entryExpressionIndex)_group_match4 = icmp eq i8 %v$(entryExpressionIndex)_group_control4, %v$(entryExpressionIndex)_h2" -> println
                "  %v$(entryExpressionIndex)_group_match5 = icmp eq i8 %v$(entryExpressionIndex)_group_control5, %v$(entryExpressionIndex)_h2" -> println
                "  %v$(entryExpressionIndex)_group_match6 = icmp eq i8 %v$(entryExpressionIndex)_group_control6, %v$(entryExpressionIndex)_h2" -> println
                "  %v$(entryExpressionIndex)_group_match7 = icmp eq i8 %v$(entryExpressionIndex)_group_control7, %v$(entryExpressionIndex)_h2" -> println
                "  %v$(entryExpressionIndex)_group_match01 = or i1 %v$(entryExpressionIndex)_group_match0, %v$(entryExpressionIndex)_group_match1" -> println
                "  %v$(entryExpressionIndex)_group_match23 = or i1 %v$(entryExpressionIndex)_group_match2, %v$(entryExpressionIndex)_group_match3" -> println
                "  %v$(entryExpressionIndex)_group_match45 = or i1 %v$(entryExpressionIndex)_group_match4, %v$(entryExpressionIndex)_group_match5" -> println
                "  %v$(entryExpressionIndex)_group_match67 = or i1 %v$(entryExpressionIndex)_group_match6, %v$(entryExpressionIndex)_group_match7" -> println
                "  %v$(entryExpressionIndex)_group_match0123 = or i1 %v$(entryExpressionIndex)_group_match01, %v$(entryExpressionIndex)_group_match23" -> println
                "  %v$(entryExpressionIndex)_group_match4567 = or i1 %v$(entryExpressionIndex)_group_match45, %v$(entryExpressionIndex)_group_match67" -> println
                "  %v$(entryExpressionIndex)_group_has_match = or i1 %v$(entryExpressionIndex)_group_match0123, %v$(entryExpressionIndex)_group_match4567" -> println
                "  %v$(entryExpressionIndex)_group_candidate_offset7 = select i1 %v$(entryExpressionIndex)_group_match7, i64 7, i64 0" -> println
                "  %v$(entryExpressionIndex)_group_candidate_offset6 = select i1 %v$(entryExpressionIndex)_group_match6, i64 6, i64 %v$(entryExpressionIndex)_group_candidate_offset7" -> println
                "  %v$(entryExpressionIndex)_group_candidate_offset5 = select i1 %v$(entryExpressionIndex)_group_match5, i64 5, i64 %v$(entryExpressionIndex)_group_candidate_offset6" -> println
                "  %v$(entryExpressionIndex)_group_candidate_offset4 = select i1 %v$(entryExpressionIndex)_group_match4, i64 4, i64 %v$(entryExpressionIndex)_group_candidate_offset5" -> println
                "  %v$(entryExpressionIndex)_group_candidate_offset3 = select i1 %v$(entryExpressionIndex)_group_match3, i64 3, i64 %v$(entryExpressionIndex)_group_candidate_offset4" -> println
                "  %v$(entryExpressionIndex)_group_candidate_offset2 = select i1 %v$(entryExpressionIndex)_group_match2, i64 2, i64 %v$(entryExpressionIndex)_group_candidate_offset3" -> println
                "  %v$(entryExpressionIndex)_group_candidate_offset1 = select i1 %v$(entryExpressionIndex)_group_match1, i64 1, i64 %v$(entryExpressionIndex)_group_candidate_offset2" -> println
                "  %v$(entryExpressionIndex)_group_candidate_offset = select i1 %v$(entryExpressionIndex)_group_match0, i64 0, i64 %v$(entryExpressionIndex)_group_candidate_offset1" -> println
                "  %v$(entryExpressionIndex)_group_candidate_unwrapped = add i64 %v$(entryExpressionIndex)_slot, %v$(entryExpressionIndex)_group_candidate_offset" -> println
                "  %v$(entryExpressionIndex)_group_candidate_slot = urem i64 %v$(entryExpressionIndex)_group_candidate_unwrapped, %v$(entryExpressionIndex)_capacity" -> println
                "  br i1 %v$(entryExpressionIndex)_group_has_match, label %dict$(entryExpressionIndex)_h2_check, label %dict$(entryExpressionIndex)_group_advance" -> println
                "dict$(entryExpressionIndex)_group_advance:" -> println
                "  %v$(entryExpressionIndex)_group_next_unwrapped = add i64 %v$(entryExpressionIndex)_slot, 8" -> println
                "  %v$(entryExpressionIndex)_group_next = urem i64 %v$(entryExpressionIndex)_group_next_unwrapped, %v$(entryExpressionIndex)_capacity" -> println
                "  %v$(entryExpressionIndex)_group_probe_next = add i64 %v$(entryExpressionIndex)_probe, 8" -> println
                "  br label %dict$(entryExpressionIndex)_loop" -> println
                "dict$(entryExpressionIndex)_h2_check:" -> println
                "  br label %dict$(entryExpressionIndex)_key_check" -> println
                "dict$(entryExpressionIndex)_key_check:" -> println
                "  %v$(entryExpressionIndex)_key_ptr = getelementptr " -> print
                entryIndexedDictionaryKeyTypeId! >= 0 -> if { entryIndexedDictionaryKeyTypeId! -> writeSemanticTypeId(context, state) } else { entryIndexedValue.typeModule -> llvmType(context, state) -> print }
                ", ptr %v$(entryExpressionIndex)_keys, i64 %v$(entryExpressionIndex)_group_candidate_slot" -> println
                "  %v$(entryExpressionIndex)_key = load " -> print
                entryIndexedDictionaryKeyTypeId! >= 0 -> if { entryIndexedDictionaryKeyTypeId! -> writeSemanticTypeId(context, state) } else { entryIndexedValue.typeModule -> llvmType(context, state) -> print }
                ", ptr %v$(entryExpressionIndex)_key_ptr, align " -> print
                entryIndexedDictionaryKeyTypeId! >= 0 -> if { context.typeAligns[entryIndexedDictionaryKeyTypeId!] -> writeDecimalLine } else { entryIndexedValue.typeModule -> legacyStorageAlign(context, state) -> writeDecimalLine }
                entryIndexValue -> isTextType -> if {
                    "  %v$(entryExpressionIndex)_found = call i1 @sollang_text_equal(%sollang.text %v$(entryExpressionIndex)_key, %sollang.text %v$(entryExpression.operand1))" -> println
                } else {
                    -1 => entryIndexedDictionaryEqMethod!
                    entryIndexedDictionaryKeyTypeId! >= 0 -> if { entryIndexedDictionaryKeyTypeId! -> traitMethodSymbol("Eq", "eq", context, state) => entryIndexedDictionaryEqMethod! }
                    entryIndexedDictionaryEqMethod! >= 0 -> if {
                        context.types[entryIndexedDictionaryKeyTypeId!] => entryIndexedNominalKeyType
                        "  %v$(entryExpressionIndex)_stored_eq = call i32 @sollang_m$(entryIndexedNominalKeyType.module)_s$(entryIndexedDictionaryEqMethod!)(" -> print
                        entryIndexedDictionaryKeyTypeId! -> writeSemanticTypeId(context, state)
                        " %v$(entryExpressionIndex)_key)" -> println
                        "  %v$(entryExpressionIndex)_query_eq = call i32 @sollang_m$(entryIndexedNominalKeyType.module)_s$(entryIndexedDictionaryEqMethod!)(" -> print
                        entryIndexedDictionaryKeyTypeId! -> writeSemanticTypeId(context, state)
                        " %v$(entryExpression.operand1))" -> println
                        "  %v$(entryExpressionIndex)_found = icmp eq i32 %v$(entryExpressionIndex)_stored_eq, %v$(entryExpressionIndex)_query_eq" -> println
                    } else {
                        "  %v$(entryExpressionIndex)_found = icmp eq " -> print
                        entryIndexedDictionaryKeyTypeId! >= 0 -> if { entryIndexedDictionaryKeyTypeId! -> writeSemanticTypeId(context, state) } else { entryIndexedValue.typeModule -> llvmType(context, state) -> print }
                        " %v$(entryExpressionIndex)_key, " -> print
                        entryIndexValue.kind == 3 or entryIndexValue.kind == 4
                            -> if {
                                entryIndexValue -> sourceToken(context, state) => entryDictionaryIndexToken
                                entryIndexValue.kind == 3 -> if {
                                    entryIndexValue -> writeIntegerLiteral(context, state)
                                    "" -> println
                                } else {
                                    (context.sources[entryIndexValue.sourceModule] -> byte(entryDictionaryIndexToken.span.start)) == 116
                                        -> if { "1" -> println } else { "0" -> println }
                                }
                            } else { "%v$(entryExpression.operand1)" -> println }
                    }
                }
                "  br i1 %v$(entryExpressionIndex)_found, label %dict$(entryExpressionIndex)_hit, label %dict$(entryExpressionIndex)_advance" -> println
                "dict$(entryExpressionIndex)_advance:" -> println
                "  %v$(entryExpressionIndex)_next_unwrapped = add i64 %v$(entryExpressionIndex)_slot, 1" -> println
                "  %v$(entryExpressionIndex)_next = urem i64 %v$(entryExpressionIndex)_next_unwrapped, %v$(entryExpressionIndex)_capacity" -> println
                "  %v$(entryExpressionIndex)_probe_next = add i64 %v$(entryExpressionIndex)_probe, 1" -> println
                "  br label %dict$(entryExpressionIndex)_loop" -> println
                "dict$(entryExpressionIndex)_missing:" -> println
                "  call void @llvm.trap()" -> println
                "  unreachable" -> println
                "dict$(entryExpressionIndex)_hit:" -> println
                "  %v$(entryExpressionIndex)_value_ptr = getelementptr " -> print
                entryIndexedDictionaryValueTypeId! >= 0 -> if { entryIndexedDictionaryValueTypeId! -> writeSemanticTypeId(context, state) } else { entryIndexedValue.typeSymbol -> llvmType(context, state) -> print }
                ", ptr %v$(entryExpressionIndex)_values, i64 %v$(entryExpressionIndex)_group_candidate_slot" -> println
                "  %v$(entryExpressionIndex) = load " -> print
                entryIndexedDictionaryValueTypeId! >= 0 -> if { entryIndexedDictionaryValueTypeId! -> writeSemanticTypeId(context, state) } else { entryIndexedValue.typeSymbol -> llvmType(context, state) -> print }
                ", ptr %v$(entryExpressionIndex)_value_ptr, align " -> print
                entryIndexedDictionaryValueTypeId! >= 0 -> if { context.typeAligns[entryIndexedDictionaryValueTypeId!] -> writeDecimalLine } else { entryIndexedValue.typeSymbol -> legacyStorageAlign(context, state) -> writeDecimalLine }
            } else {
                "  %v$(entryExpressionIndex)_data = extractvalue " -> print
                entryIndexedValue -> writeIrType(context, state)
                " %v$(entryExpression.operand0), 0" -> println
                entryIndexValue -> integerNodeWidth(context, state) => entryArrayIndexWidth
                entryIndexValue.kind != 3 and entryArrayIndexWidth > 0 and entryArrayIndexWidth < 64
                    -> if {
                        "  %v$(entryExpressionIndex)_index = " -> print
                        entryIndexValue -> integerNodeSigned(context, state)
                            -> if { "sext " -> print } else { "zext " -> print }
                        "i$(entryArrayIndexWidth) %v$(entryExpression.operand1) to i64" -> println
                    }
                "  %v$(entryExpressionIndex)_ptr = getelementptr " -> print
                entryExpression -> writeIrType(context, state)
                ", ptr %v$(entryExpressionIndex)_data, i64 " -> print
                entryIndexValue.kind == 3 -> if {
                    entryIndexValue -> writeIntegerLiteral(context, state)
                    "" -> println
                } else {
                    entryArrayIndexWidth > 0 and entryArrayIndexWidth < 64
                        -> if { "%v$(entryExpressionIndex)_index" -> println } else { "%v$(entryExpression.operand1)" -> println }
                }
                "  %v$(entryExpressionIndex) = load " -> print
                entryExpression -> writeIrType(context, state)
                ", ptr %v$(entryExpressionIndex)_ptr, align " -> print
                entryExpression -> storageAlign(context, state) -> writeDecimalLine
            }
        }
    }
    entryActiveEachSize!
}

emitEntryOperationExpression entryExpressionIndex: Int, functionIndex: Int, entryEnd: Int, entryOrder: ref [Int; ~], entryActiveStreams: mut [Int; ~], entryStreamCurrentValues: mut [Int; ~], activeStreamSize: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int uses Console {
    context.ir[entryExpressionIndex] => entryExpression
    entryExpression.kind == 8 and entryExpression.operand0 >= 0 and entryExpression.operand1 < 0 and activeStreamSize > 0
        -> if {
            context.ir[entryExpression.operand0] => entryFlowRight
            entryActiveStreams[activeStreamSize - 1] => entryFlowPipelineIndex
            context.streamPlan.pipelines[entryFlowPipelineIndex].terminalIr => entryFlowTerminalIr
            "" => entryFlowOperation!
            entryExpression.opcode == grammar.tokenIdPlus()
                -> if { "add" => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdMinus()
                -> if { "sub" => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdStar()
                -> if { "mul" => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdSlash()
                -> if { entryExpression -> integerQuotientOperation(context, state) => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdPercent()
                -> if { entryExpression -> integerRemainderOperation(context, state) => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdEqualEqual()
                -> if { "icmp eq" => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdBangEqual()
                -> if { "icmp ne" => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdLess()
                -> if { "icmp slt" => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdLessEqual()
                -> if { "icmp sle" => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdGreater()
                -> if { "icmp sgt" => entryFlowOperation! }
            entryExpression.opcode == grammar.tokenIdGreaterEqual()
                -> if { "icmp sge" => entryFlowOperation! }
            "  %v$(entryExpressionIndex) = $(entryFlowOperation!) i32 %stream$(entryFlowTerminalIr)_item, " -> print
            entryFlowRight.kind == 3 -> if {
                entryFlowRight -> writeIntegerLiteral(context, state)
                "" -> println
            } else {
                "%v$(entryExpression.operand0)" -> println
            }
        }
    (entryExpression.kind == 7 and entryExpression.operand0 >= 0) or (entryExpression.kind == 8 and entryExpression.operand0 >= 0 and entryExpression.operand1 >= 0)
        -> if {
            entryExpression.kind == 8 and (entryExpression.opcode == -24 or entryExpression.opcode == -25)
                -> if {
                    entryExpressionIndex -> emitLogicalValue(functionIndex, entryOrder, context, state)
                } else {
                    context.ir[entryExpression.operand0] => entryLeft
                    0 => entryBinaryWidth!
                    false => entryLeftPromoted!
                    false => entryRightPromoted!
                    entryExpression.kind == 8 -> if {
                        context.ir[entryExpression.operand1] => entryRight
                        entryLeft -> integerNodeWidth(context, state) => entryLeftWidth
                        entryRight -> integerNodeWidth(context, state) => entryRightWidth
                        entryLeftWidth > 0 and entryRightWidth > 0 -> if {
                            entryLeftWidth > entryRightWidth -> if { entryLeftWidth => entryBinaryWidth! } else { entryRightWidth => entryBinaryWidth! }
                            IntegerPromotionRequest { expressionIndex: entryExpressionIndex, operandIndex: entryExpression.operand0, targetWidth: entryBinaryWidth!, ownerIndex: functionIndex, right: false } -> emitIntegerPromotion(context, state) => entryLeftPromoted!
                            IntegerPromotionRequest { expressionIndex: entryExpressionIndex, operandIndex: entryExpression.operand1, targetWidth: entryBinaryWidth!, ownerIndex: functionIndex, right: true } -> emitIntegerPromotion(context, state) => entryRightPromoted!
                        }
                    }
                    "" => entryOperation!
                    entryExpression.kind == 7 -> if {
                        entryExpression.opcode == -26 -> if { "xor" => entryOperation! } else { "sub" => entryOperation! }
                    } else {
                        entryExpression.opcode == grammar.tokenIdPlus()
                            -> if { "add" => entryOperation! }
                        entryExpression.opcode == grammar.tokenIdMinus()
                            -> if { "sub" => entryOperation! }
                        entryExpression.opcode == grammar.tokenIdStar()
                            -> if { "mul" => entryOperation! }
                        entryExpression.opcode == grammar.tokenIdSlash()
                            -> if { entryExpression -> integerQuotientOperation(context, state) => entryOperation! }
                        entryExpression.opcode == grammar.tokenIdPercent()
                            -> if { entryExpression -> integerRemainderOperation(context, state) => entryOperation! }
                        entryExpression.opcode == grammar.tokenIdEqualEqual()
                            -> if { "icmp eq" => entryOperation! }
                        entryExpression.opcode == grammar.tokenIdBangEqual()
                            -> if { "icmp ne" => entryOperation! }
                        entryExpression.opcode == grammar.tokenIdLess() or entryExpression.opcode == grammar.tokenIdLessEqual() or entryExpression.opcode == grammar.tokenIdGreater() or entryExpression.opcode == grammar.tokenIdGreaterEqual()
                            -> if {
                                entryExpression -> integerComparisonOperation(context, state) => entryOperation!
                            }
                        entryExpression.opcode == -24 -> if { "or" => entryOperation! }
                        entryExpression.opcode == -25 -> if { "and" => entryOperation! }
                    }
                    entryExpression.kind == 8
                        and (entryExpression.opcode == grammar.tokenIdEqualEqual() or entryExpression.opcode == grammar.tokenIdBangEqual())
                        and (entryLeft -> isTextType)
                        and (context.ir[entryExpression.operand1] -> isTextType) => entryTextEquality
                    entryTextEquality -> if {
                        entryExpression.opcode == grammar.tokenIdBangEqual()
                            -> if {
                                "  %v$(entryExpressionIndex)_text_equal = call i1 @sollang_text_equal(%sollang.text %v$(entryExpression.operand0), %sollang.text %v$(entryExpression.operand1))" -> println
                                "  %v$(entryExpressionIndex) = xor i1 %v$(entryExpressionIndex)_text_equal, true" -> println
                            } else {
                                "  %v$(entryExpressionIndex) = call i1 @sollang_text_equal(%sollang.text %v$(entryExpression.operand0), %sollang.text %v$(entryExpression.operand1))" -> println
                            }
                    } else {
                        "  %v$(entryExpressionIndex) = $(entryOperation!) " -> print
                        entryBinaryWidth! > 0 -> if { "i$(entryBinaryWidth!)" -> print } else { entryExpression.kind == 7
                                -> if { entryExpression -> writeIrType(context, state) } else { entryLeft -> writeIrType(context, state) } }
                        " " -> print
                        entryExpression.kind == 7 and entryExpression.opcode != -26
                            -> if { "0" -> print } else {
                                entryLeft.kind == 3 or entryLeft.kind == 4 -> if {
                                    entryLeft -> sourceToken(context, state) => entryLeftToken
                                    entryLeft.kind == 3 -> if { entryLeft -> writeIntegerLiteral(context, state) } else {
                                        (context.sources[entryLeft.sourceModule] -> byte(entryLeftToken.span.start)) == 116
                                            -> if { "1" -> print } else { "0" -> print }
                                    }
                                } else {
                                    entryLeftPromoted! -> if { "%v$(entryExpressionIndex)_left_wide" -> print } else { "%v$(entryExpression.operand0)" -> print }
                                }
                            }
                        ", " -> print
                        entryExpression.kind == 7 -> if {
                            entryExpression.opcode == -26 -> if { "true" -> println } else {
                                entryLeft.kind == 3 or entryLeft.kind == 4 -> if {
                                    entryLeft -> sourceToken(context, state) => entryUnaryToken
                                    entryLeft.kind == 3 -> if {
                                        entryLeft -> writeIntegerLiteral(context, state)
                                        "" -> println
                                    } else {
                                        (context.sources[entryLeft.sourceModule] -> byte(entryUnaryToken.span.start)) == 116
                                            -> if { "1" -> println } else { "0" -> println }
                                    }
                                } else { "%v$(entryExpression.operand0)" -> println }
                            }
                        } else {
                            context.ir[entryExpression.operand1] => entryRight
                            entryRight.kind == 3 or entryRight.kind == 4
                                -> if {
                                    entryRight -> sourceToken(context, state) => entryRightToken
                                    entryRight.kind == 3 -> if {
                                        entryRight -> writeIntegerLiteral(context, state)
                                        "" -> println
                                    } else {
                                        (context.sources[entryRight.sourceModule] -> byte(entryRightToken.span.start)) == 116
                                            -> if { "1" -> println } else { "0" -> println }
                                    }
                                } else {
                                    entryRightPromoted! -> if { "%v$(entryExpressionIndex)_right_wide" -> println } else { "%v$(entryExpression.operand1)" -> println }
                                }
                        }
                    }
                }
        }
    entryExpression.kind == 6 and entryExpression.opcode == -209 and entryExpression.operand0 >= 0 and entryExpression.operand1 >= 0
        -> if {
            context.ir[entryExpression.operand0] => entryTryParallelSource
            context.ir[entryExpression.operand1] => entryTryParallelBodyCall
            context.types[entryTryParallelBodyCall.typeId] => entryTryParallelCallbackType
            context.typeSizes[entryTryParallelCallbackType.first] => entryTryParallelOkStride
            context.typeSizes[entryTryParallelBodyCall.typeId] => entryTryParallelCallbackStride
            "  %v$(entryExpressionIndex)_input = extractvalue %sollang.array.i32 %v$(entryExpression.operand0), 0" -> println
            "  %v$(entryExpressionIndex)_length = extractvalue %sollang.array.i32 %v$(entryExpression.operand0), 1" -> println
            "  %v$(entryExpressionIndex)_bytes = mul i64 %v$(entryExpressionIndex)_length, " -> print
            entryTryParallelOkStride -> writeDecimalLine
            "  %v$(entryExpressionIndex)_data = call ptr @malloc(i64 %v$(entryExpressionIndex)_bytes)" -> println
            "  %v$(entryExpressionIndex)_callback_bytes = mul i64 %v$(entryExpressionIndex)_length, " -> print
            entryTryParallelCallbackStride -> writeDecimalLine
            "  %v$(entryExpressionIndex)_callback_results = call ptr @malloc(i64 %v$(entryExpressionIndex)_callback_bytes)" -> println
            "  %v$(entryExpressionIndex)_initialized = call ptr @malloc(i64 %v$(entryExpressionIndex)_length)" -> println
            "  call void @llvm.memset.p0.i64(ptr %v$(entryExpressionIndex)_initialized, i8 0, i64 %v$(entryExpressionIndex)_length, i1 false)" -> println
            entryExpressionIndex -> parallelUsesComputePool(context, state)
                -> if {
                    CallEnvironmentRequest { callerIndex: functionIndex, callIndex: entryExpressionIndex, targetModule: entryTryParallelBodyCall.targetModule, targetSymbol: entryTryParallelBodyCall.symbol, hasArgument: true } => entryTryParallelEnvironmentRequest
                    entryTryParallelEnvironmentRequest -> targetFunctionIndex(context, state) => entryTryParallelTargetFunction
                    entryTryParallelTargetFunction -> functionCaptures(context, state) => entryTryParallelCaptures
                    entryTryParallelEnvironmentRequest -> emitCallEnvironmentValues(context, state)
                    "  %v$(entryExpressionIndex)_group = alloca %sollang.compute_group, align 8" -> println
                    "  %v$(entryExpressionIndex)_callback_slot = getelementptr %sollang.compute_group, ptr %v$(entryExpressionIndex)_group, i32 0, i32 0" -> println
                    "  store ptr @sollang_parallel_callback_$(entryExpressionIndex), ptr %v$(entryExpressionIndex)_callback_slot, align 8" -> println
                    "  %v$(entryExpressionIndex)_input_slot = getelementptr %sollang.compute_group, ptr %v$(entryExpressionIndex)_group, i32 0, i32 1" -> println
                    "  store ptr %v$(entryExpressionIndex)_input, ptr %v$(entryExpressionIndex)_input_slot, align 8" -> println
                    "  %v$(entryExpressionIndex)_output_slot = getelementptr %sollang.compute_group, ptr %v$(entryExpressionIndex)_group, i32 0, i32 2" -> println
                    "  store ptr %v$(entryExpressionIndex)_callback_results, ptr %v$(entryExpressionIndex)_output_slot, align 8" -> println
                    "  %v$(entryExpressionIndex)_count_slot = getelementptr %sollang.compute_group, ptr %v$(entryExpressionIndex)_group, i32 0, i32 3" -> println
                    "  store i64 %v$(entryExpressionIndex)_length, ptr %v$(entryExpressionIndex)_count_slot, align 8" -> println
                    entryExpressionIndex -> emitParallelCaptureEnvironment(entryExpression.operand1, functionIndex, entryTryParallelCaptures, context, state) => entryTryParallelHasEnvironment
                    "  %v$(entryExpressionIndex)_capture_slot = getelementptr %sollang.compute_group, ptr %v$(entryExpressionIndex)_group, i32 0, i32 4" -> println
                    entryTryParallelHasEnvironment -> if {
                        "  store ptr %v$(entryExpressionIndex)_capture_environment, ptr %v$(entryExpressionIndex)_capture_slot, align 8" -> println
                    } else {
                        "  store ptr null, ptr %v$(entryExpressionIndex)_capture_slot, align 8" -> println
                    }
                    "  %v$(entryExpressionIndex)_sink_bytes = mul i64 %v$(entryExpressionIndex)_length, 24" -> println
                    "  %v$(entryExpressionIndex)_sinks = call ptr @malloc(i64 %v$(entryExpressionIndex)_sink_bytes)" -> println
                    "  call void @llvm.memset.p0.i64(ptr %v$(entryExpressionIndex)_sinks, i8 0, i64 %v$(entryExpressionIndex)_sink_bytes, i1 false)" -> println
                    "  %v$(entryExpressionIndex)_sinks_slot = getelementptr %sollang.compute_group, ptr %v$(entryExpressionIndex)_group, i32 0, i32 5" -> println
                    "  store ptr %v$(entryExpressionIndex)_sinks, ptr %v$(entryExpressionIndex)_sinks_slot, align 8" -> println
                    6 => entryTryParallelRuntimeFieldIndex!
                    entryTryParallelRuntimeFieldIndex! <= 10 -> while {
                        "  %v$(entryExpressionIndex)_runtime_slot_$(entryTryParallelRuntimeFieldIndex!) = getelementptr %sollang.compute_group, ptr %v$(entryExpressionIndex)_group, i32 0, i32 $(entryTryParallelRuntimeFieldIndex!)" -> println
                        "  store ptr null, ptr %v$(entryExpressionIndex)_runtime_slot_$(entryTryParallelRuntimeFieldIndex!), align 8" -> println
                        entryTryParallelRuntimeFieldIndex! + 1 => entryTryParallelRuntimeFieldIndex!
                    }
                    "  %v$(entryExpressionIndex)_failure_limit_slot = getelementptr %sollang.compute_group, ptr %v$(entryExpressionIndex)_group, i32 0, i32 11" -> println
                    "  store atomic i64 %v$(entryExpressionIndex)_length, ptr %v$(entryExpressionIndex)_failure_limit_slot release, align 8" -> println
                    "  %v$(entryExpressionIndex)_initialized_slot = getelementptr %sollang.compute_group, ptr %v$(entryExpressionIndex)_group, i32 0, i32 12" -> println
                    "  store ptr %v$(entryExpressionIndex)_initialized, ptr %v$(entryExpressionIndex)_initialized_slot, align 8" -> println
                    "  call void @sollang_compute_execute(ptr %v$(entryExpressionIndex)_group)" -> println
                    entryTryParallelSource.kind == 14 -> if {
                        "  call void @free(ptr %v$(entryExpressionIndex)_input)" -> println
                    }
                    TryParallelCollectRequest { expressionIndex: entryExpressionIndex, outerTypeId: entryExpression.typeId, callbackTypeId: entryTryParallelBodyCall.typeId } -> emitTryParallelCollect(context, state)
                }
        }
    entryExpression.kind == 6 and entryExpression.opcode == -207 and entryExpression.operand0 >= 0 and entryExpression.operand1 >= 0
        -> if {
            context.ir[entryExpression.operand0] => entryParallelSource
            context.ir[entryExpression.operand1] => entryParallelBodyCall
            "  %v$(entryExpressionIndex)_input = extractvalue %sollang.array.i32 %v$(entryExpression.operand0), 0" -> println
            "  %v$(entryExpressionIndex)_length = extractvalue %sollang.array.i32 %v$(entryExpression.operand0), 1" -> println
