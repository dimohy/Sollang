                                                    -> if { "%v$(entryExpressionIndex)_slot" -> print } else { "%v$(entryExpressionIndex)_m$(entryCanonicalMemberOrdinal!)_slot" -> print }
                                                ", 0" -> println
                                                "  " -> print
