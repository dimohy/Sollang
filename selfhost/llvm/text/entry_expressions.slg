# Entry-function scheduling and expression responsibilities extracted from emitCore.
# Mutable stream/each arrays stay caller-owned and are borrowed by each work unit.

# Every branching/looping root can contain a visible mutation or effect. Use
# the same control set for reads, effect owners and earlier-effect barriers.
isEntrySchedulingControl node: typedIr.TypedIrNode -> Bool {
    node.kind == 18 or node.kind == 20 or node.kind == 27
        or node.kind == 33 or node.kind == 34
}

emitScheduledMutableSlots functionIndex: Int, entryEnd: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    functionIndex + 1 => entryMutableSlotIndex!
    entryMutableSlotIndex! < entryEnd -> while {
        context.ir[entryMutableSlotIndex!] => entryMutableSlotCandidate
        entryMutableSlotCandidate.kind == 17 and entryMutableSlotCandidate.flags == 1
            -> if {
                entryMutableSlotIndex! -> mutableBindingRoot(context, state) => entryMutableSlotRoot
                entryMutableSlotRoot == entryMutableSlotIndex!
                    -> if {
                        "  %slot$(entryMutableSlotRoot) = alloca " -> print
                        entryMutableSlotCandidate -> writeIrType(context, state)
                        ", align " -> print
                        entryMutableSlotCandidate -> storageAlign(context, state) -> writeDecimalLine
                    }
            }
        entryMutableSlotIndex! + 1 => entryMutableSlotIndex!
    }
}

planEntryExpressionOrder functionIndex: Int, entryEnd: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> BodySchedulePlan {
    [Bool; ~] => entryScheduled!
    functionIndex + 1 => entryScheduleInit!
    entryScheduleInit! < entryEnd -> while {
        entryScheduled! -> push(false)
        entryScheduleInit! + 1 => entryScheduleInit!
    }
    0 => entryPartitionProjectionRoute!
    entryPartitionProjectionRoute! < (context.streamPlan.partitionRoutes -> len)
        -> while {
            context.streamPlan.partitionRoutes[entryPartitionProjectionRoute!] => entryPartitionProjection
            entryPartitionProjection.terminalIr > functionIndex and entryPartitionProjection.terminalIr < entryEnd
                -> if {
                    context.ir[entryPartitionProjection.terminalIr] => entryPartitionTerminal
                    entryPartitionTerminal.operand0 > functionIndex and entryPartitionTerminal.operand0 < entryEnd and context.ir[entryPartitionTerminal.operand0].kind == 13
                        -> if {
                            entryPartitionTerminal.operand0 => entryPartitionProjectionNode!
                            entryPartitionProjectionNode! > functionIndex and entryPartitionProjectionNode! < entryEnd
                                -> while {
                                    true => entryScheduled![entryPartitionProjectionNode! - functionIndex - 1]
                                    context.ir[entryPartitionProjectionNode!].kind == 13
                                        -> if {
                                            context.ir[entryPartitionProjectionNode!].operand0 => entryPartitionProjectionNode!
                                        } else {
                                            -1 => entryPartitionProjectionNode!
                                        }
                                }
                        }
                }
            entryPartitionProjectionRoute! + 1 => entryPartitionProjectionRoute!
        }
    [Int; ~] => entryOrder!
    true => entryCombinedScheduleProgress!
    entryCombinedScheduleProgress! -> while {
        false => entryCombinedScheduleProgress!
        true => entryScheduleProgress!
        entryScheduleProgress! -> while {
            false => entryScheduleProgress!
            -1 => entryPendingEach!
            Int(entryOrder! -> len) - 1 => entryPendingEachOrderIndex!
            entryPendingEachOrderIndex! >= 0 and entryPendingEach! < 0
                -> while {
                    entryOrder![entryPendingEachOrderIndex!] => entryOrderedEachCandidate
                    context.ir[entryOrderedEachCandidate] => entryOrderedEachNode
                    entryOrderedEachNode.kind == 6 and entryOrderedEachNode.opcode == -208
                        -> if {
                            false => entryOrderedEachHasPendingBody!
                            functionIndex + 1 => entryOrderedEachBodySearch!
                            entryOrderedEachBodySearch! < entryEnd and not entryOrderedEachHasPendingBody!
                                -> while {
                                    NodeAncestorRequest { nodeIndex: entryOrderedEachBodySearch!, ownerIndex: entryOrderedEachCandidate } => entryOrderedEachAncestorRequest
                                    entryOrderedEachAncestorRequest -> irDescendsFrom(context, state) => entryOrderedEachInside!
                                    entryOrderedEachCandidate -> plannedStreamPipeline(context, state) => entryOrderedEachPipeline
                                    entryOrderedEachInside! and entryOrderedEachPipeline >= 0 and entryOrderedEachNode.operand0 >= 0
                                        -> if {
                                            NodeAncestorRequest { nodeIndex: entryOrderedEachBodySearch!, ownerIndex: entryOrderedEachNode.operand0 } -> irDescendsFrom(context, state) => entryOrderedEachInsideSource
                                            entryOrderedEachBodySearch! == entryOrderedEachNode.operand0 or entryOrderedEachInsideSource
                                                -> if { false => entryOrderedEachInside! }
                                        }
                                    not entryScheduled![entryOrderedEachBodySearch! - functionIndex - 1] and entryOrderedEachInside!
                                        -> if { true => entryOrderedEachHasPendingBody! }
                                    entryOrderedEachBodySearch! + 1 => entryOrderedEachBodySearch!
                                }
                            entryOrderedEachHasPendingBody! -> if { entryOrderedEachCandidate => entryPendingEach! }
                        }
                    entryPendingEachOrderIndex! - 1 => entryPendingEachOrderIndex!
                }
            functionIndex + 1 => entryScheduleCandidate!
            entryScheduleCandidate! < entryEnd -> while {
                not entryScheduled![entryScheduleCandidate! - functionIndex - 1]
                    -> if {
                        context.ir[entryScheduleCandidate!] => entryScheduleNode
                        entryScheduleNode.parent => entryScheduleAncestor!
                        entryScheduleNode.kind == 19 => entryInsideControlRegion!
                        entryScheduleAncestor! > functionIndex and not entryInsideControlRegion!
                            -> while {
                                context.ir[entryScheduleAncestor!].kind == 19 or context.ir[entryScheduleAncestor!].kind == 20 or context.ir[entryScheduleAncestor!].kind == 33
                                    -> if { true => entryInsideControlRegion! } else { context.ir[entryScheduleAncestor!].parent => entryScheduleAncestor! }
                            }
                        false => entryInsideIfCondition!
                        functionIndex + 1 => entryIfConditionSearch!
                        entryIfConditionSearch! < entryEnd -> while {
                            context.ir[entryIfConditionSearch!] => entryIfConditionCandidate
                            entryIfConditionCandidate.kind == 18 -> if {
                                context.ir[entryIfConditionCandidate.operand0] => entryIfConditionRoot
                                entryIfConditionRoot.kind == 8 and (entryIfConditionRoot.opcode == -25 or entryIfConditionRoot.opcode == -24) or (entryIfConditionRoot.kind == 7 and entryIfConditionRoot.opcode == -26)
                                    -> if {
                                        NodeAncestorRequest { nodeIndex: entryScheduleCandidate!, ownerIndex: entryIfConditionCandidate.operand0 } => entryIfAncestorRequest
                                        entryIfAncestorRequest -> irDescendsFrom(context, state) => entryIfDescends
                                        entryScheduleCandidate! == entryIfConditionCandidate.operand0 or entryIfDescends
                                            -> if {
                                                true => entryInsideIfCondition!
                                            }
                                    }
                            }
                            entryIfConditionSearch! + 1 => entryIfConditionSearch!
                        }
                        entryInsideIfCondition! -> if { true => entryInsideControlRegion! }
                        (entryScheduleCandidate! -> parallelCallbackOwner(context)) >= 0
                            -> if { true => entryInsideControlRegion! }
                        false => entryInsideLogicalValue!
                        entryScheduleNode.parent => entryLogicalValueAncestor!
                        entryLogicalValueAncestor! > functionIndex and not entryInsideLogicalValue!
                            -> while {
                                context.ir[entryLogicalValueAncestor!] => entryLogicalValueAncestorNode
                                entryLogicalValueAncestorNode.kind == 8 and (entryLogicalValueAncestorNode.opcode == -24 or entryLogicalValueAncestorNode.opcode == -25)
                                    -> if {
                                        true => entryInsideLogicalValue!
                                    } else {
                                        entryLogicalValueAncestorNode.parent => entryLogicalValueAncestor!
                                    }
                            }
                        entryScheduleNode.kind == 17 and entryScheduleNode.operand0 > functionIndex and entryScheduleNode.operand0 < entryEnd and not entryInsideControlRegion!
                            -> if {
                                context.ir[entryScheduleNode.operand0].parent => entryBindingScheduleAncestor!
                                entryBindingScheduleAncestor! > functionIndex and not entryInsideControlRegion!
                                    -> while {
                                        context.ir[entryBindingScheduleAncestor!].kind == 19
                                            -> if { true => entryInsideControlRegion! } else { context.ir[entryBindingScheduleAncestor!].parent => entryBindingScheduleAncestor! }
                                    }
                            }
                        entryInsideControlRegion! or entryScheduleNode.kind == 19
                            -> if {
                                true => entryScheduled![entryScheduleCandidate! - functionIndex - 1]
                                true => entryScheduleProgress!
                            }
                        true => entryScheduleReady!
                        entryInsideControlRegion! or entryScheduleNode.kind == 19
                            -> if { false => entryScheduleReady! }
                        entryScheduleReady! -> if {
                            0 => entrySequentialPipelineIndex!
                            entrySequentialPipelineIndex! < (context.streamPlan.pipelines -> len)
                                -> while {
                                    context.streamPlan.pipelines[entrySequentialPipelineIndex!] => entrySequentialPipeline
                                    false => entrySequentialInsideTerminal!
                                    NodeAncestorRequest { nodeIndex: entryScheduleCandidate!, ownerIndex: entrySequentialPipeline.terminalIr } -> irDescendsFrom(context, state) => entrySequentialInsideTerminal!
                                    not entrySequentialInsideTerminal! -> if { entryScheduleCandidate! -> streamPipelineOwnsCallback(entrySequentialPipelineIndex!, context, state) => entrySequentialInsideTerminal! }
                                    entrySequentialInsideTerminal! -> if {
                                        entrySequentialPipeline.stageCount => entrySequentialStageOrdinal!
                                        0 => entrySequentialStageSearch!
                                        entrySequentialStageSearch! < entrySequentialPipeline.stageCount and entrySequentialStageOrdinal! == entrySequentialPipeline.stageCount
                                            -> while {
                                                context.streamPlan.stages[entrySequentialPipeline.stageStart + entrySequentialStageSearch!] => entrySequentialStage
                                                entryScheduleCandidate! != entrySequentialStage.callIr
                                                    -> if {
                                                        NodeAncestorRequest { nodeIndex: entryScheduleCandidate!, ownerIndex: entrySequentialStage.callIr } -> irDescendsFrom(context, state) => entrySequentialInsideStage
                                                        entrySequentialInsideStage -> if { entrySequentialStageSearch! => entrySequentialStageOrdinal! }
                                                    }
                                                entrySequentialStageSearch! + 1 => entrySequentialStageSearch!
                                            }
                                        0 => entrySequentialPriorStage!
                                        entrySequentialPriorStage! < entrySequentialStageOrdinal!
                                            -> while {
                                                context.streamPlan.stages[entrySequentialPipeline.stageStart + entrySequentialPriorStage!] => entrySequentialPrior
                                                entrySequentialPrior.callbackRoot > functionIndex and entrySequentialPrior.callbackRoot < entryEnd and not entryScheduled![entrySequentialPrior.callbackRoot - functionIndex - 1]
                                                    -> if {
                                                        false => entryScheduleReady!
                                                    }
                                                entrySequentialPriorStage! + 1 => entrySequentialPriorStage!
                                            }
                                    }
                                    entrySequentialPipelineIndex! + 1 => entrySequentialPipelineIndex!
                                }
                        }
                        # A runtime stream callback is emitted in the body block opened by
                        # its terminal.  Scheduling any callback node before that terminal
                        # would place uses outside the defining loop and violate SSA
                        # dominance.  Keep the complete callback region behind its owner.
                        entryScheduleReady! -> if {
                            0 => entryCallbackOwnerPipelineIndex!
                            entryCallbackOwnerPipelineIndex! < (context.streamPlan.pipelines -> len)
                                -> while {
                                    context.streamPlan.pipelines[entryCallbackOwnerPipelineIndex!] => entryCallbackOwnerPipeline
                                    false => entryInsideOwnedCallback!
                                    entryCallbackOwnerPipeline.status > 0 and entryCallbackOwnerPipeline.status < 3 and entryCallbackOwnerPipeline.callbackStart >= functionIndex + 1 and entryCallbackOwnerPipeline.callbackEnd < entryEnd and entryScheduleCandidate! >= entryCallbackOwnerPipeline.callbackStart and entryScheduleCandidate! <= entryCallbackOwnerPipeline.callbackEnd
                                        -> if {
                                            NodeAncestorRequest { nodeIndex: entryScheduleCandidate!, ownerIndex: entryCallbackOwnerPipeline.terminalIr } -> irDescendsFrom(context, state) => entryInsideOwnedCallback!
                                            entryInsideOwnedCallback! and entryCallbackOwnerPipeline.source0 >= 0
                                                -> if {
                                                    NodeAncestorRequest { nodeIndex: entryScheduleCandidate!, ownerIndex: entryCallbackOwnerPipeline.source0 } -> irDescendsFrom(context, state) => entryInsideCallbackSource
                                                    entryScheduleCandidate! == entryCallbackOwnerPipeline.source0 or entryInsideCallbackSource
                                                        -> if { false => entryInsideOwnedCallback! }
                                                }
                                        }
                                    entryCallbackOwnerPipeline.stageStart => entryCallbackOwnerStageIndex!
                                    entryCallbackOwnerStageIndex! < entryCallbackOwnerPipeline.stageStart + entryCallbackOwnerPipeline.stageCount and not entryInsideOwnedCallback!
                                        -> while {
                                            context.streamPlan.stages[entryCallbackOwnerStageIndex!] => entryCallbackOwnerStage
                                            entryCallbackOwnerStage.callbackStart >= functionIndex + 1 and entryCallbackOwnerStage.callbackEnd < entryEnd and entryScheduleCandidate! >= entryCallbackOwnerStage.callbackStart and entryScheduleCandidate! <= entryCallbackOwnerStage.callbackEnd
                                                -> if {
                                                    NodeAncestorRequest { nodeIndex: entryScheduleCandidate!, ownerIndex: entryCallbackOwnerStage.callIr } -> irDescendsFrom(context, state) => entryInsideOwnedCallback!
                                                    entryInsideOwnedCallback! and entryCallbackOwnerStage.source0 >= 0
                                                        -> if {
                                                            NodeAncestorRequest { nodeIndex: entryScheduleCandidate!, ownerIndex: entryCallbackOwnerStage.source0 } -> irDescendsFrom(context, state) => entryInsideStageCallbackSource
                                                            entryScheduleCandidate! == entryCallbackOwnerStage.source0 or entryInsideStageCallbackSource
                                                                -> if { false => entryInsideOwnedCallback! }
                                                        }
                                                }
                                            entryCallbackOwnerStageIndex! + 1 => entryCallbackOwnerStageIndex!
                                        }
                                    entryInsideOwnedCallback! and entryCallbackOwnerPipeline.terminalIr > functionIndex and entryCallbackOwnerPipeline.terminalIr < entryEnd and not entryScheduled![entryCallbackOwnerPipeline.terminalIr - functionIndex - 1]
                                        -> if {
                                            false => entryScheduleReady!
                                        }
                                    entryCallbackOwnerPipelineIndex! + 1 => entryCallbackOwnerPipelineIndex!
                                }
                        }
                        false => entryScheduleInsidePendingEach!
                        entryPendingEach! >= 0 -> if {
                            NodeAncestorRequest { nodeIndex: entryScheduleCandidate!, ownerIndex: entryPendingEach! } => entryPendingEachAncestorRequest
                            entryPendingEachAncestorRequest -> irDescendsFrom(context, state) => entryScheduleInsidePendingEach!
                            not entryScheduleInsidePendingEach! -> if {
                                entryPendingEach! -> plannedStreamPipeline(context, state) => pendingStreamPipeline
                                entryScheduleCandidate! -> streamPipelineOwnsCallback(pendingStreamPipeline, context, state) => entryScheduleInsidePendingEach!
                            }
                            not entryScheduleInsidePendingEach! -> if {
                                entryScheduleCandidate! -> plannedPartitionPredicateRoute(context, state) => entryPendingPartitionPredicateRoute
                                entryPendingPartitionPredicateRoute >= 0 -> if {
                                    entryPendingPartitionPredicateRoute -> plannedPartitionJunction(context, state) => entryPendingPartitionJunction
                                    entryPendingPartitionJunction >= 0 and (entryPendingPartitionJunction -> partitionFirstTerminal(context, state)) == entryPendingEach!
                                        -> if { true => entryScheduleInsidePendingEach! }
                                }
                            }
                        }
                        entryScheduleReady! and entryPendingEach! >= 0 and not entryScheduleInsidePendingEach!
                            -> if { false => entryScheduleReady! }
                        entryScheduleReady! and entryScheduleNode.parent > functionIndex
                            -> if {
                                entryScheduleCandidate! => entryEachBranchChild!
                                entryScheduleNode.parent => entryEachScheduleAncestor!
                                entryEachScheduleAncestor! > functionIndex and entryScheduleReady!
                                    -> while {
                                        context.ir[entryEachScheduleAncestor!] => entryEachScheduleOwner
                                        entryEachScheduleOwner.kind == 6 and entryEachScheduleOwner.opcode == -208 and not entryScheduled![entryEachScheduleAncestor! - functionIndex - 1]
                                            -> if {
                                                entryEachBranchChild! != entryEachScheduleOwner.operand0
                                                    -> if { false => entryScheduleReady! }
                                            }
                                        entryEachScheduleAncestor! => entryEachBranchChild!
                                        context.ir[entryEachScheduleAncestor!].parent => entryEachScheduleAncestor!
                                    }
                            }
                        entryScheduleCandidate! -> plannedStreamPipeline(context, state) => entrySchedulePipelineIndex
                        entryScheduleCandidate! -> plannedPartitionPredicateRoute(context, state) => entrySchedulePartitionPredicateRoute
                        entryScheduleReady! and entrySchedulePartitionPredicateRoute >= 0
                            -> if {
                                entrySchedulePartitionPredicateRoute -> plannedPartitionJunction(context, state) => entrySchedulePartitionPredicateJunction
                                entrySchedulePartitionPredicateJunction -> partitionFirstTerminal(context, state) => entrySchedulePartitionFirstTerminal
                                entrySchedulePartitionFirstTerminal > functionIndex and entrySchedulePartitionFirstTerminal < entryEnd and not entryScheduled![entrySchedulePartitionFirstTerminal - functionIndex - 1]
                                    -> if { false => entryScheduleReady! }
                                context.streamPlan.junctions[entrySchedulePartitionPredicateJunction] => entrySchedulePredicateJunction
                                entrySchedulePredicateJunction.routeStart => entrySchedulePriorPredicateRoute!
                                entrySchedulePriorPredicateRoute! < entrySchedulePartitionPredicateRoute
                                    -> while {
                                        context.streamPlan.partitionRoutes[entrySchedulePriorPredicateRoute!] => entrySchedulePriorPredicate
                                        entrySchedulePriorPredicate.predicateIr > functionIndex and entrySchedulePriorPredicate.predicateIr < entryEnd and not entryScheduled![entrySchedulePriorPredicate.predicateIr - functionIndex - 1]
                                            -> if { false => entryScheduleReady! }
                                        entrySchedulePriorPredicateRoute! + 1 => entrySchedulePriorPredicateRoute!
                                    }
                            }
                        entryScheduleCandidate! -> plannedPartitionCallbackRoute(context, state) => entrySchedulePartitionCallbackRoute
                        entryScheduleReady! and entrySchedulePartitionCallbackRoute >= 0
                            -> if {
                                entrySchedulePartitionCallbackRoute -> plannedPartitionJunction(context, state) => entrySchedulePartitionCallbackJunction
                                context.streamPlan.junctions[entrySchedulePartitionCallbackJunction] => entryScheduleCallbackJunction
                                entryScheduleCallbackJunction.routeStart => entryScheduleRequiredPredicateRoute!
                                entryScheduleRequiredPredicateRoute! < entryScheduleCallbackJunction.routeStart + entryScheduleCallbackJunction.routeCount
                                    -> while {
                                        context.streamPlan.partitionRoutes[entryScheduleRequiredPredicateRoute!] => entryScheduleRequiredPredicate
                                        entryScheduleRequiredPredicate.predicateIr > functionIndex and entryScheduleRequiredPredicate.predicateIr < entryEnd and not entryScheduled![entryScheduleRequiredPredicate.predicateIr - functionIndex - 1]
                                            -> if { false => entryScheduleReady! }
                                        entryScheduleRequiredPredicateRoute! + 1 => entryScheduleRequiredPredicateRoute!
                                    }
                            }
                        entryScheduleReady! and entrySchedulePipelineIndex >= 0
                            -> if {
                                context.streamPlan.pipelines[entrySchedulePipelineIndex] => entrySchedulePipeline
                                entrySchedulePipeline.source0 => entryScheduleProducerSource!
                                entryScheduleCandidate! -> plannedPartitionRoute(context, state) => entrySchedulePartitionRoute
                                entrySchedulePartitionRoute >= 0 -> if {
                                    entrySchedulePartitionRoute -> plannedPartitionJunction(context, state) => entrySchedulePartitionJunction
                                    context.streamPlan.junctions[entrySchedulePartitionJunction].source0 => entryScheduleProducerSource!
                                }
                                entryScheduleProducerSource! -> producerValueIndex(context, state) => entryScheduleProducerValue
                                entryScheduleProducerValue > functionIndex and entryScheduleProducerValue < entryEnd and not entryScheduled![entryScheduleProducerValue - functionIndex - 1]
                                    -> if { false => entryScheduleReady! }
                            }
                        entryScheduleReady! and entryScheduleNode.kind != 38 and (entryScheduleCandidate! -> plannedStreamStage(context, state)) < 0 and (entryScheduleCandidate! -> plannedStreamPipeline(context, state)) < 0 and entryScheduleNode.operand0 > functionIndex and entryScheduleNode.operand0 < entryEnd and (entryScheduleNode.kind != 5 or context.ir[entryScheduleNode.operand0].flags % 2 == 0) and not entryScheduled![entryScheduleNode.operand0 - functionIndex - 1]
                            -> if { false => entryScheduleReady! }
                        # Assignment operand0 may be a non-emitting value wrapper.
                        # Wait for the canonical child that the emitter reads, so a
                        # post-control assignment never references a later SSA value.
                        entryScheduleReady! and (entryScheduleNode.kind == 24 or entryScheduleNode.kind == 25) and entryScheduleNode.operand0 > functionIndex
                            -> if {
                                entryScheduleNode.operand0 -> aggregateValueIndex(context, state) => entryScheduleAssignmentValue
                                entryScheduleAssignmentValue > functionIndex
                                    and entryScheduleAssignmentValue < entryEnd
                                    and not entryScheduled![entryScheduleAssignmentValue - functionIndex - 1]
                                    -> if { false => entryScheduleReady! }
                                functionIndex + 1 => entryScheduleAssignmentChildSearch!
                                entryScheduleAssignmentChildSearch! < entryEnd and entryScheduleReady!
                                    -> while {
                                        context.ir[entryScheduleAssignmentChildSearch!].parent == entryScheduleNode.operand0
                                            and not entryScheduled![entryScheduleAssignmentChildSearch! - functionIndex - 1]
                                            -> if { false => entryScheduleReady! }
                                        entryScheduleAssignmentChildSearch! + 1 => entryScheduleAssignmentChildSearch!
                                    }
                            }
                        entryScheduleReady! and entryScheduleNode.kind != 6 and entryScheduleNode.kind != 18 and entryScheduleNode.kind != 20 and entryScheduleNode.kind != 27 and entryScheduleNode.kind != 33 and entryScheduleNode.kind != 34 and entryScheduleNode.operand1 > functionIndex and entryScheduleNode.operand1 < entryEnd and not entryScheduled![entryScheduleNode.operand1 - functionIndex - 1]
                            -> if { false => entryScheduleReady! }
                        entryScheduleReady! and (entryScheduleCandidate! -> plannedStreamStage(context, state)) < 0 and entryScheduleNode.kind == 6 and entryScheduleNode.opcode != -207 and entryScheduleNode.opcode != -208 and entryScheduleNode.opcode != -209 and entryScheduleNode.operand1 > functionIndex and entryScheduleNode.operand1 < entryEnd
                            -> if {
                                entryScheduleNode.operand1 -> aggregateValueIndex(context, state) => entryScheduleAdditionalArgument
                                entryScheduleAdditionalArgument > functionIndex and entryScheduleAdditionalArgument < entryEnd and not entryScheduled![entryScheduleAdditionalArgument - functionIndex - 1]
                                    -> if { false => entryScheduleReady! }
                            }
                        entryScheduleReady!
                            and (entryScheduleCandidate! -> plannedStreamStage(context, state)) < 0
                            and (entryScheduleNode.kind == 9 or entryScheduleNode.kind == 6)
                            and entryScheduleNode.opcode != -207
                            and entryScheduleNode.opcode != -208
                            and entryScheduleNode.opcode != -209
                            and entryScheduleNode.operand0 > functionIndex
                            -> if {
                                entryScheduleNode.operand0 => entryScheduleCallArgument!
                                0 => entryScheduleCallOrdinal!
                                entryScheduleCallArgument! > functionIndex
                                    and entryScheduleCallArgument! < entryEnd
                                    and ((entryScheduleCandidate! -> callTargetParameter(entryScheduleCallOrdinal!, context, state)) >= 0
                                    or context.ir[entryScheduleCallArgument!].parent == entryScheduleCandidate!)
                                    -> while {
                                        not entryScheduled![entryScheduleCallArgument! - functionIndex - 1]
                                            -> if { false => entryScheduleReady! }
                                        entryScheduleCallArgument! -> aggregateValueIndex(context, state) => entryScheduleCallArgumentValue
                                        entryScheduleCallArgumentValue > functionIndex
                                            and entryScheduleCallArgumentValue < entryEnd
                                            and not entryScheduled![entryScheduleCallArgumentValue - functionIndex - 1]
                                            -> if { false => entryScheduleReady! }
                                        context.ir[entryScheduleCallArgument!].nextOperand => entryScheduleCallArgument!
                                        entryScheduleCallOrdinal! + 1 => entryScheduleCallOrdinal!
                                    }
                            }
                        entryScheduleReady! and entryScheduleNode.kind == 6 and entryScheduleNode.parent > functionIndex and entryScheduleNode.parent < entryEnd and context.ir[entryScheduleNode.parent].kind == 39 and context.ir[entryScheduleNode.parent].parent > functionIndex and context.ir[context.ir[entryScheduleNode.parent].parent].kind == 37
                            -> if {
                                context.ir[context.ir[entryScheduleNode.parent].parent].operand0 => entryScheduleBranchArm!
                                -1 => entrySchedulePreviousBranchArm!
                                entryScheduleBranchArm! > functionIndex and entryScheduleBranchArm! < entryEnd and entryScheduleBranchArm! != entryScheduleNode.parent
                                    -> while {
                                        entryScheduleBranchArm! => entrySchedulePreviousBranchArm!
                                        context.ir[entryScheduleBranchArm!].nextOperand => entryScheduleBranchArm!
                                    }
                                entryScheduleBranchArm! == entryScheduleNode.parent and entrySchedulePreviousBranchArm! > functionIndex and not entryScheduled![entrySchedulePreviousBranchArm! - functionIndex - 1]
                                    -> if { false => entryScheduleReady! }
                                entryScheduleCandidate! -> branchStageFlowIndex(context, state) => entryScheduleBranchStageFlow
                                entryScheduleBranchStageFlow > functionIndex and entryScheduleBranchStageFlow < entryEnd and context.ir[entryScheduleBranchStageFlow].kind == 6 and not entryScheduled![entryScheduleBranchStageFlow - functionIndex - 1]
                                    -> if { false => entryScheduleReady! }
                            }
                        entryScheduleNode.parent > functionIndex and entryScheduleNode.parent < entryEnd and (context.ir[entryScheduleNode.parent].kind == 38 or (context.ir[entryScheduleNode.parent].kind == 39 and context.ir[entryScheduleNode.parent].parent > functionIndex and context.ir[context.ir[entryScheduleNode.parent].parent].kind == 38))
                            -> if { false => entryScheduleReady! }
                        entryScheduleReady! and (entryScheduleNode -> typedIr.isConsoleRuntimeCall)
                            -> if {
                                functionIndex + 1 => entrySchedulePrintBindingSearch!
                                entrySchedulePrintBindingSearch! < entryEnd
                                    -> while {
                                        context.ir[entrySchedulePrintBindingSearch!] => entrySchedulePrintBinding
                                        entrySchedulePrintBinding.kind == 17 and entrySchedulePrintBinding.operand0 > functionIndex and entrySchedulePrintBinding.operand0 < entryEnd and (entrySchedulePrintBinding -> sourceStart(context, state)) < (entryScheduleNode -> sourceStart(context, state)) and not entryScheduled![entrySchedulePrintBindingSearch! - functionIndex - 1]
                                            -> if { false => entryScheduleReady! }
                                        entrySchedulePrintBindingSearch! + 1 => entrySchedulePrintBindingSearch!
                                    }
                            }
                        entryScheduleReady! and (entryScheduleNode.kind == 9 or entryScheduleNode.kind == 6) and entryScheduleNode.opcode == -203 and entryScheduleNode.operand1 >= 0 and context.ir[entryScheduleNode.operand1].nextOperand > functionIndex and context.ir[entryScheduleNode.operand1].nextOperand < entryEnd and not entryScheduled![context.ir[entryScheduleNode.operand1].nextOperand - functionIndex - 1]
                            -> if { false => entryScheduleReady! }
                        entryScheduleReady! and ((entryScheduleNode.kind == 9 and (entryScheduleNode.opcode == -204 or entryScheduleNode.opcode == -213 or entryScheduleNode.opcode == -241 or entryScheduleNode.opcode == -242 or entryScheduleNode.opcode == -246 or entryScheduleNode.opcode == -247 or entryScheduleNode.opcode == -252)) or (entryScheduleNode -> typedIr.isSetIntrinsicCall)) and entryScheduleNode.operand1 >= 0
                            -> if {
                                entryScheduleNode.operand1 -> aggregateValueIndex(context, state) => entrySchedulePushValue
                                entrySchedulePushValue > functionIndex and entrySchedulePushValue < entryEnd and not entryScheduled![entrySchedulePushValue - functionIndex - 1]
                                    -> if { false => entryScheduleReady! }
                            }
                        entryScheduleReady! and entryScheduleNode.kind == 26 and entryScheduleNode.operand0 >= 0
                            -> if {
                                entryScheduleNode.operand0 -> aggregateValueIndex(context, state) => entryScheduleEnumPayloadValue
                                entryScheduleEnumPayloadValue > functionIndex and entryScheduleEnumPayloadValue < entryEnd and not entryScheduled![entryScheduleEnumPayloadValue - functionIndex - 1]
                                    -> if { false => entryScheduleReady! }
