                            and context.ir[entryScheduleNode.operand0].flags != 1
                            and entryScheduleNode.parent > functionIndex
                            and entryScheduleNode.parent < entryEnd
                            and (context.ir[entryScheduleNode.parent].kind == 12
                            or context.ir[entryScheduleNode.parent].kind == 14
                            or context.ir[entryScheduleNode.parent].kind == 16
                            or context.ir[entryScheduleNode.parent].kind == 26
                            or context.ir[entryScheduleNode.parent].kind == 35)
                            and entryScheduled![entryScheduleNode.operand0 - functionIndex - 1]
                            -> if {
                                true => entryScheduleReady!
                            }
                        entryScheduleReady! -> if {
                            not entryInsideLogicalValue! -> if { entryOrder! -> push(entryScheduleCandidate!) }
                            true => entryScheduled![entryScheduleCandidate! - functionIndex - 1]
