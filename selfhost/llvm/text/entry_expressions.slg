                                                                "%v$(entryExpressionIndex)_expression$(entryExpressionRootSearch!)" -> print
                                                            }
                                                            entryExpressionRootWidth! == 32 -> if { " to i64" -> println } else { " to i32" -> println }
                                                        }
                                                    entryExpressionRootTypeSymbol! == 1 -> if {
                                                        "  %v$(entryExpressionIndex)_expression$(entryExpressionRootSearch!)_text_ptr = extractvalue %sollang.text " -> print
                                                        entryExpressionRoot.kind == 1 -> if {
                                                            entryExpressionRootStreamValue! >= 0 -> if {
                                                                entryExpressionRootStreamValue! -> writeValue(functionIndex, context, state)
                                                            } else {
                                                                entryExpressionIndex -> writeInterpolationValue(entryExpressionRootSearch!, entryExpressionInterpolation, runtimeArgument.sourceModule, functionIndex, entryExpressionIndex, context, state)
                                                            }
                                                        } else { "%v$(entryExpressionIndex)_expression$(entryExpressionRootSearch!)" -> print }
                                                        ", 0" -> println
                                                        "  %v$(entryExpressionIndex)_expression$(entryExpressionRootSearch!)_text_len = extractvalue %sollang.text " -> print
                                                        entryExpressionRoot.kind == 1 -> if {
                                                            entryExpressionRootStreamValue! >= 0 -> if {
                                                                entryExpressionRootStreamValue! -> writeValue(functionIndex, context, state)
                                                            } else {
                                                                entryExpressionIndex -> writeInterpolationValue(entryExpressionRootSearch!, entryExpressionInterpolation, runtimeArgument.sourceModule, functionIndex, entryExpressionIndex, context, state)
                                                            }
                                                        } else { "%v$(entryExpressionIndex)_expression$(entryExpressionRootSearch!)" -> print }
                                                        ", 1" -> println
                                                        entryExpression.symbol == -116 -> if {
                                                            "  call void @sollang_runtime_eprint(ptr %v$(entryExpressionIndex)_expression$(entryExpressionRootSearch!)_text_ptr, i64 %v$(entryExpressionIndex)_expression$(entryExpressionRootSearch!)_text_len, i1 false)" -> println
                                                        } else {
                                                            "  call void @sollang_runtime_print(ptr %v$(entryExpressionIndex)_expression$(entryExpressionRootSearch!)_text_ptr, i64 %v$(entryExpressionIndex)_expression$(entryExpressionRootSearch!)_text_len, i1 false)" -> println
                                                        }
                                                    } else {
                                                        entryExpressionRootTypeSymbol! == 23 -> if {
                                                            entryExpression.symbol == -116 -> if { "  call void @sollang_runtime_eprint_i1(i1 " -> print } else { "  call void @sollang_runtime_print_i1(i1 " -> print }
                                                        } else {
                                                            entryExpressionRootWidth! == 64
                                                                or (entryExpressionRootWidth! == 32 and not entryExpressionRootSigned)
                                                                -> if {
                                                                    entryExpression.symbol == -116 -> if { "  call void @sollang_runtime_eprint_i64(i64 " -> print } else { "  call void @sollang_runtime_print_i64(i64 " -> print }
                                                                } else {
                                                                    entryExpression.symbol == -116 -> if { "  call void @sollang_runtime_eprint_i32(i32 " -> print } else { "  call void @sollang_runtime_print_i32(i32 " -> print }
                                                                }
                                                        }
                                                        entryExpressionRootTypeSymbol! != 23
                                                            and entryExpressionRootWidth! > 0
                                                            and (entryExpressionRootWidth! < 32
                                                            or (entryExpressionRootWidth! == 32 and not entryExpressionRootSigned))
                                                            and entryExpressionRoot.kind != 0 -> if {
                                                                "%v$(entryExpressionIndex)_expression$(entryExpressionRootSearch!)_print" -> print
                                                            } else {
                                                                entryExpressionRoot.kind == 0 or entryExpressionRoot.kind == 4
                                                                    -> if {
                                                                        entryExpressionRoot.kind == 4 -> if {
                                                                            (context.sources[runtimeArgument.sourceModule] -> byte(entryExpressionRoot.payloadStart)) == 116
                                                                                -> if { "1" -> print } else { "0" -> print }
                                                                        } else { entryExpressionRoot -> writeInterpolationIntegerLiteral(runtimeArgument.sourceModule, context) }
                                                                    } else {
                                                                        entryExpressionRoot.kind == 5
                                                                            and entryExpressionRoot.operand0 >= 0
                                                                            and entryExpressionInterpolation[entryExpressionRoot.operand0].kind == 1
                                                                            -> if {
                                                                                "%v$(entryExpressionIndex)_expression$(entryExpressionRootSearch!)" -> print
                                                                            } else {
                                                                                entryExpressionRoot.kind == 1 -> if {
                                                                                    entryExpressionRootStreamDirect! > 0 -> if {
                                                                                        entryExpressionRootStreamDirect! == 2 -> if { "%stream$(entryExpressionRootStreamTerminalIr!)_inner_item" -> print } else { "%stream$(entryExpressionRootStreamTerminalIr!)_item" -> print }
                                                                                    } else {
                                                                                        entryExpressionRootStreamValue! >= 0 -> if {
                                                                                            entryExpressionRootStreamValue! -> writeValue(functionIndex, context, state)
                                                                                        } else {
                                                                                            entryExpressionIndex -> writeInterpolationValue(entryExpressionRootSearch!, entryExpressionInterpolation, runtimeArgument.sourceModule, functionIndex, entryExpressionIndex, context, state)
                                                                                        }
                                                                                    }
                                                                                } else { "%v$(entryExpressionIndex)_expression$(entryExpressionRootSearch!)" -> print }
                                                                            }
                                                                    }
                                                            }
                                                        entryExpressionRootWidth! == 64
                                                            or (entryExpressionRootWidth! == 32 and not entryExpressionRootSigned)
                                                            -> if {
                                                                ", i1 " -> print
                                                                entryExpressionRootTypeSymbol! -> integerSigned(context, state)
                                                                    -> if { "true" -> print } else { "false" -> print }
                                                            }
                                                        ", i1 false)" -> println
                                                    }
                                                    entryExpressionRoot.expressionStart + entryExpressionRoot.expressionLength + 1 => entryExpressionSuffixStart!
                                                    entryExpressionSegment! + 1 => entryExpressionSegment!
                                                }
                                            entryExpressionRootSearch! + 1 => entryExpressionRootSearch!
                                        }
                                    UIntSize(runtimeArgumentLength) - entryExpressionSuffixStart! => entryExpressionSuffixLength
                                    "  %v$(entryExpressionIndex)_expression_suffix = getelementptr i8, ptr @sollang_str_$(entryRuntimeArgumentIndex!), i64 $(entryExpressionSuffixStart!)" -> println
                                    entryExpression.symbol == -116 -> if { "  call void @sollang_runtime_eprint(ptr %v$(entryExpressionIndex)_expression_suffix, i64 $entryExpressionSuffixLength, i1 " -> print } else {
                                        "  call void @sollang_runtime_print(ptr %v$(entryExpressionIndex)_expression_suffix, i64 $entryExpressionSuffixLength, i1 " -> print
                                    }
                                } else {
                                    runtimeArgumentToken.span.start + 1 => interpolationContentStart
                                    runtimeArgumentToken.span.start + runtimeArgumentToken.span.length - 1 => interpolationContentEnd
                                    UIntSize(interpolationContentStart) => interpolationSegmentStart!
                                    0 => interpolationPartIndex!
                                    false => emittedInterpolation!
                                    true => interpolationSegmentsRemain!
                                    interpolationSegmentsRemain! -> while {
                                        interpolationSegmentStart! => interpolationDollar!
                                        -1 => interpolationBindingIr!
                                        interpolationSegmentStart! => interpolationMatchStart!
                                        interpolationSegmentStart! => interpolationNameEnd!
                                        interpolationDollar! < interpolationContentEnd and interpolationBindingIr! < 0
                                            -> while {
                                                (context.sources[runtimeArgument.sourceModule] -> byte(interpolationDollar!)) == 36 and interpolationDollar! + 1 < interpolationContentEnd
                                                    -> if {
                                                        interpolationDollar! + 1 => interpolationNameStart
                                                        interpolationNameStart => interpolationNameEnd!
                                                        true => interpolationNameContinues!
                                                        interpolationNameEnd! < interpolationContentEnd and interpolationNameContinues!
                                                            -> while {
                                                                context.sources[runtimeArgument.sourceModule] -> byte(interpolationNameEnd!) => interpolationNameByte
                                                                (interpolationNameByte >= 48 and interpolationNameByte <= 57) or (interpolationNameByte >= 65 and interpolationNameByte <= 90) or (interpolationNameByte >= 97 and interpolationNameByte <= 122) or interpolationNameByte == 95
                                                                    -> if {
                                                                        interpolationNameEnd! + 1 => interpolationNameEnd!
                                                                    } else { false => interpolationNameContinues! }
                                                            }
                                                        interpolationNameEnd! > interpolationNameStart
                                                            -> if {
                                                                context.ranges[runtimeArgument.sourceModule] => interpolationRange
                                                                0 => interpolationSymbolIndex!
                                                                interpolationSymbolIndex! < interpolationRange.symbolCount
                                                                    -> while {
                                                                        context.symbols[interpolationRange.symbolStart + interpolationSymbolIndex!] => interpolationSymbol
                                                                        interpolationSymbol.kind == 9 -> if {
                                                                            context.tokens[interpolationRange.tokenStart + interpolationSymbol.nameToken] => interpolationSymbolToken
                                                                            interpolationSymbolToken.span.length == interpolationNameEnd! - interpolationNameStart => interpolationNameEqual!
                                                                            UIntSize(0) => interpolationNameByteIndex!
                                                                            interpolationNameEqual! and interpolationNameByteIndex! < interpolationSymbolToken.span.length
                                                                                -> while {
                                                                                    (context.sources[runtimeArgument.sourceModule] -> byte(interpolationNameStart + interpolationNameByteIndex!)) != (context.sources[runtimeArgument.sourceModule] -> byte(interpolationSymbolToken.span.start + interpolationNameByteIndex!))
                                                                                        -> if { false => interpolationNameEqual! }
                                                                                    interpolationNameByteIndex! + 1 => interpolationNameByteIndex!
                                                                                }
                                                                            interpolationNameEqual! -> if {
                                                                                functionIndex + 1 => interpolationBindingSearch!
                                                                                interpolationBindingSearch! < entryEnd -> while {
                                                                                    context.ir[interpolationBindingSearch!].kind == 17 and context.ir[interpolationBindingSearch!].symbol == interpolationSymbolIndex! and context.ir[interpolationBindingSearch!].typeSymbol == 2
                                                                                        -> if {
                                                                                            interpolationBindingSearch! => interpolationBindingIr!
                                                                                            interpolationDollar! => interpolationMatchStart!
                                                                                        }
                                                                                    interpolationBindingSearch! + 1 => interpolationBindingSearch!
                                                                                }
                                                                            }
                                                                        }
                                                                        interpolationSymbolIndex! + 1 => interpolationSymbolIndex!
                                                                    }
                                                            }
                                                    }
                                                interpolationBindingIr! < 0 -> if { interpolationDollar! + 1 => interpolationDollar! }
                                            }
                                        interpolationBindingIr! >= 0 -> if {
                                            Int(interpolationSegmentStart! - interpolationContentStart) => interpolationPartOffset
                                            Int(interpolationMatchStart! - interpolationSegmentStart!) => interpolationPartLength
                                            "  %v$(entryExpressionIndex)_interpolation_part$(interpolationPartIndex!) = getelementptr i8, ptr @sollang_str_$(entryRuntimeArgumentIndex!), i64 $interpolationPartOffset" -> println
                                            entryExpression.symbol == -116 -> if {
                                                "  call void @sollang_runtime_eprint(ptr %v$(entryExpressionIndex)_interpolation_part$(interpolationPartIndex!), i64 $interpolationPartLength, i1 false)" -> println
                                            } else {
                                                "  call void @sollang_runtime_print(ptr %v$(entryExpressionIndex)_interpolation_part$(interpolationPartIndex!), i64 $interpolationPartLength, i1 false)" -> println
                                            }
                                            context.ir[interpolationBindingIr!] => interpolationBinding
                                            context.ir[interpolationBinding.operand0] => interpolationValue
                                            entryExpression.symbol == -116 -> if { "  call void @sollang_runtime_eprint_i32(i32 " -> print } else { "  call void @sollang_runtime_print_i32(i32 " -> print }
                                            interpolationValue.kind == 3 -> if {
                                                interpolationValue -> writeIntegerLiteral(context, state)
                                            } else { "%v$(interpolationBinding.operand0)" -> print }
                                            ", i1 false)" -> println
                                            interpolationNameEnd! => interpolationSegmentStart!
                                            interpolationPartIndex! + 1 => interpolationPartIndex!
                                            true => emittedInterpolation!
                                        } else { false => interpolationSegmentsRemain! }
                                    }
                                    emittedInterpolation! -> if {
                                        Int(interpolationSegmentStart! - interpolationContentStart) => interpolationSuffixOffset
                                        Int(interpolationContentEnd - interpolationSegmentStart!) => interpolationSuffixLength
                                        "  %v$(entryExpressionIndex)_interpolation_suffix = getelementptr i8, ptr @sollang_str_$(entryRuntimeArgumentIndex!), i64 $interpolationSuffixOffset" -> println
                                        entryExpression.symbol == -116 -> if { "  call void @sollang_runtime_eprint(ptr %v$(entryExpressionIndex)_interpolation_suffix, i64 $interpolationSuffixLength, i1 " -> print } else {
                                            "  call void @sollang_runtime_print(ptr %v$(entryExpressionIndex)_interpolation_suffix, i64 $interpolationSuffixLength, i1 " -> print
                                        }
                                    } else {
                                        entryExpression.symbol == -116 -> if { "  call void @sollang_runtime_eprint(ptr @sollang_str_$(entryRuntimeArgumentIndex!), i64 $runtimeArgumentLength, i1 " -> print } else {
                                            "  call void @sollang_runtime_print(ptr @sollang_str_$(entryRuntimeArgumentIndex!), i64 $runtimeArgumentLength, i1 " -> print
                                        }
                                    }
                                }
                            } else {
                                entryExpression.opcode == -203 -> if {
                                    "  %v$(entryExpressionIndex)_runtime_ptr = extractvalue %sollang.text %v$(entryExpressionIndex), 0" -> println
                                    "  %v$(entryExpressionIndex)_runtime_len = extractvalue %sollang.text %v$(entryExpressionIndex), 1" -> println
                                } else {
                                    "  %v$(entryExpressionIndex)_runtime_ptr = extractvalue %sollang.text %v$(entryRuntimeArgumentIndex!), 0" -> println
                                    "  %v$(entryExpressionIndex)_runtime_len = extractvalue %sollang.text %v$(entryRuntimeArgumentIndex!), 1" -> println
                                }
                                entryExpression.symbol == -116 -> if { "  call void @sollang_runtime_eprint(ptr %v$(entryExpressionIndex)_runtime_ptr, i64 %v$(entryExpressionIndex)_runtime_len, i1 " -> print } else {
                                    "  call void @sollang_runtime_print(ptr %v$(entryExpressionIndex)_runtime_ptr, i64 %v$(entryExpressionIndex)_runtime_len, i1 " -> print
                                }
                            }
                            entryExpression.symbol == -102 or entryExpression.symbol == -116
                                -> if { "true)" -> println } else { "false)" -> println }
                        }
                } else {
                    entryExpression -> typedIr.isBuiltinIntegerConversionCall
                        -> if {
                            entryExpression.operand0 -> aggregateValueIndex(context, state) => entryIntegerArgumentIndex
                            context.ir[entryIntegerArgumentIndex] => entryIntegerArgument
                            entryExpression -> integerNodeWidth(context, state) => entryTargetWidth
                            entryIntegerArgument -> integerNodeWidth(context, state) => entryInputWidth
                            "  %v$(entryExpressionIndex) = " -> print
                            entryIntegerArgument.kind == 3 -> if {
                                "add " -> print
                                entryExpression -> writeIrType(context, state)
                                " " -> print
                                entryIntegerArgument -> writeIntegerLiteral(context, state)
                                ", 0" -> println
                            } else {
                                entryIntegerArgument.typeSymbol == 19 or entryIntegerArgument.typeSymbol == 20 or entryIntegerArgument.typeSymbol == 21 or entryIntegerArgument.typeSymbol == 22
                                    -> if {
                                        "fptosi " -> print
                                    } else {
                                        entryTargetWidth < entryInputWidth -> if { "trunc " -> print } else {
                                            entryTargetWidth > entryInputWidth -> if {
                                                entryIntegerArgument -> integerNodeSigned(context, state)
                                                    -> if { "sext " -> print } else { "zext " -> print }
                                            } else { "add " -> print }
                                        }
                                    }
                                entryIntegerArgument -> writeIrType(context, state)
                                " " -> print
                                entryIntegerArgument.kind == 3 -> if {
                                    entryIntegerArgument -> sourceToken(context, state) => entryIntegerToken
                                    entryIntegerArgument -> writeIntegerLiteral(context, state)
                                } else { "%v$(entryIntegerArgumentIndex)" -> print }
                                entryTargetWidth == entryInputWidth -> if { ", 0" -> println } else {
                                    " to " -> print
                                    entryExpression -> writeIrType(context, state)
                                    "" -> println
                                }
                            }
                        } else {
                            entryExpressionIndex -> isNativePathStyleCall(context, state)
                                -> if {
                                    entryExpressionIndex -> emitNativePathStyleValue(context, state)
                                } else {
                                    entryExpressionIndex -> emitNativeTargetLoad(entryExpression, context, state)
                                    CallEnvironmentRequest { callerIndex: functionIndex, callIndex: entryExpressionIndex, targetModule: entryExpression.targetModule, targetSymbol: entryExpression.symbol, hasArgument: entryExpression.operand0 >= 0 } -> emitCallEnvironmentValues(context, state)
                                    entryExpressionIndex -> emitNativeCallValues(functionIndex, context, state)
                                    entryExpression.operand0 -> emitCallIntegerArgumentPromotions(entryExpressionIndex, functionIndex, 0, context, state)
                                    entryExpressionIndex -> writeCallResultPrefix(context, state)
                                    entryExpressionIndex -> isRangeDeferCall(context, state)
                                        -> if {
                                            " @sollang_range_stream_create(" -> print
                                        } else {
                                            entryExpressionIndex -> isMouseEventsCall(context, state)
                                                -> if { " @sollang_mouse_event_stream_make(" -> print } else { entryExpressionIndex -> writeResolvedCallTarget(entryExpression, context, state) }
                                        }
                                    entryExpressionIndex -> emitCallArguments(functionIndex, context, state)
                                    ")" -> println
                                    entryExpressionIndex -> emitCallResultFinish(context, state)
                                    entryExpressionIndex -> emitCompletedPatternBindingTransferMarks(context, state)
                                }
                        }
                }
        }
    activeStreamSize
}

emitEntryTerminalExpression entryExpressionIndex: Int, functionIndex: Int, entryEnd: Int, entryOrder: ref [Int; ~], entryActiveStreams: mut [Int; ~], entryStreamCurrentValues: mut [Int; ~], entryStreamStops: mut [Int; ~], activeStreamSize: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int uses Console {
    context.ir[entryExpressionIndex] => entryExpression
    entryExpression.kind == 18 -> if {
        context.ir[entryExpression.operand0] => entryIfCondition
        entryExpressionIndex -> irValueUsed(functionIndex, context, state) => entryIfValueUsed
        (entryIfCondition.kind == 8 and (entryIfCondition.opcode == -25 or entryIfCondition.opcode == -24) or (entryIfCondition.kind == 7 and entryIfCondition.opcode == -26)) => entryIfShortCircuit
        entryIfShortCircuit -> if {
            WhileBranchRequest { whileIndex: entryExpressionIndex, ownerIndex: functionIndex, conditionIndex: entryExpression.operand0 } -> emitWhileBranch(entryOrder, context, state)
            "while$(entryExpressionIndex)_body:" -> println
            entryExpression -> writeIfShortCircuitBodyTarget(entryExpressionIndex)
            "while$(entryExpressionIndex)_exit:" -> println
            entryExpression -> writeIfShortCircuitExitTarget(entryExpressionIndex)
        } else {
            "  br i1 " -> print
            entryIfCondition.kind == 4 -> if {
                entryIfCondition -> sourceToken(context, state) => entryIfConditionToken
                (context.sources[entryIfCondition.sourceModule] -> byte(entryIfConditionToken.span.start)) == 116
                    -> if { "1" -> print } else { "0" -> print }
            } else { "%v$(entryExpression.operand0)" -> print }
            entryExpression -> writeIfDirectBranchTargets(entryExpressionIndex)
        }
        "if$(entryExpressionIndex)_then:" -> println
        entryExpression.operand1 -> emitRegion(entryOrder, context, state)
        entryIfValueUsed and not (entryExpression.typeOrigin == 1 and entryExpression.typeSymbol == 0) and entryExpression.nextOperand >= 0
            -> if {
                entryExpression.operand1 -> regionResultValueIndex(context, state) => entryThenStoreIndex
                entryExpression -> emitIfResultStore(entryThenStoreIndex, functionIndex, entryExpressionIndex, 0, context, state)
            }
        OwnedDropRequest { regionIndex: entryExpression.operand1, beforeAst: -1, edgeIndex: entryExpressionIndex * 10 + 1, transferredSymbol: -1 } -> emitOwnedDrops([Int; ~], context, state)
        "  br label %if$(entryExpressionIndex)_merge" -> println
        entryExpression.nextOperand >= 0 -> if {
            "if$(entryExpressionIndex)_else:" -> println
            entryExpression.nextOperand -> emitRegion(entryOrder, context, state)
            entryIfValueUsed and not (entryExpression.typeOrigin == 1 and entryExpression.typeSymbol == 0)
                -> if {
                    entryExpression.nextOperand -> regionResultValueIndex(context, state) => entryElseStoreIndex
                    entryExpression -> emitIfResultStore(entryElseStoreIndex, functionIndex, entryExpressionIndex, 1, context, state)
                }
            OwnedDropRequest { regionIndex: entryExpression.nextOperand, beforeAst: -1, edgeIndex: entryExpressionIndex * 10 + 2, transferredSymbol: -1 } -> emitOwnedDrops([Int; ~], context, state)
            "  br label %if$(entryExpressionIndex)_merge" -> println
        }
        "if$(entryExpressionIndex)_merge:" -> println
        entryIfValueUsed and not (entryExpression.typeOrigin == 1 and entryExpression.typeSymbol == 0) and entryExpression.nextOperand >= 0
            -> if {
                "  %v$(entryExpressionIndex) = load " -> print
                entryExpression -> writeIrType(context, state)
                ", ptr %if$(entryExpressionIndex)_result, align " -> print
                entryExpression -> storageAlign(context, state) -> writeDecimalLine
            }
    }
    entryExpression.kind == 33 -> if { entryExpressionIndex -> emitBooleanWhen(entryOrder, context, state) }
    entryExpression.kind == 20 -> if {
        "  br label %while$(entryExpressionIndex)_header" -> println
        "while$(entryExpressionIndex)_header:" -> println
        WhileBranchRequest { whileIndex: entryExpressionIndex, ownerIndex: functionIndex, conditionIndex: entryExpression.operand0 } -> emitWhileBranch(entryOrder, context, state)
        "while$(entryExpressionIndex)_body:" -> println
        entryExpression.operand1 -> emitRegion(entryOrder, context, state)
        OwnedDropRequest { regionIndex: entryExpression.operand1, beforeAst: -1, edgeIndex: entryExpressionIndex * 10 + 3, transferredSymbol: -1 } -> emitOwnedDrops([Int; ~], context, state)
        "  br label %while$(entryExpressionIndex)_header" -> println
        "while$(entryExpressionIndex)_exit:" -> println
    }
    entryExpressionIndex -> plannedPartitionPredicateRoute(context, state) => entryCompletedPartitionPredicateRoute
    entryCompletedPartitionPredicateRoute >= 0 and context.streamPlan.partitionRoutes[entryCompletedPartitionPredicateRoute].predicateIr == entryExpressionIndex
        -> if {
            entryCompletedPartitionPredicateRoute -> plannedPartitionJunction(context, state) => entryCompletedPartitionPredicateJunction
            context.streamPlan.junctions[entryCompletedPartitionPredicateJunction] => entryCompletedPartition
            context.streamPlan.partitionRoutes[entryCompletedPartitionPredicateRoute] => entryCompletedPartitionRoute
            entryCompletedPartitionPredicateRoute + 1 => entryCompletedPartitionNextRoute
            "  br i1 " -> print
            entryExpression.kind == 4 -> if {
                entryExpression -> sourceToken(context, state) => entryPartitionPredicateToken
                (context.sources[entryExpression.sourceModule] -> byte(entryPartitionPredicateToken.span.start)) == 116
                    -> if { "1" -> print } else { "0" -> print }
            } else { "%v$(entryExpressionIndex)" -> print }
            ", label %partition$(entryCompletedPartition.junctionIr)_route$(entryCompletedPartitionRoute.ordinal), label %partition$(entryCompletedPartition.junctionIr)_" -> print
            context.streamPlan.partitionRoutes[entryCompletedPartitionNextRoute].predicateIr >= 0
                -> if { "test$(context.streamPlan.partitionRoutes[entryCompletedPartitionNextRoute].ordinal)" -> println } else { "route$(context.streamPlan.partitionRoutes[entryCompletedPartitionNextRoute].ordinal)" -> println }
            context.streamPlan.partitionRoutes[entryCompletedPartitionNextRoute].predicateIr >= 0
                -> if {
                    "partition$(entryCompletedPartition.junctionIr)_test$(context.streamPlan.partitionRoutes[entryCompletedPartitionNextRoute].ordinal):" -> println
                } else {
                    context.streamPlan.partitionRoutes[entryCompletedPartition.routeStart] => entryCompletedPartitionFirstRoute
                    "partition$(entryCompletedPartition.junctionIr)_route$(entryCompletedPartitionFirstRoute.ordinal):" -> println
                }
        }
    entryExpression.kind == 30 and activeStreamSize > 0
        -> if {
            1 => entryStreamStops[activeStreamSize - 1]
        }
    0 => entryStreamBoundaryActiveIndex!
    entryStreamBoundaryActiveIndex! < activeStreamSize
        -> while {
            entryActiveStreams[entryStreamBoundaryActiveIndex!] => entryBoundaryPipelineIndex
            context.streamPlan.pipelines[entryBoundaryPipelineIndex] => entryBoundaryPipeline
            entryBoundaryPipeline.stageStart => entryBoundaryStageIndex!
            entryBoundaryStageIndex! < entryBoundaryPipeline.stageStart + entryBoundaryPipeline.stageCount
                -> while {
                    context.streamPlan.stages[entryBoundaryStageIndex!] => entryBoundaryStage
                    entryBoundaryStage.callbackRoot == entryExpressionIndex
                        -> if {
                            context.ir[entryBoundaryStage.callIr] => entryBoundaryStageCall
                            entryBoundaryStage.flags == 4 or entryBoundaryStage.flags == 5
                                -> if {
                                    false => entryBoundaryEmitFlatMapBody!
                                    entryBoundaryStage.flags == 4 -> if {
                                        "  br label %stream$(entryBoundaryPipeline.terminalIr)_inner_init" -> println
                                        false => entryBoundaryHasAfterEach!
                                        entryBoundaryPipeline.stageStart => entryBoundaryAfterSearch!
                                        entryBoundaryAfterSearch! < entryBoundaryPipeline.stageStart + entryBoundaryPipeline.stageCount
                                            -> while {
                                                context.streamPlan.stages[entryBoundaryAfterSearch!] => entryBoundaryAfterCandidate
                                                entryBoundaryAfterCandidate.flags == 5 and entryBoundaryAfterCandidate.callbackRoot >= 0
                                                    -> if { true => entryBoundaryHasAfterEach! }
                                                entryBoundaryAfterSearch! + 1 => entryBoundaryAfterSearch!
                                            }
                                        entryBoundaryHasAfterEach! -> if {
                                            "stream$(entryBoundaryPipeline.terminalIr)_after_each:" -> println
                                        } else {
                                            "stream$(entryBoundaryPipeline.terminalIr)_inner_body:" -> println
                                            true => entryBoundaryEmitFlatMapBody!
                                        }
                                    } else {
                                        "  br label %stream$(entryBoundaryPipeline.terminalIr)_outer_continue" -> println
                                        "stream$(entryBoundaryPipeline.terminalIr)_inner_body:" -> println
                                        true => entryBoundaryEmitFlatMapBody!
                                    }
                                    entryBoundaryEmitFlatMapBody! -> if {
                                        -1 => entryBoundaryFlatMapStageIndex!
                                        entryBoundaryPipeline.stageStart => entryBoundaryFlatMapSearch!
                                        entryBoundaryFlatMapSearch! < entryBoundaryPipeline.stageStart + entryBoundaryPipeline.stageCount
                                            -> while {
                                                context.streamPlan.stages[entryBoundaryFlatMapSearch!].flags == 3
                                                    -> if { entryBoundaryFlatMapSearch! => entryBoundaryFlatMapStageIndex! }
                                                entryBoundaryFlatMapSearch! + 1 => entryBoundaryFlatMapSearch!
                                            }
                                        entryBoundaryFlatMapStageIndex! >= 0 -> if {
                                            context.streamPlan.stages[entryBoundaryFlatMapStageIndex!] => entryBoundaryFlatMapStage
                                            context.ir[entryBoundaryFlatMapStage.callIr] => entryBoundaryFlatMapCall
                                            context.ranges[entryBoundaryFlatMapCall.sourceModule] => entryBoundaryFlatMapRange
                                            -1 => entryBoundaryFlatMapScope!
                                            0 => entryBoundaryFlatMapScopeSearch!
                                            entryBoundaryFlatMapScopeSearch! < entryBoundaryFlatMapRange.symbolCount
                                                -> while {
                                                    context.symbols[entryBoundaryFlatMapRange.symbolStart + entryBoundaryFlatMapScopeSearch!] => entryBoundaryFlatMapScopeCandidate
                                                    entryBoundaryFlatMapScopeCandidate.kind == 48 and entryBoundaryFlatMapScopeCandidate.astNode == entryBoundaryFlatMapCall.astNode
                                                        -> if { entryBoundaryFlatMapScopeSearch! => entryBoundaryFlatMapScope! }
                                                    entryBoundaryFlatMapScopeSearch! + 1 => entryBoundaryFlatMapScopeSearch!
                                                }
                                            0 => entryBoundaryFlatMapRoleOrdinal!
                                            0 => entryBoundaryFlatMapRoleSearch!
                                            entryBoundaryFlatMapRoleSearch! < entryBoundaryFlatMapRange.symbolCount
                                                -> while {
                                                    context.symbols[entryBoundaryFlatMapRange.symbolStart + entryBoundaryFlatMapRoleSearch!] => entryBoundaryFlatMapRole
                                                    entryBoundaryFlatMapRole.kind == 35 and entryBoundaryFlatMapRole.parent == entryBoundaryFlatMapScope!
                                                        -> if {
                                                            functionIndex + 1 => entryBoundaryFlatMapUseSearch!
                                                            entryBoundaryFlatMapUseSearch! < entryEnd -> while {
                                                                context.ir[entryBoundaryFlatMapUseSearch!] => entryBoundaryFlatMapUse
                                                                entryBoundaryFlatMapUse.kind == 5 and entryBoundaryFlatMapUse.symbol == entryBoundaryFlatMapRoleSearch!
                                                                    -> if {
                                                                        "  %v$(entryBoundaryFlatMapUseSearch!) = freeze " -> print
                                                                        context -> emitterContext.streamStageInputValue(entryBoundaryPipelineIndex, entryBoundaryFlatMapStageIndex!) => entryBoundaryInput
                                                                        entryBoundaryFlatMapRoleOrdinal! != 0 and entryBoundaryInput >= 0
                                                                            -> if {
                                                                                context.ir[entryBoundaryInput] -> writeIrType(context, state)
                                                                            } else { entryBoundaryFlatMapUse -> writeIrType(context, state) }
                                                                        entryBoundaryFlatMapRoleOrdinal! == 0 -> if { " %stream$(entryBoundaryPipeline.terminalIr)_inner_item" -> println } else {
                                                                            entryBoundaryInput >= 0 -> if { " %v$(entryBoundaryInput)" -> println } else { " %stream$(entryBoundaryPipeline.terminalIr)_item" -> println }
                                                                        }
                                                                    }
                                                                entryBoundaryFlatMapUseSearch! + 1 => entryBoundaryFlatMapUseSearch!
                                                            }
                                                            entryBoundaryFlatMapRoleOrdinal! + 1 => entryBoundaryFlatMapRoleOrdinal!
                                                        }
                                                    entryBoundaryFlatMapRoleSearch! + 1 => entryBoundaryFlatMapRoleSearch!
                                                }
                                        }
                                    }
                                } else {
                                    false => entryBoundaryCarriesValue!
                                    entryBoundaryStage.flags == 3 -> if { true => entryBoundaryCarriesValue! }
                                    entryExpression.typeId >= 0 and entryExpression.typeId == entryBoundaryStageCall.typeId
                                        -> if {
                                            entryExpression.typeOrigin != 1 or entryExpression.typeSymbol != 23 or (context -> emitterContext.streamStageEmitsCallback(entryBoundaryStageIndex!))
                                                -> if { true => entryBoundaryCarriesValue! }
                                        }
                                    entryBoundaryCarriesValue! -> if {
                                        entryExpressionIndex => entryStreamCurrentValues[entryStreamBoundaryActiveIndex!]
                                        entryBoundaryStage.argument0 >= 0 -> if {
                                            context.ranges[entryBoundaryStageCall.sourceModule] => entryBoundaryStateRange
                                            -1 => entryBoundaryStateScope!
                                            0 => entryBoundaryStateScopeSearch!
                                            entryBoundaryStateScopeSearch! < entryBoundaryStateRange.symbolCount
                                                -> while {
                                                    context.symbols[entryBoundaryStateRange.symbolStart + entryBoundaryStateScopeSearch!] => entryBoundaryStateScopeCandidate
                                                    entryBoundaryStateScopeCandidate.kind == 48 and entryBoundaryStateScopeCandidate.astNode == entryBoundaryStageCall.astNode
                                                        -> if { entryBoundaryStateScopeSearch! => entryBoundaryStateScope! }
                                                    entryBoundaryStateScopeSearch! + 1 => entryBoundaryStateScopeSearch!
                                                }
                                            0 => entryBoundaryStateRoleCount!
                                            0 => entryBoundaryStateRoleSearch!
                                            entryBoundaryStateRoleSearch! < entryBoundaryStateRange.symbolCount
                                                -> while {
                                                    context.symbols[entryBoundaryStateRange.symbolStart + entryBoundaryStateRoleSearch!] => entryBoundaryStateRoleCandidate
                                                    entryBoundaryStateRoleCandidate.kind == 35 and entryBoundaryStateRoleCandidate.parent == entryBoundaryStateScope!
                                                        -> if { entryBoundaryStateRoleCount! + 1 => entryBoundaryStateRoleCount! }
                                                    entryBoundaryStateRoleSearch! + 1 => entryBoundaryStateRoleSearch!
                                                }
                                            entryBoundaryStateRoleCount! > 1 and entryBoundaryStage.flags != 3
                                                -> if {
                                                    "  store " -> print
                                                    entryBoundaryStageCall -> writeIrType(context, state)
                                                    " %v$(entryExpressionIndex), ptr %stream$(entryBoundaryPipeline.terminalIr)_state$(entryBoundaryStageIndex!), align " -> print
                                                    entryBoundaryStageCall -> storageAlign(context, state) -> writeDecimalLine
                                                }
                                        }
                                    }
                                    entryExpression.typeOrigin == 1 and entryExpression.typeSymbol == 23
                                        and not (context -> emitterContext.streamStageEmitsCallback(entryBoundaryStageIndex!))
                                        -> if {
                                            "  br i1 " -> print
                                            entryExpressionIndex -> writeValue(functionIndex, context, state)
                                            ", label %stream$(entryBoundaryPipeline.terminalIr)_stage$(entryBoundaryStageIndex!)_pass, label %stream$(entryBoundaryPipeline.terminalIr)_continue" -> println
                                            "stream$(entryBoundaryPipeline.terminalIr)_stage$(entryBoundaryStageIndex!)_pass:" -> println
                                        }
                                    entryBoundaryStageIndex! + 1 => entryNextStreamStageIndex!
                                    entryNextStreamStageIndex! < entryBoundaryPipeline.stageStart + entryBoundaryPipeline.stageCount and context.streamPlan.stages[entryNextStreamStageIndex!].callbackRoot < 0
                                        -> while {
                                            context.streamPlan.stages[entryNextStreamStageIndex!] => entryStateOnlyStage
                                            entryStateOnlyStage.flags == 1 -> if {
                                                "  %stream$(entryBoundaryPipeline.terminalIr)_taken$(entryNextStreamStageIndex!) = load i32, ptr %stream$(entryBoundaryPipeline.terminalIr)_slice$(entryNextStreamStageIndex!)_slot, align 4" -> println
                                                "  %stream$(entryBoundaryPipeline.terminalIr)_take_open$(entryNextStreamStageIndex!) = icmp slt i32 %stream$(entryBoundaryPipeline.terminalIr)_taken$(entryNextStreamStageIndex!), " -> print
                                                WhileValueRequest { whileIndex: entryBoundaryPipeline.terminalIr, ownerIndex: functionIndex, nodeIndex: entryStateOnlyStage.argument0 } -> writeWhileValue(context, state)
                                                "" -> println
                                                "  br i1 %stream$(entryBoundaryPipeline.terminalIr)_take_open$(entryNextStreamStageIndex!), label %stream$(entryBoundaryPipeline.terminalIr)_take_pass$(entryNextStreamStageIndex!), label %stream$(entryBoundaryPipeline.terminalIr)_exit" -> println
                                                "stream$(entryBoundaryPipeline.terminalIr)_take_pass$(entryNextStreamStageIndex!):" -> println
                                                "  %stream$(entryBoundaryPipeline.terminalIr)_taken_next$(entryNextStreamStageIndex!) = add i32 %stream$(entryBoundaryPipeline.terminalIr)_taken$(entryNextStreamStageIndex!), 1" -> println
                                                "  store i32 %stream$(entryBoundaryPipeline.terminalIr)_taken_next$(entryNextStreamStageIndex!), ptr %stream$(entryBoundaryPipeline.terminalIr)_slice$(entryNextStreamStageIndex!)_slot, align 4" -> println
                                            }
                                            entryStateOnlyStage.flags == 2 -> if {
                                                "  %stream$(entryBoundaryPipeline.terminalIr)_skipped$(entryNextStreamStageIndex!) = load i32, ptr %stream$(entryBoundaryPipeline.terminalIr)_slice$(entryNextStreamStageIndex!)_slot, align 4" -> println
                                                "  %stream$(entryBoundaryPipeline.terminalIr)_skip_open$(entryNextStreamStageIndex!) = icmp slt i32 %stream$(entryBoundaryPipeline.terminalIr)_skipped$(entryNextStreamStageIndex!), " -> print
                                                WhileValueRequest { whileIndex: entryBoundaryPipeline.terminalIr, ownerIndex: functionIndex, nodeIndex: entryStateOnlyStage.argument0 } -> writeWhileValue(context, state)
                                                "" -> println
                                                "  br i1 %stream$(entryBoundaryPipeline.terminalIr)_skip_open$(entryNextStreamStageIndex!), label %stream$(entryBoundaryPipeline.terminalIr)_skip_drop$(entryNextStreamStageIndex!), label %stream$(entryBoundaryPipeline.terminalIr)_skip_pass$(entryNextStreamStageIndex!)" -> println
                                                "stream$(entryBoundaryPipeline.terminalIr)_skip_drop$(entryNextStreamStageIndex!):" -> println
                                                "  %stream$(entryBoundaryPipeline.terminalIr)_skipped_next$(entryNextStreamStageIndex!) = add i32 %stream$(entryBoundaryPipeline.terminalIr)_skipped$(entryNextStreamStageIndex!), 1" -> println
                                                "  store i32 %stream$(entryBoundaryPipeline.terminalIr)_skipped_next$(entryNextStreamStageIndex!), ptr %stream$(entryBoundaryPipeline.terminalIr)_slice$(entryNextStreamStageIndex!)_slot, align 4" -> println
                                                "  br label %stream$(entryBoundaryPipeline.terminalIr)_continue" -> println
                                                "stream$(entryBoundaryPipeline.terminalIr)_skip_pass$(entryNextStreamStageIndex!):" -> println
                                            }
                                            entryNextStreamStageIndex! + 1 => entryNextStreamStageIndex!
                                        }
                                    entryNextStreamStageIndex! < entryBoundaryPipeline.stageStart + entryBoundaryPipeline.stageCount
                                        -> if {
                                            context.streamPlan.stages[entryNextStreamStageIndex!] => entryNextStreamStage
                                            context.ir[entryNextStreamStage.callIr] => entryNextStreamStageCall
                                            context.ranges[entryNextStreamStageCall.sourceModule] => entryNextStreamStageRange
                                            -1 => entryNextStreamCallScope!
                                            0 => entryNextStreamScopeSearch!
                                            entryNextStreamScopeSearch! < entryNextStreamStageRange.symbolCount
                                                -> while {
                                                    context.symbols[entryNextStreamStageRange.symbolStart + entryNextStreamScopeSearch!] => entryNextStreamScopeCandidate
                                                    entryNextStreamScopeCandidate.kind == 48 and entryNextStreamScopeCandidate.astNode == entryNextStreamStageCall.astNode
                                                        -> if { entryNextStreamScopeSearch! => entryNextStreamCallScope! }
                                                    entryNextStreamScopeSearch! + 1 => entryNextStreamScopeSearch!
                                                }
                                            0 => entryNextStreamRoleCount!
                                            0 => entryNextStreamRoleCountSearch!
                                            entryNextStreamRoleCountSearch! < entryNextStreamStageRange.symbolCount
                                                -> while {
                                                    context.symbols[entryNextStreamStageRange.symbolStart + entryNextStreamRoleCountSearch!] => entryNextStreamRoleCountCandidate
                                                    entryNextStreamRoleCountCandidate.kind == 35 and entryNextStreamRoleCountCandidate.parent == entryNextStreamCallScope!
                                                        -> if { entryNextStreamRoleCount! + 1 => entryNextStreamRoleCount! }
                                                    entryNextStreamRoleCountSearch! + 1 => entryNextStreamRoleCountSearch!
                                                }
                                            0 => entryNextStreamRoleSearch!
                                            entryNextStreamRoleSearch! < entryNextStreamStageRange.symbolCount
                                                -> while {
                                                    context.symbols[entryNextStreamStageRange.symbolStart + entryNextStreamRoleSearch!] => entryNextStreamRole
                                                    entryNextStreamRole.kind == 35 and entryNextStreamRole.parent == entryNextStreamCallScope!
                                                        -> if {
                                                            functionIndex + 1 => entryNextStreamUseSearch!
                                                            entryNextStreamUseSearch! < entryEnd -> while {
                                                                context.ir[entryNextStreamUseSearch!] => entryNextStreamUse
                                                                entryNextStreamUse.kind == 5 and entryNextStreamUse.symbol == entryNextStreamRoleSearch!
                                                                    -> if {
                                                                        entryNextStreamStage.flags == 3 -> if {
                                                                            context -> emitterContext.streamCallbackInput(entryBoundaryPipelineIndex, entryNextStreamStageCall.sourceModule, entryNextStreamRoleSearch!) => nextInput
                                                                            nextInput.valueIr >= 0 -> if {
                                                                                "  %v$(entryNextStreamUseSearch!) = freeze " -> print
                                                                                context.ir[nextInput.valueIr] -> writeIrType(context, state)
                                                                                " " -> print
                                                                                nextInput.valueIr -> writeValue(functionIndex, context, state)
                                                                                "" -> println
                                                                            }
                                                                        }
                                                                        entryNextStreamStage.flags != 3 and entryNextStreamRoleCount! > 1 and entryNextStreamRole.astNode == entryNextStreamStageCall.astNode
                                                                            -> if {
                                                                                "  %v$(entryNextStreamUseSearch!) = load " -> print
                                                                                entryNextStreamUse -> writeIrType(context, state)
                                                                                ", ptr %stream$(entryBoundaryPipeline.terminalIr)_state$(entryNextStreamStageIndex!), align " -> print
                                                                                entryNextStreamUse -> storageAlign(context, state) -> writeDecimalLine
                                                                            } else {
                                                                                entryNextStreamStage.flags != 3 and entryStreamCurrentValues[entryStreamBoundaryActiveIndex!] >= 0
                                                                                    -> if {
                                                                                        "  %v$(entryNextStreamUseSearch!) = freeze " -> print
                                                                                        entryNextStreamUse -> writeIrType(context, state)
                                                                                        " %v" -> print
                                                                                        entryStreamCurrentValues[entryStreamBoundaryActiveIndex!] -> writeDecimalLine
                                                                                    }
                                                                            }
                                                                    }
                                                                entryNextStreamUseSearch! + 1 => entryNextStreamUseSearch!
                                                            }
                                                        }
                                                    entryNextStreamRoleSearch! + 1 => entryNextStreamRoleSearch!
                                                }
                                        } else {
                                            context.ir[entryBoundaryPipeline.terminalIr] => entryTerminalStreamCall
                                            context.ranges[entryTerminalStreamCall.sourceModule] => entryTerminalStreamRange
                                            -1 => entryTerminalStreamRoleSymbol!
                                            0 => entryTerminalStreamRoleSearch!
                                            entryTerminalStreamRoleSearch! < entryTerminalStreamRange.symbolCount
                                                -> while {
                                                    context.symbols[entryTerminalStreamRange.symbolStart + entryTerminalStreamRoleSearch!] => entryTerminalStreamRole
                                                    entryTerminalStreamRole.kind == 35 and entryTerminalStreamRole.astNode == entryTerminalStreamCall.astNode
                                                        -> if { entryTerminalStreamRoleSearch! => entryTerminalStreamRoleSymbol! }
                                                    entryTerminalStreamRoleSearch! + 1 => entryTerminalStreamRoleSearch!
                                                }
                                            functionIndex + 1 => entryTerminalStreamUseSearch!
                                            entryTerminalStreamUseSearch! < entryEnd -> while {
                                                context.ir[entryTerminalStreamUseSearch!] => entryTerminalStreamUse
                                                entryTerminalStreamUse.kind == 5 and entryTerminalStreamUse.symbol == entryTerminalStreamRoleSymbol! and entryStreamCurrentValues[entryStreamBoundaryActiveIndex!] >= 0 and entryTerminalStreamUse.typeSymbol == context.ir[entryStreamCurrentValues[entryStreamBoundaryActiveIndex!]].typeSymbol
                                                    -> if {
                                                        "  %v$(entryTerminalStreamUseSearch!) = freeze " -> print
                                                        entryTerminalStreamUse -> writeIrType(context, state)
                                                        " %v" -> print
                                                        entryStreamCurrentValues[entryStreamBoundaryActiveIndex!] -> writeDecimalLine
                                                    }
                                                entryTerminalStreamUseSearch! + 1 => entryTerminalStreamUseSearch!
                                            }
                                        }
                                }
                        }
                    entryBoundaryStageIndex! + 1 => entryBoundaryStageIndex!
                }
            entryStreamBoundaryActiveIndex! + 1 => entryStreamBoundaryActiveIndex!
        }
    activeStreamSize
}

# Shared ordered body emission for entry and ordinary stream consumers.
emitScheduledStreamBody plan: ref BodySchedulePlan, functionIndex: Int, entryEnd: Int, entryPointerAlignment: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    functionIndex -> emitScheduledMutableSlots(entryEnd, context, state)
    [Int; ~] => entryActiveEach!
    0 => entryActiveEachSize!
    [Int; ~] => entryActiveStreams!
    [Int; ~] => entryStreamCurrentValues!
    [Int; ~] => entryStreamStops!
    0 => entryActiveStreamSize!
    0 => entryOrderIndex!
    entryOrderIndex! < (plan.order -> len) -> while {
        plan.order[entryOrderIndex!] => entryExpressionIndex
        context.ir[entryExpressionIndex] => entryExpression
        entryExpressionIndex -> emitEntryOpeningStreamExpression(functionIndex, entryEnd, entryActiveStreams!, entryStreamCurrentValues!, entryStreamStops!, entryActiveStreamSize!, context, state) => entryActiveStreamSize!
        entryExpressionIndex -> emitEntryControlExpression(functionIndex, plan.order, context, state)
        entryExpressionIndex -> emitEntryValueExpression(functionIndex, entryEnd, entryPointerAlignment, plan.order, entryActiveEach!, entryActiveEachSize!, context, state) => entryActiveEachSize!
        entryExpressionIndex -> emitEntryOperationExpression(functionIndex, entryEnd, plan.order, entryActiveStreams!, entryStreamCurrentValues!, entryActiveStreamSize!, context, state) => entryActiveStreamSize!
        entryExpressionIndex -> emitEntryTerminalExpression(functionIndex, entryEnd, plan.order, entryActiveStreams!, entryStreamCurrentValues!, entryStreamStops!, entryActiveStreamSize!, context, state) => entryActiveStreamSize!
        -1 => entryNextExpressionIndex!
        entryOrderIndex! + 1 < (plan.order -> len) -> if { plan.order[entryOrderIndex! + 1] => entryNextExpressionIndex! }
        true => entryCloseEachProgress!
        entryActiveEachSize! > 0 and entryCloseEachProgress!
            -> while {
                entryActiveEach![entryActiveEachSize! - 1] => entryCloseEachIndex
                false => entryNextInsideEach!
                entryNextExpressionIndex! >= 0 -> if {
                    NodeAncestorRequest { nodeIndex: entryNextExpressionIndex!, ownerIndex: entryCloseEachIndex } => entryCloseEachAncestorRequest
                    entryCloseEachAncestorRequest -> irDescendsFrom(context, state) => entryNextInsideEach!
                }
                entryNextInsideEach! -> if { false => entryCloseEachProgress! } else {
                    entryCloseEachIndex -> emitDirectEachEnd(false, context)
                    entryActiveEachSize! - 1 => entryActiveEachSize!
                }
            }
        true => entryCloseStreamProgress!
        entryActiveStreamSize! > 0 and entryCloseStreamProgress!
            -> while {
                entryActiveStreams![entryActiveStreamSize! - 1] => entryCloseStreamPipelineIndex
                context.streamPlan.pipelines[entryCloseStreamPipelineIndex] => entryCloseStreamPipeline
                false => entryNextInsideStream!
                entryNextExpressionIndex! >= 0 -> if {
                    NodeAncestorRequest { nodeIndex: entryNextExpressionIndex!, ownerIndex: entryCloseStreamPipeline.terminalIr } -> irDescendsFrom(context, state) => entryNextInsideStream!
                    not entryNextInsideStream! -> if { entryNextExpressionIndex! -> streamPipelineOwnsCallback(entryCloseStreamPipelineIndex, context, state) => entryNextInsideStream! }
                    not entryNextInsideStream! -> if {
                        entryCloseStreamPipeline.terminalIr -> plannedPartitionRoute(context, state) => entryCloseCandidatePartitionRoute
                        entryNextExpressionIndex! -> plannedPartitionPredicateRoute(context, state) => entryCloseCandidatePredicateRoute
                        entryCloseCandidatePartitionRoute >= 0 and entryCloseCandidatePredicateRoute >= 0
                            -> if {
                                entryCloseCandidatePartitionRoute -> plannedPartitionJunction(context, state) => entryCloseCandidatePartitionJunction
                                entryCloseCandidatePredicateRoute -> plannedPartitionJunction(context, state) => entryCloseCandidatePredicateJunction
                                entryCloseCandidatePartitionJunction == entryCloseCandidatePredicateJunction and entryCloseStreamPipeline.terminalIr == (entryCloseCandidatePartitionJunction -> partitionFirstTerminal(context, state))
                                    -> if { true => entryNextInsideStream! }
                            }
                    }
                }
                entryNextInsideStream! -> if { false => entryCloseStreamProgress! } else {
                    entryCloseStreamPipeline.terminalIr -> plannedPartitionRoute(context, state) => entryClosePartitionRoute
                    entryClosePartitionRoute >= 0 -> if {
                        entryClosePartitionRoute -> plannedPartitionJunction(context, state) => entryClosePartitionJunction
                        context.streamPlan.junctions[entryClosePartitionJunction] => entryClosePartition
                        entryClosePartitionJunction -> partitionFirstTerminal(context, state) => entryClosePartitionFirstTerminal
                        entryStreamStops![entryActiveStreamSize! - 1] == 1
                            -> if {
                                "  br label %stream$(entryClosePartitionFirstTerminal)_exit" -> println
                            } else {
                                "  br label %stream$(entryClosePartitionFirstTerminal)_continue" -> println
                            }
                        entryCloseStreamPipeline.terminalIr == entryClosePartitionFirstTerminal
                            -> if {
                                "stream$(entryClosePartitionFirstTerminal)_continue:" -> println
                                "  br label %stream$(entryClosePartitionFirstTerminal)_header" -> println
                                "stream$(entryClosePartitionFirstTerminal)_exit:" -> println
                                "  %stream$(entryClosePartitionFirstTerminal)_has_drop = icmp ne ptr %stream$(entryClosePartitionFirstTerminal)_producer_drop, null" -> println
                                "  br i1 %stream$(entryClosePartitionFirstTerminal)_has_drop, label %stream$(entryClosePartitionFirstTerminal)_drop, label %stream$(entryClosePartitionFirstTerminal)_drop_done" -> println
                                "stream$(entryClosePartitionFirstTerminal)_drop:" -> println
                                "  call void %stream$(entryClosePartitionFirstTerminal)_producer_drop(ptr %stream$(entryClosePartitionFirstTerminal)_producer_context)" -> println
                                "  br label %stream$(entryClosePartitionFirstTerminal)_drop_done" -> println
                                "stream$(entryClosePartitionFirstTerminal)_drop_done:" -> println
                                "  br label %partition$(entryClosePartition.junctionIr)_done" -> println
                            }
                        entryClosePartitionRoute == entryClosePartition.routeStart + entryClosePartition.routeCount - 1
                            -> if {
                                "partition$(entryClosePartition.junctionIr)_done:" -> println
                            }
                    } else {
                        -1 => entryCloseTakeStage!
                        -1 => entryCloseFlatMapStage!
                        entryCloseStreamPipeline.stageStart => entryCloseStageSearch!
                        entryCloseStageSearch! < entryCloseStreamPipeline.stageStart + entryCloseStreamPipeline.stageCount
                            -> while {
                                context.streamPlan.stages[entryCloseStageSearch!].flags == 1
                                    -> if { entryCloseStageSearch! => entryCloseTakeStage! }
                                context.streamPlan.stages[entryCloseStageSearch!].flags == 3
                                    -> if { entryCloseStageSearch! => entryCloseFlatMapStage! }
                                entryCloseStageSearch! + 1 => entryCloseStageSearch!
                            }
                        entryStreamStops![entryActiveStreamSize! - 1] == 1
                            -> if {
                                "  br label %stream$(entryCloseStreamPipeline.terminalIr)_exit" -> println
                            } else {
                                "  br label %stream$(entryCloseStreamPipeline.terminalIr)_continue" -> println
                            }
                        "stream$(entryCloseStreamPipeline.terminalIr)_continue:" -> println
                        entryCloseStreamPipeline.status > 0 and entryCloseStreamPipeline.status < 3
                            -> if {
                                "  br label %stream$(entryCloseStreamPipeline.terminalIr)_header" -> println
                            } else {
                                entryCloseFlatMapStage! >= 0 -> if {
                                    "  %stream$(entryCloseStreamPipeline.terminalIr)_inner_current = load i32, ptr %stream$(entryCloseStreamPipeline.terminalIr)_inner_index_slot, align 4" -> println
                                    "  %stream$(entryCloseStreamPipeline.terminalIr)_inner_next = add i32 %stream$(entryCloseStreamPipeline.terminalIr)_inner_current, 1" -> println
                                    "  store i32 %stream$(entryCloseStreamPipeline.terminalIr)_inner_next, ptr %stream$(entryCloseStreamPipeline.terminalIr)_inner_index_slot, align 4" -> println
                                    entryCloseTakeStage! >= 0 -> if {
                                        context.streamPlan.stages[entryCloseTakeStage!] => entryCloseInnerTake
                                        "  %stream$(entryCloseStreamPipeline.terminalIr)_taken_done_value = load i32, ptr %stream$(entryCloseStreamPipeline.terminalIr)_slice$(entryCloseTakeStage!)_slot, align 4" -> println
                                        "  %stream$(entryCloseStreamPipeline.terminalIr)_taken_done = icmp sge i32 %stream$(entryCloseStreamPipeline.terminalIr)_taken_done_value, " -> print
                                        WhileValueRequest { whileIndex: entryCloseStreamPipeline.terminalIr, ownerIndex: functionIndex, nodeIndex: entryCloseInnerTake.argument0 } -> writeWhileValue(context, state)
                                        "" -> println
                                        "  br i1 %stream$(entryCloseStreamPipeline.terminalIr)_taken_done, label %stream$(entryCloseStreamPipeline.terminalIr)_exit, label %stream$(entryCloseStreamPipeline.terminalIr)_inner_header" -> println
                                    } else {
                                        "  br label %stream$(entryCloseStreamPipeline.terminalIr)_inner_header" -> println
                                    }
                                    "stream$(entryCloseStreamPipeline.terminalIr)_inner_exit:" -> println
                                    "  br label %stream$(entryCloseStreamPipeline.terminalIr)_outer_continue" -> println
                                    "stream$(entryCloseStreamPipeline.terminalIr)_outer_continue:" -> println
                                    entryCloseStreamPipeline.status == 3 -> if {
                                        "  br label %stream$(entryCloseStreamPipeline.terminalIr)_exit" -> println
                                    } else {
                                        "  %stream$(entryCloseStreamPipeline.terminalIr)_current = load i32, ptr %stream$(entryCloseStreamPipeline.terminalIr)_index_slot, align 4" -> println
                                        "  %stream$(entryCloseStreamPipeline.terminalIr)_next = add i32 %stream$(entryCloseStreamPipeline.terminalIr)_current, 1" -> println
                                        "  store i32 %stream$(entryCloseStreamPipeline.terminalIr)_next, ptr %stream$(entryCloseStreamPipeline.terminalIr)_index_slot, align 4" -> println
                                        "  br label %stream$(entryCloseStreamPipeline.terminalIr)_header" -> println
                                    }
                                } else {
                                    "  %stream$(entryCloseStreamPipeline.terminalIr)_current = load i32, ptr %stream$(entryCloseStreamPipeline.terminalIr)_index_slot, align 4" -> println
                                    "  %stream$(entryCloseStreamPipeline.terminalIr)_next = add i32 %stream$(entryCloseStreamPipeline.terminalIr)_current, 1" -> println
                                    "  store i32 %stream$(entryCloseStreamPipeline.terminalIr)_next, ptr %stream$(entryCloseStreamPipeline.terminalIr)_index_slot, align 4" -> println
                                    entryCloseTakeStage! >= 0 -> if {
                                        context.streamPlan.stages[entryCloseTakeStage!] => entryCloseTake
                                        "  %stream$(entryCloseStreamPipeline.terminalIr)_taken_done_value = load i32, ptr %stream$(entryCloseStreamPipeline.terminalIr)_slice$(entryCloseTakeStage!)_slot, align 4" -> println
                                        "  %stream$(entryCloseStreamPipeline.terminalIr)_taken_done = icmp sge i32 %stream$(entryCloseStreamPipeline.terminalIr)_taken_done_value, " -> print
                                        WhileValueRequest { whileIndex: entryCloseStreamPipeline.terminalIr, ownerIndex: functionIndex, nodeIndex: entryCloseTake.argument0 } -> writeWhileValue(context, state)
                                        "" -> println
                                        "  br i1 %stream$(entryCloseStreamPipeline.terminalIr)_taken_done, label %stream$(entryCloseStreamPipeline.terminalIr)_exit, label %stream$(entryCloseStreamPipeline.terminalIr)_header" -> println
                                    } else {
                                        "  br label %stream$(entryCloseStreamPipeline.terminalIr)_header" -> println
                                    }
                                }
                            }
                        "stream$(entryCloseStreamPipeline.terminalIr)_exit:" -> println
                        entryCloseStreamPipeline.status > 0 and entryCloseStreamPipeline.status < 3
                            -> if {
                                "  %stream$(entryCloseStreamPipeline.terminalIr)_has_drop = icmp ne ptr %stream$(entryCloseStreamPipeline.terminalIr)_producer_drop, null" -> println
                                "  br i1 %stream$(entryCloseStreamPipeline.terminalIr)_has_drop, label %stream$(entryCloseStreamPipeline.terminalIr)_drop, label %stream$(entryCloseStreamPipeline.terminalIr)_drop_done" -> println
                                "stream$(entryCloseStreamPipeline.terminalIr)_drop:" -> println
                                "  call void %stream$(entryCloseStreamPipeline.terminalIr)_producer_drop(ptr %stream$(entryCloseStreamPipeline.terminalIr)_producer_context)" -> println
                                "  br label %stream$(entryCloseStreamPipeline.terminalIr)_drop_done" -> println
                                "stream$(entryCloseStreamPipeline.terminalIr)_drop_done:" -> println
                            }
                    }
                    entryActiveStreamSize! - 1 => entryActiveStreamSize!
                }
            }
        entryOrderIndex! + 1 => entryOrderIndex!
    }
}
