                                        entryMutableReadBarrierSearch! + 1 => entryMutableReadBarrierSearch!
                                    }
                                }
                            }
                        entryScheduleReady! and ((entryScheduleNode -> isSchedulingValueCapture) or (entryScheduleNode -> typedIr.isConsoleRuntimeCall) or entryScheduleNode.kind == 6 or (entryScheduleNode -> isEntrySchedulingControl) or entryScheduleNode.kind == 24 or entryScheduleNode.kind == 25 or (entryScheduleNode.kind == 17 and entryScheduleNode.flags == 1) or ((entryScheduleNode -> isSchedulingMutationIntrinsic) or (entryScheduleNode.kind == 9 and entryScheduleNode.opcode == -221) or (entryScheduleNode.kind == 9 and entryScheduleNode.opcode == -220) or (entryScheduleNode.kind == 9 and entryScheduleNode.opcode == -205) or (entryScheduleNode.kind == 9 and entryScheduleNode.opcode == -27)))
                            -> if {
                                true => entryRootEffect!
                                entryScheduleCandidate! => entryEffectOrderingIndex!
                                entryScheduleNode.parent => entryEffectAncestor!
                                entryEffectAncestor! > functionIndex and entryRootEffect!
                                    -> while {
                                        # Nested call effects inherit the enclosing call's ordering
                                        # boundary so an earlier statement completes first. The
                                        # enclosing call itself must not become a dependency barrier.
                                        (context.ir[entryEffectAncestor!] -> isSchedulingValueCapture)
                                            or (entryScheduleNode.kind == 6
                                            and ((context.ir[entryEffectAncestor!] -> typedIr.isConsoleRuntimeCall)
                                            or (context.ir[entryEffectAncestor!].kind == 6 and context.ir[entryEffectAncestor!].opcode != -208)))
                                            -> if {
                                                entryEffectAncestor! => entryEffectOrderingIndex!
                                                context.ir[entryEffectAncestor!].parent => entryEffectAncestor!
                                            } else {
                                                (context.ir[entryEffectAncestor!] -> typedIr.isConsoleRuntimeCall) or (context.ir[entryEffectAncestor!].kind == 6 and context.ir[entryEffectAncestor!].opcode != -208) or (context.ir[entryEffectAncestor!] -> isEntrySchedulingControl) or context.ir[entryEffectAncestor!].kind == 24 or context.ir[entryEffectAncestor!].kind == 25 or (context.ir[entryEffectAncestor!].kind == 17 and context.ir[entryEffectAncestor!].flags == 1) or ((context.ir[entryEffectAncestor!] -> isSchedulingMutationIntrinsic) or (context.ir[entryEffectAncestor!].kind == 9 and context.ir[entryEffectAncestor!].opcode == -205))
