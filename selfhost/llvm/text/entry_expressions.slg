                                            }
                                        not entryMutableReadInsideBarrier! and not entryScheduled![entryMutableReadBarrierSearch! - functionIndex - 1] and ((entryMutableReadBarrier -> isEntrySchedulingControl) or entryMutableReadBarrier.kind == 24 or entryMutableReadBarrier.kind == 25 or (entryMutableReadBarrier.kind == 6 and entryMutableReadBarrierMutatesBinding!) or (entryMutableReadBarrier.kind == 17 and entryMutableReadBarrier.flags == 1) or ((entryMutableReadBarrier -> isSchedulingMutationIntrinsic) or (entryMutableReadBarrier.kind == 9 and entryMutableReadBarrier.opcode == -256) or (entryMutableReadBarrier.kind == 9 and entryMutableReadBarrier.opcode == -253)) or (entryMutableReadBarrier.kind == 6 and (entryMutableReadBarrier -> typedIr.isSetMutationCall))) and (entryMutableReadBarrier -> sourceStart(context, state)) < (entryScheduleNode -> sourceStart(context, state))
                                            -> if {
