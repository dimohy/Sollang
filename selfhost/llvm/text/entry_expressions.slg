                                        functionIndex + 1 => entryMutableReadBindingSearch!
                                        entryMutableReadBindingSearch! < entryEnd -> while {
                                            context.ir[entryMutableReadBindingSearch!].kind == 17 and context.ir[entryMutableReadBindingSearch!].symbol == entryScheduleNode.symbol and context.ir[entryMutableReadBindingSearch!].flags == 1
                                                -> if {
                                                    true => entryMutableRead!
