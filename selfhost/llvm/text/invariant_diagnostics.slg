                                                                                            memberOwnerDiagnosticSubjectCanonical.origin => memberOwnerDiagnosticSubjectOrigin!
                                                                                            memberOwnerDiagnosticSubjectCanonical.module => memberOwnerDiagnosticSubjectModule!
                                                                                            memberOwnerDiagnosticSubjectCanonical.symbol => memberOwnerDiagnosticSubjectSymbol!
