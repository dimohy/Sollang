emitIrInvariantDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    context -> invalidValueLayoutType => invalidLayout
    invalidLayout >= 0 -> if {
        context.types[invalidLayout] => invalidType
        invalidType.module >= 0 and invalidType.module < (context.ranges -> len)
            and invalidType.symbol >= 0 -> if {
                context.ranges[invalidType.module] => sourceRange
                context.symbols[sourceRange.symbolStart + invalidType.symbol] => declaration
                context.nodes[sourceRange.astStart + declaration.astNode] => declarationAst
                "; sollang compiler error S058: type has a recursive by-value layout (source $(invalidType.module), byte $(declarationAst.start), length $(declarationAst.length)); use explicit box or heap-backed storage to break the value cycle" -> println
            } else {
                "; sollang compiler error S058: type has a recursive by-value layout; use explicit box or heap-backed storage to break the value cycle" -> println
            }
        return
    }
    context -> invalidInterpolationCapacityNode => invalidCapacity
    invalidCapacity >= 0 -> if {
        context.interpolations[invalidCapacity] => invalidCapacityNode
        "; sollang semantic error: capacity requires a growable/bounded array, dictionary or Arena receiver (interpolation $invalidCapacity, token $(invalidCapacityNode.sourceToken))" -> println
    }
    context -> unresolvedGenericAbiNode => unresolvedAbi
    unresolvedAbi >= 0 -> if {
        context.ir[unresolvedAbi] => unresolved
        "; sollang compiler error S047: unresolved generic ABI requires function specialization at ir $unresolvedAbi (source $(unresolved.sourceModule), ast $(unresolved.astNode), type $(unresolved.typeId))" -> println
    }
    context -> concreteFunctionsBySymbol => functions
    0 => irIndex!
    irIndex! < (context.ir -> len) -> while {
        context -> irInvariantCode(irIndex!, functions) => invariantCode
        invariantCode != 0
            -> if {
                context.ir[irIndex!] => node
                irIndex! => diagnosticIrIndex
                node.sourceModule => sourceModule
                node.astNode => astNode
                context.ranges[sourceModule] => diagnosticRange
                context.nodes[diagnosticRange.astStart + astNode] => diagnosticAst
                context.sources[sourceModule] -> slice(diagnosticAst.start, diagnosticAst.length) => diagnosticExpression
                invariantCode == 57 -> if {
                    context -> streamJoinInputContract(node) => joinContract
                    joinContract.code == 1 -> if {
                        "; sollang compiler error S057: $diagnosticExpression expects a product of at least two streams (source $sourceModule, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
                    } else {
                        joinContract.code == 2 -> if {
                            "; sollang compiler error S057: $diagnosticExpression input field at ordinal $(joinContract.fieldOrdinal) must be Stream<T> or EventStream<T>; provide a stream producer for every field (source $sourceModule, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
                        } else {
                            "; sollang compiler error S057: $diagnosticExpression input field at ordinal $(joinContract.fieldOrdinal) has a different stream type; merge and concat require matching stream element types (source $sourceModule, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
                        }
                    }
                }
                invariantCode != 57 -> if {
                    invariantCode == 55 -> if {
                        context -> concreteCallFunctionIndex(irIndex!, functions) => mismatchFunction
                        context -> arrayCallElementMismatch(irIndex!, mismatchFunction) => mismatchOrdinal
                        "; sollang compiler error S055: array argument $mismatchOrdinal has an incompatible element type in '$diagnosticExpression'; already-typed arrays cannot be implicitly narrowed or reinterpreted; provide matching element storage or explicitly convert elements (source $sourceModule, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
                    } else {
                        invariantCode == 13 -> if {
                            context.ir[node.operand0] => diagnosticArrayElement
                            "; sollang compiler error S006: non-empty array literal has no canonical storage type at ir $diagnosticIrIndex (arrayType $(node.typeId)/$(node.typeKind)/$(node.typeOrigin)/$(node.typeModule)/$(node.typeSymbol), first $(node.operand0), firstType $(diagnosticArrayElement.typeId)/$(diagnosticArrayElement.typeKind)/$(diagnosticArrayElement.typeOrigin)/$(diagnosticArrayElement.typeModule)/$(diagnosticArrayElement.typeSymbol), firstSource $(diagnosticArrayElement.operand0), source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
                        } else {
                            invariantCode == 14 -> if {
                                "; sollang compiler error S007: array literal storage element type disagrees with its first lowered operand at ir $diagnosticIrIndex (source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
                            } else {
                                invariantCode == 15 -> if {
                                    node -> irScalarIntegerWidth(context) => diagnosticResultWidth
                                    context.ir[node.operand0] => diagnosticLeft
                                    context.ir[node.operand1] => diagnosticRight
                                    diagnosticLeft -> irScalarIntegerWidth(context) => diagnosticLeftWidth
                                    diagnosticRight -> irScalarIntegerWidth(context) => diagnosticRightWidth
                                    "; sollang compiler error S008: arithmetic requires compatible numeric scalar operands and result; result width $diagnosticResultWidth, operand widths $diagnosticLeftWidth/$diagnosticRightWidth at ir $diagnosticIrIndex (types $(node.typeSymbol)/$(diagnosticLeft.typeSymbol)/$(diagnosticRight.typeSymbol), source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
                                } else {
                                    invariantCode == 16 -> if {
                                        "; sollang compiler error S009: scalar binding initializer has no binding or parameter value source at ir $diagnosticIrIndex (source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
                                    } else {
                                        invariantCode == 17 -> if {
                                            "; sollang compiler error S010: inverse guard identity disagrees between AST and Typed IR at ir $diagnosticIrIndex (source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
                                        } else {
                                            invariantCode == 11 -> if {
                                                "; sollang compiler error S011: enum subject pattern does not lower to an enum constructor at ir $diagnosticIrIndex (source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
                                            } else {
                                                invariantCode == 18 -> if {
                                                    "; sollang compiler error S012: subject when has no canonical comparison subject at ir $diagnosticIrIndex (source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
                                                } else {
                                                    invariantCode == 19 -> if {
                                                        context.ir[node.parent] => subjectArmDiagnostic
                                                        subjectArmDiagnostic.parent => subjectControlDiagnosticIndex
                                                        context.ir[subjectControlDiagnosticIndex] => subjectControlDiagnostic
                                                        -1 => followingKind!
                                                        -1 => followingParent!
