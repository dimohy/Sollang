                                                                                                        memberOwnerDiagnosticTakeCandidate.operand0 >= 0
                                                                                                            -> if { context.ir[memberOwnerDiagnosticTakeCandidate.operand0].typeId => memberOwnerDiagnosticTakeOperandType! }
