                                                            invariantCode == 4 -> if {
                                                                "; sollang compiler error S015: binary expression has no canonical right operand at ir $diagnosticIrIndex (parent $(node.parent), operand0 $(node.operand0), source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
