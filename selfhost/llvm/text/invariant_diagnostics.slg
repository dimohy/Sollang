                                                                        -1 => memberOwnerDiagnosticBindingKind!
                                                                        -1 => memberOwnerDiagnosticBindingParent!
                                                                        -1 => memberOwnerDiagnosticBindingOperand!
                                                                        -1 => memberOwnerDiagnosticBindingType!
                                                                        -1 => memberOwnerDiagnosticInitializerKind!
                                                                        -1 => memberOwnerDiagnosticInitializerSymbol!
                                                                        -1 => memberOwnerDiagnosticInitializerTarget!
                                                                        -1 => memberOwnerDiagnosticInitializerType!
                                                                        memberOwnerDiagnostic.operand0 >= 0 and memberOwnerDiagnostic.operand0 < (context.ir -> len)
                                                                            -> if {
