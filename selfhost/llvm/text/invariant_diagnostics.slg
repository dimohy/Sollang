                                                                                        memberOwnerDiagnosticTakeCandidate.sourceModule == sourceModule and memberOwnerDiagnosticTakeCandidate.kind == 9 and memberOwnerDiagnosticTakeCandidate.opcode == -213 and memberOwnerDiagnosticTakeCandidate.astNode >= 0
                                                                                            -> if {
