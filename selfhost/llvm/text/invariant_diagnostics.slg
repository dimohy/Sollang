                                                                                    context.ir[memberOwnerDiagnosticSubject].typeId => memberOwnerDiagnosticSubjectType!
                                                                                    memberOwnerDiagnosticSubjectType! >= 0 and memberOwnerDiagnosticSubjectType! < (context.types -> len)
                                                                                        -> if {
