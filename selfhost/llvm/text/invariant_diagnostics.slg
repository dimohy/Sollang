                                                            following.kind => followingKind!
                                                            following.parent => followingParent!
                                                            following.astNode => followingAst!
                                                            following.nextOperand => followingNext!
                                                        }
                                                        "; sollang compiler error S013: subject when comparison has no canonical operand pair at ir $diagnosticIrIndex (left $(node.operand0), expectedLeft $(subjectControlDiagnostic.operand0), right $(node.operand1), next $(node.nextOperand), following $(diagnosticIrIndex + 1)/$(followingKind!)/parent$(followingParent!)/ast$(followingAst!)/next$(followingNext!), arm $(node.parent)/$(subjectArmDiagnostic.kind), control $subjectControlDiagnosticIndex/$(subjectControlDiagnostic.kind), source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length)); repair the exact arm-local value edge before LLVM emission" -> println
                                                    } else {
                                                        invariantCode == 8 -> if {
                                                            "; sollang compiler error S014: member read has no canonical base operand at ir $diagnosticIrIndex (parent $(node.parent), source $sourceModule, ast $astNode, byte $(diagnosticAst.start), length $(diagnosticAst.length))" -> println
