# Sequential named branches have one materialized value per arm in the flat
# self-host IR.  Keep that representation detail in one emitter shared by
# entry, ordinary-function, and nested control-region paths so a new emission
# context cannot silently omit the arm SSA definition.
emitSequentialBranchArmValue armIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[armIndex] => arm
    arm.parent >= 0 and context.ir[arm.parent].kind == 37
        -> if {
            "  %v$(armIndex) = freeze " -> print
            arm -> writeIrType(context, state)
            " " -> print
            arm.operand1 -> writeValue(ownerIndex, context, state)
            "" -> println
        }
}

emitSequentialBranchAggregate branchIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[branchIndex] => branch
    branch.operand0 => armIndex!
    0 => armPosition!
    armIndex! >= 0 -> while {
        context.ir[armIndex!] => arm
        "  " -> print
        arm.nextOperand < 0 -> if { "%v$(branchIndex)" -> print } else { "%v$(branchIndex)_f$(armPosition!)" -> print }
        " = insertvalue " -> print
        branch -> writeIrType(context, state)
        " " -> print
        armPosition! == 0 -> if { "poison" -> print } else {
            "%v$(branchIndex)_f" -> print
            armPosition! - 1 -> writeDecimal
        }
        ", " -> print
        arm -> writeIrType(context, state)
        " " -> print
        armIndex! -> writeValue(ownerIndex, context, state)
        ", $(armPosition!)" -> println
        arm.nextOperand => armIndex!
        armPosition! + 1 => armPosition!
    }
}

# Parallel named branches have the same runtime materialization in every
# emission context.  The callback body is prepared separately; this helper
# owns the compute-group invocation and the resulting product value.
emitParallelBranchValue branchIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[branchIndex] => branch
    context.ir[branch.operand1] => branchSource
    branchSource -> boundedArrayValueTypeId(context, state) => boundedSourceType
    boundedSourceType >= 0 -> if {
        Arena(0) => sourcePrefixStorage!
        "v$(branchIndex)_source_bounded" -> materialize(sourcePrefixStorage!) => sourcePrefix
        sourcePrefix -> emitBoundedArrayValue(branch.operand1, ownerIndex, boundedSourceType, context, state)
    }
    (branchSource -> captureUsesBorrowAbi(context, state)) and (branchSource -> referenceValueTypeId(context, state)) < 0
        -> if {
            "  %v$(branchIndex)_source_ref = alloca " -> print
            branchSource -> writeFunctionValueAbiType(context, state)
            ", align " -> print
            branchSource -> storageAlign(context, state) -> writeDecimalLine
            "  store " -> print
            branchSource -> writeFunctionValueAbiType(context, state)
            " " -> print
            boundedSourceType >= 0 -> if { "%v$(branchIndex)_source_bounded" -> print } else {
                branch.operand1 -> writeValue(ownerIndex, context, state)
            }
            ", ptr %v$(branchIndex)_source_ref, align " -> print
            branchSource -> storageAlign(context, state) -> writeDecimalLine
        }
    branchIndex -> parallelBranchCaptures(context, state) => branchCaptures
    0 => branchArmCount!
    branch.operand0 => branchArmCountIndex!
    branchArmCountIndex! >= 0 -> while {
        branchArmCount! + 1 => branchArmCount!
        context.ir[branchArmCountIndex!].nextOperand => branchArmCountIndex!
    }
    "  %v$(branchIndex)_environment = alloca " -> print
    branchIndex -> writeParallelBranchEnvironmentType(branchCaptures, context, state)
    ", align 8" -> println
    "  %v$(branchIndex)_source_address = getelementptr " -> print
    branchIndex -> writeParallelBranchEnvironmentType(branchCaptures, context, state)
    ", ptr %v$(branchIndex)_environment, i32 0, i32 0" -> println
    "  store " -> print
    branchSource -> writeParallelBranchSourceType(context, state)
    " " -> print
    (branchSource -> referenceValueTypeId(context, state)) >= 0
        -> if {
            ownerIndex -> writeReferencePlaceValue(branch.operand1, context, state)
        } else { branchSource -> captureUsesBorrowAbi(context, state)
                -> if {
                    "%v$(branchIndex)_source_ref" -> print
                } else { boundedSourceType >= 0 -> if { "%v$(branchIndex)_source_bounded" -> print } else {
                        branch.operand1 -> writeValue(ownerIndex, context, state)
                } }
        }
    ", ptr %v$(branchIndex)_source_address, align " -> print
    branchSource -> parallelBranchSourceUsesPointer(context, state)
        -> if { 8 -> writeDecimalLine } else {
            branchSource -> storageAlign(context, state) -> writeDecimalLine
        }
    0 => branchCaptureIndex!
    branchCaptureIndex! < (branchCaptures -> len)
        -> while {
            CaptureValueRequest { callerIndex: ownerIndex, callIndex: branchIndex, interpolationIndex: -1, bindingIndex: branchCaptures[branchCaptureIndex!], captureIndex: branchCaptureIndex! } -> emitCaptureTransport(context, state)
            "  %v$(branchIndex)_capture_address_$(branchCaptureIndex!) = getelementptr " -> print
            branchIndex -> writeParallelBranchEnvironmentType(branchCaptures, context, state)
            ", ptr %v$(branchIndex)_environment, i32 0, i32 " -> print
            branchCaptureIndex! + 1 -> writeDecimalLine
            context.ir[branchCaptures[branchCaptureIndex!]] => branchCapture
            "  store " -> print
            branchCapture -> writeCaptureAbiType(context, state)
            " " -> print
            CaptureValueRequest { callerIndex: ownerIndex, callIndex: branchIndex, interpolationIndex: -1, bindingIndex: branchCaptures[branchCaptureIndex!], captureIndex: branchCaptureIndex! } -> writeCaptureArgumentValue(context, state)
            ", ptr %v$(branchIndex)_capture_address_$(branchCaptureIndex!), align " -> print
            branchCapture -> captureUsesBorrowAbi(context, state)
                -> if { "8" -> println } else {
                    branchCapture -> storageAlign(context, state) -> writeDecimalLine
                }
            branchCaptureIndex! + 1 => branchCaptureIndex!
        }
    branchIndex -> parallelBranchArguments(context) => branchArguments
    0 => branchArgumentIndex!
    branchArgumentIndex! < (branchArguments -> len)
        -> while {
            branchArguments[branchArgumentIndex!] => branchArgument
            context.ir[branchArgument].parent => branchArgumentCall
            branchArgument -> parallelBranchArgumentOrdinal(context) => branchArgumentOrdinal
            branchArgumentCall -> callTargetParameter(branchArgumentOrdinal, context, state) => branchArgumentParameter
            branchArgumentOrdinal == 1 -> if {
                branchArgument -> emitCallIntegerArgumentPromotions(branchArgumentCall, ownerIndex, 1, context, state)
                branchArgument -> emitReferenceArgumentValues(branchArgumentCall, ownerIndex, 1, context, state)
            }
            "  %v$(branchIndex)_argument_address_$(branchArgumentIndex!) = getelementptr " -> print
            branchIndex -> writeParallelBranchEnvironmentType(branchCaptures, context, state)
            ", ptr %v$(branchIndex)_environment, i32 0, i32 " -> print
            1 + (branchCaptures -> len) + branchArgumentIndex! -> writeDecimalLine
            "  store " -> print
            branchArgument -> writeCallArgument(branchArgumentCall, ownerIndex, branchArgumentOrdinal, context, state)
            ", ptr %v$(branchIndex)_argument_address_$(branchArgumentIndex!), align " -> print
            branchArgumentParameter >= 0 -> if { context.ir[branchArgumentParameter] -> storageAlign(context, state) -> writeDecimalLine } else { context.ir[branchArgument] -> storageAlign(context, state) -> writeDecimalLine }
            branchArgumentIndex! + 1 => branchArgumentIndex!
        }
    "  %v$(branchIndex)_output = alloca " -> print
    branch -> writeIrType(context, state)
    ", align " -> print
    branch -> storageAlign(context, state) -> writeDecimalLine
    "  %v$(branchIndex)_group = alloca %sollang.compute_group, align 8" -> println
    "  %v$(branchIndex)_callback_slot = getelementptr %sollang.compute_group, ptr %v$(branchIndex)_group, i32 0, i32 0" -> println
    "  store ptr @sollang_parallel_branch_$(branchIndex), ptr %v$(branchIndex)_callback_slot, align 8" -> println
    "  %v$(branchIndex)_input_slot = getelementptr %sollang.compute_group, ptr %v$(branchIndex)_group, i32 0, i32 1" -> println
    "  store ptr null, ptr %v$(branchIndex)_input_slot, align 8" -> println
    "  %v$(branchIndex)_output_slot = getelementptr %sollang.compute_group, ptr %v$(branchIndex)_group, i32 0, i32 2" -> println
    "  store ptr %v$(branchIndex)_output, ptr %v$(branchIndex)_output_slot, align 8" -> println
    "  %v$(branchIndex)_count_slot = getelementptr %sollang.compute_group, ptr %v$(branchIndex)_group, i32 0, i32 3" -> println
    "  store i64 $(branchArmCount!), ptr %v$(branchIndex)_count_slot, align 8" -> println
    "  %v$(branchIndex)_environment_slot = getelementptr %sollang.compute_group, ptr %v$(branchIndex)_group, i32 0, i32 4" -> println
    "  store ptr %v$(branchIndex)_environment, ptr %v$(branchIndex)_environment_slot, align 8" -> println
    "  %v$(branchIndex)_sinks = call ptr @malloc(i64 $(branchArmCount! * 24))" -> println
    "  call void @llvm.memset.p0.i64(ptr %v$(branchIndex)_sinks, i8 0, i64 $(branchArmCount! * 24), i1 false)" -> println
    "  %v$(branchIndex)_sinks_slot = getelementptr %sollang.compute_group, ptr %v$(branchIndex)_group, i32 0, i32 5" -> println
    "  store ptr %v$(branchIndex)_sinks, ptr %v$(branchIndex)_sinks_slot, align 8" -> println
    6 => branchRuntimeField!
    branchRuntimeField! <= 10 -> while {
        "  %v$(branchIndex)_runtime_slot_$(branchRuntimeField!) = getelementptr %sollang.compute_group, ptr %v$(branchIndex)_group, i32 0, i32 $(branchRuntimeField!)" -> println
        "  store ptr null, ptr %v$(branchIndex)_runtime_slot_$(branchRuntimeField!), align 8" -> println
        branchRuntimeField! + 1 => branchRuntimeField!
    }
    "  %v$(branchIndex)_failure_limit_slot = getelementptr %sollang.compute_group, ptr %v$(branchIndex)_group, i32 0, i32 11" -> println
    "  store atomic i64 $(branchArmCount!), ptr %v$(branchIndex)_failure_limit_slot release, align 8" -> println
    "  %v$(branchIndex)_initialized_slot = getelementptr %sollang.compute_group, ptr %v$(branchIndex)_group, i32 0, i32 12" -> println
    "  store ptr null, ptr %v$(branchIndex)_initialized_slot, align 8" -> println
    "  call void @sollang_compute_execute(ptr %v$(branchIndex)_group)" -> println
    "  %v$(branchIndex) = load " -> print
    branch -> writeIrType(context, state)
    ", ptr %v$(branchIndex)_output, align " -> print
    branch -> storageAlign(context, state) -> writeDecimalLine
}

emitRangeValue rangeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[rangeIndex] => range
    range.opcode == grammar.tokenIdRangeUntil() -> if {
        "  %v$(rangeIndex)_end_inclusive = sub i32 " -> print
        range.operand1 -> writeValue(ownerIndex, context, state)
        ", 1" -> println
        "  %v$(rangeIndex)_end_is_minimum = icmp eq i32 " -> print
        range.operand1 -> writeValue(ownerIndex, context, state)
        ", -2147483648" -> println
        "  %v$(rangeIndex)_normalized_start = select i1 %v$(rangeIndex)_end_is_minimum, i32 0, i32 " -> print
        range.operand0 -> writeValue(ownerIndex, context, state)
        "" -> println
        "  %v$(rangeIndex)_normalized_end = select i1 %v$(rangeIndex)_end_is_minimum, i32 -1, i32 %v$(rangeIndex)_end_inclusive" -> println
    }
    "  %v$(rangeIndex)_start = insertvalue { i32, i32 } poison, i32 " -> print
    range.opcode == grammar.tokenIdRangeUntil() -> if { "%v$(rangeIndex)_normalized_start" -> print } else { range.operand0 -> writeValue(ownerIndex, context, state) }
    ", 0" -> println
    "  %v$(rangeIndex) = insertvalue { i32, i32 } %v$(rangeIndex)_start, i32 " -> print
    range.opcode == grammar.tokenIdRangeUntil() -> if { "%v$(rangeIndex)_normalized_end" -> print } else { range.operand1 -> writeValue(ownerIndex, context, state) }
    ", 1" -> println
}

# Per-node region emission responsibilities extracted from emitRegionOrder.
# Helpers borrow the canonical emitter state and preserve caller-owned order.

emitRegionBindingExpressions regionNodeIndex: Int, ownerIndex: Int, emissionOrder: [Int], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[regionNodeIndex] => regionNode
    regionNodeIndex -> emitAsyncIntRoleReads(context, state)
    regionNodeIndex -> emitNamedBindingOwnershipInitialization(state)
    regionNode.kind == 2 -> if {
        regionNode -> sourceToken(context, state) => regionTextToken
        TextLiteralRequest { sourceModule: regionNode.sourceModule, token: regionTextToken } -> textLiteralLength(context, state) => regionTextLength
        "  %v$(regionNodeIndex)_ptr = insertvalue %sollang.text poison, ptr @sollang_str_$(regionNodeIndex), 0" -> println
        "  %v$(regionNodeIndex) = insertvalue %sollang.text %v$(regionNodeIndex)_ptr, i64 $regionTextLength, 1" -> println
        regionNodeIndex -> emitComparisonTextProducer(ownerIndex, context, state)
    }
    regionNode.kind == 5 and ownerIndex >= 0
        -> if { regionNodeIndex -> emitNamedPlaceRead(ownerIndex, context, state) }
    regionNode.kind == 17 and regionNode.flags == 1
        -> if {
            regionNodeIndex -> mutableBindingRoot(context, state) => mutableRegionRoot
            context.ir[mutableRegionRoot] => mutableRegionBinding
            context.ir[regionNode.operand0] => mutableRegionValue
            regionNode.operand0 -> callResultPropagationBindingIndex(context, state) => mutableRegionPropagationBinding
            mutableRegionBinding -> integerNodeWidth(context, state) => mutableRegionTargetWidth
            mutableRegionValue -> integerNodeWidth(context, state) => mutableRegionSourceWidth
            (mutableRegionTargetWidth > 0 and mutableRegionSourceWidth > 0 and mutableRegionTargetWidth != mutableRegionSourceWidth and mutableRegionValue.kind != 3 and mutableRegionValue.kind != 4) => castMutableRegionValue
            castMutableRegionValue -> if {
                "  %v$(regionNodeIndex)_mutable_cast = " -> print
                mutableRegionTargetWidth < mutableRegionSourceWidth
                    -> if { "trunc " -> print } else { mutableRegionValue -> integerNodeSigned(context, state)
                            -> if { "sext " -> print } else { "zext " -> print } }
                mutableRegionValue -> writeIrType(context, state)
                " %v$(regionNode.operand0) to " -> print
                mutableRegionBinding -> writeIrType(context, state)
                "" -> println
            }
            "  store " -> print
            mutableRegionBinding -> writeIrType(context, state)
            " " -> print
            mutableRegionValue.kind == 3 or mutableRegionValue.kind == 4
                -> if {
                    mutableRegionValue -> sourceToken(context, state) => mutableRegionToken
                    mutableRegionValue.kind == 3 -> if { mutableRegionValue -> writeIntegerLiteral(context, state) } else {
                        (context.sources[mutableRegionValue.sourceModule] -> byte(mutableRegionToken.span.start)) == 116
                            -> if { "1" -> print } else { "0" -> print }
                    }
                } else {
                    mutableRegionPropagationBinding == regionNodeIndex
                        -> if {
                            "%v$(regionNodeIndex)" -> print
                        } else {
                            castMutableRegionValue -> if {
                                "%v$(regionNodeIndex)_mutable_cast" -> print
                            } else {
                                regionNode.operand0 -> writeValue(ownerIndex, context, state)
                            }
                        }
                }
            ", ptr " -> print
            mutableRegionRoot -> writeMutableStoragePointer(ownerIndex, context, state)
            ", align " -> print
            mutableRegionBinding -> storageAlign(context, state) -> writeDecimalLine
        }
    regionNode.kind == 24 -> if {
        WhileValueRequest { whileIndex: regionNodeIndex, ownerIndex: ownerIndex, nodeIndex: regionNodeIndex } -> emitIndexAssignment(context, state)
    }
    regionNode.kind == 25 -> if {
        WhileValueRequest { whileIndex: regionNodeIndex, ownerIndex: ownerIndex, nodeIndex: regionNodeIndex } -> emitMemberAssignment(context, state)
    }
    regionNode.kind == 26 -> if {
        WhileValueRequest { whileIndex: regionNodeIndex, ownerIndex: ownerIndex, nodeIndex: regionNodeIndex } -> emitEnumConstructor(context, state)
        regionNodeIndex -> emitCompletedPatternBindingTransferMarks(context, state)
    }
    regionNode.kind == 27 -> if { regionNodeIndex -> emitEnumMatch(emissionOrder, context, state) }
    regionNode.kind == 33 -> if { regionNodeIndex -> emitBooleanWhen(emissionOrder, context, state) }
    regionNode.kind == 34 -> if { regionNodeIndex -> emitSubjectWhen(emissionOrder, context, state) }
    regionNode.kind == 30 and context.nodes[context.ranges[regionNode.sourceModule].astStart + regionNode.astNode].kind == 82
        -> if {
            regionNodeIndex -> emitResultPropagation(ownerIndex, emissionOrder, context, state)
        }
    regionNode.kind == 36 -> if {
        "  %v$(regionNodeIndex) = freeze " -> print
        regionNode -> writeIrType(context, state)
        " " -> print
        regionNode.operand0 -> writeValue(ownerIndex, context, state)
        "" -> println
    }
    regionNode.kind == 37 -> if { regionNodeIndex -> emitSequentialBranchAggregate(ownerIndex, context, state) }
    regionNode.kind == 39 -> if { regionNodeIndex -> emitSequentialBranchArmValue(ownerIndex, context, state) }
    regionNode.kind == 38 and context.supportsComputePool
        -> if { regionNodeIndex -> emitParallelBranchValue(ownerIndex, context, state) }
    regionNode.kind == 31 -> if { regionNodeIndex -> emitRangeValue(ownerIndex, context, state) }
}

emitRegionControlExpressions regionNodeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[regionNodeIndex] => regionNode
    regionNodeIndex -> emitPlannedJunctionValue(ownerIndex, context, state)
    regionNode.kind == 12 or regionNode.kind == 35
        -> if {
            regionNode.operand0 < 0 -> if {
                "  %v$(regionNodeIndex) = freeze " -> print
                regionNode -> writeIrType(context, state)
                " zeroinitializer" -> println
            }
            regionNode.operand0 => regionFieldValueIndex!
            0 => regionFieldPosition!
            regionFieldValueIndex! >= 0 -> while {
                context.ir[regionFieldValueIndex!] => regionFieldValue
                regionFieldValueIndex! -> aggregateValueIndex(context, state) => regionEmittedFieldIndex
                context.ir[regionEmittedFieldIndex] => regionEmittedFieldValue
                regionNode.typeId => regionStructOwnerTypeId!
                regionStructOwnerTypeId! < 0 -> if {
                    0 => regionStructOwnerTypeSearch!
                    regionStructOwnerTypeSearch! < (context.types -> len)
                        -> while {
                            context.types[regionStructOwnerTypeSearch!] => regionStructOwnerTypeCandidate
                            regionStructOwnerTypeCandidate.status == 0 and regionStructOwnerTypeCandidate.kind == 1 and regionStructOwnerTypeCandidate.origin == regionNode.typeOrigin and regionStructOwnerTypeCandidate.module == regionNode.typeModule and regionStructOwnerTypeCandidate.symbol == regionNode.typeSymbol
                                -> if { regionStructOwnerTypeSearch! => regionStructOwnerTypeId! }
                            regionStructOwnerTypeSearch! + 1 => regionStructOwnerTypeSearch!
                        }
                }
                -1 => regionTargetFieldTypeId!
                0 => regionTargetFieldSearch!
                regionTargetFieldSearch! < (context.fields -> len)
                    -> while {
                        context.fields[regionTargetFieldSearch!] => regionTargetField
                        regionTargetField.status == 0 and regionTargetField.ownerType == regionStructOwnerTypeId!
                            -> if {
                                regionTargetField.ordinal == regionFieldPosition!
                                    -> if { regionTargetField.fieldType => regionTargetFieldTypeId! }
                            }
                        regionTargetFieldSearch! + 1 => regionTargetFieldSearch!
                    }
                regionTargetFieldTypeId! < 0 -> if {
                    "; sollang compiler error S035: control-region struct emitter cannot resolve a canonical field type at ir $regionNodeIndex (owner $(regionStructOwnerTypeId!), field $(regionFieldPosition!), value $regionEmittedFieldIndex)" -> println
                }
                regionEmittedFieldValue -> integerNodeWidth(context, state) => regionSourceFieldWidth!
                0 => regionTargetFieldWidth!
                regionTargetFieldTypeId! >= 0 -> if {
                    context.types[regionTargetFieldTypeId!] => regionTargetFieldSemanticType
                    regionTargetFieldSemanticType.origin == 1 -> if {
                        regionTargetFieldSemanticType.symbol -> integerWidth(context, state) => regionTargetFieldWidth!
                        regionTargetFieldSemanticType.symbol == 12 or regionTargetFieldSemanticType.symbol == 13
                            -> if { context.pointerBitWidth => regionTargetFieldWidth! }
                    }
                }
                false => regionIndexedFieldValue!
                (regionEmittedFieldValue -> isDynamicArrayType) and regionFieldValue.nextOperand >= 0 and regionTargetFieldTypeId! >= 0
                    -> if {
                        regionEmittedFieldValue -> arrayElementTypeId(context, state) => regionFieldElementTypeId
                        regionFieldElementTypeId == regionTargetFieldTypeId!
                            -> if {
                                true => regionIndexedFieldValue!
                                context.ir[regionFieldValue.nextOperand] => regionFieldIndexValue
                                "  %v$(regionNodeIndex)_field$(regionFieldPosition!)_data = extractvalue %sollang.array.i32 %v$(regionEmittedFieldIndex), 0" -> println
                                regionFieldIndexValue -> integerReadNodeWidth(context, state) => regionFieldIndexWidth
                                regionFieldIndexValue.kind != 3 and regionFieldIndexWidth > 0 and regionFieldIndexWidth < 64
                                    -> if {
                                        "  %v$(regionNodeIndex)_field$(regionFieldPosition!)_index = " -> print
                                        regionFieldIndexValue -> integerNodeSigned(context, state)
                                            -> if { "sext " -> print } else { "zext " -> print }
                                        "i$(regionFieldIndexWidth) %v$(regionFieldValue.nextOperand) to i64" -> println
                                    }
                                "  %v$(regionNodeIndex)_field$(regionFieldPosition!)_ptr = getelementptr " -> print
                                regionTargetFieldTypeId! -> writeSemanticTypeId(context, state)
                                ", ptr %v$(regionNodeIndex)_field$(regionFieldPosition!)_data, i64 " -> print
                                regionFieldIndexValue.kind == 3 -> if {
                                    regionFieldIndexValue -> writeIntegerLiteral(context, state)
                                    "" -> println
                                } else {
                                    regionFieldIndexWidth > 0 and regionFieldIndexWidth < 64
                                        -> if { "%v$(regionNodeIndex)_field$(regionFieldPosition!)_index" -> println } else { "%v$(regionFieldValue.nextOperand)" -> println }
                                }
                                "  %v$(regionNodeIndex)_field$(regionFieldPosition!)_indexed = load " -> print
                                regionTargetFieldTypeId! -> writeSemanticTypeId(context, state)
                                ", ptr %v$(regionNodeIndex)_field$(regionFieldPosition!)_ptr, align " -> print
                                context.typeAligns[regionTargetFieldTypeId!] -> writeDecimalLine
                                regionTargetFieldWidth! => regionSourceFieldWidth!
                            }
                    }
                (regionSourceFieldWidth! > 0 and regionTargetFieldWidth! > 0 and regionSourceFieldWidth! != regionTargetFieldWidth! and regionEmittedFieldValue.kind != 3 and regionEmittedFieldValue.kind != 4) => regionCastStructField
                regionCastStructField -> if {
                    "  %v$(regionNodeIndex)_field$(regionFieldPosition!)_cast = " -> print
                    regionTargetFieldWidth! < regionSourceFieldWidth!
                        -> if { "trunc " -> print } else {
                            regionEmittedFieldValue -> integerNodeSigned(context, state)
                                -> if { "sext " -> print } else { "zext " -> print }
                        }
                    regionEmittedFieldValue -> writeIrType(context, state)
                    " " -> print
                    regionEmittedFieldValue.kind == 5 and ownerIndex >= 0 and context.ir[ownerIndex].operand1 >= 0 and regionEmittedFieldValue.symbol == context.ir[context.ir[ownerIndex].operand1].symbol
                        -> if { "%arg" -> print } else { "%v$(regionEmittedFieldIndex)" -> print }
                    " to " -> print
                    regionTargetFieldTypeId! -> writeSemanticTypeId(context, state)
                    "" -> println
                }
                regionNodeIndex -> aggregateFieldCopiesFixedStorage(regionEmittedFieldIndex, regionFieldPosition!, context, state) => regionCopyFixedField
                false => regionCopyNamedFixedField!
                false => regionCopyNamedFixedStructField!
                regionCopyFixedField and regionTargetFieldTypeId! >= 0
                    -> if {
                        "  %v$(regionNodeIndex)_field$(regionFieldPosition!)_copy_source = freeze " -> print
                        regionTargetFieldTypeId! -> writeAggregateFieldTypeId(context, state)
                        " " -> print
                        (regionEmittedFieldValue -> referenceValueTypeId(context, state)) >= 0
                            -> if { "%v$(regionEmittedFieldIndex)" -> print } else {
                                regionEmittedFieldIndex -> writeValue(ownerIndex, context, state)
                            }
                        "" -> println
                        regionTargetFieldTypeId! -> directCopyableFixedStructType(context)
                            -> if {
                                true => regionCopyNamedFixedStructField!
                                "%v$(regionNodeIndex)_field$(regionFieldPosition!)_struct_copy" -> emitCopyableFixedStructValue("%v$(regionNodeIndex)_field$(regionFieldPosition!)_copy_source", regionTargetFieldTypeId!, context, state)
                            } else {
                                true => regionCopyNamedFixedField!
                                "  %v$(regionNodeIndex)_field$(regionFieldPosition!)_source = extractvalue { ptr, i64 } %v$(regionNodeIndex)_field$(regionFieldPosition!)_copy_source, 0" -> println
                                "  %v$(regionNodeIndex)_field$(regionFieldPosition!)_length = extractvalue { ptr, i64 } %v$(regionNodeIndex)_field$(regionFieldPosition!)_copy_source, 1" -> println
                                context.typeSizes[regionTargetFieldTypeId!] => regionFieldAllocationBytes!
                                regionFieldAllocationBytes! == 0 -> if {
                                    context.typeSizes[context.types[regionTargetFieldTypeId!].first] => regionFieldAllocationBytes!
                                }
                                "  %v$(regionNodeIndex)_field$(regionFieldPosition!)_owned = call ptr @malloc(i64 $(regionFieldAllocationBytes!))" -> println
                                "  call void @llvm.memcpy.p0.p0.i64(ptr %v$(regionNodeIndex)_field$(regionFieldPosition!)_owned, ptr %v$(regionNodeIndex)_field$(regionFieldPosition!)_source, i64 $(context.typeSizes[regionTargetFieldTypeId!]), i1 false)" -> println
                                "  %v$(regionNodeIndex)_field$(regionFieldPosition!)_copy0 = insertvalue { ptr, i64 } poison, ptr %v$(regionNodeIndex)_field$(regionFieldPosition!)_owned, 0" -> println
                                "  %v$(regionNodeIndex)_field$(regionFieldPosition!)_copy = insertvalue { ptr, i64 } %v$(regionNodeIndex)_field$(regionFieldPosition!)_copy0, i64 %v$(regionNodeIndex)_field$(regionFieldPosition!)_length, 1" -> println
                            }
                    }
                regionFieldValue.nextOperand => regionNextFieldValue!
                regionIndexedFieldValue! and regionNextFieldValue! >= 0
                    -> if { context.ir[regionNextFieldValue!].nextOperand => regionNextFieldValue! }
                regionTargetFieldTypeId! >= 0 and context.types[regionTargetFieldTypeId!].kind == 12 => regionBoundedField
                regionBoundedField and not regionIndexedFieldValue!
                    -> if {
                        "v$(regionNodeIndex)_field$(regionFieldPosition!)_bounded" -> emitBoundedArrayValue(regionEmittedFieldIndex, ownerIndex, regionTargetFieldTypeId!, context, state)
                    }
                "  " -> print
                regionNextFieldValue! < 0 -> if { "%v$(regionNodeIndex)" -> print } else { "%v$(regionNodeIndex)_f$(regionFieldPosition!)" -> print }
                " = insertvalue " -> print
                regionNode -> writeIrType(context, state)
                " " -> print
                regionFieldPosition! == 0 -> if { "poison" -> print } else {
                    "%v$(regionNodeIndex)_f" -> print
                    regionFieldPosition! - 1 -> writeDecimal
                }
                ", " -> print
                regionTargetFieldTypeId! >= 0 -> if { regionTargetFieldTypeId! -> writeAggregateFieldTypeId(context, state) } else { regionEmittedFieldValue -> writeIrType(context, state) }
                " " -> print
                regionBoundedField -> if {
                    regionIndexedFieldValue! -> if { "%v$(regionNodeIndex)_field$(regionFieldPosition!)_indexed" -> print } else { "%v$(regionNodeIndex)_field$(regionFieldPosition!)_bounded" -> print }
                } else { regionCopyNamedFixedStructField! -> if {
                        "%v$(regionNodeIndex)_field$(regionFieldPosition!)_struct_copy" -> print
                    } else { regionCopyNamedFixedField! -> if {
                            "%v$(regionNodeIndex)_field$(regionFieldPosition!)_copy" -> print
                        } else { regionEmittedFieldValue.kind == 2 -> if {
                                regionEmittedFieldValue -> sourceToken(context, state) => regionFieldTextToken
                                Int(TextLiteralRequest { sourceModule: regionEmittedFieldValue.sourceModule, token: regionFieldTextToken } -> textLiteralLength(context, state)) => regionFieldTextLength
                                "{ ptr @sollang_str_$(regionEmittedFieldIndex), i64 $regionFieldTextLength }" -> print
                            } else {
                                regionEmittedFieldValue.kind == 3 or regionEmittedFieldValue.kind == 4
                                    -> if {
                                        regionEmittedFieldValue -> sourceToken(context, state) => regionFieldToken
                                        regionEmittedFieldValue.kind == 3 -> if {
                                            regionEmittedFieldValue -> writeIntegerLiteral(context, state)
                                        } else {
                                            (context.sources[regionEmittedFieldValue.sourceModule] -> byte(regionFieldToken.span.start)) == 116
                                                -> if { "1" -> print } else { "0" -> print }
                                        }
                                    } else {
                                        regionIndexedFieldValue! -> if { "%v$(regionNodeIndex)_field$(regionFieldPosition!)_indexed" -> print } else {
                                            regionCastStructField -> if { "%v$(regionNodeIndex)_field$(regionFieldPosition!)_cast" -> print } else {
                                                regionEmittedFieldValue.kind == 5 and ownerIndex >= 0 and context.ir[ownerIndex].operand1 >= 0 and regionEmittedFieldValue.symbol == context.ir[context.ir[ownerIndex].operand1].symbol
                                                    -> if { "%arg" -> print } else { "%v$(regionEmittedFieldIndex)" -> print }
                                            }
                                        }
                                    }
                    } } }
                }
                ", $(regionFieldPosition!)" -> println
                regionNextFieldValue! => regionFieldValueIndex!
                regionFieldPosition! + 1 => regionFieldPosition!
            }
            regionNodeIndex -> emitCompletedPatternBindingTransferMarks(context, state)
            regionNodeIndex -> emitAggregatePartialMoveCleanup(ownerIndex, context, state)
        }
    regionNode.kind == 13 -> if {
        context.ir[regionNode.operand0] => regionMemberDiagnosticBase
        regionMemberDiagnosticBase -> integerNodeWidth(context, state) => regionMemberDiagnosticWidth
        regionMemberDiagnosticWidth > 0 -> if {
            "; sollang compiler error S043: dotted member base resolves to scalar i$regionMemberDiagnosticWidth at ir $regionNodeIndex (parent $(regionNode.parent), base $(regionNode.operand0), baseKind $(regionMemberDiagnosticBase.kind), baseParent $(regionMemberDiagnosticBase.parent), source $(regionNode.sourceModule), ast $(regionNode.astNode), baseAst $(regionMemberDiagnosticBase.astNode))" -> println
        }
        regionNodeIndex -> canonicalMemberPathAvailable(context, state)
            -> if {
                context.ir[regionNode.operand0] => regionCanonicalMemberBase
                regionNode -> sourceNode(context, state) => regionCanonicalMemberAst
                regionCanonicalMemberBase -> sourceNode(context, state) => regionCanonicalMemberBaseAst
                regionCanonicalMemberBaseAst.start + regionCanonicalMemberBaseAst.length => regionCanonicalMemberBaseEnd
                regionCanonicalMemberAst.firstToken => regionCanonicalMemberTokenIndex!
                true => regionCanonicalBeforeMemberBaseEnd!
                regionCanonicalBeforeMemberBaseEnd! and regionCanonicalMemberTokenIndex! < regionCanonicalMemberAst.firstToken + regionCanonicalMemberAst.tokenCount
                    -> while {
                        context.tokens[context.ranges[regionNode.sourceModule].tokenStart + regionCanonicalMemberTokenIndex!].span.start < regionCanonicalMemberBaseEnd
                            -> if {
                                regionCanonicalMemberTokenIndex! + 1 => regionCanonicalMemberTokenIndex!
                            } else { false => regionCanonicalBeforeMemberBaseEnd! }
                    }
                regionCanonicalMemberTokenIndex! => regionCanonicalMemberPathStart
                0 => regionCanonicalMemberCount!
                regionCanonicalMemberTokenIndex! < regionCanonicalMemberAst.firstToken + regionCanonicalMemberAst.tokenCount
                    -> while {
                        context.tokens[context.ranges[regionNode.sourceModule].tokenStart + regionCanonicalMemberTokenIndex!].kind == grammar.tokenIdIdentifier()
                            -> if {
                                regionCanonicalMemberCount! + 1 => regionCanonicalMemberCount!
                            }
                        regionCanonicalMemberTokenIndex! + 1 => regionCanonicalMemberTokenIndex!
                    }
                regionCanonicalMemberBase.typeId => regionCanonicalMemberOwnerType!
                0 => regionCanonicalMemberOrdinal!
                regionCanonicalMemberPathStart => regionCanonicalMemberTokenIndex!
                regionCanonicalMemberTokenIndex! < regionCanonicalMemberAst.firstToken + regionCanonicalMemberAst.tokenCount
                    -> while {
                        context.tokens[context.ranges[regionNode.sourceModule].tokenStart + regionCanonicalMemberTokenIndex!].kind == grammar.tokenIdIdentifier()
                            -> if {
                                false => regionCanonicalMemberReference!
                                context.types[regionCanonicalMemberOwnerType!].kind == 8 or context.types[regionCanonicalMemberOwnerType!].kind == 6
                                    -> if {
                                        context.types[regionCanonicalMemberOwnerType!].first => regionCanonicalMemberOwnerType!
                                        true => regionCanonicalMemberReference!
                                    }
                                regionCanonicalMemberOwnerType!
                                    -> canonicalMemberFieldIndex(regionNode.sourceModule, regionCanonicalMemberTokenIndex!, context)
                                    => regionCanonicalMemberResolvedField!
                                regionCanonicalMemberResolvedField! < 0
                                    and regionCanonicalMemberOrdinal! == regionCanonicalMemberCount! - 1
                                    -> if {
                                        regionCanonicalMemberOwnerType!
                                            -> canonicalMemberFieldOrdinalIndex(regionNode.symbol, context)
                                            => regionCanonicalMemberResolvedField!
                                    }
                                context.fields[regionCanonicalMemberResolvedField!] => regionCanonicalMemberField
                                "  " -> print
                                regionCanonicalMemberOrdinal! == regionCanonicalMemberCount! - 1
                                    -> if { regionNodeIndex -> writeMemberStorageValueName(context, state) } else { "%v$(regionNodeIndex)_m$(regionCanonicalMemberOrdinal!)" -> print }
                                regionCanonicalMemberReference! -> if {
                                    "_address = getelementptr inbounds " -> print
                                    regionCanonicalMemberOwnerType! -> writeSemanticTypeId(context, state)
                                    ", ptr " -> print
                                    regionCanonicalMemberOrdinal! == 0 -> if { ownerIndex -> writeReferencePlaceValue(regionNode.operand0, context, state) } else { "%v$(regionNodeIndex)_m$(regionCanonicalMemberOrdinal! - 1)" -> print }
                                    ", i32 0, i32 $(regionCanonicalMemberField.ordinal)" -> println
                                    "  " -> print
                                    regionCanonicalMemberOrdinal! == regionCanonicalMemberCount! - 1
                                        -> if { regionNodeIndex -> writeMemberStorageValueName(context, state) } else { "%v$(regionNodeIndex)_m$(regionCanonicalMemberOrdinal!)" -> print }
                                    " = load " -> print
                                    regionCanonicalMemberField.fieldType -> writeAggregateFieldTypeId(context, state)
                                    ", ptr " -> print
                                    regionCanonicalMemberOrdinal! == regionCanonicalMemberCount! - 1
                                        -> if { regionNodeIndex -> writeMemberStorageValueName(context, state) } else { "%v$(regionNodeIndex)_m$(regionCanonicalMemberOrdinal!)" -> print }
                                    "_address, align $(context.typeAligns[regionCanonicalMemberField.fieldType])" -> println
                                } else {
                                    " = extractvalue " -> print
                                    regionCanonicalMemberOwnerType! -> writeSemanticTypeId(context, state)
                                    " " -> print
                                    regionCanonicalMemberOrdinal! == 0 -> if { regionNode.operand0 -> writeValue(ownerIndex, context, state) } else { "%v$(regionNodeIndex)_m$(regionCanonicalMemberOrdinal! - 1)" -> print }
                                    ", $(regionCanonicalMemberField.ordinal)" -> println
                                }
                                regionCanonicalMemberField.fieldType => regionCanonicalMemberOwnerType!
                                regionCanonicalMemberOrdinal! + 1 => regionCanonicalMemberOrdinal!
                            }
                        regionCanonicalMemberTokenIndex! + 1 => regionCanonicalMemberTokenIndex!
                    }
            } else {
                regionNode.operand0 >= 0 and context.ir[regionNode.operand0].typeId >= 0
                    -> if {
                        context.ir[regionNode.operand0] => regionReferenceMemberBase
                        context.types[regionReferenceMemberBase.typeId].kind == 8
                            -> if {
                                context.types[regionReferenceMemberBase.typeId].first => regionReferenceMemberOwnerType
                                "  %v$(regionNodeIndex)_address = getelementptr inbounds " -> print
                                regionReferenceMemberOwnerType -> writeSemanticTypeId(context, state)
                                ", ptr " -> print
                                ownerIndex -> writeReferencePlaceValue(regionNode.operand0, context, state)
                                ", i32 0, i32 $(regionNode.symbol)" -> println
                                regionNode.typeId => regionReferenceMemberValueType!
                                regionReferenceMemberValueType! >= 0 and context.types[regionReferenceMemberValueType!].kind == 8
                                    -> if {
                                        context.types[regionReferenceMemberValueType!].first => regionReferenceMemberValueType!
                                    }
                                "  " -> print
                                regionNodeIndex -> writeMemberStorageValueName(context, state)
                                " = load " -> print
                                regionReferenceMemberValueType! >= 0 -> if { regionReferenceMemberValueType! -> writeSemanticTypeId(context, state) } else { regionNode -> writeIrType(context, state) }
                                ", ptr %v$(regionNodeIndex)_address, align " -> print
                                regionReferenceMemberValueType! >= 0 -> if { context.typeAligns[regionReferenceMemberValueType!] -> writeDecimalLine } else { regionNode -> storageAlign(context, state) -> writeDecimalLine }
                            } else {
                                "  " -> print
                                regionNodeIndex -> writeMemberStorageValueName(context, state)
                                " = extractvalue " -> print
                                regionReferenceMemberBase.typeId -> writeSemanticTypeId(context, state)
                                " " -> print
                                ownerIndex -> writeReferencePlaceValue(regionNode.operand0, context, state)
                                ", $(regionNode.symbol)" -> println
                            }
                    } else {
                        regionNode -> isArgumentsType -> unless {
                            context.ir[regionNode.operand0] => regionMemberBase
                            regionMemberBase.typeOrigin => regionMemberCurrentOrigin!
                            regionMemberBase.typeModule => regionMemberCurrentModule!
                            regionMemberBase.typeSymbol => regionMemberCurrentSymbol!
                            # Recursive semantic identity is authoritative for nominal member
                            # ownership. Legacy origin/module fields can retain a module index
                            # from an imported projection and are not safe range indexes.
                            regionMemberBase.typeId => regionMemberCanonicalTypeId!
                            regionMemberCanonicalTypeId! >= 0 and context.types[regionMemberCanonicalTypeId!].kind == 8
                                -> if {
                                    context.types[regionMemberCanonicalTypeId!].first => regionMemberCanonicalTypeId!
                                }
                            regionMemberCanonicalTypeId! >= 0 and context.types[regionMemberCanonicalTypeId!].kind == 1
                                -> if {
                                    context.types[regionMemberCanonicalTypeId!] => regionMemberCanonicalType
                                    regionMemberCanonicalType.origin => regionMemberCurrentOrigin!
                                    regionMemberCanonicalType.module => regionMemberCurrentModule!
                                    regionMemberCanonicalType.symbol => regionMemberCurrentSymbol!
                                }
                            regionNode -> sourceNode(context, state) => regionMemberAst
                            regionMemberBase -> sourceNode(context, state) => regionMemberBaseAst
                            regionMemberBaseAst.start + regionMemberBaseAst.length => regionMemberBaseEnd
                            1 => regionMemberIdentifierCount!
                            regionMemberAst.firstToken => regionMemberTokenIndex!
                            true => beforeRegionMemberBaseEnd!
                            beforeRegionMemberBaseEnd! and regionMemberTokenIndex! < regionMemberAst.firstToken + regionMemberAst.tokenCount
                                -> while {
                                    context.tokens[context.ranges[regionNode.sourceModule].tokenStart + regionMemberTokenIndex!].span.start < regionMemberBaseEnd
                                        -> if {
                                            regionMemberTokenIndex! + 1 => regionMemberTokenIndex!
                                        } else { false => beforeRegionMemberBaseEnd! }
                                }
                            regionMemberTokenIndex! => regionMemberPathTokenStart
                            regionMemberTokenIndex! < regionMemberAst.firstToken + regionMemberAst.tokenCount
                                -> while {
                                    context.tokens[context.ranges[regionNode.sourceModule].tokenStart + regionMemberTokenIndex!].kind == grammar.tokenIdIdentifier()
                                        -> if { regionMemberIdentifierCount! + 1 => regionMemberIdentifierCount! }
                                    regionMemberTokenIndex! + 1 => regionMemberTokenIndex!
                                }
                            1 => regionMemberIdentifierOrdinal!
                            0 => regionMemberProjectionOrdinal!
                            regionMemberPathTokenStart => regionMemberTokenIndex!
                            regionMemberTokenIndex! < regionMemberAst.firstToken + regionMemberAst.tokenCount
                                -> while {
                                    context.tokens[context.ranges[regionNode.sourceModule].tokenStart + regionMemberTokenIndex!].kind == grammar.tokenIdIdentifier()
                                        -> if {
                                            regionMemberIdentifierOrdinal! > 0 -> if {
                                                regionMemberCurrentModule! => regionOwnerSourceModule!
                                                regionMemberCurrentOrigin! == 2 -> if { context.modules[regionMemberCurrentModule!].sourceIndex => regionOwnerSourceModule! }
                                                context.ranges[regionOwnerSourceModule!] => regionOwnerRange
                                                -1 => regionFieldOrdinal!
                                                0 => regionCandidateFieldOrdinal!
                                                0 => regionMemberFieldSearch!
                                                regionMemberFieldSearch! < regionOwnerRange.symbolCount
                                                    -> while {
                                                        context.symbols[regionOwnerRange.symbolStart + regionMemberFieldSearch!] => regionMemberField
                                                        regionMemberField.kind == 26 and regionMemberField.parent == regionMemberCurrentSymbol!
                                                            -> if {
                                                                context.tokens[context.ranges[regionNode.sourceModule].tokenStart + regionMemberTokenIndex!] => regionMemberName
                                                                context.tokens[regionOwnerRange.tokenStart + regionMemberField.nameToken] => regionFieldName
                                                                regionMemberName.span.length == regionFieldName.span.length => regionFieldEqual!
                                                                UIntSize(0) => regionFieldNameByte!
                                                                regionFieldEqual! and regionFieldNameByte! < regionMemberName.span.length
                                                                    -> while {
                                                                        context.sources[regionNode.sourceModule] -> byte(regionMemberName.span.start + regionFieldNameByte!) => regionMemberByte
                                                                        context.sources[regionOwnerSourceModule!] -> byte(regionFieldName.span.start + regionFieldNameByte!) => regionFieldByte
                                                                        regionMemberByte != regionFieldByte -> if { false => regionFieldEqual! }
                                                                        regionFieldNameByte! + 1 => regionFieldNameByte!
                                                                    }
                                                                regionFieldEqual! -> if {
                                                                    regionCandidateFieldOrdinal! => regionFieldOrdinal!
                                                                    -1 => regionMemberFieldTypeIndex!
                                                                    0 => regionMemberFieldTypeSearch!
                                                                    regionMemberFieldTypeSearch! < (context.nominal -> len)
                                                                        -> while {
                                                                            context.nominal[regionMemberFieldTypeSearch!].sourceModule == regionOwnerSourceModule! and context.nominal[regionMemberFieldTypeSearch!].typeAst == regionMemberField.typeNode
                                                                                -> if { regionMemberFieldTypeSearch! => regionMemberFieldTypeIndex! }
                                                                            regionMemberFieldTypeSearch! + 1 => regionMemberFieldTypeSearch!
                                                                        }
                                                                    -1 => regionMemberNextOrigin!
                                                                    -1 => regionMemberNextModule!
                                                                    -1 => regionMemberNextSymbol!
                                                                    regionMemberFieldTypeIndex! >= 0 -> if {
                                                                        context.nominal[regionMemberFieldTypeIndex!] => regionMemberFieldType
                                                                        regionMemberFieldType.origin => regionMemberNextOrigin!
                                                                        regionMemberFieldType.targetModule => regionMemberNextModule!
                                                                        regionMemberFieldType.targetSymbol => regionMemberNextSymbol!
                                                                    } else {
                                                                        0 => regionMemberCompositeSearch!
                                                                        regionMemberCompositeSearch! < (context.composite -> len)
                                                                            -> while {
                                                                                context.composite[regionMemberCompositeSearch!] => regionMemberCompositeType
                                                                                regionMemberCompositeType.sourceModule == regionOwnerSourceModule! and regionMemberCompositeType.typeAst == regionMemberField.typeNode
                                                                                    -> if {
                                                                                        10 + regionMemberCompositeType.kind => regionMemberNextOrigin!
                                                                                        regionMemberCompositeType.kind == 5 -> if {
                                                                                            regionMemberCompositeType.keySymbol => regionMemberNextModule!
                                                                                            regionMemberCompositeType.valueSymbol => regionMemberNextSymbol!
                                                                                        } else {
                                                                                            regionMemberCompositeType.elementModule => regionMemberNextModule!
                                                                                            regionMemberCompositeType.elementSymbol => regionMemberNextSymbol!
                                                                                        }
                                                                                    }
                                                                                regionMemberCompositeSearch! + 1 => regionMemberCompositeSearch!
                                                                            }
                                                                    }
                                                                    "  " -> print
                                                                    regionMemberIdentifierOrdinal! == regionMemberIdentifierCount! - 1
                                                                        -> if { regionNodeIndex -> writeMemberStorageValueName(context, state) } else { "%v$(regionNodeIndex)_m$(regionMemberProjectionOrdinal!)" -> print }
                                                                    " = extractvalue %sollang.struct.m$(regionOwnerSourceModule!)_s$(regionMemberCurrentSymbol!) " -> print
                                                                    regionMemberProjectionOrdinal! == 0 -> if {
                                                                        regionMemberBase.kind == 5 and ownerIndex >= 0 and context.ir[ownerIndex].operand1 >= 0 and regionMemberBase.symbol == context.ir[context.ir[ownerIndex].operand1].symbol
                                                                            -> if { "%arg" -> print } else { "%v$(regionNode.operand0)" -> print }
                                                                    } else {
                                                                        "%v$(regionNodeIndex)_m" -> print
                                                                        regionMemberProjectionOrdinal! - 1 -> writeDecimal
                                                                    }
                                                                    ", " -> print
                                                                    regionFieldOrdinal! -> writeDecimalLine
                                                                    regionMemberNextOrigin! => regionMemberCurrentOrigin!
                                                                    regionMemberNextModule! => regionMemberCurrentModule!
                                                                    regionMemberNextSymbol! => regionMemberCurrentSymbol!
                                                                    regionMemberProjectionOrdinal! + 1 => regionMemberProjectionOrdinal!
                                                                }
                                                                regionCandidateFieldOrdinal! + 1 => regionCandidateFieldOrdinal!
                                                            }
                                                        regionMemberFieldSearch! + 1 => regionMemberFieldSearch!
                                                    }
                                            }
                                            regionMemberIdentifierOrdinal! + 1 => regionMemberIdentifierOrdinal!
                                        }
                                    regionMemberTokenIndex! + 1 => regionMemberTokenIndex!
                                }
                        }
                    }
            }
        regionNodeIndex -> bindingFixedStorageCopyTypeId(context) => bindingCopyTypeId
        bindingCopyTypeId >= 0 -> if {
            "%v$(regionNodeIndex)_binding_copy" -> emitCopyableFixedStorageValue("%v$(regionNodeIndex)", bindingCopyTypeId, context, state)
        }
        context.ir[regionNodeIndex] -> boundedArrayValueTypeId(context, state) => boundedMemberTypeId
        boundedMemberTypeId >= 0 -> if {
            "v$(regionNodeIndex)" -> emitBoundedArrayHandle("%v$(regionNodeIndex)_bounded_value", boundedMemberTypeId, context, state)
        }
    }
}

emitRegionIntrinsicExpressions regionNodeIndex: Int, ownerIndex: Int, regionPointerAlignment: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    regionNodeIndex -> emitAsyncYieldPoint(ownerIndex, context, state)
    context.ir[regionNodeIndex] => regionNode
    regionNodeIndex -> emitArgumentsIntrinsic(context)
    regionNode.kind == 9 and regionNode.opcode == -27 and regionNode.operand0 >= 0
        -> if { regionNodeIndex -> emitBoxIntrinsic(ownerIndex, context, state) }
    regionNode.kind == 9 and (regionNode.opcode == -306 or regionNode.opcode == -307) and regionNode.operand0 >= 0
        -> if { regionNodeIndex -> emitMappedBytesExpression(ownerIndex, context, state) }
    regionNode -> isMappedBytesFlush(context)
        -> if { regionNodeIndex -> emitMappedBytesFlush(ownerIndex, context, state) }
    regionNodeIndex -> emitDynExpression(ownerIndex, context, state)
    regionNode.kind == 9 and regionNode.opcode == -226 and regionNode.operand0 >= 0
        -> if {
            regionNodeIndex -> staticTraitMethodSymbol(context, state) => regionStaticTraitMethod
            regionStaticTraitMethod >= 0 -> if {
                context.ir[regionNode.operand0] => regionStaticTraitReceiver
                "  %v$(regionNodeIndex) = call " -> print
                regionNode -> writeIrType(context, state)
                " @sollang_m$(regionStaticTraitReceiver.typeModule)_s$(regionStaticTraitMethod)(" -> print
                regionStaticTraitReceiver -> writeIrType(context, state)
                " " -> print
                regionNode.operand0 -> writeValue(ownerIndex, context, state)
                ")" -> println
            }
        }
    (regionNode.kind == 9 or regionNode.kind == 6) and regionNode.opcode == -201 and regionNode.operand0 >= 0
        -> if {
            regionNodeIndex -> emitLengthIntrinsic(ownerIndex, context, state)
        }
    regionNode.kind == 9 and regionNode.opcode <= -241 and regionNode.opcode >= -245 and regionNode.operand0 >= 0
        -> if {
            regionNodeIndex -> emitBitSetIntrinsic(ownerIndex, context, state)
        }
    regionNode.kind == 9 and regionNode.opcode <= -246 and regionNode.opcode >= -251 and regionNode.operand0 >= 0
        -> if {
            regionNodeIndex -> emitDequeIntrinsic(ownerIndex, context, state)
        }
    regionNode.kind == 9 and regionNode.opcode <= -252 and regionNode.opcode >= -254 and regionNode.operand0 >= 0
        -> if {
            regionNodeIndex -> emitHeapIntrinsic(ownerIndex, context, state)
        }
    regionNode -> typedIr.isSetIntrinsicCall
        -> if {
            regionNodeIndex -> emitSetIntrinsic(ownerIndex, context, state)
        }
    (regionNode.kind == 9 or regionNode.kind == 6) and (regionNode.opcode -> typedIr.isRawArenaOpcode)
        -> if { regionNodeIndex -> emitRawArenaIntrinsic(ownerIndex, context, state) }
    (regionNode.kind == 9 or regionNode.kind == 6) and regionNode.opcode == -236 and regionNode.operand0 >= 0
        -> if {
            regionNodeIndex -> emitCapacityIntrinsic(ownerIndex, context, state)
        }
    (regionNode.kind == 9 or regionNode.kind == 6)
        and regionNode.opcode == -271
        and regionNode.operand0 >= 0
        and regionNode.operand1 >= 0
        -> if {
            WhileValueRequest { whileIndex: regionNodeIndex, ownerIndex: ownerIndex, nodeIndex: regionNodeIndex }
                -> emitArrayReserve(context, state)
        }
    (regionNode.kind == 9 or regionNode.kind == 6) and regionNode.opcode == -202 and regionNode.operand0 >= 0 and regionNode.operand1 >= 0
        -> if {
            context.ir[regionNode.operand0] => regionByteBase
            regionNode.operand1 -> aggregateValueIndex(context, state) => regionByteIndexValue
            context.ir[regionByteIndexValue] => regionByteIndex
            regionByteIndex -> integerReadNodeWidth(context, state) => regionByteIndexWidth
            regionByteBase.typeId => regionByteBaseTypeId!
            false => regionByteBaseReference!
            regionByteBaseTypeId! >= 0 and context.types[regionByteBaseTypeId!].kind == 8
                -> if {
                    context.types[regionByteBaseTypeId!].first => regionByteBaseTypeId!
                    true => regionByteBaseReference!
                    "  %v$(regionNodeIndex)_base_source = load " -> print
                    regionByteBaseTypeId! -> writeSemanticTypeId(context, state)
                    ", ptr " -> print
                    regionNode.operand0 -> writeValue(ownerIndex, context, state)
                    ", align 8" -> println
                }
            "  %v$(regionNodeIndex)_base = extractvalue " -> print
            regionByteBaseReference! -> if { regionByteBaseTypeId! -> writeSemanticTypeId(context, state) } else { regionByteBase -> writeTextLikeType }
            " " -> print
            regionByteBaseReference! -> if { "%v$(regionNodeIndex)_base_source" -> print } else {
                regionByteBase.kind == 5 and ownerIndex >= 0 and context.ir[ownerIndex].operand1 >= 0 and regionByteBase.symbol == context.ir[context.ir[ownerIndex].operand1].symbol
                    -> if { "%arg" -> print } else { "%v$(regionNode.operand0)" -> print }
            }
            ", 0" -> println
            regionByteIndex.kind != 3 and regionByteIndexWidth > 0 and regionByteIndexWidth < 64
                -> if {
                    "  %v$(regionNodeIndex)_index = " -> print
                    regionByteIndex -> integerNodeSigned(context, state)
                        -> if { "sext" -> print } else { "zext" -> print }
                    " i$(regionByteIndexWidth) " -> print
                    regionByteIndexValue -> writeValue(ownerIndex, context, state)
                    " to i64" -> println
                }
            "  %v$(regionNodeIndex)_address = getelementptr i8, ptr %v$(regionNodeIndex)_base, i64 " -> print
            regionByteIndex.kind != 3 and regionByteIndexWidth > 0 and regionByteIndexWidth < 64
                -> if { "%v$(regionNodeIndex)_index" -> println } else {
                    regionByteIndexValue -> writeValue(ownerIndex, context, state)
                    "" -> println
                }
            "  %v$(regionNodeIndex) = load i8, ptr %v$(regionNodeIndex)_address, align 1" -> println
        }
    (regionNode.kind == 9 or regionNode.kind == 6) and regionNode.opcode == -203 and regionNode.operand0 >= 0 and regionNode.operand1 >= 0
        -> if {
            WhileValueRequest { whileIndex: -1, ownerIndex: ownerIndex, nodeIndex: regionNodeIndex } -> emitTextSlice(context, state)
        }
    regionNode.kind == 9 and regionNode.opcode == -204 and regionNode.operand0 >= 0 and regionNode.operand1 >= 0
        -> if {
            WhileValueRequest { whileIndex: regionNodeIndex, ownerIndex: ownerIndex, nodeIndex: 0 } -> emitArrayPush(context, state)
        }
    regionNode.kind == 9 and (regionNode.opcode == -223 or regionNode.opcode == -303) and regionNode.operand0 >= 0 and regionNode.operand1 >= 0
        -> if {
            WhileValueRequest { whileIndex: regionNodeIndex, ownerIndex: ownerIndex, nodeIndex: 0 } -> emitDictionaryPut(context, state)
        }
    regionNode.kind == 9 and regionNode.opcode == -213 and regionNode.operand0 >= 0 and regionNode.operand1 >= 0
        -> if {
            WhileValueRequest { whileIndex: regionNodeIndex, ownerIndex: ownerIndex, nodeIndex: 0 } -> emitTake(context, state)
        }
    regionNode -> typedIr.isOwnedContainerTransform
        -> if {
            WhileValueRequest { whileIndex: regionNodeIndex, ownerIndex: ownerIndex, nodeIndex: 0 } -> emitOwnedContainerTransform(context, state)
        }
    regionNode -> typedIr.isArrayExchangeIntrinsicCall
        -> if {
            WhileValueRequest { whileIndex: regionNodeIndex, ownerIndex: ownerIndex, nodeIndex: 0 } -> emitExchange(context, state)
        }
    (regionNode.kind == 9 or regionNode.kind == 6) and regionNode.opcode == -205 and regionNode.operand0 >= 0
        -> if {
            context.ir[regionNode.operand0] => regionMapPath
            "  %v$(regionNodeIndex) = call %sollang.source_text @sollang_runtime_map_text(%sollang.text " -> print
            regionMapPath.kind == 5 and ownerIndex >= 0 and context.ir[ownerIndex].operand1 >= 0 and regionMapPath.symbol == context.ir[context.ir[ownerIndex].operand1].symbol
                -> if { "%arg" -> print } else { "%v$(regionNode.operand0)" -> print }
            ")" -> println
        }
    (regionNode.kind == 9 or regionNode.kind == 6) and (regionNode.opcode == -214 or regionNode.opcode == -230) and regionNode.operand0 >= 0
        -> if {
            context.ir[regionNode.operand0] => regionSourcePath
            context.expectedPathStyle => regionSourcePathExpectedStyle
            regionSourcePath.typeId => regionSourcePathValueType!
            false => regionSourcePathIsReference!
            regionSourcePathValueType! >= 0 and context.types[regionSourcePathValueType!].kind == 8
                -> if {
                    context.types[regionSourcePathValueType!].first => regionSourcePathValueType!
                    true => regionSourcePathIsReference!
                }
            -1 => regionSourcePathBytesType!
            -1 => regionSourcePathStyleType!
            0 => regionSourcePathFieldIndex!
            regionSourcePathFieldIndex! < (context.fields -> len)
                -> while {
                    context.fields[regionSourcePathFieldIndex!] => regionSourcePathField
                    regionSourcePathField.ownerType == regionSourcePathValueType!
                        -> if {
                            regionSourcePathField.ordinal == 0 -> if { regionSourcePathField.fieldType => regionSourcePathBytesType! }
                            regionSourcePathField.ordinal == 1 -> if { regionSourcePathField.fieldType => regionSourcePathStyleType! }
                        }
                    regionSourcePathFieldIndex! + 1 => regionSourcePathFieldIndex!
                }
            regionSourcePathIsReference! -> if {
                "  %v$(regionNodeIndex)_path_value = load " -> print
                regionSourcePathValueType! -> writeSemanticTypeId(context, state)
                ", ptr " -> print
                regionSourcePath.kind == 5 and ownerIndex >= 0 and context.ir[ownerIndex].operand1 >= 0 and regionSourcePath.symbol == context.ir[context.ir[ownerIndex].operand1].symbol
                    -> if { "%arg" -> print } else { "%v$(regionNode.operand0)" -> print }
                ", align 8" -> println
            }
            "  %v$(regionNodeIndex)_path_bytes = extractvalue " -> print
            regionSourcePathValueType! -> writeSemanticTypeId(context, state)
            " " -> print
            regionSourcePathIsReference! -> if {
                "%v$(regionNodeIndex)_path_value" -> print
            } else {
                regionSourcePath.kind == 5 and ownerIndex >= 0 and context.ir[ownerIndex].operand1 >= 0 and regionSourcePath.symbol == context.ir[context.ir[ownerIndex].operand1].symbol
                    -> if { "%arg" -> print } else { "%v$(regionNode.operand0)" -> print }
            }
            ", 0" -> println
            "  %v$(regionNodeIndex)_path_data = extractvalue " -> print
            regionSourcePathBytesType! -> writeSemanticTypeId(context, state)
            " %v$(regionNodeIndex)_path_bytes, 0" -> println
            "  %v$(regionNodeIndex)_path_length = extractvalue " -> print
            regionSourcePathBytesType! -> writeSemanticTypeId(context, state)
            " %v$(regionNodeIndex)_path_bytes, 1" -> println
            regionNode.opcode == -214 -> if {
                "  %v$(regionNodeIndex)_path_style_value = extractvalue " -> print
                regionSourcePathValueType! -> writeSemanticTypeId(context, state)
                " " -> print
                regionSourcePathIsReference! -> if {
                    "%v$(regionNodeIndex)_path_value" -> print
                } else {
                    regionSourcePath.kind == 5 and ownerIndex >= 0 and context.ir[ownerIndex].operand1 >= 0 and regionSourcePath.symbol == context.ir[context.ir[ownerIndex].operand1].symbol
                        -> if { "%arg" -> print } else { "%v$(regionNode.operand0)" -> print }
                }
                ", 1" -> println
                "  %v$(regionNodeIndex)_path_style = extractvalue " -> print
                regionSourcePathStyleType! -> writeSemanticTypeId(context, state)
                " %v$(regionNodeIndex)_path_style_value, 0" -> println
                "  %v$(regionNodeIndex)_path_style_valid = icmp eq i32 %v$(regionNodeIndex)_path_style, $(regionSourcePathExpectedStyle)" -> println
                "  br i1 %v$(regionNodeIndex)_path_style_valid, label %map_path$(regionNodeIndex)_open, label %map_path$(regionNodeIndex)_style_error" -> println
                "map_path$(regionNodeIndex)_style_error:" -> println
                "  call void @llvm.trap()" -> println
                "  unreachable" -> println
                "map_path$(regionNodeIndex)_open:" -> println
            }
            "  %v$(regionNodeIndex)_path_text0 = insertvalue %sollang.text poison, ptr %v$(regionNodeIndex)_path_data, 0" -> println
            "  %v$(regionNodeIndex)_path_text = insertvalue %sollang.text %v$(regionNodeIndex)_path_text0, i64 %v$(regionNodeIndex)_path_length, 1" -> println
            regionNode.opcode == -230 -> if {
                "  %v$(regionNodeIndex) = freeze %sollang.text %v$(regionNodeIndex)_path_text" -> println
            } else {
                "  %v$(regionNodeIndex) = call %sollang.source_text @sollang_runtime_map_text(%sollang.text %v$(regionNodeIndex)_path_text)" -> println
            }
        }
    (regionNode.kind == 9 or regionNode.kind == 6) and regionNode.opcode == -206 and regionNode.operand0 >= 0
        -> if {
            context.ir[regionNode.operand0] => regionBorrowText
            "  %v$(regionNodeIndex)_data = extractvalue %sollang.text " -> print
            regionBorrowText.kind == 5 and ownerIndex >= 0 and context.ir[ownerIndex].operand1 >= 0 and regionBorrowText.symbol == context.ir[context.ir[ownerIndex].operand1].symbol
                -> if { "%arg" -> print } else { "%v$(regionNode.operand0)" -> print }
            ", 0" -> println
            "  %v$(regionNodeIndex)_length = extractvalue %sollang.text " -> print
            regionBorrowText.kind == 5 and ownerIndex >= 0 and context.ir[ownerIndex].operand1 >= 0 and regionBorrowText.symbol == context.ir[context.ir[ownerIndex].operand1].symbol
                -> if { "%arg" -> print } else { "%v$(regionNode.operand0)" -> print }
            ", 1" -> println
            "  %v$(regionNodeIndex)_value0 = insertvalue %sollang.source_text poison, ptr %v$(regionNodeIndex)_data, 0" -> println
            "  %v$(regionNodeIndex)_value1 = insertvalue %sollang.source_text %v$(regionNodeIndex)_value0, i64 %v$(regionNodeIndex)_length, 1" -> println
            "  %v$(regionNodeIndex)_value2 = insertvalue %sollang.source_text %v$(regionNodeIndex)_value1, ptr null, 2" -> println
            "  %v$(regionNodeIndex) = insertvalue %sollang.source_text %v$(regionNodeIndex)_value2, i64 0, 3" -> println
        }
    (regionNode.kind == 6 or regionNode.kind == 9) and (regionNode.opcode == -215 or regionNode.opcode == typedIr.pathAbsoluteOpcode())
        -> if {
            DirectoryCallRequest { callIndex: regionNodeIndex, ownerIndex: ownerIndex } -> emitDirectoryCall(context, state)
        }
    regionNode.kind == 6 and regionNode.opcode == -233
        -> if {
            DirectoryCallRequest { callIndex: regionNodeIndex, ownerIndex: ownerIndex } -> emitCreateDirectoryCall(context, state)
        }
    regionNode -> typedIr.isArenaConstructorCall
        -> if {
            WhileValueRequest { whileIndex: regionNodeIndex, ownerIndex: ownerIndex, nodeIndex: 0 } -> emitArenaConstructor(context, state)
        }
    regionNode.kind == 6 and regionNode.opcode <= -237 and regionNode.opcode >= -240
        -> if {
            WhileValueRequest { whileIndex: regionNodeIndex, ownerIndex: ownerIndex, nodeIndex: 0 } -> emitCollectionConstructor(context, state)
        }
    (regionNode.kind == 9 or regionNode.kind == 6) and regionNode.opcode == -229 and regionNode.operand0 >= 0 and regionNode.operand1 >= 0
        -> if {
            WhileValueRequest { whileIndex: regionNodeIndex, ownerIndex: ownerIndex, nodeIndex: 0 } -> emitTextMaterialize(context, state)
            regionNode.symbol == -101 or regionNode.symbol == -102 or regionNode.symbol == -116 or regionNode.symbol == -117
                -> if {
                    "  %v$(regionNodeIndex)_console_ptr = extractvalue %sollang.text %v$(regionNodeIndex), 0" -> println
                    "  %v$(regionNodeIndex)_console_len = extractvalue %sollang.text %v$(regionNodeIndex), 1" -> println
                    regionNode.symbol == -116 or regionNode.symbol == -117
                        -> if {
                            "  call void @sollang_runtime_eprint(ptr %v$(regionNodeIndex)_console_ptr, i64 %v$(regionNodeIndex)_console_len, i1 " -> print
                            regionNode.symbol == -116 -> if { "true)" -> println } else { "false)" -> println }
                        } else {
                            "  call void @sollang_runtime_print(ptr %v$(regionNodeIndex)_console_ptr, i64 %v$(regionNodeIndex)_console_len, i1 " -> print
                            regionNode.symbol == -102 -> if { "true)" -> println } else { "false)" -> println }
                        }
                }
        }
}

emitRegionArrayExpressions regionNodeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[regionNodeIndex] => regionNode
    regionNodeIndex -> emptyArrayCallParameter(context, state) => regionEmptyArrayParameter
    false => regionContextualSlice!
    regionEmptyArrayParameter >= 0 -> if {
        context.ir[regionEmptyArrayParameter] => regionEmptyArrayParameterNode
        regionEmptyArrayParameterNode.typeKind == 2 or regionEmptyArrayParameterNode.typeOrigin == 12
            -> if { true => regionContextualSlice! }
    }
    regionNode.kind == 14 and ((regionNode -> isDynamicArrayType) or (regionNode -> isFixedArrayType) or (regionNode -> isSliceArrayType) or regionContextualSlice!)
        -> if {
            0 => regionArrayOperandCount!
            regionNode.operand0 => regionArrayCountIndex!
            regionArrayCountIndex! >= 0 -> while {
                regionArrayOperandCount! + 1 => regionArrayOperandCount!
                context.ir[regionArrayCountIndex!].nextOperand => regionArrayCountIndex!
            }
            regionNode -> arrayLiteralLength(regionArrayOperandCount!, context) => regionArrayLength
            regionNode -> arrayLiteralCapacity(regionArrayLength, context) => regionArrayCapacity
            regionArrayCapacity * (regionNode -> arrayElementSize(context, state)) => regionArrayByteLength
            regionNodeIndex -> staticReadonlyArrayReturnFunction(context) => staticFunction
            staticFunction >= 0 -> if {
                "  %v$(regionNodeIndex)_data = getelementptr [$(regionArrayLength) x " -> print
                regionNode -> writeArrayElementType(context, state)
                "], ptr " -> print
                staticFunction -> writeStaticReadonlyArraySymbol(regionNodeIndex, context)
                ", i64 0, i64 0" -> println
            } else {
                (not (regionNode -> isFixedArrayType)) or (regionNodeIndex -> fixedArrayLiteralNeedsHeap(context, state))
                    -> if {
                        regionNode.typeId >= 0 and context.types[regionNode.typeId].kind == 12
                            -> if {
                                ArrayStorageIdentity { resultDomain: 0, resultIndex: regionNodeIndex, labelIndex: -1 }
                                    -> emitArrayStackBacking(regionArrayByteLength, regionNode -> arrayElementAlign(context, state))
                            } else { regionArrayByteLength == 0 -> if {
                                    regionNodeIndex -> freshEmptyArrayCallParameter(context, state) => emptyCallParameter
                                    emptyCallParameter >= 0 or (regionNode -> isFixedArrayType)
                                        -> if {
                                            (emptyCallParameter >= 0 -> if {
                                                context.ir[emptyCallParameter] -> arrayElementSize(context, state)
                                            } else { regionNode -> arrayElementSize(context, state) }) => emptyRegionFixedStorageBytes
                                            ArrayStorageIdentity { resultDomain: 0, resultIndex: regionNodeIndex, labelIndex: -1 } -> emitArrayHeapBacking(emptyRegionFixedStorageBytes)
                                        } else { ArrayStorageIdentity { resultDomain: 0, resultIndex: regionNodeIndex, labelIndex: -1 } -> emitArrayHeapBacking(0) }
                                } else {
                                    ArrayStorageIdentity { resultDomain: 0, resultIndex: regionNodeIndex, labelIndex: -1 } -> emitArrayHeapBacking(regionArrayByteLength)
                            } }
                    }
                regionNode.operand0 => regionArrayElementIndex!
                0 => regionArrayElementPosition!
                regionArrayElementIndex! >= 0 and regionArrayElementPosition! < regionArrayLength
                    -> while {
                        context.ir[regionArrayElementIndex!] => regionArrayElement
                        ArrayStorageIdentity { resultDomain: 0, resultIndex: regionNodeIndex, labelIndex: -1 }
                            -> emitArrayValueElementStore(regionArrayElementPosition!, regionNode -> arrayElementTypeId(context, state), regionNode.typeSymbol, regionArrayElementIndex!, ownerIndex, context, state)
                        regionArrayOperandCount! > 1 -> if { regionArrayElement.nextOperand => regionArrayElementIndex! }
                        regionArrayElementPosition! + 1 => regionArrayElementPosition!
                    }
            }
            ArrayStorageIdentity { resultDomain: 0, resultIndex: regionNodeIndex, labelIndex: -1 } -> emitArrayStorageCarrier(regionArrayLength, regionArrayCapacity, (regionNode -> isFixedArrayType) or (regionNode -> isSliceArrayType) or regionContextualSlice!)
            regionNodeIndex -> emitAggregatePartialMoveCleanup(ownerIndex, context, state)
        }
    regionNode.kind == 14 and regionNode.operand0 < 0 and not (regionNode -> isDynamicArrayType) and not (regionNode -> isFixedArrayType) and not (regionNode -> isSliceArrayType) and not regionContextualSlice!
        -> if {
            "; sollang compiler error S039: empty array literal has no canonical slice, fixed, or growable ABI at ir $regionNodeIndex" -> println
        }
    regionNode -> isEmptyBoundedDictionaryLiteral(context)
        -> if { regionNodeIndex -> emitEmptyBoundedDictionaryLiteral(context) }
    regionNode -> isPopulatedBoundedDictionaryLiteral(context)
        -> if { regionNodeIndex -> emitPopulatedBoundedDictionaryLiteral(ownerIndex, context, state) }
    regionNode.kind == 16 and regionNode.typeOrigin == 15
        and not (regionNode -> isEmptyBoundedDictionaryLiteral(context))
        and not (regionNode -> isPopulatedBoundedDictionaryLiteral(context))
        -> if {
            0 => regionDictionaryItemCount!
            regionNode.operand0 => regionDictionaryCountIndex!
            regionDictionaryCountIndex! >= 0 -> while {
                regionDictionaryItemCount! + 1 => regionDictionaryItemCount!
                context.ir[regionDictionaryCountIndex!].nextOperand => regionDictionaryCountIndex!
            }
            regionDictionaryItemCount! / 2 => regionDictionaryLength
            regionDictionaryLength -> dictionaryLiteralCapacity(regionNode.opcode) => regionDictionaryCapacity
            regionNode.operand0 => regionDictionaryItemStart
            -1 => regionDictionaryKeyTypeId!
            -1 => regionDictionaryValueTypeId!
            regionNode.typeId >= 0 -> if {
                context.types[regionNode.typeId] => canonicalRegionDictionaryType
                canonicalRegionDictionaryType.kind == 5 or canonicalRegionDictionaryType.kind == 13
                    -> if {
                        canonicalRegionDictionaryType.first => regionDictionaryKeyTypeId!
                        canonicalRegionDictionaryType.second => regionDictionaryValueTypeId!
                    }
            }
            regionNode.typeModule -> storageSize(context, state) => regionDictionaryKeyStorageSize!
            regionNode.typeSymbol -> storageSize(context, state) => regionDictionaryValueStorageSize!
            regionNode.typeModule -> legacyStorageAlign(context, state) => regionDictionaryKeyStorageAlign!
            regionNode.typeSymbol -> legacyStorageAlign(context, state) => regionDictionaryValueStorageAlign!
            regionDictionaryKeyTypeId! >= 0 -> if {
                context.typeSizes[regionDictionaryKeyTypeId!] => regionDictionaryKeyStorageSize!
                context.typeAligns[regionDictionaryKeyTypeId!] => regionDictionaryKeyStorageAlign!
            }
            regionDictionaryValueTypeId! >= 0 -> if {
                context.typeSizes[regionDictionaryValueTypeId!] => regionDictionaryValueStorageSize!
                context.typeAligns[regionDictionaryValueTypeId!] => regionDictionaryValueStorageAlign!
            }
            regionDictionaryItemStart => regionDictionaryFirstKeyIndex
            -1 => regionControlHashWidth!
            regionDictionaryCapacity > 0 and regionDictionaryKeyTypeId! >= 0
                and regionDictionaryKeyTypeId! < (context.types -> len)
                -> if {
                    context.types[regionDictionaryKeyTypeId!] => regionControlKeyType
                    regionControlKeyType.kind == 1 and regionControlKeyType.origin == 1
                        -> if {
                            regionControlKeyType.symbol == 23
                                -> if { 1 => regionControlHashWidth! } else {
                                    (regionControlKeyType.symbol -> integerWidth(context, state)) > 0
                                        -> if {
                                            regionDictionaryKeyStorageSize! == 1
                                                -> if { 8 => regionControlHashWidth! }
                                            regionDictionaryKeyStorageSize! == 2
                                                -> if { 16 => regionControlHashWidth! }
                                            regionDictionaryKeyStorageSize! == 4
                                                -> if { 32 => regionControlHashWidth! }
                                            regionDictionaryKeyStorageSize! == 8
                                                -> if { 64 => regionControlHashWidth! }
                                        }
                                }
                        }
                }
            -1 => regionControlHashMethod!
            regionDictionaryKeyTypeId! >= 0 -> if { regionDictionaryKeyTypeId! -> traitMethodSymbol("Hash", "hash", context, state) => regionControlHashMethod! }
            regionDictionaryFirstKeyIndex >= 0 and context.ir[regionDictionaryFirstKeyIndex].nextOperand >= 0
                -> if {
                    (context.ir[context.ir[regionDictionaryFirstKeyIndex].nextOperand].typeKind == 8) or (context.ir[context.ir[regionDictionaryFirstKeyIndex].nextOperand].typeId >= 0 and context.types[context.ir[context.ir[regionDictionaryFirstKeyIndex].nextOperand].typeId].kind == 8)
                        -> if {
                            context.pointerBitWidth / 8 => regionDictionaryValueStorageSize!
                            context.pointerBitWidth / 8 => regionDictionaryValueStorageAlign!
                        }
                }
            regionDictionaryKeyStorageSize! -> dictionaryEntryLayout(regionDictionaryKeyStorageAlign!, regionDictionaryValueStorageSize!, regionDictionaryValueStorageAlign!) => regionDictionaryEntryLayout
            regionDictionaryCapacity == 0 -> if {
                "  %v$(regionNodeIndex)_storage = getelementptr i8, ptr null, i64 0" -> println
                "v$(regionNodeIndex)" -> emitGrowableDictionaryPointers("%v$(regionNodeIndex)_storage", "0", regionDictionaryEntryLayout)
            } else {
                "v$(regionNodeIndex)" -> emitGrowableDictionaryAllocation("$(regionDictionaryCapacity)", regionDictionaryEntryLayout)
            }
            regionDictionaryItemStart => regionDictionaryItemIndex!
            0 => regionDictionaryItemPosition!
            regionDictionaryItemIndex! >= 0 -> while {
                context.ir[regionDictionaryItemIndex!] => regionDictionaryItem
                regionDictionaryItemPosition! / 2 => regionDictionaryEntryPosition
                regionDictionaryItemPosition! % 2 == 0 -> if { "keys" } else { "values" } => regionDictionarySide
                regionDictionaryItemPosition! % 2 == 0 -> if { regionNode.typeModule } else { regionNode.typeSymbol } => regionDictionaryItemSymbol
                regionDictionaryItemPosition! % 2 == 0 -> if { regionDictionaryKeyTypeId! } else { regionDictionaryValueTypeId! } => regionDictionaryItemTypeId
                regionDictionaryItemPosition! % 2 == 0 -> if {
                    DictionaryLiteralSlotRequest { dictionaryIndex: regionNodeIndex, ownerIndex: ownerIndex, entryPosition: regionDictionaryEntryPosition, keyIndex: regionDictionaryItemIndex!, keyTypeId: regionDictionaryKeyTypeId!, hashWidth: regionControlHashWidth!, hashMethod: regionControlHashMethod!, capacity: regionDictionaryCapacity, valueTypeId: regionDictionaryValueTypeId!, valueSymbol: regionNode.typeSymbol, entryLayout: regionDictionaryEntryLayout } -> emitDictionaryLiteralSlot(context, state)
                }
                regionDictionaryItemTypeId >= 0 and context.types[regionDictionaryItemTypeId].kind == 12
                    -> if {
                        Arena(0) => boundedPrefixStorage!
                        "v$(regionNodeIndex)_$(regionDictionarySide)_bounded$(regionDictionaryEntryPosition)" -> materialize(boundedPrefixStorage!) => boundedPrefix
                        boundedPrefix -> emitBoundedArrayValue(regionDictionaryItemIndex!, ownerIndex, regionDictionaryItemTypeId, context, state)
                    }
                "  %v$(regionNodeIndex)_$(regionDictionarySide)_ptr$(regionDictionaryEntryPosition) = getelementptr " -> print
                regionDictionaryEntryLayout -> writeDictionaryEntryStorageType
                ", ptr %v$(regionNodeIndex)_$(regionDictionarySide), i64 %v$(regionNodeIndex)_literal$(regionDictionaryEntryPosition)_slot" -> println
                "  store " -> print
                regionDictionaryItem.typeKind == 8 or (regionDictionaryItem.typeId >= 0 and context.types[regionDictionaryItem.typeId].kind == 8)
                    -> if { "ptr" -> print } else { regionDictionaryItemTypeId >= 0
                            -> if { regionDictionaryItemTypeId -> writeSemanticTypeId(context, state) } else { regionDictionaryItemSymbol -> llvmType(context, state) -> print } }
                " " -> print
                regionDictionaryItemTypeId >= 0 and context.types[regionDictionaryItemTypeId].kind == 12
                    -> if { "%v$(regionNodeIndex)_$(regionDictionarySide)_bounded$(regionDictionaryEntryPosition)" -> print } else {
                        regionDictionaryItemIndex! -> writeDictionaryLiteralItem(ownerIndex, context, state)
                    }
                ", ptr %v$(regionNodeIndex)_$(regionDictionarySide)_ptr$(regionDictionaryEntryPosition), align " -> print
                regionDictionaryItem.typeKind == 8 or (regionDictionaryItem.typeId >= 0 and context.types[regionDictionaryItem.typeId].kind == 8)
                    -> if { context.pointerBitWidth / 8 -> writeDecimalLine } else { regionDictionaryItemTypeId >= 0
                            -> if { context.typeAligns[regionDictionaryItemTypeId] -> writeDecimalLine } else { regionDictionaryItemSymbol -> legacyStorageAlign(context, state) -> writeDecimalLine } }
                regionDictionaryItemPosition! % 2 == 0 -> if {
                    "v$(regionNodeIndex)_literal$(regionDictionaryEntryPosition)_control" -> emitDictionaryControlStore("%v$(regionNodeIndex)_controls", "%v$(regionNodeIndex)_literal$(regionDictionaryEntryPosition)_slot", "%v$(regionNodeIndex)_literal$(regionDictionaryEntryPosition)_h2", "$(regionDictionaryCapacity)")
                }
                regionDictionaryItem.nextOperand => regionDictionaryItemIndex!
                regionDictionaryItemPosition! + 1 => regionDictionaryItemPosition!
            }
            "v$(regionNodeIndex)" -> emitGrowableDictionaryOwner("%v$(regionNodeIndex)_storage", "$(regionDictionaryLength)", "$(regionDictionaryCapacity)")
        }
}

emitIndexRead regionNodeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[regionNodeIndex] => regionNode
    regionNode.kind == 15 and (context.ir[regionNode.operand0] -> boundedDictionaryValueTypeId(context)) >= 0
        -> if {
            regionNodeIndex -> emitBoundedDictionaryIndex(ownerIndex, context, state)
            return
        }
    regionNode.kind == 15 -> if {
        context.ir[regionNode.operand0] => regionIndexedValue
        context.ir[regionNode.operand1] => regionIndexValue
        regionIndexedValue.typeId => regionIndexedContainerTypeId!
        false => regionIndexedReadonlyReference!
        regionIndexedContainerTypeId! >= 0 and context.types[regionIndexedContainerTypeId!].kind == 8
            -> if {
                context.types[regionIndexedContainerTypeId!].first => regionIndexedContainerTypeId!
                true => regionIndexedReadonlyReference!
                "v$(regionNodeIndex)_indexed_source" -> emitIndexedReadonlySource(regionNode.operand0, ownerIndex, regionIndexedContainerTypeId!, context, state)
            }
        regionNode.operand0 -> mutableBorrowParameterOrdinal(ownerIndex, context, state) => regionIndexedMutableParameterOrdinal
        -1 => regionIndexedMutableParameterIndex!
        regionIndexedMutableParameterOrdinal >= 0 -> if {
            context -> parameterIndexAtOrdinal(ownerIndex, regionIndexedMutableParameterOrdinal) => regionIndexedMutableParameterIndex!
        }
        (regionIndexedMutableParameterIndex! >= 0
            and (context.ir[regionIndexedMutableParameterIndex!] -> mutableBorrowUsesStructPointer(context))) => regionIndexedMutableUsesStructPointer
        ((regionIndexedValue -> isDictionaryType)
            or (regionIndexedReadonlyReference! and context.types[regionIndexedContainerTypeId!].kind == 5)) => regionIndexedIsDictionary
        regionIndexedValue -> isArgumentsType -> if {
            regionIndexValue -> integerReadNodeWidth(context, state) => regionArgumentIndexWidth
            regionIndexValue.kind != 3 and regionArgumentIndexWidth > 0 and regionArgumentIndexWidth < 64
                -> if {
                    "  %v$(regionNodeIndex)_argument_index = " -> print
                    regionIndexValue -> integerNodeSigned(context, state)
                        -> if { "sext " -> print } else { "zext " -> print }
                    "i$(regionArgumentIndexWidth)" -> print
                    " " -> print
                    regionNode.operand1 -> writeValue(ownerIndex, context, state)
                    " to i64" -> println
                }
            "  %v$(regionNodeIndex) = call %sollang.text @sollang_argument(i64 " -> print
            regionIndexValue.kind == 3 -> if {
                regionIndexValue -> writeIntegerLiteral(context, state)
            } else {
                regionArgumentIndexWidth > 0 and regionArgumentIndexWidth < 64
                    -> if { "%v$(regionNodeIndex)_argument_index" -> print } else {
                        regionNode.operand1 -> writeValue(ownerIndex, context, state)
                    }
            }
            ")" -> println
        } else {
            regionIndexedIsDictionary -> if {
                regionNode.operand0 -> mutableStorageRoot(context, state) => regionIndexedMutableRoot
                regionIndexedMutableRoot >= 0 -> if { "  %v$(regionNodeIndex)_dictionary = load %sollang.dict, ptr %slot$(regionIndexedMutableRoot), align 8" -> println }
                -1 => regionIndexedDictionaryKeyTypeId!
                -1 => regionIndexedDictionaryValueTypeId!
                regionIndexedContainerTypeId! >= 0 -> if {
                    context.types[regionIndexedContainerTypeId!] => regionIndexedDictionaryType
                    regionIndexedDictionaryType.kind == 5 or regionIndexedDictionaryType.kind == 13
                        -> if {
                            regionIndexedDictionaryType.first => regionIndexedDictionaryKeyTypeId!
                            regionIndexedDictionaryType.second => regionIndexedDictionaryValueTypeId!
                        }
                }
                "  %v$(regionNodeIndex)_storage = extractvalue %sollang.dict " -> print
                regionIndexedMutableRoot >= 0 -> if { "%v$(regionNodeIndex)_dictionary" -> print } else { regionIndexedReadonlyReference!
                        -> if { "%v$(regionNodeIndex)_indexed_source" -> print } else { regionNode.operand0 -> writeValue(ownerIndex, context, state) } }
                ", 0" -> println
                "  %v$(regionNodeIndex)_length = extractvalue %sollang.dict " -> print
                regionIndexedMutableRoot >= 0 -> if { "%v$(regionNodeIndex)_dictionary" -> print } else { regionIndexedReadonlyReference!
                        -> if { "%v$(regionNodeIndex)_indexed_source" -> print } else { regionNode.operand0 -> writeValue(ownerIndex, context, state) } }
                ", 1" -> println
                "  %v$(regionNodeIndex)_capacity = extractvalue %sollang.dict " -> print
                regionIndexedMutableRoot >= 0 -> if { "%v$(regionNodeIndex)_dictionary" -> print } else { regionIndexedReadonlyReference!
                        -> if { "%v$(regionNodeIndex)_indexed_source" -> print } else { regionNode.operand0 -> writeValue(ownerIndex, context, state) } }
                ", 2" -> println
                -1 => regionIndexedDictionaryKeyStorageSize!
                regionIndexedDictionaryKeyTypeId! >= 0 -> if { context.typeSizes[regionIndexedDictionaryKeyTypeId!] => regionIndexedDictionaryKeyStorageSize! }
                regionIndexedDictionaryKeyStorageSize! < 0 -> if { regionIndexedValue.typeModule -> storageSize(context, state) => regionIndexedDictionaryKeyStorageSize! }
                regionIndexedDictionaryKeyTypeId! -> dictionaryEntryLayoutForTypeIds(regionIndexedDictionaryValueTypeId!, regionIndexedValue.typeModule, regionIndexedValue.typeSymbol, context, state) => regionIndexedDictionaryEntryLayout
                "v$(regionNodeIndex)" -> emitGrowableDictionaryPointers("%v$(regionNodeIndex)_storage", "%v$(regionNodeIndex)_capacity", regionIndexedDictionaryEntryLayout)
                -1 => regionIndexedDictionaryHashWidth!
                regionIndexedDictionaryKeyTypeId! >= 0 and regionIndexedDictionaryKeyTypeId! < (context.types -> len)
                    -> if {
                        context.types[regionIndexedDictionaryKeyTypeId!] => regionIndexedDictionaryKeyType
                        regionIndexedDictionaryKeyType.kind == 1 and regionIndexedDictionaryKeyType.origin == 1
                            -> if {
                                regionIndexedDictionaryKeyType.symbol == 23
                                    -> if { 1 => regionIndexedDictionaryHashWidth! } else {
                                        (regionIndexedDictionaryKeyType.symbol -> integerWidth(context, state)) > 0
                                            -> if {
                                                regionIndexedDictionaryKeyStorageSize! == 1
                                                    -> if { 8 => regionIndexedDictionaryHashWidth! }
                                                regionIndexedDictionaryKeyStorageSize! == 2
                                                    -> if { 16 => regionIndexedDictionaryHashWidth! }
                                                regionIndexedDictionaryKeyStorageSize! == 4
                                                    -> if { 32 => regionIndexedDictionaryHashWidth! }
                                                regionIndexedDictionaryKeyStorageSize! == 8
                                                    -> if { 64 => regionIndexedDictionaryHashWidth! }
                                            }
                                    }
                            }
                    }
                -1 => regionIndexedDictionaryHashMethod!
                regionIndexedDictionaryKeyTypeId! >= 0 -> if { regionIndexedDictionaryKeyTypeId! -> traitMethodSymbol("Hash", "hash", context, state) => regionIndexedDictionaryHashMethod! }
                regionIndexedDictionaryHashWidth! > 0 and regionIndexedDictionaryHashWidth! <= 64
                    -> if {
                        "  %v$(regionNodeIndex)_hash_key = " -> print
                        regionIndexedDictionaryHashWidth! == 64 -> if { "add i64 0, " -> print } else {
                            regionIndexValue -> integerNodeSigned(context, state)
                                -> if { "sext " -> print } else { "zext " -> print }
                            "i$(regionIndexedDictionaryHashWidth!) " -> print
                        }
                        regionIndexValue.kind == 3 or regionIndexValue.kind == 4
                            -> if {
                                regionIndexValue.kind == 3 -> if { regionIndexValue -> writeIntegerLiteral(context, state) } else {
                                    regionIndexValue -> sourceToken(context, state) => regionIndexedDictionaryHashToken
                                    (context.sources[regionIndexValue.sourceModule] -> byte(regionIndexedDictionaryHashToken.span.start)) == 116
                                        -> if { "1" -> print } else { "0" -> print }
                                }
                            } else {
                                regionNode.operand1 -> writeValue(ownerIndex, context, state)
                            }
                        regionIndexedDictionaryHashWidth! == 64 -> if { "" -> println } else { " to i64" -> println }
                        "  %v$(regionNodeIndex)_hash_high = lshr i64 %v$(regionNodeIndex)_hash_key, 32" -> println
                        "  %v$(regionNodeIndex)_hash_fold = xor i64 %v$(regionNodeIndex)_hash_key, %v$(regionNodeIndex)_hash_high" -> println
                        "  %v$(regionNodeIndex)_hash = mul i64 %v$(regionNodeIndex)_hash_fold, -7046029254386353131" -> println
                        "  %v$(regionNodeIndex)_h2_shifted = lshr i64 %v$(regionNodeIndex)_hash, 57" -> println
                        "  %v$(regionNodeIndex)_h2_raw = and i64 %v$(regionNodeIndex)_h2_shifted, 127" -> println
                        "  %v$(regionNodeIndex)_h2_zero = icmp eq i64 %v$(regionNodeIndex)_h2_raw, 0" -> println
                        "  %v$(regionNodeIndex)_h2_value = select i1 %v$(regionNodeIndex)_h2_zero, i64 1, i64 %v$(regionNodeIndex)_h2_raw" -> println
                        "  %v$(regionNodeIndex)_h2 = trunc i64 %v$(regionNodeIndex)_h2_value to i8" -> println
                        "  %v$(regionNodeIndex)_start_slot = urem i64 %v$(regionNodeIndex)_hash, %v$(regionNodeIndex)_capacity" -> println
                    } else {
                        regionIndexValue -> isTextType -> if {
                            "  %v$(regionNodeIndex)_hash = call i64 @sollang_dictionary_hash_text(%sollang.text " -> print
                            regionNode.operand1 -> writeValue(ownerIndex, context, state)
                            ")" -> println
                            "  %v$(regionNodeIndex)_h2_shifted = lshr i64 %v$(regionNodeIndex)_hash, 57" -> println
                            "  %v$(regionNodeIndex)_h2_raw = and i64 %v$(regionNodeIndex)_h2_shifted, 127" -> println
                            "  %v$(regionNodeIndex)_h2_zero = icmp eq i64 %v$(regionNodeIndex)_h2_raw, 0" -> println
                            "  %v$(regionNodeIndex)_h2_value = select i1 %v$(regionNodeIndex)_h2_zero, i64 1, i64 %v$(regionNodeIndex)_h2_raw" -> println
                            "  %v$(regionNodeIndex)_h2 = trunc i64 %v$(regionNodeIndex)_h2_value to i8" -> println
                            "  %v$(regionNodeIndex)_start_slot = urem i64 %v$(regionNodeIndex)_hash, %v$(regionNodeIndex)_capacity" -> println
                        } else {
                            regionIndexedDictionaryHashMethod! >= 0 -> if {
                                context.types[regionIndexedDictionaryKeyTypeId!] => regionIndexedDictionaryHashKeyType
                                "  %v$(regionNodeIndex)_hash_value = call i32 @sollang_m$(regionIndexedDictionaryHashKeyType.module)_s$(regionIndexedDictionaryHashMethod!)(" -> print
                                regionIndexedDictionaryKeyTypeId! -> writeSemanticTypeId(context, state)
                                " " -> print
                                regionNode.operand1 -> writeValue(ownerIndex, context, state)
                                ")" -> println
                                "  %v$(regionNodeIndex)_hash_key = sext i32 %v$(regionNodeIndex)_hash_value to i64" -> println
                                "  %v$(regionNodeIndex)_hash_high = lshr i64 %v$(regionNodeIndex)_hash_key, 32" -> println
                                "  %v$(regionNodeIndex)_hash_fold = xor i64 %v$(regionNodeIndex)_hash_key, %v$(regionNodeIndex)_hash_high" -> println
                                "  %v$(regionNodeIndex)_hash = mul i64 %v$(regionNodeIndex)_hash_fold, -7046029254386353131" -> println
                                "  %v$(regionNodeIndex)_h2_shifted = lshr i64 %v$(regionNodeIndex)_hash, 57" -> println
                                "  %v$(regionNodeIndex)_h2_raw = and i64 %v$(regionNodeIndex)_h2_shifted, 127" -> println
                                "  %v$(regionNodeIndex)_h2_zero = icmp eq i64 %v$(regionNodeIndex)_h2_raw, 0" -> println
                                "  %v$(regionNodeIndex)_h2_value = select i1 %v$(regionNodeIndex)_h2_zero, i64 1, i64 %v$(regionNodeIndex)_h2_raw" -> println
                                "  %v$(regionNodeIndex)_h2 = trunc i64 %v$(regionNodeIndex)_h2_value to i8" -> println
                                "  %v$(regionNodeIndex)_start_slot = urem i64 %v$(regionNodeIndex)_hash, %v$(regionNodeIndex)_capacity" -> println
                            } else {
                                "  %v$(regionNodeIndex)_h2 = add i8 0, 1" -> println
                                "  %v$(regionNodeIndex)_start_slot = add i64 0, 0" -> println
                            }
                        }
                    }
                "  %v$(regionNodeIndex)_query = freeze " -> print
                regionIndexedDictionaryKeyTypeId! >= 0 -> if { regionIndexedDictionaryKeyTypeId! -> writeSemanticTypeId(context, state) } else { regionIndexedValue.typeModule -> llvmType(context, state) -> print }
                " " -> print
                regionNode.operand1 -> writeValue(ownerIndex, context, state)
                "" -> println
                Arena(0) => probePrefixStorage!
                "v$(regionNodeIndex)_probe" -> materialize(probePrefixStorage!) => probePrefix
                Arena(0) => probeControlsStorage!
                "%v$(regionNodeIndex)_controls" -> materialize(probeControlsStorage!) => probeControls
                Arena(0) => probeKeysStorage!
                "%v$(regionNodeIndex)_keys" -> materialize(probeKeysStorage!) => probeKeys
                Arena(0) => probeCapacityStorage!
                "%v$(regionNodeIndex)_capacity" -> materialize(probeCapacityStorage!) => probeCapacity
                Arena(0) => probeQueryStorage!
                "%v$(regionNodeIndex)_query" -> materialize(probeQueryStorage!) => probeQuery
                Arena(0) => probeHashStorage!
                "%v$(regionNodeIndex)_hash" -> materialize(probeHashStorage!) => probeHash
                Arena(0) => probeH2Storage!
                "%v$(regionNodeIndex)_h2" -> materialize(probeH2Storage!) => probeH2
                DictionaryProbe {
                    prefix: probePrefix
                    controls: probeControls
                    keys: probeKeys
                    capacity: probeCapacity
                    query: probeQuery
                    hash: probeHash
                    h2: probeH2
                    keyTypeId: regionIndexedDictionaryKeyTypeId!
                    keySymbol: regionIndexedValue.typeModule
                    valueTypeId: regionIndexedDictionaryValueTypeId!
                    valueSymbol: regionIndexedValue.typeSymbol
                    entryLayout: regionIndexedDictionaryEntryLayout
                    existingOnly: true
                    bounded: false
                } => indexedProbe
                indexedProbe -> emitDictionaryFindSlot(context, state)
                "  br i1 %v$(regionNodeIndex)_probe_found, label %dict$(regionNodeIndex)_hit, label %dict$(regionNodeIndex)_missing" -> println
                "dict$(regionNodeIndex)_missing:" -> println
                "  call void @llvm.trap()" -> println
                "  unreachable" -> println
                "dict$(regionNodeIndex)_hit:" -> println
                "  %v$(regionNodeIndex)_group_candidate_slot = add i64 %v$(regionNodeIndex)_probe_slot, 0" -> println
                "  %v$(regionNodeIndex)_value_ptr = getelementptr " -> print
                regionIndexedDictionaryEntryLayout -> writeDictionaryEntryStorageType
                ", ptr %v$(regionNodeIndex)_values, i64 %v$(regionNodeIndex)_group_candidate_slot" -> println
                "  " -> print
                regionNodeIndex -> writeMemberStorageValueName(context, state)
                " = load " -> print
                regionIndexedDictionaryValueTypeId! >= 0 -> if { regionIndexedDictionaryValueTypeId! -> writeSemanticTypeId(context, state) } else { regionIndexedValue.typeSymbol -> llvmType(context, state) -> print }
                ", ptr %v$(regionNodeIndex)_value_ptr, align " -> print
                regionIndexedDictionaryValueTypeId! >= 0 -> if { context.typeAligns[regionIndexedDictionaryValueTypeId!] -> writeDecimalLine } else { regionIndexedValue.typeSymbol -> legacyStorageAlign(context, state) -> writeDecimalLine }
            } else {
                regionIndexedMutableParameterOrdinal >= 0 and not regionIndexedMutableUsesStructPointer
                    -> if {
                        "  %v$(regionNodeIndex)_data = load ptr, ptr " -> print
                        regionIndexedMutableParameterOrdinal == 0 -> if { "%arg_mut_ptr_addr" -> print } else { "%arg$(regionIndexedMutableParameterOrdinal)_mut_ptr_addr" -> print }
                        ", align 8" -> println
                        "  %v$(regionNodeIndex)_length = load i64, ptr " -> print
                        regionIndexedMutableParameterOrdinal == 0 -> if { "%arg_mut_len_addr" -> print } else { "%arg$(regionIndexedMutableParameterOrdinal)_mut_len_addr" -> print }
                        ", align 8" -> println
                    } else {
                        "  %v$(regionNodeIndex)_data = extractvalue " -> print
                        regionIndexedReadonlyReference! -> if {
                            regionIndexedContainerTypeId! -> writeIndexedSourceType(context, state)
                        } else {
                            regionIndexedValue -> writeIrType(context, state)
                        }
                        " " -> print
                        regionIndexedReadonlyReference! -> if { "%v$(regionNodeIndex)_indexed_source" -> print } else { regionNode.operand0 -> writeValue(ownerIndex, context, state) }
                        ", 0" -> println
                        "  %v$(regionNodeIndex)_length = extractvalue " -> print
                        regionIndexedReadonlyReference! -> if {
                            regionIndexedContainerTypeId! -> writeIndexedSourceType(context, state)
                        } else {
                            regionIndexedValue -> writeIrType(context, state)
                        }
                        " " -> print
                        regionIndexedReadonlyReference! -> if { "%v$(regionNodeIndex)_indexed_source" -> print } else { regionNode.operand0 -> writeValue(ownerIndex, context, state) }
                        ", 1" -> println
                    }
                false => regionNestedIndex!
                regionIndexValue -> integerReadNodeWidth(context, state) => regionIndexWidth!
                regionIndexValue -> integerNodeSigned(context, state) => regionIndexSigned!
                (regionIndexValue -> isDynamicArrayType) and regionIndexValue.nextOperand >= 0
                    -> if {
                        true => regionNestedIndex!
                        context.ir[regionIndexValue.nextOperand] => regionNestedSubscript
                        "  %v$(regionNodeIndex)_nested_data = extractvalue %sollang.array.i32 %v$(regionNode.operand1), 0" -> println
                        regionNestedSubscript -> integerReadNodeWidth(context, state) => regionNestedSubscriptWidth
                        regionNestedSubscript.kind != 3 and regionNestedSubscriptWidth > 0 and regionNestedSubscriptWidth < 64
                            -> if {
                                "  %v$(regionNodeIndex)_nested_index = " -> print
                                regionNestedSubscript -> integerNodeSigned(context, state)
                                    -> if { "sext " -> print } else { "zext " -> print }
                                "i$(regionNestedSubscriptWidth) %v$(regionIndexValue.nextOperand) to i64" -> println
                            }
                        "  %v$(regionNodeIndex)_nested_ptr = getelementptr " -> print
                        regionIndexValue -> writeArrayElementType(context, state)
                        ", ptr %v$(regionNodeIndex)_nested_data, i64 " -> print
                        regionNestedSubscript.kind == 3 -> if {
                            regionNestedSubscript -> writeIntegerLiteral(context, state)
                            "" -> println
                        } else {
                            regionNestedSubscriptWidth > 0 and regionNestedSubscriptWidth < 64
                                -> if { "%v$(regionNodeIndex)_nested_index" -> println } else { "%v$(regionIndexValue.nextOperand)" -> println }
                        }
                        regionIndexValue -> arrayElementTypeId(context, state) => regionNestedElementTypeId
                        "  %v$(regionNodeIndex)_nested_value = load " -> print
                        regionIndexValue -> writeArrayElementType(context, state)
                        ", ptr %v$(regionNodeIndex)_nested_ptr, align " -> print
                        regionIndexValue -> arrayElementAlign(context, state) -> writeDecimalLine
                        regionNestedElementTypeId >= 0 -> if {
                            context.types[regionNestedElementTypeId] => regionNestedElementType
                            regionNestedElementType.origin == 1 -> if {
                                regionNestedElementType.symbol -> integerWidth(context, state) => regionIndexWidth!
                                regionNestedElementType.symbol == 12 or regionNestedElementType.symbol == 13
                                    -> if { context.pointerBitWidth => regionIndexWidth! }
                                regionNestedElementType.symbol -> integerSigned(context, state) => regionIndexSigned!
                            }
                        }
                    }
                regionIndexValue.kind != 3 and regionIndexWidth! > 0 and regionIndexWidth! < 64
                    -> if {
                        "  %v$(regionNodeIndex)_index = " -> print
                        regionIndexSigned! -> if { "sext " -> print } else { "zext " -> print }
                        "i$(regionIndexWidth!) " -> print
                        regionNestedIndex! -> if { "%v$(regionNodeIndex)_nested_value" -> print } else {
                            regionNode.operand1 -> writeValue(ownerIndex, context, state)
                        }
                        " to i64" -> println
                    }
                "  %v$(regionNodeIndex)_in_bounds = icmp ult i64 " -> print
                regionIndexValue.kind == 3 -> if {
                    regionIndexValue -> writeIntegerLiteral(context, state)
                } else {
                    regionIndexWidth! > 0 and regionIndexWidth! < 64
                        -> if { "%v$(regionNodeIndex)_index" -> print } else {
                            regionNestedIndex! -> if { "%v$(regionNodeIndex)_nested_value" -> print } else {
                                regionNode.operand1 -> writeValue(ownerIndex, context, state)
                            }
                        }
                }
                ", %v$(regionNodeIndex)_length" -> println
                "  br i1 %v$(regionNodeIndex)_in_bounds, label %v$(regionNodeIndex)_index_ok, label %v$(regionNodeIndex)_index_fail" -> println
                "v$(regionNodeIndex)_index_fail:" -> println
                "  call void @llvm.trap()" -> println
                "  unreachable" -> println
                "v$(regionNodeIndex)_index_ok:" -> println
                "  %v$(regionNodeIndex)_ptr = getelementptr " -> print
                regionNode.typeId >= 0 -> if { regionNode.typeId -> writeAggregateFieldTypeId(context, state) } else { regionNode -> writeIrType(context, state) }
                ", ptr %v$(regionNodeIndex)_data, i64 " -> print
                regionIndexValue.kind == 3 -> if {
                    regionIndexValue -> writeIntegerLiteral(context, state)
                    "" -> println
                } else {
                    regionIndexWidth! > 0 and regionIndexWidth! < 64
                        -> if { "%v$(regionNodeIndex)_index" -> println } else {
                            regionNestedIndex! -> if { "%v$(regionNodeIndex)_nested_value" -> println } else {
                                regionNode.operand1 -> writeValue(ownerIndex, context, state)
                                "" -> println
                            }
                        }
                }
                "  " -> print
                regionNodeIndex -> writeMemberStorageValueName(context, state)
                " = load " -> print
                regionNode.typeId >= 0 -> if { regionNode.typeId -> writeAggregateFieldTypeId(context, state) } else { regionNode -> writeIrType(context, state) }
                ", ptr %v$(regionNodeIndex)_ptr, align " -> print
                regionNode -> storageAlign(context, state) -> writeDecimalLine
            }
        }
        regionNode -> boundedArrayValueTypeId(context, state) => indexedBoundedTypeId
        indexedBoundedTypeId >= 0 -> if {
            "v$(regionNodeIndex)" -> emitStoredBoundedValueHandle(indexedBoundedTypeId, context, state)
        }
    }
}

emitRegionOperatorExpressions regionNodeIndex: Int, ownerIndex: Int, emissionOrder: [Int], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[regionNodeIndex] => regionNode
    (regionNode.kind == 7 and regionNode.operand0 >= 0) or (regionNode.kind == 8 and regionNode.operand0 >= 0 and regionNode.operand1 >= 0)
        -> if {
            regionNode.kind == 8 and (regionNode.opcode == -24 or regionNode.opcode == -25)
                -> if {
                    regionNodeIndex -> emitLogicalValue(ownerIndex, emissionOrder, context, state)
                } else {
                    context.ir[regionNode.operand0] => regionLeft
                    0 => regionBinaryWidth!
                    false => regionLeftPromoted!
                    false => regionRightPromoted!
                    regionNode.kind == 8 -> if {
                        context.ir[regionNode.operand1] => regionRight
                        regionLeft -> integerNodeWidth(context, state) => regionLeftWidth!
                        regionRight -> integerNodeWidth(context, state) => regionRightWidth!
                        regionLeftWidth! <= 0 -> if {
                            regionLeft -> scalarReferenceValueTypeId(context, state) => regionLeftReferenceTypeId
                            regionLeftReferenceTypeId >= 0 -> if {
                                context.types[regionLeftReferenceTypeId].symbol -> integerWidth(context, state) => regionLeftWidth!
                            }
                        }
                        regionRightWidth! <= 0 -> if {
                            regionRight -> scalarReferenceValueTypeId(context, state) => regionRightReferenceTypeId
                            regionRightReferenceTypeId >= 0 -> if {
                                context.types[regionRightReferenceTypeId].symbol -> integerWidth(context, state) => regionRightWidth!
                            }
                        }
                        regionLeftWidth! > 0 and regionRightWidth! > 0
                            -> if {
                                regionLeftWidth! > regionRightWidth! -> if { regionLeftWidth! => regionBinaryWidth! } else { regionRightWidth! => regionBinaryWidth! }
                                IntegerPromotionRequest { expressionIndex: regionNodeIndex, operandIndex: regionNode.operand0, targetWidth: regionBinaryWidth!, ownerIndex: ownerIndex, right: false } -> emitIntegerPromotion(context, state) => regionLeftPromoted!
                                IntegerPromotionRequest { expressionIndex: regionNodeIndex, operandIndex: regionNode.operand1, targetWidth: regionBinaryWidth!, ownerIndex: ownerIndex, right: true } -> emitIntegerPromotion(context, state) => regionRightPromoted!
                            }
                    }
                    "" => regionOperation!
                    regionNode.kind == 7 -> if {
                        regionNode.opcode -> numericUnaryOperation(regionLeft.typeSymbol) => regionOperation!
                    } else {
                        regionNode.opcode == grammar.tokenIdPlus() -> if { "add" => regionOperation! }
                        regionNode.opcode == grammar.tokenIdMinus() -> if { "sub" => regionOperation! }
                        regionNode.opcode == grammar.tokenIdStar() -> if { "mul" => regionOperation! }
                        regionNode.opcode == grammar.tokenIdSlash() -> if { regionNode -> integerQuotientOperation(context, state) => regionOperation! }
                        regionNode.opcode == grammar.tokenIdPercent()
                            -> if { regionNode -> integerRemainderOperation(context, state) => regionOperation! }
                        regionNode.opcode == grammar.tokenIdEqualEqual()
                            -> if { "icmp eq" => regionOperation! }
                        regionNode.opcode == grammar.tokenIdBangEqual()
                            -> if { "icmp ne" => regionOperation! }
                        regionNode.opcode == grammar.tokenIdLess() or regionNode.opcode == grammar.tokenIdLessEqual() or regionNode.opcode == grammar.tokenIdGreater() or regionNode.opcode == grammar.tokenIdGreaterEqual()
                            -> if {
                                regionNode -> integerComparisonOperation(context, state) => regionOperation!
                            }
                        regionNode.opcode == -24 -> if { "or" => regionOperation! }
                        regionNode.opcode == -25 -> if { "and" => regionOperation! }
                        ((regionNode -> isValueComparison) and (regionNode.operand0 -> comparisonReadIsFloat(context)))
                            or (regionLeft.typeOrigin == 1 and regionLeft.typeSymbol >= 19 and regionLeft.typeSymbol <= 22)
                            -> if { regionNode.opcode -> floatBinaryOperation => regionOperation! }
                    }
                    regionNode.kind == 8
                        and (regionNode.opcode == grammar.tokenIdEqualEqual() or regionNode.opcode == grammar.tokenIdBangEqual())
                        and (regionNode.operand0 -> comparisonReadIsText(context))
                        and (regionNode.operand1 -> comparisonReadIsText(context)) => regionTextEquality
                    (regionNode -> isValueComparison) and not regionTextEquality
                        -> if {
                            "  %v$(regionNodeIndex) = $(regionOperation!) " -> print
                            regionNode.operand0 -> comparisonReadTypeId(context) -> writeAggregateFieldTypeId(context, state)
                            " " -> print
                            regionNode.operand0 -> writeComparisonOperandValue(ownerIndex, -1, context, state)
                            ", " -> print
                            regionNode.operand1 -> writeComparisonOperandValue(ownerIndex, -1, context, state)
                            "" -> println
                        } else {
                            regionTextEquality -> if {
                                regionNodeIndex -> emitDeferredTextComparisonOperands(ownerIndex, context, state)
                                regionNode.opcode == grammar.tokenIdBangEqual()
                                    -> if {
                                        "  %v$(regionNodeIndex)_text_equal = call i1 @sollang_text_equal(%sollang.text " -> print
                                    } else {
                                        "  %v$(regionNodeIndex) = call i1 @sollang_text_equal(%sollang.text " -> print
                                    }
                                regionNode.operand0 -> writeTextComparisonOperand(regionNodeIndex, ownerIndex, 0, -1, context, state)
                                ", %sollang.text " -> print
                                regionNode.operand1 -> writeTextComparisonOperand(regionNodeIndex, ownerIndex, 1, -1, context, state)
                                ")" -> println
                                regionNode.opcode == grammar.tokenIdBangEqual()
                                    -> if {
                                        "  %v$(regionNodeIndex) = xor i1 %v$(regionNodeIndex)_text_equal, true" -> println
                                    }
                            } else {
                                "  %v$(regionNodeIndex) = $(regionOperation!) " -> print
                                regionBinaryWidth! > 0 -> if { "i$(regionBinaryWidth!)" -> print } else { regionNode.kind == 7
                                        -> if { regionNode -> writeIrType(context, state) } else { regionLeft -> writeIrType(context, state) } }
                                " " -> print
                                regionNode.kind == 7 and regionNode.opcode != -26
                                    -> if { regionLeft.typeSymbol -> numericUnaryZero -> print } else {
                                        regionLeft.kind == 3 or regionLeft.kind == 4
                                            -> if {
                                                regionLeft -> sourceToken(context, state) => regionLeftToken
                                                regionLeft.kind == 3 -> if { regionLeft -> writeIntegerLiteral(context, state) } else {
                                                    (context.sources[regionLeft.sourceModule] -> byte(regionLeftToken.span.start)) == 116
                                                        -> if { "1" -> print } else { "0" -> print }
                                                }
                                            } else {
                                                regionLeftPromoted! -> if { "%v$(regionNodeIndex)_left_wide" -> print } else {
                                                    ownerIndex >= 0 and context.ir[ownerIndex].kind == 0 and context.ir[ownerIndex].operand1 >= 0 and regionLeft.kind == 5 and regionLeft.symbol == context.ir[context.ir[ownerIndex].operand1].symbol
                                                        -> if { "%arg" -> print } else { regionNode.operand0 -> writeValue(ownerIndex, context, state) }
                                                }
                                            }
                                    }
                                regionNode.kind == 7 -> if {
                                    regionNode.opcode == -26 -> if { ", true" -> println } else {
                                        ", " -> print
                                        regionLeft.kind == 3 or regionLeft.kind == 4
                                            -> if {
                                                regionLeft.kind == 3 -> if { regionLeft -> writeIntegerLiteral(context, state) } else { "true" -> print }
                                                "" -> println
                                            } else { regionNode.operand0 -> writeValue(ownerIndex, context, state)
                                                println() }
                                    }
                                } else {
                                    ", " -> print
                                    context.ir[regionNode.operand1] => regionRight
                                    regionRight.kind == 3 or regionRight.kind == 4
                                        -> if {
                                            regionRight -> sourceToken(context, state) => regionRightToken
                                            regionRight.kind == 3 -> if {
                                                regionRight -> writeIntegerLiteral(context, state)
                                                "" -> println
                                            } else {
                                                (context.sources[regionRight.sourceModule] -> byte(regionRightToken.span.start)) == 116
                                                    -> if { "1" -> println } else { "0" -> println }
                                            }
                                        } else {
                                            regionRightPromoted! -> if { "%v$(regionNodeIndex)_right_wide" -> println } else {
                                                ownerIndex >= 0 and context.ir[ownerIndex].kind == 0 and context.ir[ownerIndex].operand1 >= 0 and regionRight.kind == 5 and regionRight.symbol == context.ir[context.ir[ownerIndex].operand1].symbol
                                                    -> if { "%arg" -> println } else { regionNode.operand1 -> writeValue(ownerIndex, context, state)
                                                        println() }
                                            }
                                        }
                                }
                            }
                        }
                }
        }
    regionNode.kind == 6 and regionNode.opcode == -209 and regionNode.operand0 >= 0 and regionNode.operand1 >= 0
        -> if {
            context.ir[regionNode.operand0] => regionTryParallelSource
            context.ir[regionNode.operand1] => regionTryParallelBodyCall
            context.types[regionTryParallelBodyCall.typeId] => regionTryParallelCallbackType
            context.typeSizes[regionTryParallelCallbackType.first] => regionTryParallelOkStride
            context.typeSizes[regionTryParallelBodyCall.typeId] => regionTryParallelCallbackStride
            "  %v$(regionNodeIndex)_input = extractvalue %sollang.array.i32 " -> print
            regionTryParallelSource.kind == 5 and ownerIndex >= 0 and context.ir[ownerIndex].kind == 0 and context.ir[ownerIndex].operand1 >= 0 and regionTryParallelSource.symbol == context.ir[context.ir[ownerIndex].operand1].symbol
                -> if { "%arg" -> print } else { "%v$(regionNode.operand0)" -> print }
            ", 0" -> println
            "  %v$(regionNodeIndex)_length = extractvalue %sollang.array.i32 " -> print
            regionTryParallelSource.kind == 5 and ownerIndex >= 0 and context.ir[ownerIndex].kind == 0 and context.ir[ownerIndex].operand1 >= 0 and regionTryParallelSource.symbol == context.ir[context.ir[ownerIndex].operand1].symbol
                -> if { "%arg" -> print } else { "%v$(regionNode.operand0)" -> print }
            ", 1" -> println
            "  %v$(regionNodeIndex)_bytes = mul i64 %v$(regionNodeIndex)_length, " -> print
            regionTryParallelOkStride -> writeDecimalLine
            "  %v$(regionNodeIndex)_data = call ptr @malloc(i64 %v$(regionNodeIndex)_bytes)" -> println
            "  %v$(regionNodeIndex)_callback_bytes = mul i64 %v$(regionNodeIndex)_length, " -> print
            regionTryParallelCallbackStride -> writeDecimalLine
            "  %v$(regionNodeIndex)_callback_results = call ptr @malloc(i64 %v$(regionNodeIndex)_callback_bytes)" -> println
            "  %v$(regionNodeIndex)_initialized = call ptr @malloc(i64 %v$(regionNodeIndex)_length)" -> println
            "  call void @llvm.memset.p0.i64(ptr %v$(regionNodeIndex)_initialized, i8 0, i64 %v$(regionNodeIndex)_length, i1 false)" -> println
            regionNodeIndex -> parallelUsesComputePool(context, state)
                -> if {
                    CallEnvironmentRequest { callerIndex: ownerIndex, callIndex: regionNodeIndex, targetModule: regionTryParallelBodyCall.targetModule, targetSymbol: regionTryParallelBodyCall.symbol, hasArgument: true } => regionTryParallelEnvironmentRequest
                    regionTryParallelEnvironmentRequest -> targetFunctionIndex(context, state) => regionTryParallelTargetFunction
                    regionTryParallelTargetFunction -> functionCaptures(context, state) => regionTryParallelCaptures
