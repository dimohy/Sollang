            nativeAggregateResult! -> if {
                context.expectedPathStyle == 1 -> if {
                    nativeAggregateWidth! > 0 -> if {
                        "  %native_result_bits_$(callIndex) = call i$(nativeAggregateWidth!)" -> print
                    } else {
                        "  call void" -> print
                    }
                } else {
                    call.typeId -> nativeSysVAggregateIndirect(context, state)
                        -> if {
                            "  call void" -> print
                        } else {
                            "  %native_result_bits_$(callIndex) = call " -> print
                            context.typeSizes[call.typeId] > 8 -> if {
                                "{ " -> print
                                call.typeId -> writeNativeSysVCoercionType(0, context, state)
                                ", " -> print
                                call.typeId -> writeNativeSysVCoercionType(1, context, state)
                                " }" -> print
                            } else {
                                call.typeId -> writeNativeSysVCoercionType(0, context, state)
                            }
                        }
                }
            } else {
                call.typeOrigin == 1 and call.typeSymbol == 0
                    -> if { "  call " -> print } else { "  %v$(callIndex) = call " -> print }
                call -> targetsNativeFunction(context, state)
                    -> if {
                        call.typeId >= 0 -> if {
                            context.types[call.typeId] => nativeScalarResultType
                            nativeScalarResultType.kind == 1 and nativeScalarResultType.origin == 1 and (nativeScalarResultType.symbol == 3 or nativeScalarResultType.symbol == 4)
                                -> if { "signext " -> print }
                            nativeScalarResultType.kind == 1 and nativeScalarResultType.origin == 1 and (nativeScalarResultType.symbol == 8 or nativeScalarResultType.symbol == 9)
                                -> if { "zeroext " -> print }
                        }
                    }
                call -> writeIrType(context, state)
            }
        }
    }
}
# A borrowed call keeps an unnamed owning producer alive until the call returns.
# Named places keep their enclosing lifetime. Consuming formals take the owner;
# fixed-array formals take elements but leave promoted backing with the caller.
emitCallTemporaryDrop argumentIndex: Int, callIndex: Int, ordinal: Int, droppedOwners: mut [Int; ~], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    callIndex -> callTargetParameter(ordinal, context, state) => parameterIndex
    parameterIndex < 0 -> if { return }
    context.ir[parameterIndex] => parameter
    context.ir[argumentIndex] => argument
    argument.kind == 5 or argument.kind == 13 or argument.kind == 15 or argument.kind == 17
        -> if { return }
    argumentIndex -> aggregateValueIndex(context, state) => valueIndex
    context.ir[valueIndex] => value
    value.kind == 6 or value.kind == 12 or value.kind == 14
        or value.kind == 16 or value.kind == 26
        or (value.kind == 9 and value.opcode == -27) => owningProducer
    not owningProducer or value.typeId < 0 or value.typeId >= (context.types -> len)
        -> if { return }
    value.kind == 6 -> if {
        (value -> targetsNativeFunction(context, state))
            or not (valueIndex -> callHasResolvedFunctionTarget(context, state))
            -> if { return }
    }
    false => dropFixedBacking!
    value.kind == 6 and context.types[value.typeId].kind == 4
        and parameter.typeId >= 0 and parameter.typeId < (context.types -> len)
        -> if {
            context.types[parameter.typeId] => parameterType
            (parameterType.kind == 2 and parameter.flags % 4 == 0)
                or (parameterType.kind == 4 and parameter.flags % 4 <= 1)
                -> if { true => dropFixedBacking! }
        }
    parameter.flags % 4 == 0 and context.typeTraits[value.typeId] % 2 == 1
        and context.types[value.typeId].kind != 4 => dropBorrowedOwner
    not dropFixedBacking! and not dropBorrowedOwner
        -> if { return }
    droppedOwners -> each droppedOwner {
        droppedOwner == valueIndex -> if { return }
    }
    dropFixedBacking! -> if {
        "  %call$(callIndex)_temporary$(ordinal) = extractvalue { ptr, i64 } %v$(valueIndex), 0" -> println
        context.typeTraits[value.typeId] % 2 == 1 and parameter.flags % 2 == 0
            -> if {
                "  %call$(callIndex)_temporary$(ordinal)_value = load " -> print
                value.typeId -> writeSemanticTypeId(context, state)
                ", ptr %call$(callIndex)_temporary$(ordinal), align " -> print
                context.typeAligns[value.typeId] -> writeDecimalLine
                "  call void @sollang_drop_t$(value.typeId)(" -> print
                value.typeId -> writeSemanticTypeId(context, state)
                " %call$(callIndex)_temporary$(ordinal)_value)" -> println
            }
        "  call void @free(ptr %call$(callIndex)_temporary$(ordinal))" -> println
    } else {
        "  call void @sollang_drop_t$(value.typeId)(" -> print
        value.typeId -> writeSemanticTypeId(context, state)
        " %v$(valueIndex))" -> println
    }
    droppedOwners -> push(valueIndex)
}
emitCallTemporaryDrops callIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    [Int; ~] => droppedOwners!
    callIndex -> branchStageFlowIndex(context, state) => flowIndex
    0 => ordinal!
    flowIndex >= 0 -> if {
        flowIndex -> emitCallTemporaryDrop(callIndex, 0, droppedOwners!, context, state)
        1 => ordinal!
    }
    context.ir[callIndex].operand0 => argumentIndex!
    argumentIndex! >= 0 and (callIndex -> callTargetParameter(ordinal!, context, state)) >= 0
        -> while {
            argumentIndex! -> emitCallTemporaryDrop(callIndex, ordinal!, droppedOwners!, context, state)
            context.ir[argumentIndex!].nextOperand => argumentIndex!
            ordinal! + 1 => ordinal!
        }
}
emitCallResultFinish callIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[callIndex] => call
    call -> targetsNativeTry(context, state) => nativeTryCall
    nativeTryCall -> if {
        call -> nativeTrySuccessTypeId(context, state) => nativeTrySuccessType
        "  %native_try_ok_$(callIndex) = icmp eq i32 %native_try_status_$(callIndex), 0" -> println
        "  %native_try_result_slot_$(callIndex) = alloca " -> print
        call -> writeIrType(context, state)
        ", align 8" -> println
        "  store " -> print
        call -> writeIrType(context, state)
        " zeroinitializer, ptr %native_try_result_slot_$(callIndex), align 8" -> println
        "  %native_try_tag_addr_$(callIndex) = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %native_try_result_slot_$(callIndex), i32 0, i32 0" -> println
        "  %native_try_tag_$(callIndex) = select i1 %native_try_ok_$(callIndex), i32 0, i32 1" -> println
        "  store i32 %native_try_tag_$(callIndex), ptr %native_try_tag_addr_$(callIndex), align 4" -> println
        "  %native_try_payload_$(callIndex) = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %native_try_result_slot_$(callIndex), i32 0, i32 1" -> println
        "  br i1 %native_try_ok_$(callIndex), label %native_try_success_$(callIndex), label %native_try_error_$(callIndex)" -> println
        "native_try_success_$(callIndex):" -> println
        nativeTrySuccessType > 0 -> if {
            "  %native_try_value_$(callIndex) = load " -> print
            nativeTrySuccessType -> writeSemanticTypeId(context, state)
            ", ptr %native_try_out_$(callIndex), align " -> print
            context.typeAligns[nativeTrySuccessType] -> writeDecimalLine
            context -> nativeHandleType(nativeTrySuccessType)
                -> if { callIndex -> emitNativeHandleValidation(true) }
            "  store " -> print
            nativeTrySuccessType -> writeSemanticTypeId(context, state)
            " %native_try_value_$(callIndex), ptr %native_try_payload_$(callIndex), align " -> print
            context.typeAligns[nativeTrySuccessType] -> writeDecimalLine
        }
        "  br label %native_try_end_$(callIndex)" -> println
        "native_try_error_$(callIndex):" -> println
        "  store i32 %native_try_status_$(callIndex), ptr %native_try_payload_$(callIndex), align 4" -> println
        "  br label %native_try_end_$(callIndex)" -> println
        "native_try_end_$(callIndex):" -> println
        "  %v$(callIndex) = load " -> print
        call -> writeIrType(context, state)
        ", ptr %native_try_result_slot_$(callIndex), align 8" -> println
    } else {
        (call -> targetsNativeFunction(context, state)) and call.typeId >= 0 and (context -> diagnostics.nativeAbiStructTypeSafe(call.typeId, 0))
            -> if {
                context.expectedPathStyle == 1 -> if {
                    call.typeId -> nativeWindowsDirectAggregateWidth(context, state) => resultWidth
                    resultWidth > 0 -> if {
                        "  store i$(resultWidth) %native_result_bits_$(callIndex), ptr %native_result_slot_$(callIndex), align " -> print
                        call -> storageAlign(context, state) -> writeDecimalLine
                    }
                    "  %v$(callIndex) = load " -> print
                    call -> writeIrType(context, state)
                    ", ptr %native_result_slot_$(callIndex), align " -> print
                    call -> storageAlign(context, state) -> writeDecimalLine
                } else {
                    call.typeId -> nativeSysVAggregateIndirect(context, state) => indirect
                    not indirect -> if {
                        context.typeSizes[call.typeId] > 8 -> if {
                            "  %native_result_part_$(callIndex)_0 = extractvalue { " -> print
                            call.typeId -> writeNativeSysVCoercionType(0, context, state)
                            ", " -> print
                            call.typeId -> writeNativeSysVCoercionType(1, context, state)
                            " } %native_result_bits_$(callIndex), 0" -> println
                            "  %native_result_part_$(callIndex)_1 = extractvalue { " -> print
                            call.typeId -> writeNativeSysVCoercionType(0, context, state)
                            ", " -> print
                            call.typeId -> writeNativeSysVCoercionType(1, context, state)
                            " } %native_result_bits_$(callIndex), 1" -> println
                            "  store " -> print
                            call.typeId -> writeNativeSysVCoercionType(0, context, state)
                            " %native_result_part_$(callIndex)_0, ptr %native_result_slot_$(callIndex), align 8" -> println
                            "  %native_result_part_ptr_$(callIndex)_1 = getelementptr i8, ptr %native_result_slot_$(callIndex), i64 8" -> println
                            "  store " -> print
                            call.typeId -> writeNativeSysVCoercionType(1, context, state)
                            " %native_result_part_$(callIndex)_1, ptr %native_result_part_ptr_$(callIndex)_1, align 8" -> println
                        } else {
                            "  store " -> print
                            call.typeId -> writeNativeSysVCoercionType(0, context, state)
                            " %native_result_bits_$(callIndex), ptr %native_result_slot_$(callIndex), align 8" -> println
                        }
                    }
                    "  %v$(callIndex) = load " -> print
                    call -> writeIrType(context, state)
                    ", ptr %native_result_slot_$(callIndex), align " -> print
                    call -> storageAlign(context, state) -> writeDecimalLine
                }
            }
        (call -> targetsNativeFunction(context, state)) and (context -> nativeHandleType(call.typeId))
            -> if { callIndex -> emitNativeHandleValidation(false) }
    }
    callIndex -> emitCallTemporaryDrops(context, state)
}

# Pattern payloads are owned values but do not have ordinary mutable-binding
# slots. A transfer can occur only on one nested control path, so retain a
# per-arm runtime liveness bit and clear it exactly after the consuming call or
# aggregate constructor has completed.
emitCompletedPatternBindingTransferMarks transferIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    transferIndex => transferOwner!
    transferOwner! >= 0 and context.ir[transferOwner!].kind != 0
        -> while { context.ir[transferOwner!].parent => transferOwner! }
    0 => moveIndex!
    moveIndex! < (context.moves -> len) -> while {
        context.moves[moveIndex!] => moveEvent
        (moveEvent.siteIr -> nearestCompletedTransferOwner(context, state)) == transferIndex
            => transferContainsMove
        transferContainsMove
            and moveEvent.bindingIr >= 0
            and moveEvent.bindingIr < (context.ir -> len)
            and context.ir[moveEvent.bindingIr].kind == 29
            -> if {
                "  store i1 false, ptr %v$(moveEvent.bindingIr)_owned, align 1" -> println
            }
        # Aggregate cleanup already owns both complete and partial parameter
        # transfers at this boundary. Calls, enums and member stores use this
        # marker; they must not duplicate that aggregate-specific handler.
        transferContainsMove
            and transferOwner! >= 0
            and moveEvent.memberIr < 0
            and moveEvent.sourceModule == context.ir[transferOwner!].sourceModule
            and (moveEvent.siteIr -> nearestAggregateTransferOwner(context, state)) < 0
            -> if {
                context -> parameterIndexForFunction(transferOwner!, moveEvent.symbol)
                    => transferredParameter
                transferredParameter >= 0
                    and (transferredParameter -> moveParameterNeedsPathOwnershipFlag(transferOwner!, context, state))
                    -> if {
                        "  store i1 false, ptr %arg$(transferredParameter)_owned, align 1" -> println
                    }
            }
        moveIndex! + 1 => moveIndex!
    }
}
