    productTypeIndex! < (context.types -> len) -> while {
        context.types[productTypeIndex!] => productType
        productType.status == 0 and productType.kind == 10
            -> if {
                "%sollang.product.t$(productTypeIndex!) = type { " -> print
                true => firstProductField!
                0 => productFieldIndex!
                productFieldIndex! < (context.fields -> len)
                    -> while {
                        context.fields[productFieldIndex!] => productField
                        productField.status == 0 and productField.ownerType == productTypeIndex!
                            -> if {
                                not firstProductField! -> if { ", " -> print }
                                productField.fieldType -> writeSemanticTypeId(context, state)
                                false => firstProductField!
                            }
                        productFieldIndex! + 1 => productFieldIndex!
                    }
                " }" -> println
            }
        productTypeIndex! + 1 => productTypeIndex!
    }
    profile -> if { "preamble after product declarations" -> runtime.eprintln }
    profile -> if { "preamble before runtime" -> runtime.eprintln }
    dropTypeActive! -> emitCoreRuntimePreamble(state.intrinsicRuntimeModule, requiresEarlyTextType!, usesComputePool, usesAsyncRuntime, usesDirectoryTraversal, usesOwnedDropRuntime!, usesSourceText!, usesStandardInputSourceText, usesText!, context, state) => runtimePreamble
    profile -> if { "preamble after runtime" -> runtime.eprintln }
    runtimePreamble.usesArguments => usesArguments
    runtimePreamble.usesNativeInterop => usesNativeInterop
    runtimePreamble.usesComInterop => usesComInterop
    [Int; ~] => declaredExternalModules!
    [Int; ~] => declaredExternalSymbols!
    0 => externalCallIndex!
    externalCallIndex! < (context.ir -> len) -> while {
        context.ir[externalCallIndex!] => externalCall
        externalCall.kind == 6 and externalCall.opcode != -205 and not (externalCall.opcode -> typedIr.isProcessExecutionOpcode) and externalCall.opcode != -212 and externalCall.opcode != -222 and not (externalCall.opcode -> typedIr.isProcessProjectionOpcode) and not (externalCall.opcode -> typedIr.isSocketRuntimeOpcode) and not (externalCall -> isSourceTextFileIntrinsic) and externalCall.targetModule >= 0 and externalCall.symbol >= 0 and not (externalCallIndex! -> isRangeDeferCall(context, state)) and not (externalCallIndex! -> isMouseEventsCall(context, state))
            -> if {
                false => externalDefined!
                externalCall.targetModule < (context.ranges -> len)
                    -> if {
                        context.ranges[externalCall.targetModule].symbolStart + externalCall.symbol => externalGlobalSymbol
                        externalGlobalSymbol >= 0 and externalGlobalSymbol < (state.frozenCaptureFunctionsBySymbol -> len) and state.frozenCaptureFunctionsBySymbol[externalGlobalSymbol] >= 0
                            -> if { true => externalDefined! }
                    }
                false => externalDeclared!
                0 => externalDeclaredSearch!
                externalDeclaredSearch! < (declaredExternalModules! -> len)
                    -> while {
                        declaredExternalModules![externalDeclaredSearch!] == externalCall.targetModule and declaredExternalSymbols![externalDeclaredSearch!] == externalCall.symbol
                            -> if { true => externalDeclared! }
                        externalDeclaredSearch! + 1 => externalDeclaredSearch!
                    }
                not (externalCall.targetModule -> isRuntimeSourceModule(context)) and not externalDefined! and not externalDeclared!
                    -> if {
                        "declare " -> print
                        externalCall -> writeIrType(context, state)
                        " @sollang_m$(externalCall.targetModule)_s$(externalCall.symbol)(" -> print
                        externalCall.operand0 >= 0 -> if { context.ir[externalCall.operand0] -> writeIrType(context, state) }
                        ")" -> println
                        declaredExternalModules! -> push(externalCall.targetModule)
                        declaredExternalSymbols! -> push(externalCall.symbol)
                    }
            }
        externalCallIndex! + 1 => externalCallIndex!
    }
    0 => parallelCallbackIndex!
    parallelCallbackIndex! < (context.ir -> len)
        -> while {
            (parallelCallbackIndex! -> irNodeReachable(context, state))
                and (parallelCallbackIndex! -> parallelUsesComputePool(context, state))
                -> if {
                    context.ir[parallelCallbackIndex!] => parallelExpression
                    context.ir[parallelExpression.operand0] => parallelSource
                    context.ir[parallelExpression.operand1] => parallelBodyCall
                    CallEnvironmentRequest { callerIndex: -1, callIndex: parallelCallbackIndex!, targetModule: parallelBodyCall.targetModule, targetSymbol: parallelBodyCall.symbol, hasArgument: true } -> targetFunctionIndex(context, state) => parallelTargetFunction
                    parallelTargetFunction -> functionCaptures(context, state) => parallelCallbackCaptures
                    parallelCallbackCaptures -> len => parallelCallbackCaptureCount
                    parallelExpression.operand1 -> parallelAdditionalArgumentCount(context) => parallelCallbackAdditionalCount
                    parallelCallbackCaptureCount + parallelCallbackAdditionalCount => parallelCallbackEnvironmentCount
                    "define internal void @sollang_parallel_callback_$(parallelCallbackIndex!)(ptr %group, i64 %index) {" -> println
                    "entry:" -> println
                    "  %input_slot = getelementptr %sollang.compute_group, ptr %group, i32 0, i32 1" -> println
                    "  %input = load ptr, ptr %input_slot, align 8" -> println
                    "  %input_address = getelementptr " -> print
                    parallelSource -> writeArrayElementType(context, state)
                    ", ptr %input, i64 %index" -> println
                    "  %item = load " -> print
                    parallelSource -> writeArrayElementType(context, state)
                    ", ptr %input_address, align " -> print
                    parallelSource -> arrayElementAlign(context, state) -> writeDecimalLine
                    parallelCallbackEnvironmentCount > 0 -> if {
                        "  %capture_environment_slot = getelementptr %sollang.compute_group, ptr %group, i32 0, i32 4" -> println
                        "  %capture_environment = load ptr, ptr %capture_environment_slot, align 8" -> println
                        0 => parallelCallbackCaptureIndex!
                        parallelCallbackCaptureIndex! < parallelCallbackCaptureCount
                            -> while {
                                "  %capture_address_$(parallelCallbackCaptureIndex!) = getelementptr " -> print
                                parallelExpression.operand1 -> writeParallelCaptureType(parallelCallbackCaptures, context, state)
                                ", ptr %capture_environment, i32 0, i32 $(parallelCallbackCaptureIndex!)" -> println
                                context.ir[parallelCallbackCaptures[parallelCallbackCaptureIndex!]] => parallelCallbackCapture
                                "  %capture_value_$(parallelCallbackCaptureIndex!) = load " -> print
                                parallelCallbackCapture -> ownsType -> if { "ptr" -> print } else { parallelCallbackCapture -> writeIrType(context, state) }
                                ", ptr %capture_address_$(parallelCallbackCaptureIndex!), align " -> print
                                parallelCallbackCapture -> ownsType -> if { 8 -> writeDecimalLine } else { parallelCallbackCapture -> storageAlign(context, state) -> writeDecimalLine }
                                parallelCallbackCaptureIndex! + 1 => parallelCallbackCaptureIndex!
                            }
                        parallelExpression.operand1 -> parallelAdditionalArgumentStart(context) => parallelCallbackAdditionalIndex!
                        0 => parallelCallbackAdditionalOrdinal!
                        parallelCallbackAdditionalIndex! >= 0 and context.ir[parallelCallbackAdditionalIndex!].parent == parallelExpression.operand1
                            -> while {
                                parallelExpression.operand1 -> callTargetParameter(parallelCallbackAdditionalOrdinal! + 1, context, state) => parallelCallbackParameterIndex
                                parallelCallbackCaptureCount + parallelCallbackAdditionalOrdinal! => parallelCallbackEnvironmentIndex
                                "  %capture_address_$(parallelCallbackEnvironmentIndex) = getelementptr " -> print
                                parallelExpression.operand1 -> writeParallelCaptureType(parallelCallbackCaptures, context, state)
                                ", ptr %capture_environment, i32 0, i32 $(parallelCallbackEnvironmentIndex)" -> println
                                "  %capture_value_$(parallelCallbackEnvironmentIndex) = load " -> print
                                parallelCallbackParameterIndex >= 0 -> if {
                                    context.ir[parallelCallbackParameterIndex] -> writeIrType(context, state)
                                } else {
                                    context.ir[parallelCallbackAdditionalIndex!] -> writeIrType(context, state)
                                }
                                ", ptr %capture_address_$(parallelCallbackEnvironmentIndex), align " -> print
                                parallelCallbackParameterIndex >= 0 -> if {
                                    context.ir[parallelCallbackParameterIndex] -> storageAlign(context, state) -> writeDecimalLine
                                } else {
                                    context.ir[parallelCallbackAdditionalIndex!] -> storageAlign(context, state) -> writeDecimalLine
                                }
                                context.ir[parallelCallbackAdditionalIndex!].nextOperand => parallelCallbackAdditionalIndex!
                                parallelCallbackAdditionalOrdinal! + 1 => parallelCallbackAdditionalOrdinal!
                            }
                    }
                    "  %mapped = call " -> print
                    parallelBodyCall -> writeIrType(context, state)
                    " @sollang_m$(parallelBodyCall.targetModule)_s$(parallelBodyCall.symbol)(" -> print
                    0 => parallelCallbackArgumentIndex!
                    parallelCallbackArgumentIndex! < parallelCallbackCaptureCount
                        -> while {
                            context.ir[parallelCallbackCaptures[parallelCallbackArgumentIndex!]] => parallelCallbackArgument
                            parallelCallbackArgument -> ownsType -> if { "ptr" -> print } else { parallelCallbackArgument -> writeIrType(context, state) }
                            " %capture_value_$(parallelCallbackArgumentIndex!), " -> print
                            parallelCallbackArgumentIndex! + 1 => parallelCallbackArgumentIndex!
                        }
                    parallelSource -> writeArrayElementType(context, state)
                    " %item" -> print
                    parallelExpression.operand1 -> parallelAdditionalArgumentStart(context) => parallelCallbackAdditionalIndex!
                    0 => parallelCallbackAdditionalOrdinal!
                    parallelCallbackAdditionalOrdinal! < parallelCallbackAdditionalCount
                        -> while {
                            parallelExpression.operand1 -> callTargetParameter(parallelCallbackAdditionalOrdinal! + 1, context, state) => parallelCallbackParameterIndex
                            parallelCallbackCaptureCount + parallelCallbackAdditionalOrdinal! => parallelCallbackEnvironmentIndex
                            ", " -> print
                            parallelCallbackParameterIndex >= 0 -> if {
                                context.ir[parallelCallbackParameterIndex] -> writeIrType(context, state)
                            } else {
                                context.ir[parallelCallbackAdditionalIndex!] -> writeIrType(context, state)
                            }
                            " %capture_value_$(parallelCallbackEnvironmentIndex)" -> print
                            context.ir[parallelCallbackAdditionalIndex!].nextOperand => parallelCallbackAdditionalIndex!
                            parallelCallbackAdditionalOrdinal! + 1 => parallelCallbackAdditionalOrdinal!
                        }
                    ")" -> println
                    "  %output_slot = getelementptr %sollang.compute_group, ptr %group, i32 0, i32 2" -> println
                    "  %output = load ptr, ptr %output_slot, align 8" -> println
                    parallelExpression.opcode == -209 -> if {
                        context.typeSizes[parallelBodyCall.typeId] => parallelBodyResultSize
                        "  %output_offset = mul i64 %index, " -> print
                        parallelBodyResultSize -> writeDecimalLine
                        "  %output_address = getelementptr i8, ptr %output, i64 %output_offset" -> println
                        "  store " -> print
                        parallelBodyCall -> writeIrType(context, state)
                        " %mapped, ptr %output_address, align " -> print
                        parallelBodyCall -> storageAlign(context, state) -> writeDecimalLine
                        "  %initialized_slot = getelementptr %sollang.compute_group, ptr %group, i32 0, i32 12" -> println
                        "  %initialized = load ptr, ptr %initialized_slot, align 8" -> println
                        "  %initialized_address = getelementptr i8, ptr %initialized, i64 %index" -> println
                        "  store atomic i8 1, ptr %initialized_address release, align 1" -> println
                        "  %result_tag = extractvalue " -> print
                        parallelBodyCall -> writeIrType(context, state)
                        " %mapped, 0" -> println
                        "  %is_error = icmp eq i32 %result_tag, 1" -> println
                        "  br i1 %is_error, label %publish_error, label %done" -> println
                        "publish_error:" -> println
                        "  %failure_limit_slot = getelementptr %sollang.compute_group, ptr %group, i32 0, i32 11" -> println
                        "  %failure_before = atomicrmw min ptr %failure_limit_slot, i64 %index acq_rel" -> println
                        "  br label %done" -> println
                        "done:" -> println
                    } else {
                        "  %output_address = getelementptr " -> print
                        parallelExpression -> writeArrayElementType(context, state)
                        ", ptr %output, i64 %index" -> println
                        "  store " -> print
                        parallelExpression -> writeArrayElementType(context, state)
                        " %mapped, ptr %output_address, align " -> print
                        parallelExpression -> arrayElementAlign(context, state) -> writeDecimalLine
                    }
                    "  ret void" -> println
                    "}" -> println
                }
            parallelCallbackIndex! + 1 => parallelCallbackIndex!
        }
    0 => parallelBranchCallbackIndex!
    parallelBranchCallbackIndex! < (context.ir -> len)
        -> while {
            context.ir[parallelBranchCallbackIndex!] => parallelBranchExpression
            parallelBranchExpression.kind == 38
                and context.supportsComputePool
                and (parallelBranchCallbackIndex! -> irNodeReachable(context, state))
                -> if {
                    context.ir[parallelBranchExpression.operand1] => parallelBranchSource
                    parallelBranchCallbackIndex! -> parallelBranchCaptures(context, state) => parallelBranchCaptures
                    parallelBranchCallbackIndex! -> parallelBranchArguments(context) => parallelBranchArguments
                    "define internal void @sollang_parallel_branch_$(parallelBranchCallbackIndex!)(ptr %group, i64 %index) {" -> println
                    "entry:" -> println
                    "  %environment_slot = getelementptr %sollang.compute_group, ptr %group, i32 0, i32 4" -> println
                    "  %environment = load ptr, ptr %environment_slot, align 8" -> println
                    "  %output_slot = getelementptr %sollang.compute_group, ptr %group, i32 0, i32 2" -> println
                    "  %output = load ptr, ptr %output_slot, align 8" -> println
                    "  switch i64 %index, label %parallel_branch_$(parallelBranchCallbackIndex!)_invalid [" -> println
                    parallelBranchExpression.operand0 => parallelBranchArmLabelIndex!
                    0 => parallelBranchArmLabelOrdinal!
                    parallelBranchArmLabelIndex! >= 0 -> while {
                        "    i64 $(parallelBranchArmLabelOrdinal!), label %parallel_branch_$(parallelBranchCallbackIndex!)_arm$(parallelBranchArmLabelOrdinal!)" -> println
                        context.ir[parallelBranchArmLabelIndex!].nextOperand => parallelBranchArmLabelIndex!
                        parallelBranchArmLabelOrdinal! + 1 => parallelBranchArmLabelOrdinal!
                    }
                    "  ]" -> println
                    parallelBranchExpression.operand0 => parallelBranchArmIndex!
                    0 => parallelBranchArmOrdinal!
                    parallelBranchArmIndex! >= 0 -> while {
                        context.ir[parallelBranchArmIndex!] => parallelBranchArm
                        "parallel_branch_$(parallelBranchCallbackIndex!)_arm$(parallelBranchArmOrdinal!):" -> println
                        "  %parallel_branch_$(parallelBranchCallbackIndex!)_source_address$(parallelBranchArmOrdinal!) = getelementptr " -> print
                        parallelBranchCallbackIndex! -> writeParallelBranchEnvironmentType(parallelBranchCaptures, context, state)
                        ", ptr %environment, i32 0, i32 0" -> println
                        "  %parallel_branch_$(parallelBranchCallbackIndex!)_source$(parallelBranchArmOrdinal!) = load " -> print
                        parallelBranchSource -> writeIrType(context, state)
                        ", ptr %parallel_branch_$(parallelBranchCallbackIndex!)_source_address$(parallelBranchArmOrdinal!), align " -> print
                        parallelBranchSource -> storageAlign(context, state) -> writeDecimalLine
                        0 => parallelBranchCaptureLoadIndex!
                        parallelBranchCaptureLoadIndex! < (parallelBranchCaptures -> len)
                            -> while {
                                "  %parallel_branch_$(parallelBranchCallbackIndex!)_arm$(parallelBranchArmOrdinal!)_capture_address$(parallelBranchCaptureLoadIndex!) = getelementptr " -> print
                                parallelBranchCallbackIndex! -> writeParallelBranchEnvironmentType(parallelBranchCaptures, context, state)
                                ", ptr %environment, i32 0, i32 " -> print
                                parallelBranchCaptureLoadIndex! + 1 -> writeDecimalLine
                                context.ir[parallelBranchCaptures[parallelBranchCaptureLoadIndex!]] => parallelBranchCaptureLoad
                                "  %parallel_branch_$(parallelBranchCallbackIndex!)_arm$(parallelBranchArmOrdinal!)_capture$(parallelBranchCaptureLoadIndex!) = load " -> print
                                parallelBranchCaptureLoad -> ownsType -> if { "ptr" -> print } else { parallelBranchCaptureLoad -> writeIrType(context, state) }
                                ", ptr %parallel_branch_$(parallelBranchCallbackIndex!)_arm$(parallelBranchArmOrdinal!)_capture_address$(parallelBranchCaptureLoadIndex!), align " -> print
                                parallelBranchCaptureLoad -> ownsType -> if { "8" -> println } else { parallelBranchCaptureLoad -> storageAlign(context, state) -> writeDecimalLine }
                                parallelBranchCaptureLoadIndex! + 1 => parallelBranchCaptureLoadIndex!
                            }
                        0 => parallelBranchArgumentLoadIndex!
                        parallelBranchArgumentLoadIndex! < (parallelBranchArguments -> len)
                            -> while {
                                parallelBranchArguments[parallelBranchArgumentLoadIndex!] => parallelBranchArgumentLoad
                                context.ir[parallelBranchArgumentLoad].parent => parallelBranchArgumentLoadCall
                                parallelBranchArgumentLoad -> parallelBranchArgumentOrdinal(context) => parallelBranchArgumentLoadOrdinal
                                parallelBranchArgumentLoadCall -> callTargetParameter(parallelBranchArgumentLoadOrdinal, context, state) => parallelBranchArgumentLoadParameter
                                "  %parallel_branch_$(parallelBranchCallbackIndex!)_arm$(parallelBranchArmOrdinal!)_argument_address$(parallelBranchArgumentLoadIndex!) = getelementptr " -> print
                                parallelBranchCallbackIndex! -> writeParallelBranchEnvironmentType(parallelBranchCaptures, context, state)
                                ", ptr %environment, i32 0, i32 " -> print
                                1 + (parallelBranchCaptures -> len) + parallelBranchArgumentLoadIndex! -> writeDecimalLine
                                "  %parallel_branch_$(parallelBranchCallbackIndex!)_arm$(parallelBranchArmOrdinal!)_argument$(parallelBranchArgumentLoadIndex!) = load " -> print
                                parallelBranchArgumentLoad -> writeParallelBranchArgumentType(context, state)
                                ", ptr %parallel_branch_$(parallelBranchCallbackIndex!)_arm$(parallelBranchArmOrdinal!)_argument_address$(parallelBranchArgumentLoadIndex!), align " -> print
                                parallelBranchArgumentLoadParameter >= 0 -> if { context.ir[parallelBranchArgumentLoadParameter] -> storageAlign(context, state) -> writeDecimalLine } else { context.ir[parallelBranchArgumentLoad] -> storageAlign(context, state) -> writeDecimalLine }
                                parallelBranchArgumentLoadIndex! + 1 => parallelBranchArgumentLoadIndex!
                            }
                        parallelBranchArm.operand0 => parallelBranchStageIndex!
                        0 => parallelBranchStageOrdinal!
                        parallelBranchExpression.operand1 => parallelBranchStageFlowIndex!
                        parallelBranchStageIndex! >= 0 -> while {
                            context.ir[parallelBranchStageIndex!] => parallelBranchStage
                            "  %parallel_branch_$(parallelBranchCallbackIndex!)_arm$(parallelBranchArmOrdinal!)_stage$(parallelBranchStageOrdinal!) = call " -> print
                            parallelBranchStage -> writeIrType(context, state)
                            " @sollang_m$(parallelBranchStage.targetModule)_s$(parallelBranchStage.symbol)(" -> print
                            CallEnvironmentRequest { callerIndex: -1, callIndex: parallelBranchStageIndex!, targetModule: parallelBranchStage.targetModule, targetSymbol: parallelBranchStage.symbol, hasArgument: true } -> targetFunctionIndex(context, state) => parallelBranchStageTarget
                            parallelBranchStageTarget >= 0 -> if {
                                parallelBranchStageTarget -> functionCaptures(context, state) => parallelBranchStageCaptures
                                0 => parallelBranchStageCaptureIndex!
                                parallelBranchStageCaptureIndex! < (parallelBranchStageCaptures -> len)
                                    -> while {
                                        -1 => parallelBranchStageCapturePosition!
                                        0 => parallelBranchCapturePositionSearch!
                                        parallelBranchCapturePositionSearch! < (parallelBranchCaptures -> len)
                                            -> while {
                                                context.ir[parallelBranchCaptures[parallelBranchCapturePositionSearch!]].symbol == context.ir[parallelBranchStageCaptures[parallelBranchStageCaptureIndex!]].symbol
                                                    -> if { parallelBranchCapturePositionSearch! => parallelBranchStageCapturePosition! }
                                                parallelBranchCapturePositionSearch! + 1 => parallelBranchCapturePositionSearch!
                                            }
                                        context.ir[parallelBranchStageCaptures[parallelBranchStageCaptureIndex!]] => parallelBranchStageCapture
                                        parallelBranchStageCapture -> ownsType -> if { "ptr" -> print } else { parallelBranchStageCapture -> writeIrType(context, state) }
                                        " %parallel_branch_$(parallelBranchCallbackIndex!)_arm$(parallelBranchArmOrdinal!)_capture$(parallelBranchStageCapturePosition!), " -> print
                                        parallelBranchStageCaptureIndex! + 1 => parallelBranchStageCaptureIndex!
                                    }
                            }
                            context.ir[parallelBranchStageFlowIndex!] -> writeIrType(context, state)
                            " " -> print
                            parallelBranchStageOrdinal! == 0 -> if {
                                "%parallel_branch_$(parallelBranchCallbackIndex!)_source$(parallelBranchArmOrdinal!)" -> print
                            } else {
                                "%parallel_branch_$(parallelBranchCallbackIndex!)_arm$(parallelBranchArmOrdinal!)_stage" -> print
                                parallelBranchStageOrdinal! - 1 -> writeDecimal
                            }
                            parallelBranchStage.operand0 => parallelBranchStageArgumentIndex!
                            parallelBranchStageArgumentIndex! >= 0 and context.ir[parallelBranchStageArgumentIndex!].parent == parallelBranchStageIndex!
                                -> while {
                                    -1 => parallelBranchStageArgumentPosition!
                                    0 => parallelBranchStageArgumentSearch!
                                    parallelBranchStageArgumentSearch! < (parallelBranchArguments -> len)
                                        -> while {
                                            parallelBranchArguments[parallelBranchStageArgumentSearch!] == parallelBranchStageArgumentIndex!
                                                -> if { parallelBranchStageArgumentSearch! => parallelBranchStageArgumentPosition! }
                                            parallelBranchStageArgumentSearch! + 1 => parallelBranchStageArgumentSearch!
                                        }
                                    ", " -> print
                                    parallelBranchStageArgumentIndex! -> writeParallelBranchArgumentType(context, state)
                                    " %parallel_branch_$(parallelBranchCallbackIndex!)_arm$(parallelBranchArmOrdinal!)_argument$(parallelBranchStageArgumentPosition!)" -> print
                                    context.ir[parallelBranchStageArgumentIndex!].nextOperand => parallelBranchStageArgumentIndex!
                                }
                            ")" -> println
                            parallelBranchStageIndex! => parallelBranchStageFlowIndex!
                            parallelBranchStage.nextOperand => parallelBranchStageIndex!
                            parallelBranchStageOrdinal! + 1 => parallelBranchStageOrdinal!
                        }
                        "  %parallel_branch_$(parallelBranchCallbackIndex!)_output$(parallelBranchArmOrdinal!) = getelementptr " -> print
                        parallelBranchExpression -> writeIrType(context, state)
                        ", ptr %output, i32 0, i32 $(parallelBranchArmOrdinal!)" -> println
                        "  store " -> print
                        parallelBranchArm -> writeIrType(context, state)
                        " %parallel_branch_$(parallelBranchCallbackIndex!)_arm$(parallelBranchArmOrdinal!)_stage" -> print
                        parallelBranchStageOrdinal! - 1 -> writeDecimal
                        ", ptr %parallel_branch_$(parallelBranchCallbackIndex!)_output$(parallelBranchArmOrdinal!), align " -> print
                        parallelBranchArm -> storageAlign(context, state) -> writeDecimalLine
                        "  ret void" -> println
                        parallelBranchArm.nextOperand => parallelBranchArmIndex!
                        parallelBranchArmOrdinal! + 1 => parallelBranchArmOrdinal!
                    }
                    "parallel_branch_$(parallelBranchCallbackIndex!)_invalid:" -> println
                    "  call void @llvm.trap()" -> println
                    "  unreachable" -> println
                    "}" -> println
                }
            parallelBranchCallbackIndex! + 1 => parallelBranchCallbackIndex!
        }
    profile -> if { "preamble complete" -> runtime.eprintln }
    CorePreambleFeatures {
        usesArguments: usesArguments
        usesNativeInterop: usesNativeInterop
        usesComInterop: usesComInterop
    }
}

hasDeferredScheduleOwner nodeIndex: Int, functionIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    (nodeIndex -> parallelCallbackOwner(context)) >= 0
        -> if { true -> return }
    nodeIndex => ancestor!
    ancestor! > functionIndex -> while {
        context.ir[ancestor!] => node
        node.kind == 19 or node.kind == 20 -> if { true -> return }
        node.parent => ancestor!
    }
    false
}

bodyScheduleIndex functionIndex: Int, state: ref CoreEmitterState -> Int {
    0 => index!
    index! < (state.bodySchedules -> len) -> while {
        state.bodySchedules[index!].functionIndex == functionIndex
            -> if { index! -> return }
        index! + 1 => index!
    }
    -1
}

prepareScheduledCoreEmitterState context: ref emitterContext.EmitContext -> CoreEmitterState {
    context -> prepareCoreEmitterState => state!
    0 => functionIndex!
    functionIndex! < (context.ir -> len) -> while {
        context.ir[functionIndex!] => function
        function.kind == 11 => needsSchedule!
        function.kind == 0 and state!.frozenReachableFunctions[functionIndex!]
            and not (function -> isIntrinsicDeclaration)
            -> if {
                context.streamPlan.pipelines -> each pipeline {
                    pipeline.terminalIr > functionIndex!
                        and pipeline.terminalIr < state!.frozenFunctionEnds[functionIndex!]
                        -> if { true => needsSchedule! }
                }
            }
        needsSchedule! -> if {
            functionIndex! -> planEntryExpressionOrder(state!.frozenFunctionEnds[functionIndex!], context, state!) => schedule
            state!.bodySchedules -> push(schedule)
        }
        functionIndex! + 1 => functionIndex!
    }
    state!
}

bodyScheduleDiagnosticCount state: ref CoreEmitterState -> Int {
    0 => count!
    state.bodySchedules -> each schedule {
        schedule.failureNode >= 0 -> if { count! + 1 => count! }
    }
    count!
}

emitBodyScheduleDiagnostics state: ref CoreEmitterState -> Unit uses Console {
    state.bodySchedules -> each schedule {
        schedule.failureNode >= 0 -> if {
            "; sollang compiler error S056: required stream terminal or callback was not scheduled exactly once (function $(schedule.functionIndex), terminal $(schedule.failureTerminal), ir $(schedule.failureNode)); this is a compiler-integrity defect" -> println
        }
    }
}
