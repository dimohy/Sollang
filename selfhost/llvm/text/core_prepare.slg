sameCanonicalIrType left: typedIr.TypedIrNode, right: typedIr.TypedIrNode -> Bool {
    left.typeId >= 0 -> if { left.typeId == right.typeId -> return }
    left.typeId < 0
        and right.typeId < 0
        and left.typeKind == right.typeKind
        and left.typeOrigin == right.typeOrigin
        and left.typeModule == right.typeModule
        and left.typeSymbol == right.typeSymbol
}

enumAbiStorageSizeCached cache: ref [Int; ~], typeId: Int, depth: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    cache[typeId] >= 0 -> if { cache[typeId] -> return }
    context.typeSizes[typeId] => resolved!
    depth < 64 -> if {
        context.types[typeId] => current
        # SourceText is lowered to %sollang.source_text { ptr, i64, ptr, i64 },
        # even when an imported nominal duplicate retains its token-sized
        # semantic layout. Enum payloads must use the emitted ABI size.
        current.kind == 1 and current.origin == 1 and current.symbol == 24 => sourceTextAbi
        sourceTextAbi -> if { 32 => resolved! }
        current.kind == 7 and current.origin == 4 and (current.symbol == 0 or current.symbol == 1)
            -> if {
                0 => payloadSize!
                current.first >= 0 -> if { cache -> enumAbiStorageSizeCached(current.first, depth + 1, context, state) => payloadSize! }
                current.second >= 0 -> if {
                    cache -> enumAbiStorageSizeCached(current.second, depth + 1, context, state) => secondSize
                    secondSize > payloadSize! -> if { secondSize => payloadSize! }
                }
                8 + ((payloadSize! + 7) / 8) * 8 => resolved!
            }
        current.kind == 4 -> if {
            # A zero-length fixed payload has no element storage edge. Resolve
            # it before visiting its element, which may be the owning enum.
            current.length == 0 -> if {
                0 => resolved!
            } else {
                current.first >= 0 -> if {
                    (cache -> enumAbiStorageSizeCached(current.first, depth + 1, context, state)) * current.length => resolved!
                }
            }
        }
        not sourceTextAbi and (current.kind == 1 or current.kind == 10)
            -> if {
                false => nominalEnum!
                typeId => nominalEnumTypeId!
                current.kind == 1 -> if {
                    typeId -> isNominalEnumType(context, state) => nominalEnum!
                    # Imported references may have a distinct type ID for the
                    # same nominal declaration. Resolve enum identity by the
                    # emitted module/symbol name before treating it as a struct.
                    not nominalEnum! and current.module >= 0 -> if {
                        0 => nominalEnumCandidateIndex!
                        nominalEnumCandidateIndex! < (context.types -> len)
                            and not nominalEnum!
                            -> while {
                                context.types[nominalEnumCandidateIndex!] => nominalEnumCandidate
                                nominalEnumCandidate.status == 0
                                    and nominalEnumCandidate.kind == 1
                                    and nominalEnumCandidate.module == current.module
                                    and nominalEnumCandidate.symbol == current.symbol
                                    and (nominalEnumCandidateIndex! -> isNominalEnumType(context, state))
                                    -> if {
                                        true => nominalEnum!
                                        nominalEnumCandidateIndex! => nominalEnumTypeId!
                                    }
                                nominalEnumCandidateIndex! + 1 => nominalEnumCandidateIndex!
                            }
                    }
                }
                nominalEnum! -> if {
                    nominalEnumTypeId! -> enumPayloadTypes(context, state) => payloads
                    0 => payloadSize!
                    0 => payloadIndex!
                    payloadIndex! < (payloads -> len) -> while {
                        cache -> enumAbiStorageSizeCached(payloads[payloadIndex!], depth + 1, context, state) => candidateSize
                        candidateSize > payloadSize! -> if { candidateSize => payloadSize! }
                        payloadIndex! + 1 => payloadIndex!
                    }
                    context.types[nominalEnumTypeId!] => nominalEnumIdentity
                    0 => nominalEnumConstructorIndex!
                    nominalEnumConstructorIndex! < (context.ir -> len)
                        -> while {
                            context.ir[nominalEnumConstructorIndex!] => nominalEnumConstructor
                            false => nominalEnumConstructorBelongs!
                            nominalEnumConstructor.typeId == nominalEnumTypeId!
                                -> if { true => nominalEnumConstructorBelongs! }
                            not nominalEnumConstructorBelongs!
                                and nominalEnumConstructor.typeId >= 0
                                and nominalEnumConstructor.typeId < (context.types -> len)
                                -> if {
                                    context.types[nominalEnumConstructor.typeId] => nominalEnumConstructorType
                                    nominalEnumConstructorType.kind == 1
                                        and nominalEnumConstructorType.module == nominalEnumIdentity.module
                                        and nominalEnumConstructorType.symbol == nominalEnumIdentity.symbol
                                        -> if { true => nominalEnumConstructorBelongs! }
                                }
                            nominalEnumConstructor.kind == 26
                                and nominalEnumConstructorBelongs!
                                and nominalEnumConstructor.operand0 >= 0
                                -> if {
                                    context.ir[nominalEnumConstructor.operand0] -> effectiveTypeId(context, state) => nominalEnumConstructorPayloadType
                                    nominalEnumConstructorPayloadType >= 0
                                        and nominalEnumConstructorPayloadType < (context.types -> len)
                                        and not (nominalEnumConstructorPayloadType -> sameNominalTypeIdentity(nominalEnumTypeId!, context))
                                        -> if {
                                            cache -> enumAbiStorageSizeCached(nominalEnumConstructorPayloadType, depth + 1, context, state) => nominalEnumConstructorPayloadSize
                                            nominalEnumConstructorPayloadSize > payloadSize!
                                                -> if { nominalEnumConstructorPayloadSize => payloadSize! }
                                        }
                                }
                            nominalEnumConstructorIndex! + 1 => nominalEnumConstructorIndex!
                        }
                    8 + ((payloadSize! + 7) / 8) * 8 => resolved!
                } else {
                    0 => aggregateSize!
                    1 => aggregateAlign!
                    false => aggregateHasField!
                    0 => fieldIndex!
                    fieldIndex! < (context.fields -> len) -> while {
                        context.fields[fieldIndex!] => field
                        false => fieldBelongs!
                        field.ownerType == typeId -> if { true => fieldBelongs! }
                        current.kind == 1 and field.ownerType >= 0 -> if {
                            context.types[field.ownerType] => owner
                            owner.kind == 1 and owner.module == current.module and owner.symbol == current.symbol
                                -> if { true => fieldBelongs! }
                        }
                        field.status == 0 and fieldBelongs! and field.fieldType >= 0
                            -> if {
                                true => aggregateHasField!
                                context.typeAligns[field.fieldType] => fieldAlign
                                fieldAlign > aggregateAlign! -> if { fieldAlign => aggregateAlign! }
                                ((aggregateSize! + fieldAlign - 1) / fieldAlign) * fieldAlign => aggregateSize!
                                cache -> enumAbiStorageSizeCached(field.fieldType, depth + 1, context, state) => fieldSize
                                aggregateSize! + fieldSize => aggregateSize!
                            }
                        fieldIndex! + 1 => fieldIndex!
                    }
                    aggregateHasField! -> if {
                        ((aggregateSize! + aggregateAlign! - 1) / aggregateAlign!) * aggregateAlign! => resolved!
                    }
                }
            }
    }
    resolved!
}

enumAbiStorageSize typeId: Int, depth: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    [Int; ~] => cache!
    0 => cacheIndex!
    cacheIndex! < (context.types -> len) -> while {
        cache! -> push(-1)
        cacheIndex! + 1 => cacheIndex!
    }
    cache! -> enumAbiStorageSizeCached(typeId, depth, context, state)
}

struct CorePreambleFeatures {
    usesArguments: Bool
    usesNativeInterop: Bool
    usesComInterop: Bool
}

prepareCoreEmitterState context: ref emitterContext.EmitContext -> CoreEmitterState {
    snapshotIntArray values: [Int; ~] -> [Int; ~] {
        [Int; ~] => snapshot!
        values -> each value {
            snapshot! -> push(value)
        }
        snapshot!
    }
    snapshotBoolArray values: [Bool; ~] -> [Bool; ~] {
        [Bool; ~] => snapshot!
        values -> each value { snapshot! -> push(value) }
        snapshot!
    }

    computeFunctionEnd functionIndex: Int -> Int {
        functionIndex + 1 => end!
        end! < (context.ir -> len) and context.ir[end!].kind != 0 and context.ir[end!].kind != 11
            -> while { end! + 1 => end! }
        end!
    }
    computeFunctionCaptures functionIndex: Int -> [Int; ~] {
        [Int; ~] => captures!
        context.ir[functionIndex] => targetFunction
        functionIndex -> computeFunctionEnd => targetEnd
        -1 => captureOuterAst!
        targetFunction.astNode >= 0 -> if {
            context.ranges[targetFunction.sourceModule] => captureSourceRange
            context.nodes[captureSourceRange.astStart + targetFunction.astNode].parent => captureAncestor!
            captureAncestor! >= 0 and captureOuterAst! < 0
                -> while {
                    context.nodes[captureSourceRange.astStart + captureAncestor!] => captureAncestorNode
                    captureAncestorNode.kind == 7 -> if { captureAncestor! => captureOuterAst! } else { captureAncestorNode.parent => captureAncestor! }
                }
        }
        [Int; ~] => captureFunctions!
        captureFunctions! -> push(functionIndex)
        0 => captureFunctionIndex!
        captureFunctionIndex! < (captureFunctions! -> len)
            -> while {
                captureFunctions![captureFunctionIndex!] => currentFunctionIndex
                context.ir[currentFunctionIndex] => currentFunction
                currentFunctionIndex -> computeFunctionEnd => currentFunctionEnd
                currentFunctionIndex + 1 => useIndex!
                useIndex! < currentFunctionEnd -> while {
                    context.ir[useIndex!] => use
                    false => useIsParameter!
                    currentFunction.operand1 => localParameter!
                    true => primaryLocalParameter!
                    use.kind == 5 -> if {
                        localParameter! >= 0 and not useIsParameter! -> while {
                            context.ir[localParameter!].symbol == use.symbol
                                and context.ir[localParameter!].sourceModule == use.sourceModule
                                -> if { true => useIsParameter! }
                            primaryLocalParameter! -> if {
                                currentFunction.nextOperand => localParameter!
                                false => primaryLocalParameter!
                            } else { context.ir[localParameter!].nextOperand => localParameter! }
                        }
                    }
                    use.kind == 5 and use.operand0 < 0 and use.symbol >= 0 and not useIsParameter!
                        -> if {
                            -1 => bindingIndex!
                            use.sourceModule >= 0 and use.sourceModule < (context.ranges -> len)
                                -> if {
                                    context.ranges[use.sourceModule].symbolStart + use.symbol => bindingSymbolIndex
                                    bindingSymbolIndex >= 0 and bindingSymbolIndex < (captureBindingBySymbol! -> len)
                                        -> if {
                                            captureBindingBySymbol![bindingSymbolIndex] => bindingCandidateIndex!
                                            bindingCandidateIndex! >= 0 and bindingIndex! < 0
                                                -> while {
                                                    bindingCandidateIndex! < currentFunctionIndex or bindingCandidateIndex! >= currentFunctionEnd
                                                        -> if {
                                                            bindingCandidateIndex! => bindingIndex!
                                                        } else {
                                                            capturePreviousBindingByIr![bindingCandidateIndex!] => bindingCandidateIndex!
                                                        }
                                                }
                                        }
                                }
                            bindingIndex! >= 0 and (bindingIndex! < functionIndex or bindingIndex! >= targetEnd)
                                -> if {
                                    false => duplicate!
                                    0 => captureSearch!
                                    captureSearch! < (captures! -> len) -> while {
                                        captures![captureSearch!] == bindingIndex! -> if { true => duplicate! }
                                        captureSearch! + 1 => captureSearch!
                                    }
                                    not duplicate! -> if { captures! -> push(bindingIndex!) }
                                }
                        }
                    use.kind == 6 and use.targetModule >= 0 and use.symbol >= 0
                        -> if {
                            -1 => calledFunctionIndex!
                            use.targetModule < (context.ranges -> len) -> if {
                                context.ranges[use.targetModule].symbolStart + use.symbol => calledFunctionSymbolIndex
                                calledFunctionSymbolIndex >= 0 and calledFunctionSymbolIndex < (captureFunctionBySymbol! -> len)
                                    -> if {
                                        captureFunctionBySymbol![calledFunctionSymbolIndex] => calledFunctionIndex!
                                    }
                            }
                            context -> emitterContext.genericFunctionForCall(useIndex!) => genericCalledFunction
                            genericCalledFunction >= 0 -> if { genericCalledFunction => calledFunctionIndex! }
                            calledFunctionIndex! >= 0 -> if {
                                false => calledFunctionInClosure!
                                context.ir[calledFunctionIndex!] => calledFunction
                                captureOuterAst! >= 0 and calledFunction.sourceModule == targetFunction.sourceModule and calledFunction.astNode >= 0
                                    -> if {
                                        context.ranges[calledFunction.sourceModule] => calledFunctionRange
                                        context.nodes[calledFunctionRange.astStart + calledFunction.astNode].parent => calledFunctionAncestor!
                                        calledFunctionAncestor! >= 0 and not calledFunctionInClosure!
                                            -> while {
                                                calledFunctionAncestor! == captureOuterAst! -> if { true => calledFunctionInClosure! } else { context.nodes[calledFunctionRange.astStart + calledFunctionAncestor!].parent => calledFunctionAncestor! }
                                            }
                                    }
                                false => calledFunctionVisited!
                                0 => visitedFunctionSearch!
                                visitedFunctionSearch! < (captureFunctions! -> len)
                                    -> while {
                                        captureFunctions![visitedFunctionSearch!] == calledFunctionIndex!
                                            -> if { true => calledFunctionVisited! }
                                        visitedFunctionSearch! + 1 => visitedFunctionSearch!
                                    }
                                calledFunctionInClosure! and not calledFunctionVisited!
                                    -> if { captureFunctions! -> push(calledFunctionIndex!) }
                            }
                        }
                    useIndex! + 1 => useIndex!
                }
                captureFunctionIndex! + 1 => captureFunctionIndex!
            }
        captures!
    }
    [Int; ~] => functionEndCache!
    [Int; ~] => firstIrChildByParent!
    [Int; ~] => lastIrChildByParent!
    [Int; ~] => nextIrSiblingByNode!
    [Bool; ~] => valuesHaveFunctionLocalDirectBindings!
    context -> irFunctionOwners => functionOwnerByIrNode
    0 => structuralCacheInit!
    structuralCacheInit! < (context.ir -> len) -> while {
        functionEndCache! -> push(-1)
        firstIrChildByParent! -> push(-1)
        lastIrChildByParent! -> push(-1)
        nextIrSiblingByNode! -> push(-1)
        valuesHaveFunctionLocalDirectBindings! -> push(false)
        structuralCacheInit! + 1 => structuralCacheInit!
    }
    # Preserve Typed IR order while indexing direct children once. Aggregate
    # wrapper resolution depends on the last compatible direct child, so a
    # prepend-only list would silently reverse the established selection rule.
    0 => childNodeIndex!
    childNodeIndex! < (context.ir -> len)
        -> while {
            context.ir[childNodeIndex!].parent => childParentIndex
            -1 => childParentOwner!
            childParentIndex >= 0 and childParentIndex < (context.ir -> len)
                -> if { functionOwnerByIrNode[childParentIndex] => childParentOwner! }
            invariantRules.irParentOwnerAccepted(
            childParentIndex,
            context.ir -> len,
            functionOwnerByIrNode[childNodeIndex!],
            childParentOwner!)
                -> if {
                    lastIrChildByParent![childParentIndex] >= 0
                        -> if {
                            childNodeIndex! => nextIrSiblingByNode![lastIrChildByParent![childParentIndex]]
                        } else {
                            childNodeIndex! => firstIrChildByParent![childParentIndex]
                        }
                    childNodeIndex! => lastIrChildByParent![childParentIndex]
                }
            childNodeIndex! + 1 => childNodeIndex!
        }
    0 => structuralFunctionIndex!
    structuralFunctionIndex! < (context.ir -> len)
        -> while {
            context.ir[structuralFunctionIndex!].kind == 0 or context.ir[structuralFunctionIndex!].kind == 11
                -> if {
                    structuralFunctionIndex! -> computeFunctionEnd => structuralFunctionEnd
                    structuralFunctionEnd => functionEndCache![structuralFunctionIndex!]
                }
            structuralFunctionIndex! + 1 => structuralFunctionIndex!
        }
    0 => bindingOwnerIndex!
    bindingOwnerIndex! < (context.ir -> len)
        -> while {
            context.ir[bindingOwnerIndex!] => bindingOwner
            bindingOwner.kind == 0 or bindingOwner.kind == 11
                -> if {
                    functionEndCache![bindingOwnerIndex!] => bindingOwnerEnd
                    bindingOwnerIndex! + 1 => bindingIndex!
                    bindingIndex! < bindingOwnerEnd
                        -> while {
                            context.ir[bindingIndex!] => bindingIndexNode
                            bindingIndexNode.kind == 17
                                and bindingIndexNode.operand0 > bindingOwnerIndex!
                                and bindingIndexNode.operand0 < bindingOwnerEnd
                                -> if {
                                    true => valuesHaveFunctionLocalDirectBindings![bindingIndexNode.operand0]
                                }
                            bindingIndex! + 1 => bindingIndex!
                        }
                }
            bindingOwnerIndex! + 1 => bindingOwnerIndex!
        }
    [Int; ~] => captureBindingBySymbol!
    [Int; ~] => captureFunctionBySymbol!
    [Bool; ~] => functionHasDeclaredEffectsBySymbol!
    [Int; ~] => capturePreviousBindingByIr!
    0 => captureSymbolInit!
    captureSymbolInit! < (context.symbols -> len)
        -> while {
            captureBindingBySymbol! -> push(-1)
            captureFunctionBySymbol! -> push(-1)
            functionHasDeclaredEffectsBySymbol! -> push(false)
            captureSymbolInit! + 1 => captureSymbolInit!
        }
    0 => captureBindingLinkInit!
    captureBindingLinkInit! < (context.ir -> len)
        -> while {
            capturePreviousBindingByIr! -> push(-1)
            captureBindingLinkInit! + 1 => captureBindingLinkInit!
        }
    0 => captureSymbolNodeIndex!
    captureSymbolNodeIndex! < (context.ir -> len)
        -> while {
            context.ir[captureSymbolNodeIndex!] => captureSymbolNode
            captureSymbolNode.sourceModule >= 0 and captureSymbolNode.sourceModule < (context.ranges -> len) and captureSymbolNode.symbol >= 0
                -> if {
                    context.ranges[captureSymbolNode.sourceModule].symbolStart + captureSymbolNode.symbol => captureGlobalSymbolIndex
                    captureGlobalSymbolIndex >= 0 and captureGlobalSymbolIndex < (context.symbols -> len)
                        -> if {
                            captureSymbolNode.kind == 17 or captureSymbolNode.kind == 10
                                -> if {
                                    captureBindingBySymbol![captureGlobalSymbolIndex] => capturePreviousBindingByIr![captureSymbolNodeIndex!]
                                    captureSymbolNodeIndex! => captureBindingBySymbol![captureGlobalSymbolIndex]
                                }
                            captureSymbolNode.kind == 0
                                and not (context -> emitterContext.isGenericInstance(captureSymbolNodeIndex!))
                                -> if {
                                    captureSymbolNodeIndex! => captureFunctionBySymbol![captureGlobalSymbolIndex]
                                    false => functionHasDeclaredEffects!
                                    context.ranges[captureSymbolNode.sourceModule] => effectSourceRange
                                    context.symbols[captureGlobalSymbolIndex] => effectFunctionSymbol
                                    effectFunctionSymbol.astNode >= 0 -> if {
                                        context.nodes[effectSourceRange.astStart + effectFunctionSymbol.astNode] => effectDeclaration
                                        effectDeclaration.firstToken => effectTokenIndex!
                                        effectTokenIndex! < effectDeclaration.firstToken + effectDeclaration.tokenCount
                                            -> while {
                                                context.tokens[effectSourceRange.tokenStart + effectTokenIndex!] => effectToken
                                                effectToken.span.length == 4
                                                    and (context.sources[captureSymbolNode.sourceModule] -> byte(effectToken.span.start)) == 117
                                                    and (context.sources[captureSymbolNode.sourceModule] -> byte(effectToken.span.start + 1)) == 115
                                                    and (context.sources[captureSymbolNode.sourceModule] -> byte(effectToken.span.start + 2)) == 101
                                                    and (context.sources[captureSymbolNode.sourceModule] -> byte(effectToken.span.start + 3)) == 115
                                                    -> if { true => functionHasDeclaredEffects! }
                                                effectTokenIndex! + 1 => effectTokenIndex!
                                            }
                                    }
                                    captureSymbolNode.operand1 => effectParameterIndex!
                                    0 => effectParameterOrdinal!
                                    effectParameterIndex! >= 0 -> while {
                                        context.ir[effectParameterIndex!] => effectParameter
                                        effectParameter.flags / 2 % 2 == 1 -> if { true => functionHasDeclaredEffects! }
                                        effectParameterOrdinal! == 0 -> if {
                                            captureSymbolNode.nextOperand => effectParameterIndex!
                                        } else {
                                            effectParameter.nextOperand => effectParameterIndex!
                                        }
                                        effectParameterOrdinal! + 1 => effectParameterOrdinal!
                                    }
                                    functionHasDeclaredEffects! => functionHasDeclaredEffectsBySymbol![captureGlobalSymbolIndex]
                                }
                        }
                }
            captureSymbolNodeIndex! + 1 => captureSymbolNodeIndex!
        }
    [Int; ~] => functionCaptureCacheOffsets!
    [Int; ~] => functionCaptureCacheCounts!
    [Int; ~] => functionCaptureCacheValues!
    0 => functionCaptureCacheInit!
    functionCaptureCacheInit! < (context.ir -> len)
        -> while {
            functionCaptureCacheOffsets! -> push(-1)
            functionCaptureCacheCounts! -> push(0)
            functionCaptureCacheInit! + 1 => functionCaptureCacheInit!
        }
    0 => functionCaptureCacheFunctionIndex!
    functionCaptureCacheFunctionIndex! < (context.ir -> len)
        -> while {
            context.ir[functionCaptureCacheFunctionIndex!].kind == 0
                -> if {
                    functionCaptureCacheFunctionIndex! -> computeFunctionCaptures => computedCaptures
                    functionCaptureCacheValues! -> len => computedCaptureStart
                    0 => computedCaptureIndex!
                    computedCaptureIndex! < (computedCaptures -> len)
                        -> while {
                            functionCaptureCacheValues! -> push(computedCaptures[computedCaptureIndex!])
                            computedCaptureIndex! + 1 => computedCaptureIndex!
                        }
                    computedCaptureStart => functionCaptureCacheOffsets![functionCaptureCacheFunctionIndex!]
                    computedCaptureIndex! => functionCaptureCacheCounts![functionCaptureCacheFunctionIndex!]
                }
            functionCaptureCacheFunctionIndex! + 1 => functionCaptureCacheFunctionIndex!
        }
    # The indexes used by parallel emitters are constructed mutably once, then
    # copied into immutable snapshots before worker callbacks can capture them.
    functionEndCache! -> snapshotIntArray => frozenFunctionEnds
    firstIrChildByParent! -> snapshotIntArray => frozenFirstIrChildByParent
    nextIrSiblingByNode! -> snapshotIntArray => frozenNextIrSiblingByNode
    valuesHaveFunctionLocalDirectBindings! -> snapshotBoolArray => frozenValuesHaveFunctionLocalDirectBindings
    captureFunctionBySymbol! -> snapshotIntArray => frozenCaptureFunctionsBySymbol
    functionHasDeclaredEffectsBySymbol! -> snapshotBoolArray => frozenFunctionsHaveDeclaredEffectsBySymbol
    functionCaptureCacheOffsets! -> snapshotIntArray => frozenFunctionCaptureOffsets
    functionCaptureCacheCounts! -> snapshotIntArray => frozenFunctionCaptureCounts
    functionCaptureCacheValues! -> snapshotIntArray => frozenFunctionCaptureValues
    context -> diagnostics.reachableFunctions => reachableFunctions
    reachableFunctions -> snapshotBoolArray => frozenReachableFunctions
    [Bool; ~] => enumMatchConsumed!
    0 => enumMatchInitializeIndex!
    enumMatchInitializeIndex! < (context.ir -> len)
        -> while {
            enumMatchConsumed! -> push(false)
            enumMatchInitializeIndex! + 1 => enumMatchInitializeIndex!
        }
    0 => enumMatchIndex!
    enumMatchIndex! < (context.ir -> len) -> while {
        context.ir[enumMatchIndex!] => enumMatch
        enumMatch.kind == 27 and enumMatch.operand0 >= 0 and enumMatch.operand0 < (context.ir -> len)
            -> if {
                context.ir[enumMatch.operand0] => enumMatchSubject
                # A named owner remains responsible for its scope cleanup. The
                # arm borrows it; only a fresh producer or parameter transfers here.
                not (enumMatchSubject.kind == 5 and enumMatchSubject.operand0 >= 0)
                    -> if { true => enumMatchConsumed![enumMatch.operand0] }
            }
        enumMatchIndex! + 1 => enumMatchIndex!
    }
    enumMatchConsumed! -> snapshotBoolArray => frozenEnumMatchConsumed
    -1 => intrinsicRuntimeModule!
    0 => intrinsicRuntimeSearch!
    intrinsicRuntimeSearch! < (context.modules -> len)
        -> while {
            context.modules[intrinsicRuntimeSearch!] => intrinsicModuleIdentity
            intrinsicModuleIdentity.pathHash == 12254170256457402476
                -> if { intrinsicModuleIdentity.sourceIndex => intrinsicRuntimeModule! }
            intrinsicRuntimeSearch! + 1 => intrinsicRuntimeSearch!
        }
    CoreEmitterState {
        bodySchedules: [BodySchedulePlan; ~]
        frozenFunctionEnds: frozenFunctionEnds
        frozenFirstIrChildByParent: frozenFirstIrChildByParent
        frozenNextIrSiblingByNode: frozenNextIrSiblingByNode
        frozenValuesHaveFunctionLocalDirectBindings: frozenValuesHaveFunctionLocalDirectBindings
        frozenReachableFunctions: frozenReachableFunctions
        frozenCaptureFunctionsBySymbol: frozenCaptureFunctionsBySymbol
        frozenFunctionsHaveDeclaredEffectsBySymbol: frozenFunctionsHaveDeclaredEffectsBySymbol
        frozenFunctionCaptureOffsets: frozenFunctionCaptureOffsets
        frozenFunctionCaptureCounts: frozenFunctionCaptureCounts
        frozenFunctionCaptureValues: frozenFunctionCaptureValues
        frozenEnumMatchConsumed: frozenEnumMatchConsumed
        intrinsicRuntimeModule: intrinsicRuntimeModule!
    } => state!
    # Resolve payload transfers after the canonical result-query caches exist.
    0 => namedMatchIndex!
    namedMatchIndex! < (context.ir -> len) -> while {
        context.ir[namedMatchIndex!] => namedMatch
        namedMatch.kind == 27 and namedMatch.operand0 >= 0
            -> if {
                context.ir[namedMatch.operand0] => namedSubject
                namedSubject.kind == 5 and namedSubject.operand0 >= 0
                    and (context.ir[namedSubject.operand0].kind == 17
                    or context.ir[namedSubject.operand0].kind == 29)
                    and (namedMatchIndex! -> enumMatchTransfersPayload(context, state!))
                    -> if {
                        true => enumMatchConsumed![namedMatch.operand0]
                        true => enumMatchConsumed![namedSubject.operand0]
                        namedMatch.operand0 -> ownedValueSourceIndex(context, state!) => namedProducer
                        true => enumMatchConsumed![namedProducer]
                    }
            }
        namedMatchIndex! + 1 => namedMatchIndex!
    }
    enumMatchConsumed! -> snapshotBoolArray => state!.frozenEnumMatchConsumed
    state!
}

emitCorePreambleFeatures context: ref emitterContext.EmitContext, profile: Bool, state: ref CoreEmitterState -> CorePreambleFeatures uses Console {
    profile -> if { "preamble start" -> runtime.eprintln }
    context -> diagnostics.usesParallelRuntime => usesComputePool
    context -> diagnostics.usesAsyncRuntime => usesAsyncRuntime
    [Int; ~] => dropTypeActive!
    0 => dropTypeActiveIndex!
    dropTypeActiveIndex! < (context.types -> len)
        -> while {
            dropTypeActive! -> push(0)
            dropTypeActiveIndex! + 1 => dropTypeActiveIndex!
        }
    0 => dropTypeSeedIndex!
    dropTypeSeedIndex! < (context.ir -> len) -> while {
        context.ir[dropTypeSeedIndex!] => dropTypeSeed
        dropTypeSeed.typeId >= 0
