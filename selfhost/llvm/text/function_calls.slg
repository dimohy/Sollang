                                                or (functionExpressionRootWidth! == 32 and not functionExpressionRootSigned))
                                                and functionExpressionRoot.kind != 0 -> if {
                                                    "  %v$(expressionIndex)_expression$(functionExpressionRootIndex)_print = " -> print
                                                    functionExpressionRootTypeSymbol! -> integerSigned(context, state)
                                                        -> if { "sext" -> print } else { "zext" -> print }
                                                    " i$(functionExpressionRootWidth!) " -> print
                                                    functionExpressionRoot.kind == 1 -> if {
                                                        expressionIndex -> writeInterpolationValue(functionExpressionRootIndex, functionExpressionInterpolation, runtimeArgument.sourceModule, functionIndex, expressionIndex, context, state)
                                                    } else {
                                                        "%v$(expressionIndex)_expression$(functionExpressionRootIndex)" -> print
                                                    }
                                                    functionExpressionRootWidth! == 32 -> if { " to i64" -> println } else { " to i32" -> println }
                                                }
                                            functionExpressionRootTypeSymbol! == 1 -> if {
                                                "  %v$(expressionIndex)_expression$(functionExpressionRootIndex)_text_ptr = extractvalue %sollang.text " -> print
                                                functionExpressionRoot.kind == 5
                                                    or functionExpressionRoot.kind == 6
                                                    or functionExpressionRoot.kind == 7
                                                    or functionExpressionRoot.kind == 8
                                                    or functionExpressionRoot.kind == 10
                                                    -> if {
                                                        "%v$(expressionIndex)_expression$(functionExpressionRootIndex)" -> print
                                                    } else {
                                                        expressionIndex -> writeInterpolationValue(functionExpressionRootIndex, functionExpressionInterpolation, runtimeArgument.sourceModule, functionIndex, expressionIndex, context, state)
                                                    }
                                                ", 0" -> println
                                                "  %v$(expressionIndex)_expression$(functionExpressionRootIndex)_text_len = extractvalue %sollang.text " -> print
                                                functionExpressionRoot.kind == 5
                                                    or functionExpressionRoot.kind == 6
                                                    or functionExpressionRoot.kind == 7
                                                    or functionExpressionRoot.kind == 8
                                                    or functionExpressionRoot.kind == 10
                                                    -> if {
                                                        "%v$(expressionIndex)_expression$(functionExpressionRootIndex)" -> print
                                                    } else {
                                                        expressionIndex -> writeInterpolationValue(functionExpressionRootIndex, functionExpressionInterpolation, runtimeArgument.sourceModule, functionIndex, expressionIndex, context, state)
                                                    }
                                                ", 1" -> println
                                                expression.symbol == -116 -> if {
                                                    "  call void @sollang_runtime_eprint(ptr %v$(expressionIndex)_expression$(functionExpressionRootIndex)_text_ptr, i64 %v$(expressionIndex)_expression$(functionExpressionRootIndex)_text_len, i1 false)" -> println
                                                } else {
                                                    "  call void @sollang_runtime_print(ptr %v$(expressionIndex)_expression$(functionExpressionRootIndex)_text_ptr, i64 %v$(expressionIndex)_expression$(functionExpressionRootIndex)_text_len, i1 false)" -> println
                                                }
                                            } else {
                                                functionExpressionRootTypeSymbol! == 23 -> if {
                                                    expression.symbol == -116 -> if { "  call void @sollang_runtime_eprint_i1(i1 " -> print } else { "  call void @sollang_runtime_print_i1(i1 " -> print }
                                                } else {
                                                    functionExpressionRootWidth! == 64
                                                        or (functionExpressionRootWidth! == 32 and not functionExpressionRootSigned)
                                                        -> if {
                                                            expression.symbol == -116 -> if { "  call void @sollang_runtime_eprint_i64(i64 " -> print } else { "  call void @sollang_runtime_print_i64(i64 " -> print }
                                                        } else {
                                                            expression.symbol == -116 -> if { "  call void @sollang_runtime_eprint_i32(i32 " -> print } else { "  call void @sollang_runtime_print_i32(i32 " -> print }
                                                        }
                                                }
                                                functionExpressionRootTypeSymbol! != 23
                                                    and functionExpressionRootWidth! > 0
                                                    and (functionExpressionRootWidth! < 32
                                                    or (functionExpressionRootWidth! == 32 and not functionExpressionRootSigned))
                                                    and functionExpressionRoot.kind != 0 -> if {
                                                        "%v$(expressionIndex)_expression$(functionExpressionRootIndex)_print" -> print
                                                    } else {
                                                        functionExpressionRoot.kind == 0 or functionExpressionRoot.kind == 4
                                                            -> if {
                                                                functionExpressionRoot.kind == 4 -> if {
                                                                    (context.sources[runtimeArgument.sourceModule] -> byte(functionExpressionRoot.payloadStart)) == 116
                                                                        -> if { "1" -> print } else { "0" -> print }
                                                                } else { functionExpressionRoot -> writeInterpolationIntegerLiteral(runtimeArgument.sourceModule, context) }
                                                            } else {
                                                                functionExpressionRoot.kind == 5
                                                                    and functionExpressionRoot.operand0 >= 0
                                                                    and functionExpressionInterpolation[functionExpressionRoot.operand0].kind == 1
                                                                    -> if {
                                                                        "%v$(expressionIndex)_expression$(functionExpressionRootIndex)" -> print
                                                                    } else {
                                                                        functionExpressionRoot.kind == 1 -> if {
                                                                            expressionIndex -> writeInterpolationValue(functionExpressionRootIndex, functionExpressionInterpolation, runtimeArgument.sourceModule, functionIndex, expressionIndex, context, state)
                                                                        } else { "%v$(expressionIndex)_expression$(functionExpressionRootIndex)" -> print }
                                                                    }
                                                            }
                                                    }
                                                functionExpressionRootWidth! == 64
                                                    or (functionExpressionRootWidth! == 32 and not functionExpressionRootSigned)
                                                    -> if {
                                                        ", i1 " -> print
                                                        functionExpressionRootTypeSymbol! -> integerSigned(context, state)
                                                            -> if { "true" -> print } else { "false" -> print }
                                                    }
                                                ", i1 false)" -> println
                                            }
                                            functionExpressionRoot.expressionStart + functionExpressionRoot.expressionLength + 1 => functionExpressionSuffixStart!
                                            functionExpressionSegment! + 1 => functionExpressionSegment!
                                        }
                                    functionExpressionRootSearch! + 1 => functionExpressionRootSearch!
                                }
                            UIntSize(runtimeArgumentLength) - functionExpressionSuffixStart! => functionExpressionSuffixLength
                            "  %v$(expressionIndex)_expression_suffix = getelementptr i8, ptr @sollang_str_$(expression.operand0), i64 $(functionExpressionSuffixStart!)" -> println
                            expression.symbol == -116 -> if { "  call void @sollang_runtime_eprint(ptr %v$(expressionIndex)_expression_suffix, i64 $functionExpressionSuffixLength, i1 " -> print } else {
                                "  call void @sollang_runtime_print(ptr %v$(expressionIndex)_expression_suffix, i64 $functionExpressionSuffixLength, i1 " -> print
                            }
                        } else {
                            runtimeArgumentToken.span.start + 1 => functionInterpolationContentStart
                            runtimeArgumentToken.span.start + runtimeArgumentToken.span.length - 1 => functionInterpolationContentEnd
                            UIntSize(functionInterpolationContentStart) => functionInterpolationSegmentStart!
                            0 => functionInterpolationPartIndex!
                            false => functionEmittedInterpolation!
                            true => functionInterpolationSegmentsRemain!
                            functionInterpolationSegmentsRemain! -> while {
                                functionInterpolationSegmentStart! => functionInterpolationDollar!
                                -1 => functionInterpolationBindingIr!
                                false => functionInterpolationParameter!
                                0 => functionInterpolationParameterOrdinal!
                                functionInterpolationSegmentStart! => functionInterpolationMatchStart!
                                functionInterpolationSegmentStart! => functionInterpolationNameEnd!
                                functionInterpolationDollar! < functionInterpolationContentEnd and functionInterpolationBindingIr! < 0 and not functionInterpolationParameter!
                                    -> while {
                                        (context.sources[runtimeArgument.sourceModule] -> byte(functionInterpolationDollar!)) == 36 and functionInterpolationDollar! + 1 < functionInterpolationContentEnd
                                            -> if {
                                                functionInterpolationDollar! + 1 => functionInterpolationNameStart
                                                functionInterpolationNameStart => functionInterpolationNameEnd!
                                                true => functionInterpolationNameContinues!
                                                functionInterpolationNameEnd! < functionInterpolationContentEnd and functionInterpolationNameContinues!
                                                    -> while {
                                                        context.sources[runtimeArgument.sourceModule] -> byte(functionInterpolationNameEnd!) => functionInterpolationNameByte
                                                        (functionInterpolationNameByte >= 48 and functionInterpolationNameByte <= 57) or (functionInterpolationNameByte >= 65 and functionInterpolationNameByte <= 90) or (functionInterpolationNameByte >= 97 and functionInterpolationNameByte <= 122) or functionInterpolationNameByte == 95
                                                            -> if {
                                                                functionInterpolationNameEnd! + 1 => functionInterpolationNameEnd!
                                                            } else { false => functionInterpolationNameContinues! }
                                                    }
                                                functionInterpolationNameEnd! > functionInterpolationNameStart
                                                    -> if {
                                                        context.ranges[runtimeArgument.sourceModule] => functionInterpolationRange
                                                        function.operand1 => functionInterpolationParameterIndex!
                                                        0 => functionInterpolationParameterCandidateOrdinal!
                                                        functionInterpolationParameterIndex! >= 0 and not functionInterpolationParameter!
                                                            -> while {
                                                                context.ir[functionInterpolationParameterIndex!] => functionInterpolationParameterCandidate
                                                                context.symbols[functionInterpolationRange.symbolStart + functionInterpolationParameterCandidate.symbol] => functionInterpolationParameterSymbol
                                                                context.tokens[functionInterpolationRange.tokenStart + functionInterpolationParameterSymbol.nameToken] => functionInterpolationParameterToken
                                                                functionInterpolationParameterToken.span.length == functionInterpolationNameEnd! - functionInterpolationNameStart => functionInterpolationParameterNameEqual!
                                                                UIntSize(0) => functionInterpolationParameterNameByte!
                                                                functionInterpolationParameterNameEqual! and functionInterpolationParameterNameByte! < functionInterpolationParameterToken.span.length
                                                                    -> while {
                                                                        (context.sources[runtimeArgument.sourceModule] -> byte(functionInterpolationNameStart + functionInterpolationParameterNameByte!)) != (context.sources[runtimeArgument.sourceModule] -> byte(functionInterpolationParameterToken.span.start + functionInterpolationParameterNameByte!))
                                                                            -> if {
                                                                                false => functionInterpolationParameterNameEqual!
                                                                            }
                                                                        functionInterpolationParameterNameByte! + 1 => functionInterpolationParameterNameByte!
                                                                    }
                                                                functionInterpolationParameterNameEqual! -> if {
                                                                    true => functionInterpolationParameter!
                                                                    functionInterpolationParameterCandidateOrdinal! => functionInterpolationParameterOrdinal!
                                                                    functionInterpolationDollar! => functionInterpolationMatchStart!
                                                                }
                                                                functionInterpolationParameterCandidateOrdinal! == 0
                                                                    -> if {
                                                                        function.nextOperand => functionInterpolationParameterIndex!
                                                                    } else {
                                                                        functionInterpolationParameterCandidate.nextOperand => functionInterpolationParameterIndex!
                                                                    }
                                                                functionInterpolationParameterCandidateOrdinal! + 1 => functionInterpolationParameterCandidateOrdinal!
                                                            }
                                                        0 => functionInterpolationSymbolIndex!
                                                        functionInterpolationSymbolIndex! < functionInterpolationRange.symbolCount and not functionInterpolationParameter!
                                                            -> while {
                                                                context.symbols[functionInterpolationRange.symbolStart + functionInterpolationSymbolIndex!] => functionInterpolationSymbol
                                                                functionInterpolationSymbol.kind == 9 or functionInterpolationSymbol.kind == 35
                                                                    -> if {
                                                                        context.tokens[functionInterpolationRange.tokenStart + functionInterpolationSymbol.nameToken] => functionInterpolationSymbolToken
                                                                        functionInterpolationSymbolToken.span.length == functionInterpolationNameEnd! - functionInterpolationNameStart => functionInterpolationNameEqual!
                                                                        UIntSize(0) => functionInterpolationNameByteIndex!
                                                                        functionInterpolationNameEqual! and functionInterpolationNameByteIndex! < functionInterpolationSymbolToken.span.length
                                                                            -> while {
                                                                                (context.sources[runtimeArgument.sourceModule] -> byte(functionInterpolationNameStart + functionInterpolationNameByteIndex!)) != (context.sources[runtimeArgument.sourceModule] -> byte(functionInterpolationSymbolToken.span.start + functionInterpolationNameByteIndex!))
                                                                                    -> if { false => functionInterpolationNameEqual! }
                                                                                functionInterpolationNameByteIndex! + 1 => functionInterpolationNameByteIndex!
                                                                            }
                                                                        functionInterpolationNameEqual! -> if {
                                                                            functionInterpolationSymbol.kind != 35 -> if {
                                                                                expressionStart => functionInterpolationBindingSearch!
                                                                                functionInterpolationBindingSearch! < functionEnd
                                                                                    -> while {
                                                                                        context.ir[functionInterpolationBindingSearch!].kind == 17 and context.ir[functionInterpolationBindingSearch!].symbol == functionInterpolationSymbolIndex! and context.ir[functionInterpolationBindingSearch!].typeSymbol == 2
                                                                                            -> if {
                                                                                                functionInterpolationBindingSearch! => functionInterpolationBindingIr!
                                                                                                functionInterpolationDollar! => functionInterpolationMatchStart!
                                                                                            }
                                                                                        functionInterpolationBindingSearch! + 1 => functionInterpolationBindingSearch!
                                                                                    }
                                                                            }
                                                                        }
                                                                    }
                                                                functionInterpolationSymbolIndex! + 1 => functionInterpolationSymbolIndex!
                                                            }
                                                    }
                                            }
                                        functionInterpolationBindingIr! < 0 and not functionInterpolationParameter!
                                            -> if { functionInterpolationDollar! + 1 => functionInterpolationDollar! }
                                    }
                                functionInterpolationBindingIr! >= 0 or functionInterpolationParameter!
                                    -> if {
                                        Int(functionInterpolationSegmentStart! - functionInterpolationContentStart) => functionInterpolationPartOffset
                                        Int(functionInterpolationMatchStart! - functionInterpolationSegmentStart!) => functionInterpolationPartLength
                                        "  %v$(expressionIndex)_interpolation_part$(functionInterpolationPartIndex!) = getelementptr i8, ptr @sollang_str_$(expression.operand0), i64 $functionInterpolationPartOffset" -> println
                                        expression.symbol == -116 -> if {
                                            "  call void @sollang_runtime_eprint(ptr %v$(expressionIndex)_interpolation_part$(functionInterpolationPartIndex!), i64 $functionInterpolationPartLength, i1 false)" -> println
                                            "  call void @sollang_runtime_eprint_i32(i32 " -> print
                                        } else {
                                            "  call void @sollang_runtime_print(ptr %v$(expressionIndex)_interpolation_part$(functionInterpolationPartIndex!), i64 $functionInterpolationPartLength, i1 false)" -> println
                                            "  call void @sollang_runtime_print_i32(i32 " -> print
                                        }
                                        functionInterpolationParameter! -> if {
                                            functionInterpolationParameterOrdinal! == 0 -> if { "%arg" -> print } else { "%arg$(functionInterpolationParameterOrdinal!)" -> print }
                                        } else {
                                            context.ir[functionInterpolationBindingIr!] => functionInterpolationBinding
                                            context.ir[functionInterpolationBinding.operand0] => functionInterpolationValue
                                            functionInterpolationValue.kind == 3 -> if {
                                                functionInterpolationValue -> writeIntegerLiteral(context, state)
                                            } else { "%v$(functionInterpolationBinding.operand0)" -> print }
                                        }
                                        ", i1 false)" -> println
                                        functionInterpolationNameEnd! => functionInterpolationSegmentStart!
                                        functionInterpolationPartIndex! + 1 => functionInterpolationPartIndex!
                                        true => functionEmittedInterpolation!
                                    } else { false => functionInterpolationSegmentsRemain! }
                            }
                            functionEmittedInterpolation! -> if {
                                Int(functionInterpolationSegmentStart! - functionInterpolationContentStart) => functionInterpolationSuffixOffset
                                Int(functionInterpolationContentEnd - functionInterpolationSegmentStart!) => functionInterpolationSuffixLength
                                "  %v$(expressionIndex)_interpolation_suffix = getelementptr i8, ptr @sollang_str_$(expression.operand0), i64 $functionInterpolationSuffixOffset" -> println
                                expression.symbol == -116 -> if { "  call void @sollang_runtime_eprint(ptr %v$(expressionIndex)_interpolation_suffix, i64 $functionInterpolationSuffixLength, i1 " -> print } else {
                                    "  call void @sollang_runtime_print(ptr %v$(expressionIndex)_interpolation_suffix, i64 $functionInterpolationSuffixLength, i1 " -> print
                                }
                            } else {
                                expression.symbol == -116 -> if { "  call void @sollang_runtime_eprint(ptr @sollang_str_$(expression.operand0), i64 $runtimeArgumentLength, i1 " -> print } else {
                                    "  call void @sollang_runtime_print(ptr @sollang_str_$(expression.operand0), i64 $runtimeArgumentLength, i1 " -> print
                                }
                            }
                        }
                    } else {
                        runtimeArgument.typeOrigin == 1 and runtimeArgument.typeSymbol == 1
                            -> if {
                                "  %v$(expressionIndex)_runtime_ptr = extractvalue %sollang.text " -> print
                                expression.opcode == -203 -> if { "%v$(expressionIndex)" -> print } else {
                                    runtimeArgument.kind == 5 and function.operand1 >= 0 and runtimeArgument.symbol == context.ir[function.operand1].symbol
                                        -> if { "%arg" -> print } else { "%v$(runtimeArgumentIndex)" -> print }
                                }
                                ", 0" -> println
                                "  %v$(expressionIndex)_runtime_len = extractvalue %sollang.text " -> print
                                expression.opcode == -203 -> if { "%v$(expressionIndex)" -> print } else {
                                    runtimeArgument.kind == 5 and function.operand1 >= 0 and runtimeArgument.symbol == context.ir[function.operand1].symbol
                                        -> if { "%arg" -> print } else { "%v$(runtimeArgumentIndex)" -> print }
                                }
                                ", 1" -> println
                                expression.symbol == -116 -> if { "  call void @sollang_runtime_eprint(ptr %v$(expressionIndex)_runtime_ptr, i64 %v$(expressionIndex)_runtime_len, i1 " -> print } else {
                                    "  call void @sollang_runtime_print(ptr %v$(expressionIndex)_runtime_ptr, i64 %v$(expressionIndex)_runtime_len, i1 " -> print
                                }
                            } else {
                                runtimeArgument -> integerNodeWidth(context, state) => runtimeArgumentWidth!
                                runtimeArgument.kind == 6
                                    and runtimeArgument.typeKind == 1
                                    and runtimeArgument.typeOrigin == 1 -> if {
                                        runtimeArgument.typeSymbol -> integerWidth(context, state) => runtimeArgumentWidth!
                                    }
                                runtimeArgument.typeSymbol == 23 -> if {
                                    expression.symbol == -116 -> if { "  call void @sollang_runtime_eprint_i1(i1 " -> print } else { "  call void @sollang_runtime_print_i1(i1 " -> print }
                                } else {
                                    runtimeArgumentWidth! > 0 and runtimeArgumentWidth! < 32 and runtimeArgument.kind != 3
                                        -> if {
                                            "  %v$(expressionIndex)_runtime_integer = " -> print
                                            runtimeArgument -> integerNodeSigned(context, state)
                                                -> if { "sext" -> print } else { "zext" -> print }
                                            " i$(runtimeArgumentWidth!) " -> print
                                            runtimeArgument.kind == 5 and (context -> writeParameterReference(functionIndex, runtimeArgument.symbol))
                                                -> unless { "%v$(runtimeArgumentIndex)" -> print }
                                            " to i32" -> println
                                        }
                                    runtimeArgumentWidth! == 64 -> if {
                                        expression.symbol == -116 -> if { "  call void @sollang_runtime_eprint_i64(i64 " -> print } else { "  call void @sollang_runtime_print_i64(i64 " -> print }
                                    } else {
                                        expression.symbol == -116 -> if { "  call void @sollang_runtime_eprint_i32(i32 " -> print } else { "  call void @sollang_runtime_print_i32(i32 " -> print }
                                    }
                                }
                                runtimeArgument.kind == 3 -> if {
                                    runtimeArgument -> writeIntegerLiteral(context, state)
                                } else {
                                    runtimeArgument.typeSymbol != 23 and runtimeArgumentWidth! > 0 and runtimeArgumentWidth! < 32
                                        -> if {
                                            "%v$(expressionIndex)_runtime_integer" -> print
                                        } else {
                                            runtimeArgument.kind == 5 and function.operand1 >= 0 and runtimeArgument.symbol == context.ir[function.operand1].symbol
                                                -> if { "%arg" -> print } else { "%v$(runtimeArgumentIndex)" -> print }
                                        }
                                }
                                runtimeArgument.typeSymbol != 23 and runtimeArgumentWidth! == 64
                                    -> if {
                                        ", i1 " -> print
                                        runtimeArgument -> integerNodeSigned(context, state)
                                            -> if { "true" -> print } else { "false" -> print }
                                    }
                                ", i1 " -> print
                            }
                    }
                    expression.symbol == -102 or expression.symbol == -116
                        -> if { "true)" -> println } else { "false)" -> println }
                } else {
                    expression -> typedIr.isBuiltinIntegerConversionCall
                        -> if {
                            expression.operand0 -> aggregateValueIndex(context, state) => functionIntegerArgumentIndex
                            context.ir[functionIntegerArgumentIndex] => functionIntegerArgument
                            expression -> integerNodeWidth(context, state) => functionTargetWidth
                            functionIntegerArgument -> integerNodeWidth(context, state) => functionInputWidth
                            "  %v$(expressionIndex) = " -> print
                            functionIntegerArgument.kind == 3 -> if {
                                "add " -> print
                                expression -> writeIrType(context, state)
                                " " -> print
                                functionIntegerArgument -> writeIntegerLiteral(context, state)
                                ", 0" -> println
                            } else {
                                functionIntegerArgument.typeSymbol == 19 or functionIntegerArgument.typeSymbol == 20 or functionIntegerArgument.typeSymbol == 21 or functionIntegerArgument.typeSymbol == 22
                                    -> if {
                                        "fptosi " -> print
                                    } else {
                                        functionTargetWidth < functionInputWidth -> if { "trunc " -> print } else {
                                            functionTargetWidth > functionInputWidth -> if {
                                                functionIntegerArgument -> integerNodeSigned(context, state)
                                                    -> if { "sext " -> print } else { "zext " -> print }
                                            } else { "add " -> print }
                                        }
                                    }
                                functionIntegerArgument -> writeIrType(context, state)
                                " " -> print
                                functionIntegerArgument.kind == 3 -> if {
                                    functionIntegerArgument -> writeIntegerLiteral(context, state)
                                } else {
                                    functionIntegerArgument.kind == 5 and function.operand1 >= 0 and functionIntegerArgument.symbol == context.ir[function.operand1].symbol
                                        -> if { "%arg" -> print } else { "%v$(functionIntegerArgumentIndex)" -> print }
                                }
                                functionTargetWidth == functionInputWidth -> if { ", 0" -> println } else {
                                    " to " -> print
                                    expression -> writeIrType(context, state)
                                    "" -> println
                                }
                            }
                        } else {
                            expressionIndex -> isNativePathStyleCall(context, state)
                                -> if {
                                    expressionIndex -> emitNativePathStyleValue(context, state)
                                } else {
                                    expressionIndex -> emitNativeTargetLoad(expression, context, state)
                                    CallEnvironmentRequest { callerIndex: functionIndex, callIndex: expressionIndex, targetModule: expression.targetModule, targetSymbol: expression.symbol, hasArgument: expression.operand0 >= 0 } -> emitCallEnvironmentValues(context, state)
                                    expressionIndex -> emitNativeCallValues(functionIndex, context, state)
                                    expression.operand0 -> emitCallIntegerArgumentPromotions(expressionIndex, functionIndex, 0, context, state)
                                    expressionIndex -> writeCallResultPrefix(context, state)
                                    expressionIndex -> isRangeDeferCall(context, state)
                                        -> if {
                                            " @sollang_range_stream_create(" -> print
                                        } else {
                                            expressionIndex -> isMouseEventsCall(context, state)
                                                -> if { " @sollang_mouse_event_stream_make(" -> print } else { expressionIndex -> writeResolvedCallTarget(expression, context, state) }
                                        }
                                    CallEnvironmentRequest { callerIndex: functionIndex, callIndex: expressionIndex, targetModule: expression.targetModule, targetSymbol: expression.symbol, hasArgument: expression.operand0 >= 0 } -> emitCallEnvironment(context, state) => functionCallEnvironment
                                    expressionIndex -> emitCallArguments(functionIndex, context, state)
                                    ")" -> println
                                    expressionIndex -> emitCallResultFinish(context, state)
                                    expressionIndex -> emitCompletedPatternBindingTransferMarks(context, state)
                                    expressionIndex -> callResultPropagationBindingIndex(context, state) => functionPropagationBindingIndex
                                    functionPropagationBindingIndex >= 0 -> if {
                                        context.ir[functionPropagationBindingIndex] => functionPropagationBinding
                                        functionPropagationBindingIndex -> emitResultPropagationValue(expressionIndex, functionPropagationBinding.parent, functionPropagationBinding.astNode, functionIndex, expressionOrder, context, state)
                                    }
                                }
                        }
                }
        }
}
