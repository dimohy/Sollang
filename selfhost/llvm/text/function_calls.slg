                                            functionExpressionRoot.kind == 5 and (functionExpressionRootIndex -> interpolationMemberFieldIndex(functionExpressionInterpolation, runtimeArgument.sourceModule, functionIndex, expressionIndex, context, state)) < 0
                                                -> if {
                                                    functionExpressionInterpolation[functionExpressionRoot.operand0] => functionExpressionMemberBase
                                                    -1 => functionExpressionMemberBaseIr!
                                                    false => functionExpressionMemberBaseParameter!
                                                    context -> parameterIndexForFunction(functionIndex, functionExpressionMemberBase.symbol) => functionExpressionMemberBaseParameterIndex
                                                    functionExpressionMemberBaseParameterIndex >= 0
