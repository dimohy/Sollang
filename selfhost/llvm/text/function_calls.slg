                                                                    functionExpressionNode.kind == 2 and functionExpressionNode.opcode != -26
                                                                        -> if { "0" -> print } else {
                                                                            functionExpressionInterpolation[functionExpressionNode.operand0] => functionExpressionLeft
                                                                            functionExpressionLeft.kind == 0 or functionExpressionLeft.kind == 4
                                                                                -> if {
                                                                                    functionExpressionLeft.kind == 4 -> if {
                                                                                        (context.sources[runtimeArgument.sourceModule] -> byte(functionExpressionLeft.payloadStart)) == 116
