                                                                                            -> unless {
                                                                                                functionExpressionLeft -> interpolationBindingIndex(runtimeArgument.sourceModule, functionIndex, expressionIndex, context, state) => functionExpressionLeftBinding
                                                                                                functionExpressionLeftBinding >= 0 -> if {
                                                                                                    context.ir[functionExpressionLeftBinding].flags == 1
                                                                                                        -> if {
                                                                                                            "%v$(expressionIndex)_expression$(functionExpressionNode.operand0)_mutable" -> print
                                                                                                        } else {
                                                                                                            context.ir[context.ir[functionExpressionLeftBinding].operand0] => functionExpressionLeftValue
                                                                                                            functionExpressionLeftValue.kind == 3 -> if {
                                                                                                                functionExpressionLeftValue -> writeIntegerLiteral(context, state)
                                                                                                            } else {
                                                                                                                "%v" -> print
                                                                                                                context.ir[functionExpressionLeftBinding].operand0 -> writeDecimal
                                                                                                            }
                                                                                                        }
                                                                                                }
                                                                                            }
                                                                                    } else { "%v$(expressionIndex)_expression$(functionExpressionNode.operand0)" -> print }
                                                                                }
                                                                        }
                                                                    ", " -> print
                                                                    functionExpressionNode.kind == 2 -> if {
                                                                        functionExpressionInterpolation[functionExpressionNode.operand0] => functionExpressionUnary
                                                                        functionExpressionNode.opcode == -26 -> if { "true" -> println } else {
                                                                            functionExpressionUnary.kind == 0 or functionExpressionUnary.kind == 4
                                                                                -> if {
                                                                                    functionExpressionUnary.kind == 4 -> if {
                                                                                        (context.sources[runtimeArgument.sourceModule] -> byte(functionExpressionUnary.payloadStart)) == 116
                                                                                            -> if { "1" -> println } else { "0" -> println }
                                                                                    } else {
                                                                                        functionExpressionUnary -> writeInterpolationIntegerLiteral(runtimeArgument.sourceModule, context)
                                                                                        "" -> println
                                                                                    }
                                                                                } else {
                                                                                    functionExpressionUnary.kind == 1 -> if {
                                                                                        context -> writeParameterReference(functionIndex, functionExpressionUnary.symbol)
                                                                                            -> if { "" -> println } else {
                                                                                                functionExpressionUnary -> interpolationBindingIndex(runtimeArgument.sourceModule, functionIndex, expressionIndex, context, state) => functionExpressionUnaryBinding
                                                                                                functionExpressionUnaryBinding >= 0 -> if {
                                                                                                    context.ir[functionExpressionUnaryBinding].flags == 1
                                                                                                        -> if {
                                                                                                            "%v$(expressionIndex)_expression$(functionExpressionNode.operand0)_mutable" -> println
                                                                                                        } else {
                                                                                                            context.ir[context.ir[functionExpressionUnaryBinding].operand0] => functionExpressionUnaryValue
                                                                                                            functionExpressionUnaryValue.kind == 3 -> if {
                                                                                                                functionExpressionUnaryValue -> writeIntegerLiteral(context, state)
                                                                                                                "" -> println
                                                                                                            } else {
                                                                                                                "%v" -> print
                                                                                                                context.ir[functionExpressionUnaryBinding].operand0 -> writeDecimalLine
                                                                                                            }
                                                                                                        }
                                                                                                }
                                                                                            }
                                                                                    } else { "%v$(expressionIndex)_expression$(functionExpressionNode.operand0)" -> println }
                                                                                }
