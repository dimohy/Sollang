namespace sollang.compiler.llvm.text

import sollang.compiler.ir.typed as typedIr
import sollang.compiler.llvm.emitter.ownership as ownershipEmitter
import sollang.compiler.llvm.emitter.context as emitterContext
import sollang.compiler.syntax as syntax
import syntax.generated.slg as grammar

# Responsibility fragment extracted from emitCore. State is passed by readonly
# reference, preserving the original direct-call and allocation behavior.

emitFunctionCalls expressionIndex: Int, functionIndex: Int, expressionStart: Int, functionEnd: Int, expressionOrder: ref [Int; ~], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[expressionIndex] => expression
    context.ir[functionIndex] => function
    (expression.kind == 6 or expression.kind == 9) and (expression.opcode -> typedIr.isProcessExecutionOpcode)
        -> if {
            ProcessCallRequest { callIndex: expressionIndex, ownerIndex: functionIndex } -> emitProcessCall(context, state)
        }
    (expression.kind == 6 or expression.kind == 9) and (expression.opcode -> typedIr.isProcessProjectionOpcode)
        -> if {
            ProcessCallRequest { callIndex: expressionIndex, ownerIndex: functionIndex } -> emitProcessProjectionCall(context, state)
        }
    expression.kind == 6 and expression.opcode == -235
        -> if {
            ProcessCallRequest { callIndex: expressionIndex, ownerIndex: functionIndex } -> emitEnvironmentCall(context, state)
        }
    expression.kind == 6 and expression.opcode == -222
        -> if { expressionIndex -> emitExitCall(context, state) }
    expression.kind == 6 and expression.opcode == -215
        -> if {
            DirectoryCallRequest { callIndex: expressionIndex, ownerIndex: functionIndex } -> emitDirectoryCall(context, state)
        }
    expression.kind == 6 and expression.opcode == -233
        -> if {
            DirectoryCallRequest { callIndex: expressionIndex, ownerIndex: functionIndex } -> emitCreateDirectoryCall(context, state)
        }
    (expression.kind == 6 or expression.kind == 9) and (expression.opcode -> typedIr.isFileRuntimeOpcode)
        -> if {
            FileCallRequest { callIndex: expressionIndex, ownerIndex: functionIndex } -> emitFileCall(context, state)
        }
    (expression.kind == 6 or expression.kind == 9)
        and (expression.opcode -> typedIr.isSocketRuntimeOpcode)
        -> if {
            SocketCallRequest { callIndex: expressionIndex, ownerIndex: functionIndex } -> emitSocketCall(context, state)
        }
    expression.kind == 6 and expression.symbol == -102 and expression.operand0 < 0
        -> if {
            "  call void @sollang_runtime_print(ptr @sollang_runtime_newline, i64 1, i1 false)" -> println
        }
    expression.kind == 6 and expression.symbol == -103
        -> if {
            expressionIndex -> callArgumentIndex(context, state) => readPromptIndex
            context.ir[readPromptIndex] => readPrompt
            readPrompt.kind == 2 -> if {
                readPrompt -> sourceToken(context, state) => readPromptToken
                Int(TextLiteralRequest { sourceModule: readPrompt.sourceModule, token: readPromptToken } -> textLiteralLength(context, state)) => readPromptLength
                "  %v$(expressionIndex) = call i32 @sollang_runtime_read_int(ptr @sollang_str_$(readPromptIndex), i64 $readPromptLength)" -> println
            } else {
                "  %v$(expressionIndex) = call i32 @sollang_runtime_read_int(ptr null, i64 0)" -> println
            }
        }
    expression -> typedIr.isArenaConstructorCall
        -> if {
            WhileValueRequest { whileIndex: expressionIndex, ownerIndex: functionIndex, nodeIndex: 0 } -> emitArenaConstructor(context, state)
        }
    expression.kind == 6 and expression.opcode <= -237 and expression.opcode >= -240
        -> if {
            WhileValueRequest { whileIndex: expressionIndex, ownerIndex: functionIndex, nodeIndex: 0 } -> emitCollectionConstructor(context, state)
        }
    expression.kind == 9 and expression.opcode == -27 and expression.operand0 >= 0
        -> if {
            expressionIndex -> emitBoxIntrinsic(functionIndex, context, state)
        }
    (expression.kind == 9 or expression.kind == 6) and expression.opcode == -229 and expression.operand0 >= 0 and expression.operand1 >= 0
        -> if {
            WhileValueRequest { whileIndex: expressionIndex, ownerIndex: functionIndex, nodeIndex: 0 } -> emitTextMaterialize(context, state)
            expression.symbol == -101 or expression.symbol == -102 or expression.symbol == -116
                -> if {
                    "  %v$(expressionIndex)_console_ptr = extractvalue %sollang.text %v$(expressionIndex), 0" -> println
                    "  %v$(expressionIndex)_console_len = extractvalue %sollang.text %v$(expressionIndex), 1" -> println
                    expression.symbol == -116 -> if {
                        "  call void @sollang_runtime_eprint(ptr %v$(expressionIndex)_console_ptr, i64 %v$(expressionIndex)_console_len, i1 true)" -> println
                    } else {
                        "  call void @sollang_runtime_print(ptr %v$(expressionIndex)_console_ptr, i64 %v$(expressionIndex)_console_len, i1 " -> print
                        expression.symbol == -102 -> if { "true)" -> println } else { "false)" -> println }
                    }
                }
        }
    (expression.kind == 6 or (expression -> typedIr.isConsoleRuntimeCall)) and not (expression -> typedIr.isSetIntrinsicCall) and expression.symbol != -103 and expression.symbol != -115 and not (expression.symbol == -102 and expression.operand0 < 0) and not (expression -> typedIr.isArenaConstructorCall) and expression.opcode != -205 and expression.opcode != -206 and expression.opcode != -207 and expression.opcode != -208 and expression.opcode != -209 and not (expression.opcode -> typedIr.isProcessExecutionOpcode) and expression.opcode != -212 and expression.opcode != -214 and expression.opcode != -215 and expression.opcode != -222 and expression.opcode != -229 and expression.opcode != -230 and expression.opcode != -233 and expression.opcode != -235 and not (expression.opcode -> typedIr.isProcessProjectionOpcode) and (expression.opcode > -237 or expression.opcode < -240) and not (expression -> isSourceTextFileIntrinsic) and not (expression.opcode -> typedIr.isFileRuntimeOpcode) and not (expression.opcode -> typedIr.isSocketRuntimeOpcode) and not (expression.parent >= 0 and context.ir[expression.parent].kind == 6 and (context.ir[expression.parent].opcode == -207 or context.ir[expression.parent].opcode == -209) and context.ir[expression.parent].operand1 == expressionIndex)
        -> if {
            expression.symbol == -101 or expression.symbol == -102 or expression.symbol == -116
                -> if {
                    expressionIndex -> callArgumentIndex(context, state) => runtimeArgumentIndex
                    context.ir[runtimeArgumentIndex] => runtimeArgument
                    runtimeArgument.kind == 2 -> if {
                        runtimeArgument -> sourceToken(context, state) => runtimeArgumentToken
                        Int(TextLiteralRequest { sourceModule: runtimeArgument.sourceModule, token: runtimeArgumentToken } -> textLiteralLength(context, state)) => runtimeArgumentLength
                        runtimeArgument -> sourceInterpolations(context, state) => functionExpressionInterpolation
                        false => hasFunctionExpressionInterpolation!
                        0 => functionExpressionSearch!
                        functionExpressionSearch! < (functionExpressionInterpolation -> len)
                            -> while {
                                functionExpressionInterpolation[functionExpressionSearch!].sourceToken == runtimeArgument.payloadToken and functionExpressionInterpolation[functionExpressionSearch!].parent < 0
                                    -> if { true => hasFunctionExpressionInterpolation! }
                                functionExpressionSearch! + 1 => functionExpressionSearch!
                            }
                        hasFunctionExpressionInterpolation! -> if {
                            0 => functionExpressionSegment!
                            UIntSize(0) => functionExpressionSuffixStart!
                            0 => functionExpressionRootSearch!
                            functionExpressionRootSearch! < (functionExpressionInterpolation -> len)
                                -> while {
                                    functionExpressionRootSearch! => functionExpressionRootIndex
                                    functionExpressionInterpolation[functionExpressionRootIndex] => functionExpressionRoot
                                    functionExpressionRoot.sourceToken == runtimeArgument.payloadToken and functionExpressionRoot.parent < 0
                                        -> if {
                                            "  %v$(expressionIndex)_expression_literal$(functionExpressionSegment!) = getelementptr i8, ptr @sollang_str_$(expression.operand0), i64 $(functionExpressionRoot.literalStart)" -> println
                                            expression.symbol == -116 -> if {
                                                "  call void @sollang_runtime_eprint(ptr %v$(expressionIndex)_expression_literal$(functionExpressionSegment!), i64 $(functionExpressionRoot.literalLength), i1 false)" -> println
                                            } else {
                                                "  call void @sollang_runtime_print(ptr %v$(expressionIndex)_expression_literal$(functionExpressionSegment!), i64 $(functionExpressionRoot.literalLength), i1 false)" -> println
                                            }
                                            functionExpressionInterpolation -> interpolationEmissionOrder(runtimeArgument.payloadToken, functionExpressionRoot.segment) => functionExpressionOrder
                                            0 => functionExpressionOrderIndex!
                                            functionExpressionOrderIndex! < (functionExpressionOrder -> len)
                                                -> while {
                                                    functionExpressionOrder[functionExpressionOrderIndex!] => functionExpressionNodeIndex
                                                    functionExpressionInterpolation[functionExpressionNodeIndex] => functionExpressionNode
                                                    functionExpressionNodeIndex -> interpolationHasLogicalAncestor(functionExpressionInterpolation) => functionExpressionInsideLogical
                                                    functionExpressionNode.sourceToken == runtimeArgument.payloadToken
                                                        and functionExpressionNode.segment == functionExpressionRoot.segment
                                                        and not functionExpressionInsideLogical -> if {
                                                            expressionIndex -> emitInterpolationIntrinsic(functionExpressionNodeIndex, functionExpressionInterpolation, runtimeArgument.sourceModule, functionIndex, expressionIndex, true, context, state)
                                                        }
                                                    functionExpressionNode.sourceToken == runtimeArgument.payloadToken and functionExpressionNode.segment == functionExpressionRoot.segment and not functionExpressionInsideLogical and (functionExpressionNode.kind == 2 or functionExpressionNode.kind == 3)
                                                        -> if {
                                                            functionExpressionNode.kind == 3 and (functionExpressionNode.opcode == -24 or functionExpressionNode.opcode == -25)
                                                                -> if {
                                                                    expressionIndex -> emitInterpolationSubtree(functionExpressionNodeIndex, functionExpressionInterpolation, runtimeArgument.sourceModule, functionIndex, expressionIndex, true, context, state)
                                                                } else {
                                                                    "" => functionExpressionOperation!
                                                                    functionExpressionNode.kind == 2 -> if { "sub" => functionExpressionOperation! }
                                                                    functionExpressionNode.kind == 2 and functionExpressionNode.opcode == -26
                                                                        -> if { "xor" => functionExpressionOperation! }
                                                                    functionExpressionNode.opcode == grammar.tokenIdPlus()
                                                                        -> if { "add" => functionExpressionOperation! }
                                                                    functionExpressionNode.opcode == grammar.tokenIdMinus()
                                                                        -> if { "sub" => functionExpressionOperation! }
                                                                    functionExpressionNode.opcode == grammar.tokenIdStar()
                                                                        -> if { "mul" => functionExpressionOperation! }
                                                                    functionExpressionNode.opcode == grammar.tokenIdSlash()
                                                                        -> if { functionExpressionNodeIndex -> interpolationQuotientOperation(functionExpressionInterpolation, runtimeArgument.sourceModule, functionIndex, expressionIndex, context, state) => functionExpressionOperation! }
                                                                    functionExpressionNode.opcode == grammar.tokenIdPercent()
                                                                        -> if { functionExpressionNodeIndex -> interpolationRemainderOperation(functionExpressionInterpolation, runtimeArgument.sourceModule, functionIndex, expressionIndex, context, state) => functionExpressionOperation! }
                                                                    functionExpressionNode.opcode == grammar.tokenIdEqualEqual()
                                                                        -> if { "icmp eq" => functionExpressionOperation! }
                                                                    functionExpressionNode.opcode == grammar.tokenIdBangEqual()
                                                                        -> if { "icmp ne" => functionExpressionOperation! }
                                                                    functionExpressionNode.opcode == grammar.tokenIdLess() or functionExpressionNode.opcode == grammar.tokenIdLessEqual() or functionExpressionNode.opcode == grammar.tokenIdGreater() or functionExpressionNode.opcode == grammar.tokenIdGreaterEqual()
                                                                        -> if { functionExpressionNodeIndex -> interpolationComparisonOperation(functionExpressionInterpolation, runtimeArgument.sourceModule, functionIndex, expressionIndex, context, state) => functionExpressionOperation! }
                                                                    functionExpressionNode.opcode == -24 -> if { "or" => functionExpressionOperation! }
                                                                    functionExpressionNode.opcode == -25 -> if { "and" => functionExpressionOperation! }
                                                                    (functionExpressionNode.opcode == -24 or functionExpressionNode.opcode == -25 or (functionExpressionNode.kind == 2 and functionExpressionNode.opcode == -26)) => functionExpressionBoolOperands!
                                                                    functionExpressionNode.opcode == grammar.tokenIdEqualEqual() or functionExpressionNode.opcode == grammar.tokenIdBangEqual()
                                                                        -> if {
                                                                            functionExpressionInterpolation[functionExpressionNode.operand0] => functionExpressionTypeOperand
                                                                            functionExpressionTypeOperand.typeSymbol == 23
                                                                                -> if { true => functionExpressionBoolOperands! }
                                                                            functionExpressionTypeOperand.kind == 1 -> if {
                                                                                context -> parameterIndexForFunction(functionIndex, functionExpressionTypeOperand.symbol) => functionExpressionTypeParameterIndex
                                                                                functionExpressionTypeParameterIndex >= 0 and context.ir[functionExpressionTypeParameterIndex].typeSymbol == 23
                                                                                    -> if { true => functionExpressionBoolOperands! }
                                                                                expressionStart => functionExpressionTypeBindingSearch!
                                                                                functionExpressionTypeBindingSearch! < functionEnd
                                                                                    -> while {
                                                                                        context.ir[functionExpressionTypeBindingSearch!].kind == 17 and context.ir[functionExpressionTypeBindingSearch!].symbol == functionExpressionTypeOperand.symbol and context.ir[functionExpressionTypeBindingSearch!].typeSymbol == 23
                                                                                            -> if { true => functionExpressionBoolOperands! }
                                                                                        functionExpressionTypeBindingSearch! + 1 => functionExpressionTypeBindingSearch!
                                                                                    }
                                                                            }
                                                                        }
                                                                    "  %v$(expressionIndex)_expression$(functionExpressionNodeIndex) = $(functionExpressionOperation!) " -> print
                                                                    functionExpressionBoolOperands! -> if { "i1 " -> print } else {
                                                                        functionExpressionNode.operand0 -> interpolationNodeIntegerWidth(functionExpressionInterpolation, runtimeArgument.sourceModule, functionIndex, expressionIndex, context, state) => functionExpressionLeftWidth
                                                                        functionExpressionLeftWidth => functionExpressionRightWidth!
                                                                        functionExpressionNode.kind == 3 -> if {
                                                                            functionExpressionNode.operand1 -> interpolationNodeIntegerWidth(functionExpressionInterpolation, runtimeArgument.sourceModule, functionIndex, expressionIndex, context, state) => functionExpressionRightWidth!
                                                                        }
                                                                        functionExpressionLeftWidth > functionExpressionRightWidth!
                                                                            -> if { functionExpressionLeftWidth } else { functionExpressionRightWidth! } => functionExpressionWidth!
