                                                                    memberCompositeType.elementModule => currentModule!
                                                                    memberCompositeType.elementSymbol => currentSymbol!
                                                                }
                                                            memberCompositeSearch! + 1 => memberCompositeSearch!
                                                        }
                                                }
                                            }
                                        }
                                    memberFieldSearch! + 1 => memberFieldSearch!
                                }
                        }
                    memberTokenIndex! + 1 => memberTokenIndex!
                }
            currentOrigin! == 1 -> if {
                currentSymbol! -> integerWidth(context, state) => width!
                currentSymbol! == 12 or currentSymbol! == 13
                    -> if { context.pointerBitWidth => width! }
            }
        }
