                    context.ranges[node.sourceModule].tokenStart + canonicalWidthTokenIndex!
                        => canonicalWidthGlobalTokenIndex
                    context.tokens[canonicalWidthGlobalTokenIndex].kind == grammar.tokenIdIdentifier()
                        -> if {
                            true => canonicalWidthPathFound!
                            canonicalMemberOwnerTypeId! >= 0
                                and context.types[canonicalMemberOwnerTypeId!].kind == 8
                                -> if {
                                    context.types[canonicalMemberOwnerTypeId!].first
                                        => canonicalMemberOwnerTypeId!
                                }
                            canonicalMemberOwnerTypeId!
                                -> canonicalMemberFieldIndex(
                            node.sourceModule,
                            canonicalWidthTokenIndex!,
                            context)
                                => canonicalWidthFieldIndex
