# Responsibility fragment extracted from emitCore. State is passed by readonly
# reference, preserving the original direct-call and allocation behavior.
# Fresh producers and explicitly moving parameters transfer cleanup to the match.
# Named owners, borrowed parameters and projections retain their owner lifetime.
enumMatchOwnsSubject subjectIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    subjectIndex -> aggregateValueIndex(context, state) => producerIndex
    producerIndex >= 0 and producerIndex < (context.ir -> len)
        -> unless { false -> return }
    context.ir[producerIndex] => producer
    producer -> effectiveTypeId(context, state) => producerType
    # The selected payload's trait controls its drop. An intrinsic enum can
    # lack a container-level owning trait while carrying an owned payload.
    # A reference result still borrows its subject even when produced by a call.
    producerType >= 0 and producerType < (context.types -> len)
        and context.types[producerType].kind == 8
        -> if { false -> return }
    producer.kind == 5 and producer.operand0 < 0 -> if {
        producerIndex => functionIndex!
        functionIndex! >= 0 and context.ir[functionIndex!].kind != 0
            and context.ir[functionIndex!].kind != 11
            -> while { context.ir[functionIndex!].parent => functionIndex! }
        functionIndex! >= 0 -> if {
            context -> parameterIndexForFunction(functionIndex!, producer.symbol) => parameterIndex
            parameterIndex >= 0 and context.ir[parameterIndex].flags % 2 == 1
                -> if { true -> return }
        }
    }
    producer.kind == 6
        or producer.kind == 18
        or producer.kind == 26
        or producer.kind == 27
        or producer.kind == 30
        or producer.kind == 33
        or producer.kind == 34
        or (producer.kind == 9 and producer.opcode != -1)
}

# A named enum transfers its owner when an arm transfers the owned payload.
# Pure inspection leaves the named owner responsible for scope cleanup.
enumMatchTransfersPayload matchIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.ir[matchIndex].operand1 => armIndex!
    armIndex! >= 0 -> while {
        armIndex! -> matchArmBindingValueIndex(context, state) => bindingIndex
        bindingIndex >= 0 -> if {
            context.ir[bindingIndex] => binding
            binding.typeId >= 0 and (binding.typeId -> semanticTypeOwns(context, state))
                -> if {
                    armIndex! -> matchRegionResultValueIndex(context, state) => resultIndex
                    resultIndex >= 0 -> if {
                        resultIndex -> ownedValueSourceIndex(context, state) => resultSource
                        context.ir[resultSource] => result
                        resultSource == bindingIndex or (result.kind == 5 and result.operand0 == bindingIndex)
                            -> if { true -> return }
                    }
                    0 => moveIndex!
                    moveIndex! < (context.moves -> len) -> while {
                        context.moves[moveIndex!] => payloadMove
                        payloadMove.bindingIr == bindingIndex and payloadMove.memberIr < 0
                            -> if { true -> return }
                        moveIndex! + 1 => moveIndex!
                    }
                }
        }
        context.ir[armIndex!].nextOperand => armIndex!
    }
    false
}

sourceStart node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> UIntSize {
    context.nodes[context.ranges[node.sourceModule].astStart + node.astNode].start
}
moveRegionFor nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.ir[nodeIndex].parent => region!
    region! >= 0 and context.ir[region!].kind != 1 and context.ir[region!].kind != 11 and context.ir[region!].kind != 19 and context.ir[region!].kind != 20
        -> while {
            context.ir[region!].parent => region!
        }
    region!
}
nodeBelongsToOwnershipRegion nodeIndex: Int, regionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.ir[nodeIndex].parent => ancestor!
    false => belongs!
    false => blocked!
    ancestor! >= 0 and not belongs! and not blocked!
        -> while {
            ancestor! == regionIndex -> if {
                true => belongs!
            } else {
                context.ir[ancestor!].kind == 19 or context.ir[ancestor!].kind == 20
                    -> if {
                        true => blocked!
                    } else {
                        context.ir[ancestor!].parent => ancestor!
                    }
            }
        }
    belongs!
}

# Return the exact move-parameter symbol whose ownership is transferred into
# one owning lexical binding. This is the shared truth for normal-return and
# early-return cleanup; copying the ABI value into a mutable slot must never
# create a second owner.
owningBindingSourceParameterSymbol bindingIndex: Int, functionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => resolved!
    bindingIndex >= 0 and bindingIndex < (context.ir -> len)
        and functionIndex >= 0 and functionIndex < (context.ir -> len)
        -> if {
            context.ir[bindingIndex] => binding
            binding.kind == 17 and binding.operand0 >= 0
                -> if {
                    context.ir[binding.operand0] => directBindingSource
                    context -> parameterIndexForFunction(functionIndex, directBindingSource.symbol)
                        => directParameterIndex
                    directBindingSource.kind == 5 and directBindingSource.symbol >= 0
                        and directParameterIndex >= 0
                        and context.ir[directParameterIndex].flags % 2 == 1
                        -> if { directBindingSource.symbol => resolved! }
                    resolved! < 0 -> if {
                        binding.operand0 -> ownedValueSourceIndex(context, state)
                            => bindingSourceIndex
                        context.ir[bindingSourceIndex] => bindingSource
                        context -> parameterIndexForFunction(functionIndex, bindingSource.symbol)
                            => sourceParameterIndex
                        bindingSource.kind == 5 and bindingSource.symbol >= 0
                            and sourceParameterIndex >= 0
                            and context.ir[sourceParameterIndex].flags % 2 == 1
                            -> if { bindingSource.symbol => resolved! }
                    }
                }
        }
    resolved!
}

# Fixed owners cross the parameter ABI as a view of caller-owned inline storage.
# Recover the value expected by the canonical drop helper at the consuming edge.
emitWholeParameterDrop parameterIndex: Int, functionIndex: Int, edgeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[parameterIndex] => parameter
    context.types[parameter.typeId].kind == 4 => inlineArray
    inlineArray -> if {
        "  %drop_parameter$(parameterIndex)_edge$(edgeIndex)_data = extractvalue { ptr, i64 } " -> print
        context -> writeParameterReference(functionIndex, parameter.symbol) => parameterWritten
        ", 0" -> println
        "  %drop_parameter$(parameterIndex)_edge$(edgeIndex)_value = load " -> print
        parameter.typeId -> writeSemanticTypeId(context, state)
        ", ptr %drop_parameter$(parameterIndex)_edge$(edgeIndex)_data, align " -> print
        context.typeAligns[parameter.typeId] -> writeDecimalLine
    }
    "  call void @sollang_drop_t$(parameter.typeId)(" -> print
    parameter.typeId -> writeSemanticTypeId(context, state)
    " " -> print
    inlineArray -> if {
        "%drop_parameter$(parameterIndex)_edge$(edgeIndex)_value" -> print
    } else {
        context -> writeParameterReference(functionIndex, parameter.symbol) => parameterWritten
    }
    ")" -> println
}

writeCleanupValueName valueIndex: Int, parameterIndex: Int, functionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    parameterIndex >= 0 -> if {
        context -> writeParameterReference(functionIndex, context.ir[parameterIndex].symbol) => parameterWritten
    } else { "%v$(valueIndex)" -> print }
}

# A binding dominates an early-return edge only when its lexical region is an
# ancestor of that edge and its source precedes the return. Sibling-arm moves
# must not suppress cleanup on a path that never executed them.
owningBindingTransfersParameterBeforeEdge bindingIndex: Int, functionIndex: Int, parameterSymbol: Int, edgeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => transferred!
    bindingIndex -> owningBindingSourceParameterSymbol(functionIndex, context, state)
        => bindingParameterSymbol
    bindingParameterSymbol == parameterSymbol and edgeIndex >= 0
        -> if {
            context.ir[bindingIndex] => binding
            binding.parent => bindingRegion
            edgeIndex => edgeAncestor!
            false => regionDominates!
            edgeAncestor! >= 0 and not regionDominates! -> while {
                edgeAncestor! == bindingRegion -> if {
                    true => regionDominates!
                } else {
                    context.ir[edgeAncestor!].parent => edgeAncestor!
                }
            }
            regionDominates!
                and (binding -> sourceStart(context, state)) < (context.ir[edgeIndex] -> sourceStart(context, state))
                -> if { true => transferred! }
        }
    transferred!
}
# Final call parameter flags are authoritative even when the earlier semantic
# move snapshot did not yet resolve the target. Only a preceding call in an
# ancestor lexical region can transfer an owner on this return path.
resolvedCallTransfersParameterBeforeEdge callIndex: Int, parameterIndex: Int, edgeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => transferred!
    context.ir[callIndex] => call
    call.parent => callRegion!
    callRegion! >= 0 and context.ir[callRegion!].kind == 17
        -> while {
            context.ir[callRegion!].parent => callRegion!
        }
    call.kind == 6 and call.targetModule >= 0 and call.symbol >= 0
        and callRegion! >= 0
        and (context.ir[callRegion!].kind == 1 or context.ir[callRegion!].kind == 19)
        and (call -> sourceStart(context, state)) < (context.ir[edgeIndex] -> sourceStart(context, state))
        -> if {
            edgeIndex => ancestor!
            false => dominates!
            ancestor! >= 0 and not dominates! -> while {
                ancestor! == callRegion! -> if {
                    true => dominates!
                } else { context.ir[ancestor!].parent => ancestor! }
            }
            dominates! -> if {
                context.ir[parameterIndex] => parameter
                call.operand0 => argumentIndex!
                0 => ordinal!
                0 => steps!
                argumentIndex! >= 0 and argumentIndex! < (context.ir -> len)
                    and steps! < (context.ir -> len) and not transferred!
                    -> while {
                        callIndex -> callTargetParameter(ordinal!, context, state) => targetParameter
                        targetParameter >= 0 and context.ir[targetParameter].flags % 2 == 1
                            -> if {
                                argumentIndex! -> ownedValueSourceIndex(context, state) => sourceIndex
                                sourceIndex >= 0 and sourceIndex < (context.ir -> len)
                                    -> if {
                                        context.ir[sourceIndex] => source
                                        source.kind == 5 and source.sourceModule == parameter.sourceModule
                                            and source.symbol == parameter.symbol
                                            -> if { true => transferred! }
                                    }
                            }
                        context.ir[argumentIndex!].nextOperand => argumentIndex!
                        ordinal! + 1 => ordinal!
                        steps! + 1 => steps!
                    }
            }
        }
    transferred!
}
matchArmBindingValueIndex armIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => resolved!
    armIndex >= 0 and armIndex < (context.ir -> len)
        -> if {
            armIndex => ownerIndex!
            ownerIndex! >= 0 and context.ir[ownerIndex!].kind != 0 and context.ir[ownerIndex!].kind != 11
                -> while { context.ir[ownerIndex!].parent => ownerIndex! }
            ownerIndex! >= 0 -> if {
                ownerIndex! -> functionEnd(context, state) => ownerEnd
                ownerIndex! + 1 => bindingSearch!
                bindingSearch! < ownerEnd and resolved! < 0 -> while {
                    context.ir[bindingSearch!] => bindingCandidate
                    bindingCandidate.parent => bindingParent!
                    false => bindingArmFound!
                    bindingParent! >= 0 and not bindingArmFound!
                        -> while {
                            context.ir[bindingParent!] => bindingAncestor
                            bindingAncestor.kind == 19
                                and bindingAncestor.parent >= 0
                                and context.ir[bindingAncestor.parent].kind == 27
                                -> if {
                                    true => bindingArmFound!
                                } else {
                                    bindingAncestor.kind == 0 or bindingAncestor.kind == 11
                                        -> if {
                                            -1 => bindingParent!
                                            true => bindingArmFound!
                                        } else {
                                            bindingAncestor.parent => bindingParent!
                                        }
                                }
                        }
                    bindingCandidate.kind == 29
                        and bindingParent! == armIndex
                        -> if { bindingSearch! => resolved! }
                    bindingSearch! + 1 => bindingSearch!
                }
            }
        }
    resolved!
}
regionFullyMovesBinding regionIndex: Int, sourceModule: Int, symbol: Int, afterStart: UIntSize, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    regionIndex >= 0 and regionIndex < (context.ir -> len)
        -> unless { false -> return }
    # A terminating control region has already discharged its cleanup and
    # contributes no ownership obligation to the caller's continuing merge.
    # Function owners have parent -1 and are scopes, not control regions.
    context.ir[regionIndex] => region
    region.kind != 0 and region.kind != 11
        -> if {
            regionIndex -> regionReturns(context, state)
                -> if { true -> return }
        }
    false => moved!
    0 => moveIndex!
    moveIndex! < (context.moves -> len) and not moved!
        -> while {
            context.moves[moveIndex!] => candidateMove
            candidateMove.memberIr < 0
                and candidateMove.regionIr == regionIndex
                and candidateMove.sourceModule == sourceModule
                and candidateMove.symbol == symbol
                and (context.ir[candidateMove.siteIr] -> sourceStart(context, state)) > afterStart
                -> if {
                    true => moved!
                }
            moveIndex! + 1 => moveIndex!
        }
    0 => controlIndex!
    controlIndex! < (context.ir -> len) and not moved!
        -> while {
            context.ir[controlIndex!] => control
            controlIndex! -> nodeBelongsToOwnershipRegion(regionIndex, context, state)
                -> if {
                    control.kind == 18 and control.nextOperand >= 0 and (control -> sourceStart(context, state)) > afterStart
                        -> if {
                            control.operand1 -> regionFullyMovesBinding(sourceModule, symbol, afterStart, context, state) => thenMoves
                            control.nextOperand -> regionFullyMovesBinding(sourceModule, symbol, afterStart, context, state) => elseMoves
                            thenMoves and elseMoves -> if { true => moved! }
                        }
                    control.kind == 27 and control.operand1 >= 0 and (control -> sourceStart(context, state)) > afterStart
                        -> if {
                            true => allArmsMove!
                            false => hasArm!
                            control.operand1 => armIndex!
                            armIndex! >= 0 -> while {
                                true => hasArm!
                                armIndex! -> enumMatchArmRegion(context, state) => armRegion
                                armRegion -> regionFullyMovesBinding(sourceModule, symbol, afterStart, context, state)
                                    -> unless {
                                        false => allArmsMove!
                                    }
                                context.ir[armIndex!].nextOperand => armIndex!
                            }
                            hasArm! and allArmsMove! -> if { true => moved! }
                        }
                    control.kind == 33 and control.operand0 >= 0 and (control -> sourceStart(context, state)) > afterStart
                        -> if {
                            true => allWhenArmsMove!
                            false => hasWhenArm!
                            false => hasWhenElse!
                            control.operand0 => whenArmIndex!
                            true => whenArmOpen!
                            whenArmIndex! >= 0 and whenArmOpen! -> while {
                                context.ir[whenArmIndex!] => whenArm
                                whenArm.kind != 19 or whenArm.parent != controlIndex!
                                    -> if {
                                        false => allWhenArmsMove!
                                        false => whenArmOpen!
                                    } else {
                                        true => hasWhenArm!
                                        (whenArm.operand0 >= 0 and whenArm.operand1 >= 0 and whenArm.operand0 != whenArm.operand1 and context.ir[whenArm.operand0].kind != 19) => conditionalWhenArm
                                        conditionalWhenArm -> if {
                                            whenArm.operand1 -> regionFullyMovesBinding(sourceModule, symbol, afterStart, context, state)
                                                -> unless {
                                                    false => allWhenArmsMove!
                                                }
                                            whenArm.nextOperand => whenArmIndex!
                                        } else {
                                            true => hasWhenElse!
                                            whenArm.operand1 >= 0 -> if {
                                                whenArm.operand1 -> regionFullyMovesBinding(sourceModule, symbol, afterStart, context, state)
                                                    -> unless {
                                                        false => allWhenArmsMove!
                                                    }
                                            } else {
                                                whenArm.operand0 -> regionFullyMovesBinding(sourceModule, symbol, afterStart, context, state)
                                                    -> unless {
                                                        false => allWhenArmsMove!
                                                    }
                                            }
                                            false => whenArmOpen!
                                        }
                                    }
                            }
                            hasWhenArm! and hasWhenElse! and allWhenArmsMove!
                                -> if { true => moved! }
                        }
                    control.kind == 34 and control.operand1 >= 0 and (control -> sourceStart(context, state)) > afterStart
                        -> if {
                            true => allSubjectWhenArmsMove!
                            false => hasSubjectWhenArm!
                            false => hasSubjectWhenElse!
                            control.operand1 => subjectWhenArmIndex!
                            true => subjectWhenArmOpen!
                            subjectWhenArmIndex! >= 0 and subjectWhenArmOpen!
                                -> while {
                                    context.ir[subjectWhenArmIndex!] => subjectWhenArm
                                    subjectWhenArm.kind != 19 or subjectWhenArm.parent != controlIndex!
                                        -> if {
                                            false => allSubjectWhenArmsMove!
                                            false => subjectWhenArmOpen!
                                        } else {
                                            true => hasSubjectWhenArm!
                                            subjectWhenArm -> sourceNode(context, state) => subjectWhenArmSource
                                            subjectWhenArmSource.kind == 58 => conditionalSubjectWhenArm
                                            conditionalSubjectWhenArm -> if {
                                                subjectWhenArm.operand1 -> regionFullyMovesBinding(sourceModule, symbol, afterStart, context, state)
                                                    -> unless {
                                                        false => allSubjectWhenArmsMove!
                                                    }
                                                subjectWhenArm.nextOperand => subjectWhenArmIndex!
                                            } else {
                                                true => hasSubjectWhenElse!
                                                subjectWhenArmIndex! -> regionFullyMovesBinding(sourceModule, symbol, afterStart, context, state)
                                                    -> unless {
                                                        false => allSubjectWhenArmsMove!
                                                    }
                                                false => subjectWhenArmOpen!
                                            }
                                        }
                                }
                            hasSubjectWhenArm! and hasSubjectWhenElse! and allSubjectWhenArmsMove!
                                -> if { true => moved! }
                        }
                }
            controlIndex! + 1 => controlIndex!
        }
    moved!
}

# A return can transfer an owning local through several value-only aggregate
# constructors (for example Array -> struct -> Result.Ok). Follow only that
# returned value graph so cleanup on an early-return edge neither frees the
# transferred storage nor mistakes another branch's aggregate for this move.
returnedValueTransferredBindingRoots valueIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> [Int; ~] {
    [valueIndex,; ~] => pending!
    [Int; ~] => roots!
    0 => pendingIndex!
    pendingIndex! < (pending! -> len)
        -> while {
            pending![pendingIndex!] => candidateIndex
            pendingIndex! + 1 => pendingIndex!
            candidateIndex >= 0 and candidateIndex < (context.ir -> len)
                -> if {
                    context.ir[candidateIndex] => candidate
                    candidate.kind == 5 and candidate.operand0 >= 0
                        -> if {
                            candidate.operand0 -> mutableBindingRoot(context, state) => candidateRoot
                            roots! -> push(candidateRoot)
                        }
                    candidate.kind == 17 -> if {
                        candidateIndex -> mutableBindingRoot(context, state) => candidateRoot
                        roots! -> push(candidateRoot)
                    }
                    (candidate.kind == 26 or candidate.kind == 36 or candidate.kind == 43)
                        and candidate.operand0 >= 0
                        -> if {
                            pending! -> push(candidate.operand0)
                        }
                    (candidate.kind == 12 or candidate.kind == 14 or candidate.kind == 16 or candidate.kind == 35)
                        and candidate.operand0 >= 0
                        -> if {
                            candidate.operand0 => operandIndex!
                            0 => operandCount!
                            operandIndex! >= 0
                                and operandIndex! < (context.ir -> len)
                                and operandCount! < (context.ir -> len)
                                -> while {
                                    pending! -> push(operandIndex!)
                                    context.ir[operandIndex!].nextOperand => operandIndex!
                                    operandCount! + 1 => operandCount!
                                }
                        }
                }
        }
    roots!
}

# An explicit early return can forward the result of a consuming call directly.
# The returned symbol then belongs to the call result, not to the move parameter,
# so symbol comparison alone must not schedule a second cleanup of that parameter.
returnedValueConsumesMoveParameter valueIndex: Int, parameterIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => consumed!
    valueIndex >= 0 and valueIndex < (context.ir -> len)
        and parameterIndex >= 0 and parameterIndex < (context.ir -> len)
        -> if {
            context.ir[parameterIndex] => parameter
            0 => moveIndex!
            moveIndex! < (context.moves -> len) and not consumed!
                -> while {
                    context.moves[moveIndex!] => moveEvent
                    moveEvent.siteIr == valueIndex
                        and moveEvent.memberIr < 0
                        and moveEvent.sourceModule == parameter.sourceModule
                        and moveEvent.symbol == parameter.symbol
                        -> if { true => consumed! }
                    moveIndex! + 1 => moveIndex!
                }
        }
    consumed!
}

# A move parameter transferred only inside a nested control region needs a
# runtime liveness bit. A function-wide "moved" decision is not sufficient:
# one match arm can return the transferred owner while a sibling error arm
# still has to drop the original parameter exactly once.
moveParameterNeedsPathOwnershipFlag parameterIndex: Int, functionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => needed!
    parameterIndex >= 0 and parameterIndex < (context.ir -> len)
        and functionIndex >= 0 and functionIndex < (context.ir -> len)
        -> if {
            context.ir[parameterIndex] => parameter
            context.ir[functionIndex] => function
            parameter.kind == 10
                and parameter.flags % 2 == 1
                and parameter.typeId >= 0
                and (parameter.typeId -> semanticTypeOwns(context, state))
                and (context -> parameterIndexForFunction(functionIndex, parameter.symbol)) == parameterIndex
                -> if {
                    0 => moveIndex!
                    moveIndex! < (context.moves -> len) and not needed!
                        -> while {
                            context.moves[moveIndex!] => candidateMove
                            false => aggregateFieldTransfer!
                            candidateMove.memberIr >= 0 -> if {
                                context.ir[candidateMove.siteIr].parent => aggregateAncestor!
                                aggregateAncestor! >= 0
                                    and aggregateAncestor! != candidateMove.regionIr
                                    and not aggregateFieldTransfer!
                                    -> while {
                                        context.ir[aggregateAncestor!] => aggregateCandidate
                                        aggregateCandidate.kind == 12
                                            or aggregateCandidate.kind == 14
                                            or aggregateCandidate.kind == 16
                                            or aggregateCandidate.kind == 26
                                            or aggregateCandidate.kind == 35
                                            -> if { true => aggregateFieldTransfer! }
                                        aggregateCandidate.parent => aggregateAncestor!
                                    }
                            }
                            ((candidateMove.memberIr < 0
                                and (candidateMove.bindingIr == parameterIndex
                                or (context -> parameterIndexForFunction(functionIndex, candidateMove.symbol)) == parameterIndex))
                                or aggregateFieldTransfer!)
                                and candidateMove.sourceModule == parameter.sourceModule
                                and candidateMove.symbol == parameter.symbol
                                and candidateMove.regionIr != function.operand0
                                -> if { true => needed! }
                            moveIndex! + 1 => moveIndex!
                        }
                }
        }
    needed!
}
memberMoveMatchesAssignment moveIndex: Int, assignmentIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.moves[moveIndex] => candidateMove
    context.ir[assignmentIndex] => candidateAssignment
    false => matches!
    candidateMove.memberIr >= 0 and candidateAssignment.kind == 25 and candidateAssignment.sourceModule == candidateMove.sourceModule and candidateAssignment.symbol == candidateMove.symbol
        -> if {
            context.ir[candidateMove.memberIr] => candidateMember
            candidateMember -> sourceNode(context, state) => candidateMemberAst
            candidateAssignment -> sourceNode(context, state) => candidateAssignmentAst
            -1 => movedFieldToken!
            0 => movedIdentifierCount!
            candidateMemberAst.firstToken => movedTokenIndex!
            movedTokenIndex! < candidateMemberAst.firstToken + candidateMemberAst.tokenCount
                -> while {
                    context.tokens[context.ranges[candidateMember.sourceModule].tokenStart + movedTokenIndex!].kind == grammar.tokenIdIdentifier()
                        -> if {
                            movedTokenIndex! => movedFieldToken!
                            movedIdentifierCount! + 1 => movedIdentifierCount!
                        }
                    movedTokenIndex! + 1 => movedTokenIndex!
                }
            movedIdentifierCount! == 2 and movedFieldToken! >= 0 and candidateAssignmentAst.secondaryToken >= 0
                -> if {
                    context.tokens[context.ranges[candidateMember.sourceModule].tokenStart + movedFieldToken!] => movedField
                    context.tokens[context.ranges[candidateAssignment.sourceModule].tokenStart + candidateAssignmentAst.secondaryToken] => assignedField
                    movedField.span.length == assignedField.span.length => matches!
                    UIntSize(0) => fieldByte!
                    matches! and fieldByte! < movedField.span.length
                        -> while {
                            (context.sources[candidateMember.sourceModule] -> byte(movedField.span.start + fieldByte!)) != (context.sources[candidateAssignment.sourceModule] -> byte(assignedField.span.start + fieldByte!))
                                -> if { false => matches! }
                            fieldByte! + 1 => fieldByte!
                        }
                }
        }
    matches!
}
partialMoveActiveBefore moveIndex: Int, regionIndex: Int, beforeAst: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.moves[moveIndex] => candidateMove
    false => active!
    beforeAst >= 0 => boundedEdge
    candidateMove.memberIr >= 0 -> if {
        candidateMove.regionIr == regionIndex => active!
        context.ir[candidateMove.siteIr] => moveSite
        UIntSize(0) => edgeEnd!
        beforeAst >= 0 -> if {
            context.nodes[context.ranges[moveSite.sourceModule].astStart + beforeAst] => edgeAst
            edgeAst.start + edgeAst.length => edgeEnd!
        }
        active! and boundedEdge and (moveSite -> sourceStart(context, state)) >= edgeEnd!
            -> if { false => active! }
        candidateMove.regionIr => assignmentOwner!
        assignmentOwner! >= 0 and context.ir[assignmentOwner!].kind != 0 and context.ir[assignmentOwner!].kind != 11
            -> while {
                context.ir[assignmentOwner!].parent => assignmentOwner!
            }
        0 => assignmentSearch!
        0 => assignmentEnd!
        assignmentOwner! >= 0 -> if {
            assignmentOwner! + 1 => assignmentSearch!
            assignmentOwner! -> functionEnd(context, state) => assignmentEnd!
        }
        assignmentSearch! < assignmentEnd! -> while {
            active! -> if {
                context.ir[assignmentSearch!] => reinitialization
                assignmentSearch! -> moveRegionFor(context, state) => reinitializationRegion
                moveSite -> sourceStart(context, state) => moveSiteStart
                reinitialization -> sourceStart(context, state) => reinitializationStart
                true => reinitializationBeforeEdge!
                boundedEdge -> if { reinitializationStart < edgeEnd! => reinitializationBeforeEdge! }
                reinitialization.kind == 25 and reinitializationRegion == candidateMove.regionIr and moveSiteStart < reinitializationStart and reinitializationBeforeEdge!
                    -> if {
                        moveIndex -> memberMoveMatchesAssignment(assignmentSearch!, context, state)
                            -> if { false => active! }
                    }
            }
            assignmentSearch! + 1 => assignmentSearch!
        }
    }
    active!
}

# A repairing field assignment observes ownership immediately before its own
# store. The generic edge query uses the complete AST span and therefore sees
# that same assignment as already completed, which would drop storage that was
# just transferred out of the field. Exclude only the current assignment while
# retaining every earlier matching repair in the same ownership region.
partialMoveActiveAtAssignment moveIndex: Int, assignmentIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.moves[moveIndex] => candidateMove
    candidateMove.regionIr == (assignmentIndex -> moveRegionFor(context, state)) => active!
    candidateMove.memberIr >= 0 and active! -> if {
        context.ir[candidateMove.siteIr] -> sourceStart(context, state) => moveStart
        context.ir[assignmentIndex] -> sourceStart(context, state) => assignmentStart
        candidateMove.regionIr => owner!
        owner! >= 0 and context.ir[owner!].kind != 0 and context.ir[owner!].kind != 11
            -> while { context.ir[owner!].parent => owner! }
        0 => search!
        0 => end!
        owner! >= 0 -> if {
            owner! + 1 => search!
            owner! -> functionEnd(context, state) => end!
        }
        search! < end! and active! -> while {
            context.ir[search!] => earlierAssignment
            earlierAssignment.kind == 25
                and search! != assignmentIndex
                and (search! -> moveRegionFor(context, state)) == candidateMove.regionIr
                and (earlierAssignment -> sourceStart(context, state)) > moveStart
                and (earlierAssignment -> sourceStart(context, state)) < assignmentStart
                and (moveIndex -> memberMoveMatchesAssignment(search!, context, state))
                -> if { false => active! }
            search! + 1 => search!
        }
    }
    active!
}
sourceInterpolations node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> [interpolation.InterpolationNode; ~] {
    context.interpolationRanges[node.sourceModule] => interpolationRange
    [interpolation.InterpolationNode; ~] => sourceNodes!
    0 => interpolationIndex!
    interpolationIndex! < interpolationRange.nodeCount
        -> while {
            context.interpolations[interpolationRange.nodeStart + interpolationIndex!] => interpolationNode!
            interpolationNode!.parent >= 0 -> if { interpolationNode!.parent - interpolationRange.nodeStart => interpolationNode!.parent }
            interpolationNode!.operand0 >= 0 -> if { interpolationNode!.operand0 - interpolationRange.nodeStart => interpolationNode!.operand0 }
            interpolationNode!.operand1 >= 0 -> if { interpolationNode!.operand1 - interpolationRange.nodeStart => interpolationNode!.operand1 }
            interpolationNode!.operand2 >= 0 -> if { interpolationNode!.operand2 - interpolationRange.nodeStart => interpolationNode!.operand2 }
            sourceNodes! -> push(interpolationNode!)
            interpolationIndex! + 1 => interpolationIndex!
        }
    sourceNodes!
}
emitDropValueName request: DropGlueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    request.valueKind == 0 -> if { "%v$(request.valueIndex)" -> print } else {
        request.valueKind == 1 -> if {
            context.ir[request.regionIndex].parent => dropParameterOwner!
            dropParameterOwner! >= 0 and context.ir[dropParameterOwner!].kind != 0 and context.ir[dropParameterOwner!].kind != 11
                -> while {
                    context.ir[dropParameterOwner!].parent => dropParameterOwner!
                }
            context -> writeParameterReference(dropParameterOwner!, context.ir[request.bindingIndex].symbol) => dropParameterWritten
        } else {
            request.valueKind == 3 -> if {
                request.regionIndex => dropParameterOwner!
                dropParameterOwner! >= 0 and context.ir[dropParameterOwner!].kind != 0 and context.ir[dropParameterOwner!].kind != 11
                    -> while {
                        context.ir[dropParameterOwner!].parent => dropParameterOwner!
                    }
                context -> writeParameterReference(dropParameterOwner!, context.ir[request.valueIndex].symbol) => dropParameterWritten
            } else { "%dropg$(request.nameRoot)_p$(request.pathCode)" -> print }
        }
    }
}
emitDropPathName request: DropGlueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    "%dropg$(request.nameRoot)_p$(request.pathCode)" -> print
}
# Fixed-array calls return promoted heap backing even when their elements are
# copyable. A direct binding owns that backing independently of the
# element drop trait; aliases, stack literals and reference results do not.
promotedFixedArrayCall valueIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => result!
    valueIndex >= 0 and valueIndex < (context.ir -> len)
        -> if {
            valueIndex -> aggregateValueIndex(context, state) => sourceIndex
            context.ir[sourceIndex] => source
            source.typeId >= 0 and source.typeId < (context.types -> len)
                and context.types[source.typeId].kind == 4
                and ((source.kind == 6
                and not (source -> targetsNativeFunction(context, state))
                and (sourceIndex -> callHasResolvedFunctionTarget(context, state)))
                or (source.kind == 18 and source.nextOperand >= 0))
                -> if { sourceIndex => result! }
        }
    result!
}
bindingPromotedFixedArrayCall bindingIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => result!
    context.ir[bindingIndex] => binding
    binding.kind == 17 and binding.operand0 >= 0
        -> if { binding.operand0 -> promotedFixedArrayCall(context, state) => result! }
    result!
}
fixedBranchTransferredBacking valueIndex: Int, regionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => transferred!
    valueIndex -> ownedValueSourceIndex(context, state) => source
    source -> promotedFixedArrayCall(context, state) => backing
    valueIndex -> returnedOwnedBindingIndex(context, state) => binding
    backing >= 0 and binding < 0 -> if { backing => transferred! }
    backing >= 0 and binding >= 0
        and context.ir[binding].parent == regionIndex
        and context.ir[binding].flags != 1
        and (binding -> bindingPromotedFixedArrayCall(context, state)) >= 0
        -> if { backing => transferred! }
    transferred!
}
emitPromotedFixedBackingDrop callIndex: Int, edgeIndex: Int -> Unit uses Console {
    "  %fixedbacking$(edgeIndex)_$(callIndex) = extractvalue { ptr, i64 } %v$(callIndex), 0" -> println
    "  call void @free(ptr %fixedbacking$(edgeIndex)_$(callIndex))" -> println
}
emitDropGlue request: DropGlueRequest, edgeNodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    [request,; ~] => dropTasks!
    0 => dropTaskIndex!
    dropTaskIndex! < (dropTasks! -> len) -> while {
        dropTasks![dropTaskIndex!] => dropTask
        false => dropTaskMoved!
        dropTask.bindingIndex >= 0 and dropTask.hasPartialMoves
            -> if {
                context.ir[dropTask.bindingIndex] => dropGlueBinding
                context.ranges[dropGlueBinding.sourceModule] => dropGlueRange
                UIntSize(0) => dropGlueBeforeEnd!
                dropTask.beforeAst >= 0 -> if {
                    context.nodes[dropGlueRange.astStart + dropTask.beforeAst] => dropGlueEdgeAst
                    dropGlueEdgeAst.start + dropGlueEdgeAst.length => dropGlueBeforeEnd!
                }
                0 => dropGlueMoveIndex!
                dropGlueMoveIndex! < (context.moves -> len) and not dropTaskMoved!
                    -> while {
                        context.moves[dropGlueMoveIndex!] => dropGlueMove
                        (dropGlueMove.regionIr == dropTask.regionIndex or (edgeNodeIndex >= 0 and (dropGlueMove.regionIr -> ownershipRegionContainsEdge(edgeNodeIndex, context, state)))) => dropGlueMoveOnEdge
                        dropGlueMove.memberIr >= 0 and dropGlueMove.sourceModule == dropGlueBinding.sourceModule and dropGlueMove.symbol == dropGlueBinding.symbol and dropGlueMoveOnEdge and (dropGlueMoveIndex! -> partialMoveActiveBefore(dropGlueMove.regionIr, dropTask.beforeAst, context, state))
                            -> if {
                                context.ir[dropGlueMove.siteIr] => dropGlueSite
                                true => dropGlueMoveBeforeEdge!
                                dropTask.beforeAst >= 0 -> if {
                                    context.nodes[dropGlueRange.astStart + dropGlueSite.astNode].start >= dropGlueBeforeEnd!
                                        -> if { false => dropGlueMoveBeforeEdge! }
                                }
                                context.nodes[dropGlueRange.astStart + dropGlueSite.astNode].start <= context.nodes[dropGlueRange.astStart + dropGlueBinding.astNode].start
                                    -> if { false => dropGlueMoveBeforeEdge! }
                                0 => dropTaskDepth!
                                dropTaskIndex! => dropTaskCursor!
                                dropTaskCursor! >= 0 and dropTasks![dropTaskCursor!].fieldOrdinal >= 0
                                    -> while {
                                        dropTaskDepth! + 1 => dropTaskDepth!
                                        dropTasks![dropTaskCursor!].parentTask => dropTaskCursor!
                                    }
                                context.ir[dropGlueMove.memberIr] => dropMoveMember
                                context.ranges[dropMoveMember.sourceModule] => dropMoveRange
                                context.nodes[dropMoveRange.astStart + dropMoveMember.astNode] => dropMoveAst
                                -1 => dropMoveDepth!
                                dropMoveAst.firstToken => dropMoveTokenIndex!
                                dropMoveTokenIndex! < dropMoveAst.firstToken + dropMoveAst.tokenCount
                                    -> while {
                                        context.tokens[dropMoveRange.tokenStart + dropMoveTokenIndex!].kind == grammar.tokenIdIdentifier()
                                            -> if { dropMoveDepth! + 1 => dropMoveDepth! }
                                        dropMoveTokenIndex! + 1 => dropMoveTokenIndex!
                                    }
                                dropTaskDepth! == dropMoveDepth! => sameDropPath!
                                dropGlueBinding.typeOrigin => dropMoveCurrentOrigin!
                                dropGlueBinding.typeModule => dropMoveCurrentModule!
                                dropGlueBinding.typeSymbol => dropMoveCurrentSymbol!
                                0 => dropMoveIdentifierOrdinal!
                                dropMoveAst.firstToken => dropMoveTokenIndex!
                                sameDropPath! and dropMoveTokenIndex! < dropMoveAst.firstToken + dropMoveAst.tokenCount
                                    -> while {
                                        context.tokens[dropMoveRange.tokenStart + dropMoveTokenIndex!].kind == grammar.tokenIdIdentifier()
                                            -> if {
                                                dropMoveIdentifierOrdinal! > 0 -> if {
                                                    dropMoveCurrentModule! => dropMoveOwnerSource!
                                                    dropMoveCurrentOrigin! == 2 -> if { context.modules[dropMoveCurrentModule!].sourceIndex => dropMoveOwnerSource! }
                                                    context.ranges[dropMoveOwnerSource!] => dropMoveOwnerRange
                                                    -1 => dropMoveFieldOrdinal!
                                                    -1 => dropMoveFieldTypeNode!
                                                    0 => dropMoveCandidateOrdinal!
                                                    0 => dropMoveFieldIndex!
                                                    dropMoveFieldIndex! < dropMoveOwnerRange.symbolCount
                                                        -> while {
                                                            context.symbols[dropMoveOwnerRange.symbolStart + dropMoveFieldIndex!] => dropMoveField
                                                            dropMoveField.kind == 26 and dropMoveField.parent == dropMoveCurrentSymbol!
                                                                -> if {
                                                                    context.tokens[dropMoveRange.tokenStart + dropMoveTokenIndex!] => dropMoveName
                                                                    context.tokens[dropMoveOwnerRange.tokenStart + dropMoveField.nameToken] => dropMoveFieldName
                                                                    dropMoveName.span.length == dropMoveFieldName.span.length => dropMoveEqual!
                                                                    UIntSize(0) => dropMoveNameByte!
                                                                    dropMoveEqual! and dropMoveNameByte! < dropMoveName.span.length
                                                                        -> while {
                                                                            context.sources[dropMoveMember.sourceModule] -> byte(dropMoveName.span.start + dropMoveNameByte!) => dropMoveByte
                                                                            context.sources[dropMoveOwnerSource!] -> byte(dropMoveFieldName.span.start + dropMoveNameByte!) => dropMoveFieldByte
                                                                            dropMoveByte != dropMoveFieldByte -> if { false => dropMoveEqual! }
                                                                            dropMoveNameByte! + 1 => dropMoveNameByte!
                                                                        }
                                                                    dropMoveEqual! -> if {
                                                                        dropMoveCandidateOrdinal! => dropMoveFieldOrdinal!
                                                                        dropMoveField.typeNode => dropMoveFieldTypeNode!
                                                                    }
                                                                    dropMoveCandidateOrdinal! + 1 => dropMoveCandidateOrdinal!
                                                                }
                                                            dropMoveFieldIndex! + 1 => dropMoveFieldIndex!
                                                        }
                                                    dropTaskIndex! => dropTaskCursor!
                                                    dropTaskDepth! - dropMoveIdentifierOrdinal! => dropTaskParentSteps!
                                                    dropTaskParentSteps! > 0 -> while {
                                                        dropTasks![dropTaskCursor!].parentTask => dropTaskCursor!
                                                        dropTaskParentSteps! - 1 => dropTaskParentSteps!
                                                    }
                                                    dropMoveFieldOrdinal! < 0 or dropTasks![dropTaskCursor!].fieldOrdinal != dropMoveFieldOrdinal!
                                                        -> if { false => sameDropPath! }
                                                    0 => dropMoveNominalIndex!
                                                    dropMoveNominalIndex! < (context.nominal -> len)
                                                        -> while {
                                                            context.nominal[dropMoveNominalIndex!] => dropMoveNominalType
                                                            dropMoveNominalType.sourceModule == dropMoveOwnerSource! and dropMoveNominalType.typeAst == dropMoveFieldTypeNode!
                                                                -> if {
                                                                    dropMoveNominalType.origin => dropMoveCurrentOrigin!
                                                                    dropMoveNominalType.targetModule => dropMoveCurrentModule!
                                                                    dropMoveNominalType.targetSymbol => dropMoveCurrentSymbol!
                                                                }
                                                            dropMoveNominalIndex! + 1 => dropMoveNominalIndex!
                                                        }
                                                }
                                                dropMoveIdentifierOrdinal! + 1 => dropMoveIdentifierOrdinal!
                                            }
                                        dropMoveTokenIndex! + 1 => dropMoveTokenIndex!
                                    }
                                dropGlueMoveBeforeEdge! and sameDropPath! -> if { true => dropTaskMoved! }
                            }
                        dropGlueMoveIndex! + 1 => dropGlueMoveIndex!
                    }
            }
        not dropTaskMoved! and dropTask.typeId >= 0 and (not dropTask.hasPartialMoves or (dropTask.fieldOrdinal >= 0 and context.types[dropTask.typeId].kind != 1)) and (dropTask.typeId -> semanticTypeOwns(context, state))
            -> if {
                false => dropTaskNeedsFixedReload!
                false => dropTaskHasInlineArrayAbi!
                context.types[dropTask.typeId].kind == 4
                    -> if { true => dropTaskHasInlineArrayAbi! }
                dropTask.valueKind == 0
                    and dropTask.valueIndex >= 0
                    and dropTask.valueIndex < (context.ir -> len)
                    and dropTaskHasInlineArrayAbi!
                    and (context.ir[dropTask.valueIndex].kind == 14 or (dropTask.valueIndex -> promotedFixedArrayCall(context, state)) >= 0)
                    -> if {
                        true => dropTaskNeedsFixedReload!
                        "  %dropfixed$(edgeNodeIndex)_$(dropTaskIndex!)_data = extractvalue { ptr, i64 } %v$(dropTask.valueIndex), 0" -> println
                        "  %dropfixed$(edgeNodeIndex)_$(dropTaskIndex!) = load " -> print
                        dropTask.typeId -> writeSemanticTypeId(context, state)
                        ", ptr %dropfixed$(edgeNodeIndex)_$(dropTaskIndex!)_data, align " -> print
                        context.typeAligns[dropTask.typeId] -> writeDecimalLine
                    }
                "  call void @sollang_drop_t$(dropTask.typeId)(" -> print
                dropTask.typeId -> writeSemanticTypeId(context, state)
                " " -> print
                dropTaskNeedsFixedReload! -> if {
                    "%dropfixed$(edgeNodeIndex)_$(dropTaskIndex!)" -> print
                } else {
                    dropTask -> emitDropValueName(context, state)
                }
                ")" -> println
            } else {
                not dropTaskMoved! and (dropTask.typeOrigin == 13 or dropTask.typeOrigin == 14)
                    -> if {
                        "  " -> print
                        dropTask -> emitDropPathName(context, state)
                        "_data = extractvalue %sollang.array.i32 " -> print
                        dropTask -> emitDropValueName(context, state)
                        ", 0" -> println
                        "  call void @free(ptr " -> print
                        dropTask -> emitDropPathName(context, state)
                        "_data)" -> println
                    } else {
                        not dropTaskMoved! and dropTask.typeOrigin == 15
                            -> if {
                                "  " -> print
                                dropTask -> emitDropPathName(context, state)
                                "_keys = extractvalue %sollang.dict " -> print
                                dropTask -> emitDropValueName(context, state)
                                ", 0" -> println
                                "  call void @free(ptr " -> print
                                dropTask -> emitDropPathName(context, state)
                                "_keys)" -> println
                                "  " -> print
                                dropTask -> emitDropPathName(context, state)
                                "_values = extractvalue %sollang.dict " -> print
                                dropTask -> emitDropValueName(context, state)
                                ", 1" -> println
                                "  call void @free(ptr " -> print
                                dropTask -> emitDropPathName(context, state)
                                "_values)" -> println
                            } else {
                                not dropTaskMoved! and (dropTask.typeOrigin == 0 or dropTask.typeOrigin == 2)
                                    -> if {
                                        context.ranges[dropTask.typeModule] => dropStructRange
                                        0 => dropFieldOrdinal!
                                        0 => dropFieldIndex!
                                        dropFieldIndex! < dropStructRange.symbolCount
                                            -> while {
                                                context.symbols[dropStructRange.symbolStart + dropFieldIndex!] => dropField
                                                dropField.kind == 26 and dropField.parent == dropTask.typeSymbol
                                                    -> if {
                                                        -1 => dropFieldTypeId!
                                                        0 => canonicalDropFieldIndex!
                                                        canonicalDropFieldIndex! < (context.fields -> len)
                                                            -> while {
                                                                context.fields[canonicalDropFieldIndex!] => canonicalDropField
                                                                canonicalDropField.status == 0 and canonicalDropField.ownerType == dropTask.typeId and canonicalDropField.ordinal == dropFieldOrdinal!
                                                                    -> if {
                                                                        canonicalDropField.fieldType => dropFieldTypeId!
                                                                    }
                                                                canonicalDropFieldIndex! + 1 => canonicalDropFieldIndex!
                                                            }
                                                        -1 => dropFieldOrigin!
                                                        -1 => dropFieldModule!
                                                        -1 => dropFieldSymbol!
                                                        dropFieldTypeId! >= 0 and context.types[dropFieldTypeId!].kind == 1
                                                            -> if {
                                                                context.types[dropFieldTypeId!].origin => dropFieldOrigin!
                                                                context.types[dropFieldTypeId!].module => dropFieldModule!
                                                                context.types[dropFieldTypeId!].symbol => dropFieldSymbol!
                                                            }
                                                        # A canonical field type is authoritative. Its ownership trait
                                                        # selects the generated type-specific drop below; legacy
                                                        # origin fallbacks are only for fields with no canonical id.
                                                        0 => dropCompositeIndex!
                                                        dropCompositeIndex! < (context.composite -> len)
                                                            -> while {
                                                                context.composite[dropCompositeIndex!] => dropCompositeType
                                                                dropFieldTypeId! < 0
                                                                    and dropFieldOrigin! < 0
                                                                    and dropCompositeType.sourceModule == dropTask.typeModule
                                                                    and dropCompositeType.typeAst == dropField.typeNode
                                                                    -> if {
                                                                        dropCompositeType.kind == 3 -> if { 13 => dropFieldOrigin! }
                                                                        dropCompositeType.kind == 5 -> if { 15 => dropFieldOrigin! }
                                                                    }
                                                                dropCompositeIndex! + 1 => dropCompositeIndex!
                                                            }
                                                        0 => dropNominalIndex!
                                                        dropNominalIndex! < (context.nominal -> len)
                                                            -> while {
                                                                context.nominal[dropNominalIndex!] => dropNominalType
                                                                dropFieldTypeId! < 0
                                                                    and dropFieldOrigin! < 0
                                                                    and dropNominalType.sourceModule == dropTask.typeModule
                                                                    and dropNominalType.typeAst == dropField.typeNode
                                                                    and (dropNominalType.origin == 0 or dropNominalType.origin == 2)
                                                                    -> if {
                                                                        dropNominalType.origin => dropFieldOrigin!
                                                                        dropNominalType.targetModule => dropFieldModule!
                                                                        dropNominalType.targetSymbol => dropFieldSymbol!
                                                                    }
                                                                dropNominalIndex! + 1 => dropNominalIndex!
                                                            }
                                                        dropFieldOrigin! >= 0 or (dropFieldTypeId! >= 0 and (dropFieldTypeId! -> semanticTypeOwns(context, state)))
                                                            -> if {
                                                                dropTasks! -> len => dropFieldPath
                                                                "  %dropg$(dropTask.nameRoot)_p$dropFieldPath = extractvalue %sollang.struct.m$(dropTask.typeModule)_s$(dropTask.typeSymbol) " -> print
                                                                dropTask -> emitDropValueName(context, state)
                                                                ", $(dropFieldOrdinal!)" -> println
                                                                dropTasks! -> push(DropGlueRequest {
                                                                    typeId: dropFieldTypeId!
                                                                    typeOrigin: dropFieldOrigin!
                                                                    typeModule: dropFieldModule!
                                                                    typeSymbol: dropFieldSymbol!
                                                                    valueKind: 2
                                                                    valueIndex: -1
                                                                    nameRoot: dropTask.nameRoot
                                                                    pathCode: dropFieldPath
                                                                    bindingIndex: dropTask.bindingIndex
                                                                    regionIndex: dropTask.regionIndex
                                                                    beforeAst: dropTask.beforeAst
                                                                    parentTask: dropTaskIndex!
                                                                    fieldOrdinal: dropFieldOrdinal!
                                                                    hasPartialMoves: dropTask.hasPartialMoves
                                                                })
                                                            }
                                                        dropFieldOrdinal! + 1 => dropFieldOrdinal!
                                                    }
                                                dropFieldIndex! + 1 => dropFieldIndex!
                                            }
                                    }
                            }
                    }
            }
        dropTaskIndex! + 1 => dropTaskIndex!
    }
}

# Each move has one completion boundary. Value wrappers do not own transfers;
# calls and constructors do, with a direct enum member assignment completing
# at its destination store. Outer aggregates must not repeat an inner transfer.
nearestCompletedTransferOwner siteIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    siteIndex => ancestor!
    -1 => owner!
    ancestor! >= 0 and owner! < 0 -> while {
        context.ir[ancestor!] => candidate
        candidate.kind == 12
            or candidate.kind == 14
            or candidate.kind == 16
            or candidate.kind == 35
            or candidate.kind == 6
            or candidate.kind == 26
            or candidate.kind == 25
            or (candidate.kind == 9 and candidate.opcode != -1)
            -> if {
                ancestor! => owner!
                candidate.kind == 26 and candidate.parent >= 0
                    and context.ir[candidate.parent].kind == 25
                    and (context.ir[candidate.parent].operand0 -> aggregateValueIndex(context, state)) == ancestor!
                    -> if { candidate.parent => owner! }
            } else {
                candidate.kind == 0 or candidate.kind == 11 or candidate.kind == 19 or candidate.kind == 20
                    -> if { -1 => ancestor! } else { candidate.parent => ancestor! }
            }
    }
    owner!
}

nearestAggregateTransferOwner siteIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    siteIndex -> nearestCompletedTransferOwner(context, state) => owner
    owner >= 0 -> if {
        context.ir[owner].kind => kind
        kind == 12 or kind == 14 or kind == 16 or kind == 35
            -> if { owner -> return }
    }
    -1
}

# An owned parameter transferred into an aggregate inside a nested control arm
# must close its source owner on that exact path. A projected-field transfer
# drops retained fields beside the aggregate construction; a complete transfer
# only clears the path-ownership bit. Function cleanup must not free either
# transferred value a second time.
emitAggregatePartialMoveCleanup aggregateIndex: Int, functionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    [Int; ~] => cleanedBindings!
    0 => moveIndex!
    moveIndex! < (context.moves -> len) -> while {
        context.moves[moveIndex!] => candidateMove
        candidateMove.siteIr -> nearestAggregateTransferOwner(context, state)
            => moveAggregateOwner
        aggregateIndex >= 0 and aggregateIndex == moveAggregateOwner
            => aggregateContainsMove
        false => alreadyCleaned!
        context -> parameterIndexForFunction(functionIndex, candidateMove.symbol)
            => movedParameterIndex
        0 => cleanedIndex!
        cleanedIndex! < (cleanedBindings! -> len) and not alreadyCleaned!
            -> while {
                cleanedBindings![cleanedIndex!] == movedParameterIndex
                    -> if { true => alreadyCleaned! }
                cleanedIndex! + 1 => cleanedIndex!
            }
        aggregateContainsMove
            and not alreadyCleaned!
            and movedParameterIndex >= 0
            and movedParameterIndex < (context.ir -> len)
            and candidateMove.regionIr != context.ir[functionIndex].operand0
            and (movedParameterIndex -> moveParameterNeedsPathOwnershipFlag(functionIndex, context, state))
            -> if {
                candidateMove.memberIr >= 0 -> if {
                    context.ir[movedParameterIndex] => movedParameter
                    DropGlueRequest {
                        typeId: movedParameter.typeId
                        typeOrigin: movedParameter.typeOrigin
                        typeModule: movedParameter.typeModule
                        typeSymbol: movedParameter.typeSymbol
                        valueKind: 1
                        valueIndex: -1
                        nameRoot: aggregateIndex * 1000 + movedParameterIndex
                        pathCode: 0
                        bindingIndex: movedParameterIndex
                        regionIndex: candidateMove.regionIr
                        beforeAst: -1
                        parentTask: -1
                        fieldOrdinal: -1
                        hasPartialMoves: true
                    } -> emitDropGlue(aggregateIndex, context, state)
                }
                "  store i1 false, ptr %arg$(movedParameterIndex)_owned, align 1" -> println
                cleanedBindings! -> push(movedParameterIndex)
            }
        moveIndex! + 1 => moveIndex!
    }
}
semanticTypeOwns typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    typeId >= 0 and typeId < (context.typeTraits -> len)
        -> if {
            context.typeTraits[typeId] % 2 == 1
        } else { false }
}
isOwnedSocketType typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => owned!
    typeId >= 0 and typeId < (context.types -> len)
        -> if {
            context.types[typeId] => candidate
            candidate.kind == 1 and (candidate.origin == 0 or candidate.origin == 2) and candidate.module >= 0
                -> if {
                    false => socketModule!
                    0 => moduleSearch!
                    moduleSearch! < (context.modules -> len) -> while {
                        context.modules[moduleSearch!] => moduleIdentity
                        moduleIdentity.sourceIndex == candidate.module and moduleIdentity.pathHash == 13685761513169113882
                            -> if { true => socketModule! }
                        moduleSearch! + 1 => moduleSearch!
                    }
                    socketModule! -> if {
                        context.ranges[candidate.module] => candidateRange
                        candidate.symbol >= 0 and candidate.symbol < candidateRange.symbolCount
                            -> if {
                                context.symbols[candidateRange.symbolStart + candidate.symbol] => candidateSymbol
                                candidate.module -> sourceTokenIs(candidateSymbol.nameToken, "TcpListener", context, state)
                                    -> if { true => owned! }
                                candidate.module -> sourceTokenIs(candidateSymbol.nameToken, "TcpStream", context, state)
                                    -> if { true => owned! }
                                candidate.module -> sourceTokenIs(candidateSymbol.nameToken, "UdpSocket", context, state)
                                    -> if { true => owned! }
                            }
                    }
                }
        }
    owned!
}
isOwnedProcessChildType typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => owned!
    typeId >= 0 and typeId < (context.types -> len)
        -> if {
            context.types[typeId] => candidate
            candidate.kind == 1 and (candidate.origin == 0 or candidate.origin == 2) and candidate.module >= 0
                -> if {
                    false => processModule!
                    0 => moduleSearch!
                    moduleSearch! < (context.modules -> len) -> while {
                        context.modules[moduleSearch!] => moduleIdentity
                        moduleIdentity.sourceIndex == candidate.module and moduleIdentity.pathHash == 15528987723426532771
                            -> if { true => processModule! }
                        moduleSearch! + 1 => moduleSearch!
                    }
                    processModule! -> if {
                        context.ranges[candidate.module] => candidateRange
                        candidate.symbol >= 0 and candidate.symbol < candidateRange.symbolCount
                            -> if {
                                context.symbols[candidateRange.symbolStart + candidate.symbol] => candidateSymbol
                                candidate.module -> sourceTokenIs(candidateSymbol.nameToken, "Child", context, state)
                                    -> if { true => owned! }
                            }
                    }
                }
        }
    owned!
}

emitSemanticDropHelpers active: [Int; ~], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    0 => dropTypeIndex!
    dropTypeIndex! < (context.types -> len) -> while {
        context.types[dropTypeIndex!] => dropType
        false => supported!
        dropType.kind == 3 or dropType.kind == 4 or dropType.kind == 5 or dropType.kind == 6 or dropType.kind == 12 or dropType.kind == 13
            -> if { true => supported! }
        dropType.kind == 9 -> if { true => supported! }
        dropType.kind == 1 and dropType.origin == 1 and (dropType.symbol == 17 or dropType.symbol == 18 or dropType.symbol == 24)
            -> if { true => supported! }
        (dropType.kind == 1 and (dropType.origin == 0 or dropType.origin == 2)) or dropType.kind == 10
            -> if { true => supported! }
        dropType.kind == 7 and dropType.origin == 4 and (dropType.symbol == 0 or dropType.symbol == 1)
            -> if { true => supported! }
        dropType.kind == 7 and dropType.origin == 4 and (dropType.symbol == 3 or dropType.symbol == 4)
            -> if { true => supported! }
        dropType.kind == 7 and dropType.origin == 4 and (dropType.symbol == 5 or dropType.symbol == 6 or dropType.symbol == 7)
            -> if { true => supported! }
        active[dropTypeIndex!] == 1 and context.typeTraits[dropTypeIndex!] % 2 == 1 and supported!
            -> if {
                "define internal void @sollang_drop_t$(dropTypeIndex!)(" -> print
                dropTypeIndex! -> writeSemanticTypeId(context, state)
                " %value) {" -> println
                "entry:" -> println
                dropType.kind == 3 or dropType.kind == 12 or (dropType.kind == 7 and dropType.origin == 4 and dropType.symbol == 7)
                    -> if {
                        "  %data = extractvalue %sollang.array.i32 %value, 0" -> println
                        "  %length = extractvalue %sollang.array.i32 %value, 1" -> println
                        dropType.first >= 0 and context.typeTraits[dropType.first] % 2 == 1
                            -> if {
                                "  br label %loop" -> println
                                "loop:" -> println
                                "  %index = phi i64 [ 0, %entry ], [ %next, %continue ]" -> println
                                "  %in_range = icmp ult i64 %index, %length" -> println
                                "  br i1 %in_range, label %item, label %done" -> println
                                "item:" -> println
                                "  %slot = getelementptr " -> print
                                dropType.first -> writeSemanticTypeId(context, state)
                                ", ptr %data, i64 %index" -> println
                                "  %element = load " -> print
                                dropType.first -> writeSemanticTypeId(context, state)
                                ", ptr %slot, align " -> print
                                context.typeAligns[dropType.first] -> writeDecimalLine
                                "  call void @sollang_drop_t$(dropType.first)(" -> print
                                dropType.first -> writeSemanticTypeId(context, state)
                                " %element)" -> println
                                "  br label %continue" -> println
                                "continue:" -> println
                                "  %next = add i64 %index, 1" -> println
                                "  br label %loop" -> println
                                "done:" -> println
                            }
                        dropType.kind == 3 or (dropType.kind == 7 and dropType.origin == 4 and dropType.symbol == 7)
                            -> if { "  call void @free(ptr %data)" -> println }
                        "  ret void" -> println
                    }
                dropType.kind == 7 and dropType.origin == 4 and dropType.symbol == 6
                    -> if {
                        "  %data = extractvalue %sollang.array.i32 %value, 0" -> println
                        "  %length = extractvalue %sollang.array.i32 %value, 1" -> println
                        "  %capacity = extractvalue %sollang.array.i32 %value, 2" -> println
                        dropType.first >= 0 and context.typeTraits[dropType.first] % 2 == 1
                            -> if {
                                "  %head = load i64, ptr %data, align 8" -> println
                                "  %payload = getelementptr i8, ptr %data, i64 8" -> println
                                "  %mask = sub i64 %capacity, 1" -> println
                                "  br label %loop" -> println
                                "loop:" -> println
                                "  %index = phi i64 [ 0, %entry ], [ %next, %continue ]" -> println
                                "  %in_range = icmp ult i64 %index, %length" -> println
                                "  br i1 %in_range, label %item, label %done" -> println
                                "item:" -> println
                                "  %logical = add i64 %head, %index" -> println
                                "  %physical = and i64 %logical, %mask" -> println
                                "  %slot = getelementptr " -> print
                                dropType.first -> writeSemanticTypeId(context, state)
                                ", ptr %payload, i64 %physical" -> println
                                "  %element = load " -> print
                                dropType.first -> writeSemanticTypeId(context, state)
                                ", ptr %slot, align " -> print
                                context.typeAligns[dropType.first] -> writeDecimalLine
                                "  call void @sollang_drop_t$(dropType.first)(" -> print
                                dropType.first -> writeSemanticTypeId(context, state)
                                " %element)" -> println
                                "  br label %continue" -> println
                                "continue:" -> println
                                "  %next = add i64 %index, 1" -> println
                                "  br label %loop" -> println
                                "done:" -> println
                            }
                        "  call void @free(ptr %data)" -> println
                        "  ret void" -> println
                    }
                dropType.kind == 7 and dropType.origin == 4 and dropType.symbol == 5
                    -> if {
                        "  %keys = extractvalue %sollang.dict %value, 0" -> println
                        "  %controls = extractvalue %sollang.dict %value, 1" -> println
                        "  %capacity = extractvalue %sollang.dict %value, 3" -> println
                        dropType.first >= 0 and context.typeTraits[dropType.first] % 2 == 1
                            -> if {
                                "  br label %loop" -> println
                                "loop:" -> println
                                "  %index = phi i64 [ 0, %entry ], [ %next, %continue ]" -> println
                                "  %in_range = icmp ult i64 %index, %capacity" -> println
                                "  br i1 %in_range, label %check, label %done" -> println
                                "check:" -> println
                                "  %control_slot = getelementptr i8, ptr %controls, i64 %index" -> println
                                "  %control = load i8, ptr %control_slot, align 1" -> println
                                "  %occupied = icmp sgt i8 %control, 0" -> println
                                "  br i1 %occupied, label %item, label %continue" -> println
                                "item:" -> println
                                "  %key_slot = getelementptr " -> print
                                dropType.first -> writeSemanticTypeId(context, state)
                                ", ptr %keys, i64 %index" -> println
                                "  %key = load " -> print
                                dropType.first -> writeSemanticTypeId(context, state)
                                ", ptr %key_slot, align " -> print
                                context.typeAligns[dropType.first] -> writeDecimalLine
                                "  call void @sollang_drop_t$(dropType.first)(" -> print
                                dropType.first -> writeSemanticTypeId(context, state)
                                " %key)" -> println
                                "  br label %continue" -> println
                                "continue:" -> println
                                "  %next = add i64 %index, 1" -> println
                                "  br label %loop" -> println
                                "done:" -> println
                            }
                        "  call void @free(ptr %controls)" -> println
                        "  ret void" -> println
                    }
                dropType.kind == 4 -> if {
                    dropType.first >= 0 and context.typeTraits[dropType.first] % 2 == 1
                        -> if {
                            "  %storage = alloca " -> print
                            dropTypeIndex! -> writeSemanticTypeId(context, state)
                            ", align " -> print
                            context.typeAligns[dropTypeIndex!] -> writeDecimalLine
                            "  store " -> print
                            dropTypeIndex! -> writeSemanticTypeId(context, state)
                            " %value, ptr %storage, align " -> print
                            context.typeAligns[dropTypeIndex!] -> writeDecimalLine
                            "  br label %loop" -> println
                            "loop:" -> println
                            "  %index = phi i64 [ 0, %entry ], [ %next, %continue ]" -> println
                            "  %in_range = icmp ult i64 %index, " -> print
                            dropType.length -> writeDecimalLine
                            "  br i1 %in_range, label %item, label %done" -> println
                            "item:" -> println
                            "  %slot = getelementptr " -> print
                            dropTypeIndex! -> writeSemanticTypeId(context, state)
                            ", ptr %storage, i64 0, i64 %index" -> println
                            "  %element = load " -> print
                            dropType.first -> writeSemanticTypeId(context, state)
                            ", ptr %slot, align " -> print
                            context.typeAligns[dropType.first] -> writeDecimalLine
                            "  call void @sollang_drop_t$(dropType.first)(" -> print
                            dropType.first -> writeSemanticTypeId(context, state)
                            " %element)" -> println
                            "  br label %continue" -> println
                            "continue:" -> println
                            "  %next = add i64 %index, 1" -> println
                            "  br label %loop" -> println
                            "done:" -> println
                        }
                    "  ret void" -> println
                }
                dropType.kind == 5 or dropType.kind == 13 -> if {
                    "  %keys = extractvalue %sollang.dict %value, 0" -> println
                    "  %values = extractvalue %sollang.dict %value, 1" -> println
                    "  %length = extractvalue %sollang.dict %value, 2" -> println
                    "  %capacity = extractvalue %sollang.dict %value, 3" -> println
                    (dropType.first >= 0 and context.typeTraits[dropType.first] % 2 == 1) or (dropType.second >= 0 and context.typeTraits[dropType.second] % 2 == 1)
                        -> if {
                            "  %control_offset = mul i64 %capacity, " -> print
                            context.typeSizes[dropType.first] -> writeDecimalLine
                            "  %controls = getelementptr i8, ptr %keys, i64 %control_offset" -> println
                            "  br label %loop" -> println
                            "loop:" -> println
                            "  %index = phi i64 [ 0, %entry ], [ %next, %continue ]" -> println
                            "  %in_range = icmp ult i64 %index, %capacity" -> println
                            "  br i1 %in_range, label %check, label %done" -> println
                            "check:" -> println
                            "  %control_slot = getelementptr i8, ptr %controls, i64 %index" -> println
                            "  %control = load i8, ptr %control_slot, align 1" -> println
                            "  %occupied = icmp sgt i8 %control, 0" -> println
                            "  br i1 %occupied, label %item, label %continue" -> println
                            "item:" -> println
                            dropType.first >= 0 and context.typeTraits[dropType.first] % 2 == 1
                                -> if {
                                    "  %key_slot = getelementptr " -> print
                                    dropType.first -> writeSemanticTypeId(context, state)
                                    ", ptr %keys, i64 %index" -> println
                                    "  %key = load " -> print
                                    dropType.first -> writeSemanticTypeId(context, state)
                                    ", ptr %key_slot, align " -> print
                                    context.typeAligns[dropType.first] -> writeDecimalLine
                                    "  call void @sollang_drop_t$(dropType.first)(" -> print
                                    dropType.first -> writeSemanticTypeId(context, state)
                                    " %key)" -> println
                                }
                            dropType.second >= 0 and context.typeTraits[dropType.second] % 2 == 1
                                -> if {
                                    "  %value_slot = getelementptr " -> print
                                    dropType.second -> writeSemanticTypeId(context, state)
                                    ", ptr %values, i64 %index" -> println
                                    "  %item_value = load " -> print
                                    dropType.second -> writeSemanticTypeId(context, state)
                                    ", ptr %value_slot, align " -> print
                                    context.typeAligns[dropType.second] -> writeDecimalLine
                                    "  call void @sollang_drop_t$(dropType.second)(" -> print
                                    dropType.second -> writeSemanticTypeId(context, state)
                                    " %item_value)" -> println
                                }
                            "  br label %continue" -> println
                            "continue:" -> println
                            "  %next = add i64 %index, 1" -> println
                            "  br label %loop" -> println
                            "done:" -> println
                        }
                    dropType.kind == 5 -> if {
                        "  call void @free(ptr %keys)" -> println
                        "  call void @free(ptr %values)" -> println
                    }
                    "  ret void" -> println
                }
                dropType.kind == 6 -> if {
                    "  %present = icmp ne ptr %value, null" -> println
                    "  br i1 %present, label %drop, label %done" -> println
                    "drop:" -> println
                    dropType.first >= 0 and context.typeTraits[dropType.first] % 2 == 1
                        -> if {
                            "  %element = load " -> print
                            dropType.first -> writeSemanticTypeId(context, state)
                            ", ptr %value, align " -> print
                            context.typeAligns[dropType.first] -> writeDecimalLine
                            "  call void @sollang_drop_t$(dropType.first)(" -> print
                            dropType.first -> writeSemanticTypeId(context, state)
                            " %element)" -> println
                        }
                    "  call void @free(ptr %value)" -> println
                    "  br label %done" -> println
                    "done:" -> println
                    "  ret void" -> println
                }
                dropType.kind == 9 -> if {
                    context -> nativeHandleType(dropTypeIndex!) -> if {
                        context -> emitNativeHandleDrop(dropTypeIndex!)
                    } else {
                        "  call void @sollang_com_release(ptr %value)" -> println
                        "  ret void" -> println
                    }
                }
                dropType.kind == 1 and dropType.origin == 1 and dropType.symbol == 24
                    -> if {
                        "  call void @sollang_runtime_unmap_text(%sollang.source_text %value)" -> println
                        "  ret void" -> println
                    }
                dropType.kind == 1 and dropType.origin == 1 and (dropType.symbol == 17 or dropType.symbol == 18)
                    -> if {
                        "  %base = extractvalue %sollang.mapped_bytes %value, 2" -> println
                        "  %mapped_length = extractvalue %sollang.mapped_bytes %value, 3" -> println
                        "  %present = icmp ne ptr %base, null" -> println
                        "  br i1 %present, label %unmap, label %done" -> println
                        "unmap:" -> println
                        "  call void @sollang_mapped_unmap(ptr %base, i64 %mapped_length)" -> println
                        "  br label %done" -> println
                        "done:" -> println
                        "  ret void" -> println
                    }
                (dropType.kind == 1 and (dropType.origin == 0 or dropType.origin == 2) and not (dropTypeIndex! -> isNominalEnumType(context, state))) or dropType.kind == 10
                    -> if {
                        dropType.kind == 1 and (dropTypeIndex! -> isOwnedSocketType(context, state))
                            -> if {
                                "  %handle = extractvalue %sollang.struct.m$(dropType.module)_s$(dropType.symbol) %value, 0" -> println
                                "  call void @sollang_platform_close_socket(i64 %handle)" -> println
                            } else {
                                dropType.kind == 1 and (dropTypeIndex! -> isOwnedProcessChildType(context, state))
                                    -> if {
                                        "  %handle = extractvalue %sollang.struct.m$(dropType.module)_s$(dropType.symbol) %value, 0" -> println
                                        "  call void @sollang_drop_process_child(i64 %handle)" -> println
                                    } else {
                                        dropType.kind == 1 and (dropTypeIndex! -> isOwnedFileType(context, state))
                                            -> if {
                                                "  %handle = extractvalue %sollang.struct.m$(dropType.module)_s$(dropType.symbol) %value, 0" -> println
                                                "  call void @sollang_platform_close_owned_file(i64 %handle)" -> println
                                            } else {
                                                0 => dropFieldIndex!
                                                dropFieldIndex! < (context.fields -> len) -> while {
                                                    context.fields[dropFieldIndex!] => dropField
                                                    dropField.status == 0 and dropField.ownerType == dropTypeIndex! and dropField.fieldType >= 0 and context.typeTraits[dropField.fieldType] % 2 == 1
                                                        -> if {
                                                            "  %field$(dropField.ordinal) = extractvalue " -> print
                                                            dropTypeIndex! -> writeSemanticTypeId(context, state)
                                                            " %value, $(dropField.ordinal)" -> println
                                                            "  call void @sollang_drop_t$(dropField.fieldType)(" -> print
                                                            dropField.fieldType -> writeSemanticTypeId(context, state)
                                                            " %field$(dropField.ordinal))" -> println
                                                        }
                                                    dropFieldIndex! + 1 => dropFieldIndex!
                                                }
                                            }
                                    }
                            }
                        "  ret void" -> println
                    }
                dropType.kind == 7 and dropType.origin == 4 and (dropType.symbol == 3 or dropType.symbol == 4)
                    -> if {
                        "%sollang.stream" => producerDropType!
                        dropType.symbol == 4 -> if { "%sollang.event_stream" => producerDropType! }
                        "  %context = extractvalue $(producerDropType!) %value, 0" -> println
                        "  %drop = extractvalue $(producerDropType!) %value, 2" -> println
                        "  %has_drop = icmp ne ptr %drop, null" -> println
                        "  br i1 %has_drop, label %drop_state, label %done" -> println
                        "drop_state:" -> println
                        "  call void %drop(ptr %context)" -> println
                        "  br label %done" -> println
                        "done:" -> println
                        "  ret void" -> println
                    }
                dropType.kind == 7 and dropType.origin == 4 and (dropType.symbol == 0 or dropType.symbol == 1)
                    -> if {
                        "  %slot = alloca %sollang.enum.t$(dropTypeIndex!), align 8" -> println
                        "  store %sollang.enum.t$(dropTypeIndex!) %value, ptr %slot, align 8" -> println
                        "  %tag = extractvalue %sollang.enum.t$(dropTypeIndex!) %value, 0" -> println
                        "  %payload = getelementptr inbounds %sollang.enum.t$(dropTypeIndex!), ptr %slot, i32 0, i32 1" -> println
                        "  %is0 = icmp eq i32 %tag, 0" -> println
                        "  br i1 %is0, label %tag0, label %tag1" -> println
                        "tag0:" -> println
                        dropType.symbol == 1 and dropType.first >= 0 and context.typeTraits[dropType.first] % 2 == 1
                            -> if {
                                "  %first = load " -> print
                                dropType.first -> writeSemanticTypeId(context, state)
                                ", ptr %payload, align " -> print
                                context.typeAligns[dropType.first] -> writeDecimalLine
                                "  call void @sollang_drop_t$(dropType.first)(" -> print
                                dropType.first -> writeSemanticTypeId(context, state)
                                " %first)" -> println
                            }
                        "  br label %done" -> println
                        "tag1:" -> println
                        dropType.symbol == 0 -> if {
                            dropType.first >= 0 and context.typeTraits[dropType.first] % 2 == 1
                                -> if {
                                    "  %some = load " -> print
                                    dropType.first -> writeSemanticTypeId(context, state)
                                    ", ptr %payload, align " -> print
                                    context.typeAligns[dropType.first] -> writeDecimalLine
                                    "  call void @sollang_drop_t$(dropType.first)(" -> print
                                    dropType.first -> writeSemanticTypeId(context, state)
                                    " %some)" -> println
                                }
                        } else {
                            dropType.second >= 0 and context.typeTraits[dropType.second] % 2 == 1
                                -> if {
                                    "  %second = load " -> print
                                    dropType.second -> writeSemanticTypeId(context, state)
                                    ", ptr %payload, align " -> print
                                    context.typeAligns[dropType.second] -> writeDecimalLine
                                    "  call void @sollang_drop_t$(dropType.second)(" -> print
                                    dropType.second -> writeSemanticTypeId(context, state)
                                    " %second)" -> println
                                }
                        }
                        "  br label %done" -> println
                        "done:" -> println
                        "  ret void" -> println
                    }
                dropTypeIndex! -> isNominalEnumType(context, state)
                    -> if {
                        dropTypeIndex! -> enumVariantPayloadTypes(context, state) => nominalDropPayloads
                        "  %slot = alloca %sollang.enum.t$(dropTypeIndex!), align 8" -> println
                        "  store %sollang.enum.t$(dropTypeIndex!) %value, ptr %slot, align 8" -> println
                        "  %tag = extractvalue %sollang.enum.t$(dropTypeIndex!) %value, 0" -> println
                        "  %payload = getelementptr inbounds %sollang.enum.t$(dropTypeIndex!), ptr %slot, i32 0, i32 1" -> println
                        "  switch i32 %tag, label %invalid [" -> println
                        0 => variantOrdinal!
                        variantOrdinal! < (nominalDropPayloads -> len)
                            -> while {
                                "    i32 $(variantOrdinal!), label %tag$(variantOrdinal!)" -> println
                                variantOrdinal! + 1 => variantOrdinal!
                            }
                        "  ]" -> println
                        0 => variantDropOrdinal!
                        variantDropOrdinal! < (nominalDropPayloads -> len)
                            -> while {
                                nominalDropPayloads[variantDropOrdinal!] => payloadType
                                "tag$(variantDropOrdinal!):" -> println
                                payloadType >= 0 and context.typeTraits[payloadType] % 2 == 1
                                    -> if {
                                        "  %payload$(variantDropOrdinal!) = load " -> print
                                        payloadType -> writeSemanticTypeId(context, state)
                                        ", ptr %payload, align " -> print
                                        context.typeAligns[payloadType] -> writeDecimalLine
                                        "  call void @sollang_drop_t$(payloadType)(" -> print
                                        payloadType -> writeSemanticTypeId(context, state)
                                        " %payload$(variantDropOrdinal!))" -> println
                                    }
                                "  br label %done" -> println
                                variantDropOrdinal! + 1 => variantDropOrdinal!
                            }
                        "invalid:" -> println
                        "  call void @llvm.trap()" -> println
                        "  unreachable" -> println
                        "done:" -> println
                        "  ret void" -> println
                    }
                "}" -> println
            }
        dropTypeIndex! + 1 => dropTypeIndex!
    }
}
emitEnumPayloadDrop request: EnumPayloadDropRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.types[request.payloadTypeId] => payloadType
    payloadType.kind == 3 -> if {
        "  %enumdrop$(request.nameRoot)_payload = load %sollang.array.i32, ptr %enumdrop$(request.pointerRoot)_payload_ptr, align " -> print
        context.typeAligns[request.payloadTypeId] -> writeDecimalLine
        "  %enumdrop$(request.nameRoot)_data = extractvalue %sollang.array.i32 %enumdrop$(request.nameRoot)_payload, 0" -> println
        "  call void @free(ptr %enumdrop$(request.nameRoot)_data)" -> println
    }
    payloadType.kind == 5 -> if {
        "  %enumdrop$(request.nameRoot)_payload = load %sollang.dict, ptr %enumdrop$(request.pointerRoot)_payload_ptr, align " -> print
        context.typeAligns[request.payloadTypeId] -> writeDecimalLine
        "  %enumdrop$(request.nameRoot)_keys = extractvalue %sollang.dict %enumdrop$(request.nameRoot)_payload, 0" -> println
        "  call void @free(ptr %enumdrop$(request.nameRoot)_keys)" -> println
        "  %enumdrop$(request.nameRoot)_values = extractvalue %sollang.dict %enumdrop$(request.nameRoot)_payload, 1" -> println
        "  call void @free(ptr %enumdrop$(request.nameRoot)_values)" -> println
    }
    payloadType.kind == 6 -> if {
        "  %enumdrop$(request.nameRoot)_payload = load ptr, ptr %enumdrop$(request.pointerRoot)_payload_ptr, align " -> print
        context.typeAligns[request.payloadTypeId] -> writeDecimalLine
        "  call void @free(ptr %enumdrop$(request.nameRoot)_payload)" -> println
    }
    payloadType.kind == 1 and payloadType.origin == 1 and payloadType.symbol == 24
        -> if {
            "  %enumdrop$(request.nameRoot)_payload = load %sollang.source_text, ptr %enumdrop$(request.pointerRoot)_payload_ptr, align " -> print
            context.typeAligns[request.payloadTypeId] -> writeDecimalLine
            "  %enumdrop$(request.nameRoot)_owner = extractvalue %sollang.source_text %enumdrop$(request.nameRoot)_payload, 2" -> println
            "  call void @free(ptr %enumdrop$(request.nameRoot)_owner)" -> println
        }
    payloadType.kind == 1 and payloadType.origin == 1 and (payloadType.symbol == 17 or payloadType.symbol == 18)
        -> if {
            "  %enumdrop$(request.nameRoot)_payload = load %sollang.mapped_bytes, ptr %enumdrop$(request.pointerRoot)_payload_ptr, align 8" -> println
            "  %enumdrop$(request.nameRoot)_base = extractvalue %sollang.mapped_bytes %enumdrop$(request.nameRoot)_payload, 2" -> println
            "  %enumdrop$(request.nameRoot)_mapped_length = extractvalue %sollang.mapped_bytes %enumdrop$(request.nameRoot)_payload, 3" -> println
            "  call void @sollang_mapped_unmap(ptr %enumdrop$(request.nameRoot)_base, i64 %enumdrop$(request.nameRoot)_mapped_length)" -> println
        }
    payloadType.kind == 1 and (payloadType.origin == 0 or payloadType.origin == 2)
        -> if {
            "  %dropg$(request.nameRoot)_p0 = load %sollang.struct.m$(payloadType.module)_s$(payloadType.symbol), ptr %enumdrop$(request.pointerRoot)_payload_ptr, align " -> print
            context.typeAligns[request.payloadTypeId] -> writeDecimalLine
            DropGlueRequest {
                typeId: request.payloadTypeId
                typeOrigin: payloadType.origin
                typeModule: payloadType.module
                typeSymbol: payloadType.symbol
                valueKind: 2
                valueIndex: -1
                nameRoot: request.nameRoot
                pathCode: 0
                bindingIndex: request.bindingIndex
                regionIndex: request.regionIndex
                beforeAst: -1
                parentTask: -1
                fieldOrdinal: -1
                hasPartialMoves: false
            } -> emitDropGlue(-1, context, state)
        }
}
emitEnumDrop request: EnumDropRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    request.valueKind == 2 -> if {
        "  %enumdrop$(request.nameRoot)_value = load %sollang.enum.t$(request.typeId), ptr %slot$(request.valueIndex), align " -> print
        context.typeAligns[request.typeId] -> writeDecimalLine
    }
    "  call void @sollang_drop_t$(request.typeId)(%sollang.enum.t$(request.typeId) " -> print
    request.valueKind == 0 -> if { "%v$(request.valueIndex)" -> print }
    request.valueKind == 1 -> if {
        context.ir[request.regionIndex].parent => enumParameterOwner!
        enumParameterOwner! >= 0 and context.ir[enumParameterOwner!].kind != 0 and context.ir[enumParameterOwner!].kind != 11
            -> while {
                context.ir[enumParameterOwner!].parent => enumParameterOwner!
            }
        context -> writeParameterReference(enumParameterOwner!, context.ir[request.bindingIndex].symbol) => enumParameterWritten
    }
    request.valueKind == 3 -> if {
        request.regionIndex => enumParameterOwner!
        enumParameterOwner! >= 0 and context.ir[enumParameterOwner!].kind != 0 and context.ir[enumParameterOwner!].kind != 11
            -> while {
                context.ir[enumParameterOwner!].parent => enumParameterOwner!
            }
        context -> writeParameterReference(enumParameterOwner!, context.ir[request.valueIndex].symbol) => enumParameterWritten
    }
    request.valueKind == 2 -> if { "%enumdrop$(request.nameRoot)_value" -> print }
    ")" -> println
}
nominalDeclarationAst typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => declarationAst!
    typeId >= 0 and typeId < (context.types -> len)
        -> if {
            context.types[typeId] => nominalType
            nominalType.kind == 1 and (nominalType.origin == 0 or nominalType.origin == 2) and nominalType.module >= 0 and nominalType.module < (context.ranges -> len)
                -> if {
                    context.ranges[nominalType.module] => nominalRange
                    nominalType.symbol >= 0 and nominalType.symbol < nominalRange.symbolCount
                        -> if {
                            context.symbols[nominalRange.symbolStart + nominalType.symbol] => nominalSymbol
                            nominalSymbol.astNode >= 0 -> if { nominalSymbol.astNode => declarationAst! }
                        }
                }
        }
    declarationAst!
}
isNominalEnumType typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    typeId -> nominalDeclarationAst(context, state) => declarationAst
    false => result!
    declarationAst >= 0 -> if {
        context.types[typeId] => nominalType
        context.ranges[nominalType.module] => nominalRange
        context.nodes[nominalRange.astStart + declarationAst].kind == 4
            -> if { true => result! }
    }
    result!
}
sameNominalTypeIdentity leftTypeId: Int, rightTypeId: Int, context: ref emitterContext.EmitContext -> Bool {
    false => same!
    leftTypeId >= 0
        and leftTypeId < (context.types -> len)
        and rightTypeId >= 0
        and rightTypeId < (context.types -> len)
        -> if {
            context.types[leftTypeId] => leftType
            context.types[rightTypeId] => rightType
            leftType.kind == 1
                and rightType.kind == 1
                and leftType.module == rightType.module
                and leftType.symbol == rightType.symbol
                -> if { true => same! }
        }
    same!
}
# One slot per declaration-order variant, including Unit for payload-free cases.
# Repeated payload types remain distinct variants with distinct runtime tags.
enumVariantPayloadTypes typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> [Int; ~] {
    [Int; ~] => payloads!
    typeId -> isNominalEnumType(context, state) -> if {
        context.types[typeId] => enumType
        context.ranges[enumType.module] => enumRange
        0 => variantIndex!
        variantIndex! < enumRange.symbolCount -> while {
            context.symbols[enumRange.symbolStart + variantIndex!] => variant
            variant.kind == 27 and variant.parent == enumType.symbol
                -> if {
                    -1 => payloadType!
                    variant.typeNode < 0 -> if { 0 => payloadType! } else {
                        context.typeReferences -> each reference {
                            reference.status == 0 and reference.sourceModule == enumType.module
                                and reference.typeAst == variant.typeNode
                                -> if { reference.typeId => payloadType! }
                        }
                    }
                    # Across module fragments the concrete constructor can provide
                    # the type, but it must match this exact variant, not a neighbor.
                    payloadType! < 0 -> if {
                        context.ir -> each constructor {
                            constructor.kind == 26 and constructor.targetModule == enumType.module
                                and constructor.symbol == variantIndex! and constructor.operand0 >= 0
                                -> if {
                                    context.ir[constructor.operand0] -> effectiveTypeId(context, state) => payloadType!
                                }
                        }
                    }
                    payloads! -> push(payloadType!)
                }
            variantIndex! + 1 => variantIndex!
        }
    }
    payloads!
}

enumPayloadTypes typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> [Int; ~] {
    [Int; ~] => payloads!
    typeId -> isNominalEnumType(context, state) -> if {
        typeId -> enumVariantPayloadTypes(context, state) => variants
        variants -> each payload {
            payload > 0 -> if { payloads! -> push(payload) }
        }
    } else {
        context.types[typeId] => enumType
        enumType.kind == 7 and enumType.origin == 4 and (enumType.symbol == 0 or enumType.symbol == 1)
            -> if {
                enumType.first >= 0 -> if { payloads! -> push(enumType.first) }
                enumType.second >= 0 -> if { payloads! -> push(enumType.second) }
            }
    }
    payloads!
}
writeSemanticTypeId typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    [typeId,; ~] => typeTasks!
    typeTasks! -> len => typeTaskSize!
    typeTaskSize! > 0 -> while {
        typeTaskSize! - 1 => typeTaskSize!
        typeTasks![typeTaskSize!] => typeTask
        typeTask < 0 -> if { "]" -> print } else {
            context.types[typeTask] => current
            current.kind == 2 -> if { "{ ptr, i64 }" -> print }
            current.kind == 3 -> if { "%sollang.array.i32" -> print }
            current.kind == 12 -> if { "%sollang.array.i32" -> print }
            current.kind == 5 -> if { "%sollang.dict" -> print }
            current.kind == 13 -> if { "%sollang.dict" -> print }
            current.kind == 14 -> if { "%sollang.bitset.t$(typeTask)" -> print }
            current.kind == 6 -> if { "ptr" -> print }
            current.kind == 8 -> if { "ptr" -> print }
            current.kind == 9 -> if { "ptr" -> print }
            current.kind == 10 -> if { "%sollang.product.t$(typeTask)" -> print }
            current.kind == 7 -> if {
                current.origin == 4 and (current.symbol == 0 or current.symbol == 1)
                    -> if { "%sollang.enum.t$(typeTask)" -> print }
                current.origin == 4 and current.symbol == 2
                    -> if { "%sollang.task" -> print }
                current.origin == 4 and current.symbol == 3
                    -> if { "%sollang.stream" -> print }
                current.origin == 4 and current.symbol == 4
                    -> if { "%sollang.event_stream" -> print }
                current.origin == 4 and current.symbol == 5
                    -> if { "%sollang.dict" -> print }
                current.origin == 4 and (current.symbol == 6 or current.symbol == 7)
                    -> if { "%sollang.array.i32" -> print }
            }
            current.kind == 4 -> if {
                "[$(current.length) x " -> print
                typeTaskSize! == (typeTasks! -> len) -> if { typeTasks! -> push(-1) } else { -1 => typeTasks![typeTaskSize!] }
                typeTaskSize! + 1 => typeTaskSize!
                typeTaskSize! == (typeTasks! -> len) -> if { typeTasks! -> push(current.first) } else { current.first => typeTasks![typeTaskSize!] }
                typeTaskSize! + 1 => typeTaskSize!
            }
            current.kind == 1 -> if {
                current.origin == 0 or current.origin == 2 -> if {
                    typeTask -> isNominalEnumType(context, state)
                        -> if { "%sollang.enum.t$(typeTask)" -> print } else { "%sollang.struct.m$(current.module)_s$(current.symbol)" -> print }
                } else {
                    current.symbol == 0 -> if { "void" -> print }
                    current.symbol == 1 -> if { "%sollang.text" -> print }
                    current.symbol == 15 -> if { "%sollang.array.i32" -> print }
                    current.symbol == 17 or current.symbol == 18 -> if { "%sollang.mapped_bytes" -> print }
                    current.symbol == 2 or current.symbol == 5 or current.symbol == 10 or current.symbol == 14
                        -> if { "i32" -> print }
                    current.symbol == 3 or current.symbol == 8 -> if { "i8" -> print }
                    current.symbol == 4 or current.symbol == 9 -> if { "i16" -> print }
                    current.symbol == 6 or current.symbol == 7 or current.symbol == 11 or current.symbol == 16
                        -> if { "i64" -> print }
                    current.symbol == 12 or current.symbol == 13
                        -> if {
                            context.pointerBitWidth == 32 -> if { "i32" -> print } else { "i64" -> print }
                        }
                    current.symbol == 19 or current.symbol == 20
                        -> if { "float" -> print }
                    current.symbol == 21 or current.symbol == 22
                        -> if { "double" -> print }
                    current.symbol == 23 -> if { "i1" -> print }
                    current.symbol == 24 -> if { "%sollang.source_text" -> print }
                    current.symbol == 25 -> if { "{ i32, i32 }" -> print }
                }
            }
        }
    }
}
effectiveTypeId node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    node.typeId => effective!
    node.kind == 5 and node.operand0 >= 0 and context.ir[node.operand0].kind == 17 and context.ir[node.operand0].flags == 1
        -> if {
            node.operand0 -> mutableBindingRoot(context, state) => effectiveBindingRoot
            context.ir[effectiveBindingRoot].typeId >= 0
                -> if { context.ir[effectiveBindingRoot].typeId => effective! }
        }
    effective!
}
writeIrType node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    # Recursive semantic identity is authoritative. The legacy projection
    # can still carry a stale imported nominal module on region nodes, so
    # consulting it first reintroduces sys.file.SourceText as an unrelated
    # user struct even when typeId already names the canonical builtin.
    # Byte indexing is lowered directly to an i8 load in every expression
    # region. Its producer ABI is therefore UInt8 even when an inferred use
    # retained the surrounding integer context in legacy node metadata.
    (node.kind == 9 or node.kind == 6) and node.opcode == -202
        -> if {
            "i8" -> print
        } else {
            # Legacy origin 16 names both boxes and erased trait objects.
            # A canonical box keeps its pointer ABI when used as an enum payload.
            node -> effectiveTypeId(context, state) => typeId
            node.typeOrigin == 16 and not (typeId >= 0 and context.types[typeId].kind == 6)
                -> if {
                    "%sollang.dyn" -> print
                } else {
                    node -> integerNodeWidth(context, state) => effectiveIntegerWidth
                    effectiveIntegerWidth > 0 -> if {
                        "i$(effectiveIntegerWidth)" -> print
                    } else {
                        typeId >= 0 and context.types[typeId].kind == 4
                            -> if {
                                # Fixed-array expression values use the documented borrowed
                                # pointer/length ABI. Their canonical storage type remains inline
                                # and is still written by writeSemanticTypeId for owner layouts.
                                "{ ptr, i64 }" -> print
                            } else {
                                typeId >= 0 -> if { typeId -> writeSemanticTypeId(context, state) } else { node -> writeType }
                            }
                    }
                }
        }
}
llvmType symbol: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Text {
    "void" => result!
    symbol == 1 -> if { "%sollang.text" => result! }
    symbol == 15 -> if { "%sollang.array.i32" => result! }
    symbol == 16 -> if { "i64" => result! }
    symbol == 17 or symbol == 18 -> if { "%sollang.mapped_bytes" => result! }
    symbol == 2 or symbol == 5 or symbol == 10 or symbol == 14
        -> if { "i32" => result! }
    symbol == 3 or symbol == 8 -> if { "i8" => result! }
    symbol == 4 or symbol == 9 -> if { "i16" => result! }
    symbol == 6 or symbol == 7 or symbol == 11 or symbol == 12 or symbol == 13
        -> if { "i64" => result! }
    symbol == 19 or symbol == 20 -> if { "float" => result! }
    symbol == 21 or symbol == 22 -> if { "double" => result! }
    symbol == 23 -> if { "i1" => result! }
    symbol == 24 -> if { "%sollang.source_text" => result! }
    symbol == 25 -> if { "{ i32, i32 }" => result! }
    result! => selected
    selected
}
storageSize symbol: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    4 => result!
    symbol == 1 -> if { 16 => result! }
    symbol == 15 -> if { 24 => result! }
    symbol == 16 -> if { 8 => result! }
    symbol == 17 or symbol == 18 -> if { 40 => result! }
    symbol == 3 or symbol == 8 or symbol == 23 -> if { 1 => result! }
    # %sollang.source_text is { ptr, i64, ptr, i64 }. The i64 members keep
    # 8-byte alignment on wasm32, so both wasm32 and x64 use 32 bytes.
    symbol == 24 -> if { 32 => result! }
    symbol == 25 -> if { 8 => result! }
    symbol == 4 or symbol == 9 -> if { 2 => result! }
    symbol == 6 or symbol == 7 or symbol == 11 or symbol == 12 or symbol == 13 or symbol == 21 or symbol == 22
        -> if { 8 => result! }
    result! => selected
    selected
}
integerWidth symbol: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    0 => result!
    symbol == 3 or symbol == 8 -> if { 8 => result! }
    symbol == 4 or symbol == 9 -> if { 16 => result! }
    symbol == 2 or symbol == 5 or symbol == 10 or symbol == 14
        -> if { 32 => result! }
    symbol == 6 or symbol == 7 or symbol == 11 or symbol == 12 or symbol == 13
        -> if { 64 => result! }
    result! => selected
    selected
}
integerSigned symbol: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    symbol == 2 or symbol == 3 or symbol == 4 or symbol == 5 or symbol == 6 or symbol == 7
}
integerNodeSigned node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    node.typeSymbol => symbol!
    node -> effectiveTypeId(context, state) => typeId
    typeId >= 0 and typeId < (context.types -> len)
        -> if {
            context.types[typeId] => canonicalType
            canonicalType.kind == 1 and canonicalType.origin == 1
                -> if {
                    canonicalType.symbol => symbol!
                }
        }
    symbol! => canonicalSymbol
    (node.kind == 9 or node.kind == 6) and node.opcode == -202
        -> if { false } else {
            canonicalSymbol -> integerSigned(context, state)
        }
}
memberNodeIntegerWidth node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    0 => width!
    -1 => canonicalMemberOwnerTypeId!
    node.kind == 13 and node.operand0 >= 0 and node.operand0 < (context.ir -> len)
        -> if {
            context.ir[node.operand0] -> effectiveTypeId(context, state) => canonicalMemberOwnerTypeId!
            canonicalMemberOwnerTypeId! >= 0 and context.types[canonicalMemberOwnerTypeId!].kind == 8
                -> if {
                    context.types[canonicalMemberOwnerTypeId!].first => canonicalMemberOwnerTypeId!
                }
            node -> sourceNode(context, state) => canonicalWidthMemberAst
            context.ir[node.operand0] -> sourceNode(context, state) => canonicalWidthBaseAst
            canonicalWidthBaseAst.start + canonicalWidthBaseAst.length
                => canonicalWidthBaseEnd
            canonicalWidthMemberAst.firstToken => canonicalWidthTokenIndex!
            true => canonicalWidthBeforeBaseEnd!
            canonicalWidthBeforeBaseEnd!
                and canonicalWidthTokenIndex! < canonicalWidthMemberAst.firstToken + canonicalWidthMemberAst.tokenCount
                -> while {
                    context.ranges[node.sourceModule].tokenStart + canonicalWidthTokenIndex!
                        => canonicalWidthGlobalTokenIndex
                    context.tokens[canonicalWidthGlobalTokenIndex].span.start < canonicalWidthBaseEnd
                        -> if {
                            canonicalWidthTokenIndex! + 1 => canonicalWidthTokenIndex!
                        } else {
                            false => canonicalWidthBeforeBaseEnd!
                        }
                }
            false => canonicalWidthPathInvalid!
            false => canonicalWidthPathFound!
            canonicalWidthTokenIndex! < canonicalWidthMemberAst.firstToken + canonicalWidthMemberAst.tokenCount
                and not canonicalWidthPathInvalid!
                -> while {
                    context.ranges[node.sourceModule].tokenStart + canonicalWidthTokenIndex!
                        => canonicalWidthGlobalTokenIndex
                    context.tokens[canonicalWidthGlobalTokenIndex].kind == grammar.tokenIdIdentifier()
                        -> if {
                            true => canonicalWidthPathFound!
                            canonicalMemberOwnerTypeId! >= 0
                                and context.types[canonicalMemberOwnerTypeId!].kind == 8
                                -> if {
                                    context.types[canonicalMemberOwnerTypeId!].first
                                        => canonicalMemberOwnerTypeId!
                                }
                            canonicalMemberOwnerTypeId!
                                -> canonicalMemberFieldIndex(
                            node.sourceModule,
                            canonicalWidthTokenIndex!,
                            context)
                                => canonicalWidthFieldIndex
                            canonicalWidthFieldIndex >= 0 -> if {
                                context.fields[canonicalWidthFieldIndex].fieldType
                                    => canonicalMemberOwnerTypeId!
                            } else {
                                true => canonicalWidthPathInvalid!
                            }
                        }
                    canonicalWidthTokenIndex! + 1 => canonicalWidthTokenIndex!
                }
            canonicalWidthPathFound!
                and not canonicalWidthPathInvalid!
                and canonicalMemberOwnerTypeId! >= 0
                -> if {
                    context.types[canonicalMemberOwnerTypeId!] => canonicalWidthType
                    canonicalWidthType.kind == 1 and canonicalWidthType.origin == 1
                        -> if {
                            canonicalWidthType.symbol -> integerWidth(context, state) => width!
                            canonicalWidthType.symbol == 12 or canonicalWidthType.symbol == 13
                                -> if {
                                    context.pointerBitWidth => width!
                                }
                        }
                }
        }
    node.kind == 13 and node.operand0 >= 0 and canonicalMemberOwnerTypeId! < 0
        -> if {
            context.ir[node.operand0] => memberBase
            memberBase.typeOrigin => currentOrigin!
            memberBase.typeModule => currentModule!
            memberBase.typeSymbol => currentSymbol!
            node -> sourceNode(context, state) => memberAst
            memberBase -> sourceNode(context, state) => memberBaseAst
            memberBaseAst.start + memberBaseAst.length => memberBaseEnd
            memberAst.firstToken => memberTokenIndex!
            true => beforeMemberBaseEnd!
            beforeMemberBaseEnd! and memberTokenIndex! < memberAst.firstToken + memberAst.tokenCount
                -> while {
                    context.tokens[context.ranges[node.sourceModule].tokenStart + memberTokenIndex!].span.start < memberBaseEnd
                        -> if {
                            memberTokenIndex! + 1 => memberTokenIndex!
                        } else { false => beforeMemberBaseEnd! }
                }
            memberTokenIndex! < memberAst.firstToken + memberAst.tokenCount
                -> while {
                    context.tokens[context.ranges[node.sourceModule].tokenStart + memberTokenIndex!].kind == grammar.tokenIdIdentifier()
                        -> if {
                            currentModule! => ownerSourceModule!
                            currentOrigin! == 2 -> if { context.modules[currentModule!].sourceIndex => ownerSourceModule! }
                            context.ranges[ownerSourceModule!] => ownerRange
                            0 => memberFieldSearch!
                            false => memberFieldFound!
                            not memberFieldFound! and memberFieldSearch! < ownerRange.symbolCount
                                -> while {
                                    context.symbols[ownerRange.symbolStart + memberFieldSearch!] => memberField
                                    memberField.kind == 26 and memberField.parent == currentSymbol!
                                        -> if {
                                            context.tokens[context.ranges[node.sourceModule].tokenStart + memberTokenIndex!] => memberName
                                            context.tokens[ownerRange.tokenStart + memberField.nameToken] => fieldName
                                            memberName.span.length == fieldName.span.length => fieldEqual!
                                            UIntSize(0) => fieldNameByte!
                                            fieldEqual! and fieldNameByte! < memberName.span.length
                                                -> while {
                                                    context.sources[node.sourceModule] -> byte(memberName.span.start + fieldNameByte!) => memberByte
                                                    context.sources[ownerSourceModule!] -> byte(fieldName.span.start + fieldNameByte!) => fieldByte
                                                    memberByte != fieldByte -> if { false => fieldEqual! }
                                                    fieldNameByte! + 1 => fieldNameByte!
                                                }
                                            fieldEqual! -> if {
                                                true => memberFieldFound!
                                                -1 => memberFieldTypeIndex!
                                                0 => memberFieldTypeSearch!
                                                memberFieldTypeSearch! < (context.nominal -> len)
                                                    -> while {
                                                        context.nominal[memberFieldTypeSearch!].sourceModule == ownerSourceModule! and context.nominal[memberFieldTypeSearch!].typeAst == memberField.typeNode
                                                            -> if {
                                                                memberFieldTypeSearch! => memberFieldTypeIndex!
                                                            }
                                                        memberFieldTypeSearch! + 1 => memberFieldTypeSearch!
                                                    }
                                                memberFieldTypeIndex! >= 0 -> if {
                                                    context.nominal[memberFieldTypeIndex!] => memberFieldType
                                                    memberFieldType.origin => currentOrigin!
                                                    memberFieldType.targetModule => currentModule!
                                                    memberFieldType.targetSymbol => currentSymbol!
                                                } else {
                                                    -1 => currentOrigin!
                                                    0 => memberCompositeSearch!
                                                    memberCompositeSearch! < (context.composite -> len)
                                                        -> while {
                                                            context.composite[memberCompositeSearch!] => memberCompositeType
                                                            memberCompositeType.sourceModule == ownerSourceModule! and memberCompositeType.typeAst == memberField.typeNode
                                                                -> if {
                                                                    10 + memberCompositeType.kind => currentOrigin!
                                                                    memberCompositeType.elementModule => currentModule!
                                                                    memberCompositeType.elementSymbol => currentSymbol!
                                                                }
                                                            memberCompositeSearch! + 1 => memberCompositeSearch!
                                                        }
                                                }
                                            }
                                        }
                                    memberFieldSearch! + 1 => memberFieldSearch!
                                }
                        }
                    memberTokenIndex! + 1 => memberTokenIndex!
                }
            currentOrigin! == 1 -> if {
                currentSymbol! -> integerWidth(context, state) => width!
                currentSymbol! == 12 or currentSymbol! == 13
                    -> if { context.pointerBitWidth => width! }
            }
        }
    width!
}
referenceValueTypeId node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => valueTypeId!
    node -> effectiveTypeId(context, state) => referenceTypeId
    referenceTypeId >= 0
        and referenceTypeId < (context.types -> len)
        and context.types[referenceTypeId].kind == 8
        -> if {
            context.types[referenceTypeId].first => candidateTypeId
            candidateTypeId >= 0 and candidateTypeId < (context.types -> len)
                -> if { candidateTypeId => valueTypeId! }
        }
    valueTypeId!
}

scalarReferenceValueTypeId node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => valueTypeId!
    node -> referenceValueTypeId(context, state) => candidateTypeId
    candidateTypeId >= 0 -> if {
        context.types[candidateTypeId] => candidateType
        candidateType.kind == 1 and candidateType.origin == 1
            -> if {
                candidateType.symbol -> integerWidth(context, state) => candidateWidth
                candidateWidth > 0 or candidateType.symbol == 23
                    -> if { candidateTypeId => valueTypeId! }
            }
    }
    valueTypeId!
}
integerNodeWidth node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => symbol!
    false => canonicalReference!
    node.typeOrigin == 1 -> if { node.typeSymbol => symbol! }
    node -> effectiveTypeId(context, state) => typeId
    typeId >= 0 and typeId < (context.types -> len)
        -> if {
            context.types[typeId] => canonicalType
            canonicalType.kind == 1 and canonicalType.origin == 1
                -> if {
                    canonicalType.symbol => symbol!
                }
            canonicalType.kind == 8 -> if { true => canonicalReference! }
        }
    symbol! -> integerWidth(context, state) => width!
    symbol! == 23 -> if { 1 => width! }
    symbol! == 12 or symbol! == 13 -> if { context.pointerBitWidth => width! }
    (node.kind == 9 or node.kind == 6) and node.opcode == -202
        -> if { 8 => width! }
    node.kind == 13 and not canonicalReference!
        -> if {
            node -> memberNodeIntegerWidth(context, state) => memberWidth
            memberWidth > 0 -> if { memberWidth => width! }
        }
