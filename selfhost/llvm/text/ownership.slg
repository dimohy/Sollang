            node -> sourceNode(context, state) => canonicalWidthMemberAst
            context.ir[node.operand0] -> sourceNode(context, state) => canonicalWidthBaseAst
            canonicalWidthBaseAst.start + canonicalWidthBaseAst.length
                => canonicalWidthBaseEnd
            canonicalWidthMemberAst.firstToken => canonicalWidthTokenIndex!
