                                    -> if {
                                        "  %handle = extractvalue %sollang.struct.m$(dropType.module)_s$(dropType.symbol) %value, 0" -> println
                                        "  call void @sollang_drop_process_child(i64 %handle)" -> println
                                    } else {
                                        dropType.kind == 1 and (dropTypeIndex! -> isOwnedFileType(context, state))
                                            -> if {
                                                "  %handle = extractvalue %sollang.struct.m$(dropType.module)_s$(dropType.symbol) %value, 0" -> println
                                                "  call void @sollang_platform_close_owned_file(i64 %handle)" -> println
                                            } else {
                                                0 => dropFieldIndex!
                                                dropFieldIndex! < (context.fields -> len) -> while {
                                                    context.fields[dropFieldIndex!] => dropField
                                                    dropField.status == 0 and dropField.ownerType == dropTypeIndex! and dropField.fieldType >= 0
                                                        and (context.typeTraits[dropField.fieldType] % 2 == 1 or context.types[dropField.fieldType].kind == 4)
                                                        -> if {
                                                            "  %field$(dropField.ordinal) = extractvalue " -> print
                                                            dropTypeIndex! -> writeSemanticTypeId(context, state)
                                                            " %value, $(dropField.ordinal)" -> println
                                                            context.types[dropField.fieldType].kind == 4
                                                                -> if {
                                                                    "  %field_data$(dropField.ordinal) = extractvalue { ptr, i64 } %field$(dropField.ordinal), 0" -> println
                                                                    dropField.fieldType -> semanticTypeOwns(context, state)
                                                                        -> if {
                                                                            "  %field_elements$(dropField.ordinal) = load " -> print
                                                                            dropField.fieldType -> writeSemanticTypeId(context, state)
                                                                            ", ptr %field_data$(dropField.ordinal), align " -> print
                                                                            context.typeAligns[dropField.fieldType] -> writeDecimalLine
                                                                            "  call void @sollang_drop_t$(dropField.fieldType)(" -> print
                                                                            dropField.fieldType -> writeSemanticTypeId(context, state)
                                                                            " %field_elements$(dropField.ordinal))" -> println
                                                                        }
                                                                    "  call void @free(ptr %field_data$(dropField.ordinal))" -> println
                                                                } else {
                                                                    "  call void @sollang_drop_t$(dropField.fieldType)(" -> print
                                                                    dropField.fieldType -> writeSemanticTypeId(context, state)
                                                                    " %field$(dropField.ordinal))" -> println
                                                                }
                                                        }
                                                    dropFieldIndex! + 1 => dropFieldIndex!
                                                }
                                            }
                                    }
                            }
                        "  ret void" -> println
                    }
                dropType.kind == 7 and dropType.origin == 4 and (dropType.symbol == 3 or dropType.symbol == 4)
                    -> if {
                        "%sollang.stream" => producerDropType!
                        dropType.symbol == 4 -> if { "%sollang.event_stream" => producerDropType! }
                        "  %context = extractvalue $(producerDropType!) %value, 0" -> println
                        "  %drop = extractvalue $(producerDropType!) %value, 2" -> println
                        "  %has_drop = icmp ne ptr %drop, null" -> println
                        "  br i1 %has_drop, label %drop_state, label %done" -> println
                        "drop_state:" -> println
                        "  call void %drop(ptr %context, i1 true)" -> println
                        "  br label %done" -> println
                        "done:" -> println
                        "  ret void" -> println
                    }
                dropType.kind == 7 and dropType.origin == 4 and (dropType.symbol == 0 or dropType.symbol == 1)
                    -> if {
                        "  %slot = alloca %sollang.enum.t$(dropTypeIndex!), align 8" -> println
                        "  store %sollang.enum.t$(dropTypeIndex!) %value, ptr %slot, align 8" -> println
                        "  %tag = extractvalue %sollang.enum.t$(dropTypeIndex!) %value, 0" -> println
                        "  %payload = getelementptr inbounds %sollang.enum.t$(dropTypeIndex!), ptr %slot, i32 0, i32 1" -> println
                        "  %is0 = icmp eq i32 %tag, 0" -> println
                        "  br i1 %is0, label %tag0, label %tag1" -> println
                        "tag0:" -> println
                        dropType.symbol == 1 -> if {
                            dropType.first -> emitStoredEnumPayloadDrop("first", context, state)
                        }
                        "  br label %done" -> println
                        "tag1:" -> println
                        dropType.symbol == 0 -> if {
                            dropType.first -> emitStoredEnumPayloadDrop("some", context, state)
                        } else {
                            dropType.second -> emitStoredEnumPayloadDrop("second", context, state)
                        }
                        "  br label %done" -> println
                        "done:" -> println
                        "  ret void" -> println
                    }
                dropTypeIndex! -> isNominalEnumType(context, state)
                    -> if {
                        dropTypeIndex! -> enumVariantPayloadTypes(context, state) => nominalDropPayloads
                        "  %slot = alloca %sollang.enum.t$(dropTypeIndex!), align 8" -> println
                        "  store %sollang.enum.t$(dropTypeIndex!) %value, ptr %slot, align 8" -> println
                        "  %tag = extractvalue %sollang.enum.t$(dropTypeIndex!) %value, 0" -> println
                        "  %payload = getelementptr inbounds %sollang.enum.t$(dropTypeIndex!), ptr %slot, i32 0, i32 1" -> println
                        "  switch i32 %tag, label %invalid [" -> println
                        0 => variantOrdinal!
                        variantOrdinal! < (nominalDropPayloads -> len)
                            -> while {
                                "    i32 $(variantOrdinal!), label %tag$(variantOrdinal!)" -> println
                                variantOrdinal! + 1 => variantOrdinal!
                            }
                        "  ]" -> println
                        0 => variantDropOrdinal!
                        variantDropOrdinal! < (nominalDropPayloads -> len)
                            -> while {
                                nominalDropPayloads[variantDropOrdinal!] => payloadType
                                "tag$(variantDropOrdinal!):" -> println
                                payloadType >= 0 and context.typeTraits[payloadType] % 2 == 1
                                    -> if {
                                        "  %payload$(variantDropOrdinal!) = load " -> print
                                        payloadType -> writeSemanticTypeId(context, state)
                                        ", ptr %payload, align " -> print
                                        context.typeAligns[payloadType] -> writeDecimalLine
                                        "  call void @sollang_drop_t$(payloadType)(" -> print
                                        payloadType -> writeSemanticTypeId(context, state)
                                        " %payload$(variantDropOrdinal!))" -> println
                                    }
                                "  br label %done" -> println
                                variantDropOrdinal! + 1 => variantDropOrdinal!
                            }
                        "invalid:" -> println
                        "  call void @llvm.trap()" -> println
                        "  unreachable" -> println
                        "done:" -> println
                        "  ret void" -> println
                    }
                "}" -> println
            }
        dropTypeIndex! + 1 => dropTypeIndex!
    }
}
# Destruction of a stored enum payload includes its fixed descriptor backing.
# Inline fixed-array drop glue only destroys elements and cannot free that carrier.
emitStoredEnumPayloadDrop typeId: Int, name: Text, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    typeId >= 0 -> if {
        context.types[typeId] => payloadType
        payloadType.kind == 4 -> if {
            "  %$(name) = load { ptr, i64 }, ptr %payload, align 8" -> println
            "  %$(name)_data = extractvalue { ptr, i64 } %$(name), 0" -> println
            context.typeTraits[typeId] % 2 == 1 -> if {
                "  %$(name)_elements = load " -> print
                typeId -> writeSemanticTypeId(context, state)
                ", ptr %$(name)_data, align " -> print
                context.typeAligns[typeId] -> writeDecimalLine
                "  call void @sollang_drop_t$(typeId)(" -> print
                typeId -> writeSemanticTypeId(context, state)
                " %$(name)_elements)" -> println
            }
            "  call void @free(ptr %$(name)_data)" -> println
        } else {
            context.typeTraits[typeId] % 2 == 1 -> if {
                "  %$(name) = load " -> print
                typeId -> writeSemanticTypeId(context, state)
                ", ptr %payload, align " -> print
                context.typeAligns[typeId] -> writeDecimalLine
                "  call void @sollang_drop_t$(typeId)(" -> print
                typeId -> writeSemanticTypeId(context, state)
                " %$(name))" -> println
            }
        }
    }
}

emitEnumPayloadDrop request: EnumPayloadDropRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.types[request.payloadTypeId] => payloadType
    payloadType.kind == 3 -> if {
        "  %enumdrop$(request.nameRoot)_payload = load %sollang.array.i32, ptr %enumdrop$(request.pointerRoot)_payload_ptr, align " -> print
        context.typeAligns[request.payloadTypeId] -> writeDecimalLine
        "  %enumdrop$(request.nameRoot)_data = extractvalue %sollang.array.i32 %enumdrop$(request.nameRoot)_payload, 0" -> println
        "  call void @free(ptr %enumdrop$(request.nameRoot)_data)" -> println
    }
    payloadType.kind == 5 -> if {
        "  %enumdrop$(request.nameRoot)_payload = load %sollang.dict, ptr %enumdrop$(request.pointerRoot)_payload_ptr, align " -> print
        context.typeAligns[request.payloadTypeId] -> writeDecimalLine
        "  %enumdrop$(request.nameRoot)_keys = extractvalue %sollang.dict %enumdrop$(request.nameRoot)_payload, 0" -> println
        "  call void @free(ptr %enumdrop$(request.nameRoot)_keys)" -> println
    }
    payloadType.kind == 13 and context.typeTraits[request.payloadTypeId] % 2 == 1
        -> if {
            "  %enumdrop$(request.nameRoot)_payload = load " -> print
            request.payloadTypeId -> writeSemanticTypeId(context, state)
            ", ptr %enumdrop$(request.pointerRoot)_payload_ptr, align " -> print
            context.typeAligns[request.payloadTypeId] -> writeDecimalLine
            "  call void @sollang_drop_t$(request.payloadTypeId)(" -> print
            request.payloadTypeId -> writeSemanticTypeId(context, state)
            " %enumdrop$(request.nameRoot)_payload)" -> println
        }
    payloadType.kind == 6 -> if {
        "  %enumdrop$(request.nameRoot)_payload = load ptr, ptr %enumdrop$(request.pointerRoot)_payload_ptr, align " -> print
        context.typeAligns[request.payloadTypeId] -> writeDecimalLine
        "  call void @free(ptr %enumdrop$(request.nameRoot)_payload)" -> println
    }
    payloadType.kind == 1 and payloadType.origin == 1 and payloadType.symbol == 24
        -> if {
            "  %enumdrop$(request.nameRoot)_payload = load %sollang.source_text, ptr %enumdrop$(request.pointerRoot)_payload_ptr, align " -> print
            context.typeAligns[request.payloadTypeId] -> writeDecimalLine
            "  call void @sollang_runtime_unmap_text(%sollang.source_text %enumdrop$(request.nameRoot)_payload)" -> println
        }
    payloadType.kind == 1 and payloadType.origin == 1 and (payloadType.symbol == 17 or payloadType.symbol == 18)
        -> if {
            "  %enumdrop$(request.nameRoot)_payload = load %sollang.mapped_bytes, ptr %enumdrop$(request.pointerRoot)_payload_ptr, align 8" -> println
            "  %enumdrop$(request.nameRoot)_base = extractvalue %sollang.mapped_bytes %enumdrop$(request.nameRoot)_payload, 2" -> println
            "  %enumdrop$(request.nameRoot)_mapped_length = extractvalue %sollang.mapped_bytes %enumdrop$(request.nameRoot)_payload, 3" -> println
            "  call void @sollang_mapped_unmap(ptr %enumdrop$(request.nameRoot)_base, i64 %enumdrop$(request.nameRoot)_mapped_length)" -> println
        }
    payloadType.kind == 1 and (payloadType.origin == 0 or payloadType.origin == 2)
        -> if {
            "  %dropg$(request.nameRoot)_p0 = load %sollang.struct.m$(payloadType.module)_s$(payloadType.symbol), ptr %enumdrop$(request.pointerRoot)_payload_ptr, align " -> print
            context.typeAligns[request.payloadTypeId] -> writeDecimalLine
            DropGlueRequest {
                typeId: request.payloadTypeId
                typeOrigin: payloadType.origin
                typeModule: payloadType.module
                typeSymbol: payloadType.symbol
                valueKind: 2
                valueIndex: -1
                nameRoot: request.nameRoot
                pathCode: 0
                bindingIndex: request.bindingIndex
                regionIndex: request.regionIndex
                beforeAst: -1
                parentTask: -1
                fieldOrdinal: -1
                hasPartialMoves: false
            } -> emitDropGlue(-1, context, state)
        }
}
emitEnumDrop request: EnumDropRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    request.valueKind == 2 -> if {
        "  %enumdrop$(request.nameRoot)_value = load %sollang.enum.t$(request.typeId), ptr %slot$(request.valueIndex), align " -> print
        context.typeAligns[request.typeId] -> writeDecimalLine
    }
    "  call void @sollang_drop_t$(request.typeId)(%sollang.enum.t$(request.typeId) " -> print
    request.valueKind == 0 -> if { "%v$(request.valueIndex)" -> print }
    request.valueKind == 1 -> if {
        context.ir[request.regionIndex].parent => enumParameterOwner!
        enumParameterOwner! >= 0 and context.ir[enumParameterOwner!].kind != 0 and context.ir[enumParameterOwner!].kind != 11
            -> while {
                context.ir[enumParameterOwner!].parent => enumParameterOwner!
            }
        context -> writeParameterReference(enumParameterOwner!, context.ir[request.bindingIndex].symbol) => enumParameterWritten
    }
    request.valueKind == 3 -> if {
        request.regionIndex => enumParameterOwner!
        enumParameterOwner! >= 0 and context.ir[enumParameterOwner!].kind != 0 and context.ir[enumParameterOwner!].kind != 11
            -> while {
                context.ir[enumParameterOwner!].parent => enumParameterOwner!
            }
        context -> writeParameterReference(enumParameterOwner!, context.ir[request.valueIndex].symbol) => enumParameterWritten
    }
    request.valueKind == 2 -> if { "%enumdrop$(request.nameRoot)_value" -> print }
    ")" -> println
}
nominalDeclarationAst typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => declarationAst!
    typeId >= 0 and typeId < (context.types -> len)
        -> if {
            context.types[typeId] => nominalType
            nominalType.kind == 1 and (nominalType.origin == 0 or nominalType.origin == 2) and nominalType.module >= 0 and nominalType.module < (context.ranges -> len)
                -> if {
                    context.ranges[nominalType.module] => nominalRange
                    nominalType.symbol >= 0 and nominalType.symbol < nominalRange.symbolCount
                        -> if {
                            context.symbols[nominalRange.symbolStart + nominalType.symbol] => nominalSymbol
                            nominalSymbol.astNode >= 0 -> if { nominalSymbol.astNode => declarationAst! }
                        }
                }
        }
    declarationAst!
}
isNominalEnumType typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    typeId -> nominalDeclarationAst(context, state) => declarationAst
    false => result!
    declarationAst >= 0 -> if {
        context.types[typeId] => nominalType
        context.ranges[nominalType.module] => nominalRange
        context.nodes[nominalRange.astStart + declarationAst].kind == 4
            -> if { true => result! }
    }
    result!
}
sameNominalTypeIdentity leftTypeId: Int, rightTypeId: Int, context: ref emitterContext.EmitContext -> Bool {
    false => same!
    leftTypeId >= 0
        and leftTypeId < (context.types -> len)
        and rightTypeId >= 0
        and rightTypeId < (context.types -> len)
        -> if {
            context.types[leftTypeId] => leftType
            context.types[rightTypeId] => rightType
            leftType.kind == 1
                and rightType.kind == 1
                and leftType.module == rightType.module
                and leftType.symbol == rightType.symbol
                -> if { true => same! }
        }
    same!
}
# One slot per declaration-order variant, including Unit for payload-free cases.
# Repeated payload types remain distinct variants with distinct runtime tags.
enumVariantPayloadTypes typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> [Int; ~] {
    [Int; ~] => payloads!
    typeId -> isNominalEnumType(context, state) -> if {
        context.types[typeId] => enumType
        context.ranges[enumType.module] => enumRange
        0 => variantIndex!
        variantIndex! < enumRange.symbolCount -> while {
            context.symbols[enumRange.symbolStart + variantIndex!] => variant
            variant.kind == 27 and variant.parent == enumType.symbol
                -> if {
                    -1 => payloadType!
                    variant.typeNode < 0 -> if { 0 => payloadType! } else {
                        context.typeReferences -> each reference {
                            reference.status == 0 and reference.sourceModule == enumType.module
                                and reference.typeAst == variant.typeNode
                                -> if { reference.typeId => payloadType! }
                        }
                    }
                    # Across module fragments the concrete constructor can provide
                    # the type, but it must match this exact variant, not a neighbor.
                    payloadType! < 0 -> if {
                        context.ir -> each constructor {
                            constructor.kind == 26 and constructor.targetModule == enumType.module
                                and constructor.symbol == variantIndex! and constructor.operand0 >= 0
                                -> if {
                                    context.ir[constructor.operand0] -> effectiveTypeId(context, state) => payloadType!
                                }
                        }
                    }
                    payloads! -> push(payloadType!)
                }
            variantIndex! + 1 => variantIndex!
        }
    }
    payloads!
}

enumPayloadTypes typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> [Int; ~] {
    [Int; ~] => payloads!
    typeId -> isNominalEnumType(context, state) -> if {
        typeId -> enumVariantPayloadTypes(context, state) => variants
        variants -> each payload {
            payload > 0 -> if { payloads! -> push(payload) }
        }
    } else {
        context.types[typeId] => enumType
        enumType.kind == 7 and enumType.origin == 4 and (enumType.symbol == 0 or enumType.symbol == 1)
            -> if {
                enumType.first >= 0 -> if { payloads! -> push(enumType.first) }
                enumType.second >= 0 -> if { payloads! -> push(enumType.second) }
            }
    }
    payloads!
}
writeAggregateFieldTypeId typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.types[typeId].kind == 4 -> if { "{ ptr, i64 }" -> print } else { typeId -> writeSemanticTypeId(context, state) }
}
writeSemanticTypeId typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    [typeId,; ~] => typeTasks!
    typeTasks! -> len => typeTaskSize!
    typeTaskSize! > 0 -> while {
        typeTaskSize! - 1 => typeTaskSize!
        typeTasks![typeTaskSize!] => typeTask
        typeTask < 0 -> if { "]" -> print } else {
            context.types[typeTask] => current
            current.kind == 2 -> if { "{ ptr, i64 }" -> print }
            current.kind == 3 -> if { "%sollang.array.i32" -> print }
            current.kind == 12 -> if { "%sollang.array.i32" -> print }
            current.kind == 5 -> if { "%sollang.dict" -> print }
            current.kind == 13 -> if { "%sollang.bounded_dictionary.t$(typeTask)" -> print }
            current.kind == 14 -> if { "%sollang.bitset.t$(typeTask)" -> print }
            current.kind == 6 -> if { "ptr" -> print }
            current.kind == 8 -> if { "ptr" -> print }
            current.kind == 9 -> if { "ptr" -> print }
            current.kind == 10 -> if { "%sollang.product.t$(typeTask)" -> print }
            current.kind == 7 -> if {
                current.origin == 4 and (current.symbol == 0 or current.symbol == 1)
                    -> if { "%sollang.enum.t$(typeTask)" -> print }
                current.origin == 4 and current.symbol == 2
                    -> if { "%sollang.task" -> print }
                current.origin == 4 and current.symbol == 3
                    -> if { "%sollang.stream" -> print }
                current.origin == 4 and current.symbol == 4
                    -> if { "%sollang.event_stream" -> print }
                current.origin == 4 and current.symbol == 5
                    -> if { "%sollang.dict" -> print }
                current.origin == 4 and (current.symbol == 6 or current.symbol == 7)
                    -> if { "%sollang.array.i32" -> print }
            }
            current.kind == 4 -> if {
                "[$(current.length) x " -> print
                typeTaskSize! == (typeTasks! -> len) -> if { typeTasks! -> push(-1) } else { -1 => typeTasks![typeTaskSize!] }
                typeTaskSize! + 1 => typeTaskSize!
                typeTaskSize! == (typeTasks! -> len) -> if { typeTasks! -> push(current.first) } else { current.first => typeTasks![typeTaskSize!] }
                typeTaskSize! + 1 => typeTaskSize!
            }
            current.kind == 1 -> if {
                current.origin == 16 -> if { "%sollang.dyn" -> print } else {
                    current.origin == 0 or current.origin == 2 -> if {
                        typeTask -> isNominalEnumType(context, state)
                            -> if { "%sollang.enum.t$(typeTask)" -> print } else { "%sollang.struct.m$(current.module)_s$(current.symbol)" -> print }
                    } else {
                        current.symbol == 0 -> if { "void" -> print }
                        current.symbol == 1 -> if { "%sollang.text" -> print }
                        current.symbol == 15 -> if { "%sollang.array.i32" -> print }
                        current.symbol == 17 or current.symbol == 18 -> if { "%sollang.mapped_bytes" -> print }
                        current.symbol == 2 or current.symbol == 5 or current.symbol == 10 or current.symbol == 14
                            -> if { "i32" -> print }
                        current.symbol == 3 or current.symbol == 8 -> if { "i8" -> print }
                        current.symbol == 4 or current.symbol == 9 -> if { "i16" -> print }
                        current.symbol == 6 or current.symbol == 7 or current.symbol == 11 or current.symbol == 16
                            -> if { "i64" -> print }
                        current.symbol == 12 or current.symbol == 13
                            -> if {
                                context.pointerBitWidth == 32 -> if { "i32" -> print } else { "i64" -> print }
                            }
                        current.symbol == 19 or current.symbol == 20
                            -> if { "float" -> print }
                        current.symbol == 21 or current.symbol == 22
                            -> if { "double" -> print }
                        current.symbol == 23 -> if { "i1" -> print }
                        current.symbol == 24 -> if { "%sollang.source_text" -> print }
                        current.symbol == 25 -> if { "{ i32, i32 }" -> print }
                    }
                }
            }
        }
    }
}
effectiveTypeId node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    node.typeId => effective!
    node.kind == 5 and node.operand0 >= 0 and context.ir[node.operand0].kind == 17 and context.ir[node.operand0].flags == 1
        -> if {
            node.operand0 -> mutableBindingRoot(context, state) => effectiveBindingRoot
            context.ir[effectiveBindingRoot].typeId >= 0
                -> if { context.ir[effectiveBindingRoot].typeId => effective! }
        }
    effective!
}
isAsyncTaskValue node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext -> Bool {
    # Await produces its joined value, not the Task read by its source name.
    # A joined Task still has the canonical Task result type.
    node.kind == 5 and node.sourceModule >= 0 and node.sourceModule < (context.ranges -> len)
        and node.astNode >= 0 -> if {
            context.ranges[node.sourceModule] => range
            node.astNode < range.astCount and context.awaitSourceByAst[range.astStart + node.astNode]
                -> if {
                    node.typeId >= 0 and node.typeId < (context.types -> len)
                        -> if {
                            context.types[node.typeId] => resultType
                            resultType.kind == 7 and resultType.origin == 4 and resultType.symbol == 2 -> return
                        }
                    false -> return
                }
        }
    node -> typedIr.isAsyncTaskValue(context.ir)
}

writeIrType node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    # The semantic result type names the joined payload, not a Task handle.
    node -> isAsyncTaskValue(context) -> if {
        "%sollang.task" -> print
        return
    }
    # Recursive semantic identity is authoritative. The legacy projection
    # can still carry a stale imported nominal module on region nodes, so
    # consulting it first reintroduces sys.file.SourceText as an unrelated
    # user struct even when typeId already names the canonical builtin.
    # Byte indexing is lowered directly to an i8 load in every expression
    # region. Its producer ABI is therefore UInt8 even when an inferred use
    # retained the surrounding integer context in legacy node metadata.
    (node.kind == 9 or node.kind == 6) and node.opcode == -202
        -> if {
            "i8" -> print
        } else {
            # Legacy origin 16 names both boxes and erased trait objects.
            # A canonical box keeps its pointer ABI when used as an enum payload.
            node -> effectiveTypeId(context, state) => typeId
            node.typeOrigin == 16 and not (typeId >= 0 and context.types[typeId].kind == 6)
                -> if {
                    "%sollang.dyn" -> print
                } else {
                    node -> integerNodeWidth(context, state) => effectiveIntegerWidth
                    effectiveIntegerWidth > 0 -> if {
                        "i$(effectiveIntegerWidth)" -> print
                    } else {
                        typeId >= 0 and context.types[typeId].kind == 4
                            -> if {
                                # Fixed-array expression values use the documented borrowed
                                # pointer/length ABI. Their canonical storage type remains inline
                                # and is still written by writeSemanticTypeId for owner layouts.
                                "{ ptr, i64 }" -> print
                            } else {
                                typeId >= 0 -> if { typeId -> writeSemanticTypeId(context, state) } else { node -> writeType }
                            }
                    }
                }
        }
}
llvmType symbol: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Text {
    symbol -> when {
        == 1 { "%sollang.text" }
        == 2 { "i32" }
        == 3 { "i8" }
        == 4 { "i16" }
        == 5 { "i32" }
        6..7 { "i64" }
        == 8 { "i8" }
        == 9 { "i16" }
        == 10 { "i32" }
        11..13 { "i64" }
        == 14 { "i32" }
        == 15 { "%sollang.array.i32" }
        == 16 { "i64" }
        17..18 { "%sollang.mapped_bytes" }
        19..20 { "float" }
        21..22 { "double" }
        == 23 { "i1" }
        == 24 { "%sollang.source_text" }
        == 25 { "{ i32, i32 }" }
        else { "void" }
    }
}
storageSize symbol: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    4 => result!
    symbol == 1 -> if { 16 => result! }
    symbol == 15 -> if { 24 => result! }
    symbol == 16 -> if { 8 => result! }
    symbol == 17 or symbol == 18 -> if { 40 => result! }
    symbol == 3 or symbol == 8 or symbol == 23 -> if { 1 => result! }
    # %sollang.source_text is { ptr, i64, ptr, i64 }. The i64 members keep
    # 8-byte alignment on wasm32, so both wasm32 and x64 use 32 bytes.
    symbol == 24 -> if { 32 => result! }
    symbol == 25 -> if { 8 => result! }
    symbol == 4 or symbol == 9 -> if { 2 => result! }
    symbol == 6 or symbol == 7 or symbol == 11 or symbol == 12 or symbol == 13 or symbol == 21 or symbol == 22
        -> if { 8 => result! }
    result! => selected
    selected
}
integerWidth symbol: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    0 => result!
    symbol == 3 or symbol == 8 -> if { 8 => result! }
    symbol == 4 or symbol == 9 -> if { 16 => result! }
    symbol == 2 or symbol == 5 or symbol == 10 or symbol == 14
        -> if { 32 => result! }
    symbol == 6 or symbol == 7 or symbol == 11 or symbol == 12 or symbol == 13
        -> if { 64 => result! }
    result! => selected
    selected
}
integerSigned symbol: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    symbol == 2 or symbol == 3 or symbol == 4 or symbol == 5 or symbol == 6 or symbol == 7 or symbol == 12
}
integerNodeSigned node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    node.typeSymbol => symbol!
    node -> effectiveTypeId(context, state) => declaredTypeId
    context.types -> typeIds.materializedReadTypeId(declaredTypeId) => typeId
    typeId >= 0 and typeId < (context.types -> len)
        -> if {
            context.types[typeId] => canonicalType
            canonicalType.kind == 1 and canonicalType.origin == 1
                -> if {
                    canonicalType.symbol => symbol!
                }
        }
    symbol! => canonicalSymbol
    (node.kind == 9 or node.kind == 6) and node.opcode == -202
        -> if { false } else {
            canonicalSymbol -> integerSigned(context, state)
        }
}
