        -> if {
            context.ir[node.operand0] -> effectiveTypeId(context, state) => canonicalMemberOwnerTypeId!
            canonicalMemberOwnerTypeId! >= 0 and context.types[canonicalMemberOwnerTypeId!].kind == 8
                -> if {
                    context.types[canonicalMemberOwnerTypeId!].first => canonicalMemberOwnerTypeId!
