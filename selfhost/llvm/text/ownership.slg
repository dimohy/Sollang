# Responsibility fragment extracted from emitCore. State is passed by readonly
# reference, preserving the original direct-call and allocation behavior.
# Fresh producers and explicitly moving parameters transfer cleanup to the match.
# Named owners, borrowed parameters and projections retain their owner lifetime.
namedStructFieldProjection valueIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    valueIndex >= 0 and valueIndex < (context.ir -> len)
        -> unless { false -> return }
    context.ir[valueIndex].kind == 13 -> unless { false -> return }
    valueIndex => currentIndex!
    currentIndex! >= 0 and currentIndex! < (context.ir -> len)
        and context.ir[currentIndex!].kind == 13
        -> while { context.ir[currentIndex!].operand0 => currentIndex! }
    currentIndex! >= 0 and currentIndex! < (context.ir -> len)
        -> unless { false -> return }
    context.ir[currentIndex!] => owner
    owner.kind == 5
}

materializedEnumSubject subjectIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> typedIr.TypedIrNode {
    context.ir[subjectIndex] => subject!
    subject! -> referenceValueTypeId(context, state) => valueTypeId
    valueTypeId >= 0 -> if {
        context.types[valueTypeId] => valueType
        valueTypeId => subject!.typeId
        valueType.kind => subject!.typeKind
        valueType.origin => subject!.typeOrigin
        valueType.module => subject!.typeModule
        valueType.symbol => subject!.typeSymbol
    }
    subject!
}

writeEnumSubjectValue subjectIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    (context.ir[subjectIndex] -> referenceValueTypeId(context, state)) >= 0
        -> if { "%v$(subjectIndex)" -> print } else {
            subjectIndex -> writeValue(ownerIndex, context, state)
        }
}

enumMatchOwnsSubject subjectIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    subjectIndex -> aggregateValueIndex(context, state) => producerIndex
    producerIndex >= 0 and producerIndex < (context.ir -> len)
        -> unless { false -> return }
    context.ir[producerIndex] => producer
    producer -> effectiveTypeId(context, state) => producerType
    # The selected payload's trait controls its drop. An intrinsic enum can
    # lack a container-level owning trait while carrying an owned payload.
    # A reference result still borrows its subject even when produced by a call.
    producerType >= 0 and producerType < (context.types -> len)
        and context.types[producerType].kind == 8
        -> if { false -> return }
    producer.kind == 5 and producer.operand0 < 0 -> if {
        producerIndex => functionIndex!
        functionIndex! >= 0 and context.ir[functionIndex!].kind != 0
            and context.ir[functionIndex!].kind != 11
            -> while { context.ir[functionIndex!].parent => functionIndex! }
        functionIndex! >= 0 -> if {
            context -> parameterIndexForFunction(functionIndex!, producer.symbol) => parameterIndex
            parameterIndex >= 0 and context.ir[parameterIndex].flags % 2 == 1
                -> if { true -> return }
        }
    }
    producer.kind == 6
        or producer.kind == 18
        or producer.kind == 26
        or producer.kind == 27
        or producer.kind == 30
        or producer.kind == 33
        or producer.kind == 34
        or (producer.kind == 9 and producer.opcode != -1)
}

# A named enum transfers its owner when an arm transfers the owned payload.
# Pure inspection leaves the named owner responsible for scope cleanup.
enumMatchOwnsPayload matchIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.ir[matchIndex] => match
    match.operand0 -> materializedEnumSubject(context, state) => subject
    (match.operand0 -> enumMatchOwnsSubject(context, state))
        or (subject.kind == 5 and subject.operand0 >= 0
        and (context.ir[subject.operand0].kind == 17
        or context.ir[subject.operand0].kind == 29)
        and (state.frozenEnumMatchConsumed -> ownershipEmitter.enumMatchConsumes(match.operand0, subject.kind, subject.operand0)))
}
directPatternBindingValue valueIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    valueIndex -> aggregateValueIndex(context, state) => sourceIndex
    sourceIndex >= 0 and sourceIndex < (context.ir -> len)
        -> unless { -1 -> return }
    context.ir[sourceIndex] => source
    source.kind == 29 -> if { sourceIndex -> return }
    source.kind == 5 and source.operand0 >= 0
        and context.ir[source.operand0].kind == 29
        -> if { source.operand0 -> return }
    -1
}
patternBindingOwnsPayload bindingIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.ir[bindingIndex].parent => matchIndex!
    matchIndex! >= 0 and context.ir[matchIndex!].kind != 27
        and context.ir[matchIndex!].kind != 0 and context.ir[matchIndex!].kind != 11
        -> while { context.ir[matchIndex!].parent => matchIndex! }
    matchIndex! >= 0 and context.ir[matchIndex!].kind == 27
        -> if { matchIndex! -> enumMatchOwnsPayload(context, state) } else { false }
}
fixedEnumPayloadBorrows valueIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    valueIndex -> directPatternBindingValue(context, state) => patternBinding
    patternBinding >= 0 -> if {
        not (patternBinding -> patternBindingOwnsPayload(context, state)) -> return
    }
    valueIndex -> aggregateValueIndex(context, state) => sourceIndex
    context.ir[sourceIndex] => source
    source.kind == 5 and ownerIndex >= 0 -> if {
        context -> parameterIndexForFunction(ownerIndex, source.symbol) => parameterIndex
        parameterIndex >= 0 -> if {
            context.ir[parameterIndex].flags % 2 == 0 -> return
        }
    }
    false
}

enumMatchTransfersPayload matchIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.ir[matchIndex].operand1 => armIndex!
    armIndex! >= 0 -> while {
        armIndex! -> matchArmBindingValueIndex(context, state) => bindingIndex
        bindingIndex >= 0 -> if {
            context.ir[bindingIndex] => binding
            context.interpolationPayloadTransfers -> each transfer {
                transfer.bindingIr == bindingIndex -> if { true -> return }
            }
            binding.typeId >= 0 and (binding.typeId -> semanticTypeOwns(context, state))
                -> if {
                    armIndex! -> matchRegionResultValueIndex(context, state) => resultIndex
                    resultIndex >= 0 -> if {
                        resultIndex -> ownedValueSourceIndex(context, state) => resultSource
                        context.ir[resultSource] => result
                        resultSource == bindingIndex or (result.kind == 5 and result.operand0 == bindingIndex)
                            -> if { true -> return }
                    }
                    0 => moveIndex!
                    moveIndex! < (context.moves -> len) -> while {
                        context.moves[moveIndex!] => payloadMove
                        payloadMove.bindingIr == bindingIndex -> if {
                            payloadMove.memberIr < 0 -> if { true -> return }
                            # An arm can transfer an owned field while retaining
                            # siblings for its own partial-payload cleanup. The
                            # original named enum must relinquish that payload
                            # just as it does for a whole-payload transfer.
                            payloadMove.memberIr < (context.ir -> len)
                                and ((context.ir[payloadMove.memberIr] -> effectiveTypeId(context, state)) -> semanticTypeOwns(context, state))
                                -> if { true -> return }
                        }
                        moveIndex! + 1 => moveIndex!
                    }
                }
        }
        context.ir[armIndex!].nextOperand => armIndex!
    }
    false
}

# The C# emitter removes a named owning subject before emitting any arm
# when a payload transfers. Reuse the same frozen transfer decision for
# later name reads instead of permitting a second view of released storage.
consumedEnumSubjectReadDiagnostics context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int uses Console {
    [Int; ~] => reportedReads!
    0 => functionIndex!
    functionIndex! < (context.ir -> len) -> while {
        context.ir[functionIndex!] => function
        function.kind == 11 or (function.kind == 0 and state.frozenReachableFunctions[functionIndex!])
            -> if {
                functionIndex! -> functionEnd(context, state) => ownerEnd
                functionIndex! + 1 => matchIndex!
                matchIndex! < ownerEnd -> while {
                    context.ir[matchIndex!] => match
                    match.kind == 27 and match.operand0 >= 0 -> if {
                        context.ir[match.operand0] => subject
                        subject.kind == 5 and subject.operand0 >= 0
                            and state.frozenEnumMatchConsumed[match.operand0]
                            and (matchIndex! -> enumMatchTransfersPayload(context, state))
                            -> if {
                                match -> sourceStart(context, state) => consumedStart
                                matchIndex! -> terminatingControlReturns(context, state) => matchReturns
                                functionIndex! + 1 => readIndex!
                                readIndex! < ownerEnd -> while {
                                    context.ir[readIndex!] => read
                                    read.kind == 5 and read.operand0 == subject.operand0
                                        and read.sourceModule == subject.sourceModule and read.payloadToken >= 0
                                        and (read -> sourceStart(context, state)) > consumedStart
                                        and (not matchReturns or (NodeAncestorRequest { nodeIndex: readIndex!, ownerIndex: matchIndex! } -> irDescendsFrom(context, state)))
                                        -> if {
                                            false => reported!
                                            reportedReads! -> each previous { previous == readIndex! -> if { true => reported! } }
                                            not reported! -> if {
                                                context.ranges[read.sourceModule] => range
                                                context.tokens[range.tokenStart + read.payloadToken] => token
                                                context -> diagnostics.emitConsumedBindingReadDiagnostic(semanticDiagnostics.ConsumedBindingReadDiagnostic {
                                                    sourceModule: read.sourceModule
                                                    astNode: read.astNode
                                                    span: token.span
                                                })
                                                reportedReads! -> push(readIndex!)
                                            }
                                        }
                                    readIndex! + 1 => readIndex!
                                }
                            }
                    }
                    matchIndex! + 1 => matchIndex!
                }
            }
        functionIndex! + 1 => functionIndex!
    }
    reportedReads! -> len
}

sourceStart node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> UIntSize {
    context.nodes[context.ranges[node.sourceModule].astStart + node.astNode].start
}
# Capture exact interpolation payload places before frozen match ownership.
# Pattern payload candidates are retained so the final match-consumed table can
# decide the borrowed-view transfer exception without a second emitter state.
interpolationPatternTransferEligible bindingIndex: Int, functionIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    bindingIndex => subjectIndex!
    0 => hop!
    hop! < (context.ir -> len) -> while {
        context.ir[subjectIndex!] => subject
        subject.typeId >= 0 and context.types[subject.typeId].kind == 8
            -> if { false -> return }
        subject.kind == 29 -> if {
            subject.parent => matchIndex!
            matchIndex! >= 0 and context.ir[matchIndex!].kind != 27 and context.ir[matchIndex!].kind != 0 and context.ir[matchIndex!].kind != 11
                -> while { context.ir[matchIndex!].parent => matchIndex! }
            matchIndex! < 0 or context.ir[matchIndex!].kind != 27
                -> if { false -> return }
            context.ir[matchIndex!].operand0 => subjectIndex!
            subjectIndex! < 0 -> if { false -> return }
        } else {
            subject.kind == 5 -> if {
                subject.operand0 >= 0 -> if {
                    subject.operand0 => subjectIndex!
                } else {
                    context -> parameterIndexForFunction(functionIndex, subject.symbol) => parameterIndex
                    parameterIndex >= 0 and context.ir[parameterIndex].flags % 2 == 1 -> return
                }
            } else {
                subject.kind == 10 -> if { subject.flags % 2 == 1 -> return }
                # Owning lexical storage and fresh producers have a cleanup
                # obligation. References were excluded before this decision.
                (subject.kind == 17 or subject.kind == 6 or subject.kind == 18 or subject.kind == 26
                    or subject.kind == 27 or subject.kind == 30 or subject.kind == 33 or subject.kind == 34
                    or (subject.kind == 9 and subject.opcode != -1)) -> return
            }
        }
        hop! + 1 => hop!
    }
    false
}

collectEnumPayloadStoragePlaces context: ref emitterContext.EmitContext -> [ownershipCheck.EnumPayloadStoragePlace; ~] {
    [ownershipCheck.EnumPayloadStoragePlace; ~] => transfers!
    0 => constructorIndex!
    context.interpolationEnumConstructors -> each constructor {
        constructor.callNode >= 0 and constructor.argumentNode >= 0
            and constructor.enumTypeId >= 0 and constructor.expectedTypeId >= 0
            and constructor.actualTypeId == constructor.expectedTypeId
            and (context.types[constructor.expectedTypeId].kind == 4
            or context.typeTraits[constructor.expectedTypeId] % 2 == 1)
            -> if {
                constructor.argumentNode => rootNode!
                0 => fieldDepth!
                context.interpolations[rootNode!].kind == 5 and context.interpolations[rootNode!].operand0 >= 0
                    -> while {
                        fieldDepth! + 1 => fieldDepth!
                        context.interpolations[rootNode!].operand0 => rootNode!
                    }
                context.interpolations[rootNode!] => root
                root.kind == 1 and root.symbol >= 0 -> if {
                    0 => siteIndex!
                    siteIndex! < (context.ir -> len) -> while {
                        context.ir[siteIndex!] => site
                        site.kind == 2 and site.sourceModule == constructor.sourceModule
                            and site.payloadToken >= 0 and site.payloadToken < context.ranges[constructor.sourceModule].tokenCount
                            and site.payloadToken == context.interpolations[constructor.callNode].sourceToken
                            -> if {
                                site.parent => functionIndex!
                                functionIndex! >= 0 and context.ir[functionIndex!].kind != 0 and context.ir[functionIndex!].kind != 11
                                    -> while { context.ir[functionIndex!].parent => functionIndex! }
                                -1 => bindingIndex!
                                functionIndex! >= 0 -> if {
                                    context -> parameterIndexForFunction(functionIndex!, root.symbol) => bindingIndex!
                                    context.ranges[site.sourceModule] => range
                                    context.nodes[range.astStart + site.astNode].start => siteStart
                                    UIntSize(0) => bindingStart!
                                    0 => candidateIndex!
                                    candidateIndex! < (context.ir -> len) -> while {
                                        context.ir[candidateIndex!] => candidate
                                        (candidate.kind == 17 or candidate.kind == 29)
                                            and candidate.sourceModule == site.sourceModule and candidate.symbol == root.symbol
                                            and candidate.astNode >= 0 -> if {
                                                candidate.parent => candidateFunction!
                                                candidateFunction! >= 0 and context.ir[candidateFunction!].kind != 0 and context.ir[candidateFunction!].kind != 11
                                                    -> while { context.ir[candidateFunction!].parent => candidateFunction! }
                                                context.nodes[range.astStart + candidate.astNode].start => candidateStart
                                                candidateFunction! == functionIndex! and candidateStart <= siteStart
                                                    and (bindingIndex! < 0 or candidateStart > bindingStart!)
                                                    -> if {
                                                        candidateIndex! => bindingIndex!
                                                        candidateStart => bindingStart!
                                                    }
                                            }
                                        candidateIndex! + 1 => candidateIndex!
                                    }
                                }
                                bindingIndex! >= 0 -> if {
                                    site.parent => region!
                                    region! >= 0 and context.ir[region!].kind != 1 and context.ir[region!].kind != 11 and context.ir[region!].kind != 19 and context.ir[region!].kind != 20
                                        -> while { context.ir[region!].parent => region! }
                                    transfers! -> push(ownershipCheck.EnumPayloadStoragePlace {
                                        constructorIndex: constructorIndex!
                                        argumentAst: -1
                                        siteIr: siteIndex!
                                        callNode: constructor.callNode
                                        argumentNode: constructor.argumentNode
                                        bindingIr: bindingIndex!
                                        sourceModule: site.sourceModule
                                        regionIr: region!
                                        fieldDepth: fieldDepth!
                                    })
                                }
                            }
                        siteIndex! + 1 => siteIndex!
                    }
                }
            }
        constructor.callAst >= 0 and constructor.argumentAst >= 0
            and constructor.enumTypeId >= 0 and constructor.expectedTypeId >= 0
            and constructor.actualTypeId == constructor.expectedTypeId
            -> if {
                0 => siteIndex!
                siteIndex! < (context.ir -> len) -> while {
                    context.ir[siteIndex!] => site
                    site.kind == 26 and site.sourceModule == constructor.sourceModule
                        and site.astNode == constructor.callAst and site.operand0 >= 0
                        -> if {
                            context.ir -> ownershipCheck.resolvedPlaceRootBinding(site.operand0) => bindingIr!
                            site.parent => functionIr!
                            functionIr! >= 0 and context.ir[functionIr!].kind != 0 and context.ir[functionIr!].kind != 11
                                -> while { context.ir[functionIr!].parent => functionIr! }
                            bindingIr! < 0 -> if {
                                context.ir -> ownershipCheck.placeProjectionRoot(site.operand0) => rootIr
                                rootIr >= 0 and context.ir[rootIr].kind == 5 and context.ir[rootIr].operand0 < 0 and functionIr! >= 0
                                    -> if { context -> parameterIndexForFunction(functionIr!, context.ir[rootIr].symbol) => bindingIr! }
                            }
                            bindingIr! >= 0 -> if {
                                context.ir -> ownershipCheck.resolvedPlaceProjectionDepth(site.operand0) => fieldDepth
                                transfers! -> push(ownershipCheck.EnumPayloadStoragePlace {
                                    constructorIndex: constructorIndex!
                                    siteIr: siteIndex!
                                    callNode: -1
                                    argumentNode: -1
                                    argumentAst: constructor.argumentAst
                                    bindingIr: bindingIr!
                                    sourceModule: constructor.sourceModule
                                    regionIr: site.parent
                                    fieldDepth: fieldDepth
                                })
                            }
                        }
                    siteIndex! + 1 => siteIndex!
                }
            }
        constructorIndex! + 1 => constructorIndex!
    }
    transfers!
}

enumPayloadPlaceBorrows place: ownershipCheck.EnumPayloadStoragePlace, context: ref emitterContext.EmitContext -> Bool {
    context.ir[place.bindingIr] => binding
    binding.typeId >= 0 and context.types[binding.typeId].kind == 8
        -> if { true -> return }
    binding.kind == 10 -> if { binding.flags % 2 == 0 -> return }
    binding.kind == 29 -> if {
        context.ir[place.siteIr].parent => functionIndex!
        functionIndex! >= 0 and context.ir[functionIndex!].kind != 0 and context.ir[functionIndex!].kind != 11
            -> while { context.ir[functionIndex!].parent => functionIndex! }
        not (place.bindingIr -> interpolationPatternTransferEligible(functionIndex!, context)) -> return
    }
    false
}

collectInterpolationPayloadTransfers places: ref [ownershipCheck.EnumPayloadStoragePlace; ~], context: ref emitterContext.EmitContext -> [typedIr.InterpolationPayloadTransfer; ~] {
    [typedIr.InterpolationPayloadTransfer; ~] => transfers!
    places -> each place {
        place.callNode >= 0 and place.argumentNode >= 0 and not (place -> enumPayloadPlaceBorrows(context))
            -> if {
                transfers! -> push(typedIr.InterpolationPayloadTransfer {
                    siteIr: place.siteIr
                    callNode: place.callNode
                    argumentNode: place.argumentNode
                    bindingIr: place.bindingIr
                    sourceModule: place.sourceModule
                    regionIr: place.regionIr
                    fieldDepth: place.fieldDepth
                })
            }
    }
    transfers!
}

interpolationConsumedNameByNode context: ref emitterContext.EmitContext -> [Bool; ~] {
    [Bool; ~] => consumed!
    context.unresolvedInterpolationBindingByNode -> each unresolved { consumed! -> push(unresolved) }
    context.interpolationPayloadTransfers -> each transfer {
        transfer.fieldDepth == 0 -> if {
            context.interpolations[transfer.callNode] => constructor
            context.ir[transfer.bindingIr] => binding
            0 => nameIndex!
            nameIndex! < (context.interpolations -> len) -> while {
                context.interpolations[nameIndex!] => name
                name.kind == 1 and name.symbol == binding.symbol
                    and name.payloadStart >= constructor.payloadStart + constructor.payloadLength
                    -> if {
                        context.interpolationRanges[transfer.sourceModule] => range
                        nameIndex! >= range.nodeStart and nameIndex! < range.nodeStart + range.nodeCount
                            -> if {
                                0 => siteIndex!
                                siteIndex! < (context.ir -> len) -> while {
                                    context.ir[siteIndex!] => site
                                    site.kind == 2 and site.sourceModule == transfer.sourceModule
                                        and site.payloadToken >= 0 and site.payloadToken < context.ranges[transfer.sourceModule].tokenCount
                                        and site.payloadToken == name.sourceToken
                                        -> if {
                                            site.parent => region!
                                            region! >= 0 and context.ir[region!].kind != 1 and context.ir[region!].kind != 11 and context.ir[region!].kind != 19 and context.ir[region!].kind != 20
                                                -> while { context.ir[region!].parent => region! }
                                            region! == transfer.regionIr -> if { true => consumed![nameIndex!] }
                                        }
                                    siteIndex! + 1 => siteIndex!
                                }
                            }
                    }
                nameIndex! + 1 => nameIndex!
            }
        }
    }
    consumed!
}

interpolationConsumedBindingReads context: ref emitterContext.EmitContext -> [semanticDiagnostics.ConsumedBindingReadDiagnostic; ~] {
    [semanticDiagnostics.ConsumedBindingReadDiagnostic; ~] => reads!
    context.consumedBindingReads -> each read { reads! -> push(read) }
    context.interpolationPayloadTransfers -> each transfer {
        transfer.fieldDepth == 0 -> if {
            context.ir[transfer.bindingIr] => binding
            context.ranges[transfer.sourceModule] => range
            context.nodes[range.astStart + context.ir[transfer.siteIr].astNode] => siteAst
            0 => readIndex!
            readIndex! < (context.ir -> len) -> while {
                context.ir[readIndex!] => read
                read.kind == 5 and read.sourceModule == transfer.sourceModule and read.symbol == binding.symbol and read.astNode >= 0
                    -> if {
                        context.nodes[range.astStart + read.astNode] => readAst
                        read.parent => region!
                        region! >= 0 and context.ir[region!].kind != 1 and context.ir[region!].kind != 11 and context.ir[region!].kind != 19 and context.ir[region!].kind != 20
                            -> while { context.ir[region!].parent => region! }
                        region! == transfer.regionIr and readAst.start >= siteAst.start + siteAst.length
                            and readAst.payloadToken >= 0 -> if {
                                context.tokens[range.tokenStart + readAst.payloadToken].span => span
                                false => duplicate!
                                reads! -> each existingRead {
                                    existingRead.sourceModule == transfer.sourceModule and existingRead.span.start == span.start and existingRead.span.length == span.length
                                        -> if { true => duplicate! }
                                }
                                not duplicate! -> if {
                                    reads! -> push(semanticDiagnostics.ConsumedBindingReadDiagnostic {
                                        sourceModule: transfer.sourceModule, astNode: read.astNode, span: span
                                    })
                                }
                            }
                    }
                readIndex! + 1 => readIndex!
            }
        }
    }
    reads!
}

interpolationOwnedParameterCallsByNode context: ref emitterContext.EmitContext -> [Bool; ~] {
    [Bool; ~] => calls!
    0 => nodeIndex!
    nodeIndex! < (context.interpolations -> len) -> while {
        false => movesInput!
        (context.interpolations[nodeIndex!].kind == 8 or context.interpolations[nodeIndex!].kind == 10)
            and context.interpolationEnumConstructorByNode[nodeIndex!] < 0
            and context.importedInterpolationCallTargetByNode[nodeIndex!] >= 0
            -> if {
                context.ir[context.importedInterpolationCallTargetByNode[nodeIndex!]] => target
                target.operand1 >= 0 and context.ir[target.operand1].flags % 4 == 1
                    -> if { true => movesInput! }
            }
        calls! -> push(movesInput!)
        nodeIndex! + 1 => nodeIndex!
    }
    calls!
}

appendInterpolationWholePayloadMoves context: ref emitterContext.EmitContext -> [typedIr.MoveEvent; ~] {
    [typedIr.MoveEvent; ~] => moves!
    context.moves -> each existingMove { moves! -> push(existingMove) }
    context.interpolationPayloadTransfers -> each transfer {
        transfer.fieldDepth == 0 -> if {
            moves! -> push(typedIr.MoveEvent {
                siteIr: transfer.siteIr
                valueIr: transfer.bindingIr
                awaited: false
                bindingIr: transfer.bindingIr
                sourceModule: transfer.sourceModule
                symbol: context.ir[transfer.bindingIr].symbol
                regionIr: transfer.regionIr
                memberIr: -1
            })
        }
    }
    moves!
}

moveRegionFor nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.ir[nodeIndex].parent => region!
    region! >= 0 and context.ir[region!].kind != 1 and context.ir[region!].kind != 11 and context.ir[region!].kind != 19 and context.ir[region!].kind != 20
        -> while {
            context.ir[region!].parent => region!
        }
    region!
}
nodeBelongsToOwnershipRegion nodeIndex: Int, regionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.ir[nodeIndex].parent => ancestor!
    false => belongs!
    false => blocked!
    ancestor! >= 0 and not belongs! and not blocked!
        -> while {
            ancestor! == regionIndex -> if {
                true => belongs!
            } else {
                context.ir[ancestor!].kind == 19 or context.ir[ancestor!].kind == 20
                    -> if {
                        true => blocked!
                    } else {
                        context.ir[ancestor!].parent => ancestor!
                    }
            }
        }
    belongs!
}

# Return the exact move-parameter symbol whose ownership is transferred into
# one owning lexical binding. This is the shared truth for normal-return and
# early-return cleanup; copying the ABI value into a mutable slot must never
# create a second owner.
owningBindingSourceParameterSymbol bindingIndex: Int, functionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => resolved!
    bindingIndex >= 0 and bindingIndex < (context.ir -> len)
        and functionIndex >= 0 and functionIndex < (context.ir -> len)
        -> if {
            context.ir[bindingIndex] => binding
            binding.kind == 17 and binding.operand0 >= 0
                and not (binding.typeId >= 0 and (binding.typeId -> directCopyableFixedStructType(context)))
                -> if {
                    context.ir[binding.operand0] => directBindingSource
                    context -> parameterIndexForFunction(functionIndex, directBindingSource.symbol)
                        => directParameterIndex
                    directBindingSource.kind == 5 and directBindingSource.symbol >= 0
                        and directParameterIndex >= 0
                        and context.ir[directParameterIndex].flags % 2 == 1
                        -> if { directBindingSource.symbol => resolved! }
                    resolved! < 0 -> if {
                        binding.operand0 -> ownedValueSourceIndex(context, state)
                            => bindingSourceIndex
                        context.ir[bindingSourceIndex] => bindingSource
                        context -> parameterIndexForFunction(functionIndex, bindingSource.symbol)
                            => sourceParameterIndex
                        bindingSource.kind == 5 and bindingSource.symbol >= 0
                            and sourceParameterIndex >= 0
                            and context.ir[sourceParameterIndex].flags % 2 == 1
                            -> if { bindingSource.symbol => resolved! }
                    }
                }
        }
    resolved!
}

# Fixed owners cross the parameter ABI as a view of caller-owned inline storage.
# Recover the value expected by the canonical drop helper at the consuming edge.
emitWholeParameterDrop parameterIndex: Int, functionIndex: Int, edgeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[parameterIndex] => parameter
    context.types[parameter.typeId].kind == 4 => inlineArray
    inlineArray -> if {
        "  %drop_parameter$(parameterIndex)_edge$(edgeIndex)_data = extractvalue { ptr, i64 } " -> print
        context -> writeParameterReference(functionIndex, parameter.symbol) => parameterWritten
        ", 0" -> println
        "  %drop_parameter$(parameterIndex)_edge$(edgeIndex)_value = load " -> print
        parameter.typeId -> writeSemanticTypeId(context, state)
        ", ptr %drop_parameter$(parameterIndex)_edge$(edgeIndex)_data, align " -> print
        context.typeAligns[parameter.typeId] -> writeDecimalLine
    }
    "  call void @sollang_drop_t$(parameter.typeId)(" -> print
    parameter.typeId -> writeSemanticTypeId(context, state)
    " " -> print
    inlineArray -> if {
        "%drop_parameter$(parameterIndex)_edge$(edgeIndex)_value" -> print
    } else {
        context -> writeParameterReference(functionIndex, parameter.symbol) => parameterWritten
    }
    ")" -> println
}

writeCleanupValueName valueIndex: Int, parameterIndex: Int, functionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    parameterIndex >= 0 -> if {
        context -> writeParameterReference(functionIndex, context.ir[parameterIndex].symbol) => parameterWritten
    } else {
        valueIndex -> bindingFixedStorageCopyTypeId(context) => bindingCopyType
        bindingCopyType >= 0 -> if { "%v$(valueIndex)_binding_copy" -> print } else { "%v$(valueIndex)" -> print }
    }
}

# A binding dominates an early-return edge only when its lexical region is an
# ancestor of that edge and its source precedes the return. Sibling-arm moves
# must not suppress cleanup on a path that never executed them.
owningBindingTransfersParameterBeforeEdge bindingIndex: Int, functionIndex: Int, parameterSymbol: Int, edgeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => transferred!
    bindingIndex -> owningBindingSourceParameterSymbol(functionIndex, context, state)
        => bindingParameterSymbol
    bindingParameterSymbol == parameterSymbol and edgeIndex >= 0
        -> if {
            context.ir[bindingIndex] => binding
            binding.parent => bindingRegion
            edgeIndex => edgeAncestor!
            false => regionDominates!
            edgeAncestor! >= 0 and not regionDominates! -> while {
                edgeAncestor! == bindingRegion -> if {
                    true => regionDominates!
                } else {
                    context.ir[edgeAncestor!].parent => edgeAncestor!
                }
            }
            regionDominates!
                and (binding -> sourceStart(context, state)) < (context.ir[edgeIndex] -> sourceStart(context, state))
                -> if { true => transferred! }
        }
    transferred!
}
# Final call parameter flags are authoritative even when the earlier semantic
# move snapshot did not yet resolve the target. Only a preceding call in an
# ancestor lexical region can transfer an owner on this return path.
resolvedCallTransfersParameterBeforeEdge callIndex: Int, parameterIndex: Int, edgeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => transferred!
    context.ir[callIndex] => call
    call.parent => callRegion!
    callRegion! >= 0 and context.ir[callRegion!].kind == 17
        -> while {
            context.ir[callRegion!].parent => callRegion!
        }
    call.kind == 6 and call.targetModule >= 0 and call.symbol >= 0
        and callRegion! >= 0
        and (context.ir[callRegion!].kind == 1 or context.ir[callRegion!].kind == 19)
        and (call -> sourceStart(context, state)) < (context.ir[edgeIndex] -> sourceStart(context, state))
        -> if {
            edgeIndex => ancestor!
            false => dominates!
            ancestor! >= 0 and not dominates! -> while {
                ancestor! == callRegion! -> if {
                    true => dominates!
                } else { context.ir[ancestor!].parent => ancestor! }
            }
            dominates! -> if {
                context.ir[parameterIndex] => parameter
                call.operand0 => argumentIndex!
                0 => ordinal!
                0 => steps!
                argumentIndex! >= 0 and argumentIndex! < (context.ir -> len)
                    and steps! < (context.ir -> len) and not transferred!
                    -> while {
                        callIndex -> callTargetParameter(ordinal!, context, state) => targetParameter
                        targetParameter >= 0 and context.ir[targetParameter].flags % 2 == 1
                            -> if {
                                argumentIndex! -> ownedValueSourceIndex(context, state) => sourceIndex
                                sourceIndex >= 0 and sourceIndex < (context.ir -> len)
                                    -> if {
                                        context.ir[sourceIndex] => source
                                        source.kind == 5 and source.sourceModule == parameter.sourceModule
                                            and source.symbol == parameter.symbol
                                            -> if { true => transferred! }
                                    }
                            }
                        context.ir[argumentIndex!].nextOperand => argumentIndex!
                        ordinal! + 1 => ordinal!
                        steps! + 1 => steps!
                    }
            }
        }
    transferred!
}
matchArmBindingValueIndex armIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => resolved!
    armIndex >= 0 and armIndex < (context.ir -> len)
        -> if {
            armIndex => ownerIndex!
            ownerIndex! >= 0 and context.ir[ownerIndex!].kind != 0 and context.ir[ownerIndex!].kind != 11
                -> while { context.ir[ownerIndex!].parent => ownerIndex! }
            ownerIndex! >= 0 -> if {
                ownerIndex! -> functionEnd(context, state) => ownerEnd
                ownerIndex! + 1 => bindingSearch!
                bindingSearch! < ownerEnd and resolved! < 0 -> while {
                    context.ir[bindingSearch!] => bindingCandidate
                    bindingCandidate.parent => bindingParent!
                    false => bindingArmFound!
                    bindingParent! >= 0 and not bindingArmFound!
                        -> while {
                            context.ir[bindingParent!] => bindingAncestor
                            bindingAncestor.kind == 19
                                and bindingAncestor.parent >= 0
                                and context.ir[bindingAncestor.parent].kind == 27
                                -> if {
                                    true => bindingArmFound!
                                } else {
                                    bindingAncestor.kind == 0 or bindingAncestor.kind == 11
                                        -> if {
                                            -1 => bindingParent!
                                            true => bindingArmFound!
                                        } else {
                                            bindingAncestor.parent => bindingParent!
                                        }
                                }
                        }
                    bindingCandidate.kind == 29
                        and bindingParent! == armIndex
                        -> if { bindingSearch! => resolved! }
                    bindingSearch! + 1 => bindingSearch!
                }
            }
        }
    resolved!
}
regionFullyMovesBinding regionIndex: Int, sourceModule: Int, symbol: Int, afterStart: UIntSize, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    regionIndex -> regionFullyMovesPlace(sourceModule, symbol, -1, afterStart, -1, -1, context, state)
}

# Compare canonical field identities from the leaf back to the shared owner.
# Indexed projections cannot establish the same owned struct field path.
sameMovedFieldPath leftIndex: Int, rightIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    leftIndex => left!
    rightIndex => right!
    true => same!
    same! and left! >= 0 and right! >= 0
        and context.ir[left!].kind == 13 and context.ir[right!].kind == 13
        -> while {
            context.ir[left!] => leftField
            context.ir[right!] => rightField
            leftField.symbol < 0 or rightField.symbol < 0
                or leftField.symbol != rightField.symbol
                or leftField.targetModule != rightField.targetModule
                -> if { false => same! }
            leftField.operand0 => left!
            rightField.operand0 => right!
        }
    same! and left! >= 0 and right! >= 0
        and context.ir[left!].kind == 5 and context.ir[right!].kind == 5
}

regionFullyMovesPlace regionIndex: Int, sourceModule: Int, symbol: Int, memberIndex: Int, afterStart: UIntSize, beforeAst: Int, edgeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    regionIndex >= 0 and regionIndex < (context.ir -> len)
        -> unless { false -> return }
    # A terminating control region has already discharged its cleanup and
    # contributes no ownership obligation to the caller's continuing merge.
    # Function owners have parent -1 and are scopes, not control regions.
    context.ir[regionIndex] => region
    region.kind != 0 and region.kind != 11
        and (edgeIndex < 0 or not (regionIndex -> ownershipRegionContainsEdge(edgeIndex, context, state)))
        -> if {
            regionIndex -> regionReturns(context, state)
                -> if { true -> return }
        }
    # Ownership queries inspect one function's lexical controls. Reuse the
    # canonical contiguous function boundary; unrelated functions cannot
    # transfer this region's cleanup obligation.
    regionIndex => functionOwner!
    functionOwner! >= 0 and context.ir[functionOwner!].kind != 0 and context.ir[functionOwner!].kind != 11
        -> while { context.ir[functionOwner!].parent => functionOwner! }
    functionOwner! >= 0 -> unless { false -> return }
    functionOwner! -> functionEnd(context, state) => ownerEnd
    # A field repaired in this continuing region owns its replacement again.
    # Ignore earlier transfers; a later transfer must independently prove all
    # live arms. This keeps the whole-binding query's original cutoff intact.
    afterStart => effectiveAfterStart!
    memberIndex >= 0 -> if {
        functionOwner! => repairIndex!
        repairIndex! < ownerEnd -> while {
            context.ir[repairIndex!] => repair
            repair.kind == 25 and repair.sourceModule == sourceModule
                and repair.symbol == symbol
                and (repairIndex! -> moveRegionFor(context, state)) == regionIndex
                and (repair -> sourceStart(context, state)) > effectiveAfterStart!
                -> if {
                    true => repairBeforeEdge!
                    edgeIndex >= 0 -> if {
                        (repair -> sourceStart(context, state)) >= (context.ir[edgeIndex] -> sourceStart(context, state))
                            -> if { false => repairBeforeEdge! }
                    }
                    0 => repairMoveIndex!
                    false => matchingRepair!
                    repairBeforeEdge! and repairMoveIndex! < (context.moves -> len) and not matchingRepair!
                        -> while {
                            context.moves[repairMoveIndex!] => repairMove
                            repairMove.memberIr >= 0 and repairMove.sourceModule == sourceModule
                                and repairMove.symbol == symbol
                                and (memberIndex -> sameMovedFieldPath(repairMove.memberIr, context))
                                and (repairMoveIndex! -> memberMoveMatchesAssignment(repairIndex!, context, state))
                                -> if { true => matchingRepair! }
                            repairMoveIndex! + 1 => repairMoveIndex!
                        }
                    matchingRepair! -> if {
                        repair -> sourceStart(context, state) => effectiveAfterStart!
                    }
                }
            repairIndex! + 1 => repairIndex!
        }
    }
    false => moved!
    0 => moveIndex!
    moveIndex! < (context.moves -> len) and not moved!
        -> while {
            context.moves[moveIndex!] => candidateMove
            # Reject foreign places before interpreting this edge's module-local
            # AST index in a candidate move's source module.
            candidateMove.regionIr == regionIndex
                and candidateMove.sourceModule == sourceModule
                and candidateMove.symbol == symbol
                and ((memberIndex < 0 and candidateMove.memberIr < 0)
                or (memberIndex >= 0 and candidateMove.memberIr >= 0
                and (memberIndex -> sameMovedFieldPath(candidateMove.memberIr, context))
                and (moveIndex! -> partialMoveActiveBefore(candidateMove.regionIr, beforeAst, context, state))))
                and (context.ir[candidateMove.siteIr] -> sourceStart(context, state)) > effectiveAfterStart!
                -> if {
                    true => moved!
                }
            moveIndex! + 1 => moveIndex!
        }
    # Reuse the frozen parent edges instead of rescanning foreign branches for
    # every region. Arm and loop barriers retain the ancestor query's boundary.
    state.frozenFirstIrChildByParent[regionIndex] => controlIndex!
    controlIndex! >= functionOwner! and controlIndex! < ownerEnd and not moved!
        -> while {
            context.ir[controlIndex!] => control
            # Only these complete selection shapes can move a place on every arm.
            (control.kind == 18 and control.nextOperand >= 0)
                or (control.kind == 27 and control.operand1 >= 0)
                or (control.kind == 33 and control.operand0 >= 0)
                or (control.kind == 34 and control.operand1 >= 0)
                -> if {
                    control -> sourceNode(context, state) => controlAst
                    true => controlBeforeEdge!
                    edgeIndex >= 0 -> if {
                        controlAst.start + controlAst.length > (context.ir[edgeIndex] -> sourceStart(context, state))
                            -> if { false => controlBeforeEdge! }
                    }
                    controlBeforeEdge! and (controlIndex! -> nodeBelongsToOwnershipRegion(regionIndex, context, state))
                        -> if {
                            control.kind == 18 and control.nextOperand >= 0 and (control -> sourceStart(context, state)) > effectiveAfterStart!
                                -> if {
                                    control.operand1 -> regionFullyMovesPlace(sourceModule, symbol, memberIndex, effectiveAfterStart!, beforeAst, edgeIndex, context, state) => thenMoves
                                    control.nextOperand -> regionFullyMovesPlace(sourceModule, symbol, memberIndex, effectiveAfterStart!, beforeAst, edgeIndex, context, state) => elseMoves
                                    thenMoves and elseMoves -> if { true => moved! }
                                }
                            control.kind == 27 and control.operand1 >= 0 and (control -> sourceStart(context, state)) > effectiveAfterStart!
                                -> if {
                                    true => allArmsMove!
                                    false => hasArm!
                                    control.operand1 => armIndex!
                                    armIndex! >= 0 -> while {
                                        true => hasArm!
                                        armIndex! -> enumMatchArmRegion(context, state) => armRegion
                                        armRegion -> regionFullyMovesPlace(sourceModule, symbol, memberIndex, effectiveAfterStart!, beforeAst, edgeIndex, context, state)
                                            -> unless {
                                                false => allArmsMove!
                                            }
                                        context.ir[armIndex!].nextOperand => armIndex!
                                    }
                                    hasArm! and allArmsMove! -> if { true => moved! }
                                }
                            control.kind == 33 and control.operand0 >= 0 and (control -> sourceStart(context, state)) > effectiveAfterStart!
                                -> if {
                                    true => allWhenArmsMove!
                                    false => hasWhenArm!
                                    false => hasWhenElse!
                                    control.operand0 => whenArmIndex!
                                    true => whenArmOpen!
                                    whenArmIndex! >= 0 and whenArmOpen! -> while {
                                        context.ir[whenArmIndex!] => whenArm
                                        whenArm.kind != 19 or whenArm.parent != controlIndex!
                                            -> if {
                                                false => allWhenArmsMove!
                                                false => whenArmOpen!
                                            } else {
                                                true => hasWhenArm!
                                                (whenArm.operand0 >= 0 and whenArm.operand1 >= 0 and whenArm.operand0 != whenArm.operand1 and context.ir[whenArm.operand0].kind != 19) => conditionalWhenArm
                                                conditionalWhenArm -> if {
                                                    whenArm.operand1 -> regionFullyMovesPlace(sourceModule, symbol, memberIndex, effectiveAfterStart!, beforeAst, edgeIndex, context, state)
                                                        -> unless {
                                                            false => allWhenArmsMove!
                                                        }
                                                    whenArm.nextOperand => whenArmIndex!
                                                } else {
                                                    true => hasWhenElse!
                                                    whenArm.operand1 >= 0 -> if {
                                                        whenArm.operand1 -> regionFullyMovesPlace(sourceModule, symbol, memberIndex, effectiveAfterStart!, beforeAst, edgeIndex, context, state)
                                                            -> unless {
                                                                false => allWhenArmsMove!
                                                            }
                                                    } else {
                                                        whenArm.operand0 -> regionFullyMovesPlace(sourceModule, symbol, memberIndex, effectiveAfterStart!, beforeAst, edgeIndex, context, state)
                                                            -> unless {
                                                                false => allWhenArmsMove!
                                                            }
                                                    }
                                                    false => whenArmOpen!
                                                }
                                            }
                                    }
                                    hasWhenArm! and hasWhenElse! and allWhenArmsMove!
                                        -> if { true => moved! }
                                }
                            control.kind == 34 and control.operand1 >= 0 and (control -> sourceStart(context, state)) > effectiveAfterStart!
                                -> if {
                                    true => allSubjectWhenArmsMove!
                                    false => hasSubjectWhenArm!
                                    false => hasSubjectWhenElse!
                                    control.operand1 => subjectWhenArmIndex!
                                    true => subjectWhenArmOpen!
                                    subjectWhenArmIndex! >= 0 and subjectWhenArmOpen!
                                        -> while {
                                            context.ir[subjectWhenArmIndex!] => subjectWhenArm
                                            subjectWhenArm.kind != 19 or subjectWhenArm.parent != controlIndex!
                                                -> if {
                                                    false => allSubjectWhenArmsMove!
                                                    false => subjectWhenArmOpen!
                                                } else {
                                                    true => hasSubjectWhenArm!
                                                    subjectWhenArm -> sourceNode(context, state) => subjectWhenArmSource
                                                    subjectWhenArmSource.kind == 58 => conditionalSubjectWhenArm
                                                    conditionalSubjectWhenArm -> if {
                                                        subjectWhenArm.operand1 -> regionFullyMovesPlace(sourceModule, symbol, memberIndex, effectiveAfterStart!, beforeAst, edgeIndex, context, state)
                                                            -> unless {
                                                                false => allSubjectWhenArmsMove!
                                                            }
                                                        subjectWhenArm.nextOperand => subjectWhenArmIndex!
                                                    } else {
                                                        true => hasSubjectWhenElse!
                                                        subjectWhenArmIndex! -> regionFullyMovesPlace(sourceModule, symbol, memberIndex, effectiveAfterStart!, beforeAst, edgeIndex, context, state)
                                                            -> unless {
                                                                false => allSubjectWhenArmsMove!
                                                            }
                                                        false => subjectWhenArmOpen!
                                                    }
                                                }
                                        }
                                    hasSubjectWhenArm! and hasSubjectWhenElse! and allSubjectWhenArmsMove!
                                        -> if { true => moved! }
                                }
                        }
                }
            -1 => nextControlIndex!
            control.kind != 19 and control.kind != 20 -> if {
                state.frozenFirstIrChildByParent[controlIndex!] => nextControlIndex!
            }
            nextControlIndex! < 0 -> if {
                controlIndex! => completedControlIndex!
                completedControlIndex! >= 0 and completedControlIndex! != regionIndex
                    and nextControlIndex! < 0 -> while {
                        state.frozenNextIrSiblingByNode[completedControlIndex!] => nextControlIndex!
                        nextControlIndex! < 0 -> if {
                            context.ir[completedControlIndex!].parent => completedControlIndex!
                        }
                    }
            }
            nextControlIndex! => controlIndex!
        }
    moved!
}

# Match the constructor emitter's canonical field ordinal and source form.
# A copied field creates new backing and retains its named source owner.
aggregateFieldCopiesFixedStorage aggregateIndex: Int, valueIndex: Int, fieldOrdinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    aggregateIndex >= 0 and aggregateIndex < (context.ir -> len)
        and valueIndex >= 0 and valueIndex < (context.ir -> len) and fieldOrdinal >= 0
        -> unless { false -> return }
    context.ir[aggregateIndex] => aggregate
    aggregate.kind == 12 or aggregate.kind == 35
        -> unless { false -> return }
    valueIndex -> aggregateValueIndex(context, state) => sourceIndex
    context.ir[sourceIndex].kind == 5 or (sourceIndex -> namedStructFieldProjection(context))
        -> unless { false -> return }
    aggregate.typeId => ownerTypeId!
    ownerTypeId! < 0 -> if {
        0 => ownerSearch!
        ownerSearch! < (context.types -> len) -> while {
            context.types[ownerSearch!] => candidate
            candidate.status == 0 and candidate.kind == 1
                and candidate.origin == aggregate.typeOrigin
                and candidate.module == aggregate.typeModule
                and candidate.symbol == aggregate.typeSymbol
                -> if { ownerSearch! => ownerTypeId! }
            ownerSearch! + 1 => ownerSearch!
        }
    }
    ownerTypeId! >= 0 and ownerTypeId! < (context.types -> len)
        -> unless { false -> return }
    ownerTypeId! -> canonicalMemberFieldOrdinalIndex(fieldOrdinal, context) => fieldIndex
    fieldIndex >= 0 -> unless { false -> return }
    context.fields[fieldIndex].fieldType => targetTypeId
    targetTypeId >= 0 and targetTypeId < (context.types -> len)
        -> unless { false -> return }
    targetTypeId -> directCopyableFixedStructType(context)
        -> if { true -> return }
    context.types[targetTypeId] => targetType
    targetType.kind == 4 and targetType.first >= 0
        and targetType.first < (context.typeTraits -> len)
        and context.typeTraits[targetType.first] % 2 == 0
}

# A return can transfer an owning local through several value-only aggregate
# constructors (for example Array -> struct -> Result.Ok). Follow only that
# returned value graph so cleanup on an early-return edge neither frees the
# transferred storage nor mistakes another branch's aggregate for this move.
returnedValueTransferredBindingRoots valueIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> [Int; ~] {
    [valueIndex,; ~] => pending!
    [Int; ~] => roots!
    0 => pendingIndex!
    pendingIndex! < (pending! -> len)
        -> while {
            pending![pendingIndex!] => candidateIndex
            pendingIndex! + 1 => pendingIndex!
            candidateIndex >= 0 and candidateIndex < (context.ir -> len)
                -> if {
                    context.ir[candidateIndex] => candidate
                    candidate.kind == 5 and candidate.operand0 >= 0
                        -> if {
                            candidate.operand0 -> mutableBindingRoot(context, state) => candidateRoot
                            roots! -> push(candidateRoot)
                        }
                    candidate.kind == 17 -> if {
                        candidateIndex -> mutableBindingRoot(context, state) => candidateRoot
                        roots! -> push(candidateRoot)
                    }
                    (candidate.kind == 26 or candidate.kind == 36 or candidate.kind == 43)
                        and candidate.operand0 >= 0
                        -> if {
                            pending! -> push(candidate.operand0)
                        }
                    (candidate.kind == 12 or candidate.kind == 14 or candidate.kind == 16 or candidate.kind == 35)
                        and candidate.operand0 >= 0
                        -> if {
                            candidate.operand0 => operandIndex!
                            0 => operandCount!
                            operandIndex! >= 0
                                and operandIndex! < (context.ir -> len)
                                and operandCount! < (context.ir -> len)
                                -> while {
                                    candidateIndex -> aggregateFieldCopiesFixedStorage(operandIndex!, operandCount!, context, state)
                                        -> unless { pending! -> push(operandIndex!) }
                                    context.ir[operandIndex!].nextOperand => operandIndex!
                                    operandCount! + 1 => operandCount!
                                }
                        }
                }
        }
    roots!
}

# An explicit early return can forward the result of a consuming call directly.
# The returned symbol then belongs to the call result, not to the move parameter,
# so symbol comparison alone must not schedule a second cleanup of that parameter.
returnedValueConsumesMoveParameter valueIndex: Int, parameterIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => consumed!
    valueIndex >= 0 and valueIndex < (context.ir -> len)
        and parameterIndex >= 0 and parameterIndex < (context.ir -> len)
        -> if {
            context.ir[parameterIndex] => parameter
            0 => moveIndex!
            moveIndex! < (context.moves -> len) and not consumed!
                -> while {
                    context.moves[moveIndex!] => moveEvent
                    moveEvent.siteIr == valueIndex
                        and moveEvent.memberIr < 0
                        and moveEvent.sourceModule == parameter.sourceModule
                        and moveEvent.symbol == parameter.symbol
                        -> if { true => consumed! }
                    moveIndex! + 1 => moveIndex!
                }
        }
    consumed!
}

# A move parameter transferred only inside a nested control region needs a
# runtime liveness bit. A function-wide "moved" decision is not sufficient:
# one match arm can return the transferred owner while a sibling error arm
# still has to drop the original parameter exactly once.
moveParameterNeedsPathOwnershipFlag parameterIndex: Int, functionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => needed!
    parameterIndex >= 0 and parameterIndex < (context.ir -> len)
        and functionIndex >= 0 and functionIndex < (context.ir -> len)
        -> if {
            context.ir[parameterIndex] => parameter
            context.ir[functionIndex] => function
            parameter.kind == 10
                and parameter.flags % 2 == 1
                and parameter.typeId >= 0
                and (parameter.typeId -> semanticTypeOwns(context, state))
                and (context -> parameterIndexForFunction(functionIndex, parameter.symbol)) == parameterIndex
                -> if {
                    0 => moveIndex!
                    moveIndex! < (context.moves -> len) and not needed!
                        -> while {
                            context.moves[moveIndex!] => candidateMove
                            false => aggregateFieldTransfer!
                            candidateMove.memberIr >= 0 -> if {
                                context.ir[candidateMove.siteIr].parent => aggregateAncestor!
                                aggregateAncestor! >= 0
                                    and aggregateAncestor! != candidateMove.regionIr
                                    and not aggregateFieldTransfer!
                                    -> while {
                                        context.ir[aggregateAncestor!] => aggregateCandidate
                                        aggregateCandidate.kind == 12
                                            or aggregateCandidate.kind == 14
                                            or aggregateCandidate.kind == 16
                                            or aggregateCandidate.kind == 26
                                            or aggregateCandidate.kind == 35
                                            -> if { true => aggregateFieldTransfer! }
                                        aggregateCandidate.parent => aggregateAncestor!
                                    }
                            }
                            ((candidateMove.memberIr < 0
                                and (candidateMove.bindingIr == parameterIndex
                                or (context -> parameterIndexForFunction(functionIndex, candidateMove.symbol)) == parameterIndex))
                                or aggregateFieldTransfer!)
                                and candidateMove.sourceModule == parameter.sourceModule
                                and candidateMove.symbol == parameter.symbol
                                and candidateMove.regionIr != function.operand0
                                -> if { true => needed! }
                            moveIndex! + 1 => moveIndex!
                        }
                }
        }
    needed!
}
memberMoveMatchesAssignment moveIndex: Int, assignmentIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.moves[moveIndex] => candidateMove
    context.ir[assignmentIndex] => candidateAssignment
    false => matches!
    candidateMove.memberIr >= 0 and candidateAssignment.kind == 25 and candidateAssignment.sourceModule == candidateMove.sourceModule and candidateAssignment.symbol == candidateMove.symbol
        -> if {
            context.ir[candidateMove.memberIr] => candidateMember
            candidateMember -> sourceNode(context, state) => candidateMemberAst
            candidateAssignment -> sourceNode(context, state) => candidateAssignmentAst
            -1 => movedFieldToken!
            0 => movedIdentifierCount!
            candidateMemberAst.firstToken => movedTokenIndex!
            movedTokenIndex! < candidateMemberAst.firstToken + candidateMemberAst.tokenCount
                -> while {
                    context.tokens[context.ranges[candidateMember.sourceModule].tokenStart + movedTokenIndex!].kind == grammar.tokenIdIdentifier()
                        -> if {
                            movedTokenIndex! => movedFieldToken!
                            movedIdentifierCount! + 1 => movedIdentifierCount!
                        }
                    movedTokenIndex! + 1 => movedTokenIndex!
                }
            movedIdentifierCount! == 2 and movedFieldToken! >= 0 and candidateAssignmentAst.secondaryToken >= 0
                -> if {
                    context.tokens[context.ranges[candidateMember.sourceModule].tokenStart + movedFieldToken!] => movedField
                    context.tokens[context.ranges[candidateAssignment.sourceModule].tokenStart + candidateAssignmentAst.secondaryToken] => assignedField
                    movedField.span.length == assignedField.span.length => matches!
                    UIntSize(0) => fieldByte!
                    matches! and fieldByte! < movedField.span.length
                        -> while {
                            (context.sources[candidateMember.sourceModule] -> byte(movedField.span.start + fieldByte!)) != (context.sources[candidateAssignment.sourceModule] -> byte(assignedField.span.start + fieldByte!))
                                -> if { false => matches! }
                            fieldByte! + 1 => fieldByte!
                        }
                }
        }
    matches!
}
partialMoveActiveBefore moveIndex: Int, regionIndex: Int, beforeAst: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.moves[moveIndex] => candidateMove
    false => active!
    beforeAst >= 0 => boundedEdge
    candidateMove.memberIr >= 0 -> if {
        candidateMove.regionIr == regionIndex => active!
        context.ir[candidateMove.siteIr] => moveSite
        UIntSize(0) => edgeEnd!
        beforeAst >= 0 -> if {
            context.nodes[context.ranges[moveSite.sourceModule].astStart + beforeAst] => edgeAst
            edgeAst.start + edgeAst.length => edgeEnd!
        }
        active! and boundedEdge and (moveSite -> sourceStart(context, state)) >= edgeEnd!
            -> if { false => active! }
        candidateMove.regionIr => assignmentOwner!
        assignmentOwner! >= 0 and context.ir[assignmentOwner!].kind != 0 and context.ir[assignmentOwner!].kind != 11
            -> while {
                context.ir[assignmentOwner!].parent => assignmentOwner!
            }
        0 => assignmentSearch!
        0 => assignmentEnd!
        assignmentOwner! >= 0 -> if {
            assignmentOwner! + 1 => assignmentSearch!
            assignmentOwner! -> functionEnd(context, state) => assignmentEnd!
        }
        assignmentSearch! < assignmentEnd! -> while {
            active! -> if {
                context.ir[assignmentSearch!] => reinitialization
                assignmentSearch! -> moveRegionFor(context, state) => reinitializationRegion
                moveSite -> sourceStart(context, state) => moveSiteStart
                reinitialization -> sourceStart(context, state) => reinitializationStart
                true => reinitializationBeforeEdge!
                boundedEdge -> if { reinitializationStart < edgeEnd! => reinitializationBeforeEdge! }
                reinitialization.kind == 25 and reinitializationRegion == candidateMove.regionIr and moveSiteStart < reinitializationStart and reinitializationBeforeEdge!
                    -> if {
                        moveIndex -> memberMoveMatchesAssignment(assignmentSearch!, context, state)
                            -> if { false => active! }
                    }
            }
            assignmentSearch! + 1 => assignmentSearch!
        }
    }
    active!
}

# A repairing field assignment observes ownership immediately before its own
# store. The generic edge query uses the complete AST span and therefore sees
# that same assignment as already completed, which would drop storage that was
# just transferred out of the field. Exclude only the current assignment while
# retaining every earlier matching repair in the same ownership region.
partialMoveActiveAtAssignment moveIndex: Int, assignmentIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.moves[moveIndex] => candidateMove
    candidateMove.regionIr == (assignmentIndex -> moveRegionFor(context, state)) => active!
    candidateMove.memberIr >= 0 and active! -> if {
        context.ir[candidateMove.siteIr] -> sourceStart(context, state) => moveStart
        context.ir[assignmentIndex] -> sourceStart(context, state) => assignmentStart
        candidateMove.regionIr => owner!
        owner! >= 0 and context.ir[owner!].kind != 0 and context.ir[owner!].kind != 11
            -> while { context.ir[owner!].parent => owner! }
        0 => search!
        0 => end!
        owner! >= 0 -> if {
            owner! + 1 => search!
            owner! -> functionEnd(context, state) => end!
        }
        search! < end! and active! -> while {
            context.ir[search!] => earlierAssignment
            earlierAssignment.kind == 25
                and search! != assignmentIndex
                and (search! -> moveRegionFor(context, state)) == candidateMove.regionIr
                and (earlierAssignment -> sourceStart(context, state)) > moveStart
                and (earlierAssignment -> sourceStart(context, state)) < assignmentStart
                and (moveIndex -> memberMoveMatchesAssignment(search!, context, state))
                -> if { false => active! }
            search! + 1 => search!
        }
    }
    active!
}
sourceInterpolations node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> [interpolation.InterpolationNode; ~] {
    context.interpolationRanges[node.sourceModule] => interpolationRange
    [interpolation.InterpolationNode; ~] => sourceNodes!
    0 => interpolationIndex!
    interpolationIndex! < interpolationRange.nodeCount
        -> while {
            context.interpolations[interpolationRange.nodeStart + interpolationIndex!] => interpolationNode!
            interpolationNode!.parent >= 0 -> if { interpolationNode!.parent - interpolationRange.nodeStart => interpolationNode!.parent }
            interpolationNode!.operand0 >= 0 -> if { interpolationNode!.operand0 - interpolationRange.nodeStart => interpolationNode!.operand0 }
            interpolationNode!.operand1 >= 0 -> if { interpolationNode!.operand1 - interpolationRange.nodeStart => interpolationNode!.operand1 }
            interpolationNode!.operand2 >= 0 -> if { interpolationNode!.operand2 - interpolationRange.nodeStart => interpolationNode!.operand2 }
            sourceNodes! -> push(interpolationNode!)
            interpolationIndex! + 1 => interpolationIndex!
        }
    sourceNodes!
}
emitDropValueName request: DropGlueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    request.valueKind == 0 -> if {
        request.valueIndex -> bindingFixedStorageCopyTypeId(context) => bindingCopyType
        bindingCopyType >= 0 -> if {
            "%v$(request.valueIndex)_binding_copy" -> print
        } else { "%v$(request.valueIndex)" -> print }
    } else {
        request.valueKind == 1 -> if {
            context.ir[request.regionIndex].parent => dropParameterOwner!
            dropParameterOwner! >= 0 and context.ir[dropParameterOwner!].kind != 0 and context.ir[dropParameterOwner!].kind != 11
                -> while {
                    context.ir[dropParameterOwner!].parent => dropParameterOwner!
                }
            context -> writeParameterReference(dropParameterOwner!, context.ir[request.bindingIndex].symbol) => dropParameterWritten
        } else {
            request.valueKind == 3 -> if {
                request.regionIndex => dropParameterOwner!
                dropParameterOwner! >= 0 and context.ir[dropParameterOwner!].kind != 0 and context.ir[dropParameterOwner!].kind != 11
                    -> while {
                        context.ir[dropParameterOwner!].parent => dropParameterOwner!
                    }
                context -> writeParameterReference(dropParameterOwner!, context.ir[request.valueIndex].symbol) => dropParameterWritten
            } else { "%dropg$(request.nameRoot)_p$(request.pathCode)" -> print }
        }
    }
}
emitDropPathName request: DropGlueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    "%dropg$(request.nameRoot)_p$(request.pathCode)" -> print
}
# Fixed-array calls return promoted heap backing even when their elements are
# copyable. A direct binding owns that backing independently of the
# element drop trait; aliases, stack literals and reference results do not.
fixedResultPropagationValue valueIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    valueIndex >= 0 and valueIndex < (context.ir -> len)
        -> unless { false -> return }
    context.ir[valueIndex] => value
    value -> sourceNode(context, state) => valueSource
    value.kind == 30 and value.typeId >= 0
        and value.typeId < (context.types -> len)
        and context.types[value.typeId].kind == 4
        and valueSource.kind == 82
}
fixedResultPropagationBinding bindingIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    bindingIndex >= 0 and bindingIndex < (context.ir -> len)
        -> unless { false -> return }
    context.ir[bindingIndex] => binding
    binding.kind == 17 and binding.operand0 >= 0
        and binding.typeId >= 0 and binding.typeId < (context.types -> len)
        and context.types[binding.typeId].kind == 4
        and ((binding.operand0 -> fixedResultPropagationValue(context, state))
        or (binding.operand0 -> callResultPropagationBindingIndex(context, state)) == bindingIndex)
}
anonymousProjectionOwnerIndex valueIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    valueIndex -> aggregateValueIndex(context, state) => projectionIndex!
    projectionIndex! >= 0 and projectionIndex! < (context.ir -> len)
        -> unless { -1 -> return }
    context.ir[projectionIndex!].kind == 13 -> unless { -1 -> return }
    projectionIndex! >= 0 and projectionIndex! < (context.ir -> len)
        and context.ir[projectionIndex!].kind == 13
        -> while {
            context.ir[projectionIndex!].operand0 -> aggregateValueIndex(context, state) => projectionIndex!
        }
    projectionIndex! >= 0 and projectionIndex! < (context.ir -> len)
        -> unless { -1 -> return }
    context.ir[projectionIndex!] => producer
    producer.kind == 6 or producer.kind == 12 or producer.kind == 35
        -> unless { -1 -> return }
    producer.kind == 6
        and ((producer -> targetsNativeFunction(context, state))
        or not (projectionIndex! -> callHasResolvedFunctionTarget(context, state)))
        -> if { -1 -> return }
    producer.typeId >= 0 and producer.typeId < (context.types -> len)
        and (producer.typeId -> semanticTypeOwns(context, state))
        -> unless { -1 -> return }
    projectionIndex!
}
singleFixedFieldTemporaryValue valueIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    valueIndex -> anonymousProjectionOwnerIndex(context, state) => ownerIndex
    ownerIndex < 0 -> if { false -> return }
    context.ir[valueIndex] => value
    value.typeId >= 0 and context.types[value.typeId].kind == 4
        -> unless { false -> return }
    context.ir[ownerIndex].typeId => ownerTypeId
    0 => fieldCount!
    false => matchingField!
    context.fields -> each field {
        field.status == 0 and field.ownerType == ownerTypeId
            -> if {
                fieldCount! + 1 => fieldCount!
                field.fieldType == value.typeId -> if { true => matchingField! }
            }
    }
    fieldCount! == 1 and matchingField!
}
promotedFixedArrayCall valueIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    valueIndex -> bindingFixedStorageCopyTypeId(context) => bindingCopyType
    bindingCopyType >= 0 and context.types[bindingCopyType].kind == 4
        -> if { valueIndex -> return }
    -1 => result!
    valueIndex >= 0 and valueIndex < (context.ir -> len)
        -> if {
            valueIndex -> aggregateValueIndex(context, state) => sourceIndex
            context.ir[sourceIndex] => source
            source.typeId >= 0 and source.typeId < (context.types -> len)
                and context.types[source.typeId].kind == 4
                and ((source.kind == 6
                and not (source -> targetsNativeFunction(context, state))
                and (sourceIndex -> callHasResolvedFunctionTarget(context, state)))
                or (source.kind == 18 and source.nextOperand >= 0)
                or (sourceIndex -> fixedResultPropagationValue(context, state))
                or (sourceIndex -> singleFixedFieldTemporaryValue(context, state))
                or (sourceIndex -> fixedResultPropagationBinding(context, state)))
                -> if { sourceIndex => result! }
        }
    result!
}
bindingPromotedFixedArrayCall bindingIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => result!
    context.ir[bindingIndex] => binding
    binding.kind == 17 and binding.operand0 >= 0
        -> if {
            binding.operand0 -> promotedFixedArrayCall(context, state) => result!
            result! < 0 and (bindingIndex -> fixedResultPropagationBinding(context, state))
                -> if { bindingIndex => result! }
        }
    result!
}
fixedBranchTransferredBacking valueIndex: Int, regionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => transferred!
    valueIndex -> ownedValueSourceIndex(context, state) => source
    source -> promotedFixedArrayCall(context, state) => backing
    valueIndex -> returnedOwnedBindingIndex(context, state) => binding
    backing >= 0 and binding < 0 -> if { backing => transferred! }
    backing >= 0 and binding >= 0
        and context.ir[binding].parent == regionIndex
        and context.ir[binding].flags != 1
        and (binding -> bindingPromotedFixedArrayCall(context, state)) >= 0
        -> if { backing => transferred! }
    transferred!
}
emitPromotedFixedBackingDrop callIndex: Int, edgeIndex: Int, context: ref emitterContext.EmitContext -> Unit uses Console {
    "  %fixedbacking$(edgeIndex)_$(callIndex) = extractvalue { ptr, i64 } " -> print
    (callIndex -> bindingFixedStorageCopyTypeId(context)) >= 0
        -> if { "%v$(callIndex)_binding_copy" -> print } else { "%v$(callIndex)" -> print }
    ", 0" -> println
    "  call void @free(ptr %fixedbacking$(edgeIndex)_$(callIndex))" -> println
}

# Classify nested struct fields independently of their nominal owning bit.
# 0 needs no backing copy, 1 contains copyable fixed storage, -1 is affine
# or unsupported. Value layouts are acyclic; the arena bound rejects cycles.
fixedStructCopyState typeId: Int, depth: Int, context: ref emitterContext.EmitContext -> Int {
    typeId < 0 or typeId >= (context.types -> len) or depth >= (context.types -> len)
        -> if { -1 -> return }
    context.types[typeId] => owner
    owner.kind == 4 -> if {
        owner.first < 0 or owner.first >= (context.typeTraits -> len)
            or context.typeSizes[typeId] < 0
            or context.typeTraits[owner.first] % 2 == 1
            or context.types[owner.first].kind == 4
            -> if { -1 -> return }
        1 -> return
    }
    (owner.kind == 1 and (owner.origin == 0 or owner.origin == 2)) or owner.kind == 10
        -> if {
            # Enum payload copying has a separate ownership contract.
            owner.kind == 1 and owner.module >= 0 and owner.module < (context.ranges -> len)
                -> if {
                    context.ranges[owner.module] => range
                    owner.symbol >= 0 and owner.symbol < range.symbolCount
                        -> if {
                            context.symbols[range.symbolStart + owner.symbol].astNode => declaration
                            declaration >= 0 and context.nodes[range.astStart + declaration].kind == 4
                                -> if { -1 -> return }
                        }
                }
            context.typeTraits[typeId] / 4 % 2 == 1 -> if { -1 -> return }
            0 => result!
            0 => fieldIndex!
            fieldIndex! < (context.fields -> len) and result! >= 0
                -> while {
                    context.fields[fieldIndex!] => field
                    field.status == 0 and field.ownerType == typeId and field.fieldType >= 0
                        -> if {
                            field.fieldType -> fixedStructCopyState(depth + 1, context) => fieldState
                            fieldState < 0 -> if { -1 => result! } else {
                                fieldState == 1 -> if { 1 => result! }
                            }
                        }
                    fieldIndex! + 1 => fieldIndex!
                }
            result! -> return
        }
    context.typeTraits[typeId] % 2 == 1 -> if { -1 } else { 0 }
}

directCopyableFixedStructType typeId: Int, context: ref emitterContext.EmitContext -> Bool {
    typeId >= 0 and typeId < (context.types -> len)
        -> unless { false -> return }
    context.types[typeId] => owner
    ((owner.kind == 1 and (owner.origin == 0 or owner.origin == 2)) or owner.kind == 10)
        and (typeId -> fixedStructCopyState(0, context)) == 1
}

# Fixed arrays and aggregate fields share one backing-copy implementation.
emitCopyableFixedArrayValue prefix: Text, sourceName: Text, typeId: Int, context: ref emitterContext.EmitContext -> Unit uses Console {
    "  $(prefix)_data = extractvalue { ptr, i64 } $(sourceName), 0" -> println
    "  $(prefix)_length = extractvalue { ptr, i64 } $(sourceName), 1" -> println
    context.typeSizes[typeId] => allocationBytes!
    allocationBytes! == 0 and context.types[typeId].first >= 0
        -> if { context.typeSizes[context.types[typeId].first] => allocationBytes! }
    "  $(prefix)_owned = call ptr @malloc(i64 $(allocationBytes!))" -> println
    "  call void @llvm.memcpy.p0.p0.i64(ptr $(prefix)_owned, ptr $(prefix)_data, i64 $(context.typeSizes[typeId]), i1 false)" -> println
    "  $(prefix)_slice0 = insertvalue { ptr, i64 } poison, ptr $(prefix)_owned, 0" -> println
    "  $(prefix) = insertvalue { ptr, i64 } $(prefix)_slice0, i64 $(prefix)_length, 1" -> println
}

emitCopyableFixedStorageValue prefix: Text, sourceName: Text, typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.types[typeId].kind == 4 -> if {
        prefix -> emitCopyableFixedArrayValue(sourceName, typeId, context)
    } else { prefix -> emitCopyableFixedStructValue(sourceName, typeId, context, state) }
}

emitCopyableFixedStructValue prefix: Text, sourceName: Text, typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    -1 => previousCopiedField!
    0 => fieldIndex!
    fieldIndex! < (context.fields -> len) -> while {
        context.fields[fieldIndex!] => field
        field.status == 0 and field.ownerType == typeId and field.fieldType >= 0
            and (field.fieldType -> fixedStructCopyState(0, context)) == 1
            -> if {
                "  $(prefix)_copy_field$(field.ordinal) = extractvalue " -> print
                typeId -> writeSemanticTypeId(context, state)
                previousCopiedField! < 0 -> if {
                    " $(sourceName)" -> print
                } else { " $(prefix)_copy_aggregate_$(previousCopiedField!)" -> print }
                ", $(field.ordinal)" -> println
                context.types[field.fieldType].kind == 4 -> if {
                    "$(prefix)_copy_slice_$(field.ordinal)" -> emitCopyableFixedArrayValue("$(prefix)_copy_field$(field.ordinal)", field.fieldType, context)
                    "  $(prefix)_copy_aggregate_$(field.ordinal) = insertvalue " -> print
                    typeId -> writeSemanticTypeId(context, state)
                    previousCopiedField! < 0 -> if {
                        " $(sourceName)" -> print
                    } else { " $(prefix)_copy_aggregate_$(previousCopiedField!)" -> print }
                    ", { ptr, i64 } $(prefix)_copy_slice_$(field.ordinal), $(field.ordinal)" -> println
                } else {
                    "$(prefix)_copy_nested$(field.ordinal)" -> emitCopyableFixedStructValue("$(prefix)_copy_field$(field.ordinal)", field.fieldType, context, state)
                    "  $(prefix)_copy_aggregate_$(field.ordinal) = insertvalue " -> print
                    typeId -> writeSemanticTypeId(context, state)
                    previousCopiedField! < 0 -> if { " $(sourceName)" -> print } else {
                        " $(prefix)_copy_aggregate_$(previousCopiedField!)" -> print
                    }
                    ", " -> print
                    field.fieldType -> writeSemanticTypeId(context, state)
                    " $(prefix)_copy_nested$(field.ordinal), $(field.ordinal)" -> println
                }
                field.ordinal => previousCopiedField!
            }
        fieldIndex! + 1 => fieldIndex!
    }
    "  $(prefix) = freeze " -> print
    typeId -> writeSemanticTypeId(context, state)
    " $(prefix)_copy_aggregate_$(previousCopiedField!)" -> println
}

emitDirectCopyableFixedStructCopy valueIndex: Int, typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    "%v$(valueIndex)" -> emitCopyableFixedStructValue("%v$(valueIndex)_copy_source", typeId, context, state)
}

# Only the two borrowing intrinsics construct SourceText with a literal null
# owner. Follow direct immutable aliases, but stop at mutable, control, tap,
# parameter, field and opaque values so their dynamic cleanup remains intact.
knownBorrowedSourceTextDrop request: DropGlueRequest, context: ref emitterContext.EmitContext -> Bool {
    false => sourceTextRequest!
    request.typeId >= 0 and request.typeId < (context.types -> len)
        -> if {
            context.types[request.typeId] => requestType
            requestType.kind == 1 and requestType.origin == 1 and requestType.symbol == 24
                => sourceTextRequest!
        } else {
            request.typeId < 0 and request.typeOrigin == 1 and request.typeSymbol == 24
                => sourceTextRequest!
        }
    not sourceTextRequest! or request.valueKind != 0
        or request.valueIndex < 0 or request.valueIndex >= (context.ir -> len)
        -> if { false -> return }

    request.valueIndex => candidateIndex!
    0 => hop!
    hop! < (context.ir -> len) -> while {
        context.ir[candidateIndex!] => candidate
        candidate -> typeQueries.isSourceText => candidateIsSourceText
        candidateIsSourceText and (candidate.kind == 6 or candidate.kind == 9)
            and (candidate.opcode == -206 or candidate.opcode == -232)
            -> if { true -> return }

        -1 => nextIndex!
        candidateIsSourceText and candidate.kind == 17 and candidate.flags != 1
            and candidate.operand0 >= 0 and candidate.operand0 < (context.ir -> len)
            -> if { candidate.operand0 => nextIndex! }
        candidateIsSourceText and candidate.kind == 5
            and candidate.operand0 >= 0 and candidate.operand0 < (context.ir -> len)
            -> if {
                context.ir[candidate.operand0] => binding
                binding.kind == 17 and binding.flags != 1
                    and (binding -> typeQueries.isSourceText)
                    and binding.operand0 >= 0 and binding.operand0 < (context.ir -> len)
                    -> if { binding.operand0 => nextIndex! }
            }
        nextIndex! < 0 -> if { false -> return }
        nextIndex! => candidateIndex!
        hop! + 1 => hop!
    }
    false
}

emitInterpolationEnumTransferMark argumentNode: Int, sourceModule: Int, ownerIndex: Int, beforeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    argumentNode -> interpolationEnumPayloadBorrows(sourceModule, ownerIndex, beforeIndex, context, state)
        -> if { return }
    context.interpolations[argumentNode] => argument
    argument.kind != 1 -> if { return }
    argument -> interpolationBindingIndex(sourceModule, ownerIndex, beforeIndex, context, state) => bindingIndex
    bindingIndex < 0 -> if { return }
    context.ir[bindingIndex] => binding
    binding.kind == 29 and (bindingIndex -> patternBindingNeedsOwnershipFlag(context, state))
        -> if { "  store i1 false, ptr %v$(bindingIndex)_owned, align 1" -> println }
    binding.kind == 10 and (bindingIndex -> moveParameterNeedsPathOwnershipFlag(ownerIndex, context, state))
        -> if { "  store i1 false, ptr %arg$(bindingIndex)_owned, align 1" -> println }
}

interpolationTransferMatchesAssignment transfer: typedIr.InterpolationPayloadTransfer, assignmentIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    context.ir[assignmentIndex] => assignment
    context.ir[transfer.bindingIr] => binding
    assignment.kind != 25 or assignment.sourceModule != transfer.sourceModule or assignment.symbol != binding.symbol
        -> if { false -> return }
    context.ranges[assignment.sourceModule] => range
    context.nodes[range.astStart + assignment.astNode] => assignmentAst
    assignmentAst.secondaryToken < 0 -> if { false -> return }
    [Int; ~] => members!
    transfer.argumentNode => memberIndex!
    context.interpolations[memberIndex!].kind == 5
        -> while {
            members! -> push(memberIndex!)
            context.interpolations[memberIndex!].operand0 => memberIndex!
        }
    0 => identifierOrdinal!
    assignmentAst.firstToken => tokenIndex!
    true => matches!
    tokenIndex! <= assignmentAst.secondaryToken and matches!
        -> while {
            context.tokens[range.tokenStart + tokenIndex!] => token
            token.kind == grammar.tokenIdIdentifier() -> if {
                identifierOrdinal! > 0 -> if {
                    identifierOrdinal! > (members! -> len) -> if {
                        false => matches!
                    } else {
                        context.interpolations[members![Int(members! -> len) - identifierOrdinal!]] => member
                        member.callNameLength != token.span.length -> if { false => matches! }
                        UIntSize(0) => byteIndex!
                        matches! and byteIndex! < token.span.length -> while {
                            (context.sources[assignment.sourceModule] -> byte(token.span.start + byteIndex!)) != (context.sources[transfer.sourceModule] -> byte(member.callNameStart + byteIndex!))
                                -> if { false => matches! }
                            byteIndex! + 1 => byteIndex!
                        }
                    }
                }
                identifierOrdinal! + 1 => identifierOrdinal!
            }
            tokenIndex! + 1 => tokenIndex!
        }
    matches! and identifierOrdinal! > 1
}

interpolationTransferActiveBefore transfer: typedIr.InterpolationPayloadTransfer, beforeAst: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.ir[transfer.siteIr] -> sourceStart(context, state) => moveStart
    UIntSize(0) => edgeEnd!
    beforeAst >= 0 -> if {
        context.nodes[context.ranges[transfer.sourceModule].astStart + beforeAst] => edge
        edge.start + edge.length => edgeEnd!
        moveStart >= edgeEnd! -> if { false -> return }
    }
    transfer.regionIr => functionIndex!
    functionIndex! >= 0 and context.ir[functionIndex!].kind != 0 and context.ir[functionIndex!].kind != 11
        -> while { context.ir[functionIndex!].parent => functionIndex! }
    functionIndex! < 0 -> if { false -> return }
    transfer.argumentNode -> interpolationEnumPayloadBorrows(transfer.sourceModule, functionIndex!, transfer.siteIr, context, state)
        -> if { false -> return }
    functionIndex! + 1 => assignmentIndex!
    functionIndex! -> functionEnd(context, state) => end
    assignmentIndex! < end -> while {
        context.ir[assignmentIndex!] => assignment
        assignment -> sourceStart(context, state) => assignmentStart
        assignment.kind == 25 and assignment.sourceModule == transfer.sourceModule
            and (assignmentIndex! -> moveRegionFor(context, state)) == transfer.regionIr
            and assignmentStart > moveStart and (beforeAst < 0 or assignmentStart < edgeEnd!)
            and (transfer -> interpolationTransferMatchesAssignment(assignmentIndex!, context))
            -> if { false -> return }
        assignmentIndex! + 1 => assignmentIndex!
    }
    true
}

interpolationTransferMatchesDropPath transfer: typedIr.InterpolationPayloadTransfer, taskIndex: Int, tasks: ref [DropGlueRequest; ~], context: ref emitterContext.EmitContext -> Bool {
    transfer.argumentNode => memberIndex!
    taskIndex => taskIndex!
    0 => depth!
    true => matches!
    taskIndex! >= 0 and tasks[taskIndex!].fieldOrdinal >= 0 and matches!
        -> while {
            context.interpolations[memberIndex!] => member
            member.kind != 5 -> if { false -> return }
            context.interpolationMemberFieldByNode[memberIndex!] => fieldIndex
            fieldIndex < 0 or context.fields[fieldIndex].ordinal != tasks[taskIndex!].fieldOrdinal
                -> if { false => matches! }
            member.operand0 => memberIndex!
            tasks[taskIndex!].parentTask => taskIndex!
            depth! + 1 => depth!
        }
    matches! and depth! == transfer.fieldDepth
}

emitDropGlue request: DropGlueRequest, edgeNodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    request => rootRequest!
    context.interpolationPayloadTransfers -> each transfer {
        transfer.bindingIr == request.bindingIndex and transfer.fieldDepth > 0
            -> if { true => rootRequest!.hasPartialMoves }
    }
    [rootRequest!,; ~] => dropTasks!
    0 => dropTaskIndex!
    dropTaskIndex! < (dropTasks! -> len) -> while {
        dropTasks![dropTaskIndex!] => dropTask
        false => dropTaskMoved!
        dropTask.bindingIndex >= 0 and dropTask.hasPartialMoves
            -> if {
                context.ir[dropTask.bindingIndex] => dropGlueBinding
                context.ranges[dropGlueBinding.sourceModule] => dropGlueRange
                UIntSize(0) => dropGlueBeforeEnd!
                dropTask.beforeAst >= 0 -> if {
                    context.nodes[dropGlueRange.astStart + dropTask.beforeAst] => dropGlueEdgeAst
                    dropGlueEdgeAst.start + dropGlueEdgeAst.length => dropGlueBeforeEnd!
                }
                0 => dropGlueMoveIndex!
                dropGlueMoveIndex! < (context.moves -> len) and not dropTaskMoved!
                    -> while {
                        context.moves[dropGlueMoveIndex!] => dropGlueMove
                        (dropGlueMove.regionIr == dropTask.regionIndex
                            or (edgeNodeIndex >= 0 and (dropGlueMove.regionIr -> ownershipRegionContainsEdge(edgeNodeIndex, context, state)))
                            or (dropGlueMove.memberIr >= 0
                            and (dropTask.regionIndex -> regionFullyMovesPlace(dropGlueBinding.sourceModule, dropGlueBinding.symbol, dropGlueMove.memberIr, dropGlueBinding -> sourceStart(context, state), dropTask.beforeAst, edgeNodeIndex, context, state)))) => dropGlueMoveOnEdge
                        dropGlueMove.memberIr >= 0 and dropGlueMove.sourceModule == dropGlueBinding.sourceModule and dropGlueMove.symbol == dropGlueBinding.symbol and dropGlueMoveOnEdge and (dropGlueMoveIndex! -> partialMoveActiveBefore(dropGlueMove.regionIr, dropTask.beforeAst, context, state))
                            -> if {
                                context.ir[dropGlueMove.siteIr] => dropGlueSite
                                true => dropGlueMoveBeforeEdge!
                                dropTask.beforeAst >= 0 -> if {
                                    context.nodes[dropGlueRange.astStart + dropGlueSite.astNode].start >= dropGlueBeforeEnd!
                                        -> if { false => dropGlueMoveBeforeEdge! }
                                }
                                context.nodes[dropGlueRange.astStart + dropGlueSite.astNode].start <= context.nodes[dropGlueRange.astStart + dropGlueBinding.astNode].start
                                    -> if { false => dropGlueMoveBeforeEdge! }
                                0 => dropTaskDepth!
                                dropTaskIndex! => dropTaskCursor!
                                dropTaskCursor! >= 0 and dropTasks![dropTaskCursor!].fieldOrdinal >= 0
                                    -> while {
                                        dropTaskDepth! + 1 => dropTaskDepth!
                                        dropTasks![dropTaskCursor!].parentTask => dropTaskCursor!
                                    }
                                context.ir[dropGlueMove.memberIr] => dropMoveMember
                                context.ranges[dropMoveMember.sourceModule] => dropMoveRange
                                context.nodes[dropMoveRange.astStart + dropMoveMember.astNode] => dropMoveAst
                                -1 => dropMoveDepth!
                                dropMoveAst.firstToken => dropMoveTokenIndex!
                                dropMoveTokenIndex! < dropMoveAst.firstToken + dropMoveAst.tokenCount
                                    -> while {
                                        context.tokens[dropMoveRange.tokenStart + dropMoveTokenIndex!].kind == grammar.tokenIdIdentifier()
                                            -> if { dropMoveDepth! + 1 => dropMoveDepth! }
                                        dropMoveTokenIndex! + 1 => dropMoveTokenIndex!
                                    }
                                dropTaskDepth! == dropMoveDepth! => sameDropPath!
                                dropGlueBinding.typeOrigin => dropMoveCurrentOrigin!
                                dropGlueBinding.typeModule => dropMoveCurrentModule!
                                dropGlueBinding.typeSymbol => dropMoveCurrentSymbol!
                                0 => dropMoveIdentifierOrdinal!
                                dropMoveAst.firstToken => dropMoveTokenIndex!
                                sameDropPath! and dropMoveTokenIndex! < dropMoveAst.firstToken + dropMoveAst.tokenCount
                                    -> while {
                                        context.tokens[dropMoveRange.tokenStart + dropMoveTokenIndex!].kind == grammar.tokenIdIdentifier()
                                            -> if {
                                                dropMoveIdentifierOrdinal! > 0 -> if {
                                                    dropMoveCurrentModule! => dropMoveOwnerSource!
                                                    dropMoveCurrentOrigin! == 2 -> if { context.modules[dropMoveCurrentModule!].sourceIndex => dropMoveOwnerSource! }
                                                    context.ranges[dropMoveOwnerSource!] => dropMoveOwnerRange
                                                    -1 => dropMoveFieldOrdinal!
                                                    -1 => dropMoveFieldTypeNode!
                                                    0 => dropMoveCandidateOrdinal!
                                                    0 => dropMoveFieldIndex!
                                                    dropMoveFieldIndex! < dropMoveOwnerRange.symbolCount
                                                        -> while {
                                                            context.symbols[dropMoveOwnerRange.symbolStart + dropMoveFieldIndex!] => dropMoveField
                                                            dropMoveField.kind == 26 and dropMoveField.parent == dropMoveCurrentSymbol!
                                                                -> if {
                                                                    context.tokens[dropMoveRange.tokenStart + dropMoveTokenIndex!] => dropMoveName
                                                                    context.tokens[dropMoveOwnerRange.tokenStart + dropMoveField.nameToken] => dropMoveFieldName
                                                                    dropMoveName.span.length == dropMoveFieldName.span.length => dropMoveEqual!
                                                                    UIntSize(0) => dropMoveNameByte!
                                                                    dropMoveEqual! and dropMoveNameByte! < dropMoveName.span.length
                                                                        -> while {
                                                                            context.sources[dropMoveMember.sourceModule] -> byte(dropMoveName.span.start + dropMoveNameByte!) => dropMoveByte
                                                                            context.sources[dropMoveOwnerSource!] -> byte(dropMoveFieldName.span.start + dropMoveNameByte!) => dropMoveFieldByte
                                                                            dropMoveByte != dropMoveFieldByte -> if { false => dropMoveEqual! }
                                                                            dropMoveNameByte! + 1 => dropMoveNameByte!
                                                                        }
                                                                    dropMoveEqual! -> if {
                                                                        dropMoveCandidateOrdinal! => dropMoveFieldOrdinal!
                                                                        dropMoveField.typeNode => dropMoveFieldTypeNode!
                                                                    }
                                                                    dropMoveCandidateOrdinal! + 1 => dropMoveCandidateOrdinal!
                                                                }
                                                            dropMoveFieldIndex! + 1 => dropMoveFieldIndex!
                                                        }
                                                    dropTaskIndex! => dropTaskCursor!
                                                    dropTaskDepth! - dropMoveIdentifierOrdinal! => dropTaskParentSteps!
                                                    dropTaskParentSteps! > 0 -> while {
                                                        dropTasks![dropTaskCursor!].parentTask => dropTaskCursor!
                                                        dropTaskParentSteps! - 1 => dropTaskParentSteps!
                                                    }
                                                    dropMoveFieldOrdinal! < 0 or dropTasks![dropTaskCursor!].fieldOrdinal != dropMoveFieldOrdinal!
                                                        -> if { false => sameDropPath! }
                                                    0 => dropMoveNominalIndex!
                                                    dropMoveNominalIndex! < (context.nominal -> len)
                                                        -> while {
                                                            context.nominal[dropMoveNominalIndex!] => dropMoveNominalType
                                                            dropMoveNominalType.sourceModule == dropMoveOwnerSource! and dropMoveNominalType.typeAst == dropMoveFieldTypeNode!
                                                                -> if {
                                                                    dropMoveNominalType.origin => dropMoveCurrentOrigin!
                                                                    dropMoveNominalType.targetModule => dropMoveCurrentModule!
                                                                    dropMoveNominalType.targetSymbol => dropMoveCurrentSymbol!
                                                                }
                                                            dropMoveNominalIndex! + 1 => dropMoveNominalIndex!
                                                        }
                                                }
                                                dropMoveIdentifierOrdinal! + 1 => dropMoveIdentifierOrdinal!
                                            }
                                        dropMoveTokenIndex! + 1 => dropMoveTokenIndex!
                                    }
                                dropGlueMoveBeforeEdge! and sameDropPath! -> if { true => dropTaskMoved! }
                            }
                        dropGlueMoveIndex! + 1 => dropGlueMoveIndex!
                    }
            }
        dropTask.bindingIndex >= 0 and dropTask.hasPartialMoves and not dropTaskMoved!
            -> if {
                context.interpolationPayloadTransfers -> each transfer {
                    transfer.bindingIr == dropTask.bindingIndex and transfer.fieldDepth > 0
                        and (transfer.regionIr == dropTask.regionIndex or (edgeNodeIndex >= 0 and (transfer.regionIr -> ownershipRegionContainsEdge(edgeNodeIndex, context, state))))
                        and (transfer -> interpolationTransferMatchesDropPath(dropTaskIndex!, dropTasks!, context))
                        and (transfer -> interpolationTransferActiveBefore(dropTask.beforeAst, context, state))
                        -> if { true => dropTaskMoved! }
                }
            }
        dropTask.typeId >= 0 and context.types[dropTask.typeId].kind == 4
            and dropTask.valueKind == 2 and dropTask.parentTask >= 0
            => dropTaskIsFixedField
        not dropTaskMoved! and dropTaskIsFixedField -> if {
            "  " -> print
            dropTask -> emitDropPathName(context, state)
            "_fixed_data = extractvalue { ptr, i64 } " -> print
            dropTask -> emitDropValueName(context, state)
            ", 0" -> println
            dropTask.typeId -> semanticTypeOwns(context, state)
                -> if {
                    "  " -> print
                    dropTask -> emitDropPathName(context, state)
                    "_fixed_elements = load " -> print
                    dropTask.typeId -> writeSemanticTypeId(context, state)
                    ", ptr " -> print
                    dropTask -> emitDropPathName(context, state)
                    "_fixed_data, align " -> print
                    context.typeAligns[dropTask.typeId] -> writeDecimalLine
                    "  call void @sollang_drop_t$(dropTask.typeId)(" -> print
                    dropTask.typeId -> writeSemanticTypeId(context, state)
                    " " -> print
                    dropTask -> emitDropPathName(context, state)
                    "_fixed_elements)" -> println
                }
            "  call void @free(ptr " -> print
            dropTask -> emitDropPathName(context, state)
            "_fixed_data)" -> println
        }
        not dropTaskMoved! and not dropTaskIsFixedField and dropTask.typeId >= 0 and (not dropTask.hasPartialMoves or (dropTask.fieldOrdinal >= 0 and context.types[dropTask.typeId].kind != 1)) and (dropTask.typeId -> semanticTypeOwns(context, state)) and not (dropTask -> knownBorrowedSourceTextDrop(context))
            -> if {
                false => dropTaskNeedsFixedReload!
                false => dropTaskHasInlineArrayAbi!
                context.types[dropTask.typeId].kind == 4
                    -> if { true => dropTaskHasInlineArrayAbi! }
                dropTask.valueKind == 0
                    and dropTask.valueIndex >= 0
                    and dropTask.valueIndex < (context.ir -> len)
                    and dropTaskHasInlineArrayAbi!
                    and (context.ir[dropTask.valueIndex].kind == 14 or (dropTask.valueIndex -> promotedFixedArrayCall(context, state)) >= 0)
                    -> if {
                        true => dropTaskNeedsFixedReload!
                        "  %dropfixed$(edgeNodeIndex)_$(dropTaskIndex!)_data = extractvalue { ptr, i64 } %v$(dropTask.valueIndex), 0" -> println
                        "  %dropfixed$(edgeNodeIndex)_$(dropTaskIndex!) = load " -> print
                        dropTask.typeId -> writeSemanticTypeId(context, state)
                        ", ptr %dropfixed$(edgeNodeIndex)_$(dropTaskIndex!)_data, align " -> print
                        context.typeAligns[dropTask.typeId] -> writeDecimalLine
                    }
                "  call void @sollang_drop_t$(dropTask.typeId)(" -> print
                dropTask.typeId -> writeSemanticTypeId(context, state)
                " " -> print
                dropTaskNeedsFixedReload! -> if {
                    "%dropfixed$(edgeNodeIndex)_$(dropTaskIndex!)" -> print
                } else {
                    dropTask -> emitDropValueName(context, state)
                }
                ")" -> println
            } else {
                not dropTaskMoved! and (dropTask.typeOrigin == 13 or dropTask.typeOrigin == 14)
                    -> if {
                        "  " -> print
                        dropTask -> emitDropPathName(context, state)
                        "_data = extractvalue %sollang.array.i32 " -> print
                        dropTask -> emitDropValueName(context, state)
                        ", 0" -> println
                        "  call void @free(ptr " -> print
                        dropTask -> emitDropPathName(context, state)
                        "_data)" -> println
                    } else {
                        not dropTaskMoved! and dropTask.typeOrigin == 15
                            and (dropTask.typeId < 0 or context.types[dropTask.typeId].kind == 5)
                            -> if {
                                "  " -> print
                                dropTask -> emitDropPathName(context, state)
                                "_keys = extractvalue %sollang.dict " -> print
                                dropTask -> emitDropValueName(context, state)
                                ", 0" -> println
                                "  call void @free(ptr " -> print
                                dropTask -> emitDropPathName(context, state)
                                "_keys)" -> println
                            } else {
                                not dropTaskMoved! and (dropTask.typeOrigin == 0 or dropTask.typeOrigin == 2)
                                    -> if {
                                        context.ranges[dropTask.typeModule] => dropStructRange
                                        0 => dropFieldOrdinal!
                                        0 => dropFieldIndex!
                                        dropFieldIndex! < dropStructRange.symbolCount
                                            -> while {
                                                context.symbols[dropStructRange.symbolStart + dropFieldIndex!] => dropField
                                                dropField.kind == 26 and dropField.parent == dropTask.typeSymbol
                                                    -> if {
                                                        -1 => dropFieldTypeId!
                                                        0 => canonicalDropFieldIndex!
                                                        canonicalDropFieldIndex! < (context.fields -> len)
                                                            -> while {
                                                                context.fields[canonicalDropFieldIndex!] => canonicalDropField
                                                                canonicalDropField.status == 0 and canonicalDropField.ownerType == dropTask.typeId and canonicalDropField.ordinal == dropFieldOrdinal!
                                                                    -> if {
                                                                        canonicalDropField.fieldType => dropFieldTypeId!
                                                                    }
                                                                canonicalDropFieldIndex! + 1 => canonicalDropFieldIndex!
                                                            }
                                                        -1 => dropFieldOrigin!
                                                        -1 => dropFieldModule!
                                                        -1 => dropFieldSymbol!
                                                        dropFieldTypeId! >= 0 and context.types[dropFieldTypeId!].kind == 1
                                                            -> if {
                                                                context.types[dropFieldTypeId!].origin => dropFieldOrigin!
                                                                context.types[dropFieldTypeId!].module => dropFieldModule!
                                                                context.types[dropFieldTypeId!].symbol => dropFieldSymbol!
                                                            }
                                                        # A canonical field type is authoritative. Its ownership trait
                                                        # selects the generated type-specific drop below; legacy
                                                        # origin fallbacks are only for fields with no canonical id.
                                                        0 => dropCompositeIndex!
                                                        dropCompositeIndex! < (context.composite -> len)
                                                            -> while {
                                                                context.composite[dropCompositeIndex!] => dropCompositeType
                                                                dropFieldTypeId! < 0
                                                                    and dropFieldOrigin! < 0
                                                                    and dropCompositeType.sourceModule == dropTask.typeModule
                                                                    and dropCompositeType.typeAst == dropField.typeNode
                                                                    -> if {
                                                                        dropCompositeType.kind == 3 -> if { 13 => dropFieldOrigin! }
                                                                        dropCompositeType.kind == 5 -> if { 15 => dropFieldOrigin! }
                                                                    }
                                                                dropCompositeIndex! + 1 => dropCompositeIndex!
                                                            }
                                                        0 => dropNominalIndex!
                                                        dropNominalIndex! < (context.nominal -> len)
                                                            -> while {
                                                                context.nominal[dropNominalIndex!] => dropNominalType
                                                                dropFieldTypeId! < 0
                                                                    and dropFieldOrigin! < 0
                                                                    and dropNominalType.sourceModule == dropTask.typeModule
                                                                    and dropNominalType.typeAst == dropField.typeNode
                                                                    and (dropNominalType.origin == 0 or dropNominalType.origin == 2)
                                                                    -> if {
                                                                        dropNominalType.origin => dropFieldOrigin!
                                                                        dropNominalType.targetModule => dropFieldModule!
                                                                        dropNominalType.targetSymbol => dropFieldSymbol!
                                                                    }
                                                                dropNominalIndex! + 1 => dropNominalIndex!
                                                            }
                                                        dropFieldOrigin! >= 0 or (dropFieldTypeId! >= 0
                                                            and (context.types[dropFieldTypeId!].kind == 4
                                                            or (dropFieldTypeId! -> semanticTypeOwns(context, state))))
                                                            -> if {
                                                                dropTasks! -> len => dropFieldPath
                                                                "  %dropg$(dropTask.nameRoot)_p$dropFieldPath = extractvalue %sollang.struct.m$(dropTask.typeModule)_s$(dropTask.typeSymbol) " -> print
                                                                dropTask -> emitDropValueName(context, state)
                                                                ", $(dropFieldOrdinal!)" -> println
                                                                dropTasks! -> push(DropGlueRequest {
                                                                    typeId: dropFieldTypeId!
                                                                    typeOrigin: dropFieldOrigin!
                                                                    typeModule: dropFieldModule!
                                                                    typeSymbol: dropFieldSymbol!
                                                                    valueKind: 2
                                                                    valueIndex: -1
                                                                    nameRoot: dropTask.nameRoot
                                                                    pathCode: dropFieldPath
                                                                    bindingIndex: dropTask.bindingIndex
                                                                    regionIndex: dropTask.regionIndex
                                                                    beforeAst: dropTask.beforeAst
                                                                    parentTask: dropTaskIndex!
                                                                    fieldOrdinal: dropFieldOrdinal!
                                                                    hasPartialMoves: dropTask.hasPartialMoves
                                                                })
                                                            }
                                                        dropFieldOrdinal! + 1 => dropFieldOrdinal!
                                                    }
                                                dropFieldIndex! + 1 => dropFieldIndex!
                                            }
                                    }
                            }
                    }
            }
        dropTaskIndex! + 1 => dropTaskIndex!
    }
}

# Each move has one completion boundary. Value wrappers do not own transfers;
# calls and constructors do, with a direct enum member assignment completing
# at its destination store. Outer aggregates must not repeat an inner transfer.
nearestCompletedTransferOwner siteIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    siteIndex -> isAwaitSourceNode(context)
        -> if { siteIndex -> return }
    siteIndex => ancestor!
    -1 => owner!
    ancestor! >= 0 and owner! < 0 -> while {
        context.ir[ancestor!] => candidate
        candidate.kind == 12
            or candidate.kind == 14
            or candidate.kind == 16
            or candidate.kind == 35
            or candidate.kind == 6
            or candidate.kind == 26
            or candidate.kind == 25
            or (candidate.kind == 9 and candidate.opcode != -1)
            -> if {
                ancestor! => owner!
                candidate.kind == 26 and candidate.parent >= 0
                    and context.ir[candidate.parent].kind == 25
                    and (context.ir[candidate.parent].operand0 -> aggregateValueIndex(context, state)) == ancestor!
                    -> if { candidate.parent => owner! }
            } else {
                candidate.kind == 0 or candidate.kind == 11 or candidate.kind == 19 or candidate.kind == 20
                    -> if { -1 => ancestor! } else { candidate.parent => ancestor! }
            }
    }
    owner!
}

nearestAggregateTransferOwner siteIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    siteIndex -> nearestCompletedTransferOwner(context, state) => owner
    owner >= 0 -> if {
        context.ir[owner].kind => kind
        kind == 12 or kind == 14 or kind == 16 or kind == 35
            -> if { owner -> return }
    }
    -1
}

# Match the C# storage-coverage rule using canonical field paths. Indexed
# elements never represent transfer of their containing field storage.
ownedProjectionMatchesPrefix memberIndex: Int, prefix: ref [Int; ~], context: ref emitterContext.EmitContext -> Bool {
    memberIndex => member!
    prefix -> len => depth!
    depth! > 0 -> while {
        member! < 0 or member! >= (context.ir -> len)
            -> if { false -> return }
        context.ir[member!] => projection
        projection.kind != 13 or projection.operand0 < 0 or projection.operand0 >= (context.ir -> len)
            -> if { false -> return }
        depth! - 1 => depth!
        context.fields[prefix[depth!]] => field
        context.ir[projection.operand0].typeId != field.ownerType
            -> if { false -> return }
        # Typed IR symbol stores the canonical field ordinal. The base type
        # above identifies the owning nominal or structural field table.
        projection.symbol != field.ordinal -> if { false -> return }
        projection.operand0 => member!
    }
    member! >= 0 and member! < (context.ir -> len) and context.ir[member!].kind == 5
}

ownedProjectionPathsCoverStorage typeId: Int, prefix: ref [Int; ~], bindingIndex: Int, aggregateIndex: Int, depth: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    typeId < 0 or typeId >= (context.types -> len) or depth >= (context.types -> len)
        -> if { false -> return }
    context.ir[bindingIndex] => binding
    context.ir[aggregateIndex] => aggregate
    aggregate -> sourceNode(context, state) => aggregateAst
    aggregateAst.start + aggregateAst.length => completedEnd
    aggregateIndex -> moveRegionFor(context, state) => aggregateRegion
    0 => moveIndex!
    moveIndex! < (context.moves -> len) -> while {
        context.moves[moveIndex!] => coverageMove
        coverageMove.sourceModule == binding.sourceModule and coverageMove.symbol == binding.symbol
            and coverageMove.memberIr >= 0
            and (coverageMove.regionIr == aggregateRegion or (coverageMove.regionIr -> ownershipRegionContainsEdge(aggregateIndex, context, state)))
            and (coverageMove.memberIr -> ownedProjectionMatchesPrefix(prefix, context))
            and (moveIndex! -> partialMoveActiveBefore(coverageMove.regionIr, aggregate.astNode, context, state))
            -> if {
                coverageMove.siteIr -> nearestCompletedTransferOwner(context, state) => completedOwner
                completedOwner >= 0 -> if {
                    context.ir[completedOwner] -> sourceNode(context, state) => completedAst
                    completedAst.start + completedAst.length <= completedEnd
                        -> if { true -> return }
                }
            }
        moveIndex! + 1 => moveIndex!
    }
    false => hasOwnedField!
    0 => fieldIndex!
    fieldIndex! < (context.fields -> len) -> while {
        context.fields[fieldIndex!] => field
        field.status == 0 and field.ownerType == typeId and (field.fieldType -> semanticTypeOwns(context, state))
            -> if {
                true => hasOwnedField!
                [Int; ~] => fieldPrefix!
                prefix -> each entry { fieldPrefix! -> push(entry) }
                fieldPrefix! -> push(fieldIndex!)
                field.fieldType -> ownedProjectionPathsCoverStorage(fieldPrefix!, bindingIndex, aggregateIndex, depth + 1, context, state)
                    -> unless { false -> return }
            }
        fieldIndex! + 1 => fieldIndex!
    }
    hasOwnedField!
}

# Whole-owner aggregate transfers clear path liveness. A complete set of
# projected owned paths does the same; independent retained fields stay live.
emitAggregatePartialMoveCleanup aggregateIndex: Int, functionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    [Int; ~] => cleanedBindings!
    0 => moveIndex!
    moveIndex! < (context.moves -> len) -> while {
        context.moves[moveIndex!] => candidateMove
        candidateMove.siteIr -> nearestAggregateTransferOwner(context, state)
            => moveAggregateOwner
        aggregateIndex >= 0 and aggregateIndex == moveAggregateOwner
            => aggregateContainsMove
        false => alreadyCleaned!
        context -> parameterIndexForFunction(functionIndex, candidateMove.symbol)
            => movedParameterIndex
        0 => cleanedIndex!
        cleanedIndex! < (cleanedBindings! -> len) and not alreadyCleaned!
            -> while {
                cleanedBindings![cleanedIndex!] == movedParameterIndex
                    -> if { true => alreadyCleaned! }
                cleanedIndex! + 1 => cleanedIndex!
            }
        false => wholeStorageTransferred!
        aggregateContainsMove and not alreadyCleaned! and movedParameterIndex >= 0 and movedParameterIndex < (context.ir -> len)
            and candidateMove.regionIr != context.ir[functionIndex].operand0
            and (movedParameterIndex -> moveParameterNeedsPathOwnershipFlag(functionIndex, context, state))
            -> if {
                candidateMove.memberIr < 0 -> if { true => wholeStorageTransferred! } else {
                    [Int; ~] => rootPrefix
                    context.ir[movedParameterIndex].typeId -> ownedProjectionPathsCoverStorage(rootPrefix, movedParameterIndex, aggregateIndex, 0, context, state)
                        -> if { true => wholeStorageTransferred! }
                }
            }
        aggregateContainsMove
            and wholeStorageTransferred!
            and not alreadyCleaned!
            and movedParameterIndex >= 0
            and movedParameterIndex < (context.ir -> len)
            and candidateMove.regionIr != context.ir[functionIndex].operand0
            and (movedParameterIndex -> moveParameterNeedsPathOwnershipFlag(functionIndex, context, state))
            -> if {
                "  store i1 false, ptr %arg$(movedParameterIndex)_owned, align 1" -> println
                cleanedBindings! -> push(movedParameterIndex)
            }
        moveIndex! + 1 => moveIndex!
    }
}
semanticTypeOwns typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    typeId >= 0 and typeId < (context.typeTraits -> len)
        -> if {
            context.typeTraits[typeId] % 2 == 1
        } else { false }
}

# Runtime pattern liveness also tracks fixed backing with scalar elements,
# even when semantic move analysis has no affine element event to report.
namedBindingPathOwnershipFlags context: ref emitterContext.EmitContext -> [Bool; ~] {
    [Bool; ~] => flags!
    context.ir -> each node { flags! -> push(false) }
    context.moves -> each transfer {
        transfer.bindingIr >= 0 and transfer.bindingIr < (context.ir -> len)
            and transfer.memberIr < 0 -> if {
                context.ir[transfer.bindingIr] => binding
                binding.kind == 17 and binding.flags != 1
                    and transfer.regionIr != binding.parent
                    -> if { true => flags![transfer.bindingIr] }
            }
    }
    flags!
}

namedBindingNeedsOwnershipFlag bindingIndex: Int, state: ref CoreEmitterState -> Bool {
    bindingIndex >= 0 and bindingIndex < (state.frozenNamedBindingPathOwned -> len)
        and state.frozenNamedBindingPathOwned[bindingIndex]
}

emitNamedBindingOwnershipInitialization bindingIndex: Int, state: ref CoreEmitterState -> Unit uses Console {
    bindingIndex -> namedBindingNeedsOwnershipFlag(state)
        -> if { "  store i1 true, ptr %v$(bindingIndex)_owned, align 1" -> println }
}

patternBindingNeedsOwnershipFlag bindingIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    bindingIndex >= 0 and bindingIndex < (context.ir -> len)
        -> unless { false -> return }
    context.ir[bindingIndex].kind == 29 -> unless { false -> return }
    context.ir[bindingIndex] -> effectiveTypeId(context, state) => typeId
    typeId >= 0 and context.types[typeId].kind == 4
        -> if { true -> return }
    0 => moveIndex!
    moveIndex! < (context.moves -> len) -> while {
        context.moves[moveIndex!].bindingIr == bindingIndex
            -> if { true -> return }
        moveIndex! + 1 => moveIndex!
    }
    false
}

# Match payloads carry their own fixed-array backing independently of whether
# their elements need a drop. Borrowed subjects are excluded by the caller.
emitPatternBindingDrop bindingIndex: Int, regionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[bindingIndex].typeId => typeId
    bindingIndex => functionOwner!
    functionOwner! >= 0 and context.ir[functionOwner!].kind != 0 and context.ir[functionOwner!].kind != 11
        -> while { context.ir[functionOwner!].parent => functionOwner! }
    bindingIndex -> asyncFrameBindingRoot(functionOwner!, context, state) => frameRoot
    0 => dropValueKind!
    frameRoot >= 0 -> if {
        2 => dropValueKind!
        "  %dropg$(bindingIndex)_p0 = load " -> print
        context.ir[bindingIndex] -> writeIrType(context, state)
        ", ptr " -> print
        frameRoot -> writeAsyncLocalAddress(context)
        ", align " -> print
        context.ir[bindingIndex] -> asyncFrameValueAlign(context, state) -> writeDecimalLine
    }
    false => hasInterpolationProjection!
    context.interpolationPayloadTransfers -> each transfer {
        transfer.bindingIr == bindingIndex and transfer.fieldDepth > 0
            -> if { true => hasInterpolationProjection! }
    }
    context.moves -> each transfer {
        transfer.bindingIr == bindingIndex and transfer.memberIr >= 0
            -> if { true => hasInterpolationProjection! }
    }
    hasInterpolationProjection! -> if {
        context.types[typeId] => type
        DropGlueRequest {
            typeId: typeId, typeOrigin: type.origin, typeModule: type.module, typeSymbol: type.symbol,
            valueKind: dropValueKind!, valueIndex: bindingIndex, nameRoot: bindingIndex, pathCode: 0,
            bindingIndex: bindingIndex, regionIndex: regionIndex,
            beforeAst: -1, parentTask: -1, fieldOrdinal: -1, hasPartialMoves: true
        } -> emitDropGlue(-1, context, state)
        return
    }
    context.types[typeId].kind == 4 -> if {
        "  %patternfixed$(bindingIndex)_data = extractvalue { ptr, i64 } " -> print
        frameRoot >= 0 -> if { "%dropg$(bindingIndex)_p0" -> print } else { "%v$(bindingIndex)" -> print }
        ", 0" -> println
        typeId -> semanticTypeOwns(context, state) -> if {
            "  %patternfixed$(bindingIndex)_elements = load " -> print
            typeId -> writeSemanticTypeId(context, state)
            ", ptr %patternfixed$(bindingIndex)_data, align " -> print
            context.typeAligns[typeId] -> writeDecimalLine
            "  call void @sollang_drop_t$(typeId)(" -> print
            typeId -> writeSemanticTypeId(context, state)
            " %patternfixed$(bindingIndex)_elements)" -> println
        }
        "  call void @free(ptr %patternfixed$(bindingIndex)_data)" -> println
    } else {
        "  call void @sollang_drop_t$(typeId)(" -> print
        typeId -> writeSemanticTypeId(context, state)
        " " -> print
        frameRoot >= 0 -> if { "%dropg$(bindingIndex)_p0" -> print } else { "%v$(bindingIndex)" -> print }
        ")" -> println
    }
}
isOwnedSocketType typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => owned!
    typeId >= 0 and typeId < (context.types -> len)
        -> if {
            context.types[typeId] => candidate
            candidate.kind == 1 and (candidate.origin == 0 or candidate.origin == 2) and candidate.module >= 0
                -> if {
                    false => socketModule!
                    0 => moduleSearch!
                    moduleSearch! < (context.modules -> len) -> while {
                        context.modules[moduleSearch!] => moduleIdentity
                        moduleIdentity.sourceIndex == candidate.module and moduleIdentity.pathHash == 13685761513169113882
                            and modules.logicalNameIs(context.sources[candidate.module], moduleIdentity, context.ranges[candidate.module], context.tokens, "std.net.socket")
                            -> if { true => socketModule! }
                        moduleSearch! + 1 => moduleSearch!
                    }
                    socketModule! -> if {
                        context.ranges[candidate.module] => candidateRange
                        candidate.symbol >= 0 and candidate.symbol < candidateRange.symbolCount
                            -> if {
                                context.symbols[candidateRange.symbolStart + candidate.symbol] => candidateSymbol
                                candidate.module -> sourceTokenIs(candidateSymbol.nameToken, "TcpListener", context, state)
                                    -> if { true => owned! }
                                candidate.module -> sourceTokenIs(candidateSymbol.nameToken, "TcpStream", context, state)
                                    -> if { true => owned! }
                                candidate.module -> sourceTokenIs(candidateSymbol.nameToken, "UdpSocket", context, state)
                                    -> if { true => owned! }
                                candidate.module -> sourceTokenIs(candidateSymbol.nameToken, "CompletionReactor", context, state)
                                    -> if { true => owned! }
                            }
                    }
                }
        }
    owned!
}
isOwnedProcessChildType typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => owned!
    typeId >= 0 and typeId < (context.types -> len)
        -> if {
            context.types[typeId] => candidate
            candidate.kind == 1 and (candidate.origin == 0 or candidate.origin == 2) and candidate.module >= 0
                -> if {
                    false => processModule!
                    0 => moduleSearch!
                    moduleSearch! < (context.modules -> len) -> while {
                        context.modules[moduleSearch!] => moduleIdentity
                        moduleIdentity.sourceIndex == candidate.module and moduleIdentity.pathHash == 15528987723426532771
                            and modules.logicalNameIs(context.sources[candidate.module], moduleIdentity, context.ranges[candidate.module], context.tokens, "sys.process")
                            -> if { true => processModule! }
                        moduleSearch! + 1 => moduleSearch!
                    }
                    processModule! -> if {
                        context.ranges[candidate.module] => candidateRange
                        candidate.symbol >= 0 and candidate.symbol < candidateRange.symbolCount
                            -> if {
                                context.symbols[candidateRange.symbolStart + candidate.symbol] => candidateSymbol
                                candidate.module -> sourceTokenIs(candidateSymbol.nameToken, "Child", context, state)
                                    -> if { true => owned! }
                            }
                    }
                }
        }
    owned!
}

