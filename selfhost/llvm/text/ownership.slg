}
referenceValueTypeId node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => valueTypeId!
    node -> effectiveTypeId(context, state) => referenceTypeId
    referenceTypeId >= 0
        and referenceTypeId < (context.types -> len)
        and context.types[referenceTypeId].kind == 8
        -> if {
            context.types[referenceTypeId].first => candidateTypeId
            candidateTypeId >= 0 and candidateTypeId < (context.types -> len)
                -> if { candidateTypeId => valueTypeId! }
        }
    valueTypeId!
}

scalarReferenceValueTypeId node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => valueTypeId!
    node -> referenceValueTypeId(context, state) => candidateTypeId
    candidateTypeId >= 0 -> if {
        context.types[candidateTypeId] => candidateType
        candidateType.kind == 1 and candidateType.origin == 1
            -> if {
                candidateType.symbol -> integerWidth(context, state) => candidateWidth
                candidateWidth > 0 or candidateType.symbol == 23
                    -> if { candidateTypeId => valueTypeId! }
            }
    }
    valueTypeId!
}
integerNodeWidth node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => symbol!
    false => canonicalReference!
    node.typeOrigin == 1 -> if { node.typeSymbol => symbol! }
    node -> effectiveTypeId(context, state) => typeId
    typeId >= 0 and typeId < (context.types -> len)
        -> if {
            context.types[typeId] => canonicalType
            canonicalType.kind == 1 and canonicalType.origin == 1
                -> if {
                    canonicalType.symbol => symbol!
                }
            canonicalType.kind == 8 -> if { true => canonicalReference! }
        }
    symbol! -> integerWidth(context, state) => width!
    symbol! == 23 -> if { 1 => width! }
    symbol! == 12 or symbol! == 13 -> if { context.pointerBitWidth => width! }
    (node.kind == 9 or node.kind == 6) and node.opcode == -202
        -> if { 8 => width! }
    node.kind == 13 and not canonicalReference!
        -> if {
            node -> memberNodeIntegerWidth(context, state) => memberWidth
            memberWidth > 0 -> if { memberWidth => width! }
        }
    node.kind == 5 and node.operand0 >= 0 and node.operand0 < (context.ir -> len) and context.ir[node.operand0].kind == 17 and context.ir[node.operand0].flags != 1 and context.ir[node.operand0].operand0 >= 0 and context.ir[node.operand0].operand0 < (context.ir -> len)
        -> if {
            context.ir[context.ir[node.operand0].operand0] -> integerNodeWidth(context, state) => width!
        }
    node.kind == 7 and node.operand0 >= 0 and node.operand0 < (context.ir -> len)
        -> if {
            # Unary result identity carries contextual signed literal bounds.
            # The positive magnitude operand may still have default Int type.
            node.opcode == -26 -> if { 1 => width! } else {
                context.ir[node.operand0] => unaryOperand
                # A computed unary operand already has an exact runtime width.
                # Preserve contextual width only for a literal magnitude such
                # as 128 inside an Int8 -128 expression.
                unaryOperand.kind != 3 -> if {
                    unaryOperand -> integerNodeWidth(context, state) => unaryOperandWidth
                    unaryOperandWidth > 0 -> if { unaryOperandWidth => width! }
                }
            }
        }
    node.kind == 8 and node.operand0 >= 0 and node.operand0 < (context.ir -> len) and node.operand1 >= 0 and node.operand1 < (context.ir -> len)
        -> if {
            node.opcode == grammar.tokenIdEqualEqual() or node.opcode == grammar.tokenIdBangEqual() or node.opcode == grammar.tokenIdLess() or node.opcode == grammar.tokenIdLessEqual() or node.opcode == grammar.tokenIdGreater() or node.opcode == grammar.tokenIdGreaterEqual() or node.opcode == -24 or node.opcode == -25
                -> if {
                    1 => width!
                } else {
                    context.ir[node.operand0] -> integerNodeWidth(context, state) => leftWidth
                    context.ir[node.operand1] -> integerNodeWidth(context, state) => rightWidth
                    leftWidth > rightWidth -> if { leftWidth => width! } else { rightWidth => width! }
                }
        }
    (node.kind == 9 or node.kind == 6) and (node.opcode == -201 or node.opcode == -236) and node.operand0 >= 0
        -> if {
            node.typeSymbol == 2 -> if { 32 => width! } else { context.pointerBitWidth => width! }
        }
    width!
}
# Storage/ABI consumers retain integerNodeWidth's reference representation.
# Index value consumers explicitly request the scalar width after a read.
integerReadNodeWidth node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    node -> scalarReferenceValueTypeId(context, state) => readTypeId
    readTypeId >= 0 -> if {
        context.types[readTypeId].symbol => symbol
        symbol == 23 -> if { 1 -> return }
        symbol == 12 or symbol == 13 -> if { context.pointerBitWidth -> return }
        symbol -> integerWidth(context, state) -> return
    }
    node -> integerNodeWidth(context, state)
}

nodeContainsReadIntAt nodeIndex: Int, depth: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => contains!
    depth < 32 and nodeIndex >= 0 and nodeIndex < (context.ir -> len)
        -> if {
            context.ir[nodeIndex] => candidate
            candidate.kind == 6 and candidate.symbol == -103
                -> if {
                    true => contains!
                } else {
                    candidate.operand0 != nodeIndex -> if {
                        candidate.operand0 -> nodeContainsReadIntAt(depth + 1, context, state) => contains!
                    }
                    not contains! and candidate.operand1 != nodeIndex
                        -> if {
                            candidate.operand1 -> nodeContainsReadIntAt(depth + 1, context, state) => contains!
                        }
                }
        }
    contains!
}
nodeContainsReadInt rootIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    rootIndex -> nodeContainsReadIntAt(0, context, state)
}
integerComparisonOperation expression: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Text {
    context.ir[expression.operand0] => operand
    operand -> integerNodeSigned(context, state) => signed
    expression.opcode == grammar.tokenIdLess() -> if {
        signed -> if { "icmp slt" } else { "icmp ult" }
    } else {
        expression.opcode == grammar.tokenIdLessEqual()
            -> if {
                signed -> if { "icmp sle" } else { "icmp ule" }
            } else {
                expression.opcode == grammar.tokenIdGreater()
                    -> if {
                        signed -> if { "icmp sgt" } else { "icmp ugt" }
                    } else {
                        signed -> if { "icmp sge" } else { "icmp uge" }
                    }
            }
    }
}
integerQuotientOperation expression: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Text {
    expression -> integerNodeWidth(context, state) => resultWidth
    resultWidth > 0 -> if { expression } else { context.ir[expression.operand0] } => operand
    operand -> integerNodeSigned(context, state)
        -> if { "sdiv" } else { "udiv" }
}
integerRemainderOperation expression: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Text {
    expression -> integerNodeWidth(context, state) => resultWidth
    resultWidth > 0 -> if { expression } else { context.ir[expression.operand0] } => operand
    operand -> integerNodeSigned(context, state)
        -> if { "srem" } else { "urem" }
}
legacyStorageAlign symbol: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    4 => result!
    symbol == 1 or symbol == 16 or symbol == 17 or symbol == 18
        -> if { 8 => result! }
    symbol == 3 or symbol == 8 or symbol == 23 -> if { 1 => result! }
    # SourceText contains i64 length fields and therefore keeps 8-byte ABI
    # alignment even when the target pointer width is 32 bits.
    symbol == 24 -> if { 8 => result! }
    symbol == 4 or symbol == 9 -> if { 2 => result! }
    symbol == 6 or symbol == 7 or symbol == 11 or symbol == 12 or symbol == 13 or symbol == 21 or symbol == 22
        -> if { 8 => result! }
    result! => selected
    selected
}
storageAlign node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    node.typeOrigin == 16 -> if { context.pointerBitWidth / 8 } else {
        node -> effectiveTypeId(context, state) => typeId
        typeId >= 0 -> if {
            typeId -> isNominalEnumType(context, state) -> if { 8 } else {
                context.typeLayoutStatuses[typeId] == 0 -> if { context.typeAligns[typeId] } else { 1 }
            }
        } else {
            node.typeSymbol -> legacyStorageAlign(context, state)
        }
    }
}
enumVariantTag node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext -> Int {
    node.typeId < 0 or node.typeId >= (context.types -> len)
        -> if { -1 -> return }
    context.types[node.typeId] => enumType
    enumType.status != 0 -> if { -1 -> return }
    -1 => tag!
    # Nominal identity owns the tag, even when the type's name is a builtin
    # variant spelling. The payload token of a direct call names its qualifier.
    (enumType.kind == 1 or enumType.kind == 7)
        and (enumType.origin == 0 or enumType.origin == 2)
        and node.targetModule >= 0 and node.targetModule < (context.ranges -> len)
        and enumType.module == node.targetModule
        -> if {
            context.ranges[node.targetModule] => targetVariantRange
            node.symbol >= 0 and node.symbol < targetVariantRange.symbolCount
                -> if {
                    context.symbols[targetVariantRange.symbolStart + node.symbol] => variantSymbol
                    variantSymbol.kind == 27 and variantSymbol.parent >= 0
                        and variantSymbol.parent < targetVariantRange.symbolCount
                        and enumType.symbol == variantSymbol.parent
                        and context.symbols[targetVariantRange.symbolStart + variantSymbol.parent].kind == 4
                        -> if {
                            0 => variantOrdinal!
                            0 => variantSymbolIndex!
                            variantSymbolIndex! < node.symbol -> while {
                                context.symbols[targetVariantRange.symbolStart + variantSymbolIndex!] => siblingVariant
                                siblingVariant.kind == 27 and siblingVariant.parent == variantSymbol.parent
                                    -> if { variantOrdinal! + 1 => variantOrdinal! }
                                variantSymbolIndex! + 1 => variantSymbolIndex!
                            }
                            variantOrdinal! => tag!
                        }
                }
        }
    # Only canonical Option and Result constructors use token spelling.
    enumType.kind == 7 and enumType.origin == 4
        and (enumType.symbol == 0 or enumType.symbol == 1)
        and node.sourceModule >= 0 and node.sourceModule < (context.ranges -> len)
        -> if {
            context.ranges[node.sourceModule] => variantRange
            node.payloadToken >= 0 and node.payloadToken < variantRange.tokenCount
                -> if {
                    context.tokens[variantRange.tokenStart + node.payloadToken] => variantToken
                    enumType.symbol == 1 and variantToken.span.length == 2
                        -> if {
                            context.sources[node.sourceModule] -> byte(variantToken.span.start) => first
                            context.sources[node.sourceModule] -> byte(variantToken.span.start + 1) => second
                            first == 79 and second == 107 -> if { 0 => tag! }
                        }
                    enumType.symbol == 1 and variantToken.span.length == 3
                        -> if {
                            context.sources[node.sourceModule] -> byte(variantToken.span.start) => first
                            context.sources[node.sourceModule] -> byte(variantToken.span.start + 1) => second
                            context.sources[node.sourceModule] -> byte(variantToken.span.start + 2) => third
                            first == 69 and second == 114 and third == 114
                                -> if { 1 => tag! }
                        }
                    enumType.symbol == 0 and variantToken.span.length == 4
                        -> if {
                            context.sources[node.sourceModule] -> byte(variantToken.span.start) => first
                            context.sources[node.sourceModule] -> byte(variantToken.span.start + 1) => second
                            context.sources[node.sourceModule] -> byte(variantToken.span.start + 2) => third
                            context.sources[node.sourceModule] -> byte(variantToken.span.start + 3) => fourth
                            first == 78 and second == 111 and third == 110 and fourth == 101
                                -> if { 0 => tag! }
                            first == 83 and second == 111 and third == 109 and fourth == 101
                                -> if { 1 => tag! }
                        }
                }
        }
    tag!
}
