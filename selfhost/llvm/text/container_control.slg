# Responsibility fragment extracted from emitCore. State is passed by readonly
# reference, preserving the original direct-call and allocation behavior.
# Integer indexes consume the referenced value; forwarding a reference argument
# remains an address operation in writeWhileValue and the call-argument helpers.
emitWhileIntegerIndexRead request: WhileValueRequest, indexValue: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int uses Console, Process {
    context.ir[indexValue] -> scalarReferenceValueTypeId(context, state) => readTypeId
    readTypeId < 0 -> if { -1 -> return }
    "  %while$(request.whileIndex -> valueNameId(state))_v$(request.nodeIndex -> valueNameId(state))_index_value = load " -> print
    readTypeId -> writeAggregateFieldTypeId(context, state)
    ", ptr " -> print
    WhileValueRequest { whileIndex: request.whileIndex, ownerIndex: request.ownerIndex, nodeIndex: indexValue } -> writeWhileValue(context, state)
    ", align " -> print
    context.typeAligns[readTypeId] -> writeDecimalLine
    readTypeId
}

writeWhileIntegerIndexValue request: WhileValueRequest, indexValue: Int, readTypeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    readTypeId >= 0 -> if {
        "%while$(request.whileIndex -> valueNameId(state))_v$(request.nodeIndex -> valueNameId(state))_index_value" -> print
    } else {
        WhileValueRequest { whileIndex: request.whileIndex, ownerIndex: request.ownerIndex, nodeIndex: indexValue } -> writeWhileValue(context, state)
    }
}

writeWhileValue request: WhileValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    request.nodeIndex < 0 or request.nodeIndex >= (context.ir -> len)
        or request.ownerIndex >= (context.ir -> len)
        -> if {
            "sollang compiler verification failure V007: while value request escaped canonical Typed IR bounds (while $(request.whileIndex), owner $(request.ownerIndex), node $(request.nodeIndex), irCount $(context.ir -> len)); this is a compiler-integrity defect, not a source error; repair the producer operand or owner edge before LLVM emission" -> runtime.eprintln
            "; sollang compiler verification failure V007: while value request escaped canonical Typed IR bounds (while $(request.whileIndex), owner $(request.ownerIndex), node $(request.nodeIndex), irCount $(context.ir -> len)); repair the producer operand or owner edge before LLVM emission" -> println
        } else {
            context.ir[request.nodeIndex] => value
            value -> isUserBlockScope -> if {
                request.nodeIndex -> aggregateValueIndex(context, state) -> writeValue(request.ownerIndex, context, state)
                return
            }
            value.kind == 29 -> if {
                "%v$(request.nodeIndex -> valueNameId(state))" -> print
            } else {
                value.kind == 2 -> if {
                    value -> sourceToken(context, state) => whileTextToken
                    Int(TextLiteralRequest { sourceModule: value.sourceModule, token: whileTextToken } -> textLiteralLength(context, state)) => whileTextLength
                    "{ ptr @sollang_str_$(request.nodeIndex -> stringGlobalName(state)), i64 $whileTextLength }" -> print
                } else {
                    value.kind == 3 or value.kind == 4 -> if {
                        value -> sourceToken(context, state) => valueToken
                        value.kind == 3 -> if {
                            value -> writeIntegerLiteral(context, state)
                        } else {
                            (context.sources[value.sourceModule] -> byte(valueToken.span.start)) == 116
                                -> if { "1" -> print } else { "0" -> print }
                        }
                    } else {
                        value.kind == 5
                            and value.operand0 >= 0
                            and value.operand0 < (context.ir -> len)
                            and context.ir[value.operand0].kind == 29 -> if {
                                "%v$(value.operand0 -> valueNameId(state))" -> print
                            } else {
                                -1 => whileParameterOrdinal!
                                request.ownerIndex >= 0
                                    and context.ir[request.ownerIndex].kind == 0
                                    and context.ir[request.ownerIndex].operand1 >= 0
                                    and (value.kind == 5 or value.kind == 10) -> if {
                                        value.symbol == context.ir[context.ir[request.ownerIndex].operand1].symbol
                                            -> if { 0 => whileParameterOrdinal! } else {
                                                request.ownerIndex -> additionalParameterOrdinal(value.symbol, context, state) => whileParameterOrdinal!
                                            }
                                    }
                                whileParameterOrdinal! >= 0 -> if {
                                    request.nodeIndex -> mutableBorrowParameterOrdinal(request.ownerIndex, context, state) => mutableWhileParameterOrdinal
                                    mutableWhileParameterOrdinal >= 0 -> if {
                                        "%while$(request.whileIndex -> valueNameId(state))_v$(request.nodeIndex -> valueNameId(state))" -> print
                                    } else {
                                        whileParameterOrdinal! == 0 -> if { "%arg" -> print } else { "%arg$(whileParameterOrdinal!)" -> print }
                                    }
                                } else {
                                    false => capturedWhileValue!
                                    request.ownerIndex >= 0 and context.ir[request.ownerIndex].kind == 0 and value.kind == 5 and value.operand0 < 0
                                        -> if {
                                            request.ownerIndex -> functionCaptures(context, state) => whileOwnerCaptures
                                            0 => whileOwnerCaptureIndex!
                                            whileOwnerCaptureIndex! < (whileOwnerCaptures -> len)
                                                -> while {
                                                    context.ir[whileOwnerCaptures[whileOwnerCaptureIndex!]].symbol == value.symbol
                                                        -> if { true => capturedWhileValue! }
                                                    whileOwnerCaptureIndex! + 1 => whileOwnerCaptureIndex!
                                                }
                                            context.ir[request.ownerIndex] => whileOwnerFunction
                                            context.ranges[whileOwnerFunction.sourceModule] => whileOwnerRange
                                            context.symbols[whileOwnerRange.symbolStart + whileOwnerFunction.symbol] => whileOwnerSymbol
                                            whileOwnerSymbol.parent >= 0 -> if {
                                                whileOwnerRange.symbolStart + whileOwnerSymbol.parent => whileParentGlobalSymbol
                                                -1 => whileParentFunction!
                                                whileParentGlobalSymbol >= 0 and whileParentGlobalSymbol < (state.frozenCaptureFunctionsBySymbol -> len)
                                                    -> if { state.frozenCaptureFunctionsBySymbol[whileParentGlobalSymbol] => whileParentFunction! }
                                                whileParentFunction! >= 0 -> if {
                                                    context.ir[whileParentFunction!] => whileParentCandidate
                                                    whileParentCandidate.operand1 >= 0 and context.ir[whileParentCandidate.operand1].symbol == value.symbol
                                                        -> if {
                                                            true => capturedWhileValue!
                                                        }
                                                }
                                            }
                                        }
                                    request.nodeIndex -> eachRoleOwner(context) => whileEachRoleOwner
                                    request.nodeIndex -> structuredParallelRoleOwner(context) => whileParallelRoleOwner
                                    value.kind == 12 or value.kind == 26 or value.kind == 27
                                        or value.kind == 33 or value.kind == 34 or value.kind == 35
                                        or (value.kind == 8 and (value.opcode == -24 or value.opcode == -25))
                                        -> if {
                                            "%v$(request.nodeIndex -> valueNameId(state))" -> print
                                        } else {
                                            capturedWhileValue! or whileEachRoleOwner >= 0 or whileParallelRoleOwner >= 0
                                                -> if { "%v$(request.nodeIndex -> valueNameId(state))" -> print } else { "%while$(request.whileIndex -> valueNameId(state))_v$(request.nodeIndex -> valueNameId(state))" -> print }
                                        }
                                }
                            }
                    }
                }
            }
        }
}

emitWhileCurrentMutableParameterValue whileIndex: Int, valueIndex: Int, parameterOrdinal: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[valueIndex] => value
    context -> parameterIndexAtOrdinal(ownerIndex, parameterOrdinal) => parameterIndex
    parameterIndex >= 0 and (context.ir[parameterIndex] -> mutableBorrowUsesStructPointer(context))
        -> if {
            context.ir[parameterIndex] -> effectiveTypeId(context, state) => mutableParameterTypeId
            mutableParameterTypeId >= 0
                and context.types[mutableParameterTypeId].kind == 4
                and context.types[mutableParameterTypeId].length >= 0
                -> if {
                    "  %while$(whileIndex -> valueNameId(state))_v$(valueIndex -> valueNameId(state)) = insertvalue %sollang.int_slice " -> print
                    parameterOrdinal == 0 -> if { "%arg" -> print } else { "%arg$(parameterOrdinal)" -> print }
                    ", i64 $(context.types[mutableParameterTypeId].length), 1" -> println
                } else {
                    "  %while$(whileIndex -> valueNameId(state))_v$(valueIndex -> valueNameId(state)) = load " -> print
                    value -> writeIrType(context, state)
                    ", ptr " -> print
                    parameterOrdinal -> writeMutableStructParameterPointer
                    ", align " -> print
                    value -> storageAlign(context, state) -> writeDecimalLine
                }
        } else {
            "  %while$(whileIndex -> valueNameId(state))_v$(valueIndex -> valueNameId(state))_current_ptr = load ptr, ptr " -> print
            parameterOrdinal == 0 -> if { "%arg_mut_ptr_addr" -> print } else { "%arg$(parameterOrdinal)_mut_ptr_addr" -> print }
            ", align 8" -> println
            "  %while$(whileIndex -> valueNameId(state))_v$(valueIndex -> valueNameId(state))_current_len = load i64, ptr " -> print
            parameterOrdinal == 0 -> if { "%arg_mut_len_addr" -> print } else { "%arg$(parameterOrdinal)_mut_len_addr" -> print }
            ", align 8" -> println
            "  %while$(whileIndex -> valueNameId(state))_v$(valueIndex -> valueNameId(state))_current_capacity = load i64, ptr " -> print
            parameterOrdinal == 0 -> if { "%arg_mut_capacity_addr" -> print } else { "%arg$(parameterOrdinal)_mut_capacity_addr" -> print }
            ", align 8" -> println
            "  %while$(whileIndex -> valueNameId(state))_v$(valueIndex -> valueNameId(state))_current0 = insertvalue " -> print
            value -> writeIrType(context, state)
            " poison, ptr %while$(whileIndex -> valueNameId(state))_v$(valueIndex -> valueNameId(state))_current_ptr, 0" -> println
            "  %while$(whileIndex -> valueNameId(state))_v$(valueIndex -> valueNameId(state))_current1 = insertvalue " -> print
            value -> writeIrType(context, state)
            " %while$(whileIndex -> valueNameId(state))_v$(valueIndex -> valueNameId(state))_current0, i64 %while$(whileIndex -> valueNameId(state))_v$(valueIndex -> valueNameId(state))_current_len, 1" -> println
            "  %while$(whileIndex -> valueNameId(state))_v$(valueIndex -> valueNameId(state)) = insertvalue " -> print
            value -> writeIrType(context, state)
            " %while$(whileIndex -> valueNameId(state))_v$(valueIndex -> valueNameId(state))_current1, i64 %while$(whileIndex -> valueNameId(state))_v$(valueIndex -> valueNameId(state))_current_capacity, 2" -> println
        }
}
emitBoundedDictionaryIndexAssignment request: WhileValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[request.nodeIndex] => assignment
    request.nodeIndex -> mutableBindingRoot(context, state) => assignmentRoot
    context.ir[assignmentRoot] => assignmentBinding
    assignment.operand0 -> aggregateValueIndex(context, state) => valueIndex
    assignmentBinding -> boundedDictionaryValueTypeId(context) => dictionaryTypeId
    context.types[dictionaryTypeId] => dictionaryType
    dictionaryType.first => keyTypeId
    dictionaryType.second => valueTypeId
    dictionaryTypeId -> boundedDictionaryLayoutForType(context) => layout
    Arena(0) => prefixStorage!
    "bassign$(request.nodeIndex)" -> materialize(prefixStorage!) => prefix
    "  %$(prefix)_owner = getelementptr i8, ptr " -> print
    assignmentRoot -> writeMutableStoragePointer(request.ownerIndex, context, state)
    ", i64 0" -> println
    prefix -> emitBoundedDictionaryStoragePointer("%$(prefix)_owner", dictionaryTypeId)
    "  %$(prefix)_query = freeze " -> print
    keyTypeId -> writeSemanticTypeId(context, state)
    " " -> print
    assignment.operand1 -> writeValue(request.ownerIndex, context, state)
    "" -> println
    "$(prefix)_find" -> emitBoundedDictionaryFindRequiredSlot("%$(prefix)_storage", "%$(prefix)_query", dictionaryTypeId, false, context, state)
    "$(prefix)_value" -> emitBoundedDictionaryEntryPointer("%$(prefix)_storage", "%$(prefix)_find_slot", layout.valueOffset, layout)
    valueTypeId -> semanticTypeOwns(context, state)
        -> if {
            "  %$(prefix)_old_value = load " -> print
            valueTypeId -> writeSemanticTypeId(context, state)
            ", ptr %$(prefix)_value_ptr, align $(layout.valueAlign)" -> println
            "  call void @sollang_drop_t$(valueTypeId)(" -> print
            valueTypeId -> writeSemanticTypeId(context, state)
            " %$(prefix)_old_value)" -> println
        }
    "  store " -> print
    valueTypeId -> writeSemanticTypeId(context, state)
    " " -> print
    valueIndex -> writeValue(request.ownerIndex, context, state)
    ", ptr %$(prefix)_value_ptr, align $(layout.valueAlign)" -> println
}

emitIndexAssignment request: WhileValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[request.nodeIndex] => assignment
    assignment.operand0 >= 0 -> if {
        assignment.operand1 >= 0 -> if {
            request.nodeIndex -> mutableBindingRoot(context, state) => assignmentRoot
            context.ir[assignmentRoot] => assignmentBinding
            assignment.operand0 -> aggregateValueIndex(context, state) => assignmentValueIndex
            context.ir[assignmentValueIndex] => assignmentValue
            context.ir[assignment.operand1] => assignmentIndex
            (assignmentBinding -> boundedDictionaryValueTypeId(context)) >= 0
                -> if {
                    request -> emitBoundedDictionaryIndexAssignment(context, state)
                    return
                }
            assignmentBinding -> isDictionaryType -> if {
                -1 => assignmentKeyTypeId!
                -1 => assignmentValueTypeId!
                assignmentBinding.typeId >= 0 -> if {
                    context.types[assignmentBinding.typeId] => assignmentDictionaryType
                    assignmentDictionaryType.kind == 5 or assignmentDictionaryType.kind == 13
                        -> if {
                            assignmentDictionaryType.first => assignmentKeyTypeId!
                            assignmentDictionaryType.second => assignmentValueTypeId!
                        }
                }
                "  %assign$(request.nodeIndex -> valueNameId(state))_dictionary = load %sollang.int_dictionary, ptr " -> print
                assignmentRoot -> writeMutableStoragePointer(request.ownerIndex, context, state)
                ", align 8" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_storage = extractvalue %sollang.int_dictionary %assign$(request.nodeIndex -> valueNameId(state))_dictionary, 0" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_length = extractvalue %sollang.int_dictionary %assign$(request.nodeIndex -> valueNameId(state))_dictionary, 1" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_capacity = extractvalue %sollang.int_dictionary %assign$(request.nodeIndex -> valueNameId(state))_dictionary, 2" -> println
                -1 => assignmentKeyStorageSize!
                assignmentKeyTypeId! >= 0 -> if { context.typeSizes[assignmentKeyTypeId!] => assignmentKeyStorageSize! }
                assignmentKeyStorageSize! < 0 -> if { assignmentBinding.typeModule -> storageSize(context, state) => assignmentKeyStorageSize! }
                false => assignmentKeyIsText!
                -1 => assignmentHashMethod!
                -1 => assignmentEqMethod!
                assignmentKeyTypeId! >= 0 -> if {
                    context.types[assignmentKeyTypeId!] => assignmentCanonicalKeyType
                    assignmentCanonicalKeyType.kind == 1 and assignmentCanonicalKeyType.origin == 1 and assignmentCanonicalKeyType.symbol == 1
                        -> if { true => assignmentKeyIsText! }
                    assignmentKeyTypeId! -> traitMethodSymbol("Hash", "hash", context, state) => assignmentHashMethod!
                    assignmentKeyTypeId! -> traitMethodSymbol("Eq", "eq", context, state) => assignmentEqMethod!
                }
                (assignmentHashMethod! >= 0 and assignmentEqMethod! >= 0) => assignmentKeyIsNominal
                assignmentKeyStorageSize! == 1 -> if {
                    assignmentKeyTypeId! >= 0 -> if { context.types[assignmentKeyTypeId!].symbol -> integerWidth(context, state) } else { -1 }
                } else {
                    assignmentKeyStorageSize! == 2 -> if { 16 } else {
                        assignmentKeyStorageSize! == 4 -> if { 32 } else {
                            assignmentKeyStorageSize! == 8 -> if { 64 } else { -1 }
                        }
                    }
                } => assignmentHashWidth
                false => assignmentHashSigned!
                assignmentKeyTypeId! >= 0 -> if { context.types[assignmentKeyTypeId!].symbol -> integerSigned(context, state) => assignmentHashSigned! }
                "  %assign$(request.nodeIndex -> valueNameId(state))_query = freeze " -> print
                assignmentKeyTypeId! >= 0 -> if { assignmentKeyTypeId! -> writeSemanticTypeId(context, state) } else { assignmentBinding.typeModule -> llvmType(context, state) -> print }
                " " -> print
                assignment.operand1 -> writeValue(request.ownerIndex, context, state)
                "" -> println
                "assign$(request.nodeIndex -> valueNameId(state))_lookup" -> emitSetHashValue(
                "%assign$(request.nodeIndex -> valueNameId(state))_query",
                assignmentKeyTypeId!,
                assignmentHashMethod!,
                assignmentKeyIsText!,
                assignmentKeyIsNominal,
                assignmentHashWidth,
                assignmentHashSigned!,
                context,
                state)
                "  %assign$(request.nodeIndex -> valueNameId(state))_h2_shifted = lshr i64 %assign$(request.nodeIndex -> valueNameId(state))_lookup_hash, 57" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_h2_raw = and i64 %assign$(request.nodeIndex -> valueNameId(state))_h2_shifted, 127" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_h2_zero = icmp eq i64 %assign$(request.nodeIndex -> valueNameId(state))_h2_raw, 0" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_h2_value = select i1 %assign$(request.nodeIndex -> valueNameId(state))_h2_zero, i64 1, i64 %assign$(request.nodeIndex -> valueNameId(state))_h2_raw" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_h2 = trunc i64 %assign$(request.nodeIndex -> valueNameId(state))_h2_value to i8" -> println
                assignmentKeyTypeId! -> dictionaryEntryLayoutForTypeIds(assignmentValueTypeId!, assignmentBinding.typeModule, assignmentBinding.typeSymbol, context, state) => assignmentEntryLayout
                "assign$(request.nodeIndex -> valueNameId(state))" -> emitGrowableDictionaryPointers("%assign$(request.nodeIndex -> valueNameId(state))_storage", "%assign$(request.nodeIndex -> valueNameId(state))_capacity", assignmentEntryLayout)
                "  %assign$(request.nodeIndex -> valueNameId(state))_has_capacity = icmp ugt i64 %assign$(request.nodeIndex -> valueNameId(state))_capacity, 0" -> println
                "  br i1 %assign$(request.nodeIndex -> valueNameId(state))_has_capacity, label %assign$(request.nodeIndex -> valueNameId(state))_find_start, label %assign$(request.nodeIndex -> valueNameId(state))_missing" -> println
                "assign$(request.nodeIndex -> valueNameId(state))_find_start:" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_start_slot = urem i64 %assign$(request.nodeIndex -> valueNameId(state))_lookup_hash, %assign$(request.nodeIndex -> valueNameId(state))_capacity" -> println
                "  br label %assign$(request.nodeIndex -> valueNameId(state))_find" -> println
                "assign$(request.nodeIndex -> valueNameId(state))_find:" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_find_slot = phi i64 [ %assign$(request.nodeIndex -> valueNameId(state))_start_slot, %assign$(request.nodeIndex -> valueNameId(state))_find_start ], [ %assign$(request.nodeIndex -> valueNameId(state))_find_next, %assign$(request.nodeIndex -> valueNameId(state))_find_advance ]" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_find_probe = phi i64 [ 0, %assign$(request.nodeIndex -> valueNameId(state))_find_start ], [ %assign$(request.nodeIndex -> valueNameId(state))_find_probe_next, %assign$(request.nodeIndex -> valueNameId(state))_find_advance ]" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_find_active = icmp ult i64 %assign$(request.nodeIndex -> valueNameId(state))_find_probe, %assign$(request.nodeIndex -> valueNameId(state))_capacity" -> println
                "  br i1 %assign$(request.nodeIndex -> valueNameId(state))_find_active, label %assign$(request.nodeIndex -> valueNameId(state))_find_check, label %assign$(request.nodeIndex -> valueNameId(state))_missing" -> println
                "assign$(request.nodeIndex -> valueNameId(state))_find_check:" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_control_ptr = getelementptr i8, ptr %assign$(request.nodeIndex -> valueNameId(state))_controls, i64 %assign$(request.nodeIndex -> valueNameId(state))_find_slot" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_control = load i8, ptr %assign$(request.nodeIndex -> valueNameId(state))_control_ptr, align 1" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_empty = icmp eq i8 %assign$(request.nodeIndex -> valueNameId(state))_control, 0" -> println
                "  br i1 %assign$(request.nodeIndex -> valueNameId(state))_empty, label %assign$(request.nodeIndex -> valueNameId(state))_missing, label %assign$(request.nodeIndex -> valueNameId(state))_h2_check" -> println
                "assign$(request.nodeIndex -> valueNameId(state))_h2_check:" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_h2_match = icmp eq i8 %assign$(request.nodeIndex -> valueNameId(state))_control, %assign$(request.nodeIndex -> valueNameId(state))_h2" -> println
                "  br i1 %assign$(request.nodeIndex -> valueNameId(state))_h2_match, label %assign$(request.nodeIndex -> valueNameId(state))_key_check, label %assign$(request.nodeIndex -> valueNameId(state))_find_advance" -> println
                "assign$(request.nodeIndex -> valueNameId(state))_key_check:" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_key_ptr = getelementptr " -> print
                assignmentEntryLayout -> writeDictionaryEntryStorageType
                ", ptr %assign$(request.nodeIndex -> valueNameId(state))_keys, i64 %assign$(request.nodeIndex -> valueNameId(state))_find_slot" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_key = load " -> print
                assignmentKeyTypeId! >= 0 -> if { assignmentKeyTypeId! -> writeSemanticTypeId(context, state) } else { assignmentBinding.typeModule -> llvmType(context, state) -> print }
                ", ptr %assign$(request.nodeIndex -> valueNameId(state))_key_ptr, align " -> print
                assignmentKeyTypeId! >= 0 -> if { context.typeAligns[assignmentKeyTypeId!] -> writeDecimalLine } else { assignmentBinding.typeModule -> legacyStorageAlign(context, state) -> writeDecimalLine }
                "assign$(request.nodeIndex -> valueNameId(state))_lookup" -> emitSetEquality(
                "%assign$(request.nodeIndex -> valueNameId(state))_key",
                "%assign$(request.nodeIndex -> valueNameId(state))_query",
                assignmentKeyTypeId!,
                assignmentEqMethod!,
                assignmentKeyIsText!,
                assignmentKeyIsNominal,
                context,
                state)
                "  br i1 %assign$(request.nodeIndex -> valueNameId(state))_lookup_equal, label %assign$(request.nodeIndex -> valueNameId(state))_hit, label %assign$(request.nodeIndex -> valueNameId(state))_find_advance" -> println
                "assign$(request.nodeIndex -> valueNameId(state))_find_advance:" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_find_next_unwrapped = add i64 %assign$(request.nodeIndex -> valueNameId(state))_find_slot, 1" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_find_next = urem i64 %assign$(request.nodeIndex -> valueNameId(state))_find_next_unwrapped, %assign$(request.nodeIndex -> valueNameId(state))_capacity" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_find_probe_next = add i64 %assign$(request.nodeIndex -> valueNameId(state))_find_probe, 1" -> println
                "  br label %assign$(request.nodeIndex -> valueNameId(state))_find" -> println
                "assign$(request.nodeIndex -> valueNameId(state))_missing:" -> println
                "  call void @llvm.trap()" -> println
                "  unreachable" -> println
                "assign$(request.nodeIndex -> valueNameId(state))_hit:" -> println
                "  %assign$(request.nodeIndex -> valueNameId(state))_value_ptr = getelementptr " -> print
                assignmentEntryLayout -> writeDictionaryEntryStorageType
                ", ptr %assign$(request.nodeIndex -> valueNameId(state))_values, i64 %assign$(request.nodeIndex -> valueNameId(state))_find_slot" -> println
                assignmentValueTypeId! >= 0 and (assignmentValueTypeId! -> semanticTypeOwns(context, state))
                    -> if {
                        "  %assign$(request.nodeIndex -> valueNameId(state))_previous = load " -> print
                        assignmentValueTypeId! -> writeSemanticTypeId(context, state)
                        ", ptr %assign$(request.nodeIndex -> valueNameId(state))_value_ptr, align " -> print
                        context.typeAligns[assignmentValueTypeId!] -> writeDecimalLine
                        "  call void @sollang_drop_t$(assignmentValueTypeId!)(" -> print
                        assignmentValueTypeId! -> writeSemanticTypeId(context, state)
                        " %assign$(request.nodeIndex -> valueNameId(state))_previous)" -> println
                    }
                "  store " -> print
                assignmentValueTypeId! >= 0 -> if { assignmentValueTypeId! -> writeSemanticTypeId(context, state) } else { assignmentBinding.typeSymbol -> llvmType(context, state) -> print }
                " " -> print
                assignmentValue.kind == 3 or assignmentValue.kind == 4
                    -> if {
                        assignmentValue -> sourceToken(context, state) => assignmentDictionaryValueToken
                        assignmentValue.kind == 3 -> if {
                            assignmentValue -> writeIntegerLiteral(context, state)
                        } else {
                            (context.sources[assignmentValue.sourceModule] -> byte(assignmentDictionaryValueToken.span.start)) == 116
                                -> if { "1" -> print } else { "0" -> print }
                        }
                    } else {
                        request.ownerIndex >= 0 and context.ir[request.ownerIndex].kind == 0 and context.ir[request.ownerIndex].operand1 >= 0 and assignmentValue.kind == 5 and assignmentValue.symbol == context.ir[context.ir[request.ownerIndex].operand1].symbol
                            -> if { "%arg" -> print } else { "%v$(assignmentValueIndex -> valueNameId(state))" -> print }
                    }
                ", ptr %assign$(request.nodeIndex -> valueNameId(state))_value_ptr, align " -> print
                assignmentValueTypeId! >= 0 -> if { context.typeAligns[assignmentValueTypeId!] -> writeDecimalLine } else { assignmentBinding.typeSymbol -> legacyStorageAlign(context, state) -> writeDecimalLine }
                "  br label %assign$(request.nodeIndex -> valueNameId(state))_done" -> println
                "assign$(request.nodeIndex -> valueNameId(state))_done:" -> println
            } else {
                assignmentBinding -> arrayElementTypeId(context, state) => assignmentTargetElementTypeId
                assignmentTargetElementTypeId < 0 -> if {
                    "; sollang compiler error S032: index assignment target has no canonical array element type at ir $(request.nodeIndex) (root $assignmentRoot, bindingType $(assignmentBinding.typeId), value $(assignment.operand0), index $(assignment.operand1))" -> println
                    process.exit(1)
                    return
                }
                assignmentBinding.kind == 10 -> if {
                    -1 => assignmentParameterOrdinal!
                    request.ownerIndex >= 0 and context.ir[request.ownerIndex].kind == 0 and context.ir[request.ownerIndex].operand1 >= 0 and context.ir[context.ir[request.ownerIndex].operand1].symbol == assignmentBinding.symbol
                        -> if {
                            0 => assignmentParameterOrdinal!
                        } else {
                            request.ownerIndex -> additionalParameterOrdinal(assignmentBinding.symbol, context, state) => assignmentParameterOrdinal!
                        }
                    assignmentBinding.flags / 2 % 2 == 1 -> if {
                        assignmentBinding -> mutableBorrowUsesStructPointer(context)
                            -> if {
                                "  %assign$(request.nodeIndex -> valueNameId(state))_data = extractvalue " -> print
                                assignmentBinding -> writeIrType(context, state)
                                " " -> print
                                assignmentParameterOrdinal! == 0 -> if { "%arg" -> print } else { "%arg$(assignmentParameterOrdinal!)" -> print }
                                ", 0" -> println
                            } else {
                                "  %assign$(request.nodeIndex -> valueNameId(state))_data = load ptr, ptr " -> print
                                assignmentParameterOrdinal! == 0 -> if { "%arg_mut_ptr_addr" -> print } else { "%arg$(assignmentParameterOrdinal!)_mut_ptr_addr" -> print }
                                ", align 8" -> println
                            }
                    } else {
                        "  %assign$(request.nodeIndex -> valueNameId(state))_data = extractvalue " -> print
                        assignmentBinding -> writeIrType(context, state)
                        " " -> print
                        assignmentParameterOrdinal! == 0 -> if { "%arg" -> print } else { "%arg$(assignmentParameterOrdinal!)" -> print }
                        ", 0" -> println
                    }
                } else {
                    "  %assign$(request.nodeIndex -> valueNameId(state))_array = load " -> print
                    assignmentBinding -> writeIrType(context, state)
                    ", ptr %slot$(assignmentRoot -> valueNameId(state)), align 8" -> println
                    "  %assign$(request.nodeIndex -> valueNameId(state))_data = extractvalue " -> print
                    assignmentBinding -> writeIrType(context, state)
                    " %assign$(request.nodeIndex -> valueNameId(state))_array, 0" -> println
                }
                assignmentIndex -> integerNodeWidth(context, state) => assignmentIndexWidth!
                assignmentIndex -> integerNodeSigned(context, state) => assignmentIndexSigned!
                assignmentIndex.kind == 5 -> if {
                    assignmentIndex -> scalarReferenceValueTypeId(context, state) => assignmentIndexReadTypeId
                    assignmentIndexReadTypeId >= 0 -> if {
                        context.types[assignmentIndexReadTypeId].symbol => assignmentIndexReadSymbol
                        assignmentIndexReadSymbol -> integerWidth(context, state) => assignmentIndexWidth!
                        assignmentIndexReadSymbol -> integerSigned(context, state) => assignmentIndexSigned!
                    }
                }
                assignmentIndexWidth! == 64 -> if {
                    "  %assign$(request.nodeIndex -> valueNameId(state))_index = add i64 0, " -> print
                    assignment.operand1 -> writeValue(request.ownerIndex, context, state)
                    "" -> println
                } else {
                    "  %assign$(request.nodeIndex -> valueNameId(state))_index = " -> print
                    assignmentIndexSigned!
                        -> if { "sext" -> print } else { "zext" -> print }
                    " i$(assignmentIndexWidth!) " -> print
                    assignment.operand1 -> writeValue(request.ownerIndex, context, state)
                    " to i64" -> println
                }
                "  %assign$(request.nodeIndex -> valueNameId(state))_ptr = getelementptr " -> print
                assignmentBinding -> writeArrayElementType(context, state)
                ", ptr %assign$(request.nodeIndex -> valueNameId(state))_data, i64 %assign$(request.nodeIndex -> valueNameId(state))_index" -> println
                false => assignmentValueIsReference!
                false => assignmentReferenceValueIsMaterialized!
                assignmentValue.typeId >= 0
                    and context.types[assignmentValue.typeId].kind == 8
                    and context.types[assignmentValue.typeId].first == assignmentTargetElementTypeId
                    -> if {
                        true => assignmentValueIsReference!
                        assignmentValueIndex -> referenceParameterValueIsMaterialized(request.ownerIndex, context, state) => assignmentReferenceValueIsMaterialized!
                        assignmentReferenceValueIsMaterialized! -> unless {
                            "  %assign$(request.nodeIndex -> valueNameId(state))_referenced_value = load " -> print
                            assignmentTargetElementTypeId -> writeSemanticTypeId(context, state)
                            ", ptr %v$(assignmentValueIndex -> valueNameId(state)), align " -> print
                            context.typeAligns[assignmentTargetElementTypeId] -> writeDecimalLine
                        }
                    }
                assignmentValue -> integerNodeWidth(context, state) => assignmentSourceWidth
                0 => assignmentTargetWidth!
                assignmentTargetElementTypeId >= 0 -> if {
                    context.types[assignmentTargetElementTypeId] => assignmentTargetElementType
                    assignmentTargetElementType.kind == 1 and assignmentTargetElementType.origin == 1
                        -> if {
                            assignmentTargetElementType.symbol -> integerWidth(context, state) => assignmentTargetWidth!
                            assignmentTargetElementType.symbol == 12 or assignmentTargetElementType.symbol == 13
                                -> if { context.pointerBitWidth => assignmentTargetWidth! }
                        }
                } else {
                    assignmentBinding -> integerNodeWidth(context, state) => assignmentTargetWidth!
                }
                (assignmentSourceWidth > 0 and assignmentTargetWidth! > 0 and assignmentSourceWidth != assignmentTargetWidth! and assignmentValue.kind != 3 and assignmentValue.kind != 4) => castAssignmentValue
                castAssignmentValue -> if {
                    "  %assign$(request.nodeIndex -> valueNameId(state))_value_cast = " -> print
                    assignmentTargetWidth! < assignmentSourceWidth
                        -> if { "trunc " -> print } else {
                            assignmentValue -> integerNodeSigned(context, state)
                                -> if { "sext " -> print } else { "zext " -> print }
                        }
                    assignmentValue -> writeIrType(context, state)
                    " " -> print
                    request.ownerIndex >= 0 and context.ir[request.ownerIndex].kind == 0 and context.ir[request.ownerIndex].operand1 >= 0 and assignmentValue.kind == 5 and assignmentValue.symbol == context.ir[context.ir[request.ownerIndex].operand1].symbol
                        -> if { "%arg" -> print } else { "%v$(assignmentValueIndex -> valueNameId(state))" -> print }
                    " to " -> print
                    assignmentBinding -> writeArrayElementType(context, state)
                    "" -> println
                }
                assignmentTargetElementTypeId >= 0 and (assignmentTargetElementTypeId -> semanticTypeOwns(context, state))
                    -> if {
                        "  %assign$(request.nodeIndex -> valueNameId(state))_previous = load " -> print
                        assignmentTargetElementTypeId -> writeSemanticTypeId(context, state)
                        ", ptr %assign$(request.nodeIndex -> valueNameId(state))_ptr, align " -> print
                        context.typeAligns[assignmentTargetElementTypeId] -> writeDecimalLine
                        "  call void @sollang_drop_t$(assignmentTargetElementTypeId)(" -> print
                        assignmentTargetElementTypeId -> writeSemanticTypeId(context, state)
                        " %assign$(request.nodeIndex -> valueNameId(state))_previous)" -> println
                    }
                "  store " -> print
                assignmentBinding -> writeArrayElementType(context, state)
                " " -> print
                assignmentValue.kind == 3 or assignmentValue.kind == 4
                    -> if {
                        assignmentValue -> sourceToken(context, state) => assignmentValueToken
                        assignmentValue.kind == 3 -> if { assignmentValue -> writeIntegerLiteral(context, state) } else {
                            (context.sources[assignmentValue.sourceModule] -> byte(assignmentValueToken.span.start)) == 116
                                -> if { "1" -> print } else { "0" -> print }
                        }
                    } else {
                        assignmentValueIsReference! -> if {
                            assignmentReferenceValueIsMaterialized!
                                -> if { "%v$(assignmentValueIndex -> valueNameId(state))" -> print } else { "%assign$(request.nodeIndex -> valueNameId(state))_referenced_value" -> print }
                        } else {
                            castAssignmentValue -> if { "%assign$(request.nodeIndex -> valueNameId(state))_value_cast" -> print } else {
                                request.ownerIndex >= 0 and context.ir[request.ownerIndex].kind == 0 and context.ir[request.ownerIndex].operand1 >= 0 and assignmentValue.kind == 5 and assignmentValue.symbol == context.ir[context.ir[request.ownerIndex].operand1].symbol
                                    -> if { "%arg" -> print } else { "%v$(assignmentValueIndex -> valueNameId(state))" -> print }
                            }
                        }
                    }
                ", ptr %assign$(request.nodeIndex -> valueNameId(state))_ptr, align " -> print
                assignmentBinding -> arrayElementAlign(context, state) -> writeDecimalLine
            }
        }
    }
}
emitMemberAssignment request: WhileValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[request.nodeIndex] => assignment
    assignment.operand0 >= 0 and assignment.operand1 >= 0
        -> if {
            assignment.operand1 -> mutableBindingRoot(context, state) => assignmentRoot
            context.ir[assignmentRoot] => assignmentBinding
            assignment.operand0 -> aggregateValueIndex(context, state) => assignmentValueIndex
            context.ir[assignmentValueIndex] => assignmentValue
            assignmentBinding.typeModule => assignmentOwnerSource!
            assignmentBinding.typeOrigin == 2 -> if {
                context.modules[assignmentBinding.typeModule].sourceIndex => assignmentOwnerSource!
            }
            context.ranges[assignmentOwnerSource!] => assignmentOwnerRange
            assignment -> sourceNode(context, state) => assignmentAst
            context.tokens[context.ranges[assignment.sourceModule].tokenStart + assignmentAst.secondaryToken] => assignmentMemberName
            -1 => assignmentFieldOrdinal!
            0 => assignmentCandidateOrdinal!
            0 => assignmentFieldSearch!
            assignmentFieldSearch! < assignmentOwnerRange.symbolCount
                -> while {
                    context.symbols[assignmentOwnerRange.symbolStart + assignmentFieldSearch!] => assignmentField
                    assignmentField.kind == 26 and assignmentField.parent == assignmentBinding.typeSymbol
                        -> if {
                            context.tokens[assignmentOwnerRange.tokenStart + assignmentField.nameToken] => assignmentFieldName
                            assignmentMemberName.span.length == assignmentFieldName.span.length => assignmentFieldEqual!
                            UIntSize(0) => assignmentFieldByte!
                            assignmentFieldEqual! and assignmentFieldByte! < assignmentMemberName.span.length
                                -> while {
                                    context.sources[assignment.sourceModule] -> byte(assignmentMemberName.span.start + assignmentFieldByte!) => assignmentMemberByte
                                    context.sources[assignmentOwnerSource!] -> byte(assignmentFieldName.span.start + assignmentFieldByte!) => assignmentFieldNameByte
                                    assignmentMemberByte != assignmentFieldNameByte
                                        -> if { false => assignmentFieldEqual! }
                                    assignmentFieldByte! + 1 => assignmentFieldByte!
                                }
                            assignmentFieldEqual! -> if { assignmentCandidateOrdinal! => assignmentFieldOrdinal! }
                            assignmentCandidateOrdinal! + 1 => assignmentCandidateOrdinal!
                        }
                    assignmentFieldSearch! + 1 => assignmentFieldSearch!
                }
            assignmentFieldOrdinal! >= 0 -> if {
                assignmentBinding.typeId => assignmentOwnerTypeId!
                0 => assignmentOwnerTypeSearch!
                assignmentOwnerTypeSearch! < (context.types -> len)
                    -> while {
                        context.types[assignmentOwnerTypeSearch!] => assignmentOwnerTypeCandidate
                        assignmentOwnerTypeCandidate.status == 0 and assignmentOwnerTypeCandidate.kind == 1 and assignmentOwnerTypeCandidate.origin == assignmentBinding.typeOrigin and assignmentOwnerTypeCandidate.module == assignmentBinding.typeModule and assignmentOwnerTypeCandidate.symbol == assignmentBinding.typeSymbol
                            -> if { assignmentOwnerTypeSearch! => assignmentOwnerTypeId! }
                        assignmentOwnerTypeSearch! + 1 => assignmentOwnerTypeSearch!
                    }
                -1 => assignmentTargetFieldTypeId!
                0 => assignmentTargetFieldOrdinal!
                0 => assignmentTargetFieldSearch!
                assignmentTargetFieldSearch! < (context.fields -> len)
                    -> while {
                        context.fields[assignmentTargetFieldSearch!] => assignmentTargetField
                        assignmentTargetField.status == 0 and assignmentTargetField.ownerType == assignmentOwnerTypeId!
                            -> if {
                                assignmentTargetFieldOrdinal! == assignmentFieldOrdinal!
                                    -> if { assignmentTargetField.fieldType => assignmentTargetFieldTypeId! }
                                assignmentTargetFieldOrdinal! + 1 => assignmentTargetFieldOrdinal!
                            }
                        assignmentTargetFieldSearch! + 1 => assignmentTargetFieldSearch!
                    }
                0 => assignmentSourceWidth!
                0 => assignmentTargetWidth!
                assignmentValue.typeOrigin == 1 -> if { assignmentValue -> integerNodeWidth(context, state) => assignmentSourceWidth! }
                assignmentTargetFieldTypeId! >= 0 -> if {
                    context.types[assignmentTargetFieldTypeId!] => assignmentTargetFieldSemanticType
                    assignmentTargetFieldSemanticType.origin == 1
                        -> if {
                            assignmentTargetFieldSemanticType.symbol -> integerWidth(context, state) => assignmentTargetWidth!
                            assignmentTargetFieldSemanticType.symbol == 12 or assignmentTargetFieldSemanticType.symbol == 13
                                -> if { context.pointerBitWidth => assignmentTargetWidth! }
                        }
                }
                (assignmentSourceWidth! > 0 and assignmentTargetWidth! > 0 and assignmentSourceWidth! != assignmentTargetWidth! and assignmentValue.kind != 3 and assignmentValue.kind != 4) => castAssignmentValue
                castAssignmentValue -> if {
                    "  %member_assign$(request.nodeIndex)_value_cast = " -> print
                    assignmentTargetWidth! < assignmentSourceWidth!
                        -> if { "trunc " -> print } else {
                            assignmentValue -> integerNodeSigned(context, state)
                                -> if { "sext " -> print } else { "zext " -> print }
                        }
                    assignmentValue -> writeIrType(context, state)
                    " " -> print
                    request.ownerIndex >= 0 and context.ir[request.ownerIndex].kind == 0 and context.ir[request.ownerIndex].operand1 >= 0 and assignmentValue.kind == 5 and assignmentValue.symbol == context.ir[context.ir[request.ownerIndex].operand1].symbol
                        -> if { "%arg" -> print } else { "%v$(assignmentValueIndex -> valueNameId(state))" -> print }
                    " to " -> print
                    assignmentTargetFieldTypeId! -> writeSemanticTypeId(context, state)
                    "" -> println
                }
                false => materializeFixedAssignment!
                assignmentTargetFieldTypeId! >= 0
                    and context.types[assignmentTargetFieldTypeId!].kind == 4
                    and assignmentValue.typeId >= 0
                    and context.types[assignmentValue.typeId].kind == 4
                    -> if { true => materializeFixedAssignment! }
                false => assignmentFieldWasMoved!
                0 => assignmentMoveSearch!
                assignmentMoveSearch! < (context.moves -> len)
                    -> while {
                        context.moves[assignmentMoveSearch!] => assignmentMove
                        assignmentMove.memberIr >= 0 and assignmentMove.sourceModule == assignment.sourceModule and assignmentMove.symbol == assignment.symbol and (assignmentMoveSearch! -> memberMoveMatchesAssignment(request.nodeIndex, context, state)) and ((assignmentMoveSearch! -> partialMoveActiveAtAssignment(request.nodeIndex, context, state))
                            or ((request.nodeIndex -> moveRegionFor(context, state)) -> regionFullyMovesPlace(assignment.sourceModule, assignment.symbol, assignmentMove.memberIr, assignmentBinding -> sourceStart(context, state), assignment.astNode, request.nodeIndex, context, state)))
                            -> if {
                                true => assignmentFieldWasMoved!
                            }
                        assignmentMoveSearch! + 1 => assignmentMoveSearch!
                    }
                "  %member_assign$(request.nodeIndex)_field_address = getelementptr inbounds %sollang.struct.$(context -> emitterContext.declarationName(assignmentOwnerSource!, assignmentBinding.typeSymbol)), ptr " -> print
                assignmentRoot -> writeMutableStoragePointer(request.ownerIndex, context, state)
                ", i32 0, i32 $(assignmentFieldOrdinal!)" -> println
                not assignmentFieldWasMoved! and assignmentTargetFieldTypeId! >= 0
                    and (materializeFixedAssignment! or (assignmentTargetFieldTypeId! -> semanticTypeOwns(context, state)))
                    -> if {
                        "  %member_assign$(request.nodeIndex)_previous = load " -> print
                        materializeFixedAssignment! -> if { "%sollang.int_slice" -> print } else { assignmentTargetFieldTypeId! -> writeSemanticTypeId(context, state) }
                        ", ptr %member_assign$(request.nodeIndex)_field_address, align " -> print
                        materializeFixedAssignment! -> if { "8" -> println } else { context.typeAligns[assignmentTargetFieldTypeId!] -> writeDecimalLine }
                        materializeFixedAssignment! and not (assignmentTargetFieldTypeId! -> semanticTypeOwns(context, state))
                            -> if {
                                "  %member_assign$(request.nodeIndex)_previous_data = extractvalue %sollang.int_slice %member_assign$(request.nodeIndex)_previous, 0" -> println
                                "  call void @sollang_free(ptr %member_assign$(request.nodeIndex)_previous_data)" -> println
                            } else {
                                "  call void @sollang_drop_t$(assignmentTargetFieldTypeId!)(" -> print
                                materializeFixedAssignment! -> if { "%sollang.int_slice" -> print } else { assignmentTargetFieldTypeId! -> writeSemanticTypeId(context, state) }
                                " %member_assign$(request.nodeIndex)_previous)" -> println
                            }
                    }
                "  store " -> print
                materializeFixedAssignment! -> if { "%sollang.int_slice" -> print } else {
                    assignmentTargetFieldTypeId! >= 0 -> if { assignmentTargetFieldTypeId! -> writeSemanticTypeId(context, state) } else { assignmentValue -> writeIrType(context, state) }
                }
                " " -> print
                materializeFixedAssignment! -> if {
                    request.ownerIndex >= 0 and context.ir[request.ownerIndex].kind == 0 and context.ir[request.ownerIndex].operand1 >= 0 and assignmentValue.kind == 5 and assignmentValue.symbol == context.ir[context.ir[request.ownerIndex].operand1].symbol
                        -> if { "%arg" -> print } else { "%v$(assignmentValueIndex -> valueNameId(state))" -> print }
                } else {
                    assignmentValue.kind == 3 or assignmentValue.kind == 4
                        -> if {
                            assignmentValue -> sourceToken(context, state) => assignmentValueToken
                            assignmentValue.kind == 3 -> if {
                                assignmentValue -> writeIntegerLiteral(context, state)
                            } else {
                                (context.sources[assignmentValue.sourceModule] -> byte(assignmentValueToken.span.start)) == 116
                                    -> if { "1" -> print } else { "0" -> print }
                            }
                        } else {
                            castAssignmentValue -> if { "%member_assign$(request.nodeIndex)_value_cast" -> print } else {
                                request.ownerIndex >= 0 and context.ir[request.ownerIndex].kind == 0 and context.ir[request.ownerIndex].operand1 >= 0 and assignmentValue.kind == 5 and assignmentValue.symbol == context.ir[context.ir[request.ownerIndex].operand1].symbol
                                    -> if { "%arg" -> print } else { "%v$(assignmentValueIndex -> valueNameId(state))" -> print }
                            }
                        }
                }
                ", ptr %member_assign$(request.nodeIndex)_field_address" -> print
                ", align " -> print
                materializeFixedAssignment! -> if { "8" -> println } else {
                    assignmentTargetFieldTypeId! >= 0 -> if { context.typeAligns[assignmentTargetFieldTypeId!] -> writeDecimalLine } else { assignmentBinding -> storageAlign(context, state) -> writeDecimalLine }
                }
                request.nodeIndex -> emitCompletedPatternBindingTransferMarks(context, state)
                # A scalar fixed payload transfers its backing even without a
                # semantic affine move event. Mark the exact named payload
                # only after the field store has completed on this path.
                materializeFixedAssignment! -> if {
                    assignmentValueIndex -> emitDirectFixedPatternTransferMark(context, state)
                }
            }
        }
}
# Value-owned inline arrays need addressable storage for a dynamic subscript.
# The caller reserves one slot at function entry, never in a loop header.
whileInlineValueIndexTypeId indexIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.ir[indexIndex] => index
    index.kind != 15 or index.operand0 < 0 -> if { -1 -> return }
    context.ir[index.operand0] => member
    member.kind != 13 or member.operand0 < 0 -> if { -1 -> return }
    context.ir[member.operand0] => owner
    owner.typeId >= 0 and (context.types[owner.typeId].kind == 8 or context.types[owner.typeId].kind == 6)
        -> if { -1 -> return }
    index.operand0 -> canonicalMemberValueTypeId(context, state) => fieldType
    fieldType >= 0 and context.types[fieldType].kind == 12
        -> if { fieldType -> return }
    -1
}

emitWhileMember request: WhileValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[request.nodeIndex] => member
    context.ir[member.operand0] => base
    member -> sourceNode(context, state) => memberAst
    base -> sourceNode(context, state) => baseAst
    baseAst.start + baseAst.length => baseEnd
    memberAst.firstToken => tokenIndex!
    true => beforeBaseEnd!
    beforeBaseEnd! and tokenIndex! < memberAst.firstToken + memberAst.tokenCount
        -> while {
            context.tokens[context.ranges[member.sourceModule].tokenStart + tokenIndex!].span.start < baseEnd
                -> if { tokenIndex! + 1 => tokenIndex! } else { false => beforeBaseEnd! }
        }
    tokenIndex! => pathStart
    0 => memberCount!
    tokenIndex! < memberAst.firstToken + memberAst.tokenCount
        -> while {
            context.tokens[context.ranges[member.sourceModule].tokenStart + tokenIndex!].kind == grammar.tokenIdIdentifier()
                -> if { memberCount! + 1 => memberCount! }
            tokenIndex! + 1 => tokenIndex!
        }
    base.typeId => ownerType!
    0 => ordinal!
    pathStart => tokenIndex!
    tokenIndex! < memberAst.firstToken + memberAst.tokenCount
        -> while {
            context.tokens[context.ranges[member.sourceModule].tokenStart + tokenIndex!].kind == grammar.tokenIdIdentifier()
                -> if {
                    false => reference!
                    context.types[ownerType!].kind == 8 or context.types[ownerType!].kind == 6
                        -> if {
                            context.types[ownerType!].first => ownerType!
                            true => reference!
                        }
                    ownerType! -> canonicalMemberFieldIndex(member.sourceModule, tokenIndex!, context) => fieldIndex!
                    fieldIndex! < 0 and ordinal! == memberCount! - 1
                        -> if {
                            ownerType! -> canonicalMemberFieldOrdinalIndex(member.symbol, context) => fieldIndex!
                        }
                    context.fields[fieldIndex!] => field
                    ordinal! == memberCount! - 1 => terminal
                    "  %while$(request.whileIndex -> valueNameId(state))_v$(request.nodeIndex -> valueNameId(state))" -> print
                    terminal -> unless { "_m$(ordinal!)" -> print }
                    reference! -> if {
                        "_address = getelementptr inbounds " -> print
                        ownerType! -> writeSemanticTypeId(context, state)
                        ", ptr " -> print
                        ordinal! == 0 -> if {
                            member.operand0 -> isLocalReadonlyReferenceName(request.ownerIndex, context, state)
                                -> if { request.ownerIndex -> writeForwardedReferenceValue(member.operand0, context, state) } else {
                                    WhileValueRequest { whileIndex: request.whileIndex, ownerIndex: request.ownerIndex, nodeIndex: member.operand0 } -> writeWhileValue(context, state)
                                }
                        } else {
                            "%while$(request.whileIndex -> valueNameId(state))_v$(request.nodeIndex -> valueNameId(state))_m$(ordinal! - 1)" -> print
                        }
                        ", i32 0, i32 $(field.ordinal)" -> println
                        "  %while$(request.whileIndex -> valueNameId(state))_v$(request.nodeIndex -> valueNameId(state))" -> print
                        terminal -> unless { "_m$(ordinal!)" -> print }
                        " = load " -> print
                        field.fieldType -> writeAggregateFieldTypeId(context, state)
                        ", ptr %while$(request.whileIndex -> valueNameId(state))_v$(request.nodeIndex -> valueNameId(state))" -> print
                        terminal -> unless { "_m$(ordinal!)" -> print }
                        "_address, align $(context.typeAligns[field.fieldType])" -> println
                    } else {
                        " = extractvalue " -> print
                        ownerType! -> writeSemanticTypeId(context, state)
                        " " -> print
                        ordinal! == 0 -> if {
                            WhileValueRequest { whileIndex: request.whileIndex, ownerIndex: request.ownerIndex, nodeIndex: member.operand0 } -> writeWhileValue(context, state)
                        } else {
                            "%while$(request.whileIndex -> valueNameId(state))_v$(request.nodeIndex -> valueNameId(state))_m$(ordinal! - 1)" -> print
                        }
                        ", $(field.ordinal)" -> println
                    }
                    field.fieldType => ownerType!
                    ordinal! + 1 => ordinal!
                }
            tokenIndex! + 1 => tokenIndex!
        }
}
emitWhileCallArgumentChain argumentIndex: Int, callIndex: Int, whileIndex: Int, ownerIndex: Int, ordinal: Int, separator: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    argumentIndex >= 0 and context.ir[argumentIndex].parent == callIndex
        -> if {
            separator -> if { ", " -> print }
            argumentIndex -> aggregateValueIndex(context, state) => argumentValueIndex
            context.ir[argumentValueIndex] => argument
            callIndex -> callTargetParameter(ordinal, context, state) => argumentParameterIndex
            false => argumentNeedsReferenceSlot!
            argumentParameterIndex >= 0 -> if {
                context.ir[argumentParameterIndex] => argumentParameter
                argumentParameter.typeId >= 0 and context.types[argumentParameter.typeId].kind == 8 and not (argument.typeId >= 0 and context.types[argument.typeId].kind == 8)
                    -> if { true => argumentNeedsReferenceSlot! }
            }
            argumentIndex -> callArgumentNeedsSliceProjection(callIndex, ordinal, context, state) => whileArgumentNeedsSliceProjection
            argumentIndex -> callArgumentNeedsReferenceValueLoad(callIndex, ordinal, context, state) => whileArgumentNeedsReferenceValueLoad
            callIndex -> callBoundedValueParameterTypeId(ordinal, context, state) => whileBoundedArgumentTypeId
            whileBoundedArgumentTypeId >= 0 -> if {
                whileBoundedArgumentTypeId -> writeValueAbiTypeId(context, state)
                " %while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_bounded" -> print
            } else {
                callIndex -> callArgumentIsMutableBorrow(ordinal, context, state)
                    -> if {
                        argumentIndex -> writeCallArgument(callIndex, ownerIndex, ordinal, context, state)
                    } else {
                        whileArgumentNeedsSliceProjection -> if {
                            "%sollang.int_slice %while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_slice" -> print
                        } else {
                            argumentNeedsReferenceSlot! -> if {
                                "ptr %callref$(callIndex -> valueNameId(state))_arg$(ordinal)_address" -> print
                            } else {
                                argumentParameterIndex >= 0 -> if {
                                    context.ir[argumentParameterIndex] -> writeIrType(context, state)
                                } else {
                                    argument -> writeIrType(context, state)
                                }
                                " " -> print
                                whileArgumentNeedsReferenceValueLoad -> if {
                                    "%while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_reference_value" -> print
                                } else {
                                    WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: argumentValueIndex } -> writeWhileValue(context, state)
                                }
                            }
                        }
                    }
            }
            argument.nextOperand -> emitWhileCallArgumentChain(callIndex, whileIndex, ownerIndex, ordinal + 1, true, context, state)
        }
}
emitWhileCallArgumentPromotions argumentIndex: Int, callIndex: Int, whileIndex: Int, ownerIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    argumentIndex >= 0 and (context.ir[argumentIndex].parent == callIndex or argumentIndex == context.ir[callIndex].operand0)
        -> if {
            callIndex -> callBoundedValueParameterTypeId(ordinal, context, state) => whileBoundedArgumentTypeId
            whileBoundedArgumentTypeId >= 0 -> if {
                argumentIndex -> aggregateValueIndex(context, state) => whileBoundedValueIndex
                argumentIndex -> callArgumentNeedsReferenceValueLoad(callIndex, ordinal, context, state)
                    -> if {
                        "  %while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_bounded = load " -> print
                        whileBoundedArgumentTypeId -> writeValueAbiTypeId(context, state)
                        ", ptr " -> print
                        WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: whileBoundedValueIndex } -> writeWhileValue(context, state)
                        ", align $(context.typeAligns[whileBoundedArgumentTypeId])" -> println
                    } else {
                        Arena(0) => boundedPrefixStorage!
                        "while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_bounded" -> materialize(boundedPrefixStorage!) => boundedPrefix
                        "  %$(boundedPrefix)_handle = freeze %sollang.array.i32 " -> print
                        WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: whileBoundedValueIndex } -> writeWhileValue(context, state)
                        "" -> println
                        boundedPrefix -> emitBoundedArrayValueFromHandle("%$(boundedPrefix)_handle", whileBoundedArgumentTypeId, context, state)
                    }
            }
            whileBoundedArgumentTypeId < 0 and (argumentIndex -> callArgumentNeedsReferenceValueLoad(callIndex, ordinal, context, state))
                -> if {
                    argumentIndex -> aggregateValueIndex(context, state) => whileReferenceValueIndex
                    callIndex -> callTargetParameter(ordinal, context, state) => whileReferenceParameterIndex
                    context.ir[whileReferenceParameterIndex] => whileReferenceParameter
                    "  %while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_reference_value = load " -> print
                    whileReferenceParameter -> writeIrType(context, state)
                    ", ptr " -> print
                    WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: whileReferenceValueIndex } -> writeWhileValue(context, state)
                    ", align $(context.typeAligns[whileReferenceParameter.typeId])" -> println
                }
            argumentIndex -> callArgumentNeedsSliceProjection(callIndex, ordinal, context, state)
                -> if {
                    argumentIndex -> aggregateValueIndex(context, state) => whileSliceValueIndex
                    context.ir[whileSliceValueIndex] => whileSliceValue
                    whileSliceValue.typeId => whileSliceTypeId!
                    whileSliceValueIndex -> canonicalMemberValueTypeId(context, state) => whileCanonicalSliceTypeId
                    whileCanonicalSliceTypeId >= 0 -> if { whileCanonicalSliceTypeId => whileSliceTypeId! }
                    context.types[whileSliceTypeId!].kind == 4 -> if {
                        "  %while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_slice_storage = alloca " -> print
                        whileSliceTypeId! -> writeSemanticTypeId(context, state)
                        ", align $(context.typeAligns[whileSliceTypeId!])" -> println
                        "  store " -> print
                        whileSliceTypeId! -> writeSemanticTypeId(context, state)
                        " " -> print
                        WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: whileSliceValueIndex } -> writeWhileValue(context, state)
                        ", ptr %while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_slice_storage, align $(context.typeAligns[whileSliceTypeId!])" -> println
                        "  %while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_slice0 = insertvalue %sollang.int_slice poison, ptr %while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_slice_storage, 0" -> println
                        "  %while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_slice = insertvalue %sollang.int_slice %while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_slice0, i64 $(context.types[whileSliceTypeId!].length), 1" -> println
                    } else {
                        "  %while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_slice_data = extractvalue %sollang.array.i32 " -> print
                        WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: whileSliceValueIndex } -> writeWhileValue(context, state)
                        ", 0" -> println
                        "  %while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_slice_length = extractvalue %sollang.array.i32 " -> print
                        WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: whileSliceValueIndex } -> writeWhileValue(context, state)
                        ", 1" -> println
                        "  %while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_slice0 = insertvalue %sollang.int_slice poison, ptr " -> print
                        whileSliceValueIndex -> writeCallSliceDataPointer("%while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_slice_data", context, state)
                        ", 0" -> println
                        "  %while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_slice = insertvalue %sollang.int_slice %while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_slice0, i64 %while$(whileIndex -> valueNameId(state))_call$(callIndex)_arg$(ordinal)_slice_length, 1" -> println
                    }
                }
            context.ir[argumentIndex].nextOperand -> emitWhileCallArgumentPromotions(callIndex, whileIndex, ownerIndex, ordinal + 1, context, state)
        }
}
emitWhilePathText request: WhileValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    request.whileIndex => whileIndex
    request.nodeIndex => nodeIndex
    context.ir[nodeIndex] => pathCall
    context.ir[pathCall.operand0] => pathValue
    pathValue.typeId => pathType!
    false => pathIsReference!
    pathType! >= 0 and context.types[pathType!].kind == 8
        -> if {
            context.types[pathType!].first => pathType!
            true => pathIsReference!
        }
    -1 => bytesType!
    -1 => styleType!
    0 => fieldIndex!
    fieldIndex! < (context.fields -> len) -> while {
        context.fields[fieldIndex!] => field
        field.ownerType == pathType! -> if {
            field.ordinal == 0 -> if { field.fieldType => bytesType! }
            field.ordinal == 1 -> if { field.fieldType => styleType! }
        }
        fieldIndex! + 1 => fieldIndex!
    }
    pathIsReference! -> if {
        "  %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_value = load " -> print
        pathType! -> writeSemanticTypeId(context, state)
        ", ptr " -> print
        WhileValueRequest { whileIndex: whileIndex, ownerIndex: request.ownerIndex, nodeIndex: pathCall.operand0 } -> writeWhileValue(context, state)
        ", align 8" -> println
    }
    "  %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_bytes = extractvalue " -> print
    pathType! -> writeSemanticTypeId(context, state)
    " " -> print
    pathIsReference! -> if { "%while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_value" -> print } else {
        WhileValueRequest { whileIndex: whileIndex, ownerIndex: request.ownerIndex, nodeIndex: pathCall.operand0 } -> writeWhileValue(context, state)
    }
    ", 0" -> println
    "  %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_data = extractvalue " -> print
    bytesType! -> writeSemanticTypeId(context, state)
    " %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_bytes, 0" -> println
    "  %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_length = extractvalue " -> print
    bytesType! -> writeSemanticTypeId(context, state)
    " %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_bytes, 1" -> println
    pathCall.opcode == -214 -> if {
        context.expectedPathStyle => expectedStyle
        "  %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_style_value = extractvalue " -> print
        pathType! -> writeSemanticTypeId(context, state)
        " " -> print
        pathIsReference! -> if { "%while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_value" -> print } else {
            WhileValueRequest { whileIndex: whileIndex, ownerIndex: request.ownerIndex, nodeIndex: pathCall.operand0 } -> writeWhileValue(context, state)
        }
        ", 1" -> println
        "  %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_style = extractvalue " -> print
        styleType! -> writeSemanticTypeId(context, state)
        " %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_style_value, 0" -> println
        "  %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_style_valid = icmp eq i32 %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_style, $(expectedStyle)" -> println
        "  br i1 %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_style_valid, label %while$(whileIndex -> valueNameId(state))_map_path$(nodeIndex)_open, label %while$(whileIndex -> valueNameId(state))_map_path$(nodeIndex)_style_error" -> println
        "while$(whileIndex -> valueNameId(state))_map_path$(nodeIndex)_style_error:" -> println
        "  call void @llvm.trap()" -> println
        "  unreachable" -> println
        "while$(whileIndex -> valueNameId(state))_map_path$(nodeIndex)_open:" -> println
    }
    "  %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_text0 = insertvalue %sollang.text poison, ptr %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_data, 0" -> println
    "  %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_text = insertvalue %sollang.text %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_text0, i64 %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_length, 1" -> println
    pathCall.opcode == -230 -> if {
        "  %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state)) = freeze %sollang.text %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_text" -> println
    } else {
        "  %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state)) = call %sollang.source_text @sollang_runtime_map_text(%sollang.text %while$(whileIndex -> valueNameId(state))_v$(nodeIndex -> valueNameId(state))_path_text)" -> println
    }
}

emitWhileBranch request: WhileBranchRequest, emissionOrder: [Int], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    request.whileIndex => whileIndex
    request.ownerIndex => ownerIndex
    context.ir[whileIndex] => whileNode
    [WhileBoolTask; ~] => boolTasks!
    boolTasks! -> push(WhileBoolTask {
        kind: 0
        nodeIndex: request.conditionIndex
        trueKind: 0
        trueNode: whileIndex
        falseKind: 1
        falseNode: whileIndex
    })
    1 => boolTaskSize!
    false => emittedLogicalLabel!
    [Int; ~] => entryValueNodes!
    boolTaskSize! > 0 -> while {
        boolTaskSize! - 1 => boolTaskSize!
        boolTasks![boolTaskSize!] => boolTask
        boolTask.kind == 1 -> if {
            true => emittedLogicalLabel!
            "while$(whileIndex -> valueNameId(state))_bool$(boolTask.nodeIndex)_rhs:" -> println
        } else {
            boolTask.nodeIndex => boolNodeIndex!
            true => boolNodeUnwrap!
            boolNodeUnwrap! and context.ir[boolNodeIndex!].kind == 9
                -> while {
                    -1 => boolNodeChild!
                    UIntSize(0) => boolNodeChildStart!
                    boolNodeIndex! + 1 => boolNodeChildSearch!
                    boolNodeChildSearch! < whileIndex -> while {
                        context.ir[boolNodeChildSearch!].parent == boolNodeIndex!
                            -> if {
                                context.ir[boolNodeChildSearch!] -> sourceNode(context, state) => boolNodeChildAst
                                boolNodeChild! < 0 or boolNodeChildAst.start > boolNodeChildStart!
                                    -> if {
                                        boolNodeChildSearch! => boolNodeChild!
                                        boolNodeChildAst.start => boolNodeChildStart!
                                    }
                            }
                        boolNodeChildSearch! + 1 => boolNodeChildSearch!
                    }
                    boolNodeChild! >= 0 -> if { boolNodeChild! => boolNodeIndex! } else { false => boolNodeUnwrap! }
                }
            context.ir[boolNodeIndex!] => boolNode
            boolNode.kind == 8 and (boolNode.opcode == -25 or boolNode.opcode == -24)
                -> if {
                    WhileBoolTask {
                        kind: 0
                        nodeIndex: boolNode.operand1
                        trueKind: boolTask.trueKind
                        trueNode: boolTask.trueNode
                        falseKind: boolTask.falseKind
                        falseNode: boolTask.falseNode
                    } => rightTask
                    boolTaskSize! == (boolTasks! -> len) -> if { boolTasks! -> push(rightTask) } else { rightTask => boolTasks![boolTaskSize!] }
                    boolTaskSize! + 1 => boolTaskSize!
                    WhileBoolTask {
                        kind: 1
                        nodeIndex: boolNodeIndex!
                        trueKind: -1
                        trueNode: -1
                        falseKind: -1
                        falseNode: -1
                    } => labelTask
                    boolTaskSize! == (boolTasks! -> len) -> if { boolTasks! -> push(labelTask) } else { labelTask => boolTasks![boolTaskSize!] }
                    boolTaskSize! + 1 => boolTaskSize!
                    boolTask.trueKind => leftTrueKind!
                    boolTask.trueNode => leftTrueNode!
                    boolTask.falseKind => leftFalseKind!
                    boolTask.falseNode => leftFalseNode!
                    boolNode.opcode == -25 -> if {
                        2 => leftTrueKind!
                        boolNodeIndex! => leftTrueNode!
                    } else {
                        2 => leftFalseKind!
                        boolNodeIndex! => leftFalseNode!
                    }
                    WhileBoolTask {
                        kind: 0
                        nodeIndex: boolNode.operand0
                        trueKind: leftTrueKind!
                        trueNode: leftTrueNode!
                        falseKind: leftFalseKind!
                        falseNode: leftFalseNode!
                    } => leftTask
                    boolTaskSize! == (boolTasks! -> len) -> if { boolTasks! -> push(leftTask) } else { leftTask => boolTasks![boolTaskSize!] }
                    boolTaskSize! + 1 => boolTaskSize!
                } else {
                    boolNode.kind == 7 and boolNode.opcode == -26
                        -> if {
                            WhileBoolTask {
                                kind: 0
                                nodeIndex: boolNode.operand0
                                trueKind: boolTask.falseKind
                                trueNode: boolTask.falseNode
                                falseKind: boolTask.trueKind
                                falseNode: boolTask.trueNode
                            } => notTask
                            boolTaskSize! == (boolTasks! -> len) -> if { boolTasks! -> push(notTask) } else { notTask => boolTasks![boolTaskSize!] }
                            boolTaskSize! + 1 => boolTaskSize!
                        } else {
                            [Int; ~] => valueTasks!
                            valueTasks! -> push(boolNodeIndex! + 1)
                            1 => valueTaskSize!
                            valueTaskSize! > 0 -> while {
                                valueTaskSize! - 1 => valueTaskSize!
                                valueTasks![valueTaskSize!] => valueTask
                                valueTask > 0 -> if {
                                    valueTask - 1 => valueNodeIndex
                                    context.ir[valueNodeIndex] => valueNode
                                    valueNodeIndex -> isSubjectWhenRangeCondition(whileIndex, context) => subjectRangeCondition
                                    false => valueProvidedByEntry!
                                    0 => entryValueSearch!
                                    entryValueSearch! < (entryValueNodes! -> len) and not valueProvidedByEntry!
                                        -> while {
                                            entryValueNodes![entryValueSearch!] == valueNodeIndex
                                                -> if { true => valueProvidedByEntry! }
                                            entryValueSearch! + 1 => entryValueSearch!
                                        }
                                    not valueProvidedByEntry! -> if {
                                        not emittedLogicalLabel! -> if { entryValueNodes! -> push(valueNodeIndex) }
                                        0 - valueNodeIndex - 1 => emitValueTask
                                        valueTaskSize! == (valueTasks! -> len) -> if { valueTasks! -> push(emitValueTask) } else { emitValueTask => valueTasks![valueTaskSize!] }
                                        valueTaskSize! + 1 => valueTaskSize!
                                        (valueNode.kind == 6 or valueNode.kind == 7 or valueNode.kind == 8 or valueNode.kind == 9 or valueNode.kind == 13 or valueNode.kind == 14 or valueNode.kind == 15 or valueNode.kind == 18 or valueNode.kind == 12 or valueNode.kind == 26 or valueNode.kind == 27 or valueNode.kind == 35 or subjectRangeCondition)
                                            and not (valueNode.kind == 8 and (valueNode.opcode == -24 or valueNode.opcode == -25))
                                            -> if {
                                                (valueNode.kind == 8 or valueNode.kind == 15 or subjectRangeCondition or ((valueNode.kind == 9 or valueNode.kind == 6) and (valueNode.opcode == -202 or valueNode.opcode == -203))) and valueNode.operand1 >= 0
                                                    -> if {
                                                        valueNode.operand1 => secondValueIndex!
                                                        (valueNode.kind == 9 or valueNode.kind == 6) and valueNode.opcode == -202
                                                            -> if {
                                                                valueNode.operand1 -> aggregateValueIndex(context, state) => secondValueIndex!
                                                            }
                                                        secondValueIndex! + 1 => secondValueTask
                                                        valueTaskSize! == (valueTasks! -> len) -> if { valueTasks! -> push(secondValueTask) } else { secondValueTask => valueTasks![valueTaskSize!] }
                                                        valueTaskSize! + 1 => valueTaskSize!
                                                        valueNode.kind == 9 and valueNode.opcode == -203 and context.ir[valueNode.operand1].nextOperand >= 0
                                                            -> if {
                                                                context.ir[valueNode.operand1].nextOperand + 1 => sliceLengthTask
                                                                valueTaskSize! == (valueTasks! -> len) -> if { valueTasks! -> push(sliceLengthTask) } else { sliceLengthTask => valueTasks![valueTaskSize!] }
                                                                valueTaskSize! + 1 => valueTaskSize!
                                                            }
                                                    }
                                                # Linked children are written in source order. Reverse their
                                                # task pushes so the LIFO evaluator executes the first child first.
                                                valueNode.kind == 6 or valueNode.kind == 12 or valueNode.kind == 35 or valueNode.kind == 14
                                                    -> if {
                                                        [Int; ~] => linkedValueTasks!
                                                        valueNode.operand0 => linkedValueIndex!
                                                        linkedValueIndex! >= 0 -> while {
                                                            linkedValueTasks! -> push(linkedValueIndex! + 1)
                                                            context.ir[linkedValueIndex!].nextOperand => linkedValueIndex!
                                                        }
                                                        linkedValueTasks! -> len => linkedValueCount!
                                                        linkedValueCount! > 0 -> while {
                                                            linkedValueCount! - 1 => linkedValueCount!
                                                            linkedValueTasks![linkedValueCount!] => linkedValueTask
                                                            valueTaskSize! == (valueTasks! -> len) -> if { valueTasks! -> push(linkedValueTask) } else { linkedValueTask => valueTasks![valueTaskSize!] }
                                                            valueTaskSize! + 1 => valueTaskSize!
                                                        }
                                                    } else {
                                                        valueNode.operand0 >= 0 -> if {
                                                            valueNode.operand0 + 1 => firstValueTask
                                                            valueTaskSize! == (valueTasks! -> len) -> if { valueTasks! -> push(firstValueTask) } else { firstValueTask => valueTasks![valueTaskSize!] }
                                                            valueTaskSize! + 1 => valueTaskSize!
                                                        }
                                                    }
                                            }
                                    }
                                } else {
                                    0 - valueTask - 1 => valueNodeIndex
                                    context.ir[valueNodeIndex] => valueNode
                                    valueNodeIndex -> isSubjectWhenRangeCondition(whileIndex, context)
                                        -> if { valueNodeIndex -> emitSubjectWhenRangeCondition(whileIndex, ownerIndex, context, state) }
                                    valueNode -> isUserBlockScope -> if {
                                        valueNodeIndex -> emitRegion(emissionOrder, context, state)
                                    }
                                    valueNode.kind == 26 -> if {
                                        WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNodeIndex } -> emitEnumConstructor(context, state)
                                    }
                                    valueNode.kind == 27 -> if {
                                        valueNodeIndex -> emitEnumMatchWithSubjectDomain(whileIndex, emissionOrder, context, state)
                                    }
                                    valueNode.kind == 33 -> if { valueNodeIndex -> emitBooleanWhen(emissionOrder, context, state) }
                                    valueNode.kind == 34 -> if { valueNodeIndex -> emitSubjectWhen(emissionOrder, context, state) }
                                    valueNode.kind == 12 or valueNode.kind == 35 -> if {
                                        valueNodeIndex -> emitAggregateExpressions(ownerIndex, whileIndex, context, state)
                                    }
                                    valueNode.kind == 2 -> if {
                                        valueNodeIndex -> emitComparisonTextProducer(ownerIndex, context, state)
                                    }
                                    valueNode.kind == 8 and (valueNode.opcode == -24 or valueNode.opcode == -25)
                                        -> if {
                                            valueNodeIndex -> emitLogicalValue(ownerIndex, emissionOrder, context, state)
                                        }
                                    valueNode.kind == 5 -> if {
                                        valueNodeIndex -> emitComparisonReferenceNameRead(ownerIndex, whileIndex, context, state)
                                        false => parameterValue!
                                        ownerIndex >= 0 and context.ir[ownerIndex].kind == 0 and context.ir[ownerIndex].operand1 >= 0 and valueNode.symbol == context.ir[context.ir[ownerIndex].operand1].symbol
                                            -> if { true => parameterValue! }
                                        -1 => mutableParameterOrdinal!
                                        valueNode.operand0 < 0 -> if {
                                            valueNodeIndex -> mutableBorrowParameterOrdinal(ownerIndex, context, state) => mutableParameterOrdinal!
                                        }
                                        mutableParameterOrdinal! >= 0 -> if {
                                            emitWhileCurrentMutableParameterValue(whileIndex, valueNodeIndex, mutableParameterOrdinal!, ownerIndex, context, state)
                                        }
                                        not parameterValue! -> if {
                                            -1 => valueBindingIndex!
                                            valueNode.operand0 >= 0 and context.ir[valueNode.operand0].kind == 17
                                                -> if { valueNode.operand0 => valueBindingIndex! }
                                            valueBindingIndex! >= 0 -> if {
                                                context.ir[valueBindingIndex!] => valueBinding
                                                valueBinding.flags == 1 -> if {
                                                    valueBindingIndex! -> mutableBindingRoot(context, state) => valueRoot
                                                    "  %while$(whileIndex -> valueNameId(state))_v$(valueNodeIndex -> valueNameId(state)) = load " -> print
                                                    valueNode -> writeIrType(context, state)
                                                    ", ptr %slot$(valueRoot -> valueNameId(state)), align " -> print
                                                    valueNode -> storageAlign(context, state) -> writeDecimalLine
                                                } else {
                                                    valueBindingIndex! -> asyncFrameBindingRoot(ownerIndex, context, state) => asyncRoot
                                                    asyncRoot >= 0 -> if {
                                                        "  %while$(whileIndex -> valueNameId(state))_v$(valueNodeIndex -> valueNameId(state)) = load " -> print
                                                        valueNode -> writeIrType(context, state)
                                                        ", ptr " -> print
                                                        asyncRoot -> writeAsyncLocalAddress(context, state)
                                                        ", align " -> print
                                                        valueNode -> storageAlign(context, state) -> writeDecimalLine
                                                    } else {
                                                        context.ir[valueBinding.operand0] => bindingOperand
                                                        "  %while$(whileIndex -> valueNameId(state))_v$(valueNodeIndex -> valueNameId(state)) = freeze " -> print
                                                        bindingOperand -> writeIrType(context, state)
                                                        " " -> print
                                                        bindingOperand.kind == 3 or bindingOperand.kind == 4
                                                            -> if {
                                                                bindingOperand -> sourceToken(context, state) => bindingToken
                                                                bindingOperand.kind == 3 -> if { bindingOperand -> writeIntegerLiteral(context, state) } else { (context.sources[bindingOperand.sourceModule] -> byte(bindingToken.span.start)) == 116
                                                                        -> if { "1" -> print } else { "0" -> print } }
                                                            } else {
                                                                valueBinding.operand0 -> writeValue(ownerIndex, context, state)
                                                            }
                                                        "" -> println
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    valueNode.kind == 14 and ((valueNode -> isDynamicArrayType) or (valueNode -> isFixedArrayType) or (valueNode -> isSliceArrayType))
                                        -> if {
                                            0 => whileArrayOperandCount!
                                            valueNode.operand0 => whileArrayCountIndex!
                                            whileArrayCountIndex! >= 0 -> while {
                                                whileArrayOperandCount! + 1 => whileArrayOperandCount!
                                                context.ir[whileArrayCountIndex!].nextOperand => whileArrayCountIndex!
                                            }
                                            whileArrayOperandCount! => whileArrayLength!
                                            valueNode.typeId >= 0
                                                and context.types[valueNode.typeId].kind == 4
                                                and context.types[valueNode.typeId].length >= 0
                                                -> if { context.types[valueNode.typeId].length => whileArrayLength! }
                                            whileArrayLength! => whileArrayCapacity!
                                            valueNode.opcode >= 1_000_000 -> if {
                                                valueNode.opcode - 1_000_000 => whileArrayCapacity!
                                            }
                                            valueNode.typeId >= 0 and context.types[valueNode.typeId].kind == 12
                                                -> if { context.types[valueNode.typeId].length => whileArrayCapacity! }
                                            (valueNode -> isFixedArrayType)
                                                and not (valueNodeIndex -> fixedArrayLiteralNeedsHeap(context, state))
                                                -> if {
                                                    "  %while$(whileIndex -> valueNameId(state))_v$(valueNodeIndex -> valueNameId(state))_data = getelementptr i8, ptr %v$(valueNodeIndex -> valueNameId(state))_data, i64 0" -> println
                                                } else {
                                                    whileArrayCapacity! * (valueNode -> arrayElementSize(context, state)) => whileArrayByteLength
                                                    whileArrayByteLength == 0 -> if {
                                                        valueNodeIndex -> freshEmptyArrayCallParameter(context, state) => emptyWhileCallParameter
                                                        emptyWhileCallParameter >= 0 or (valueNode -> isFixedArrayType)
                                                            -> if {
                                                                (emptyWhileCallParameter >= 0 -> if {
                                                                    context.ir[emptyWhileCallParameter] -> arrayElementSize(context, state)
                                                                } else { valueNode -> arrayElementSize(context, state) }) => emptyWhileCallStorageBytes
                                                                ArrayStorageIdentity { resultDomain: 2, resultIndex: valueNodeIndex, labelIndex: whileIndex } -> emitArrayHeapBacking(emptyWhileCallStorageBytes, ownerIndex, context, state)
                                                            } else {
                                                                "  %while$(whileIndex -> valueNameId(state))_v$(valueNodeIndex -> valueNameId(state))_data = inttoptr i64 0 to ptr" -> println
                                                            }
                                                    } else {
                                                        ArrayStorageIdentity { resultDomain: 2, resultIndex: valueNodeIndex, labelIndex: whileIndex } -> emitArrayHeapBacking(whileArrayByteLength, ownerIndex, context, state)
                                                    }
                                                }
