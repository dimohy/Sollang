                                                        whileIndexedMutableParameterOrdinal == 0 -> if { "%arg_mut_ptr_addr" -> print } else { "%arg$(whileIndexedMutableParameterOrdinal)_mut_ptr_addr" -> print }
                                                        ", align 8" -> println
                                                        "  %while$(whileIndex)_v$(valueNodeIndex)_length = load i64, ptr " -> print
                                                        whileIndexedMutableParameterOrdinal == 0 -> if { "%arg_mut_len_addr" -> print } else { "%arg$(whileIndexedMutableParameterOrdinal)_mut_len_addr" -> print }
                                                        ", align 8" -> println
                                                    } else {
                                                        "  %while$(whileIndex)_v$(valueNodeIndex)_data = extractvalue " -> print
                                                        whileIndexedReadonlyReference! -> if {
                                                            whileIndexedContainerTypeId! -> writeSemanticTypeId(context, state)
                                                        } else {
                                                            whileIndexedArray -> writeIrType(context, state)
                                                        }
                                                        " " -> print
                                                        whileIndexedReadonlyReference! -> if {
                                                            "%while$(whileIndex)_v$(valueNodeIndex)_indexed_source" -> print
                                                        } else {
                                                            WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand0 } -> writeWhileValue(context, state)
                                                        }
                                                        ", 0" -> println
                                                        "  %while$(whileIndex)_v$(valueNodeIndex)_length = extractvalue " -> print
                                                        whileIndexedReadonlyReference! -> if {
                                                            whileIndexedContainerTypeId! -> writeSemanticTypeId(context, state)
                                                        } else {
                                                            whileIndexedArray -> writeIrType(context, state)
                                                        }
                                                        " " -> print
                                                        whileIndexedReadonlyReference! -> if {
                                                            "%while$(whileIndex)_v$(valueNodeIndex)_indexed_source" -> print
                                                        } else {
                                                            WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand0 } -> writeWhileValue(context, state)
                                                        }
                                                        ", 1" -> println
                                                    }
                                                whileIndexWidth == 64 -> if {
                                                    "  %while$(whileIndex)_v$(valueNodeIndex)_index = add i64 0, " -> print
                                                } else {
                                                    "  %while$(whileIndex)_v$(valueNodeIndex)_index = " -> print
                                                    whileIndexValue -> integerNodeSigned(context, state)
                                                        -> if { "sext " -> print } else { "zext " -> print }
                                                    whileIndexValue -> writeIrType(context, state)
                                                    " " -> print
                                                }
                                                WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand1 } -> writeWhileValue(context, state)
                                                whileIndexWidth == 64 -> if { "" -> println } else { " to i64" -> println }
                                                "  %while$(whileIndex)_v$(valueNodeIndex)_in_bounds = icmp ult i64 %while$(whileIndex)_v$(valueNodeIndex)_index, %while$(whileIndex)_v$(valueNodeIndex)_length" -> println
                                                "  br i1 %while$(whileIndex)_v$(valueNodeIndex)_in_bounds, label %while$(whileIndex)_v$(valueNodeIndex)_index_ok, label %while$(whileIndex)_v$(valueNodeIndex)_index_fail" -> println
                                                "while$(whileIndex)_v$(valueNodeIndex)_index_fail:" -> println
                                                "  call void @llvm.trap()" -> println
                                                "  unreachable" -> println
                                                "while$(whileIndex)_v$(valueNodeIndex)_index_ok:" -> println
                                                "  %while$(whileIndex)_v$(valueNodeIndex)_ptr = getelementptr " -> print
                                                valueNode -> writeIrType(context, state)
                                                ", ptr %while$(whileIndex)_v$(valueNodeIndex)_data, i64 %while$(whileIndex)_v$(valueNodeIndex)_index" -> println
                                                "  %while$(whileIndex)_v$(valueNodeIndex) = load " -> print
                                                valueNode -> writeIrType(context, state)
                                                ", ptr %while$(whileIndex)_v$(valueNodeIndex)_ptr, align " -> print
                                                valueNode -> storageAlign(context, state) -> writeDecimalLine
                                            }
                                        }
                                    valueNode.kind == 18 and valueNode.operand0 >= 0 and valueNode.operand1 >= 0 and valueNode.nextOperand >= 0
                                        -> if {
                                            context.ir[valueNode.operand0] => whileIfCondition
                                            (whileIfCondition.kind == 8 and (whileIfCondition.opcode == -25 or whileIfCondition.opcode == -24) or (whileIfCondition.kind == 7 and whileIfCondition.opcode == -26)) => whileIfShortCircuit
                                            whileIfShortCircuit -> if {
                                                WhileBranchRequest { whileIndex: valueNodeIndex, ownerIndex: ownerIndex, conditionIndex: valueNode.operand0 } -> emitWhileBranch(emissionOrder, context, state)
                                                "while$(valueNodeIndex)_body:" -> println
                                                "  br label %if$(valueNodeIndex)_then" -> println
                                                "while$(valueNodeIndex)_exit:" -> println
                                                "  br label %if$(valueNodeIndex)_else" -> println
                                            } else {
                                                "  br i1 " -> print
                                                WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand0 } -> writeWhileValue(context, state)
                                                ", label %if$(valueNodeIndex)_then, label %if$(valueNodeIndex)_else" -> println
                                            }
                                            "if$(valueNodeIndex)_then:" -> println
                                            valueNode.operand1 -> emitRegion(emissionOrder, context, state)
                                            valueNode.operand1 -> regionResultValueIndex(context, state) => whileThenStoreIndex
                                            valueNode -> emitIfResultStore(whileThenStoreIndex, ownerIndex, valueNodeIndex, 0, context, state)
                                            "  br label %if$(valueNodeIndex)_merge" -> println
                                            "if$(valueNodeIndex)_else:" -> println
                                            valueNode.nextOperand -> emitRegion(emissionOrder, context, state)
                                            valueNode.nextOperand -> regionResultValueIndex(context, state) => whileElseStoreIndex
                                            valueNode -> emitIfResultStore(whileElseStoreIndex, ownerIndex, valueNodeIndex, 1, context, state)
                                            "  br label %if$(valueNodeIndex)_merge" -> println
                                            "if$(valueNodeIndex)_merge:" -> println
                                            "  %while$(whileIndex)_v$(valueNodeIndex) = load " -> print
                                            valueNode -> writeIrType(context, state)
                                            ", ptr %if$(valueNodeIndex)_result, align " -> print
                                            valueNode -> storageAlign(context, state) -> writeDecimalLine
                                        }
                                    valueNode.kind == 8 and (valueNode.operand0 < 0 or valueNode.operand1 < 0)
                                        -> if {
                                            "; invalid while binary ir=$(valueNodeIndex) op0=$(valueNode.operand0) op1=$(valueNode.operand1) opcode=$(valueNode.opcode)" -> println
                                        }
                                    (valueNode.kind == 7 and valueNode.operand0 >= 0) or (valueNode.kind == 8 and valueNode.opcode != -24 and valueNode.opcode != -25 and valueNode.operand0 >= 0 and valueNode.operand1 >= 0)
                                        -> if {
                                            context.ir[valueNode.operand0] => left
                                            0 => whileBinaryWidth!
                                            false => whileLeftPromoted!
                                            false => whileRightPromoted!
                                            valueNode.kind == 8 -> if {
                                                context.ir[valueNode.operand1] => whileRight
                                                left -> integerNodeWidth(context, state) => whileLeftWidth
                                                whileRight -> integerNodeWidth(context, state) => whileRightWidth
                                                whileLeftWidth > 0 and whileRightWidth > 0 -> if {
                                                    whileLeftWidth > whileRightWidth -> if { whileLeftWidth => whileBinaryWidth! } else { whileRightWidth => whileBinaryWidth! }
                                                    whileLeftWidth < whileBinaryWidth! and left.kind != 3 and left.kind != 4
                                                        -> if {
                                                            "  %while$(whileIndex)_v$(valueNodeIndex)_left_wide = " -> print
                                                            left -> integerNodeSigned(context, state) -> if { "sext" -> print } else { "zext" -> print }
                                                            " i$(whileLeftWidth) " -> print
                                                            WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand0 } -> writeWhileValue(context, state)
                                                            " to i$(whileBinaryWidth!)" -> println
                                                            true => whileLeftPromoted!
                                                        }
                                                    whileRightWidth < whileBinaryWidth! and whileRight.kind != 3 and whileRight.kind != 4
                                                        -> if {
                                                            "  %while$(whileIndex)_v$(valueNodeIndex)_right_wide = " -> print
                                                            whileRight -> integerNodeSigned(context, state)
                                                                -> if { "sext" -> print } else { "zext" -> print }
                                                            " i$(whileRightWidth) " -> print
                                                            WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand1 } -> writeWhileValue(context, state)
                                                            " to i$(whileBinaryWidth!)" -> println
                                                            true => whileRightPromoted!
                                                        }
                                                }
                                            }
                                            valueNode.kind == 8
                                                and (valueNode.opcode == grammar.tokenIdEqualEqual() or valueNode.opcode == grammar.tokenIdBangEqual())
                                                and (left -> isTextType)
                                                and (context.ir[valueNode.operand1] -> isTextType) => whileTextEquality
                                            whileTextEquality -> if {
                                                valueNode.opcode == grammar.tokenIdBangEqual()
                                                    -> if {
                                                        "  %while$(whileIndex)_v$(valueNodeIndex)_text_equal = call i1 @sollang_text_equal(%sollang.text " -> print
                                                    } else {
                                                        "  %while$(whileIndex)_v$(valueNodeIndex) = call i1 @sollang_text_equal(%sollang.text " -> print
                                                    }
                                                WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand0 } -> writeWhileValue(context, state)
                                                ", %sollang.text " -> print
                                                WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand1 } -> writeWhileValue(context, state)
                                                ")" -> println
                                                valueNode.opcode == grammar.tokenIdBangEqual()
                                                    -> if {
                                                        "  %while$(whileIndex)_v$(valueNodeIndex) = xor i1 %while$(whileIndex)_v$(valueNodeIndex)_text_equal, true" -> println
                                                    }
                                            } else {
                                                "  %while$(whileIndex)_v$(valueNodeIndex) = " -> print
                                                valueNode.kind == 7 -> if {
                                                    valueNode.opcode == -26 -> if { "xor" -> print } else { "sub" -> print }
                                                } else {
                                                    valueNode.opcode == grammar.tokenIdPlus() -> if { "add" -> print }
                                                    valueNode.opcode == grammar.tokenIdMinus() -> if { "sub" -> print }
                                                    valueNode.opcode == grammar.tokenIdStar() -> if { "mul" -> print }
                                                    valueNode.opcode == grammar.tokenIdSlash() -> if { valueNode -> integerQuotientOperation(context, state) -> print }
                                                    valueNode.opcode == grammar.tokenIdPercent()
                                                        -> if { valueNode -> integerRemainderOperation(context, state) -> print }
                                                    valueNode.opcode == grammar.tokenIdEqualEqual()
                                                        -> if { "icmp eq" -> print }
                                                    valueNode.opcode == grammar.tokenIdBangEqual()
                                                        -> if { "icmp ne" -> print }
                                                    valueNode.opcode == grammar.tokenIdLess() or valueNode.opcode == grammar.tokenIdLessEqual() or valueNode.opcode == grammar.tokenIdGreater() or valueNode.opcode == grammar.tokenIdGreaterEqual()
                                                        -> if {
                                                            valueNode -> integerComparisonOperation(context, state) -> print
                                                        }
                                                    valueNode.opcode == -24 -> if { "or" -> print }
                                                    valueNode.opcode == -25 -> if { "and" -> print }
                                                }
                                                " " -> print
                                                whileBinaryWidth! > 0 -> if { "i$(whileBinaryWidth!)" -> print } else { valueNode.kind == 7
                                                        -> if { valueNode -> writeIrType(context, state) } else { left -> writeIrType(context, state) } }
                                                " " -> print
                                                valueNode.kind == 7 -> if {
                                                    valueNode.opcode == -26 -> if {
                                                        WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand0 } -> writeWhileValue(context, state)
                                                        ", true" -> println
                                                    } else {
                                                        "0, " -> print
                                                        WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand0 } -> writeWhileValue(context, state)
                                                        "" -> println
                                                    }
                                                } else {
                                                    whileLeftPromoted! -> if { "%while$(whileIndex)_v$(valueNodeIndex)_left_wide" -> print } else {
                                                        WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand0 } -> writeWhileValue(context, state)
                                                    }
                                                    ", " -> print
                                                    whileRightPromoted! -> if { "%while$(whileIndex)_v$(valueNodeIndex)_right_wide" -> print } else {
                                                        WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand1 } -> writeWhileValue(context, state)
                                                    }
                                                    "" -> println
                                                }
                                            }
                                        }
                                }
                            }
                            "  br i1 " -> print
                            WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: boolNodeIndex! } -> writeWhileValue(context, state)
                            ", label %" -> print
                            boolTask.trueKind == 0 -> if { "while$(whileIndex)_body" -> print }
                            boolTask.trueKind == 1 -> if { "while$(whileIndex)_exit" -> print }
                            boolTask.trueKind == 2 -> if { "while$(whileIndex)_bool$(boolTask.trueNode)_rhs" -> print }
                            ", label %" -> print
                            boolTask.falseKind == 0 -> if { "while$(whileIndex)_body" -> print }
                            boolTask.falseKind == 1 -> if { "while$(whileIndex)_exit" -> print }
                            boolTask.falseKind == 2 -> if { "while$(whileIndex)_bool$(boolTask.falseNode)_rhs" -> print }
                            "" -> println
                        }
                }
        }
    }
}

# Logical operators are values, but their right operand is evaluated only along
# the branch selected by the left operand. Reuse the condition tree emitter and
# merge its true/false exits into the SSA value expected for the logical node.
emitLogicalValue logicalIndex: Int, ownerIndex: Int, emissionOrder: [Int], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    WhileBranchRequest { whileIndex: logicalIndex, ownerIndex: ownerIndex, conditionIndex: logicalIndex } -> emitWhileBranch(emissionOrder, context, state)
    "while$(logicalIndex)_body:" -> println
    "  br label %logical$(logicalIndex)_merge" -> println
    "while$(logicalIndex)_exit:" -> println
    "  br label %logical$(logicalIndex)_merge" -> println
    "logical$(logicalIndex)_merge:" -> println
    "  %v$(logicalIndex) = phi i1 [ true, %while$(logicalIndex)_body ], [ false, %while$(logicalIndex)_exit ]" -> println
}

writeCleanupName edgeIndex: Int, bindingIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    "%cleanup" -> print
    edgeIndex -> writeDecimal
    "_b" -> print
    bindingIndex -> writeDecimal
}
producerPipelineConsumesBinding bindingIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => consumed!
    0 => pipelineIndex!
    pipelineIndex! < (context.streamPlan.pipelines -> len) and not consumed!
        -> while {
            context.streamPlan.pipelines[pipelineIndex!] => pipeline
            pipeline.status > 0 and pipeline.status < 3 -> if {
                pipeline.source0 == bindingIndex -> if { true => consumed! }
                pipeline.source0 >= 0 and pipeline.source0 < (context.ir -> len)
                    -> if {
                        context.ir[pipeline.source0] => source
                        source.kind == 5 and source.operand0 == bindingIndex
                            -> if { true => consumed! }
                        context.ir[bindingIndex].operand0 >= 0 and pipeline.source0 == context.ir[bindingIndex].operand0
                            -> if { true => consumed! }
                    }
            }
            pipelineIndex! + 1 => pipelineIndex!
        }
    0 => junctionIndex!
    junctionIndex! < (context.streamPlan.junctions -> len) and not consumed!
        -> while {
            context.streamPlan.junctions[junctionIndex!] => junction
            junction.kind == 1 and junction.status > 0 and junction.status < 3
                -> if {
                    junction.source0 -> streamIr.resolveProducer(context.ir) => source
                    source == bindingIndex -> if { true => consumed! }
                    source >= 0 and source < (context.ir -> len)
                        and context.ir[bindingIndex].operand0 >= 0
                        and source == context.ir[bindingIndex].operand0
                        -> if { true => consumed! }
                }
            junctionIndex! + 1 => junctionIndex!
        }
    consumed!
}
ownershipRegionContainsEdge regionIndex: Int, edgeNodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    edgeNodeIndex => edgeAncestor!
    false => contains!
    edgeAncestor! >= 0 and not contains! -> while {
        edgeAncestor! == regionIndex -> if {
            true => contains!
        } else {
            context.ir[edgeAncestor!].parent => edgeAncestor!
        }
    }
    contains!
}
bindingValueDominatesEdge valueIndex: Int, bindingRegion: Int, edgeNodeIndex: Int, emissionOrder: [Int], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    true => dominates!
    valueIndex >= 0 and edgeNodeIndex >= 0 and (emissionOrder -> len) > 0
        -> if {
            valueIndex => valueRoot!
            -1 => valueOrderPosition!
            valueRoot! >= 0 and valueOrderPosition! < 0
                -> while {
                    0 => valueOrderSearch!
                    valueOrderSearch! < (emissionOrder -> len) and valueOrderPosition! < 0
                        -> while {
                            emissionOrder[valueOrderSearch!] == valueRoot!
                                -> if { valueOrderSearch! => valueOrderPosition! }
                            valueOrderSearch! + 1 => valueOrderSearch!
                        }
                    valueOrderPosition! < 0 -> if { context.ir[valueRoot!].parent => valueRoot! }
                }
            edgeNodeIndex => edgeRoot!
            -1 => edgeOrderPosition!
            edgeRoot! >= 0 and edgeOrderPosition! < 0
                -> while {
                    0 => edgeOrderSearch!
                    edgeOrderSearch! < (emissionOrder -> len) and edgeOrderPosition! < 0
                        -> while {
                            emissionOrder[edgeOrderSearch!] == edgeRoot!
                                -> if { edgeOrderSearch! => edgeOrderPosition! }
                            edgeOrderSearch! + 1 => edgeOrderSearch!
                        }
                    edgeOrderPosition! < 0 -> if { context.ir[edgeRoot!].parent => edgeRoot! }
                }
            valueOrderPosition! >= 0
                and edgeOrderPosition! >= 0
                and valueOrderPosition! >= edgeOrderPosition!
                -> if {
                    false => dominates!
                }
        }
    # A synthetic region-end edge names the enclosing control owner. It is
    # after that region, whereas a real return nested in an initializer is not.
    (edgeNodeIndex >= 0 and (edgeNodeIndex -> ownershipRegionContainsEdge(bindingRegion, context, state))) => isRegionExit
    valueIndex => valueAncestor!
    valueAncestor! >= 0 and valueAncestor! != bindingRegion and dominates! and not isRegionExit
        -> while {
            (valueAncestor! -> ownershipRegionContainsEdge(edgeNodeIndex, context, state))
                or (edgeNodeIndex -> ownershipRegionContainsEdge(valueAncestor!, context, state))
                -> if {
                    false => dominates!
                } else {
                    context.ir[valueAncestor!].parent => valueAncestor!
                }
        }
    dominates!
}
emitOwnedDrops request: OwnedDropRequest, emissionOrder: [Int], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.pointerBitWidth / 8 => ownedPointerAlignment
    context.ir[request.regionIndex] => dropRegion
    UIntSize(0) => dropBeforeEnd!
    request.beforeAst >= 0 -> if {
        context.nodes[context.ranges[dropRegion.sourceModule].astStart + request.beforeAst] => dropEdgeAst
        dropEdgeAst.start + dropEdgeAst.length => dropBeforeEnd!
    }
    request.regionIndex => ownedDropOwner!
    ownedDropOwner! >= 0 and context.ir[ownedDropOwner!].kind != 0 and context.ir[ownedDropOwner!].kind != 11
        -> while {
            context.ir[ownedDropOwner!].parent => ownedDropOwner!
        }
    request.edgeIndex / 10 => ownedDropEdgeNode
    request.transferredSymbol => ownedTransferredSymbol!
    -1 => ownedTransferredValue!
    ownedDropEdgeNode >= 0 and ownedDropEdgeNode < (context.ir -> len)
        -> if {
            context.ir[ownedDropEdgeNode] => ownedDropControl
            ownedDropControl.kind == 23 -> if {
                ownedDropControl.operand0 => ownedTransferredValue!
            }
            # A used branch result leaves the region before its locals are dropped.
            request.beforeAst < 0 and ownedDropControl.kind == 18
                and ownedDropControl.nextOperand >= 0
                and not (ownedDropControl.typeOrigin == 1 and ownedDropControl.typeSymbol == 0)
                and (ownedDropEdgeNode -> controlValueUsed(ownedDropOwner!, context, state))
                -> if {
                    request.regionIndex -> regionResultValueIndex(context, state) => ownedTransferredValue!
                }
        }
    -1 => ownedTransferredBacking!
    ownedTransferredValue! >= 0
        -> if {
            ownedTransferredValue! -> ownedValueSourceIndex(context, state) => ownedTransferredBacking!
            context.ir[ownedDropEdgeNode].kind == 18
                and context.ir[ownedDropEdgeNode].typeId >= 0
                and context.types[context.ir[ownedDropEdgeNode].typeId].kind == 4
                -> if {
                    ownedTransferredValue! -> fixedBranchTransferredBacking(request.regionIndex, context, state) => ownedTransferredBacking!
                }
        }
    (ownedTransferredValue! >= 0
        -> if {
            ownedTransferredValue!
                -> returnedValueTransferredBindingRoots(context, state)
        } else {
            [Int; ~]
        }) => ownedTransferredRoots
    ownedDropEdgeNode >= 0 and ownedDropEdgeNode < (context.ir -> len) and context.ir[ownedDropEdgeNode].kind == 23 and context.ir[ownedDropEdgeNode].operand0 >= 0
        -> if {
            context.ir[ownedDropEdgeNode].operand0 -> returnedOwnedBindingIndex(context, state) => ownedReturnedBinding
            ownedReturnedBinding >= 0 and ownedReturnedBinding < (context.ir -> len)
                -> if {
                    context.ir[ownedReturnedBinding].symbol => ownedTransferredSymbol!
                }
        }
    ownedDropOwner! + 1 => ownedDropStart
    ownedDropOwner! -> functionEnd(context, state) => ownedDropIndex!
    ownedDropIndex! > ownedDropStart -> while {
        ownedDropIndex! - 1 => ownedDropIndex!
        context.ir[ownedDropIndex!] => ownedDropCandidate
        true => ownedDropBeforeEdge!
        request.beforeAst >= 0 -> if {
            (ownedDropCandidate -> sourceStart(context, state)) >= dropBeforeEnd!
                -> if { false => ownedDropBeforeEdge! }
        }
        ownedDropBeforeEdge!
            and ownedDropCandidate.kind == 17
            and ownedDropCandidate.operand0 >= 0
            and not (ownedDropCandidate.operand0 -> bindingValueDominatesEdge(request.regionIndex, ownedDropEdgeNode, emissionOrder, context, state))
            -> if {
                false => ownedDropBeforeEdge!
            }
        false => ownedDropMoved!
        state.frozenEnumMatchConsumed -> ownershipEmitter.enumMatchConsumes(ownedDropIndex!, ownedDropCandidate.kind, ownedDropCandidate.operand0)
            -> if { true => ownedDropMoved! }
        false => ownedDropHasPartialMoves!
        true => ownedDropIsRoot!
        ownedDropIndex! => ownedDropRoot!
        ownedDropCandidate.kind == 17 and ownedDropCandidate.parent == request.regionIndex and ((ownedDropCandidate -> ownsType) or (ownedDropCandidate.typeId >= 0 and (ownedDropCandidate.typeId -> semanticTypeOwns(context, state))))
            -> if {
                ownedDropIndex! -> mutableBindingRoot(context, state) => ownedDropRoot!
                ownedDropRoot! != ownedDropIndex! -> if { false => ownedDropIsRoot! }
            }
        ownedDropCandidate.kind == 17 and ((ownedDropCandidate -> ownsType) or (ownedDropCandidate.typeId >= 0 and (ownedDropCandidate.typeId -> semanticTypeOwns(context, state))))
            -> if {
                0 => ownedTransferredRootIndex!
                ownedTransferredRootIndex! < (ownedTransferredRoots -> len)
                    and not ownedDropMoved!
                    -> while {
                        ownedTransferredRoots[ownedTransferredRootIndex!] == ownedDropRoot!
                            -> if { true => ownedDropMoved! }
                        ownedTransferredRootIndex! + 1 => ownedTransferredRootIndex!
                    }
                ownedDropIndex! -> producerPipelineConsumesBinding(context, state)
                    -> if { true => ownedDropMoved! }
                0 => ownedMoveIndex!
                ownedMoveIndex! < (context.moves -> len) and not ownedDropMoved!
                    -> while {
                        context.moves[ownedMoveIndex!] => ownedMove
                        (ownedMove.regionIr == request.regionIndex or (ownedMove.regionIr -> ownershipRegionContainsEdge(ownedDropEdgeNode, context, state))) => ownedMoveOnEdge
                        # A partial move may originate in a nested control region on
                        # this early-return edge. Test activity in the move's own
                        # ownership region; the outer cleanup region cannot identify
                        # a field transferred inside the nested if/while path.
                        ownedMove.memberIr >= 0 and ownedMove.sourceModule == ownedDropCandidate.sourceModule and ownedMove.symbol == ownedDropCandidate.symbol and ownedMoveOnEdge and (ownedMoveIndex! -> partialMoveActiveBefore(ownedMove.regionIr, request.beforeAst, context, state))
                            -> if { true => ownedDropHasPartialMoves! }
                        ownedMove.memberIr < 0 and ownedMove.sourceModule == ownedDropCandidate.sourceModule and ownedMove.symbol == ownedDropCandidate.symbol and ownedMoveOnEdge
                            -> if {
                                context.ir[ownedMove.siteIr] => ownedMoveCall
                                true => ownedMoveBeforeEdge!
                                request.beforeAst >= 0 -> if {
                                    (ownedMoveCall -> sourceStart(context, state)) >= dropBeforeEnd!
                                        -> if { false => ownedMoveBeforeEdge! }
                                }
                                (ownedMoveCall -> sourceStart(context, state)) > (ownedDropCandidate -> sourceStart(context, state)) and ownedMoveBeforeEdge!
                                    -> if { true => ownedDropMoved! }
                            }
                        ownedMoveIndex! + 1 => ownedMoveIndex!
                    }
                # At a completed region, every continuing nested arm may have
                # transferred this owner. Early exits must use only moves on
                # their exact path, never later moves in the same region.
                request.beforeAst < 0 and not ownedDropMoved!
                    -> if {
                        request.regionIndex -> regionFullyMovesBinding(
                        ownedDropCandidate.sourceModule,
                        ownedDropCandidate.symbol,
                        ownedDropCandidate -> sourceStart(context, state),
                        context,
                        state)
                            -> if { true => ownedDropMoved! }
                    }
                ownedDropStart => ownedPutMoveIndex!
                ownedDropOwner! -> functionEnd(context, state) => ownedPutMoveEnd
                ownedPutMoveIndex! < ownedPutMoveEnd and not ownedDropMoved!
                    -> while {
                        context.ir[ownedPutMoveIndex!] => ownedPutMove
                        ownedPutMove.kind == 9 and (ownedPutMove.opcode == -223 or ownedPutMove.opcode == -303) and ownedPutMove.operand1 >= 0 and ownedPutMove.operand1 < (context.ir -> len)
                            -> if {
                                context.ir[ownedPutMove.operand1] => ownedPutMoveKey
                                ownedPutMoveKey.kind == 5 and ownedPutMoveKey.operand0 >= 0 and ownedPutMoveKey.operand0 < (context.ir -> len)
                                    -> if {
                                        ownedPutMoveKey.operand0 -> mutableBindingRoot(context, state) => ownedPutMoveKeyRoot
                                        true => ownedPutKeyBeforeEdge!
                                        request.beforeAst >= 0 -> if {
                                            (ownedPutMove -> sourceStart(context, state)) >= dropBeforeEnd!
                                                -> if { false => ownedPutKeyBeforeEdge! }
                                        }
                                        ownedPutMoveKeyRoot == ownedDropRoot! and (ownedPutMove -> sourceStart(context, state)) > (ownedDropCandidate -> sourceStart(context, state)) and ownedPutKeyBeforeEdge!
                                            -> if {
                                                true => ownedDropMoved!
                                            }
                                    }
                                ownedPutMoveKey.nextOperand => ownedPutMoveValueIndex
                                ownedPutMoveValueIndex >= 0 and ownedPutMoveValueIndex < (context.ir -> len)
                                    -> if {
                                        context.ir[ownedPutMoveValueIndex] => ownedPutMoveValue
                                        ownedPutMoveValue.kind == 5 and ownedPutMoveValue.operand0 >= 0 and ownedPutMoveValue.operand0 < (context.ir -> len)
                                            -> if {
                                                ownedPutMoveValue.operand0 -> mutableBindingRoot(context, state) => ownedPutMoveRoot
                                                true => ownedPutMoveBeforeEdge!
                                                request.beforeAst >= 0 -> if {
                                                    (ownedPutMove -> sourceStart(context, state)) >= dropBeforeEnd!
                                                        -> if { false => ownedPutMoveBeforeEdge! }
                                                }
                                                ownedPutMoveRoot == ownedDropRoot! and (ownedPutMove -> sourceStart(context, state)) > (ownedDropCandidate -> sourceStart(context, state)) and ownedPutMoveBeforeEdge!
                                                    -> if {
                                                        true => ownedDropMoved!
                                                    }
                                            }
                                    }
                            }
                        ownedPutMoveIndex! + 1 => ownedPutMoveIndex!
                    }
            }
        ownedDropIndex! => cleanupBindingIndex
        ownedDropCandidate.operand0 => ownedDropValueIndex!
        ownedDropCandidate.kind == 17 and ownedDropCandidate.operand0 >= 0
            -> if {
                ownedDropCandidate.operand0 -> callResultPropagationBindingIndex(context, state) => ownedDropPropagationBinding
                ownedDropPropagationBinding == ownedDropIndex!
                    -> if { ownedDropIndex! => ownedDropValueIndex! }
            }
        -1 => ownedDropParameterIndex!
        ownedDropCandidate.kind == 17 and ownedDropCandidate.flags != 1
            -> if {
                ownedDropIndex! -> owningBindingSourceParameterSymbol(ownedDropOwner!, context, state)
                    => ownedDropParameterSymbol
                ownedDropParameterSymbol >= 0 -> if {
                    context -> parameterIndexForFunction(ownedDropOwner!, ownedDropParameterSymbol)
                        => ownedDropParameterIndex!
                }
            }
        ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved! and not ownedDropHasPartialMoves! and ownedDropCandidate.kind == 17 and ownedDropCandidate.parent == request.regionIndex and ownedDropCandidate.typeId >= 0 and (ownedDropCandidate.typeId -> semanticTypeOwns(context, state)) and ownedDropCandidate.symbol != ownedTransferredSymbol!
            -> if {
                false => ownedDropNeedsInlineArrayReload!
                false => ownedDropHasInlineArrayAbi!
                context.types[ownedDropCandidate.typeId].kind == 4
                    -> if { true => ownedDropHasInlineArrayAbi! }
                (ownedDropCandidate.flags != 1 or (ownedDropValueIndex! -> promotedFixedArrayCall(context, state)) >= 0)
                    and ownedDropHasInlineArrayAbi!
                    and ownedDropValueIndex! >= 0
                    and ownedDropValueIndex! < (context.ir -> len)
                    and (context.ir[ownedDropValueIndex!].kind == 14 or (ownedDropValueIndex! -> promotedFixedArrayCall(context, state)) >= 0)
                    -> if {
                        true => ownedDropNeedsInlineArrayReload!
                        "  " -> print
                        request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                        "_fixed_data = extractvalue { ptr, i64 } %v$(ownedDropValueIndex!), 0" -> println
                        "  " -> print
                        request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                        "_fixed = load " -> print
                        ownedDropCandidate.typeId -> writeSemanticTypeId(context, state)
                        ", ptr " -> print
                        request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                        "_fixed_data, align " -> print
                        context.typeAligns[ownedDropCandidate.typeId] -> writeDecimalLine
                    }
                ownedDropCandidate.flags == 1 and not ownedDropNeedsInlineArrayReload!
                    -> if {
                        "  " -> print
                        request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                        "_current = load " -> print
                        ownedDropCandidate.typeId -> writeSemanticTypeId(context, state)
                        ", ptr %slot$(ownedDropRoot!), align " -> print
                        ownedDropCandidate -> storageAlign(context, state) -> writeDecimalLine
                    }
                "  call void @sollang_drop_t$(ownedDropCandidate.typeId)(" -> print
                ownedDropCandidate.typeId -> writeSemanticTypeId(context, state)
                " " -> print
                ownedDropCandidate.flags == 1 and not ownedDropNeedsInlineArrayReload!
                    -> if {
                        request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                        "_current" -> print
                    } else {
                        ownedDropNeedsInlineArrayReload! -> if {
                            request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                            "_fixed" -> print
                        } else {
                            ownedDropValueIndex! -> writeCleanupValueName(ownedDropParameterIndex!, ownedDropOwner!, context, state)
                        }
                    }
                ")" -> println
            }
        ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved! and ownedDropCandidate.kind == 17 and ownedDropCandidate.parent == request.regionIndex and ownedDropCandidate.typeId < 0 and (ownedDropCandidate -> isDynamicArrayType) and ownedDropCandidate.symbol != ownedTransferredSymbol!
            -> if {
                ownedDropCandidate.flags == 1 -> if {
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_current = load %sollang.array.i32, ptr %slot$(ownedDropRoot!), align " -> print
                    ownedDropCandidate -> storageAlign(context, state) -> writeDecimalLine
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    " = extractvalue %sollang.array.i32 " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_current, 0" -> println
                } else {
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    " = extractvalue %sollang.array.i32 " -> print
                    ownedDropValueIndex! -> writeCleanupValueName(ownedDropParameterIndex!, ownedDropOwner!, context, state)
                    ", 0" -> println
                }
                "  call void @free(ptr " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                ")" -> println
            }
        ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved! and ownedDropCandidate.kind == 17 and ownedDropCandidate.parent == request.regionIndex and ownedDropCandidate.typeId < 0 and (ownedDropCandidate -> isDictionaryType) and ownedDropCandidate.symbol != ownedTransferredSymbol!
            -> if {
                ownedDropCandidate.flags == 1 -> if {
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_current = load %sollang.dict, ptr %slot$(ownedDropRoot!), align " -> print
                    ownedDropCandidate -> storageAlign(context, state) -> writeDecimalLine
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_keys = extractvalue %sollang.dict " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_current, 0" -> println
                } else {
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_keys = extractvalue %sollang.dict " -> print
                    ownedDropValueIndex! -> writeCleanupValueName(ownedDropParameterIndex!, ownedDropOwner!, context, state)
                    ", 0" -> println
                }
                "  call void @free(ptr " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_keys)" -> println
                ownedDropCandidate.flags == 1 -> if {
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_values = extractvalue %sollang.dict " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_current, 1" -> println
                } else {
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_values = extractvalue %sollang.dict " -> print
                    ownedDropValueIndex! -> writeCleanupValueName(ownedDropParameterIndex!, ownedDropOwner!, context, state)
                    ", 1" -> println
                }
                "  call void @free(ptr " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_values)" -> println
            }
        ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved! and ownedDropCandidate.kind == 17 and ownedDropCandidate.parent == request.regionIndex and ownedDropCandidate.typeId < 0 and ownedDropCandidate.typeOrigin == 16 and ownedDropCandidate.symbol != ownedTransferredSymbol!
            -> if {
                ownedDropCandidate.flags == 1 -> if {
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_current = load %sollang.dyn, ptr %slot$(ownedDropRoot!), align $ownedPointerAlignment" -> println
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_data = extractvalue %sollang.dyn " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_current, 0" -> println
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_vtable = extractvalue %sollang.dyn " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_current, 1" -> println
                } else {
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_data = extractvalue %sollang.dyn " -> print
                    ownedDropValueIndex! -> writeCleanupValueName(ownedDropParameterIndex!, ownedDropOwner!, context, state)
                    ", 0" -> println
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_vtable = extractvalue %sollang.dyn " -> print
                    ownedDropValueIndex! -> writeCleanupValueName(ownedDropParameterIndex!, ownedDropOwner!, context, state)
                    ", 1" -> println
                }
                "  " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_drop_slot = getelementptr ptr, ptr " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_vtable, i64 0" -> println
                "  " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_drop = load ptr, ptr " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_drop_slot, align $ownedPointerAlignment" -> println
                "  call void " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_drop(ptr " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_data)" -> println
            }
        ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved! and ownedDropCandidate.kind == 17 and ownedDropCandidate.parent == request.regionIndex and (ownedDropCandidate.typeId < 0 or ownedDropHasPartialMoves!) and (ownedDropCandidate -> isGenericEnumType) and ownedDropCandidate.symbol != ownedTransferredSymbol!
            -> if {
                0 => ownedEnumValueKind!
                ownedDropParameterIndex! >= 0 -> if { 3 => ownedEnumValueKind! }
                ownedDropCandidate.flags == 1 -> if { 2 => ownedEnumValueKind! }
                EnumDropRequest {
                    typeId: ownedDropCandidate.typeId
                    valueKind: ownedEnumValueKind!
                    valueIndex: ownedDropCandidate.flags == 1 -> if { ownedDropRoot! } else {
                        ownedDropParameterIndex! >= 0 -> if { ownedDropParameterIndex! } else { ownedDropValueIndex! }
                    }
                    nameRoot: request.edgeIndex * 1000 + ownedDropIndex!
                    bindingIndex: ownedDropIndex!
                    regionIndex: request.regionIndex
                } -> emitEnumDrop(context, state)
            }
        ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved! and ownedDropCandidate.kind == 17 and ownedDropCandidate.parent == request.regionIndex and (ownedDropCandidate.typeId < 0 or ownedDropHasPartialMoves!) and (ownedDropCandidate -> isNominalStructType) and ownedDropCandidate.symbol != ownedTransferredSymbol!
            -> if {
                request.edgeIndex * 1000 + ownedDropIndex! => ownedDropNameRoot
                ownedDropCandidate.flags == 1 -> if {
                    "  %dropg$(ownedDropNameRoot)_p0 = load %sollang.struct.m$(ownedDropCandidate.typeModule)_s$(ownedDropCandidate.typeSymbol), ptr %slot$(ownedDropRoot!), align " -> print
                    ownedDropCandidate -> storageAlign(context, state) -> writeDecimalLine
                }
                0 => ownedDropValueKind!
                ownedDropParameterIndex! >= 0 -> if { 3 => ownedDropValueKind! }
                ownedDropCandidate.flags == 1 -> if { 2 => ownedDropValueKind! }
                DropGlueRequest {
                    typeId: ownedDropCandidate.typeId
                    typeOrigin: ownedDropCandidate.typeOrigin
                    typeModule: ownedDropCandidate.typeModule
                    typeSymbol: ownedDropCandidate.typeSymbol
                    valueKind: ownedDropValueKind!
                    valueIndex: ownedDropParameterIndex! >= 0 -> if { ownedDropParameterIndex! } else { ownedDropValueIndex! }
                    nameRoot: ownedDropNameRoot
                    pathCode: 0
                    bindingIndex: ownedDropIndex!
                    regionIndex: request.regionIndex
                    beforeAst: request.beforeAst
                    parentTask: -1
                    fieldOrdinal: -1
                    hasPartialMoves: ownedDropHasPartialMoves!
                } -> emitDropGlue(ownedDropEdgeNode, context, state)
            }
        ownedDropIndex! -> bindingPromotedFixedArrayCall(context, state) => ownedBackingCall
        ownedBackingCall >= 0 and ownedDropBeforeEdge! and ownedDropCandidate.parent == request.regionIndex and ownedBackingCall != ownedTransferredBacking!
            and ownedDropCandidate.symbol != ownedTransferredSymbol!
            -> if {
                ownedBackingCall -> emitPromotedFixedBackingDrop(request.edgeIndex)
            }
    }
}
