                                            "  br label %if$(valueNodeIndex -> valueNameId(state))_merge" -> println
                                            "if$(valueNodeIndex -> valueNameId(state))_merge:" -> println
                                            "  %while$(whileIndex -> valueNameId(state))_v$(valueNodeIndex -> valueNameId(state)) = load " -> print
                                            valueNode -> writeIrType(context, state)
                                            ", ptr %if$(valueNodeIndex -> valueNameId(state))_result, align " -> print
                                            valueNode -> storageAlign(context, state) -> writeDecimalLine
                                        }
                                    valueNode.kind == 8 and (valueNode.operand0 < 0 or valueNode.operand1 < 0)
                                        -> if {
                                            "; invalid while binary ir=$(valueNodeIndex) op0=$(valueNode.operand0) op1=$(valueNode.operand1) opcode=$(valueNode.opcode)" -> println
                                        }
                                    (valueNode.kind == 7 and valueNode.operand0 >= 0) or (valueNode.kind == 8 and valueNode.opcode != -24 and valueNode.opcode != -25 and valueNode.operand0 >= 0 and valueNode.operand1 >= 0)
                                        -> if {
                                            context.ir[valueNode.operand0] => left
                                            0 => whileBinaryWidth!
                                            false => whileLeftPromoted!
                                            false => whileRightPromoted!
                                            valueNode.kind == 8 -> if {
                                                context.ir[valueNode.operand1] => whileRight
                                                left -> integerNodeWidth(context, state) => whileLeftWidth
                                                whileRight -> integerNodeWidth(context, state) => whileRightWidth
                                                whileLeftWidth > 0 and whileRightWidth > 0 -> if {
                                                    whileLeftWidth > whileRightWidth -> if { whileLeftWidth => whileBinaryWidth! } else { whileRightWidth => whileBinaryWidth! }
                                                    whileLeftWidth < whileBinaryWidth! and left.kind != 3 and left.kind != 4
                                                        -> if {
                                                            "  %while$(whileIndex -> valueNameId(state))_v$(valueNodeIndex -> valueNameId(state))_left_wide = " -> print
                                                            left -> integerNodeSigned(context, state) -> if { "sext" -> print } else { "zext" -> print }
                                                            " i$(whileLeftWidth) " -> print
                                                            WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand0 } -> writeWhileValue(context, state)
                                                            " to i$(whileBinaryWidth!)" -> println
                                                            true => whileLeftPromoted!
                                                        }
                                                    whileRightWidth < whileBinaryWidth! and whileRight.kind != 3 and whileRight.kind != 4
                                                        -> if {
                                                            "  %while$(whileIndex -> valueNameId(state))_v$(valueNodeIndex -> valueNameId(state))_right_wide = " -> print
                                                            whileRight -> integerNodeSigned(context, state)
                                                                -> if { "sext" -> print } else { "zext" -> print }
                                                            " i$(whileRightWidth) " -> print
                                                            WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand1 } -> writeWhileValue(context, state)
                                                            " to i$(whileBinaryWidth!)" -> println
                                                            true => whileRightPromoted!
                                                        }
                                                }
                                            }
                                            valueNode.kind == 8
                                                and (valueNode.opcode == grammar.tokenIdEqualEqual() or valueNode.opcode == grammar.tokenIdBangEqual())
                                                and (valueNode.operand0 -> comparisonReadIsText(context))
                                                and (valueNode.operand1 -> comparisonReadIsText(context)) => whileTextEquality
                                            whileTextEquality -> if {
                                                valueNodeIndex -> emitDeferredTextComparisonOperands(ownerIndex, context, state)
                                                valueNode.opcode == grammar.tokenIdBangEqual()
                                                    -> if {
                                                        "  %while$(whileIndex -> valueNameId(state))_v$(valueNodeIndex -> valueNameId(state))_text_equal = call i1 @sollang_text_equal(%sollang.text " -> print
                                                    } else {
                                                        "  %while$(whileIndex -> valueNameId(state))_v$(valueNodeIndex -> valueNameId(state)) = call i1 @sollang_text_equal(%sollang.text " -> print
                                                    }
                                                valueNode.operand0 -> writeTextComparisonOperand(valueNodeIndex, ownerIndex, 0, whileIndex, context, state)
                                                ", %sollang.text " -> print
                                                valueNode.operand1 -> writeTextComparisonOperand(valueNodeIndex, ownerIndex, 1, whileIndex, context, state)
                                                ")" -> println
                                                valueNode.opcode == grammar.tokenIdBangEqual()
                                                    -> if {
                                                        "  %while$(whileIndex -> valueNameId(state))_v$(valueNodeIndex -> valueNameId(state)) = xor i1 %while$(whileIndex -> valueNameId(state))_v$(valueNodeIndex -> valueNameId(state))_text_equal, true" -> println
                                                    }
                                            } else {
                                                "  %while$(whileIndex -> valueNameId(state))_v$(valueNodeIndex -> valueNameId(state)) = " -> print
                                                valueNode.kind == 7 -> if {
                                                    valueNode.opcode -> numericUnaryOperation(left.typeSymbol) -> print
                                                } else { ((valueNode -> isValueComparison) and (valueNode.operand0 -> comparisonReadIsFloat(context)))
                                                        or (left.typeOrigin == 1 and left.typeSymbol >= 19 and left.typeSymbol <= 22)
                                                        -> if {
                                                            valueNode.opcode -> floatBinaryOperation -> print
                                                        } else {
                                                            valueNode.opcode == grammar.tokenIdPlus() -> if { "add" -> print }
                                                            valueNode.opcode == grammar.tokenIdMinus() -> if { "sub" -> print }
                                                            valueNode.opcode == grammar.tokenIdStar() -> if { "mul" -> print }
                                                            valueNode.opcode == grammar.tokenIdSlash() -> if { valueNode -> integerQuotientOperation(context, state) -> print }
                                                            valueNode.opcode == grammar.tokenIdPercent()
                                                                -> if { valueNode -> integerRemainderOperation(context, state) -> print }
                                                            valueNode.opcode == grammar.tokenIdEqualEqual()
                                                                -> if { "icmp eq" -> print }
                                                            valueNode.opcode == grammar.tokenIdBangEqual()
                                                                -> if { "icmp ne" -> print }
                                                            valueNode.opcode == grammar.tokenIdLess() or valueNode.opcode == grammar.tokenIdLessEqual() or valueNode.opcode == grammar.tokenIdGreater() or valueNode.opcode == grammar.tokenIdGreaterEqual()
                                                                -> if {
                                                                    valueNode -> integerComparisonOperation(context, state) -> print
                                                                }
                                                            valueNode.opcode == -24 -> if { "or" -> print }
                                                            valueNode.opcode == -25 -> if { "and" -> print }
                                                    } }
                                                " " -> print
                                                valueNode -> isValueComparison -> if {
                                                    valueNode.operand0 -> comparisonReadTypeId(context) -> writeAggregateFieldTypeId(context, state)
                                                } else { whileBinaryWidth! > 0 -> if { "i$(whileBinaryWidth!)" -> print } else { valueNode.kind == 7
                                                            -> if { valueNode -> writeIrType(context, state) } else { left -> writeIrType(context, state) } } }
                                                " " -> print
                                                valueNode.kind == 7 -> if {
                                                    valueNode.opcode == -26 -> if {
                                                        WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand0 } -> writeWhileValue(context, state)
                                                        ", true" -> println
                                                    } else {
                                                        left.typeSymbol -> numericUnaryZero -> print
                                                        ", " -> print
                                                        WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand0 } -> writeWhileValue(context, state)
                                                        "" -> println
                                                    }
                                                } else {
                                                    valueNode -> isValueComparison -> if {
                                                        valueNode.operand0 -> writeComparisonOperandValue(ownerIndex, whileIndex, context, state)
                                                    } else { whileLeftPromoted! -> if { "%while$(whileIndex -> valueNameId(state))_v$(valueNodeIndex -> valueNameId(state))_left_wide" -> print } else {
                                                            WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand0 } -> writeWhileValue(context, state)
                                                    } }
                                                    ", " -> print
                                                    valueNode -> isValueComparison -> if {
                                                        valueNode.operand1 -> writeComparisonOperandValue(ownerIndex, whileIndex, context, state)
                                                    } else { whileRightPromoted! -> if { "%while$(whileIndex -> valueNameId(state))_v$(valueNodeIndex -> valueNameId(state))_right_wide" -> print } else {
                                                            WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueNode.operand1 } -> writeWhileValue(context, state)
                                                    } }
                                                    "" -> println
                                                }
                                            }
                                        }
                                }
                            }
                            "  br i1 " -> print
                            WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: boolNodeIndex! } -> writeWhileValue(context, state)
                            ", label %" -> print
                            boolTask.trueKind == 0 -> if { "while$(whileIndex -> valueNameId(state))_body" -> print }
                            boolTask.trueKind == 1 -> if { "while$(whileIndex -> valueNameId(state))_exit" -> print }
                            boolTask.trueKind == 2 -> if { "while$(whileIndex -> valueNameId(state))_bool$(boolTask.trueNode)_rhs" -> print }
                            ", label %" -> print
                            boolTask.falseKind == 0 -> if { "while$(whileIndex -> valueNameId(state))_body" -> print }
                            boolTask.falseKind == 1 -> if { "while$(whileIndex -> valueNameId(state))_exit" -> print }
                            boolTask.falseKind == 2 -> if { "while$(whileIndex -> valueNameId(state))_bool$(boolTask.falseNode)_rhs" -> print }
                            "" -> println
                        }
                }
        }
    }
}

# Logical operators are values, but their right operand is evaluated only along
# the branch selected by the left operand. Reuse the condition tree emitter and
# merge its true/false exits into the SSA value expected for the logical node.
emitLogicalValue logicalIndex: Int, ownerIndex: Int, emissionOrder: [Int], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    WhileBranchRequest { whileIndex: logicalIndex, ownerIndex: ownerIndex, conditionIndex: logicalIndex } -> emitWhileBranch(emissionOrder, context, state)
    "while$(logicalIndex -> valueNameId(state))_body:" -> println
    "  br label %logical$(logicalIndex)_merge" -> println
    "while$(logicalIndex -> valueNameId(state))_exit:" -> println
    "  br label %logical$(logicalIndex)_merge" -> println
    "logical$(logicalIndex)_merge:" -> println
    "  %v$(logicalIndex -> valueNameId(state)) = phi i1 [ true, %while$(logicalIndex -> valueNameId(state))_body ], [ false, %while$(logicalIndex -> valueNameId(state))_exit ]" -> println
}

writeCleanupName edgeIndex: Int, bindingIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    "%cleanup" -> print
    edgeIndex -> writeDecimal
    "_b" -> print
    bindingIndex -> writeDecimal
}
producerPipelineConsumesBinding bindingIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => consumed!
    0 => pipelineIndex!
    pipelineIndex! < (context.streamPlan.pipelines -> len) and not consumed!
        -> while {
            context.streamPlan.pipelines[pipelineIndex!] => pipeline
            pipeline.status > 0 and pipeline.status < 3 -> if {
                pipeline.source0 == bindingIndex -> if { true => consumed! }
                pipeline.source0 >= 0 and pipeline.source0 < (context.ir -> len)
                    -> if {
                        context.ir[pipeline.source0] => source
                        source.kind == 5 and source.operand0 == bindingIndex
                            -> if { true => consumed! }
                        context.ir[bindingIndex].operand0 >= 0 and pipeline.source0 == context.ir[bindingIndex].operand0
                            -> if { true => consumed! }
                    }
            }
            pipelineIndex! + 1 => pipelineIndex!
        }
    0 => junctionIndex!
    junctionIndex! < (context.streamPlan.junctions -> len) and not consumed!
        -> while {
            context.streamPlan.junctions[junctionIndex!] => junction
            junction.kind == 1 and junction.status > 0 and junction.status < 3
                -> if {
                    junction.source0 -> streamIr.resolveProducer(context.ir) => source
                    source == bindingIndex -> if { true => consumed! }
                    source >= 0 and source < (context.ir -> len)
                        and context.ir[bindingIndex].operand0 >= 0
                        and source == context.ir[bindingIndex].operand0
                        -> if { true => consumed! }
                }
            junctionIndex! + 1 => junctionIndex!
        }
    consumed!
}
ownershipRegionContainsEdge regionIndex: Int, edgeNodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    edgeNodeIndex => edgeAncestor!
    false => contains!
    edgeAncestor! >= 0 and not contains! -> while {
        edgeAncestor! == regionIndex -> if {
            true => contains!
        } else {
            context.ir[edgeAncestor!].parent => edgeAncestor!
        }
    }
    contains!
}
bindingValueDominatesEdge valueIndex: Int, bindingRegion: Int, edgeNodeIndex: Int, emissionOrder: [Int], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    true => dominates!
    false => whenRegionExit!
    edgeNodeIndex >= 0 and (context.ir[edgeNodeIndex].kind == 33 or context.ir[edgeNodeIndex].kind == 34 or context.ir[edgeNodeIndex].kind == 27)
        and (edgeNodeIndex -> ownershipRegionContainsEdge(bindingRegion, context, state))
        -> if { true => whenRegionExit! }
    valueIndex >= 0 and edgeNodeIndex >= 0 and (emissionOrder -> len) > 0 and not whenRegionExit!
        -> if {
            valueIndex => valueRoot!
            -1 => valueOrderPosition!
            valueRoot! >= 0 and valueOrderPosition! < 0
                -> while {
                    0 => valueOrderSearch!
                    valueOrderSearch! < (emissionOrder -> len) and valueOrderPosition! < 0
                        -> while {
                            emissionOrder[valueOrderSearch!] == valueRoot!
                                -> if { valueOrderSearch! => valueOrderPosition! }
                            valueOrderSearch! + 1 => valueOrderSearch!
                        }
                    valueOrderPosition! < 0 -> if { context.ir[valueRoot!].parent => valueRoot! }
                }
            edgeNodeIndex => edgeRoot!
            -1 => edgeOrderPosition!
            edgeRoot! >= 0 and edgeOrderPosition! < 0
                -> while {
                    0 => edgeOrderSearch!
                    edgeOrderSearch! < (emissionOrder -> len) and edgeOrderPosition! < 0
                        -> while {
                            emissionOrder[edgeOrderSearch!] == edgeRoot!
                                -> if { edgeOrderSearch! => edgeOrderPosition! }
                            edgeOrderSearch! + 1 => edgeOrderSearch!
                        }
                    edgeOrderPosition! < 0 -> if { context.ir[edgeRoot!].parent => edgeRoot! }
                }
            valueOrderPosition! >= 0
                and edgeOrderPosition! >= 0
                and valueOrderPosition! >= edgeOrderPosition!
                -> if {
                    false => dominates!
                }
        }
    # A synthetic region-end edge names the enclosing control owner. It is
    # after that region, whereas a real return nested in an initializer is not.
    ((edgeNodeIndex >= 0 and (edgeNodeIndex -> ownershipRegionContainsEdge(bindingRegion, context, state)))
        or whenRegionExit!) => isRegionExit
    valueIndex => valueAncestor!
    valueAncestor! >= 0 and valueAncestor! != bindingRegion and dominates! and not isRegionExit
        -> while {
            (valueAncestor! -> ownershipRegionContainsEdge(edgeNodeIndex, context, state))
                or (edgeNodeIndex -> ownershipRegionContainsEdge(valueAncestor!, context, state))
                -> if {
                    false => dominates!
                } else {
                    context.ir[valueAncestor!].parent => valueAncestor!
                }
        }
    dominates!
}
emitCompletedParallelCallbackDrops expressionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    OwnedDropRequest { regionIndex: expressionIndex, beforeAst: -1, edgeIndex: expressionIndex * 10 + 7, transferredSymbol: -1 } -> emitOwnedDrops([Int; ~], context, state)
}

emitOwnedDrops request: OwnedDropRequest, emissionOrder: [Int], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.pointerBitWidth / 8 => ownedPointerAlignment
    context.ir[request.regionIndex] => dropRegion
    UIntSize(0) => dropBeforeEnd!
    request.beforeAst >= 0 -> if {
        context.nodes[context.ranges[dropRegion.sourceModule].astStart + request.beforeAst] => dropEdgeAst
        dropEdgeAst.start + dropEdgeAst.length => dropBeforeEnd!
    }
    request.regionIndex => ownedDropOwner!
    ownedDropOwner! >= 0 and context.ir[ownedDropOwner!].kind != 0 and context.ir[ownedDropOwner!].kind != 11
        -> while {
            context.ir[ownedDropOwner!].parent => ownedDropOwner!
        }
    request.edgeIndex / 10 => ownedDropEdgeNode
    request.transferredSymbol => ownedTransferredSymbol!
    -1 => ownedTransferredValue!
    ownedDropEdgeNode >= 0 and ownedDropEdgeNode < (context.ir -> len)
        -> if {
            context.ir[ownedDropEdgeNode] => ownedDropControl
            ownedDropControl.kind == 23 -> if {
                ownedDropControl.operand0 => ownedTransferredValue!
            }
            ownedDropControl -> isUserBlockScope -> if {
                ownedDropControl.operand1 => ownedTransferredValue!
            }
            ownedDropControl.kind == 6 and (ownedDropControl.opcode == -207 or ownedDropControl.opcode == -209)
                -> if {
                    ownedDropControl.operand1 => ownedTransferredValue!
                }
            # A used branch result leaves the region before its locals are dropped.
            request.beforeAst < 0
                and ((ownedDropControl.kind == 18 and ownedDropControl.nextOperand >= 0)
                or ((ownedDropControl.kind == 33 or ownedDropControl.kind == 34) and ownedDropControl.operand0 >= 0)
                or (ownedDropControl.kind == 27 and ownedDropControl.operand1 >= 0))
                and not (ownedDropControl.typeOrigin == 1 and ownedDropControl.typeSymbol == 0)
                and (ownedDropEdgeNode -> controlValueUsed(ownedDropOwner!, context, state))
                -> if {
                    request.regionIndex -> regionResultValueIndex(context, state) => ownedTransferredValue!
                }
        }
    false => ownedReturnCopiesFixedBacking!
    ownedTransferredValue! >= 0 and ownedDropOwner! >= 0
        and ownedDropEdgeNode >= 0 and ownedDropEdgeNode < (context.ir -> len)
        and context.ir[ownedDropEdgeNode].kind == 23
        -> if {
            context.ir[ownedDropOwner!].typeId => ownedReturnTypeId
            ownedReturnTypeId >= 0 and context.types[ownedReturnTypeId].kind == 4
                and not (ownedReturnTypeId -> semanticTypeOwns(context, state))
                and (ownedTransferredValue! -> fixedArrayReturnNeedsPromotion(ownedDropOwner!, context, state))
                -> if {
                    true => ownedReturnCopiesFixedBacking!
                    -1 => ownedTransferredValue!
                    -1 => ownedTransferredSymbol!
                }
        }
    -1 => ownedTransferredBacking!
    ownedTransferredValue! >= 0
        -> if {
            ownedTransferredValue! -> ownedValueSourceIndex(context, state) => ownedTransferredBacking!
            context.ir[ownedDropEdgeNode].kind == 18
                and context.ir[ownedDropEdgeNode].typeId >= 0
                and context.types[context.ir[ownedDropEdgeNode].typeId].kind == 4
                -> if {
                    ownedTransferredValue! -> fixedBranchTransferredBacking(request.regionIndex, context, state) => ownedTransferredBacking!
                }
        }
    (ownedTransferredValue! >= 0
        -> if {
            ownedTransferredValue!
                -> returnedValueTransferredBindingRoots(context, state)
        } else {
            [Int; ~]
        }) => ownedTransferredRoots
    not ownedReturnCopiesFixedBacking! and ownedDropEdgeNode >= 0 and ownedDropEdgeNode < (context.ir -> len) and context.ir[ownedDropEdgeNode].kind == 23 and context.ir[ownedDropEdgeNode].operand0 >= 0
        -> if {
            context.ir[ownedDropEdgeNode].operand0 -> returnedOwnedBindingIndex(context, state) => ownedReturnedBinding
            ownedReturnedBinding >= 0 and ownedReturnedBinding < (context.ir -> len)
                -> if {
                    context.ir[ownedReturnedBinding].symbol => ownedTransferredSymbol!
                }
        }
    ownedDropOwner! + 1 => ownedDropStart
    ownedDropOwner! -> functionEnd(context, state) => ownedDropIndex!
    ownedDropIndex! > ownedDropStart -> while {
        ownedDropIndex! - 1 => ownedDropIndex!
        context.ir[ownedDropIndex!] => ownedDropCandidate
        # An explicit return exits the active match arm as well as its body.
        # Fallthrough payload cleanup remains owned by emitEnumMatch.
        (request.beforeAst >= 0
            and ownedDropEdgeNode >= 0 and ownedDropEdgeNode < (context.ir -> len)
            and context.ir[ownedDropEdgeNode].kind == 23
            and ownedDropCandidate.kind == 29
            and (ownedDropIndex! -> patternBindingOwnsPayload(context, state))) => ownedDropIsPattern
        (ownedDropCandidate.kind == 17 or ownedDropIsPattern) => ownedDropCandidateIsBinding
        true => ownedDropBeforeEdge!
        request.beforeAst >= 0 -> if {
            (ownedDropCandidate -> sourceStart(context, state)) >= dropBeforeEnd!
                -> if { false => ownedDropBeforeEdge! }
        }
        ownedDropBeforeEdge!
            and ownedDropCandidate.kind == 17
            and ownedDropCandidate.operand0 >= 0
            and not (ownedDropCandidate.operand0 -> bindingValueDominatesEdge(request.regionIndex, ownedDropEdgeNode, emissionOrder, context, state))
            -> if {
                false => ownedDropBeforeEdge!
            }
        false => ownedDropMoved!
        ownedDropIndex! -> isUserBlockBorrowedRoleBinding(context)
            -> if { true => ownedDropMoved! }
        state.frozenEnumMatchConsumed -> ownershipEmitter.enumMatchConsumes(ownedDropIndex!, ownedDropCandidate.kind, ownedDropCandidate.operand0)
            -> if { true => ownedDropMoved! }
        false => ownedDropHasPartialMoves!
        false => ownedFixedBackingReleased!
        true => ownedDropIsRoot!
        ownedDropIndex! => ownedDropRoot!
        ownedDropCandidateIsBinding and ownedDropCandidate.parent == request.regionIndex and ((ownedDropCandidate -> ownsType) or (ownedDropCandidate.typeId >= 0 and ((ownedDropCandidate.typeId < (context.types -> len) and context.types[ownedDropCandidate.typeId].kind == 4) or (ownedDropCandidate.typeId -> semanticTypeOwns(context, state)) or (ownedDropCandidate.typeId -> directCopyableFixedStructType(context)))))
            -> if {
                ownedDropIndex! -> mutableBindingRoot(context, state) => ownedDropRoot!
                ownedDropRoot! != ownedDropIndex! -> if { false => ownedDropIsRoot! }
            }
        ownedDropCandidateIsBinding and ((ownedDropCandidate -> ownsType) or (ownedDropCandidate.typeId >= 0 and ((ownedDropCandidate.typeId < (context.types -> len) and context.types[ownedDropCandidate.typeId].kind == 4) or (ownedDropCandidate.typeId -> semanticTypeOwns(context, state)) or (ownedDropCandidate.typeId -> directCopyableFixedStructType(context)))))
            -> if {
                0 => ownedTransferredRootIndex!
                ownedTransferredRootIndex! < Int(ownedTransferredRoots -> len)
                    and not ownedDropMoved!
                    -> while {
                        ownedTransferredRoots[ownedTransferredRootIndex!] == ownedDropRoot!
                            -> if { true => ownedDropMoved! }
                        ownedTransferredRootIndex! + 1 => ownedTransferredRootIndex!
                    }
                ownedDropIndex! -> producerPipelineConsumesBinding(context, state)
                    -> if { true => ownedDropMoved! }
                0 => ownedMoveIndex!
                ownedMoveIndex! < (context.moves -> len) and not ownedDropMoved!
                    -> while {
                        context.moves[ownedMoveIndex!] => ownedMove
                        (ownedMove.regionIr == request.regionIndex or (ownedMove.regionIr -> ownershipRegionContainsEdge(ownedDropEdgeNode, context, state))) => ownedMoveOnEdge
                        # A partial move may originate in a nested control region on
                        # this early-return edge. Test activity in the move's own
                        # ownership region; the outer cleanup region cannot identify
                        # a field transferred inside the nested if/while path.
                        ownedMove.memberIr >= 0 and ownedMove.sourceModule == ownedDropCandidate.sourceModule and ownedMove.symbol == ownedDropCandidate.symbol and ownedMoveOnEdge and (ownedMoveIndex! -> partialMoveActiveBefore(ownedMove.regionIr, request.beforeAst, context, state))
                            -> if { true => ownedDropHasPartialMoves! }
                        ownedMove.memberIr < 0 and ownedMove.sourceModule == ownedDropCandidate.sourceModule and ownedMove.symbol == ownedDropCandidate.symbol and ownedMoveOnEdge
                            -> if {
                                context.ir[ownedMove.siteIr] => ownedMoveCall
                                true => ownedMoveBeforeEdge!
                                request.beforeAst >= 0 -> if {
                                    (ownedMoveCall -> sourceStart(context, state)) >= dropBeforeEnd!
                                        -> if { false => ownedMoveBeforeEdge! }
                                }
                                (ownedMoveCall -> sourceStart(context, state)) > (ownedDropCandidate -> sourceStart(context, state)) and ownedMoveBeforeEdge!
                                    -> if { true => ownedDropMoved! }
                            }
                        ownedMoveIndex! + 1 => ownedMoveIndex!
                    }
                # At a completed region, every continuing nested arm may have
                # transferred this owner. Early exits must use only moves on
                # their exact path, never later moves in the same region.
                request.beforeAst < 0 and not ownedDropMoved!
                    -> if {
                        request.regionIndex -> regionFullyMovesBinding(
                        ownedDropCandidate.sourceModule,
                        ownedDropCandidate.symbol,
                        ownedDropCandidate -> sourceStart(context, state),
                        context,
                        state)
                            -> if { true => ownedDropMoved! }
                    }
                ownedDropStart => ownedPutMoveIndex!
                ownedDropOwner! -> functionEnd(context, state) => ownedPutMoveEnd
                ownedPutMoveIndex! < ownedPutMoveEnd and not ownedDropMoved!
                    -> while {
                        context.ir[ownedPutMoveIndex!] => ownedPutMove
                        ownedPutMove.kind == 9 and (ownedPutMove.opcode == -223 or ownedPutMove.opcode == -303) and ownedPutMove.operand1 >= 0 and ownedPutMove.operand1 < (context.ir -> len)
                            -> if {
                                context.ir[ownedPutMove.operand1] => ownedPutMoveKey
                                ownedPutMoveKey.kind == 5 and ownedPutMoveKey.operand0 >= 0 and ownedPutMoveKey.operand0 < (context.ir -> len)
                                    -> if {
                                        ownedPutMoveKey.operand0 -> mutableBindingRoot(context, state) => ownedPutMoveKeyRoot
                                        true => ownedPutKeyBeforeEdge!
                                        request.beforeAst >= 0 -> if {
                                            (ownedPutMove -> sourceStart(context, state)) >= dropBeforeEnd!
                                                -> if { false => ownedPutKeyBeforeEdge! }
                                        }
                                        ownedPutMoveKeyRoot == ownedDropRoot! and (ownedPutMove -> sourceStart(context, state)) > (ownedDropCandidate -> sourceStart(context, state)) and ownedPutKeyBeforeEdge!
                                            -> if {
                                                true => ownedDropMoved!
                                            }
                                    }
                                ownedPutMoveKey.nextOperand => ownedPutMoveValueIndex
                                ownedPutMoveValueIndex >= 0 and ownedPutMoveValueIndex < (context.ir -> len)
                                    -> if {
                                        context.ir[ownedPutMoveValueIndex] => ownedPutMoveValue
                                        ownedPutMoveValue.kind == 5 and ownedPutMoveValue.operand0 >= 0 and ownedPutMoveValue.operand0 < (context.ir -> len)
                                            -> if {
                                                ownedPutMoveValue.operand0 -> mutableBindingRoot(context, state) => ownedPutMoveRoot
                                                true => ownedPutMoveBeforeEdge!
                                                request.beforeAst >= 0 -> if {
                                                    (ownedPutMove -> sourceStart(context, state)) >= dropBeforeEnd!
                                                        -> if { false => ownedPutMoveBeforeEdge! }
                                                }
                                                ownedPutMoveRoot == ownedDropRoot! and (ownedPutMove -> sourceStart(context, state)) > (ownedDropCandidate -> sourceStart(context, state)) and ownedPutMoveBeforeEdge!
                                                    -> if {
                                                        true => ownedDropMoved!
                                                    }
                                            }
                                    }
                            }
                        ownedPutMoveIndex! + 1 => ownedPutMoveIndex!
                    }
            }
        ownedDropIndex! => cleanupBindingIndex
        ownedDropCandidate.operand0 => ownedDropValueIndex!
        ownedDropIsPattern -> if { ownedDropIndex! => ownedDropValueIndex! }
        ownedDropCandidate.kind == 17 and ownedDropCandidate.operand0 >= 0
            -> if {
                ownedDropCandidate.operand0 -> callResultPropagationBindingIndex(context, state) => ownedDropPropagationBinding
                ownedDropPropagationBinding == ownedDropIndex!
                    -> if { ownedDropIndex! => ownedDropValueIndex! }
            }
        -1 => ownedDropParameterIndex!
        ownedDropCandidate.kind == 17 and ownedDropCandidate.flags != 1
            -> if {
                ownedDropIndex! -> owningBindingSourceParameterSymbol(ownedDropOwner!, context, state)
                    => ownedDropParameterSymbol
                ownedDropParameterSymbol >= 0 -> if {
                    context -> parameterIndexForFunction(ownedDropOwner!, ownedDropParameterSymbol)
                        => ownedDropParameterIndex!
                }
            }
        ((ownedDropIsPattern or (ownedDropIndex! -> namedBindingNeedsOwnershipFlag(state))) and ownedDropBeforeEdge! and ownedDropIsRoot!
            and not ownedDropMoved! and ownedDropCandidate.parent == request.regionIndex
            and ownedDropCandidate.symbol != ownedTransferredSymbol!
            and ((ownedDropIndex! -> patternBindingNeedsOwnershipFlag(context, state))
            or (ownedDropIndex! -> namedBindingNeedsOwnershipFlag(state)))) => ownedDropPatternFlagGuard
        ownedDropPatternFlagGuard -> if {
            "  %patternreturn$(request.edgeIndex)_b$(ownedDropIndex! -> valueNameId(state))_owned = load i1, ptr %v$(ownedDropIndex! -> valueNameId(state))_owned, align 1" -> println
            "  br i1 %patternreturn$(request.edgeIndex)_b$(ownedDropIndex! -> valueNameId(state))_owned, label %patternreturn$(request.edgeIndex)_b$(ownedDropIndex! -> valueNameId(state))_drop, label %patternreturn$(request.edgeIndex)_b$(ownedDropIndex! -> valueNameId(state))_done" -> println
            "patternreturn$(request.edgeIndex)_b$(ownedDropIndex! -> valueNameId(state))_drop:" -> println
        }
        ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved!
            and ownedDropCandidateIsBinding and ownedDropCandidate.parent == request.regionIndex
            and ownedDropCandidate.symbol != ownedTransferredSymbol!
            and (ownedDropCandidate -> isAsyncTaskValue(context))
            -> if {
                ownedDropIndex! -> emitScopedTaskDrop(ownedDropOwner!, request.regionIndex, request.beforeAst, request.edgeIndex, context, state)
                true => ownedDropMoved!
            }
        ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved! and not ownedDropHasPartialMoves! and ownedDropCandidateIsBinding and ownedDropCandidate.parent == request.regionIndex and ownedDropCandidate.typeId >= 0 and (ownedDropCandidate.typeId -> semanticTypeOwns(context, state)) and ownedDropCandidate.symbol != ownedTransferredSymbol! and not (ownedDropValueIndex! -> isPlannedContainerPayload(context, state))
            -> if {
                false => ownedDropNeedsInlineArrayReload!
                context.types[ownedDropCandidate.typeId].kind == 4 => ownedDropHasInlineArrayAbi
                context.types[ownedDropCandidate.typeId].kind == 12 => ownedDropNeedsBoundedValue
                -1 => ownedDropFrameRoot!
                ownedDropOwner! >= 0 and context.ir[ownedDropOwner!].kind == 0
                    -> if {
                        ownedDropIndex! -> asyncFrameBindingRoot(ownedDropOwner!, context, state) => ownedDropFrameRoot!
                    }
                ownedDropHasInlineArrayAbi -> if {
                    true => ownedDropNeedsInlineArrayReload!
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_fixed_carrier = " -> print
                    ownedDropCandidate.flags == 1 or ownedDropFrameRoot! >= 0
                        -> if {
                            "load %sollang.int_slice, ptr " -> print
                            ownedDropFrameRoot! >= 0 -> if {
                                ownedDropFrameRoot! -> writeAsyncLocalAddress(context, state)
                            } else { "%slot$(ownedDropRoot! -> valueNameId(state))" -> print }
                            ", align 8" -> println
                        } else {
                            "freeze %sollang.int_slice " -> print
                            ownedDropValueIndex! -> writeCleanupValueName(ownedDropParameterIndex!, ownedDropOwner!, context, state)
                            "" -> println
                        }
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_fixed_data = extractvalue %sollang.int_slice " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_fixed_carrier, 0" -> println
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_fixed = load " -> print
                    ownedDropCandidate.typeId -> writeSemanticTypeId(context, state)
                    ", ptr " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_fixed_data, align " -> print
                    context.typeAligns[ownedDropCandidate.typeId] -> writeDecimalLine
                }
                (ownedDropCandidate.flags == 1 or ownedDropFrameRoot! >= 0) and not ownedDropNeedsInlineArrayReload!
                    -> if {
                        "  " -> print
                        request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                        "_current = load " -> print
                        ownedDropNeedsBoundedValue -> if {
                            ownedDropCandidate -> writeIrType(context, state)
                        } else { ownedDropCandidate.typeId -> writeSemanticTypeId(context, state) }
                        ", ptr " -> print
                        ownedDropFrameRoot! >= 0 -> if {
                            ownedDropFrameRoot! -> writeAsyncLocalAddress(context, state)
                        } else { "%slot$(ownedDropRoot! -> valueNameId(state))" -> print }
                        ", align " -> print
                        ownedDropCandidate -> storageAlign(context, state) -> writeDecimalLine
                    }
                ownedDropNeedsBoundedValue -> if {
                    # Local slots and expressions carry runtime handles; drop
                    # helpers receive canonical inline bounded values.
                    "  %cleanupbounded$(request.edgeIndex)_b$(cleanupBindingIndex -> valueNameId(state))_handle = freeze %sollang.array.i32 " -> print
                    ownedDropCandidate.flags == 1 or ownedDropFrameRoot! >= 0
                        -> if {
                            request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                            "_current" -> print
                        } else {
                            ownedDropValueIndex! -> writeCleanupValueName(ownedDropParameterIndex!, ownedDropOwner!, context, state)
                        }
                    "" -> println
                    Arena(0) => prefixStorage!
                    "cleanupbounded$(request.edgeIndex)_b$(cleanupBindingIndex -> valueNameId(state))" -> materialize(prefixStorage!) => prefix
                    Arena(0) => valueStorage!
                    "%$(prefix)_handle" -> materialize(valueStorage!) => handle
                    prefix -> emitBoundedArrayValueFromHandle(handle, ownedDropCandidate.typeId, context, state)
                }
                "  call void @sollang_drop_t$(ownedDropCandidate.typeId)(" -> print
                ownedDropCandidate.typeId -> writeSemanticTypeId(context, state)
                " " -> print
                ownedDropNeedsBoundedValue -> if {
                    "%cleanupbounded$(request.edgeIndex)_b$(cleanupBindingIndex -> valueNameId(state))" -> print
                } else { (ownedDropCandidate.flags == 1 or ownedDropFrameRoot! >= 0) and not ownedDropNeedsInlineArrayReload!
                        -> if {
                            request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                            "_current" -> print
                        } else {
                            ownedDropNeedsInlineArrayReload! -> if {
                                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                                "_fixed" -> print
                            } else {
                                ownedDropValueIndex! -> writeCleanupValueName(ownedDropParameterIndex!, ownedDropOwner!, context, state)
                            }
                        }
                }
                ")" -> println
                ownedDropHasInlineArrayAbi -> if {
                    "  call void @sollang_free(ptr " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_fixed_data)" -> println
                    true => ownedFixedBackingReleased!
                }
            }
        ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved! and ownedDropCandidateIsBinding and ownedDropCandidate.parent == request.regionIndex and ownedDropCandidate.typeId < 0 and (ownedDropCandidate -> isDynamicArrayType) and ownedDropCandidate.symbol != ownedTransferredSymbol! and not (ownedDropValueIndex! -> isPlannedContainerPayload(context, state))
            -> if {
                ownedDropCandidate.flags == 1 -> if {
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_current = load %sollang.array.i32, ptr %slot$(ownedDropRoot! -> valueNameId(state)), align " -> print
                    ownedDropCandidate -> storageAlign(context, state) -> writeDecimalLine
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    " = extractvalue %sollang.array.i32 " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_current, 0" -> println
                } else {
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    " = extractvalue %sollang.array.i32 " -> print
                    ownedDropValueIndex! -> writeCleanupValueName(ownedDropParameterIndex!, ownedDropOwner!, context, state)
                    ", 0" -> println
                }
                "  call void @sollang_free(ptr " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                ")" -> println
            }
        ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved! and ownedDropCandidateIsBinding and ownedDropCandidate.parent == request.regionIndex and ownedDropCandidate.typeId < 0 and (ownedDropCandidate -> isDictionaryType) and ownedDropCandidate.symbol != ownedTransferredSymbol! and not (ownedDropValueIndex! -> isPlannedContainerPayload(context, state))
            -> if {
                ownedDropCandidate.flags == 1 -> if {
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_current = load %sollang.int_dictionary, ptr %slot$(ownedDropRoot! -> valueNameId(state)), align " -> print
                    ownedDropCandidate -> storageAlign(context, state) -> writeDecimalLine
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_keys = extractvalue %sollang.int_dictionary " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_current, 0" -> println
                } else {
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_keys = extractvalue %sollang.int_dictionary " -> print
                    ownedDropValueIndex! -> writeCleanupValueName(ownedDropParameterIndex!, ownedDropOwner!, context, state)
                    ", 0" -> println
                }
                "  call void @sollang_free(ptr " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_keys)" -> println
            }
        ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved! and ownedDropCandidateIsBinding and ownedDropCandidate.parent == request.regionIndex and ownedDropCandidate.typeId < 0 and ownedDropCandidate.typeOrigin == 16 and ownedDropCandidate.symbol != ownedTransferredSymbol!
            -> if {
                ownedDropCandidate.flags == 1 -> if {
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_current = load %sollang.dyn, ptr %slot$(ownedDropRoot! -> valueNameId(state)), align $ownedPointerAlignment" -> println
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_data = extractvalue %sollang.dyn " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_current, 0" -> println
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_vtable = extractvalue %sollang.dyn " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_current, 1" -> println
                } else {
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_data = extractvalue %sollang.dyn " -> print
                    ownedDropValueIndex! -> writeCleanupValueName(ownedDropParameterIndex!, ownedDropOwner!, context, state)
                    ", 0" -> println
                    "  " -> print
                    request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                    "_vtable = extractvalue %sollang.dyn " -> print
                    ownedDropValueIndex! -> writeCleanupValueName(ownedDropParameterIndex!, ownedDropOwner!, context, state)
                    ", 1" -> println
                }
                "  " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_drop_slot = getelementptr ptr, ptr " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_vtable, i64 0" -> println
                "  " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_drop = load ptr, ptr " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_drop_slot, align $ownedPointerAlignment" -> println
                "  call void " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_drop(ptr " -> print
                request.edgeIndex -> writeCleanupName(cleanupBindingIndex, context, state)
                "_data)" -> println
            }
        ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved! and ownedDropCandidateIsBinding and ownedDropCandidate.parent == request.regionIndex and (ownedDropCandidate.typeId < 0 or ownedDropHasPartialMoves!) and (ownedDropCandidate -> isGenericEnumType) and ownedDropCandidate.symbol != ownedTransferredSymbol!
            -> if {
                0 => ownedEnumValueKind!
                ownedDropParameterIndex! >= 0 -> if { 3 => ownedEnumValueKind! }
                ownedDropCandidate.flags == 1 -> if { 2 => ownedEnumValueKind! }
                EnumDropRequest {
                    typeId: ownedDropCandidate.typeId
                    valueKind: ownedEnumValueKind!
                    valueIndex: ownedDropCandidate.flags == 1 -> if { ownedDropRoot! } else {
                        ownedDropParameterIndex! >= 0 -> if { ownedDropParameterIndex! } else { ownedDropValueIndex! }
                    }
                    nameRoot: request.edgeIndex * 1000 + ownedDropIndex!
                    bindingIndex: ownedDropIndex!
                    regionIndex: request.regionIndex
                } -> emitEnumDrop(context, state)
            }
        ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved! and ownedDropCandidateIsBinding and ownedDropCandidate.parent == request.regionIndex and (ownedDropCandidate.typeId < 0 or ownedDropHasPartialMoves! or ((ownedDropCandidate.typeId -> directCopyableFixedStructType(context)) and not (ownedDropCandidate.typeId -> semanticTypeOwns(context, state)))) and (ownedDropCandidate -> isNominalStructType) and ownedDropCandidate.symbol != ownedTransferredSymbol!
            -> if {
                request.edgeIndex * 1000 + ownedDropIndex! => ownedDropNameRoot
                ownedDropIndex! -> emitAsyncBindingDropValue(ownedDropOwner!, ownedDropNameRoot, context, state) => ownedDropFromAsyncFrame
                not ownedDropFromAsyncFrame and ownedDropCandidate.flags == 1
                    -> if {
                        "  %dropg$(ownedDropNameRoot)_p0 = load %sollang.struct.$(context -> emitterContext.declarationName(ownedDropCandidate.typeModule, ownedDropCandidate.typeSymbol)), ptr %slot$(ownedDropRoot! -> valueNameId(state)), align " -> print
                        ownedDropCandidate -> storageAlign(context, state) -> writeDecimalLine
                    }
                0 => ownedDropValueKind!
                ownedDropParameterIndex! >= 0 -> if { 3 => ownedDropValueKind! }
                ownedDropFromAsyncFrame or ownedDropCandidate.flags == 1
                    -> if { 2 => ownedDropValueKind! }
                DropGlueRequest {
                    typeId: ownedDropCandidate.typeId
                    typeOrigin: ownedDropCandidate.typeOrigin
                    typeModule: ownedDropCandidate.typeModule
                    typeSymbol: ownedDropCandidate.typeSymbol
                    valueKind: ownedDropValueKind!
                    valueIndex: ownedDropParameterIndex! >= 0 -> if { ownedDropParameterIndex! } else { ownedDropValueIndex! }
                    nameRoot: ownedDropNameRoot
                    pathCode: 0
                    bindingIndex: ownedDropIndex!
                    regionIndex: request.regionIndex
                    beforeAst: request.beforeAst
                    parentTask: -1
                    fieldOrdinal: -1
                    hasPartialMoves: ownedDropHasPartialMoves!
                } -> emitDropGlue(ownedDropEdgeNode, context, state)
            }
        ownedDropIndex! -> bindingPromotedFixedArrayCall(context, state) => ownedBackingValue!
        # Region and entry cleanup own heap fixed literals independently of
        # scalar element drop traits, just like ordinary function cleanup.
        ownedBackingValue! < 0 and ownedDropCandidate.kind == 17
            and ownedDropIsRoot! and not ownedDropMoved!
            and ownedDropCandidate.typeId >= 0
            and context.types[ownedDropCandidate.typeId].kind == 4
            and not (ownedDropCandidate.typeId -> semanticTypeOwns(context, state))
            and ownedDropCandidate.operand0 >= 0
            and context.ir[ownedDropCandidate.operand0].kind == 14
            and (ownedDropCandidate.operand0 -> fixedArrayLiteralNeedsHeap(context, state))
            -> if { ownedDropCandidate.operand0 => ownedBackingValue! }
        false => fixedBackingTransferred!
        # Only a local with actual fixed backing needs a transferred-root check.
        # The scan also visits region nodes, which have no binding-name token.
        ownedBackingValue! >= 0
            and ownedTransferredValue! >= 0 and ownedTransferredValue! < (context.ir -> len)
            -> if {
                # Enum constructors materialize the existing fixed descriptor.
                # Follow only value-preserving enum/name wrappers; struct fields
                # can copy backing and must retain their source cleanup.
                ownedTransferredValue! -> returnedOwnedBindingIndex(context, state) => transferredFixedBinding
                transferredFixedBinding >= 0 -> if {
                    transferredFixedBinding -> mutableBindingRoot(context, state) => transferredFixedRoot
                    ownedDropIndex! -> mutableBindingRoot(context, state) => droppedFixedRoot
                    transferredFixedRoot == droppedFixedRoot => fixedBackingTransferred!
                }
            }
        ownedBackingValue! >= 0 and ownedDropBeforeEdge! and not ownedFixedBackingReleased! and ownedDropCandidate.parent == request.regionIndex
            and not ownedDropMoved!
            and ownedBackingValue! != ownedTransferredBacking!
            and not fixedBackingTransferred!
            and ownedDropCandidate.symbol != ownedTransferredSymbol!
            -> if {
                ownedBackingValue! -> emitPromotedFixedBackingDrop(request.edgeIndex, context, state)
            }
        ownedDropIsPattern and ownedDropBeforeEdge! and ownedDropIsRoot! and not ownedDropMoved!
            and ownedDropCandidate.parent == request.regionIndex
            and ownedDropCandidate.symbol != ownedTransferredSymbol!
            and ownedDropCandidate.typeId >= 0
            and context.types[ownedDropCandidate.typeId].kind == 4
            and not (ownedDropCandidate.typeId -> semanticTypeOwns(context, state))
            -> if {
                "  %patternreturn$(request.edgeIndex)_b$(ownedDropIndex! -> valueNameId(state))_data = extractvalue %sollang.int_slice %v$(ownedDropIndex! -> valueNameId(state)), 0" -> println
                "  call void @sollang_free(ptr %patternreturn$(request.edgeIndex)_b$(ownedDropIndex! -> valueNameId(state))_data)" -> println
            }
        ownedDropPatternFlagGuard -> if {
            "  br label %patternreturn$(request.edgeIndex)_b$(ownedDropIndex! -> valueNameId(state))_done" -> println
            "patternreturn$(request.edgeIndex)_b$(ownedDropIndex! -> valueNameId(state))_done:" -> println
        }
        ownedDropBeforeEdge! and ownedDropIsRoot! and ownedDropCandidateIsBinding
            and ownedDropCandidate.parent == request.regionIndex
            -> if { ownedDropIndex! -> emitMutableHeaderEnd(context) }
    }
}
