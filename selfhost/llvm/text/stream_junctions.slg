namespace sollang.compiler.llvm.text

import sollang.compiler.llvm.emitter.context as emitterContext
import sollang.compiler.llvm.emitter.stream_join_runtime as streamJoinRuntime

emitPlannedJunctionValue expressionIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[expressionIndex].kind == 43 -> if {
        expressionIndex -> plannedStreamJunction(context, state) => junctionIndex
        junctionIndex >= 0 and context.streamPlan.junctions[junctionIndex].kind == 2
            -> if {
                context.streamPlan.junctions[junctionIndex] => junction
                junctionIndex -> junctionRequiresConcurrent(context, state) => concurrent
                junction.policy == 0 -> if { expressionIndex -> emitZipJunctionValue(junctionIndex, ownerIndex, context, state) }
                junction.policy == 1 and not concurrent -> if { expressionIndex -> emitMergeJunctionValue(junctionIndex, ownerIndex, context, state) }
                (junction.policy == 1 or junction.policy == 3) and concurrent
                    -> if { expressionIndex -> emitConcurrentJunctionValue(junctionIndex, ownerIndex, context, state) }
                junction.policy == 2 -> if { expressionIndex -> emitConcatJunctionValue(junctionIndex, ownerIndex, context, state) }
                junction.policy == 3 and not concurrent -> if { expressionIndex -> emitLatestJunctionValue(junctionIndex, ownerIndex, context, state) }
            }
    }
}

emitJunctionDropRuntime junctionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.streamPlan.junctions[junctionIndex] => junction
    junctionIndex -> junctionRequiresConcurrent(context, state) => concurrent
    "define internal void @sollang_join_$(junction.junctionIr -> valueNameId(state))_drop(ptr %context, i1 %destroy) {" -> println
    "entry:" -> println
    concurrent -> if {
        "  %runtime_address = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(junction.inputCount)" -> println
        "  %runtime = load ptr, ptr %runtime_address, align 8" -> println
        "  call void @sollang_stream_join_runtime_cancel(ptr %runtime)" -> println
    }
    0 => cancelInput!
    cancelInput! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + cancelInput!] => input
        context.types[input.typeId].symbol == 4 -> if {
            "  %cancel_stream_address$(cancelInput!) = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(cancelInput!)" -> println
            "  %cancel_stream$(cancelInput!) = load %sollang.event_stream, ptr %cancel_stream_address$(cancelInput!), align 8" -> println
            "  %cancel_context$(cancelInput!) = extractvalue %sollang.event_stream %cancel_stream$(cancelInput!), 0" -> println
            "  %cancel_callback$(cancelInput!) = extractvalue %sollang.event_stream %cancel_stream$(cancelInput!), 2" -> println
            "  %has_cancel$(cancelInput!) = icmp ne ptr %cancel_callback$(cancelInput!), null" -> println
            "  br i1 %has_cancel$(cancelInput!), label %cancel_input$(cancelInput!), label %cancel_done$(cancelInput!)" -> println
            "cancel_input$(cancelInput!):" -> println
            "  call void %cancel_callback$(cancelInput!)(ptr %cancel_context$(cancelInput!), i1 false)" -> println
            "  br label %cancel_done$(cancelInput!)" -> println
            "cancel_done$(cancelInput!):" -> println
        }
        cancelInput! + 1 => cancelInput!
    }
    "  br i1 %destroy, label %destroy_inputs, label %cancelled_only" -> println
    "cancelled_only:" -> println
    "  ret void" -> println
    "destroy_inputs:" -> println
    concurrent -> if {
        "  call void @sollang_stream_join_runtime_join_destroy(ptr %runtime)" -> println
    }
    0 => dropInput!
    dropInput! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + dropInput!] => input
        "%sollang.stream" => producerType!
        context.types[input.typeId].symbol == 4 -> if { "%sollang.event_stream" => producerType! }
        "  %drop_stream_address$(dropInput!) = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(dropInput!)" -> println
        "  %drop_stream$(dropInput!) = load $(producerType!), ptr %drop_stream_address$(dropInput!), align 8" -> println
        "  %drop_context$(dropInput!) = extractvalue $(producerType!) %drop_stream$(dropInput!), 0" -> println
        "  %drop_callback$(dropInput!) = extractvalue $(producerType!) %drop_stream$(dropInput!), 2" -> println
        "  %has_drop$(dropInput!) = icmp ne ptr %drop_callback$(dropInput!), null" -> println
        "  br i1 %has_drop$(dropInput!), label %drop_input$(dropInput!), label %drop_done$(dropInput!)" -> println
        "drop_input$(dropInput!):" -> println
        "  call void %drop_callback$(dropInput!)(ptr %drop_context$(dropInput!), i1 true)" -> println
        "  br label %drop_done$(dropInput!)" -> println
        "drop_done$(dropInput!):" -> println
        dropInput! + 1 => dropInput!
    }
    "  call void @sollang_free(ptr %context)" -> println
    "  ret void" -> println
    "}" -> println
}

emitConcatJunctionRuntime junctionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.streamPlan.junctions[junctionIndex] => junction
    context.ir[junction.junctionIr] => junctionNode
    "%sollang.join.$(junction.junctionIr -> valueNameId(state)) = type { " -> print
    0 => contextField!
    contextField! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + contextField!] => input
        context.types[input.typeId] => inputType
        inputType.symbol == 4 -> if { "%sollang.event_stream" -> print } else { "%sollang.stream" -> print }
        ", " -> print
        contextField! + 1 => contextField!
    }
    "i32 }" -> println
    "define internal i1 @sollang_join_$(junction.junctionIr -> valueNameId(state))_next(ptr %context, ptr %output) {" -> println
    "entry:" -> println
    "  %cursor_address = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(junction.inputCount)" -> println
    "  %cursor = load i32, ptr %cursor_address, align 4" -> println
    "  switch i32 %cursor, label %done [" -> println
    0 => switchInput!
    switchInput! < junction.inputCount -> while {
        "    i32 $(switchInput!), label %input$(switchInput!)" -> println
        switchInput! + 1 => switchInput!
    }
    "  ]" -> println
    0 => nextInput!
    nextInput! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + nextInput!] => input
        context.types[input.typeId] => inputType
        "%sollang.stream" => producerType!
        inputType.symbol == 4 -> if { "%sollang.event_stream" => producerType! }
        "input$(nextInput!):" -> println
        "  %stream_address$(nextInput!) = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(nextInput!)" -> println
        "  %stream$(nextInput!) = load $(producerType!), ptr %stream_address$(nextInput!), align 8" -> println
        "  %stream_context$(nextInput!) = extractvalue $(producerType!) %stream$(nextInput!), 0" -> println
        "  %stream_next$(nextInput!) = extractvalue $(producerType!) %stream$(nextInput!), 1" -> println
        "  %has_value$(nextInput!) = call i1 %stream_next$(nextInput!)(ptr %stream_context$(nextInput!), ptr %output)" -> println
        "  br i1 %has_value$(nextInput!), label %value$(nextInput!), label %exhausted$(nextInput!)" -> println
        "value$(nextInput!):" -> println
        "  ret i1 true" -> println
        "exhausted$(nextInput!):" -> println
        "  store i32 $(nextInput! + 1), ptr %cursor_address, align 4" -> println
        nextInput! + 1 < junction.inputCount -> if { "  br label %input$(nextInput! + 1)" -> println } else { "  br label %done" -> println }
        nextInput! + 1 => nextInput!
    }
    "done:" -> println
    "  ret i1 false" -> println
    "}" -> println
    junctionIndex -> emitJunctionDropRuntime(context, state)
}
emitZipJunctionRuntime junctionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.streamPlan.junctions[junctionIndex] => junction
    context.ir[junction.junctionIr] => junctionNode
    context.types[junctionNode.typeId].first => outputElementType
    "%sollang.join.$(junction.junctionIr -> valueNameId(state)) = type { " -> print
    0 => contextField!
    contextField! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + contextField!] => input
        context.types[input.typeId] => inputType
        inputType.symbol == 4 -> if { "%sollang.event_stream" -> print } else { "%sollang.stream" -> print }
        ", " -> print
        contextField! + 1 => contextField!
    }
    "i1 }" -> println
    "define internal i1 @sollang_join_$(junction.junctionIr -> valueNameId(state))_next(ptr %context, ptr %output) {" -> println
    "entry:" -> println
    "  %done_address = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(junction.inputCount)" -> println
    "  %done_value = load i1, ptr %done_address, align 1" -> println
    junction.inputCount > 0 -> if { "  br i1 %done_value, label %done, label %input0" -> println } else { "  br label %done" -> println }
    0 => nextInput!
    nextInput! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + nextInput!] => input
        context.types[input.typeId] => inputType
        "%sollang.stream" => producerType!
        inputType.symbol == 4 -> if { "%sollang.event_stream" => producerType! }
        "input$(nextInput!):" -> println
        "  %stream_address$(nextInput!) = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(nextInput!)" -> println
        "  %stream$(nextInput!) = load $(producerType!), ptr %stream_address$(nextInput!), align 8" -> println
        "  %stream_context$(nextInput!) = extractvalue $(producerType!) %stream$(nextInput!), 0" -> println
        "  %stream_next$(nextInput!) = extractvalue $(producerType!) %stream$(nextInput!), 1" -> println
        "  %output_field$(nextInput!) = getelementptr " -> print
        outputElementType -> writeSemanticTypeId(context, state)
        ", ptr %output, i32 0, i32 $(nextInput!)" -> println
        "  %has_value$(nextInput!) = call i1 %stream_next$(nextInput!)(ptr %stream_context$(nextInput!), ptr %output_field$(nextInput!))" -> println
        "  br i1 %has_value$(nextInput!), label %value$(nextInput!), label %failed$(nextInput!)" -> println
        "value$(nextInput!):" -> println
        nextInput! + 1 < junction.inputCount -> if { "  br label %input$(nextInput! + 1)" -> println } else { "  ret i1 true" -> println }
        "failed$(nextInput!):" -> println
        nextInput! > 0 -> if {
            nextInput! => partialInput!
            partialInput! > 0 -> while {
                partialInput! - 1 => partialInput!
                context.streamPlan.junctionInputs[junction.inputStart + partialInput!] => partial
                context.types[partial.typeId].first => partialType
                context.typeTraits[partialType] % 2 == 1 -> if {
                    "  %partial$(nextInput!)_field$(partialInput!) = getelementptr " -> print
                    outputElementType -> writeSemanticTypeId(context, state)
                    ", ptr %output, i32 0, i32 $(partialInput!)" -> println
                    "  %partial$(nextInput!)_value$(partialInput!) = load " -> print
                    partialType -> writeSemanticTypeId(context, state)
                    ", ptr %partial$(nextInput!)_field$(partialInput!), align $(context.typeAligns[partialType])" -> println
                    "  call void @sollang_drop_t$(partialType)(" -> print
                    partialType -> writeSemanticTypeId(context, state)
                    " %partial$(nextInput!)_value$(partialInput!))" -> println
                }
            }
        }
        "  store i1 true, ptr %done_address, align 1" -> println
        "  ret i1 false" -> println
        nextInput! + 1 => nextInput!
    }
    "done:" -> println
    "  ret i1 false" -> println
    "}" -> println
    junctionIndex -> emitJunctionDropRuntime(context, state)
}

emitMergeJunctionRuntime junctionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.streamPlan.junctions[junctionIndex] => junction
    "%sollang.join.$(junction.junctionIr -> valueNameId(state)) = type { " -> print
    0 => contextField!
    contextField! < junction.inputCount -> while {
        "%sollang.stream, " -> print
        contextField! + 1 => contextField!
    }
    "i32" -> print
    0 => activeField!
    activeField! < junction.inputCount -> while {
        ", i1" -> print
        activeField! + 1 => activeField!
    }
    " }" -> println
    "define internal i1 @sollang_join_$(junction.junctionIr -> valueNameId(state))_next(ptr %context, ptr %output) {" -> println
    "entry:" -> println
    "  %checked_slot = alloca i32, align 4" -> println
    "  store i32 0, ptr %checked_slot, align 4" -> println
    "  br label %loop" -> println
    "loop:" -> println
    "  %checked = load i32, ptr %checked_slot, align 4" -> println
    "  %all_checked = icmp sge i32 %checked, $(junction.inputCount)" -> println
    "  br i1 %all_checked, label %done, label %dispatch" -> println
    "dispatch:" -> println
    "  %cursor_address = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(junction.inputCount)" -> println
    "  %cursor = load i32, ptr %cursor_address, align 4" -> println
    "  switch i32 %cursor, label %done [" -> println
    0 => switchInput!
    switchInput! < junction.inputCount -> while {
        "    i32 $(switchInput!), label %input$(switchInput!)" -> println
        switchInput! + 1 => switchInput!
    }
    "  ]" -> println
    0 => nextInput!
    nextInput! < junction.inputCount -> while {
        "input$(nextInput!):" -> println
        "  %active_address$(nextInput!) = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(junction.inputCount + 1 + nextInput!)" -> println
        "  %active$(nextInput!) = load i1, ptr %active_address$(nextInput!), align 1" -> println
        "  br i1 %active$(nextInput!), label %pull$(nextInput!), label %advance$(nextInput!)" -> println
        "pull$(nextInput!):" -> println
        "  %stream_address$(nextInput!) = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(nextInput!)" -> println
        "  %stream$(nextInput!) = load %sollang.stream, ptr %stream_address$(nextInput!), align 8" -> println
        "  %stream_context$(nextInput!) = extractvalue %sollang.stream %stream$(nextInput!), 0" -> println
        "  %stream_next$(nextInput!) = extractvalue %sollang.stream %stream$(nextInput!), 1" -> println
        "  %has_value$(nextInput!) = call i1 %stream_next$(nextInput!)(ptr %stream_context$(nextInput!), ptr %output)" -> println
        "  br i1 %has_value$(nextInput!), label %value$(nextInput!), label %exhausted$(nextInput!)" -> println
        "value$(nextInput!):" -> println
        "  store i32 $((nextInput! + 1) % junction.inputCount), ptr %cursor_address, align 4" -> println
        "  ret i1 true" -> println
        "exhausted$(nextInput!):" -> println
        "  store i1 false, ptr %active_address$(nextInput!), align 1" -> println
        "  br label %advance$(nextInput!)" -> println
        "advance$(nextInput!):" -> println
        "  store i32 $((nextInput! + 1) % junction.inputCount), ptr %cursor_address, align 4" -> println
        "  %checked_before$(nextInput!) = load i32, ptr %checked_slot, align 4" -> println
        "  %checked_next$(nextInput!) = add i32 %checked_before$(nextInput!), 1" -> println
        "  store i32 %checked_next$(nextInput!), ptr %checked_slot, align 4" -> println
        "  br label %loop" -> println
        nextInput! + 1 => nextInput!
    }
    "done:" -> println
    "  ret i1 false" -> println
    "}" -> println
    junctionIndex -> emitJunctionDropRuntime(context, state)
}

emitLatestJunctionRuntime junctionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.streamPlan.junctions[junctionIndex] => junction
    context.ir[junction.junctionIr] => junctionNode
    context.types[junctionNode.typeId].first => outputElementType
    "%sollang.join.$(junction.junctionIr -> valueNameId(state)) = type { " -> print
    0 => streamField!
    streamField! < junction.inputCount -> while {
        "%sollang.stream, " -> print
        streamField! + 1 => streamField!
    }
    "i32, i32" -> print
    0 => activeField!
    activeField! < junction.inputCount -> while {
        ", i1" -> print
        activeField! + 1 => activeField!
    }
    0 => cacheField!
    cacheField! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + cacheField!] => cacheInput
        ", " -> print
        context.types[cacheInput.typeId].first -> writeSemanticTypeId(context, state)
        cacheField! + 1 => cacheField!
    }
    " }" -> println
    "define internal i1 @sollang_join_$(junction.junctionIr -> valueNameId(state))_next(ptr %context, ptr %output) {" -> println
    "entry:" -> println
    "  %cursor_address = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(junction.inputCount)" -> println
    "  %state_address = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(junction.inputCount + 1)" -> println
    "  %state = load i32, ptr %state_address, align 4" -> println
    "  switch i32 %state, label %done [" -> println
    "    i32 0, label %initial0" -> println
    "    i32 1, label %scan_entry" -> println
    "  ]" -> println
    0 => initialInput!
    initialInput! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + initialInput!] => input
        context.types[input.typeId].first => inputElementType
        "initial$(initialInput!):" -> println
        "  %initial_stream_address$(initialInput!) = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(initialInput!)" -> println
        "  %initial_stream$(initialInput!) = load %sollang.stream, ptr %initial_stream_address$(initialInput!), align 8" -> println
        "  %initial_context$(initialInput!) = extractvalue %sollang.stream %initial_stream$(initialInput!), 0" -> println
        "  %initial_next$(initialInput!) = extractvalue %sollang.stream %initial_stream$(initialInput!), 1" -> println
        "  %cache_address$(initialInput!) = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(junction.inputCount * 2 + 2 + initialInput!)" -> println
        "  %initial_has$(initialInput!) = call i1 %initial_next$(initialInput!)(ptr %initial_context$(initialInput!), ptr %cache_address$(initialInput!))" -> println
        "  br i1 %initial_has$(initialInput!), label %initial_value$(initialInput!), label %initial_failed" -> println
        "initial_value$(initialInput!):" -> println
        initialInput! + 1 < junction.inputCount -> if { "  br label %initial$(initialInput! + 1)" -> println } else {
            "  store i32 1, ptr %state_address, align 4" -> println
            "  br label %snapshot" -> println
        }
        initialInput! + 1 => initialInput!
    }
    "initial_failed:" -> println
    "  store i32 2, ptr %state_address, align 4" -> println
    "  ret i1 false" -> println
    "scan_entry:" -> println
    "  %checked_slot = alloca i32, align 4" -> println
    "  store i32 0, ptr %checked_slot, align 4" -> println
    "  br label %loop" -> println
    "loop:" -> println
    "  %checked = load i32, ptr %checked_slot, align 4" -> println
    "  %all_checked = icmp sge i32 %checked, $(junction.inputCount)" -> println
    "  br i1 %all_checked, label %done, label %dispatch" -> println
    "dispatch:" -> println
    "  %cursor = load i32, ptr %cursor_address, align 4" -> println
    "  switch i32 %cursor, label %done [" -> println
    0 => switchInput!
    switchInput! < junction.inputCount -> while {
        "    i32 $(switchInput!), label %input$(switchInput!)" -> println
        switchInput! + 1 => switchInput!
    }
    "  ]" -> println
    0 => nextInput!
    nextInput! < junction.inputCount -> while {
        "input$(nextInput!):" -> println
        "  %active_address$(nextInput!) = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(junction.inputCount + 2 + nextInput!)" -> println
        "  %active$(nextInput!) = load i1, ptr %active_address$(nextInput!), align 1" -> println
        "  br i1 %active$(nextInput!), label %pull$(nextInput!), label %advance$(nextInput!)" -> println
        "pull$(nextInput!):" -> println
        "  %stream_address$(nextInput!) = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(nextInput!)" -> println
        "  %stream$(nextInput!) = load %sollang.stream, ptr %stream_address$(nextInput!), align 8" -> println
        "  %stream_context$(nextInput!) = extractvalue %sollang.stream %stream$(nextInput!), 0" -> println
        "  %stream_next$(nextInput!) = extractvalue %sollang.stream %stream$(nextInput!), 1" -> println
        "  %update_cache$(nextInput!) = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(junction.inputCount * 2 + 2 + nextInput!)" -> println
        "  %has_value$(nextInput!) = call i1 %stream_next$(nextInput!)(ptr %stream_context$(nextInput!), ptr %update_cache$(nextInput!))" -> println
        "  br i1 %has_value$(nextInput!), label %value$(nextInput!), label %exhausted$(nextInput!)" -> println
        "value$(nextInput!):" -> println
        "  store i32 $((nextInput! + 1) % junction.inputCount), ptr %cursor_address, align 4" -> println
        "  br label %snapshot" -> println
        "exhausted$(nextInput!):" -> println
        "  store i1 false, ptr %active_address$(nextInput!), align 1" -> println
        "  br label %advance$(nextInput!)" -> println
        "advance$(nextInput!):" -> println
        "  store i32 $((nextInput! + 1) % junction.inputCount), ptr %cursor_address, align 4" -> println
        "  %checked_before$(nextInput!) = load i32, ptr %checked_slot, align 4" -> println
        "  %checked_next$(nextInput!) = add i32 %checked_before$(nextInput!), 1" -> println
        "  store i32 %checked_next$(nextInput!), ptr %checked_slot, align 4" -> println
        "  br label %loop" -> println
        nextInput! + 1 => nextInput!
    }
    "snapshot:" -> println
    0 => snapshotField!
    snapshotField! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + snapshotField!] => snapshotInput
        context.types[snapshotInput.typeId].first => snapshotType
        "  %snapshot_cache$(snapshotField!) = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(junction.inputCount * 2 + 2 + snapshotField!)" -> println
        "  %snapshot_value$(snapshotField!) = load " -> print
        snapshotType -> writeSemanticTypeId(context, state)
        ", ptr %snapshot_cache$(snapshotField!), align $(context.typeAligns[snapshotType])" -> println
        "  %snapshot_output$(snapshotField!) = getelementptr " -> print
        outputElementType -> writeSemanticTypeId(context, state)
        ", ptr %output, i32 0, i32 $(snapshotField!)" -> println
        "  store " -> print
        snapshotType -> writeSemanticTypeId(context, state)
        " %snapshot_value$(snapshotField!), ptr %snapshot_output$(snapshotField!), align $(context.typeAligns[snapshotType])" -> println
        snapshotField! + 1 => snapshotField!
    }
    "  ret i1 true" -> println
    "done:" -> println
    "  ret i1 false" -> println
    "}" -> println
    junctionIndex -> emitJunctionDropRuntime(context, state)
}

junctionRequiresConcurrent junctionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.streamPlan.junctions[junctionIndex] => junction
    false => concurrent!
    junction.kind == 2 and (junction.policy == 1 or junction.policy == 3)
        -> if {
            junction.inputStart => inputIndex!
            inputIndex! < junction.inputStart + junction.inputCount
                -> while {
                    context.streamPlan.junctionInputs[inputIndex!].typeId => inputTypeId
                    inputTypeId >= 0 and inputTypeId < (context.types -> len)
                        -> if {
                            context.types[inputTypeId] => inputType
                            inputType.kind == 7 and inputType.symbol == 4
                                -> if { true => concurrent! }
                        }
                    inputIndex! + 1 => inputIndex!
                }
        }
    concurrent!
}

emitConcurrentJunctionInputCallbacks junctionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.streamPlan.junctions[junctionIndex] => junction
    "define internal i1 @sollang_join_$(junction.junctionIr -> valueNameId(state))_pull(ptr %context, i32 %index, ptr %slot) {" -> println
    "entry:" -> println
    "  switch i32 %index, label %invalid [" -> println
    0 => switchInput!
    switchInput! < junction.inputCount -> while {
        "    i32 $(switchInput!), label %input$(switchInput!)" -> println
        switchInput! + 1 => switchInput!
    }
    "  ]" -> println
    0 => pullInput!
    pullInput! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + pullInput!] => input
        context.types[input.typeId] => inputType
        "%sollang.stream" => producerType!
        inputType.symbol == 4 -> if { "%sollang.event_stream" => producerType! }
        "input$(pullInput!):" -> println
        "  %stream_address$(pullInput!) = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(pullInput!)" -> println
        "  %stream$(pullInput!) = load $(producerType!), ptr %stream_address$(pullInput!), align 8" -> println
        "  %stream_context$(pullInput!) = extractvalue $(producerType!) %stream$(pullInput!), 0" -> println
        "  %stream_next$(pullInput!) = extractvalue $(producerType!) %stream$(pullInput!), 1" -> println
        "  %has_value$(pullInput!) = call i1 %stream_next$(pullInput!)(ptr %stream_context$(pullInput!), ptr %slot)" -> println
        "  ret i1 %has_value$(pullInput!)" -> println
        pullInput! + 1 => pullInput!
    }
    "invalid:" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "}" -> println

    "define internal void @sollang_join_$(junction.junctionIr -> valueNameId(state))_drop_item(ptr %context, i32 %index, ptr %slot) {" -> println
    "entry:" -> println
    false => hasOwnedInput!
    0 => ownedSearch!
    ownedSearch! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + ownedSearch!] => ownedInput
        context.types[ownedInput.typeId].first => ownedElementType
        context.typeTraits[ownedElementType] % 2 == 1
            -> if { true => hasOwnedInput! }
        ownedSearch! + 1 => ownedSearch!
    }
    hasOwnedInput! -> if {
        "  switch i32 %index, label %done [" -> println
        0 => ownedSwitch!
        ownedSwitch! < junction.inputCount -> while {
            context.streamPlan.junctionInputs[junction.inputStart + ownedSwitch!] => ownedSwitchInput
            context.types[ownedSwitchInput.typeId].first => ownedSwitchType
            context.typeTraits[ownedSwitchType] % 2 == 1
                -> if { "    i32 $(ownedSwitch!), label %drop$(ownedSwitch!)" -> println }
            ownedSwitch! + 1 => ownedSwitch!
        }
        "  ]" -> println
        0 => ownedDrop!
        ownedDrop! < junction.inputCount -> while {
            context.streamPlan.junctionInputs[junction.inputStart + ownedDrop!] => ownedDropInput
            context.types[ownedDropInput.typeId].first => ownedDropType
            context.typeTraits[ownedDropType] % 2 == 1 -> if {
                "drop$(ownedDrop!):" -> println
                "  %pending$(ownedDrop!) = load " -> print
                ownedDropType -> writeSemanticTypeId(context, state)
                ", ptr %slot, align $(context.typeAligns[ownedDropType])" -> println
                "  call void @sollang_drop_t$(ownedDropType)(" -> print
                ownedDropType -> writeSemanticTypeId(context, state)
                " %pending$(ownedDrop!))" -> println
                "  br label %done" -> println
            }
            ownedDrop! + 1 => ownedDrop!
        }
        "done:" -> println
    }
    "  ret void" -> println
    "}" -> println
}

emitConcurrentJunctionDrop junctionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.streamPlan.junctions[junctionIndex] => junction
    junctionIndex -> emitJunctionDropRuntime(context, state)
}

emitConcurrentMergeJunctionRuntime junctionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.streamPlan.junctions[junctionIndex] => junction
    "%sollang.join.$(junction.junctionIr -> valueNameId(state)) = type { " -> print
    0 => contextField!
    contextField! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + contextField!] => input
        context.types[input.typeId].symbol == 4 -> if { "%sollang.event_stream, " -> print } else { "%sollang.stream, " -> print }
        contextField! + 1 => contextField!
    }
    "ptr }" -> println
    junctionIndex -> emitConcurrentJunctionInputCallbacks(context, state)
    "define internal i1 @sollang_join_$(junction.junctionIr -> valueNameId(state))_next(ptr %context, ptr %output) {" -> println
    "entry:" -> println
    "  %runtime_address = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(junction.inputCount)" -> println
    "  %runtime = load ptr, ptr %runtime_address, align 8" -> println
    "  %index_address = alloca i32, align 4" -> println
    "  %kind_address = alloca i32, align 4" -> println
    "  %slot_address = alloca ptr, align 8" -> println
    "  br label %wait" -> println
    "wait:" -> println
    "  %available = call i1 @sollang_stream_join_runtime_next_event(ptr %runtime, ptr %index_address, ptr %kind_address, ptr %slot_address)" -> println
    "  br i1 %available, label %received, label %done" -> println
    "received:" -> println
    "  %kind = load i32, ptr %kind_address, align 4" -> println
    "  %is_value = icmp eq i32 %kind, 0" -> println
    "  br i1 %is_value, label %value, label %wait" -> println
    "value:" -> println
    "  %index = load i32, ptr %index_address, align 4" -> println
    "  %slot = load ptr, ptr %slot_address, align 8" -> println
    context.streamPlan.junctionInputs[junction.inputStart] => firstInput
    context.types[firstInput.typeId].first => outputType
    "  %item = load " -> print
    outputType -> writeSemanticTypeId(context, state)
    ", ptr %slot, align $(context.typeAligns[outputType])" -> println
    "  store " -> print
    outputType -> writeSemanticTypeId(context, state)
    " %item, ptr %output, align $(context.typeAligns[outputType])" -> println
    "  call void @sollang_stream_join_runtime_release(ptr %runtime, i32 %index)" -> println
    "  ret i1 true" -> println
    "done:" -> println
    "  ret i1 false" -> println
    "}" -> println
    junctionIndex -> emitConcurrentJunctionDrop(context, state)
}

emitConcurrentLatestSnapshot junctionIndex: Int, snapshotOrdinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.streamPlan.junctions[junctionIndex] => junction
    context.ir[junction.junctionIr] => junctionNode
    context.types[junctionNode.typeId].first => outputType
    0 => snapshotInput!
    snapshotInput! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + snapshotInput!] => input
        context.types[input.typeId].first => elementType
        "  %snapshot$(snapshotOrdinal)_cache$(snapshotInput!) = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(junction.inputCount + 3 + snapshotInput!)" -> println
        "  %snapshot$(snapshotOrdinal)_value$(snapshotInput!) = load " -> print
        elementType -> writeSemanticTypeId(context, state)
        ", ptr %snapshot$(snapshotOrdinal)_cache$(snapshotInput!), align $(context.typeAligns[elementType])" -> println
        "  %snapshot$(snapshotOrdinal)_output$(snapshotInput!) = getelementptr " -> print
        outputType -> writeSemanticTypeId(context, state)
        ", ptr %output, i32 0, i32 $(snapshotInput!)" -> println
        "  store " -> print
        elementType -> writeSemanticTypeId(context, state)
        " %snapshot$(snapshotOrdinal)_value$(snapshotInput!), ptr %snapshot$(snapshotOrdinal)_output$(snapshotInput!), align $(context.typeAligns[elementType])" -> println
        snapshotInput! + 1 => snapshotInput!
    }
    "  ret i1 true" -> println
}

emitConcurrentLatestJunctionRuntime junctionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.streamPlan.junctions[junctionIndex] => junction
    "%sollang.join.$(junction.junctionIr -> valueNameId(state)) = type { " -> print
    0 => contextField!
    contextField! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + contextField!] => input
        context.types[input.typeId].symbol == 4 -> if { "%sollang.event_stream, " -> print } else { "%sollang.stream, " -> print }
        contextField! + 1 => contextField!
    }
    "ptr, i32, [$(junction.inputCount) x i1]" -> print
    0 => cacheField!
    cacheField! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + cacheField!] => cacheInput
        ", " -> print
        context.types[cacheInput.typeId].first -> writeSemanticTypeId(context, state)
        cacheField! + 1 => cacheField!
    }
    " }" -> println
    junctionIndex -> emitConcurrentJunctionInputCallbacks(context, state)
    "define internal i1 @sollang_join_$(junction.junctionIr -> valueNameId(state))_next(ptr %context, ptr %output) {" -> println
    "entry:" -> println
    "  %runtime_address = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(junction.inputCount)" -> println
    "  %runtime = load ptr, ptr %runtime_address, align 8" -> println
    "  %index_address = alloca i32, align 4" -> println
    "  %kind_address = alloca i32, align 4" -> println
    "  %slot_address = alloca ptr, align 8" -> println
    "  br label %wait" -> println
    "wait:" -> println
    "  %available = call i1 @sollang_stream_join_runtime_next_event(ptr %runtime, ptr %index_address, ptr %kind_address, ptr %slot_address)" -> println
    "  br i1 %available, label %received, label %done" -> println
    "received:" -> println
    "  %index = load i32, ptr %index_address, align 4" -> println
    "  switch i32 %index, label %done [" -> println
    0 => switchInput!
    switchInput! < junction.inputCount -> while {
        "    i32 $(switchInput!), label %input$(switchInput!)" -> println
        switchInput! + 1 => switchInput!
    }
    "  ]" -> println
    0 => eventInput!
    eventInput! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + eventInput!] => input
        context.types[input.typeId].first => elementType
        "input$(eventInput!):" -> println
        "  %kind$(eventInput!) = load i32, ptr %kind_address, align 4" -> println
        "  %is_value$(eventInput!) = icmp eq i32 %kind$(eventInput!), 0" -> println
        "  %initialized_address$(eventInput!) = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(junction.inputCount + 2), i32 $(eventInput!)" -> println
        "  br i1 %is_value$(eventInput!), label %value$(eventInput!), label %completion$(eventInput!)" -> println
        "completion$(eventInput!):" -> println
        "  %was_initialized$(eventInput!) = load i1, ptr %initialized_address$(eventInput!), align 1" -> println
        "  br i1 %was_initialized$(eventInput!), label %wait, label %impossible$(eventInput!)" -> println
        "impossible$(eventInput!):" -> println
        "  call void @sollang_stream_join_runtime_cancel(ptr %runtime)" -> println
        "  ret i1 false" -> println
        "value$(eventInput!):" -> println
        "  %slot$(eventInput! -> valueNameId(state)) = load ptr, ptr %slot_address, align 8" -> println
        "  %item$(eventInput!) = load " -> print
        elementType -> writeSemanticTypeId(context, state)
        ", ptr %slot$(eventInput! -> valueNameId(state)), align $(context.typeAligns[elementType])" -> println
        "  %cache$(eventInput!) = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(junction.inputCount + 3 + eventInput!)" -> println
        "  store " -> print
        elementType -> writeSemanticTypeId(context, state)
        " %item$(eventInput!), ptr %cache$(eventInput!), align $(context.typeAligns[elementType])" -> println
        "  call void @sollang_stream_join_runtime_release(ptr %runtime, i32 $(eventInput!))" -> println
        "  %already_initialized$(eventInput!) = load i1, ptr %initialized_address$(eventInput!), align 1" -> println
        "  br i1 %already_initialized$(eventInput!), label %ready_check$(eventInput!), label %initialize$(eventInput!)" -> println
        "initialize$(eventInput!):" -> println
        "  store i1 true, ptr %initialized_address$(eventInput!), align 1" -> println
        "  %initialized_count_address$(eventInput!) = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(junction.inputCount + 1)" -> println
        "  %initialized_count$(eventInput!) = load i32, ptr %initialized_count_address$(eventInput!), align 4" -> println
        "  %next_initialized_count$(eventInput!) = add i32 %initialized_count$(eventInput!), 1" -> println
        "  store i32 %next_initialized_count$(eventInput!), ptr %initialized_count_address$(eventInput!), align 4" -> println
        "  br label %ready_check$(eventInput!)" -> println
        "ready_check$(eventInput!):" -> println
        "  %current_count_address$(eventInput!) = getelementptr %sollang.join.$(junction.junctionIr -> valueNameId(state)), ptr %context, i32 0, i32 $(junction.inputCount + 1)" -> println
        "  %current_count$(eventInput!) = load i32, ptr %current_count_address$(eventInput!), align 4" -> println
        "  %ready$(eventInput!) = icmp eq i32 %current_count$(eventInput!), $(junction.inputCount)" -> println
        "  br i1 %ready$(eventInput!), label %snapshot$(eventInput!), label %wait" -> println
        "snapshot$(eventInput!):" -> println
        junctionIndex -> emitConcurrentLatestSnapshot(eventInput!, context, state)
        eventInput! + 1 => eventInput!
    }
    "done:" -> println
    "  ret i1 false" -> println
    "}" -> println
    junctionIndex -> emitConcurrentJunctionDrop(context, state)
}

emitStreamJunctionRuntimes context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    false => concurrentRuntimeEmitted!
    0 => junctionIndex!
    junctionIndex! < (context.streamPlan.junctions -> len)
        -> while {
            context.streamPlan.junctions[junctionIndex!] => junction
            junction.kind == 2 and junction.policy == 0
                -> if { junctionIndex! -> emitZipJunctionRuntime(context, state) }
            junction.kind == 2 and junction.policy == 1 and not (junctionIndex! -> junctionRequiresConcurrent(context, state))
                -> if { junctionIndex! -> emitMergeJunctionRuntime(context, state) }
            junction.kind == 2 and junction.policy == 1 and (junctionIndex! -> junctionRequiresConcurrent(context, state))
                -> if {
                    not concurrentRuntimeEmitted! -> if {
                        context.expectedPathStyle == 1 -> if { streamJoinRuntime.emitWindowsPlatform() } else { streamJoinRuntime.emitLinuxPlatform() }
                        streamJoinRuntime.emitCommon()
                        true => concurrentRuntimeEmitted!
                    }
                    junctionIndex! -> emitConcurrentMergeJunctionRuntime(context, state)
                }
            junction.kind == 2 and junction.policy == 2
                -> if { junctionIndex! -> emitConcatJunctionRuntime(context, state) }
            junction.kind == 2 and junction.policy == 3 and not (junctionIndex! -> junctionRequiresConcurrent(context, state))
                -> if { junctionIndex! -> emitLatestJunctionRuntime(context, state) }
            junction.kind == 2 and junction.policy == 3 and (junctionIndex! -> junctionRequiresConcurrent(context, state))
                -> if {
                    not concurrentRuntimeEmitted! -> if {
                        context.expectedPathStyle == 1 -> if { streamJoinRuntime.emitWindowsPlatform() } else { streamJoinRuntime.emitLinuxPlatform() }
                        streamJoinRuntime.emitCommon()
                        true => concurrentRuntimeEmitted!
                    }
                    junctionIndex! -> emitConcurrentLatestJunctionRuntime(context, state)
                }
            junctionIndex! + 1 => junctionIndex!
        }
}

emitJunctionInputValue expressionIndex: Int, junctionIndex: Int, inputOrdinal: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.streamPlan.junctions[junctionIndex] => junction
    context.streamPlan.junctionInputs[junction.inputStart + inputOrdinal] => input
    "  %join$(expressionIndex -> valueNameId(state))_source$(inputOrdinal) = extractvalue " -> print
    context.ir[input.productIr] -> writeIrType(context, state)
    " " -> print
    input.productIr -> writeValue(ownerIndex, context, state)
    ", $(input.ordinal)" -> println
}

emitZipJunctionValue expressionIndex: Int, junctionIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.streamPlan.junctions[junctionIndex] => junction
    context.ir[expressionIndex] => expression
    "  %join$(expressionIndex -> valueNameId(state))_size_pointer = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr null, i32 1" -> println
    "  %join$(expressionIndex -> valueNameId(state))_size = ptrtoint ptr %join$(expressionIndex -> valueNameId(state))_size_pointer to i64" -> println
    "  %join$(expressionIndex -> valueNameId(state))_context = call ptr @sollang_alloc(i64 %join$(expressionIndex -> valueNameId(state))_size)" -> println
    0 => inputIndex!
    inputIndex! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + inputIndex!] => input
        expressionIndex -> emitJunctionInputValue(junctionIndex, inputIndex!, ownerIndex, context, state)
        context.types[input.typeId] => inputType
        "%sollang.stream" => producerType!
        inputType.symbol == 4 -> if { "%sollang.event_stream" => producerType! }
        "  %join$(expressionIndex -> valueNameId(state))_input$(inputIndex!) = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr %join$(expressionIndex -> valueNameId(state))_context, i32 0, i32 $(inputIndex!)" -> println
        "  store $(producerType!) " -> print
        "%join$(expressionIndex -> valueNameId(state))_source$(inputIndex!)" -> print
        ", ptr %join$(expressionIndex -> valueNameId(state))_input$(inputIndex!), align 8" -> println
        inputIndex! + 1 => inputIndex!
    }
    "  %join$(expressionIndex -> valueNameId(state))_done = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr %join$(expressionIndex -> valueNameId(state))_context, i32 0, i32 $(junction.inputCount)" -> println
    "  store i1 false, ptr %join$(expressionIndex -> valueNameId(state))_done, align 1" -> println
    "%sollang.stream" => resultType!
    context.types[expression.typeId].symbol == 4
        -> if { "%sollang.event_stream" => resultType! }
    "  %join$(expressionIndex -> valueNameId(state))_with_context = insertvalue $(resultType!) poison, ptr %join$(expressionIndex -> valueNameId(state))_context, 0" -> println
    "  %join$(expressionIndex -> valueNameId(state))_with_next = insertvalue $(resultType!) %join$(expressionIndex -> valueNameId(state))_with_context, ptr @sollang_join_$(expressionIndex -> valueNameId(state))_next, 1" -> println
    "  %v$(expressionIndex -> valueNameId(state)) = insertvalue $(resultType!) %join$(expressionIndex -> valueNameId(state))_with_next, ptr @sollang_join_$(expressionIndex -> valueNameId(state))_drop, 2" -> println
}

emitMergeJunctionValue expressionIndex: Int, junctionIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.streamPlan.junctions[junctionIndex] => junction
    context.ir[expressionIndex] => expression
    "  %join$(expressionIndex -> valueNameId(state))_size_pointer = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr null, i32 1" -> println
    "  %join$(expressionIndex -> valueNameId(state))_size = ptrtoint ptr %join$(expressionIndex -> valueNameId(state))_size_pointer to i64" -> println
    "  %join$(expressionIndex -> valueNameId(state))_context = call ptr @sollang_alloc(i64 %join$(expressionIndex -> valueNameId(state))_size)" -> println
    0 => inputIndex!
    inputIndex! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + inputIndex!] => input
        expressionIndex -> emitJunctionInputValue(junctionIndex, inputIndex!, ownerIndex, context, state)
        "  %join$(expressionIndex -> valueNameId(state))_input$(inputIndex!) = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr %join$(expressionIndex -> valueNameId(state))_context, i32 0, i32 $(inputIndex!)" -> println
        "  store %sollang.stream " -> print
        "%join$(expressionIndex -> valueNameId(state))_source$(inputIndex!)" -> print
        ", ptr %join$(expressionIndex -> valueNameId(state))_input$(inputIndex!), align 8" -> println
        inputIndex! + 1 => inputIndex!
    }
    "  %join$(expressionIndex -> valueNameId(state))_cursor = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr %join$(expressionIndex -> valueNameId(state))_context, i32 0, i32 $(junction.inputCount)" -> println
    "  store i32 0, ptr %join$(expressionIndex -> valueNameId(state))_cursor, align 4" -> println
    0 => activeIndex!
    activeIndex! < junction.inputCount -> while {
        "  %join$(expressionIndex -> valueNameId(state))_active$(activeIndex!) = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr %join$(expressionIndex -> valueNameId(state))_context, i32 0, i32 $(junction.inputCount + 1 + activeIndex!)" -> println
        "  store i1 true, ptr %join$(expressionIndex -> valueNameId(state))_active$(activeIndex!), align 1" -> println
        activeIndex! + 1 => activeIndex!
    }
    "%sollang.stream" => resultType!
    context.types[expression.typeId].symbol == 4
        -> if { "%sollang.event_stream" => resultType! }
    "  %join$(expressionIndex -> valueNameId(state))_with_context = insertvalue $(resultType!) poison, ptr %join$(expressionIndex -> valueNameId(state))_context, 0" -> println
    "  %join$(expressionIndex -> valueNameId(state))_with_next = insertvalue $(resultType!) %join$(expressionIndex -> valueNameId(state))_with_context, ptr @sollang_join_$(expressionIndex -> valueNameId(state))_next, 1" -> println
    "  %v$(expressionIndex -> valueNameId(state)) = insertvalue $(resultType!) %join$(expressionIndex -> valueNameId(state))_with_next, ptr @sollang_join_$(expressionIndex -> valueNameId(state))_drop, 2" -> println
}

emitLatestJunctionValue expressionIndex: Int, junctionIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.streamPlan.junctions[junctionIndex] => junction
    context.ir[expressionIndex] => expression
    "  %join$(expressionIndex -> valueNameId(state))_size_pointer = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr null, i32 1" -> println
    "  %join$(expressionIndex -> valueNameId(state))_size = ptrtoint ptr %join$(expressionIndex -> valueNameId(state))_size_pointer to i64" -> println
    "  %join$(expressionIndex -> valueNameId(state))_context = call ptr @sollang_alloc(i64 %join$(expressionIndex -> valueNameId(state))_size)" -> println
    0 => inputIndex!
    inputIndex! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + inputIndex!] => input
        expressionIndex -> emitJunctionInputValue(junctionIndex, inputIndex!, ownerIndex, context, state)
        "  %join$(expressionIndex -> valueNameId(state))_input$(inputIndex!) = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr %join$(expressionIndex -> valueNameId(state))_context, i32 0, i32 $(inputIndex!)" -> println
        "  store %sollang.stream " -> print
        "%join$(expressionIndex -> valueNameId(state))_source$(inputIndex!)" -> print
        ", ptr %join$(expressionIndex -> valueNameId(state))_input$(inputIndex!), align 8" -> println
        inputIndex! + 1 => inputIndex!
    }
    "  %join$(expressionIndex -> valueNameId(state))_cursor = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr %join$(expressionIndex -> valueNameId(state))_context, i32 0, i32 $(junction.inputCount)" -> println
    "  store i32 0, ptr %join$(expressionIndex -> valueNameId(state))_cursor, align 4" -> println
    "  %join$(expressionIndex -> valueNameId(state))_state = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr %join$(expressionIndex -> valueNameId(state))_context, i32 0, i32 $(junction.inputCount + 1)" -> println
    "  store i32 0, ptr %join$(expressionIndex -> valueNameId(state))_state, align 4" -> println
    0 => activeIndex!
    activeIndex! < junction.inputCount -> while {
        "  %join$(expressionIndex -> valueNameId(state))_active$(activeIndex!) = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr %join$(expressionIndex -> valueNameId(state))_context, i32 0, i32 $(junction.inputCount + 2 + activeIndex!)" -> println
        "  store i1 true, ptr %join$(expressionIndex -> valueNameId(state))_active$(activeIndex!), align 1" -> println
        activeIndex! + 1 => activeIndex!
    }
    "%sollang.stream" => resultType!
    context.types[expression.typeId].symbol == 4
        -> if { "%sollang.event_stream" => resultType! }
    "  %join$(expressionIndex -> valueNameId(state))_with_context = insertvalue $(resultType!) poison, ptr %join$(expressionIndex -> valueNameId(state))_context, 0" -> println
    "  %join$(expressionIndex -> valueNameId(state))_with_next = insertvalue $(resultType!) %join$(expressionIndex -> valueNameId(state))_with_context, ptr @sollang_join_$(expressionIndex -> valueNameId(state))_next, 1" -> println
    "  %v$(expressionIndex -> valueNameId(state)) = insertvalue $(resultType!) %join$(expressionIndex -> valueNameId(state))_with_next, ptr @sollang_join_$(expressionIndex -> valueNameId(state))_drop, 2" -> println
}

emitConcurrentJunctionValue expressionIndex: Int, junctionIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.streamPlan.junctions[junctionIndex] => junction
    "  %join$(expressionIndex -> valueNameId(state))_size_pointer = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr null, i32 1" -> println
    "  %join$(expressionIndex -> valueNameId(state))_size = ptrtoint ptr %join$(expressionIndex -> valueNameId(state))_size_pointer to i64" -> println
    "  %join$(expressionIndex -> valueNameId(state))_context = call ptr @sollang_alloc(i64 %join$(expressionIndex -> valueNameId(state))_size)" -> println
    "  %join$(expressionIndex -> valueNameId(state))_allocated = icmp ne ptr %join$(expressionIndex -> valueNameId(state))_context, null" -> println
    "  br i1 %join$(expressionIndex -> valueNameId(state))_allocated, label %join$(expressionIndex -> valueNameId(state))_initialize, label %join$(expressionIndex -> valueNameId(state))_allocation_failed" -> println
    "join$(expressionIndex -> valueNameId(state))_allocation_failed:" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "join$(expressionIndex -> valueNameId(state))_initialize:" -> println
    0 => inputIndex!
    inputIndex! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + inputIndex!] => input
        expressionIndex -> emitJunctionInputValue(junctionIndex, inputIndex!, ownerIndex, context, state)
        context.types[input.typeId] => inputType
        "%sollang.stream" => producerType!
        inputType.symbol == 4 -> if { "%sollang.event_stream" => producerType! }
        "  %join$(expressionIndex -> valueNameId(state))_input$(inputIndex!) = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr %join$(expressionIndex -> valueNameId(state))_context, i32 0, i32 $(inputIndex!)" -> println
        "  store $(producerType!) " -> print
        "%join$(expressionIndex -> valueNameId(state))_source$(inputIndex!)" -> print
        ", ptr %join$(expressionIndex -> valueNameId(state))_input$(inputIndex!), align 8" -> println
        inputIndex! + 1 => inputIndex!
    }
    junction.policy == 3 -> if {
        "  %join$(expressionIndex -> valueNameId(state))_initialized_count = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr %join$(expressionIndex -> valueNameId(state))_context, i32 0, i32 $(junction.inputCount + 1)" -> println
        "  store i32 0, ptr %join$(expressionIndex -> valueNameId(state))_initialized_count, align 4" -> println
        0 => initializedInput!
        initializedInput! < junction.inputCount -> while {
            "  %join$(expressionIndex -> valueNameId(state))_initialized$(initializedInput!) = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr %join$(expressionIndex -> valueNameId(state))_context, i32 0, i32 $(junction.inputCount + 2), i32 $(initializedInput!)" -> println
            "  store i1 false, ptr %join$(expressionIndex -> valueNameId(state))_initialized$(initializedInput!), align 1" -> println
            initializedInput! + 1 => initializedInput!
        }
    }
    -1 => maximumInput!
    0 => sizeInput!
    sizeInput! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + sizeInput!] => sizeInputPlan
        context.types[sizeInputPlan.typeId].first => elementType
        "  %join$(expressionIndex -> valueNameId(state))_item$(sizeInput!)_size_pointer = getelementptr " -> print
        elementType -> writeSemanticTypeId(context, state)
        ", ptr null, i32 1" -> println
        "  %join$(expressionIndex -> valueNameId(state))_item$(sizeInput!)_size = ptrtoint ptr %join$(expressionIndex -> valueNameId(state))_item$(sizeInput!)_size_pointer to i64" -> println
        maximumInput! < 0 -> if {
            sizeInput! => maximumInput!
        } else {
            "  %join$(expressionIndex -> valueNameId(state))_item$(sizeInput!)_larger = icmp ugt i64 %join$(expressionIndex -> valueNameId(state))_item$(sizeInput!)_size, %join$(expressionIndex -> valueNameId(state))_item_max$(sizeInput! - 1)" -> println
            "  %join$(expressionIndex -> valueNameId(state))_item_max$(sizeInput!) = select i1 %join$(expressionIndex -> valueNameId(state))_item$(sizeInput!)_larger, i64 %join$(expressionIndex -> valueNameId(state))_item$(sizeInput!)_size, i64 %join$(expressionIndex -> valueNameId(state))_item_max$(sizeInput! - 1)" -> println
        }
        sizeInput! == 0 -> if {
            "  %join$(expressionIndex -> valueNameId(state))_item_max0 = add i64 %join$(expressionIndex -> valueNameId(state))_item0_size, 0" -> println
        }
        sizeInput! + 1 => sizeInput!
    }
    "  %join$(expressionIndex -> valueNameId(state))_runtime = call ptr @sollang_stream_join_runtime_create(i32 $(junction.inputCount), i64 %join$(expressionIndex -> valueNameId(state))_item_max$(junction.inputCount - 1), ptr @sollang_join_$(expressionIndex -> valueNameId(state))_pull, ptr @sollang_join_$(expressionIndex -> valueNameId(state))_drop_item, ptr %join$(expressionIndex -> valueNameId(state))_context)" -> println
    "  %join$(expressionIndex -> valueNameId(state))_runtime_created = icmp ne ptr %join$(expressionIndex -> valueNameId(state))_runtime, null" -> println
    "  br i1 %join$(expressionIndex -> valueNameId(state))_runtime_created, label %join$(expressionIndex -> valueNameId(state))_runtime_ready, label %join$(expressionIndex -> valueNameId(state))_runtime_failed" -> println
    "join$(expressionIndex -> valueNameId(state))_runtime_failed:" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "join$(expressionIndex -> valueNameId(state))_runtime_ready:" -> println
    "  %join$(expressionIndex -> valueNameId(state))_runtime_address = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr %join$(expressionIndex -> valueNameId(state))_context, i32 0, i32 $(junction.inputCount)" -> println
    "  store ptr %join$(expressionIndex -> valueNameId(state))_runtime, ptr %join$(expressionIndex -> valueNameId(state))_runtime_address, align 8" -> println
    "  %join$(expressionIndex -> valueNameId(state))_with_context = insertvalue %sollang.event_stream poison, ptr %join$(expressionIndex -> valueNameId(state))_context, 0" -> println
    "  %join$(expressionIndex -> valueNameId(state))_with_next = insertvalue %sollang.event_stream %join$(expressionIndex -> valueNameId(state))_with_context, ptr @sollang_join_$(expressionIndex -> valueNameId(state))_next, 1" -> println
    "  %v$(expressionIndex -> valueNameId(state)) = insertvalue %sollang.event_stream %join$(expressionIndex -> valueNameId(state))_with_next, ptr @sollang_join_$(expressionIndex -> valueNameId(state))_drop, 2" -> println
}

emitConcatJunctionValue expressionIndex: Int, junctionIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.streamPlan.junctions[junctionIndex] => junction
    context.ir[expressionIndex] => expression
    "  %join$(expressionIndex -> valueNameId(state))_size_pointer = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr null, i32 1" -> println
    "  %join$(expressionIndex -> valueNameId(state))_size = ptrtoint ptr %join$(expressionIndex -> valueNameId(state))_size_pointer to i64" -> println
    "  %join$(expressionIndex -> valueNameId(state))_context = call ptr @sollang_alloc(i64 %join$(expressionIndex -> valueNameId(state))_size)" -> println
    0 => inputIndex!
    inputIndex! < junction.inputCount -> while {
        context.streamPlan.junctionInputs[junction.inputStart + inputIndex!] => input
        expressionIndex -> emitJunctionInputValue(junctionIndex, inputIndex!, ownerIndex, context, state)
        context.types[input.typeId] => inputType
        "%sollang.stream" => producerType!
        inputType.symbol == 4 -> if { "%sollang.event_stream" => producerType! }
        "  %join$(expressionIndex -> valueNameId(state))_input$(inputIndex!) = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr %join$(expressionIndex -> valueNameId(state))_context, i32 0, i32 $(inputIndex!)" -> println
        "  store $(producerType!) " -> print
        "%join$(expressionIndex -> valueNameId(state))_source$(inputIndex!)" -> print
        ", ptr %join$(expressionIndex -> valueNameId(state))_input$(inputIndex!), align 8" -> println
        inputIndex! + 1 => inputIndex!
    }
    "  %join$(expressionIndex -> valueNameId(state))_cursor = getelementptr %sollang.join.$(expressionIndex -> valueNameId(state)), ptr %join$(expressionIndex -> valueNameId(state))_context, i32 0, i32 $(junction.inputCount)" -> println
    "  store i32 0, ptr %join$(expressionIndex -> valueNameId(state))_cursor, align 4" -> println
    "%sollang.stream" => resultType!
    context.types[expression.typeId].symbol == 4
        -> if { "%sollang.event_stream" => resultType! }
    "  %join$(expressionIndex -> valueNameId(state))_with_context = insertvalue $(resultType!) poison, ptr %join$(expressionIndex -> valueNameId(state))_context, 0" -> println
    "  %join$(expressionIndex -> valueNameId(state))_with_next = insertvalue $(resultType!) %join$(expressionIndex -> valueNameId(state))_with_context, ptr @sollang_join_$(expressionIndex -> valueNameId(state))_next, 1" -> println
    "  %v$(expressionIndex -> valueNameId(state)) = insertvalue $(resultType!) %join$(expressionIndex -> valueNameId(state))_with_next, ptr @sollang_join_$(expressionIndex -> valueNameId(state))_drop, 2" -> println
}
