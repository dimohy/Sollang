                    ((context.ir[referenceRootBinding].kind == 10
                        and context.ir[referenceRootBinding].typeId >= 0
                        and context.types[context.ir[referenceRootBinding].typeId].kind == 8)
                        or context.ir[referenceRootBinding].flags == 1) -> if { true => referenceUsesMutableSlot! }
                }
                referenceUsesMutableSlot! -> if {
                    referenceArgumentIndex -> emitMutableReferencePlace(referenceRootBinding, callIndex, ordinal, ownerIndex, context, state) => emittedReferenceProjectionDepth
                } else {
                "  %callref" -> print
                callIndex -> writeDecimal
                "_arg" -> print
                ordinal -> writeDecimal
                " = alloca " -> print
                referenceOwnerType -> writeSemanticTypeId(context, state)
                ", align " -> print
                context.typeAligns[referenceOwnerType] -> writeDecimalLine
                "  store " -> print
                referenceOwnerType -> writeSemanticTypeId(context, state)
                " " -> print
                referenceArgumentIndex -> writeValue(ownerIndex, context, state)
                ", ptr %callref" -> print
                callIndex -> writeDecimal
                "_arg" -> print
                ordinal -> writeDecimal
                ", align " -> print
                context.typeAligns[referenceOwnerType] -> writeDecimalLine
                }
            }
        }
        context.ir[argumentIndex].nextOperand -> emitReferenceArgumentValues(callIndex, ownerIndex, ordinal + 1, context, state)
    }
}
emitWhileReferenceArgumentValues argumentIndex: Int, callIndex: Int, whileIndex: Int, ownerIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    (argumentIndex >= 0 and context.ir[argumentIndex].parent == callIndex) -> if {
        context.ir[argumentIndex] => callArgument
