    ", 0" -> println
    "  %v$(callIndex)_stderr_length = extractvalue %sollang.text " -> print
    argumentIndex -> writeValue(ownerIndex, context, state)
    ", 1" -> println
    "  call void @sollang_runtime_eprintln(ptr %v$(callIndex)_stderr_data, i64 %v$(callIndex)_stderr_length)" -> println
