        context.ir[call.parent] => arm
        (arm.parent >= 0 and (context.ir[arm.parent].kind == 37 or context.ir[arm.parent].kind == 38)) -> if {
            context.ir[arm.parent].operand1 => flowIndex!
            call -> sourceStart(context, state) => callStart
            UIntSize(0) => previousStart!
            0 => candidateIndex!
            candidateIndex! < (context.ir -> len) -> while {
                context.ir[candidateIndex!] => candidate
                (candidate.kind == 6 and candidate.parent == call.parent and candidateIndex! != callIndex) -> if {
                    candidate -> sourceStart(context, state) => candidateStart
                    (candidateStart < callStart and (flowIndex! == context.ir[arm.parent].operand1 or candidateStart > previousStart!)) -> if {
                        candidateIndex! => flowIndex!
                        candidateStart => previousStart!
                    }
                }
                candidateIndex! + 1 => candidateIndex!
            }
        }
    }
    flowIndex!
