# Entry and ordinary scheduling share the same resolved await identity used
# by value emission. A blocking join remains observable without a resume point.
isResolvedAwaitNode node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext -> Bool {
    node -> typedIr.isAsyncExpressionRead -> if { false -> return }
    node.kind == 5 and node.sourceModule >= 0 and node.sourceModule < (context.ranges -> len) and node.astNode >= 0
        -> if {
            context.ranges[node.sourceModule] => range
            node.astNode < range.astCount
                -> if { context.awaitSourceByAst[range.astStart + node.astNode] -> return }
        }
    false
}

isAwaitSourceNode nodeIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    nodeIndex >= 0 and nodeIndex < (context.ir -> len)
        -> if { context.ir[nodeIndex] -> isResolvedAwaitNode(context) -> return }
    false
}

awaitTaskProducer nodeIndex: Int, context: ref emitterContext.EmitContext -> Int {
    context.ir[nodeIndex].operand0 => producerIndex!
    0 => depth!
    producerIndex! >= 0 and producerIndex! < (context.ir -> len) and depth! < 4
        -> while {
            context.ir[producerIndex!] => producer
            ((producer.flags / 8) % 2 == 1
                and (producer.kind == 6 or producer.kind == 9))
                or (producer.kind != 5 and producer.kind != 17
                and (producer -> isAsyncTaskValue(context)))
                -> if {
                    4 => depth!
                } else {
                    (producer.kind == 5 or producer.kind == 17) and producer.operand0 >= 0
                        -> if {
                            producer.operand0 => producerIndex!
                            depth! + 1 => depth!
                        } else {
                            -1 => producerIndex!
                            4 => depth!
                        }
                }
        }
    producerIndex!
}

emitScopedTaskDrop bindingIndex: Int, ownerIndex: Int, regionIndex: Int, beforeAst: Int, edgeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[bindingIndex] => binding
    binding.operand0 => producerIndex
    false => consumed!
    # edgeIndex names emitted cleanup labels; it is not an IR array index.
    # Resolve an early edge by source identity before querying branch coverage.
    -1 => edgeNodeIndex!
    beforeAst >= 0 -> if {
        ownerIndex + 1 => edgeSearch!
        ownerIndex -> functionEnd(context, state) => edgeEnd
        edgeSearch! < edgeEnd and edgeNodeIndex! < 0 -> while {
            context.ir[edgeSearch!] => edgeNode
            edgeNode.sourceModule == binding.sourceModule and edgeNode.astNode == beforeAst
                -> if { edgeSearch! => edgeNodeIndex! }
            edgeSearch! + 1 => edgeSearch!
        }
    }
    context.moves -> each transfer {
        transfer.bindingIr == bindingIndex and transfer.memberIr < 0
            and (transfer.regionIr == regionIndex
            or ((beforeAst < 0 or edgeNodeIndex! >= 0)
            and (regionIndex -> regionFullyMovesPlace(binding.sourceModule, binding.symbol, -1, binding -> sourceStart(context, state), beforeAst, edgeNodeIndex!, context, state))))
            -> if {
                true => beforeEdge!
                beforeAst >= 0 -> if {
                    context.nodes[context.ranges[binding.sourceModule].astStart + beforeAst] => edge
                    (context.ir[transfer.siteIr] -> sourceStart(context, state)) < edge.start + edge.length => beforeEdge!
                }
                beforeEdge! -> if { true => consumed! }
            }
    }
    ownerIndex + 1 => consumerIndex!
    ownerIndex -> functionEnd(context, state) => end
    consumerIndex! < end and not consumed! -> while {
        context.ir[consumerIndex!] => consumer
        ((consumerIndex! -> isAwaitSourceNode(context)) or consumer.opcode == -321)
            and (consumerIndex! -> awaitTaskProducer(context)) == producerIndex
            -> if {
                consumer.parent => consumerScope!
                consumerScope! >= 0 and context.ir[consumerScope!].kind == 17
                    -> while { context.ir[consumerScope!].parent => consumerScope! }
                true => beforeEdge!
                beforeAst >= 0 -> if {
                    context.nodes[context.ranges[binding.sourceModule].astStart + beforeAst] => edge
                    (consumer -> sourceStart(context, state)) < edge.start + edge.length => beforeEdge!
                }
                consumerScope! == regionIndex and beforeEdge!
                    -> if { true => consumed! }
            }
        consumerIndex! + 1 => consumerIndex!
    }
    consumed! -> if { return }
    -1 => frameRoot!
    context.ir[ownerIndex].kind == 0 -> if { bindingIndex -> asyncFrameBindingRoot(ownerIndex, context, state) => frameRoot! }
    frameRoot! >= 0 -> if {
        "  %scope_task$(edgeIndex)_$(bindingIndex) = load %sollang.task, ptr " -> print
        frameRoot! -> writeAsyncLocalAddress(context)
        ", align $(context.pointerBitWidth / 8)" -> println
    }
    "  %scope_task$(edgeIndex)_$(bindingIndex)_task_handle = extractvalue %sollang.task " -> print
    frameRoot! >= 0 -> if { "%scope_task$(edgeIndex)_$(bindingIndex)" -> print } else { "%v$(producerIndex)" -> print }
    ", 0" -> println
    "  %scope_task$(edgeIndex)_$(bindingIndex)_task_context = extractvalue %sollang.task " -> print
    frameRoot! >= 0 -> if { "%scope_task$(edgeIndex)_$(bindingIndex)" -> print } else { "%v$(producerIndex)" -> print }
    ", 1" -> println
    "  %scope_task$(edgeIndex)_$(bindingIndex)_joined = call i1 @sollang_task_join(ptr %scope_task$(edgeIndex)_$(bindingIndex)_task_handle)" -> println
    "  br i1 %scope_task$(edgeIndex)_$(bindingIndex)_joined, label %scope_task$(edgeIndex)_$(bindingIndex)_done, label %scope_task$(edgeIndex)_$(bindingIndex)_failed" -> println
    "scope_task$(edgeIndex)_$(bindingIndex)_failed:" -> println
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "scope_task$(edgeIndex)_$(bindingIndex)_done:" -> println
    "scope_task$(edgeIndex)_$(bindingIndex)" -> emitJoinedTaskResultCompletion
    context.ir[producerIndex] => producer!
    producer!.typeId >= 0 -> if {
        context.types[producer!.typeId] => storedType
        storedType.kind == 7 and storedType.origin == 4 and storedType.symbol == 2
            -> if {
                storedType.first => producer!.typeId
            }
    }
    producer! => producer
    producer.typeId >= 0 and (producer.typeId -> semanticTypeOwns(context, state))
        -> if {
            "  %scope_task$(edgeIndex)_$(bindingIndex)_result = load " -> print
            producer.typeId -> writeSemanticTypeId(context, state)
            ", ptr %scope_task$(edgeIndex)_$(bindingIndex)_task_context, align " -> print
            producer -> storageAlign(context, state) -> writeDecimalLine
            "  call void @sollang_drop_t$(producer.typeId)(" -> print
            producer.typeId -> writeSemanticTypeId(context, state)
            " %scope_task$(edgeIndex)_$(bindingIndex)_result)" -> println
        }
    "  %scope_task$(edgeIndex)_$(bindingIndex)_released = call i1 @sollang_task_release(ptr %scope_task$(edgeIndex)_$(bindingIndex)_task_handle)" -> println
    "  br i1 %scope_task$(edgeIndex)_$(bindingIndex)_released, label %scope_task$(edgeIndex)_$(bindingIndex)_released_ok, label %scope_task$(edgeIndex)_$(bindingIndex)_failed" -> println
    "scope_task$(edgeIndex)_$(bindingIndex)_released_ok:" -> println
}

emitCancelTaskValue nodeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[nodeIndex] => cancellation
    cancellation.opcode == -321 and (cancellation.kind == 6 or cancellation.kind == 9)
        -> if {
            cancellation.operand0 >= 0 and cancellation.operand0 < (context.ir -> len)
                -> if {
                    "  %v$(nodeIndex)_cancel_handle = extractvalue %sollang.task " -> print
                    cancellation.operand0 -> writeValue(ownerIndex, context, state)
                    ", 0" -> println
                    "  %v$(nodeIndex)_cancelled = call i1 @sollang_task_cancel(ptr %v$(nodeIndex)_cancel_handle)" -> println
                    "  br i1 %v$(nodeIndex)_cancelled, label %cancel$(nodeIndex)_done, label %cancel$(nodeIndex)_failed" -> println
                    "cancel$(nodeIndex)_failed:" -> println
                    "  call void @llvm.trap()" -> println
                    "  unreachable" -> println
                    "cancel$(nodeIndex)_done:" -> println
                    nodeIndex -> emitCompletedPatternBindingTransferMarks(context, state)
                }
        }
}

emitCompletedFileRead namePrefix: Text, awaited: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.types[awaited.typeId].first => optionTypeId
    context.types[optionTypeId].first => scalarTypeId
    context.typeSizes[scalarTypeId] => scalarSize
    context.typeAligns[scalarTypeId] => scalarAlign
    "  %$(namePrefix)_file_result_slot = alloca " -> print
    awaited.typeId -> writeSemanticTypeId(context, state)
    ", align 8" -> println
    "  %$(namePrefix)_file_option_slot = alloca " -> print
    optionTypeId -> writeSemanticTypeId(context, state)
    ", align 8" -> println
    "  %$(namePrefix)_file_data_slot = getelementptr %sollang.task_control, ptr %$(namePrefix)_task_handle, i32 0, i32 13" -> println
    "  %$(namePrefix)_file_count_slot = getelementptr %sollang.task_control, ptr %$(namePrefix)_task_handle, i32 0, i32 14" -> println
    "  %$(namePrefix)_file_count = load i64, ptr %$(namePrefix)_file_count_slot, align 8" -> println
    "  %$(namePrefix)_file_ok_slot = getelementptr %sollang.task_control, ptr %$(namePrefix)_task_handle, i32 0, i32 15" -> println
    "  %$(namePrefix)_file_ok_value = load i32, ptr %$(namePrefix)_file_ok_slot, align 4" -> println
    "  %$(namePrefix)_file_ok = icmp ne i32 %$(namePrefix)_file_ok_value, 0" -> println
    "  store " -> print
    awaited.typeId -> writeSemanticTypeId(context, state)
    " zeroinitializer, ptr %$(namePrefix)_file_result_slot, align 8" -> println
    "  br i1 %$(namePrefix)_file_ok, label %file_$(namePrefix)_count, label %file_$(namePrefix)_error_io" -> println
    "file_$(namePrefix)_count:" -> println
    "  %$(namePrefix)_file_eof = icmp eq i64 %$(namePrefix)_file_count, 0" -> println
    "  br i1 %$(namePrefix)_file_eof, label %file_$(namePrefix)_none, label %file_$(namePrefix)_nonempty" -> println
    "file_$(namePrefix)_nonempty:" -> println
    "  %$(namePrefix)_file_full = icmp eq i64 %$(namePrefix)_file_count, $scalarSize" -> println
    "  br i1 %$(namePrefix)_file_full, label %file_$(namePrefix)_loaded, label %file_$(namePrefix)_error_truncated" -> println
    "file_$(namePrefix)_loaded:" -> println
    "  %$(namePrefix)_file_scalar = load " -> print
    scalarTypeId == 23 -> if { "i8" -> print } else { scalarTypeId -> writeSemanticTypeId(context, state) }
    ", ptr %$(namePrefix)_file_data_slot, align $scalarAlign" -> println
    scalarTypeId == 23 -> if {
        "  %$(namePrefix)_file_encoding_ok = icmp ule i8 %$(namePrefix)_file_scalar, 1" -> println
        "  br i1 %$(namePrefix)_file_encoding_ok, label %file_$(namePrefix)_valid, label %file_$(namePrefix)_error_invalid" -> println
    } else {
        scalarTypeId == 14 -> if {
            "  %$(namePrefix)_file_in_range = icmp ule i32 %$(namePrefix)_file_scalar, 1114111" -> println
            "  %$(namePrefix)_file_before_surrogate = icmp ult i32 %$(namePrefix)_file_scalar, 55296" -> println
            "  %$(namePrefix)_file_after_surrogate = icmp ugt i32 %$(namePrefix)_file_scalar, 57343" -> println
            "  %$(namePrefix)_file_not_surrogate = or i1 %$(namePrefix)_file_before_surrogate, %$(namePrefix)_file_after_surrogate" -> println
            "  %$(namePrefix)_file_encoding_ok = and i1 %$(namePrefix)_file_in_range, %$(namePrefix)_file_not_surrogate" -> println
            "  br i1 %$(namePrefix)_file_encoding_ok, label %file_$(namePrefix)_valid, label %file_$(namePrefix)_error_invalid" -> println
        } else { "  br label %file_$(namePrefix)_valid" -> println }
    }
    "file_$(namePrefix)_valid:" -> println
    "  store " -> print
    optionTypeId -> writeSemanticTypeId(context, state)
    " zeroinitializer, ptr %$(namePrefix)_file_option_slot, align 8" -> println
    "  %$(namePrefix)_file_some_tag = getelementptr inbounds " -> print
    optionTypeId -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_file_option_slot, i32 0, i32 0" -> println
    "  store i32 1, ptr %$(namePrefix)_file_some_tag, align 4" -> println
    "  %$(namePrefix)_file_some_payload = getelementptr inbounds " -> print
    optionTypeId -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_file_option_slot, i32 0, i32 1" -> println
    scalarTypeId == 23 -> if {
        "  %$(namePrefix)_file_bool = trunc i8 %$(namePrefix)_file_scalar to i1" -> println
    }
    "  store " -> print
    scalarTypeId -> writeSemanticTypeId(context, state)
    " " -> print
    scalarTypeId == 23 -> if { "%$(namePrefix)_file_bool" -> print } else { "%$(namePrefix)_file_scalar" -> print }
    ", ptr %$(namePrefix)_file_some_payload, align $scalarAlign" -> println
    "  %$(namePrefix)_file_some = load " -> print
    optionTypeId -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_file_option_slot, align 8" -> println
    "  %$(namePrefix)_file_ok_tag = getelementptr inbounds " -> print
    awaited.typeId -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_file_result_slot, i32 0, i32 0" -> println
    "  store i32 0, ptr %$(namePrefix)_file_ok_tag, align 4" -> println
    "  %$(namePrefix)_file_ok_payload = getelementptr inbounds " -> print
    awaited.typeId -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_file_result_slot, i32 0, i32 1" -> println
    "  store " -> print
    optionTypeId -> writeSemanticTypeId(context, state)
    " %$(namePrefix)_file_some, ptr %$(namePrefix)_file_ok_payload, align 8" -> println
    "  br label %file_$(namePrefix)_merge" -> println
    "file_$(namePrefix)_none:" -> println
    "  %$(namePrefix)_file_none = insertvalue " -> print
    optionTypeId -> writeSemanticTypeId(context, state)
    " zeroinitializer, i32 0, 0" -> println
    "  %$(namePrefix)_file_none_tag = getelementptr inbounds " -> print
    awaited.typeId -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_file_result_slot, i32 0, i32 0" -> println
    "  store i32 0, ptr %$(namePrefix)_file_none_tag, align 4" -> println
    "  %$(namePrefix)_file_none_payload = getelementptr inbounds " -> print
    awaited.typeId -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_file_result_slot, i32 0, i32 1" -> println
    "  store " -> print
    optionTypeId -> writeSemanticTypeId(context, state)
    " %$(namePrefix)_file_none, ptr %$(namePrefix)_file_none_payload, align 8" -> println
    "  br label %file_$(namePrefix)_merge" -> println
    "file_$(namePrefix)_error_io:" -> println
    "  %$(namePrefix)_file_io_text0 = insertvalue %sollang.text poison, ptr @sollang_file_error_io, 0" -> println
    "  %$(namePrefix)_file_io_text = insertvalue %sollang.text %$(namePrefix)_file_io_text0, i64 2, 1" -> println
    "  br label %file_$(namePrefix)_error_store" -> println
    "file_$(namePrefix)_error_truncated:" -> println
    "  %$(namePrefix)_file_truncated_text0 = insertvalue %sollang.text poison, ptr @sollang_file_error_truncated, 0" -> println
    "  %$(namePrefix)_file_truncated_text = insertvalue %sollang.text %$(namePrefix)_file_truncated_text0, i64 9, 1" -> println
    "  br label %file_$(namePrefix)_error_store" -> println
    "file_$(namePrefix)_error_invalid:" -> println
    "  %$(namePrefix)_file_invalid_text0 = insertvalue %sollang.text poison, ptr @sollang_file_error_invalid, 0" -> println
    "  %$(namePrefix)_file_invalid_text = insertvalue %sollang.text %$(namePrefix)_file_invalid_text0, i64 7, 1" -> println
    "  br label %file_$(namePrefix)_error_store" -> println
    "file_$(namePrefix)_error_store:" -> println
    "  %$(namePrefix)_file_error_text = phi %sollang.text [ %$(namePrefix)_file_io_text, %file_$(namePrefix)_error_io ], [ %$(namePrefix)_file_truncated_text, %file_$(namePrefix)_error_truncated ], [ %$(namePrefix)_file_invalid_text, %file_$(namePrefix)_error_invalid ]" -> println
    "  %$(namePrefix)_file_error_tag = getelementptr inbounds " -> print
    awaited.typeId -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_file_result_slot, i32 0, i32 0" -> println
    "  store i32 1, ptr %$(namePrefix)_file_error_tag, align 4" -> println
    "  %$(namePrefix)_file_error_payload = getelementptr inbounds " -> print
    awaited.typeId -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_file_result_slot, i32 0, i32 1" -> println
    "  store %sollang.text %$(namePrefix)_file_error_text, ptr %$(namePrefix)_file_error_payload, align 8" -> println
    "  br label %file_$(namePrefix)_merge" -> println
    "file_$(namePrefix)_merge:" -> println
    "  %$(namePrefix)_file_result = load " -> print
    awaited.typeId -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_file_result_slot, align 8" -> println
    "  store " -> print
    awaited.typeId -> writeSemanticTypeId(context, state)
    " %$(namePrefix)_file_result, ptr %$(namePrefix)_task_context, align 8" -> println
}

# Scalar writes succeed only after the worker reports a full transfer.
emitCompletedFileWrite namePrefix: Text, resultTypeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    "  %$(namePrefix)_file_write_result_slot = alloca " -> print
    resultTypeId -> writeSemanticTypeId(context, state)
    ", align 8" -> println
    "  store " -> print
    resultTypeId -> writeSemanticTypeId(context, state)
    " zeroinitializer, ptr %$(namePrefix)_file_write_result_slot, align 8" -> println
    "  %$(namePrefix)_file_write_size_slot = getelementptr %sollang.task_control, ptr %$(namePrefix)_task_handle, i32 0, i32 11" -> println
    "  %$(namePrefix)_file_write_size = load i32, ptr %$(namePrefix)_file_write_size_slot, align 4" -> println
    "  %$(namePrefix)_file_write_expected = zext i32 %$(namePrefix)_file_write_size to i64" -> println
    "  %$(namePrefix)_file_write_count_slot = getelementptr %sollang.task_control, ptr %$(namePrefix)_task_handle, i32 0, i32 14" -> println
    "  %$(namePrefix)_file_write_count = load i64, ptr %$(namePrefix)_file_write_count_slot, align 8" -> println
    "  %$(namePrefix)_file_write_ok_slot = getelementptr %sollang.task_control, ptr %$(namePrefix)_task_handle, i32 0, i32 15" -> println
    "  %$(namePrefix)_file_write_ok_value = load i32, ptr %$(namePrefix)_file_write_ok_slot, align 4" -> println
    "  %$(namePrefix)_file_write_ok = icmp ne i32 %$(namePrefix)_file_write_ok_value, 0" -> println
    "  %$(namePrefix)_file_write_full = icmp eq i64 %$(namePrefix)_file_write_count, %$(namePrefix)_file_write_expected" -> println
    "  %$(namePrefix)_file_write_success = and i1 %$(namePrefix)_file_write_ok, %$(namePrefix)_file_write_full" -> println
    "  br i1 %$(namePrefix)_file_write_success, label %file_write_$(namePrefix)_merge, label %file_write_$(namePrefix)_error" -> println
    "file_write_$(namePrefix)_error:" -> println
    "  %$(namePrefix)_file_write_error_tag = getelementptr inbounds " -> print
    resultTypeId -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_file_write_result_slot, i32 0, i32 0" -> println
    "  store i32 1, ptr %$(namePrefix)_file_write_error_tag, align 4" -> println
    "  %$(namePrefix)_file_write_error_payload = getelementptr inbounds " -> print
    resultTypeId -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_file_write_result_slot, i32 0, i32 1" -> println
    "  %$(namePrefix)_file_write_io0 = insertvalue %sollang.text poison, ptr @sollang_file_error_io, 0" -> println
    "  %$(namePrefix)_file_write_io = insertvalue %sollang.text %$(namePrefix)_file_write_io0, i64 2, 1" -> println
    "  store %sollang.text %$(namePrefix)_file_write_io, ptr %$(namePrefix)_file_write_error_payload, align 8" -> println
    "  br label %file_write_$(namePrefix)_merge" -> println
    "file_write_$(namePrefix)_merge:" -> println
    "  %$(namePrefix)_file_write_result = load " -> print
    resultTypeId -> writeSemanticTypeId(context, state)
    ", ptr %$(namePrefix)_file_write_result_slot, align 8" -> println
    "  store " -> print
    resultTypeId -> writeSemanticTypeId(context, state)
    " %$(namePrefix)_file_write_result, ptr %$(namePrefix)_task_context, align 8" -> println
}

# Both explicit await and scoped discard join before rebuilding runtime results.
# Each cleanup edge supplies its own SSA prefix; result storage stays Task-owned.
emitCompletedRuntimeTaskResult resultIndex: Int, producerIndex: Int, namePrefix: Text, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[producerIndex].opcode -> typedIr.isAsyncFileReadOpcode
        -> if { namePrefix -> emitCompletedFileRead(context.ir[resultIndex], context, state) }
    context.ir[producerIndex].opcode == typedIr.asyncFileWriteOpcode()
        -> if { namePrefix -> emitCompletedFileWrite(context.ir[resultIndex].typeId, context, state) }
    context.ir[producerIndex].opcode -> typedIr.isSocketCompletionDequeueOpcode
        -> if { context.ir[resultIndex].typeId -> emitCompletedSocketDequeue(producerIndex, namePrefix, context, state) }
}

# Result adapters travel with the Task control, including erased aggregate fields.
# Storage preserves async scheduling; normalization runs only after a successful join.
emitJoinedTaskResultCompletion namePrefix: Text -> Unit uses Console {
    "  %$(namePrefix)_completion_slot = getelementptr %sollang.task_control, ptr %$(namePrefix)_task_handle, i32 0, i32 22" -> println
    "  %$(namePrefix)_completion = load ptr, ptr %$(namePrefix)_completion_slot, align 8" -> println
    "  %$(namePrefix)_needs_completion = icmp ne ptr %$(namePrefix)_completion, null" -> println
    "  br i1 %$(namePrefix)_needs_completion, label %task_result_$(namePrefix)_complete, label %task_result_$(namePrefix)_ready" -> println
    "task_result_$(namePrefix)_complete:" -> println
    "  call void %$(namePrefix)_completion(ptr %$(namePrefix)_task_handle)" -> println
    "  store ptr null, ptr %$(namePrefix)_completion_slot, align 8" -> println
    "  br label %task_result_$(namePrefix)_ready" -> println
    "task_result_$(namePrefix)_ready:" -> println
}

emitRuntimeTaskResultCompletionFunctions context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    0 => producerIndex!
    producerIndex! < (context.ir -> len) -> while {
        context.ir[producerIndex!] => producer
        (producer.kind == 6 or producer.kind == 9)
            and ((producer.opcode -> typedIr.isAsyncFileOpcode) or (producer.opcode -> typedIr.isSocketCompletionDequeueOpcode))
            and (producerIndex! -> irNodeReachable(context, state))
            -> if {
                "define internal void @sollang_task_result_complete_n$(producerIndex!)(ptr %control) {" -> println
                "entry:" -> println
                "  %completed_task_handle = getelementptr i8, ptr %control, i64 0" -> println
                "  %completed_context_slot = getelementptr %sollang.task_control, ptr %control, i32 0, i32 0" -> println
                "  %completed_task_context = load ptr, ptr %completed_context_slot, align 8" -> println
                producerIndex! -> emitCompletedRuntimeTaskResult(producerIndex!, "completed", context, state)
                "  ret void" -> println
                "}" -> println
            }
        producerIndex! + 1 => producerIndex!
    }
}

emitAwaitTaskValue nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    nodeIndex -> isAwaitSourceNode(context) -> if {
        nodeIndex -> awaitTaskProducer(context) => producerIndex
        producerIndex >= 0 -> if {
            context.ir[nodeIndex] => awaited
            not (nodeIndex -> emitAsyncAwaitPoint(producerIndex, context, state))
                -> if {
                    "  %v$(nodeIndex)_task_handle = extractvalue %sollang.task %v$(producerIndex), 0" -> println
                    "  %v$(nodeIndex)_task_context = extractvalue %sollang.task %v$(producerIndex), 1" -> println
                }
            "  %v$(nodeIndex)_task_joined = call i1 @sollang_task_join(ptr %v$(nodeIndex)_task_handle)" -> println
            "  br i1 %v$(nodeIndex)_task_joined, label %await$(nodeIndex)_joined, label %await$(nodeIndex)_failed" -> println
            "await$(nodeIndex)_failed:" -> println
            "  call void @llvm.trap()" -> println
            "  unreachable" -> println
            "await$(nodeIndex)_joined:" -> println
            "v$(nodeIndex)" -> emitJoinedTaskResultCompletion
            not (awaited.typeOrigin == 1 and awaited.typeSymbol == 0)
                -> if {
                    "  " -> print
                    nodeIndex -> writeMemberStorageValueName(context, state)
                    " = load " -> print
                    awaited.typeId -> writeSemanticTypeId(context, state)
                    ", ptr %v$(nodeIndex)_task_context, align " -> print
                    awaited -> storageAlign(context, state) -> writeDecimalLine
                    awaited -> boundedArrayValueTypeId(context, state) => awaitedBoundedType
                    "v$(nodeIndex)" -> emitStoredBoundedValueHandle(awaitedBoundedType, context, state)
                }
            "  %v$(nodeIndex)_task_released = call i1 @sollang_task_release(ptr %v$(nodeIndex)_task_handle)" -> println
            "  br i1 %v$(nodeIndex)_task_released, label %await$(nodeIndex)_released, label %await$(nodeIndex)_release_failed" -> println
            "await$(nodeIndex)_release_failed:" -> println
            "  call void @llvm.trap()" -> println
            "  unreachable" -> println
            "await$(nodeIndex)_released:" -> println
            nodeIndex -> emitAsyncAwaitResultWrite(context, state)
            nodeIndex -> emitCompletedPatternBindingTransferMarks(context, state)
        }
    }
}

emitDurationSleepTask nodeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[nodeIndex] => node
    node.opcode == -113 and node.operand0 >= 0 -> if {
        context.ir[node.operand0] => duration
        "  %v$(nodeIndex)_sleep_millis = extractvalue " -> print
        duration -> writeIrType(context, state)
        " " -> print
        node.operand0 -> writeValue(ownerIndex, context, state)
        ", 0" -> println
        "  %v$(nodeIndex)_sleep_positive = icmp sgt i64 %v$(nodeIndex)_sleep_millis, 0" -> println
        "  %v$(nodeIndex)_sleep_normalized = select i1 %v$(nodeIndex)_sleep_positive, i64 %v$(nodeIndex)_sleep_millis, i64 0" -> println
        "  %v$(nodeIndex)_sleep_now = call i64 @sollang_now_millis()" -> println
        "  %v$(nodeIndex)_sleep_remaining = sub i64 9223372036854775807, %v$(nodeIndex)_sleep_now" -> println
        "  %v$(nodeIndex)_sleep_too_large = icmp sgt i64 %v$(nodeIndex)_sleep_normalized, %v$(nodeIndex)_sleep_remaining" -> println
        "  %v$(nodeIndex)_sleep_finite_deadline = add i64 %v$(nodeIndex)_sleep_now, %v$(nodeIndex)_sleep_normalized" -> println
        "  %v$(nodeIndex)_sleep_deadline = select i1 %v$(nodeIndex)_sleep_too_large, i64 9223372036854775807, i64 %v$(nodeIndex)_sleep_finite_deadline" -> println
        context -> usesReachableAsyncDiagnostics(state) => diagnosticSleep
        "  %v$(nodeIndex)_sleep_context = call ptr @sollang_alloc(i64 " -> print
        diagnosticSleep -> if { "56" -> print } else { "1" -> print }
        ")" -> println
        "  %v$(nodeIndex)_sleep_allocated = icmp ne ptr %v$(nodeIndex)_sleep_context, null" -> println
        "  br i1 %v$(nodeIndex)_sleep_allocated, label %sleep$(nodeIndex)_initialize, label %sleep$(nodeIndex)_allocation_failed" -> println
        "sleep$(nodeIndex)_allocation_failed:" -> println
        "  call void @llvm.trap()" -> println
        "  unreachable" -> println
        "sleep$(nodeIndex)_initialize:" -> println
        "  store i8 0, ptr %v$(nodeIndex)_sleep_context, align 1" -> println
        diagnosticSleep -> if {
            "  %v$(nodeIndex)_sleep_header = getelementptr i8, ptr %v$(nodeIndex)_sleep_context, i64 8" -> println
            "  store { ptr, ptr, i64, i64, ptr, ptr } zeroinitializer, ptr %v$(nodeIndex)_sleep_header, align 8" -> println
            "  %v$(nodeIndex)_sleep_handle = call ptr @sollang_task_start(ptr @sollang_diagnostic_sleep_worker, ptr @sollang_diagnostic_sleep_destroy, ptr @sollang_diagnostic_sleep_cancel, ptr %v$(nodeIndex)_sleep_context)" -> println
        } else {
            "  %v$(nodeIndex)_sleep_handle = call ptr @sollang_task_start(ptr @sollang_sleep_worker, ptr @sollang_free, ptr @sollang_sleep_cancel, ptr %v$(nodeIndex)_sleep_context)" -> println
        }
        "  %v$(nodeIndex)_sleep_started = icmp ne ptr %v$(nodeIndex)_sleep_handle, null" -> println
        "  br i1 %v$(nodeIndex)_sleep_started, label %sleep$(nodeIndex)_ready, label %sleep$(nodeIndex)_start_failed" -> println
        "sleep$(nodeIndex)_start_failed:" -> println
        "  call void @sollang_free(ptr %v$(nodeIndex)_sleep_context)" -> println
        "  call void @llvm.trap()" -> println
        "  unreachable" -> println
        "sleep$(nodeIndex)_ready:" -> println
        diagnosticSleep -> if {
            "v$(nodeIndex)_sleep" -> emitTaskDiagnosticHeaderStore("%v$(nodeIndex)_sleep_handle", "%v$(nodeIndex)_sleep_header")
            ownerIndex -> diagnosticCallerFunction(context) => parentFunction
            parentFunction >= 0 -> if {
                parentFunction -> asyncDiagnosticHeaderOffset(context, state) => parentOffset
                "  %v$(nodeIndex)_sleep_parent = getelementptr i8, ptr %async_context, i64 $(parentOffset)" -> println
                "  call void @sollang_diagnostic_inherit(ptr %v$(nodeIndex)_sleep_header, ptr %v$(nodeIndex)_sleep_handle, ptr %v$(nodeIndex)_sleep_parent)" -> println
            }
        }
        "  %v$(nodeIndex)_sleep_deadline_slot = getelementptr %sollang.task_control, ptr %v$(nodeIndex)_sleep_handle, i32 0, i32 8" -> println
        "  store i64 %v$(nodeIndex)_sleep_deadline, ptr %v$(nodeIndex)_sleep_deadline_slot, align 8" -> println
        "  %v$(nodeIndex)_task_handle = insertvalue %sollang.task poison, ptr %v$(nodeIndex)_sleep_handle, 0" -> println
        "  %v$(nodeIndex) = insertvalue %sollang.task %v$(nodeIndex)_task_handle, ptr %v$(nodeIndex)_sleep_context, 1" -> println
    }
}

writeIfDirectBranchTargets expression: typedIr.TypedIrNode, expressionIndex: Int -> Unit uses Console {
    expression.opcode == -28 -> if {
        ", label %if$(expressionIndex)_merge, label %if$(expressionIndex)_then" -> println
    } else {
        expression.nextOperand >= 0 -> if {
            ", label %if$(expressionIndex)_then, label %if$(expressionIndex)_else" -> println
        } else {
            ", label %if$(expressionIndex)_then, label %if$(expressionIndex)_merge" -> println
        }
    }
}

writeIfShortCircuitBodyTarget expression: typedIr.TypedIrNode, expressionIndex: Int -> Unit uses Console {
    expression.opcode == -28 -> if {
        "  br label %if$(expressionIndex)_merge" -> println
    } else {
        "  br label %if$(expressionIndex)_then" -> println
    }
}

writeIfShortCircuitExitTarget expression: typedIr.TypedIrNode, expressionIndex: Int -> Unit uses Console {
    expression.opcode == -28 -> if {
        "  br label %if$(expressionIndex)_then" -> println
    } else {
        expression.nextOperand >= 0 -> if {
            "  br label %if$(expressionIndex)_else" -> println
        } else {
            "  br label %if$(expressionIndex)_merge" -> println
        }
    }
}

# Responsibility fragment extracted from emitCore. State is passed by readonly
# reference, preserving the original direct-call and allocation behavior.
functionEnd functionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    state.frozenFunctionEnds[functionIndex]
}
isIntrinsicDeclaration node: typedIr.TypedIrNode -> Bool {
    node.kind == 0 and node.flags / 128 % 2 == 1 and node.flags / 512 % 2 == 0
}
isNativeDeclarationSymbol sourceModule: Int, symbol: Int, context: ref emitterContext.EmitContext -> Bool {
    false => native!
    sourceModule >= 0
        and sourceModule < (context.ranges -> len)
        and symbol >= 0
        and symbol < context.ranges[sourceModule].symbolCount
        -> if {
            context.ranges[sourceModule] => nativeRange
            context.symbols[nativeRange.symbolStart + symbol] => nativeSymbol
            nativeSymbol.kind == 7
                and nativeSymbol.flags / 128 % 2 == 1
                and nativeSymbol.flags / 512 % 2 == 0
                and nativeSymbol.astNode >= 0
                and nativeSymbol.astNode < nativeRange.astCount
                and context.nodes[nativeRange.astStart + nativeSymbol.astNode].cstRuleId == grammar.ruleIdNativeFunctionDeclaration()
                -> if { true => native! }
        }
    native!
}
isNativeFunction node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    (node -> isImportedLibraryFunction(context, state))
        or ((node -> isIntrinsicDeclaration)
        and (node.sourceModule -> isNativeDeclarationSymbol(node.symbol, context)))
}
nativeFunctionReachable functionIndex: Int, state: ref CoreEmitterState -> Bool {
    functionIndex >= 0
        and functionIndex < (state.frozenReachableFunctions -> len)
        and state.frozenReachableFunctions[functionIndex]
}
irNodeReachable nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    nodeIndex => ownerIndex!
    ownerIndex! >= 0
        and ownerIndex! < (context.ir -> len)
        and context.ir[ownerIndex!].kind != 0
        and context.ir[ownerIndex!].kind != 11 -> while {
            context.ir[ownerIndex!].parent => ownerIndex!
        }
    ownerIndex! -> nativeFunctionReachable(state)
}
# Runtime admission shares the exact function and implicit-drop roots of emission.
usesReachableProcessRuntime context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool uses Console, Process {
    context -> diagnostics.usesProcessRuntimeWithReachability(state.frozenReachableFunctions)
        -> if { true -> return }
    context -> activeSemanticDropTypes(state) => active
    0 => typeIndex!
    typeIndex! < (active -> len) -> while {
        active[typeIndex!] == 1 and (typeIndex! -> isOwnedProcessChildType(context, state))
            -> if { true -> return }
        typeIndex! + 1 => typeIndex!
    }
    false
}

usesReachableOwnedFileRuntime context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool uses Console, Process {
    context -> diagnostics.usesOwnedFileRuntimeWithReachability(state.frozenReachableFunctions)
        -> if { true -> return }
    context -> activeSemanticDropTypes(state) => active
    0 => typeIndex!
    typeIndex! < (active -> len) -> while {
        active[typeIndex!] == 1 and (typeIndex! -> isOwnedFileType(context, state))
            -> if { true -> return }
        typeIndex! + 1 => typeIndex!
    }
    false
}

usesReachableResizeRuntime context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context -> diagnostics.usesStandardInputSourceTextRuntimeWithReachability(state.frozenReachableFunctions)
        -> if { true -> return }
    0 => nodeIndex!
    nodeIndex! < (context.ir -> len) -> while {
        context.ir[nodeIndex!] => node
        (nodeIndex! -> irNodeReachable(context, state))
            and (node.opcode == -271 or (node.opcode == -229 and node.operand0 >= 0 and node.operand1 >= 0))
            -> if { true -> return }
        nodeIndex! + 1 => nodeIndex!
    }
    false
}

usesReachableRangeRuntime context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    0 => nodeIndex!
    nodeIndex! < (context.ir -> len) -> while {
        (nodeIndex! -> irNodeReachable(context, state))
            and (nodeIndex! -> isRangeDeferCall(context, state))
            -> if { true -> return }
        nodeIndex! + 1 => nodeIndex!
    }
    false
}

# Runtime admission follows the same frozen function reachability as emission.
usesReachableAsyncFileRuntime context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    0 => nodeIndex!
    nodeIndex! < (context.ir -> len) -> while {
        context.ir[nodeIndex!] => node
        (node.kind == 6 or node.kind == 9)
            and (node.opcode -> typedIr.isAsyncFileOpcode)
            and (nodeIndex! -> irNodeReachable(context, state))
            -> if { true -> return }
        nodeIndex! + 1 => nodeIndex!
    }
    false
}

usesReachableAsyncDiagnostics context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    0 => nodeIndex!
    nodeIndex! < (context.ir -> len) -> while {
        context.ir[nodeIndex!] => node
        (node.kind == 6 or node.kind == 9)
            and node.opcode <= -324 and node.opcode >= -327
            and (nodeIndex! -> irNodeReachable(context, state))
            -> if { true -> return }
        nodeIndex! + 1 => nodeIndex!
    }
    false
}

usesReachableAsyncRuntime context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context -> diagnostics.usesSocketCompletionRuntimeWithReachability(state.frozenReachableFunctions)
        -> if { true -> return }
    0 => nodeIndex!
    nodeIndex! < (context.ir -> len) -> while {
        context.ir[nodeIndex!] => node
        ((node.kind == 0 and (node.flags / 8) % 2 == 1)
            or ((node.kind == 6 or node.kind == 9)
            and ((node.flags / 8) % 2 == 1 or node.opcode == -113
            or (node.opcode -> typedIr.isAsyncFileOpcode))))
            and (nodeIndex! -> irNodeReachable(context, state))
            -> if { true -> return }
        nodeIndex! + 1 => nodeIndex!
    }
    false
}

usesReachablePathAbsolute context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    0 => nodeIndex!
    nodeIndex! < (context.ir -> len) -> while {
        context.ir[nodeIndex!] => node
        (node.kind == 6 or node.kind == 9) and node.opcode == typedIr.pathAbsoluteOpcode()
            and (nodeIndex! -> irNodeReachable(context, state))
            -> if { true -> return }
        nodeIndex! + 1 => nodeIndex!
    }
    false
}

emitWasmRuntimeTargetDiagnostics context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int uses Console {
    context -> usesReachablePathAbsolute(state) -> if {
        "; sollang semantic error: directory traversal is unavailable on the current target" -> println
        1 -> return
    }
    context -> usesReachableAsyncFileRuntime(state)
        -> if {
            "; sollang semantic error: asynchronous file I/O is unavailable on wasm32-browser; use a host-provided file adapter" -> println
            1 -> return
        }
    context -> usesReachableAsyncRuntime(state) -> if {
        "; sollang semantic error: async functions are unavailable on the current target" -> println
        1 -> return
    }
    0
}

nativeLibraryReachable sourceModule: Int, libraryAst: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => reachable!
    0 => functionIndex!
    functionIndex! < (context.ir -> len) and not reachable!
        -> while {
            context.ir[functionIndex!] => function
            (functionIndex! -> nativeFunctionReachable(state))
                and (function -> isNativeFunction(context, state))
                and function.sourceModule == sourceModule
                and (function -> nativeLibraryAst(context, state)) == libraryAst
                -> if {
                    true => reachable!
                }
            functionIndex! + 1 => functionIndex!
        }
    reachable!
}
isComFunction node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    node.kind == 0 and node.flags / 512 % 2 == 1
}
isImportedLibraryFunction node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    node.kind == 0
        and node.flags / 262144 % 2 == 1
        and node.sourceModule >= (context.ranges -> len)
        and node.sourceModule - (context.ranges -> len) < (context.libraries.interfaces -> len)
}
targetsImportedLibraryFunction node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => imported!
    context.ranges -> len => libraryModuleBase
    node.targetModule >= libraryModuleBase
        and node.targetModule - libraryModuleBase < (context.libraries.interfaces -> len)
        and node.symbol >= 0 -> if {
            node.targetModule - libraryModuleBase => interfaceIndex
            node.symbol < (context.libraries.interfaces[interfaceIndex].exports -> len)
                -> if {
                    true => imported!
                }
        }
    imported!
}
targetsNativeFunction node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    node -> targetsImportedLibraryFunction(context, state) => native!
    node.targetModule -> isNativeDeclarationSymbol(node.symbol, context)
        -> if { true => native! }
    native!
}
targetsNativeTry node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => nativeTry!
    node.targetModule -> isNativeDeclarationSymbol(node.symbol, context)
        -> if {
            context.ranges[node.targetModule] => nativeTryRange
            context.symbols[nativeTryRange.symbolStart + node.symbol] => nativeTrySymbol
            nativeTrySymbol.flags / 32768 % 2 == 1 -> if {
                true => nativeTry!
            }
        }
    nativeTry!
}
nativeTrySuccessTypeId node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => successType!
    (node -> targetsNativeTry(context, state))
        and node.typeId >= 0
        and node.typeId < (context.types -> len) -> if {
            context.types[node.typeId] => resultType
            resultType.kind == 7
                and resultType.origin == 4
                and resultType.symbol == 1
                and resultType.second == (context.types -> typeIds.builtinTypeId(5))
                -> if {
                    resultType.first => successType!
                }
        }
    successType!
}
writeNativeFunctionPointerSlot sourceModule: Int, symbol: Int, imported: Bool, context: ref emitterContext.EmitContext -> Unit uses Console {
    imported -> if {
        sourceModule - (context.ranges -> len) => nativeInterface
        "@sollang_library_function_i$(nativeInterface)_e$(symbol)" -> print
    } else {
        "@sollang_native_function_m$(sourceModule)_s$(symbol)" -> print
    }
}

emitNativeTargetLoad nodeIndex: Int, node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    node -> targetsNativeFunction(context, state)
        -> if {
            node -> targetsImportedLibraryFunction(context, state) => imported
            "  %native_target_$(nodeIndex) = load ptr, ptr " -> print
            node.targetModule -> writeNativeFunctionPointerSlot(node.symbol, imported, context)
            ", align 8" -> println
        }
}
writeResolvedCallTarget nodeIndex: Int, node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    node -> targetsNativeFunction(context, state) => resolvedNativeTarget
    resolvedNativeTarget -> if {
        " %native_target_$(nodeIndex)(" -> print
    }
    not resolvedNativeTarget -> if {
        node.targetModule => resolvedTargetModule!
        node.symbol => resolvedTargetSymbol!
        llvmRuntime.RuntimeFunctionRef { module: -1, symbol: -1 } => runtimeTarget!
        resolvedTargetSymbol! == -104 and state.intrinsicRuntimeModule >= 0
            -> if {
                state.intrinsicRuntimeModule -> runtimeFunctionRef("seedRandom", context) => runtimeTarget!
            }
        resolvedTargetSymbol! == -105 and state.intrinsicRuntimeModule >= 0
            -> if {
                state.intrinsicRuntimeModule -> runtimeFunctionRef("randomBelow", context) => runtimeTarget!
            }
        resolvedTargetSymbol! == -106 and state.intrinsicRuntimeModule >= 0
            -> if {
                state.intrinsicRuntimeModule -> runtimeFunctionRef("openIntWriter", context) => runtimeTarget!
            }
        resolvedTargetSymbol! == -107 and state.intrinsicRuntimeModule >= 0
            -> if {
                state.intrinsicRuntimeModule -> runtimeFunctionRef("writeInt", context) => runtimeTarget!
            }
        resolvedTargetSymbol! == -108 and state.intrinsicRuntimeModule >= 0
            -> if {
                state.intrinsicRuntimeModule -> runtimeFunctionRef("closeIntWriter", context) => runtimeTarget!
            }
        resolvedTargetSymbol! == -109 and state.intrinsicRuntimeModule >= 0
            -> if {
                state.intrinsicRuntimeModule -> runtimeFunctionRef("openIntReader", context) => runtimeTarget!
            }
        resolvedTargetSymbol! == -110 and state.intrinsicRuntimeModule >= 0
            -> if {
                state.intrinsicRuntimeModule -> runtimeFunctionRef("closestInt", context) => runtimeTarget!
            }
        resolvedTargetSymbol! == -111 and state.intrinsicRuntimeModule >= 0
            -> if {
                state.intrinsicRuntimeModule -> runtimeFunctionRef("closeIntReader", context) => runtimeTarget!
            }
        resolvedTargetSymbol! == -112 and state.intrinsicRuntimeModule >= 0
            -> if {
                state.intrinsicRuntimeModule -> runtimeFunctionRef("nowMillis", context) => runtimeTarget!
            }
        resolvedTargetSymbol! == -114 and state.intrinsicRuntimeModule >= 0
            -> if {
                state.intrinsicRuntimeModule -> runtimeFunctionRef("flushStandardOutput", context) => runtimeTarget!
            }
        runtimeTarget!.symbol >= 0 -> if {
            runtimeTarget!.module => resolvedTargetModule!
            runtimeTarget!.symbol => resolvedTargetSymbol!
        }
        " @sollang_m$(resolvedTargetModule!)_s$(resolvedTargetSymbol!)" -> print
        context -> emitterContext.genericFunctionForCall(nodeIndex) => genericFunction
        genericFunction >= 0 -> if { "_g$(genericFunction)" -> print }
        "(" -> print
    }
}
nativeLibraryAst function: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => libraryAst!
    function.sourceModule >= 0 and function.sourceModule < (context.ranges -> len) and function.symbol >= 0
        -> if {
            context.ranges[function.sourceModule] => nativeRange
            function.symbol < nativeRange.symbolCount -> if {
                context.symbols[nativeRange.symbolStart + function.symbol] => nativeSymbol
                nativeSymbol.astNode >= 0 -> if {
                    context.nodes[nativeRange.astStart + nativeSymbol.astNode] => nativeFunctionAst
                    nativeFunctionAst.parent >= 0 and context.nodes[nativeRange.astStart + nativeFunctionAst.parent].kind == 65
                        -> if {
                            nativeFunctionAst.parent => libraryAst!
                        }
                }
            }
        }
    libraryAst!
}
nativeSymbolToken function: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.ranges[function.sourceModule] => nativeRange
    context.symbols[nativeRange.symbolStart + function.symbol] => nativeSymbol
    nativeSymbol.nameToken => symbolToken!
    context.nodes[nativeRange.astStart + nativeSymbol.astNode] => nativeFunctionAst
    nativeFunctionAst.firstToken => nativeTokenSearch!
    nativeTokenSearch! < nativeFunctionAst.firstToken + nativeFunctionAst.tokenCount
        -> while {
            context.tokens[nativeRange.tokenStart + nativeTokenSearch!].kind == grammar.tokenIdString()
                -> if {
                    nativeTokenSearch! => symbolToken!
                }
            nativeTokenSearch! + 1 => nativeTokenSearch!
        }
    symbolToken!
}
controlArmValueIsConcrete valueIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    valueIndex < 0 or valueIndex >= (context.ir -> len)
        -> if { false -> return }
    context.ir[valueIndex] => valueNode
    valueNode.kind == 18 -> if {
        (valueNode.operand1 >= 0
            and valueNode.operand1 < (context.ir -> len)
            and context.ir[valueNode.operand1].kind == 19
            and context.ir[valueNode.operand1].operand1 >= 0
            and valueNode.nextOperand >= 0
            and valueNode.nextOperand < (context.ir -> len)
            and context.ir[valueNode.nextOperand].kind == 19
            and context.ir[valueNode.nextOperand].operand1 >= 0) -> return
    }
    valueNode.kind == 27 -> if {
        valueIndex -> enumMatchHasConcreteArmValues(context, state) -> return
    }
    valueNode.kind == 33 or valueNode.kind == 34 -> if {
        valueIndex -> whenHasConcreteArmValues(context, state) -> return
    }
    true
}

whenHasConcreteArmValues whenIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.ir[whenIndex] => whenNode
    whenNode.operand1 => armIndex!
    whenNode.kind == 33 -> if { whenNode.operand0 => armIndex! }
    false => hasElse!
    false => hasConcreteArm!
    true => valid!
    armIndex! >= 0 and not hasElse! and valid! -> while {
        armIndex! >= (context.ir -> len) -> if { false => valid! } else {
            context.ir[armIndex!] => arm
            arm.kind != 19 or arm.parent != whenIndex -> if { false => valid! } else {
                arm -> sourceNode(context, state) => armSource
                armIndex! => armRegion!
                armSource.kind == 58 -> if {
                    arm.operand1 => armRegion!
                } else { true => hasElse! }
                armRegion! < 0 or armRegion! >= (context.ir -> len)
                    -> if {
                        false => valid!
                    } else {
                        context.ir[armRegion!].kind != 19 -> if { false => valid! } else {
                            armRegion! -> regionReturns(context, state) -> unless {
                                true => hasConcreteArm!
                                armRegion! -> subjectWhenArmResultValueIndex(context, state) => valueIndex
                                valueIndex -> controlArmValueIsConcrete(context, state)
                                    -> unless { false => valid! }
                            }
                        }
                    }
                arm.nextOperand => armIndex!
            }
        }
    }
    valid! and hasElse! and hasConcreteArm!
}

enumMatchHasConcreteArmValues matchIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => valid!
    matchIndex >= 0 and matchIndex < (context.ir -> len) and context.ir[matchIndex].kind == 27
        -> if {
            true => valid!
            false => hasConcreteArm!
            context.ir[matchIndex].operand1 => armIndex!
            armIndex! >= 0 and armIndex! < (context.ir -> len) and valid!
                -> while {
                    context.ir[armIndex!] => arm
                    arm.kind != 19 or arm.parent != matchIndex -> if {
                        false => valid!
                    } else {
                        armIndex! -> regionReturns(context, state) -> unless {
                            true => hasConcreteArm!
                            armIndex! -> matchRegionResultValueIndex(context, state) => valueIndex
                            valueIndex -> controlArmValueIsConcrete(context, state)
                                -> unless { false => valid! }
                        }
                        arm.nextOperand => armIndex!
                    }
                }
            not hasConcreteArm! -> if { false => valid! }
        }
    valid!
}

irValueUsed nodeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => used!
    context.ir[nodeIndex] => valueCandidate
    nodeIndex -> valueHasDirectBinding(state)
        -> if { true => used! }
    valueCandidate.parent => valueParentIndex!
    not used! and valueParentIndex! >= 0 -> while {
        context.ir[valueParentIndex!] => valueParent
        valueParent.kind == 6
            or valueParent.kind == 12
            or valueParent.kind == 14
            or valueParent.kind == 16 -> if {
                true => used!
            } else {
                valueParent.kind == 9 -> if {
                    valueParent.parent => valueParentIndex!
                } else {
                    -1 => valueParentIndex!
                }
            }
    }
    not used!
        and valueCandidate.kind == 19
        and valueCandidate.parent >= 0
        and valueCandidate.parent < (context.ir -> len)
        and (context.ir[valueCandidate.parent].kind == 27
        or context.ir[valueCandidate.parent].kind == 33
        or context.ir[valueCandidate.parent].kind == 34)
        -> if {
            valueCandidate.parent -> irValueUsed(ownerIndex, context, state) => used!
        }
    ownerIndex + 1 => useIndex!
    ownerIndex -> functionEnd(context, state) => useEnd
    not used! and useIndex! < useEnd -> while {
        context.ir[useIndex!] => useNode
        false => internalUse!
        useNode.parent => useAncestor!
        useAncestor! >= 0 and not internalUse! -> while {
            useAncestor! == nodeIndex -> if { true => internalUse! } else {
                context.ir[useAncestor!].parent => useAncestor!
            }
        }
        -1 => useOperand0Value!
        -1 => useOperand1Value!
        useNode.operand0 >= 0 -> if { useNode.operand0 -> aggregateValueIndex(context, state) => useOperand0Value! }
        useNode.operand1 >= 0 -> if { useNode.operand1 -> aggregateValueIndex(context, state) => useOperand1Value! }
        (valueCandidate.kind == 18
            or valueCandidate.kind == 27
            or valueCandidate.kind == 33
            or valueCandidate.kind == 34)
            and useNode.kind == 19
            and useNode.operand1 >= 0
            and not internalUse!
            and useIndex! != nodeIndex
            -> if {
                false => nestedRegionTypeMatches!
                valueCandidate.typeId >= 0 and useNode.typeId == valueCandidate.typeId
                    -> if { true => nestedRegionTypeMatches! }
                valueCandidate.typeId < 0
                    and useNode.typeId < 0
                    and valueCandidate.typeKind == useNode.typeKind
                    and valueCandidate.typeOrigin == useNode.typeOrigin
                    and valueCandidate.typeModule == useNode.typeModule
                    and valueCandidate.typeSymbol == useNode.typeSymbol
                    -> if { true => nestedRegionTypeMatches! }
                NodeAncestorRequest { nodeIndex: useNode.operand1, ownerIndex: nodeIndex } => nestedResultRequest
                nestedResultRequest -> irDescendsFrom(context, state) => nestedResultDescends
                useNode.operand1 -> directBlockResultControlIndex(useIndex!, context, state) => directBlockResultControl
                nestedRegionTypeMatches!
                    and (nestedResultDescends or directBlockResultControl == nodeIndex)
                    -> if {
                        ownerIndex >= 0 and context.ir[ownerIndex].operand0 == useIndex!
                            -> if {
                                true => used!
                            } else {
                                useIndex! -> irValueUsed(ownerIndex, context, state) => used!
                            }
                    }
            }
        useIndex! != nodeIndex
            and (not internalUse!
            or useNode.operand0 == nodeIndex
            or useNode.operand1 == nodeIndex
            or useOperand0Value! == nodeIndex
            or useOperand1Value! == nodeIndex)
            and (useNode.operand0 == nodeIndex
            or useNode.operand1 == nodeIndex
            or useOperand0Value! == nodeIndex
            or useOperand1Value! == nodeIndex
            or (useNode.kind == 18 and useNode.nextOperand == nodeIndex))
            -> if {
                false => structuralRegionUse!
                useNode.kind == 19 -> if {
                    useNode -> sourceNode(context, state) => useSource
                    # A block region's operand1 forwards its last expression, but
                    # that value is only demanded when the region itself escapes.
                    # Arm-to-body links and sibling links are control structure,
                    # never value uses by themselves.
                    useSource.kind == 43 -> if {
                        useNode.operand1 == nodeIndex -> if {
                            useIndex! -> irValueUsed(ownerIndex, context, state) => used!
                        }
                    }
                    useNode.operand1 == nodeIndex -> if {
                        useIndex! => enumArmRegion!
                        enumArmRegion! >= 0 and context.ir[enumArmRegion!].kind == 19
                            -> while {
                                context.ir[enumArmRegion!].parent => enumArmRegion!
                            }
                        enumArmRegion! >= 0
                            and context.ir[enumArmRegion!].kind == 27
                            and not (context.ir[enumArmRegion!].typeOrigin == 1 and context.ir[enumArmRegion!].typeSymbol == 0)
                            and (enumArmRegion! -> enumMatchHasConcreteArmValues(context, state))
                            -> if {
                                enumArmRegion! -> irValueUsed(ownerIndex, context, state) => used!
                            }
                        useIndex! => whenArmRegion!
                        whenArmRegion! >= 0 and context.ir[whenArmRegion!].kind == 19
                            -> while {
                                context.ir[whenArmRegion!].parent => whenArmRegion!
                            }
                        whenArmRegion! >= 0
                            and (context.ir[whenArmRegion!].kind == 33 or context.ir[whenArmRegion!].kind == 34)
                            and not (context.ir[whenArmRegion!].typeOrigin == 1 and context.ir[whenArmRegion!].typeSymbol == 0)
                            -> if {
                                whenArmRegion! -> irValueUsed(ownerIndex, context, state) => used!
                            }
                    }
                    true => structuralRegionUse!
                }
                # A while consumes its operand1 region only as the loop body. The
                # region's final expression is not a value use of either the body
                # or a nested control expression. Treating this structural edge as
                # a use makes a statement-position enum match allocate a result
                # slot and store unrelated arm statement types into that slot.
                useNode.kind == 20 and useNode.operand1 == nodeIndex
                    -> if { true => structuralRegionUse! }
                not structuralRegionUse! -> if { true => used! }
            }
        useIndex! + 1 => useIndex!
    }
    used! and valueCandidate.kind == 18
        and not (nodeIndex -> controlResultShapeComplete(0, context, state))
        -> if { false => used! }
    used!
}
controlResultDiscardedByWhile nodeIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    nodeIndex => structuralValue!
    nodeIndex => ancestor!
    false => discarded!
    true => searching!
    searching! and ancestor! >= 0 -> while {
        context.ir[ancestor!].parent => parentIndex
        parentIndex < 0 -> if {
            false => searching!
        } else {
            context.ir[parentIndex] => parent
            parent.kind == 9 and parent.operand0 < 0 and parent.operand1 < 0
                -> if {
                    parentIndex => ancestor!
                } else {
                    parent.kind == 19 and parent.operand1 == structuralValue!
                        -> if {
                            parentIndex => structuralValue!
                            parentIndex => ancestor!
                        } else {
                            (parent.kind == 18 or parent.kind == 27 or parent.kind == 33 or parent.kind == 34)
                                and (parent.operand1 == structuralValue! or parent.nextOperand == structuralValue!)
                                -> if {
                                    parentIndex => structuralValue!
                                    parentIndex => ancestor!
                                } else {
                                    parent.kind == 20 and parent.operand1 == structuralValue!
                                        -> if {
                                            true => discarded!
                                            false => searching!
                                        } else {
                                            false => searching!
                                        }
                                }
                        }
                }
        }
    }
    discarded!
}
controlValueUsed nodeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.ir[nodeIndex] => candidate
    false => used!
    not (candidate.typeOrigin == 1 and candidate.typeSymbol == 0)
        and not (nodeIndex -> controlResultDiscardedByWhile(context))
        -> if { nodeIndex -> irValueUsed(ownerIndex, context, state) => used! }
    used!
}
callResultPropagationBindingIndex callIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => bindingIndex!
    callIndex >= 0 and callIndex < (context.ir -> len)
        -> if {
            context.ir[callIndex] => call
            call.parent >= 0 -> if {
                context.ir[call.parent] => binding
                binding.kind == 17
                    and binding.operand0 == callIndex
                    and binding.typeId >= 0
                    and call.typeId >= 0
                    and call.typeId < (context.types -> len)
                    and context.types[call.typeId].kind == 7
                    and context.types[call.typeId].origin == 4
                    and context.types[call.typeId].symbol == 1
                    and context.types[call.typeId].first == binding.typeId
                    and binding.sourceModule >= 0
                    and binding.sourceModule < (context.ranges -> len)
                    -> if {
                        context.ranges[binding.sourceModule] => propagationBindingRange
                        context.nodes[propagationBindingRange.astStart + binding.astNode] => propagationBindingAst
                        -1 => propagationBindingLastFlow!
                        propagationBindingAst.firstToken => propagationBindingTokenIndex!
                        propagationBindingTokenIndex! < propagationBindingAst.firstToken + propagationBindingAst.tokenCount
                            -> while {
                                context.tokens[propagationBindingRange.tokenStart + propagationBindingTokenIndex!] => propagationBindingToken
                                propagationBindingToken.kind == grammar.tokenIdQuestion() or propagationBindingToken.kind == grammar.tokenIdArrow()
                                    -> if {
                                        propagationBindingToken.kind => propagationBindingLastFlow!
                                    }
                                propagationBindingToken.kind == grammar.tokenIdFatArrow()
                                    -> if {
                                        propagationBindingAst.firstToken + propagationBindingAst.tokenCount => propagationBindingTokenIndex!
                                    } else {
                                        propagationBindingTokenIndex! + 1 => propagationBindingTokenIndex!
                                    }
                            }
                        propagationBindingLastFlow! == grammar.tokenIdQuestion()
                            -> if { call.parent => bindingIndex! }
                    }
            }
        }
    bindingIndex!
}
# Producer sources are evaluated once before entering the callback loop.
streamPipelineOwnsSource nodeIndex: Int, pipelineIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    pipelineIndex < 0 -> if { false -> return }
    context.streamPlan.pipelines[pipelineIndex] => pipeline
    false => insideSource!
    pipeline.source0 >= 0 -> if {
        NodeAncestorRequest { nodeIndex: nodeIndex, ownerIndex: pipeline.source0 } -> irDescendsFrom(context, state) => insideSource!
        nodeIndex == pipeline.source0 -> if { true => insideSource! }
    }
    pipeline.source1 >= 0 and not insideSource! -> if {
        NodeAncestorRequest { nodeIndex: nodeIndex, ownerIndex: pipeline.source1 } -> irDescendsFrom(context, state) => insideSource!
        nodeIndex == pipeline.source1 -> if { true => insideSource! }
    }
    insideSource!
}

# Deferred named producers retain callback ownership outside terminal ancestry.
streamPipelineOwnsCallback nodeIndex: Int, pipelineIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    pipelineIndex < 0 -> if { false -> return }
    nodeIndex -> streamPipelineOwnsSource(pipelineIndex, context, state)
        -> if { false -> return }
    context.streamPlan.pipelines[pipelineIndex] => pipeline
    false => owned!
    nodeIndex >= pipeline.callbackStart and nodeIndex <= pipeline.callbackEnd
        -> if { NodeAncestorRequest { nodeIndex: nodeIndex, ownerIndex: pipeline.terminalIr } -> irDescendsFrom(context, state) => owned! }
    pipeline.stageStart => stageIndex!
    stageIndex! < pipeline.stageStart + pipeline.stageCount and not owned!
        -> while {
            context.streamPlan.stages[stageIndex!] => stage
            nodeIndex >= stage.callbackStart and nodeIndex <= stage.callbackEnd
                -> if { NodeAncestorRequest { nodeIndex: nodeIndex, ownerIndex: stage.callIr } -> irDescendsFrom(context, state) => owned! }
            stageIndex! + 1 => stageIndex!
        }
    owned!
}

streamPipelineOwnsNode nodeIndex: Int, pipelineIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.streamPlan.pipelines[pipelineIndex] => pipeline
    nodeIndex == pipeline.terminalIr -> if { true -> return }
    nodeIndex -> streamPipelineOwnsCallback(pipelineIndex, context, state) => owned!
    pipeline.stageStart => stageIndex!
    stageIndex! < pipeline.stageStart + pipeline.stageCount and not owned!
        -> while {
            context.streamPlan.stages[stageIndex!].callIr == nodeIndex
                -> if { true => owned! }
            stageIndex! + 1 => stageIndex!
        }
    owned! and not (nodeIndex -> streamPipelineOwnsSource(pipelineIndex, context, state))
}

# Source subtrees must remain available before the stream body opens its loop.
regionOwnedStreamPipeline nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => found!
    0 => pipelineIndex!
    pipelineIndex! < (context.streamPlan.pipelines -> len) and found! < 0
        -> while {
            nodeIndex -> streamPipelineOwnsNode(pipelineIndex!, context, state)
                -> if { pipelineIndex! => found! }
            pipelineIndex! + 1 => pipelineIndex!
        }
    found!
}

# A callback's nested region continues its already open pipeline. A distinct
# pipeline declared inside that region still needs its own opening boundary.
regionStartingStreamPipeline nodeIndex: Int, regionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    0 => pipelineIndex!
    pipelineIndex! < (context.streamPlan.pipelines -> len)
        -> while {
            not (regionIndex -> streamPipelineOwnsCallback(pipelineIndex!, context, state))
                and (nodeIndex -> streamPipelineOwnsNode(pipelineIndex!, context, state))
                -> if { pipelineIndex! -> return }
            pipelineIndex! + 1 => pipelineIndex!
        }
    -1
}

streamCallbackHasNestedRegion nodeIndex: Int, pipelineIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    context.streamPlan.pipelines[pipelineIndex] => pipeline
    nodeIndex => ancestor!
    ancestor! >= 0 -> while {
        ancestor! == pipeline.terminalIr -> if { false -> return }
        pipeline.stageStart => stageIndex!
        stageIndex! < pipeline.stageStart + pipeline.stageCount
            -> while {
                context.streamPlan.stages[stageIndex!].callIr == ancestor!
                    -> if { false -> return }
                stageIndex! + 1 => stageIndex!
            }
        context.ir[ancestor!] => node
        node.kind == 19 or node.kind == 20 or node.kind == 33
            -> if { true -> return }
        node.parent => ancestor!
    }
    false
}
plannedStreamPipeline terminalIr: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => found!
    0 => pipelineIndex!
    pipelineIndex! < (context.streamPlan.pipelines -> len)
        -> while {
            context.streamPlan.pipelines[pipelineIndex!].terminalIr == terminalIr
                -> if { pipelineIndex! => found! }
            pipelineIndex! + 1 => pipelineIndex!
        }
    found!
}
plannedStreamStage callIr: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => found!
    0 => stageIndex!
    stageIndex! < (context.streamPlan.stages -> len)
        -> while {
            context.streamPlan.stages[stageIndex!].callIr == callIr
                -> if { stageIndex! => found! }
            stageIndex! + 1 => stageIndex!
        }
    found!
}
plannedStreamJunction junctionIr: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => found!
    0 => junctionIndex!
    junctionIndex! < (context.streamPlan.junctions -> len)
        -> while {
            context.streamPlan.junctions[junctionIndex!].junctionIr == junctionIr
                -> if { junctionIndex! => found! }
            junctionIndex! + 1 => junctionIndex!
        }
    found!
}
plannedPartitionRoute terminalIr: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => found!
    0 => routeIndex!
    routeIndex! < (context.streamPlan.partitionRoutes -> len)
        -> while {
            context.streamPlan.partitionRoutes[routeIndex!].terminalIr == terminalIr
                -> if { routeIndex! => found! }
            routeIndex! + 1 => routeIndex!
        }
    found!
}
plannedPartitionJunction routeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => found!
    0 => junctionIndex!
    junctionIndex! < (context.streamPlan.junctions -> len)
        -> while {
            context.streamPlan.junctions[junctionIndex!] => junction
            junction.kind == 1 and routeIndex >= junction.routeStart and routeIndex < junction.routeStart + junction.routeCount
                -> if { junctionIndex! => found! }
            junctionIndex! + 1 => junctionIndex!
        }
    found!
}
plannedPartitionPredicateRoute nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => found!
    0 => routeIndex!
    routeIndex! < (context.streamPlan.partitionRoutes -> len)
        -> while {
            context.streamPlan.partitionRoutes[routeIndex!] => route
            route.predicateIr >= 0 -> if {
                NodeAncestorRequest { nodeIndex: nodeIndex, ownerIndex: route.predicateIr } -> irDescendsFrom(context, state) => inside
                nodeIndex == route.predicateIr or inside -> if { routeIndex! => found! }
            }
            routeIndex! + 1 => routeIndex!
        }
    found!
}
partitionFirstTerminal junctionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.streamPlan.junctions[junctionIndex] => junction
    context.streamPlan.partitionRoutes[junction.routeStart].terminalIr
}
plannedPartitionCallbackRoute nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => found!
    0 => routeIndex!
    routeIndex! < (context.streamPlan.partitionRoutes -> len)
        -> while {
            context.streamPlan.partitionRoutes[routeIndex!] => route
            route.pipelineIndex >= 0 -> if {
                context.streamPlan.pipelines[route.pipelineIndex] => pipeline
                false => owned!
                nodeIndex != pipeline.terminalIr -> if {
                    NodeAncestorRequest { nodeIndex: nodeIndex, ownerIndex: pipeline.terminalIr } -> irDescendsFrom(context, state) => owned!
                }
                owned! and pipeline.source0 >= 0 -> if {
                    NodeAncestorRequest { nodeIndex: nodeIndex, ownerIndex: pipeline.source0 } -> irDescendsFrom(context, state) => insideSource
                    nodeIndex == pipeline.source0 or insideSource
                        -> if { false => owned! }
                }
                not owned! and nodeIndex != pipeline.terminalIr
                    -> if {
                        nodeIndex -> regionOwnedStreamPipeline(context, state) => ownerPipeline
                        ownerPipeline == route.pipelineIndex -> if { true => owned! }
                    }
                owned! -> if { routeIndex! => found! }
            }
            routeIndex! + 1 => routeIndex!
        }
    found!
}
isStreamTerminalRole pipelineIndex: Int, argumentIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    argumentIndex < 0 -> if { false -> return }
    context.ir[argumentIndex] => argument
    argument.kind != 5 -> if { false -> return }
    context -> emitterContext.isStreamTerminalRole(pipelineIndex, argument.sourceModule, argument.symbol)
}

streamCallbackInputValue pipelineIndex: Int, roleSymbol: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.streamPlan.pipelines[pipelineIndex] => pipeline
    context.ir[pipeline.terminalIr].sourceModule => sourceModule
    context -> emitterContext.streamCallbackInput(pipelineIndex, sourceModule, roleSymbol) => input
    input.valueIr -> aggregateValueIndex(context, state)
}

streamCallbackRole pipelineIndex: Int, expressionIndex: Int, runtimeArgumentIndex: Int, roleSymbol: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.streamPlan.pipelines[pipelineIndex] => pipeline
    context.ir[pipeline.terminalIr].sourceModule => sourceModule
    context -> emitterContext.streamCallbackInput(pipelineIndex, sourceModule, roleSymbol) => input
    input.kind == 2 -> if { 2 -> return }
    input.kind == 1 or input.kind == 3 -> if { 1 -> return }
    0 => direct!
    direct! == 0 and pipeline.terminalIr >= 0 and pipeline.terminalIr < (context.ir -> len)
        -> if {
            context.ir[pipeline.terminalIr] => terminal
            context.ranges[terminal.sourceModule] => terminalRange
            0 => terminalRoleSearch!
            terminalRoleSearch! < terminalRange.symbolCount
                -> while {
                    context.symbols[terminalRange.symbolStart + terminalRoleSearch!] => terminalRole
                    terminalRole.kind == 35 and terminalRole.astNode == terminal.astNode and roleSymbol == terminalRoleSearch!
                        -> if { 1 => direct! }
                    terminalRoleSearch! + 1 => terminalRoleSearch!
                }
        }
    direct!
}
isStreamFunctionIr functionIr: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => stream!
    context.ir[functionIr] => candidate
    candidate.kind == 0 and candidate.sourceModule >= 0 and candidate.sourceModule < (context.ranges -> len) and candidate.symbol >= 0
        -> if {
            context.ranges[candidate.sourceModule] => candidateRange
            candidate.symbol < candidateRange.symbolCount
                -> if {
                    context.symbols[candidateRange.symbolStart + candidate.symbol] => candidateSymbol
                    candidateSymbol.kind == 7 -> if { (candidateSymbol.flags / 64) % 2 == 1 => stream! }
                }
        }
    stream!
}
isRangeDeferCall callIr: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => deferCall!
    callIr >= 0 and callIr < (context.ir -> len)
        -> if {
            context.ir[callIr] => candidate
            candidate.kind == 6 and candidate.typeId >= 0 and candidate.typeId < (context.types -> len) and candidate.operand0 >= 0 and candidate.operand0 < (context.ir -> len) and candidate.targetModule >= 0 and candidate.targetModule < (context.ranges -> len) and candidate.symbol >= 0
                -> if {
                    context.types[candidate.typeId] => resultType
                    context.ir[candidate.operand0] => argument
                    context.ranges[candidate.targetModule] => targetRange
                    candidate.symbol < targetRange.symbolCount -> if {
                        context.symbols[targetRange.symbolStart + candidate.symbol] => target
                        resultType.kind == 7 and resultType.origin == 4 and resultType.symbol == 3 and argument.typeId >= 0 and argument.typeId < (context.types -> len)
                            -> if {
                                context.types[argument.typeId] => argumentType
                                argumentType.kind == 1 and argumentType.origin == 1 and argumentType.symbol == 25 and (candidate.targetModule -> sourceTokenIs(target.nameToken, "defer", context, state))
                                    -> if {
                                        true => deferCall!
                                    }
                            }
                    }
                }
        }
    deferCall!
}
isMouseEventsCall callIr: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context -> diagnostics.isMouseEventsCall(callIr)
}
isNativePathStyleCall callIr: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    callIr >= 0 and callIr < (context.ir -> len)
        and (context.ir[callIr].kind == 6 or context.ir[callIr].kind == 9)
        and context.ir[callIr].opcode == typedIr.pathNativeStyleOpcode()
}
emitNativePathStyleValue callIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[callIndex] => call
    "  %v$(callIndex)_native_style_slot = alloca " -> print
    call -> writeIrType(context, state)
    ", align 4" -> println
    "  store " -> print
    call -> writeIrType(context, state)
    " zeroinitializer, ptr %v$(callIndex)_native_style_slot, align 4" -> println
    "  %v$(callIndex)_native_style_tag = getelementptr inbounds " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(callIndex)_native_style_slot, i32 0, i32 0" -> println
    "  store i32 " -> print
    context.expectedPathStyle -> writeDecimal
    ", ptr %v$(callIndex)_native_style_tag, align 4" -> println
    "  %v$(callIndex) = load " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(callIndex)_native_style_slot, align 4" -> println
}
nodeDescendsFrom request: NodeAncestorRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => descends!
    context.ir[request.nodeIndex] => descendantNode
    context.ir[request.ownerIndex] => ownerNode
    descendantNode.sourceModule == ownerNode.sourceModule and descendantNode.astNode >= 0 and ownerNode.astNode >= 0
        -> if {
            context.ranges[descendantNode.sourceModule] => descendantRange
            context.nodes[descendantRange.astStart + descendantNode.astNode].parent => ancestorAst!
            ancestorAst! >= 0 and not descends! -> while {
                ancestorAst! == ownerNode.astNode -> if { true => descends! } else { context.nodes[descendantRange.astStart + ancestorAst!].parent => ancestorAst! }
            }
        }
    descends!
}
irDescendsFrom request: NodeAncestorRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => descends!
    context.ir[request.nodeIndex].parent => ancestor!
    ancestor! >= 0 and not descends! -> while {
        ancestor! == request.ownerIndex -> if { true => descends! } else { context.ir[ancestor!].parent => ancestor! }
    }
    descends!
}
# Both the pre-LLVM value-source invariant and native each lowering use this
# exact role declaration. Typed IR intentionally leaves a role read without
# operand0 because the loop produces its value on each iteration.
eachRoleOwner nodeIndex: Int, context: ref emitterContext.EmitContext -> Int {
    -1 => owner!
    context.ir[nodeIndex] => roleUse
    roleUse.kind == 5 and roleUse.operand0 < 0 and roleUse.symbol >= 0 and roleUse.sourceModule >= 0
        -> if {
            context.ranges[roleUse.sourceModule] => roleRange
            roleUse.symbol < roleRange.symbolCount -> if {
                context.symbols[roleRange.symbolStart + roleUse.symbol] => roleSymbol
                roleSymbol.kind == 35 and roleSymbol.astNode >= 0
                    -> if {
                        roleUse.parent => roleFunctionOwner!
                        roleFunctionOwner! >= 0 and context.ir[roleFunctionOwner!].kind != 0 and context.ir[roleFunctionOwner!].kind != 11
                            -> while { context.ir[roleFunctionOwner!].parent => roleFunctionOwner! }
                        roleFunctionOwner! >= 0 -> if {
                            roleFunctionOwner! + 1 => roleOwnerSearch!
                            roleOwnerSearch! < (context.ir -> len)
                                and context.ir[roleOwnerSearch!].kind != 0
                                and context.ir[roleOwnerSearch!].kind != 11
                                -> while {
                                    context.ir[roleOwnerSearch!] => roleOwnerCandidate
                                    roleOwnerCandidate.kind == 6 and (roleOwnerCandidate.opcode -> typedIr.isDirectIterationOpcode) and roleOwnerCandidate.sourceModule == roleUse.sourceModule and roleOwnerCandidate.astNode == roleSymbol.astNode
                                        -> if { roleOwnerSearch! => owner! }
                                    roleOwnerSearch! + 1 => roleOwnerSearch!
                                }
                        }
                    }
            }
        }
    owner!
}
functionCaptures functionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> [Int; ~] {
    [Int; ~] => captures!
    state.frozenFunctionCaptureOffsets[functionIndex] => cachedCaptureOffset
    0 => cachedCaptureIndex!
    cachedCaptureIndex! < state.frozenFunctionCaptureCounts[functionIndex]
        -> while {
            captures! -> push(state.frozenFunctionCaptureValues[cachedCaptureOffset + cachedCaptureIndex!])
            cachedCaptureIndex! + 1 => cachedCaptureIndex!
        }
    captures!
}
parallelBranchCaptures branchIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> [Int; ~] {
    [Int; ~] => captures!
    context.ir[branchIndex].operand0 => armIndex!
    armIndex! >= 0 -> while {
        context.ir[armIndex!].operand0 => stageIndex!
        stageIndex! >= 0 -> while {
            context.ir[stageIndex!] => stage
            CallEnvironmentRequest { callerIndex: -1, callIndex: stageIndex!, targetModule: stage.targetModule, targetSymbol: stage.symbol, hasArgument: true } -> targetFunctionIndex(context, state) => targetFunction
            targetFunction >= 0 -> if {
                targetFunction -> functionCaptures(context, state) => stageCaptures
                0 => stageCaptureIndex!
                stageCaptureIndex! < (stageCaptures -> len) -> while {
                    stageCaptures[stageCaptureIndex!] => stageCapture
                    false => alreadyCaptured!
                    0 => existingCaptureIndex!
                    existingCaptureIndex! < (captures! -> len) -> while {
                        context.ir[captures![existingCaptureIndex!]].symbol == context.ir[stageCapture].symbol
                            -> if { true => alreadyCaptured! }
                        existingCaptureIndex! + 1 => existingCaptureIndex!
                    }
                    not alreadyCaptured! -> if { captures! -> push(stageCapture) }
                    stageCaptureIndex! + 1 => stageCaptureIndex!
                }
            }
            context.ir[stageIndex!].nextOperand => stageIndex!
        }
        context.ir[armIndex!].nextOperand => armIndex!
    }
    captures!
}
parallelBranchArguments branchIndex: Int, context: ref emitterContext.EmitContext -> [Int; ~] {
    [Int; ~] => arguments!
    context.ir[branchIndex].operand0 => armIndex!
    armIndex! >= 0 -> while {
        context.ir[armIndex!].operand0 => stageIndex!
        stageIndex! >= 0 -> while {
            context.ir[stageIndex!].operand0 => argumentIndex!
            argumentIndex! >= 0 and context.ir[argumentIndex!].parent == stageIndex!
                -> while {
                    arguments! -> push(argumentIndex!)
                    context.ir[argumentIndex!].nextOperand => argumentIndex!
                }
            context.ir[stageIndex!].nextOperand => stageIndex!
        }
        context.ir[armIndex!].nextOperand => armIndex!
    }
    arguments!
}
parallelBranchArgumentOrdinal argumentIndex: Int, context: ref emitterContext.EmitContext -> Int {
    context.ir[argumentIndex].parent => callIndex
    context.ir[callIndex].operand0 => candidateIndex!
    1 => ordinal!
    candidateIndex! >= 0 and candidateIndex! != argumentIndex
        -> while {
            ordinal! + 1 => ordinal!
            context.ir[candidateIndex!].nextOperand => candidateIndex!
        }
    ordinal!
}
writeParallelBranchArgumentType argumentIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[argumentIndex].parent => callIndex
    argumentIndex -> parallelBranchArgumentOrdinal(context) => ordinal
    callIndex -> callTargetParameter(ordinal, context, state) => parameterIndex
    parameterIndex >= 0 -> if { context.ir[parameterIndex] -> writeFunctionValueAbiType(context, state) } else { context.ir[argumentIndex] -> writeFunctionValueAbiType(context, state) }
}

parallelBranchSourceUsesPointer source: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    (source -> referenceValueTypeId(context, state)) >= 0 or (source -> captureUsesBorrowAbi(context, state))
}

writeParallelBranchSourceType source: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    source -> parallelBranchSourceUsesPointer(context, state)
        -> if { "ptr" -> print } else {
            source -> writeFunctionValueAbiType(context, state)
        }
}

writeParallelBranchEnvironmentType branchIndex: Int, captures: [Int; ~], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    "{ " -> print
    context.ir[context.ir[branchIndex].operand1] -> writeParallelBranchSourceType(context, state)
    0 => captureIndex!
    captureIndex! < (captures -> len) -> while {
        ", " -> print
        context.ir[captures[captureIndex!]] => capture
        capture -> writeCaptureAbiType(context, state)
        captureIndex! + 1 => captureIndex!
    }
    branchIndex -> parallelBranchArguments(context) => arguments
    0 => argumentIndex!
    argumentIndex! < (arguments -> len) -> while {
        ", " -> print
        arguments[argumentIndex!] -> writeParallelBranchArgumentType(context, state)
        argumentIndex! + 1 => argumentIndex!
    }
    " }" -> print
}
targetFunctionIndex request: CallEnvironmentRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    request.callIndex => targetCallIndex!
    targetCallIndex! >= 0 and targetCallIndex! < (context.ir -> len)
        -> if {
            context.ir[targetCallIndex!] => call
            call.kind == 6 and (call.opcode == -207 or call.opcode == -209)
                and call.operand1 >= 0 and call.operand1 < (context.ir -> len)
                -> if {
                    context.ir[call.operand1] => bodyCall
                    bodyCall.targetModule == request.targetModule and bodyCall.symbol == request.targetSymbol
                        -> if { call.operand1 => targetCallIndex! }
                }
        }
    context -> emitterContext.genericFunctionForCall(targetCallIndex!) => genericFunction
    genericFunction >= 0 -> if { genericFunction -> return }
    -1 => targetFunctionIr!
    request.targetModule >= 0 and request.targetModule < (context.ranges -> len)
        -> if {
            context.ranges[request.targetModule].symbolStart + request.targetSymbol => targetGlobalSymbol
            targetGlobalSymbol >= 0 and targetGlobalSymbol < (state.frozenCaptureFunctionsBySymbol -> len)
                -> if {
                    state.frozenCaptureFunctionsBySymbol[targetGlobalSymbol] => targetFunctionIr!
                }
        }
    targetFunctionIr! < 0 and request.targetModule >= (context.ranges -> len)
        -> if {
            0 => importedFunctionSearch!
            importedFunctionSearch! < (context.ir -> len) and targetFunctionIr! < 0
                -> while {
                    context.ir[importedFunctionSearch!] => importedFunction
                    importedFunction.kind == 0
                        and importedFunction.sourceModule == request.targetModule
                        and importedFunction.symbol == request.targetSymbol
                        and importedFunction.flags / 262144 % 2 == 1
                        -> if {
                            importedFunctionSearch! => targetFunctionIr!
                        }
                    importedFunctionSearch! + 1 => importedFunctionSearch!
                }
        }
    targetFunctionIr!
}
functionParameterAt targetFunction: Int, ordinal: Int, context: ref emitterContext.EmitContext -> Int {
    -1 => parameter!
    targetFunction >= 0 -> if { context.ir[targetFunction].operand1 => parameter! }
    0 => parameterOrdinal!
    parameter! >= 0 and parameterOrdinal! < ordinal
        -> while {
            parameterOrdinal! == 0 -> if {
                context.ir[targetFunction].nextOperand => parameter!
            } else {
                context.ir[parameter!].nextOperand => parameter!
            }
            parameterOrdinal! + 1 => parameterOrdinal!
        }
    parameter!
}
callTargetParameter callIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.ir[callIndex] => call
    CallEnvironmentRequest { callerIndex: -1, callIndex: callIndex, targetModule: call.targetModule, targetSymbol: call.symbol, hasArgument: call.operand0 >= 0 } -> targetFunctionIndex(context, state) => targetFunction
    targetFunction -> functionParameterAt(ordinal, context) => parameter!
    # A frozen symbol lookup can resolve to an imported interface stub. Some
    # stubs expose only the primary parameter even though the concrete module
    # function has additional parameters. The emitted function definition is
    # authoritative for its ABI, so recover the matching concrete declaration
    # before deciding that the argument chain has ended.
    parameter! < 0 and call.targetModule >= 0 and call.symbol >= 0
        -> if {
            0 => candidateIndex!
            candidateIndex! < (context.ir -> len) and parameter! < 0
                -> while {
                    context.ir[candidateIndex!] => candidate
                    candidate.kind == 0
                        and candidate.sourceModule == call.targetModule
                        and candidate.symbol == call.symbol
                        -> if {
                            candidateIndex! -> functionParameterAt(ordinal, context) => candidateParameter
                            candidateParameter >= 0 -> if { candidateParameter => parameter! }
                        }
                    candidateIndex! + 1 => candidateIndex!
                }
        }
    parameter!
}
callHasResolvedFunctionTarget callIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.ir[callIndex] => call
    CallEnvironmentRequest {
        callerIndex: -1
        callIndex: callIndex
        targetModule: call.targetModule
        targetSymbol: call.symbol
        hasArgument: call.operand0 >= 0
    } => request
    (request -> targetFunctionIndex(context, state)) >= 0
}
callMutatesBinding callIndex: Int, bindingIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => mutates!
    callIndex >= 0 and callIndex < (context.ir -> len) and bindingIndex >= 0 and bindingIndex < (context.ir -> len)
        -> if {
            context.ir[callIndex].operand0 => argumentIndex!
            0 => ordinal!
            argumentIndex! >= 0 and not mutates! -> while {
                callIndex -> callTargetParameter(ordinal!, context, state) => parameterIndex
                parameterIndex >= 0 and context.ir[parameterIndex].flags / 2 % 2 == 1
                    -> if {
                        argumentIndex! -> aggregateValueIndex(context, state) => argumentValueIndex
                        argumentValueIndex -> referencePlaceRootBindingForEmission(ownerIndex, context, state) => argumentRoot
                        argumentRoot >= 0 -> if {
                            argumentRoot -> mutableBindingRoot(context, state) => argumentMutableRoot
                            bindingIndex -> mutableBindingRoot(context, state) => readMutableRoot
                            argumentMutableRoot == readMutableRoot -> if { true => mutates! }
                        }
                    }
                context.ir[argumentIndex!].nextOperand => argumentIndex!
                ordinal! + 1 => ordinal!
            }
        }
    mutates!
}
sourceTokenIs sourceIndex: Int, tokenIndex: Int, expected: Text, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => equal!
    sourceIndex >= 0 and sourceIndex < (context.ranges -> len) and tokenIndex >= 0
        -> if {
            context.ranges[sourceIndex] => tokenRange
            context.tokens[tokenRange.tokenStart + tokenIndex] => actual
            actual.span.length == (expected -> len) => equal!
            UIntSize(0) => tokenByte!
            equal! and tokenByte! < actual.span.length -> while {
                (context.sources[sourceIndex] -> byte(actual.span.start + tokenByte!)) != (expected -> byte(tokenByte!))
                    -> if { false => equal! }
                tokenByte! + 1 => tokenByte!
            }
        }
    equal!
}
sourceTokensEqual leftSource: Int, leftToken: Int, rightSource: Int, rightToken: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => equal!
    leftSource >= 0 and leftSource < (context.ranges -> len) and rightSource >= 0 and rightSource < (context.ranges -> len) and leftToken >= 0 and rightToken >= 0
        -> if {
            context.ranges[leftSource] => leftRange
            context.ranges[rightSource] => rightRange
            context.tokens[leftRange.tokenStart + leftToken] => left
            context.tokens[rightRange.tokenStart + rightToken] => right
            left.span.length == right.span.length => equal!
            UIntSize(0) => tokenByte!
            equal! and tokenByte! < left.span.length -> while {
                (context.sources[leftSource] -> byte(left.span.start + tokenByte!)) != (context.sources[rightSource] -> byte(right.span.start + tokenByte!))
                    -> if { false => equal! }
                tokenByte! + 1 => tokenByte!
            }
        }
    equal!
}
# Resolve a trait method for a nominal key without transferring `self`.
# Impl methods are ordinary typed-IR functions, so dictionary equality can
# call the same readonly-borrow ABI as an explicit method invocation.
traitMethodSymbol typeId: Int, traitName: Text, methodName: Text, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    typeId -> diagnostics.traitMethodSymbol(traitName, methodName, context) => resolvedMethod!
    resolvedMethod! >= 0 and typeId >= 0 and typeId < (context.types -> len)
        -> if {
            context.types[typeId].module => receiverSource
            receiverSource >= 0 and receiverSource < (context.ranges -> len)
                -> if {
                    context.ranges[receiverSource].symbolStart + resolvedMethod! => methodGlobalSymbol
                    methodGlobalSymbol < 0 or methodGlobalSymbol >= (state.frozenCaptureFunctionsBySymbol -> len) or state.frozenCaptureFunctionsBySymbol[methodGlobalSymbol] < 0
                        -> if { -1 => resolvedMethod! }
                } else { -1 => resolvedMethod! }
        }
    resolvedMethod!
}
# Resolves `alias.Trait.method` against the concrete receiver. The typed
# IR preserves the static call as opcode -226 so return types, including
# owned aggregates, remain the ordinary semantic result type.
staticTraitMethodSymbol nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => resolvedMethod!
    context.ir[nodeIndex] => dispatch
    dispatch.operand0 >= 0 and dispatch.sourceModule >= 0 and dispatch.astNode >= 0
        -> if {
            context.ranges[dispatch.sourceModule] => dispatchRange
            -1 => traitToken!
            -1 => methodToken!
            context.nodes[dispatchRange.astStart + dispatch.astNode] => dispatchAst
            0 => tokenSearch!
            tokenSearch! < dispatchRange.tokenCount -> while {
                context.tokens[dispatchRange.tokenStart + tokenSearch!] => dispatchToken
                dispatchToken.kind == grammar.tokenIdIdentifier() and dispatchToken.span.start >= dispatchAst.start and dispatchToken.span.start < dispatchAst.start + dispatchAst.length
                    -> if {
                        methodToken! >= 0 -> if { methodToken! => traitToken! }
                        tokenSearch! => methodToken!
                    }
                tokenSearch! + 1 => tokenSearch!
            }
            traitToken! >= 0 and methodToken! >= 0 -> if {
                context.tokens[dispatchRange.tokenStart + traitToken!] => traitNameToken
                context.tokens[dispatchRange.tokenStart + methodToken!] => methodNameToken
                context.sources[dispatch.sourceModule] -> slice(traitNameToken.span.start, traitNameToken.span.length) => traitName
                context.sources[dispatch.sourceModule] -> slice(methodNameToken.span.start, methodNameToken.span.length) => methodName
                context.ir[dispatch.operand0].typeId -> traitMethodSymbol(traitName, methodName, context, state) => resolvedMethod!
            }
        }
    resolvedMethod!
}
hasWorkerScalarArrayElement nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => supported!
    context.ir[nodeIndex] => arrayNode
    arrayNode.typeId >= 0 -> if {
        context.types[arrayNode.typeId] => arrayType
        arrayType.kind == 3 and arrayType.first >= 0
            -> if {
                context.types[arrayType.first] => elementType
                elementType.kind == 1 and elementType.origin == 1 and ((elementType.symbol >= 2 and elementType.symbol <= 14) or (elementType.symbol >= 19 and elementType.symbol <= 23))
                    -> if {
                        true => supported!
                    }
            }
    }
    supported!
}
hasWorkerSourceTextArrayElement nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => supported!
    context.ir[nodeIndex] => arrayNode
    arrayNode -> arrayElementTypeId(context, state) => elementTypeId
    elementTypeId >= 0 -> if {
        context.types[elementTypeId] => elementType
        elementType.kind == 1 and elementType.origin == 1 and elementType.symbol == 24
            -> if {
                true => supported!
            }
    }
    supported!
}
workerTransferType typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    [Int; ~] => pending!
    [Int; ~] => visited!
    pending! -> push(typeId)
    true => supported!
    0 => pendingIndex!
    supported! and pendingIndex! < (pending! -> len)
        -> while {
            pending![pendingIndex!] => currentTypeId
            false => alreadyVisited!
            0 => visitedIndex!
            visitedIndex! < (visited! -> len) -> while {
                visited![visitedIndex!] == currentTypeId -> if { true => alreadyVisited! }
                visitedIndex! + 1 => visitedIndex!
            }
            not alreadyVisited! -> if {
                visited! -> push(currentTypeId)
                currentTypeId < 0 or currentTypeId >= (context.types -> len)
                    -> if {
                        false => supported!
                    } else {
                        context.types[currentTypeId] => currentType
                        currentType.status != 0 -> if {
                            false => supported!
                        } else {
                            currentType.kind == 1 -> if {
                                currentType.origin == 1 -> if {
                                    not (currentType.symbol == 1 or (currentType.symbol >= 2 and currentType.symbol <= 14) or (currentType.symbol >= 19 and currentType.symbol <= 23))
                                        -> if {
                                            false => supported!
                                        }
                                } else {
                                    currentType.origin == 0 or currentType.origin == 2
                                        -> if {
                                            0 => fieldIndex!
                                            fieldIndex! < (context.fields -> len) -> while {
                                                context.fields[fieldIndex!] => field
                                                field.status == 0 and field.ownerType == currentTypeId
                                                    -> if {
                                                        pending! -> push(field.fieldType)
                                                    }
                                                fieldIndex! + 1 => fieldIndex!
                                            }
                                        } else {
                                            false => supported!
                                        }
                                }
                            } else {
                                currentType.kind == 3 or currentType.kind == 4 or currentType.kind == 6
                                    -> if {
                                        pending! -> push(currentType.first)
                                    } else {
                                        currentType.kind == 7 and currentType.origin == 4 and (currentType.symbol == 0 or currentType.symbol == 1)
                                            -> if {
                                                pending! -> push(currentType.first)
                                                currentType.second >= 0 -> if { pending! -> push(currentType.second) }
                                            } else {
                                                false => supported!
                                            }
                                    }
                            }
                        }
                    }
            }
            pendingIndex! + 1 => pendingIndex!
        }
    supported!
}
directWorkerSourceTextType typeId: Int, context: ref emitterContext.EmitContext -> Bool {
    false => supported!
    typeId >= 0 and typeId < (context.types -> len)
        -> if {
            context.types[typeId] => candidate
            candidate.status == 0 and candidate.kind == 1 and candidate.origin == 1 and candidate.symbol == 24
                -> if { true => supported! }
        }
    supported!
}
workerTryParallelResultType typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => supported!
    typeId >= 0 and typeId < (context.types -> len)
        -> if {
            context.types[typeId] => resultType
            resultType.status == 0 and resultType.kind == 7 and resultType.origin == 4 and resultType.symbol == 1
                and resultType.first >= 0 and resultType.second >= 0
                -> if {
                    (resultType.first -> workerTransferType(context, state))
                        or (resultType.first -> directWorkerSourceTextType(context)) => okTransferable
                    (resultType.second -> workerTransferType(context, state))
                        or (resultType.second -> directWorkerSourceTextType(context)) => errorTransferable
                    okTransferable and errorTransferable -> if { true => supported! }
                }
        }
    supported!
}
hasWorkerTransferArrayElement nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => supported!
    context.ir[nodeIndex] => arrayNode
    arrayNode -> arrayElementTypeId(context, state) => elementTypeId
    elementTypeId >= 0 -> if { elementTypeId -> workerTransferType(context, state) => supported! }
    supported!
}
parallelHasDirectBodyCall expressionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.ir[expressionIndex] => parallelExpression
    parallelExpression.kind != 6
        or (parallelExpression.opcode != -207 and parallelExpression.opcode != -209)
        or parallelExpression.operand0 < 0 or parallelExpression.operand1 < 0
        -> if { false -> return }
    context.ir[parallelExpression.operand1] => bodyCall
    bodyCall.kind != 6 or bodyCall.targetModule < 0 or bodyCall.symbol < 0
        or bodyCall.operand0 < 0
        -> if { false -> return }
    (bodyCall.operand0 -> structuredParallelRoleOwner(context)) != expressionIndex
        -> if { false -> return }
    CallEnvironmentRequest { callerIndex: -1, callIndex: expressionIndex, targetModule: bodyCall.targetModule, targetSymbol: bodyCall.symbol, hasArgument: true } -> targetFunctionIndex(context, state) => targetIndex
    targetIndex < 0 -> if { false -> return }
    context.ir[targetIndex] => target
    target.flags / 8 % 2 == 1 or target.operand1 < 0
        or target.typeId != bodyCall.typeId
        -> if { false -> return }
    context.ir[target.operand1].typeId != context.ir[bodyCall.operand0].typeId
        -> if { false -> return }
    context.ir[bodyCall.operand0].nextOperand => argumentIndex!
    argumentIndex! >= 0 -> while {
        context.ir[argumentIndex!] => argument
        argument.kind != 5
            or (argumentIndex! -> structuredParallelRoleOwner(context)) == expressionIndex
            -> if { false -> return }
        argument.nextOperand => argumentIndex!
    }
    context.ranges[parallelExpression.sourceModule] => range
    context.nodes[range.astStart + parallelExpression.astNode] => parallelAst
    context.nodes[range.astStart + bodyCall.astNode] => bodyAst
    bodyAst.parent != parallelExpression.astNode or bodyAst.flags / 524288 % 2 != 1
        -> if { false -> return }
    context.ir[parallelExpression.operand0].astNode => sourceAstIndex
    false => bodyFound!
    false => targetFound!
    0 => childIndex!
    childIndex! < range.astCount -> while {
        context.nodes[range.astStart + childIndex!] => child
        child.parent == parallelExpression.astNode and childIndex! != sourceAstIndex
            -> if {
                childIndex! == bodyCall.astNode -> if {
                    true => bodyFound!
                } else {
                    child.kind == 16 and child.payloadToken == parallelAst.payloadToken
                        and child.flags / 524288 % 2 != 1
                        -> if { true => targetFound! } else { false -> return }
                }
            }
        childIndex! + 1 => childIndex!
    }
    bodyFound! and targetFound!
}

isDirectParallelBodyCall expressionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.ir[expressionIndex] => expression
    expression.parent < 0 -> if { false -> return }
    context.ir[expression.parent].operand1 != expressionIndex
        -> if { false -> return }
    expression.parent -> parallelHasDirectBodyCall(context, state)
}

parallelUsesComputePool expressionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => supported!
    context.ir[expressionIndex] => parallelExpression
    context.supportsComputePool and (expressionIndex -> parallelHasDirectBodyCall(context, state))
        -> if {
            context.ir[parallelExpression.operand1] => parallelCall
            CallEnvironmentRequest { callerIndex: -1, callIndex: expressionIndex, targetModule: parallelCall.targetModule, targetSymbol: parallelCall.symbol, hasArgument: true } -> targetFunctionIndex(context, state) => parallelTarget
            parallelTarget >= 0 -> if {
                parallelExpression.operand0 -> hasWorkerScalarArrayElement(context, state) => scalarInput
                parallelExpression.operand0 -> hasWorkerTransferArrayElement(context, state) => transferableInput
                false => transferableOutput!
                parallelExpression.opcode == -207 -> if {
                    expressionIndex -> hasWorkerTransferArrayElement(context, state) => transferableOutput!
                } else {
                    parallelCall.typeId >= 0 -> if { parallelCall.typeId -> workerTryParallelResultType(context, state) => transferableOutput! }
                }
                scalarInput and transferableOutput! -> if { true => supported! }
                # Copyable nominal request records and recursively transferable
                # result records use the same direct worker ABI as scalar values.
                transferableInput and transferableOutput! -> if { true => supported! }
                parallelExpression.operand0 -> hasWorkerSourceTextArrayElement(context, state) => sourceTextInput
                sourceTextInput and transferableOutput! -> if { true => supported! }
                # The ownership pass is the single authority for callback
                # captures: E18 rejects mutable bindings and E19 rejects
                # structurally non-shareable values before LLVM emission. The
                # callback environment copies scalar captures and borrows owned
                # immutable captures until the structured join completes. Do not
                # reject safe scalar or readonly-reference captures here merely
                # because they do not use the owning-value ABI.
            }
        }
    supported!
}
# Capture signatures and all environment fields share the canonical value ABI.
captureUsesBorrowAbi binding: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    binding -> boundedArrayValueTypeId(context, state) => boundedType
    boundedType >= 0 -> if { boundedType -> semanticTypeOwns(context, state) -> return }
    binding -> ownsType
}

writeCaptureAbiType binding: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    binding -> captureUsesBorrowAbi(context, state)
        -> if { "ptr" -> print } else {
            binding -> writeFunctionValueAbiType(context, state)
        }
}

captureBindingIsLocal request: CaptureValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    request.callerIndex -> functionEnd(context, state) => callerEnd
    request.bindingIndex > request.callerIndex and request.bindingIndex < callerEnd
}

captureTransportPrefix request: CaptureValueRequest, storage: mut Arena -> Text {
    request.interpolationIndex >= 0 -> if {
        "interpolation$(request.callIndex)_expression$(request.interpolationIndex)_capture$(request.captureIndex)" -> materialize(storage) -> return
    }
    "callenv$(request.callIndex)_capture$(request.captureIndex)" -> materialize(storage)
}

captureParameterOrdinal request: CaptureValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.ir[request.bindingIndex] => binding
    context.ir[request.callerIndex].operand1 => primary
    primary >= 0 and context.ir[primary].symbol == binding.symbol
        -> if { 0 -> return }
    request.callerIndex -> additionalParameterOrdinal(binding.symbol, context, state)
}

emitBoundedCaptureTransport request: CaptureValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    request -> captureBindingIsLocal(context, state)
        -> unless { return }
    context.ir[request.bindingIndex] => binding
    binding -> boundedArrayValueTypeId(context, state) => boundedType
    boundedType < 0 -> if { return }
    Arena(0) => prefixStorage!
    request -> captureTransportPrefix(prefixStorage!) => prefix
    binding.kind == 10 and binding.flags / 2 % 2 == 1
        -> if {
            request -> captureParameterOrdinal(context, state) => ordinal
            ordinal < 0 -> if {
                "; sollang compiler error S019: bounded capture has no mutable parameter ordinal" -> println
                process.exit(1)
            }
            Arena(0) => sourcePrefixStorage!
            "$(prefix)_source" -> materialize(sourcePrefixStorage!) => sourcePrefix
            sourcePrefix -> emitCurrentMutableParameterValueAt(request.bindingIndex, ordinal, request.callerIndex, context, state)
        } else { binding.kind != 10 and binding.flags == 1 -> if {
                request.bindingIndex -> mutableBindingRoot(context, state) => bindingRoot
                "  %$(prefix)_source = load %sollang.array.i32, ptr %slot$(bindingRoot), align 8" -> println
            } else {
                "  %$(prefix)_source = freeze %sollang.array.i32 " -> print
                request -> emitCaptureValue(context, state)
                "" -> println
            }
        }
    Arena(0) => valuePrefixStorage!
    "$(prefix)_bounded" -> materialize(valuePrefixStorage!) => valuePrefix
    Arena(0) => sourceStorage!
    "%$(prefix)_source" -> materialize(sourceStorage!) => source
    valuePrefix -> emitBoundedArrayValueFromHandle(source, boundedType, context, state)
    binding -> captureUsesBorrowAbi(context, state)
        -> if {
            "  %$(prefix)_bounded_ref = alloca " -> print
            boundedType -> writeValueAbiTypeId(context, state)
            ", align $(context.typeAligns[boundedType])" -> println
            "  store " -> print
            boundedType -> writeValueAbiTypeId(context, state)
            " %$(prefix)_bounded, ptr %$(prefix)_bounded_ref, align $(context.typeAligns[boundedType])" -> println
        }
}

emitCaptureTransport request: CaptureValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[request.bindingIndex] => binding
    (binding -> boundedArrayValueTypeId(context, state)) >= 0
        -> if {
            request -> emitBoundedCaptureTransport(context, state)
            return
        }
    request -> captureBindingIsLocal(context, state)
        -> unless { return }
    Arena(0) => prefixStorage!
    request -> captureTransportPrefix(prefixStorage!) => prefix
    binding.kind == 10 and binding.flags / 2 % 2 == 1
        -> if {
            request -> captureParameterOrdinal(context, state) => ordinal
            ordinal < 0 -> if {
                "; sollang compiler error S019: capture has no mutable parameter ordinal" -> println
                process.exit(1)
            }
            prefix -> emitCurrentMutableParameterValueAt(request.bindingIndex, ordinal, request.callerIndex, context, state)
        } else {
            binding.kind != 10 and binding.flags == 1 and not (binding -> captureUsesBorrowAbi(context, state))
                -> if {
                    request.bindingIndex -> mutableBindingRoot(context, state) => bindingRoot
                    "  %$(prefix) = load " -> print
                    binding -> writeIrType(context, state)
                    ", ptr %slot$(bindingRoot), align " -> print
                    binding -> storageAlign(context, state) -> writeDecimalLine
                }
        }
    (binding -> captureUsesBorrowAbi(context, state)) and not (binding.kind != 10 and binding.flags == 1)
        -> if {
            request.interpolationIndex >= 0 -> if {
                "  %$(prefix)_ref = alloca " -> print
                binding -> writeIrType(context, state)
                ", align " -> print
                binding -> storageAlign(context, state) -> writeDecimalLine
            }
            "  store " -> print
            binding -> writeIrType(context, state)
            " " -> print
            request -> emitCaptureValue(context, state)
            ", ptr " -> print
            request -> emitCapturePointer(context, state)
            ", align " -> print
            binding -> storageAlign(context, state) -> writeDecimalLine
        }
}

writeCaptureArgumentValue request: CaptureValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    Arena(0) => prefixStorage!
    request -> captureTransportPrefix(prefixStorage!) => prefix
    context.ir[request.bindingIndex] => binding
    binding -> captureUsesBorrowAbi(context, state)
        -> if {
            request -> emitCapturePointer(context, state)
        } else {
            (binding -> boundedArrayValueTypeId(context, state)) >= 0
                and (request -> captureBindingIsLocal(context, state))
                -> if {
                    "%$(prefix)_bounded" -> print
                } else { request -> emitCaptureValue(context, state) }
        }
}

emitCapturePointer request: CaptureValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    Arena(0) => prefixStorage!
    request -> captureTransportPrefix(prefixStorage!) => prefix
    request.callerIndex -> functionEnd(context, state) => callerEnd
    context.ir[request.bindingIndex] => binding
    request.bindingIndex > request.callerIndex and request.bindingIndex < callerEnd
        -> if {
            (binding -> boundedArrayValueTypeId(context, state)) >= 0
                -> if {
                    "%$(prefix)_bounded_ref" -> print
                } else { binding.kind != 10 and binding.flags == 1 -> if {
                        request.bindingIndex -> mutableBindingRoot(context, state) => bindingRoot
                        "%slot$(bindingRoot)" -> print
                    } else { request.interpolationIndex >= 0 -> if {
                            "%$(prefix)_ref" -> print
                        } else {
                            "%capture_borrow_binding$(request.bindingIndex)" -> print
                } } }
        } else {
            request.callerIndex -> functionCaptures(context, state) => callerCaptures
            -1 => capturePosition!
            0 => callerCaptureIndex!
            callerCaptureIndex! < (callerCaptures -> len)
                -> while {
                    context.ir[callerCaptures[callerCaptureIndex!]].symbol == binding.symbol
                        -> if { callerCaptureIndex! => capturePosition! }
                    callerCaptureIndex! + 1 => callerCaptureIndex!
                }
            capturePosition! >= 0 -> if { "%capture_$(capturePosition!)" -> print } else { "null" -> print }
        }
}
emitCaptureValue request: CaptureValueRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    Arena(0) => prefixStorage!
    request -> captureTransportPrefix(prefixStorage!) => prefix
    context.ir[request.callerIndex] => caller
    context.ir[request.bindingIndex] => binding
    request.callerIndex -> functionEnd(context, state) => callerEnd
    request.bindingIndex > request.callerIndex and request.bindingIndex < callerEnd
        -> if {
            binding.kind == 10 -> if {
                request -> captureParameterOrdinal(context, state) => ordinal
                ordinal < 0 -> if {
                    "; sollang compiler error S019: capture has no parameter ordinal" -> println
                    process.exit(1)
                }
                binding.flags / 2 % 2 == 1 -> if {
                    "%$(prefix)" -> print
                } else { ordinal == 0 -> if { "%arg" -> print } else { "%arg$(ordinal)" -> print } }
            } else {
                binding.flags == 1 -> if { "%$(prefix)" -> print } else {
                    binding.operand0 -> writeValue(request.callerIndex, context, state)
                }
            }
        } else {
            request.callerIndex -> functionCaptures(context, state) => callerCaptures
            -1 => capturePosition!
            0 => callerCaptureIndex!
            callerCaptureIndex! < (callerCaptures -> len)
                -> while {
                    context.ir[callerCaptures[callerCaptureIndex!]].symbol == binding.symbol
                        -> if { callerCaptureIndex! => capturePosition! }
                    callerCaptureIndex! + 1 => callerCaptureIndex!
                }
            capturePosition! >= 0 -> if { "%capture_$(capturePosition!)" -> print } else {
                caller.operand1 >= 0 and context.ir[caller.operand1].symbol == binding.symbol
                    -> if { "%arg" -> print } else { "poison" -> print }
            }
        }
}
emitIntegerTextRootAllocas textIndex: Int, prefix: Text, ownerIndex: Int, lexicalIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    textIndex < 0 -> if { return }
    context.ir[textIndex].kind != 2 -> if { return }
    context.ir[textIndex] => textNode
    textNode -> sourceInterpolations(context, state) => interpolations
    textIndex -> interpolatedTextRoots(context, state) => roots
    0 => ordinal!
    ordinal! < (roots -> len) -> while {
        roots[ordinal!] -> interpolationNodeIntegerWidth(interpolations,
        textNode.sourceModule, ownerIndex, lexicalIndex, context, state) => width
        width > 0 -> if {
            "  %$(prefix)_root$(ordinal!)_buffer = alloca [21 x i8], align 1" -> println
        }
        ordinal! + 1 => ordinal!
    }
}

emitTransientIntegerTextAllocas textIndex: Int, callIndex: Int, ownerIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    textIndex < 0 -> if { return }
    textIndex -> isDeferredTextChoice(context, state)
        -> if {
            [Int; ~] => leaves!
            textIndex -> appendDeferredTextChoiceLeaves(leaves!, context, state)
            leaves! -> each leaf {
                leaf -> emitIntegerTextRootAllocas("calltext$(callIndex)_arg$(ordinal)_leaf$(leaf)",
                ownerIndex, leaf, context, state)
            }
        } else {
            textIndex -> emitIntegerTextRootAllocas("calltext$(callIndex)_arg$(ordinal)",
            ownerIndex, callIndex, context, state)
        }
}

isEmittedTextArgument argumentIndex: Int, callIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    argumentIndex >= 0
        and ((callIndex -> callTargetParameter(ordinal, context, state)) >= 0
        or (not (callIndex -> callHasResolvedFunctionTarget(context, state))
        and (context.ir[argumentIndex].parent == callIndex or argumentIndex == context.ir[callIndex].operand0)))
}

emitFormattingCallAllocas callIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[callIndex] => call
    (call.kind == 6 or call.kind == 9) and call.opcode == -229
        and call.operand0 >= 0 and call.operand1 >= 0
        -> if {
            call.operand0 -> producerValueIndex(context, state) => textIndex
            textIndex -> isDeferredTextChoice(context, state)
                -> if {
                    textIndex -> emitTransientIntegerTextAllocas(callIndex, ownerIndex, 0, context, state)
                } else {
                    textIndex -> emitIntegerTextRootAllocas("materialize$(callIndex)",
                    ownerIndex, callIndex, context, state)
                }
            return
        }
    call.kind == 8 and (call.opcode == grammar.tokenIdEqualEqual() or call.opcode == grammar.tokenIdBangEqual())
        and (call.operand0 -> comparisonReadIsText(context))
        and (call.operand1 -> comparisonReadIsText(context))
        -> if {
            call.operand0 -> transientTextOperandSource(callIndex, 0, context, state)
                -> emitTransientIntegerTextAllocas(callIndex, ownerIndex, 0, context, state)
            call.operand1 -> transientTextOperandSource(callIndex, 1, context, state)
                -> emitTransientIntegerTextAllocas(callIndex, ownerIndex, 1, context, state)
            return
        }
    call.kind == 6 or call.kind == 9 -> if {
        call.operand0 => argumentIndex!
        0 => ordinal!
        argumentIndex! -> isEmittedTextArgument(callIndex, ordinal!, context, state)
            -> while {
                argumentIndex! -> transientTextOperandSource(callIndex, ordinal!, context, state)
                    -> emitTransientIntegerTextAllocas(callIndex, ownerIndex, ordinal!, context, state)
                context.ir[argumentIndex!].nextOperand => argumentIndex!
                ordinal! + 1 => ordinal!
            }
    }
}

emitHoistedReferenceArgumentAllocas ownerIndex: Int, startIndex: Int, endIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    startIndex => callIndex!
    callIndex! < endIndex -> while {
        context.ir[callIndex!] => call
        call.kind == 6 or call.kind == 9 -> if {
            call.operand0 => argumentIndex!
            0 => ordinal!
            argumentIndex! >= 0
                and (callIndex! -> callTargetParameter(ordinal!, context, state)) >= 0
                -> while {
                    context.ir[argumentIndex!] => callArgument
                    argumentIndex! -> aggregateValueIndex(context, state) => referenceArgumentIndex
                    callIndex! -> callTargetParameter(ordinal!, context, state) => referenceParameterIndex
                    context.ir[referenceParameterIndex] => referenceParameter
                    referenceParameter.typeId >= 0
                        and context.types[referenceParameter.typeId].kind == 8
                        and not (callArgument.typeId >= 0
                        and context.types[callArgument.typeId].kind == 8)
                        -> if {
                            context.types[referenceParameter.typeId].first => referenceOwnerType
                            referenceArgumentIndex -> referencePlaceRootBindingForEmission(ownerIndex, context, state) => referenceRootBinding
                            referenceArgumentIndex -> referencePlaceAddressDepth(context, state) => referenceProjectionDepth
                            referenceRootBinding -> referenceRootHasAddress(ownerIndex, context, state) => referenceRootAddressable
                            (not referenceRootAddressable
                                and referenceProjectionDepth > 0
                                and (context.ir[referenceArgumentIndex].kind == 13
                                or (context.ir[referenceArgumentIndex].kind == 15
                                and context.ir[referenceArgumentIndex].operand0 >= 0
                                and context.ir[context.ir[referenceArgumentIndex].operand0].kind == 13))) => referenceNeedsTemporaryRoot
                            referenceNeedsTemporaryRoot and referenceRootBinding < 0
                                -> if {
                                    context.ir[referenceArgumentIndex] => missingRootArgument
                                    -1 => missingRootBaseKind!
                                    -1 => missingRootBaseOperand!
                                    -1 => missingRootBaseSymbol!
                                    -1 => missingRootBaseType!
                                    -1 => missingRootLeafKind!
                                    -1 => missingRootLeafOperand!
                                    -1 => missingRootLeafSymbol!
                                    -1 => missingRootLeafType!
                                    -1 => missingRootPrimaryKind!
                                    -1 => missingRootPrimarySymbol!
                                    -1 => missingRootPrimaryType!
                                    -1 => missingRootAdditionalKind!
                                    -1 => missingRootAdditionalSymbol!
                                    -1 => missingRootAdditionalType!
                                    missingRootArgument.operand0 >= 0
                                        and missingRootArgument.operand0 < (context.ir -> len)
                                        -> if {
                                            context.ir[missingRootArgument.operand0] => missingRootBase
                                            missingRootBase.kind => missingRootBaseKind!
                                            missingRootBase.operand0 => missingRootBaseOperand!
                                            missingRootBase.symbol => missingRootBaseSymbol!
                                            missingRootBase.typeId => missingRootBaseType!
                                            missingRootBase.operand0 >= 0
                                                and missingRootBase.operand0 < (context.ir -> len)
                                                -> if {
                                                    context.ir[missingRootBase.operand0] => missingRootLeaf
                                                    missingRootLeaf.kind => missingRootLeafKind!
                                                    missingRootLeaf.operand0 => missingRootLeafOperand!
                                                    missingRootLeaf.symbol => missingRootLeafSymbol!
                                                    missingRootLeaf.typeId => missingRootLeafType!
                                                }
                                        }
                                    ownerIndex >= 0 and ownerIndex < (context.ir -> len)
                                        -> if {
                                            context.ir[ownerIndex] => missingRootOwner
                                            missingRootOwner.operand1 >= 0
                                                and missingRootOwner.operand1 < (context.ir -> len)
                                                -> if {
                                                    context.ir[missingRootOwner.operand1] => missingRootPrimary
                                                    missingRootPrimary.kind => missingRootPrimaryKind!
                                                    missingRootPrimary.symbol => missingRootPrimarySymbol!
                                                    missingRootPrimary.typeId => missingRootPrimaryType!
                                                }
                                            missingRootOwner.nextOperand >= 0
                                                and missingRootOwner.nextOperand < (context.ir -> len)
                                                -> if {
                                                    context.ir[missingRootOwner.nextOperand] => missingRootAdditional
                                                    missingRootAdditional.kind => missingRootAdditionalKind!
                                                    missingRootAdditional.symbol => missingRootAdditionalSymbol!
                                                    missingRootAdditional.typeId => missingRootAdditionalType!
                                                }
                                        }
                                    "sollang compiler verification failure V009: readonly projected call argument lost its addressable root before LLVM emission at ir $(callIndex!) (argument $referenceArgumentIndex/$(missingRootArgument.kind)/$(missingRootArgument.parent)/$(missingRootArgument.operand0)/$(missingRootArgument.symbol)/$(missingRootArgument.typeId), base $(missingRootBaseKind!)/$(missingRootBaseOperand!)/$(missingRootBaseSymbol!)/$(missingRootBaseType!), leaf $(missingRootLeafKind!)/$(missingRootLeafOperand!)/$(missingRootLeafSymbol!)/$(missingRootLeafType!), parameters $(missingRootPrimaryKind!)/$(missingRootPrimarySymbol!)/$(missingRootPrimaryType!),$(missingRootAdditionalKind!)/$(missingRootAdditionalSymbol!)/$(missingRootAdditionalType!), ordinal $(ordinal!), owner $ownerIndex, target $(call.targetModule)/$(call.symbol), source $(call.sourceModule), ast $(call.astNode)); do not borrow a literal or temporary and do not copy the projected value as a fallback; preserve the valid binding or parameter root in Typed IR" -> runtime.eprintln
                                }
                            referenceOwnerType => referenceStorageType!
                            referenceNeedsTemporaryRoot and referenceRootBinding >= 0
                                -> if { referenceRootBinding -> referenceRootStorageType(context) => referenceStorageType! }
                            not referenceRootAddressable
                                and (referenceProjectionDepth == 0
                                or (referenceNeedsTemporaryRoot and referenceRootBinding >= 0))
                                -> if {
                                    "  %callref$(callIndex!)_arg$(ordinal!) = alloca " -> print
                                    referenceStorageType! -> writeValueAbiTypeId(context, state)
                                    ", align " -> print
                                    referenceStorageType! -> runtimeAggregateStorageAlignment(context) -> writeDecimalLine
                                }
                        }
                    context.ir[argumentIndex!].nextOperand => argumentIndex!
                    ordinal! + 1 => ordinal!
                }
            callIndex! -> callArgumentIndex(context, state) => interpolationArgumentIndex!
            # Materialize consumes deferred Text through its flow source;
            # its ordinary argument is the Arena. Use the same scratch planner
            # and consumer label for that source as for other Text consumers.
            call.opcode == -229 and call.operand0 >= 0 and call.operand1 >= 0
                => materializedInterpolationSource
            materializedInterpolationSource -> if { call.operand0 => interpolationArgumentIndex! }
            [Int; ~] => interpolationTextIndices!
            interpolationArgumentIndex! >= 0 -> while {
                interpolationArgumentIndex! -> aggregateValueIndex(context, state) => interpolationArgumentValueIndex
                interpolationArgumentValueIndex -> producerValueIndex(context, state) => interpolationTextIndex!
                call -> typedIr.isConsoleRuntimeCall -> if {
                    callIndex! -> regionOwnedStreamPipeline(context, state) => pipelineIndex
                    pipelineIndex >= 0 -> if {
                        pipelineIndex -> isStreamTerminalRole(interpolationArgumentValueIndex, context)
                            -> if {
                                context.streamPlan.pipelines[pipelineIndex] => pipeline
                                context -> emitterContext.streamStageInputValue(pipelineIndex,
                                pipeline.stageStart + pipeline.stageCount) => retainedValue
                                retainedValue >= 0 -> if {
                                    retainedValue -> producerValueIndex(context, state) => interpolationTextIndex!
                                }
                            }
                    }
                }
                interpolationTextIndex! >= 0 and context.ir[interpolationTextIndex!].kind == 2
                    -> if {
                        false => interpolationTextSeen!
                        0 => seenTextIndex!
                        seenTextIndex! < (interpolationTextIndices! -> len)
                            -> while {
                                interpolationTextIndices![seenTextIndex!] == interpolationTextIndex!
                                    -> if { true => interpolationTextSeen! }
                                seenTextIndex! + 1 => seenTextIndex!
                            }
                        not interpolationTextSeen! -> if {
                            interpolationTextIndices! -> push(interpolationTextIndex!)
                            context.ir[interpolationTextIndex!] => interpolationText
                            interpolationText -> sourceInterpolations(context, state) => interpolationNodes
                            0 => interpolationNodeIndex!
                            interpolationNodeIndex! < (interpolationNodes -> len)
                                -> while {
                                    interpolationNodes[interpolationNodeIndex!] => interpolationNode
                                    interpolationNode.sourceToken == interpolationText.payloadToken
                                        -> if {
                                            not state.frozenDeferredTextCaptureLeaves[interpolationTextIndex!]
                                                -> if {
                                                    callIndex! -> emitInterpolationFixedAllocas(
                                                    interpolationNodeIndex!, interpolationNodes, interpolationText.sourceModule,
                                                    ownerIndex, callIndex!, context, state)
                                                }
                                            callIndex! -> emitInterpolationCallReferenceArgumentAllocas(
                                            interpolationNodeIndex!,
                                            interpolationNodes,
                                            interpolationText.sourceModule,
                                            ownerIndex,
                                            callIndex!,
                                            context,
                                            state)
                                        }
                                    interpolationNodeIndex! + 1 => interpolationNodeIndex!
                                }
                        }
                    }
                materializedInterpolationSource -> if {
                    -1 => interpolationArgumentIndex!
                } else { context.ir[interpolationArgumentIndex!].nextOperand => interpolationArgumentIndex! }
            }
        }
        callIndex! -> emitFormattingCallAllocas(ownerIndex, context, state)
        call.kind == 6
            and (call.opcode == -207 or call.opcode == -209)
            and call.operand1 >= 0
            and (call.operand1 < startIndex or call.operand1 >= endIndex)
            -> if {
                ownerIndex -> emitHoistedReferenceArgumentAllocas(call.operand1, call.operand1 + 1, context, state)
            }
        callIndex! + 1 => callIndex!
    }
}
emitReferenceArgumentValues argumentIndex: Int, callIndex: Int, ownerIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    argumentIndex >= 0
        and ((callIndex -> callTargetParameter(ordinal, context, state)) >= 0
        or (not (callIndex -> callHasResolvedFunctionTarget(context, state))
        and (context.ir[argumentIndex].parent == callIndex or argumentIndex == context.ir[callIndex].operand0)))
        -> if {
            context.ir[argumentIndex] => callArgument
            argumentIndex -> aggregateValueIndex(context, state) => referenceArgumentIndex
            context.ir[referenceArgumentIndex] => referenceArgument
            callIndex -> callTargetParameter(ordinal, context, state) => referenceParameterIndex
            referenceParameterIndex >= 0 -> if {
                context.ir[referenceParameterIndex] => referenceParameter
                referenceParameter.typeId >= 0 and context.types[referenceParameter.typeId].kind == 8 and not (callArgument.typeId >= 0 and context.types[callArgument.typeId].kind == 8)
                    -> if {
                        context.types[referenceParameter.typeId].first => referenceOwnerType
                        referenceArgumentIndex -> referencePlaceRootBindingForEmission(ownerIndex, context, state) => referenceRootBinding
                        referenceArgumentIndex -> referencePlaceAddressDepth(context, state) => referenceProjectionDepth
                        referenceRootBinding -> referenceRootHasAddress(ownerIndex, context, state) => referenceRootAddressable
                        (not referenceRootAddressable
                            and referenceProjectionDepth > 0
                            and (context.ir[referenceArgumentIndex].kind == 13
                            or (context.ir[referenceArgumentIndex].kind == 15
                            and context.ir[referenceArgumentIndex].operand0 >= 0
                            and context.ir[context.ir[referenceArgumentIndex].operand0].kind == 13))) => referenceNeedsTemporaryRoot
                        -1 => emittedReferenceProjectionDepth!
                        referenceNeedsTemporaryRoot
                            -> if {
                                referenceRootBinding -> referenceRootStorageType(context) => referenceStorageType
                                "  store " -> print
                                referenceStorageType -> writeAggregateFieldTypeId(context, state)
                                " " -> print
                                referenceRootBinding -> writeReferenceRootValue(ownerIndex, context, state)
                                ", ptr %callref$(callIndex)_arg$(ordinal), align " -> print
                                referenceStorageType -> runtimeAggregateStorageAlignment(context) -> writeDecimalLine
                            }
                        referenceRootAddressable or referenceProjectionDepth > 0
                            -> if {
                                referenceArgumentIndex -> emitMutableReferencePlace(referenceRootBinding, callIndex, ordinal, ownerIndex, -1, referenceNeedsTemporaryRoot, context, state) => emittedReferenceProjectionDepth!
                            } else {
                                context.types[referenceOwnerType].kind == 12 => boundedReferenceValue
                                boundedReferenceValue -> if {
                                    "callref$(callIndex)_arg$(ordinal)_bounded" -> emitBoundedArrayValue(referenceArgumentIndex, ownerIndex, referenceOwnerType, context, state)
                                }
                                "  store " -> print
                                referenceOwnerType -> writeValueAbiTypeId(context, state)
                                " " -> print
                                boundedReferenceValue -> if { "%callref$(callIndex)_arg$(ordinal)_bounded" -> print } else {
                                    referenceArgumentIndex -> mutableBorrowParameterOrdinal(ownerIndex, context, state) => liveReferenceParameterOrdinal
                                    liveReferenceParameterOrdinal >= 0 -> if {
                                        "%v$(referenceArgumentIndex)" -> print
                                    } else {
                                        referenceArgumentIndex -> writeValue(ownerIndex, context, state)
                                    }
                                }
                                ", ptr %callref" -> print
                                callIndex -> writeDecimal
                                "_arg" -> print
                                ordinal -> writeDecimal
                                ", align " -> print
                                referenceOwnerType -> runtimeAggregateStorageAlignment(context) -> writeDecimalLine
                            }
                        "  %callref$(callIndex)_arg$(ordinal)_address = getelementptr i8, ptr " -> print
                        emittedReferenceProjectionDepth! > 0 -> if {
                            "%callref$(callIndex)_arg$(ordinal)_place$(emittedReferenceProjectionDepth! - 1)" -> print
                        } else {
                            referenceRootAddressable -> if {
                                referenceRootBinding -> writeReferenceRootAddress(ownerIndex, context, state)
                            } else {
                                "%callref$(callIndex)_arg$(ordinal)" -> print
                            }
                        }
                        ", i64 0" -> println
                    }
            }
            context.ir[argumentIndex].nextOperand -> emitReferenceArgumentValues(callIndex, ownerIndex, ordinal + 1, context, state)
        }
}
emitWhileReferenceArgumentValues argumentIndex: Int, callIndex: Int, whileIndex: Int, ownerIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    argumentIndex >= 0
        and ((callIndex -> callTargetParameter(ordinal, context, state)) >= 0
        or (not (callIndex -> callHasResolvedFunctionTarget(context, state))
        and (context.ir[argumentIndex].parent == callIndex or argumentIndex == context.ir[callIndex].operand0)))
        -> if {
            context.ir[argumentIndex] => callArgument
            argumentIndex -> aggregateValueIndex(context, state) => referenceArgumentIndex
            context.ir[referenceArgumentIndex] => referenceArgument
            callIndex -> callTargetParameter(ordinal, context, state) => referenceParameterIndex
            referenceParameterIndex >= 0 -> if {
                context.ir[referenceParameterIndex] => referenceParameter
                referenceParameter.typeId >= 0 and context.types[referenceParameter.typeId].kind == 8 and not (callArgument.typeId >= 0 and context.types[callArgument.typeId].kind == 8)
                    -> if {
                        context.types[referenceParameter.typeId].first => referenceOwnerType
                        referenceArgumentIndex -> referencePlaceRootBindingForEmission(ownerIndex, context, state) => referenceRootBinding
                        referenceArgumentIndex -> referencePlaceAddressDepth(context, state) => referenceProjectionDepth
                        referenceRootBinding -> referenceRootHasAddress(ownerIndex, context, state) => referenceRootAddressable
                        (not referenceRootAddressable
                            and referenceProjectionDepth > 0
                            and (context.ir[referenceArgumentIndex].kind == 13
                            or (context.ir[referenceArgumentIndex].kind == 15
                            and context.ir[referenceArgumentIndex].operand0 >= 0
                            and context.ir[context.ir[referenceArgumentIndex].operand0].kind == 13))) => referenceNeedsTemporaryRoot
                        -1 => emittedReferenceProjectionDepth!
                        referenceNeedsTemporaryRoot
                            -> if {
                                referenceRootBinding -> referenceRootStorageType(context) => referenceStorageType
                                "  store " -> print
                                referenceStorageType -> writeAggregateFieldTypeId(context, state)
                                " " -> print
                                referenceRootBinding -> writeReferenceRootValue(ownerIndex, context, state)
                                ", ptr %callref$(callIndex)_arg$(ordinal), align " -> print
                                referenceStorageType -> runtimeAggregateStorageAlignment(context) -> writeDecimalLine
                            }
                        referenceRootAddressable or referenceProjectionDepth > 0
                            -> if {
                                referenceArgumentIndex -> emitMutableReferencePlace(referenceRootBinding, callIndex, ordinal, ownerIndex, whileIndex, referenceNeedsTemporaryRoot, context, state) => emittedReferenceProjectionDepth!
                            } else {
                                referenceArgumentIndex -> mutableBorrowParameterOrdinal(ownerIndex, context, state) => liveWhileReferenceOrdinal
                                liveWhileReferenceOrdinal >= 0 -> if {
                                    "  %callref$(callIndex)_arg$(ordinal)_live_ptr = load ptr, ptr " -> print
                                    liveWhileReferenceOrdinal == 0 -> if { "%arg_mut_ptr_addr" -> print } else { "%arg$(liveWhileReferenceOrdinal)_mut_ptr_addr" -> print }
                                    ", align 8" -> println
                                    "  %callref$(callIndex)_arg$(ordinal)_live_len = load i64, ptr " -> print
                                    liveWhileReferenceOrdinal == 0 -> if { "%arg_mut_len_addr" -> print } else { "%arg$(liveWhileReferenceOrdinal)_mut_len_addr" -> print }
                                    ", align 8" -> println
                                    "  %callref$(callIndex)_arg$(ordinal)_live_capacity = load i64, ptr " -> print
                                    liveWhileReferenceOrdinal == 0 -> if { "%arg_mut_capacity_addr" -> print } else { "%arg$(liveWhileReferenceOrdinal)_mut_capacity_addr" -> print }
                                    ", align 8" -> println
                                    "  %callref$(callIndex)_arg$(ordinal)_live0 = insertvalue " -> print
                                    referenceOwnerType -> writeAggregateFieldTypeId(context, state)
                                    " poison, ptr %callref$(callIndex)_arg$(ordinal)_live_ptr, 0" -> println
                                    "  %callref$(callIndex)_arg$(ordinal)_live1 = insertvalue " -> print
                                    referenceOwnerType -> writeAggregateFieldTypeId(context, state)
                                    " %callref$(callIndex)_arg$(ordinal)_live0, i64 %callref$(callIndex)_arg$(ordinal)_live_len, 1" -> println
                                    "  %callref$(callIndex)_arg$(ordinal)_live = insertvalue " -> print
                                    referenceOwnerType -> writeAggregateFieldTypeId(context, state)
                                    " %callref$(callIndex)_arg$(ordinal)_live1, i64 %callref$(callIndex)_arg$(ordinal)_live_capacity, 2" -> println
                                }
                                context.types[referenceOwnerType].kind == 12 => boundedWhileReferenceValue
                                boundedWhileReferenceValue -> if {
                                    "  %callref$(callIndex)_arg$(ordinal)_handle = freeze %sollang.array.i32 " -> print
                                    liveWhileReferenceOrdinal >= 0 -> if { "%callref$(callIndex)_arg$(ordinal)_live" -> print } else {
                                        WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: referenceArgumentIndex } -> writeWhileValue(context, state)
                                    }
                                    "" -> println
                                    "callref$(callIndex)_arg$(ordinal)_bounded" -> emitBoundedArrayValueFromHandle("%callref$(callIndex)_arg$(ordinal)_handle", referenceOwnerType, context, state)
                                }
                                "  store " -> print
                                referenceOwnerType -> writeValueAbiTypeId(context, state)
                                " " -> print
                                boundedWhileReferenceValue -> if { "%callref$(callIndex)_arg$(ordinal)_bounded" -> print } else {
                                    liveWhileReferenceOrdinal >= 0 -> if {
                                        "%callref$(callIndex)_arg$(ordinal)_live" -> print
                                    } else {
                                        WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: referenceArgumentIndex } -> writeWhileValue(context, state)
                                    }
                                }
                                ", ptr %callref$(callIndex)_arg$(ordinal), align " -> print
                                referenceOwnerType -> runtimeAggregateStorageAlignment(context) -> writeDecimalLine
                            }
                        "  %callref$(callIndex)_arg$(ordinal)_address = getelementptr i8, ptr " -> print
                        emittedReferenceProjectionDepth! > 0 -> if {
                            "%callref$(callIndex)_arg$(ordinal)_place$(emittedReferenceProjectionDepth! - 1)" -> print
                        } else {
                            referenceRootAddressable -> if {
                                referenceRootBinding -> writeReferenceRootAddress(ownerIndex, context, state)
                            } else {
                                "%callref$(callIndex)_arg$(ordinal)" -> print
                            }
                        }
                        ", i64 0" -> println
                    }
            }
            context.ir[argumentIndex].nextOperand -> emitWhileReferenceArgumentValues(callIndex, whileIndex, ownerIndex, ordinal + 1, context, state)
        }
}
emitMutableBorrowPlace label: Text, mutableParameterIndex: Int, mutableValueIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    mutableValueIndex -> referencePlaceRootBindingForEmission(ownerIndex, context, state) => mutableRootBinding
    mutableValueIndex -> mutableBorrowParameterOrdinal(ownerIndex, context, state) => forwardedOrdinal
    mutableRootBinding -> mutableBorrowParameterOrdinal(ownerIndex, context, state) => forwardedRootOrdinal
    (mutableValueIndex >= 0
        and context.ir[mutableValueIndex].kind == 13
        and context.ir[mutableValueIndex].operand0 >= 0
        and context.ir[mutableValueIndex].symbol >= 0
        and mutableRootBinding >= 0
        and (context.ir[context.ir[mutableValueIndex].operand0] -> isNominalStructType)) => projectedStructMember
    false => mutableBorrowUsesStructPointer!
    mutableParameterIndex >= 0 -> if {
        context.ir[mutableParameterIndex] -> mutableBorrowUsesStructPointer(context)
            => mutableBorrowUsesStructPointer!
    }
    mutableBorrowUsesStructPointer! -> if {
        projectedStructMember -> if {
            -1 => projectedFixedTypeId!
            mutableParameterIndex >= 0 -> if {
                context.ir[mutableParameterIndex] -> effectiveTypeId(context, state) => projectedFixedTypeId!
            }
            projectedFixedTypeId! >= 0 and context.types[projectedFixedTypeId!].kind == 4 => projectedFixedMember
            context.ir[context.ir[mutableValueIndex].operand0].typeId => mutableMemberOwnerType!
            mutableMemberOwnerType! >= 0 and context.types[mutableMemberOwnerType!].kind == 8
                -> if {
                    context.types[mutableMemberOwnerType!].first => mutableMemberOwnerType!
                }
            "  %$(label)" -> print
            projectedFixedMember -> if { "_field" -> print }
            " = getelementptr inbounds " -> print
            mutableMemberOwnerType! -> writeSemanticTypeId(context, state)
            ", ptr " -> print
            forwardedRootOrdinal >= 0 -> if {
                forwardedRootOrdinal -> writeMutableStructParameterPointer
            } else {
                "%slot$(mutableRootBinding)" -> print
            }
            ", i32 0, i32 " -> print
            context.ir[mutableValueIndex].symbol -> writeDecimalLine
            projectedFixedMember -> if {
                "  %$(label)_carrier = load %sollang.int_slice, ptr %$(label)_field, align 8" -> println
                "  %$(label) = extractvalue %sollang.int_slice %$(label)_carrier, 0" -> println
            }
        } else {
            context.ir[mutableParameterIndex] -> effectiveTypeId(context, state) => mutableTargetTypeId
            mutableTargetTypeId >= 0
                and context.types[mutableTargetTypeId].kind == 4
                and context.types[mutableTargetTypeId].length >= 0
                and forwardedOrdinal < 0 -> if {
                    mutableRootBinding -> mutableBindingRoot(context, state) => mutableRoot
                    "  %$(label)_fixed = load %sollang.int_slice, ptr %slot$(mutableRoot), align " -> print
                    context.ir[mutableRoot] -> storageAlign(context, state) -> writeDecimalLine
                    "  %$(label) = extractvalue %sollang.int_slice %$(label)_fixed, 0" -> println
                } else {
                    "  %$(label) = getelementptr i8, ptr " -> print
                    forwardedOrdinal >= 0 -> if {
                        forwardedOrdinal -> writeMutableStructParameterPointer
                    } else {
                        mutableRootBinding -> mutableBindingRoot(context, state) => mutableRoot
                        "%slot$(mutableRoot)" -> print
                    }
                    ", i64 0" -> println
                }
        }
    } else {
        projectedStructMember -> if {
            context.ir[context.ir[mutableValueIndex].operand0].typeId => mutableMemberOwnerType!
            mutableMemberOwnerType! >= 0 and context.types[mutableMemberOwnerType!].kind == 8
                -> if {
                    context.types[mutableMemberOwnerType!].first => mutableMemberOwnerType!
                }
            "  %$(label)_storage = getelementptr inbounds " -> print
            mutableMemberOwnerType! -> writeSemanticTypeId(context, state)
            ", ptr " -> print
            forwardedRootOrdinal >= 0 -> if {
                forwardedRootOrdinal -> writeMutableStructParameterPointer
            } else {
                "%slot$(mutableRootBinding)" -> print
            }
            ", i32 0, i32 " -> print
            context.ir[mutableValueIndex].symbol -> writeDecimalLine
            context.ir[mutableValueIndex] -> boundedArrayValueTypeId(context, state) => boundedMutableFieldTypeId
            boundedMutableFieldTypeId >= 0 -> if {
                "  %$(label)_len = getelementptr inbounds " -> print
                boundedMutableFieldTypeId -> writeValueAbiTypeId(context, state)
                ", ptr %$(label)_storage, i32 0, i32 0" -> println
                "  %$(label)_data = getelementptr inbounds " -> print
                boundedMutableFieldTypeId -> writeValueAbiTypeId(context, state)
                ", ptr %$(label)_storage, i32 0, i32 1, i64 0" -> println
                "  %$(label)_ptr = alloca ptr, align 8" -> println
                "  store ptr %$(label)_data, ptr %$(label)_ptr, align 8" -> println
                "  %$(label)_capacity = alloca i64, align 8" -> println
                "  store i64 $(context.types[boundedMutableFieldTypeId].length), ptr %$(label)_capacity, align 8" -> println
            } else {
                "  %$(label)_ptr = getelementptr inbounds " -> print
                context.ir[mutableValueIndex] -> writeIrType(context, state)
                ", ptr %$(label)_storage, i32 0, i32 0" -> println
                "  %$(label)_len = getelementptr inbounds " -> print
                context.ir[mutableValueIndex] -> writeIrType(context, state)
                ", ptr %$(label)_storage, i32 0, i32 1" -> println
                "  %$(label)_capacity = getelementptr inbounds " -> print
                context.ir[mutableValueIndex] -> writeIrType(context, state)
                ", ptr %$(label)_storage, i32 0, i32 2" -> println
            }
            "  %$(label)_0 = insertvalue %sollang.mutable_container poison, ptr %$(label)_ptr, 0" -> println
            "  %$(label)_1 = insertvalue %sollang.mutable_container %$(label)_0, ptr %$(label)_len, 1" -> println
            "  %$(label) = insertvalue %sollang.mutable_container %$(label)_1, ptr %$(label)_capacity, 2" -> println
        } else {
            forwardedOrdinal >= 0 -> if {
                forwardedOrdinal == 0 -> if {
                    "  %$(label)_0 = insertvalue %sollang.mutable_container poison, ptr %arg_mut_ptr_addr, 0" -> println
                    "  %$(label)_1 = insertvalue %sollang.mutable_container %$(label)_0, ptr %arg_mut_len_addr, 1" -> println
                    "  %$(label) = insertvalue %sollang.mutable_container %$(label)_1, ptr %arg_mut_capacity_addr, 2" -> println
                } else {
                    "  %$(label)_0 = insertvalue %sollang.mutable_container poison, ptr %arg$(forwardedOrdinal)_mut_ptr_addr, 0" -> println
                    "  %$(label)_1 = insertvalue %sollang.mutable_container %$(label)_0, ptr %arg$(forwardedOrdinal)_mut_len_addr, 1" -> println
                    "  %$(label) = insertvalue %sollang.mutable_container %$(label)_1, ptr %arg$(forwardedOrdinal)_mut_capacity_addr, 2" -> println
                }
            } else {
                mutableRootBinding -> mutableBindingRoot(context, state) => mutableRoot
                "  %$(label)_ptr = getelementptr inbounds " -> print
                context.ir[mutableRoot] -> writeIrType(context, state)
                ", ptr %slot$(mutableRoot), i32 0, i32 0" -> println
                "  %$(label)_len = getelementptr inbounds " -> print
                context.ir[mutableRoot] -> writeIrType(context, state)
                ", ptr %slot$(mutableRoot), i32 0, i32 1" -> println
                "  %$(label)_capacity = getelementptr inbounds " -> print
                context.ir[mutableRoot] -> writeIrType(context, state)
                ", ptr %slot$(mutableRoot), i32 0, i32 2" -> println
                "  %$(label)_0 = insertvalue %sollang.mutable_container poison, ptr %$(label)_ptr, 0" -> println
                "  %$(label)_1 = insertvalue %sollang.mutable_container %$(label)_0, ptr %$(label)_len, 1" -> println
                "  %$(label) = insertvalue %sollang.mutable_container %$(label)_1, ptr %$(label)_capacity, 2" -> println
            }
        }
    }
}
emitMutableBorrowArgumentValues argumentIndex: Int, callIndex: Int, ownerIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    argumentIndex >= 0
        and ((callIndex -> callTargetParameter(ordinal, context, state)) >= 0
        or ((context.ir[callIndex].opcode == -272 or context.ir[callIndex].opcode == -287 or context.ir[callIndex].opcode == -290 or context.ir[callIndex].opcode == -291 or context.ir[callIndex].opcode == -292) and ordinal == 1)
        or (not (callIndex -> callHasResolvedFunctionTarget(context, state))
        and (context.ir[argumentIndex].parent == callIndex or argumentIndex == context.ir[callIndex].operand0)))
        -> if {
            callIndex -> callTargetParameter(ordinal, context, state) => mutableParameterIndex
            ((context.ir[callIndex].opcode == -272 or context.ir[callIndex].opcode == -287 or context.ir[callIndex].opcode == -290 or context.ir[callIndex].opcode == -291 or context.ir[callIndex].opcode == -292) and ordinal == 1) => intrinsicMutableBorrow
            (intrinsicMutableBorrow
                or (mutableParameterIndex >= 0
                and context.ir[mutableParameterIndex].flags / 2 % 2 == 1))
                and not (context.ir[callIndex] -> targetsNativeFunction(context, state))
                -> if {
                    argumentIndex -> aggregateValueIndex(context, state) => mutableValueIndex
                    "callmut$(callIndex)_arg$(ordinal)" -> emitMutableBorrowPlace(mutableParameterIndex, mutableValueIndex, ownerIndex, context, state)
                }
            context.ir[argumentIndex].nextOperand -> emitMutableBorrowArgumentValues(callIndex, ownerIndex, ordinal + 1, context, state)
        }
}
emitCurrentMutableParameterValueAt prefix: Text, valueIndex: Int, parameterOrdinal: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[valueIndex] => value
    context -> parameterIndexAtOrdinal(ownerIndex, parameterOrdinal) => parameterIndex
    parameterIndex >= 0 and (context.ir[parameterIndex] -> mutableBorrowUsesStructPointer(context))
        -> if {
            context.ir[parameterIndex] -> effectiveTypeId(context, state) => mutableParameterTypeId
            mutableParameterTypeId >= 0
                and context.types[mutableParameterTypeId].kind == 4
                and context.types[mutableParameterTypeId].length >= 0
                -> if {
                    "  %$(prefix) = insertvalue %sollang.int_slice " -> print
                    parameterOrdinal == 0 -> if { "%arg" -> print } else { "%arg$(parameterOrdinal)" -> print }
                    ", i64 $(context.types[mutableParameterTypeId].length), 1" -> println
                } else {
                    "  %$(prefix) = load " -> print
                    value -> writeIrType(context, state)
                    ", ptr " -> print
                    parameterOrdinal -> writeMutableStructParameterPointer
                    ", align " -> print
                    value -> storageAlign(context, state) -> writeDecimalLine
                }
        } else {
            "  %$(prefix)_current_ptr = load ptr, ptr " -> print
            parameterOrdinal == 0 -> if { "%arg_mut_ptr_addr" -> print } else { "%arg$(parameterOrdinal)_mut_ptr_addr" -> print }
            ", align 8" -> println
            "  %$(prefix)_current_len = load i64, ptr " -> print
            parameterOrdinal == 0 -> if { "%arg_mut_len_addr" -> print } else { "%arg$(parameterOrdinal)_mut_len_addr" -> print }
            ", align 8" -> println
            "  %$(prefix)_current_capacity = load i64, ptr " -> print
            parameterOrdinal == 0 -> if { "%arg_mut_capacity_addr" -> print } else { "%arg$(parameterOrdinal)_mut_capacity_addr" -> print }
            ", align 8" -> println
            "  %$(prefix)_current0 = insertvalue " -> print
            value -> writeIrType(context, state)
            " poison, ptr %$(prefix)_current_ptr, 0" -> println
            "  %$(prefix)_current1 = insertvalue " -> print
            value -> writeIrType(context, state)
            " %$(prefix)_current0, i64 %$(prefix)_current_len, 1" -> println
            "  %$(prefix) = insertvalue " -> print
            value -> writeIrType(context, state)
            " %$(prefix)_current1, i64 %$(prefix)_current_capacity, 2" -> println
        }
}

emitCurrentMutableParameterValue valueIndex: Int, parameterOrdinal: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    Arena(0) => prefixStorage!
    "v$(valueIndex)" -> materialize(prefixStorage!) => prefix
    prefix -> emitCurrentMutableParameterValueAt(valueIndex, parameterOrdinal, ownerIndex, context, state)
}
interpolatedTextRoots textIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> [Int; ~] {
    [Int; ~] => roots!
    context.ir[textIndex] => textNode
    textNode -> sourceInterpolations(context, state) => interpolations
    0 => search!
    search! < (interpolations -> len) -> while {
        interpolations[search!] => currentInterpolation
        currentInterpolation.sourceToken == textNode.payloadToken and currentInterpolation.parent < 0
            -> if {
                roots! -> push(search!)
            }
        search! + 1 => search!
    }
    roots!
}
transientTextOperandSource argumentIndex: Int, callIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.ir[callIndex] => consumer
    consumer.kind == 8 and (consumer.opcode == grammar.tokenIdEqualEqual() or consumer.opcode == grammar.tokenIdBangEqual())
        and (context.ir[argumentIndex] -> isTextType) => comparison
    -1 => parameterIndex!
    not comparison -> if { callIndex -> callTargetParameter(ordinal, context, state) => parameterIndex! }
    -1 => textIndex!
    comparison or (parameterIndex! >= 0 and (context.ir[parameterIndex!] -> isTextType))
        -> if {
            argumentIndex -> aggregateValueIndex(context, state) => argumentValueIndex
            argumentValueIndex -> producerValueIndex(context, state) => producedValueIndex
            producedValueIndex -> isDeferredTextChoice(context, state)
                -> if { producedValueIndex => textIndex! }
            producedValueIndex >= 0 and context.ir[producedValueIndex].kind == 2
                -> if {
                    producedValueIndex -> interpolatedTextRoots(context, state) => roots
                    (roots -> len) > 0 -> if { producedValueIndex => textIndex! }
                }
        }
    textIndex!
}
emitTransientTextOperand argumentIndex: Int, callIndex: Int, ownerIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {    argumentIndex -> transientTextOperandSource(callIndex, ordinal, context, state) => textIndex
    textIndex -> isDeferredTextChoice(context, state)
        -> if {
            textIndex -> emitDeferredTextTransientChoice(callIndex, ownerIndex, ordinal, context, state)
            return
        }
    textIndex -> emitTransientTextLiteral(callIndex, ownerIndex, "calltext$(callIndex)_arg$(ordinal)", -1, context, state)
}

emitTransientTextLiteral textIndex: Int, callIndex: Int, ownerIndex: Int, prefix: Text, captureIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    textIndex >= 0 -> if {
        context.ir[textIndex] => textNode
        textNode -> sourceInterpolations(context, state) => interpolations
        textIndex -> interpolatedTextRoots(context, state) => roots
        (captureIndex >= 0 -> if { textIndex } else { callIndex }) => lexicalIndex
        Int(roots -> len) => rootCount
        UIntSize(0) => staticLength!
        UIntSize(0) => suffixStart!
        0 => rootOrdinal!
        rootOrdinal! < rootCount -> while {
            roots[rootOrdinal!] => interpolationIndex
            interpolations[interpolationIndex] => interpolationRoot
            (captureIndex < 0 -> if {
                interpolationIndex -> interpolationReferenceValueTypeId(interpolations, textNode.sourceModule, ownerIndex, callIndex, context, state)
            } else { -1 }) => transientReferenceValueTypeId
            captureIndex < 0 -> if {
                interpolations -> interpolationEmissionOrder(textNode.payloadToken, interpolationRoot.segment) => expressionOrder
                0 => expressionOrderIndex!
                expressionOrderIndex! < (expressionOrder -> len)
                    -> while {
                        expressionOrder[expressionOrderIndex!] => expressionNodeIndex
                        interpolations[expressionNodeIndex] => expressionNode
                        expressionNodeIndex -> interpolationHasLogicalAncestor(interpolations) => insideLogical
                        not insideLogical -> if {
                            expressionNode.kind == 3 and (expressionNode.opcode == -24 or expressionNode.opcode == -25)
                                -> if {
                                    callIndex -> emitInterpolationSubtree(expressionNodeIndex, interpolations, textNode.sourceModule, ownerIndex, callIndex, true, context, state)
                                } else {
                                    callIndex -> emitInterpolationIntrinsic(expressionNodeIndex, interpolations, textNode.sourceModule, ownerIndex, callIndex, true, context, state)
                                    callIndex -> emitInterpolationOperation(expressionNodeIndex, interpolations, textNode.sourceModule, ownerIndex, callIndex, context, state)
                                }
                        }
                        expressionOrderIndex! + 1 => expressionOrderIndex!
                    }
                transientReferenceValueTypeId >= 0 -> if {
                    callIndex -> emitInterpolationReferenceValue(interpolationIndex, transientReferenceValueTypeId, interpolations, textNode.sourceModule, ownerIndex, callIndex, context, state)
                }
            }
            (captureIndex >= 0 -> if {
                interpolationIndex -> deferredTextCaptureType(interpolations, textNode.sourceModule, ownerIndex, textIndex, context, state)
            } else {
                interpolationIndex -> interpolationNodeTypeId(interpolations, textNode.sourceModule, ownerIndex, callIndex, context, state)
            }) => transientRootTypeId
            captureIndex >= 0 -> if {
                "  %$(prefix)_root$(rootOrdinal!)_value = load " -> print
                transientRootTypeId -> writeSemanticTypeId(context, state)
                ", ptr %deferred_text$(captureIndex)_root$(interpolationIndex)_slot, align $(context.typeAligns[transientRootTypeId])" -> println
            }
            interpolationRoot.typeSymbol == 23 => transientRootIsBool!
            transientRootTypeId >= 0 and transientRootTypeId < (context.types -> len)
                -> if {
                    context.types[transientRootTypeId].kind == 1
                        and context.types[transientRootTypeId].origin == 1
                        and context.types[transientRootTypeId].symbol == 23
                        -> if { true => transientRootIsBool! }
                }
            transientReferenceValueTypeId >= 0 and context.types[transientReferenceValueTypeId].symbol == 23
                -> if { true => transientRootIsBool! }
            interpolationIndex -> interpolationNodeIntegerWidth(interpolations, textNode.sourceModule, ownerIndex, lexicalIndex, context, state) => integerWidth
            transientRootIsBool!
                -> if {
                    captureIndex >= 0 -> if {
                        "$(prefix)_root$(rootOrdinal!)" -> emitDeferredBoolTextRootBytes
                    } else {
                        "$(prefix)_root$(rootOrdinal!)"
                            -> emitDeferredBoolTextRoot(callIndex, interpolationIndex, interpolations, textNode.sourceModule, ownerIndex, callIndex, context, state)
                    }
                } else {
                    integerWidth > 0 -> if {
                        integerWidth < 64 -> if {
                            "  %$(prefix)_root$(rootOrdinal!)_integer = " -> print
                            interpolationIndex -> interpolationNodeSigned(interpolations, textNode.sourceModule, ownerIndex, lexicalIndex, context, state)
                                -> if { "sext" -> print } else { "zext" -> print }
                            " i$(integerWidth) " -> print
                            transientReferenceValueTypeId >= 0 -> if {
                                "%v$(callIndex)_expression$(interpolationIndex)_reference_value" -> print
                            } else {
                                captureIndex >= 0 -> if { "%$(prefix)_root$(rootOrdinal!)_value" -> print } else {
                                    callIndex -> writeInterpolationValue(interpolationIndex, interpolations, textNode.sourceModule, ownerIndex, callIndex, context, state)
                                }
                            }
                            " to i64" -> println
                        }
                        "  %$(prefix)_root$(rootOrdinal!)_length = call i64 @" -> print
                        interpolationIndex -> interpolationNodeSigned(interpolations, textNode.sourceModule, ownerIndex, lexicalIndex, context, state)
                            -> if { "sollang_format_i64" -> print } else { "sollang_format_u64" -> print }
                        "(ptr %$(prefix)_root$(rootOrdinal!)_buffer, i64 " -> print
                        integerWidth < 64 -> if { "%$(prefix)_root$(rootOrdinal!)_integer" -> print } else {
                            transientReferenceValueTypeId >= 0 -> if {
                                "%v$(callIndex)_expression$(interpolationIndex)_reference_value" -> print
                            } else {
                                captureIndex >= 0 -> if { "%$(prefix)_root$(rootOrdinal!)_value" -> print } else {
                                    callIndex -> writeInterpolationValue(interpolationIndex, interpolations, textNode.sourceModule, ownerIndex, callIndex, context, state)
                                }
                            }
                        }
                        ")" -> println
                        "  %$(prefix)_root$(rootOrdinal!)_ptr = getelementptr [21 x i8], ptr %$(prefix)_root$(rootOrdinal!)_buffer, i64 0, i64 0" -> println
                    } else {
                        "  %$(prefix)_root$(rootOrdinal!)_ptr = extractvalue %sollang.text " -> print
                        transientReferenceValueTypeId >= 0 -> if {
                            "%v$(callIndex)_expression$(interpolationIndex)_reference_value" -> print
                        } else {
                            captureIndex >= 0 -> if { "%$(prefix)_root$(rootOrdinal!)_value" -> print } else {
                                callIndex -> writeInterpolationValue(interpolationIndex, interpolations, textNode.sourceModule, ownerIndex, callIndex, context, state)
                            }
                        }
                        ", 0" -> println
                        "  %$(prefix)_root$(rootOrdinal!)_length = extractvalue %sollang.text " -> print
                        transientReferenceValueTypeId >= 0 -> if {
                            "%v$(callIndex)_expression$(interpolationIndex)_reference_value" -> print
                        } else {
                            captureIndex >= 0 -> if { "%$(prefix)_root$(rootOrdinal!)_value" -> print } else {
                                callIndex -> writeInterpolationValue(interpolationIndex, interpolations, textNode.sourceModule, ownerIndex, callIndex, context, state)
                            }
                        }
                        ", 1" -> println
                    }
                }
            staticLength! + interpolationRoot.literalLength => staticLength!
            interpolationRoot.expressionStart + interpolationRoot.expressionLength + 1 => suffixStart!
            rootOrdinal! + 1 => rootOrdinal!
        }
        textNode -> sourceToken(context, state) => textToken
        TextLiteralRequest { sourceModule: textNode.sourceModule, token: textToken } -> textLiteralLength(context, state) => rawLength
        staticLength! + rawLength - suffixStart! => staticLength!
        "  %$(prefix)_length0 = add i64 0, " -> print
        Int(staticLength!) -> writeDecimalLine
        0 => lengthOrdinal!
        lengthOrdinal! < rootCount -> while {
            "  %$(prefix)_length" -> print
            lengthOrdinal! + 1 -> writeDecimal
            " = add i64 %$(prefix)_length" -> print
            lengthOrdinal! -> writeDecimal
            ", %$(prefix)_root$(lengthOrdinal!)_length" -> println
            "  %$(prefix)_length$(lengthOrdinal! + 1)_ok = icmp uge i64 %$(prefix)_length$(lengthOrdinal! + 1), %$(prefix)_length$(lengthOrdinal!)" -> println
            "  br i1 %$(prefix)_length$(lengthOrdinal! + 1)_ok, label %$(prefix)_length$(lengthOrdinal! + 1)_ready, label %$(prefix)_length$(lengthOrdinal! + 1)_overflow" -> println
            "$(prefix)_length$(lengthOrdinal! + 1)_overflow:" -> println
            "  call void @llvm.trap()" -> println
            "  unreachable" -> println
            "$(prefix)_length$(lengthOrdinal! + 1)_ready:" -> println
            lengthOrdinal! + 1 => lengthOrdinal!
        }
        "  %$(prefix)_empty = icmp eq i64 %$(prefix)_length$(rootCount), 0" -> println
        "  %$(prefix)_allocation_length = select i1 %$(prefix)_empty, i64 1, i64 %$(prefix)_length$(rootCount)" -> println
        "  %$(prefix)_buffer = alloca i8, i64 %$(prefix)_allocation_length, align 1" -> println
        "  %$(prefix)_offset0 = add i64 0, 0" -> println
        0 => copyOrdinal!
        copyOrdinal! < rootCount -> while {
            roots[copyOrdinal!] => copyIndex
            interpolations[copyIndex] => copyRoot
            "  %$(prefix)_literal$(copyOrdinal!)_target = getelementptr i8, ptr %$(prefix)_buffer, i64 %$(prefix)_offset$(copyOrdinal! * 2)" -> println
            "  %$(prefix)_literal$(copyOrdinal!)_source = getelementptr i8, ptr @sollang_str_$(textIndex), i64 $(copyRoot.literalStart)" -> println
            "  call void @llvm.memcpy.p0.p0.i64(ptr %$(prefix)_literal$(copyOrdinal!)_target, ptr %$(prefix)_literal$(copyOrdinal!)_source, i64 $(copyRoot.literalLength), i1 false)" -> println
            "  %$(prefix)_offset$(copyOrdinal! * 2 + 1) = add i64 %$(prefix)_offset$(copyOrdinal! * 2), $(copyRoot.literalLength)" -> println
            "  %$(prefix)_root$(copyOrdinal!)_target = getelementptr i8, ptr %$(prefix)_buffer, i64 %$(prefix)_offset$(copyOrdinal! * 2 + 1)" -> println
            "  call void @llvm.memcpy.p0.p0.i64(ptr %$(prefix)_root$(copyOrdinal!)_target, ptr %$(prefix)_root$(copyOrdinal!)_ptr, i64 %$(prefix)_root$(copyOrdinal!)_length, i1 false)" -> println
            "  %$(prefix)_offset$(copyOrdinal! * 2 + 2) = add i64 %$(prefix)_offset$(copyOrdinal! * 2 + 1), %$(prefix)_root$(copyOrdinal!)_length" -> println
            copyOrdinal! + 1 => copyOrdinal!
        }
        rawLength - suffixStart! => suffixLength
        "  %$(prefix)_suffix_target = getelementptr i8, ptr %$(prefix)_buffer, i64 %$(prefix)_offset$(rootCount * 2)" -> println
        "  %$(prefix)_suffix_source = getelementptr i8, ptr @sollang_str_$(textIndex), i64 $(suffixStart!)" -> println
        "  call void @llvm.memcpy.p0.p0.i64(ptr %$(prefix)_suffix_target, ptr %$(prefix)_suffix_source, i64 $(suffixLength), i1 false)" -> println
        "  %$(prefix)_value0 = insertvalue %sollang.text poison, ptr %$(prefix)_buffer, 0" -> println
        "  %$(prefix) = insertvalue %sollang.text %$(prefix)_value0, i64 %$(prefix)_length$(rootCount), 1" -> println
    }
}

emitDeferredTextTransientChoice choiceIndex: Int, callIndex: Int, ownerIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    "calltext$(callIndex)_arg$(ordinal)" -> emitDeferredTextTransientChoiceNamed(choiceIndex, callIndex, ownerIndex, context, state)
}

emitDeferredTextTransientChoiceLeaf prefix: Text, leaf: Int, callIndex: Int, ownerIndex: Int, joinPrefix: Text, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    "$(prefix)_start:" -> println
    (context.ir[leaf].kind == 2 -> if { leaf -> interpolatedTextRoots(context, state) } else { [Int; ~] }) => roots
    (roots -> len) > 0 -> if {
        leaf -> emitTransientTextLiteral(callIndex, ownerIndex, prefix, leaf, context, state)
    } else {
        "  %$(prefix) = load %sollang.text, ptr %deferred_text$(leaf)_value_slot, align 8" -> println
    }
    "  br label %$(prefix)_done" -> println
    "$(prefix)_done:" -> println
    "  br label %$(joinPrefix)_end" -> println
    "$(prefix)_next:" -> println
}

emitDeferredTextTransientChoiceNamed prefix: Text, choiceIndex: Int, callIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    [Int; ~] => leaves!
    choiceIndex -> appendDeferredTextChoiceLeaves(leaves!, context, state)
    "  %$(prefix)_tag = load i64, ptr %deferred_text$(choiceIndex)_tag, align 8" -> println
    leaves! -> each leaf {
        "  %$(prefix)_is$(leaf) = icmp eq i64 %$(prefix)_tag, $(leaf)" -> println
        "  br i1 %$(prefix)_is$(leaf), label %$(prefix)_leaf$(leaf)_start, label %$(prefix)_leaf$(leaf)_next" -> println
        "$(prefix)_leaf$(leaf)" -> emitDeferredTextTransientChoiceLeaf(leaf, callIndex, ownerIndex, prefix, context, state)
    }
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "$(prefix)_end:" -> println
    "  %$(prefix) = phi %sollang.text " -> print
    0 => index!
    index! < (leaves! -> len) -> while {
        index! > 0 -> if { ", " -> print }
        leaves![index!] => leaf
        "[ %$(prefix)_leaf$(leaf), %$(prefix)_leaf$(leaf)_done ]" -> print
        index! + 1 => index!
    }
    "" -> println
}

emitDeferredTextComparisonOperands comparisonIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[comparisonIndex] => comparison
    comparison.operand0 -> producerValueIndex(context, state) => left
    left -> isDeferredTextChoice(context, state) -> if {
        left -> emitDeferredTextTransientChoice(comparisonIndex, ownerIndex, 0, context, state)
    }
    comparison.operand1 -> producerValueIndex(context, state) => right
    right -> isDeferredTextChoice(context, state)
        -> if {
            right -> emitDeferredTextTransientChoice(comparisonIndex, ownerIndex, 1, context, state)
        }
}

emitTransientTextArguments argumentIndex: Int, callIndex: Int, ownerIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    argumentIndex -> isEmittedTextArgument(callIndex, ordinal, context, state)
        -> if {
            argumentIndex -> emitTransientTextOperand(callIndex, ownerIndex, ordinal, context, state)
            context.ir[argumentIndex].nextOperand -> emitTransientTextArguments(callIndex, ownerIndex, ordinal + 1, context, state)
        }
}
isValueComparison node: typedIr.TypedIrNode -> Bool {
    node.kind == 8 and (node.opcode == grammar.tokenIdEqualEqual()
        or node.opcode == grammar.tokenIdBangEqual() or node.opcode == grammar.tokenIdLess()
        or node.opcode == grammar.tokenIdLessEqual() or node.opcode == grammar.tokenIdGreater()
        or node.opcode == grammar.tokenIdGreaterEqual())
}
comparisonReadTypeId valueIndex: Int, context: ref emitterContext.EmitContext -> Int {
    context.types -> typeIds.materializedReadTypeId(context.ir[valueIndex].typeId)
}
comparisonReadIsText valueIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    valueIndex -> comparisonReadTypeId(context) => readTypeId
    readTypeId >= 0 and readTypeId < (context.types -> len)
        and context.types[readTypeId].kind == 1 and context.types[readTypeId].origin == 1
        and context.types[readTypeId].symbol == 1
}
comparisonReadIsFloat valueIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    valueIndex -> comparisonReadTypeId(context) => readTypeId
    readTypeId >= 0 and readTypeId < (context.types -> len)
        and context.types[readTypeId].kind == 1 and context.types[readTypeId].origin == 1
        and context.types[readTypeId].symbol >= 19 and context.types[readTypeId].symbol <= 22
}
isComparisonReferenceName valueIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    context.ir[valueIndex] => value
    value.kind != 5 or (value -> referenceValueTypeId(context, state)) < 0
        or value.parent < 0 or value.parent >= (context.ir -> len)
        -> if { false -> return }
    context.ir[value.parent] -> isValueComparison
        -> if { true -> return }
    value.parent -> isSubjectWhenRangeCondition(context.ir[value.parent].parent, context)
}
emitComparisonReferenceNameRead valueIndex: Int, ownerIndex: Int, whileIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    valueIndex -> isComparisonReferenceName(context, state)
        -> unless { return }
    whileIndex < 0 and (valueIndex -> referenceParameterValueIsMaterialized(ownerIndex, context, state))
        -> if { return }
    valueIndex -> comparisonReadTypeId(context) => readTypeId
    "  %cmpref$(whileIndex)_v$(valueIndex) = load " -> print
    readTypeId -> writeAggregateFieldTypeId(context, state)
    ", ptr " -> print
    ownerIndex -> writeForwardedReferenceValue(valueIndex, context, state)
    ", align " -> print
    context.typeAligns[readTypeId] -> writeDecimalLine
}
writeComparisonOperandValue valueIndex: Int, ownerIndex: Int, whileIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[valueIndex] => value
    # Subject-when arms reuse the value evaluated before their conditions.
    # That value belongs to the outer flow, not to a loop's reload domain.
    whileIndex >= 0 and whileIndex < (context.ir -> len)
        and context.ir[whileIndex].kind == 19
        and context.ir[whileIndex].parent >= 0
        -> if {
            context.ir[whileIndex].parent => subjectControlIndex
            context.ir[subjectControlIndex].kind == 34
                and context.ir[subjectControlIndex].operand0 == valueIndex
                -> if {
                    subjectControlIndex -> writeSubjectWhenValue(ownerIndex, context, state)
                    return
                }
        }
    value -> isUserBlockScope -> if {
        valueIndex -> aggregateValueIndex(context, state) => resultIndex
        resultIndex != valueIndex -> if {
            resultIndex -> writeComparisonOperandValue(ownerIndex, whileIndex, context, state)
            return
        }
    }
    value.kind == 3 -> if {
        value -> writeIntegerLiteral(context, state)
        return
    }
    value.kind == 4 -> if {
        value -> sourceToken(context, state) => token
        (context.sources[value.sourceModule] -> byte(token.span.start)) == 116
            -> if { "1" -> print } else { "0" -> print }
        return
    }
    valueIndex -> isComparisonReferenceName(context, state)
        -> if {
            whileIndex < 0 and (valueIndex -> referenceParameterValueIsMaterialized(ownerIndex, context, state))
                -> if { "%v$(valueIndex)" -> print } else { "%cmpref$(whileIndex)_v$(valueIndex)" -> print }
        } else {
            whileIndex >= 0 -> if {
                WhileValueRequest { whileIndex: whileIndex, ownerIndex: ownerIndex, nodeIndex: valueIndex } -> writeWhileValue(context, state)
            } else { ownerIndex >= 0 -> if {
                    valueIndex -> writeFunctionValueName(ownerIndex, context, state)
                } else { "%v$(valueIndex)" -> print }
            }
        }
}
writeSubjectWhenValue whenIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[whenIndex].operand0 => subjectIndex
    (context.ir[subjectIndex] -> referenceValueTypeId(context, state)) >= 0
        -> if { "%when$(whenIndex)_subject_read" -> print } else {
            subjectIndex -> writeValue(ownerIndex, context, state)
        }
}

writeSubjectWhenOperand whenIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[whenIndex].operand0 => subjectIndex
    context.ir[subjectIndex] -> referenceValueTypeId(context, state) => readTypeId
    readTypeId >= 0 -> if {
        readTypeId -> writeAggregateFieldTypeId(context, state)
        " " -> print
        whenIndex -> writeSubjectWhenValue(ownerIndex, context, state)
    } else { subjectIndex -> writeReadOperand(ownerIndex, context, state) }
}
emitComparisonTextProducer textIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[textIndex] => textNode
    textNode.kind == 2 and textNode.parent >= 0 -> if {
        context.ir[textNode.parent] => consumer
        consumer.kind == 8 and (consumer.opcode == grammar.tokenIdEqualEqual() or consumer.opcode == grammar.tokenIdBangEqual())
            and (consumer.operand0 -> comparisonReadIsText(context)) and (consumer.operand1 -> comparisonReadIsText(context))
            -> if {
                consumer.operand0 == textIndex -> if {
                    textIndex -> emitTransientTextOperand(textNode.parent, ownerIndex, 0, context, state)
                } else { consumer.operand1 == textIndex -> if {
                        textIndex -> emitTransientTextOperand(textNode.parent, ownerIndex, 1, context, state)
                } }
            }
    }
}
writeTextComparisonOperand argumentIndex: Int, expressionIndex: Int, ownerIndex: Int, ordinal: Int, whileIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    argumentIndex -> transientTextOperandSource(expressionIndex, ordinal, context, state) => transientSource
    transientSource >= 0 -> if {
        "%calltext$(expressionIndex)_arg$(ordinal)" -> print
    } else {
        argumentIndex -> writeComparisonOperandValue(ownerIndex, whileIndex, context, state)
    }
}
diagnosticCallerFunction ownerIndex: Int, context: ref emitterContext.EmitContext -> Int {
    ownerIndex => owner!
    owner! >= 0 and owner! < (context.ir -> len)
        and context.ir[owner!].kind != 0 and context.ir[owner!].kind != 11
        -> while { context.ir[owner!].parent => owner! }
    owner! >= 0 and context.ir[owner!].kind == 0
        and context.ir[owner!].flags / 8 % 2 == 1
        -> if { owner! -> return }
    -1
}

diagnosticCallHasParent request: CallEnvironmentRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    request -> targetFunctionIndex(context, state) => target
    target < 0 -> if { false -> return }
    context.ir[target].flags / 8 % 2 == 0 -> if { false -> return }
    context -> usesReachableAsyncDiagnostics(state)
        -> unless { false -> return }
    true
}

emitDiagnosticParentCallValue request: CallEnvironmentRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    request -> diagnosticCallHasParent(context, state)
        -> unless { return }
    request.callerIndex -> diagnosticCallerFunction(context) => owner
    owner >= 0 -> if {
        owner -> asyncDiagnosticHeaderOffset(context, state) => offset
        "  %callenv$(request.callIndex)_diagnostic_parent = getelementptr i8, ptr %async_context, i64 $(offset)" -> println
    }
}

emitCallEnvironmentValues request: CallEnvironmentRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    request -> emitDiagnosticParentCallValue(context, state)
    context.ir[request.callIndex].operand0 -> emitTransientTextArguments(request.callIndex, request.callerIndex, 0, context, state)
    context.ir[request.callIndex].operand0 -> emitReferenceArgumentValues(request.callIndex, request.callerIndex, 0, context, state)
    context.ir[request.callIndex].operand0 -> emitMutableBorrowArgumentValues(request.callIndex, request.callerIndex, 0, context, state)
    request -> emitCallCaptureEnvironmentValues(context, state)
}
emitWhileCallEnvironmentValues request: CallEnvironmentRequest, whileIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    request -> emitDiagnosticParentCallValue(context, state)
    context.ir[request.callIndex].operand0 -> emitTransientTextArguments(request.callIndex, request.callerIndex, 0, context, state)
    context.ir[request.callIndex].operand0 -> emitWhileReferenceArgumentValues(request.callIndex, whileIndex, request.callerIndex, 0, context, state)
    context.ir[request.callIndex].operand0 -> emitMutableBorrowArgumentValues(request.callIndex, request.callerIndex, 0, context, state)
    request -> emitCallCaptureEnvironmentValues(context, state)
}
emitCallCaptureEnvironmentValues request: CallEnvironmentRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    request -> targetFunctionIndex(context, state) => targetFunctionIr
    [Int; ~] => callCaptures!
    targetFunctionIr >= 0 -> if {
        targetFunctionIr -> functionCaptures(context, state) => resolvedCallCaptures
        0 => resolvedCaptureIndex!
        resolvedCaptureIndex! < (resolvedCallCaptures -> len)
            -> while {
                callCaptures! -> push(resolvedCallCaptures[resolvedCaptureIndex!])
                resolvedCaptureIndex! + 1 => resolvedCaptureIndex!
            }
    }
    0 => captureIndex!
    captureIndex! < (callCaptures! -> len) -> while {
        CaptureValueRequest { callerIndex: request.callerIndex, callIndex: request.callIndex, interpolationIndex: -1, bindingIndex: callCaptures![captureIndex!], captureIndex: captureIndex! } -> emitCaptureTransport(context, state)
        captureIndex! + 1 => captureIndex!
    }
}

emitCallEnvironment request: CallEnvironmentRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool uses Console, Process {
    request -> targetFunctionIndex(context, state) => targetFunctionIr
    [Int; ~] => callCaptures!
    targetFunctionIr >= 0 -> if {
        targetFunctionIr -> functionCaptures(context, state) => resolvedCallCaptures
        0 => resolvedCaptureIndex!
        resolvedCaptureIndex! < (resolvedCallCaptures -> len)
            -> while {
                callCaptures! -> push(resolvedCallCaptures[resolvedCaptureIndex!])
                resolvedCaptureIndex! + 1 => resolvedCaptureIndex!
            }
    }
    request -> diagnosticCallHasParent(context, state) => hasDiagnosticParent
    hasDiagnosticParent -> if {
        "ptr " -> print
        (request.callerIndex -> diagnosticCallerFunction(context)) >= 0
            -> if { "%callenv$(request.callIndex)_diagnostic_parent" -> print } else { "null" -> print }
        (callCaptures! -> len) > 0 or request.hasArgument
            -> if { ", " -> print }
    }
    0 => captureIndex!
    captureIndex! < (callCaptures! -> len) -> while {
        callCaptures![captureIndex!] => bindingIndex
        context.ir[bindingIndex] -> writeCaptureAbiType(context, state)
        " " -> print
        CaptureValueRequest { callerIndex: request.callerIndex, callIndex: request.callIndex, interpolationIndex: -1, bindingIndex: bindingIndex, captureIndex: captureIndex! } -> writeCaptureArgumentValue(context, state)
        captureIndex! + 1 < (callCaptures! -> len) or request.hasArgument
            -> if { ", " -> print }
        captureIndex! + 1 => captureIndex!
    }
    hasDiagnosticParent or (callCaptures! -> len) > 0
}
sourceToken node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> syntax.SyntaxToken {
    context.ranges[node.sourceModule] => tokenRange
    tokenRange.tokenStart + node.payloadToken => tokenIndex
    context.tokens[tokenIndex]
}
writeIntegerLiteral node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    node -> typedIr.isSpecializedIntegerConstant -> if {
        "$(node.opcode)" -> print
        return
    }
    node.typeKind == 1 and node.typeOrigin == 1
        and node.typeSymbol >= 19 and node.typeSymbol <= 22
        -> if {
            node.typeSymbol == 19 or node.typeSymbol == 20
                -> if { 32 } else { 64 } => width
            node -> writeFloatingLiteral(width, context, state)
            return
        }
    context.ranges[node.sourceModule] => range
    context.constantLiterals -> constantLowering.find(range.literalStart, range.literalCount, node.astNode) -> when {
        Some(value) {
            "$value" -> print
            return
        }
        None { }
    }
    node -> sourceToken(context, state) => token
    context.sources[node.sourceModule] => source
    (source -> byte(token.span.start)) == 39 -> if {
        source -> syntax.decodeCharacterLiteral(token.span) -> when {
            Some(value) { "$value" -> print -> return }
            None { }
        }
    }
    token.span.start => segmentStart!
    token.span.start => byteIndex!
    token.span.start + token.span.length => tokenEnd
    byteIndex! < tokenEnd -> while {
        (source -> byte(byteIndex!)) == 95 -> if {
            byteIndex! > segmentStart! -> if { source -> slice(segmentStart!, byteIndex! - segmentStart!) -> print }
            byteIndex! + 1 => segmentStart!
        }
        byteIndex! + 1 => byteIndex!
    }
    tokenEnd > segmentStart! -> if { source -> slice(segmentStart!, tokenEnd - segmentStart!) -> print }
}

# Encode the destination width exactly, preserving signed zero and ties-to-even.
writeFloatingLiteral node: typedIr.TypedIrNode, width: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    node.kind == 7 and node.opcode == grammar.tokenIdMinus() => negative
    negative -> if { context.ir[node.operand0] } else { node } => literalNode
    literalNode -> sourceToken(context, state) => token
    context.sources[literalNode.sourceModule] -> slice(token.span.start, token.span.length) => literal
    literal -> floatingLiterals.encode(width) => encoding
    not encoding.valid -> if {
        "; sollang internal error: floating literal is not finite at its committed width" -> println
        process.exit(1)
    }
    negative -> if { encoding -> floatingLiterals.negate } else { encoding } -> floatingLiterals.write
}

# Value consumers use an existing reference read; place and call-ABI writers
# retain the original pointer representation.
writeReadOperand argumentIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[argumentIndex] => argument
    argument -> referenceValueTypeId(context, state) => readTypeId
    readTypeId >= 0 -> if {
        readTypeId -> writeAggregateFieldTypeId(context, state)
    } else { argument -> writeIrType(context, state) }
    " " -> print
    argumentIndex -> referenceParameterValueIsMaterialized(ownerIndex, context, state)
        -> if { "%v$(argumentIndex)" -> print } else {
            argumentIndex -> writeValue(ownerIndex, context, state)
        }
}

emitBuiltinNumericConversion nodeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[nodeIndex] => conversion
    conversion -> typedIr.isBuiltinFloatConversionCall
        -> if {
            nodeIndex -> emitBuiltinFloatConversion(ownerIndex, context, state)
            return
        }
    conversion.operand0 -> aggregateValueIndex(context, state) => argumentIndex
    context.ir[argumentIndex] => argument
    conversion -> integerNodeWidth(context, state) => targetWidth
    argument -> integerReadNodeWidth(context, state) => inputWidth
    argument.typeSymbol >= 19 and argument.typeSymbol <= 22 => sourceIsFloat
    "  %v$(nodeIndex) = " -> print
    argument.kind == 3 -> if {
        "add " -> print
        conversion -> writeIrType(context, state)
        " " -> print
        argument -> writeIntegerLiteral(context, state)
        ", 0" -> println
        return
    }
    sourceIsFloat -> if {
        conversion -> builtinFloatToIntegerOpcode(context, state) -> print
    } else {
        targetWidth < inputWidth -> if { "trunc " -> print } else {
            targetWidth > inputWidth -> if {
                argument -> integerNodeSigned(context, state)
                    -> if { "sext " -> print } else { "zext " -> print }
            } else { "add " -> print }
        }
    }
    argumentIndex -> writeReadOperand(ownerIndex, context, state)
    targetWidth == inputWidth and not sourceIsFloat
        -> if {
            ", 0" -> println
        } else {
            " to " -> print
            conversion -> writeIrType(context, state)
            "" -> println
        }
}

emitBuiltinFloatConversion nodeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[nodeIndex] => conversion
    conversion.operand0 -> aggregateValueIndex(context, state) => argumentIndex
    context.ir[argumentIndex] => argument
    "  %v$(nodeIndex) = " -> print
    argument.typeSymbol >= 19 and argument.typeSymbol <= 22 => sourceIsFloat
    conversion.typeSymbol == 19 or conversion.typeSymbol == 20
        -> if { 32 } else { 64 } => targetWidth
    argument.typeSymbol == 19 or argument.typeSymbol == 20
        -> if { 32 } else { 64 } => sourceWidth
    argument.kind == 3 or (argument.kind == 7 and argument.opcode == grammar.tokenIdMinus()
        and argument.operand0 >= 0 and argument.operand0 < (context.ir -> len)
        and context.ir[argument.operand0].kind == 3) -> if {
            # A direct literal takes the destination precision; computed operands
            # retain their already rounded value through the casts below.
            "freeze " -> print
            conversion -> writeIrType(context, state)
            " " -> print
            argument -> writeFloatingLiteral(targetWidth, context, state)
            "" -> println
            return
        }
    sourceIsFloat -> if {
        targetWidth == sourceWidth -> if { "freeze " -> print } else {
            targetWidth < sourceWidth -> if { "fptrunc " -> print } else { "fpext " -> print }
        }
    } else {
        argument -> integerNodeSigned(context, state)
            -> if { "sitofp " -> print } else { "uitofp " -> print }
    }
    argumentIndex -> writeReadOperand(ownerIndex, context, state)
    not sourceIsFloat or targetWidth != sourceWidth
        -> if {
            " to " -> print
            conversion -> writeIrType(context, state)
        }
    "" -> println
}

builtinFloatToIntegerOpcode target: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Text {
    target -> integerNodeSigned(context, state)
        -> if { "fptosi " } else { "fptoui " }
}

numericUnaryOperation opcode: Int, builtin: Int -> Text {
    opcode == -26 -> if { "xor" -> return }
    builtin -> typeIds.canonicalBuiltinSymbol => canonical
    canonical == 20 or canonical == 21 -> if { "fsub" -> return }
    "sub"
}
numericUnaryZero builtin: Int -> Text {
    builtin -> typeIds.canonicalBuiltinSymbol => canonical
    canonical == 20 or canonical == 21 -> if { "-0.0" } else { "0" }
}
floatBinaryOperation opcode: Int -> Text {
    opcode == grammar.tokenIdPlus() -> if { "fadd" -> return }
    opcode == grammar.tokenIdMinus() -> if { "fsub" -> return }
    opcode == grammar.tokenIdStar() -> if { "fmul" -> return }
    opcode == grammar.tokenIdSlash() -> if { "fdiv" -> return }
    opcode == grammar.tokenIdPercent() -> if { "frem" -> return }
    opcode == grammar.tokenIdEqualEqual() -> if { "fcmp oeq" -> return }
    opcode == grammar.tokenIdBangEqual() -> if { "fcmp one" -> return }
    opcode == grammar.tokenIdLess() -> if { "fcmp olt" -> return }
    opcode == grammar.tokenIdLessEqual() -> if { "fcmp ole" -> return }
    opcode == grammar.tokenIdGreater() -> if { "fcmp ogt" -> return }
    opcode == grammar.tokenIdGreaterEqual() -> if { "fcmp oge" -> return }
    ""
}
# Arguments is a copyable count snapshot over process-lifetime runtime storage.
# Materialize it even when passed, returned, bound, or stored as an ordinary value.
emitArgumentsIntrinsic nodeIndex: Int, context: ref emitterContext.EmitContext -> Unit uses Console {
    context.ir[nodeIndex] => node
    (node.kind == 6 or node.kind == 9) and node.opcode == -212
        -> if {
            "  %v$(nodeIndex) = call i64 @sollang_argument_count()" -> println
        }
}

# Binding copies follow the source place and canonical destination type. Reads
# that are not the direct RHS of a binding retain their borrowed representation.
bindingFixedStorageCopyTypeId valueIndex: Int, context: ref emitterContext.EmitContext -> Int {
    valueIndex >= 0 and valueIndex < (context.ir -> len)
        -> unless { -1 -> return }
    context.ir[valueIndex] => value
    value.kind == 5 or (valueIndex -> namedStructFieldProjection(context))
        -> unless { -1 -> return }
    value.parent >= 0 and value.parent < (context.ir -> len)
        -> unless { -1 -> return }
    context.ir[value.parent] => binding
    binding.kind == 17 and binding.operand0 == valueIndex
        and (binding.typeId -> fixedStructCopyState(0, context)) == 1
        -> if { binding.typeId } else { -1 }
}

writeValue nodeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    nodeIndex < 0 or nodeIndex >= (context.ir -> len)
        -> if {
            context.ir -> len => irCount
            -1 => ownerKind!
            -1 => ownerSource!
            -1 => ownerAst!
            -1 => ownerSymbol!
            -1 => ownerByte!
            -1 => ownerLength!
            ownerIndex >= 0 and ownerIndex < irCount -> if {
                context.ir[ownerIndex] => invalidValueOwner
                invalidValueOwner.kind => ownerKind!
                invalidValueOwner.sourceModule => ownerSource!
                invalidValueOwner.astNode => ownerAst!
                invalidValueOwner.symbol => ownerSymbol!
                ownerSource! >= 0
                    and ownerSource! < (context.ranges -> len)
                    and ownerAst! >= 0
                    and ownerAst! < context.ranges[ownerSource!].astCount
                    -> if {
                        context.nodes[context.ranges[ownerSource!].astStart + ownerAst!] => invalidValueOwnerAst
                        Int(invalidValueOwnerAst.start) => ownerByte!
                        Int(invalidValueOwnerAst.length) => ownerLength!
                    }
            }
            "sollang compiler error S052: LLVM value writer received invalid IR index $nodeIndex (owner $ownerIndex, ownerKind $(ownerKind!), ownerSource $(ownerSource!), ownerAst $(ownerAst!), ownerSymbol $(ownerSymbol!), ownerByte $(ownerByte!), ownerLength $(ownerLength!), irCount $irCount); this is a compiler-integrity defect, not a source error" -> runtime.eprintln
        }
    context.ir[nodeIndex] => value
    # A caller-inline lexical scope produces its operand value, not an SSA
    # instruction of its own. Preserve the original scope for scheduling and
    # ownership while exposing its canonical result to ordinary consumers.
    value -> isUserBlockScope -> if {
        nodeIndex -> aggregateValueIndex(context, state) => scopedValueIndex
        scopedValueIndex != nodeIndex -> if {
            scopedValueIndex -> writeValue(ownerIndex, context, state)
            return
        }
    }
    (nodeIndex -> bindingFixedStorageCopyTypeId(context)) >= 0
        -> if {
            "%v$(nodeIndex)_binding_copy" -> print -> return
        }
    value.kind == 3 or value.kind == 4 -> if {
        value -> sourceToken(context, state) => valueToken
        value.kind == 3 -> if {
            value -> writeIntegerLiteral(context, state)
        } else {
            (context.sources[value.sourceModule] -> byte(valueToken.span.start)) == 116
                -> if { "1" -> print } else { "0" -> print }
        }
    } else {
        # Frame-backed payload reads have their own reload in the current
        # continuation; their original arm value cannot dominate resume edges.
        value.kind == 5 and value.operand0 >= 0 and context.ir[value.operand0].kind == 29
            and not (nodeIndex -> isAwaitSourceNode(context))
            and (value.operand0 -> asyncFrameBindingRoot(ownerIndex, context, state)) < 0
            -> if {
                "%v$(value.operand0)" -> print
            } else {
                -1 => parameterOrdinal!
                ownerIndex >= 0 and context.ir[ownerIndex].kind == 0 and context.ir[ownerIndex].operand1 >= 0
                    and (value.kind == 5 or (value.kind == 10 and value.parent == ownerIndex))
                    -> if {
                        value.symbol == context.ir[context.ir[ownerIndex].operand1].symbol
                            -> if { 0 => parameterOrdinal! } else {
                                ownerIndex -> additionalParameterOrdinal(value.symbol, context, state) => parameterOrdinal!
                            }
                    }
                parameterOrdinal! >= 0 -> if {
                    nodeIndex -> mutableBorrowParameterOrdinal(ownerIndex, context, state) => mutableParameterOrdinal
                    mutableParameterOrdinal >= 0 -> if {
                        "%v$(nodeIndex)" -> print
                    } else {
                        value -> scalarReferenceValueTypeId(context, state) => referenceValueTypeId
                        value -> referenceValueTypeId(context, state) => referencedValueTypeId
                        referenceValueTypeId >= 0 or (referencedValueTypeId >= 0 and context.types[referencedValueTypeId].kind == 12)
                            -> if {
                                "%v$(nodeIndex)" -> print
                            } else {
                                parameterOrdinal! == 0 -> if { "%arg" -> print } else { "%arg$(parameterOrdinal!)" -> print }
                            }
                    }
                } else { "%v$(nodeIndex)" -> print }
            }
    }
}

boundedIntrinsicDictionaryTypeId node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    node -> effectiveTypeId(context, state) => valueTypeId!
    valueTypeId! >= 0 and valueTypeId! < (context.types -> len) and context.types[valueTypeId!].kind == 8
        -> if { context.types[valueTypeId!].first => valueTypeId! }
    valueTypeId! >= 0 and valueTypeId! < (context.types -> len) and context.types[valueTypeId!].kind == 13
        -> if { valueTypeId! -> return }
    -1
}

emitLengthIntrinsic callIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[callIndex] => call
    context.ir[call.operand0] => base
    base -> integerNodeWidth(context, state) => lengthReceiverIntegerWidth
    lengthReceiverIntegerWidth > 0 -> if {
        "; sollang compiler error S042: len receiver resolves to scalar i$lengthReceiverIntegerWidth at ir $callIndex (receiver $(call.operand0), receiverKind $(base.kind), receiverType $(base.typeId)/$(base.typeKind)/$(base.typeOrigin)/$(base.typeModule)/$(base.typeSymbol), source $(call.sourceModule), ast $(call.astNode))" -> println
    }
    call -> integerNodeWidth(context, state) => resultWidth
    base -> boundedIntrinsicDictionaryTypeId(context, state) => boundedTypeId
    boundedTypeId >= 0 -> if {
        boundedTypeId -> boundedDictionaryLayoutForType(context) => boundedLayout
        call.operand0 -> mutableBorrowParameterOrdinal(ownerIndex, context, state) => boundedMutableParameterOrdinal
        -1 => boundedMutableRoot!
        false => boundedReadonlyReference!
        base -> effectiveTypeId(context, state) => boundedReceiverTypeId
        boundedReceiverTypeId >= 0 and context.types[boundedReceiverTypeId].kind == 8
            -> if { true => boundedReadonlyReference! }
        boundedMutableParameterOrdinal < 0 and not boundedReadonlyReference!
            -> if { call.operand0 -> mutableStorageRoot(context, state) => boundedMutableRoot! }
        boundedMutableParameterOrdinal >= 0 or boundedMutableRoot! >= 0 or boundedReadonlyReference!
            -> if {
                "  %v$(callIndex)_length_source = load " -> print
                boundedTypeId -> writeSemanticTypeId(context, state)
                ", ptr " -> print
                boundedMutableParameterOrdinal >= 0 -> if {
                    boundedMutableParameterOrdinal -> writeMutableStructParameterPointer
                } else {
                    boundedMutableRoot! >= 0 -> if {
                        "%slot$(boundedMutableRoot!)" -> print
                    } else { call.operand0 -> writeValue(ownerIndex, context, state) }
                }
                ", align $(boundedLayout.align)" -> println
            }
        "  %v$(callIndex)" -> print
        resultWidth == 32 -> if { "_raw" -> print }
        " = extractvalue " -> print
        boundedTypeId -> writeSemanticTypeId(context, state)
        " " -> print
        boundedMutableParameterOrdinal >= 0 or boundedMutableRoot! >= 0 or boundedReadonlyReference!
            -> if { "%v$(callIndex)_length_source" -> print } else { call.operand0 -> writeValue(ownerIndex, context, state) }
        ", 0" -> println
        resultWidth == 32 -> if { "  %v$(callIndex) = trunc i64 %v$(callIndex)_raw to i32" -> println }
        return
    }
    call.operand0 -> mutableBorrowParameterOrdinal(ownerIndex, context, state) => mutableLengthParameterOrdinal
    mutableLengthParameterOrdinal >= 0 -> if {
        base -> isDictionaryType -> if {
            "  %v$(callIndex)_length_source = load %sollang.int_dictionary, ptr " -> print
            mutableLengthParameterOrdinal -> writeMutableStructParameterPointer
            ", align 8" -> println
            "  %v$(callIndex)" -> print
            resultWidth == 32 -> if { "_raw" -> print }
            " = extractvalue %sollang.int_dictionary %v$(callIndex)_length_source, 1" -> println
        } else {
            "  %v$(callIndex)" -> print
            resultWidth == 32 -> if { "_raw" -> print }
            " = load i64, ptr " -> print
            mutableLengthParameterOrdinal == 0 -> if { "%arg_mut_len_addr" -> print } else { "%arg$(mutableLengthParameterOrdinal)_mut_len_addr" -> print }
            ", align 8" -> println
        }
        resultWidth == 32 -> if { "  %v$(callIndex) = trunc i64 %v$(callIndex)_raw to i32" -> println }
    } else {
        base -> isArgumentsType -> if {
            "  %v$(callIndex)" -> print
            resultWidth == 32 -> if { "_raw" -> print }
            " = call i64 @sollang_argument_count()" -> println
            resultWidth == 32 -> if { "  %v$(callIndex) = trunc i64 %v$(callIndex)_raw to i32" -> println }
        } else {
            base.typeId => valueTypeId!
            false => readonlyReference!
            valueTypeId! >= 0 and context.types[valueTypeId!].kind == 8
                -> if {
                    context.types[valueTypeId!].first => valueTypeId!
                    true => readonlyReference!
                }
            readonlyReference! and valueTypeId! >= 0 and context.types[valueTypeId!].kind == 12
                -> if {
                    "  %v$(callIndex)" -> print
                    resultWidth == 32 -> if { "_raw" -> print }
                    " = load i64, ptr " -> print
                    ownerIndex -> writeForwardedReferenceValue(call.operand0, context, state)
                    ", align 8" -> println
                    resultWidth == 32 -> if { "  %v$(callIndex) = trunc i64 %v$(callIndex)_raw to i32" -> println }
                    return
                }
            -1 => mutableRoot!
            not readonlyReference! and (base -> isDictionaryType)
                -> if {
                    call.operand0 -> mutableStorageRoot(context, state) => mutableRoot!
                }
            not readonlyReference! and valueTypeId! >= 0 and context.types[valueTypeId!].kind == 7 and context.types[valueTypeId!].origin == 4 and (context.types[valueTypeId!].symbol == 6 or context.types[valueTypeId!].symbol == 7)
                -> if {
                    call.operand0 -> mutableStorageRoot(context, state) => mutableRoot!
                }
            mutableRoot! >= 0 -> if {
                "  %v$(callIndex)_length_source = load " -> print
                valueTypeId! -> writeSemanticTypeId(context, state)
                ", ptr %slot$(mutableRoot!), align 8" -> println
            }
            readonlyReference! -> if {
                "  %v$(callIndex)_length_source = load " -> print
                valueTypeId! -> writeSemanticTypeId(context, state)
                ", ptr " -> print
                call.operand0 -> writeValue(ownerIndex, context, state)
                ", align 8" -> println
            }
            "  %v$(callIndex)" -> print
            resultWidth == 32 -> if { "_raw" -> print }
            " = extractvalue " -> print
            readonlyReference! -> if {
                valueTypeId! -> writeSemanticTypeId(context, state)
            } else {
                base -> writeIrType(context, state)
            }
            " " -> print
            mutableRoot! >= 0 or readonlyReference! -> if {
                "%v$(callIndex)_length_source" -> print
            } else {
                call.operand0 -> writeValue(ownerIndex, context, state)
            }
            ", " -> print
            "1" -> println
            resultWidth == 32 -> if { "  %v$(callIndex) = trunc i64 %v$(callIndex)_raw to i32" -> println }
        }
    }
}

emitCapacityIntNarrowing callIndex: Int, whileIndex: Int -> Unit uses Console {
    whileIndex < 0 -> if {
        "  %v$(callIndex)_capacity_fits = icmp ule i64 %v$(callIndex)_raw, 2147483647" -> println
        "  br i1 %v$(callIndex)_capacity_fits, label %v$(callIndex)_capacity_ok, label %v$(callIndex)_capacity_fail" -> println
        "v$(callIndex)_capacity_fail:" -> println
        "  call void @llvm.trap()" -> println
        "  unreachable" -> println
        "v$(callIndex)_capacity_ok:" -> println
        "  %v$(callIndex) = trunc i64 %v$(callIndex)_raw to i32" -> println
    } else {
        "  %while$(whileIndex)_v$(callIndex)_capacity_fits = icmp ule i64 %while$(whileIndex)_v$(callIndex)_raw, 2147483647" -> println
        "  br i1 %while$(whileIndex)_v$(callIndex)_capacity_fits, label %while$(whileIndex)_v$(callIndex)_capacity_ok, label %while$(whileIndex)_v$(callIndex)_capacity_fail" -> println
        "while$(whileIndex)_v$(callIndex)_capacity_fail:" -> println
        "  call void @llvm.trap()" -> println
        "  unreachable" -> println
        "while$(whileIndex)_v$(callIndex)_capacity_ok:" -> println
        "  %while$(whileIndex)_v$(callIndex) = trunc i64 %while$(whileIndex)_v$(callIndex)_raw to i32" -> println
    }
}

