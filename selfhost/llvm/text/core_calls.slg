    callIndex -> callTargetParameter(ordinal, context, state) => argumentParameterIndex
    false => argumentNeedsReferenceSlot!
    argumentParameterIndex >= 0 -> if {
        context.ir[argumentParameterIndex] => argumentParameter
        (argumentParameter.typeId >= 0 and context.types[argumentParameter.typeId].kind == 8 and not (argument.typeId >= 0 and context.types[argument.typeId].kind == 8)) -> if { true => argumentNeedsReferenceSlot! }
        ((context.ir[callIndex] -> targetsNativeFunction(context, state)) and argumentParameter.flags / 2 % 2 == 1 and (context -> diagnostics.nativeAbiStructTypeSafe(argumentParameter.typeId, 0))) -> if { true => argumentNeedsReferenceSlot! }
    }
    false => argumentIsMutableBorrow!
    false => argumentIsMutableStructBorrow!
