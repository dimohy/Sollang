        hasLeadingArgument! -> if { ", " -> print }
        branchFlowIndex -> writeCallArgument(callIndex, ownerIndex, 0, context, state)
        call.operand0 -> emitCallArgumentChain(callIndex, ownerIndex, 1, true, context, state)
