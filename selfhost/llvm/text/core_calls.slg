        parameter -> integerNodeWidth(context, state) => parameterWidth
        (value.kind != 3
            and value.kind != 4
            and valueWidth > 0
            and parameterWidth > 0
            and valueWidth != parameterWidth) -> if { true => needsPromotion! }
    }
    needsPromotion!
