                    genericToken.kind == grammar.tokenIdLess() -> if { true => inGenericArguments! }
                    (inGenericArguments! and genericToken.kind == grammar.tokenIdNumber()) -> if { genericTokenIndex! => genericNumberToken! }
                    genericToken.kind == grammar.tokenIdGreater() -> if { false => inGenericArguments! }
