emitCallArguments callIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[callIndex] => call
    false => hasLeadingArgument!
    ((call -> targetsNativeFunction(context, state)) and call.typeId >= 0 and (context -> diagnostics.nativeAbiStructTypeSafe(call.typeId, 0)) and (call.typeId -> nativeAggregateIndirect(context, state))) -> if {
        "ptr sret(" -> print
        call -> writeIrType(context, state)
        ") %native_result_slot_$(callIndex)" -> print
        true => hasLeadingArgument!
    }
    callIndex -> branchStageFlowIndex(context, state) => branchFlowIndex
