                "  %native_arg_bits_$(callIndex)_$(ordinal) = load i$(directWidth), ptr %native_arg_$(callIndex)_$(ordinal), align " -> print
                parameter -> storageAlign(context, state) -> writeDecimalLine
            }
        }
    }
}
emitNativeWindowsArgumentValues argumentIndex: Int, callIndex: Int, ownerIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    (argumentIndex >= 0 and (context.ir[argumentIndex].parent == callIndex or (argumentIndex == context.ir[callIndex].operand0 and (context.ir[argumentIndex].kind == 18 or context.ir[argumentIndex].kind == 27)))) -> if {
        argumentIndex -> emitNativeWindowsArgumentValue(callIndex, ownerIndex, ordinal, context, state)
        context.ir[argumentIndex].nextOperand -> emitNativeWindowsArgumentValues(callIndex, ownerIndex, ordinal + 1, context, state)
    }
}
emitNativeWindowsCallValues callIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[callIndex] => call
    (context.expectedPathStyle == 1 and (call -> targetsNativeFunction(context, state))) -> if {
        (call.typeId >= 0 and (context -> diagnostics.nativeAbiStructTypeSafe(call.typeId, 0))) -> if {
            call.typeId -> nativeWindowsDirectAggregateWidth(context, state) => resultWidth
            "  %native_result_slot_$(callIndex) = alloca " -> print
            call -> writeIrType(context, state)
            ", align " -> print
            resultWidth == 0 -> if { "16" -> println } else { call -> storageAlign(context, state) -> writeDecimalLine }
        }
        call.operand0 -> emitNativeWindowsArgumentValues(callIndex, ownerIndex, 0, context, state)
    }
}
emitNativeSysVArgumentValue argumentIndex: Int, callIndex: Int, ownerIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    callIndex -> callTargetParameter(ordinal, context, state) => parameterIndex
    (parameterIndex >= 0 and argumentIndex >= 0) -> if {
        context.ir[parameterIndex] => parameter
        false => byValueAbiStruct!
        (parameter.typeId >= 0 and parameter.typeId < (context.types -> len) and context.types[parameter.typeId].kind != 8 and parameter.flags / 2 % 2 == 0) -> if {
            context -> diagnostics.nativeAbiStructTypeSafe(parameter.typeId, 0) => byValueAbiStruct!
        }
        byValueAbiStruct! -> if {
            callIndex -> nativeSysVArgumentIndirect(ordinal, parameter.typeId, context, state) => indirect
            indirect -> if {
                "  %native_arg_$(callIndex)_$(ordinal) = alloca " -> print
                parameter -> writeIrType(context, state)
                ", align " -> print
                parameter -> storageAlign(context, state) -> writeDecimalLine
                "  store " -> print
                parameter -> writeIrType(context, state)
                " " -> print
                argumentIndex -> writeValue(ownerIndex, context, state)
                ", ptr %native_arg_$(callIndex)_$(ordinal), align " -> print
                parameter -> storageAlign(context, state) -> writeDecimalLine
            } else {
                "  %native_arg_storage_$(callIndex)_$(ordinal) = alloca [2 x i64], align 8" -> println
                "  store [2 x i64] zeroinitializer, ptr %native_arg_storage_$(callIndex)_$(ordinal), align 8" -> println
                "  store " -> print
                parameter -> writeIrType(context, state)
                " " -> print
                argumentIndex -> writeValue(ownerIndex, context, state)
                ", ptr %native_arg_storage_$(callIndex)_$(ordinal), align " -> print
                parameter -> storageAlign(context, state) -> writeDecimalLine
                "  %native_arg_part_$(callIndex)_$(ordinal)_0 = load " -> print
                parameter.typeId -> writeNativeSysVCoercionType(0, context, state)
                ", ptr %native_arg_storage_$(callIndex)_$(ordinal), align " -> print
                parameter -> storageAlign(context, state) -> writeDecimalLine
                context.typeSizes[parameter.typeId] > 8 -> if {
                    "  %native_arg_part_ptr_$(callIndex)_$(ordinal)_1 = getelementptr i8, ptr %native_arg_storage_$(callIndex)_$(ordinal), i64 8" -> println
                    "  %native_arg_part_$(callIndex)_$(ordinal)_1 = load " -> print
                    parameter.typeId -> writeNativeSysVCoercionType(1, context, state)
                    ", ptr %native_arg_part_ptr_$(callIndex)_$(ordinal)_1, align 8" -> println
                }
            }
        }
    }
}
emitNativeSysVArgumentValues argumentIndex: Int, callIndex: Int, ownerIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    (argumentIndex >= 0 and (context.ir[argumentIndex].parent == callIndex or (argumentIndex == context.ir[callIndex].operand0 and (context.ir[argumentIndex].kind == 18 or context.ir[argumentIndex].kind == 27)))) -> if {
        argumentIndex -> emitNativeSysVArgumentValue(callIndex, ownerIndex, ordinal, context, state)
        context.ir[argumentIndex].nextOperand -> emitNativeSysVArgumentValues(callIndex, ownerIndex, ordinal + 1, context, state)
    }
}
emitNativeSysVCallValues callIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[callIndex] => call
    (context.expectedPathStyle == 0 and (call -> targetsNativeFunction(context, state))) -> if {
        (call.typeId >= 0 and (context -> diagnostics.nativeAbiStructTypeSafe(call.typeId, 0))) -> if {
            call.typeId -> nativeSysVAggregateIndirect(context, state) => indirect
            indirect -> if {
                "  %native_result_slot_$(callIndex) = alloca " -> print
                call -> writeIrType(context, state)
                ", align " -> print
                call -> storageAlign(context, state) -> writeDecimalLine
            } else {
                "  %native_result_slot_$(callIndex) = alloca [2 x i64], align 8" -> println
                "  store [2 x i64] zeroinitializer, ptr %native_result_slot_$(callIndex), align 8" -> println
            }
        }
        call.operand0 -> emitNativeSysVArgumentValues(callIndex, ownerIndex, 0, context, state)
    }
}
emitNativeCallValues callIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.expectedPathStyle == 1 -> if {
        callIndex -> emitNativeWindowsCallValues(ownerIndex, context, state)
    } else {
        callIndex -> emitNativeSysVCallValues(ownerIndex, context, state)
    }
    context.ir[callIndex] => nativeTryCall
    nativeTryCall -> nativeTrySuccessTypeId(context, state) => nativeTryOutputType
    nativeTryOutputType > 0 -> if {
        "  %native_try_out_$(callIndex) = alloca " -> print
        nativeTryOutputType -> writeSemanticTypeId(context, state)
        ", align " -> print
        context.typeAligns[nativeTryOutputType] -> writeDecimalLine
        "  store " -> print
        nativeTryOutputType -> writeSemanticTypeId(context, state)
        " zeroinitializer, ptr %native_try_out_$(callIndex), align " -> print
        context.typeAligns[nativeTryOutputType] -> writeDecimalLine
    }
}
writeCallArgumentTypeAndValue argumentIndex: Int, callIndex: Int, ownerIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool uses Console {
    false => handled!
    (context.expectedPathStyle == 1 and (context.ir[callIndex] -> targetsNativeFunction(context, state))) -> if {
        callIndex -> callTargetParameter(ordinal, context, state) => parameterIndex
        parameterIndex >= 0 -> if {
            context.ir[parameterIndex] => parameter
            false => byValueAbiStruct!
            (parameter.typeId >= 0 and parameter.typeId < (context.types -> len) and context.types[parameter.typeId].kind != 8 and parameter.flags / 2 % 2 == 0) -> if {
                context -> diagnostics.nativeAbiStructTypeSafe(parameter.typeId, 0) => byValueAbiStruct!
            }
            byValueAbiStruct! -> if {
                parameter.typeId -> nativeWindowsDirectAggregateWidth(context, state) => directWidth
                directWidth > 0 -> if {
                    "i$(directWidth) %native_arg_bits_$(callIndex)_$(ordinal)" -> print
                } else {
                    "ptr %native_arg_$(callIndex)_$(ordinal)" -> print
                }
                true => handled!
            }
        }
    }
    (context.expectedPathStyle == 0 and (context.ir[callIndex] -> targetsNativeFunction(context, state))) -> if {
        callIndex -> callTargetParameter(ordinal, context, state) => parameterIndex
        parameterIndex >= 0 -> if {
            context.ir[parameterIndex] => parameter
            false => byValueAbiStruct!
            (parameter.typeId >= 0 and parameter.typeId < (context.types -> len) and context.types[parameter.typeId].kind != 8 and parameter.flags / 2 % 2 == 0) -> if {
                context -> diagnostics.nativeAbiStructTypeSafe(parameter.typeId, 0) => byValueAbiStruct!
            }
            byValueAbiStruct! -> if {
                callIndex -> nativeSysVArgumentIndirect(ordinal, parameter.typeId, context, state) => indirect
                indirect -> if {
                    "ptr byval(" -> print
                    parameter -> writeIrType(context, state)
                    ") align " -> print
                    parameter -> storageAlign(context, state) -> writeDecimal
                    " %native_arg_$(callIndex)_$(ordinal)" -> print
                } else {
                    parameter.typeId -> writeNativeSysVCoercionType(0, context, state)
                    " %native_arg_part_$(callIndex)_$(ordinal)_0" -> print
                    context.typeSizes[parameter.typeId] > 8 -> if {
                        ", " -> print
                        parameter.typeId -> writeNativeSysVCoercionType(1, context, state)
                        " %native_arg_part_$(callIndex)_$(ordinal)_1" -> print
                    }
                }
                true => handled!
            }
        }
    }
    handled!
}
writeCallResultPrefix callIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[callIndex] => call
    call -> targetsNativeTry(context, state) => nativeTryCall
    nativeTryCall -> if {
        "  %native_try_status_$(callIndex) = call i32" -> print
    } else {
    false => nativeAggregateResult!
    0 => nativeAggregateWidth!
    ((call -> targetsNativeFunction(context, state)) and call.typeId >= 0) -> if {
        context -> diagnostics.nativeAbiStructTypeSafe(call.typeId, 0) => nativeAggregateResult!
        (nativeAggregateResult! and context.expectedPathStyle == 1) -> if { call.typeId -> nativeWindowsDirectAggregateWidth(context, state) => nativeAggregateWidth! }
    }
    nativeAggregateResult! -> if {
        context.expectedPathStyle == 1 -> if {
            nativeAggregateWidth! > 0 -> if {
                "  %native_result_bits_$(callIndex) = call i$(nativeAggregateWidth!)" -> print
            } else {
                "  call void" -> print
            }
        } else {
            call.typeId -> nativeSysVAggregateIndirect(context, state) -> if {
                "  call void" -> print
            } else {
                "  %native_result_bits_$(callIndex) = call " -> print
                context.typeSizes[call.typeId] > 8 -> if {
                    "{ " -> print
                    call.typeId -> writeNativeSysVCoercionType(0, context, state)
                    ", " -> print
                    call.typeId -> writeNativeSysVCoercionType(1, context, state)
                    " }" -> print
                } else {
                    call.typeId -> writeNativeSysVCoercionType(0, context, state)
                }
            }
        }
    } else {
        (call.typeOrigin == 1 and call.typeSymbol == 0) -> if { "  call " -> print } else { "  %v$(callIndex) = call " -> print }
        (call -> targetsNativeFunction(context, state)) -> if {
            call.typeId >= 0 -> if {
                context.types[call.typeId] => nativeScalarResultType
                (nativeScalarResultType.kind == 1 and nativeScalarResultType.origin == 1 and (nativeScalarResultType.symbol == 3 or nativeScalarResultType.symbol == 4)) -> if { "signext " -> print }
                (nativeScalarResultType.kind == 1 and nativeScalarResultType.origin == 1 and (nativeScalarResultType.symbol == 8 or nativeScalarResultType.symbol == 9)) -> if { "zeroext " -> print }
            }
        }
        call -> writeIrType(context, state)
    }
    }
}
emitCallResultFinish callIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[callIndex] => call
    call -> targetsNativeTry(context, state) => nativeTryCall
    nativeTryCall -> if {
        call -> nativeTrySuccessTypeId(context, state) => nativeTrySuccessType
        "  %native_try_ok_$(callIndex) = icmp eq i32 %native_try_status_$(callIndex), 0" -> println
        "  %native_try_result_slot_$(callIndex) = alloca " -> print
        call -> writeIrType(context, state)
        ", align 8" -> println
        "  store " -> print
        call -> writeIrType(context, state)
        " zeroinitializer, ptr %native_try_result_slot_$(callIndex), align 8" -> println
        "  %native_try_tag_addr_$(callIndex) = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %native_try_result_slot_$(callIndex), i32 0, i32 0" -> println
        "  %native_try_tag_$(callIndex) = select i1 %native_try_ok_$(callIndex), i32 0, i32 1" -> println
        "  store i32 %native_try_tag_$(callIndex), ptr %native_try_tag_addr_$(callIndex), align 4" -> println
        "  %native_try_payload_$(callIndex) = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %native_try_result_slot_$(callIndex), i32 0, i32 1" -> println
        "  br i1 %native_try_ok_$(callIndex), label %native_try_success_$(callIndex), label %native_try_error_$(callIndex)" -> println
        "native_try_success_$(callIndex):" -> println
        nativeTrySuccessType > 0 -> if {
            "  %native_try_value_$(callIndex) = load " -> print
            nativeTrySuccessType -> writeSemanticTypeId(context, state)
            ", ptr %native_try_out_$(callIndex), align " -> print
            context.typeAligns[nativeTrySuccessType] -> writeDecimalLine
            context -> nativeHandleType(nativeTrySuccessType) -> if { callIndex -> emitNativeHandleValidation(true) }
            "  store " -> print
            nativeTrySuccessType -> writeSemanticTypeId(context, state)
            " %native_try_value_$(callIndex), ptr %native_try_payload_$(callIndex), align " -> print
            context.typeAligns[nativeTrySuccessType] -> writeDecimalLine
        }
        "  br label %native_try_end_$(callIndex)" -> println
        "native_try_error_$(callIndex):" -> println
        "  store i32 %native_try_status_$(callIndex), ptr %native_try_payload_$(callIndex), align 4" -> println
        "  br label %native_try_end_$(callIndex)" -> println
        "native_try_end_$(callIndex):" -> println
        "  %v$(callIndex) = load " -> print
        call -> writeIrType(context, state)
        ", ptr %native_try_result_slot_$(callIndex), align 8" -> println
    } else {
    ((call -> targetsNativeFunction(context, state)) and call.typeId >= 0 and (context -> diagnostics.nativeAbiStructTypeSafe(call.typeId, 0))) -> if {
        context.expectedPathStyle == 1 -> if {
            call.typeId -> nativeWindowsDirectAggregateWidth(context, state) => resultWidth
            resultWidth > 0 -> if {
                "  store i$(resultWidth) %native_result_bits_$(callIndex), ptr %native_result_slot_$(callIndex), align " -> print
                call -> storageAlign(context, state) -> writeDecimalLine
            }
            "  %v$(callIndex) = load " -> print
            call -> writeIrType(context, state)
            ", ptr %native_result_slot_$(callIndex), align " -> print
            call -> storageAlign(context, state) -> writeDecimalLine
        } else {
            call.typeId -> nativeSysVAggregateIndirect(context, state) => indirect
            not indirect -> if {
                context.typeSizes[call.typeId] > 8 -> if {
                    "  %native_result_part_$(callIndex)_0 = extractvalue { " -> print
                    call.typeId -> writeNativeSysVCoercionType(0, context, state)
                    ", " -> print
                    call.typeId -> writeNativeSysVCoercionType(1, context, state)
                    " } %native_result_bits_$(callIndex), 0" -> println
                    "  %native_result_part_$(callIndex)_1 = extractvalue { " -> print
                    call.typeId -> writeNativeSysVCoercionType(0, context, state)
                    ", " -> print
                    call.typeId -> writeNativeSysVCoercionType(1, context, state)
                    " } %native_result_bits_$(callIndex), 1" -> println
                    "  store " -> print
                    call.typeId -> writeNativeSysVCoercionType(0, context, state)
                    " %native_result_part_$(callIndex)_0, ptr %native_result_slot_$(callIndex), align 8" -> println
                    "  %native_result_part_ptr_$(callIndex)_1 = getelementptr i8, ptr %native_result_slot_$(callIndex), i64 8" -> println
                    "  store " -> print
                    call.typeId -> writeNativeSysVCoercionType(1, context, state)
                    " %native_result_part_$(callIndex)_1, ptr %native_result_part_ptr_$(callIndex)_1, align 8" -> println
                } else {
                    "  store " -> print
                    call.typeId -> writeNativeSysVCoercionType(0, context, state)
                    " %native_result_bits_$(callIndex), ptr %native_result_slot_$(callIndex), align 8" -> println
                }
            }
            "  %v$(callIndex) = load " -> print
            call -> writeIrType(context, state)
            ", ptr %native_result_slot_$(callIndex), align " -> print
            call -> storageAlign(context, state) -> writeDecimalLine
        }
    }
    ((call -> targetsNativeFunction(context, state)) and (context -> nativeHandleType(call.typeId))) -> if { callIndex -> emitNativeHandleValidation(false) }
    }
}
