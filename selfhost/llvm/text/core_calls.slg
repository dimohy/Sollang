sourceToken node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> syntax.SyntaxToken {
    context.ranges[node.sourceModule] => tokenRange
    tokenRange.tokenStart + node.payloadToken => tokenIndex
    context.tokens[tokenIndex]
}
writeValue nodeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[nodeIndex] => value
    (value.kind == 3 or value.kind == 4) -> if {
        value -> sourceToken(context, state) => valueToken
        value.kind == 3 -> if {
            context.sources[value.sourceModule] -> slice(valueToken.span.start, valueToken.span.length) -> print
        } else {
            ((context.sources[value.sourceModule] -> byte(valueToken.span.start)) == UInt8(116)) -> if { "1" -> print } else { "0" -> print }
        }
    } else {
        (value.kind == 5 and value.operand0 >= 0 and context.ir[value.operand0].kind == 29) -> if {
            "%v$(value.operand0)" -> print
        } else {
        -1 => parameterOrdinal!
        (ownerIndex >= 0 and context.ir[ownerIndex].kind == 0 and context.ir[ownerIndex].operand1 >= 0 and value.kind == 5) -> if {
            value.symbol == context.ir[context.ir[ownerIndex].operand1].symbol -> if { 0 => parameterOrdinal! } else {
                ownerIndex -> additionalParameterOrdinal(value.symbol, context, state) => parameterOrdinal!
            }
        }
        parameterOrdinal! >= 0 -> if {
            parameterOrdinal! == 0 -> if { "%arg" -> print } else { "%arg$(parameterOrdinal!)" -> print }
        } else { "%v$(nodeIndex)" -> print }
        }
    }
}
emitIfResultStore resultNode: typedIr.TypedIrNode, valueIndex: Int, ownerIndex: Int, ifIndex: Int, branchOrdinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[valueIndex] => valueNode
    resultNode -> integerNodeWidth(context, state) => resultWidth
    valueNode -> integerNodeWidth(context, state) => valueWidth
    (resultWidth > 0 and valueWidth > 0 and resultWidth != valueWidth) -> if {
        "  %if" -> print
        ifIndex -> writeDecimal
        "_result_value" -> print
        branchOrdinal -> writeDecimal
        " = " -> print
        resultWidth < valueWidth -> if { "trunc " -> print } else {
            valueNode -> integerNodeSigned(context, state) -> if { "sext " -> print } else { "zext " -> print }
        }
        valueNode -> writeIrType(context, state)
        " " -> print
        valueIndex -> writeValue(ownerIndex, context, state)
        " to " -> print
        resultNode -> writeIrType(context, state)
