                and context.ir[referenceValueRoot].typeId >= 0
                and context.types[context.ir[referenceValueRoot].typeId].kind == 8)
                or (context.ir[referenceValueRoot].kind != 10 and context.ir[referenceValueRoot].flags == 1)) -> if { true => referenceValueUsesMutableSlot! }
        }
