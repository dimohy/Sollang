isSourceTextFileIntrinsic node: typedIr.TypedIrNode -> Bool {
    node.kind == 6 and (node.opcode == -231 or node.opcode == -232 or node.opcode == -234)
}
emitSourceTextFileIntrinsic callIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[callIndex] => call
    call.opcode == -231 -> if {
        "  %v$(callIndex) = call %sollang.source_text @sollang_runtime_read_standard_input()" -> println
    }
    (call.opcode == -234 and call.operand0 >= 0) -> if {
        "  %v$(callIndex) = call %sollang.source_text @sollang_runtime_read_standard_input_chunk_once(i64 " -> print
        call.operand0 -> writeValue(ownerIndex, context, state)
        ")" -> println
    }
    (call.opcode == -232 and call.operand0 >= 0) -> if {
        context.ir[call.operand0] => borrowedBytes
        borrowedBytes.typeId => borrowedBytesType!
        false => borrowedBytesReference!
        (borrowedBytesType! >= 0 and context.types[borrowedBytesType!].kind == 8) -> if {
            context.types[borrowedBytesType!].first => borrowedBytesType!
            true => borrowedBytesReference!
        }
        borrowedBytesReference! -> if {
            "  %v$(callIndex)_bytes = load " -> print
            borrowedBytesType! -> writeSemanticTypeId(context, state)
            ", ptr " -> print
            call.operand0 -> writeValue(ownerIndex, context, state)
            ", align 8" -> println
        }
        "  %v$(callIndex)_data = extractvalue " -> print
        borrowedBytesType! -> writeSemanticTypeId(context, state)
        " " -> print
        borrowedBytesReference! -> if { "%v$(callIndex)_bytes" -> print } else { call.operand0 -> writeValue(ownerIndex, context, state) }
        ", 0" -> println
        "  %v$(callIndex)_length = extractvalue " -> print
        borrowedBytesType! -> writeSemanticTypeId(context, state)
        " " -> print
        borrowedBytesReference! -> if { "%v$(callIndex)_bytes" -> print } else { call.operand0 -> writeValue(ownerIndex, context, state) }
        ", 1" -> println
        "  %v$(callIndex)_value0 = insertvalue %sollang.source_text poison, ptr %v$(callIndex)_data, 0" -> println
        "  %v$(callIndex)_value1 = insertvalue %sollang.source_text %v$(callIndex)_value0, i64 %v$(callIndex)_length, 1" -> println
        "  %v$(callIndex)_value2 = insertvalue %sollang.source_text %v$(callIndex)_value1, ptr null, 2" -> println
        "  %v$(callIndex) = insertvalue %sollang.source_text %v$(callIndex)_value2, i64 0, 3" -> println
    }
}
emitStandardErrorCall callIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    callIndex -> callArgumentIndex(context, state) => argumentIndex
