            call.typeId -> nativeSysVAggregateIndirect(context, state) -> if {
                "  call void" -> print
            } else {
                "  %native_result_bits_$(callIndex) = call " -> print
                context.typeSizes[call.typeId] > 8 -> if {
                    "{ " -> print
                    call.typeId -> writeNativeSysVCoercionType(0, context, state)
                    ", " -> print
                    call.typeId -> writeNativeSysVCoercionType(1, context, state)
                    " }" -> print
                } else {
                    call.typeId -> writeNativeSysVCoercionType(0, context, state)
                }
            }
        }
    } else {
        (call.typeOrigin == 1 and call.typeSymbol == 0) -> if { "  call " -> print } else { "  %v$(callIndex) = call " -> print }
        (call -> targetsNativeFunction(context, state)) -> if {
            call.typeId >= 0 -> if {
                context.types[call.typeId] => nativeScalarResultType
                (nativeScalarResultType.kind == 1 and nativeScalarResultType.origin == 1 and (nativeScalarResultType.symbol == 3 or nativeScalarResultType.symbol == 4)) -> if { "signext " -> print }
                (nativeScalarResultType.kind == 1 and nativeScalarResultType.origin == 1 and (nativeScalarResultType.symbol == 8 or nativeScalarResultType.symbol == 9)) -> if { "zeroext " -> print }
            }
        }
        call -> writeIrType(context, state)
    }
    }
}
emitCallResultFinish callIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[callIndex] => call
    call -> targetsNativeTry(context, state) => nativeTryCall
    nativeTryCall -> if {
        call -> nativeTrySuccessTypeId(context, state) => nativeTrySuccessType
        "  %native_try_ok_$(callIndex) = icmp eq i32 %native_try_status_$(callIndex), 0" -> println
        "  %native_try_result_slot_$(callIndex) = alloca " -> print
        call -> writeIrType(context, state)
        ", align 8" -> println
        "  store " -> print
        call -> writeIrType(context, state)
        " zeroinitializer, ptr %native_try_result_slot_$(callIndex), align 8" -> println
        "  %native_try_tag_addr_$(callIndex) = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %native_try_result_slot_$(callIndex), i32 0, i32 0" -> println
        "  %native_try_tag_$(callIndex) = select i1 %native_try_ok_$(callIndex), i32 0, i32 1" -> println
        "  store i32 %native_try_tag_$(callIndex), ptr %native_try_tag_addr_$(callIndex), align 4" -> println
        "  %native_try_payload_$(callIndex) = getelementptr inbounds " -> print
        call -> writeIrType(context, state)
        ", ptr %native_try_result_slot_$(callIndex), i32 0, i32 1" -> println
        "  br i1 %native_try_ok_$(callIndex), label %native_try_success_$(callIndex), label %native_try_error_$(callIndex)" -> println
        "native_try_success_$(callIndex):" -> println
        nativeTrySuccessType > 0 -> if {
            "  %native_try_value_$(callIndex) = load " -> print
            nativeTrySuccessType -> writeSemanticTypeId(context, state)
            ", ptr %native_try_out_$(callIndex), align " -> print
            context.typeAligns[nativeTrySuccessType] -> writeDecimalLine
            context -> nativeHandleType(nativeTrySuccessType) -> if { callIndex -> emitNativeHandleValidation(true) }
            "  store " -> print
            nativeTrySuccessType -> writeSemanticTypeId(context, state)
            " %native_try_value_$(callIndex), ptr %native_try_payload_$(callIndex), align " -> print
            context.typeAligns[nativeTrySuccessType] -> writeDecimalLine
        }
        "  br label %native_try_end_$(callIndex)" -> println
        "native_try_error_$(callIndex):" -> println
        "  store i32 %native_try_status_$(callIndex), ptr %native_try_payload_$(callIndex), align 4" -> println
        "  br label %native_try_end_$(callIndex)" -> println
        "native_try_end_$(callIndex):" -> println
        "  %v$(callIndex) = load " -> print
        call -> writeIrType(context, state)
        ", ptr %native_try_result_slot_$(callIndex), align 8" -> println
    } else {
    ((call -> targetsNativeFunction(context, state)) and call.typeId >= 0 and (context -> diagnostics.nativeAbiStructTypeSafe(call.typeId, 0))) -> if {
        context.expectedPathStyle == 1 -> if {
            call.typeId -> nativeWindowsDirectAggregateWidth(context, state) => resultWidth
            resultWidth > 0 -> if {
                "  store i$(resultWidth) %native_result_bits_$(callIndex), ptr %native_result_slot_$(callIndex), align " -> print
                call -> storageAlign(context, state) -> writeDecimalLine
            }
            "  %v$(callIndex) = load " -> print
            call -> writeIrType(context, state)
            ", ptr %native_result_slot_$(callIndex), align " -> print
            call -> storageAlign(context, state) -> writeDecimalLine
        } else {
            call.typeId -> nativeSysVAggregateIndirect(context, state) => indirect
            not indirect -> if {
                context.typeSizes[call.typeId] > 8 -> if {
                    "  %native_result_part_$(callIndex)_0 = extractvalue { " -> print
                    call.typeId -> writeNativeSysVCoercionType(0, context, state)
                    ", " -> print
                    call.typeId -> writeNativeSysVCoercionType(1, context, state)
                    " } %native_result_bits_$(callIndex), 0" -> println
                    "  %native_result_part_$(callIndex)_1 = extractvalue { " -> print
                    call.typeId -> writeNativeSysVCoercionType(0, context, state)
                    ", " -> print
                    call.typeId -> writeNativeSysVCoercionType(1, context, state)
                    " } %native_result_bits_$(callIndex), 1" -> println
                    "  store " -> print
                    call.typeId -> writeNativeSysVCoercionType(0, context, state)
                    " %native_result_part_$(callIndex)_0, ptr %native_result_slot_$(callIndex), align 8" -> println
                    "  %native_result_part_ptr_$(callIndex)_1 = getelementptr i8, ptr %native_result_slot_$(callIndex), i64 8" -> println
                    "  store " -> print
                    call.typeId -> writeNativeSysVCoercionType(1, context, state)
                    " %native_result_part_$(callIndex)_1, ptr %native_result_part_ptr_$(callIndex)_1, align 8" -> println
                } else {
                    "  store " -> print
                    call.typeId -> writeNativeSysVCoercionType(0, context, state)
                    " %native_result_bits_$(callIndex), ptr %native_result_slot_$(callIndex), align 8" -> println
                }
            }
            "  %v$(callIndex) = load " -> print
            call -> writeIrType(context, state)
            ", ptr %native_result_slot_$(callIndex), align " -> print
            call -> storageAlign(context, state) -> writeDecimalLine
        }
    }
    ((call -> targetsNativeFunction(context, state)) and (context -> nativeHandleType(call.typeId))) -> if { callIndex -> emitNativeHandleValidation(false) }
    }
}
