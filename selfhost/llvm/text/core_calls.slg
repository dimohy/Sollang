                        context.ir[mutableParameterIndex] -> mutableBorrowUsesStructPointer(context)
                            => mutableBorrowUsesStructPointer!
                    }
                    mutableBorrowUsesStructPointer! -> if {
                        projectedStructMember -> if {
                            context.ir[context.ir[mutableValueIndex].operand0].typeId => mutableMemberOwnerType!
                            mutableMemberOwnerType! >= 0 and context.types[mutableMemberOwnerType!].kind == 8
                                -> if {
                                    context.types[mutableMemberOwnerType!].first => mutableMemberOwnerType!
                                }
                            "  %callmut$(callIndex)_arg$(ordinal) = getelementptr inbounds " -> print
                            mutableMemberOwnerType! -> writeSemanticTypeId(context, state)
                            ", ptr " -> print
                            forwardedRootOrdinal >= 0 -> if {
                                forwardedRootOrdinal -> writeMutableStructParameterPointer
                            } else {
                                "%slot$(mutableRootBinding)" -> print
                            }
                            ", i32 0, i32 " -> print
                            context.ir[mutableValueIndex].symbol -> writeDecimalLine
                        } else {
                            context.ir[mutableParameterIndex] -> effectiveTypeId(context, state) => mutableTargetTypeId
                            mutableTargetTypeId >= 0
                                and context.types[mutableTargetTypeId].kind == 4
                                and context.types[mutableTargetTypeId].length >= 0
                                and forwardedOrdinal < 0 -> if {
                                    mutableRootBinding -> mutableBindingRoot(context, state) => mutableRoot
                                    "  %callmut$(callIndex)_arg$(ordinal)_fixed = load { ptr, i64 }, ptr %slot$(mutableRoot), align " -> print
                                    context.ir[mutableRoot] -> storageAlign(context, state) -> writeDecimalLine
                                    "  %callmut$(callIndex)_arg$(ordinal) = extractvalue { ptr, i64 } %callmut$(callIndex)_arg$(ordinal)_fixed, 0" -> println
                                } else {
                                    "  %callmut$(callIndex)_arg$(ordinal) = getelementptr i8, ptr " -> print
                                    forwardedOrdinal >= 0 -> if {
                                        forwardedOrdinal -> writeMutableStructParameterPointer
                                    } else {
                                        mutableRootBinding -> mutableBindingRoot(context, state) => mutableRoot
                                        "%slot$(mutableRoot)" -> print
                                    }
                                    ", i64 0" -> println
                                }
                        }
                    } else {
                        projectedStructMember -> if {
                            context.ir[context.ir[mutableValueIndex].operand0].typeId => mutableMemberOwnerType!
                            mutableMemberOwnerType! >= 0 and context.types[mutableMemberOwnerType!].kind == 8
                                -> if {
                                    context.types[mutableMemberOwnerType!].first => mutableMemberOwnerType!
                                }
                            "  %callmut$(callIndex)_arg$(ordinal)_storage = getelementptr inbounds " -> print
                            mutableMemberOwnerType! -> writeSemanticTypeId(context, state)
                            ", ptr " -> print
                            forwardedRootOrdinal >= 0 -> if {
                                forwardedRootOrdinal -> writeMutableStructParameterPointer
                            } else {
                                "%slot$(mutableRootBinding)" -> print
                            }
                            ", i32 0, i32 " -> print
                            context.ir[mutableValueIndex].symbol -> writeDecimalLine
                            "  %callmut$(callIndex)_arg$(ordinal)_ptr = getelementptr inbounds " -> print
                            context.ir[mutableValueIndex] -> writeIrType(context, state)
                            ", ptr %callmut$(callIndex)_arg$(ordinal)_storage, i32 0, i32 0" -> println
                            "  %callmut$(callIndex)_arg$(ordinal)_len = getelementptr inbounds " -> print
                            context.ir[mutableValueIndex] -> writeIrType(context, state)
                            ", ptr %callmut$(callIndex)_arg$(ordinal)_storage, i32 0, i32 1" -> println
                            "  %callmut$(callIndex)_arg$(ordinal)_capacity = getelementptr inbounds " -> print
                            context.ir[mutableValueIndex] -> writeIrType(context, state)
                            ", ptr %callmut$(callIndex)_arg$(ordinal)_storage, i32 0, i32 2" -> println
                            "  %callmut$(callIndex)_arg$(ordinal)_0 = insertvalue %sollang.mutable_container poison, ptr %callmut$(callIndex)_arg$(ordinal)_ptr, 0" -> println
                            "  %callmut$(callIndex)_arg$(ordinal)_1 = insertvalue %sollang.mutable_container %callmut$(callIndex)_arg$(ordinal)_0, ptr %callmut$(callIndex)_arg$(ordinal)_len, 1" -> println
                            "  %callmut$(callIndex)_arg$(ordinal) = insertvalue %sollang.mutable_container %callmut$(callIndex)_arg$(ordinal)_1, ptr %callmut$(callIndex)_arg$(ordinal)_capacity, 2" -> println
                        } else {
                            forwardedOrdinal >= 0 -> if {
                                forwardedOrdinal == 0 -> if {
                                    "  %callmut$(callIndex)_arg$(ordinal)_0 = insertvalue %sollang.mutable_container poison, ptr %arg_mut_ptr_addr, 0" -> println
                                    "  %callmut$(callIndex)_arg$(ordinal)_1 = insertvalue %sollang.mutable_container %callmut$(callIndex)_arg$(ordinal)_0, ptr %arg_mut_len_addr, 1" -> println
                                    "  %callmut$(callIndex)_arg$(ordinal) = insertvalue %sollang.mutable_container %callmut$(callIndex)_arg$(ordinal)_1, ptr %arg_mut_capacity_addr, 2" -> println
                                } else {
                                    "  %callmut$(callIndex)_arg$(ordinal)_0 = insertvalue %sollang.mutable_container poison, ptr %arg$(forwardedOrdinal)_mut_ptr_addr, 0" -> println
                                    "  %callmut$(callIndex)_arg$(ordinal)_1 = insertvalue %sollang.mutable_container %callmut$(callIndex)_arg$(ordinal)_0, ptr %arg$(forwardedOrdinal)_mut_len_addr, 1" -> println
                                    "  %callmut$(callIndex)_arg$(ordinal) = insertvalue %sollang.mutable_container %callmut$(callIndex)_arg$(ordinal)_1, ptr %arg$(forwardedOrdinal)_mut_capacity_addr, 2" -> println
                                }
                            } else {
                                mutableRootBinding -> mutableBindingRoot(context, state) => mutableRoot
                                "  %callmut$(callIndex)_arg$(ordinal)_ptr = getelementptr inbounds " -> print
                                context.ir[mutableRoot] -> writeIrType(context, state)
                                ", ptr %slot$(mutableRoot), i32 0, i32 0" -> println
                                "  %callmut$(callIndex)_arg$(ordinal)_len = getelementptr inbounds " -> print
                                context.ir[mutableRoot] -> writeIrType(context, state)
                                ", ptr %slot$(mutableRoot), i32 0, i32 1" -> println
                                "  %callmut$(callIndex)_arg$(ordinal)_capacity = getelementptr inbounds " -> print
                                context.ir[mutableRoot] -> writeIrType(context, state)
                                ", ptr %slot$(mutableRoot), i32 0, i32 2" -> println
                                "  %callmut$(callIndex)_arg$(ordinal)_0 = insertvalue %sollang.mutable_container poison, ptr %callmut$(callIndex)_arg$(ordinal)_ptr, 0" -> println
                                "  %callmut$(callIndex)_arg$(ordinal)_1 = insertvalue %sollang.mutable_container %callmut$(callIndex)_arg$(ordinal)_0, ptr %callmut$(callIndex)_arg$(ordinal)_len, 1" -> println
                                "  %callmut$(callIndex)_arg$(ordinal) = insertvalue %sollang.mutable_container %callmut$(callIndex)_arg$(ordinal)_1, ptr %callmut$(callIndex)_arg$(ordinal)_capacity, 2" -> println
                            }
                        }
                    }
                }
            context.ir[argumentIndex].nextOperand -> emitMutableBorrowArgumentValues(callIndex, ownerIndex, ordinal + 1, context, state)
        }
}
emitCurrentMutableParameterValue valueIndex: Int, parameterOrdinal: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[valueIndex] => value
    context -> parameterIndexAtOrdinal(ownerIndex, parameterOrdinal) => parameterIndex
    parameterIndex >= 0 and (context.ir[parameterIndex] -> mutableBorrowUsesStructPointer(context))
        -> if {
            context.ir[parameterIndex] -> effectiveTypeId(context, state) => mutableParameterTypeId
            mutableParameterTypeId >= 0
                and context.types[mutableParameterTypeId].kind == 4
                and context.types[mutableParameterTypeId].length >= 0
                -> if {
                    "  %v$(valueIndex) = insertvalue { ptr, i64 } " -> print
                    parameterOrdinal == 0 -> if { "%arg" -> print } else { "%arg$(parameterOrdinal)" -> print }
                    ", i64 $(context.types[mutableParameterTypeId].length), 1" -> println
                } else {
                    "  %v$(valueIndex) = load " -> print
                    value -> writeIrType(context, state)
                    ", ptr " -> print
                    parameterOrdinal -> writeMutableStructParameterPointer
                    ", align " -> print
                    value -> storageAlign(context, state) -> writeDecimalLine
                }
        } else {
            "  %v$(valueIndex)_current_ptr = load ptr, ptr " -> print
            parameterOrdinal == 0 -> if { "%arg_mut_ptr_addr" -> print } else { "%arg$(parameterOrdinal)_mut_ptr_addr" -> print }
            ", align 8" -> println
            "  %v$(valueIndex)_current_len = load i64, ptr " -> print
            parameterOrdinal == 0 -> if { "%arg_mut_len_addr" -> print } else { "%arg$(parameterOrdinal)_mut_len_addr" -> print }
            ", align 8" -> println
            "  %v$(valueIndex)_current_capacity = load i64, ptr " -> print
            parameterOrdinal == 0 -> if { "%arg_mut_capacity_addr" -> print } else { "%arg$(parameterOrdinal)_mut_capacity_addr" -> print }
            ", align 8" -> println
            "  %v$(valueIndex)_current0 = insertvalue " -> print
            value -> writeIrType(context, state)
            " poison, ptr %v$(valueIndex)_current_ptr, 0" -> println
            "  %v$(valueIndex)_current1 = insertvalue " -> print
            value -> writeIrType(context, state)
            " %v$(valueIndex)_current0, i64 %v$(valueIndex)_current_len, 1" -> println
            "  %v$(valueIndex) = insertvalue " -> print
            value -> writeIrType(context, state)
            " %v$(valueIndex)_current1, i64 %v$(valueIndex)_current_capacity, 2" -> println
        }
}
interpolatedTextRoots textIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> [Int; ~] {
    [Int; ~] => roots!
    context.ir[textIndex] => textNode
    textNode -> sourceInterpolations(context, state) => interpolations
    0 => search!
    search! < (interpolations -> len) -> while {
        interpolations[search!] => currentInterpolation
        currentInterpolation.sourceToken == textNode.payloadToken and currentInterpolation.parent < 0
            -> if {
                roots! -> push(search!)
            }
        search! + 1 => search!
    }
    roots!
}
transientTextArgumentSource argumentIndex: Int, callIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    callIndex -> callTargetParameter(ordinal, context, state) => parameterIndex
    -1 => textIndex!
    parameterIndex >= 0 and (context.ir[parameterIndex] -> isTextType)
        -> if {
            argumentIndex -> aggregateValueIndex(context, state) => argumentValueIndex
            argumentValueIndex -> producerValueIndex(context, state) => producedValueIndex
            producedValueIndex >= 0 and context.ir[producedValueIndex].kind == 2
                -> if {
                    producedValueIndex -> interpolatedTextRoots(context, state) => roots
                    (roots -> len) > 0 -> if { producedValueIndex => textIndex! }
                }
        }
    textIndex!
}
emitTransientTextArgument argumentIndex: Int, callIndex: Int, ownerIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    argumentIndex -> transientTextArgumentSource(callIndex, ordinal, context, state) => textIndex
    textIndex >= 0 -> if {
        context.ir[textIndex] => textNode
        textNode -> sourceInterpolations(context, state) => interpolations
        textIndex -> interpolatedTextRoots(context, state) => roots
        Int(roots -> len) => rootCount
        UIntSize(0) => staticLength!
        UIntSize(0) => suffixStart!
        0 => rootOrdinal!
        rootOrdinal! < rootCount -> while {
            roots[rootOrdinal!] => interpolationIndex
            interpolations[interpolationIndex] => interpolationRoot
            interpolations -> interpolationEmissionOrder(textNode.payloadToken, interpolationRoot.segment) => expressionOrder
            0 => expressionOrderIndex!
            expressionOrderIndex! < (expressionOrder -> len)
                -> while {
                    expressionOrder[expressionOrderIndex!] => expressionNodeIndex
                    interpolations[expressionNodeIndex] => expressionNode
                    expressionNodeIndex -> interpolationHasLogicalAncestor(interpolations) => insideLogical
                    not insideLogical -> if {
                        expressionNode.kind == 3 and (expressionNode.opcode == -24 or expressionNode.opcode == -25)
                            -> if {
                                callIndex -> emitInterpolationSubtree(expressionNodeIndex, interpolations, textNode.sourceModule, ownerIndex, callIndex, true, context, state)
                            } else {
                                callIndex -> emitInterpolationIntrinsic(expressionNodeIndex, interpolations, textNode.sourceModule, ownerIndex, callIndex, true, context, state)
                                callIndex -> emitInterpolationOperation(expressionNodeIndex, interpolations, textNode.sourceModule, ownerIndex, callIndex, context, state)
                            }
                    }
                    expressionOrderIndex! + 1 => expressionOrderIndex!
                }
            interpolationIndex -> interpolationNodeIntegerWidth(interpolations, textNode.sourceModule, ownerIndex, callIndex, context, state) => integerWidth
            integerWidth > 0 -> if {
                "  %calltext$(callIndex)_arg$(ordinal)_root$(rootOrdinal!)_buffer = alloca [21 x i8], align 1" -> println
                integerWidth < 64 -> if {
                    "  %calltext$(callIndex)_arg$(ordinal)_root$(rootOrdinal!)_integer = " -> print
                    interpolationIndex -> interpolationNodeSigned(interpolations, textNode.sourceModule, ownerIndex, callIndex, context, state)
                        -> if { "sext" -> print } else { "zext" -> print }
                    " i$(integerWidth) " -> print
                    callIndex -> writeInterpolationValue(interpolationIndex, interpolations, textNode.sourceModule, ownerIndex, callIndex, context, state)
                    " to i64" -> println
                }
                "  %calltext$(callIndex)_arg$(ordinal)_root$(rootOrdinal!)_length = call i64 @" -> print
                interpolationIndex -> interpolationNodeSigned(interpolations, textNode.sourceModule, ownerIndex, callIndex, context, state)
                    -> if { "sollang_format_i64" -> print } else { "sollang_format_u64" -> print }
                "(ptr %calltext$(callIndex)_arg$(ordinal)_root$(rootOrdinal!)_buffer, i64 " -> print
                integerWidth < 64 -> if { "%calltext$(callIndex)_arg$(ordinal)_root$(rootOrdinal!)_integer" -> print } else {
                    callIndex -> writeInterpolationValue(interpolationIndex, interpolations, textNode.sourceModule, ownerIndex, callIndex, context, state)
                }
                ")" -> println
                "  %calltext$(callIndex)_arg$(ordinal)_root$(rootOrdinal!)_ptr = getelementptr [21 x i8], ptr %calltext$(callIndex)_arg$(ordinal)_root$(rootOrdinal!)_buffer, i64 0, i64 0" -> println
            } else {
                "  %calltext$(callIndex)_arg$(ordinal)_root$(rootOrdinal!)_ptr = extractvalue %sollang.text " -> print
                callIndex -> writeInterpolationValue(interpolationIndex, interpolations, textNode.sourceModule, ownerIndex, callIndex, context, state)
                ", 0" -> println
                "  %calltext$(callIndex)_arg$(ordinal)_root$(rootOrdinal!)_length = extractvalue %sollang.text " -> print
                callIndex -> writeInterpolationValue(interpolationIndex, interpolations, textNode.sourceModule, ownerIndex, callIndex, context, state)
                ", 1" -> println
            }
            staticLength! + interpolationRoot.literalLength => staticLength!
            interpolationRoot.expressionStart + interpolationRoot.expressionLength + 1 => suffixStart!
            rootOrdinal! + 1 => rootOrdinal!
        }
        textNode -> sourceToken(context, state) => textToken
        TextLiteralRequest { sourceModule: textNode.sourceModule, token: textToken } -> textLiteralLength(context, state) => rawLength
        staticLength! + rawLength - suffixStart! => staticLength!
        "  %calltext$(callIndex)_arg$(ordinal)_length0 = add i64 0, " -> print
        Int(staticLength!) -> writeDecimalLine
        0 => lengthOrdinal!
        lengthOrdinal! < rootCount -> while {
            "  %calltext$(callIndex)_arg$(ordinal)_length" -> print
            lengthOrdinal! + 1 -> writeDecimal
            " = add i64 %calltext$(callIndex)_arg$(ordinal)_length" -> print
            lengthOrdinal! -> writeDecimal
            ", %calltext$(callIndex)_arg$(ordinal)_root$(lengthOrdinal!)_length" -> println
            "  %calltext$(callIndex)_arg$(ordinal)_length$(lengthOrdinal! + 1)_ok = icmp uge i64 %calltext$(callIndex)_arg$(ordinal)_length$(lengthOrdinal! + 1), %calltext$(callIndex)_arg$(ordinal)_length$(lengthOrdinal!)" -> println
            "  br i1 %calltext$(callIndex)_arg$(ordinal)_length$(lengthOrdinal! + 1)_ok, label %calltext$(callIndex)_arg$(ordinal)_length$(lengthOrdinal! + 1)_ready, label %calltext$(callIndex)_arg$(ordinal)_length$(lengthOrdinal! + 1)_overflow" -> println
            "calltext$(callIndex)_arg$(ordinal)_length$(lengthOrdinal! + 1)_overflow:" -> println
            "  call void @llvm.trap()" -> println
            "  unreachable" -> println
            "calltext$(callIndex)_arg$(ordinal)_length$(lengthOrdinal! + 1)_ready:" -> println
            lengthOrdinal! + 1 => lengthOrdinal!
        }
        "  %calltext$(callIndex)_arg$(ordinal)_empty = icmp eq i64 %calltext$(callIndex)_arg$(ordinal)_length$(rootCount), 0" -> println
        "  %calltext$(callIndex)_arg$(ordinal)_allocation_length = select i1 %calltext$(callIndex)_arg$(ordinal)_empty, i64 1, i64 %calltext$(callIndex)_arg$(ordinal)_length$(rootCount)" -> println
        "  %calltext$(callIndex)_arg$(ordinal)_buffer = alloca i8, i64 %calltext$(callIndex)_arg$(ordinal)_allocation_length, align 1" -> println
        "  %calltext$(callIndex)_arg$(ordinal)_offset0 = add i64 0, 0" -> println
        0 => copyOrdinal!
        copyOrdinal! < rootCount -> while {
            roots[copyOrdinal!] => copyIndex
            interpolations[copyIndex] => copyRoot
            "  %calltext$(callIndex)_arg$(ordinal)_literal$(copyOrdinal!)_target = getelementptr i8, ptr %calltext$(callIndex)_arg$(ordinal)_buffer, i64 %calltext$(callIndex)_arg$(ordinal)_offset$(copyOrdinal! * 2)" -> println
            "  %calltext$(callIndex)_arg$(ordinal)_literal$(copyOrdinal!)_source = getelementptr i8, ptr @sollang_str_$(textIndex), i64 $(copyRoot.literalStart)" -> println
            "  call void @llvm.memcpy.p0.p0.i64(ptr %calltext$(callIndex)_arg$(ordinal)_literal$(copyOrdinal!)_target, ptr %calltext$(callIndex)_arg$(ordinal)_literal$(copyOrdinal!)_source, i64 $(copyRoot.literalLength), i1 false)" -> println
            "  %calltext$(callIndex)_arg$(ordinal)_offset$(copyOrdinal! * 2 + 1) = add i64 %calltext$(callIndex)_arg$(ordinal)_offset$(copyOrdinal! * 2), $(copyRoot.literalLength)" -> println
            "  %calltext$(callIndex)_arg$(ordinal)_root$(copyOrdinal!)_target = getelementptr i8, ptr %calltext$(callIndex)_arg$(ordinal)_buffer, i64 %calltext$(callIndex)_arg$(ordinal)_offset$(copyOrdinal! * 2 + 1)" -> println
            "  call void @llvm.memcpy.p0.p0.i64(ptr %calltext$(callIndex)_arg$(ordinal)_root$(copyOrdinal!)_target, ptr %calltext$(callIndex)_arg$(ordinal)_root$(copyOrdinal!)_ptr, i64 %calltext$(callIndex)_arg$(ordinal)_root$(copyOrdinal!)_length, i1 false)" -> println
            "  %calltext$(callIndex)_arg$(ordinal)_offset$(copyOrdinal! * 2 + 2) = add i64 %calltext$(callIndex)_arg$(ordinal)_offset$(copyOrdinal! * 2 + 1), %calltext$(callIndex)_arg$(ordinal)_root$(copyOrdinal!)_length" -> println
            copyOrdinal! + 1 => copyOrdinal!
        }
        rawLength - suffixStart! => suffixLength
        "  %calltext$(callIndex)_arg$(ordinal)_suffix_target = getelementptr i8, ptr %calltext$(callIndex)_arg$(ordinal)_buffer, i64 %calltext$(callIndex)_arg$(ordinal)_offset$(rootCount * 2)" -> println
        "  %calltext$(callIndex)_arg$(ordinal)_suffix_source = getelementptr i8, ptr @sollang_str_$(textIndex), i64 $(suffixStart!)" -> println
        "  call void @llvm.memcpy.p0.p0.i64(ptr %calltext$(callIndex)_arg$(ordinal)_suffix_target, ptr %calltext$(callIndex)_arg$(ordinal)_suffix_source, i64 $(suffixLength), i1 false)" -> println
        "  %calltext$(callIndex)_arg$(ordinal)_value0 = insertvalue %sollang.text poison, ptr %calltext$(callIndex)_arg$(ordinal)_buffer, 0" -> println
        "  %calltext$(callIndex)_arg$(ordinal) = insertvalue %sollang.text %calltext$(callIndex)_arg$(ordinal)_value0, i64 %calltext$(callIndex)_arg$(ordinal)_length$(rootCount), 1" -> println
    }
}
emitTransientTextArguments argumentIndex: Int, callIndex: Int, ownerIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    argumentIndex >= 0
        and ((callIndex -> callTargetParameter(ordinal, context, state)) >= 0
        or (not (callIndex -> callHasResolvedFunctionTarget(context, state))
        and (context.ir[argumentIndex].parent == callIndex or argumentIndex == context.ir[callIndex].operand0)))
        -> if {
            argumentIndex -> emitTransientTextArgument(callIndex, ownerIndex, ordinal, context, state)
            context.ir[argumentIndex].nextOperand -> emitTransientTextArguments(callIndex, ownerIndex, ordinal + 1, context, state)
        }
}
emitCallEnvironmentValues request: CallEnvironmentRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[request.callIndex].operand0 -> emitTransientTextArguments(request.callIndex, request.callerIndex, 0, context, state)
    context.ir[request.callIndex].operand0 -> emitReferenceArgumentValues(request.callIndex, request.callerIndex, 0, context, state)
    context.ir[request.callIndex].operand0 -> emitMutableBorrowArgumentValues(request.callIndex, request.callerIndex, 0, context, state)
    request -> emitCallCaptureEnvironmentValues(context, state)
}
emitWhileCallEnvironmentValues request: CallEnvironmentRequest, whileIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[request.callIndex].operand0 -> emitTransientTextArguments(request.callIndex, request.callerIndex, 0, context, state)
    context.ir[request.callIndex].operand0 -> emitWhileReferenceArgumentValues(request.callIndex, whileIndex, request.callerIndex, 0, context, state)
    request -> emitCallCaptureEnvironmentValues(context, state)
}
emitCallCaptureEnvironmentValues request: CallEnvironmentRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    -1 => targetFunctionIr!
    request.targetModule >= 0 and request.targetModule < (context.ranges -> len)
        -> if {
            context.ranges[request.targetModule].symbolStart + request.targetSymbol => targetGlobalSymbol
            targetGlobalSymbol >= 0 and targetGlobalSymbol < (state.frozenCaptureFunctionsBySymbol -> len)
                -> if {
                    state.frozenCaptureFunctionsBySymbol[targetGlobalSymbol] => targetFunctionIr!
                }
        }
    [Int; ~] => callCaptures!
    targetFunctionIr! >= 0 -> if {
        targetFunctionIr! -> functionCaptures(context, state) => resolvedCallCaptures
        0 => resolvedCaptureIndex!
        resolvedCaptureIndex! < (resolvedCallCaptures -> len)
            -> while {
                callCaptures! -> push(resolvedCallCaptures[resolvedCaptureIndex!])
                resolvedCaptureIndex! + 1 => resolvedCaptureIndex!
            }
    }
    request.callerIndex -> functionEnd(context, state) => callerEnd
    0 => captureIndex!
    captureIndex! < (callCaptures! -> len) -> while {
        callCaptures![captureIndex!] => bindingIndex
        context.ir[bindingIndex] => binding
        bindingIndex > request.callerIndex and bindingIndex < callerEnd and binding.kind != 10 and binding.flags == 1 and not (binding -> ownsType)
            -> if {
                bindingIndex -> mutableBindingRoot(context, state) => bindingRoot
                "  %callenv$(request.callIndex)_capture$(captureIndex!) = load " -> print
                binding -> writeIrType(context, state)
                ", ptr %slot$(bindingRoot), align " -> print
                binding -> storageAlign(context, state) -> writeDecimalLine
            }
        (binding -> ownsType) and bindingIndex > request.callerIndex and bindingIndex < callerEnd and not (binding.kind != 10 and binding.flags == 1)
            -> if {
                "  store " -> print
                binding -> writeIrType(context, state)
                " " -> print
                CaptureValueRequest { callerIndex: request.callerIndex, callIndex: request.callIndex, bindingIndex: bindingIndex, captureIndex: captureIndex! } -> emitCaptureValue(context, state)
                ", ptr %capture_borrow_binding$(bindingIndex), align " -> print
                binding -> storageAlign(context, state) -> writeDecimalLine
            }
        captureIndex! + 1 => captureIndex!
    }
}
emitCallEnvironment request: CallEnvironmentRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool uses Console {
    -1 => targetFunctionIr!
    request.targetModule >= 0 and request.targetModule < (context.ranges -> len)
        -> if {
            context.ranges[request.targetModule].symbolStart + request.targetSymbol => targetGlobalSymbol
            targetGlobalSymbol >= 0 and targetGlobalSymbol < (state.frozenCaptureFunctionsBySymbol -> len)
                -> if {
                    state.frozenCaptureFunctionsBySymbol[targetGlobalSymbol] => targetFunctionIr!
                }
        }
    [Int; ~] => callCaptures!
    targetFunctionIr! >= 0 -> if {
        targetFunctionIr! -> functionCaptures(context, state) => resolvedCallCaptures
        0 => resolvedCaptureIndex!
        resolvedCaptureIndex! < (resolvedCallCaptures -> len)
            -> while {
                callCaptures! -> push(resolvedCallCaptures[resolvedCaptureIndex!])
                resolvedCaptureIndex! + 1 => resolvedCaptureIndex!
            }
    }
    0 => captureIndex!
    captureIndex! < (callCaptures! -> len) -> while {
        callCaptures![captureIndex!] => bindingIndex
        context.ir[bindingIndex] => binding
        binding -> ownsType -> if {
            "ptr " -> print
            request.callerIndex -> functionEnd(context, state) => callerEnd
            bindingIndex > request.callerIndex and bindingIndex < callerEnd
                -> if {
                    binding.kind != 10 and binding.flags == 1 -> if {
                        bindingIndex -> mutableBindingRoot(context, state) => bindingRoot
                        "%slot$(bindingRoot)" -> print
                    } else {
                        "%capture_borrow_binding$(bindingIndex)" -> print
                    }
                } else {
                    request.callerIndex -> functionCaptures(context, state) => callerCaptures
                    -1 => capturePosition!
                    0 => callerCaptureIndex!
                    callerCaptureIndex! < (callerCaptures -> len)
                        -> while {
                            context.ir[callerCaptures[callerCaptureIndex!]].symbol == binding.symbol
                                -> if { callerCaptureIndex! => capturePosition! }
                            callerCaptureIndex! + 1 => callerCaptureIndex!
                        }
                    capturePosition! >= 0 -> if { "%capture_$(capturePosition!)" -> print } else { "null" -> print }
                }
        } else {
            binding -> writeIrType(context, state)
            " " -> print
            CaptureValueRequest { callerIndex: request.callerIndex, callIndex: request.callIndex, bindingIndex: bindingIndex, captureIndex: captureIndex! } -> emitCaptureValue(context, state)
        }
        captureIndex! + 1 < (callCaptures! -> len) or request.hasArgument
            -> if { ", " -> print }
        captureIndex! + 1 => captureIndex!
    }
    (callCaptures! -> len) > 0
}
