emitIfResultStore resultNode: typedIr.TypedIrNode, valueIndex: Int, ownerIndex: Int, ifIndex: Int, branchOrdinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    (valueIndex >= 0 and valueIndex < (context.ir -> len)) -> if {
    context.ir[valueIndex] => valueNode
    resultNode -> integerNodeWidth(context, state) => resultWidth
    valueNode -> integerNodeWidth(context, state) => valueWidth
    (resultWidth > 0 and valueWidth > 0 and resultWidth != valueWidth) -> if {
        "  %if" -> print
        ifIndex -> writeDecimal
        "_result_value" -> print
        branchOrdinal -> writeDecimal
        " = " -> print
        resultWidth < valueWidth -> if { "trunc " -> print } else {
            valueNode -> integerNodeSigned(context, state) -> if { "sext " -> print } else { "zext " -> print }
        }
        valueNode -> writeIrType(context, state)
        " " -> print
        valueIndex -> writeValue(ownerIndex, context, state)
        " to " -> print
        resultNode -> writeIrType(context, state)
        "" -> println
    }
    "  store " -> print
    resultNode -> writeIrType(context, state)
    " " -> print
