            functionIndex -> additionalParameterOrdinal(referenceValue.symbol, context, state) => referenceParameterOrdinal
            referenceParameterOrdinal >= 1 -> if {
                "%arg" -> print
                referenceParameterOrdinal -> writeDecimal
                true => wroteParameter!
            }
        }
    }
    (not wroteParameter!
        and referenceValue.kind == 13
        and referenceValue.operand0 >= 0
        and context.ir[referenceValue.operand0].typeId >= 0
        and context.types[context.ir[referenceValue.operand0].typeId].kind == 8) -> if {
        "%v$(valueIndex)_address" -> print
