            }
            ", " -> print
            capacity -> if { "2" -> println } else { "1" -> println }
            resultWidth == 32 -> if {
                capacity -> if { request.nodeIndex -> emitCapacityIntNarrowing(request.whileIndex) } else { "  %while$(request.whileIndex)_v$(request.nodeIndex) = trunc i64 %while$(request.whileIndex)_v$(request.nodeIndex)_raw to i32" -> println }
            }
        }
    }
}

isSourceTextFileIntrinsic node: typedIr.TypedIrNode -> Bool {
    node.kind == 6 and (node.opcode == -231 or node.opcode == -232 or node.opcode == -234)
}
emitSourceTextFileIntrinsic callIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[callIndex] => call
    call.opcode == -231 -> if {
        "  %v$(callIndex) = call %sollang.source_text @sollang_runtime_read_standard_input()" -> println
    }
    call.opcode == -234 and call.operand0 >= 0 -> if {
        "  %v$(callIndex) = call %sollang.source_text @sollang_runtime_read_standard_input_chunk_once(i64 " -> print
        call.operand0 -> writeValue(ownerIndex, context, state)
        ")" -> println
    }
    call.opcode == -232 and call.operand0 >= 0 -> if {
        context.ir[call.operand0] => borrowedBytes
        borrowedBytes.typeId => borrowedBytesType!
        false => borrowedBytesReference!
        borrowedBytesType! >= 0 and context.types[borrowedBytesType!].kind == 8
            -> if {
                context.types[borrowedBytesType!].first => borrowedBytesType!
                true => borrowedBytesReference!
            }
        borrowedBytesReference! -> if {
            "  %v$(callIndex)_bytes = load " -> print
            borrowedBytesType! -> writeSemanticTypeId(context, state)
            ", ptr " -> print
            call.operand0 -> writeValue(ownerIndex, context, state)
            ", align 8" -> println
        }
        "  %v$(callIndex)_data = extractvalue " -> print
        borrowedBytesType! -> writeSemanticTypeId(context, state)
        " " -> print
        borrowedBytesReference! -> if { "%v$(callIndex)_bytes" -> print } else { call.operand0 -> writeValue(ownerIndex, context, state) }
        ", 0" -> println
        "  %v$(callIndex)_length = extractvalue " -> print
        borrowedBytesType! -> writeSemanticTypeId(context, state)
        " " -> print
        borrowedBytesReference! -> if { "%v$(callIndex)_bytes" -> print } else { call.operand0 -> writeValue(ownerIndex, context, state) }
        ", 1" -> println
        "  %v$(callIndex)_value0 = insertvalue %sollang.source_text poison, ptr %v$(callIndex)_data, 0" -> println
        "  %v$(callIndex)_value1 = insertvalue %sollang.source_text %v$(callIndex)_value0, i64 %v$(callIndex)_length, 1" -> println
        "  %v$(callIndex)_value2 = insertvalue %sollang.source_text %v$(callIndex)_value1, ptr null, 2" -> println
        "  %v$(callIndex) = insertvalue %sollang.source_text %v$(callIndex)_value2, i64 0, 3" -> println
    }
}
isTextControl node: typedIr.TypedIrNode -> Bool {
    (node.kind == 18 or node.kind == 27 or node.kind == 33 or node.kind == 34)
        and node.typeOrigin == 1 and node.typeSymbol == 1
}

appendDeferredTextChoiceLeaves valueIndex: Int, leaves: mut [Int; ~], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit {
    valueIndex -> producerValueIndex(context, state) => produced
    produced -> isDeferredTextChoice(context, state)
        -> if {
            produced -> deferredTextControlValues(context, state) -> each value {
                value -> appendDeferredTextChoiceLeaves(leaves, context, state)
            }
        } else {
            false => present!
            leaves -> each leaf { leaf == produced -> if { true => present! } }
            not present! -> if { leaves -> push(produced) }
        }
}

usesDeferredScalarCapture context: ref emitterContext.EmitContext, state: ref CoreEmitterState, builtin: Int -> Bool {
    0 => leaf!
    leaf! < (state.frozenDeferredTextCaptureLeaves -> len)
        -> while {
            state.frozenDeferredTextCaptureLeaves[leaf!] and context.ir[leaf!].kind == 2
                -> if {
                    context.ir[leaf!] => value
                    value.parent => owner!
                    owner! >= 0 and context.ir[owner!].kind != 0 and context.ir[owner!].kind != 11
                        -> while { context.ir[owner!].parent => owner! }
                    value -> sourceInterpolations(context, state) => fragments
                    leaf! -> interpolatedTextRoots(context, state) => roots
                    roots -> each root {
                        root -> deferredTextCaptureType(fragments, value.sourceModule, owner!, leaf!, context, state) => typeId
                        typeId >= 0 and typeId < (context.types -> len)
                            -> if {
                                context.types[typeId] => capturedType
                                capturedType.kind == 1 and capturedType.origin == 1
                                    -> if {
                                        builtin == 23 and capturedType.symbol == 23 -> if { true -> return }
                                        builtin == 0 and (capturedType.symbol -> integerWidth(context, state)) > 0
                                            -> if { true -> return }
                                    }
                            }
                    }
                }
            leaf! + 1 => leaf!
        }
    false
}

emitCapturedTextConsoleValue prefix: Text, typeId: Int, errorOutput: Bool, newline: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    (errorOutput -> if { "sollang_runtime_eprint" } else { "sollang_runtime_print" }) => writer
    context.types[typeId] => valueType
    valueType.kind == 1 and valueType.origin == 1 and valueType.symbol == 1
        -> if {
            "  %$(prefix)_ptr = extractvalue %sollang.text %$(prefix)_value, 0" -> println
            "  %$(prefix)_len = extractvalue %sollang.text %$(prefix)_value, 1" -> println
            "  call void @$(writer)(ptr %$(prefix)_ptr, i64 %$(prefix)_len, i1 " -> print
            newline -> if { "true)" -> println } else { "false)" -> println }
            return
        }
    valueType.kind == 1 and valueType.origin == 1 and valueType.symbol == 23
        -> if {
            "  call void @$(writer)_i1(i1 %$(prefix)_value, i1 " -> print
            newline -> if { "true)" -> println } else { "false)" -> println }
            return
        }
    valueType.symbol -> integerWidth(context, state) => width!
    valueType.symbol == 12 or valueType.symbol == 13
        -> if { context.pointerBitWidth => width! }
    valueType.symbol -> integerSigned(context, state) => signed
    width! < 64 -> if {
        "  %$(prefix)_wide = " -> print
        signed -> if { "sext" -> print } else { "zext" -> print }
        " i$(width!) %$(prefix)_value to i64" -> println
    }
    "  call void @$(writer)_i64(i64 " -> print
    width! < 64 -> if { "%$(prefix)_wide" -> print } else { "%$(prefix)_value" -> print }
    ", i1 " -> print
    signed -> if { "true" -> print } else { "false" -> print }
    ", i1 " -> print
    newline -> if { "true)" -> println } else { "false)" -> println }
}

emitCapturedDeferredTextConsoleLeaf leafIndex: Int, callIndex: Int, ownerIndex: Int, errorOutput: Bool, newline: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    "deferred_console$(callIndex)_leaf$(leafIndex)" -> emitCapturedDeferredTextConsoleLeafNamed(leafIndex, ownerIndex, errorOutput, newline, context, state)
}

emitCapturedDeferredTextConsoleLeafNamed prefix: Text, leafIndex: Int, ownerIndex: Int, errorOutput: Bool, newline: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[leafIndex] => leaf
    (errorOutput -> if { "sollang_runtime_eprint" } else { "sollang_runtime_print" }) => writer
    (leaf.kind == 2 -> if { leafIndex -> interpolatedTextRoots(context, state) } else { [Int; ~] }) => roots
    (roots -> len) == 0 -> if {
        "  %$(prefix)_value = load %sollang.text, ptr %deferred_text$(leafIndex)_value_slot, align 8" -> println
        1 -> interpolationBuiltinTypeId(context) => textType
        prefix -> emitCapturedTextConsoleValue(textType, errorOutput, newline, context, state)
        return
    }
    leaf -> sourceInterpolations(context, state) => fragments
    UIntSize(0) => suffixStart!
    roots -> each root {
        fragments[root] => fragment
        "  %$(prefix)_literal$(root) = getelementptr i8, ptr @sollang_str_$(leafIndex), i64 $(fragment.literalStart)" -> println
        "  call void @$(writer)(ptr %$(prefix)_literal$(root), i64 $(fragment.literalLength), i1 false)" -> println
        root -> deferredTextCaptureType(fragments, leaf.sourceModule, ownerIndex, leafIndex, context, state) => typeId
        "  %$(prefix)_root$(root)_value = load " -> print
        typeId -> writeSemanticTypeId(context, state)
        ", ptr %deferred_text$(leafIndex)_root$(root)_slot, align $(context.typeAligns[typeId])" -> println
        "$(prefix)_root$(root)" -> emitCapturedTextConsoleValue(typeId, errorOutput, false, context, state)
        fragment.expressionStart + fragment.expressionLength + 1 => suffixStart!
    }
    leaf -> sourceToken(context, state) => token
    TextLiteralRequest { sourceModule: leaf.sourceModule, token: token } -> textLiteralLength(context, state) => rawLength
    rawLength - suffixStart! => suffixLength
    "  %$(prefix)_suffix = getelementptr i8, ptr @sollang_str_$(leafIndex), i64 $(suffixStart!)" -> println
    "  call void @$(writer)(ptr %$(prefix)_suffix, i64 $(suffixLength), i1 " -> print
    newline -> if { "true)" -> println } else { "false)" -> println }
}

emitDeferredTextConsole callIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool uses Console {
    context.ir[callIndex] => call
    (call.symbol == -101 or call.symbol == -102 or call.symbol == -116 or call.symbol == -117)
        and call.operand0 >= 0 -> unless { false -> return }
    callIndex -> callArgumentIndex(context, state) -> producerValueIndex(context, state) => choice
    choice -> isDeferredTextChoice(context, state)
        -> unless { false -> return }
    [Int; ~] => leaves!
    choice -> appendDeferredTextChoiceLeaves(leaves!, context, state)
    "  %deferred_console$(callIndex)_tag = load i64, ptr %deferred_text$(choice)_tag, align 8" -> println
    leaves! -> each leaf {
        "  %deferred_console$(callIndex)_is$(leaf) = icmp eq i64 %deferred_console$(callIndex)_tag, $(leaf)" -> println
        "  br i1 %deferred_console$(callIndex)_is$(leaf), label %deferred_console$(callIndex)_leaf$(leaf), label %deferred_console$(callIndex)_next$(leaf)" -> println
        "deferred_console$(callIndex)_leaf$(leaf):" -> println
        leaf -> emitCapturedDeferredTextConsoleLeaf(callIndex, ownerIndex, call.symbol == -116 or call.symbol == -117, call.symbol == -102 or call.symbol == -116, context, state)
        "  br label %deferred_console$(callIndex)_end" -> println
        "deferred_console$(callIndex)_next$(leaf):" -> println
    }
    "  call void @llvm.trap()" -> println
    "  unreachable" -> println
    "deferred_console$(callIndex)_end:" -> println
    true
}

isDeferredTextChoice valueIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    valueIndex >= 0 and valueIndex < (state.frozenDeferredTextValues -> len)
        and state.frozenDeferredTextValues[valueIndex]
        and (context.ir[valueIndex] -> isTextControl)
}

deferredTextControlValues controlIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> [Int; ~] {
    [Int; ~] => values!
    state.frozenFirstIrChildByParent[controlIndex] => child!
    child! >= 0 -> while {
        context.ir[child!].kind == 19 -> if {
            -1 => result!
            context.ir[controlIndex].kind == 27
                -> if { child! -> matchRegionResultValueIndex(context, state) => result! } else {
                    context.ir[controlIndex].kind == 33 or context.ir[controlIndex].kind == 34
                        -> if {
                            child! => region!
                            context.ir[child!] -> sourceNode(context, state) => armSource
                            (context.ir[controlIndex].kind == 33 and armSource.kind == 58)
                                or (context.ir[controlIndex].kind == 34 and context.ir[child!].operand1 >= 0 and context.ir[context.ir[child!].operand1].kind == 19)
                                -> if { context.ir[child!].operand1 => region! }
                            region! -> subjectWhenArmResultValueIndex(context, state) => result!
                        } else { child! -> regionResultValueIndex(context, state) => result! }
                }
            result! >= 0 -> if {
                result! -> producerValueIndex(context, state) => produced
                produced >= 0 -> if { values! -> push(produced) }
            }
        }
        state.frozenNextIrSiblingByNode[child!] => child!
    }
    values!
}

prepareDeferredTextValues context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> [Bool; ~] {
    [Bool; ~] => tokens!
    0 => token!
    token! < (context.tokens -> len) -> while {
        tokens! -> push(false)
        token! + 1 => token!
    }
    context.interpolationRanges -> each range {
        range.nodeStart => node!
        node! < range.nodeStart + range.nodeCount -> while {
            context.interpolations[node!] => fragment
            fragment.parent < 0 -> if {
                true => tokens![context.ranges[range.sourceModule].tokenStart + fragment.sourceToken]
            }
            node! + 1 => node!
        }
    }
    [Bool; ~] => values!
    context.ir -> each node {
        false => deferred!
        node.kind == 2 and node.payloadToken >= 0 -> if {
            tokens![context.ranges[node.sourceModule].tokenStart + node.payloadToken] => deferred!
        }
        values! -> push(deferred!)
    }
    true => changed!
    changed! -> while {
        false => changed!
        Int(context.ir -> len) - 1 => index!
        index! >= 0 -> while {
            not values![index!] and (context.ir[index!] -> isTextControl)
                -> if {
                    index! -> deferredTextControlValues(context, state) -> each value {
                        values![value] -> if {
                            true => values![index!]
                            true => changed!
                        }
                    }
                }
            index! - 1 => index!
        }
    }
    values!
}

appendDeferredTextCaptureLeaves valueIndex: Int, leaves: mut [Bool; ~], context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit {
    valueIndex -> producerValueIndex(context, state) => produced
    produced < 0 -> if { return }
    produced -> isDeferredTextChoice(context, state)
        -> if {
            produced -> deferredTextControlValues(context, state) -> each value {
                value -> appendDeferredTextCaptureLeaves(leaves, context, state)
            }
        } else { true => leaves[produced] }
}

prepareDeferredTextCaptureLeaves context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> [Bool; ~] {
    [Bool; ~] => leaves!
    0 => index!
    index! < (context.ir -> len) -> while {
        leaves! -> push(false)
        index! + 1 => index!
    }
    0 => index!
    index! < (context.ir -> len) -> while {
        index! -> isDeferredTextChoice(context, state)
            -> if {
                index! -> appendDeferredTextCaptureLeaves(leaves!, context, state)
            }
        index! + 1 => index!
    }
    leaves!
}

deferredTextCaptureType root: Int, fragments: ref [interpolation.InterpolationNode; ~], sourceModule: Int, ownerIndex: Int, leafIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    root -> interpolationNodeTypeId(fragments, sourceModule, ownerIndex, leafIndex, context, state) => typeId
    context.types -> typeIds.materializedReadTypeId(typeId)
}

emitDeferredTextCaptureAllocas valueIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    valueIndex -> isDeferredTextChoice(context, state)
        -> if {
            "  %deferred_text$(valueIndex)_tag = alloca i64, align 8" -> println
        }
    state.frozenDeferredTextCaptureLeaves[valueIndex]
        -> unless { return }
    context.ir[valueIndex] => value
    value.kind == 2 -> if {
        valueIndex -> interpolatedTextRoots(context, state) => roots
        (roots -> len) > 0 -> if {
            value -> sourceInterpolations(context, state) => fragments
            0 => scratchNodeIndex!
            scratchNodeIndex! < (fragments -> len) -> while {
                fragments[scratchNodeIndex!].sourceToken == value.payloadToken
                    -> if {
                        valueIndex -> emitInterpolationFixedAllocas(scratchNodeIndex!, fragments,
                        value.sourceModule, ownerIndex, valueIndex, context, state)
                    }
                scratchNodeIndex! + 1 => scratchNodeIndex!
            }
            roots -> each root {
                root -> deferredTextCaptureType(fragments, value.sourceModule, ownerIndex, valueIndex, context, state) => typeId
                "  %deferred_text$(valueIndex)_root$(root)_slot = alloca " -> print
                typeId -> writeSemanticTypeId(context, state)
                ", align $(context.typeAligns[typeId])" -> println
            }
            return
        }
    }
    "  %deferred_text$(valueIndex)_value_slot = alloca %sollang.text, align 8" -> println
}

deferredTextCaptureDiagnosticCount context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int uses Console {
    0 => leaf!
    leaf! < (context.ir -> len) -> while {
        state.frozenDeferredTextCaptureLeaves[leaf!] and context.ir[leaf!].kind == 2
            -> if {
                context.ir[leaf!] => value
                value.parent => owner!
                owner! >= 0 and context.ir[owner!].kind != 0 and context.ir[owner!].kind != 11
                    -> while { context.ir[owner!].parent => owner! }
                value -> sourceInterpolations(context, state) => fragments
                leaf! -> interpolatedTextRoots(context, state) => roots
                0 => ordinal!
                ordinal! < (roots -> len) -> while {
                    roots[ordinal!] -> deferredTextCaptureType(fragments, value.sourceModule, owner!, leaf!, context, state) => typeId
                    typeId < 0 or typeId >= (context.types -> len)
                        -> if {
                            "; sollang internal invariant: deferred Text capture has no canonical materialized type (ir $(leaf!), fragment $(roots[ordinal!])); this is a compiler-integrity defect" -> println
                            1 -> return
                        }
                    context.types[typeId] => captureType
                    captureType.symbol -> integerWidth(context, state) => captureWidth
                    captureType.kind == 1 and captureType.origin == 1
                        and (captureType.symbol == 1 or captureType.symbol == 23 or (captureWidth > 0 and captureWidth <= 64))
                        -> unless {
                            "; sollang internal invariant: deferred Text capture has no typed consumer writer (ir $(leaf!), fragment $(roots[ordinal!]), type $(typeId)); this is a compiler-integrity defect" -> println
                            1 -> return
                        }
                    ordinal! + 1 => ordinal!
                }
            }
        leaf! + 1 => leaf!
    }
    0
}

emitDeferredTextCaptureStore valueIndex: Int, ownerIndex: Int, controlIndex: Int, branchOrdinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    valueIndex -> producerValueIndex(context, state) => produced
    produced -> isDeferredTextChoice(context, state)
        -> if {
            "  %deferred_text$(controlIndex)_tag$(branchOrdinal) = load i64, ptr %deferred_text$(produced)_tag, align 8" -> println
            "  store i64 %deferred_text$(controlIndex)_tag$(branchOrdinal), ptr %deferred_text$(controlIndex)_tag, align 8" -> println
            return
        }
    context.ir[produced] => value
    (value.kind == 2 -> if { produced -> interpolatedTextRoots(context, state) } else { [Int; ~] }) => roots
    (roots -> len) > 0 -> if {
        value -> sourceInterpolations(context, state) => fragments
        roots -> each root {
            fragments -> interpolationEmissionOrder(value.payloadToken, fragments[root].segment) => order
            order -> each node {
                node -> interpolationHasLogicalAncestor(fragments)
                    -> unless {
                        fragments[node].kind == 3 and (fragments[node].opcode == -24 or fragments[node].opcode == -25)
                            -> if { produced -> emitInterpolationSubtree(node, fragments, value.sourceModule, ownerIndex, produced, true, context, state) } else {
                                produced -> emitInterpolationIntrinsic(node, fragments, value.sourceModule, ownerIndex, produced, true, context, state)
                                produced -> emitInterpolationOperation(node, fragments, value.sourceModule, ownerIndex, produced, context, state)
                            }
                    }
            }
            root -> interpolationReferenceValueTypeId(fragments, value.sourceModule, ownerIndex, produced, context, state) => referenceType
            referenceType >= 0 -> if {
                produced -> emitInterpolationReferenceValue(root, referenceType, fragments, value.sourceModule, ownerIndex, produced, context, state)
            }
            root -> deferredTextCaptureType(fragments, value.sourceModule, ownerIndex, produced, context, state) => typeId
            "  store " -> print
            typeId -> writeSemanticTypeId(context, state)
            " " -> print
            referenceType >= 0 -> if { "%v$(produced)_expression$(root)_reference_value" -> print } else { produced -> writeInterpolationValue(root, fragments, value.sourceModule, ownerIndex, produced, context, state) }
            ", ptr %deferred_text$(produced)_root$(root)_slot, align $(context.typeAligns[typeId])" -> println
        }
    } else {
        "  store %sollang.text " -> print
        produced -> writeValue(ownerIndex, context, state)
        ", ptr %deferred_text$(produced)_value_slot, align 8" -> println
    }
    "  store i64 $(produced), ptr %deferred_text$(controlIndex)_tag, align 8" -> println
}

emitIfResultStore resultNode: typedIr.TypedIrNode, valueIndex: Int, ownerIndex: Int, ifIndex: Int, branchOrdinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    ifIndex -> isDeferredTextChoice(context, state)
        -> if {
            valueIndex -> emitDeferredTextCaptureStore(ownerIndex, ifIndex, branchOrdinal, context, state)
            "  store %sollang.text poison, ptr %if$(ifIndex)_result, align " -> print
            resultNode -> storageAlign(context, state) -> writeDecimalLine
            return
        }
    valueIndex >= 0 and valueIndex < (context.ir -> len)
        -> if {
            context.ir[valueIndex] => valueNode
            false => fixedBranchCopied!
            # Fixed branch results have one owned backing contract on every arm.
            # Reuse a fresh local owner; copy borrowed storage and outer bindings.
            resultNode.kind == 18 and resultNode.typeId >= 0
                and context.types[resultNode.typeId].kind == 4
                -> if {
                    (branchOrdinal == 0 -> if { resultNode.operand1 } else { resultNode.nextOperand }) => branchRegion
                    valueIndex -> fixedBranchTransferredBacking(branchRegion, context, state) => transferredBacking
                    transferredBacking < 0 -> if {
                        "  %if$(ifIndex)_fixed$(branchOrdinal)_source = extractvalue %sollang.int_slice " -> print
                        valueIndex -> writeValue(ownerIndex, context, state)
                        ", 0" -> println
                        "  %if$(ifIndex)_fixed$(branchOrdinal)_data = call ptr @sollang_alloc(i64 $(context.typeSizes[resultNode.typeId]))" -> println
                        "  call void @llvm.memcpy.p0.p0.i64(ptr %if$(ifIndex)_fixed$(branchOrdinal)_data, ptr %if$(ifIndex)_fixed$(branchOrdinal)_source, i64 $(context.typeSizes[resultNode.typeId]), i1 false)" -> println
                        "  %if$(ifIndex)_fixed$(branchOrdinal)_0 = insertvalue %sollang.int_slice poison, ptr %if$(ifIndex)_fixed$(branchOrdinal)_data, 0" -> println
                        "  %if$(ifIndex)_fixed$(branchOrdinal) = insertvalue %sollang.int_slice %if$(ifIndex)_fixed$(branchOrdinal)_0, i64 $(context.types[resultNode.typeId].length), 1" -> println
                        true => fixedBranchCopied!
                    }
                }
            resultNode -> integerNodeWidth(context, state) => resultWidth
            valueNode -> integerNodeWidth(context, state) => valueWidth
            resultWidth > 0 and valueWidth > 0 and resultWidth != valueWidth
                -> if {
                    "  %if" -> print
                    ifIndex -> writeDecimal
                    "_result_value" -> print
                    branchOrdinal -> writeDecimal
                    " = " -> print
                    resultWidth < valueWidth -> if { "trunc " -> print } else {
                        valueNode -> integerNodeSigned(context, state)
                            -> if { "sext " -> print } else { "zext " -> print }
                    }
                    valueNode -> writeIrType(context, state)
                    " " -> print
                    valueIndex -> writeValue(ownerIndex, context, state)
                    " to " -> print
                    resultNode -> writeIrType(context, state)
                    "" -> println
                }
            "  store " -> print
            resultNode -> writeIrType(context, state)
            " " -> print
            fixedBranchCopied! -> if {
                "%if$(ifIndex)_fixed$(branchOrdinal)" -> print
            } else {
                resultWidth > 0 and valueWidth > 0 and resultWidth != valueWidth
                    -> if {
                        "%if" -> print
                        ifIndex -> writeDecimal
                        "_result_value" -> print
                        branchOrdinal -> writeDecimal
                    } else {
                        valueIndex -> writeValue(ownerIndex, context, state)
                    }
            }
            ", ptr %if" -> print
            ifIndex -> writeDecimal
            "_result, align " -> print
            resultNode -> storageAlign(context, state) -> writeDecimalLine
        } else {
            "; sollang compiler error S025: value-producing control result store has no concrete source value (control $ifIndex, kind $(resultNode.kind), branch $branchOrdinal, value $valueIndex, source $(resultNode.sourceModule), ast $(resultNode.astNode))" -> println
        }
}
isOwnedFileType typeId: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => owned!
    typeId >= 0 and typeId < (context.types -> len)
        -> if {
            context.types[typeId] => candidate
            candidate.kind == 1 and (candidate.origin == 0 or candidate.origin == 2) and candidate.module >= 0
                -> if {
                    false => fileModule!
                    0 => moduleSearch!
                    moduleSearch! < (context.modules -> len) -> while {
                        context.modules[moduleSearch!] => moduleIdentity
                        moduleIdentity.sourceIndex == candidate.module and moduleIdentity.pathHash == 1560534979202565016
                            and modules.logicalNameIs(context.sources[candidate.module], moduleIdentity, context.ranges[candidate.module], context.tokens, "sys.file")
                            -> if { true => fileModule! }
                        moduleSearch! + 1 => moduleSearch!
                    }
                    fileModule! -> if {
                        context.ranges[candidate.module] => candidateRange
                        candidate.symbol >= 0 and candidate.symbol < candidateRange.symbolCount
                            -> if {
                                context.symbols[candidateRange.symbolStart + candidate.symbol] => candidateSymbol
                                context.tokens[candidateRange.tokenStart + candidateSymbol.nameToken] => candidateName
                                candidateName.span.length == 4 -> if {
                                    (context.sources[candidate.module] -> byte(candidateName.span.start)) == 70 and (context.sources[candidate.module] -> byte(candidateName.span.start + 1)) == 105 and (context.sources[candidate.module] -> byte(candidateName.span.start + 2)) == 108 and (context.sources[candidate.module] -> byte(candidateName.span.start + 3)) == 101
                                        -> if { true => owned! }
                                }
                                candidateName.span.length == 10 -> if {
                                    (context.sources[candidate.module] -> byte(candidateName.span.start)) == 70 and (context.sources[candidate.module] -> byte(candidateName.span.start + 1)) == 105 and (context.sources[candidate.module] -> byte(candidateName.span.start + 2)) == 108 and (context.sources[candidate.module] -> byte(candidateName.span.start + 3)) == 101 and (context.sources[candidate.module] -> byte(candidateName.span.start + 4)) == 87 and (context.sources[candidate.module] -> byte(candidateName.span.start + 5)) == 114 and (context.sources[candidate.module] -> byte(candidateName.span.start + 6)) == 105 and (context.sources[candidate.module] -> byte(candidateName.span.start + 7)) == 116 and (context.sources[candidate.module] -> byte(candidateName.span.start + 8)) == 101 and (context.sources[candidate.module] -> byte(candidateName.span.start + 9)) == 114
                                        -> if { true => owned! }
                                }
                            }
                    }
                }
        }
    owned!
}
referencePlaceRootBinding placeIndex: Int, context: ref emitterContext.EmitContext -> Int {
    placeIndex => root!
    root! >= 0 and (context.ir[root!].kind == 13 or context.ir[root!].kind == 15)
        -> while {
            context.ir[root!].operand0 => root!
        }
    root! >= 0 and context.ir[root!].kind == 17
        -> if {
            root!
        } else {
            root! >= 0 and context.ir[root!].kind == 5 and context.ir[root!].operand0 >= 0
                -> if {
                    context.ir[root!].operand0
                } else { -1 }
        }
}
referencePlaceRootBindingForOwner placeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext -> Int {
    placeIndex -> referencePlaceRootBinding(context) => resolvedRoot
    resolvedRoot >= 0 and context.ir[resolvedRoot].kind != 5
        -> if { resolvedRoot } else {
            placeIndex + 0 => rootRead!
            resolvedRoot >= 0 -> if { resolvedRoot => rootRead! }
            rootRead! >= 0 and (context.ir[rootRead!].kind == 13 or context.ir[rootRead!].kind == 15)
                -> while {
                    context.ir[rootRead!].operand0 => rootRead!
                }
            -1 => parameterRoot!
            rootRead! >= 0
                and context.ir[rootRead!].kind == 5
                and ownerIndex >= 0
                and (context.ir[ownerIndex].kind == 0 or context.ir[ownerIndex].kind == 11)
                -> if {
                    context.ir[ownerIndex].operand1 + 0 => parameterSearch!
                    true => primaryParameter!
                    parameterSearch! >= 0 -> while {
                        context.ir[parameterSearch!].symbol == context.ir[rootRead!].symbol
                            -> if {
                                parameterSearch! => parameterRoot!
                                -1 => parameterSearch!
                            } else {
                                primaryParameter! -> if {
                                    context.ir[ownerIndex].nextOperand => parameterSearch!
                                    false => primaryParameter!
                                } else {
                                    context.ir[parameterSearch!].nextOperand => parameterSearch!
                                }
                            }
                    }
                }
            parameterRoot!
        }
}
referencePlaceRootBindingForEmission placeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    placeIndex -> referencePlaceRootBindingForOwner(ownerIndex, context) => root!
    root! < 0
        and ownerIndex >= 0
        and (context.ir[ownerIndex].kind == 0 or context.ir[ownerIndex].kind == 11)
        -> if {
            placeIndex => rootRead!
            rootRead! >= 0 and (context.ir[rootRead!].kind == 13 or context.ir[rootRead!].kind == 15)
                -> while { context.ir[rootRead!].operand0 => rootRead! }
            rootRead! >= 0 and context.ir[rootRead!].kind == 5
                -> if {
                    (rootRead! -> directEachRoleAddressOwner(context, state)) >= 0
                        -> if { rootRead! => root! }
                    state.frozenFunctionCaptureOffsets[ownerIndex] => captureOffset
                    0 => captureIndex!
                    captureIndex! < state.frozenFunctionCaptureCounts[ownerIndex] and root! < 0
                        -> while {
                            state.frozenFunctionCaptureValues[captureOffset + captureIndex!] => captureBinding
                            context.ir[captureBinding] => capturedRoot
                            capturedRoot.sourceModule == context.ir[rootRead!].sourceModule
                                and capturedRoot.symbol == context.ir[rootRead!].symbol
                                -> if { captureBinding => root! }
                            captureIndex! + 1 => captureIndex!
                        }
                }
        }
    root!
}
isMutablePlaceRead placeIndex: Int, ownerStart: Int, ownerEnd: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    placeIndex => root!
    root! >= 0 and (context.ir[root!].kind == 13 or context.ir[root!].kind == 15)
        -> while {
            context.ir[root!].operand0 => root!
        }
    false => mutable!
    root! >= ownerStart and root! < ownerEnd and context.ir[root!].kind == 17 and context.ir[root!].flags == 1
        -> if {
            true => mutable!
        }
    root! >= ownerStart and root! < ownerEnd and context.ir[root!].kind == 5
        -> if {
            context.ir[root!] => rootName
            false => exactMutableReadBinding!
            rootName.operand0 >= ownerStart and rootName.operand0 < ownerEnd and context.ir[rootName.operand0].kind == 17
                -> if {
                    true => exactMutableReadBinding!
                    context.ir[rootName.operand0].flags == 1 -> if { true => mutable! }
                }
            not exactMutableReadBinding! -> if {
                ownerStart => mutableBindingSearch!
                not mutable! and mutableBindingSearch! < ownerEnd
                    -> while {
                        context.ir[mutableBindingSearch!] => mutableBinding
                        mutableBinding.kind == 17 and mutableBinding.flags == 1 and rootName.payloadToken >= 0 and mutableBinding.payloadToken >= 0
                            -> if {
                                rootName.sourceModule -> sourceTokensEqual(rootName.payloadToken, mutableBinding.sourceModule, mutableBinding.payloadToken, context, state)
                                    -> if {
                                        true => mutable!
                                    }
                            }
                        mutableBindingSearch! + 1 => mutableBindingSearch!
                    }
            }
        }
    mutable!
}
# Follow value-preserving wrappers and readonly bindings to the aggregate that
# owns the storage. Aggregate constructors transfer that storage into their
# result; cleanup must therefore reason about the source aggregate rather than
# the final freeze/name wrapper used by LLVM emission.
ownedValueSourceIndex valueIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    valueIndex -> aggregateValueIndex(context, state) => resolved!
    true => searching!
    searching! -> while {
        false => searching!
        context.ir[resolved!] => candidate
        -1 => next!
        (resolved! -> bindingFixedStorageCopyTypeId(context)) >= 0 => copiedBindingSource
        copiedBindingSource -> if { candidate.parent => next! }
        candidate.kind == 36 and candidate.operand0 >= 0
            -> if {
                candidate.operand0 => next!
            }
        not copiedBindingSource and candidate.kind == 5 and candidate.operand0 >= 0 and context.ir[candidate.operand0].kind == 17 and context.ir[candidate.operand0].operand0 >= 0
            -> if {
                (candidate.operand0 -> fixedResultPropagationBinding(context, state))
                    or (context.ir[candidate.operand0].operand0 -> bindingFixedStorageCopyTypeId(context)) >= 0
                    -> if { candidate.operand0 => next! } else {
                        context.ir[candidate.operand0].operand0 => next!
                    }
            }
        candidate.kind == 17 and candidate.operand0 >= 0
            and not (resolved! -> fixedResultPropagationBinding(context, state))
            and (candidate.operand0 -> bindingFixedStorageCopyTypeId(context)) < 0
            -> if {
                candidate.operand0 => next!
            }
        next! >= 0 -> if {
            next! -> aggregateValueIndex(context, state) => canonicalNext
            canonicalNext != resolved! -> if {
                canonicalNext => resolved!
                true => searching!
            }
        }
    }
    resolved!
}

# Resolve the owning local carried by a returned value. Enum constructors and
# value-preserving wrappers transfer their payload into the returned aggregate,
# so cleanup on that return edge must exclude the original binding.
returnedOwnedBindingIndex valueIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    valueIndex => resolved!
    -1 => bindingIndex!
    true => searching!
    searching! and resolved! >= 0 -> while {
        false => searching!
        resolved! -> aggregateValueIndex(context, state) => aggregateIndex
        aggregateIndex != resolved! -> if {
            aggregateIndex => resolved!
            true => searching!
        } else {
            context.ir[resolved!] => candidate
            candidate.kind == 26 and candidate.operand0 >= 0
                -> if {
                    candidate.operand0 => resolved!
                    true => searching!
                } else {
                    candidate.kind == 36 and candidate.operand0 >= 0
                        -> if {
                            candidate.operand0 => resolved!
                            true => searching!
                        } else {
                            candidate.kind == 5 and candidate.operand0 >= 0 and context.ir[candidate.operand0].kind == 17
                                -> if {
                                    candidate.operand0 -> mutableBindingRoot(context, state) => bindingIndex!
                                }
                            candidate.kind == 17 -> if {
                                resolved! -> mutableBindingRoot(context, state) => bindingIndex!
                            }
                        }
                }
        }
    }
    bindingIndex!
}
producerValueIndex sourceIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    sourceIndex -> aggregateValueIndex(context, state) => resolved!
    true => searching!
    searching! and resolved! >= 0 and resolved! < (context.ir -> len)
        -> while {
            false => searching!
            context.ir[resolved!] => value
            value.kind == 5 and value.operand0 >= 0 and value.operand0 < (context.ir -> len)
                -> if {
                    context.ir[value.operand0] => binding
                    binding.kind == 17 and binding.flags != 1 and binding.operand0 >= 0
                        -> if {
                            binding.operand0 -> aggregateValueIndex(context, state) => resolved!
                            true => searching!
                        }
                }
            value.kind == 17 and value.flags != 1 and value.operand0 >= 0
                -> if {
                    value.operand0 -> aggregateValueIndex(context, state) => resolved!
                    true => searching!
                }
        }
    resolved!
}

callArgumentIndex callIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.ir[callIndex] => call
    call.operand0 -> aggregateValueIndex(context, state) => firstArgumentIndex
    firstArgumentIndex => argumentIndex!
    call.operand1 >= 0 -> if {
        call.operand1 -> aggregateValueIndex(context, state) => secondArgumentIndex
        secondArgumentIndex > argumentIndex! -> if { secondArgumentIndex => argumentIndex! }
    }
    argumentIndex! -> typedIr.userBlockLiteralInput(context.ir)
}
directRegionResultValueIndex regionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.ir[regionIndex].operand1 => resolved!
    true => resolving!
    resolving! -> while {
        false => resolving!
        resolved! >= 0 and context.ir[resolved!].kind == 17 and context.ir[resolved!].operand0 >= 0
            -> if {
                context.ir[resolved!].operand0 => resolved!
                true => resolving!
            }
        resolved! -> aggregateValueIndex(context, state) => aggregateResolved
        aggregateResolved != resolved! -> if {
            aggregateResolved => resolved!
            true => resolving!
        }
    }
    # A block-bodied region can name its block wrapper rather than its final
    # value. Preserve a directly nested value-control merge instead of letting
    # the generic block writer fall through to the block's first child (often
    # the control condition).
    resolved! -> directBlockResultControlIndex(regionIndex, context, state) => blockControlResult
    blockControlResult >= 0 -> if { blockControlResult => resolved! }
    # A region operand can still name a leaf inside a nested value-producing
    # control. Select that control only when it is the region's direct child;
    # this preserves the nested merge value without escaping into an enclosing
    # match or when arm.
    resolved! => directAncestor!
    -1 => directControlAncestor!
    true => directAncestorOpen!
    directAncestor! >= 0 and directAncestorOpen!
        -> while {
            context.ir[directAncestor!] => directCandidate
            false => directCandidateTypeMatches!
            context.ir[regionIndex].typeId >= 0
                and directCandidate.typeId == context.ir[regionIndex].typeId
                -> if { true => directCandidateTypeMatches! }
            context.ir[regionIndex].typeId < 0
                and directCandidate.typeId < 0
                and directCandidate.typeKind == context.ir[regionIndex].typeKind
                and directCandidate.typeOrigin == context.ir[regionIndex].typeOrigin
                and directCandidate.typeModule == context.ir[regionIndex].typeModule
                and directCandidate.typeSymbol == context.ir[regionIndex].typeSymbol
                -> if { true => directCandidateTypeMatches! }
            (directCandidate.kind == 18
                or directCandidate.kind == 20
                or directCandidate.kind == 27
                or directCandidate.kind == 33
                or directCandidate.kind == 34)
                and directCandidateTypeMatches!
                -> if { directAncestor! => directControlAncestor! }
            context.ir[directAncestor!].parent => directParent
            directParent == regionIndex -> if {
                directControlAncestor! >= 0
                    -> if { directControlAncestor! => resolved! }
                false => directAncestorOpen!
            } else {
                directParent < 0 -> if {
                    false => directAncestorOpen!
                } else {
                    directParent => directAncestor!
                }
            }
        }
    resolved!
}
dominatingRegionResultValueIndex valueIndex: Int, regionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    valueIndex => resolved!
    # A region can record a leaf result. When that leaf is produced inside a
    # nested value-control expression, users outside the control flow must
    # consume the control node's merge value instead of a branch-local leaf.
    resolved! => resultAncestor!
    resultAncestor! >= 0 and resultAncestor! != regionIndex
        -> while {
            context.ir[resultAncestor!].parent => resultParent
            resultParent >= 0 and resultParent != regionIndex
                -> if {
                    context.ir[resultParent] => resultParentNode
                    false => resultParentTypeMatches!
                    context.ir[regionIndex].typeId >= 0 and resultParentNode.typeId == context.ir[regionIndex].typeId
                        -> if { true => resultParentTypeMatches! }
                    context.ir[regionIndex].typeId < 0
                        and resultParentNode.typeId < 0
                        and resultParentNode.typeKind == context.ir[regionIndex].typeKind
                        and resultParentNode.typeOrigin == context.ir[regionIndex].typeOrigin
                        and resultParentNode.typeModule == context.ir[regionIndex].typeModule
                        and resultParentNode.typeSymbol == context.ir[regionIndex].typeSymbol
                        -> if { true => resultParentTypeMatches! }
                    (resultParentNode.kind == 18
                        or resultParentNode.kind == 27
                        or resultParentNode.kind == 33
                        or resultParentNode.kind == 34)
                        and resultParentTypeMatches!
                        -> if { resultParent => resolved! }
                }
            resultParent => resultAncestor!
        }
    resolved!
}
regionResultValueIndex regionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    regionIndex -> directRegionResultValueIndex(context, state) => resolved
    resolved -> dominatingRegionResultValueIndex(regionIndex, context, state)
}
matchRegionResultValueIndex regionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.ir[regionIndex] => matchArm
    matchArm.operand1 => resolved!
    matchArm.operand1 >= 0 and context.ir[matchArm.operand1].kind == 19
        -> if {
            matchArm.operand1 -> directRegionResultValueIndex(context, state) => resolved!
        } else {
            # Expression-bodied enum arms store the matched payload binding in
            # operand1. The computed arm value is the final direct child after the
            # pattern and payload, not the payload itself.
            regionIndex + 1 => armChildSearch!
            regionIndex => armOwner!
            armOwner! >= 0 and context.ir[armOwner!].kind != 0 and context.ir[armOwner!].kind != 11
                -> while {
                    context.ir[armOwner!].parent => armOwner!
                }
            context.ir -> len => armChildEnd!
            armOwner! >= 0 -> if { armOwner! -> functionEnd(context, state) => armChildEnd! }
            armChildSearch! < armChildEnd! -> while {
                context.ir[armChildSearch!] => armChild
                false => armChildMatchesResultType!
                matchArm.typeId >= 0 and armChild.typeId == matchArm.typeId
                    -> if {
                        true => armChildMatchesResultType!
                    }
                matchArm.typeId < 0
                    and armChild.typeId < 0
                    and armChild.typeKind == matchArm.typeKind
                    and armChild.typeOrigin == matchArm.typeOrigin
                    and armChild.typeModule == matchArm.typeModule
                    and armChild.typeSymbol == matchArm.typeSymbol
                    -> if {
                        true => armChildMatchesResultType!
                    }
                armChild.parent == regionIndex
                    and armChildSearch! != matchArm.operand0
                    and armChildSearch! != matchArm.operand1
                    and armChildMatchesResultType! -> if {
                        armChildSearch! => resolved!
                    }
                armChildSearch! + 1 => armChildSearch!
            }
        }
    # A block-bodied arm reaches this point through the branch above after
    # `directRegionResultValueIndex`. Its expression root can still precede
    # the selected leaf in Typed IR (operator 10 consumes conversion 11, for
    # example), so root selection must not be limited to expression-bodied
    # arms. Follow same-typed consumers across the owning function for both
    # representations.
    regionIndex => commonArmOwner!
    commonArmOwner! >= 0 and context.ir[commonArmOwner!].kind != 0 and context.ir[commonArmOwner!].kind != 11
        -> while { context.ir[commonArmOwner!].parent => commonArmOwner! }
    context.ir -> len => commonArmEnd!
    commonArmOwner! >= 0 -> if { commonArmOwner! -> functionEnd(context, state) => commonArmEnd! }
    resolved! >= 0 and resolved! < (context.ir -> len) => commonArmRootOpen!
    commonArmRootOpen! -> while {
        false => commonArmRootOpen!
        regionIndex + 1 => commonArmRootSearch!
        commonArmRootSearch! < commonArmEnd! -> while {
            context.ir[commonArmRootSearch!] => commonArmRootCandidate
            false => commonArmRootMatchesResultType!
            context.ir[resolved!].typeId >= 0 and commonArmRootCandidate.typeId == context.ir[resolved!].typeId
                -> if { true => commonArmRootMatchesResultType! }
            context.ir[resolved!].typeId < 0
                and commonArmRootCandidate.typeId < 0
                and commonArmRootCandidate.typeKind == context.ir[resolved!].typeKind
                and commonArmRootCandidate.typeOrigin == context.ir[resolved!].typeOrigin
                and commonArmRootCandidate.typeModule == context.ir[resolved!].typeModule
                and commonArmRootCandidate.typeSymbol == context.ir[resolved!].typeSymbol
                -> if { true => commonArmRootMatchesResultType! }
            commonArmRootSearch! != resolved!
                and commonArmRootMatchesResultType!
                and commonArmRootCandidate.kind != 17
                and commonArmRootCandidate.kind != 19
                and (commonArmRootCandidate.operand0 == resolved!
                or commonArmRootCandidate.operand1 == resolved!)
                -> if {
                    commonArmRootSearch! => resolved!
                    true => commonArmRootOpen!
                }
            commonArmRootSearch! + 1 => commonArmRootSearch!
        }
    }
    resolved! -> aggregateValueIndex(context, state) => aggregateResolved
    aggregateResolved -> dominatingRegionResultValueIndex(regionIndex, context, state) => dominatingResolved!
    dominatingResolved! < 0 -> if {
        regionIndex -> matchArmBindingValueIndex(context, state) => armBindingIndex
        armBindingIndex >= 0 -> if {
            context.ir[armBindingIndex] => armBinding
            context.ir[regionIndex].parent => matchIndex
            context.ir[matchIndex] => match
            false => bindingTypeMatches!
            match.typeId >= 0 and armBinding.typeId == match.typeId
                -> if { true => bindingTypeMatches! }
            match.typeId < 0
                and armBinding.typeId < 0
                and armBinding.typeKind == match.typeKind
                and armBinding.typeOrigin == match.typeOrigin
                and armBinding.typeModule == match.typeModule
                and armBinding.typeSymbol == match.typeSymbol
                -> if { true => bindingTypeMatches! }
            bindingTypeMatches! -> if { armBindingIndex => dominatingResolved! }
        }
    }
    dominatingResolved!
}

# Diagnostic reads borrow session records and caller-owned fixed storage.
# Field types come from canonical nominal metadata, never fixture identities.
emitDiagnosticRecordLoad label: Text, recordLabel: Text, byteOffset: Int, valueType: Text -> Unit uses Console {
    "  %$(label)_slot = getelementptr i8, ptr %$(recordLabel), i64 $(byteOffset)" -> println
    "  %$(label) = load $(valueType), ptr %$(label)_slot, align " -> print
    valueType == "i32" -> if { "4" -> println } else { "8" -> println }
}

emitDiagnosticFieldPointer label: Text, ownerLabel: Text, ownerType: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    "  %$(label) = getelementptr inbounds " -> print
    ownerType -> writeSemanticTypeId(context, state)
    ", ptr %$(ownerLabel), i32 0, i32 $(ordinal)" -> println
}

emitDiagnosticOptionalId label: Text, optionType: Int, valueLabel: Text, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    "$(label)_tag" -> emitDiagnosticFieldPointer(label, optionType, 0, context, state)
    "$(label)_payload" -> emitDiagnosticFieldPointer(label, optionType, 1, context, state)
    "  %$(label)_present = icmp ne i64 %$(valueLabel), 0" -> println
    "  %$(label)_ordinal = zext i1 %$(label)_present to i32" -> println
    "  store i32 %$(label)_ordinal, ptr %$(label)_tag, align 4" -> println
    "  store i64 %$(valueLabel), ptr %$(label)_payload, align 8" -> println
}

emitDiagnosticSnapshotRecord label: Text, snapshotType: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    "  store " -> print
    snapshotType -> writeSemanticTypeId(context, state)
    " zeroinitializer, ptr %$(label)_destination, align 8" -> println
    0 => field!
    field! < 7 -> while {
        "$(label)_field$(field!)" -> emitDiagnosticFieldPointer("$(label)_destination", snapshotType, field!, context, state)
        field! + 1 => field!
    }
    "$(label)_task" -> emitDiagnosticRecordLoad("$(label)_record", 0, "i64")
    "$(label)_parent" -> emitDiagnosticRecordLoad("$(label)_record", 8, "i64")
    "$(label)_awaited" -> emitDiagnosticRecordLoad("$(label)_record", 32, "i64")
    "$(label)_deadline" -> emitDiagnosticRecordLoad("$(label)_record", 40, "i64")
    "$(label)_resume" -> emitDiagnosticRecordLoad("$(label)_record", 28, "i32")
    "  %$(label)_status = call i32 @sollang_diagnostic_observed_status(ptr %$(label)_record)" -> println
    "  store i64 %$(label)_task, ptr %$(label)_field0, align 8" -> println
    snapshotType -> nominalFieldType(1, context) => parentType
    "$(label)_field1" -> emitDiagnosticOptionalId(parentType, "$(label)_parent", context, state)
    snapshotType -> nominalFieldType(4, context) => awaitedType
    "$(label)_field4" -> emitDiagnosticOptionalId(awaitedType, "$(label)_awaited", context, state)
    "  %$(label)_completed = icmp eq i32 %$(label)_status, 2" -> println
    "  %$(label)_cancelled = icmp eq i32 %$(label)_status, 3" -> println
    "  %$(label)_running = icmp eq i32 %$(label)_status, 1" -> println
    "  %$(label)_pending_running = select i1 %$(label)_running, i32 1, i32 0" -> println
    "  %$(label)_completed_earlier = select i1 %$(label)_completed, i32 2, i32 %$(label)_pending_running" -> println
    "  %$(label)_lifecycle = select i1 %$(label)_cancelled, i32 3, i32 %$(label)_completed_earlier" -> println
    snapshotType -> nominalFieldType(2, context) => lifecycleType
    "$(label)_lifecycle_slot" -> emitDiagnosticFieldPointer("$(label)_field2", lifecycleType, 0, context, state)
    "  store i32 %$(label)_lifecycle, ptr %$(label)_lifecycle_slot, align 4" -> println
    "  %$(label)_ready = icmp eq i32 %$(label)_status, 0" -> println
    "  %$(label)_timer = icmp eq i32 %$(label)_status, 4" -> println
    "  %$(label)_blocked = icmp eq i32 %$(label)_status, 5" -> println
    "  %$(label)_ready_tag = select i1 %$(label)_ready, i32 1, i32 0" -> println
    "  %$(label)_timer_tag = select i1 %$(label)_timer, i32 2, i32 %$(label)_ready_tag" -> println
    "  %$(label)_wait = select i1 %$(label)_blocked, i32 3, i32 %$(label)_timer_tag" -> println
    snapshotType -> nominalFieldType(3, context) => waitType
    "$(label)_wait_slot" -> emitDiagnosticFieldPointer("$(label)_field3", waitType, 0, context, state)
    "  store i32 %$(label)_wait, ptr %$(label)_wait_slot, align 4" -> println
    "  %$(label)_visible_deadline = select i1 %$(label)_timer, i64 %$(label)_deadline, i64 0" -> println
    "  store i64 %$(label)_visible_deadline, ptr %$(label)_field5, align 8" -> println
    "  %$(label)_has_resume = icmp ne i32 %$(label)_resume, 0" -> println
    "  %$(label)_no_deadline = icmp eq i64 %$(label)_deadline, 0" -> println
    "  %$(label)_visible_state = or i1 %$(label)_no_deadline, %$(label)_timer" -> println
    "  %$(label)_has_locator = and i1 %$(label)_has_resume, %$(label)_visible_state" -> println
    "  br i1 %$(label)_has_locator, label %$(label)_locator, label %$(label)_done" -> println
    "$(label)_locator:" -> println
    snapshotType -> nominalFieldType(6, context) => suspensionType
    context.types[suspensionType].first => locatorType
    "$(label)_locator_tag" -> emitDiagnosticFieldPointer("$(label)_field6", suspensionType, 0, context, state)
    "$(label)_locator_payload" -> emitDiagnosticFieldPointer("$(label)_field6", suspensionType, 1, context, state)
    "  store i32 1, ptr %$(label)_locator_tag, align 4" -> println
    0 => locatorField!
    locatorField! < 6 -> while {
        "$(label)_locator_field$(locatorField!)" -> emitDiagnosticFieldPointer("$(label)_locator_payload", locatorType, locatorField!, context, state)
        locatorField! + 1 => locatorField!
    }
    0 => textField!
    textField! < 2 -> while {
        "$(label)_text$(textField!)_ptr" -> emitDiagnosticRecordLoad("$(label)_record", 48 + textField! * 16, "ptr")
        "$(label)_text$(textField!)_len" -> emitDiagnosticRecordLoad("$(label)_record", 56 + textField! * 16, "i64")
        "  %$(label)_text$(textField!)_0 = insertvalue %sollang.text zeroinitializer, ptr %$(label)_text$(textField!)_ptr, 0" -> println
        "  %$(label)_text$(textField!) = insertvalue %sollang.text %$(label)_text$(textField!)_0, i64 %$(label)_text$(textField!)_len, 1" -> println
        "  store %sollang.text %$(label)_text$(textField!), ptr %$(label)_locator_field$(textField!), align 8" -> println
        textField! + 1 => textField!
    }
    "  store i32 %$(label)_resume, ptr %$(label)_locator_field2, align 4" -> println
    "$(label)_byte" -> emitDiagnosticRecordLoad("$(label)_record", 80, "i64")
    "  store i64 %$(label)_byte, ptr %$(label)_locator_field3, align 8" -> println
    4 => coordinate!
    coordinate! < 6 -> while {
        "$(label)_coordinate$(coordinate!)" -> emitDiagnosticRecordLoad("$(label)_record", 88 + (coordinate! - 4) * 8, "i64")
        "  %$(label)_coordinate$(coordinate!)_narrow = trunc i64 %$(label)_coordinate$(coordinate!) to i32" -> println
        "  store i32 %$(label)_coordinate$(coordinate!)_narrow, ptr %$(label)_locator_field$(coordinate!), align 4" -> println
        coordinate! + 1 => coordinate!
    }
    "  br label %$(label)_done" -> println
    "$(label)_done:" -> println
}

emitDiagnosticSnapshotRow label: Text, nodeIndex: Int, row: Int, snapshotType: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    "  %$(label)_present = icmp ugt i64 %snap$(nodeIndex)_count, $(row)" -> println
    "  br i1 %$(label)_present, label %$(label)_write, label %$(label)_next" -> println
    "$(label)_write:" -> println
    "  %$(label)_record = getelementptr i8, ptr %snap$(nodeIndex)_records, i64 $(row * 112)" -> println
    "  %$(label)_destination = getelementptr " -> print
    snapshotType -> writeSemanticTypeId(context, state)
    ", ptr %snap$(nodeIndex)_output, i64 $(row)" -> println
    label -> emitDiagnosticSnapshotRecord(snapshotType, context, state)
    "  br label %$(label)_next" -> println
    "$(label)_next:" -> println
}

emitDiagnosticSnapshotCall nodeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[nodeIndex] => node
    node.operand1 -> aggregateValueIndex(context, state) => outputIndex
    context.ir[outputIndex] -> effectiveTypeId(context, state) => outputType
    outputType < 0 or context.types[outputType].kind != 4 or context.types[outputType].length < 0
        -> if { "; sollang internal error: diagnostic snapshot requires fixed mutable storage" -> println
            process.exit(1) }
    context.types[outputType].first => snapshotType
    context.types[outputType].length => capacity
    nodeIndex -> callTargetParameter(1, context, state) => outputParameter
    outputParameter < 0 -> if {
        "; sollang internal error: diagnostic snapshot mutable parameter is unresolved" -> println
        process.exit(1)
    }
    "snap$(nodeIndex)_output" -> emitMutableBorrowPlace(outputParameter, outputIndex, ownerIndex, context, state)
    "  %snap$(nodeIndex)_token = extractvalue " -> print
    context.ir[node.operand0] -> writeIrType(context, state)
    " " -> print
    node.operand0 -> writeValue(ownerIndex, context, state)
    ", 0" -> println
    "  %snap$(nodeIndex)_session = inttoptr i64 %snap$(nodeIndex)_token to ptr" -> println
    "snap$(nodeIndex)_count" -> emitDiagnosticRecordLoad("snap$(nodeIndex)_session", 16, "i64")
    "snap$(nodeIndex)_records" -> emitDiagnosticRecordLoad("snap$(nodeIndex)_session", 32, "ptr")
    0 => row!
    row! < capacity -> while {
        "snap$(nodeIndex)_row$(row!)" -> emitDiagnosticSnapshotRow(nodeIndex, row!, snapshotType, context, state)
        row! + 1 => row!
    }
    "snap$(nodeIndex)_id" -> emitDiagnosticRecordLoad("snap$(nodeIndex)_session", 0, "i64")
    "  %snap$(nodeIndex)_truncated = icmp ugt i64 %snap$(nodeIndex)_count, $(capacity)" -> println
    "  %snap$(nodeIndex)_written = select i1 %snap$(nodeIndex)_truncated, i64 $(capacity), i64 %snap$(nodeIndex)_count" -> println
    0 => summaryField!
    summaryField! < 4 -> while {
        "  %snap$(nodeIndex)_summary$(summaryField!) = insertvalue " -> print
        node -> writeIrType(context, state)
        summaryField! == 0 -> if { " zeroinitializer" -> print } else { " %snap$(nodeIndex)_summary$(summaryField! - 1)" -> print }
        summaryField! -> when {
            == 0 { ", i64 %snap$(nodeIndex)_id" -> print }
            == 1 { ", i64 %snap$(nodeIndex)_written" -> print }
            == 2 { ", i64 %snap$(nodeIndex)_count" -> print }
            else { ", i1 %snap$(nodeIndex)_truncated" -> print }
        }
        ", $(summaryField!)" -> println
        summaryField! + 1 => summaryField!
    }
    "  %v$(nodeIndex) = freeze " -> print
    node -> writeIrType(context, state)
    " %snap$(nodeIndex)_summary3" -> println
}


emitDiagnosticSessionCall nodeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[nodeIndex] => node
    (node.kind == 6 or node.kind == 9) and node.opcode == -326
        -> if { nodeIndex -> emitDiagnosticSnapshotCall(ownerIndex, context, state)
            return }
    (node.kind == 6 or node.kind == 9) and node.opcode == -325
        -> if { nodeIndex -> emitDiagnosticTrackCall(ownerIndex, context, state)
            return }
    (node.kind != 6 and node.kind != 9)
        or (node.opcode != -324 and node.opcode != -327)
        -> if { return }
    context.ir[node.operand0] => input
    "  %v$(nodeIndex)_diagnostic_input = extractvalue " -> print
    input -> writeIrType(context, state)
    " " -> print
    node.operand0 -> writeValue(ownerIndex, context, state)
    ", 0" -> println
    "  %v$(nodeIndex)_diagnostic_result_slot = alloca " -> print
    node -> writeIrType(context, state)
    ", align 8" -> println
    "  store " -> print
    node -> writeIrType(context, state)
    " zeroinitializer, ptr %v$(nodeIndex)_diagnostic_result_slot, align 8" -> println
    "  %v$(nodeIndex)_diagnostic_tag = getelementptr inbounds " -> print
    node -> writeIrType(context, state)
    ", ptr %v$(nodeIndex)_diagnostic_result_slot, i32 0, i32 0" -> println
    "  %v$(nodeIndex)_diagnostic_payload = getelementptr inbounds " -> print
    node -> writeIrType(context, state)
    ", ptr %v$(nodeIndex)_diagnostic_result_slot, i32 0, i32 1" -> println
    node.opcode == -324 -> if {
        "  %v$(nodeIndex)_diagnostic_raw = call { ptr, i32 } @sollang_diagnostic_start(i32 %v$(nodeIndex)_diagnostic_input)" -> println
        "  %v$(nodeIndex)_diagnostic_session = extractvalue { ptr, i32 } %v$(nodeIndex)_diagnostic_raw, 0" -> println
        "  %v$(nodeIndex)_diagnostic_error = extractvalue { ptr, i32 } %v$(nodeIndex)_diagnostic_raw, 1" -> println
        "  %v$(nodeIndex)_diagnostic_ok = icmp eq i32 %v$(nodeIndex)_diagnostic_error, -1" -> println
    } else {
        "  %v$(nodeIndex)_diagnostic_session = inttoptr i64 %v$(nodeIndex)_diagnostic_input to ptr" -> println
        "  %v$(nodeIndex)_diagnostic_raw = call { i1, i64, i64, i64 } @sollang_diagnostic_close(ptr %v$(nodeIndex)_diagnostic_session)" -> println
        "  %v$(nodeIndex)_diagnostic_ok = extractvalue { i1, i64, i64, i64 } %v$(nodeIndex)_diagnostic_raw, 0" -> println
    }
    "  %v$(nodeIndex)_diagnostic_discriminant = select i1 %v$(nodeIndex)_diagnostic_ok, i32 0, i32 1" -> println
    "  store i32 %v$(nodeIndex)_diagnostic_discriminant, ptr %v$(nodeIndex)_diagnostic_tag, align 4" -> println
    "  br i1 %v$(nodeIndex)_diagnostic_ok, label %diagnostic$(nodeIndex)_ok, label %diagnostic$(nodeIndex)_error" -> println
    "diagnostic$(nodeIndex)_ok:" -> println
    node.opcode == -324 -> if {
        "  %v$(nodeIndex)_diagnostic_token = ptrtoint ptr %v$(nodeIndex)_diagnostic_session to i64" -> println
        "  store i64 %v$(nodeIndex)_diagnostic_token, ptr %v$(nodeIndex)_diagnostic_payload, align 8" -> println
    } else {
        1 => field!
        field! <= 3 -> while {
            "  %v$(nodeIndex)_diagnostic_summary$(field!) = extractvalue { i1, i64, i64, i64 } %v$(nodeIndex)_diagnostic_raw, $(field!)" -> println
            "  %v$(nodeIndex)_diagnostic_summary_slot$(field!) = getelementptr i8, ptr %v$(nodeIndex)_diagnostic_payload, i64 $((field! - 1) * 8)" -> println
            "  store i64 %v$(nodeIndex)_diagnostic_summary$(field!), ptr %v$(nodeIndex)_diagnostic_summary_slot$(field!), align 8" -> println
            field! + 1 => field!
        }
    }
    "  br label %diagnostic$(nodeIndex)_merge" -> println
    "diagnostic$(nodeIndex)_error:" -> println
    node.opcode == -324 -> if {
        "  store i32 %v$(nodeIndex)_diagnostic_error, ptr %v$(nodeIndex)_diagnostic_payload, align 4" -> println
    } else {
        # The zeroed failure payload retains Busy's ordinal and the exact owner.
        "  store i64 %v$(nodeIndex)_diagnostic_input, ptr %v$(nodeIndex)_diagnostic_payload, align 8" -> println
    }
    "  br label %diagnostic$(nodeIndex)_merge" -> println
    "diagnostic$(nodeIndex)_merge:" -> println
    "  %v$(nodeIndex) = load " -> print
    node -> writeIrType(context, state)
    ", ptr %v$(nodeIndex)_diagnostic_result_slot, align 8" -> println
}

# The ordinary record is160 bytes inside the existing168-byte allocation.
# This diagnostic-only view retains the producer's actual header across aliases.
emitTaskDiagnosticHeaderStore label: Text, controlName: Text, headerName: Text -> Unit uses Console {
    "  %$(label)_header_slot = getelementptr %sollang.diagnostic_task_control, ptr $(controlName), i32 0, i32 1" -> println
    "  store ptr $(headerName), ptr %$(label)_header_slot, align 8" -> println
}

runtimeTaskContextSize resultSize: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context -> usesReachableAsyncDiagnostics(state)
        -> if { (resultSize + 7) / 8 * 8 + 48 } else { resultSize }
}

emitRuntimeTaskDiagnosticContext label: Text, controlName: Text, contextName: Text, resultSize: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context -> usesReachableAsyncDiagnostics(state)
        -> unless { return }
    (resultSize + 7) / 8 * 8 => headerOffset
    "  %$(label)_header = getelementptr i8, ptr $(contextName), i64 $headerOffset" -> println
    "  store { ptr, ptr, i64, i64, ptr, ptr } zeroinitializer, ptr %$(label)_header, align 8" -> println
    label -> emitTaskDiagnosticHeaderStore(controlName, "%$(label)_header")
    ownerIndex -> diagnosticCallerFunction(context) => parentFunction
    parentFunction >= 0 -> if {
        parentFunction -> asyncDiagnosticHeaderOffset(context, state) => parentOffset
        "  %$(label)_parent = getelementptr i8, ptr %async_context, i64 $parentOffset" -> println
        "  call void @sollang_diagnostic_inherit(ptr %$(label)_header, ptr $(controlName), ptr %$(label)_parent)" -> println
    }
}

# Static provenance is used only for optional sleep source locations, never
# to reconstruct a Task context or its diagnostic-header address.
diagnosticSleepProducer valueIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    valueIndex => current!
    0 => depth!
    current! >= 0 and current! < (context.ir -> len)
        and depth! < (context.ir -> len) -> while {
            context.ir[current!] => value
            (value.kind == 6 or value.kind == 9)
                and (value.flags / 8 % 2 == 1 or value.opcode == -113)
                -> if {
                    current! -> return
                }
            (value.kind == 6 or value.kind == 9) and value.opcode == -325
                -> if { value.operand1 => current! } else {
                    value.kind == 5 or value.kind == 17 or value.kind == 16
                        -> if { value.operand0 => current! } else {
                            value.kind == 29 and value.parent >= 0
                                -> if {
                                    context.ir[value.parent] => arm
                                    arm.kind == 19 and arm.parent >= 0
                                        and context.ir[arm.parent].kind == 27
                                        -> if { context.ir[arm.parent].operand0 => current! } else { -1 -> return }
                                } else { -1 -> return }
                        }
                }
            depth! + 1 => depth!
        }
    -1
}

# Resolve the source path belonging to an already-classified sleep intrinsic.
# Its canonical declaration supplies the name; spelling alone never admits it.
diagnosticSleepProducerOffset producerIndex: Int, context: ref emitterContext.EmitContext -> Int {
    context.ir[producerIndex] => producer
    producer.targetModule < 0 or producer.symbol < 0
        -> if { -1 -> return }
    context.ranges[producer.targetModule] => declarationRange
    context.symbols[declarationRange.symbolStart + producer.symbol] => declaration
    context.tokens[declarationRange.tokenStart + declaration.nameToken].span => name
    context.sources[producer.targetModule] -> slice(name.start, name.length) => declaredName
    context.ranges[producer.sourceModule] => range
    0 => candidateIndex!
    candidateIndex! < range.astCount -> while {
        context.nodes[range.astStart + candidateIndex!] => candidate
        candidate.kind == 16 and candidate.payloadToken >= 0
            and (candidate.parent == producer.astNode or candidateIndex! == producer.astNode)
            -> if {
                context.tokens[range.tokenStart + candidate.payloadToken].span => token
                (context.sources[producer.sourceModule] -> slice(token.start, token.length)) == declaredName
                    -> if { Int(candidate.start) -> return }
            }
        candidateIndex! + 1 => candidateIndex!
    }
    -1
}

emitDiagnosticTrackCall nodeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context.ir[nodeIndex] => node
    context.ir[node.operand0] => session
    "  %v$(nodeIndex)_track_token = extractvalue " -> print
    session -> writeIrType(context, state)
    " " -> print
    node.operand0 -> writeValue(ownerIndex, context, state)
    ", 0" -> println
    "  %v$(nodeIndex)_track_session = inttoptr i64 %v$(nodeIndex)_track_token to ptr" -> println
    "  %v$(nodeIndex)_track_task = freeze %sollang.task " -> print
    node.operand1 -> writeValue(ownerIndex, context, state)
    "" -> println
    "  %v$(nodeIndex)_track_control = extractvalue %sollang.task %v$(nodeIndex)_track_task, 0" -> println
    "  %v$(nodeIndex)_track_context = extractvalue %sollang.task %v$(nodeIndex)_track_task, 1" -> println
    "  %v$(nodeIndex)_track_header_slot = getelementptr %sollang.diagnostic_task_control, ptr %v$(nodeIndex)_track_control, i32 0, i32 1" -> println
    "  %v$(nodeIndex)_track_header = load ptr, ptr %v$(nodeIndex)_track_header_slot, align 8" -> println
    "  %v$(nodeIndex)_track_error = call i32 @sollang_diagnostic_track(ptr %v$(nodeIndex)_track_session, ptr %v$(nodeIndex)_track_header, ptr %v$(nodeIndex)_track_control)" -> println
    "  %v$(nodeIndex)_track_ok = icmp eq i32 %v$(nodeIndex)_track_error, -1" -> println
    "  %v$(nodeIndex)_track_tag_value = select i1 %v$(nodeIndex)_track_ok, i32 0, i32 1" -> println
    "  %v$(nodeIndex)_track_result_slot = alloca " -> print
    node -> writeIrType(context, state)
    ", align 8" -> println
    "  store " -> print
    node -> writeIrType(context, state)
    " zeroinitializer, ptr %v$(nodeIndex)_track_result_slot, align 8" -> println
    "  %v$(nodeIndex)_track_tag = getelementptr inbounds " -> print
    node -> writeIrType(context, state)
    ", ptr %v$(nodeIndex)_track_result_slot, i32 0, i32 0" -> println
    "  store i32 %v$(nodeIndex)_track_tag_value, ptr %v$(nodeIndex)_track_tag, align 4" -> println
    "  %v$(nodeIndex)_track_payload = getelementptr inbounds " -> print
    node -> writeIrType(context, state)
    ", ptr %v$(nodeIndex)_track_result_slot, i32 0, i32 1" -> println
    "  store %sollang.task %v$(nodeIndex)_track_task, ptr %v$(nodeIndex)_track_payload, align 8" -> println
    "  br i1 %v$(nodeIndex)_track_ok, label %track$(nodeIndex)_merge, label %track$(nodeIndex)_error" -> println
    "track$(nodeIndex)_error:" -> println
    "  %v$(nodeIndex)_track_kind = getelementptr i8, ptr %v$(nodeIndex)_track_payload, i64 16" -> println
    "  store i32 %v$(nodeIndex)_track_error, ptr %v$(nodeIndex)_track_kind, align 4" -> println
    "  br label %track$(nodeIndex)_merge" -> println
    "track$(nodeIndex)_merge:" -> println
    "  %v$(nodeIndex) = load " -> print
    node -> writeIrType(context, state)
    ", ptr %v$(nodeIndex)_track_result_slot, align 8" -> println
}
