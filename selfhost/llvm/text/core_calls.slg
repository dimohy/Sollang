        true => argumentIsMutableBorrow!
        context.ir[argumentParameterIndex] -> mutableBorrowUsesStructPointer(context) -> if { true => argumentIsMutableStructBorrow! }
    }
    argumentIsMutableBorrow! -> if {
        argumentIsMutableStructBorrow! -> if {
            "ptr %callmut$(callIndex)_arg$(ordinal)" -> print
        } else {
