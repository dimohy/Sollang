                        memberFieldMatches! -> if {
                            memberField.ordinal => memberFieldOrdinal!
                            memberField.fieldType => memberFieldType!
                        }
                    }
                    memberFieldSearch! + 1 => memberFieldSearch!
                }
                memberFieldOrdinal! >= 0 -> if {
                    "  %callref" -> print
                    callIndex -> writeDecimal
                    "_arg" -> print
                    ordinal -> writeDecimal
                    "_place" -> print
                    memberProjectionOrdinal! -> writeDecimal
                    " = getelementptr inbounds " -> print
                    memberOwnerType! -> writeSemanticTypeId(context, state)
                    ", ptr " -> print
                    memberProjectionOrdinal! == 0 -> if {
                        rootBinding -> writeReferenceRootAddress(ownerIndex, context, state)
