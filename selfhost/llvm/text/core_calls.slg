additionalParameterOrdinal functionIndex: Int, symbol: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.ir[functionIndex].nextOperand -> findAdditionalParameterOrdinal(symbol, 1, context, state)
}
writeReferencePlaceValue functionIndex: Int, valueIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[functionIndex] => referenceFunction
    context.ir[valueIndex] => referenceValue
