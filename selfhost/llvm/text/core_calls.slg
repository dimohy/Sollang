# Responsibility fragment extracted from emitCore. State is passed by readonly
# reference, preserving the original direct-call and allocation behavior.
functionEnd functionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    state.frozenFunctionEnds[functionIndex]
}
isNativeFunction node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    node.kind == 0 and node.flags / 128 % 2 == 1 and node.flags / 512 % 2 == 0
}
isComFunction node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    node.kind == 0 and node.flags / 512 % 2 == 1
}
isImportedLibraryFunction node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    node.kind == 0
        and node.flags / 262144 % 2 == 1
        and node.sourceModule >= (context.ranges -> len)
        and node.sourceModule - (context.ranges -> len) < (context.libraries.interfaces -> len)
}
targetsImportedLibraryFunction node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => imported!
    context.ranges -> len => libraryModuleBase
    (node.targetModule >= libraryModuleBase
        and node.targetModule - libraryModuleBase < (context.libraries.interfaces -> len)
        and node.symbol >= 0) -> if {
        node.targetModule - libraryModuleBase => interfaceIndex
        node.symbol < (context.libraries.interfaces[interfaceIndex].exports -> len) -> if {
            true => imported!
        }
    }
    imported!
}
targetsNativeFunction node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    node -> targetsImportedLibraryFunction(context, state) => native!
    (node.targetModule >= 0 and node.targetModule < (context.ranges -> len) and node.symbol >= 0) -> if {
        context.ranges[node.targetModule] => nativeTargetRange
        node.symbol < nativeTargetRange.symbolCount -> if {
            context.symbols[nativeTargetRange.symbolStart + node.symbol] => nativeTargetSymbol
            (nativeTargetSymbol.kind == 7 and nativeTargetSymbol.flags / 128 % 2 == 1 and nativeTargetSymbol.flags / 512 % 2 == 0) -> if { true => native! }
        }
    }
    native!
}
targetsNativeTry node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => nativeTry!
    (node.targetModule >= 0 and node.targetModule < (context.ranges -> len) and node.symbol >= 0) -> if {
        context.ranges[node.targetModule] => nativeTryRange
        node.symbol < nativeTryRange.symbolCount -> if {
            context.symbols[nativeTryRange.symbolStart + node.symbol] => nativeTrySymbol
            (nativeTrySymbol.kind == 7
                and nativeTrySymbol.flags / 128 % 2 == 1
                and nativeTrySymbol.flags / 512 % 2 == 0
                and nativeTrySymbol.flags / 32768 % 2 == 1) -> if {
                true => nativeTry!
            }
        }
    }
    nativeTry!
}
nativeTrySuccessTypeId node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => successType!
    ((node -> targetsNativeTry(context, state))
        and node.typeId >= 0
        and node.typeId < (context.types -> len)) -> if {
        context.types[node.typeId] => resultType
        (resultType.kind == 7
            and resultType.origin == 4
            and resultType.symbol == 1
            and resultType.second == 5) -> if {
            resultType.first => successType!
        }
    }
    successType!
}
emitNativeTargetLoad nodeIndex: Int, node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    node -> targetsNativeFunction(context, state) -> if {
        node -> targetsImportedLibraryFunction(context, state) -> if {
            node.targetModule - (context.ranges -> len) => nativeInterface
            "  %native_target_$(nodeIndex) = load ptr, ptr @sollang_library_function_i$(nativeInterface)_e$(node.symbol), align 8" -> println
        } else {
            node.targetModule => nativeTargetModule
            node.symbol => nativeTargetSymbol
            "  %native_target_$(nodeIndex) = load ptr, ptr @sollang_native_function_m$(nativeTargetModule)_s$(nativeTargetSymbol), align 8" -> println
        }
    }
}
writeResolvedCallTarget nodeIndex: Int, node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    node -> targetsNativeFunction(context, state) => resolvedNativeTarget
    resolvedNativeTarget -> if {
        " %native_target_$(nodeIndex)(" -> print
    }
    not resolvedNativeTarget -> if {
        node.targetModule => resolvedTargetModule!
        node.symbol => resolvedTargetSymbol!
        (resolvedTargetSymbol! <= -104
            and resolvedTargetSymbol! >= -114
            and state.intrinsicRuntimeModule >= 0) -> if {
            state.intrinsicRuntimeModule => resolvedTargetModule!
            0 - resolvedTargetSymbol! - 101 => resolvedTargetSymbol!
        }
        " @sollang_m$(resolvedTargetModule!)_s$(resolvedTargetSymbol!)(" -> print
    }
}
nativeLibraryAst function: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => libraryAst!
    (function.sourceModule >= 0 and function.sourceModule < (context.ranges -> len) and function.symbol >= 0) -> if {
        context.ranges[function.sourceModule] => nativeRange
        function.symbol < nativeRange.symbolCount -> if {
            context.symbols[nativeRange.symbolStart + function.symbol] => nativeSymbol
            nativeSymbol.astNode >= 0 -> if {
                context.nodes[nativeRange.astStart + nativeSymbol.astNode] => nativeFunctionAst
                (nativeFunctionAst.parent >= 0 and context.nodes[nativeRange.astStart + nativeFunctionAst.parent].kind == 65) -> if {
                    nativeFunctionAst.parent => libraryAst!
                }
            }
        }
    }
    libraryAst!
}
nativeSymbolToken function: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.ranges[function.sourceModule] => nativeRange
    context.symbols[nativeRange.symbolStart + function.symbol] => nativeSymbol
    nativeSymbol.nameToken => symbolToken!
    context.nodes[nativeRange.astStart + nativeSymbol.astNode] => nativeFunctionAst
    nativeFunctionAst.firstToken => nativeTokenSearch!
    nativeTokenSearch! < nativeFunctionAst.firstToken + nativeFunctionAst.tokenCount -> while {
        context.tokens[nativeRange.tokenStart + nativeTokenSearch!].kind == grammar.tokenIdString() -> if {
            nativeTokenSearch! => symbolToken!
        }
        nativeTokenSearch! + 1 => nativeTokenSearch!
    }
    symbolToken!
}
irValueUsed nodeIndex: Int, ownerIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => used!
    context.ir[nodeIndex] => valueCandidate
    (valueCandidate.kind == 18
        and valueCandidate.nextOperand >= 0
        and not (valueCandidate.typeOrigin == 1 and valueCandidate.typeSymbol == 0)) -> if {
        true => used!
    }
    ownerIndex + 1 => useIndex!
    ownerIndex -> functionEnd(context, state) => useEnd
    (not used! and useIndex! < useEnd) -> while {
        context.ir[useIndex!] => useNode
        (useIndex! != nodeIndex and (useNode.operand0 == nodeIndex or useNode.operand1 == nodeIndex or useNode.nextOperand == nodeIndex)) -> if { true => used! }
        useIndex! + 1 => useIndex!
    }
    used!
}
plannedStreamPipeline terminalIr: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => found!
    0 => pipelineIndex!
    pipelineIndex! < (context.streamPlan.pipelines -> len) -> while {
        context.streamPlan.pipelines[pipelineIndex!].terminalIr == terminalIr -> if { pipelineIndex! => found! }
        pipelineIndex! + 1 => pipelineIndex!
    }
    found!
}
plannedStreamStage callIr: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => found!
    0 => stageIndex!
    stageIndex! < (context.streamPlan.stages -> len) -> while {
        context.streamPlan.stages[stageIndex!].callIr == callIr -> if { stageIndex! => found! }
        stageIndex! + 1 => stageIndex!
    }
    found!
}
streamCallbackRole pipelineIndex: Int, expressionIndex: Int, runtimeArgumentIndex: Int, roleSymbol: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    0 => direct!
    context.streamPlan.pipelines[pipelineIndex] => pipeline
    pipeline.stageStart => stageIndex!
    stageIndex! < pipeline.stageStart + pipeline.stageCount -> while {
        context.streamPlan.stages[stageIndex!] => stage
        (stage.callbackStart >= 0 and ((expressionIndex >= stage.callbackStart and expressionIndex <= stage.callbackEnd) or (runtimeArgumentIndex >= stage.callbackStart and runtimeArgumentIndex <= stage.callbackEnd))) -> if {
            context.ir[stage.callIr] => stageCall
            context.ranges[stageCall.sourceModule] => stageRange
            -1 => stageScope!
            0 => stageScopeSearch!
            stageScopeSearch! < stageRange.symbolCount -> while {
                context.symbols[stageRange.symbolStart + stageScopeSearch!] => stageScopeCandidate
                (stageScopeCandidate.kind == 48 and stageScopeCandidate.astNode == stageCall.astNode) -> if { stageScopeSearch! => stageScope! }
                stageScopeSearch! + 1 => stageScopeSearch!
            }
            0 => roleOrdinal!
            0 => roleSearch!
            roleSearch! < stageRange.symbolCount -> while {
                context.symbols[stageRange.symbolStart + roleSearch!] => stageRole
                (stageRole.kind == 35 and stageRole.parent == stageScope!) -> if {
                    roleSymbol == roleSearch! -> if {
                        (stage.flags == 3 and roleOrdinal! == 0) -> if { 2 => direct! } else { 1 => direct! }
                    }
                    roleOrdinal! + 1 => roleOrdinal!
                }
                roleSearch! + 1 => roleSearch!
            }
        }
        stageIndex! + 1 => stageIndex!
    }
    (direct! == 0 and pipeline.terminalIr >= 0 and pipeline.terminalIr < (context.ir -> len)) -> if {
        context.ir[pipeline.terminalIr] => terminal
        context.ranges[terminal.sourceModule] => terminalRange
        0 => terminalRoleSearch!
        terminalRoleSearch! < terminalRange.symbolCount -> while {
            context.symbols[terminalRange.symbolStart + terminalRoleSearch!] => terminalRole
            (terminalRole.kind == 35 and terminalRole.astNode == terminal.astNode and roleSymbol == terminalRoleSearch!) -> if { 1 => direct! }
            terminalRoleSearch! + 1 => terminalRoleSearch!
        }
    }
    direct!
}
isStreamFunctionIr functionIr: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => stream!
    context.ir[functionIr] => candidate
    (candidate.kind == 0 and candidate.sourceModule >= 0 and candidate.sourceModule < (context.ranges -> len) and candidate.symbol >= 0) -> if {
        context.ranges[candidate.sourceModule] => candidateRange
        candidate.symbol < candidateRange.symbolCount -> if {
            context.symbols[candidateRange.symbolStart + candidate.symbol] => candidateSymbol
            candidateSymbol.kind == 7 -> if { (candidateSymbol.flags / 64) % 2 == 1 => stream! }
        }
    }
    stream!
}
isRangeFunctionIr functionIr: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => range!
    context.ir[functionIr] => candidate
    candidate.typeId >= 0 -> if {
        context.types[candidate.typeId] => candidateType
        (candidateType.kind == 1 and candidateType.origin == 1 and candidateType.symbol == 25) -> if { true => range! }
    }
    range!
}
isRangeDeferCall callIr: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => deferCall!
    (callIr >= 0 and callIr < (context.ir -> len)) -> if {
        context.ir[callIr] => candidate
        (candidate.kind == 6 and candidate.typeId >= 0 and candidate.typeId < (context.types -> len) and candidate.operand0 >= 0 and candidate.operand0 < (context.ir -> len) and candidate.targetModule >= 0 and candidate.targetModule < (context.ranges -> len) and candidate.symbol >= 0) -> if {
            context.types[candidate.typeId] => resultType
            context.ir[candidate.operand0] => argument
            context.ranges[candidate.targetModule] => targetRange
            candidate.symbol < targetRange.symbolCount -> if {
                context.symbols[targetRange.symbolStart + candidate.symbol] => target
                (resultType.kind == 7 and resultType.origin == 4 and resultType.symbol == 3 and argument.typeId >= 0 and argument.typeId < (context.types -> len)) -> if {
                    context.types[argument.typeId] => argumentType
                    (argumentType.kind == 1 and argumentType.origin == 1 and argumentType.symbol == 25 and (candidate.targetModule -> sourceTokenIs(target.nameToken, "defer", context, state))) -> if {
                        true => deferCall!
                    }
                }
            }
        }
    }
    deferCall!
}
isMouseEventsCall callIr: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => mouseCall!
    (callIr >= 0 and callIr < (context.ir -> len)) -> if {
        context.ir[callIr] => candidate
        (candidate.kind == 6 and candidate.typeId >= 0 and candidate.typeId < (context.types -> len) and candidate.targetModule >= 0 and candidate.targetModule < (context.ranges -> len) and candidate.symbol >= 0) -> if {
            context.types[candidate.typeId] => resultType
            context.ranges[candidate.targetModule] => targetRange
            candidate.symbol < targetRange.symbolCount -> if {
                context.symbols[targetRange.symbolStart + candidate.symbol] => target
                (resultType.kind == 7 and resultType.origin == 4 and resultType.symbol == 4 and (candidate.targetModule -> sourceTokenIs(target.nameToken, "mouseEvents", context, state))) -> if {
                    true => mouseCall!
                }
            }
        }
    }
    mouseCall!
}
isNativePathStyleCall callIr: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => nativeStyleCall!
    (callIr >= 0 and callIr < (context.ir -> len)) -> if {
        context.ir[callIr] => candidate
        (candidate.kind == 6
            and candidate.operand0 < 0
            and candidate.targetModule >= 0
            and candidate.targetModule < (context.ranges -> len)
            and candidate.symbol >= 0) -> if {
            context.ranges[candidate.targetModule] => targetRange
            candidate.symbol < targetRange.symbolCount -> if {
                context.symbols[targetRange.symbolStart + candidate.symbol] => target
                candidate.targetModule -> sourceTokenIs(target.nameToken, "nativeStyle", context, state) -> if {
                    true => nativeStyleCall!
                }
            }
        }
    }
    nativeStyleCall!
}
emitNativePathStyleValue callIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    context.ir[callIndex] => call
    "  %v$(callIndex)_native_style_slot = alloca " -> print
    call -> writeIrType(context, state)
    ", align 4" -> println
    "  store " -> print
    call -> writeIrType(context, state)
    " zeroinitializer, ptr %v$(callIndex)_native_style_slot, align 4" -> println
    "  %v$(callIndex)_native_style_tag = getelementptr inbounds " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(callIndex)_native_style_slot, i32 0, i32 0" -> println
    "  store i32 " -> print
    context.expectedPathStyle -> writeDecimal
    ", ptr %v$(callIndex)_native_style_tag, align 4" -> println
    "  %v$(callIndex) = load " -> print
    call -> writeIrType(context, state)
    ", ptr %v$(callIndex)_native_style_slot, align 4" -> println
}
nodeDescendsFrom request: NodeAncestorRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => descends!
    context.ir[request.nodeIndex] => descendantNode
    context.ir[request.ownerIndex] => ownerNode
    (descendantNode.sourceModule == ownerNode.sourceModule and descendantNode.astNode >= 0 and ownerNode.astNode >= 0) -> if {
        context.ranges[descendantNode.sourceModule] => descendantRange
        context.nodes[descendantRange.astStart + descendantNode.astNode].parent => ancestorAst!
        (ancestorAst! >= 0 and not descends!) -> while {
            ancestorAst! == ownerNode.astNode -> if { true => descends! } else { context.nodes[descendantRange.astStart + ancestorAst!].parent => ancestorAst! }
        }
    }
    descends!
}
irDescendsFrom request: NodeAncestorRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => descends!
    context.ir[request.nodeIndex].parent => ancestor!
    (ancestor! >= 0 and not descends!) -> while {
        ancestor! == request.ownerIndex -> if { true => descends! } else { context.ir[ancestor!].parent => ancestor! }
    }
    descends!
}
eachRoleOwner nodeIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => owner!
    context.ir[nodeIndex] => roleUse
    (roleUse.kind == 5 and roleUse.operand0 < 0 and roleUse.symbol >= 0 and roleUse.sourceModule >= 0) -> if {
        context.ranges[roleUse.sourceModule] => roleRange
        roleUse.symbol < roleRange.symbolCount -> if {
            context.symbols[roleRange.symbolStart + roleUse.symbol] => roleSymbol
            (roleSymbol.kind == 35 and roleSymbol.astNode >= 0) -> if {
                roleUse.parent => roleFunctionOwner!
                (roleFunctionOwner! >= 0 and context.ir[roleFunctionOwner!].kind != 0 and context.ir[roleFunctionOwner!].kind != 11) -> while { context.ir[roleFunctionOwner!].parent => roleFunctionOwner! }
                0 => roleOwnerSearch!
                context.ir -> len => roleOwnerEnd!
                roleFunctionOwner! >= 0 -> if {
                    roleFunctionOwner! + 1 => roleOwnerSearch!
                    roleFunctionOwner! -> functionEnd(context, state) => roleOwnerEnd!
                }
                roleOwnerSearch! < roleOwnerEnd! -> while {
                    context.ir[roleOwnerSearch!] => roleOwnerCandidate
                    (roleOwnerCandidate.kind == 6 and roleOwnerCandidate.opcode == -208 and roleOwnerCandidate.sourceModule == roleUse.sourceModule and roleOwnerCandidate.astNode == roleSymbol.astNode) -> if { roleOwnerSearch! => owner! }
                    roleOwnerSearch! + 1 => roleOwnerSearch!
                }
            }
        }
    }
    owner!
}
functionCaptures functionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> [Int; ~] {
    [Int; ~] => captures!
    state.frozenFunctionCaptureOffsets[functionIndex] => cachedCaptureOffset
    0 => cachedCaptureIndex!
    cachedCaptureIndex! < state.frozenFunctionCaptureCounts[functionIndex] -> while {
        captures! -> push(state.frozenFunctionCaptureValues[cachedCaptureOffset + cachedCaptureIndex!])
        cachedCaptureIndex! + 1 => cachedCaptureIndex!
    }
    captures!
}
targetFunctionIndex request: CallEnvironmentRequest, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => targetFunctionIr!
    (request.targetModule >= 0 and request.targetModule < (context.ranges -> len)) -> if {
        context.ranges[request.targetModule].symbolStart + request.targetSymbol => targetGlobalSymbol
        (targetGlobalSymbol >= 0 and targetGlobalSymbol < (state.frozenCaptureFunctionsBySymbol -> len)) -> if {
            state.frozenCaptureFunctionsBySymbol[targetGlobalSymbol] => targetFunctionIr!
        }
    }
    (targetFunctionIr! < 0 and request.targetModule >= (context.ranges -> len)) -> if {
        0 => importedFunctionSearch!
        (importedFunctionSearch! < (context.ir -> len) and targetFunctionIr! < 0) -> while {
            context.ir[importedFunctionSearch!] => importedFunction
            (importedFunction.kind == 0
                and importedFunction.sourceModule == request.targetModule
                and importedFunction.symbol == request.targetSymbol
                and importedFunction.flags / 262144 % 2 == 1) -> if {
                importedFunctionSearch! => targetFunctionIr!
            }
            importedFunctionSearch! + 1 => importedFunctionSearch!
        }
    }
    targetFunctionIr!
}
callTargetParameter callIndex: Int, ordinal: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.ir[callIndex] => call
    CallEnvironmentRequest { callerIndex: -1, callIndex: callIndex, targetModule: call.targetModule, targetSymbol: call.symbol, hasArgument: call.operand0 >= 0 } -> targetFunctionIndex(context, state) => targetFunction
    -1 => parameter!
    targetFunction >= 0 -> if { context.ir[targetFunction].operand1 => parameter! }
    0 => parameterOrdinal!
    (parameter! >= 0 and parameterOrdinal! < ordinal) -> while {
        parameterOrdinal! == 0 -> if {
            context.ir[targetFunction].nextOperand => parameter!
        } else {
            context.ir[parameter!].nextOperand => parameter!
        }
        parameterOrdinal! + 1 => parameterOrdinal!
    }
    parameter!
}
sourceTokenIs sourceIndex: Int, tokenIndex: Int, expected: Text, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => equal!
    (sourceIndex >= 0 and sourceIndex < (context.ranges -> len) and tokenIndex >= 0) -> if {
        context.ranges[sourceIndex] => tokenRange
        context.tokens[tokenRange.tokenStart + tokenIndex] => actual
        actual.span.length == (expected -> len) => equal!
        UIntSize(0) => tokenByte!
        (equal! and tokenByte! < actual.span.length) -> while {
            (context.sources[sourceIndex] -> byte(actual.span.start + tokenByte!)) != (expected -> byte(tokenByte!)) -> if { false => equal! }
            tokenByte! + UIntSize(1) => tokenByte!
        }
    }
    equal!
}
sourceTokensEqual leftSource: Int, leftToken: Int, rightSource: Int, rightToken: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Bool {
    false => equal!
    (leftSource >= 0 and leftSource < (context.ranges -> len) and rightSource >= 0 and rightSource < (context.ranges -> len) and leftToken >= 0 and rightToken >= 0) -> if {
        context.ranges[leftSource] => leftRange
        context.ranges[rightSource] => rightRange
        context.tokens[leftRange.tokenStart + leftToken] => left
        context.tokens[rightRange.tokenStart + rightToken] => right
        left.span.length == right.span.length => equal!
        UIntSize(0) => tokenByte!
        (equal! and tokenByte! < left.span.length) -> while {
            (context.sources[leftSource] -> byte(left.span.start + tokenByte!)) != (context.sources[rightSource] -> byte(right.span.start + tokenByte!)) -> if { false => equal! }
            tokenByte! + UIntSize(1) => tokenByte!
        }
    }
    equal!
}
# Resolve a trait method for a nominal key without transferring `self`.
# Impl methods are ordinary typed-IR functions, so dictionary equality can
# call the same readonly-borrow ABI as an explicit method invocation.
traitMethodSymbol typeId: Int, traitName: Text, methodName: Text, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    -1 => resolvedMethod!
    (typeId >= 0 and typeId < (context.types -> len)) -> if {
        context.types[typeId] => receiverType
        (receiverType.kind == 1 and receiverType.module >= 0 and receiverType.module < (context.ranges -> len)) -> if {
            receiverType.module => receiverSource
            context.ranges[receiverSource] => receiverRange
            (receiverType.symbol >= 0 and receiverType.symbol < receiverRange.symbolCount) -> if {
                context.symbols[receiverRange.symbolStart + receiverType.symbol] => receiverSymbol
                0 => implSearch!
                implSearch! < receiverRange.symbolCount -> while {
                    context.symbols[receiverRange.symbolStart + implSearch!] => implCandidate
                    (resolvedMethod! < 0 and implCandidate.kind == 6 and implCandidate.parent < 0) -> if {
                        false => traitHeaderMatched!
                        context.nodes[receiverRange.astStart + implCandidate.astNode] => implAst
                        implAst.firstToken => implTokenSearch!
                        implTokenSearch! < implAst.firstToken + implAst.tokenCount -> while {
                            context.tokens[receiverRange.tokenStart + implTokenSearch!].kind == grammar.tokenIdIdentifier() -> if {
                                receiverSource -> sourceTokenIs(implTokenSearch!, traitName, context, state) -> if { true => traitHeaderMatched! }
                            }
                            implTokenSearch! + 1 => implTokenSearch!
                        }
                        traitHeaderMatched! -> if {
                        -1 => targetPath!
                        UIntSize(0) => targetPathStart!
                        0 => targetPathSearch!
                        targetPathSearch! < receiverRange.astCount -> while {
                            context.nodes[receiverRange.astStart + targetPathSearch!] => targetPathCandidate
                            (targetPathCandidate.kind == 16 and targetPathCandidate.parent == implCandidate.astNode and (targetPath! < 0 or targetPathCandidate.start > targetPathStart!)) -> if {
                                targetPathSearch! => targetPath!
                                targetPathCandidate.start => targetPathStart!
                            }
                            targetPathSearch! + 1 => targetPathSearch!
                        }
                        -1 => targetNameToken!
                        targetPath! >= 0 -> if {
                            context.nodes[receiverRange.astStart + targetPath!] => targetPathNode
                            targetPathNode.firstToken => targetTokenSearch!
                            targetTokenSearch! < targetPathNode.firstToken + targetPathNode.tokenCount -> while {
                                context.tokens[receiverRange.tokenStart + targetTokenSearch!].kind == grammar.tokenIdIdentifier() -> if { targetTokenSearch! => targetNameToken! }
                                targetTokenSearch! + 1 => targetTokenSearch!
                            }
                        }
                        (targetNameToken! >= 0 and (receiverSource -> sourceTokensEqual(targetNameToken!, receiverSource, receiverSymbol.nameToken, context, state))) -> if {
                            0 => methodSearch!
                            methodSearch! < receiverRange.symbolCount -> while {
                                context.symbols[receiverRange.symbolStart + methodSearch!] => methodCandidate
