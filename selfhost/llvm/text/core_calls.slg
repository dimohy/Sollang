    ((context.ir[callIndex] -> targetsNativeFunction(context, state)) and argumentParameterIndex >= 0) -> if {
        context.ir[argumentParameterIndex] => nativeScalarParameter
        nativeScalarParameter.typeId >= 0 -> if {
            context.types[nativeScalarParameter.typeId] => nativeScalarParameterType
            (nativeScalarParameterType.kind == 1 and nativeScalarParameterType.origin == 1 and (nativeScalarParameterType.symbol == 3 or nativeScalarParameterType.symbol == 4)) -> if { "signext " -> print }
            (nativeScalarParameterType.kind == 1 and nativeScalarParameterType.origin == 1 and (nativeScalarParameterType.symbol == 8 or nativeScalarParameterType.symbol == 9)) -> if { "zeroext " -> print }
