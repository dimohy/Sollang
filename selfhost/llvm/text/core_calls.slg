emitCallArgumentChain argumentIndex: Int, callIndex: Int, ownerIndex: Int, ordinal: Int, separator: Bool, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console {
    callIndex => chainCallIndex
    ownerIndex => chainOwnerIndex
    separator => chainSeparator
    # A block call's body shares the call AST parent and therefore participates
    # in the generic sibling chain, but it is not a runtime ABI argument. Once
    # a concrete function target is known, parameter metadata is authoritative
    # and terminates the chain before that body result. Unresolved intrinsics
    # retain their explicit operands because they intentionally have no
    # function-body parameter IR.
    (argumentIndex >= 0
        and (context.ir[argumentIndex].parent == chainCallIndex or argumentIndex == context.ir[chainCallIndex].operand0)
        and ((chainCallIndex -> callTargetParameter(ordinal, context, state)) >= 0
            or not (chainCallIndex -> callHasResolvedFunctionTarget(context, state)))) -> if {
        chainSeparator -> if { ", " -> print }
        argumentIndex -> writeCallArgument(chainCallIndex, chainOwnerIndex, ordinal, context, state)
        context.ir[argumentIndex].nextOperand -> emitCallArgumentChain(chainCallIndex, chainOwnerIndex, ordinal + 1, true, context, state)
    }
}
branchStageFlowIndex callIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Int {
    context.ir[callIndex] => call
    -1 => flowIndex!
