containsCanonicalSource canonicalPaths: ref [path.Path; ~], candidate: Text -> Bool {
    false => found!
    0 => index!
    index! < (canonicalPaths -> len) and not found!
        -> while {
            canonicalPaths[index!] -> equalsText(candidate)
                -> if { true => found! }
            index! + 1 => index!
        }
    found!
}

appendUniqueMappedSource sourcePathText: Text, style: path.Style, canonicalPaths: mut [path.Path; ~], owners: mut [file.SourceText; ~] -> Unit uses File {
    sourcePathText -> path.fromText(style) -> query -> when {
        Ok(info) {
            info.canonical -> pathText => canonicalView
            canonicalPaths -> containsCanonicalSource(canonicalView) => duplicate
            not duplicate -> if {
                canonicalView -> path.fromText(style) => canonical
                canonicalPaths -> push(canonical)
                sourcePathText -> file.mapText => owner
                owners -> push(owner)
            }
        }
        Err(error) {
            # Preserve the existing file mapping diagnostic when canonicalization fails.
            sourcePathText -> file.mapText => owner
            owners -> push(owner)
        }
    }
}

mapUniqueSources paths: ref [path.Path; ~], explicitPaths: [Text; ~] -> [file.SourceText; ~] uses File {
    [path.Path; ~] => canonicalPaths!
    [file.SourceText; ~] => owners!
    paths[0] -> styleKind => style
    0 => sourcePathIndex!
    sourcePathIndex! < (paths -> len) -> while {
        paths[sourcePathIndex!] -> pathText => sourcePathText
        sourcePathText -> appendUniqueMappedSource(style, canonicalPaths!, owners!)
        sourcePathIndex! + 1 => sourcePathIndex!
    }
    0 => explicitPathIndex!
    explicitPathIndex! < (explicitPaths -> len) -> while {
        explicitPaths[explicitPathIndex!] -> appendUniqueMappedSource(style, canonicalPaths!, owners!)
        explicitPathIndex! + 1 => explicitPathIndex!
    }
    owners!
}

emitDiscoveredAndExplicitChecked paths: move [path.Path; ~], explicitPaths: [Text; ~] -> Int uses Console, File {
    (paths -> len) == 0 -> if {
        "; sollang source root error: source root contains no readable .slg files" -> println
        1
    } else {
        paths -> mapUniqueSources(explicitPaths) => owners
        [Text; ~] => sources!
        0 => sourceIndex!
        sourceIndex! < (owners -> len) -> while {
            owners[sourceIndex!] -> len => sourceLength
            owners[sourceIndex!] -> slice(UIntSize(0), sourceLength) => source
            sources! -> push(source)
            sourceIndex! + 1 => sourceIndex!
        }
        sources! -> llvm.emitChecked
    }
}

emitDiscoveredAndExplicitLinuxChecked paths: move [path.Path; ~], explicitPaths: [Text; ~] -> Int uses Console, File {
    (paths -> len) == 0 -> if {
        "; sollang source root error: source root contains no readable .slg files" -> println
        1
    } else {
        paths -> mapUniqueSources(explicitPaths) => owners
        [Text; ~] => sources!
        0 => sourceIndex!
        sourceIndex! < (owners -> len) -> while {
            owners[sourceIndex!] -> len => sourceLength
            owners[sourceIndex!] -> slice(UIntSize(0), sourceLength) => source
            sources! -> push(source)
            sourceIndex! + 1 => sourceIndex!
        }
        sources! -> llvm.emitLinuxChecked
    }
}

emitDiscoveredAndExplicitWasmChecked paths: move [path.Path; ~], explicitPaths: [Text; ~] -> Int uses Console, File {
    (paths -> len) == 0 -> if {
        "; sollang source root error: source root contains no readable .slg files" -> println
        1
    } else {
        paths -> mapUniqueSources(explicitPaths) => owners
        [Text; ~] => sources!
        0 => sourceIndex!
        sourceIndex! < (owners -> len) -> while {
            owners[sourceIndex!] -> len => sourceLength
            owners[sourceIndex!] -> slice(UIntSize(0), sourceLength) => source
            sources! -> push(source)
            sourceIndex! + 1 => sourceIndex!
        }
        sources! -> llvm.emitWasmChecked
    }
}

sourceRootExitFailure: -> Unit uses Process {
    process.exit(1)
}

collectExplicitPaths explicitStart: UIntSize -> [Text; ~] uses Process {
    process.arguments() => arguments
    [Text; ~] => explicitPaths!
    explicitStart => explicitIndex!
    explicitIndex! < (arguments -> len) -> while {
        explicitPaths! -> push(arguments[explicitIndex!])
        explicitIndex! + 1 => explicitIndex!
    }
    explicitPaths!
}

# Public CLI builds compile the same complete standard-library source root as
# the reference compiler, followed by the explicitly selected product sources.
public emitCheckedRoot root: move path.Path, explicitStart: UIntSize, target: Int -> Int uses Console, File, Process {
    target == 0 -> if {
        explicitStart -> collectExplicitPaths => explicitPaths
        root -> sourceRoot.discoverDirect -> emitDiscoveredAndExplicitChecked(explicitPaths)
    } else {
        target == 1 -> if {
            explicitStart -> collectExplicitPaths => explicitPaths
            root -> sourceRoot.discoverDirect -> emitDiscoveredAndExplicitLinuxChecked(explicitPaths)
        } else {
            explicitStart -> collectExplicitPaths => explicitPaths
            root -> sourceRoot.discoverDirect -> emitDiscoveredAndExplicitWasmChecked(explicitPaths)
        }
    }
}

public emitLinuxCheckedRoot root: move path.Path -> Unit uses Console, File, Process {
    root -> sourceRoot.discover -> when {
        Ok(paths) { paths -> emitDiscoveredLinuxChecked }
        Err(error) {
            "; sollang source root error: " -> print
            error -> println
            1
        }
    } => diagnosticCount
    diagnosticCount > 0 -> if { sourceRootExitFailure() }
}

public emitWasmCheckedRoot root: move path.Path -> Unit uses Console, File, Process {
    root -> sourceRoot.discover -> when {
        Ok(paths) { paths -> emitDiscoveredWasmChecked }
        Err(error) {
            "; sollang source root error: " -> print
            error -> println
            1
        }
    } => diagnosticCount
    diagnosticCount > 0 -> if { sourceRootExitFailure() }
}
