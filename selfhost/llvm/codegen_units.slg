namespace sollang.compiler.llvm.codegen_units

import sollang.compiler.llvm.codegen_cache_policy as cachePolicy

# LLVM fragments are retained as packed little-endian bytes: one UInt64 stores
# up to eight output bytes. Module identity words retain the complete canonical
# namespace bytes so hash ties are ordered by complete identities, never reused
# as if the hash alone were an identity.
public struct PackedFragment {
    public words: [UInt64; ~]
    public byteLength: Int
}

public struct CodegenUnits {
    public kinds: [Int; ~]
    public moduleHashes: [UInt64; ~]
    public interfaceHashes: [UInt64; ~]
    public implementationHashes: [UInt64; ~]
    public identityStarts: [Int; ~]
    public identityLengths: [Int; ~]
    public identityWords: [UInt64; ~]
    public fragmentStarts: [Int; ~]
    public fragmentWordLengths: [Int; ~]
    public fragmentByteLengths: [Int; ~]
    public fragmentWords: [UInt64; ~]
}

# Validation status: 0 valid, 1 truncated, 2 magic, 3 schema, 4 context,
# 5 declared length, 6 envelope checksum, 7 structure, 8 canonical order,
# 9 unit cardinality/kind, 10 invalid/duplicate module identity, 11 fragment checksum.
public struct CodegenValidation {
    public status: Int
    public unitCount: Int
    public moduleCount: Int
    public fragmentByteCount: Int
}

public struct DecodedCodegenUnits {
    public units: CodegenUnits
    public status: Int
}

public struct MergedCodegen {
    public words: [UInt64; ~]
    public byteLength: Int
    public unitCount: Int
    public status: Int
}

struct Utf8Scalar {
    value: Int
    byteLength: Int
}

mix hash: UInt64, value: UInt64 -> UInt64 {
    hash -> cachePolicy.checksumMix(value)
}

lessUnsigned left: UInt64, right: UInt64 -> Bool {
    UInt64(9223372036854775808) => midpoint
    left / midpoint => leftHigh
    right / midpoint => rightHigh
    leftHigh < rightHigh -> if {
        true
    } else {
        leftHigh > rightHigh -> if {
            false
        } else {
            left % midpoint < right % midpoint
        }
    }
}

canRead index: Int, count: Int, length: Int -> Bool {
    index >= 0 and count >= 0 and index <= length and count <= length - index
}

power256 exponent: Int -> UInt64 {
    UInt64(1) => factor!
    0 => index!
    index! < exponent -> while {
        factor! * 256 => factor!
        index! + 1 => index!
    }
    factor!
}

requiredWords byteLength: Int -> Int {
    byteLength / 8 => wordLength!
    byteLength % 8 == 0 -> unless { wordLength! + 1 => wordLength! }
    wordLength!
}

utf8Byte words: ref [UInt64; ~], wordStart: Int, byteOffset: Int, packed: Bool -> UInt64 {
    packed -> if {
        byteOffset % 8 -> power256 => factor
        words[wordStart + byteOffset / 8] / factor % 256
    } else { words[wordStart + byteOffset] }
}

# Identity bytes occupy one word each; fragment bytes occupy little-endian words.
# Both views use the same strict scalar rules without copying their payloads.
utf8Scalar words: ref [UInt64; ~], wordStart: Int, start: Int, end: Int, packed: Bool -> Utf8Scalar {
    Utf8Scalar { value: -1, byteLength: 0 } => invalid
    start < 0 or start >= end
        -> if { invalid -> return }
    packed -> if { end -> requiredWords } else { end } => storageWords
    wordStart -> canRead(storageWords, words -> len)
        -> unless { invalid -> return }
    words -> utf8Byte(wordStart, start, packed) => firstWord
    firstWord > 255 -> if { invalid -> return }
    Int(firstWord) => first
    first < 128 -> if { Utf8Scalar { value: first, byteLength: 1 } -> return }
    0 => width!
    0 => value!
    0 => minimum!
    first >= 194 and first <= 223 -> if {
        2 => width!
        first - 192 => value!
        128 => minimum!
    } else {
        first >= 224 and first <= 239 -> if {
            3 => width!
            first - 224 => value!
            2048 => minimum!
        } else {
            first >= 240 and first <= 244 -> if {
                4 => width!
                first - 240 => value!
                65536 => minimum!
            }
        }
    }
    width! == 0 or width! > end - start -> if { invalid -> return }
    1 => offset!
    offset! < width! -> while {
        words -> utf8Byte(wordStart, start + offset!, packed) => next
        next < 128 or next > 191 -> if { invalid -> return }
        value! * 64 + Int(next) - 128 => value!
        offset! + 1 => offset!
    }
    value! < minimum! or value! > 1114111 or (value! >= 55296 and value! <= 57343)
        -> if { invalid -> return }
    Utf8Scalar { value: value!, byteLength: width! }
}

identityUtf8Valid words: ref [UInt64; ~], start: Int, length: Int -> Bool {
    start -> canRead(length, words -> len) -> unless { false -> return }
    start + length => end
    start => index!
    index! < end -> while {
        words -> utf8Scalar(0, index!, end, false) => scalar
        scalar.value < 0 -> if { false -> return }
        index! + scalar.byteLength => index!
    }
    true
}

packedUtf8Valid words: ref [UInt64; ~], wordStart: Int, byteLength: Int -> Bool {
    byteLength < 0 -> if { false -> return }
    byteLength -> requiredWords => storageWords
    wordStart -> canRead(storageWords, words -> len)
        -> unless { false -> return }
    0 => index!
    index! < byteLength -> while {
        words -> utf8Scalar(wordStart, index!, byteLength, true) => scalar
        scalar.value < 0 -> if { false -> return }
        index! + scalar.byteLength => index!
    }
    true
}

ordinalFirstUnit value: Int -> Int {
    value >= 65536 -> if { 55296 + (value - 65536) / 1024 } else { value }
}

# CSharp StringComparer.Ordinal compares UTF-16 units, not UTF-8 byte order.
# Valid supplementary scalars share their high unit only with supplementary
# scalars; their scalar order then supplies the low-unit comparison.
# Return2 keeps malformed input distinct from equal identities.
identityOrder words: ref [UInt64; ~], leftStart: Int, leftLength: Int, rightStart: Int, rightLength: Int -> Int {
    not (words -> identityUtf8Valid(leftStart, leftLength))
        or not (words -> identityUtf8Valid(rightStart, rightLength))
        -> if { 2 -> return }
    leftStart + leftLength => leftEnd
    rightStart + rightLength => rightEnd
    leftStart => left!
    rightStart => right!
    left! < leftEnd and right! < rightEnd -> while {
        words -> utf8Scalar(0, left!, leftEnd, false) => a
        words -> utf8Scalar(0, right!, rightEnd, false) => b
        a.value != b.value -> if {
            a.value -> ordinalFirstUnit => aFirst
            b.value -> ordinalFirstUnit => bFirst
            aFirst < bFirst or (aFirst == bFirst and a.value < b.value)
                -> if { -1 -> return } else { 1 -> return }
        }
        left! + a.byteLength => left!
        right! + b.byteLength => right!
    }
    left! < leftEnd -> if { 1 -> return }
    right! < rightEnd -> if { -1 -> return }
    0
}

checksum words: [UInt64; ~], start: Int, count: Int, seed: UInt64 -> UInt64 {
    seed => hash!
    0 => index!
    index! < count -> while {
        hash! -> mix(words[start + index!]) => hash!
        index! + 1 => index!
    }
    hash!
}

fragmentChecksum words: [UInt64; ~], start: Int, wordLength: Int, byteLength: Int -> UInt64 {
    cachePolicy.fragmentChecksumSeed() => hash!
    UInt64(byteLength) => byteLengthWord
    hash! -> mix(byteLengthWord) => mixedHash
    mixedHash => hash!
    0 => index!
    index! < wordLength -> while {
        hash! -> mix(words[start + index!]) => nextHash
        nextHash => hash!
        index! + 1 => index!
    }
    hash!
}

identityHash words: [UInt64; ~], start: Int, length: Int -> UInt64 {
    UInt64(1469598103934665603) => hash!
    0 => index!
    index! < length -> while {
        hash! * 1099511628211 + words[start + index!] => hash!
        index! + 1 => index!
    }
    hash!
}

public pack text: Text -> PackedFragment {
    [UInt64; ~] => words!
    Int(text -> len) => byteLength
    0 => byteIndex!
    byteIndex! < byteLength -> while {
        byteIndex! % 8 => byteOffset
        byteOffset == 0 -> if { words! -> push(0) }
        words! -> len => wordCount
        byteOffset -> power256 => factor
        words![wordCount - 1] => currentWord
        text -> byte(UIntSize(byteIndex!)) => currentByte
        currentWord + UInt64(currentByte) * factor => packedWord
        packedWord => words![wordCount - 1]
        byteIndex! + 1 => byteIndex!
    }
    PackedFragment { words: words!, byteLength: byteLength } => result
    result
}

inputShapeValid units: CodegenUnits -> Bool {
    units.kinds -> len => count
    ((units.moduleHashes -> len) == count and (units.interfaceHashes -> len) == count and (units.implementationHashes -> len) == count and (units.identityStarts -> len) == count and (units.identityLengths -> len) == count and (units.fragmentStarts -> len) == count and (units.fragmentWordLengths -> len) == count and (units.fragmentByteLengths -> len) == count) => valid!
    0 => index!
    valid! and index! < count -> while {
        units.identityStarts[index!] -> canRead(units.identityLengths[index!], units.identityWords -> len)
            -> unless { false => valid! }
        valid! -> if {
            units.identityWords -> identityUtf8Valid(units.identityStarts[index!], units.identityLengths[index!])
                -> unless { false => valid! }
        }
        units.fragmentStarts[index!] -> canRead(units.fragmentWordLengths[index!], units.fragmentWords -> len)
            -> unless { false => valid! }
        valid! and units.fragmentByteLengths[index!] >= 0 and units.fragmentWordLengths[index!] == (units.fragmentByteLengths[index!] -> requiredWords)
            -> unless { false => valid! }
        index! + 1 => index!
    }
    valid!
}

unitLess units: CodegenUnits, left: Int, right: Int -> Bool {
    units.kinds[left] < units.kinds[right] -> if {
        true
    } else {
        units.kinds[left] > units.kinds[right] -> if {
            false
        } else {
            units.moduleHashes[left] == units.moduleHashes[right]
                -> if {
                    units.identityWords -> identityOrder(units.identityStarts[left], units.identityLengths[left], units.identityStarts[right], units.identityLengths[right]) == -1
                } else {
                    units.moduleHashes[left] -> lessUnsigned(units.moduleHashes[right])
                }
        }
    }
}

# Schema 1 envelope:
# magic, schema, compiler, target, configuration, unit count, word count,
# checksum, followed by canonical records. Each record is kind, module hash,
# interface hash, implementation hash, identity length, fragment byte length,
# fragment word length, fragment checksum, identity words, fragment words.
public encode units: CodegenUnits, compilerHash: UInt64, targetHash: UInt64, configurationHash: UInt64 -> [UInt64; ~] {
    [UInt64; ~] => words!
    units -> inputShapeValid -> if {
        words! -> push(6002245291164258119)
        words! -> push(1)
        words! -> push(compilerHash)
        words! -> push(targetHash)
        words! -> push(configurationHash)
        words! -> push(UInt64(units.kinds -> len))
        words! -> push(0)
        words! -> push(0)

        [Bool; ~] => emitted!
        0 => emittedIndex!
        emittedIndex! < (units.kinds -> len) -> while {
            emitted! -> push(false)
            emittedIndex! + 1 => emittedIndex!
        }
        0 => emittedCount!
        emittedCount! < (units.kinds -> len) -> while {
            -1 => selected!
            0 => candidate!
            candidate! < (units.kinds -> len) -> while {
                false => candidateLess!
                selected! < 0 -> if {
                    true => candidateLess!
                } else {
                    units -> unitLess(candidate!, selected!) => candidateLess!
                }
                not emitted![candidate!] and candidateLess!
                    -> if { candidate! => selected! }
                candidate! + 1 => candidate!
            }
            true => emitted![selected!]
            units.kinds[selected!] => kind
            units.identityStarts[selected!] => identityStart
            units.identityLengths[selected!] => identityLength
            units.fragmentStarts[selected!] => fragmentStart
            units.fragmentWordLengths[selected!] => fragmentWordLength
            units.fragmentByteLengths[selected!] => fragmentByteLength
            words! -> push(UInt64(kind))
            words! -> push(units.moduleHashes[selected!])
            words! -> push(units.interfaceHashes[selected!])
            words! -> push(units.implementationHashes[selected!])
            words! -> push(UInt64(identityLength))
            words! -> push(UInt64(fragmentByteLength))
            words! -> push(UInt64(fragmentWordLength))
            units.fragmentWords -> fragmentChecksum(fragmentStart, fragmentWordLength, fragmentByteLength) => payloadChecksum
            words! -> push(payloadChecksum)
            0 => identityIndex!
            identityIndex! < identityLength -> while {
                words! -> push(units.identityWords[identityStart + identityIndex!])
                identityIndex! + 1 => identityIndex!
            }
            0 => fragmentIndex!
            fragmentIndex! < fragmentWordLength -> while {
                words! -> push(units.fragmentWords[fragmentStart + fragmentIndex!])
                fragmentIndex! + 1 => fragmentIndex!
            }
            emittedCount! + 1 => emittedCount!
        }
        words! -> len => declaredWordCount
        UInt64(declaredWordCount) => declaredWordCountWord
        declaredWordCountWord => words![6]
        declaredWordCount - 8 => checksumWordCount
        cachePolicy.envelopeChecksumSeed() => checksumSeed
        words! -> checksum(8, checksumWordCount, checksumSeed) => artifactChecksum
        artifactChecksum => words![7]
    }
    words!
}

public validate words: [UInt64; ~], compilerHash: UInt64, targetHash: UInt64, configurationHash: UInt64 -> CodegenValidation {
    words -> len => wordLength
    0 => status!
    0 => unitCount!
    0 => moduleCount!
    0 => fragmentByteCount!
    wordLength >= 8 -> if {
        words[0] == 6002245291164258119 -> unless { 2 => status! }
        status! == 0 and words[1] != 1 -> if { 3 => status! }
        status! == 0 and not (cachePolicy.matchesContext(words[2] == compilerHash, words[3] == targetHash, words[4] == configurationHash))
            -> if { 4 => status! }
        status! == 0 and words[6] != UInt64(wordLength)
            -> if { 5 => status! }
        wordLength - 8 => checksumWordCount
        cachePolicy.envelopeChecksumSeed() => checksumSeed
        words -> checksum(8, checksumWordCount, checksumSeed) => actualChecksum
        status! == 0 and words[7] != actualChecksum
            -> if { 6 => status! }
        status! == 0 -> if {
            words[5] <= 1000000 -> if { Int(words[5]) => unitCount! } else { 7 => status! }
        }
        8 => index!
        -1 => previousKind!
        UInt64(0) => previousModuleHash!
        0 => previousIdentityStart!
        0 => previousIdentityLength!
        0 => prefixCount!
        0 => suffixCount!
        0 => unitIndex!
        status! == 0 and unitIndex! < unitCount! -> while {
            index! -> canRead(8, wordLength) -> if {
                words[index!] <= 2 -> unless {
                    CodegenValidation { status: 9, unitCount: unitCount!, moduleCount: moduleCount!, fragmentByteCount: fragmentByteCount! } -> return
                }
                Int(words[index!]) => kind
                words[index! + 1] => moduleHash
                words[index! + 4] <= 1048576 and words[index! + 4] <= UInt64(wordLength)
                    -> unless { 7 => status! }
                words[index! + 5] <= 1073741824 -> unless { 7 => status! }
                words[index! + 6] <= UInt64(wordLength) -> unless { 7 => status! }
                0 => identityLength!
                0 => fragmentByteLength!
                0 => fragmentWordLength!
                status! == 0 -> if {
                    Int(words[index! + 4]) => identityLength!
                    Int(words[index! + 5]) => fragmentByteLength!
                    Int(words[index! + 6]) => fragmentWordLength!
                }
                status! == 0 and fragmentWordLength! != (fragmentByteLength! -> requiredWords)
                    -> if { 7 => status! }
                index! + 8 => identityStart
                identityStart -> canRead(identityLength!, wordLength) => identityReadable
                status! == 0 and not identityReadable -> if { 7 => status! }
                0 => fragmentStart!
                status! == 0 -> if { identityStart + identityLength! => fragmentStart! }
                fragmentStart! -> canRead(fragmentWordLength!, wordLength) => fragmentReadable
                status! == 0 and not fragmentReadable -> if { 7 => status! }
                status! == 0 -> if {
                    kind < 0 or kind > 2 -> if { 9 => status! }
                    kind < previousKind! -> if { 8 => status! }
                    kind == 0 -> if {
                        prefixCount! + 1 => prefixCount!
                        moduleHash != 0 or identityLength! != 0 -> if { 9 => status! }
                    }
                    kind == 1 -> if {
                        moduleCount! + 1 => moduleCount!
                    }
                    kind == 2 -> if {
                        suffixCount! + 1 => suffixCount!
                        moduleHash != 0 or identityLength! != 0 -> if { 9 => status! }
                    }
                    0 => identityIndex!
                    status! == 0 and identityIndex! < identityLength!
                        -> while {
                            words[identityStart + identityIndex!] <= 255
                                -> unless { 7 => status! }
                            identityIndex! + 1 => identityIndex!
                        }
                    status! == 0 and kind == 1 -> if {
                        words -> identityUtf8Valid(identityStart, identityLength!)
                            -> unless { 10 => status! }
                    }
                    status! == 0 and kind == 1 -> if {
                        words -> identityHash(identityStart, identityLength!) => actualModuleHash
                        actualModuleHash != moduleHash -> if { 10 => status! }
                    }
                    status! == 0 and kind == 1 -> if {
                        previousKind! == 1 -> if {
                            moduleHash == previousModuleHash! -> if {
                                words -> identityOrder(previousIdentityStart!, previousIdentityLength!, identityStart, identityLength!) => order
                                order == 0 or order == 2 -> if { 10 => status! }
                                order == 1 -> if { 8 => status! }
                            } else {
                                previousModuleHash! -> lessUnsigned(moduleHash)
                                    -> unless { 8 => status! }
                            }
                        }
                        moduleHash => previousModuleHash!
                        identityStart => previousIdentityStart!
                        identityLength! => previousIdentityLength!
                    }
                    fragmentByteCount! + fragmentByteLength! => fragmentByteCount!
                    words -> fragmentChecksum(fragmentStart!, fragmentWordLength!, fragmentByteLength!) => actualFragmentChecksum
                    status! == 0 and actualFragmentChecksum != words[index! + 7]
                        -> if { 11 => status! }
                    status! == 0 and fragmentWordLength! > 0 and fragmentByteLength! % 8 != 0
                        -> if {
                            fragmentByteLength! % 8 => usedBytes
                            usedBytes -> power256 => paddingFactor
                            words[fragmentStart! + fragmentWordLength! - 1] / paddingFactor != 0
                                -> if { 7 => status! }
                        }
                    status! == 0 -> if {
                        words -> packedUtf8Valid(fragmentStart!, fragmentByteLength!)
                            -> unless { 7 => status! }
                    }
                    kind => previousKind!
                    fragmentStart! + fragmentWordLength! => index!
                }
            } else { 1 => status! }
            unitIndex! + 1 => unitIndex!
        }
        status! == 0 and index! != wordLength -> if { 7 => status! }
        status! == 0 and (prefixCount! != 1 or suffixCount! != 1)
            -> if { 9 => status! }
    } else { 1 => status! }
    CodegenValidation { status: status!, unitCount: unitCount!, moduleCount: moduleCount!, fragmentByteCount: fragmentByteCount! }
}

public decode words: [UInt64; ~], compilerHash: UInt64, targetHash: UInt64, configurationHash: UInt64 -> DecodedCodegenUnits {
    words -> validate(compilerHash, targetHash, configurationHash) => validation
    [Int; ~] => kinds!
    [UInt64; ~] => moduleHashes!
    [UInt64; ~] => interfaceHashes!
    [UInt64; ~] => implementationHashes!
    [Int; ~] => identityStarts!
    [Int; ~] => identityLengths!
    [UInt64; ~] => identityWords!
    [Int; ~] => fragmentStarts!
    [Int; ~] => fragmentWordLengths!
    [Int; ~] => fragmentByteLengths!
    [UInt64; ~] => fragmentWords!
    validation.status => status
    8 => index!
    0 => unitIndex!
    status == 0 and unitIndex! < validation.unitCount
        -> while {
            Int(words[index!]) => kind
            Int(words[index! + 4]) => identityLength
            Int(words[index! + 5]) => fragmentByteLength
            Int(words[index! + 6]) => fragmentWordLength
            index! + 8 => identityStart
            identityStart + identityLength => fragmentStart
            kinds! -> push(kind)
            moduleHashes! -> push(words[index! + 1])
            interfaceHashes! -> push(words[index! + 2])
            implementationHashes! -> push(words[index! + 3])
            identityStarts! -> push(identityWords! -> len)
            identityLengths! -> push(identityLength)
            0 => identityIndex!
            identityIndex! < identityLength -> while {
                identityWords! -> push(words[identityStart + identityIndex!])
                identityIndex! + 1 => identityIndex!
            }
            fragmentStarts! -> push(fragmentWords! -> len)
            fragmentWordLengths! -> push(fragmentWordLength)
            fragmentByteLengths! -> push(fragmentByteLength)
            0 => fragmentIndex!
            fragmentIndex! < fragmentWordLength -> while {
                fragmentWords! -> push(words[fragmentStart + fragmentIndex!])
                fragmentIndex! + 1 => fragmentIndex!
            }
            fragmentStart + fragmentWordLength => index!
            unitIndex! + 1 => unitIndex!
        }
    CodegenUnits {
        kinds: kinds!
        moduleHashes: moduleHashes!
        interfaceHashes: interfaceHashes!
        implementationHashes: implementationHashes!
        identityStarts: identityStarts!
        identityLengths: identityLengths!
        identityWords: identityWords!
        fragmentStarts: fragmentStarts!
        fragmentWordLengths: fragmentWordLengths!
        fragmentByteLengths: fragmentByteLengths!
        fragmentWords: fragmentWords!
    } => units
    DecodedCodegenUnits { units: units, status: status } => result
    result
}

public merge words: [UInt64; ~], compilerHash: UInt64, targetHash: UInt64, configurationHash: UInt64 -> MergedCodegen {
    words -> validate(compilerHash, targetHash, configurationHash) => validation
    [UInt64; ~] => merged!
    0 => mergedByteLength!
    8 => index!
    0 => unitIndex!
    validation.status == 0 and unitIndex! < validation.unitCount
        -> while {
            Int(words[index! + 4]) => identityLength
            Int(words[index! + 5]) => fragmentByteLength
            Int(words[index! + 6]) => fragmentWordLength
            index! + 8 + identityLength => fragmentStart
            0 => byteIndex!
            byteIndex! < fragmentByteLength -> while {
                byteIndex! / 8 => sourceWordOffset
                byteIndex! % 8 => sourceByteOffset
                sourceByteOffset -> power256 => sourceFactor
                (words[fragmentStart + sourceWordOffset] / sourceFactor) % 256 => value
                mergedByteLength! % 8 => destinationByteOffset
                destinationByteOffset == 0 -> if { merged! -> push(0) }
                destinationByteOffset -> power256 => destinationFactor
                merged! -> len => mergedWordCount
                merged![mergedWordCount - 1] => currentWord
                currentWord + value * destinationFactor => packedWord
                packedWord => merged![mergedWordCount - 1]
                mergedByteLength! + 1 => mergedByteLength!
                byteIndex! + 1 => byteIndex!
            }
            fragmentStart + fragmentWordLength => index!
            unitIndex! + 1 => unitIndex!
        }
    MergedCodegen { words: merged!, byteLength: mergedByteLength!, unitCount: validation.unitCount, status: validation.status } => result
    result
}

streamPrefix: -> Text => "; sollang.codegen.unit "
streamEnd: -> Text => "; sollang.codegen.end"

public beginStreamedUnit kind: Int, identity: Text -> Unit uses Console {
    "; sollang.codegen.unit $kind:$identity" -> println
}

public endStreamedUnits: -> Unit uses Console {
    streamEnd() -> println
}
