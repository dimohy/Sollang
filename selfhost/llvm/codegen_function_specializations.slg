namespace sollang.compiler.llvm.codegen_cache_keys

import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.type_ids as typeIds

public struct FunctionSpecializationRequest {
    public sourceModule: Int
    public ownerSymbol: Int
    public inputTemplate: Int
    public additionalTemplates: [Int; ~]
    public inputTemplates: [Int; ~]
    public actualInputs: [Int; ~]
    public resultType: Int
    public status: Int
    public valueParameterHash: UInt64
    public valueArgument: Int
}

public struct FunctionBinding {
    public active: Bool
    public valueArgument: Int
    public sourceModule: Int
    public ownerSymbol: Int
    public arguments: [Int; ~]
    public argumentIdentities: [Int; ~]
    public inputType: Int
    public returnType: Int
    public additionalTypes: [Int; ~]
}

public unboundFunction: -> FunctionBinding {
    FunctionBinding { active: false, valueArgument: -1, sourceModule: -1, ownerSymbol: -1, arguments: [Int; ~], argumentIdentities: [Int; ~], inputType: -1, returnType: -1, additionalTypes: [Int; ~] }
}

specializeIdentityType types: mut [typeIds.SemanticType; ~], plan: ref FunctionSpecializationRequest, template: Int -> Result<Int, TypeUniverseCaptureError> {
    template < 0 -> if { Result<Int, TypeUniverseCaptureError>.Ok(-1) -> return }
    plan.valueArgument >= 0 -> if {
        types -> typeIds.specializeManyWithIntegerValueInto(plan.inputTemplates, plan.actualInputs, template, plan.valueParameterHash, plan.valueArgument)
    } else { types -> typeIds.specializeManyInto(plan.inputTemplates, plan.actualInputs, template) } => resolved
    resolved.status != 0 or resolved.root < 0 or types[resolved.root].containsParameter
        -> if { Result<Int, TypeUniverseCaptureError>.Err(TypeUniverseCaptureError.InvalidType) -> return }
    Result<Int, TypeUniverseCaptureError>.Ok(resolved.root)
}

public bindFunctionSpecialization prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], plan: ref FunctionSpecializationRequest -> Result<FunctionBinding, TypeUniverseCaptureError> {
    (plan.status != 0 and plan.valueArgument < 0) or plan.sourceModule < 0 or plan.sourceModule >= (prepared.package.ranges -> len) or plan.ownerSymbol < 0
        -> if { Result<FunctionBinding, TypeUniverseCaptureError>.Err(TypeUniverseCaptureError.InvalidType) -> return }
    prepared.package.ranges[plan.sourceModule] => range
    [Int; ~] => arguments!
    plan.valueArgument >= 0 -> if {
        plan.valueParameterHash == 0 -> if { Result<FunctionBinding, TypeUniverseCaptureError>.Err(TypeUniverseCaptureError.InvalidType) -> return }
        plan.inputTemplate >= 0 -> if {
            types -> typeIds.materializedReadTypeId(plan.inputTemplate) => input
            input < 0 or input >= (types -> len) -> if { Result<FunctionBinding, TypeUniverseCaptureError>.Err(TypeUniverseCaptureError.InvalidType) -> return }
            types[input] => array
            array.kind == 4 and array.lengthHash == plan.valueParameterHash
                -> if {
                    (plan.actualInputs -> len) == 0 -> if { Result<FunctionBinding, TypeUniverseCaptureError>.Err(TypeUniverseCaptureError.InvalidType) -> return }
                    types -> typeIds.materializedReadTypeId(plan.actualInputs[0]) => actual
                    actual < 0 or actual >= (types -> len) -> if { Result<FunctionBinding, TypeUniverseCaptureError>.Err(TypeUniverseCaptureError.InvalidType) -> return }
                    (types[actual].kind != 3 and types[actual].kind != 4) or types[actual].first < 0
                        -> if { Result<FunctionBinding, TypeUniverseCaptureError>.Err(TypeUniverseCaptureError.InvalidType) -> return }
                    types[actual].first => element
                    arguments! -> push(element)
                    0 => ordinal!
                    0..<range.symbolCount -> each symbol {
                        prepared.package.symbols[range.symbolStart + symbol] => member
                        member.kind == 32 and member.parent == plan.ownerSymbol
                            -> if {
                                ordinal! > 0 and array.first >= 0 and types[array.first].origin == 3 and types[array.first].symbol == symbol
                                    -> if {
                                        (arguments! -> len) < ordinal! -> while { arguments! -> push(-1) }
                                        arguments! -> push(element)
                                    }
                                ordinal! + 1 => ordinal!
                            }
                    }
                }
        }
    } else {
        0..<range.symbolCount -> each symbol {
            prepared.package.symbols[range.symbolStart + symbol] => member
            member.kind == 32 and member.parent == plan.ownerSymbol
                -> if {
                    -1 => parameter!
                    0..<(types -> len) -> each typeId {
                        types[typeId] => type
                        type.kind == 1 and type.origin == 3 and type.module == plan.sourceModule and type.symbol == symbol
                            -> if { typeId => parameter! }
                    }
                    parameter! < 0 -> if { Result<FunctionBinding, TypeUniverseCaptureError>.Err(TypeUniverseCaptureError.InvalidType) -> return }
                    types -> specializeIdentityType(plan, parameter!) -> when {
                        Err(error) { Result<FunctionBinding, TypeUniverseCaptureError>.Err(error) -> return }
                        Ok(actual) {
                            arguments! -> push(actual)
                        }
                    }
                }
        }
        (arguments! -> len) == 0 or (arguments! -> len) > 3
            -> if { Result<FunctionBinding, TypeUniverseCaptureError>.Err(TypeUniverseCaptureError.InvalidType) -> return }
    }
    types -> specializeIdentityType(plan, plan.inputTemplate) -> when {
        Err(error) { Result<FunctionBinding, TypeUniverseCaptureError>.Err(error) -> return }
        Ok(value) { value }
    } => input
    [Int; ~] => additional!
    plan.additionalTemplates -> each parameter {
        types -> specializeIdentityType(plan, parameter) -> when {
            Err(error) { Result<FunctionBinding, TypeUniverseCaptureError>.Err(error) -> return }
            Ok(actual) { additional! -> push(actual) }
        }
    }
    types -> specializeIdentityType(plan, plan.resultType) -> when {
        Err(error) { Result<FunctionBinding, TypeUniverseCaptureError>.Err(error) -> return }
        Ok(value) { value }
    } => result
    Result<FunctionBinding, TypeUniverseCaptureError>.Ok(FunctionBinding { active: true, valueArgument: plan.valueArgument, sourceModule: plan.sourceModule, ownerSymbol: plan.ownerSymbol, arguments: arguments!, argumentIdentities: [Int; ~], inputType: input, returnType: result, additionalTypes: additional! })
}

public attachFunctionBindingIdentities binding: move FunctionBinding, registeredIds: ref [Int; ~] -> Result<FunctionBinding, TypeUniverseCaptureError> {
    binding => resolved!
    [Int; ~] => identities!
    resolved!.arguments -> each typeId {
        typeId == -1 and resolved!.valueArgument >= 0
            -> if { identities! -> push(-1) } else {
                typeId < 0 or typeId >= (registeredIds -> len) or registeredIds[typeId] < 0
                    -> if { Result<FunctionBinding, TypeUniverseCaptureError>.Err(TypeUniverseCaptureError.InvalidType) -> return }
                identities! -> push(registeredIds[typeId])
            }
    }
    identities! => resolved!.argumentIdentities
    Result<FunctionBinding, TypeUniverseCaptureError>.Ok(resolved!)
}

public captureFunctionSpecialization prepared: ref semanticContext.SemanticSnapshot, types: mut [typeIds.SemanticType; ~], plan: ref FunctionSpecializationRequest, declaredIds: ref [Int; ~] -> Result<FunctionBinding, TypeUniverseCaptureError> {
    prepared -> bindFunctionSpecialization(types, plan) -> when {
        Err(error) { Result<FunctionBinding, TypeUniverseCaptureError>.Err(error) }
        Ok(binding) { binding -> attachFunctionBindingIdentities(declaredIds) }
    }
}
