namespace sollang.compiler.llvm.emitter.mouse_event_runtime

import sollang.compiler.llvm.runtime as runtime

public emitWindowsMouseEventRuntime: -> Unit uses Console {
    """
    declare dllimport i32 @SetConsoleMode(ptr, i32)
    declare dllimport i32 @ReadConsoleInputW(ptr, ptr, i32, ptr)
    declare dllimport ptr @CreateEventA(ptr, i32, i32, ptr)
    declare dllimport i32 @SetEvent(ptr)
    declare dllimport i32 @CancelSynchronousIo(ptr)
    """ -> println
    runtime.mouseWindowsFunctions() -> println
}

public emitLinuxMouseEventRuntime hasTextRuntime: Bool -> Unit uses Console {
    hasTextRuntime -> unless {
        "declare i64 @write(i32, ptr, i64)" -> println
    }
    """
    declare i32 @isatty(i32)
    declare i64 @read(i32, ptr, i64)
    declare i32 @close(i32)
    declare i32 @poll(ptr, i64, i32)
    declare i32 @eventfd(i32, i32)
    declare i32 @tcgetattr(i32, ptr)
    declare i32 @tcsetattr(i32, i32, ptr)
    """ -> println
    runtime.mouseLinuxWorkerFunctions() -> println
    runtime.mouseLinuxLifecycleFunctions() -> println
}
