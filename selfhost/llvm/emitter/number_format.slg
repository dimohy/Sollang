namespace sollang.compiler.llvm.emitter.number_format

import sollang.compiler.llvm.runtime as llvmRuntime

public emitIntFormatRuntime: -> Unit uses Console {
    llvmRuntime.integerFormattingFunctions() -> println
}

public emitIntTextRuntime: -> Unit uses Console {
    """
    define internal void @sollang_runtime_print_i32(ptr %stdout, ptr %written, ptr %ok_state, i32 %value, i1 %newline) {
    entry:
      %buffer = alloca [12 x i8], align 1
      %wide = sext i32 %value to i64
      %length = call i64 @sollang_format_i64(ptr %buffer, i64 %wide)
      call void @sollang_runtime_print(ptr %stdout, ptr %written, ptr %ok_state, ptr %buffer, i64 %length, i1 %newline)
      ret void
    }
    """ -> println
    """
    define internal void @sollang_runtime_print_i64(ptr %stdout, ptr %written, ptr %ok_state, i64 %value, i1 %signed, i1 %newline) {
    entry:
      %buffer = alloca [21 x i8], align 1
      br i1 %signed, label %signed_value, label %unsigned_value
    signed_value:
      %signed_length = call i64 @sollang_format_i64(ptr %buffer, i64 %value)
      br label %emit
    unsigned_value:
      %unsigned_length = call i64 @sollang_format_u64(ptr %buffer, i64 %value)
      br label %emit
    emit:
      %length = phi i64 [ %signed_length, %signed_value ], [ %unsigned_length, %unsigned_value ]
      call void @sollang_runtime_print(ptr %stdout, ptr %written, ptr %ok_state, ptr %buffer, i64 %length, i1 %newline)
      ret void
    }
    """ -> println
}

public emitBoolTextRuntime: -> Unit uses Console {
    """
    @sollang_runtime_bool_true = private constant [4 x i8] c"true"
    @sollang_runtime_bool_false = private constant [5 x i8] c"false"
    define internal void @sollang_runtime_print_i1(ptr %stdout, ptr %written, ptr %ok_state, i1 %value, i1 %newline) {
    entry:
      %data = select i1 %value, ptr @sollang_runtime_bool_true, ptr @sollang_runtime_bool_false
      %length = select i1 %value, i64 4, i64 5
      call void @sollang_runtime_print(ptr %stdout, ptr %written, ptr %ok_state, ptr %data, i64 %length, i1 %newline)
      ret void
    }
    """ -> println
}

public emitIntStandardErrorRuntime: -> Unit uses Console {
    """
    define internal void @sollang_runtime_eprint_i32(i32 %value, i1 %newline) {
    entry:
      %buffer = alloca [12 x i8], align 1
      %wide = sext i32 %value to i64
      %length = call i64 @sollang_format_i64(ptr %buffer, i64 %wide)
      call void @sollang_runtime_eprint(ptr %buffer, i64 %length, i1 %newline)
      ret void
    }
    """ -> println
    """
    define internal void @sollang_runtime_eprint_i64(i64 %value, i1 %signed, i1 %newline) {
    entry:
      %buffer = alloca [21 x i8], align 1
      br i1 %signed, label %signed_value, label %unsigned_value
    signed_value:
      %signed_length = call i64 @sollang_format_i64(ptr %buffer, i64 %value)
      br label %emit
    unsigned_value:
      %unsigned_length = call i64 @sollang_format_u64(ptr %buffer, i64 %value)
      br label %emit
    emit:
      %length = phi i64 [ %signed_length, %signed_value ], [ %unsigned_length, %unsigned_value ]
      call void @sollang_runtime_eprint(ptr %buffer, i64 %length, i1 %newline)
      ret void
    }
    """ -> println
}

public emitBoolStandardErrorRuntime: -> Unit uses Console {
    """
    define internal void @sollang_runtime_eprint_i1(i1 %value, i1 %newline) {
    entry:
      %data = select i1 %value, ptr @sollang_runtime_bool_true, ptr @sollang_runtime_bool_false
      %length = select i1 %value, i64 4, i64 5
      call void @sollang_runtime_eprint(ptr %data, i64 %length, i1 %newline)
      ret void
    }
    """ -> println
}
