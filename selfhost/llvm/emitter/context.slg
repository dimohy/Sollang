namespace sollang.compiler.llvm.emitter.context

import sollang.compiler.ast as ast
import sollang.compiler.ir.interpolation as interpolation
import sollang.compiler.ir.stream as streamIr
import sollang.compiler.ir.typed as typedIr
import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.calls as calls
import sollang.compiler.semantic.composite_types as compositeTypes
import sollang.compiler.semantic.modules as modules
import sollang.compiler.semantic.nominal_types as nominalTypes
import sollang.compiler.semantic.ownership_check as ownershipCheck
import sollang.compiler.semantic.symbols as symbols
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.syntax as syntax
public struct EmitContext {
    sources: [Text; ~]
    ranges: [analysis.SourceAnalysisRange; ~]
    nodes: [ast.AstNode; ~]
    tokens: [syntax.SyntaxToken; ~]
    symbols: [symbols.Symbol; ~]
    calls: [calls.ModuleCallResolution; ~]
    interpolationRanges: [interpolation.InterpolationSourceRange; ~]
    interpolations: [interpolation.InterpolationNode; ~]
    ir: [typedIr.TypedIrNode; ~]
    streamPlan: streamIr.StreamPlan
    moves: [typedIr.MoveEvent; ~]
    nominal: [nominalTypes.NominalType; ~]
    composite: [compositeTypes.CompositeType; ~]
    modules: [modules.ModuleIdentity; ~]
    types: [typeIds.SemanticType; ~]
    fields: [typeIds.NominalField; ~]
    typeSizes: [Int; ~]
    typeAligns: [Int; ~]
    typeLayoutStatuses: [Int; ~]
    typeTraits: [Int; ~]
    pointerBitWidth: Int
    supportsComputePool: Bool
    expectedPathStyle: Int
    ownershipDiagnostics: [ownershipCheck.OwnershipDiagnostic; ~]
}
