public struct InitializerDiagnostic {
    public code: Int
    public sourceModule: Int
    public astNode: Int
    public fieldOrdinal: Int
}

public declarationName context: ref EmitContext, sourceModule: Int, symbol: Int -> Text {
    context.symbolNames -> scopedNames.view(context.ranges[sourceModule].symbolStart + symbol)
}

