namespace sollang.compiler.llvm.emitter.ownership

# The caller builds the transfer bitmap once while it still owns the typed IR.
# This scalar-only boundary avoids copying compiler aggregates across modules.
public enumMatchConsumes consumed: [Bool; ~], candidateIndex: Int, candidateKind: Int, candidateOperand: Int -> Bool {
    false => result!
    (candidateIndex >= 0 and candidateIndex < (consumed -> len)) -> if {
        consumed[candidateIndex] => result!
        (not result!
            and candidateKind == 17
            and candidateOperand >= 0
            and candidateOperand < (consumed -> len)) -> if {
            consumed[candidateOperand] => result!
        }
    }
    result!
}
