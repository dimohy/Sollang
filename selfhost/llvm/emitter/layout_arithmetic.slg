namespace sollang.compiler.llvm.emitter.layout_arithmetic

# Type admission guarantees a positive Int32 bit count. Widen before rounding;
# even the maximum admitted count fits in 33554432 words and 268435456 bytes.
public bitSetWordCount bitCount: Int -> Int {
    Int((Int64(bitCount) + 63) / 64)
}

public struct BoundedArrayLayout {
    public dataOffset: Int
    public size: Int
    public align: Int
}

public enum Error { InvalidInput, Overflow }

public struct BoundedDictionaryLayout {
    public bucketCapacity: Int
    public entriesOffset: Int
    public storageSize: Int
    public size: Int
    public align: Int
}

public boundedDictionaryStorageLayout capacity: Int, entryStride: Int, entryAlign: Int -> Result<BoundedDictionaryLayout, Error> {
    capacity <= 0 or entryStride < 0 or entryAlign < 1
        -> if { Error.InvalidInput -> Result<BoundedDictionaryLayout, Error>.Err -> return }
    Error.Overflow -> Result<BoundedDictionaryLayout, Error>.Err => overflow
    (Int64(capacity) * 8 + 6) / 7 => minimumBuckets
    minimumBuckets > 2147483647 -> if { overflow -> return }
    Int64(16) => buckets!
    buckets! < minimumBuckets -> while {
        buckets! * 2 => buckets!
        buckets! > 2147483647 -> if { overflow -> return }
    }
    buckets! + 16 => controlsEnd
    controlsEnd > 2147483647 -> if { overflow -> return }
    Int64(entryAlign) => fieldAlign
    controlsEnd + fieldAlign > 2147483647 -> if { overflow -> return }
    ((controlsEnd + fieldAlign - 1) / fieldAlign) * fieldAlign => entriesOffset
    buckets! * Int64(entryStride) => payload
    payload > 2147483647 -> if { overflow -> return }
    entriesOffset + payload => end
    end > 2147483647 -> if { overflow -> return }
    entryAlign > 8 -> if { entryAlign } else { 8 } => alignment
    Int64(alignment) => storageAlign
    end + storageAlign > 2147483647 -> if { overflow -> return }
    ((end + storageAlign - 1) / storageAlign) * storageAlign => storageSize
    8 + storageSize => valueEnd
    valueEnd > 2147483647 -> if { overflow -> return }
    valueEnd + storageAlign > 2147483647 -> if { overflow -> return }
    ((valueEnd + storageAlign - 1) / storageAlign) * storageAlign => size
    BoundedDictionaryLayout {
        bucketCapacity: Int(buckets!)
        entriesOffset: Int(entriesOffset)
        storageSize: Int(storageSize)
        size: Int(size)
        align: alignment
    } -> Result<BoundedDictionaryLayout, Error>.Ok
}

# Match TypeDefinitionTable's checked operation order before publishing a size.
public boundedArrayStorageLayout elementSize: Int, elementAlign: Int, capacity: Int -> Result<BoundedArrayLayout, Error> {
    elementSize < 0 or elementAlign < 1 or capacity <= 0
        -> if { Error.InvalidInput -> Result<BoundedArrayLayout, Error>.Err -> return }
    Error.Overflow -> Result<BoundedArrayLayout, Error>.Err => overflow
    Int64(elementAlign) => fieldAlign
    8 + fieldAlign > 2147483647 -> if { overflow -> return }
    ((8 + fieldAlign - 1) / fieldAlign) * fieldAlign => dataOffset
    Int64(elementSize) * Int64(capacity) => payload
    payload > 2147483647 -> if { overflow -> return }
    dataOffset + payload => end
    end > 2147483647 -> if { overflow -> return }
    elementAlign > 8 -> if { elementAlign } else { 8 } => alignment
    end + Int64(alignment) > 2147483647 -> if { overflow -> return }
    ((end + Int64(alignment) - 1) / Int64(alignment)) * Int64(alignment) => size
    BoundedArrayLayout { dataOffset: Int(dataOffset), size: Int(size), align: alignment }
        -> Result<BoundedArrayLayout, Error>.Ok
}
