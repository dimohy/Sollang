namespace sollang.compiler.llvm.emitter.stream_join_runtime

import sollang.compiler.llvm.runtime as runtime

public emitWindowsPlatform: -> Unit uses Console {
    runtime.streamJoinWindowsDeclarations() -> println
    runtime.streamJoinWindowsFunctions() -> println
}

public emitLinuxPlatform: -> Unit uses Console {
    runtime.streamJoinLinuxDeclarations() -> println
    runtime.streamJoinLinuxFunctions() -> println
}

public emitCommon: -> Unit uses Console {
    runtime.streamJoinWorkerFunctions() -> println
    runtime.streamJoinLifecycleFunctions() -> println
}
