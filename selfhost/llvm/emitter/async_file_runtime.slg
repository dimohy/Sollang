namespace sollang.compiler.llvm.emitter.async_file_runtime

import sollang.compiler.llvm.runtime as llvmRuntime

# File and socket Tasks share completion publication, draining and platform
# signals. File worker requests remain a separate optional capability.

emitIoCommonRuntime: -> Unit uses Console {
    llvmRuntime.ioPushCompletionFunction() -> println
    llvmRuntime.ioDrainCompletionsFunction() -> println
    llvmRuntime.ioWaitIdleFunction() -> println
    llvmRuntime.ioShutdownFunction() -> println
}

emitFileSharedRuntime: -> Unit uses Console {
    # The compatibility reader keeps its existing handle/offset storage behind
    # the same platform ABI consumed by the compiled CSharp worker definition.
    """
    define internal %sollang.file_count_result @sollang_platform_read_file_bytes(ptr %data, i64 %length) {
    entry:
      %result = call %sollang.file_count_result @sollang_binary_read(ptr %data, i64 %length)
      ret %sollang.file_count_result %result
    }
    """ -> println
    llvmRuntime.asyncFilePushRequestFunction() -> println
    llvmRuntime.asyncFileWorkerFunction() -> println
    llvmRuntime.asyncFileSubmitFunction() -> println
    llvmRuntime.asyncFileShutdownFunction() -> println
    llvmRuntime.asyncFileTaskWorkerFunction() -> println
    llvmRuntime.asyncFileTaskCancelFunction() -> println
    llvmRuntime.asyncFileOpenTaskStartFunction() -> println
    llvmRuntime.asyncFileBufferTaskStartFunction() -> println
}

public emitSharedRuntime: -> Unit uses Console {
    emitIoCommonRuntime()
    emitFileSharedRuntime()
}

# Socket-only IO owns no file worker. Structured Task scope cleanup precedes
# shutdown, matching the managed runtime's worker-not-started branch.
public emitSharedIoRuntime: -> Unit uses Console {
    emitIoCommonRuntime()
    """
    define internal void @sollang_async_shutdown() {
    entry:
      call void @sollang_io_shutdown()
      ret void
    }
    """ -> println
}

public emitWindowsIoRuntime: -> Unit uses Console {
    llvmRuntime.asyncWindowsIoFunctions() -> println
}

emitWindowsFileRuntime: -> Unit uses Console {
    llvmRuntime.asyncWindowsFileWorkerFunctions() -> println
}

public emitWindowsRuntime: -> Unit uses Console {
    emitWindowsIoRuntime()
    emitWindowsFileRuntime()
}

public emitLinuxIoRuntime: -> Unit uses Console {
    llvmRuntime.asyncLinuxIoFunctions() -> println
}

emitLinuxFileRuntime: -> Unit uses Console {
    llvmRuntime.asyncLinuxFileWorkerFunctions() -> println
}

public emitLinuxRuntime: -> Unit uses Console {
    emitLinuxIoRuntime()
    emitLinuxFileRuntime()
}
