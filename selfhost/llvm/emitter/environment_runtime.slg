namespace sollang.compiler.llvm.emitter.environment_runtime

import sollang.compiler.llvm.runtime as runtime

public emitTypeRuntime: -> Unit uses Console {
    runtime.environmentResultType() -> println
}

public emitWindowsRuntime: -> Unit uses Console {
    runtime.environmentWindowsGlobals() -> println
    runtime.environmentWindowsFunctions() -> println
}

public emitLinuxRuntime: -> Unit uses Console {
    "declare ptr @getenv(ptr)" -> println
    runtime.environmentLinuxFunctions() -> println
}
