      %stdout_error_slot = getelementptr inbounds %sollang.process_capture_stream, ptr %stdout_context, i32 0, i32 6
      store i1 false, ptr %stdout_error_slot, align 1
      %stderr_fd_slot = getelementptr inbounds %sollang.process_capture_stream, ptr %stderr_context, i32 0, i32 0
