      %stderr_limit_slot = getelementptr inbounds %sollang.process_capture_stream, ptr %stderr_context, i32 0, i32 4
      store i64 %stderr_limit, ptr %stderr_limit_slot, align 8
      %stderr_truncated_slot = getelementptr inbounds %sollang.process_capture_stream, ptr %stderr_context, i32 0, i32 5
      store i1 false, ptr %stderr_truncated_slot, align 1
      %stderr_error_slot = getelementptr inbounds %sollang.process_capture_stream, ptr %stderr_context, i32 0, i32 6
      store i1 false, ptr %stderr_error_slot, align 1
