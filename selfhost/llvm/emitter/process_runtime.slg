      %stdout_length_slot = getelementptr inbounds %sollang.process_capture_stream, ptr %stdout_context, i32 0, i32 2
      store i64 0, ptr %stdout_length_slot, align 8
      %stdout_capacity_slot = getelementptr inbounds %sollang.process_capture_stream, ptr %stdout_context, i32 0, i32 3
      store i64 0, ptr %stdout_capacity_slot, align 8
