namespace sollang.compiler.llvm.emitter.compute_runtime

import sollang.compiler.llvm.runtime as llvmRuntime

public emitWindowsComputeRuntime: -> Unit uses Console {
    """
    %sollang.compute_group = type { ptr, ptr, ptr, i64, ptr, ptr, ptr, ptr, ptr, ptr, ptr, i64, ptr }
    @sollang_compute_semaphore = internal global ptr null
    @sollang_compute_completion_event = internal global ptr null
    @sollang_compute_worker_count = internal global i32 0
    @sollang_compute_worker_limit = internal global i32 0
    @sollang_compute_worker_handles = internal global [64 x ptr] zeroinitializer, align 8
    @sollang_compute_group_current = internal global ptr null
    @sollang_compute_next = internal global i64 0
    @sollang_compute_active = internal global i32 0
    @sollang_compute_barrier_departed = internal global i32 0
    @sollang_compute_running = internal global i32 0
    @sollang_compute_peak = internal global i32 0
    @sollang_compute_parent_gate = internal global i32 0
    @sollang_compute_stopping = internal global i32 0
    declare dllimport ptr @CreateEventA(ptr, i32, i32, ptr)
    declare dllimport i32 @SetEvent(ptr)
    declare dllimport ptr @CreateSemaphoreA(ptr, i32, i32, ptr)
    declare dllimport i32 @ReleaseSemaphore(ptr, i32, ptr)
    declare dllimport i32 @ResetEvent(ptr)
    declare dllimport i32 @GetActiveProcessorCount(i16)
    """ -> println
    llvmRuntime.computeWindowsOutputFunctions() -> println
    llvmRuntime.computeWindowsFunctions() -> println
    llvmRuntime.computeQueryFunctions() -> println
}

public emitLinuxComputeRuntime: -> Unit uses Console {
    """
    %sollang.compute_group = type { ptr, ptr, ptr, i64, ptr, ptr, ptr, ptr, ptr, ptr, ptr, i64, ptr }
    @sollang_compute_work_event_fd = internal global i32 -1
    @sollang_compute_completion_event_fd = internal global i32 -1
    @sollang_compute_worker_count = internal global i32 0
    @sollang_compute_worker_limit = internal global i32 0
    @sollang_compute_worker_threads = internal global [64 x i64] zeroinitializer, align 8
    @sollang_compute_group_current = internal global ptr null
    @sollang_compute_next = internal global i64 0
    @sollang_compute_active = internal global i32 0
    @sollang_compute_running = internal global i32 0
    @sollang_compute_peak = internal global i32 0
    @sollang_compute_parent_gate = internal global i32 0
    @sollang_compute_stopping = internal global i32 0
    @sollang_compute_generation = internal global i32 0
    declare i32 @eventfd(i32, i32)
    declare i32 @close(i32)
    declare i64 @read(i32, ptr, i64)
    declare i64 @sysconf(i32)
    declare i64 @syscall(i64, ...)
    """ -> println
    llvmRuntime.computeLinuxOutputFunctions() -> println
    llvmRuntime.computeLinuxFunctions() -> println
    llvmRuntime.computeQueryFunctions() -> println
}

public emitMemoryOutputSinkRuntime: -> Unit uses Console {
    "%sollang.output_sink = type { ptr, i64, i64 }" -> println
    llvmRuntime.memoryOutputSinkFunctions() -> println
}
