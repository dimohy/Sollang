                                    -> if { true => owned! }
                                not completionOnly and (candidate.module -> sourceTokenMatches(candidateSymbol.nameToken, "TcpStream", context))
                                    -> if { true => owned! }
                                not completionOnly and (candidate.module -> sourceTokenMatches(candidateSymbol.nameToken, "UdpSocket", context))
                                    -> if { true => owned! }
                                candidate.module -> sourceTokenMatches(candidateSymbol.nameToken, "CompletionReactor", context)
                                    -> if { true => owned! }
