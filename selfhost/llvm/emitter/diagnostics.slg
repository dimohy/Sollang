            equal! and byteIndex! < actual.span.length -> while {
                context.sources[sourceIndex] -> byte(actual.span.start + byteIndex!) => actualByte
                expected -> byte(byteIndex!) => expectedByte
                actualByte != expectedByte -> if { false => equal! }
                byteIndex! + 1 => byteIndex!
            }
        }
    equal!
