compareOwnedBranchFieldTokens context: ref emitterContext.EmitContext, sourceModule: Int, leftTokenIndex: Int, rightTokenIndex: Int -> Int {
    context.ranges[sourceModule] => sourceRange
    context.tokens[sourceRange.tokenStart + leftTokenIndex] => leftToken
    context.tokens[sourceRange.tokenStart + rightTokenIndex] => rightToken
    leftToken.span.length < rightToken.span.length
        -> if { leftToken.span.length } else { rightToken.span.length } => sharedLength
    0 => order!
    UIntSize(0) => byteIndex!
    order! == 0 and byteIndex! < sharedLength -> while {
        context.sources[sourceModule] -> byte(leftToken.span.start + byteIndex!) => leftByte
        context.sources[sourceModule] -> byte(rightToken.span.start + byteIndex!) => rightByte
        leftByte < rightByte -> if { -1 => order! }
        leftByte > rightByte -> if { 1 => order! }
        byteIndex! + 1 => byteIndex!
    }
    order! == 0 -> if {
        leftToken.span.length < rightToken.span.length
            -> if { -1 => order! }
        leftToken.span.length > rightToken.span.length
            -> if { 1 => order! }
    }
    order!
}

emitOwnedBranchJoinDiagnostic context: ref emitterContext.EmitContext, diagnostic: ownershipCheck.OwnershipDiagnostic -> Unit uses Console {
    [Int; ~] => fieldTokens!
    context.ownershipDiagnostics -> each candidate {
        diagnostic -> ownershipCheck.branchJoinDiagnosticsMatch(candidate, context.ir)
            -> if {
                context -> ownedBranchFieldNameToken(candidate.actualSymbol) => fieldToken
                fieldToken >= 0 -> if { fieldTokens! -> push(fieldToken) }
            }
    }
    0 => fieldIndex!
    fieldIndex! < (fieldTokens! -> len) -> while {
        fieldIndex! => smallest!
        fieldIndex! + 1 => candidateIndex!
        candidateIndex! < (fieldTokens! -> len) -> while {
            context -> compareOwnedBranchFieldTokens(diagnostic.sourceModule, fieldTokens![candidateIndex!], fieldTokens![smallest!]) => fieldOrder
            fieldOrder < 0 -> if { candidateIndex! => smallest! }
            candidateIndex! + 1 => candidateIndex!
        }
        smallest! != fieldIndex! -> if {
            fieldTokens![fieldIndex!] => firstToken
            fieldTokens![smallest!] => fieldTokens![fieldIndex!]
            firstToken => fieldTokens![smallest!]
        }
        fieldIndex! + 1 => fieldIndex!
    }
    diagnostic.actualSymbol => projectionIr!
    0 => projectionDepth!
    projectionIr! >= 0 and projectionIr! < (context.ir -> len)
        and projectionDepth! < (context.ir -> len)
        and (context.ir[projectionIr!].kind == 13 or context.ir[projectionIr!].kind == 15)
        -> while {
            context.ir[projectionIr!].operand0 => projectionIr!
            projectionDepth! + 1 => projectionDepth!
        }
    projectionIr! >= 0 and projectionIr! < (context.ir -> len)
        and (fieldTokens! -> len) > 0
        and context.ir[projectionIr!].payloadToken >= 0
        -> if {
            context.ir[projectionIr!] => rootName
            context.ranges[rootName.sourceModule] => rootRange
            context.tokens[rootRange.tokenStart + rootName.payloadToken] => rootToken
            context.ranges[diagnostic.sourceModule] => fieldRange
            "; sollang error[E20]: partial move of owned field(s) '" -> print
            -1 => previousToken!
            0 => printedFields!
            fieldTokens! -> each fieldTokenIndex {
                previousToken! < 0 or (context -> compareOwnedBranchFieldTokens(diagnostic.sourceModule, previousToken!, fieldTokenIndex)) != 0
                    -> if {
                        printedFields! > 0 -> if { ", " -> print }
                        context.tokens[fieldRange.tokenStart + fieldTokenIndex] => fieldToken
                        context.sources[diagnostic.sourceModule] -> slice(fieldToken.span.start, fieldToken.span.length) -> print
                        printedFields! + 1 => printedFields!
                    }
                fieldTokenIndex => previousToken!
            }
            "' from binding '" -> print
            context.sources[rootName.sourceModule] -> slice(rootToken.span.start, rootToken.span.length) -> print
            "' exits a branch; reinitialize each moved field before the branch exits or return from the moving branch" -> println
        } else {
            diagnostic.span => diagnosticSpan
            "; sollang error[E20]: partial move exits a branch or loop without reinitialization (source $(diagnostic.sourceModule), byte $(diagnosticSpan.start), length $(diagnosticSpan.length))" -> println
        }
}

emitOwnedBindingBranchDiagnostic context: ref emitterContext.EmitContext, diagnostic: ownershipCheck.OwnershipDiagnostic -> Unit uses Console {
    context.ir[diagnostic.actualSymbol] => binding
    context.ranges[binding.sourceModule] => bindingRange
    context.tokens[bindingRange.tokenStart + binding.payloadToken] => nameToken
    context.sources[binding.sourceModule] -> slice(nameToken.span.start, nameToken.span.length) => name
    context.ranges[diagnostic.sourceModule] => range
    context.ir[diagnostic.actualOrigin].astNode => controlAst
    context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.span.start) => location
    "<main>" => moduleName!
    not (context.nodes -> semanticDiagnostics.expressionBelongsToMain(range, controlAst))
        and context.modules[diagnostic.sourceModule].pathLength > 0
        -> if {
            context.modules[diagnostic.sourceModule] => identity
            context.sources[diagnostic.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
        }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] owned binding '$name" -> print
    nameToken.span.start + nameToken.span.length < (context.sources[binding.sourceModule] -> len)
        and (context.sources[binding.sourceModule] -> byte(nameToken.span.start + nameToken.span.length)) == '!'
        -> if { "!" -> print }
    "' must be consumed on every control-flow branch or on none of them" -> println
}

# Borrow provenance selects the existing pattern-transfer diagnostic regardless
# of whether consumption is an affine binding or an enum constructor payload.
emitBorrowedEnumPayloadMessage payloadName: Text -> Unit uses Console {
    "owned enum payload '$payloadName' is borrowed from the matched subject and cannot be moved; match a named owner or an owned temporary to transfer the payload" -> println
}

emitOwnedBindingCreationDiagnostic context: ref emitterContext.EmitContext, diagnostic: ownershipCheck.OwnershipDiagnostic -> Unit uses Console {
    context.ir[diagnostic.actualSymbol] => binding
    context.ranges[diagnostic.sourceModule] => range
    context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.span.start) => location
    "<main>" => moduleName!
    not (context.nodes -> semanticDiagnostics.expressionBelongsToMain(range, binding.astNode))
        and context.modules[diagnostic.sourceModule].pathLength > 0
        -> if {
            context.modules[diagnostic.sourceModule] => identity
            context.sources[diagnostic.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
        }
    diagnostic.expectedSymbol >= 0 -> if {
        context.ir[diagnostic.expectedSymbol] => payload
        context.nodes[range.astStart + payload.astNode] => payloadPattern
        context.tokens[range.tokenStart + payloadPattern.secondaryToken] => payloadToken
        context.sources[diagnostic.sourceModule] -> slice(payloadToken.span.start, payloadToken.span.length) => payloadName
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] " -> print
        payloadName -> emitBorrowedEnumPayloadMessage
    } else {
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] owned container values must be created directly at their binding site in the current slice" -> println
    }
}

# A typed argument retains its declaration type and expression identity. The
# semantic diagnostic owner formats these identities before any LLVM emission.
public emitTypedCallArgumentDiagnostic context: ref emitterContext.EmitContext, callIndex: Int, parameterIndex: Int, argumentIndex: Int, runtimeOrdinal: Int -> Unit uses Console {
    context.ir[callIndex] => call
    context.ir[parameterIndex] => parameter
    context.ir[argumentIndex] => argument
    context.ranges[call.sourceModule] => range
    context.nodes[range.astStart + call.astNode] => callAst
    -1 => pathAst!
    callAst.kind == 16 -> if { call.astNode => pathAst! } else {
        0 => childIndex!
        childIndex! < range.astCount -> while {
            context.nodes[range.astStart + childIndex!] => child
            child.kind == 16 and child.parent == call.astNode
                -> if {
                    pathAst! < 0 -> if { childIndex! => pathAst! } else {
                        child.start > context.nodes[range.astStart + pathAst!].start
                            -> if { childIndex! => pathAst! }
                    }
                }
            childIndex! + 1 => childIndex!
        }
    }
    pathAst! < 0 -> if {
        "sollang: compiler invariant [TYPED_CALL_ARGUMENT_PATH_MISSING]" -> println
        return
    }
    runtimeOrdinal == 0 -> if {
        context -> emitInitializerSemanticPrefix(call.sourceModule, call.astNode)
    } else {
        context -> emitInitializerSemanticPrefix(argument.sourceModule, argument.astNode)
    }
    "function '" -> print
    context -> emitOwnedMoveFunctionName(callIndex, pathAst!)
    "'" -> print
    runtimeOrdinal > 0 -> if {
        context.ranges[parameter.sourceModule] => parameterRange
        context.symbols[parameterRange.symbolStart + parameter.symbol] => parameterSymbol
        context.tokens[parameterRange.tokenStart + parameterSymbol.nameToken] => parameterName
        " parameter '" -> print
        context.sources[parameter.sourceModule] -> slice(parameterName.span.start, parameterName.span.length) -> print
        "'" -> print
    }
    " expects " -> print
    parameter.typeId -> emitBoxOperandTypeName(context)
    " but received " -> print
    argument.typeId -> emitBoxOperandTypeName(context)
    "" -> println
}

emitOwnedMoveFunctionName context: ref emitterContext.EmitContext, callIr: Int, pathAst: Int -> Unit uses Console {
    context.ir[callIr] => irCall
    calls.ModuleCallResolution { sourceModule: irCall.sourceModule, callAst: irCall.astNode, origin: 0, targetModule: irCall.targetModule, targetSourceModule: -1, functionSymbol: irCall.symbol, status: 0 } => call
    context -> emitSemanticCallPathName(call, pathAst, true)
}

# The C# parser expands an explicit import alias before any callable lookup.
# Diagnostic rendering and owned-call diagnostics share that path contract.
# Owned calls additionally require their committed target identity.
emitSemanticCallPathName context: ref emitterContext.EmitContext, call: calls.ModuleCallResolution, pathAst: Int, requireTargetIdentity: Bool -> Unit uses Console {
    context.ranges[call.sourceModule] => range
    context.nodes[range.astStart + pathAst] => path
    -1 => firstIdentifier!
    0 => identifierCount!
    path.firstToken => tokenIndex!
    path.firstToken + path.tokenCount => tokenEnd!
    tokenIndex! < tokenEnd! -> while {
        context.tokens[range.tokenStart + tokenIndex!] => token
        token.kind == grammar.tokenIdLeftParen() or token.kind == grammar.tokenIdLess()
            -> if { tokenIndex! => tokenEnd! }
        tokenIndex! < tokenEnd! and token.kind == grammar.tokenIdIdentifier()
            -> if {
                firstIdentifier! < 0 -> if { tokenIndex! => firstIdentifier! }
                identifierCount! + 1 => identifierCount!
            }
        tokenIndex! + 1 => tokenIndex!
    }
    -1 => selectedImport!
    false => explicitAliasName!
    0 => importIndex!
    firstIdentifier! < 0 -> if { context.imports -> len => importIndex! }
    importIndex! < (context.imports -> len) -> while {
        context.imports[importIndex!] => edge
        importIndex! >= (context.resolvedImports -> len)
            -> if {
                "sollang: compiler invariant [OWNED_MOVE_IMPORT_IDENTITY_MISSING]" -> print
                return
            }
        context.resolvedImports[importIndex!] => resolved
        edge.sourceModule == call.sourceModule and resolved.status == 0
            and (edge.aliasToken < 0 or edge.aliasToken >= range.tokenCount)
            -> if {
                "sollang: compiler invariant [OWNED_MOVE_IMPORT_ALIAS_MISSING]" -> print
                return
            }
        edge.sourceModule == call.sourceModule and resolved.status == 0
            -> if {
                context.tokens[range.tokenStart + edge.aliasToken] => aliasToken
                context.tokens[range.tokenStart + firstIdentifier!] => callerToken
                aliasToken.span.length == callerToken.span.length => equal!
                UIntSize(0) => byteIndex!
                equal! and byteIndex! < aliasToken.span.length
                    -> while {
                        context.sources[call.sourceModule] -> byte(aliasToken.span.start + byteIndex!) => aliasByte
                        context.sources[call.sourceModule] -> byte(callerToken.span.start + byteIndex!) => callerByte
                        aliasByte != callerByte -> if { false => equal! }
                        byteIndex! + 1 => byteIndex!
                    }
                equal! -> if {
                    true => explicitAliasName!
                    not requireTargetIdentity
                        or (resolved.targetModule >= 0 and call.targetModule >= 0
                        and context.modules[resolved.targetModule].pathHash == context.modules[call.targetModule].pathHash)
                        -> if { importIndex! => selectedImport! }
                }
            }
        importIndex! + 1 => importIndex!
    }
    false => openExpansion!
    selectedImport! < 0 and identifierCount! == 1 and not explicitAliasName!
        -> if {
            0 => resolutionIndex!
            resolutionIndex! < (context.calls -> len) -> while {
                context.calls[resolutionIndex!] => resolution
                resolution.sourceModule == call.sourceModule and resolution.callAst == call.callAst
                    and resolution.status == 0 and resolution.origin == 1
                    and resolution.targetModule == call.targetModule and resolution.functionSymbol == call.functionSymbol
                    and resolution.targetSourceModule >= 0 and resolution.targetSourceModule < (context.ranges -> len)
                    and resolution.targetModule >= 0 and resolution.targetModule < (context.modules -> len)
                    and context.modules[resolution.targetModule].pathHash != context.modules[call.sourceModule].pathHash
                    -> if {
                        context.ranges[resolution.targetSourceModule] => targetRange
                        resolution.functionSymbol >= 0 and resolution.functionSymbol < targetRange.symbolCount
                            -> if {
                                context.symbols[targetRange.symbolStart + resolution.functionSymbol] => targetSymbol
                                targetSymbol.kind == 7 and targetSymbol.parent < 0 and targetSymbol.flags / 4 % 2 == 1
                                    -> if {
                                        0 => openImportIndex!
                                        openImportIndex! < (context.imports -> len) -> while {
                                            context.imports[openImportIndex!] => edge
                                            context.resolvedImports[openImportIndex!] => resolved
                                            edge.sourceModule == call.sourceModule and resolved.status == 0
                                                and resolved.targetModule >= 0 and resolved.targetModule < (context.modules -> len)
                                                and context.modules[resolved.targetModule].pathHash == context.modules[resolution.targetModule].pathHash
                                                -> if {
                                                    openImportIndex! => selectedImport!
                                                    true => openExpansion!
                                                    context.imports -> len => openImportIndex!
                                                }
                                            openImportIndex! + 1 => openImportIndex!
                                        }
                                    }
                            }
                    }
                resolutionIndex! + 1 => resolutionIndex!
            }
        }
    selectedImport! < 0 -> if {
        false => printedLocal!
        path.firstToken => localToken!
        localToken! < tokenEnd! -> while {
            context.tokens[range.tokenStart + localToken!] => token
            token.kind == grammar.tokenIdIdentifier() -> if {
                printedLocal! -> if { "." -> print }
                context.sources[call.sourceModule] -> slice(token.span.start, token.span.length) -> print
                true => printedLocal!
            }
            localToken! + 1 => localToken!
        }
        not printedLocal! -> if { "sollang: compiler invariant [OWNED_MOVE_CALL_PATH_MISSING]" -> print }
        return
    }
    context.imports[selectedImport!] => selected
    false => printed!
    0 => importToken!
    importToken! < range.tokenCount -> while {
        context.tokens[range.tokenStart + importToken!] => token
        token.kind == grammar.tokenIdIdentifier() and token.span.start >= selected.pathStart
            and token.span.start < selected.pathStart + selected.pathLength
            -> if {
                printed! -> if { "." -> print }
                context.sources[call.sourceModule] -> slice(token.span.start, token.span.length) -> print
                true => printed!
            }
        importToken! + 1 => importToken!
    }
    firstIdentifier! + 1 => suffixToken!
    openExpansion! -> if { firstIdentifier! => suffixToken! }
    suffixToken! < tokenEnd! -> while {
        context.tokens[range.tokenStart + suffixToken!] => token
        token.kind == grammar.tokenIdIdentifier() -> if {
            "." -> print
            context.sources[call.sourceModule] -> slice(token.span.start, token.span.length) -> print
        }
        suffixToken! + 1 => suffixToken!
    }
}

# Both mutation and return-escape paths display the same numeric index place.
emitCanonicalBorrowIndex context: ref emitterContext.EmitContext, sourceModule: Int, tokenIndex: Int, negative: Bool -> Unit uses Console {
    context.ranges[sourceModule] => range
    context.tokens[range.tokenStart + tokenIndex] => token
    "[" -> print
    token.span.start => cursor!
    token.span.start + token.span.length => end
    cursor! < end -> while {
        context.sources[sourceModule] -> byte(cursor!) => digit
        digit != 48 and digit != 95 -> if { break }
        cursor! + 1 => cursor!
    }
    cursor! == end -> if { "0" -> print } else {
        negative -> if { "-" -> print }
        cursor! < end -> while {
            context.sources[sourceModule] -> byte(cursor!) != 95
                -> if { context.sources[sourceModule] -> slice(cursor!, UIntSize(1)) -> print }
            cursor! + 1 => cursor!
        }
    }
    "]" -> print
}

emitBorrowedTextOriginPlace context: ref emitterContext.EmitContext, placeIr: Int, bindingIr: Int -> Unit uses Console {
    context.ir[bindingIr] => binding
    context.ranges[binding.sourceModule] => bindingRange
    context.tokens[bindingRange.tokenStart + binding.payloadToken] => bindingToken
    context.sources[binding.sourceModule] -> slice(bindingToken.span.start, bindingToken.span.length) -> print
    [Int; ~] => projections!
    placeIr => current!
    current! >= 0 and current! < (context.ir -> len)
        and (projections! -> len) < (context.ir -> len)
        and (context.ir[current!].kind == 13 or context.ir[current!].kind == 15)
        -> while {
            projections! -> push(current!)
            context.ir[current!].operand0 => current!
        }
    (projections! -> len) => remaining!
    remaining! > 0 -> while {
        remaining! - 1 => remaining!
        context.ir[projections![remaining!]] => projection
        context.ranges[projection.sourceModule] => range
        projection.kind == 13 -> if {
            context.nodes[range.astStart + projection.astNode] => fieldAst
            context.tokens -> typeIds.memberNameToken(range.tokenStart, projection.payloadToken, fieldAst.firstToken + fieldAst.tokenCount) => fieldTokenIndex
            fieldTokenIndex < 0
                -> if {
                    "sollang: compiler invariant [BORROWED_TEXT_ORIGIN_FIELD_MISSING]" -> println
                    return
                }
            context.tokens[range.tokenStart + fieldTokenIndex] => fieldToken
            "." -> print
            context.sources[projection.sourceModule] -> slice(fieldToken.span.start, fieldToken.span.length) -> print
        } else {
            projection.operand1 => indexIr!
            false => negative!
            indexIr! >= 0 and indexIr! < (context.ir -> len) and context.ir[indexIr!].kind == 7
                and context.ir[indexIr!].opcode == grammar.tokenIdMinus()
                -> if {
                    context.ir[indexIr!].operand0 => indexIr!
                    true => negative!
                }
            false => literal!
            indexIr! >= 0 and indexIr! < (context.ir -> len) and context.ir[indexIr!].kind == 3
                -> if {
                    context.ir[indexIr!] => index
                    context.ranges[index.sourceModule] => indexRange
                    context.tokens[indexRange.tokenStart + index.payloadToken] => indexToken
                    not (context.sources[index.sourceModule] -> numericLiteralRange.literalUsesFloatingSyntax(indexToken.span.start, indexToken.span.start + indexToken.span.length))
                        -> if {
                            context -> emitCanonicalBorrowIndex(index.sourceModule, index.payloadToken, negative!)
                            true => literal!
                        }
                }
            not literal! -> if { "[*]" -> print }
        }
    }
}

emitReadonlyReferenceLoanPath context: ref emitterContext.EmitContext, loan: ref ownershipCheck.ReadonlyReferenceLoan -> Unit uses Console {
    loan.path -> each step {
        step.kind == 2 -> if {
            step.ordinal == 0 -> if { "[Some]" -> print } else {
                step.ordinal == 1 -> if { "[Ok]" -> print } else { "[Err]" -> print }
            }
        } else {
            step.kind == 0 -> if {
                context.ranges[step.sourceModule] => fieldRange
                context.tokens[fieldRange.tokenStart + step.nameToken] => fieldName
                "." -> print
                context.sources[step.sourceModule] -> slice(fieldName.span.start, fieldName.span.length) -> print
            } else {
                "._$(step.ordinal)" -> print
            }
        }
    }
}

emitBorrowedTextOriginMutationDiagnostic context: ref emitterContext.EmitContext, diagnostic: ownershipCheck.OwnershipDiagnostic -> Unit uses Console {
    diagnostic.expectedSymbol < 0 or diagnostic.expectedSymbol >= (context.ir -> len)
        or diagnostic.actualSymbol < 0 or diagnostic.actualSymbol >= (context.ir -> len)
        or diagnostic.expectedModule < 0 or diagnostic.expectedModule >= (context.ir -> len)
        -> if {
            "sollang: compiler invariant [BORROWED_TEXT_ORIGIN_PLACE_MISSING]" -> println
            return
        }
    context.ir[diagnostic.actualSymbol] => borrowed
    context.ranges[borrowed.sourceModule] => borrowedRange
    context.tokens[borrowedRange.tokenStart + borrowed.payloadToken] => borrowedToken
    context.sources[borrowed.sourceModule] -> slice(borrowedToken.span.start, borrowedToken.span.length) => borrowedName
    context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.span.start) => location
    "<main>" => moduleName!
    not (context.nodes -> semanticDiagnostics.expressionBelongsToMain(borrowedRange, borrowed.astNode))
        and context.modules[diagnostic.sourceModule].pathLength > 0
        -> if {
            context.modules[diagnostic.sourceModule] => identity
            context.sources[diagnostic.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
        }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] cannot move or mutate " -> print
    diagnostic.code == 23 -> if { "owner '" -> print } else { "origin '" -> print }
    context -> emitBorrowedTextOriginPlace(diagnostic.expectedModule, diagnostic.expectedSymbol)
    diagnostic.code == 23 -> if {
        "' while readonly reference '$borrowedName" -> print
    } else {
        "' while borrowed Text view '$borrowedName" -> print
    }
    borrowed.kind == 17 and borrowed.flags % 2 == 1
        -> if { "!" -> print }
    diagnostic.code == 23 and diagnostic.readonlyReferencePath >= 0
        and diagnostic.readonlyReferencePath < (context.readonlyReferencePaths -> len)
        -> if {
            context -> emitReadonlyReferenceLoanPath(context.readonlyReferencePaths[diagnostic.readonlyReferencePath])
        }
    "' is live in this scope" -> println
}

emitReadonlyReferenceArgumentDiagnostic context: ref emitterContext.EmitContext, diagnostic: ownershipCheck.OwnershipDiagnostic -> Unit uses Console {
    context.ranges[diagnostic.sourceModule] => range
    -1 => argumentAst!
    0 => nodeIndex!
    nodeIndex! < range.astCount -> while {
        context.nodes[range.astStart + nodeIndex!] => node
        node.start == diagnostic.span.start and node.length == diagnostic.span.length
            -> if {
                argumentAst! < 0 or node.kind == 36 or node.kind == 41
                    -> if { nodeIndex! => argumentAst! }
            }
        nodeIndex! + 1 => nodeIndex!
    }
    argumentAst! < 0 -> if {
        "sollang: compiler invariant [READONLY_REFERENCE_ARGUMENT_AST_MISSING]" -> println
        return
    }
    context.nodes[range.astStart + argumentAst!] => argument
    diagnostic.span.start => offset!
    argument.kind == 36 or argument.kind == 41 -> if {
        context.tokens[range.tokenStart + argument.payloadToken].span.start => offset!
    }
    context -> emitInitializerSemanticPrefixAtOffset(diagnostic.sourceModule, argumentAst!, offset!)
    context.ranges[diagnostic.expectedModule] => functionRange
    context.symbols[functionRange.symbolStart + diagnostic.functionSymbol] => functionSymbol
    context.tokens[functionRange.tokenStart + functionSymbol.nameToken] => functionName
    "function '" -> print
    context.sources[diagnostic.expectedModule] -> slice(functionName.span.start, functionName.span.length) -> print
    "' requires an addressable owner or reference; literals and temporary values cannot be borrowed" -> println
}

emitBorrowedOwnedMoveDiagnostic context: ref emitterContext.EmitContext, diagnostic: ownershipCheck.OwnershipDiagnostic -> Unit uses Console {
    context.ir -> ownershipCheck.placeProjectionRoot(diagnostic.actualSymbol) => rootIr
    context.ir[rootIr] => root
    context.ranges[root.sourceModule] => rootRange
    context.tokens[rootRange.tokenStart + root.payloadToken] => nameToken
    context.sources[root.sourceModule] -> slice(nameToken.span.start, nameToken.span.length) => name
    context.ir[diagnostic.actualBuiltin] => call
    context.ranges[call.sourceModule] => callRange
    diagnostic.expectedModule < 0 or diagnostic.expectedModule >= callRange.astCount
        -> if {
            "sollang: compiler invariant [OWNED_MOVE_CALL_PATH_MISSING]" -> println
            return
        }
    context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.span.start) => location
    context.ir[diagnostic.actualSymbol] => argument
    context.ranges[diagnostic.sourceModule] => sourceRange
    "<main>" => moduleName!
    context.nodes -> semanticDiagnostics.expressionBelongsToMain(sourceRange, argument.astNode) => inMain
    not inMain and context.modules[diagnostic.sourceModule].pathLength > 0
        -> if {
            context.modules[diagnostic.sourceModule] => identity
            context.sources[diagnostic.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
        }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] owned value '$name' is borrowed and cannot be passed to move input of function '" -> print
    context -> emitOwnedMoveFunctionName(diagnostic.actualBuiltin, diagnostic.expectedModule)
    "'; transfer ownership with a move input such as '$name: move " -> print
    diagnostic.actualOrigin -> emitBoxOperandTypeName(context)
    "', or keep the called input readonly/copy the value explicitly" -> println
}

emitBorrowedOwnedStorageOrResultDiagnostic context: ref emitterContext.EmitContext, diagnostic: ownershipCheck.OwnershipDiagnostic -> Unit uses Console {
    context.ir[diagnostic.actualSymbol] => borrowedUse
    context.ranges[borrowedUse.sourceModule] => range
    context.tokens[range.tokenStart + borrowedUse.payloadToken] => nameToken
    context.sources[borrowedUse.sourceModule] -> slice(nameToken.span.start, nameToken.span.length) => name
    context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.span.start) => location
    "<main>" => moduleName!
    not (context.nodes -> semanticDiagnostics.expressionBelongsToMain(range, borrowedUse.astNode))
        and context.modules[diagnostic.sourceModule].pathLength > 0
        -> if {
            context.modules[diagnostic.sourceModule] => identity
            context.sources[diagnostic.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
        }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] " -> print
    diagnostic.code == 31 -> if {
        "borrowed owned value '$name' cannot be copied into array storage; transfer an owned value instead" -> println
    } else {
        diagnostic.code == 25 -> if {
            diagnostic.expectedOrigin == 1 -> if {
                "owned container block results must move a block-local owner, not an owner from an outer scope" -> println
            } else {
                "owned value '$name' is borrowed and cannot escape in an owned result; declare the parameter as '$name: move ...' to transfer ownership, or keep the result borrowed/copy the value explicitly" -> println
            }
        } else {
            "owned value '$name' is borrowed and cannot be stored in " -> print
            diagnostic.code == 26 and diagnostic.expectedOrigin == 1
                -> if {
                    context.ir[diagnostic.expectedModule] => assignment
                    context.types -> typeIds.materializedReadTypeId(context.ir[assignment.operand1].typeId) => ownerTypeId
                    context.ranges[assignment.sourceModule] => assignmentRange
                    context.nodes[assignmentRange.astStart + assignment.astNode] => assignmentAst
                    context.tokens[assignmentRange.tokenStart + assignmentAst.secondaryToken] => fieldToken
                    "owned field '" -> print
                    ownerTypeId -> emitBoxOperandTypeName(context)
                    "." -> print
                    context.sources[assignment.sourceModule] -> slice(fieldToken.span.start, fieldToken.span.length) -> print
                    "'" -> print
                } else {
                    diagnostic.code == 26 and diagnostic.expectedOrigin == 2
                        -> if {
                            "owned indexed storage" -> print
                        } else {
                            diagnostic.code == 26 and diagnostic.expectedOrigin == 3
                                -> if {
                                    context.ir[diagnostic.expectedModule] => binding
                                    context.ranges[binding.sourceModule] => bindingRange
                                    context.tokens[bindingRange.tokenStart + binding.payloadToken] => bindingToken
                                    "owned binding '" -> print
                                    context.sources[binding.sourceModule] -> slice(bindingToken.span.start, bindingToken.span.length) -> print
                                    "'" -> print
                                } else {
                                    "owned container storage" -> print
                                }
                        }
                }
            "; transfer ownership with a move input such as '$name: move ...', or store a borrowed view/copy the value explicitly" -> println
        }
    }
}

emitOwnedBindingRootInvariant: -> Unit uses Console {
    "; sollang invariant error: owned binding diagnostic has no verified binding origin" -> println
}

ownedBindingFieldNameToken context: ref emitterContext.EmitContext, fieldIr: Int -> Int {
    fieldIr >= 0 and fieldIr < (context.ir -> len)
        -> unless { -1 -> return }
    context.ir[fieldIr] => field
    field.kind == 13 and field.sourceModule >= 0 and field.sourceModule < (context.ranges -> len)
        -> unless { -1 -> return }
    context.ranges[field.sourceModule] => range
    field.astNode >= 0 and field.astNode < range.astCount
        and field.payloadToken >= 0 and field.payloadToken < range.tokenCount
        -> unless { -1 -> return }
    context.nodes[range.astStart + field.astNode] => fieldAst
    fieldAst.kind == 36 and fieldAst.firstToken >= 0 and fieldAst.tokenCount > 0
        and fieldAst.firstToken + fieldAst.tokenCount <= range.tokenCount
        and field.payloadToken >= fieldAst.firstToken
        and field.payloadToken < fieldAst.firstToken + fieldAst.tokenCount
        -> unless { -1 -> return }
    context.tokens[range.tokenStart + field.payloadToken].kind == grammar.tokenIdDot()
        -> unless { -1 -> return }
    -1 => nameToken!
    field.payloadToken + 1 => tokenIndex!
    tokenIndex! < fieldAst.firstToken + fieldAst.tokenCount
        -> while {
            context.tokens[range.tokenStart + tokenIndex!].kind == grammar.tokenIdIdentifier()
                -> if { tokenIndex! => nameToken! }
            tokenIndex! + 1 => tokenIndex!
        }
    nameToken!
}

emitOwnedBindingFieldPath context: ref emitterContext.EmitContext, fieldIr: Int -> Unit uses Console {
    [Int; ~] => fields!
    fieldIr => root!
    0 => depth!
    root! >= 0 and root! < (context.ir -> len) and context.ir[root!].kind == 13 and depth! < (context.ir -> len)
        -> while {
            context -> ownedBindingFieldNameToken(root!) => fieldToken
            fields! -> push(fieldToken)
            context.ir[root!].operand0 => root!
            depth! + 1 => depth!
        }
    context.ir[root!] => owner
    context.ranges[owner.sourceModule] => range
    context.tokens[range.tokenStart + owner.payloadToken] => ownerToken
    context.sources[owner.sourceModule] -> slice(ownerToken.span.start, ownerToken.span.length) -> print
    fields! -> len => ordinal!
    ordinal! > 0 -> while {
        ordinal! - 1 => ordinal!
        context.tokens[range.tokenStart + fields![ordinal!]] => fieldToken
        "." -> print
        context.sources[owner.sourceModule] -> slice(fieldToken.span.start, fieldToken.span.length) -> print
    }
}

emitAggregateTransferOverlapDiagnostic context: ref emitterContext.EmitContext, diagnostic: ownershipCheck.OwnershipDiagnostic -> Unit uses Console {
    diagnostic.actualSymbol >= 0 and diagnostic.actualSymbol < (context.ir -> len)
        -> unless {
            emitOwnedBindingRootInvariant()
            return
        }
    context.ir[diagnostic.actualSymbol] => owner
    owner.kind == 5 and owner.sourceModule >= 0 and owner.sourceModule < (context.ranges -> len)
        -> unless {
            emitOwnedBindingRootInvariant()
            return
        }
    context.ranges[owner.sourceModule] => range
    owner.payloadToken >= 0 and owner.payloadToken < range.tokenCount
        -> unless {
            emitOwnedBindingRootInvariant()
            return
        }
    context.tokens[range.tokenStart + owner.payloadToken] => token
    context.nodes[range.astStart + owner.astNode] => ownerAst
    context.sources[owner.sourceModule] -> slice(ownerAst.start, ownerAst.length) => name
    diagnostic.expectedSymbol >= 0 and diagnostic.expectedSymbol < (context.ir -> len)
        -> unless {
            emitOwnedBindingRootInvariant()
            return
        }
    context.ir[diagnostic.expectedSymbol] => constructor
    constructor.sourceModule >= 0 and constructor.sourceModule < (context.ranges -> len)
        -> unless {
            emitOwnedBindingRootInvariant()
            return
        }
    context.ranges[constructor.sourceModule] => constructorRange
    constructor.astNode >= 0 and constructor.astNode < constructorRange.astCount
        -> unless {
            emitOwnedBindingRootInvariant()
            return
        }
    context.nodes[constructorRange.astStart + constructor.astNode] => constructorAst
    context.sources[constructor.sourceModule] -> syntaxDiagnostics.sourceLocation(constructorAst.start) => location
    "<main>" => moduleName!
    not (context.nodes -> semanticDiagnostics.expressionBelongsToMain(constructorRange, constructor.astNode))
        and context.modules[constructor.sourceModule].pathLength > 0
        -> if {
            context.modules[constructor.sourceModule] => identity
            context.sources[constructor.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
        }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] owned binding '$name' cannot initialize more than one aggregate position" -> println
}

emitFirstOwnedBindingDiagnostic context: ref emitterContext.EmitContext -> Unit uses Console {
    context.firstOwnedBindingDiagnostic => index
    index >= 0 and index < (context.ownershipDiagnostics -> len)
        -> unless {
            emitOwnedBindingRootInvariant()
            return
        }
    context.ownershipDiagnostics[index] => diagnostic
    diagnostic.code == ownershipCheck.aggregateTransferOverlapCode()
        -> if {
            context -> emitAggregateTransferOverlapDiagnostic(diagnostic)
            return
        }
    diagnostic.actualSymbol => bindingIr!
    diagnostic.code == 36 -> if { diagnostic.expectedSymbol => bindingIr! }
    diagnostic.code == 38 -> if {
        bindingIr! >= 0 and bindingIr! < (context.ir -> len)
            -> unless {
                emitOwnedBindingRootInvariant()
                return
            }
        context.ir[bindingIr!].parent => bindingIr!
    }
    diagnostic.code == 17 -> if {
        0 => depth!
        bindingIr! >= 0 and bindingIr! < (context.ir -> len)
            and context.ir[bindingIr!].kind != 17 and depth! < (context.ir -> len)
            -> while {
                context.ir[bindingIr!].parent => bindingIr!
                depth! + 1 => depth!
            }
    }
    bindingIr! >= 0 and bindingIr! < (context.ir -> len)
        -> unless {
            emitOwnedBindingRootInvariant()
            return
        }
    context.ir[bindingIr!] => binding
    binding.kind == 17 and binding.sourceModule == diagnostic.sourceModule
        and binding.sourceModule >= 0 and binding.sourceModule < (context.ranges -> len)
        -> unless {
            emitOwnedBindingRootInvariant()
            return
        }
    context.ranges[binding.sourceModule] => range
    binding.astNode >= 0 and binding.astNode < range.astCount
        and binding.payloadToken >= 0 and binding.payloadToken < range.tokenCount
        -> unless {
            emitOwnedBindingRootInvariant()
            return
        }
    context.nodes[range.astStart + binding.astNode] => bindingAst
    bindingAst.kind == 9 or bindingAst.kind == 61
        -> unless {
            emitOwnedBindingRootInvariant()
            return
        }
    diagnostic.code == 34 -> if {
        context -> emitOwnedBindingCreationDiagnostic(diagnostic)
        return
    }
    diagnostic.code == 17 or diagnostic.code == 36 or diagnostic.code == 38
        -> unless {
            emitOwnedBindingRootInvariant()
            return
        }
    diagnostic.actualSymbol >= 0 and diagnostic.actualSymbol < (context.ir -> len)
        -> unless {
            emitOwnedBindingRootInvariant()
            return
        }
    context.ir[diagnostic.actualSymbol] => value
    value.sourceModule == binding.sourceModule
        -> unless {
            emitOwnedBindingRootInvariant()
            return
        }
    diagnostic.code != 38 -> if {
        value.payloadToken >= 0 and value.payloadToken < range.tokenCount
            -> unless {
                emitOwnedBindingRootInvariant()
                return
            }
    }
    diagnostic.code == 36 and (diagnostic.actualBuiltin < -1 or diagnostic.actualBuiltin > 1)
        -> if {
            emitOwnedBindingRootInvariant()
            return
        }
    # Validate every field token/root before printing a selected field path.
    diagnostic.code == 36 or diagnostic.code == 38
        -> if {
            diagnostic.actualSymbol => root!
            0 => depth!
            root! >= 0 and root! < (context.ir -> len) and context.ir[root!].kind == 13 and depth! < (context.ir -> len)
                -> while {
                    context.ir[root!] => field
                    context -> ownedBindingFieldNameToken(root!) => fieldNameToken
                    field.sourceModule == binding.sourceModule and fieldNameToken >= 0
                        and fieldNameToken < range.tokenCount
                        -> unless {
                            emitOwnedBindingRootInvariant()
                            return
                        }
                    field.operand0 => root!
                    depth! + 1 => depth!
                }
            root! >= 0 and root! < (context.ir -> len)
                -> unless {
                    emitOwnedBindingRootInvariant()
                    return
                }
            context.ir[root!] => owner
            owner.kind == 5 and owner.sourceModule == binding.sourceModule
                and owner.payloadToken >= 0 and owner.payloadToken < range.tokenCount
                -> unless {
                    emitOwnedBindingRootInvariant()
                    return
                }
        }
    context.tokens[range.tokenStart + binding.payloadToken] => nameToken
    context.sources[binding.sourceModule] -> syntaxDiagnostics.sourceLocation(nameToken.span.start) => location
    "<main>" => moduleName!
    not (context.nodes -> semanticDiagnostics.expressionBelongsToMain(range, binding.astNode))
        and context.modules[binding.sourceModule].pathLength > 0
        -> if {
            context.modules[binding.sourceModule] => identity
            context.sources[binding.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
        }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] " -> print
    diagnostic.code == 38 -> if {
        "owned field '" -> print
        context -> emitOwnedBindingFieldPath(diagnostic.actualSymbol)
        "' overlaps an already moved field" -> println
        return
    }
    diagnostic.code == 17 -> if {
        context.tokens[range.tokenStart + value.payloadToken] => valueToken
        "owned binding '" -> print
        context.sources[value.sourceModule] -> slice(valueToken.span.start, valueToken.span.length) -> print
        "' is partially moved; use only live sibling fields" -> println
    } else {
        diagnostic.actualBuiltin == 1 -> if {
            "owned nested field '" -> print
            context -> emitOwnedBindingFieldPath(diagnostic.actualSymbol)
            "' cannot be moved from a mutable borrow in the current slice because nested field assignment is not supported; use a move input for the containing owner or borrow the field for a readonly call" -> println
            return
        }
        "owned field '" -> print
        context -> emitOwnedBindingFieldPath(diagnostic.actualSymbol)
        "' moved from a mutable borrow must be reinitialized by the immediately following infallible statement; write 'replacement => " -> print
        context -> emitOwnedBindingFieldPath(diagnostic.actualSymbol)
        "' without '?' before any use, control flow, or early return" -> println
    }
}

emitBorrowedTextDeclarationName context: ref emitterContext.EmitContext, sourceModule: Int, functionSymbol: Int -> Unit uses Console {
    context.ranges[sourceModule] => range
    context.symbols[range.symbolStart + functionSymbol] => function
    function.kind == 31 and function.parent >= 0 -> if {
        context.symbols[range.symbolStart + function.parent] => implementationSymbol
        -1 => ownerAst!
        UIntSize(0) => ownerStart!
        0 => localAst!
        localAst! < range.astCount -> while {
            context.nodes[range.astStart + localAst!] => node
            (node.kind == 12 or node.kind == 16) and node.parent == implementationSymbol.astNode
                and (ownerAst! < 0 or node.start > ownerStart!)
                -> if {
                    localAst! => ownerAst!
                    node.start => ownerStart!
                }
            localAst! + 1 => localAst!
        }
        -1 => ownerType!
        context.typeReferences -> each reference {
            reference.sourceModule == sourceModule and reference.typeAst == ownerAst! and reference.status == 0
                -> if { reference.typeId => ownerType! }
        }
        ownerType! >= 0 -> if {
            ownerType! -> emitBoxOperandTypeName(context)
            "." -> print
        } else {
            "sollang: compiler invariant [BORROWED_RETURN_IMPL_OWNER_MISSING]" -> print
            return
        }
    } else {
        function.parent >= 0 -> if {
            context.symbols[range.symbolStart + function.parent] => parent
            parent.kind == 7 or parent.kind == 31 -> if {
                context -> emitBorrowedTextDeclarationName(sourceModule, function.parent)
                "." -> print
            } else {
                context.modules[sourceModule] => module
                module.pathLength > 0 -> if {
                    context.sources[sourceModule] -> slice(module.pathStart, module.pathLength) -> print
                    "." -> print
                }
            }
        } else {
            context.modules[sourceModule] => module
            module.pathLength > 0 -> if {
                context.sources[sourceModule] -> slice(module.pathStart, module.pathLength) -> print
                "." -> print
            }
        }
    }
    context.tokens[range.tokenStart + function.nameToken] => name
    context.sources[sourceModule] -> slice(name.span.start, name.span.length) -> print
}

emitBorrowedTextOriginProjection context: ref emitterContext.EmitContext, placeIr: Int -> Unit uses Console {
    [Int; ~] => projections!
    placeIr => current!
    0 => edges!
    current! >= 0 and current! < (context.ir -> len) and edges! < (context.ir -> len)
        and (context.ir[current!].kind == 13 or context.ir[current!].kind == 15)
        -> while {
            projections! -> push(current!)
            context.ir[current!].operand0 => current!
            edges! + 1 => edges!
        }
    projections! -> len => projection!
    projection! > 0 -> while {
        projection! - 1 => projection!
        context.ir[projections![projection!]] => node
        node.kind == 13 -> if {
            context -> ownedBindingFieldNameToken(projections![projection!]) => tokenIndex
            context.ranges[node.sourceModule] => range
            context.tokens[range.tokenStart + tokenIndex] => token
            "." -> print
            context.sources[node.sourceModule] -> slice(token.span.start, token.span.length) -> print
        } else {
            node.operand1 => indexIr!
            false => negative!
            indexIr! >= 0 and context.ir[indexIr!].kind == 7 and context.ir[indexIr!].opcode == grammar.tokenIdMinus()
                -> if {
                    true => negative!
                    context.ir[indexIr!].operand0 => indexIr!
                }
            indexIr! >= 0 and context.ir[indexIr!].kind == 3
                -> if {
                    context.ir[indexIr!] => literal
                    context.ranges[literal.sourceModule] => range
                    context.nodes[range.astStart + literal.astNode] => literalAst
                    context -> emitCanonicalBorrowIndex(literal.sourceModule, literalAst.firstToken, negative!)
                } else { "[*]" -> print }
        }
    }
}

emitBorrowedTextReturnInference context: ref emitterContext.EmitContext, diagnostic: ownershipCheck.OwnershipDiagnostic -> Unit uses Console {
    context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.span.start) => location
    "<main>" => moduleName!
    context.modules[diagnostic.sourceModule] => module
    module.pathLength > 0 -> if {
        context.sources[diagnostic.sourceModule] -> slice(module.pathStart, module.pathLength) => moduleName!
    }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] function '" -> print
    context -> emitBorrowedTextDeclarationName(diagnostic.sourceModule, diagnostic.functionSymbol)
    "' cannot return Text storage after slicing borrowed SourceText; return a value whose borrowed Text origins can be inferred from its inputs or copy into an owned text type" -> println
}

emitBorrowedTextReturnEscape context: ref emitterContext.EmitContext, diagnostic: ownershipCheck.OwnershipDiagnostic -> Unit uses Console {
    context.ir[diagnostic.expectedSymbol] => owner
    context.ranges[owner.sourceModule] => ownerRange
    context.symbols[ownerRange.symbolStart + owner.symbol] => ownerSymbol
    context.tokens[ownerRange.tokenStart + ownerSymbol.nameToken] => ownerToken
    context.sources[owner.sourceModule] -> slice(ownerToken.span.start, ownerToken.span.length) => name
    context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.span.start) => location
    "<main>" => moduleName!
    context.modules[diagnostic.sourceModule].pathLength > 0
        -> if {
            context.modules[diagnostic.sourceModule] => identity
            context.sources[diagnostic.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
        }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] borrowed origin '$name" -> print
    context -> emitBorrowedTextOriginProjection(diagnostic.expectedModule)
    diagnostic.code == ownershipCheck.borrowedTextBlockEscapeCode()
        -> if {
            "' cannot escape its block through a Text result" -> println
            return
        }
    "' cannot escape function '" -> print
    context -> emitBorrowedTextDeclarationName(diagnostic.sourceModule, diagnostic.functionSymbol)
    "' through its return value" -> println
}

borrowedTextReturnOwnsAst context: ref emitterContext.EmitContext, diagnostic: ownershipCheck.OwnershipDiagnostic, sourceModule: Int, localAst: Int -> Bool {
    sourceModule != diagnostic.sourceModule or localAst < 0
        -> if { false -> return }
    context.ranges[sourceModule] => range
    context.symbols[range.symbolStart + diagnostic.functionSymbol].astNode => functionAst
    localAst => ancestor!
    0 => edges!
    ancestor! >= 0 and ancestor! < range.astCount and edges! < range.astCount
        -> while {
            ancestor! == functionAst -> if { true -> return }
            context.nodes[range.astStart + ancestor!] => node
            # A nested function is a separate inference and return owner.
            node.kind == 7 or node.kind == 31 -> if { false -> return }
            node.parent => ancestor!
            edges! + 1 => edges!
        }
    false
}

isFunctionReturnDiagnostic diagnostic: ownershipCheck.OwnershipDiagnostic -> Bool {
    (diagnostic.code == ownershipCheck.borrowedTextReturnEscapeCode()
        or diagnostic.code == ownershipCheck.borrowedTextReturnInferenceCode()
        or diagnostic.code == ownershipCheck.functionReturnCompatibilityCode()
        or diagnostic.code == ownershipCheck.deferredFunctionReturnCode()
        or diagnostic.code == ownershipCheck.localArraySliceReturnCode()
        or diagnostic.code == 32
        or (diagnostic.code == 22 and diagnostic.functionSymbol >= 0
        and diagnostic.expectedSymbol == -1 and diagnostic.expectedModule == diagnostic.sourceModule
        and diagnostic.actualBuiltin == -1))
}

functionReturnDiagnosticPhase diagnostic: ownershipCheck.OwnershipDiagnostic -> Int {
    diagnostic.code == ownershipCheck.functionReturnCompatibilityCode() or diagnostic.code == ownershipCheck.localArraySliceReturnCode()
        -> if {
            diagnostic.actualOrigin == 23 -> if { 0 -> return }
            2 -> return
        }
    diagnostic.code == ownershipCheck.borrowedTextReturnEscapeCode()
        -> if {
            diagnostic.actualBuiltin == 23 -> if { 1 -> return }
            3 -> return
        }
    diagnostic.code == ownershipCheck.deferredFunctionReturnCode()
        -> if { 4 -> return }
    diagnostic.code == 22 -> if { 5 -> return }
    6
}

emitFunctionReturnPrefix context: ref emitterContext.EmitContext, diagnostic: ownershipCheck.OwnershipDiagnostic -> Unit uses Console {
    diagnostic.span.start => displayStart!
    diagnostic.code == 22 or diagnostic.code == 32
        -> if {
            context.ranges[diagnostic.sourceModule] => declarationRange
            context.symbols[declarationRange.symbolStart + diagnostic.functionSymbol] => declaration
            context.tokens[declarationRange.tokenStart + declaration.nameToken].span.start => displayStart!
        }
    context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(displayStart!) => location
    "<main>" => moduleName!
    context.ranges[diagnostic.sourceModule] => range
    context.symbols[range.symbolStart + diagnostic.functionSymbol] => function
    not (context.nodes -> semanticDiagnostics.expressionBelongsToMain(range, function.astNode))
        and context.modules[diagnostic.sourceModule].pathLength > 0
        -> if {
            context.modules[diagnostic.sourceModule] => identity
            context.sources[diagnostic.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
        }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] " -> print
}

emitFunctionReturnCompatibility context: ref emitterContext.EmitContext, diagnostic: ownershipCheck.OwnershipDiagnostic -> Unit uses Console {
    context -> emitFunctionReturnPrefix(diagnostic)
    context.ir[diagnostic.expectedSymbol] => function
    context.ranges[function.sourceModule] => range
    context.symbols[range.symbolStart + function.symbol] => declaration
    context.types -> ownershipCheck.functionBodyReturnType(function.typeId, declaration.flags) => expectedBodyType
    diagnostic.actualOrigin == 23 -> if {
        "return requires " -> print
        expectedBodyType -> emitBoxOperandTypeName(context)
        " but received " -> print
    } else {
        "function '" -> print
        context -> emitBorrowedTextDeclarationName(diagnostic.sourceModule, diagnostic.functionSymbol)
        "' returns " -> print
    }
    diagnostic.actualSymbol >= 0 and diagnostic.actualSymbol < (context.ir -> len)
        -> if {
            context.ir[diagnostic.actualSymbol].typeId -> emitBoxOperandTypeName(context)
        } else { "Unit" -> print }
    diagnostic.actualOrigin != 23 -> if {
        " but declares " -> print
        expectedBodyType -> emitBoxOperandTypeName(context)
    }
    println()
}

emitArraySliceReturnDiagnostic context: ref emitterContext.EmitContext, diagnostic: ownershipCheck.OwnershipDiagnostic -> Unit uses Console {
    context -> emitFunctionReturnPrefix(diagnostic)
    diagnostic.code == ownershipCheck.localArraySliceReturnCode()
        -> if {
            "cannot return local array storage as a readonly slice; declare an owned array return type instead" -> println
        } else {
            context.ir[diagnostic.expectedSymbol] => parameter
            context.ranges[parameter.sourceModule] => range
            context.symbols[range.symbolStart + parameter.symbol] => declaration
            declaration -> symbols.contextualName => contextual
            "readonly slice parameter '" -> print
            (contextual -> len) > 0 -> if { contextual -> print } else {
                context.tokens[range.tokenStart + declaration.nameToken] => token
                context.sources[parameter.sourceModule] -> slice(token.span.start, token.span.length) -> print
            }
            "' cannot escape beyond the call; return an owned copy instead" -> println
        }
}

emitFunctionReturnGuard context: ref emitterContext.EmitContext, diagnostic: ownershipCheck.OwnershipDiagnostic -> Unit uses Console {
    context -> emitFunctionReturnPrefix(diagnostic)
    "function '" -> print
    context -> emitBorrowedTextDeclarationName(diagnostic.sourceModule, diagnostic.functionSymbol)
    diagnostic.code == ownershipCheck.deferredFunctionReturnCode()
        -> if {
            "' cannot return deferred interpolation; materialize it into an explicit Arena owner" -> println
        } else {
            "' cannot return a value containing a readonly reference whose origin is not inferred from a reference-bearing input" -> println
        }
}

firstBorrowedTextReturnDiagnostic context: ref emitterContext.EmitContext -> Int {
    -1 => selected!
    0 => diagnosticIndex!
    diagnosticIndex! < (context.ownershipDiagnostics -> len)
        -> while {
            context.ownershipDiagnostics[diagnosticIndex!] => diagnostic
            diagnostic -> isFunctionReturnDiagnostic
                -> if {
                    selected! < 0 -> if { diagnosticIndex! => selected! } else {
                        context.ownershipDiagnostics[selected!] => prior
                        context.ranges[diagnostic.sourceModule] => range
                        context.ranges[prior.sourceModule] => priorRange
                        context.symbols[range.symbolStart + diagnostic.functionSymbol] => function
                        context.symbols[priorRange.symbolStart + prior.functionSymbol] => priorFunction
                        context.tokens[range.tokenStart + function.nameToken].span.start => functionStart
                        context.tokens[priorRange.tokenStart + priorFunction.nameToken].span.start => priorStart
                        diagnostic.sourceModule < prior.sourceModule
                            or (diagnostic.sourceModule == prior.sourceModule and functionStart < priorStart)
                            -> if { diagnosticIndex! => selected! }
                        diagnostic.sourceModule == prior.sourceModule and diagnostic.functionSymbol == prior.functionSymbol
                            -> if {
                                diagnostic -> functionReturnDiagnosticPhase => phase
                                prior -> functionReturnDiagnosticPhase => priorPhase
                                phase < priorPhase or (phase == priorPhase and diagnostic.span.start < prior.span.start)
                                    -> if { diagnosticIndex! => selected! }
                            }
                    }
                }
            diagnosticIndex! + 1 => diagnosticIndex!
        }
    selected!
}

borrowedTextBodyPrecedesReturn context: ref emitterContext.EmitContext, diagnostic: ownershipCheck.OwnershipDiagnostic, sourceModule: Int, localAst: Int -> Bool {
    sourceModule < 0 or sourceModule >= (context.ranges -> len)
        -> if { false -> return }
    context.ranges[sourceModule] => range
    localAst < 0 or localAst >= range.astCount -> if { false -> return }
    context -> borrowedTextReturnOwnsAst(diagnostic, sourceModule, localAst)
        -> if {
            diagnostic -> functionReturnDiagnosticPhase => phase
            phase <= 1 -> if {
                context.nodes[range.astStart + localAst].start < diagnostic.span.start + diagnostic.span.length -> return
            }
            true -> return
        }
    sourceModule != diagnostic.sourceModule -> if { sourceModule < diagnostic.sourceModule -> return }
    context.ranges[diagnostic.sourceModule] => returnRange
    context.symbols[returnRange.symbolStart + diagnostic.functionSymbol] => returnFunction
    context.tokens[returnRange.tokenStart + returnFunction.nameToken].span.start => returnStart
    localAst => owner!
    0 => edges!
    owner! >= 0 and owner! < range.astCount and edges! < range.astCount
        -> while {
            context.nodes[range.astStart + owner!] => node
            node.kind == 7 or node.kind == 31 -> if { node.start < returnStart -> return }
            node.parent => owner!
            edges! + 1 => edges!
        }
    context.nodes[range.astStart + localAst].start < returnStart
}

borrowedTextDeclarationRootPrecedes context: ref emitterContext.EmitContext, diagnostic: ownershipCheck.OwnershipDiagnostic -> Bool {
    context.firstDeclarationRootDiagnostic => root
    root == 2 -> if { context -> borrowedTextBodyPrecedesReturn(diagnostic, context.numericCallLiteralDiagnostic.sourceModule, context.numericCallLiteralDiagnostic.locationAst) -> return }
    root == 3 -> if { context -> borrowedTextBodyPrecedesReturn(diagnostic, context.numericCallArgumentDiagnostic.sourceModule, context.numericCallArgumentDiagnostic.argumentAst) -> return }
    root == 4 -> if { context -> borrowedTextBodyPrecedesReturn(diagnostic, context.nominalFieldMismatch.sourceModule, context.nominalFieldMismatch.initializerAst) -> return }
    root == 5 -> if { context -> borrowedTextBodyPrecedesReturn(diagnostic, context.bindingDeclarationDiagnostic.sourceModule, context.bindingDeclarationDiagnostic.valueAst) -> return }
    root == 6 -> if { context -> borrowedTextBodyPrecedesReturn(diagnostic, context.callOwnershipDiagnostic.sourceModule, context.callOwnershipDiagnostic.argumentAst) -> return }
    root == 7 -> if { context -> borrowedTextBodyPrecedesReturn(diagnostic, context.dictionaryKeyDiagnostic.sourceModule, context.dictionaryKeyDiagnostic.locationAst) -> return }
    root == 8 -> if { context -> borrowedTextBodyPrecedesReturn(diagnostic, context.ownedIndexReadDiagnostic.sourceModule, context.ownedIndexReadDiagnostic.indexAst) -> return }
    root == 9 -> if { context -> borrowedTextBodyPrecedesReturn(diagnostic, context.callArityDiagnostic.sourceModule, context.callArityDiagnostic.callAst) -> return }
    root == 10 and context.firstOwnedBindingDiagnostic >= 0
        -> if {
            context.ownershipDiagnostics[context.firstOwnedBindingDiagnostic] => owned
            context.ranges[owned.sourceModule] => range
            0 => localAst!
            localAst! < range.astCount -> while {
                context.nodes[range.astStart + localAst!] => node
                node.start == owned.span.start -> if { context -> borrowedTextBodyPrecedesReturn(diagnostic, owned.sourceModule, localAst!) -> return }
                localAst! + 1 => localAst!
            }
        }
    false
}

emitDeferredTextStorageDiagnostic context: ref emitterContext.EmitContext, diagnostic: ownershipCheck.OwnershipDiagnostic -> Unit uses Console {
    context.ir[diagnostic.actualSymbol] => consumer
    consumer.kind == 17 -> if {
        context.ranges[consumer.sourceModule] => range
        context.nodes[range.astStart + consumer.astNode] => storageAst
        storageAst.kind == 9 or storageAst.kind == 48
            -> if {
                context -> emitInitializerSemanticPrefixAtOffset(diagnostic.sourceModule, diagnostic.actualOrigin, diagnostic.span.start)
                "deferred interpolation cannot be stored directly; materialize it into an explicit Arena owner" -> println
                return
            }
    }
    diagnostic.expectedSymbol < 0 or diagnostic.expectedSymbol > 8
        -> if {
            "; sollang internal invariant: deferred Text storage destination is unresolved" -> println
            return
        }
    context -> emitInitializerSemanticPrefixAtOffset(diagnostic.sourceModule, diagnostic.actualOrigin, diagnostic.span.start)
    "deferred interpolation cannot be stored " -> print
    diagnostic.expectedSymbol == 0 -> if { "directly" -> print }
    diagnostic.expectedSymbol == 1 -> if { "in array elements" -> print }
    diagnostic.expectedSymbol == 2 -> if { "in struct fields" -> print }
    diagnostic.expectedSymbol == 3 -> if { "in product fields" -> print }
    diagnostic.expectedSymbol == 4 -> if { "in dictionary keys" -> print }
    diagnostic.expectedSymbol == 5 -> if { "in dictionary values" -> print }
    diagnostic.expectedSymbol == 6 -> if { "in indexed elements" -> print }
    diagnostic.expectedSymbol == 7 -> if { "in deque elements" -> print }
    diagnostic.expectedSymbol == 8 -> if { "in set elements" -> print }
    "; materialize it into an explicit Arena owner" -> println
}

emitBorrowedTextReturnDiagnostic context: ref emitterContext.EmitContext -> Bool uses Console {
    context -> firstBorrowedTextReturnDiagnostic => index
    index < 0 -> if { false -> return }
    context.ownershipDiagnostics[index] => diagnostic
    context -> borrowedTextDeclarationRootPrecedes(diagnostic)
        -> if { false -> return }
    context -> firstBlockingInterpolationNode => interpolationNode
    interpolationNode < (context.interpolations -> len)
        -> if {
            context -> interpolationSourceModule(interpolationNode) => sourceModule
            sourceModule >= 0 and sourceModule < (context.ranges -> len)
                -> if {
                    context.nodes -> semanticDiagnostics.interpolationStringAst(context.ranges[sourceModule], context.interpolations, interpolationNode) => stringAst
                    context -> borrowedTextBodyPrecedesReturn(diagnostic, sourceModule, stringAst)
                        -> if {
                            context -> emitInterpolationDiagnostics
                            true -> return
                        }
                }
        }
    context.expressionOperandDiagnostic => bodyExpression
    bodyExpression.code > 0 and (context -> borrowedTextBodyPrecedesReturn(diagnostic, bodyExpression.sourceModule, bodyExpression.astNode))
        -> if {
            context -> emitExpressionOperandDiagnostics
            true -> return
        }
    # The selected-call table is already the canonical unknown-target authority.
    # Emit just the failed call owned by this function, not the declaration guard
    # plus every unresolved call in the package.
    0 => callIndex!
    callIndex! < (context.calls -> len) -> while {
        context.calls[callIndex!] => call
        (context -> isBlockingUnresolvedCall(callIndex!))
            and (context -> borrowedTextBodyPrecedesReturn(diagnostic, call.sourceModule, call.callAst))
            -> if {
                context -> emitCallDiagnostic(callIndex!)
                true -> return
            }
        callIndex! + 1 => callIndex!
    }
    # Existing body failures use their actual IR read/call owner.
    context.ownershipDiagnostics -> each bodyFailure {
        (bodyFailure.code == 35 or bodyFailure.code == 41 or bodyFailure.code == 42)
            and bodyFailure.actualSymbol >= 0 and bodyFailure.actualSymbol < (context.ir -> len)
            -> if {
                context.ir[bodyFailure.actualSymbol] => use
                context -> borrowedTextBodyPrecedesReturn(diagnostic, use.sourceModule, use.astNode)
                    -> if {
                        bodyFailure.code == 35 -> if {
                            context -> emitDeferredTextStorageDiagnostic(bodyFailure)
                        } else {
                            bodyFailure.code == 42 -> if {
                                context -> emitBorrowedOwnedMoveDiagnostic(bodyFailure)
                            } else {
                                context -> emitBorrowedOwnedStorageOrResultDiagnostic(bodyFailure)
                            }
                        }
                        true -> return
                    }
            }
    }
    diagnostic.code == ownershipCheck.localArraySliceReturnCode() or diagnostic.code == 32
        -> if {
            context -> emitArraySliceReturnDiagnostic(diagnostic)
            true -> return
        }
    diagnostic.code == ownershipCheck.functionReturnCompatibilityCode()
        -> if {
            context -> emitFunctionReturnCompatibility(diagnostic)
            true -> return
        }
    diagnostic.code == ownershipCheck.deferredFunctionReturnCode() or diagnostic.code == 22
        -> if {
            context -> emitFunctionReturnGuard(diagnostic)
            true -> return
        }
    diagnostic.code == ownershipCheck.borrowedTextReturnEscapeCode()
        -> if {
            context -> emitBorrowedTextReturnEscape(diagnostic)
        } else {
            context -> emitBorrowedTextReturnInference(diagnostic)
        }
    true
}

public emitOwnershipDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    0 => diagnosticIndex!
    diagnosticIndex! < (context.ownershipDiagnostics -> len)
        -> while {
            context.ownershipDiagnostics[diagnosticIndex!] => diagnostic
            diagnostic.code == ownershipCheck.borrowedTextBlockEscapeCode()
                -> if { context -> emitBorrowedTextReturnEscape(diagnostic) }
            diagnostic.code == ownershipCheck.aggregateTransferOverlapCode()
                -> if { context -> emitAggregateTransferOverlapDiagnostic(diagnostic) }
            diagnostic.code == ownershipCheck.diagnosticTrackTaskArgumentCode()
                -> if {
                    context -> emitInitializerSemanticPrefixAtOffset(diagnostic.sourceModule, diagnostic.actualOrigin, diagnostic.span.start)
                    "DiagnosticSession.track<T> requires T to be Task<U>; the moved owner is not consumed on rejection" -> println
                }
            diagnostic.code == ownershipCheck.parallelSourceTextResultCode()
                -> if {
                    context -> emitInitializerSemanticPrefixAtOffset(diagnostic.sourceModule, diagnostic.actualOrigin, diagnostic.span.start)
                    "parallel callback SourceText is supported only as a direct top-level tryParallel Result payload" -> println
                }
            diagnostic.code == ownershipCheck.taskOperationContractCode()
                -> if {
                    context -> emitInitializerSemanticPrefixAtOffset(diagnostic.sourceModule, diagnostic.actualOrigin, diagnostic.span.start)
                    diagnostic.actualBuiltin == 3 -> if {
                        "await is only valid in async functions or main" -> println
                    } else {
                        diagnostic.actualBuiltin == 1 -> if { "await" -> print } else { "cancel" -> print }
                        " expects Task<T> but received " -> print
                        context.ir[diagnostic.actualSymbol].typeId -> emitBoxOperandTypeName(context)
                        "" -> println
                    }
                }
            diagnostic.code == 36 and (diagnostic.actualBuiltin < -1 or diagnostic.actualBuiltin > 1)
                -> if {
                    emitOwnedBindingRootInvariant()
                    return
                }

            # Borrowed-return failures are selected once with their body error
            # dependencies by emitBlockingDiagnostics, not appended here.
            diagnostic.code == 42 -> if { context -> emitBorrowedOwnedMoveDiagnostic(diagnostic) }
            diagnostic.code == 41 -> if {
                context -> emitBorrowedOwnedStorageOrResultDiagnostic(diagnostic)
            } else {
                diagnostic.code == 40 -> if {
                    context.ranges[diagnostic.expectedOrigin] => mutableFunctionRange
                    context.symbols[mutableFunctionRange.symbolStart + diagnostic.functionSymbol] => mutableFunctionSymbol
                    context.tokens[mutableFunctionRange.tokenStart + mutableFunctionSymbol.nameToken] => mutableFunctionNameToken
                    context.sources[diagnostic.expectedOrigin] -> slice(mutableFunctionNameToken.span.start, mutableFunctionNameToken.span.length) => mutableFunctionName
                    context.ir[diagnostic.actualSymbol] => mutableArgument
                    diagnostic.actualSymbol => mutableRootIr!
                    mutableRootIr! >= 0 and (context.ir[mutableRootIr!].kind == 13 or context.ir[mutableRootIr!].kind == 15)
                        -> while { context.ir[mutableRootIr!].operand0 => mutableRootIr! }
                    mutableRootIr! >= 0 and context.ir[mutableRootIr!].kind == 5
                        -> if {
                            context.ir[mutableRootIr!] => mutableRoot
                            context.ranges[mutableRoot.sourceModule] => mutableRootRange
                            context.nodes[mutableRootRange.astStart + mutableRoot.astNode] => mutableRootAst
                            context.tokens[mutableRootRange.tokenStart + mutableRootAst.firstToken] => mutableRootToken
                            "; sollang error[E40]: function '$mutableFunctionName' mutably borrows a container; use a mutable owner binding such as '" -> print
                            context.sources[mutableRoot.sourceModule] -> slice(mutableRootToken.span.start, mutableRootToken.span.length) -> print
                            "!' (source $(diagnostic.sourceModule), byte $(diagnostic.span.start), length $(diagnostic.span.length))" -> println
                        } else {
                            context.ir[diagnostic.actualSymbol] => mutableCallArgument
                            context.ranges[mutableCallArgument.sourceModule] => mutableCallRange
                            diagnostic.expectedSymbol > 0 or context.nodes[mutableCallRange.astStart + mutableCallArgument.astNode].kind == 11
                                -> if {
                                    "; sollang error[E40]: function '$mutableFunctionName' mutably borrows a container, so the argument must be a mutable owner place (source $(diagnostic.sourceModule), byte $(diagnostic.span.start), length $(diagnostic.span.length))" -> println
                                } else {
                                    "; sollang error[E40]: function '$mutableFunctionName' mutably borrows a container, so the flowed input must be a mutable owner place (source $(diagnostic.sourceModule), byte $(diagnostic.span.start), length $(diagnostic.span.length))" -> println
                                }
                        }
                }
                diagnostic.code == 39 -> if {
                    context.ir[diagnostic.actualSymbol] => ownedCall
                    context.ranges[ownedCall.sourceModule] => callRange
                    diagnostic.expectedModule < 0 or diagnostic.expectedModule >= callRange.astCount
                        -> if {
                            "sollang: compiler invariant [OWNED_MOVE_CALL_PATH_MISSING]" -> println
                            return
                        }
                    context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.span.start) => ownedLocation
                    "<main>" => ownedModuleName!
                    context.nodes -> semanticDiagnostics.expressionBelongsToMain(callRange, ownedCall.astNode) => ownedInMain
                    not ownedInMain and context.modules[diagnostic.sourceModule].pathLength > 0
                        -> if {
                            context.modules[diagnostic.sourceModule] => ownedModule
                            context.sources[diagnostic.sourceModule] -> slice(ownedModule.pathStart, ownedModule.pathLength) => ownedModuleName!
                        }
                    "sollang: semantic error at $(ownedLocation.line):$(ownedLocation.column): [module '$(ownedModuleName!)'] function '" -> print
                    context -> emitOwnedMoveFunctionName(diagnostic.actualSymbol, diagnostic.expectedModule)
                    "' consumes an owned container, so the " -> print
                    diagnostic.expectedSymbol > 0 or context.nodes[callRange.astStart + ownedCall.astNode].kind == 11
                        -> if { "argument must be a named owner" -> println } else { "flowed input must be a named owner" -> println }
                }
                diagnostic.code == 17 -> if {
                    diagnostic.span => diagnosticSpan
                    diagnosticSpan.start => diagnosticStart
                    diagnosticSpan.length => diagnosticLength
                    diagnostic.expectedSymbol >= 0 -> if {
                        context.ir[diagnostic.expectedSymbol] => moveSite
                        context.ranges[moveSite.sourceModule] => moveRange
                        context.nodes[moveRange.astStart + moveSite.astNode].start => moveStart
                        "; sollang error[E17]: use of a partially moved value (source $(diagnostic.sourceModule), move byte $moveStart, use byte $diagnosticStart, length $diagnosticLength)" -> println
                    } else {
                        "; sollang error[E17]: use of a partially moved value (source $(diagnostic.sourceModule), use byte $diagnosticStart, length $diagnosticLength)" -> println
                    }
                } else {
                    diagnostic.code == 38 and not (diagnostic -> ownershipCheck.isSupersededByBranchJoin(context.ownershipDiagnostics))
                        -> if {
                            context.ir[diagnostic.actualSymbol] => overlappingField
                            context.ranges[overlappingField.sourceModule] => overlappingFieldRange
                            context.nodes[overlappingFieldRange.astStart + overlappingField.astNode] => overlappingFieldAst
                            "owned field '" -> print
                            overlappingFieldAst.firstToken => overlappingFieldTokenIndex!
                            overlappingFieldTokenIndex! < overlappingFieldAst.firstToken + overlappingFieldAst.tokenCount
                                -> while {
                                    context.tokens[overlappingFieldRange.tokenStart + overlappingFieldTokenIndex!] => overlappingFieldToken
                                    overlappingFieldToken.kind != grammar.triviaIdWhitespace()
                                        and overlappingFieldToken.kind != grammar.triviaIdComment()
                                        and overlappingFieldToken.kind != grammar.tokenIdNewLine()
                                        -> if {
                                            context.sources[overlappingField.sourceModule] -> slice(overlappingFieldToken.span.start, overlappingFieldToken.span.length) -> print
                                        }
                                    overlappingFieldTokenIndex! + 1 => overlappingFieldTokenIndex!
                                }
                            "' overlaps an already moved field" -> println
                        }
                    diagnostic.code == 18 -> if {
                        diagnostic.span => diagnosticSpan
                        diagnosticSpan.start => diagnosticStart
                        diagnosticSpan.length => diagnosticLength
                        "; sollang error[E18]: mutable binding captured by a parallel callback (source $(diagnostic.sourceModule), byte $diagnosticStart, length $diagnosticLength)" -> println
                    } else {
                        diagnostic.code == 19 -> if {
                            diagnostic.span => diagnosticSpan
                            diagnosticSpan.start => diagnosticStart
                            diagnosticSpan.length => diagnosticLength
                            "; sollang error[E19]: non-sendable binding captured by a parallel callback (source $(diagnostic.sourceModule), byte $diagnosticStart, length $diagnosticLength)" -> println
                        } else {
                            diagnostic.code == 20
                                and not (diagnosticIndex! -> ownershipCheck.isDuplicateBranchJoinDiagnostic(context.ownershipDiagnostics, context.ir))
                                and not (diagnostic -> ownershipCheck.isBranchJoinSupersededByOverlap(context.ownershipDiagnostics, context.ir))
                                and not (diagnostic -> ownershipCheck.isBranchJoinSupersededByBorrowMutation(context.ownershipDiagnostics, context.ir))
                                -> if {
                                    context -> emitOwnedBranchJoinDiagnostic(diagnostic)
                                } else {
                                    diagnostic.code == 21 -> if {
                                        context -> emitBorrowedTextOriginMutationDiagnostic(diagnostic)
                                    } else {
                                        diagnostic.code == 22 -> if {
                                            diagnostic.span => diagnosticSpan
                                            diagnosticSpan.start => diagnosticStart
                                            diagnosticSpan.length => diagnosticLength
                                            diagnostic.expectedSymbol >= 0 -> if {
                                                context -> emitReadonlyReferenceArgumentDiagnostic(diagnostic)
                                            } else {
                                                "; sollang error[E22]: readonly reference argument requires an addressable owner or reference; literals and temporary values cannot be borrowed; bind the value to an immutable name before passing it by ref (source $(diagnostic.sourceModule), byte $diagnosticStart, length $diagnosticLength)" -> println
                                            }
                                        } else {
                                            diagnostic.code == 23 -> if {
                                                context -> emitBorrowedTextOriginMutationDiagnostic(diagnostic)
                                            } else {
                                                diagnostic.code == 24 and not (diagnostic -> ownershipCheck.isConsumedBindingRead(context.ir))
                                                    -> if {
                                                        context.ir[diagnostic.actualSymbol] => affineReuse
                                                        context.ranges[affineReuse.sourceModule] => affineReuseRange
                                                        affineReuse.payloadToken >= 0 -> if {
                                                            context.tokens[affineReuseRange.tokenStart + affineReuse.payloadToken] => affineReuseName
                                                            context.sources[affineReuse.sourceModule] -> slice(affineReuseName.span.start, affineReuseName.span.length) => affineName
                                                            "; sollang error[E24]: affine value '$affineName' was already consumed; use the owner returned by the consuming call, borrow it before the move, or create a new owner before reuse" -> println
                                                        } else {
                                                            "; sollang error[E24]: affine producer was already consumed; bind and use the owner returned by the consuming call, or create a new owner before reuse" -> println
                                                        }
                                                    } else {
                                                        diagnostic.code == 25 -> if {
                                                            context -> emitBorrowedOwnedStorageOrResultDiagnostic(diagnostic)
                                                        } else {
                                                            diagnostic.code == 26 -> if {
                                                                context -> emitBorrowedOwnedStorageOrResultDiagnostic(diagnostic)
                                                            } else {
                                                                diagnostic.code == 27 -> if {
                                                                    context.ir[diagnostic.actualSymbol] => ownedBlockCall
                                                                    context.ranges[ownedBlockCall.sourceModule] => ownedBlockRange
                                                                    context.nodes[ownedBlockRange.astStart + ownedBlockCall.astNode] => ownedBlockAst
                                                                    context.tokens[ownedBlockRange.tokenStart + ownedBlockAst.payloadToken] => ownedBlockNameToken
                                                                    context.sources[ownedBlockCall.sourceModule] -> slice(ownedBlockNameToken.span.start, ownedBlockNameToken.span.length) => ownedBlockName
                                                                    "; sollang error[E27]: owned result of block function '$ownedBlockName' must be bound with '=> name' (source $(diagnostic.sourceModule), byte $(diagnostic.span.start), length $(diagnostic.span.length)); bind the result and return or transfer that named owner" -> println
                                                                } else {
                                                                    diagnostic.code == 31 -> if {
                                                                        diagnostic.expectedOrigin == 8 -> if {
                                                                            context -> emitBorrowedOwnedStorageOrResultDiagnostic(diagnostic)
                                                                        } else {
                                                                            "; sollang error[E31]: indexed owned value cannot be copied into an owning binding, return, or storage (source $(diagnostic.sourceModule), byte $(diagnostic.span.start), length $(diagnostic.span.length)); borrow the value for a readonly call or transfer it with the container take operation" -> println
                                                                        }
                                                                    }
                                                                    diagnostic.code == 32 -> if {
                                                                        "; sollang error[E32]: readonly slice parameter cannot escape beyond the call (source $(diagnostic.sourceModule), byte $(diagnostic.span.start), length $(diagnostic.span.length)); return an owned copy instead" -> println
                                                                    }
                                                                    diagnostic.code == 33 -> if {
                                                                        context -> emitOwnedBindingBranchDiagnostic(diagnostic)
                                                                    }
                                                                    diagnostic.code == 34 -> if {
                                                                        context -> emitOwnedBindingCreationDiagnostic(diagnostic)
                                                                    }
                                                                    diagnostic.code == 35 -> if {
                                                                        context -> emitDeferredTextStorageDiagnostic(diagnostic)
                                                                    }
                                                                    diagnostic.code == 36 -> if {
                                                                        diagnostic.actualBuiltin == 1 -> if {
                                                                            "; sollang error[E36]: owned nested field cannot be moved from a mutable borrow in the current slice because nested field assignment is not supported (source $(diagnostic.sourceModule), byte $(diagnostic.span.start), length $(diagnostic.span.length)); use a move input for the containing owner or borrow the field for a readonly call" -> println
                                                                        } else {
                                                                            "; sollang error[E36]: owned field moved from a mutable borrow must be reinitialized by the immediately following infallible statement (source $(diagnostic.sourceModule), byte $(diagnostic.span.start), length $(diagnostic.span.length)); write the replacement to the same field without '?' before any use, control flow, or early return" -> println
                                                                        }
                                                                    }
                                                                    diagnostic.code == 37 -> if {
                                                                        "move input expects an owned container or user value type" -> println
                                                                    }
                                                                    diagnostic.code == 28 -> if {
                                                                        context.ir[diagnostic.actualSymbol] => containerRebind
                                                                        context.ranges[containerRebind.sourceModule] => containerRebindRange
                                                                        context.tokens[containerRebindRange.tokenStart + containerRebind.payloadToken] => containerRebindNameToken
                                                                        context.sources[containerRebind.sourceModule] -> slice(containerRebindNameToken.span.start, containerRebindNameToken.span.length) => containerRebindName
                                                                        context -> emitInitializerSemanticPrefixAtOffset(diagnostic.sourceModule, containerRebind.astNode, containerRebindNameToken.span.start)
                                                                        "owned container binding '$containerRebindName!' cannot be rebound; bind the selected owner once with '=> name!' or mutate the existing owner through its instance methods" -> println
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                            }
                                        }
                                    }
                                }
                        }
                    }
                }
            }
            diagnosticIndex! + 1 => diagnosticIndex!
        }
}

public interpolationSourceModule context: ref emitterContext.EmitContext, nodeIndex: Int -> Int {
    -1 => sourceModule!
    0 => rangeIndex!
    rangeIndex! < (context.interpolationRanges -> len)
        -> while {
            context.interpolationRanges[rangeIndex!] => interpolationRange
            nodeIndex >= interpolationRange.nodeStart and nodeIndex < interpolationRange.nodeStart + interpolationRange.nodeCount
                -> if {
                    interpolationRange.sourceModule => sourceModule!
                }
            rangeIndex! + 1 => rangeIndex!
        }
    sourceModule!
}

public isBlockingMappedIndexInterpolation context: ref emitterContext.EmitContext, nodeIndex: Int -> Bool {
    nodeIndex >= 0 and nodeIndex < (context.invalidMappedIndexByNode -> len)
        -> if { context.invalidMappedIndexByNode[nodeIndex] } else { false }
}

public isBlockingInvalidUnaryInterpolation context: ref emitterContext.EmitContext, nodeIndex: Int -> Bool {
    nodeIndex >= 0 and nodeIndex < (context.invalidSignedUnaryByNode -> len)
        -> if { context.invalidSignedUnaryByNode[nodeIndex] } else { false }
}

public isBlockingInvalidNotInterpolation context: ref emitterContext.EmitContext, nodeIndex: Int -> Bool {
    nodeIndex >= 0 and nodeIndex < (context.invalidNotUnaryByNode -> len)
        -> if { context.invalidNotUnaryByNode[nodeIndex] } else { false }
}

public isBlockingContextualNumericLiteralInterpolation context: ref emitterContext.EmitContext, nodeIndex: Int -> Bool {
    nodeIndex < 0 or nodeIndex >= (context.interpolationNumericLiteralContextByNode -> len)
        -> if { false -> return }
    context.interpolationNumericLiteralContextByNode[nodeIndex] => literal
    literal.status >= 0 and literal.status != 1
}

emitInterpolationNumericLiteralValue context: ref emitterContext.EmitContext, nodeIndex: Int, sourceModule: Int -> Unit uses Console {
    context.interpolations[nodeIndex] => root
    root.kind == 2 => negative
    negative -> if { root.operand0 } else { nodeIndex } => literalIndex
    context.interpolations[literalIndex] => literal
    negative -> if { "-" -> print }
    (context.sources[sourceModule] -> byte(literal.payloadStart)) == '\''
        -> if {
            syntax.SourceSpan { fileId: sourceModule, start: literal.payloadStart, length: literal.payloadLength } => span
            context.sources[sourceModule] -> syntax.decodeCharacterLiteral(span) -> when {
                Some(scalar) { "$scalar" -> print }
                None { context.sources[sourceModule] -> slice(literal.payloadStart, literal.payloadLength) -> print }
            }
        } else { context.sources[sourceModule] -> slice(literal.payloadStart, literal.payloadLength) -> print }
}

emitContextualNumericLiteralDiagnostic context: ref emitterContext.EmitContext, nodeIndex: Int -> Unit uses Console {
    context.interpolationNumericLiteralContextByNode[nodeIndex] => decision
    context -> interpolationSourceModule(nodeIndex) => sourceModule
    context -> emitInterpolationSemanticPrefix(nodeIndex, sourceModule)
    "numeric literal " -> print
    context -> emitInterpolationNumericLiteralValue(nodeIndex, sourceModule)
    decision.status == 2 -> if {
        " is a Unicode surrogate and cannot be a CodePoint" -> println
    } else {
        " is out of range for " -> print
        decision.typeId -> emitBoxOperandTypeName(context)
        context.types[decision.typeId].symbol -> typeIds.canonicalBuiltinSymbol => builtin
        builtin -> numericLiteralRange.minimumText(context.pointerBitWidth) => minimum
        builtin -> numericLiteralRange.maximumText(context.pointerBitWidth) => maximum
        " ($minimum..$maximum)" -> println
    }
}

interpolationDescendsFrom context: ref emitterContext.EmitContext, nodeIndex: Int, ancestorIndex: Int -> Bool {
    context.interpolations[nodeIndex].parent => parentIndex!
    parentIndex! >= 0 and parentIndex! < (context.interpolations -> len)
        -> while {
            parentIndex! == ancestorIndex -> if { true -> return }
            context.interpolations[parentIndex!].parent => parentIndex!
        }
    false
}

isBlockingInterpolationArray context: ref emitterContext.EmitContext, nodeIndex: Int -> Bool {
    nodeIndex < 0 or nodeIndex >= (context.interpolations -> len)
        or nodeIndex >= (context.interpolationArrayByNode -> len)
        -> if { false -> return }
    context.interpolations[nodeIndex].kind != 16 -> if { false -> return }
    context.interpolationArrayByNode[nodeIndex] => literal
    literal.valueAst >= 0 and literal.status > 0 and literal.status != 15
        and not (literal.status == 10 and literal.diagnosticContext == 2)
}

emitInterpolationArrayVariantName context: ref emitterContext.EmitContext, constructorIndex: Int -> Unit uses Console {
    context.interpolationEnumConstructors[constructorIndex] => constructor
    context.types[constructor.enumTypeId] => enumType
    enumType.kind == 7 and enumType.origin == 4 -> if {
        enumType.symbol == 0 -> if { "Option.Some" -> print } else {
            constructor.variantTag == 0 -> if { "Result.Ok" -> print } else { "Result.Err" -> print }
        }
        return
    }
    context.ranges[constructor.targetSourceModule] => range
    context.symbols[range.symbolStart + constructor.variantSymbol] => variant
    context.symbols[range.symbolStart + variant.parent] => definition
    context.tokens[range.tokenStart + definition.nameToken] => definitionToken
    context.tokens[range.tokenStart + variant.nameToken] => variantToken
    context.sources[constructor.targetSourceModule] -> slice(definitionToken.span.start, definitionToken.span.length) -> print
    "." -> print
    context.sources[constructor.targetSourceModule] -> slice(variantToken.span.start, variantToken.span.length) -> print
}

emitInterpolationArrayDiagnostic context: ref emitterContext.EmitContext, nodeIndex: Int -> Unit uses Console {
    context.interpolationArrayByNode[nodeIndex] => literal
    context -> interpolationSourceModule(nodeIndex) => sourceModule
    literal.status == 1 or literal.status == 9 or literal.status == 14
        -> if {
            literal.status == 1 -> if { "INTERPOLATION_ARRAY_TYPE_UNRESOLVED" } else {
                literal.status == 9 -> if { "INTERPOLATION_ARRAY_RETENTION_INCOMPLETE" } else {
                    "INTERPOLATION_ARRAY_REPEAT_MAPPING_INVALID"
                }
            } => failureId
            "; sollang compiler verification failure $failureId: source $sourceModule, interpolation $nodeIndex, ast $(literal.valueAst); repair canonical array analysis or source retention before LLVM emission" -> println
            return
        }
    literal.status == 10 and (literal.diagnosticContext != 1 or literal.contextNode < 0
        or literal.contextNode >= (context.interpolationEnumConstructorByNode -> len))
        -> if {
            "; sollang compiler verification failure INTERPOLATION_ARRAY_DIAGNOSTIC_CONTEXT_MISSING: source $sourceModule, interpolation $nodeIndex; retain the canonical constructor or function argument diagnostic before LLVM emission" -> println
            return
        }
    literal.status == 10 and context.interpolationEnumConstructorByNode[literal.contextNode] < 0
        -> if {
            "; sollang compiler verification failure INTERPOLATION_ARRAY_CONSTRUCTOR_FACT_MISSING: source $sourceModule, interpolation $nodeIndex; retain the canonical constructor diagnostic identity before LLVM emission" -> println
            return
        }
    context -> emitInterpolationSemanticPrefix(literal.diagnosticNode, sourceModule)
    literal.status == 2 -> if {
        "array elements must have one type; expected " -> print
        literal.elementTypeId -> emitBoxOperandTypeName(context)
        ", got " -> print
        literal.actualTypeId -> emitBoxOperandTypeName(context)
        println()
        return
    }
    literal.status == 3 -> if {
        "fixed array elements must be inline scalar or user values" -> println
        return
    }
    literal.status == 4 -> if {
        "bounded array initializer has $(literal.elementCount) elements but capacity is $(literal.storageLength)" -> println
        return
    }
    literal.status == 6 -> if {
        literal.diagnosticNode => root!
        context.interpolations[root!].kind == 5 and context.interpolations[root!].operand0 >= 0
            -> while { context.interpolations[root!].operand0 => root! }
        context.interpolations[root!] => owner
        context.sources[sourceModule] -> slice(owner.payloadStart, owner.payloadLength) => name
        "borrowed owned value '$name' cannot be copied into array storage; transfer an owned value instead" -> println
        return
    }
    literal.status == 7 -> if {
        "numeric literal " -> print
        context -> emitInterpolationNumericLiteralValue(literal.diagnosticNode, sourceModule)
        " is out of range for " -> print
        literal.elementTypeId -> emitBoxOperandTypeName(context)
        context.types[literal.elementTypeId].symbol -> typeIds.canonicalBuiltinSymbol => symbol
        symbol == 20 or symbol == 21 -> if { println() } else {
            symbol -> numericLiteralRange.minimumText(context.pointerBitWidth) => minimum
            symbol -> numericLiteralRange.maximumText(context.pointerBitWidth) => maximum
            " ($minimum..$maximum)" -> println
        }
        return
    }
    literal.status == 8 -> if {
        "array repeat value must be an inline copyable value" -> println
        return
    }
    literal.status == 10 -> if {
        context.interpolationEnumConstructorByNode[literal.contextNode] => constructorIndex
        "variant '" -> print
        context -> emitInterpolationArrayVariantName(constructorIndex)
        "' expects " -> print
        literal.expectedTypeId -> emitBoxOperandTypeName(context)
        ", got " -> print
        literal.actualTypeId -> emitBoxOperandTypeName(context)
        println()
        return
    }
    literal.status == 11 -> if {
        literal.dynamic -> if { "growable array elements must have a supported inline value layout" -> println } else {
            "bounded array elements must be inline scalar or user values" -> println
        }
        return
    }
    literal.status == 12 or literal.status == 13 -> if {
        context.types[literal.expectedTypeId].length => expectedLength
        not literal.dynamic and not literal.bounded and literal.storageLength >= 0 => isRepeatedLiteral
        literal.status == 12 -> if { "fixed array expects $expectedLength" -> print } else {
            "bounded array capacity is $expectedLength, got $(literal.elementCount)" -> print
        }
        isRepeatedLiteral -> if { " repeated elements" -> print } else { " elements" -> print }
        literal.status == 12 -> if { ", got $(literal.elementCount)" -> print }
        println()
    }
}

isBlockingInterpolationMethodDecision context: ref emitterContext.EmitContext, nodeIndex: Int -> Bool {
    context.semanticInterpolationCallTargets[nodeIndex].status => status
    status == 2 or status == 3
}

firstBlockingInterpolationNode context: ref emitterContext.EmitContext -> Int {
    -1 => firstIndex!
    0 => nodeIndex!
    nodeIndex! < (context.interpolations -> len) -> while {
        not context.activeInterpolationBodyByNode[nodeIndex!]
            -> if {
                nodeIndex! + 1 => nodeIndex!
                continue
            }
        (context -> isBlockingInterpolationArray(nodeIndex!))
            or context.interpolationOwnedParameterCallByNode[nodeIndex!]
            or context.unresolvedInterpolationBindingByNode[nodeIndex!]
            or context.uninvokedInterpolationFunctionByNode[nodeIndex!]
            or context.uninvokedAssociatedMemberByNode[nodeIndex!]
            or context.missingLocalAssociatedMemberByNode[nodeIndex!]
            or context.localEnumMemberDecisionByNode[nodeIndex!].status == 1
            or context.localEnumMemberDecisionByNode[nodeIndex!].status == 2
            or context.unresolvedInterpolationCallByNode[nodeIndex!]
            or context.directCallExpectedArityByNode[nodeIndex!] >= 0
            or (context -> isBlockingInterpolationMethodDecision(nodeIndex!))
            or context.importedInterpolationCallTargetByNode[nodeIndex!] < -2
            or context.interpolationPrivateFieldByNode[nodeIndex!] >= 0
            or context.interpolationMissingMemberOwnerTypeByNode[nodeIndex!] >= 0
            or context.invalidArgumentsInterpolationIndexByNode[nodeIndex!]
            or context.unsupportedIndexOwnerTypeByNode[nodeIndex!] >= 0
            or (context -> isBlockingMappedIndexInterpolation(nodeIndex!))
            or context.invalidCollectionIndexExpectedTypeByNode[nodeIndex!] >= 0
            or context.interpolationContextualDiagnosticByNode[nodeIndex!].code > 0
            or context.interpolationOwnedIndexElementTypeByNode[nodeIndex!] >= 0
            or (context -> isBlockingInvalidUnaryInterpolation(nodeIndex!))
            or (context -> isBlockingInvalidNotInterpolation(nodeIndex!))
            or (context -> isBlockingContextualNumericLiteralInterpolation(nodeIndex!))
            or context.binaryArithmeticDiagnosticByNode[nodeIndex!].code > 0
            or context.binaryComparisonDiagnosticByNode[nodeIndex!].code > 0
            or context.binaryLogicalDiagnosticByNode[nodeIndex!] > 0
            or context.interpolationResultPropagationByNode[nodeIndex!].status > 0
            or context.invalidIntrinsicFlowArityByNode[nodeIndex!]
            or context.invalidTextIntrinsicArgumentByNode[nodeIndex!] >= 0
            or context.collectionMembershipDiagnosticByNode[nodeIndex!].code > 0
            or context.invalidNumericConversionArityByNode[nodeIndex!]
            or context.invalidNumericConversionTypeByNode[nodeIndex!] >= 0
            or context.invalidCodePointFloatConversionByNode[nodeIndex!]
            or context.invalidNumericConversionLiteralByNode[nodeIndex!] >= 0
            or context.interpolationCallArgumentDiagnosticByNode[nodeIndex!].code > 0
            or context.invalidDisplayTypeByNode[nodeIndex!] >= 0
            -> if {
                firstIndex! < 0 -> if { nodeIndex! => firstIndex! } else {
                    context -> interpolationDescendsFrom(nodeIndex!, firstIndex!)
                        -> if { nodeIndex! => firstIndex! } else { firstIndex! -> return }
                }
            }
        nodeIndex! + 1 => nodeIndex!
    }
    firstIndex! >= 0 -> if { firstIndex! -> return }
    context.interpolations -> len
}

emitInterpolationSemanticPrefixAt context: ref emitterContext.EmitContext, nodeIndex: Int, sourceModule: Int, location: syntaxDiagnostics.SourceLocation -> Unit uses Console {
    "<main>" => moduleName!
    not (context.nodes -> semanticDiagnostics.interpolationBelongsToMain(context.ranges[sourceModule], context.interpolations, nodeIndex))
        and context.modules[sourceModule].pathLength > 0
        -> if {
            context.modules[sourceModule] => identity
            context.sources[sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
        }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] " -> print
}

emitInterpolationSemanticPrefix context: ref emitterContext.EmitContext, nodeIndex: Int, sourceModule: Int -> Unit uses Console {
    context.interpolations -> semanticDiagnostics.interpolationExpressionLocation(context.sources[sourceModule], nodeIndex) => location
    context -> emitInterpolationSemanticPrefixAt(nodeIndex, sourceModule, location)
}

emitInterpolationCallArityDiagnostic context: ref emitterContext.EmitContext, nodeIndex: Int -> Unit uses Console {
    context.interpolations[nodeIndex] => call
    context -> interpolationSourceModule(nodeIndex) => sourceModule
    context.directCallExpectedArityByNode[nodeIndex] => expected
    context.importedInterpolationCallTargetByNode[nodeIndex] => target
    false => flowed!
    call.operand0 >= 0 and context.interpolations[call.operand0].payloadStart < call.callNameStart
        -> if { true => flowed! }
    flowed! and expected > 0 and target >= 0 -> if {
        context.ir[target] => function
        context.ranges[function.sourceModule] => range
        context.symbols[range.symbolStart + function.symbol] => declaration
        context.tokens[range.tokenStart + declaration.nameToken] => nameToken
        context.sources[function.sourceModule] -> syntaxDiagnostics.sourceLocation(nameToken.span.start) => location
        context -> emitInterpolationSemanticPrefixAt(nodeIndex, sourceModule, location)
    } else {
        context -> emitInterpolationSemanticPrefix(nodeIndex, sourceModule)
    }
    "function '" -> print
    target >= 0 -> if {
        context.ir[target] => function
        not modules.sameLogicalSource(context.sources, context.modules, sourceModule, function.sourceModule, context.tokens, context.ranges)
            and context.modules[function.sourceModule].pathLength > 0
            -> if {
                context.modules[function.sourceModule] => identity
                context.sources[function.sourceModule] -> slice(identity.pathStart, identity.pathLength) -> print
                "." -> print
            }
        context.ranges[function.sourceModule] => range
        context.symbols[range.symbolStart + function.symbol] => declaration
        context.tokens[range.tokenStart + declaration.nameToken] => nameToken
        context.sources[function.sourceModule] -> slice(nameToken.span.start, nameToken.span.length) -> print
    } else {
        context.sources[sourceModule] -> slice(call.callNameStart, call.callNameLength) -> print
    }
    "' " -> print
    flowed! -> if {
        expected == 0 -> if {
            "does not accept a flowed input" -> println
        } else {
            "expects $(expected - 1) additional argument(s)" -> println
        }
    } else {
        "expects $expected argument(s)" -> println
    }
}

emitInterpolationBindingSemanticPrefix context: ref emitterContext.EmitContext, nodeIndex: Int, sourceModule: Int -> Unit uses Console {
    context.interpolations -> semanticDiagnostics.unresolvedInterpolationBindingLocation(context.sources[sourceModule], nodeIndex) => location
    context -> emitInterpolationSemanticPrefixAt(nodeIndex, sourceModule, location)
}

binaryArithmeticOperatorName opcode: Int -> Text {
    opcode == grammar.tokenIdMinus() -> if { "-" -> return }
    opcode == grammar.tokenIdStar() -> if { "*" -> return }
    opcode == grammar.tokenIdSlash() -> if { "/" -> return }
    opcode == grammar.tokenIdPercent() -> if { "%" -> return }
    "+"
}

emitEnumPayloadStorageDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    context.enumPayloadStorageDiagnostics -> each diagnostic {
        context.ir[diagnostic.bindingIr] => binding
        context.ranges[diagnostic.sourceModule] => range
        binding.kind == 29 -> if {
            context.nodes[range.astStart + binding.astNode] => pattern
            context.tokens[range.tokenStart + pattern.secondaryToken] => payloadToken
            context.sources[diagnostic.sourceModule] -> slice(payloadToken.span.start, payloadToken.span.length) => payloadName
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(pattern.start) => location
            "<main>" => moduleName!
            not (context.nodes -> semanticDiagnostics.expressionBelongsToMain(range, binding.astNode))
                and context.modules[diagnostic.sourceModule].pathLength > 0
                -> if {
                    context.modules[diagnostic.sourceModule] => identity
                    context.sources[diagnostic.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
                }
            "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] " -> print
            payloadName -> emitBorrowedEnumPayloadMessage
        } else {
            context.symbols[range.symbolStart + binding.symbol] => owner
            context.tokens[range.tokenStart + owner.nameToken] => token
            context.sources[diagnostic.sourceModule] -> slice(token.span.start, token.span.length) => name
            diagnostic.argumentNode >= 0 -> if {
                context.interpolations -> semanticDiagnostics.interpolationExpressionLocation(context.sources[diagnostic.sourceModule], diagnostic.argumentNode) => location
                context -> emitInterpolationSemanticPrefixAt(diagnostic.argumentNode, diagnostic.sourceModule, location)
            } else {
                context.nodes[range.astStart + diagnostic.argumentAst] => argument
                context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(argument.start) => location
                "<main>" => moduleName!
                not (context.nodes -> semanticDiagnostics.expressionBelongsToMain(range, diagnostic.argumentAst))
                    and context.modules[diagnostic.sourceModule].pathLength > 0
                    -> if {
                        context.modules[diagnostic.sourceModule] => identity
                        context.sources[diagnostic.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
                    }
                "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] " -> print
            }
            "owned value '$name' is borrowed and cannot be stored in owned enum payload storage; transfer ownership with a move input such as '$name: move ...', or store a borrowed view/copy the value explicitly" -> println
        }
    }
}

public emitInterpolationDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    context -> firstBlockingInterpolationNode => nodeIndex!
    nodeIndex! < (context.interpolations -> len)
        -> while {
            context.interpolations[nodeIndex!] => interpolationNode
            context -> isBlockingInterpolationArray(nodeIndex!)
                -> if {
                    context -> emitInterpolationArrayDiagnostic(nodeIndex!)
                    return
                }
            context.interpolationOwnedParameterCallByNode[nodeIndex!]
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    sourceModule >= 0 -> if {
                        context.tokens[context.ranges[sourceModule].tokenStart + interpolationNode.sourceToken].span.start => literalStart
                        context.sources[sourceModule] -> syntaxDiagnostics.sourceLocation(literalStart) => location
                        context -> emitInterpolationSemanticPrefixAt(nodeIndex!, sourceModule, location)
                        "owned container parameter calls must be direct calls or direct value-flow from a named owner" -> println
                    }
                    return
                }
            context.interpolationCallArgumentDiagnosticByNode[nodeIndex!].code > 0
                -> if {
                    context -> emitInterpolationCallArgumentDiagnostic(nodeIndex!)
                    return
                }
            context.interpolationResultPropagationByNode[nodeIndex!].status > 0
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    sourceModule >= 0 -> if {
                        context.interpolationResultPropagationByNode[nodeIndex!] => decision
                        context -> emitInterpolationSemanticPrefix(nodeIndex!, sourceModule)
                        decision.status == 1 -> if {
                            "'?' expects Result<T, E> but received " -> print
                            decision.operandTypeId -> emitBoxOperandTypeName(context)
                            "" -> println
                        }
                        decision.status == 2 -> if {
                            "'?' can only be used inside a function returning Result<T, E>" -> println
                        }
                        decision.status == 3 -> if {
                            "'?' error type " -> print
                            decision.operandErrorTypeId -> emitBoxOperandTypeName(context)
                            " does not match function error type " -> print
                            decision.functionErrorTypeId -> emitBoxOperandTypeName(context)
                            "" -> println
                        }
                        decision.status == 4 -> if {
                            "owned Result '?' must consume a temporary Result or the function's explicit move input" -> println
                        }
                    }
                }
            context.unresolvedInterpolationBindingByNode[nodeIndex!]
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    sourceModule >= 0 -> if {
                        context.sources[sourceModule] -> slice(interpolationNode.payloadStart, interpolationNode.payloadLength) => name
                        context -> emitInterpolationBindingSemanticPrefix(nodeIndex!, sourceModule)
                        interpolationNode.prefixSymbol >= 0 and interpolationNode.payloadStart > 0
                            and (context.sources[sourceModule] -> byte(interpolationNode.payloadStart - 1)) == 36
                            -> if {
                                context.ranges[sourceModule] => sourceRange
                                context.symbols[sourceRange.symbolStart + interpolationNode.prefixSymbol] => prefixBinding
                                context.tokens[sourceRange.tokenStart + prefixBinding.nameToken] => prefixToken
                                context.sources[sourceModule] -> slice(prefixToken.span.start, prefixToken.span.length) => prefixName
                                context.sources[sourceModule] -> slice(interpolationNode.payloadStart + prefixToken.span.length, interpolationNode.payloadLength - prefixToken.span.length) => suffix
                                "unknown binding '$name'; use '" -> print
                                "$" -> print
                                "($prefixName)$suffix' to mark the interpolation boundary" -> println
                            } else {
                                "unknown binding '$name'; check its spelling and lexical scope. If the value was consumed by a move input, use the owner returned by that call, borrow it before the move, or create a new owner before reuse" -> println
                            }
                    } else {
                        "sollang: semantic error: unknown interpolation binding" -> println
                    }
                }
            context.uninvokedInterpolationFunctionByNode[nodeIndex!]
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    sourceModule >= 0 -> if {
                        context.sources[sourceModule] -> slice(interpolationNode.payloadStart, interpolationNode.payloadLength) => name
                        context -> emitInterpolationBindingSemanticPrefix(nodeIndex!, sourceModule)
                        interpolationNode.bareFunctionStatus == 1
                            -> if {
                                "function '$name' expects an argument and must use call or flow syntax" -> println
                            } else {
                                "zero-input function '$name' must be called with parentheses: '$name()'" -> println
                            }
                    }
                }
            context.uninvokedAssociatedMemberByNode[nodeIndex!]
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.interpolations[interpolationNode.operand0] => ownerNameNode
                    context.sources[sourceModule] -> slice(ownerNameNode.payloadStart, ownerNameNode.payloadLength) => ownerName
                    context.sources[sourceModule] -> slice(interpolationNode.callNameStart, interpolationNode.callNameLength) => memberName
                    context -> emitInterpolationSemanticPrefix(nodeIndex!, sourceModule)
                    "zero-input function '$ownerName.$memberName' must be called with parentheses: '$ownerName.$memberName()'" -> println
                }
            context.missingLocalAssociatedMemberByNode[nodeIndex!]
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.interpolations[interpolationNode.operand0] => ownerNameNode
                    context.sources[sourceModule] -> slice(ownerNameNode.payloadStart, ownerNameNode.payloadLength) => ownerName
                    context.sources[sourceModule] -> slice(interpolationNode.callNameStart, interpolationNode.callNameLength) => fieldName
                    context -> emitInterpolationSemanticPrefix(nodeIndex!, sourceModule)
                    "type '$ownerName' has no zero-argument associated member '$fieldName'" -> println
                }
            context.localEnumMemberDecisionByNode[nodeIndex!].status == 1
                or context.localEnumMemberDecisionByNode[nodeIndex!].status == 2
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.sources[sourceModule] -> slice(interpolationNode.callNameStart, interpolationNode.callNameLength) => variantName
                    interpolationNode.kind == 15 -> if {
                        # C# generic member diagnostics retain the fragment's canonical origin.
                        context -> emitInterpolationSemanticPrefixAt(nodeIndex!, sourceModule, syntaxDiagnostics.SourceLocation { line: 1, column: 1 })
                    } else { context -> emitInterpolationSemanticPrefix(nodeIndex!, sourceModule) }
                    context.localEnumMemberDecisionByNode[nodeIndex!].status == 1
                        -> if { "enum '" -> print } else { "variant '" -> print }
                    interpolationNode.kind == 15 -> if {
                        context.localEnumMemberDecisionByNode[nodeIndex!].typeId -> emitBoxOperandTypeName(context)
                    } else {
                        context.interpolations[interpolationNode.operand0] => ownerNameNode
                        context.sources[sourceModule] -> slice(ownerNameNode.payloadStart, ownerNameNode.payloadLength) -> print
                    }
                    context.localEnumMemberDecisionByNode[nodeIndex!].status == 1
                        -> if {
                            "' has no variant '$variantName'" -> println
                        } else { ".$variantName' requires a payload argument" -> println }
                }
            context.unresolvedInterpolationCallByNode[nodeIndex!]
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.sources[sourceModule] -> slice(interpolationNode.callNameStart, interpolationNode.callNameLength) => name
                    context.interpolations -> semanticDiagnostics.interpolationCallTargetLocation(context.sources[sourceModule], nodeIndex!) => location
                    context -> emitInterpolationSemanticPrefixAt(nodeIndex!, sourceModule, location)
                    interpolationNode.qualifiedReceiverStatus == 2
                        -> if {
                            "unknown function or method '$name'" -> println
                        } else {
                            "unknown value-flow target '" -> print
                            context -> emitFlowTargetName(sourceModule, interpolationNode.callNameStart, interpolationNode.callNameLength)
                            "'" -> println
                        }
                }
            context.directCallExpectedArityByNode[nodeIndex!] >= 0
                -> if {
                    context -> emitInterpolationCallArityDiagnostic(nodeIndex!)
                }
            context.semanticInterpolationCallTargets[nodeIndex!].status == 2
                -> if {
                    context.semanticInterpolationCallTargets[nodeIndex!] => target
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    interpolationNode.callNameStart => memberStart!
                    memberStart! => nameByte!
                    nameByte! < interpolationNode.callNameStart + interpolationNode.callNameLength
                        -> while {
                            (context.sources[sourceModule] -> byte(nameByte!)) == 46
                                -> if { nameByte! + 1 => memberStart! }
                            nameByte! + 1 => nameByte!
                        }
                    context.sources[sourceModule] -> slice(memberStart!, interpolationNode.callNameStart + interpolationNode.callNameLength - memberStart!) => name
                    "sollang: ambiguous trait member '" -> print
                    target.receiverType -> emitBoxOperandTypeName(context)
                    ".$name'; use 'value -> Trait.$name'" -> println
                }
            context.semanticInterpolationCallTargets[nodeIndex!].status == 3
                -> if {
                    context.semanticInterpolationCallTargets[nodeIndex!] => target
                    context.ranges[target.sourceModule] => declarationRange
                    context.symbols[declarationRange.symbolStart + target.symbol] => declaration
                    context.tokens[declarationRange.tokenStart + declaration.nameToken] => nameToken
                    context.sources[target.sourceModule] -> syntaxDiagnostics.sourceLocation(nameToken.span.start) => location
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.sources[sourceModule] -> slice(interpolationNode.callNameStart, interpolationNode.callNameLength) => name
                    context -> emitInterpolationSemanticPrefixAt(nodeIndex!, sourceModule, location)
                    "function '$name' expects $(target.expectedAdditionalArguments) additional argument(s)" -> println
                }
            context.importedInterpolationCallTargetByNode[nodeIndex!] < -2
                -> if {
                    -context.importedInterpolationCallTargetByNode[nodeIndex!] - 3 => functionIndex
                    context.ir[functionIndex] => function
                    context.semanticInterpolationCallTargets[nodeIndex!].ownerType => receiverTypeId!
                    receiverTypeId! < 0 -> if { context.ir[function.operand1].typeId => receiverTypeId! }
                    receiverTypeId! => receiverTypeId
                    context.types[receiverTypeId] => receiverType
                    context.ranges[function.sourceModule] => functionRange
                    context.symbols[functionRange.symbolStart + function.symbol] => declaration
                    context.tokens[functionRange.tokenStart + declaration.nameToken] => nameToken
                    context.sources[function.sourceModule] -> slice(nameToken.span.start, nameToken.span.length) => name
                    context.modules[function.sourceModule] => identity
                    context.sources[function.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.interpolations -> semanticDiagnostics.interpolationCallTargetLocation(context.sources[sourceModule], nodeIndex!) => location
                    context -> emitInterpolationSemanticPrefixAt(nodeIndex!, sourceModule, location)
                    "function '" -> print
                    context.semanticInterpolationCallTargets[nodeIndex!] => method
                    method.traitModule >= 0 -> if {
                        context.modules[method.traitModule] => traitModule
                        traitModule.sourceIndex => traitSource
                        traitModule.pathLength > 0 -> if {
                            context.sources[traitSource] -> slice(traitModule.pathStart, traitModule.pathLength) -> print
                            "." -> print
                        }
                        context.ranges[traitSource] => traitRange
                        context.symbols[traitRange.symbolStart + method.traitSymbol] => traitSymbol
                        context.tokens[traitRange.tokenStart + traitSymbol.nameToken] => traitName
                        context.sources[traitSource] -> slice(traitName.span.start, traitName.span.length) -> print
                        "." -> print
                    }
                    (receiverType.kind == 1 and receiverType.origin == 1)
                        or receiverType.kind == 2 or receiverType.kind == 3
                        or receiverType.kind == 4 or receiverType.kind == 12
                        -> if { "$moduleName." -> print }
                    receiverTypeId -> emitBoxOperandTypeName(context)
                    ".$name' is internal to module '$moduleName'" -> println
                }
            context.interpolationMissingMemberOwnerTypeByNode[nodeIndex!] >= 0
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    interpolationNode.callNameLength > 0 -> if {
                        context.sources[sourceModule] -> slice(interpolationNode.callNameStart, interpolationNode.callNameLength) => memberName
                        context.interpolations -> semanticDiagnostics.interpolationExpressionLocation(context.sources[sourceModule], nodeIndex!) => location
                        context -> emitInterpolationSemanticPrefixAt(nodeIndex!, sourceModule, location)
                        "struct '" -> print
                        context.interpolationMissingMemberOwnerTypeByNode[nodeIndex!] -> emitBoxOperandTypeName(context)
                        "' has no field or readonly computed member '$memberName'" -> println
                    } else {
                        "; sollang compiler error S062: interpolation member has no field token" -> println
                    }
                }
            context.interpolationPrivateFieldByNode[nodeIndex!] >= 0
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.interpolationPrivateFieldByNode[nodeIndex!] => fieldIndex
                    context.fields[fieldIndex] => field
                    context.types[field.ownerType] => ownerType
                    context -> privateFieldOwnerSource(field.ownerType) => ownerSource
                    context.ranges[ownerSource] => ownerRange
                    context.symbols[ownerRange.symbolStart + ownerType.symbol] => ownerSymbol
                    context.tokens[ownerRange.tokenStart + ownerSymbol.nameToken] => ownerNameToken
                    context.sources[ownerSource] -> slice(ownerNameToken.span.start, ownerNameToken.span.length) => ownerName
                    context.modules[ownerSource] => ownerModule
                    context.sources[ownerSource] -> slice(ownerModule.pathStart, ownerModule.pathLength) => moduleName
                    context.symbols[ownerRange.symbolStart + field.fieldSymbol] => fieldSymbol
                    context.tokens[ownerRange.tokenStart + fieldSymbol.nameToken] => fieldNameToken
                    context.sources[ownerSource] -> slice(fieldNameToken.span.start, fieldNameToken.span.length) => fieldName
                    context -> emitInterpolationSemanticPrefix(nodeIndex!, sourceModule)
                    "cannot read private field '$fieldName' of struct '$moduleName.$ownerName' outside module '$moduleName'; use its public factory or public instance methods" -> println
                }
            context.invalidArgumentsInterpolationIndexByNode[nodeIndex!]
                and context.invalidCollectionIndexExpectedTypeByNode[nodeIndex!] < 0
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.interpolations[interpolationNode.operand1] => index
                    "; sollang semantic error: index must be UIntSize (source $sourceModule, byte $(index.payloadStart), length $(index.payloadLength))" -> println
                }
            context.unsupportedIndexOwnerTypeByNode[nodeIndex!] >= 0
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.types[context.unsupportedIndexOwnerTypeByNode[nodeIndex!]] => ownerType
                    context.interpolations -> semanticDiagnostics.interpolationFragmentLocation(context.sources[sourceModule], interpolationNode.operand0) => location
                    context -> emitInterpolationSemanticPrefixAt(nodeIndex!, sourceModule, location)
                    ownerType.kind == 7 and ownerType.origin == 4
                        and (ownerType.symbol == 5 or ownerType.symbol == 6 or ownerType.symbol == 7)
                        -> if {
                            context.unsupportedIndexOwnerTypeByNode[nodeIndex!] -> emitBoxOperandTypeName(context)
                            " preserves its invariant and does not support indexing" -> print
                        } else {
                            "indexing expects an array, dictionary, or mapped byte view" -> print
                        }
                    "" -> println
                }
            (context -> isBlockingMappedIndexInterpolation(nodeIndex!))
                and context.invalidCollectionIndexExpectedTypeByNode[nodeIndex!] < 0
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.interpolations[interpolationNode.operand1] => index
                    "; sollang semantic error: index must be UIntSize (source $sourceModule, byte $(index.payloadStart), length $(index.payloadLength))" -> println
                }
            context.invalidCollectionIndexExpectedTypeByNode[nodeIndex!] >= 0
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context -> emitInterpolationSemanticPrefix(interpolationNode.operand1, sourceModule)
                    "index must be " -> print
                    context.invalidCollectionIndexExpectedTypeByNode[nodeIndex!] -> emitBoxOperandTypeName(context)
                    "" -> println
                }
            context.interpolationContextualDiagnosticByNode[nodeIndex!].code > 0
                -> if {
                    context.interpolationContextualDiagnosticByNode[nodeIndex!] => diagnostic
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context -> emitInterpolationSemanticPrefix(diagnostic.locationNode, sourceModule)
                    diagnostic.code == 1 -> if {
                        "contextual " -> print
                        diagnostic.ownerType -> emitBoxOperandTypeName(context)
                        " literal field name must be an identifier" -> println
                    }
                    diagnostic.code == 2 -> if {
                        context.interpolations[diagnostic.locationNode] => label
                        context.sources[sourceModule] -> slice(label.payloadStart, label.payloadLength) => name
                        "field '$name' is initialized more than once" -> print
                        interpolationNode.kind == 14 -> if {
                            " in '" -> print
                            diagnostic.ownerType -> emitBoxOperandTypeName(context)
                            "'" -> print
                        }
                        "" -> println
                    }
                    diagnostic.code == 3 -> if {
                        context.fields[diagnostic.fieldIndex] => field
                        context.ranges[field.sourceModule] => fieldRange
                        field.labelToken => fieldTokenIndex!
                        field.fieldSymbol >= 0 -> if {
                            context.symbols[fieldRange.symbolStart + field.fieldSymbol].nameToken => fieldTokenIndex!
                        }
                        context.tokens[fieldRange.tokenStart + fieldTokenIndex!] => fieldToken
                        context.sources[field.sourceModule] -> slice(fieldToken.span.start, fieldToken.span.length) => fieldName
                        interpolationNode.kind == 14 -> if {
                            "struct '" -> print
                            diagnostic.ownerType -> emitBoxOperandTypeName(context)
                            "' requires field '$fieldName' to be initialized" -> println
                        } else {
                            "contextual " -> print
                            diagnostic.ownerType -> emitBoxOperandTypeName(context)
                            " literal is missing field '$fieldName'" -> println
                        }
                    }
                    diagnostic.code == 4 -> if {
                        context.fields[diagnostic.fieldIndex] => field
                        context.ranges[field.sourceModule] => fieldRange
                        field.labelToken => fieldTokenIndex!
                        field.fieldSymbol >= 0 -> if {
                            context.symbols[fieldRange.symbolStart + field.fieldSymbol].nameToken => fieldTokenIndex!
                        }
                        context.tokens[fieldRange.tokenStart + fieldTokenIndex!] => fieldToken
                        context.sources[field.sourceModule] -> slice(fieldToken.span.start, fieldToken.span.length) => fieldName
                        "field '" -> print
                        interpolationNode.kind != 14 -> if {
                            diagnostic.ownerType -> emitBoxOperandTypeName(context)
                            "." -> print
                        }
                        "$fieldName' expects " -> print
                        field.fieldType -> emitBoxOperandTypeName(context)
                        ", got " -> print
                        diagnostic.actualType -> emitBoxOperandTypeName(context)
                        "" -> println
                    }
                    diagnostic.code == 5 -> if {
                        context.interpolations[diagnostic.locationNode] => label
                        context.sources[sourceModule] -> slice(label.payloadStart, label.payloadLength) => name
                        "struct '" -> print
                        diagnostic.ownerType -> emitBoxOperandTypeName(context)
                        "' has no field '$name'" -> println
                    }
                    diagnostic.code == 6 -> if {
                        context.interpolations[diagnostic.locationNode] => literal
                        context.sources[sourceModule] -> slice(literal.callNameStart, literal.callNameLength) => typeName
                        "unknown struct type '$typeName'" -> println
                    }
                    diagnostic.code == 7 -> if {
                        context.types[diagnostic.ownerType] => ownerType
                        context.modules[ownerType.module] => ownerModule
                        context.sources[ownerType.module] -> slice(ownerModule.pathStart, ownerModule.pathLength) => ownerName
                        "type '" -> print
                        diagnostic.ownerType -> emitBoxOperandTypeName(context)
                        "' is internal to module '$ownerName'" -> println
                    }
                }
            context.interpolationOwnedIndexElementTypeByNode[nodeIndex!] >= 0
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.interpolations -> semanticDiagnostics.interpolationIndexExpressionLocation(context.sources[sourceModule], nodeIndex!) => location
                    context -> emitInterpolationSemanticPrefixAt(nodeIndex!, sourceModule, location)
                    context.interpolationOwnedIndexElementTypeByNode[nodeIndex!] -> emitOwnedIndexReadMessage(context.interpolationOwnedIndexContainerByNode[nodeIndex!] == 2, context)
                }
            context -> isBlockingInvalidUnaryInterpolation(nodeIndex!)
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.interpolations[interpolationNode.operand0] => operand
                    context -> emitInterpolationSemanticPrefix(interpolationNode.operand0, sourceModule)
                    "operand of unary '-' must be a signed numeric value" -> println
                }
            context -> isBlockingInvalidNotInterpolation(nodeIndex!)
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context -> emitInterpolationSemanticPrefix(interpolationNode.operand0, sourceModule)
                    "'not' expects Bool" -> println
                }
            context.invalidIntrinsicFlowArityByNode[nodeIndex!]
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.interpolations -> semanticDiagnostics.interpolationCallTargetLocation(context.sources[sourceModule], nodeIndex!) => location
                    context -> emitInterpolationSemanticPrefixAt(nodeIndex!, sourceModule, location)
                    interpolationNode.opcode == -202 or interpolationNode.opcode == -203
                        -> if {
                            interpolationNode.opcode -> emitTextIntrinsicArityDiagnostic
                        }
                    interpolationNode.opcode == -101 -> if {
                        "len does not accept arguments" -> println
                    }
                    interpolationNode.opcode == -236 -> if {
                        "capacity does not accept arguments" -> println
                    }
                    interpolationNode.opcode == -244 -> if {
                        "BitSet count does not accept arguments" -> println
                    }
                }
            context.invalidTextIntrinsicArgumentByNode[nodeIndex!] >= 0
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context -> emitInterpolationSemanticPrefix(context.invalidTextIntrinsicArgumentByNode[nodeIndex!], sourceModule)
                    interpolationNode.opcode -> emitTextIntrinsicIndexDiagnostic
                }
            context.collectionMembershipDiagnosticByNode[nodeIndex!].code > 0
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.collectionMembershipDiagnosticByNode[nodeIndex!] => membership
                    membership.code == 1 or membership.code == 2 -> if {
                        context.interpolations -> semanticDiagnostics.interpolationCallTargetLocation(context.sources[sourceModule], nodeIndex!) => location
                        context -> emitInterpolationSemanticPrefixAt(nodeIndex!, sourceModule, location)
                        membership.code == 1 -> if {
                            "BitSet operation expects exactly one Int bit index" -> println
                        } else { "Set contains expects exactly one element" -> println }
                    } else {
                        context -> emitInterpolationSemanticPrefix(membership.argumentNode, sourceModule)
                        membership.code == 3 -> if {
                            "BitSet index must be Int, got " -> print
                        } else {
                            "Set element must be " -> print
                            membership.expectedTypeId -> emitBoxOperandTypeName(context)
                            ", got " -> print
                        }
                        membership.actualTypeId -> emitBoxOperandTypeName(context)
                        "" -> println
                    }
                }
            context -> isBlockingContextualNumericLiteralInterpolation(nodeIndex!)
                -> if { context -> emitContextualNumericLiteralDiagnostic(nodeIndex!) }
            context.invalidNumericConversionArityByNode[nodeIndex!]
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.sources[sourceModule] -> slice(interpolationNode.callNameStart, interpolationNode.callNameLength) => targetName
                    context -> emitInterpolationSemanticPrefix(nodeIndex!, sourceModule)
                    "numeric conversion '$targetName' expects exactly one argument" -> println
                }
            context.invalidNumericConversionTypeByNode[nodeIndex!] >= 0
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.sources[sourceModule] -> slice(interpolationNode.callNameStart, interpolationNode.callNameLength) => targetName
                    context -> emitInterpolationSemanticPrefix(interpolationNode.operand0, sourceModule)
                    "numeric conversion '$targetName' expects a numeric value, got " -> print
                    context.invalidNumericConversionTypeByNode[nodeIndex!] -> emitBoxOperandTypeName(context)
                    "" -> println
                }
            context.invalidCodePointFloatConversionByNode[nodeIndex!]
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context -> emitInterpolationSemanticPrefix(interpolationNode.operand0, sourceModule)
                    "CodePoint conversion requires an integer Unicode scalar value" -> println
                }
            context.invalidNumericConversionLiteralByNode[nodeIndex!] >= 0
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    interpolationNode.operand0 => literalIndex!
                    false => negative!
                    context.interpolations[literalIndex!] => operand
                    operand.kind == 2 and operand.opcode == grammar.tokenIdMinus()
                        -> if {
                            operand.operand0 => literalIndex!
                            true => negative!
                        }
                    context.interpolations[literalIndex!] => literal
                    context.sources[sourceModule] -> slice(interpolationNode.callNameStart, interpolationNode.callNameLength) => targetName
                    context -> emitInterpolationSemanticPrefix(interpolationNode.operand0, sourceModule)
                    "numeric literal " -> print
                    negative! -> if { "-" -> print }
                    (context.sources[sourceModule] -> byte(literal.payloadStart)) == 39
                        -> if {
                            syntax.SourceSpan { fileId: sourceModule, start: literal.payloadStart, length: literal.payloadLength } => characterSpan
                            context.sources[sourceModule] -> syntax.decodeCharacterLiteral(characterSpan) -> when {
                                Some(value) { "$value" -> print }
                                None { context.sources[sourceModule] -> slice(literal.payloadStart, literal.payloadLength) -> print }
                            }
                        } else {
                            context.sources[sourceModule] -> slice(literal.payloadStart, literal.payloadLength) -> print
                        }
                    context.invalidNumericConversionLiteralByNode[nodeIndex!] == 4
                        -> if { " is not an integer for $targetName" -> print } else {
                            context.invalidNumericConversionLiteralByNode[nodeIndex!] == 2
                                -> if { " is a Unicode surrogate and cannot be a CodePoint" -> print } else {
                                    context.invalidNumericConversionLiteralByNode[nodeIndex!] == 3
                                        -> if {
                                            " is out of range for $targetName" -> print
                                        } else {
                                            interpolationNode.typeSymbol -> numericLiteralRange.minimumText(context.pointerBitWidth) => minimum
                                            interpolationNode.typeSymbol -> numericLiteralRange.maximumText(context.pointerBitWidth) => maximum
                                            " is out of range for $targetName ($minimum..$maximum)" -> print
                                        }
                                }
                        }
                    "" -> println
                }
            context.binaryArithmeticDiagnosticByNode[nodeIndex!].code > 0
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.binaryArithmeticDiagnosticByNode[nodeIndex!] => diagnostic
                    interpolationNode.opcode -> binaryArithmeticOperatorName => operatorName
                    diagnostic.code == 3 -> if {
                        context -> emitInterpolationSemanticPrefix(interpolationNode.operand1, sourceModule)
                        "operands of '" -> print
                        operatorName -> print
                        "' must have the same numeric type; left is " -> print
                        diagnostic.leftTypeId -> emitBoxOperandTypeName(context)
                        ", right is " -> print
                        diagnostic.rightTypeId -> emitBoxOperandTypeName(context)
                        "" -> println
                    } else {
                        context -> emitInterpolationSemanticPrefix(interpolationNode.operand0, sourceModule)
                        diagnostic.code == 1 -> if {
                            "CodePoint does not support '" -> print
                            operatorName -> print
                            "'; convert it to UInt32 before arithmetic" -> println
                        } else {
                            "left operand of '" -> print
                            operatorName -> print
                            "' must be a compatible numeric value" -> println
                        }
                    }
                }
            context.binaryComparisonDiagnosticByNode[nodeIndex!].code > 0
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.binaryComparisonDiagnosticByNode[nodeIndex!] => diagnostic
                    diagnostic.code == 2 or diagnostic.code == 4 -> if {
                        context -> emitInterpolationSemanticPrefix(interpolationNode.operand1, sourceModule)
                    } else {
                        context -> emitInterpolationSemanticPrefix(interpolationNode.operand0, sourceModule)
                    }
                    diagnostic.code == 1 -> if {
                        "Text supports content equality with '==' and '!='; ordering requires an explicit text comparison API" -> println
                    } else {
                        diagnostic.code == 2 -> if {
                            "Text equality requires Text on both sides; left is " -> print
                            diagnostic.leftTypeId -> emitBoxOperandTypeName(context)
                            ", right is " -> print
                            diagnostic.rightTypeId -> emitBoxOperandTypeName(context)
                            "" -> println
                        } else {
                            diagnostic.code == 3 -> if {
                                "left operand of comparison must be numeric" -> println
                            } else {
                                "comparison operands must have the same numeric type; left is " -> print
                                diagnostic.leftTypeId -> emitBoxOperandTypeName(context)
                                ", right is " -> print
                                diagnostic.rightTypeId -> emitBoxOperandTypeName(context)
                                "" -> println
                            }
                        }
                    }
                }
            context.binaryLogicalDiagnosticByNode[nodeIndex!] > 0
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.binaryLogicalDiagnosticByNode[nodeIndex!] == 1
                        -> if {
                            context -> emitInterpolationSemanticPrefix(interpolationNode.operand0, sourceModule)
                            "left operand of '" -> print
                        } else {
                            context -> emitInterpolationSemanticPrefix(interpolationNode.operand1, sourceModule)
                            "right operand of '" -> print
                        }
                    interpolationNode.opcode == -24 -> if { "or" -> print } else { "and" -> print }
                    "' must be Bool" -> println
                }
            context.invalidDisplayTypeByNode[nodeIndex!] >= 0
                and context.interpolationOwnedIndexElementTypeByNode[nodeIndex!] < 0
                and context.binaryArithmeticDiagnosticByNode[nodeIndex!].code == 0
                and context.binaryComparisonDiagnosticByNode[nodeIndex!].code == 0
                and context.binaryLogicalDiagnosticByNode[nodeIndex!] == 0
                -> if {
                    context -> interpolationSourceModule(nodeIndex!) => sourceModule
                    context.ranges[sourceModule] => sourceRange
                    context.tokens[sourceRange.tokenStart + interpolationNode.sourceToken] => stringToken
                    context.sources[sourceModule] -> syntaxDiagnostics.sourceLocation(stringToken.span.start) => location
                    context -> emitInterpolationSemanticPrefixAt(nodeIndex!, sourceModule, location)
                    "string interpolation expects Text, Int, or Bool but received " -> print
                    context.invalidDisplayTypeByNode[nodeIndex!] -> emitBoxOperandTypeName(context)
                    "" -> println
                }
            context.interpolations -> len => nodeIndex!
        }
}

flowTargetPath context: ref emitterContext.EmitContext, callIndex: Int -> Int {
    context.calls[callIndex] => call
    context.ranges[call.sourceModule] => range
    context.nodes[range.astStart + call.callAst] => callNode
    callNode.kind != 10 -> if { -1 -> return }
    -1 => target!
    0 => index!
    index! < range.astCount -> while {
        context.nodes[range.astStart + index!] => node
        node.kind == 16 and node.parent == call.callAst and node.start > callNode.start
            -> if {
                target! < 0 -> if { index! => target! } else {
                    node.start > context.nodes[range.astStart + target!].start
                        -> if { index! => target! }
                }
            }
        index! + 1 => index!
    }
    target!
}

public unresolvedCallNameToken context: ref emitterContext.EmitContext, callIndex: Int -> Int {
    -1 => nameToken!
    callIndex >= 0 and callIndex < (context.calls -> len)
        -> if {
            context.calls[callIndex] => call
            context.ranges[call.sourceModule] => sourceRange
            context.nodes[sourceRange.astStart + call.callAst] => callNode
            context -> flowTargetPath(callIndex) => targetPath
            targetPath >= 0 -> if {
                context.nodes[sourceRange.astStart + targetPath].payloadToken -> return
            }
            callNode.kind == 48 -> if { callNode.payloadToken => nameToken! }
            callNode.kind == 15 -> if { callNode.payloadToken => nameToken! }
            callNode.kind == 36 -> if {
                callNode.firstToken => pathToken!
                pathToken! < callNode.firstToken + callNode.tokenCount
                    -> while {
                        context.tokens[sourceRange.tokenStart + pathToken!].kind == grammar.tokenIdIdentifier()
                            -> if { pathToken! => nameToken! }
                        pathToken! + 1 => pathToken!
                    }
            }
            callNode.kind == 10 -> if {
                false => afterArrow!
                0 => argumentDepth!
                callNode.firstToken => tokenIndex!
                tokenIndex! < callNode.firstToken + callNode.tokenCount
                    -> while {
                        context.tokens[sourceRange.tokenStart + tokenIndex!] => token
                        token.kind == grammar.tokenIdArrow() and argumentDepth! == 0
                            -> if {
                                true => afterArrow!
                                -1 => nameToken!
                            }
                        token.kind == grammar.tokenIdLeftParen()
                            -> if { argumentDepth! + 1 => argumentDepth! }
                        token.kind == grammar.tokenIdRightParen() and argumentDepth! > 0
                            -> if { argumentDepth! - 1 => argumentDepth! }
                        afterArrow! and argumentDepth! == 0 and token.kind == grammar.tokenIdIdentifier()
                            -> if { tokenIndex! => nameToken! }
                        tokenIndex! + 1 => tokenIndex!
                    }
            }
        }
    nameToken!
}

public isBlockingUnresolvedCall context: ref emitterContext.EmitContext, callIndex: Int -> Bool {
    false => blocking!
    callIndex >= 0 and callIndex < (context.calls -> len)
        -> if {
            context.calls[callIndex] => candidate
            context.ranges[candidate.sourceModule] => flowDecisionRange
            context.unsupportedNominalEnumFlowPathByAst[flowDecisionRange.astStart + candidate.callAst] >= 0
                -> if { true => blocking! }
            candidate.status == 4 or candidate.status == 5
                -> if { true => blocking! }
            candidate.status == 7 -> if {
                context.ranges[candidate.sourceModule] => nominalCallRange
                candidate.callAst >= 0 and candidate.callAst < nominalCallRange.astCount
                    -> if {
                        nominalCallRange.astStart + candidate.callAst => nominalCallAst
                        nominalCallAst < (context.finalCallResolvedByAst -> len)
                            -> if { not context.finalCallResolvedByAst[nominalCallAst] => blocking! }
                    }
            }
            candidate.status == 2 or candidate.status == 3
                -> if {
                    context.ranges[candidate.sourceModule] => candidateRange
                    context.nodes[candidateRange.astStart + candidate.callAst] => candidateNode
                    # The preliminary module-call table intentionally retains an
                    # unresolved entry for an inherent flow call until receiver
                    # types are final. The global AST index was built once from
                    # final Typed IR and is the authoritative convergence proof.
                    false => finalCallResolved!
                    candidate.callAst >= 0 and candidate.callAst < candidateRange.astCount
                        -> if {
                            candidateRange.astStart + candidate.callAst => finalCallAst
                            finalCallAst < (context.finalCallResolvedByAst -> len)
                                -> if {
                                    context.finalCallResolvedByAst[finalCallAst] => finalCallResolved!
                                }
                        }
                    # Type conversions and nominal/enum constructors share the direct
                    # call CST shape but are resolved by type analysis rather than the
                    # function-call table. Only flow and block-call targets are
                    # authoritative unresolved function diagnostics here.
                    false => qualifiedTarget!
                    false => dynConversionTarget!
                    context -> unresolvedCallNameToken(callIndex) => candidateNameToken
                    false => candidatePropagates!
                    candidateNameToken >= 0
                        and candidateNameToken + 1 < candidateNode.firstToken + candidateNode.tokenCount
                        -> if {
                            context.tokens[candidateRange.tokenStart + candidateNameToken + 1].kind
                                => candidateNextKind
                            candidateNextKind == grammar.tokenIdQuestion()
                                -> if { true => candidatePropagates! }
                        }
                    candidateNode.firstToken => qualifiedTokenSearch!
                    qualifiedTokenSearch! < candidateNode.firstToken + candidateNode.tokenCount
                        -> while {
                            context.tokens[candidateRange.tokenStart + qualifiedTokenSearch!] => qualifiedToken
                            qualifiedToken.kind == grammar.tokenIdDot() -> if { true => qualifiedTarget! }
                            qualifiedToken.kind == grammar.tokenIdLess() and qualifiedTokenSearch! > candidateNode.firstToken
                                -> if {
                                    context.tokens[candidateRange.tokenStart + qualifiedTokenSearch! - 1] => conversionToken
                                    conversionToken.span.length == 3 -> if {
                                        context.sources[candidate.sourceModule] -> byte(conversionToken.span.start) => conversionByte0
                                        context.sources[candidate.sourceModule] -> byte(conversionToken.span.start + 1) => conversionByte1
                                        context.sources[candidate.sourceModule] -> byte(conversionToken.span.start + 2) => conversionByte2
                                        conversionByte0 == 100 and conversionByte1 == 121 and conversionByte2 == 110
                                            -> if { true => dynConversionTarget! }
                                    }
                                }
                            qualifiedTokenSearch! + 1 => qualifiedTokenSearch!
                        }
                    candidateNameToken > 0 -> if {
                        context.tokens[candidateRange.tokenStart + candidateNameToken - 1] => previousToken
                        previousToken.kind == grammar.tokenIdDot() -> if { true => qualifiedTarget! }
                    }
                    false => resultBindingTarget!
                    candidateNode.kind == 10
                        and not qualifiedTarget!
                        and not candidatePropagates!
                        -> if {
                            context.tokens[candidateRange.tokenStart + candidateNameToken]
                                => candidateName
                            0 => sourceCallIndex!
                            sourceCallIndex! < (context.calls -> len) -> while {
                                context.calls[sourceCallIndex!] => sourceCall
                                sourceCall.status == 0 and sourceCall.sourceModule == candidate.sourceModule and sourceCall.callAst != candidate.callAst
                                    -> if {
                                        context.nodes[candidateRange.astStart + sourceCall.callAst] => sourceCallNode
                                        sourceCallNode.parent => sourceCallAncestor!
                                        false => sourceBelongsToCandidate!
                                        sourceCallAncestor! >= 0 and not sourceBelongsToCandidate!
                                            -> while {
                                                sourceCallAncestor! == candidate.callAst -> if {
                                                    true => sourceBelongsToCandidate!
                                                } else {
                                                    context.nodes[candidateRange.astStart + sourceCallAncestor!].parent => sourceCallAncestor!
                                                }
                                            }
                                        false => sourceCallHasArguments!
                                        sourceCallNode.firstToken => sourceCallToken!
                                        sourceCallToken! < sourceCallNode.firstToken + sourceCallNode.tokenCount
                                            -> while {
                                                context.tokens[candidateRange.tokenStart + sourceCallToken!].kind == grammar.tokenIdLeftParen()
                                                    -> if { true => sourceCallHasArguments! }
                                                sourceCallToken! + 1 => sourceCallToken!
                                            }
                                        sourceBelongsToCandidate! and not sourceCallHasArguments! and sourceCallNode.start < candidateName.span.start
                                            -> if {
                                                true => resultBindingTarget!
                                            }
                                    }
                                sourceCallIndex! + 1 => sourceCallIndex!
                            }
                        }
                    (candidateNode.kind == 10 or candidateNode.kind == 48)
                        and candidateNameToken >= 0
                    # A dotted flow target still requires a final declaration
                    # or intrinsic identity. Qualification cannot suppress an
                    # ordinary unknown-target error and defer it to V006.
                        and (not qualifiedTarget! or candidateNode.kind == 10)
                        and not dynConversionTarget!
                        and not resultBindingTarget!
                        and not finalCallResolved!
                        -> if {
                            true => blocking!
                        }
                }
        }
    blocking!
}

emitOpenImportAmbiguity context: ref emitterContext.EmitContext, call: calls.ModuleCallResolution, nameToken: syntax.SyntaxToken, name: Text -> Bool uses Console {
    [Int; ~] => matchingImports!
    context.ranges[call.sourceModule] => sourceRange
    context.sources[call.sourceModule] -> len => sourceLength
    context.sources[call.sourceModule] -> slice(UIntSize(0), sourceLength) => source
    0 => importIndex!
    importIndex! < (context.imports -> len) -> while {
        context.imports[importIndex!] => edge
        context.resolvedImports[importIndex!] => resolved
        false => importMatches!
        edge.sourceModule == call.sourceModule and resolved.status == 0
            -> if {
                context.modules[resolved.targetModule] => importedModule
                0 => fragmentIndex!
                fragmentIndex! < (context.modules -> len) and not importMatches!
                    -> while {
                        context.modules[fragmentIndex!] => fragment
                        fragment.pathHash == importedModule.pathHash -> if {
                            fragment.sourceIndex => targetSource
                            context.ranges[targetSource] => targetRange
                            context.sources[targetSource] -> len => targetLength
                            context.sources[targetSource] -> slice(UIntSize(0), targetLength) => targetText
                            0 => symbolIndex!
                            symbolIndex! < targetRange.symbolCount and not importMatches!
                                -> while {
                                    context.symbols[targetRange.symbolStart + symbolIndex!] => candidate
                                    candidate.kind == 7 and candidate.parent < 0 and candidate.nameToken >= 0 and candidate.flags / 4 % 2 == 1
                                        -> if {
                                            context.tokens[targetRange.tokenStart + candidate.nameToken] => candidateName
                                            candidateName.span.length == nameToken.span.length => sameName!
                                            UIntSize(0) => nameByte!
                                            sameName! and nameByte! < nameToken.span.length
                                                -> while {
                                                    (source -> byte(nameToken.span.start + nameByte!)) != (targetText -> byte(candidateName.span.start + nameByte!))
                                                        -> if {
                                                            false => sameName!
                                                        }
                                                    nameByte! + 1 => nameByte!
                                                }
                                            sameName! -> if { true => importMatches! }
                                        }
                                    symbolIndex! + 1 => symbolIndex!
                                }
                        }
                        fragmentIndex! + 1 => fragmentIndex!
                    }
            }
        importMatches! -> if { matchingImports! -> push(importIndex!) }
        importIndex! + 1 => importIndex!
    }
    (matchingImports! -> len) > 1 -> if {
        "; sollang semantic error: imported symbol '$name' is ambiguous between " -> print
        0 => matchIndex!
        matchIndex! < (matchingImports! -> len) -> while {
            matchIndex! > 0 -> if { ", " -> print }
            context.imports[matchingImports![matchIndex!]] => matchingEdge
            "'" -> print
            source -> slice(matchingEdge.pathStart, matchingEdge.pathLength) -> print
            ".$name'" -> print
            matchIndex! + 1 => matchIndex!
        }
        context.imports[matchingImports![0]] => firstEdge
        context.tokens[sourceRange.tokenStart + firstEdge.aliasToken] => firstAlias
        "; use a qualified name such as '" -> print
        source -> slice(firstAlias.span.start, firstAlias.span.length) -> print
        ".$name' or an import alias for the module (source $(call.sourceModule), byte $(nameToken.span.start), length $(nameToken.span.length))" -> println
        true -> return
    }
    false
}

emitFlowTargetName context: ref emitterContext.EmitContext, sourceModule: Int, nameStart: UIntSize, nameLength: UIntSize -> Unit uses Console {
    context.ranges[sourceModule] => range
    UIntSize(0) => firstLength!
    firstLength! < nameLength and (context.sources[sourceModule] -> byte(nameStart + firstLength!)) != 46
        -> while { firstLength! + 1 => firstLength! }
    context.sources[sourceModule] -> slice(nameStart, firstLength!) => firstName
    context.imports -> each edge {
        edge.sourceModule == sourceModule -> if {
            context.tokens[range.tokenStart + edge.aliasToken] => alias
            context.sources[sourceModule] -> slice(alias.span.start, alias.span.length) => aliasName
            firstName == aliasName -> if {
                context.sources[sourceModule] -> slice(edge.pathStart, edge.pathLength) -> print
                nameLength > firstLength! -> if {
                    context.sources[sourceModule] -> slice(nameStart + firstLength!, nameLength - firstLength!) -> print
                }
                return
            }
        }
    }
    context.sources[sourceModule] -> slice(nameStart, nameLength) -> print
}

emitCallDiagnostic context: ref emitterContext.EmitContext, callIndex: Int -> Unit uses Console {
    context.calls[callIndex] => call
    context -> isBlockingUnresolvedCall(callIndex)
        -> if {
            context.ranges[call.sourceModule] => sourceRange
            context.nodes[sourceRange.astStart + call.callAst] => callNode
            context -> unresolvedCallNameToken(callIndex) => callNameToken
            context.tokens[sourceRange.tokenStart + callNameToken] => nameToken
            nameToken.span.start => diagnosticNameStart!
            nameToken.span.length => diagnosticNameLength!
            callNode.kind == 36 -> if {
                callNode.start => diagnosticNameStart!
                callNode.length => diagnosticNameLength!
            }
            context -> flowTargetPath(callIndex) => directTargetPath
            directTargetPath >= 0 -> if {
                context.nodes[sourceRange.astStart + directTargetPath] => targetPath
                targetPath.start => diagnosticNameStart!
                targetPath.length => diagnosticNameLength!
            }
            context.unsupportedNominalEnumFlowPathByAst[sourceRange.astStart + call.callAst] => unsupportedNominalFlowPath
            unsupportedNominalFlowPath >= 0 -> if {
                context.nodes[sourceRange.astStart + unsupportedNominalFlowPath] => targetPath
                targetPath.start => diagnosticNameStart!
                targetPath.length => diagnosticNameLength!
            }
            diagnosticNameStart! => nameStart
            diagnosticNameLength! => nameLength
            context.sources[call.sourceModule] -> slice(nameStart, nameLength) => name
            false => propagatingTarget!
            callNameToken + 1 < sourceRange.tokenCount -> if {
                context.tokens[sourceRange.tokenStart + callNameToken + 1].kind
                    => callNextKind
                callNextKind == grammar.tokenIdQuestion()
                    -> if { true => propagatingTarget! }
            }
            call.status == 7 -> if {
                "; sollang semantic error: receiver has no accessible method '$name'; call a method declared for this receiver type or use a supported builtin collection receiver (source $(call.sourceModule), byte $nameStart, length $nameLength)" -> println
            } else {
                call.status == 4 -> if {
                    "; sollang semantic error: function '$name' expects an argument and must use call or flow syntax (source $(call.sourceModule), byte $nameStart, length $nameLength)" -> println
                } else {
                    call.status == 5 -> if {
                        "; sollang semantic error: zero-input function '$name' must be called with parentheses: '$name()' (source $(call.sourceModule), byte $nameStart, length $nameLength)" -> println
                    } else {
                        context -> emitOpenImportAmbiguity(call, nameToken, name) => emittedAmbiguity
                        not emittedAmbiguity -> if {
                            propagatingTarget! -> if {
                                "; sollang semantic error: unresolved instance call target '$name'; the identifier after '->' is the method name, while the identifier after '=>' is the result binding; use an existing instance method name before '?' (source $(call.sourceModule), byte $nameStart, length $nameLength)" -> println
                            } else {
                                callNode.kind == 10 -> if {
                                    context.sources[call.sourceModule] -> syntaxDiagnostics.sourceLocation(nameStart) => location
                                    "<main>" => moduleName!
                                    context.modules[call.sourceModule].pathLength > 0
                                        -> if {
                                            context.modules[call.sourceModule] => identity
                                            context.sources[call.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
                                        }
                                    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] unknown value-flow target '" -> print
                                    context -> emitFlowTargetName(call.sourceModule, nameStart, nameLength)
                                    "'" -> println
                                } else {
                                    "; sollang semantic error: unresolved call target '$name' (source $(call.sourceModule), byte $nameStart, length $nameLength)" -> println
                                }
                            }
                        }
                    }
                }
            }
        }
}

public emitCallDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    0 => callIndex!
    callIndex! < (context.calls -> len) -> while {
        context -> emitCallDiagnostic(callIndex!)
        callIndex! + 1 => callIndex!
    }
}

public nativeAbiFixedScalarSymbol symbol: Int, allowUnit: Bool -> Bool {
    symbol -> typeIds.canonicalBuiltinSymbol => canonical
    (allowUnit and canonical == 0) or canonical == 2 or canonical == 3
        or canonical == 4 or canonical == 6 or canonical == 8 or canonical == 9
        or canonical == 10 or canonical == 11 or canonical == 20 or canonical == 21
}

public nativeAbiStructTypeSafe context: ref emitterContext.EmitContext, typeId: Int, depth: Int -> Bool {
    false => safe!
    depth < 32 and typeId >= 0 and typeId < (context.types -> len)
        -> if {
            context.types[typeId] => structureType
            structureType.kind == 1 and (structureType.origin == 0 or structureType.origin == 2) and structureType.module >= 0 and structureType.module < (context.ranges -> len)
                -> if {
                    context.ranges[structureType.module] => structureRange
                    structureType.symbol >= 0 and structureType.symbol < structureRange.symbolCount
                        -> if {
                            context.symbols[structureRange.symbolStart + structureType.symbol] => structureSymbol
                            structureSymbol.kind == 3 and structureSymbol.flags / 256 % 2 == 1 and context.typeLayoutStatuses[typeId] == 0
                                -> if {
                                    true => safe!
                                    0 => fieldCount!
                                    0 => fieldIndex!
                                    fieldIndex! < (context.fields -> len) -> while {
                                        context.fields[fieldIndex!] => field
                                        field.status == 0 and field.ownerType == typeId
                                            -> if {
                                                fieldCount! + 1 => fieldCount!
                                                false => fieldSafe!
                                                field.fieldType >= 0 and field.fieldType < (context.types -> len)
                                                    -> if {
                                                        context.types[field.fieldType] => fieldType
                                                        fieldType.kind == 1 and fieldType.origin == 1
                                                            -> if {
                                                                fieldType.symbol -> nativeAbiFixedScalarSymbol(false) => fieldSafe!
                                                            } else {
                                                                context -> nativeAbiStructTypeSafe(field.fieldType, depth + 1) => fieldSafe!
                                                            }
                                                    }
                                                not fieldSafe! -> if { false => safe! }
                                            }
                                        fieldIndex! + 1 => fieldIndex!
                                    }
                                    fieldCount! == 0 -> if { false => safe! }
                                }
                        }
                }
        }
    safe!
}

public nativeAbiOpaqueHandleTypeSafe context: ref emitterContext.EmitContext, typeId: Int -> Bool {
    false => safe!
    typeId >= 0 and typeId < (context.types -> len)
        -> if {
            context.types[typeId] => handleType
            handleType.kind == 9
                and handleType.module >= 0
                and handleType.module < (context.ranges -> len)
                -> if {
                    context.ranges[handleType.module] => handleRange
                    handleType.symbol >= 0 and handleType.symbol < handleRange.symbolCount
                        -> if {
                            context.symbols[handleRange.symbolStart + handleType.symbol] => handleSymbol
                            handleSymbol.flags / 65536 % 2 == 1 -> if { true => safe! }
                        }
                }
        }
    safe!
}

public nativeHandleForgeryCount context: ref emitterContext.EmitContext -> Int {
    0 => count!
    0 => nodeIndex!
    nodeIndex! < (context.ir -> len) -> while {
        context.ir[nodeIndex!] => node
        node.kind == 12
            and node.typeId >= 0
            and node.typeId < (context.types -> len)
            and context.types[node.typeId].kind == 9
            and node.typeModule >= 0
            and node.typeModule < (context.ranges -> len)
            and node.typeSymbol >= 0 -> if {
                context.ranges[node.typeModule] => typeRange
                node.typeSymbol < typeRange.symbolCount -> if {
                    context.symbols[typeRange.symbolStart + node.typeSymbol] => typeSymbol
                    typeSymbol.flags / 65536 % 2 == 1 -> if { count! + 1 => count! }
                }
            }
        nodeIndex! + 1 => nodeIndex!
    }
    count!
}

public emitNativeHandleForgeryDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    0 => nodeIndex!
    nodeIndex! < (context.ir -> len) -> while {
        context.ir[nodeIndex!] => node
        node.kind == 12
            and node.typeId >= 0
            and node.typeId < (context.types -> len)
            and context.types[node.typeId].kind == 9
            and node.typeModule >= 0
            and node.typeModule < (context.ranges -> len)
            and node.typeSymbol >= 0 -> if {
                context.ranges[node.typeModule] => typeRange
                node.typeSymbol < typeRange.symbolCount -> if {
                    context.symbols[typeRange.symbolStart + node.typeSymbol] => typeSymbol
                    typeSymbol.flags / 65536 % 2 == 1 -> if {
                        context.tokens[typeRange.tokenStart + typeSymbol.nameToken] => nameToken
                        context.sources[node.typeModule] -> slice(nameToken.span.start, nameToken.span.length) => typeName
                        context.nodes[context.ranges[node.sourceModule].astStart + node.astNode] => literal
                        "; sollang semantic error: opaque handle '$typeName' can only be created by its native constructor (source $(node.sourceModule), byte $(literal.start), length $(literal.length))" -> println
                    }
                }
            }
        nodeIndex! + 1 => nodeIndex!
    }
}

public nativeAbiValueTypeSafe context: ref emitterContext.EmitContext, node: typedIr.TypedIrNode, allowUnit: Bool -> Bool {
    false => safe!
    node.typeId >= 0 and node.typeId < (context.types -> len)
        -> if {
            context.types[node.typeId] => nativeType
            nativeType.kind == 1 and nativeType.origin == 1
                -> if {
                    nativeType.symbol -> nativeAbiFixedScalarSymbol(allowUnit) => safe!
                } else {
                    context -> nativeAbiOpaqueHandleTypeSafe(node.typeId) => safe!
                    not safe! -> if { context -> nativeAbiStructTypeSafe(node.typeId, 0) => safe! }
                }
        } else {
            node.typeOrigin == 1 -> if {
                node.typeSymbol -> nativeAbiFixedScalarSymbol(allowUnit) => safe!
            }
        }
    safe!
}

public nativeAbiParameterSafe context: ref emitterContext.EmitContext, node: typedIr.TypedIrNode -> Bool {
    false => safe!
    node.flags % 2 == 0 -> if {
        node.flags / 2 % 2 == 1 -> if {
            context -> nativeAbiStructTypeSafe(node.typeId, 0) => safe!
        } else {
            node.typeId >= 0 and node.typeId < (context.types -> len) and context.types[node.typeId].kind == 8
                -> if {
                    context.types[node.typeId].first => borrowedTypeId
                    context -> nativeAbiOpaqueHandleTypeSafe(borrowedTypeId) => safe!
                    not safe! -> if { context -> nativeAbiStructTypeSafe(borrowedTypeId, 0) => safe! }
                } else {
                    context -> nativeAbiValueTypeSafe(node, false) => safe!
                }
        }
    }
    safe!
}

public nativeAbiResultSafe context: ref emitterContext.EmitContext, node: typedIr.TypedIrNode -> Bool {
    false => safe!
    node.typeId < 0 or node.typeId >= (context.types -> len) or context.types[node.typeId].kind != 8
        -> if {
            context -> nativeAbiValueTypeSafe(node, true) => safe!
        }
    safe!
}

public nativeAbiPhysicalResult context: ref emitterContext.EmitContext, node: typedIr.TypedIrNode -> typedIr.TypedIrNode {
    node => physical!
    node.flags / 32768 % 2 == 1
        and node.typeId >= 0
        and node.typeId < (context.types -> len) -> if {
            context.types[node.typeId] => resultType
            resultType.kind == 7
                and resultType.origin == 4
                and resultType.symbol == 1
                and resultType.first >= 0
                and resultType.first < (context.types -> len)
                -> if {
                    context.types[resultType.first] => successType
                    resultType.first => physical!.typeId
                    successType.kind => physical!.typeKind
                    successType.origin => physical!.typeOrigin
                    successType.module => physical!.typeModule
                    successType.symbol => physical!.typeSymbol
                }
        }
    physical!
}

isNativeLibraryFunction context: ref emitterContext.EmitContext, function: typedIr.TypedIrNode -> Bool {
    false => native!
    function.kind == 0
        and function.flags / 128 % 2 == 1
        and function.flags / 512 % 2 == 0
        and function.sourceModule >= 0
        and function.sourceModule < (context.ranges -> len)
        and function.symbol >= 0
        and function.symbol < context.ranges[function.sourceModule].symbolCount
        -> if {
            context.ranges[function.sourceModule] => sourceRange
            context.symbols[sourceRange.symbolStart + function.symbol] => functionSymbol
            functionSymbol.kind == 7
                and functionSymbol.astNode >= 0
                and functionSymbol.astNode < sourceRange.astCount
                and context.nodes[sourceRange.astStart + functionSymbol.astNode].cstRuleId == grammar.ruleIdNativeFunctionDeclaration()
                -> if { true => native! }
        }
    native!
}

public nativeAbiUnsafeTypeCount context: ref emitterContext.EmitContext -> Int {
    0 => count!
    0 => functionIndex!
    functionIndex! < (context.ir -> len) -> while {
        context.ir[functionIndex!] => function
        context -> isNativeLibraryFunction(function)
            -> if {
                context -> nativeAbiPhysicalResult(function) => physicalResult
                not (context -> nativeAbiResultSafe(physicalResult))
                    -> if { count! + 1 => count! }
                function.operand1 >= 0 -> if {
                    not (context -> nativeAbiParameterSafe(context.ir[function.operand1]))
                        -> if { count! + 1 => count! }
                }
                function.nextOperand => parameterIndex!
                parameterIndex! >= 0 -> while {
                    context.ir[parameterIndex!] => parameter
                    not (context -> nativeAbiParameterSafe(parameter))
                        -> if { count! + 1 => count! }
                    parameter.nextOperand => parameterIndex!
                }
            }
        functionIndex! + 1 => functionIndex!
    }
    count!
}

public writeNativeAbiTypeName typeSymbol: Int -> Unit uses Console {
    typeSymbol == 0 -> if { "Unit" -> print }
    typeSymbol == 1 -> if { "Text" -> print }
    typeSymbol == 2 -> if { "Int" -> print }
    typeSymbol == 3 -> if { "Int8" -> print }
    typeSymbol == 4 -> if { "Int16" -> print }
    typeSymbol == 5 -> if { "Int32" -> print }
    typeSymbol == 6 -> if { "Int64" -> print }
    typeSymbol == 7 -> if { "Long" -> print }
    typeSymbol == 8 -> if { "UInt8" -> print }
    typeSymbol == 9 -> if { "UInt16" -> print }
    typeSymbol == 10 -> if { "UInt32" -> print }
    typeSymbol == 11 -> if { "UInt64" -> print }
    typeSymbol == 12 -> if { "Size" -> print }
    typeSymbol == 13 -> if { "UIntSize" -> print }
    typeSymbol == 14 -> if { "CodePoint" -> print }
    typeSymbol == 19 -> if { "Float" -> print }
    typeSymbol == 20 -> if { "Float32" -> print }
    typeSymbol == 21 -> if { "Float64" -> print }
    typeSymbol == 22 -> if { "Double" -> print }
    typeSymbol == 23 -> if { "Bool" -> print }
    typeSymbol < 0 or typeSymbol > 23 -> if { "type#$typeSymbol" -> print }
}

writeNativeIntegerTypeBounds typeSymbol: Int, pointerBitWidth: Int -> Unit uses Console {
    typeSymbol == 2 or typeSymbol == 5 -> if { "-2147483648..2147483647" -> print }
    typeSymbol == 3 -> if { "-128..127" -> print }
    typeSymbol == 4 -> if { "-32768..32767" -> print }
    typeSymbol == 6 or typeSymbol == 7 -> if { "-9223372036854775808..9223372036854775807" -> print }
    typeSymbol == 8 -> if { "0..255" -> print }
    typeSymbol == 9 -> if { "0..65535" -> print }
    typeSymbol == 10 -> if { "0..4294967295" -> print }
    typeSymbol == 11 -> if { "0..18446744073709551615" -> print }
    typeSymbol == 12 and pointerBitWidth == 32 -> if { "-2147483648..2147483647" -> print }
    typeSymbol == 12 and pointerBitWidth == 64 -> if { "-9223372036854775808..9223372036854775807" -> print }
    typeSymbol == 13 and pointerBitWidth == 32 -> if { "0..4294967295" -> print }
    typeSymbol == 13 and pointerBitWidth == 64 -> if { "0..18446744073709551615" -> print }
    typeSymbol == 14 -> if { "0..1114111" -> print }
}

public emitNativeAbiTypeDiagnostic node: typedIr.TypedIrNode, role: Text -> Unit uses Console {
    "; sollang semantic error: native function " -> print
    role -> print
    " type '" -> print
    node.typeSymbol -> writeNativeAbiTypeName
    "' is not ABI-safe; use a fixed-width scalar type in the first native ABI slice" -> println
}

public emitNativeAbiDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    0 => functionIndex!
    functionIndex! < (context.ir -> len) -> while {
        context.ir[functionIndex!] => function
        context -> isNativeLibraryFunction(function)
            -> if {
                context -> nativeAbiPhysicalResult(function) => physicalResult
                not (context -> nativeAbiResultSafe(physicalResult))
                    -> if { physicalResult -> emitNativeAbiTypeDiagnostic("result") }
                function.operand1 >= 0 -> if {
                    context.ir[function.operand1] => primaryParameter
                    not (context -> nativeAbiParameterSafe(primaryParameter))
                        -> if { primaryParameter -> emitNativeAbiTypeDiagnostic("input") }
                }
                function.nextOperand => parameterIndex!
                parameterIndex! >= 0 -> while {
                    context.ir[parameterIndex!] => parameter
                    not (context -> nativeAbiParameterSafe(parameter))
                        -> if { parameter -> emitNativeAbiTypeDiagnostic("parameter") }
                    parameter.nextOperand => parameterIndex!
                }
            }
        functionIndex! + 1 => functionIndex!
    }
}

public nativeInteropFunctionCount context: ref emitterContext.EmitContext -> Int {
    0 => count!
    0 => functionIndex!
    functionIndex! < (context.ir -> len) -> while {
        context.ir[functionIndex!] => function
        context -> isNativeLibraryFunction(function)
            -> if { count! + 1 => count! }
        functionIndex! + 1 => functionIndex!
    }
    0 => libraryInterfaceIndex!
    libraryInterfaceIndex! < (context.libraries.interfaces -> len)
        -> while {
            count! + (context.libraries.interfaces[libraryInterfaceIndex!].exports -> len) => count!
            libraryInterfaceIndex! + 1 => libraryInterfaceIndex!
        }
    count!
}

public comInteropFunctionCount context: ref emitterContext.EmitContext -> Int {
    0 => count!
    0 => symbolIndex!
    symbolIndex! < (context.symbols -> len) -> while {
        context.symbols[symbolIndex!] => symbol
        (symbol.kind == 7 or symbol.kind == 36) and symbol.flags / 512 % 2 == 1
            -> if {
                count! + 1 => count!
            }
        symbolIndex! + 1 => symbolIndex!
    }
    count!
}

public emitWasmNativeInteropDiagnostic: -> Unit uses Console {
    "; sollang semantic error: native libraries are unavailable on wasm32-browser" -> println
}

public emitWasmConcurrentStreamJoinDiagnostic: -> Unit uses Console {
    "; sollang semantic error: merge/latest of EventStream<T> inputs are unavailable on the current target because bounded concurrent fan-in requires native worker wakeup and join support" -> println
}

public emitWasmParallelDiagnostic: -> Unit uses Console {
    "; sollang semantic error: parallel execution is unavailable on wasm32-browser because the target does not provide a compute worker pool" -> println
}

public emitComTargetDiagnostic target: Text -> Unit uses Console {
    "; sollang semantic error: COM declarations require target windows-x64; $target does not provide COM" -> println
}

mouseCapacityLiteralIndex context: ref emitterContext.EmitContext, argumentIndex: Int -> Int {
    argumentIndex < 0 or argumentIndex >= (context.ir -> len)
        -> if { -1 -> return }
    context.ir[argumentIndex] => argument
    argument.kind == 7 and argument.opcode == grammar.tokenIdMinus()
        -> if { argument.operand0 } else { argumentIndex }
}

public mouseEventLiteralCapacity context: ref emitterContext.EmitContext, callIndex: Int -> Int {
    callIndex < 0 or callIndex >= (context.ir -> len)
        -> if { -1 -> return }
    context.ir[callIndex] => call
    call.kind != 6 or call.targetModule < 0
        or call.targetModule >= (context.ranges -> len)
        or call.targetModule >= (context.modules -> len)
        -> if { -1 -> return }
    context.modules[call.targetModule] => ownerModule
    context.sources[ownerModule.sourceIndex] -> slice(ownerModule.pathStart, ownerModule.pathLength) => ownerPath
    ownerPath != "sys.input.mouse" -> if { -1 -> return }
    context.ranges[call.targetModule] => targetRange
    call.symbol < 0 or call.symbol >= targetRange.symbolCount
        -> if { -1 -> return }
    context.symbols[targetRange.symbolStart + call.symbol] => targetSymbol
    targetSymbol.kind != 7 or targetSymbol.parent >= 0 or targetSymbol.nameToken < 0
        -> if { -1 -> return }
    context.tokens[targetRange.tokenStart + targetSymbol.nameToken] => targetName
    (context.sources[call.targetModule] -> slice(targetName.span.start, targetName.span.length)) != "source"
        -> if { -1 -> return }
    context -> mouseCapacityLiteralIndex(call.operand0) => literalIndex
    literalIndex < 0 or literalIndex >= (context.ir -> len)
        -> if { -1 -> return }
    context.ir[literalIndex] => literal
    literal.kind != 3 or literal.payloadToken < 0
        -> if { -1 -> return }
    context.ranges[literal.sourceModule] => range
    context.tokens[range.tokenStart + literal.payloadToken] => token
    context.sources[literal.sourceModule] -> slice(token.span.start, token.span.length) => spelling
    spelling -> numericLiteralRange.literalUsesFloatingSyntax(0, spelling -> len)
        -> if { -1 -> return }
    0 => capacity!
    UIntSize(0) => cursor!
    cursor! < (spelling -> len) -> while {
        spelling -> byte(cursor!) => digit
        digit != 95 -> if {
            digit < 48 or digit > 57 -> if { -1 -> return }
            # Values above the permitted maximum need no unbounded accumulation.
            capacity! <= 65536 -> if { capacity! * 10 + Int(digit - 48) => capacity! }
        }
        cursor! + 1 => cursor!
    }
    # Zero also classifies every negative literal as below the permitted minimum.
    literalIndex != call.operand0 -> if { 0 } else { capacity! }
}

public invalidMouseEventCapacityCount context: ref emitterContext.EmitContext -> Int {
    0 => count!
    0 => callIndex!
    callIndex! < (context.ir -> len) -> while {
        context -> mouseEventLiteralCapacity(callIndex!) => capacity
        capacity >= 0 and (capacity < 2 or capacity > 65536)
            -> if { count! + 1 => count! }
        callIndex! + 1 => callIndex!
    }
    count!
}

mouseCapacityOverridesNumericLiteral context: ref emitterContext.EmitContext -> Int {
    context.numericCallLiteralDiagnostic => diagnostic
    diagnostic.code == 0 -> if { -1 -> return }
    0 => callIndex!
    callIndex! < (context.ir -> len) -> while {
        context -> mouseEventLiteralCapacity(callIndex!) => capacity
        capacity >= 0 and (capacity < 2 or capacity > 65536)
            -> if {
                context.ir[context.ir[callIndex!].operand0] => argument
                argument.sourceModule == diagnostic.sourceModule and argument.astNode == diagnostic.locationAst
                    -> if { callIndex! -> return }
            }
        callIndex! + 1 => callIndex!
    }
    -1
}

emitMouseEventCapacityDiagnostic context: ref emitterContext.EmitContext, callIndex: Int -> Unit uses Console {
    context.ir[callIndex].operand0 => argumentIndex
    context.ir[argumentIndex] => argument
    context.ranges[argument.sourceModule] => range
    context.nodes[range.astStart + argument.astNode] => argumentAst
    context -> emitInitializerSemanticPrefixAtOffset(argument.sourceModule, argument.astNode, argumentAst.start)
    "mouse event capacity must be between 2 and 65536 but received " -> print
    context -> mouseCapacityLiteralIndex(argumentIndex) => literalIndex
    literalIndex != argumentIndex -> if { "-" -> print }
    context.ir[literalIndex] => literal
    context.tokens[range.tokenStart + literal.payloadToken] => token
    UIntSize(0) => cursor!
    cursor! < token.span.length -> while {
        (context.sources[argument.sourceModule] -> byte(token.span.start + cursor!)) != 95
            -> if { context.sources[argument.sourceModule] -> slice(token.span.start + cursor!, 1) -> print }
        cursor! + 1 => cursor!
    }
    println()
}

public emitMouseEventDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    0 => callIndex!
    callIndex! < (context.ir -> len) -> while {
        context -> mouseEventLiteralCapacity(callIndex!) => capacity
        capacity >= 0 and (capacity < 2 or capacity > 65536)
            -> if {
                context -> emitMouseEventCapacityDiagnostic(callIndex!)
            }
        callIndex! + 1 => callIndex!
    }
}

importPathEquals context: ref emitterContext.EmitContext, edge: modules.ImportEdge, expected: Text -> Bool {
    edge.pathLength == (expected -> len) => equal!
    UIntSize(0) => index!
    equal! and index! < edge.pathLength -> while {
        (context.sources[edge.sourceModule] -> byte(edge.pathStart + index!)) != (expected -> byte(index!))
            -> if { false => equal! }
        index! + 1 => index!
    }
    equal!
}

isIntrinsicModuleImport context: ref emitterContext.EmitContext, edge: modules.ImportEdge -> Bool {
    false => intrinsic!
    context -> importPathEquals(edge, "sys.directory")
        -> if { true => intrinsic! }
    context -> importPathEquals(edge, "sys.input.mouse")
        -> if { true => intrinsic! }
    context -> importPathEquals(edge, "sys.file")
        -> if { true => intrinsic! }
    context -> importPathEquals(edge, "sys.io") -> if { true => intrinsic! }
    context -> importPathEquals(edge, "sys.path")
        -> if { true => intrinsic! }
    context -> importPathEquals(edge, "sys.process")
        -> if { true => intrinsic! }
    context -> importPathEquals(edge, "sys.random")
        -> if { true => intrinsic! }
    context -> importPathEquals(edge, "sys.runtime")
        -> if { true => intrinsic! }
    context -> importPathEquals(edge, "sys.text")
        -> if { true => intrinsic! }
    context -> importPathEquals(edge, "std.time")
        -> if { true => intrinsic! }
    intrinsic!
}

isBlockingModuleImport context: ref emitterContext.EmitContext, resolvedIndex: Int -> Bool {
    context.resolvedImports[resolvedIndex] => resolved
    resolved.status != 0 => blocking!
    blocking! and resolved.status == 1 -> if {
        context.imports[resolved.edge] => edge
        context -> isIntrinsicModuleImport(edge) -> if { false => blocking! }
    }
    blocking!
}

public moduleImportDiagnosticCount context: ref emitterContext.EmitContext -> Int {
    0 => count!
    0 => resolvedIndex!
    resolvedIndex! < (context.resolvedImports -> len)
        -> while {
            context -> isBlockingModuleImport(resolvedIndex!)
                -> if { count! + 1 => count! }
            resolvedIndex! + 1 => resolvedIndex!
        }
    count!
}

public emitModuleImportDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    0 => resolvedIndex!
    resolvedIndex! < (context.resolvedImports -> len)
        -> while {
            context.resolvedImports[resolvedIndex!] => resolved
            context -> isBlockingModuleImport(resolvedIndex!)
                -> if {
                    context.imports[resolved.edge] => edge
                    context.ranges[edge.sourceModule] => sourceRange
                    resolved.status == 1 -> if {
                        context.sources[edge.sourceModule] -> slice(edge.pathStart, edge.pathLength) => importPath
                        edge.sourceModule => sourceModule
                        edge.pathStart => pathStart
                        edge.pathLength => pathLength
                        "; sollang semantic error: unresolved import '$importPath' (source $sourceModule, byte $pathStart, length $pathLength)" -> println
                    } else {
                        context.tokens[sourceRange.tokenStart + edge.aliasToken] => aliasToken
                        context.sources[edge.sourceModule] -> slice(aliasToken.span.start, aliasToken.span.length) => alias
                        edge.sourceModule => sourceModule
                        aliasToken.span.start => aliasStart
                        aliasToken.span.length => aliasLength
                        "; sollang semantic error: duplicate import alias '$alias' (source $sourceModule, byte $aliasStart, length $aliasLength)" -> println
                    }
                }
            resolvedIndex! + 1 => resolvedIndex!
        }
}

public libraryImportDiagnosticCount context: ref emitterContext.EmitContext -> Int {
    # Read the nested scalar through a borrowed catalog place. This avoids
    # copying the owned arrays inside LibraryCatalog.
    readCatalogDiagnosticCount catalog: ref libraryImports.LibraryCatalog -> Int {
        catalog.diagnosticCount
    }
    context.libraries -> readCatalogDiagnosticCount => count!
    0 => libraryCallIndex!
    libraryCallIndex! < (context.libraryCalls -> len)
        -> while {
            context.libraryCalls[libraryCallIndex!].status != 0
                -> if { count! + 1 => count! }
            libraryCallIndex! + 1 => libraryCallIndex!
        }
    count! + (context.libraryCallDiagnostics -> len) => count!
    count!
}

emitLibraryBindingDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    0 => bindingIndex!
    bindingIndex! < (context.libraries.bindings -> len)
        -> while {
            context.libraries.bindings[bindingIndex!] => binding
            binding.status != 0 -> if {
                context.ranges[binding.sourceModule] => bindingRange
                context.tokens[bindingRange.tokenStart + binding.aliasToken] => aliasToken
                context.sources[binding.sourceModule] -> slice(aliasToken.span.start, aliasToken.span.length) => alias
                binding.status => bindingStatus
                binding.sourceModule => bindingSourceModule
                aliasToken.span.start => aliasStart
                "; sollang semantic error: library '$alias' interface validation failed with code $bindingStatus (source $bindingSourceModule, byte $aliasStart)" -> println
            }
            bindingIndex! + 1 => bindingIndex!
        }
}

public emitLibraryImportDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    context -> emitLibraryBindingDiagnostics
    0 => libraryCallIndex!
    libraryCallIndex! < (context.libraryCalls -> len)
        -> while {
            context.libraryCalls[libraryCallIndex!] => libraryCall
            libraryCall.status != 0 -> if {
                context.ranges[libraryCall.sourceModule] => callRange
                context.nodes[callRange.astStart + libraryCall.pathAst] => callPath
                libraryCall.sourceModule => libraryCallSourceModule
                callPath.start => callPathStart
                callPath.length => callPathLength
                "; sollang semantic error: unresolved library export (source $libraryCallSourceModule, byte $callPathStart, length $callPathLength)" -> println
            }
            libraryCallIndex! + 1 => libraryCallIndex!
        }
    0 => projectionDiagnosticIndex!
    projectionDiagnosticIndex! < (context.libraryCallDiagnostics -> len)
        -> while {
            context.libraryCallDiagnostics[projectionDiagnosticIndex!] => projection
            context.ranges[projection.sourceModule] => projectionRange
            context.nodes[projectionRange.astStart + projection.pathAst] => projectionPath
            projection.code => projectionCode
            projection.expected => projectionExpected
            projection.actual => projectionActual
            projection.sourceModule => projectionSourceModule
            projectionPath.start => projectionPathStart
            projectionPath.length => projectionPathLength
            "; sollang semantic error: invalid library call code $projectionCode, expected $projectionExpected, actual $projectionActual (source $projectionSourceModule, byte $projectionPathStart, length $projectionPathLength)" -> println
            projectionDiagnosticIndex! + 1 => projectionDiagnosticIndex!
        }
}

resultPropagationOwner propagationIndex: Int, context: ref emitterContext.EmitContext -> Int {
    context.ir[propagationIndex].parent => owner!
    owner! >= 0
        and owner! < (context.ir -> len)
        and context.ir[owner!].kind != 0
        and context.ir[owner!].kind != 11 -> while {
            context.ir[owner!].parent => owner!
        }
    owner!
}

resultPropagationHasResultOwner propagationIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    propagationIndex -> resultPropagationOwner(context) => owner
    owner >= 0 and owner < (context.ir -> len) and context.ir[owner].kind == 0 => hasFunctionOwner
    false => hasResultOwner!
    hasFunctionOwner -> if {
        context.ir[owner].typeId => ownerTypeId
        ownerTypeId >= 0 and ownerTypeId < (context.types -> len)
            -> if {
                context.types[ownerTypeId] => ownerType
                ownerType.kind == 7 and ownerType.first >= 0 and ownerType.second >= 0
                    -> if { true => hasResultOwner! }
            }
    }
    hasResultOwner!
}

resultPropagationErrorTypeMismatch propagationIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    context.ir[propagationIndex] => propagation
    propagation.kind != 30 or propagation.operand0 < 0 or propagation.operand0 >= (context.ir -> len)
        or propagation.sourceModule < 0 or propagation.sourceModule >= (context.ranges -> len)
        -> if { false -> return }
    context.ranges[propagation.sourceModule] => range
    propagation.astNode < 0 or propagation.astNode >= range.astCount
        -> if { false -> return }
    context.nodes[range.astStart + propagation.astNode].kind != 82
        or not (propagationIndex -> resultPropagationHasResultOwner(context))
        -> if { false -> return }
    context.types -> typeIds.materializedReadTypeId(context.ir[propagation.operand0].typeId) => operandTypeId
    operandTypeId < 0 or operandTypeId >= (context.types -> len)
        -> if { false -> return }
    context.types[operandTypeId] => operandType
    operandType.kind != 7 or operandType.origin != 4 or operandType.symbol != 1 or operandType.second < 0
        -> if { false -> return }
    propagationIndex -> resultPropagationOwner(context) => owner
    context.types[context.ir[owner].typeId] => ownerType
    operandType.second != ownerType.second
}

emitResultPropagationSemanticPrefix propagationIndex: Int, context: ref emitterContext.EmitContext -> Unit uses Console {
    context.ir[propagationIndex] => propagation
    context.ranges[propagation.sourceModule] => range
    context.nodes[range.astStart + propagation.astNode] => propagationAst
    context.tokens[range.tokenStart + propagationAst.payloadToken].span.start => offset
    context -> emitInitializerSemanticPrefixAtOffset(propagation.sourceModule, propagation.astNode, offset)
}

resultPropagationErrorTypeMismatchCount context: ref emitterContext.EmitContext -> Int {
    0 => count!
    0 => propagationIndex!
    propagationIndex! < (context.ir -> len) -> while {
        propagationIndex! -> resultPropagationErrorTypeMismatch(context)
            -> if { count! + 1 => count! }
        propagationIndex! + 1 => propagationIndex!
    }
    count!
}

emitResultPropagationErrorTypeDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    0 => propagationIndex!
    propagationIndex! < (context.ir -> len) -> while {
        propagationIndex! -> resultPropagationErrorTypeMismatch(context)
            -> if {
                context.ir[propagationIndex!] => propagation
                context.types -> typeIds.materializedReadTypeId(context.ir[propagation.operand0].typeId) => operandTypeId
                propagationIndex! -> resultPropagationOwner(context) => owner
                propagationIndex! -> emitResultPropagationSemanticPrefix(context)
                "'?' error type " -> print
                context.types[operandTypeId].second -> emitBoxOperandTypeName(context)
                " does not match function error type " -> print
                context.types[context.ir[owner].typeId].second -> emitBoxOperandTypeName(context)
                "" -> println
            }
        propagationIndex! + 1 => propagationIndex!
    }
}

public resultPropagationOutsideResultFunctionCount context: ref emitterContext.EmitContext -> Int {
    0 => count!
    0 => propagationIndex!
    propagationIndex! < (context.ir -> len) -> while {
        context.ir[propagationIndex!] => propagation
        propagation.kind == 30
            and propagation.sourceModule >= 0
            and propagation.sourceModule < (context.ranges -> len)
            and propagation.astNode >= 0
            and propagation.astNode < context.ranges[propagation.sourceModule].astCount
            and context.nodes[context.ranges[propagation.sourceModule].astStart + propagation.astNode].kind == 82
            and not (propagationIndex! -> resultPropagationHasResultOwner(context))
            -> if { count! + 1 => count! }
        propagationIndex! + 1 => propagationIndex!
    }
    count!
}

public emitResultPropagationOwnerDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    0 => propagationIndex!
    propagationIndex! < (context.ir -> len) -> while {
        context.ir[propagationIndex!] => propagation
        propagation.kind == 30
            and propagation.sourceModule >= 0
            and propagation.sourceModule < (context.ranges -> len)
            and propagation.astNode >= 0
            and propagation.astNode < context.ranges[propagation.sourceModule].astCount
            and context.nodes[context.ranges[propagation.sourceModule].astStart + propagation.astNode].kind == 82
            and not (propagationIndex! -> resultPropagationHasResultOwner(context))
            -> if {
                context.nodes[context.ranges[propagation.sourceModule].astStart + propagation.astNode] => propagationAst
                "; sollang semantic error: '?' can only be used inside a function returning Result<T, E>; in main, match the Result explicitly with '-> when' and handle Ok/Err (source $(propagation.sourceModule), byte $(propagationAst.start), length $(propagationAst.length))" -> println
            }
        propagationIndex! + 1 => propagationIndex!
    }
}

ownedResultPropagationUsesNamedPlace propagationIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    context.ir[propagationIndex] => propagation
    propagation.kind != 30 or propagation.operand0 < 0 or propagation.operand0 >= (context.ir -> len)
        -> if { false -> return }
    propagation.sourceModule < 0 or propagation.sourceModule >= (context.ranges -> len)
        or propagation.astNode < 0 or propagation.astNode >= context.ranges[propagation.sourceModule].astCount
        -> if { false -> return }
    context.nodes[context.ranges[propagation.sourceModule].astStart + propagation.astNode].kind != 82
        -> if { false -> return }
    context.ir[propagation.operand0] => source
    source.kind == 5 and source.typeId >= 0 and source.typeId < (context.types -> len)
        and context.types[source.typeId].kind == 8 -> if {
            propagationIndex -> resultPropagationErrorTypeMismatch(context)
                -> if { false -> return }
            context.types -> typeIds.materializedReadTypeId(source.typeId) => resultTypeId
            resultTypeId >= 0 and resultTypeId < (context.types -> len)
                and context.types[resultTypeId].kind == 7
                and context.types[resultTypeId].origin == 4
                and context.types[resultTypeId].symbol == 1
                and resultTypeId < (context.ownedStorageByType -> len)
                -> if { context.ownedStorageByType[resultTypeId] -> return }
            false -> return
        }
    source.kind != 5 or source.operand0 < 0 or source.operand0 >= (context.ir -> len)
        -> if { false -> return }
    context.ir[source.operand0] => sourceBinding
    (sourceBinding.kind != 17 and sourceBinding.kind != 29)
        or sourceBinding.typeId < 0 or sourceBinding.typeId >= (context.types -> len)
        or context.types[sourceBinding.typeId].kind != 7
        -> if { false -> return }
    context.types[sourceBinding.typeId] => resultType
    false => ownsPayload!
    resultType.first >= 0 and resultType.first < (context.typeTraits -> len)
        and (((context.typeTraits[resultType.first] / 2) % 2 == 1)
        or ((context.typeTraits[resultType.first] / 4) % 2 == 1))
        -> if { true => ownsPayload! }
    resultType.second >= 0 and resultType.second < (context.typeTraits -> len)
        and (((context.typeTraits[resultType.second] / 2) % 2 == 1)
        or ((context.typeTraits[resultType.second] / 4) % 2 == 1))
        -> if { true => ownsPayload! }
    ownsPayload!
}

public ownedResultPropagationNamedPlaceCount context: ref emitterContext.EmitContext -> Int {
    0 => count!
    0 => propagationIndex!
    propagationIndex! < (context.ir -> len) -> while {
        propagationIndex! -> ownedResultPropagationUsesNamedPlace(context)
            -> if { count! + 1 => count! }
        propagationIndex! + 1 => propagationIndex!
    }
    count!
}

public emitOwnedResultPropagationNamedPlaceDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    0 => propagationIndex!
    propagationIndex! < (context.ir -> len) -> while {
        propagationIndex! -> ownedResultPropagationUsesNamedPlace(context)
            -> if {
                context.ir[propagationIndex!] => propagation
                propagationIndex! -> emitResultPropagationSemanticPrefix(context)
                "owned Result '?' must consume a temporary Result or the function's explicit move input" -> println
            }
        propagationIndex! + 1 => propagationIndex!
    }
}

public returnOutsideFunctionCount context: ref emitterContext.EmitContext -> Int {
    0 => count!
    0 => returnIndex!
    returnIndex! < (context.ir -> len) -> while {
        context.ir[returnIndex!] => candidate
        candidate.kind == 23 -> if {
            returnIndex! => owner!
            owner! >= 0
                and owner! < (context.ir -> len)
                and context.ir[owner!].kind != 0
                and context.ir[owner!].kind != 11 -> while {
                    context.ir[owner!].parent => owner!
                }
            owner! >= 0
                and owner! < (context.ir -> len)
                and context.ir[owner!].kind == 11
                -> if { count! + 1 => count! } else {
                    candidate.sourceModule >= 0 and candidate.sourceModule < (context.ranges -> len)
                        -> if {
                            context.nodes -> semanticDiagnostics.returnFromAsyncFunction(context.ranges[candidate.sourceModule], candidate.astNode)
                                -> if { count! + 1 => count! }
                        }
                }
        }
        returnIndex! + 1 => returnIndex!
    }
    count!
}

public emitReturnOutsideFunctionDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    0 => returnIndex!
    returnIndex! < (context.ir -> len) -> while {
        context.ir[returnIndex!] => candidate
        candidate.kind == 23 -> if {
            returnIndex! => owner!
            owner! >= 0
                and owner! < (context.ir -> len)
                and context.ir[owner!].kind != 0
                and context.ir[owner!].kind != 11 -> while {
                    context.ir[owner!].parent => owner!
                }
            owner! >= 0
                and owner! < (context.ir -> len)
                and context.ir[owner!].kind == 11
                and candidate.sourceModule >= 0
                and candidate.sourceModule < (context.ranges -> len)
                -> if {
                    context.ranges[candidate.sourceModule] => sourceRange
                    candidate.astNode >= 0 and candidate.astNode < sourceRange.astCount
                        -> if {
                            context.nodes[sourceRange.astStart + candidate.astNode] => returnAst
                            candidate.sourceModule => sourceModule
                            "; sollang semantic error: 'return' is only valid inside a value or Unit function (source $sourceModule, byte $(returnAst.start), length $(returnAst.length))" -> println
                        }
                } else {
                    candidate.sourceModule >= 0 and candidate.sourceModule < (context.ranges -> len)
                        -> if {
                            context.ranges[candidate.sourceModule] => range
                            context.nodes -> semanticDiagnostics.returnFromAsyncFunction(range, candidate.astNode)
                                -> if {
                                    context.nodes[range.astStart + candidate.astNode] => statement
                                    statement.payloadToken >= 0 and statement.payloadToken < range.tokenCount
                                        -> if {
                                            context.tokens[range.tokenStart + statement.payloadToken].span.start => offset
                                            context -> emitInitializerSemanticPrefixAtOffset(candidate.sourceModule, candidate.astNode, offset)
                                            "explicit return in an async function is not supported in the first runtime slice" -> println
                                        }
                                }
                        }
                }
        }
        returnIndex! + 1 => returnIndex!
    }
}

emitBoxOperandTypeName typeId: Int, context: ref emitterContext.EmitContext -> Unit uses Console {
    context.types[typeId] => semanticType
    semanticType.kind == 1 -> if {
        semanticType.origin == 1 -> if {
            semanticType.symbol -> typeIds.builtinTypeName -> print
            return
        }
        context.modules[semanticType.module] => typeModule
        typeModule.pathLength > 0 -> if {
            context.sources[semanticType.module] -> slice(typeModule.pathStart, typeModule.pathLength) -> print
            "." -> print
        }
        context.ranges[semanticType.module] => typeRange
        context.symbols[typeRange.symbolStart + semanticType.symbol] => typeSymbol
        context.tokens[typeRange.tokenStart + typeSymbol.nameToken] => nameToken
        context.sources[semanticType.module] -> slice(nameToken.span.start, nameToken.span.length) -> print
        return
    }
    semanticType.kind == 2 -> if {
        "[" -> print
        semanticType.first -> emitBoxOperandTypeName(context)
        "]" -> print
        return
    }
    semanticType.kind == 3 -> if {
        "[" -> print
        semanticType.first -> emitBoxOperandTypeName(context)
        "; ~]" -> print
        return
    }
    semanticType.kind == 4 -> if {
        "[" -> print
        semanticType.first -> emitBoxOperandTypeName(context)
        semanticType.length >= 0 -> if {
            "; $(semanticType.length)]" -> print
        } else { "; N]" -> print }
        return
    }
    semanticType.kind == 5 -> if {
        "{" -> print
        semanticType.first -> emitBoxOperandTypeName(context)
        ": " -> print
        semanticType.second -> emitBoxOperandTypeName(context)
        "}" -> print
        return
    }
    semanticType.kind == 6 -> if {
        "box " -> print
        semanticType.first -> emitBoxOperandTypeName(context)
        return
    }
    semanticType.kind == 7 and semanticType.origin == 4
        -> if {
            semanticType.symbol -> typeIds.intrinsicGenericName -> print
            "<" -> print
            semanticType.first -> emitBoxOperandTypeName(context)
            semanticType.symbol == 1 -> if {
                ", " -> print
                semanticType.second -> emitBoxOperandTypeName(context)
            }
            ">" -> print
            return
        }
    semanticType.kind == 8 -> if {
        "ref " -> print
        semanticType.first -> emitBoxOperandTypeName(context)
        return
    }
    semanticType.kind == 10 -> if {
        "(" -> print
        0 => ordinal!
        ordinal! < semanticType.length -> while {
            ordinal! > 0 -> if { ", " -> print }
            -1 => fieldIndex!
            0 => fieldSearch!
            fieldSearch! < (context.fields -> len) and fieldIndex! < 0
                -> while {
                    context.fields[fieldSearch!] => field
                    field.ownerType == typeId and field.ordinal == ordinal!
                        -> if { fieldSearch! => fieldIndex! }
                    fieldSearch! + 1 => fieldSearch!
                }
            fieldIndex! >= 0 -> if {
                context.fields[fieldIndex!] => field
                field.labelToken >= 0 -> if {
                    context.ranges[field.sourceModule] => fieldRange
                    context.tokens[fieldRange.tokenStart + field.labelToken] => label
                    context.sources[field.sourceModule] -> slice(label.span.start, label.span.length) -> print
                    ": " -> print
                }
                field.fieldType -> emitBoxOperandTypeName(context)
            } else { "<unresolved product field>" -> print }
            ordinal! + 1 => ordinal!
        }
        ")" -> print
        return
    }
    semanticType.kind == 12 -> if {
        "[" -> print
        semanticType.first -> emitBoxOperandTypeName(context)
        "; <=$(semanticType.length)]" -> print
        return
    }
    semanticType.kind == 13 -> if {
        "{" -> print
        semanticType.first -> emitBoxOperandTypeName(context)
        ": " -> print
        semanticType.second -> emitBoxOperandTypeName(context)
        "; <=$(semanticType.length)}" -> print
        return
    }
    semanticType.kind == 14 -> if {
        "BitSet<$(semanticType.length)>" -> print
        return
    }
    "<semantic type $(semanticType.kind)>" -> print
}

numericCallLiteralOverridesUnary context: ref emitterContext.EmitContext -> Bool {
    context.numericCallLiteralDiagnostic.code > 0
        and context.numericCallLiteralDiagnostic.negative
        and context.expressionOperandDiagnostic.code == 4
        and context.numericCallLiteralDiagnostic.sourceModule == context.expressionOperandDiagnostic.sourceModule
        and context.numericCallLiteralDiagnostic.locationAst == context.expressionOperandDiagnostic.astNode
}

expressionOperandDiagnosticCount context: ref emitterContext.EmitContext -> Int {
    context -> numericCallLiteralOverridesUnary -> if { 0 -> return }
    context.expressionOperandDiagnostic.code > 0 -> if { 1 } else { 0 }
}

numericCallLiteralDiagnosticCount context: ref emitterContext.EmitContext -> Int {
    context.numericCallLiteralDiagnostic.code > 0
        -> if { 1 } else { 0 }
}

emitTextIntrinsicArityDiagnostic opcode: Int -> Unit uses Console {
    opcode == -202 -> if { "Text byte expects one UIntSize index" -> println }
    opcode == -203 -> if { "Text slice expects UIntSize start and byte length" -> println }
}

emitTextIntrinsicIndexDiagnostic opcode: Int -> Unit uses Console {
    opcode == -202 -> if { "Text byte index must be UIntSize" -> println }
    opcode == -203 -> if { "Text slice start and length must be UIntSize" -> println }
}

emitNumericCallLiteralDiagnostic context: ref emitterContext.EmitContext -> Unit uses Console {
    context -> emitNumericLiteralDiagnostic(context.numericCallLiteralDiagnostic)
}

emitNumericLiteralDiagnostic context: ref emitterContext.EmitContext, diagnostic: semanticDiagnostics.NumericCallLiteralDiagnostic -> Unit uses Console {
    diagnostic.code == 0 -> if { return }
    context.ranges[diagnostic.sourceModule] => sourceRange
    context.nodes[sourceRange.astStart + diagnostic.locationAst] => locationNode
    context.nodes[sourceRange.astStart + diagnostic.literalAst] => literalNode
    context.constantLiterals -> constantLowering.findDiagnosticStart(sourceRange.literalStart, sourceRange.literalCount, diagnostic.literalAst) -> when {
        Some(start) { start }
        None { locationNode.start }
    } => locationStart
    context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(locationStart) => location
    "<main>" => moduleName!
    context.nodes -> semanticDiagnostics.expressionBelongsToMain(sourceRange, diagnostic.locationAst) => inMain
    not inMain and context.modules[diagnostic.sourceModule].pathLength > 0
        -> if {
            context.modules[diagnostic.sourceModule] => identity
            context.sources[diagnostic.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
        }
    diagnostic.expectedSymbol -> typeIds.builtinTypeName => targetName
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] numeric literal " -> print
    context.constantLiterals -> constantLowering.find(sourceRange.literalStart, sourceRange.literalCount, diagnostic.literalAst) -> when {
        Some(folded) {
            folded < 0 -> if {
                not diagnostic.negative -> if { "-" -> print }
                # Avoid negating Long.min while printing its unsigned magnitude.
                UInt64(-(folded + 1)) + 1 -> print
            } else {
                diagnostic.negative -> if { "-" -> print }
                folded -> print
            }
        }
        None {
            diagnostic.negative -> if { "-" -> print }
            (context.sources[diagnostic.sourceModule] -> byte(literalNode.start)) == 39
                -> if {
                    syntax.SourceSpan { fileId: diagnostic.sourceModule, start: literalNode.start, length: literalNode.length } => characterSpan
                    context.sources[diagnostic.sourceModule] -> syntax.decodeCharacterLiteral(characterSpan) -> when {
                        Some(value) { "$value" -> print }
                        None { context.sources[diagnostic.sourceModule] -> slice(literalNode.start, literalNode.length) -> print }
                    }
                } else {
                    context.sources[diagnostic.sourceModule] -> slice(literalNode.start, literalNode.length) -> print
                }
        }
    }
    diagnostic.code == 3 -> if {
        " is not an integer for $targetName" -> println
        return
    }
    diagnostic.code == 2 -> if {
        " is a Unicode surrogate and cannot be a CodePoint" -> println
        return
    }

    diagnostic.expectedSymbol -> numericLiteralRange.minimumText(context.pointerBitWidth) => minimum
    diagnostic.expectedSymbol -> numericLiteralRange.maximumText(context.pointerBitWidth) => maximum
    " is out of range for $targetName ($minimum..$maximum)" -> println
}

numericCallArgumentDiagnosticCount context: ref emitterContext.EmitContext -> Int {
    context.numericCallLiteralDiagnostic.code > 0
        -> if { 0 -> return }
    context.numericCallArgumentDiagnostic.code > 0
        -> if { 1 } else { 0 }
}

emitNumericCallArgumentDiagnostic context: ref emitterContext.EmitContext -> Unit uses Console {
    context.numericCallLiteralDiagnostic.code > 0
        -> if { return }
    context.numericCallArgumentDiagnostic => diagnostic
    diagnostic.code == 0 -> if { return }
    diagnostic.code == 6 or diagnostic.code == 7 -> if {
        context.ranges[diagnostic.sourceModule] => range
        context.nodes[range.astStart + diagnostic.argumentAst] => argument
        context -> emitInitializerSemanticPrefixAtOffset(diagnostic.sourceModule, diagnostic.argumentAst, argument.start)
        diagnostic.code == 6 -> if {
            "writeAtAsync expects a scalar value and one UInt64 byte offset" -> println
        } else {
            "writeAtAsync supports Bool, CodePoint, and numeric scalars; got " -> print
            diagnostic.actualTypeId -> emitBoxOperandTypeName(context)
            println()
        }
        return
    }
    diagnostic.code == 3 or diagnostic.code == 4 -> if {
        context.ranges[diagnostic.sourceModule] => range
        context.nodes[range.astStart + diagnostic.argumentAst] => argument
        context -> emitInitializerSemanticPrefixAtOffset(diagnostic.sourceModule, diagnostic.argumentAst, argument.start)
        diagnostic.code == 3 -> if { "file scalar value must be " -> print } else { "file offset must be " -> print }
        diagnostic.expectedTypeId -> emitBoxOperandTypeName(context)
        " or an integer literal" -> println
        return
    }
    context.ranges[diagnostic.targetSourceModule] => functionRange
    context.symbols[functionRange.symbolStart + diagnostic.functionSymbol] => functionSymbol
    context.symbols[functionRange.symbolStart + diagnostic.parameterSymbol] => parameterSymbol
    context.tokens[functionRange.tokenStart + functionSymbol.nameToken] => functionToken
    context.tokens[functionRange.tokenStart + parameterSymbol.nameToken] => parameterToken
    context.sources[diagnostic.targetSourceModule] => declarationSource
    declarationSource -> slice(functionToken.span.start, functionToken.span.length) => functionName!
    declarationSource -> slice(parameterToken.span.start, parameterToken.span.length) => parameterName
    context.ranges[diagnostic.sourceModule] => sourceRange
    context.nodes[sourceRange.astStart + diagnostic.argumentAst] => argument
    context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(argument.start) => location
    "<main>" => moduleName!
    context.modules[diagnostic.sourceModule].pathLength > 0
        -> if {
            context.modules[diagnostic.sourceModule] => identity
            context.sources[diagnostic.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
        }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] " -> print
    diagnostic.code == 5 -> if {
        "expected a boxed value but received " -> print
        diagnostic.actualTypeId -> emitBoxOperandTypeName(context)
        println() -> return
    }
    diagnostic.code == 2 -> if {
        context.symbols[functionRange.symbolStart + diagnostic.genericParameterSymbol] => genericSymbol
        context.tokens[functionRange.tokenStart + genericSymbol.nameToken] => genericToken
        declarationSource -> slice(genericToken.span.start, genericToken.span.length) => genericName
        "type parameter '$genericName' was inferred as both " -> print
        diagnostic.expectedTypeId -> emitBoxOperandTypeName(context)
        " and " -> print
        diagnostic.actualTypeId -> emitBoxOperandTypeName(context)
        println() -> return
    }
    diagnostic.parameterOrdinal == 0 and diagnostic.callAst >= 0
        -> if {
            0 => calleeAst!
            calleeAst! < sourceRange.astCount -> while {
                context.nodes[sourceRange.astStart + calleeAst!] => callee
                callee.parent == diagnostic.callAst and callee.kind == 16
                    -> if {
                        context.sources[diagnostic.sourceModule] -> slice(callee.start, callee.length) => functionName!
                    }
                calleeAst! + 1 => calleeAst!
            }
        }
    -1 => directPathAst!
    diagnostic.callAst >= 0 and context.nodes[sourceRange.astStart + diagnostic.callAst].kind == 11
        -> if {
            0 => childAst!
            childAst! < sourceRange.astCount -> while {
                context.nodes[sourceRange.astStart + childAst!] => child
                child.parent == diagnostic.callAst and child.kind == 16
                    -> if { childAst! => directPathAst! }
                childAst! + 1 => childAst!
            }
        }
    diagnostic.code != 8 -> if { "function '" -> print }
    directPathAst! >= 0 -> if {
        calls.ModuleCallResolution {
            sourceModule: diagnostic.sourceModule, callAst: diagnostic.callAst,
            origin: 0, targetModule: diagnostic.targetSourceModule,
            targetSourceModule: diagnostic.targetSourceModule,
            functionSymbol: diagnostic.functionSymbol, status: 0
        } => call
        context -> emitSemanticCallPathName(call, directPathAst!, false)
    } else {
        diagnostic.parameterOrdinal == 0 and diagnostic.callAst >= 0
            and not modules.sameLogicalSource(context.sources, context.modules, diagnostic.sourceModule, diagnostic.targetSourceModule, context.tokens, context.ranges)
            and context.modules[diagnostic.targetSourceModule].pathLength > 0
            -> if {
                context.modules[diagnostic.targetSourceModule] => targetIdentity
                declarationSource -> slice(targetIdentity.pathStart, targetIdentity.pathLength) -> print
                "." -> print
                declarationSource -> slice(functionToken.span.start, functionToken.span.length) -> print
            } else { functionName! -> print }
    }
    diagnostic.code == 8 -> if { " " -> print } else { "' " -> print }
    diagnostic.parameterOrdinal > 0 -> if { "parameter '$parameterName' " -> print }
    "expects " -> print
    diagnostic.expectedTypeId -> emitBoxOperandTypeName(context)
    " but received " -> print
    diagnostic.actualTypeId -> emitBoxOperandTypeName(context)
    println()
}

emitMemberFieldCollision context: ref emitterContext.EmitContext -> Unit uses Console {
    context.memberFieldCollision => collision
    collision.sourceModule < 0 -> if { return }
    context.ranges[collision.sourceModule] => sourceRange
    context.symbols[sourceRange.symbolStart + collision.functionSymbol] => declaration
    context.tokens[sourceRange.tokenStart + declaration.nameToken] => nameToken
    context.sources[collision.sourceModule] -> syntaxDiagnostics.sourceLocation(nameToken.span.start) => location
    context.sources[collision.sourceModule] -> slice(nameToken.span.start, nameToken.span.length) => memberName
    "<main>" => moduleName!
    context.modules[collision.sourceModule].pathLength > 0
        -> if {
            context.modules[collision.sourceModule] => identity
            context.sources[collision.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
        }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] member '" -> print
    collision.ownerType -> emitBoxOperandTypeName(context)
    ".$memberName' conflicts with a stored field of the same name" -> println
}

emitExpressionSemanticPrefix context: ref emitterContext.EmitContext, diagnostic: semanticDiagnostics.ExpressionOperandDiagnostic, location: syntaxDiagnostics.SourceLocation -> Unit uses Console {
    "<main>" => moduleName!
    context.ranges[diagnostic.sourceModule] => sourceRange
    context.nodes -> semanticDiagnostics.expressionBelongsToMain(sourceRange, diagnostic.astNode)
        => inMain
    not inMain and context.modules[diagnostic.sourceModule].pathLength > 0
        -> if {
            context.modules[diagnostic.sourceModule] => identity
            context.sources[diagnostic.sourceModule] -> slice(identity.pathStart, identity.pathLength)
                => moduleName!
        }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] " -> print
}

emitExpressionOperandDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    context -> numericCallLiteralOverridesUnary -> if { return }
    context.expressionOperandDiagnostic => diagnostic
    diagnostic.code == 73 -> if {
        context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
        context -> emitExpressionSemanticPrefix(diagnostic, location)
        diagnostic.operatorKind == 2 -> if {
            "owned heap containers must be bound directly so the compiler can prove and insert their drop" -> println
        } else {
            diagnostic.operatorKind == 3 -> if {
                "await is only valid in async functions or main" -> println
            } else { "await does not accept arguments" -> println }
        }
        return
    }
    diagnostic.code == 72 -> if {
        context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
        context -> emitExpressionSemanticPrefix(diagnostic, location)
        "enum pattern matching expects an enum subject" -> println
        return
    }
    diagnostic.code == 71 -> if {
        context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
        context -> emitExpressionSemanticPrefix(diagnostic, location)
        diagnostic.operatorKind -> binaryArithmeticOperatorName => operatorName
        diagnostic.operandTypeSymbol == 1 -> if {
            "CodePoint does not support '$operatorName'; convert it to UInt32 before arithmetic" -> println
        } else {
            "left operand of '$operatorName' must be a compatible numeric value" -> println
        }
        return
    }
    diagnostic.code == 70 -> if {
        context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
        context -> emitExpressionSemanticPrefix(diagnostic, location)
        "fold expects a range or Int array input" -> println
        return
    }
    diagnostic.code >= 60 and diagnostic.code <= 67
        -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
            context -> emitExpressionSemanticPrefix(diagnostic, location)
            diagnostic.operatorKind -> when {
                == 1 { "alloc" }
                == 2 { "used" }
                == 3 { "store" }
                == 4 { "load" }
                else { "reset" }
            } => operation
            diagnostic.code == 60 -> if {
                diagnostic.operatorKind -> when {
                    == 1 { "arena alloc must be final and expects byte-count and alignment arguments" -> println }
                    == 2 { "used does not accept arguments" -> println }
                    == 3 { "arena store must be final and expects offset and UInt8 value arguments" -> println }
                    == 4 { "arena load expects one UIntSize offset" -> println }
                    else { "arena reset must be final and takes no arguments" -> println }
                }
            }
            diagnostic.code == 61 -> if {
                context.ranges[diagnostic.sourceModule] => range
                context.nodes[range.astStart + diagnostic.operandAst] => owner
                context.tokens[range.tokenStart + owner.payloadToken] => token
                context.sources[diagnostic.sourceModule] -> slice(token.span.start, token.span.length) => ownerName
                ownerName -> len => nameLength!
                nameLength! > 0 and (ownerName -> byte(nameLength! - 1)) == 33
                    -> if { nameLength! - 1 => nameLength! }
                ownerName -> slice(UIntSize(0), nameLength!) => name
                "$operation requires writable owner storage; change a readonly parameter from '$name: Type' to '$name: mut Type', declare an instance receiver as 'mut self', or bind local owned storage with '=> $name!'" -> println
            }
            diagnostic.code == 62 -> if { "$operation requires a named mutable container binding" -> println }
            diagnostic.code == 63 -> if { "arena alloc byte-count and alignment must be Int or UIntSize" -> println }
            diagnostic.code == 64 -> if { "arena alignment must be a nonzero power of two" -> println }
            diagnostic.code == 65 -> if { "arena store expects UIntSize offset and UInt8 value" -> println }
            diagnostic.code == 66 -> if { "arena load offset must be UIntSize" -> println }
            diagnostic.code == 67 -> if { "unknown value-flow target '$operation'" -> println }
            return
        }
    diagnostic.code == 68 or diagnostic.code == 69
        -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
            context -> emitExpressionSemanticPrefix(diagnostic, location)
            diagnostic.code == 68 -> if {
                diagnostic.operatorKind -> emitTextIntrinsicArityDiagnostic
            } else {
                diagnostic.operatorKind -> emitTextIntrinsicIndexDiagnostic
            }
            return
        }
    diagnostic.code == 73 -> if {
        context.ranges[diagnostic.sourceModule] => range
        context.nodes[range.astStart + diagnostic.astNode] => function
        context.modules[diagnostic.sourceModule] => identity
        context.sources[diagnostic.sourceModule] => source
        [UInt8; ~] => bytes!
        source -> semanticDiagnostics.appendFunctionDeclarationName(context.tokens, range.tokenStart, range.tokenCount, identity.pathStart, identity.pathLength, function.payloadToken, bytes!)
        bytes! -> file.borrowBytes => nameView
        nameView -> slice(UIntSize(0), nameView -> len) => name
        source -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
        context -> emitExpressionSemanticPrefix(diagnostic, location)
        "function '$name' already exists" -> println
        return
    }
    diagnostic.code == 49 -> if {
        context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
        context -> emitExpressionSemanticPrefix(diagnostic, location)
        "the sys namespace is reserved for the standard library" -> println
        return
    }
    diagnostic.code == 46 -> if {
        context.ranges[diagnostic.sourceModule] => range
        context.nodes[range.astStart + diagnostic.astNode] => function
        context.tokens[range.tokenStart + function.payloadToken] => token
        context.sources[diagnostic.sourceModule] -> slice(token.span.start, token.span.length) => name
        context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
        context -> emitExpressionSemanticPrefix(diagnostic, location)
        "function name '$name' is reserved" -> println
        return
    }
    diagnostic.code == 44 or diagnostic.code == 45
        -> if {
            context.ranges[diagnostic.sourceModule] => range
            context.nodes[range.astStart + diagnostic.operandAst] => reference
            context.sources[diagnostic.sourceModule] -> slice(reference.start, reference.length) => name
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
            context -> emitExpressionSemanticPrefix(diagnostic, location)
            diagnostic.code == 44 -> if {
                "unknown effect '$name'; supported effects: Clock, Console, Environment, File, Network, Process, Random" -> println
            } else {
                "effect '$name' is declared more than once" -> println
            }
            return
        }
    diagnostic.code == 41 or diagnostic.code == 42
        -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
            context -> emitExpressionSemanticPrefix(diagnostic, location)
            context.types[diagnostic.firstTypeId].length => expectedLength
            context.ranges[diagnostic.sourceModule] => range
            typeIds.arrayStorageSyntaxFromTokens(context.sources[diagnostic.sourceModule], context.tokens, range.tokenStart, context.nodes[range.astStart + diagnostic.operandAst]) => storage
            diagnostic.code == 41 -> if { "fixed array expects $expectedLength" -> print } else {
                "bounded array capacity is $expectedLength, got $(diagnostic.operandTypeSymbol)" -> print
            }
            storage.isRepeat -> if { " repeated elements" -> print } else { " elements" -> print }
            diagnostic.code == 41 -> if { ", got $(diagnostic.operandTypeSymbol)" -> print }
            println()
            return
        }
    diagnostic.code == 43 -> if {
        context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
        context -> emitExpressionSemanticPrefix(diagnostic, location)
        "array elements must have one type; expected " -> print
        diagnostic.firstTypeId -> emitBoxOperandTypeName(context)
        ", got " -> print
        diagnostic.operandTypeSymbol -> emitBoxOperandTypeName(context)
        println()
        return
    }
    diagnostic.code == 40 -> if {
        context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
        context -> emitExpressionSemanticPrefix(diagnostic, location)
        diagnostic.operandTypeSymbol -> binaryArithmeticOperatorName => operatorName
        "operands of '$operatorName' must have type " -> print
        diagnostic.firstTypeId -> emitBoxOperandTypeName(context)
        " in this context" -> println
        return
    }
    diagnostic.code == 39 -> if {
        context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
        context -> emitExpressionSemanticPrefix(diagnostic, location)
        context.fields[diagnostic.operatorKind] => field
        context.ranges[field.sourceModule] => fieldRange
        context.symbols[fieldRange.symbolStart + field.fieldSymbol] => declaration
        context.tokens[fieldRange.tokenStart + declaration.nameToken] => fieldToken
        context.sources[field.sourceModule] -> slice(fieldToken.span.start, fieldToken.span.length) => fieldName
        context.modules[field.sourceModule] => ownerModule
        context.sources[field.sourceModule] -> slice(ownerModule.pathStart, ownerModule.pathLength) => moduleName
        "cannot construct struct '" -> print
        diagnostic.operandTypeId -> emitBoxOperandTypeName(context)
        "' outside module '$moduleName' because field '$fieldName' is private; use its public factory or public instance methods" -> println
        return
    }
    diagnostic.code == 38 -> if {
        context.ranges[diagnostic.sourceModule] => range
        context.nodes[range.astStart + diagnostic.operandAst] => literal
        diagnostic.operandAst => locationAst!
        false => negative!
        literal.parent >= 0 -> if {
            context.nodes[range.astStart + literal.parent] => parent
            parent.kind == 22 and parent.operatorKind == grammar.tokenIdMinus()
                -> if {
                    literal.parent => locationAst!
                    true => negative!
                }
        }
        semanticDiagnostics.NumericCallLiteralDiagnostic {
            code: diagnostic.operandTypeSymbol, sourceModule: diagnostic.sourceModule,
            locationAst: locationAst!, literalAst: diagnostic.operandAst,
            expectedSymbol: context.types[diagnostic.firstTypeId].symbol,
            negative: negative!
        } => numeric
        context -> emitNumericLiteralDiagnostic(numeric)
        return
    }
    diagnostic.code > 0 -> if {
        diagnostic.code >= 33 and diagnostic.code <= 37
            -> if {
                context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
                context -> emitExpressionSemanticPrefix(diagnostic, location)
                diagnostic.code == 33 -> if {
                    "contextual " -> print
                    diagnostic.operandTypeId -> emitBoxOperandTypeName(context)
                    " literal field name must be an identifier" -> println
                    return
                }
                context.ranges[diagnostic.sourceModule] => range
                context.nodes[range.astStart + diagnostic.operandAst] => label
                diagnostic.code == 34 or diagnostic.code == 37
                    -> if {
                        context.tokens[range.tokenStart + label.payloadToken] => token
                        context.sources[diagnostic.sourceModule] -> slice(token.span.start, token.span.length) => name
                        diagnostic.code == 34 -> if {
                            "field '$name' is initialized more than once" -> println
                        } else {
                            "struct '" -> print
                            diagnostic.operandTypeId -> emitBoxOperandTypeName(context)
                            "' has no field '$name'" -> println
                        }
                        return
                    }
                context.fields[diagnostic.operatorKind] => field
                context.ranges[field.sourceModule] => fieldRange
                field.labelToken => fieldToken!
                field.fieldSymbol >= 0 -> if {
                    context.symbols[fieldRange.symbolStart + field.fieldSymbol].nameToken => fieldToken!
                }
                context.tokens[fieldRange.tokenStart + fieldToken!] => token
                context.sources[field.sourceModule] -> slice(token.span.start, token.span.length) => name
                diagnostic.code == 35 -> if {
                    "contextual " -> print
                    diagnostic.operandTypeId -> emitBoxOperandTypeName(context)
                    " literal is missing field '$name'" -> println
                } else {
                    "field '" -> print
                    diagnostic.operandTypeId -> emitBoxOperandTypeName(context)
                    ".$name' expects " -> print
                    field.fieldType -> emitBoxOperandTypeName(context)
                    ", got " -> print
                    diagnostic.firstTypeId -> emitBoxOperandTypeName(context)
                    "" -> println
                }
                return
            }
        diagnostic.code == 47 -> if {
            context.calls[diagnostic.operatorKind] => call
            context.ranges[call.targetSourceModule] => targetRange
            context.modules[call.targetSourceModule] => identity
            context.sources[call.targetSourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName
            context.symbols[targetRange.symbolStart + call.functionSymbol] => target
            context.tokens[targetRange.tokenStart + target.nameToken] => nameToken
            context.sources[call.targetSourceModule] -> slice(nameToken.span.start, nameToken.span.length) => name
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
            context -> emitExpressionSemanticPrefix(diagnostic, location)
            "function '$moduleName.$name' is internal to module '$moduleName'" -> println
            return
        }
        diagnostic.code == 48 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
            context -> emitExpressionSemanticPrefix(diagnostic, location)
            context -> emitSemanticCallPathName(context.calls[diagnostic.operatorKind], diagnostic.operandAst, false)
            " is only valid in main for the current runtime slice" -> println
            return
        }
        diagnostic.code == 32 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
            context -> emitExpressionSemanticPrefix(diagnostic, location)
            diagnostic.operatorKind == -1 -> if {
                "map requires effect File; add 'uses File' to the caller signature" -> println
                return
            }
            context.calls[diagnostic.operatorKind] => effectCall
            effectCall.origin == 2 and effectCall.functionSymbol == -114
                -> if {
                    "flush requires effect File; add 'uses File' to the caller signature" -> println
                    return
                }
            "function '" -> print
            context -> emitSemanticCallPathName(context.calls[diagnostic.operatorKind], diagnostic.operandAst, false)
            diagnostic.operandTypeSymbol -> effects.declaredEffectName => effectName
            "' requires effect $effectName; add 'uses $effectName' to the caller signature" -> println
            return
        }
        diagnostic.code == 31 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
            context -> emitExpressionSemanticPrefix(diagnostic, location)
            diagnostic.operatorKind == 1 -> if {
                "value-flow expression statements must end in a unit-producing call or bind their result with '=>'" -> println
            } else {
                "only function calls with side effects are valid expression statements" -> println
            }
            return
        }
        diagnostic.code == 29 or diagnostic.code == 30
            -> if {
                context.ranges[diagnostic.sourceModule] => sourceRange
                context.nodes[sourceRange.astStart + diagnostic.astNode] => pattern
                context.tokens[sourceRange.tokenStart + pattern.payloadToken] => variant
                context.sources[diagnostic.sourceModule] -> slice(variant.span.start, variant.span.length) => variantName
                context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
                context -> emitExpressionSemanticPrefix(diagnostic, location)
                "variant '" -> print
                diagnostic.operandTypeId -> emitBoxOperandTypeName(context)
                ".$variantName' " -> print
                diagnostic.code == 29 -> if {
                    "requires a payload binding" -> println
                } else {
                    "has no payload to bind" -> println
                }
                return
            }
        diagnostic.code == 28 -> if {
            context.ranges[diagnostic.sourceModule] => sourceRange
            context.nodes[sourceRange.astStart + diagnostic.operandAst] => nameAst
            context.tokens[sourceRange.tokenStart + nameAst.payloadToken] => nameToken
            context.sources[diagnostic.sourceModule] -> slice(nameToken.span.start, nameToken.span.length) => name
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => nameLocation
            context -> emitExpressionSemanticPrefix(diagnostic, nameLocation)
            diagnostic.operatorKind == 4 -> if {
                "function '$name' expects an argument and must use call or flow syntax" -> println
            } else {
                "zero-input function '$name' must be called with parentheses: '$name()'" -> println
            }
            return
        }
        diagnostic.code == 23 -> if {
            context.ranges[diagnostic.sourceModule] => sourceRange
            context.nodes[sourceRange.astStart + diagnostic.operandAst] => nameAst
            context.tokens[sourceRange.tokenStart + nameAst.payloadToken] => nameToken
            context.sources[diagnostic.sourceModule] -> slice(nameToken.span.start, nameToken.span.length) => name
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => nameLocation
            context -> emitExpressionSemanticPrefix(diagnostic, nameLocation)
            "unknown binding '$name" -> print
            nameAst.firstToken => nameTokenIndex!
            nameTokenIndex! >= 0 and nameTokenIndex! < nameAst.firstToken + nameAst.tokenCount
                and nameTokenIndex! < sourceRange.tokenCount
                -> while {
                    context.tokens[sourceRange.tokenStart + nameTokenIndex!].kind == grammar.tokenIdBang()
                        -> if { "!" -> print }
                    nameTokenIndex! + 1 => nameTokenIndex!
                }
            "'; check its spelling and lexical scope. If the value was consumed by a move input, use the owner returned by that call, borrow it before the move, or create a new owner before reuse" -> println
            return
        }
        diagnostic.code >= 51 and diagnostic.code <= 54
            -> if {
                context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => repeatLocation
                context -> emitExpressionSemanticPrefix(diagnostic, repeatLocation)
                diagnostic.code == 51 -> if {
                    "repeat expects an integer input" -> println
                } else {
                    diagnostic.code == 52 -> if {
                        "Unit block function 'repeat' cannot bind a result" -> println
                    } else {
                        "it" => roleName!
                        diagnostic.operatorKind >= 0 -> if {
                            context.ranges[diagnostic.sourceModule] => range
                            context.tokens[range.tokenStart + diagnostic.operatorKind] => nameToken
                            context.sources[diagnostic.sourceModule] -> slice(nameToken.span.start, nameToken.span.length) => roleName!
                        }
                        diagnostic.code == 53
                            -> if { "binding '$(roleName!)' already exists in this scope" -> println } else { "binding name '$(roleName!)' is reserved" -> println }
                    }
                }
                return
            }
        diagnostic.code == 50 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => yieldLocation
            context -> emitExpressionSemanticPrefix(diagnostic, yieldLocation)
            "yield() is only valid inside a block function; current function is '" -> print
            context.ranges[diagnostic.sourceModule] => sourceRange
            diagnostic.operandAst >= 0 and context.nodes[sourceRange.astStart + diagnostic.operandAst].kind != 8
                -> if {
                    context.nodes[sourceRange.astStart + diagnostic.operandAst] => function
                    context.tokens[sourceRange.tokenStart + function.payloadToken] => nameToken
                    context.sources[diagnostic.sourceModule] -> slice(nameToken.span.start, nameToken.span.length) -> print
                } else { "main" -> print }
            "'" -> println
            return
        }
        diagnostic.code == 25 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => yieldLocation
            context -> emitExpressionSemanticPrefix(diagnostic, yieldLocation)
            "bare yield is only valid inside an async function" -> println
            return
        }
        diagnostic.code == 27 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => fieldLocation
            context -> emitExpressionSemanticPrefix(diagnostic, fieldLocation)
            context.fields[diagnostic.operatorKind] => field
            context.ranges[field.sourceModule] => fieldRange
            context.symbols[fieldRange.symbolStart + field.fieldSymbol] => declaration
            context.tokens[fieldRange.tokenStart + declaration.nameToken] => fieldToken
            context.sources[field.sourceModule] -> slice(fieldToken.span.start, fieldToken.span.length) => fieldName
            "cannot read private field '$fieldName' of struct '" -> print
            diagnostic.operandTypeId -> emitBoxOperandTypeName(context)
            "' outside module '" -> print
            0 => fieldModuleIndex!
            fieldModuleIndex! < (context.modules -> len) -> while {
                context.modules[fieldModuleIndex!] => identity
                identity.sourceIndex == field.sourceModule -> if {
                    context.sources[field.sourceModule] -> slice(identity.pathStart, identity.pathLength) -> print
                    context.modules -> len => fieldModuleIndex!
                } else { fieldModuleIndex! + 1 => fieldModuleIndex! }
            }
            "'; use its public factory or public instance methods" -> println
            return
        }
        diagnostic.code == 26 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => elementLocation
            context -> emitExpressionSemanticPrefix(diagnostic, elementLocation)
            "fixed array elements must be inline scalar or user values" -> println
            return
        }
        diagnostic.code == 24 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => repeatLocation
            context -> emitExpressionSemanticPrefix(diagnostic, repeatLocation)
            "array repeat value must be an inline copyable value" -> println
            return
        }
        diagnostic.code == 21 or diagnostic.code == 22
            -> if {
                context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => rangeLocation
                context -> emitExpressionSemanticPrefix(diagnostic, rangeLocation)
                diagnostic.code == 21 -> if {
                    "range start must be an integer" -> println
                } else {
                    "range end must be an integer" -> println
                }
                return
            }
        diagnostic.code == 3 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => unaryLocation
            context -> emitExpressionSemanticPrefix(diagnostic, unaryLocation)
            "'not' expects Bool" -> println
            return
        }
        diagnostic.code == 4 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => unaryLocation
            context -> emitExpressionSemanticPrefix(diagnostic, unaryLocation)
            "operand of unary '-' must be a signed numeric value" -> println
            return
        }
        diagnostic.code == 5 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => boxLocation
            diagnostic.operandTypeSymbol -> typeIds.builtinTypeName => operandTypeName
            context -> emitExpressionSemanticPrefix(diagnostic, boxLocation)
            "type $operandTypeName cannot be boxed in this slice" -> println
            return
        }
        diagnostic.code == 6 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => boxLocation
            context -> emitExpressionSemanticPrefix(diagnostic, boxLocation)
            "type " -> print
            diagnostic.operandTypeId -> emitBoxOperandTypeName(context)
            " cannot be boxed in this slice" -> println
            return
        }
        diagnostic.code == 7 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => mapPathLocation
            context -> emitExpressionSemanticPrefix(diagnostic, mapPathLocation)
            "map path must be Text" -> println
            return
        }
        diagnostic.code >= 8 and diagnostic.code <= 10
            -> if {
                context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => mapClauseLocation
                diagnostic.code == 8 -> if { "map offset must be UInt64 or an integer literal" } else {
                    diagnostic.code == 9 -> if { "map length must be UIntSize or an integer literal" } else {
                        "mapped file size must be UInt64 or an integer literal"
                    }
                } => mapClauseMessage
                "; sollang error[E29]: $mapClauseMessage at $(mapClauseLocation.line):$(mapClauseLocation.column) (source $(diagnostic.sourceModule), ast $(diagnostic.astNode))" -> println
                return
            }
        diagnostic.code == 11 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => mapBindingLocation
            "; sollang error[E29]: map write requires a mutable owner binding; use '=> name!' at $(mapBindingLocation.line):$(mapBindingLocation.column) (source $(diagnostic.sourceModule), ast $(diagnostic.astNode))" -> println
            return
        }
        diagnostic.code == 12 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => materializeLocation
            context -> emitExpressionSemanticPrefix(diagnostic, materializeLocation)
            "Text materialize expects one mutable Arena owner" -> println
            return
        }
        diagnostic.code == 13 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => materializeLocation
            context -> emitExpressionSemanticPrefix(diagnostic, materializeLocation)
            "Text materialize expects Arena but received " -> print
            diagnostic.operandTypeId -> emitBoxOperandTypeName(context)
            println()
            return
        }
        diagnostic.code == 14 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => materializeLocation
            context -> emitExpressionSemanticPrefix(diagnostic, materializeLocation)
            "function 'materialize' mutably borrows a container; use a mutable owner binding such as '" -> print
            context.ranges[diagnostic.sourceModule] => ownerRange
            context.nodes[ownerRange.astStart + diagnostic.operandAst] => ownerArgument
            context.tokens[ownerRange.tokenStart + ownerArgument.payloadToken] => ownerNameToken
            context.sources[diagnostic.sourceModule] -> slice(ownerNameToken.span.start, ownerNameToken.span.length) => ownerName
            "$ownerName!'" -> println
            return
        }
        diagnostic.code == 15 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => materializeLocation
            context -> emitExpressionSemanticPrefix(diagnostic, materializeLocation)
            "function 'materialize' mutably borrows a container, so the argument must be a mutable owner place" -> println
            return
        }
        diagnostic.code == 16 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => binaryLocation
            context -> emitExpressionSemanticPrefix(diagnostic, binaryLocation)
            diagnostic.operatorKind -> when {
                == grammar.tokenIdPlus() { "+" }
                == grammar.tokenIdMinus() { "-" }
                == grammar.tokenIdStar() { "*" }
                == grammar.tokenIdSlash() { "/" }
                else { "%" }
            } => operatorName
            diagnostic.operandTypeSymbol -> typeIds.builtinTypeName => leftTypeName
            "operands of '$operatorName' must have the same numeric type; left is $leftTypeName, right is " -> print
            diagnostic.operandTypeId -> emitBoxOperandTypeName(context)
            println()
            return
        }
        diagnostic.code == 17 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => ifLocation
            context -> emitExpressionSemanticPrefix(diagnostic, ifLocation)
            "if branches must return the same type, got " -> print
            diagnostic.firstTypeId -> emitBoxOperandTypeName(context)
            " and " -> print
            diagnostic.operandTypeId -> emitBoxOperandTypeName(context)
            println()
            return
        }
        diagnostic.code == 20 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => whenLocation
            context -> emitExpressionSemanticPrefix(diagnostic, whenLocation)
            diagnostic.operatorKind == 43 -> if {
                "when else must return " -> print
                diagnostic.firstTypeId -> emitBoxOperandTypeName(context)
                " but returns " -> print
            } else {
                "when arms must return the same type, got " -> print
                diagnostic.firstTypeId -> emitBoxOperandTypeName(context)
                " and " -> print
            }
            diagnostic.operandTypeId -> emitBoxOperandTypeName(context)
            println()
            return
        }
        diagnostic.code == 18 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => whileLocation
            context -> emitExpressionSemanticPrefix(diagnostic, whileLocation)
            "while condition must be Bool" -> println
            return
        }
        diagnostic.code == 19 -> if {
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => bindingLocation
            context -> emitExpressionSemanticPrefix(diagnostic, bindingLocation)
            context.ranges[diagnostic.sourceModule] => bindingRange
            context.nodes[bindingRange.astStart + diagnostic.astNode] => binding
            context.tokens[bindingRange.tokenStart + binding.payloadToken] => nameToken
            context.sources[diagnostic.sourceModule] -> slice(nameToken.span.start, nameToken.span.length) => name
            "mutable rebind of '$(name)!' requires " -> print
            diagnostic.firstTypeId -> emitBoxOperandTypeName(context)
            " but received " -> print
            diagnostic.operandTypeId -> emitBoxOperandTypeName(context)
            println()
            return
        }
        context.ranges[diagnostic.sourceModule] => sourceRange
        context.nodes[sourceRange.astStart + diagnostic.astNode].kind == 24
            -> if { "or" } else { "and" } => operatorName
        context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(diagnostic.locationOffset) => location
        context -> emitExpressionSemanticPrefix(diagnostic, location)
        diagnostic.code == 1 -> if {
            "left operand of '$operatorName' must be Bool" -> println
        } else {
            "right operand of '$operatorName' must be Bool" -> println
        }
    }
}
# Only source-owned binary comparisons use this contract. Subject-style when
# arms have their own synthetic comparison topology and are checked separately.
comparisonOperandFailureAt context: ref emitterContext.EmitContext, index: Int -> Int {
    context.ir[index] => comparison
    comparison.kind == 8
        and (comparison.opcode == grammar.tokenIdEqualEqual()
        or comparison.opcode == grammar.tokenIdBangEqual()
        or comparison.opcode == grammar.tokenIdLess()
        or comparison.opcode == grammar.tokenIdLessEqual()
        or comparison.opcode == grammar.tokenIdGreater()
        or comparison.opcode == grammar.tokenIdGreaterEqual())
        -> unless { 0 -> return }
    comparison.sourceModule >= 0 and comparison.sourceModule < (context.ranges -> len)
        -> unless { 0 -> return }
    context.ranges[comparison.sourceModule] => range
    comparison.astNode >= 0 and comparison.astNode < range.astCount
        -> unless { 0 -> return }
    context.nodes[range.astStart + comparison.astNode].kind => sourceKind
    sourceKind == 18 or sourceKind == 19 -> unless { 0 -> return }
    comparison.operand0 >= 0 and comparison.operand0 < (context.ir -> len)
        and comparison.operand1 >= 0 and comparison.operand1 < (context.ir -> len)
        -> unless { 5 -> return }
    context.ir[comparison.operand0] => left
    context.ir[comparison.operand1] => right
    context.types -> typeIds.materializedReadTypeId(left.typeId) => leftTypeId
    context.types -> typeIds.materializedReadTypeId(right.typeId) => rightTypeId
    leftTypeId >= 0 and leftTypeId < (context.types -> len)
        and rightTypeId >= 0 and rightTypeId < (context.types -> len)
        -> unless { 5 -> return }
    context.types[leftTypeId] => leftType
    context.types[rightTypeId] => rightType
    leftType.kind == 1 -> if { leftType.origin } else { -1 } => leftOrigin
    rightType.kind == 1 -> if { rightType.origin } else { -1 } => rightOrigin
    comparison.opcode -> semanticTypes.comparisonOperandFailure(leftOrigin, leftType.symbol, rightOrigin, rightType.symbol)
}

comparisonOperandDiagnosticCount context: ref emitterContext.EmitContext -> Int {
    0 => count!
    0 => index!
    index! < (context.ir -> len) -> while {
        context -> comparisonOperandFailureAt(index!) => failure
        failure != 0 -> if { count! + 1 => count! }
        index! + 1 => index!
    }
    count!
}

emitComparisonOperandDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    0 => index!
    index! < (context.ir -> len) -> while {
        context -> comparisonOperandFailureAt(index!) => failure
        failure != 0 -> if {
            context.ir[index!] => comparison
            failure == 5 -> if {
                "; sollang semantic error: comparison operands must have resolved numeric or Text types (source $(comparison.sourceModule), ast $(comparison.astNode))" -> println
            } else {
                context.ir[comparison.operand0] => left
                context.ir[comparison.operand1] => right
                context.types -> typeIds.materializedReadTypeId(left.typeId) => leftTypeId
                context.types -> typeIds.materializedReadTypeId(right.typeId) => rightTypeId
                failure == 1 or failure == 2 -> if { left.astNode } else { right.astNode } => valueAst
                context -> emitInitializerSemanticPrefix(comparison.sourceModule, valueAst)
                failure -> when {
                    == 1 { "left operand of comparison must be numeric" -> println }
                    == 2 { "Text supports content equality with '==' and '!='; ordering requires an explicit text comparison API" -> println }
                    == 3 {
                        "Text equality requires Text on both sides; left is " -> print
                        leftTypeId -> emitBoxOperandTypeName(context)
                        ", right is " -> print
                        rightTypeId -> emitBoxOperandTypeName(context)
                        "" -> println
                    }
                    else {
                        "comparison operands must have the same numeric type; left is " -> print
                        leftTypeId -> emitBoxOperandTypeName(context)
                        ", right is " -> print
                        rightTypeId -> emitBoxOperandTypeName(context)
                        "" -> println
                    }
                }
            }
        }
        index! + 1 => index!
    }
}

enumExhaustivenessDiagnosticCount context: ref emitterContext.EmitContext -> Int {
    0 => count!
    -1 => source!
    -1 => selection!
    context.missingEnumVariants -> each missing {
        missing.sourceModule != source! or missing.astNode != selection!
            -> if {
                count! + 1 => count!
                missing.sourceModule => source!
                missing.astNode => selection!
            }
    }
    count!
}

emitEnumExhaustivenessDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    -1 => source!
    -1 => selection!
    context.missingEnumVariants -> each missing {
        missing.sourceModule != source! or missing.astNode != selection!
            -> if {
                selection! >= 0 -> if { "" -> println }
                context -> emitInitializerSemanticPrefix(missing.sourceModule, missing.astNode)
                "non-exhaustive enum when; missing " -> print
                missing.sourceModule => source!
                missing.astNode => selection!
            } else { ", " -> print }
        missing.typeId -> emitBoxOperandTypeName(context)
        "." -> print
        missing.variantSymbol >= 0 -> if {
            context.types[missing.typeId] => enumType
            context.ranges[enumType.module] => ownerRange
            context.symbols[missing.variantSymbol] => variant
            context.tokens[ownerRange.tokenStart + variant.nameToken] => token
            context.sources[enumType.module] -> slice(token.span.start, token.span.length) -> print
        } else {
            context.types[missing.typeId].symbol == 0 -> if {
                missing.variantTag == 0 -> if { "Some" } else { "None" } -> print
            } else {
                missing.variantTag == 0 -> if { "Ok" } else { "Err" } -> print
            }
        }
    }
    selection! >= 0 -> if { "" -> println }
}

privateFieldOperationTypeId context: ref emitterContext.EmitContext, node: typedIr.TypedIrNode -> Int {
    -1 => typeId!
    node.kind == 12 -> if { node.typeId => typeId! }
    node.kind == 13 and node.operand0 >= 0 and node.operand0 < (context.ir -> len)
        -> if { context.ir[node.operand0].typeId => typeId! }
    node.kind == 25 and node.operand1 >= 0 and node.operand1 < (context.ir -> len)
        -> if { context.ir[node.operand1].typeId => typeId! }
    typeId! >= 0 and typeId! < (context.types -> len)
        and context.types[typeId!].kind == 8
        -> if { context.types[typeId!].first => typeId! }
    typeId!
}

privateFieldOwnerSource context: ref emitterContext.EmitContext, typeId: Int -> Int {
    -1 => sourceModule!
    typeId >= 0 and typeId < (context.types -> len)
        -> if {
            context.types[typeId] => valueType
            valueType.kind == 1 and (valueType.origin == 0 or valueType.origin == 2)
                -> if {
                    valueType.module => sourceModule!
                    valueType.origin == 2 -> if {
                        valueType.module >= 0 and valueType.module < (context.modules -> len)
                            -> if { context.modules[valueType.module].sourceIndex => sourceModule! } else { -1 => sourceModule! }
                    }
                }
        }
    sourceModule!
}

sameFieldTokenText context: ref emitterContext.EmitContext, leftSource: Int, leftToken: Int, rightSource: Int, rightToken: Int -> Bool {
    context.tokens[leftToken] => left
    context.tokens[rightToken] => right
    left.span.length == right.span.length => equal!
    UIntSize(0) => byteIndex!
    equal! and byteIndex! < left.span.length -> while {
        context.sources[leftSource] -> byte(left.span.start + byteIndex!) => leftByte
        context.sources[rightSource] -> byte(right.span.start + byteIndex!) => rightByte
        leftByte != rightByte -> if { false => equal! }
        byteIndex! + 1 => byteIndex!
    }
    equal!
}

externalPrivateOperationField context: ref emitterContext.EmitContext, node: typedIr.TypedIrNode -> Int {
    -1 => privateField!
    context -> privateFieldOperationTypeId(node) => typeId
    context -> privateFieldOwnerSource(typeId) => ownerSource
    ownerSource >= 0 and ownerSource < (context.ranges -> len)
        and not (context.sources -> modules.sameLogicalSource(context.modules, ownerSource, node.sourceModule, context.tokens, context.ranges))
        -> if {
            context.types[typeId] => valueType
            context.ranges[ownerSource] => ownerRange
            context.ranges[node.sourceModule] => operationRange
            context.nodes[operationRange.astStart + node.astNode] => operationAst
            -1 => operationFieldToken!
            node.kind == 13 -> if {
                operationAst.firstToken => tokenIndex!
                tokenIndex! < operationAst.firstToken + operationAst.tokenCount
                    -> while {
                        context.tokens[operationRange.tokenStart + tokenIndex!].kind == grammar.tokenIdIdentifier()
                            -> if { operationRange.tokenStart + tokenIndex! => operationFieldToken! }
                        tokenIndex! + 1 => tokenIndex!
                    }
            }
            node.kind == 25 -> if {
                operationRange.tokenStart + operationAst.secondaryToken => operationFieldToken!
            }
            valueType.symbol >= 0 and valueType.symbol < ownerRange.symbolCount
                -> if {
                    0 => fieldIndex!
                    fieldIndex! < ownerRange.symbolCount and privateField! < 0
                        -> while {
                            context.symbols[ownerRange.symbolStart + fieldIndex!] => field
                            field.kind == 26 and field.parent == valueType.symbol
                                -> if {
                                    node.kind == 12 -> if {
                                        field.flags / 4 % 2 == 0 -> if { fieldIndex! => privateField! }
                                    } else {
                                        operationFieldToken! >= 0
                                            and context -> sameFieldTokenText(
                                        node.sourceModule,
                                        operationFieldToken!,
                                        ownerSource,
                                        ownerRange.tokenStart + field.nameToken)
                                            -> if {
                                                field.flags / 4 % 2 == 0 -> if { fieldIndex! => privateField! }
                                            }
                                    }
                                }
                            fieldIndex! + 1 => fieldIndex!
                        }
                }
        }
    privateField!
}

privateFieldOperationDiagnosticCount context: ref emitterContext.EmitContext -> Int {
    0 => count!
    0 => irIndex!
    irIndex! < (context.ir -> len) -> while {
        context.ir[irIndex!] => node
        (node.kind == 12 or node.kind == 13 or node.kind == 25)
            and context -> externalPrivateOperationField(node) >= 0
            -> if { count! + 1 => count! }
        irIndex! + 1 => irIndex!
    }
    count!
}

emitPrivateFieldOperationDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    0 => irIndex!
    irIndex! < (context.ir -> len) -> while {
        context.ir[irIndex!] => node
        (node.kind == 12 or node.kind == 13 or node.kind == 25)
            and context -> externalPrivateOperationField(node) >= 0
            -> if {
                context -> privateFieldOperationTypeId(node) => typeId
                context.types[typeId] => valueType
                context -> privateFieldOwnerSource(typeId) => ownerSource
                context.ranges[ownerSource] => ownerRange
                context.symbols[ownerRange.symbolStart + valueType.symbol] => ownerSymbol
                context.tokens[ownerRange.tokenStart + ownerSymbol.nameToken] => ownerNameToken
                context.sources[ownerSource] -> slice(ownerNameToken.span.start, ownerNameToken.span.length) => ownerName
                -1 => ownerModuleIndex!
                0 => moduleIndex!
                moduleIndex! < (context.modules -> len) -> while {
                    context.modules[moduleIndex!] => moduleIdentity
                    moduleIdentity.sourceIndex == ownerSource
                        -> if {
                            moduleIndex! => ownerModuleIndex!
                            context.modules -> len => moduleIndex!
                        } else {
                            moduleIndex! + 1 => moduleIndex!
                        }
                }
                context.modules[ownerModuleIndex!] => ownerModule
                context.sources[ownerSource] -> slice(ownerModule.pathStart, ownerModule.pathLength) => moduleName
                context.ranges[node.sourceModule] => sourceRange
                context.nodes[sourceRange.astStart + node.astNode] => operationAst
                context -> externalPrivateOperationField(node) => privateFieldIndex
                context.symbols[ownerRange.symbolStart + privateFieldIndex] => privateField
                context.tokens[ownerRange.tokenStart + privateField.nameToken] => privateFieldNameToken
                context.sources[ownerSource] -> slice(privateFieldNameToken.span.start, privateFieldNameToken.span.length) => privateFieldName
                node.kind -> when {
                    == 12 {
                        "; sollang semantic error: cannot construct struct '$moduleName.$ownerName' outside module '$moduleName' because field '$privateFieldName' is private; use its public factory or public instance methods" -> println
                    }
                    == 13 {
                        -1 => fieldToken!
                        operationAst.firstToken => tokenIndex!
                        tokenIndex! < operationAst.firstToken + operationAst.tokenCount
                            -> while {
                                context.tokens[sourceRange.tokenStart + tokenIndex!].kind == grammar.tokenIdIdentifier()
                                    -> if { tokenIndex! => fieldToken! }
                                tokenIndex! + 1 => tokenIndex!
                            }
                        context.tokens[sourceRange.tokenStart + fieldToken!] => fieldNameToken
                        context.sources[node.sourceModule] -> slice(fieldNameToken.span.start, fieldNameToken.span.length) => fieldName
                        "; sollang semantic error: cannot read private field '$fieldName' of struct '$moduleName.$ownerName' outside module '$moduleName'; use its public factory or public instance methods" -> println
                    }
                    else {
                        context.tokens[sourceRange.tokenStart + operationAst.secondaryToken] => fieldNameToken
                        context.sources[node.sourceModule] -> slice(fieldNameToken.span.start, fieldNameToken.span.length) => fieldName
                        "; sollang semantic error: cannot write private field '$fieldName' of struct '$moduleName.$ownerName' outside module '$moduleName'; use its public factory or public instance methods" -> println
                    }
                }
            }
        irIndex! + 1 => irIndex!
    }
}

signatureTypeId source: Int, typeAst: Int, context: ref emitterContext.EmitContext -> Int {
    -1 => result!
    false => ambiguous!
    context.typeReferences -> each reference {
        reference.sourceModule == source and reference.typeAst == typeAst and reference.status == 0
            -> if {
                result! < 0 -> if {
                    reference.typeId => result!
                } else {
                    result! != reference.typeId -> if { true => ambiguous! }
                }
            }
    }
    ambiguous! -> if { -1 -> return }
    result!
}

signatureTypeTerm source: Int, typeAst: Int, context: ref emitterContext.EmitContext -> Int {
    context.ranges[source] => range
    -1 => result!
    0 => index!
    index! < range.termCount -> while {
        context.typeTerms[range.termStart + index!].astNode == typeAst
            -> if { range.termStart + index! => result! }
        index! + 1 => index!
    }
    result!
}

signatureNominalIdentity source: Int, typeAst: Int, context: ref emitterContext.EmitContext -> Int {
    source -> signatureTypeTerm(typeAst, context) => termIndex
    termIndex >= 0 -> if {
        context.typeTerms[termIndex] => term
        term.kind == 7 and term.nameToken >= 0 -> if {
            source -> sourceTokenIs(term.nameToken, "Option", context)
                -> if { -100 -> return }
            source -> sourceTokenIs(term.nameToken, "Result", context)
                -> if { -101 -> return }
            source -> sourceTokenIs(term.nameToken, "Task", context)
                -> if { -102 -> return }
            source -> sourceTokenIs(term.nameToken, "Stream", context)
                -> if { -103 -> return }
            source -> sourceTokenIs(term.nameToken, "EventStream", context)
                -> if { -104 -> return }
            source -> sourceTokenIs(term.nameToken, "Set", context)
                -> if { -105 -> return }
            source -> sourceTokenIs(term.nameToken, "Deque", context)
                -> if { -106 -> return }
            source -> sourceTokenIs(term.nameToken, "BinaryHeap", context)
                -> if { -107 -> return }
        }
    }
    -1 => result!
    context.nominal -> each nominal {
        nominal.sourceModule == source and nominal.typeAst == typeAst and nominal.status == 0
            -> if {
                nominal.origin == 1 -> if {
                    0 - nominal.targetSymbol - 2 => result!
                } else {
                    nominal.targetModule >= 0 and nominal.targetModule < (context.ranges -> len) and nominal.targetSymbol >= 0
                        -> if { context.ranges[nominal.targetModule].symbolStart + nominal.targetSymbol => result! }
                }
            }
    }
    result!
}

signatureTypeMatches leftSource: Int, leftAst: Int, rightSource: Int, rightAst: Int, implSymbol: Int, context: ref emitterContext.EmitContext -> Bool {
    leftAst < 0 or rightAst < 0 -> if { false -> return }
    leftSource -> signatureTypeTerm(leftAst, context) => leftTermIndex
    # An associated declaration type belongs to this exact implementation even
    # when an earlier generic specialization left a provisional positive type
    # id on the shared declaration AST. Only a bare nominal annotation names
    # the associated type; an array containing Item must keep its array shape.
    # Resolve the binding before consulting cached ids so another specialization
    # cannot decide this signature.
    context.ranges[leftSource] => annotationRange
    context.nodes[annotationRange.astStart + leftAst] => annotation
    -1 => nameToken!
    0 => names!
    annotation.firstToken => tokenIndex!
    tokenIndex! < annotation.firstToken + annotation.tokenCount
        -> while {
            context.tokens[annotationRange.tokenStart + tokenIndex!].kind == grammar.tokenIdIdentifier()
                -> if {
                    tokenIndex! => nameToken!
                    names! + 1 => names!
                }
            tokenIndex! + 1 => tokenIndex!
        }
    leftTermIndex >= 0 and context.typeTerms[leftTermIndex].kind == 1 and names! == 1
        -> if {
            context.ranges[rightSource] => implementationRange
            0 => symbolIndex!
            symbolIndex! < implementationRange.symbolCount
                -> while {
                    context.symbols[implementationRange.symbolStart + symbolIndex!] => associated
                    associated.kind == 30 and associated.parent == implSymbol and associated.nameToken >= 0
                        and (leftSource -> sourceTokensEqual(nameToken!, rightSource, associated.nameToken, context))
                        -> if {
                            rightSource -> signatureTypeMatches(associated.typeNode, rightSource, rightAst, implSymbol, context) -> return
                        }
                    symbolIndex! + 1 => symbolIndex!
                }
        }
    leftSource -> signatureTypeId(leftAst, context) => leftId
    rightSource -> signatureTypeId(rightAst, context) => rightId
    leftId >= 0 and leftId == rightId -> if { true -> return }
    rightSource -> signatureTypeTerm(rightAst, context) => rightTermIndex
    leftTermIndex < 0 or rightTermIndex < 0 -> if { false -> return }
    context.typeTerms[leftTermIndex] => leftTerm
    context.typeTerms[rightTermIndex] => rightTerm
    leftTerm.kind != rightTerm.kind or leftTerm.kind == 1
        -> if { false -> return }
    leftTerm.kind == 11 -> if {
        (leftTerm.nameToken < 0 and rightTerm.nameToken >= 0) or (leftTerm.nameToken >= 0 and rightTerm.nameToken < 0)
            -> if { false -> return }
        leftTerm.nameToken >= 0 and not (leftSource -> sourceTokensEqual(leftTerm.nameToken, rightSource, rightTerm.nameToken, context))
            -> if { false -> return }
    }
    leftTerm.kind == 7 -> if {
        leftSource -> signatureNominalIdentity(leftAst, context) => leftIdentity
        rightSource -> signatureNominalIdentity(rightAst, context) => rightIdentity
        leftIdentity == -1 or leftIdentity != rightIdentity
            -> if { false -> return }
    }
    (leftTerm.lengthToken < 0 and rightTerm.lengthToken >= 0) or (leftTerm.lengthToken >= 0 and rightTerm.lengthToken < 0)
        -> if { false -> return }
    leftTerm.lengthToken >= 0 and not (leftSource -> sourceTokensEqual(leftTerm.lengthToken, rightSource, rightTerm.lengthToken, context))
        -> if { false -> return }
    context.ranges[leftSource] => leftRange
    context.ranges[rightSource] => rightRange
    [leftTerm.firstArgument, leftTerm.secondArgument] => leftArguments
    [rightTerm.firstArgument, rightTerm.secondArgument] => rightArguments
    0 => argument!
    argument! < 2 -> while {
        leftArguments[argument!] => leftChild
        rightArguments[argument!] => rightChild
        (leftChild < 0 and rightChild >= 0) or (leftChild >= 0 and rightChild < 0)
            -> if { false -> return }
        leftChild >= 0 -> if {
            context.typeTerms[leftRange.termStart + leftChild].astNode => leftChildAst
            context.typeTerms[rightRange.termStart + rightChild].astNode => rightChildAst
            not (leftSource -> signatureTypeMatches(leftChildAst, rightSource, rightChildAst, implSymbol, context))
                -> if { false -> return }
        }
        argument! + 1 => argument!
    }
    true
}

signatureInput source: Int, method: Int, ordinal: Int, context: ref emitterContext.EmitContext -> Int {
    context.ranges[source] => range
    -1 => selected!
    0 => candidateIndex!
    candidateIndex! < range.symbolCount -> while {
        context.symbols[range.symbolStart + candidateIndex!] => candidate
        candidate.kind == 35 and candidate.parent == method and candidate.nameToken >= 0
            and not (source -> sourceTokenIs(candidate.nameToken, "self", context))
            -> if {
                0 => preceding!
                0 => otherIndex!
                otherIndex! < range.symbolCount -> while {
                    context.symbols[range.symbolStart + otherIndex!] => other
                    other.kind == 35 and other.parent == method and other.nameToken >= 0
                        and not (source -> sourceTokenIs(other.nameToken, "self", context))
                        and context.tokens[range.tokenStart + other.nameToken].span.start < context.tokens[range.tokenStart + candidate.nameToken].span.start
                        -> if { preceding! + 1 => preceding! }
                    otherIndex! + 1 => otherIndex!
                }
                preceding! == ordinal -> if { candidateIndex! => selected! }
            }
        candidateIndex! + 1 => candidateIndex!
    }
    selected!
}

traitDeclarationForImpl source: Int, implementationIndex: Int, context: ref emitterContext.EmitContext -> Int {
    context.ranges[source] => range
    context.symbols[range.symbolStart + implementationIndex] => implementation
    -1 => traitPath!
    0 => paths!
    0 => nodeIndex!
    nodeIndex! < range.astCount -> while {
        context.nodes[range.astStart + nodeIndex!] => node
        node.parent == implementation.astNode and node.kind == 16
            -> if {
                traitPath! < 0 or node.start < context.nodes[range.astStart + traitPath!].start
                    -> if { nodeIndex! => traitPath! }
                paths! + 1 => paths!
            }
        nodeIndex! + 1 => nodeIndex!
    }
    paths! < 2 -> if { -1 -> return }
    context.nodes[range.astStart + traitPath!] => path
    -1 => traitName!
    path.firstToken => tokenIndex!
    tokenIndex! < path.firstToken + path.tokenCount
        -> while {
            context.tokens[range.tokenStart + tokenIndex!].kind == grammar.tokenIdIdentifier()
                -> if { tokenIndex! => traitName! }
            tokenIndex! + 1 => tokenIndex!
        }
    traitName! < 0 -> if { -1 -> return }
    context.tokens[range.tokenStart + traitName!] => name
    UInt64(0) => moduleHash!
    false => foundModule!
    name.span.start == path.start -> if {
        context.modules -> each identity { identity.sourceIndex == source
                -> if { identity.pathHash => moduleHash!
                    true => foundModule! } }
    } else {
        context.sources[source] -> slice(path.start, name.span.start - path.start - 1) => prefix
        context.imports -> each edge {
            edge.sourceModule == source and edge.aliasToken >= 0
                -> if {
                    context.tokens[range.tokenStart + edge.aliasToken] => alias
                    (context.sources[source] -> slice(alias.span.start, alias.span.length)) == prefix
                        -> if { edge.targetHash => moduleHash!
                            true => foundModule! }
                }
        }
        not foundModule! -> if {
            context.modules -> each identity {
                (context.sources[identity.sourceIndex] -> slice(identity.pathStart, identity.pathLength)) == prefix
                    -> if { identity.pathHash => moduleHash!
                        true => foundModule! }
            }
        }
    }
    -1 => result!
    foundModule! -> if {
        context.modules -> each identity {
            identity.pathHash == moduleHash! -> if {
                context.ranges[identity.sourceIndex] => candidateRange
                0 => candidateIndex!
                candidateIndex! < candidateRange.symbolCount -> while {
                    context.symbols[candidateRange.symbolStart + candidateIndex!] => candidate
                    candidate.kind == 5 and candidate.nameToken >= 0 and (source -> sourceTokensEqual(traitName!, identity.sourceIndex, candidate.nameToken, context))
                        -> if { candidateRange.symbolStart + candidateIndex! => result! }
                    candidateIndex! + 1 => candidateIndex!
                }
            }
        }
    }
    result!
}

# Return a stable mismatch category; no source calls are needed to validate an implementationIndex.
traitMethodMismatch source: Int, implementationIndex: Int, declarationSource: Int, declaration: Int, context: ref emitterContext.EmitContext -> Int {
    context.ranges[source] => range
    context.ranges[declarationSource] => declarationRange
    context.symbols[declarationRange.symbolStart + declaration] => expected
    -1 => method!
    0 => search!
    search! < range.symbolCount -> while {
        context.symbols[range.symbolStart + search!] => candidate
        candidate.kind == 31 and candidate.parent == implementationIndex and candidate.nameToken >= 0
            and (source -> sourceTokensEqual(candidate.nameToken, declarationSource, expected.nameToken, context))
            -> if { search! => method! }
        search! + 1 => search!
    }
    method! < 0 -> if { 4 -> return }
    context.symbols[range.symbolStart + method!] => actualMethod
    expected.flags % 4 != actualMethod.flags % 4 -> if { 2 -> return }
    not (declarationSource -> signatureTypeMatches(expected.typeNode, source, actualMethod.typeNode, implementationIndex, context))
        -> if { 5 -> return }
    0 => ordinal!
    true => checking!
    checking! -> while {
        declarationSource -> signatureInput(declaration, ordinal!, context) => left
        source -> signatureInput(method!, ordinal!, context) => right
        left < 0 and right >= 0 or left >= 0 and right < 0
            -> if { 1 -> return }
        left < 0 -> if { false => checking! } else {
            context.symbols[declarationRange.symbolStart + left] => leftParameter
            context.symbols[range.symbolStart + right] => rightParameter
            leftParameter.flags % 4 != rightParameter.flags % 4
                -> if { 2 -> return }
            not (declarationSource -> signatureTypeMatches(leftParameter.typeNode, source, rightParameter.typeNode, implementationIndex, context))
                -> if { 3 -> return }
            ordinal! + 1 => ordinal!
        }
    }
    0
}

traitMethodDeclaration source: Int, method: Int, traitIdentity: Int, context: ref emitterContext.EmitContext -> Int {
    context.ranges[source] => range
    context.symbols[range.symbolStart + method] => actual
    context.ranges -> each declarationRange {
        traitIdentity >= declarationRange.symbolStart and traitIdentity < declarationRange.symbolStart + declarationRange.symbolCount
            -> if {
                0 => declaration!
                declaration! < declarationRange.symbolCount -> while {
                    context.symbols[declarationRange.symbolStart + declaration!] => expected
                    expected.kind == 29 and expected.parent == traitIdentity - declarationRange.symbolStart
                        and (source -> sourceTokensEqual(actual.nameToken, declarationRange.sourceModule, expected.nameToken, context))
                        -> if { declarationRange.symbolStart + declaration! -> return }
                    declaration! + 1 => declaration!
                }
            }
    }
    -1
}

traitImplementationReceiver source: Int, implementation: Int, context: ref emitterContext.EmitContext -> Int {
    context.ranges[source] => range
    context.symbols[range.symbolStart + implementation] => owner
    context.nodes -> typeIds.implTypePaths(range.astStart, range.astCount, owner.astNode) => paths
    source -> signatureTypeId(paths.ownerAst, context) => ownerTypeId
    ownerTypeId < 0 -> if { -1 -> return }
    context.types[ownerTypeId] => ownerType
    (ownerType.kind == 1 or ownerType.kind == 7) and (ownerType.origin == 0 or ownerType.origin == 2)
        and ownerType.module >= 0 and ownerType.module < (context.ranges -> len) and ownerType.symbol >= 0
        -> if { context.ranges[ownerType.module].symbolStart + ownerType.symbol -> return }
    -1
}

struct TraitRequirementImplementationSelection {
    symbol: Int
    count: Int
}

traitRequirementImplementations traitIdentity: Int, receiverIdentity: Int, requirement: Int, firstOnly: Bool, context: ref emitterContext.EmitContext -> TraitRequirementImplementationSelection {
    -1 => selected!
    0 => count!
    context.ranges -> each range {
        0 => method!
        method! < range.symbolCount -> while {
            context.symbols[range.symbolStart + method!] => actual
            actual.kind == 31 and actual.parent >= 0 and actual.nameToken >= 0
                and context.symbols[range.symbolStart + actual.parent].kind == 6
                -> if {
                    range.sourceModule -> traitDeclarationForImpl(actual.parent, context) == traitIdentity
                        and (range.sourceModule -> traitImplementationReceiver(actual.parent, context)) == receiverIdentity
                        and (range.sourceModule -> traitMethodDeclaration(method!, traitIdentity, context)) == requirement
                        -> if {
                            selected! < 0 -> if { range.symbolStart + method! => selected! }
                            count! + 1 => count!
                            firstOnly -> if {
                                TraitRequirementImplementationSelection { symbol: selected!, count: count! } -> return
                            }
                        }
                }
            method! + 1 => method!
        }
    }
    TraitRequirementImplementationSelection { symbol: selected!, count: count! }
}

traitRequirementImplementation traitIdentity: Int, receiverIdentity: Int, requirement: Int, context: ref emitterContext.EmitContext -> Int {
    traitIdentity -> traitRequirementImplementations(receiverIdentity, requirement, true, context) => selection
    selection.symbol
}

traitRequirementImplemented traitIdentity: Int, receiverIdentity: Int, requirement: Int, context: ref emitterContext.EmitContext -> Bool {
    (traitIdentity -> traitRequirementImplementation(receiverIdentity, requirement, context)) >= 0
}

traitAssociatedBindingIssue source: Int, implementation: Int, traitIdentity: Int, context: ref emitterContext.EmitContext -> Int {
    context.ranges[source] => implementationRange
    [Int; ~] => bindings!
    0 => symbolIndex!
    symbolIndex! < implementationRange.symbolCount
        -> while {
            implementationRange.symbolStart + symbolIndex! => identity
            context.symbols[identity] => binding
            binding.kind == 30 and binding.parent == implementation and binding.nameToken >= 0
                -> if { bindings! -> push(identity) }
            symbolIndex! + 1 => symbolIndex!
        }
    context.ranges -> each declarationRange {
        traitIdentity >= declarationRange.symbolStart and traitIdentity < declarationRange.symbolStart + declarationRange.symbolCount
            -> if {
                [Int; ~] => declarations!
                0 => declarationIndex!
                declarationIndex! < declarationRange.symbolCount
                    -> while {
                        declarationRange.symbolStart + declarationIndex! => identity
                        context.symbols[identity] => declaration
                        declaration.kind == 28 and declaration.parent == traitIdentity - declarationRange.symbolStart and declaration.nameToken >= 0
                            -> if { declarations! -> push(identity) }
                        declarationIndex! + 1 => declarationIndex!
                    }
                # Return the real binding/declaration identity. Its symbol kind
                # distinguishes an unknown binding from a missing declaration.
                bindings! -> each bindingIdentity {
                    context.symbols[bindingIdentity] => binding
                    false => declared!
                    declarations! -> each declarationIdentity {
                        context.symbols[declarationIdentity] => declaration
                        source -> sourceTokensEqual(binding.nameToken, declarationRange.sourceModule, declaration.nameToken, context)
                            -> if { true => declared! }
                    }
                    not declared! -> if { bindingIdentity -> return }
                }
                declarations! -> each declarationIdentity {
                    context.symbols[declarationIdentity] => declaration
                    false => bound!
                    bindings! -> each bindingIdentity {
                        context.symbols[bindingIdentity] => binding
                        source -> sourceTokensEqual(binding.nameToken, declarationRange.sourceModule, declaration.nameToken, context)
                            -> if { true => bound! }
                    }
                    not bound! -> if { declarationIdentity -> return }
                }
            }
    }
    -1
}

traitSignatureDiagnostics context: ref emitterContext.EmitContext, writeDiagnostics: Bool -> Int uses Console {
    # Concrete methods are checked before any missing requirement, matching the
    # managed function traversal. The first diagnostic owns the source location.
    -1 => checkedAssociatedImpl!
    context.ranges -> each range {
        0 => method!
        method! < range.symbolCount -> while {
            context.symbols[range.symbolStart + method!] => actual
            actual.kind == 31 and actual.parent >= 0 and actual.nameToken >= 0
                and context.symbols[range.symbolStart + actual.parent].kind == 6
                -> if {
                    range.sourceModule -> traitDeclarationForImpl(actual.parent, context) => traitIdentity
                    traitIdentity >= 0 -> if {
                        range.symbolStart + actual.parent => implementationIdentity
                        implementationIdentity != checkedAssociatedImpl!
                            -> if {
                                range.sourceModule -> traitAssociatedBindingIssue(actual.parent, traitIdentity, context) => issue
                                issue >= 0 -> if {
                                    writeDiagnostics -> if {
                                        context.tokens[range.tokenStart + actual.nameToken] => methodName
                                        context -> emitInitializerSemanticPrefixAtOffset(range.sourceModule, actual.astNode, methodName.span.start)
                                        context.symbols[issue] => associated
                                        associated.kind == 30 -> if {
                                            "trait '" -> print
                                            context -> emitNominalDeclarationName(traitIdentity)
                                            "' has no associated type '" -> print
                                        } else {
                                            "impl " -> print
                                            context -> emitNominalDeclarationName(traitIdentity)
                                            " requires associated type '" -> print
                                        }
                                        context.ranges -> each issueRange {
                                            issue >= issueRange.symbolStart and issue < issueRange.symbolStart + issueRange.symbolCount
                                                -> if {
                                                    context.tokens[issueRange.tokenStart + associated.nameToken] => name
                                                    context.sources[issueRange.sourceModule] -> slice(name.span.start, name.span.length) -> print
                                                }
                                        }
                                        "'" -> println
                                    }
                                    1 -> return
                                }
                                implementationIdentity => checkedAssociatedImpl!
                            }
                        range.sourceModule -> traitMethodDeclaration(method!, traitIdentity, context) => requirement
                        0 => mismatch!
                        requirement >= 0 -> if {
                            context.ranges -> each declarationRange {
                                requirement >= declarationRange.symbolStart and requirement < declarationRange.symbolStart + declarationRange.symbolCount
                                    -> if {
                                        range.sourceModule -> traitMethodMismatch(actual.parent, declarationRange.sourceModule, requirement - declarationRange.symbolStart, context) => mismatch!
                                    }
                            }
                        }
                        requirement < 0 or mismatch! > 0 -> if {
                            writeDiagnostics -> if {
                                context.tokens[range.tokenStart + actual.nameToken] => nameToken
                                context.sources[range.sourceModule] -> slice(nameToken.span.start, nameToken.span.length) => name
                                context -> emitInitializerSemanticPrefixAtOffset(range.sourceModule, actual.astNode, nameToken.span.start)
                                requirement < 0 -> if {
                                    "trait '" -> print
                                    context -> emitNominalDeclarationName(traitIdentity)
                                    "' has no method '$name'" -> println
                                } else {
                                    "trait method '" -> print
                                    context -> emitNominalDeclarationName(traitIdentity)
                                    ".$name' signature does not match its declaration" -> println
                                }
                            }
                            1 -> return
                        }
                    }
                }
            method! + 1 => method!
        }
    }
    # Missing requirements are grouped by canonical trait and receiver, so a
    # separate impl block can supply a method for the same managed pair.
    context.ranges -> each range {
        0 => method!
        method! < range.symbolCount -> while {
            context.symbols[range.symbolStart + method!] => actual
            actual.kind == 31 and actual.parent >= 0 and actual.nameToken >= 0
                and context.symbols[range.symbolStart + actual.parent].kind == 6
                -> if {
                    range.sourceModule -> traitDeclarationForImpl(actual.parent, context) => traitIdentity
                    range.sourceModule -> traitImplementationReceiver(actual.parent, context) => receiverIdentity
                    traitIdentity >= 0 and receiverIdentity >= 0 -> if {
                        context.ranges -> each declarationRange {
                            traitIdentity >= declarationRange.symbolStart and traitIdentity < declarationRange.symbolStart + declarationRange.symbolCount
                                -> if {
                                    0 => declaration!
                                    declaration! < declarationRange.symbolCount -> while {
                                        declarationRange.symbolStart + declaration! => requirement
                                        context.symbols[requirement] => expected
                                        expected.kind == 29 and expected.parent == traitIdentity - declarationRange.symbolStart
                                            and not (traitIdentity -> traitRequirementImplemented(receiverIdentity, requirement, context))
                                            -> if {
                                                writeDiagnostics -> if {
                                                    context.symbols[traitIdentity] => traitDeclaration
                                                    context -> emitInitializerSemanticPrefix(declarationRange.sourceModule, traitDeclaration.astNode)
                                                    "impl " -> print
                                                    context -> emitNominalDeclarationName(traitIdentity)
                                                    " for " -> print
                                                    context -> emitNominalDeclarationName(receiverIdentity)
                                                    context.tokens[declarationRange.tokenStart + expected.nameToken] => nameToken
                                                    context.sources[declarationRange.sourceModule] -> slice(nameToken.span.start, nameToken.span.length) => name
                                                    " is missing method '$name'" -> println
                                                }
                                                1 -> return
                                            }
                                        declaration! + 1 => declaration!
                                    }
                                }
                        }
                    }
                }
            method! + 1 => method!
        }
    }
    0
}

emitDynConversionPrefix conversion: typedIr.TypedIrNode, context: ref emitterContext.EmitContext -> Unit uses Console {
    context.ranges[conversion.sourceModule] => range
    context.nodes[range.astStart + conversion.astNode] => expression
    expression.start => offset!
    expression.firstToken => cursor!
    false => found!
    cursor! < expression.firstToken + expression.tokenCount and not found!
        -> while {
            context.tokens[range.tokenStart + cursor!] => token
            token.kind == grammar.tokenIdIdentifier()
                and (context.sources[conversion.sourceModule] -> slice(token.span.start, token.span.length)) == "dyn"
                -> if {
                    token.span.start => offset!
                    true => found!
                }
            cursor! + 1 => cursor!
        }
    context -> emitInitializerSemanticPrefixAtOffset(conversion.sourceModule, conversion.astNode, offset!)
}

dynConversionOperandDiagnostic conversion: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, writeDiagnostics: Bool -> Bool uses Console {
    context.ir[conversion.operand0].typeId => operandTypeId
    false => userValue!
    operandTypeId >= 0 and operandTypeId < (context.types -> len)
        -> if {
            context.types[operandTypeId] => operandType
            (operandType.kind == 1 or operandType.kind == 7)
                and (operandType.origin == 0 or operandType.origin == 2) => userValue!
        }
    not userValue! -> if {
        writeDiagnostics -> if {
            conversion -> emitDynConversionPrefix(context)
            "dyn conversion requires a user value but received " -> print
            operandTypeId -> emitBoxOperandTypeName(context)
            "" -> println
        }
        true -> return
    }
    context.ownedStorageByType[operandTypeId] -> if {
        writeDiagnostics -> if {
            conversion -> emitDynConversionPrefix(context)
            "dyn conversion of values with nested owned storage is not supported until move transfer is explicit" -> println
        }
        true -> return
    }
    false
}

dynConversionImplementationDiagnostic conversion: typedIr.TypedIrNode, context: ref emitterContext.EmitContext, writeDiagnostics: Bool -> Bool uses Console {
    context.types[conversion.typeId] => dynType
    context.ranges[dynType.module].symbolStart + dynType.symbol => traitIdentity
    context.ir[conversion.operand0].typeId => receiverTypeId
    context.types[receiverTypeId] => receiver
    context.ranges[receiver.module].symbolStart + receiver.symbol => receiverIdentity
    conversion.typeId -> dynTraitMethodCount(context) => methodCount
    0 => ordinal!
    ordinal! < methodCount -> while {
        conversion.typeId -> dynTraitMethodDeclaration(ordinal!, context) => requirement
        traitIdentity -> traitRequirementImplementations(receiverIdentity, requirement, false, context) => selection
        selection.count != 1 -> if {
            writeDiagnostics -> if {
                conversion -> emitDynConversionPrefix(context)
                receiverTypeId -> emitBoxOperandTypeName(context)
                " must provide exactly one implementation of '" -> print
                context -> emitNominalDeclarationName(traitIdentity)
                "." -> print
                context.symbols[requirement] => method
                context.ranges[dynType.module] => range
                context.tokens[range.tokenStart + method.nameToken] => name
                context.sources[dynType.module] -> slice(name.span.start, name.span.length) -> print
                "' for dyn conversion" -> println
            }
            true -> return
        }
        ordinal! + 1 => ordinal!
    }
    false
}

dynCompatibilityDiagnostics context: ref emitterContext.EmitContext, writeDiagnostics: Bool -> Int uses Console {
    0 => count!
    0 => index!
    index! < (context.ir -> len) -> while {
        context.ir[index!] => conversion
        conversion.kind == 9 and conversion.opcode == -224 and conversion.operand0 >= 0 and conversion.typeOrigin == 16
            and conversion.typeId >= 0 and conversion.typeModule >= 0
            -> if {
                conversion -> dynConversionOperandDiagnostic(context, writeDiagnostics)
                    -> if {
                        count! + 1 => count!
                    } else {
                        context.ranges[conversion.typeModule] => range
                        range.symbolStart + conversion.typeSymbol => traitIdentity
                        false => associated!
                        0 => memberIndex!
                        -1 => incompatible!
                        memberIndex! < range.symbolCount -> while {
                            context.symbols[range.symbolStart + memberIndex!] => member
                            member.parent == conversion.typeSymbol -> if {
                                member.kind == 28 -> if { true => associated! }
                                member.kind == 29 and incompatible! < 0 -> if {
                                    conversion.typeModule -> signatureInput(memberIndex!, 0, context) => additionalInput
                                    conversion.typeModule -> signatureTypeId(member.typeNode, context) => returnType
                                    member.flags % 4 != 0 or additionalInput >= 0 or returnType != 2
                                        -> if { memberIndex! => incompatible! }
                                }
                            }
                            memberIndex! + 1 => memberIndex!
                        }
                        associated! or incompatible! >= 0 -> if {
                            count! + 1 => count!
                            writeDiagnostics -> if {
                                conversion -> emitDynConversionPrefix(context)
                                associated! -> if {
                                    "trait '" -> print
                                    context -> emitNominalDeclarationName(traitIdentity)
                                    "' is not dyn-compatible because it declares associated types" -> println
                                } else {
                                    "trait method '" -> print
                                    context -> emitNominalDeclarationName(traitIdentity)
                                    "." -> print
                                    context.symbols[range.symbolStart + incompatible!] => method
                                    context.tokens[range.tokenStart + method.nameToken] => name
                                    context.sources[conversion.typeModule] -> slice(name.span.start, name.span.length) -> print
                                    "' is not dyn-compatible; the current dyn slice requires readonly self, no additional parameters, and an Int return type" -> println
                                }
                            }
                        } else {
                            conversion -> dynConversionImplementationDiagnostic(context, writeDiagnostics)
                                -> if { count! + 1 => count! }
                        }
                    }
            }
        index! + 1 => index!
    }
    count!
}

struct FixedArrayCallFunctionSelection {
    computed: Bool
    first: Int
    valueGenericTemplate: Int
}

fixedArrayCallDiagnostics context: ref emitterContext.EmitContext, writeDiagnostics: Bool -> Int uses Console {
    context.ir -> typedIr.functionDeclarationIrs => functionCandidates
    {UInt64: FixedArrayCallFunctionSelection; 16~} => functionsByIdentity!
    context.ir -> each query {
        query.kind == 6 and query.targetModule >= 0 and query.symbol >= 0 and query.operand0 >= 0
            -> if {
                query.targetModule -> typedIr.sourceLocalIdentity(query.symbol) => identity
                functionsByIdentity! -> putIfAbsent(identity, FixedArrayCallFunctionSelection { computed: false, first: -1, valueGenericTemplate: -1 }) => inserted
            }
    }
    0 => count!
    0 => callIndex!
    callIndex! < (context.ir -> len) -> while {
        context.ir[callIndex!] => call
        call.kind == 6 and call.targetModule >= 0 and call.symbol >= 0 and call.operand0 >= 0
            -> if {
                call.targetModule -> typedIr.sourceLocalIdentity(call.symbol) => identity
                functionsByIdentity![identity] => selection!
                not selection!.computed -> if {
                    0 => valueGenericTemplateSearch!
                    valueGenericTemplateSearch! < (functionCandidates -> len) and selection!.valueGenericTemplate < 0
                        -> while {
                            functionCandidates[valueGenericTemplateSearch!] => candidateIr
                            context.ir[candidateIr] => valueGenericCandidate
                            valueGenericCandidate.kind == 0
                                and valueGenericCandidate.sourceModule == call.targetModule
                                and valueGenericCandidate.symbol == call.symbol
                                -> if {
                                    selection!.first < 0 -> if { candidateIr => selection!.first }
                                    valueGenericCandidate.operand1 >= 0 -> if {
                                        context.ir[valueGenericCandidate.operand1].typeId => valueGenericExpectedId!
                                        valueGenericExpectedId! >= 0 and context.types[valueGenericExpectedId!].kind == 8
                                            -> if { context.types[valueGenericExpectedId!].first => valueGenericExpectedId! }
                                        valueGenericExpectedId! >= 0
                                            and context.types[valueGenericExpectedId!].kind == 4
                                            and context.types[valueGenericExpectedId!].length < 0
                                            and context.types[valueGenericExpectedId!].lengthHash != 0
                                            -> if { candidateIr => selection!.valueGenericTemplate }
                                    }
                                }
                            valueGenericTemplateSearch! + 1 => valueGenericTemplateSearch!
                        }
                    true => selection!.computed
                    functionsByIdentity! -> put(identity, selection!)
                }
                selection!.valueGenericTemplate => valueGenericTemplate
                valueGenericTemplate >= 0 -> if {
                    context.ir[call.operand0].typeId => valueGenericActualId!
                    valueGenericActualId! >= 0 and context.types[valueGenericActualId!].kind == 8
                        -> if { context.types[valueGenericActualId!].first => valueGenericActualId! }
                    -1 => valueGenericLength!
                    context.ranges[call.sourceModule] => valueGenericCallRange
                    context.nodes[valueGenericCallRange.astStart + call.astNode] => valueGenericCallAst
                    false => inValueGenericArguments!
                    valueGenericCallAst.firstToken => valueGenericTokenIndex!
                    valueGenericTokenIndex! < valueGenericCallAst.firstToken + valueGenericCallAst.tokenCount
                        -> while {
                            context.tokens[valueGenericCallRange.tokenStart + valueGenericTokenIndex!] => valueGenericToken
                            valueGenericToken.kind == grammar.tokenIdLess()
                                -> if { true => inValueGenericArguments! }
                            inValueGenericArguments! and valueGenericLength! < 0
                                and valueGenericToken.kind == grammar.tokenIdNumber()
                                -> if {
                                    context.sources[call.sourceModule] -> syntax.numericExtentTokenValue(valueGenericToken) => valueGenericLength!
                                }
                            valueGenericToken.kind == grammar.tokenIdGreater()
                                -> if { false => inValueGenericArguments! }
                            valueGenericTokenIndex! + 1 => valueGenericTokenIndex!
                        }
                    valueGenericActualId! >= 0 -> if {
                        context.types[valueGenericActualId!] => valueGenericActual
                        valueGenericActual.kind != 4 -> if {
                            count! + 1 => count!
                            writeDiagnostics -> if {
                                context.ranges[call.targetModule] => valueGenericTargetRange
                                context.symbols[valueGenericTargetRange.symbolStart + call.symbol] => valueGenericFunction
                                context.tokens[valueGenericTargetRange.tokenStart + valueGenericFunction.nameToken] => valueGenericNameToken
                                context.sources[call.targetModule] -> slice(valueGenericNameToken.span.start, valueGenericNameToken.span.length) => valueGenericName
                                "; sollang semantic error: value-generic function '$valueGenericName' requires a fixed array input" -> println
                            }
                        } else {
                            valueGenericLength! >= 0 and valueGenericActual.length >= 0
                                and valueGenericActual.length != valueGenericLength!
                                -> if {
                                    count! + 1 => count!
                                    writeDiagnostics -> if {
                                        "; sollang semantic error: value-generic function expects [" -> print
                                        valueGenericActual.first >= 0
                                            and context.types[valueGenericActual.first].kind == 1
                                            and context.types[valueGenericActual.first].origin == 1
                                            -> if { context.types[valueGenericActual.first].symbol -> writeNativeAbiTypeName } else { "type#$(valueGenericActual.first)" -> print }
                                        "; $(valueGenericLength!)] but received [" -> print
                                        valueGenericActual.first >= 0
                                            and context.types[valueGenericActual.first].kind == 1
                                            and context.types[valueGenericActual.first].origin == 1
                                            -> if { context.types[valueGenericActual.first].symbol -> writeNativeAbiTypeName } else { "type#$(valueGenericActual.first)" -> print }
                                        "; $(valueGenericActual.length)]" -> println
                                    }
                                }
                        }
                    }
                }
                context -> emitterContext.genericFunctionForCall(callIndex!) => functionIndex!
                functionIndex! < 0 -> if {
                    selection!.first => functionIndex!
                }
                functionIndex! >= 0 -> if {
                    context.ir[functionIndex!] => target
                    target.operand1 => parameterIndex!
                    call.operand0 => argumentIndex!
                    parameterIndex! >= 0 and argumentIndex! >= 0 -> while {
                        context.ir[parameterIndex!].typeId => expectedId!
                        context.ir[argumentIndex!].typeId => actualId!
                        expectedId! >= 0 and expectedId! < (context.types -> len) and actualId! >= 0 and actualId! < (context.types -> len)
                            -> if {
                                context.types[expectedId!].kind == 8 -> if { context.types[expectedId!].first => expectedId! }
                                context.types[actualId!].kind == 8 -> if { context.types[actualId!].first => actualId! }
                                expectedId! >= 0 and actualId! >= 0 -> if {
                                    context.types[expectedId!] => expected
                                    context.types[actualId!] => actual
                                    expected.kind == 4 and actual.kind == 4 and expected.length >= 0 and actual.length >= 0
                                        and not expected.containsParameter and not actual.containsParameter and expected.length != actual.length
                                        -> if {
                                            count! + 1 => count!
                                            writeDiagnostics -> if {
                                                "; sollang semantic error: fixed array argument expects length $(expected.length), received $(actual.length) (source $(call.sourceModule)); pass the declared fixed length" -> println
                                            }
                                        }
                                }
                            }
                        context.ir[argumentIndex!].nextOperand => argumentIndex!
                        parameterIndex! == target.operand1 -> if {
                            target.nextOperand => parameterIndex!
                        } else { context.ir[parameterIndex!].nextOperand => parameterIndex! }
                    }
                }
            }
        callIndex! + 1 => callIndex!
    }
    count!
}

initializerTypesMatch expectedId: Int, actualId: Int, context: ref emitterContext.EmitContext -> Bool {
    expectedId == actualId -> if { true -> return }
    expectedId < 0 or actualId < 0 -> if { false -> return }
    context.types[expectedId] => expected
    context.types[actualId] => actual
    expected.kind != actual.kind or expected.length != actual.length
        -> if { false -> return }
    expected.kind == 1 -> if {
        expected.module == actual.module and expected.symbol == actual.symbol
            and (expected.origin == actual.origin or (expected.origin == 0 or expected.origin == 2) and (actual.origin == 0 or actual.origin == 2)) => sameNominal
        sameNominal -> return
    }
    expected.origin != actual.origin or expected.module != actual.module or expected.symbol != actual.symbol
        -> if { false -> return }
    expected.first -> initializerTypesMatch(actual.first, context)
        and (expected.second -> initializerTypesMatch(actual.second, context))
}

writeDictionaryPutTypeName typeId: Int, context: ref emitterContext.EmitContext -> Unit uses Console {
    typeId < 0 or typeId >= (context.types -> len)
        -> if {
            "unknown type" -> print
            return
        }
    context.types[typeId] => expected
    expected.kind == 1 and expected.origin == 1 -> if {
        expected.symbol -> writeNativeAbiTypeName
        return
    }
    expected.kind == 1 and expected.module >= 0 and expected.module < (context.ranges -> len)
        -> if {
            context.ranges[expected.module] => range
            expected.symbol >= 0 and expected.symbol < range.symbolCount
                -> if {
                    context.symbols[range.symbolStart + expected.symbol] => symbol
                    symbol.nameToken >= 0 and symbol.nameToken < range.tokenCount
                        -> if {
                            context.tokens[range.tokenStart + symbol.nameToken] => name
                            context.sources[expected.module] -> slice(name.span.start, name.span.length) -> print
                            return
                        }
                }
        }
    "type#$(typeId)" -> print
}

# This semantic gate owns dictionary put argument compatibility for every
# checked target. The same scan counts and prints failures before LLVM output.
dictionaryPutArgumentDiagnostics context: ref emitterContext.EmitContext, writeDiagnostics: Bool -> Int uses Console {
    0 => failures!
    0 => nodeIndex!
    nodeIndex! < (context.ir -> len) -> while {
        context.ir[nodeIndex!] => operation
        operation.kind == 9 and (operation.opcode == -223 or operation.opcode == -303)
            and operation.operand0 >= 0 and operation.operand0 < (context.ir -> len)
            -> if {
                context.ir[operation.operand0] => receiver
                receiver.typeId => dictionaryTypeId!
                dictionaryTypeId! >= 0 and dictionaryTypeId! < (context.types -> len)
                    -> if {
                        context.types[dictionaryTypeId!] => dictionaryType!
                        dictionaryType!.kind == 8 -> if {
                            dictionaryType!.first => dictionaryTypeId!
                            dictionaryTypeId! >= 0 and dictionaryTypeId! < (context.types -> len)
                                -> if { context.types[dictionaryTypeId!] => dictionaryType! }
                        }
                        dictionaryTypeId! >= 0 and dictionaryTypeId! < (context.types -> len)
                            and (dictionaryType!.kind == 5 or dictionaryType!.kind == 13)
                            -> if {
                                operation.operand1 => keyIndex
                                -1 => valueIndex!
                                keyIndex >= 0 and keyIndex < (context.ir -> len)
                                    -> if { context.ir[keyIndex].nextOperand => valueIndex! }
                                false => arityMismatch!
                                keyIndex < 0 or keyIndex >= (context.ir -> len)
                                    or valueIndex! < 0 or valueIndex! >= (context.ir -> len)
                                    -> if { true => arityMismatch! }
                                not arityMismatch! and context.ir[valueIndex!].nextOperand >= 0
                                    -> if { true => arityMismatch! }
                                arityMismatch! -> if {
                                    failures! + 1 => failures!
                                    writeDiagnostics -> if {
                                        "; sollang semantic error: " -> print
                                        operation.opcode == -223 -> if { "put" -> print } else { "putIfAbsent" -> print }
                                        " expects key and value arguments (source $(operation.sourceModule))" -> println
                                    }
                                }
                                false => mismatch!
                                not arityMismatch! -> if {
                                    context.ir[keyIndex] => key
                                    context.ir[valueIndex!] => value
                                    key.typeId >= 0 and key.typeId < (context.types -> len)
                                        and not (dictionaryType!.first -> initializerTypesMatch(key.typeId, context))
                                        -> if { true => mismatch! }
                                    value.typeId >= 0 and value.typeId < (context.types -> len)
                                        and not (dictionaryType!.second -> initializerTypesMatch(value.typeId, context))
                                        -> if { true => mismatch! }
                                }
                                not arityMismatch! and mismatch! -> if {
                                    failures! + 1 => failures!
                                    writeDiagnostics -> if {
                                        "; sollang semantic error: " -> print
                                        operation.opcode == -223 -> if { "put" -> print } else { "putIfAbsent" -> print }
                                        " expects " -> print
                                        dictionaryType!.first -> writeDictionaryPutTypeName(context)
                                        " key and " -> print
                                        dictionaryType!.second -> writeDictionaryPutTypeName(context)
                                        " value arguments (source $(operation.sourceModule))" -> println
                                    }
                                }
                            }
                    }
            }
        nodeIndex! + 1 => nodeIndex!
    }
    failures!
}

# Contextual integer literals are checked lexically against the destination
# range, without narrowing variables or overflowing a host signed parser.
initializerIntegerLiteralStatus expectedId: Int, value: typedIr.TypedIrNode, context: ref emitterContext.EmitContext -> Int {
    # 0 = outside the destination range, 1 = valid, 2 = Unicode surrogate.
    # Preserve the reason found by the same lexical scan used for range checks.
    expectedId < 0 or value.astNode < 0 -> if { 0 -> return }
    value.kind != 3 and not (value.kind == 7 and value.opcode == grammar.tokenIdMinus() and value.operand0 >= 0 and context.ir[value.operand0].kind == 3)
        -> if { 0 -> return }
    context.types[expectedId] => expected
    expected.kind != 1 or expected.origin != 1 or expected.symbol < 2 or expected.symbol > 14
        -> if { 0 -> return }
    context.ranges[value.sourceModule] => range
    value.astNode => literalAst!
    context.nodes[range.astStart + literalAst!] => literal!
    false => negative!
    value.kind == 7 -> if {
        context.ir[value.operand0].astNode => literalAst!
        context.nodes[range.astStart + literalAst!] => literal!
        true => negative!
    }
    context.sources[value.sourceModule] => source
    source -> len => sourceLength
    literal!.start => cursor!
    literal!.start + literal!.length => end!
    literal!.length == 0 or literal!.start >= sourceLength or end! < literal!.start or end! > sourceLength
        -> if { 0 -> return }
    false => foldedLiteral!
    Long(0) => foldedValue!
    Long(1) => foldedPlace!
    (source -> byte(literal!.start)) == 39 -> if {
        syntax.SourceSpan { fileId: 0, start: literal!.start, length: literal!.length } => characterSpan
        source -> syntax.decodeCharacterLiteral(characterSpan) -> when {
            Some(character) {
                true => foldedLiteral!
                -Long(character) => foldedValue!
                0 => cursor!
                1 => end!
                foldedValue! / foldedPlace! <= -10 -> while {
                    foldedPlace! * 10 => foldedPlace!
                    end! + 1 => end!
                }
            }
            None { 0 -> return }
        }
    }
    # Expanded collection numbers retain the selector's source span. Their
    # numeric value lives in the same indexed table used by LLVM emission.
    not foldedLiteral! -> if {
        context.constantLiterals -> constantLowering.find(range.literalStart, range.literalCount, literalAst!) -> when {
            Some(folded) {
                true => foldedLiteral!
                # Keep the magnitude nonpositive so Long.min never needs negation.
                folded < 0 -> if {
                    not negative! => negative!
                    folded => foldedValue!
                } else { -folded => foldedValue! }
                0 => cursor!
                1 => end!
                foldedValue! / foldedPlace! <= -10 -> while {
                    foldedPlace! * 10 => foldedPlace!
                    end! + 1 => end!
                }
            }
            None { }
        }
    }
    source -> numericLiteralRange.integerLiteralStatus(cursor!, end!, expected.symbol, context.pointerBitWidth, negative!, foldedLiteral!, foldedValue!, foldedPlace!)
}


public analyzeNominalInitializers context: ref emitterContext.EmitContext, qualifiedPaths: ref [qualified.QualifiedResolution; ~] -> [emitterContext.InitializerDiagnostic; ~] {
    [emitterContext.InitializerDiagnostic; ~] => failures!
    # Direct numeric conversions share the contextual literal bounds and
    # surrogate classifier with nominal initializer fields and enum payloads.
    # Check only literal operands: computed values use the runtime conversion.
    0 => conversionIndex!
    conversionIndex! < (context.ir -> len) -> while {
        context.ir[conversionIndex!] => conversion
        conversion.kind == 6 and conversion.symbol == -1 and conversion.targetModule < 0
            and conversion.opcode == -1 and conversion.typeId >= 0
            and conversion.typeId < (context.types -> len)
            and conversion.typeOrigin == 1 and conversion.typeSymbol >= 2
            and conversion.typeSymbol <= 14 and conversion.operand0 >= 0
            -> if {
                conversion.operand0 => operandIndex!
                operandIndex! < (context.ir -> len) -> if {
                    context.ir[operandIndex!] => operand!
                    operand!.kind == 9 and operand!.opcode == -1 and operand!.operand0 >= 0
                        and operand!.operand0 < (context.ir -> len)
                        -> while {
                            operand!.operand0 => operandIndex!
                            context.ir[operandIndex!] => operand!
                        }
                    operand!.kind == 3 or (operand!.kind == 7
                        and operand!.opcode == grammar.tokenIdMinus()
                        and operand!.operand0 >= 0
                        and context.ir[operand!.operand0].kind == 3)
                        -> if {
                            conversion.typeId -> initializerIntegerLiteralStatus(operand!, context) => conversionLiteralStatus
                            conversionLiteralStatus != 1 -> if {
                                9 => conversionDiagnosticCode!
                                conversionLiteralStatus == 2 -> if { 11 => conversionDiagnosticCode! }
                                failures! -> push(emitterContext.InitializerDiagnostic {
                                    code: conversionDiagnosticCode!
                                    sourceModule: operand!.sourceModule
                                    astNode: operand!.astNode
                                    fieldOrdinal: conversion.typeSymbol
                                })
                            }
                        }
                }
            }
        conversionIndex! + 1 => conversionIndex!
    }
    # Resolution failures must remain semantic errors even if no executable
    # constructor survives lowering. The resolved module owns the enum lookup;
    # unrelated member and method paths do not acquire enum diagnostics.
    qualifiedPaths -> each resolution {
        (resolution.status == 2 or resolution.status == 3)
            and resolution.sourceModule >= 0 and resolution.pathAst >= 0
            and resolution.targetModule >= 0 and resolution.targetModule < (context.modules -> len)
            -> if {
                context.ranges[resolution.sourceModule] => useRange
                context.nodes[useRange.astStart + resolution.pathAst] => usePath
                -1 => previousIdentifier!
                -1 => lastIdentifier!
                usePath.firstToken => tokenIndex!
                usePath.firstToken + usePath.tokenCount => tokenEnd!
                tokenIndex! < tokenEnd! -> while {
                    context.tokens[useRange.tokenStart + tokenIndex!].kind => tokenKind
                    tokenKind == grammar.tokenIdLeftParen() or tokenKind == grammar.tokenIdLeftBrace()
                        -> if { tokenIndex! => tokenEnd! }
                    tokenKind == grammar.tokenIdIdentifier() -> if {
                        lastIdentifier! => previousIdentifier!
                        tokenIndex! => lastIdentifier!
                    }
                    tokenIndex! + 1 => tokenIndex!
                }
                context.modules[resolution.targetModule].sourceIndex => ownerSource
                context.ranges[ownerSource] => ownerRange
                false => enumOwner!
                -1 => enumOwnerSymbol!
                resolution.targetSymbol >= 0 and resolution.targetSymbol < ownerRange.symbolCount
                    -> if {
                        context.symbols[ownerRange.symbolStart + resolution.targetSymbol] => target
                        target.kind == 4 -> if {
                            true => enumOwner!
                            resolution.targetSymbol => enumOwnerSymbol!
                        }
                        target.kind == 27 and target.parent >= 0 -> if {
                            true => enumOwner!
                            target.parent => enumOwnerSymbol!
                        }
                    }
                resolution.status == 2 and previousIdentifier! >= 0
                    -> if {
                        0 => ownerIndex!
                        ownerIndex! < ownerRange.symbolCount and not enumOwner!
                            -> while {
                                context.symbols[ownerRange.symbolStart + ownerIndex!] => owner
                                owner.kind == 4 and owner.parent < 0 and owner.nameToken >= 0
                                    -> if {
                                        context -> sameFieldTokenText(resolution.sourceModule,
                                        useRange.tokenStart + previousIdentifier!, ownerSource,
                                        ownerRange.tokenStart + owner.nameToken)
                                            -> if {
                                                true => enumOwner!
                                                ownerIndex! => enumOwnerSymbol!
                                            }
                                    }
                                ownerIndex! + 1 => ownerIndex!
                            }
                    }
                false => sameLogicalModule!
                context.modules -> each callerModule {
                    callerModule.sourceIndex == resolution.sourceModule
                        and callerModule.pathHash == context.modules[resolution.targetModule].pathHash
                        -> if { true => sameLogicalModule! }
                }
                # The executable main block has the global module scope even
                # when its source file also declares a named namespace.
                resolution.pathAst => callerAncestor!
                callerAncestor! >= 0 and sameLogicalModule!
                    -> while {
                        context.nodes[useRange.astStart + callerAncestor!] => callerNode
                        callerNode.kind == 8 and context.modules[resolution.targetModule].pathHash != 0
                            -> if { false => sameLogicalModule! }
                        callerNode.parent => callerAncestor!
                    }
                enumOwner! and (resolution.status != 3 or not sameLogicalModule!)
                    -> if {
                        # Path and call-shaped AST wrappers share the same source
                        # constructor. Report its semantic failure only once.
                        false => alreadyReported!
                        failures! -> each prior {
                            prior.sourceModule == resolution.sourceModule
                                and context.nodes[useRange.astStart + prior.astNode].start == usePath.start
                                -> if { true => alreadyReported! }
                        }
                        not alreadyReported! -> if {
                            failures! -> push(emitterContext.InitializerDiagnostic {
                                code: resolution.status == 2 -> if { 6 } else { 7 }
                                sourceModule: resolution.sourceModule
                                astNode: resolution.pathAst
                                fieldOrdinal: ownerRange.symbolStart + enumOwnerSymbol!
                            })
                        }
                    }
            }
    }
    [Int; ~] => firstChild!
    [Int; ~] => nextSibling!
    0 => index!
    index! < (context.nodes -> len) -> while {
        firstChild! -> push(-1)
        nextSibling! -> push(-1)
        index! + 1 => index!
    }
    0 => sourceIndex!
    sourceIndex! < (context.ranges -> len) -> while {
        context.ranges[sourceIndex!] => range
        range.astCount - 1 => localIndex!
        localIndex! >= 0 -> while {
            range.astStart + localIndex! => globalIndex
            context.nodes[globalIndex].parent => parent
            parent >= 0 -> if {
                range.astStart + parent => globalParent
                firstChild![globalParent] => nextSibling![globalIndex]
                globalIndex => firstChild![globalParent]
            }
            localIndex! - 1 => localIndex!
        }
        sourceIndex! + 1 => sourceIndex!
    }
    [Int; ~] => firstField!
    [Int; ~] => nextField!
    [Int; ~] => seenAtLiteral!
    0 => index!
    index! < (context.types -> len) -> while {
        firstField! -> push(-1)
        index! + 1 => index!
    }
    0 => index!
    index! < (context.fields -> len) -> while {
        nextField! -> push(-1)
        seenAtLiteral! -> push(-1)
        index! + 1 => index!
    }
    (context.fields -> len) - 1 => index!
    index! >= 0 -> while {
        context.fields[index!] => field
        field.ownerType >= 0 and field.status == 0 -> if {
            firstField![field.ownerType] => nextField![index!]
            index! => firstField![field.ownerType]
        }
        index! - 1 => index!
    }
    [Int; ~] => declaredTypeByAst!
    context.nodes -> each node { declaredTypeByAst! -> push(-1) }
    context.typeReferences -> each reference {
        reference.status == 0 and reference.sourceModule >= 0 and reference.typeAst >= 0
            -> if {
                context.ranges[reference.sourceModule].astStart + reference.typeAst => declaredAst
                reference.typeId => declaredTypeByAst![declaredAst]
            }
    }
    0 => literalIndex!
    literalIndex! < (context.ir -> len) -> while {
        context.ir[literalIndex!] => literal
        # A nominal variant's declaration, not the actual payload, owns its
        # storage type. Reuse canonical initializer compatibility and scalar
        # literal bounds after unwrapping only transparent value containers.
        literal.kind == 26 and literal.targetModule >= 0
            and literal.targetModule < (context.ranges -> len) and literal.symbol >= 0
            -> if {
                context.ranges[literal.targetModule] => variantRange
                literal.symbol < variantRange.symbolCount -> if {
                    context.symbols[variantRange.symbolStart + literal.symbol] => variant
                    variant.kind == 27 and variant.typeNode >= 0 -> if {
                        declaredTypeByAst![variantRange.astStart + variant.typeNode] => payloadType
                        literal.operand0 => payloadIndex!
                        payloadIndex! >= 0 and context.ir[payloadIndex!].kind == 9
                            and context.ir[payloadIndex!].opcode == -1
                            -> while { context.ir[payloadIndex!].operand0 => payloadIndex! }
                        payloadType >= 0 and payloadIndex! >= 0 -> if {
                            context.ir[payloadIndex!] => payload
                            false => payloadOutOfRange!
                            context.types[payloadType] => declaredPayloadType
                            (payload.kind == 3 or (payload.kind == 7
                                and payload.opcode == grammar.tokenIdMinus()
                                and payload.operand0 >= 0
                                and context.ir[payload.operand0].kind == 3))
                                and declaredPayloadType.kind == 1
                                and declaredPayloadType.origin == 1
                                and declaredPayloadType.symbol >= 2
                                and declaredPayloadType.symbol <= 14
                                -> if {
                                    payloadType -> initializerIntegerLiteralStatus(payload, context) => payloadLiteralStatus
                                    payloadLiteralStatus != 1 -> if {
                                        true => payloadOutOfRange!
                                        9 => payloadDiagnosticCode!
                                        payloadLiteralStatus == 2 -> if { 11 => payloadDiagnosticCode! }
                                        failures! -> push(emitterContext.InitializerDiagnostic {
                                            code: payloadDiagnosticCode!
                                            sourceModule: payload.sourceModule
                                            astNode: payload.astNode
                                            fieldOrdinal: declaredPayloadType.symbol
                                        })
                                    }
                                }
                            not payloadOutOfRange!
                                and not (payloadType -> initializerTypesMatch(payload.typeId, context))
                                and (payloadType -> initializerIntegerLiteralStatus(payload, context)) != 1
                                -> if {
                                    failures! -> push(emitterContext.InitializerDiagnostic {
                                        code: 8
                                        sourceModule: literal.sourceModule
                                        astNode: payload.astNode
                                        fieldOrdinal: literalIndex!
                                    })
                                }
                        }
                    }
                }
            }
        literal.kind == 12 and literal.typeId >= 0 and literal.astNode >= 0 and literal.sourceModule >= 0
            -> if {
                context.ranges[literal.sourceModule] => range
                range.astStart + literal.astNode => globalLiteral
                context.nodes[globalLiteral] => literalSyntax
                literalSyntax.kind == 39 or literalSyntax.kind == 38
                    -> if {
                        0 => initialized!
                        firstChild![globalLiteral] => initializerIndex!
                        literal.operand0 => valueIndex!
                        initializerIndex! >= 0 -> while {
                            context.nodes[initializerIndex!] => initializer
                            -1 => contextualValueAst!
                            initializer.kind == 40 or literalSyntax.kind == 38
                                -> if {
                                    initialized! + 1 => initialized!
                                    literalSyntax.kind == 38 -> if {
                                        nextSibling![initializerIndex!] => contextualValueAst!
                                        initializer.kind != 15 -> if {
                                            failures! -> push(emitterContext.InitializerDiagnostic {
                                                code: 10
                                                sourceModule: literal.sourceModule
                                                astNode: initializerIndex! - range.astStart
                                                fieldOrdinal: literal.typeId
                                            })
                                        }
                                    }
                                    # Operand links are canonical field order; locate the value
                                    # by its initializer AST identity, independent of source order.
                                    -1 => valueIndex!
                                    literal.operand0 => valueSearch!
                                    valueSearch! >= 0 and valueIndex! < 0 -> while {
                                        context.ir[valueSearch!].astNode => valueAst!
                                        literalSyntax.kind == 39 -> if {
                                            valueAst! >= 0 and valueAst! != literal.astNode
                                                and context.nodes[range.astStart + valueAst!].kind != 40
                                                -> while {
                                                    context.nodes[range.astStart + valueAst!].parent => valueAst!
                                                }
                                        } else {
                                            valueAst! >= 0 and valueAst! != literal.astNode
                                                and context.nodes[range.astStart + valueAst!].parent != literal.astNode
                                                -> while {
                                                    context.nodes[range.astStart + valueAst!].parent => valueAst!
                                                }
                                        }
                                        (literalSyntax.kind == 39 and valueAst! >= 0 and range.astStart + valueAst! == initializerIndex!)
                                            or (literalSyntax.kind == 38 and valueAst! == contextualValueAst!)
                                            -> if { valueSearch! => valueIndex! }
                                        context.ir[valueSearch!].nextOperand => valueSearch!
                                    }
                                    -1 => matched!
                                    firstField![literal.typeId] => fieldIndex!
                                    fieldIndex! >= 0 and matched! < 0 -> while {
                                        context.fields[fieldIndex!] => field
                                        field.fieldSymbol >= 0 -> if {
                                            context.ranges[field.sourceModule] => fieldRange
                                            context.symbols[fieldRange.symbolStart + field.fieldSymbol] => fieldSymbol
                                            context -> sameFieldTokenText(literal.sourceModule, range.tokenStart + initializer.payloadToken,
                                            field.sourceModule, fieldRange.tokenStart + fieldSymbol.nameToken)
                                                -> if { fieldIndex! => matched! }
                                        }
                                        nextField![fieldIndex!] => fieldIndex!
                                    }
                                    matched! < 0 and (literalSyntax.kind == 39 or initializer.kind == 15)
                                        -> if {
                                            failures! -> push(emitterContext.InitializerDiagnostic { code: 1, sourceModule: literal.sourceModule, astNode: initializerIndex! - range.astStart, fieldOrdinal: -1 })
                                        }
                                    matched! >= 0 -> if {
                                        context.fields[matched!] => field
                                        seenAtLiteral![matched!] == literalIndex! -> if {
                                            failures! -> push(emitterContext.InitializerDiagnostic { code: 2, sourceModule: literal.sourceModule, astNode: initializerIndex! - range.astStart, fieldOrdinal: field.ordinal })
                                        }
                                        literalIndex! => seenAtLiteral![matched!]
                                        valueIndex! >= 0 -> if {
                                            context.ir[valueIndex!] => value
                                            value.typeId >= 0 and field.fieldType >= 0 -> if {
                                                context.types[field.fieldType] => declaredFieldType
                                                (value.kind == 3 or (value.kind == 7 and value.opcode == grammar.tokenIdMinus()
                                                    and value.operand0 >= 0 and context.ir[value.operand0].kind == 3))
                                                    and declaredFieldType.kind == 1 and declaredFieldType.origin == 1
                                                    and declaredFieldType.symbol >= 2 and declaredFieldType.symbol <= 14
                                                    -> if {
                                                        field.fieldType -> initializerIntegerLiteralStatus(value, context) => fieldLiteralStatus
                                                        fieldLiteralStatus != 1
                                                            -> if {
                                                                9 => fieldDiagnosticCode!
                                                                fieldLiteralStatus == 2 -> if { 11 => fieldDiagnosticCode! }
                                                                failures! -> push(emitterContext.InitializerDiagnostic { code: fieldDiagnosticCode!, sourceModule: value.sourceModule, astNode: value.astNode, fieldOrdinal: declaredFieldType.symbol })
                                                            }
                                                    } else {
                                                        not (field.fieldType -> initializerTypesMatch(value.typeId, context))
                                                            -> if {
                                                                failures! -> push(emitterContext.InitializerDiagnostic { code: 3, sourceModule: literal.sourceModule, astNode: initializerIndex! - range.astStart, fieldOrdinal: field.ordinal })
                                                            }
                                                    }
                                            }
                                        }
                                    }
                                    valueIndex! >= 0 -> if { context.ir[valueIndex!].nextOperand => valueIndex! }
                                }
                            literalSyntax.kind == 38 and contextualValueAst! >= 0
                                -> if {
                                    nextSibling![contextualValueAst!] => initializerIndex!
                                } else {
                                    nextSibling![initializerIndex!] => initializerIndex!
                                }
                        }
                        0 => declared!
                        firstField![literal.typeId] => fieldIndex!
                        fieldIndex! >= 0 -> while {
                            declared! + 1 => declared!
                            nextField![fieldIndex!] => fieldIndex!
                        }
                        initialized! != declared! -> if {
                            failures! -> push(emitterContext.InitializerDiagnostic { code: 4, sourceModule: literal.sourceModule, astNode: literal.astNode, fieldOrdinal: -1 })
                        }
                    }
            }
        # Reuse the cached initializer pass and scalar bounds authority. Array
        # contextual typing can already have assigned the target type, so
        # matching type IDs do not prove that the source integer fits.
        literal.kind == 14 and literal.typeId >= 0
            and literal.typeId < (context.types -> len)
            and literal.operand0 >= 0 -> if {
                context.types[literal.typeId] => arrayType!
                arrayType!.kind == 8 and arrayType!.first >= 0
                    -> if { context.types[arrayType!.first] => arrayType! }
                (arrayType!.kind == 2 or arrayType!.kind == 3
                    or arrayType!.kind == 4 or arrayType!.kind == 12)
                    and arrayType!.first >= 0 -> if {
                        context.types[arrayType!.first] => elementType
                        elementType.kind == 1 and elementType.origin == 1
                            and elementType.symbol >= 2 and elementType.symbol <= 14
                            -> if {
                                literal.operand0 => elementIndex!
                                0 => ordinal!
                                elementIndex! >= 0 -> while {
                                    context.ir[elementIndex!] => value
                                    (value.kind == 3
                                        or (value.kind == 7 and value.opcode == grammar.tokenIdMinus()
                                        and value.operand0 >= 0 and context.ir[value.operand0].kind == 3))
                                        and (arrayType!.first -> initializerIntegerLiteralStatus(value, context)) != 1
                                        -> if {
                                            failures! -> push(emitterContext.InitializerDiagnostic {
                                                code: 5
                                                sourceModule: value.sourceModule
                                                astNode: value.astNode
                                                fieldOrdinal: ordinal!
                                            })
                                        }
                                    value.nextOperand => elementIndex!
                                    ordinal! + 1 => ordinal!
                                }
                            }
                    }
            }
        literalIndex! + 1 => literalIndex!
    }
    failures!
}

enumFailureOwnsUnknownCall context: ref emitterContext.EmitContext, failure: emitterContext.InitializerDiagnostic -> Bool {
    context.bindingDeclarationDiagnostic => binding
    binding.code != 2 or failure.code != 6 or failure.sourceModule != binding.sourceModule
        -> if { false -> return }
    context.ranges[binding.sourceModule] => range
    context.nodes[range.astStart + binding.valueAst] => call
    context.nodes[range.astStart + failure.astNode] => path
    call.kind != 11 or path.start != call.start -> if { false -> return }
    path.kind == 36 and path.length == call.length
        -> if { true -> return }
    failure.astNode => ancestor!
    ancestor! >= 0 -> while {
        ancestor! == binding.valueAst -> if { true -> return }
        context.nodes[range.astStart + ancestor!].parent => ancestor!
    }
    false
}

emitInitializerSemanticPrefix context: ref emitterContext.EmitContext, sourceModule: Int, valueAst: Int -> Unit uses Console {
    context.ranges[sourceModule] => range
    context.nodes[range.astStart + valueAst] => value
    context -> emitInitializerSemanticPrefixAtOffset(sourceModule, valueAst, value.start)
}

emitInitializerSemanticPrefixAtOffset context: ref emitterContext.EmitContext, sourceModule: Int, valueAst: Int, offset: UIntSize -> Unit uses Console {
    context.ranges[sourceModule] => range
    context.sources[sourceModule] -> syntaxDiagnostics.sourceLocation(offset) => location
    "<main>" => moduleName!
    not (context.nodes -> semanticDiagnostics.expressionBelongsToMain(range, valueAst))
        -> if {
            context.modules[sourceModule] => identity
            identity.pathLength > 0 -> if {
                context.sources[sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
            }
        }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] " -> print
}

emitNominalDeclarationName context: ref emitterContext.EmitContext, declarationIndex: Int -> Unit uses Console {
    context.symbols[declarationIndex] => declaration
    context.ranges -> each range {
        declarationIndex >= range.symbolStart and declarationIndex < range.symbolStart + range.symbolCount
            -> if {
                context.modules -> each identity {
                    identity.sourceIndex == range.sourceModule and identity.pathLength > 0
                        -> if {
                            context.sources[range.sourceModule] -> slice(identity.pathStart, identity.pathLength) -> print
                            "." -> print
                        }
                }
                context.tokens[range.tokenStart + declaration.nameToken] => name
                context.sources[range.sourceModule] -> slice(name.span.start, name.span.length) -> print
            }
    }
}

emitEnumInitializerDiagnostic context: ref emitterContext.EmitContext, failure: emitterContext.InitializerDiagnostic -> Unit uses Console {
    context -> emitInitializerSemanticPrefix(failure.sourceModule, failure.astNode)
    context.ranges[failure.sourceModule] => range
    failure.code == 6 -> if {
        "enum '" -> print
        context -> emitNominalDeclarationName(failure.fieldOrdinal)
        context.nodes[range.astStart + failure.astNode] => path
        -1 => lastIdentifier!
        path.firstToken => tokenIndex!
        path.firstToken + path.tokenCount => tokenEnd!
        tokenIndex! < tokenEnd! -> while {
            context.tokens[range.tokenStart + tokenIndex!].kind => tokenKind
            tokenKind == grammar.tokenIdLeftParen() or tokenKind == grammar.tokenIdLeftBrace()
                -> if { tokenIndex! => tokenEnd! }
            tokenKind == grammar.tokenIdIdentifier()
                -> if { tokenIndex! => lastIdentifier! }
            tokenIndex! + 1 => tokenIndex!
        }
        context.tokens[range.tokenStart + lastIdentifier!] => member
        context.sources[failure.sourceModule] -> slice(member.span.start, member.span.length) => memberName
        "' has no variant '$memberName'" -> println
        return
    }
    context.ir[failure.fieldOrdinal] => constructor
    context.ranges[constructor.targetModule] => variantRange
    context.symbols[variantRange.symbolStart + constructor.symbol] => variant
    "variant '" -> print
    context -> emitNominalDeclarationName(variantRange.symbolStart + variant.parent)
    context.tokens[variantRange.tokenStart + variant.nameToken] => variantName
    "." -> print
    context.sources[constructor.targetModule] -> slice(variantName.span.start, variantName.span.length) -> print
    "' expects " -> print
    -1 => expectedType!
    context.typeReferences -> each reference {
        reference.status == 0 and reference.sourceModule == constructor.targetModule
            and reference.typeAst == variant.typeNode -> if { reference.typeId => expectedType! }
    }
    expectedType! -> emitBoxOperandTypeName(context)
    ", got " -> print
    constructor.operand0 => payloadIndex!
    context.ir[payloadIndex!].kind == 9 and context.ir[payloadIndex!].opcode == -1
        and context.ir[payloadIndex!].operand0 >= 0
        -> while { context.ir[payloadIndex!].operand0 => payloadIndex! }
    context.ir[payloadIndex!].typeId -> emitBoxOperandTypeName(context)
    "" -> println
}

emitNominalInitializerDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    context.nominalFieldMismatch => mismatch
    mismatch.sourceModule >= 0 -> if {
        context.ranges[mismatch.sourceModule] => range
        context.nodes[range.astStart + mismatch.valueAst] => value
        context.sources[mismatch.sourceModule] -> syntaxDiagnostics.sourceLocation(value.start) => location
        context.fields[mismatch.fieldIndex] => field
        context.ranges[field.sourceModule] => fieldRange
        context.symbols[fieldRange.symbolStart + field.fieldSymbol] => fieldSymbol
        context.tokens[fieldRange.tokenStart + fieldSymbol.nameToken] => nameToken
        context.sources[field.sourceModule] -> slice(nameToken.span.start, nameToken.span.length) => fieldName
        "<main>" => moduleName!
        context.nodes -> semanticDiagnostics.expressionBelongsToMain(range, mismatch.valueAst) => inMain
        not inMain and context.modules[mismatch.sourceModule].pathLength > 0
            -> if {
                context.modules[mismatch.sourceModule] => identity
                context.sources[mismatch.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
            }
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] field '$fieldName' expects " -> print
        field.fieldType -> emitBoxOperandTypeName(context)
        ", got " -> print
        mismatch.actualTypeId -> emitBoxOperandTypeName(context)
        println() -> return
    }
    context.initializerDiagnostics -> each failure {
        failure.code == 1 -> if {
            context.ranges[failure.sourceModule] => range
            context.nodes[range.astStart + failure.astNode] => initializer
            context.tokens[range.tokenStart + initializer.payloadToken] => token
            context.sources[failure.sourceModule] -> slice(token.span.start, token.span.length) => name
            "; sollang semantic error: unknown struct initializer field '$name' (source $(failure.sourceModule)); use a declared field name" -> println
        }
        failure.code == 2 -> if {
            "; sollang semantic error: duplicate struct initializer field (source $(failure.sourceModule)); initialize each declared field exactly once" -> println
        }
        failure.code == 10 -> if {
            context.types[failure.fieldOrdinal] => ownerType
            context.ranges[ownerType.module] => ownerRange
            context.symbols[ownerRange.symbolStart + ownerType.symbol] => ownerSymbol
            context.tokens[ownerRange.tokenStart + ownerSymbol.nameToken] => ownerNameToken
            context.sources[ownerType.module] -> slice(ownerNameToken.span.start, ownerNameToken.span.length) => ownerName
            "; sollang semantic error: contextual $ownerName literal field name must be an identifier (source $(failure.sourceModule)); use a declared field identifier" -> println
        }
        failure.code == 3 -> if {
            context.ranges[failure.sourceModule] => range
            context.nodes[range.astStart + failure.astNode] => initializer
            "; sollang semantic error: struct initializer field type mismatch (source $(failure.sourceModule), field $(failure.fieldOrdinal)); match the declared field type and ownership; source span byte $(initializer.start), length $(initializer.length)" -> println
        }
        failure.code == 4 -> if {
            "; sollang semantic error: struct initializer field count mismatch (source $(failure.sourceModule)); initialize each declared field exactly once" -> println
        }
        failure.code == 9 or failure.code == 11 -> if {
            context.ranges[failure.sourceModule] => range
            context.nodes[range.astStart + failure.astNode] => literal
            context.sources[failure.sourceModule] -> slice(literal.start, literal.length) => spelling
            "; sollang semantic error: numeric literal " -> print
            UIntSize(0) => spellingIndex!
            spellingIndex! < (spelling -> len) -> while {
                (spelling -> byte(spellingIndex!)) != 95 -> if {
                    spelling -> slice(spellingIndex!, 1) -> print
                }
                spellingIndex! + 1 => spellingIndex!
            }
            failure.code == 11 -> if {
                " is a Unicode surrogate and cannot be a CodePoint" -> println
            } else {
                " is out of range for " -> print
                failure.fieldOrdinal -> writeNativeAbiTypeName
                " (" -> print
                failure.fieldOrdinal -> writeNativeIntegerTypeBounds(context.pointerBitWidth)
                ")" -> println
            }
        }
        failure.code == 5 -> if {
            "; sollang semantic error: contextual array integer literal is out of range (source $(failure.sourceModule), element $(failure.fieldOrdinal)); use a literal within the element type bounds" -> println
        }
        failure.code >= 6 and failure.code <= 8 -> if {
            context.ranges[failure.sourceModule] => range
            context.nodes[range.astStart + failure.astNode] => initializer
            failure.code == 6 -> if {
                context -> emitEnumInitializerDiagnostic(failure)
            }
            failure.code == 7 -> if {
                "; sollang semantic error: enum constructor is not public (source $(failure.sourceModule), byte $(initializer.start)); use an exported enum from this module" -> println
            }
            failure.code == 8 -> if {
                context -> emitEnumInitializerDiagnostic(failure)
            }
        }
    }
}

invalidArrayElementLayout typeId: Int, context: ref emitterContext.EmitContext -> Bool {
    # Declared fields and contextual literals can contain owning arrays. Their
    # descriptors and inline values have layouts even where ordinary source
    # signatures reject the same shape. Source admission owns that distinction.
    typeId < 0 or typeId >= (context.types -> len)
        -> if { false -> return }
    context.types[typeId] => outer
    (outer.kind == 2 or outer.kind == 3 or outer.kind == 4 or outer.kind == 12)
        and outer.first >= 0 and outer.first < (context.types -> len)
        -> unless { false -> return }
    context.types[outer.first] => element
    element.kind == 1 and element.origin == 1 and element.symbol == 0
}

appendArrayElementLayoutType typeId: Int, used: mut [Bool; ~], pending: mut [Int; ~] -> Unit {
    typeId >= 0 and typeId < (used -> len) and not used[typeId]
        -> if {
            true => used[typeId]
            pending -> push(typeId)
        }
}

arrayElementLayoutTypeUses context: ref emitterContext.EmitContext -> [Bool; ~] {
    # Interning retains provisional inference types. Only committed declarations,
    # final IR and their type/field dependencies own element-layout decisions.
    [Bool; ~] => used!
    [Int; ~] => pending!
    [Int; ~] => fieldHeads!
    context.types -> each type {
        used! -> push(false)
        fieldHeads! -> push(-1)
    }
    [Int; ~] => fieldNext!
    0 => fieldIndex!
    fieldIndex! < (context.fields -> len) -> while {
        context.fields[fieldIndex!] => field
        fieldNext! -> push(-1)
        field.ownerType >= 0 and field.ownerType < (fieldHeads! -> len)
            -> if {
                fieldHeads![field.ownerType] => fieldNext![fieldIndex!]
                fieldIndex! => fieldHeads![field.ownerType]
            }
        fieldIndex! + 1 => fieldIndex!
    }
    context.typeReferences -> each reference {
        reference.typeId -> appendArrayElementLayoutType(used!, pending!)
    }
    context.ir -> each node {
        node.typeId -> appendArrayElementLayoutType(used!, pending!)
    }
    0 => cursor!
    cursor! < (pending! -> len) -> while {
        pending![cursor!] => currentTypeId
        context.types[currentTypeId] => current
        current.kind == 2 or current.kind == 3 or current.kind == 4
            or current.kind == 5 or current.kind == 6 or current.kind == 7
            or current.kind == 8 or current.kind == 12 or current.kind == 13
            -> if { current.first -> appendArrayElementLayoutType(used!, pending!) }
        current.kind == 5 or current.kind == 7 or current.kind == 13
            -> if { current.second -> appendArrayElementLayoutType(used!, pending!) }
        fieldHeads![currentTypeId] => currentField!
        currentField! >= 0 -> while {
            context.fields[currentField!].fieldType
                -> appendArrayElementLayoutType(used!, pending!)
            fieldNext![currentField!] => currentField!
        }
        cursor! + 1 => cursor!
    }
    used!
}

arrayElementLayoutDiagnosticCount context: ref emitterContext.EmitContext -> Int {
    context -> arrayElementLayoutTypeUses => used
    0 => count!
    0 => typeIndex!
    typeIndex! < (context.types -> len) -> while {
        used[typeIndex!] and (typeIndex! -> invalidArrayElementLayout(context))
            -> if { count! + 1 => count! }
        typeIndex! + 1 => typeIndex!
    }
    count!
}

# The layout invariant also sees inferred and cached types. Only an explicit
# typed-empty value owns the constructor location used by the source diagnostic.
typedEmptyArrayLayoutDiagnosticSource typeId: Int, context: ref emitterContext.EmitContext -> Int {
    -1 => selected!
    -1 => selectedModule!
    UIntSize(0) => selectedStart!
    0 => irIndex!
    irIndex! < (context.ir -> len) -> while {
        context.ir[irIndex!] => node
        node.typeId == typeId and node.sourceModule >= 0
            and node.sourceModule < (context.ranges -> len) and node.astNode >= 0
            -> if {
                context.ranges[node.sourceModule] => range
                node.astNode < range.astCount -> if {
                    context.nodes[range.astStart + node.astNode] => literal
                    literal.kind == 37 and literal.tokenCount > 0
                        -> if {
                            false => explicitType!
                            0 => childIndex!
                            childIndex! < range.astCount and not explicitType!
                                -> while {
                                    context.nodes[range.astStart + childIndex!] => child
                                    child.parent == node.astNode and (child.kind == 12 or child.kind == 16)
                                        -> if { true => explicitType! }
                                    childIndex! + 1 => childIndex!
                                }
                            explicitType! and (selected! < 0 or node.sourceModule < selectedModule!
                                or (node.sourceModule == selectedModule! and literal.start < selectedStart!))
                                -> if {
                                    irIndex! => selected!
                                    node.sourceModule => selectedModule!
                                    literal.start => selectedStart!
                                }
                        }
                }
            }
        irIndex! + 1 => irIndex!
    }
    selected!
}

emitArrayElementLayoutDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    context -> arrayElementLayoutTypeUses => used
    0 => typeIndex!
    typeIndex! < (context.types -> len) -> while {
        used[typeIndex!] and (typeIndex! -> invalidArrayElementLayout(context))
            -> if {
                context.types[typeIndex!] => invalidArray
                typeIndex! -> typedEmptyArrayLayoutDiagnosticSource(context) => sourceIr
                sourceIr >= 0 -> if {
                    context.ir[sourceIr] => sourceNode
                    context.ranges[sourceNode.sourceModule] => range
                    context.nodes[range.astStart + sourceNode.astNode] => literal
                    literal.firstToken => tokenIndex!
                    tokenIndex! < literal.firstToken + literal.tokenCount
                        -> while {
                            context.tokens[range.tokenStart + tokenIndex!] => token
                            token.kind != grammar.triviaIdWhitespace() and token.kind != grammar.triviaIdComment()
                                and token.kind != grammar.tokenIdNewLine() -> if { break }
                            tokenIndex! + 1 => tokenIndex!
                        }
                    context.tokens[range.tokenStart + tokenIndex!] => name
                    context.sources[sourceNode.sourceModule] => source
                    context.modules[sourceNode.sourceModule] => identity
                    "<main>" => moduleName!
                    identity.pathLength > 0 -> if {
                        source -> slice(identity.pathStart, identity.pathLength) => moduleName!
                    }
                    17 => code!
                    invalidArray.kind == 3 -> if { 18 => code! }
                    invalidArray.kind == 4 -> if { 19 => code! }
                    invalidArray.kind == 12 -> if { 20 => code! }
                    source -> emitSignatureTypeDiagnosticForSource(moduleName!, name, "", code!)
                } else {
                    invalidArray.kind == 2 -> if {
                        "; sollang semantic error: readonly array views require inline scalar or user-value elements" -> println
                    }
                    invalidArray.kind == 3 -> if {
                        "; sollang semantic error: growable array elements must have a supported inline value layout" -> println
                    }
                    invalidArray.kind == 4 -> if {
                        "; sollang semantic error: fixed array elements must be inline scalar or user values" -> println
                    }
                    invalidArray.kind == 12 -> if {
                        "; sollang semantic error: bounded array elements must be inline scalar or user values" -> println
                    }
                }
            }
        typeIndex! + 1 => typeIndex!
    }
}

emitUnresolvedMutableNameDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    0 => index!
    index! < (context.unresolvedMutableNames -> len)
        -> while {
            context.unresolvedMutableNames[index!] => diagnostic
            context.sources[diagnostic.sourceModule]
                -> slice(diagnostic.span.start, diagnostic.span.length) => name
            diagnostic.ownInitializer -> if {
                "; sollang semantic error: unknown binding '$name' (source $(diagnostic.sourceModule), byte $(diagnostic.span.start), length $(diagnostic.span.length)); a binding is not visible inside its own initializer; initialize it from an earlier binding or a different value" -> println
            } else {
                "; sollang semantic error: unknown binding '$name' (source $(diagnostic.sourceModule), byte $(diagnostic.span.start), length $(diagnostic.span.length)); a mutable local read must retain '!'" -> println
            }
            index! + 1 => index!
        }
}

public emitConsumedBindingReadDiagnostic context: ref emitterContext.EmitContext, diagnostic: semanticDiagnostics.ConsumedBindingReadDiagnostic -> Unit uses Console {
    context.sources[diagnostic.sourceModule]
        -> slice(diagnostic.span.start, diagnostic.span.length) => name
    context.sources[diagnostic.sourceModule]
        -> syntaxDiagnostics.sourceLocation(diagnostic.span.start) => location
    "<main>" => moduleName!
    context.ranges[diagnostic.sourceModule] => sourceRange
    false => inMain!
    diagnostic.astNode >= 0 and diagnostic.astNode < sourceRange.astCount
        -> if {
            context.nodes -> semanticDiagnostics.expressionBelongsToMain(sourceRange, diagnostic.astNode) => inMain!
        }
    not inMain! and context.modules[diagnostic.sourceModule].pathLength > 0
        -> if {
            context.modules[diagnostic.sourceModule] => identity
            context.sources[diagnostic.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
        }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] unknown binding '$name'; check its spelling and lexical scope. If the value was consumed by a move input, use the owner returned by that call, borrow it before the move, or create a new owner before reuse" -> println
}

emitConsumedBindingReadDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    context.consumedBindingReads -> each diagnostic {
        context -> emitConsumedBindingReadDiagnostic(diagnostic)
    }
}

# The flat literal operand chain contains one key and one value per entry.
# Validate it before LLVM output; opcode is the explicit capacity hint, not
# permission to discard populated operands.
boundedDictionaryInitializerDiagnostics context: ref emitterContext.EmitContext, writeDiagnostics: Bool -> Int uses Console {
    0 => failures!
    0 => nodeIndex!
    nodeIndex! < (context.ir -> len) -> while {
        context.ir[nodeIndex!] => literal
        literal.kind == 16 and literal.typeKind == 13
            -> if {
                literal.opcode => capacity!
                capacity! < 0 and literal.typeId >= 0 and literal.typeId < (context.types -> len)
                    -> if { context.types[literal.typeId].length => capacity! }
                0 => operandCount!
                literal.operand0 => operandIndex!
                false => malformed!
                operandIndex! < -1 -> if { true => malformed! }
                0 => steps!
                operandIndex! >= 0 and steps! < (context.ir -> len)
                    -> while {
                        operandIndex! >= (context.ir -> len) -> if {
                            true => malformed!
                            -1 => operandIndex!
                        } else {
                            operandCount! + 1 => operandCount!
                            context.ir[operandIndex!].nextOperand => operandIndex!
                        }
                        steps! + 1 => steps!
                    }
                operandIndex! != -1 or operandCount! % 2 != 0
                    -> if { true => malformed! }
                malformed! or capacity! <= 0 or operandCount! / 2 > capacity!
                    -> if {
                        failures! + 1 => failures!
                        writeDiagnostics -> if {
                            malformed! -> if {
                                "; sollang semantic error: bounded dictionary initializer has an invalid key/value operand chain (source $(literal.sourceModule))" -> println
                            } else {
                                "; sollang semantic error: bounded dictionary capacity must be positive and at least the initializer count (source $(literal.sourceModule))" -> println
                            }
                        }
                    }
            }
        nodeIndex! + 1 => nodeIndex!
    }
    failures!
}

public codePointNumericDiagnostics context: ref emitterContext.EmitContext, writeDiagnostics: Bool -> Int uses Console {
    0 => failures!
    0 => nodeIndex!
    nodeIndex! < (context.ir -> len) -> while {
        context.ir[nodeIndex!] => node
        node.kind == 6 and node.symbol == -1 and node.targetModule < 0
            and node.typeOrigin == 1 and node.typeSymbol == 14
            and node.operand0 >= 0 and node.operand0 < (context.ir -> len)
            -> if {
                context.ir[node.operand0] => argument
                argument.typeOrigin == 1 and argument.typeSymbol >= 19 and argument.typeSymbol <= 22
                    -> if {
                        failures! + 1 => failures!
                        writeDiagnostics -> if {
                            "; sollang semantic error: CodePoint conversion requires an integer Unicode scalar value" -> println
                        }
                    }
            }
        node.kind == 8 and node.operand0 >= 0 and node.operand0 < (context.ir -> len)
            and context.ir[node.operand0].typeOrigin == 1
            and context.ir[node.operand0].typeSymbol == 14
            and (node.opcode == grammar.tokenIdPlus()
            or node.opcode == grammar.tokenIdMinus()
            or node.opcode == grammar.tokenIdStar()
            or node.opcode == grammar.tokenIdSlash()
            or node.opcode == grammar.tokenIdPercent())
            -> if {
                failures! + 1 => failures!
                writeDiagnostics -> if {
                    "+" => operatorName!
                    node.opcode == grammar.tokenIdMinus() -> if { "-" => operatorName! }
                    node.opcode == grammar.tokenIdStar() -> if { "*" => operatorName! }
                    node.opcode == grammar.tokenIdSlash() -> if { "/" => operatorName! }
                    node.opcode == grammar.tokenIdPercent() -> if { "%" => operatorName! }
                    "; sollang semantic error: CodePoint does not support '$(operatorName!)'; convert it to UInt32 before arithmetic" -> println
                }
            }
        nodeIndex! + 1 => nodeIndex!
    }
    failures!
}

emitInterpolationCallArgumentDiagnostic context: ref emitterContext.EmitContext, nodeIndex: Int -> Unit uses Console {
    context.interpolationCallArgumentDiagnosticByNode[nodeIndex] => diagnostic
    diagnostic.code == 0 -> if { return }
    syntaxDiagnostics.SourceLocation { line: diagnostic.line, column: diagnostic.column } => location
    context -> emitInterpolationSemanticPrefixAt(diagnostic.callNode, diagnostic.sourceModule, location)
    diagnostic.code == 2 -> if {
        context.types[diagnostic.expectedTypeId].symbol -> typeIds.canonicalBuiltinSymbol => symbol
        "numeric literal " -> print
        context -> emitInterpolationNumericLiteralValue(diagnostic.literalNode, diagnostic.sourceModule)
        " is out of range for " -> print
        diagnostic.literalTargetSymbol >= 0
            -> if { diagnostic.literalTargetSymbol -> writeNativeAbiTypeName } else {
                diagnostic.expectedTypeId -> emitBoxOperandTypeName(context)
            }
        symbol == 20 or symbol == 21 -> if { println() } else {
            symbol -> numericLiteralRange.minimumText(context.pointerBitWidth) => minimum
            symbol -> numericLiteralRange.maximumText(context.pointerBitWidth) => maximum
            " ($minimum..$maximum)" -> println
        }
        return
    }
    context.ranges[diagnostic.targetSourceModule] => functionRange
    context.symbols[functionRange.symbolStart + diagnostic.functionSymbol] => functionSymbol
    context.tokens[functionRange.tokenStart + functionSymbol.nameToken] => functionToken
    "function '" -> print
    not modules.sameLogicalSource(context.sources, context.modules, diagnostic.sourceModule, diagnostic.targetSourceModule, context.tokens, context.ranges)
        and context.modules[diagnostic.targetSourceModule].pathLength > 0
        -> if {
            context.modules[diagnostic.targetSourceModule] => identity
            context.sources[diagnostic.targetSourceModule] -> slice(identity.pathStart, identity.pathLength) -> print
            "." -> print
        }
    context.sources[diagnostic.targetSourceModule] -> slice(functionToken.span.start, functionToken.span.length) -> print
    "' " -> print
    diagnostic.parameterOrdinal > 0 -> if {
        context.symbols[functionRange.symbolStart + diagnostic.parameterSymbol] => parameterSymbol
        context.tokens[functionRange.tokenStart + parameterSymbol.nameToken] => parameterToken
        "parameter '" -> print
        context.sources[diagnostic.targetSourceModule] -> slice(parameterToken.span.start, parameterToken.span.length) -> print
        "' " -> print
    }
    "expects " -> print
    diagnostic.expectedTypeId -> emitBoxOperandTypeName(context)
    " but received " -> print
    diagnostic.actualTypeId -> emitBoxOperandTypeName(context)
    println()
}

globalFunctionAliasAdmissionDiagnostics context: ref emitterContext.EmitContext, writeDiagnostics: Bool -> Int uses Console {
    context.globalFunctionAliasDiagnostic => diagnostic
    diagnostic.code == 0 -> if { 0 -> return }
    context.expressionOperandDiagnostic.code => declarationCode
    declarationCode == 44 or declarationCode == 45 or declarationCode == 46 or declarationCode == 49
        -> if {
            writeDiagnostics -> if { context -> emitExpressionOperandDiagnostics }
            1 -> return
        }
    context -> traitSignatureDiagnostics(writeDiagnostics) => traitFailures
    traitFailures > 0 -> if { traitFailures -> return }
    writeDiagnostics -> if {
        "<main>" => moduleName!
        diagnostic.contextSourceModule >= 0 -> if {
            context.modules[diagnostic.contextSourceModule] => identity
            identity.pathLength > 0 -> if {
                context.sources[diagnostic.contextSourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
            }
        }
        diagnostic.code == 1 -> if {
            diagnostic.marker -> calls.globalFunctionAliasModule => targetModule
            diagnostic.marker -> calls.canonicalGlobalFunctionAliasName => targetName
            "sollang: semantic error at 0:0: [module '$(moduleName!)'] standard library function '$targetModule.$targetName' was not loaded" -> println
        } else {
            context.ranges[diagnostic.targetSourceModule] => range
            context.symbols[range.symbolStart + diagnostic.functionSymbol] => target
            context.tokens[range.tokenStart + target.nameToken] => token
            context.sources[diagnostic.targetSourceModule] -> syntaxDiagnostics.sourceLocation(token.span.start) => location
            diagnostic.marker -> calls.globalFunctionAliasName => name
            "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] global import alias '$name' conflicts with an existing function" -> println
        }
    }
    1
}

# Declaration duplicates precede body binding, but retain an earlier
# invalid signature. Compare source order and token locations, not IR order.
duplicateFunctionPrecedesSignature context: ref emitterContext.EmitContext -> Bool {
    context.expressionOperandDiagnostic => diagnostic
    diagnostic.code != 73 -> if { false -> return }
    context.signatureTypeDiagnostic => signature
    signature.sourceModule < 0 -> if { true -> return }
    diagnostic.sourceModule != signature.sourceModule
        -> if {
            diagnostic.sourceModule < signature.sourceModule -> return
        }
    context.ranges[signature.sourceModule] => range
    context.tokens[range.tokenStart + signature.nameToken] => token
    diagnostic.locationOffset <= token.span.start
}

public blockingDiagnosticCount context: ref emitterContext.EmitContext -> Int uses Console {
    context.libraries.diagnosticCount > 0
        -> if { context.libraries.diagnosticCount -> return }
    context -> duplicateFunctionPrecedesSignature
        -> if { 1 -> return }
    context.signatureTypeDiagnostic.sourceModule >= 0 or context.inferredInputConflict.sourceModule >= 0
        -> if { 1 -> return }
    context -> globalFunctionAliasAdmissionDiagnostics(false) => aliasFailures
    aliasFailures > 0 -> if { aliasFailures -> return }
    context.firstDeclarationRootDiagnostic > 0
        -> if { 1 -> return }
    (context -> firstBorrowedTextReturnDiagnostic) >= 0
        -> if { 1 -> return }
    context.expressionOperandDiagnostic.code == 24 or context.expressionOperandDiagnostic.code == 26 or context.expressionOperandDiagnostic.code == 27 or context.expressionOperandDiagnostic.code == 28 or context.expressionOperandDiagnostic.code == 29 or context.expressionOperandDiagnostic.code == 30
        -> if { 1 -> return }
    context.nominalFieldMismatch.sourceModule >= 0
        -> if { 1 } else { context.initializerDiagnostics -> len } => initializerFailures
    context -> traitSignatureDiagnostics(false) => signatureFailures
    context -> fixedArrayCallDiagnostics(false) => fixedArrayFailures
    context -> dynCompatibilityDiagnostics(false) => dynFailures
    context -> dictionaryPutArgumentDiagnostics(false) => dictionaryPutFailures
    context -> boundedDictionaryInitializerDiagnostics(false) => boundedDictionaryFailures
    context -> codePointNumericDiagnostics(false) => codePointFailures
    (context.constantFailures -> len) + (context.unresolvedMutableNames -> len) + (context.consumedBindingReads -> len) + (context.enumPayloadStorageDiagnostics -> len) + initializerFailures + signatureFailures + fixedArrayFailures + dynFailures + dictionaryPutFailures + boundedDictionaryFailures + codePointFailures => count!
    0 => diagnosticIndex!
    diagnosticIndex! < (context.ownershipDiagnostics -> len)
        -> while {
            diagnosticIndex! -> ownershipCheck.isBlockingDiagnostic(context.ownershipDiagnostics, context.ir)
                -> if { count! + 1 => count! }
            diagnosticIndex! + 1 => diagnosticIndex!
        }
    0 => interpolationIndex!
    interpolationIndex! < (context.interpolations -> len)
        -> while {
            not context.activeInterpolationBodyByNode[interpolationIndex!]
                -> if {
                    interpolationIndex! + 1 => interpolationIndex!
                    continue
                }
            context -> isBlockingInterpolationArray(interpolationIndex!)
                -> if { count! + 1 => count! }
            context.interpolationCallArgumentDiagnosticByNode[interpolationIndex!].code > 0
                -> if { count! + 1 => count! }
            context.interpolationOwnedParameterCallByNode[interpolationIndex!]
                -> if { count! + 1 => count! }
            context.unresolvedInterpolationBindingByNode[interpolationIndex!]
                -> if { count! + 1 => count! }
            context.uninvokedInterpolationFunctionByNode[interpolationIndex!]
                -> if { count! + 1 => count! }
            context.uninvokedAssociatedMemberByNode[interpolationIndex!]
                -> if { count! + 1 => count! }
            context.missingLocalAssociatedMemberByNode[interpolationIndex!]
                -> if { count! + 1 => count! }
            context.localEnumMemberDecisionByNode[interpolationIndex!].status == 1
                or context.localEnumMemberDecisionByNode[interpolationIndex!].status == 2
                -> if { count! + 1 => count! }
            context.unresolvedInterpolationCallByNode[interpolationIndex!]
                -> if { count! + 1 => count! }
            context.directCallExpectedArityByNode[interpolationIndex!] >= 0
                -> if { count! + 1 => count! }
            context -> isBlockingInterpolationMethodDecision(interpolationIndex!)
                -> if { count! + 1 => count! }
            context.importedInterpolationCallTargetByNode[interpolationIndex!] < -2
                -> if { count! + 1 => count! }
            context.interpolationPrivateFieldByNode[interpolationIndex!] >= 0
                -> if { count! + 1 => count! }
            context.interpolationMissingMemberOwnerTypeByNode[interpolationIndex!] >= 0
                -> if { count! + 1 => count! }
            context.invalidArgumentsInterpolationIndexByNode[interpolationIndex!]
                -> if { count! + 1 => count! }
            context.unsupportedIndexOwnerTypeByNode[interpolationIndex!] >= 0
                -> if { count! + 1 => count! }
            context -> isBlockingMappedIndexInterpolation(interpolationIndex!)
                -> if { count! + 1 => count! }
            context.invalidCollectionIndexExpectedTypeByNode[interpolationIndex!] >= 0
                -> if { count! + 1 => count! }
            context.interpolationContextualDiagnosticByNode[interpolationIndex!].code > 0
                -> if { count! + 1 => count! }
            context -> isBlockingInvalidUnaryInterpolation(interpolationIndex!)
                -> if { count! + 1 => count! }
            context -> isBlockingInvalidNotInterpolation(interpolationIndex!)
                -> if { count! + 1 => count! }
            context -> isBlockingContextualNumericLiteralInterpolation(interpolationIndex!)
                -> if { count! + 1 => count! }
            context.invalidIntrinsicFlowArityByNode[interpolationIndex!]
                -> if { count! + 1 => count! }
            context.invalidTextIntrinsicArgumentByNode[interpolationIndex!] >= 0
                -> if { count! + 1 => count! }
            context.collectionMembershipDiagnosticByNode[interpolationIndex!].code > 0
                -> if { count! + 1 => count! }
            context.invalidNumericConversionArityByNode[interpolationIndex!]
                -> if { count! + 1 => count! }
            context.invalidNumericConversionTypeByNode[interpolationIndex!] >= 0
                -> if { count! + 1 => count! }
            context.invalidCodePointFloatConversionByNode[interpolationIndex!]
                -> if { count! + 1 => count! }
            context.invalidNumericConversionLiteralByNode[interpolationIndex!] >= 0
                -> if { count! + 1 => count! }
            context.binaryArithmeticDiagnosticByNode[interpolationIndex!].code > 0
                -> if { count! + 1 => count! }
            context.binaryComparisonDiagnosticByNode[interpolationIndex!].code > 0
                -> if { count! + 1 => count! }
            context.binaryLogicalDiagnosticByNode[interpolationIndex!] > 0
                -> if { count! + 1 => count! }
            context.interpolationResultPropagationByNode[interpolationIndex!].status > 0
                -> if { count! + 1 => count! }
            context.invalidDisplayTypeByNode[interpolationIndex!] >= 0
                -> if { count! + 1 => count! }
            interpolationIndex! + 1 => interpolationIndex!
        }
    0 => callIndex!
    callIndex! < (context.calls -> len) -> while {
        context -> isBlockingUnresolvedCall(callIndex!)
            -> if { count! + 1 => count! }
        callIndex! + 1 => callIndex!
    }
    context -> invalidMouseEventCapacityCount => invalidMouseCapacities
    count! + invalidMouseCapacities => count!
    context -> moduleImportDiagnosticCount => invalidModuleImports
    count! + invalidModuleImports => count!
    context -> libraryImportDiagnosticCount => invalidLibraryImports
    count! + invalidLibraryImports => count!
    context -> nativeAbiUnsafeTypeCount => invalidNativeAbiTypes
    count! + invalidNativeAbiTypes => count!
    context -> nativeHandleForgeryCount => nativeHandleForgeries
    count! + nativeHandleForgeries => count!
    context -> resultPropagationOutsideResultFunctionCount => invalidResultPropagations
    count! + invalidResultPropagations => count!
    context -> resultPropagationErrorTypeMismatchCount => mismatchedResultPropagations
    count! + mismatchedResultPropagations => count!
    context -> ownedResultPropagationNamedPlaceCount => invalidOwnedResultPropagations
    count! + invalidOwnedResultPropagations => count!
    context -> returnOutsideFunctionCount => invalidReturns
    count! + invalidReturns => count!
    context -> expressionOperandDiagnosticCount => invalidExpressionOperands
    count! + invalidExpressionOperands => count!
    context -> numericCallArgumentDiagnosticCount => invalidNumericCallArguments
    count! + invalidNumericCallArguments => count!
    context -> numericCallLiteralDiagnosticCount => invalidNumericCallLiterals
    count! + invalidNumericCallLiterals => count!
    context.memberFieldCollision.sourceModule >= 0
        -> if { count! + 1 => count! }
    context -> comparisonOperandDiagnosticCount => invalidComparisons
    count! + invalidComparisons => count!
    context -> enumExhaustivenessDiagnosticCount => nonExhaustiveEnums
    count! + nonExhaustiveEnums => count!
    context -> privateFieldOperationDiagnosticCount => privateFieldOperations
    count! + privateFieldOperations => count!
    context -> arrayElementLayoutDiagnosticCount => invalidArrayElementLayouts
    count! + invalidArrayElementLayouts => count!
    count!
}

emitCallArityDiagnostic context: ref emitterContext.EmitContext -> Unit uses Console {
    context.callArityDiagnostic => diagnostic
    context.ranges[diagnostic.sourceModule] => directRange
    context.nodes[directRange.astStart + diagnostic.callAst] => directCall
    # Ordinary calls retain the source namespace even in main. Main-only
    # interpolation diagnostics own their separate scope-aware prefix.
    "<main>" => moduleName!
    context.modules[diagnostic.sourceModule] => sourceIdentity
    sourceIdentity.pathLength > 0 -> if {
        context.sources[diagnostic.sourceModule] -> slice(sourceIdentity.pathStart, sourceIdentity.pathLength) => moduleName!
    }
    diagnostic.nativePathStyle -> if {
        context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(directCall.start) => location
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] sys.path.nativeStyle does not accept arguments" -> println
        return
    }
    diagnostic.genericTypeArguments -> if {
        context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(directCall.start) => location
        context.ranges[diagnostic.targetSourceModule] => declarationRange
        context.symbols[declarationRange.symbolStart + diagnostic.functionSymbol] => declaration
        context.tokens[declarationRange.tokenStart + declaration.nameToken] => nameToken
        context.sources[diagnostic.targetSourceModule] -> slice(nameToken.span.start, nameToken.span.length) => name
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] generic function '$name' expects $(diagnostic.expectedAdditionalArguments) argument(s)" -> println
        return
    }
    diagnostic.runtimeRequest and diagnostic.targetPathAst >= 0
        -> if {
            directCall.start => offset!
            directCall.kind == 10 -> if {
                context.nodes[directRange.astStart + diagnostic.targetPathAst].start => offset!
            }
            context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(offset!) => location
            "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] " -> print
            directCall.kind == 10 -> if { "function '" -> print }
            calls.ModuleCallResolution {
                sourceModule: diagnostic.sourceModule, callAst: diagnostic.callAst,
                origin: 0, targetModule: diagnostic.targetSourceModule,
                targetSourceModule: diagnostic.targetSourceModule,
                functionSymbol: diagnostic.functionSymbol, status: 0
            } => call
            context -> emitSemanticCallPathName(call, diagnostic.targetPathAst, false)
            directCall.kind == 10 -> if {
                "' expects $(diagnostic.expectedAdditionalArguments) additional argument(s)" -> println
            } else { " expects $(diagnostic.expectedAdditionalArguments) argument(s)" -> println }
            return
        }
    directCall.kind == 11 -> if {
        context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(directCall.start) => location
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] function '" -> print
        calls.ModuleCallResolution {
            sourceModule: diagnostic.sourceModule, callAst: diagnostic.callAst,
            origin: 0, targetModule: diagnostic.targetSourceModule,
            targetSourceModule: diagnostic.targetSourceModule,
            functionSymbol: diagnostic.functionSymbol, status: 0
        } => call
        diagnostic.targetPathAst >= 0 -> if {
            context -> emitSemanticCallPathName(call, diagnostic.targetPathAst, false)
        } else {
            context.tokens[directRange.tokenStart + directCall.firstToken] => nameToken
            context.sources[diagnostic.sourceModule] -> slice(nameToken.span.start, nameToken.span.length) -> print
        }
        "' expects $(diagnostic.expectedAdditionalArguments) argument(s)" -> println
        return
    }
    context.ranges[diagnostic.targetSourceModule] => range
    context.symbols[range.symbolStart + diagnostic.functionSymbol] => function
    context.tokens[range.tokenStart + function.nameToken] => nameToken
    context.sources[diagnostic.targetSourceModule] -> slice(nameToken.span.start, nameToken.span.length) => name
    context.sources[diagnostic.targetSourceModule] -> syntaxDiagnostics.sourceLocation(nameToken.span.start) => location
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] function '$name' expects $(diagnostic.expectedAdditionalArguments) additional argument(s)" -> println
}

public emitBlockingDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    context.libraries.diagnosticCount > 0 -> if {
        context -> emitLibraryBindingDiagnostics
        return
    }
    context -> duplicateFunctionPrecedesSignature
        -> if {
            context -> emitExpressionOperandDiagnostics
            return
        }
    context.signatureTypeDiagnostic.sourceModule >= 0
        and (context.signatureTypeDiagnostic.code < 6 or context.signatureTypeDiagnostic.code == 15
        or context.signatureTypeDiagnostic.code == 16)
        -> if {
            context -> emitSignatureTypeDiagnostic
            return
        }
    context.inferredInputConflict.sourceModule >= 0
        -> if {
            context -> emitInferredInputConflict
            return
        }
    context.signatureTypeDiagnostic.sourceModule >= 0
        -> if {
            context -> emitSignatureTypeDiagnostic
            return
        }
    context -> globalFunctionAliasAdmissionDiagnostics(true) => aliasFailures
    aliasFailures > 0 -> if { return }
    context -> emitBorrowedTextReturnDiagnostic -> if { return }
    context.firstDeclarationRootDiagnostic == 2 -> if {
        context -> mouseCapacityOverridesNumericLiteral => mouseCall
        mouseCall >= 0 -> if {
            context -> emitMouseEventCapacityDiagnostic(mouseCall)
        } else { context -> emitNumericCallLiteralDiagnostic }
        return
    }
    context.firstDeclarationRootDiagnostic == 3 -> if {
        context -> emitNumericCallArgumentDiagnostic
        return
    }
    context.firstDeclarationRootDiagnostic == 4 -> if {
        context -> emitNominalInitializerDiagnostics
        return
    }
    context.firstDeclarationRootDiagnostic == 11 -> if {
        context -> emitExpressionOperandDiagnostics
        return
    }
    context.firstDeclarationRootDiagnostic == 5 -> if {
        context.initializerDiagnostics -> each failure {
            context -> enumFailureOwnsUnknownCall(failure)
                -> if {
                    context -> emitEnumInitializerDiagnostic(failure)
                    return
                }
        }
        context -> emitBindingDeclarationDiagnostic
        return
    }
    context.firstDeclarationRootDiagnostic == 6 -> if {
        context -> emitCallOwnershipDiagnostic
        return
    }
    context.firstDeclarationRootDiagnostic == 7 -> if {
        context -> emitDictionaryKeyDiagnostic
        return
    }
    context.firstDeclarationRootDiagnostic == 8 -> if {
        context -> emitOwnedIndexReadDiagnostic
        return
    }
    context.firstDeclarationRootDiagnostic == 9 -> if {
        context -> emitCallArityDiagnostic
        return
    }
    context.firstDeclarationRootDiagnostic == 10 -> if {
        context -> emitFirstOwnedBindingDiagnostic
        return
    }
    context.expressionOperandDiagnostic.code == 24 or context.expressionOperandDiagnostic.code == 26 or context.expressionOperandDiagnostic.code == 27 or context.expressionOperandDiagnostic.code == 28
        -> if {
            context -> emitExpressionOperandDiagnostics
            return
        }
    context -> emitUnresolvedMutableNameDiagnostics
    context -> emitConsumedBindingReadDiagnostics
    context -> emitNominalInitializerDiagnostics
    context -> codePointNumericDiagnostics(true) => codePointFailures
    context -> traitSignatureDiagnostics(true) => traitFailures
    context -> fixedArrayCallDiagnostics(true) => fixedArrayFailures
    context -> dynCompatibilityDiagnostics(true) => dynFailures
    context -> dictionaryPutArgumentDiagnostics(true) => dictionaryPutFailures
    context -> boundedDictionaryInitializerDiagnostics(true) => boundedDictionaryFailures
    context -> emitConstantCollectionDiagnostics
    context -> emitOwnershipDiagnostics
    context -> emitEnumPayloadStorageDiagnostics
    context -> emitInterpolationDiagnostics
    context -> emitCallDiagnostics
    context -> emitMouseEventDiagnostics
    context -> emitModuleImportDiagnostics
    context -> emitLibraryImportDiagnostics
    context -> emitNativeAbiDiagnostics
    context -> emitNativeHandleForgeryDiagnostics
    context -> emitResultPropagationOwnerDiagnostics
    context -> emitResultPropagationErrorTypeDiagnostics
    context -> emitOwnedResultPropagationNamedPlaceDiagnostics
    context -> emitReturnOutsideFunctionDiagnostics
    context -> emitMemberFieldCollision
    context -> emitExpressionOperandDiagnostics
    context -> emitComparisonOperandDiagnostics
    context -> emitEnumExhaustivenessDiagnostics
    context -> emitPrivateFieldOperationDiagnostics
    context -> emitArrayElementLayoutDiagnostics
}

emitOwnedIndexReadMessage elementTypeId: Int, dictionary: Bool, context: ref emitterContext.EmitContext -> Unit uses Console {
    dictionary -> if { "indexing owned dictionary value type " -> print } else {
        "indexing owned array element type " -> print
    }
    elementTypeId -> emitBoxOperandTypeName(context)
    " may only borrow it directly for a readonly call; use take to move it out" -> println
}

emitOwnedIndexReadDiagnostic context: ref emitterContext.EmitContext -> Unit uses Console {
    context.ownedIndexReadDiagnostic => diagnostic
    context.ranges[diagnostic.sourceModule] => range
    context.nodes[range.astStart + diagnostic.indexAst] => node
    context.tokens[range.tokenStart + node.payloadToken] => bracket
    context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(bracket.span.start) => location
    "<main>" => moduleName!
    not (context.nodes -> semanticDiagnostics.expressionBelongsToMain(range, diagnostic.indexAst))
        and context.modules[diagnostic.sourceModule].pathLength > 0
        -> if {
            context.modules[diagnostic.sourceModule] => identity
            context.sources[diagnostic.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
        }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] " -> print
    diagnostic.elementTypeId -> emitOwnedIndexReadMessage(diagnostic.dictionary, context)
}

emitDictionaryKeyDiagnostic context: ref emitterContext.EmitContext -> Unit uses Console {
    context.dictionaryKeyDiagnostic => diagnostic
    context.ranges[diagnostic.sourceModule] => range
    context.nodes[range.astStart + diagnostic.locationAst] => node
    node.start => locationStart!
    diagnostic.nameToken >= 0 -> if {
        context.tokens[range.tokenStart + diagnostic.nameToken].span.start => locationStart!
    }
    context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(locationStart!) => location
    "<main>" => moduleName!
    not (context.nodes -> semanticDiagnostics.expressionBelongsToMain(range, diagnostic.locationAst))
        and context.modules[diagnostic.sourceModule].pathLength > 0
        -> if {
            context.modules[diagnostic.sourceModule] => identity
            context.sources[diagnostic.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
        }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] dictionary key type " -> print
    diagnostic.keyTypeId -> emitBoxOperandTypeName(context)
    " must implement Hash.hash: self -> Int and Eq.eq: self -> Int" -> println
}

emitCallOwnershipDiagnostic context: ref emitterContext.EmitContext -> Unit uses Console {
    context.callOwnershipDiagnostic => diagnostic
    context.ranges[diagnostic.sourceModule] => range
    context.nodes[range.astStart + diagnostic.argumentAst] => argument
    context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(argument.start) => location
    context.ranges[diagnostic.targetSourceModule] => functionRange
    context.symbols[functionRange.symbolStart + diagnostic.functionSymbol] => function
    context.tokens[functionRange.tokenStart + function.nameToken] => functionToken
    context.sources[diagnostic.targetSourceModule] -> slice(functionToken.span.start, functionToken.span.length) => functionName
    "<main>" => moduleName!
    not (context.nodes -> semanticDiagnostics.expressionBelongsToMain(range, diagnostic.argumentAst))
        and context.modules[diagnostic.sourceModule].pathLength > 0
        -> if {
            context.modules[diagnostic.sourceModule] => identity
            context.sources[diagnostic.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
        }
    diagnostic.code == 4 -> if {
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] function '$functionName' requires an addressable owner or reference; literals and temporary values cannot be borrowed" -> println
        return
    }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] function '$functionName' mutably borrows a container" -> print
    diagnostic.code == 1 -> if {
        context.nodes[range.astStart + diagnostic.rootAst] => root
        context.tokens[range.tokenStart + root.firstToken] => token
        context.sources[diagnostic.sourceModule] -> slice(token.span.start, token.span.length) => name
        "; use a mutable owner binding such as '$name!'" -> println
    } else {
        diagnostic.code == 2 -> if {
            ", so the argument must be a mutable owner place" -> println
        } else {
            ", so the flowed input must be a mutable owner place" -> println
        }
    }
}

emitBindingDeclarationDiagnostic context: ref emitterContext.EmitContext -> Unit uses Console {
    context.bindingDeclarationDiagnostic => diagnostic
    context.ranges[diagnostic.sourceModule] => range
    context.tokens[range.tokenStart + diagnostic.nameToken] => token
    context.sources[diagnostic.sourceModule] -> slice(token.span.start, token.span.length) => name
    context.sources[diagnostic.sourceModule] -> syntaxDiagnostics.sourceLocation(token.span.start) => location
    "<main>" => moduleName!
    context.modules[diagnostic.sourceModule] => identity
    identity.pathLength > 0 -> if {
        context.sources[diagnostic.sourceModule] -> slice(identity.pathStart, identity.pathLength) => moduleName!
    }
    diagnostic.code == 13 -> if {
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] function '" -> print
        moduleName! != "<main>" -> if { "$(moduleName!)." -> print }
        "$name' cannot infer one return type from the function body" -> println
        return
    }
    diagnostic.code == 14 -> if {
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] index must be " -> print
        diagnostic.expectedTypeId -> emitBoxOperandTypeName(context)
        "" -> println
        return
    }
    diagnostic.code == 15 -> if {
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] array elements must have one type; expected " -> print
        diagnostic.expectedTypeId -> emitBoxOperandTypeName(context)
        ", got " -> print
        diagnostic.actualTypeId -> emitBoxOperandTypeName(context)
        "" -> println
        return
    }
    diagnostic.code == 11 or diagnostic.code == 12
        -> if {
            "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] indexed assignment " -> print
            diagnostic.code == 11 -> if { "value" -> print } else { "index" -> print }
            " must be " -> print
            diagnostic.expectedTypeId -> emitBoxOperandTypeName(context)
            "" -> println
            return
        }
    diagnostic.code == 10 -> if {
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] binding name '$(name)' is reserved" -> println
        return
    }
    diagnostic.code == 2 or diagnostic.code == 9 -> if {
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] " -> print
        diagnostic.code == 9 -> if {
            context.libraryCalls -> each libraryCall {
                libraryCall.status == 3 and libraryCall.sourceModule == diagnostic.sourceModule
                    and libraryCall.callAst == diagnostic.valueAst
                    -> if {
                        context.libraries.bindings[libraryCall.bindingIndex] => binding
                        context.modules[binding.sourceModule] => owner
                        context.sources[binding.sourceModule] -> slice(owner.pathStart, owner.pathLength) => ownerName
                        context.ranges[binding.sourceModule] => bindingRange
                        context.tokens[bindingRange.tokenStart + binding.aliasToken] => alias
                        context.sources[binding.sourceModule] -> slice(alias.span.start, alias.span.length) => aliasName
                        context.libraries.interfaces[binding.interfaceIndex].strings -> file.borrowBytes => strings
                        context.libraries.interfaces[binding.interfaceIndex].exports[libraryCall.exportIndex].name => exportName
                        strings -> slice(exportName.start, exportName.length) => memberName
                        "function '$(ownerName).$(aliasName).$(memberName)' is internal to module '$(ownerName)'" -> println
                        return
                    }
            }
        }
        diagnostic.code == 2 -> if { "unknown function or method '" -> print } else { "function '" -> print }
        -1 => selectedCall!
        0 => callIndex!
        callIndex! < (context.calls -> len) -> while {
            context.calls[callIndex!] => call
            call.sourceModule == diagnostic.sourceModule and call.callAst == diagnostic.valueAst
                -> if { callIndex! => selectedCall! }
            callIndex! + 1 => callIndex!
        }
        selectedCall! < 0 -> if {
            "sollang: compiler invariant [SEMANTIC_CALL_DIAGNOSTIC_IDENTITY_MISSING]" -> println
            return
        }
        context.calls[selectedCall!] => call
        context -> emitSemanticCallPathName(call, diagnostic.valueAst, false)
        diagnostic.code == 2 -> if { "'" -> println } else {
            context.modules[call.targetModule] => targetIdentity
            context.sources[targetIdentity.sourceIndex] -> slice(targetIdentity.pathStart, targetIdentity.pathLength) => targetModuleName
            "' is internal to module '$targetModuleName'" -> println
        }
        return
    }
    diagnostic.code >= 3 and diagnostic.code <= 8
        -> if {
            "append expects exactly one Int argument" => message!
            diagnostic.code == 4 -> if { "append expects an Int value" => message! }
            diagnostic.code == 5 -> if { "updated expects two Int arguments" => message! }
            diagnostic.code == 6 -> if { "updated expects Int arguments" => message! }
            diagnostic.code == 7 -> if { "append must be bound directly with '=>'" => message! }
            diagnostic.code == 8 -> if { "updated must be bound directly with '=>'" => message! }
            "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] $(message!)" -> println
            return
        }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] binding '$name' already exists in this scope" -> println
}

public emitDeclaredTypeSpelling source: ref Text, tokens: ref [syntax.SyntaxToken; ~], tokenStart: Int, annotation: ast.AstNode -> Unit uses Console {
    false => space!
    false => previousWord!
    annotation.firstToken => cursor!
    cursor! < annotation.firstToken + annotation.tokenCount
        -> while {
            tokens[tokenStart + cursor!] => token
            token.kind != grammar.triviaIdWhitespace() and token.kind != grammar.triviaIdComment()
                and token.kind != grammar.tokenIdNewLine() -> if {
                    token.kind == grammar.tokenIdIdentifier() or token.kind == grammar.tokenIdNumber() => word
                    space! or (previousWord! and word) -> if { " " -> print }
                    source -> slice(token.span.start, token.span.length) -> print
                    token.kind == grammar.tokenIdComma() or token.kind == grammar.tokenIdColon()
                        or token.kind == grammar.tokenIdSemicolon() => space!
                    word => previousWord!
                }
            cursor! + 1 => cursor!
        }
}

public emitSignatureTypeDiagnosticForSource source: Text, moduleName: Text, name: syntax.SyntaxToken, genericName: Text, code: Int -> Unit uses Console {
    source -> syntaxDiagnostics.sourceLocation(name.span.start) => location
    code == 23 -> if {
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName)'] async functions require a transferable result, a sendable input, and a non-local user declaration; owned inputs must use move" -> println
        return
    }
    code >= 17 and code <= 20 -> if {
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName)'] " -> print
        code == 17 -> if { "readonly array views require inline scalar or user-value elements" -> println }
        code == 18 -> if { "growable array elements must have a supported inline value layout" -> println }
        code == 19 -> if { "fixed array elements must be inline scalar or user values" -> println }
        code == 20 -> if { "bounded array elements must be inline scalar or user values" -> println }
        return
    }
    code == 22 -> if {
        source -> slice(name.span.start, name.span.length) => fieldName
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName)'] struct field '$fieldName' must be an inline value type" -> println
        return
    }
    code == 15 or code == 16 -> if {
        code == 15 -> if { "generic move inputs are not implemented yet" } else {
            "generic local and impl functions are not implemented yet"
        } => message
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName)'] $message" -> println
        return
    }
    code == 5 or code == 6 or code == 7 -> if {
        source -> slice(name.span.start, name.span.length) => functionName
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName)'] function '" -> print
        moduleName != "<main>" -> if { "$moduleName." -> print }
        functionName -> print
        code == 5 -> if { "' public function signatures require explicit input and return types" -> println }
        code == 6 -> if { "' an inferred private function must be consumed by exactly one function or main scope" -> println }
        code == 7 -> if { "' an inferred private function is consumed by multiple functions; write its signature explicitly" -> println }
        return
    }
    code == 4 -> if {
        source -> slice(name.span.start, name.span.length) => variantName
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName)'] enum variant '$variantName' payload must be an inline value type" -> println
        return
    }
    code == 3 -> if {
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName)'] mut input expects an owned container or struct value" -> println
        return
    }
    code == 2 -> if {
        "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName)'] generic function input must use its type parameter '$genericName' in this slice" -> println
        return
    }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName)'] fixed array length must be a nonnegative integer literal" -> println
}

emitInferredInputConflict context: ref emitterContext.EmitContext -> Unit uses Console {
    context.inferredInputConflict => diagnostic
    context.ranges[diagnostic.sourceModule] => range
    context.symbols[range.symbolStart + diagnostic.functionSymbol] => function
    context.tokens[range.tokenStart + function.nameToken] => name
    context.sources[diagnostic.sourceModule] => source
    source -> syntaxDiagnostics.sourceLocation(name.span.start) => location
    context.modules[diagnostic.sourceModule] => identity
    "<main>" => moduleName!
    identity.pathLength > 0 -> if { source -> slice(identity.pathStart, identity.pathLength) => moduleName! }
    "sollang: semantic error at $(location.line):$(location.column): [module '$(moduleName!)'] function '" -> print
    moduleName! != "<main>" -> if { "$(moduleName!)." -> print }
    source -> slice(name.span.start, name.span.length) -> print
    "' has conflicting inferred input types " -> print
    diagnostic.firstTypeId -> emitBoxOperandTypeName(context)
    " and " -> print
    diagnostic.actualTypeId -> emitBoxOperandTypeName(context)
    "" -> println
}

emitSignatureTypeDiagnostic context: ref emitterContext.EmitContext -> Unit uses Console {
    context.signatureTypeDiagnostic => diagnostic
    context.ranges[diagnostic.sourceModule] => range
    context.tokens[range.tokenStart + diagnostic.nameToken] => name
    context.sources[diagnostic.sourceModule] => source
    "<main>" => moduleName!
    context.modules[diagnostic.sourceModule] => identity
    identity.pathLength > 0 -> if {
        source -> slice(identity.pathStart, identity.pathLength) => moduleName!
    }
    "" => genericName!
    diagnostic.code == 2 -> if {
        context.tokens[range.tokenStart + diagnostic.genericToken] => generic
        source -> slice(generic.span.start, generic.span.length) => genericName!
    }
    source -> emitSignatureTypeDiagnosticForSource(moduleName!, name, genericName!, diagnostic.code)
}

constantCollectionMessage failure: constantLowering.Failure -> Text {
    failure.error -> when {
        InvalidAst(_) { "invalid constant collection expression; use a constant integer range" }
        InvalidRange(_) { "constant collection bounds must be ascending; reverse the bounds" }
        ExpansionLimit(_) { "constant collection expansion exceeds 100000 elements; reduce the range" }
        InvalidSelector(_) { "array each must produce one integer; dictionary each must produce key: value" }
        Expression(error) {
            error.kind -> when {
                NonConstant { "collection bounds and selectors must be constant integer expressions" }
                Overflow { "constant collection integer arithmetic overflow; reduce the operands" }
                DivisionByZero { "constant collection division by zero; use a nonzero divisor" }
                InvalidAst { "invalid constant collection expression tree" }
            }
        }
    }
}

emitConstantCollectionDiagnostics context: ref emitterContext.EmitContext -> Unit uses Console {
    0 => sourceIndex!
    sourceIndex! < (context.ranges -> len) -> while {
        context.ranges[sourceIndex!] => range
        0 => index!
        index! < range.constantFailureCount -> while {
            context.constantFailures[range.constantFailureStart + index!] => failure
            failure -> constantCollectionMessage => message
            "; sollang error S055: $message (source $(sourceIndex!), byte $(failure.start), length $(failure.length))" -> println
            index! + 1 => index!
        }
        sourceIndex! + 1 => sourceIndex!
    }
}

public isMouseEventsCall context: ref emitterContext.EmitContext, callIndex: Int -> Bool {
    callIndex < 0 or callIndex >= (context.ir -> len)
        -> if { false -> return }
    context.ir[callIndex] => call
    call.kind != 6 or call.typeId < 0 or call.typeId >= (context.types -> len)
        or call.targetModule < 0 or call.targetModule >= (context.ranges -> len)
        or call.targetModule >= (context.modules -> len)
        -> if { false -> return }
    context.types[call.typeId] => resultType
    resultType.kind != 7 or resultType.origin != 4 or resultType.symbol != 4
        -> if { false -> return }
    context.modules[call.targetModule] => ownerModule
    (context.sources[ownerModule.sourceIndex] -> slice(ownerModule.pathStart, ownerModule.pathLength)) != "sys.input.mouse"
        -> if { false -> return }
    context.ranges[call.targetModule] => targetRange
    call.symbol < 0 or call.symbol >= targetRange.symbolCount
        -> if { false -> return }
    context.symbols[targetRange.symbolStart + call.symbol] => target
    target.kind != 31 or target.parent < 0 or target.parent >= targetRange.symbolCount
        or target.nameToken < 0 or target.nameToken >= targetRange.tokenCount
        -> if { false -> return }
    context.symbols[targetRange.symbolStart + target.parent] => owner
    owner.nameToken < 0 or owner.nameToken >= targetRange.tokenCount
        -> if { false -> return }
    (call.targetModule -> sourceTokenIs(target.nameToken, "events", context))
        and (call.targetModule -> sourceTokenIs(owner.nameToken, "Source", context))
}

public usesMouseEventsRuntime context: ref emitterContext.EmitContext -> Bool {
    false => usesMouse!
    0 => callIndex!
    callIndex! < (context.ir -> len) and not usesMouse!
        -> while {
            context -> isMouseEventsCall(callIndex!) -> if { true => usesMouse! }
            callIndex! + 1 => callIndex!
        }
    usesMouse!
}
