                        context.modules[moduleIndex!] => moduleIdentity
                        moduleIdentity.sourceIndex == candidate.module
                            and moduleIdentity.pathHash == 13685761513169113882
                            and modules.logicalNameIs(context.sources[candidate.module], moduleIdentity, context.ranges[candidate.module], context.tokens, "std.net.socket")
