public usesMappedBytesRuntime context: ref emitterContext.EmitContext -> Bool {
    0 => nodeIndex!
    nodeIndex! < (context.ir -> len) -> while {
        context.ir[nodeIndex!] => node
        node.typeOrigin == 1 and (node.typeSymbol == 17 or node.typeSymbol == 18)
            -> if { true -> return }
        node.kind == 9 and (node.opcode == -306 or node.opcode == -307)
            -> if { true -> return }
        nodeIndex! + 1 => nodeIndex!
    }
    false
}

# Compute the executable call-graph closure once per consumer. Function bodies
# are contiguous in typed IR; calls inside text interpolation live in the
# interpolation IR and must participate in the same closure.
public interpolationCallNameMatches node: interpolationIr.InterpolationNode, sourceModule: Int, functionIndex: Int, context: ref emitterContext.EmitContext -> Bool {
    context.ir[functionIndex] => function
    context.ranges[function.sourceModule] => functionRange
    context.symbols[functionRange.symbolStart + function.symbol] => functionSymbol
    functionSymbol -> symbols.hasQualifiedFunctionName(context.tokens, functionRange.tokenStart, functionRange.tokenCount)
        -> if { false -> return }
    context.tokens[functionRange.tokenStart + functionSymbol.nameToken] => functionName
    node.callNameLength == functionName.span.length => equal!
    UIntSize(0) => nameByteIndex!
    equal! and nameByteIndex! < functionName.span.length
        -> while {
            context.sources[sourceModule] -> byte(node.callNameStart + nameByteIndex!) => callNameByte
            context.sources[function.sourceModule] -> byte(functionName.span.start + nameByteIndex!) => functionNameByte
            callNameByte != functionNameByte -> if { false => equal! }
            nameByteIndex! + 1 => nameByteIndex!
        }
    equal!
}

sourceTokenIs sourceModule: Int, tokenIndex: Int, expected: Text, context: ref emitterContext.EmitContext -> Bool {
    context.ranges[sourceModule] => sourceRange
    context.tokens[sourceRange.tokenStart + tokenIndex] => token
    token.span.length == (expected -> len) => equal!
    UIntSize(0) => byteIndex!
    equal! and byteIndex! < token.span.length -> while {
        (context.sources[sourceModule] -> byte(token.span.start + byteIndex!)) != (expected -> byte(byteIndex!))
            -> if { false => equal! }
        byteIndex! + 1 => byteIndex!
    }
    equal!
}

sourceTokensEqual leftSource: Int, leftToken: Int, rightSource: Int, rightToken: Int, context: ref emitterContext.EmitContext -> Bool {
    context.ranges[leftSource] => leftRange
    context.ranges[rightSource] => rightRange
    context.tokens[leftRange.tokenStart + leftToken] => left
    context.tokens[rightRange.tokenStart + rightToken] => right
    left.span.length == right.span.length => equal!
    UIntSize(0) => byteIndex!
    equal! and byteIndex! < left.span.length -> while {
        (context.sources[leftSource] -> byte(left.span.start + byteIndex!)) != (context.sources[rightSource] -> byte(right.span.start + byteIndex!))
            -> if { false => equal! }
        byteIndex! + 1 => byteIndex!
    }
    equal!
}

# Resolve the local symbol of a nominal trait implementation independently of
# emission state. Reachability and LLVM lowering must consume the same answer:
# collection Hash/Eq calls are implicit codegen edges, not ordinary IR calls.
public traitMethodSymbol typeId: Int, traitName: Text, methodName: Text, context: ref emitterContext.EmitContext -> Int {
    typeId < 0 or typeId >= (context.types -> len)
        -> if { -1 -> return }
    context.types[typeId] => receiver
    receiver.kind != 1 or receiver.module < 0 -> if { -1 -> return }
    typeId -> typeIds.nominalTraitMethodSymbol(traitName, methodName, context.ranges, context.nodes, context.tokens, context.symbols, context.sources[receiver.module], context.modules, context.types)
}

# Vtable requirements and implementations retain actual declaration identities.
public dynTraitMethodDeclaration typeId: Int, ordinal: Int, context: ref emitterContext.EmitContext -> Int {
    typeId < 0 or typeId >= (context.types -> len)
        -> if { -1 -> return }
    context.types[typeId] => dynType
    dynType.kind != 1 or dynType.origin != 16 or dynType.module < 0
        -> if { -1 -> return }
    context.ranges[dynType.module] => range
    0 => index!
    0 => position!
    index! < range.symbolCount -> while {
        context.symbols[range.symbolStart + index!] => member
        member.kind == 29 and member.parent == dynType.symbol
            -> if {
                position! == ordinal -> if { range.symbolStart + index! -> return }
                position! + 1 => position!
            }
        index! + 1 => index!
    }
    -1
}

public dynTraitMethodCount typeId: Int, context: ref emitterContext.EmitContext -> Int {
    0 => count!
    (typeId -> dynTraitMethodDeclaration(count!, context)) >= 0
        -> while { count! + 1 => count! }
    count!
}

public dynTraitImplementationFunction conversion: typedIr.TypedIrNode, ordinal: Int, context: ref emitterContext.EmitContext -> Int {
    conversion.typeId -> dynTraitMethodDeclaration(ordinal, context) => requirement
    requirement < 0 or conversion.operand0 < 0 -> if { -1 -> return }
    context.types[conversion.typeId] => dynType
    context.ranges[dynType.module].symbolStart + dynType.symbol => traitIdentity
    context.types -> typeIds.materializedReadTypeId(context.ir[conversion.operand0].typeId) => receiverType
    receiverType < 0 -> if { -1 -> return }
    context.types[receiverType] => receiver
    receiver.module < 0 or receiver.symbol < 0 -> if { -1 -> return }
    context.ranges[receiver.module].symbolStart + receiver.symbol => receiverIdentity
    traitIdentity -> traitRequirementImplementations(receiverIdentity, requirement, false, context) => selection
    selection.count != 1 -> if { -1 -> return }
    selection.symbol => implementation
    0 => functionIndex!
    functionIndex! < (context.ir -> len) -> while {
        context.ir[functionIndex!] => function
        function.kind == 0 and function.sourceModule >= 0 and function.symbol >= 0 and function.operand1 >= 0
            -> if {
                context.ranges[function.sourceModule].symbolStart + function.symbol == implementation
                    and (context.types -> typeIds.materializedReadTypeId(context.ir[function.operand1].typeId)) == receiverType
                    -> if { functionIndex! -> return }
            }
        functionIndex! + 1 => functionIndex!
    }
    -1
}

public dynTraitDispatchSlot call: typedIr.TypedIrNode, context: ref emitterContext.EmitContext -> Int {
    call.targetModule < 0 or call.targetModule >= (context.ranges -> len)
        -> if { -1 -> return }
    context.ranges[call.targetModule] => range
    call.symbol < 0 or call.symbol >= range.symbolCount
        -> if { -1 -> return }
    context.symbols[range.symbolStart + call.symbol] => selected
    selected.kind != 29 -> if { -1 -> return }
    0 => index!
    1 => slot!
    index! < range.symbolCount -> while {
        context.symbols[range.symbolStart + index!] => candidate
        candidate.kind == 29 and candidate.parent == selected.parent
            -> if {
                index! == call.symbol -> if { slot! -> return }
                slot! + 1 => slot!
            }
        index! + 1 => index!
    }
    -1
}

# Dictionary literals, mutations, and indexed reads emit Hash/Eq calls without
# ordinary call IR. Their shared key type is the reachability edge.
dictionaryKeyTypeId typeId: Int, context: ref emitterContext.EmitContext -> Int {
    typeId => dictionaryTypeId!
    dictionaryTypeId! >= 0 and dictionaryTypeId! < (context.types -> len)
        and context.types[dictionaryTypeId!].kind == 8
        -> if { context.types[dictionaryTypeId!].first => dictionaryTypeId! }
    -1 => keyTypeId!
    dictionaryTypeId! >= 0 and dictionaryTypeId! < (context.types -> len)
        -> if {
            context.types[dictionaryTypeId!] => dictionaryType
            dictionaryType.kind == 5 or dictionaryType.kind == 13
                or (dictionaryType.kind == 7 and dictionaryType.origin == 4 and dictionaryType.symbol == 5)
                -> if { dictionaryType.first => keyTypeId! }
        }
    keyTypeId!
}

collectionTraitMethodFunction keyTypeId: Int, traitName: Text, methodName: Text, functionBySymbol: ref [Int; ~], context: ref emitterContext.EmitContext -> Int {
    -1 => functionIndex!
    keyTypeId >= 0 and keyTypeId < (context.types -> len)
        -> if {
            keyTypeId -> traitMethodSymbol(traitName, methodName, context) => methodSymbol
            context.types[keyTypeId].module => keyModule
            methodSymbol >= 0 and keyModule >= 0 and keyModule < (context.ranges -> len)
                -> if {
                    context.ranges[keyModule].symbolStart + methodSymbol => globalSymbol
                    globalSymbol >= 0 and globalSymbol < (functionBySymbol -> len)
                        -> if { functionBySymbol[globalSymbol] => functionIndex! }
                }
        }
    functionIndex!
}

public reachableFunctions context: ref emitterContext.EmitContext -> [Bool; ~] {
    [Int; ~] => functionEnds!
    [Int; ~] => functionBySymbol!
    0 => initializeIndex!
    initializeIndex! < (context.ir -> len) -> while {
        functionEnds! -> push(-1)
        initializeIndex! + 1 => initializeIndex!
    }
    0 => symbolInitializeIndex!
    symbolInitializeIndex! < (context.symbols -> len)
        -> while {
            functionBySymbol! -> push(-1)
            symbolInitializeIndex! + 1 => symbolInitializeIndex!
        }
    0 => functionIndex!
    functionIndex! < (context.ir -> len) -> while {
        context.ir[functionIndex!] => function
        function.kind == 0 or function.kind == 11 -> if {
            functionIndex! + 1 => functionEnd!
            functionEnd! < (context.ir -> len)
                and context.ir[functionEnd!].kind != 0
                and context.ir[functionEnd!].kind != 11 -> while {
                    functionEnd! + 1 => functionEnd!
                }
            functionEnd! => functionEnds![functionIndex!]
            function.kind == 0
                and not (context -> emitterContext.isGenericInstance(functionIndex!))
                and function.sourceModule >= 0
                and function.sourceModule < (context.ranges -> len)
                and function.symbol >= 0 -> if {
                    context.ranges[function.sourceModule].symbolStart + function.symbol => globalSymbol
                    globalSymbol >= 0 and globalSymbol < (functionBySymbol! -> len)
                        -> if {
                            functionIndex! => functionBySymbol![globalSymbol]
                        }
                }
        }
        functionIndex! + 1 => functionIndex!
    }
    [Bool; ~] => reachable!
    0 => reachableInitializeIndex!
    reachableInitializeIndex! < (context.ir -> len)
        -> while {
            context.ir[reachableInitializeIndex!] => reachableCandidate
            reachableCandidate.kind == 11 => reachableCandidateIsRoot
            reachable! -> push(reachableCandidateIsRoot)
            reachableInitializeIndex! + 1 => reachableInitializeIndex!
        }
    [Bool; ~] => seenCollectionKeys!
    0 => keyInitializeIndex!
    keyInitializeIndex! < (context.types -> len)
        -> while {
            seenCollectionKeys! -> push(false)
            keyInitializeIndex! + 1 => keyInitializeIndex!
        }
    true => changed!
    changed! -> while {
        false => changed!
        context.genericBodies.interpolationInstances -> each instance {
            instance.ownerFunction >= 0 and reachable![instance.ownerFunction]
                and not reachable![instance.functionNode]
                -> if {
                    true => reachable![instance.functionNode]
                    true => changed!
                }
        }
        0 => ownerIndex!
        ownerIndex! < (context.ir -> len) -> while {
            reachable![ownerIndex!]
                and (context.ir[ownerIndex!].kind == 0 or context.ir[ownerIndex!].kind == 11)
                -> if {
                    ownerIndex! + 1 => useIndex!
                    functionEnds![ownerIndex!] => ownerEnd
                    useIndex! < ownerEnd -> while {
                        context.ir[useIndex!] => use
                        (use.kind == 6 or use.kind == 9)
                            and use.targetModule >= 0
                            and use.targetModule < (context.ranges -> len)
                            and use.symbol >= 0 -> if {
                                context.ranges[use.targetModule].symbolStart + use.symbol => globalTargetSymbol
                                globalTargetSymbol >= 0 and globalTargetSymbol < (functionBySymbol! -> len)
                                    -> if {
                                        functionBySymbol![globalTargetSymbol] => targetFunction!
                                        context -> emitterContext.genericFunctionForCall(useIndex!) => genericFunction
                                        genericFunction >= 0 -> if { genericFunction => targetFunction! }
                                        targetFunction! >= 0 and not reachable![targetFunction!]
                                            -> if {
                                                true => reachable![targetFunction!]
                                                true => changed!
                                            }
                                    }
                            }
                        use.kind == 9 and use.opcode == -224
                            and use.operand0 >= 0 and use.typeOrigin == 16
                            -> if {
                                0 => methodOrdinal!
                                use.typeId -> dynTraitMethodCount(context) => methodCount
                                methodOrdinal! < methodCount -> while {
                                    use -> dynTraitImplementationFunction(methodOrdinal!, context) => implementationFunction
                                    implementationFunction >= 0 and not reachable![implementationFunction]
                                        -> if {
                                            true => reachable![implementationFunction]
                                            true => changed!
                                        }
                                    methodOrdinal! + 1 => methodOrdinal!
                                }
                            }
                        -1 => collectionKeyTypeId!
                        use -> typedIr.isSetIntrinsicCall -> if {
                            context.ir[use.operand0].typeId => setTypeId!
                            setTypeId! >= 0 and setTypeId! < (context.types -> len) and context.types[setTypeId!].kind == 8
                                -> if { context.types[setTypeId!].first => setTypeId! }
                            setTypeId! >= 0 and setTypeId! < (context.types -> len)
                                -> if { context.types[setTypeId!].first => collectionKeyTypeId! }
                        }
                        # A reachable dictionary-typed value covers literals,
                        # parameters, and receivers of put, take, and indexing.
                        use.typeId -> dictionaryKeyTypeId(context) => dictionaryKeyType
                        dictionaryKeyType >= 0 -> if { dictionaryKeyType => collectionKeyTypeId! }
                        collectionKeyTypeId! >= 0 and collectionKeyTypeId! < (seenCollectionKeys! -> len)
                            and not seenCollectionKeys![collectionKeyTypeId!]
                            -> if {
                                true => seenCollectionKeys![collectionKeyTypeId!]
                                collectionKeyTypeId! -> collectionTraitMethodFunction("Hash", "hash", functionBySymbol!, context) => hashFunction
                                collectionKeyTypeId! -> collectionTraitMethodFunction("Eq", "eq", functionBySymbol!, context) => eqFunction
                                hashFunction >= 0 and not reachable![hashFunction]
                                    -> if {
                                        true => reachable![hashFunction]
                                        true => changed!
                                    }
                                eqFunction >= 0 and not reachable![eqFunction]
                                    -> if {
                                        true => reachable![eqFunction]
                                        true => changed!
                                    }
                            }
                        use.kind == 2
                            and use.sourceModule >= 0
                            and use.sourceModule < (context.interpolationRanges -> len)
                            -> if {
                                context.interpolationRanges[use.sourceModule] => interpolationRange
                                0 => interpolationOffset!
                                interpolationOffset! < interpolationRange.nodeCount
                                    -> while {
                                        context.interpolations[interpolationRange.nodeStart + interpolationOffset!] => interpolation
                                        (interpolation.kind == 8 or interpolation.kind == 10)
                                            and interpolation.sourceToken == use.payloadToken
                                            -> if {
                                                interpolationRange.nodeStart + interpolationOffset! => interpolationNodeIndex
                                                context -> emitterContext.interpolationFunctionForOwner(ownerIndex!, interpolationNodeIndex) => interpolationTarget
                                                interpolationTarget >= 0 and not reachable![interpolationTarget]
                                                    -> if {
                                                        true => reachable![interpolationTarget]
                                                        true => changed!
                                                    }
                                            }
                                        interpolation.kind == 5 and interpolation.sourceToken == use.payloadToken
                                            -> if {
                                                interpolationRange.nodeStart + interpolationOffset! => memberNodeIndex
                                                context -> emitterContext.interpolationFunctionForOwner(ownerIndex!, memberNodeIndex) => computedMemberTarget
                                                computedMemberTarget >= 0 and not reachable![computedMemberTarget]
                                                    -> if {
                                                        true => reachable![computedMemberTarget]
                                                        true => changed!
                                                    }
                                            }
                                        interpolationOffset! + 1 => interpolationOffset!
                                    }
                            }
                        use.kind == 2
                            and use.sourceModule >= 0
                            and use.sourceModule < (context.interpolationRanges -> len)
                            -> if {
                                context.interpolationRanges[use.sourceModule] => instanceInterpolationRange
                                0 => instanceInterpolationOffset!
                                instanceInterpolationOffset! < instanceInterpolationRange.nodeCount
                                    -> while {
                                        context.interpolations[instanceInterpolationRange.nodeStart + instanceInterpolationOffset!] => instanceInterpolation
                                        instanceInterpolation.kind == 10
                                            and instanceInterpolation.sourceToken == use.payloadToken
                                            and instanceInterpolation.operand0 >= 0
                                            and (context -> emitterContext.interpolationFunctionForOwner(ownerIndex!, instanceInterpolationRange.nodeStart + instanceInterpolationOffset!)) < 0
                                            -> if {
                                                1 => instanceArgumentCount!
                                                instanceInterpolation.operand1 >= 0 -> if {
                                                    instanceArgumentCount! + 1 => instanceArgumentCount!
                                                }
                                                instanceInterpolation.operand2 >= 0 -> if {
                                                    instanceArgumentCount! + 1 => instanceArgumentCount!
                                                }
                                                0 => instanceCandidateSearch!
                                                instanceCandidateSearch! < (context.ir -> len)
                                                    -> while {
                                                        context.ir[instanceCandidateSearch!] => instanceCandidate
                                                        instanceCandidate.kind == 0
                                                            and instanceCandidate.operand1 >= 0
                                                            and (instanceInterpolation -> interpolationCallNameMatches(use.sourceModule, instanceCandidateSearch!, context))
                                                            -> if {
                                                                1 => instanceParameterCount!
                                                                instanceCandidate.nextOperand => instanceParameterSearch!
                                                                instanceParameterSearch! >= 0 -> while {
                                                                    instanceParameterCount! + 1 => instanceParameterCount!
                                                                    context.ir[instanceParameterSearch!].nextOperand => instanceParameterSearch!
                                                                }
                                                                instanceParameterCount! == instanceArgumentCount!
                                                                    and not reachable![instanceCandidateSearch!]
                                                                    -> if {
                                                                        true => reachable![instanceCandidateSearch!]
                                                                        true => changed!
                                                                    }
                                                            }
                                                        instanceCandidateSearch! + 1 => instanceCandidateSearch!
                                                    }
                                            }
                                        instanceInterpolationOffset! + 1 => instanceInterpolationOffset!
                                    }
                            }
                        useIndex! + 1 => useIndex!
                    }
                }
            ownerIndex! + 1 => ownerIndex!
        }
    }
    reachable!
}

nodeInReachableFunction nodeIndex: Int, reachable: ref [Bool; ~], context: ref emitterContext.EmitContext -> Bool {
    nodeIndex => ownerIndex!
    ownerIndex! >= 0
        and ownerIndex! < (context.ir -> len)
        and context.ir[ownerIndex!].kind != 0
        and context.ir[ownerIndex!].kind != 11 -> while {
            context.ir[ownerIndex!].parent => ownerIndex!
        }
    ownerIndex! >= 0 and ownerIndex! < (reachable -> len) and reachable[ownerIndex!]
}

isBuiltinOutputSymbol symbol: Int -> Bool {
    symbol == -101 or symbol == -102 or symbol == -116 or symbol == -117
}

isInterpolationValueBindingKind kind: Int -> Bool {
    kind == 10 or kind == 17 or kind == 29
}

# Root interpolation names resolve through their lexical binding. A readonly
# reference binding keeps the reference type on the IR node, while emission
# reads its builtin value type. Keep capability selection on that same value
# type so formatter definitions and emitted calls stay closed.
interpolationValueBuiltinScalarSymbol node: typedIr.TypedIrNode, context: ref emitterContext.EmitContext -> Int {
    node.typeId => valueTypeId!
    valueTypeId! >= 0 and valueTypeId! < (context.types -> len) => hasCanonicalType
    valueTypeId! >= 0 and valueTypeId! < (context.types -> len)
        and context.types[valueTypeId!].kind == 8
        and context.types[valueTypeId!].first >= 0
        and context.types[valueTypeId!].first < (context.types -> len)
        -> if { context.types[valueTypeId!].first => valueTypeId! }
    -1 => builtinSymbol!
    valueTypeId! >= 0 and valueTypeId! < (context.types -> len)
        -> if {
            context.types[valueTypeId!] => valueType
            valueType.kind == 1 and valueType.origin == 1
                -> if { valueType.symbol => builtinSymbol! }
        }
    not hasCanonicalType and node.typeOrigin == 1
        -> if { node.typeSymbol => builtinSymbol! }
    builtinSymbol!
}

# Member, index, source-call, Result-propagation and canonical suspension
# payload types may become concrete only after
# interpolation lowering, when receiver-aware emission resolves their base or
# callee. Keep both scalar formatter families available for these deferred
# roots so runtime capability selection cannot disagree with emission.
interpolationFormatterTypeDeferred kind: Int -> Bool {
    kind == 5 or kind == 7 or kind == 8 or kind == 10 or kind == 11 or kind == 17
}

public usesTextRuntime context: ref emitterContext.EmitContext -> Bool {
    false => usesRuntime!
    0 => nodeIndex!
    nodeIndex! < (context.ir -> len) -> while {
        context.ir[nodeIndex!] => node
        (node.symbol -> isBuiltinOutputSymbol)
            or node.symbol == -103
            or (node.kind == 6 and (node.targetModule -> runtimeFunctionNamed(node.symbol, "flushStandardOutput", context)))
            -> if {
                true => usesRuntime!
            }
        nodeIndex! + 1 => nodeIndex!
    }
    context -> usesStandardError -> if { true => usesRuntime! }
    usesRuntime!
}

runtimeFunctionNamed sourceModule: Int, symbolIndex: Int, expectedName: Text, context: ref emitterContext.EmitContext -> Bool {
    false => runtimeModule!
    0 => moduleIndex!
    moduleIndex! < (context.modules -> len) -> while {
        context.modules[moduleIndex!] => moduleIdentity
        moduleIdentity.sourceIndex == sourceModule and moduleIdentity.pathHash == 12254170256457402476
            -> if {
                true => runtimeModule!
            }
        moduleIndex! + 1 => moduleIndex!
    }
    false => matches!
    runtimeModule! and sourceModule >= 0 and sourceModule < (context.ranges -> len)
        -> if {
            context.ranges[sourceModule] => sourceRange
            symbolIndex >= 0 and symbolIndex < sourceRange.symbolCount
                -> if {
                    context.symbols[sourceRange.symbolStart + symbolIndex] => symbol
                    symbol.nameToken >= 0 and symbol.nameToken < sourceRange.tokenCount
                        -> if {
                            context.tokens[sourceRange.tokenStart + symbol.nameToken] => nameToken
                            expectedName -> len => expectedLength
                            nameToken.span.length == expectedLength => matches!
                            UIntSize(0) => byteIndex!
                            matches! and byteIndex! < expectedLength -> while {
                                (context.sources[sourceModule] -> byte(nameToken.span.start + byteIndex!)) != (expectedName -> byte(byteIndex!))
                                    -> if {
                                        false => matches!
                                    }
                                byteIndex! + 1 => byteIndex!
                            }
                        }
                }
        }
    matches!
}

public usesStandardError context: ref emitterContext.EmitContext -> Bool {
    false => usesError!
    0 => moduleIndex!
    moduleIndex! < (context.modules -> len) -> while {
        context.modules[moduleIndex!] => moduleIdentity
        moduleIdentity.pathHash == 12254170256457402476
            and moduleIdentity.sourceIndex >= 0
            and moduleIdentity.sourceIndex < (context.ranges -> len)
            -> if {
                context.ranges[moduleIdentity.sourceIndex] => runtimeRange
                0 => runtimeSymbolIndex!
                runtimeSymbolIndex! < runtimeRange.symbolCount
                    -> while {
                        moduleIdentity.sourceIndex -> runtimeFunctionNamed(runtimeSymbolIndex!, "eprintln", context)
                            -> if {
                                true => usesError!
                            }
                        moduleIdentity.sourceIndex -> runtimeFunctionNamed(runtimeSymbolIndex!, "eprint", context)
                            -> if {
                                true => usesError!
                            }
                        runtimeSymbolIndex! + 1 => runtimeSymbolIndex!
                    }
            }
        moduleIndex! + 1 => moduleIndex!
    }
    0 => nodeIndex!
    nodeIndex! < (context.ir -> len) -> while {
        context.ir[nodeIndex!] => node
        node.symbol == -116 or node.symbol == -117
            or (context.expectedPathStyle == 1 and node.kind == 14)
            or (context.expectedPathStyle == 1 and node.opcode == -203)
            or (node.kind == 0 and (node.sourceModule -> runtimeFunctionNamed(node.symbol, "eprintln", context)))
            or (node.kind == 0 and (node.sourceModule -> runtimeFunctionNamed(node.symbol, "eprint", context)))
            or (node.kind == 6 and (node.targetModule -> runtimeFunctionNamed(node.symbol, "eprintln", context)))
            or (node.kind == 6 and (node.targetModule -> runtimeFunctionNamed(node.symbol, "eprint", context)))
            -> if {
                true => usesError!
            }
        nodeIndex! + 1 => nodeIndex!
    }
    context.expectedPathStyle == 1 -> if {
        context.interpolations -> each node {
            node.opcode == -203 -> if { true => usesError! }
        }
    }
    usesError!
}

public usesParallelRuntime context: ref emitterContext.EmitContext -> Bool {
    false => usesRuntime!
    0 => nodeIndex!
    nodeIndex! < (context.ir -> len) -> while {
        context.ir[nodeIndex!].opcode == -207 or context.ir[nodeIndex!].opcode == -209 or context.ir[nodeIndex!].symbol == -115 or context.ir[nodeIndex!].opcode == -115 or context.ir[nodeIndex!].opcode == -328 or context.ir[nodeIndex!].opcode == -329 or context.ir[nodeIndex!].kind == 38
            -> if { true => usesRuntime! }
        nodeIndex! + 1 => nodeIndex!
    }
    usesRuntime!
}

public usesParallelBranches context: ref emitterContext.EmitContext -> Bool {
    false => usesParallelBranch!
    0 => nodeIndex!
    nodeIndex! < (context.ir -> len) -> while {
        context.ir[nodeIndex!].kind == 38 -> if { true => usesParallelBranch! }
        nodeIndex! + 1 => nodeIndex!
    }
    usesParallelBranch!
}

public usesProcessRuntime context: ref emitterContext.EmitContext -> Bool {
    false => usesRuntime!
    0 => nodeIndex!
    nodeIndex! < (context.ir -> len) -> while {
        context.ir[nodeIndex!].opcode -> typedIr.isProcessExecutionOpcode
            -> if { true => usesRuntime! }
        nodeIndex! + 1 => nodeIndex!
    }
    usesRuntime!
}

