namespace sollang.compiler.llvm.codegen_cache_keys

import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.llvm.codegen_cache_key_policy as plans

public enum DeclarationFieldError { InvalidInput, UnsupportedDeclaration, InvalidType, UnavailablePart }

# Names retain every parsed namespace and containing type segment. Parent and
# symbol indexes remain local to their source, exactly like the type adapter.
declarationNameField context: ref TypeFieldContext, package: ref analysis.PackageAnalysis, declaration: Int -> Field {
    package.ranges[context.sourceModule] => range
    [UInt8; ~] => bytes!
    context -> appendTypeNamespace(package, context.sourceModule, context.identities[context.sourceModule], bytes!)
    [Int; ~] => owners!
    declaration => owner!
    owner! >= 0 -> while {
        owners! -> push(owner!)
        package.symbols[range.symbolStart + owner!].parent => owner!
    }
    (owners! -> len) - 1 => index!
    index! >= 0 -> while {
        (bytes! -> len) > 0 -> if { bytes! -> push('.') }
        package.symbols[range.symbolStart + owners![index!]].nameToken => nameToken
        context -> typeTokenText(package, context.sourceModule, nameToken) -> appendTypeText(bytes!)
        index! - 1 => index!
    }
    Field { bytes: bytes! }
}

# Numeric metadata uses the managed invariant decimal spelling and owns bytes.
unsignedDeclarationField value: UInt64 -> Field {
    [UInt8; ~] => reversed!
    value => remaining!
    remaining! == 0 -> if { reversed! -> push('0') }
    remaining! > 0 -> while {
        reversed! -> push(UInt8(48 + remaining! % 10))
        remaining! / 10 => remaining!
    }
    [UInt8; ~] => bytes!
    (reversed! -> len) - 1 => index!
    index! >= 0 -> while {
        bytes! -> push(reversed![index!])
        index! - 1 => index!
    }
    Field { bytes: bytes! }
}

# This dispatch supplies facts. The compiled shared rule owns their order.
sourceMemberField context: ref TypeFieldContext, package: ref analysis.PackageAnalysis, symbolIndex: Int, part: plans.KeyPart -> Result<Field, DeclarationFieldError> {
    package.symbols[package.ranges[context.sourceModule].symbolStart + symbolIndex] => member
    part -> plans.partIndex => selected
    selected == (plans.KeyPart.MemberName -> plans.partIndex)
        -> if {
            member.nameToken < 0 -> if { Result<Field, DeclarationFieldError>.Err(DeclarationFieldError.InvalidInput) -> return }
            context -> typeTokenText(package, context.sourceModule, member.nameToken) -> textField => field
            Result<Field, DeclarationFieldError>.Ok(field) -> return
        }
    selected == (plans.KeyPart.MemberType -> plans.partIndex)
        -> if {
            member.typeNode < 0 -> if {
                member.kind == 27 -> if { Result<Field, DeclarationFieldError>.Ok(textField("")) -> return }
                Result<Field, DeclarationFieldError>.Err(DeclarationFieldError.InvalidType) -> return
            }
            context -> typeAnnotationField(package, member.typeNode) -> when {
                Ok(field) { Result<Field, DeclarationFieldError>.Ok(field) -> return }
                Err(_) { Result<Field, DeclarationFieldError>.Err(DeclarationFieldError.InvalidType) -> return }
            }
        }
    selected == (plans.KeyPart.MemberOwnership -> plans.partIndex)
        -> if {
            Result<Field, DeclarationFieldError>.Ok(unsignedDeclarationField(UInt64(member.flags % 4))) -> return
        }
    Result<Field, DeclarationFieldError>.Err(DeclarationFieldError.UnavailablePart)
}

struct TraitFields {
    associated: [Field; ~]
    methods: [Field; ~]
}

traitDeclarationFields context: ref TypeFieldContext, package: ref analysis.PackageAnalysis -> Result<TraitFields, DeclarationFieldError> {
    package.ranges[context.sourceModule] => range
    [Field; ~] => associated!
    [Field; ~] => methods!
    0 => index!
    index! < range.symbolCount -> while {
        package.symbols[range.symbolStart + index!] => member
        member.parent == context.ownerSymbol -> if {
            member.kind == 28 -> if {
                context -> typeTokenText(package, context.sourceModule, member.nameToken) -> textField => name
                associated! -> push(name)
            }
            member.kind == 29 -> if {
                [Int; ~] => parameters!
                0 => parameterIndex!
                parameterIndex! < range.symbolCount -> while {
                    package.symbols[range.symbolStart + parameterIndex!] => parameter
                    parameter.kind == 35 and parameter.parent == index! and parameter.astNode != member.astNode
                        -> if { parameters! -> push(parameterIndex!) }
                    parameterIndex! + 1 => parameterIndex!
                }
                plans.traitMethodFields() => methodRule
                methodRule.parts -> each part {
                    part -> plans.partIndex => selected
                    selected == (plans.KeyPart.MethodParameterCount -> plans.partIndex)
                        -> if {
                            methods! -> push(unsignedDeclarationField(UInt64(parameters! -> len)))
                        } else {
                            selected == (plans.KeyPart.MethodParameters -> plans.partIndex)
                                -> if {
                                    plans.ownedTypeFields() => parameterRule
                                    parameters! -> each parameterIndex {
                                        parameterRule.parts -> each parameterPart {
                                            context -> sourceMemberField(package, parameterIndex, parameterPart) -> when {
                                                Ok(field) { methods! -> push(field) }
                                                Err(error) { Result<TraitFields, DeclarationFieldError>.Err(error) -> return }
                                            }
                                        }
                                    }
                                } else {
                                    context -> sourceMemberField(package, index!, part) -> when {
                                        Ok(field) { methods! -> push(field) }
                                        Err(error) { Result<TraitFields, DeclarationFieldError>.Err(error) -> return }
                                    }
                                }
                        }
                }
            }
        }
        index! + 1 => index!
    }
    Result<TraitFields, DeclarationFieldError>.Ok(TraitFields { associated: associated!, methods: methods! })
}

# Supply real declaration facts; the generated rule selects their order. A
# future rule requesting another fact fails through the existing MissingPart
# contract rather than silently omitting it from an interface fingerprint.
public declarationBindings context: ref TypeFieldContext, package: ref analysis.PackageAnalysis -> Result<[Binding; ~], DeclarationFieldError> {
    context.sourceModule < 0 or context.sourceModule >= (package.ranges -> len)
        -> if { Result<[Binding; ~], DeclarationFieldError>.Err(DeclarationFieldError.InvalidInput) -> return }
    package.ranges[context.sourceModule] => range
    context.ownerSymbol < 0 or context.ownerSymbol >= range.symbolCount
        -> if { Result<[Binding; ~], DeclarationFieldError>.Err(DeclarationFieldError.InvalidInput) -> return }
    package.symbols[range.symbolStart + context.ownerSymbol] => declaration
    declaration.kind != 3 and declaration.kind != 4 and declaration.kind != 5
        -> if { Result<[Binding; ~], DeclarationFieldError>.Err(DeclarationFieldError.UnsupportedDeclaration) -> return }
    declaration.flags / 4 % 2 == 0 or declaration.nameToken < 0
        -> if { Result<[Binding; ~], DeclarationFieldError>.Err(DeclarationFieldError.InvalidInput) -> return }
    declaration.parent >= 0 -> if {
        package.symbols[range.symbolStart + declaration.parent].kind != 3
            -> if { Result<[Binding; ~], DeclarationFieldError>.Err(DeclarationFieldError.UnsupportedDeclaration) -> return }
    }
    [Binding; ~] => bindings!
    [Field; ~] => identity!
    context -> declarationNameField(package, context.ownerSymbol) => name
    identity! -> push(name)
    bindings! -> push(Binding { part: plans.KeyPart.Identity, fields: identity! })
    declaration.kind == 5 -> if {
        context -> traitDeclarationFields(package) -> when {
            Ok(fields) {
                bindings! -> push(Binding { part: plans.KeyPart.TraitAssociatedTypes, fields: fields.associated })
                bindings! -> push(Binding { part: plans.KeyPart.TraitMethods, fields: fields.methods })
                Result<[Binding; ~], DeclarationFieldError>.Ok(bindings!) -> return
            }
            Err(error) { Result<[Binding; ~], DeclarationFieldError>.Err(error) -> return }
        }
    }
    [Field; ~] => visibility!
    visibility! -> push(textField("public"))
    bindings! -> push(Binding { part: plans.KeyPart.Visibility, fields: visibility! })
    declaration.kind == 3 -> if {
        [Field; ~] => container!
        declaration.parent >= 0 -> if {
            context -> declarationNameField(package, declaration.parent) => owner
            container! -> push(owner)
        } else { container! -> push(textField("")) }
        bindings! -> push(Binding { part: plans.KeyPart.DeclarationContainer, fields: container! })
    }
    [Field; ~] => members!
    0 => index!
    index! < range.symbolCount -> while {
        package.symbols[range.symbolStart + index!] => member
        member.parent == context.ownerSymbol
            and ((declaration.kind == 3 and member.kind == 26) or (declaration.kind == 4 and member.kind == 27))
            -> if {
                plans.namedTypeFields() => memberRule
                memberRule.parts -> each part {
                    context -> sourceMemberField(package, index!, part) -> when {
                        Ok(field) { members! -> push(field) }
                        Err(error) { Result<[Binding; ~], DeclarationFieldError>.Err(error) -> return }
                    }
                }
            }
        index! + 1 => index!
    }
    declaration.kind == 3 -> if { plans.KeyPart.StructFields } else { plans.KeyPart.EnumVariants } => part
    bindings! -> push(Binding { part: part, fields: members! })
    Result<[Binding; ~], DeclarationFieldError>.Ok(bindings!)
}
