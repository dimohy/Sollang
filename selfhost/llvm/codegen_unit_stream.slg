namespace sollang.compiler.llvm.codegen_units

import sys.text as text

# Process-backed emitters preserve the same prefix/module/suffix boundaries as
# the CSharp memory sink. These are framing comments, never LLVM parsing rules.
# Views borrow the complete input; its owner must outlive the returned units.
public struct StreamedUnit {
    public kind: Int
    public identity: Text
    public fragment: Text
    public hasKey: Bool
    public reused: Bool
    public interfaceHash: UInt64
    public implementationHash: UInt64
}

public enum UnitStreamError { Framing, Incomplete, Identity, Order, Limit, Key }

struct StreamKey { interfaceHash: UInt64, implementationHash: UInt64 }

# The CLI's worker-count header describes this invocation, not a cached unit.
# Keep the unit parser strict; only the process transport removes this header.
public compilerStreamPayload source: Text -> Text {
    "; sollang workers = " => prefix
    not (source -> text.startsWith(prefix)) -> if { source -> return }
    prefix -> len => start
    start => end!
    end! < (source -> len) and (source -> byte(end!)) != 10
        -> while { end! + 1 => end! }
    end! == (source -> len) -> if { source -> return }
    end! => digitsEnd!
    digitsEnd! > start and (source -> byte(digitsEnd! - 1)) == 13
        -> if { digitsEnd! - 1 => digitsEnd! }
    digitsEnd! == start or (source -> byte(start)) == '0'
        -> if { source -> return }
    UInt64(0) => workers!
    start => index!
    index! < digitsEnd! -> while {
        Int(source -> byte(index!)) - '0' => digit
        digit < 0 or digit > 9 or workers! > 214748364 or (workers! == 214748364 and digit > 7)
            -> if { source -> return }
        workers! * 10 + UInt64(digit) => workers!
        index! + 1 => index!
    }
    source -> slice(end! + 1, (source -> len) - end! - 1)
}

readStreamHash source: Text -> Result<UInt64, UnitStreamError> {
    (source -> len) == 0 or (source -> len) > 20 -> if { Result<UInt64, UnitStreamError>.Err(UnitStreamError.Key) -> return }
    (source -> len) > 1 and (source -> byte(0)) == '0'
        -> if { Result<UInt64, UnitStreamError>.Err(UnitStreamError.Key) -> return }
    UInt64(0) => hash!
    UIntSize(0) => index!
    index! < (source -> len) -> while {
        Int(source -> byte(index!)) - '0' => digit
        digit < 0 or digit > 9 or hash! > 1844674407370955161 or (hash! == 1844674407370955161 and digit > 5)
            -> if { Result<UInt64, UnitStreamError>.Err(UnitStreamError.Key) -> return }
        hash! * 10 + UInt64(digit) => hash!
        index! + 1 => index!
    }
    Result<UInt64, UnitStreamError>.Ok(hash!)
}

readStreamKey source: Text -> Result<StreamKey, UnitStreamError> {
    UIntSize(0) => separator!
    separator! < (source -> len) and (source -> byte(separator!)) != ':'
        -> while { separator! + 1 => separator! }
    separator! >= (source -> len) -> if { Result<StreamKey, UnitStreamError>.Err(UnitStreamError.Key) -> return }
    source -> slice(0, separator!) -> readStreamHash -> when {
        Err(error) { Result<StreamKey, UnitStreamError>.Err(error) -> return }
        Ok(value) { value }
    } => interfaceHash
    source -> slice(separator! + 1, (source -> len) - separator! - 1) -> readStreamHash -> when {
        Err(error) { Result<StreamKey, UnitStreamError>.Err(error) -> return }
        Ok(value) { value }
    } => implementationHash
    Result<StreamKey, UnitStreamError>.Ok(StreamKey { interfaceHash: interfaceHash, implementationHash: implementationHash })
}

public readStreamedUnits source: Text -> Result<[StreamedUnit; ~], UnitStreamError> {
    [StreamedUnit; ~] => units!
    [UInt64; ~] => identityWords!
    -1 => kind!
    "" => identity!
    false => hasKey!
    false => reused!
    UInt64(0) => interfaceHash!
    UInt64(0) => implementationHash!
    -1 => keyMode!
    UIntSize(0) => fragmentStart!
    UIntSize(0) => lineStart!
    UInt64(0) => previousHash!
    0 => previousStart!
    0 => previousLength!
    source -> len => length
    streamPrefix() => prefix
    prefix -> len => prefixLength
    lineStart! < length -> while {
        lineStart! => lineEnd!
        lineEnd! < length and (source -> byte(lineEnd!)) != '\n'
            -> while { lineEnd! + 1 => lineEnd! }
        lineEnd! == length
            -> if { Result<[StreamedUnit; ~], UnitStreamError>.Err(UnitStreamError.Incomplete) -> return }
        lineEnd! => contentEnd!
        contentEnd! > lineStart! and (source -> byte(contentEnd! - 1)) == '\r'
            -> if { contentEnd! - 1 => contentEnd! }
        source -> slice(lineStart!, contentEnd! - lineStart!) => line
        line == streamEnd() -> if {
            kind! != 2 or lineEnd! + 1 != length
                -> if { Result<[StreamedUnit; ~], UnitStreamError>.Err(UnitStreamError.Framing) -> return }
            source -> slice(fragmentStart!, lineStart! - fragmentStart!) => fragment
            (units! -> len) >= 1000000 or (fragment -> len) > 1073741824
                -> if { Result<[StreamedUnit; ~], UnitStreamError>.Err(UnitStreamError.Limit) -> return }
            keyMode! == 1 and not hasKey! or keyMode! == 0 and hasKey!
                -> if { Result<[StreamedUnit; ~], UnitStreamError>.Err(UnitStreamError.Key) -> return }
            units! -> push(StreamedUnit { kind: kind!, identity: identity!, fragment: fragment, hasKey: hasKey!, reused: reused!, interfaceHash: interfaceHash!, implementationHash: implementationHash! })
            units! -> Result<[StreamedUnit; ~], UnitStreamError>.Ok -> return
        }
        line -> text.startsWith(prefix) -> if {
            (line -> len) < prefixLength + 2 or (line -> byte(prefixLength + 1)) != ':'
                -> if { Result<[StreamedUnit; ~], UnitStreamError>.Err(UnitStreamError.Framing) -> return }
            Int(line -> byte(prefixLength)) - '0' => nextKind
            line -> slice(prefixLength + 2, (line -> len) - prefixLength - 2) => nextIdentity
            nextKind < 0 or nextKind > 2 or (kind! < 0 and nextKind != 0)
                or (kind! >= 0 and nextKind == 0) or kind! == 2
                -> if { Result<[StreamedUnit; ~], UnitStreamError>.Err(UnitStreamError.Order) -> return }
            nextKind != 1 and (nextIdentity -> len) != 0
                -> if { Result<[StreamedUnit; ~], UnitStreamError>.Err(UnitStreamError.Identity) -> return }
            (nextIdentity -> len) > 1048576
                -> if { Result<[StreamedUnit; ~], UnitStreamError>.Err(UnitStreamError.Limit) -> return }
            kind! >= 0 -> if {
                source -> slice(fragmentStart!, lineStart! - fragmentStart!) => fragment
                (units! -> len) >= 1000000 or (fragment -> len) > 1073741824
                    -> if { Result<[StreamedUnit; ~], UnitStreamError>.Err(UnitStreamError.Limit) -> return }
                keyMode! == 1 and not hasKey! or keyMode! == 0 and hasKey!
                    -> if { Result<[StreamedUnit; ~], UnitStreamError>.Err(UnitStreamError.Key) -> return }
                hasKey! -> if { 1 } else { 0 } => keyMode!
                units! -> push(StreamedUnit { kind: kind!, identity: identity!, fragment: fragment, hasKey: hasKey!, reused: reused!, interfaceHash: interfaceHash!, implementationHash: implementationHash! })
            }
            nextKind == 1 -> if {
                identityWords! -> len => start
                UIntSize(0) => offset!
                offset! < (nextIdentity -> len) -> while {
                    identityWords! -> push(UInt64(nextIdentity -> byte(offset!)))
                    offset! + 1 => offset!
                }
                Int(nextIdentity -> len) => identityLength
                identityWords! -> identityUtf8Valid(start, identityLength)
                    -> unless { Result<[StreamedUnit; ~], UnitStreamError>.Err(UnitStreamError.Identity) -> return }
                identityWords! -> identityHash(start, identityLength) => hash
                kind! == 1 -> if {
                    hash == previousHash! -> if {
                        (identityWords! -> identityOrder(previousStart!, previousLength!, start, identityLength)) != -1
                            -> if { Result<[StreamedUnit; ~], UnitStreamError>.Err(UnitStreamError.Order) -> return }
                    } else {
                        previousHash! -> lessUnsigned(hash)
                            -> unless { Result<[StreamedUnit; ~], UnitStreamError>.Err(UnitStreamError.Order) -> return }
                    }
                }
                hash => previousHash!
                start => previousStart!
                identityLength => previousLength!
            }
            false => hasKey!
            false => reused!
            0 => interfaceHash!
            0 => implementationHash!
            nextKind => kind!
            nextIdentity => identity!
            lineEnd! + 1 => fragmentStart!
        } else {
            line == "; sollang.codegen.reused" -> if {
                not hasKey! or reused! or fragmentStart! != lineStart!
                    -> if { Result<[StreamedUnit; ~], UnitStreamError>.Err(UnitStreamError.Key) -> return }
                true => reused!
                lineEnd! + 1 => fragmentStart!
            } else { line -> text.startsWith(streamKeyPrefix()) -> if {
                    kind! < 0 or hasKey! or keyMode! == 0 or fragmentStart! != lineStart!
                        -> if { Result<[StreamedUnit; ~], UnitStreamError>.Err(UnitStreamError.Key) -> return }
                    streamKeyPrefix() -> len => keyPrefixLength
                    line -> slice(keyPrefixLength, (line -> len) - keyPrefixLength) -> readStreamKey -> when {
                        Err(error) { Result<[StreamedUnit; ~], UnitStreamError>.Err(error) -> return }
                        Ok(key) {
                            true => hasKey!
                            key.interfaceHash => interfaceHash!
                            key.implementationHash => implementationHash!
                            lineEnd! + 1 => fragmentStart!
                        }
                    }
                } else { kind! < 0 -> if { Result<[StreamedUnit; ~], UnitStreamError>.Err(UnitStreamError.Framing) -> return } }
            }
        }
        lineEnd! + 1 => lineStart!
    }
    Result<[StreamedUnit; ~], UnitStreamError>.Err(UnitStreamError.Incomplete)
}
