namespace sollang.compiler.llvm.text

import sollang.compiler.llvm.codegen_cache_keys as keys
import sollang.compiler.llvm.codegen_cache_key_policy as plans
import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.semantic.type_registration as registration

captureRegisteredTypeRecord records: mut keys.TypeUniverseRecords, context: mut keys.TypeFieldContext, package: ref analysis.PackageAnalysis, semantic: ref typeIds.SemanticTypeSet, layouts: ref TypeLayouts, typeId: Int, type: typeIds.SemanticType -> Result<Unit, keys.TypeUniverseCaptureError> {
    type.kind == 1 and type.origin == 1 -> if {
        records -> keys.appendBuiltinTypeUniverseRecord(semantic.types, typeId) -> return
    }
    type.kind == 1 or type.kind == 9 -> if {
        type.module < 0 or type.module >= (package.ranges -> len)
            -> if { Result<Unit, keys.TypeUniverseCaptureError>.Err(keys.TypeUniverseCaptureError.InvalidType) -> return }
        package.ranges[type.module] => range
        type.symbol < 0 or type.symbol >= range.symbolCount
            -> if { Result<Unit, keys.TypeUniverseCaptureError>.Err(keys.TypeUniverseCaptureError.InvalidType) -> return }
        -1 => words!
        package.symbols[range.symbolStart + type.symbol].kind == 4
            -> if {
                layouts.statuses[typeId] != 0 or layouts.sizes[typeId] < 8 or (layouts.sizes[typeId] - 8) % 8 != 0
                    -> if { Result<Unit, keys.TypeUniverseCaptureError>.Err(keys.TypeUniverseCaptureError.InvalidType) -> return }
                (layouts.sizes[typeId] - 8) / 8 => words!
            }
        context.sourceModule => previous
        type.module => context.sourceModule
        records -> keys.appendDeclaredTypeUniverseRecordWithIdentity(context, package, semantic, typeId, type, words!) => result
        previous => context.sourceModule
        result -> return
    }
    type.kind == 10 or (type.kind == 7 and type.origin == 4 and (type.symbol == 0 or type.symbol == 1))
        -> if {
            records -> keys.appendSyntheticTypeUniverseRecord(context, package, semantic, typeId, layouts.sizes, layouts.statuses) -> return
        }
    (type -> typeIds.isHeapCollection) or type.kind == 4 or type.kind == 6 or type.kind == 12 or type.kind == 13
        -> if {
            records -> appendStorageTypeUniverseRecord(semantic.types, layouts, typeId) -> return
        }
    type.kind == 8 -> if {
        records -> keys.appendReferenceTypeUniverseRecord(semantic.types, typeId) -> return
    }
    Result<Unit, keys.TypeUniverseCaptureError>.Err(keys.TypeUniverseCaptureError.InvalidType)
}

# The semantic registry supplies committed identities explicitly. This boundary
# never infers membership from unrelated scratch entries in the semantic arena.
# Range is always registered, even if the caller supplies no source identities.
# Errors discard the private result; no partially captured table is published.
public captureRegisteredTypeUniverse context: mut keys.TypeFieldContext, package: ref analysis.PackageAnalysis, semantic: ref typeIds.SemanticTypeSet, layouts: ref TypeLayouts, registeredIds: ref [Int; ~] -> Result<keys.TypeUniverseRecords, keys.TypeUniverseCaptureError> {
    [registration.RegisteredDeclaration; ~] => declarations
    context -> captureRegisteredUniverseWithDeclarations(package, semantic, layouts, registeredIds, declarations)
}

# Consume the real registry, including source identities whose runtime type
# was canonicalized. Source names and final field-type identities stay linked.
public captureCompilationTypeUniverse context: mut keys.TypeFieldContext, package: ref analysis.PackageAnalysis, semantic: ref typeIds.SemanticTypeSet, layouts: ref TypeLayouts, seeds: ref registration.RegisteredTypeSeeds -> Result<keys.TypeUniverseRecords, keys.TypeUniverseCaptureError> {
    context -> captureRegisteredUniverseWithDeclarations(package, semantic, layouts, seeds.used, seeds.declarations)
}

captureRegisteredUniverseWithDeclarations context: mut keys.TypeFieldContext, package: ref analysis.PackageAnalysis, semantic: ref typeIds.SemanticTypeSet, layouts: ref TypeLayouts, registeredIds: ref [Int; ~], declarations: ref [registration.RegisteredDeclaration; ~] -> Result<keys.TypeUniverseRecords, keys.TypeUniverseCaptureError> {
    (layouts.sizes -> len) != (semantic.types -> len) or (layouts.aligns -> len) != (semantic.types -> len) or (layouts.statuses -> len) != (semantic.types -> len)
        -> if { Result<keys.TypeUniverseRecords, keys.TypeUniverseCaptureError>.Err(keys.TypeUniverseCaptureError.InvalidType) -> return }
    [Bool; ~] => seen!
    semantic.types -> each _ { seen! -> push(false) }
    registeredIds -> each typeId {
        typeId < 0 or typeId >= (semantic.types -> len)
            -> if { Result<keys.TypeUniverseRecords, keys.TypeUniverseCaptureError>.Err(keys.TypeUniverseCaptureError.InvalidType) -> return }
        seen![typeId] or semantic.types[typeId].status != 0 or semantic.types[typeId].containsParameter
            -> if { Result<keys.TypeUniverseRecords, keys.TypeUniverseCaptureError>.Err(keys.TypeUniverseCaptureError.InvalidType) -> return }
        true => seen![typeId]
    }
    [Int; ~] => declarationByType!
    semantic.types -> each _ { declarationByType! -> push(-1) }
    0 => declarationIndex!
    declarations -> each declaration {
        declaration.typeId < 0 or declaration.typeId >= (semantic.types -> len)
            -> if { Result<keys.TypeUniverseRecords, keys.TypeUniverseCaptureError>.Err(keys.TypeUniverseCaptureError.InvalidType) -> return }
        not seen![declaration.typeId] or declarationByType![declaration.typeId] >= 0
            -> if { Result<keys.TypeUniverseRecords, keys.TypeUniverseCaptureError>.Err(keys.TypeUniverseCaptureError.InvalidType) -> return }
        declarationIndex! => declarationByType![declaration.typeId]
        declarationIndex! + 1 => declarationIndex!
    }
    keys.TypeUniverseRecords { categories: [plans.KeyPart; ~], typeIds: [Int; ~], memberOrdinals: [Int; ~], fields: [keys.Field; ~] } => records!
    semantic.types -> typeIds.builtinTypeId(25) => range
    range < 0 -> if { Result<keys.TypeUniverseRecords, keys.TypeUniverseCaptureError>.Err(keys.TypeUniverseCaptureError.InvalidType) -> return }
    not seen![range] -> if {
        records! -> keys.appendBuiltinTypeUniverseRecord(semantic.types, range) -> when {
            Err(error) { Result<keys.TypeUniverseRecords, keys.TypeUniverseCaptureError>.Err(error) -> return }
            Ok {}
        }
    }
    registeredIds -> each typeId {
        declarationByType![typeId] => selected
        selected >= 0 -> if { declarations[selected].identity } else { semantic.types[typeId] } => identity
        records! -> captureRegisteredTypeRecord(context, package, semantic, layouts, typeId, identity) -> when {
            Err(error) { Result<keys.TypeUniverseRecords, keys.TypeUniverseCaptureError>.Err(error) -> return }
            Ok {}
        }
    }
    Result<keys.TypeUniverseRecords, keys.TypeUniverseCaptureError>.Ok(records!)
}

# Append signature metadata through a separate scope. Concrete capture and its
# runtime admission checks finish before any abstract descriptors are considered.
public captureCompilationTypeUniverseWithSignatures context: mut keys.TypeFieldContext, package: ref analysis.PackageAnalysis, semantic: ref typeIds.SemanticTypeSet, layouts: ref TypeLayouts, seeds: ref registration.RegisteredTypeSeeds, signatureIds: ref [Int; ~] -> Result<keys.TypeUniverseRecords, keys.TypeUniverseCaptureError> {
    context -> captureCompilationTypeUniverse(package, semantic, layouts, seeds) -> when {
        Err(error) { Result<keys.TypeUniverseRecords, keys.TypeUniverseCaptureError>.Err(error) -> return }
        Ok(value) { value }
    } => records!
    records! -> appendMetadataSignatureUniverse(context, package, semantic, layouts, signatureIds) -> when {
        Err(error) { Result<keys.TypeUniverseRecords, keys.TypeUniverseCaptureError>.Err(error) -> return }
        Ok {}
    }
    Result<keys.TypeUniverseRecords, keys.TypeUniverseCaptureError>.Ok(records!)
}

appendMetadataSignatureUniverse records: mut keys.TypeUniverseRecords, context: mut keys.TypeFieldContext, package: ref analysis.PackageAnalysis, semantic: ref typeIds.SemanticTypeSet, runtimeLayouts: ref TypeLayouts, signatureIds: ref [Int; ~] -> Result<Unit, keys.TypeUniverseCaptureError> {
    (signatureIds -> len) != (semantic.types -> len)
        -> if { Result<Unit, keys.TypeUniverseCaptureError>.Err(keys.TypeUniverseCaptureError.InvalidType) -> return }
    semantic.types -> typeIds.builtinTypeId(13) => pointerType
    pointerType < 0 -> if { Result<Unit, keys.TypeUniverseCaptureError>.Err(keys.TypeUniverseCaptureError.InvalidType) -> return }
    runtimeLayouts.sizes[pointerType] => pointerSize
    pointerSize != 4 and pointerSize != 8 -> if { Result<Unit, keys.TypeUniverseCaptureError>.Err(keys.TypeUniverseCaptureError.InvalidType) -> return }
    [typeIds.SemanticType; ~] => types!
    semantic.types -> each type { types! -> push(type) }
    [typeIds.NominalField; ~] => fields!
    semantic.fields -> each field { fields! -> push(field) }
    TypeLayoutRequest { types: types!, fields: fields!, typeId: -1, pointerBitWidth: pointerSize * 8 } -> metadataSignatureLayoutsFor => layouts!
    [Int; ~] => referenceByAst!
    package.nodes -> each _ { referenceByAst! -> push(-1) }
    semantic.references -> each reference {
        reference.typeAst >= 0 -> if {
            reference.typeId => referenceByAst![package.ranges[reference.sourceModule].astStart + reference.typeAst]
        }
    }
    [Int; ~] => traits!
    semantic.types -> each _ { traits! -> push(0) }
    semantic.types -> refineDeclaredTypeLayouts(semantic.fields, semantic.references, package.ranges, package.symbols, package.nodes, referenceByAst!, layouts!.sizes, layouts!.aligns, layouts!.statuses, traits!)
    [Int; ~] => seen!
    0 => typeId!
    semantic.types -> each type {
        type.containsParameter and signatureIds[typeId!] >= 1024
            and ((type -> typeIds.isHeapCollection) or type.kind == 4 or type.kind == 6 or type.kind == 8 or type.kind == 10 or type.kind == 12 or type.kind == 13
            or (type.kind == 7 and type.origin == 4 and (type.symbol == 0 or type.symbol == 1)))
            -> if {
                false => duplicate!
                seen! -> each previous { previous == signatureIds[typeId!] -> if { true => duplicate! } }
                not duplicate! -> if {
                    seen! -> push(signatureIds[typeId!])
                    type.kind == 10 or (type.kind == 7 and type.origin == 4 and (type.symbol == 0 or type.symbol == 1))
                        -> if {
                            records -> keys.appendMetadataSignatureTypeUniverseRecord(context, package, semantic, typeId!, layouts!.sizes, layouts!.statuses, signatureIds)
                        } else {
                            type.kind == 8 -> if {
                                records -> keys.appendMetadataSignatureReferenceRecord(semantic.types, typeId!, signatureIds)
                            } else {
                                records -> appendMetadataSignatureStorageRecord(semantic.types, layouts!, typeId!, signatureIds)
                            }
                        } -> when {
                            Err(error) { Result<Unit, keys.TypeUniverseCaptureError>.Err(error) -> return }
                            Ok {}
                        }
                }
            }
        typeId! + 1 => typeId!
    }
    Result<Unit, keys.TypeUniverseCaptureError>.Ok
}
