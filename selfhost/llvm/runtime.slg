public emitLinuxOwnedFile emitOpenCloseDeclarations: Bool -> Unit uses Console {
    """
    declare i64 @pread(i32, ptr, i64, i64)
    declare i64 @pwrite(i32, ptr, i64, i64)
    declare i32 @fsync(i32)
    declare i32 @rename(ptr, ptr)
    declare i32 @unlink(ptr)
    """ -> println
    emitOpenCloseDeclarations -> if {
        """
        declare i32 @open(ptr, i32, i32)
        declare i32 @close(i32)
        """ -> println
    }
    4096 -> emitOwnedFilePathCopy
    emitOwnedFilePathNoNul()
    """
    define internal i32 @sollang_platform_create_exclusive_file(ptr %path, i64 %length) {
    entry:
      %buffer = alloca [260 x i8], align 1
      %buffer_ptr = getelementptr inbounds [260 x i8], ptr %buffer, i64 0, i64 0
      %fits = icmp ule i64 %length, 259
      br i1 %fits, label %copy, label %failure
    copy:
      %copied = call i32 @sollang_owned_file_copy_path(ptr %path, i64 %length, ptr %buffer_ptr)
      %no_nul = call i32 @sollang_owned_file_path_has_no_nul(ptr %path, i64 %length)
      %valid = and i32 %copied, %no_nul
      %valid_path = icmp ne i32 %valid, 0
      br i1 %valid_path, label %create, label %failure
    create:
      %fd = call i32 @open(ptr %buffer_ptr, i32 193, i32 384)
      %opened = icmp sge i32 %fd, 0
      br i1 %opened, label %close, label %classify
    classify:
      %errno_ptr = call ptr @__errno_location()
      %errno = load i32, ptr %errno_ptr, align 4
      %exists = icmp eq i32 %errno, 17
      %status = select i1 %exists, i32 0, i32 -1
      ret i32 %status
    close:
      %closed = call i32 @close(i32 %fd)
      %close_ok = icmp eq i32 %closed, 0
      %close_status = select i1 %close_ok, i32 1, i32 -1
      ret i32 %close_status
    failure:
      ret i32 -1
    }

    define internal i32 @sollang_platform_remove_file(ptr %path, i64 %length) {
    entry:
      %buffer = alloca [260 x i8], align 1
      %buffer_ptr = getelementptr inbounds [260 x i8], ptr %buffer, i64 0, i64 0
      %fits = icmp ule i64 %length, 259
      br i1 %fits, label %copy, label %failure
    copy:
      %copied = call i32 @sollang_owned_file_copy_path(ptr %path, i64 %length, ptr %buffer_ptr)
      %no_nul = call i32 @sollang_owned_file_path_has_no_nul(ptr %path, i64 %length)
      %valid = and i32 %copied, %no_nul
      %valid_path = icmp ne i32 %valid, 0
      br i1 %valid_path, label %remove, label %failure
    remove:
      %removed = call i32 @unlink(ptr %buffer_ptr)
      %success = icmp eq i32 %removed, 0
      br i1 %success, label %removed_file, label %classify
    classify:
      %errno_ptr = call ptr @__errno_location()
      %errno = load i32, ptr %errno_ptr, align 4
      %missing = icmp eq i32 %errno, 2
      %status = select i1 %missing, i32 0, i32 -1
      ret i32 %status
    removed_file:
      ret i32 1
    failure:
      ret i32 -1
    }

    define internal %sollang.file_handle_result @sollang_platform_open_owned_read_file(ptr %path, i64 %length) {
    entry:
      %buffer = alloca [4096 x i8], align 1
      %buffer_ptr = getelementptr inbounds [4096 x i8], ptr %buffer, i64 0, i64 0
      %copied = call i32 @sollang_owned_file_copy_path(ptr %path, i64 %length, ptr %buffer_ptr)
      %valid_path = icmp ne i32 %copied, 0
