    define internal i32 @sollang_platform_create_directory(ptr %path, i64 %len, i32 %style) {
    entry:
      %style_ok = icmp eq i32 %style, 1
      %length_ok = icmp ule i64 %len, 32766
      %valid = and i1 %style_ok, %length_ok
