      %size_high_ptr = getelementptr i8, ptr %information, i64 32
      %size_high32 = load i32, ptr %size_high_ptr, align 4
      %size_low_ptr = getelementptr i8, ptr %information, i64 36
      %size_low32 = load i32, ptr %size_low_ptr, align 4
      %size_high = zext i32 %size_high32 to i64
      %size_low = zext i32 %size_low32 to i64
      %size_shifted = shl i64 %size_high, 32
      %size = or i64 %size_shifted, %size_low
      %time_low_ptr = getelementptr i8, ptr %information, i64 20
      %time_low32 = load i32, ptr %time_low_ptr, align 4
      %time_high_ptr = getelementptr i8, ptr %information, i64 24
      %time_high32 = load i32, ptr %time_high_ptr, align 4
      %time_low = zext i32 %time_low32 to i64
      %time_high = zext i32 %time_high32 to i64
      %time_shifted = shl i64 %time_high, 32
      %file_time = or i64 %time_shifted, %time_low
      %unix_ticks = sub i64 %file_time, 116444736000000000
      %modified_nanos = mul i64 %unix_ticks, 100
      call void @sollang_free(ptr %canonical_wide)
      %closed = call i32 @CloseHandle(ptr %handle)
      %result0 = insertvalue %sollang.path_query_result poison, ptr %canonical_utf8, 0
      %result1 = insertvalue %sollang.path_query_result %result0, i64 %utf8_bytes64, 1
      %result2 = insertvalue %sollang.path_query_result %result1, i8 %kind, 2
      %result3 = insertvalue %sollang.path_query_result %result2, i64 %size, 3
      %result4 = insertvalue %sollang.path_query_result %result3, i64 %modified_nanos, 4
      %result5 = insertvalue %sollang.path_query_result %result4, i32 1, 5
      ret %sollang.path_query_result %result5
    utf8_fail:
      call void @sollang_free(ptr %canonical_utf8)
      br label %canonical_wide_fail
    canonical_wide_fail:
      call void @sollang_free(ptr %canonical_wide)
      br label %handle_fail
    handle_fail:
      %failed_closed = call i32 @CloseHandle(ptr %handle)
      br label %fail
    input_fail:
      call void @sollang_free(ptr %wide_input)
      br label %fail
    fail:
      %failure_path0 = insertvalue %sollang.path_query_result poison, ptr null, 0
      %failure_path1 = insertvalue %sollang.path_query_result %failure_path0, i64 0, 1
      %failure_path2 = insertvalue %sollang.path_query_result %failure_path1, i8 3, 2
      %failure_path3 = insertvalue %sollang.path_query_result %failure_path2, i64 0, 3
      %failure_path4 = insertvalue %sollang.path_query_result %failure_path3, i64 0, 4
      %failure_path5 = insertvalue %sollang.path_query_result %failure_path4, i32 0, 5
      ret %sollang.path_query_result %failure_path5
    }
    """ -> println
}

emitStandardInputSourceTextBody: -> Unit uses Console {
    """
    define %sollang.source_text @sollang_runtime_read_standard_input() {
    entry:
      %buffer_slot = alloca ptr, align 8
      %length_slot = alloca i64, align 8
      %capacity_slot = alloca i64, align 8
      %initial = call ptr @sollang_alloc(i64 4096)
      %initial_ok = icmp ne ptr %initial, null
      br i1 %initial_ok, label %initialize, label %failure
    initialize:
      store ptr %initial, ptr %buffer_slot, align 8
      store i64 0, ptr %length_slot, align 8
      store i64 4096, ptr %capacity_slot, align 8
      br label %read
    read:
      %buffer = load ptr, ptr %buffer_slot, align 8
      %length = load i64, ptr %length_slot, align 8
      %capacity = load i64, ptr %capacity_slot, align 8
      %available = sub i64 %capacity, %length
      %destination = getelementptr i8, ptr %buffer, i64 %length
      %count = call i64 @sollang_runtime_read_standard_input_chunk(ptr %destination, i64 %available)
      %read_failed = icmp slt i64 %count, 0
      br i1 %read_failed, label %release_failure, label %advance
    advance:
      %eof = icmp eq i64 %count, 0
      %next_length = add i64 %length, %count
      store i64 %next_length, ptr %length_slot, align 8
      br i1 %eof, label %success, label %inspect_capacity
    inspect_capacity:
      %full = icmp eq i64 %next_length, %capacity
      br i1 %full, label %grow, label %read
    grow:
      %next_capacity = mul i64 %capacity, 2
      %resized = call ptr @sollang_resize(ptr %buffer, i64 %next_length, i64 %next_capacity)
      %resize_ok = icmp ne ptr %resized, null
      br i1 %resize_ok, label %store_resize, label %release_failure
    store_resize:
      store ptr %resized, ptr %buffer_slot, align 8
      store i64 %next_capacity, ptr %capacity_slot, align 8
      br label %read
    success:
      %final_buffer = load ptr, ptr %buffer_slot, align 8
      %final_length = load i64, ptr %length_slot, align 8
      %result0 = insertvalue %sollang.source_text poison, ptr %final_buffer, 0
      %result1 = insertvalue %sollang.source_text %result0, i64 %final_length, 1
      %result2 = insertvalue %sollang.source_text %result1, ptr %final_buffer, 2
      %result3 = insertvalue %sollang.source_text %result2, i64 -1, 3
      ret %sollang.source_text %result3
    release_failure:
      %failed_buffer = load ptr, ptr %buffer_slot, align 8
      call void @sollang_free(ptr %failed_buffer)
      br label %failure
    failure:
      call void @llvm.trap()
      unreachable
    }
    """ -> println
    """
    define %sollang.source_text @sollang_runtime_read_standard_input_chunk_once(i64 %capacity) {
    entry:
      %zero_capacity = icmp eq i64 %capacity, 0
      %allocation_size = select i1 %zero_capacity, i64 1, i64 %capacity
      %buffer = call ptr @sollang_alloc(i64 %allocation_size)
      %allocated = icmp ne ptr %buffer, null
      br i1 %allocated, label %read, label %failure
    read:
      %count = call i64 @sollang_runtime_read_standard_input_chunk(ptr %buffer, i64 %capacity)
      %read_failed = icmp slt i64 %count, 0
      br i1 %read_failed, label %release_failure, label %success
    success:
      %result0 = insertvalue %sollang.source_text poison, ptr %buffer, 0
      %result1 = insertvalue %sollang.source_text %result0, i64 %count, 1
      %result2 = insertvalue %sollang.source_text %result1, ptr %buffer, 2
      %result3 = insertvalue %sollang.source_text %result2, i64 -1, 3
      ret %sollang.source_text %result3
    release_failure:
      call void @sollang_free(ptr %buffer)
      br label %failure
    failure:
      call void @llvm.trap()
      unreachable
    }
    """ -> println
}

