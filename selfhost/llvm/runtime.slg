public emitGlobalBinaryFileRuntime windows: Bool, flushOutput: Bool -> Unit uses Console {
    "define internal void @sollang_binary_failure() noreturn {" -> println
    "entry:" -> println
    flushOutput -> if { "  call void @sollang_runtime_flush_stdout()" -> println }
    windows -> if { "  call void @ExitProcess(i32 1)" -> println } else { "  call void @exit(i32 1)" -> println }
    "  unreachable" -> println
    "}" -> println
    """
    @sollang_binary_writer_handle = internal global i64 -1
    @sollang_binary_writer_offset = internal global i64 0
    @sollang_binary_reader_handle = internal global i64 -1
    @sollang_binary_reader_offset = internal global i64 0

