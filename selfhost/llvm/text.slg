emitCore context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Unit uses Console, Process {
    context -> emitCoreWithEntry(state, true)
}

prepareCodegenFunctionGroups context: ref emitterContext.EmitContext, state: ref CoreEmitterState -> Result<codegenUnits.FunctionGroups, codegenUnits.FunctionGroupError> {
    [Int; ~] => starts!
    [Int; ~] => lengths!
    [UInt64; ~] => words!
    0 => source!
    source! < (context.sources -> len) -> while {
        words! -> len => start
        starts! -> push(start)
        context.sources[source!] -> modules.appendLogicalNameWords(context.modules[source!], context.ranges[source!], context.tokens, words!)
        lengths! -> push((words! -> len) - start)
        source! + 1 => source!
    }
    codegenUnits.ModuleNames { starts: starts!, lengths: lengths!, words: words! } => names
    [codegenUnits.ModuleFunction; ~] => functions!
    0 => index!
    index! < (context.ir -> len) -> while {
        context.ir[index!].kind == 0
            and (index! -> nativeFunctionReachable(state))
            and not (context.ir[index!] -> isIntrinsicDeclaration)
            and not (context.ir[index!] -> isComFunction(context, state))
            and not (index! -> isStreamFunctionIr(context, state))
            -> if { functions! -> push(codegenUnits.ModuleFunction { functionIndex: index!, sourceIndex: context.ir[index!].sourceModule }) }
        index! + 1 => index!
    }
    functions! -> sortCodegenFunctions(context)
    functions! -> codegenUnits.planFunctions(names)
}

emitCodegenFunction functionIndex: Int, context: ref emitterContext.EmitContext, state: ref CoreEmitterState, usesAes: Bool -> Int uses Console, Process {
    usesAes and (functionIndex -> isAes128EncryptBlockFunction(context, state))
        -> if { functionIndex -> emitAes128FunctionSet(context, state) -> return }
    functionIndex -> emitFunction(context, state)
}

emitCodegenModule groupIndex: Int, groups: ref codegenUnits.FunctionGroups, context: ref emitterContext.EmitContext, state: ref CoreEmitterState, usesAes: Bool, streamed: Bool -> Int uses Console, Process {
    streamed -> if {
        groups.sources[groupIndex] => source
        [UInt64; ~] => words!
        context.sources[source] -> modules.appendLogicalNameWords(context.modules[source], context.ranges[source], context.tokens, words!)
        [UInt8; ~] => bytes!
        words! -> each word { bytes! -> push(UInt8(word)) }
        bytes! -> file.borrowBytes => owner
        owner -> slice(0, owner -> len) => identity
        1 -> codegenUnits.beginStreamedUnit(identity)
    }
    groups.starts[groupIndex] => first
    first + groups.lengths[groupIndex] => end
    first => index!
    index! < end -> while {
        groups.functions[index!] -> emitCodegenFunction(context, state, usesAes) => functionEnd
        index! + 1 => index!
    }
    end
}

emitCoreWithEntry context: ref emitterContext.EmitContext, state: ref CoreEmitterState, emitEntry: Bool -> Unit uses Console, Process {
    context -> emitCoreWithUnitStream(state, emitEntry, false)
}

emitCoreWithUnitStream context: ref emitterContext.EmitContext, state: ref CoreEmitterState, emitEntry: Bool, streamed: Bool -> Unit uses Console, Process {
    context.symbolNames.status != 0 -> if {
        "; sollang compiler invariant: invalid declaration symbol names" -> println
        process.exit(1)
    }
    context -> prepareCodegenFunctionGroups(state) -> when {
        Ok(groups) { context -> emitCoreFunctionGroupsWithEntry(state, emitEntry, groups, streamed) }
        Err(_) {
            "; sollang compiler invariant: invalid codegen function grouping" -> println
            process.exit(1)
        }
    }
}

emitCoreFunctionGroupsWithEntry context: ref emitterContext.EmitContext, state: ref CoreEmitterState, emitEntry: Bool, groups: ref codegenUnits.FunctionGroups, streamed: Bool -> Unit uses Console, Process {
    context -> emitCorePreambleFeatures(false, state) => coreFeatures
    context -> emitRuntimeTaskResultCompletionFunctions(state)
    coreFeatures.usesArguments => usesArguments
    coreFeatures.usesNativeInterop => usesNativeInterop
    coreFeatures.usesComInterop => usesComInterop
    context -> usesAes128CpuSpecialization(state) => usesAes128Specialization
    context.pointerBitWidth / 8 => entryPointerAlignment
    [Int; ~] => moduleIndices!
    0..<(groups.sources -> len) -> each index { moduleIndices! -> push(index) }
    moduleIndices! -> parallel groupIndex {
        groupIndex -> emitCodegenModule(groups, context, state, usesAes128Specialization, streamed)
    } => moduleEmissionEnds
    streamed -> if { 2 -> codegenUnits.beginStreamedUnit("") }
    0 => functionIndex!
    functionIndex! < (context.ir -> len) -> while {
        context.ir[functionIndex!] => function
        function.kind == 11 and emitEntry -> if {
            functionIndex! + 1 => entryEnd!
            entryEnd! < (context.ir -> len) and context.ir[entryEnd!].kind != 0 and context.ir[entryEnd!].kind != 11
                -> while { entryEnd! + 1 => entryEnd! }
            context.pointerBitWidth == 32 -> if {
                "define i32 @sollang_start() {" -> println
            } else {
                usesArguments and context.expectedPathStyle != 1
                    -> if { "define i32 @main(i32 %argc, ptr %argv) {" -> println } else { "define i32 @main() {" -> println }
            }
            "entry:" -> println
            functionIndex! -> emitHoistedControlAllocas(functionIndex! + 1, entryEnd!, true, false, context, state)
            functionIndex! -> emitHoistedReferenceArgumentAllocas(functionIndex! + 1, entryEnd!, context, state)
            usesNativeInterop -> if { "  call void @sollang_native_init()" -> println }
            usesComInterop -> if { "  call void @sollang_com_init()" -> println }
            usesArguments and context.pointerBitWidth != 32
                -> if {
                    context.expectedPathStyle == 1 -> if {
                        "  %arguments_ok = call i32 @sollang_init_arguments()" -> println
                        "  %arguments_valid = icmp ne i32 %arguments_ok, 0" -> println
                    } else {
                        "  %argc64 = zext i32 %argc to i64" -> println
                        "  store i64 %argc64, ptr @sollang_argc, align 8" -> println
                        "  store ptr %argv, ptr @sollang_argv, align 8" -> println
                    }
                }
            functionIndex! -> bodyScheduleIndex(state) => entryScheduleIndex
            state.bodySchedules[entryScheduleIndex] -> emitScheduledStreamBody(functionIndex!, entryEnd!, entryPointerAlignment, context, state)
            OwnedDropRequest { regionIndex: functionIndex!, beforeAst: -1, edgeIndex: functionIndex! * 10 + 6, transferredSymbol: -1 } -> emitOwnedDrops([Int; ~], context, state)
            context -> usesReachableAsyncRuntime(state)
                -> if { "  call void @sollang_async_shutdown()" -> println }
            usesComInterop -> if { "  call void @sollang_com_cleanup()" -> println }
            usesNativeInterop -> if { "  call void @sollang_native_cleanup()" -> println }
            context.supportsComputePool and (context -> diagnostics.usesParallelRuntime)
                -> if { "  call void @sollang_compute_shutdown()" -> println }
            context.expectedPathStyle == 1 and (context -> diagnostics.usesEnvironmentRuntime)
                -> if { "  call void @sollang_dispose_environment()" -> println }
            context.expectedPathStyle == 1 and (context -> diagnostics.usesSocketRuntimeWithReachability(state.frozenReachableFunctions))
                -> if { "  call void @sollang_platform_socket_cleanup()" -> println }
            usesArguments and context.expectedPathStyle == 1 and context.pointerBitWidth != 32
                -> if {
                    "  call void @sollang_dispose_arguments()" -> println
                }
            context -> diagnostics.usesTextRuntime -> if { "  call void @sollang_runtime_flush_stdout()" -> println }
            context.pointerBitWidth != 32 and context.expectedPathStyle == 0 and (context -> diagnostics.usesTextRuntime)
                -> if {
                    "  %io_failed = load atomic i8, ptr @sollang_runtime_io_failed monotonic, align 1" -> println
                    "  %exit_code = zext i8 %io_failed to i32" -> println
                    "  ret i32 %exit_code" -> println
                } else {
                    usesArguments and context.expectedPathStyle == 1 and context.pointerBitWidth != 32
                        -> if {
                            "  %exit_code = select i1 %arguments_valid, i32 0, i32 1" -> println
                            "  ret i32 %exit_code" -> println
                        } else {
                            "  ret i32 0" -> println
                        }
                }
            "}" -> println
            entryEnd! => functionIndex!
        } else {
            functionIndex! + 1 => functionIndex!
        }
    }
    # Keep attribute group zero authoritative. LLVM assigns group zero to
    # llvm.trap when this line is absent, which would make every runtime helper
    # carrying #0 cold+noreturn and lets O1 miscompile returning platform calls.
    context -> diagnostics.usesSocketRuntimeWithReachability(state.frozenReachableFunctions)
        -> if {
            "attributes #0 = { nounwind }" -> println
        }
}
