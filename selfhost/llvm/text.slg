namespace sollang.compiler.llvm.text

import sollang.compiler.ast as ast
import sollang.compiler.ir.interpolation as interpolation
import sollang.compiler.ir.stream as streamIr
import sollang.compiler.ir.typed as typedIr
import sollang.compiler.llvm.target as llvmTarget
import sollang.compiler.llvm.runtime as llvmRuntime
import sollang.compiler.llvm.emitter.number_format as numberFormat
import sollang.compiler.llvm.emitter.compute_runtime as computeRuntime
import sollang.compiler.llvm.emitter.text_output_runtime as textOutputRuntime
import sollang.compiler.llvm.emitter.process_runtime as processRuntime
import sollang.compiler.llvm.emitter.mouse_event_runtime as mouseEventRuntime
import sollang.compiler.llvm.emitter.com_runtime as comRuntime
import sollang.compiler.llvm.emitter.ownership as ownershipEmitter
import sollang.compiler.llvm.emitter.context as emitterContext
import sollang.compiler.llvm.emitter.diagnostics as diagnostics
import sollang.compiler.llvm.emitter.type_queries as typeQueries
import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.calls as calls
import sollang.compiler.semantic.composite_types as compositeTypes
import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.expression_type_ids as expressionTypeIds
import sollang.compiler.semantic.modules as modules
import sollang.compiler.semantic.nominal_types as nominalTypes
import sollang.compiler.semantic.ownership_check as ownershipCheck
import sollang.compiler.semantic.symbols as symbols
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.syntax as syntax
import syntax.generated.slg as grammar
import sys.file as file

emitCore context: ref emitterContext.EmitContext -> Unit uses Console {
    borrowCoreState value: ref CoreEmitterState -> ref CoreEmitterState {
        value
    }

    snapshotIntArray values: [Int; ~] -> [Int; ~] {
        [Int; ~] => snapshot!
        values -> each value {
            snapshot! -> push(value)
        }
        snapshot!
    }
    snapshotBoolArray values: [Bool; ~] -> [Bool; ~] {
        [Bool; ~] => snapshot!
        values -> each value { snapshot! -> push(value) }
        snapshot!
    }

    computeFunctionEnd functionIndex: Int -> Int {
        functionIndex + 1 => end!
        (end! < (context.ir -> len) and context.ir[end!].kind != 0 and context.ir[end!].kind != 11) -> while { end! + 1 => end! }
        end!
    }
    computeFunctionCaptures functionIndex: Int -> [Int; ~] {
        [Int; ~] => captures!
        context.ir[functionIndex] => targetFunction
        functionIndex -> computeFunctionEnd => targetEnd
        -1 => captureOuterAst!
        targetFunction.astNode >= 0 -> if {
            context.ranges[targetFunction.sourceModule] => captureSourceRange
            context.nodes[captureSourceRange.astStart + targetFunction.astNode].parent => captureAncestor!
            (captureAncestor! >= 0 and captureOuterAst! < 0) -> while {
                context.nodes[captureSourceRange.astStart + captureAncestor!] => captureAncestorNode
                captureAncestorNode.kind == 7 -> if { captureAncestor! => captureOuterAst! } else { captureAncestorNode.parent => captureAncestor! }
            }
        }
        [Int; ~] => captureFunctions!
        captureFunctions! -> push(functionIndex)
        0 => captureFunctionIndex!
        captureFunctionIndex! < (captureFunctions! -> len) -> while {
            captureFunctions![captureFunctionIndex!] => currentFunctionIndex
            context.ir[currentFunctionIndex] => currentFunction
            currentFunctionIndex -> computeFunctionEnd => currentFunctionEnd
            currentFunctionIndex + 1 => useIndex!
            useIndex! < currentFunctionEnd -> while {
                context.ir[useIndex!] => use
                (use.kind == 5 and use.operand0 < 0 and use.symbol >= 0 and not (currentFunction.operand1 >= 0 and use.symbol == context.ir[currentFunction.operand1].symbol)) -> if {
                    -1 => bindingIndex!
                    (use.sourceModule >= 0 and use.sourceModule < (context.ranges -> len)) -> if {
                        context.ranges[use.sourceModule].symbolStart + use.symbol => bindingSymbolIndex
                        (bindingSymbolIndex >= 0 and bindingSymbolIndex < (captureBindingBySymbol! -> len)) -> if {
                            captureBindingBySymbol![bindingSymbolIndex] => bindingCandidateIndex!
                            (bindingCandidateIndex! >= 0 and bindingIndex! < 0) -> while {
                                (bindingCandidateIndex! < currentFunctionIndex or bindingCandidateIndex! >= currentFunctionEnd) -> if {
                                    bindingCandidateIndex! => bindingIndex!
                                } else {
                                    capturePreviousBindingByIr![bindingCandidateIndex!] => bindingCandidateIndex!
                                }
                            }
                        }
                    }
                    (bindingIndex! >= 0 and (bindingIndex! < functionIndex or bindingIndex! >= targetEnd)) -> if {
                        false => duplicate!
                        0 => captureSearch!
                        captureSearch! < (captures! -> len) -> while {
                            captures![captureSearch!] == bindingIndex! -> if { true => duplicate! }
                            captureSearch! + 1 => captureSearch!
                        }
                        not duplicate! -> if { captures! -> push(bindingIndex!) }
                    }
                }
                (use.kind == 6 and use.targetModule >= 0 and use.symbol >= 0) -> if {
                    -1 => calledFunctionIndex!
                    use.targetModule < (context.ranges -> len) -> if {
                        context.ranges[use.targetModule].symbolStart + use.symbol => calledFunctionSymbolIndex
                        (calledFunctionSymbolIndex >= 0 and calledFunctionSymbolIndex < (captureFunctionBySymbol! -> len)) -> if {
                            captureFunctionBySymbol![calledFunctionSymbolIndex] => calledFunctionIndex!
                        }
                    }
                    calledFunctionIndex! >= 0 -> if {
                        false => calledFunctionInClosure!
                        context.ir[calledFunctionIndex!] => calledFunction
                        (captureOuterAst! >= 0 and calledFunction.sourceModule == targetFunction.sourceModule and calledFunction.astNode >= 0) -> if {
                            context.ranges[calledFunction.sourceModule] => calledFunctionRange
                            context.nodes[calledFunctionRange.astStart + calledFunction.astNode].parent => calledFunctionAncestor!
                            (calledFunctionAncestor! >= 0 and not calledFunctionInClosure!) -> while {
                                calledFunctionAncestor! == captureOuterAst! -> if { true => calledFunctionInClosure! } else { context.nodes[calledFunctionRange.astStart + calledFunctionAncestor!].parent => calledFunctionAncestor! }
                            }
                        }
                        false => calledFunctionVisited!
                        0 => visitedFunctionSearch!
                        visitedFunctionSearch! < (captureFunctions! -> len) -> while {
                            captureFunctions![visitedFunctionSearch!] == calledFunctionIndex! -> if { true => calledFunctionVisited! }
                            visitedFunctionSearch! + 1 => visitedFunctionSearch!
                        }
                        (calledFunctionInClosure! and not calledFunctionVisited!) -> if { captureFunctions! -> push(calledFunctionIndex!) }
                    }
                }
                useIndex! + 1 => useIndex!
            }
            captureFunctionIndex! + 1 => captureFunctionIndex!
        }
        captures!
    }
    [Int; ~] => functionEndCache!
    0 => structuralCacheInit!
    structuralCacheInit! < (context.ir -> len) -> while {
        functionEndCache! -> push(-1)
        structuralCacheInit! + 1 => structuralCacheInit!
    }
    0 => structuralFunctionIndex!
    structuralFunctionIndex! < (context.ir -> len) -> while {
        (context.ir[structuralFunctionIndex!].kind == 0 or context.ir[structuralFunctionIndex!].kind == 11) -> if {
            structuralFunctionIndex! -> computeFunctionEnd => structuralFunctionEnd
            structuralFunctionEnd => functionEndCache![structuralFunctionIndex!]
        }
        structuralFunctionIndex! + 1 => structuralFunctionIndex!
    }
    [Int; ~] => captureBindingBySymbol!
    [Int; ~] => captureFunctionBySymbol!
    [Int; ~] => capturePreviousBindingByIr!
    0 => captureSymbolInit!
    captureSymbolInit! < (context.symbols -> len) -> while {
        captureBindingBySymbol! -> push(-1)
        captureFunctionBySymbol! -> push(-1)
        captureSymbolInit! + 1 => captureSymbolInit!
    }
    0 => captureBindingLinkInit!
    captureBindingLinkInit! < (context.ir -> len) -> while {
        capturePreviousBindingByIr! -> push(-1)
        captureBindingLinkInit! + 1 => captureBindingLinkInit!
    }
    0 => captureSymbolNodeIndex!
    captureSymbolNodeIndex! < (context.ir -> len) -> while {
        context.ir[captureSymbolNodeIndex!] => captureSymbolNode
        (captureSymbolNode.sourceModule >= 0 and captureSymbolNode.sourceModule < (context.ranges -> len) and captureSymbolNode.symbol >= 0) -> if {
            context.ranges[captureSymbolNode.sourceModule].symbolStart + captureSymbolNode.symbol => captureGlobalSymbolIndex
            (captureGlobalSymbolIndex >= 0 and captureGlobalSymbolIndex < (context.symbols -> len)) -> if {
                (captureSymbolNode.kind == 17 or captureSymbolNode.kind == 10) -> if {
                    captureBindingBySymbol![captureGlobalSymbolIndex] => capturePreviousBindingByIr![captureSymbolNodeIndex!]
                    captureSymbolNodeIndex! => captureBindingBySymbol![captureGlobalSymbolIndex]
                }
                captureSymbolNode.kind == 0 -> if {
                    captureSymbolNodeIndex! => captureFunctionBySymbol![captureGlobalSymbolIndex]
                }
            }
        }
        captureSymbolNodeIndex! + 1 => captureSymbolNodeIndex!
    }
    [Int; ~] => functionCaptureCacheOffsets!
    [Int; ~] => functionCaptureCacheCounts!
    [Int; ~] => functionCaptureCacheValues!
    0 => functionCaptureCacheInit!
    functionCaptureCacheInit! < (context.ir -> len) -> while {
        functionCaptureCacheOffsets! -> push(-1)
        functionCaptureCacheCounts! -> push(0)
        functionCaptureCacheInit! + 1 => functionCaptureCacheInit!
    }
    0 => functionCaptureCacheFunctionIndex!
    functionCaptureCacheFunctionIndex! < (context.ir -> len) -> while {
        context.ir[functionCaptureCacheFunctionIndex!].kind == 0 -> if {
            functionCaptureCacheFunctionIndex! -> computeFunctionCaptures => computedCaptures!
            functionCaptureCacheValues! -> len => computedCaptureStart
            0 => computedCaptureIndex!
            computedCaptureIndex! < (computedCaptures! -> len) -> while {
                functionCaptureCacheValues! -> push(computedCaptures![computedCaptureIndex!])
                computedCaptureIndex! + 1 => computedCaptureIndex!
            }
            computedCaptureStart => functionCaptureCacheOffsets![functionCaptureCacheFunctionIndex!]
            computedCaptureIndex! => functionCaptureCacheCounts![functionCaptureCacheFunctionIndex!]
        }
        functionCaptureCacheFunctionIndex! + 1 => functionCaptureCacheFunctionIndex!
    }
    # The indexes used by parallel emitters are constructed mutably once, then
    # copied into immutable snapshots before worker callbacks can capture them.
    functionEndCache! -> snapshotIntArray => frozenFunctionEnds
    captureFunctionBySymbol! -> snapshotIntArray => frozenCaptureFunctionsBySymbol
    functionCaptureCacheOffsets! -> snapshotIntArray => frozenFunctionCaptureOffsets
    functionCaptureCacheCounts! -> snapshotIntArray => frozenFunctionCaptureCounts
    functionCaptureCacheValues! -> snapshotIntArray => frozenFunctionCaptureValues
    [Bool; ~] => enumMatchConsumed!
    0 => enumMatchInitializeIndex!
    enumMatchInitializeIndex! < (context.ir -> len) -> while {
        enumMatchConsumed! -> push(false)
        enumMatchInitializeIndex! + 1 => enumMatchInitializeIndex!
    }
    0 => enumMatchIndex!
    enumMatchIndex! < (context.ir -> len) -> while {
        context.ir[enumMatchIndex!] => enumMatch
        (enumMatch.kind == 27 and enumMatch.operand0 >= 0 and enumMatch.operand0 < (context.ir -> len)) -> if {
            true => enumMatchConsumed![enumMatch.operand0]
            context.ir[enumMatch.operand0] => enumMatchSubject
            (enumMatchSubject.kind == 5 and enumMatchSubject.operand0 >= 0 and enumMatchSubject.operand0 < (context.ir -> len)) -> if {
                true => enumMatchConsumed![enumMatchSubject.operand0]
            }
        }
        enumMatchIndex! + 1 => enumMatchIndex!
    }
    enumMatchConsumed! -> snapshotBoolArray => frozenEnumMatchConsumed
    context -> diagnostics.usesParallelRuntime => usesComputePool
    -1 => intrinsicRuntimeModule!
    0 => intrinsicRuntimeSearch!
    intrinsicRuntimeSearch! < (context.modules -> len) -> while {
        context.modules[intrinsicRuntimeSearch!] => intrinsicModuleIdentity
        intrinsicModuleIdentity.pathHash == UInt64(12254170256457402476) -> if { intrinsicModuleIdentity.sourceIndex => intrinsicRuntimeModule! }
        intrinsicRuntimeSearch! + 1 => intrinsicRuntimeSearch!
    }
    CoreEmitterState {
        frozenFunctionEnds: frozenFunctionEnds
        frozenCaptureFunctionsBySymbol: frozenCaptureFunctionsBySymbol
        frozenFunctionCaptureOffsets: frozenFunctionCaptureOffsets
        frozenFunctionCaptureCounts: frozenFunctionCaptureCounts
        frozenFunctionCaptureValues: frozenFunctionCaptureValues
        frozenEnumMatchConsumed: frozenEnumMatchConsumed
        intrinsicRuntimeModule: intrinsicRuntimeModule!
    } => stateOwner
    stateOwner -> borrowCoreState => state
    [Int; ~] => dropTypeActive!
    0 => dropTypeActiveIndex!
    dropTypeActiveIndex! < (context.types -> len) -> while {
        dropTypeActive! -> push(0)
        dropTypeActiveIndex! + 1 => dropTypeActiveIndex!
    }
    0 => dropTypeSeedIndex!
    dropTypeSeedIndex! < (context.ir -> len) -> while {
        context.ir[dropTypeSeedIndex!] => dropTypeSeed
        (dropTypeSeed.typeId >= 0
            and dropTypeSeed.typeId < (dropTypeActive! -> len)
            and (dropTypeSeed.typeId -> semanticTypeOwns(context, state))) -> if {
            1 => dropTypeActive![dropTypeSeed.typeId]
        }
        dropTypeSeedIndex! + 1 => dropTypeSeedIndex!
    }
    true => dropTypeChanged!
    dropTypeChanged! -> while {
        false => dropTypeChanged!
        0 => dropTypeClosureIndex!
        dropTypeClosureIndex! < (context.types -> len) -> while {
            dropTypeActive![dropTypeClosureIndex!] == 1 -> if {
                context.types[dropTypeClosureIndex!] => dropClosureType
                (dropClosureType.kind == 3 or dropClosureType.kind == 4 or dropClosureType.kind == 5 or dropClosureType.kind == 6 or dropClosureType.kind == 7) -> if {
                    (dropClosureType.first >= 0 and dropClosureType.first < (dropTypeActive! -> len) and context.typeTraits[dropClosureType.first] % 2 == 1 and dropTypeActive![dropClosureType.first] == 0) -> if {
                        1 => dropTypeActive![dropClosureType.first]
                        true => dropTypeChanged!
                    }
                    (dropClosureType.second >= 0 and dropClosureType.second < (dropTypeActive! -> len) and context.typeTraits[dropClosureType.second] % 2 == 1 and dropTypeActive![dropClosureType.second] == 0) -> if {
                        1 => dropTypeActive![dropClosureType.second]
                        true => dropTypeChanged!
                    }
                }
                (dropClosureType.kind == 1 and (dropClosureType.origin == 0 or dropClosureType.origin == 2)) -> if {
                    0 => dropClosureFieldIndex!
                    dropClosureFieldIndex! < (context.fields -> len) -> while {
                        context.fields[dropClosureFieldIndex!] => dropClosureField
                        (dropClosureField.status == 0 and dropClosureField.ownerType == dropTypeClosureIndex! and dropClosureField.fieldType >= 0 and dropClosureField.fieldType < (dropTypeActive! -> len) and context.typeTraits[dropClosureField.fieldType] % 2 == 1 and dropTypeActive![dropClosureField.fieldType] == 0) -> if {
                            1 => dropTypeActive![dropClosureField.fieldType]
                            true => dropTypeChanged!
                        }
                        dropClosureFieldIndex! + 1 => dropClosureFieldIndex!
                    }
                }
            }
            dropTypeClosureIndex! + 1 => dropTypeClosureIndex!
        }
    }
    false => usesOwnedDropRuntime!
    0 => ownedDropRuntimeIndex!
    ownedDropRuntimeIndex! < (context.types -> len) -> while {
        (dropTypeActive![ownedDropRuntimeIndex!] == 1 and (context.typeTraits[ownedDropRuntimeIndex!] / 2) % 2 == 1) -> if { true => usesOwnedDropRuntime! }
        ownedDropRuntimeIndex! + 1 => ownedDropRuntimeIndex!
    }
    false => usesSourceText!
    context -> diagnostics.usesStandardInputSourceTextRuntime => usesStandardInputSourceText!
    0 => sourceTextTypeSearch!
    sourceTextTypeSearch! < (context.ir -> len) -> while {
        context.ir[sourceTextTypeSearch!] -> typeQueries.isSourceText -> if { true => usesSourceText! }
        sourceTextTypeSearch! + 1 => sourceTextTypeSearch!
    }
    usesSourceText! -> if { "%sollang.source_text = type { ptr, i64, ptr, i64 }" -> println }
    context -> diagnostics.usesOwnedFileRuntime => usesOwnedFile!
    usesOwnedFile! -> if {
        "%sollang.file_handle_result = type { i64, i32 }" -> println
        "%sollang.file_count_result = type { i64, i32 }" -> println
        """
        @sollang_file_error_io = private constant [2 x i8] c"io"
        @sollang_file_error_truncated = private constant [9 x i8] c"truncated"
        @sollang_file_error_invalid = private constant [7 x i8] c"invalid"
        """ -> println
    }
    context -> diagnostics.usesDirectoryRuntime => usesDirectoryTraversal
    usesDirectoryTraversal -> if {
        "%sollang.directory_result = type { ptr, i64, i64, i32 }" -> println
        "%sollang.path_query_result = type { ptr, i64, i8, i64, i64, i32 }" -> println
        "%sollang.directory_node = type { ptr, i64, i8, [7 x i8] }" -> println
        """
        @sollang_directory_error_io = private constant [2 x i8] c"io"
        """ -> println
        context.pointerBitWidth == 32 -> if {
            """
            define internal i32 @sollang_platform_create_directory(ptr %path, i64 %len, i32 %style) {
            entry:
              ret i32 0
            }
            define internal %sollang.directory_result @sollang_platform_read_directory(ptr %path, i64 %len, i32 %style) {
            entry:
              ret %sollang.directory_result zeroinitializer
            }
            define internal %sollang.path_query_result @sollang_platform_query_path(ptr %path, i64 %len, i32 %style) {
            entry:
              %failure0 = insertvalue %sollang.path_query_result poison, ptr null, 0
              %failure1 = insertvalue %sollang.path_query_result %failure0, i64 0, 1
              %failure2 = insertvalue %sollang.path_query_result %failure1, i8 3, 2
              %failure3 = insertvalue %sollang.path_query_result %failure2, i64 0, 3
              %failure4 = insertvalue %sollang.path_query_result %failure3, i64 0, 4
              %failure5 = insertvalue %sollang.path_query_result %failure4, i32 0, 5
              ret %sollang.path_query_result %failure5
            }
            """ -> println
        }
    }
    # Primitive named types must be complete before nominal types and drop
    # helpers use them as sized fields or getelementptr base elements.
    false => usesText!
    0 => textTypeSearch!
    textTypeSearch! < (context.ir -> len) -> while {
        context.ir[textTypeSearch!].typeSymbol == 1 -> if { true => usesText! }
        textTypeSearch! + 1 => textTypeSearch!
    }
    (usesSourceText! or usesOwnedFile!) -> if { true => usesText! }
    false => requiresEarlyTextType!
    0 => earlyTextFieldIndex!
    earlyTextFieldIndex! < (context.fields -> len) -> while {
        context.fields[earlyTextFieldIndex!] => earlyTextField
        (earlyTextField.status == 0 and earlyTextField.ownerType >= 0 and earlyTextField.ownerType < (dropTypeActive! -> len) and dropTypeActive![earlyTextField.ownerType] == 1 and earlyTextField.fieldType >= 0 and earlyTextField.fieldType < (context.types -> len)) -> if {
            context.types[earlyTextField.fieldType] => earlyTextFieldType
            (earlyTextFieldType.kind == 1 and earlyTextFieldType.origin == 1 and earlyTextFieldType.symbol == 1) -> if { true => requiresEarlyTextType! }
        }
        earlyTextFieldIndex! + 1 => earlyTextFieldIndex!
    }
    requiresEarlyTextType! -> if { "%sollang.text = type { ptr, i64 }" -> println }
    false => usesTaskType!
    0 => taskTypeSearch!
    taskTypeSearch! < (context.types -> len) -> while {
        context.types[taskTypeSearch!] => taskTypeCandidate
        (taskTypeCandidate.status == 0 and taskTypeCandidate.kind == 7 and taskTypeCandidate.origin == 4 and taskTypeCandidate.symbol == 2) -> if { true => usesTaskType! }
        taskTypeSearch! + 1 => taskTypeSearch!
    }
    usesTaskType! -> if { "%sollang.task = type { ptr, ptr }" -> println }
    false => usesStreamType!
    false => usesEventStreamType!
    0 => producerTypeSearch!
    producerTypeSearch! < (context.types -> len) -> while {
        context.types[producerTypeSearch!] => producerTypeCandidate
        (producerTypeCandidate.status == 0 and producerTypeCandidate.kind == 7 and producerTypeCandidate.origin == 4 and producerTypeCandidate.symbol == 3) -> if { true => usesStreamType! }
        (producerTypeCandidate.status == 0 and producerTypeCandidate.kind == 7 and producerTypeCandidate.origin == 4 and producerTypeCandidate.symbol == 4) -> if { true => usesEventStreamType! }
        producerTypeSearch! + 1 => producerTypeSearch!
    }
    usesStreamType! -> if { "%sollang.stream = type { ptr, ptr, ptr }" -> println }
    usesEventStreamType! -> if { "%sollang.event_stream = type { ptr, ptr, ptr }" -> println }
    -1 => mouseEventTypeId!
    -1 => mouseEventKindTypeId!
    -1 => mouseOverflowTypeId!
    0 => mouseCallSearch!
    mouseCallSearch! < (context.ir -> len) -> while {
        mouseCallSearch! -> isMouseEventsCall(context, state) -> if {
            context.ir[mouseCallSearch!] => mouseCall
            context.types[mouseCall.typeId].first => mouseEventTypeId!
            (mouseCall.operand0 >= 0 and context.ir[mouseCall.operand0].nextOperand >= 0) -> if {
                context.ir[context.ir[mouseCall.operand0].nextOperand].typeId => mouseOverflowTypeId!
            }
        }
        mouseCallSearch! + 1 => mouseCallSearch!
    }
    mouseEventTypeId! >= 0 -> if {
        0 => mouseEventFieldSearch!
        mouseEventFieldSearch! < (context.fields -> len) -> while {
            context.fields[mouseEventFieldSearch!] => mouseEventField
            (mouseEventField.status == 0 and mouseEventField.ownerType == mouseEventTypeId! and mouseEventField.ordinal == 4) -> if {
                mouseEventField.fieldType => mouseEventKindTypeId!
            }
            mouseEventFieldSearch! + 1 => mouseEventFieldSearch!
        }
        "%sollang.enum.t$(mouseEventKindTypeId!) = type { i32, [0 x i64] }" -> println
        "%sollang.enum.t$(mouseOverflowTypeId!) = type { i32, [0 x i64] }" -> println
        context.types[mouseEventTypeId!] => mouseEventType
        mouseEventType.module => mouseEventModule
        mouseEventType.symbol => mouseEventSymbol
        "%sollang.struct.m$(mouseEventModule)_s$(mouseEventSymbol) = type { " -> print
        true => firstMouseEventField!
        0 => mouseEventLayoutFieldIndex!
        mouseEventLayoutFieldIndex! < (context.fields -> len) -> while {
            context.fields[mouseEventLayoutFieldIndex!] => mouseEventLayoutField
            (mouseEventLayoutField.status == 0 and mouseEventLayoutField.ownerType == mouseEventTypeId!) -> if {
                not firstMouseEventField! -> if { ", " -> print }
                mouseEventLayoutField.fieldType -> writeSemanticTypeId(context, state)
                false => firstMouseEventField!
            }
            mouseEventLayoutFieldIndex! + 1 => mouseEventLayoutFieldIndex!
        }
        " }" -> println
        "declare void @llvm.trap()" -> println
        "define internal i1 @sollang_mouse_event_stream_next(ptr %context, ptr %output) {" -> println
        "entry:" -> println
        "  %x = alloca i32, align 4" -> println
        "  %y = alloca i32, align 4" -> println
        "  %delta = alloca i32, align 4" -> println
        "  %button = alloca i32, align 4" -> println
        "  %kind = alloca i32, align 4" -> println
        "  %available = call i1 @sollang_mouse_event_next_raw(ptr %context, ptr %x, ptr %y, ptr %delta, ptr %button, ptr %kind)" -> println
        "  br i1 %available, label %write, label %done" -> println
        "write:" -> println
        "  %x_value = load i32, ptr %x, align 4" -> println
        "  %y_value = load i32, ptr %y, align 4" -> println
        "  %delta_value = load i32, ptr %delta, align 4" -> println
        "  %button_value = load i32, ptr %button, align 4" -> println
        "  %kind_value = load i32, ptr %kind, align 4" -> println
        "  %x_address = getelementptr " -> print
        mouseEventTypeId! -> writeSemanticTypeId(context, state)
        ", ptr %output, i32 0, i32 0" -> println
        "  store i32 %x_value, ptr %x_address, align 4" -> println
        "  %y_address = getelementptr " -> print
        mouseEventTypeId! -> writeSemanticTypeId(context, state)
        ", ptr %output, i32 0, i32 1" -> println
        "  store i32 %y_value, ptr %y_address, align 4" -> println
        "  %delta_address = getelementptr " -> print
        mouseEventTypeId! -> writeSemanticTypeId(context, state)
        ", ptr %output, i32 0, i32 2" -> println
        "  store i32 %delta_value, ptr %delta_address, align 4" -> println
        "  %button_address = getelementptr " -> print
        mouseEventTypeId! -> writeSemanticTypeId(context, state)
        ", ptr %output, i32 0, i32 3" -> println
        "  store i32 %button_value, ptr %button_address, align 4" -> println
        "  %kind0 = insertvalue " -> print
        mouseEventKindTypeId! -> writeSemanticTypeId(context, state)
        " poison, i32 %kind_value, 0" -> println
        "  %kind1 = insertvalue " -> print
        mouseEventKindTypeId! -> writeSemanticTypeId(context, state)
        " %kind0, [0 x i64] zeroinitializer, 1" -> println
        "  %kind_address = getelementptr " -> print
        mouseEventTypeId! -> writeSemanticTypeId(context, state)
        ", ptr %output, i32 0, i32 4" -> println
        "  store " -> print
        mouseEventKindTypeId! -> writeSemanticTypeId(context, state)
        " %kind1, ptr %kind_address, align 8" -> println
        "  ret i1 true" -> println
        "done:" -> println
        "  ret i1 false" -> println
        "}" -> println
        "define internal %sollang.event_stream @sollang_mouse_event_stream_make(i32 %capacity, " -> print
        mouseOverflowTypeId! -> writeSemanticTypeId(context, state)
        " %overflow) {" -> println
        "entry:" -> println
        "  %overflow_tag = extractvalue " -> print
        mouseOverflowTypeId! -> writeSemanticTypeId(context, state)
        " %overflow, 0" -> println
        "  %context = call ptr @sollang_mouse_event_stream_create(i32 %capacity, i32 %overflow_tag)" -> println
        "  %created = icmp ne ptr %context, null" -> println
        "  br i1 %created, label %ready, label %failed" -> println
        "ready:" -> println
        "  %with_context = insertvalue %sollang.event_stream poison, ptr %context, 0" -> println
        "  %with_next = insertvalue %sollang.event_stream %with_context, ptr @sollang_mouse_event_stream_next, 1" -> println
        "  %result = insertvalue %sollang.event_stream %with_next, ptr @sollang_mouse_event_stream_drop, 2" -> println
        "  ret %sollang.event_stream %result" -> println
        "failed:" -> println
