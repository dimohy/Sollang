                                    "  br label %stream$(entryClosePartitionFirstTerminal)_drop_done" -> println
                                    "stream$(entryClosePartitionFirstTerminal)_drop_done:" -> println
                                    "  br label %partition$(entryClosePartition.junctionIr)_done" -> println
                                }
                                entryClosePartitionRoute == entryClosePartition.routeStart + entryClosePartition.routeCount - 1 -> if {
                                    "partition$(entryClosePartition.junctionIr)_done:" -> println
                                }
                            } else {
                            -1 => entryCloseTakeStage!
                            -1 => entryCloseFlatMapStage!
                            entryCloseStreamPipeline.stageStart => entryCloseStageSearch!
                            entryCloseStageSearch! < entryCloseStreamPipeline.stageStart + entryCloseStreamPipeline.stageCount -> while {
                                context.streamPlan.stages[entryCloseStageSearch!].flags == 1 -> if { entryCloseStageSearch! => entryCloseTakeStage! }
                                context.streamPlan.stages[entryCloseStageSearch!].flags == 3 -> if { entryCloseStageSearch! => entryCloseFlatMapStage! }
                                entryCloseStageSearch! + 1 => entryCloseStageSearch!
                            }
                            entryStreamStops![entryActiveStreamSize! - 1] == 1 -> if {
                                "  br label %stream$(entryCloseStreamPipeline.terminalIr)_exit" -> println
                            } else {
                                "  br label %stream$(entryCloseStreamPipeline.terminalIr)_continue" -> println
                            }
                            "stream$(entryCloseStreamPipeline.terminalIr)_continue:" -> println
                            entryCloseStreamPipeline.status > 0 -> if {
                                "  br label %stream$(entryCloseStreamPipeline.terminalIr)_header" -> println
                            } else {
                            entryCloseFlatMapStage! >= 0 -> if {
                                "  %stream$(entryCloseStreamPipeline.terminalIr)_inner_current = load i32, ptr %stream$(entryCloseStreamPipeline.terminalIr)_inner_index_slot, align 4" -> println
                                "  %stream$(entryCloseStreamPipeline.terminalIr)_inner_next = add i32 %stream$(entryCloseStreamPipeline.terminalIr)_inner_current, 1" -> println
                                "  store i32 %stream$(entryCloseStreamPipeline.terminalIr)_inner_next, ptr %stream$(entryCloseStreamPipeline.terminalIr)_inner_index_slot, align 4" -> println
                                entryCloseTakeStage! >= 0 -> if {
                                    context.streamPlan.stages[entryCloseTakeStage!] => entryCloseInnerTake
                                    "  %stream$(entryCloseStreamPipeline.terminalIr)_taken_done_value = load i32, ptr %stream$(entryCloseStreamPipeline.terminalIr)_slice$(entryCloseTakeStage!)_slot, align 4" -> println
                                    "  %stream$(entryCloseStreamPipeline.terminalIr)_taken_done = icmp sge i32 %stream$(entryCloseStreamPipeline.terminalIr)_taken_done_value, " -> print
                                    WhileValueRequest { whileIndex: entryCloseStreamPipeline.terminalIr, ownerIndex: functionIndex!, nodeIndex: entryCloseInnerTake.argument0 } -> writeWhileValue(context, state)
                                    "" -> println
                                    "  br i1 %stream$(entryCloseStreamPipeline.terminalIr)_taken_done, label %stream$(entryCloseStreamPipeline.terminalIr)_exit, label %stream$(entryCloseStreamPipeline.terminalIr)_inner_header" -> println
                                } else {
                                    "  br label %stream$(entryCloseStreamPipeline.terminalIr)_inner_header" -> println
                                }
                                "stream$(entryCloseStreamPipeline.terminalIr)_inner_exit:" -> println
                                "  br label %stream$(entryCloseStreamPipeline.terminalIr)_outer_continue" -> println
                                "stream$(entryCloseStreamPipeline.terminalIr)_outer_continue:" -> println
                                "  %stream$(entryCloseStreamPipeline.terminalIr)_current = load i32, ptr %stream$(entryCloseStreamPipeline.terminalIr)_index_slot, align 4" -> println
                                "  %stream$(entryCloseStreamPipeline.terminalIr)_next = add i32 %stream$(entryCloseStreamPipeline.terminalIr)_current, 1" -> println
                                "  store i32 %stream$(entryCloseStreamPipeline.terminalIr)_next, ptr %stream$(entryCloseStreamPipeline.terminalIr)_index_slot, align 4" -> println
                                "  br label %stream$(entryCloseStreamPipeline.terminalIr)_header" -> println
                            } else {
                                "  %stream$(entryCloseStreamPipeline.terminalIr)_current = load i32, ptr %stream$(entryCloseStreamPipeline.terminalIr)_index_slot, align 4" -> println
                                "  %stream$(entryCloseStreamPipeline.terminalIr)_next = add i32 %stream$(entryCloseStreamPipeline.terminalIr)_current, 1" -> println
                                "  store i32 %stream$(entryCloseStreamPipeline.terminalIr)_next, ptr %stream$(entryCloseStreamPipeline.terminalIr)_index_slot, align 4" -> println
                                entryCloseTakeStage! >= 0 -> if {
                                    context.streamPlan.stages[entryCloseTakeStage!] => entryCloseTake
                                    "  %stream$(entryCloseStreamPipeline.terminalIr)_taken_done_value = load i32, ptr %stream$(entryCloseStreamPipeline.terminalIr)_slice$(entryCloseTakeStage!)_slot, align 4" -> println
                                    "  %stream$(entryCloseStreamPipeline.terminalIr)_taken_done = icmp sge i32 %stream$(entryCloseStreamPipeline.terminalIr)_taken_done_value, " -> print
                                    WhileValueRequest { whileIndex: entryCloseStreamPipeline.terminalIr, ownerIndex: functionIndex!, nodeIndex: entryCloseTake.argument0 } -> writeWhileValue(context, state)
                                    "" -> println
                                    "  br i1 %stream$(entryCloseStreamPipeline.terminalIr)_taken_done, label %stream$(entryCloseStreamPipeline.terminalIr)_exit, label %stream$(entryCloseStreamPipeline.terminalIr)_header" -> println
                                } else {
                                    "  br label %stream$(entryCloseStreamPipeline.terminalIr)_header" -> println
                                }
                            }
                            }
                            "stream$(entryCloseStreamPipeline.terminalIr)_exit:" -> println
                            entryCloseStreamPipeline.status > 0 -> if {
                                "  %stream$(entryCloseStreamPipeline.terminalIr)_has_drop = icmp ne ptr %stream$(entryCloseStreamPipeline.terminalIr)_producer_drop, null" -> println
                                "  br i1 %stream$(entryCloseStreamPipeline.terminalIr)_has_drop, label %stream$(entryCloseStreamPipeline.terminalIr)_drop, label %stream$(entryCloseStreamPipeline.terminalIr)_drop_done" -> println
                                "stream$(entryCloseStreamPipeline.terminalIr)_drop:" -> println
                                "  call void %stream$(entryCloseStreamPipeline.terminalIr)_producer_drop(ptr %stream$(entryCloseStreamPipeline.terminalIr)_producer_context)" -> println
                                "  br label %stream$(entryCloseStreamPipeline.terminalIr)_drop_done" -> println
                                "stream$(entryCloseStreamPipeline.terminalIr)_drop_done:" -> println
                            }
                            }
                            entryActiveStreamSize! - 1 => entryActiveStreamSize!
                        }
                    }
                    entryOrderIndex! + 1 => entryOrderIndex!
                }
                OwnedDropRequest { regionIndex: functionIndex!, beforeAst: -1, edgeIndex: functionIndex! * 10 + 6, transferredSymbol: -1 } -> emitOwnedDrops(context, state)
                usesComInterop! -> if { "  call void @sollang_com_cleanup()" -> println }
                usesNativeInterop! -> if { "  call void @sollang_native_cleanup()" -> println }
                (context.supportsComputePool and (context -> diagnostics.usesParallelRuntime)) -> if { "  call void @sollang_compute_shutdown()" -> println }
                (context.expectedPathStyle == 1 and (context -> diagnostics.usesEnvironmentRuntime)) -> if { "  call void @sollang_dispose_environment()" -> println }
                context -> diagnostics.usesTextRuntime -> if { "  call void @sollang_runtime_flush_stdout()" -> println }
                "  ret i32 0" -> println
                "}" -> println
                entryEnd! => functionIndex!
            } else {
                functionIndex! + 1 => functionIndex!
            }
    }
    functionIndicesAfterEntry! -> parallel functionEmitIndex {
        functionEmitIndex -> emitFunction(context, state)
    } => functionEmissionStatusesAfterEntry!
}
