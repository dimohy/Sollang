namespace sollang.compiler.lexer

import sollang.compiler.syntax as syntax
import sollang.compiler.syntax.unicode_identifier as unicodeIdentifier
import sollang.compiler.syntax.source_decoding as sourceDecoding
import syntax.generated.slg as grammar
import sys.file as file

lexText source: Text -> [syntax.SyntaxToken; ~] {
    isDigit value: UInt8 -> Bool {
        value >= 48 and value <= 57
    }
    isHorizontalWhitespace value: UInt8 -> Bool {
        value == 32 or value == 9
    }
    source -> sourceDecoding.firstInvalidUtf8Offset -> when {
        Some(offset) {
            [syntax.SyntaxToken; ~] => rejected!
            rejected! -> push(syntax.SyntaxToken {
                kind: grammar.tokenIdInvalid()
                span: syntax.SourceSpan { fileId: 0, start: offset, length: 1 }
            })
            rejected! -> push(syntax.SyntaxToken {
                kind: grammar.tokenIdEnd()
                span: syntax.SourceSpan { fileId: 0, start: source -> len, length: 0 }
            })
            rejected! -> return
        }
        None {}
    }
    [syntax.SyntaxToken; ~] => tokens!
    UIntSize(0) => position!
    source -> len => sourceLength
    grammar.lexerLiteralTexts() => literalTexts
    grammar.lexerLiteralIndexes() => literalIndexes
    grammar.lexerRuleTokens() => ruleTokens

    position! < sourceLength -> while {
        source -> byte(position!) => current
        current -> isHorizontalWhitespace -> if {
            position! => whitespaceStart
            position! + 1 => position!
            position! < sourceLength and ((source -> byte(position!)) -> isHorizontalWhitespace)
                -> while {
                    position! + 1 => position!
                }
            syntax.SyntaxToken {
                kind: grammar.triviaIdWhitespace()
                span: syntax.SourceSpan { fileId: 0, start: whitespaceStart, length: position! - whitespaceStart }
            } => whitespaceToken
            tokens! -> push(whitespaceToken)
        } else {
            current == 35 -> if {
                position! => commentStart
                position! + 1 => position!
                position! < sourceLength and (source -> byte(position!)) != 10 and (source -> byte(position!)) != 13
                    -> while {
                        position! + 1 => position!
                    }
                syntax.SyntaxToken {
                    kind: grammar.triviaIdComment()
                    span: syntax.SourceSpan { fileId: 0, start: commentStart, length: position! - commentStart }
                } => commentToken
                tokens! -> push(commentToken)
            } else {
                current == 10 or current == 13 -> if {
                    UIntSize(1) => newlineWidth!
                    current == 13 and position! + 1 < sourceLength and (source -> byte(position! + 1)) == 10
                        -> if { 2 => newlineWidth! }
                    syntax.SyntaxToken {
                        kind: grammar.tokenIdNewLine()
                        span: syntax.SourceSpan { fileId: 0, start: position!, length: newlineWidth! }
                    } => newlineToken
                    tokens! -> push(newlineToken)
                    position! + newlineWidth! => position!
                } else {
                    source -> unicodeIdentifier.startWidth(position!) => identifierWidth
                    identifierWidth > 0 -> if {
                        position! => identifierStart
                        position! + identifierWidth => position!
                        source -> unicodeIdentifier.continueWidth(position!) => nextIdentifierWidth!
                        nextIdentifierWidth! > 0 -> while {
                            position! + nextIdentifierWidth! => position!
                            source -> unicodeIdentifier.continueWidth(position!) => nextIdentifierWidth!
                        }
                        syntax.SyntaxToken {
                            kind: grammar.tokenIdIdentifier()
                            span: syntax.SourceSpan { fileId: 0, start: identifierStart, length: position! - identifierStart }
                        } => identifierToken
                        tokens! -> push(identifierToken)
                    } else {
                        current -> isDigit -> if {
                            position! => numberStart
                            position! + 1 => position!
                            position! < sourceLength and (((source -> byte(position!)) -> isDigit) or ((source -> byte(position!)) == 95 and position! + 1 < sourceLength and ((source -> byte(position! + 1)) -> isDigit)))
                                -> while {
                                    position! + 1 => position!
                                }
                            position! + 1 < sourceLength and (source -> byte(position!)) == 46 and ((source -> byte(position! + 1)) -> isDigit)
                                -> if {
                                    position! + 1 => position!
                                    position! < sourceLength and (((source -> byte(position!)) -> isDigit) or ((source -> byte(position!)) == 95 and position! + 1 < sourceLength and ((source -> byte(position! + 1)) -> isDigit)))
                                        -> while {
                                            position! + 1 => position!
                                        }
                                }
                            position! < sourceLength and ((source -> byte(position!)) == 101 or (source -> byte(position!)) == 69)
                                -> if {
                                    position! + 1 => position!
                                    position! < sourceLength and ((source -> byte(position!)) == 43 or (source -> byte(position!)) == 45)
                                        -> if {
                                            position! + 1 => position!
                                        }
                                    position! < sourceLength and (((source -> byte(position!)) -> isDigit) or ((source -> byte(position!)) == 95 and position! + 1 < sourceLength and ((source -> byte(position! + 1)) -> isDigit)))
                                        -> while {
                                            position! + 1 => position!
                                        }
                                }
                            syntax.SyntaxToken {
                                kind: grammar.tokenIdNumber()
                                span: syntax.SourceSpan { fileId: 0, start: numberStart, length: position! - numberStart }
                            } => numberToken
                            tokens! -> push(numberToken)
                        } else {
                            current == 39 -> if {
                                position! => characterStart
                                position! + 1 => position!
                                false => characterClosed!
                                false => characterStopped!
                                position! < sourceLength and not characterClosed! and not characterStopped!
                                    -> while {
                                        source -> byte(position!) => characterByte
                                        characterByte == 10 or characterByte == 13 -> if {
                                            true => characterStopped!
                                        } else {
                                            characterByte == 39 -> if {
                                                position! + 1 => position!
                                                true => characterClosed!
                                            } else {
                                                characterByte == 92 and position! + 1 < sourceLength
                                                    -> if { position! + 2 => position! } else { position! + 1 => position! }
                                            }
                                        }
                                    }
                                syntax.SourceSpan { fileId: 0, start: characterStart, length: position! - characterStart } => characterSpan
                                false => characterValid!
                                characterClosed! -> if {
                                    source -> syntax.decodeCharacterLiteral(characterSpan) -> when {
                                        Some(value) { true => characterValid! }
                                        None { }
                                    }
                                }
                                syntax.SyntaxToken {
                                    kind: characterValid! -> if { grammar.tokenIdCharacter() } else { grammar.tokenIdInvalid() }
                                    span: characterSpan
                                } => characterToken
                                tokens! -> push(characterToken)
                            } else {
                                current == 34 -> if {
                                    position! => stringStart
                                    false => rawString!
                                    false => stringClosed!
                                    position! + 2 < sourceLength -> if {
                                        (source -> byte(position! + 1)) == 34 and (source -> byte(position! + 2)) == 34
                                            -> if { true => rawString! }
                                    }
                                    rawString! -> if {
                                        UIntSize(0) => delimiterWidth!
                                        position! + delimiterWidth! < sourceLength and (source -> byte(position! + delimiterWidth!)) == 34
                                            -> while {
                                                delimiterWidth! + 1 => delimiterWidth!
                                            }
                                        position! + delimiterWidth! => position!
                                        false => rawClosed!
                                        position! < sourceLength and not rawClosed!
                                            -> while {
                                                UIntSize(0) => quoteRun!
                                                position! + quoteRun! < sourceLength and (source -> byte(position! + quoteRun!)) == 34
                                                    -> while {
                                                        quoteRun! + 1 => quoteRun!
                                                    }
                                                quoteRun! >= delimiterWidth! -> if { true => rawClosed! }
                                                not rawClosed! -> if { position! + 1 => position! }
                                            }
                                        rawClosed! -> if {
                                            position! + delimiterWidth! => position!
                                            true => stringClosed!
                                        }
                                    } else {
                                        position! + 1 => position!
                                        position! < sourceLength and (source -> byte(position!)) != 34
                                            and (source -> byte(position!)) != 10
                                            and (source -> byte(position!)) != 13
                                            -> while {
                                                position! + 1 => position!
                                            }
                                        position! < sourceLength and (source -> byte(position!)) == 34
                                            -> if {
                                                position! + 1 => position!
                                                true => stringClosed!
                                            }
                                    }
                                    syntax.SyntaxToken {
                                        kind: stringClosed! -> if { grammar.tokenIdString() } else { grammar.tokenIdInvalid() }
                                        span: syntax.SourceSpan { fileId: 0, start: stringStart, length: position! - stringStart }
                                    } => stringToken
                                    tokens! -> push(stringToken)
                                } else {
                                    Int(-1) => kind!
                                    UIntSize(0) => width!
                                    0 => ruleIndex!
                                    ruleIndex! < (literalIndexes -> len) -> while {
                                        literalIndexes[ruleIndex!] => literalIndex
                                        literalIndex >= 0 -> if {
                                            literalTexts[literalIndex] => spelling
                                            spelling -> len => spellingLength
                                            spellingLength > width! and position! + spellingLength <= sourceLength
                                                -> if {
                                                    true => matches!
                                                    UIntSize(0) => characterIndex!
                                                    characterIndex! < spellingLength and matches!
                                                        -> while {
                                                            (source -> byte(position! + characterIndex!)) != (spelling -> byte(characterIndex!))
                                                                -> if { false => matches! }
                                                            characterIndex! + 1 => characterIndex!
                                                        }
                                                    matches! -> if {
                                                        ruleTokens[ruleIndex!] => kind!
                                                        spellingLength => width!
                                                    }
                                                }
                                        }
                                        ruleIndex! + 1 => ruleIndex!
                                    }
                                    kind! < 0 -> if {
                                        1 => width!
                                        source -> unicodeIdentifier.scalarWidth(position!) => invalidWidth
                                        invalidWidth > 0 -> if { invalidWidth => width! }
                                    }
                                    kind! >= 0 -> if {
                                        syntax.SyntaxToken {
                                            kind: kind!
                                            span: syntax.SourceSpan { fileId: 0, start: position!, length: width! }
                                        } => punctuationToken
                                        tokens! -> push(punctuationToken)
                                    } else {
                                        syntax.SyntaxToken {
                                            kind: grammar.tokenIdInvalid()
                                            span: syntax.SourceSpan { fileId: 0, start: position!, length: width! }
                                        } => invalidToken
                                        tokens! -> push(invalidToken)
                                    }
                                    position! + width! => position!
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    syntax.SyntaxToken {
        kind: grammar.tokenIdEnd()
        span: syntax.SourceSpan { fileId: 0, start: sourceLength, length: 0 }
    } => endToken
    tokens! -> push(endToken)
    tokens!
}

public lexSource source: file.SourceText -> [syntax.SyntaxToken; ~] {
    source -> len => sourceLength
    source -> slice(UIntSize(0), sourceLength) => view
    view -> lexText
}

public lex source: Text -> [syntax.SyntaxToken; ~] {
    source -> lexText
}
