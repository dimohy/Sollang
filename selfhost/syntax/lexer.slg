namespace sollang.compiler.lexer

import sollang.compiler.syntax as syntax
import syntax.generated.slg as grammar
import sys.file as file

lexText source: Text -> [syntax.SyntaxToken; ~] {
    isDigit value: UInt8 -> Bool {
        value >= 48 and value <= 57
    }
    isIdentifierStart value: UInt8 -> Bool {
        (value >= 65 and value <= 90) or (value >= 97 and value <= 122) or value == 95 or value >= 128
    }
    isIdentifierContinue value: UInt8 -> Bool {
        value -> isIdentifierStart => start
        value -> isDigit => digit
        start or digit
    }
    isHorizontalWhitespace value: UInt8 -> Bool {
        value == 32 or value == 9 or value == 13
    }
    tripleKind first: UInt8, second: UInt8, third: UInt8 -> Int {
        -1 => kind!
        first == 46 and second == 46 and third == 60 -> if {
            grammar.tokenIdRangeUntil() => kind!
        }
        kind! => result
        result
    }
    pairKind value: UInt16 -> Int {
        -1 => kind!
        value == 11822 -> if { grammar.tokenIdRange() => kind! }
        value == 11582 -> if { grammar.tokenIdArrow() => kind! }
        value == 15678 -> if { grammar.tokenIdFatArrow() => kind! }
        value == 15677 -> if { grammar.tokenIdEqualEqual() => kind! }
        value == 8509 -> if { grammar.tokenIdBangEqual() => kind! }
        value == 15421 -> if { grammar.tokenIdLessEqual() => kind! }
        value == 15933 -> if { grammar.tokenIdGreaterEqual() => kind! }
        kind! => result
        result
    }
    singleKind value: UInt8 -> Int {
        -1 => kind!
        value == 123 -> if { grammar.tokenIdLeftBrace() => kind! }
        value == 125 -> if { grammar.tokenIdRightBrace() => kind! }
        value == 91 -> if { grammar.tokenIdLeftBracket() => kind! }
        value == 93 -> if { grammar.tokenIdRightBracket() => kind! }
        value == 40 -> if { grammar.tokenIdLeftParen() => kind! }
        value == 41 -> if { grammar.tokenIdRightParen() => kind! }
        value == 126 -> if { grammar.tokenIdTilde() => kind! }
        value == 46 -> if { grammar.tokenIdDot() => kind! }
        value == 44 -> if { grammar.tokenIdComma() => kind! }
        value == 59 -> if { grammar.tokenIdSemicolon() => kind! }
        value == 43 -> if { grammar.tokenIdPlus() => kind! }
        value == 45 -> if { grammar.tokenIdMinus() => kind! }
        value == 42 -> if { grammar.tokenIdStar() => kind! }
        value == 47 -> if { grammar.tokenIdSlash() => kind! }
        value == 37 -> if { grammar.tokenIdPercent() => kind! }
        value == 63 -> if { grammar.tokenIdQuestion() => kind! }
        value == 58 -> if { grammar.tokenIdColon() => kind! }
        value == 33 -> if { grammar.tokenIdBang() => kind! }
        value == 60 -> if { grammar.tokenIdLess() => kind! }
        value == 62 -> if { grammar.tokenIdGreater() => kind! }
        value == 61 -> if { grammar.tokenIdEqual() => kind! }
        kind! => result
        result
    }
    [syntax.SyntaxToken; ~] => tokens!
    UIntSize(0) => position!
    source -> len => sourceLength

    position! < sourceLength -> while {
        source -> byte(position!) => current
        current -> isHorizontalWhitespace -> if {
            position! => whitespaceStart
            position! + 1 => position!
            (position! < sourceLength and ((source -> byte(position!)) -> isHorizontalWhitespace))
                -> while {
                position! + 1 => position!
            }
            syntax.SyntaxToken {
                kind: grammar.triviaIdWhitespace()
                span: syntax.SourceSpan { fileId: 0, start: whitespaceStart, length: position! - whitespaceStart }
            } => whitespaceToken
            tokens! -> push(whitespaceToken)
        } else {
            current == 35 -> if {
                position! => commentStart
                position! + 1 => position!
                (position! < sourceLength and (source -> byte(position!)) != 10)
                    -> while {
                    position! + 1 => position!
                }
                syntax.SyntaxToken {
                    kind: grammar.triviaIdComment()
                    span: syntax.SourceSpan { fileId: 0, start: commentStart, length: position! - commentStart }
                } => commentToken
                tokens! -> push(commentToken)
            } else {
                current == 10 -> if {
                    syntax.SyntaxToken {
                        kind: grammar.tokenIdNewLine()
                        span: syntax.SourceSpan { fileId: 0, start: position!, length: 1 }
                    } => newlineToken
                    tokens! -> push(newlineToken)
                    position! + 1 => position!
                } else {
                    current -> isIdentifierStart -> if {
                        position! => identifierStart
                        position! + 1 => position!
                        (position! < sourceLength and ((source -> byte(position!)) -> isIdentifierContinue))
                            -> while {
                            position! + 1 => position!
                        }
                        syntax.SyntaxToken {
                            kind: grammar.tokenIdIdentifier()
                            span: syntax.SourceSpan { fileId: 0, start: identifierStart, length: position! - identifierStart }
                        } => identifierToken
                        tokens! -> push(identifierToken)
                    } else {
                        current -> isDigit -> if {
                            position! => numberStart
                            position! + 1 => position!
                            (position! < sourceLength and (((source -> byte(position!)) -> isDigit) or ((source -> byte(position!)) == 95 and position! + 1 < sourceLength and ((source -> byte(position! + 1)) -> isDigit))))
                                -> while {
                                position! + 1 => position!
                            }
                            (position! + 1 < sourceLength and (source -> byte(position!)) == 46 and ((source -> byte(position! + 1)) -> isDigit))
                                -> if {
                                position! + 1 => position!
                                (position! < sourceLength and (((source -> byte(position!)) -> isDigit) or ((source -> byte(position!)) == 95 and position! + 1 < sourceLength and ((source -> byte(position! + 1)) -> isDigit))))
                                    -> while {
                                    position! + 1 => position!
                                }
                            }
                            (position! < sourceLength and ((source -> byte(position!)) == 101 or (source -> byte(position!)) == 69))
                                -> if {
                                position! + 1 => position!
                                (position! < sourceLength and ((source -> byte(position!)) == 43 or (source -> byte(position!)) == 45))
                                    -> if {
                                    position! + 1 => position!
                                }
                                (position! < sourceLength and (((source -> byte(position!)) -> isDigit) or ((source -> byte(position!)) == 95 and position! + 1 < sourceLength and ((source -> byte(position! + 1)) -> isDigit))))
                                    -> while {
                                    position! + 1 => position!
                                }
                            }
                            syntax.SyntaxToken {
                                kind: grammar.tokenIdNumber()
                                span: syntax.SourceSpan { fileId: 0, start: numberStart, length: position! - numberStart }
                            } => numberToken
                            tokens! -> push(numberToken)
                        } else {
                            current == 34 -> if {
                                position! => stringStart
                                false => rawString!
                                false => stringClosed!
                                position! + 2 < sourceLength -> if {
                                    ((source -> byte(position! + 1)) == 34 and (source -> byte(position! + 2)) == 34)
                                        -> if { true => rawString! }
                                }
                                rawString! -> if {
                                    UIntSize(0) => delimiterWidth!
                                    (position! + delimiterWidth! < sourceLength and (source -> byte(position! + delimiterWidth!)) == 34)
                                        -> while {
                                        delimiterWidth! + 1 => delimiterWidth!
                                    }
                                    position! + delimiterWidth! => position!
                                    false => rawClosed!
                                    (position! < sourceLength and not rawClosed!)
                                        -> while {
                                        UIntSize(0) => quoteRun!
                                        (position! + quoteRun! < sourceLength and (source -> byte(position! + quoteRun!)) == 34)
                                            -> while {
                                            quoteRun! + 1 => quoteRun!
                                        }
                                        quoteRun! >= delimiterWidth! -> if { true => rawClosed! }
                                        not rawClosed! -> if { position! + 1 => position! }
                                    }
                                    rawClosed! -> if {
                                        position! + delimiterWidth! => position!
                                        true => stringClosed!
                                    }
                                } else {
                                    position! + 1 => position!
                                    (position! < sourceLength and (source -> byte(position!)) != 34)
                                        -> while {
                                        position! + 1 => position!
                                    }
                                    position! < sourceLength -> if {
                                        position! + 1 => position!
                                        true => stringClosed!
                                    }
                                }
                                syntax.SyntaxToken {
                                    kind: stringClosed! -> if { grammar.tokenIdString() } else { grammar.tokenIdInvalid() }
                                    span: syntax.SourceSpan { fileId: 0, start: stringStart, length: position! - stringStart }
                                } => stringToken
                                tokens! -> push(stringToken)
                            } else {
                                Int(-1) => kind!
                                UIntSize(1) => width!
                                position! + 2 < sourceLength -> if {
                                    source -> byte(position! + 1) => following
                                    source -> byte(position! + 2) => third
                                    current -> tripleKind(following, third) => triple
                                    triple >= 0 -> if {
                                        triple => kind!
                                        3 => width!
                                    }
                                }
                                kind! < 0 and position! + 1 < sourceLength -> if {
                                    source -> byte(position! + 1) => following
                                    UInt16(current) * 256 + UInt16(following) -> pairKind => pair
                                    pair >= 0 -> if {
                                        pair => kind!
                                        2 => width!
                                    }
                                }
                                kind! < 0 -> if {
                                    current -> singleKind => kind!
                                }
                                kind! >= 0 -> if {
                                    syntax.SyntaxToken {
                                        kind: kind!
                                        span: syntax.SourceSpan { fileId: 0, start: position!, length: width! }
                                    } => punctuationToken
                                    tokens! -> push(punctuationToken)
                                } else {
                                    syntax.SyntaxToken {
                                        kind: grammar.tokenIdInvalid()
                                        span: syntax.SourceSpan { fileId: 0, start: position!, length: width! }
                                    } => invalidToken
                                    tokens! -> push(invalidToken)
                                }
                                position! + width! => position!
                            }
                        }
                    }
                }
            }
        }
    }

    syntax.SyntaxToken {
        kind: grammar.tokenIdEnd()
        span: syntax.SourceSpan { fileId: 0, start: sourceLength, length: 0 }
    } => endToken
    tokens! -> push(endToken)
    tokens!
}

public lexSource source: file.SourceText -> [syntax.SyntaxToken; ~] {
    source -> len => sourceLength
    source -> slice(UIntSize(0), sourceLength) => view
    view -> lexText
}

public lex source: Text -> [syntax.SyntaxToken; ~] {
    source -> lexText
}
