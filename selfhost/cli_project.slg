namespace sollang.compiler.cli_project

import sollang.compiler.project
import sollang.compiler.package_versions as versions
import sollang.compiler.source_root as sourceRoot
import sys.file as file
import sys.path as path

unitValue: -> Unit {
    false => ignored
}

public struct ProjectInput {
    status: Int
    source: Text
    sourceDirectory: Text
    projectDirectory: Text
    productName: Text
    multiProduct: Bool
    dependencyCount: Int
}

textEndsWith value: Text, suffix: Text -> Bool {
    value -> len => valueLength
    suffix -> len => suffixLength
    suffixLength <= valueLength => matches!
    valueLength - suffixLength => start
    UIntSize(0) => index!
    (matches! and index! < suffixLength) -> while {
        (value -> byte(start + index!)) != (suffix -> byte(index!))
            -> if { false => matches! }
        index! + 1 => index!
    }
    matches!
}

textEquals left: Text, right: Text -> Bool {
    (left -> len) == (right -> len) => matches!
    UIntSize(0) => index!
    (matches! and index! < (left -> len)) -> while {
        (left -> byte(index!)) != (right -> byte(index!))
            -> if { false => matches! }
        index! + 1 => index!
    }
    matches!
}

directoryOf value: Text -> Text {
    UIntSize(0) => lastSeparator!
    false => found!
    UIntSize(0) => index!
    index! < (value -> len) -> while {
        value -> byte(index!) => current
        (current == 47 or current == 92) -> if {
            index! => lastSeparator!
            true => found!
        }
        index! + 1 => index!
    }
    found! -> if {
        value -> slice(UIntSize(0), lastSeparator!) => directory
        directory -> return
    }
    "."
}

manifestPath option: Text, storage: mut Arena -> Text {
    option -> textEndsWith(".project") -> if {
        option -> return
    }
    "$option/sollang.project" -> materialize(storage)
}

spanText source: file.SourceText, span: project.TextSpan -> Text {
    source -> slice(span.start, span.length)
}

joinedPath base: Text, child: Text, style: path.Style -> path.Path {
    [UInt8; ~] => bytes!
    UIntSize(0) => baseIndex!
    baseIndex! < (base -> len) -> while {
        base -> byte(baseIndex!) => current
        current => normalized!
        style -> when {
            Windows {
                current == 47 -> if { 92 => normalized! }
            }
            Posix {}
        }
        bytes! -> push(normalized!)
        baseIndex! + 1 => baseIndex!
    }
    (bytes! -> len) > 0 -> if {
        bytes![(bytes! -> len) - 1] => last
        (last == 47 or last == 92) => separated
        not separated -> if {
            style -> when {
                Windows { bytes! -> push(92) }
                Posix { bytes! -> push(47) }
            }
        }
    }
    UIntSize(0) => childIndex!
    childIndex! < (child -> len) -> while {
        child -> byte(childIndex!) => current
        current => normalized!
        style -> when {
            Windows {
                current == 47 -> if { 92 => normalized! }
            }
            Posix {}
        }
        bytes! -> push(normalized!)
        childIndex! + 1 => childIndex!
    }
    path.Path { bytes: bytes!, style: style } => result
    result
}

normalizePath value: move path.Path -> Result<path.Path, Text> {
    value.style => style
    value.bytes => source
    [UInt8; ~] => output!
    [UIntSize; ~] => componentStarts!
    false => windows!
    style -> when {
        Posix { unitValue() }
        Windows {
            true => windows!
            unitValue()
        }
    }
    UIntSize(source -> len) => sourceLength
    UIntSize(0) => index!
    false => wroteComponent!

    windows! -> if {
        (sourceLength >= 3 and source[1] == 58 and source[2] == 92)
            -> if {
            output! -> push(source[0])
            output! -> push(58)
            output! -> push(92)
            3 => index!
            (index! < sourceLength and source[Int(index!)] == 92)
                -> while {
                index! + 1 => index!
            }
        }
    } else {
        (sourceLength > 0 and source[0] == 47) -> if {
            output! -> push(47)
            1 => index!
            (index! < sourceLength and source[Int(index!)] == 47)
                -> while {
                index! + 1 => index!
            }
        }
    }

    false => escaped!
    (index! < sourceLength and not escaped!) -> while {
        index! => componentStart
        (index! < sourceLength and (windows! -> if { source[Int(index!)] != 92 } else { source[Int(index!)] != 47 }))
            -> while {
            index! + 1 => index!
        }
        index! => componentEnd
        componentEnd - componentStart => componentLength
        (index! < sourceLength and (windows! -> if { source[Int(index!)] == 92 } else { source[Int(index!)] == 47 }))
            -> while {
            index! + 1 => index!
        }

        componentLength == 1 and source[Int(componentStart)] == 46 => currentDirectory
        componentLength == 2 and source[Int(componentStart)] == 46 and source[Int(componentStart + 1)] == 46 => parentDirectory
        (componentLength > 0 and not currentDirectory and not parentDirectory)
            -> if {
            UIntSize(output! -> len) => truncateStart
            wroteComponent! -> if {
                windows! -> if { output! -> push(92) } else { output! -> push(47) }
            }
            componentStarts! -> push(truncateStart)
            componentStart => componentByteIndex!
            componentByteIndex! < componentEnd -> while {
                output! -> push(source[Int(componentByteIndex!)])
                componentByteIndex! + 1 => componentByteIndex!
            }
            true => wroteComponent!
        }
        parentDirectory -> if {
            UIntSize(componentStarts! -> len) > 0 -> if {
                componentStarts! -> take(Int(UIntSize(componentStarts! -> len) - 1)) => truncateTo
                UIntSize(output! -> len) > truncateTo -> while {
                    output! -> take(Int(UIntSize(output! -> len) - 1)) => removed
                }
                UIntSize(componentStarts! -> len) > 0 => wroteComponent!
            } else {
                true => escaped!
            }
        }
    }

    escaped! -> if {
        Result<path.Path, Text>.Err("path escapes root") -> return
    }
    UIntSize(output! -> len) == 0 -> if { output! -> push(46) }
    path.Path { bytes: output!, style: style } => normalized
    Result<path.Path, Text>.Ok(normalized)
}

manifestOwnedPath option: Text, style: path.Style -> path.Path {
    [UInt8; ~] => bytes!
    UIntSize(0) => index!
    index! < (option -> len) -> while {
        option -> byte(index!) => current
        current => normalized!
        style -> when {
            Windows {
                current == 47 -> if { 92 => normalized! }
            }
            Posix {}
        }
        bytes! -> push(normalized!)
        index! + 1 => index!
    }
    not (option -> textEndsWith(".project")) -> if {
        (bytes! -> len) > 0 -> if {
            bytes![(bytes! -> len) - 1] => last
            (last == 47 or last == 92) => separated
            not separated -> if {
                style -> when {
                    Windows { bytes! -> push(92) }
                    Posix { bytes! -> push(47) }
                }
            }
        }
        "sollang.project" => name
        UIntSize(0) => nameIndex!
        nameIndex! < (name -> len) -> while {
            bytes! -> push(name -> byte(nameIndex!))
            nameIndex! + 1 => nameIndex!
        }
    }
    path.Path { bytes: bytes!, style: style } => result
    result
}

sameSpanText source: file.SourceText, left: project.TextSpan, right: project.TextSpan -> Bool {
    left.length == right.length => same!
    UIntSize(0) => index!
    (same! and index! < left.length) -> while {
        (source -> byte(left.start + index!)) != (source -> byte(right.start + index!))
            -> if {
            false => same!
        }
        index! + 1 => index!
    }
    same!
}

emptyInput status: Int -> ProjectInput {
    ProjectInput {
        status: status
        source: ""
        sourceDirectory: ""
        projectDirectory: ""
        productName: ""
        multiProduct: false
        dependencyCount: 0
    } => result
    result
}

# Appends every transitive path-dependency source closure once.
# Status: 0 valid, 20 non-path dependency, 21 invalid dependency manifest,
# 22 dependency does not expose its same-named product, 23 graph limit,
# 24 dependency cycle, 25 dependency/project name mismatch,
# 26 dependency version requirement mismatch, 27 canonical-path query,
# 28 dependency manifest open, 29 dependency manifest syntax.
public resolvePathGraph option: Text, sources: mut [path.Path; ~], packageManifests: mut [path.Path; ~], packageNames: mut [path.Path; ~], packageVersions: mut [path.Path; ~], style: path.Style -> Int uses File {
    [path.Path; ~] => manifests!
    0 => status!
    option -> manifestOwnedPath(style) -> normalizePath -> when {
        Ok(normalized) {
            path.pathText(normalized) => normalizedText
            manifests! -> push(normalizedText -> path.fromText(style))
            unitValue()
        }
        Err(_) {
            27 => status!
            manifests! -> push("" -> path.fromText(style))
            unitValue()
        }
    }
    [path.Path; ~] => canonicalManifests!
    [Int; ~] => parents!
    parents! -> push(-1)
    [path.Path; ~] => expectedNames!
    expectedNames! -> push("" -> path.fromText(style))
    [path.Path; ~] => requirements!
    requirements! -> push("" -> path.fromText(style))
    0 => processed!
    (status! == 0 and processed! < (manifests! -> len))
        -> while {
        processed! >= 64 -> if { 23 => status! }
        status! == 0 -> if {
            path.pathText(manifests![processed!]) => queuedManifestText
            queuedManifestText -> path.fromText(style) => manifestPath
            path.pathText(manifestPath) => manifestText
            false => skipCurrent!
            status! == 0 -> if {
                parents![processed!] => ancestor!
                (not skipCurrent! and ancestor! >= 0) -> while {
                    path.equalsText(canonicalManifests![ancestor!], manifestText)
                        -> if {
                        24 => status!
                    }
                    parents![ancestor!] => ancestor!
                }
                0 => seenIndex!
                (status! == 0 and not skipCurrent! and seenIndex! < processed!)
                    -> while {
                    path.equalsText(canonicalManifests![seenIndex!], manifestText)
                        -> if {
                        true => skipCurrent!
                    }
                    seenIndex! + 1 => seenIndex!
                }
                canonicalManifests! -> push(manifestText -> path.fromText(style))
            }
            manifestText -> directoryOf => manifestDirectoryText
            manifestDirectoryText -> path.fromText(style) => manifestDirectory
            (status! == 0 and not skipCurrent!) -> if {
            manifestText -> file.openRead -> when {
                Ok(_) {}
                Err(_) { 28 => status! }
            }
            status! == 0 -> if {
                manifestText -> file.mapText => source
                source -> len => sourceLength
                source -> slice(UIntSize(0), sourceLength) => sourceView
                sourceView -> project.parse => parsed
                parsed.status != 0 -> if { 29 => status! }

                (status! == 0 and processed! > 0) -> if {
                    source -> spanText(parsed.name) => manifestName
                    not (path.equalsText(expectedNames![processed!], manifestName))
                        -> if {
                        25 => status!
                    }
                    status! == 0 -> if {
                        path.pathText(requirements![processed!]) => requirementText
                        source -> spanText(parsed.version) => manifestVersion
                        requirementText -> versions.accepts(manifestVersion) => accepted
                        (accepted.status != 0 or not accepted.accepted)
                            -> if { 26 => status! }
                    }
                }

                status! == 0 -> if {
                    packageManifests -> push(manifestText -> path.fromText(style))
                    source -> spanText(parsed.name) => packageName
                    packageNames -> push(packageName -> path.fromText(style))
                    source -> spanText(parsed.version) => packageVersion
                    packageVersions -> push(packageVersion -> path.fromText(style))
                }

                (status! == 0 and processed! > 0) -> if {
                    -1 => productIndex!
                    0 => candidateIndex!
                    candidateIndex! < (parsed.products -> len) -> while {
                        source -> sameSpanText(parsed.products[candidateIndex!].name, parsed.name)
                            -> if {
                            candidateIndex! => productIndex!
                        }
                        candidateIndex! + 1 => candidateIndex!
                    }
                    productIndex! < 0 -> if {
                        22 => status!
                    } else {
                        source -> spanText(parsed.products[productIndex!].root) => rootRelative
                        path.pathText(manifestDirectory) => directoryText
                        directoryText -> joinedPath(rootRelative, style) => rootPath
                        path.pathText(rootPath) => rootText
                        rootText -> directoryOf => sourceDirectoryText
                        sourceDirectoryText -> path.fromText(style) => sourceDirectory
                        sourceDirectory -> sourceRoot.discoverDirect => discovered
                        0 => discoveredIndex!
                        discoveredIndex! < (discovered -> len) -> while {
                            path.pathText(discovered[discoveredIndex!]) => discoveredText
                            sources -> push(discoveredText -> path.fromText(style))
                            discoveredIndex! + 1 => discoveredIndex!
                        }
                    }
                }

                0 => dependencyIndex!
                (status! == 0 and dependencyIndex! < (parsed.dependencies -> len))
                    -> while {
                    parsed.dependencies[dependencyIndex!].path.length == 0
                        -> if {
                        20 => status!
                    } else {
                        source -> spanText(parsed.dependencies[dependencyIndex!].path) => dependencyRelative
                        path.pathText(manifestDirectory) => directoryText
                        directoryText -> joinedPath(dependencyRelative, style) => dependencyDirectory
                        path.pathText(dependencyDirectory) => dependencyDirectoryText
                        dependencyDirectoryText -> joinedPath("sollang.project", style) => dependencyManifest
                        dependencyManifest -> normalizePath -> when {
                            Ok(normalized) {
                                path.pathText(normalized) => dependencyManifestText
                                manifests! -> push(dependencyManifestText -> path.fromText(style))
                                parents! -> push(processed!)
                                source -> spanText(parsed.dependencies[dependencyIndex!].name) => dependencyName
                                expectedNames! -> push(dependencyName -> path.fromText(style))
                                parsed.dependencies[dependencyIndex!].version.length > 0
                                    -> if {
                                    source -> spanText(parsed.dependencies[dependencyIndex!].version)
                                } else {
                                    "*"
                                } => dependencyRequirement
                                requirements! -> push(dependencyRequirement -> path.fromText(style))
                                unitValue()
                            }
                            Err(_) {
                                27 => status!
                                unitValue()
                            }
                        }
                    }
                    dependencyIndex! + 1 => dependencyIndex!
                }
            }
            }
            status! == 0 -> if { processed! + 1 => processed! }
        }
    }
    status!
}

public appendDependencySources option: Text, sources: mut [path.Path; ~], style: path.Style -> Int uses File {
    [path.Path; ~] => packageManifests!
    [path.Path; ~] => packageNames!
    [path.Path; ~] => packageVersions!
    option -> resolvePathGraph(sources, packageManifests!, packageNames!, packageVersions!, style)
}

# Status: 0 valid, 1 invalid manifest, 2 requested product missing,
# 3 product selection required.
public load option: Text, requestedProduct: Text, manifestStorage: mut Arena, rootStorage: mut Arena, productNameStorage: mut Arena -> ProjectInput uses File {
    option -> manifestPath(manifestStorage) => manifest
    manifest -> directoryOf => directory
    manifest -> path.fromText(path.nativeStyle()) => manifestFile
    manifestFile -> file.mapPath => source
    source -> len => sourceLength
    source -> slice(UIntSize(0), sourceLength) => sourceView
    sourceView -> project.parse => parsed
    parsed.status != 0 -> if {
        parsed.status + 100 => parseStatus
        parseStatus -> emptyInput => failure
        failure -> return
    }

    -1 => selectedIndex!
    (requestedProduct -> len) > 0 -> if {
        0 => index!
        index! < (parsed.products -> len) -> while {
            source -> spanText(parsed.products[index!].name) => candidate
            candidate -> textEquals(requestedProduct) -> if { index! => selectedIndex! }
            index! + 1 => index!
        }
        selectedIndex! < 0 -> if {
            2 -> emptyInput => failure
            failure -> return
        }
    } else {
        (parsed.products -> len) == 1 -> if {
            0 => selectedIndex!
        } else {
            3 -> emptyInput => failure
            failure -> return
        }
    }

    source -> spanText(parsed.products[selectedIndex!].root) => relativeRoot
    source -> spanText(parsed.products[selectedIndex!].name) => productNameView
    productNameView -> materialize(productNameStorage) => productName
    "$directory/$relativeRoot" -> materialize(rootStorage) => rootSource
    rootSource -> directoryOf => sourceDirectory
    ProjectInput {
        status: 0
        source: rootSource
        sourceDirectory: sourceDirectory
        projectDirectory: directory
        productName: productName
        multiProduct: (parsed.products -> len) > 1
        dependencyCount: parsed.dependencies -> len
    } => result
    result
}
