parser Sollang.Compiler.Parsing.Parser

start SourceFile

rule SourceFile = NewLine* NamespaceDeclaration? (ImportDeclaration | LibraryImportDeclaration)* NewLine* (TopLevelDeclaration NewLine*)* (MainBlock | Statement*) NewLine* End
rule NamespaceDeclaration = Identifier("namespace") Path StatementEnd
rule ImportDeclaration = Identifier("import") Path (Identifier("as") Identifier)? StatementEnd
rule StructDeclaration = Identifier("public")? AbiMarker? Identifier("struct") Identifier LeftBrace NewLine* StructFieldDeclaration* RightBrace
rule StructFieldDeclaration = Identifier Colon TypeAnnotation Comma? NewLine*
rule EnumDeclaration = Identifier("public")? Identifier("enum") Identifier LeftBrace NewLine* EnumVariantDeclaration* RightBrace
rule EnumVariantDeclaration = Identifier (LeftParen TypeAnnotation RightParen)? Comma? NewLine*
rule EffectDeclaration = Identifier("public")? Identifier("effect") Identifier LeftBrace NewLine* EffectOperationDeclaration* RightBrace
rule EffectOperationDeclaration = Identifier Identifier? Colon (TypeAnnotation Arrow TypeAnnotation | Arrow TypeAnnotation) NewLine+
rule TraitDeclaration = Identifier("public")? Identifier("trait") Identifier LeftBrace NewLine* (TraitAssociatedTypeDeclaration | TraitMethodDeclaration)* RightBrace
rule TraitAssociatedTypeDeclaration = Identifier("type") Identifier StatementEnd
rule TraitMethodDeclaration = Identifier Colon ((Identifier("move") | Identifier("mut"))? Identifier("self")) Arrow TypeAnnotation StatementEnd
rule ImplDeclaration = Identifier("impl") Path (Identifier("for") Path)? LeftBrace NewLine* ImplAssociatedTypeBinding* (MethodDeclaration NewLine*)* RightBrace
rule ImplAssociatedTypeBinding = Identifier("type") Identifier Equal TypeAnnotation StatementEnd
rule MethodDeclaration = Identifier("public")? Identifier Colon ((Identifier("move") | Identifier("mut"))? Identifier("self"))? Arrow TypeAnnotation (BlockFunctionBody | FunctionBody)
rule ComLibraryDeclaration = Identifier("com") Identifier Identifier("class") String (Identifier("from") String)? Identifier("in") Identifier LeftBrace NewLine* (ComInterfaceDeclaration NewLine*)* RightBrace
rule ComInterfaceDeclaration = Identifier("interface") Identifier String LeftBrace NewLine* (ComMethodDeclaration NewLine*)* RightBrace
rule ComMethodDeclaration = Identifier Identifier? Colon FunctionSignature Identifier("at") Number
rule NativeLibraryDeclaration = Identifier("native") Identifier Identifier("from") String LeftBrace NewLine* ((NativeHandleDeclaration | NativeFunctionDeclaration) NewLine*)* RightBrace
rule NativeHandleDeclaration = Identifier("handle") Identifier Identifier("drop") String
rule NativeFunctionDeclaration = Identifier("try")? Identifier Identifier? Colon FunctionSignature (Identifier("as") String)?
rule FunctionDeclaration = Identifier("public")? Path GenericParameterClause? Identifier? Colon FunctionSignature GenericWhereClause? (BlockFunctionBody | FunctionBody)
rule GenericParameterClause = Less Identifier (Comma Identifier)* Greater
rule GenericWhereClause = Identifier("where") AssociatedTypeEqualityConstraint (Comma AssociatedTypeEqualityConstraint)*
rule AssociatedTypeEqualityConstraint = Identifier (Colon Path | Dot Identifier EqualEqual TypeAnnotation)
rule FunctionSignature = StreamFunctionSignature | Arrow Identifier("async")? EffectClause | Arrow Identifier("async")? TypeAnnotation EffectClause? | Arrow Identifier("async")? | InputTypeAnnotation AdditionalFunctionInput* Arrow Identifier("async")? EffectClause | InputTypeAnnotation AdditionalFunctionInput* Arrow Identifier("async")? TypeAnnotation EffectClause? | InputTypeAnnotation AdditionalFunctionInput* Arrow Identifier("async")?
rule AdditionalFunctionInput = Comma Identifier Colon InputTypeAnnotation
rule EffectClause = Identifier("uses") EffectReference (Comma EffectReference)*
rule EffectReference = Path
rule BlockFunctionBody = Identifier("block") Identifier Colon TypeAnnotation (Comma Identifier Colon TypeAnnotation)* (Arrow TypeAnnotation)? (LeftBrace BlockBody RightBrace | Equal Identifier("intrinsic"))
rule FunctionBody = LeftBrace NewLine* (FunctionDeclaration NewLine*)* Statement* RightBrace | FatArrow Expression | Equal (Identifier("intrinsic") | Identifier("native") String)
rule MainBlock = Identifier("main") LeftBrace NewLine* Statement* RightBrace
rule Statement = ReturnStatement | GuardLoopControlStatement | LoopControlStatement | StreamStopStatement | StreamStateBindingStatement | BindingStatement | IndexAssignmentStatement | FieldAssignmentStatement | ControlFlowExpressionStatement | ExpressionStatement | BlockFunctionCallStatement
rule ControlFlowExpressionStatement = ControlFlowExpression StatementEnd
rule ControlFlowExpression = RangeOrLogicalExpression Arrow (IfFlowTarget | UnlessFlowTarget | WhileFlowTarget | WhenFlowTarget | FoldFlowTarget) (NewLine* Arrow (IfFlowTarget | UnlessFlowTarget | WhileFlowTarget | WhenFlowTarget | FoldFlowTarget | BranchFlowTarget | ParallelBranchFlowTarget | PartitionFlowTarget | TapFlowTarget | StreamJoinFlowTarget | StandardGenericEnumFlowTarget | Path FlowGenericArgument? FlowTargetCall?))* Question*
rule BlockFunctionCallStatement = RangeOrLogicalExpression (NewLine* Arrow (StreamSliceStage | notKeyword("if") notKeyword("unless") notKeyword("when") notKeyword("fold") notKeyword("branch") notKeyword("partition") Path FlowTargetCall? (Identifier (Comma Identifier)*)? LeftBrace NewLine* Statement* RightBrace))+ (NewLine* FatArrow MutableName)? NewLine*
rule StreamSliceStage = (Identifier("take") | Identifier("skip")) FlowTargetCall
rule EachStatement = RangeExpression Arrow Identifier("each") Identifier LeftBrace NewLine* Statement* RightBrace
rule BindingStatement = Expression NewLine* FatArrow MutableName StatementEnd
rule IndexAssignmentStatement = Expression FatArrow MutableName LeftBracket Expression RightBracket StatementEnd
rule FieldAssignmentStatement = Expression FatArrow MutableName Dot Identifier StatementEnd
rule MutableName = Identifier Bang?
rule ExpressionStatement = Expression StatementEnd
rule StatementEnd = NewLine+ | lookahead(RightBrace) | lookahead(End)
rule RangeExpression = LogicalOrExpression (Range | RangeUntil) LogicalOrExpression
rule Expression = FlowExpression
rule FlowExpression = RangeOrLogicalExpression (NewLine* Arrow (IfFlowTarget | UnlessFlowTarget | WhileFlowTarget | WhenFlowTarget | FoldFlowTarget | BranchFlowTarget | ParallelBranchFlowTarget | PartitionFlowTarget | TapFlowTarget | StreamJoinFlowTarget | StandardGenericEnumFlowTarget | Path FlowGenericArgument? FlowTargetCall?))* Question*
rule StandardGenericEnumFlowTarget = (Identifier("Option") Less TypeAnnotation Greater | Identifier("Result") Less TypeAnnotation Comma TypeAnnotation Greater) Dot Identifier FlowTargetCall?
rule FlowGenericArgument = Less (Number | TypeAnnotation) Greater
rule CompileTimeValueArgument = Less Number Greater
rule FlowTargetCall = LeftParen NewLine* ArgumentList? NewLine* RightParen
rule BranchFlowTarget = Identifier("branch") LeftBrace NewLine* BranchArm (NewLine+ BranchArm)* NewLine* RightBrace
rule ParallelBranchFlowTarget = Identifier("parallel") Identifier("branch") LeftBrace NewLine* BranchArm (NewLine+ BranchArm)* NewLine* RightBrace
rule BranchArm = Identifier Colon (Identifier("ref") | Identifier("mut") | Identifier("move"))? Arrow JunctionTarget (NewLine* Arrow JunctionTarget)*
rule PartitionFlowTarget = Identifier("partition") Identifier? LeftBrace NewLine* PartitionWhenArm NewLine+ (PartitionWhenArm NewLine+)* PartitionElseArm NewLine* RightBrace
rule PartitionWhenArm = Identifier Colon Identifier("when") Expression
rule PartitionElseArm = Identifier Colon Identifier("else")
rule TapFlowTarget = Identifier("tap") (LeftBrace NewLine* Arrow JunctionTarget (NewLine* Arrow JunctionTarget)* NewLine* RightBrace | JunctionTarget (lookahead(NewLine) | lookahead(Arrow) | lookahead(FatArrow) | lookahead(RightBrace) | lookahead(End)))
rule StreamJoinFlowTarget = Identifier("zip") | Identifier("merge") | Identifier("concat") | Identifier("latest")
rule JunctionTarget = Path FlowGenericArgument? FlowTargetCall?
rule RangeOrLogicalExpression = RangeExpression | LogicalOrExpression
rule IfFlowTarget = Identifier("if") LeftBrace BlockBody RightBrace (Identifier("else") LeftBrace BlockBody RightBrace)?
rule UnlessFlowTarget = Identifier("unless") LeftBrace BlockBody RightBrace
rule WhenFlowTarget = Identifier("when") LeftBrace NewLine* SubjectWhenArm+ (Identifier("else") WhenArmBody NewLine*)? RightBrace
rule FoldFlowTarget = Identifier("fold") Expression (Identifier Comma Identifier)? LeftBrace BlockBody RightBrace
rule WhenExpression = Identifier("when") LeftBrace NewLine* WhenArm+ (Identifier("else") WhenArmBody NewLine*)? RightBrace
rule WhenArm = notKeyword("else") WhenCondition WhenArmBody NewLine*
rule WhenCondition = LogicalOrExpression
rule SubjectWhenArm = SubjectWhenCondition WhenArmBody NewLine*
rule SubjectWhenCondition = EnumPattern | (EqualEqual | BangEqual | Less | LessEqual | Greater | GreaterEqual) Expression | RangeExpression
rule EnumPattern = notKeyword("else") ((Identifier("Option") Less TypeAnnotation Greater | Identifier("Result") Less TypeAnnotation Comma TypeAnnotation Greater) Dot Identifier | Path) (LeftParen Identifier? RightParen)?
rule WhenArmBody = FatArrow Expression | LeftBrace BlockBody RightBrace
rule BlockBody = NewLine* Statement* Expression? NewLine*
rule LogicalOrExpression = LogicalAndExpression (NewLine* Identifier("or") LogicalAndExpression)*
rule LogicalAndExpression = EqualityExpression (NewLine* Identifier("and") EqualityExpression)*
rule EqualityExpression = ComparisonExpression ((EqualEqual | BangEqual) ComparisonExpression)*
rule ComparisonExpression = AdditiveExpression ((Less | LessEqual | Greater | GreaterEqual) AdditiveExpression)*
rule AdditiveExpression = MultiplicativeExpression ((Plus | Minus) MultiplicativeExpression)*
rule MultiplicativeExpression = UnaryExpression ((Star | Slash | Percent) UnaryExpression)*
rule UnaryExpression = Identifier("not") UnaryExpression | Identifier("box") UnaryExpression | Minus UnaryExpression | PrimaryExpression
rule BoxExpression = Identifier("box") UnaryExpression
rule PrimaryExpression = PostfixExpression
rule PostfixExpression = AtomExpression ((Bang LeftBracket Expression RightBracket) | (LeftBracket Expression RightBracket) | (Dot Identifier) | Question)*
rule AtomExpression = WhenExpression | MapExpression | StructLiteralExpression | EnumConstructorExpression | TypeApplicationExpression | CallExpression | ArrayExpression | DictionaryExpression | ProductExpression | StringExpression | NumberExpression | NameExpression | LeftParen Expression RightParen
rule ProductExpression = LeftParen ProductElement Comma ProductElement (Comma ProductElement)* Comma? RightParen
rule ProductElement = (Identifier Colon)? Expression
rule EnumConstructorExpression = TypeAnnotation Dot Identifier (LeftParen NewLine* ArgumentList? NewLine* RightParen)?
rule MapExpression = Identifier("map") (Identifier("read") | Identifier("write")) PrimaryExpression (Identifier("at") AdditiveExpression Identifier("for") AdditiveExpression)? (Identifier("size") AdditiveExpression)?
rule StructLiteralExpression = TypeName LeftBrace NewLine* StructFieldInitializer ((Comma NewLine* | NewLine+) StructFieldInitializer)* Comma? NewLine* RightBrace
rule StructFieldInitializer = Identifier Colon Expression
rule ArrayExpression = LeftBracket NewLine* (TypedEmptyArray | ArrayItems)? NewLine* RightBracket
rule TypedEmptyArray = TypeName Semicolon (Tilde | Number Tilde | LessEqual Number)
rule ArrayItems = Expression (Semicolon (Number | Identifier) | (Comma NewLine* Expression)* Comma? Semicolon NewLine* (Tilde | LessEqual Number) | (Comma NewLine* Expression)*)
rule DictionaryExpression = LeftBrace NewLine* (TypedEmptyDictionary | DictionaryEntry ((Comma NewLine* | NewLine+) DictionaryEntry)* Comma?) NewLine* RightBrace
rule TypedEmptyDictionary = TypeAnnotation Colon TypeAnnotation (Semicolon (Number Tilde | LessEqual Number | NewLine* DictionaryEntry ((Comma NewLine* | NewLine+) DictionaryEntry)* Comma?))?
rule DictionaryEntry = Expression Colon Expression
rule CallExpression = Path LeftParen NewLine* ArgumentList? NewLine* RightParen
rule TypeApplicationExpression = Path Less (TypeAnnotation | Number) Greater LeftParen NewLine* ArgumentList? NewLine* RightParen
rule ArgumentList = Expression (Comma NewLine* Expression)*
rule Path = Identifier (Dot Identifier)*
rule TypeName = Path
rule TypeAnnotation = Identifier("ref") TypeAnnotation | Identifier("box") TypeAnnotation | Identifier("dyn") TypeName | TypeName (Less (TypeAnnotation | Number) (Comma TypeAnnotation)? Greater)? | LeftBracket TypeAnnotation RightBracket | LeftBracket TypeAnnotation Semicolon (Tilde | Number | Identifier | LessEqual Number) RightBracket | LeftBrace TypeAnnotation Colon TypeAnnotation (Semicolon LessEqual Number)? RightBrace | ProductType
rule ProductType = LeftParen ProductTypeField Comma ProductTypeField (Comma ProductTypeField)* Comma? RightParen
rule ProductTypeField = (Identifier Colon)? TypeAnnotation
rule InputTypeAnnotation = (Identifier("move") | Identifier("mut"))? TypeAnnotation
rule StringExpression = String
rule NumberExpression = Number
rule NameExpression = Identifier Bang?
rule WhileFlowTarget = Identifier("while") LeftBrace BlockBody RightBrace
rule LoopControlStatement = (Identifier("break") | Identifier("continue")) StatementEnd
rule GuardLoopControlStatement = RangeOrLogicalExpression Arrow Identifier("if") (Identifier("break") | Identifier("continue")) StatementEnd
rule ReturnStatement = Identifier("return") StatementEnd | RangeOrLogicalExpression Arrow Identifier("return") StatementEnd
rule StreamFunctionSignature = Arrow Identifier("stream") TypeAnnotation EffectClause? | InputTypeAnnotation AdditionalFunctionInput* Arrow Identifier("stream") TypeAnnotation EffectClause?
rule StreamStateBindingStatement = Expression NewLine* FatArrow Identifier("state") MutableName StatementEnd
rule StreamStopStatement = Identifier("stop") StatementEnd
rule LibraryImportDeclaration = Identifier("library") Identifier Identifier("from") String
rule AbiMarker = Identifier("abi")
rule TopLevelDeclaration = StructDeclaration | EnumDeclaration | EffectDeclaration | TraitDeclaration | ImplDeclaration | ComLibraryDeclaration | NativeLibraryDeclaration | FunctionDeclaration
