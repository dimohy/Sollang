import sollang.compiler.llvm.text as llvm

main {
    [
        """
        struct Pair {
            left: Int
            right: Int
        }

        replace values: mut [Pair; ~], index: Int, value: ref Pair -> Unit {
            value => values[index]
        }

        main { }
        """,
        ~
    ] => sources!
    sources! -> llvm.emit
}
