# Zero-input functions call with (), while enum members and self properties stay member-like.
enum Status {
    Ready
}

struct Point {
    x: Int
}

impl Point {
    doubled: self -> Int => self.x * 2
}

answer: -> Int => 42

main {
    answer() => value
    Status.Ready => status
    Point { x: 5 } => point
    point.doubled => doubled
    "$value,$doubled" -> println
}
