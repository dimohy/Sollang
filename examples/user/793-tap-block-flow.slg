# Tap block stages execute left to right while the outer flow keeps its input.
double value: Int -> Int => value * 2
writeAudit value: Int -> Unit uses Console => "side=$value" -> println
increment value: Int -> Int => value + 1

main {
    9
        -> tap {
            -> double
            -> writeAudit
        }
        -> increment
        => result
    "$result" -> println
}
