# Growable arrays use `; ~`; single-element, seeded, and typed-empty forms are distinct.
main {
    7 => one
    [one,; ~] => single!
    [1, 2; ~] => seeded!
    [Int; ~] => empty!
    empty! -> push(40)
    empty! -> push(2)
    single![0] + seeded![0] + seeded![1] + empty![0] + empty![1] => total
    "$(single! -> len),$(seeded! -> len),$(empty! -> len),$total" -> println
}
