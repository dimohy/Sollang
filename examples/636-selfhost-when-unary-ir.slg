import sollang.compiler.ir.typed as typedIr
import sollang.compiler.ast as ast

main {
    [
        """
        unwrap result: Result<Int32, Int32> -> Int32 {
            result -> when {
                Result<Int32, Int32>.Ok(value) => value
                Result<Int32, Int32>.Err(error) => -error
            }
        }
        """,
        ~
    ] => sources!
    sources![0] -> ast.lower => nodes!
    0 => astIndex!
    astIndex! < (nodes! -> len) -> while {
        nodes![astIndex!] => node
        "when unary AST = $(astIndex!),$(node.kind),$(node.parent),$(node.operatorKind),$(node.firstToken),$(node.tokenCount)" -> println
        astIndex! + 1 => astIndex!
    }
    sources! -> typedIr.lower => ir!
    0 => nodeIndex!
    nodeIndex! < (ir! -> len) -> while {
        ir![nodeIndex!] => node
        "when unary IR = $(nodeIndex!),$(node.kind),$(node.parent),$(node.symbol),$(node.typeSymbol),$(node.operand0),$(node.operand1),$(node.nextOperand),$(node.opcode)" -> println
        nodeIndex! + 1 => nodeIndex!
    }
}
