import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.qualified as qualified

main {
    """
    com fixture class "11111111-2222-3333-4444-555555555555" in mta {
        interface Calculator "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee" {
            add left: Int32, right: Int32 -> Result<Int32, Int32> at 3
        }
    }

    main {
        fixture.create
        fixture.clone
        fixture.add(20, 22)
    }
    """ => source
    [source, ~] => sources!
    sources! -> analysis.analyze => package
    package -> qualified.resolveAnalyzed => calls!
    calls! -> each call {
        package.ranges[call.sourceModule] => sourceRange
        package.symbols[sourceRange.symbolStart + call.targetSymbol] => target
        "COM call = $(call.status),$(target.flags)" -> println
    }
}
