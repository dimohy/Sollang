import sollang.compiler.llvm.invariant_rules as invariantRules

main {
    invariantRules.implicitFlowArgumentCount(true, true, 1, 1) => linkedRole
    invariantRules.implicitFlowArgumentCount(true, false, 2, 3) => capturedRole
    invariantRules.implicitFlowArgumentCount(false, false, 2, 3) => ordinaryCall
    "implicit=$linkedRole,$capturedRole,$ordinaryCall" -> println
}
