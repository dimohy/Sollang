# `..` includes the end; `..<` excludes it, including subject-range arms.
main {
    1..3 -> fold 0 total, value {
        total + value
    } => inclusive
    1..<3 -> fold 0 total, value {
        total + value
    } => exclusive
    3 -> when {
        1..<3 => "outside"
        3..3 => "inclusive"
        else => "unexpected"
    } => matched
    "$inclusive,$exclusive,$matched" -> println
}
