import sollang.compiler.llvm.text as llvm

# A computed slice length may be nested below a transparent AST wrapper. LLVM
# must consume the wrapper's concrete value producer, which is emitted first.
main {
    [
        """
        computedSlice pattern: Text -> Text {
            pattern -> slice(UIntSize(1), (pattern -> len) - UIntSize(2))
        }

        main {
            "abcd" -> computedSlice -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
