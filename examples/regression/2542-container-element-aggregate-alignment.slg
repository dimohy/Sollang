struct ByteTriple {
    first: UInt8
    second: UInt8
    third: UInt8
}

struct WordTriple {
    first: Int
    second: Int
    third: Int
}

main {
    [ByteTriple; ~] => bytes!
    [WordTriple; ~] => words!
    0 => index!
    index! < 2 -> while {
        bytes! -> push(ByteTriple { first: 4, second: 5, third: 6 })
        words! -> push(WordTriple { first: 4, second: 5, third: 6 })
        index! + 1 => index!
    }
    bytes![1] => byteValue
    words![1] => wordValue
    byteValue.first + byteValue.second + byteValue.third -> println
    wordValue.first + wordValue.second + wordValue.third -> println
}
