# A trailing bookkeeping binding must not replace the explicit final value.
# This is the compact shape used by checked compiler entrypoints after cleanup.
diagnosticCount: -> Int uses Console {
    [Int; ~] => owners!
    owners! -> push(7)
    0 => diagnostics
    diagnostics == 0 -> if { "return-selection=body" -> println }
    owners! -> len => ownerCount
    diagnostics
}

main {
    diagnosticCount() -> println
}
