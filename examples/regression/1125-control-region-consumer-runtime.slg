enum Outcome {
    Ok(Int)
    Err(Int)
}

reject code: Int -> Outcome => Outcome.Err(code)

# A control-result console consumer nested inside another control region uses
# the region emitter, independently from top-level function scheduling.
verify enabled: Bool -> Unit uses Console {
    enabled -> if {
        reject(1) -> when {
            Ok(value) { "region-ok" }
            Err(error) { "region-error" }
        } -> println
    }
}

main {
    true -> verify
}
