main {
    CodePoint(55_295) => before
    CodePoint(57_344) => after
    CodePoint(1_114_111) => maximum
    UInt8(255) => byteMaximum
    UInt32(65) => value
    CodePoint(value) => computed
    "$(UInt32(before)) $(UInt32(after)) $(UInt32(maximum)) $(byteMaximum) $(UInt32(computed))" -> println
}
