make source: Text -> [Int; ~] {
    [1, 2; ~]
}

consume values: move [Int; ~] -> Int {
    values[0] + values[1]
}

probe source: Text -> Unit uses Console {
    source -> make -> consume => total
    "$total:$source" -> println
}

main {
    "kept" => source
    source -> make -> consume => total
    "$total" -> println
    source -> println
    "borrowed" -> probe
}
