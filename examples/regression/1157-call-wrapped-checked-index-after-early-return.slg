identityText value: Text -> Text => value

preferredOrFirstThroughCall preferred: Text, fallback: [Text; ~] -> Text {
    (preferred -> len) > 0 -> if { preferred -> return }
    fallback[0] -> identityText
}

main {
    [Text; ~] => empty
    "ready" -> preferredOrFirstThroughCall(empty) -> println
}
