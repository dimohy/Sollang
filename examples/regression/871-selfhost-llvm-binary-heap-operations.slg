# Verifies self-host LLVM BinaryHeap growth and max-heap ordering through a mutable borrow.
import sollang.compiler.llvm.text as llvm

main {
    [
    """
    fill heap: mut BinaryHeap<Int> -> Unit {
        heap -> push(4)
        heap -> push(9)
        heap -> push(1)
        heap -> push(7)
        heap -> push(12)
        heap -> push(3)
    }

    main {
        BinaryHeap<Int>(2) => heap!
        heap! -> fill
        heap! -> peek -> println
        heap! -> pop => removed1
        removed1 -> println
        heap! -> pop => removed2
        removed2 -> println
        heap! -> pop => removed3
        removed3 -> println
        heap! -> pop => removed4
        removed4 -> println
        heap! -> pop => removed5
        removed5 -> println
        heap! -> pop => removed6
        removed6 -> println
        heap! -> len -> println
    }
    """; ~
    ] => sources!
    sources! -> llvm.emit
}
