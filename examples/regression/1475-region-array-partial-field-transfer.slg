struct Owner { values: [Int; ~], retained: [Int; ~] }
sink values: move [[Int; ~]; ~] -> Int { values -> len }
consume value: move Owner -> Int {
    true -> if {
        [value.values,; ~] => items
        items -> sink -> return
    }
    0
}
main {
    Owner { values: [7,; ~], retained: [8,; ~] } -> consume -> println
}