struct BoxedBytes {
    values: [Int; ~]
}

enum Payload {
    Bytes(BoxedBytes)
}

consume value: move Payload -> Int {
    value -> when {
        Bytes(bytes) { bytes.values -> len }
    }
}

main {
    Payload.Bytes(BoxedBytes { values: [1, 2, 3; ~] }) -> consume => count
    "fresh-owned-enum=$count" -> println
}
