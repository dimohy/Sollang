# Associated substitutions apply inside returned storage too.
trait Producer {
    type Item
    make: self -> [Item; ~]
}
struct IntProducer { }
impl Producer for IntProducer {
    type Item = Int
    make: self -> [Int; ~] { [10, 20; ~] }
}
main {
    IntProducer { } -> Producer.make => values
    values -> len -> println
}
