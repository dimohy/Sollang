struct Inner {
    values: [UInt8; 8]
}

struct Outer {
    inner: Inner
}

make: -> Inner => Inner { values: [7; 8] }

setFirst values: mut [UInt8; 8] -> Unit {
    9 => values[0]
}

main {
    make() => original!
    original!.values -> setFirst
    Outer { inner: original! } => copied
    "original=$(original!.values[0]),copied=$(copied.inner.values[0])" -> println
}
