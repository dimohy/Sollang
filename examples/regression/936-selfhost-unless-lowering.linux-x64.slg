import sollang.compiler.llvm.text as llvm

main {
    [
        """
        # Self-host lowering preserves this inverse guard.
        false -> unless {
            "stage2-unless-ok" -> println
        }
        true -> unless {
            "stage2-unless-failed" -> println
        }
        """; ~
    ] => sources
    sources -> llvm.emitLinux
}
