import std.path as path
import sys.file as file
import sys.path as legacy

bounds input: Int, count: Int, component: Int -> path.Limits => path.Limits {
    maxInputBytes: input
    maxComponents: count
    maxComponentBytes: component
}

appendByte output: mut [UInt8; ~], value: UInt8 -> Unit {
    output -> push(value)
}

kindName kind: path.Kind -> Text => kind -> when {
    PosixRoot => "PosixRoot"
    WindowsRoot => "WindowsRoot"
    DrivePrefix => "DrivePrefix"
    UncRoot => "UncRoot"
    CurrentDirectory => "CurrentDirectory"
    ParentDirectory => "ParentDirectory"
    Normal => "Normal"
}

errorName kind: path.ErrorKind -> Text => kind -> when {
    InvalidLimits => "InvalidLimits"
    InputLimit => "InputLimit"
    InvalidNul => "InvalidNul"
    InvalidPrefix => "InvalidPrefix"
    UnsupportedNamespace => "UnsupportedNamespace"
    ComponentLimit => "ComponentLimit"
    ComponentSizeLimit => "ComponentSizeLimit"
}

show label: Text, text: Text, style: legacy.Style, limits: path.Limits -> Result<Unit, path.Error> uses Console {
    path.components(text, style, limits)? => parts!
    true => reading!
    reading! -> while {
        parts! -> next? -> when {
            Some(component) {
                "$label=$(kindName(component.kind))@$(component.offset)+$(component.length)" -> println
            }
            None {
                "$label=end@$(parts! -> offset)" -> println
                false => reading!
            }
        }
    }
    Result<Unit, path.Error>.Ok
}

rejectCreation label: Text, text: Text, style: legacy.Style, limits: path.Limits -> Unit uses Console {
    path.components(text, style, limits) -> when {
        Ok(parts) { "unexpected-created-$label" -> println }
        Err(error) { "$label=$(errorName(error.kind))@$(error.offset)" -> println }
    }
}

rejectNext label: Text, text: Text, style: legacy.Style, limits: path.Limits, skip: Int -> Result<Unit, path.Error> uses Console {
    path.components(text, style, limits)? => parts!
    0..<skip -> each index {
        parts! -> next? -> when {
            Some(component) {
                "$label-prior=$(kindName(component.kind))@$(component.offset)+$(component.length)" -> println
            }
            None { "unexpected-prior-end-$label" -> println }
        }
    }
    parts! -> offset => before
    0..<2 -> each attempt {
        parts! -> next -> when {
            Ok(component) { "unexpected-next-$label" -> println }
            Err(error) {
                before == (parts! -> offset) => stable
                "$label-$attempt=$(errorName(error.kind))@$(error.offset),stable=$stable" -> println
            }
        }
    }
    Result<Unit, path.Error>.Ok
}

localComponentMetadata: -> Result<Option<path.Component>, path.Error> {
    [UInt8; ~] => bytes!
    appendByte(bytes!, 97)
    appendByte(bytes!, 47)
    appendByte(bytes!, 98)
    bytes! -> file.borrowBytes => source
    source -> slice(0, source -> len) => text
    path.components(text, legacy.Style.Posix, bounds(3, 2, 1))? => parts!
    parts! -> next
}

run: -> Result<Unit, path.Error> uses Console {
    bounds(256, 32, 64) => roomy
    show("empty", "", legacy.Style.Posix, roomy)?
    show("unicode", "/한/😀", legacy.Style.Posix, roomy)?
    show("dots", "a//./../b/", legacy.Style.Posix, roomy)?
    show("posix-backslash", """a\b/c""", legacy.Style.Posix, roomy)?
    show("drive-absolute", """C:\dir\..\file""", legacy.Style.Windows, roomy)?
    show("drive-relative", """c:foo\bar""", legacy.Style.Windows, roomy)?
    show("rooted", """\dir""", legacy.Style.Windows, roomy)?
    show("unc", """\\server\share\file""", legacy.Style.Windows, roomy)?
    show("mixed-unc", """\/server/share\leaf""", legacy.Style.Windows, roomy)?
    show("posix-repeat", "///a//", legacy.Style.Posix, roomy)?
    show("posix-colon", "a:b", legacy.Style.Posix, roomy)?
    show("windows-repeat", """foo\\bar""", legacy.Style.Windows, roomy)?

    rejectCreation("invalid-limits", "", legacy.Style.Posix, bounds(-1, 1, 1))
    rejectCreation("input-limit", "abc", legacy.Style.Posix, bounds(2, 1, 3))
    [UInt8; ~] => nulBytes!
    appendByte(nulBytes!, 97)
    appendByte(nulBytes!, 0)
    appendByte(nulBytes!, 98)
    nulBytes! -> file.borrowBytes => nulSource
    nulSource -> slice(0, nulSource -> len) => nulText
    rejectCreation("nul", nulText, legacy.Style.Posix, roomy)
    rejectCreation("namespace", """\\?\C:\""", legacy.Style.Windows, roomy)
    rejectCreation("triple-root", """\\\a""", legacy.Style.Windows, roomy)
    rejectCreation("unc-incomplete", """\\srv""", legacy.Style.Windows, roomy)
    rejectCreation("unc-dot-share", """\\srv\..""", legacy.Style.Windows, roomy)

    rejectNext("count", "/a", legacy.Style.Posix, bounds(2, 1, 8), 1)?
    rejectNext("size", "/abc", legacy.Style.Posix, bounds(4, 4, 2), 1)?
    rejectNext("precedence", "abc", legacy.Style.Posix, bounds(3, 0, 0), 0)?
    show("exact", "/abc", legacy.Style.Posix, bounds(4, 2, 3))?
    localComponentMetadata()? -> when {
        Some(component) { "metadata=$(kindName(component.kind))@$(component.offset)+$(component.length)" -> println }
        None { "unexpected-metadata-end" -> println }
    }
    Result<Unit, path.Error>.Ok
}

main {
    run() -> when {
        Ok(done) { }
        Err(error) { "unexpected=$(errorName(error.kind))@$(error.offset)" -> println }
    }
}
