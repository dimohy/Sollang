import std.net.quic.error as errors
import std.net.quic.frame as frames
import std.net.quic.transport_parameters as transport

verifyMaxData: -> Result<Bool, errors.Error> {
    frames.Value.MaxData(65_537) -> frames.encodeValue? => encoded
    frames.decode(encoded, 0)? => decoded
    decoded.frame -> when {
        MaxData(maximum) { Result<Bool, errors.Error>.Ok(maximum == 65_537 and decoded.nextOffset == UIntSize(encoded -> len)) }
        else { Result<Bool, errors.Error>.Ok(false) }
    }
}

verifyMaxStreamData: -> Result<Bool, errors.Error> {
    frames.Value.MaxStreamData(frames.MaxStreamData { id: 4, maximum: 90_000 }) -> frames.encodeValue? => encoded
    frames.decode(encoded, 0)? => decoded
    decoded.frame -> when {
        MaxStreamData(limit) { Result<Bool, errors.Error>.Ok(limit.id == 4 and limit.maximum == 90_000) }
        else { Result<Bool, errors.Error>.Ok(false) }
    }
}

verifyMaxStreams: -> Result<Bool, errors.Error> {
    frames.Value.MaxStreams(frames.MaxStreams {
        bidirectional: false
        maximum: 1_152_921_504_606_846_976
    }) -> frames.encodeValue? => encoded
    frames.decode(encoded, 0)? => decoded
    decoded.frame -> when {
        MaxStreams(limit) {
            not limit.bidirectional
                and limit.maximum == 1_152_921_504_606_846_976
                -> unless { Result<Bool, errors.Error>.Ok(false) -> return }
        }
        else { Result<Bool, errors.Error>.Ok(false) -> return }
    }
    frames.Value.MaxStreams(frames.MaxStreams {
        bidirectional: true
        maximum: 1_152_921_504_606_846_977
    }) -> frames.encodeValue -> when {
        Ok(unexpected) { Result<Bool, errors.Error>.Ok(false) -> return }
        Err(error) {
            error.code == errors.frameEncodingError()
                -> unless { Result<Bool, errors.Error>.Ok(false) -> return }
        }
    }
    # Frame type followed by the eight-byte QUIC varint for 2^60 + 1.
    frames.decode([18, 208, 0, 0, 0, 0, 0, 0, 1], 0) -> when {
        Ok(unexpected) { Result<Bool, errors.Error>.Ok(false) -> return }
        Err(error) {
            error.code == errors.frameEncodingError()
                -> unless { Result<Bool, errors.Error>.Ok(false) -> return }
        }
    }
    frames.decode([22, 208, 0, 0, 0, 0, 0, 0, 1], 0) -> when {
        Ok(unexpected) { Result<Bool, errors.Error>.Ok(false) -> return }
        Err(error) {
            error.code == errors.frameEncodingError()
                -> unless { Result<Bool, errors.Error>.Ok(false) -> return }
        }
    }
    1_152_921_504_606_846_976 -> transport.streamCount? => finalValid
    finalValid -> value => finalValue
    1_152_921_504_606_846_977 -> transport.streamCount -> when {
        Ok(unexpected) { Result<Bool, errors.Error>.Ok(false) -> return }
        Err(error) {
            finalValue == 1_152_921_504_606_846_976 => countValid
            error.code == errors.transportParameterError() => errorValid
            Result<Bool, errors.Error>.Ok(countValid and errorValid)
        }
    }
}

verifyDataBlocked: -> Result<Bool, errors.Error> {
    frames.Value.DataBlocked(70_000) -> frames.encodeValue? => encoded
    frames.decode(encoded, 0)? => decoded
    decoded.frame -> when {
        DataBlocked(limit) { Result<Bool, errors.Error>.Ok(limit == 70_000) }
        else { Result<Bool, errors.Error>.Ok(false) }
    }
}

verifyStreamDataBlocked: -> Result<Bool, errors.Error> {
    frames.Value.StreamDataBlocked(frames.StreamDataBlocked { id: 8, limit: 80_000 }) -> frames.encodeValue? => encoded
    frames.decode(encoded, 0)? => decoded
    decoded.frame -> when {
        StreamDataBlocked(blocked) { Result<Bool, errors.Error>.Ok(blocked.id == 8 and blocked.limit == 80_000) }
        else { Result<Bool, errors.Error>.Ok(false) }
    }
}

verifyStreamsBlocked: -> Result<Bool, errors.Error> {
    frames.Value.StreamsBlocked(frames.StreamsBlocked { bidirectional: true, limit: 33 }) -> frames.encodeValue? => encoded
    frames.decode(encoded, 0)? => decoded
    decoded.frame -> when {
        StreamsBlocked(blocked) { Result<Bool, errors.Error>.Ok(blocked.bidirectional and blocked.limit == 33) }
        else { Result<Bool, errors.Error>.Ok(false) }
    }
}

run: -> Result<Bool, errors.Error> {
    verifyMaxData()? => maxData
    verifyMaxStreamData()? => maxStreamData
    verifyMaxStreams()? => maxStreams
    verifyDataBlocked()? => dataBlocked
    verifyStreamDataBlocked()? => streamDataBlocked
    verifyStreamsBlocked()? => streamsBlocked
    Result<Bool, errors.Error>.Ok(
    maxData and maxStreamData and maxStreams
        and dataBlocked and streamDataBlocked and streamsBlocked)
}

main {
    run() -> when {
        Ok(valid) { valid -> if { "flow-control-frames=ok" } else { "flow-control-frames=failed" } -> println }
        Err(error) { "flow-control-frames-error=$(error.code)" -> println }
    }
}
