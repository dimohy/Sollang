struct Holder {
    value: sys.directory.RawResult
}
make: -> Holder {
    Holder {
        value: sys.directory.RawResult.Ok(sys.directory.Raw { bytes: [17; ~], count: 1 })
    }
}
first holder: ref Holder -> UInt8 {
    holder.value -> when {
        Ok(raw) { raw.bytes[0] }
        Err(message) { 0 }
    }
}
main {
    make() => holder
    holder -> first -> println
    holder -> first -> println
}
