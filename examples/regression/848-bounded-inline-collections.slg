struct BoundedBundle {
    values: [Int; <=8]
    lookup: {Int: Int; <=8}
}

makeBoundedValues: -> [Int; <=8] {
    [41, 42; <=8] => values!
    values!
}

makeBoundedLookup: -> {Int: Int; <=8} {
    {4: 40, 5: 50; <=8} => lookup!
    lookup!
}

countBounded values: [Int; <=8] -> Int {
    values -> len
}

appendBounded values: mut [Int; <=8] -> Unit {
    values -> push(13)
}

putBounded values: mut {Int: Int; <=8} -> Unit {
    values -> put(13, 130)
}

main {
    [Int; <=8] => values!
    [1, 2; <=8] => seeded!
    values! -> push(7)
    values! -> push(11)
    values! -> len => valueCount
    values! -> capacity => valueCapacity
    values![0] => first
    values! -> countBounded => calledCount
    values! -> appendBounded
    values! -> len => mutatedValueCount
    seeded! -> len => seededCount

    {Int: Int; <=8} => lookup!
    {1: 10, 2: 20; <=8} => seededLookup!
    lookup! -> put(7, 70)
    lookup! -> put(11, 110)
    lookup! -> len => lookupCount
    lookup! -> capacity => lookupCapacity
    lookup![11] => found
    seededLookup![2] => seededValue
    lookup! -> putBounded
    lookup! -> take(7) => takenValue
    lookup! -> put(23, 230)
    lookup![23] => reusedValue
    lookup! -> len => mutatedLookupCount

    makeBoundedValues() => returnedValues!
    makeBoundedLookup() => returnedLookup!
    BoundedBundle {
        values: returnedValues!
        lookup: returnedLookup!
    } => bundle!
    bundle.values![1] => nestedValue
    bundle.lookup![5] => nestedLookupValue

    "array len=$valueCount capacity=$valueCapacity first=$first seeded=$seededCount called=$calledCount mutated=$mutatedValueCount" -> println
    "dictionary len=$lookupCount capacity=$lookupCapacity found=$found seeded=$seededValue taken=$takenValue reused=$reusedValue mutated=$mutatedLookupCount" -> println
    "nested array=$nestedValue dictionary=$nestedLookupValue" -> println
}
