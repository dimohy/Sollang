sameText source: Text, expected: Text -> Bool {
    source == expected
}

main {
    true and "abc" -> sameText("abc") => rightFlow
    "abc" -> len == 3 and rightFlow => comparedFlow
    false or "abc" -> sameText("abc") => alternativeFlow

    rightFlow and comparedFlow and alternativeFlow
        -> if {
            "value-flow-logical-precedence=valid" -> println
        }
}
