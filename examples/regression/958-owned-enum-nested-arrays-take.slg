import sys.quic.error as errors
import sys.quic.frame
import sys.quic.frame_types as frames

connectionId: -> [UInt8; ~] => [1, 2, 3, 4, 5, 6, 7, 8; ~]

run: -> Result<Bool, errors.Error> {
    [frames.Value; ~] => source!
    source! -> push(frames.Value.NewConnectionId(frames.NewConnectionId {
        sequence: 1
        retirePriorTo: 0
        connectionId: connectionId()
        statelessResetToken: [9; 16]
    }))
    source! -> push(frames.Value.Ping)
    frame.encodeAll(source!)? => encoded
    frame.decodeAll(encoded)? => decoded!
    false => valid!
    decoded! -> take(0) -> when {
        NewConnectionId(value) {
            (value.sequence == 1
                and value.retirePriorTo == 0
                and (value.connectionId -> len) == 8
                and value.connectionId[0] == 1
                and value.statelessResetToken[15] == 9) => valid!
        }
        else {}
    }
    decoded! -> take(0) -> when {
        Ping {}
        else { false => valid! }
    }
    Result<Bool, errors.Error>.Ok(valid!)
}

main {
    run() -> when {
        Ok(valid) { valid -> if { "owned-nested-arrays=ok" } else { "owned-nested-arrays=failed" } -> println }
        Err(value) { "owned-nested-arrays-error=$(value.code)" -> println }
    }
}
