import sys.io
import std.net as net
import std.net.socket as socket

observeTcp: -> Result<Bool, socket.SocketError> uses Network {
    socket.ListenOptions {
        endpoint: net.loopback(0) -> unified
        backlog: 4
        reuseAddress: true
    } -> listen? => listener
    listener -> localEndpoint? => listenerLocal
    listenerLocal -> connect? => client
    client -> localEndpoint? => clientLocal
    client -> remoteEndpoint? => clientRemote
    listener -> accept? => server
    server -> localEndpoint? => serverLocal
    server -> remoteEndpoint? => serverRemote
    listenerLocal -> port => listenerPort
    clientLocal -> port => clientPort
    clientRemote -> port => clientRemotePort
    serverLocal -> port => serverPort
    serverRemote -> port => serverRemotePort
    client -> close
    server -> close
    listener -> close
    Result<Bool, socket.SocketError>.Ok(
        listenerPort > 0
            and clientPort > 0
            and clientRemotePort == listenerPort
            and serverPort == listenerPort
            and serverRemotePort == clientPort)
}

observeUdp: -> Result<Bool, socket.SocketError> uses Network {
    socket.DatagramBindOptions {
        endpoint: net.loopback(0) -> unified
        reuseAddress: true
    } -> bind? => datagram
    datagram -> localEndpoint? => local
    local -> port => port
    datagram -> close
    Result<Bool, socket.SocketError>.Ok(port > 0)
}

main {
    observeTcp() -> when {
        Ok(tcp) {
            observeUdp() -> when {
                Ok(udp) {
                    tcp and udp -> if {
                        "socket-endpoints=ok"
                    } else {
                        "socket-endpoints=failed"
                    } -> println
                }
                Err(error) { "socket-endpoints-error=$(error.code)" -> println }
            }
        }
        Err(error) { "socket-endpoints-error=$(error.code)" -> println }
    }
}
