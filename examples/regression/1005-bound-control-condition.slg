main {
    true => indexReady
    true => moreWorkRemaining
    false => skippedThisRound
    (indexReady and moreWorkRemaining and not skippedThisRound)
        -> if {
            "wrapped-if" -> println
        }

    0 => index!
    true => stillScanningPrefix
    1 => remainingPrefixLength
    (stillScanningPrefix and index! < remainingPrefixLength)
        -> while {
            "wrapped-while" -> println
            index! + 1 => index!
        }
}

