enum OwnedChoice {
    First([UInt8; ~])
    Second([UInt8; ~])
}

measure choice: move OwnedChoice -> Int {
    choice -> when {
        First(bytes) {
            bytes -> len => length
            length -> return
        }
        Second(bytes) {
            bytes -> len => length
            length -> return
        }
    }
    0
}

main {
    [UInt8(1), UInt8(2); ~] => firstBytes!
    OwnedChoice.First(firstBytes!) => firstChoice!
    firstChoice! -> measure => first

    [UInt8(3), UInt8(4), UInt8(5); ~] => secondBytes!
    OwnedChoice.Second(secondBytes!) => secondChoice!
    secondChoice! -> measure => second
    "enum early return=$first,$second" -> println
}
