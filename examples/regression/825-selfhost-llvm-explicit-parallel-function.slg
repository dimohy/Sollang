import sollang.compiler.llvm.text as llvm

# Explicit parallel branches use the structured compute runtime from ordinary
# function bodies as well as from the program entry point.
main {
    [
        """
        double value: Int -> Int => value * 2
        square value: Int -> Int => value * value
        run value: Int -> (doubled: Int, squared: Int) {
            value -> parallel branch {
                doubled: ref -> double
                squared: ref -> square
            }
        }
        main {
            7 -> run => results
            results.doubled + results.squared -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
