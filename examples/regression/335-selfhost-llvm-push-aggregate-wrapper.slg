import sollang.compiler.llvm.text as llvm

main {
    [
    """
    struct Counts {
        count: Int
    }

    collect enabled: Bool -> Int {
        [Counts; ~] => items!
        "abc" => value
        enabled -> if {
            items! -> push(Counts { count: Int(value -> len) })
        }
        0
    }

    main { true -> collect -> println }
    """; ~
    ] => sources!
    sources! -> llvm.emit
}
