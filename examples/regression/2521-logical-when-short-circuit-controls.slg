enum Kind {
    File
    Directory
}

touch label: Text -> Bool uses Console {
    label -> println
    true
}

show value: Bool -> Unit uses Console {
    value -> if { "true" } else { "false" } -> println
}

enumAnd enabled: Bool, kind: Kind -> Bool uses Console {
    enabled and (kind -> when {
        Directory => "enum" -> touch
        else => false
    })
}

enumOr enabled: Bool, kind: Kind -> Bool uses Console {
    enabled or (kind -> when {
        Directory => "enum" -> touch
        else => false
    })
}

booleanAnd enabled: Bool, flag: Bool -> Bool uses Console {
    enabled and (when {
        flag => "boolean" -> touch
        else => false
    })
}

booleanOr enabled: Bool, flag: Bool -> Bool uses Console {
    enabled or (when {
        flag => "boolean" -> touch
        else => false
    })
}

subjectAnd enabled: Bool, value: Int -> Bool uses Console {
    enabled and (value -> when {
        == 7 => "subject" -> touch
        else => false
    })
}

subjectOr enabled: Bool, value: Int -> Bool uses Console {
    enabled or (value -> when {
        == 7 => "subject" -> touch
        else => false
    })
}

main {
    enumAnd(false, Kind.Directory) -> show
    enumAnd(true, Kind.Directory) -> show
    enumOr(true, Kind.Directory) -> show
    enumOr(false, Kind.Directory) -> show
    booleanAnd(false, true) -> show
    booleanAnd(true, true) -> show
    booleanOr(true, true) -> show
    booleanOr(false, true) -> show
    subjectAnd(false, 7) -> show
    subjectAnd(true, 7) -> show
    subjectOr(true, 7) -> show
    subjectOr(false, 7) -> show
    0 => index!
    index! < 2 and (index! -> when {
        < 2 => true
        else => false
    }) -> while { index! + 1 => index! }
    index! -> println
}
