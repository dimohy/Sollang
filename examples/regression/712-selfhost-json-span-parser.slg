import sollang.compiler.json as json
import sys.file as file

main {
    [UInt8; ~] => sourceBytes!
    """{"kind":"FunctionDecl","inner":[{"name":"add"},{"name":"scale"}]}""" => sourceText
    UIntSize(0) => sourceIndex!
    sourceIndex! < (sourceText -> len) -> while {
        sourceBytes! -> push(sourceText -> byte(sourceIndex!))
        sourceIndex! + UIntSize(1) => sourceIndex!
    }
    sourceBytes! -> file.borrowBytes => source!
    source! -> json.parse(UIntSize(0), source! -> len) => root
    source! -> json.findMember(root, "kind") => kindMember
    source! -> json.decodeString(kindMember.value) => kind!
    source! -> json.findMember(root, "inner") => innerMember
    source! -> json.firstArrayValue(innerMember.value) => first
    source! -> json.findMember(first.value, "name") => firstNameMember
    source! -> json.decodeString(firstNameMember.value) => firstName!
    source! -> json.nextArrayValue(innerMember.value, first.next) => second
    source! -> json.findMember(second.value, "name") => secondNameMember
    source! -> json.decodeString(secondNameMember.value) => secondName!
    kind! -> file.borrowBytes => kindSource!
    firstName! -> file.borrowBytes => firstSource!
    secondName! -> file.borrowBytes => secondSource!
    kindSource! -> slice(UIntSize(0), kindSource! -> len) => kindText
    firstSource! -> slice(UIntSize(0), firstSource! -> len) => firstText
    secondSource! -> slice(UIntSize(0), secondSource! -> len) => secondText
    "$kindText:$firstText,$secondText" -> println
}
