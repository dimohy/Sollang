# A generic type application's balanced type clause owns its angles, while a
# greater-than token in or after the call arguments remains a real comparison.
makeError message: Text -> Result<Int, Text> {
    Result<Int, Text>.Err(message) => result
    result
}

main {
    makeError("generic") -> when {
        Ok(value) { "$value" -> println }
        Err(message) { message -> println }
    }
    Result<Bool, Text>.Ok(3 > 2) => nested
    nested -> when {
        Ok(value) { "argument=$value" -> println }
        Err(message) { message -> println }
    }
    3 > 2 => greater
    "comparison=$greater" -> println
}
