enum Style {
    Posix
    Windows
}

endsWith style: Style, last: UInt8 -> Bool {
    false => found!
    true -> if {
        style -> when {
            Posix => last == 47
            Windows => last == 47 or last == 92
        } => found!
    }
    found!
}

main {
    Style.Windows -> endsWith(92) => result
    "when-binding=$result" -> println
}
