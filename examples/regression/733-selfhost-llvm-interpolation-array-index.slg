import sollang.compiler.llvm.text as llvm

# Interpolation preserves one expression root for an indexed array element and
# uses the canonical width of a computed UIntSize subscript.
main {
    [
        """
        showLast values: [Text; ~] -> Unit {
            "selected=$(values[(values -> len) - 1])" -> println
        }

        main {
            ["first", "last"; ~] -> showLast
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
