table: -> [UInt8] => [3, 5, 7, 11, 13, 17, 19, 23]

computed first: UInt8 -> [UInt8; 2] => [first, UInt8(UInt32(first) + 1)]

fixedTable: -> [UInt8; 2] => [29, 31]

ownedTable: -> [UInt8; ~] => [37, 41; ~]

main {
    0 => sum!
    0 => pass!
    pass! < 1000 -> while {
        table() => values
        0 => index!
        index! < (values -> len) -> while {
            sum! + Int(values[index!]) => sum!
            index! + 1 => index!
        }
        pass! + 1 => pass!
    }
    43 -> computed => computedValues
    fixedTable() => fixedValues
    ownedTable() => ownedValues
    sum! + Int(computedValues[0]) => sum!
    sum! + Int(computedValues[1]) => sum!
    sum! + Int(fixedValues[0]) => sum!
    sum! + Int(fixedValues[1]) => sum!
    sum! + Int(ownedValues[0]) => sum!
    sum! + Int(ownedValues[1]) => sum!
    sum! -> println
}
