struct Holder {
    values: [UInt8; 8]
}

inspect source: Holder, selected: Bool -> UInt8 {
    selected -> if {
        source => copied
        copied.values[0] -> return
    }
    0
}

main {
    Holder { values: [7; 8] } => original
    inspect(original, true) => first
    "first=$first,original=$(original.values[0])" -> println
}
