import sollang.compiler.semantic.calls as calls

main {
    [
        """
        native fixture from "artifacts/native-interop/native_fixture" {
            add left: Int32, right: Int32 -> Int32 as "native_add"
        }

        main {
            fixture.add(20, 22)
        }
        """; ~
    ] => sources!
    sources! -> calls.resolveModules => resolved!
    resolved! -> each call {
        call.functionSymbol >= 0 -> if {
            "native call = $(call.origin),$(call.targetSourceModule),$(call.functionSymbol),$(call.status)" -> println
        }
    }
}
