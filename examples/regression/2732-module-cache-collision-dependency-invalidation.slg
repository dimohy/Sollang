import sollang.compiler.semantic.module_cache as cache

main {
    [
    """
    namespace identity.mmmmmmmmmmmmmmmmmmmmmmmm
    public struct Entry { public value: Int }

    """,
    """
    namespace identity.nkllmlnlmpnjnmnmmomooioj
    public struct Entry { public value: Int }

    """,
    """
    namespace consumer
    import identity.nkllmlnlmpnjnmnmmomooioj as provider
    public answer: -> Int => 1

    """; ~
    ] => baseline
    [
    """
    namespace identity.mmmmmmmmmmmmmmmmmmmmmmmm
    public struct Entry { public value: Int }

    """,
    """
    namespace identity.nkllmlnlmpnjnmnmmomooioj
    public struct Entry { public value: Int, public other: Int }

    """,
    """
    namespace consumer
    import identity.nkllmlnlmpnjnmnmmomooioj as provider
    public answer: -> Int => 1

    """; ~
    ] => changed
    baseline -> cache.encode(173) => words
    words -> cache.reuse(changed, 173) => reuse
    reuse.hits -> println
    reuse.misses -> println
}
