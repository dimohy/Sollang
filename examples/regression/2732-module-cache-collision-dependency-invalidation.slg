import sollang.compiler.semantic.module_cache as cache

main {
    [
        "namespace identity.mmmmmmmmmmmmmmmmmmmmmmmm\npublic struct Entry { public value: Int }\n",
        "namespace identity.nkllmlnlmpnjnmnmmomooioj\npublic struct Entry { public value: Int }\n",
        "namespace consumer\nimport identity.nkllmlnlmpnjnmnmmomooioj as provider\npublic answer: -> Int => 1\n"; ~
    ] => baseline
    [
        "namespace identity.mmmmmmmmmmmmmmmmmmmmmmmm\npublic struct Entry { public value: Int }\n",
        "namespace identity.nkllmlnlmpnjnmnmmomooioj\npublic struct Entry { public value: Int, public other: Int }\n",
        "namespace consumer\nimport identity.nkllmlnlmpnjnmnmmomooioj as provider\npublic answer: -> Int => 1\n"; ~
    ] => changed
    baseline -> cache.encode(173) => words
    words -> cache.reuse(changed, 173) => reuse
    reuse.hits -> println
    reuse.misses -> println
}
