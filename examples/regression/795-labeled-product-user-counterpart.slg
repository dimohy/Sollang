# Labeled products preserve field names across binding and function boundaries.
weighted pair: (left: Int, right: Int) -> Int => pair.left * 10 + pair.right

main {
    (left: 4, right: 2) => pair
    pair.left => left
    pair.right => right
    pair -> weighted => total
    "left=$left, right=$right, total=$total" -> println
}
