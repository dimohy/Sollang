import sollang.compiler.llvm.text as llvm

main {
    [
        """
        struct Packet {
            source: [UInt8; ~]
            bytes: [UInt8; ~]
        }

        extract packet: move Packet -> Result<[UInt8; ~], Int> {
            Result<[UInt8; ~], Int>.Ok(packet.bytes)
        }

        main {
            Packet {
                source: [1, 2, 3; ~]
                bytes: [7, 8; ~]
            } -> extract -> when {
                Ok(bytes) { "result-struct-field=$(bytes -> len),$(bytes[1])" -> println }
                Err(error) { "unexpected=$error" -> println }
            }
        }
        """
    ] => sources
    sources -> llvm.emit
}
