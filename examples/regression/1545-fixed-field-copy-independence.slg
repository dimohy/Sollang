struct Packet { bytes: [UInt8; 1] }
make: -> [UInt8; 1] { [13] }
main {
    make() => bytes!
    # Each aggregate owns its copy before the source is mutated.
    Packet { bytes: bytes! } => named
    (bytes: bytes!, marker: 0) => product
    [Packet; { bytes: bytes! }] => contextual
    Packet { bytes: named.bytes } => projected
    17 => bytes![0]
    bytes![0] -> println
    named.bytes[0] -> println
    product.bytes[0] -> println
    contextual[0].bytes[0] -> println
    projected.bytes[0] -> println
}
