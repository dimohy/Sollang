ordinary: -> Unit uses Console {
    [Int; 0~] => a!
    a! -> len -> println
    a! -> capacity -> println
    a! -> push(10)
    a! -> push(20)
    a! -> len -> println
    a![1] -> println
    [Int; 4~] => b!
    b! -> len -> println
    b! -> capacity -> println
    b! -> push(10)
    b! -> push(20)
    b! -> len -> println
    b![1] -> println
}
nested: -> Unit uses Console { true -> if {
        [Int; 0~] => a!
        a! -> len -> println
        a! -> capacity -> println
        a! -> push(10)
        a! -> push(20)
        a! -> len -> println
        a![1] -> println
        [Int; 4~] => b!
        b! -> len -> println
        b! -> capacity -> println
        b! -> push(10)
        b! -> push(20)
        b! -> len -> println
        b![1] -> println
} }
looped: -> Unit uses Console { 0 => index!
    index! < 1 -> while {
        [Int; 0~] => a!
        a! -> len -> println
        a! -> capacity -> println
        a! -> push(10)
        a! -> push(20)
        a! -> len -> println
        a![1] -> println
        [Int; 4~] => b!
        b! -> len -> println
        b! -> capacity -> println
        b! -> push(10)
        b! -> push(20)
        b! -> len -> println
        b![1] -> println
        index! + 1 => index!
} }
main {
    [Int; 0~] => a!
    a! -> len -> println
    a! -> capacity -> println
    a! -> push(10)
    a! -> push(20)
    a! -> len -> println
    a![1] -> println
    [Int; 4~] => b!
    b! -> len -> println
    b! -> capacity -> println
    b! -> push(10)
    b! -> push(20)
    b! -> len -> println
    b![1] -> println
    ordinary()
    nested()
    looped()
    [7; 3] => repeated
    repeated -> len -> println
    repeated[2] -> println
}
