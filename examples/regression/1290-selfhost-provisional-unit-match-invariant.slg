import sollang.compiler.ir.stream as streamIr
import sollang.compiler.ir.typed as typedIr
import sollang.compiler.llvm.emitter.context as emitterContext
import sollang.compiler.llvm.text as llvm
import sollang.compiler.semantic.library_imports as libraryImports
import sollang.compiler.semantic.type_ids as typeIds

# V011 must recognize both legal arm shapes: a direct terminal and a nested
# block region. Either shape retaining provisional Unit would produce invalid
# LLVM when the match feeds a mutable assignment.
main {
    [
    typedIr.TypedIrNode { kind: 6, parent: -1, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 4, typeModule: -1, typeSymbol: 1, typeId: 0, typeKind: 7, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 27, parent: -1, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: 0, operand1: 2, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 19, parent: 1, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: 3, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 4, parent: 2, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 23, typeId: 2, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 27, parent: -1, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: 0, operand1: 5, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 19, parent: 4, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: 6, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 19, parent: 5, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: 7, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 4, parent: 6, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 23, typeId: 2, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 27, parent: -1, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: 0, operand1: 9, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 19, parent: 8, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: 10, nextOperand: 11, flags: 0 },
    typedIr.TypedIrNode { kind: 4, parent: 9, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 23, typeId: 2, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 19, parent: 8, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: 12, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 19, parent: 11, sourceModule: -1, astNode: -1, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: -1, flags: 0 }; ~
    ] => ir
    [
    typeIds.SemanticType { kind: 7, origin: 4, module: -1, symbol: 1, first: 1, second: 1, length: -1, lengthHash: 0, containsParameter: false, status: 0 },
    typeIds.SemanticType { kind: 1, origin: 1, module: -1, symbol: 0, first: -1, second: -1, length: -1, lengthHash: 0, containsParameter: false, status: 0 },
    typeIds.SemanticType { kind: 1, origin: 1, module: -1, symbol: 23, first: -1, second: -1, length: -1, lengthHash: 0, containsParameter: false, status: 0 }; ~
    ] => types
    emitterContext.EmitContext {
        initializerDiagnostics: []
        sources: []
        ranges: []
        nodes: []
        constantLiterals: []
        constantFailures: []
        tokens: []
        symbols: []
        calls: []
        finalCallResolvedByAst: []
        libraries: libraryImports.LibraryCatalog { diagnosticCount: 0, bindings: [], sources: [], interfaces: [], runtimeLibraries: [] }
        libraryCalls: []
        libraryCallDiagnostics: []
        interpolationRanges: []
        interpolations: []
        ir: ir
        genericCallPlans: []
        genericBodies: typedIr.GenericBodyBindings { functionsByCall: [], templatesByFunction: [] }
        streamPlan: streamIr.StreamPlan { pipelines: [], stages: [], junctions: [], junctionInputs: [], partitionRoutes: [] }
        moves: []
        nominal: []
        composite: []
        modules: []
        imports: []
        resolvedImports: []
        types: types
        typeReferences: []
        typeTerms: []
        fields: []
        typeSizes: []
        typeAligns: []
        typeLayoutStatuses: []
        typeTraits: []
        pointerBitWidth: 64
        targetArchitecture: 1
        cpuDispatchPolicy: 1
        requiredCpuFeatures: 1
        allowedCpuFeatures: 1_022
        forbiddenCpuFeatures: 0
        supportsComputePool: false
        expectedPathStyle: 1
        usesConcurrentStreamJoins: false
        ownershipDiagnostics: []
    } => context
    [Int; ~] => functions
    context -> llvm.irInvariantCode(1, functions) => directCode
    context -> llvm.irInvariantCode(4, functions) => nestedCode
    context -> llvm.irInvariantCode(8, functions) => incompleteCode
    "provisional Unit match invariants = $directCode,$nestedCode,$incompleteCode" -> println
}
