struct ByteTriple {
    first: UInt8
    second: UInt8
    third: UInt8
}

struct WordTriple {
    first: Int
    second: Int
    third: Int
}

main {
    {Int: ByteTriple; <=2} => boundedBytes!
    {Int: WordTriple; <=2} => boundedWords!
    {Int: ByteTriple} => bytes!
    {Int: WordTriple} => words!
    ByteTriple { first: 4, second: 5, third: 6 } => byteValue
    WordTriple { first: 4, second: 5, third: 6 } => wordValue
    boundedBytes! -> put(1, byteValue)
    boundedWords! -> put(1, wordValue)
    bytes! -> put(1, byteValue)
    words! -> put(1, wordValue)
    boundedBytes![1] => boundedByte
    boundedWords![1] => boundedWord
    bytes![1] => heapByte
    words![1] => heapWord
    boundedByte.first + boundedByte.second + boundedByte.third -> println
    boundedWord.first + boundedWord.second + boundedWord.third -> println
    heapByte.first + heapByte.second + heapByte.third -> println
    heapWord.first + heapWord.second + heapWord.third -> println
}
