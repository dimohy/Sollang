import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.modules as modules
import sollang.compiler.semantic.calls as calls

verify missing: Int, caller: Int -> Unit uses Console {
    caller == 1 => conflict
    caller == 2 => qualified
    [
    """
    namespace sys.io
    public print value: Int -> Int => value

    """,
    """
    namespace sys.io
    public println value: Int -> Int => value

    """,
    """
    namespace sys.io
    public readInt value: Int -> Int => value

    """,
    """
    namespace sys.random
    public seed value: Int -> Int => value

    """,
    """
    namespace sys.random
    public below value: Int -> Int => value

    """,
    """
    namespace sys.file
    public openIntWriter value: Int -> Int => value

    """,
    """
    namespace sys.file
    public writeInt value: Int -> Int => value

    """,
    """
    namespace sys.file
    public closeIntWriter value: Int -> Int => value

    """,
    """
    namespace sys.file
    public openIntReader value: Int -> Int => value

    """,
    """
    namespace sys.file
    public closestInt value: Int -> Int => value

    """,
    """
    namespace sys.file
    public closeIntReader value: Int -> Int => value

    """,
    """
    namespace sys.runtime
    public parallel value: Int -> Int => value

    """,
    """
    namespace sys.runtime
    public tryParallel value: Int -> Int => value

    """,
    """
    namespace sys.runtime
    public limitParallelWorkers value: Int -> Int => value

    """,
    """
    namespace sys.runtime
    public parallelWorkers value: Int -> Int => value

    """,
    """
    namespace sys.runtime
    public parallelPeakWorkers value: Int -> Int => value

    """] => canonical
    [Text; ~] => sources!
    0 => index!
    index! < (canonical -> len) -> while {
        index! != missing -> if { sources! -> push(canonical[index!]) }
        index! + 1 => index!
    }
    sources! -> len => trusted
    conflict -> if {
        sources! -> push("parallelWorkers: -> Int => 1\nmain {}\n")
    } else {
        qualified -> if {
            sources! -> push("parallelWorkers.extra: -> Int => 1\nmain {}\n")
        } else {
            sources! -> push(
            """
            main {}

            """)
        }
    }
    sources! -> analysis.analyze => package
    package -> modules.identitiesAnalyzed => identities
    package -> calls.firstGlobalFunctionAliasDiagnostic(identities, 0, trusted) => result
    result.marker -> calls.globalFunctionAliasModule => moduleName
    result.marker -> calls.canonicalGlobalFunctionAliasName => targetName
    result.functionSymbol >= 0 and result.targetSourceModule >= 0 => selected
    "missing=$missing conflict=$conflict qualified=$qualified code=$(result.code) target=$moduleName.$targetName selected=$selected" -> println
}

main {
    -1 -> verify(0)
    0..15 -> each index { index -> verify(0) }
    -1 -> verify(1)
    -1 -> verify(2)
}
