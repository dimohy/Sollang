struct Storage { values: {Key: Int} }
struct Key { id: Int }
trait Hash { hash: self -> Int }
trait Eq { eq: self -> Int }
impl Hash for Key { hash: self -> Int => self.id }
impl Eq for Key { eq: self -> Int => self.id }

main {
    {Key: Int; 2~} => values!
    values! -> put(Key { id: 2 }, 42)
    Storage { values: values! } => storage
    storage.values[Key { id: 2 }] -> println
}
