transform value: Result<Int, Int> -> Result<Int, Int> {
    value -> when {
        Ok(item) { item + 1 -> Result<Int, Int>.Ok }
        Err(error) { error + 2 -> Result<Int, Int>.Err }
    }
}

success: -> Result<Int, Int> {
    7 -> Result<Int, Int>.Ok -> transform
}

failure: -> Result<Int, Int> {
    9 -> Result<Int, Int>.Err -> transform
}

main {
    success() -> when {
        Ok(value) { "ok=$value" -> println }
        Err(_) { "unexpected-error" -> println }
    }
    failure() -> when {
        Ok(_) { "unexpected-ok" -> println }
        Err(value) { "error=$value" -> println }
    }
}
