enum Failure { Invalid }
struct Consumer { }

impl Consumer {
    accept: self, value: Int64 -> Int64 => value
}

minimum: -> Result<Int64, Failure> {
    Result<Int64, Failure>.Ok(-9_223_372_036_854_775_808)
}

optional: -> Option<Int64> {
    Option<Int64>.Some(-9_223_372_036_854_775_808)
}

main {
    # The unary carrier and its numeric leaf share the exact declared width.
    Consumer { } => consumer
    consumer -> accept(-9_223_372_036_854_775_808) -> println
    minimum() -> when {
        Ok(value) { value -> println }
        Err(error) { "unexpected-result" -> println }
    }
    optional() -> when {
        Some(value) { value -> println }
        None { "unexpected-option" -> println }
    }
}
