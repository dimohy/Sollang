# A UIntSize field keeps its type when indexing mapped bytes in interpolation.
struct Offset {
    value: UIntSize
}

readMap: -> MappedBytes uses File {
    map read "data.bin" => data
    data
}

main {
    Offset { value: 1 } => offset
    readMap() => data
    "byte=$(data[offset.value])" -> println
}
