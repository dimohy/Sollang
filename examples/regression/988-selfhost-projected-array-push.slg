struct Buffer {
    values: [Int; ~]
}

impl Buffer {
    append: mut self, value: Int -> Unit {
        self.values -> push(value)
    }

    takeFirst: mut self -> Int => self.values -> take(0)
}

main {
    Buffer { values: [Int; ~] } => buffer!
    buffer! -> append(17)
    buffer! -> append(25)
    buffer! -> takeFirst => first
    first + buffer!.values[0] -> println
}
