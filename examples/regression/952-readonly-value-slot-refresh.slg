struct Buffer {
    bytes: [UInt8; ~]
}

first value: ref Buffer -> UInt8 => value.bytes[0]

main {
    0 => iteration!
    UInt8(0) => observed!
    iteration! < 2 -> while {
        [UInt8; ~] => bytes!
        iteration! == 0 -> if {
            bytes! -> push(7)
        } else {
            bytes! -> push(9)
        }
        Buffer { bytes: bytes! } => buffer
        iteration! == 0 -> if {
            buffer -> first => ignored
        } else {
            buffer -> first => observed!
        }
        iteration! + 1 => iteration!
    }
    observed! == 9 -> if { "readonly slot refresh ok" } else { "readonly slot refresh failed" } -> println
}
