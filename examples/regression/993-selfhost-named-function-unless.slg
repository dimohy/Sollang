import sollang.compiler.llvm.text as llvm

main {
    [
        """
        guarded kind: Int -> Int {
            1 => value!
            kind == 0 -> unless { value! + 10 => value! }
            (kind == 1 or kind == 2) -> unless { value! + 100 => value! }
            true -> if {
                kind == 3 -> unless { value! + 1_000 => value! }
            }
            value!
        }

        main {
            guarded(0) -> println
            guarded(1) -> println
            guarded(3) -> println
        }
        """; ~
    ] => sources
    sources -> llvm.emit
}
