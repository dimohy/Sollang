import sollang.compiler.llvm.text as llvm

# An interpolated Text remains deferred until it reaches a Text parameter.
# The call boundary materializes one transient value whose lifetime covers the
# call, including interpolation through an ordinary immutable binding.
main {
    [
        """
        emit value: Text -> Unit {
            value -> println
        }

        main {
            "left" => left
            "right" => right
            "$left::$right" => joined
            joined -> emit
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
