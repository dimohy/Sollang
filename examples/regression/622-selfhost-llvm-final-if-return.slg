import sollang.compiler.llvm.text as llvm

main {
    [
        """
        decide value: Int -> Bool {
            value >= 0 -> if {
                value > 1 and value < 10 and value != 5
            } else {
                value == -24
            }
        }

        main { }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
