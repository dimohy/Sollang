import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.ir.typed as typedIr

main {
    [
        "examples/regression/637-same-module-split-impl-main.slg",
        "examples/regression/sample/split_impl_type.slg",
        "examples/regression/sample/split_impl_methods.slg"; ~
    ] => paths
    paths -> semanticContext.prepareFiles => prepared!

    0 => methodCount!
    0 => sourceIndex!
    sourceIndex! < (prepared!.package.ranges -> len) -> while {
        prepared!.package.ranges[sourceIndex!] => range
        0 => symbolIndex!
        symbolIndex! < range.symbolCount -> while {
            prepared!.package.symbols[range.symbolStart + symbolIndex!] => symbol
            symbol.kind == 31 -> if { methodCount! + 1 => methodCount! }
            symbolIndex! + 1 => symbolIndex!
        }
        sourceIndex! + 1 => sourceIndex!
    }

    -1 => mainTargetSource!
    -1 => mainFunction!
    -1 => innerFunction!
    0 => failedCalls!
    0 => callIndex!
    callIndex! < (prepared!.calls -> len) -> while {
        prepared!.calls[callIndex!] => call
        call.status != 0 -> if { failedCalls! + 1 => failedCalls! }
        (call.sourceModule == 0 and call.functionSymbol >= 0) -> if {
            call.targetSourceModule => mainTargetSource!
            call.functionSymbol => mainFunction!
        }
        (call.sourceModule == 2 and call.functionSymbol >= 0) -> if {
            call.functionSymbol => innerFunction!
        }
        callIndex! + 1 => callIndex!
    }
    "split impl = $(mainTargetSource!),$(mainFunction!),$(innerFunction!),$(methodCount!),$(failedCalls!)" -> println

    prepared! -> typedIr.lowerContext => ir!
    -1 => doubleParameter!
    -1 => mainReceiver!
    -1 => innerReceiver!
    -1 => memberNode!
    -1 => memberOwner!
    -1 => memberType!
    0 => irIndex!
    irIndex! < (ir! -> len) -> while {
        ir![irIndex!] => node
        (node.kind == 0 and node.sourceModule == 2 and node.symbol == 1) -> if {
            node.operand1 => doubleParameter!
        }
        (node.kind == 6 and node.sourceModule == 0 and node.targetModule == 2 and node.symbol == 2) -> if {
            node.operand0 => mainReceiver!
        }
        (node.kind == 6 and node.sourceModule == 2 and node.targetModule == 2 and node.symbol == 1) -> if {
            node.operand0 => innerReceiver!
        }
        (node.kind == 13 and node.sourceModule == 2) -> if {
            irIndex! => memberNode!
            node.operand0 => memberOwner!
            node.typeSymbol => memberType!
        }
        irIndex! + 1 => irIndex!
    }
    0 => hasDoubleParameter!
    0 => hasMainReceiver!
    0 => hasInnerReceiver!
    0 => hasMemberNode!
    0 => hasMemberOwner!
    0 => hasIntMember!
    doubleParameter! >= 0 -> if { 1 => hasDoubleParameter! }
    mainReceiver! >= 0 -> if { 1 => hasMainReceiver! }
    innerReceiver! >= 0 -> if { 1 => hasInnerReceiver! }
    memberNode! >= 0 -> if { 1 => hasMemberNode! }
    memberOwner! >= 0 -> if { 1 => hasMemberOwner! }
    memberType! == 2 -> if { 1 => hasIntMember! }
    "split impl ir = $(hasDoubleParameter!),$(hasMainReceiver!),$(hasInnerReceiver!)" -> println
    "split impl member = $(hasMemberNode!),$(hasMemberOwner!),$(hasIntMember!)" -> println
}
