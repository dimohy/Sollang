import sollang.compiler.ir.typed as typedIr

main {
    [
        """
        struct Node {
            parent: Int
        }

        struct NodeResult {
            nodes: [Node; ~]
        }

        relocate: -> [Node; ~] {
            lower: -> NodeResult {
                NodeResult { nodes: [Node { parent: 1 }; ~] }
            }

            [Node; ~] => results!
            true -> if {
                lower()
            } else {
                lower()
            } => lowered
            0 => index!
            index! < (lowered.nodes -> len) -> while {
                lowered.nodes[index!] => node!
                node!.parent + 10 => node!.parent
                results! -> push(node!)
                index! + 1 => index!
            }
            results!
        }

        main { }
        """; ~
    ] => sources!
    sources! -> typedIr.lower => ir!
    ir! -> each node {
        (node.sourceModule == 0 and node.kind == 25 and node.operand1 >= 0) -> if {
            ir![node.operand1] => owner
            "member owner = $(owner.typeOrigin),$(owner.typeModule),$(owner.typeSymbol),$(owner.typeKind)" -> println
        }
    }
}
