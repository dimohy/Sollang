import sys.crypto.sha256 as sha256

main {
    [UInt8(97), 98, 99] => input
    sha256.digest(input) => digest
    (digest[0] == 186
        and digest[1] == 120
        and digest[2] == 22
        and digest[3] == 191
        and digest[28] == 242
        and digest[29] == 0
        and digest[30] == 21
        and digest[31] == 173) -> if { "sha256=ok" } else { "sha256=failed" } -> println
}
