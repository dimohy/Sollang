import std.crypto.sha256 as sha256

same left: [UInt8; 32], right: [UInt8; 32] -> Bool {
    0 => index!
    index! < 32 -> while {
        left[index!] == right[index!] -> unless { false -> return }
        index! + 1 => index!
    }
    true
}

main {
    sha256.create() => hasher!
    hasher! -> update([97, 98, 99])
    hasher! -> finish => digest
    [UInt8(186), 120, 22, 191, 143, 1, 207, 234, 65, 65, 64, 222, 93, 174, 34, 35, 176, 3, 97, 163, 150, 23, 122, 156, 180, 16, 255, 97, 242, 0, 21, 173] => expected
    sha256.create() => emptyHasher
    emptyHasher -> finish => emptyDigest
    [UInt8(227), 176, 196, 66, 152, 252, 28, 20, 154, 251, 244, 200, 153, 111, 185, 36, 39, 174, 65, 228, 100, 155, 147, 76, 164, 149, 153, 27, 120, 82, 184, 85] => expectedEmpty
    same(digest, expected) and same(emptyDigest, expectedEmpty)
        -> if { "sha256=ok" } else { "sha256=failed" } -> println
}
