main {
    [UInt8; ~] => bytes!
    [Int; ~] => integers!
    0 => index!
    index! < 16 -> while {
        bytes! -> push(UInt8(index!))
        integers! -> push(index!)
        index! + 1 => index!
    }
    "bytes=$(bytes! -> len),$(bytes![15]);integers=$(integers! -> len),$(integers![15])" -> println
}
