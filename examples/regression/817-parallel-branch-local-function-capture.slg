# Parallel branch transports readonly local-function captures into every structured worker arm.
run value: Int, offset: Int -> (adjusted: Int, scaled: Int) {
    adjust input: Int -> Int => input + offset
    scale input: Int -> Int => input * offset

    value -> parallel branch {
        adjusted: -> adjust
        scaled: -> scale
    }
}

main {
    5 -> run(3) => result
    "$(result.adjusted):$(result.scaled)" -> println
}
