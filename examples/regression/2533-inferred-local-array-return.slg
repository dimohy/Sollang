# Owned results and borrowed consumers declare their distinct array contracts.
run: -> Int {
    singleton value: Int -> [Int; 1] {
        [value]
    }

    arrayLength values: [Int] -> Int {
        values -> len
    }

    arrayLength(singleton(1)) => first
    arrayLength([2, 3]) => second
    first + second
}

main {
    run() -> println
}
