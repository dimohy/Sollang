choose value: Int -> Result<Int, Text> => when {
    value == 3 => Result<Int, Text>.Err("three")
    else => Result<Int, Text>.Ok(value * 2)
}

main {
    when {
        true => 7
        else => 9
    } -> println
    2 -> choose -> when {
        Ok(value) => value
        Err(error) => 0
    } -> println
    3 -> choose -> when {
        Ok(value) => "unexpected"
        Err(error) => error
    } -> println
}
