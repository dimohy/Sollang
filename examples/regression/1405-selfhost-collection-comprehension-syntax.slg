# Exercises the generated grammar VM, independently of collection evaluation.
import sollang.compiler.diagnostics as diagnostics

verify label: Text, source: Text -> Unit uses Console {
    source -> diagnostics.analyze -> len => errorCount
    "$label=$errorCount" -> println
}

main {
    "range" -> verify("main { [1..2] => values }")
    "unnamed" -> verify("main { [1..2 -> each { it * 10 }] => values }")
    "named" -> verify("main { [1..2 -> each item { item * 10 }] => values }")
    "dictionary" -> verify("main { {1..2 -> each { it: it * 10 }} => values }")
    "runtime-tail" -> verify("show values: ref [Int; ~] -> Unit uses Console { values -> each number { number -> println } }\nmain {}")
    "mixed-array" -> verify("main { [0, 1..2 -> each { it * 10 }, 30] => values }")
    "dynamic-array" -> verify("main { [1..2 -> each { it * 10 }; ~] => values }")
    "missing-selector" -> verify("main { [1..2 -> each {}] => values }")
    "missing-dictionary-value" -> verify("main { {1..2 -> each { it: }} => values }")
}
