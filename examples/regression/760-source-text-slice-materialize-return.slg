import sys.file as file

# slice preserves SourceText storage, while materialize copies the selected
# bytes into the explicit Arena owner. The returned Text therefore borrows the
# Arena rather than the temporary SourceText view.
copyBytes bytes: ref [UInt8; ~], storage: mut Arena -> Text uses File {
    bytes -> file.borrowBytes => source
    source -> slice(UIntSize(0), source -> len) -> materialize(storage)
}

main {
    [UInt8(111), 119, 110, 101, 100; ~] => bytes
    Arena(0) => storage!
    bytes -> copyBytes(storage!) -> println
}
