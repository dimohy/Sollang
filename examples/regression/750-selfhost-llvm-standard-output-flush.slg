import sollang.compiler.llvm.text as llvm

# A qualified runtime flush must resolve to the declared sys.runtime intrinsic
# and emit its native wrapper, never an unresolved (-1, -1) call target.
main {
    [
    """
    import sys.runtime as runtime

    main {
        "ready" -> println
        runtime.flushStandardOutput()
    }
    """; ~
    ] => sources!
    sources! -> llvm.emit
}
