import sollang.compiler.llvm.text as llvm

main {
    [
    """
    struct Counts {
        count: Int
    }

    inspect flag: Bool -> Int uses Console {
        "abc" => value
        Counts { count: 0 } => counts!
        flag -> if {
            Int(value -> len) => counts!.count
            Counts { count: Int(value -> len) } => constructed
            "converted" -> println
        }
        0
    }

    main { true -> inspect -> println }
    """; ~
    ] => sources!
    sources! -> llvm.emit
}
