enum Leaf {
    Value(Int)
}
enum Branch {
    Value(Option<Result<Leaf, Text>>)
}
main {
    Branch.Value(Option<Result<Leaf, Text>>.Some(Result<Leaf, Text>.Ok(Leaf.Value(17)))) => branch
    branch -> when {
        Value(option) {
            option -> when {
                None { "none" -> println }
                Some(result) {
                    result -> when {
                        Err(message) { message -> println }
                        Ok(leaf) {
                            leaf -> when {
                                Value(value) { value -> println }
                            }
                        }
                    }
                }
            }
        }
    }
}
