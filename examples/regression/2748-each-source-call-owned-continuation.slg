struct Output { values: [Int; ~] }
struct Encoded { words: [UInt64; ~] }

copyWords words: ref [UInt64; ~] -> [UInt64; ~] {
    [UInt64; ~] => result!
    words -> each word { result! -> push(word) }
    result!
}

referenceEnd words: ref [UInt64; ~], start: Int -> Int {
    words[start] == 1 -> if { start + 2 + Int(words[start + 1]) } else { start + 2 }
}

restore words: ref [UInt64; ~] -> Output {
    [Int; ~] => result!
    words -> each word { result! -> push(Int(word)) }
    Output { values: result! }
}

functionCase: -> Output uses Console {
    Encoded { words: [2, 0, 0, 0, 0, 9; ~] } => encoded
    1 => cursor!
    0..<Int(encoded.words[0]) -> each {
        encoded.words -> referenceEnd(cursor!) => cursor!
    }
    encoded.words -> copyWords => copied!
    3 => copied![0]
    copied! -> restore => result
    cursor! == 5 => advanced
    advanced -> println
    result
}

main {
    Encoded { words: [2, 0, 0, 0, 0, 9; ~] } => encoded
    1 => cursor!
    0..<Int(encoded.words[0]) -> each {
        encoded.words -> referenceEnd(cursor!) => cursor!
    }
    encoded.words -> copyWords => copied!
    3 => copied![0]
    copied! -> restore => result
    cursor! == 5 => advanced
    advanced -> println
    result.values -> len -> println
    functionCase() => functionResult
    functionResult.values -> len -> println
}
