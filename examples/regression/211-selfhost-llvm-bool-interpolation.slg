import sollang.compiler.llvm.text as llvm

main {
    [
        """
        show flag: Bool -> Unit uses Console {
            "flag=$(flag), not=$(not flag), repeated=$(flag)" -> println
        }

        evaluate value: Int -> Unit uses Console {
            value > 0 => positive
            "positive=$(positive), literal=$(false), compare=$(value <= 10), logic=$(positive and not false)" -> println
        }

        main {
            show(true)
            evaluate(7)
            3 > 9 => larger
            "main=$(larger), equality=$(4 == 4), bool-literal=$(true), logic=$(true or false)" -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
