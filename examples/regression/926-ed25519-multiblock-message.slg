import sys.crypto.ed25519

seed: -> [UInt8] => [
    157, 97, 177, 157, 239, 253, 90, 96, 186, 132, 74, 244, 146, 236, 44, 196,
    68, 73, 197, 105, 123, 50, 105, 25, 112, 59, 172, 3, 28, 174, 127, 96]

publicKey: -> [UInt8] => [
    215, 90, 152, 1, 130, 177, 10, 183, 213, 75, 254, 211, 201, 100, 7, 58,
    14, 225, 114, 243, 218, 166, 35, 37, 175, 2, 26, 104, 247, 7, 81, 26]

message: -> [UInt8] => [
    48, 129, 203, 160, 3, 2, 1, 2, 2, 1, 1, 48, 5, 6, 3, 43, 101, 112,
    48, 23, 49, 21, 48, 19, 6, 3, 85, 4, 3, 12, 12, 115, 111, 108, 108, 97, 110, 103, 45, 112, 101, 101, 114,
    48, 30, 23, 13, 50, 48, 48, 49, 48, 49, 48, 48, 48, 48, 48, 48, 90, 23, 13, 52, 57, 49, 50, 51, 49, 50, 51, 53, 57, 53, 57, 90,
    48, 23, 49, 21, 48, 19, 6, 3, 85, 4, 3, 12, 12, 115, 111, 108, 108, 97, 110, 103, 45, 112, 101, 101, 114,
    48, 42, 48, 5, 6, 3, 43, 101, 112, 3, 33, 0,
    215, 90, 152, 1, 130, 177, 10, 183, 213, 75, 254, 211, 201, 100, 7, 58,
    14, 225, 114, 243, 218, 166, 35, 37, 175, 2, 26, 104, 247, 7, 81, 26,
    163, 60, 48, 58, 48, 23, 6, 3, 85, 29, 17, 4, 16, 48, 14, 130, 12, 115, 111, 108, 108, 97, 110, 103, 45, 112, 101, 101, 114,
    48, 15, 6, 3, 85, 29, 19, 1, 1, 255, 4, 5, 48, 3, 1, 1, 255,
    48, 14, 6, 3, 85, 29, 15, 1, 1, 255, 4, 4, 3, 2, 2, 132]

expectedSignature: -> [UInt8] => [
    110, 33, 13, 153, 8, 123, 160, 151, 55, 52, 78, 52, 135, 39, 248, 22,
    132, 173, 250, 1, 15, 117, 195, 141, 67, 177, 129, 224, 179, 146, 149, 58,
    222, 255, 82, 238, 236, 130, 251, 41, 128, 112, 137, 79, 92, 79, 126, 236,
    60, 255, 198, 163, 30, 140, 176, 78, 87, 67, 249, 58, 182, 121, 106, 7]

same left: [UInt8], right: [UInt8] -> Bool {
    (left -> len) == (right -> len) -> unless { false -> return }
    true => equal!
    0 => index!
    index! < (left -> len) -> while {
        left[index!] == right[index!] -> unless { false => equal! }
        index! + 1 => index!
    }
    equal!
}

main {
    ed25519.sign(seed(), message()) -> when {
        Ok(signature) {
            ed25519.verify(publicKey(), message(), expectedSignature()) -> when {
                Ok(verified) {
                    signature -> same(expectedSignature()) => signed
                    signed -> if { "true" } else { "false" } => signedText
                    verified -> if { "true" } else { "false" } => verifiedText
                    "ed25519-multiblock=$signedText,$verifiedText" -> println
                }
                Err(error) { "ed25519-multiblock=false,false" -> println }
            }
        }
        Err(error) { "ed25519-multiblock=false,false" -> println }
    }
}
