struct Payload { values: [Int; ~] }
enum Owner {
    Empty
    Value(Result<Payload, Text>)
}
one: -> Owner {
    Owner.Value(Result<Payload, Text>.Ok(Payload { values: [17; ~] }))
}
impl Owner {
    first: self -> Int {
        self -> when {
            Empty { 0 }
            Value(result) {
                result -> when {
                    Err(message) { 0 }
                    Ok(payload) { payload.values[0] }
                }
            }
        }
    }
}
main { one() -> first -> println }
