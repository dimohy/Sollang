import sollang.compiler.llvm.text as llvm

# A final mutable aggregate read must be loaded even when the scheduler
# suppresses its ordinary name expression after a control-flow barrier.
main {
    [
        """
        struct Cursor {
            index: Int
            status: Int
        }

        step input: Cursor -> Cursor {
            Cursor { index: input.index, status: input.status }
        }

        copyBytes source: [UInt8; ~] -> [UInt8; ~] {
            [UInt8; ~] => copied!
            0 => index!
            index! < (source -> len) -> while {
                copied! -> push(source[index!])
                index! + 1 => index!
            }
            copied!
        }

        advance input: Cursor -> Cursor {
            input => next!
            next! -> step => next!
            next!.status == 0 -> if {
                1 => next!.status
            }
            next! -> step => next!
            next!
        }

        main { }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
