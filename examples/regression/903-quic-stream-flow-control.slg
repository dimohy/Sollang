import std.net.quic.error as errors
import std.net.quic.stream_state as streams

verify: -> Result<Bool, errors.Error> uses Console {
    UInt64(0) -> streams.validatePeerOpened(true, 1, 1)? => bidirectional
    UInt64(2) -> streams.validatePeerOpened(true, 1, 1)? => unidirectional
    UInt64(4) -> streams.validatePeerOpened(true, 1, 1) -> when {
        Ok(opened) { "missing-limit-error" -> println }
        Err(error) { "$(bidirectional.sequence),$(unidirectional.id),$(error.code)" -> println }
    }
    UInt64(1) -> streams.validatePeerOpened(true, 1, 1) -> when {
        Ok(opened) { "missing-state-error" -> println }
        Err(error) { "$(error.code)" -> println }
    }

    UInt64(4_611_686_018_427_387_903) -> streams.validatePeerOpened(
    false,
    1_152_921_504_606_846_976,
    1_152_921_504_606_846_976)? => finalIdentity
    UInt64(4_611_686_018_427_387_904) -> streams.validatePeerOpened(
    false,
    1_152_921_504_606_846_976,
    1_152_921_504_606_846_976) -> when {
        Ok(opened) { "missing-stream-id-limit" -> println }
        Err(error) { "$(finalIdentity.sequence),$(error.code)" -> println }
    }
    UInt64(0) -> streams.validatePeerOpened(
    true,
    1_152_921_504_606_846_977,
    1) -> when {
        Ok(opened) { "missing-stream-count-limit" -> println }
        Err(error) { "$(error.code)" -> println }
    }

    streams.initialReceiveFlow(100) -> onReceive(10, 20, false)? => received
    received -> onReceive(30, 10, true)? => finished
    finished -> onConsumed(25)? => consumed
    finished -> onReceive(40, 1, false) -> when {
        Ok(state) { "missing-final-size-error" -> println }
        Err(error) { "$(finished.highestReceived),$(finished.finalSize),$(consumed.consumed),$(error.code)" -> println }
    }
    streams.initialReceiveFlow(4_611_686_018_427_387_903)
        -> onReceive(4_611_686_018_427_387_903, 1, false) -> when {
            Ok(state) { "missing-offset-limit" -> println }
            Err(error) { "$(error.code)" -> println }
        }

    streams.initialSendFlow(50) -> reserveSend(30, false)? => firstSend
    firstSend -> reserveSend(20, true)? => finalSend
    finalSend -> reserveSend(0, false) -> when {
        Ok(state) { "missing-closed-send-error" -> println }
        Err(error) { "$(finalSend.sent),$(finalSend.finalSize),$(error.code)" -> println }
    }
    streams.initialSendFlow(4_611_686_018_427_387_903)
        -> reserveSend(4_611_686_018_427_387_904, false) -> when {
            Ok(state) { "missing-send-offset-limit" -> println }
            Err(error) { "$(error.code)" -> println }
        }

    streams.initialConnectionFlow(100, 80) -> onReceive(60)? => connectionReceived
    connectionReceived -> reserveSend(70)? => connectionSent
    "$(connectionSent.received),$(connectionSent.sent)" -> println
    Result<Bool, errors.Error>.Ok(true)
}

main {
    verify() -> when {
        Ok(done) {}
        Err(error) { "unexpected=$(error.code)" -> println }
    }
}
