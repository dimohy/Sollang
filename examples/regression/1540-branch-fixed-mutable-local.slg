make value: UInt8 -> [UInt8; 1] { [value] }

read selected: Bool -> Int {
    selected -> if {
        UInt8(13) -> make => bytes!
        14 => bytes![0]
        bytes!
    } else {
        UInt8(17) -> make => bytes!
        18 => bytes![0]
        bytes!
    } => bytes
    Int(bytes[0])
}

main {
    true -> read -> println
    false -> read -> println
}
