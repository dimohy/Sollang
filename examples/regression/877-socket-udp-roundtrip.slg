import sys.io
import std.net.socket as socket
import std.net as net

# UDP uses the same flat Result propagation contract as TCP.
# An unused std.net.quic declaration must not make this program load its adapter.
runDatagram serverEndpoint: net.Endpoint -> Result<socket.Datagram, socket.SocketError> uses Network {
    socket.DatagramBindOptions { endpoint: serverEndpoint, reuseAddress: true } -> bind? => server
    net.loopback(43177) -> unified => clientEndpoint
    socket.DatagramBindOptions { endpoint: clientEndpoint, reuseAddress: true } -> bind? => client
    [UInt8(112), 105, 110, 103; ~] => ping
    client -> sendTo(serverEndpoint, ping)? => sent
    server -> receiveFrom(16)
}

main {
    net.loopback(43176) -> unified => serverEndpoint
    serverEndpoint -> runDatagram -> when {
        Ok(datagram) {
            UInt32(datagram.source -> port) => sourcePort
            datagram.bytes -> len => count
            UInt32(datagram.bytes[0]) => first
            UInt32(datagram.bytes[3]) => last
            "udp=$sourcePort,$count,$first,$last" -> println
        }
        Err(error) { "udp-error=$(error.code)" -> println }
    }
}
