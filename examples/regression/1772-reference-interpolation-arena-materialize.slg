# Arena materialization reads the value behind a readonly reference in both
# interpolation spellings before constructing the Arena-backed Text view.
struct Pair {
    first: Int
}

first pair: ref Pair -> ref Int {
    pair.first
}

main {
    Pair { first: 41 } => pair
    pair -> first => borrowed
    Arena(0) => storage!

    "expression=$(borrowed)" -> materialize(storage!) => expression
    expression -> println

    "name=$borrowed" -> materialize(storage!) => name
    name -> println
}
