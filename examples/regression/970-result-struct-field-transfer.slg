struct Packet {
    source: [UInt8; ~]
    bytes: [UInt8; ~]
}

payload: -> Result<[UInt8; ~], UInt8> {
    Packet {
        source: [9, 8; ~]
        bytes: [3, 5, 8; ~]
    } => packet
    Result<[UInt8; ~], UInt8>.Ok(packet.bytes)
}

main {
    payload() -> when {
        Ok(bytes) { "result-struct-field=$(bytes -> len),$(bytes[2])" -> println }
        Err(error) { "result-struct-field-error=$error" -> println }
    }
}
