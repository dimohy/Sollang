# Nested UIntSize fields keep their type in mapped index interpolation.
struct Inner { value: UIntSize }
struct Outer { inner: Inner }

readMap: -> MappedBytes uses File {
    map read "data.bin" => data
    data
}

main {
    Outer { inner: Inner { value: 1 } } => offset
    readMap() => data
    "byte=$(data[offset.inner.value])" -> println
}
