struct Record {
    left: Int
    right: Int
}

# Assigning a readonly struct-reference parameter into an array copies the
# already materialized value instead of loading it again as a pointer.
replaceRecord records: mut [Record; ~], index: Int, replacement: ref Record -> Unit {
    replacement => records[index]
}

main {
    [Record { left: 1, right: 2 }; ~] => records!
    Record { left: 40, right: 2 } => replacement
    records! -> replaceRecord(0, replacement)
    records![0] => result
    "ref-struct-array=$(result.left + result.right)" -> println
}
