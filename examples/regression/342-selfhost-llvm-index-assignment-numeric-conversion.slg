import sollang.compiler.llvm.text as llvm

main {
    [
        """
        readFirst values: [Int; ~] -> Int { values[0] }

        main {
            [1, 2; ~] => values!
            UIntSize(9) => wide
            Int(wide) => values![0]
            values! -> readFirst -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
