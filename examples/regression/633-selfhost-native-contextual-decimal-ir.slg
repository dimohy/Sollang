import sollang.compiler.ir.typed as typedIr

main {
    [
        """
        native fixture from "native_fixture" {
            scale value: Float64, factor: Float64 -> Float64 as "native_scale"
        }

        main {
            fixture.scale(1.5, 4)
        }
        """; ~
    ] => sources
    sources -> typedIr.lower => ir
    0 => nodeIndex!
    nodeIndex! < (ir -> len) -> while {
        ir[nodeIndex!] => node
        (node.kind == 0 or node.kind == 3 or node.kind == 6 or node.kind == 7) -> if {
            "contextual decimal IR = $(nodeIndex!),$(node.kind),$(node.typeKind),$(node.typeId),$(node.typeOrigin),$(node.typeSymbol),$(node.operand0),$(node.operand1),$(node.nextOperand)" -> println
        }
        nodeIndex! + 1 => nodeIndex!
    }
}
