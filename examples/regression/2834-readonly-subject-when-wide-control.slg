struct Values {
    signed: Long
    unsigned: UInt64
}

selectSigned value: ref Long -> Int {
    value -> when {
        -5..-1 => 7
        else => 9
    }
}

selectUnsigned value: ref UInt64 -> Int {
    value -> when {
        >= 9223372036854775808 => 8
        else => 6
    }
}

main {
    Values { signed: -3, unsigned: 18446744073709551615 } => values
    values.signed -> selectSigned -> println
    values.unsigned -> selectUnsigned -> println
}
