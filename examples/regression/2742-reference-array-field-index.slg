struct IntView { values: ref [Int; ~] }
struct WordView { values: ref [UInt64; ~] }

borrow<T> values: ref [T; ~] -> ref [T; ~] => values
intAt view: IntView -> Int => view.values[1]
wordAt view: WordView -> UInt64 => view.values[1]

main {
    [1, 2; ~] => numbers
    [UInt64(3), 4; ~] => words
    IntView { values: numbers -> borrow } -> intAt -> println
    WordView { values: words -> borrow } -> wordAt -> println
}
