shift value: Int, delta: Int -> Int => value + delta
makeDelta seed: Int -> Int => seed + 3

run values: [Int; ~], delta: Int -> [Int; ~] {
    values -> parallel value {
        value -> shift(delta + 1)
    } => mapped
    mapped
}

main {
    [1, 2; ~] -> run(4) => ordinary
    "$(ordinary[0]),$(ordinary[1])" -> println

    [1, 2; ~] -> parallel value {
        value -> shift(makeDelta(4))
    } => direct
    "$(direct[0]),$(direct[1])" -> println

    false -> if {
        0 -> println
    } else {
        [5; ~] -> parallel value {
            value -> shift(2 + 3)
        } => nested
        nested[0] -> println
    }
}
