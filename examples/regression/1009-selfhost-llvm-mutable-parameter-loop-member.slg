import sollang.compiler.llvm.text as llvm

main {
    [
        """
        struct Pending {
            bytes: [UInt8; ~]
        }

        drain pending: mut Pending -> Int {
            0 => sum!
            (pending.bytes -> len) > 0 -> while {
                pending.bytes -> take(0) => value
                sum! + Int(value) => sum!
            }
            sum!
        }

        main {
            Pending { bytes: [1, 2, 3] } => pending!
            pending! -> drain => sum
            sum -> println
            pending!.bytes -> len -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
