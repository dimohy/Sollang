import sys.quic.application_engine as application

secret: -> [UInt8; 32] => [68; 32]

main {
    application.create(secret()) => state!
    state! -> application.update
    (state!.phase and state!.secret[0] != 68) -> if {
        "key-state=ok" -> println
    } else {
        "key-state=failed" -> println
    }
}
