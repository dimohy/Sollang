import std.net.quic.application_engine as application
import std.net.quic.keys

secret: -> [UInt8; 32] => [68; 32]

main {
    application.create(keys.version1(), secret()) => state!
    state! -> update
    state!.phase and state!.secret[0] != 68 -> if {
        "key-state=ok" -> println
    } else {
        "key-state=failed" -> println
    }
}
