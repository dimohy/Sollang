import sys.directory as directory
import sys.path as path

# readRawSnapshot copies a fresh intrinsic enum payload through a readonly
# reference. The original payload must be dropped after copying it.
main {
    path.fromText(".", path.nativeStyle()) => location
    directory.readRawSnapshot(location) => snapshot
    (snapshot.bytes -> len) > 0 => populated
    "directory-snapshot=$populated" -> println
}
