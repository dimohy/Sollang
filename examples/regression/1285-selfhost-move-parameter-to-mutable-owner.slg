struct Owner {
    values: [Int; ~]
}

impl Owner {
    valueCount: mut self -> Int {
        self.values -> len
    }

    consume: move self -> Int {
        self => owner!
        owner! -> valueCount => count
        count == 3 -> if { count -> return }
        0
    }
}

main {
    Owner { values: [3, 5, 8; ~] } -> consume => count
    "move-parameter=$(count == 3)" -> println
}
