struct Holder {
    values: [UInt64; 2]
}

makeValues: -> [UInt64; 2] => [1, 2]

replace destination: mut [UInt64; 2], source: [UInt64] -> Unit {
    0 => index!
    index! < 2 -> while {
        source[index!] => destination[index!]
        index! + 1 => index!
    }
}

exercise destination: mut Holder -> UInt64 {
    makeValues() => output!
    output! -> replace([9, 8])
    output![0] + output![1]
}

main {
    Holder { values: [3, 4] } => holder!
    holder! -> exercise => result
    "inline-shadow=$result,$(holder!.values[0]),$(holder!.values[1])" -> println
}
