enum Mode {
    First
    Second
}

struct Owner {
    bytes: [UInt8; ~]
}

consume owner: move Owner -> Result<Int, Int> {
    Result<Int, Int>.Ok(owner.bytes -> len)
}

impl Owner {
    forward: move self, mode: Mode -> Result<Int, Int> {
        mode -> when {
            First { self -> consume -> return }
            Second { self -> consume -> return }
        }
        Result<Int, Int>.Err(1)
    }
}

main {
    Owner { bytes: [1, 2, 3; ~] } -> forward(Mode.First) -> when {
        Err(_) { "direct-consuming-call-return=false" -> println }
        Ok(count) { "direct-consuming-call-return=$(count == 3)" -> println }
    }
}
