main {
    -1 => first!
    -1 => second!
    UIntSize(0) => firstStart!
    UIntSize(0) => secondStart!
    7 => child
    UIntSize(11) => childStart

    first! < 0 or childStart > firstStart!
        -> if {
            first! => second!
            firstStart! => secondStart!
            child => first!
            childStart => firstStart!
            firstStart!
        } else {
            childStart < firstStart!
                -> if {
                    first! => second!
                    firstStart! => secondStart!
                    child => first!
                    childStart => firstStart!
                    firstStart!
                } else {
                    second! < 0 or childStart < secondStart!
                        -> if {
                            child => second!
                            childStart => secondStart!
                            secondStart!
                        } else { firstStart! }
                }
        } => selectedStart

    "first=$(first!),second=$(second!),starts=$(firstStart!):$(secondStart!),selected=$(selectedStart)" -> println
}
