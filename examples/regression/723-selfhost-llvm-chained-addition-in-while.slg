import sollang.compiler.llvm.text as llvm

# Every nested `+` in a parenthesized chain must become an LLVM add, including
# additions inside a while body.
main {
    [
        """
        combine first: UInt64, second: UInt64, third: UInt64 -> UInt64 {
            UInt64(0) => result!
            0 => bit!
            bit! < 1 -> while {
                ((first % 2) + (second % 2) + (third % 2)) % 2 => value
                result! + value => result!
                bit! + 1 => bit!
            }
            result!
        }

        main {
            UInt64(1) -> combine(1, 1) -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
