import sollang.compiler.llvm.text as llvm

# Every nested `+` in a parenthesized chain must become an LLVM add, including
# additions inside a while body.
main {
    [
        """
        combine first: UInt64, second: UInt64, third: UInt64 -> UInt64 {
            UInt64(0) => result!
            0 => bit!
            bit! < 1 -> while {
                ((first % UInt64(2)) + (second % UInt64(2)) + (third % UInt64(2))) % UInt64(2) => value
                result! + value => result!
                bit! + 1 => bit!
            }
            result!
        }

        main {
            UInt64(1) -> combine(UInt64(1), UInt64(1)) -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
