import sollang.compiler.llvm.text as llvm

# Each explicit parallel arm retains its own left-to-right stage order and
# publishes only the arm's final value into the labeled product.
main {
    [
        """
        add value: Int, amount: Int -> Int => value + amount
        double value: Int -> Int => value * 2
        isEven value: Int -> Bool => value % 2 == 0
        main {
            5 -> parallel branch {
                number: ref -> add(3) -> double
                flag: ref -> add(1) -> isEven
            } => results
            results.number -> println
            results.flag -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
