import probe.copy_model as model

increment value: Int -> Int => value + 1

seal nodes: mut [model.Box; ~] -> Unit uses Console {
    0 => index!
    index! < (nodes -> len) -> while {
        nodes[index!] => item!
        item!.value >= 0 -> if {
            item!.value -> increment => item!.value
            item! => nodes[index!]
            item!.value -> println
        }
        index! + 1 => index!
    }
}

main {
    [model.Box; ~] => nodes!
    nodes! -> push(model.Box { value: 1 })
    nodes! -> seal
}
