import sys.io
import std.net.quic as quic

struct Roundtrip {
    streamCount: Int
    streamFirst: UInt8
    streamLast: UInt8
    streamFinished: Bool
    datagramCount: Int
}

ping: -> [UInt8] => [112, 105, 110, 103]

runQuic version: UInt32 -> Result<Roundtrip, quic.QuicError> uses Network, Random, Clock {
    quic.generateIdentity()? => identityB
    identityB -> certificate? => certificateB

    quic.loopback(0) => localA
    quic.loopback(0) => localB
    quic.bind(localA)? => endpointA!
    quic.bind(localB)? => endpointB!
    endpointB! -> listen(identityB)? => listener!

    quic.loopback(endpointB! -> localPort) => peerB
    endpointA! -> connectVersion(peerB, certificateB, version)? => connectionA!
    listener! -> accept(endpointB!)? => connectionB!
    listener! -> close(endpointB!)
    connectionA! -> localEndpoint => localAActual
    connectionA! -> remoteEndpoint => remoteBActual
    connectionB! -> localEndpoint => localBActual
    connectionB! -> remoteEndpoint => remoteAActual

    connectionA! -> openBi(endpointA!)? => channelA!
    ping() => pingBytes
    channelA! -> send(connectionA!, endpointA!, pingBytes)? => sent
    channelA! -> finish(connectionA!, endpointA!)?
    connectionB! -> acceptBi(endpointB!)? => channelB!
    channelB! -> receive(connectionB!, endpointB!, 16)? => received
    channelB! -> receive(connectionB!, endpointB!, 16)? => endOfStream
    channelB! -> receive(connectionB!, endpointB!, 16)? => repeatedEndOfStream

    connectionA! -> sendDatagram(endpointA!, pingBytes)?
    connectionB! -> receiveDatagram(endpointB!)? => datagram
    channelA! -> id => streamIdA
    channelB! -> id => streamIdB
    channelA! -> isWriteFinished => writeFinished
    channelB! -> isReadFinished => readFinished
    writeFinished
        and readFinished
        and streamIdA == streamIdB
        and (localAActual -> port) > 0
        and (localBActual -> port) > 0
        and (remoteAActual -> port) == (localAActual -> port)
        and (remoteBActual -> port) == (localBActual -> port)
        and (endOfStream -> len) == 0
        and (repeatedEndOfStream -> len) == 0 => streamFinished
    connectionA! -> close(endpointA!, 0)?
    connectionB! -> close(endpointB!, 0)?
    endpointA! -> close
    endpointB! -> close

    Result<Roundtrip, quic.QuicError>.Ok(Roundtrip {
        streamCount: received -> len
        streamFirst: received[0]
        streamLast: received[3]
        streamFinished: streamFinished
        datagramCount: datagram -> len
    })
}

runVersion version: UInt32 -> Unit uses Network, Random, Clock, Console {
    runQuic(version) -> when {
        Ok(value) {
            value.streamFinished -> if { "true" } else { "false" } => finishedText
            "quic=$version,$(value.streamCount),$(value.streamFirst),$(value.streamLast),$finishedText,$(value.datagramCount)" -> println
        }
        Err(error) { "quic-error=$version,$(error.code)" -> println }
    }
}

main {
    quic.version1() -> runVersion
    quic.version2() -> runVersion
}
