# Associated substitutions recurse through intrinsic generic result storage.
trait Producer {
    type Failure
    make: self -> Result<Int, Failure>
}

struct Value { }

impl Producer for Value {
    type Failure = Text

    make: self -> Result<Int, Text> {
        Result<Int, Text>.Ok(1)
    }
}

main {
    Value { } -> Producer.make -> when {
        Ok(value) { value -> println }
        Err(error) { error -> println }
    }
}
