import std.net.quic.error as errors
import std.net.quic.loss_recovery as recovery

boolText value: Bool -> Text => value -> if { "true" } else { "false" }

verify: -> Result<Bool, errors.Error> uses Console {
    recovery.initialRttState() -> update(100_000, 0, 25_000, false) => first
    first -> update(120_000, 10_000, 25_000, true) => second
    second -> probeTimeout(25_000, true, 2)? => timeout
    second -> timeThresholdDelay => thresholdDelay
    recovery.lostByPacketThreshold(10, 7) => packetLost
    second -> lostByTimeThreshold(1_135_000, 1_000_000) => timeLost
    packetLost -> boolText => packetLostText
    timeLost -> boolText => timeLostText
    "$(first.smoothed),$(second.latest),$(second.minimum),$(second.smoothed),$(second.variance)" -> println
    "$thresholdDelay,$timeout,$packetLostText,$timeLostText" -> println

    recovery.initialCongestionState(1_200) => initial
    initial -> onPacketSent(3_000, true) => sent
    sent -> onPacketsAcknowledged(1_200, 100, 1_200, true) => acknowledged
    acknowledged -> onPacketsLost(1_200, 200, 250, 1_200) => lost
    lost -> onPacketsAcknowledged(600, 150, 1_200, true) => recoveryAck
    recoveryAck -> onPacketSent(1_200, false) => ackOnly
    ackOnly -> onPersistentCongestion(1_200) => persistent
    "$(initial.congestionWindow),$(sent.bytesInFlight),$(acknowledged.congestionWindow),$(acknowledged.bytesInFlight),$(lost.congestionWindow),$(lost.bytesInFlight),$(recoveryAck.congestionWindow),$(ackOnly.bytesInFlight),$(persistent.congestionWindow)" -> println
    Result<Bool, errors.Error>.Ok(true)
}

main {
    verify() -> when {
        Ok(done) {}
        Err(error) { "error=$(error.code)" -> println }
    }
}
