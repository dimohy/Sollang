import sollang.compiler.llvm.text as llvm

main {
    [
        """
        import regression.third_argument as target

        main {
            target.total(2, 3, []) -> println
        }
        """,
        """
        namespace regression.third_argument

        public total first: Int, second: Int, values: [Int; ~] -> Int {
            first + second + (values -> len)
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
