increment item: Int -> Int { item + 1 }

selected code: Int, replacement: Int -> Int {
    -1 => left!
    replacement => left!
    -1 => right!
    replacement + 4 => right!
    code == 1 -> if { left! } else { right! } => operandAst
    operandAst -> increment
}

nested code: Int, replacement: Int -> Int {
    0 => result!
    code > 0 -> if {
        -1 => left!
        replacement => left!
        -1 => right!
        replacement + 4 => right!
        code == 1 -> if { left! } else { right! } => operandAst
        operandAst -> increment => result!
    }
    result!
}

main {
    1 -> selected(4) -> println
    2 -> selected(4) -> println
    1 -> nested(4) -> println
    2 -> nested(4) -> println
}
