# Verifies that workingDirectory configures only the child Command instance.
import sys.file as file
import sys.process as process

main {
    process.arguments() => arguments
    arguments -> len => count
    count > 1 -> if {
        file.openRead("Alpha.txt") -> when {
            Result<file.File, Text>.Ok(opened) { "cwd=true" -> println }
            Result<file.File, Text>.Err(error) { "cwd=false" -> println }
        }
    } else {
        process.command(arguments[0]) => command!
        command! -> workingDirectory("examples/regression/fixtures/425-directory-order")
        command! -> arg("--child")
        command! -> status -> when {
            Result<process.ExitStatus, Text>.Ok(status) { "status=$(status -> exitCode)" -> println }
            Result<process.ExitStatus, Text>.Err(error) { "process=$error" -> println }
        }
    }
}
