import std.net.http as http

main {
    http.limits(256, 128, 8, 32, 128) -> when {
        Ok(limits) => http.parser(limits) -> when {
            Ok(headParser) => headParser -> parseRequest("GET / HTTP/1.1\r\nHost: example.test\r\n\r\n") -> when {
                Ok(request) { "parsed=$(request -> fieldCount)" -> println }
                Err(error) { "parse error @$(error.offset)" -> println }
            }
            Err(error) { "parser error @$(error.offset)" -> println }
        }
        Err(error) { "limits error @$(error.offset)" -> println }
    }
}
