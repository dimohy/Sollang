import sollang.compiler.llvm.text as llvm

# Partition pulls one producer once, evaluates routes in source order, and
# dispatches each item directly to exactly one terminal without route buffers.
main {
    [
        """
        import std.sequence

        makeValues values: Range -> Stream<Int> { values -> defer }

        main {
            1..6 -> makeValues
                -> partition value {
                    even: when value % 2 == 0
                    large: when value >= 3
                    other: else
                } => routed
            routed.even -> each value { value -> println }
            routed.large -> each value { value -> println }
            routed.other -> each value { value -> println }
        }
        """,
        """
        namespace std.sequence

        public defer values: Range -> Stream<Int> = intrinsic
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
