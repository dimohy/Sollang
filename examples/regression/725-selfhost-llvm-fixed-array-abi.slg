import sollang.compiler.llvm.text as llvm

# Canonical fixed-array identity must lower to the pointer/length expression ABI
# for literals, binding reads, variable indexing, and len.
main {
    [
        """
        fixedValue index: Int -> UInt64 {
            [UInt64(11), UInt64(22), UInt64(33)] => constants
            constants[index]
        }

        fixedCount seed: Int -> Int {
            [UInt64(11), UInt64(22), UInt64(33)] => constants
            constants -> len
        }

        main {
            2 -> fixedValue -> println
            0 -> fixedCount -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
