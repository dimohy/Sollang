sameText source: Text, expected: Text -> Bool {
    source == expected
}

differentText source: Text, expected: Text -> Bool {
    source != expected
}

main {
    "abc" -> sameText("abc") => same
    "abc" -> differentText("abd") => different
    "" == "" => empty
    false => nested!
    true -> if {
        "abc" == "abc" => nested!
    }
    false => loop!
    0 => index!
    index! < 1 -> while {
        "abc" != "ab" => loop!
        index! + 1 => index!
    }
    "same=$(same),different=$(different),empty=$(empty),nested=$(nested!),loop=$(loop!)" -> println
}
