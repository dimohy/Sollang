double value: Int -> Int {
    value * 2
}

# An unreachable parallel body must not create a native callback whose target
# function is omitted by the executable call-graph closure.
unusedParallel values: [Int; ~] -> [Int; ~] {
    values -> parallel value {
        value -> double
    } => doubled
    doubled
}

main {
    "reachable-only" -> println
}
