main {
    Result<[Int; ~], Text>.Ok([2, 3; ~]) -> when {
        Ok(payload) {
            payload => owner!
            owner! -> push(5)
            "fresh=$(owner! -> len):$(owner![0]),$(owner![2])" -> println
        }
        Err(error) { error -> println }
    }

    Result<[Int; ~], Text>.Ok([7; ~]) => result
    result -> when {
        Ok(payload) {
            payload => owner!
            owner! -> push(8)
            "named=$(owner! -> len):$(owner![0]),$(owner![1])" -> println
        }
        Err(error) { error -> println }
    }

    Result<Result<[Int; ~], Text>, Text>.Ok(Result<[Int; ~], Text>.Ok([10; ~])) -> when {
        Ok(parcel) {
            parcel -> when {
                Ok(payload) {
                    payload => owner!
                    owner! -> push(11)
                    "nested=$(owner! -> len):$(owner![0]),$(owner![1])" -> println
                }
                Err(error) { error -> println }
            }
        }
        Err(error) { error -> println }
    }

    Result<[Int; ~], Text>.Ok([13; ~]) => borrowed
    borrowed -> when {
        Ok(payload) { "borrow-first=$(payload -> len)" -> println }
        Err(error) { error -> println }
    }
    borrowed -> when {
        Ok(payload) { "borrow-again=$(payload -> len)" -> println }
        Err(error) { error -> println }
    }
}
