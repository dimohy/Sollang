struct Token {
    raw: Int
}

impl Token {
    byte: self, index: UIntSize -> Int => self.raw + Int(index)
    slice: self, start: UIntSize, length: UIntSize -> Int => self.raw + Int(start) + Int(length)
}

main {
    Token { raw: 7 } => token
    "byte=$(token -> byte(1)), slice=$(token -> slice(1, 2))" -> println
}
