struct Entry { words: [Int; ~] }
struct View { entries: ref [Entry; ~] }
borrowEntries values: ref [Entry; ~] -> ref [Entry; ~] => values
size entry: ref Entry -> Int => entry.words -> len
impl View {
    public count: self, index: ref Int -> Int => self.entries[index] -> size
}
struct Scalars { values: ref [Int; ~] }
borrowInts values: ref [Int; ~] -> ref [Int; ~] => values
borrowedInt value: ref Int -> Int => value
impl Scalars {
    public at: self, index: ref Int -> Int => self.values[index] -> borrowedInt
}
struct Lookup { values: ref {Int: Int} }
borrowTable values: ref {Int: Int} -> ref {Int: Int} => values
impl Lookup {
    public count: self, key: Int -> Int => self.values[key] -> borrowedInt
}

main {
    [Entry; ~] => entries!
    entries! -> push(Entry { words: [1, 2; ~] })
    entries! -> push(Entry { words: [7, 8, 9; ~] })
    View { entries: entries! -> borrowEntries } => view
    1 => index
    view -> count(index) -> println
    entries![index] -> size -> println
    [Int; ~] => values!
    values! -> push(11)
    values! -> push(42)
    Scalars { values: values! -> borrowInts } => scalars
    scalars -> at(index) -> println
    values![index] -> borrowedInt -> println
    {Int: Int; 2~} => table!
    table! -> put(7, 77)
    Lookup { values: table! -> borrowTable } => lookup
    lookup -> count(7) -> println
}
