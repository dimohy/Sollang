import sollang.compiler.llvm.text as llvm

main {
    [
        """
        struct Point {
            x: Int
        }
        readFirst values: [Int; ~] -> Int => values[0]
        arrayFirst: -> Int {
            [7, 8; ~] => values!
            values! -> push(9)
            values! -> readFirst
        }
        pointX: -> Int {
            Point { x: 9 } => point
            point.x
        }
        dictionaryValue: -> Int {
            {1: 10, 2: 20} => values
            values[2]
        }
        main { arrayFirst() + pointX() + dictionaryValue() -> println }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
