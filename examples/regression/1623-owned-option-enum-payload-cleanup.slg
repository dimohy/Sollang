struct Payload { values: [Int; ~] }
enum Owner {
    Empty
    Value(Option<Payload>)
}
one: -> Owner {
    Owner.Value(Option<Payload>.Some(Payload { values: [13; ~] }))
}
impl Owner {
    first: self -> Int {
        self -> when {
            Empty { 0 }
            Value(option) {
                option -> when {
                    None { 0 }
                    Some(payload) { payload.values[0] }
                }
            }
        }
    }
}
main { one() -> first -> println }
