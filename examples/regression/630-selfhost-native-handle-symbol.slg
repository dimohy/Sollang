import sollang.compiler.ast as ast
import sollang.compiler.lexer as lexer
import sollang.compiler.semantic.symbols as symbols

main {
    """
    native handleFixture from "handle_fixture" {
        handle Counter drop "counter_drop"
        create initial: Int32 -> handleFixture.Counter as "counter_create"
    }

    main {
    }
    """ => source
    source -> ast.lower => nodes
    source -> lexer.lex => tokens
    nodes -> symbols.collectPrepared => table
    table -> each symbol {
        (symbol.kind == 3 and symbol.flags / 65536 % 2 == 1) -> if {
            tokens[symbol.nameToken] => nameToken
            source -> slice(nameToken.span.start, nameToken.span.length) => name
            "symbol = $(symbol.kind),$(symbol.parent),$name,$(symbol.flags)" -> println
        }
    }
}
