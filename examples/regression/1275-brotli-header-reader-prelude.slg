import std.compress.brotli.compressed_header as headers
import std.compress.brotli.literal_context as contexts
import std.compress.brotli.prefix_table as prefix

# Feed one bit per caller step and require the parent HeaderReader to consume
# and replace each of its three BlockStreamReader owners in wire order.
check parser: headers.Parser -> Bool {
    prefix.WindowLimits { maxBufferedBits: 56 } -> window -> when {
        Err(_) { false }
        Ok(window) {
            window => window!
            parser -> headerReader => reader!
            prefix.Position { byteIndex: 0, bitIndex: 0 } => position!
            [UInt8(248), 5] => input
            0 => finishedBlocks!
            0 => fedBits!
            0 => attempts!
            attempts! < 32 -> while {
                reader! -> read(window!) -> when {
                    Err(_) { false -> return }
                    Ok(progress) {
                        progress -> when {
                            NeedMore(_) {
                                (window! -> available) + 1 => required
                                window! -> fill(input, position!, required) -> when {
                                    Err(_) { false -> return }
                                    Ok(next) { next => position! }
                                }
                                fedBits! + 1 => fedBits!
                            }
                            NeedBlockPrefix(_) { false -> return }
                            NeedBlockFinish(index) {
                                index == finishedBlocks! -> unless { false -> return }
                                reader! -> finishBlock -> when {
                                    Err(_) { false -> return }
                                    Ok(_) { }
                                }
                                finishedBlocks! + 1 => finishedBlocks!
                            }
                            Ready {
                                reader! -> finishPrelude -> when {
                                    Err(_) { false -> return }
                                    Ok(prelude) {
                                        prelude.contextModes[0] -> when {
                                            Utf8 { true }
                                            else { false }
                                        } => modeOk
                                        finishedBlocks! == 3
                                            and fedBits! == 11
                                            and position!.byteIndex == 1
                                            and position!.bitIndex == 3
                                            and (window! -> available) == 0
                                            and (prelude.blockStreams -> len) == 3
                                            and prelude.blockStreams[0].typeCount == 1
                                            and prelude.blockStreams[1].typeCount == 1
                                            and prelude.blockStreams[2].typeCount == 1
                                            and prelude.distancePostfixBits == 3
                                            and prelude.directDistanceCodes == 136
                                            and prelude.distanceCodeCount == 520
                                            and prelude.literalContextEntryCount == 64
                                            and modeOk => result
                                        result -> return
                                    }
                                }
                            }
                        }
                    }
                }
                attempts! + 1 => attempts!
            }
            false
        }
    }
}

main {
    headers.Limits {
        maxBlockTypes: 256
        maxBlockLength: 16_793_840
        maxContextEntries: 16_384
        maxTrees: 256
        maxTableEntries: 1_080
        maxTotalTableEntries: 276_480
    } -> parser -> when {
        Err(_) { "header-reader=false" -> println }
        Ok(parser) { "header-reader=$(parser -> check)" -> println }
    }
}
