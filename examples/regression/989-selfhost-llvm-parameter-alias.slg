import sollang.compiler.llvm.text as llvm

# An immutable local alias of a parameter must read the parameter ABI value
# directly; the parameter name intentionally has no standalone SSA producer.
main {
    [
        """
        alias value: Int -> Int {
            value => copy
            0 => index!
            index! < 1 -> while {
                copy -> println
                index! + 1 => index!
            }
            copy
        }

        main {
            41 -> alias -> println
        }
        """; ~
    ] => sources
    sources -> llvm.emit
}
