import sollang.compiler.ir.typed as typedIr
import sollang.compiler.semantic.context as semanticContext

# A Boolean binding initialized by a when result must remain a valid condition
# operand when it immediately flows into a structured if.
main {
    ["tests/Sollang.ExampleTests/Fixtures/selfhost-stage2-when-result-if-condition.slg"; ~] => sourcePaths
    sourcePaths -> semanticContext.prepareFiles => prepared
    prepared -> typedIr.lowerContext => ir
    0 => ifs!
    0 => invalid!
    0 => index!
    index! < (ir -> len) -> while {
        ir[index!] => node
        node.kind == 18 -> if {
            ifs! + 1 => ifs!
            (node.operand0 < 0 or node.operand0 >= (ir -> len))
                -> if {
                invalid! + 1 => invalid!
            }
        }
        index! + 1 => index!
    }
    "ifs=$(ifs!),invalid=$(invalid!)" -> println
}
