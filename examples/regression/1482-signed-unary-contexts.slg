minimum8: -> Int8 { -128 }
negate8 value: Int8 -> Int8 { -value }
foldedDigit value: Long, place: Long -> UInt8 { UInt8(-(value / place % 10) + 48) }
minimum16: -> Int16 { -32768 }
minimum64: -> Int64 { -9223372036854775808 }
first8 values: [Int8] -> Int8 { values[0] }
additional ignored: Int, values: [Int16] -> Int16 { values[0] }
showConditionally flag: Bool -> Unit uses Console {
    flag -> if {
        [-128; 2] -> first8 -> println
    }
}
showLoop: -> Unit uses Console {
    0 => index!
    index! < 1 -> while {
        0 -> additional([-32768; 2]) -> println
        index! + 1 => index!
    }
}
main {
    minimum8() -> println
    7 -> negate8 -> println
    -123 -> foldedDigit(100) -> println
    minimum16() -> println
    minimum64() -> println
    [-128, 127] -> first8 -> println
    0 -> additional([-32768; 2]) -> println
    true -> showConditionally
    showLoop()
    -1 -> println
}
