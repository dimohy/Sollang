struct Holder {
    values: [UInt8; 32]
}

make: -> [UInt8; 32] => [7; 32]

wrap source: [UInt8; 32], selected: Bool -> Holder {
    selected -> if {
        Holder { values: source } -> return
    }
    Holder { values: [0; 32] }
}

main {
    make() => original
    wrap(original, true) => copied
    "copied=$(copied.values[0]),original=$(original[0])" -> println
}
