# Product values keep their structural fields through flow and function boundaries.
sum pair: (Int, Int) -> Int => pair._0 + pair._1

weighted pair: (left: Int, right: Int) -> Int => pair.left * 10 + pair.right

main {
    (10, 20) -> sum => ordinary
    "$ordinary" -> println
    (left: 4, right: 2) -> weighted => labeled
    "$labeled" -> println
}
