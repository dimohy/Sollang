# A fresh nominal receiver's declared count method wins over BitSet.count.
struct Ordering { }
impl Ordering {
    count: self, values: [Int] -> Int => values -> len
}

integers count: Int -> [Int; ~] {
    [Int; ~] => values!
    0 => index!
    index! < count -> while {
        values! -> push(index! + 1)
        index! + 1 => index!
    }
    values!
}

main {
    2 -> integers => numbers
    Ordering { } -> count(numbers) -> println
}
