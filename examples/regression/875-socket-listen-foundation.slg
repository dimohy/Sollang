import sys.io
import sys.socket as socket

# Verifies numeric-address binding and deterministic affine listener cleanup.
# An unused sys.quic declaration must not make this program load its adapter.
main {
    socket.ListenOptions {
        endpoint: socket.Endpoint { address: "127.0.0.1", port: 0 }
        backlog: 8
        reuseAddress: true
    } -> socket.listen -> when {
        Ok(listener) { "listener=ready" -> println }
        Err(error) { "listener=error code=$(error.code)" -> println }
    }
}
