import sys.io
import std.net.socket as socket
import std.net as net

# Verifies numeric-address binding and deterministic affine listener cleanup.
# An unused std.net.quic declaration must not make this program load its adapter.
main {
    socket.ListenOptions {
        endpoint: net.loopback(0) -> unified
        backlog: 8
        reuseAddress: true
    } -> listen -> when {
        Ok(listener) { "listener=ready" -> println }
        Err(error) { "listener=error code=$(error.code)" -> println }
    }
}
