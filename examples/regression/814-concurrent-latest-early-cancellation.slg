# Early stop after the first latest snapshot cancels all inputs without an unbounded queue or leaked worker.
import std.sequence

makeValues values: Range -> Stream<Int> => values -> defer

asEvents left: move Stream<Int>, right: move Stream<Int> -> EventStream<Int> {
    (left, right) -> merge
}

main {
    1..100 -> makeValues => firstLeft
    1001..1100 -> makeValues => firstRight
    firstLeft -> asEvents(firstRight) => first
    2001..2100 -> makeValues => secondLeft
    3001..3100 -> makeValues => secondRight
    secondLeft -> asEvents(secondRight) => second

    0 => received!
    (first: first, second: second) -> latest => snapshots
    snapshots
        -> take(1)
        -> each snapshot {
            received! + 1 => received!
        }
    "received=$(received!)" -> println
}
