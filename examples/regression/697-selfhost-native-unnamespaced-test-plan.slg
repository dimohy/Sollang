import sollang.compiler.cli_test as cliTest
import sys.file as file

# A direct test source without a namespace still needs an importable generated
# harness and the same result/exit contract as project tests.
main {
    ["tests/Sollang.NativeTestFixtures/failure.slg"; ~] => sources
    sources -> cliTest.build(sources -> len, "") => plan
    "plan = $(plan.status),$(plan.count)" -> println
    plan.harness -> file.borrowBytes => harness
    harness -> slice(UIntSize(0), UIntSize(plan.harness -> len)) -> print
}
