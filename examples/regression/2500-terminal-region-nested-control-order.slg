import sys.io

compute limit: Int -> Int {
    0 => sum!
    0 => outer!
    outer! < limit -> while {
        0 => inner!
        inner! < 4 -> while {
            (outer! == 1 and inner! == 2) or inner! == 0 -> if {
                sum! + 5 => sum!
            } else {
                sum! + 1 => sum!
            }
            inner! + 1 => inner!
        }
        outer! + 1 => outer!
    }
    sum!
}

main {
    "nested=$(compute(3))" -> println
}
