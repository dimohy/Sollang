struct Entry { values: [Int; ~] }
struct Algorithms { }
impl Algorithms {
    swap<T>: self, values: mut [T; ~], left: Int, right: Int -> Unit {
        values[left] => previous
        values[right] => values[left]
        previous => values[right]
    }
}
main {
    [Entry { values: [11, 12; ~] }, Entry { values: [21, 22; ~] }; ~] => values!
    Algorithms { } => algorithms
    algorithms -> swap(values!, 0, 1)
    values![0].values[0] -> println
    values![1].values[0] -> println
}
