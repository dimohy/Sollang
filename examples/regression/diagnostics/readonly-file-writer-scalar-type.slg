import sys.file as file

writeBorrowed writer: ref file.FileWriter -> Result<Unit, Text> uses File {
    Int64(513) => value
    writer -> writeAt<UInt16>(value, 0)
}

main {
    file.openWrite("artifacts/example-tests/readonly-file-writer-rejected.bin") -> when {
        Ok(writer) { writer -> writeBorrowed => result }
        Err(_) {}
    }
}
