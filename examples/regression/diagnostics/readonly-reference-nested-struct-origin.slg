# A stored readonly reference keeps its owner live until the field's last use.
struct Pair {
    first: Int
    second: Int
}

struct PairView {
    value: ref Int
}

same value: ref Int -> ref Int {
    value
}

read value: ref Int -> Int {
    value
}

struct Outer {
    inner: PairView
}

main {
    Pair { first: 10, second: 20 } => pair!
    Outer { inner: PairView { value: pair!.first -> same } } => stored
    Pair { first: 30, second: 40 } => pair!
    stored.inner.value -> read => observed
}
