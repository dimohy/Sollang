struct Owner { values: [Int; ~] }
struct Pair { left: Owner, right: Owner }
impl Owner { finish: move self -> Int { self.values -> len } }
impl Pair {
    finish: self -> Int {
        self.left -> finish => leftCount
        self.right -> finish => rightCount
        leftCount + rightCount
    }
}
main { Pair { left: Owner { values: [7,; ~] }, right: Owner { values: [8,9,; ~] } } -> finish -> println }

