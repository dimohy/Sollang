# Associated items retain the declared growable array shape.
trait Counter {
    type Item
    count: self, values: [Item; ~] -> Int
}
struct IntCounter { }
impl Counter for IntCounter {
    type Item = Int
    count: self, values: [Int; 2] -> Int { values -> len }
}
main {
    [10, 20; ~] => values
    IntCounter { } -> Counter.count(values) -> println
}
