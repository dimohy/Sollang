# Fixed array storage does not make its affine elements implicitly copyable.
struct Item { values: [Int; ~] }
struct Holder { items: [Item; 1] }
store holders: mut [Holder; ~], items: [Item; 1] -> Unit {
    holders -> push(Holder { items: items })
}
main {
    [Holder; ~] => holders!
    [Item { values: [13; ~] }] => items
    holders! -> store(items)
}
