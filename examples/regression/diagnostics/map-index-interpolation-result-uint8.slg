# A propagated UInt8 result is still an invalid mapped byte index.
readMap: -> MappedBytes uses File {
    map read "data.bin" => data
    data
}

offset: -> Result<UInt8, Int> => Result<UInt8, Int>.Ok(UInt8(1))

run: -> Result<Unit, Int> uses File, Console {
    readMap() => data
    "byte=$(data[offset()?])" -> println
    Result<Unit, Int>.Ok
}

main {
    run() -> when {
        Ok(done) { }
        Err(error) { "unexpected-error=$error" -> println }
    }
}
