choose first: ref Int, second: ref Int -> ref Int {
    second
}

same value: ref Int -> ref Int {
    value
}

forward first: ref Int, second: ref Int -> ref Int {
    first -> choose(second) -> same
}

main {
    10 => first!
    20 => second!
    first! -> forward(second!) => borrowed
    30 => second!
    borrowed -> println
}
