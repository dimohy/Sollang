import sys.file as file

# Rebinding transfers the affine handle; the old name cannot be reused.
main {
    file.openRead("missing.bin") => opened
    opened -> when {
        Result<file.File, Text>.Ok(reader) {
            reader => copied
            "$(reader.token)" -> println
            "$(copied.token)" -> println
        }
        Result<file.File, Text>.Err(error) => error -> println
    }
}
