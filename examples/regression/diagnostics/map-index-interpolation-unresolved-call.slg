# An unresolved call inside a mapped index must fail before code generation.
readMap: -> MappedBytes uses File {
    map read "data.bin" => data
    data
}

run: -> Result<Unit, Int> uses File, Console {
    readMap() => data
    "byte=$(data[missingOffset()])" -> println
    Result<Unit, Int>.Ok
}

main {
    run() -> when {
        Ok(done) { }
        Err(error) { "unexpected-error=$error" -> println }
    }
}
