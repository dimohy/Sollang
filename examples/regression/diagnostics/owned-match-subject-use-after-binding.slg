main {
    Result<[Int; ~], Text>.Ok([1; ~]) => result
    result -> when {
        Ok(payload) {
            payload => owner!
            owner! -> push(2)
            owner! -> len -> println
        }
        Err(error) { error -> println }
    }
    result -> when {
        Ok(payload) { payload -> len -> println }
        Err(error) { error -> println }
    }
}
