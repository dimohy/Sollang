import sys.process as process

main {
    [1, 2; ~] => argv
    process.Command { argv: argv, workingDirectoryValue: "", hasWorkingDirectory: false, environmentChanges: [process.EnvironmentChange; ~], inheritsEnvironment: true, standardInput: process.Input.Inherit, standardOutput: process.Output.Inherit, standardError: process.Output.Inherit } => command
    command -> run => status
}
