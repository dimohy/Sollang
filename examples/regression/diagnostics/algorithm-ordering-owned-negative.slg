import std.algorithm as algorithm

struct Entry { values: [Int; ~] }
struct EntryComparison { }
impl algorithm.Comparison for EntryComparison {
    type Item = Entry
    public compare: self, left: ref Entry, right: ref Entry -> Int {
        left.values[0] < right.values[0] -> if { -1 } else { 1 }
    }
}
main {
    [Entry { values: [2; ~] }, Entry { values: [1; ~] }; ~] => values!
    algorithm.Ordering { direction: algorithm.Direction.Ascending } => ordering
    ordering -> sort(values!, EntryComparison { })
}
