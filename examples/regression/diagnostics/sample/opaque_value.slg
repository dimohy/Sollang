namespace sample.opaque_value

public struct Token {
    raw: UInt64
}

public struct Point {
    public x: UInt64
}

public struct Inner {
    secret: UInt64
}

public struct Wrapper {
    public inner: Inner
}

public token value: UInt64 -> Token => Token { raw: value }

public wrapped value: UInt64 -> Wrapper {
    Wrapper { inner: Inner { secret: value } }
}

impl Token {
    public value: self -> UInt64 => self.raw
}
