struct Owner { values: [Int; ~] }
struct Inner { left: Owner }
struct Outer { inner: Inner }

consume first: move Owner, scale: Int, second: move Owner -> Int {
    (first.values -> len) + scale + (second.values -> len)
}

main {
    Owner { values: [1; ~] } => first
    Outer { inner: Inner { left: Owner { values: [2; ~] } } } => outer
    first -> consume(3, outer.inner.left) -> println
}
