struct Owner { values: [Int; ~] }
struct Inner { left: Owner, right: Owner }
struct Outer { inner: Inner }

impl Owner {
    finish: move self -> Int => self.values -> len
}

impl Outer {
    finish: move self -> Int {
        true -> if {
            self.inner.left -> finish => leftCount
        } else {
            self.inner.left -> finish => leftCount
        }
        self.inner.right -> finish
    }
}

main {
    Outer { inner: Inner { left: Owner { values: [7; ~] }, right: Owner { values: [8, 9; ~] } } }
        -> finish -> println
}
