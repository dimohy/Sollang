import std.text.csv as csv

forge: -> Result<Unit, csv.Error> {
    csv.standard() -> writer(csv.WriterLimits {
        maxOutputBytes: 64
        maxRecords: 2
        maxFieldsPerRecord: 2
        maxFieldBytes: 16
    })? => writer!
    0 => writer!.encodedBytes
    Result<Unit, csv.Error>.Ok
}

main {
    forge() -> when {
        Ok(_) { "unexpected-forged" -> println }
        Err(error) { error.offset -> println }
    }
}
