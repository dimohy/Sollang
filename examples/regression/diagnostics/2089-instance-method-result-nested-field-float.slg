struct Inner {
    public value: Float32
}

struct Outer {
    public inner: Inner
}

struct Maker {
    value: Outer
}

impl Maker {
    make: self -> Outer => self.value
}

main {
    Maker { value: Outer { inner: Inner { value: Float32(1.5) } } } => maker
    "value=$((maker -> make).inner.value)" -> println
}
