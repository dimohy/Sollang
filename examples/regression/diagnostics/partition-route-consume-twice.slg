# A partition route cannot be attached to two downstream consumers.
import std.sequence

makeValues values: Range -> Stream<Int> => values -> defer

main {
    1..3 -> makeValues => values
    values -> partition value {
        even: when value % 2 == 0
        other: else
    } => routed
    routed.even -> each value {
        "$value" -> println
    }
    routed.even -> each value {
        "$value" -> println
    }
    routed.other -> each value {
        "$value" -> println
    }
}
