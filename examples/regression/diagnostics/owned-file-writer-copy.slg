import sys.file as file

# Rebinding transfers the affine writer; the old name cannot be reused.
main {
    file.openWrite("artifacts/example-tests/owned-writer-copy.bin") => opened
    opened -> when {
        Result<file.FileWriter, Text>.Ok(writer) {
            writer => copied
            "$(writer.token)" -> println
            "$(copied.token)" -> println
        }
        Result<file.FileWriter, Text>.Err(error) => error -> println
    }
}
