# A branch move arm consumes the named affine source for the enclosing scope.
consume values: move [Int; ~] -> Int => values -> len
inspect values: ref [Int; ~] -> Int => values -> len

main {
    [1, 2; ~] => values!
    values! -> branch {
        observed: ref -> inspect
        consumed: move -> consume
    } => result
    values! -> len => invalid
}
