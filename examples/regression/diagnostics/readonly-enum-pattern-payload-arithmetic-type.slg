struct Cell { number: Int }
enum Packet {
    Empty
    Some(Cell)
}
read value: ref Packet -> Int {
    value -> when {
        Empty { 0 }
        Some(cell) { cell.number + false }
    }
}
main {
    Packet.Some(Cell { number: 41 }) => packet
    packet -> read -> println
    packet -> read -> println
    Packet.Empty => empty
    empty -> read -> println
}
