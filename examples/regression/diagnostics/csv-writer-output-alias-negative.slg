import std.text.csv as csv
import sys.file as file

alias: -> Result<Unit, csv.Error> {
    [UInt8; ~] => output!
    output! -> push(97)
    output! -> push(44)
    output! -> push(98)
    0..<5 -> each index { output! -> push(170) }
    output! -> file.borrowBytes => source
    source -> slice(0, 3) => text
    [text] => fields
    csv.standard() -> writer(csv.WriterLimits {
        maxOutputBytes: 64
        maxRecords: 2
        maxFieldsPerRecord: 2
        maxFieldBytes: 16
    })? => writer!
    writer! -> writeRecord(fields, output!)? => length
    Result<Unit, csv.Error>.Ok
}

main {
    alias() -> when {
        Ok(_) { "unexpected-alias" -> println }
        Err(error) { error.offset -> println }
    }
}
