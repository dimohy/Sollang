# Late receiver resolution must preserve UInt8 literal range checks.
struct Window { value: Int }
impl Window {
    fill: mut self, bytes: [UInt8], position: Int, count: Int -> Result<Int, Int> { Result<Int, Int>.Ok(Int(bytes[0]) + position + count) }
}
make marker: Int -> Result<Window, Int> { Result<Window, Int>.Ok(Window { value: marker }) }
check marker: Int -> Int {
    marker -> make -> when { Err(_) { 0 -> return } Ok(window) { window } } => window!
    window! -> fill([256], 2, 3) -> when {
        Ok(value) { value }
        Err(_) { 0 }
    }
}
main { 1 -> check -> println }
