struct Owner { bytes: [UInt8; ~] }
struct Branch { first: Owner, second: Owner }
struct Tree { left: Branch, right: Branch }

main {
    Tree {
        left: Branch { first: Owner { bytes: [1; ~] }, second: Owner { bytes: [2; ~] } }
        right: Branch { first: Owner { bytes: [3; ~] }, second: Owner { bytes: [4; ~] } }
    } => tree
    tree.left => left
    tree.left.first => overlapping
    left.first.bytes -> len -> println
    overlapping.bytes -> len -> println
}
