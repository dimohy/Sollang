import sys.file as file

prefix source: file.SourceText -> (first: Text, second: Int) {
    source -> slice(UIntSize(0), UIntSize(3)) => view
    (first: view, second: 1)
}

consume source: move file.SourceText -> Unit {
}

main {
    "lexer" -> file.borrowText => source
    source -> prefix => views
    source -> consume
    views.first -> println
}
