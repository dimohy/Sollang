struct Pair {
    left: [Int; ~]
    right: [Int; ~]
}

replacement: -> Result<[Int; ~], Int> => Result<[Int; ~], Int>.Err(7)

impl Pair {
    invalid: mut self -> Result<Int, Int> {
        self.left => left
        replacement()? => self.left
        Result<Int, Int>.Ok(left -> len)
    }
}

main {
    Pair { left: [1; ~], right: [2; ~] } => pair!
    pair! -> invalid => result
}
