mutate borrowed: Result<[Int; ~], Text> -> Int {
    Result<[Int; ~], Text>.Ok([3; ~]) -> when {
        Ok(payload) {
            payload => owner!
            owner! -> push(4)
            borrowed -> when {
                Ok(payload) {
                    payload => illegal!
                    illegal! -> push(5)
                    illegal! -> len
                }
                Err(_) { 0 }
            }
        }
        Err(_) { 0 }
    }
}

main {
    Result<[Int; ~], Text>.Ok([1; ~]) -> mutate -> println
}
