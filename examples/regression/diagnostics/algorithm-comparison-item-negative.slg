import std.algorithm as algorithm

struct TextComparison { }
impl algorithm.Comparison for TextComparison {
    type Item = Text
    public compare: self, left: ref Text, right: ref Text -> Int => 0
}
main {
    [2, 1; ~] => values!
    algorithm.Ordering { direction: algorithm.Direction.Ascending } => ordering
    ordering -> sort(values!, TextComparison { })
}
