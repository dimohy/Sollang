import std.text.regex as regex
import sys.file as file

appendByte output: mut [UInt8; ~], value: UInt8 -> Unit { output -> push(value) }

escape: -> Result<regex.Pattern, regex.Error> {
    [UInt8; ~] => bytes!
    appendByte(bytes!, 97)
    bytes! -> file.borrowBytes => source
    source -> slice(0, 1) => text
    regex.pattern(text, regex.Limits { maxPatternBytes: 1, maxAtoms: 1, maxInputBytes: 1, maxSteps: 10 })
}

main {
    escape() -> when {
        Ok(matcher) { matcher -> scratchCells -> println }
        Err(error) { error.patternOffset -> println }
    }
}
