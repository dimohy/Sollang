wrap value: Text, storage: mut Arena -> Result<Int, Text> {
    value -> materialize(storage) -> Result<Int, Text>.Err
}

main {
    Arena(0) => storage!
    "first" -> wrap(storage!) => wrapped
    "second" -> materialize(storage!) => second
    wrapped -> when {
        Ok(_) {}
        Err(value) { value -> println }
    }
    second -> println
}
