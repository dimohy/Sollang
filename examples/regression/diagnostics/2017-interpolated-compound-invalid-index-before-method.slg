public struct Token { raw: UInt64 }

public makeToken value: UInt64 -> Token => Token { raw: value }
public value token: Token -> UInt64 => 99

impl Token {
    public value: self -> UInt64 => self.raw
}

main {
    makeToken(7) => token
    [token] => tokens
    "value=$(tokens[UIntSize(0) + UIntSize(0)] -> value(1))" -> println
}
