# Nested UInt8 fields cannot index mapped bytes in interpolation.
struct Inner { value: UInt8 }
struct Outer { inner: Inner }

readMap: -> MappedBytes uses File {
    map read "data.bin" => data
    data
}

main {
    Outer { inner: Inner { value: UInt8(1) } } => offset
    readMap() => data
    "byte=$(data[offset.inner.value])" -> println
}
