wrap value: Text, storage: mut Arena -> Result<Text, Int> {
    value -> materialize(storage) -> Result<Text, Int>.Ok
}

main {
    Arena(0) => storage!
    "first" -> wrap(storage!) => wrapped
    "second" -> materialize(storage!) => second
    wrapped -> when {
        Err(_) {}
        Ok(value) { value -> println }
    }
    second -> println
}
