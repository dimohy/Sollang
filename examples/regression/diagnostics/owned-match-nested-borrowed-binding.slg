mutate result: Result<Result<[Int; ~], Text>, Text> -> Int {
    result -> when {
        Ok(parcel) {
            parcel -> when {
                Ok(payload) {
                    payload => owner!
                    owner! -> push(2)
                    owner! -> len
                }
                Err(_) { 0 }
            }
        }
        Err(_) { 0 }
    }
}

main {
    Result<Result<[Int; ~], Text>, Text>.Ok(Result<[Int; ~], Text>.Ok([1; ~])) -> mutate -> println
}
