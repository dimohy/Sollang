import std.time as time

main {
    time.monotonicClock() => clock
    1 -> time.milliseconds -> when {
        Ok(period) {
            clock -> timer(period, time.MissedTickPolicy.Burst) -> when {
                Ok(timer) {
                    timer -> wait => pending
                    timer -> close
                    pending -> cancel
                }
                Err(error) { }
            }
        }
        Err(error) { }
    }
}
