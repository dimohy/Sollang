# The name after `->` is the instance method, not the result binding.
struct Window {
    value: Int
}

struct Limits {
    value: Int
}

impl Limits {
    window: self -> Result<Window, Int> {
        Result<Window, Int>.Ok(Window { value: self.value })
    }
}

run: -> Result<Int, Int> {
    Limits { value: 42 } -> chunkWindow? => chunkWindow!
    Result<Int, Int>.Ok(chunkWindow.value)
}

main {
    0 -> println
}
