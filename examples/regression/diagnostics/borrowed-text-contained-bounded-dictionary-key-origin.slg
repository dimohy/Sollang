import sys.file as file

prefix source: file.SourceText -> {Text: Int; <=2} {
    source -> slice(UIntSize(0), UIntSize(3)) => view
    {view: 1; <=2}
}

consume source: move file.SourceText -> Unit {
}

main {
    "lexer" -> file.borrowText => source
    source -> prefix => views
    source -> consume
    views["lex"] -> println
}
