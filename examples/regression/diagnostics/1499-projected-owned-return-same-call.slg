struct Owner { values: [Int; ~] }
struct Pair { left: Owner, right: Owner }
consume owner: move Owner -> Int { owner.values -> len }
consumeBoth owner: move Owner, other: move Owner -> Int { (owner.values -> len) + (other.values -> len) }
impl Pair { finish: move self -> Int {
        true -> while { consumeBoth(self.left, self.left) -> return }
        0
} }
main { Pair { left: Owner { values: [7,; ~] }, right: Owner { values: [8,9,; ~] } } -> finish -> println }
