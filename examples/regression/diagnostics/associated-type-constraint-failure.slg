struct TextSource {
    value: Text
}

trait Source {
    type Item
    read: self -> Item
}

impl Source for TextSource {
    type Item = Text

    read: self -> Text {
        self.value
    }
}

sourceInt<T> value: T -> Int where T: Source, T.Item == Int {
    0
}

main {
    TextSource { value: "text" } -> sourceInt => answer
    "$answer" -> println
}
