import std.path as path
import sys.file as file
import sys.path as legacy

appendByte output: mut [UInt8; ~], value: UInt8 -> Unit {
    output -> push(value)
}

escape: -> Result<path.Components, path.Error> {
    [UInt8; ~] => bytes!
    appendByte(bytes!, 97)
    appendByte(bytes!, 47)
    appendByte(bytes!, 98)
    bytes! -> file.borrowBytes => source
    source -> slice(0, source -> len) => text
    path.components(text, legacy.Style.Posix, path.Limits {
        maxInputBytes: 3
        maxComponents: 2
        maxComponentBytes: 1
    })
}

main {
    escape() -> when {
        Ok(parts) {
            parts => owner!
            owner! -> next -> when {
                Ok(component) { component -> println }
                Err(error) { error.offset -> println }
            }
        }
        Err(error) => error.offset -> println
    }
}
