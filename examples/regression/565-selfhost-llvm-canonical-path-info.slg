import sollang.compiler.llvm.text as llvm

main {
    [
    """
    import sys.path as path
    main {
        "examples/regression/fixtures/425-directory-order/Alpha.txt" -> path.fromText(path.nativeStyle()) => filePath
        filePath -> queryRaw -> when {
            Ok(raw) { raw.byteLength != 6 -> if { "unexpected file length" -> println } }
            Err(message) { message -> println }
        }
    }
    """; ~
    ] => sources!
    sources! -> llvm.emit
}
