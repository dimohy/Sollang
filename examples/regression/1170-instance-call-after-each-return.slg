struct Command {
    values: [Text; ~]
}

impl Command {
    public run: move self -> Int => self.values -> len
}

normalize value: Int -> Int => value

execute output: Text, arguments: [Text; ~] -> Int {
    [Text; ~] => values!
    values! -> push(output)
    arguments -> each argument { values! -> push(argument) }
    Command { values: values! } => command
    command -> run -> normalize
}

# The final instance pipeline must be emitted after the each callback.
main {
    "output" -> execute(["one", "two"; ~]) => count
    "$count" -> println
}
