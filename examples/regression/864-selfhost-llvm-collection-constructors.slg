import sollang.compiler.llvm.text as llvm

main {
    [
        """
        main {
            BinaryHeap<Int>(2) => heap!
            Deque<Int>(2) => deque!
            Set<Int>(2) => set!
            BitSet<130>() => bits!
            "constructed" -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
