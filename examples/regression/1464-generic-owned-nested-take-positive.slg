struct Row { values: [Int; ~] }
struct Entry { rows: [Row; ~] }
struct Algorithms { }
impl Algorithms {
    extract<T>: self, values: mut [T; ~], index: Int -> T {
        values -> take(index)
    }
}
main {
    [Entry { rows: [Row { values: [31, 32; ~] },; ~] },; ~] => entries!
    Algorithms { } => algorithms
    algorithms -> extract(entries!, 0) => first
    first.rows[0].values[0] -> println
    first.rows[0].values[1] -> println
    entries! -> len -> println
}
