import sollang.compiler.ir.typed as typedIr

# Exposes the exact return operand selected by the self-hosted Typed IR.
main {
    [
        """
        nibble value: UInt8 -> UInt64 {
            value >= UInt8(48) and value <= UInt8(57) -> if {
                UInt64(value - UInt8(48))
            } else {
                UInt64(value - UInt8(97)) + UInt64(10)
            }
        }

        accumulate source: Text, start: UIntSize, offset: UIntSize, digits: UIntSize -> UInt64 {
            UInt64(0) => value!
            UIntSize(0) => digit!
            digit! < digits -> while {
                value! * UInt64(16) + (source -> byte(start + offset + digit!) -> nibble) => value!
                digit! + UIntSize(1) => digit!
            }
            value!
        }

        main { }
        """; ~
    ] => sources!
    sources! -> typedIr.lower => ir!
    0 => index!
    index! < (ir! -> len) -> while {
        ir![index!] => node
        node.sourceModule == 0 -> if {
            index! => currentIndex
            "$currentIndex: kind=$(node.kind), parent=$(node.parent), symbol=$(node.symbol), operand0=$(node.operand0), operand1=$(node.operand1), next=$(node.nextOperand), flags=$(node.flags), opcode=$(node.opcode)" -> println
        }
        index! + 1 => index!
    }
}
