import sollang.compiler.llvm.text as llvm

main {
    [
        """
        native fixture from "native_fixture" {
            add left: Int32, right: Int32 -> Int32 as "native_add"
        }

        main {
            fixture.add(20, 22) -> println
        }
        """; ~
    ] => sources
    sources -> llvm.emitWasmChecked => diagnosticCount
    "diagnostics = $diagnosticCount" -> println
}
