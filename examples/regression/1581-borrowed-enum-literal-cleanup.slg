struct Payload { values: [Int; ~] }
enum Owner {
    Empty
    First(Payload)
    Second(Payload)
}
impl Owner {
    first: self -> Int {
        self -> when {
            Empty { 0 }
            First(payload) { payload.values[0] }
            Second(payload) { payload.values[0] }
        }
    }
}
main { Owner.Second(Payload { values: [13; ~] }) -> first -> println }