import sys.quic.keys as keys
import sys.quic.protection as protection

connectionId: -> [UInt8] => [131, 148, 200, 240, 62, 81, 87, 8]

main {
    keys.deriveInitial(keys.version1(), connectionId()) => initial
    protection.headerMask(initial.clientHeaderProtection, [209, 177, 201, 141, 215, 104, 159, 184, 236, 17, 210, 66, 177, 35, 220, 155]) => mask
    protection.nonce(initial.clientIv, 2) => nonce
    (mask[0] == 67
        and mask[1] == 123
        and mask[2] == 154
        and mask[3] == 236
        and mask[4] == 54
        and nonce[0] == 250
        and nonce[1] == 4
        and nonce[2] == 75
        and nonce[3] == 47
        and nonce[4] == 66
        and nonce[5] == 163
        and nonce[6] == 253
        and nonce[7] == 59
        and nonce[8] == 70
        and nonce[9] == 251
        and nonce[10] == 37
        and nonce[11] == 94) -> if {
        "quic-header-protection=ok"
    } else {
        "quic-header-protection=failed"
    } -> println
}
