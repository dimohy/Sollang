# Exact formatter output retained from the CSharp eight-case continuation proof.
import sollang.compiler.cli_format as formatter
import sys.file as file

utf8 values: [Int] -> [UInt8; ~] {
    [UInt8; ~] => bytes!
    values -> each value { bytes! -> push(UInt8(value)) }
    bytes!
}

check sourceValues: [Int], expectedValues: [Int], label: Text -> Unit uses Console {
    sourceValues -> utf8 => sourceBytes
    expectedValues -> utf8 => expectedBytes
    sourceBytes -> file.borrowBytes => source
    expectedBytes -> file.borrowBytes => expected
    source -> formatter.format => result
    result.bytes -> file.borrowBytes => formatted
    formatted -> slice(0, formatted -> len) => actualText
    expected -> slice(0, expected -> len) => expectedText
    "$label=$(result.status == 0 and actualText == expectedText)" -> println
}

