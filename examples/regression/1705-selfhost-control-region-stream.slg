import std.sequence

main {
    1 -> when {
        1..1 {
            0 => total!
            1..10
                -> map item { item * 2 }
                -> filter item { item % 3 == 0 }
                -> take(3)
                -> each item {
                    total! + item => total!
                }
            total! -> println
        }
        else { 0 -> println }
    }
}
