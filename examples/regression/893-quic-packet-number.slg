import std.net.quic.packet_number as packetNumber
import std.net.quic.error as errors

check: -> Result<Bool, errors.Error> {
    UInt64(2_821_665_003) -> packetNumber.restore(39_730, 2)? => restored
    UInt64(1_001) -> packetNumber.selectLength(true, 1_000) => oneByte
    UInt64(33_768) -> packetNumber.selectLength(true, 1_000) => threeBytes
    UInt64(1_001) -> packetNumber.selectLength(false, 0) => firstFlight
    UInt64(2_821_692_210) -> packetNumber.truncate(2)? => truncated
    Result<Bool, errors.Error>.Ok(restored == 2_821_692_210
        and oneByte == 1
        and threeBytes == 3
        and firstFlight == 4
        and truncated.value == 39_730
        and truncated.byteCount == 2)
}

main {
    check() -> when {
        Ok(matches) { matches }
        Err(failure) { false }
    } -> if {
        "quic-packet-number=ok"
    } else {
        "quic-packet-number=failed"
    } -> println
}
