import sollang.compiler.semantic.context as context
import sollang.compiler.semantic.expression_type_ids as expressions
import sollang.compiler.semantic.semantic_generations as generations
import std.crypto.sha256 as sha256

reseal content: ref [UInt64; ~] -> [UInt64; ~] {
    [UInt64; ~] => words!
    content -> each word { words! -> push(word) }
    UInt64((words! -> len) + 32) => words![2]
    [UInt8; ~] => bytes!
    words! -> each word {
        word => remaining!
        0..<8 -> each {
            bytes! -> push(UInt8(remaining! % 256))
            remaining! / 256 => remaining!
        }
    }
    sha256.create() => hasher!
    hasher! -> update(bytes!)
    hasher! -> finish => digest
    digest -> each byte { words! -> push(UInt64(byte)) }
    words!
}

main {
    """
    import stored.provider as provider
    main { provider.plus(UInt8(3)) => value
    value -> println
    }

    """ => mainSource
    """
    namespace stored.provider
    public plus<T> value: T -> T => value

    """ => provider
    """
    namespace unrelated
    public value: -> Int => 1

    """ => unrelated
    [mainSource, provider, unrelated; ~] -> context.prepare => before
    before -> expressions.resolveCallContext => resolved
    ["main.slg", "provider.slg", "other.slg"; ~] => paths
    [UInt8(0); 32] => fingerprint
    generations.CompilationIdentity { compiler: 1, target: 2, configuration: 3 } => identity
    resolved.prepared -> generations.capture(resolved.types, paths, 0, identity, fingerprint) => encoded
    encoded.status == 0 -> println
    [unrelated, provider, mainSource; ~] -> context.prepare => current
    ["other.slg", "provider.slg", "main.slg"; ~] => currentPaths
    encoded.words -> generations.restore(current, currentPaths, identity, fingerprint) => restored
    restored.status == 0 -> println
    """
    namespace stored.provider
    public plus<T> value: T -> T { value }

    """ => providerChanged
    [mainSource, providerChanged, unrelated; ~] -> context.prepare => changed
    encoded.words -> generations.restore(changed, paths, identity, fingerprint) => rejected
    (rejected.status == 14 and (rejected.calls -> len) == 0 and (rejected.owner.bindings -> len) == 0) -> println
    [mainSource, provider,
    """
    namespace unrelated
    public value: -> Int => 2

    """; ~] -> context.prepare => independent
    encoded.words -> generations.restore(independent, paths, identity, fingerprint) => reused
    reused.status == 0 -> println
    generations.CompilationIdentity { compiler: 2, target: 2, configuration: 3 } => changedCompiler
    encoded.words -> generations.restore(current, currentPaths, changedCompiler, fingerprint) => contextRejected
    contextRejected.status == 12 -> println
    [UInt8(1); 32] => changedFingerprint
    encoded.words -> generations.restore(current, currentPaths, identity, changedFingerprint) => declarationRejected
    declarationRejected.status == 13 -> println
    generations.CompilationIdentity { compiler: 1, target: 4, configuration: 3 } => changedTarget
    encoded.words -> generations.restore(current, currentPaths, changedTarget, fingerprint) => targetRejected
    targetRejected.status == 12 -> println
    generations.CompilationIdentity { compiler: 1, target: 2, configuration: 4 } => changedConfiguration
    encoded.words -> generations.restore(current, currentPaths, changedConfiguration, fingerprint) => configurationRejected
    configurationRejected.status == 12 -> println
    encoded.words[7] == 2 -> println
    (encoded.words -> len) - 32 => contentLength
    [UInt64; ~] => damaged!
    encoded.words -> each word { damaged! -> push(word) }
    (damaged![contentLength] + 1) % 256 => damaged![contentLength]
    damaged! -> generations.restore(current, currentPaths, identity, fingerprint) => checksumRejected
    (checksumRejected.status == 11 and (checksumRejected.owner.semantic.types -> len) == 0) -> println
    41 + Int(encoded.words[40]) + 32 => firstEnd
    firstEnd + 1 + Int(encoded.words[firstEnd]) + 32 => secondEnd
    [UInt64; ~] => missingTarget!
    0..<firstEnd -> each index { missingTarget! -> push(encoded.words[index]) }
    secondEnd..<contentLength -> each index { missingTarget! -> push(encoded.words[index]) }
    1 => missingTarget![7]
    missingTarget! -> reseal => forgedTarget
    forgedTarget -> generations.restore(current, currentPaths, identity, fingerprint) => missingTargetRejected
    (missingTargetRejected.status == 14 and (missingTargetRejected.calls -> len) == 0) -> println
    [UInt64; ~] => missingOwner!
    0..<40 -> each index { missingOwner! -> push(encoded.words[index]) }
    firstEnd..<contentLength -> each index { missingOwner! -> push(encoded.words[index]) }
    1 => missingOwner![7]
    missingOwner! -> reseal => forgedOwner
    forgedOwner -> generations.restore(current, currentPaths, identity, fingerprint) => missingOwnerRejected
    missingOwnerRejected.status == 14 -> println
    [UInt64; ~] => duplicate!
    0..<secondEnd -> each index { duplicate! -> push(encoded.words[index]) }
    firstEnd..<secondEnd -> each index { duplicate! -> push(encoded.words[index]) }
    secondEnd..<contentLength -> each index { duplicate! -> push(encoded.words[index]) }
    3 => duplicate![7]
    duplicate! -> reseal => forgedDuplicate
    forgedDuplicate -> generations.restore(current, currentPaths, identity, fingerprint) => duplicateRejected
    duplicateRejected.status == 14 -> println
    [UInt64; ~] => truncated!
    0..<((encoded.words -> len) - 1) -> each index { truncated! -> push(encoded.words[index]) }
    truncated! -> generations.restore(current, currentPaths, identity, fingerprint) => truncatedRejected
    truncatedRejected.status == 10 -> println
    [UInt8(0); 31] => shortFingerprint
    resolved.prepared -> generations.capture(resolved.types, paths, 0, identity, shortFingerprint) => invalidCapture
    (invalidCapture.status == 10 and (invalidCapture.words -> len) == 0) -> println
    """
    namespace stored.provider
    privatePart: -> Int => 1

    """ => providerPart
    [mainSource, provider, providerPart, unrelated; ~] -> context.prepare => multi
    multi -> expressions.resolveCallContext => multiResolved
    ["main.slg", "provider.slg", "part.slg", "other.slg"; ~] => multiPaths
    multiResolved.prepared -> generations.capture(multiResolved.types, multiPaths, 0, identity, fingerprint) => multiEncoded
    [mainSource, provider,
    """
    namespace stored.provider
    privatePart: -> Int => 2

    """, unrelated; ~] -> context.prepare => changedPart
    multiEncoded.words -> generations.restore(changedPart, multiPaths, identity, fingerprint) => partRejected
    partRejected.status == 14 -> println
    """
    import stored.provider as provider
    main { provider.value() -> println }

    """ => plainMain
    """
    namespace stored.provider
    public value: -> Int => 1

    """ => plainProvider
    [plainMain, plainProvider; ~] -> context.prepare => plain
    plain -> expressions.resolveCallContext => plainResolved
    ["main.slg", "provider.slg"; ~] => plainPaths
    plainResolved.prepared -> generations.capture(plainResolved.types, plainPaths, 0, identity, fingerprint) => plainEncoded
    [plainMain,
    """
    namespace stored.provider
    public value: -> Int => 2

    """; ~] -> context.prepare => plainChanged
    plainEncoded.words -> generations.restore(plainChanged, plainPaths, identity, fingerprint) => plainReused
    plainReused.status == 0 -> println
}
