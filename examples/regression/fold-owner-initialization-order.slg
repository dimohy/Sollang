struct Counter {
    public value: Int
}
bump counter: mut Counter -> Int {
    counter.value + 1 => counter.value
    counter.value
}
sumFrom initial: Int -> Int {
    Counter { value: initial } => counter!
    1..2 -> fold 0 total, index {
        (counter! -> bump) + total
    } => result
    result
}
main {
    3 -> sumFrom -> println
    Counter { value: 3 } => counter!
    1..0 -> fold 0 total, index {
        (counter! -> bump) + total
    } => result
    result -> println
    counter!.value -> println
}
