namespace sollang.compiler.semantic.ownership_check

import sollang.compiler.ir.typed as typedIr

node kind: Int, module: Int, symbol: Int, target: Int -> typedIr.TypedIrNode {
    typedIr.TypedIrNode { kind: kind, parent: -1, sourceModule: module, astNode: -1, symbol: symbol, targetModule: target, typeOrigin: -1, typeModule: -1, typeSymbol: -1, typeId: -1, typeKind: -1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: -1, flags: 0 }
}

index typed: ref [typedIr.TypedIrNode; ~], call: Int, selected: Int -> BorrowedTextCallFunctionIndex {
    [Int; ~] => selections!
    0..<Int(typed -> len) -> each { selections! -> push(-1) }
    call >= 0 -> if { selected => selections![call] }
    typed -> typedIr.functionDeclarationIrs => candidates
    typed -> borrowedTextFunctionsByIdentity(candidates) => functions
    BorrowedTextCallFunctionIndex { genericSelectionByCall: selections!, functionCandidates: candidates, functionsByIdentity: functions, interpolationResultTypes: [Int; ~], interpolationFunctionTargets: [Int; ~], interpolationRootByToken: [Int; ~], interpolationNextRoot: [Int; ~] }
}

contract function: Int -> BorrowedTextReturn {
    BorrowedTextReturn { functionIr: function, sourceModule: 2, functionSymbol: 9, parameterOrdinal: 0, transfersOwner: false, concreteParameter: true }
}

main {
    [node(0, 2, 9, -1), node(0, 2, 9, -1), node(0, 3, 9, -1), node(0, -1, -7, -1), node(6, 0, 9, 2), node(6, 0, 9, 3), node(6, 0, 10, 3), node(6, 0, -7, -1), node(9, 4, 11, 4), node(6, 0, 11, 4); ~] => typed
    typed -> index(-1, -1) => ordinary
    [BorrowedTextReturn; ~] => absent
    (-2147483648 -> borrowedTextFunctionIdentity(-2147483648)) == 0 -> println
    (2147483647 -> borrowedTextFunctionIdentity(2147483647)) > (2147483647 -> borrowedTextFunctionIdentity(-2147483648)) -> println
    (0 -> borrowedTextFunctionIdentity(-1)) != (-1 -> borrowedTextFunctionIdentity(2147483647)) -> println
    2 -> borrowedTextFunctionIdentity(9) => duplicateKey
    (ordinary.functionsByIdentity[duplicateKey].unique == -2 and ordinary.functionsByIdentity[duplicateKey].last == 1) -> println
    (typed -> borrowedTextSelectedCallFunctionIr(absent, ordinary, 4)) == -2 -> println
    (typed -> borrowedTextSelectedCallFunctionIr(absent, ordinary, 5)) == 2 -> println
    (typed -> borrowedTextSelectedCallFunctionIr(absent, ordinary, 6)) == -1 -> println
    (typed -> borrowedTextSelectedCallFunctionIr(absent, ordinary, 7)) == 3 -> println
    (typed -> borrowedTextSelectedCallFunctionIr(absent, ordinary, 9)) == -1 -> println
    [contract(0); ~] => known
    (typed -> borrowedTextSelectedCallFunctionIr(known, ordinary, 4)) == 0 -> println
    [contract(0), contract(1); ~] => ambiguous
    (typed -> borrowedTextSelectedCallFunctionIr(ambiguous, ordinary, 4)) == -1 -> println
    typed -> index(4, 1) => concrete
    (typed -> borrowedTextSelectedCallFunctionIr(ambiguous, concrete, 4)) == 1 -> println
    typed -> index(4, 8) => invalidKind
    (typed -> borrowedTextSelectedCallFunctionIr(absent, invalidKind, 4)) == -2 -> println
    typed -> index(4, 99) => invalidRange
    (typed -> borrowedTextSelectedCallFunctionIr(absent, invalidRange, 4)) == -2 -> println
    typed -> index(4, 2) => invalidIdentity
    (typed -> borrowedTextSelectedCallFunctionIr(absent, invalidIdentity, 4)) == -2 -> println
    (typed -> borrowedTextSelectedCallFunctionIr(absent, ordinary, -1)) == -2 -> println
    (typed -> borrowedTextSelectedCallFunctionIr(absent, ordinary, 10)) == -2 -> println
}
