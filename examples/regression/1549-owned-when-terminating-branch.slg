# Terminating arms do not contribute an ownership state to the continuation.
struct Owner { values: [Int; ~] }
sink values: move [Owner; 2] -> Int { values -> len }
consume flag: Int, values: move [Owner; 2] -> Int {
    flag -> when { == 1 {
        values -> sink => count
        count -> return
    } else { 2 } } => remaining
    remaining
}
main {
    [Owner { values: [7,; ~] }, Owner { values: [8, 9; ~] }] => values
    0 -> consume(values) -> println
    [Owner { values: [7,; ~] }, Owner { values: [8, 9; ~] }] => nextValues
    1 -> consume(nextValues) -> println
}
