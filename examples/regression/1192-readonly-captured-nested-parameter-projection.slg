struct Batch {
    values: [Int; ~]
}

struct Envelope {
    unrelated: Int
    batch: Batch
}

struct Lookup {
    bias: Int
}

readLength lookup: ref Lookup, values: ref [Int; ~] -> Int => (values -> len) + lookup.bias

inspect envelope: Envelope -> Int {
    local request: Lookup -> Int {
        request -> readLength(envelope.batch.values)
    }

    Lookup { bias: 0 } -> local
}

main {
    Envelope {
        unrelated: 77
        batch: Batch { values: [3, 5; ~] }
    } -> inspect => length
    "captured-nested-ref-length=$length" -> println
}
