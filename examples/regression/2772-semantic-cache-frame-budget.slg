namespace sollang.compiler.semantic.semantic_cache

import sollang.compiler.semantic.owner_call_facts as owners

main {
    (9 -> capturedRowFits(72, 0)) -> println
    (9 -> capturedRowFits(15999957, 0)) -> println
    not (9 -> capturedRowFits(15999958, 0)) -> println
    (9 -> capturedRowFits(15999547, 205)) -> println
    not (9 -> capturedRowFits(15999548, 205)) -> println
    (15999894 -> capturedRowFits(72, 0)) -> println
    not (15999895 -> capturedRowFits(72, 0)) -> println
    not (9 -> capturedRowFits(72, -1)) -> println
    not (9 -> capturedRowFits(72, 2147483647)) -> println
    not (9 -> capturedRowFits(-1, 0)) -> println
    [UInt64; ~] => frame!
    0..<9 -> each { frame! -> push(0) }
    [UInt64; ~] => payload!
    0..<72 -> each { payload! -> push(0) }
    owners.EncodedOwnerCalls { words: payload!, status: 0 } -> appendGenerationRow(frame!, 0) => accepted
    (accepted == 0 and (frame! -> len) == 83 and frame![9] == 0 and frame![10] == 72) -> println
    [UInt64; ~] => skipped!
    0..<9 -> each { skipped! -> push(0) }
    owners.EncodedOwnerCalls { words: [UInt64; ~], status: 7 } -> appendGenerationRow(skipped!, 0) => rejected
    (rejected == 7 and (skipped! -> len) == 11 and skipped![9] == 7 and skipped![10] == 0) -> println
}
