import std.hash.crc32 as crc32

struct FixedInput {
    bytes: [UInt8; 9]
}

main {
    0 => iteration!
    iteration! < 1 -> while {
        FixedInput { bytes: [49; 9] } => input
        crc32.Polynomial.Ieee -> hasher => hasher!
        hasher! -> write(input.bytes)
        hasher! -> checksum => first
        hasher! -> reset
        hasher! -> write(input.bytes)
        hasher! -> checksum => second
        "$first,$second" -> println
        iteration! + 1 => iteration!
    }
}
