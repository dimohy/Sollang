import sollang.compiler.semantic.context as context
import sollang.compiler.semantic.expression_type_ids as expressions
import sollang.compiler.semantic.semantic_generations as generations
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.semantic.calls as calls

sameType left: ref [typeIds.SemanticType; ~], right: ref [typeIds.SemanticType; ~], a: Int, b: Int -> Bool {
    a < 0 or b < 0 -> if { a == b => same
        same -> return }
    a >= (left -> len) or b >= (right -> len) -> if { false -> return }
    left[a] => x
    right[b] => y
    x.kind != y.kind or x.origin != y.origin or x.module != y.module or x.symbol != y.symbol
        or x.length != y.length or x.status != y.status or (x.containsParameter and not y.containsParameter) or (not x.containsParameter and y.containsParameter)
        -> if { false -> return }
    sameType(left, right, x.first, y.first) and sameType(left, right, x.second, y.second)
}

sameOwner expected: ref expressions.ResolvedCallContext, actual: ref expressions.ResolvedCallContext, source: Int -> Bool {
    expected.prepared.package.ranges[source] => range
    0..<range.symbolCount -> each symbol {
        expected.types.lexicalBindingTypeBySymbol[range.symbolStart + symbol] => left
        actual.types.lexicalBindingTypeBySymbol[range.symbolStart + symbol] => right
        not sameType(expected.types.types, actual.types.types, left, right)
            -> if { false -> return }
    }
    0 => expectedValues!
    0 => actualValues!
    expected.types.expressions -> each value {
        value.sourceModule == source -> if {
            expectedValues! + 1 => expectedValues!
            0 => matches!
            false => found!
            actual.types.expressions -> each candidate {
                candidate.sourceModule == source and candidate.astNode == value.astNode
                    -> if {
                        matches! + 1 => matches!
                        candidate.status == value.status and sameType(expected.types.types, actual.types.types, value.typeId, candidate.typeId) => found!
                    }
            }
            not found! or matches! != 1 -> if { false -> return }
        }
    }
    actual.types.expressions -> each value { value.sourceModule == source -> if { actualValues! + 1 => actualValues! } }
    expectedValues! != actualValues! -> if { false -> return }
    0..<range.astCount -> each ast {
        expected.prepared.callIndexByAst[range.astStart + ast] => left
        actual.prepared.callIndexByAst[range.astStart + ast] => right
        (left < 0 and right >= 0) or (left >= 0 and right < 0)
            -> if { false -> return }
        left >= 0 -> if {
            expected.prepared.calls[left] => x
            actual.prepared.calls[right] => y
            x.targetSourceModule != y.targetSourceModule or x.functionSymbol != y.functionSymbol or x.status != y.status
                -> if { false -> return }
        }
    }
    0 => expectedArguments!
    0 => actualArguments!
    expected.types.callArguments -> each argument {
        argument.sourceModule == source -> if {
            expectedArguments! + 1 => expectedArguments!
            false => found!
            actual.types.callArguments -> each candidate {
                candidate.sourceModule == source and candidate.callAst == argument.callAst and candidate.parameterOrdinal == argument.parameterOrdinal
                    -> if {
                        candidate.status == argument.status and candidate.targetSourceModule == argument.targetSourceModule and candidate.functionSymbol == argument.functionSymbol
                            and sameType(expected.types.types, actual.types.types, argument.expectedTypeId, candidate.expectedTypeId)
                            and sameType(expected.types.types, actual.types.types, argument.actualTypeId, candidate.actualTypeId)
                            and sameType(expected.types.types, actual.types.types, argument.genericActualTypeId, candidate.genericActualTypeId)
                            and sameType(expected.types.types, actual.types.types, argument.genericFirstActualTypeId, candidate.genericFirstActualTypeId)
                            and sameType(expected.types.types, actual.types.types, argument.mismatchExpectedTypeId, candidate.mismatchExpectedTypeId)
                            and sameType(expected.types.types, actual.types.types, argument.mismatchActualTypeId, candidate.mismatchActualTypeId)
                            and candidate.parameterSymbol == argument.parameterSymbol and candidate.genericParameterSymbol == argument.genericParameterSymbol => found!
                    }
            }
            not found! -> if { false -> return }
        }
    }
    actual.types.callArguments -> each argument { argument.sourceModule == source -> if { actualArguments! + 1 => actualArguments! } }
    expectedArguments! == actualArguments!
}

main {
    "import stored.provider as provider\nmain { UInt8(3) => input\nprovider.plus(input) => value\nvalue + (true -> if { 1 } else { 2 }) => total\nvalue -> println\ntotal -> println\n}\n" => mainSource
    "namespace stored.provider\npublic plus<T> value: T -> T => value\n" => provider
    "namespace unrelated\npublic value: -> Int => 1\n" => unrelated
    [mainSource, provider, unrelated; ~] -> context.prepare -> expressions.resolveCallContext => before
    ["main.slg", "provider.slg", "other.slg"; ~] => paths
    generations.CompilationIdentity { compiler: 1, target: 2, configuration: 3 } => identity
    before.prepared -> generations.captureCurrent(before.types, paths, 0, identity) => encoded
    encoded.status == 0 -> println
    "namespace unrelated\npublic value: -> Int => 2\n" => changedOther
    [changedOther, provider, mainSource; ~] -> context.prepare -> expressions.resolveCallContext => expected
    ["other.slg", "provider.slg", "main.slg"; ~] => reorderedPaths
    [changedOther, provider, mainSource; ~] -> context.prepare => current
    encoded.words -> generations.resolveCurrent(current, reorderedPaths, identity) -> when {
        Ok(actual) { sameOwner(expected, actual, 2) -> println }
        Err(_) { false -> println }
    }
    [changedOther, provider, mainSource; ~] -> context.prepare => ordinary
    expressions.emptyCallContextSeeds() => empty
    ordinary -> expressions.resolveCallContextSeeded(empty) -> when {
        Ok(actual) { sameOwner(expected, actual, 2) -> println }
        Err(_) { false -> println }
    }
    [mainSource, provider, unrelated; ~] -> context.prepare => wrongShape
    expressions.CallContextSeeds { ownerBySource: [true,; ~], bindingTypeBySymbol: [Int; ~], values: [expressions.ExpressionTypeId; ~], calls: [calls.ModuleCallResolution; ~], arguments: [expressions.ResolvedCallArgument; ~] } => malformed
    wrongShape -> expressions.resolveCallContextSeeded(malformed) -> when { Ok(_) { false -> println } Err(code) { code == 1 -> println } }
    [mainSource, "namespace stored.provider\npublic plus<T> value: T -> T { value }\n", unrelated; ~] -> context.prepare => changedGeneric
    encoded.words -> generations.resolveCurrent(changedGeneric, paths, identity) -> when { Ok(_) { false -> println } Err(code) { code == 14 -> println } }
    [mainSource, provider, unrelated; ~] -> context.prepare => changedContext
    generations.CompilationIdentity { compiler: 2, target: 2, configuration: 3 } => wrongIdentity
    encoded.words -> generations.resolveCurrent(changedContext, paths, wrongIdentity) -> when { Ok(_) { false -> println } Err(code) { code == 12 -> println } }
    before.prepared -> generations.captureCurrent(before.types, paths, 1, identity) => providerEncoded
    providerEncoded.status == 0 -> println
    [changedOther, provider, mainSource; ~] -> context.prepare => multiple!
    multiple! -> generations.emptySeeds => seeds!
    providerEncoded.words -> generations.restoreCurrent(multiple!, reorderedPaths, identity) => providerOwner
    providerOwner -> generations.appendRestoredOwner(multiple!, seeds!) => providerStatus
    encoded.words -> generations.restoreCurrent(multiple!, reorderedPaths, identity) => mainOwner
    mainOwner -> generations.appendRestoredOwner(multiple!, seeds!) => mainStatus
    encoded.words -> generations.restoreCurrent(multiple!, reorderedPaths, identity) => duplicateOwner
    duplicateOwner -> generations.appendRestoredOwner(multiple!, seeds!) => duplicateStatus
    duplicateStatus == 17 -> println
    multiple! -> context.freeze -> expressions.resolveCallContextSeeded(seeds!) -> when {
        Ok(actual) { (providerStatus == 0 and mainStatus == 0 and sameOwner(expected, actual, 1) and sameOwner(expected, actual, 2)) -> println }
        Err(_) { false -> println }
    }
    [mainSource, provider, unrelated; ~] -> context.prepare => badType
    badType -> generations.emptySeeds => invalid!
    [true, false, false; ~] => invalid!.ownerBySource
    invalid!.values -> push(expressions.ExpressionTypeId { sourceModule: 0, astNode: 0, typeId: 999999, status: 0 })
    badType -> expressions.resolveCallContextSeeded(invalid!) -> when { Ok(_) { false -> println } Err(code) { code == 1 -> println } }

}
