makeSet: -> Set<Int> uses Console {
    Set<Int>(4) => values!
    values! -> insert(10) => first
    values! -> insert(20) => second
    values! -> insert(10) => duplicate
    values! -> insert(30) => third
    values! -> insert(4) => inserted4
    values! -> insert(5) => inserted5
    values! -> insert(6) => inserted6
    values! -> insert(7) => inserted7
    values! -> insert(8) => inserted8
    values! -> insert(9) => inserted9
    values! -> insert(11) => inserted11
    values! -> insert(12) => inserted12
    values! -> insert(13) => inserted13
    values! -> insert(14) => inserted14
    values! -> insert(15) => inserted15
    values! -> insert(16) => inserted16
    first -> if { "first=true" -> println } else { "first=false" -> println }
    duplicate -> if { "duplicate=true" -> println } else { "duplicate=false" -> println }
    values!
}

main {
    makeSet() => values!
    0 => total!
    values! -> each value {
        total! + value => total!
    }
    values! -> contains(20) => before
    values! -> remove(20) => removed
    values! -> remove(20) => removedAgain
    values! -> contains(20) => after
    0 => remaining!
    values! -> each value {
        remaining! + value => remaining!
    }
    values! -> len => length
    values! -> capacity => capacity
    before -> if { "before=true" -> println } else { "before=false" -> println }
    removed -> if { "removed=true" -> println } else { "removed=false" -> println }
    removedAgain -> if { "again=true" -> println } else { "again=false" -> println }
    after -> if { "after=true" -> println } else { "after=false" -> println }
    total! -> println
    remaining! -> println
    "len=$length capacity=$capacity" -> println
}
