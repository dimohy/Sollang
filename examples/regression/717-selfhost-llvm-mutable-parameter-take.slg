import sollang.compiler.llvm.text as llvm

# Array take must read and update a mutable parameter through its ABI borrow
# addresses rather than an unallocated local slot.
main {
    [
        """
        remove values: mut [Int; ~], index: Int -> Int {
            values -> take(index) => removed
            removed
        }

        main {
            [10, 20; ~] => values!
            values! -> remove(0) -> println
            values![0] -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
