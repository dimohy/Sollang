enum Route {
    Local(UInt64)
    Remote(UInt64)
}

enum RouteResult {
    Ok(UInt64)
    Err(UInt64)
}

# A match typed during finalization must still seal its enclosing if result.
route local: Bool -> RouteResult {
    local -> if {
        Route.Local(7) -> when {
            Local(value) { RouteResult.Ok(value) }
            Remote(value) { RouteResult.Err(value) }
        }
    } else {
        RouteResult.Ok(11)
    }
}

main {
    route(true) -> when {
        Ok(value) { "route=$value" -> println }
        Err(value) { "error=$value" -> println }
    }
}
