import sys.io
import std.net as net
import std.net.socket as socket
import std.time as time

# Relative synchronous timeouts stay on the live TcpStream and None restores blocking mode.
timeoutMillis timeout: Option<time.Duration> -> Long => timeout -> when {
    Option<time.Duration>.Some(duration) => duration -> asMilliseconds
    Option<time.Duration>.None => -1
}

observe read: time.Duration, write: time.Duration, zero: time.Duration -> Result<Bool, socket.SocketError> uses Network, Console {
    socket.ListenOptions {
        endpoint: net.loopback(0) -> unified
        backlog: 4
        reuseAddress: true
    } -> listen? => listener
    listener -> localEndpoint? => endpoint
    endpoint -> connect? => client
    listener -> accept? => server

    client -> setReadTimeout(Option<time.Duration>.Some(zero)) -> when {
        Ok(_) { false }
        Err(error) => error.kind -> when {
            InvalidArgument { true }
            else { false }
        }
    } => zeroRejected

    client -> setReadTimeout(Option<time.Duration>.Some(read))?
    client -> readTimeout? => observedRead
    client -> setWriteTimeout(Option<time.Duration>.Some(write))?
    client -> writeTimeout? => observedWrite
    client -> setReadTimeout(Option<time.Duration>.None)?
    client -> setWriteTimeout(Option<time.Duration>.None)?
    client -> readTimeout? => clearedRead
    client -> writeTimeout? => clearedWrite

    observedRead -> timeoutMillis => readMillis
    observedWrite -> timeoutMillis => writeMillis
    clearedRead -> timeoutMillis => clearedReadMillis
    clearedWrite -> timeoutMillis => clearedWriteMillis
    readMillis >= 250 and readMillis <= 300 => readValid
    writeMillis >= 400 and writeMillis <= 450 => writeValid
    "read-valid=$readValid,write-valid=$writeValid,cleared=$clearedReadMillis,$clearedWriteMillis,zero-rejected=$(zeroRejected)" -> println

    client -> close
    server -> close
    listener -> close
    Result<Bool, socket.SocketError>.Ok(
        readValid
            and writeValid
            and clearedReadMillis == -1
            and clearedWriteMillis == -1
            and zeroRejected)
}

main {
    time.milliseconds(250) -> when {
        Ok(read) {
            time.milliseconds(400) -> when {
                Ok(write) {
                    time.milliseconds(0) -> when {
                        Ok(zero) {
                            observe(read, write, zero) -> when {
                                Ok(valid) { valid -> if { "socket-timeout=ok" } else { "socket-timeout=failed" } -> println }
                                Err(error) { "socket-timeout-error=$(error.code)" -> println }
                            }
                        }
                        Err(_) { "zero-duration-error" -> println }
                    }
                }
                Err(_) { "write-duration-error" -> println }
            }
        }
        Err(_) { "read-duration-error" -> println }
    }
}
