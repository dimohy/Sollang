# Verifies recursive self-host expression types for collection constructors.
import sollang.compiler.ast as ast
import sollang.compiler.semantic.expression_type_ids as expressionTypeIds

main {
    [
        """
        main {
            Set<Int>(2) => set!
            Deque<Int>(2) => deque!
            BinaryHeap<Int>(2) => heap!
            Deque<box Int>(2) => ownedDeque!
            BitSet<130>() => bits!
        }
        """; ~
    ] => sources
    sources -> expressionTypeIds.resolve => resolved
    sources[0] -> ast.lower => nodes

    false => hasSet!
    false => hasDeque!
    false => hasHeap!
    false => hasBits!
    false => hasOwnedDeque!
    resolved.expressions -> each expression {
        resolved.types[expression.typeId] => semanticType
        (semanticType.kind == 7 and semanticType.origin == 4 and semanticType.symbol == 5)
            -> if { true => hasSet! }
        (semanticType.kind == 7 and semanticType.origin == 4 and semanticType.symbol == 6)
            -> if { true => hasDeque! }
        (semanticType.kind == 7 and semanticType.origin == 4 and semanticType.symbol == 7)
            -> if { true => hasHeap! }
        (semanticType.kind == 7 and semanticType.origin == 4 and semanticType.symbol == 6 and semanticType.first >= 0 and resolved.types[semanticType.first].kind == 6)
            -> if { true => hasOwnedDeque! }
        (semanticType.kind == 14 and semanticType.origin == 4 and semanticType.symbol == 8 and semanticType.length == 130)
            -> if { true => hasBits! }
    }

    hasSet! -> if { "set=true" -> println } else { "set=false" -> println }
    hasDeque! -> if { "deque=true" -> println } else { "deque=false" -> println }
    hasHeap! -> if { "heap=true" -> println } else { "heap=false" -> println }
    hasBits! -> if { "bits=true" -> println } else { "bits=false" -> println }
    hasOwnedDeque! -> if { "owned-deque=true" -> println } else { "owned-deque=false" -> println }
}
