namespace conditional.argument

struct Target {
    public objectFormat: Int
}

struct Product {
    public target: Target
}

emit value: Text -> Unit uses Console {
    value -> println
}

emitCount value: Text -> Int32 uses Console {
    value -> println
    7
}

unit: -> Unit {}

acceptUnit value: Unit -> Int32 { 9 }

run product: Product -> Unit uses Console {
    product.target.objectFormat == 3 -> if { "wasm32-browser" } else { "Linux" }
        -> emit
    product.target.objectFormat == 3 -> if { "again-wasm" } else { "again-linux" }
        -> emitCount -> println
    product.target.objectFormat == 3 -> if { "inline-wasm" } else { "inline-linux" } -> emit
    product.target.objectFormat == 3 -> if { unit() } else { unit() }
        -> acceptUnit -> println
}

main {
    Product { target: Target { objectFormat: 3 } } -> run
    Product { target: Target { objectFormat: 1 } } -> run
}
