struct Input { values: [Int; ~] }
struct Output { values: [Int; ~], status: Int }

restore words: ref [UInt64; ~], first: ref Input, second: ref Input -> Output {
    [Int; ~] => values!
    first.values -> each value { values! -> push(value) }
    second.values -> each value { values! -> push(value) }
    Output { values: values!, status: Int(words[1]) }
}

main {
    Input { values: [1, 2; ~] } => input
    [UInt64(1), 0; ~] => words!
    words![0] == 1 -> if { 255 => words![1] } else { 3 => words![1] }
    words! -> restore(input, input) => result
    result.status == 255 => valid
    valid -> println
    result.values -> len -> println
}
