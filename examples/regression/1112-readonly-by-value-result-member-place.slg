# A projected readonly borrow from a by-value call result must materialize the
# aggregate or use an existing address. It must not invent an owned local slot.
struct Record {
    values: [Int; ~]
}

make: -> Record => Record { values: [4, 6; ~] }

measure values: ref [Int; ~] -> Int => values -> len

main {
    make() => prepared
    prepared.values -> measure => length
    "length=$length" -> println
}
