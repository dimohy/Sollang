trait Reader {
    readInto: mut self, output: mut [UInt8; ~] -> Int
}
struct ByteReader {
    value: UInt8
}
impl Reader for ByteReader {
    readInto: mut self, output: mut [UInt8; ~] -> Int {
        output -> push(self.value)
        1
    }
}
read<T> reader: mut T, output: mut [UInt8; ~] -> Int where T: Reader {
    reader -> Reader.readInto(output)
}
main {
    ByteReader { value: 42 } => reader!
    [UInt8; ~] => bytes!
    reader! -> read(bytes!) => count
    count -> println
    bytes![0] -> println
}
