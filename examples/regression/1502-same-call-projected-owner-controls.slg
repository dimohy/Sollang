struct Owner { values: [Int; ~] }
struct Pair { left: Owner, right: Owner }

consumeBoth owner: move Owner, other: move Owner -> Int {
    (owner.values -> len) + (other.values -> len)
}
readBoth owner: Owner, other: Owner -> Int {
    (owner.values -> len) + (other.values -> len)
}
impl Pair {
    finish: move self -> Int { consumeBoth(self.left, self.right) }
    readTwice: self -> Int { readBoth(self.left, self.left) }
}
main {
    Pair { left: Owner { values: [7; ~] }, right: Owner { values: [8, 9; ~] } } => first
    first -> finish -> println
    Pair { left: Owner { values: [7; ~] }, right: Owner { values: [8, 9; ~] } } => second
    second -> readTwice -> println
}
