import sollang.compiler.ast as ast
import sollang.compiler.semantic.symbols as symbols

# Receiver metadata must survive scalar, collection, and multi-field mutation.
main {
    """
    struct EnvironmentChange {
        name: Text
    }

    struct Command {
        environmentChanges: [EnvironmentChange; ~]
        inheritsEnvironment: Bool
    }

    impl Command {
        public clearScalar: mut self -> Unit {
            false => self.inheritsEnvironment
        }

        public clearArray: mut self -> Unit {
            [EnvironmentChange; ~] => self.environmentChanges
        }

        public clearBoth: mut self -> Unit {
            [EnvironmentChange; ~] => self.environmentChanges
            false => self.inheritsEnvironment
        }
    }
    """ => source

    source -> ast.lower => nodes
    0 => methodCount!
    0 => methodReceiverCount!
    0 => memberAssignmentCount!
    0 => nodeIndex!
    nodes -> len => nodeCount
    nodeIndex! < nodeCount -> while {
        nodes[nodeIndex!] => node
        node.kind == 31 -> if {
            methodCount! + 1 => methodCount!
            node.secondaryToken >= 0 -> if { methodReceiverCount! + 1 => methodReceiverCount! }
        }
        node.kind == 54 -> if { memberAssignmentCount! + 1 => memberAssignmentCount! }
        nodeIndex! + 1 => nodeIndex!
    }
    "ast=$(methodCount!),$(methodReceiverCount!),$(memberAssignmentCount!)" -> println

    source -> symbols.collect => declarations
    0 => methodSymbolCount!
    0 => receiverSymbolCount!
    0 => declarationIndex!
    declarations -> len => declarationCount
    declarationIndex! < declarationCount -> while {
        declarations[declarationIndex!] => declaration
        declaration.kind == 31 -> if { methodSymbolCount! + 1 => methodSymbolCount! }
        declaration.kind == 35 -> if { receiverSymbolCount! + 1 => receiverSymbolCount! }
        declarationIndex! + 1 => declarationIndex!
    }
    "symbols=$(methodSymbolCount!),$(receiverSymbolCount!)" -> println
}
