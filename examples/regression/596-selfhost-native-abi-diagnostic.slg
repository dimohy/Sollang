import sollang.compiler.llvm.text as llvm

main {
    [
        """
        native fixture from "native_fixture" {
            length value: Text -> Int32 as "native_length"
        }

        main {
        }
        """; ~
    ] => sources
    sources -> llvm.emitChecked => diagnosticCount
    "diagnostics = $diagnosticCount" -> println
}
