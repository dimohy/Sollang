struct Holder {
    value: [UInt8; 32]
}

zeros: -> [UInt8; 32] => [0; 32]

produce: -> Result<[UInt8; 32], UInt64> {
    zeros() => value!
    7 => value![0]
    9 => value![31]
    Result<[UInt8; 32], UInt64>.Ok(value!)
}

main {
    Holder { value: [0; 32] } => holder!
    produce() -> when {
        Ok(value) { value => holder!.value }
        Err(error) {}
    }
    "fixed-result-field=$(holder!.value[0]),$(holder!.value[31])" -> println
}
