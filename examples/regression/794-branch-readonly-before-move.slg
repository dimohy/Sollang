# Readonly arms may inspect an affine input before one final source-ordered move arm.
length values: ref [Int; ~] -> Int => values -> len
consume values: move [Int; ~] -> Int => values -> len

main {
    [10, 20, 30; ~] => values
    values
    -> branch {
        observed: ref -> length
        consumed: move -> consume
    }
    => facts
    facts.observed => observed
    facts.consumed => consumed
    "observed=$observed, consumed=$consumed" -> println
}
