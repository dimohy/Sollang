struct Entry {
    value: Int
}

enabledEntries: -> [Entry; ~] {
    [Entry { value: 40 }; ~]
}

disabledEntries: -> [Entry; ~] {
    [Entry { value: 0 }; ~]
}

choose enabled: Bool -> Unit uses Console {
    enabled -> if {
        enabledEntries()
    } else {
        disabledEntries()
    } => entries
    entries[0].value + 2 -> println
}

main { true -> choose }
