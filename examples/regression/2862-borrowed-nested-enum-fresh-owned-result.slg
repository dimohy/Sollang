namespace specimen.metadata
import specimen.keys as keys
make source: ref [Int; ~] -> keys.Holder { keys.Holder { values: [7; ~] } }
fresh source: ref Option<Result<[Int; ~], keys.Error>> -> Result<keys.Holder, keys.Error> {
    source -> when {
        None { Result<keys.Holder, keys.Error>.Err(keys.Error.Invalid) }
        Some(captured) { captured -> when {
                Err(error) { Result<keys.Holder, keys.Error>.Err(error) }
                Ok(items) {
                    items -> make => value
                    Result<keys.Holder, keys.Error>.Ok(value)
                }
        } }
    }
}
main {
    Option<Result<[Int; ~], keys.Error>>.Some(Result<[Int; ~], keys.Error>.Ok([1, 2; ~])) => source
    source -> fresh -> when { Err(_) { 0 -> println } Ok(item) { item.values[0] -> println } }
    source -> when { None { 0 -> println } Some(captured) { captured -> when { Err(_) { 0 -> println } Ok(items) { items -> len -> println } } } }
    Option<Result<[Int; ~], keys.Error>>.Some(Result<[Int; ~], keys.Error>.Err(keys.Error.Invalid)) => failed
    failed -> fresh -> when { Err(_) { 0 -> println } Ok(item) { item.values[0] -> println } }
}
