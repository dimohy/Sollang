import sollang.compiler.ir.module_artifact_types as artifactTypes
import sollang.compiler.semantic.modules as modules

main {
    # The header declares records that do not fit in the supplied payload.
    [0, 0, 0, 0, 0, 50000, 0, 0, 0; ~]
        -> artifactTypes.decode([modules.ModuleIdentity; ~]) => decoded
    decoded.status == 1 and (decoded.types -> len) == 0 and (decoded.hashes -> len) == 0
        -> if { "rejected" } else { "unexpected decoding" } -> println
}
