import sollang.compiler.cli_format as cliFormat
import sollang.compiler.cli_language_server as cliLanguageServer
import sys.file as file
import sys.process as process
import sys.runtime as runtime

# Exercise the production CLI modules with input owned by the actual main.
main {
    process.arguments() => arguments
    (arguments -> len) == 1 -> if { process.exit(0) }
    arguments[1] == "language-server" -> if {
        (arguments -> len) != 2 -> if {
            "sollang: usage: sollang language-server" -> runtime.eprintln
            process.exit(1)
        }
        cliLanguageServer.newSession() => session!
        not session!.finished -> while {
            UIntSize(4096) -> file.readStandardInputChunk => chunk
            session! -> cliLanguageServer.accept(chunk)
        }
        process.exit(session!.exitCode)
    }
    arguments[1] == "format" -> if {
        cliFormat.run() -> when {
            Completed(exitCode) { process.exit(exitCode) }
            StandardInput {
                file.readStandardInput() => owner
                owner -> cliFormat.formatStandardInput => exitCode
                process.exit(exitCode)
            }
        }
    }
    process.exit(1)
}
