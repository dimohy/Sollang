left value: Int -> Int block item: Int -> Int {
    (value -> yield) + 1
}
right value: Int -> Int block item: Int -> Int {
    1 + (value -> yield)
}
negative value: Int -> Int block item: Int -> Int {
    -(value -> yield)
}
equal value: Int -> Bool block item: Int -> Int {
    (value -> yield) == 10
}
ordinary value: Int, offset: Int -> Int => value + offset
main {
    5 -> left item { item * 2 } -> println
    5 -> right item { item * 2 } -> println
    5 -> negative item { item * 2 } -> println
    5 -> equal item { item * 2 } -> println
    ordinary(2, 1) -> println
}
