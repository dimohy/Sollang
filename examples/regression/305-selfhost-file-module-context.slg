import sollang.compiler.semantic.context as context

main {
    [
        "examples/regression/52-multi-file-modules.slg",
        "examples/regression/sample/math.slg"; ~
    ] => paths
    paths -> context.prepareFiles => prepared
    "file context = $(prepared.package.sources -> len),$(prepared.modules -> len),$(prepared.package.tokens -> len)" -> println
}
