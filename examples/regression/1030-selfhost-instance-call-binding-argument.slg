struct Decoder {
    bias: UInt8
}

decodeByte decoder: Decoder, byte: UInt8 -> UInt8 {
    decoder.bias + byte
}

decode decoder: Decoder -> UInt8 {
    UInt8(8) => byte
    decoder.bias == 0 -> if { 0 -> return }
    decoder -> decodeByte(byte)
}

main {
    Decoder { bias: 4 } => decoder
    decoder -> decode => decoded
    decoded == 12 -> if { "binding-call=ok" -> println }
}
