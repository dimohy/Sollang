import sollang.compiler.source_style as sourceStyle

main {
    # The namespace boundary probe is real multiline source, not escaped text.
    """
    namespaceFake
    namespace sample.mod
    """ -> sourceStyle.moduleName => boundaryModule
    "module-boundary=$boundaryModule" -> println
    """
    namespace sample.mod
    main {
        aaaaaaaaaaaaaaaaaaaa == bbbbbbbbbbbbbbbbbbbbb -> if { }
        (ready and active) -> while { }
        (ready
            and active)
            -> if { }
        (ready
            and active) or ready
            -> unless { }
    }
    """ => source
    source -> sourceStyle.moduleName => module
    "module=$module" -> println
    source -> sourceStyle.analyze => notes
    notes -> each note {
        "note=$(note.code),$(note.line),$(note.column),$(note.conditionLength),$(note.role)" -> println
    }
}
