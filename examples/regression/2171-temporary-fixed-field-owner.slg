struct Holder {
    values: [UInt8; 8]
}

makeHolder: -> Holder => Holder { values: [7; 8] }

makeValues: -> [UInt8; 8] {
    makeHolder().values => values!
    9 => values![0]
    values!
}

first values: [UInt8] -> UInt8 => values[0]

main {
    makeValues() => returned
    "returned=$(returned[0]),borrowed=$(first(makeHolder().values))" -> println
}
