import sollang.compiler.ast as ast

main {
    [
    "value -> byte()",
    "value -> slice(UIntSize(1))",
    "value -> byte(UIntSize(1), UIntSize(2))",
    "value -> slice(UIntSize(0), UIntSize(1), UIntSize(1))"
    ] => expressions
    expressions -> each expression {
        expression -> println
        expression -> ast.lowerExpression => nodes
        0 => index!
        nodes -> each node {
            expression -> slice(node.start, node.length) => payload
            "$(index!): kind=$(node.kind), parent=$(node.parent), payload=$(payload)" -> println
            index! + 1 => index!
        }
    }
}
