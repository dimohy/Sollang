# A push inside a function must store the parameter value selected through a
# transparent value wrapper, not an undefined wrapper SSA name.
appendByte output: mut [UInt8; ~], byte: UInt8 -> Unit {
    output -> push(byte)
}

main {
    [UInt8; ~] => output!
    appendByte(output!, 42)
    Int(output![0]) -> println
}
