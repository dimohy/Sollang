import sollang.compiler.cli_format as cliFormat
import sys.file as file

main {
    """"
    main {
    true -> if {
    """
    raw
    """ -> println
    }
    true -> if {
    """first
      second
    third""" -> println
    }
    true -> if {
    (value == 1 and value < 2 and value >= 0 and value != 3) -> if {
    "long" -> println
    }
    }
    1 => aaaaaaaaaaaaaaaaaaaa
    1 => bbbbbbbbbbbbbbbbbbbb
    (aaaaaaaaaaaaaaaaaaaa == bbbbbbbbbbbbbbbbbbbb) -> if {
    "short" -> println
    }
    (ready
    and active)
    -> unless {
    "multiline" -> println
    }
    }
    """" => unformatted
    unformatted -> file.borrowText => source
    source -> cliFormat.format => result
    "status=$(result.status)" -> println
    result.bytes -> file.borrowBytes => formatted
    formatted -> slice(UIntSize(0), formatted -> len) -> print
}
