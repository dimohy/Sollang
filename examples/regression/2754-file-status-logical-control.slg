import sys.file as file
import sys.process as process

claimAndRemove path: Text -> Bool uses File {
    (path -> file.createExclusive) == 1 and (path -> file.removePath) == 1
}

main {
    process.arguments() => arguments
    Arena(0) => storage!
    "$(arguments[0]).claim" -> materialize(storage!) => path
    (path -> file.createExclusive) == 1 -> println
    (path -> file.removePath) == 1 -> println
    path -> claimAndRemove -> println
    (false and (path -> file.createExclusive) == 1) -> println
    (path -> file.createExclusive) == 1 -> println
    (path -> file.removePath) == 1 -> println
    0 => count!
    count! < 2 and (path -> file.createExclusive) == 1
        -> while {
        (path -> file.removePath) == 1 -> println
        count! + 1 => count!
    }
    count! -> println
    (path -> file.createExclusive) == 1 -> println
    (path -> file.removePath) == 1 -> println
}
