import sollang.compiler.llvm.text as llvm

# A call argument wrapped by flow syntax resolves to its concrete index-access
# producer. The load must dominate the call that consumes the selected Text.
main {
    [
        """
        echoText value: Text -> Text {
            value
        }

        showLast values: [Text; ~] -> Text {
            values[(values -> len) - 1] -> echoText
        }

        main {
            ["first", "last"; ~] -> showLast -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
