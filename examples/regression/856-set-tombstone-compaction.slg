main {
    Set<Int>(4) => values!
    values! -> insert(1) => inserted1
    values! -> insert(2) => inserted2
    values! -> insert(3) => inserted3
    values! -> insert(4) => inserted4
    values! -> insert(5) => inserted5
    values! -> insert(6) => inserted6
    values! -> remove(1) => removed1
    values! -> remove(2) => removed2
    values! -> remove(3) => removed3
    values! -> remove(4) => removed4
    0 => total!
    values! -> each value {
        total! + value => total!
    }
    values! -> insert(1) => reinserted
    values! -> contains(1) => restored
    values! -> len => length
    values! -> capacity => capacity
    total! -> println
    reinserted -> if { "reinserted=true" -> println } else { "reinserted=false" -> println }
    restored -> if { "restored=true" -> println } else { "restored=false" -> println }
    "len=$length capacity=$capacity" -> println
}
