struct Pair { first: Int }

choose condition: Bool, left: ref Pair, right: ref Pair -> ref Pair {
    condition -> if { left -> return }
    right -> relay
}

relay value: ref Pair -> ref Pair { value }

main {
    Pair { first: 11 } => left!
    Pair { first: 21 } => right!
    choose(false, left!, right!) => borrowed
    borrowed.first -> println
    12 => left!.first
    22 => right!.first
    "left=$(left!.first),right=$(right!.first)" -> println
}
