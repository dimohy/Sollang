struct Span {
    start: UIntSize
}

struct Token {
    kind: Int
    span: Span
}

checksMutableNameSuffix expected: Int -> Bool {
    -1 => selectedToken!
    Token { kind: 7, span: Span { start: 1 } } => selectedToken
    selectedToken.span.start > 0 -> if { 0 => selectedToken! }
    selectedToken! >= 0 and selectedToken! != expected
}

main {
    1 -> checksMutableNameSuffix
        => checked
    "mutable-name-suffix-resolution=$(checked)" -> println
}
