struct Cursor {
    offset: Int
}

impl Cursor {
    public fill: mut self, output: mut [UInt8; ~] -> Int {
        0 => index!
        index! < (output -> len) -> while {
            7 => output[index!]
            index! + 1 => index!
        }
        self.offset + (output -> len) => self.offset
        output -> len
    }
}

# A post-loop member assignment emits every converted input before its use.
main {
    Cursor { offset: 0 } => cursor!
    [UInt8; ~] => output!
    output! -> push(0)
    output! -> push(0)
    cursor! -> fill(output!) => count
    "count=$count offset=$(cursor!.offset) bytes=$(output![0]),$(output![1])" -> println
}
