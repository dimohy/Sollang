inspectPrimary values: [UInt8], expected: Int -> Unit uses Console {
    values -> len => count
    count -> println
    count == expected -> if {
        values[count - 1] -> println
    } else {
        "missing-last" -> println
    }
}

inspectAdditional expected: Int, values: [UInt8] -> Unit uses Console {
    values -> inspectPrimary(expected)
}

main {
    [170; 131] -> inspectPrimary(131)
    64 -> inspectAdditional([170; 64])
}
