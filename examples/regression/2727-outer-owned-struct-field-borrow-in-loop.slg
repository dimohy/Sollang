struct Holder { values: [Int; ~] }

make value: Int -> Holder {
    [Int; ~] => values!
    values! -> push(value)
    Holder { values: values! }
}
read values: ref [Int; ~] -> Int => values[0]

show: -> Unit uses Console {
    7 -> make => outer
    0 => index!
    index! < 2 -> while {
        outer.values -> read -> println
        9 -> make => inner
        inner.values -> read -> println
        index! + 1 => index!
    }
}

main { show() }
