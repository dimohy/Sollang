value number: Int, offset: Int -> Result<Int, Int> => Result<Int, Int>.Ok(number + offset)

main {
    false => first!
    6 -> value(1) -> when {
        Err(_) { }
        Ok(number) {
            number -> value(0) -> when {
                Err(_) { }
                Ok(inner) { inner == 7 => first! }
            }
        }
    }
    false => second!
    6 -> value(1) -> when {
        Err(_) { }
        Ok(number) {
            number -> value(0) -> when {
                Err(_) { }
                Ok(inner) { inner == 7 => second! }
            }
        }
    }
    false => third!
    6 -> value(1) -> when {
        Err(_) { }
        Ok(number) {
            number -> value(0) -> when {
                Err(_) { }
                Ok(inner) { inner == 7 => third! }
            }
        }
    }
    "match-effect=$(first!):$(second!):$(third!)" -> println
}
