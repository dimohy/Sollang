import sollang.compiler.llvm.text as llvm

main {
    [
    """
    make: -> {UInt16: Int64} => {UInt16(1): Int64(9), UInt16(2): Int64(5)}

    lookup values: {UInt16: Int64} -> Int64 => values[UInt16(1)]

    main {
        make() -> lookup => value
        "value = $value" -> println
    }
    """; ~
    ] => sources!
    sources! -> llvm.emit
}
