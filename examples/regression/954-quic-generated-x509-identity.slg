import sys.crypto.ed25519
import sys.quic.x509_ed25519 as x509
import sys.quic.x509_identity as identity

seed: -> [UInt8; 32] => [
    157, 97, 177, 157, 239, 253, 90, 96,
    186, 132, 74, 244, 146, 236, 44, 196,
    68, 73, 197, 105, 123, 50, 105, 25,
    112, 59, 172, 3, 28, 174, 127, 96
]

main {
    identity.certificate(seed()) -> when {
        Ok(certificate) {
            ed25519.publicKey(seed()) -> when {
                Ok(expectedKey) {
                    x509.parsePinnedServer(certificate, certificate, [
                        115, 111, 108, 108, 97, 110, 103, 45, 112, 101, 101, 114
                    ]) -> when {
                        Ok(actualKey) {
                            (actualKey[0] == expectedKey[0]
                                and actualKey[31] == expectedKey[31]
                                and (certificate -> len) == 284) -> if {
                                "generated x509 identity ok" -> println
                            } else { "generated x509 identity failed" -> println }
                        }
                        Err(parseError) { "generated x509 parse error=$(parseError.code)" -> println }
                    }
                }
                Err(keyError) { "generated x509 key error" -> println }
            }
        }
        Err(certificateError) { "generated x509 certificate error=$(certificateError.code)" -> println }
    }
}
