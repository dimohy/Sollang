struct Holder {
    values: [UInt8; 8]
}

consume value: move Holder, early: Bool -> UInt8 {
    early -> if { value.values[0] -> return }
    value.values[1]
}

main {
    consume(Holder { values: [7; 8] }, true) => early
    consume(Holder { values: [9; 8] }, false) => normal
    "early=$early,normal=$normal" -> println
}
