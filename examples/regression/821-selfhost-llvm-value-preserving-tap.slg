import sollang.compiler.llvm.text as llvm

# Tap executes its side call first and then forwards the original value.
main {
    [
        """
        audit value: Int -> Unit uses Console { value -> println }
        double value: Int -> Int => value * 2
        main {
            7 -> tap audit -> double => result
            result -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
