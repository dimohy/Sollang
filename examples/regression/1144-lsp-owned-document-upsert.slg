struct Document {
    uri: [UInt8; ~]
    text: [UInt8; ~]
}

upsert documents: mut [Document; ~], uri: move [UInt8; ~], text: move [UInt8; ~] -> Int {
    documents -> len => index
    documents -> push(Document { uri: uri, text: text })
    index
}

main {
    [Document; ~] => documents!
    [UInt8(1), 2, 3; ~] => uri
    [UInt8(4), 5, 6, 7; ~] => text
    documents! -> upsert(uri, text) => index
    "$(documents![index].uri -> len),$(documents![index].text -> len)" -> println
}
