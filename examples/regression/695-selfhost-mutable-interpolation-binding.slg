import sollang.compiler.ast as ast
import sollang.compiler.ir.interpolation as interpolation
import sollang.compiler.semantic.symbols as symbols

# Mutable declarations and ordinary declarations are one lexical binding
# family. Interpolation must resolve both through the same symbol invariant.
main {
    """
    main {
        0 => failures!
        "test result: $(2 - failures!) passed; $(failures!) failed" -> println
        "" => projectDirectory!
        true -> if {
            "project" => projectDirectory!
            "$(projectDirectory!)/tests" -> println
        }
    }
    """ => source
    source -> ast.lower => syntaxNodes
    syntaxNodes -> symbols.collectPrepared => symbolTable
    source -> interpolation.lower => nodes
    0 => mutableNames!
    0 => resolvedNames!
    0 => storageNames!
    nodes -> each node {
        node.kind == 1 -> if {
            mutableNames! + 1 => mutableNames!
            node.symbol >= 0 -> if {
                resolvedNames! + 1 => resolvedNames!
                symbolTable[node.symbol].kind == 9 -> if {
                    storageNames! + 1 => storageNames!
                }
            }
        }
    }
    "mutable interpolation = $(mutableNames!),$(resolvedNames!)" -> println
    "mutable interpolation storage = $(storageNames!)" -> println
}
