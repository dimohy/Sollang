enum Failure {
    Limit
}

appendChecked output: mut [UInt8; ~], byte: UInt8, maximum: Int -> Result<Int, Failure> {
    (output -> len) < maximum -> unless {
        Result<Int, Failure>.Err(Failure.Limit) -> return
    }
    output -> push(byte)
    Result<Int, Failure>.Ok(1)
}

main {
    [UInt8; ~] => output!
    appendChecked(output!, 65, 4) -> when {
        Err(_) { 0 -> println }
        Ok(_) { output![0] -> println }
    }
}
