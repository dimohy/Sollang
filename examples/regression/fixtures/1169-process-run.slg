import sys.process as process
import examples.qualified_method_tool as tool

main {
    process.Command {
        argv: ["tool"; ~]
        workingDirectoryValue: ""
        hasWorkingDirectory: false
        environmentChanges: [process.EnvironmentChange; ~]
        inheritsEnvironment: true
        standardInput: process.Input.Inherit
        standardOutput: process.Output.Inherit
        standardError: process.Output.Inherit
    } => command
    command -> run => result
}
