namespace audit.wrapper

import audit.leaf as leaf

public struct Hasher { inner: leaf.Hasher, marker: Int }

public create value: Int -> Hasher {
    Hasher { inner: leaf.create(value), marker: 7 }
}

impl Hasher {
    public finish: move self -> Int {
        self.inner => inner
        inner -> finish
    }
    public finishDirect: move self -> Int { self.inner -> finish }
}
