namespace examples.projected_binding_type

public struct Connection {
    public token: UInt32
}

public struct Session {
    public connection: Connection
}

public struct Endpoint {
    public token: UInt32
}

public struct Listener {
    public token: UInt32
}

impl Connection {
    public close: move self, code: UInt32 -> UInt32 => code
}

impl Endpoint {
    public close: move self, code: UInt32 -> UInt32 => code
}

impl Listener {
    public close: move self, code: UInt32 -> UInt32 => code
}
