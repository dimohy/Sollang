namespace sample.array_transform

public struct Item {
    public value: Int
}

public transform source: [Text; ~] -> [Item; ~] {
    [Item; ~] => items!
    0 => index!
    index! < (source -> len) -> while {
        items! -> push(Item { value: index! + 1 })
        index! + 1 => index!
    }
    items!
}
