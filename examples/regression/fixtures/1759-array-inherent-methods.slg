namespace regression.array_inherent_methods

public struct Marker {
    public value: UInt8
}

impl Marker {
    public read: self -> UInt8 => self.value
}

impl [UInt8] {
    public firstPlus: self, amount: UInt8 -> UInt8 => self[0] + amount
}

public localFirstPlus source: [UInt8], amount: UInt8 -> UInt8 => source -> firstPlus(amount)
