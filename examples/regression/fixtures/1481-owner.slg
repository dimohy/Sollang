namespace regression.early_return_owner
public struct Owner { public values: [Int; ~] }
impl Owner {
    public intoValues: move self -> [Int; ~] {
        self.values => values
        values
    }
}

public observe owner: ref Owner -> Int { owner.values -> len }
public takeValues marker: Int, owner: move Owner -> [Int; ~] {
    owner.values => values
    values
}
impl Owner {
    public intoObservedValues: move self -> [Int; ~] uses Console {
        "transfer" -> println
        self.values => values
        values
    }
}
