enum Failure {
    First(Int)
    Second(Int)
}

convert input: Result<Int, Failure> -> Result<Int, Int> {
    input -> when {
        Ok(value) { value -> Result<Int, Int>.Ok }
        Err(error) {
            error -> when {
                First(value) { value + 10 }
                Second(value) { value + 20 }
            } -> Result<Int, Int>.Err
        }
    }
}

show input: Result<Int, Int> -> Unit uses Console {
    input -> when {
        Ok(value) { "ok=$value" -> println }
        Err(value) { "error=$value" -> println }
    }
}

main {
    Result<Int, Failure>.Ok(3) -> convert -> show
    Result<Int, Failure>.Err(Failure.First(4)) -> convert -> show
    Result<Int, Failure>.Err(Failure.Second(5)) -> convert -> show
}
