namespace specimen.metadata
import specimen.keys as keys
make source: ref [Int; ~] -> keys.Holder { keys.Holder { values: [7; ~] } }
fresh source: ref Option<[Int; ~]> -> Result<keys.Holder, keys.Error> {
    source -> when {
        None { Result<keys.Holder, keys.Error>.Err(keys.Error.Invalid) }
        Some(items) {
            items -> make => value
            Result<keys.Holder, keys.Error>.Ok(value)
        }
    }
}
main {
    Option<[Int; ~]>.Some([1, 2; ~]) => source
    source -> fresh -> when { Err(_) { 0 -> println } Ok(item) { item.values[0] -> println } }
    source -> when { None { 0 -> println } Some(items) { items -> len -> println } }
    Option<[Int; ~]>.None => missing
    missing -> fresh -> when { Err(_) { 0 -> println } Ok(item) { item.values[0] -> println } }
}
