lower: -> Long uses Console {
    "lower" -> println
    -5
}

upper: -> Long uses Console {
    "upper" -> println
    -1
}

selectLiteral value: Long -> Int {
    value -> when {
        -5..-1 => 7
        else => 9
    }
}

selectComputed value: Long -> Int uses Console {
    value -> when {
        lower()..upper() => 7
        else => 9
    }
}

main {
    -3 -> selectLiteral -> println
    -3 -> selectComputed -> println
    0 -> selectComputed -> println
}
