enum Outer {
    Value(Inner)
}

enum Inner {
    Value(Mixed)
}

struct Mixed {
    tag: UInt8
    value: Bytes3
    tail: Int
}

struct Bytes3 {
    first: UInt8
    second: UInt8
    third: UInt8
}

struct Node {
    value: Int
    children: [Node; ~]
}

enum Tree {
    Leaf
    Child(box Tree)
}

main {
    Outer.Value(Inner.Value(Mixed { tag: 1, value: Bytes3 { first: 4, second: 5, third: 6 }, tail: 9 })) -> when {
        Value(inner) {
            inner -> when {
                Value(value) { value.tail -> println }
            }
        }
    }
}
