import sollang.compiler.ir.interpolation as interpolation

# Regression identity 734 keeps this topology check distinct from Typed IR 732.
main {
    """
    probe values: [Text; ~] -> Unit {
        "selected=$(values[(values -> len) - 1])" -> println
    }
    """ => source
    source -> interpolation.lower => nodes
    0 => roots!
    0 => indexes!
    0 => binaryThirdOperands!
    0 => index!
    index! < (nodes -> len) -> while {
        nodes[index!] => node
        node.parent < 0 -> if { roots! + 1 => roots! }
        node.kind == 7 -> if { indexes! + 1 => indexes! }
        (node.kind == 3 and node.operand2 >= 0) -> if { binaryThirdOperands! + 1 => binaryThirdOperands! }
        index! + 1 => index!
    }
    "roots=$(roots!),indexes=$(indexes!),binaryThirdOperands=$(binaryThirdOperands!)" -> println
}
