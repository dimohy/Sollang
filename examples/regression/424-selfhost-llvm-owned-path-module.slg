import sollang.compiler.llvm.text as llvm

main {
    [
    """
    import sys.path as path
    main {
        path.fromText("a/./b", path.Style.Posix) => source
        source -> normalizeConfined -> when {
            Ok(normalized) {
                normalized -> byteCount => length
                length == 3 -> if { "owned path module" -> println }
            }
            Err(message) { message -> println }
        }
    }
    """; ~
    ] => sources!
    sources! -> llvm.emit
}
