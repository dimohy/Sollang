import sollang.compiler.cli_project as cliProject
import sys.path as path

main {
    Arena(0) => manifestStorage!
    Arena(0) => rootStorage!
    Arena(0) => productNameStorage!
    "examples/regression/projects/272-project-manifest" -> cliProject.load("", manifestStorage!, rootStorage!, productNameStorage!) => input
    "examples/regression/projects/272-project-manifest/src/main.slg" -> path.fromText(path.nativeStyle()) -> absolute -> when {
        Ok(expectedRoot) {
            input.source == (expectedRoot -> pathText) => matchesRoot
            "cli project = $(input.status),root matches = $matchesRoot" -> println
        }
        Err(error) { "expected root failed: $error" -> println }
    }
}
