# A skipped consuming branch leaves both fixed-array elements owned by the callee.
struct Owner { values: [Int; ~] }
sink values: move [Owner; 2] -> Int { values -> len }
consume flag: Bool, values: move [Owner; 2] -> Int {
    flag -> if {
        values -> sink => count
        count -> return
    }
    2
}
main {
    [Owner { values: [7,; ~] }, Owner { values: [8, 9; ~] }] => values
    false -> consume(values) -> println
}
