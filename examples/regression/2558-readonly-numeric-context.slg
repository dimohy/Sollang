sum value: ref Int64 -> Int64 { value + 1 }
reverse value: ref Int64 -> Int64 { 1 + value }
equal value: ref Int64 -> Bool { value == 41 }
negate value: ref Int64 -> Int64 { -value }
choice value: ref Int64, flag: Bool -> Int64 { value + (flag -> if { 1 } else { 2 }) }
main {
    Int64(41) => value
    value -> sum -> println
    value -> reverse -> println
    value -> equal -> println
    value -> negate -> println
    value -> choice(true) -> println
    value -> choice(false) -> println
}
