import sys.crypto.sha512

empty: -> [UInt8] => []
abc: -> [UInt8] => [97, 98, 99]
longMessage: -> [UInt8] => [
    97, 98, 99, 100, 101, 102, 103, 104, 98, 99, 100, 101, 102, 103, 104, 105,
    99, 100, 101, 102, 103, 104, 105, 106, 100, 101, 102, 103, 104, 105, 106, 107,
    101, 102, 103, 104, 105, 106, 107, 108, 102, 103, 104, 105, 106, 107, 108, 109,
    103, 104, 105, 106, 107, 108, 109, 110, 104, 105, 106, 107, 108, 109, 110, 111,
    105, 106, 107, 108, 109, 110, 111, 112, 106, 107, 108, 109, 110, 111, 112, 113,
    107, 108, 109, 110, 111, 112, 113, 114, 108, 109, 110, 111, 112, 113, 114, 115,
    109, 110, 111, 112, 113, 114, 115, 116, 110, 111, 112, 113, 114, 115, 116, 117]

ed25519Seed: -> [UInt8] => [
    157, 97, 177, 157, 239, 253, 90, 96,
    186, 132, 74, 244, 146, 236, 44, 196,
    68, 73, 197, 105, 123, 50, 105, 25,
    112, 59, 172, 3, 28, 174, 127, 96]

matches actual: [UInt8], expected: [UInt8] -> Bool {
    (actual -> len) == (expected -> len) -> unless { false -> return }
    true => equal!
    0 => index!
    index! < (actual -> len) -> while {
        actual[index!] == expected[index!] -> unless { false => equal! }
        index! + 1 => index!
    }
    equal!
}

main {
    empty() -> sha512.digest => emptyDigest
    abc() -> sha512.digest => abcDigest
    longMessage() -> sha512.digest => longDigest
    ed25519Seed() -> sha512.digest => seedDigest
    emptyDigest -> matches([
        207, 131, 225, 53, 126, 239, 184, 189, 241, 84, 40, 80, 214, 109, 128, 7,
        214, 32, 228, 5, 11, 87, 21, 220, 131, 244, 169, 33, 211, 108, 233, 206,
        71, 208, 209, 60, 93, 133, 242, 176, 255, 131, 24, 210, 135, 126, 236, 47,
        99, 185, 49, 189, 71, 65, 122, 129, 165, 56, 50, 122, 249, 39, 218, 62]) => emptyOk
    abcDigest -> matches([
        221, 175, 53, 161, 147, 97, 122, 186, 204, 65, 115, 73, 174, 32, 65, 49,
        18, 230, 250, 78, 137, 169, 126, 162, 10, 158, 238, 230, 75, 85, 211, 154,
        33, 146, 153, 42, 39, 79, 193, 168, 54, 186, 60, 35, 163, 254, 235, 189,
        69, 77, 68, 35, 100, 60, 232, 14, 42, 154, 201, 79, 165, 76, 164, 159]) => abcOk
    longDigest -> matches([
        142, 149, 155, 117, 218, 227, 19, 218, 140, 244, 247, 40, 20, 252, 20, 63,
        143, 119, 121, 198, 235, 159, 127, 161, 114, 153, 174, 173, 182, 136, 144, 24,
        80, 29, 40, 158, 73, 0, 247, 228, 51, 27, 153, 222, 196, 181, 67, 58,
        199, 211, 41, 238, 182, 221, 38, 84, 94, 150, 229, 91, 135, 75, 233, 9]) => longOk
    seedDigest -> matches([
        53, 124, 131, 134, 79, 40, 51, 203, 66, 122, 46, 241, 192, 10, 1, 60,
        253, 255, 39, 104, 217, 128, 192, 163, 165, 32, 240, 6, 144, 77, 233, 15,
        155, 79, 10, 254, 40, 11, 116, 106, 119, 134, 132, 231, 84, 66, 80, 32,
        87, 183, 71, 58, 3, 240, 143, 150, 245, 163, 142, 146, 135, 224, 31, 143]) => seedOk
    emptyOk -> if { "true" } else { "false" } => emptyText
    abcOk -> if { "true" } else { "false" } => abcText
    longOk -> if { "true" } else { "false" } => longText
    seedOk -> if { "true" } else { "false" } => seedText
    "sha512=$emptyText,$abcText,$longText,$seedText,$(abcDigest[0]),$(abcDigest[63])" -> println
}
