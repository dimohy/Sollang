struct State {
    values: [Int; ~]
    enabled: Bool
}

impl State {
    public clearScalar: mut self -> Unit {
        false => self.enabled
    }

    public clearArray: mut self -> Unit {
        [Int; ~] => self.values
    }

    public clearBoth: mut self -> Unit {
        [Int; ~] => self.values
        false => self.enabled
    }
}

main {
    State { values: [1, 2; ~], enabled: true } => scalar!
    scalar! -> clearScalar
    "scalar=$(scalar!.enabled)" -> println

    State { values: [3, 4; ~], enabled: true } => array!
    array! -> clearArray
    array!.values -> len => arrayLength
    "array=$arrayLength" -> println

    State { values: [5, 6; ~], enabled: true } => both!
    both! -> clearBoth
    both!.values -> len => bothLength
    "both=$bothLength,$(both!.enabled)" -> println
}
