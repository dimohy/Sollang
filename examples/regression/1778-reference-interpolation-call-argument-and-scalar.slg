# An interpolated call forwards the readonly pointer ABI, while arithmetic
# reads the referenced scalar before using an integer operand.
struct Pair {
    first: Int
}

first pair: ref Pair -> ref Int {
    pair.first
}

readRef value: ref Int -> Int {
    value
}

main {
    Pair { first: 41 } => pair
    pair -> first => borrowed
    "ref=$(readRef(borrowed)),sum=$(borrowed + 1)" -> println
}
