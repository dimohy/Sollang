import sys.file as file

# Each call performs one bounded blocking read. The returned SourceText owns
# exactly that chunk and a zero-length chunk is the stable EOF signal.
main {
    UIntSize(3) -> file.readStandardInputChunk => first
    "first=$(first -> len):$(first -> slice(UIntSize(0), first -> len))" -> println
    UIntSize(3) -> file.readStandardInputChunk => second
    "second=$(second -> len):$(second -> slice(UIntSize(0), second -> len))" -> println
    UIntSize(3) -> file.readStandardInputChunk => tail
    "tail=$(tail -> len)" -> println
    UIntSize(3) -> file.readStandardInputChunk => eof
    "eof=$(eof -> len)" -> println
}
