struct Marker {
    value: UInt8
}

byteValue: -> UInt8 => 1

main {
    Marker {
        value: 1 -> when {
            == 1 { 7 }
            else { 9 }
        }
    } => marker
    (byteValue() == (1 -> when {
        == 1 { 1 }
        else { 0 }
    }) and marker.value == 7) -> if {
        "contextual-when-numeric=ok"
    } else {
        "contextual-when-numeric=failed"
    } -> println
}
