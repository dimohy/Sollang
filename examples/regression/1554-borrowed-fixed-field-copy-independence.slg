# Storing a borrowed fixed scalar value copies its storage independently.
struct Holder {
    bytes: [UInt8; 8]
}
store holders: mut [Holder; ~], bytes: [UInt8; 8] -> Unit {
    holders -> push(Holder { bytes: bytes })
}
make: -> [UInt8; 8] { [13; 8] }
main {
    [Holder; ~] => holders!
    make() => bytes!
    holders! -> store(bytes!)
    17 => bytes![0]
    holders![0].bytes[0] -> println
    bytes![0] -> println
}
