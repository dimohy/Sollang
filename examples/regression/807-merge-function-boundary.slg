# Cold-stream merge crosses a function boundary and keeps its fair request schedule.
import std.sequence

makeValues values: Range -> Stream<Int> {
    values -> defer
}

mergeValues left: move Stream<Int>, right: move Stream<Int> -> EventStream<Int> {
    (left, right) -> merge
}

main {
    1..3 -> makeValues => left
    10..12 -> makeValues => right
    left -> mergeValues(right) => merged
    merged -> each value {
        "$value" -> println
    }
}
