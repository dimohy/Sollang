import sollang.compiler.ast as ast
import sollang.compiler.ir.typed as typedIr

main {
    """
    make value: Int32 -> Result<Int32, Int32> {
        Result<Int32, Int32>.Ok(value)
    }

    propagate value: Int32 -> Result<Int32, Int32> {
        make(value)? => checked
        Result<Int32, Int32>.Ok(checked)
    }
    """ => source
    source -> ast.lower => nodes!
    0 => astIndex!
    astIndex! < (nodes! -> len) -> while {
        nodes![astIndex!] => node
        node.kind == 71 -> if {
            "result propagation AST = $(node.kind),$(node.parent),$(node.operatorKind)" -> println
        }
        astIndex! + 1 => astIndex!
    }

    [source; ~] => sources!
    sources! -> typedIr.lower => ir!
    0 => irIndex!
    irIndex! < (ir! -> len) -> while {
        ir![irIndex!] => node
        (node.kind == 30 or (node.kind == 17 and node.parent >= 0 and ir![node.parent].kind == 1)) -> if {
            "result propagation IR = $(node.kind),$(node.parent),$(node.typeId),$(node.typeOrigin),$(node.typeSymbol),$(node.operand0)" -> println
        }
        irIndex! + 1 => irIndex!
    }
}
