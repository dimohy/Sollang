struct Buffer {
    values: [Int; ~]
}

impl Buffer {
    takeAndReset: mut self -> [Int; ~] {
        self.values => values
        [Int; ~] => self.values
        values
    }
}

main {
    Buffer { values: [11, 22, 33; ~] } => buffer!
    buffer! -> takeAndReset => values
    "moved-field=$(values[0] == 11 and values[1] == 22 and values[2] == 33 and (buffer!.values -> len) == 0)" -> println
}
