import sollang.compiler.semantic.context as semanticContext
import sys.file as file

main {
    """
    namespace sample.tests

    test_selected: -> Bool => true
    test_unselected: -> Bool => true
    """ => testsSource
    """
    import sample.tests as tests

    main {
        tests.test_selected -> if {}
    }
    """ => harnessSource
    [file.SourceText; ~] => sources!
    sources! -> push(testsSource -> file.borrowText)
    sources! -> push(harnessSource -> file.borrowText)
    [0; ~] => sourceIndices!
    [0; ~] => symbolIndices!
    sources! -> semanticContext.prepareTestSources(sourceIndices!, symbolIndices!) => prepared!
    prepared!.package.ranges[0] => range
    prepared!.package.symbols[range.symbolStart] => selected
    prepared!.package.symbols[range.symbolStart + 1] => unselected
    ((selected.flags / 4) % 2) == 1 -> if { "selected=public" -> println } else { "selected=private" -> println }
    ((unselected.flags / 4) % 2) == 0 -> if { "unselected=private" -> println } else { "unselected=public" -> println }
}
