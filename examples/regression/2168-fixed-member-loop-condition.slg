struct Holder {
    values: [UInt8; 8]
}

inspectValue value: Holder -> Bool {
    0 => index!
    index! < 8 and value.values[index!] == 7 -> while {
        index! + 1 => index!
    }
    index! == 8
}

inspectReference value: ref Holder -> Bool {
    0 => index!
    index! < 8 and value.values[index!] == 7 -> while {
        index! + 1 => index!
    }
    index! == 8
}

main {
    Holder { values: [7; 8] } => holder
    "value=$(inspectValue(holder)),reference=$(inspectReference(holder))" -> println
}
