enum Mode {
    Persistent
    Close
}

# Immutable values declared before a match must dominate every nested
# short-circuit control edge that reads them. The emitter must not clone their
# initializer trees or invent control-local SSA names.
hasDiscontiguousTail mode: Mode -> Bool {
    9 - 4 => initial
    8 - 3 => received
    mode -> when {
        Persistent {
            initial > 0 and received > 0 -> if { true -> return }
        }
        Close { }
    }
    false
}

main {
    Mode.Persistent -> hasDiscontiguousTail => persistent
    Mode.Close -> hasDiscontiguousTail => close
    "nested-short-circuit-binding-dominance=$(persistent):$(close)" -> println
}
