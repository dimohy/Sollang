struct Owner { bytes: [UInt8; ~] }
struct Branch { first: Owner, second: Owner }
struct Tree { left: Branch, right: Branch }

consume value: move Owner -> Int => value.bytes -> len

main {
    Tree {
        left: Branch { first: Owner { bytes: [1; ~] }, second: Owner { bytes: [2, 3; ~] } }
        right: Branch { first: Owner { bytes: [4, 5, 6; ~] }, second: Owner { bytes: [7, 8, 9, 10; ~] } }
    } => tree
    tree.left.first => leftFirst
    tree.right.first => rightFirst
    tree.left.second => leftSecond
    tree.right.second => rightSecond
    leftFirst -> consume => a
    rightFirst -> consume => b
    leftSecond -> consume => c
    rightSecond -> consume => d
    "direct=$a,$b,$c,$d" -> println
}
