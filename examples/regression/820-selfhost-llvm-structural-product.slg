import sollang.compiler.llvm.text as llvm

# Structural products keep exact labels and lower to a canonical LLVM aggregate.
main {
    [
        """
        sum pair: (left: Int, right: Int) -> Int {
            pair.left + pair.right
        }

        consume packet: move (values: [Int; ~], total: Int) -> Int {
            packet.total
        }

        main {
            (left: 1, right: 2) => pair
            pair.left -> println
            pair -> sum -> println
            (values: [4, 5; ~], total: 9) -> consume -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
