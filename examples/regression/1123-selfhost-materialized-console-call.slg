import sollang.compiler.llvm.text as llvm

main {
    [
    """
    enum Outcome {
        Ok(Int)
        Err(Int)
    }

    reject code: Int -> Outcome => Outcome.Err(code)

    verify: -> Unit uses Console {
        true -> if {
            reject(1) -> when {
                Ok(value) { "unexpected" }
                Err(error) { "materialized-console" }
            } -> println
        }
    }

    main {
        verify()
    }
    """; ~
    ] => sources
    sources -> llvm.emit
}
