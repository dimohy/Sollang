struct Plan {
    status: Int
    values: [Int; ~]
}

collect nodes: mut [Int; ~], plans: ref [Plan; ~] -> [Int; ~] {
    nodes -> len => originalCount
    [Int; ~] => results!
    plans -> each plan {
        plan.status => status!
        -1 => value!
        [Int; ~] => body!
        status! == 0 -> if {
            plan.status < 0 or plan.status >= originalCount
                -> if { 2 => status! } else {
                    nodes[plan.status] != 0 -> if { 2 => status! }
                }
        }
        status! == 0 -> if {
            0 => index!
            index! < (plan.values -> len) and status! == 0
                -> while {
                    body! -> push(plan.values[index!])
                    index! + 1 => index!
                }
            status! == 0 -> if {
                0 => append!
                append! < (body! -> len) -> while {
                    nodes -> push(body![append!])
                    append! + 1 => append!
                }
                42 => value!
            }
        }
        results! -> push(value!)
    }
    results!
}

main {
    [Int; ~] => first!
    first! -> push(41)
    [Int; ~] => second!
    second! -> push(7)
    [Plan; ~] => plans!
    plans! -> push(Plan { status: 0, values: first! })
    plans! -> push(Plan { status: 1, values: second! })
    [Int; ~] => nodes!
    nodes! -> push(0)
    nodes! -> collect(plans!) => results
    results -> len -> println
    results -> each value { value -> println }
    nodes! -> each value { value -> println }
}
