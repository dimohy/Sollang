import fixture.result_instance as counters

# Imported Result factories preserve the concrete instance receiver type.
readCreated value: Int -> Result<Int, Int> {
    counters.create(value)? => counter!
    counter! -> increment => result
    Result<Int, Int>.Ok(result)
}

main {
    readCreated(43) -> when {
        Ok(value) { "imported-mut-method=$value" -> println }
        Err(error) { "unexpected=$error" -> println }
    }
}
