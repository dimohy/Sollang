# Structured parallel callbacks may share a readonly reference and pass the
# same pointer to every worker without copying the referenced value.
struct Offset {
    value: Int
}

addOffset value: Int, offset: ref Offset -> Int {
    value + offset.value
}

main {
    Offset { value: 10 } => offset
    [1, 2, 3, 4; ~] -> parallel value {
        value -> addOffset(offset)
    } => shifted

    shifted -> each value {
        "$value" -> println
    }
}
