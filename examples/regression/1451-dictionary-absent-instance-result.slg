insertKey values: mut {UInt64: Int}, key: UInt64, value: Int -> Bool {
    values -> putIfAbsent(key, value)
}

main {
    {UInt64: Int; 1~} => values!
    UInt64(4294967297) => firstKey
    UInt64(8589934593) => secondKey
    values! -> insertKey(firstKey, -1) => first
    values! -> insertKey(firstKey, 99) => duplicate
    values! -> insertKey(secondKey, 20) => second
    "first=$first,duplicate=$duplicate,second=$second" -> println
    "count=$(values! -> len),retained=$(values![firstKey]),added=$(values![secondKey])" -> println
    {Int: Int; <=1} => bounded!
    bounded! -> putIfAbsent(7, 70) => boundedFirst
    bounded! -> putIfAbsent(7, 99) => boundedDuplicate
    "bounded=$boundedFirst,duplicate=$boundedDuplicate,value=$(bounded![7])" -> println
}
