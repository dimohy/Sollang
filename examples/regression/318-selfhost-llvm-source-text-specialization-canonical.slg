import sollang.compiler.llvm.text as llvm

main {
    [
    """
    import sys.file as file
    scan inputs: move [file.SourceText; ~] -> UIntSize {
        inputs => pending!
        [file.SourceText; ~] => owners!
        (pending! -> len) > 0 -> while {
            pending! -> take(0) => owner
            owners! -> push(owner)
        }
        UIntSize(0) => total!
        0 => index!
        index! < (owners! -> len) -> while {
            owners![index!] -> len => sourceLength
            total! + sourceLength => total!
            index! + 1 => index!
        }
        total!
    }
    main {
        [file.borrowText("one"), file.borrowText("four"); ~] -> scan -> println
    }
    """; ~
    ] => sources!
    sources! -> llvm.emit
}
