import sollang.compiler.ir.typed as typedIr

# A late compiler-provided writeAt producer, not its operandless syntax
# wrapper, is the subject of the following Result match.
main {
    """"
        namespace sys.file

        public struct FileWriter {
            public token: UInt64
        }

        public openWrite path: Text -> Result<FileWriter, Text> uses File = intrinsic
    """" => fileSource
    """"
        namespace sample

        import sys.file as file

        mix hash: UInt64, value: UInt64 -> UInt64 => hash + value

        main {
            UInt64(3) -> mix(UInt64(4)) => mixed
            "probe.tmp" -> file.openWrite -> when {
                Ok(writer) {
                    writer -> writeAt<UInt8>(UInt8(1), UInt64(0)) -> when {
                        Ok(_) {}
                        Err(_) {}
                    }
                }
                Err(_) {}
            }
        }
    """" => sampleSource
    [fileSource, sampleSource; ~] -> typedIr.lower => ir
    0 => writeMatches!
    0 => linkedSubjects!
    0 => resolvedLocalFlows!
    -1 => writeProducerIndex!
    -1 => writeMatchIndex!
    0 => nodeIndex!
    ir -> each node {
        node.kind == 6 and node.targetModule == 1 and node.symbol >= 0
            -> if { resolvedLocalFlows! + 1 => resolvedLocalFlows! }
        node.opcode == -221 -> if {
            nodeIndex! => writeProducerIndex!
            node.nextOperand => writeMatchIndex!
        }
        node.kind == 27 and node.operand0 == writeProducerIndex!
            -> if {
            writeMatches! + 1 => writeMatches!
            writeMatchIndex! == nodeIndex! -> if {
                linkedSubjects! + 1 => linkedSubjects!
            }
        }
        nodeIndex! + 1 => nodeIndex!
    }
    "file write matches=$(writeMatches!), linked subjects=$(linkedSubjects!), local flows=$(resolvedLocalFlows!)" -> println
}
