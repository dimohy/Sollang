import sollang.compiler.semantic.module_interfaces as interfaces

main {
    [
    "namespace identity.mmmmmmmmmmmmmmmmmmmmmmmm\npublic struct Entry { public value: Int }\n",
    "namespace identity.nkllmlnlmpnjnmnmmomooioj\npublic struct Entry { public value: Int }\n",
    "namespace identity . mmmmmmmmmmmmmmmmmmmmmmmm\npublic struct Entry { public value: Int }\n",
    "namespace identity.mmmmmmmmmmmmmmmmmmmmmmmm # name trivia\npublic struct Entry { public value: Int }\n"; ~
    ] => sources
    sources -> interfaces.interfaces => canonical
    interfaces.sameInterface(canonical, 0, canonical, 1) -> println
    interfaces.sameInterface(canonical, 0, canonical, 2) -> println
    interfaces.sameInterface(canonical, 0, canonical, 3) -> println
}
