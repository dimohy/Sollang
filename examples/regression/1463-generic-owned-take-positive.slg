struct Entry { values: [Int; ~] }
struct Algorithms { }
impl Algorithms {
    extract<T>: self, values: mut [T; ~], index: Int -> T {
        values -> take(index)
    }
}
main {
    [Entry { values: [11, 12; ~] }, Entry { values: [21, 22; ~] }; ~] => entries!
    Algorithms { } => algorithms
    algorithms -> extract(entries!, 0) => first
    first.values[0] -> println
    first.values[1] -> println
    entries! -> len -> println
    entries![0].values[0] -> println
}
