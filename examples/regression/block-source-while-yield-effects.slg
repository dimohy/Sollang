struct Counter {
    public value: Int
}
bump counter: mut Counter -> Int {
    counter.value + 1 => counter.value
    counter.value
}
run value: Int -> Unit uses Console block item: Int -> Bool {
    value -> yield -> while { "body" -> println }
}
main {
    Counter { value: 0 } => counter!
    5 -> run item {
        counter! -> bump => next
        next -> println
        next < 3
    }
    counter!.value -> println
}
