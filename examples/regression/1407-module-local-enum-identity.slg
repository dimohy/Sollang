# Local enum owners beat unrelated same-name types; local values still shadow them.
import regression.enum_scope as scope

enum Error {
    Foreign
}

main {
    scope.empty() -> when {
        Failed { "local=empty" -> println }
        Present(value) { "unexpected=$value" -> println }
    }
    scope.payload(7) -> when {
        Failed { "unexpected=empty" -> println }
        Present(value) { "payload=$value" -> println }
    }
    scope.shadow(11) => shadowed
    "shadow=$shadowed" -> println
    scope.matched() => matched
    "match=$matched" -> println
}
