struct Inner {
    values: [UInt8; 8]
}

struct Outer {
    inner: Inner
}

setFirst values: mut [UInt8; 8] -> Unit {
    9 => values[0]
}

main {
    Outer { inner: Inner { values: [7; 8] } } => original!
    original! => copied
    original!.inner.values -> setFirst
    0 => index!
    0 => total!
    index! < 3 -> while {
        total! + Int(copied.inner.values[0]) => total!
        index! + 1 => index!
    }
    "total=$(total!),original=$(original!.inner.values[0])" -> println
}
