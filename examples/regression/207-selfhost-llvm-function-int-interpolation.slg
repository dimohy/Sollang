import sollang.compiler.llvm.text as llvm

main {
    [
        """
report seed: Int -> Unit uses Console {
    nested value: Int, offset: Int, enabled: Bool, owner: Int -> Unit uses Console {
        value + 1 => next
        "$value->$next->$owner->$value" -> println
    }
    nested(seed, 3, true, 42)
}

main {
    report(-7)
}
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
