import sollang.compiler.ir.interpolation as interpolation

main {
    """
    main {
        [Int; ~] => program!
        program! -> push(1)
        "count=$(program! -> len)" -> println
    }
    """ => source
    source -> interpolation.lower => nodes
    nodes -> each node {
        source -> slice(node.payloadStart, node.payloadLength) => payload
        "kind=$(node.kind),symbol=$(node.symbol),owner=$(node.ownerSymbol),payload=$payload" -> println
    }
}
