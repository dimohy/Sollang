# A direct flow applies the declared element type before default Int inference.
signed values: [Int64] -> Unit uses Console {
    values[0] -> println
    values[1] -> println
}

unsigned values: [UInt64] -> Unit uses Console {
    values[0] -> println
}

main {
    [-9223372036854775808, 9223372036854775807] -> signed
    [18446744073709551615; 2] -> unsigned
}
