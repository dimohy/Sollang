struct Owned {
    tag: Int
    value: box Int
}

verifyOwned values: [Owned; <=2] -> Unit uses Console {
    count input: ref [Owned; <=2] -> Int {
        input -> len
    }
    first input: ref [Owned; <=2] -> Int {
        input[0].tag
    }
    values -> parallel branch {
        size: ref -> count
        first: ref -> first
    } => result
    result.size -> println
    result.first -> println
}

verifyCopy values: [Int; <=3], offsets: [Int; <=2] -> Unit uses Console {
    make input: ref [Int; <=3], extra: [Int; <=2] -> [Int; <=3] {
        [input[0] + extra[0]; <=3]
    }
    copy input: ref [Int; <=3] -> [Int; <=3] {
        [input[0] + 0; <=3]
    }
    values -> parallel branch {
        first: ref -> make(offsets) -> copy
        second: ref -> make(offsets)
    } => result
    result.first => firstResult
    result.second => secondResult
    firstResult[0] -> println
    secondResult[0] -> println
}

main {
    [Owned { tag: 7, value: box 9 }; <=2] => owned
    owned -> verifyOwned
    [1, 2; <=3] => values
    [10; <=2] => offsets
    values -> verifyCopy(offsets)
}
