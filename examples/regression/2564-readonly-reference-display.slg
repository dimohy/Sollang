sameInt value: ref Int -> ref Int { value }
sameByte value: ref UInt8 -> ref UInt8 { value }
sameLong value: ref Long -> ref Long { value }
sameBool value: ref Bool -> ref Bool { value }
sameText value: ref Text -> ref Text { value }

showInt value: ref Int -> Unit uses Console {
    value -> println
}

main {
    42 => number
    UInt8(255) => small
    Long(5000000000) => wide
    true => flag
    "hello" => text
    number -> sameInt => borrowedNumber
    small -> sameByte => borrowedSmall
    wide -> sameLong => borrowedWide
    flag -> sameBool => borrowedFlag
    text -> sameText => borrowedText
    borrowedNumber -> println
    borrowedSmall -> println
    borrowedWide -> println
    borrowedFlag -> println
    borrowedText -> println
    number -> showInt
}
