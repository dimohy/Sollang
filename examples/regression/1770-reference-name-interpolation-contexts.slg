# Direct-name interpolation follows the same reference value rule as $(name).
struct Pair {
    first: Int
    second: Int
}

first pair: ref Pair -> ref Int {
    pair.first
}

show pair: ref Pair -> Unit uses Console {
    pair -> first => borrowed
    "function=$borrowed" -> println
    true -> if {
        "control=$borrowed" -> println
    }
}

main {
    Pair { first: 41, second: 1 } => pair
    pair -> first => borrowed
    "entry=$borrowed" -> println
    pair -> show
}
