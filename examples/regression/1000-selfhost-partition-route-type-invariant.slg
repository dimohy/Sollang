import sollang.compiler.ir.stream as streamIr
import sollang.compiler.ir.typed as typedIr
import sollang.compiler.llvm.emitter.context as emitterContext
import sollang.compiler.llvm.text as llvm
import sollang.compiler.semantic.library_imports as libraryImports
import sollang.compiler.semantic.type_ids as typeIds

# S045 rejects a partition product that captured a provisional Range instead
# of preserving the canonical Stream source wrapper on every route.
main {
    [
        typedIr.TypedIrNode { kind: 5, parent: 1, sourceModule: 0, astNode: 0, symbol: -1, targetModule: -1, typeOrigin: 4, typeModule: -1, typeSymbol: 3, typeId: 1, typeKind: 7, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: -1, flags: 0 },
        typedIr.TypedIrNode { kind: 40, parent: -1, sourceModule: 0, astNode: 1, symbol: -1, targetModule: -1, typeOrigin: -1, typeModule: -1, typeSymbol: -1, typeId: 2, typeKind: 10, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: 0, operand1: -1, nextOperand: -1, flags: 0 }; ~
    ] => ir
    [
        typeIds.SemanticType { kind: 1, origin: 1, module: -1, symbol: 25, first: -1, second: -1, length: -1, lengthHash: 0, containsParameter: false, status: 0 },
        typeIds.SemanticType { kind: 7, origin: 4, module: -1, symbol: 3, first: 0, second: -1, length: -1, lengthHash: 0, containsParameter: false, status: 0 },
        typeIds.SemanticType { kind: 10, origin: -1, module: -1, symbol: -1, first: -1, second: -1, length: 2, lengthHash: 0, containsParameter: false, status: 0 }; ~
    ] => types
    [
        typeIds.NominalField { ownerType: 2, sourceModule: 0, ownerSymbol: -1, fieldSymbol: -1, labelToken: -1, ordinal: 0, fieldType: 0, status: 0 },
        typeIds.NominalField { ownerType: 2, sourceModule: 0, ownerSymbol: -1, fieldSymbol: -1, labelToken: -1, ordinal: 1, fieldType: 0, status: 0 }; ~
    ] => fields
    emitterContext.EmitContext {
        sources: []
        ranges: []
        nodes: []
        tokens: []
        symbols: []
        calls: []
        libraries: libraryImports.LibraryCatalog { diagnosticCount: 0, bindings: [], sources: [], interfaces: [], runtimeLibraries: [] }
        libraryCalls: []
        libraryCallDiagnostics: []
        interpolationRanges: []
        interpolations: []
        ir: ir
        streamPlan: streamIr.StreamPlan { pipelines: [], stages: [], junctions: [], junctionInputs: [], partitionRoutes: [] }
        moves: []
        nominal: []
        composite: []
        modules: []
        imports: []
        resolvedImports: []
        types: types
        fields: fields
        typeSizes: []
        typeAligns: []
        typeLayoutStatuses: []
        typeTraits: []
        pointerBitWidth: 64
        supportsComputePool: false
        expectedPathStyle: 1
        usesConcurrentStreamJoins: false
        ownershipDiagnostics: []
    } => context
    [Int; ~] => functions!
    functions! -> push(-1)
    context -> llvm.irInvariantCode(1, functions!) => code
    "partition invariant = $code" -> println
}
