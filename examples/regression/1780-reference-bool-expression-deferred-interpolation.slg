# Boolean expression roots retain Bool formatting in both deferred Text paths.
struct State {
    ready: Bool
    number: Int
}

ready state: ref State -> ref Bool { state.ready }
number state: ref State -> ref Int { state.number }

show prefix: Text, value: Text -> Unit uses Console {
    prefix -> print
    value -> println
}

main {
    State { ready: true, number: -7 } => state
    state -> ready => borrowedReady
    state -> number => borrowedNumber
    true => plainReady
    Arena(0) => storage!

    "arena-logic=$(borrowedReady and true),comparison=$(borrowedNumber < 0),plain=$plainReady"
        -> materialize(storage!) => materialized
    materialized -> println

    "call:" -> show("logic=$(borrowedReady and false),comparison=$(borrowedNumber < 0),literal=$(false)")
}
