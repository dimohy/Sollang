# Distinct generic wrappers keep independent blockless-stage call identities.
import std.sequence
consume<T> marker: T -> Int uses Console {
    1..3 -> map index { marker } => values
    0 => count!
    values -> take(1) -> each value {
        value -> println
        count! + 1 => count!
    }
    count!
}
outer<T> marker: T -> Int uses Console { marker -> consume }
main {
    7 -> outer -> println
    "text" -> outer -> println
}
