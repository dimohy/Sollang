namespace examples.regression.async_two_ready_task_reverse_await

firstValue: -> async Int { 11 }

secondValue: -> async Int {
    yield
    22
}

public observe: -> async Unit uses Console {
    firstValue() => first
    secondValue() => second
    second -> await -> println
    first -> await -> println
}

main {
    examples.regression.async_two_ready_task_reverse_await.observe() => observation
    observation -> await
}
