import sys.quic.keys as keys

connectionId: -> [UInt8] => [131, 148, 200, 240, 62, 81, 87, 8]

main {
    keys.deriveInitial(keys.version2(), connectionId()) => initial
    (initial.clientSecret[0] == 20 and initial.clientSecret[31] == 123
        and initial.serverSecret[0] == 2 and initial.serverSecret[31] == 193
        and initial.clientKey[0] == 139 and initial.clientKey[15] == 93
        and initial.serverKey[0] == 130 and initial.serverKey[15] == 167
        and initial.clientIv[0] == 145 and initial.clientIv[11] == 159
        and initial.serverHeaderProtection[0] == 237 and initial.serverHeaderProtection[15] == 58) -> if {
        "quic-v2-keys=ok"
    } else { "quic-v2-keys=failed" } -> println
}
