import sollang.compiler.ir.typed as typedIr

main {
    [
        """
        native handleFixture from "handle_fixture" {
            handle Counter drop "counter_drop"
            create initial: Int32 -> handleFixture.Counter as "counter_create"
            add self: ref handleFixture.Counter, amount: Int32 -> Int32 as "counter_add"
        }

        main {
            handleFixture.create(40) => counter
            handleFixture.add(counter, 2)
        }
        """; ~
    ] => sources!
    sources! -> typedIr.lower => ir!
    0 => nodeIndex!
    nodeIndex! < (ir! -> len) -> while {
        ir![nodeIndex!] => node
        ((node.kind == 0 and node.flags / 128 % 2 == 1)
            or node.kind == 10
            or (node.kind == 6 and node.targetModule == 0)
            or (node.kind == 17 and node.typeKind == 9)) -> if {
            "native handle IR = $(nodeIndex!),$(node.kind),$(node.typeKind),$(node.typeId),$(node.typeModule),$(node.typeSymbol),$(node.flags),$(node.operand0),$(node.operand1)" -> println
        }
        nodeIndex! + 1 => nodeIndex!
    }
}
