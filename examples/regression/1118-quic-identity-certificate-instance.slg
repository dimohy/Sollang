import std.net.quic as quic

createCertificate: -> Result<Int, quic.QuicError> uses Random {
    quic.generateIdentity()? => identity
    identity -> certificate? => certificate
    Result<Int, quic.QuicError>.Ok(certificate -> len)
}

main {
    createCertificate() -> when {
        Ok(length) { "quic-certificate-positive=$(length > 0)" -> println }
        Err(error) { "quic-certificate-error=$(error.code)" -> println }
    }
}
