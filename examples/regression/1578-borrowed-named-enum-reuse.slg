struct Payload { values: [Int; ~] }
enum Owner {
    Empty
    First(Payload)
    Second(Payload)
}
empty: -> Owner { Owner.Empty }
one: -> Owner { Owner.First(Payload { values: [11; ~] }) }
two: -> Owner { Owner.Second(Payload { values: [13; ~] }) }
impl Owner {
    first: self -> Int {
        self -> when {
            Empty { 0 }
            First(payload) { payload.values[0] }
            Second(payload) { payload.values[0] }
        }
    }
}
main {
    two() => owner
    owner -> first -> println
    owner -> first -> println
}