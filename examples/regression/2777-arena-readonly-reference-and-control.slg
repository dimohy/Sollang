readByte memory: ref Arena, offset: UIntSize -> UInt8 {
    memory -> load(offset)
}
mutateByte memory: mut Arena -> Unit uses Console {
    memory -> alloc(5, 1) => offset
    memory -> store(offset, UInt8(77))
    memory -> load(offset) => byte
    byte -> println
    memory -> reset
}
main {
    Arena(1) => memory!
    true -> if {
        memory! -> alloc(2, 2) => offset
        memory! -> store(offset, UInt8(66))
        memory! -> load(offset) -> println
        memory! -> readByte(offset) -> println
        memory! -> reset
    }
    memory! -> mutateByte
    memory! -> used -> println
    memory! -> capacity -> println
}
