struct ScalarFrame {
    start: Int
    finish: Int
    data: [Int; ~]
}
struct ScalarOwner {
    frames: [ScalarFrame; ~]
}
sumScalarFields first: Int, second: Int -> Int => first + second
main {
    ScalarOwner {
        frames: [ScalarFrame {
            start: 2
            finish: 3
            data: [7,; ~]
        },; ~]
    } => owner
    owner.frames[0].start -> sumScalarFields(owner.frames[0].finish) => total
    "$total,$(owner.frames[0].data[0])" -> println
}
