# A readonly Bool reference formats as true or false in both deferred Text
# paths and both interpolation spellings.
struct State {
    ready: Bool
}

ready state: ref State -> ref Bool { state.ready }

show prefix: Text, value: Text -> Unit uses Console {
    prefix -> print
    value -> println
}

main {
    State { ready: true } => yes
    State { ready: false } => no
    yes -> ready => borrowedYes
    no -> ready => borrowedNo
    Arena(0) => storage!

    "arena-expression=$(borrowedYes),name=$borrowedNo"
        -> materialize(storage!) => materialized
    materialized -> println

    "call:" -> show("expression=$(borrowedNo),name=$borrowedYes")
}
