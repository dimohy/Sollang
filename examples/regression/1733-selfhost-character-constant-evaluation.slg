import sollang.compiler.ast as ast
import sollang.compiler.semantic.constant_expressions as expressions

evaluate source: Text -> Result<Long, expressions.Error> {
    source -> ast.lowerExpression => nodes
    source -> expressions.compile(nodes, 0, "")? => evaluator!
    evaluator! -> evaluate(0)
}

show source: Text -> Unit uses Console {
    source -> evaluate -> when {
        Ok(value) { value -> println }
        Err(_) { "error" -> println }
    }
}

main {
    "'a'" -> show
    """'\n'""" -> show
    "'한'" -> show
    "'😀'" -> show
    """'\''""" -> show
    """'\\'""" -> show
}
