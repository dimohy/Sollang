import sollang.compiler.ir.interpolation as interpolation

main {
    """
    struct Box {
        value: Int
    }

    inspect: -> Unit {
        Box { value: 7 } => box!
        "value=$(box!.value)" -> println
    }
    """ => source
    source -> interpolation.lower => nodes
    0 => index!
    index! < (nodes -> len) -> while {
        nodes[index!] => node
        node.kind == 1 -> if {
            source -> slice(node.payloadStart, node.payloadLength) => name
            "name=$name,symbol=$(node.symbol)" -> println
        }
        index! + 1 => index!
    }
}
