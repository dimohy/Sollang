import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.effects as effects
import sollang.compiler.semantic.diagnostics as diagnostics
import sollang.compiler.semantic.expression_type_ids as expressionTypeIds
import sollang.compiler.ir.typed as typedIr

verifyPrepared initialPrepared: move semanticContext.SemanticSnapshot, expected: Int -> Unit uses Console {
    initialPrepared -> expressionTypeIds.resolveCallContext => committed
    committed.prepared => prepared
    committed.types => resolved
    prepared -> typedIr.lowerResolvedContext(resolved) => ir
    [diagnostics.UnresolvedMutableNameDiagnostic; ~] => mutableNames
    prepared.package -> diagnostics.firstExpressionOperandDiagnostic(prepared, resolved, ir, mutableNames, 64) => result
    result.code == 32 -> if { result.operandTypeSymbol } else { 0 } => actual
    actual -> effects.declaredEffectName => name
    "effect=$actual name=$name expected=$expected code=$(result.code)" -> println
    result.code == 44 or result.code == 45 -> if {
        prepared.package.ranges[result.sourceModule] => range
        prepared.package.nodes[range.astStart + result.operandAst] => reference
        prepared.package.sources[result.sourceModule] -> slice(reference.start, reference.length) => declaredName
        "declaration=$declaredName" -> println
    }
}

verify sources: [Text; ~], expected: Int -> Unit uses Console {
    sources -> len => libraryStart
    [Text; ~] => loaded!
    sources -> each source { loaded! -> push(source) }
    # Retain canonical declarations and their explicit loader authority.
    # Alias visibility and Console effects must not come from ABI markers.
    loaded! -> push(
    """
    namespace sys.io
    public print value: Text -> Unit uses Console {}
    public println value: Text -> Unit uses Console {}
    public readInt prompt: Text -> Int uses Console => 1
    """)
    loaded! -> push(
    """
    namespace sys.random
    seed value: Int -> Unit uses Random {}
    below maxExclusive: Int -> Int uses Random => 1
    """)
    loaded! -> push(
    """
    namespace sys.file
    openIntWriter path: Text -> Int uses File => 1
    writeInt writer: Int, value: Int -> Unit uses File {}
    closeIntWriter writer: Int -> Unit uses File {}
    openIntReader path: Text -> Int uses File => 1
    closestInt reader: Int, value: Int -> Int uses File => 1
    closeIntReader reader: Int -> Unit uses File {}
    """)
    loaded! -> semanticContext.prepare => prepared!
    libraryStart => prepared!.standardLibrarySourceStart
    3 => prepared!.standardLibrarySourceCount
    prepared! -> freeze -> verifyPrepared(expected)
}

verifyRuntime sources: [Text; ~], expected: Int -> Unit uses Console {
    # These eight cases model a user source followed by a loaded ABI source.
    # Only the ABI source receives the loader's explicit authority.
    [Text; ~] => loaded!
    sources -> each source { loaded! -> push(source) }
    loaded! -> push(
    """
    namespace sys.io
    public println value: Text -> Unit uses Console {}
    """)
    loaded! -> semanticContext.prepare => prepared!
    1 => prepared!.standardLibrarySourceStart
    2 => prepared!.standardLibrarySourceCount
    prepared! -> freeze -> verifyPrepared(expected)
}

verifyUnknown sources: [Text; ~] -> Unit uses Console {
    sources -> semanticContext.prepare -> expressionTypeIds.resolveCallContext => committed
    committed.prepared.calls -> each call {
        "unknown status=$(call.status) symbol=$(call.functionSymbol)" -> println
    }
}

verifySourceAuthority count: Int -> Unit uses Console {
    ["namespace sys.runtime\npublic sample: -> Int => 1\n", "main {}\n"; ~] => sources
    sources -> semanticContext.prepareWithStandardLibrarySources(count)
        -> expressionTypeIds.resolveCallContext => serial
    sources -> semanticContext.prepareParallelWithStandardLibrarySources(count)
        -> expressionTypeIds.resolveCallContext => parallel
    "authority expected=$count serial=$(serial.prepared.standardLibrarySourceCount) parallel=$(parallel.prepared.standardLibrarySourceCount)" -> println
}

verifyTestSourceAuthority count: Int -> Unit uses Console {
    ["test_scope: -> Bool => true\n", "namespace sys.runtime\npublic sample: -> Int => 1\n", "main {}\n"; ~] => sources
    sources -> semanticContext.prepareTestsWithStandardLibrarySources([0; ~], [0; ~], 1, count)
        -> expressionTypeIds.resolveCallContext => committed
    committed.prepared => prepared
    prepared -> semanticContext.isStandardLibrarySource(-1) => before
    prepared -> semanticContext.isStandardLibrarySource(0) => user
    prepared -> semanticContext.isStandardLibrarySource(1) => library
    prepared -> semanticContext.isStandardLibrarySource(2) => harness
    "test authority count=$count before=$before user=$user library=$library harness=$harness" -> println
}

