import sollang.compiler.llvm.text as llvm

# A dynamic-array Result specialization returned from a function must lower
# through the self-host emitter as an enum constructor, not a member access.
main {
    [
        """
        dynamicError message: Text -> Result<[Int; ~], Text> {
            Result<[Int; ~], Text>.Err(message)
        }

        main {
            "dynamic" -> dynamicError -> when {
                Ok(value) => value -> len -> println
                Err(message) => message -> println
            }
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
