import sys.io
import std.net as net
import std.net.socket as socket

observe: -> Result<Bool, socket.SocketError> uses Network {
    socket.ListenOptions {
        endpoint: net.loopback(0) -> unified
        backlog: 4
        reuseAddress: true
    } -> listen? => listener

    listener -> setNonblocking(true)?
    listener -> accept -> when {
        Ok(unexpected) {
            unexpected -> close
            false
        }
        Err(error) => error.kind -> when {
            WouldBlock { true }
            else { false }
        }
    } => listenerWouldBlock
    listener -> setNonblocking(false)?

    listener -> localEndpoint? => endpoint
    endpoint -> connect? => client
    listener -> accept? => server
    client -> setNonblocking(true)?
    client -> setNonblocking(false)?
    server -> setNonblocking(true)?
    server -> setNonblocking(false)?

    socket.DatagramBindOptions {
        endpoint: net.loopback(0) -> unified
        reuseAddress: true
    } -> bind? => datagram
    datagram -> setNonblocking(true)?
    datagram -> setNonblocking(false)?

    datagram -> close
    client -> close
    server -> close
    listener -> close
    Result<Bool, socket.SocketError>.Ok(listenerWouldBlock)
}

main {
    observe() -> when {
        Ok(valid) { "socket-nonblocking=$valid" -> println }
        Err(error) { "socket-nonblocking-error=$(error.code)" -> println }
    }
}
