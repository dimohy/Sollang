import sys.file as file

# A control result keeps the SourceText view representation across the join.
select flag: Bool -> file.SourceText {
    flag -> if {
        "abc" -> file.borrowText
    } else {
        "de" -> file.borrowText
    }
}

main {
    true -> select => first
    first -> len -> println
    false -> select => second
    second -> len -> println
}
