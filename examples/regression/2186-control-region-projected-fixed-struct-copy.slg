struct Holder {
    values: [UInt8; 8]
}

struct Outer {
    inner: Holder
}

inspect source: ref Outer, selected: Bool -> UInt8 {
    selected -> if {
        source.inner => copied
        copied.values[0] -> return
    }
    0
}

main {
    Outer { inner: Holder { values: [7; 8] } } => original
    inspect(original, true) => first
    "first=$first,original=$(original.inner.values[0])" -> println
}
