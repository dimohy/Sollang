# Origin/liveness now permits a readonly reference to an owning aggregate.
# The owner remains live through both borrowed calls.
struct Values {
    items: [Int; ~]
}

count values: ref Values -> Int {
    values.items -> len
}

first values: ref Values -> ref Int {
    values.items[0]
}

main {
    [Int; ~] => items!
    items! -> push(10)
    items! -> push(20)
    items! -> push(30)
    Values { items: items! } => values!
    values! -> count => before
    values! -> first => firstValue
    "$firstValue" -> println
    values! -> count => after
    "$before,$after" -> println
}
