fresh source: ref Result<[Int; ~], Int> -> Result<[Int; ~], Int> {
    source -> when {
        Err(code) { Result<[Int; ~], Int>.Err(code) }
        Ok(items) { Result<[Int; ~], Int>.Ok([7; ~]) }
    }
}

main {
    Result<[Int; ~], Int>.Ok([1, 2; ~]) => source
    source -> fresh -> when {
        Err(code) { code -> println }
        Ok(items) { items[0] -> println }
    }
    source -> when {
        Err(code) { code -> println }
        Ok(items) { items -> len -> println }
    }
