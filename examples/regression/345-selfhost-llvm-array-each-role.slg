import sollang.compiler.llvm.text as llvm

# This lowering test intentionally keeps a dynamic owner; S003 is expected.
main {
    [
    """
    sum: -> Int {
        [1, 2; ~] => values
        0 => total!
        values -> each value {
            total! + value => total!
        }
        total!
    }

    main {
        sum() -> println
    }
    """; ~
    ] => sources!
    sources! -> llvm.emit
}
