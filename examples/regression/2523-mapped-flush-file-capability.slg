# A mapped-buffer flush consumes File authority inside an ordinary function.
# Keep the function uncalled so this capability check needs no filesystem I/O.
flushMapped: -> UIntSize uses File {
    map write "unused-mapped-flush-capability.bin" size 8 => data!
    data! -> flush
    data! -> len
}

main {
    "mapped flush capability = ready" -> println
}
