import sollang.compiler.llvm.text as llvm

# A bound owning struct returned from a nested control region transfers its
# storage to the caller. The return cleanup must not drop that same binding.
main {
    [
        """
        struct OwnedPath {
            bytes: [UInt8; ~]
        }

        struct Resolution {
            valid: Bool
            value: OwnedPath
        }

        resolve accepted: Bool -> Resolution {
            accepted -> if {
                OwnedPath { bytes: [UInt8(1), UInt8(2), UInt8(3); ~] } => path!
                Resolution { valid: true, value: path! } => result!
                result! -> return
            }
            OwnedPath { bytes: [UInt8; ~] } => empty!
            Resolution { valid: false, value: empty! }
        }

        main {
            true -> resolve => result!
            result!.value.bytes -> len -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
