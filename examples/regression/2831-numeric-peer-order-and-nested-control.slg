left: -> Long uses Console {
    "left" -> println
    10
}

right: -> Long uses Console {
    "right" -> println
    2
}

floating: -> Float64 uses Console {
    "floating" -> println
    2.0
}

main {
    1 - right() -> println
    3 * right() -> println
    1 + (right() + 1) -> println
    -1 + right() -> println
    1.0 < floating() -> println
    left() + right() -> println
    1 + 2 -> println
}
