# Inherent methods win over colliding imports in cloned generic calls.
import open_import.alpha as alpha
import open_import.beta as beta
struct First { value: Int }
struct Second { value: Int }
impl First { transform: self -> Int { self.value } }
impl Second { transform: self -> Int { self.value * 2 } }
apply<T> value: T -> Int { value -> transform }
main {
    First { value: 42 } -> apply -> println
    Second { value: 42 } -> apply -> println
    3 -> alpha.transform -> println
    3 -> beta.transform -> println
}
