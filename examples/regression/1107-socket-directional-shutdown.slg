import sys.io
import std.net as net
import std.net.socket as socket

struct HalfClose {
    requestCount: Int
    eofCount: Int
    responseCount: Int
    first: UInt32
    last: UInt32
}

runHalfClose bindEndpoint: net.Endpoint -> Result<HalfClose, socket.SocketError> uses Network {
    socket.ListenOptions {
        endpoint: bindEndpoint
        backlog: 4
        reuseAddress: true
    } -> listen? => listener
    listener -> localPort? => port
    net.loopback(port) -> unified => clientEndpoint
    clientEndpoint -> connect? => client
    listener -> accept? => server

    client -> sendText("ping")? => sent
    client -> shutdown(socket.ShutdownDirection.Send)?
    server -> receive(16)? => request
    server -> receive(16)? => eof
    server -> sendText("pong")? => responseSent
    client -> receive(16)? => response

    client -> close
    server -> close
    listener -> close
    Result<HalfClose, socket.SocketError>.Ok(HalfClose {
        requestCount: Int(request -> len)
        eofCount: Int(eof -> len)
        responseCount: Int(response -> len)
        first: UInt32(response[0])
        last: UInt32(response[3])
    })
}

main {
    net.loopback(0) -> unified -> runHalfClose -> when {
        Ok(value) {
            "half-close=$(value.requestCount),$(value.eofCount),$(value.responseCount),$(value.first),$(value.last)" -> println
        }
        Err(error) { "socket-error=$(error.code)" -> println }
    }
}
