struct Batch {
    values: [Int; ~]
}

total values: ref [Int; ~] -> Int {
    0 => sum!
    values -> each value { sum! + value => sum! }
    sum!
}

read batches: ref [Batch; ~] -> Int {
    0 => sum!
    batches -> each batch {
        batch.values -> total => value
        sum! + value => sum!
    }
    sum!
}

main {
    [Int; ~] => values!
    values! -> push(300)
    values! -> push(17)
    [Batch; ~] => batches!
    batches! -> push(Batch { values: values! })
    batches! -> read -> println
    batches! -> each batch {
        batch.values -> total -> println
    }
}
