struct Entry { words: [Int; ~] }
struct Lookup { values: ref {Text: Entry} }

borrowTable values: ref {Text: Entry} -> ref {Text: Entry} => values
size entry: ref Entry -> Int => entry.words -> len

impl Lookup {
    public count: self, key: Text -> Int => self.values[key] -> size
}

main {
    {Text: Entry; 2~} => table!
    table! -> put("one", Entry { words: [7, 8; ~] })
    Lookup { values: table! -> borrowTable } => lookup
    lookup -> count("one") -> println
    lookup.values["one"] -> size -> println
    table!["one"] -> size -> println
}
