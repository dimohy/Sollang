import sollang.compiler.ir.typed as typedIr

main {
    [
        """
        struct Packet {
            value: box Int
        }

        roundTrip packet: move Packet -> async Packet {
            packet
        }

        wrap packet: move Packet -> Result<Packet, Text> {
            Result<Packet, Text>.Ok(packet)
        }

        main {
            Packet { value: box 7 } => packet
            packet -> roundTrip => pending
            Packet { value: box 8 } => wrappedPacket
            wrappedPacket -> wrap => wrapped
        }
        """; ~
    ] => sources!
    sources! -> typedIr.lower => ir!
    ir! -> typedIr.movesFrom => moves!

    ir! -> each node {
        (node.kind == 6 and (node.flags / 8) % 2 == 1) -> if {
            "async move call flags=$(node.flags)" -> println
        }
    }
    "owned move events=$(moves! -> len)" -> println
}
