import sollang.compiler.llvm.text as llvm

main {
    [
        """
        spin: -> Unit uses Console {
            true -> while {
                "tick" -> println
            }
        }

        wait enabled: Bool -> Unit uses Console {
            enabled -> while {
                "waiting" -> println
            }
        }

        nested enabled: Bool -> Unit uses Console {
            enabled -> if {
                false -> while {
                    "wrong-nested" -> println
                }
            } else {
                "wrong-else" -> println
            }
        }

        main {
            nested(true)
            wait(false)
            false -> while {
                "wrong" -> println
            }
            "done" -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
