import sollang.compiler.diagnostics as diagnostics
import sys.file as file

main {
    """main { "ok" -> println }""" => sourceText
    [UInt8; ~] => bytes!
    UIntSize(0) => index!
    index! < (sourceText -> len) -> while {
        bytes! -> push(sourceText -> byte(index!))
        index! + 1 => index!
    }
    bytes! -> file.borrowBytes => source
    source -> slice(UIntSize(0), source -> len) => view
    view -> diagnostics.analyze => found
    "$(found -> len)" -> println
}
