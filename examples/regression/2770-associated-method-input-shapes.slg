struct Item { value: Int }

impl Item {
    public count: -> Int => 7
    public twice: Int -> Int => it + it
    public identity<T>: T -> T => it
    public read: self -> Int => self.value
}

main {
    Item.count() -> println
    Item.twice(3) -> println
    Item { value: 5 } -> read -> println
    Item.identity(9) -> println
}
