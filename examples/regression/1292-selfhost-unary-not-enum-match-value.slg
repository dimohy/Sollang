enum Choice {
    Keep
    Flip
}

choose choice: Choice, input: Bool -> Bool {
    choice -> when {
        Keep { input }
        Flip { not input }
    } => selected
    selected
}

main {
    choose(Choice.Keep, true) => kept
    choose(Choice.Flip, true) => flipped
    "unary-not-match=$(kept),$(flipped)" -> println
}
