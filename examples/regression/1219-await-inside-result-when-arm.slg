# Await inside a Result arm must keep its compiler intrinsic identity.
incrementAsync value: Int -> async Int {
    value + 1
}

produce: -> Result<Int, Text> {
    Result<Int, Text>.Ok(41)
}

main {
    produce() -> when {
        Ok(value) {
            value -> incrementAsync => task
            task -> await => result
            "awaited=$result" -> println
        }
        Err(message) { message -> println }
    }
}
