main {
    true => indexReady
    true => moreWorkRemaining
    false => skippedThisRound
    (indexReady and moreWorkRemaining and not skippedThisRound) -> if {
        "long-if" -> println
    }

    0 => index!
    true => stillScanningPrefix
    1 => remainingPrefixLength
    (stillScanningPrefix and index! < remainingPrefixLength) -> while {
        "long-while" -> println
        index! + 1 => index!
    }
}

