struct Failure {
    code: Int
}

struct Reading {
    value: Long
}

checkedDifference later: Long, earlier: Long -> Result<Reading, Failure> {
    later < earlier -> if {
        Failure { code: 1 } -> Result<Reading, Failure>.Err
    } else {
        earlier < 0 and later > 9_223_372_036_854_775_807 + earlier
            -> if {
                Failure { code: 2 } -> Result<Reading, Failure>.Err
            } else {
                Reading { value: later - earlier } -> Result<Reading, Failure>.Ok
            }
    }
}

main {
    checkedDifference(10, 3) -> when {
        Ok(reading) { "difference=$(reading.value)" -> println }
        Err(failure) { "failure=$(failure.code)" -> println }
    }
}
