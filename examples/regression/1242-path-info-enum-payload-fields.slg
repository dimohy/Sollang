import sys.path as path

main {
    "examples/regression/fixtures/425-directory-order/Alpha.txt" -> path.fromText(path.nativeStyle()) => sourcePath
    sourcePath -> query -> when {
        Ok(info) {
            info.byteLength == 6 and info.modifiedNanos > 0
                -> if { "path-info-enum-payload-fields=ok" } else { "path-info-enum-payload-fields=failed" } -> println
        }
        Err(_) { "path-info-enum-payload-fields=failed" -> println }
    }
}
