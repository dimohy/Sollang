sumRange: -> async Int {
    0 => total!
    1..2 -> each value {
        yield
        total! + value => total!
    }
    total!
}

sumRepeat: -> async Int {
    0 => total!
    2 -> repeat turn {
        yield
        total! + turn => total!
    }
    total!
}

main {
    sumRange() => rangeTask
    rangeTask -> await -> println
    sumRepeat() => repeatTask
    repeatTask -> await -> println
}
