makeFlags: -> BitSet<130> {
    BitSet<130>() => flags!
    flags! -> set(0)
    flags! -> set(64)
    flags! -> set(129)
    flags!
}

main {
    makeFlags() => flags!
    flags! -> contains(64) => middle
    flags! -> clear(64)
    flags! -> contains(64) => cleared
    flags! -> count => count
    flags! -> len => length
    middle -> if { "middle=true" -> println } else { "middle=false" -> println }
    cleared -> if { "cleared=true" -> println } else { "cleared=false" -> println }
    "count=$count len=$length" -> println
}
