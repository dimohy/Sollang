# Zip crosses a function boundary as one affine producer and preserves labeled output fields.
import std.sequence

makeValues values: Range -> Stream<Int> {
    values -> defer
}

zipValues left: move Stream<Int>, right: move Stream<Int> -> Stream<(left: Int, right: Int)> {
    (left: left, right: right) -> zip
}

main {
    1..3 -> makeValues => left
    10..14 -> makeValues => right
    left -> zipValues(right) => paired
    paired -> each pair {
        "$(pair.left)+$(pair.right)" -> println
    }
}
