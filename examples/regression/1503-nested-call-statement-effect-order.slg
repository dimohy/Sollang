first values: [Int] -> Int { values[0] }
mark value: Int -> Int uses Console {
    value -> println
    value
}
run: -> Unit uses Console {
    [1] -> first -> println
    [mark(2)] -> first -> println
}
main {
    # Pending array arguments must not let later nested effects run early.
    [1] -> first -> println
    [mark(2)] -> first -> println
    run()
    [1] -> first -> println
    [mark(2), mark(3)] -> first -> println
}
