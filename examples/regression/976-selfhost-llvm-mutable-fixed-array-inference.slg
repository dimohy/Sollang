import sollang.compiler.llvm.text as llvm

# A mutable binding changes fixed-array elements, not the array shape. The
# inferred [UInt64; 3] identity must survive typed IR lowering and LLVM slots.
main {
    [
        """
        replaceFirst seed: UInt64 -> UInt64 {
            [UInt64(11), 22, 33] => values!
            seed => values![0]
            values![0] + values![2]
        }

        main {
            9 -> replaceFirst -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
