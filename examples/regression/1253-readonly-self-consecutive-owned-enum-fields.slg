struct Values {
    items: [Int; ~]
}

enum Slot {
    Absent
    Present(Values)
}

struct Pair {
    first: Slot
    second: Slot
}

impl Pair {
    sum: self -> Int => self.first -> when {
        Absent { 0 }
        Present(first) => self.second -> when {
            Absent { first.items -> len }
            Present(second) { (first.items -> len) + (second.items -> len) }
        }
    }
}

main {
    Pair {
        first: Slot.Present(Values { items: [1, 2] })
        second: Slot.Present(Values { items: [3, 4, 5] })
    } -> sum => total
    "total=$total" -> println
}
