struct Inner {
    values: [UInt8; 8]
}

struct Outer {
    inner: Inner
}

setFirst values: mut [UInt8; 8] -> Unit {
    9 => values[0]
}

inspect: -> UInt8 {
    read: -> UInt8 {
        copied.inner.values[0]
    }

    Outer { inner: Inner { values: [7; 8] } } => original!
    original! => copied
    original!.inner.values -> setFirst

    read()
}

main {
    inspect() => first
    "first=$first" -> println
}
