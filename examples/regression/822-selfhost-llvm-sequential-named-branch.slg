import sollang.compiler.llvm.text as llvm

# Sequential branch arms share one input, run in source order, and form a labeled product.
main {
    [
        """
        double value: Int -> Int uses Console {
            "first" -> println
            value * 2
        }
        increment value: Int -> Int uses Console {
            "second" -> println
            value + 1
        }
        combine parts: (doubled: Int, incremented: Int) -> Int => parts.doubled + parts.incremented
        main {
            5 -> branch {
                doubled: -> double
                incremented: -> increment
            } -> combine => total
            total -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
