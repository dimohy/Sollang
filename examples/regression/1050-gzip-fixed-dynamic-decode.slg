import std.compress.gzip as gzip

matches left: [UInt8], right: [UInt8] -> Bool {
    (left -> len) == (right -> len) -> unless { false -> return }
    0 => index!
    index! < (left -> len) -> while {
        left[index!] == right[index!] -> unless { false -> return }
        index! + 1 => index!
    }
    true
}

fixedSource: -> [UInt8] => [
    104, 101, 108, 108, 111, 32, 104, 101, 108, 108, 111, 32,
    104, 101, 108, 108, 111, 32, 104, 101, 108, 108, 111]

fixedGzip: -> [UInt8] => [
    31, 139, 8, 0, 0, 0, 0, 0, 4, 10, 203, 72, 205, 201, 201, 87,
    200, 64, 39, 1, 227, 81, 61, 141, 23, 0, 0, 0]

dynamicSource: -> [UInt8] => [
    4, 29, 2, 17, 1, 5, 31, 4, 15, 10, 10, 11, 3, 22, 1, 4, 0, 5, 8, 25,
    8, 2, 5, 31, 1, 14, 8, 15, 7, 16, 11, 15, 25, 13, 2, 1, 27, 10, 3, 27,
    13, 18, 24, 5, 7, 24, 2, 19, 1, 16, 17, 28, 22, 11, 4, 3, 12, 11, 1, 25,
    11, 17, 4, 5, 0, 7, 5, 9, 8, 22, 24, 3, 8, 3, 15, 29, 4, 19, 6, 0,
    19, 7, 3, 9, 4, 8, 9, 9, 13, 6, 1, 1, 2, 11, 7, 21, 11, 17, 30, 1]

dynamicGzip: -> [UInt8] => [
    31, 139, 8, 0, 0, 0, 0, 0, 0, 10, 5, 193, 9, 14, 128, 32, 12, 0,
    48, 118, 185, 193, 68, 68, 34, 129, 120, 253, 255, 151, 182, 252, 96, 5,
    249, 184, 164, 228, 212, 129, 131, 216, 52, 148, 15, 54, 43, 186, 123, 153,
    25, 225, 74, 116, 229, 99, 136, 14, 108, 176, 215, 187, 59, 211, 234, 48,
    189, 178, 4, 149, 104, 125, 144, 81, 121, 184, 45, 161, 41, 69, 182, 24,
    243, 2, 128, 174, 167, 215, 23, 126, 119, 247, 214, 182, 100, 0, 0, 0]

run: -> Result<Unit, gzip.Error> uses Console {
    gzip.Limits { maxOutputBytes: 1_024, maxExpansionRatio: 64 } -> codec()? => codec
    codec -> decompress(fixedGzip())? => fixedDecoded
    codec -> decompress(dynamicGzip())? => dynamicDecoded
    fixedDecoded -> matches(fixedSource()) => fixedOk
    dynamicDecoded -> matches(dynamicSource()) => dynamicOk
    fixedOk -> if { "true" } else { "false" } => fixedText
    dynamicOk -> if { "true" } else { "false" } => dynamicText
    "fixed=$fixedText,$(fixedDecoded -> len)" -> println
    "dynamic=$dynamicText,$(dynamicDecoded -> len)" -> println
    Result<Unit, gzip.Error>.Ok
}

main {
    run() -> when {
        Ok(done) { }
        Err(error) { "unexpected=$(error.offset)" -> println }
    }
}
