struct Payload { values: [Int; ~] }
enum Owner {
    Empty
    First(Payload)
    Second(Payload)
}
empty: -> Owner { Owner.Empty }
one: -> Owner { Owner.First(Payload { values: [11; ~] }) }
two: -> Owner { Owner.Second(Payload { values: [13; ~] }) }
impl Owner {
    extract: move self -> Payload {
        self -> when {
            Empty { Payload { values: [0; ~] } }
            First(payload) { payload }
            Second(payload) { payload }
        }
    }
}
impl Payload { first: self -> Int { self.values[0] } }
main {
    empty() -> extract -> first -> println
    one() -> extract -> first -> println
    two() -> extract -> first -> println
}