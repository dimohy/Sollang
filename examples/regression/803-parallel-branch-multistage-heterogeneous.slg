# Parallel arms may capture Copy arguments, run multiple pure stages, and return different types.
add value: Int, amount: Int -> Int => value + amount
double value: Int -> Int => value * 2
isEven value: Int -> Bool => value % 2 == 0

main {
    5 -> parallel branch {
        number: ref -> add(3) -> double
        flag: ref -> add(1) -> isEven
    } => results

    "number=$(results.number)" -> println
    results.flag -> if {
        "flag=true" -> println
    } else {
        "flag=false" -> println
    }
}
