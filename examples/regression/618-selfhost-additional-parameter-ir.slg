import sollang.compiler.ir.typed as typedIr

main {
    [
        """
        report value: Int, owner: Int -> Unit {
            "$value->$owner" -> println
        }

        main { }
        """; ~
    ] => sources!
    sources! -> typedIr.lower => ir!
    ir! -> each node {
        (node.sourceModule == 0 and (node.kind == 0 or node.kind == 10)) -> if {
            "parameter ir = $(node.kind),$(node.symbol),$(node.payloadToken),$(node.operand1),$(node.nextOperand)" -> println
        }
    }
}
