struct Holder {
    values: [UInt8; 8]
}

makeValues: -> Result<[UInt8; 8], Int> {
    [7; 8] -> Result<[UInt8; 8], Int>.Ok
}

replace holder: mut Holder, shouldReplace: Bool -> Unit {
    makeValues() -> when {
        Ok(values) { shouldReplace -> if { values => holder.values } }
        Err(_) {}
    }
}

main {
    Holder { values: [0; 8] } => holder!
    holder! -> replace(false)
    "unchanged=$(holder!.values[0])" -> println
    holder! -> replace(true)
    "replaced=$(holder!.values[0])" -> println
}
