import sollang.compiler.ast as ast
import sollang.compiler.ir.interpolation as interpolation
import sollang.compiler.lexer as lexer

# A parenthesized interpolation must preserve a flow call as the expression
# root. Otherwise code generation prints the captured array as an integer.
main {
    "values! -> len" => expression
    expression -> ast.lowerExpression => expressionNodes
    expression -> lexer.lex => expressionTokens
    expressionNodes -> each node {
        "-" => payload!
        node.payloadToken >= 0 -> if {
            expressionTokens[node.payloadToken] => token
            expression -> slice(token.span.start, token.span.length) => payload!
        }
        "ast=$(node.kind),$(node.parent),$(node.operatorKind),$(payload!)" -> println
    }

    """
    main {
        [1, 2, 3; ~] => values!
        "count=$(values! -> len)" -> println
    }
    """ => source
    source -> interpolation.lower => interpolationNodes
    interpolationNodes -> each node {
        source -> slice(node.payloadStart, node.payloadLength) => payload
        "ir=$(node.kind),$(node.parent),$(node.opcode),$payload,$(node.operand0),$(node.operand1),$(node.typeSymbol)" -> println
    }
}
