# Verifies self-host Set built-in Text hashing and equality helpers.
import sollang.compiler.llvm.text as llvm

main {
    [
        """
        main {
            Set<Text>(4) => set!
            set! -> insert("alpha") -> println
            set! -> insert("beta") -> println
            set! -> insert("alpha") -> println
            set! -> contains("beta") -> println
            set! -> remove("alpha") -> println
            set! -> contains("alpha") -> println
            set! -> len -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
