import std.net.quic as quic
import std.net.quic.p2p as p2p
import std.net.quic.error as errors
import std.net as net

verifyRecords: -> Result<Unit, quic.QuicError> {
    p2p.fromSeed([7; 32])? => validIdentity
    validIdentity -> createRecord(
    net.loopback(44_434),
    9_000_000_000_000)? => validRecord
    validRecord -> validate(1)?

    p2p.fromSeed([8; 32])? => expiredIdentity
    expiredIdentity -> createRecord(
    net.loopback(44_435),
    10)? => expiredRecord
    expiredRecord -> validate(11) -> when {
        Ok(done) { Result<Unit, quic.QuicError>.Err(quic.QuicError {
                kind: errors.Kind.Internal
                code: 81_090
            }) -> return }
        Err(error) { error.code == 81_006 -> unless { Result<Unit, quic.QuicError>.Err(error) -> return } }
    }

    p2p.fromSeed([9; 32])? => tamperedIdentity
    tamperedIdentity -> createRecord(
    net.loopback(44_436),
    9_000_000_000_000)? => tamperedRecord!
    net.loopback(44_437) => tamperedRecord!.endpoint
    tamperedRecord! -> validate(1) -> when {
        Ok(done) { Result<Unit, quic.QuicError>.Err(quic.QuicError {
                kind: errors.Kind.Internal
                code: 81_091
            }) -> return }
        Err(error) { error.code == 81_007 -> unless { Result<Unit, quic.QuicError>.Err(error) -> return } }
    }
    Result<Unit, quic.QuicError>.Ok
}

main {
    verifyRecords() -> when {
        Ok(done) { "p2p-peer-record-ok" -> println }
        Err(error) { "p2p-peer-record-error=$(error.code)" -> println }
    }
}
