import sollang.compiler.llvm.codegen_units as codegen

check artifact: [UInt64; ~], label: Text -> Unit uses Console {
    artifact -> codegen.validate(101, 202, 303) => validation
    artifact -> codegen.decode(101, 202, 303) => decoded
    artifact -> codegen.merge(101, 202, 303) => merged
    "$(label)=$(validation.status),$(decoded.status),$(merged.status)" -> println
}

