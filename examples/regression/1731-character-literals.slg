main {
    "a\n" => source
    (source -> byte(0)) == 'a' -> println
    (source -> byte(1)) == '\n' -> println
    '\0' -> println
    '\b' -> println
    '\t' -> println
    '\f' -> println
    '\r' -> println
    '\"' -> println
    '\'' -> println
    '\\' -> println
    '한' -> println
    '😀' -> println
}
