enum Outcome {
    Ok(Int)
    Err(Int)
}

reject code: Int -> Outcome => Outcome.Err(code)

# Function bodies and entry points use separate LLVM scheduling paths. Both
# must retain a materialized console consumer after a statement-valued match.
verify: -> Unit uses Console {
    reject(1) -> when {
        Ok(value) { "first-ok" }
        Err(error) { "first-error" }
    } -> println
    reject(2) -> when {
        Ok(value) { "second-ok" }
        Err(error) { "second-error" }
    } -> println
    reject(3) -> when {
        Ok(value) { "third-ok" }
        Err(error) { "third-error" }
    } -> println
}

main {
    verify()
}
