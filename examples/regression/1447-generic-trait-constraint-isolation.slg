struct Point { value: Int }
struct Algorithms { }
trait Measure { measure: self -> Int }
trait Other { measure: self -> Int }
impl Other for Point {
    measure: self -> Int => self.value + 100
}
impl Measure for Point {
    measure: self -> Int => self.value
}
impl Algorithms {
    measured<T>: self, value: T -> Int where T: Measure {
        value -> Measure.measure
    }
    other<T>: self, value: T -> Int where T: Other {
        value -> Other.measure
    }
}
main {
    Algorithms { } -> measured(Point { value: 50 }) -> println
    Algorithms { } -> other(Point { value: 50 }) -> println
}
