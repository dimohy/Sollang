import sys.io
import std.net.quic.error as errors
import std.net.quic.keys
import std.net.quic.version_packet as versionPacket

verify: -> Result<UInt32, errors.Error> {
    versionPacket.Packet {
        destinationConnectionId: [1, 2, 3; ~]
        sourceConnectionId: [4, 5; ~]
        versions: [keys.version2(); ~]
    } => packet
    packet -> encode(192)? => encoded
    versionPacket.decode(encoded)? => decoded
    decoded -> validateOriginal(keys.version1())? => valid
    valid -> if { decoded.versions[0] } else { 0 } -> Result<UInt32, errors.Error>.Ok
}

main {
    verify() -> when {
        Ok(version) { "packet-version=$version" -> println }
        Err(error) { "packet-error=$(error.code)" -> println }
    }
}
