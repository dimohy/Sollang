import sys.file as file

printBytes bytes: ref [UInt8; ~] -> Unit uses Console {
    bytes -> file.borrowBytes => source
    source -> len => length
    source -> slice(UIntSize(0), length) => value
    value -> println
}

main {
    [UInt8; ~] => bytes!
    bytes! -> push(99)
    bytes! -> push(117)
    bytes! -> push(114)
    bytes! -> push(114)
    bytes! -> push(101)
    bytes! -> push(110)
    bytes! -> push(116)
    bytes! -> printBytes
}
