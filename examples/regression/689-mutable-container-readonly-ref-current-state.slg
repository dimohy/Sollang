import sys.file as file

printBytes bytes: ref [UInt8; ~] -> Unit uses Console {
    bytes -> file.borrowBytes => source!
    source! -> len => length
    source! -> slice(UIntSize(0), length) => value
    value -> println
}

main {
    [UInt8; ~] => bytes!
    bytes! -> push(UInt8(99))
    bytes! -> push(UInt8(117))
    bytes! -> push(UInt8(114))
    bytes! -> push(UInt8(114))
    bytes! -> push(UInt8(101))
    bytes! -> push(UInt8(110))
    bytes! -> push(UInt8(116))
    bytes! -> printBytes
}
