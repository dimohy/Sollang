import sollang.compiler.llvm.text as llvm

main {
    [
        """
        main {
            [Int; <=8] => values!
            values! -> push(7)
            values! -> len => valueCount
            values! -> capacity => valueCapacity

            {Int: Int; <=8} => lookup!
            lookup! -> put(11, 110)
            lookup! -> len => lookupCount
            lookup! -> capacity => lookupCapacity

            "array=$valueCount/$valueCapacity dictionary=$lookupCount/$lookupCapacity" -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
