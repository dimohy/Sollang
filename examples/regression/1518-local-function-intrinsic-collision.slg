import regression.unrelated_intrinsic_methods as unrelated

# An unrelated module's methods must not replace resolved local functions.
count values: [Int] -> Int { values[0] + 100 }
len values: [Int] -> Int { values[1] + 200 }

main {
    [3, 5] -> count -> println
    [3, 5] -> len -> println
    unrelated.builtinLength() -> println
}
