ready: -> async Bool { true }

identity value: Bool -> Bool => value

both: -> async Bool {
    ready() => first
    ready() => second
    first -> await -> identity => firstOk
    second -> await -> identity => secondOk
    firstOk and secondOk
}

either: -> async Bool {
    ready() => first
    ready() => second
    first -> await -> identity => firstOk
    second -> await -> identity => secondOk
    firstOk or secondOk
}

main {
    both() => andTask
    andTask -> await -> println
    either() => orTask
    orTask -> await -> println
}
