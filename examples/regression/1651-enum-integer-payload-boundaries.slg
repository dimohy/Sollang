enum ByteOwner { Value(UInt8) }
enum SignedOwner { Value(Int8) }
enum WideOwner { Value(UInt64) }

main {
    ByteOwner.Value(255) -> when {
        Value(value) { value -> println }
    }
    SignedOwner.Value(-128) -> when {
        Value(value) { value -> println }
    }
    SignedOwner.Value(127) -> when {
        Value(value) { value -> println }
    }
    WideOwner.Value(18446744073709551615) -> when {
        Value(value) { value -> println }
    }
}
