# Parallel branch transports captures used transitively by sibling local helpers.
run value: Int, offset: Int -> (adjusted: Int, scaled: Int) {
    addOffset input: Int -> Int => input + offset
    adjust input: Int -> Int => input -> addOffset
    scale input: Int -> Int => input * offset

    value -> parallel branch {
        adjusted: -> adjust
        scaled: -> scale
    }
}

main {
    5 -> run(3) => result
    "$(result.adjusted):$(result.scaled)" -> println
}
