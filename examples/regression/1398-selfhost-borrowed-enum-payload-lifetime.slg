struct OwnedValues {
    entries: [Int; ~]
}

enum StoredValues {
    Empty
    Present(OwnedValues)
}

struct Holder {
    values: StoredValues
}

impl Holder {
    length: self -> Int => self.values -> when {
        Empty { 0 }
        Present(values) { values.entries -> len }
    }
}

main {
    OwnedValues { entries: [3, 5, 8; ~] } => values
    Holder { values: StoredValues.Present(values) } => holder
    holder -> length => first
    holder -> length => second
    "borrowed-enum=$first:$second" -> println
}
