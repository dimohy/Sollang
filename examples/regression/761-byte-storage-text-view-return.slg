import sys.file as file

# A readonly byte-array reference is a valid symbolic origin for a Text view.
view bytes: ref [UInt8; ~] -> Text uses File {
    bytes -> file.borrowBytes => source
    source -> slice(UIntSize(1), UIntSize(3))
}

main {
    [UInt8(115), 112, 97, 110, 115; ~] => bytes
    bytes -> view -> println
}
