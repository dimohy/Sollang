# Indexed replacement must probe past a deleted collision slot.
main {
    { 1: 10, 5: 50 } => scores!
    scores! -> take(1) => removed
    55 => scores![5]
    scores! -> put(9, 90)
    scores! -> len => count
    removed -> println
    scores![5] -> println
    scores![9] -> println
    count -> println
}
