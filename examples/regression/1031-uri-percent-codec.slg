import std.uri.percent as percent

run: -> Result<Unit, percent.Error> uses Console {
    percent.pathSegment() => codec
    codec -> encode([97, 47, 32, 37, 255], 13)? => encoded
    codec -> decode(encoded, 5)? => decoded
    "encoded=$(encoded -> len),$(encoded[0]),$(encoded[1]),$(encoded[3]),$(encoded[12])" -> println
    "decoded=$(decoded -> len),$(decoded[0]),$(decoded[1]),$(decoded[4])" -> println

    codec -> decode([37, 50, 71], 3) -> when {
        Ok(value) { "unexpected" -> println }
        Err(error) { "invalid=$(error.offset)" -> println }
    }
    codec -> encode([97, 47, 32, 37, 255], 12) -> when {
        Ok(value) { "unexpected" -> println }
        Err(error) { "limit=$(error.offset)" -> println }
    }
    Result<Unit, percent.Error>.Ok
}

main {
    run() -> when {
        Ok(done) { }
        Err(error) { "unexpected=$(error.offset)" -> println }
    }
}
