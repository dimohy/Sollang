# The self-host parser accepts persistent stream state only in value-first form.
import sollang.compiler.parser as parser

main {
    """
    firstTwo<T> value: T -> stream T {
        0 => state emitted!
        emitted! + 1 => emitted!
        value -> emit
    }
    """ => source
    source -> parser.parseEvents => events!
    events![(events! -> len) - 1].value == 1 -> if {
        "state=valid" -> println
    } else {
        "state=invalid" -> println
    }
}
