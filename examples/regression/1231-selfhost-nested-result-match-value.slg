nested value: Int -> Bool {
    Result<Int, Text>.Ok(value) -> when {
        Err(_) { false }
        Ok(number) => Result<Bool, Text>.Ok(number == 7) -> when {
            Err(_) { false }
            Ok(valid) { valid }
        }
    }
}

main {
    7 -> nested -> if { "nested result ok" } else { "nested result failed" } -> println
}
