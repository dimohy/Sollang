enum Error {
    Rejected
}

struct Buffer {
    values: [Long; ~]
}

setAt values: mut [Long; ~], index: Int, value: Long -> Unit {
    value => values[index]
}

impl Buffer {
    update: mut self, value: Long, reject: Bool -> Result<Long, Error> {
        self.values -> setAt(0, value)
        reject -> if {
            Error.Rejected -> Result<Long, Error>.Err
        } else {
            value -> Result<Long, Error>.Ok
        } => selected
        selected -> when {
            Ok(result) { result -> Result<Long, Error>.Ok }
            Err(error) { error -> Result<Long, Error>.Err -> return }
        }
    }
}

main {
    Buffer { values: [1; ~] } => buffer!
    buffer! -> update(7, true) -> when {
        Ok(value) { "unexpected=$value" -> println }
        Err(_) { "rejected" -> println }
    }
    buffer! -> update(11, false) -> when {
        Ok(value) { "reused=$value" -> println }
        Err(_) { "unexpected-error" -> println }
    }
    "stored=$(buffer!.values[0])" -> println
}
