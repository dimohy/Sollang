import std.net

# The target path of a nested instance flow is a sibling of the receiver call
# in the AST. The self-host call index must attach `unified`, not `local`, to
# the kind-10 call node without restoring the old quadratic AST scan.
consume endpoint: net.Endpoint -> Int => 42

wrap local: net.Ipv4Endpoint -> Int {
    consume(local -> unified)
}

main {
    net.loopback(0) -> wrap => result
    "$result" -> println
}
