value input: Int -> Result<Int, Text> => Result<Int, Text>.Ok(input)
reject input: Int -> Result<Int, Text> => Result<Int, Text>.Err("stop")
double input: Int -> Int => input * 2

run: -> Result<Unit, Text> uses Console {
    value(2)? -> println
    3 -> value? -> println
    4 -> value? -> double -> println
    5 -> reject? -> println
    "unreachable" -> println
    Result<Unit, Text>.Ok
}

main {
    run() -> when {
        Ok(_) { "unexpected" -> println }
        Err(error) { "error=$error" -> println }
    }
}
