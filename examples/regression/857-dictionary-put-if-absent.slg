main {
    { 1: 10 } => legacy!
    legacy! -> putIfAbsent(1, 99) => legacyDuplicate
    legacy! -> putIfAbsent(2, 20) => legacyInserted

    {Int: Text; 4~} => labels!
    labels! -> putIfAbsent(1, "first") => first
    labels! -> putIfAbsent(1, "discarded") => duplicate
    labels! -> putIfAbsent(2, "second") => second

    {Int: Int; <=2} => bounded!
    bounded! -> putIfAbsent(7, 70) => boundedFirst
    bounded! -> putIfAbsent(7, 700) => boundedDuplicate
    bounded! -> putIfAbsent(8, 80) => boundedSecond

    legacyDuplicate -> if { "legacyDuplicate=true" -> println } else { "legacyDuplicate=false" -> println }
    legacyInserted -> if { "legacyInserted=true" -> println } else { "legacyInserted=false" -> println }
    first -> if { "first=true" -> println } else { "first=false" -> println }
    duplicate -> if { "duplicate=true" -> println } else { "duplicate=false" -> println }
    second -> if { "second=true" -> println } else { "second=false" -> println }
    labels![1] -> println
    "labels=$(labels! -> len) legacy=$(legacy! -> len) legacy2=$(legacy![2])" -> println
    boundedFirst -> if { "boundedFirst=true" -> println } else { "boundedFirst=false" -> println }
    boundedDuplicate -> if { "boundedDuplicate=true" -> println } else { "boundedDuplicate=false" -> println }
    boundedSecond -> if { "boundedSecond=true" -> println } else { "boundedSecond=false" -> println }
    "bounded=$(bounded! -> len),value=$(bounded![7])" -> println
}
