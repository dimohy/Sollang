# Verifies one-reserve bulk append from fixed arrays into copyable heap arrays.
main {
    [Int; ~] => ints!
    ints! -> reserve(1)
    ints! -> push(7)
    [8, 9, 10] => moreInts
    ints! -> pushAll(moreInts)

    [Text; ~] => labels!
    labels! -> push("first")
    ["second", "third"] => moreLabels
    labels! -> pushAll(moreLabels)

    "ints=$(ints! -> len),$(ints! -> capacity),$(ints![0]),$(ints![3])" -> println
    "labels=$(labels! -> len),$(labels! -> capacity),$(labels![0]),$(labels![2])" -> println
}
