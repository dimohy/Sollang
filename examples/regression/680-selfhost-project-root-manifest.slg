import sollang.compiler.project as projects

main {
    """project {
            name: "demo"
            version: "0.4.0"
            root: "src/main.slg"
        }
        """ => source
    source -> projects.parse => manifest!
    manifest!.products[0] => product
    source -> slice(product.root.start, product.root.length) => root
    "project root = $(manifest!.status),$root" -> println
}
