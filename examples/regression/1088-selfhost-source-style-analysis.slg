import sollang.compiler.source_style as sourceStyle

main {
    """
    main {
        true => indexReady
        true => moreWorkRemaining
        false => skippedThisRound
        indexReady and moreWorkRemaining and not skippedThisRound -> if {
            "long-if" -> println
        }

        0 => index!
        true => stillScanningPrefix
        1 => remainingPrefixLength
        stillScanningPrefix and index! < remainingPrefixLength -> while {
            "long-while" -> println
            index! + 1 => index!
        }
    }
    """ => source
    source -> sourceStyle.analyze => notes
    "$(notes -> len)" -> println
    0 => index!
    index! < (notes -> len) -> while {
        notes[index!] => note
        "$(note.code),$(note.line),$(note.column),$(note.conditionLength),$(note.role)" -> println
        index! + 1 => index!
    }
}
