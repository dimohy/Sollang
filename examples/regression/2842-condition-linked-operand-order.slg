first: -> Int uses Console {
    "first" -> println
    1
}

second: -> Int uses Console {
    "second" -> println
    2
}

condition left: Int, right: Int -> Bool => left > right

struct Pair { left: Int, right: Int }

conditionArray values: [Int; ~] -> Bool => values[0] > values[1]
conditionPair pair: Pair -> Bool => pair.left > pair.right

exercise: -> Unit uses Console {
    condition(first(), second()) -> while {
        "unexpected" -> println
    }
    "function-done" -> println
}

main {
    "entry" -> println
    condition(first(), second()) -> while {
        "unexpected" -> println
    }
    "array" -> println
    conditionArray([first(), second(); ~]) -> while {
        "unexpected" -> println
    }
    "logical" -> println
    (true and condition(first(), second())) -> println
    (false or condition(first(), second())) -> println
    "aggregate" -> println
    conditionPair(Pair { left: first(), right: second() }) -> while {
        "unexpected" -> println
    }
    "function" -> println
    exercise()
    "done" -> println
}
