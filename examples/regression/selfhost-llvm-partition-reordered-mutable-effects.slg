import sollang.compiler.llvm.text as llvm

main {
    [
    """
    namespace routing
    import std.sequence
    make: -> Stream<Int> { 1..6 -> defer }
    isEven value: Int -> Bool => value % 2 == 0
    main {
        make() -> partition value {
            even: when isEven(value)
            large: when value >= 3
            other: else
        } => routed
        0 => otherTotal!
        routed.other -> each value {
            otherTotal! + value => otherTotal!
            otherTotal! -> println
        }
        "registered other" -> println
        0 => largeTotal!
        routed.large -> each value {
            largeTotal! + value => largeTotal!
            largeTotal! -> println
        }
        0 => evenTotal!
        routed.even -> each value {
            evenTotal! + value => evenTotal!
            evenTotal! -> println
        }
        evenTotal! -> println
        largeTotal! -> println
        otherTotal! -> println
    }
    """; ~
    ] => sources!
    sources! -> llvm.emit
}
