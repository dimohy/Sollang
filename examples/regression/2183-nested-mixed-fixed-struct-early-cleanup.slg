struct FixedHolder {
    values: [UInt8; 8]
}

struct Mixed {
    moving: [Int; ~]
    kept: FixedHolder
}

consume values: move [Int; ~] -> Int => values[0]

finish owner: move Mixed -> Int {
    owner.moving -> consume => first
    first -> return
}

main {
    Mixed { moving: [7; ~], kept: FixedHolder { values: [9; 8] } } -> finish => first
    "first=$first" -> println
}
