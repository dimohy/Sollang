sum values: Range -> Int {
    values -> fold 0 total, value { total + value }
}

main {
    1..3 => values
    values -> fold 0 total, value { total + value } -> println
    values -> sum -> println
    1..<3 -> fold 0 total, value { total + value } -> println
    3..<3 => empty
    empty -> fold 17 total, value { total + value } -> println
    2147483647..2147483647 => maximum
    maximum -> fold 0 total, value { total + 1 } -> println
    -2147483648..<-2147483648 => minimumEmpty
    minimumEmpty -> fold 19 total, value { total + value } -> println
}
