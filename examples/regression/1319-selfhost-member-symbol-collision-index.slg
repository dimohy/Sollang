struct Node {
    value: Int
}

struct Package {
    nodes: [Node; ~]
}

struct Snapshot {
    package: Package
}

read snapshot: Snapshot, nodes: mut [Node; ~], index: Int -> Int {
    snapshot.package.nodes[index].value
}

main {
    Snapshot {
        package: Package {
            nodes: [Node { value: 7 }, Node { value: 8 }, Node { value: 9 }; ~]
        }
    } => snapshot
    [Node { value: 1 }; ~] => nodes!
    snapshot -> read(nodes!, 2) => selected
    "selected=$selected" -> println
}
