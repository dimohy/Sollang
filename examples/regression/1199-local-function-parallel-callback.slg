increment value: Int -> Int => value + 1

run values: [Int; ~] -> [Int; ~] {
    map current: [Int; ~] -> [Int; ~] {
        # A reachable local owner must participate in the same callback
        # reachability closure as an ordinary emitted function.
        current -> parallel value {
            value -> increment
        } => mapped
        mapped
    }

    values -> map
}

makeValues: -> [Int; ~] {
    [Int; ~] => values!
    0 => value!
    value! < 3 -> while {
        values! -> push(value!)
        value! + 1 => value!
    }
    values!
}

main {
    makeValues() => values
    values -> run => mapped
    "mapped=$(mapped -> len)" -> println
}
