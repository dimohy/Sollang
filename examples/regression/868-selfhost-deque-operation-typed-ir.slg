# Verifies canonical self-host Typed IR opcodes and result types for Deque operations.
import sollang.compiler.ir.typed as typedIr

main {
    [
        """
        main {
            Deque<Int>(3) => queue!
            queue! -> pushFront(1)
            queue! -> pushBack(2)
            queue! -> front => first
            queue! -> back => last
            queue! -> popFront => poppedFirst
            queue! -> popBack => poppedLast
            Deque<box Int>(2) => owned!
            owned! -> pushBack(box 1)
            owned! -> popFront => firstOwned
        }
        """; ~
    ] => sources!
    sources! -> typedIr.lower => ir!

    [false, false, false, false, false, false; ~] => found!
    false => hasOwnedPop!
    ir! -> each node {
        (node.kind == 9 and node.opcode == -246 and node.typeOrigin == 1 and node.typeSymbol == 0) -> if { true => found![0] }
        (node.kind == 9 and node.opcode == -247 and node.typeOrigin == 1 and node.typeSymbol == 0) -> if { true => found![1] }
        (node.kind == 9 and node.opcode == -248 and node.typeOrigin == 1 and node.typeSymbol == 2) -> if { true => found![2] }
        (node.kind == 9 and node.opcode == -249 and node.typeOrigin == 1 and node.typeSymbol == 2) -> if { true => found![3] }
        (node.kind == 9 and node.opcode == -250 and node.typeOrigin == 1 and node.typeSymbol == 2) -> if { true => found![4] }
        (node.kind == 9 and node.opcode == -251 and node.typeOrigin == 1 and node.typeSymbol == 2) -> if { true => found![5] }
        (node.kind == 9 and node.opcode == -250 and node.typeKind == 6) -> if { true => hasOwnedPop! }
    }

    found![0] -> if { "pushFront=true" -> println } else { "pushFront=false" -> println }
    found![1] -> if { "pushBack=true" -> println } else { "pushBack=false" -> println }
    found![2] -> if { "front=true" -> println } else { "front=false" -> println }
    found![3] -> if { "back=true" -> println } else { "back=false" -> println }
    found![4] -> if { "popFront=true" -> println } else { "popFront=false" -> println }
    found![5] -> if { "popBack=true" -> println } else { "popBack=false" -> println }
    hasOwnedPop! -> if { "owned-pop=true" -> println } else { "owned-pop=false" -> println }
}
