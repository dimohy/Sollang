make: -> Result<[UInt8; 8], Int> => Result<[UInt8; 8], Int>.Ok([7; 8])

inspect value: ref Result<[UInt8; 8], Int> -> UInt8 {
    value -> when {
        Ok(bytes) { bytes[0] }
        Err(error) { 0 }
    }
}

main {
    make() => value
    inspect(value) => first
    inspect(value) => second
    "first=$first,second=$second" -> println
}
