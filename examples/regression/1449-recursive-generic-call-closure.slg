# Recursive calls and repeated concrete calls share one specialization.
afterSteps<T> value: T, count: Int -> T {
    count == 0 -> if {
        value
    } else {
        value -> afterSteps(count - 1)
    }
}

main {
    300 -> afterSteps(3) -> println
    "recursive" -> afterSteps(2) -> println
    301 -> afterSteps(1) -> println
}
