import sollang.compiler.ir.typed as typedIr

# Container len must remain Int through a binding and a later call argument.
main {
    [
        """"
        canRead index: Int, count: Int, length: Int -> Bool {
            index >= 0 and count >= 0 and index <= length and count <= length - index
        }

        validate words: [UInt64; ~] -> Bool {
            words -> len => wordLength
            0 => index!
            index! -> canRead(8, wordLength)
        }
        """"; ~
    ] => sources
    sources -> typedIr.lower => ir
    0 => index!
    ir -> each node {
        node.astNode >= 38 -> if {
            "ir = $(index!),$(node.kind),$(node.parent),$(node.astNode),$(node.symbol),$(node.typeOrigin),$(node.typeSymbol),$(node.opcode),$(node.operand0),$(node.operand1),$(node.nextOperand)" -> println
        }
        index! + 1 => index!
    }
}
