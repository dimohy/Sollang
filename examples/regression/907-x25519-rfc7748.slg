import sys.crypto.x25519

privateScalar: -> [UInt8] => [
    119, 7, 109, 10, 115, 24, 165, 125,
    60, 22, 193, 114, 81, 178, 102, 69,
    223, 76, 47, 135, 235, 192, 153, 42,
    177, 119, 251, 165, 29, 185, 44, 42]

expected: -> [UInt8] => [
    133, 32, 240, 9, 137, 48, 167, 84,
    116, 139, 125, 220, 180, 62, 247, 90,
    13, 191, 58, 13, 38, 56, 26, 244,
    235, 164, 169, 142, 170, 155, 78, 106]

main {
    privateScalar() -> x25519.publicKey => actual
    true => matches!
    0 => index!
    index! < 32 -> while {
        actual[index!] == expected()[index!] -> unless { false => matches! }
        index! + 1 => index!
    }
    matches! -> if { "true" } else { "false" } => matchText
    "x25519=$matchText,$(actual[0]),$(actual[31])" -> println
}
