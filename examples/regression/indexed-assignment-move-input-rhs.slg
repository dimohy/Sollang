import sys.file as file
replace source: move file.SourceText, values: mut [file.SourceText; ~] -> Unit {
    source => values[0]
}
main {
    "examples/regression/indexed-assignment-mutable-rhs.slg" -> file.mapText => initial
    [file.SourceText; ~] => values!
    values! -> push(initial)
    "examples/regression/indexed-assignment-mutable-rhs.slg" -> file.mapText => source
    source -> replace(values!)
    (values![0] -> len) > 0 -> println
}
