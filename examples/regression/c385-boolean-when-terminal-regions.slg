grade score: Int -> Int {
    when {
        score >= 80 { 7 -> return }
        else { 9 -> return }
    }
}
subjectGrade score: Int -> Int {
    score -> when {
        >= 80 { 7 -> return }
        else { 9 -> return }
    }
}
continuing score: Int -> Int {
    when {
        score >= 80 { 2 }
        else { 3 }
    } => result
    result + 10
}
nested score: Int, enabled: Bool -> Int {
    enabled -> if {
        when {
            score >= 80 { 7 -> return }
            else { 9 -> return }
        }
    } else {
        11 -> return
    }
}
main {
    85 -> grade -> println
    70 -> grade -> println
    85 -> subjectGrade -> println
    70 -> subjectGrade -> println
    85 -> continuing -> println
    70 -> continuing -> println
    85 -> nested(true) -> println
    70 -> nested(true) -> println
    85 -> nested(false) -> println
}
