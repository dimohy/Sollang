native fixture from "artifacts/native-interop/native_fixture" {
    try checkedDouble value: Int32 -> Int32 as "native_checked_double"
}

resultValue result: Result<Int32, Int32> -> Int32 {
    result -> when {
        Result<Int32, Int32>.Ok(value) => value
        Result<Int32, Int32>.Err(error) => error
    }
}

main {
    fixture.checkedDouble(21) -> resultValue => success
    fixture.checkedDouble(-1) -> resultValue => failure
    "$success" -> println
    "$failure" -> println
}
