struct Pair {
    first: Int
    second: Int
}

mark value: Int -> Int uses Console {
    value -> println
    value
}

main {
    Pair { second: mark(20), first: mark(10) } => direct
    direct.first -> println
    direct.second -> println

    [Pair; { second: mark(40), first: mark(30) }] => pairs
    pairs[0].first -> println
    pairs[0].second -> println
}
