struct Counter {
    bytes: UInt64
}

struct Payload {
    data: [UInt8; ~]
}

subtractPayload connection: mut Counter, value: ref Payload -> Unit {
    connection.bytes - UInt64(value.data -> len)
        => connection.bytes
}

main {
    Counter { bytes: 5 } => connection!
    Payload { data: [7, 8, 9; ~] } => value
    subtractPayload(connection!, value)
    connection!.bytes -> println
}
