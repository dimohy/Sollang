# Interpolated reference operands use scalar values for Boolean logic and
# signed integer comparison and arithmetic.
struct Values {
    number: Int
    ready: Bool
}

number values: ref Values -> ref Int { values.number }
ready values: ref Values -> ref Bool { values.ready }

show values: ref Values -> Unit uses Console {
    values -> number => borrowedNumber
    values -> ready => borrowedReady
    "function=$(borrowedReady and true),$(borrowedNumber < 0),$(borrowedNumber + 2)" -> println
    true -> if {
        "control=$(borrowedReady and true),$(borrowedNumber < 0)" -> println
    }
}

main {
    Values { number: -7, ready: true } => values
    values -> number => borrowedNumber
    values -> ready => borrowedReady
    "entry=$(borrowedReady and true),$(borrowedNumber < 0),$(borrowedNumber + 2)" -> println
    values -> show
}
