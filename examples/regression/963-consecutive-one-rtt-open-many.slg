import std.net.quic.application_engine as application
import std.net.quic.error as errors
import std.net.quic.frame as frames
import std.net.quic.keys

secret: -> [UInt8; 32] => [68; 32]
connectionId: -> [UInt8] => [1, 2, 3, 4, 5, 6, 7, 8]

run: -> Result<Bool, errors.Error> {
    application.create(keys.version1(), secret()) => sender
    application.create(keys.version1(), secret()) => receiver!

    [frames.Value; ~] => firstFrames!
    firstFrames! -> push(frames.Value.NewConnectionId(frames.NewConnectionId {
        sequence: 1
        retirePriorTo: 0
        connectionId: [9, 8, 7, 6, 5, 4, 3, 2; ~]
        statelessResetToken: [17; 16]
    }))
    sender -> encodeMany(connectionId(), 3, firstFrames!)? => firstPacket

    [frames.Value; ~] => secondFrames!
    secondFrames! -> push(frames.Value.Stream(frames.Stream {
        id: 0
        offset: 0
        fin: true
        data: [112, 105, 110, 103; ~]
    }))
    sender -> encodeMany(connectionId(), 4, secondFrames!)? => secondPacket

    receiver! -> openMany(firstPacket, connectionId(), 0)? => first!
    receiver! -> openMany(secondPacket, connectionId(), 4)? => second!
    first!.frames -> take(0) -> when {
        NewConnectionId(value) {}
        else { Result<Bool, errors.Error>.Ok(false) -> return }
    }
    false => valid!
    second!.frames -> take(0) -> when {
        Stream(value) {
            (value.fin and value.data[0] == 112 and value.data[3] == 103) => valid!
        }
        else {}
    }
    Result<Bool, errors.Error>.Ok(valid!)
}

main {
    run() -> when {
        Ok(valid) { valid -> if { "consecutive-open-many=ok" } else { "consecutive-open-many=failed" } -> println }
        Err(value) { "consecutive-open-many-error=$(value.code)" -> println }
    }
}
