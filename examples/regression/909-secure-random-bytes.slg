import sys.crypto.random as random
import sys.crypto.x25519 as x25519

hasNonZero bytes: [UInt8] -> Bool {
    false => found!
    0 => index!
    index! < (bytes -> len) -> while {
        bytes[index!] != 0 -> if { true => found! }
        index! + 1 => index!
    }
    found!
}

main {
    32 -> random.bytes -> when {
        Ok(bytes) {
            hasNonZero(bytes) -> if { "true" } else { "false" } => nonZeroText
            "random=$(bytes -> len),$nonZeroText" -> println
        }
        Err(error) { "random-error" -> println }
    }
    x25519.generatePrivateKey() -> when {
        Ok(privateKey) {
            privateKey -> x25519.publicKey => publicKey
            "x25519=$(privateKey -> len),$(publicKey -> len)" -> println
        }
        Err(error) { "x25519-error" -> println }
    }
}
