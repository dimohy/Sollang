import sollang.compiler.semantic.module_interfaces as interfaces

main {
    ["namespace numeric_cache.provider\n\npublic struct Entry { public value: Int }\npublic struct Other { public marker: Int }\npublic entry: -> Entry => Entry { value: 1 }\n","namespace numeric_cache.provider\n\nhidden: -> Int => 99\npublic struct Other { public marker: Int }\npublic struct Entry { public value: Int }\npublic entry: -> Entry => Entry { value: 2 }\n","namespace numeric_cache.provider\n\npublic struct Entry { public value: Long }\npublic struct Other { public marker: Int }\npublic entry: -> Entry => Entry { value: Long(1) }\n"; ~] => sources
    sources -> interfaces.interfaces => canonical
    interfaces.sameInterface(canonical, 0, canonical, 1) -> println
    interfaces.sameInterface(canonical, 0, canonical, 2) -> println
}
