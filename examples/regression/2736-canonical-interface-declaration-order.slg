import sollang.compiler.semantic.module_interfaces as interfaces

main {
    [
    """
    namespace numeric_cache.provider

    public struct Entry { public value: Int }
    public struct Other { public marker: Int }
    public entry: -> Entry => Entry { value: 1 }

    """,
    """
    namespace numeric_cache.provider

    hidden: -> Int => 99
    public struct Other { public marker: Int }
    public struct Entry { public value: Int }
    public entry: -> Entry => Entry { value: 2 }

    """,
    """
    namespace numeric_cache.provider

    public struct Entry { public value: Long }
    public struct Other { public marker: Int }
    public entry: -> Entry => Entry { value: Long(1) }

    """; ~] => sources
    sources -> interfaces.interfaces => canonical
    interfaces.sameInterface(canonical, 0, canonical, 1) -> println
    interfaces.sameInterface(canonical, 0, canonical, 2) -> println
}
