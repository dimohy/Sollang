# A readonly aggregate reference to a direct mutable local must borrow the
# local slot. It must not name an unallocated call-reference temporary.
measure prefix: Int, bytes: ref [UInt8; ~] -> Int {
    bytes -> len
}

main {
    [UInt8; ~] => bytes!
    bytes! -> push(7)
    bytes! -> push(9)
    10 -> measure(bytes!) => length
    "length=$length" -> println
}
