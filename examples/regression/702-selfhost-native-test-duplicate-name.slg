import sollang.compiler.cli_test as cliTest

main {
    [
        "tests/Sollang.NativeTestFixtures/duplicate-a.slg",
        "tests/Sollang.NativeTestFixtures/duplicate-b.slg";
        ~
    ] => sources
    sources -> cliTest.build(sources -> len, "") => plan
    "status = $(plan.status)" -> println
}
