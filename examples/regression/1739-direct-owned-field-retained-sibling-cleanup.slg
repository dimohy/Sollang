struct Owner { bytes: [UInt8; ~] }
struct Pair { moved: Owner, retained: Owner }

consume value: move Owner -> Int => value.bytes -> len

main {
    Pair {
        moved: Owner { bytes: [1, 2; ~] }
        retained: Owner { bytes: [3, 4, 5; ~] }
    } => pair
    pair.moved => moved
    moved -> consume => length
    "retained-sibling=$length" -> println
}
