import sollang.compiler.llvm.text as llvm

main {
    [
    """
    import sys.runtime as runtime

    main {
        UIntSize(8) -> runtime.secureRandomBytes -> when {
            Ok(bytes) { bytes -> len }
            Err(_) { 0 }
        } => observed
    }
    """; ~
    ] => sources!
    sources! -> llvm.emit
}
