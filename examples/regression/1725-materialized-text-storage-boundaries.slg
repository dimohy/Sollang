struct Label { text: Text }

main {
    7 => value
    Arena(64) => storage!
    "value=$value" -> materialize(storage!) => text

    ["prefix", text] => fields
    fields[1] -> println
    (label: text, count: value) => record
    record.label -> println
    Label { text: text } => label
    label.text -> println

    # The same explicit view may be stored without additional materialization.
    [Text; <=1] => bounded!
    bounded! -> push(text)
    bounded![0] -> println

    # An immediate sink keeps deferred formatting and needs no Arena mutation.
    "immediate=$value" -> println
}
