import std.net as net
import std.net.socket as socket

struct ClientResult {
    invalidRangeRejected: Bool
    rangeCount: UIntSize
}

sendRangeClient endpoint: net.Endpoint -> Result<ClientResult, socket.SocketError> uses Network {
    endpoint -> connect? => connection
    [UInt8; ~] => bytes!
    bytes! -> push(120)
    bytes! -> push(120)
    bytes! -> push(112)
    bytes! -> push(105)
    bytes! -> push(110)
    bytes! -> push(103)
    bytes! -> push(121)
    bytes! -> push(121)
    connection -> sendRange(bytes!, 7, 2) -> when {
        Ok(_) { false }
        Err(error) => error.kind -> when {
            InvalidArgument { true }
            else { false }
        }
    } => invalidRangeRejected
    connection -> sendRange(bytes!, 2, 4)? => rangeCount
    connection -> close
    Result<ClientResult, socket.SocketError>.Ok(ClientResult {
        invalidRangeRejected: invalidRangeRejected
        rangeCount: rangeCount
    })
}

sendAllClient endpoint: net.Endpoint -> Result<Unit, socket.SocketError> uses Network {
    endpoint -> connect? => connection
    [UInt8; ~] => bytes!
    bytes! -> push(112)
    bytes! -> push(111)
    bytes! -> push(110)
    bytes! -> push(103)
    connection -> sendAll(bytes!)?
    connection -> close
    Result<Unit, socket.SocketError>.Ok
}

main {
    net.loopback(43179) -> unified => endpoint
    socket.ListenOptions {
        endpoint: endpoint
        backlog: 8
        reuseAddress: true
    } -> listen -> when {
        Err(error) { "listen-error=$(error.code)" -> println }
        Ok(listener) {
            endpoint -> sendRangeClient -> when {
                Err(error) { "range-error=$(error.code)" -> println }
                Ok(client) {
                    listener -> accept -> when {
                        Err(error) { "accept-error=$(error.code)" -> println }
                        Ok(connection) {
                            connection -> receive(8) -> when {
                                Err(error) { "receive-error=$(error.code)" -> println }
                                Ok(rangeBytes) {
                                    connection -> close
                                    endpoint -> sendAllClient -> when {
                                        Err(error) { "all-error=$(error.code)" -> println }
                                        Ok(_) {
                                            listener -> accept -> when {
                                                Err(error) { "accept-error=$(error.code)" -> println }
                                                Ok(allStream) {
                                                    allStream -> receive(8) -> when {
                                                        Err(error) { "receive-error=$(error.code)" -> println }
                                                        Ok(allBytes) {
                                                            allStream -> close
                                                            listener -> close
                                                            client.invalidRangeRejected
                                                                and client.rangeCount == 4
                                                                and (rangeBytes -> len) == 4
                                                                and rangeBytes[0] == 112
                                                                and rangeBytes[3] == 103
                                                                and (allBytes -> len) == 4
                                                                and allBytes[0] == 112
                                                                and allBytes[3] == 103
                                                                -> if { "socket-send-range-all=ok" } else { "socket-send-range-all=failed" }
                                                                -> println
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
