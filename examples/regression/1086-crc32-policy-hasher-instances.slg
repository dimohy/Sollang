import std.hash.crc32 as crc32

main {
    [UInt8(49), 50, 51, 52, 53, 54, 55, 56, 57] => input
    crc32.Polynomial.Ieee -> checksum(input) => ieee
    crc32.Polynomial.Castagnoli -> checksum(input) => castagnoli
    "one-shot=$ieee,$castagnoli" -> println

    crc32.Polynomial.Ieee -> hasher => hasher!
    [UInt8(49), 50, 51] => first
    [UInt8(52), 53, 54] => second
    [UInt8(55), 56, 57] => third
    hasher! -> write(first)
    hasher! -> write(second)
    hasher! -> write(third)
    hasher! -> checksum => chunked
    "chunked=$chunked" -> println

    hasher! -> reset
    hasher! -> checksum => emptyAfterReset
    [UInt8; ~] => emptyInput
    crc32.Polynomial.Ieee -> checksum(emptyInput) => empty
    "empty=$empty,$emptyAfterReset" -> println
}
