# Nested owning enum payloads preserve their complete declaration layout.
struct Payload { values: [Int; ~] }
enum Inner {
    Empty
    Value(Payload)
}
enum Outer {
    Empty
    Value(Inner)
}
main {
    Outer.Value(Inner.Value(Payload { values: [13; ~] })) => owner
    owner -> when {
        Empty { "0" -> println }
        Value(inner) {
            inner -> when {
                Empty { "0" -> println }
                Value(payload) { payload.values[0] -> println }
            }
        }
    }
}
