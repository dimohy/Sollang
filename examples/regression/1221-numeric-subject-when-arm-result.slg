# A numeric subject when returns the selected arm value, never its subject.
select value: Int -> Int => value -> when {
    == 0 { 1 }
    == 1 { 4 }
    else { 8 }
}

selectAfterPrior descriptor: Int -> Int {
    descriptor % 4 -> when {
        == 0 { 0 }
        == 1 { 1 }
        == 2 { 2 }
        == 3 { 4 }
        else { 0 }
    } => dictionaryBytes
    descriptor / 64 -> when {
        == 0 { (descriptor / 32) % 2 }
        == 1 { 2 }
        == 2 { 4 }
        == 3 { 8 }
        else { 0 }
    } => sizeBytes
    dictionaryBytes * 10 + sizeBytes
}

main {
    "$(0 -> select),$(1 -> select),$(2 -> select);$(32 -> selectAfterPrior),$(67 -> selectAfterPrior)"
        -> println
}
