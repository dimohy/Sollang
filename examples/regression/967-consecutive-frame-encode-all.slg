import std.net.quic.error as errors
import std.net.quic.frame as frames

run: -> Result<Bool, errors.Error> {
    [frames.Value; ~] => firstFrames!
    firstFrames! -> push(frames.Value.NewConnectionId(frames.NewConnectionId {
        sequence: 1
        retirePriorTo: 0
        connectionId: [9, 8, 7, 6, 5, 4, 3, 2; ~]
        statelessResetToken: [17; 16]
    }))
    frames.encodeAll(firstFrames!)? => first

    [frames.Value; ~] => secondFrames!
    secondFrames! -> push(frames.Value.Stream(frames.Stream {
        id: 0
        offset: 0
        fin: true
        data: [112, 105, 110, 103; ~]
    }))
    frames.encodeAll(secondFrames!)? => second

    Result<Bool, errors.Error>.Ok((first -> len) == 28 and (second -> len) == 7)
}

main {
    run() -> when {
        Ok(valid) { valid -> if { "consecutive-frame-encode-all=ok" } else { "consecutive-frame-encode-all=failed" } -> println }
        Err(value) { "consecutive-frame-encode-all-error=$(value.code)" -> println }
    }
}
