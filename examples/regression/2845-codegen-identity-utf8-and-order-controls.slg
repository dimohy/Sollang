main {
    strayContinuationArtifact() -> check("stray-continuation")
    overlongTwoArtifact() -> check("overlong-two")
    invalidLeadingC1Artifact() -> check("invalid-leading-c1")
    invalidContinuationArtifact() -> check("invalid-continuation")
    overlongThreeArtifact() -> check("overlong-three")
    highSurrogateArtifact() -> check("high-surrogate")
    surrogateEndArtifact() -> check("surrogate-end")
    overlongFourArtifact() -> check("overlong-four")
    beyondUnicodeArtifact() -> check("beyond-unicode")
    invalidLeadingF5Artifact() -> check("invalid-leading-f5")
    truncatedTwoArtifact() -> check("truncated-two")
    truncatedThreeArtifact() -> check("truncated-three")
    truncatedFourArtifact() -> check("truncated-four")
    duplicateCompleteIdentityArtifact() -> check("duplicate-complete-identity")
    reversedCompleteIdentityArtifact() -> check("reversed-complete-identity")
    identityWordExceedsByteArtifact() -> check("identity-word-exceeds-byte")
    unicodeScalarBoundariesArtifact() -> check("unicode-scalar-boundaries")

    # Hash ties use UTF-16 ordinal order; deliberately forged hashes still fail validation.
    codegen.CodegenUnits {
        kinds: [0, 1, 1, 2; ~]
        moduleHashes: [0, 1, 1, 0; ~]
        interfaceHashes: [101, 101, 101, 101; ~]
        implementationHashes: [202, 202, 202, 202; ~]
        identityStarts: [0, 0, 3, 7; ~]
        identityLengths: [0, 3, 4, 0; ~]
        identityWords: [239, 188, 161, 240, 144, 128, 128; ~]
        fragmentStarts: [0, 1, 2, 3; ~]
        fragmentWordLengths: [1, 1, 1, 1; ~]
        fragmentByteLengths: [1, 1, 1, 1; ~]
        fragmentWords: [72, 65, 66, 84; ~]
    } => unicodeUnits
    unicodeUnits -> codegen.encode(101, 202, 303) => encoded
    encoded -> codegen.validate(101, 202, 303) => forged
    "ordinal=$(encoded[25]) invalidhash=$(forged.status)" -> println
}
