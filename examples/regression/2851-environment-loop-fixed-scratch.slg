# An empty environment name is absent; exercise fixed scratch in both owners.
import sys.process as process

describe value: Option<Text> -> Text {
    value -> when {
        Option<Text>.None => "missing"
        Option<Text>.Some(_) => "present"
    }
}

inspect: -> Unit uses Console, Environment {
    0 => round!
    round! < 2 -> while {
        process.environment("") -> describe -> println
        round! + 1 => round!
    }
}

main {
    0 => round!
    round! < 2 -> while {
        process.environment("") -> describe -> println
        round! + 1 => round!
    }
    inspect()
}
