enum Progress {
    Continue
    Ready
}

advance attempt: Int -> Result<Progress, Text> {
    attempt == 0 -> if {
        Result<Progress, Text>.Ok(Progress.Continue)
    } else {
        Result<Progress, Text>.Ok(Progress.Ready)
    }
}

check: -> Bool {
    0 => attempt!
    attempt! < 2 -> while {
        attempt! -> advance -> when {
            Err(_) { false -> return }
            Ok(progress) {
                progress -> when {
                    Continue { }
                    Ready { true -> return }
                }
            }
        }
        attempt! + 1 => attempt!
    }
    false
}

main {
    "statement-match=$(check())" -> println
}
