import sollang.compiler.cli_project as cliProject
import sys.path as path

struct Inspection {
    status: Int
    sources: Int
}

inspect option: Text, style: path.Style -> Inspection uses File {
    [path.Path; ~] => sources!
    option -> cliProject.appendDependencySources(sources!, style) => status
    Inspection { status: status, sources: sources! -> len }
}

main {
    path.nativeStyle() => style
    "examples/regression/projects/682-native-dependency-graph/valid/app" -> inspect(style) => valid
    "examples/regression/projects/682-native-dependency-graph/cycle/a" -> inspect(style) => cycle
    "examples/regression/projects/682-native-dependency-graph/name/app" -> inspect(style) => name
    "examples/regression/projects/682-native-dependency-graph/version/app" -> inspect(style) => version
    "examples/regression/projects/682-native-dependency-graph/remote/app" -> inspect(style) => remote

    "valid = $(valid.status),$(valid.sources)" -> println
    "cycle = $(cycle.status),$(cycle.sources)" -> println
    "name = $(name.status),$(name.sources)" -> println
    "version = $(version.status),$(version.sources)" -> println
    "remote = $(remote.status),$(remote.sources)" -> println
}
