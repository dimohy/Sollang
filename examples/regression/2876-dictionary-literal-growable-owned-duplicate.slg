struct OwnedValues {
    values: [Int; ~]
}

make value: Int -> [Int; ~] {
    [value, value; ~]
}

main {
    {1: OwnedValues { values: (1 -> make) }, 1: OwnedValues { values: (9 -> make) }} => batches!
    batches! -> len -> println
    batches! -> take(1) => retained
    retained.values[0] -> println
    batches! -> len -> println
}
