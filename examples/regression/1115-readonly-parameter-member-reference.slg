# A readonly by-value aggregate parameter materializes one call-scoped root
# before one of its fields is passed by readonly reference.
struct Packet {
    value: Int
}

readValue value: ref Int -> Int {
    value
}

readPacket packet: Packet -> Int {
    readValue(packet.value)
}

main {
    Packet { value: 7 } -> readPacket => value
    value == 7 -> if { "ok" -> println } else { "bad" -> println }
}
