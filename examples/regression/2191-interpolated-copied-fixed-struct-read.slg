struct Inner {
    values: [UInt8; 8]
}

struct Outer {
    inner: Inner
}

setFirst values: mut [UInt8; 8] -> Unit {
    9 => values[0]
}

main {
    Outer { inner: Inner { values: [7; 8] } } => original!
    original! => copied
    original!.inner.values -> setFirst
    "copied=$(copied.inner.values[0]),original=$(original!.inner.values[0])" -> println
}
