chooseValue values: [Int; 2], alternate: [Int; 2], choose: Bool -> Int {
    (choose -> if { values } else { alternate }) => selected
    selected[0]
}
main {
    [13, 257] => left
    [31, 37] => right
    left -> chooseValue(right, true) => first
    left -> chooseValue(right, false) => second
    first -> println
    second -> println
}
