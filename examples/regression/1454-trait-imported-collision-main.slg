import probe.other as other
import probe.comparison as contract
struct IntegerOrder { }
impl contract.Comparison for IntegerOrder {
    type Item = Int
    compare: self, left: Int, right: Int -> Int {
        left < right -> if { -1 } else {
            left > right -> if { 1 } else { 0 }
        }
    }
}

struct Algorithms { }
impl Algorithms {
    less<T, C>: self, left: T, right: T, comparison: C -> Bool where C: contract.Comparison, C.Item == T {
        comparison -> contract.Comparison.compare(left, right) < 0
    }
}

impl other.Comparison for IntegerOrder {
    type Item = Int
    compare: self, left: Int, right: Int -> Int {
        left > right -> if { -1 } else { 1 }
    }
}
main {
    Algorithms { } -> less(3, 7, IntegerOrder { }) -> println
    Algorithms { } -> less(7, 3, IntegerOrder { }) -> println
}
