# Nested fixed scalar fields retain independent storage after a borrowed copy.
struct Inner { values: [Int; 2] }
struct Outer { inner: Inner }
store holders: mut [Outer; ~], inner: Inner -> Unit {
    holders -> push(Outer { inner: inner })
}
mutate values: mut [Int; 2] -> Unit { 17 => values[0] }
main {
    [Outer; ~] => holders!
    Inner { values: [13, 257] } => inner!
    holders! -> store(inner!)
    inner!.values -> mutate
    holders![0].inner.values[0] -> println
    inner!.values[0] -> println
}
