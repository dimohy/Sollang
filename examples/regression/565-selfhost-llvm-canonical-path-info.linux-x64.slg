import sollang.compiler.llvm.text as llvm

main {
    [
    """
    namespace sys.path
    public struct Path {
        public bytes: [UInt8; ~]
        public style: Style
    }
    public struct RawInfo {
        public bytes: [UInt8; ~]
        public kindCode: UInt8
        public byteLength: UInt64
        public modifiedNanos: UInt64
    }
    public enum Style {
        Posix
        Windows
    }
    impl Path {
        public queryRaw: self -> Result<RawInfo, Text> uses File = intrinsic
    }
    public fromText value: Text, style: Style -> Path {
        [UInt8; ~] => bytes!
        UIntSize(0) => index!
        index! < (value -> len) -> while {
            bytes! -> push(value -> byte(index!))
            index! + UIntSize(1) => index!
        }
        Path { bytes: bytes!, style: style } => result!
        result!
    }
    """,
    """
    import sys.path as path
    main {
        "examples/regression/fixtures/425-directory-order/Alpha.txt" -> path.fromText(path.Style.Posix) => filePath!
        filePath! -> queryRaw => result!
    }
    """; ~
    ] => sources!
    sources! -> llvm.emit
}
