import std.crypto.tls13_keys as tls13
import std.net.quic.application_engine as application
import std.net.quic.error as errors
import std.net.quic.frame as frames
import std.net.quic.keys

secret: -> [UInt8; 32] => [68; 32]
connectionId: -> [UInt8] => [1, 2, 3, 4, 5, 6, 7, 8]
data: -> [UInt8; ~] => [112, 105, 110, 103; ~]

run: -> Result<Bool, errors.Error> {
    application.create(keys.version1(), secret()) => sender
    application.create(keys.version1(), secret()) => receiver!
    sender -> encode(
    connectionId(),
    1,
    frames.Value.Stream(frames.Stream {
        id: 0
        offset: 0
        fin: true
        data: data()
    }))? => protected
    receiver! -> open(
    protected,
    connectionId(),
    1)? => opened
    false => valid!
    opened.frame -> when {
        Stream(streamFrame) { streamFrame.data[0] == 112 => valid! }
        Padding(count) {}
        Ping {}
        Ack(ack) {}
        ResetStream(value) {}
        StopSending(value) {}
        Crypto(crypto) {}
        Datagram(datagram) {}
        MaxData(maximum) {}
        MaxStreamData(limit) {}
        MaxStreams(limit) {}
        DataBlocked(limit) {}
        StreamDataBlocked(blocked) {}
        StreamsBlocked(blocked) {}
        ConnectionClose(close) {}
        HandshakeDone {}
        NewConnectionId(value) {}
        RetireConnectionId(sequence) {}
    }
    sender -> encode(
    connectionId(),
    2,
    frames.Value.Datagram(frames.Datagram { data: data() }))? => protectedAgain
    receiver! -> open(
    protectedAgain,
    connectionId(),
    2)? => openedAgain
    openedAgain.frame -> when {
        Datagram(datagram) { (valid! and datagram.data[3] == 103) => valid! }
        Padding(count) {}
        Ping {}
        Ack(ack) {}
        ResetStream(value) {}
        StopSending(value) {}
        Crypto(crypto) {}
        Stream(streamFrame) {}
        MaxData(maximum) {}
        MaxStreamData(limit) {}
        MaxStreams(limit) {}
        DataBlocked(limit) {}
        StreamDataBlocked(blocked) {}
        StreamsBlocked(blocked) {}
        ConnectionClose(close) {}
        HandshakeDone {}
        NewConnectionId(value) {}
        RetireConnectionId(sequence) {}
    }
    Result<Bool, errors.Error>.Ok(valid!)
}

main {
    run() -> when {
        Ok(valid) { valid -> if { "owned-frame=ok" } else { "owned-frame=failed" } -> println }
        Err(error) { "owned-frame-error=$(error.code)" -> println }
    }
}
