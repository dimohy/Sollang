struct Literal {
    kind: Int
    value: UInt64
}
struct Package {
    literals: [Literal; ~]
}
struct Collected {
    literals: [Literal; ~]
    other: [Int; ~]
}
make: -> [Int; ~] { [7; ~] }
collect values: [Literal; ~] -> Collected {
    make() => other
    [Literal; ~] => output!
    values -> each literal { output! -> push(literal) }
    Collected { literals: output!, other: other }
}
main {
    Package { literals: [Literal { kind: 1, value: 42 }, Literal { kind: 2, value: 99 }; ~] } => package
    package.literals -> collect => result
    result.literals -> len -> println
    result.literals[0].value -> println
    result.literals[1].value -> println
    result.other[0] -> println
}

