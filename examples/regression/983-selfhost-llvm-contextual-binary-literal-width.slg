import sollang.compiler.llvm.text as llvm

# The bare divisor inherits UInt16 from its independently typed peer. The
# semantic result and physical LLVM producer must therefore both be i16.
main {
    [
        """
        highNibble value: UInt8 -> UInt16 => UInt16(value) / 16

        main {
            255 -> highNibble -> println
        }
        """; ~
    ] => sources
    sources -> llvm.emit
}
