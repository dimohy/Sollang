# Disabled allocation branches let the emitted contracts be inspected safely.
inspect enabled: Bool -> Unit uses Console {
    enabled -> if {
        [Int; 1_000_000_000~] => wideBytes
        wideBytes -> len -> println
        wideBytes -> capacity -> println
        [Int; 2_146_483_647~] => lastEncoded
        lastEncoded -> len -> println
        lastEncoded -> capacity -> println
        [Int; 2_146_483_648~] => firstOverflow
        firstOverflow -> len -> println
        firstOverflow -> capacity -> println
        [Int; 2_147_483_647~] => maximum
        maximum -> len -> println
        maximum -> capacity -> println
    }
}

main {
    false -> inspect
    "safe" -> println
}
