makeValues: -> Result<[UInt8; 8], Int> {
    [7; 8] -> Result<[UInt8; 8], Int>.Ok
}

forward source: ref Result<[UInt8; 8], Int> -> Result<[UInt8; 8], Int> {
    source -> when {
        Ok(values) { values -> Result<[UInt8; 8], Int>.Ok }
        Err(error) { error -> Result<[UInt8; 8], Int>.Err }
    }
}

main {
    makeValues() => original
    original -> forward -> when {
        Ok(values) { "forwarded=$(values[0])" -> println }
        Err(error) { "error=$error" -> println }
    }
    original -> when {
        Ok(values) { "original=$(values[0])" -> println }
        Err(error) { "error=$error" -> println }
    }
}
