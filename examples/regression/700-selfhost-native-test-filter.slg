import sollang.compiler.cli_test as cliTest
import sys.file as file

# A non-empty test filter selects only matching qualified test names.
main {
    [
        "tests/Sollang.NativeTestFixtures/success/src/main.slg",
        "tests/Sollang.NativeTestFixtures/success/src/native_tests/math.slg",
        "tests/Sollang.NativeTestFixtures/success/src/native_tests/test_support.slg",
        "tests/Sollang.NativeTestFixtures/success/tests/math_tests.slg";
        ~
    ] => sources
    sources -> cliTest.build(sources -> len, "addition") => plan
    "plan = $(plan.status),$(plan.count)" -> println
    plan.harness -> file.borrowBytes => harness
    harness -> slice(UIntSize(0), UIntSize(plan.harness -> len)) -> print
}
