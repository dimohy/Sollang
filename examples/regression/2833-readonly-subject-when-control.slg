selectValue value: ref Int -> Int {
    value -> when {
        >= 2 => 7
        else => 9
    }
}

selectRange value: ref Int -> Int {
    value -> when {
        1..4 => 8
        else => 6
    }
}

main {
    3 => source
    source -> selectValue -> println
    source -> selectRange -> println
}
