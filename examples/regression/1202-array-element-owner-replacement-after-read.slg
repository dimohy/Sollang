struct Chunk {
    values: [Int; ~]
}

appendValues output: mut [Int; ~], chunk: ref Chunk -> Unit {
    chunk.values -> len => valueCount
    0 => valueIndex!
    valueIndex! < valueCount -> while {
        output -> push(chunk.values[valueIndex!])
        valueIndex! + 1 => valueIndex!
    }
}

appendAndRelease output: mut [Int; ~], chunks: mut [Chunk; ~], index: Int -> Unit {
    output -> appendValues(chunks[index])
    Chunk { values: [Int; ~] } => chunks[index]
}

main {
    [Chunk { values: [1, 2; ~] }, Chunk { values: [3, 4; ~] }; ~] => chunks!
    [Int; ~] => values!
    values! -> appendAndRelease(chunks!, 0)
    values! -> appendAndRelease(chunks!, 1)
    0 => sum!
    0 => valueIndex!
    values! -> len => resultCount
    valueIndex! < resultCount -> while {
        sum! + values![valueIndex!] => sum!
        valueIndex! + 1 => valueIndex!
    }
    chunks![0].values -> len => firstRemaining
    chunks![1].values -> len => secondRemaining
    "sum=$(sum!) remaining=$firstRemaining,$secondRemaining" -> println
}
