struct Value {
    number: Int
}

struct Holder {
    value: Value
}

makeValue ready: Bool -> Result<Value, Int> {
    ready -> if {
        Result<Value, Int>.Ok(Value { number: 42 })
    } else {
        Result<Value, Int>.Err(7)
    }
}

makeHolder ready: Bool -> Result<Holder, Int> {
    ready -> makeValue -> when {
        Err(error) { Result<Holder, Int>.Err(error) -> return }
        Ok(value) { value }
    } => value
    Result<Holder, Int>.Ok(Holder { value: value })
}

main {
    true -> makeHolder -> when {
        Err(error) { "error=$error" -> println }
        Ok(holder) { "value=$(holder.value.number)" -> println }
    }
}
