import sollang.compiler.ir.typed as typedIr
import sollang.compiler.semantic.context as semanticContext

# A Bool block result bound before `if` remains the control condition after
# generic stream lowering and final Typed IR canonicalization.
main {
    [
        """
        filter<T> value: T -> stream T block item: T -> Bool {
            value -> yield => accepted
            accepted -> if {
                value -> emit
            }
        }
        """; ~
    ] => sources
    sources -> semanticContext.prepare => prepared
    prepared -> typedIr.lowerContext => ir
    0 => ifNodes!
    0 => unresolvedConditions!
    0 => referenceConditions!
    0 => boundConditions!
    0 => index!
    index! < (ir -> len) -> while {
        ir[index!] => node
        node.kind == 18 -> if {
            ifNodes! + 1 => ifNodes!
            node.operand0 < 0 -> if {
                unresolvedConditions! + 1 => unresolvedConditions!
            } else {
                ir[node.operand0] => condition
                condition.kind == 5 -> if {
                    referenceConditions! + 1 => referenceConditions!
                    (condition.operand0 >= 0 and ir[condition.operand0].kind == 17) -> if {
                        boundConditions! + 1 => boundConditions!
                    }
                }
            }
        }
        index! + 1 => index!
    }
    "ifs=$(ifNodes!),unresolved=$(unresolvedConditions!),references=$(referenceConditions!),bound=$(boundConditions!)" -> println
}
