# A projected readonly borrow rooted in a reference-return binding must use the
# binding's canonical pointer producer. A reference binding has no owned slot.
struct Record {
    values: [Int; ~]
}

borrow value: ref Record -> ref Record => value

measure prefix: Int, values: ref [Int; ~] -> Int {
    values -> len
}

main {
    Record { values: [3, 5; ~] } => record
    record -> borrow => current
    10 -> measure(current.values) => length
    "length=$length" -> println
}
