# Structured parallel arms share one affine owner only through readonly references.
length values: ref [Int; ~] -> Int => values -> len
first values: ref [Int; ~] -> Int => values[0]

main {
    [7, 8, 9; ~] => values
    values -> parallel branch {
        count: ref -> length
        head: ref -> first
    } => results

    "count=$(results.count)" -> println
    "head=$(results.head)" -> println
    "owner=$(values -> len)" -> println
}
