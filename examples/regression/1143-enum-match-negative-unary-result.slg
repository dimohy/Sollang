# An expression-bodied enum arm returns the outer unary value, not its positive literal child.
select value: Option<Long> -> Long => value -> when {
    Option<Long>.Some(number) => number
    Option<Long>.None => -1
}

main {
    Option<Long>.Some(7) -> select => some
    Option<Long>.None -> select => none
    "some=$some,none=$none" -> println
}
