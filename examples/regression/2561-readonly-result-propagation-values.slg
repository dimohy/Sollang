advance value: ref Result<Int64, Int> -> Result<Int64, Int> {
    value? => checked
    Result<Int64, Int>.Ok(checked + 1)
}

read value: Result<Int64, Int> -> Int64 {
    value -> when {
        Ok(number) { number }
        Err(error) { Int64(error) }
    }
}

main {
    Result<Int64, Int>.Ok(Int64(41)) => success
    Result<Int64, Int>.Err(7) => failure
    success -> advance -> read -> println
    failure -> advance -> read -> println
    success -> read -> println
    failure -> read -> println
}
