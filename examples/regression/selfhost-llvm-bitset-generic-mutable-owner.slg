# Verifies self-host LLVM mutation, membership, count, and length for inline BitSet.
import sollang.compiler.llvm.text as llvm

main {
    [
    """
    mark flags: mut BitSet<130> -> Unit { flags -> set(129) }
    forward<T> flags: mut T -> Unit { flags -> mark }
    main {
        BitSet<130>() => flags!
        flags! -> forward
        flags! -> contains(129) -> println
        flags! -> count -> println
    }
    """; ~
    ] => sources!
    sources! -> llvm.emit
}
