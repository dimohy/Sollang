struct Item {
    value: Int
}

makeItems count: Int -> [Item; ~] {
    [Item; ~] => items!
    0 => index!
    index! < count -> while {
        items! -> push(Item { value: index! + 1 })
        index! + 1 => index!
    }
    items!
}

main {
    2 -> makeItems => items
    items -> each outer {
        items -> each inner {
            "$(outer.value):$(inner.value)" -> println
        }
    }
}
