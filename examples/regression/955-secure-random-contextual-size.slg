import sys.crypto.random

run: -> Result<Int, random.Error> uses Random {
    random.bytes(8)? => bytes
    Result<Int, random.Error>.Ok(bytes -> len)
}

main {
    run() -> when {
        Ok(length) { "secure random contextual size=$length" -> println }
        Err(error) { "secure random failed" -> println }
    }
}
