enum Kind {
    First
    Second
}

struct Failure {
    kind: Kind
}

enum Outcome {
    Ok(Int)
    Err(Failure)
}

impl Failure {
    public errorKind: self -> Kind => self.kind
}

kindText kind: Kind -> Text => kind -> when {
    First { "first" }
    Second { "second" }
}

main {
    Outcome.Err(Failure { kind: Kind.Second }) -> when {
        Ok(value) { "unexpected=$value" -> println }
        Err(error) { "kind=$(error -> errorKind -> kindText)" -> println }
    }
}
