struct Algorithms { }
struct Point { value: Int }
trait Measure {
    measure: self -> Int
}
impl Measure for Point {
    measure: self -> Int => self.value
}
impl Algorithms {
    measured<T>: self, value: T -> Int where T: Measure {
        value -> Measure.measure
    }
}
main {
    Algorithms { } -> measured(Point { value: 50 }) => result
    "$result" -> println
}
