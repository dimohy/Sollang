import sollang.compiler.ast as ast
import sollang.compiler.ir.stream as streamIr
import sollang.compiler.ir.typed as typedIr
import sollang.compiler.llvm.emitter.context as emitterContext
import sollang.compiler.llvm.text as llvm
import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.library_imports as libraryImports
import sollang.compiler.semantic.type_ids as typeIds
import sollang.compiler.syntax as syntax

# S050 checks every arm: it rejects `Data` for a Result subject and accepts a
# separate match whose `Ok` and `Err` arms both belong to Result.
main {
    [
    typedIr.TypedIrNode { kind: 6, parent: 1, sourceModule: 0, astNode: 5, symbol: -1, targetModule: -1, typeOrigin: 4, typeModule: -1, typeSymbol: 1, typeId: 0, typeKind: 7, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 27, parent: -1, sourceModule: 0, astNode: 0, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: 0, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 27, parent: -1, sourceModule: 0, astNode: 4, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 0, typeId: 1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: 0, operand1: -1, nextOperand: -1, flags: 0 }; ~
    ] => ir
    [
    typeIds.SemanticType { kind: 7, origin: 4, module: -1, symbol: 1, first: 1, second: 1, length: -1, lengthHash: 0, containsParameter: false, status: 0 },
    typeIds.SemanticType { kind: 1, origin: 1, module: -1, symbol: 0, first: -1, second: -1, length: -1, lengthHash: 0, containsParameter: false, status: 0 }; ~
    ] => types
    [
    ast.AstNode { kind: 16, parent: -1, cstRuleId: -1, operatorKind: -1, payloadToken: -1, secondaryToken: -1, tertiaryToken: -1, flags: 0, firstToken: 0, tokenCount: 1, start: 0, length: 4 },
    ast.AstNode { kind: 58, parent: 0, cstRuleId: -1, operatorKind: -1, payloadToken: -1, secondaryToken: -1, tertiaryToken: -1, flags: 0, firstToken: 0, tokenCount: 1, start: 0, length: 4 },
    ast.AstNode { kind: 59, parent: 1, cstRuleId: -1, operatorKind: -1, payloadToken: 0, secondaryToken: -1, tertiaryToken: -1, flags: 0, firstToken: 0, tokenCount: 1, start: 0, length: 4 },
    ast.AstNode { kind: 16, parent: -1, cstRuleId: -1, operatorKind: -1, payloadToken: -1, secondaryToken: -1, tertiaryToken: -1, flags: 0, firstToken: 0, tokenCount: 3, start: 0, length: 9 },
    ast.AstNode { kind: 16, parent: -1, cstRuleId: -1, operatorKind: -1, payloadToken: -1, secondaryToken: -1, tertiaryToken: -1, flags: 0, firstToken: 1, tokenCount: 2, start: 4, length: 5 },
    ast.AstNode { kind: 58, parent: 4, cstRuleId: -1, operatorKind: -1, payloadToken: -1, secondaryToken: -1, tertiaryToken: -1, flags: 0, firstToken: 1, tokenCount: 1, start: 4, length: 2 },
    ast.AstNode { kind: 59, parent: 5, cstRuleId: -1, operatorKind: -1, payloadToken: 1, secondaryToken: -1, tertiaryToken: -1, flags: 0, firstToken: 1, tokenCount: 1, start: 4, length: 2 },
    ast.AstNode { kind: 58, parent: 4, cstRuleId: -1, operatorKind: -1, payloadToken: -1, secondaryToken: -1, tertiaryToken: -1, flags: 0, firstToken: 2, tokenCount: 1, start: 6, length: 3 },
    ast.AstNode { kind: 59, parent: 7, cstRuleId: -1, operatorKind: -1, payloadToken: 2, secondaryToken: -1, tertiaryToken: -1, flags: 0, firstToken: 2, tokenCount: 1, start: 6, length: 3 }; ~
    ] => nodes
    [
    syntax.SyntaxToken { kind: 0, span: syntax.SourceSpan { fileId: 0, start: 0, length: 4 } },
    syntax.SyntaxToken { kind: 0, span: syntax.SourceSpan { fileId: 0, start: 4, length: 2 } },
    syntax.SyntaxToken { kind: 0, span: syntax.SourceSpan { fileId: 0, start: 6, length: 3 } }; ~
    ] => tokens
    [
    analysis.SourceAnalysisRange { sourceModule: 0, astStart: 0, astCount: 9, tokenStart: 0, tokenCount: 3, symbolStart: 0, symbolCount: 0, nameStart: 0, nameCount: 0, termStart: 0, termCount: 0, typeStart: 0, typeCount: 0, literalStart: 0, literalCount: 0, constantFailureStart: 0, constantFailureCount: 0 }; ~
    ] => ranges
    emitterContext.EmitContext {
        initializerDiagnostics: []
        sources: ["DataOkErr",; ~]
        ranges: ranges
        nodes: nodes
        constantLiterals: []
        constantFailures: []
        tokens: tokens
        symbols: []
        calls: []
        finalCallResolvedByAst: []
        awaitSourceByAst: []
        libraries: libraryImports.LibraryCatalog { diagnosticCount: 0, bindings: [], sources: [], interfaces: [], runtimeLibraries: [] }
        libraryCalls: []
        libraryCallDiagnostics: []
        interpolationRanges: []
        interpolations: []
        ir: ir
        genericCallPlans: []
        genericBodies: typedIr.GenericBodyBindings { functionsByCall: [], templatesByFunction: [] }
        streamPlan: streamIr.StreamPlan { pipelines: [], stages: [], junctions: [], junctionInputs: [], partitionRoutes: [] }
        moves: []
        nominal: []
        composite: []
        modules: []
        imports: []
        resolvedImports: []
        types: types
        typeReferences: []
        typeTerms: []
        fields: []
        typeSizes: []
        typeAligns: []
        typeLayoutStatuses: []
        typeTraits: []
        pointerBitWidth: 64
        targetArchitecture: 1
        cpuDispatchPolicy: 0
        requiredCpuFeatures: 0
        allowedCpuFeatures: 0
        forbiddenCpuFeatures: 0
        supportsComputePool: false
        expectedPathStyle: 1
        usesConcurrentStreamJoins: false
        ownershipDiagnostics: []
    } => context
    [Int; ~] => functions
    context -> llvm.irInvariantCode(1, functions) => invalidCode
    context -> llvm.irInvariantCode(2, functions) => validCode
    "enum match variant invariants = $invalidCode,$validCode" -> println
}
