make: -> [UInt8; 1] { [13] }
read selected: Bool -> Int {
    0 => result!
    selected -> if {
        make() => bytes
        0 => index!
        index! < 1 -> while {
            Int(bytes[index!]) => result!
            index! + 1 => index!
        }
    }
    result!
}
main {
    true -> read -> println
    false -> read -> println
}
