import sys.path as path

# `Path.join` contains an enum `when` whose Boolean value feeds the
# `childAbsolute` binding and branch condition. Its match, binding, and read
# identities must converge on Bool before LLVM emission.
main {
    "/workspace" -> path.fromText(path.Style.Posix) => candidate
    candidate -> join("src") -> when {
        Ok(joined) {
            joined -> equalsText("/workspace/src") => matches
            "joined=$(matches)" -> println
        }
        Err(error) {
            "joined=false" -> println
        }
    }
}
