import sollang.compiler.llvm.text as llvm

main {
    [
    """
    minimum offset: Long -> Long => -9_223_372_036_854_775_807 - Long(1) + offset

    belowMinimum value: Long -> Bool => value < -9_223_372_036_854_775_807

    atMostMinimum value: Long -> Bool => value <= -9_223_372_036_854_775_807

    equalsMinimum value: Long -> Bool => value == -9_223_372_036_854_775_807

    differsMinimum value: Long -> Bool => value != -9_223_372_036_854_775_807

    aboveMinimum value: Long -> Bool => value > -9_223_372_036_854_775_807

    atLeastMinimum value: Long -> Bool => value >= -9_223_372_036_854_775_807

    main {
        minimum(5) => value
        belowMinimum(value) => below
        atMostMinimum(value) => atMost
        equalsMinimum(value) => equals
        differsMinimum(value) => differs
        aboveMinimum(value) => above
        atLeastMinimum(value) => atLeast
    }
    """; ~
    ] => sources
    sources -> llvm.emit
}
