main {
    [UInt64; ~] => hash!
    hash! -> push(1)
    hash! -> push(2)
    hash! -> push(3)
    hash! -> push(4)
    hash! -> push(5)
    hash! -> push(6)
    hash! -> push(7)
    hash! -> push(8)
    hash![0] == 1 -> if { "fixed-size-warning=ok" } else { "fixed-size-warning=failed" } -> println
}
