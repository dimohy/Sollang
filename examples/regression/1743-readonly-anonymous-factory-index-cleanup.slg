struct FactoryInner {
    data: [Int; ~]
}
struct FactoryFrame {
    inner: FactoryInner
}
makeFactoryFrames: -> [FactoryFrame; ~] {
    [FactoryFrame { inner: FactoryInner { data: [9, 10,; ~] } },; ~]
}
observeFactoryData data: [Int] -> Int => data -> len
main { makeFactoryFrames()[0].inner.data -> observeFactoryData -> println }
