seed: -> Result<Int, Int> => Result<Int, Int>.Ok(1)
bytes: -> [UInt8; 8] => [0; 8]

make: -> Result<[UInt8; 8], Int> {
    seed() -> when {
        Ok(value) {
            bytes() => buffer!
            UInt8(value + 6) => buffer![0]
            Result<[UInt8; 8], Int>.Ok(buffer!)
        }
        Err(error) { Result<[UInt8; 8], Int>.Err(error) }
    }
}

main {
    make() -> when {
        Ok(buffer) { "first=$(buffer[0])" -> println }
        Err(error) { "error=$error" -> println }
    }
}
