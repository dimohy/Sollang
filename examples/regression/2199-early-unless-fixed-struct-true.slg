struct Holder {
    values: [UInt8; 8]
}

create: -> Holder => Holder { values: [7; 8] }

setSecond values: mut [UInt8; 8] -> Unit {
    9 => values[1]
}

consume value: move Holder -> UInt8 {
    value.values[0]
}

guarded selected: Bool -> UInt8 {
    selected -> unless { 0 -> return }
    create() => owner!
    owner!.values -> setSecond
    owner! -> consume
}

main {
    true -> guarded => first
    "first=$first" -> println
}
