import sollang.compiler.llvm.text as llvm

# A missing qualified module call is a blocking semantic error. It must never
# be dropped from generated code as though the statement did not exist.
main {
    [
        """
        import missing.process as process

        main {
            1 -> process.exit
        }
        """; ~
    ] => sources!
    sources! -> llvm.emitChecked => diagnosticCount
    "diagnostics = $diagnosticCount" -> println
}
