ready value: Int -> Bool {
    value > 0
}

main {
    1 => value
    true => enabled
    # Boolean flow expressions remain valid operands of logical conditions.
    value == 1 and value > 0 and not (value -> ready)
        -> if { "first=entered" } else { "first=skipped" }
        -> println
    value == 1 and (enabled -> if { value > 0 } else { value < 0 })
        -> if { "second=entered" } else { "second=skipped" }
        -> println
}
