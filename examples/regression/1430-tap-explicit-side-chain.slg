audit value: Int -> Unit uses Console { value -> println }
add value: Int, amount: Int -> Int => value + amount
double value: Int -> Int => value * 2

run value: Int -> Int uses Console {
    value -> tap {
        -> add(3)
        -> audit
    } -> double
}

main {
    7 -> run => ordinary
    8 -> tap {
        -> add(4)
        -> audit
    } -> double => entry
    "ordinary=$ordinary,entry=$entry" -> println
}
