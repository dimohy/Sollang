import std.time as time

delayed value: Int -> async Int uses Clock {
    time.Duration { millis: 25 } => duration
    duration -> sleep -> await
    value
}

quick value: Int -> async Int uses Clock {
    time.Duration { millis: 1 } => duration
    duration -> sleep -> await
    value
}

veryDelayed value: Int -> async Int uses Clock {
    time.Duration { millis: 1000 } => duration
    duration -> sleep -> await
    value
}

main {
    time.monotonicClock() => clock
    clock -> now => started
    1 -> delayed => slow
    2 -> quick => fast

    time.Duration { millis: 1000 } => cancelDuration
    cancelDuration -> sleep => cancelled
    3 -> veryDelayed => cancelledParent
    time.Duration { millis: 0 } => zeroDuration
    zeroDuration -> sleep -> await
    cancelled -> cancel
    cancelledParent -> cancel

    fast -> await => fastValue
    slow -> await => slowValue
    time.Duration { millis: 0 } => finalZeroDuration
    finalZeroDuration -> sleep -> await
    clock -> now => finished
    finished -> durationSince(started) -> when {
        Ok(elapsed) {
            elapsed.millis >= 20 -> if {
                "fast=$fastValue,slow=$slowValue,cancelled=true,parent=true,elapsed=true" -> println
            } else {
                "fast=$fastValue,slow=$slowValue,cancelled=true,parent=true,elapsed=false" -> println
            }
        }
        Err(error) {
            "fast=$fastValue,slow=$slowValue,cancelled=true,parent=true,elapsed=false" -> println
        }
    }
}
