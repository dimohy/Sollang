import sys.runtime as rt

main {
    "artifacts/sorted-int-runtime-regression.i64" -> rt.openIntWriter
    0 => value!
    value! < 8200 -> while {
        value! -> rt.writeInt
        value! + 1 => value!
    }
    rt.closeIntWriter()
    "artifacts/sorted-int-runtime-regression.i64" -> rt.openIntReader
    0 -> rt.closestInt -> println
    8191 -> rt.closestInt -> println
    8192 -> rt.closestInt -> println
    8199 -> rt.closestInt -> println
    9000 -> rt.closestInt -> println
    rt.closeIntReader()
}
