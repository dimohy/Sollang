# Imported Result payload members anchor a named arithmetic call argument.
import std.net.quic.varint
import std.net.quic.error as errors

copyPayload bytes: [UInt8], offset: UIntSize -> UIntSize => offset

advance bytes: [UInt8] -> Result<UIntSize, errors.Error> {
    varint.decode(bytes, 0)? => cursor
    cursor.nextOffset + 1 => offset
    copyPayload([], offset) => next
    Result<UIntSize, errors.Error>.Ok(next)
}

main {
    advance([0]) -> when {
        Ok(offset) { "offset=$offset" -> println }
        Err(error) { "error" -> println }
    }
}
