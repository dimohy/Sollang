enum Item {
    Bytes([UInt8; ~])
    Marker(Int)
}

append output: mut [UInt8; ~], bytes: [UInt8] -> Unit {
    0 => index!
    index! < (bytes -> len) -> while {
        output -> push(bytes[index!])
        index! + 1 => index!
    }
}

consume items: mut [Item; ~] -> Result<[UInt8; ~], Int> {
    [UInt8; ~] => output!
    (items -> len) > 0 -> while {
        items -> take(0) -> when {
            Bytes(bytes) { output! -> append(bytes) }
            Marker(value) { output! -> push(UInt8(value)) }
        }
    }
    Result<[UInt8; ~], Int>.Ok(output!)
}

run: -> Result<Bool, Int> {
    [Item; ~] => firstItems!
    firstItems! -> push(Item.Bytes([1, 2, 3; ~]))
    consume(firstItems!)? => first

    [Item; ~] => secondItems!
    secondItems! -> push(Item.Bytes([4, 5, 6; ~]))
    consume(secondItems!)? => second

    Result<Bool, Int>.Ok(first[0] == 1 and second[2] == 6)
}

main {
    run() -> when {
        Ok(valid) { valid -> if { "consecutive-owned-parameter=ok" } else { "consecutive-owned-parameter=failed" } -> println }
        Err(value) { "consecutive-owned-parameter-error" -> println }
    }
}
