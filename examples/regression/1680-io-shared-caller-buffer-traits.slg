import std.io as io

run: -> Result<Bool, io.Error> uses Console {
    io.memoryReader([10, 20, 30], 3)? => reader!
    [UInt8; ~] => output!
    output! -> push(0)
    output! -> push(0)
    output! -> push(0)
    reader! -> io.Reader.readInto(output!)? => readCount
    "read=$readCount,$(output![0]),$(output![1]),$(output![2]),pos=$(reader! -> position)" -> println

    io.memoryWriter(2)? => writer!
    writer! -> io.Writer.write(output!)? => writeCount
    writer! -> intoBytes => written
    "write=$writeCount,$(written[0]),$(written[1])" -> println
    Result<Bool, io.Error>.Ok(true)
}

main {
    run() -> when {
        Ok(value) { }
        Err(failure) { "unexpected-error@$(failure -> errorOffset)" -> println }
    }
}
