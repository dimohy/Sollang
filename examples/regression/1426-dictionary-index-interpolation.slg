show values: ref {Int: Int}, enabled: Bool -> Unit uses Console {
    enabled -> if {
        "borrowed=$(values[7])" -> println
    } else {
        "off" -> println
    }
}

main {
    {7: 70, 2: 20, 11: 110} => values!
    "literal=$(values![2]),$(values![11])" -> println
    values! -> put(7, 77)
    values! -> show(true)
    {"red": 10, "blue": 20} => colors
    "blue" => key
    "text=$(colors[key])" -> println
}
