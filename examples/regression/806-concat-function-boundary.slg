# Concat crosses a function boundary and drains its affine input producers in product order.
import std.sequence

makeValues values: Range -> Stream<Int> {
    values -> defer
}

concatValues first: move Stream<Int>, second: move Stream<Int> -> Stream<Int> {
    (first, second) -> concat
}

main {
    1..2 -> makeValues => first
    4..5 -> makeValues => second
    first -> concatValues(second) => joined
    joined -> each value {
        "$value" -> println
    }
}
