struct Selection {
    unique: Int
    last: Int
}

build values: ref [Int; ~] -> {Int: Selection} {
    {Int: Selection; 16~} => result!
    values -> each value {
        result! -> put(value, Selection { unique: value, last: value })
    }
    result!
}

main {
    [7, 9; ~] => values
    values -> build => table
    (table[7].unique == 7 and table[9].last == 9) -> println
}
