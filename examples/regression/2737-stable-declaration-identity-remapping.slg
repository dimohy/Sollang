import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.modules as modules
import sollang.compiler.semantic.module_interfaces as interfaces

namedSymbol package: ref analysis.PackageAnalysis, kind: Int, name: Text -> Int {
    package.ranges[0] => range
    0 => index!
    index! < range.symbolCount -> while {
        package.symbols[range.symbolStart + index!] => symbol
        symbol.kind == kind and symbol.nameToken >= 0
            -> if {
                package.tokens[range.tokenStart + symbol.nameToken] => token
                package.sources[0] -> slice(token.span.start, token.span.length) => actual
                actual == name -> if { index! -> return }
            }
        index! + 1 => index!
    }
    -1
}

forceLookupHashes hashes: mut [UInt64; ~], value: UInt64 -> Unit {
    0 => index!
    index! < (hashes -> len) -> while {
        value => hashes[index!]
        index! + 1 => index!
    }
}

main {
    ["namespace numeric_cache.provider\n\npublic struct Entry { public value: Int }\npublic struct Other { public marker: Int }\npublic entry: -> Entry => Entry { value: 1 }\n"; ~] -> analysis.analyze => original
    original -> modules.identitiesAnalyzed => originalModules
    original -> namedSymbol(3, "Entry") => oldType
    original -> namedSymbol(7, "entry") => oldFunction
    original -> interfaces.declarationIdentityAnalyzed(originalModules, 0, oldType) => typeKey
    original -> interfaces.declarationIdentityAnalyzed(originalModules, 0, oldFunction) => functionKey

    ["namespace numeric_cache.provider\n\nhidden: -> Int => 99\npublic struct Other { public marker: Int }\npublic struct Entry { public value: Int }\npublic entry: -> Entry => Entry { value: 2 }\n"; ~] -> analysis.analyze => reordered
    reordered -> modules.identitiesAnalyzed => currentModules
    reordered -> interfaces.declarationIdentitiesAnalyzed(currentModules) => currentIndex!
    reordered -> namedSymbol(3, "Entry") => currentType
    reordered -> namedSymbol(7, "entry") => currentFunction
    currentIndex! -> interfaces.findDeclarationIdentity(typeKey.words) => foundType
    foundType.status == 0 and foundType.sourceModule == 0 and foundType.symbol == currentType => typePreserved
    typePreserved -> println
    currentIndex! -> interfaces.findDeclarationIdentity(functionKey.words) => foundFunction
    foundFunction.status == 0 and foundFunction.symbol == currentFunction => functionPreserved
    functionPreserved -> println

    currentIndex!.keyIndexBySymbol[reordered.ranges[0].symbolStart + currentType] => keyIndex
    currentIndex!.hashes[keyIndex] => forcedHash
    currentIndex!.hashes -> forceLookupHashes(forcedHash)
    currentIndex! -> interfaces.findDeclarationIdentity(typeKey.words) => fullMatch
    fullMatch.status == 0 and fullMatch.symbol == currentType => collisionRejected
    collisionRejected -> println

    ["namespace identity.mmmmmmmmmmmmmmmmmmmmmmmm\npublic struct Entry { public value: Int }\n","namespace identity.nkllmlnlmpnjnmnmmomooioj\npublic struct Entry { public value: Int }\n"; ~] -> analysis.analyze => collisionPackage
    collisionPackage -> modules.identitiesAnalyzed => collisionModules
    collisionPackage -> interfaces.declarationIdentitiesAnalyzed(collisionModules) => collisionIndex
    collisionPackage -> interfaces.declarationIdentityAnalyzed(collisionModules, 1, 0) => rightKey
    collisionIndex -> interfaces.findDeclarationIdentity(rightKey.words) => rightMatch
    collisionModules[0].pathHash == collisionModules[1].pathHash
        and rightMatch.status == 0 and rightMatch.sourceModule == 1 => namespacePreserved
    namespacePreserved -> println

    ["namespace numeric_cache.provider\n\npublic struct Entry { public value: Int }\npublic struct Other { public marker: Int }\npublic entry: -> Entry => Entry { value: 1 }\n","namespace numeric_cache.provider\n\npublic struct Entry { public value: Int }\npublic struct Other { public marker: Int }\npublic entry: -> Entry => Entry { value: 1 }\n"; ~] -> analysis.analyze => duplicate
    duplicate -> modules.identitiesAnalyzed => duplicateModules
    duplicate -> interfaces.declarationIdentitiesAnalyzed(duplicateModules) => duplicateIndex
    duplicateIndex -> interfaces.findDeclarationIdentity(typeKey.words) => ambiguous
    ambiguous.status == 2 and ambiguous.sourceModule == -1 and ambiguous.symbol == -1 => ambiguityRejected
    ambiguityRejected -> println

    ["namespace missing\npublic struct Entry { public value: Int }\n"; ~] -> analysis.analyze => absent
    absent -> modules.identitiesAnalyzed => absentModules
    absent -> interfaces.declarationIdentityAnalyzed(absentModules, 0, 0) => absentKey
    currentIndex! -> interfaces.findDeclarationIdentity(absentKey.words) => notFound
    notFound.status == 1 -> println

    ["namespace 네임.모듈\npublic struct 이름 { public 값: Int }\n"; ~] -> analysis.analyze => unicodePackage
    unicodePackage -> modules.identitiesAnalyzed => unicodeModules
    unicodePackage -> interfaces.declarationIdentitiesAnalyzed(unicodeModules) => unicodeIndex
    unicodePackage -> interfaces.declarationIdentityAnalyzed(unicodeModules, 0, 0) => unicodeKey
    unicodeIndex -> interfaces.findDeclarationIdentity(unicodeKey.words) => unicodeMatch
    unicodeMatch.status == 0 and unicodeMatch.symbol == 0 => unicodePreserved
    unicodePreserved -> println
}
