primary8 value: Int8 -> Unit uses Console { value -> println }
additional8 ignored: Int, value: UInt8 -> Unit uses Console { value -> println }
primary16 value: Int16 -> Unit uses Console { value -> println }
additional16 ignored: Int, value: UInt16 -> Unit uses Console { value -> println }
main {
    127 -> primary8
    0 -> additional8(255)
    32767 -> primary16
    0 -> additional16(65535)
}
