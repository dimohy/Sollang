# A sequential named branch nested in a value-producing control region must
# materialize each arm before assembling the labeled product.
double value: Int -> Int => value * 2

square value: Int -> Int => value * value

source value: Int -> Result<Int, Text> => Result<Int, Text>.Ok(value)

main {
    source(5) -> when {
        Ok(value) {
            value -> branch {
                doubled: -> double
                squared: -> square
            } => values
            values.doubled + values.squared -> println
        }
        Err(message) { message -> println }
    }
}
