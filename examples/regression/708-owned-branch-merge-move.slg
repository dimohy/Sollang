struct Packet {
    left: [UInt8; ~]
    right: [UInt8; ~]
}

pushIf packets: mut [Packet; ~], chooseFirst: Bool, left: move [UInt8; ~], right: move [UInt8; ~] -> Unit {
    chooseFirst -> if {
        packets -> push(Packet { left: left, right: right })
    } else {
        packets -> push(Packet { left: left, right: right })
    }
}

pushWhen packets: mut [Packet; ~], choice: Int, left: move [UInt8; ~], right: move [UInt8; ~] -> Unit {
    choice -> when {
        == 1 {
            packets -> push(Packet { left: left, right: right })
        }
        else {
            packets -> push(Packet { left: left, right: right })
        }
    }
}

main {
    [Packet; ~] => packets!

    [UInt8(1); ~] => ifTrueLeft!
    [UInt8(2); ~] => ifTrueRight!
    packets! -> pushIf(true, ifTrueLeft!, ifTrueRight!)

    [UInt8(3); ~] => ifFalseLeft!
    [UInt8(4); ~] => ifFalseRight!
    packets! -> pushIf(false, ifFalseLeft!, ifFalseRight!)

    [UInt8(5); ~] => whenFirstLeft!
    [UInt8(6); ~] => whenFirstRight!
    packets! -> pushWhen(1, whenFirstLeft!, whenFirstRight!)

    [UInt8(7); ~] => whenElseLeft!
    [UInt8(8); ~] => whenElseRight!
    packets! -> pushWhen(2, whenElseLeft!, whenElseRight!)

    packets! -> len => count
    "branch move count=$count" -> println
}
