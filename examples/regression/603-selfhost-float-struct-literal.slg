import sollang.compiler.ir.typed as typedIr

main {
    """
    abi struct Point {
        x: Float64
        y: Float64
    }

    main {
        Point { x: Double(3.0), y: Double(4.0) } => point!
    }
    """ => source
    [source,; ~] -> typedIr.lower => nodes!
    0 => entries!
    0 => structLiterals!
    nodes! -> each node {
        node.kind == 11 -> if { entries! + 1 => entries! }
        node.kind == 12 -> if { structLiterals! + 1 => structLiterals! }
    }
    "entry=$(entries!), struct=$(structLiterals!)" -> println
}
