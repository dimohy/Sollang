forward values: [UInt8; 8] -> Result<[UInt8; 8], Int> {
    values -> Result<[UInt8; 8], Int>.Ok
}

main {
    [UInt8(7); 8] => original!
    original! -> forward -> when {
        Ok(values) { "forwarded=$(values[0])" -> println }
        Err(error) { "error=$error" -> println }
    }
    9 => original![0]
    "original=$(original![0])" -> println
}
