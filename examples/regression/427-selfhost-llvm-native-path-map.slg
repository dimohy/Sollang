import sollang.compiler.llvm.text as llvm

# The .root.txt test input supplies canonical standard-library providers.
# The runner materializes this program and compares its execution with C#.
main {
    [
        """
        import sys.path as path
        import sys.file as file

        main {
            "examples/regression/fixtures/425-directory-order/Alpha.txt" -> path.fromText(path.nativeStyle()) => sourcePath
            sourcePath -> file.mapPath => source
            (source -> len) == 6 -> if {
                "selfhost path map ok" -> println
            } else {
                "unexpected" -> println
            }
        }
        """; ~
    ] => sources
    sources -> llvm.emit
}
