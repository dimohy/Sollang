struct Holder {
    values: [UInt8; 8]
}

makeValues: -> Result<[UInt8; 8], Int> {
    [UInt8(0); 8] => values!
    7 => values![0]
    Result<[UInt8; 8], Int>.Ok(values!)
}

makeHolder: -> Result<Holder, Int> {
    makeValues()? => values
    Holder { values: values } -> Result<Holder, Int>.Ok
}

main {
    makeHolder() -> when {
        Ok(holder) { "first=$(holder.values[0])" -> println }
        Err(error) { "error=$error" -> println }
    }
}
