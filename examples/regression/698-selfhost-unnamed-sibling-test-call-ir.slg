import sollang.compiler.ir.typed as typedIr
import sollang.compiler.semantic.context as semanticContext

# A generated test harness is an unnamed source fragment. Its direct call to a
# test in another unnamed fragment must resolve to that exact source/symbol.
main {
    """
    test_expected_failure: -> Bool => 1 == 2
    """ => testSource
    """
    main {
        test_expected_failure() -> if {}
    }
    """ => harnessSource
    [testSource, harnessSource; ~] => sources
    sources -> semanticContext.prepare => prepared
    prepared.calls -> each call {
        "call=$(call.sourceModule),$(call.callAst),$(call.origin),$(call.targetModule),$(call.targetSourceModule),$(call.functionSymbol),$(call.status)" -> println
    }
    prepared -> typedIr.lowerContext => ir
    0 => nodeIndex!
    nodeIndex! < (ir -> len) -> while {
        ir[nodeIndex!] => node
        (node.kind == 0 or node.kind == 6) -> if {
            "ir=$(nodeIndex!),$(node.kind),$(node.sourceModule),$(node.symbol),$(node.targetModule),$(node.operand0),$(node.operand1),$(node.nextOperand),$(node.flags)" -> println
        }
        nodeIndex! + 1 => nodeIndex!
    }
}
