parseDigits text: Text -> Int uses Console {
    0 => capacity!
    UIntSize(0) => byteIndex!
    byteIndex! < (text -> len) -> while {
        text -> byte(byteIndex!) => digit
        digit != 95 -> if {
            text -> slice(byteIndex!, 1) -> print
            capacity! * 10 + Int(digit - 48) => capacity!
        }
        byteIndex! + 1 => byteIndex!
    }
    "=" -> print
    capacity! -> println
    capacity!
}

main {
    parseDigits("1_2") => parsed
}
