import sollang.compiler.cli_package_lock as locks
import sollang.compiler.cli_project as cliProject
import sys.path as path

main {
    path.nativeStyle() => style
    [path.Path; ~] => sources!
    [path.Path; ~] => manifests!
    [path.Path; ~] => names!
    [path.Path; ~] => versions!
    "examples/regression/projects/682-native-dependency-graph/valid/app" -> cliProject.resolvePathGraph(sources!, manifests!, names!, versions!, style) => status
    manifests! -> locks.render(names!, versions!, style) => bytes
    path.Path { bytes: bytes, style: path.Style.Posix } => lockText
    path.pathText(lockText) => rendered
    "status = $status" -> println
    rendered -> print
}
