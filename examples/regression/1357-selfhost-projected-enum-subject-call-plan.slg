import std.net.quic.stream_state

# A projected enum subject must not inherit the inner function call target.
verify id: UInt64 -> Unit uses Console {
    stream_state.identity(id).direction -> when {
        Bidirectional { true }
        Unidirectional { false }
    } => bidirectional
    "projected-enum-subject=$(bidirectional)" -> println
}

main {
    verify(0)
}
