checked value: Int, delta: Int -> Result<Int, Text> {
    value == 2 -> if { Result<Int, Text>.Err("two") -> return }
    Result<Int, Text>.Ok(value + delta)
}
makeDelta seed: Int -> Int => seed + 3

main {
    [1, 3; ~] -> tryParallel value {
        value -> checked((true -> if { 5 } else { 6 }))
    } => success
    success -> when {
        Ok(values) { "$(values[0]),$(values[1])" -> println }
        Err(error) { error -> println }
    }

    [1, 2; ~] -> tryParallel value {
        value -> checked(makeDelta(1))
    } => failure
    failure -> when {
        Ok(values) { "unexpected" -> println }
        Err(error) { error -> println }
    }

    [Int; ~] => empty
    empty -> tryParallel value {
        value -> checked(3 + 4)
    } => emptyResult
    emptyResult -> when {
        Ok(values) { "empty=$(values -> len)" -> println }
        Err(error) { error -> println }
    }
}
