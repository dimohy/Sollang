import sollang.compiler.llvm.text as llvm

# Read-only SourceText helpers receive a reference to the affine owner. Text
# view intrinsics load that reference without moving or unmapping the source.
main {
    [
        """
        import sys.file as file

        inspect source: ref file.SourceText -> Unit {
            Int(source -> byte(UIntSize(0))) -> println
            source -> slice(UIntSize(0), UIntSize(1)) -> println
        }

        main {
            "syntax/sollang.lexer" => path
            path -> file.mapText => source!
            source! -> inspect
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
