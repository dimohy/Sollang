struct Packet {
    bytes: [UInt8; 4]
}

makeBytes: -> [UInt8; 4] {
    [UInt8(0); 4] => bytes!
    0 => index!
    index! < 4 -> while {
        UInt8(index!) => bytes![index!]
        index! + 1 => index!
    }
    bytes!
}

main {
    makeBytes() => bytes
    Packet { bytes: bytes } => packet
    ((packet.bytes -> len) == 4 and packet.bytes[3] == 3) -> if {
        "fixed-field=ok"
    } else {
        "fixed-field=failed"
    } -> println
}
