make: -> [UInt8; 1] { [13] }

select selected: Bool -> [UInt8; 1] {
    selected -> if {
        make() => bytes
        bytes
    } else {
        [UInt8(17)]
    }
}

read selected: Bool -> Int {
    selected -> select => bytes
    Int(bytes[0])
}

main {
    true -> read -> println
    false -> read -> println
}
