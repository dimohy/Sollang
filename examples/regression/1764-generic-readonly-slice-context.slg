struct Ordering { }
impl Ordering {
    count<T>: self, values: [T] -> Int => values -> len
}

integers count: Int -> [Int; ~] {
    [Int; ~] => values!
    0 => index!
    index! < count -> while {
        values! -> push(index! + 1)
        index! + 1 => index!
    }
    values!
}

main {
    2 -> integers => numbers
    ["one", "two"] => words
    Ordering { } -> count(numbers) -> println
    Ordering { } -> count(words) -> println
}
