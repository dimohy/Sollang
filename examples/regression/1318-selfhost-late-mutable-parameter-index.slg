pickLast first: mut [Int; ~], readonly: [Int], second: mut [Int; ~], last: mut [Int; ~], index: Int -> Int {
    last[index]
}

main {
    [1; ~] => first!
    [2] => readonly
    [3, 4; ~] => second!
    [7, 8, 9; ~] => last!
    first! -> pickLast(readonly, second!, last!, 2) => selected
    "selected=$selected" -> println
}
