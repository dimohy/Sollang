import sollang.compiler.llvm.text as llvm

# Imported nested value members in function and entry arithmetic must project
# every canonical field before the scalar operation.
main {
    [
        """
        namespace fixture.syntax

        public struct Span {
            public start: UIntSize
            public length: UIntSize
        }

        public struct Token {
            public kind: Int
            public span: Span
        }
        """,
        """
        namespace fixture.main
        import fixture.syntax as syntax

        offset token: syntax.Token, index: UIntSize -> UIntSize {
            token.span.start + index
        }

        main {
            syntax.Token { kind: 1, span: syntax.Span { start: 40, length: 2 } } => token
            "function=$(token -> offset(2))" -> println
            "entry=$(token.span.start + 2)" -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
