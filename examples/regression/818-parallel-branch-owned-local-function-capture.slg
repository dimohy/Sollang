# Parallel branch shares an owned immutable Text capture by readonly address until every arm joins.
measure value: Int, prefix: Text -> (left: Int, right: Int) {
    addLength input: Int -> Int => input + Int(prefix -> len)

    value -> parallel branch {
        left: -> addLength
        right: -> addLength
    }
}

main {
    7 -> measure("item") => result
    "$(result.left):$(result.right)" -> println
}
