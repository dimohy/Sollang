show value: ref Int -> Unit uses Console { value -> println }
showLong value: ref Long -> Unit uses Console { value -> println }
showBool value: ref Bool -> Unit uses Console { value -> println }
showText value: ref Text -> Unit uses Console { value -> print
    value -> println }
main {
    -7 => number
    Long(42) => wide
    true => flag
    "hello" => label
    number -> show
    wide -> showLong
    flag -> showBool
    label -> showText
    true -> if {
        number -> show
        wide -> showLong
        flag -> showBool
        label -> showText
    }
}
