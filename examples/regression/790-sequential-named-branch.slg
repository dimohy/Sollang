# A sequential branch evaluates named arms in source order and returns a labeled product.
double value: Int -> Int => value * 2
increment value: Int -> Int => value + 1
combine parts: (doubled: Int, incremented: Int) -> Int => parts.doubled + parts.incremented

main {
    5
        -> branch {
            doubled: -> double
            incremented: -> increment
        }
        -> combine
        => total
    "$total" -> println
}
