import sollang.compiler.llvm.text as llvm

main {
    [
        """
        namespace std.net.socket

        public struct TcpStream {
            public token: UInt64
        }

        public enum SocketErrorKind {
            Other
        }

        public enum ShutdownDirection {
            Receive
            Send
            Both
        }

        public struct SocketError {
            public kind: SocketErrorKind
            public code: Int32
        }

        impl TcpStream {
            public shutdown: self, direction: ShutdownDirection -> Result<Unit, SocketError> uses Network = intrinsic
        }
        """,
        """
        import std.net.socket as socket

        closeInBranch condition: Bool, connection: socket.TcpStream -> Result<Unit, socket.SocketError> uses Network {
            condition -> if {
                connection -> shutdown(socket.ShutdownDirection.Both)
            } else {
                connection -> shutdown(socket.ShutdownDirection.Both)
            }
        }

        main {
            "nested-socket-intrinsic" -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
