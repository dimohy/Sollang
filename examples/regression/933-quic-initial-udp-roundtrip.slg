import sys.quic.error as errors
import sys.quic.initial_engine as initial
import sys.quic.keys
import sys.quic.tls_hello as hello
import sys.socket as socket

randomBytes: -> [UInt8; 32] => [1; 32]
clientKeyShare: -> [UInt8; 32] => [2; 32]
serverKeyShare: -> [UInt8; 32] => [3; 32]
originalDestinationConnectionId: -> [UInt8] => [131, 148, 200, 240, 62, 81, 87, 8]
clientSourceConnectionId: -> [UInt8] => [17, 18, 19, 20, 21, 22, 23, 24]
serverSourceConnectionId: -> [UInt8] => [33, 34, 35, 36, 37, 38, 39, 40]

ioError code: Int32 -> errors.Error {
    errors.Error { kind: errors.Kind.Io, code: UInt64(UInt32(code)) }
}

bind endpoint: socket.Endpoint -> Result<socket.UdpSocket, errors.Error> uses Network {
    socket.bindDatagram({ endpoint: endpoint, reuseAddress: true }) -> when {
        Ok(datagram) { Result<socket.UdpSocket, errors.Error>.Ok(datagram) }
        Err(error) { Result<socket.UdpSocket, errors.Error>.Err(ioError(error.code)) }
    }
}

localPort datagram: socket.UdpSocket -> Result<UInt16, errors.Error> uses Network {
    socket.localPort(datagram) -> when {
        Ok(port) { Result<UInt16, errors.Error>.Ok(port) }
        Err(error) { Result<UInt16, errors.Error>.Err(ioError(error.code)) }
    }
}

sendTo datagram: socket.UdpSocket, endpoint: socket.Endpoint, bytes: ref [UInt8; ~] -> Result<UIntSize, errors.Error> uses Network {
    socket.sendTo(datagram, endpoint, bytes) -> when {
        Ok(count) { Result<UIntSize, errors.Error>.Ok(count) }
        Err(error) { Result<UIntSize, errors.Error>.Err(ioError(error.code)) }
    }
}

receiveFrom datagram: socket.UdpSocket, maxBytes: UIntSize -> Result<socket.Datagram, errors.Error> uses Network {
    socket.receiveFrom(datagram, maxBytes) -> when {
        Ok(received) { Result<socket.Datagram, errors.Error>.Ok(received) }
        Err(error) { Result<socket.Datagram, errors.Error>.Err(ioError(error.code)) }
    }
}

requireFullDatagram count: UIntSize, expected: UIntSize -> Result<Unit, errors.Error> {
    count == expected -> if {
        Result<Unit, errors.Error>.Ok
    } else {
        Result<Unit, errors.Error>.Err(errors.Error { kind: errors.Kind.Io, code: UInt64(count) })
    }
}

roundtrip: -> Result<Bool, errors.Error> uses Network {
    socket.Endpoint { address: "127.0.0.1", port: 0 } -> bind? => server
    server -> localPort? => serverPort
    socket.Endpoint { address: "127.0.0.1", port: 0 } -> bind? => client

    hello.encodeClientHello(
        randomBytes(),
        [115, 111, 108, 108, 97, 110, 103, 45, 112, 101, 101, 114],
        [104, 51],
        clientKeyShare(),
        [1])? => clientHello
    initial.encodeClientInitial(
        keys.version2(),
        originalDestinationConnectionId(),
        clientSourceConnectionId(),
        0,
        clientHello)? => clientPacket
    socket.Endpoint { address: "127.0.0.1", port: serverPort } => serverEndpoint
    sendTo(client, serverEndpoint, clientPacket)? => clientSent
    requireFullDatagram(clientSent, UIntSize(clientPacket -> len))?

    receiveFrom(server, 2_048)? => request
    initial.acceptClientInitial(request.bytes, 0)? => accepted
    hello.encodeServerHello(randomBytes(), serverKeyShare())? => serverHello
    initial.encodeServerInitial(accepted, serverSourceConnectionId(), 0, serverHello)? => serverPacket
    socket.Endpoint { address: "127.0.0.1", port: request.sourcePort } => clientEndpoint
    sendTo(server, clientEndpoint, serverPacket)? => serverSent
    requireFullDatagram(serverSent, UIntSize(serverPacket -> len))?

    receiveFrom(client, 2_048)? => response
    initial.openServerInitial(
        response.bytes,
        keys.version2(),
        originalDestinationConnectionId(),
        clientSourceConnectionId(),
        0)? => opened
    Result<Bool, errors.Error>.Ok(
        (request.bytes -> len) >= 1_200
            and accepted.packetNumber == 0
            and opened.packetNumber == 0
            and opened.serverSourceConnectionId[0] == 33
            and opened.serverSourceConnectionId[7] == 40)
}

main {
    roundtrip() -> when {
        Ok(valid) { valid -> if { "quic-initial-udp=ok" } else { "quic-initial-udp=failed" } -> println }
        Err(error) { "quic-initial-udp-error=$(error.code)" -> println }
    }
}
