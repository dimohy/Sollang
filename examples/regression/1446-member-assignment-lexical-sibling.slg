struct Item { value: Int }

run: -> Int {
    0 => sum!
    0 => first!
    first! < 1 -> while {
        Item { value: 1 } => item!
        300 => item!.value
        sum! + item!.value => sum!
        first! + 1 => first!
    }
    0 => second!
    second! < 1 -> while {
        Item { value: 2 } => item!
        17 => item!.value
        sum! + item!.value => sum!
        second! + 1 => second!
    }
    sum!
}

main {
    run() -> println
    0 => sum!
    0 => first!
    first! < 1 -> while {
        Item { value: 1 } => item!
        300 => item!.value
        sum! + item!.value => sum!
        first! + 1 => first!
    }
    0 => second!
    second! < 1 -> while {
        Item { value: 2 } => item!
        17 => item!.value
        sum! + item!.value => sum!
        second! + 1 => second!
    }
    sum! -> println
}
