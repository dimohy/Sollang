import sys.quic.keys as initial
import sys.quic.traffic_keys as traffic

connectionId: -> [UInt8] => [131, 148, 196, 248, 3, 110, 81, 87, 8]

main {
    initial.deriveInitial(initial.version1(), connectionId()) => v1
    traffic.derive(initial.version1(), v1.clientSecret) => v1Client
    initial.deriveInitial(initial.version2(), connectionId()) => v2
    traffic.derive(initial.version2(), v2.serverSecret) => v2Server
    traffic.nextSecret(v1.clientSecret) => updatedSecret
    (v1Client.key[0] == v1.clientKey[0]
        and v1Client.key[15] == v1.clientKey[15]
        and v1Client.iv[0] == v1.clientIv[0]
        and v1Client.iv[11] == v1.clientIv[11]
        and v1Client.headerProtection[0] == v1.clientHeaderProtection[0]
        and v1Client.headerProtection[15] == v1.clientHeaderProtection[15]) -> if { "true" } else { "false" } => v1Matches
    (v2Server.key[0] == v2.serverKey[0]
        and v2Server.key[15] == v2.serverKey[15]
        and v2Server.iv[0] == v2.serverIv[0]
        and v2Server.iv[11] == v2.serverIv[11]
        and v2Server.headerProtection[0] == v2.serverHeaderProtection[0]
        and v2Server.headerProtection[15] == v2.serverHeaderProtection[15]) -> if { "true" } else { "false" } => v2Matches
    (updatedSecret[0] != v1.clientSecret[0]
        or updatedSecret[31] != v1.clientSecret[31]) -> if { "true" } else { "false" } => changed
    "traffic-keys=$v1Matches,$v2Matches,$changed" -> println
}
