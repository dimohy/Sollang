import std.net.quic.error as errors
import std.net.quic.frame as frames
import std.net.quic.loss_recovery as recovery
import std.net.quic.packet_recovery as journal

verify: -> Result<Bool, errors.Error> uses Console {
    journal.create() => packets!
    packets! -> recordSent(6, 90_000, 1_200, true, true)
    packets! -> recordSent(7, 100_000, 1_200, true, true)
    packets! -> recordSent(8, 110_000, 1_200, true, true)
    packets! -> recordSent(10, 130_000, 1_200, true, true)
    recovery.initialCongestionState(1_200) => congestion0
    congestion0 -> onPacketSent(1_200, true) => congestion1
    congestion1 -> onPacketSent(1_200, true) => congestion2
    congestion2 -> onPacketSent(1_200, true) => congestion3
    congestion3 -> onPacketSent(1_200, true) => congestion4
    frames.Ack {
        largestAcknowledged: 10
        ackDelay: 5_000
        firstRange: 0
        ranges: [frames.AckRange { gap: 1, rangeLength: 0 }; ~]
    } => ack
    packets! -> processAck(
    ack,
    recovery.initialRttState(),
    congestion4,
    200_000,
    25_000,
    true,
    1_200,
    true)? => updated
    "$(updated.acknowledgedPackets),$(updated.lostPackets),$(updated.acknowledgedBytes),$(updated.lostBytes),$(packets!.packets -> len),$(packets!.packets[0].number)" -> println
    "$(updated.rtt.latest),$(updated.rtt.smoothed),$(updated.rtt.variance),$(updated.congestion.congestionWindow),$(updated.congestion.bytesInFlight)" -> println
    Result<Bool, errors.Error>.Ok(true)
}

main {
    verify() -> when {
        Ok(done) {}
        Err(error) { "unexpected=$(error.code)" -> println }
    }
}
