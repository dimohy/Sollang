# A borrowed additional argument releases the owner created by its nested flow.
struct Owner { values: [Int; ~] }
create value: Int -> Owner { Owner { values: [value,; ~] } }
impl Owner {
    first: self -> Int { self.values[0] }
}
observe marker: Int, owner: Owner -> Int { marker + (owner -> first) }
main {
    4 -> observe(9 -> create) -> println
}
