namespace examples.regression.async_enum_payload_across_nested_yield

owned: -> Result<[Int; ~], Text> => Result<[Int; ~], Text>.Ok([7; ~])

consume value: move [Int; ~] -> Unit uses Console { value[0] -> println }

public observe: -> async Unit uses Console {
    owned() -> when {
        Ok(value) {
            1 -> when {
                == 1 {
                    yield
                    value -> consume
                }
                else { "unexpected" -> println }
            }
        }
        Err(error) { error -> println }
    }
}

main {
    examples.regression.async_enum_payload_across_nested_yield.observe() => observation
    observation -> await
}
