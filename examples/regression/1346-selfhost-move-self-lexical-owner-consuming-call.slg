enum Mode {
    Buffered
    Fresh
}

struct Owner {
    bytes: [UInt8; ~]
}

consume owner: move Owner -> Result<Int, Int> {
    Result<Int, Int>.Ok(owner.bytes -> len)
}

impl Owner {
    forward: move self, mode: Mode -> Result<Int, Int> {
        self => current
        mode -> when {
            Buffered { current -> consume }
            Fresh { current -> consume }
        }
    }
}

main {
    Owner { bytes: [1, 2, 3; ~] } -> forward(Mode.Buffered) -> when {
        Err(_) { "move-self-consuming-call=false" -> println }
        Ok(count) { "move-self-consuming-call=$(count == 3)" -> println }
    }
}
