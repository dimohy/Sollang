main {
    [Int; ~] => ints!
    ints! -> reserve(9)
    ints! -> push(1)
    ints! -> reserve(4)

    [Text; ~] => texts!
    texts! -> reserve(9)
    texts! -> push("kept")

    BinaryHeap<Int>(2) => heap!
    heap! -> push(4)
    heap! -> push(9)
    heap! -> reserve(9)
    heap! -> peek => top

    Deque<Int>(2) => deque!
    deque! -> pushBack(2)
    deque! -> pushFront(1)
    deque! -> reserve(9)
    deque! -> front => front
    deque! -> back => back

    Set<Int>(2) => set!
    set! -> insert(7) => setInserted
    set! -> reserve(17)

    { 1: 10 } => legacy!
    legacy! -> reserve(17)
    legacy![1] => legacyValue

    {Int: Text; 2~} => labels!
    labels! -> put(1, "one")
    labels! -> reserve(17)
    labels![1] => label

    "ints=$(ints! -> capacity),$(ints![0])" -> println
    "texts=$(texts! -> capacity),$(texts![0])" -> println
    "heap=$(heap! -> capacity),$top" -> println
    "deque=$(deque! -> capacity),$front,$back" -> println
    "set=$(set! -> capacity),$(set! -> len)" -> println
    "legacy=$(legacy! -> capacity),$legacyValue" -> println
    "labels=$(labels! -> capacity),$label" -> println
}
