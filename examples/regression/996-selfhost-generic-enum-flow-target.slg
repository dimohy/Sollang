wrap value: Int -> Result<Int, Text> {
    value -> Result<Int, Text>.Ok
}

normalize result: Result<Int, Text> -> Result<Int, Text> {
    result -> when {
        Ok(value) {
            value == 23 -> if {
                Result<Int, Text>.Ok(value)
            } else {
                Result<Int, Text>.Err("wrong-value")
            }
        }
        Err(message) { Result<Int, Text>.Err(message) }
    }
}

main {
    wrap(23) -> normalize -> when {
        Ok(value) { "flow-enum=$value" -> println }
        Err(message) { "unexpected=$message" -> println }
    }
}
