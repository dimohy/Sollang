import sys.io
import std.net.socket as socket
import std.net as net

boundPort endpoint: net.Endpoint -> Result<UInt16, socket.SocketError> uses Network {
    socket.DatagramBindOptions { endpoint: endpoint, reuseAddress: true } -> bind? => datagram
    datagram -> localPort
}

main {
    net.loopback(0) -> unified -> boundPort -> when {
        Ok(port) {
            port > 0 -> if { "true" } else { "false" } => assigned
            "ephemeral=$assigned" -> println
        }
        Err(error) { "bind-error=$(error.code)" -> println }
    }
}
