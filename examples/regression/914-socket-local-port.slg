import sys.io
import sys.socket as socket

boundPort endpoint: socket.Endpoint -> Result<UInt16, socket.SocketError> uses Network {
    socket.bindDatagram({ endpoint: endpoint, reuseAddress: true })? => datagram
    socket.localPort(datagram)
}

main {
    socket.Endpoint { address: "127.0.0.1", port: 0 } -> boundPort -> when {
        Ok(port) {
            port > 0 -> if { "true" } else { "false" } => assigned
            "ephemeral=$assigned" -> println
        }
        Err(error) { "bind-error=$(error.code)" -> println }
    }
}
