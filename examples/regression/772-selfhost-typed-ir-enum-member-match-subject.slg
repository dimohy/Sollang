import sollang.compiler.ir.typed as typedIr
import sollang.compiler.semantic.context as semanticContext

# Matching an enum-valued struct member must use the member projection as the
# subject, never the surrounding struct name or a transparent wrapper.
main {
    [
        """
        enum Kind { File Directory }

        struct Info {
            values: [Int; ~]
            kind: Kind
        }

        classify info: Info -> Int {
            info.kind -> when {
                File { 0 }
                Directory { 1 }
            }
        }
        """; ~
    ] => sources
    sources -> semanticContext.prepare => prepared
    prepared -> typedIr.lowerContext => ir
    0 => matches!
    0 => invalid!
    0 => index!
    index! < (ir -> len) -> while {
        ir[index!] => node
        node.kind == 27 -> if {
            matches! + 1 => matches!
            (node.operand0 < 0 or node.operand0 >= (ir -> len))
                -> if {
                invalid! + 1 => invalid!
            } else {
                ir[node.operand0] => subject
                ir[subject.operand0] => base
                -1 => expectedFieldType!
                0 => fieldIndex!
                fieldIndex! < (prepared.semantic.fields -> len)
                    -> while {
                    prepared.semantic.fields[fieldIndex!] => field
                    (field.ownerType == base.typeId and field.ordinal == 1)
                        -> if {
                        field.fieldType => expectedFieldType!
                    }
                    fieldIndex! + 1 => fieldIndex!
                }
                (subject.kind != 13 or expectedFieldType! < 0 or subject.typeId != expectedFieldType!)
                    -> if {
                    invalid! + 1 => invalid!
                }
            }
        }
        index! + 1 => index!
    }
    "matches=$(matches!),invalid=$(invalid!)" -> println
}
