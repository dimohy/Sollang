import sample.call_result_member as sample
import sample.call_result_member_model as model

# A field projected directly from an imported qualified call result remains a
# concrete Typed IR value and owns the following enum match. The call is the
# member base; neither qualified-path normalization nor match repair may drop
# or replace the field projection.

main {
    UInt64(1) => id
    sample.identity(id).direction -> when {
        Bidirectional { "call-result member = bidirectional" -> println }
        Unidirectional { "call-result member = unidirectional" -> println }
    }
}
