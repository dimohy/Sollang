selectBit bitIndex: UInt64 -> UInt64 {
    bitIndex -> when {
        == 0 { 11 }
        == 1 { 22 }
        == 2 { 33 }
        else { 44 }
    }
}

keepFinal bitIndex: UInt64 -> UInt64 {
    bitIndex -> when {
        == 0 { 55 }
        else { 66 }
    } => ignored
    77
}

main {
    "terminal-subject-when=$(selectBit(0)),$(selectBit(1)),$(selectBit(2)),$(selectBit(9)); nonterminal=$(keepFinal(0))" -> println
}
