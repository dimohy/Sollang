struct Pair {
    first: Int
    second: Int
}
struct TwoViews {
    left: ref Int
    right: ref Int
}
same value: ref Int -> ref Int { value }
read value: ref Int -> Int { value }
main {
    Pair { first: 10, second: 11 } => left!
    Pair { first: 20, second: 21 } => right
    TwoViews {
        left: left!.first -> same
        right: right.first -> same
    } => stored
    Pair { first: 30, second: 31 } => left!
    stored.right -> read -> println
}
