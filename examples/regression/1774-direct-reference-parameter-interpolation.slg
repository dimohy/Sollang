# Direct readonly parameters retain pointer ABI in both argument positions;
# interpolation reads their values in ordinary and nested control regions.
showFirst value: ref Int -> Unit uses Console {
    "first-name=$value" -> println
    "first-expression=$(value)" -> println
    true -> if {
        "first-control=$value" -> println
    }
}

showAdditional prefix: Int, value: ref Int -> Unit uses Console {
    "additional-name=$value" -> println
    "additional-expression=$(value)" -> println
    true -> if {
        "additional-control=$(value)" -> println
    }
}

main {
    41 => number
    number -> showFirst
    7 -> showAdditional(number)
}
