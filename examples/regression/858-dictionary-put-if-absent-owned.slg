struct OwnedValues {
    values: [Int; ~]
}

main {
    {Int: OwnedValues; 1~} => batches!
    OwnedValues { values: [1, 2, 3; ~] } => first!
    batches! -> putIfAbsent(1, first!) => inserted
    OwnedValues { values: [9, 9; ~] } => duplicate!
    batches! -> putIfAbsent(1, duplicate!) => replaced
    batches! -> take(1) => retained!
    retained!.values -> len => retainedLength
    inserted -> if { "inserted=true" -> println } else { "inserted=false" -> println }
    replaced -> if { "replaced=true" -> println } else { "replaced=false" -> println }
    "retained=$retainedLength remaining=$(batches! -> len)" -> println
}
