import sollang.compiler.ir.interpolation as interpolation

# Member projection after an indexed expression must retain one dependency chain
# so LLVM emission can materialize every intermediate value before the root.
main {
    """
    public struct Item { value: Int }

    probe items: ref [Item; ~], index: Int -> Unit {
        "selected=$(items[index].value)" -> println
    }
    """ => source
    source -> interpolation.lower => nodes!
    0 => nodeIndex!
    nodeIndex! < (nodes! -> len) -> while {
        nodes![nodeIndex!] => node
        "node=$(nodeIndex!),kind=$(node.kind),parent=$(node.parent),operand0=$(node.operand0),operand1=$(node.operand1),payload=$(source -> slice(node.payloadStart, node.payloadLength))" -> println
        nodeIndex! + 1 => nodeIndex!
    }
}
