# Ensures a fallible call result keeps its receiver type over the initializer's leading literal.
import examples.call_result_receiver as model

run: -> Result<Int, Text> {
    model.Builder { seed: 0 } -> create? => ready
    ready -> shared => value
    Result<Int, Text>.Ok(value)
}

main {
    run() -> when {
        Ok(value) { "call-result-receiver=$value" -> println }
        Err(error) { "call-result-receiver-error=$error" -> println }
    }
}
