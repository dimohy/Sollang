import regression.imported_projection_types as types

struct Lookup {
    bias: Int
}

readLength lookup: ref Lookup, values: ref [Int; ~] -> Int => (values -> len) + lookup.bias

inspect envelope: types.Envelope -> Int {
    Lookup { bias: 0 } => lookup
    lookup -> readLength(envelope.batch.values)
}

main {
    types.Envelope {
        batch: types.Batch { values: [3, 5; ~] }
    } -> inspect => length
    "imported-nested-ref-length=$length" -> println
}
