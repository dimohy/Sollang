enum Outcome {
    Ok(Int)
    Err(Int)
}

reject code: Int -> Outcome => Outcome.Err(code)

# Every statement-valued match keeps its trailing consumer, including when
# several controls occur consecutively before the function's final value.
main {
    reject(1) -> when {
        Ok(value) { "first-ok" }
        Err(error) { "first-error" }
    } -> println
    reject(2) -> when {
        Ok(value) { "second-ok" }
        Err(error) { "second-error" }
    } -> println
    reject(3) -> when {
        Ok(value) { "third-ok" }
        Err(error) { "third-error" }
    } -> println
}
