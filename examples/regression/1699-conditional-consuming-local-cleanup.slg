# Both branches consume one local owner through fallible calls.
consume values: move [Int; ~] -> Result<Int, Int> {
    values -> len == 4 -> unless { Result<Int, Int>.Err(1) -> return }
    Result<Int, Int>.Ok(4)
}

run transfer: Bool -> Result<Int, Int> uses Console {
    true -> if {
        [1, 2, 3; ~] => values!
        values! -> push(4)
        transfer -> if {
            values! -> consume? => count
            "first=$count" -> println
        } else {
            values! -> consume? => count
            "second=$count" -> println
        }
    }
    Result<Int, Int>.Ok(0)
}

main {
    true -> run -> when {
        Ok(count) { }
        Err(code) { "error=$code" -> println }
    }
    false -> run -> when {
        Ok(count) { }
        Err(code) { "error=$code" -> println }
    }
}
