import sollang.compiler.llvm.text as llvm

main {
    [
    """
    run: -> Int {
        pick index: Int -> Int {
            values![index]
        }
        [4, 5; ~] => values!
        values! -> reserve(8)
        values! -> push(6)
        pick(1) + pick(2)
    }

    main {
        run() -> println
    }
    """; ~
    ] => sources!
    sources! -> llvm.emit
}
