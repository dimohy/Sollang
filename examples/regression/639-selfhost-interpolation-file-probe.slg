import sollang.compiler.ir.interpolation as interpolation
import sys.file as file

main {
    "examples/regression/576-linq-multiplication-table.slg" -> file.mapText => owner!
    owner! -> len => sourceLength
    owner! -> slice(UIntSize(0), sourceLength) => source
    source -> interpolation.lower => nodes!

    0 => nodeIndex!
    nodeIndex! < (nodes! -> len) -> while {
        nodes![nodeIndex!] => node
        node.kind == 1 -> if {
            "name=" -> print
            source -> slice(node.payloadStart, node.payloadLength) -> print
            ",symbol=$(node.symbol)" -> print
            ",owner=$(node.ownerSymbol)" -> println
        }
        nodeIndex! + 1 => nodeIndex!
    }
}
