import sollang.compiler.llvm.text as llvm

main {
    """
        com fixture class "11111111-2222-3333-4444-555555555555" in mta {
            interface Calculator "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee" {
                add left: Int32, right: Int32 -> Result<Int32, Int32> at 3
            }
        }

        main {
            fixture.create
        }
    """ => source
    [source,; ~] => linuxSources
    linuxSources -> llvm.emitLinuxChecked => linuxDiagnostics
    "linux diagnostics = $linuxDiagnostics" -> println
    [source,; ~] => wasmSources
    wasmSources -> llvm.emitWasmChecked => wasmDiagnostics
    "wasm diagnostics = $wasmDiagnostics" -> println
}
