# A propagated UIntSize result can index mapped bytes.
readMap: -> MappedBytes uses File {
    map read "data.bin" => data
    data
}

offset: -> Result<UIntSize, Int> => Result<UIntSize, Int>.Ok(1)

run: -> Result<Unit, Int> uses File, Console {
    readMap() => data
    "byte=$(data[offset()?])" -> println
    Result<Unit, Int>.Ok
}

main {
    run() -> when {
        Ok(done) { }
        Err(error) { "unexpected-error=$error" -> println }
    }
}
