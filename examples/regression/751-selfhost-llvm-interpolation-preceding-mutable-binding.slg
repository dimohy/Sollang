import sollang.compiler.llvm.text as llvm

# Interpolation inside control flow must read the nearest mutable definition
# that precedes the literal in source order. A later assignment must never be
# selected merely because its node appears earlier in the flat IR table.
main {
    [
        """
        main {
            0 => ordinal!
            ordinal! < 1 -> while {
                true -> if {
                    "value=$(ordinal! - 1)" -> println
                }
                ordinal! + 1 => ordinal!
            }
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
