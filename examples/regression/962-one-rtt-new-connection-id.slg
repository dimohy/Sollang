import sys.quic.application_engine as application
import sys.quic.error as errors
import sys.quic.frame_types as frames
import sys.quic.keys

secret: -> [UInt8; 32] => [68; 32]
connectionId: -> [UInt8] => [1, 2, 3, 4, 5, 6, 7, 8]

run: -> Result<Bool, errors.Error> {
    application.create(secret()) => sender
    application.create(secret()) => receiver!
    [frames.Value; ~] => values!
    values! -> push(frames.Value.NewConnectionId(frames.NewConnectionId {
        sequence: 1
        retirePriorTo: 0
        connectionId: [9, 8, 7, 6, 5, 4, 3, 2; ~]
        statelessResetToken: [17; 16]
    }))
    application.encodeMany(keys.version1(), connectionId(), 3, values!, sender)? => datagram
    application.openMany(keys.version1(), datagram, connectionId(), 0, receiver!)? => opened!
    false => valid!
    opened!.frames -> take(0) -> when {
        NewConnectionId(value) {
            (opened!.packetNumber == 3
                and value.sequence == 1
                and value.connectionId[7] == 2
                and value.statelessResetToken[15] == 17) => valid!
        }
        else {}
    }
    Result<Bool, errors.Error>.Ok(valid!)
}

main {
    run() -> when {
        Ok(valid) { valid -> if { "one-rtt-new-cid=ok" } else { "one-rtt-new-cid=failed" } -> println }
        Err(value) { "one-rtt-new-cid-error=$(value.code)" -> println }
    }
}
