# Both inner matches borrow the payload; the outer enum keeps its owner.
struct Table {
    data: [Int; ~]
}

enum Slot {
    Empty
    Built(Table)
}

make: -> Result<Slot, Int> {
    Slot.Built(Table { data: [42] }) -> Result<Slot, Int>.Ok
}

inspect table: Table -> Int => table.data[0]

main {
    make() -> when {
        Err(error) { error -> println }
        Ok(slot) {
            slot -> when {
                Empty { 0 }
                Built(table) { table -> inspect }
            } -> println
            slot -> when {
                Empty { 0 }
                Built(table) { table -> inspect }
            } -> println
        }
    }
}
