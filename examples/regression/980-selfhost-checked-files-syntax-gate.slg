import sollang.compiler.llvm.text as llvm

# File-backed checked emission must reject syntax before semantic preparation,
# so a recovered partial AST can never reach Typed IR or LLVM.
main {
    ["examples/regression/diagnostics/849-unterminated-flow-println.slg"; ~] -> llvm.emitCheckedFiles => diagnostics
    "checked-file syntax diagnostics = $diagnostics" -> println
}
