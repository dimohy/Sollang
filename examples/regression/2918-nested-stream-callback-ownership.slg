import std.sequence

makeRange: -> Range uses Console {
    "source" -> println
    0..1
}

emitNested: -> Unit uses Console {
    makeRange() -> map value { value + 1 } -> each outer {
        outer > 0 -> if {
            0..1 -> map inner { inner + outer } -> each result {
                result -> println
            }
        }
    }
}

main { emitNested() }
