struct Packet { bytes: [UInt8; 1] }
make value: UInt8 -> [UInt8; 1] { [value] }
packet selected: Bool -> Packet {
    selected -> if { Packet { bytes: 13 -> make } -> return }
    Packet { bytes: 17 -> make }
}
main {
    true -> packet => first
    false -> packet => second
    first.bytes[0] -> println
    second.bytes[0] -> println
}
