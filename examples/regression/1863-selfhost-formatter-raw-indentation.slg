import sollang.compiler.cli_format as formatter
import sys.file as file

reportFormatted values: [Int; ~], label: Text -> Unit uses Console {
    [UInt8; ~] => sourceBytes!
    values -> each value { sourceBytes! -> push(UInt8(value)) }
    sourceBytes! -> file.borrowBytes => source
    source -> formatter.format => result
    "case=$label,status=$(result.status)" -> println
    result.bytes -> file.borrowBytes => formatted
    formatted -> slice(UIntSize(0), formatted -> len) -> print
}

main {
    [109, 97, 105, 110, 32, 123, 10, 32, 32, 32, 32, 32, 32, 32, 32, 34, 34, 34, 10, 194, 160, 10, 32, 32, 32, 32, 32, 32, 32, 32, 34, 34, 34, 10, 32, 32, 32, 32, 32, 32, 32, 32, 45, 62, 32, 112, 114, 105, 110, 116, 108, 110, 10, 125, 10]
        -> reportFormatted("raw-indent-nbsp")
    [109, 97, 105, 110, 32, 123, 10, 32, 32, 32, 32, 32, 32, 32, 32, 34, 34, 34, 10, 226, 128, 131, 10, 32, 32, 32, 32, 32, 32, 32, 32, 34, 34, 34, 10, 32, 32, 32, 32, 32, 32, 32, 32, 45, 62, 32, 112, 114, 105, 110, 116, 108, 110, 10, 125, 10]
        -> reportFormatted("raw-indent-em-space")
    [109, 97, 105, 110, 32, 123, 10, 32, 32, 32, 32, 32, 32, 32, 32, 34, 34, 34, 10, 9, 9, 10, 32, 32, 32, 32, 32, 32, 32, 32, 34, 34, 34, 10, 32, 32, 32, 32, 32, 32, 32, 32, 45, 62, 32, 112, 114, 105, 110, 116, 108, 110, 10, 125, 10]
        -> reportFormatted("raw-indent-ascii-tabs")
    [109, 97, 105, 110, 32, 123, 10, 34, 34, 34, 10, 10, 34, 34, 34, 10, 45, 62, 32, 112, 114, 105, 110, 116, 108, 110, 10, 125, 10]
        -> reportFormatted("raw-expand-empty")
    [109, 97, 105, 110, 32, 123, 10, 34, 34, 34, 10, 194, 160, 10, 34, 34, 34, 10, 45, 62, 32, 112, 114, 105, 110, 116, 108, 110, 10, 125, 10]
        -> reportFormatted("raw-expand-nbsp")
    [109, 97, 105, 110, 32, 123, 10, 32, 32, 32, 32, 32, 32, 32, 32, 34, 34, 34, 10, 32, 32, 32, 32, 32, 32, 32, 32, 98, 111, 100, 121, 10, 32, 32, 32, 32, 32, 32, 32, 32, 34, 34, 34, 10, 32, 32, 32, 32, 32, 32, 32, 32, 45, 62, 32, 112, 114, 105, 110, 116, 108, 110, 10, 125, 10]
        -> reportFormatted("raw-shrink-payload")
