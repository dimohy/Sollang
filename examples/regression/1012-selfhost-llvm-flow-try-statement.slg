import sollang.compiler.llvm.text as llvm

main {
    [
        """
        fail value: Int -> Result<Unit, Int> {
            Result<Unit, Int>.Err(value)
        }

        pipe value: Int -> Result<Unit, Int> {
            value -> fail?
            Result<Unit, Int>.Ok
        }

        direct value: Int -> Result<Unit, Int> {
            fail(value)?
            Result<Unit, Int>.Ok
        }

        main {
            pipe(7) -> when {
                Ok(done) { "pipe-ok" -> println }
                Err(value) { "pipe=$value" -> println }
            }
            direct(9) -> when {
                Ok(done) { "direct-ok" -> println }
                Err(value) { "direct=$value" -> println }
            }
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
