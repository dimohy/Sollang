# A continuing else arm participates in its enclosing value join.
choose flag: Bool, value: Int -> Int {
    flag -> if {
        when {
            value > 0 { 1 -> return }
            else { 2 }
        }
    } else { 3 }
}

# Both the conditional arm and its else may instead return from the function.
all flag: Bool, value: Int -> Int {
    flag -> if {
        when {
            value > 0 { 10 -> return }
            else { 20 -> return }
        }
    } else { 30 -> return }
}

main {
    choose(true, 0) -> println
    choose(true, 1) -> println
    choose(false, 0) -> println
    all(true, 0) -> println
    all(true, 1) -> println
    all(false, 0) -> println
}
