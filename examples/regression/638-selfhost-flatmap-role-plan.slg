import sollang.compiler.ir.stream as streamIr
import sollang.compiler.ir.typed as typedIr
import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.expression_type_ids as expressionTypeIds

main {
    [
        """
        import std.sequence

        main {
            2..9
                -> beforeEach dan {
                    dan -> println
                }
                -> flatMap(1..9) dan, multiplier {
                    dan * multiplier
                }
                -> each line {
                    line -> println
                }
        }
        """,
        """
        namespace std.sequence

        public beforeEach values: Range -> stream Int block item: Int -> Unit {
            values -> each item {
                item -> yield
                item -> emit
            }
        }

        public flatMap<T, R> outer: T, innerValues: Range -> stream R block outerItem: T, inner: Int -> R {
            innerValues -> each inner {
                outer -> yield(inner) -> emit
            }
        }
        """,
        """
        namespace probe

        enum Kind {
            File
            Other
        }

        code kind: Kind -> Int => kind -> when {
            File => 0
            Other => 1
        }
        """; ~
    ] => sources!
    sources! -> semanticContext.prepare => prepared
    prepared -> typedIr.lowerContext => ir!
    prepared -> expressionTypeIds.resolveContext => resolved!
    prepared -> streamIr.build(ir!, resolved!) => plan!
    0 => stageIndex!
    stageIndex! < (plan!.stages -> len) -> while {
        plan!.stages[stageIndex!] => stage
        "stage = $(stageIndex!),$(stage.flags),$(stage.callIr),$(stage.callbackStart),$(stage.callbackEnd)" -> println
        stageIndex! + 1 => stageIndex!
    }
    0 => sourceIndex!
    sourceIndex! < (prepared.package.ranges -> len) -> while {
        prepared.package.ranges[sourceIndex!] => range
        0 => symbolIndex!
        symbolIndex! < range.symbolCount -> while {
            prepared.package.symbols[range.symbolStart + symbolIndex!] => symbol
            symbol.kind == 35 -> if {
                prepared.package.tokens[range.tokenStart + symbol.nameToken] => nameToken
                prepared.package.sources[sourceIndex!] -> slice(nameToken.span.start, nameToken.span.length) => name
                "role = $(sourceIndex!),$(symbolIndex!),$(symbol.parent),$(symbol.astNode),$name" -> println
            }
            symbolIndex! + 1 => symbolIndex!
        }
        sourceIndex! + 1 => sourceIndex!
    }
    0 => failedCalls!
    prepared.calls -> each call {
        call.status != 0 -> if { failedCalls! + 1 => failedCalls! }
    }
    Int(prepared.calls -> len) => callCount
    failedCalls! => failed
    "$callCount,$failed" -> println
}
