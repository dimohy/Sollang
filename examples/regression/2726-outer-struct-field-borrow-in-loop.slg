struct Holder { value: Int }

make value: Int -> Holder => Holder { value: value }
read value: ref Int -> Int => value

show: -> Unit uses Console {
    7 -> make => outer
    0 => index!
    index! < 2 -> while {
        outer.value -> read -> println
        9 -> make => inner
        inner.value -> read -> println
        index! + 1 => index!
    }
}

main { show() }
