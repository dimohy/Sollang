import regression.enum_split as keys

capture error: keys.Detail -> keys.Capture {
    keys.Capture.Record(error)
}

report value: keys.Capture -> Unit uses Console {
    value -> when {
        keys.Capture.Invalid { "invalid" -> println }
        keys.Capture.Record(error) {
            error -> when {
                keys.Detail.Category { "category" -> println }
                keys.Detail.Record { "record" -> println }
            }
        }
    }
}

main {
    keys.Detail.Category -> capture -> report
    keys.Detail.Record -> capture -> report
}
