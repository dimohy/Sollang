main {
    Int(Double(0.1) * 1000000000.0) -> println
    Int(Double(1e-1) * 1000000000.0) -> println
    Int(Double(-0.1) * 1000000000.0) -> println
    Float32(0.1) => narrow
    Int(Double(narrow) * 1000000000.0) -> println
    true -> if {
        Int(Double(0.1) * 1000000000.0) -> println
    }
    "direct=$(Int(Double(0.1) * 1000000000.0))" -> println
    "negative=$(Int(Double(-0.1) * 1000000000.0))" -> println
    "computed=$(Int(Double(narrow) * 1000000000.0))" -> println
}
