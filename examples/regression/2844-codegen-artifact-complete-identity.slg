main {
    validArtifact() => valid
    valid -> codegen.validate(101, 202, 303) => validation
    valid -> codegen.decode(101, 202, 303) => decoded
    valid -> codegen.merge(101, 202, 303) => merged
    "valid=$(validation.status) decoded=$(decoded.status) merged=$(merged.status)" -> println
    invalidArtifact() => invalid
    invalid -> codegen.validate(101, 202, 303) => rejected
    "invalid=$(rejected.status)" -> println
}
