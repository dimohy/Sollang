pair value: ref Int64 -> (Int64, Int) { (value, 1) }

labeled value: ref Int64 -> (left: Int64, right: Int) {
    (left: value, right: 1)
}

sum value: (Int64, Int) -> Int64 { value._0 + Int64(value._1) }

weighted value: (left: Int64, right: Int) -> Int64 {
    value.left + Int64(value.right)
}

main {
    Int64(41) => value
    value -> pair -> sum -> println
    value -> labeled -> weighted -> println
}
