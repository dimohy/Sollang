# Imported enum patterns retain the complete alias-qualified type owner.
import regression.enum_scope as scope

enum Error {
    Foreign
}

main {
    scope.empty() -> when {
        scope.Error.Failed { "local=empty" -> println }
        scope.Error.Present(value) { "unexpected=$value" -> println }
    }
    scope.payload(7) -> when {
        scope.Error.Failed { "unexpected=empty" -> println }
        scope.Error.Present(value) { "payload=$value" -> println }
    }
    scope.shadow(11) => shadowed
    "shadow=$shadowed" -> println
    scope.matched() => matched
    "match=$matched" -> println
}
