struct Point {
    public x: Int
}

readPoint: -> Result<Point, Int> => Result<Point, Int>.Ok(Point { x: 5 })

run: -> Result<Unit, Int> uses Console {
    "value=$((readPoint()?).x)" -> println
    Result<Unit, Int>.Ok
}

main {
    run() -> when {
        Ok(done) { }
        Err(error) { "unexpected-error=$error" -> println }
    }
}
