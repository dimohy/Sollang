make value: UInt8 -> [UInt8; 1] { [value] }

read selected: Bool -> Int {
    selected -> if {
        UInt8(13) -> make => bytes
        bytes
    } else {
        UInt8(17) -> make => bytes
        bytes
    } => selectedBytes
    Int(selectedBytes[0])
}

main {
    true -> read -> println
    false -> read -> println
}
