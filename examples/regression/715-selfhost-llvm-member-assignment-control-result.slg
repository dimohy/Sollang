import sollang.compiler.llvm.text as llvm

# A mutable member assignment must depend on the value-producing control node,
# never on its transparent syntax wrapper.
main {
    [
        """
        struct Node {
            operand0: Int
        }

        select flag: Bool -> Int {
            Node { operand0: -1 } => node!
            flag -> if { 3 } else { 4 } => node!.operand0
            node.operand0
        }

        main {
            true -> select -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
