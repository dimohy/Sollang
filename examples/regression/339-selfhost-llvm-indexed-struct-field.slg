import sollang.compiler.llvm.text as llvm

main {
    [
    """
    struct Request {
        caller: Int
        binding: Int
    }

    make captures: [Int; ~] -> Int {
        0 => index!
        0 => result!
        index! < (captures -> len) -> while {
            Request { caller: 7, binding: captures[index!] } => request
            request.binding => result!
            index! + 1 => index!
        }
        result!
    }

    main { [3, 7] -> make -> println }
    """; ~
    ] => sources!
    sources! -> llvm.emit
}
