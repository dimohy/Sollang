import sollang.compiler.ir.typed as typedIr

main {
    [
    """
    choose rule: Int -> Int {
        [Int; ~] => activeRules!
        activeRules! -> push(0)
        activeRules! -> len => activeRuleCount
        rule < activeRuleCount -> if {
            rule => activeRules![0]
        } else {
            activeRules! -> push(rule)
        }
        activeRules! -> len
    }

    main {
    }
    """; ~
    ] => sources
    sources -> typedIr.lower => ir
    ir -> typedIr.movesFrom => moves
    "move events = $(moves -> len)" -> println
}
