selectText code: Int -> Text {
    "other" => selected!
    when {
        code == 1 { "one" => selected! }
        code == 2 { "two" => selected! }
        else { "other" => selected! }
    }
    selected! => result
    result
}

main {
    0 -> selectText -> println
    1 -> selectText -> println
    2 -> selectText -> println
}
