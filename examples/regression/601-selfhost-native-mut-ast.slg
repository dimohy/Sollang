import sollang.compiler.ast as ast
import sollang.compiler.lexer as lexer

main {
    """
    abi struct Point {
        x: Float64
        y: Float64
    }

    native fixture from "native_fixture" {
        translate point: mut Point, dx: Float64, dy: Float64 -> Unit as "native_point_translate"
    }

    main {
    }
    """ => source
    source -> ast.lower => nodes!
    source -> lexer.lex => tokens!
    nodes! -> each node {
        (node.kind == 7 or node.kind == 60 or node.kind == 12 or node.kind == 65) -> if {
            "$(node.kind):$(node.parent):$(node.flags):$(node.payloadToken)" -> println
        }
    }
}
