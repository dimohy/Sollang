import sollang.compiler.ast as ast
import sollang.compiler.ir.typed as typedIr

main {
    [
        """
        main {
            false -> unless { "ok" -> println }
        }
        """; ~
    ] => sources
    sources[0] -> ast.lower => nodes
    nodes -> each node {
        "ast=$(node.kind),$(node.parent),$(node.cstRuleId),$(node.operatorKind)" -> println
    }
    sources -> typedIr.lower => ir
    ir -> each node {
        node.kind == 18 -> if {
            "if-opcode=$(node.opcode)" -> println
        }
    }
}
