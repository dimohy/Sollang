# Associated items retain the declared fixed array length.
trait Counter {
    type Item
    count: self, values: [Item; 2] -> Int
}
struct IntCounter { }
impl Counter for IntCounter {
    type Item = Int
    count: self, values: [Int; 2] -> Int { values -> len }
}
main {
    [10, 20] => values
    IntCounter { } -> Counter.count(values) -> println
}
