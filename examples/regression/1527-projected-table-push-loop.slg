# Transferring a field into a collection leaves only its sibling to clean up.
struct Table { values: [Int; ~] }
struct Owner { table: Table, retained: [Int; ~] }

collect count: Int -> [Table; ~] {
    [Table; ~] => items!
    0 => index!
    index! < count -> while {
        Owner {
            table: Table { values: [7,; ~] }
            retained: [8,; ~]
        } => owner
        items! -> push(owner.table)
        index! + owner.retained[0] - 7 => index!
    }
    items!
}

main {
    2 -> collect => items
    items[0].values[0] + items[1].values[0] -> println
    0 -> collect -> len -> println
}
