increment value: Int -> Int => value + 1

mapOwned values: move [Int; ~], useParallel: Bool -> [Int; ~] {
    useParallel -> if {
        values -> parallel value { value -> increment } => mapped
        mapped -> return
    }
    [Int; ~] => mapped!
    0 => index!
    index! < (values -> len) -> while {
        mapped! -> push(values[index!] -> increment)
        index! + 1 => index!
    }
    mapped!
}

main {
    [1, 2, 3; ~] => values
    values -> mapOwned(true) => mapped
    "mapped=$(mapped -> len)" -> println
}
