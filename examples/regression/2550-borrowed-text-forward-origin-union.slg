import sys.file as file

pick useLeft: Bool, left: file.SourceText, right: file.SourceText -> Text {
    useLeft -> if { left -> slice(UIntSize(0), UIntSize(3)) -> return }
    relay(right -> slice(UIntSize(0), UIntSize(3)))
}

relay value: Text -> Text { value }

consume source: move file.SourceText -> Unit {}

main {
    "lexer" -> file.borrowText => left
    "parser" -> file.borrowText => right
    pick(false, left, right) => selected
    selected -> println
    left -> consume
    right -> consume
}
