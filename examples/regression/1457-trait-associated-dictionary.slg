# Associated items retain the declared growable array shape.
trait Counter {
    type Item
    count: self, values: {Text: Item} -> Int
}
struct IntCounter { }
impl Counter for IntCounter {
    type Item = Int
    count: self, values: {Text: Int} -> Int { values -> len }
}
main {
    {"first": 10, "second": 20} => values
    IntCounter { } -> Counter.count(values) -> println
}
