struct Counter {
    value: Int
}

impl Counter {
    public reset: mut self -> Unit {
        7 => self.value
    }

    public clear: mut self -> Unit {
        8 => self.value
    }

    public take: mut self, delta: Int -> Int {
        self.value - delta => self.value
        self.value
    }

    public len: self -> Int {
        self.value + 100
    }
}

main {
    Counter { value: 1 } => counter!
    counter! -> reset
    counter! -> clear
    counter! -> take(3) => counterValue
    counter! -> len => counterLength

    [4, 5, 6; ~] => values!
    values! -> take(0) => first
    values! -> len => remaining

    "counter=$counterValue,$counterLength;array=$first,$remaining" -> println
}
