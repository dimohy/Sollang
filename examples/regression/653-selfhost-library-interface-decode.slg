import sollang.compiler.semantic.library_interfaces as interfaces
import sys.file as file

# Verifies one-pass, span-backed decoding of the canonical .slglib interface.
main {
    """{
          "schema": 1,
          "abi": "sollang-c-v1",
          "target": "windows-x64",
          "libraryFile": "fixture.dll",
          "abiHash": "f1409516c2bcb25b9ae072c277c67abeee8f3606079b93a97a33a857565254a4",
          "exports": [
            {
              "name": "add",
              "qualifiedName": "math.add",
              "symbol": "slg_f1409516c2bcb25b9ae072c277c67abeee8f3606079b93a97a33a857565254a4_math_add",
              "parameters": [
                {
                  "name": "left",
                  "type": "Int32"
                },
                {
                  "name": "right",
                  "type": "Int32"
                }
              ],
              "result": "Int32",
              "signatureHash": "2b538d972d24ad807912d5f7dbc2d46e88abc48b09a168e9f980e1316d5f0bda"
            }
          ]
        }
        """ => source
    source -> file.borrowText => owner
    owner -> interfaces.parseSource => document
    document.strings -> file.borrowBytes => decoded
    document.exports[0] => exported
    document.parameters[exported.parameterStart] => first
    document.parameters[exported.parameterStart + 1] => second

    "status = $(document.status)" -> println
    decoded -> slice(document.target.start, document.target.length) -> println
    decoded -> slice(exported.name.start, exported.name.length) -> println
    decoded -> slice(first.name.start, first.name.length) -> print
    ":" -> print
    decoded -> slice(first.typeName.start, first.typeName.length) -> print
    "," -> print
    decoded -> slice(second.name.start, second.name.length) -> print
    ":" -> print
    decoded -> slice(second.typeName.start, second.typeName.length) -> println

    """{"schema":1,"abi":"wrong","target":"windows-x64","libraryFile":"x.dll","abiHash":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef","exports":[]}""" -> interfaces.parse => invalidAbi
    "invalid abi = $(invalidAbi.status)" -> println
}
