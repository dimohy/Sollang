makeQueue: -> Deque<Int> {
    Deque<Int>(3) => queue!
    queue! -> pushBack(2)
    queue! -> pushBack(3)
    queue! -> pushFront(1)
    queue! -> pushBack(4)
    queue! -> pushBack(5)
    queue!
}

main {
    makeQueue() => queue!
    queue! -> front => first
    queue! -> back => last
    queue! -> popFront => a
    queue! -> popBack => e
    queue! -> popFront => b
    queue! -> popFront => c
    queue! -> popFront => d
    queue! -> len => length
    queue! -> capacity => capacity
    "ends=$first,$last order=$a,$b,$c,$d,$e len=$length capacity=$capacity" -> println
}
