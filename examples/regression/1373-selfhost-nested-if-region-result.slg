import sys.io

enum Outcome {
    Ok(Int)
    Err(Bool)
}

# The outer else region must consume the nested if result, not its condition.
classify value: Int -> Outcome => value < 0
    -> if {
        Outcome.Err(true)
    } else {
        value > 10
            -> if {
                Outcome.Err(false)
            } else {
                Outcome.Ok(value)
            }
    }

main {
    classify(0) -> when {
        Ok(value) { "nested-if=$value" -> println }
        Err(value) { "nested-if-error=$value" -> println }
    }
}
