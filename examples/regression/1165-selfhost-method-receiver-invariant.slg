import sollang.compiler.llvm.invariant_rules as invariantRules

# V008 stops a declared instance method whose Typed IR lost its self receiver.
main {
    invariantRules.methodReceiverInvariantCode(31, 1, 0, 0, -1, -1, -1, -1, -1) => missingCode
    invariantRules.methodReceiverInvariantCode(31, 1, 0, 0, 10, 0, 35, 0, 1) => validCode
    "receiver invariant=$missingCode,$validCode" -> println
}
