import sollang.compiler.llvm.text as llvm

# A readonly array parameter remains an address at the function ABI. Both the
# primary and an additional parameter position must materialize its aggregate
# before each reads data and length.
main {
    [
        """
        show heading: Text, values: ref [Text; ~] -> Unit uses Console {
            heading -> println
            values -> each value { value -> println }
        }

        main {
            ["alpha", "beta"; ~] => values!
            "values" -> show(values!)
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
