struct Bytes3 {
    first: UInt8
    second: UInt8
    third: UInt8
}

struct Words3 {
    first: Int
    second: Int
    third: Int
}

struct Mixed {
    tag: UInt8
    value: Bytes3
    tail: Int
}

consumeBytes value: move box Bytes3 -> UInt8 { value.third }
consumeWords value: move box Words3 -> Int { value.third }
consumeMixed value: move box Mixed -> Int { value.tail }

main {
    box Bytes3 { first: 4, second: 5, third: 6 } -> consumeBytes -> println
    box Words3 { first: 4, second: 5, third: 6 } -> consumeWords -> println
    box Mixed { tag: 1, value: Bytes3 { first: 4, second: 5, third: 6 }, tail: 9 } -> consumeMixed -> println
}
