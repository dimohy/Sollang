fill<N> values: mut [UInt8; N], value: UInt8 -> Unit where N: Int {
    0 => index!
    index! < N -> while {
        value => values[index!]
        index! + 1 => index!
    }
}

zeros: -> [UInt8; 4] => [0; 4]

main {
    zeros() => values!
    values! -> fill<4>(7)
    (values![0] == 7 and values![3] == 7) -> if {
        "fixed-repeat-value-generic-mutation=ok"
    } else {
        "fixed-repeat-value-generic-mutation=failed"
    } -> println
}
