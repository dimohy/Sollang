struct Holder {
    value: sys.directory.RawResult
}
make: -> Holder {
    Holder {
        value: sys.directory.RawResult.Ok(sys.directory.Raw { bytes: [13; ~], count: 1 })
    }
}
main {
    make() => holder
    holder.value -> when {
        Ok(raw) { raw.bytes[0] -> println }
        Err(message) { message -> println }
    }
}
