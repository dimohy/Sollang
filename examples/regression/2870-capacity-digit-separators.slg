# Capacity digits may contain separators without adding live array elements.
ordinary: -> Unit uses Console {
    [Int; 1_024~] => values
    values -> len -> println
    values -> capacity -> println
    {Int: Int; 1_024~} => entries
    entries -> len -> println
    entries -> capacity -> println
}

main {
    [Int; 1_024~] => values
    values -> len -> println
    values -> capacity -> println
    {Int: Int; 1_024~} => entries
    entries -> len -> println
    entries -> capacity -> println
    ordinary()
    true -> if { ordinary() }
    0 => index!
    index! < 1 -> while {
        ordinary()
        index! + 1 => index!
    }
}
