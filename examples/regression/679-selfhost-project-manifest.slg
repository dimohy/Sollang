import sollang.compiler.project as projects

main {
    """project {
            name: "demo"
            version: "0.4.0"
            products: {
                app: "src/main.slg"
                tool: "src/tool.slg"
            }
            dependencies: {
                core: {
                    path: "../core"
                    version: "^1.2.0"
                }
            }
        }
        """ => source
    source -> projects.parse => manifest!
    manifest!.products[0] => app
    manifest!.products[1] => tool
    manifest!.dependencies[0] => core
    source -> slice(manifest!.name.start, manifest!.name.length) => name
    source -> slice(app.name.start, app.name.length) => appName
    source -> slice(app.root.start, app.root.length) => appRoot
    source -> slice(tool.name.start, tool.name.length) => toolName
    source -> slice(core.name.start, core.name.length) => dependencyName
    source -> slice(core.path.start, core.path.length) => dependencyPath
    "project = $(manifest!.status),$name,$appName,$appRoot,$toolName,$dependencyName,$dependencyPath" -> println
}
