namespace specimen.metadata
import specimen.keys as keys
make source: ref [Int; ~] -> keys.Holder {
    keys.Holder { values: [7; ~] }
}
fresh source: ref Result<[Int; ~], keys.Error> -> Result<keys.Holder, keys.Error> {
    source -> when {
        Err(_) { Result<keys.Holder, keys.Error>.Err(_) -> return }
        Ok(items) {
            items -> make => value
            Result<keys.Holder, keys.Error>.Ok(value)
        }
    }
}
main {
    Result<[Int; ~], keys.Error>.Ok([1, 2; ~]) => source
    source -> fresh -> when {
        Err(_) { 0 -> println }
        Ok(item) { item.values[0] -> println }
    }
    source -> when {
        Err(_) { 0 -> println }
        Ok(items) { items -> len -> println }
    }
}
