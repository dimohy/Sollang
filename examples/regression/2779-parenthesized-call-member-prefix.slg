struct Info { operation: Int }

memberInfo value: Text -> Info { Info { operation: 1 } }

main {
    "materialize" => targetName
    (targetName -> memberInfo).operation -> println
    (targetName -> memberInfo).operation > 0
        -> if { "flow" -> println }
    (memberInfo(targetName)).operation -> println
    (memberInfo(targetName)).operation > 0
        -> if { "direct" -> println }
}
