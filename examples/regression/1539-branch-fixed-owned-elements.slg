struct Owner { values: [Int; ~] }
make value: Int -> [Owner; 1] {
    [Owner { values: [value,; ~] }]
}

read selected: Bool -> Int {
    selected -> if {
        13 -> make => owners
        owners
    } else {
        17 -> make => owners
        owners
    } => owners
    owners[0].values[0]
}

main {
    true -> read -> println
    false -> read -> println
}
