resolve seed: Int -> Int {
    Result<Int, Text>.Ok(seed) -> when {
        Ok(value) {
            [value, value + 1; ~] => owned
            Result<Int, Text>.Ok(owned[0]) -> when {
                Ok(answer) { answer -> return }
                Err(error) { -1 -> return }
            }
        }
        Err(error) { -2 -> return }
    }
    -3
}

main {
    7 -> resolve => result
    "$result" -> println
}
