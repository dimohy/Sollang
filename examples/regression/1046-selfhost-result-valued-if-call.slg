enum ChoiceError {
    Rejected(Int)
}

reject code: Int -> Result<Int, ChoiceError> {
    Result<Int, ChoiceError>.Err(ChoiceError.Rejected(code))
}

choose first: Bool -> Result<Int, ChoiceError> {
    first -> if {
        reject(10)
    } else {
        reject(20)
    }
}

main {
    true -> choose -> when {
        Ok(value) { "unexpected $value" -> println }
        Err(error) => error -> when {
            Rejected(code) { "rejected=$code" -> println }
        }
    }
}
