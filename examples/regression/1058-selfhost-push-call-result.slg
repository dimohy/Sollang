struct SourceValue {
    value: Int
}

struct TargetValue {
    value: Int
}

# A push must store the direct call result, not reinterpret its source as %argN.
convert source: SourceValue -> TargetValue => TargetValue { value: source.value }

appendConverted output: mut [TargetValue; ~], source: SourceValue -> Unit {
    output -> push(source -> convert)
}

main {
    [TargetValue; ~] => output!
    appendConverted(output!, SourceValue { value: 42 })
    output![0].value -> println
}
