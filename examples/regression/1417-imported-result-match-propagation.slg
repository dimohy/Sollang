import sollang.compiler.semantic.constant_integer as arithmetic

enum Error {
    ExpansionLimit(Int)
}

convert end: Long, start: Long -> Result<Long, Error> {
    end -> arithmetic.evaluateBinary(start, arithmetic.Operator.Subtract) -> when {
        Ok(distance) { distance -> Result<Long, Error>.Ok }
        Err(_) { Error.ExpansionLimit(7) -> Result<Long, Error>.Err }
    }? => distance
    distance -> Result<Long, Error>.Ok
}

main {
    Long(9) -> convert(1) -> when {
        Ok(value) { "ok=$value" -> println }
        Err(_) { "unexpected-error" -> println }
    }
    9223372036854775807 -> convert(-1) -> when {
        Ok(_) { "unexpected-ok" -> println }
        Err(error) {
            error -> when {
                ExpansionLimit(value) { "error=$value" -> println }
            }
        }
    }
}
