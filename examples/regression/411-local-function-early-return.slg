select seed: Int -> Int {
    local value: Int -> Int {
        [Int; ~] => owned!
        owned! -> push(value)
        value > 0 -> if {
            owned! -> push(value + 1)
            owned![1] -> return
        }
        owned![0]
    }

    seed -> local
}

main {
    7 -> select => positive
    0 -> select => zero
    "local return = $positive,$zero" -> println
}
