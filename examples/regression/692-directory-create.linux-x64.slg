import sys.directory as directory
import sys.path as path

main {
    path.nativeStyle() => style
    "artifacts/example-tests/692-directory-create-linux" -> path.fromText(style) => target!
    target! -> directory.create => created
    target! -> directory.create => exists
    "examples/regression/692-directory-create.slg" -> path.fromText(style) => filePath!
    filePath! -> directory.create => fileRejected
    created -> if { "created = true" -> println } else { "created = false" -> println }
    exists -> if { "exists = true" -> println } else { "exists = false" -> println }
    fileRejected -> if { "file = true" -> println } else { "file = false" -> println }
}
