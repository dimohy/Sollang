# Cold-stream latest crosses a function boundary and emits after initialization and every update.
import std.sequence

makeValues values: Range -> Stream<Int> {
    values -> defer
}

latestValues left: move Stream<Int>, right: move Stream<Int> -> EventStream<(left: Int, right: Int)> {
    (left: left, right: right) -> latest
}

main {
    1..3 -> makeValues => left
    10..11 -> makeValues => right
    left -> latestValues(right) => current
    current -> each pair {
        "$(pair.left):$(pair.right)" -> println
    }
}
