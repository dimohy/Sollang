# Reference interpolation reads the referenced LLVM value for signed, Boolean,
# and Text writers rather than sending a pointer to any of them.
struct Values {
    whole: Long
    ready: Bool
    caption: Text
}

whole values: ref Values -> ref Long { values.whole }
ready values: ref Values -> ref Bool { values.ready }
caption values: ref Values -> ref Text { values.caption }

main {
    Values { whole: -7, ready: true, caption: "ok" } => values
    values -> whole => borrowedWhole
    values -> ready => borrowedReady
    values -> caption => borrowedCaption
    "values=$(borrowedWhole),$(borrowedReady),$(borrowedCaption)" -> println
}
