import sollang.compiler.semantic.ownership_check as ownershipCheck

report source: Text -> Unit uses Console {
    [Text; ~] => sources!
    sources! -> push(source)
    sources! -> ownershipCheck.analyze => diagnostics
    0 => blockEscapes!
    diagnostics -> each diagnostic {
        diagnostic.code == ownershipCheck.borrowedTextBlockEscapeCode()
            -> if { blockEscapes! + 1 => blockEscapes! }
    }
    "$(diagnostics -> len):$(blockEscapes!)" -> println
}

main {
    """
    show flag: Bool -> Unit uses Console {
        flag -> if {
            Arena(64) => storage!
            "local" -> materialize(storage!) => text
            text
        } else { "other" } -> println
    }
    main { show(true) }
    """ -> report

    """
    show flag: Bool -> Unit uses Console {
        Arena(64) => storage!
        "outer" -> materialize(storage!) => text
        flag -> if { text } else { "other" } -> println
    }
    main { show(true) }
    """ -> report

    """
    show flag: Bool -> Unit uses Console {
        flag -> if {
            Arena(64) => storage!
            "local" -> materialize(storage!) => text
            text -> len
        } else { UIntSize(0) } -> println
    }
    main { show(true) }
    """ -> report

    """
    relay value: Text -> Text { value }
    show flag: Bool -> Unit uses Console {
        flag -> if {
            Arena(64) => storage!
            "local" -> materialize(storage!) => text
            text -> relay
        } else { "other" } -> println
    }
    main { show(true) }
    """ -> report

    """
    show flag: Bool -> Unit uses Console {
        flag -> if {
            flag -> if {
                Arena(64) => storage!
                "local" -> materialize(storage!) => text
                text
            } else { "inner" }
        } else { "outer" } -> println
    }
    main { show(true) }
    """ -> report

    """
    show result: Result<Int, Int> -> Unit uses Console {
        result -> when {
            Ok(value) {
                Arena(64) => storage!
                "local" -> materialize(storage!) => text
                text
            }
            Err(error) => "other"
        } -> println
    }
    main { show(Ok(1)) }
    """ -> report
}
