# Verifies self-host LLVM mutation, membership, count, and length for inline BitSet.
import sollang.compiler.llvm.text as llvm

main {
    [
        """
        mark bits: mut BitSet<130> -> Unit {
            bits! -> set(5)
        }

        main {
            BitSet<130>() => bits!
            bits! -> mark
            bits! -> set(0)
            bits! -> set(64)
            bits! -> set(129)
            bits! -> contains(5) -> println
            bits! -> contains(0) -> println
            bits! -> contains(64) -> println
            bits! -> clear(64)
            bits! -> contains(64) -> println
            bits! -> count -> println
            bits! -> len -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
