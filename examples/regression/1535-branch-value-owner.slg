struct Owner { values: [Int; ~] }

read selected: Bool -> Int {
    selected -> if {
        Owner { values: [13,; ~] } => owner
        owner
    } else {
        Owner { values: [17,; ~] } => owner
        owner
    } => selectedOwner
    selectedOwner.values[0]
}

main {
    true -> read -> println
    false -> read -> println
}
