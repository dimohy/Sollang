struct PacketQueue {
    pending: [UInt8; ~]
}

bytes count: Int -> [UInt8; ~] {
    [UInt8; ~] => values!
    0 => index!
    index! < count -> while {
        values! -> push(7)
        index! + 1 => index!
    }
    values!
}

main {
    PacketQueue { pending: bytes(55) } => queue!
    [UInt8; ~] => output!
    (queue!.pending -> len) > 0 -> while {
        queue!.pending -> take(0) => value
        output! -> push(value)
    }
    ((queue!.pending -> len) == 0 and (output! -> len) == 55 and output![54] == 7) -> if {
        "repeated-projected-take=ok"
    } else {
        "repeated-projected-take=failed"
    } -> println
}
