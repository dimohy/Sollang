import sys.file as file

struct Payload {
    source: file.SourceText
    tail: UInt64
}

make: -> Result<Payload, UInt64> {
    "payload" -> file.borrowText => source
    Result<Payload, UInt64>.Ok(Payload {
        source: source
        tail: 73
    })
}

main {
    make() -> when {
        Ok(payload) {
            payload.source -> len => sourceLength
            "source=$sourceLength,tail=$(payload.tail)" -> println
        }
        Err(error) { "error=$error" -> println }
    }
}
