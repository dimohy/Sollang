import regression.parenthesized_call_member as calls

main {
    "materialize" => value
    (value -> calls.memberInfo).operation -> println
    (value -> calls.memberInfo).operation > 0
        -> if { "flow" -> println }
    (calls.memberInfo(value)).operation -> println
    (calls.memberInfo(value)).operation > 0
        -> if { "direct" -> println }
    (((calls.memberInfo(value)))).operation -> println
    (calls.memberInfo(calls.sourceValue(value))).operation -> println
}
