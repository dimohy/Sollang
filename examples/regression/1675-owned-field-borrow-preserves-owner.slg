# Repeated inspection borrows the payload and leaves its original owner live.
struct Table {
    data: [Int; ~]
}

enum Slot {
    Empty
    Built(Table)
}

struct Reader {
    table: Slot
}

inspect reader: Reader -> Int {
    reader.table -> when {
        Empty { 0 }
        Built(value) { value.data[0] }
    }
}

main {
    Reader {
        table: Slot.Built(Table { data: [42] })
    } => reader
    reader -> inspect -> println
    reader -> inspect -> println
}
