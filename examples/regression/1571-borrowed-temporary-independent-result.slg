# Borrowing a temporary to create an independent owner releases both owners once.
struct Owner { values: [Int; ~] }
create: -> Owner { Owner { values: [13; ~] } }
impl Owner {
    duplicate: self -> Owner {
        Owner { values: [self.values[0],; ~] }
    }
    first: self -> Int { self.values[0] }
}
main {
    create() -> duplicate -> first -> println
}
