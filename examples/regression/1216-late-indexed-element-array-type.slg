readSingle bytes: [UInt8] -> Int {
    (bytes -> len) == 1 -> unless { -1 -> return }
    Int(bytes[0])
}

# An indexed element must establish the enclosing fixed-array type after path inference.
main {
    [UInt8(65), 66, 67] => source
    [source[1]] => chunk
    "$(chunk -> readSingle)" -> println
}
