import sollang.compiler.semantic.module_cache as cache

main {
    [
        "namespace identity.mmmmmmmmmmmmmmmmmmmmmmmm\npublic struct Entry { public value: Int }\n",
        "namespace identity.nkllmlnlmpnjnmnmmomooioj\npublic struct Entry { public value: Int }\n"; ~
    ] => sources
    sources -> cache.encode(173) => words
    words -> cache.reuse(sources, 173) => warm
    warm.hits -> println
    warm.misses -> println
}
