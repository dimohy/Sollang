import sollang.compiler.semantic.module_cache as cache

main {
    [
    """
    namespace identity.mmmmmmmmmmmmmmmmmmmmmmmm
    public struct Entry { public value: Int }

    """,
    """
    namespace identity.nkllmlnlmpnjnmnmmomooioj
    public struct Entry { public value: Int }

    """; ~
    ] => sources
    sources -> cache.encode(173) => words
    words -> cache.reuse(sources, 173) => warm
    warm.hits -> println
    warm.misses -> println
}
