# Zip emits labeled products in input order and stops at the shortest stream.
import std.sequence

makeValues values: Range -> Stream<Int> {
    values -> defer
}

main {
    1..3 -> makeValues => left
    10..14 -> makeValues => right
    (left: left, right: right) -> zip => paired
    paired -> each pair {
        "$(pair.left)+$(pair.right)" -> println
    }
}
