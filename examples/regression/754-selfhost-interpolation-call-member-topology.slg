import sollang.compiler.ir.interpolation as interpolation
import sollang.compiler.lexer as lexer
import sollang.compiler.semantic.symbols as symbols

# Keep the complete child-first topology for source calls, builtin conversions,
# nested member access, and arithmetic inside interpolation expressions.
main {
    """
    offset token: Token, index: UIntSize -> UIntSize { index }

    probe token: Token -> Unit {
        "function=$(token -> offset(UIntSize(2)))" -> println
        "entry=$(token.span.start + UIntSize(2))" -> println
    }
    """ => source
    source -> lexer.lex => tokens
    source -> symbols.collect => symbolTable
    0 => symbolIndex!
    symbolIndex! < (symbolTable -> len) -> while {
        symbolTable[symbolIndex!] => symbol
        "" => symbolName!
        symbol.nameToken >= 0 -> if {
            tokens[symbol.nameToken] => nameToken
            source -> slice(nameToken.span.start, nameToken.span.length) => symbolName!
        }
        "symbol=$(symbolIndex!),kind=$(symbol.kind),name=$(symbolName!)" -> println
        symbolIndex! + 1 => symbolIndex!
    }
    source -> interpolation.lower => nodes
    0 => index!
    index! < (nodes -> len) -> while {
        nodes[index!] => node
        source -> slice(node.payloadStart, node.payloadLength) => payload
        "node=$(index!),kind=$(node.kind),parent=$(node.parent),symbol=$(node.symbol),op0=$(node.operand0),op1=$(node.operand1),op2=$(node.operand2),payload=$payload" -> println
        index! + 1 => index!
    }
}
