import sollang.compiler.llvm.text as llvm

# LLVM interpolation emits member, index, and trailing member dependencies in
# source order without leaving an undefined SSA operand at the print call.
main {
    [
        """
        public struct Item { value: Int }

        show items: ref [Item; ~], index: Int -> Unit {
            "selected=$(items[index].value)" -> println
        }

        main {
            [Item { value: 41 }, Item { value: 42 }; ~] => items!
            items! -> show(1)
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
