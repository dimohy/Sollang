import regression.array_inherent_methods as arrayMethods

main {
    [UInt8(7), 9] => bytes
    bytes -> arrayMethods.firstPlus(3) => imported
    bytes -> arrayMethods.localFirstPlus(4) => currentModule
    imported == 10 and currentModule == 11 and bytes[0] == 7
        -> if { "array-self=ok" } else { "array-self=failed" } -> println
}
