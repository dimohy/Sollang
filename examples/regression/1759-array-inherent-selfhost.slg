import regression.array_inherent_methods as arrayMethods

main {
    [UInt8(7), UInt8(9)] => bytes
    bytes -> arrayMethods.firstPlus(UInt8(3)) => imported
    bytes -> arrayMethods.localFirstPlus(UInt8(4)) => currentModule
    imported == UInt8(10) and currentModule == UInt8(11) and bytes[0] == UInt8(7)
        -> if { "array-self=ok" } else { "array-self=failed" } -> println
}
