# A Unit observation's final Bool assignment neither filters nor replaces items.
import std.sequence

main {
    0 => seen!
    false => flipped!
    1..3
        -> map value { value }
        -> tap value {
            not flipped! => flipped!
        }
        -> each value {
            seen! + 1 => seen!
        }
    seen! -> println
    flipped! -> if {
        1 -> println
    } else {
        0 -> println
    }
}
