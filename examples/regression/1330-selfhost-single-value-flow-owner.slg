import sollang.compiler.ast as ast

main {
    """
    main {
        [Int; ~] => projected!
        projected! -> push(1)
    }
    """ -> ast.lower => nodes
    0 => flowOwnerCount!
    0 - 1 => mutableOwnerParentKind!
    nodes -> each node {
        node.kind == 10 -> if {
            flowOwnerCount! + 1 => flowOwnerCount!
        }
        node.kind == 15 -> if {
            nodes[node.parent].kind => mutableOwnerParentKind!
        }
    }
    "flow-owners=$(flowOwnerCount!),mutable-owner-parent=$(mutableOwnerParentKind!)" -> println
}
