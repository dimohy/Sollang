import sys.process as process

choose left: Arguments, right: Arguments, first: Bool -> Arguments {
    first -> if { left } else { right }
}

identity<T> value: T -> T => value

main {
    process.arguments() => arguments
    choose(arguments, arguments, true) -> identity => first
    choose(arguments, arguments, false) -> identity => second
    first[1] -> println
    second[2] -> println
    (first -> len) -> println
    (second -> len) -> println
}
