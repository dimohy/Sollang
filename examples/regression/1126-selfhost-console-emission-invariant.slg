    typedIr.TypedIrNode { kind: 6, parent: -1, sourceModule: 0, astNode: 0, symbol: -1, targetModule: -1, typeOrigin: -1, typeModule: -1, typeSymbol: 0, typeId: -1, typeKind: -1, typeFlags: 0, payloadToken: -1, opcode: -275, operand0: 3, operand1: -1, nextOperand: -1, flags: 0 }; ~
