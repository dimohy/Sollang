import sollang.compiler.ir.stream as streamIr
import sollang.compiler.ir.typed as typedIr
import sollang.compiler.llvm.emitter.context as emitterContext
import sollang.compiler.llvm.text as llvm
import sollang.compiler.semantic.library_imports as libraryImports

# V003 rejects a builtin console effect whose Typed IR shape is not covered by
# the canonical ordinary-or-materialized emission predicate.
main {
    [
    typedIr.TypedIrNode { kind: 10, parent: -1, sourceModule: 0, astNode: 0, symbol: -101, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 1, typeId: -1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 6, parent: -1, sourceModule: 0, astNode: 0, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 23, typeId: -1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 9, parent: -1, sourceModule: 0, astNode: 0, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 23, typeId: -1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 3, parent: -1, sourceModule: 0, astNode: 0, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 2, typeId: -1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 6, parent: -1, sourceModule: 0, astNode: 0, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 2, typeId: -1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: 3, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 6, parent: -1, sourceModule: 0, astNode: 0, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 15, typeId: -1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: 3, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 5, parent: -1, sourceModule: 0, astNode: 0, symbol: 0, targetModule: -1, typeOrigin: 4, typeModule: -1, typeSymbol: 5, typeId: -1, typeKind: 7, typeFlags: 1, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: 3, flags: 0 },
    typedIr.TypedIrNode { kind: 9, parent: -1, sourceModule: 0, astNode: 0, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 23, typeId: -1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: 6, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 9, parent: -1, sourceModule: 0, astNode: 0, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 23, typeId: -1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: 6, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 3, parent: -1, sourceModule: 0, astNode: 0, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 2, typeId: -1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: -1, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 27, parent: 11, sourceModule: 0, astNode: 0, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 2, typeId: -1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: 9, operand1: -1, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 9, parent: -1, sourceModule: 0, astNode: 0, symbol: -1, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 2, typeId: -1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: 9, operand1: 10, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 9, parent: -1, sourceModule: 0, astNode: 0, symbol: -102, targetModule: -1, typeOrigin: 1, typeModule: -1, typeSymbol: 23, typeId: -1, typeKind: 1, typeFlags: 0, payloadToken: -1, opcode: -1, operand0: 9, operand1: 10, nextOperand: -1, flags: 0 },
    typedIr.TypedIrNode { kind: 6, parent: -1, sourceModule: 0, astNode: 0, symbol: -1, targetModule: -1, typeOrigin: -1, typeModule: -1, typeSymbol: 0, typeId: -1, typeKind: -1, typeFlags: 0, payloadToken: -1, opcode: -275, operand0: 3, operand1: -1, nextOperand: -1, flags: 0 }; ~
    ] => ir
    emitterContext.EmitContext {
        initializerDiagnostics: []
        sources: []
        ranges: []
        nodes: []
        constantLiterals: []
        constantFailures: []
        tokens: []
        symbols: []
        calls: []
        finalCallResolvedByAst: []
        awaitSourceByAst: []
        libraries: libraryImports.LibraryCatalog { diagnosticCount: 0, bindings: [], sources: [], interfaces: [], runtimeLibraries: [] }
        libraryCalls: []
        libraryCallDiagnostics: []
        interpolationRanges: []
        interpolations: []
        ir: ir
        genericCallPlans: []
        genericBodies: typedIr.GenericBodyBindings { functionsByCall: [], templatesByFunction: [] }
        streamPlan: streamIr.StreamPlan { pipelines: [], stages: [], junctions: [], junctionInputs: [], partitionRoutes: [] }
        moves: []
        nominal: []
        composite: []
        modules: []
        imports: []
        resolvedImports: []
        types: []
        typeReferences: []
        typeTerms: []
        fields: []
        typeSizes: []
        typeAligns: []
        typeLayoutStatuses: []
        typeTraits: []
        pointerBitWidth: 64
        targetArchitecture: 1
        cpuDispatchPolicy: 0
        requiredCpuFeatures: 0
        allowedCpuFeatures: 0
        forbiddenCpuFeatures: 0
        supportsComputePool: false
        expectedPathStyle: 1
        usesConcurrentStreamJoins: false
        ownershipDiagnostics: []
    } => context
    [Int; ~] => functions!
    functions! -> push(-1)
    context -> llvm.irInvariantCode(0, functions!) => code
    "console invariant = $code" -> println
    context -> llvm.irInvariantCode(1, functions!) => unresolvedCode
    "ordinary unresolved call invariant = $unresolvedCode" -> println
    context -> llvm.irInvariantCode(2, functions!) => materializedUnresolvedCode
    "non-call materialized sentinel invariant = $materializedUnresolvedCode" -> println
    context -> llvm.irInvariantCode(4, functions!) => integerConversionCode
    "targetless integer conversion invariant = $integerConversionCode" -> println
    context -> llvm.irInvariantCode(5, functions!) => arenaConstructorCode
    "targetless Arena constructor invariant = $arenaConstructorCode" -> println
    context -> llvm.irInvariantCode(7, functions!) => materializedSetCode
    "materialized unresolved Set invariant = $materializedSetCode" -> println
    context -> llvm.irInvariantCode(8, functions!) => materializedCallCode
    "materialized linked-argument unresolved call invariant = $materializedCallCode" -> println
    context -> llvm.irInvariantCode(11, functions!) => producerWrapperCode
    "transparent control producer wrapper invariant = $producerWrapperCode" -> println
    context -> llvm.irInvariantCode(12, functions!) => duplicateTrailingCallCode
    "duplicate trailing call invariant = $duplicateTrailingCallCode" -> println
    context -> llvm.irInvariantCode(13, functions!) => streamSliceCode
    "compiler stream slice invariant = $streamSliceCode" -> println
}
