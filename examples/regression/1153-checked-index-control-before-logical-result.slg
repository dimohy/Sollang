struct Node {
    kind: Int
    symbol: Int
}

struct Context {
    nodes: [Node; 2]
}

needsProjection argumentIndex: Int, parameterIndex: Int, context: ref Context -> Bool {
    argumentIndex => current!
    current! >= 0
        and current! < (context.nodes -> len)
        and context.nodes[current!].kind == 8
        -> if {
            context.nodes[current!].symbol => current!
        }
    parameterIndex >= 0
        and parameterIndex < (context.nodes -> len)
        and current! >= 0
        and current! < (context.nodes -> len)
        and context.nodes[context.nodes[parameterIndex].symbol].kind == 3
}

main {
    Context {
        nodes: [Node { kind: 8, symbol: 0 }, Node { kind: 3, symbol: 1 }]
    } => context
    "$(0 -> needsProjection(1, context))" -> println
}
