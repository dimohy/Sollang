import sollang.compiler.llvm.text as llvm

# A final value-producing if remains the function result after multiple
# preceding while expressions. Control nodes must carry their canonical type
# before the return operand is linked.
main {
    [
        """
        struct Node {
            kind: Int
            next: Int
        }

        struct Context {
            nodes: [Node; ~]
        }

        selectIndex start: Int, context: ref Context -> Int {
            start => current!
            (current! >= 0 and (context.nodes[current!].kind == 13 or context.nodes[current!].kind == 15)) -> while {
                context.nodes[current!].next => current!
            }
            (current! >= 0 and context.nodes[current!].kind == 17) -> while {
                context.nodes[current!].next => current!
            }
            current! >= 0 -> if {
                current!
            } else {
                (current! >= 0 and context.nodes[current!].kind == 5 and context.nodes[current!].next >= 0) -> while {
                    context.nodes[current!].next => current!
                }
                current! >= 0 -> if {
                    context.nodes[current!].next
                } else {
                    -1
                }
            }
        }

        main { }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
