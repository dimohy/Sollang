import audit.leaf as leaf
import audit.wrapper as wrapper

score value: leaf.Hasher -> Int { value -> read }
identity<T> value: T -> T { value }
read value: ref leaf.Hasher -> Int { value -> read }

main {
    42 -> wrapper.create => bound
    bound -> finish -> println
    42 -> wrapper.create => direct
    direct -> finishDirect -> println
    42 -> leaf.create => hasher
    hasher -> run -> println
    hasher -> read -> println
    hasher -> leaf.fromFragment -> println
    hasher -> score -> println
    44 -> identity -> println
}
