import sys.quic.crypto_stream as crypto
import sys.quic.error as errors

verify: -> Result<Bool, errors.Error> uses Console {
    [crypto.ByteCell; ~] => cells!
    cells! -> crypto.insert(2, [30, 40], 8)? => insertedTail
    cells! -> crypto.insert(0, [10, 20, 30], 8)? => insertedHead
    cells! -> crypto.readContiguous(0, 3) => first
    cells! -> crypto.readContiguous(first.nextOffset, 3) => second

    [UInt8; ~] => sendBuffer!
    sendBuffer! -> crypto.append([1, 2, 3]) => firstOffset
    sendBuffer! -> crypto.append([4, 5, 6]) => secondOffset
    crypto.chunk(sendBuffer!, 2, 3)? => sent

    "$insertedTail,$insertedHead,$(first.nextOffset),$(second.nextOffset),$(cells! -> len)" -> println
    "$(first.bytes[0]),$(first.bytes[2]),$(second.bytes[0])" -> println
    "$firstOffset,$secondOffset,$(sent.offset),$(sent.bytes[0]),$(sent.bytes[2])" -> println
    Result<Bool, errors.Error>.Ok(true)
}

main {
    verify() -> when {
        Ok(done) {}
        Err(error) { "error=$(error.code)" -> println }
    }

    [crypto.ByteCell; ~] => conflict!
    conflict! -> crypto.insert(0, [1], 1) -> when {
        Ok(inserted) {}
        Err(error) { "unexpected=$(error.code)" -> println }
    }
    conflict! -> crypto.insert(0, [2], 1) -> when {
        Ok(inserted) { "conflict-missed" -> println }
        Err(error) { "conflict=$(error.code)" -> println }
    }

    [crypto.ByteCell; ~] => limited!
    limited! -> crypto.insert(0, [1, 2], 1) -> when {
        Ok(inserted) { "limit-missed" -> println }
        Err(error) { "limit=$(error.code)" -> println }
    }
}
