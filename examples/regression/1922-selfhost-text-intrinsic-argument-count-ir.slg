import sollang.compiler.ir.interpolation as interpolation

main {
    """
    main {
        "abc" => value
        "a=$(value -> byte())" -> println
        "b=$(value -> slice(UIntSize(1)))" -> println
        "c=$(value -> byte(UIntSize(1), UIntSize(2)))" -> println
        "d=$(value -> slice(UIntSize(0), UIntSize(1), UIntSize(1)))" -> println
    }
    """ => source
    source -> interpolation.lower => nodes
    nodes -> each node {
        node.kind == 6 and (node.opcode == -202 or node.opcode == -203)
            -> if { "opcode=$(node.opcode), count=$(node.argumentCount)" -> println }
    }
}
