import sollang.compiler.ir.typed as typedIr
import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.expression_type_ids as expressionTypeIds

# Enum-pattern when expressions must select their enum-valued member access,
# never the enclosing nominal struct, as the match subject.
main {
    [
        "examples/regression/763-selfhost-cli-cpp-binding-module.slg",
        "selfhost/cli_cpp_binding.slg",
        "selfhost/cli_grammar.slg",
        "selfhost/cpp_binding.slg",
        "selfhost/json.slg",
        "stdlib/sys/process.slg",
        "stdlib/sys/runtime.slg",
        "stdlib/sys/path.slg",
        "selfhost/runtime/file.slg",
        "stdlib/sys/directory.slg",
        "stdlib/sys/directory/kind.slg"; ~
    ] => sourcePaths
    sourcePaths -> semanticContext.prepareFiles => prepared
    prepared -> typedIr.lowerContext => ir
    prepared -> expressionTypeIds.resolveContext => recursiveTypes
    0 => matches!
    0 => invalid!
    0 => index!
    index! < (ir -> len) -> while {
        ir[index!] => node
        node.kind == 27 -> if {
            matches! + 1 => matches!
            (node.operand0 < 0 or node.operand0 >= (ir -> len)) -> if {
                invalid! + 1 => invalid!
            } else {
                ir[node.operand0] => subject
                false => enumSubject!
                subject.typeKind == 7 -> if { true => enumSubject! }
                subject.typeOrigin => subjectOrigin!
                subject.typeModule => subjectModule!
                subject.typeSymbol => subjectSymbol!
                (subject.typeId >= 0 and subject.typeId < (recursiveTypes.types -> len)) -> if {
                    recursiveTypes.types[subject.typeId] => subjectType
                    subjectType.kind == 7 -> if { true => enumSubject! }
                    subjectType.origin => subjectOrigin!
                    subjectType.module => subjectModule!
                    subjectType.symbol => subjectSymbol!
                }
                (not enumSubject!
                    and (subjectOrigin! == 0 or subjectOrigin! == 2)
                    and subjectModule! >= 0
                    and subjectModule! < (prepared.package.ranges -> len)) -> if {
                    prepared.package.ranges[subjectModule!] => subjectRange
                    (subjectSymbol! >= 0 and subjectSymbol! < subjectRange.symbolCount) -> if {
                        prepared.package.symbols[subjectRange.symbolStart + subjectSymbol!] => subjectDeclaration
                        (subjectDeclaration.astNode >= 0
                            and prepared.package.nodes[subjectRange.astStart + subjectDeclaration.astNode].kind == 4) -> if {
                            true => enumSubject!
                        }
                    }
                }
                not enumSubject! -> if {
                    invalid! + 1 => invalid!
                }
            }
        }
        index! + 1 => index!
    }
    "matches=$(matches!),invalid=$(invalid!)" -> println
}
