struct Cursor {
    offset: UIntSize
}

impl Cursor {
    public reset: mut self -> Unit {
        0 => self.offset
    }
}

main {
    Cursor { offset: 9 } => cursor!
    cursor! -> reset
    cursor!.offset == 0
        -> if { "contextual-member-assignment=ok" } else { "contextual-member-assignment=failed" }
        -> println
}
