import sollang.compiler.llvm.text as llvm

# Explicit parallel branch arms execute through the structured compute pool.
main {
    [
        """
        double value: Int -> Int => value * 2
        square value: Int -> Int => value * value
        main {
            7 -> parallel branch {
                doubled: ref -> double
                squared: ref -> square
            } => results
            results.doubled + results.squared -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
