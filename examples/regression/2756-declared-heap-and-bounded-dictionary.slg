struct Mixed {
    heap: {Text: Payload}
    bounded: {Text: Payload; <=2}
}
struct Payload { value: Int }

main {
    {Text: Payload; 2~} => heap!
    {Text: Payload; <=2} => bounded!
    heap! -> put("one", Payload { value: 7 })
    bounded! -> put("one", Payload { value: 9 })
    Mixed { heap: heap!, bounded: bounded! } => values
    values.heap["one"].value -> println
    values.bounded["one"].value -> println
}
