# A temporary enum releases the owned storage inside its payload.
struct Payload { values: [Int; ~] }
enum Owner { Values(Payload) }
create: -> Owner { Owner.Values(Payload { values: [13; ~] }) }
impl Owner {
    first: self -> Int {
        self -> when { Values(payload) { payload.values[0] } }
    }
}
main {
    create() -> first -> println
}
