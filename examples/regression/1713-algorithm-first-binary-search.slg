import std.algorithm as algorithm

struct IntegerComparison { }
impl algorithm.Comparison for IntegerComparison {
    type Item = Int
    public compare: self, left: ref Int, right: ref Int -> Int {
        left < right -> if { -2_147_483_648 } else {
            left > right -> if { 2_147_483_647 } else { 0 }
        }
    }
}

main {
    algorithm.Ordering { direction: algorithm.Direction.Ascending } => ascending
    algorithm.Ordering { direction: algorithm.Direction.Descending } => descending
    IntegerComparison { } => comparison
    [-3, -1, -1, -1, 2, 4, 4, 9; ~] => values!
    -5..11 -> each needle {
        ascending -> binarySearch(values!, needle, comparison) => result
        "asc=$needle,$(result.index),$(result.found)" -> println
    }
    descending -> sort(values!, comparison)
    -5..11 -> each needle {
        descending -> binarySearch(values!, needle, comparison) => result
        "desc=$needle,$(result.index),$(result.found)" -> println
    }
    [Int; ~] => empty
    ascending -> binarySearch(empty, 0, comparison) => absent
    "empty=$(absent.index),$(absent.found)" -> println
    [7; ~] => single
    6..8 -> each needle {
        ascending -> binarySearch(single, needle, comparison) => result
        "single=$needle,$(result.index),$(result.found)" -> println
    }
}
