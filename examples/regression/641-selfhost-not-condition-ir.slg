import sollang.compiler.ir.typed as typedIr

main {
    [
        """
        main {
            -1 => value!
            value! < 0 => first
            first -> if {
                1 => value!
            }
            not first -> if {
                2 => value!
            }
            value! -> println
        }
        """; ~
    ] => sources!
    sources! -> typedIr.lower => ir!
    0 => nodeIndex!
    nodeIndex! < (ir! -> len) -> while {
        ir![nodeIndex!] => node
        node.kind == 18 -> if {
            ir![node.operand0] => condition
            "if condition = $(condition.kind),$(condition.typeSymbol),$(condition.opcode)" -> println
        }
        nodeIndex! + 1 => nodeIndex!
    }
}
