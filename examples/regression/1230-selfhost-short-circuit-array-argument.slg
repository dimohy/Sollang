same left: ref [UInt8; ~], right: [UInt8] -> Bool {
    (left -> len) == (right -> len) -> unless { false -> return }
    0 => index!
    index! < (left -> len) -> while {
        left[index!] == right[index!] -> unless { false -> return }
        index! + 1 => index!
    }
    true
}

main {
    [UInt8; ~] => bytes!
    bytes! -> push(1)
    bytes! -> push(2)
    bytes! -> push(3)
    true and (bytes! -> same([1, 2, 3]))
        -> if { "short-circuit array ok" } else { "short-circuit array failed" }
        -> println
}
