import sollang.compiler.syntax as syntax

decode value: Text -> Int {
    syntax.SyntaxToken {
        kind: 0
        span: syntax.SourceSpan { fileId: 0, start: 0, length: value -> len }
    } => token
    value -> syntax.numericExtentTokenValue(token)
}

main {
    "0_4" -> decode -> println
    "2_147_483_647" -> decode -> println
    "2_147_483_648" -> decode -> println
    "4.0" -> decode -> println
    "" -> decode -> println
    "0_0" -> decode -> println
}
