enum Leaf {
    Value(Int)
}
enum Branch {
    Value(Option<Leaf>)
}
main {
    Branch.Value(Option<Leaf>.Some(Leaf.Value(13))) => branch
    branch -> when {
        Value(option) {
            option -> when {
                None { "none" -> println }
                Some(leaf) {
                    leaf -> when {
                        Value(value) { value -> println }
                    }
                }
            }
        }
    }
}
