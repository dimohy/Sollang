import std.net.quic.error as errors
import std.net.quic.stream_state as streams

run: -> Result<Bool, errors.Error> uses Console {
    streams.initialReceiveFlow(16) -> onReceive(5, 1, false)? => received
    received -> onReceive(0, 5, true) -> when {
        Ok(flow) { "missing-final-size-error" -> println }
        Err(error) { "quic-final-size=$(error.code)" -> println }
    }
    Result<Bool, errors.Error>.Ok(true)
}

main {
    run() -> when {
        Ok(done) {}
        Err(error) { "unexpected=$(error.code)" -> println }
    }
}
