import sollang.compiler.semantic.context as context

pathStatus sources: [Text; ~], expectedPath: Text -> Int {
    sources -> context.prepare => prepared
    -1 => selected!
    prepared.qualified -> each value {
        value.sourceModule == 0 -> if {
            prepared.package.nodes[prepared.package.ranges[0].astStart + value.pathAst] => node
            prepared.package.sources[0] -> slice(node.start, node.length) => name
            name == expectedPath -> if { value.status => selected! }
        }
    }
    selected!
}

main {
    """
    import stored.header as provider
    main { provider.Item.count() -> println }

    """ => caller
    """
    namespace stored . header
    public struct Item {}

    """ => owner
    """
    namespace stored.header
    impl Item { public count: -> Int => 7 }

    """ => method
    pathStatus([caller, owner, method; ~], "provider.Item.count") -> println
    """
    namespace stored . header
    struct Item {}

    """ => privateOwner
    pathStatus([caller, privateOwner, method; ~], "provider.Item.count") -> println
    """
    namespace stored.header
    impl Item { count: -> Int => 7 }

    """ => privateMethod
    pathStatus([caller, owner, privateMethod; ~], "provider.Item.count") -> println
    """
    namespace stored . header
    main { stored.header.Item.count() -> println }

    """ => sameModuleCaller
    pathStatus([sameModuleCaller, privateOwner, privateMethod; ~], "stored.header.Item.count") -> println
    """
    namespace stored.other
    public struct Item {}
    impl Item { public count: -> Int => 7 }

    """ => foreignMethod
    pathStatus([caller, owner, foreignMethod; ~], "provider.Item.count") -> println
}
