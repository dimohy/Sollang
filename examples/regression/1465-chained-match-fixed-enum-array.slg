enum State {
    A
    B
    C
    D
    E
    F
    G
    H
    I
}

enum Advance {
    Continue
    NeedMore(Int)
    Ready
}

enum Failure {
    Invalid
}

read state: State -> Int {
    true -> while {
        state -> when {
            A { Result<Advance, Failure>.Ok(Advance.NeedMore(9)) }
            B { Result<Advance, Failure>.Ok(Advance.NeedMore(8)) }
            C { Result<Advance, Failure>.Ok(Advance.NeedMore(7)) }
            D { Result<Advance, Failure>.Ok(Advance.NeedMore(6)) }
            E { Result<Advance, Failure>.Ok(Advance.NeedMore(5)) }
            F { Result<Advance, Failure>.Ok(Advance.NeedMore(4)) }
            G { Result<Advance, Failure>.Ok(Advance.NeedMore(3)) }
            H { Result<Advance, Failure>.Ok(Advance.NeedMore(2)) }
            I { Result<Advance, Failure>.Ok(Advance.NeedMore(1)) }
        } -> when {
            Err(_) { -1 -> return }
            Ok(progress) {
                progress -> when {
                    Continue { }
                    NeedMore(bits) { bits -> return }
                    Ready { 0 -> return }
                }
            }
        }
    }
    -2
}

main {
    [State.A, State.B, State.C, State.D, State.E, State.F, State.G, State.H, State.I] -> each state {
        state -> read -> println
    }
}
