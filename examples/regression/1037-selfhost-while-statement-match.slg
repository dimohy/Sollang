enum Step {
    Stop
    Add
}

main {
    0 => count!
    true => running!
    Step.Add => step
    running! -> while {
        step -> when {
            Stop { false => running! }
            Add {
                count! + 1 => count!
                false => running!
            }
        }
    }
    "running=$(running!),count=$(count!)" -> println
}
