within value: Int, lower: Int, upper: Int -> Bool {
    value >= lower and value <= upper
}

shift value: Int, left: Int, right: Int -> Int {
    value + left + right
}

main {
    [3, 10; ~] -> parallel value {
        true and (value -> within(1, 8))
            -> if {
                value -> shift(2, 4)
            } else {
                value -> shift(0, 0)
            }
    } => shifted
    "$(shifted[0]),$(shifted[1])" -> println
}
