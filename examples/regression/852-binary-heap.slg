makeHeap: -> BinaryHeap<Int> {
    BinaryHeap<Int>(2) => heap!
    heap! -> push(4)
    heap! -> push(9)
    heap! -> push(1)
    heap! -> push(7)
    heap!
}

main {
    makeHeap() => heap!
    heap! -> peek => first
    heap! -> pop => a
    heap! -> pop => b
    heap! -> pop => c
    heap! -> pop => d
    heap! -> len => length
    heap! -> capacity => capacity
    "peek=$first order=$a,$b,$c,$d len=$length capacity=$capacity" -> println
}
