enum Kind {
    File
    Directory
}

matches enabled: Bool, kind: Kind -> Bool {
    enabled and (kind -> when {
        Directory => true
        else => false
    })
}

main {
    matches(true, Kind.Directory) -> if { "true" } else { "false" } -> println
    matches(true, Kind.File) -> if { "true" } else { "false" } -> println
    matches(false, Kind.Directory) -> if { "true" } else { "false" } -> println
}
