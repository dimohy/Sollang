struct Entry {
    data: [UInt8; ~]
}

struct Batch {
    marker: Int
    values: [Entry; ~]
}

batch marker: Int -> Batch {
    [Entry; ~] => values!
    values! -> push(Entry { data: [UInt8(marker), 2, 3; ~] })
    Batch { marker: marker, values: values! }
}

main {
    0 => index!
    0 => total!
    index! < 3 -> while {
        batch(index! + 1) => current!
        current!.values -> take(0) => value
        total! + Int(value.data[0]) + current!.marker => total!
        index! + 1 => index!
    }
    total! == 12 -> if { "12" } else { "failed" } -> println
}
