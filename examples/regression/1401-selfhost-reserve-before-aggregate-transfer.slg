struct Buffer {
    entries: [UInt8; ~]
}

prepare values: move [UInt8; ~] -> Buffer {
    values => output!
    output! -> reserve(64)
    Buffer { entries: output! }
}

main {
    [1, 2, 3; ~] -> prepare => buffer
    buffer.entries -> capacity => capacity
    "reserve-transfer=$(capacity >= 64)" -> println
}
