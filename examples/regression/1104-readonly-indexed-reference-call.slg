struct Entry {
    rank: Int
}

sumRanks left: ref Entry, right: ref Entry -> Int => left.rank + right.rank

indexedSum entries: ref [Entry; ~] -> Int => entries[0] -> sumRanks(entries[1])

main {
    [Entry { rank: 1 }, Entry { rank: 2 }; ~] => entries
    entries -> indexedSum => sum
    "sum=$sum" -> println
}
