import sollang.compiler.ir.typed as typedIr
import sollang.compiler.semantic.context as semanticContext

main {
    """"
        main {
            "payload" => value
            [value; ~] => values
            values -> len -> println
        }
    """" => source
    [source,; ~] -> semanticContext.prepare => prepared
    prepared -> typedIr.lowerContext => ir

    0 => index!
    index! < (ir -> len) -> while {
        ir[index!] => node
        "$(index!):$(node.kind):$(node.typeId):$(node.operand0):$(node.opcode):$(node.astNode)" -> println
        index! + 1 => index!
    }
}
