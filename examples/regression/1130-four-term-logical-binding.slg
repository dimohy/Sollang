# A grouped logical chain must bind the final Boolean materialization rather
# than the last scalar operand that happened to precede its control region.
main {
    [1; ~] => first
    [1; ~] => second
    [1; ~] => third
    [1; ~] => fourth
    [1; ~] => fifth
    ((first -> len) == (second -> len) and (first -> len) == (third -> len) and (first -> len) == (fourth -> len) and (first -> len) == (fifth -> len)) => all!
    0 => index!
    all! and index! < 1 -> while {
        false => all!
        index! + 1 => index!
    }
    not all! -> if {
        "four-term logical = true" -> println
    } else {
        "four-term logical = false" -> println
    }
}
