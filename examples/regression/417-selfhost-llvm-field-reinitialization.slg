import sollang.compiler.llvm.text as llvm

main {
    [
    """
    struct Holder {
        values: [Int; ~]
    }

    repair: -> Int {
        Holder { values: [1, 2; ~] } => holder!
        [3, 4, 5; ~] => replacement
        holder!.values => moved
        replacement => holder!.values
        holder!.values -> len
    }

    replace: -> Int {
        Holder { values: [6, 7; ~] } => holder!
        [8, 9, 10; ~] => replacement
        replacement => holder!.values
        holder!.values -> len
    }

    main {
        repair() -> println
        replace() -> println
    }
    """; ~
    ] => sources!
    sources! -> llvm.emit
}
