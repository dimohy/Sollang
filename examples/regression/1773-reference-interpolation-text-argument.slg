# A deferred interpolated Text passed as an additional call argument reads
# the value behind a readonly reference in both interpolation spellings.
struct Pair {
    first: Int
}

first pair: ref Pair -> ref Int {
    pair.first
}

show prefix: Text, text: Text -> Unit uses Console {
    prefix -> print
    text -> println
}

main {
    Pair { first: 41 } => pair
    pair -> first => borrowed

    "call:" -> show("expression=$(borrowed)")
    "call:" -> show("name=$borrowed")
}
