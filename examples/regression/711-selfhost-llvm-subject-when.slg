import sollang.compiler.llvm.text as llvm

# Verify every integer subject arm and both range boundary forms through LLVM.
main {
    [
        """
        classify value: Int -> Int => value -> when {
            < 0 => 1
            == 0 => 2
            <= 1 => 3
            > 10 => 4
            >= 10 => 5
            != 7 => 6
            else => 7
        }

        classifyRange value: Int -> Int => value -> when {
            1..<3 => 8
            3..3 => 9
            else => 10
        }

        main {
            -1 -> classify => less
            0 -> classify => equal
            1 -> classify => lessEqual
            11 -> classify => greater
            10 -> classify => greaterEqual
            8 -> classify => notEqual
            7 -> classify => otherwise
            2 -> classifyRange => exclusive
            3 -> classifyRange => inclusive
            4 -> classifyRange => outside
            "$less,$equal,$lessEqual,$greater,$greaterEqual,$notEqual,$otherwise,$exclusive,$inclusive,$outside" -> println
        }
        """; ~
    ] => sources!
    sources! -> llvm.emit
}
