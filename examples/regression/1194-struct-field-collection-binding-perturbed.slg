import sys.file as file

struct Request {
    sources: [Text; ~]
}

struct Unrelated {
    entries: [UInt64; ~]
}

struct Package {
    unrelated: [UInt64; ~]
    sources: [file.SourceText; ~]
}

convert request: Request -> Package {
    [file.SourceText; ~] => sources!
    request.sources -> each source {
        source -> file.borrowText => ownedSource
        sources! -> push(ownedSource)
    }
    Package {
        unrelated: [UInt64; ~]
        sources: sources!
    }
}

main {
    Request { sources: ["alpha", "beta"; ~] } -> convert => package
    "collection-binding-count=$(package.sources -> len)" -> println
}
