import sollang.compiler.semantic.context as semanticContext
import sollang.compiler.semantic.expression_type_ids as expressionTypeIds
import sollang.compiler.ir.typed as typedIr

main {
    """
    namespace custom.roles

    public parallel seed: Int -> Int uses Console block item: Int {
        seed -> yield
        seed + 1
    }

    public tryParallel seed: Int -> Int uses Console block item: Int {
        seed -> yield
        seed + 2
    }
    """ => library
    """
    import custom.roles as roles

    run seed: Int -> Int uses Console {
        seed -> roles.parallel item { item -> println } => result
        result
    }

    main {
        7 -> roles.parallel item { item -> println } => first
        7 -> roles.tryParallel item { item -> println } => second
        run(7) => third
        [Int; ~] => values!
        1..3 -> each item { values! -> push(item) }
        values! -> parallel item { item * 2 } => mapped
        (mapped -> len) -> println
    }
    """ => program
    [library, program; ~] => sources
    sources -> semanticContext.prepare => prepared
    prepared -> expressionTypeIds.resolveContext => resolved
    prepared -> typedIr.lowerResolvedContext(resolved) => nodes
    0 => ordinary!
    0 => wrong!
    0 => intResults!
    0 => builtin!
    nodes -> each node {
        node.kind == 6 and node.targetModule == 0 and node.symbol >= 0
            -> if {
                ordinary! + 1 => ordinary!
                node.opcode == -207 or node.opcode == -209 -> if { wrong! + 1 => wrong! }
                node.typeKind == 1 and node.typeSymbol == 2 -> if { intResults! + 1 => intResults! }
            }
        node.kind == 6 and node.opcode == -207 -> if { builtin! + 1 => builtin! }
    }
    "ordinary=$(ordinary!),wrong=$(wrong!),intResults=$(intResults!),builtin=$(builtin!)" -> println
}
