# A returned scalar reference must be read before interpolation in every
# LLVM output context, including a function and its nested control region.
struct Pair {
    first: Int
    second: Int
}

first pair: ref Pair -> ref Int {
    pair.first
}

show pair: ref Pair -> Unit uses Console {
    pair -> first => borrowed
    "function=$(borrowed)" -> println
    true -> if {
        "control=$(borrowed)" -> println
    }
}

main {
    Pair { first: 41, second: 1 } => pair
    pair -> first => borrowed
    "entry=$(borrowed)" -> println
    pair -> show
}
