import sollang.compiler.llvm.text as llvm

# Sollang digit separators are lexical sugar and must not reach LLVM tokens.
main {
    [
        """
        maximum: -> Int {
            65_535 => value!
            value! - 1 => value!
            value!
        }

        main {
            maximum() -> println
        }
        """; ~
    ] => sources
    sources -> llvm.emit
}
