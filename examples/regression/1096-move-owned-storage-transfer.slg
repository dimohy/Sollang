struct Holder {
    bytes: [UInt8; ~]
}

storeField holder: mut Holder, bytes: move [UInt8; ~] -> Unit {
    bytes => holder.bytes
}

storeIndex slots: mut [Holder; ~], bytes: move [UInt8; ~] -> Unit {
    Holder { bytes: bytes } => slots[0]
}

main {
    Holder { bytes: [1; ~] } => holder!
    [UInt8(2), 3; ~] => fieldBytes
    holder! -> storeField(fieldBytes)

    [Holder { bytes: [4; ~] }; ~] => slots!
    [UInt8(5), 6, 7; ~] => indexedBytes
    slots! -> storeIndex(indexedBytes)

    "field=$(holder!.bytes -> len),indexed=$(slots![0].bytes -> len)" -> println
}
