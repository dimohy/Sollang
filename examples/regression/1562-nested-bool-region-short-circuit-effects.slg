# Nested branch values keep their own evaluation and short-circuit effects.
probe value: Int -> Bool uses Console {
    "probe=$value" -> println
    value > 0
}
choose enabled: Bool -> Bool uses Console {
    true and (enabled -> if { 1 -> probe } else { 0 -> probe })
}
main {
    false and (true -> if { 9 -> probe } else { -9 -> probe })
        -> if { "unexpected" } else { "skipped" }
        -> println
    true -> choose -> if { "yes" } else { "no" } -> println
    false -> choose -> if { "yes" } else { "no" } -> println
    0 => index!
    index! < 2 and (true -> if { index! < 2 } else { false })
        -> while { index! + 1 => index! }
    index! -> println
}
