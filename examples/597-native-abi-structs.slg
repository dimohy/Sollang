abi struct Point {
    x: Float64
    y: Float64
}

abi struct Mixed {
    tag: Int32
    value: Float64
    code: Int16
}

abi struct Pair32 {
    left: Int32
    right: Int32
}

abi struct IntDouble {
    tag: Int32
    value: Float64
}

abi struct FloatPair {
    left: Float32
    right: Float32
}

native fixture from "artifacts/native-interop/native_fixture" {
    pointSum point: Point -> Float64 as "native_point_sum"
    pointSumRef point: ref Point -> Float64 as "native_point_sum_ref"
    translate point: mut Point, dx: Float64, dy: Float64 -> Unit as "native_point_translate"
    makePoint x: Float64, y: Float64 -> Point as "native_point_make"

    pointSize: -> Int64 as "native_point_size"
    pointAlignment: -> Int64 as "native_point_alignment"
    pointXOffset: -> Int64 as "native_point_x_offset"
    pointYOffset: -> Int64 as "native_point_y_offset"
    mixedSize: -> Int64 as "native_mixed_size"
    mixedAlignment: -> Int64 as "native_mixed_alignment"
    mixedTagOffset: -> Int64 as "native_mixed_tag_offset"
    mixedValueOffset: -> Int64 as "native_mixed_value_offset"
    mixedCodeOffset: -> Int64 as "native_mixed_code_offset"

    pair32Sum value: Pair32 -> Int32 as "native_pair32_sum"
    makePair32 left: Int32, right: Int32 -> Pair32 as "native_pair32_make"
    intDoubleSum value: IntDouble -> Float64 as "native_int_double_sum"
    makeIntDouble tag: Int32, value: Float64 -> IntDouble as "native_int_double_make"
    floatPairSum value: FloatPair -> Float32 as "native_float_pair_sum"
    makeFloatPair left: Float32, right: Float32 -> FloatPair as "native_float_pair_make"
    mixedSum value: Mixed -> Int64 as "native_mixed_sum"
    makeMixed tag: Int32, value: Float64, code: Int16 -> Mixed as "native_mixed_make"
    pair32AfterSix a: Int32, b: Int32, c: Int32, d: Int32, e: Int32, f: Int32, value: Pair32 -> Int32 as "native_pair32_after_six"
    pointAfterEight a: Float64, b: Float64, c: Float64, d: Float64, e: Float64, f: Float64, g: Float64, h: Float64, value: Point -> Float64 as "native_point_after_eight"
    negateI16 value: Int16 -> Int16 as "native_negate_i16"
    addU16 left: UInt16, right: UInt16 -> UInt16 as "native_add_u16"
}

main {
    Point { x: Double(3.0), y: Double(4.0) } => point!

    point! -> fixture.pointSum => byValue
    point! -> fixture.pointSumRef => byRef
    fixture.translate(point!, 10, 20)
    point! -> fixture.pointSumRef => translated
    fixture.makePoint(5, 12) => made
    made -> fixture.pointSum => returned

    Int64(byValue) => byValueInt
    Int64(byRef) => byRefInt
    Int64(translated) => translatedInt
    Int64(returned) => returnedInt

    fixture.pointSize => pointSize
    fixture.pointAlignment => pointAlignment
    fixture.pointXOffset => pointXOffset
    fixture.pointYOffset => pointYOffset
    fixture.mixedSize => mixedSize
    fixture.mixedAlignment => mixedAlignment
    fixture.mixedTagOffset => mixedTagOffset
    fixture.mixedValueOffset => mixedValueOffset
    fixture.mixedCodeOffset => mixedCodeOffset

    Pair32 { left: 8, right: 9 } -> fixture.pair32Sum => pair32Value
    fixture.makePair32(10, 11) -> fixture.pair32Sum => pair32Returned
    IntDouble { tag: 12, value: Double(13.0) } -> fixture.intDoubleSum => intDoubleValue
    fixture.makeIntDouble(14, 15) -> fixture.intDoubleSum => intDoubleReturned
    FloatPair { left: Float(1.5), right: Float(2.5) } -> fixture.floatPairSum => floatPairValue
    fixture.makeFloatPair(3.5, 4.5) -> fixture.floatPairSum => floatPairReturned
    Mixed { tag: 16, value: Double(17.0), code: Int16(18) } -> fixture.mixedSum => mixedValue
    fixture.makeMixed(19, 20, 21) -> fixture.mixedSum => mixedReturned
    fixture.pair32AfterSix(1, 2, 3, 4, 5, 6, Pair32 { left: 7, right: 8 }) => pressuredInteger
    fixture.pointAfterEight(1, 2, 3, 4, 5, 6, 7, 8, Point { x: Double(9.0), y: Double(10.0) }) => pressuredSse
    fixture.negateI16(123) => negative16
    fixture.addU16(40000, 20000) => unsigned16

    Int64(intDoubleValue) => intDoubleValueInt
    Int64(intDoubleReturned) => intDoubleReturnedInt
    Int64(floatPairValue) => floatPairValueInt
    Int64(floatPairReturned) => floatPairReturnedInt
    Int64(pressuredSse) => pressuredSseInt
    Int64(negative16) => negative16Int
    Int64(unsigned16) => unsigned16Int

    "calls=$byValueInt,$byRefInt,$translatedInt,$returnedInt" -> println
    "abi-matrix=$pair32Value,$pair32Returned,$intDoubleValueInt,$intDoubleReturnedInt,$floatPairValueInt,$floatPairReturnedInt,$mixedValue,$mixedReturned,$pressuredInteger,$pressuredSseInt" -> println
    "narrow-scalars=$negative16Int,$unsigned16Int" -> println
    "point-layout=$pointSize,$pointAlignment,$pointXOffset,$pointYOffset" -> println
    "mixed-layout=$mixedSize,$mixedAlignment,$mixedTagOffset,$mixedValueOffset,$mixedCodeOffset" -> println
}
