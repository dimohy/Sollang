import sollang.compiler.semantic.ownership_check as ownershipCheck

main {
    [
        """
        struct Pair {
            left: Int
            right: Int
        }

        sum value: ref Pair -> Int {
            value.left + value.right
        }

        forward value: ref Pair -> Int {
            value -> sum
        }

        main {
            Pair { left: 20, right: 22 } => pair
            pair -> forward -> println
        }
        """,
        ~
    ] => sources!

    sources! -> ownershipCheck.analyze => diagnostics!
    diagnostics! -> len => diagnosticCount
    "selfhost ref forwarding diagnostics = $diagnosticCount" -> println
}
