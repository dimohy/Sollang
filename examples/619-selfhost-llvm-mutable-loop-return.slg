import sollang.compiler.llvm.text as llvm

main {
    [
        """
        nibble value: UInt8 -> UInt64 {
            value >= UInt8(48) and value <= UInt8(57) -> if {
                UInt64(value - UInt8(48))
            } else {
                UInt64(value - UInt8(97)) + UInt64(10)
            }
        }

        accumulate source: Text, start: UIntSize, offset: UIntSize, digits: UIntSize -> UInt64 {
            UInt64(0) => value!
            UIntSize(0) => digit!
            digit! < digits -> while {
                value! * UInt64(16) + (source -> byte(start + offset + digit!) -> nibble) => value!
                digit! + UIntSize(1) => digit!
            }
            value!
        }

        main { }
        """,
        ~
    ] => sources!
    sources! -> llvm.emit
}
