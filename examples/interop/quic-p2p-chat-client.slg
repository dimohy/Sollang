# The sample reconstructs the server's signed record from a deterministic
# seed so it is self-contained. Real applications receive PeerRecord from a
# trusted contact, rendezvous service, QR code, or another discovery channel.
import sys.io as io
import std.net.quic as quic
import std.net.quic.p2p as p2p
import std.net as net

chatProtocol: -> [UInt8; 14] => [
115, 111, 108, 108, 97, 110, 103,
47, 99, 104, 97, 116, 47, 49]

chat: -> Result<Unit, quic.QuicError> uses Network, Random, Clock, Console {
    p2p.fromSeed([1; 32])? => serverIdentity
    serverIdentity -> createRecord(
    net.loopback(44_434),
    9_000_000_000_000)? => serverRecord
    p2p.fromSeed([2; 32])? => clientIdentity
    quic.bind(quic.loopback(0))? => endpoint!
    clientIdentity -> dial(
    endpoint!,
    serverRecord,
    quic.version1())? => session!
    session! -> openProtocol(endpoint!, chatProtocol())? => stream!
    session! -> sendMessage(
    endpoint!,
    stream!,
    [104, 101, 108, 108, 111, 45, 112, 101, 101, 114])?
    session! -> receiveMessage(endpoint!, stream!, 1_024)? => response
    session! -> finish(endpoint!, stream!)?
    session! -> close(endpoint!, 0)?
    endpoint! -> close
    io.println("client-received=$(response -> len)")
    Result<Unit, quic.QuicError>.Ok
}

main {
    chat() -> when {
        Ok(done) { "p2p-client-complete" -> io.println }
        Err(error) { "p2p-client-error=$(error.code)" -> io.println }
    }
}
