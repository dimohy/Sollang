import sys.io as io
import sys.quic as quic
import sys.runtime as runtime

serve: -> Result<Unit, quic.QuicError> uses Network, Random, Clock, Console {
    quic.generateIdentity()? => identity
    quic.bind(
        quic.Ipv4Endpoint { a: 127, b: 0, c: 0, d: 1, port: 44_433 },
        identity,
        [])? => endpoint
    io.println("ready=44433")
    runtime.flushStandardOutput()
    quic.accept(endpoint)? => connection!
    io.println("accepted")
    runtime.flushStandardOutput()
    quic.acceptBi(connection!)? => channel!
    io.println("stream-open")
    runtime.flushStandardOutput()
    quic.receive(connection!, channel!, 16)? => request
    io.println("stream-read")
    runtime.flushStandardOutput()
    quic.send(connection!, channel!, [112, 111, 110, 103])? => sent
    quic.finish(connection!, channel!)?
    quic.close(connection!, 0)?
    io.println("received=$(request -> len)")
    Result<Unit, quic.QuicError>.Ok
}

main {
    serve() -> when {
        Ok(done) { "complete" -> io.println }
        Err(error) { "error=$(error.code)" -> io.println }
    }
}
