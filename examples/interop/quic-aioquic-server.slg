import sys.io as io
import std.net.quic as quic
import sys.runtime as runtime

serve: -> Result<Unit, quic.QuicError> uses Network, Random, Clock, Console {
    quic.generateIdentity()? => identity
    quic.bind(quic.loopback(44_433))? => endpoint!
    endpoint! -> listen(identity)? => listener!
    io.println("ready=44433")
    runtime.flushStandardOutput()
    listener! -> accept(endpoint!)? => connection!
    listener! -> close(endpoint!)
    io.println("accepted")
    runtime.flushStandardOutput()
    connection! -> acceptBi(endpoint!)? => channel!
    io.println("stream-open")
    runtime.flushStandardOutput()
    channel! -> receive(connection!, endpoint!, 16)? => request
    io.println("stream-read")
    runtime.flushStandardOutput()
    channel! -> send(connection!, endpoint!, [112, 111, 110, 103])? => sent
    channel! -> finish(connection!, endpoint!)?
    connection! -> close(endpoint!, 0)?
    endpoint! -> close
    io.println("received=$(request -> len)")
    Result<Unit, quic.QuicError>.Ok
}

main {
    serve() -> when {
        Ok(done) { "complete" -> io.println }
        Err(error) { "error=$(error.code)" -> io.println }
    }
}
