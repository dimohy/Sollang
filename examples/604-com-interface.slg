com fixture class "8A90E2A5-7A2D-4E2A-98A0-6B5C2A12C501" from "artifacts/com-interop/com_fixture" in mta {
    interface Calculator "4C10A47B-725D-41D3-B5A6-70D67D3BEB11" {
        add left: Int32, right: Int32 -> Result<Int32, Int32> at 3
    }
    interface Arithmetic "B214A96D-58CF-4311-A29B-6DF850801C74" {
        sum left: Int32, right: Int32 -> Result<Int32, Int32> at 3
    }
    interface Missing "4C6EE04F-BACA-4DE7-91EE-EA56CC97D10A" {
    }
}

native probe from "artifacts/com-interop/com_fixture" {
    references: -> Int32 as "com_fixture_live_references"
}

main {
    fixture.create -> when {
        Ok(calculator) {
            calculator -> fixture.add(20, 22) -> when {
                Ok(value) => "COM result = $value" -> println
                Err(status) => "COM method failed = $status" -> println
            }
            calculator -> fixture.queryArithmeticFromCalculator -> when {
                Ok(arithmetic) {
                    arithmetic -> fixture.sum(21, 21) -> when {
                        Ok(value) => "COM query result = $value" -> println
                        Err(status) => "COM queried method failed = $status" -> println
                    }
                }
                Err(status) => "COM query failed = $status" -> println
            }
            calculator -> fixture.queryMissingFromCalculator -> when {
                Ok(missing) => "Unexpected COM interface" -> println
                Err(status) => "COM query failure = $status" -> println
            }
            calculator -> fixture.clone => cloned
            cloned -> fixture.add(19, 23) -> when {
                Ok(value) => "COM clone result = $value" -> println
                Err(status) => "COM clone method failed = $status" -> println
            }
        }
        Err(status) => "COM activation failed = $status" -> println
    }
    probe.references => references
    "COM references after scope = $references" -> println
}
