import sollang.compiler.ast as ast
import sollang.compiler.lexer as lexer
import sollang.compiler.parser as parser

main {
    """
    library fixture from "../build/fixture"

    main {
    }
    """ => source
    source -> ast.lower => nodes!
    source -> lexer.lex => tokens!
    source -> parser.parseEvents => events!
    events! -> len => eventCount
    events![eventCount - 1] => outcome
    "accepted = $(outcome.value)" -> println
    nodes! -> each node {
        node.kind == 69 -> if {
            tokens![node.payloadToken] => aliasToken
            tokens![node.secondaryToken] => pathToken
            source -> slice(aliasToken.span.start, aliasToken.span.length) => alias
            source -> slice(pathToken.span.start, pathToken.span.length) => path
            "library = $alias,$path,$(nodes![node.parent].kind)" -> println
        }
    }
}
