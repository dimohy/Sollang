import sollang.compiler.llvm.text as llvm

main {
    [
        """
        isDigit value: UInt8 -> Bool {
            value >= UInt8(48) and value <= UInt8(57)
        }

        scan source: Text -> UIntSize {
            UIntSize(0) => position!
            source -> len => sourceLength
            (position! < sourceLength and (((source -> byte(position!)) -> isDigit) or ((source -> byte(position!)) == UInt8(95) and position! + UIntSize(1) < sourceLength and ((source -> byte(position! + UIntSize(1))) -> isDigit)))) -> while {
                position! + UIntSize(1) => position!
            }
            position!
        }

        main { }
        """,
        ~
    ] => sources!
    sources! -> llvm.emit
}
