abi struct Pair32 {
    left: Int32
    right: Int32
}

abi struct Point {
    x: Float64
    y: Float64
}

native fixture from "artifacts/native-interop/native_fixture" {
    makePair32 left: Int32, right: Int32 -> Pair32 as "native_pair32_make"
    makePoint x: Float64, y: Float64 -> Point as "native_point_make"
    pair32AfterSix a: Int32, b: Int32, c: Int32, d: Int32, e: Int32, f: Int32, value: Pair32 -> Int32 as "native_pair32_after_six"
    pointAfterEight a: Float64, b: Float64, c: Float64, d: Float64, e: Float64, f: Float64, g: Float64, h: Float64, value: Point -> Float64 as "native_point_after_eight"
    negateI16 value: Int16 -> Int16 as "native_negate_i16"
    addU16 left: UInt16, right: UInt16 -> UInt16 as "native_add_u16"
}

main {
    fixture.makePair32(7, 8) => pair
    fixture.makePoint(9, 10) => point
    fixture.pair32AfterSix(1, 2, 3, 4, 5, 6, pair) => pressuredInteger
    fixture.pointAfterEight(1, 2, 3, 4, 5, 6, 7, 8, point) => pressuredSse
    fixture.negateI16(123) => negative16
    fixture.addU16(40000, 20000) => unsigned16

    Int64(pressuredSse) => pressuredSseInt
    Int64(negative16) => negative16Int
    Int64(unsigned16) => unsigned16Int
    "$pressuredInteger,$pressuredSseInt,$negative16Int,$unsigned16Int" -> println
}
