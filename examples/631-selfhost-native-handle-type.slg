import sollang.compiler.semantic.analysis as analysis
import sollang.compiler.semantic.type_ids as typeIds

main {
    """
    native handleFixture from "handle_fixture" {
        handle Counter drop "counter_drop"
        create initial: Int32 -> handleFixture.Counter as "counter_create"
        add self: ref handleFixture.Counter, amount: Int32 -> Int32 as "counter_add"
    }

    main {
    }
    """ => source
    [source, ~] => sources!
    sources! -> analysis.analyze => package
    package -> typeIds.resolveAnalyzed => resolved
    typeIds.TypeClassificationRequest {
        types: resolved.types
        fields: resolved.fields
    } -> typeIds.classify => traits!
    0 => typeIndex!
    typeIndex! < (resolved.types -> len) -> while {
        resolved.types[typeIndex!] => semanticType
        (semanticType.kind == 9 and semanticType.origin == 0) -> if {
            "Native handle type = $(semanticType.module),$(semanticType.symbol),$(traits![typeIndex!])" -> println
        }
        typeIndex! + 1 => typeIndex!
    }
    resolved.references -> each reference {
        resolved.types[reference.typeId] => referenceType
        referenceType.kind == 9 -> if {
            "Native handle reference = $(reference.sourceModule),$(reference.typeAst),$(reference.typeId),$(reference.status)" -> println
        }
    }
}
