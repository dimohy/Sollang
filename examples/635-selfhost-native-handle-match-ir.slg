import sollang.compiler.ir.typed as typedIr

main {
    [
        """
        native fixture from "native_fixture" {
            handle Counter drop "counter_drop"
            try create initial: Int32 -> fixture.Counter as "counter_create"
            add self: ref fixture.Counter, amount: Int32 -> Int32 as "counter_add"
        }
        """,
        """
        counterResult result: Result<fixture.Counter, Int32> -> Int32 {
            result -> when {
                Result<fixture.Counter, Int32>.Ok(counter) {
                    fixture.add(counter, 2)
                }
                Result<fixture.Counter, Int32>.Err(error) => -error
            }
        }

        main {
            fixture.create(40) -> counterResult => value
            "$value" -> println
        }
        """,
        ~
    ] => sources!
    sources! -> typedIr.lower => ir!
    0 => nodeIndex!
    nodeIndex! < (ir! -> len) -> while {
        ir![nodeIndex!] => node
        node.sourceModule == 1 -> if {
            "native handle match IR = $(nodeIndex!),$(node.kind),$(node.parent),$(node.symbol),$(node.targetModule),$(node.typeKind),$(node.typeId),$(node.operand0),$(node.operand1),$(node.nextOperand)" -> println
        }
        nodeIndex! + 1 => nodeIndex!
    }
}
