import sollang.compiler.ir.typed as typedIr

main {
    [
        """
        com fixture class "8A90E2A5-7A2D-4E2A-98A0-6B5C2A12C501" from "artifacts/com-interop/com_fixture" in mta {
            interface Calculator "4C10A47B-725D-41D3-B5A6-70D67D3BEB11" {
                add left: Int32, right: Int32 -> Result<Int32, Int32> at 3
            }
            interface Arithmetic "B214A96D-58CF-4311-A29B-6DF850801C74" {
                sum left: Int32, right: Int32 -> Result<Int32, Int32> at 3
            }
            interface Missing "4C6EE04F-BACA-4DE7-91EE-EA56CC97D10A" {
            }
        }

        native probe from "artifacts/com-interop/com_fixture" {
            referencesAfter value: Int32 -> Int32 as "com_fixture_live_references_after"
        }

        main {
            fixture.create -> when {
                Ok(calculator) {
                    calculator -> fixture.queryArithmeticFromCalculator -> when {
                        Ok(arithmetic) => arithmetic -> fixture.sum(20, 22) -> when {
                            Ok(value) => value
                            Err(status) => status
                        }
                        Err(status) => status
                    } => value
                    calculator -> fixture.queryMissingFromCalculator -> when {
                        Ok(missing) => 0
                        Err(status) => status
                    } => missingStatus
                    value -> println
                    missingStatus -> println
                    value
                }
                Err(status) => status
            } => value
            probe.referencesAfter(value) -> println
        }
        """,
        ~
    ] => sources!
    sources! -> typedIr.lower => ir!

    -1 => entry!
    -1 => outerBinding!
    -1 => nativeCall!
    0 => index!
    index! < (ir! -> len) -> while {
        ir![index!] => node
        node.kind == 11 -> if { index! => entry! }
        (node.kind == 17 and node.parent == entry!) -> if { index! => outerBinding! }
        (node.kind == 6 and node.targetModule == 0 and node.symbol == 7) -> if { index! => nativeCall! }
        index! + 1 => index!
    }

    0 => hasNameArgument!
    0 => resolvesOuterBinding!
    0 => producesInt32!
    0 => retainsControlDependency!
    nativeCall! >= 0 -> if {
        ir![nativeCall!].operand0 => argument!
        (argument! >= 0 and ir![argument!].kind == 5) -> if {
            1 => hasNameArgument!
            ir![argument!].operand0 == outerBinding! -> if { 1 => resolvesOuterBinding! }
        }
    }
    outerBinding! >= 0 -> if {
        ir![outerBinding!].operand0 => outerValue
        (outerValue >= 0 and ir![outerValue].kind == 27) -> if { 1 => retainsControlDependency! }
        (ir![outerBinding!].typeOrigin == 1 and ir![outerBinding!].typeSymbol == 5 and ir![outerValue].typeOrigin == 1 and ir![outerValue].typeSymbol == 5) -> if {
            1 => producesInt32!
        }
    }
    "COM query schedule IR = $(hasNameArgument!),$(resolvesOuterBinding!),$(producesInt32!),$(retainsControlDependency!)" -> println
}
