import sollang.compiler.ir.typed as typedIr
import sollang.compiler.semantic.ownership_check as ownershipCheck

# A later mutable parameter must not contaminate the first parameter's flags.
main {
    [
        """
        appendLength source: Text, values: mut [Int; ~] -> Unit {
            values -> push(3)
        }

        struct Pair {
            left: Int
            right: Int
        }

        sum value: ref Pair -> Int {
            value.left + value.right
        }

        forward value: ref Pair, offset: Int, enabled: Bool -> Int {
            value -> sum
        }

        main {
            [1, ~] => values!
            appendLength("abc", values!)
            Pair { left: 20, right: 22 } => pair
            pair -> forward(0, true)
        }
        """,
        ~
    ] => sources!
    sources! -> typedIr.lower => ir!
    ir! -> each node {
        (node.kind == 0 or node.kind == 10) -> if {
            "node = $(node.kind),$(node.symbol),$(node.flags),$(node.typeKind)" -> println
        }
    }
    sources! -> ownershipCheck.analyze -> len => diagnosticCount
    "diagnostics = $diagnosticCount" -> println
}
