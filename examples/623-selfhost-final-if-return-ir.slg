import sollang.compiler.ir.typed as typedIr

main {
    [
        """
        decide value: Int -> Bool {
            value >= 0 -> if {
                value > 1 and value < 10 and value != 5
            } else {
                value == -24
            }
        }

        main { }
        """,
        ~
    ] => sources!
    sources! -> typedIr.lower => ir!
    0 => index!
    index! < (ir! -> len) -> while {
        ir![index!] => node
        node.sourceModule == 0 -> if {
            index! => currentIndex
            "$currentIndex: kind=$(node.kind), parent=$(node.parent), symbol=$(node.symbol), operand0=$(node.operand0), operand1=$(node.operand1), next=$(node.nextOperand), flags=$(node.flags), opcode=$(node.opcode), typeId=$(node.typeId), typeKind=$(node.typeKind), typeOrigin=$(node.typeOrigin), typeModule=$(node.typeModule), typeSymbol=$(node.typeSymbol)" -> println
        }
        index! + 1 => index!
    }
}
